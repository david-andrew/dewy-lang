# The units of measure beyond time: `import units` brings them all in, `from
# units import (m kg)` a selection (time — the second and its scales — is the
# prelude's, see `time.dewy`). Physical dimensions are compile-time type
# factors. Canonical scales are the SI base units (metre, kilogram, ...), so
# derived SI units are exact scale 1 and prefixes are exact rationals folded
# at compile time.

# SI base units: metre, kilogram, ampere, kelvin, mole, candela. Derived
# units and prefixes are exact compile-time rationals of these, so unit
# arithmetic folds away entirely; only runtime quantities carry a number.
const m:(1 * Length) = 1 transmute (1 * Length)
const metre:(1 * Length) = m
const meter:(1 * Length) = m
const km = 1000 * m
const cm = m / 100
const mm = m / 1000

const kg:(1 * Mass) = 1 transmute (1 * Mass)
const kilogram:(1 * Mass) = kg
const g = kg / 1000
const mg = g / 1000

const A:(1 * Current) = 1 transmute (1 * Current)
const K:(1 * Temperature) = 1 transmute (1 * Temperature)
const mol:(1 * Amount) = 1 transmute (1 * Amount)
const cd:(1 * Luminosity) = 1 transmute (1 * Luminosity)

# Angles: the canonical unit is the whole turn, so degrees are exact
# rationals (45° is 1/8 turn) and range reduction for trig is exact. The
# radian's scale (1/2π turn) is irrational, so `rad` is a fixed-point unit.
const turn:(1 * Angle) = 1 transmute (1 * Angle)
const ° = turn / 360
const deg = °
const degree = °
const degrees = °
const rad:(fixed * Angle) = _fixed_from_raw(683565276) transmute (fixed * Angle)   # 2^32 / 2π
const radian:(fixed * Angle) = rad
const radians:(fixed * Angle) = rad

# Derived units.
const Hz = 1 / s
const N = kg * m / s^2
const Pa = N / m^2
const J = N * m
const W = J / s

# Trigonometry takes an angle quantity and yields a dimensionless fixed value.
let _cos_rational = (angle:(rational<int64> * Angle)):>fixed => _cos_turns(_fixed_from_rational(angle transmute rational<int64>))
let _cos_fixed = (angle:(fixed * Angle)):>fixed => _cos_turns(angle transmute fixed)
let cos = @_cos_rational & @_cos_fixed
let _sin_rational = (angle:(rational<int64> * Angle)):>fixed => _sin_turns(_fixed_from_rational(angle transmute rational<int64>))
let _sin_fixed = (angle:(fixed * Angle)):>fixed => _sin_turns(angle transmute fixed)
let sin = @_sin_rational & @_sin_fixed
let _tan_rational = (angle:(rational<int64> * Angle)):>fixed|DivisionByZero => _tan_turns(_fixed_from_rational(angle transmute rational<int64>))
let _tan_fixed = (angle:(fixed * Angle)):>fixed|DivisionByZero => _tan_turns(angle transmute fixed)
let tan = @_tan_rational & @_tan_fixed

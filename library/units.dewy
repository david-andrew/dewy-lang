# Physical dimensions are compile-time type factors. Duration preserves the
# chosen numeric representation; unit constants carry an exact scale which is
# folded into that representation when a quantity is constructed.

const Duration:type = <T of real>(T * Time)

const ns:Duration<1> = 1 transmute Duration<1>
const nanosecond:Duration<1> = 1 transmute Duration<1>
const nanoseconds:Duration<1> = 1 transmute Duration<1>

const ms:Duration<1000000> = 1000000 transmute Duration<1000000>
const millisecond:Duration<1000000> = 1000000 transmute Duration<1000000>
const milliseconds:Duration<1000000> = 1000000 transmute Duration<1000000>

const s:Duration<1000000000> = 1000000000 transmute Duration<1000000000>
const second:Duration<1000000000> = 1000000000 transmute Duration<1000000000>
const seconds:Duration<1000000000> = 1000000000 transmute Duration<1000000000>

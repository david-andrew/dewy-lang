# String methods, written in Dewy over grapheme indexing and slicing. The
# checker turns `text.contains(x)` into `_string_contains(text x)` (and the
# zero-argument ones, `text.trim`, into calls), so these read as methods.
# Positions and lengths are in graphemes, like indexing.

let _string_starts_with = (text:string prefix:string):>bool => {
    let m:int64 = prefix.length
    if m =? 0 { return true }
    if m >? text.length { return false }
    let last:int64 = m - 1
    if last <? text.length and last >=? 0 { return text[0..last] =? prefix }
    return false
}

let _string_ends_with = (text:string suffix:string):>bool => {
    let m:int64 = suffix.length
    if m =? 0 { return true }
    if m >? text.length { return false }
    let start:int64 = text.length - m
    let last:int64 = text.length - 1
    if start >=? 0 and start <=? last and last <? text.length { return text[start..last] =? suffix }
    return false
}

# The first position where `needle` occurs, or `none`.
let _string_find = (text:string needle:string):>int64|none => {
    let m:int64 = needle.length
    if m =? 0 { return 0 }
    let i:int64 = 0
    loop i + m <=? text.length {
        let last:int64 = i + m - 1
        if i >=? 0 and last >=? i and last <? text.length {
            if text[i..last] =? needle { return i }
        }
        i += 1
    }
    return none
}

# The last position where `needle` occurs, or `none`.
let _string_rfind = (text:string needle:string):>int64|none => {
    let m:int64 = needle.length
    if m =? 0 { return text.length }
    if m >? text.length { return none }
    let i:int64 = text.length - m
    loop i >=? 0 {
        let last:int64 = i + m - 1
        if i <? text.length and last >=? i and last <? text.length {
            if text[i..last] =? needle { return i }
        }
        i -= 1
    }
    return none
}

let _string_contains = (text:string needle:string):>bool => {
    match _string_find(text needle) {
        <int64> => return true
        <none> => return false
    }
}

# The pieces between occurrences of `separator` (an empty separator splits
# into graphemes); adjacent separators give empty pieces, like Python.
let _string_split = (text:string separator:string):>array<string> => {
    let pieces:array<string> = []
    let m:int64 = separator.length
    if m =? 0 {
        let k:int64 = 0
        loop k <? text.length { pieces.push(text[k])  k += 1 }
        return pieces
    }
    let start:int64 = 0
    let i:int64 = 0
    loop i + m <=? text.length {
        let last:int64 = i + m - 1
        let matched:bool = false
        if i >=? 0 and i <? text.length and last >=? i and last <? text.length { matched = text[i..last] =? separator }
        if matched {
            _push_piece(@pieces text start i)
            i += m
            start = i
        } else {
            i += 1
        }
    }
    _push_piece(@pieces text start text.length)
    return pieces
}

# `text[start..stop)` as a piece (empty when `start` is `stop`).
let _push_piece = (@pieces:array<string> text:string start:int64 stop:int64):>void => {
    if start >=? stop { pieces.push("")  return void }
    let last:int64 = stop - 1
    if start >=? 0 and start <? text.length and last >=? start and last <? text.length { pieces.push(text[start..last]) }
    return void
}

# The lines of `text`, without their line breaks; a final line break does
# not add an empty last line.
let _string_lines = (text:string):>array<string> => {
    let lines:array<string> = _string_split(text "\n")
    if lines.length >? 0 {
        let last:int64 = lines.length - 1
        if last >=? 0 and last <? lines.length {
            if lines[last].length =? 0 { let dropped:string = lines.pop() }
        }
    }
    return lines
}

let _is_space = (g:string):>bool => g =? " " or g =? "\t" or g =? "\n" or g =? "\r"

let _string_trim_start = (text:string):>string => {
    let i:int64 = 0
    loop i <? text.length {
        if not _is_space(text[i]) { break }
        i += 1
    }
    if i =? 0 { return text }
    let last:int64 = text.length - 1
    if i <? text.length and i <=? last and last <? text.length { return text[i..last] }
    return ""
}

let _string_trim_end = (text:string):>string => {
    let last:int64 = text.length - 1
    loop last >=? 0 and last <? text.length {
        if not _is_space(text[last]) { break }
        last -= 1
    }
    if last <? 0 { return "" }
    if last =? text.length - 1 { return text }
    if last <? text.length { return text[0..last] }
    return ""
}

let _string_trim = (text:string):>string => _string_trim_end(_string_trim_start(text))

# Every occurrence of `old` replaced by `new` (an empty `old` leaves the text alone).
let _string_replace = (text:string old:string new:string):>string => {
    if old.length =? 0 { return text }
    let pieces = _string_split(text old)
    return pieces.join(new)
}


# ---- scalars

# Appends a scalar's UTF-8 bytes.
let _push_utf8 = (@bytes:array<uint8> code:int64):>void => {
    if code <? 0x80 {
        bytes.push(code transmute uint8)
    } else if code <? 0x800 {
        bytes.push((0xC0 + (code >> 6)) transmute uint8)
        bytes.push((0x80 + (code and 0x3F)) transmute uint8)
    } else if code <? 0x10000 {
        bytes.push((0xE0 + (code >> 12)) transmute uint8)
        bytes.push((0x80 + ((code >> 6) and 0x3F)) transmute uint8)
        bytes.push((0x80 + (code and 0x3F)) transmute uint8)
    } else {
        bytes.push((0xF0 + (code >> 18)) transmute uint8)
        bytes.push((0x80 + ((code >> 12) and 0x3F)) transmute uint8)
        bytes.push((0x80 + ((code >> 6) and 0x3F)) transmute uint8)
        bytes.push((0x80 + (code and 0x3F)) transmute uint8)
    }
}

# The string of UTF-8 bytes this module produced itself (always valid).
let _string_of_utf8 = (bytes:array<uint8>):>string => {
    match bytes as string|none {
        text:string => return text
        <none> => return ""   # unreachable: the bytes were encoded here
    }
}

# The one-scalar string of a Unicode scalar value. The range is a proof
# obligation at the call (a loop over `[0..0x20)` proves it). A surrogate
# code point (0xD800–0xDFFF) is not a scalar and cannot be in a string, so it
# yields U+FFFD, the replacement character (a refinement cannot exclude a
# range in the middle yet).
let chr = (scalar:int64<scalar >=? 0 and scalar <? 0x110000>):>string => {
    let code:int64 = scalar
    if code >=? 0xD800 and code <=? 0xDFFF { code = 0xFFFD }
    let bytes:array<uint8> = []
    _push_utf8(@bytes code)
    return _string_of_utf8(bytes)
}

# ---- sets from other values: `set"0123"` (the graphemes), `set(values)` (the elements)

let _set_of_graphemes = (text:string):>set<string> => {
    let members:set<string> = set[]
    loop g in text { members.add(g) }
    return members
}

let _set_of_array = <T>(values:array<T>):>set<T> => {
    let members:set<T> = set[]
    loop v in values { members.add(v) }
    return members
}

# ---- loop capture: `[loop i in xs f(i)]`, `set[loop …]`, `[loop … k -> v]`
# collect each iteration's value (the compiler declares the container and
# adds every expressed value of the loop body through these)

let _capture_push = <T>(@values:array<T> value:T):>void => {
    values.push(value)
}

let _capture_add = <T>(@members:set<T> value:T):>void => {
    members.add(value)
}

let _capture_store = <K V>(@entries:dict<K V> key:K value:V):>void => {
    entries[key] = value
}

# Runtime diagnostics in the layout of the compiler's reports (`dewy/reporting.py`),
# with the same shape as that module: `Span`s and `Pointer`s, a `Theme`, a
# `SrcFile` excerpt that knows its lines and columns, `Segment`s (one pointer
# on one line, in columns), and a `Report` that renders itself:
#
#   Error: title
#
#     × message
#       ╭─[path:row:column]
#     N | source line
#       ·      ─┬─
#       ·       ╰─ pointer message
#       ╰───
#     note: first note
#           later notes
#     help: text
#
#   let report = Report("error" "sample")
#   report.point(12 17 "first operand")
#   report.note("a note")
#   report.render(SrcFile("input" 1 "let total = price * count + tax"))
#
# Spans are byte offsets into the excerpt (one or more source lines with no
# trailing newline); columns count characters (UTF-8 lead bytes). Everything
# goes to stderr, colored only when stderr is a terminal.
#
# Mirrors `reporting.py` for pointers within one line: several pointers per
# line in palette colors, underlines below the line (or above, for the first
# of two adjacent pointed lines), stacked messages with `│` connectors,
# zero-width pointers as `╱╲`, dimmed spans, notes, and help. Not yet:
# pointers spanning lines, blank-line markers, control-character glyphs,
# multi-line messages.
if $target in? ["x86_64" "riscv" "arm" "c"] {
    from p"linux/io.dewy" import (_write_stderr _stderr_is_terminal)
}

let Span:type = [
    start:int64
    stop:int64 = start
    is_zero_width = () => start >=? stop
    contains = (offset:int64):>bool => start <=? offset and offset <? stop
]

let Pointer:type = [span:Span message:string]

# ---- output helpers ----
let _print_repeated = (s:string count:int64):>void => {
    let i:int64 = 0
    loop i <? count {
        print(s)
        i += 1
    }
    return void
}

let _digit_count = (value:int64):>int64 => {
    let digits:int64 = 1
    let rest:int64 = value
    loop rest >=? 10 {
        rest = rest // 10
        digits += 1
    }
    return digits
}

let _write_byte = (byte:uint8):>void => {
    let one:array<uint8> = [byte]
    if _capture_output { _captured.push(byte)  return void }
    let written:int64 = _write_stderr(one)
    return void
}

let _is_continuation_byte = (byte:uint8):>bool => byte >=? 128 and byte <? 192

# ---- Theme: the ANSI colors of `reporting.py`, painted only on terminals ----
let Theme:type = [
    enabled:bool = false
    paint = (code:string) => { if enabled { print(code) } }
    reset = () => { if enabled { print("\u001b[0m") } }
    colored = (text:string code:string) => {
        paint(code)
        print(text)
        reset
    }
    severity_color = (severity:string):>string => {
        if severity =? "warning" { return "\u001b[33m" }
        if severity =? "info" { return "\u001b[34m" }
        if severity =? "hint" { return "\u001b[36m" }
        return "\u001b[31m"
    }
    label_color = ():>string => "\u001b[38;5;245m"
    dim_color = ():>string => "\u001b[90m"
    # the pointer palette, in the compiler's order
    pointer_color = (index:int64):>string => {
        let slot:int64 = index % 7
        if slot =? 0 { return "\u001b[96m" }         # cyan
        if slot =? 1 { return "\u001b[92m" }         # green
        if slot =? 2 { return "\u001b[93m" }         # yellow
        if slot =? 3 { return "\u001b[94m" }         # blue
        if slot =? 4 { return "\u001b[38;5;135m" }   # purple
        if slot =? 5 { return "\u001b[38;5;211m" }   # pink
        return "\u001b[38;5;214m"                    # light orange
    }
]

let _severity_label = (severity:string):>string => {
    if severity =? "warning" { return "Warning" }
    if severity =? "info" { return "Info" }
    if severity =? "hint" { return "Hint" }
    return "Error"
}

# ---- SrcFile: an excerpt of a source file, with its geometry ----
let SrcFile:type = [
    path:string
    first_row:int64      # the line number of the excerpt's first line
    body:string
    line_count = ():>int64 => {
        let bytes:array<uint8> = body as array<uint8>
        let count:int64 = 1
        let i:int64 = 0
        loop i <? bytes.length {
            if bytes[i] =? 10 { count += 1 }
            i += 1
        }
        return count
    }
    # the byte offset where `line` starts
    line_start = (line:int64):>int64 => {
        let bytes:array<uint8> = body as array<uint8>
        let current:int64 = 0
        let i:int64 = 0
        loop i <? bytes.length {
            if current =? line { return i }
            if bytes[i] =? 10 { current += 1 }
            i += 1
        }
        return bytes.length
    }
    # one past the last byte of `line`, excluding its newline
    line_end = (line:int64):>int64 => {
        let bytes:array<uint8> = body as array<uint8>
        let i:int64 = line_start(line)
        if i <? 0 { i = 0 }
        loop i <? bytes.length {
            if bytes[i] =? 10 { return i }
            i += 1
        }
        return bytes.length
    }
    line_of = (offset:int64):>int64 => {
        let bytes:array<uint8> = body as array<uint8>
        let line:int64 = 0
        let i:int64 = 0
        loop i <? offset {
            if i >=? 0 and i <? bytes.length {
                if bytes[i] =? 10 { line += 1 }
            }
            i += 1
        }
        return line
    }
    # characters (UTF-8 lead bytes) in bytes[first, stop)
    chars_between = (first:int64 stop:int64):>int64 => {
        let bytes:array<uint8> = body as array<uint8>
        let count:int64 = 0
        let i:int64 = first
        loop i <? stop {
            if i >=? 0 and i <? bytes.length {
                if not _is_continuation_byte(bytes[i]) { count += 1 }
            }
            i += 1
        }
        return count
    }
    # 1-based column of a byte offset within its line
    column_of = (offset:int64):>int64 => 1 + chars_between(line_start(line_of(offset)) offset)
    # the bytes of `line`, greying out the dimmed spans
    write_line = (line:int64 dimmed:array<Span> theme:Theme) => {
        let bytes:array<uint8> = body as array<uint8>
        let dimming:bool = false
        let i:int64 = line_start(line)
        let stop:int64 = line_end(line)
        loop i <? stop {
            if i >=? 0 and i <? bytes.length {
                let dim:bool = false
                loop span in dimmed { if span.contains(i) { dim = true } }
                if dim and not dimming { theme.paint(theme.dim_color) }
                if dimming and not dim { theme.reset }
                dimming = dim
                _write_byte(bytes[i])
            }
            i += 1
        }
        if dimming { theme.reset }
    }
]

# ---- Segment: one pointer on one line, in columns (reporting.py's `_Segment`) ----
let Segment:type = [
    pointer:int64        # index into the report's pointers
    start_col:int64
    end_col:int64        # exclusive; equals start_col for a zero-width pointer
    anchor_col:int64     # the column of its `┬`/`┴`/`╰`/`╭`
]

# ---- Report ----
let Report:type = [
    severity:string
    title:string
    message:string = ""          # the `× message` line; empty when none
    hint:string = ""             # the `help:` line; empty when none
    pointers:array<Pointer> = []
    dimmed:array<Span> = []
    notes:array<string> = []

    describe = (text:string) => { message = text }
    point = (start:int64 stop:int64 text:string) => { pointers.push(Pointer(Span(start stop) text)) }
    dim = (start:int64 stop:int64) => { dimmed.push(Span(start stop)) }
    note = (text:string) => { notes.push(text) }
    help = (text:string) => { hint = text }

    line_has_pointer = (line:int64 src:SrcFile):>bool => {
        loop p in pointers { if src.line_of(p.span.start) =? line { return true } }
        return false
    }

    # the pointers on `line`, with their columns
    segments_on = (line:int64 src:SrcFile):>array<Segment> => {
        let segments:array<Segment> = []
        let line_begin:int64 = src.line_start(line)
        let line_stop:int64 = src.line_end(line)
        let index:int64 = 0
        loop index <? pointers.length {
            let p:Pointer = pointers[index]
            if src.line_of(p.span.start) =? line {
                let stop:int64 = p.span.stop
                if stop >? line_stop { stop = line_stop }
                let start_col:int64 = src.chars_between(line_begin p.span.start)
                if stop <=? p.span.start {
                    # zero width: drawn as `╱╲` just before the position
                    if start_col >? 0 { start_col -= 1 }
                    segments.push(Segment(index start_col start_col start_col))
                } else {
                    let end_col:int64 = start_col + src.chars_between(p.span.start stop)
                    segments.push(Segment(index start_col end_col (start_col + (end_col - start_col - 1) // 2)))
                }
            }
            index += 1
        }
        return segments
    }

    # the spaces that align `╭`, `·`, and `╰` under the line-number gutter
    gutter = (digits:int64) => { _print_repeated(" " (3 + digits)) }
    marker_prefix = (digits:int64) => {
        gutter(digits)
        print"· "
    }

    # the `──┬──` (or `──┴──`) layer under (or over) the line
    print_baseline = (segments:array<Segment> width:int64 above:bool digits:int64 theme:Theme) => {
        marker_prefix(digits)
        let col:int64 = 0
        loop col <? width {
            let glyph:string = " "
            let color:string = ""
            loop seg in segments {
                if seg.end_col =? seg.start_col {
                    if col =? seg.start_col {
                        glyph = "╲"
                        if not above { glyph = "╱" }
                        color = theme.pointer_color(seg.pointer)
                    } else if col =? seg.start_col + 1 {
                        glyph = "╱"
                        if not above { glyph = "╲" }
                        color = theme.pointer_color(seg.pointer)
                    }
                } else if seg.start_col <=? col and col <? seg.end_col {
                    glyph = "─"
                    if col =? seg.anchor_col {
                        glyph = "┬"
                        if above { glyph = "┴" }
                    }
                    color = theme.pointer_color(seg.pointer)
                }
            }
            if glyph =? " " { print(glyph) } else { theme.colored(glyph color) }
            col += 1
        }
        print"\n"
    }

    # one `╰─ message` (below) or `╭─ message` (above) line for segment `q`,
    # with `│` connectors for the segments whose messages are still pending
    # (below) or already out (above)
    print_message_line = (segments:array<Segment> q:int64 printed:array<int64> above:bool digits:int64 theme:Theme) => {
        marker_prefix(digits)
        let anchor:int64 = 0
        let pointer:int64 = 0
        if q >=? 0 and q <? segments.length {
            anchor = segments[q].anchor_col
            pointer = segments[q].pointer
        }
        let col:int64 = 0
        loop col <? anchor {
            let glyph:string = " "
            let color:string = ""
            let other:int64 = 0
            loop other <? segments.length {
                if other <? printed.length {
                    let connects:bool = printed[other] =? 1
                    if not above { connects = printed[other] =? 0 }
                    if other not=? q and connects and segments[other].anchor_col =? col {
                        glyph = "│"
                        color = theme.pointer_color(segments[other].pointer)
                    }
                }
                other += 1
            }
            if glyph =? " " { print(glyph) } else { theme.colored(glyph color) }
            col += 1
        }
        theme.paint(theme.pointer_color(pointer))
        if above { print"╭─ " } else { print"╰─ " }
        if pointer >=? 0 and pointer <? pointers.length { print(pointers[pointer].message) }
        theme.reset
        print"\n"
    }

    # all message lines of a line: below, from the rightmost anchor inward;
    # above, from the leftmost outward
    print_message_lines = (segments:array<Segment> above:bool digits:int64 theme:Theme) => {
        let printed:array<int64> = []
        loop seg in segments { printed.push(0) }
        let remaining:int64 = segments.length
        loop remaining >? 0 {
            let chosen:int64 = -1
            let best:int64 = 0
            let q:int64 = 0
            loop q <? segments.length {
                if q <? printed.length {
                    if printed[q] =? 0 {
                        let anchor:int64 = segments[q].anchor_col
                        let better:bool = chosen <? 0
                        if not better {
                            if above { better = anchor <? best } else { better = anchor >? best }
                        }
                        if better {
                            chosen = q
                            best = anchor
                        }
                    }
                }
                q += 1
            }
            if chosen >=? 0 {
                print_message_line(segments chosen printed above digits theme)
                if chosen <? printed.length { printed[chosen] = 1 }
            }
            remaining -= 1
        }
    }

    # `  N | source line`, the number right-aligned to `digits`
    print_source_line = (line:int64 src:SrcFile digits:int64 theme:Theme) => {
        let row:int64 = src.first_row + line
        print"  "
        _print_repeated(" " (digits - _digit_count(row)))
        theme.paint(theme.label_color)
        print(row)
        theme.reset
        print" | "
        src.write_line(line dimmed theme)
        print"\n"
    }

    print_labelled = (label:string text:string theme:Theme) => {
        print"  "
        theme.colored(label theme.label_color)
        print" {text}\n"
    }

    # `note:` lines and `help:` after the excerpt
    print_trailer = (theme:Theme) => {
        let n:int64 = 0
        loop n <? notes.length {
            if n =? 0 { print_labelled("note:" notes[n] theme) } else { print"        {notes[n]}\n" }
            n += 1
        }
        if hint.length >? 0 { print_labelled("help:" hint theme) }
    }

    render = (src:SrcFile) => {
        _set_output_stderr(true)
        let theme = Theme(_stderr_is_terminal())
        let severity_color:string = theme.severity_color(severity)
        let label:string = _severity_label(severity)
        print"{label}: "
        theme.colored(title severity_color)
        print"\n\n"
        if message.length >? 0 {
            print"  "
            if severity =? "error" { theme.colored("×" severity_color) } else { theme.colored("•" severity_color) }
            print" {message}\n"
        }
        if pointers.length =? 0 {
            print_trailer(theme)
            return void
        }

        # the header points at the earliest pointer
        let first_offset:int64 = pointers[0].span.start
        let first_line:int64 = src.line_of(first_offset)
        let last_line:int64 = first_line
        loop p in pointers {
            if p.span.start <? first_offset { first_offset = p.span.start }
            let line:int64 = src.line_of(p.span.start)
            if line <? first_line { first_line = line }
            if line >? last_line { last_line = line }
        }
        let digits:int64 = _digit_count(src.first_row + last_line)
        gutter(digits)
        print"╭─[{src.path}:{src.first_row + src.line_of(first_offset)}:{src.column_of(first_offset)}]\n"

        # two adjacent pointed lines draw the first one's pointers above it
        let above_lines:array<int64> = []
        let l:int64 = 0
        let lines:int64 = src.line_count
        loop l <? lines {
            above_lines.push(0)
            l += 1
        }
        l = first_line
        loop l <=? last_line {
            if line_has_pointer(l src) and line_has_pointer(l + 1 src) {
                if l >=? 0 and l <? above_lines.length { above_lines[l] = 1 }
                l += 2
            } else {
                l += 1
            }
        }

        l = first_line
        loop l <=? last_line {
            let segments:array<Segment> = segments_on(l src)
            let width:int64 = 0
            loop seg in segments {
                let end:int64 = seg.end_col
                if seg.end_col =? seg.start_col { end = seg.start_col + 2 }
                if end >? width { width = end }
            }
            let above:bool = false
            if l >=? 0 and l <? above_lines.length { above = above_lines[l] =? 1 }
            if segments.length >? 0 and above {
                print_message_lines(segments true digits theme)
                print_baseline(segments width true digits theme)
            }
            print_source_line(l src digits theme)
            if segments.length >? 0 and not above {
                print_baseline(segments width false digits theme)
                print_message_lines(segments false digits theme)
            }
            l += 1
        }
        gutter(digits)
        print"╰───\n"
        print_trailer(theme)
        return void
    }
]

# ---- the report of a failed `$runtime_assert` or `$expect` (the compiler emits the calls) ----
# The condition is the pointer, its message the pointer text, and the
# `, message` tail of the source (up to `dim_stop`) is greyed out.
let _condition_report = (title:string start:int64 stop:int64 dim_stop:int64 message:string):>Report => {
    let report = Report("error" title)
    report.point(start stop message)
    if dim_stop >? stop { report.dim(stop dim_stop) }
    return report
}

let _assertion_report = (start:int64 stop:int64 dim_stop:int64 message:string):>Report => _condition_report("assertion failed" start stop dim_stop message)
let _expectation_report = (start:int64 stop:int64 dim_stop:int64 message:string):>Report => _condition_report("expectation failed" start stop dim_stop message)

let _assertion_note = (@report:Report text:string):>void => {
    report.note(text)
    return void
}

let _assertion_render = (report:Report path:string row:int64 line:string):>void => {
    report.render(SrcFile(path row line))
    return void
}


# let Error = type of Report & [severity='error']
# let Warning = type of Report & [severity='warning']
# let Info = type of Report & [severity='info']
# let Hint = type of Report & [severity='hint']



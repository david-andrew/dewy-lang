# Unicode 16.0.0 extended grapheme boundaries for validated UTF-8.
# The generated tables use sorted nine-byte records: little-endian start,
# little-endian end, and property. This is the same data and UAX #29 rule
# ordering used by the hosted compiler; no locale or host Unicode database
# participates at runtime.
$include_bytes(p"grapheme_break.bin") as break_table
$include_bytes(p"indic_conjunct_break.bin") as indic_table
$include_bytes(p"extended_pictographic.bin") as pictographic_table

const GCB=[other=0 cr=1 lf=2 control=3 l=4 v=5 t=6 lv=7 lvt=8 extend=9 zwj=10 spacing_mark=11 prepend=12 regional_indicator=13]
const INCB=[other=0 consonant=1 extend=2 linker=3]

# Tables are read in place: passing one as an `array<uint8>` argument would
# materialize a private copy of the whole table for every lookup.
const TABLE=[breaks=0 indic=1 pictographic=2]
table_length = (table:int64):>int64 => if table =? TABLE.breaks break_table.length else if table =? TABLE.indic indic_table.length else pictographic_table.length
table_byte = (table:int64 offset:int64):>int64 => {
    $runtime_assert offset >=? 0
    if table =? TABLE.breaks {
        $runtime_assert offset <? break_table.length
        return break_table[offset] as int64
    }
    if table =? TABLE.indic {
        $runtime_assert offset <? indic_table.length
        return indic_table[offset] as int64
    }
    $runtime_assert offset <? pictographic_table.length
    return pictographic_table[offset] as int64
}
word = (table:array<uint8> offset:int64):>int64 => {
    $runtime_assert table.length >=? 4
    $runtime_assert offset >=? 0 and offset <=? table.length-4
    let a=table[offset] as int64
    let b=table[offset+1] as int64
    let c=table[offset+2] as int64
    let d=table[offset+3] as int64
    return a+(b<<8)+(c<<16)+(d<<24)
}
table_word = (table:int64 offset:int64):>int64 => {
    let a=table_byte(table offset)
    let b=table_byte(table offset+1)
    let c=table_byte(table offset+2)
    let d=table_byte(table offset+3)
    return a+(b<<8)+(c<<16)+(d<<24)
}
property = (table:int64 scalar:int64):>int64 => {
    let low:int64=0
    let high:int64=table_length(table) // 9
    loop low <? high {
        let middle:int64=(low+high)//2
        let offset:int64=middle*9
        let start=table_word(table offset)
        let stop=table_word(table offset+4)
        if scalar <? start {high=middle}
        else if scalar >? stop {low=middle+1}
        else return table_byte(table offset+8)
    }
    return 0
}

# Stream the context needed by GB9c, GB11, and GB12/13 rather than retaining
# all preceding scalars. A byte offset marks the beginning of each cluster;
# the final offset is included, and empty text has the sole boundary zero.
# Offsets remain words here; descriptor storage decides its physical width.
# A zero destination collects public word offsets. The native string runtime
# supplies space for (byte_length+1) uint32 offsets instead, so segmentation
# writes the final table without a growable word array and a narrowing copy.
# A negative destination counts without writing either sink. The scanner
# returns -1 for malformed UTF-8, avoiding an allocated optional result on
# the count-only runtime path. Public wrappers retain their optional APIs.
let scan = (bytes:array<uint8> @result:array<int64> destination:int64):>int64 => {
    if destination =? 0 {result.push(0)} else if destination >? 0 {__store_u32__(0 destination)}
    let boundaries:int64=1
    let offset:int64=0
    let previous:int64=GCB.other
    let regional_run:int64=0
    let indic_context:int64=0   # 0 absent; 1 consonant; 2 consonant + linker
    let pictographic_chain:bool=false
    let zwj_after_pictographic:bool=false
    loop offset <? bytes.length {
        $runtime_assert offset >=? 0
        let first=bytes[offset] as int64
        # Printable ASCII after anything but a Prepend is always a boundary
        # and carries no Indic, pictographic, regional or Hangul state. Take
        # whole runs of it without the per-scalar classification below; the
        # state left behind is exactly what one ASCII "other" scalar leaves.
        if first >=? 0x20 and first <? 0x7f and previous not=? GCB.prepend {
            loop offset <? bytes.length and bytes[offset] >=? 0x20 and bytes[offset] <? 0x7f {
                if offset >? 0 {
                    if destination =? 0 {result.push(offset)}
                    else if destination >? 0 {__store_u32__(offset transmute uint32 destination+boundaries*4)}
                    boundaries+=1
                }
                offset+=1
            }
            previous=GCB.other
            regional_run=0
            zwj_after_pictographic=false
            pictographic_chain=false
            indic_context=0
            continue
        }
        let scalar:int64=first
        let count:int64=1
        let minimum:int64=0
        if first >=? 0xc2 and first <=? 0xdf {scalar=first and 0x1f count=2 minimum=0x80}
        else if first >=? 0xe0 and first <=? 0xef {scalar=first and 0x0f count=3 minimum=0x800}
        else if first >=? 0xf0 and first <=? 0xf4 {scalar=first and 0x07 count=4 minimum=0x10000}
        else if first >=? 0x80 return -1
        if count >? bytes.length-offset return -1
        let index:int64=1
        loop index <? count {
            let position:int64=offset+index
            $runtime_assert position >=? 0 and position <? bytes.length
            let next=bytes[position] as int64
            if next <? 0x80 or next >? 0xbf return -1
            scalar=(scalar<<6)+(next and 0x3f)
            index+=1
        }
        if scalar <? minimum or scalar >? 0x10ffff or scalar >=? 0xd800 and scalar <=? 0xdfff return -1
        # ASCII has no Indic or pictographic properties. Resolve its four
        # grapheme classes directly; CR/LF still follows GB3 below. Besides
        # avoiding binary searches, this keeps ordinary compiler text out of
        # the generic table argument-copy path.
        let current:int64=GCB.other
        let indic:int64=INCB.other
        let pictographic:bool=false
        if scalar <? 128 {
            if scalar =? 13 {current=GCB.cr}
            else if scalar =? 10 {current=GCB.lf}
            else if scalar <? 32 or scalar =? 127 {current=GCB.control}
        } else {
            current=property(TABLE.breaks scalar)
            indic=property(TABLE.indic scalar)
            pictographic=property(TABLE.pictographic scalar) =? 1
        }
        let boundary:bool=true
        if previous =? GCB.cr and current =? GCB.lf {boundary=false}
        else if previous =? GCB.cr or previous =? GCB.lf or previous =? GCB.control or current =? GCB.cr or current =? GCB.lf or current =? GCB.control {}
        else if previous =? GCB.l and (current =? GCB.l or current =? GCB.v or current =? GCB.lv or current =? GCB.lvt) {boundary=false}
        else if (previous =? GCB.lv or previous =? GCB.v) and (current =? GCB.v or current =? GCB.t) {boundary=false}
        else if (previous =? GCB.lvt or previous =? GCB.t) and current =? GCB.t {boundary=false}
        else if current =? GCB.extend or current =? GCB.zwj or current =? GCB.spacing_mark {boundary=false}
        else if previous =? GCB.prepend {boundary=false}
        else if indic =? INCB.consonant and indic_context =? 2 {boundary=false}
        else if pictographic and previous =? GCB.zwj and zwj_after_pictographic {boundary=false}
        else if previous =? GCB.regional_indicator and current =? GCB.regional_indicator and regional_run % 2 =? 1 {boundary=false}
        if offset >? 0 and boundary {
            if destination =? 0 {result.push(offset)}
            else if destination >? 0 {__store_u32__(offset transmute uint32 destination+boundaries*4)}
            boundaries+=1
        }

        regional_run=if current =? GCB.regional_indicator regional_run+1 else 0
        zwj_after_pictographic=current =? GCB.zwj and pictographic_chain
        if current not=? GCB.extend {pictographic_chain=pictographic}
        if indic =? INCB.consonant {indic_context=1}
        else if indic =? INCB.linker and indic_context >? 0 {indic_context=2}
        else if indic not=? INCB.extend {indic_context=0}
        previous=current
        offset+=count
    }
    if offset >? 0 {
        if destination =? 0 {result.push(offset)}
        else if destination >? 0 {__store_u32__(offset transmute uint32 destination+boundaries*4)}
        boundaries+=1
    }
    return boundaries-1
}

let segment = (bytes:array<uint8> @result:array<int64> destination:int64):>int64|none => {
    let count=scan(bytes @result destination)
    if count <? 0 return none
    return count
}

let boundaries = (bytes:array<uint8>):>array<int64>|none => {
    let result:array<int64>=[]
    let count=segment(bytes @result 0)
    if count is? none return none
    return result
}

# Internal storage interface, not a different segmentation rule. The caller
# owns the destination, including on invalid input, and reserves four bytes
# for every possible boundary (one more than the input byte count).
let write_boundaries = (bytes:array<uint8> destination:int64):>int64|none => {
    if destination =? 0 or bytes.length >? uint32.max return none
    let unused:array<int64>=[]
    return segment(bytes @unused destination)
}

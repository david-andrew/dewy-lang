# Portable integer math used by the compiler's operator routing.

# Arithmetic that cannot be proven safe yields one of these instead of a wrong
# value or a crash: the caller handles the branch (`is?`, `or_throw`).
let Overflow:type = type of error          # int64 parts would wrap
let DivisionByZero:type = type of error    # a divisor that is exactly zero at runtime

# `base ^ exponent` for a non-negative integer exponent, by squaring.
let _int_pow = (base:int64 exponent:int64):>int64 => {
    let result:int64 = 1
    loop exponent >? 0 {
        if exponent % 2 =? 1 { result = result * base }
        base = base * base
        exponent = exponent // 2
    }
    return result
}

# The smaller / larger of two integers.
let min = (a:int64 b:int64):>int64 => if a <? b a else b
let max = (a:int64 b:int64):>int64 => if a >? b a else b

# Unicode tables the prelude carries as data (after `path.dewy`: the
# include names its file with a path literal).

# ---- case folding (Unicode 16.0.0 CaseFolding.txt, statuses C and F)

# Sorted 16-byte records: the scalar, then up to three folded scalars
# (0 = none), little-endian; generated by `dewy/semantic/unicode/generate.py`.
$include_bytes(p"unicode/casefold.bin") as _casefold_table
let _CASEFOLD_RECORDS:int64 = 1557

let _casefold_word = (offset:int64<offset >=? 0 and offset <? 24909>):>int64 => {
    let b0:int64 = _casefold_table[offset] transmute int64
    let b1:int64 = _casefold_table[offset + 1] transmute int64
    let b2:int64 = _casefold_table[offset + 2] transmute int64
    let b3:int64 = _casefold_table[offset + 3] transmute int64
    return b0 + (b1 << 8) + (b2 << 16) + (b3 << 24)
}

# The record of a scalar, or -1 when it folds to itself.
let _casefold_record = (scalar:int64):>int64 => {
    let low:int64 = 0
    let high:int64 = _CASEFOLD_RECORDS
    loop low <? high {
        let middle:int64 = (low + high) // 2
        if middle >=? 0 and middle <? 1557 {
            let found:int64 = _casefold_word(middle * 16)
            if found =? scalar { return middle }
            if found <? scalar { low = middle + 1 } else { high = middle }
        } else {
            return -1
        }
    }
    return -1
}

# Case-insensitive comparison form: every scalar replaced by its full case
# folding (`"Straße".casefold` is `"strasse"`); other text is unchanged.
let _string_casefold = (text:string):>string => {
    let bytes:array<uint8> = []
    let scalars:array<uint32> = text as array<uint32>
    loop scalar in scalars {
        let code:int64 = scalar transmute int64
        let record:int64 = _casefold_record(code)
        if record >=? 0 and record <? 1557 {
            let base:int64 = record * 16
            loop slot in [1..4) {
                let folded:int64 = _casefold_word(base + slot * 4)
                if folded not=? 0 { _push_utf8(@bytes folded) }
            }
        } else {
            _push_utf8(@bytes code)
        }
    }
    return _string_of_utf8(bytes)
}

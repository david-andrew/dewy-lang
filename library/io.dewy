# Portable printing. The target layer provides `_write_stdout`/`_write_stderr`;
# everything here is target-independent policy. `$target` is resolved at
# compile time (udewy's gating, plus `in?` over a target list), so only the
# matching layer is imported. The native backends and the C backend all run
# on the Linux syscall layer for now.
if $target in? ["x86_64" "riscv" "arm" "c"] {
    from p"linux/io.dewy" import (_write_stdout _write_stderr)
}

# Diagnostics (a failed `$runtime_assert`) switch all printing to stderr.
let _stderr_output:bool = false
let _set_output_stderr = (enabled:bool):>void => {
    _stderr_output = enabled
    return void
}

let _print_string = (s:string):>void => {
    let bytes:array<uint8> = s as array<uint8>
    if _stderr_output {
        let written:int64 = _write_stderr(bytes)
    } else {
        let written:int64 = _write_stdout(bytes)
    }
    return void
}

let _print_int64 = (value:int64):>void => {
    if value <? 0 {
        _print_string("-")
        # Negating the minimum signed value would overflow.
        if value =? -9223372036854775808 {
            _print_string("9223372036854775808")
            return void
        }
        value = -value
    }
    if value >=? 10 {
        _print_int64(value // 10)
    }
    let digits = "0123456789"
    _print_string(digits[value % 10])
    return void
}

let _print_bool = (value:bool):>void => {
    if value {
        _print_string("true")
    } else {
        _print_string("false")
    }
    return void
}

# Rationals print as reduced fractions; whole values print as integers.
let _print_rational = (value:Rational):>void => {
    _print_int64(value.numerator)
    if value.denominator not =? 1 {
        _print_string("/")
        _print_int64(value.denominator)
    }
    return void
}

# Fixed-point values print in decimal with trailing zeros trimmed (up to
# nine fractional digits; the representation holds about 9.6).
let _print_fixed = (value:Fixed):>void => {
    let raw:int64 = value.raw
    if raw <? 0 {
        _print_string("-")
        raw = -raw
    }
    _print_int64(raw >> 32)
    let fraction:int64 = raw and 4294967295
    if fraction =? 0 { return void }
    let digits:array<int64 length=9> = [0 0 0 0 0 0 0 0 0]
    let last:int64 = -1
    loop i in [0..9) {
        fraction = fraction * 10
        digits[i] = fraction >> 32
        fraction = fraction and 4294967295
        if digits[i] not =? 0 { last = i }
    }
    if last <? 0 { return void }
    _print_string(".")
    loop i in [0..9) {
        if i <=? last { _print_int64(digits[i]) }
    }
    return void
}

# Big integers print in decimal from their base-10^9 chunks.
let _print_bigint = (value:BigInt):>void => {
    if value.negative { _print_string("-") }
    if value.limbs.length =? 0 { _print_string("0") return void }
    let chunks = _bigint_decimal_chunks(value.limbs)
    let i:int64 = chunks.length
    let first:bool = true
    loop i >? 0 {
        i = i - 1
        if i <? chunks.length {
            let chunk:int64 = chunks[i] transmute int64
            if first {
                _print_int64(chunk)
                first = false
            } else {
                let pad:int64 = 100000000
                loop pad >? chunk and pad >? 1 {
                    _print_string("0")
                    pad = pad // 10
                }
                _print_int64(chunk)
            }
        }
    }
    return void
}

let print = @_print_string & @_print_int64 & @_print_bool & @_print_rational & @_print_fixed & @_print_bigint

let printl = (s:string=''):>void => {
    print(s)
    print("\n")
}

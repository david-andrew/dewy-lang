# Portable printing. The target layer provides `_write_stdout`/`_write_stderr`;
# everything here is target-independent policy. `$target` is resolved at
# compile time (udewy's gating, plus `in?` over a target list), so only the
# matching layer is imported. The native backends and the C backend all run
# on the Linux syscall layer for now.
if $target in? ["x86_64" "riscv" "arm" "c"] {
    from p"linux/io.dewy" import (_write_stdout _write_stderr)
}

let _print_string = (s:string):>void => {
    let bytes:array<uint8> = s as array<uint8>
    let written:int64 = _write_stdout(bytes)
    return void
}

let _print_int64 = (value:int64):>void => {
    if value <? 0 {
        _print_string("-")
        # Negating the minimum signed value would overflow.
        if value =? -9223372036854775808 {
            _print_string("9223372036854775808")
            return void
        }
        value = -value
    }
    if value >=? 10 {
        _print_int64(value // 10)
    }
    let digits = "0123456789"
    _print_string(digits[value % 10])
    return void
}

let _print_bool = (value:bool):>void => {
    if value {
        _print_string("true")
    } else {
        _print_string("false")
    }
    return void
}

let print = _print_string & _print_int64 & _print_bool

let printl = (s:string):>void => {
    print(s)
    print("\n")
}

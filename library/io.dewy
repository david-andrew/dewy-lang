# Portable printing. The target layer provides `_write_stdout`/`_write_stderr`;
# everything here is target-independent policy. `$target` is resolved at
# compile time (udewy's gating, plus `in?` over a target list), so only the
# matching layer is imported. The native backends and the C backend all run
# on the Linux syscall layer for now.
if $target in? ["x86_64" "riscv" "arm" "c"] {
    from p"linux/io.dewy" import (_write_stdout _write_stderr _stdout_is_terminal)
    from p"linux/system.dewy" import (_exit)
}

# End the process with an exit status. `never` means control cannot continue
# past a call, so `exit` (and wrappers such as a `panic`) block the flow of
# broken states into later code.
let exit = (code:int64):>never => _exit(code)

# The failure path of a `$prototype` runtime check: the compile error that was
# deferred to runtime, already rendered, printed to stderr before exiting.
let _prototype_panic = (message:string):>never => {
    let written:int64 = _write_stderr(message as array<uint8>)
    _exit(102)
}

# Whether ordinary output goes to a terminal (colors are painted only then).
let _output_is_terminal = ():>bool => _stdout_is_terminal()

# Diagnostics (a failed `$runtime_assert`) switch all printing to stderr.
let _stderr_output:bool = false
let _set_output_stderr = (enabled:bool):>void => {
    _stderr_output = enabled
    return void
}

# Output capture (the test runner): while enabled, everything printed —
# stdout and stderr alike — is appended to `_captured` instead of written,
# so a test's output is shown only if it fails.
let _capture_output:bool = false
let _captured:array<uint8> = []
let _set_capture = (enabled:bool):>void => {
    _capture_output = enabled
    return void
}

let _print_bytes = (bytes:array<uint8>):>void => {
    if _capture_output {
        loop b in bytes { _captured.push(b) }
    } else if _stderr_output {
        let written:int64 = _write_stderr(bytes)
    } else {
        let written:int64 = _write_stdout(bytes)
    }
    return void
}

let _print_string = (s:string):>void => {
    let bytes:array<uint8> = s as array<uint8>
    _print_bytes(bytes)
    return void
}

let _print_int64 = (value:int64):>void => {
    if value <? 0 {
        _print_string("-")
        # Negating the minimum signed value would overflow.
        if value =? -9223372036854775808 {
            _print_string("9223372036854775808")
            return void
        }
        value = -value
    }
    if value >=? 10 {
        _print_int64(value // 10)
    }
    let digits = "0123456789"
    _print_string(digits[value % 10])
    return void
}

let _print_bool = (value:bool):>void => {
    if value {
        _print_string("true")
    } else {
        _print_string("false")
    }
    return void
}

# Rationals print as reduced fractions; whole values print as integers.
let _print_rational = (value:Rational):>void => {
    _print_int64(value.numerator)
    if value.denominator not =? 1 {
        _print_string("/")
        _print_int64(value.denominator)
    }
    return void
}

let _print_bigrational = (value:BigRational):>void => {
    if value =? 0 { _print_string("0") return void }
    _print_bigint(value.numerator)
    if not _bigint_is_one(value.denominator) {
        _print_string("/")
        _print_bigint(value.denominator)
    }
    return void
}

# Fixed-point values print in decimal with trailing zeros trimmed (up to
# nine fractional digits; the representation holds about 9.6).
let _print_fixed = (value:Fixed):>void => {
    let raw:int64 = value.raw
    if raw <? 0 {
        _print_string("-")
        raw = -raw
    }
    _print_int64(raw >> 32)
    let fraction:int64 = raw and 4294967295
    if fraction =? 0 { return void }
    let digits:array<int64 length=9> = [0 0 0 0 0 0 0 0 0]
    let last:int64 = -1
    loop i in [0..9) {
        fraction = fraction * 10
        digits[i] = fraction >> 32
        fraction = fraction and 4294967295
        if digits[i] not =? 0 { last = i }
    }
    if last <? 0 { return void }
    _print_string(".")
    loop i in [0..9) {
        if i <=? last { _print_int64(digits[i]) }
    }
    return void
}

# Big integers print in decimal from their base-10^9 chunks.
let _print_bigint = (value:BigInt):>void => {
    if value =? 0 { _print_string("0") return void }
    if value.sign <? 0 { _print_string("-") }
    let chunks = _bigint_decimal_chunks(value.limbs)
    let i:int64 = chunks.length
    let first:bool = true
    loop i >? 0 {
        i = i - 1
        if i <? chunks.length {
            let chunk:int64 = chunks[i] transmute int64
            if first {
                _print_int64(chunk)
                first = false
            } else {
                let pad:int64 = 100000000
                loop pad >? chunk and pad >? 1 {
                    _print_string("0")
                    pad = pad // 10
                }
                _print_int64(chunk)
            }
        }
    }
    return void
}

# `print(x)` prints a value by its type: the arms below are decided per
# instance (`value is? …` on a type parameter settles at compile time), and
# anything else prints as its `as string` text — a container or an object
# converts to its literal syntax through the shapes below (an object
# through its `__as__` when it declares one, else field by field). `printl`
# adds a newline. An interpolated argument is printed part by part by the
# compiler, each part passed to `print`, which is not observable.
let print = <T>(value:T):>void => {
    if value is? string { _print_string(value) }
    else if value is? int { _print_int64(value transmute int64) }
    else if value is? bool { _print_bool(value) }
    else if value is? Rational { _print_rational(value) }
    else if value is? BigRational { _print_bigrational(value) }
    else if value is? Fixed { _print_fixed(value) }
    else if value is? BigInt { _print_bigint(value) }
    else if value is? none { _print_string("none") }
    else {
        let text:string = value as string
        _print_string(text)
    }
}

let printl = <T>(value:T):>void => {
    print(value)
    print"\n"
}

# A string inside a structure is quoted, with the escapes of its literal syntax.
let _escaped = (g:string):>string => {
    if g =? "\n" { return "\\n" }
    if g =? "\t" { return "\\t" }
    if g =? "\r" { return "\\r" }
    if g =? "\\" { return "\\\\" }
    if g =? '"' { return '\\"' }
    return g
}

# The literal syntax of a container (`x as string`, an interpolation field,
# and so `print`): each builds its pieces and joins them; a member converts
# through `'{v}'`, so nesting is arbitrary. `quote` — decided by the compiler
# from the member type — marks string members: `[1 2 3]`, `set["a" "b"]`,
# `["a" -> 1]`.
let _quoted = (text:string):>string => {
    let pieces:array<string> = ['"']
    loop g in text { pieces.push(_escaped(g)) }
    pieces.push('"')
    return pieces.join
}

# A string of the arena's own (a copy of any string's bytes), for text a
# function builds and returns.
let _arena_text = (text:string):>string => {
    let pieces:array<string> = [text]
    return pieces.join      # a join built for the return lives in the arena
}

# A member's text inside a structure: a string member quoted when the
# container asks (`quote`), anything else — a number, `none`, an object —
# as it prints. The member test is decided per instance where the type
# settles it, and made at runtime for a union member.
let _member_text = <T>(v:T quote:bool):>string => {
    if v is? string {
        if quote { return _quoted(v) }
        return v
    }
    return _arena_text('{v}')
}

let _array_as_string = <T>(values:array<T> quote:bool):>string => {
    let pieces:array<string> = ["["]
    let first:bool = true
    loop v in values {
        if not first { pieces.push" " }
        first = false
        pieces.push(_member_text(v quote))
    }
    pieces.push"]"
    return pieces.join
}

let _set_as_string = <T>(members:set<T> quote:bool):>string => {
    let pieces:array<string> = ["set["]
    let first:bool = true
    loop v in members {
        if not first { pieces.push" " }
        first = false
        pieces.push(_member_text(v quote))
    }
    pieces.push"]"
    return pieces.join
}

let _dict_as_string = <K V>(entries:dict<K V> quote_keys:bool quote_values:bool):>string => {
    let pieces:array<string> = ["["]
    let first:bool = true
    loop [k v] in entries {
        if not first { pieces.push" " }
        first = false
        pieces.push(_member_text(k quote_keys))
        pieces.push" -> "
        pieces.push(_member_text(v quote_values))
    }
    pieces.push"]"
    return pieces.join
}

    __store_i64__(block head_address)
    return void
}
let _arena_release = (block:int64 size:int64):>void => {
    if block =? 0 { return void }
    # Region memory is released with its region, never block by block.
    if block >=? _region_low and block <? _region_high and _allocator_of(block) not=? 0 { return void }
    if _arena_free_lists =? 0 { _arena_free_lists = _arena_bump(512) }
    let class:int64 = 0
    if size >? 8 {
        let n:int64 = (size-1) >> 3
        if n >=? 4294967296 {n = n >> 32  class += 32}
        if n >=? 65536 {n = n >> 16  class += 16}
        if n >=? 256 {n = n >> 8  class += 8}
        if n >=? 16 {n = n >> 4  class += 4}
        if n >=? 4 {n = n >> 2  class += 2}
        if n >=? 2 {class += 1}
        class += 1
    }
    _arena_live_bytes -= 8 << (class as uint64)
    let head_address:int64 = _arena_free_lists + class * 8
    __store_i64__(__load_i64__(head_address) block)
    __store_i64__(block head_address)
    return void
}

# Native immutable strings use a private descriptor and shared byte/boundary
# backing. This is an implementation ownership boundary, not a source alias.
# The control stores refs, data, data size, boundaries, boundary size and a
# cached grapheme count, in the 64-byte arena class.
# A descriptor's owner word (offset 40) is zero for immortal literals. Views
# retain the original control even when their boundary/data pointers shift.
let _native_string_owner = (data:int64 size:int64 boundaries:int64 boundary_size:int64):>int64 => {
    let owner=_arena_alloc_64()
    __store_i64__(1 owner)
    __store_i64__(data owner+8)
    __store_i64__(size owner+16)
    __store_i64__(boundaries owner+24)
    __store_i64__(boundary_size owner+32)
    __store_i64__((-1) owner+40)  # unknown until counted or segmented
    return owner
}
let _native_string_view_owner = (value:int64):>int64 => {
    let owner=__load_i64__(value+40)
    # Static views own their descriptor, but never the literal's buffers.
    if owner =? 0 return _native_string_owner(0 0 0 0)
    let refs=__load_i64__(owner)
    if refs >? 0 {__store_i64__(refs+1 owner)}
    return owner
}
let _native_string_copy = (value:int64):>int64 => {
    let owner=__load_i64__(value+40)
    if owner =? 0 return value
    let refs=__load_i64__(owner)
    if refs <? 0 return value
    let copy=_arena_alloc_64()
    let offset:int64=0
    loop offset <? 48 {
        __store_i64__(__load_i64__(value+offset) copy+offset)
        offset+=8
    }
    __store_i64__(refs+1 owner)
    return copy
}
let _native_string_release = (value:int64):>void => {
    if value =? 0 return void
    let owner=__load_i64__(value+40)
    if owner =? 0 return void
    let refs=__load_i64__(owner)
    # Raw exposure has no tracked lifetime. Pin the backing and descriptor.
    if refs <? 0 return void
    refs-=1
    __store_i64__(refs owner)
    if refs =? 0 {
        _arena_release(__load_i64__(owner+8) __load_i64__(owner+16))
        _arena_release(__load_i64__(owner+24) __load_i64__(owner+32))
        _arena_release_64(owner)
    }
    _arena_release_64(value)
    return void
}
let _native_string_pin = (value:int64):>int64 => {
    let owner=__load_i64__(value+40)
    if owner not=? 0 {__store_i64__((-1) owner)}
    return value
}

# Shared descriptor ABI: the six visible words remain unchanged, with one
# private reference count immediately before an arena descriptor. Copying an
# immutable string retains that descriptor instead of allocating another.
# Backing refs count distinct descriptors (including slices), while the
# prefix counts handles to one descriptor. Static strings have no prefix.
# Keep the old copy/release helpers above for existing bootstrap seeds; a
# lowerer must select this complete helper family when constructing prefixes.
let _native_string_descriptor = ():>int64 => {
    let storage=_arena_alloc_64()
    __store_i64__(1 storage)
    return storage+8
}
let _native_string_retain = (value:int64):>int64 => {
    let owner=__load_i64__(value+40)
    if owner =? 0 return value
    if __load_i64__(owner) <? 0 return value
    if not _shareable(owner) return _native_string_clone(value)
    __store_i64__(__load_i64__(value-8)+1 value-8)
    return value
}
# A private copy of a string in the current context: its backing bytes and
# grapheme boundaries, and a descriptor with the same offsets into them.
let _native_string_clone = (value:int64):>int64 => {
    let owner=__load_i64__(value+40)
    let data=__load_i64__(owner+8)
    let size=__load_i64__(owner+16)
    let boundaries=__load_i64__(owner+24)
    let boundary_size=__load_i64__(owner+32)
    let copy_data=if size >? 0 _arena_alloc(size) else 0
    let index:int64=0
    loop index <? size { __store_u8__(__load_u8__(data+index) copy_data+index)  index+=1 }
    let copy_boundaries:int64=0
    if boundaries not=? 0 and boundary_size >? 0 {
        copy_boundaries=_arena_alloc(boundary_size)
        index=0
        loop index <? boundary_size { __store_u8__(__load_u8__(boundaries+index) copy_boundaries+index)  index+=1 }
    }
    let copy_owner=_native_string_owner(copy_data size copy_boundaries boundary_size)
    __store_i64__(__load_i64__(owner+40) copy_owner+40)
    let descriptor=_native_string_descriptor()
    __store_i64__(copy_data + (__load_i64__(value) - data) descriptor)
    __store_i64__(__load_i64__(value+8) descriptor+8)
    let view_boundaries=__load_i64__(value+16)
    __store_i64__(if view_boundaries =? 0 or boundaries =? 0 view_boundaries else copy_boundaries + (view_boundaries - boundaries) descriptor+16)
    __store_i64__(__load_i64__(value+24) descriptor+24)
    __store_i64__(__load_i64__(value+32) descriptor+32)
    __store_i64__(copy_owner descriptor+40)
    return descriptor
}
let _native_string_drop = (value:int64):>void => {
    if value =? 0 return void
    let owner=__load_i64__(value+40)
    if owner =? 0 return void
    let refs=__load_i64__(owner)
    # Exposure pins all views of this backing, as in the earlier ABI.
    if refs <? 0 return void
    let handles=__load_i64__(value-8)-1
    __store_i64__(handles value-8)
    if handles >? 0 return void
    refs-=1
    __store_i64__(refs owner)
    if refs =? 0 {
        _arena_release(__load_i64__(owner+8) __load_i64__(owner+16))
        _arena_release(__load_i64__(owner+24) __load_i64__(owner+32))
        _arena_release_64(owner)
    }
    _arena_release_64(value-8)
    return void
}

# Regions — the scoped-arena tier. A region is a bump allocator over 64 KB
# chunks (an oversized allocation gets a run of chunks of its own) that is
# released as a whole: its chunks go back to a free list for the next region.
# `$allocator(@arena) { ... }` makes an arena's region the allocation context
# of a block; hosted lowering also gives a function a *frame region* for the
# string storage that provably never leaves the frame. A header is three
# words: cursor, end, first chunk; a chunk starts with two words: next chunk,
# size.
#
# Every region chunk lies in one reserved address range, so whether an
# address belongs to a region, and to which, is a range check and one load
# from the owner table: nothing is read near an arbitrary (static or stack)
# address. The owner of a chunk in use is its region header; a free chunk's
# owner is -1, still region memory, so a stray release of it is ignored.
let _region_headers:int64 = 0     # free list of headers
let _region_chunks:int64 = 0      # free list of standard chunks
let _region_runs:int64 = 0        # free list of oversized runs: next, size
# Reserved ranges (PROT_NONE until used): up to 32 entries of four words,
# base, end, cursor and owner table (one word per chunk). A range is 1 GB,
# or smaller when the address-space limit refuses that; another is reserved
# when one fills. `_region_low`/`_region_high` bound all of them.
let _region_ranges:int64 = 0
let _region_range_count:int64 = 0
let _region_low:int64 = 0
let _region_high:int64 = 0
# The region of the innermost `$allocator` block; 0 is the process heap.
let _allocator_context:int64 = 0

# Chunks are 65536 bytes (shift 16).

# The range entry holding an address, or 0.
let _region_range_of = (address:int64):>int64 => {
    if address <? _region_low or address >=? _region_high return 0
    let index:int64 = 0
    loop index <? _region_range_count {
        let entry:int64 = _region_ranges + index * 32
        if address >=? __load_i64__(entry) and address <? __load_i64__(entry + 16) return entry
        index += 1
    }
    return 0
}
# The region that owns an address: its header, -1 for a free region chunk,
# 0 for anything else (heap, frame, static data).
let _allocator_of = (address:int64):>int64 => {
    let entry:int64 = _region_range_of(address)
    if entry =? 0 return 0
    return __load_i64__(__load_i64__(entry + 24) + ((address - __load_i64__(entry)) >> 16) * 8)
}
let _region_set_owner = (chunk:int64 size:int64 owner:int64):>void => {
    let entry:int64 = _region_range_of(chunk)
    if entry =? 0 return void
    let owners:int64 = __load_i64__(entry + 24)
    let unit:int64 = (chunk - __load_i64__(entry)) >> 16
    let stop:int64 = unit + (size >> 16)
    loop unit <? stop {
        __store_i64__(owner owners + unit * 8)
        unit += 1
    }
    return void
}
# Reserve a range of at least `size` bytes; 0 when the address space is full.
let _region_reserve = (size:int64):>int64 => {
    if _region_ranges =? 0 { _region_ranges = __syscall6__(9 0 4096 3 34 (-1) 0) }
    if _region_range_count >=? 32 return 0
    let reserved:int64 = 1073741824
    if reserved <? size { reserved = size }
    let base:int64 = -1
    loop base <? 0 and reserved >=? size {
        # mmap(NULL reserved+64 KB PROT_NONE MAP_PRIVATE|MAP_ANONYMOUS|MAP_NORESERVE -1 0)
        base = __syscall6__(9 0 reserved + 65536 0 16418 (-1) 0)
        if base <? 0 {
            if reserved >? size and reserved >? 1048576 { reserved = reserved >> 1 } else { return 0 }
            if reserved <? size { reserved = size }
        }
    }
    let owners:int64 = __syscall6__(9 0 (((reserved >> 16) * 8 + 4095) >> 12) << 12 3 34 (-1) 0)
    if owners <? 0 return 0
    let aligned:int64 = ((base + 65536 - 1) >> 16) << 16
    let entry:int64 = _region_ranges + _region_range_count * 32
    __store_i64__(aligned entry)
    __store_i64__(aligned + reserved entry + 8)
    __store_i64__(aligned entry + 16)
    __store_i64__(owners entry + 24)
    _region_range_count += 1
    if _region_low =? 0 or aligned <? _region_low { _region_low = aligned }
    if aligned + reserved >? _region_high { _region_high = aligned + reserved }
    return entry
}
# A run of `size` bytes (a multiple of the chunk size) from a reserved
# range, readable and writable, zero, owned by `owner`.
let _region_map = (size:int64 owner:int64):>int64 => {
    let entry:int64 = 0
    if _region_range_count >? 0 { entry = _region_ranges + (_region_range_count - 1) * 32 }
    if entry =? 0 or __load_i64__(entry + 16) + size >? __load_i64__(entry + 8) { entry = _region_reserve(size) }
    if entry =? 0 return 0
    let chunk:int64 = __load_i64__(entry + 16)
    __store_i64__(chunk + size entry + 16)
    # mprotect(chunk size PROT_READ|PROT_WRITE)
    let status:int64 = __syscall3__(10 chunk size 3)
    _region_set_owner(chunk size owner)
    return chunk
}
# Whether a handle to `block` may be shared in the current context: heap
# storage outlives every block, and a region shares within its own block.
# Anything else is copied, so nothing escapes the region it lives in.
let _shareable = (block:int64):>bool => {
    if _region_high =? 0 return true
    let owner:int64 = _allocator_of(block)
    return owner =? 0 or owner =? _allocator_context
}
# Growth and rebuilding allocate where the structure being grown lives, not
# in the current context: a heap array pushed inside an `$allocator` block
# stays heap storage.
let _arena_alloc_for = (anchor:int64 size:int64):>int64 => {
    if _allocator_context =? 0 and _region_high =? 0 return _arena_alloc(size)
    let owner:int64 = _allocator_of(anchor)
    if owner <? 0 { owner = 0 }
    if owner =? _allocator_context return _arena_alloc(size)
    let context:int64 = _allocator_context
    _allocator_context = owner
    let block:int64 = _arena_alloc(size)
    _allocator_context = context
    return block
}
# Allocation in the current `$allocator` block's region: cleared like a
# recycled heap block, since region chunks are reused without clearing.
let _context_alloc = (size:int64):>int64 => {
    let aligned:int64 = ((size + 7) // 8) * 8
    let block:int64 = _region_alloc(_allocator_context aligned)
    let cursor:int64 = block
    let stop:int64 = block + aligned
    loop cursor + 32 <=? stop {
        __store_i64__(0 cursor) __store_i64__(0 cursor+8) __store_i64__(0 cursor+16) __store_i64__(0 cursor+24)
        cursor = cursor + 32
    }
    loop cursor <? stop { __store_i64__(0 cursor)  cursor = cursor + 8 }
    return block
}

let _region_new = ():>int64 => {
    let header:int64 = _region_headers
    if header =? 0 {
        # A header is heap storage even inside another region's block.
        let context:int64 = _allocator_context
        _allocator_context = 0
        header = _arena_alloc(24)
        _allocator_context = context
    } else { _region_headers = __load_i64__(header) }
    __store_i64__(0 header)
    let end_address:int64 = header + 8
    __store_i64__(0 end_address)
    let first_address:int64 = header + 16
    __store_i64__(0 first_address)
    return header
}

let _region_alloc = (region:int64 size:int64):>int64 => {
    let aligned:int64 = ((size + 7) // 8) * 8
    let end_address:int64 = region + 8
    let cursor:int64 = __load_i64__(region)
    let limit:int64 = __load_i64__(end_address)
    if cursor + aligned >? limit {
        let chunk_size:int64 = 65536
        if aligned + 16 >? chunk_size { chunk_size = ((aligned + 16 + 65536 - 1) >> 16) << 16 }
        let chunk:int64 = 0
        if chunk_size =? 65536 and _region_chunks not=? 0 {
            chunk = _region_chunks
            _region_chunks = __load_i64__(chunk)
            _region_set_owner(chunk chunk_size region)
        } else if chunk_size >? 65536 {
            # Reuse a released run of exactly this size, else map a new one.
            let previous:int64 = 0
            let run:int64 = _region_runs
            loop run not=? 0 and chunk =? 0 {
                if __load_i64__(run + 8) =? chunk_size {
                    chunk = run
                    if previous =? 0 { _region_runs = __load_i64__(run) } else { __store_i64__(__load_i64__(run) previous) }
                } else {
                    previous = run
                    run = __load_i64__(run)
                }
            }
            if chunk =? 0 { chunk = _region_map(chunk_size region) } else { _region_set_owner(chunk chunk_size region) }
        } else {
            chunk = _region_map(chunk_size region)
        }
        let first_address:int64 = region + 16
        __store_i64__(__load_i64__(first_address) chunk)
        let size_address:int64 = chunk + 8
        __store_i64__(chunk_size size_address)
        __store_i64__(chunk first_address)
        cursor = chunk + 16
        limit = chunk + chunk_size
        __store_i64__(limit end_address)
    }
    __store_i64__(cursor + aligned region)
    return cursor
}

# empty a region (its chunks go back) but keep it usable: a loop's region is
# reset at the end of every iteration
let _region_reset = (region:int64):>void => {
    let first_address:int64 = region + 16
    let chunk:int64 = __load_i64__(first_address)
    loop chunk not=? 0 {
        let next:int64 = __load_i64__(chunk)
        let size_address:int64 = chunk + 8
        let size:int64 = __load_i64__(size_address)
        _region_set_owner(chunk size (-1))
        if size =? 65536 {
            __store_i64__(_region_chunks chunk)
            _region_chunks = chunk
        } else {
            __store_i64__(_region_runs chunk)
            _region_runs = chunk
        }
        chunk = next
    }
    __store_i64__(0 region)
    let end_address:int64 = region + 8
    __store_i64__(0 end_address)
    __store_i64__(0 first_address)
    return void
}

let _region_release = (region:int64):>void => {
    _region_reset(region)
    __store_i64__(_region_headers region)
    _region_headers = region
    return void
}

# Entering an `$allocator(@arena)` block makes the arena's region (created on
# first use) the context and returns the previous context; every exit of the
# block restores that.
let _allocator_enter = (@arena:Arena):>int64 => {
    if arena.handle =? 0 {arena.handle=_region_new()}
    let previous:int64=_allocator_context
    _allocator_context=arena.handle
    return previous
}
let _allocator_exit = (previous:int64):>void => {
    _allocator_context=previous
    return void
}

# A scratch allocator for `$allocator(@arena) { ... }` blocks: allocations
# bump through its chunks, releases are free, and `reset` (or dropping the
# arena) returns every chunk at once. Nothing allocated in it can outlive it:
# a value stored anywhere another allocator owns is copied there.
Arena = type of [
    handle:int64 = 0
    reset = ():>void => {
        if handle not=? 0 {_region_release(handle)}
        handle = 0
    }
    $__drop__
    release = ():>void => {
        if handle not=? 0 {_region_release(handle)}
    }
]

# Process exit: exit_group(2) is syscall 231. The checker has no
# never-returning functions yet, so the signature says `void`; callers that
# need divergence (the `$runtime_assert` failure path) mark it themselves.
let _exit = (status:int64):>never => {
    let ignored:int64 = __syscall1__(231 status)
    __unreachable__()
}

# The prepared tree of a union member in a cell whose layout the writer does
# not know (a function's result cell, declared by the caller under a possibly
# wider union): the cell lists (tag tree) pairs after its count word.
let _union_tree = (cell:int64 tag:int64):>int64 => {
    let count:int64 = __load_i64__(cell + 16)
    i:int64 = 0
    loop i <? count {
        let entry:int64 = cell + 24 + i * 16
        if __load_i64__(entry) =? tag return __load_i64__(entry + 8)
        i += 1
    }
    return 0
}

# Linux x86_64 system facilities.  Future targets can provide the same public
# bindings with platform-appropriate implementations.

# Durations are rational seconds at this boundary (the canonical Time scale);
# the kernel wants whole nanoseconds.
# The duration is a fixed-width rational: constants fit, and a runtime big
# rational must be narrowed by the caller.
let sleep = (duration:(rational<int64> * Time)):>void => {
    let seconds:Rational = duration transmute Rational
    let total_nanoseconds:uint64 = ((seconds.numerator * 1000000000) // seconds.denominator) transmute uint64
    let request:int64 = __alloca__(16)
    let request_nanoseconds:int64 = request + 8
    __store_u64__(__unsigned_idiv__(total_nanoseconds 1000000000) request)
    __store_u64__(__unsigned_mod__(total_nanoseconds 1000000000) request_nanoseconds)
    let status:int64 = __syscall2__(35 request 0)
    return void
}

# Arena allocation — the first dynamic storage tier of the ownership model.
# Blocks come in power-of-two size classes (8 bytes … 2^47): `_arena_alloc`
# takes a released block of the class from its free list, or bumps the
# current mmap chunk; `_arena_release` puts a block back for reuse. A reused
# block is zeroed, like a fresh one. The compiler releases what it can prove
# dead (a growable array's old buffer after growth, the array of a local at
# the end of its scope); everything else lives for the process, until
# scoped arenas land.
let _arena_cursor:int64 = 0
let _arena_end:int64 = 0
let _arena_free_lists:int64 = 0     # 48 list heads, one per size class, allocated on first use

let _arena_class = (size:int64):>int64 => {
    let class:int64 = 0
    let width:int64 = 8
    loop width <? size { width = width * 2  class += 1 }
    return class
}

let _arena_width = (class:int64):>int64 => {
    let width:int64 = 8
    let c:int64 = 0
    loop c <? class { width = width * 2  c += 1 }
    return width
}

let _arena_bump = (size:int64):>int64 => {
    let aligned:int64 = ((size + 7) // 8) * 8
    if _arena_cursor + aligned >? _arena_end {
        let chunk:int64 = 1048576
        if aligned >? chunk { chunk = aligned }
        # mmap(NULL chunk PROT_READ|PROT_WRITE MAP_PRIVATE|MAP_ANONYMOUS fd=-1 0)
        let base:int64 = __syscall6__(9 0 chunk 3 34 (-1) 0)
        _arena_cursor = base
        _arena_end = base + chunk
    }
    let result:int64 = _arena_cursor
    _arena_cursor = _arena_cursor + aligned
    return result
}

let _arena_alloc = (size:int64):>int64 => {
    if _arena_free_lists =? 0 { _arena_free_lists = _arena_bump(384) }
    let class:int64 = _arena_class(size)
    let head_address:int64 = _arena_free_lists + class * 8
    let block:int64 = __load_i64__(head_address)
    let width:int64 = _arena_width(class)
    if block =? 0 { return _arena_bump(width) }
    __store_i64__(__load_i64__(block) head_address)     # pop: the block's first word is the next free block
    let cursor:int64 = block
    let stop:int64 = block + width
    loop cursor <? stop { __store_i64__(0 cursor)  cursor = cursor + 8 }
    return block
}

let _arena_release = (block:int64 size:int64):>void => {
    if block =? 0 { return void }
    if _arena_free_lists =? 0 { _arena_free_lists = _arena_bump(384) }
    let class:int64 = _arena_class(size)
    let head_address:int64 = _arena_free_lists + class * 8
    __store_i64__(__load_i64__(head_address) block)
    __store_i64__(block head_address)
    return void
}

# Regions — the scoped-arena tier. A region is a bump allocator over 64 KB
# chunks (an oversized allocation gets a chunk of its own) that is released
# as a whole: its chunks go back to a free list for the next region. The
# compiler gives a function a *frame region* for the string storage that
# provably never leaves the frame — slices, decoded bytes, joins — and
# releases it at every exit. A header is three words: cursor, end, first
# chunk; a chunk starts with two words: next chunk, size.
let _region_headers:int64 = 0     # free list of headers
let _region_chunks:int64 = 0      # free list of 65536-byte chunks

let _region_new = ():>int64 => {
    let header:int64 = _region_headers
    if header =? 0 { header = _arena_alloc(24) } else { _region_headers = __load_i64__(header) }
    __store_i64__(0 header)
    let end_address:int64 = header + 8
    __store_i64__(0 end_address)
    let first_address:int64 = header + 16
    __store_i64__(0 first_address)
    return header
}

let _region_alloc = (region:int64 size:int64):>int64 => {
    let aligned:int64 = ((size + 7) // 8) * 8
    let end_address:int64 = region + 8
    let cursor:int64 = __load_i64__(region)
    let limit:int64 = __load_i64__(end_address)
    if cursor + aligned >? limit {
        let chunk_size:int64 = 65536
        if aligned + 16 >? chunk_size { chunk_size = aligned + 16 }
        let chunk:int64 = 0
        if chunk_size =? 65536 and _region_chunks not=? 0 {
            chunk = _region_chunks
            _region_chunks = __load_i64__(chunk)
        } else {
            chunk = _arena_alloc(chunk_size)
        }
        let first_address:int64 = region + 16
        __store_i64__(__load_i64__(first_address) chunk)
        let size_address:int64 = chunk + 8
        __store_i64__(chunk_size size_address)
        __store_i64__(chunk first_address)
        cursor = chunk + 16
        limit = chunk + chunk_size
        __store_i64__(limit end_address)
    }
    __store_i64__(cursor + aligned region)
    return cursor
}

# empty a region (its chunks go back) but keep it usable: a loop's region is
# reset at the end of every iteration
let _region_reset = (region:int64):>void => {
    let first_address:int64 = region + 16
    let chunk:int64 = __load_i64__(first_address)
    loop chunk not=? 0 {
        let next:int64 = __load_i64__(chunk)
        let size_address:int64 = chunk + 8
        let size:int64 = __load_i64__(size_address)
        if size =? 65536 {
            __store_i64__(_region_chunks chunk)
            _region_chunks = chunk
        } else {
            _arena_release(chunk size)
        }
        chunk = next
    }
    __store_i64__(0 region)
    let end_address:int64 = region + 8
    __store_i64__(0 end_address)
    __store_i64__(0 first_address)
    return void
}

let _region_release = (region:int64):>void => {
    _region_reset(region)
    __store_i64__(_region_headers region)
    _region_headers = region
    return void
}

# Process exit: exit_group(2) is syscall 231. The checker has no
# never-returning functions yet, so the signature says `void`; callers that
# need divergence (the `$runtime_assert` failure path) mark it themselves.
let _exit = (status:int64):>never => {
    let ignored:int64 = __syscall1__(231 status)
    __unreachable__()
}

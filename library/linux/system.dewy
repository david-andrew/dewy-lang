# Linux x86_64 system facilities.  Future targets can provide the same public
# bindings with platform-appropriate implementations.

# Durations are rational seconds at this boundary (the canonical Time scale);
# the kernel wants whole nanoseconds.
# The duration is a fixed-width rational: constants fit, and a runtime big
# rational must be narrowed by the caller.
let sleep = (duration:(rational<int64> * Time)):>void => {
    let seconds:Rational = duration transmute Rational
    let total_nanoseconds:uint64 = ((seconds.numerator * 1000000000) // seconds.denominator) transmute uint64
    let request:int64 = __alloca__(16)
    let request_nanoseconds:int64 = request + 8
    __store_u64__(__unsigned_idiv__(total_nanoseconds 1000000000) request)
    __store_u64__(__unsigned_mod__(total_nanoseconds 1000000000) request_nanoseconds)
    let status:int64 = __syscall2__(35 request 0)
    return void
}

# Arena allocation — the first dynamic storage tier of the ownership model.
# Blocks come in power-of-two size classes (8 bytes … 2^47): `_arena_alloc`
# takes a released block of the class from its free list, or bumps the
# current mmap chunk; `_arena_release` puts a block back for reuse. A reused
# block is zeroed, like a fresh one. The compiler releases what it can prove
# dead (a growable array's old buffer after growth, the array of a local at
# the end of its scope); everything else lives for the process, until
# scoped arenas land.
let _arena_cursor:int64 = 0
let _arena_end:int64 = 0
let _arena_free_lists:int64 = 0     # 64 list heads: 48 power-of-two classes, then the headed-record classes below; allocated on first use
# Internal performance counters count size-class payload bytes, not mmap
# metadata or resident pages. They make copy/reclamation regressions visible
# on bounded workloads without another full bootstrap run.
let _arena_allocated_bytes:int64 = 0
let _arena_live_bytes:int64 = 0
let _arena_peak_bytes:int64 = 0
let _arena_copied_bytes:int64 = 0
let _arena_note_copy = (size:int64):>void => {_arena_copied_bytes+=size}


let _arena_class = (size:int64):>int64 => {
    # Most descriptors fit in the first four classes. Larger requests use
    # bit-length of ceil(size/8)-1, with bounded work instead of doubling a
    # width once per class on every allocation and release.
    if size <=? 16 {return if size <=? 8 0 else 1}
    if size <=? 64 {return if size <=? 32 2 else 3}
    if size <=? 256 {return if size <=? 128 4 else 5}
    let remaining:int64=(size-1)>>3
    let class:int64 = 0
    if remaining >=? 4294967296 {remaining = remaining >> 32 class += 32}
    if remaining >=? 65536 {remaining = remaining >> 16 class += 16}
    if remaining >=? 256 {remaining = remaining >> 8 class += 8}
    if remaining >=? 16 {remaining = remaining >> 4 class += 4}
    if remaining >=? 4 {remaining = remaining >> 2 class += 2}
    if remaining >=? 2 {class += 1}
    return class+1
}

let _arena_width = (class:int64):>int64 => {
    # Preserve the old nonpositive-class result. Dewy's defined wide shifts
    # also preserve the wrapped zero for classes beyond the machine word.
    return if class <=? 0 8 else 8 << (class as uint64)
}

let _arena_bump = (size:int64):>int64 => {
    let aligned:int64 = ((size + 7) // 8) * 8
    if _arena_cursor + aligned >? _arena_end {
        let chunk:int64 = 1048576
        if aligned >? chunk { chunk = aligned }
        # mmap(NULL chunk PROT_READ|PROT_WRITE MAP_PRIVATE|MAP_ANONYMOUS fd=-1 0)
        let base:int64 = __syscall6__(9 0 chunk 3 34 (-1) 0)
        _arena_cursor = base
        _arena_end = base + chunk
    }
    let result:int64 = _arena_cursor
    _arena_cursor = _arena_cursor + aligned
    return result
}

# Size class and width are computed inline: on backends without an
# optimizer, three helper calls per allocation cost more than the bookkeeping.
let _arena_alloc = (size:int64):>int64 => {
    if _allocator_context not=? 0 { return _context_alloc(size) }
    if _arena_free_lists =? 0 { _arena_free_lists = _arena_bump(512) }
    let class:int64 = 0
    if size >? 8 {
        let n:int64 = (size-1) >> 3
        if n >=? 4294967296 {n = n >> 32  class += 32}
        if n >=? 65536 {n = n >> 16  class += 16}
        if n >=? 256 {n = n >> 8  class += 8}
        if n >=? 16 {n = n >> 4  class += 4}
        if n >=? 4 {n = n >> 2  class += 2}
        if n >=? 2 {class += 1}
        class += 1
    }
    let width:int64 = 8 << (class as uint64)
    let head_address:int64 = _arena_free_lists + class * 8
    let block:int64 = __load_i64__(head_address)
    _arena_allocated_bytes += width
    _arena_live_bytes += width
    if _arena_live_bytes >? _arena_peak_bytes {_arena_peak_bytes=_arena_live_bytes}
    # Fresh bump memory is zero already; only recycled blocks need clearing.
    if block =? 0 { return _arena_bump(width) }
    __store_i64__(__load_i64__(block) head_address)     # pop: the block's first word is the next free block
    let cursor:int64 = block
    let stop:int64 = block + width
    # Widths are powers of two: from 64 bytes on, clear eight words per step.
    # Without an optimizing backend the loop overhead otherwise dominates.
    if width >=? 64 {
        loop cursor <? stop {
            __store_i64__(0 cursor) __store_i64__(0 cursor+8) __store_i64__(0 cursor+16) __store_i64__(0 cursor+24)
            __store_i64__(0 cursor+32) __store_i64__(0 cursor+40) __store_i64__(0 cursor+48) __store_i64__(0 cursor+56)
            cursor = cursor + 64
        }
        return block
    }
    loop cursor <? stop { __store_i64__(0 cursor)  cursor = cursor + 8 }
    return block
}
# Size-class specializations for the sizes generated code allocates most:
# no class computation and no width argument on the hot path. Generated
# code selects one by constant size; other sizes use the general entries.


    let head_address:int64 = _arena_free_lists + 0
    let block:int64 = __load_i64__(head_address)
    _arena_allocated_bytes += 8
    _arena_live_bytes += 8
    if _arena_live_bytes >? _arena_peak_bytes {_arena_peak_bytes=_arena_live_bytes}
    if block =? 0 { return _arena_bump(8) }
    __store_i64__(__load_i64__(block) head_address)
    __store_i64__(0 block+0)
    return block
}
let _arena_release_8 = (block:int64):>void => {
    if block =? 0 { return void }
    if block >=? _region_low and block <? _region_high and _allocator_of(block) not=? 0 { return void }
    if _arena_free_lists =? 0 { _arena_free_lists = _arena_bump(512) }
    _arena_live_bytes -= 8
    let head_address:int64 = _arena_free_lists + 0
    __store_i64__(__load_i64__(head_address) block)
    __store_i64__(block head_address)
    return void
}


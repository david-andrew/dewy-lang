# Processes and directories over Linux syscalls: fork=57, execve=59,
# wait4=61, getdents64=217. Loaded before `path.dewy` with `files.dewy`, so
# `Path` can list itself. Every outcome is a value: a child's exit status,
# or `SpawnError` when it could not be started.
let SpawnError:type = type of error       # fork or exec failed

# A NUL-terminated copy of a string, as the kernel wants it.
let _c_string = (text:string):>array<uint8> => {
    let bytes:array<uint8> = text as array<uint8>
    let buffer:array<uint8> = []
    loop b in bytes buffer.push(b)
    buffer.push(0)
    return buffer
}

# This process's environment as the kernel handed it over: `NAME=value`
# entries, each NUL-terminated (Linux exposes it as /proc/self/environ).
let _environment_bytes = ():>array<uint8> => {
    match _read_bytes_at("/proc/self/environ") {
        bytes:array<uint8> => return bytes
        _ => return []
    }
}

# `environ[start..stop)` is one `NAME=value` entry: its value when the name is `wanted`.
let _environment_value = (environ:array<uint8> start:int64 stop:int64 wanted:array<uint8>):>string|undefined => {
    let equals:int64 = start + wanted.length
    if equals >=? stop { return undefined }
    if equals >=? environ.length { return undefined }
    if equals <? 0 { return undefined }
    let k:int64 = 0
    loop k <? wanted.length {
        let index:int64 = start + k
        if index <? 0 { return undefined }
        if index >=? environ.length { return undefined }
        if environ[index] not=? wanted[k] { return undefined }
        k += 1
    }
    if environ[equals] not=? 61 { return undefined }   # `=`
    let value_bytes:array<uint8> = []
    let j:int64 = equals + 1
    loop j <? stop {
        if j >=? 0 and j <? environ.length { value_bytes.push(environ[j]) }
        j += 1
    }
    let text = value_bytes as string|undefined
    match text {
        s:string => return s
        <undefined> => return undefined
    }
}

# The value of an environment variable, or `undefined` when it is not set.
let environment = (name:string):>string|undefined => {
    let wanted:array<uint8> = name as array<uint8>
    let environ:array<uint8> = _environment_bytes()
    let start:int64 = 0
    let i:int64 = 0
    loop i <? environ.length {
        if environ[i] =? 0 {
            let value = _environment_value(environ start i wanted)
            match value {
                s:string => return s
                <undefined> => {}
            }
            start = i + 1
        }
        i += 1
    }
    return undefined
}

# ---- processes ----
# `run` waits for the exit status; `run_silent` sends the child's output to
# /dev/null; `spawn` starts a child and returns it (`child.wait`); `capture`
# waits and collects the child's stdout and stderr. The status is the exit
# code, 128 + the signal number when a signal ended the child, or
# `SpawnError` when it could not be started (fork or pipe failed). The
# child inherits this process's environment; a failed exec reports 127 like
# a shell would. `program` is a path: the kernel does no PATH search
# (`run("/usr/bin/env" ["python3" …])` does one).
let Child:type = [
    pid:int64
    wait = ():>int64 => _wait_status(pid)
]

let Output:type = [
    status:int64
    stdout:array<uint8>
    stderr:array<uint8>
    stdout_text = ():>string|undefined => stdout as string|undefined
    stderr_text = ():>string|undefined => stderr as string|undefined
]

let run = (program:string args:array<string>):>int64|SpawnError => {
    match _spawn_with(program args (-1) (-1)) {
        pid:int64 => return _wait_status(pid)
        <SpawnError> => return SpawnError
    }
}

let run_silent = (program:string args:array<string>):>int64|SpawnError => {
    let dev_null:array<uint8> = _c_string("/dev/null")
    let fd:int64 = __syscall3__(2 __load_i64__(dev_null) 1 0)     # open(O_WRONLY)
    if fd <? 0 { return SpawnError }
    let spawned = _spawn_with(program args fd fd)
    let closed:int64 = __syscall1__(3 fd)
    match spawned {
        pid:int64 => return _wait_status(pid)
        <SpawnError> => return SpawnError
    }
}

let spawn = (program:string args:array<string>):>Child|SpawnError => {
    match _spawn_with(program args (-1) (-1)) {
        pid:int64 => return [pid = pid]
        <SpawnError> => return SpawnError
    }
}

# Run to completion with the child's stdout and stderr collected. Both
# pipes are drained as they fill (poll), so a child that writes a lot to
# either stream cannot block on a full pipe.
let capture = (program:string args:array<string>):>Output|SpawnError => {
    let out_pipe:int64 = __alloca__(8)
    let err_pipe:int64 = __alloca__(8)
    if __syscall2__(293 out_pipe 0) <? 0 { return SpawnError }       # pipe2
    if __syscall2__(293 err_pipe 0) <? 0 { return SpawnError }
    let out_read:int64 = _pipe_end(out_pipe 0)
    let out_write:int64 = _pipe_end(out_pipe 4)
    let err_read:int64 = _pipe_end(err_pipe 0)
    let err_write:int64 = _pipe_end(err_pipe 4)
    let spawned = _spawn_with(program args out_write err_write)
    let closed_out:int64 = __syscall1__(3 out_write)
    let closed_err:int64 = __syscall1__(3 err_write)
    match spawned {
        pid:int64 => {
            let streams = _drain_pipes(out_read err_read)
            let status:int64 = _wait_status(pid)
            return [status = status stdout = streams.stdout stderr = streams.stderr]
        }
        <SpawnError> => {
            let closed_out_read:int64 = __syscall1__(3 out_read)
            let closed_err_read:int64 = __syscall1__(3 err_read)
            return SpawnError
        }
    }
}

# One end of a `pipe2` result (two 32-bit descriptors).
let _pipe_end = (pipe:int64 offset:int64):>int64 => {
    let address:int64 = pipe + offset
    let word:uint32 = __load_u32__(address)
    return word transmute int64
}

# Fill one `struct pollfd { int fd; short events; short revents }` (POLLIN = 1);
# a closed stream is polled as fd -1, which the kernel ignores.
let _poll_slot = (slot:int64 fd:int64 open:bool):>void => {
    let wanted:int64 = -1
    if open { wanted = fd }
    let fd_word:uint32 = wanted transmute uint32
    __store_u32__(fd_word slot)
    let events_address:int64 = slot + 4
    __store_u16__(1 events_address)
    let revents_address:int64 = slot + 6
    __store_u16__(0 revents_address)
    return void
}

let _poll_ready = (slot:int64):>bool => {
    let revents_address:int64 = slot + 6
    let revents:uint16 = __load_u16__(revents_address)
    return revents not=? 0
}

let _Streams:type = [stdout:array<uint8> stderr:array<uint8>]

# Read both pipes to EOF, whichever has data first (poll = syscall 7).
let _drain_pipes = (out_fd:int64 err_fd:int64):>_Streams => {
    let stdout:array<uint8> = []
    let stderr:array<uint8> = []
    let fds:int64 = __alloca__(16)
    let err_slot:int64 = fds + 8
    let chunk:int64 = __alloca__(4096)
    let out_open:bool = true
    let err_open:bool = true
    loop out_open or err_open {
        _poll_slot(fds out_fd out_open)
        _poll_slot(err_slot err_fd err_open)
        let ready:int64 = __syscall3__(7 fds 2 (-1))
        if ready <? 0 { out_open = false  err_open = false }
        if out_open and _poll_ready(fds) {
            let count:int64 = __syscall3__(0 out_fd chunk 4096)
            if count <=? 0 { out_open = false  let closed:int64 = __syscall1__(3 out_fd) }
            else {
                let i:int64 = 0
                loop i <? count { let address:int64 = chunk + i  stdout.push(__load_u8__(address))  i += 1 }
            }
        }
        if err_open and _poll_ready(err_slot) {
            let count:int64 = __syscall3__(0 err_fd chunk 4096)
            if count <=? 0 { err_open = false  let closed:int64 = __syscall1__(3 err_fd) }
            else {
                let i:int64 = 0
                loop i <? count { let address:int64 = chunk + i  stderr.push(__load_u8__(address))  i += 1 }
            }
        }
    }
    return [stdout = stdout stderr = stderr]
}

# fork/execve; the child's stdout/stderr are `out_fd`/`err_fd` when they
# are not -1. Yields the pid.
let _spawn_with = (program:string args:array<string> out_fd:int64 err_fd:int64):>int64|SpawnError => {
    # one pool holds every NUL-terminated string; argv and envp are built
    # from its offsets once the pool has stopped growing (growth may move it)
    let pool:array<uint8> = []
    let starts:array<int64> = []
    starts.push(pool.length)
    loop b in (program as array<uint8>) pool.push(b)
    pool.push(0)
    loop arg in args {
        starts.push(pool.length)
        loop b in (arg as array<uint8>) pool.push(b)
        pool.push(0)
    }
    let environ:array<uint8> = _environment_bytes()
    let env_starts:array<int64> = []
    let at_entry_start:bool = true
    loop b in environ {
        if at_entry_start { env_starts.push(pool.length)  at_entry_start = false }
        pool.push(b)
        if b =? 0 { at_entry_start = true }
    }
    if not at_entry_start { pool.push(0) }
    let base:int64 = __load_i64__(pool)
    let argv:array<int64> = []
    loop start in starts argv.push(base + start)
    argv.push(0)
    let envp:array<int64> = []
    loop start in env_starts envp.push(base + start)
    envp.push(0)
    let c_program:int64 = base + 0
    let pid:int64 = __syscall0__(57)
    if pid <? 0 { return SpawnError }
    if pid =? 0 {
        if out_fd >=? 0 { let out:int64 = __syscall2__(33 out_fd 1) }   # dup2
        if err_fd >=? 0 { let err:int64 = __syscall2__(33 err_fd 2) }
        let failed:int64 = __syscall3__(59 c_program __load_i64__(argv) __load_i64__(envp))
        let ended:int64 = __syscall1__(231 127)    # exit_group: the exec failed
        return SpawnError                         # unreachable: the child has exited
    }
    return pid
}

# wait4 for one child: its exit status, or 128 + the signal that ended it.
let _wait_status = (pid:int64):>int64 => {
    let status_cell:int64 = __alloca__(8)
    __store_i64__(0 status_cell)
    let waited:int64 = __syscall4__(61 pid status_cell 0 0)
    if waited <? 0 { return -1 }
    let status:int64 = __load_i64__(status_cell) and 65535
    let signal:int64 = status and 127
    if signal =? 0 { return (status >> 8) and 255 }
    return 128 + signal
}

# The entries of a directory (excluding `.` and `..`), in the order the
# kernel returns them. Names that are not UTF-8 are skipped.
let list_directory = (path:string):>array<string>|FileNotFound|FileAccessDenied|IsDirectory|FileExists|FileError => {
    let names:array<string> = []
    let c_path = _c_string(path)
    # O_RDONLY|O_DIRECTORY = 65536
    let fd:int64 = __syscall3__(2 __load_i64__(c_path) 65536 0)
    if fd <? 0 { return _file_error(fd) }
    let buffer:int64 = __alloca__(8192)
    let count:int64 = __syscall3__(217 fd buffer 8192)
    loop count >? 0 {
        let offset:int64 = 0
        loop offset <? count {
            # struct linux_dirent64: d_ino u64, d_off u64, d_reclen u16 @16, d_type u8 @18, d_name @19
            let record:int64 = buffer + offset
            let reclen_address:int64 = record + 16
            let reclen:int64 = __load_u16__(reclen_address) transmute int64
            let name_bytes:array<uint8> = []
            let cursor:int64 = record + 19
            let byte:uint8 = __load_u8__(cursor)
            loop byte not=? 0 {
                name_bytes.push(byte)
                cursor = cursor + 1
                byte = __load_u8__(cursor)
            }
            let name = name_bytes as string|undefined
            match name {
                text:string => if text not=? "." and text not=? ".." { names.push(text) }
                <undefined> => {}
            }
            if reclen <=? 0 { offset = count } else { offset = offset + reclen }
        }
        count = __syscall3__(217 fd buffer 8192)
    }
    let closed:int64 = __syscall1__(3 fd)
    if count <? 0 { return _file_error(count) }
    return names
}

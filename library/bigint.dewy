# Arbitrary-precision integers. `bigint` is this type: the literal `0`, or a
# sign and a nonempty little-endian array of base-2^32 limbs (each held in a
# uint64 word so limb products fit in 64 bits). Zero is its own case rather
# than a sign value, so there is no negative zero and no zero with limbs;
# `bigint & ~0` names the nonzero form, and `if x =? 0` narrows between the
# two. The one convention the type cannot state is canonical form: no leading
# zero limbs (`_bigint_from_limbs` is the only place limbs are packed).
# Operations are ordinary Dewy functions; the checker only routes
# `+ - * // % ^` and comparisons here and promotes integer operands.
let BigInt:type = 0 | [sign:-1|1 limbs:array<uint64 length >? 0>]

let _LIMB_BASE:uint64 = 4294967296
let _LIMB_MASK:uint64 = 4294967295
let _BIGINT_ONE:BigInt & ~0 = [sign = 1 limbs = [1]]

let _bigint_trim = (@limbs:array<uint64>):>void => {
    loop limbs.length >? 0 and limbs[limbs.length - 1] =? 0 {
        limbs.pop;
    }
}

# Pack a magnitude: trimmed limbs with a sign, or zero when nothing is left.
let _bigint_from_limbs = (negative:bool limbs:array<uint64>):>BigInt => {
    _bigint_trim(@limbs)
    if limbs.length >? 0 {
        if negative { return [sign = -1 limbs = limbs] }
        return [sign = 1 limbs = limbs]
    }
    return 0
}

# A nonzero word has one or two limbs, so the literal shapes cover it.
let _bigint_from_int_nonzero = (value:int64 & ~0):>BigInt & ~0 => {
    let magnitude:uint64 = value transmute uint64
    if value <? 0 { magnitude = (0 - value) transmute uint64 }   # wraps correctly for the minimum
    let low:uint64 = magnitude and _LIMB_MASK
    let high:uint64 = magnitude >> 32
    if value <? 0 {
        if high =? 0 { return [sign = -1 limbs = [low]] }
        return [sign = -1 limbs = [low high]]
    }
    if high =? 0 { return [sign = 1 limbs = [low]] }
    return [sign = 1 limbs = [low high]]
}

let _bigint_from_int = (value:int64):>BigInt => {
    if value =? 0 { return 0 }
    return _bigint_from_int_nonzero(value)
}

let _bigint_limbs = (value:BigInt):>array<uint64> => {
    if value =? 0 { return [] }
    return value.limbs
}

# --- magnitude helpers (limb arrays) ---
let _mag_compare = (a:array<uint64> b:array<uint64>):>int64 => {
    if a.length >? b.length { return 1 }
    if a.length <? b.length { return -1 }
    let i:int64 = a.length
    loop i >? 0 {
        i = i - 1
        if i <? a.length and i <? b.length {
            if a[i] >? b[i] { return 1 }
            if a[i] <? b[i] { return -1 }
        }
    }
    return 0
}

let _mag_add = (a:array<uint64> b:array<uint64>):>array<uint64> => {
    let result:array<uint64> = []
    let carry:uint64 = 0
    let i:int64 = 0
    loop i <? a.length or i <? b.length {
        let sum:uint64 = carry
        if i <? a.length { sum = sum + a[i] }
        if i <? b.length { sum = sum + b[i] }
        result.push(sum and _LIMB_MASK)
        carry = sum >> 32
        i = i + 1
    }
    if carry not =? 0 { result.push(carry) }
    return result
}

# a - b for |a| >= |b|
let _mag_sub = (a:array<uint64> b:array<uint64>):>array<uint64> => {
    let result:array<uint64> = []
    let borrow:uint64 = 0
    let i:int64 = 0
    loop i <? a.length {
        let top:uint64 = a[i] + _LIMB_BASE
        let subtract:uint64 = borrow
        if i <? b.length { subtract = subtract + b[i] }
        let diff:uint64 = top - subtract
        result.push(diff and _LIMB_MASK)
        borrow = 1 - (diff >> 32)
        i = i + 1
    }
    _bigint_trim(@result)
    return result
}

let _mag_mul = (a:array<uint64> b:array<uint64>):>array<uint64> => {
    let result:array<uint64> = []
    let n:int64 = 0
    loop n <? a.length + b.length { result.push(0)  n = n + 1 }
    let i:int64 = 0
    loop i <? a.length {
        let carry:uint64 = 0
        let j:int64 = 0
        loop j <? b.length {
            let k:int64 = i + j
            if k <? result.length {
                let t:uint64 = a[i] * b[j] + result[k] + carry
                result[k] = t and _LIMB_MASK
                carry = t >> 32
            }
            j = j + 1
        }
        let k:int64 = i + b.length
        loop carry not =? 0 and k <? result.length {
            let t:uint64 = result[k] + carry
            result[k] = t and _LIMB_MASK
            carry = t >> 32
            k = k + 1
        }
        i = i + 1
    }
    _bigint_trim(@result)
    return result
}

# --- shifts by whole bit counts ---
let _mag_shift_left = (limbs:array<uint64> bits:int64<bits >=? 0>):>array<uint64> => {
    if limbs.length =? 0 { return [] }
    let limb_shift:int64 = bits // 32
    let bit_shift:uint64 = (bits % 32) transmute uint64
    let result:array<uint64> = []
    let n:int64 = 0
    loop n <? limb_shift { result.push(0)  n = n + 1 }
    let carry:uint64 = 0
    let i:int64 = 0
    loop i <? limbs.length {
        let t:uint64 = (limbs[i] << bit_shift) or carry
        result.push(t and _LIMB_MASK)
        carry = t >> 32
        i = i + 1
    }
    if carry not =? 0 { result.push(carry) }
    return result
}

let _mag_shift_right = (limbs:array<uint64> bits:int64<bits >=? 0>):>array<uint64> => {
    let limb_shift:int64 = bits // 32
    let bit_shift:uint64 = (bits % 32) transmute uint64
    let result:array<uint64> = []
    let i:int64 = limb_shift
    if i <? 0 { i = 0 }      # the analysis does not carry the sign through `//`
    loop i <? limbs.length {
        let value:uint64 = limbs[i] >> bit_shift
        let next:int64 = i + 1
        if next <? limbs.length {
            if bit_shift not =? 0 { value = value or ((limbs[next] << (32 - bit_shift)) and _LIMB_MASK) }
        }
        result.push(value)
        i = i + 1
    }
    _bigint_trim(@result)
    return result
}

# the number of low zero bits (0 for zero)
let _mag_trailing_zeros = (limbs:array<uint64>):>int64<i => i >=? 0> => {
    let count:int64 = 0
    let i:int64 = 0
    loop i <? limbs.length {
        let limb:uint64 = limbs[i]
        if limb =? 0 {
            count = count + 32
        } else {
            loop (limb and 1) =? 0 {
                limb = limb >> 1
                count = count + 1
            }
            if count >=? 0 { return count }   # a counter; the analysis widens it
            return 0
        }
        i = i + 1
    }
    return 0
}

# the shift that puts a limb's highest set bit at bit 31 (the limb is nonzero)
let _limb_leading_zeros = (limb:uint64):>int64<i => i >=? 0> => {
    let count:int64 = 0
    loop (limb and 2147483648) =? 0 and count <? 32 {
        limb = limb << 1
        count = count + 1
    }
    if count >=? 0 { return count }   # a counter; the analysis widens it
    return 0
}

# --- division ---
# quotient and remainder of magnitudes (b nonzero)
let _MagDivMod:type = [quotient:array<uint64> remainder:array<uint64>]

# short division by one limb, most significant limb first: each quotient limb
# depends only on the limb it replaces and the running remainder
let _mag_divmod_limb = (a:array<uint64> divisor:uint64 & ~0):>_MagDivMod => {
    let quotient:array<uint64> = []
    let n:int64 = 0
    loop n <? a.length { quotient.push(0)  n = n + 1 }
    let remainder:uint64 = 0
    let i:int64 = a.length
    loop i >? 0 {
        i = i - 1
        if i <? a.length {
            if i <? quotient.length {
                let value:uint64 = (remainder << 32) or a[i]
                quotient[i] = value // divisor
                remainder = value % divisor
            }
        }
    }
    _bigint_trim(@quotient)
    if remainder =? 0 { return [quotient = quotient remainder = []] }
    return [quotient = quotient remainder = [remainder]]
}

let _mag_mod_limb = (a:array<uint64> divisor:uint64 & ~0):>uint64 => {
    let remainder:uint64 = 0
    let i:int64 = a.length
    loop i >? 0 {
        i = i - 1
        if i <? a.length { remainder = ((remainder << 32) or a[i]) % divisor }
    }
    return remainder
}

# Knuth's Algorithm D (TAOCP 4.3.1): the divisor is shifted so its top limb
# has bit 31 set, then each quotient limb is estimated from the top two limbs
# of the running remainder and the top limb of the divisor, corrected at most
# twice by the second limb, and confirmed by the multiply-and-subtract; a
# rare final borrow means the estimate was one too big and the divisor is
# added back. One trial limb per quotient limb, instead of one per bit.
let _mag_divmod = (a:array<uint64> b:array<uint64>):>_MagDivMod => {
    if _mag_compare(a b) <? 0 { return [quotient = [] remainder = a] }
    if b.length =? 1 {
        let divisor:uint64 = b[0]
        if divisor not =? 0 { return _mag_divmod_limb(a divisor) }
    }
    let last:int64 = b.length - 1
    let shift:int64 = 0
    if last >=? 0 { if last <? b.length { shift = _limb_leading_zeros(b[last]) } }
    let v:array<uint64> = _mag_shift_left(b shift)
    let u:array<uint64> = _mag_shift_left(a shift)
    loop u.length <? a.length + 1 { u.push(0) }
    let n:int64 = v.length
    let m:int64 = u.length - n - 1
    let quotient:array<uint64> = []
    let k:int64 = 0
    loop k <=? m { quotient.push(0)  k = k + 1 }
    let v_top:uint64 = 0
    let v_next:uint64 = 0
    let v_last:int64 = n - 1
    let v_prev:int64 = n - 2
    if v_last <? v.length { if v_last >=? 0 { v_top = v[v_last] } }
    if v_prev <? v.length { if v_prev >=? 0 { v_next = v[v_prev] } }
    # the top limb is nonzero (no leading zero limbs) and shifted to bit 31;
    # the analysis does not know that, hence the (never taken) fallback
    if v_top =? 0 { return [quotient = [] remainder = a] }
    let j:int64 = m
    loop j >=? 0 {
        # estimate from the top two remainder limbs over the top divisor limb
        let u_top:uint64 = 0
        let u_next:uint64 = 0
        let u_third:uint64 = 0
        let top:int64 = j + n
        let below:int64 = top - 1
        let third:int64 = top - 2
        if top <? u.length { if top >=? 0 { u_top = u[top] } }
        if below <? u.length { if below >=? 0 { u_next = u[below] } }
        if third <? u.length { if third >=? 0 { u_third = u[third] } }
        let numerator:uint64 = (u_top << 32) or u_next
        let qhat:uint64 = numerator // v_top
        let rhat:uint64 = numerator % v_top
        let adjusting:bool = true
        loop adjusting {
            adjusting = false
            if qhat >=? _LIMB_BASE { adjusting = true }
            else { if qhat * v_next >? ((rhat << 32) or u_third) { adjusting = true } }
            if adjusting {
                qhat = qhat - 1
                rhat = rhat + v_top
                if rhat >=? _LIMB_BASE { adjusting = false }
            }
        }
        # multiply and subtract qhat * v from u[j .. j + n]
        let borrow:uint64 = 0
        let carry:uint64 = 0
        let i:int64 = 0
        loop i <? n {
            let at:int64 = i + j
            if i <? v.length {
                if at >=? 0 {
                    if at <? u.length {
                        let product:uint64 = qhat * v[i] + carry
                        carry = product >> 32
                        let difference:uint64 = u[at] + _LIMB_BASE - (product and _LIMB_MASK) - borrow
                        u[at] = difference and _LIMB_MASK
                        borrow = 1 - (difference >> 32)
                    }
                }
            }
            i = i + 1
        }
        if top >=? 0 {
            if top <? u.length {
                let difference:uint64 = u[top] + _LIMB_BASE - carry - borrow
                u[top] = difference and _LIMB_MASK
                borrow = 1 - (difference >> 32)
            }
        }
        if borrow not =? 0 {
            # the estimate was one too big: add the divisor back
            qhat = qhat - 1
            let add_carry:uint64 = 0
            i = 0
            loop i <? n {
                let at:int64 = i + j
                if i <? v.length {
                    if at >=? 0 {
                        if at <? u.length {
                            let t:uint64 = u[at] + v[i] + add_carry
                            u[at] = t and _LIMB_MASK
                            add_carry = t >> 32
                        }
                    }
                }
                i = i + 1
            }
            if top >=? 0 {
                if top <? u.length { u[top] = (u[top] + add_carry) and _LIMB_MASK }
            }
        }
        if j <? quotient.length { quotient[j] = qhat }   # j >= 0 is the loop condition
        j = j - 1
    }
    _bigint_trim(@quotient)
    let remainder:array<uint64> = []
    let low:int64 = 0
    loop low <? n {
        if low <? u.length { remainder.push(u[low]) }
        low = low + 1
    }
    return [quotient = quotient remainder = _mag_shift_right(remainder shift)]
}

# --- greatest common divisor ---
# Binary (Stein's) gcd: shifts and subtractions in place of divisions. When
# either operand is one limb, one short division reduces the problem to a
# word gcd, which is the common case (a small factor against a large one).
let _limb_gcd = (a:uint64 b:uint64):>uint64 => {
    loop b not =? 0 {
        let t:uint64 = a % b
        a = b
        b = t
    }
    return a
}

let _mag_gcd = (a:array<uint64> b:array<uint64>):>array<uint64> => {
    if a.length =? 0 { return b }
    if b.length =? 0 { return a }
    if a.length =? 1 {
        let limb:uint64 = a[0]
        if limb not =? 0 { return [_limb_gcd(limb _mag_mod_limb(b limb))] }
    }
    if b.length =? 1 {
        let limb:uint64 = b[0]
        if limb not =? 0 { return [_limb_gcd(limb _mag_mod_limb(a limb))] }
    }
    let zeros_a:int64 = _mag_trailing_zeros(a)
    let zeros_b:int64 = _mag_trailing_zeros(b)
    let common:int64 = zeros_a
    if zeros_b <? common { common = zeros_b }
    let x:array<uint64> = _mag_shift_right(a zeros_a)
    let y:array<uint64> = _mag_shift_right(b zeros_b)
    loop y.length >? 0 {
        # both odd: the difference of the larger and the smaller is even
        if _mag_compare(x y) >? 0 {
            x = _mag_sub(x y)
            x = _mag_shift_right(x _mag_trailing_zeros(x))
        } else {
            y = _mag_sub(y x)
            if y.length >? 0 { y = _mag_shift_right(y _mag_trailing_zeros(y)) }
        }
    }
    if common >=? 0 { return _mag_shift_left(x common) }
    return x
}

# --- signed operations ---
let _bigint_neg = (a:BigInt):>BigInt => {
    if a =? 0 { return 0 }
    return [sign = -a.sign limbs = a.limbs]
}
let _bigint_neg_nonzero = (a:BigInt & ~0):>BigInt & ~0 => [sign = -a.sign limbs = a.limbs]
let _bigint_abs = (a:BigInt):>BigInt => {
    if a =? 0 { return 0 }
    return [sign = 1 limbs = a.limbs]
}
let _bigint_abs_nonzero = (a:BigInt & ~0):>BigInt & ~0 => [sign = 1 limbs = a.limbs]

let _bigint_add = (a:BigInt b:BigInt):>BigInt => {
    if a =? 0 { return b }
    if b =? 0 { return a }
    if a.sign =? b.sign { return _bigint_from_limbs(a.sign <? 0 _mag_add(a.limbs b.limbs)) }
    let order:int64 = _mag_compare(a.limbs b.limbs)
    if order =? 0 { return 0 }
    if order >? 0 { return _bigint_from_limbs(a.sign <? 0 _mag_sub(a.limbs b.limbs)) }
    return _bigint_from_limbs(b.sign <? 0 _mag_sub(b.limbs a.limbs))
}

let _bigint_sub = (a:BigInt b:BigInt):>BigInt => _bigint_add(a _bigint_neg(b))

let _bigint_mul = (a:BigInt b:BigInt):>BigInt => {
    if a =? 0 { return 0 }
    if b =? 0 { return 0 }
    return _bigint_from_limbs(a.sign not =? b.sign _mag_mul(a.limbs b.limbs))
}

# The product of nonzero magnitudes is nonzero; the analysis does not know
# that a schoolbook product has a limb, hence the (never taken) fallback.
let _bigint_mul_nonzero = (a:BigInt & ~0 b:BigInt & ~0):>BigInt & ~0 => {
    let product:array<uint64> = _mag_mul(a.limbs b.limbs)
    if product.length >? 0 {
        if a.sign =? b.sign { return [sign = 1 limbs = product] }
        return [sign = -1 limbs = product]
    }
    return a
}

# floor division and modulo with Python's sign conventions; a nonzero
# divisor is the caller's proof (`if d not=? 0`)
let _bigint_floordiv = (a:BigInt b:BigInt & ~0):>BigInt => {
    if a =? 0 { return 0 }
    let parts = _mag_divmod(a.limbs b.limbs)
    let negative:bool = a.sign not =? b.sign
    let quotient:BigInt = _bigint_from_limbs(negative parts.quotient)
    if negative and parts.remainder.length >? 0 {
        quotient = _bigint_sub(quotient _BIGINT_ONE)
    }
    return quotient
}

let _bigint_mod = (a:BigInt b:BigInt & ~0):>BigInt => {
    if a =? 0 { return 0 }
    let parts = _mag_divmod(a.limbs b.limbs)
    let remainder:BigInt = _bigint_from_limbs(a.sign <? 0 parts.remainder)
    if a.sign not =? b.sign and parts.remainder.length >? 0 {
        remainder = _bigint_add(remainder b)
    }
    return remainder
}

let _bigint_pow_nonzero = (base:BigInt & ~0 exponent:int64):>BigInt & ~0 => {
    let result:BigInt & ~0 = _BIGINT_ONE
    let factor:BigInt & ~0 = base
    loop exponent >? 0 {
        if exponent % 2 =? 1 { result = _bigint_mul_nonzero(result factor) }
        factor = _bigint_mul_nonzero(factor factor)
        exponent = exponent // 2
    }
    return result
}

let _bigint_pow = (base:BigInt exponent:int64):>BigInt => {
    if base =? 0 {
        if exponent =? 0 { return _BIGINT_ONE }
        return 0
    }
    return _bigint_pow_nonzero(base exponent)
}

let _bigint_compare = (a:BigInt b:BigInt):>int64 => {
    if a =? 0 {
        if b =? 0 { return 0 }
        return -b.sign
    }
    if b =? 0 { return a.sign }
    if a.sign not =? b.sign { return a.sign }
    let order:int64 = _mag_compare(a.limbs b.limbs)
    if a.sign <? 0 { return -order }
    return order
}

let _bigint_eq = (a:BigInt b:BigInt):>bool => _bigint_compare(a b) =? 0
let _bigint_ne = (a:BigInt b:BigInt):>bool => _bigint_compare(a b) not =? 0
let _bigint_lt = (a:BigInt b:BigInt):>bool => _bigint_compare(a b) <? 0
let _bigint_le = (a:BigInt b:BigInt):>bool => _bigint_compare(a b) <=? 0
let _bigint_gt = (a:BigInt b:BigInt):>bool => _bigint_compare(a b) >? 0
let _bigint_ge = (a:BigInt b:BigInt):>bool => _bigint_compare(a b) >=? 0

let _bigint_sign = (value:BigInt):>int64 => {
    if value =? 0 { return 0 }
    return value.sign
}

let _bigint_is_one = (value:BigInt):>bool => {
    if value =? 0 { return false }
    if value.sign <? 0 { return false }
    if value.limbs.length =? 1 { return value.limbs[0] =? 1 }
    return false
}

# gcd(0 0) is taken as 1 so the result is always a usable divisor.
let _bigint_gcd = (a:BigInt b:BigInt):>BigInt & ~0 => {
    let g:array<uint64> = _mag_gcd(_bigint_limbs(a) _bigint_limbs(b))
    if g.length >? 0 { return [sign = 1 limbs = g] }
    return _BIGINT_ONE
}

# The exact quotient of a nonzero multiple by a positive divisor (the sign
# follows the dividend). The divisor divides the value, so the quotient is
# nonzero; the analysis does not know that, hence the (never taken) fallback.
let _bigint_exact_div = (value:BigInt & ~0 divisor:BigInt & ~0):>BigInt & ~0 => {
    if _bigint_is_one(divisor) { return value }
    let parts = _mag_divmod(value.limbs divisor.limbs)
    if parts.quotient.length >? 0 { return [sign = value.sign limbs = parts.quotient] }
    return value
}

# decimal digits, most significant first, by repeated division by 10^9
let _bigint_decimal_chunks = (limbs:array<uint64>):>array<uint64> => {
    let chunks:array<uint64> = []          # least significant chunk first
    let current:array<uint64> = limbs      # a copy, divided in place
    loop current.length >? 0 {
        # short division by 10^9, most significant limb first: each quotient
        # limb depends only on the limb it replaces and the running remainder
        let i:int64 = current.length
        let remainder:uint64 = 0
        loop i >? 0 {
            i = i - 1
            if i <? current.length {
                let value:uint64 = (remainder << 32) or current[i]
                current[i] = value // 1000000000
                remainder = value % 1000000000
            }
        }
        _bigint_trim(@current)
        chunks.push(remainder)
    }
    return chunks
}

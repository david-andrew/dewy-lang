# Source-language dispatch. The C bootstrap substitutes bootstrap/frontend.jo.
use 'util.jo'
use 'ast.jo'
use 'parse.jo'
use 'dewy_parse.jo'
use 'dewy_fast.jo'

source_declarations = (file: int) -> int[]:
    if files[file].is_dewy:
        first = nodes.len()
        mode = env("DEWY_CORE_FRONTEND") ?? "fast"
        if mode != "fast" and mode != "legacy": fatal(mkpos(file, 0), "DEWY_CORE_FRONTEND must be 'fast' or 'legacy'")
        decls = if mode == "legacy": dewy_parse_file(file) else: dewy_fast_file(file)
        i = nodes.len() - 1
        loop i >= first:
            if nodes[i].kind == .loopx:
                lowered = desugar_loopx(i)
                nodes[i] = nodes[lowered]
            i -= 1
        return decls
    parse_file(file)

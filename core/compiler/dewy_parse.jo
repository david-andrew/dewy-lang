# Dewy's syntax tree projected into the pinned core's compact AST.
# This is an explicitly limited source-level experiment, not Sloppy syntax
# accepted under a different extension. Unknown Dewy forms fail at their source.
use 'util.jo'
use 'ast.jo'
use 'lex.jo'
use 'parse.jo'
use 'expr.jo'

struct DewySyntax:
    kind: str
    text: str
    pos: int
    children: int[]

dewy_syntax: DewySyntax[]
dw_index_context: int[]  # enclosing index nodes, for contextual `end`

dw_child = (id: int, at: int) -> int: dewy_syntax[id].children[at]
dw_multiplications = (id: int) -> int:
    score = if dewy_syntax[id].text == "MultiplyJuxtapose": 1 else: 0
    loop child in dewy_syntax[id].children: score += dw_multiplications(child)
    score

dw_unwrap = (id: int) -> int:
    let id = id
    loop true:
        if dewy_syntax[id].kind == "Atom": id = dw_child(id, 0)
        else if dewy_syntax[id].kind == "Ambiguous":
            best = -1
            score = 1000000000
            tied = false
            loop child in dewy_syntax[id].children:
                next = dw_multiplications(child)
                if next < score:
                    best = child
                    score = next
                    tied = false
                else if next == score: tied = true
            if best < 0 or tied: return dw_fail(id, "an ambiguous expression; use explicit multiplication or parentheses")
            id = best
        else: return id
    id
dw_name = (id: int) -> str:
    let id = dw_unwrap(id)
    if dewy_syntax[id].kind == "Identifier": return dewy_syntax[id].text
    ""
dw_op = (id: int) -> str:
    let id = dw_unwrap(id)
    if dewy_syntax[id].kind == "BinOp" and dewy_syntax[dw_child(id, 0)].kind == "CombinedAssignmentOp": return dewy_syntax[dw_child(dw_child(id, 0), 0)].text + "="
    if dewy_syntax[id].kind == "BinOp" or dewy_syntax[id].kind == "Prefix" or dewy_syntax[id].kind == "Postfix" or dewy_syntax[id].kind == "Flat": return dewy_syntax[dw_child(id, 0)].text
    ""
dw_fail = (id: int, what: str) -> int:
    fatal(dewy_syntax[id].pos, "Dewy core experiment does not yet support {what}")
    0

# The syntax parser has already recognized the digits and base. Accumulate with
# an explicit limit so neither overflow nor a high unsigned bit changes a value.
dw_digits = (text: str) -> str:
    digits = text[3..]
    if starts_with(lower(digits), text[..2)): digits = digits[2..]
    digits

dw_alphabet = (text: str, id: int) -> str:
    alphabet = ""
    match text[..3):
        "0b:": alphabet = "01"
        "0t:": alphabet = "012"
        "0q:": alphabet = "0123"
        "0s:": alphabet = "012345"
        "0o:": alphabet = "01234567"
        "0d:": alphabet = "0123456789"
        "0z:": alphabet = "0123456789xe"
        "0x:": alphabet = "0123456789abcdef"
        _: dw_fail(id, "this numeric base")
    alphabet

dw_unsigned = (text: str, id: int) -> u64?:
    alphabet = dw_alphabet(text, id)
    base = u64(len(alphabet))
    value: u64 = 0
    loop c in lower(dw_digits(text)):
        if c == '_': continue
        digit = find_byte(alphabet, c)
        if digit < 0: fatal(dewy_syntax[id].pos, "invalid numeric digit")
        if value > (0xFFFFFFFFFFFFFFFF - u64(digit)) / base:
            return none
        value = value * base + u64(digit)
    value

# Only modules that use a large literal import the exact-integer library. The
# alias contains a character that cannot occur in a user identifier.
dw_bigint_import = 0
const DW_BIGINT_ALIAS = "$dewy_bigint"

dw_finish_declarations = (declarations: int[]) -> int[]:
    if dw_bigint_import == 0: return declarations
    [dw_bigint_import] + declarations

dw_bigint_value = (limbs: u64[], pos: int, negative: bool = false) -> int:
    if dw_bigint_import == 0:
        dw_bigint_import = mk(.import_, pos)
        nodes[dw_bigint_import].aux2 = 1
        nodes[dw_bigint_import].sval = i32(intern("@lib/bigint.dewy"))
        nodes[dw_bigint_import].name = i32(intern(DW_BIGINT_ALIAS))
    owner = mk(.ident, pos)
    nodes[owner].name = i32(intern(DW_BIGINT_ALIAS))
    callee = mk(.field, pos)
    nodes[callee].a = i32(owner)
    nodes[callee].name = i32(intern("BigInt"))
    sign = mk(.int_lit, pos)
    nodes[sign].ival = if negative: -1 else: 1
    add_flag(sign, NF_LITERAL)
    sign_arg = mk(.namedarg, pos)
    nodes[sign_arg].name = i32(intern("_sign"))
    nodes[sign_arg].a = i32(sign)
    items: int[]
    loop limb in limbs:
        item = mk(.int_lit, pos)
        nodes[item].ival = int(limb)
        add_flag(item, NF_LITERAL)
        items.push(item)
    magnitude = mk(.array, pos)
    set_list(magnitude, items)
    magnitude_arg = mk(.namedarg, pos)
    nodes[magnitude_arg].name = i32(intern("_limbs"))
    nodes[magnitude_arg].a = i32(magnitude)
    result = mk(.call, pos)
    nodes[result].a = i32(callee)
    set_list(result, [sign_arg, magnitude_arg])
    result

dw_big_integer = (text: str, id: int) -> int:
    alphabet = dw_alphabet(text, id)
    base = u64(len(alphabet))
    limbs: u64[]
    loop c in lower(dw_digits(text)):
        if c == '_': continue
        digit = find_byte(alphabet, c)
        if digit < 0: fatal(dewy_syntax[id].pos, "invalid numeric digit")
        carry = u64(digit)
        loop i in [0..limbs.len()):
            word = limbs[i] * base + carry
            limbs[i] = word & 0xFFFFFFFF
            carry = word >> 32
        if carry != 0: limbs.push(carry)
    dw_bigint_value(limbs, dewy_syntax[id].pos)

# Power-of-two based strings pack digits most-significant-bit first. The final
# partial byte is zero padded, as in the existing Dewy literal design.
dw_binary = (id: int) -> int:
    text = dewy_syntax[id].text
    prefix = text[..3)
    alphabet = ""
    width = 0
    match prefix:
        "0b:": alphabet = "01"; width = 1
        "0q:": alphabet = "0123"; width = 2
        "0o:": alphabet = "01234567"; width = 3
        "0x:": alphabet = "0123456789abcdef"; width = 4
        "0u:": alphabet = "0123456789abcdefghijklmnopqrstuv"; width = 5
        "0g:": alphabet = "0123456789abcdefghijklmnopqrstuvwxyzABCDEFGHIJKLMNOPQRSTUVWXYZ+/"; width = 6
        _: return dw_fail(id, "this based-string packing")
    digits = text[3..]
    if width != 6: digits = lower(digits)
    pending = 0
    bits = 0
    padded = false
    packed: u8[]
    loop c in digits:
        if c == '_' and width != 6: continue
        if c == '=' and width == 6: padded = true; continue
        if padded: fatal(dewy_syntax[id].pos, "based-string padding must be at the end")
        digit = find_byte(alphabet, c)
        if width == 6 and c == '-': digit = 62
        if width == 6 and c == '_': digit = 63
        if digit < 0: fatal(dewy_syntax[id].pos, "invalid based-string digit")
        pending = (pending << width) | digit
        bits += width
        if bits >= 8:
            bits -= 8
            packed.push(u8(pending >> bits))
            pending &= (1 << bits) - 1
    if bits > 0: packed.push(u8(pending << (8 - bits)))
    pos = dewy_syntax[id].pos
    value = mk(.str_lit, pos)
    nodes[value].sval = i32(intern(str_from_bytes(packed)))
    callee = mk(.ident, pos)
    nodes[callee].name = i32(intern("bytes"))
    call = mk(.call, pos)
    nodes[call].a = i32(callee)
    set_list(call, [value])
    call

dw_is_include = (id: int) -> bool:
    if not starts_with(dw_op(id), "CallJuxtapose"): return false
    tag = dw_unwrap(dw_child(id, 1))
    dewy_syntax[tag].kind == "Metatag" and dewy_syntax[tag].text == "include_bytes"

dw_include = (id: int) -> int:
    arg = dw_unwrap(dw_child(id, 2))
    if dewy_syntax[arg].kind != "Block" or dewy_syntax[arg].children.len() != 1:
        return dw_fail(id, "$include_bytes without one literal path")
    path = dw_unwrap(dw_child(arg, 0))
    if dw_op(path) != "CallJuxtapose" or dw_name(dw_child(path, 1)) != "p":
        return dw_fail(path, "$include_bytes without a p\"path\" literal")
    path = dw_unwrap(dw_child(path, 2))
    if dewy_syntax[path].kind != "String": return dw_fail(path, "a nonliteral asset path")
    callee = mk(.ident, dewy_syntax[id].pos)
    nodes[callee].name = i32(intern("embed"))
    call = mk(.call, dewy_syntax[id].pos)
    nodes[call].a = i32(callee)
    set_list(call, [dw_expr(path)])
    call

dw_type = (id: int) -> int:
    let id = dw_unwrap(id)
    pos = dewy_syntax[id].pos
    name = dw_name(id)
    if name != "":
        if name == "int64": name = "i64"
        else if name == "uint64": name = "u64"
        else if name == "int32": name = "i32"
        else if name == "uint32": name = "u32"
        else if name == "int16": name = "i16"
        else if name == "uint16": name = "u16"
        else if name == "int8": name = "i8"
        else if name == "uint8": name = "u8"
        else if name == "float64": name = "f64"
        else if name == "float32": name = "f32"
        else if name == "string": name = "str"
        else if name == "int" or name == "uint": return dw_fail(id, "unbounded integer types; use an explicit fixed width in this experiment")
        n = mk(.tname, pos)
        nodes[n].name = i32(intern(name))
        return n
    if dewy_syntax[id].kind == "Block" and dewy_syntax[id].text == "[]:":
        n = mk(.trecord, pos)
        fields: int[]
        loop child in dewy_syntax[id].children:
            if dw_op(child) != ":": return dw_fail(child, "an inline record field without a type; use a named record for defaults")
            field = dw_param(child, .vardecl)
            if has_flag(field, NF_MUT): return dw_fail(child, "a mutable inline record field; mutability belongs on the parameter")
            fields.push(field)
        set_list(n, fields)
        return n
    if dw_op(id) == "|":
        n = mk(.tunion, pos)
        set_list(n, [dw_type(dw_child(id, 1)), dw_type(dw_child(id, 2))])
        return n
    if dewy_syntax[id].kind == "Postfix" and dw_op(id) == "?":
        n = mk(.topt, pos)
        nodes[n].a = i32(dw_type(dw_child(id, 1)))
        return n
    if dw_op(id) == ":>":
        params = dw_child(id, 1)
        if dewy_syntax[params].kind != "Block" or dewy_syntax[params].text != "():": return dw_fail(params, "this function type")
        n = mk(.tfn, pos)
        types_: int[]
        loop param in dewy_syntax[params].children:
            p = dw_param(param, .param)
            if nodes[p].a == 0: return dw_fail(param, "an untyped parameter in a function type")
            t = int(nodes[p].a)
            if has_flag(p, NF_MUT): add_flag(t, NF_MUT)
            types_.push(t)
        set_list(n, types_)
        result = dw_child(id, 2)
        if dw_name(result) != "void": nodes[n].a = i32(dw_type(result))
        return n
    if dw_op(id) == ".":
        owner = dw_name(dw_child(id, 1))
        member = dw_name(dw_child(id, 2))
        if owner == "" or member == "": return dw_fail(id, "this qualified type")
        n = mk(.tname, pos)
        nodes[n].sval = i32(intern(owner))
        nodes[n].name = i32(intern(member))
        return n
    if dewy_syntax[id].kind == "Block" and dewy_syntax[id].text == "():" and dewy_syntax[id].children.len() == 1:
        return dw_type(dw_child(id, 0))
    if dw_op(id) == "TypeParamJuxtapose" and dw_name(dw_child(id, 1)) == "array":
        args = dw_child(id, 2)
        if dewy_syntax[args].children.len() != 1: return dw_fail(id, "array type constraints")
        n = mk(.tarray, pos)
        nodes[n].a = i32(dw_type(dw_child(args, 0)))
        return n
    if dw_op(id) == "TypeParamJuxtapose" and dw_name(dw_child(id, 1)) == "dict":
        args = dw_child(id, 2)
        if dewy_syntax[args].children.len() != 2: return dw_fail(id, "dictionary type constraints")
        n = mk(.tmap, pos)
        nodes[n].a = i32(dw_type(dw_child(args, 0)))
        nodes[n].b = i32(dw_type(dw_child(args, 1)))
        return n
    if dw_op(id) == "TypeParamJuxtapose":
        n = dw_type(dw_child(id, 1))
        if nodes[n].kind != .tname or nkids(n) != 0: return dw_fail(id, "type arguments on this type expression")
        args: int[]
        loop child in dewy_syntax[dw_child(id, 2)].children: args.push(dw_type(child))
        set_list(n, args)
        return n
    return dw_fail(id, "this type expression")

# Type parameters use the existing compact specialization machinery. Constraints
# are not silently ignored: this slice accepts only distinct parameter names.
dw_type_params = (id: int) -> int[]:
    out: int[]
    seen: str[]
    loop child in dewy_syntax[id].children:
        name = dw_name(child)
        if name == "" or name == "of": return [dw_fail(child, "constrained type parameters; use plain type parameter names")]
        if seen.contains(name): fatal(dewy_syntax[child].pos, "duplicate type parameter '{name}'")
        seen.push(name)
        n = mk(.ident, dewy_syntax[child].pos)
        nodes[n].name = i32(intern(name))
        out.push(n)
    if out.len() == 0: return [dw_fail(id, "an empty type parameter declaration")]
    out

dw_param = (id: int, kind: NK) -> int:
    let id = id
    pos = dewy_syntax[id].pos
    initial = 0
    if dw_op(id) == "=":
        initial = dw_child(id, 2)
        id = dw_child(id, 1)
    lhs = id
    annotation = 0
    if dw_op(id) == ":":
        lhs = dw_child(id, 1)
        annotation = dw_child(id, 2)
    else if kind == .vardecl and initial == 0: return dw_fail(id, "a field without a type or default")
    by_place = dw_op(lhs) == "@"
    if by_place: lhs = dw_child(lhs, 1)
    name = dw_name(lhs)
    if name == "": return dw_fail(lhs, "destructured parameters")
    n = mk(kind, pos)
    nodes[n].name = i32(intern(name))
    if annotation != 0: nodes[n].a = i32(dw_type(annotation))
    if initial != 0: nodes[n].b = i32(dw_expr(initial))
    if by_place: add_flag(n, NF_MUT)
    return n

dw_function = (id: int, name: str) -> int:
    signature = dw_child(id, 1)
    params = signature
    result = 0
    if dw_op(signature) == ":>":
        params = dw_child(signature, 1)
        result = dw_child(signature, 2)
    type_params: int[]
    if dw_op(params) == "CallJuxtapose" and dewy_syntax[dw_child(params, 1)].text == "<>:":
        if name == "": return dw_fail(params, "an explicitly generic closure; declare a top-level generic function")
        type_params = dw_type_params(dw_child(params, 1))
        params = dw_child(params, 2)
    if dewy_syntax[params].kind != "Block" or dewy_syntax[params].text != "():": return dw_fail(params, "this parameter list")
    n = mk(if name == "": NK.lambda else: NK.fn_, dewy_syntax[id].pos)
    nodes[n].name = i32(intern(name))
    if type_params.len() > 0:
        if name == "main": return dw_fail(id, "a generic entry point")
        set_list2(n, type_params)
        add_flag(n, NF_GENERIC)
    if result != 0:
        if dw_name(result) == "void": add_flag(n, NF_VOID)
        else: nodes[n].a = i32(dw_type(result))
    ps: int[]
    loop p in dewy_syntax[params].children: ps.push(dw_param(p, .param))
    body = dw_block(dw_child(id, 2))
    prefix: int[]
    loop param in ps:
        if has_flag(param, NF_MUT): continue
        local = mk(.vardecl, nodes[param].pos)
        nodes[local].name = nodes[param].name
        value = mk(.ident, nodes[param].pos)
        nodes[value].name = nodes[param].name
        if name == "main":
            if ps.len() != 1: return dw_fail(id, "multiple entry-point parameters")
            nodes[value].name = i32(intern("args"))
            call = mk(.call, nodes[param].pos)
            nodes[call].a = i32(value)
            value = call
            nodes[local].a = nodes[param].a
        nodes[local].b = i32(value)
        prefix.push(local)
    if name == "main":
        loop param in ps:
            if has_flag(param, NF_MUT): return dw_fail(id, "a mutable entry-point parameter")
        ps = []
    set_list(n, ps)
    loop statement in kids(body): prefix.push(statement)
    set_list(body, prefix)
    nodes[n].b = i32(body)
    return n

dw_binary_token = (op: str, id: int) -> Tok:
    match op:
        "+": .plus
        "-": .minus
        "*", "MultiplyJuxtapose": .star
        "/": .slash
        "%": .percent
        "=?": .eq
        "not=?": .ne
        "in?": .kw_in
        "<?": .lt
        "<=?": .le
        ">?": .gt
        ">=?": .ge
        "<<": .shl
        ">>": .shr
        "and": .amp
        "or": .pipe
        "xor": .caret
        _:
            dw_fail(id, "operator '{op}'")
            .eof

dw_expr = (id: int) -> int:
    let id = dw_unwrap(id)
    k = dewy_syntax[id].kind
    text = dewy_syntax[id].text
    pos = dewy_syntax[id].pos
    op = dw_op(id)
    if op == "RangeJuxtapose": return dw_range_value(dw_iterable(id, true, true))
    if dw_is_include(id): return dw_include(id)
    if k == "BasedString": return dw_binary(id)
    if k == "Identifier":
        if text == "none": return mk(.none_lit, pos)
        if text == "end" and dw_index_context.len() > 0:
            ix = dw_index_context[dw_index_context.len() - 1]
            name = intern("$index_end{ix}")
            nodes[ix].sval = i32(name)
            return comp_ident(name, pos)
        n = mk(.ident, pos)
        nodes[n].name = i32(intern(if text == "printl": "print" else: text))
        return n
    if k == "Integer":
        if let value = dw_unsigned(text, id):
            n = mk(.int_lit, pos)
            nodes[n].ival = int(value)
            add_flag(n, NF_LITERAL)
            if nodes[n].ival < 0: add_flag(n, NF_U64)
            return n
        return dw_big_integer(text, id)
    if k == "Real":
        parts = split(text, "|")
        if parts.len() != 3 or not starts_with(parts[0], "0d:"): return dw_fail(id, "this real literal")
        number = dw_digits(parts[0])
        if parts[1] != "":
            if not starts_with(parts[1], "0d:"): return dw_fail(id, "nondecimal real fractions")
            number = number + "." + dw_digits(parts[1])
        if parts[2] != "":
            exponent = parts[2]
            if exponent[1] != 'e' or not starts_with(exponent[2..], "0d:"):
                return dw_fail(id, "nondecimal real exponents")
            number += "e" + exponent[..1) + dw_digits(exponent[2..])
        value = to_float(replace(number, "_", ""))
        if value == none: return dw_fail(id, "this real literal")
        if value! - value! != 0.0: fatal(pos, "real literal exceeds float64")
        n = mk(.float_lit, pos)
        nodes[n].fval = value!
        add_flag(n, NF_LITERAL)
        return n
    if k == "IString":
        n = mk(.str_lit, pos)
        nodes[n].aux = 1
        pieces: int[]
        loop child in dewy_syntax[id].children:
            if dewy_syntax[child].kind == "StringChunk":
                part = mk(.str_lit, dewy_syntax[child].pos)
                nodes[part].sval = i32(intern(dewy_syntax[child].text))
                pieces.push(part)
            else:
                if dewy_syntax[child].kind != "Block" or dewy_syntax[child].children.len() != 1: return dw_fail(child, "this string interpolation")
                part = mk(.pair, dewy_syntax[child].pos)
                nodes[part].a = i32(dw_expr(dw_child(child, 0)))
                nodes[part].sval = -1
                pieces.push(part)
        set_list(n, pieces)
        return n
    if k == "Bool":
        n = mk(.bool_lit, pos)
        nodes[n].ival = if text == "true": 1 else: 0
        return n
    if k == "String":
        n = mk(.str_lit, pos)
        nodes[n].sval = i32(intern(text))
        return n
    if k == "Block":
        children = dewy_syntax[id].children
        if children.len() == 1 and dw_op(children[0]) == "RangeJuxtapose": return dw_range_value(dw_iterable(id, true, true))
        if text == "():" and children.len() == 1: return dw_expr(children[0])
        if text == "[]:":
            if children.len() == 1 and dewy_syntax[children[0]].kind == "Flow":
                first = dw_child(children[0], 0)
                if dewy_syntax[first].kind == "KeywordExpr" and dewy_syntax[dw_child(first, 0)].text == "loop": return dw_comprehension(children[0])
            is_map = children.len() > 0 and dw_op(children[0]) == "->"
            is_record = children.len() > 0 and dw_op(children[0]) == "="
            loop child in children:
                if dw_op(child) == "=": is_record = true
            n = mk(if is_map: NK.map_lit else if is_record: NK.record_lit else: NK.array, pos)
            xs: int[]
            loop child in children:
                item = dw_unwrap(child)
                if not is_map and dewy_syntax[item].kind == "Postfix" and dw_op(item) == "...":
                    value = dw_expr(dw_child(item, 1))
                    add_flag(value, NF_SPREAD)
                    xs.push(value)
                else if is_map:
                    if dw_op(child) != "->": return dw_fail(child, "a dictionary item without ->")
                    pair = mk(.pair, dewy_syntax[child].pos)
                    nodes[pair].a = i32(dw_expr(dw_child(child, 1)))
                    nodes[pair].b = i32(dw_expr(dw_child(child, 2)))
                    xs.push(pair)
                else if is_record:
                    if dw_op(child) != "=": return dw_fail(child, "a record item without a field name and =")
                    name = dw_name(dw_child(child, 1))
                    if name == "": return dw_fail(child, "a record field without a simple name")
                    field = mk(.namedarg, dewy_syntax[child].pos)
                    nodes[field].name = i32(intern(name))
                    nodes[field].a = i32(dw_expr(dw_child(child, 2)))
                    xs.push(field)
                else: xs.push(dw_expr(child))
            set_list(n, xs)
            return n
        if text == "{{}}:": return dw_block(id)
        return dw_fail(id, "this expression block")
    if k == "Postfix" and op == "...":
        fatal(pos, "spread is supported inside array or record literals: `[values... item]` or `[base... field=value]`")
    if k == "Prefix":
        e = dw_expr(dw_child(id, 1))
        if op == "@":
            add_flag(e, NF_MUT)
            return e
        if op == "-" and nodes[e].kind == .int_lit and nodes[e].aux2 == 0:
            if has_flag(e, NF_U64) and nodes[e].ival != -9223372036854775807 - 1:
                value = u64(nodes[e].ival)
                return dw_bigint_value([value & 0xFFFFFFFF, value >> 32], pos, true)
            nodes[e].ival = -nodes[e].ival
            nodes[e].pos = pos
            nodes[e].aux2 = 1
            clear_flag(e, NF_U64)
            return e
        if op == "-" and nodes[e].kind == .float_lit:
            nodes[e].fval = -nodes[e].fval
            nodes[e].pos = pos
            return e
        n = mk(if op == "not": NK.not_ else: NK.unary, pos)
        if op != "-" and op != "not" and op != "+": return dw_fail(id, "prefix '{op}'")
        nodes[n].op = i32(int(if op == "-": Tok.minus else: Tok.plus))
        nodes[n].a = i32(e)
        return n
    if k == "Flow":
        loop arm in dewy_syntax[id].children:
            if dewy_syntax[arm].kind == "KeywordExpr" and dewy_syntax[dw_child(arm, 0)].text == "loop":
                return dw_fail(arm, "a loop used as a value; use return or a comprehension")
        return dw_flow(id, 0)
    if k == "BinOp":
        left = dw_child(id, 1)
        right = dw_child(id, 2)
        if op == "is?" or op == "isnt?":
            n = mk(.istype, pos)
            nodes[n].a = i32(dw_expr(left))
            nodes[n].b = i32(dw_type(right))
            if op == "isnt?" or dewy_syntax[dw_child(id, 0)].kind == "InvertedComparisonOp":
                inverted = mk(.not_, pos)
                nodes[inverted].a = i32(n)
                return inverted
            return n
        if dewy_syntax[dw_child(id, 0)].kind == "InvertedComparisonOp":
            comparison = mk(.binary, pos)
            nodes[comparison].op = i32(int(dw_binary_token(op, id)))
            nodes[comparison].a = i32(dw_expr(left))
            nodes[comparison].b = i32(if op == "in?": dw_membership(right) else: dw_expr(right))
            n = mk(.not_, pos)
            nodes[n].a = i32(comparison)
            return n
        if op == "=>": return dw_function(id, "")
        if op == "TypeParamJuxtapose":
            n = mk(.typeapply, pos)
            nodes[n].a = i32(dw_expr(left))
            nodes[n].c = i32(dw_type(id))
            args: int[]
            loop child in dewy_syntax[right].children: args.push(dw_type(child))
            set_list(n, args)
            return n
        if op == "//" or op == "%" or op == "^" or op == "/":
            a = dw_expr(left)
            b = dw_expr(right)
            name = if op == "/": "__dewy_divide" else if op == "^": "__dewy_power" else if op == "//": "__floor_div" else: "__floor_mod"
            callee = mk(.ident, pos)
            nodes[callee].name = i32(intern(name))
            n = mk(.call, pos)
            nodes[n].a = i32(callee)
            set_list(n, [a, b])
            return n
        if op == ".":
            name = dw_name(right)
            if name == "": return dw_fail(id, "computed member names")
            n = mk(.field, pos)
            nodes[n].a = i32(dw_expr(left))
            nodes[n].name = i32(intern(name))
            return n
        if op == "as":
            n = mk(.cast, pos)
            nodes[n].a = i32(dw_expr(left))
            nodes[n].b = i32(dw_type(right))
            return n
        if starts_with(op, "CallJuxtapose") or op == "IndexJuxtapose":
            xs = dewy_syntax[right].children
            bracket = dewy_syntax[right].kind == "Block" and dewy_syntax[right].text in ["[]:", "[):"]
            n = mk(if bracket: NK.index else: NK.call, pos)
            nodes[n].a = i32(dw_expr(left))
            callee = int(nodes[n].a)
            if not bracket and nodes[callee].kind == .field: add_flag(int(nodes[callee].a), NF_MUT)
            args: int[]
            if bracket: dw_index_context.push(n)
            if dewy_syntax[right].kind != "Block": args.push(dw_expr(right))
            else if bracket and xs.len() == 1 and (dw_op(xs[0]) == "RangeJuxtapose" or dw_name(xs[0]) == ".."):
                args.push(dw_iterable(right, true))
            else:
                if dewy_syntax[right].text == "[):": return dw_fail(right, "an exclusive index without a range")
                loop child in xs:
                    if dw_op(child) == "=":
                        a = mk(.namedarg, dewy_syntax[child].pos)
                        nodes[a].name = i32(intern(dw_name(dw_child(child, 1))))
                        nodes[a].a = i32(dw_expr(dw_child(child, 2)))
                        args.push(a)
                    else: args.push(dw_expr(child))
            if bracket: dw_index_context.pop()
            set_list(n, args)
            if bracket and args.len() == 1: nodes[n].b = i32(args[0])
            return n
        if op == "??":
            n = mk(.coalesce, pos)
            nodes[n].a = i32(dw_expr(left))
            nodes[n].b = i32(dw_expr(right))
            return n
        n = mk(if op == "and": NK.and_ else if op == "or": NK.or_ else: NK.binary, pos)
        nodes[n].op = i32(int(dw_binary_token(op, id)))
        nodes[n].a = i32(dw_expr(left))
        nodes[n].b = i32(if op == "in?": dw_membership(right) else: dw_expr(right))
        return n
    return dw_fail(id, "syntax '{k}'")

dw_stmt = (id: int, top: bool = false) -> int:
    let id = dw_unwrap(id)
    pos = dewy_syntax[id].pos
    k = dewy_syntax[id].kind
    if dw_op(id) == "as" and dw_is_include(dw_child(id, 1)):
        name = dw_name(dw_child(id, 2))
        if name == "": return dw_fail(id, "this asset binding")
        n = mk(.vardecl, pos)
        nodes[n].name = i32(intern(name))
        nodes[n].b = i32(dw_include(dw_child(id, 1)))
        return n
    if dw_op(id) == "SemicolonJuxtapose":
        s = dw_stmt(dw_child(id, 1), top)
        if nodes[s].kind == .exprstmt:
            n = mk(.assign, pos)
            nodes[n].op = i32(int(Tok.assign))
            nodes[n].a = i32(mk(.hole, pos))
            nodes[n].b = nodes[s].a
            return n
        return s
    if k == "KeywordExpr":
        word = dewy_syntax[dw_child(id, 0)].text
        if word == "from" or word == "import":
            if not top: return dw_fail(id, "local imports")
            return dw_import(id)
        if word == "return":
            n = mk(.return_, pos)
            if dewy_syntax[id].children.len() > 1: nodes[n].a = i32(dw_expr(dw_child(id, 1)))
            return n
        if word == "let" or word == "const": return dw_declare(dw_child(id, 1), word == "const", top)
        if word == "break" or word == "continue":
            n = mk(if word == "break": NK.break_ else: NK.continue_, pos)
            if dewy_syntax[id].children.len() > 1:
                label = dw_child(id, 1)
                if dewy_syntax[label].kind != "Metatag": return dw_fail(label, "a loop exit without a $label")
                nodes[n].name = i32(intern(dewy_syntax[label].text))
            return n
        return dw_fail(id, "statement '{word}'")
    if k == "Flow":
        n = dw_flow(id, 0)
        add_flag(n, NF_STMT)
        return dw_flow_stmt(n)
    if dw_op(id) in ["+=", "-=", "*=", "/=", "//=", "%=", "^=", "<<=", ">>="]:
        n = mk(.assign, pos)
        op = dw_op(id)
        nodes[n].op = i32(int(if op == "+=": Tok.pluseq else if op == "-=": Tok.minuseq else if op == "/=" or op == "//=": Tok.slasheq else if op == "%=": Tok.percenteq else if op == "^=": Tok.careteq else if op == "<<=": Tok.shleq else if op == ">>=": Tok.shreq else: Tok.stareq))
        if op in ["/=", "//=", "%=", "^="]:
            nodes[n].sval = i32(intern(if op == "/=": "__dewy_divide" else if op == "//=": "__floor_div" else if op == "%=": "__floor_mod" else: "__dewy_power"))
        nodes[n].a = i32(dw_expr(dw_child(id, 1)))
        nodes[n].b = i32(dw_expr(dw_child(id, 2)))
        return n
    if dw_op(id) == "=" or dw_op(id) == ":":
        if top or dw_op(id) == ":": return dw_declare(id, false, top)
        n = mk(.assign, pos)
        nodes[n].op = i32(int(Tok.assign))
        lhs = dw_unwrap(dw_child(id, 1))
        if dewy_syntax[lhs].kind == "Block" and dewy_syntax[lhs].text == "[]:":
            pattern = mk(.tuple, dewy_syntax[lhs].pos)
            set_list(pattern, dw_bindings(lhs))
            nodes[n].a = i32(pattern)
        else: nodes[n].a = i32(dw_expr(lhs))
        nodes[n].b = i32(dw_expr(dw_child(id, 2)))
        return n
    n = mk(.exprstmt, pos)
    nodes[n].a = i32(dw_expr(id))
    return n

dw_bindings = (id: int) -> int[]:
    bindings: int[]
    seen: {str: bool} = {}
    loop child in dewy_syntax[id].children:
        name = dw_name(child)
        if name == "": return [dw_fail(child, "nested or annotated unpacking targets; use simple names")]
        if name != "_" and seen.has(name): fatal(dewy_syntax[child].pos, "duplicate unpacking name '{name}'")
        seen[name] = true
        n = mk(if name == "_": NK.hole else: NK.ident, dewy_syntax[child].pos)
        nodes[n].name = i32(intern(name))
        bindings.push(n)
    if bindings.len() == 0: return [dw_fail(id, "an empty unpacking target")]
    bindings

dw_declare = (id: int, constant: bool, top: bool) -> int:
    let id = dw_unwrap(id)
    initial = 0
    lhs = id
    if dw_op(id) == "=":
        lhs = dw_child(id, 1)
        initial = dw_child(id, 2)
    annotation = 0
    if dw_op(lhs) == ":":
        annotation = dw_child(lhs, 2)
        lhs = dw_child(lhs, 1)
    if dewy_syntax[lhs].kind == "Block" and dewy_syntax[lhs].text == "[]:":
        if initial == 0 or annotation != 0 or constant: return dw_fail(lhs, "unpacking without a value, with an annotation, or with const")
        n = mk(.vardecl, dewy_syntax[id].pos)
        set_list(n, dw_bindings(lhs))
        nodes[n].b = i32(dw_expr(initial))
        return n
    name = dw_name(lhs)
    if name == "": return dw_fail(lhs, "this declaration")
    if not top and initial != 0 and dw_op(dw_grouped(initial)) == "&":
        return dw_fail(initial, "a local overload group; declare it at module level")
    if initial != 0 and dw_op(initial) == "=>":
        if top: return dw_function(initial, name)
        n = mk(.vardecl, dewy_syntax[id].pos)
        nodes[n].name = i32(intern(name))
        nodes[n].b = i32(dw_function(initial, ""))
        if annotation != 0: nodes[n].a = i32(dw_type(annotation))
        return n
    if annotation != 0 and dw_name(annotation) == "type":
        if initial == 0: return dw_fail(id, "a type declaration without a definition")
        type_params: int[]
        if dw_op(initial) in ["IndexJuxtapose", "CallJuxtapose"] and dewy_syntax[dw_child(initial, 1)].text == "<>:":
            type_params = dw_type_params(dw_child(initial, 1))
            initial = dw_child(initial, 2)
        if dewy_syntax[initial].text != "[]:":
            n = mk(.typealias, dewy_syntax[id].pos)
            nodes[n].name = i32(intern(name))
            nodes[n].a = i32(dw_type(initial))
            if type_params.len() > 0:
                set_list2(n, type_params)
                add_flag(n, NF_GENERIC)
            return n
        n = mk(.struct_, dewy_syntax[id].pos)
        nodes[n].name = i32(intern(name))
        if type_params.len() > 0:
            set_list2(n, type_params)
            add_flag(n, NF_GENERIC)
        fields: int[]
        loop field in dewy_syntax[initial].children: fields.push(dw_param(field, .vardecl))
        set_list(n, fields)
        return n
    n = mk(if constant: NK.const_ else: NK.vardecl, dewy_syntax[id].pos)
    nodes[n].name = i32(intern(name))
    if annotation != 0: nodes[n].a = i32(dw_type(annotation))
    if initial != 0: nodes[n].b = i32(dw_expr(initial))
    return n

dw_import = (id: int) -> int:
    pos = dewy_syntax[id].pos
    n = mk(.import_, pos)
    spec = dw_unwrap(dw_child(id, 1))
    alias = ""
    if dw_op(spec) == "as":
        alias = dw_name(dw_child(spec, 2))
        if alias == "": return dw_fail(spec, "this module alias")
        spec = dw_unwrap(dw_child(spec, 1))
    value = dw_name(spec)
    if value == "":
        if dw_op(spec) != "CallJuxtapose" or dw_name(dw_child(spec, 1)) != "p": return dw_fail(spec, "this module path; use a library name or p\"file.dewy\"")
        path = dw_unwrap(dw_child(spec, 2))
        if dewy_syntax[path].kind != "String": return dw_fail(path, "a nonliteral module path")
        value = dewy_syntax[path].text
        nodes[n].aux2 = 1
    nodes[n].sval = i32(intern(value))
    nodes[n].name = i32(intern(strip_ext(file_name(value))))
    if alias != "": nodes[n].name = i32(intern(alias))
    if dewy_syntax[dw_child(id, 0)].text == "from":
        if dewy_syntax[id].children.len() != 4: return dw_fail(id, "this import")
        nodes[n].aux = 2
        selected = dw_unwrap(dw_child(id, 3))
        imported: int[]
        if dw_op(selected) == ",":
            loop i in [1..dewy_syntax[selected].children.len()): imported.push(dw_import_name(dw_child(selected, i)))
        else: imported.push(dw_import_name(selected))
        loop item in imported:
            if nodes[item].kind != .ident: return dw_fail(selected, "this imported name")
        set_list(n, imported)
    else if dewy_syntax[id].children.len() != 2: return dw_fail(id, "this import alias")
    return n

dw_import_name = (id: int) -> int:
    let id = dw_unwrap(id)
    loop dewy_syntax[id].kind == "Block" and dewy_syntax[id].text == "():" and dewy_syntax[id].children.len() == 1:
        id = dw_unwrap(dw_child(id, 0))
    alias = ""
    if dw_op(id) == "as":
        alias = dw_name(dw_child(id, 2))
        if alias == "": return dw_fail(id, "this imported alias; group each aliased name")
        id = dw_child(id, 1)
    if dw_name(id) == "": return dw_fail(id, "this imported name")
    n = dw_expr(id)
    if alias != "": nodes[n].aux = i32(intern(alias))
    return n

dw_range_value = (range: int) -> int:
    pos = nodes[range].pos
    if nodes[range].a == 0 or nodes[range].b == 0: fatal(pos, "a stored range needs both endpoints; open ranges can be used directly in loops or membership")
    step = has_flag(range, NF_STEP)
    second = if step: int(nodes[range].c) else: bc_int(0, pos)
    stepped = mk(.bool_lit, pos)
    nodes[stepped].ival = if step: 1 else: 0
    inclusive = mk(.bool_lit, pos)
    nodes[inclusive].ival = if has_flag(range, NF_INCLUSIVE): 1 else: 0
    result = bc_call("__dewy_range", [int(nodes[range].a), second, int(nodes[range].b), stepped, inclusive], pos)
    if has_flag(range, NF_EXCL_FIRST): result = bc_call("__dewy_range_tail", [result], pos)
    result

dw_membership = (id: int) -> int:
    r = dw_iterable(id, true, true)
    if nodes[r].kind == .range and (has_flag(r, NF_STEP) or has_flag(r, NF_EXCL_FIRST)): return dw_range_value(r)
    r

dw_iterable = (id: int, slice: bool = false, membership: bool = false) -> int:
    let id = dw_unwrap(id)
    inclusive = true
    exclude_first = false
    if dewy_syntax[id].kind == "Block" and dewy_syntax[id].children.len() == 1 and (dw_op(dw_child(id, 0)) == "RangeJuxtapose" or dw_name(dw_child(id, 0)) == ".."):
        wrapper = dewy_syntax[id].text
        if wrapper not in ["[]:", "[):", "():", "(]:"]: return dw_fail(id, "this range boundary")
        inclusive = wrapper == "[]:" or wrapper == "(]:"
        exclude_first = wrapper == "():" or wrapper == "(]:"
        if exclude_first and slice and not membership: return dw_fail(id, "a slice with an exclusive first bound")
        id = dw_unwrap(dw_child(id, 0))
    if slice and dw_name(id) == "..": return mk(.range, dewy_syntax[id].pos)
    if dw_op(id) != "RangeJuxtapose":
        value = dw_expr(id)
        if slice: return value
        # Resolve iterable strings once, before combined-loop desugaring. Other
        # iterable types keep their existing representation without a wrapper.
        call = mk(.call, dewy_syntax[id].pos)
        callee = mk(.ident, dewy_syntax[id].pos)
        nodes[callee].name = i32(intern("__dewy_iter"))
        nodes[call].a = i32(callee)
        set_list(call, [value])
        return call
    size = dewy_syntax[id].children.len()
    n = mk(.range, dewy_syntax[id].pos)
    at = 1
    if dw_name(dw_child(id, at)) != "..":
        first = dw_unwrap(dw_child(id, at))
        if dw_op(first) == ",":
            if dewy_syntax[first].children.len() != 3: return dw_fail(first, "a stepped range without exactly two starting values")
            nodes[n].a = i32(dw_expr(dw_child(first, 1)))
            nodes[n].c = i32(dw_expr(dw_child(first, 2)))
            add_flag(n, NF_STEP)
        else: nodes[n].a = i32(dw_expr(first))
        at += 1
    else if not slice: return dw_fail(id, "a loop range without a start")
    if at >= size or dw_name(dw_child(id, at)) != ".." or size > at + 2: return dw_fail(id, "this range")
    if size == at + 2: nodes[n].b = i32(dw_expr(dw_child(id, at + 1)))
    if inclusive: add_flag(n, NF_INCLUSIVE)
    if exclude_first:
        add_flag(n, NF_EXCL_FIRST)
        if not slice: return bc_call("__dewy_iter", [dw_range_value(n)], dewy_syntax[id].pos)
    return n

dw_loop_head = (id: int, combined: bool = false) -> int:
    let id = dw_unwrap(id)
    op = dw_op(id)
    n = mk(.lhead, dewy_syntax[id].pos)
    if op == "in":
        nodes[n].op = 1
        binder = dw_unwrap(dw_child(id, 1))
        binders: int[]
        if dewy_syntax[binder].kind == "Block" and dewy_syntax[binder].text == "[]:":
            loop element in dewy_syntax[binder].children:
                if dw_name(element) == "": return dw_fail(element, "this loop binding")
                binders.push(dw_expr(element))
        else:
            if dw_name(binder) == "": return dw_fail(binder, "this loop binding")
            binders.push(dw_expr(binder))
        set_list(n, binders)
        it = dw_iterable(dw_child(id, 2))
        if combined and nodes[it].kind == .range and has_flag(it, NF_STEP) and nodes[it].b != 0:
            it = bc_call("__dewy_iter", [dw_range_value(it)], nodes[it].pos)
        nodes[n].a = i32(it)
    else if op == "and" or op == "or":
        nodes[n].op = if op == "and": 2 else: 3
        nodes[n].a = i32(dw_loop_head(dw_child(id, 1), true))
        nodes[n].b = i32(dw_loop_head(dw_child(id, 2), true))
        return head_collapse(n)
    else:
        nodes[n].op = 4
        nodes[n].a = i32(dw_expr(id))
    return n

# Match bodies use the same statement/value blocks as functions and conditionals.
dw_flow_stmt = (n: int) -> int:
    if nodes[n].kind != .match_: return n
    s = mk(.exprstmt, nodes[n].pos)
    nodes[s].a = i32(n)
    s

dw_pattern = (id: int) -> int:
    let id = dw_unwrap(id)
    pos = dewy_syntax[id].pos
    name = dw_name(id)
    if name != "":
        p = mk(.pwild, pos)
        if name != "_": nodes[p].name = i32(intern(name))
        return p
    binding = ""
    if dw_op(id) == ":":
        binding = dw_name(dw_child(id, 1))
        if binding == "": return dw_fail(id, "this match binding")
        id = dw_unwrap(dw_child(id, 2))
    else if dewy_syntax[id].kind == "Block" and dewy_syntax[id].text == "<>:" and dewy_syntax[id].children.len() == 1:
        id = dw_unwrap(dw_child(id, 0))
    else: return dw_fail(id, "this match pattern")
    k = dewy_syntax[id].kind
    literal = k == "Integer" or k == "String" or k == "Bool" or dw_name(id) == "none"
    if dw_op(id) == "-": literal = dewy_syntax[dw_unwrap(dw_child(id, 1))].kind == "Integer"
    p = mk(if literal: NK.plit else: NK.ptype, pos)
    nodes[p].a = i32(if literal: dw_expr(id) else: dw_type(id))
    if binding != "" and binding != "_": nodes[p].name = i32(intern(binding))
    p

dw_match = (id: int, accumulator: int = 0, map: bool = false) -> int:
    n = mk(.match_, dewy_syntax[id].pos)
    nodes[n].a = i32(dw_expr(dw_child(id, 1)))
    body = dw_child(id, 2)
    arms = [body]
    if dewy_syntax[body].kind == "Block" and dewy_syntax[body].text == "{{}}:": arms = dewy_syntax[body].children
    xs: int[]
    loop source in arms:
        if dw_op(source) != "=>": return dw_fail(source, "a match arm without =>")
        arm = mk(.arm, dewy_syntax[source].pos)
        set_list(arm, [dw_pattern(dw_child(source, 1))])
        nodes[arm].b = i32(dw_block(dw_child(source, 2), accumulator, map))
        xs.push(arm)
    set_list(n, xs)
    n

dw_flow = (id: int, at: int, accumulator: int = 0, map: bool = false) -> int:
    items = dewy_syntax[id].children
    if at >= items.len(): return 0
    arm = items[at]
    if dewy_syntax[arm].kind != "KeywordExpr": return dw_block(arm, accumulator, map)
    word = dewy_syntax[dw_child(arm, 0)].text
    if word == "match":
        n = dw_match(arm, accumulator, map)
        if at + 1 < items.len():
            rest = dw_flow(id, at + 1, accumulator, map)
            if nodes[rest].kind != .block:
                block = mk(.block, nodes[rest].pos)
                set_list(block, [dw_flow_stmt(rest)])
                rest = block
            fallback = mk(.arm, nodes[rest].pos)
            set_list(fallback, [mk(.pwild, nodes[rest].pos)])
            nodes[fallback].b = i32(rest)
            xs = kids(n)
            xs.push(fallback)
            set_list(n, xs)
        return n
    if word != "if" and word != "loop": return dw_block(arm, accumulator, map)
    if dewy_syntax[arm].children.len() != 3: return dw_fail(arm, "this flow arm")
    n = mk(if word == "if": NK.if_ else: NK.while_, dewy_syntax[arm].pos)
    if word == "loop":
        head = dw_loop_head(dw_child(arm, 1))
        if at + 1 < items.len():
            nodes[n].kind = .loopx
            nodes[n].a = i32(head)
        else if nodes[head].op == 1:
            nodes[n].kind = .for_
            nodes[n].a = nodes[head].a
            set_list(n, kids(head))
        else if nodes[head].op == 4: nodes[n].a = nodes[head].a
        else:
            nodes[n].kind = .loopx
            nodes[n].a = i32(head)
    else: nodes[n].a = i32(dw_expr(dw_child(arm, 1)))
    nodes[n].b = i32(dw_block(dw_child(arm, 2), accumulator, map))
    if at + 1 < items.len():
        rest = dw_flow(id, at + 1, accumulator, map)
        if nodes[rest].kind != .block:
            block = mk(.block, dewy_syntax[arm].pos)
            set_list(block, [dw_flow_stmt(rest)])
            rest = block
        nodes[n].c = i32(rest)
    return n

dw_block = (id: int, accumulator: int = 0, map: bool = false) -> int:
    n = mk(.block, dewy_syntax[id].pos)
    statements: int[]
    if dewy_syntax[id].kind == "Block" and dewy_syntax[id].text == "{{}}:":
        children = dewy_syntax[id].children
        label = 0
        label_pos = 0
        loop i in 0.. and child in children:
            if dewy_syntax[child].kind == "Metatag":
                if label != 0: fatal(label_pos, "a loop label must be followed by a loop")
                label = intern(dewy_syntax[child].text)
                label_pos = dewy_syntax[child].pos
                continue
            statement = if accumulator != 0 and i + 1 == children.len(): dw_collect(child, accumulator, map) else: dw_stmt(child)
            if label != 0:
                if nodes[statement].kind != .loopx and nodes[statement].kind != .for_ and nodes[statement].kind != .while_: fatal(label_pos, "a loop label must be followed by a loop")
                nodes[statement].sval = i32(label)
                label = 0
            statements.push(statement)
        if label != 0: fatal(label_pos, "a loop label must be followed by a loop")
    else if accumulator != 0: statements.push(dw_collect(id, accumulator, map))
    else: statements.push(dw_stmt(id))
    set_list(n, statements)
    return n

# Comprehensions use ordinary loops, conditionals and push calls, following the
# implementation-language frontend. No lazy runtime or separate ownership path.
dw_collection_kind = (id: int) -> int:
    let id = dw_unwrap(id)
    kind = dewy_syntax[id].kind
    children = dewy_syntax[id].children
    candidates: int[]
    if kind == "Flow":
        loop arm in children:
            if dewy_syntax[arm].kind == "KeywordExpr":
                word = dewy_syntax[dw_child(arm, 0)].text
                if word == "match":
                    body = dw_child(arm, 2)
                    arms = [body]
                    if dewy_syntax[body].kind == "Block": arms = dewy_syntax[body].children
                    loop branch in arms:
                        if dw_op(branch) != "=>": return dw_fail(branch, "a match arm without =>")
                        candidates.push(dw_child(branch, 2))
                else: candidates.push(dw_child(arm, 2))
            else: candidates.push(arm)
    else if kind == "Block" and dewy_syntax[id].text == "{{}}:":
        if children.len() == 0: return 0
        candidates.push(children[children.len() - 1])
    else:
        if kind == "KeywordExpr" or dw_op(id) in ["SemicolonJuxtapose", "=", "+=", "-=", "*=", "/=", "//=", "%=", "^=", "<<=", ">>="]: return 0
        return if dw_op(id) == "->": 2 else: 1
    result = 0
    loop candidate in candidates:
        next = dw_collection_kind(candidate)
        if next == 0: continue
        if result != 0 and result != next: fatal(dewy_syntax[candidate].pos, "a comprehension cannot mix array elements and dictionary entries")
        result = next
    result

dw_collect = (id: int, accumulator: int, map: bool) -> int:
    let id = dw_unwrap(id)
    kind = dewy_syntax[id].kind
    if kind == "Flow":
        n = dw_flow(id, 0, accumulator, map)
        add_flag(n, NF_STMT)
        return dw_flow_stmt(n)
    if kind == "Block" and dewy_syntax[id].text == "{{}}:": return dw_block(id, accumulator, map)
    if kind == "KeywordExpr" or dw_op(id) in ["SemicolonJuxtapose", "=", "+=", "-=", "*=", "/=", "//=", "%=", "^=", "<<=", ">>="]: return dw_stmt(id)
    pos = dewy_syntax[id].pos
    value = 0
    if map:
        if dw_op(id) != "->": return dw_fail(id, "a dictionary comprehension element without ->")
        value = mk(.tuple, pos)
        set_list(value, [dw_expr(dw_child(id, 1)), dw_expr(dw_child(id, 2))])
    else: value = dw_expr(id)
    receiver = mk(.ident, pos)
    nodes[receiver].name = i32(accumulator)
    add_flag(receiver, NF_MUT)
    callee = mk(.field, pos)
    nodes[callee].a = i32(receiver)
    nodes[callee].name = i32(intern("push"))
    call = mk(.call, pos)
    nodes[call].a = i32(callee)
    set_list(call, [value])
    statement = mk(.exprstmt, pos)
    nodes[statement].a = i32(call)
    statement

dw_comprehension = (id: int) -> int:
    pos = dewy_syntax[id].pos
    map = dw_collection_kind(id) == 2
    # `$` cannot begin an ordinary identifier, so this binding cannot capture a
    # user-written name, including one inside a nested comprehension.
    accumulator = intern("$dewy_collection_{nodes.len()}")
    decl = mk(.vardecl, pos)
    nodes[decl].name = i32(accumulator)
    nodes[decl].b = i32(mk(.array, pos))
    body = dw_collect(id, accumulator, map)
    result = mk(.exprstmt, pos)
    value = mk(.ident, pos)
    nodes[value].name = i32(accumulator)
    nodes[result].a = i32(value)
    block = mk(.block, pos)
    set_list(block, [decl, body, result])
    add_flag(block, NF_COMPREHENSION)
    if not map: return block
    callee = mk(.ident, pos)
    nodes[callee].name = i32(intern("__map_of"))
    call = mk(.call, pos)
    nodes[call].a = i32(callee)
    set_list(call, [block])
    call

# Strip grouping parentheses when recognizing a function declaration or group.
dw_grouped = (id: int) -> int:
    let id = dw_unwrap(id)
    loop dewy_syntax[id].kind == "Block" and dewy_syntax[id].text == "():" and dewy_syntax[id].children.len() == 1:
        id = dw_unwrap(dw_child(id, 0))
    id

dw_overload_members = (id: int, name: str, declarations: mut int[]):
    let id = dw_grouped(id)
    if dw_op(id) == "&":
        loop i in [1..dewy_syntax[id].children.len()):
            dw_overload_members(dw_child(id, i), name, declarations)
    else if dw_op(id) == "=>": declarations.push(dw_function(id, name))
    else: dw_fail(id, "an overload group member other than a function literal")

# Expand a static overload group directly into ordinary declarations. This keeps
# overload selection, generic specialization and callable context in one checker.
dw_top_declarations = (id: int) -> int[]:
    declaration = dw_unwrap(id)
    if dw_op(declaration) == "SemicolonJuxtapose": declaration = dw_unwrap(dw_child(declaration, 1))
    if dewy_syntax[declaration].kind == "KeywordExpr":
        word = dewy_syntax[dw_child(declaration, 0)].text
        if word == "let" or word == "const": declaration = dw_unwrap(dw_child(declaration, 1))
    if dw_op(declaration) == "=":
        name = dw_name(dw_child(declaration, 1))
        initial = dw_grouped(dw_child(declaration, 2))
        if name != "" and dw_op(initial) == "&":
            if name == "main": return [dw_fail(id, "an overloaded entry point")]
            declarations: int[]
            dw_overload_members(initial, name, declarations)
            return declarations
        if name != "" and dw_op(initial) == "=>": return [dw_function(initial, name)]
    [dw_stmt(id, true)]

dewy_parse_file = (file: int) -> int[]:
    dw_bigint_import = 0
    parser = env("DEWY_CORE_PARSER") ?? join_path(dir_name(exe_path()), "dewy-parse")
    if not file_exists(parser): fatal(mkpos(file, 0), "legacy syntax parser is not installed; rebuild with --legacy-parser or use the default frontend")
    # Parse the compiler's source snapshot, including unsaved editor text.
    # A Linux anonymous file avoids named temporary files and argument-size
    # limits. The parent keeps it open until the child has finished reading.
    fd = syscall(319, data(__zstr("dewy-syntax")), 1)  # memfd_create(MFD_CLOEXEC)
    if fd < 0: fatal(mkpos(file, 0), "could not create the parser's source snapshot")
    source = files[file].src
    written = 0
    loop written < len(source):
        count = syscall(1, fd, data(source) + written, len(source) - written)
        if count == -4: continue
        if count <= 0:
            syscall(3, fd)
            fatal(mkpos(file, 0), "could not write the parser's source snapshot")
        written += count
    snapshot = "/proc/{syscall(39)}/fd/{fd}"
    status, output = run_program(parser, [files[file].path, "--snapshot", snapshot])
    syscall(3, fd)
    if status != 0:
        if starts_with(output, "error\t"):
            fields = split(trim(output), "\t")
            if fields.len() == 3:
                payload = parse_json(fields[2])
                if payload is not JsonError:
                    fatal(mkpos(file, to_int(fields[1]) ?? 0), payload.as_str() ?? "invalid Dewy syntax")
        fatal(mkpos(file, 0), "Dewy syntax parser failed (exit {status})")
    dewy_syntax = [DewySyntax()]
    stack: int[]
    root = 0
    loop line in split(output, "\n"):
        if line == "": continue
        fields = split(line, "\t")
        if fields.len() != 5: fatal(mkpos(file, 0), "invalid syntax transport")
        depth = to_int(fields[0]) ?? -1
        start = to_int(fields[2]) ?? -1
        payload = parse_json(fields[4])
        if payload is JsonError: fatal(mkpos(file, 0), "invalid syntax payload")
        text = payload.as_str() ?? ""
        if depth < 0 or depth > stack.len() or start < 0: fatal(mkpos(file, 0), "invalid syntax location")
        stack.truncate(depth)
        id = dewy_syntax.len()
        dewy_syntax.push(DewySyntax(fields[1], text, mkpos(file, start)))
        if stack.len() > 0: dewy_syntax[stack[stack.len() - 1]].children.push(id)
        else: root = id
        stack.push(id)
    if root == 0: fatal(mkpos(file, 0), "missing syntax root")
    decls: int[]
    loop child in dewy_syntax[root].children:
        loop declaration in dw_top_declarations(child): decls.push(declaration)
    dewy_syntax = []
    return dw_finish_declarations(decls)

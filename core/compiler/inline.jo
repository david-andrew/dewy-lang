# Inlining for release builds. All functions are lowered and optimized first; then calls to
# small non-recursive functions are replaced by a copy of the callee's body (with renamed
# vregs and frame slots, and `ret` turned into a branch out of a wrapping block), and the
# caller is optimized again.

use 'ir.jo'
use 'check.jo'
use 'opt.jo'

const INLINE_MAX = 24       # callee size limit, in IR instructions
const INLINE_LOOP_MAX = 96  # ... for a call in a loop to a leaf (a function that calls nothing)
const INLINE_WRAPPER_MAX = 64   # ... for a leaf called once by a function at most this size
const INLINE_LOOPY_CALLER_MAX = 400     # (a leaf with a loop: only into callers this small)
inl_calls = 0               # calls (that return, not on rare paths) in the function being inlined into

rel_fns: IrFn[]             # lowered functions, in lowering order
rel_by_index: int[]         # lfunc index -> position in rel_fns (-1: not collected)

# Default builds expand tiny leaves and one layer of small wrappers before
# their one local pass. Wrapper expansion is bounded and uses only original
# leaves, so declaration order cannot grow an arbitrary call chain.
# No callee optimization, call-graph ordering or repeated caller optimization.
fast_fns: IrFn[]
fast_by_index: int[]

fast_inline_kind = (f: IrFn) -> int:
    if f.cabi or f.noinline or len(f.export_name) > 0 or f.code.len() > 24 or f.slot_size.len() > 0: return 0
    calls = 0
    # A nonreturning failure path does not add a call to successful execution.
    # Retain it when expanding bounds-checked helpers, just as release does.
    loop ins in f.code:
        if ins.op == .call and ins.c != 1:
            if ins.c != 0 or calls != 0: return 0
            calls += 1
        if ins.op == .calli or ins.op == .callc or ins.op == .syscall or ins.op == .intr or ins.op == .loop or ins.op == .streq: return 0
    1 + calls

fast_inline_prepare = (fs: IrFn[]):
    fast_fns = []
    fast_by_index = []
    wrappers: int[]
    loop k in 0.. and f in fs:
        kind = fast_inline_kind(f)
        if kind == 0: continue
        if kind == 2:
            wrappers.push(k)
            continue
        loop fast_by_index.len() <= f.fn_index: fast_by_index.push(-1)
        fast_by_index[f.fn_index] = fast_fns.len()
        fast_fns.push(f)
    leaves = fast_fns.len()
    saved = ir
    loop k in wrappers:
        f = fs[k]
        leaf = -1
        loop ins in f.code:
            if ins.op != .call or ins.c != 0: continue
            if ins.imm >= fast_by_index.len(): break
            j = fast_by_index[int(ins.imm)]
            if j >= 0 and j < leaves and int(ins.b) == fast_fns[j].nparams: leaf = j
        if leaf < 0: continue
        ir = f
        # k_vreg's register cache belongs to one function, including this
        # preparation step before ordinary emission starts.
        kc_fn += 1
        fast_inline_into()
        if ir.code.len() > 48: continue
        loop fast_by_index.len() <= f.fn_index: fast_by_index.push(-1)
        fast_by_index[f.fn_index] = fast_fns.len()
        fast_fns.push(ir)
    ir = saved

fast_inline_target = (ins: Ins) -> int:
    if ins.op != .call or ins.c != 0 or ins.imm >= fast_by_index.len(): return -1
    j = fast_by_index[int(ins.imm)]
    if j < 0 or fast_fns[j].fn_index == ir.fn_index or int(ins.b) != fast_fns[j].nparams: return -1
    j

fast_inline_into = ():
    if fast_fns.len() == 0: return
    found = false
    loop ins in ir.code:
        if fast_inline_target(ins) >= 0:
            found = true
            break
    if not found: return
    out: Ins[]
    out.reserve(ir.code.len() * 2)
    old = ir.code
    loop ins in old:
        j = fast_inline_target(ins)
        if j >= 0: inline_call(ins, fast_fns[j], out)
        else: out.push(ins)
    ir.code = out

rel_collect = ():
    loop rel_by_index.len() <= ir.fn_index: rel_by_index.push(-1)
    rel_by_index[ir.fn_index] = rel_fns.len()
    rel_fns.push(ir)

# 0: not inlined, 1: small (inlined anywhere), 2: a leaf inlined into loops, 3: the same with a
# loop of its own (into callers that are not large: in a large one, what its loop keeps in
# registers may not get them, and a call costs little next to a loop)
inlinable = (f: IrFn) -> int:
    if f.cabi or f.noinline or len(f.export_name) > 0 or f.code.len() > INLINE_LOOP_MAX: return 0
    leaf = true
    has_loop = false
    size = f.code.len()
    loop ins in f.code:
        if ins.op == .loop: has_loop = true
        if ins.op == .streq:
            # Match the existing string helper plus its bounded comparison.
            size += 81
            has_loop = true
        if ins.op == .memeq:
            # A variable-length comparison expands to several size cases and
            # a vector loop. Charge it as a substantial body, not one scalar
            # instruction, while still allowing its small callers to inline.
            size += 47
            has_loop = true
        if ins.op == .call and ins.imm == f.fn_index: return 0         # recursive
        if ins.op == .intr and ins.imm >= 2: return 0                 # setjmp-like intrinsics
        # (calls on rarely taken paths, like the out-of-line refcounting during a parallel job,
        # do not count)
        if (ins.op == .call and ins.c == 0) or ins.op == .calli or ins.op == .callc or ins.op == .syscall: leaf = false
    # Keep a web loop kernel independently callable. Repeated calls let the
    # runtime tier it up; embedding it in a one-shot outer loop can keep the
    # entire workload in baseline machine code for that invocation.
    if target_wasm and has_loop: return 0
    if size > INLINE_LOOP_MAX: return 0
    if size <= INLINE_MAX: return 1
    if leaf and has_loop: return 3
    if leaf: return 2
    0

defines_value = (op: Op) -> bool:
    match op:
        nop, block, loop, end, else_, br, brif, brtable, if_, ret, trap, store, copy, zero, memcpy, memset, zeroslots, assume, vop: false
        _: true

# copy an argument list (vregs renamed) into the caller's args; returns its start
remap_args = (callee: IrFn, start: int, n: int, vm: int[]) -> int:
    s = ir.args.len()
    loop k in [0..n): ir.args.push(i32(vm[int(callee.args[start + k])]))
    s

# rename the vregs and slots used by a callee instruction
remap = (c0: Ins, callee: IrFn, vm: int[], sm: int[]) -> Ins:
    c = c0
    a = int(c.a)
    bb = int(c.b)
    match c.op:
        nop, block, loop, end, else_, br, trap, iconst, fconst, gaddr, daddr, faddr: pass
        slot: c.a = i32(sm[a])
        intr, call, syscall: c.a = i32(remap_args(callee, a, bb, vm))
        calli, callc:
            c.a = i32(remap_args(callee, a, bb, vm))
            c.c = i32(vm[int(c.c)])
        if_, brif, zero, assume: c.a = i32(vm[a])
        brtable:
            c.a = i32(vm[a])
            s = ir.args.len()
            loop k in [0..bb): ir.args.push(callee.args[int(c.c) + k])
            c.c = i32(s)
        ret:
            if a >= 0: c.a = i32(vm[a])
        store, copy:
            c.a = i32(vm[a])
            c.b = i32(vm[bb])
            if c.op == .store and int(c.c) & M_INDEX != 0: c.dst = i32(vm[int(c.dst)])
        memcpy, memset, select, vop, memeq:
            c.a = i32(vm[a])
            c.b = i32(vm[bb])
            c.c = i32(vm[int(c.c)])
        zeroslots:
            s = ir.args.len()
            loop k in [0..bb):
                item = int(callee.args[a + k])
                if item & 1 == 1: ir.args.push(i32((vm[item >> 1] << 1) | 1))
                else: ir.args.push(i32(sm[item >> 1] << 1))
            c.a = i32(s)
        load:
            c.a = i32(vm[a])
            if int(c.c) & M_INDEX != 0: c.b = i32(vm[bb])
        mov, neg, not_, fneg, fsqrt, fabs, ffloor, fceil, ftrunc, sext8, sext16, sext32, zext8, zext16, zext32, i2f, u2f, f2i, f2f, bits2f, f2bits:
            c.a = i32(vm[a])
        _:
            c.a = i32(vm[a])
            c.b = i32(vm[bb])
    if defines_value(c.op) and c.dst >= 0 and c.op != .store: c.dst = i32(vm[int(c.dst)])
    c

# splice callee's body in place of `call` (appending to out)
inline_call = (call: Ins, callee: IrFn, out: mut Ins[]):
    vm = fill(0, callee.vtypes.len())
    loop v in [0..callee.vtypes.len()):
        if int(callee.vtypes[v]) == VK: vm[v] = k_vreg(callee.kval[v])
        else: vm[v] = vreg(int(callee.vtypes[v]))
    sm = fill(0, callee.slot_size.len())
    loop s in [0..callee.slot_size.len()): sm[s] = new_slot(int(callee.slot_size[s]), int(callee.slot_align[s]))
    loop k in [0..int(call.b)):
        p = vm[k]
        out.push(Ins(.mov, i32(vtype(p)), i32(p), ir.args[int(call.a) + k], 0, 0, 0))
    if callee.raw_mem: ir.raw_mem = true
    out.push(Ins(.block, 0, 0, 0, 0, 0, 0))
    depth = 0
    loop ci in callee.code:
        op = ci.op
        if op == .ret:
            if ci.a >= 0 and call.dst >= 0:
                out.push(Ins(.mov, i32(vtype(int(call.dst))), call.dst, i32(vm[int(ci.a)]), 0, 0, 0))
            out.push(Ins(.br, 0, 0, 0, 0, 0, depth))
            continue
        ni = remap(ci, callee, vm, sm)
        # (the calls of a callee inlined on a rarely taken path are on it too)
        if call.c == 2 and op == .call and ni.c == 0: ni.c = 2
        # (in a backtrace the inlined code is the call's line of the function it is in now)
        ni.pos = call.pos
        out.push(ni)
        if op == .block or op == .loop or op == .if_: depth += 1
        else if op == .end: depth -= 1
    out.push(Ins(.end, 0, 0, 0, 0, 0, 0))

# the callee to inline for a call in a loop nest `depth` deep (-1: none)
inline_target = (ins: Ins, depth: int, self_pos: int, snap: IrFn[], can: int[]) -> int:
    j = inline_callee(ins, self_pos, snap)
    if j < 0: return -1
    if can[j] == 1 or (can[j] == 2 and depth > 0): return j
    if can[j] == 3 and depth > 0 and ir.code.len() <= INLINE_LOOPY_CALLER_MAX: return j
    # a leaf into a caller that is little more than the call (a wrapper, like a map's get around
    # its lookup): the caller becomes a leaf itself, which loops can then take in
    if can[j] >= 2 and ir.code.len() <= INLINE_WRAPPER_MAX and inl_calls == 1: return j
    -1

# the function a direct call (that returns) calls, if it was collected (-1: none)
inline_callee = (ins: Ins, self_pos: int, snap: IrFn[]) -> int:
    if ins.op != .call or ins.c == 1 or ins.imm >= rel_by_index.len(): return -1
    j = rel_by_index[int(ins.imm)]
    if j < 0 or j == self_pos or int(ins.b) != snap[j].nparams: return -1
    j

# inline small callees into the current function (ir); returns true if anything changed
inline_into = (self_pos: int, snap: IrFn[], can: int[]) -> bool:
    # (the calls that stay: not inlined by size, not on a rarely taken path)
    inl_calls = 0
    loop ins in ir.code:
        if ins.op == .calli or ins.op == .callc: inl_calls += 1
        else if ins.op == .call and ins.c == 0:
            j = inline_callee(ins, self_pos, snap)
            if j < 0 or can[j] != 1: inl_calls += 1
    any = false
    depth = 0
    kinds: Op[]
    loop ins in ir.code:
        if inline_target(ins, depth, self_pos, snap, can) >= 0:
            any = true
            break
        if ins.op == .block or ins.op == .loop or ins.op == .if_:
            kinds.push(ins.op)
            if ins.op == .loop: depth += 1
        else if ins.op == .end:
            if kinds.pop() == .loop: depth -= 1
    if not any: return false
    out: Ins[]
    out.reserve(ir.code.len() * 2)
    old = ir.code
    depth = 0
    kinds.clear()
    loop ins in old:
        j = inline_target(ins, depth, self_pos, snap, can)
        if j >= 0:
            inline_call(ins, snap[j], out)
            continue
        out.push(ins)
        if ins.op == .block or ins.op == .loop or ins.op == .if_:
            kinds.push(ins.op)
            if ins.op == .loop: depth += 1
        else if ins.op == .end:
            if kinds.pop() == .loop: depth -= 1
    ir.code = out
    true

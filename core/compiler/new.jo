# Small Dewy starting points, using the same native/web runtime as ordinary builds.
use 'util.jo'

new_usage = ():
    eprint("usage: dewy-core new <directory> [game|program] (game is the default)")
    exit(2)

new_project = (lib: str, a: str[]):
    if a.len() < 3 or a.len() > 4 or starts_with(a[2], "-"): new_usage()
    kind = "game"
    if a.len() == 4: kind = a[3]
    if kind != "game" and kind != "program":
        eprint("dewy-core: no template '{kind}'")
        new_usage()
    dir = a[2]
    if file_exists(dir):
        eprint("dewy-core: {dir} already exists; choose a new directory")
        exit(1)
    template = "{lib}/new/dewy/{kind}.dewy"
    src = read_file(template) ?? ""
    if len(src) == 0:
        eprint("dewy-core: cannot read {template}")
        exit(1)
    readme = "# Dewy {kind}\n\nFrom this directory:\n\n```sh\ndewy-core main.dewy\ndewy-core check main.dewy\ndewy-core watch main.dewy\ndewy-core build main.dewy -o main\n```\n"
    if kind == "game":
        readme += "\nFor a self-contained web build:\n\n```sh\ndewy-core build main.dewy --target wasm -o main\n```\n\nOpen main.html in a browser. In watch mode, saving a function change updates the\nrunning game while keeping its state. Compiler errors leave the last working\nversion running. Use --release for an optimizing standalone build.\n"
    make_dirs(dir)
    if not write_file("{dir}/main.dewy", src) or not write_file("{dir}/README.md", readme) or not write_file("{dir}/.gitignore", "/main\n/main.exe\n/main.html\n/main.zip\n"):
        eprint("dewy-core: cannot write the project in {dir}")
        exit(1)
    print("Created {dir}/main.dewy. See {dir}/README.md to run, check and build it.")

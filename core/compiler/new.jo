# Small Dewy starting points, using the same native/web runtime as ordinary builds.
use 'util.jo'

new_usage = ():
    eprint("usage: dewy-core new <directory> [game|arcade|platformer|3d|online|program] (game is the default)")
    exit(2)

new_project_name = (dir: str, fallback: str) -> str:
    # Keep this usable by the C seed, which does not auto-load std/path.jo.
    path = replace(dir, "\\", "/")
    loop len(path) > 0 and path[len(path) - 1] == '/': path = path[..len(path) - 1)
    slash = rfind(path, "/")
    if slash >= 0: path = path[slash + 1..]
    name = ""
    loop c in path.lower():
        if is_alnum(c) or c == '_': name += byte_str(c)
        else if len(name) > 0 and name[len(name) - 1] != '-': name += "-"
    loop len(name) > 0 and name[len(name) - 1] == '-': name = name[..len(name) - 1)
    if len(name) == 0: name = fallback
    name + ".dewy"

new_project = (lib: str, a: str[]):
    if a.len() < 3 or a.len() > 4 or starts_with(a[2], "-"): new_usage()
    kind = "game"
    if a.len() == 4: kind = a[3]
    if kind != "game" and kind != "arcade" and kind != "platformer" and kind != "3d" and kind != "online" and kind != "program":
        eprint("dewy-core: no template '{kind}'")
        new_usage()
    dir = a[2]
    if file_exists(dir):
        eprint("dewy-core: {dir} already exists; choose a new directory")
        exit(1)
    template = "{lib}/new/dewy/{kind}.dewy"
    src = read_file(template) ?? ""
    if len(src) == 0:
        eprint("dewy-core: cannot read {template}")
        exit(1)
    entry = if kind == "online" or kind == "arcade": new_project_name(dir, kind) else: "main.dewy"
    readme = "# Dewy {kind}\n\nFrom this directory:\n\n```sh\ndewy-core {entry}\ndewy-core check {entry}\ndewy-core watch {entry}\ndewy-core build {entry} -o main\n```\n"
    if kind != "program":
        readme += "\nFor a self-contained web build:\n\n```sh\ndewy-core build {entry} --target wasm -o main\n```\n\nOpen main.html in a browser. In watch mode, saving a function change updates the\nrunning game while keeping its state. Compiler errors leave the last working\nversion running. Use --release for an optimizing standalone build.\n"
    if kind == "arcade":
        readme += "\nCollect gold and avoid the rocks with arrows/WASD or a gamepad. Escape/Start\npauses, as does leaving the window. Menus accept mouse, keyboard and gamepad.\nThe high score is saved locally. Keep {entry}'s filename the same between builds;\nit names the saved data. Use a distinct source filename before publishing.\nRun `dewy-core test {entry}` for the two simulation tests. Its Game value includes\nits random generator, so saved states replay the same input identically.\n"
    if kind == "platformer":
        readme += "\nMove with arrows/A/D or a gamepad. Jump with Space/W/up or gamepad A; hold down\nto drop through a platform. Collect every coin. Edit LEVEL to change the map,\nRUN/JUMP/GRAVITY to tune movement, and tick to change the player rules.\nThe tile art and sounds are generated in the source; no assets are required.\nRun `dewy-core test main.dewy` for the included movement and coin tests.\n"
    if kind == "3d":
        readme += "\nClick to capture the mouse; WASD walks, Space jumps, and left click shoots.\nEscape releases the mouse. Gamepads use the sticks, A, and RB/right trigger.\nFind every glowing orb; shots push crates and are blocked by walls. After winning,\nR or gamepad Start resets the yard. Edit start to place crates and orbs.\nRun `dewy-core test main.dewy` to check shot selection without opening a window.\n"
    if kind == "online":
        readme += "\n## Play together\n\nPractice plays locally. Invite a friend shares a code; the friend pastes it into\nJoin a friend and sends the displayed reply back. Set WEB_PAGE in {entry} to\nyour hosted web build so native invitations can share a browser link.\n\nFor short room codes with no reply to copy, configure MATCH_SERVER in the source\nor run `DEWY_MATCH_SERVER=ws://your-server:7700 ./main`. Browser pages accept\n`?server=ws://your-server:7700`; HTTPS pages need a wss:// service. The Dewy\nrepository includes tools/sloppy_core/rendezvous.jo and setup instructions in\nexamples/sloppy_core/README.md. No public server is configured by default.\n\nKeep {entry}'s filename the same in native and web builds: it is PROGRAM_NAME,\nwhich scopes saved data and room names. Choose a distinct name before publishing.\nThe tick function consumes ordinary Game and Pad values; rollback replays it,\nso keep clocks, live input and unseeded randomness outside it.\n"
    make_dirs(dir)
    if not write_file("{dir}/{entry}", src) or not write_file("{dir}/README.md", readme) or not write_file("{dir}/.gitignore", "/main\n/main.exe\n/main.html\n/main.zip\n"):
        eprint("dewy-core: cannot write the project in {dir}")
        exit(1)
    print("Created {dir}/{entry}. See {dir}/README.md to run, check and build it.")

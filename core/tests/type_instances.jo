# Exercise type canonicalization across later inference-variable bindings.
use '../compiler/types.jo'
use '../compiler/ast.jo'
use '../compiler/util.jo'
main = () -> int:
    init_types()
    probe_decl = mk(.struct_, 0)
    nodes[probe_decl].name = i32(intern("Probe"))
    probe_var = mk_var()
    probe_early = get_struct_inst(probe_decl, [mk_array(probe_var)])
    probe_fixed = get_struct_inst(probe_decl, [mk_array(T_INT)])
    if probe_early == probe_fixed: return 1
    if not unify(probe_var, T_INT): return 2
    if get_struct_inst(probe_decl, [mk_array(T_INT)]) != probe_fixed or zonk(probe_early) != probe_fixed: return 3
    probe_later_var = mk_var()
    probe_later = get_struct_inst(probe_decl, [mk_array(probe_later_var)])
    probe_text = get_struct_inst(probe_decl, [mk_array(T_STR)])
    if not unify(probe_later_var, T_STR): return 4
    if get_struct_inst(probe_decl, [mk_array(T_STR)]) != probe_text or zonk(probe_later) != probe_text: return 5
    if not type_eq(probe_later, probe_text): return 6
    if get_struct_inst(probe_decl, [T_INT, T_STR]) == get_struct_inst(probe_decl, [T_STR, T_INT]): return 7
    # A later inference instance must not replace an earlier concrete one.
    probe_second_decl = mk(.struct_, 0)
    nodes[probe_second_decl].name = i32(intern("Second"))
    probe_first_fixed = get_struct_inst(probe_second_decl, [T_INT])
    probe_last_var = mk_var()
    get_struct_inst(probe_second_decl, [probe_last_var])
    if not unify(probe_last_var, T_INT): return 8
    if get_struct_inst(probe_second_decl, [T_INT]) != probe_first_fixed: return 9
    if get_struct_inst(probe_decl, [T_INT]) == probe_first_fixed: return 10
    # Even an already-bound variable is not a canonical argument ID.
    probe_bound_decl = mk(.struct_, 0)
    nodes[probe_bound_decl].name = i32(intern("Bound"))
    probe_bound_var = mk_var()
    if not unify(probe_bound_var, T_STR): return 11
    probe_bound = get_struct_inst(probe_bound_decl, [probe_bound_var])
    probe_resolved = zonk(probe_bound)
    if has_var(probe_resolved) or probe_resolved != get_struct_inst(probe_bound_decl, [T_STR]): return 12
    if not type_eq(probe_bound, probe_resolved): return 13
    # Unions of different cardinality are unequal even while a member is open.
    union_var = mk_var()
    union_array = mk_array(union_var)
    union_small = mk_union([T_BOOL, union_array])
    union_extra = get_struct_inst(probe_decl, [T_BOOL])
    union_large = mk_union([T_BOOL, union_array, union_extra])
    if type_eq(union_small, union_large) or type_eq(union_large, union_small): return 14
    union_fixed = mk_union([T_BOOL, mk_array(T_INT)])
    if not unify(union_var, T_INT): return 15
    union_resolved = zonk(union_small)
    if has_var(union_resolved) or union_resolved != union_fixed: return 16
    if mk_union([mk_array(T_INT), T_BOOL, T_BOOL]) != union_fixed: return 17
    if not type_eq(union_small, union_resolved): return 18
    # A raw bound variable nested in an array still needs canonicalization.
    union_later_var = mk_var()
    if not unify(union_later_var, T_STR): return 19
    union_later = mk_union([T_BOOL, mk_array(union_later_var)])
    if zonk(union_later) != mk_union([T_BOOL, mk_array(T_STR)]): return 20
    # Concrete subsets cannot unify with a larger union. An open type member
    # can still infer several remaining alternatives through unify_unions.
    union_pair = mk_union([T_BOOL, T_INT])
    union_triple = mk_union([T_BOOL, T_INT, T_STR])
    if unify(union_pair, union_triple) or unify(union_triple, union_pair): return 21
    union_rest = mk_var()
    if not unify(mk_union([T_BOOL, union_rest]), union_triple): return 22
    if prune(union_rest) != mk_union([T_INT, T_STR]): return 23
    print("ok")
    0

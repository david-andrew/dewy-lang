# Exercise stable record lookup across later inference-variable bindings.
use '../compiler/types.jo'
use '../compiler/ast.jo'
use '../compiler/util.jo'
main = () -> int:
    init_types()
    probe_decl = mk(.struct_, 0)
    nodes[probe_decl].name = i32(intern("Probe"))
    probe_var = mk_var()
    probe_early = get_struct_inst(probe_decl, [mk_array(probe_var)])
    probe_fixed = get_struct_inst(probe_decl, [mk_array(T_INT)])
    if probe_early == probe_fixed: return 1
    if not unify(probe_var, T_INT): return 2
    if get_struct_inst(probe_decl, [mk_array(T_INT)]) != probe_early: return 3
    probe_later_var = mk_var()
    probe_later = get_struct_inst(probe_decl, [mk_array(probe_later_var)])
    probe_text = get_struct_inst(probe_decl, [mk_array(T_STR)])
    if not unify(probe_later_var, T_STR): return 4
    if get_struct_inst(probe_decl, [mk_array(T_STR)]) != probe_later: return 5
    if not type_eq(probe_later, probe_text): return 6
    if get_struct_inst(probe_decl, [T_INT, T_STR]) == get_struct_inst(probe_decl, [T_STR, T_INT]): return 7
    # A later inference instance must not replace an earlier concrete one.
    probe_second_decl = mk(.struct_, 0)
    nodes[probe_second_decl].name = i32(intern("Second"))
    probe_first_fixed = get_struct_inst(probe_second_decl, [T_INT])
    probe_last_var = mk_var()
    get_struct_inst(probe_second_decl, [probe_last_var])
    if not unify(probe_last_var, T_INT): return 8
    if get_struct_inst(probe_second_decl, [T_INT]) != probe_first_fixed: return 9
    if get_struct_inst(probe_decl, [T_INT]) == probe_first_fixed: return 10
    print("ok")
    0

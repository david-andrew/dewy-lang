# requires: sloppy
# type unions: A | B values, `is` tests, narrowing, aliases, match on member types
struct ParseError:
    msg: str
    at: int

type Result[T, E] = T | E
type Num = int | f64

parse_int = (s: str) -> int | ParseError:
    if len(s) == 0: return ParseError("empty", 0)
    n = 0
    loop i in 0.. and c in bytes(s):
        if c < '0' or c > '9': return ParseError("not a digit", i)
        n = n * 10 + int(c - '0')
    n

twice = (s: str) -> Result[int, ParseError]:
    r = parse_int(s)
    if r is ParseError: return r
    r * 2            # r is an int here

describe = (v: int | str | f64) -> str:
    if v is int: return "int {v + 1}"
    if v is str: return "str of length {len(v)}"
    "something else"

demo1 = ():
    loop s in ["42", "", "4x2"]:
        r = parse_int(s)
        if r is int: print("ok", r + 1)
        else: print("error:", r.msg, "at", r.at)
    t = twice("21")
    if t is int: print(t)
    print(describe(5), describe("hey"), describe(2.5))
    x: Num = 3
    print(x is int, x is f64)
    x = 2.5
    print(x is int, x is f64)
    o: int? = none
    print(o is none, o is int)
    o = 7
    if o is int: print(o + 1)
    w: int | none = 5
    print(w is int)
    v: int | str = "s"
    print(v is str and len(v) == 1)

struct Box:
    v: int | str

type Shape = Circle | Rect

area2 = (s: Shape) -> f64:
    if s is Circle: return 3.0 * s.r * s.r
    if s is Rect: return s.w * s.h
    0.0

demo2 = ():
    xs: (int | str)[] = [1, "two", 3]
    xs.push("four")
    print(xs)
    print(xs[1], xs[0] == xs[0], xs[0] == xs[2])
    b = Box("hello")
    print(b)
    b.v = 5
    print(b, b.v is int)
    shapes: Shape[] = [Circle(1.0), Rect(2.0, 3.0)]
    total = 0.0
    loop s in shapes: total += area2(s)
    print(total)
    names: str[]
    loop x in xs:
        if x is str: names.push(x + "!")
    print(names)
    m: {str: int | str} = {}
    m["a"] = 1
    m["b"] = "bee"
    print(m["b"])
    xs = []
    names = []
    m = {}
    shapes = []
    b = Box(0)

struct Circle:
    r: f64
struct Rect:
    w: f64
    h: f64

area = (s: Shape) -> f64:
    match s:
        Circle: 3.0 * s.r * s.r
        Rect: s.w * s.h

show = (v: int | str | bool) -> str:
    match v:
        int: "int {v * 2}"
        str: "str {v}!"
        bool: "bool"

classify = (v: int | str) -> str:
    if v is int and v > 10: return "big"
    if v is str or v < 0: return "str or negative"
    "small"

demo3 = ():
    print(area(Circle(2.0)), area(Rect(2.0, 5.0)))
    print(show(21), show("hi"), show(true))
    print(classify(50), classify(3), classify(-4), classify("x"))
    u: int | str = 3
    u = "now a string"
    if u is str: print(len(u))
    p: Shape = Rect(1.0, 2.0)
    print(p, p == p)

next_val = (i: int) -> int | str:
    if i % 3 == 2: return "stop"
    i * 10

demo4 = ():
    r = next_val(0)
    if r is str: return
    print(r + 1)                 # r: int
    r = 7                        # still an int: stays narrowed
    print(r + 1)
    r = next_val(2)              # may be a str: r is int | str again
    print(r)
    i = 0
    loop:
        r = next_val(i)
        if r is str: break
        print("got", r * 2)
        i += 1
    print(r, r is str)

# three members: ruling one out leaves a smaller union; widening to a bigger union
struct Big:
    v: int
    tag: str
type Val = int | str | Big

weigh = (x: Val) -> int:
    if x is str: return len(x) * 10
    if x is Big: return x.v + len(x.tag)        # x: int | Big before this test
    x + 1000                                    # x: int

show3 = (x: int | str | f64) -> str: "<{x}>"

demo5 = ():
    vals: Val[] = [3, "four", Big(5, "five")]
    loop x in vals:
        print(weigh(x))
        if x is int: print("int", x + 1)
        else if x is str: print("str", x + "!")
        else: print("big", x.tag)               # neither int nor str
        match x:
            int, str: print("simple", x)        # x: int | str
            _: print("other", x.v)              # x: Big
        if x is str: continue
        y: int | Big = x                        # (int | Big fits)
        print(y)
    small: int | str = "s"
    print(show3(small))                         # int | str widens to int | str | f64
    small = 2
    wide: int | str | f64 = small
    print(wide, show3(wide))
    w: Val = 1
    if w is str: return
    w = "reassigned"                            # the whole union again
    print(w, weigh(w))

# fields narrow like variables
struct Slot:
    item: int | str | Big
    count: int?

describe = (self: Slot) -> str:
    if self.item is Big: return "big {self.item.tag}"
    if self.item is int: return "number {self.item + 1}"
    "text {self.item} ({len(self.item)})"

bump = (self: mut Slot):
    if self.count is int: self.count = self.count + 1
    else: self.count = 1

# a type parameter inside a union stands for the members the union does not name
value_or[T] = (r: T | Big, d: T) -> T:
    if r is Big: return d
    r
is_big[T] = (r: T | Big) -> bool: r is Big

demo6 = ():
    slots = [Slot(3, 2), Slot("abc", none), Slot(Big(1, "b"), 1)]
    loop s in slots: print(describe(s))
    s = slots[0]
    if s.item is int and s.count is int: print(s.item * s.count)
    s.item = "text"                             # s.item is a str from here on
    print(len(s.item))
    if s.count is int:
        bump(s)                                 # (may change s.count: no longer known)
        print(s.count)
    v: int | str | Big = "x"
    print(value_or(v, 5), value_or(Big(2, "two"), 7), is_big(2.5), is_big(Big(0, "")))

main = ():
    demo1()
    demo2()
    demo3()
    demo4()
    demo5()
    demo6()

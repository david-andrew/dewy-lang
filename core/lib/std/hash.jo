# SHA-256: a file's or a text's fingerprint, as 64 hex digits (the same as `sha256sum` prints).
# Two different contents practically never have the same one: to check a download, or to know
# whether a file changed since it was last built.

__SHA_K = [0x428a2f98, 0x71374491, 0xb5c0fbcf, 0xe9b5dba5, 0x3956c25b, 0x59f111f1, 0x923f82a4, 0xab1c5ed5,
    0xd807aa98, 0x12835b01, 0x243185be, 0x550c7dc3, 0x72be5d74, 0x80deb1fe, 0x9bdc06a7, 0xc19bf174,
    0xe49b69c1, 0xefbe4786, 0x0fc19dc6, 0x240ca1cc, 0x2de92c6f, 0x4a7484aa, 0x5cb0a9dc, 0x76f988da,
    0x983e5152, 0xa831c66d, 0xb00327c8, 0xbf597fc7, 0xc6e00bf3, 0xd5a79147, 0x06ca6351, 0x14292967,
    0x27b70a85, 0x2e1b2138, 0x4d2c6dfc, 0x53380d13, 0x650a7354, 0x766a0abb, 0x81c2c92e, 0x92722c85,
    0xa2bfe8a1, 0xa81a664b, 0xc24b8b70, 0xc76c51a3, 0xd192e819, 0xd6990624, 0xf40e3585, 0x106aa070,
    0x19a4c116, 0x1e376c08, 0x2748774c, 0x34b0bcb5, 0x391c0cb3, 0x4ed8aa4a, 0x5b9cca4f, 0x682e6ff3,
    0x748f82ee, 0x78a5636f, 0x84c87814, 0x8cc70208, 0x90befffa, 0xa4506ceb, 0xbef9a3f7, 0xc67178f2]

__rotr32 = (x: int, n: int) -> int: ((x >> n) | (x << (32 - n))) & 0xFFFFFFFF

# the SHA-256 of these bytes, as 64 lowercase hex digits
sha256 = (b: u8[]) -> str:
    h = [0x6a09e667, 0xbb67ae85, 0x3c6ef372, 0xa54ff53a, 0x510e527f, 0x9b05688c, 0x1f83d9ab, 0x5be0cd19]
    w = fill(0, 64)
    whole = b.len() / 64 * 64
    p = 0
    loop p < whole:
        __sha_block(h, w, b, p)
        p += 64
    # (the rest, a 1 bit, zeros, and the length in bits: one or two blocks more)
    m: u8[]
    loop i in [whole..b.len()): m.push(b[i])
    m.push(0x80)
    loop m.len() % 64 != 56: m.push(0)
    bits = b.len() * 8
    loop k in [0..8): m.push(u8((bits >> (56 - 8 * k)) & 255))
    p = 0
    loop p < m.len():
        __sha_block(h, w, m, p)
        p += 64
    out = ""
    loop v in h: out = out + "{v:08x}"
    out

__sha_block = (h: mut int[], w: mut int[], m: u8[], p: int):
    loop t in [0..16):
        q = p + 4 * t
        w[t] = (int(m[q]) << 24) | (int(m[q + 1]) << 16) | (int(m[q + 2]) << 8) | int(m[q + 3])
    loop t in [16..64):
        x = w[t - 15]
        y = w[t - 2]
        s0 = __rotr32(x, 7) xor __rotr32(x, 18) xor (x >> 3)
        s1 = __rotr32(y, 17) xor __rotr32(y, 19) xor (y >> 10)
        w[t] = (w[t - 16] + s0 + w[t - 7] + s1) & 0xFFFFFFFF
    a = h[0]
    b = h[1]
    c = h[2]
    d = h[3]
    e = h[4]
    f = h[5]
    g = h[6]
    hh = h[7]
    loop t in [0..64):
        s1 = __rotr32(e, 6) xor __rotr32(e, 11) xor __rotr32(e, 25)
        ch = (e & f) xor ((e xor 0xFFFFFFFF) & g)
        t1 = (hh + s1 + ch + __SHA_K[t] + w[t]) & 0xFFFFFFFF
        s0 = __rotr32(a, 2) xor __rotr32(a, 13) xor __rotr32(a, 22)
        mj = (a & b) xor (a & c) xor (b & c)
        t2 = (s0 + mj) & 0xFFFFFFFF
        hh = g
        g = f
        f = e
        e = (d + t1) & 0xFFFFFFFF
        d = c
        c = b
        b = a
        a = (t1 + t2) & 0xFFFFFFFF
    h[0] = (h[0] + a) & 0xFFFFFFFF
    h[1] = (h[1] + b) & 0xFFFFFFFF
    h[2] = (h[2] + c) & 0xFFFFFFFF
    h[3] = (h[3] + d) & 0xFFFFFFFF
    h[4] = (h[4] + e) & 0xFFFFFFFF
    h[5] = (h[5] + f) & 0xFFFFFFFF
    h[6] = (h[6] + g) & 0xFFFFFFFF
    h[7] = (h[7] + hh) & 0xFFFFFFFF

# the SHA-256 of a text's UTF-8 bytes: sha256("abc") is ba7816bf...
sha256 = (s: str) -> str: sha256(bytes(s))

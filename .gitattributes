# Test data is compared byte for byte: never convert line endings (some cases contain CR on purpose).
tests/** -text
*.out -text
*.err -text
# Historical notes keep their own line endings.
resources/** -text
# Shell scripts run under bash everywhere.
*.sh text eol=lf
# License texts ship byte-identical on every platform
LICENSE text eol=lf
editors/vscode/LICENSE text eol=lf
TRADEMARKS.md text eol=lf
lib/std/unicode/LICENSE.txt text eol=lf
lib/game/assets/OFL.txt text eol=lf

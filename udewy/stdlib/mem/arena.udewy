# Stable, process-lifetime chunks. Growing an arena never moves prior
# allocations: parser tokens, strings and backend tables retain their pointers.
const ARENA_SIZE:int = 0x1000000
let g_arena:int = 0
let g_arena_ptr:int = 0
let g_arena_remaining:int = 0

let arena_chunk = (size:int):>void => {
    let ptr:int = host_mmap_rw(size)
    if ptr <=? 0 { host_exit(1) }
    g_arena = ptr
    g_arena_ptr = ptr
    g_arena_remaining = size
    return void
}
let arena_init = ():>void => {
    arena_chunk(ARENA_SIZE)
    return void
}
let arena_alloc = (size:int):>int => {
    # Reserve word alignment and reject arithmetic overflow before mapping.
    if size <? 0 or size >? 9223372036854775800 { host_exit(1) }
    let aligned:int = (size + 7) and (-8)
    if aligned >? g_arena_remaining {
        let capacity:int = ARENA_SIZE
        if aligned >? capacity { capacity = aligned }
        arena_chunk(capacity)
    }
    let ptr:int = g_arena_ptr
    g_arena_ptr = g_arena_ptr + aligned
    g_arena_remaining = g_arena_remaining - aligned
    return ptr
}

let str_to_cstr = (s:int):>int => {
    let slen:int = str_len(s)
    let buf:int = arena_alloc(slen + 1)
    copy_bytes(buf s slen)
    __store_u8__(CH_NUL buf + slen)
    return buf
}

{
  "name": "udewy",
  "displayName": "udewy",
  "description": "Syntax highlighting for the udewy programming language",
  "version": "0.1.15",
  "publisher": "RedFoxLabs",
  "engines": {
    "vscode": "^1.75.0"
  },
  "categories": [
    "Programming Languages"
  ],
  "icon": "images/udewy_logo_128x128.png",
  "files": [
    "language-configuration.json",
    "syntaxes/udewy.tmLanguage.json",
    "images/udewy_logo_128x128.png",
    "images/udewy-file.png",
    "README.md",
    "LICENSE"
  ],
  "contributes": {
    "languages": [
      {
        "id": "udewy",
        "aliases": [
          "udewy"
        ],
        "extensions": [
          ".udewy"
        ],
        "icon": {
          "light": "./images/udewy-file.png",
          "dark": "./images/udewy-file.png"
        },
        "configuration": "./language-configuration.json"
      }
    ],
    "grammars": [
      {
        "language": "udewy",
        "scopeName": "source.udewy",
        "path": "./syntaxes/udewy.tmLanguage.json",
        "unbalancedBracketScopes": [
          "meta.type-declaration.udewy",
          "meta.bracketed-type.udewy",
          "meta.type-parameter.udewy"
        ]
      }
    ]
  },
  "license": "GPL-3.0",
  "repository": {
    "type": "git",
    "url": "https://github.com/david-andrew/dewy-lang"
  }
}

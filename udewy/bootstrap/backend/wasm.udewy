    else if str_eq(name "__audio_init__") { w_emit_host_call(name "$__host_audio_init__") }
    else if str_eq(name "__audio_play__") { w_emit_host_call(name "$__host_audio_play__") }
    else if str_eq(name "__audio_sample_rate__") { w_emit_host_call(name "$__host_audio_sample_rate__") }
    else if str_eq(name "__audio_stream_init__") { w_emit_host_call(name "$__host_audio_stream_init__") }
    else if str_eq(name "__audio_stream_write__") { w_emit_host_call(name "$__host_audio_stream_write__") }
    else if str_eq(name "__audio_stream_needs_samples__") { w_emit_host_call(name "$__host_audio_stream_needs_samples__") }
    else if str_eq(name "__webgl_init__") { w_emit_host_call(name "$__host_webgl_init__") }
    else if str_eq(name "__webgl_uniform1i__") { w_emit_host_call(name "$__host_webgl_uniform1i__") }
    else if str_eq(name "__webgl_uniform2i__") { w_emit_host_call(name "$__host_webgl_uniform2i__") }
    else if str_eq(name "__webgl_uniform1iv__") { w_emit_host_call(name "$__host_webgl_uniform1iv__") }
    else if str_eq(name "__webgl_uniform2iv__") { w_emit_host_call(name "$__host_webgl_uniform2iv__") }
    else if str_eq(name "__webgl_render__") { w_emit_host_call(name "$__host_webgl_render__") }
    else if str_eq(name "__gpu_init__") { w_emit_host_call(name "$__host_gpu_init__") }
    else if str_eq(name "__gpu_set_viewport__") { w_emit_host_call(name "$__host_gpu_set_viewport__") }
    else if str_eq(name "__gpu_clear__") { w_emit_host_call(name "$__host_gpu_clear__") }
    else if str_eq(name "__gpu_set_perspective_frustum__") { w_emit_host_call(name "$__host_gpu_set_perspective_frustum__") }
    else if str_eq(name "__gpu_set_view_matrix__") { w_emit_host_call(name "$__host_gpu_set_view_matrix__") }
    else if str_eq(name "__gpu_set_texture__") { w_emit_host_call(name "$__host_gpu_set_texture__") }

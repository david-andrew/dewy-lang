    else if str_eq(name "__gpu_set_depth_write__") { w_emit_host_call(name "$__host_gpu_set_depth_write__") }
    else if str_eq(name "__gpu_set_line_width__") { w_emit_host_call(name "$__host_gpu_set_line_width__") }
    else if str_eq(name "__gpu_submit__") { w_emit_host_call(name "$__host_gpu_submit__") }
    else if str_eq(name "__gpu_overlay_begin__") { w_emit_host_call(name "$__host_gpu_overlay_begin__") }
    else if str_eq(name "__gpu_overlay_end__") { w_emit_host_call(name "$__host_gpu_overlay_end__") }
    else if str_eq(name "__gpu_create_texture__") { w_emit_host_call(name "$__host_gpu_create_texture__") }
    else if str_eq(name "__gpu_present__") { w_emit_host_call(name "$__host_gpu_present__") }
    else if str_eq(name "__gpu_window_width__") { w_emit_host_call(name "$__host_gpu_window_width__") }
    else if str_eq(name "__gpu_window_height__") { w_emit_host_call(name "$__host_gpu_window_height__") }
    else if str_eq(name "__audio_queue_init__") { w_emit_host_call(name "$__host_audio_queue_init__") }
    else if str_eq(name "__audio_queue_push__") { w_emit_host_call(name "$__host_audio_queue_push__") }
    else if str_eq(name "__audio_queue_size__") { w_emit_host_call(name "$__host_audio_queue_size__") }
    return void
}

let w_get_builtin_constants = ():>int => { return map_new() }

# --- Finish module: render WAT ---

let w_emit_data_segment = (out:int offset:int data_str:int):>void => {
    bb_push_str(out "  (data (i32.const ")
    bb_push_int(out offset)
    bb_push_str(out ") \"")
    let n:int = str_len(data_str)
    let i:int = 0
    loop i <? n {
        let b:int = __load_u8__(data_str + i)
        bb_push_byte(out 92)
        let hi:int = (b >> 4) and 15
        let lo:int = b and 15
        let h:int = hi + 48
        if hi >=? 10 { h = hi + 87 }
        bb_push_byte(out h)
        let l:int = lo + 48
        if lo >=? 10 { l = lo + 87 }
        bb_push_byte(out l)
        i = i + 1
    }
    bb_push_str(out "\")\n")
    return void
}

let w_finish_module = ():>int => {
    let out:int = bb_new(8192)
    bb_push_str(out "(module\n")

    # Function types for indirect calls. Emitted BEFORE imports so the
    # implicit type entries created by inline import signatures don't
    # collide with our named $type_fnN entries.
    # w_indirect_arities is an intset (intmap-backed), slot size 24.
    let cap_ia:int = intmap_cap(w_indirect_arities)
    let slots_ia:int = intmap_slots(w_indirect_arities)
    let arities:int = vec_new(8)
    let k:int = 0
    loop k <? cap_ia {
        let slot:int = slots_ia + (k * 24)
        if __load__(slot) =? 1 {
            vec_push(arities __load__(slot + 8))
        }
        k = k + 1
    }
    # Sort.
    let m:int = vec_len(arities)
    let a:int = 1
    loop a <? m {
        let cur:int = vec_get(arities a)
        let b:int = a - 1
        loop b >=? 0 {
            if vec_get(arities b) <=? cur { break }
            vec_set(arities b + 1 vec_get(arities b))
            b = b - 1
        }
        vec_set(arities b + 1 cur)
        a = a + 1
    }
    let ai:int = 0
    loop ai <? m {
        let arity:int = vec_get(arities ai)
        bb_push_str(out "  (type $type_fn")
        bb_push_int(out arity)
        bb_push_str(out " (func")
        let pi:int = 0
        loop pi <? arity {
            bb_push_str(out " (param i64)")
            pi = pi + 1
        }
        bb_push_str(out " (result i64)))\n")
        ai = ai + 1
    }

    let page_size:int = 65536
    # The stack grows down from above all data: 2 MiB, or 1 MiB past the
    # data when that is higher (a large static reservation must not meet the
    # stack). wasm.py computes the same.
    let stack_top:int = ((w_data_offset + 15) // 16) * 16 + 1048576
    if stack_top <? 2097152 { stack_top = 2097152 }
    let mem_required:int = w_data_offset + (2 * page_size)
    if mem_required <? stack_top { mem_required = stack_top }
    let mem_pages:int = (mem_required + page_size - 1) // page_size
    if mem_pages <? 32 { mem_pages = 32 }
    bb_push_str(out "  (import \"env\" \"memory\" (memory ")
    bb_push_int(out mem_pages)
    bb_push_str(out "))\n")

    let imp_n:int = vec_len(w_imports)
    let imp_i:int = 0
    loop imp_i <? imp_n {
        bb_push_str(out "  ")
        bb_push_str(out vec_get(w_imports imp_i))
        bb_push_byte(out 10)
        imp_i = imp_i + 1
    }

    bb_push_str(out "  (global $stack_ptr (mut i32) (i32.const ")
    bb_push_int(out stack_top)
    bb_push_str(out "))\n")
    if w_module_init_name not=? 0 {
        bb_push_str(out "  (global $__udewy_module_init_done (mut i32) (i32.const 0))\n")
    }

    let table_n:int = vec_len(w_function_ids)
    if table_n >? 0 {
        bb_push_str(out "  (table $__udewy_fn_table ")
        bb_push_int(out table_n)
        bb_push_str(out " funcref)\n")
    }

    # Emit functions.
    let fi:int = 0
    loop fi <? table_n {
        let lid:int = vec_get(w_function_ids fi)
        let fn_name:int = intmap_get(w_fn_labels lid)
        let pc:int = intmap_get(w_fn_param_counts lid)
        if w_have_reachable and (not intset_has(w_reachable lid)) {
            # Stub reachable-but-unused: keep table layout intact.
            bb_push_str(out "  (func ")
            bb_push_str(out fn_name)
            let pi:int = 0
            loop pi <? pc {
                bb_push_str(out " (param i64)")
                pi = pi + 1
            }
            bb_push_str(out " (result i64) i64.const 0)\n")
        } else if intset_has(w_defined_label_ids lid) {
            bb_push_str(out "  (func ")
            bb_push_str(out fn_name)
            let pi2:int = 0
            loop pi2 <? pc {
                bb_push_str(out " (param $p")
                bb_push_int(out pi2)
                bb_push_str(out " i64)")
                pi2 = pi2 + 1
            }
            bb_push_str(out " (result i64)\n")
            # Standard locals.
            bb_push_str(out "    (local $swap0 i64)\n")
            bb_push_str(out "    (local $swap1 i32)\n")
            bb_push_str(out "    (local $div_lhs i64)\n")
            bb_push_str(out "    (local $div_rhs i64)\n")
            bb_push_str(out "    (local $sc_tmp i64)\n")
            bb_push_str(out "    (local $stack_base i32)\n")
            bb_push_str(out "    (local $alloc_size i32)\n")
            bb_push_str(out "    (local $alloc_ptr i32)\n")
            # Function-specific extra locals.
            let lines:int = intmap_get(w_function_codes lid)
            # We don't separately track them; the alloc_local pushes decls into
            # current_locals_extra at the time. But we discarded that on
            # end_function. We need to keep them per-function. Store them in
            # the line vec at the front using a marker.
            # For simplicity, scan lines for "local.set $lN" / "local.get $lN"
            # and emit unique local decls.
            let seen:int = intset_new()
            let lc:int = vec_len(lines)
            let li:int = 0
            loop li <? lc {
                let line:int = vec_get(lines li)
                # Look for "$l" followed by digits.
                let len:int = str_len(line)
                let j:int = 0
                loop j <? len - 2 {
                    if (__load_u8__(line + j) =? 36) and (__load_u8__(line + j + 1) =? 108) {
                        let c:int = __load_u8__(line + j + 2)
                        if (c >=? 48) and (c <=? 57) {
                            let id_start:int = j + 2
                            let id_end:int = id_start
                            loop id_end <? len {
                                let cc:int = __load_u8__(line + id_end)
                                if (cc <? 48) or (cc >? 57) { break }
                                id_end = id_end + 1
                            }
                            let slot:int = w_parse_int(line id_start id_end)
                            if not intset_has(seen slot) {
                                intset_add(seen slot)
                                bb_push_str(out "    (local $l")
                                bb_push_int(out slot)
                                bb_push_str(out " i64)\n")
                            }
                        }
                    }
                    j = j + 1
                }
                li = li + 1
            }
            # Emit body lines.
            let li2:int = 0
            loop li2 <? lc {
                bb_push_str(out vec_get(lines li2))
                bb_push_byte(out 10)
                li2 = li2 + 1
            }
            bb_push_str(out "  )\n")
        } else {
            # Extern function: imported (already in imports).
        }
        fi = fi + 1
    }

    # main wrapper.
    bb_push_str(out "  (func $main (result i64)\n")
    if w_module_init_name not=? 0 {
        bb_push_str(out "    global.get $__udewy_module_init_done\n")
        bb_push_str(out "    if\n")
        bb_push_str(out "    else\n")
        bb_push_str(out "      i32.const 1\n")
        bb_push_str(out "      global.set $__udewy_module_init_done\n")
        bb_push_str(out "      call $")
        bb_push_str(out w_module_init_name)
        bb_push_byte(out 10)
        bb_push_str(out "      drop\n")
        bb_push_str(out "    end\n")
    }
    # Find the user main label_id (if any) to know its arity.
    let main_arity:int = 0
    let mi:int = 0
    loop mi <? table_n {
        let lid_m:int = vec_get(w_function_ids mi)
        if str_eq(intmap_get(w_fn_labels lid_m) w_user_main_name) {
            main_arity = intmap_get(w_fn_param_counts lid_m)
            break
        }
        mi = mi + 1
    }
    let pa:int = 0
    loop pa <? main_arity {
        bb_push_str(out "    i64.const 0\n")
        pa = pa + 1
    }
    bb_push_str(out "    call ")
    bb_push_str(out w_user_main_name)
    bb_push_byte(out 10)
    bb_push_str(out "  )\n")

    # Function table element.
    if table_n >? 0 {
        bb_push_str(out "  (elem (i32.const 0)")
        let ei:int = 0
        loop ei <? table_n {
            bb_push_byte(out 32)
            bb_push_str(out intmap_get(w_fn_labels vec_get(w_function_ids ei)))
            ei = ei + 1
        }
        bb_push_str(out ")\n")
    }

    # Data segments.
    let ds_n:int = vec_len(w_data_segments)
    let di:int = 0
    loop di <? ds_n {
        w_emit_data_segment(out vec_get(w_data_segments di) vec_get(w_data_segments di + 1))
        di = di + 2
    }

    bb_push_str(out "  (export \"main\" (func $main))\n")
    if table_n >? 0 {
        bb_push_str(out "  (export \"__udewy_fn_table\" (table $__udewy_fn_table))\n")
    }
    bb_push_str(out ")\n")
    return bb_finalize_as_string(out)
}

# The page every module runs in (../../backend/wasm_harness/README.md): the
# templates are the ones wasm.py reads, filled the same way.

# The values of the page being written, as `w_fill` substitutes them.
let w_page_pages:int = 0
let w_page_title:int = 0
let w_page_file:int = 0
let w_page_b64:int = 0
let w_page_linked:int = 0      # vec alternating name, base64 of each linked .wasm
let w_page_extra_js:int = 0    # vec of linked .js sources

let w_emit_extra_js = (out:int extra_js:int):>void => {
    if extra_js =? 0 { return void }
    let n:int = vec_len(extra_js)
    let i:int = 0
    loop i <? n {
        bb_push_str(out "\n")
        bb_push_str(out vec_get(extra_js i))
        i = i + 1
    }
    return void
}

let w_emit_linked_wasm_scripts = (out:int linked:int):>void => {
    if linked =? 0 { return void }
    let n:int = vec_len(linked)
    let i:int = 0
    loop i <? n {
        if i >? 0 { bb_push_str(out "\n") }
        bb_push_str(out "    <script data-wasm-artifact=\"")
        bb_push_str(out vec_get(linked i))
        bb_push_str(out "\" type=\"application/wasm-b64\">\n")
        bb_push_str(out vec_get(linked i + 1))
        bb_push_str(out "\n    </script>")
        i = i + 2
    }
    return void
}

# True if `@@` starts at `at`.
let w_marker_at = (template:int at:int n:int):>int => {
    if at + 1 >=? n { return false }
    return __load_u8__(template + at) =? 64 and __load_u8__(template + at + 1) =? 64
}

let w_named = (name:int len:int text:int):>int => {
    return str_eq_len(name len text str_len(text))
}

# Copy `template` to `out`, replacing each `@@NAME@@` by its value in one
# pass: a value is not searched for placeholders.
let w_fill = (out:int template:int):>void => {
    let n:int = str_len(template)
    let start:int = 0
    let i:int = 0
    loop i <? n {
        if w_marker_at(template i n) {
            let j:int = i + 2
            loop j <? n {
                if w_marker_at(template j n) { break }
                j = j + 1
            }
            if j >=? n {
                eprintl("error: unterminated placeholder in the wasm32 harness")
                host_exit(1)
            }
            bb_push_bytes(out template + start i - start)
            let name:int = template + i + 2
            let len:int = j - i - 2
            if w_named(name len "HOST_JS") {
                w_fill(out w_harness_host)
                w_emit_extra_js(out w_page_extra_js)
            } else if w_named(name len "MEMORY_PAGES") {
                bb_push_int(out w_page_pages)
            } else if w_named(name len "TITLE") {
                bb_push_str(out w_page_title)
            } else if w_named(name len "WASM_FILE") {
                bb_push_str(out w_page_file)
            } else if w_named(name len "WASM_B64") {
                bb_push_str(out w_page_b64)
            } else if w_named(name len "LINKED_WASM") {
                w_emit_linked_wasm_scripts(out w_page_linked)
            } else {
                eprintl("error: unknown placeholder in the wasm32 harness")
                host_exit(1)
            }
            i = j + 2
            start = i
        } else {
            i = i + 1
        }
    }
    bb_push_bytes(out template + start n - start)
    return void
}

# Reading position for `w_leb`.
let w_read_at:int = 0

# The unsigned LEB128 number at `w_read_at` in `data`, moving past it.
let w_leb = (data:int):>int => {
    let result:int = 0
    let shift:int = 0
    loop true {
        let byte:int = __load_u8__(data + w_read_at)
        w_read_at = w_read_at + 1
        result = result or ((byte and 127) << shift)
        shift = shift + 7
        if byte <? 128 { return result }
    }
    return result
}

# The minimum page count of the memory a wasm module imports (1 when it
# imports none), read from its import section as wasm.py reads it.
let w_module_memory_pages = (data:int n:int):>int => {
    w_read_at = 8
    loop w_read_at <? n {
        let section:int = __load_u8__(data + w_read_at)
        w_read_at = w_read_at + 1
        let size:int = w_leb(data)
        let end:int = w_read_at + size
        if section =? 2 {
            let count:int = w_leb(data)
            let k:int = 0
            loop k <? count {
                let module_name:int = w_leb(data)
                w_read_at = w_read_at + module_name
                let field_name:int = w_leb(data)
                w_read_at = w_read_at + field_name
                let kind:int = __load_u8__(data + w_read_at)
                w_read_at = w_read_at + 1
                if kind =? 0 {
                    let type_index:int = w_leb(data)
                } else if kind =? 1 {
                    w_read_at = w_read_at + 1
                    let table_flags:int = w_leb(data)
                    let table_min:int = w_leb(data)
                    if table_flags and 1 { let table_max:int = w_leb(data) }
                } else if kind =? 2 {
                    let flags:int = w_leb(data)
                    return w_leb(data)
                } else {
                    w_read_at = w_read_at + 2
                }
                k = k + 1
            }
        }
        w_read_at = end
    }
    return 1
}

# --- compile_and_link / run ---

# True if str `s` ends with str `suffix`.
let w_str_ends_with = (s:int suffix:int):>int => {
    let sn:int = str_len(s)
    let xn:int = str_len(suffix)
    if xn >? sn { return false }
    return str_eq_len(s + sn - xn xn suffix xn)
}

# Build "<cache_dir>/<name><ext>" as a fresh length-prefixed string. `ext`
# may be empty.
let w_path_with = (cache_dir:int name:int ext:int):>int => {
    let bb:int = bb_new(str_len(cache_dir) + str_len(name) + str_len(ext) + 4)
    bb_push_str(bb cache_dir)
    bb_push_byte(bb 47)
    bb_push_str(bb name)
    bb_push_str(bb ext)
    return bb_finalize_as_string(bb)
}

let w_read_or_die = (path:int what:int):>int => {
    let data:int = fs_read_file(path_to_cstr(path))
    if data =? 0 {
        eprint("error: cannot read ")
        eprintl(what)
        host_exit(1)
    }
    return data
}

# Spawn xdg-open <url> without waiting. Mirrors python's _open_browser:
# detaches into a new session and redirects stdin/stdout/stderr to /dev/null
# so the launched browser's diagnostic chatter doesn't bleed into our shell.
# Falls back to PATH search for xdg-open (handles minimal /bin envs).
let w_open_browser = (url:int):>void => {
    let argv:int = vec_new(2)
    vec_push(argv w_str("xdg-open"))
    vec_push(argv url)
    let pid:int = host_fork()
    if pid <? 0 { return void }
    if pid =? 0 {
        host_setsid()
        let devnull:int = host_open(path_to_cstr("/dev/null") O_RDWR 0)
        if devnull >=? 0 {
            host_dup2(devnull STDIN)
            host_dup2(devnull STDOUT)
            host_dup2(devnull STDERR)
            if devnull >? 2 { host_close(devnull) }
        }
        let argv_table:int = proc_build_cstr_argv(argv)
        let envp:int = g_envp
        if envp =? 0 {
            envp = arena_alloc(8)
            __store__(0 envp)
        }
        let prog_cstr:int = path_to_cstr(vec_get(argv 0))
        host_execve(prog_cstr argv_table envp)
        proc_init_search_dirs()
        let j:int = 0
        loop j <? vec_len(proc_search_dirs) {
            let candidate:int = proc_join_cstr(vec_get(proc_search_dirs j) prog_cstr)
            host_execve(path_to_cstr(candidate) argv_table envp)
            j = j + 1
        }
        host_exit(127)
    }
    return void
}

let w_compile_and_link = (code:int input_name:int cache_dir:int options:int):>int => {
    fs_mkdir_p(cache_dir)

    let wat_path:int = w_path_with(cache_dir input_name ".wat")
    let wasm_path:int = w_path_with(cache_dir input_name ".wasm")

    # The direct path encodes the binary module in process instead of
    # running wat2wasm (the default; see be_direct_objects).
    if be_direct_objects() {
        let module:int = wb_assemble(code str_len(code))
        fs_write_file(path_to_cstr(wasm_path) bb_data(module) bb_len(module))
    } else {
        fs_write_file(path_to_cstr(wat_path) code str_len(code))
        let conv:int = vec_new(4)
        vec_push(conv w_str("wat2wasm"))
        vec_push(conv wat_path)
        vec_push(conv w_str("-o"))
        vec_push(conv wasm_path)
        proc_run_or_die(conv "wat2wasm failed (install wabt: https://github.com/WebAssembly/wabt)")
    }
    return w_wrap(wasm_path input_name cache_dir options)
}

# Write the page (../../backend/wasm_harness/) for the module at
# `wasm_path`: one HTML file with the module embedded, or in split mode a
# page that loads the module beside it. Returns the file to open or serve.
# A module another compiler built (the Dewy compiler's wasm32 emitter) comes
# here directly.
let w_wrap = (wasm_path:int input_name:int cache_dir:int options:int):>int => {
    fs_mkdir_p(cache_dir)
    let html_path:int = w_path_with(cache_dir input_name ".html")
    let served:int = w_path_with(cache_dir input_name ".wasm")
    let module:int = w_read_or_die(wasm_path wasm_path)
    let split_wasm:int = be_opt_split_wasm(options)
    if split_wasm and not str_eq(served wasm_path) {
        fs_write_file(path_to_cstr(served) module str_len(module))
    }
    let artifacts:int = be_opt_link_artifacts(options)

    # Walk link artifacts: classify into JS (appended to host JS), sidecar
    # .wasm (split mode -> copy next to HTML; embedded mode -> base64
    # alongside main module), and reject anything else.
    let extra_js:int = vec_new(2)
    let linked_pairs:int = vec_new(8)
    if artifacts not=? 0 {
        let ai:int = 0
        loop ai <? vec_len(artifacts) {
            let art:int = vec_get(artifacts ai)
            if w_str_ends_with(art ".js") {
                vec_push(extra_js w_read_or_die(art art))
            } else if w_str_ends_with(art ".wasm") {
                let basename:int = path_basename(art)
                let data:int = w_read_or_die(art art)
                if split_wasm {
                    let dst:int = w_path_with(cache_dir basename "")
                    fs_write_file(path_to_cstr(dst) data str_len(data))
                } else {
                    vec_push(linked_pairs basename)
                    vec_push(linked_pairs b64_encode(data str_len(data)))
                }
            } else {
                eprint("error: unsupported wasm32 link artifact: ")
                eprintl(art)
                host_exit(1)
            }
            ai = ai + 1
        }
    }

    w_page_pages = w_module_memory_pages(module str_len(module))
    w_page_title = input_name
    w_page_file = path_basename(served)
    w_page_linked = linked_pairs
    w_page_extra_js = extra_js
    let out:int = bb_new(262144)
    if split_wasm {
        w_fill(out w_harness_split)
    } else {
        w_page_b64 = b64_encode(module str_len(module))
        w_fill(out w_harness_embedded)
    }
    let html:int = bb_finalize_as_string(out)
    fs_write_file(path_to_cstr(html_path) html str_len(html))

    if split_wasm { return served }
    return html_path
}

# Derive the .html path from a compile_and_link return value (which may be
# the .wasm path in split mode).
let w_html_path_for = (output_path:int):>int => {
    if w_str_ends_with(output_path ".html") { return output_path }
    let dir:int = path_dirname(output_path)
    let stem:int = path_stem(output_path)
    return w_path_with(dir stem ".html")
}

# Resolve a path to absolute via getcwd if it's relative.
let w_resolve_abs = (p:int):>int => {
    if str_len(p) >? 0 {
        if __load_u8__(p) =? 47 { return p }    # '/'
    }
    let cwd_buf:int = host_mmap_rw(4096)
    let n:int = host_getcwd(cwd_buf 4096)
    if n <=? 0 { return p }
    let bb:int = bb_new(cstr_len(cwd_buf) + str_len(p) + 2)
    bb_push_cstr(bb cwd_buf)
    bb_push_str(bb "/")
    bb_push_str(bb p)
    return bb_finalize_as_string(bb)
}

# Build a `file://...` URL from a path. Path is resolved to absolute first
# because xdg-open / gio require an absolute path in the URI.
let w_to_file_uri = (p:int):>int => {
    let abs:int = w_resolve_abs(p)
    let bb:int = bb_new(str_len(abs) + 8)
    bb_push_str(bb "file://")
    bb_push_str(bb abs)
    return bb_finalize_as_string(bb)
}

# Serve the given HTML over a local HTTP server, open a browser at it, and
# wait until the browser tab closes (via heartbeat) or the user kills us.
let w_serve_html = (html_path:int):>void => {
    let cache_dir:int = path_dirname(html_path)
    let html_name:int = path_basename(html_path)

    let port:int = http_server_start(cache_dir html_name)
    if port <? 0 {
        eprint("error: failed to bind HTTP server (")
        let bb:int = bb_new(16)
        bb_push_int(bb port)
        eprint(bb_finalize_as_string(bb))
        eprintl(")")
        host_exit(1)
    }

    let url_bb:int = bb_new(64)
    bb_push_str(url_bb "http://127.0.0.1:")
    bb_push_int(url_bb port)
    bb_push_byte(url_bb 47)
    bb_push_str(url_bb html_name)
    let url:int = bb_finalize_as_string(url_bb)

    eprint("Serving ")
    eprint(html_path)
    eprint(" at ")
    eprintl(url)
    eprintl("The server exits when the tab closes")
    w_open_browser(url)

    http_server_serve(30000 15000)
    http_server_close()
    return void
}

let w_run = (output_path:int args:int options:int):>int => {
    let html_path:int = w_html_path_for(output_path)
    let split_wasm:int = be_opt_split_wasm(options)
    let serve_wasm:int = be_opt_serve_wasm(options)

    if split_wasm or serve_wasm {
        w_serve_html(html_path)
        return 0
    }

    eprint("Opening ")
    eprintl(html_path)
    let url:int = w_to_file_uri(html_path)
    w_open_browser(url)
    return 0
}

let w_get_compile_message = (output_path:int options:int):>int => {
    let split_wasm:int = be_opt_split_wasm(options)
    let cache_dir:int = path_dirname(output_path)
    let bb:int = bb_new(256)
    if split_wasm {
        let html_path:int = w_html_path_for(output_path)
        bb_push_str(bb "Split mode output:\n  WASM: ")
        bb_push_str(bb output_path)
        bb_push_str(bb "\n  HTML: ")
        bb_push_str(bb html_path)
        bb_push_str(bb "\nServe with: python -m http.server -d ")
        bb_push_str(bb cache_dir)
    } else {
        bb_push_str(bb "Compiled: ")
        bb_push_str(bb output_path)
        bb_push_str(bb "\n(single file with embedded WASM)\nOpen directly in a browser, or serve with: python -m http.server -d ")
        bb_push_str(bb cache_dir)
    }
    return bb_finalize_as_string(bb)
}
let w_install_backend = ():>void => {
    w_alloc_state()
    be_begin_module = w_begin_module
    be_finish_module = w_finish_module
    be_set_module_init = w_set_module_init
    be_set_imported_sources = be_default_set_imported_sources
    be_mark_location = be_default_mark_location
    be_note_local = be_default_note_local
    be_begin_scope = be_default_scope_hook
    be_end_scope = be_default_scope_hook
    be_intern_string = w_intern_string
    be_intern_words = w_intern_words
    be_define_global = w_define_global
    be_declare_extern_global = w_declare_extern_global
    be_intern_static = w_intern_static
    be_push_string_ref = w_push_string_ref
    be_push_global_ref = w_push_global_ref
    be_push_static_ref = w_push_static_ref
    be_load_global = w_load_global
    be_store_global = w_store_global
    be_function_ref = w_function_ref
    be_string_ref = w_string_ref
    be_static_ref = w_static_ref
    be_declare_function = w_declare_function
    be_bind_extern_function = w_bind_extern_function
    be_declare_extern_function = w_declare_extern_function
    be_should_warn_unused_extern = be_default_should_warn_unused_extern
    be_begin_function = w_begin_function
    be_end_function = w_end_function
    be_set_reachable_functions = w_set_reachable_functions
    be_load_param = w_load_param
    be_alloc_local = w_alloc_local
    be_load_local = w_load_local
    be_store_local = w_store_local
    be_push_const_i64 = w_push_const_i64
    be_push_void = w_push_void
    be_push_fn_ref = w_push_fn_ref
    be_pop_value = w_pop_value
    be_save_value = w_save_value
    be_restore_value = w_restore_value
    be_unary_op = w_unary_op
    be_binary_op = w_binary_op
    be_binary_immediate = be_default_binary_immediate
    be_begin_if = w_begin_if
    be_begin_else = w_begin_else
    be_end_if = w_end_if
    be_begin_loop = w_begin_loop
    be_begin_loop_body = w_begin_loop_body
    be_end_loop = w_end_loop
    be_emit_break = w_emit_break
    be_emit_continue = w_emit_continue
    be_cond_and_split = w_cond_and_split
    be_cond_and_join = w_cond_and_join
    be_cond_or_split = w_cond_or_split
    be_cond_or_join = w_cond_or_join
    be_emit_return = w_emit_return
    be_call_direct = w_call_direct
    be_call_indirect = w_call_indirect
    be_max_call_args = w_max_call_args
    be_is_intrinsic = w_is_intrinsic
    be_intrinsic_arity = w_intrinsic_arity
    be_intrinsic_static_arg_indices = w_intrinsic_static_arg_indices
    be_emit_intrinsic = w_emit_intrinsic
    be_get_builtin_constants = w_get_builtin_constants
    be_compile_and_link = w_compile_and_link
    be_run = w_run
    be_get_compile_message = w_get_compile_message
    return void
}

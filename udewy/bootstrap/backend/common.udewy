# Backend protocol -- function pointer globals populated by select_backend().
#
# Every Backend method in udewy/backend/common.py maps to a global function
# pointer here. Backends populate these pointers at startup via select_backend.
# The parser then calls through them with normal indirect call syntax.

import p"../runtime/runtime.udewy"
import p"../t1.udewy"

# ----------------------------------------------------------------------------
# Core intrinsic arities (mirrors backend.common.CORE_INTRINSIC_ARITIES)
# ----------------------------------------------------------------------------

let g_core_intrinsics:int = 0   # Map of name -> arity

let core_intrinsics_init = ():>void => {
    if g_core_intrinsics not=? 0 { return void }
    let m:int = map_new()
    map_put_str(m "__load_u8__" 1)
    map_put_str(m "__load_u16__" 1)
    map_put_str(m "__load_u32__" 1)
    map_put_str(m "__load_u64__" 1)
    map_put_str(m "__store_u8__" 2)
    map_put_str(m "__store_u16__" 2)
    map_put_str(m "__store_u32__" 2)
    map_put_str(m "__store_u64__" 2)
    map_put_str(m "__load_i8__" 1)
    map_put_str(m "__load_i16__" 1)
    map_put_str(m "__load_i32__" 1)
    map_put_str(m "__load_i64__" 1)
    map_put_str(m "__store_i8__" 2)
    map_put_str(m "__store_i16__" 2)
    map_put_str(m "__store_i32__" 2)
    map_put_str(m "__store_i64__" 2)
    map_put_str(m "__load__" 1)
    map_put_str(m "__store__" 2)
    map_put_str(m "__alloca__" 1)
    map_put_str(m "__static_alloca__" 1)
    map_put_str(m "__signed_shr__" 2)
    map_put_str(m "__unsigned_idiv__" 2)
    map_put_str(m "__unsigned_mod__" 2)
    map_put_str(m "__unsigned_lt__" 2)
    map_put_str(m "__unsigned_gt__" 2)
    map_put_str(m "__unsigned_lte__" 2)
    map_put_str(m "__unsigned_gte__" 2)
    map_put_str(m "__breakpoint__" 0)
    g_core_intrinsics = m
    return void
}

# ----------------------------------------------------------------------------
# Function pointer globals. All initialized to 0; populated by select_backend.
# ----------------------------------------------------------------------------
#
# Module lifecycle
let be_begin_module:int = 0           # fn ():>void
let be_finish_module:int = 0          # fn ():>int (returns length-prefixed code string)
let be_set_module_init:int = 0        # fn (name:int):>void   (0 if no init)
let be_set_imported_sources:int = 0   # fn (paths_vec:int):>void
# Debug information (metadata only; the defaults do nothing)
# Chosen before parsing; diagnostics and breakpoint instructions are unaffected.
let be_debug_info:int = true

# Whether a build writes its objects (or wasm module) itself rather than
# through the assembler: the native default. UDEWY_OBJECT=as selects `as`
# (the cross binutils, `wat2wasm`) instead. The Python µDewy keeps the
# assembler by default, where it is the faster route.
let be_direct_objects = ():>int => {
    let mode:int = proc_getenv("UDEWY_OBJECT")
    if mode =? 0 { return true }
    return not str_eq(mode "as")
}
let be_mark_location:int = 0          # fn (path:int line:int column:int):>void — the source position of the code emitted next
let be_note_local:int = 0             # fn (slot:int name:int type_name:int formatter:int parameter:int):>void — a declared variable or parameter
let be_begin_scope:int = 0            # fn ():>void
let be_end_scope:int = 0              # fn ():>void

# Data section
let be_intern_string:int = 0          # fn (data:int len:int):>int
let be_intern_words:int = 0           # fn (elements_vec:int kinds_vec:int):>int
let be_define_global:int = 0          # fn (name:int kind:int value:int):>int  kind: SV_*
let be_declare_extern_global:int = 0  # fn (name:int):>int
let be_intern_static:int = 0          # fn (size:int):>int
let be_push_string_ref:int = 0        # fn (label_id:int):>void
let be_push_global_ref:int = 0        # fn (label_id:int):>void
let be_push_static_ref:int = 0        # fn (label_id:int):>void
let be_load_global:int = 0            # fn (label_id:int):>void
let be_store_global:int = 0           # fn (label_id:int):>void
let be_function_ref:int = 0           # fn (label_id:int):>int
let be_string_ref:int = 0             # fn (label_id:int):>int
let be_static_ref:int = 0             # fn (label_id:int):>int

# Functions
let be_declare_function:int = 0       # fn (name:int num_params:int):>int
let be_bind_extern_function:int = 0   # fn (label_id:int name:int):>void
let be_declare_extern_function:int = 0  # fn (name:int num_params:int):>int
let be_should_warn_unused_extern:int = 0  # fn (name:int):>int
let be_begin_function:int = 0         # fn (label_id:int name:int param_count:int is_main:int):>void
let be_end_function:int = 0           # fn ():>void
let be_set_reachable_functions:int = 0  # fn (label_ids_set:int):>void
let be_load_param:int = 0             # fn (index:int):>void
let be_alloc_local:int = 0            # fn ():>int
let be_load_local:int = 0             # fn (slot:int):>void
let be_store_local:int = 0            # fn (slot:int):>void

# Value stack
let be_push_const_i64:int = 0         # fn (value:int):>void
let be_push_void:int = 0              # fn ():>void
let be_push_fn_ref:int = 0            # fn (label_id:int):>void
let be_pop_value:int = 0              # fn ():>void
let be_save_value:int = 0             # fn ():>void
let be_restore_value:int = 0          # fn ():>void

# Operators
let be_unary_op:int = 0               # fn (op_kind:int):>void
let be_binary_op:int = 0              # fn (op_kind:int):>void
let be_binary_immediate:int = 0       # fn (op_kind:int value:int):>void

# A target may use immediate instructions without disturbing older saved
# operands. This default is the ordinary stack sequence for the same operation.
let be_default_binary_immediate = (op_kind:int value:int):>void => {
    (@be_save_value)()
    (@be_push_const_i64)(value)
    (@be_binary_op)(op_kind)
    return void
}

# Control flow
let be_begin_if:int = 0
let be_begin_else:int = 0
let be_end_if:int = 0
let be_begin_loop:int = 0
let be_begin_loop_body:int = 0
let be_end_loop:int = 0
let be_emit_break:int = 0
let be_emit_continue:int = 0
let be_cond_and_split:int = 0         # fn ():>int (returns label)
let be_cond_and_join:int = 0          # fn (label:int):>void
let be_cond_or_split:int = 0          # fn ():>int
let be_cond_or_join:int = 0           # fn (label:int):>void
let be_emit_return:int = 0

# Calls
let be_call_direct:int = 0            # fn (label_id:int num_args:int):>void
let be_call_indirect:int = 0          # fn (num_args:int):>void
let be_max_call_args:int = 0          # fn ():>int (-1 = unlimited)

# Intrinsics
let be_is_intrinsic:int = 0           # fn (name:int):>int
let be_intrinsic_arity:int = 0        # fn (name:int):>int (-1 = unsupported)
let be_intrinsic_static_arg_indices:int = 0  # fn (name:int):>int (bitmask)
let be_emit_intrinsic:int = 0         # fn (name:int num_args:int static_args_map:int):>void
let be_get_builtin_constants:int = 0  # fn ():>int (returns Map of name -> int)

# Compilation
let be_compile_and_link:int = 0       # fn (code:int input_name:int cache_dir:int options:int):>int
let be_run:int = 0                    # fn (output_path:int args:int options:int):>int
let be_get_compile_message:int = 0    # fn (output_path:int options:int):>int

# ----------------------------------------------------------------------------
# CompileOptions struct (analogous to udewy.backend.common.RunOptions + kwargs).
# Backends accept a pointer to this struct in compile_and_link / run; 0 means
# "no options, all defaults". Accessors below tolerate a 0 pointer.
# ----------------------------------------------------------------------------
#
# +0   link_artifacts:Vec<str>     (0 if none)
# +8   split_wasm:int (bool)
# +16  serve_wasm:int (bool)
# +24  input_file:str               (0 if none; resolved source path)
const BO_LINK_ARTIFACTS:int = 0
const BO_SPLIT_WASM:int = 8
const BO_SERVE_WASM:int = 16
const BO_INPUT_FILE:int = 24
const BO_SIZE:int = 32

let be_options_new = ():>int => {
    let opts:int = arena_alloc(BO_SIZE)
    __store__(0 opts + BO_LINK_ARTIFACTS)
    __store__(false opts + BO_SPLIT_WASM)
    __store__(false opts + BO_SERVE_WASM)
    __store__(0 opts + BO_INPUT_FILE)
    return opts
}

let be_opt_link_artifacts = (opts:int):>int => {
    if opts =? 0 { return 0 }
    return __load__(opts + BO_LINK_ARTIFACTS)
}

let be_opt_split_wasm = (opts:int):>int => {
    if opts =? 0 { return false }
    return __load__(opts + BO_SPLIT_WASM)
}

let be_opt_serve_wasm = (opts:int):>int => {
    if opts =? 0 { return false }
    return __load__(opts + BO_SERVE_WASM)
}

let be_opt_input_file = (opts:int):>int => {
    if opts =? 0 { return 0 }
    return __load__(opts + BO_INPUT_FILE)
}

let be_opt_set_link_artifacts = (opts:int v:int):>void => { __store__(v opts + BO_LINK_ARTIFACTS)  return void }
let be_opt_set_split_wasm     = (opts:int v:int):>void => { __store__(v opts + BO_SPLIT_WASM)     return void }
let be_opt_set_serve_wasm     = (opts:int v:int):>void => { __store__(v opts + BO_SERVE_WASM)     return void }
let be_opt_set_input_file     = (opts:int v:int):>void => { __store__(v opts + BO_INPUT_FILE)     return void }

# Convenience: classify a link-artifact path as shared (.so or .so.N) vs static
# (everything else: .a, .o, .js, .wasm, ...). Returns true for shared.
let be_artifact_is_shared = (path:int):>int => {
    let n:int = str_len(path)
    let i:int = 0
    loop i <? n - 2 {
        # Look for ".so" followed by end-of-string or "." (e.g. .so.0.25.0).
        if __load_u8__(path + i) =? 46 {
            if __load_u8__(path + i + 1) =? 115 {
                if __load_u8__(path + i + 2) =? 111 {
                    let after:int = i + 3
                    if after =? n { return true }
                    if __load_u8__(path + after) =? 46 { return true }
                }
            }
        }
        i = i + 1
    }
    return false
}

# Default for backends without source-level capability modules.
let be_default_should_warn_unused_extern = (name:int):>int => {
    return true
}

let be_default_set_imported_sources = (paths_vec:int):>void => {
    return void
}

let be_default_mark_location = (path:int line:int column:int):>void => {
    return void
}

let be_default_note_local = (slot:int name:int type_name:int formatter:int parameter:int):>void => {
    return void
}

let be_default_scope_hook = ():>void => {
    return void
}

let be_default_intrinsic_static_arg_indices = (name:int):>int => {
    return 0
}

# ----------------------------------------------------------------------------
# Local register allocation (mirrors backend.common.LocalRegisterAllocator).
#
# Native backends keep every local in a frame slot and record each access as
# a site: the code line that reads or writes the slot, the slot's dense key,
# and the text before and after the operand in the instruction's register
# form (the line as emitted holds the frame-slot form). µDewy has no
# address-of-local operation, so the recorded sites are every use of a slot.
# At the end of a function the sites become live intervals; a linear scan
# hands the busiest intervals registers and the backend rewrites their sites
# into register moves. Slots keep their frame homes, so frame sizes and
# alignment do not change.
#
# Intervals are line ranges. A value declared before a loop and touched
# inside it lives around the whole loop; a slot allocated inside the loop
# (its `let` is in the body) cannot be read before the body stores it again,
# so such loops never widen its interval. Clobber lines (calls, syscalls)
# split the register file: an interval spanning one may only use a register
# the callee preserves; a call-free interval prefers a scratch register.
# ----------------------------------------------------------------------------

let la_sites:int = 0        # flattened (line, key, prefix, suffix)
let la_scores:int = 0       # key -> use weight
let la_alloc_lines:int = 0  # key -> line index at allocation (-1 unknown)
let la_pinned:int = 0       # key -> true when the slot must stay in memory
let la_loops:int = 0        # flattened (start line, end line) per finished loop
let la_open_loops:int = 0   # stack of start lines of loops being emitted
let la_clobbers:int = 0     # line indices that clobber scratch registers
let la_assignment:int = 0   # key -> register string or 0, after la_assign

let la_init = ():>void => {
    if la_sites not=? 0 { return void }
    la_sites = vec_new(64)
    la_scores = vec_new(16)
    la_alloc_lines = vec_new(16)
    la_pinned = vec_new(16)
    la_loops = vec_new(8)
    la_open_loops = vec_new(4)
    la_clobbers = vec_new(16)
    la_assignment = vec_new(16)
    return void
}

let la_begin_function = ():>void => {
    la_init()
    vec_set_len(la_sites 0)
    vec_set_len(la_scores 0)
    vec_set_len(la_alloc_lines 0)
    vec_set_len(la_pinned 0)
    vec_set_len(la_loops 0)
    vec_set_len(la_open_loops 0)
    vec_set_len(la_clobbers 0)
    vec_set_len(la_assignment 0)
    return void
}

let la_ensure_key = (key:int):>void => {
    loop vec_len(la_scores) <=? key {
        vec_push(la_scores 0)
        vec_push(la_alloc_lines (-1))
        vec_push(la_pinned false)
    }
    return void
}

let la_note_alloc = (key:int line:int):>void => {
    la_ensure_key(key)
    if vec_get(la_alloc_lines key) <? 0 { vec_set(la_alloc_lines key line) }
    return void
}

let la_pin = (key:int):>void => {
    la_ensure_key(key)
    vec_set(la_pinned key true)
    return void
}

let la_loop_depth = ():>int => {
    return vec_len(la_open_loops)
}

let la_note_site = (line:int key:int prefix:int suffix:int):>void => {
    la_ensure_key(key)
    let depth:int = vec_len(la_open_loops)
    if depth >? 3 { depth = 3 }
    vec_set(la_scores key vec_get(la_scores key) + (1 << (3 * depth)))
    vec_push(la_sites line)
    vec_push(la_sites key)
    vec_push(la_sites prefix)
    vec_push(la_sites suffix)
    return void
}

let la_begin_loop = (line:int):>void => {
    vec_push(la_open_loops line)
    return void
}

let la_end_loop = (line:int):>void => {
    let start:int = vec_get(la_open_loops vec_len(la_open_loops) - 1)
    vec_pop(la_open_loops)
    vec_push(la_loops start)
    vec_push(la_loops line)
    return void
}

let la_note_clobber = (line:int):>void => {
    vec_push(la_clobbers line)
    return void
}

# Assign registers: `callee_regs` survive clobber lines, `caller_regs` do not.
# Fills la_assignment (key -> register or 0).
let la_assign = (callee_regs:int caller_regs:int):>void => {
    let keys:int = vec_len(la_scores)
    vec_set_len(la_assignment 0)
    let starts:int = vec_new(keys)
    let ends:int = vec_new(keys)
    let counts:int = vec_new(keys)
    let k:int = 0
    loop k <? keys {
        vec_push(la_assignment 0)
        vec_push(starts (-1))
        vec_push(ends (-1))
        vec_push(counts 0)
        k = k + 1
    }
    let i:int = 0
    loop i <? vec_len(la_sites) {
        let line:int = vec_get(la_sites i)
        let key:int = vec_get(la_sites i + 1)
        if vec_get(starts key) <? 0 or line <? vec_get(starts key) { vec_set(starts key line) }
        if line >? vec_get(ends key) { vec_set(ends key line) }
        vec_set(counts key vec_get(counts key) + 1)
        i = i + 4
    }
    # Loops finish inner before outer, so one pass in finishing order widens
    # an interval through every loop that carries it around a back edge.
    let l:int = 0
    loop l <? vec_len(la_loops) {
        let loop_start:int = vec_get(la_loops l)
        let loop_end:int = vec_get(la_loops l + 1)
        k = 0
        loop k <? keys {
            if vec_get(counts k) >? 0 and vec_get(la_alloc_lines k) <? loop_start {
                if vec_get(starts k) <=? loop_end and vec_get(ends k) >=? loop_start {
                    if vec_get(starts k) >? loop_start { vec_set(starts k loop_start) }
                    if vec_get(ends k) <? loop_end { vec_set(ends k loop_end) }
                }
            }
            k = k + 1
        }
        l = l + 2
    }
    # Candidates in start order (insertion sort; functions have few locals).
    let order:int = vec_new(keys)
    k = 0
    loop k <? keys {
        if vec_get(counts k) >=? 2 and not vec_get(la_pinned k) {
            let pos:int = vec_len(order)
            vec_push(order k)
            loop pos >? 0 and vec_get(starts vec_get(order pos - 1)) >? vec_get(starts k) {
                vec_set(order pos vec_get(order pos - 1))
                pos = pos - 1
            }
            vec_set(order pos k)
        }
        k = k + 1
    }
    let callee_count:int = vec_len(callee_regs)
    let caller_count:int = vec_len(caller_regs)
    let reg_count:int = callee_count + caller_count
    # Register r (index into callee then caller pools) -> key holding it, or -1.
    let holders:int = vec_new(reg_count)
    let r:int = 0
    loop r <? reg_count {
        vec_push(holders (-1))
        r = r + 1
    }
    let clobber_cursor:int = 0
    let o:int = 0
    loop o <? vec_len(order) {
        let key:int = vec_get(order o)
        let start:int = vec_get(starts key)
        let end:int = vec_get(ends key)
        # Expire intervals that ended before this one starts.
        r = 0
        loop r <? reg_count {
            let holder:int = vec_get(holders r)
            if holder >=? 0 and vec_get(ends holder) <? start { vec_set(holders r (-1)) }
            r = r + 1
        }
        # Does a clobber line fall strictly inside the interval?
        loop clobber_cursor <? vec_len(la_clobbers) and vec_get(la_clobbers clobber_cursor) <? start {
            clobber_cursor = clobber_cursor + 1
        }
        let spans_clobber:int = clobber_cursor <? vec_len(la_clobbers) and vec_get(la_clobbers clobber_cursor) <? end
        # Eligible registers: scratch first for call-free intervals, then saved.
        let first:int = 0
        let last:int = callee_count
        if not spans_clobber { last = reg_count }
        let chosen:int = -1
        r = callee_count
        if spans_clobber { r = 0 }
        loop r <? last and chosen <? 0 {
            if vec_get(holders r) <? 0 { chosen = r }
            r = r + 1
        }
        if chosen <? 0 and not spans_clobber {
            r = 0
            loop r <? callee_count and chosen <? 0 {
                if vec_get(holders r) <? 0 { chosen = r }
                r = r + 1
            }
        }
        if chosen <? 0 {
            # Evict the least valuable active interval when this one is busier.
            let victim:int = -1
            let victim_score:int = 0
            r = first
            loop r <? last {
                let holder:int = vec_get(holders r)
                if holder >=? 0 {
                    if victim <? 0 or vec_get(la_scores holder) <? victim_score {
                        victim = r
                        victim_score = vec_get(la_scores holder)
                    }
                }
                r = r + 1
            }
            if victim >=? 0 and victim_score <? vec_get(la_scores key) {
                vec_set(la_assignment vec_get(holders victim) 0)
                chosen = victim
            }
        }
        if chosen >=? 0 {
            vec_set(holders chosen key)
            if chosen <? callee_count { vec_set(la_assignment key vec_get(callee_regs chosen)) }
            else { vec_set(la_assignment key vec_get(caller_regs chosen - callee_count)) }
        }
        o = o + 1
    }
    return void
}

# Rewrite every site of an assigned slot into its register form.
let la_rewrite = (code:int):>void => {
    let i:int = 0
    loop i <? vec_len(la_sites) {
        let register:int = vec_get(la_assignment vec_get(la_sites i + 1))
        if register not=? 0 {
            let prefix:int = vec_get(la_sites i + 2)
            let suffix:int = vec_get(la_sites i + 3)
            let bb:int = bb_new(str_len(prefix) + str_len(register) + str_len(suffix))
            bb_push_str(bb prefix)
            bb_push_str(bb register)
            bb_push_str(bb suffix)
            vec_set(code vec_get(la_sites i) bb_finalize_as_string(bb))
        }
        i = i + 4
    }
    return void
}

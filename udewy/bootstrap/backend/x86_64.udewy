# x86_64 backend for the udewy bootstrap. Generates GNU assembler syntax
# targeting Linux x86_64 with System V ABI. Mirrors udewy/backend/x86_64.py.

import p"./common.udewy"
import p"./linux.udewy"
import p"../t1.udewy"

# ----------------------------------------------------------------------------
# Backend state (globals -- only one backend is active at a time)
# ----------------------------------------------------------------------------

const X86_FIXED_FRAME_BYTES:int = 48

# Vec of label_ids (parallel to x86_function_codes).
let x86_function_ids:int = 0
# Vec of code Vecs. Each entry is a Vec of length-prefixed string lines.
let x86_function_codes:int = 0

# The currently-being-emitted function's code Vec, or 0 when between functions.
let x86_current_fn_code:int = 0
# A final add/sub immediate can become the following memory displacement.
# The code vector and its length identify adjacency, including debug barriers.
let x86_address_code:int = 0
let x86_address_length:int = 0
let x86_address_offset:int = 0

# IntSet of label_ids that are reachable (may be 0 = all reachable).
let x86_reachable_fn_label_ids:int = 0
let x86_have_reachable:int = 0

# Vec of data section lines.
let x86_data:int = 0

# Next label id (also used to mint unique label names).
let x86_next_label:int = 0

# Set of extern symbol strings (needed for .extern declarations).
let x86_extern_symbols:int = 0

# 0 = none, otherwise a udewy string for the module init function name.
let x86_module_init_name:int = 0

# Per-function state.
let x86_current_fn_epilogue:int = 0    # string: "<label>_epilogue"
let x86_stack_offset:int = 0           # next free local slot
let x86_param_slots:int = 0            # Vec of slot offsets
let x86_saved_depth:int = 0
let x86_spilled_depth:int = 0
let x86_min_slot_offset:int = 0
let x86_frame_subtract_index:int = 0   # index into current_fn_code to patch
# Local register allocation (la_* in common.udewy). Slots are keyed densely
# by frame position. %rbx/%r15 are preserved by the ABI and are not
# expression scratch; %r8/%r9/%r11 are free between calls and syscalls.
let x86_callee_local_regs:int = 0
let x86_caller_local_regs:int = 0
# The visible value may be pending rather than in %rax: the flags of the last
# comparison (the condition that would make it -1), a local plus a constant
# offset not yet loaded, a constant, or a load not yet performed. Branches,
# saves, comparisons and memory operations consume pending values directly;
# every other emitter flushes them first.
const XP_NONE:int = 0
const XP_CC:int = 1
const XP_SLOT:int = 2
const XP_CONST:int = 3
const XP_MEM:int = 4
let x86_pending_kind:int = 0
let x86_pending_cc:int = 0        # XP_CC
let x86_pending_slot:int = 0      # XP_SLOT, and XP_MEM based on a local
let x86_pending_offset:int = 0
let x86_pending_value:int = 0     # XP_CONST
let x86_pending_width:int = 0     # XP_MEM
let x86_pending_signed:int = 0
let x86_pending_address:int = 0   # XP_MEM operand text based on %rax, or 0 when based on the local

# Control-flow stacks. The if stack has 3 parallel Vecs; loop stack has 2.
let x86_if_else_labels:int = 0
let x86_if_end_labels:int = 0
let x86_if_else_emitted:int = 0
let x86_loop_start_labels:int = 0
# Parallel assembly: byte offsets into the finished text where independent
# chunks begin (empty when the module is assembled as one file), and the
# directives every chunk repeats (source files, externs).
let x86_chunk_offsets:int = 0
let x86_chunk_header:int = 0
let x86_loop_end_labels:int = 0

# label_id -> string ptr (length-prefixed) mappings via IntMap.
let x86_fn_labels:int = 0
let x86_global_labels:int = 0
let x86_string_labels:int = 0
let x86_static_labels:int = 0

# Debug information (mirrors x86_64.py): DWARF file numbers for `.loc`, and
# every function's variables in their lexical scopes.
let x86_source_files:int = 0         # Map path -> file number
let x86_source_file_paths:int = 0    # Vec<str>, in numbering order
let x86_debug_functions:int = 0      # Vec<DebugFunction>
let x86_debug_function:int = 0       # DebugFunction, or 0
let x86_debug_scope:int = 0          # the innermost open DebugScope, or 0
let x86_debug_frames:int = 0         # Vec of (frame root, end label, outer scope), flattened in threes

# DebugScope: +0 low label, +8 high label, +16 Vec<DebugVar>, +24 Vec<DebugScope>, +32 Vec<DebugVar> parameters (a function's root only)
const DS_LOW:int = 0
const DS_HIGH:int = 8
const DS_VARS:int = 16
const DS_CHILDREN:int = 24
const DS_PARAMS:int = 32
const DS_SIZE:int = 40
# DebugVar: +0 name, +8 slot, +16 type name, +24 formatter (0: none)
const DV_NAME:int = 0
const DV_SLOT:int = 8
const DV_TYPE:int = 16
const DV_FORMATTER:int = 24
const DV_SIZE:int = 32
# DebugFunction: +0 name, +8 label, +16 end label, +24 scope, +32 label id
const DF_NAME:int = 0
const DF_LABEL:int = 8
const DF_END:int = 16
const DF_SCOPE:int = 24
const DF_LABEL_ID:int = 32
const DF_SIZE:int = 40

let x86_debug_scope_new = (low:int high:int):>int => {
    let d:int = arena_alloc(DS_SIZE)
    __store__(low d + DS_LOW)
    __store__(high d + DS_HIGH)
    __store__(vec_new(2) d + DS_VARS)
    __store__(vec_new(2) d + DS_CHILDREN)
    __store__(vec_new(2) d + DS_PARAMS)
    return d
}

# ----------------------------------------------------------------------------
# Helpers
# ----------------------------------------------------------------------------

let x86_alloc_state = ():>void => {
    x86_address_code = 0
    x86_function_ids = vec_new(16)
    x86_function_codes = vec_new(16)
    x86_data = vec_new(32)
    x86_extern_symbols = set_new()
    x86_param_slots = vec_new(8)
    x86_callee_local_regs = vec_new(2)
    vec_push(x86_callee_local_regs "%rbx")
    vec_push(x86_callee_local_regs "%r15")
    x86_caller_local_regs = vec_new(3)
    vec_push(x86_caller_local_regs "%r8")
    vec_push(x86_caller_local_regs "%r9")
    vec_push(x86_caller_local_regs "%r11")
    x86_if_else_labels = vec_new(4)
    x86_if_end_labels = vec_new(4)
    x86_if_else_emitted = vec_new(4)
    x86_loop_start_labels = vec_new(4)
    x86_loop_end_labels = vec_new(4)
    x86_fn_labels = intmap_new()
    x86_global_labels = intmap_new()
    x86_string_labels = intmap_new()
    x86_static_labels = intmap_new()
    x86_source_files = map_new()
    x86_source_file_paths = vec_new(4)
    x86_debug_functions = vec_new(16)
    x86_debug_function = 0
    x86_debug_scope = 0
    x86_debug_frames = vec_new(12)
    return void
}

let x86_str = (s:int):>int => {
    let bb:int = bb_new(str_len(s))
    bb_push_str(bb s)
    return bb_finalize_as_string(bb)
}

let x86_emit_str = (s:int):>void => {
    vec_push(x86_current_fn_code s)
    return void
}

let x86_emit_indented = (s:int):>void => {
    let bb:int = bb_new(8 + str_len(s))
    bb_push_str(bb "    ")
    bb_push_str(bb s)
    vec_push(x86_current_fn_code bb_finalize_as_string(bb))
    return void
}

let x86_emit_label_str = (label:int):>void => {
    let bb:int = bb_new(str_len(label) + 1)
    bb_push_str(bb label)
    bb_push_byte(bb 58)   # ':'
    vec_push(x86_current_fn_code bb_finalize_as_string(bb))
    return void
}

let x86_emit_data_str = (s:int):>void => {
    vec_push(x86_data s)
    return void
}

# Data and function labels are global symbols so that chunks assembled
# separately can refer to each other; control-flow labels stay local.
let x86_globl_line = (label:int):>int => {
    let bb:int = bb_new(str_len(label) + 8)
    bb_push_str(bb ".globl ")
    bb_push_str(bb label)
    return bb_finalize_as_string(bb)
}

let x86_emit_data_label = (label:int):>void => {
    vec_push(x86_data x86_globl_line(label))
    let bb:int = bb_new(str_len(label) + 1)
    bb_push_str(bb label)
    bb_push_byte(bb 58)
    vec_push(x86_data bb_finalize_as_string(bb))
    return void
}

# Generate a new unique label string ".<prefix><n>" — ".L<prefix><n>" for
# control-flow labels, which are assembler-local (dropped from the symbol
# table) so a debugger names frames by their function; data and function
# labels stay symbols.
let x86_new_label = (prefix:int):>int => {
    let bb:int = bb_new(8 + str_len(prefix))
    bb_push_byte(bb 46)   # '.'
    if not (str_eq(prefix "str") or str_eq(prefix "global") or str_eq(prefix "static") or str_eq(prefix "fn")) {
        bb_push_byte(bb 76)   # 'L'
    }
    bb_push_str(bb prefix)
    bb_push_int(bb x86_next_label)
    x86_next_label = x86_next_label + 1
    return bb_finalize_as_string(bb)
}

# ----------------------------------------------------------------------------
# Debug information: locations, scopes, variables (mirrors x86_64.py)
# ----------------------------------------------------------------------------

let x86_mark_location = (path:int line:int column:int):>void => {
    if not be_debug_info { return void }
    if x86_current_fn_code =? 0 { return void }   # nothing is emitted between functions
    x86_flush()
    let number:int = 0
    if map_has_str(x86_source_files path) {
        number = map_get_str(x86_source_files path)
    } else {
        number = vec_len(x86_source_file_paths) + 1
        map_put_str(x86_source_files path number)
        vec_push(x86_source_file_paths path)
    }
    let bb:int = bb_new(48)
    bb_push_str(bb "    .loc ")
    bb_push_int(bb number)
    bb_push_byte(bb 32)
    bb_push_int(bb line)
    bb_push_byte(bb 32)
    bb_push_int(bb column)
    vec_push(x86_current_fn_code bb_finalize_as_string(bb))
    return void
}

let x86_debug_label = ():>int => {
    let label:int = x86_new_label("dbg")
    x86_emit_label_str(label)
    return label
}

# The scopes still open close with the function (the parser pops the body's
# scope after `end_function`): their end labels go here.
let x86_end_debug_function = ():>void => {
    let n:int = vec_len(x86_debug_frames)
    let i:int = n - 3
    loop i >=? 0 {
        x86_emit_label_str(vec_get(x86_debug_frames i + 1))
        i = i - 3
    }
    vec_set_len(x86_debug_frames 0)
    x86_debug_scope = 0
    return void
}

let x86_begin_scope = ():>void => {
    if (x86_debug_scope =? 0) or (x86_current_fn_code =? 0) { return void }
    x86_flush()
    let end_label:int = x86_new_label("dbg_end")
    let node:int = x86_debug_scope_new(x86_debug_label() end_label)
    vec_push(__load__(x86_debug_scope + DS_CHILDREN) node)
    vec_push(x86_debug_frames node)
    vec_push(x86_debug_frames end_label)
    vec_push(x86_debug_frames x86_debug_scope)
    x86_debug_scope = node
    return void
}

let x86_end_scope = ():>void => {
    let n:int = vec_len(x86_debug_frames)
    if (n =? 0) or (x86_current_fn_code =? 0) { return void }
    x86_flush()
    let outer:int = vec_get(x86_debug_frames n - 1)
    let end_label:int = vec_get(x86_debug_frames n - 2)
    vec_set_len(x86_debug_frames n - 3)
    x86_emit_label_str(end_label)
    x86_debug_scope = outer
    return void
}

# A variable is visible from its declaration to the end of its scope: a
# lexical block from here to the scope's end holds it (later declarations of
# the scope nest inside, so each sees only what was declared before it).
let x86_debug_var_new = (slot:int name:int type_name:int formatter:int):>int => {
    let v:int = arena_alloc(DV_SIZE)
    __store__(name v + DV_NAME)
    __store__(slot v + DV_SLOT)
    __store__(type_name v + DV_TYPE)
    __store__(formatter v + DV_FORMATTER)
    return v
}

let x86_note_local = (slot:int name:int type_name:int formatter:int parameter:int):>void => {
    if (x86_debug_scope =? 0) or (x86_current_fn_code =? 0) { return void }
    if parameter {
        # visible throughout: a formal parameter of the function itself
        vec_push(__load__(__load__(x86_debug_function + DF_SCOPE) + DS_PARAMS) x86_debug_var_new(slot name type_name formatter))
        return void
    }
    let high:int = 0
    let n:int = vec_len(x86_debug_frames)
    if n >? 0 {
        high = vec_get(x86_debug_frames n - 2)
    } else {
        high = __load__(x86_debug_function + DF_END)
    }
    let node:int = x86_debug_scope_new(x86_debug_label() high)
    vec_push(__load__(node + DS_VARS) x86_debug_var_new(slot name type_name formatter))
    vec_push(__load__(x86_debug_scope + DS_CHILDREN) node)
    x86_debug_scope = node
    return void
}

let x86_dwarf_string = (out:int text:int):>void => {
    bb_push_str(out "    .string \"")
    let n:int = str_len(text)
    let i:int = 0
    loop i <? n {
        let b:int = __load_u8__(text + i)
        if (b =? 92) or (b =? 34) { bb_push_byte(out 92) }   # escape '\' and '"'
        bb_push_byte(out b)
        i = i + 1
    }
    bb_push_str(out "\"\n")
    return void
}

let x86_sleb128 = (out:int value:int):>void => {
    loop true {
        let byte:int = value and 127
        value = __signed_shr__(value 7)
        let done:int = false
        if (value =? 0) and ((byte and 64) =? 0) { done = true }
        if (value =? -1) and ((byte and 64) not=? 0) { done = true }
        if done {
            bb_push_int(out byte)
            return void
        }
        bb_push_int(out byte or 128)
        bb_push_str(out ", ")
    }
    return void
}

let x86_sleb128_length = (value:int):>int => {
    let count:int = 0
    loop true {
        let byte:int = value and 127
        value = __signed_shr__(value 7)
        count = count + 1
        if (value =? 0) and ((byte and 64) =? 0) { return count }
        if (value =? -1) and ((byte and 64) not=? 0) { return count }
    }
    return count
}

# a type name is a typedef of the word; with a formatter it is a typedef of
# the formatter's typedef, so a debugger shows the type's name and its
# script finds the formatter through the chain
let x86_type_key = (type_name:int formatter:int):>int => {
    let bb:int = bb_new(str_len(type_name) + 2)
    bb_push_str(bb type_name)
    bb_push_byte(bb 0)
    if formatter not=? 0 { bb_push_str(bb formatter) }
    return bb_finalize_as_string(bb)
}

let x86_collect_debug_vars = (vars:int type_names:int type_keys:int formatters:int formatter_names:int):>void => {
    let i:int = 0
    loop i <? vec_len(vars) {
        let v:int = vec_get(vars i)
        let formatter:int = __load__(v + DV_FORMATTER)
        if (formatter not=? 0) and (not map_has_str(formatters formatter)) {
            map_put_str(formatters formatter vec_len(formatter_names))
            vec_push(formatter_names formatter)
        }
        let key:int = x86_type_key(__load__(v + DV_TYPE) formatter)
        if not map_has_str(type_names key) {
            map_put_str(type_names key vec_len(type_keys))
            vec_push(type_keys v)
        }
        i = i + 1
    }
    return void
}

let x86_collect_debug_types = (scope:int type_names:int type_keys:int formatters:int formatter_names:int):>void => {
    x86_collect_debug_vars(__load__(scope + DS_PARAMS) type_names type_keys formatters formatter_names)
    x86_collect_debug_vars(__load__(scope + DS_VARS) type_names type_keys formatters formatter_names)
    let children:int = __load__(scope + DS_CHILDREN)
    let c:int = 0
    loop c <? vec_len(children) {
        x86_collect_debug_types(vec_get(children c) type_names type_keys formatters formatter_names)
        c = c + 1
    }
    return void
}

let x86_push_label_ref = (out:int prefix:int index:int suffix:int):>void => {
    bb_push_str(out prefix)
    bb_push_int(out index)
    bb_push_str(out suffix)
    return void
}

let x86_emit_debug_scope = (out:int scope:int block:int type_names:int):>void => {
    if block {
        bb_push_str(out "    .uleb128 6\n")
        bb_push_str(out "    .quad ")
        bb_push_str(out __load__(scope + DS_LOW))
        bb_push_str(out "\n    .quad ")
        bb_push_str(out __load__(scope + DS_HIGH))
        bb_push_str(out " - ")
        bb_push_str(out __load__(scope + DS_LOW))
        bb_push_byte(out 10)
    }
    x86_emit_debug_vars(out __load__(scope + DS_PARAMS) 7 type_names)
    x86_emit_debug_vars(out __load__(scope + DS_VARS) 5 type_names)
    let children:int = __load__(scope + DS_CHILDREN)
    let c:int = 0
    loop c <? vec_len(children) {
        x86_emit_debug_scope(out vec_get(children c) true type_names)
        c = c + 1
    }
    if block { bb_push_str(out "    .byte 0\n") }
    return void
}

let x86_emit_debug_vars = (out:int vars:int abbrev:int type_names:int):>void => {
    let i:int = 0
    loop i <? vec_len(vars) {
        let v:int = vec_get(vars i)
        bb_push_str(out "    .uleb128 ")
        bb_push_int(out abbrev)
        bb_push_byte(out 10)
        x86_dwarf_string(out __load__(v + DV_NAME))
        let key:int = x86_type_key(__load__(v + DV_TYPE) __load__(v + DV_FORMATTER))
        x86_push_label_ref(out "    .long .Ldbg_type" map_get_str(type_names key) " - .Ldebug_info0\n")
        let slot:int = __load__(v + DV_SLOT)
        bb_push_str(out "    .uleb128 ")
        bb_push_int(out 1 + x86_sleb128_length(slot))
        bb_push_str(out "\n    .byte 0x91\n    .byte ")   # DW_OP_fbreg
        x86_sleb128(out slot)
        bb_push_byte(out 10)
        i = i + 1
    }
    return void
}

# DWARF 4: one compile unit with the functions, their parameters and locals
# (each at a fixed `%rbp` offset), and a typedef per type name so a debugger
# script can format values by the name. The assembler builds the line table
# from `.loc`; `.debug_aranges` maps addresses to the unit.
let x86_debug_info_sections = (out:int):>void => {
    let functions:int = vec_new(16)
    let fi:int = 0
    loop fi <? vec_len(x86_debug_functions) {
        let f:int = vec_get(x86_debug_functions fi)
        if (not x86_have_reachable) or intset_has(x86_reachable_fn_label_ids __load__(f + DF_LABEL_ID)) {
            vec_push(functions f)
        }
        fi = fi + 1
    }
    if vec_len(functions) =? 0 { return void }
    let type_names:int = map_new()      # type key -> typedef index
    let type_keys:int = vec_new(16)     # index -> a DebugVar with that type and formatter
    let formatters:int = map_new()      # formatter -> typedef index
    let formatter_names:int = vec_new(8)
    fi = 0
    loop fi <? vec_len(functions) {
        x86_collect_debug_types(__load__(vec_get(functions fi) + DF_SCOPE) type_names type_keys formatters formatter_names)
        fi = fi + 1
    }
    let has_lines:int = vec_len(x86_source_file_paths) >? 0
    bb_push_str(out ".section .debug_abbrev,\"\",@progbits\n.Ldebug_abbrev0:\n")
    bb_push_str(out "    .uleb128 1\n    .uleb128 0x11\n    .byte 1\n")
    bb_push_str(out "    .uleb128 0x25 ; .uleb128 0x08\n    .uleb128 0x13 ; .uleb128 0x05\n    .uleb128 0x03 ; .uleb128 0x08\n")
    if has_lines { bb_push_str(out "    .uleb128 0x10 ; .uleb128 0x17\n") }
    bb_push_str(out "    .byte 0 ; .byte 0\n")
    bb_push_str(out "    .uleb128 2 ; .uleb128 0x24 ; .byte 0\n    .uleb128 0x03 ; .uleb128 0x08\n    .uleb128 0x3e ; .uleb128 0x0b\n    .uleb128 0x0b ; .uleb128 0x0b\n    .byte 0 ; .byte 0\n")
    bb_push_str(out "    .uleb128 3 ; .uleb128 0x16 ; .byte 0\n    .uleb128 0x03 ; .uleb128 0x08\n    .uleb128 0x49 ; .uleb128 0x13\n    .byte 0 ; .byte 0\n")
    bb_push_str(out "    .uleb128 4 ; .uleb128 0x2e ; .byte 1\n    .uleb128 0x03 ; .uleb128 0x08\n    .uleb128 0x11 ; .uleb128 0x01\n    .uleb128 0x12 ; .uleb128 0x07\n    .uleb128 0x40 ; .uleb128 0x18\n    .uleb128 0x3f ; .uleb128 0x19\n    .byte 0 ; .byte 0\n")
    bb_push_str(out "    .uleb128 5 ; .uleb128 0x34 ; .byte 0\n    .uleb128 0x03 ; .uleb128 0x08\n    .uleb128 0x49 ; .uleb128 0x13\n    .uleb128 0x02 ; .uleb128 0x18\n    .byte 0 ; .byte 0\n")
    bb_push_str(out "    .uleb128 6 ; .uleb128 0x0b ; .byte 1\n    .uleb128 0x11 ; .uleb128 0x01\n    .uleb128 0x12 ; .uleb128 0x07\n    .byte 0 ; .byte 0\n")
    bb_push_str(out "    .uleb128 7 ; .uleb128 0x05 ; .byte 0\n    .uleb128 0x03 ; .uleb128 0x08\n    .uleb128 0x49 ; .uleb128 0x13\n    .uleb128 0x02 ; .uleb128 0x18\n    .byte 0 ; .byte 0\n")
    bb_push_str(out "    .byte 0\n\n")
    bb_push_str(out ".section .debug_info,\"\",@progbits\n.Ldebug_info0:\n")
    bb_push_str(out "    .long .Ldebug_info_end - .Ldebug_info_start\n.Ldebug_info_start:\n")
    bb_push_str(out "    .value 4\n    .long .Ldebug_abbrev0\n    .byte 8\n    .uleb128 1\n")
    x86_dwarf_string(out "udewy")
    bb_push_str(out "    .value 0x0c\n")   # DW_LANG_C99: the debuggers' expression parsers are happy with it
    let unit_name:int = "udewy"
    if has_lines { unit_name = vec_get(x86_source_file_paths 0) }
    x86_dwarf_string(out unit_name)
    if has_lines { bb_push_str(out "    .long .Ldebug_line0\n") }
    bb_push_str(out ".Ldbg_type_word:\n    .uleb128 2\n")
    x86_dwarf_string(out "int64")
    bb_push_str(out "    .byte 5\n    .byte 8\n")   # DW_ATE_signed, 8 bytes
    let k:int = 0
    loop k <? vec_len(formatter_names) {
        x86_push_label_ref(out ".Ldbg_fmt" k ":\n    .uleb128 3\n")
        x86_dwarf_string(out vec_get(formatter_names k))
        bb_push_str(out "    .long .Ldbg_type_word - .Ldebug_info0\n")
        k = k + 1
    }
    k = 0
    loop k <? vec_len(type_keys) {
        let v:int = vec_get(type_keys k)
        x86_push_label_ref(out ".Ldbg_type" k ":\n    .uleb128 3\n")
        x86_dwarf_string(out __load__(v + DV_TYPE))
        let formatter:int = __load__(v + DV_FORMATTER)
        if formatter not=? 0 {
            x86_push_label_ref(out "    .long .Ldbg_fmt" map_get_str(formatters formatter) " - .Ldebug_info0\n")
        } else {
            bb_push_str(out "    .long .Ldbg_type_word - .Ldebug_info0\n")
        }
        k = k + 1
    }
    fi = 0
    loop fi <? vec_len(functions) {
        let f:int = vec_get(functions fi)
        bb_push_str(out "    .uleb128 4\n")
        x86_dwarf_string(out __load__(f + DF_NAME))
        bb_push_str(out "    .quad ")
        bb_push_str(out __load__(f + DF_LABEL))
        bb_push_str(out "\n    .quad ")
        bb_push_str(out __load__(f + DF_END))
        bb_push_str(out " - ")
        bb_push_str(out __load__(f + DF_LABEL))
        bb_push_str(out "\n    .uleb128 1\n    .byte 0x56\n")   # DW_OP_reg6: %rbp is the frame base
        x86_emit_debug_scope(out __load__(f + DF_SCOPE) false type_names)
        bb_push_str(out "    .byte 0\n")
        fi = fi + 1
    }
    bb_push_str(out "    .byte 0\n.Ldebug_info_end:\n\n")
    bb_push_str(out ".section .debug_aranges,\"\",@progbits\n")
    bb_push_str(out "    .long .Ldebug_aranges_end - .Ldebug_aranges_start\n.Ldebug_aranges_start:\n")
    bb_push_str(out "    .value 2\n    .long .Ldebug_info0\n    .byte 8\n    .byte 0\n    .zero 4\n")
    fi = 0
    loop fi <? vec_len(functions) {
        let f:int = vec_get(functions fi)
        bb_push_str(out "    .quad ")
        bb_push_str(out __load__(f + DF_LABEL))
        bb_push_str(out "\n    .quad ")
        bb_push_str(out __load__(f + DF_END))
        bb_push_str(out " - ")
        bb_push_str(out __load__(f + DF_LABEL))
        bb_push_byte(out 10)
        fi = fi + 1
    }
    bb_push_str(out "    .quad 0\n    .quad 0\n.Ldebug_aranges_end:\n")
    if has_lines { bb_push_str(out ".section .debug_line,\"\",@progbits\n.Ldebug_line0:\n") }
    bb_push_byte(out 10)
    return void
}

let x86_arg_reg = (i:int):>int => {
    if i =? 0 { return "%rdi" }
    if i =? 1 { return "%rsi" }
    if i =? 2 { return "%rdx" }
    if i =? 3 { return "%rcx" }
    if i =? 4 { return "%r8" }
    if i =? 5 { return "%r9" }
    return 0
}

let x86_value_cache_reg = (i:int):>int => {
    if i =? 0 { return "%r12" }
    if i =? 1 { return "%r13" }
    if i =? 2 { return "%r14" }
    return 0
}

let x86_xmm_reg = (i:int):>int => {
    if i =? 0 { return "%xmm0" }
    if i =? 1 { return "%xmm1" }
    if i =? 2 { return "%xmm2" }
    if i =? 3 { return "%xmm3" }
    if i =? 4 { return "%xmm4" }
    if i =? 5 { return "%xmm5" }
    if i =? 6 { return "%xmm6" }
    if i =? 7 { return "%xmm7" }
    return 0
}

let x86_note_slot = (slot:int):>void => {
    if slot <? x86_min_slot_offset { x86_min_slot_offset = slot }
    return void
}

let x86_max_2 = (a:int b:int):>int => {
    if a >? b { return a }
    return b
}

let x86_frame_bytes = ():>int => {
    let required:int = x86_max_2(X86_FIXED_FRAME_BYTES (-x86_min_slot_offset))
    return (required + 15) and (-16)
}

# Push a 1-arg instruction: "    <op> <reg>"
let x86_emit_op_reg = (op:int reg:int):>void => {
    let bb:int = bb_new(32)
    bb_push_str(bb "    ")
    bb_push_str(bb op)
    bb_push_byte(bb 32)
    bb_push_str(bb reg)
    vec_push(x86_current_fn_code bb_finalize_as_string(bb))
    return void
}

# "    <op> <src>, <dst>"
let x86_emit_op_2 = (op:int src:int dst:int):>void => {
    let bb:int = bb_new(48)
    bb_push_str(bb "    ")
    bb_push_str(bb op)
    bb_push_byte(bb 32)
    bb_push_str(bb src)
    bb_push_str(bb ", ")
    bb_push_str(bb dst)
    vec_push(x86_current_fn_code bb_finalize_as_string(bb))
    return void
}

# "    <op> $<imm>, <dst>"
let x86_emit_op_imm = (op:int imm:int dst:int):>void => {
    let bb:int = bb_new(48)
    bb_push_str(bb "    ")
    bb_push_str(bb op)
    bb_push_str(bb " $")
    bb_push_int(bb imm)
    bb_push_str(bb ", ")
    bb_push_str(bb dst)
    vec_push(x86_current_fn_code bb_finalize_as_string(bb))
    return void
}

# "    <op> <off>(<base>), <dst>"
let x86_emit_op_mem_r = (op:int off:int base:int dst:int):>void => {
    let bb:int = bb_new(48)
    bb_push_str(bb "    ")
    bb_push_str(bb op)
    bb_push_byte(bb 32)
    bb_push_int(bb off)
    bb_push_byte(bb 40)
    bb_push_str(bb base)
    bb_push_str(bb "), ")
    bb_push_str(bb dst)
    vec_push(x86_current_fn_code bb_finalize_as_string(bb))
    return void
}

# "    <op> <src>, <off>(<base>)"
let x86_emit_op_r_mem = (op:int src:int off:int base:int):>void => {
    let bb:int = bb_new(48)
    bb_push_str(bb "    ")
    bb_push_str(bb op)
    bb_push_byte(bb 32)
    bb_push_str(bb src)
    bb_push_str(bb ", ")
    bb_push_int(bb off)
    bb_push_byte(bb 40)
    bb_push_str(bb base)
    bb_push_byte(bb 41)
    vec_push(x86_current_fn_code bb_finalize_as_string(bb))
    return void
}

# "    jmp <label>"
let x86_emit_jmp = (op:int label:int):>void => {
    let bb:int = bb_new(32)
    bb_push_str(bb "    ")
    bb_push_str(bb op)
    bb_push_byte(bb 32)
    bb_push_str(bb label)
    vec_push(x86_current_fn_code bb_finalize_as_string(bb))
    return void
}

# ----------------------------------------------------------------------------
# Save/restore logical-stack values into a small register cache, with spill.
# ----------------------------------------------------------------------------

# Spill slots spell the top of the stack as "(%rsp)", as the hosted backend does.
let x86_save_reg = (reg:int):>void => {
    if x86_spilled_depth >? 0 {
        x86_emit_indented("subq $16, %rsp")
        x86_emit_op_2("movq" reg "(%rsp)")
        x86_spilled_depth = x86_spilled_depth + 1
    } else if x86_saved_depth <? 3 {
        x86_emit_op_2("movq" reg x86_value_cache_reg(x86_saved_depth))
    } else {
        let i:int = 0
        loop i <? x86_saved_depth {
            x86_emit_indented("subq $16, %rsp")
            x86_emit_op_2("movq" x86_value_cache_reg(i) "(%rsp)")
            i = i + 1
        }
        x86_emit_indented("subq $16, %rsp")
        x86_emit_op_2("movq" reg "(%rsp)")
        x86_spilled_depth = x86_saved_depth + 1
    }
    x86_saved_depth = x86_saved_depth + 1
    return void
}

let x86_pop_saved_into = (reg:int):>void => {
    x86_saved_depth = x86_saved_depth - 1
    if x86_spilled_depth >? 0 {
        x86_emit_op_2("movq" "(%rsp)" reg)
        x86_emit_indented("addq $16, %rsp")
        x86_spilled_depth = x86_spilled_depth - 1
    } else if x86_saved_depth <? 3 {
        let cache_reg:int = x86_value_cache_reg(x86_saved_depth)
        if not str_eq(cache_reg reg) {
            x86_emit_op_2("movq" cache_reg reg)
        }
    }
    return void
}

# Consume a logical-stack value in its cache register. Once popped, that
# register may hold the result. A spilled value needs one scratch-register
# load; neither path disturbs the right operand in %rax.
let x86_pop_saved_operand = (width:int):>int => {
    let reg:int = 0
    if x86_spilled_depth =? 0 {
        x86_saved_depth = x86_saved_depth - 1
        reg = x86_value_cache_reg(x86_saved_depth)
    } else {
        reg = "%r10"
        x86_pop_saved_into(reg)
    }
    if width =? 64 { return reg }
    let bb:int = bb_new(8)
    bb_push_str(bb reg)
    if width =? 32 { bb_push_str(bb "d") }
    else if width =? 16 { bb_push_str(bb "w") }
    else if width =? 8 { bb_push_str(bb "b") }
    return bb_finalize_as_string(bb)
}

# ----------------------------------------------------------------------------
# Call argument preparation
# ----------------------------------------------------------------------------

# Marshal `num_args` saved values into argregs/stack, plus optionally a fn ptr
# into `fn_reg` (0 if not used). Returns the number of bytes added to rsp.
let x86_prepare_call_args = (num_args:int fn_reg:int):>int => {
    let reg_count:int = num_args
    if reg_count >? 6 { reg_count = 6 }
    let stack_count:int = num_args - reg_count
    let stack_bytes:int = ((stack_count * 8) + 15) and (-16)
    let consumed:int = num_args
    if fn_reg not=? 0 { consumed = consumed + 1 }

    if x86_spilled_depth >? 0 {
        x86_emit_op_2("movq" "%rsp" "%r10")
        if stack_bytes >? 0 {
            x86_emit_op_imm("subq" stack_bytes "%rsp")
            let o:int = 0
            loop o <? stack_count {
                let src_off:int = (stack_count - 1 - o) * 16
                x86_emit_op_mem_r("movq" src_off "%r10" "%rax")
                x86_emit_op_r_mem("movq" "%rax" o * 8 "%rsp")
                o = o + 1
            }
        }
        let ri:int = reg_count - 1
        loop ri >=? 0 {
            let src_off:int = (stack_count + (reg_count - 1 - ri)) * 16
            x86_emit_op_mem_r("movq" src_off "%r10" x86_arg_reg(ri))
            ri = ri - 1
        }
        if fn_reg not=? 0 {
            x86_emit_op_mem_r("movq" num_args * 16 "%r10" fn_reg)
        }
        x86_saved_depth = x86_saved_depth - consumed
        x86_spilled_depth = x86_spilled_depth - consumed
        return stack_bytes + consumed * 16
    }

    if stack_bytes >? 0 {
        x86_emit_op_imm("subq" stack_bytes "%rsp")
        let o:int = stack_count - 1
        loop o >=? 0 {
            x86_pop_saved_into("%rax")
            x86_emit_op_r_mem("movq" "%rax" o * 8 "%rsp")
            o = o - 1
        }
    }
    let ri2:int = reg_count - 1
    loop ri2 >=? 0 {
        x86_pop_saved_into(x86_arg_reg(ri2))
        ri2 = ri2 - 1
    }
    if fn_reg not=? 0 {
        x86_pop_saved_into(fn_reg)
    }
    return stack_bytes
}

# ----------------------------------------------------------------------------
# Module lifecycle
# ----------------------------------------------------------------------------

let x86_begin_module = ():>void => {
    return void
}

let x86_set_module_init = (name:int):>void => {
    x86_module_init_name = name
    return void
}

let x86_set_reachable_functions = (label_ids:int):>void => {
    x86_reachable_fn_label_ids = label_ids
    x86_have_reachable = true
    return void
}

# Assembler processes to run concurrently (UDEWY_JOBS; 1 assembles one file).
let x86_jobs = ():>int => {
    let jobs:int = proc_getenv_int("UDEWY_JOBS" 8)
    if jobs <? 1 { return 1 }
    if jobs >? 64 { return 64 }
    return jobs
}

let x86_finish_module = ():>int => {
    let out:int = bb_new(4096)
    x86_chunk_offsets = vec_new(8)
    let pf:int = 0
    loop pf <? vec_len(x86_source_file_paths) {
        bb_push_str(out ".file ")
        bb_push_int(out pf + 1)
        bb_push_str(out " \"")
        let path:int = vec_get(x86_source_file_paths pf)
        let pn:int = str_len(path)
        let pi:int = 0
        loop pi <? pn {
            let b:int = __load_u8__(path + pi)
            if (b =? 92) or (b =? 34) { bb_push_byte(out 92) }
            bb_push_byte(out b)
            pi = pi + 1
        }
        bb_push_str(out "\"\n")
        pf = pf + 1
    }
    let externs:int = x86_extern_symbols
    let cap:int = map_cap(externs)
    let slots:int = map_slots(externs)
    let names:int = vec_new(16)
    let i:int = 0
    loop i <? cap {
        let slot:int = slots + (i * 32)
        if __load__(slot) =? 1 {
            let key:int = __load__(slot + 8)
            let keylen:int = __load__(slot + 16)
            let bb:int = bb_new(keylen + 1)
            bb_push_bytes(bb key keylen)
            vec_push(names bb_finalize_as_string(bb))
        }
        i = i + 1
    }
    let m:int = vec_len(names)
    let a:int = 1
    loop a <? m {
        let cur:int = vec_get(names a)
        let b:int = a - 1
        loop b >=? 0 {
            let prev:int = vec_get(names b)
            if str_lex_cmp(prev cur) <=? 0 { break }
            vec_set(names b + 1 prev)
            b = b - 1
        }
        vec_set(names b + 1 cur)
        a = a + 1
    }
    let k:int = 0
    loop k <? m {
        bb_push_str(out ".extern ")
        bb_push_str(out vec_get(names k))
        bb_push_byte(out 10)
        k = k + 1
    }
    # Everything so far (source files, externs) is repeated in every chunk.
    let header:int = bb_new(bb_len(out) + 1)
    bb_push_bytes(header bb_data(out) bb_len(out))
    x86_chunk_header = bb_finalize_as_string(header)
    bb_push_str(out ".text\n")
    bb_push_str(out ".globl _start\n")
    bb_push_byte(out 10)
    bb_push_str(out "_start:\n")
    bb_push_str(out "    xorq %rbp, %rbp\n")
    bb_push_str(out "    movq (%rsp), %rdi\n")
    bb_push_str(out "    leaq 8(%rsp), %rsi\n")
    bb_push_str(out "    andq $-16, %rsp\n")
    if x86_module_init_name not=? 0 {
        bb_push_str(out "    call ")
        bb_push_str(out x86_module_init_name)
        bb_push_byte(out 10)
    }
    bb_push_str(out "    call __main__\n")
    bb_push_str(out "    movq %rax, %rdi\n")
    bb_push_str(out "    movq $231, %rax\n")
    bb_push_str(out "    syscall\n")
    bb_push_byte(out 10)
    let nf:int = vec_len(x86_function_ids)
    # Split a large debug-free module into roughly equal chunks at function
    # boundaries so the assembler can run on them concurrently. DWARF
    # sections refer to labels across the whole module, so they stay whole.
    let jobs:int = x86_jobs()
    let target:int = 0
    if jobs >? 1 and not be_debug_info {
        let total:int = 0
        let ti:int = 0
        loop ti <? nf {
            let tlid:int = vec_get(x86_function_ids ti)
            if (not x86_have_reachable) or intset_has(x86_reachable_fn_label_ids tlid) {
                let tlines:int = vec_get(x86_function_codes ti)
                let tl:int = vec_len(tlines)
                let tj:int = 0
                loop tj <? tl {
                    total = total + str_len(vec_get(tlines tj)) + 1
                    tj = tj + 1
                }
            }
            ti = ti + 1
        }
        if total >? 4194304 { target = total // jobs }
    }
    let emitted:int = 0
    let last_split:int = 0
    let fi:int = 0
    loop fi <? nf {
        let lid:int = vec_get(x86_function_ids fi)
        if (not x86_have_reachable) or intset_has(x86_reachable_fn_label_ids lid) {
            if target >? 0 and emitted - last_split >=? target and vec_len(x86_chunk_offsets) + 1 <? jobs {
                vec_push(x86_chunk_offsets bb_len(out))
                last_split = emitted
            }
            let lines:int = vec_get(x86_function_codes fi)
            let ll:int = vec_len(lines)
            let li:int = 0
            loop li <? ll {
                let line:int = vec_get(lines li)
                bb_push_str(out line)
                bb_push_byte(out 10)
                emitted = emitted + str_len(line) + 1
                li = li + 1
            }
        }
        fi = fi + 1
    }
    bb_push_byte(out 10)
    bb_push_str(out ".data\n")
    bb_push_str(out ".hidden __dso_handle\n")
    bb_push_str(out ".weak __dso_handle\n")
    bb_push_str(out "__dso_handle:\n")
    bb_push_str(out "    .quad 0\n")
    let nd:int = vec_len(x86_data)
    let di:int = 0
    loop di <? nd {
        bb_push_str(out vec_get(x86_data di))
        bb_push_byte(out 10)
        di = di + 1
    }
    bb_push_byte(out 10)
    x86_debug_info_sections(out)
    bb_push_str(out ".section .note.GNU-stack,\"\",@progbits\n")
    bb_push_byte(out 10)
    return bb_finalize_as_string(out)
}

# ----------------------------------------------------------------------------
# Data section
# ----------------------------------------------------------------------------

let x86_intern_string = (data:int len:int):>int => {
    let label_id:int = x86_next_label
    let label:int = x86_new_label("str")
    intmap_put(x86_string_labels label_id label)

    let bb:int = bb_new(64 + str_len(label))
    bb_push_str(bb ".section .data.")
    bb_push_str(bb label)
    bb_push_str(bb ",\"aw\",@progbits")
    vec_push(x86_data bb_finalize_as_string(bb))
    x86_emit_data_label(label)
    let bb2:int = bb_new(32)
    bb_push_str(bb2 "    .quad ")
    bb_push_int(bb2 len)
    vec_push(x86_data bb_finalize_as_string(bb2))
    if len >? 0 {
        let bb3:int = bb_new(8 + len * 4)
        bb_push_str(bb3 "    .byte ")
        let i:int = 0
        loop i <? len {
            if i >? 0 { bb_push_str(bb3 ", ") }
            bb_push_int(bb3 __load_u8__(data + i))
            i = i + 1
        }
        vec_push(x86_data bb_finalize_as_string(bb3))
    }
    return label_id
}

let x86_intern_words = (elements_vec:int kinds_vec:int):>int => {
    let label_id:int = x86_next_label
    let label:int = x86_new_label("static")
    intmap_put(x86_static_labels label_id label)
    # a table of symbols is retained (SHF_GNU_RETAIN) even when nothing in
    # the program reads it: it may exist for something outside the program
    # (a debugger's formatters), and the linker would otherwise drop the
    # table and the functions only it names
    let has_symbol:int = false
    let e:int = 0
    loop e <? vec_len(elements_vec) {
        if vec_get(kinds_vec e) not=? 1 { has_symbol = true }
        e = e + 1
    }
    let bb:int = bb_new(64 + str_len(label))
    bb_push_str(bb ".section .data.")
    bb_push_str(bb label)
    if has_symbol {
        bb_push_str(bb ",\"awR\",@progbits")
    } else {
        bb_push_str(bb ",\"aw\",@progbits")
    }
    vec_push(x86_data bb_finalize_as_string(bb))
    vec_push(x86_data "    .balign 8")
    x86_emit_data_label(label)
    let i:int = 0
    loop i <? vec_len(elements_vec) {
        let line:int = bb_new(32)
        bb_push_str(line "    .quad ")
        if vec_get(kinds_vec i) =? 1 {
            bb_push_int(line vec_get(elements_vec i))
        } else {
            bb_push_str(line vec_get(elements_vec i))
        }
        vec_push(x86_data bb_finalize_as_string(line))
        i = i + 1
    }
    return label_id
}

let x86_define_global = (name:int kind:int value:int):>int => {
    let label_id:int = x86_next_label
    let label:int = 0
    if name =? 0 {
        label = x86_new_label("global")
    } else {
        label = x86_str(name)
        x86_next_label = x86_next_label + 1
    }
    intmap_put(x86_global_labels label_id label)
    let bb:int = bb_new(64 + str_len(label))
    bb_push_str(bb ".section .data.")
    bb_push_str(bb label)
    bb_push_str(bb ",\"aw\",@progbits")
    vec_push(x86_data bb_finalize_as_string(bb))
    x86_emit_data_label(label)
    let line:int = bb_new(32)
    bb_push_str(line "    .quad ")
    if kind =? 1 {
        bb_push_int(line value)
    } else {
        bb_push_str(line value)
    }
    vec_push(x86_data bb_finalize_as_string(line))
    return label_id
}

let x86_declare_extern_global = (name:int):>int => {
    let label_id:int = x86_next_label
    x86_next_label = x86_next_label + 1
    let label:int = x86_str(name)
    intmap_put(x86_global_labels label_id label)
    set_add_str(x86_extern_symbols label)
    return label_id
}

let x86_intern_static = (size:int):>int => {
    let label_id:int = x86_next_label
    let label:int = x86_new_label("static")
    intmap_put(x86_static_labels label_id label)
    let bb:int = bb_new(64 + str_len(label))
    bb_push_str(bb ".section .bss.")
    bb_push_str(bb label)
    bb_push_str(bb ",\"aw\",@nobits")
    vec_push(x86_data bb_finalize_as_string(bb))
    x86_emit_data_label(label)
    if size >? 0 {
        let line:int = bb_new(32)
        bb_push_str(line "    .zero ")
        bb_push_int(line size)
        vec_push(x86_data bb_finalize_as_string(line))
    }
    return label_id
}

let x86_push_string_ref = (label_id:int):>void => {
    x86_flush()
    let label:int = intmap_get(x86_string_labels label_id)
    let bb:int = bb_new(48)
    bb_push_str(bb "    leaq ")
    bb_push_str(bb label)
    bb_push_str(bb "+8(%rip), %rax")
    vec_push(x86_current_fn_code bb_finalize_as_string(bb))
    return void
}

let x86_push_global_ref = (label_id:int):>void => {
    x86_flush()
    let label:int = intmap_get(x86_global_labels label_id)
    let bb:int = bb_new(48)
    bb_push_str(bb "    leaq ")
    bb_push_str(bb label)
    bb_push_str(bb "(%rip), %rax")
    vec_push(x86_current_fn_code bb_finalize_as_string(bb))
    return void
}

let x86_push_static_ref = (label_id:int):>void => {
    x86_flush()
    let label:int = intmap_get(x86_static_labels label_id)
    let bb:int = bb_new(48)
    bb_push_str(bb "    leaq ")
    bb_push_str(bb label)
    bb_push_str(bb "(%rip), %rax")
    vec_push(x86_current_fn_code bb_finalize_as_string(bb))
    return void
}

let x86_load_global = (label_id:int):>void => {
    x86_flush()
    let label:int = intmap_get(x86_global_labels label_id)
    let bb:int = bb_new(48)
    bb_push_str(bb "    movq ")
    bb_push_str(bb label)
    bb_push_str(bb "(%rip), %rax")
    vec_push(x86_current_fn_code bb_finalize_as_string(bb))
    return void
}

let x86_store_global = (label_id:int):>void => {
    x86_flush()
    let label:int = intmap_get(x86_global_labels label_id)
    let bb:int = bb_new(48)
    bb_push_str(bb "    movq %rax, ")
    bb_push_str(bb label)
    bb_push_str(bb "(%rip)")
    vec_push(x86_current_fn_code bb_finalize_as_string(bb))
    return void
}

let x86_function_ref = (label_id:int):>int => {
    return intmap_get(x86_fn_labels label_id)
}

let x86_string_ref = (label_id:int):>int => {
    let label:int = intmap_get(x86_string_labels label_id)
    let bb:int = bb_new(str_len(label) + 4)
    bb_push_str(bb label)
    bb_push_str(bb "+8")
    return bb_finalize_as_string(bb)
}

let x86_static_ref = (label_id:int):>int => {
    return intmap_get(x86_static_labels label_id)
}

# ----------------------------------------------------------------------------
# Functions
# ----------------------------------------------------------------------------

let x86_declare_function = (name:int num_params:int):>int => {
    let label_id:int = x86_next_label
    let label:int = 0
    if name =? 0 {
        label = x86_new_label("fn")
    } else {
        label = x86_str(name)
        x86_next_label = x86_next_label + 1
    }
    intmap_put(x86_fn_labels label_id label)
    return label_id
}

let x86_bind_extern_function = (label_id:int name:int):>void => {
    let label:int = x86_str(name)
    intmap_put(x86_fn_labels label_id label)
    set_add_str(x86_extern_symbols label)
    return void
}

let x86_declare_extern_function = (name:int num_params:int):>int => {
    let label_id:int = x86_declare_function(name num_params)
    set_add_str(x86_extern_symbols intmap_get(x86_fn_labels label_id))
    return label_id
}

let x86_begin_function = (label_id:int name:int param_count:int is_main:int):>void => {
    let label:int = intmap_get(x86_fn_labels label_id)
    x86_saved_depth = 0
    x86_spilled_depth = 0
    x86_min_slot_offset = 0
    x86_pending_kind = XP_NONE
    la_begin_function()

    let code:int = vec_new(64)
    vec_push(x86_function_ids label_id)
    vec_push(x86_function_codes code)
    x86_current_fn_code = code

    let bb:int = bb_new(64 + str_len(label))
    bb_push_str(bb ".section .text.")
    bb_push_str(bb label)
    bb_push_str(bb ",\"ax\",@progbits")
    vec_push(x86_current_fn_code bb_finalize_as_string(bb))
    if is_main {
        vec_push(x86_current_fn_code x86_globl_line("__main__"))
        x86_emit_label_str("__main__")
    }
    vec_push(x86_current_fn_code x86_globl_line(label))
    x86_emit_label_str(label)
    if be_debug_info {
        let endbb:int = bb_new(str_len(label) + 8)
        bb_push_str(endbb ".L")
        bb_push_str(endbb label)
        bb_push_str(endbb "_end")
        let f:int = arena_alloc(DF_SIZE)
        __store__(name f + DF_NAME)
        __store__(label f + DF_LABEL)
        __store__(bb_finalize_as_string(endbb) f + DF_END)
        __store__(x86_debug_scope_new(label __load__(f + DF_END)) f + DF_SCOPE)
        __store__(label_id f + DF_LABEL_ID)
        vec_push(x86_debug_functions f)
        x86_debug_function = f
        x86_debug_scope = __load__(f + DF_SCOPE)
        vec_set_len(x86_debug_frames 0)
    }
    x86_emit_indented("pushq %rbp")
    x86_emit_indented("movq %rsp, %rbp")
    x86_frame_subtract_index = vec_len(x86_current_fn_code)
    x86_emit_indented("# frame setup")
    x86_emit_indented("movq %rbx, -8(%rbp)")
    x86_emit_indented("movq %r12, -16(%rbp)")
    x86_emit_indented("movq %r13, -24(%rbp)")
    x86_emit_indented("movq %r14, -32(%rbp)")
    x86_emit_indented("movq %r15, -40(%rbp)")

    vec_set_len(x86_param_slots 0)
    x86_stack_offset = -48

    let i:int = 0
    loop i <? param_count {
        let slot:int = x86_stack_offset
        vec_push(x86_param_slots slot)
        x86_note_slot(slot)
        la_note_alloc(x86_slot_key(slot) vec_len(x86_current_fn_code))
        if i <? 6 {
            x86_emit_slot_store(x86_arg_reg(i) slot)
        } else {
            let caller_off:int = 16 + (i - 6) * 8
            x86_emit_op_mem_r("movq" caller_off "%rbp" "%rax")
            x86_emit_slot_store("%rax" slot)
        }
        x86_stack_offset = x86_stack_offset - 8
        i = i + 1
    }
    # Incoming argument registers stay live through the last parameter store:
    # an interval that crosses it may not take one of them.
    if param_count >? 0 { la_note_clobber(vec_len(x86_current_fn_code) - 1) }
    let ebb:int = bb_new(str_len(label) + 16)
    bb_push_str(ebb ".L")
    bb_push_str(ebb label)
    bb_push_str(ebb "_epilogue")
    x86_current_fn_epilogue = bb_finalize_as_string(ebb)
    return void
}

let x86_end_function = ():>void => {
    x86_flush()
    x86_end_debug_function()
    x86_allocate_locals()
    let fb:int = x86_frame_bytes()
    let bb:int = bb_new(32)
    bb_push_str(bb "    subq $")
    bb_push_int(bb fb)
    bb_push_str(bb ", %rsp")
    vec_set(x86_current_fn_code x86_frame_subtract_index bb_finalize_as_string(bb))
    x86_emit_label_str(x86_current_fn_epilogue)
    x86_emit_indented("movq -8(%rbp), %rbx")
    x86_emit_indented("movq -16(%rbp), %r12")
    x86_emit_indented("movq -24(%rbp), %r13")
    x86_emit_indented("movq -32(%rbp), %r14")
    x86_emit_indented("movq -40(%rbp), %r15")
    x86_emit_indented("movq %rbp, %rsp")
    x86_emit_indented("popq %rbp")
    x86_emit_indented("ret")
    if x86_debug_function not=? 0 {
        x86_emit_label_str(__load__(x86_debug_function + DF_END))
    }
    x86_current_fn_code = 0
    return void
}

let x86_load_param = (index:int):>void => {
    x86_load_local(vec_get(x86_param_slots index))
    return void
}

let x86_slot_key = (slot:int):>int => {
    return (0 - slot - X86_FIXED_FRAME_BYTES) >> 3
}

let x86_slot_operand = (slot:int):>int => {
    let bb:int = bb_new(16)
    bb_push_int(bb slot)
    bb_push_str(bb "(%rbp)")
    return bb_finalize_as_string(bb)
}

# Emit one instruction that reads or writes a local: `prefix` + operand +
# `suffix`, where the operand is the frame slot now and the slot's register
# after allocation. Debug builds keep the frame slot.
let x86_emit_slot_access = (slot:int prefix:int suffix:int):>void => {
    let bb:int = bb_new(str_len(prefix) + str_len(suffix) + 16)
    bb_push_str(bb prefix)
    bb_push_int(bb slot)
    bb_push_str(bb "(%rbp)")
    bb_push_str(bb suffix)
    x86_emit_two_form(slot bb_finalize_as_string(bb) prefix suffix)
    return void
}

# Emit `memory_line` (which may hold two instructions) for a slot that is in
# memory; after allocation the line becomes `prefix` + register + `suffix`.
let x86_emit_two_form = (slot:int memory_line:int prefix:int suffix:int):>void => {
    if not be_debug_info {
        la_note_site(vec_len(x86_current_fn_code) x86_slot_key(slot) prefix suffix)
    }
    vec_push(x86_current_fn_code memory_line)
    return void
}

let x86_slot_text = (slot:int):>int => {
    let bb:int = bb_new(16)
    bb_push_int(bb slot)
    bb_push_str(bb "(%rbp)")
    return bb_finalize_as_string(bb)
}

let x86_reg32 = (reg:int):>int => {
    if str_eq(reg "%rax") { return "%eax" }
    if str_eq(reg "%rbx") { return "%ebx" }
    let bb:int = bb_new(8)
    bb_push_str(bb reg)
    bb_push_str(bb "d")
    return bb_finalize_as_string(bb)
}

let x86_load_mnemonic = (width:int signed:int):>int => {
    if width =? 64 { return "movq" }
    if width =? 32 { if signed { return "movslq" } return "movl" }
    if width =? 16 { if signed { return "movswq" } return "movzwq" }
    if signed { return "movsbq" }
    return "movzbq"
}

let x86_store_mnemonic = (width:int):>int => {
    if width =? 64 { return "movq" }
    if width =? 32 { return "movl" }
    if width =? 16 { return "movw" }
    return "movb"
}

# "    op $value, " for an immediate first operand.
let x86_imm_prefix = (op:int value:int):>int => {
    let bb:int = bb_new(32)
    bb_push_str(bb "    ")
    bb_push_str(bb op)
    bb_push_str(bb " $")
    bb_push_int(bb value)
    bb_push_str(bb ", ")
    return bb_finalize_as_string(bb)
}

# Emit `op X, tail` where X is the pending memory operand: `off(%rax)`, or the
# local's slot loaded into %rax first (one instruction after allocation).
let x86_emit_pending_mem_op = (op:int tail:int):>void => {
    let bb:int = bb_new(64)
    if x86_pending_address not=? 0 {
        bb_push_str(bb "    ")
        bb_push_str(bb op)
        bb_push_byte(bb 32)
        bb_push_str(bb x86_pending_address)
        bb_push_str(bb tail)
        vec_push(x86_current_fn_code bb_finalize_as_string(bb))
        return void
    }
    bb_push_str(bb "    movq ")
    bb_push_str(bb x86_slot_text(x86_pending_slot))
    bb_push_str(bb ", %rax\n    ")
    bb_push_str(bb op)
    bb_push_byte(bb 32)
    bb_push_int(bb x86_pending_offset)
    bb_push_str(bb "(%rax)")
    bb_push_str(bb tail)
    let prefix:int = bb_new(32)
    bb_push_str(prefix "    ")
    bb_push_str(prefix op)
    bb_push_byte(prefix 32)
    bb_push_int(prefix x86_pending_offset)
    bb_push_byte(prefix 40)
    let suffix:int = bb_new(16 + str_len(tail))
    bb_push_byte(suffix 41)
    bb_push_str(suffix tail)
    x86_emit_two_form(x86_pending_slot bb_finalize_as_string(bb) bb_finalize_as_string(prefix) bb_finalize_as_string(suffix))
    return void
}

# Perform the pending load into `dst`.
let x86_emit_pending_load = (dst:int):>void => {
    let op:int = x86_load_mnemonic(x86_pending_width x86_pending_signed)
    let target:int = dst
    if str_eq(op "movl") { target = x86_reg32(dst) }
    let tail:int = bb_new(16)
    bb_push_str(tail ", ")
    bb_push_str(tail target)
    if x86_pending_address =? 0 and not str_eq(dst "%rax") {
        # The destination doubles as the base register while the local is in memory.
        let bb:int = bb_new(64)
        bb_push_str(bb "    movq ")
        bb_push_str(bb x86_slot_text(x86_pending_slot))
        bb_push_str(bb ", ")
        bb_push_str(bb dst)
        bb_push_str(bb "\n    ")
        bb_push_str(bb op)
        bb_push_byte(bb 32)
        bb_push_int(bb x86_pending_offset)
        bb_push_byte(bb 40)
        bb_push_str(bb dst)
        bb_push_byte(bb 41)
        bb_push_str(bb ", ")
        bb_push_str(bb target)
        let prefix:int = bb_new(32)
        bb_push_str(prefix "    ")
        bb_push_str(prefix op)
        bb_push_byte(prefix 32)
        bb_push_int(prefix x86_pending_offset)
        bb_push_byte(prefix 40)
        let suffix:int = bb_new(16)
        bb_push_byte(suffix 41)
        bb_push_str(suffix ", ")
        bb_push_str(suffix target)
        x86_emit_two_form(x86_pending_slot bb_finalize_as_string(bb) bb_finalize_as_string(prefix) bb_finalize_as_string(suffix))
        return void
    }
    x86_emit_pending_mem_op(op bb_finalize_as_string(tail))
    return void
}

let x86_emit_slot_load = (slot:int register:int):>void => {
    let bb:int = bb_new(16)
    bb_push_str(bb ", ")
    bb_push_str(bb register)
    x86_emit_slot_access(slot "    movq " bb_finalize_as_string(bb))
    return void
}

let x86_emit_slot_store = (register:int slot:int):>void => {
    let bb:int = bb_new(16)
    bb_push_str(bb "    movq ")
    bb_push_str(bb register)
    bb_push_str(bb ", ")
    x86_emit_slot_access(slot bb_finalize_as_string(bb) "")
    return void
}

let x86_invert_cc = (cc:int):>int => {
    if str_eq(cc "e") { return "ne" }
    if str_eq(cc "ne") { return "e" }
    if str_eq(cc "l") { return "ge" }
    if str_eq(cc "ge") { return "l" }
    if str_eq(cc "g") { return "le" }
    if str_eq(cc "le") { return "g" }
    if str_eq(cc "a") { return "be" }
    if str_eq(cc "be") { return "a" }
    if str_eq(cc "b") { return "ae" }
    return "b"
}

# Materialize a pending value into %rax.
let x86_flush = ():>void => {
    let kind:int = x86_pending_kind
    x86_pending_kind = XP_NONE
    if kind =? XP_CC {
        x86_emit_bool_from_cc(x86_pending_cc)
    } else if kind =? XP_SLOT {
        x86_emit_slot_load(x86_pending_slot "%rax")
        if x86_pending_offset not=? 0 {
            x86_emit_op_imm("addq" x86_pending_offset "%rax")
            x86_address_code = x86_current_fn_code
            x86_address_length = vec_len(x86_current_fn_code)
            x86_address_offset = x86_pending_offset
        }
    } else if kind =? XP_CONST {
        let bb:int = bb_new(32)
        bb_push_str(bb "    movq $")
        bb_push_int(bb x86_pending_value)
        bb_push_str(bb ", %rax")
        vec_push(x86_current_fn_code bb_finalize_as_string(bb))
    } else if kind =? XP_MEM {
        x86_emit_pending_load("%rax")
    }
    return void
}

# Consume a pending condition as a branch: jump when the condition holds
# (`when_true`) or fails. Returns false when no condition is pending.
let x86_branch_pending = (label:int when_true:int):>int => {
    if x86_pending_kind not=? XP_CC { return false }
    let cc:int = x86_pending_cc
    x86_pending_kind = XP_NONE
    if not when_true { cc = x86_invert_cc(cc) }
    let bb:int = bb_new(8)
    bb_push_str(bb "j")
    bb_push_str(bb cc)
    x86_emit_jmp(bb_finalize_as_string(bb) label)
    return true
}

# Debug builds retain their existing stack locations; frame sizes and
# __alloca__ alignment do not change either way.
let x86_allocate_locals = ():>void => {
    if be_debug_info {return void}
    la_assign(x86_callee_local_regs x86_caller_local_regs)
    la_rewrite(x86_current_fn_code)
    return void
}

let x86_alloc_local = ():>int => {
    x86_flush()
    let slot:int = x86_stack_offset
    x86_stack_offset = x86_stack_offset - 8
    x86_note_slot(slot)
    la_note_alloc(x86_slot_key(slot) vec_len(x86_current_fn_code))
    return slot
}

let x86_load_local = (slot:int):>void => {
    x86_flush()
    x86_pending_kind = XP_SLOT
    x86_pending_slot = slot
    x86_pending_offset = 0
    return void
}

let x86_store_local = (slot:int):>void => {
    if x86_pending_kind =? XP_CONST and x86_fits_imm32(x86_pending_value) {
        x86_pending_kind = XP_NONE
        x86_emit_slot_access(slot x86_imm_prefix("movq" x86_pending_value) "")
        return void
    }
    x86_flush()
    x86_emit_slot_store("%rax" slot)
    return void
}

let x86_fits_imm32 = (value:int):>int => {
    return value >=? -2147483648 and value <=? 2147483647
}

# ----------------------------------------------------------------------------
# Value stack
# ----------------------------------------------------------------------------

let x86_push_const_i64 = (value:int):>void => {
    x86_flush()
    x86_pending_kind = XP_CONST
    x86_pending_value = value
    return void
}

let x86_push_void = ():>void => {
    x86_flush()
    x86_emit_indented("xorq %rax, %rax")
    return void
}

let x86_push_fn_ref = (label_id:int):>void => {
    x86_flush()
    let label:int = intmap_get(x86_fn_labels label_id)
    let bb:int = bb_new(48)
    bb_push_str(bb "    leaq ")
    bb_push_str(bb label)
    bb_push_str(bb "(%rip), %rax")
    vec_push(x86_current_fn_code bb_finalize_as_string(bb))
    return void
}

# A discarded value that was never materialized costs nothing.
# A discarded value that was never materialized costs nothing.
let x86_pop_value = ():>void => {
    x86_pending_kind = XP_NONE
    return void
}

let x86_save_value = ():>void => {
    let kind:int = x86_pending_kind
    if kind >=? XP_SLOT and x86_spilled_depth =? 0 and x86_saved_depth <? 3 {
        let cache:int = x86_value_cache_reg(x86_saved_depth)
        x86_pending_kind = XP_NONE
        if kind =? XP_SLOT {
            if x86_pending_offset =? 0 {
                x86_emit_slot_load(x86_pending_slot cache)
            } else {
                let bb:int = bb_new(64)
                bb_push_str(bb "    movq ")
                bb_push_str(bb x86_slot_text(x86_pending_slot))
                bb_push_str(bb ", ")
                bb_push_str(bb cache)
                bb_push_str(bb "\n    addq $")
                bb_push_int(bb x86_pending_offset)
                bb_push_str(bb ", ")
                bb_push_str(bb cache)
                let prefix:int = bb_new(24)
                bb_push_str(prefix "    leaq ")
                bb_push_int(prefix x86_pending_offset)
                bb_push_byte(prefix 40)
                let suffix:int = bb_new(16)
                bb_push_str(suffix "), ")
                bb_push_str(suffix cache)
                x86_emit_two_form(x86_pending_slot bb_finalize_as_string(bb) bb_finalize_as_string(prefix) bb_finalize_as_string(suffix))
            }
        } else if kind =? XP_CONST {
            let bb:int = bb_new(32)
            bb_push_str(bb "    movq $")
            bb_push_int(bb x86_pending_value)
            bb_push_str(bb ", ")
            bb_push_str(bb cache)
            vec_push(x86_current_fn_code bb_finalize_as_string(bb))
        } else {
            x86_emit_pending_load(cache)
        }
        x86_saved_depth = x86_saved_depth + 1
        return void
    }
    x86_flush()
    x86_save_reg("%rax")
    return void
}

let x86_restore_value = ():>void => {
    x86_flush()
    x86_pop_saved_into("%rax")
    return void
}

# ----------------------------------------------------------------------------
# Operators
# ----------------------------------------------------------------------------

let x86_unary_op = (op_kind:int):>void => {
    # A pending condition is exactly -1 or 0, so `not` is its inverse.
    if op_kind =? TK_NOT and x86_pending_kind =? XP_CC {
        x86_pending_cc = x86_invert_cc(x86_pending_cc)
        return void
    }
    if op_kind =? TK_MINUS and x86_pending_kind =? XP_CONST {
        x86_pending_value = 0 - x86_pending_value
        return void
    }
    x86_flush()
    if op_kind =? TK_MINUS {
        x86_emit_indented("negq %rax")
    } else if op_kind =? TK_NOT {
        x86_emit_indented("notq %rax")
    }
    return void
}

let x86_emit_signed_idiv = ():>void => {
    let div_zero:int = x86_new_label("div_zero")
    let done:int = x86_new_label("div_done")
    let do_idiv:int = x86_new_label("div_idiv")
    x86_emit_indented("testq %rcx, %rcx")
    x86_emit_jmp("jz" div_zero)
    x86_emit_indented("movabsq $0x8000000000000000, %rdx")
    x86_emit_indented("cmpq %rdx, %rax")
    x86_emit_jmp("jne" do_idiv)
    x86_emit_indented("cmpq $-1, %rcx")
    x86_emit_jmp("jne" do_idiv)
    x86_emit_jmp("jmp" done)
    x86_emit_label_str(do_idiv)
    x86_emit_indented("cqto")
    x86_emit_indented("idivq %rcx")
    x86_emit_jmp("jmp" done)
    x86_emit_label_str(div_zero)
    x86_emit_indented("movq $-1, %rax")
    x86_emit_label_str(done)
    return void
}

let x86_emit_signed_mod = ():>void => {
    let mod_zero:int = x86_new_label("mod_zero")
    let done:int = x86_new_label("mod_done")
    let do_idiv:int = x86_new_label("mod_idiv")
    x86_emit_indented("testq %rcx, %rcx")
    x86_emit_jmp("jz" mod_zero)
    x86_emit_indented("movabsq $0x8000000000000000, %rdx")
    x86_emit_indented("cmpq %rdx, %rax")
    x86_emit_jmp("jne" do_idiv)
    x86_emit_indented("cmpq $-1, %rcx")
    x86_emit_jmp("jne" do_idiv)
    x86_emit_indented("xorq %rax, %rax")
    x86_emit_jmp("jmp" done)
    x86_emit_label_str(do_idiv)
    x86_emit_indented("cqto")
    x86_emit_indented("idivq %rcx")
    x86_emit_indented("movq %rdx, %rax")
    x86_emit_jmp("jmp" done)
    x86_emit_label_str(mod_zero)
    x86_emit_label_str(done)
    return void
}

# Compare `left` with the visible value and leave the condition pending.
# Compare `left` with the visible value and leave the condition pending.
let x86_compare_pending = (cc:int left:int):>void => {
    let kind:int = x86_pending_kind
    let tail:int = bb_new(16)
    bb_push_str(tail ", ")
    bb_push_str(tail left)
    if kind =? XP_SLOT and x86_pending_offset =? 0 {
        x86_pending_kind = XP_NONE
        x86_emit_slot_access(x86_pending_slot "    cmpq " bb_finalize_as_string(tail))
    } else if kind =? XP_CONST and x86_fits_imm32(x86_pending_value) {
        x86_pending_kind = XP_NONE
        x86_emit_op_imm("cmpq" x86_pending_value left)
    } else if kind =? XP_MEM and x86_pending_width =? 64 {
        x86_pending_kind = XP_NONE
        x86_emit_pending_mem_op("cmpq" bb_finalize_as_string(tail))
    } else {
        x86_flush()
        x86_emit_op_2("cmpq" "%rax" left)
    }
    x86_pending_kind = XP_CC
    x86_pending_cc = cc
    return void
}

let x86_emit_bool_from_cc = (cc:int):>void => {
    let bb:int = bb_new(16)
    bb_push_str(bb "    set")
    bb_push_str(bb cc)
    bb_push_str(bb " %al")
    vec_push(x86_current_fn_code bb_finalize_as_string(bb))
    x86_emit_indented("movzbq %al, %rax")
    x86_emit_indented("negq %rax")
    return void
}

let x86_binary_immediate = (op_kind:int value:int):>void => {
    # µDewy words already use signed 64-bit storage here. Arithmetic immediates
    # sign-extend 32 bits; shifts use only the low six bits of the count.
    let cc:int = 0
    if op_kind =? TK_EQ { cc = "e" }
    else if op_kind =? TK_NOT_EQ { cc = "ne" }
    else if op_kind =? TK_GT { cc = "g" }
    else if op_kind =? TK_LT { cc = "l" }
    else if op_kind =? TK_GT_EQ { cc = "ge" }
    else if op_kind =? TK_LT_EQ { cc = "le" }
    if cc and x86_fits_imm32(value) {
        let kind:int = x86_pending_kind
        if kind =? XP_SLOT and x86_pending_offset =? 0 {
            x86_pending_kind = XP_NONE
            x86_emit_slot_access(x86_pending_slot x86_imm_prefix("cmpq" value) "")
        } else if kind =? XP_MEM and x86_pending_width =? 64 {
            x86_pending_kind = XP_NONE
            let op:int = bb_new(24)
            bb_push_str(op "cmpq $")
            bb_push_int(op value)
            bb_push_byte(op 44)
            x86_emit_pending_mem_op(bb_finalize_as_string(op) "")
        } else {
            x86_flush()
            x86_emit_op_imm("cmpq" value "%rax")
        }
        x86_pending_kind = XP_CC
        x86_pending_cc = cc
        return void
    }
    # A constant offset joins a pending local: the address folds into whatever
    # consumes it.
    if x86_pending_kind =? XP_SLOT and (op_kind =? TK_PLUS or op_kind =? TK_MINUS) and x86_fits_imm32(value) {
        let offset:int = x86_pending_offset + value
        if op_kind =? TK_MINUS { offset = x86_pending_offset - value }
        if x86_fits_imm32(offset) {
            x86_pending_offset = offset
            return void
        }
    }
    x86_flush()
    if op_kind =? TK_LEFT_SHIFT {
        x86_emit_op_imm("shlq" value and 63 "%rax")
        return void
    }
    if op_kind =? TK_RIGHT_SHIFT {
        x86_emit_op_imm("shrq" value and 63 "%rax")
        return void
    }
    if value >=? -2147483648 and value <=? 2147483647 {
        let op:int = 0
        if op_kind =? TK_PLUS { op = "addq" }
        else if op_kind =? TK_MINUS { op = "subq" }
        else if op_kind =? TK_MUL { op = "imulq" }
        else if op_kind =? TK_AND { op = "andq" }
        else if op_kind =? TK_OR { op = "orq" }
        else if op_kind =? TK_XOR { op = "xorq" }
        if op {
            x86_emit_op_imm(op value "%rax")
            if op_kind =? TK_PLUS or op_kind =? TK_MINUS {
                let offset:int = value
                if op_kind =? TK_MINUS { offset = 0 - value }
                if offset >=? -2147483648 and offset <=? 2147483647 {
                    x86_address_code = x86_current_fn_code
                    x86_address_length = vec_len(x86_current_fn_code)
                    x86_address_offset = offset
                }
            }
            return void
        }
    }
    be_default_binary_immediate(op_kind value)
    return void
}

let x86_binary_op = (op_kind:int):>void => {
    let cc:int = 0
    if op_kind =? TK_EQ { cc = "e" }
    else if op_kind =? TK_NOT_EQ { cc = "ne" }
    else if op_kind =? TK_GT { cc = "g" }
    else if op_kind =? TK_LT { cc = "l" }
    else if op_kind =? TK_GT_EQ { cc = "ge" }
    else if op_kind =? TK_LT_EQ { cc = "le" }
    if x86_pending_kind =? XP_CC { x86_flush() }
    if cc {
        x86_compare_pending(cc x86_pop_saved_operand(64))
        return void
    }
    if op_kind =? TK_MINUS and x86_pending_kind =? XP_SLOT and x86_pending_offset =? 0 {
        x86_pending_kind = XP_NONE
        let left:int = x86_pop_saved_operand(64)
        let bb:int = bb_new(16)
        bb_push_str(bb ", ")
        bb_push_str(bb left)
        x86_emit_slot_access(x86_pending_slot "    subq " bb_finalize_as_string(bb))
        x86_emit_op_2("movq" left "%rax")
        return void
    }
    x86_flush()
    # Division and shifts still need the fixed hardware operand registers.
    if op_kind =? TK_IDIV or op_kind =? TK_MOD or op_kind =? TK_LEFT_SHIFT or op_kind =? TK_RIGHT_SHIFT {
        x86_emit_op_2("movq" "%rax" "%rcx")
        x86_pop_saved_into("%rax")
        if op_kind =? TK_IDIV { x86_emit_signed_idiv() }
        else if op_kind =? TK_MOD { x86_emit_signed_mod() }
        else if op_kind =? TK_LEFT_SHIFT { x86_emit_op_2("shlq" "%cl" "%rax") }
        else { x86_emit_op_2("shrq" "%cl" "%rax") }
        return void
    }
    let left:int = x86_pop_saved_operand(64)
    if op_kind =? TK_PLUS { x86_emit_op_2("addq" left "%rax") }
    else if op_kind =? TK_MINUS {
        x86_emit_op_2("subq" "%rax" left)
        x86_emit_op_2("movq" left "%rax")
    }
    else if op_kind =? TK_MUL { x86_emit_op_2("imulq" left "%rax") }
    else if op_kind =? TK_AND { x86_emit_op_2("andq" left "%rax") }
    else if op_kind =? TK_OR { x86_emit_op_2("orq" left "%rax") }
    else if op_kind =? TK_XOR { x86_emit_op_2("xorq" left "%rax") }
    return void
}

# ----------------------------------------------------------------------------
# Memory ops
# ----------------------------------------------------------------------------

let x86_memory_address = ():>int => {
    let code:int = x86_address_code
    x86_address_code = 0
    # Conditions short-circuit: never read a missing code vector.
    if code not=? 0 and code =? x86_current_fn_code and vec_len(code) =? x86_address_length {
        vec_pop(code)
        let bb:int = bb_new(32)
        bb_push_int(bb x86_address_offset)
        bb_push_str(bb "(%rax)")
        return bb_finalize_as_string(bb)
    }
    return "(%rax)"
}

let x86_load_mem = (width:int signed:int):>void => {
    if x86_pending_kind =? XP_SLOT {
        x86_pending_address = 0
    } else {
        x86_flush()
        x86_pending_address = x86_memory_address()
    }
    x86_pending_kind = XP_MEM
    x86_pending_width = width
    x86_pending_signed = signed
    return void
}

let x86_store_mem = (width:int):>void => {
    if x86_pending_kind =? XP_SLOT {
        x86_pending_kind = XP_NONE
        # The store goes through the local's register once allocated; %rax is
        # free to hold the address while it is in memory.
        x86_pending_address = 0
        let value:int = x86_pop_saved_operand(width)
        let head:int = bb_new(24)
        bb_push_str(head "    ")
        bb_push_str(head x86_store_mnemonic(width))
        bb_push_byte(head 32)
        bb_push_str(head value)
        bb_push_str(head ", ")
        let store:int = bb_finalize_as_string(head)
        let bb:int = bb_new(64)
        bb_push_str(bb "    movq ")
        bb_push_str(bb x86_slot_text(x86_pending_slot))
        bb_push_str(bb ", %rax\n")
        bb_push_str(bb store)
        bb_push_int(bb x86_pending_offset)
        bb_push_str(bb "(%rax)")
        let reg_prefix:int = bb_new(32)
        bb_push_str(reg_prefix store)
        bb_push_int(reg_prefix x86_pending_offset)
        bb_push_byte(reg_prefix 40)
        x86_emit_two_form(x86_pending_slot bb_finalize_as_string(bb) bb_finalize_as_string(reg_prefix) ")")
        x86_emit_indented("xorq %rax, %rax")
        return void
    }
    x86_flush()
    # Capture the address before a spilled saved value emits its pop.
    let address:int = x86_memory_address()
    let value:int = x86_pop_saved_operand(width)
    x86_emit_op_2(x86_store_mnemonic(width) value address)
    x86_emit_indented("xorq %rax, %rax")
    return void
}

let x86_signed_shr = ():>void => {
    x86_emit_op_2("movq" "%rax" "%rcx")
    x86_pop_saved_into("%rax")
    x86_emit_op_2("sarq" "%cl" "%rax")
    return void
}

let x86_emit_unsigned_idiv = ():>void => {
    let div_zero:int = x86_new_label("udiv_zero")
    let done:int = x86_new_label("udiv_done")
    x86_emit_indented("testq %rcx, %rcx")
    x86_emit_jmp("jz" div_zero)
    x86_emit_indented("xorq %rdx, %rdx")
    x86_emit_indented("divq %rcx")
    x86_emit_jmp("jmp" done)
    x86_emit_label_str(div_zero)
    x86_emit_indented("movq $-1, %rax")
    x86_emit_label_str(done)
    return void
}

let x86_emit_unsigned_mod = ():>void => {
    let mod_zero:int = x86_new_label("umod_zero")
    let done:int = x86_new_label("umod_done")
    x86_emit_indented("testq %rcx, %rcx")
    x86_emit_jmp("jz" mod_zero)
    x86_emit_indented("xorq %rdx, %rdx")
    x86_emit_indented("divq %rcx")
    x86_emit_indented("movq %rdx, %rax")
    x86_emit_jmp("jmp" done)
    x86_emit_label_str(mod_zero)
    x86_emit_label_str(done)
    return void
}

let x86_unsigned_idiv = ():>void => {
    x86_emit_op_2("movq" "%rax" "%rcx")
    x86_pop_saved_into("%rax")
    x86_emit_unsigned_idiv()
    return void
}

let x86_unsigned_mod = ():>void => {
    x86_emit_op_2("movq" "%rax" "%rcx")
    x86_pop_saved_into("%rax")
    x86_emit_unsigned_mod()
    return void
}

let x86_unsigned_cmp = (kind:int):>void => {
    if x86_pending_kind =? XP_CC { x86_flush() }
    let cc:int = ""
    if kind =? 0 { cc = "a" }
    else if kind =? 1 { cc = "b" }
    else if kind =? 2 { cc = "ae" }
    else if kind =? 3 { cc = "be" }
    x86_compare_pending(cc x86_pop_saved_operand(64))
    return void
}

let x86_alloca = ():>void => {
    # Spills belong below the buffer: their later pops must not discard the
    # allocation or read its contents as operands. Copy forward because the
    # old and new spill regions overlap for small allocations.
    if x86_spilled_depth >? 0 { x86_emit_indented("movq %rsp, %r10") }
    x86_emit_indented("addq $7, %rax")
    x86_emit_indented("andq $-8, %rax")
    x86_emit_indented("subq %rax, %rsp")
    let offset:int = 0
    loop offset <? x86_spilled_depth * 16 {
        x86_emit_op_mem_r("movq" offset "%r10" "%rcx")
        x86_emit_op_r_mem("movq" "%rcx" offset "%rsp")
        offset = offset + 16
    }
    if x86_spilled_depth >? 0 {
        x86_emit_op_mem_r("leaq" x86_spilled_depth * 16 "%rsp" "%rax")
    } else { x86_emit_indented("movq %rsp, %rax") }
    return void
}

# ----------------------------------------------------------------------------
# Calls
# ----------------------------------------------------------------------------

let x86_call_direct = (label_id:int num_args:int):>void => {
    x86_flush()
    let stack_bytes:int = x86_prepare_call_args(num_args 0)
    let label:int = intmap_get(x86_fn_labels label_id)
    let bb:int = bb_new(32 + str_len(label))
    bb_push_str(bb "    call ")
    bb_push_str(bb label)
    la_note_clobber(vec_len(x86_current_fn_code))
    vec_push(x86_current_fn_code bb_finalize_as_string(bb))
    if stack_bytes >? 0 {
        x86_emit_op_imm("addq" stack_bytes "%rsp")
    }
    return void
}

let x86_call_indirect = (num_args:int):>void => {
    x86_flush()
    let stack_bytes:int = x86_prepare_call_args(num_args "%r11")
    la_note_clobber(vec_len(x86_current_fn_code))
    x86_emit_indented("call *%r11")
    if stack_bytes >? 0 {
        x86_emit_op_imm("addq" stack_bytes "%rsp")
    }
    return void
}

let x86_max_call_args = ():>int => {
    return -1
}

let x86_syscall = (num_args:int):>void => {
    la_note_clobber(vec_len(x86_current_fn_code))
    if num_args =? 1 {
        x86_emit_indented("syscall")
    } else if num_args =? 2 {
        x86_emit_op_2("movq" "%rax" "%rdi")
        x86_pop_saved_into("%rax")
        x86_emit_indented("syscall")
    } else if num_args =? 3 {
        x86_emit_op_2("movq" "%rax" "%rsi")
        x86_pop_saved_into("%rdi")
        x86_pop_saved_into("%rax")
        x86_emit_indented("syscall")
    } else if num_args =? 4 {
        x86_emit_op_2("movq" "%rax" "%rdx")
        x86_pop_saved_into("%rsi")
        x86_pop_saved_into("%rdi")
        x86_pop_saved_into("%rax")
        x86_emit_indented("syscall")
    } else if num_args =? 5 {
        x86_emit_op_2("movq" "%rax" "%r10")
        x86_pop_saved_into("%rdx")
        x86_pop_saved_into("%rsi")
        x86_pop_saved_into("%rdi")
        x86_pop_saved_into("%rax")
        x86_emit_indented("syscall")
    } else if num_args =? 6 {
        x86_emit_op_2("movq" "%rax" "%r8")
        x86_pop_saved_into("%r10")
        x86_pop_saved_into("%rdx")
        x86_pop_saved_into("%rsi")
        x86_pop_saved_into("%rdi")
        x86_pop_saved_into("%rax")
        x86_emit_indented("syscall")
    } else if num_args =? 7 {
        x86_emit_op_2("movq" "%rax" "%r9")
        x86_pop_saved_into("%r8")
        x86_pop_saved_into("%r10")
        x86_pop_saved_into("%rdx")
        x86_pop_saved_into("%rsi")
        x86_pop_saved_into("%rdi")
        x86_pop_saved_into("%rax")
        x86_emit_indented("syscall")
    }
    return void
}

# Mixed extern intrinsic helpers.
# Name "__call_extern_mixed_N__" -> N (1..8), or -1 if not a match.
let x86_mixed_extern_arg_slots = (name:int):>int => {
    if not str_prefix(name "__call_extern_mixed_") { return -1 }
    let n:int = str_len(name)
    if n <? 23 { return -1 }
    if __load_u8__(name + n - 2) not=? 95 { return -1 }  # underscore
    if __load_u8__(name + n - 1) not=? 95 { return -1 }
    let mid_len:int = n - 22       # length of digit section
    if mid_len <? 1 { return -1 }
    let v:int = 0
    let i:int = 0
    loop i <? mid_len {
        let c:int = __load_u8__(name + 20 + i)
        if (c <? 48) or (c >? 57) { return -1 }
        v = v * 10 + (c - 48)
        i = i + 1
    }
    if (v <? 1) or (v >? 8) { return -1 }
    return v
}

let x86_move_to_xmm = (kind:int xmm_reg:int):>void => {
    if kind =? 1 {
        x86_emit_op_2("movd" "%eax" xmm_reg)
    } else if kind =? 2 {
        x86_emit_op_2("movq" "%rax" xmm_reg)
    }
    return void
}

# tags: Vec of int (0=GP, 1=f32, 2=f64), one per arg.
let x86_call_extern_xmm_mixed = (tags:int):>void => {
    let n:int = vec_len(tags)
    let gp_slots:int = vec_new(n)
    let xmm_slots:int = vec_new(n)
    let gp_count:int = 0
    let xmm_count:int = 0
    let i:int = 0
    loop i <? n {
        let k:int = vec_get(tags i)
        if k =? 0 {
            vec_push(gp_slots gp_count)
            vec_push(xmm_slots (-1))
            gp_count = gp_count + 1
        } else {
            vec_push(gp_slots (-1))
            vec_push(xmm_slots xmm_count)
            xmm_count = xmm_count + 1
        }
        i = i + 1
    }
    let ai:int = n - 1
    loop ai >=? 0 {
        let k:int = vec_get(tags ai)
        if k =? 0 {
            let dst:int = x86_arg_reg(vec_get(gp_slots ai))
            if not str_eq(dst "%rax") {
                x86_emit_op_2("movq" "%rax" dst)
            }
        } else {
            x86_move_to_xmm(k x86_xmm_reg(vec_get(xmm_slots ai)))
        }
        if ai >? 0 {
            x86_pop_saved_into("%rax")
        }
        ai = ai - 1
    }
    x86_pop_saved_into("%r11")
    la_note_clobber(vec_len(x86_current_fn_code))
    x86_emit_indented("call *%r11")
    return void
}

# static_args_map: IntMap arg_index -> tag (0/1/2). Returns Vec of tags
# for arg_index = 1, 3, 5, ... up to mixed_args*2.
let x86_mixed_extern_type_tags = (name:int static_args_map:int):>int => {
    let m:int = x86_mixed_extern_arg_slots(name)
    let tags:int = vec_new(m)
    let i:int = 0
    loop i <? m {
        let idx:int = 1 + i * 2
        vec_push(tags intmap_get(static_args_map idx))
        i = i + 1
    }
    return tags
}

# ----------------------------------------------------------------------------
# Control flow
# ----------------------------------------------------------------------------

let x86_begin_if = ():>void => {
    let else_label:int = x86_new_label("else")
    let end_label:int = x86_new_label("if_end")
    vec_push(x86_if_else_labels else_label)
    vec_push(x86_if_end_labels end_label)
    vec_push(x86_if_else_emitted false)
    if not x86_branch_pending(else_label false) {
        x86_flush()
        x86_emit_indented("testq %rax, %rax")
        x86_emit_jmp("jz" else_label)
    }
    return void
}

let x86_begin_else = ():>void => {
    x86_flush()
    let top:int = vec_len(x86_if_else_labels) - 1
    let else_label:int = vec_get(x86_if_else_labels top)
    let end_label:int = vec_get(x86_if_end_labels top)
    vec_set(x86_if_else_emitted top true)
    x86_emit_jmp("jmp" end_label)
    x86_emit_label_str(else_label)
    return void
}

let x86_end_if = ():>void => {
    x86_flush()
    let top:int = vec_len(x86_if_else_labels) - 1
    let else_label:int = vec_get(x86_if_else_labels top)
    let end_label:int = vec_get(x86_if_end_labels top)
    let emitted:int = vec_get(x86_if_else_emitted top)
    vec_pop(x86_if_else_labels)
    vec_pop(x86_if_end_labels)
    vec_pop(x86_if_else_emitted)
    if not emitted { x86_emit_label_str(else_label) }
    x86_emit_label_str(end_label)
    return void
}

let x86_begin_loop = ():>void => {
    x86_flush()
    let start:int = x86_new_label("loop_start")
    let end:int = x86_new_label("loop_end")
    vec_push(x86_loop_start_labels start)
    vec_push(x86_loop_end_labels end)
    la_begin_loop(vec_len(x86_current_fn_code))
    x86_emit_label_str(start)
    return void
}

let x86_begin_loop_body = ():>void => {
    let top:int = vec_len(x86_loop_end_labels) - 1
    let end:int = vec_get(x86_loop_end_labels top)
    if not x86_branch_pending(end false) {
        x86_flush()
        x86_emit_indented("testq %rax, %rax")
        x86_emit_jmp("jz" end)
    }
    return void
}

let x86_end_loop = ():>void => {
    x86_flush()
    let top:int = vec_len(x86_loop_start_labels) - 1
    let start:int = vec_get(x86_loop_start_labels top)
    let end:int = vec_get(x86_loop_end_labels top)
    vec_pop(x86_loop_start_labels)
    vec_pop(x86_loop_end_labels)
    x86_emit_jmp("jmp" start)
    x86_emit_label_str(end)
    la_end_loop(vec_len(x86_current_fn_code))
    return void
}

let x86_emit_break = ():>void => {
    x86_flush()
    let top:int = vec_len(x86_loop_end_labels) - 1
    let end:int = vec_get(x86_loop_end_labels top)
    x86_emit_jmp("jmp" end)
    return void
}

let x86_emit_continue = ():>void => {
    x86_flush()
    let top:int = vec_len(x86_loop_start_labels) - 1
    let start:int = vec_get(x86_loop_start_labels top)
    x86_emit_jmp("jmp" start)
    return void
}

let x86_cond_and_split = ():>int => {
    let lbl:int = x86_new_label("cond_and_false")
    if not x86_branch_pending(lbl false) {
        x86_flush()
        x86_emit_indented("testq %rax, %rax")
        x86_emit_jmp("jz" lbl)
    }
    return lbl
}

let x86_cond_and_join = (false_label:int):>void => {
    x86_flush()
    let done:int = x86_new_label("cond_and_done")
    x86_emit_jmp("jmp" done)
    x86_emit_label_str(false_label)
    x86_emit_indented("xorq %rax, %rax")
    x86_emit_label_str(done)
    return void
}

let x86_cond_or_split = ():>int => {
    let done:int = x86_new_label("cond_or_done")
    if x86_pending_kind =? XP_CC {
        # The taken path must carry the true value; movq leaves the flags alone.
        x86_emit_indented("movq $-1, %rax")
        x86_branch_pending(done true)
    } else {
        x86_flush()
        x86_emit_indented("testq %rax, %rax")
        x86_emit_jmp("jnz" done)
    }
    return done
}

let x86_cond_or_join = (done_label:int):>void => {
    x86_flush()
    x86_emit_label_str(done_label)
    return void
}

let x86_emit_return = ():>void => {
    x86_flush()
    x86_emit_jmp("jmp" x86_current_fn_epilogue)
    return void
}

# ----------------------------------------------------------------------------
# Intrinsics
# ----------------------------------------------------------------------------

let g_x86_intrinsics:int = 0     # Map of name -> arity

let x86_init_intrinsics = ():>void => {
    if g_x86_intrinsics not=? 0 { return void }
    core_intrinsics_init()
    let m:int = map_new()
    # copy core
    let cap:int = map_cap(g_core_intrinsics)
    let slots:int = map_slots(g_core_intrinsics)
    let i:int = 0
    loop i <? cap {
        let slot:int = slots + (i * 32)
        if __load__(slot) =? 1 {
            map_put(m __load__(slot + 8) __load__(slot + 16) __load__(slot + 24))
        }
        i = i + 1
    }
    linux_syscall_intrinsics_into(m)
    map_put_str(m "__i64_to_f32_bits__" 1)
    map_put_str(m "__i64_to_f64_bits__" 1)
    map_put_str(m "__f32_bits_to_i64__" 1)
    map_put_str(m "__f64_bits_to_i64__" 1)
    g_x86_intrinsics = m
    return void
}

let x86_is_intrinsic = (name:int):>int => {
    x86_init_intrinsics()
    if map_has_str(g_x86_intrinsics name) { return true }
    if x86_mixed_extern_arg_slots(name) >=? 0 { return true }
    return false
}

let x86_intrinsic_arity = (name:int):>int => {
    x86_init_intrinsics()
    let m:int = x86_mixed_extern_arg_slots(name)
    if m >=? 0 { return 1 + m * 2 }
    if map_has_str(g_x86_intrinsics name) {
        return map_get_str(g_x86_intrinsics name)
    }
    return -1
}

# Returns a bitmask of arg indices that must be compile-time int constants.
let x86_intrinsic_static_arg_indices = (name:int):>int => {
    let m:int = x86_mixed_extern_arg_slots(name)
    if m <? 0 { return 0 }
    let mask:int = 0
    let i:int = 0
    loop i <? m {
        mask = mask or (1 << (1 + i * 2))
        i = i + 1
    }
    return mask
}

let x86_str_starts_with = (s:int prefix:int):>int => {
    return str_prefix(s prefix)
}

# Memory intrinsics consume a pending address themselves.
let x86_memory_intrinsic = (name:int):>int => {
    let n:int = str_len(name)
    if n <? 8 { return false }
    if str_eq_len(name 7 "__load_" 7) { return true }
    return str_eq_len(name 8 "__store_" 8)
}

let x86_emit_intrinsic = (name:int num_args:int static_args_map:int):>void => {
    if not x86_memory_intrinsic(name) { x86_flush() }
    if str_eq(name "__load_u8__")        { x86_load_mem(8 0) }
    else if str_eq(name "__load_u16__")  { x86_load_mem(16 0) }
    else if str_eq(name "__load_u32__")  { x86_load_mem(32 0) }
    else if str_eq(name "__load_u64__")  { x86_load_mem(64 0) }
    else if str_eq(name "__load__")      { x86_load_mem(64 0) }
    else if str_eq(name "__breakpoint__") {
        # a debugger attached to the process stops here (SIGTRAP otherwise)
        x86_emit_indented("int3")
        x86_push_void()
    }
    else if str_eq(name "__store_u8__")  { x86_store_mem(8) }
    else if str_eq(name "__store_u16__") { x86_store_mem(16) }
    else if str_eq(name "__store_u32__") { x86_store_mem(32) }
    else if str_eq(name "__store_u64__") { x86_store_mem(64) }
    else if str_eq(name "__store__")     { x86_store_mem(64) }
    else if str_eq(name "__load_i8__")   { x86_load_mem(8 1) }
    else if str_eq(name "__load_i16__")  { x86_load_mem(16 1) }
    else if str_eq(name "__load_i32__")  { x86_load_mem(32 1) }
    else if str_eq(name "__load_i64__")  { x86_load_mem(64 1) }
    else if str_eq(name "__store_i8__")  { x86_store_mem(8) }
    else if str_eq(name "__store_i16__") { x86_store_mem(16) }
    else if str_eq(name "__store_i32__") { x86_store_mem(32) }
    else if str_eq(name "__store_i64__") { x86_store_mem(64) }
    else if str_eq(name "__signed_shr__")    { x86_signed_shr() }
    else if str_eq(name "__unsigned_idiv__") { x86_unsigned_idiv() }
    else if str_eq(name "__unsigned_mod__")  { x86_unsigned_mod() }
    else if str_eq(name "__unsigned_lt__")   { x86_unsigned_cmp(1) }
    else if str_eq(name "__unsigned_gt__")   { x86_unsigned_cmp(0) }
    else if str_eq(name "__unsigned_lte__")  { x86_unsigned_cmp(3) }
    else if str_eq(name "__unsigned_gte__")  { x86_unsigned_cmp(2) }
    else if str_eq(name "__alloca__")        { x86_alloca() }
    else if str_eq(name "__i64_to_f32_bits__") {
        x86_emit_indented("cvtsi2ss %rax, %xmm0")
        x86_emit_indented("movd %xmm0, %eax")
    }
    else if str_eq(name "__i64_to_f64_bits__") {
        x86_emit_indented("cvtsi2sd %rax, %xmm0")
        x86_emit_indented("movq %xmm0, %rax")
    }
    else if str_eq(name "__f32_bits_to_i64__") {
        x86_emit_indented("movd %eax, %xmm0")
        x86_emit_indented("cvttss2si %xmm0, %rax")
    }
    else if str_eq(name "__f64_bits_to_i64__") {
        x86_emit_indented("movq %rax, %xmm0")
        x86_emit_indented("cvttsd2si %xmm0, %rax")
    }
    else if x86_str_starts_with(name "__syscall") {
        x86_syscall(num_args)
    }
    else {
        x86_call_extern_xmm_mixed(x86_mixed_extern_type_tags(name static_args_map))
    }
    return void
}

let x86_get_builtin_constants = ():>int => {
    return linux_builtin_constants(0)
}

# ----------------------------------------------------------------------------
# compile_and_link / run
# ----------------------------------------------------------------------------

# Forks `as` to assemble, then `ld` to link.
# Returns the executable path (length-prefixed udewy string).
let x86_compile_and_link = (code:int input_name:int cache_dir:int options:int):>int => {
    fs_mkdir_p(cache_dir)
    let asm_bb:int = bb_new(str_len(cache_dir) + str_len(input_name) + 4)
    bb_push_str(asm_bb cache_dir)
    bb_push_byte(asm_bb 47)
    bb_push_str(asm_bb input_name)
    bb_push_str(asm_bb ".s")
    let asm_path:int = bb_finalize_as_string(asm_bb)

    let obj_bb:int = bb_new(str_len(cache_dir) + str_len(input_name) + 4)
    bb_push_str(obj_bb cache_dir)
    bb_push_byte(obj_bb 47)
    bb_push_str(obj_bb input_name)
    bb_push_str(obj_bb ".o")
    let obj_path:int = bb_finalize_as_string(obj_bb)

    let exe_bb:int = bb_new(str_len(cache_dir) + str_len(input_name) + 2)
    bb_push_str(exe_bb cache_dir)
    bb_push_byte(exe_bb 47)
    bb_push_str(exe_bb input_name)
    let exe_path:int = bb_finalize_as_string(exe_bb)

    # Assemble the chunks recorded by x86_finish_module concurrently; each
    # chunk repeats the module header and the GNU-stack note.
    let objects:int = vec_new(8)
    let splits:int = 0
    if x86_chunk_offsets not=? 0 { splits = vec_len(x86_chunk_offsets) }
    if splits =? 0 {
        fs_write_file(path_to_cstr(asm_path) code str_len(code))
        let argv1:int = vec_new(8)
        vec_push(argv1 x86_str("as"))
        vec_push(argv1 asm_path)
        vec_push(argv1 x86_str("-o"))
        vec_push(argv1 obj_path)
        proc_run_or_die(argv1 "assembler failed")
        vec_push(objects obj_path)
    } else {
        let pids:int = vec_new(splits + 1)
        let ci:int = 0
        loop ci <=? splits {
            let start:int = 0
            if ci >? 0 { start = vec_get(x86_chunk_offsets ci - 1) }
            let stop:int = str_len(code)
            if ci <? splits { stop = vec_get(x86_chunk_offsets ci) }
            let chunk:int = bb_new(stop - start + str_len(x86_chunk_header) + 64)
            if ci >? 0 { bb_push_str(chunk x86_chunk_header) }
            bb_push_bytes(chunk code + start stop - start)
            if ci <? splits { bb_push_str(chunk "\n.section .note.GNU-stack,\"\",@progbits\n") }
            let chunk_asm:int = bb_new(str_len(cache_dir) + str_len(input_name) + 16)
            bb_push_str(chunk_asm cache_dir)
            bb_push_byte(chunk_asm 47)
            bb_push_str(chunk_asm input_name)
            bb_push_byte(chunk_asm 46)
            bb_push_int(chunk_asm ci)
            bb_push_str(chunk_asm ".s")
            let chunk_asm_path:int = bb_finalize_as_string(chunk_asm)
            let chunk_obj:int = bb_new(str_len(cache_dir) + str_len(input_name) + 16)
            bb_push_str(chunk_obj cache_dir)
            bb_push_byte(chunk_obj 47)
            bb_push_str(chunk_obj input_name)
            bb_push_byte(chunk_obj 46)
            bb_push_int(chunk_obj ci)
            bb_push_str(chunk_obj ".o")
            let chunk_obj_path:int = bb_finalize_as_string(chunk_obj)
            fs_write_file(path_to_cstr(chunk_asm_path) bb_data(chunk) bb_len(chunk))
            let argv1:int = vec_new(8)
            vec_push(argv1 x86_str("as"))
            vec_push(argv1 chunk_asm_path)
            vec_push(argv1 x86_str("-o"))
            vec_push(argv1 chunk_obj_path)
            let pid:int = proc_spawn(argv1)
            if pid <? 0 { eprintl("error: could not start the assembler") host_exit(1) }
            vec_push(pids pid)
            vec_push(objects chunk_obj_path)
            ci = ci + 1
        }
        let failed:int = 0
        let wi:int = 0
        loop wi <? vec_len(pids) {
            if proc_wait(vec_get(pids wi)) not=? 0 { failed = 1 }
            wi = wi + 1
        }
        if failed { eprintl("error: assembler failed") host_exit(1) }
    }

    # Partition link artifacts into static (.a/.o) vs shared (.so*).
    let artifacts:int = be_opt_link_artifacts(options)
    let static_arts:int = vec_new(4)
    let shared_arts:int = vec_new(4)
    if artifacts not=? 0 {
        let ai:int = 0
        loop ai <? vec_len(artifacts) {
            let p:int = vec_get(artifacts ai)
            if be_artifact_is_shared(p) { vec_push(shared_arts p) }
            else { vec_push(static_arts p) }
            ai = ai + 1
        }
    }

    let argv2:int = vec_new(32)
    vec_push(argv2 x86_str("ld"))
    if vec_len(shared_arts) >? 0 {
        # Dynamic link: need to point at the platform dynamic linker.
        let dyn_linker:int = x86_find_dynamic_linker()
        vec_push(argv2 x86_str("-e"))
        vec_push(argv2 x86_str("_start"))
        vec_push(argv2 x86_str("--gc-sections"))
        vec_push(argv2 x86_str("--dynamic-linker"))
        vec_push(argv2 dyn_linker)
        let oi:int = 0
        loop oi <? vec_len(objects) { vec_push(argv2 vec_get(objects oi)) oi = oi + 1 }
        if vec_len(static_arts) >? 0 {
            vec_push(argv2 x86_str("--start-group"))
            let si:int = 0
            loop si <? vec_len(static_arts) {
                vec_push(argv2 vec_get(static_arts si))
                si = si + 1
            }
            vec_push(argv2 x86_str("--end-group"))
        }
        let hi:int = 0
        loop hi <? vec_len(shared_arts) {
            vec_push(argv2 vec_get(shared_arts hi))
            hi = hi + 1
        }
    } else {
        vec_push(argv2 x86_str("-static"))
        vec_push(argv2 x86_str("-e"))
        vec_push(argv2 x86_str("_start"))
        vec_push(argv2 x86_str("--gc-sections"))
        let oj:int = 0
        loop oj <? vec_len(objects) { vec_push(argv2 vec_get(objects oj)) oj = oj + 1 }
        if vec_len(static_arts) >? 0 {
            vec_push(argv2 x86_str("--start-group"))
            let si:int = 0
            loop si <? vec_len(static_arts) {
                vec_push(argv2 vec_get(static_arts si))
                si = si + 1
            }
            vec_push(argv2 x86_str("--end-group"))
        }
    }
    vec_push(argv2 x86_str("-o"))
    vec_push(argv2 exe_path)
    proc_run_or_die(argv2 "linker failed")
    return exe_path
}

# Locate the x86_64 Linux dynamic linker. Matches udewy/backend/x86_64.py.
let x86_find_dynamic_linker = ():>int => {
    let c1:int = x86_str("/usr/lib64/ld-linux-x86-64.so.2")
    if fs_exists(path_to_cstr(c1)) { return c1 }
    let c2:int = x86_str("/lib64/ld-linux-x86-64.so.2")
    if fs_exists(path_to_cstr(c2)) { return c2 }
    eprintl("error: could not find the x86_64 Linux dynamic linker for shared-library linking")
    host_exit(1)
    return 0
}

let x86_run = (output_path:int args:int options:int):>int => {
    let argv:int = vec_new(vec_len(args) + 1)
    vec_push(argv output_path)
    let i:int = 0
    loop i <? vec_len(args) {
        vec_push(argv vec_get(args i))
        i = i + 1
    }
    return proc_run(argv)
}

let x86_get_compile_message = (output_path:int options:int):>int => {
    let bb:int = bb_new(64)
    bb_push_str(bb "Compiled: ")
    bb_push_str(bb output_path)
    return bb_finalize_as_string(bb)
}

# ----------------------------------------------------------------------------
# Installer
# ----------------------------------------------------------------------------

let x86_install_backend = ():>void => {
    x86_alloc_state()

    be_begin_module = x86_begin_module
    be_finish_module = x86_finish_module
    be_set_module_init = x86_set_module_init
    be_set_imported_sources = be_default_set_imported_sources
    be_mark_location = x86_mark_location
    be_note_local = x86_note_local
    be_begin_scope = x86_begin_scope
    be_end_scope = x86_end_scope

    be_intern_string = x86_intern_string
    be_intern_words = x86_intern_words
    be_define_global = x86_define_global
    be_declare_extern_global = x86_declare_extern_global
    be_intern_static = x86_intern_static
    be_push_string_ref = x86_push_string_ref
    be_push_global_ref = x86_push_global_ref
    be_push_static_ref = x86_push_static_ref
    be_load_global = x86_load_global
    be_store_global = x86_store_global
    be_function_ref = x86_function_ref
    be_string_ref = x86_string_ref
    be_static_ref = x86_static_ref

    be_declare_function = x86_declare_function
    be_bind_extern_function = x86_bind_extern_function
    be_declare_extern_function = x86_declare_extern_function
    be_should_warn_unused_extern = be_default_should_warn_unused_extern
    be_begin_function = x86_begin_function
    be_end_function = x86_end_function
    be_set_reachable_functions = x86_set_reachable_functions
    be_load_param = x86_load_param
    be_alloc_local = x86_alloc_local
    be_load_local = x86_load_local
    be_store_local = x86_store_local

    be_push_const_i64 = x86_push_const_i64
    be_push_void = x86_push_void
    be_push_fn_ref = x86_push_fn_ref
    be_pop_value = x86_pop_value
    be_save_value = x86_save_value
    be_restore_value = x86_restore_value

    be_unary_op = x86_unary_op
    be_binary_op = x86_binary_op
    be_binary_immediate = x86_binary_immediate

    be_begin_if = x86_begin_if
    be_begin_else = x86_begin_else
    be_end_if = x86_end_if
    be_begin_loop = x86_begin_loop
    be_begin_loop_body = x86_begin_loop_body
    be_end_loop = x86_end_loop
    be_emit_break = x86_emit_break
    be_emit_continue = x86_emit_continue
    be_cond_and_split = x86_cond_and_split
    be_cond_and_join = x86_cond_and_join
    be_cond_or_split = x86_cond_or_split
    be_cond_or_join = x86_cond_or_join
    be_emit_return = x86_emit_return

    be_call_direct = x86_call_direct
    be_call_indirect = x86_call_indirect
    be_max_call_args = x86_max_call_args

    be_is_intrinsic = x86_is_intrinsic
    be_intrinsic_arity = x86_intrinsic_arity
    be_intrinsic_static_arg_indices = x86_intrinsic_static_arg_indices
    be_emit_intrinsic = x86_emit_intrinsic
    be_get_builtin_constants = x86_get_builtin_constants

    be_compile_and_link = x86_compile_and_link
    be_run = x86_run
    be_get_compile_message = x86_get_compile_message
    return void
}

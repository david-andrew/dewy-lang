let st_rec_begin_function = (label:int name:int param_count:int is_main:int):>void => {
    let outer:int = st_depth =? 0
    if outer {
        st_op(22)
        st_u(st_dense(st_rec_fn label))
        st_ostr(name)
        st_u(param_count)
        if is_main { st_u(1) } else { st_u(0) }
    }
    st_depth = st_depth + 1
    (@st_orig_begin_function)(label name param_count is_main)
    st_depth = st_depth - 1
    return void
}

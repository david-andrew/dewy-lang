    return void
}
let st_rec_intern_string = (data:int len:int):>int => {
    let outer:int = st_depth =? 0
    if outer {
        st_op(9)
        st_u(len)
        st_bytes(data len)
    }
    st_depth = st_depth + 1
    let result:int = (@st_orig_intern_string)(data len)
    st_depth = st_depth - 1
    if outer { st_u(st_new_dense(st_rec_string result)) }
    return result
}
let st_rec_define_global = (name:int kind:int value:int):>int => {
    let outer:int = st_depth =? 0
    if outer {
        st_op(10)
        st_ostr(name)
        st_value(kind value)
    }
    st_depth = st_depth + 1
    let result:int = (@st_orig_define_global)(name kind value)
    st_depth = st_depth - 1
    if outer { st_u(st_new_dense(st_rec_global result)) }
    return result
}

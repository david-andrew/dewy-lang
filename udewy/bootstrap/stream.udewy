let st_rec_intern_words = (elements:int kinds:int):>int => {
    let outer:int = st_depth =? 0
    if outer {
        st_op(13)
        st_u(vec_len(elements))
        let wi:int = 0
        loop wi <? vec_len(elements) { st_value(vec_get(kinds wi) vec_get(elements wi))  wi = wi + 1 }
    }
    st_depth = st_depth + 1
    let result:int = (@st_orig_intern_words)(elements kinds)
    st_depth = st_depth - 1
    if outer { st_u(st_new_dense(st_rec_static result)) }
    return result
}

# µDewy bytecode: a recorder and a player for the parser's backend calls.
# Generated from one operation table (udewy/BYTECODE.md); mirrors
# udewy/stream.py. The recorder wraps the backend's function pointers,
# writing each call before forwarding it. The player decodes a stream and
# makes the same calls on the live backend, mapping each recorded id to the
# one the backend returns, one table per id space.

import p"./runtime/runtime.udewy"
import p"./backend/common.udewy"

const ST_SV_INT:int = 1

let st_out:int = 0
let st_depth:int = 0          # backend calls in progress (nested ones are not recorded)
let st_refs:int = 0           # backend reference value -> label id (recording)
let st_rec_fn:int = 0
let st_rec_global:int = 0
let st_rec_string:int = 0
let st_rec_static:int = 0
let st_rec_slot:int = 0
let st_rec_cond:int = 0
let st_data:int = 0
let st_len:int = 0
let st_pos:int = 0
let st_fn_map:int = 0
let st_global_map:int = 0
let st_string_map:int = 0
let st_static_map:int = 0
let st_slot_map:int = 0
let st_cond_map:int = 0

# ----------------------------------------------------------------------------
# Encoding
# ----------------------------------------------------------------------------

let st_op = (op:int):>void => {
    bb_push_byte(st_out op)
    return void
}
let st_u = (v:int):>void => {
    let x:int = v
    loop true {
        let low:int = x and 127
        x = x >> 7
        if x =? 0 {
            bb_push_byte(st_out low)
            return void
        }
        bb_push_byte(st_out low or 128)
    }
    return void
}
let st_s = (v:int):>void => {
    st_u((v << 1) xor __signed_shr__(v 63))
    return void
}
let st_bytes = (data:int len:int):>void => {
    bb_push_bytes(st_out data len)
    return void
}
let st_str = (s:int):>void => {
    st_u(str_len(s))
    st_bytes(s str_len(s))
    return void
}
let st_ostr = (s:int):>void => {
    if s =? 0 {
        st_u(0)
        return void
    }
    st_u(str_len(s) + 1)
    st_bytes(s str_len(s))
    return void
}
# Stream ids are dense per id space, in creation order, whatever the
# backend returned: both recorders write the same stream for one program.
# Each space maps a live id to its stream id (a map and its next id).
let st_space_new = ():>int => {
    let space:int = arena_alloc(16)
    __store__(intmap_new() space)
    __store__(0 space + 8)
    return space
}
let st_new_dense = (space:int live:int):>int => {
    let dense:int = __load__(space + 8)
    __store__(dense + 1 space + 8)
    intmap_put(__load__(space) live dense)
    return dense
}
let st_dense = (space:int live:int):>int => {
    let dense:int = intmap_get(__load__(space) live)
    if dense =? IM_MISSING {
        eprintl("error: µDewy bytecode: a backend id recorded before it was created")
        host_exit(1)
    }
    return dense
}
# A stable value: an integer, or the stream id of the label behind a
# backend reference.
let st_value = (kind:int value:int):>void => {
    st_u(kind)
    if kind =? ST_SV_INT {
        st_s(value)
        return void
    }
    let label:int = intmap_get(st_refs value)
    if label =? IM_MISSING {
        eprintl("error: µDewy bytecode: a reference value without a recorded label")
        host_exit(1)
    }
    if kind =? 2 { st_u(st_dense(st_rec_fn label)) }
    else if kind =? 3 { st_u(st_dense(st_rec_string label)) }
    else { st_u(st_dense(st_rec_static label)) }
    return void
}
# A set of function labels, as ascending stream ids.
let st_function_set = (m:int):>void => {
    let ids:int = vec_new(intmap_size(m) + 1)
    let slots:int = intmap_slots(m)
    let i:int = 0
    loop i <? intmap_cap(m) {
        let slot:int = slots + i * IM_SLOT_SIZE
        if __load__(slot + IM_SLOT_STATE) =? IM_OCCUPIED { vec_push(ids st_dense(st_rec_fn __load__(slot + IM_SLOT_KEY))) }
        i = i + 1
    }
    # Insertion sort: the stream spells a set in one order.
    let a:int = 1
    loop a <? vec_len(ids) {
        let value:int = vec_get(ids a)
        let b:int = a - 1
        loop b >=? 0 and vec_get(ids b) >? value {
            vec_set(ids b + 1 vec_get(ids b))
            b = b - 1
        }
        vec_set(ids b + 1 value)
        a = a + 1
    }
    st_u(vec_len(ids))
    let k:int = 0
    loop k <? vec_len(ids) { st_u(vec_get(ids k))  k = k + 1 }
    return void
}
# Static intrinsic arguments, as (index, value) pairs by ascending index.
let st_int_pairs = (m:int):>void => {
    st_u(intmap_size(m))
    let written:int = 0
    let index:int = 0
    loop written <? intmap_size(m) {
        let value:int = intmap_get(m index)
        if value not=? IM_MISSING or intmap_has(m index) {
            st_u(index)
            st_s(value)
            written = written + 1
        }
        index = index + 1
    }
    return void
}

# ----------------------------------------------------------------------------
# Recorder
# ----------------------------------------------------------------------------

let st_orig_begin_module:int = 0
let st_orig_finish_module:int = 0
let st_orig_set_module_init:int = 0
let st_orig_set_imported_sources:int = 0
let st_orig_mark_location:int = 0
let st_orig_note_local:int = 0
let st_orig_begin_scope:int = 0
let st_orig_end_scope:int = 0
let st_orig_intern_string:int = 0
let st_orig_define_global:int = 0
let st_orig_declare_extern_global:int = 0
let st_orig_intern_static:int = 0
let st_orig_intern_words:int = 0
let st_orig_push_string_ref:int = 0
let st_orig_push_global_ref:int = 0
let st_orig_push_static_ref:int = 0
let st_orig_load_global:int = 0
let st_orig_store_global:int = 0
let st_orig_declare_function:int = 0
let st_orig_bind_extern_function:int = 0
let st_orig_declare_extern_function:int = 0
let st_orig_begin_function:int = 0
let st_orig_end_function:int = 0
let st_orig_set_reachable_functions:int = 0
let st_orig_load_param:int = 0
let st_orig_alloc_local:int = 0
let st_orig_load_local:int = 0
let st_orig_store_local:int = 0
let st_orig_push_const_i64:int = 0
let st_orig_push_void:int = 0
let st_orig_push_fn_ref:int = 0
let st_orig_pop_value:int = 0
let st_orig_save_value:int = 0
let st_orig_restore_value:int = 0
let st_orig_unary_op:int = 0
let st_orig_binary_op:int = 0
let st_orig_binary_immediate:int = 0
let st_orig_begin_if:int = 0
let st_orig_begin_else:int = 0
let st_orig_end_if:int = 0
let st_orig_begin_loop:int = 0
let st_orig_begin_loop_body:int = 0
let st_orig_end_loop:int = 0
let st_orig_emit_break:int = 0
let st_orig_emit_continue:int = 0
let st_orig_cond_and_split:int = 0
let st_orig_cond_and_join:int = 0
let st_orig_cond_or_split:int = 0
let st_orig_cond_or_join:int = 0
let st_orig_emit_return:int = 0
let st_orig_call_direct:int = 0
let st_orig_call_indirect:int = 0
let st_orig_emit_intrinsic:int = 0
let st_orig_function_ref:int = 0
let st_orig_string_ref:int = 0
let st_orig_static_ref:int = 0

let st_rec_function_ref = (label_id:int):>int => {
    let value:int = (@st_orig_function_ref)(label_id)
    intmap_put(st_refs value label_id)
    return value
}
let st_rec_string_ref = (label_id:int):>int => {
    let value:int = (@st_orig_string_ref)(label_id)
    intmap_put(st_refs value label_id)
    return value
}
let st_rec_static_ref = (label_id:int):>int => {
    let value:int = (@st_orig_static_ref)(label_id)
    intmap_put(st_refs value label_id)
    return value
}
let st_rec_begin_module = ():>void => {
    let outer:int = st_depth =? 0
    if outer {
        st_op(1)
    }
    st_depth = st_depth + 1
    (@st_orig_begin_module)()
    st_depth = st_depth - 1
    return void
}
let st_rec_finish_module = ():>int => {
    let outer:int = st_depth =? 0
    if outer {
        st_op(2)
    }
    st_depth = st_depth + 1
    let result:int = (@st_orig_finish_module)()
    st_depth = st_depth - 1
    return result
}
let st_rec_set_module_init = (name:int):>void => {
    let outer:int = st_depth =? 0
    if outer {
        st_op(3)
        st_ostr(name)
    }
    st_depth = st_depth + 1
    (@st_orig_set_module_init)(name)
    st_depth = st_depth - 1
    return void
}
let st_rec_set_imported_sources = (paths:int):>void => {
    let outer:int = st_depth =? 0
    if outer {
        st_op(4)
        st_u(vec_len(paths))
        let pi:int = 0
        loop pi <? vec_len(paths) { st_str(vec_get(paths pi))  pi = pi + 1 }
    }
    st_depth = st_depth + 1
    (@st_orig_set_imported_sources)(paths)
    st_depth = st_depth - 1
    return void
}
let st_rec_mark_location = (path:int line:int column:int):>void => {
    let outer:int = st_depth =? 0
    if outer {
        st_op(5)
        st_str(path)
        st_u(line)
        st_u(column)
    }
    st_depth = st_depth + 1
    (@st_orig_mark_location)(path line column)
    st_depth = st_depth - 1
    return void
}
let st_rec_note_local = (slot:int name:int type_name:int formatter:int parameter:int):>void => {
    let outer:int = st_depth =? 0
    if outer {
        st_op(6)
        st_u(st_dense(st_rec_slot slot))
        st_str(name)
        st_str(type_name)
        st_ostr(formatter)
        if parameter { st_u(1) } else { st_u(0) }
    }
    st_depth = st_depth + 1
    (@st_orig_note_local)(slot name type_name formatter parameter)
    st_depth = st_depth - 1
    return void
}
let st_rec_begin_scope = ():>void => {
    let outer:int = st_depth =? 0
    if outer {
        st_op(7)
    }
    st_depth = st_depth + 1
    (@st_orig_begin_scope)()
    st_depth = st_depth - 1
    return void
}

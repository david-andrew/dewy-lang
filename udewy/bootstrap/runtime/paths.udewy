# Path manipulation utilities. Paths are length-prefixed udewy strings (output
# of arena_alloc + bb_finalize_as_string).

const CH_SLASH:int = 47
const CH_DOT:int = 46

# Find the last '/' offset in a length-prefixed string. Returns -1 if none.
let path_last_slash = (p:int):>int => {
    let n:int = str_len(p)
    let i:int = n - 1
    loop i >=? 0 {
        if __load_u8__(p + i) =? CH_SLASH { return i }
        i = i - 1
    }
    return -1
}

# Find the last '.' offset in the basename. Returns -1 if none.
let path_last_dot = (p:int):>int => {
    let n:int = str_len(p)
    let slash:int = path_last_slash(p)
    let i:int = n - 1
    loop i >? slash {
        if __load_u8__(p + i) =? CH_DOT { return i }
        i = i - 1
    }
    return -1
}

# Return basename as a freshly arena-allocated length-prefixed string.
let path_basename = (p:int):>int => {
    let slash:int = path_last_slash(p)
    let n:int = str_len(p)
    let start:int = slash + 1
    let len:int = n - start
    let bb:int = bb_new(len + 1)
    bb_push_bytes(bb p + start len)
    return bb_finalize_as_string(bb)
}

# Return dirname as a freshly arena-allocated length-prefixed string. Returns
# an empty string when the path contains no slash.
let path_dirname = (p:int):>int => {
    let slash:int = path_last_slash(p)
    if slash <? 0 {
        let empty:int = bb_new(1)
        return bb_finalize_as_string(empty)
    }
    let bb:int = bb_new(slash + 1)
    bb_push_bytes(bb p slash)
    return bb_finalize_as_string(bb)
}

# Return file suffix (e.g. ".udewy") as a fresh string. Empty if none.
let path_suffix = (p:int):>int => {
    let dot:int = path_last_dot(p)
    if dot <? 0 {
        let empty:int = bb_new(1)
        return bb_finalize_as_string(empty)
    }
    let n:int = str_len(p)
    let bb:int = bb_new(n - dot + 1)
    bb_push_bytes(bb p + dot n - dot)
    return bb_finalize_as_string(bb)
}

# Return basename stripped of its suffix (e.g. "foo.udewy" -> "foo").
let path_stem = (p:int):>int => {
    let base:int = path_basename(p)
    let dot:int = path_last_dot(base)
    if dot <? 0 { return base }
    let bb:int = bb_new(dot + 1)
    bb_push_bytes(bb base dot)
    return bb_finalize_as_string(bb)
}

# Join two path components with '/'. If `b` is absolute, returns just `b`.
let path_join = (a:int b:int):>int => {
    let bn:int = str_len(b)
    if (bn >? 0) and (__load_u8__(b) =? CH_SLASH) {
        # absolute path: copy b
        let bb2:int = bb_new(bn + 1)
        bb_push_bytes(bb2 b bn)
        return bb_finalize_as_string(bb2)
    }
    let an:int = str_len(a)
    let bb:int = bb_new(an + bn + 2)
    bb_push_bytes(bb a an)
    if (an >? 0) and (__load_u8__(a + an - 1) not=? CH_SLASH) {
        bb_push_byte(bb CH_SLASH)
    }
    bb_push_bytes(bb b bn)
    return bb_finalize_as_string(bb)
}

# Resolve a relative path against a base directory. If the relative path is
# absolute, it is returned (lexically normalized). Result is a fresh string.
# Performs lexical resolution (handles . and ..) but does NOT follow symlinks.
let path_resolve = (base_dir:int relative:int):>int => {
    let combined:int = path_join(base_dir relative)
    return path_normalize(combined)
}

# Test whether the segment at seg_ptr/seg_len equals "..".
let path_is_dotdot = (seg_ptr:int seg_len:int):>int => {
    if seg_len not=? 2 { return false }
    if __load_u8__(seg_ptr) not=? CH_DOT { return false }
    if __load_u8__(seg_ptr + 1) not=? CH_DOT { return false }
    return true
}

# Normalize a path lexically: collapse runs of '/', remove "." segments, and
# resolve ".." segments where possible.
let path_normalize = (p:int):>int => {
    let n:int = str_len(p)
    let absolute:int = false
    if n >? 0 {
        if __load_u8__(p) =? CH_SLASH { absolute = true }
    }

    # Parallel vectors of segment pointers and lengths.
    let seg_ptrs:int = vec_new(16)
    let seg_lens:int = vec_new(16)

    let i:int = 0
    loop i <? n {
        loop (i <? n) and (__load_u8__(p + i) =? CH_SLASH) {
            i = i + 1
        }
        if i >=? n { break }
        let start:int = i
        loop (i <? n) and (__load_u8__(p + i) not=? CH_SLASH) {
            i = i + 1
        }
        let seg_len:int = i - start
        let seg_ptr:int = p + start

        if (seg_len =? 1) and (__load_u8__(seg_ptr) =? CH_DOT) {
            # skip "."
        } else if path_is_dotdot(seg_ptr seg_len) {
            let count:int = vec_len(seg_ptrs)
            if count >? 0 {
                let top_ptr:int = vec_get(seg_ptrs count - 1)
                let top_len:int = vec_get(seg_lens count - 1)
                if path_is_dotdot(top_ptr top_len) {
                    vec_push(seg_ptrs seg_ptr)
                    vec_push(seg_lens seg_len)
                } else {
                    vec_pop(seg_ptrs)
                    vec_pop(seg_lens)
                }
            } else if not absolute {
                vec_push(seg_ptrs seg_ptr)
                vec_push(seg_lens seg_len)
            }
        } else {
            vec_push(seg_ptrs seg_ptr)
            vec_push(seg_lens seg_len)
        }
    }

    let bb:int = bb_new(n + 1)
    if absolute { bb_push_byte(bb CH_SLASH) }
    let k:int = 0
    let count2:int = vec_len(seg_ptrs)
    loop k <? count2 {
        if k >? 0 { bb_push_byte(bb CH_SLASH) }
        bb_push_bytes(bb vec_get(seg_ptrs k) vec_get(seg_lens k))
        k = k + 1
    }
    if (bb_len(bb) =? 0) and not absolute {
        bb_push_byte(bb CH_DOT)
    }
    return bb_finalize_as_string(bb)
}

# Convert a length-prefixed string to an arena-allocated NUL-terminated cstring.
let path_to_cstr = (p:int):>int => {
    let n:int = str_len(p)
    let out:int = arena_alloc(n + 1)
    copy_bytes(out p n)
    __store_u8__(0 out + n)
    return out
}

# Build a length-prefixed string from a cstring (null-terminated).
let path_from_cstr = (s:int):>int => {
    let n:int = cstr_len(s)
    let bb:int = bb_new(n + 1)
    bb_push_bytes(bb s n)
    return bb_finalize_as_string(bb)
}

let path_is_absolute = (p:int):>int => {
    if str_len(p) <=? 0 { return false }
    return __load_u8__(p) =? CH_SLASH
}

let path_slice = (p:int start:int end:int):>int => {
    let n:int = end - start
    let bb:int = bb_new(n + 1)
    bb_push_bytes(bb p + start n)
    return bb_finalize_as_string(bb)
}

let path_has_prefix = (s:int prefix:int):>int => {
    if str_len(s) <? str_len(prefix) { return false }
    return str_prefix(s prefix)
}

let path_cwd = ():>int => {
    let buf:int = host_mmap_rw(4096)
    host_getcwd(buf 4096)
    return path_from_cstr(buf)
}

let path_absolute = (input:int):>int => {
    let p:int = path_normalize(input)
    if path_is_absolute(p) { return p }
    return path_resolve(path_cwd() p)
}

# Longest shared directory prefix of `a` and `b`. Root is "/".
let path_common_prefix = (a:int b:int):>int => {
    let an:int = str_len(a)
    let bn:int = str_len(b)
    let n:int = an
    if bn <? n { n = bn }
    let i:int = 0
    let last_slash:int = -1
    loop i <? n {
        let ca:int = __load_u8__(a + i)
        if ca not=? __load_u8__(b + i) { break }
        if ca =? CH_SLASH { last_slash = i }
        i = i + 1
    }
    if i =? an {
        if (i =? bn) or ((i <? bn) and (__load_u8__(b + i) =? CH_SLASH)) {
            return path_slice(a 0 an)
        }
    }
    if i =? bn {
        if (i <? an) and (__load_u8__(a + i) =? CH_SLASH) {
            return path_slice(b 0 bn)
        }
    }
    if last_slash <? 0 {
        let empty:int = bb_new(1)
        return bb_finalize_as_string(empty)
    }
    if last_slash =? 0 {
        return path_slice(a 0 1)
    }
    return path_slice(a 0 last_slash)
}

let path_after_prefix = (p:int prefix:int):>int => {
    let pn:int = str_len(prefix)
    let n:int = str_len(p)
    if n <=? pn { return path_basename(p) }
    let start:int = pn
    if __load_u8__(p + pn) =? CH_SLASH {
        start = pn + 1
    }
    if start >=? n { return path_basename(p) }
    return path_slice(p start n)
}

let path_fnv1a = (p:int):>int => {
    let h:int = 0xcbf29ce484222325
    let n:int = str_len(p)
    let i:int = 0
    loop i <? n {
        h = h xor __load_u8__(p + i)
        h = h * 0x100000001b3
        i = i + 1
    }
    return h
}

let path_hex_digit = (d:int):>int => {
    if d <? 10 { return d + 48 }
    return d - 10 + 97
}

# High 48 bits of FNV-1a as 12 lowercase hex digits.
let path_hash12 = (p:int):>int => {
    let h:int = path_fnv1a(p)
    let tmp:int = __alloca__(8)
    __store__(h tmp)
    let bb:int = bb_new(13)
    let i:int = 0
    loop i <? 6 {
        let b:int = __load_u8__(tmp + 7 - i)
        bb_push_byte(bb path_hex_digit((b >> 4) and 0xf))
        bb_push_byte(bb path_hex_digit(b and 0xf))
        i = i + 1
    }
    return bb_finalize_as_string(bb)
}

# Relative path of `input` from cwd when it is inside cwd. Outside paths
# become `__external__/<hash12>/<tail-after-common-ancestor>`.
let path_relative_to_cwd = (input:int):>int => {
    let abs:int = path_absolute(input)
    let cwd:int = path_cwd()
    let cn:int = str_len(cwd)
    if path_has_prefix(abs cwd) {
        let an:int = str_len(abs)
        if an =? cn { return path_basename(abs) }
        if __load_u8__(abs + cn) =? CH_SLASH {
            return path_slice(abs cn + 1 an)
        }
    }
    let tail:int = path_after_prefix(abs path_common_prefix(abs cwd))
    return path_join(path_join("__external__" path_hash12(abs)) tail)
}

# Strip a leading `__dewycache__/` so a generated intermediate does not nest.
let path_strip_cache_prefix = (rel:int):>int => {
    let prefix:int = "__dewycache__"
    let pn:int = str_len(prefix)
    if not path_has_prefix(rel prefix) { return rel }
    let n:int = str_len(rel)
    if n =? pn { return path_basename(rel) }
    if __load_u8__(rel + pn) not=? CH_SLASH { return rel }
    if n =? pn + 1 { return path_basename(rel) }
    return path_slice(rel pn + 1 n)
}

# Source path used as the cache key: cwd-relative, cache prefix removed.
let path_cache_source = (input:int):>int => {
    return path_strip_cache_prefix(path_relative_to_cwd(input))
}

# `__dewycache__` or `__dewycache__/<parent of mirrored source>`.
let path_cache_dir = (input:int):>int => {
    let rel:int = path_cache_source(input)
    let parent:int = path_dirname(rel)
    let root:int = "__dewycache__"
    if str_len(parent) =? 0 { return root }
    return path_join(root parent)
}

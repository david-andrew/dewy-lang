# Jump Table Demo: Simple Stack-Based Calculator
#
# Opcode handlers are stored in a compile-time function-pointer table.
# Dispatch is an indirect call through that table.
#
# Opcodes:
#   0 = PUSH (next byte is value to push)
#   1 = ADD  (pop two, push sum)
#   2 = SUB  (pop two, push difference)
#   3 = MUL  (pop two, push product)
#   4 = HALT (stop execution, top of stack is result)

# Stack for the calculator (fixed size)
let calc_stack:int = __static_alloca__(128)
let stack_ptr:int = 0

# Opcode handler functions
let op_push = (val:int):>int => {
    __store__(val calc_stack + stack_ptr * 8)
    stack_ptr = stack_ptr + 1
    return 0
}

let op_add = (unused:int):>int => {
    stack_ptr = stack_ptr - 1
    let b:int = __load__(calc_stack + stack_ptr * 8)
    stack_ptr = stack_ptr - 1
    let a:int = __load__(calc_stack + stack_ptr * 8)
    __store__(a + b calc_stack + stack_ptr * 8)
    stack_ptr = stack_ptr + 1
    return 0
}

let op_sub = (unused:int):>int => {
    stack_ptr = stack_ptr - 1
    let b:int = __load__(calc_stack + stack_ptr * 8)
    stack_ptr = stack_ptr - 1
    let a:int = __load__(calc_stack + stack_ptr * 8)
    __store__(a - b calc_stack + stack_ptr * 8)
    stack_ptr = stack_ptr + 1
    return 0
}

let op_mul = (unused:int):>int => {
    stack_ptr = stack_ptr - 1
    let b:int = __load__(calc_stack + stack_ptr * 8)
    stack_ptr = stack_ptr - 1
    let a:int = __load__(calc_stack + stack_ptr * 8)
    __store__(a * b calc_stack + stack_ptr * 8)
    stack_ptr = stack_ptr + 1
    return 0
}

let op_halt = (unused:int):>int => {
    return 1
}

const handlers:int = __static_words__(op_push op_add op_sub op_mul op_halt)

# Helper to write a digit
let print_digit = (n:int):>void => {
    let buf:int = " "
    __store_u8__(n + 48 buf)
    __syscall3__(1 1 buf 1)
    return void
}

# Print a number (simple, works for small positive numbers)
let print_num = (n:int):>void => {
    if n >=? 100 {
        print_digit(n // 100)
        n = n % 100
        print_digit(n // 10)
        print_digit(n % 10)
    } else if n >=? 10 {
        print_digit(n // 10)
        print_digit(n % 10)
    } else {
        print_digit(n)
    }
    return void
}

let print = (s:int):>void => {
    let len:int = __load__(s - 8)
    __syscall3__(1 1 s len)
    return void
}

# Execute bytecode program
let execute = (program:int len:int):>int => {
    let pc:int = 0
    
    loop pc <? len {
        let opcode:int = __load_u8__(program + pc)
        pc = pc + 1
        if opcode >=? 5 {
            return 0
        }

        let val:int = 0
        if opcode =? 0 {
            val = __load_u8__(program + pc)
            pc = pc + 1
        }

        let fn:int = __load__(handlers + opcode * 8)
        if (fn)(val) {
            stack_ptr = stack_ptr - 1
            return __load__(calc_stack + stack_ptr * 8)
        }
    }
    
    return 0
}

let main = ():>int => {
    # Program: (3 + 5) * (10 - 2)
    # Bytecode: PUSH 3, PUSH 5, ADD, PUSH 10, PUSH 2, SUB, MUL, HALT
    let program:int = 0x"00 03 00 05 01 00 0a 00 02 02 03 04"
    let prog_len:int = __load__(program - 8)
    let stack_idx:int = 0
    loop stack_idx <? 16 {
        __store__(0 calc_stack + stack_idx * 8)
        stack_idx += 1
    }
    
    print("Calculator result: ")
    let result:int = execute(program prog_len)
    print_num(result)
    print("\n")
    
    # Verify: (3 + 5) * (10 - 2) = 8 * 8 = 64
    if result =? 64 {
        print("Test passed!\n")
        return 0
    }
    
    print("Test FAILED!\n")
    return 1
}

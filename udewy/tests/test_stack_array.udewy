# Test explicit stack storage with runtime values
let square = (x:int):>int => {
    return x * x
}

let main = ():>int => {
    let a:int = 2
    let b:int = 3
    let c:int = 5
    
    # Runtime values stored in explicit stack storage.
    let arr:int = __alloca__(32)
    __store__(a arr)
    __store__(b arr + 8)
    __store__(c arr + 16)
    __store__(square(4) arr + 24)
    
    # Sum all elements: 2 + 3 + 5 + 16 = 26
    let sum:int = 0
    let len:int = 4
    let i:int = 0
    loop i <? len {
        let elem:int = __load__(arr + i * 8)
        sum = sum + elem
        i = i + 1
    }
    
    return sum
}

# Parallax Engine / orbital foundry. All driving geometry uses uztrack 1.
# The road is a machine: a rolling service gantry reaches the underside of
# two enormous reactor hulls, then a vertical drop feeds a launch chamber.
# On the hulls, the whole circumference is driveable. The open collar between
# them demands a return to the marked meridian; it is not a cosmetic tube.
# The launch has a lower, connected recharge bypass. The final alternating
# banks narrow after the landing, so exit speed must be planned in advance.

import p"./prelude.udewy"

const TRACK_PARALLAX_ENGINE:Cstr = "
uztrack 1
name PARALLAX ENGINE
laps 3
space
# DOCK: start upright; the service gantry rolls onto its wall and underside.
node grid pos -1500 300 1300 tan 0 0 -1 width 44 44 surf grid
node dock pos -1500 300 500 tan 0 0 -1 width 44 44 surf normal
node wall pos -1500 450 -100 tan 0.2 0.4 -1 up 1 0 0 width 42 42 surf normal
node crown pos -1300 700 -600 tan 0.8 0.5 -0.7 up 0 -1 0 width 38 38 surf cork
node under pos -700 1000 -850 tan 1 0.25 -0.15 up 0 -1 0 width 38 38 surf normal
node mouth pos 0 1100 -900 tan 1 0 0 up 0 -1 0 width 44 44 surf normal
# FIRST VESSEL: the riding surface swells to a 1.2 km diameter hull.
# Shrink while still closed (the engine models the radial surface velocity),
# then open at constant radius so the collar never drops away underneath.
node hull0 pos 400 1100 -900 tan 1 0 0 up 0 -1 0 width 160 160 xsect -360 lift 1 surf normal
node hull1 pos 900 1100 -900 tan 1 0 0 up 0 -1 0 width 850 850 xsect -360 lift 1 surf normal
node hull2 pos 1500 1100 -900 tan 1 0 0 up 0 -1 0 width 1900 1900 xsect -360 lift 1 surf normal
node neck0 pos 2200 1100 -900 tan 1 0 0 up 0 -1 0 width 220 220 xsect -360 lift 1 surf ramp
node collar pos 2450 1100 -900 tan 1 0 0 up 0 -1 0 width 110 110 xsect -180 lift 1 surf ramp
node neck1 pos 2700 1100 -900 tan 1 0 0 up 0 -1 0 width 220 220 xsect -360 lift 1 surf normal
# SECOND VESSEL: the broad outer bulge exchanges surface distance for recharge.
node hull3 pos 3300 1100 -900 tan 1 0 0 up 0 -1 0 width 1300 1300 xsect -360 lift 1 surf normal
node hull4 pos 3900 1100 -900 tan 1 0 0 up 0 -1 0 width 160 160 xsect -360 lift 1 surf normal
node lip pos 4300 1100 -900 tan 1 0 0 up 0 -1 0 width 160 160 xsect -360 lift 1 surf normal
# CORE NEEDLE: left at the collar enters the machine itself. A fast slender
# spindle runs inside the second hull; its middle opens to a 120-degree arc.
# Its own internal dive cuts off the outer end-cap and vertical wall.
# The outer hull is broad and recharges energy before that longer descent.
node bore0 pos 2750 1100 -720 tan 1 0 0.3 up 0 -1 0 width 220 220 xsect -360 lift 1 surf normal
node bore1 pos 3000 1100 -680 tan 1 0 0 up 0 -1 0 width 70 70 xsect -360 lift 1 surf normal
node needle pos 3350 1100 -720 tan 1 0 -0.15 up 0 -1 0 width 23.3333 23.3333 xsect -120 lift 1 surf boost
node bore2 pos 3700 1100 -800 tan 1 0 -0.3 up 0 -1 0 width 70 70 xsect -360 lift 1 surf normal
node corefall pos 4200 450 -700 tan 0 -1 0 up -1 0 0 width 70 70 xsect -360 lift 1 surf loop
node corecatch pos 3900 -200 -600 tan -1 0 0 width 70 70 xsect -360 lift 1 surf loop
# GUILLOTINE: stay on the closed hull while folding down the machine's
# end. Only unfold once upright, so gravity assists the floor transition.
node drop0 pos 4650 750 -750 tan 0 -1 0 up -1 0 0 width 160 160 xsect -360 lift 1 surf loop
node drop1 pos 4650 150 -750 tan 0 -1 0 up -1 0 0 width 160 160 xsect -360 lift 1 surf loop
node drop2 pos 4300 -200 -600 tan -1 0 0 up 0 1 0 width 160 160 xsect -360 lift 1 surf loop
node runway pos 3500 -200 -600 tan -1 0 0 width 48 48 surf normal
node fork pos 2800 -200 -600 tan -1 0 0 width 48 48 surf normal
# MASS DRIVER: straight ahead is the launch; right is the lower recharge
# bypass. The orange runway is long enough to establish speed before flight.
node ramp pos 2350 -160 -600 tan -1 0.15 0 width 38 38 surf ramp
node launch pos 2100 -120 -600 tan -1 0.16 0 width 38 38 surf ramp
# 150 m of genuine air. The broad landing gives overspeed a longer run-out.
node land pos 1950 -135 -600 tan -1 0 0 width 72 72 surf normal
node landout pos 1300 -135 -600 tan -1 0 0 width 60 60 surf normal
node merge pos 850 -135 -600 tan -1 0 0 width 52 52 surf normal
# LOWER CIRCUIT: longer, protected, recharging. It rejoins before the slalom.
node bypass0 pos 2450 -300 -1050 tan -0.8 -0.1 -0.6 roll 24 width 56 56 surf normal
node bypass1 pos 1800 -350 -1200 tan -1 0 0 roll -18 width 64 64 surf recharge
node bypass2 pos 1150 -260 -1000 tan -0.7 0.2 0.7 roll -24 width 56 56 surf normal
# SCISSORS: the landing's speed has to be converted into lateral precision.
# The first bank is generous; the reversal pinches to a 48 m ribbon. An
# inside edge opens at the apex, but an outside rail still catches overshoot.
node scoop pos 250 -40 -350 tan -0.5 0.2 1 roll -24 width 70 70 xsect 90 surf normal
node slalom0 pos 50 100 350 tan 0 0.2 1 width 110 110 xsect 180 surf normal
node slalom1 pos 200 220 950 tan 0.5 0.1 1 roll -35 width 72 72 xsect 90 surf normal
node slalom2 pos 200 260 1400 tan -0.6 0 0.8 roll 40 width 40 40 surf normal
node blade pos -120 260 1750 tan -1 0 0 roll 55 width 24 24 surf cork
node release pos -600 280 1750 tan -1 0.05 0 roll 28 width 40 40 surf normal
node cool pos -1050 300 1750 tan -1 0 0 width 56 56 surf normal
node home pos -1500 300 1450 tan 0 0 -1 roll 18 width 44 44 surf normal
seg grid from grid to dock
seg wall from dock to wall
seg roll from wall to crown
seg ceiling from crown to under
seg approach from under to mouth
seg evert from mouth to hull0
seg swell0 from hull0 to hull1
seg swell1 from hull1 to hull2
seg taper0 from hull2 to neck0
seg open from neck0 to collar rails none
seg close from collar to neck1 rails none
seg swell2 from neck1 to hull3 surf recharge
seg taper1 from hull3 to hull4
seg unfurl from hull4 to lip
seg fold from lip to drop0
seg drop from drop0 to drop1
seg catch from drop1 to drop2
seg brake from drop2 to runway
seg decision from runway to fork
seg boost from fork to ramp surf boost
seg ramp from ramp to launch rails none surf ramp
seg landing from land to landout rails none
seg runout from landout to merge
seg scoop from merge to scoop
seg bowl from scoop to slalom0
seg bank0 from slalom0 to slalom1
seg bank1 from slalom1 to slalom2
seg knife from slalom2 to blade rails left
seg release from blade to release
seg cool from release to cool
seg home from cool to home
# A short 150 m service strip gives roughly one boost back at racing speed;
# it cannot replace the two full recharge routes earlier in the lap.
seg finish from home to grid surf recharge
seg bypass0 from fork to bypass0
seg bypass1 from bypass0 to bypass1 surf recharge
seg bypass2 from bypass1 to bypass2 surf recharge
seg bypass3 from bypass2 to merge
seg core0 from collar to bore0
seg core1 from bore0 to bore1 surf boost
seg core2 from bore1 to needle rails none surf boost
seg core3 from needle to bore2 rails none surf boost
seg core4 from bore2 to corefall
seg core5 from corefall to corecatch
seg core6 from corecatch to runway
start grid 0.4
route grid wall roll ceiling approach evert swell0 swell1 taper0 open close swell2 taper1 unfurl fold drop catch brake decision boost ramp landing runout scoop bowl bank0 bank1 knife release cool home finish
\0"

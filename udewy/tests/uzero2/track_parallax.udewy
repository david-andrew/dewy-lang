# Parallax Engine: an interwoven three-lap circuit built entirely from the
# existing track grammar. The high road and the home straight occupy the
# same skyline at different heights; the inversion is the eastern landmark.
#
# Racing rhythm: climbing esses -> energy/pace fork -> pipe inversion ->
# swelling exterior tube -> bank reversal -> low recovery straight.
# The outer fork restores energy. The shorter inner bridge spends that
# opportunity on a boosted entry and an exposed full roll. Both rejoin
# before the inversion, with identical lap progress at the merge.
# Approach the fork on the left for the spindle, right for the capacitor.

import p"./prelude.udewy"

const TRACK_PARALLAX_ENGINE:Cstr = "
uztrack 1
name PARALLAX ENGINE
laps 3
space
# GRID / CLIMB. A full straight to settle the pack before the bank changes.
node grid pos 0 180 600 tan 0 0 -1 width 52 52 xsect 0 surf grid
node approach pos 0 180 0 tan -0.3 0.05 -1 roll -8 width 52 52 xsect 0 surf normal
node esses0 pos -250 210 -350 tan -0.85 0.14 -0.5 roll -22 width 56 56 xsect 0 surf normal
node esses1 pos -650 280 -450 tan -1 0.2 0.1 roll -28 width 62 62 xsect 0 surf normal
node esses2 pos -1000 360 -250 tan -0.45 0.2 0.9 roll -22 width 56 56 xsect 0 surf normal
node esses3 pos -1100 420 150 tan 0 0.1 1 roll 12 width 48 48 xsect 0 surf normal
node fork pos -950 440 550 tan 0 0 1 width 48 48 xsect 0 surf normal
# CAPACITOR. Wide, railed outer crescent; the long green sector buys boosts
# for the next lap. A driver with a full battery has a reason to skip it.
node outer0 pos -950 440 1000 tan 0.7 0 0.7 roll 24 width 68 68 xsect 0 surf normal
node outer1 pos 0 440 1400 tan 1 0 0 roll 20 width 76 76 xsect 0 surf recharge
node outer2 pos 950 440 1000 tan 0.7 0 -0.7 roll 24 width 68 68 xsect 0 surf normal
node merge pos 1100 440 400 tan 0 0 -1 width 60 60 xsect 0 surf normal
# SPINDLE. The inside cut is visible from the fork: orange entry, then a
# pink ribbon rotating once above the low return. No hidden gap or leap of
# faith; commit to the narrow centre and let the road carry the inversion.
node bridge0 pos -650 440 850 tan 1 0 0 width 28 28 xsect 0 surf normal
node bridge1 pos 0 440 850 tan 1 0 0 up 0 -1 0 width 28 28 xsect 0 surf cork
node bridge2 pos 650 440 850 tan 1 0 0 width 28 28 xsect 0 surf normal
# IRIS. The shared road encloses gradually, then makes a drifting vertical
# loop. Explicit up vectors keep the frame continuous through dead vertical.
node iris0 pos 1100 440 0 tan 0 0 -1 width 90 90 xsect 180 surf normal
node iris1 pos 1100 440 -450 tan 0 0 -1 up 0 1 0 width 125 125 xsect 360 surf loop
node loop0 pos 1220 680 -690 tan 0 1 0 up 0 0 -1 width 125 125 xsect 360 surf loop
node loop1 pos 1340 920 -450 tan 0 0 1 up 0 -1 0 width 125 125 xsect 360 surf loop
node loop2 pos 1460 680 -210 tan 0 -1 0 up 0 0 1 width 125 125 xsect 360 surf loop
node loop3 pos 1580 440 -450 tan 0 0 -1 up 0 1 0 width 125 125 xsect 360 surf loop
node iris2 pos 1580 500 -950 tan -0.3 0.3 -1 width 90 90 xsect 180 surf normal
node saddle pos 1300 600 -1250 tan -1 0.2 -0.25 roll -16 width 60 60 xsect 0 surf normal
# LENS. Evert onto the tube, swell, neck down, then unfurl above the grid.
# The varying radius changes the available lateral space without a seam.
# Crossings are separated vertically; the upper road previews the way home.
node lens0 pos 700 680 -1350 tan -1 0 0 width 110 110 xsect -180 lift 1 surf normal
node lens1 pos 100 650 -1200 tan -0.8 -0.1 0.6 width 185 185 xsect -360 lift 1 surf normal
node lens2 pos -200 600 -800 tan 0 -0.1 1 width 100 100 xsect -360 lift 1 surf cork
node lens3 pos -150 560 -300 tan 0.4 -0.1 1 width 160 160 xsect -360 lift 1 surf normal
node lens4 pos 100 500 100 tan 0.8 -0.2 0.6 width 160 160 xsect -360 lift 1 surf normal
node lens5 pos 500 420 300 tan 1 -0.2 0 width 120 120 xsect -360 lift 1 surf normal
node lens6 pos 850 340 150 tan 0 -0.2 -1 width 95 95 xsect -180 lift 1 surf normal
# UNDERTOW. Open to a railed ribbon before the direction change. The green
# straight gives a partial refill even to a driver who took the spindle.
node undertow pos 700 260 -200 tan -1 -0.1 0 roll -24 width 58 58 xsect 0 surf normal
node return0 pos 350 220 50 tan 0 -0.1 1 roll -18 width 54 54 xsect 0 surf normal
node return1 pos 350 180 550 tan 0 0 1 width 54 54 xsect 0 surf normal
node return2 pos 600 180 1000 tan 0 0 1 roll 18 width 60 60 xsect 0 surf normal
node return3 pos 300 180 1300 tan -1 0 0 roll 26 width 64 64 xsect 0 surf normal
node return4 pos 0 180 1000 tan 0 0 -1 roll 18 width 56 56 xsect 0 surf normal
seg launch from grid to approach
seg climb0 from approach to esses0
seg climb1 from esses0 to esses1
seg climb2 from esses1 to esses2
seg climb3 from esses2 to esses3
seg decision from esses3 to fork
seg capacitor0 from fork to outer0
seg capacitor1 from outer0 to outer1 surf recharge
seg capacitor2 from outer1 to outer2 surf recharge
seg capacitor3 from outer2 to merge
seg iris_in0 from merge to iris0
seg iris_in1 from iris0 to iris1
seg inversion0 from iris1 to loop0
seg inversion1 from loop0 to loop1
seg inversion2 from loop1 to loop2
seg inversion3 from loop2 to loop3
seg iris_out from loop3 to iris2
seg saddle from iris2 to saddle
seg evert0 from saddle to lens0
seg evert1 from lens0 to lens1
seg lens0 from lens1 to lens2
seg lens1 from lens2 to lens3
seg lens2 from lens3 to lens4
seg lens3 from lens4 to lens5
seg unfurl0 from lens5 to lens6
seg unfurl1 from lens6 to undertow
seg reversal from undertow to return0
seg recovery from return0 to return1 surf recharge
seg home0 from return1 to return2
seg home1 from return2 to return3
seg home2 from return3 to return4
seg home3 from return4 to grid
# With antipodal up vectors on these straight spans, the bake chooses
# +180 degrees for each half. Together they form one full roll.
seg spindle_in from fork to bridge0 surf boost
seg spindle0 from bridge0 to bridge1 rails none surf cork
seg spindle1 from bridge1 to bridge2 rails none surf cork
seg spindle_out from bridge2 to merge
start launch 0.5
route launch climb0 climb1 climb2 climb3 decision capacitor0 capacitor1 capacitor2 capacitor3 iris_in0 iris_in1 inversion0 inversion1 inversion2 inversion3 iris_out saddle evert0 evert1 lens0 lens1 lens2 lens3 unfurl0 unfurl1 reversal recovery home0 home1 home2 home3
\0"

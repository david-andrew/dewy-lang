# Row mask (5 bits) of one glyph row. Lowercase letters fold to uppercase;
# anything outside the table renders blank.
let packed_bits = (data:int bit_offset:int width:int):>int => {
    let value:int = 0
    let i:int = 0
    loop i <? width {
        let bit_index:int = bit_offset + i
        let byte:int = __load_u8__(data + (bit_index // 8))
        value = (value << 1) or ((byte >> (7 - (bit_index % 8))) and 1)
        i += 1
    }
    return value
}

let glyph_row = (ch:int row:int):>int => {
    let c:int = ch
    if (c >=? 97) and (c <=? 122) {
        c -= 32
    }
    if (c <? GLYPH_FIRST) or (c >? GLYPH_LAST) {
        return 0
    }
    let glyph_index:int = ((c - GLYPH_FIRST) * GLYPH_ROW_COUNT) + row
    return packed_bits(glyph_rows glyph_index * 5 5)
}

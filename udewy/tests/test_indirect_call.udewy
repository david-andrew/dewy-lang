# Computed function-pointer calls through a variable; reads the same under Dewy and udewy.
let double = (x:int64):>int64 => {
    return x * 2
}

let choose = ():> <(x:int64):>int64> => {
    return @double
}

let main = ():>int64 => {
    let fn_ptr:<(x:int64):>int64> = choose()
    let indirect:int64 = (@fn_ptr)(5)
    let piped:int64 = (@fn_ptr)(6)
    return indirect + piped
}

import p"./font.udewy"
# Bespoke pixel artwork, rasterized in udewy into an identical RGBA framebuffer
# on every target. The expensive architecture/texture pass is baked once.
const W:int = 480
const H:int = 270
const INK:int = 0x0a1520
const SHADOW:int = 0x101f29
const SLATE:int = 0x243b43
const STONE:int = 0x39545b
const EDGE:int = 0x59716e
const MIST:int = 0x9eaaa0
const WHITE:int = 0xf5e9c7
const GOLD:int = 0xe6b86b
const RUST:int = 0x9d5d4c
const TEAL:int = 0x60dfcc
const RED:int = 0xf47c77
let canvas:int = 0
let backdrop:int = __static_alloca__(518400)
let ox:int = 0
let oy:int = 0
let palette:int = __static_words__(0x000000 0x0a1520 0x263744 0x395568 0x607e88 0xb4c7c0 0xf5e9c7 0xe6b86b 0x9d5d4c 0x633c40 0x60dfcc 0x248d92 0xf47c77 0xa74762 0x453d60 0x84729a)
let rgba = (c:int):>int => { return 0xff000000 or ((c and 255) << 16) or (c and 65280) or ((c >> 16) and 255) }
let mix = (a:int b:int t:int):>int => {
    let r:int = ((a >> 16) * (256 - t) + (b >> 16) * t) // 256
    let g:int = (((a >> 8) and 255) * (256 - t) + ((b >> 8) and 255) * t) // 256
    let bl:int = ((a and 255) * (256 - t) + (b and 255) * t) // 256
    return (r << 16) or (g << 8) or bl
}
let pixel = (x:int y:int c:int):>void => {
    x += ox y += oy
    if (x >=? 0) and (x <? W) and (y >=? 0) and (y <? H) {
        __store_u32__(rgba(c) canvas + (y * W + x) * 4)
    }
    return void
}
let rect = (x:int y:int w:int h:int c:int):>void => {
    x += ox y += oy
    let right:int = min(W x + w)
    let bottom:int = min(H y + h)
    x = max(0 x) y = max(0 y)
    let color:int = rgba(c)
    loop y <? bottom {
        let p:int = canvas + (y * W + x) * 4
        let end:int = canvas + (y * W + right) * 4
        loop p <? end { __store_u32__(color p) p += 4 }
        y += 1
    }
    return void
}
let line = (x:int y:int x2:int y2:int c:int):>void => {
    let dx:int = abs(x2 - x)
    let dy:int = -abs(y2 - y)
    let sx:int = 1
    let sy:int = 1
    if x >? x2 { sx = -1 }
    if y >? y2 { sy = -1 }
    let err:int = dx + dy
    loop true {
        pixel(x y c)
        if (x =? x2) and (y =? y2) { break }
        let e:int = 2 * err
        if e >=? dy { err += dy x += sx }
        if e <=? dx { err += dx y += sy }
    }
    return void
}
let ellipse = (x:int y:int rx:int ry:int c:int):>void => {
    let row:int = -ry
    loop row <=? ry {
        let width:int = sqrt(max(0 ry * ry - row * row) * rx * rx) // max(1 ry)
        rect(x - width y + row width * 2 + 1 1 c)
        row += 1
    }
    return void
}
let ring = (x:int y:int rx:int ry:int c:int):>void => {
    let a:int = 0
    let lx:int = x + rx
    let ly:int = y
    loop a <=? 1024 {
        let nx:int = x + cos(a) * rx // FP
        let ny:int = y + sin(a) * ry // FP
        line(lx ly nx ny c)
        lx = nx ly = ny a += 16
    }
    return void
}
let diamond = (x:int y:int r:int c:int):>void => {
    let i:int = -r
    loop i <=? r { rect(x - r + abs(i) y + i (r - abs(i)) * 2 + 1 1 c) i += 1 }
    return void
}
let outline = (x:int y:int w:int h:int c:int):>void => {
    rect(x y w 1 c) rect(x y + h - 1 w 1 c)
    rect(x y 1 h c) rect(x + w - 1 y 1 h c)
    return void
}
let text = (s:int x:int y:int scale:int c:int):>void => {
    let i:int = 0
    loop i <? __load__(s - 8) {
        let row:int = 0
        loop row <? 7 {
            let bits:int = glyph_row(__load_u8__(s + i) row)
            let col:int = 0
            loop col <? 5 {
                if has(bits 1 << (4 - col)) { rect(x + (i * 6 + col) * scale y + row * scale scale scale c) }
                col += 1
            }
            row += 1
        }
        i += 1
    }
    return void
}
let center = (s:int y:int scale:int c:int):>void => {
    text(s (W - (__load__(s - 8) * 6 - 1) * scale) // 2 y scale c)
    return void
}
let number = (n:int x:int y:int scale:int c:int):>void => {
    let buf:int = __static_alloca__(32)
    let end:int = buf + 31
    let p:int = end
    loop true {
        p -= 1 __store_u8__(48 + n % 10 p) n = n // 10
        if n =? 0 { break }
    }
    let i:int = 0
    loop p + i <? end {
        let row:int = 0
        loop row <? 7 {
            let bits:int = glyph_row(__load_u8__(p + i) row)
            let col:int = 0
            loop col <? 5 {
                if has(bits 1 << (4 - col)) { rect(x + (i * 6 + col) * scale y + row * scale scale scale c) }
                col += 1
            }
            row += 1
        }
        i += 1
    }
    return void
}
let hash = (x:int y:int):>int => { return ((x * 374761393 + y * 668265263) xor ((x + y * 17) * 1274126177)) and 0x7fffffff }
let glow = (x:int y:int r:int c:int):>void => {
    # Sparse ordered dither halos preserve a deliberate, crisp pixel aesthetic.
    let yy:int = -r
    loop yy <=? r {
        let xx:int = -r
        loop xx <=? r {
            let d:int = xx * xx + yy * yy
            if (d <? r * r) and (((xx + yy * 3) and 7) =? 0) { pixel(x + xx y + yy mix(INK c 55)) }
            xx += 1
        }
        yy += 1
    }
    return void
}
let column = (x:int y:int height:int):>void => {
    ellipse(x + 5 y + 3 17 5 0x142930)
    rect(x - 10 y - height 20 height 0x263f48)
    rect(x - 8 y - height 4 height 0x4a6265)
    rect(x + 5 y - height 3 height 0x172d38)
    rect(x - 3 y - height 2 height 0x334d55)
    let i:int = 7
    loop i <? height {
        line(x - 9 y - i x + 9 y - i - 1 0x1c323c)
        pixel(x - 7 y - i - 1 EDGE) i += 11
    }
    rect(x - 13 y - height - 4 26 5 STONE)
    rect(x - 12 y - height - 4 23 1 EDGE)
    rect(x - 13 y - 2 26 4 STONE)
    rect(x - 15 y + 2 30 4 SLATE)
    rect(x - 14 y + 2 28 1 EDGE)
    line(x - 1 y - height + 6 x + 2 y - height + 13 INK)
    line(x + 2 y - height + 13 x - 1 y - height + 20 INK)
    return void
}
let grass = (x:int y:int k:int):>void => {
    let i:int = 0
    loop i <? 7 {
        let h:int = 3 + hash(x + i y) % 9
        line(x + i - 3 y x + i - 5 + i // 2 y - h k)
        i += 1
    }
    return void
}
let tree = (x:int y:int side:int):>void => {
    let c:int = 0x192b34
    line(x y x + side * 6 y - 32 c) line(x + 1 y x + side * 7 y - 32 c)
    line(x + side * 6 y - 32 x + side * 2 y - 56 c)
    line(x + side * 4 y - 23 x - side * 14 y - 37 c)
    line(x - side * 14 y - 37 x - side * 19 y - 52 c)
    line(x - side * 10 y - 34 x - side * 26 y - 34 c)
    line(x + side * 5 y - 40 x + side * 24 y - 53 c)
    line(x + side * 24 y - 53 x + side * 27 y - 67 c)
    line(x + side * 24 y - 53 x + side * 35 y - 51 c)
    return void
}
let bake_scene = ():>void => {
    canvas = backdrop ox = 0 oy = 0
    let y:int = 0
    loop y <? H {
        let c:int = mix(0x0c1729 0x27434a y * 150 // H)
        rect(0 y W 1 c)
        let x:int = 0
        loop x <? W {
            let h:int = hash(x y)
            if h % 41 =? 0 { pixel(x y mix(c 0x749494 18)) }
            x += 1
        }
        y += 1
    }
    # Distant silhouettes and fine fog bands.
    let i:int = 0
    loop i <? 24 {
        let x:int = i * 23 - 10
        let h:int = 12 + hash(i 7) % 40
        rect(x 64 - h 14 h 0x101d2c)
        rect(x - 2 61 - h 18 3 0x142431)
        if i % 3 =? 0 { rect(x + 5 53 - h 3 12 0x101d2c) }
        i += 1
    }
    rect(0 61 W 1 0x344e55)
    # Water surrounding the elevated plaza.
    i = 0
    loop i <? 340 {
        let x:int = hash(i 71) % W
        let yy:int = 67 + hash(i 93) % 200
        line(x yy x + 2 + hash(i 12) % 15 yy 0x2a424b)
        i += 1
    }
    # Raised octagonal stone island, retaining wall, and steps.
    y = 63
    loop y <? 247 {
        let inset:int = max(0 83 - y) + max(0 y - 227)
        rect(32 + inset y 416 - inset * 2 1 0x152b35)
        y += 1
    }
    y = 62
    loop y <? 237 {
        let inset:int = max(0 82 - y) + max(0 y - 219)
        rect(32 + inset y 416 - inset * 2 1 0x30474c)
        y += 1
    }
    # Hand-weathered blocks. The deterministic texture never shimmers.
    y = 66
    loop y <? 234 {
        let inset:int = max(0 84 - y) + max(0 y - 218)
        let x:int = 36 + inset
        loop x <? 444 - inset {
            let row:int = (y - 64) // 16
            let col:int = (x + (row % 2) * 16) // 32
            let h:int = hash(col row)
            let c:int = mix(0x293f45 0x405652 h % 130)
            if ((y - 64) % 16 =? 0) or ((x + (row % 2) * 16) % 32 =? 0) { c = 0x20373e }
            if (y - 64) % 16 =? 1 { c = 0x455c59 }
            if hash(x y) % 23 =? 0 { c = mix(c 0x718071 36) }
            if hash(x y) % 149 =? 0 { c = 0x223b40 }
            pixel(x y c) x += 1
        }
        y += 1
    }
    line(52 62 428 62 EDGE) line(33 82 33 218 EDGE)
    line(447 82 447 218 EDGE) line(52 236 428 236 EDGE)
    line(52 62 33 82 EDGE) line(428 62 447 82 EDGE)
    line(33 218 52 236 EDGE) line(447 218 428 236 EDGE)
    i = 0
    loop i <? 4 {
        rect(211 - i * 3 237 + i * 3 58 + i * 6 3 0x253b42)
        rect(211 - i * 3 237 + i * 3 58 + i * 6 1 STONE) i += 1
    }
    # The observatory's engraved brass astrolabe.
    ellipse(240 150 111 69 0x2b4449)
    ring(240 150 110 69 0x50605a) ring(240 150 106 66 0x1c363d)
    ring(240 150 101 63 0x777562) ring(240 150 100 62 0x48564e)
    ring(240 150 83 52 0x596454) ring(240 150 81 50 0x1e383e)
    ring(240 150 40 25 0x657467) ring(240 150 37 23 0x19353d)
    i = 0
    loop i <? 32 {
        let a:int = i * 32
        line(240 + cos(a) * 92 // FP 150 + sin(a) * 57 // FP 240 + cos(a) * 100 // FP 150 + sin(a) * 62 // FP 0x82816a)
        if i % 4 =? 0 {
            line(240 + cos(a) * 42 // FP 150 + sin(a) * 26 // FP 240 + cos(a) * 78 // FP 150 + sin(a) * 48 // FP 0x536459)
            diamond(240 + cos(a) * 110 // FP 150 + sin(a) * 69 // FP 3 GOLD)
        }
        i += 1
    }
    # Fractures, scattered tiles, and vegetation around the outer wall.
    i = 0
    loop i <? 55 {
        let x:int = 48 + hash(i 91) % 384
        let yy:int = 70 + hash(i 93) % 156
        if abs(x - 240) >? 120 {
            line(x yy x + 3 yy + 3 0x19353a)
            line(x + 3 yy + 3 x + 8 yy + 2 0x19353a)
            pixel(x + 2 yy + 4 0x506158)
        }
        i += 1
    }
    i = 0
    loop i <? 32 {
        let x:int = 44 + hash(i 233) % 392
        let yy:int = 70
        if i % 2 =? 0 { yy = 234 }
        grass(x yy 0x476157)
        if i % 4 =? 0 { grass(x + 3 yy 0x69816b) }
        i += 1
    }
    tree(23 168 1) tree(459 186 (-1))
    column(58 88 45) column(422 88 45)
    column(97 65 23) column(383 65 30)
    # Broken flagstones and fallen masonry.
    rect(76 75 18 4 SLATE) rect(78 73 15 3 EDGE)
    rect(397 75 11 5 SLATE) rect(398 74 9 1 MIST)
    canvas = backend_framebuffer()
    return void
}
let sprite = (data:int width:int height:int x:int y:int flip:int flash:int):>void => {
    let row:int = 0
    loop row <? height {
        let col:int = 0
        loop col <? width {
            let ch:int = __load_u8__(data + row * width + col)
            if ch not=? 46 {
                let idx:int = ch - 48
                if ch >=? 65 { idx = ch - 65 + 10 }
                let c:int = __load__(palette + idx * 8)
                if flash { c = WHITE }
                let xx:int = col
                if flip { xx = width - 1 - col }
                pixel(x + xx y + row c)
            }
            col += 1
        }
        row += 1
    }
    return void
}


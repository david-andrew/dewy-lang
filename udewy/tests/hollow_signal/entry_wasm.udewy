import p"./platform_wasm.udewy"
import p"./core.udewy"
import p"./render.udewy"
import p"./audio.udewy"
import p"./frame.udewy"
let ready:int = 0
let main = ():>int => {
    if ready =? 0 {
        backend_init("Hollow Signal\0")
        initialize()
        ready = 1
    } else { frame_step() }
    return 0
}

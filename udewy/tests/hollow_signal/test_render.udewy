# Headless render fixtures. Emits six consecutive 480x270 RGBA frames.
# Guard words check every scene for framebuffer writes outside its bounds.
$supported_targets = ["x86_64"]
import p"./core.udewy"
import p"./render.udewy"
let storage:int = __static_alloca__(518416)
let fb:int = 0
let backend_framebuffer = ():>int => { return fb }
let output_frame = ():>void => {
    render()
    __syscall3__(SYS_WRITE STDOUT fb 518400)
    return void
}
let main = ():>int => {
    fb = storage + 8
    __store__(0x1234567890 storage)
    __store__(0x9876543210 fb + 518400)
    bake_scene()
    output_frame()
    new_game() wave = 4 banner = 0 invuln = 0
    let i:int = 0
    loop i <? 8 {
        let id:int = spawn_enemy(1 + i % 4 80 + i * 43 100 + i % 3 * 40)
        put(enemies + id * ES 10 0)
        i += 1
    }
    let f:int = 0
    loop f <? 100 { step(16) f += 1 }
    ground_strike(285 186)
    combo = 5 combo_time = 140 energy = 100
    output_frame()
    mode = UPGRADE choice = 1 output_frame()
    new_game() clear(enemies EN * ES) alive = 0 wave = 4 start_wave()
    put(enemies 10 0) put(enemies 7 0)
    f = 0
    loop f <? 52 { step(16 or 8) f += 1 }
    put(enemies 7 30) ground_strike(260 180)
    output_frame()
    mode = PAUSE output_frame()
    mode = WIN score = 58720 best = 58720 death_time = 90 output_frame()
    if (__load__(storage) not=? 0x1234567890) or (__load__(fb + 518400) not=? 0x9876543210) { return 1 }
    return 0
}

# Test packed boolean lookup data
# Six booleans, MSB first.
const lookup_table:int = 0b"101001"
const LOOKUP_COUNT:int = 6

let main = ():>int => {
    let ptr:int = lookup_table
    let len:int = LOOKUP_COUNT
    
    # Count the set bits.
    let sum:int = 0
    let i:int = 0
    loop i <? len {
        let elem:int = (__load_u8__(ptr + (i // 8)) >> (7 - (i % 8))) and 1
        if elem not=? 0 {
            sum = sum + 1
        }
        i = i + 1
    }
    
    # Three entries are set.
    return sum
}

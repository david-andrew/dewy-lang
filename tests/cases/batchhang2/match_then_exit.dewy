# quick
let drops:int64=0
Ticket:type=[id:int64 $__drop__=():>void=>{drops+=id}]
consume=()=>{
    match Ticket[7] {
        _:Ticket=>{}
    }
}
reuse_stack=()=>{
    let tickets:array<Ticket length <? 4>=[]
    tickets.push(Ticket[1])
    tickets.push(Ticket[2])
    printl(tickets.pop().id)
}
main=()=>{
    consume()
    reuse_stack()
    printl(drops)
    exit(0)
}

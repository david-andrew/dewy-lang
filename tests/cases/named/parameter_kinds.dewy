# `...` ends the positional run; `<v:T>` keeps a parameter out of the keyword interface
offset = (value:int64 ... amount:int64):>int64 => value + amount
printl(offset(40 amount=2))
printl(offset(amount=1 value=2))
scale = (value:int64 ... by:int64=2 plus:int64=0):>int64 => value * by + plus
printl(scale(20))
printl(scale(20 plus=2))
increment = (<value:int64>):>int64 => value + 1
printl(increment(41))

$runtime_checks

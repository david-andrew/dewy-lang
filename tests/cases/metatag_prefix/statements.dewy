# Settings live in scopes; loop labels still prefix their loop.
main=(argv:array<string>)=>{
    let xs=[20 22]
    let i=argv.length-1
    let first={
        $runtime_checks
        xs[i]
    }
    let second={
        $runtime_checks
        xs[i+1]
    }
    {
        $runtime_checks
        $outer
        loop n in [0..2) {
            if xs[i] =? 20 {break $outer}
        }
    }
    printl(first+second)
}

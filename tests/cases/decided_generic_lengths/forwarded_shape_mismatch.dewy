# A shaped parameter checks its integer type parameters against the argument.
inner = <R C>(g:array<int64 length=[R C]>):>int64 => R * 10 + C
outer = <R C>(g:array<int64 length=[R C]>):>int64 => inner<R C>(g)
main = () => {
    let g:array<int64 length=[2 3]> = [1 2 3
                                       4 5 6]
    printl(outer<2 4>(g))
}

main=()=>{
    let values=dict<string int64>()
    loop name in ["b" "a"] {values[name]=2}
    let results:array<[string int64]>=[]
    loop seed in [7 11] {
        loop name in values.keys.values.sorted() {results.push([name seed])}
    }
    let best=results.min_by((p)=>p[1])
    printl(best[0] best[1] results.length results[1][0])
}

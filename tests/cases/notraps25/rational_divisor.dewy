# `rational(a b)` is zero exactly when a is: a nonzero numerator divides.
main = () => {
    let half = rational(1 2)
    let third = rational(1 3)
    let n = args().length + 1
    let q = rational(n 7)
    let back = rational(-3 -4)
    printl"{2/half} {third/third} {1/q} {1/back} {1/rational(5)}"
}

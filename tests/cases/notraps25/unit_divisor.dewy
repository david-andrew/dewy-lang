# Dividing by a unit, a unit-valued constant or a written quantity: each is a
# nonzero number, so the exact division has nothing left to check.
from units import m, cm, kg, g
main = () => {
    let d = 12m
    let e = 3s
    let f = e
    let sack = 2.5kg
    printl"{d/e} {d/f} {d/cm} {sack/(125g)} {(1.5m)/cm} {12/e}"
}

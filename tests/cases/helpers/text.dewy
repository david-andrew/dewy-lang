# quick
# Text helpers: is_empty, prefix/suffix removal, chars as graphemes, count, lines, trims.
main=()=>{
    printl("".is_empty)
    printl("x".is_empty)
    printl("v1.2.txt".remove_prefix("v").remove_suffix(".txt"))
    printl("abc".remove_prefix("x"))
    printl("aab".remove_prefix("a"))
    printl("é🙂x".chars)
    printl("é🙂x".chars.length)
    printl("banana".count("an"))
    printl("a\nb\r\nc\n".lines)
    printl("[{"  pad  ".trim_start}]")
    printl("[{"  pad  ".trim_end}]")
}

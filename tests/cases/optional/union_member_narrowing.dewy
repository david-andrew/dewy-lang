# x is? C failing on an optional union (A | B | C)? leaves an (A | B)?: an early exit
# narrows the rest of the block, through further tests, closures and reassignment
Stop:type = type of error & [why:string]
Halt:type = type of error & []
f = (k:int64):>(int64 | none | Stop | Halt) => if k =? 0 none else if k =? 1 Stop["stopped"] else if k =? 2 Halt else k
take = (v:int64?):>int64 => v ?? -1
main = () => {
    let kept:array<int64?> = []
    loop k in [0..5) {
        let r = f(k)
        if r is? Stop or r is? Halt continue
        kept.push(r)
        let show = () => take(r)
        printl(show())
        r = f(1)
        if r is? Stop printl(r.why)
    }
    printl(kept)
    loop k in [0..5) {
        let r = f(k)
        if r is? Stop continue
        if r is? Halt continue
        if r is? none printl"none" else printl(r + 1)
    }
}

# An `int` counter copied into another carried counter keeps its lower bound.
scan = (xs:array<int>):>int => {
    let n = 0
    let back = 0
    loop n <? xs.length {
        if xs[n] =? 1 {
            back = n
            n += 1
        } else {
            back += 1
            n = back
        }
    }
    back
}
main = () => printl(scan([1 0 1 1 0]))

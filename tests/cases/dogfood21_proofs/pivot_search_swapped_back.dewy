# Near miss: after the swap, m[found] holds the old m[r], of unknown length.
pick = (rows:array<array<int>> c:int64 r:int64):>int => {
    let m = rows
    if r <? 0 or r >=? m.length or c <? 0 return 0
    let found = -1
    loop i in [r..m.length) if m[i].length >? c {
        found = i
        break
    }
    if found <? 0 return 0
    m.swap(r found)
    m[found][c]
}
main = () => printl(pick([[1] [2 3] [4 5 6]] 1 0))

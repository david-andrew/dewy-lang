# Near miss: the loop may also set found and keep going, so the exhausted
# path does not hold the sentinel alone, and the last index set says nothing.
pick = (rows:array<array<int>> c:int64):>int => {
    let found = -1
    loop i in [0..rows.length) {
        if rows[i].length >? c {
            found = i
            break
        }
        found = i
    }
    if found <? 0 return 0
    rows[found][c]
}
main = () => printl(pick([[1] [2 3]] 1))

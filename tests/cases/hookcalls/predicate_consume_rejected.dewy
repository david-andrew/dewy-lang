# An owner operation must invalidate the global reached by its hook.
let data:array<int64>=[10 20]
Handle=type of [fd:int64
    $__drop__
    close=():>void=>{data=[]}
    ready=():>bool=>fd >=? 0
    $__consume__
    valid=(i:int64 rows:array<int64>):>bool=>0 <=? i and i <? rows.length
    $__consume__
    finish=():>void=>{}
]
pick=(i:int64):>int64=>{
    let h=Handle[3]
    if i <? 0 or i >=? data.length {return 0}
    if not h.valid(i data) {return 0}
    data[i]
}
main=()=>{printl(pick(1))}

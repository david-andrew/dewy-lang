# A bounds helper remains useful in a program that closes files.
let closed:int64=0
File=type of [fd:int64
    $__drop__=():>void=>{closed+=1}
    ready=():>bool=>fd >=? 0
    valid=(i:int64 rows:array<int64>):>bool=>0 <=? i and i <? rows.length
]
read_row=(rows:array<int64> i:int64):>int64=>{
    let file=File[3]
    if file.valid(i rows) and file.ready {return rows[i]}
    0
}
main=()=>{printl(read_row([61 67] 1))}

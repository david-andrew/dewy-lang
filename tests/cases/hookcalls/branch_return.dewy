# Acquiring a socket does not close it or change the guarded cursor.
let cursor:int64=0
Socket=type of [fd:int64 peer:string
    $__drop__=():>void=>{cursor=99}
    connected=():>bool=>fd >=? 0
]
connect=(fd:int64):>Socket=>if fd >=? 0 {Socket[fd "local"]} else {Socket[0 "backup"]}
receive=(packets:array<int64>):>int64=>{
    if cursor <? 0 or cursor >=? packets.length {return 0}
    let socket=connect(4)
    if not socket.connected {return 0}
    packets[cursor]
}
main=()=>{printl(receive([37]))}

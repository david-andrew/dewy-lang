# A file descriptor borrows its metadata while a guarded row is read.
let closed:int64=0
File=type of [fd:int64 path:string
    $__drop__
    close=():>void=>{closed+=1}
    ready=():>bool=>fd >=? 0
]
read_row=(@rows:array<int64> i:int64):>int64=>{
    let file=File[3 "events.log"]
    if i <? 0 or i >=? rows.length {return 0}
    if not file.ready {return 0}
    rows[i]
}
main=()=>{let rows:array<int64>=[11 22] printl(read_row(@rows 1))}

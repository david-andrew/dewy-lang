# exit: 42
$runtime_checks
# Float keys sort by IEEE totalOrder: -0.0 before 0.0.
Item:type=[score:float64 id:int64]
run=()=>{let items=[Item[0.0 0] Item[-0.0 1] Item[-2.5 2] Item[1.5 3]]
items.sort(key=(item:Item):>float64=>item.score)
return if items[0].id =? 2 and items[1].id =? 1 and items[2].id =? 0 and items[3].id =? 3 42 else 1}
main=()=>exit(run())

let drops:int64=0
Owner=type of [value:int64
    $__drop__
    release=():>void=>{drops+=1}
]
main=()=>{
    {
        let m:dict<int64 Owner>=[0->Owner[0] 1->Owner[1]]
        loop i in [2..10) {m[i]=Owner[i]}
        m[0]=Owner[42]
        loop i in [1..8) {m.remove(i)}
        let total:int64=0
        loop [key value] in m {total+=value.value}
        assert(total=?59 and drops=?8)
        let popped=m.pop(0)
        assert(popped.value=?42 and drops=?8)
        m.clear()
        assert(drops=?10)
    }
    assert(drops=?11)
    printl"ok"
}

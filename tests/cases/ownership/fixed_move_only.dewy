let drops:int64=0
Owner=type of [value:int64
    $__drop__
    release=():>void=>{drops+=1}
]
Pair:type=array<Owner length=2>
identity=<T>(value:T):>T=>value
main=()=>{
    {let a:Pair=[Owner[0] Owner[1]] let b=identity(a) $runtime_assert(b[1].value=?1)}
    $runtime_assert(drops=?2)
    printl"ok"
}

# quick
let moves:int64=0
let copies:int64=0
let drops:int64=0
Owner=type of [value:int64
    $__drop__
    release=():>void=>{drops+=1}
    $__copy__
    duplicate=():>Owner=>{
        copies+=1
        let result=Owner[value+1]
        return result
    }
    $__move__
    transfer=():>Owner=>{
        moves+=1
        let result=Owner[value+2]
        return if value>?0 result else result
    }
]
main=()=>{
    {
        let first=Owner[10]
        let second=first.copy()
        assert(first.value=?10 and second.value=?11)
        let third=first
        assert(third.value=?12)
        assert(copies=?1 and moves=?1)
    }
    assert(drops=?2)
    printl"ok"
}

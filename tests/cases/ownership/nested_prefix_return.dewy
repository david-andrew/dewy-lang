let drops:int64=0
Leaf=type of [value:int64
    $__drop__
    release=():>void=>{drops+=1}
]
Whole=type of [first:Leaf second:Leaf
    $__drop__
    release=():>void=>{drops+=100}
]
exercise=():>int64=>{
    let whole=Whole[Leaf[1] {return 7}]
    return 0
}
main=()=>{$runtime_assert(exercise()=?7) $runtime_assert(drops=?1) printl"ok"}

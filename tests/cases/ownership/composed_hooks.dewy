let copies:int64=0
let moves:int64=0
let drops:int64=0
Owner=type of [value:int64
    $__drop__
    release=():>void=>{drops+=1}
    $__copy__
    duplicate=():>Owner=>{copies+=1 return Owner[value]}
    $__move__
    transfer=():>Owner=>{moves+=1 return Owner[value]}
]
main=()=>{
    {
        let first=Owner[7]
        let second=first.copy()
        $runtime_assert(first.value=?second.value)
        let third=first
        $runtime_assert(third.value=?7)
    }
    $runtime_assert(copies=?1)
    $runtime_assert(moves=?1)
    $runtime_assert(drops=?2)
    printl"ok"
}

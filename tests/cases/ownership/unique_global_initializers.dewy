let exposed:array<int64>=[]
let survivor:array<int64>=[]
let private_values:array<int64>=[]
exposed.push(10)
survivor.push(20)
private_values.push(30)
let first=exposed

copy_survivor=()=>survivor
mutate=()=>{
    exposed[0]=11
    survivor[0]=21
    private_values[0]=31
}
main=()=>{
    let second=copy_survivor()
    mutate()
    $runtime_assert(first[0]=?10)
    $runtime_assert(second[0]=?20)
    $runtime_assert(exposed[0]=?11)
    $runtime_assert(survivor[0]=?21)
    $runtime_assert(private_values[0]=?31)
    printl"ok"
}

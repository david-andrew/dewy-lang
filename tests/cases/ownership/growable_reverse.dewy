let order:int64=0
Owner=type of [value:int64
    $__drop__
    release=():>void=>{order=order*10+value}
]
main=()=>{
    {let a=[Owner[1] Owner[2] Owner[3]] a.clear()}
    assert(order=?321)
    order=0
    {let a=[Owner[1] Owner[2] Owner[3]] printl(a.length)}
    assert(order=?321)
    printl"ok"
}

# quick
$runtime_checks
let drops:int64=0
let copies:int64=0
let moves:int64=0
Owner=type of [value:int64
    $__drop__
    release=():>void=>{drops+=1}
    $__copy__
    duplicate=():>Owner=>{copies+=1 return Owner[value]}
    $__move__
    transfer=():>Owner=>{moves+=1 return Owner[value]}
]
identity=<T>(value:T):>T=>value
main=()=>{
    {
        let a:array<Owner>=[]
        loop i in [0..20) {a.push(Owner[i])}
        a.reserve(100)
        $runtime_assert(drops=?0 and copies=?0 and moves=?0)
        let b=a.copy()
        $runtime_assert(copies=?20)
        let x=a.pop()
        let y=a.pop(0)
        a[0]=Owner[42]
        $runtime_assert(drops=?1)
        a.clear()
        $runtime_assert(drops=?19)
        let c=identity(b)
        let sum:int64=0
        loop value in c {sum+=value.value}
        $runtime_assert(sum=?190 and x.value=?19 and y.value=?0)
        $runtime_assert(copies=?20 and moves=?0)
    }
    $runtime_assert(drops=?41)
    printl"ok"
}

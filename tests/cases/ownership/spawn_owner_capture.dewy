# modes: native native-release
$runtime_checks

# A spawned task owns the move-only values its body captures: they are moved in, used
# there, and dropped once, when the group releases the task.
End:type = [
    id:int64
    $__drop__
    release = ():>void => printl"drop"
]
main = () => {
    let e = End[3]
    let f = End[4]
    concurrent {
        spawn { printl"in task {e.id}" }
    }
    printl"after {f.id}"
}

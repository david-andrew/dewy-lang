let drops:int64=0
Owner=type of [value:int64
    $__drop__
    release=():>void=>{drops+=1}
]
main=()=>{
    {
        let xs:array<Owner length=2>=[Owner[0] Owner[42]]
        let sum:int64=0
        loop x in xs {sum+=x.value}
        $runtime_assert(sum=?42 and drops=?0 and xs[1].value=?42)
    }
    $runtime_assert(drops=?2)
    printl"ok"
}

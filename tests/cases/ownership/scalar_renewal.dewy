let drops:int64=0
Owner=type of [value:int64
    $__drop__
    release=():>void=>{drops+=1}
]
consume=(owner:Owner):>int64=>owner.value
conditional=(flag:bool)=>{
    let owner=Owner[1]
    if flag {consume(owner);}
    owner=Owner[2]
}
main=()=>{
    let owner=Owner[1]
    let moved=owner
    owner=Owner[2]
    $runtime_assert(consume(moved)=?1)
    $runtime_assert(drops=?1)
    owner=owner
    $runtime_assert(drops=?1)
    $runtime_assert(consume(owner)=?2)
    $runtime_assert(drops=?2)
    conditional(true)
    $runtime_assert(drops=?4)
    conditional(false)
    $runtime_assert(drops=?6)
    printl"ok"
}

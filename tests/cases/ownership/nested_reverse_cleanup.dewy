Leaf=type of [id:int64
    $__drop__
    release=():>void=>{printl"leaf"}
]
Left=type of [leaf:Leaf
    $__drop__
    release=():>void=>{printl"left"}
]
Right=type of [leaf:Leaf
    $__drop__
    release=():>void=>{printl"right"}
]
Tree=type of [left:Left right:Right
    $__drop__
    release=():>void=>{printl"tree"}
]
main=()=>{let tree=Tree[Left[Leaf[1]] Right[Leaf[2]]] printl"ready"}

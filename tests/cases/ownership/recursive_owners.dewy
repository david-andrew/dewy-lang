# quick
let drops:int64=0
Leaf=type of [value:int64
    $__drop__
    release=():>void=>{drops+=1}
]
Node:type=[next:Node?=none owner:Leaf]
main=()=>{
    {let first=Node[none Leaf[1]]
     let second=Node[first Leaf[2]]
     let third=Node[second Leaf[3]]
     let final=third
     assert(final.owner.value=?3)}
    assert(drops=?3)
    printl"ok"
}

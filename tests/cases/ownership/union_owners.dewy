# A union whose alternatives include an owner is an owner: it drops its active
# alternative; a match binding, a narrowed name or or_throw takes the owner out at its
# last use; a widening or a return moves it. Each owner drops once on every path.
let drops:int64 = 0
let sent:int64 = 0
Permit:type = [
    id:int64
    $__drop__
    release = ():>void => {drops += 1}
    $__consume__
    use = ():>int64 => {sent += 1 return id}
]
Stop:type = [why:int64]
Other:type = [x:int64]
get = (n:int64):>Permit | Stop => {
    if n >? 0 return Permit[n]
    Stop[0]
}
widen = (n:int64):>Permit | Stop | Other => get(n)
take = (u:Permit | Stop):>int64 => {
    match u {
        p:Permit => p.use
        _:Stop => 0
    }
}
main = () => {
    {let a = get(1)}
    $runtime_assert(drops =? 1)
    {let w = widen(2)}
    $runtime_assert(drops =? 2)
    {let w = widen(0)}
    $runtime_assert(drops =? 2)
    $runtime_assert(take(get(3)) =? 3)
    $runtime_assert(drops =? 3 and sent =? 1)
    {let a = get(4) let b = a $runtime_assert(take(b) =? 4)}
    $runtime_assert(drops =? 4 and sent =? 2)
    # is? narrows the local; consuming the narrowed name moves the permit out
    {let a = get(5)
     if a is? Permit {$runtime_assert(a.use =? 5)}
     $runtime_assert(drops =? 5)}
    $runtime_assert(drops =? 5)
    # a narrowing not taken: the local still drops its permit at the end
    {let a = get(6)
     if a is? Stop {printl"stop"}
     $runtime_assert(drops =? 5)}
    $runtime_assert(drops =? 6)
    loop i in [0..3) {
        match get(i) {
            p:Permit => {p.use;}
            _:Stop => {}
        }
    }
    $runtime_assert(drops =? 8 and sent =? 5)
    printl"ok {drops} {sent}"
}

# quick
let drops:int64=0
Owner=type of [value:int64
    $__drop__
    release=():>void=>{drops+=1}
]
make=(n:int64):>Owner=>Owner[n]
consume=(value:Owner):>int64=>value.value
choose=(flag:bool):>int64=>{
    let first=make(4)
    if flag {let next=first return consume(next)}
    else {let next=first return consume(next)+1}
}
main=()=>{
    $runtime_assert(choose(true)=?4)
    $runtime_assert(drops=?1)
    $runtime_assert(choose(false)=?5)
    $runtime_assert(drops=?2)
    {let zero=make(0)}
    $runtime_assert(drops=?3)
    make(0);
    $runtime_assert(drops=?4)
    {let a=make(10) a=make(20)}
    $runtime_assert(drops=?6)
    printl"ok"
}

# Two cursors stepped down on some paths only (the LCS walk-back) stay at
# most the lengths they started at.
merge_back = (a:array<int> b:array<int>):>int => {
    let i = a.length
    let j = b.length
    let t = 0
    loop i >? 0 and j >? 0 {
        if a[i - 1] >=? b[j - 1] { t = t * 10 + a[i - 1]; i -= 1 }
        else { t = t * 10 + b[j - 1]; j -= 1 }
    }
    t
}
main = () => printl(merge_back([1 3 5] [2 4]))

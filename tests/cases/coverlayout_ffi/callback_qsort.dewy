# modes: native native-release
$extern
qsort=(base:ptr<int32> count:uint64 width:uint64 compare:<(a:ptr<int32> b:ptr<int32>):>int32>):>void
$export
compare_values=(a:ptr<int32> b:ptr<int32>):>int32=>$unsafe {
    if a[0] <? b[0] -1 else if a[0] >? b[0] 1 else 0
}
main=():>void=>$unsafe {
    let items:array<int32>=[5 2 9 1]
    qsort(items.ptr 4 size_of<int32> @compare_values)
    printl(items)
}

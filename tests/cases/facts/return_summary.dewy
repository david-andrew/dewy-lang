# A call's result carries what every return of its callee establishes: an
# array's length interval, or a word's interval.
pair=(x:float64):>array<float64>=>{
    if x <? 0.0 return [0.0 0.0]
    return [x 1.0]
}
lower=():>int64=>1
clamp=(n:int64):>int64=>{
    if n >? 3 return 3
    if n <? 0 return 0
    n
}
main=()=>{
    let w=pair(2.0)
    let xs=[1 2 3 4 5]
    let k=lower()
    $assert w.length =? 2 and k =? 1
    printl(w[0] w[1] xs[lower()] xs[clamp(9)] xs[1..lower()+2))
}

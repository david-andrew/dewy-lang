# A partial application called in a loop: its writes are forgotten after the loop.
let items = [1 2 3]
drop = (a:int b:int):>void => {if a + b >? 0 items.clear()}
f = (i:int):>int => {
    if i <? 0 or i >=? items.length return 0
    let g = @drop(1)
    loop k in [0..3) { g(k) }
    items[i]
}
printl(f(1))

# An unbounded int's host sentinel cannot stand for its actual upper limit.
choose=(xs:array<int> i:int j:int pick:int64<0 <=? pick and pick <? 2>):>uint64=>{
    if i <? 0 or i >? 9223372036854775807 or j <? 0 return uint64(0)
    let choices=[i j]
    uint64(choices[pick])
}
printl(choose([4] 0 18446744073709551616 1))

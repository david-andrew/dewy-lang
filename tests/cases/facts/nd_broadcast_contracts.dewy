let a=[1 2 3 ; 4 5 6]
let row=[10 20 30]
printl((a .+ row).data)
printl((a .+ [10 ; 20]).data)
printl((a .+ 2).data)
printl((zeros<int>(0 3) .+ row).data)
same=(a:array<int length=[r c]> b:array<int length=[r c]>):>void=>{
    printl((a .+ b).data)
}
same(a a)
let cube=zeros<int>(2 1 3) .+ row
printl(cube.length)
let sum=a .+ row
printl(sum[1 2])
let again=sum .+ row
printl(again[1 2])
dynamic=(a:array<float64 length=[r c]> b:array<float64 length=[r c]>):>float64=>{
    if r =? 0 or c =? 0 return 0.0
    let sum=a .+ b
    sum[0 0]
}
printl(dynamic(eye(2) eye(2)))

# quick
$runtime_checks=false
State:type='free'|'ready'
Slot:type=[state:State count:int64]
mark=(@slots:array<Slot length=4> i:int64):>void=>{
    if i <? 0 or i >=? 4 return
    slots[i].state='ready'
    if slots[i].count <? int64.max slots[i].count+=1
}
main=():>void=>{
    let slots:array<Slot length=4>=[[state='free' count=0] [state='free' count=0] [state='free' count=0] [state='free' count=0]]
    mark(@slots 2)
    mark(@slots 9)
    printl("{slots[2].state} {slots[2].count} {slots[1].state}")
}

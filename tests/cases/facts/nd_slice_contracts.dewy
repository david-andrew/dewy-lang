main=()=>{
    let m=[1 2 3 ; 4 5 6]
    printl(m[[..] 1].data)
    printl(m[1 [..]].data)
    let block=m[[0..2) [1..3)]
    printl(block[1 1])
    printl(m[[0..0) [..]].data)
    printl(m[[99..99) [..]].data)
    let stored=[0..2)
    printl(m[stored 0].data)
    m[[0..1) [1..3)]=[8 9]
    printl(m.data)
    m[1 [..]]=7
    printl(m.data)
    m[[..] [..]] .+= 1
    printl(m.data)
    let first=(m:array<int length=[r c]>):>int=>{
        if r =? 0 or c =? 0 return 0
        let row=m[0 [..]]
        row[0]
    }
    printl(first(m))
    let old=m[[..] [..]]
    m=zeros<int>(1 1)
    printl(old[1 2])
}

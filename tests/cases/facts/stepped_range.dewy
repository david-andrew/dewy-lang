# A stepped range's values lie between its first value and its end, in the
# direction of the step; reading a mutable parameter's length writes nothing.
bump=(@xs:array<int64>):>void=>{
    loop i in [1,3..xs.length) { xs[i]+=1 }
}
main=()=>{
    let xs:array<int64>=[1 2 3 4 5 6 7]
    bump(@xs)
    if xs.length <? 7 return
    let total:int64=0
    loop i in [0,2..xs.length) {
        $assert i >=? 0 and i <? xs.length
        total+=xs[i]
    }
    loop i in [6,4..0] {
        $assert i <=? 6 and i >=? 0
        total+=xs[i]
    }
    printl(total)
}

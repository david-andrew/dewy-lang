Coin:type=[pos:vec2 taken:bool=false pop:Tween<float64>=tween(0.0 1.0 0.35 @ease_out)]
collect=(@coins:array<Coin> at:vec2 dt:float64):>int64=>{
    let count=0
    loop @coin in coins {
        if coin.taken coin.pop.update(dt)
        else if (coin.pos-at).norm<?30.0 {coin.taken=true;count+=1}
    }
    return count
}
let coins=[Coin[vec2(0 0)] Coin[vec2(100 0)]]
printl(collect(@coins vec2(0 0) 0.1))
printl(collect(@coins vec2(0 0) 0.1))
printl(coins.length)

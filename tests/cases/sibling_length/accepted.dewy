# A field's elements index a sibling array: checked on every change, known on every read.
Graph:type = [nodes:array<string> next:array<int64<(<? nodes.length)>>]
link = (@g:Graph src:int64 dst:int64):>void => {
    if 0 <=? src <? g.next.length and 0 <=? dst <? g.nodes.length { g.next[src] = dst }
}
add = (@g:Graph name:string):>void => {
    g.nodes.push(name)
    g.next.push(g.nodes.length - 1)
}
walk = (g:Graph start:int64 steps:int64):>void => {
    let at = start
    loop _ in [0..steps) {
        if not (0 <=? at <? g.next.length) return
        printl(g.nodes[g.next[at]])
        at = g.next[at]
    }
}
main = ():>void => {
    let g = Graph[nodes=['a' 'b' 'c'] next=[1 2 0]]
    add(@g 'd')
    link(@g 2 3)
    walk(g 0 5)
    loop e in g.next { printl(g.nodes[e]) }
    if g.next.length >? 1 { printl(g.nodes[g.next[1]]) }
    if g.next.length >? 0 { g.next.pop(); }
    if g.nodes.length >? 4 { g.next.insert(4 0) }
    if g.nodes.length >? 0 { g.next = [0 0 0] }
    g.next.clear()
    if g.nodes.length >? 0 { g.nodes.pop(); }
    g.nodes.clear()
    printl("{g.nodes.length} {g.next.length}")
}

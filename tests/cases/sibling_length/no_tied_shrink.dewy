Index:type = [keys:array<int64> values:array<string length =? keys.length> next:array<int64<(<? keys.length)>>]
drop = (@ix:Index):>void => {
    if ix.keys.length >? 0 {
        ix.keys.pop();
        ix.values.pop();
    }
}
main = ():>void => {
    let ix = Index[keys=[1 2] values=['a' 'b'] next=[1]]
    drop(@ix)
}

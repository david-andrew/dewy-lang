# exit: 42
$runtime_checks
run=()=>{
let a=reshape([float64(0.0) 2.0 1.0 3.0] 2 2) let b:array<float64>=[4.0 7.0]
let x=solve(a b)
$runtime_assert(abs(x[0]-1.0) <? 1e-12 and abs(x[1]-2.0) <? 1e-12)
let identity=a*inverse(a)
loop i in [0..2) {loop j in [0..2) {
$runtime_assert(abs(identity[i j]-(if i =? j 1.0 else 0.0)) <? 1e-12)}}
$runtime_assert(abs(det(a)+2.0) <? 1e-12)
$runtime_assert(a.data =? [0.0 2.0 1.0 3.0] and b =? [4.0 7.0])
return 42}
main=()=>exit(run())

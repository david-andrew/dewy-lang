# exit: 42
let calls=0
next=():>int64=>{calls+=1 return 9007199254740993}
run=()=>{
let value=next()
let a=sum([value 1]) let b=sum([1 value])
let c=sum([next() 1]) let d=sum([1 next()])
return if a=?9007199254740994 and b=?a and c=?a and d=?a and calls=?3 42 else 1}
main=()=>exit(run())

$runtime_checks

# exit: 42
# quick
$runtime_checks
run=()=>{
let a=reshape([1 2 3 4 5 6] 2 3)
$runtime_assert(a[[..] 1].shape =? [2] and a[[..] 1].data =? [2 5])
$runtime_assert(a[1 [..]].shape =? [3] and a[1 [..]].data =? [4 5 6])
let block=a[[0..2) [1..3)]
$runtime_assert(block.shape =? [2 2] and block.data =? [2 3 5 6])
$runtime_assert(a[0 [1..]].data =? [2 3])
$runtime_assert(a[[..] [..]].data =? a.data)
$runtime_assert(a[[0..0) [..]].shape =? [0 3] and size(a[[0..0) [..]]) =? 0)
return 42}
main=()=>exit(run())

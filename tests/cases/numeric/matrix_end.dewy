# exit: 42
$runtime_checks
run=()=>{
let m=reshape([1 2 3 4 5 6] 2 3)
$runtime_assert(m[end end] =? 6 and m[0 end] =? 3 and m[end 0] =? 4)
$runtime_assert(m[end-1 end] =? 3)
$runtime_assert(m[0 [0..end]].data =? [1 2 3])
$runtime_assert(m[[0..end] end].data =? [3 6])
$runtime_assert(m[[0..end] [0..end]].data =? m.data)
let saved=m m[end end]=42
$runtime_assert(m.data =? [1 2 3 4 5 42] and saved.data =? [1 2 3 4 5 6])
m[0 end]+=10
$runtime_assert(m[0 end] =? 13)
m[[0..end] end]=[20 22]
$runtime_assert(m.data =? [1 2 20 4 5 22])
return 42}
main=()=>exit(run())

# quick
# A matrix times a written-out column vector: the literal takes the matrix's
# elements, so decimals are floats there, not exact fractions.
main = () => {
    let a:array<float64> = [2.0 0.0 0.0 4.0]
    let m = reshape(a 2 2)
    printl(m * [1.5 0.25])
    printl(inverse(m) * [1.0 1.0])
}

$runtime_checks

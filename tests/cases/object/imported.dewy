# quick
from p"../../fixtures/objects/span.dewy" import Span, make_counter
import p"../../fixtures/objects/span.dewy" as spans
main = () => {
    let s = Span(1 4)
    s.grow(2)
    let t = spans.Span(0 2)
    t.grow(1)
    let c = make_counter(5)
    c.increment
    printl"{s.width} {t.width()} {c.value}"
}

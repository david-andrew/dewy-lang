# Generic closures that reach themselves again through a record: a stored closure
# given its record, and record-literal methods (recursive, mutually recursive, generic).
main = () => {
    let fact = <R>(r:R n:int64):>int64 => if n <=? 1 1 else n * r.f(r n - 1)
    let holder = [f = @fact]
    printl(holder.f(holder 5))
    let m = [
        base = 3
        power = (k:int64):>int64 => if k <=? 0 1 else base * power(k - 1)
        is_even = (k:int64):>bool => if k =? 0 true else is_odd(k - 1)
        is_odd = (k:int64):>bool => if k =? 0 false else is_even(k - 1)
        repeat = <T>(item:T k:int64):>array<T> => if k <=? 0 [] else [item repeat(item k - 1)...]
        steps = 0
        count_down = (k:int64) => if k >? 0 { steps += 1  count_down(k - 1) }
    ]
    m.count_down(4)
    printl"{m.power(4)} {m.is_even(10)} {m.is_odd(7)} {m.repeat("ab" 3)} {m.repeat(1 2)} {m.steps}"
}

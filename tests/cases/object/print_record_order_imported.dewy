# quick
# modes: native web
# An anonymous record prints in its canonical (name-sorted) order: another module
# writing the same shape in another order does not change it.
from p"../../fixtures/objects/record_order.dewy" import swapped
main = () => {
    printl([x=3 y=4])
    printl(swapped)
    printl"{[y=5 x=6]}"
}

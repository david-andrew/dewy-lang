# Tuples of indices keep each component's bounds, sorted too.
main = () => {
    let xs = [5 6 7]
    let pairs:array<[int64 int64]> = [loop i in [0..xs.length) loop j in [i + 1..xs.length) [i j]]
    loop [a b] in pairs { printl(xs[a] + xs[b]) }
    if not pairs.is_empty { let [i j] = pairs[pairs.length - 1]; printl(xs[i] * xs[j]) }
    let named:array<[string int64]> = [loop i in [0..xs.length) ["n{i}" i]]
    loop [n i] in named { printl("{n} {xs[i]}") }
}

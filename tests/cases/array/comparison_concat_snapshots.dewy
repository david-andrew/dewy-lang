# exit: 42
run=()=>{
let text="a"
let joined="{text}{ {text="b"; "c"} }"
if joined not=? "ac" or text not=? "b" return 1
text="a"
if text not=? {text="b"; "a"} return 2
let values=[1]
let combined=[values... {values=[2]; [3]}...]
return if combined =? [1 3] and values =? [2] 42 else 3
}
main=()=>exit(run())

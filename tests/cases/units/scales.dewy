# quick
from units import m, km, cm, mm, kg, g, deg, turn
main=():>int64=>{
    $runtime_assert (3km =? 3000m)
    $runtime_assert (250cm =? 2500mm)
    $runtime_assert (300ms =? 3s/10)
    $runtime_assert (1000000ns =? 1ms)
    $runtime_assert (2hour =? 120minute)
    $runtime_assert (500g =? kg/2)
    $runtime_assert (90deg =? turn/4)
    printl"{3km/m} {300ms/s} {90deg/turn}"
    return 0
}

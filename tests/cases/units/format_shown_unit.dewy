# A format spec shows the number in the unit the quantity prints in; otherwise canonical.
from units import km, m, K, °C, °F, deg, turn, R, RSI, RValue
let t = 20°C
printl"{t:.1f} {t as °F:.1f} {t/K:.2f}"
let held:float64*Temperature = 300.0K
printl"{held:.1f}"
let d = 1500m
printl"{d:.1f} {d as km:.3f} {3km:.1f}"
let a:float64*Length = 2500.0m
printl"{a as km:.2f} {a:.2f}"
printl"{(180deg as turn):.2f} {90deg as deg:.1f}"
let small:float32*Length = 1500.0m
printl"{small as km:.2f}"
let step = 25°C - 5°C
printl"{step:.1f} {step as °F:.1f} {step/K:.1f}"
let wall:float64*RValue = 13.4R
printl"{wall as R:.1f} {wall as RSI:.3f} {wall/R:.1f}"

from units import m, km
Speed:type = float64 * Length / Time
Duration:type = <T>(T * Time)
travel=(speed:Speed elapsed:Duration<float64>):>(float64 * Length)=>speed*elapsed
identity=<T>(value:T):>T=>value
stretch=<T>(distance:T * Length factor:T):>(T * Length)=>distance*factor
choose=((x:float64 * Length):>int64=>1) & ((x:float64 * Time):>int64=>2)
main=():>int64=>{
    let speed:Speed=2.0m/s
    let elapsed:Duration<float64>=3s
    $runtime_assert (travel(speed 300ms) =? 0.6m)
    let distance=travel(speed elapsed)
    $runtime_assert (distance =? 6m)
    $runtime_assert (identity(2m) =? 2m)
    $runtime_assert (identity(3s) =? 3s)
    $runtime_assert (stretch(distance 2.0) =? 12m)
    $runtime_assert (choose(distance) =? 1)
    $runtime_assert (choose(elapsed) =? 2)
    let kilometers:float64 * Length=2km
    printl"{distance} {kilometers}"
    return 0
}

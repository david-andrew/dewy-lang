# 1 RSI against 1 US R, from the definitions: the IT BTU, the international foot, 5/9 K per °F.
from units import inch, ft, feet, foot, yd, yard, yards, mile, miles, m, J, W, kW, kJ, kWh, K, °C, °F, BTU, R, RSI
printl"{RSI/R} {R/RSI}"
printl"{RSI =? 52752792631/9290304000*R}"
printl"{R =? ft^2*(5K/9)*hour/BTU}"
printl"{R =? ft^2*°F*hour/BTU} {RSI =? m^2*°C/W}"
printl"{ft =? 3048m/10000} {foot =? ft} {feet =? ft} {yd =? 3ft} {yard =? yd} {yards =? yd} {mile =? 1609.344m} {miles =? mile}"
printl"{BTU =? 1055.05585262J} {kJ =? 1000J} {kW =? 1000W} {kWh =? 3600000J}"
printl"{1RSI as R} {1R as RSI}"
printl"{(1R)*(3inch)/(3inch) =? 1R}"

# modes: native native-release
main=()=>{
    let start=time()
    sleep(30ms)
    sleep(1/100 * s)
    let fraction:float64 * Time=0.01 * s
    sleep(fraction)
    let whole:int64 * Time=0 * s
    sleep(whole)
    let pause=300ms
    sleep(pause/30)
    sleep(-300ms)
    printl(time()-start >=? 0.06)
    return 0
}

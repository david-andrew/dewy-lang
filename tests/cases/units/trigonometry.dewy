from units import turn, deg, °
main=()=>{
    printl"{cos(45°)} {sin(30°)} {cos(60°)} {tan(45°)}"
    printl"{cos(90°)} {sin(-90°)} {sin(180°)} {cos(1turn)} {tan(-45deg)}"
    printl"{sin(1000001/4 * turn)} {cos(-7/2 * turn)}"
    let eighth:float64 * Angle=0.125 * turn
    let whole:int64 * Angle=3turn
    printl"{sin(eighth)} {cos(whole)} {sin(whole)}"
    let x:float64=0.5
    printl"{sin(x)} {cos(0.5)}"
    return 0
}

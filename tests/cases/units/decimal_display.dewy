# Decimals keep printing as decimals through quantities (display as written).
from units import kg, g, N, m, cm
half = (l:(rational * Length)) => l/2
main = () => {
    let sack = 2.5kg
    let gravity = 9.81N/kg
    printl"{gravity} {sack*gravity/N} {sack/(125g)} {1.25m/m} {-(0.5m)/cm} {(1.5m)^2/m^2}"
    loop x in [1.5 2.25] printl"{x*m/cm} {(x*m)/m} {half(x*m)/m}"
    printl"{(1/3)*m/cm} {(1/3 + 0.5)*m/m}"
}

$runtime_checks

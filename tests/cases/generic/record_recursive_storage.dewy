# exit: 42
Node:type=<T>[value:T children:array<Node<T>>=[]]
sum=<T>(node:Node<T>):>T=>{
let result=node.value loop child in node.children {result+=sum(child)} return result}
main=()=>{
let tree=Node<int64>[20 [Node<int64>[10] Node<int64>[12]]]
let reals=Node<float64>[0.5 [Node<float64>[1.5]]]
let saved=tree tree.children[0].value=99
return if sum(reals)=?2.0 and sum(saved)=?42 and sum(tree)=?131 42 else 1}

# Near miss of unproven_bound_rejected: a guard proves the bound; the chain runs once.
calls = 0
next = (x:int):>int => { calls += 1; x }
main = () => {
    let t:[int int] = [0 0]
    loop i in [0..2) { t[i] += i + 1 }
    let j = next(1)
    if 0 <=? j <? 2 { t[j] += 10 }
    printl(t)
    printl(calls)
}

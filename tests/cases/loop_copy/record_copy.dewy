# A record element's copy, changed and read, and the place form that changes the array.
Enemy:type = [hp:int name:string]
main = () => {
    let enemies = [Enemy[10 "a"] Enemy[20 "b"]]
    loop e in enemies { e.hp -= 1; printl(e) }
    printl(enemies)
    loop @e in enemies { e.hp -= 1 }
    printl(enemies)
}

# `int` literals above the int64 range fold exactly in floor, remainder, power and division
main=():>void=>{
    printl(9223372036854775808 // 2)
    printl(9223372036854775808 % 3)
    printl((-9223372036854775809) // 2)
    printl(18446744073709551615 % 10)
    printl(10 // 9223372036854775809)
    printl(10 % 9223372036854775809)
    printl(9223372036854775809 ^ 1)
    printl(9223372036854775809 / 2)
}

$runtime_checks
# An `@xs[i]` argument inside a loop writes the element: the loop's cached array
# must be made unique first, or the write lands in a literal or a shared copy.
Item:type=[id:int64 tags:array<int64>]
bump=(@t:int64):>void=>{t+=1}
main=():>void=>{
    let xs:array<int64>=[8]
    let d:dict<string array<int64>>=["k"->xs]
    let r:[v:int64 xs:array<int64>]=[v=1 xs=[8 9]]
    let rs=r
    let aa:array<array<int64>>=[[1 2] [3]]
    let ab=aa
    let items=[Item[1 [2]] Item[3 [4]]]
    let saved=items
    loop i in [int64(0)..2) {
        bump(@xs[0])
        bump(@r.xs[i])
        bump(@aa[0][i])
        bump(@items[i].id)
        bump(@items[0].tags[0])
    }
    printl(xs) printl(d)
    printl(r) printl(rs)
    printl(aa) printl(ab)
    printl(items) printl(saved)
}

# A text that starts with p has at least p's graphemes: `word[p.length..]`
# slices after a true `word.startswith(p)`, combining marks included.
rest = (word:string p:string):>string => {
    if word.startswith(p) return word[p.length..]
    word
}
main = () => {
    printl(rest(">=1.2" ">="))
    printl(rest("1.2" ">="))
    printl(rest("éx" "e").length)
    printl(rest("ab" "ab").length)
}

# A loop that only pushes never shrinks its array: a guard on the entry
# length (`d <=? out.length`) still holds for every later length.
copy_back = (start:array<string> d:int n:int):>array<string> => {
    let out = start
    if not (1 <=? d <=? out.length) return out
    loop _ in [0..n) out.push(out[out.length - d])
    out
}
copy_some = (start:array<int> d:int):>array<int> => {
    let out = start
    if not (1 <=? d <=? out.length) return out
    loop k in [0..10) if k % 3 =? 0 out.push(out[out.length - d] + k)
    out
}
main = () => {
    printl(copy_back(["a" "b"] 2 5).join(""))
    printl(copy_some([1] 1))
}

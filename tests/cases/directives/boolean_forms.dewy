# Boolean settings: `$name` and `$name=true` turn a setting on, `$name=false` off.
$runtime_checks=true
$explicit_copies=true

$runtime_checks
first=(xs:array<int64> i:int64):>int64=>{
    return xs[i]
}
$explicit_copies=false
second=(xs:array<int64> i:int64):>int64=>{
    let ys=xs
    ys[0]=0
    return xs[i]+ys[i]
}
main=()=>{
    let xs:array<int64>=[4 5]
    printl("{first(xs 1)} {second(xs 0)}")
}

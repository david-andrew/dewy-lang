# exit: 101
# An unproven sum under `$no_inf` and `$runtime_checks` is checked: an
# overflow fails where it happens.
total=(xs:array<float64>):>float64=>{
    $no_inf
    $runtime_checks
    let acc=0.0
    loop x in xs {
        acc+=x
    }
    return acc
}
main=()=>{
    let xs:array<float64>=[]
    loop i in [0..3) {
        xs.push(1e308)
    }
    printl(total([1.0 2.0]))
    printl(total(xs))
}

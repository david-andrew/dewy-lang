# `$no_hidden_costs=false` opts a scope out of the whole bundle; inside it a
# scope may ask for runtime checks again.
$no_hidden_costs
at=(xs:array<int64> i:int64):>int64=>{
    $no_hidden_costs=false
    $runtime_checks
    let ys=xs
    return ys[i]
}
main=()=>{
    $no_hidden_costs=false
    $runtime_checks
    let xs:array<int64>=[3 4]
    printl(at(xs 1))
}

# Under $no_hidden_costs an arena acquires its capacity explicitly, and allocation
# inside $allocator is allowed where it is proven to fit that capacity.
$no_hidden_costs
count=():>int64 | OutOfMemory=>{
    let a=arena(200) or_throw
    let n=$allocator(@a) {
        let xs:array<int64>=[1 2 3]
        let total:int64=0
        loop i in [0..10) {
            let ys:array<int64>=[i i+1]
            total+=ys[1]
        }
        xs.length+(total%1000000)
    }
    n
}
show=(n:int64):>void=>{
    $no_hidden_costs=false
    printl("{n}")
}
main=()=>{
    $no_hidden_costs=false
    let n=count() or_throw
    show(n)
}

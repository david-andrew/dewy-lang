# A parenthesized element of a collecting array literal is one value (fuzz seed 9).
main=():>void=>{
    let o2:int64?=int64.min
    printl"= {[(match o2 {m20:int64=>m20 <none>=>int64(1099511627776)}) {int64(2) int64(4) int64(0)}]}"
    let c = o2 =? none
    printl([(if c 1 else 2) {3 4}])
    printl([({5; 6}) {7 8}])
    printl(["a" {"b" "c"} (match c {<true>=>"d" _=>"e"})])
}

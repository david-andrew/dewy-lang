# quick
# modes: native native-release
# exit: 42
increment=(@value:int64):>void=>{value+=1}
add=(value:int64 extra:int64=1):>int64=>value+extra
length=(values:array<int64>):>int64=>values.length
main=():>void=>exit(entry()) entry=()=>{
    let value:int64=40
    increment(@value)
    return add(value)
}

$runtime_checks

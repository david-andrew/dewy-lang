# Closures capturing state, higher-order functions and deep recursion.
$runtime_checks
make_counter=(start:int64):>(():>int64)=>{
    let n=start
    return ($capture n)=>{ n+=1; return n }
}
ack=(m:int64 n:int64):>int64=>if m <=? 0 or n >? 1000000 or n <? 0 n+1 else if n =? 0 ack(m-1 1) else ack(m-1 ack(m n-1))
fib=(n:int64):>int64=>if n <? 2 n else fib(n-1)+fib(n-2)
main=()=>{
    let c=make_counter(10)
    c();
    c();
    printl(c())
    let fs=[(x:int64)=>x+1 (x:int64)=>x*2 (x:int64)=>x*x]
    printl([loop f in fs f(7)])
    printl"{ack(2 3)} {fib(25)}"
    let xs=[5 3 9 1 7]
    printl(xs.map((x)=>x*10).filter((x)=>x >? 20).sum)
}

}
name=(s:string):>int64=>{
    match s {
        <"w0"> => 0
        <"w1"> => 1
        <"w2"> => 4
        <"w3"> => 9
        <"w4"> => 16
        <"w5"> => 25
        <"w6"> => 36
        <"w7"> => 49
        <"w8"> => 64
        <"w9"> => 81
        <"w10"> => 100
        <"w11"> => 121
        <"w12"> => 144
        <"w13"> => 169
        <"w14"> => 196
        <"w15"> => 225
        <"w16"> => 256
        <"w17"> => 289
        <"w18"> => 324
        <"w19"> => 361
        <"w20"> => 400
        <"w21"> => 441
        <"w22"> => 484
        <"w23"> => 529
        <"w24"> => 576
        <"w25"> => 625
        <"w26"> => 676
        <"w27"> => 729

}
main=()=>{
    let t:int64=0
    loop k in [-2..45) { t+=pick(k) % 1000003 }
    printl(t)
    printl"{0x123456789abcdef0 xor 0x0fedcba987654321} {-0x7fffffffffffffff} {1.0e-7} {6.02214076e23}"
    let n:int64=0
    loop k in [0..35) { n+=name("w{k}") }
    printl(n)
}

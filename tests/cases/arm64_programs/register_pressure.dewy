    let i37=int64(argv.length)*40 % 1000
    let i38=int64(argv.length)*41 % 1000
    let i39=int64(argv.length)*42 % 1000
    let f0=float64(argv.length)*0.25
    let f1=float64(argv.length)*1.25
    let f2=float64(argv.length)*2.25

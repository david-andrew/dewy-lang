# quick
# `$build` is the compile-time record of how the program is built.
main=()=>{
    let mode=$build.mode
    printl(mode =? "release" or mode =? "debug")
    printl($build.debug =? ($build.mode =? "debug"))
    if $build.mode =? "release" { printl("optimized") } else { printl("optimized") }
    if $build.debug or not $build.debug { printl("folded") }
}

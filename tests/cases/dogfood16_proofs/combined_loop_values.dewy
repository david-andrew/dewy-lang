# A combined header (and its loop/else) expresses its body's values where the
# loop stands, as a single-header loop does: calls included.
pairs = (xs:array<int> ys:array<int>) => { loop x in xs and y in ys max(x y) }
main = () => {
    let xs = [3 9]
    let ys = [5 6 7]
    let empty:array<int> = []
    printl([loop x in xs and y in ys max(x y)])
    printl([loop i in 0.. and x in xs and y in ys "{i}:{x + y}"])
    printl([loop x in xs or y in ys max(x ?? 0 y ?? 0)])
    printl([loop x in xs max(x 4) else max(1 2)])
    printl([loop x in empty max(x 4) else max(1 2)])
    printl([loop x in empty and y in ys max(x y) else min(7 8)])
    printl([pairs(xs ys)])
}

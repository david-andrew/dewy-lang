# Checking each level gives the plain value.
show = (order:array<string?> i:int):>void => {
    let b = order.get(i)
    if b is? none return
    if b is? none { printl"empty seat"; return }
    let s:string = b
    printl"{s}"
}
main = () => { show(['a' none 'c'] 0) show(['a' none 'c'] 1) show(['a' none] 5) }

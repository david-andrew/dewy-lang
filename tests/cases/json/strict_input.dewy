# quick
# JSON names each field once, and a \u escape of half a surrogate pair is an error.
Settings:type=[a:int64=0 b:string="" inner:Inner=[x=0]]
Inner:type=[x:int64]
show=(text:string)=>{
    let j=parse_json(text)
    if j is? JsonError printl"parse: {j.message} @{j.line}:{j.column}" else printl"parse: {to_json(j)}"
    let t=from_json<Settings>(text)
    if t is? TextError printl"typed: {t.message} @{t.line}:{t.column}" else printl"typed: {t}"
}
main=()=>{
    show(r'{"a":1,"a":2}')
    show(r'{"a":1,"b":"x","inner":{"x":1,"x":2}}')
    show(r'{"inner":{"x":1},"inner":{"x":2}}')
    show(r'{"a":1,"b":"😀"}')
    show(r'{"a":1,"b":"\ud83d"}')
    show(r'{"a":1,"b":"\ud83dx"}')
    show(r'{"a":1,"b":"\ud83dA"}')
    show(r'{"a":1,"b":"\ude00"}')
    show(r'{"a":1,"inner":{"x":1},"b":"ok"}')
    show(r'{"k0":0,"k1":1,"k2":2,"k3":3,"k4":4,"k5":5,"k6":6,"k7":7,"k8":8,"k9":9,"k10":0,"k11":1,"k12":2,"k13":3,"k14":4,"k15":5,"k16":6,"k17":7,"k3":1}')
    show(r'{"k0":0,"k1":1,"k2":2,"k3":3,"k4":4,"k5":5,"k6":6,"k7":7,"k8":8,"k9":9,"k10":0,"k11":1,"k12":2,"k13":3,"k14":4,"k15":5,"k16":6,"k17":7,"a":1}')
    show(r'{"f0":0,"f1":1,"f2":2,"f3":3,"f4":4,"f5":5,"f6":6,"f7":7,"f8":8,"f9":9,"f10":10,"f11":11,"f12":12,"f13":13,"f14":14,"f15":15,"f16":16,"f17":17,"f18":18,"f19":19,"f20":20,"f21":21,"f22":22,"f23":23,"f24":24,"f25":25,"f26":26,"f27":27,"f28":28,"f29":29,"f30":30,"f31":31,"f32":32,"f33":33,"f34":34,"f35":35,"f36":36,"f37":37,"f38":38,"f39":39,"f40":40,"f41":41,"f42":42,"f43":43,"f44":44,"f45":45,"f46":46,"f47":47,"f48":48,"f49":49,"f50":50,"f51":51,"f52":52,"f53":53,"f54":54,"f55":55,"f56":56,"f57":57,"f58":58,"f59":59,"f60":60,"f61":61,"f62":62,"f63":63,"f64":64,"f65":65,"f66":66,"f67":67,"f68":68,"f69":69,"f70":70,"f71":71,"f72":72,"f73":73,"f74":74,"f75":75,"f76":76,"f77":77,"f78":78,"f79":79,"f80":80,"f81":81,"f82":82,"f83":83,"f84":84,"f85":85,"f86":86,"f87":87,"f88":88,"f89":89,"f90":90,"f91":91,"f92":92,"f93":93,"f94":94,"f95":95,"f96":96,"f97":97,"f98":98,"f99":99,"a":5,"inner":{"f0":0,"f1":1,"f2":2,"f3":3,"f4":4,"f5":5,"f6":6,"f7":7,"f8":8,"f9":9,"f10":10,"f11":11,"f12":12,"f13":13,"f14":14,"f15":15,"f16":16,"f17":17,"f18":18,"f19":19,"f20":20,"f21":21,"f22":22,"f23":23,"f24":24,"f25":25,"f26":26,"f27":27,"f28":28,"f29":29,"f30":30,"f31":31,"f32":32,"f33":33,"f34":34,"f35":35,"f36":36,"f37":37,"f38":38,"f39":39,"f40":40,"f41":41,"f42":42,"f43":43,"f44":44,"f45":45,"f46":46,"f47":47,"f48":48,"f49":49,"f50":50,"f51":51,"f52":52,"f53":53,"f54":54,"f55":55,"f56":56,"f57":57,"f58":58,"f59":59,"f60":60,"f61":61,"f62":62,"f63":63,"f64":64,"f65":65,"f66":66,"f67":67,"f68":68,"f69":69,"f70":70,"f71":71,"f72":72,"f73":73,"f74":74,"f75":75,"f76":76,"f77":77,"f78":78,"f79":79,"f80":80,"f81":81,"f82":82,"f83":83,"f84":84,"f85":85,"f86":86,"f87":87,"f88":88,"f89":89,"f90":90,"f91":91,"f92":92,"f93":93,"f94":94,"f95":95,"f96":96,"f97":97,"f98":98,"f99":99,"x":3}}')
    show(r'{"f0":0,"f1":1,"f2":2,"f3":3,"f4":4,"f5":5,"f6":6,"f7":7,"f8":8,"f9":9,"f10":10,"f11":11,"f12":12,"f13":13,"f14":14,"f15":15,"f16":16,"f17":17,"f18":18,"f19":19,"f20":20,"f21":21,"f22":22,"f23":23,"f24":24,"f25":25,"f26":26,"f27":27,"f28":28,"f29":29,"f30":30,"f31":31,"f32":32,"f33":33,"f34":34,"f35":35,"f36":36,"f37":37,"f38":38,"f39":39,"f40":40,"f41":41,"f42":42,"f43":43,"f44":44,"f45":45,"f46":46,"f47":47,"f48":48,"f49":49,"f50":50,"f51":51,"f52":52,"f53":53,"f54":54,"f55":55,"f56":56,"f57":57,"f58":58,"f59":59,"f60":60,"f61":61,"f62":62,"f63":63,"f64":64,"f65":65,"f66":66,"f67":67,"f68":68,"f69":69,"f70":70,"f71":71,"f72":72,"f73":73,"f74":74,"f75":75,"f76":76,"f77":77,"f78":78,"f79":79,"f80":80,"f81":81,"f82":82,"f83":83,"f84":84,"f85":85,"f86":86,"f87":87,"f88":88,"f89":89,"f90":90,"f91":91,"f92":92,"f93":93,"f94":94,"f95":95,"f96":96,"f97":97,"f98":98,"f99":99,"inner":{"f0":0,"f1":1,"f2":2,"f3":3,"f4":4,"f5":5,"f6":6,"f7":7,"f8":8,"f9":9,"f10":10,"f11":11,"f12":12,"f13":13,"f14":14,"f15":15,"f16":16,"f17":17,"f18":18,"f19":19,"f20":20,"f21":21,"f22":22,"f23":23,"f24":24,"f25":25,"f26":26,"f27":27,"f28":28,"f29":29,"f30":30,"f31":31,"f32":32,"f33":33,"f34":34,"f35":35,"f36":36,"f37":37,"f38":38,"f39":39,"f40":40,"f41":41,"f42":42,"f43":43,"f44":44,"f45":45,"f46":46,"f47":47,"f48":48,"f49":49,"f50":50,"f51":51,"f52":52,"f53":53,"f54":54,"f55":55,"f56":56,"f57":57,"f58":58,"f59":59,"f60":60,"f61":61,"f62":62,"f63":63,"f64":64,"f65":65,"f66":66,"f67":67,"f68":68,"f69":69,"f70":70,"f71":71,"f72":72,"f73":73,"f74":74,"f75":75,"f76":76,"f77":77,"f78":78,"f79":79,"f80":80,"f81":81,"f82":82,"f83":83,"f84":84,"f85":85,"f86":86,"f87":87,"f88":88,"f89":89,"f90":90,"f91":91,"f92":92,"f93":93,"f94":94,"f95":95,"f96":96,"f97":97,"f98":98,"f99":99,"f77":3}}')
    show(r'{"f0":0,"f1":1,"f2":2,"f3":3,"f4":4,"f5":5,"f6":6,"f7":7,"f8":8,"f9":9,"f10":10,"f11":11,"f12":12,"f13":13,"f14":14,"f15":15,"f16":16,"f17":17,"f18":18,"f19":19,"f20":20,"f21":21,"f22":22,"f23":23,"f24":24,"f25":25,"f26":26,"f27":27,"f28":28,"f29":29,"f30":30,"f31":31,"f32":32,"f33":33,"f34":34,"f35":35,"f36":36,"f37":37,"f38":38,"f39":39,"f40":40,"f41":41,"f42":42,"f43":43,"f44":44,"f45":45,"f46":46,"f47":47,"f48":48,"f49":49,"f50":50,"f51":51,"f52":52,"f53":53,"f54":54,"f55":55,"f56":56,"f57":57,"f58":58,"f59":59,"f60":60,"f61":61,"f62":62,"f63":63,"f64":64,"f65":65,"f66":66,"f67":67,"f68":68,"f69":69,"f70":70,"f71":71,"f72":72,"f73":73,"f74":74,"f75":75,"f76":76,"f77":77,"f78":78,"f79":79,"f80":80,"f81":81,"f82":82,"f83":83,"f84":84,"f85":85,"f86":86,"f87":87,"f88":88,"f89":89,"f90":90,"f91":91,"f92":92,"f93":93,"f94":94,"f95":95,"f96":96,"f97":97,"f98":98,"f99":99,"f99":1}')
    let d=from_json<dict<string int64>>(r'{"p":1,"q":2,"p":3}')
    if d is? TextError printl"dict: {d.message} @{d.line}:{d.column}" else printl"dict: {d}"
    let e=from_json<dict<string int64>>(r'{"p":1,"q":2}')
    if e is? TextError printl"dict: {e.message}" else printl"dict: {e}"
}

# quick
# Literal arms over an optional union: `<true>` and `<false>` together cover its bool.
get = (n:int64):>(int64 | bool)? => {
    if n =? 1 return none
    if n =? 2 return true
    if n =? 3 return false
    n
}
name = (v:(int64 | bool)?):>string => match v {
    <true> => "yes"
    <false> => "no"
    <0> => "zero"
    <none> => "nothing"
    n:int64 => "int {n}"
}
main = () => {
    loop i in [0..5) printl(name(get(i)))
}

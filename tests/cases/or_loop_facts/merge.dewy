merge = (a:array<int64> b:array<int64>):>array<int64> => {
    let out:array<int64> = []
    let i = 0
    let j = 0
    loop i <? a.length or j <? b.length {
        if j >=? b.length {
            out.push(a[i])
            i += 1
        } else if i >=? a.length {
            out.push(b[j])
            j += 1
        } else if a[i] <=? b[j] {
            out.push(a[i])
            i += 1
        } else {
            out.push(b[j])
            j += 1
        }
    }
    out
}
printl(merge([1 4 6] [2 3 7 9]))

# members(U) has one order whatever the spelling, as a union is a set: the integers
# rising, then the strings in text order
Mode:type = <'fast' | 1 | 'slow' | 2>
loop m in members(Mode) print"{m} "
printl("")
Pick:type = <3|1|2>
loop m in members(Pick) print"{m} "
printl("")
CB:type = 'c' | 'b'
BC:type = 'b' | 'c'
loop m in members(CB) print"{m} "
loop m in members(BC) print"{m} "
printl("")

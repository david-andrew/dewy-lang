# exit: 42
$runtime_checks
let order:int64=0
bound=(tag:int64 value:int64)=>{order=order*10+tag return value}
run=()=>{
let stop:int64=8
let r=[bound(1 0),bound(2 2)..bound(3 stop))
stop=100
let saved=r let values:array<int64>=[]
loop x in r {r=[100..101] if x =? 2 continue values.push(x)}
return if order =? 123 and values =? [0 4 6] and 4 in? saved and 4 not in? r 42 else 1
}
main=()=>exit(run())

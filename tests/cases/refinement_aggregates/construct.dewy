R:type=[low:int64=2 high:int64<i => i >=? low>=low]
append=(@xs:array<int64> x:int64):>addr<i => i <? xs.length>=>{
    let i=xs.length
    xs.push(x)
    return i
}
main=()=>{
    let r=R[]
    let saved=r.copy()
    r.high=4
    r.low=3
    $assert saved.low =? 2
    let xs:array<int64 length <? 4>=[1]
    xs.push(2)
    xs.reserve(100)
    $assert xs.length =? 2
    let ys:array<int64>=[]
    let i=append(@ys 3)
    $assert i <? ys.length
    let positive:array<int8<i => i >? 0>>=[1 2]
    positive[1]=3
    printl("{saved.low} {r.low} {r.high} {xs.length} {ys[i]} {positive[1]}")
}

f=(@p:array<int64<(<? p.length)>> i:int64 j:int64):>void=>{
    if i >=? 0 and i <? p.length and j >=? 0 and j <? p.length {
        let t = p[i]
        p[i] = p[j]
        p[j] = t
    }
}
main=():>void=>{
    let p:array<int64<(<? p.length)>> = [2 0 1]
    f(@p 0 1)
    f(@p 0 7)
    printl(p)
}

# A vector lane read twice, `id.x`, is one value: its guard bounds the index.
get=(xs:array<int32> id:ivec2 w:int32 h:int32):>int32=>{
    if id.x >=? 0 and id.x <? w and id.y >=? 0 and id.y <? h and w <=? 4096 and h <=? 4096 and xs.length =? w*h {
        return xs[id.y*w+id.x]
    }
    return 0
}
one=(xs:array<int32> id:ivec2):>int32=>{
    if id.x >=? 0 and id.x <? xs.length { return xs[id.x] }
    return 0
}
main=()=>{ printl(get([int32(1) 2 3 4 5 6] ivec2(1 1) 3 2)) printl(one([int32(1) 2 3] ivec2(2 0))) }

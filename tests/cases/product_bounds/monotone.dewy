# y <? h and w >=? 1 give y*w <? h*w; y <=? h and w >=? 0 give y*w <=? h*w.
first=(xs:array<int> w:int h:int y:int):>int=>{
    if xs.length >=? h*w and w >=? 1 and y >=? 0 and y <? h { return xs[y*w] }
    return 0
}
rows=(xs:array<int> w:int h:int y:int):>int=>{
    if xs.length =? h*w and w >=? 0 and y >=? 0 and y <=? h { return xs[0..y*w).length }
    return 0
}
main=()=>{ printl(first([1 2 3 4 5 6] 3 2 1)) printl(rows([1 2 3 4 5 6] 3 2 2)) }

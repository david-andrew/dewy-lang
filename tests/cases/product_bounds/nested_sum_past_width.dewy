# j <=? n - col lets (k*n + col) + j reach n*n.
dot=(b:array<float64> n:int64 k:int64 col:int64):>float64=>{
    let acc=0.0
    if n <? 1 or n >? 1000000 or b.length not=? n*n or k <? 0 or k >=? n or col <? 0 or col >=? n return 0.0
    let base=k*n+col
    loop j in [0..n-col] { acc += b[base+j] }
    acc
}
main=()=>printl(dot([1.0 2.0 3.0 4.0] 2 1 0))

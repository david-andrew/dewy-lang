$runtime_checks

let copies:int64=0
let moves:int64=0
let drops:int64=0
Owner=type of [value:int64
    $__drop__
    release=():>void=>{drops+=1}
    $__copy__
    duplicate=():>Owner=>{copies+=1 return Owner[value]}
    $__move__
    transfer=():>Owner=>{moves+=1 return Owner[value]}
]
main=()=>{
    {
        let xs:array<Owner length <? 4> = []
        xs.push(Owner[1])
        xs.push(Owner[2])
        let a=xs.pop()
        printl"{a.value} {xs.length} c={copies} m={moves} d={drops}"
    }
    printl"c={copies} m={moves} d={drops}"
}

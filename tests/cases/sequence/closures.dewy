# exit: 42
$runtime_checks
Series:type=[first:int64 count:int64]
length=(s:Series)=>s.count
__index__=(s:Series index:int64)=>s.first+index
run=()=>{let callbacks=[loop x in Series[13 3] ()=>x]
return if callbacks[0]() =? 13 and callbacks[1]() =? 14 and callbacks[2]() =? 15 42 else 1}
main=()=>exit(run())

# A later statement of a run may not leave early: the record would be left half changed.
Index:type = [keys:array<int64> values:array<string length =? keys.length>]
add = (@ix:Index key:int64 v:string?):>void => {
    ix.keys.push(key)
    ix.values.push(v ?? return)
}
main = ():>void => { let ix = Index[[] []] add(@ix 1 none) printl(ix.keys.length) }

# A run that changes the tied fields by different amounts.
Index:type = [keys:array<int64> values:array<string length =? keys.length>]
add = (@ix:Index key:int64 v:string):>void => {
    ix.keys.push(key)
    ix.values.push(v)
    ix.values.push(v)
}
main = ():>void => { let ix = Index[[] []] add(@ix 1 "a") printl(ix.keys.length) }

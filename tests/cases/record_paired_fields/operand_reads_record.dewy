# A later statement of a run may not read the record or call anything.
Index:type = [keys:array<int64> values:array<string length =? keys.length>]
add = (@ix:Index key:int64):>void => {
    ix.keys.push(key)
    ix.values.push("{ix.keys.length}")
}
main = ():>void => { let ix = Index[[] []] add(@ix 1) }

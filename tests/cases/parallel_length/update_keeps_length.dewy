# `parallel @x in xs` stores in place: xs keeps its length, after the loop and across an outer loop
main = () => {
    let shifted = [parallel i in [0..10) i+1]
    parallel @x in shifted { x *= 2 }
    printl(shifted[0])
    let xs = [1 2 3]
    loop k in [0..3) {
        parallel @x in xs { x += k }
        printl(xs[2])
    }
    printl(xs[2])
}

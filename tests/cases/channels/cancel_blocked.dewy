# modes: native native-release
# A receive waiting on an empty channel and a send waiting on a full one are cancellation
# points; when a sibling fails, the group cancels them and each gives Canceled.
Failed:type = type of error
waiter = (c:Channel<int64> waiting:Atomic<int64>):>int64 | Closed | Canceled => {
    waiting.store(1)
    let v = c.receive() or_throw
    v
}
filler = (c:Channel<int64> filled:Atomic<int64>):>int64 | Closed | Canceled => {
    let sent:int64 = 0
    loop true {
        c.send(sent) or_throw
        sent += 1
        if sent =? 2 filled.store(1)
    }
    sent
}
# (it fails once the waiter has started and the filler has filled the channel: a task that
# starts after its group is canceled is skipped, and a canceled send gives Canceled at once)
quitter = (waiting:Atomic<int64> filled:Atomic<int64>):>void | Failed | Canceled => {
    loop waiting.load() =? 0 or filled.load() =? 0 { sleep(1ms) or_throw }
    sleep(0.01s) or_throw
    return Failed
}
main = () => {
    let empty = channel<int64>(1)
    let full = channel<int64>(2)
    let waiting = atomic(0)
    let filled = atomic(0)
    concurrent {
        let a = spawn waiter(empty waiting)
        let b = spawn filler(full filled)
        spawn quitter(waiting filled)
    }
    printl"receive canceled: {a is? Canceled}"
    printl"send canceled: {b is? Canceled}"
    # (the full channel kept what was sent before the send waited)
    printl"kept: {full.receive()} {full.receive()}"
    # Level-triggered: in a canceled group, every later wait gives Canceled, even one that
    # would not wait; the value stays for a receive outside it.
    empty.send(7) or_throw
    let gave_canceled = false
    concurrent g {
        cancel(g)
        gave_canceled = empty.receive() is? Canceled
    }
    printl"in the canceled group: {gave_canceled}"
    printl"after it: {empty.receive()}"
}

# exit: 42
apply=(f:<(value:int64):>bool> value:int64):>bool=>f(value)
run=()=>{let limit=10
if not apply((<?limit) 9) or apply((>=?limit) 9) return 1
if not apply((not=?limit) 9) or apply((=?limit) 9) return 2
if not apply((in?[9 10]) 9) or apply((not in?[9 10]) 9) return 3
return 42}
main=()=>exit(run())

# quick
main=():>void=>{
    let s="héllo wörld"
    let n=(s as array<uint8>).length
    printl"{s.byte_slice(0 1)}|{s.byte_slice(1 3)}|{s.byte_slice(7 n)}|{s.byte_slice(n n)}|"
    printl(s.byte_slice(0 n) =? s)
    let word=s.byte_slice(7 13)
    printl"{word} {word.length} {(word as array<uint8>).length}"
}

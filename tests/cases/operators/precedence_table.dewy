# quick
# The precedence table in docs/LANGUAGE.md, from the archived reference.
main=()=>{
    let x:int64=3
    let y:int64=4
    printl(~x^2)           # (~x)^2
    printl(~x*2)           # (~x)*2
    printl(-x^2)           # -(x^2)
    printl(-x*y)           # -(x*y)
    printl(2^3x)           # (2^3)*x
    printl(1 + 2 << 1)     # (1+2) << 1
    printl(x & 1 =? 1)     # (x & 1) =? 1
    printl(not x =? y)     # not (x =? y)
    printl(not x =? 3 and y =? 4)
    let o:int64|none=none
    printl(o ?? 1 =? 1)    # (o ?? 1) =? 1
    printl((x as float64) + 0.5)
}

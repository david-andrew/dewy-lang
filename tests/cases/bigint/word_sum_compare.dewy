# A sum of two integers compared with a third is exact, even past the 64-bit range.
compare=(x:int64 k:int64 n:int64):>string=>{
    let i:int=x
    let j:int=k
    "{i + j <? n} {i + j <=? n} {i + j >? n} {i + j >=? n} {i + j =? n} {i + j not=? n} {n <? i + j} {n >? i + j}"
}
main=():>void=>{
    printl(compare(int64.max - 2 5 int64.max))
    printl(compare(int64.min + 1 (-5) int64.min))
    printl(compare(3 4 7))
    printl(compare(3 4 8))
    printl(compare(int64.max 0 int64.max))
    printl(compare(int64.max 1 int64.max))
}

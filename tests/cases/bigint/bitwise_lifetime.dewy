# exit: 42
from bigint import BigInt, bigint
exercise=():>void=>{
let a:BigInt=123456789012345678901234567890 let b:BigInt=-98765432109876543210987654321
let saved=a
loop i in [0..20) {
    let shifted=a << i
    let mixed=(a and b) or (a xor b)
    if (shifted >> i) not=? saved or mixed not=? (a or b) panic("bit operation mismatch")
    a=not (not a)
}
}
run=()=>{exercise() let before=alloc_count() exercise()
return if before =? alloc_count() 42 else 1}
main=()=>exit(run())

# A drop inside a while loop invalidates the guard made before the loop.
let data:array<int64>=[1 2 3]
Shrink=type of [id:int64
    $__drop__
    release=():>void=>{data=[]}
]
total=(n:int64):>int64=>{
    let last:int64=0
    if 0 <=? n and n <=? data.length {
        let i=0
        loop i <? n {
            last=data[i]
            {let _s=Shrink[i]}
            i+=1
        }
    }
    last
}
main=()=>{printl(total(3))}

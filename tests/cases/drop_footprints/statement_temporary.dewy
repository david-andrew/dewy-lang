# A statement's temporary drops at its end, before the next statement.
let data:array<int64>=[1 2 3]
Shrink=type of [id:int64
    $__drop__
    release=():>void=>{data=[]}
    ok=():>bool=>id >? 0
]
pick=(i:int64):>int64=>{
    if 0 <=? i and i <? data.length {
        let _fine=Shrink[1].ok
        return data[i]
    }
    0
}
main=()=>{printl(pick(1))}

# Handle-like owners beside array proofs. A handle's drop hook closes it by
# updating global counters only, so facts about the arrays a function
# borrows survive every close: at inner block ends, statement ends,
# replacements, loop iterations and match arms. Asking a handle `ready`
# borrows it, and opening one moves it out of `open_handle`: neither closes
# anything, so guards made before them still prove the index after them.
let closed:int64=0
let last_fd:int64=-1
Handle=type of [fd:int64 path:string
    $__drop__=():>void=>{
        closed+=1
        last_fd=fd
    }
    ready=():>bool=>fd >=? 0
]
open_handle=(fd:int64):>Handle=>Handle[fd "data.bin"]
# Binary search over the sorted keys a caller lends, closing a probe handle
# each step.
search=(@keys:array<int64> target:int64):>int64=>{
    let lo=0
    let hi=keys.length
    loop lo <? hi {
        let mid=lo+(hi-lo)//2
        {let _probe=open_handle(mid)}
        if keys[mid] <? target {lo=mid+1} else {hi=mid}
    }
    lo
}
# Copy a window of rows into a buffer through a replaced handle.
window=(@rows:array<int64> @out:array<int64> start:int64):>int64=>{
    if start <? 0 or start >=? rows.length or out.length =? 0 {return 0}
    let h=open_handle(start)
    if not h.ready {return 0}
    out[0]=rows[start]
    let copied=1
    let i=start+1
    loop i <? rows.length and copied <? out.length and h.ready {
        out[copied]=rows[i]
        h=open_handle(i)
        copied+=1
        i+=1
    }
    copied
}
# A handle per lookup, its readiness tested inline, then an index.
lookup=(@table:array<int64> slots:array<int64>):>int64=>{
    let hits=0
    loop slot in slots {
        if 0 <=? slot and slot <? table.length and open_handle(slot).ready {
            if table[slot] >? 0 {hits+=1}
        }
    }
    hits
}
# An optional handle taken by a match arm, then a guarded read.
first_ready=(@table:array<int64> fd:int64):>int64=>{
    let maybe:Handle?=if fd >=? 0 {open_handle(fd)} else {none}
    if table.length =? 0 {return 0}
    match maybe {
        h:Handle => {if h.ready {printl"handle {h.fd} ready"}}
        _ => {printl"no handle"}
    }
    table[0]
}
main=()=>{
    let keys:array<int64>=[2 3 5 7 11 13 17 19]
    printl(search(@keys 11))
    printl(search(@keys 4))
    let rows:array<int64>=[10 20 30 40 50]
    let out:array<int64>=[0 0 0]
    printl(window(@rows @out 1))
    printl(out)
    let table:array<int64>=[0 4 0 9]
    printl(lookup(@table [1 3 7 (-1) 2]))
    printl(first_ready(@table 3))
    printl(first_ready(@table (-1)))
    printl"closed {closed}, last {last_fd}"
}

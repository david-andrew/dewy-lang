# quick
# exit: 42
main=()=>{
    let text="abc"
    let count=0
    loop ch in text {count+=1}
    if count=?3 {let text="other" printl(text)}
    let a=5
    a=300
    if a not=? 300 {return 0}
    let big=9223372036854775807
    big+=1
    if big not=? 9223372036854775808 {return 0}
    return match text {<"abc">=>count+39}
}

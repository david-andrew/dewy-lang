# Under `$runtime_checks` a GPU function's stores are still proved, from its guards: a
# shader cannot run the check, so an unproven one is an error (exact_store_unproven_bad).
$runtime_checks
Shift:type=[src:GpuBuffer<int32> dst:GpuBuffer<int32>]
back=(id:int64 u:Shift):>void=>{
    if id >? 0 and id <? 1000000 { u.dst[id]=u.src[id-1] } else { u.dst[id]=u.src[id] }
}
inc=(x:int32):>int32=>{
    if x <? 1000 and x >? -1000 { return x+1 }
    return 0
}
main=()=>{
    let a=gpu_buffer([int32(-9) 5 -7 40])
    let b=gpu_buffer<int32>(4)
    dispatch(compute(@back) 4 Shift(a b))
    printl(cpu(b))
    printl(cpu(inc.(gpu([int32(-9) 5 999]))).data)
}

# modes: native native-release
# A refined C result is the `$extern` declaration's claim, trusted like a
# `ptr<T>` result being non-null: here it proves the conversion to uint8.
Byte:type = int32<b => b >=? 0 and b <=? 255>
toupper = (c:int32):>Byte => $extern
upper = (c:int32):>uint8 => uint8($unsafe toupper(c))
main = ():>void => printl(upper(97) $unsafe toupper(98))

# exit: 42
signed=(take:bool a:int8<overflow='wrap'> b:int8<overflow='wrap'>):>int8<overflow='wrap'>=>if take a+1 else b-1
unsigned=(take:bool a:uint64<overflow='wrap'> b:uint64<overflow='wrap'>):>uint64<overflow='wrap'>=>if take a xor b else a+b
run=()=>{let high:uint64<overflow='wrap'>=18446744073709551615
return if signed(true 127 0)=?(-128) and signed(false 0 (-128))=?127
and unsigned(true high 1)=?18446744073709551614 and unsigned(false high 1)=?0 42 else 1}
main=()=>exit(run())

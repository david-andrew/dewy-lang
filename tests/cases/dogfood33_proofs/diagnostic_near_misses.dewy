let released:int64 = 0
Batch:type = type of [id:int64 $__drop__ = ():>void => { released += 1 }]
use_batch = ():>void => { let batch = Batch[1]; printl(batch.id) }
main = () => {
    use_batch()
    printl(released)
    let d = ["a" -> 1]
    printl(d.get("b") ?? 0)
    let present:dict<string int?> = ["a" -> none]
    printl(present["a"] ?? 7)
}

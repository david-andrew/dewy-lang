$runtime_checks
# Containers whose elements carry a refinement: maps, sets and nested arrays.
Nat:type=int64<(>=? 0)>
Pos:type=int64<(>? 0)>
main=()=>{
    let d:dict<string array<Nat>>=["a"->[1 2] "b"->[3] "c"->[]]
    d["d"]=[4]
    d["b"].push(7)
    printl(d.pop("a"))
    printl(d.pop("c"))
    printl(d.pop("d"))
    printl(d)
    let e:dict<string Pos>=["a"->1 "b"->2]
    e["c"]=3
    e["a"]=e["a"]+1
    printl(e)
    printl(e.get("z") ?? 1)
    printl("b" in? e)
    let n:dict<string Nat>=["a"->1 "b"->0]
    n["a"]+=1
    printl(n.pop("a"))
    printl(n)
    let s:set<Pos>=set[1 2 3]
    s.push(4)
    printl(s.length)
    printl(3 in? s)
    let ys:array<array<Pos>>=[[1] [2 3]]
    ys.push([5])
    ys[0].push(9)
    printl(ys)
}

# A guard on the arguments proves another parameter's refinement.
clamp = (v:int lo:int hi:int<(>=? lo)>):>int => if v <? lo lo else if v >? hi hi else v
pick = (row:array<int> x:int):>int => {
    if row.length =? 0 return 0
    clamp(x 0 row.length - 1)
}
main = () => printl(pick([1 2 3] 5) pick([1 2 3] -4))

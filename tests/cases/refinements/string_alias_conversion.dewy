# stdin: green\n
# modes: native native-release
# A literal-union reader returns checked values; proven stores and casts keep
# their obligation, and a subset widens without a reader.
Color:type = 'red' | 'green'
Wide:type = 'red' | 'green' | 'blue'
name = (c:Color):>string => match c {
    <'red'> => "R"
    <'green'> => "G"
}
main = ():>void | ValidationError | Canceled => {
    let text = read_line() ?? "red"
    let c = Color(text) or_throw
    let w:Wide = c
    let back = Color(w) or_throw
    let same = if text is? Color text as Color else 'red'
    printl"{name(Color('red') or_throw)} {name(c)} {w} {back} {same} {c =? same} {'green' as Color}"
}

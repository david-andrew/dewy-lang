main = () => {
    let flags:uint8 = 0b1111
    flags &= 0b0110
    printl(flags)
    flags |= 0b1000
    printl(flags)
    let n:int64 = 12
    n and= 10
    printl(n)
    n or= 3
    printl(n)
    n xor= 1
    printl(n)
    let ok = true
    ok and= false
    printl(ok)
    ok or= true
    printl(ok)
    let xs = [5 6]
    xs[0] |= 2
    printl(xs)
    let a = set[1 2 3]
    a &= set[2 3 4]
    printl(a)
    a or= set[9]
    printl(a)
    let and_n = 1
    printl(and_n)
}

# exit: 42
Box:type=[value:int8<overflow='wrap'>]
__index__=(box:Box i:int64<overflow='wrap'>):>int8<overflow='wrap'>=>box.value
__setindex__=(@box:Box i:int64<overflow='wrap'> value:int8<overflow='wrap'>):>void=>{box.value=value}
run=()=>{let box=Box[-128] box[0]//=-1 box[0]%=3
return if box.value =? 1 42 else 1}
main=()=>exit(run())

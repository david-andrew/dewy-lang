f = (a:array<int> b:array<int>):>int => {
    let prev:array<int> = [loop j in [0..b.length] j]
    loop i in [1..a.length] {
        let cur:array<int> = [i]
        loop j in [1..b.length) {
            cur.push(prev[j + 1] + cur[j - 1])
        }
        prev = cur
    }
    0
}
main = () => printl(f([1 2] [3 4]))

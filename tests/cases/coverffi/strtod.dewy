# modes: native native-release
# Parse a run of numbers from one buffer with strtod, following its end pointer.
$extern
strtod = (s:ptr<uint8> stop:ptr<ptr<uint8>?>):>float64

parse_all = (text:string):>array<float64> => $unsafe {
    let buf = bytes(text)
    buf.push(0)
    let out:array<float64> = []
    let at = buf.ptr
    let stop:array<ptr<uint8>?> = [none]
    loop _ in [0..buf.length) {
        let value = strtod(at stop.ptr)
        let next = stop[0]
        if next is? none break
        if next =? at break
        out.push(value)
        at = next
    }
    out
}

main = () => {
    printl(parse_all("1.5 -2 3e2  0.125 x 9"))
}

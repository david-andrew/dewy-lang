# Nothing shows the handle is in the store: the call is an error, which names both.
Store:type=[live:array<bool>]
Slot:type=[i:int64]
contains=(s:Store h:Slot):>bool=>h.i >=? 0 and h.i <? s.live.length and s.live[h.i]
get=(s:Store h:Slot<(in? s)>):>int64=>h.i
main=():>void=>{
    let s=Store[[true false]]
    let free=Slot[1]
    printl(get(s free))
}

# An assigned array whose extents match the selection axis by axis has the right count.
f = (@m:array<float64 length=[r c]>):>void => {
    if r <? 3 or c <? 3 return
    let h = r-1 let w = c-1
    let a = m[[1..h) [1..w)]
    m[[1..h) [1..w)] = a
    m[[1..h) [1..w)] .+= a .* 2.0
    m[[2..h] [1..w)] = a .+ 1.0
}
main = ():>void => {
    let m = zeros(3 3)
    f(@m)
    printl(m.data)
}

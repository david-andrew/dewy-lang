$runtime_checks
let number:int = 28
let key = number as Key
printl(int64(key))
printl(int32(key))
printl(uint8(key))
printl(int(key))
printl(int64(key as int))
printl(int32(key as int))
printl(uint8(key as int))
printl(int64(Key.n1 as int))
printl(int64(Key.n1 as int64))
printl(int64(int64(28) as Key))
printl(int64(uint8(28) as Key))
printl(int64(2 as Mouse))
printl(int(Mouse.right))
printl(int64(Mouse.right as int))
printl(int64(3 as PadButton))
printl(int64(PadButton.y as int))
printl(int64(28 as Key))

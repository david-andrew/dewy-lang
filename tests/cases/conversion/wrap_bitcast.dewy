# quick
main=()=>{
    let big:int64=-1
    printl(big.wrap(uint64))
    printl(big.wrap(uint8))
    let x:int64=300
    printl(x.wrap(uint8))
    printl(x.wrap(int8))
    let n=2^70+5
    printl(n.wrap(uint8))
    printl(float64(1.0).bitcast(uint64))
    printl(uint64(4607182418800017408).bitcast(float64))
    printl(float32(-0.0).bitcast(uint32))
    let ok:int64=200
    if 0 <=? ok <=? 255 { printl(uint8(ok)) }
    printl(ok as uint8)
}

# quick
main=()=>{
    let big:int64=-1
    printl(wrap<uint64>(big))
    printl(wrap<uint8>(big))
    let x:int64=300
    printl(wrap<uint8>(x))
    printl(wrap<int8>(x))
    let n=2^70+5
    printl(wrap<uint8>(n))
    printl(float64(1.0) transmute uint64)
    printl(uint64(4607182418800017408) transmute float64)
    printl(float32(-0.0) transmute uint32)
    let ok:int64=200
    if 0 <=? ok <=? 255 { printl(uint8(ok)) }
    printl(ok as uint8)
}

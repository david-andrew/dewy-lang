# exit: 42
# Float-to-integer conversions truncate toward zero; the value must fit.
run=()=>{let a:float64=42.9 let high:float64=255.9 let low:float64=-128.5 let small:float64=-0.5
return if (a as int64) =? 42 and (high as uint8) =? 255 and (low as int8) =? -128 and (small as uint64) =? 0 42 else 1}
main=()=>exit(run())

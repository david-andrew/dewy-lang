# exit: 42
$runtime_checks
let word="first"
spec=():>string=>{word="later" return ">8"}
run=()=>{
# (the pattern first, then the value: `fmt(p)` gives the function that is then called)
let result=fmt(spec())(word) ?? ""
if result not=? "   later" or word not=? "later" return 1
let pattern=".2f"
if fmt(pattern)(1.125) not=? "1.12" return 2
return 42
}
main=()=>exit(run())

# exit: 42
# quick
probe=(is:int64? isnt:int64? notin:int64):>int64=>{
if false or not true return 1
if (is is? none) or (isnt isnt? int64) return 2
if not (is in? [20 21]) or notin not in? [22] return 3
let iffy=is
let λ=notin
return iffy+λ}
run=()=>probe(20 21 22)
main=()=>exit(run())

$runtime_checks

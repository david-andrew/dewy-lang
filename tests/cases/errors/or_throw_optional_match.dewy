# The match the diagnostic suggests forwards the error and keeps the optional.
Oops:type=type of error & [code:int64]
lookup=(x:int64):>int64?|Oops=>if x <? 0 Oops[x] else if x =? 0 none else x*10
use=(x:int64):>int64|Oops=>{
    match lookup(x) {
        failure:Oops => return failure
        found:int64 => return found+1
        _ => return 0
    }
}
printl(use(3))
printl(use(0))
printl(use(-1))

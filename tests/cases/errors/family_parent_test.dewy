# `is?` and `match` on a minted parent with a child narrow to the family, whose fields
# each member reads (at the top level, on a field path, in a function)
Ticket:type = type of error & [message:string code:int64=1]
Late:type = type of Ticket & [minutes:int64]
f = (k:int64):>int64|Ticket => if k =? 0 Late["late" 2 5] else if k =? 1 Ticket["plain" 3] else k
show = (t:Ticket) => printl"{t.message} {t.code}"
let r = f(0)
if r is? Ticket { printl(r.message) }
let s = f(5)
if s is? Ticket { printl(s.code) } else { printl(s + 1) }
Box:type = [v:int64|Ticket]
let b = Box[f(1)]
if b.v is? Ticket { printl(b.v.code) }
if r is? Late { printl(r.minutes) }
main = () => {
    loop k in [0 1 2] {
        let x = f(k)
        match x {
            <Ticket> => printl(x.message)
            _ => printl"value {x}"
        }
    }
    show(Late["l" 7 1])
    show(Ticket["p" 8])
}

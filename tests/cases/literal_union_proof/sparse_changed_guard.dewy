const KEEP0="a0"
const NOISE0="gap0"
const KEEP1="a1"
const NOISE1="gap1"
const KEEP2="a2"
const NOISE2="gap2"
const KEEP3="a3"
const NOISE3="gap3"
const KEEP4="a4"
const NOISE4="gap4"
const KEEP5="a5"
const NOISE5="gap5"
const KEEP6="a6"
const NOISE6="gap6"
const KEEP7="a7"
const NOISE7="gap7"
Action:type='a0'|'a1'|'a2'|'a3'|'a4'|'a5'|'a6'|'a7'
convert=(s:string):>Action=>{if s is? Action {s="bad"; return s as Action}; 'a0'}
main=()=>{printl(convert("a7"))}

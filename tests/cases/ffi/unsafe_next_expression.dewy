# modes: native
# `$unsafe` covers the next expression, on its line or the next; `$unsafe { ... }` several.
$extern
getpid=():>int32
main=():>void=>{
    let a = $unsafe getpid()
    $unsafe printl(getpid() >? 0)
    $unsafe
    printl(getpid() =? a)
    $unsafe {
        let b = getpid
        printl(b =? a)
    }
}

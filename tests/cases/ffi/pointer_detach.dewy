# modes: native native-release
# A pointer to an array's elements: written through, the array is its own (others sharing
# its elements keep theirs); only read through, nothing is copied.
fill=(p:ptr<uint8> n:int64 v:uint8):>void=>{
    $unsafe
    loop i in [0..n) {p[i]=v}
}
total=(p:ptr<uint8> n:int64):>int64=>{
    $unsafe
    let s:int64=0
    loop i in [0..n) {s+=int64(p[i])}
    s
}
# (a parameter's pointer, written through: the caller's array stays as it was)
scribble=(a:array<uint8>):>int64=>{
    $unsafe
    let q=a.ptr + 1
    q[0]=99
    a[1]
}
via_call=(a:array<uint8>):>int64=>{
    $unsafe
    fill(a.ptr a.length 5)
    total(a.ptr a.length)
}
read_only=(a:array<uint8>):>int64=>{
    $unsafe
    let p=a.ptr
    let w=(p as ptr<uint16>)[0]
    total(p a.length) + int64(w) + int64((p + 2)[0])
}
memset=(p:ptr<uint8> c:int32 n:uint64):>ptr<uint8> => $extern
main=():>void=>{
    $unsafe
    let a:array<uint8>=[1 2 3 4]
    let b=a
    printl"{scribble(a)} {a} {via_call(a)} {a} {read_only(a)}"
    let c=a
    let p=c.ptr
    p[0]=42
    printl"{a} {b} {c}"
    let d=a
    memset(d.ptr 7 2)
    printl"{a} {d}"
    let e=a
    let r=e.ptr
    let shifted=if e.length >? 2 r + 2 else r
    shifted[0]=11
    printl"{a} {e}"
}

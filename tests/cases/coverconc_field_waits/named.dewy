# modes: native native-release
Routes:type = [inbox:Channel<string> count:int]
main = () => {
    let routes = Routes[channel<string>(1) 0]
    let ready = @routes.inbox.receive
    routes.inbox.send("message") or_throw
    match select(@ready) {
        s:(@ready).string => printl(s)
        _ => {}
    }
    routes.inbox.close()
    match select(@ready) {
        <(@ready).Closed> => printl"closed"
        _ => {}
    }
}

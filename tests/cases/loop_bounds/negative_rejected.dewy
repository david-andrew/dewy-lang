f = (@xs:array<int64 length >? 0> steps:array<int64>):>int64 => {
    let at = 0
    loop step in steps {
        if step >? 0 {
            xs.push(step)
            at = xs.length - 1
        } else { at = xs.length - 2 }
    }
    xs[at]
}
main = () => {
    let a:array<int64 length >? 0> = [1]
    printl(f(@a [-1]))
}

# A count past the match, not a position: it may equal the length.
past = (xs:array<float32> p:vec2):>int? => {
    loop i in [0..xs.length) if xs[i] >? p.x return i + 1
    none
}
main = () => {
    let xs:array<float32> = [1.0 4.0 9.0]
    let k = past(xs vec2(3 1))
    if k isnt? none printl(xs[k])
}

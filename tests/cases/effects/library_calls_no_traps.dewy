# quick
$runtime_checks=false
# (no traps: none of these library calls may panic on its arguments)
scale=(x:rational y:rational):>rational=>x*y+y
share=(x:rational n:int64):>rational=>if n not=? 0 x/n else x
main=():>void=>{
    printl(0.1+0.2)
    printl(scale(0.1 0.2))
    let harmonic=0/1
    loop n in [1..5) {harmonic+=1/n}
    printl(harmonic)
    printl(1/3)
    let x=0.75
    printl"{x/0.5} {x/2} {x//0.25} {x%0.5} {share(x 3)} {(1/6)^2}"
    printl([1 2 ; 3 4])
    printl(ones(2 2))
    printl(zeros<int64>(2 3).shape)
    printl(eye(2))
    printl([parallel i in [0..5) i*i])
    let bytes:array<uint8>=[1 2 3 4 5 6 7 8 9]
    printl(bytes.read<uint64>(1))
    printl(("abcdefghij" as array<uint8>).read<uint32>(2))
    let table:array<int64>=[loop i in [0..256) i*2]
    let k:int16=300
    printl(table[uint8<overflow='wrap'>(k)])
}

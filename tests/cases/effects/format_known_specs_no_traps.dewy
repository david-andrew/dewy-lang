$runtime_checks=false
# (no traps: a specification the compiler knows, a literal or a binding written
# once, is checked while compiling; an unbounded integer's format included)
Spec:type="<6" | ">6"
show=(x:int64 spec:Spec):>string=>fmt(spec)(x) ?? ""
main=():>void=>{
    printl(fmt'>8'(5))
    printl(fmt'.2e'(12500))
    let pattern=".2f"
    printl(fmt(pattern)(1.125))
    printl(fmt'#x'(255))
    printl(show(42 ">6"))
}

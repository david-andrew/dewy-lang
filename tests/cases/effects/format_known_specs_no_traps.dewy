$runtime_checks=false
# (no traps: a specification the compiler knows, a literal or a binding written
# once, is checked while compiling; an unbounded integer's format included)
Spec:type="<6" | ">6"
show=(x:int64 spec:Spec):>string=>format(x spec)
main=():>void=>{
    printl(format(5 ">8"))
    printl(format(12500 ".2e"))
    let pattern=".2f"
    printl(format(1.125 pattern))
    printl(format(255 "#x"))
    printl(show(42 ">6"))
}

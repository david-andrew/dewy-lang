# quick
# Operations on secrets: comparisons give bools, arithmetic gives secrets, `.reveal` the value.
check = (pw:secret<string> attempt:string):>bool => pw =? attempt
scale = (k:secret<int64> x:int64):>secret<int64> => k * x + 7
bump = (@k:secret<int64>):>void => { k += 1 }
id = <T>(x:T):>T => x
Login:type = [user:string pass:secret<string>]
let pw:secret<string> = "open sesame"
printl(check(pw "open sesame") check(pw "guess"))
printl(scale(secret(5) 2).reveal)
let n:secret<int64> = 41
bump(@n)
printl(n.reveal (-n).reveal)
let total = secret(0)
loop i in [1..4] { total += i }
printl(total =? 10 total <? 3)
printl(id(secret("x")) =? secret("x"))
printl([secret("a") secret("b")].contains(secret("b")))
printl(max(secret(1) secret(2)).reveal)
let a = Login["ann" "p"]
printl(a =? Login["ann" "p"] a =? Login["ann" "q"])
let vault = [secret("k1") -> 1 secret("k2") -> 2]
printl(vault[secret("k2")])
a.pass = "changed"
printl(a.pass.reveal.length)
let typed = "abc" as secret<string>
printl(typed.reveal)
let read = () => n.reveal * 2
printl(read())

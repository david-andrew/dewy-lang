# quick
# A secret's value reaches no output: printing, interpolation, text, records, containers.
Login:type = [user:string pass:secret<string>]
let key = secret("hunter2")
printl(key)
printl"key={key}"
printl(string(key))
printl(Login["ann" key])
printl"{Login["ann" key]}"
printl([secret(1) secret(2)])
printl(["vault" -> key])
let maybe:secret<int64>? = secret(7)
printl(maybe)
let either:secret<int64>|string = secret(7)
printl(either)
printl(hash(key))
printl(key.reveal)

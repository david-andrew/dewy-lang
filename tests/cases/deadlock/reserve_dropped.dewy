# modes: native native-release
# A permit dropped unsent gives its slot back: the later sends fit the capacity of one.
main = () => {
    let q = mpmc<int64>(1)
    {let held = q.reserve}
    q.send(1);
    printl"{q.receive or_throw}"
    let c = channel<int64>(1)
    match c.reserve {
        _:Reserved<int64> => {}
        _ => {}
    }
    c.send(2);
    printl"{c.receive or_throw}"
    loop i in [0..3) {
        {let held = q.reserve}
        q.send(i);
        printl"{q.receive or_throw}"
    }
}

# modes: native native-release
transfer = (src:Mutex<int64> dst:Mutex<int64> amount:int64):>void => {
    let a = @(src.lock())
    let b = @(dst.lock())
    a -= amount
    b += amount
}
main = () => {
    let x = mutex<int64>(100)
    let y = mutex<int64>(100)
    concurrent {
        spawn transfer(x y 10)
        spawn transfer(y x 20)
    }
    printl"done"
}

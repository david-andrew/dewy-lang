# quick
# Mutex<T>: `@(m.lock())` lends the payload until the place's last use; `try_lock` gives Busy
# while another holder has it; copies of the handle share the lock.
main = () => {
    let m = mutex<int64>(10)
    let a = @(m.lock())
    match @(m.try_lock()) {
        <Busy> => printl"busy while a lives"
        n:int64 => printl"got {n}"
    }
    a += 5
    match @(m.try_lock()) {
        <Busy> => printl"busy"
        n:int64 => {
            n += 1
            printl"got {n} after a's last use"
        }
    }
    let copy = m
    let c = @(copy.lock())
    c *= 2
    printl"{c}"
    let names = mutex(["a"])
    let n = @(names.lock())
    n.push("b")
    printl"{n}"
}

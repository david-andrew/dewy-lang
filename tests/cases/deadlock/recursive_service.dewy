# A recursive service whose lock's place ends before it serves the sub-request runs; the one
# keeping it across the recursive call is recursive_service_held.dewy's error.
serve = (m:Mutex<int64> depth:int64):>int64 => {
    let state = @(m.lock())
    state += 1
    if depth >? 0 return serve(m depth - 1) + 1
    return 0
}
main = () => {
    let m = mutex<int64>(0)
    printl"{serve(m 3)}"
    let s = @(m.lock())
    printl"served {s}"
}

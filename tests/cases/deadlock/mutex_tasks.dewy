# modes: native native-release
# Tasks and parallel iterations share a Mutex by copying its handle.
bump = (m:Mutex<int64> times:int64):>int64 => {
    loop i in [0..times) {
        let c = @(m.lock())
        c += 1
    }
    times
}
main = () => {
    let total = mutex<int64>(0)
    concurrent {
        spawn bump(total 20000)
        spawn bump(total 20000)
        spawn bump(total 20000)
    }
    let t = @(total.lock())
    printl"tasks: {t}"
    let sum = mutex<int64>(0)
    parallel i in [0..1000) {
        let s = @(sum.lock())
        s += i
    }
    let s = @(sum.lock())
    printl"parallel: {s}"
}

# A library holding its lock while it calls back: the callback taking the same lock waits forever.
notify = (m:Mutex<int> listener:<(i:int):>void>):>void => {
    let state = @(m.lock())
    state += 1
    listener(state)
}
main = () => {
    let m = mutex(0)
    notify(m (i:int):>void => {
        let again = @(m.lock())
        again += i
    })
}

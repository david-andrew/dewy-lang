# The guarded sum is a value of `r` and `c` at the guard: after `r` changes,
# `r + c` is a different value and the old guard says nothing about it.
pair = (xs:array<int> r0:int c:int) => {
    let r = r0
    if 0 <=? r + c <? xs.length {
        r += 1
        printl(xs[r + c])
    }
}
main = () => { pair([1 2 3] 1 1) }

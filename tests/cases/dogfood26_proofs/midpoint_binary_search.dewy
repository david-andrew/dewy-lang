# `(lo + hi) // 2` with `lo <? hi` lies in [lo, hi): a binary search's probe.
count_at_most = (xs:array<int> t:int):>int => {
    let lo = 0
    let hi = xs.length
    loop lo <? hi {
        let mid = (lo + hi) // 2
        if xs[mid] <=? t lo = mid + 1 else hi = mid
    }
    lo
}
first_at_least = (xs:array<int> t:int):>int => {
    let lo = 0
    let hi = xs.length
    loop lo <? hi {
        let mid = (hi + lo) // 2
        if xs[mid] <? t lo = mid + 1 else hi = mid
    }
    lo
}
probe = (xs:array<int> lo:int hi:int):>int => {
    if not (0 <=? lo <? hi <=? xs.length) return -1
    xs[(lo + hi) // 2]
}
main = () => {
    let xs = [1 3 5 5 7 9]
    printl(count_at_most(xs 5))
    printl(first_at_least(xs 5))
    printl(first_at_least(xs 10))
    printl(probe(xs 2 5))
}

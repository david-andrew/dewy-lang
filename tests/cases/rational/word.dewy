# quick
# rational<int64>: int64 parts; + - * / ^ and negation give Overflow when the
# exact normalized result leaves them.
step=(acc:rational<int64> by:rational<int64>):>rational<int64>|Overflow=>acc+by
main=():>void=>{
    let acc:rational<int64>=0
    let third:rational<int64>=1/3
    loop i in [0..300) {
        let next=step(acc third)
        if next is? Overflow exit(1)
        acc=next
    }
    printl("{acc} {acc =? 100} {acc <? 101} {third.numerator+third.denominator}")
    let n:int64=7
    let w:rational<int64>=n
    let q=w/2
    if q is? Overflow exit(2)
    printl("{q} {int(q)} {q.floor()}")
    let top:rational<int64>=9223372036854775807
    printl("{top+1 is? Overflow} {top*2 is? Overflow} {top-1 is? Overflow}")
    let low:rational<int64>=-9223372036854775808
    printl("{-low is? Overflow} {-top is? Overflow} {low/(-1) is? Overflow}")
    let tiny:rational<int64>=1/3037000500
    printl("{tiny*tiny is? Overflow} {tiny^2 is? Overflow} {third^39 is? Overflow} {third^40 is? Overflow}")
    let exact:rational=third
    printl("{exact/3} {third+1/6} {exact+third} {third*exact}")
    let f:float64=third
    printl(f)
}

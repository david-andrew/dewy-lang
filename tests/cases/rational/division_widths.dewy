# exit: 42
divide=(a b)=>a/b
run=()=>{
if divide(7 as int8 -3 as int16) not=? (-7)/3 return 1
if divide(uint64(18446744073709551615) -1) not=? bigint(-18446744073709551615) return 2
if divide(-9223372036854775808 uint64(18446744073709551615)) not=? (-9223372036854775808)/uint64(18446744073709551615) return 3
return if bigint(123456789012345678901234567890)/10 =? bigint(12345678901234567890123456789)
and 1/bigint(123456789012345678901234567890)*bigint(123456789012345678901234567890) =? 1 42 else 4
}
main=()=>exit(run())

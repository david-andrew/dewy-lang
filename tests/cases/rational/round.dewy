# `.round()`: the nearest integer, a half away from zero; `rounding=` names another rule.
main=():>void=>{
    printl("{(5/2).round()} {(7/2).round()} {(-5/2).round()} {(-7/2).round()} {(1/2).round()} {(-1/2).round()}")
    printl("{(1/3).round()} {(2/3).round()} {(-2/3).round()} {rational(4).round()}")
    let big=(10^30+1)/2
    printl(big.round())
    printl(big.round(rounding='nearest_even'))
    let w:rational<int64>=5/2
    printl("{w.round()} {w.round(rounding='nearest_even')}")
    printl("{(5/2).round(rounding='nearest_even')} {(7/2).round(rounding='nearest_even')} {(-5/2).round(rounding='nearest_even')}")
    printl("{(5/2).round(rounding='nearest_toward_zero')} {(-5/2).round(rounding='nearest_toward_zero')} {(-5/2).round(rounding='nearest_up')} {(5/2).round(rounding='nearest_down')}")
    printl("{round(7/2)} {round(2.5)} {round(-2.5)} {round(-5/2 rounding='nearest_even')}")
}

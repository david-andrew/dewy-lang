# `.round()`: the nearest integer, a half away from zero; `ties=` names another rule.
main=():>void=>{
    printl("{(5/2).round()} {(7/2).round()} {(-5/2).round()} {(-7/2).round()} {(1/2).round()} {(-1/2).round()}")
    printl("{(1/3).round()} {(2/3).round()} {(-2/3).round()} {rational(4).round()}")
    let big=(10^30+1)/2
    printl(big.round())
    printl(big.round(ties='even'))
    let w:rational<int64>=5/2
    printl("{w.round()} {w.round(ties='even')}")
    printl("{(5/2).round(ties='even')} {(7/2).round(ties='even')} {(-5/2).round(ties='even')}")
    printl("{(5/2).round(ties='zero')} {(-5/2).round(ties='zero')} {(-5/2).round(ties='up')} {(5/2).round(ties='down')}")
    printl("{round(7/2)} {round(2.5)} {round(-2.5)} {round(-5/2 ties='even')}")
}

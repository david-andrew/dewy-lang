# `abs`, `min`, `max` and `sign` of fractions stay exact; an integer beside a
# fraction promotes, and a float beside one makes the float member the choice.
main=():>void=>{
    let third=1/3
    let neg=-2/5
    printl("{abs(third)} {abs(neg)} {abs(third) =? third} {abs(neg) =? 2/5}")
    printl("{min(third neg)} {max(third neg)} {min(neg third)} {max(neg third)}")
    printl("{sign(neg)} {sign(third)} {sign(third-third)} {sign(neg)*neg}")
    let n:int=2
    let w:int64=-1
    printl("{min(third n)} {max(n third)} {max(third w)} {min(w third)} {max(third 1)}")
    let f:float64=0.25
    printl("{min(third f)} {max(third f)} {min(f neg)}")
    printl("{min(third 0.5)} {max(0.1 0.2)} {abs(-2.5)}")
    let big=(10/3)^30
    printl(abs(-big) =? big)
    let a:rational<int64>=(-1)/3
    let b:rational<int64>=1/4
    printl("{min(a b)} {max(a b)} {sign(a)} {min(a third)}")
    let magnitude=abs(a)
    if magnitude is? Overflow printl("overflow") else printl(magnitude)
    printl("{abs(-7)} {min(3 4)} {max(1.5 f)} {sign(-f)}")
}

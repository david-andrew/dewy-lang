# exit: 42
run=()=>{
loop text in ["" "+" "-" "1/" "/2" "1/0" "1/2/3" " 1" "1 /2" "1.5" "１２"] {
    if rational(text) isnt? none return 1
}
if rational("1" "0") isnt? none or rational("x" "2") isnt? none return 4
let half=rational("-0002/-0004") ?? 0
if "{half}" not=? "1/2" or "{rational(0 -3)}" not=? "0" return 2
return if half =? (rational("1" "2") ?? 0) and rational(0) =? 0 and rational("+42") =? 42 42 else 3
}
main=()=>exit(run())

# exit: 42
$explicit_copies
# Strings are immutable: keeping one shares it, and costs no copy, so the
# policy accepts these without `.copy`. Mutable runtime-sized storage still counts.
Entry:type=[name:string note:string]
label=(name:string):>Entry=>Entry[name 'n:{name}']
snapshot=(@entry:Entry):>string=>{
    let saved=entry
    entry.name='changed'
    return saved.name
}
main=():>void=>{
    let entry=Entry['old' 'note']
    if snapshot(@entry) not=? 'old' or entry.name not=? 'changed' exit(3)
    let names:array<string>=['a' 'bb' 'ccc']
    let entries:array<Entry>=[]
    loop name in names {entries.push(label(name))}
    if names.length =? 0 or entries.length <? 3 exit(1)
    let first=names[0]
    let kept=first
    let note=entries[2].note
    exit((if kept =? 'a' and note =? 'n:ccc' and first.length =? 1 42 else 2))
}

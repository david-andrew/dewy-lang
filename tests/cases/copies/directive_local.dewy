# `$explicit_copies` in a function body holds for that function only.
$runtime_checks
loose=(xs:array<int64>):>int64=>{
    let ys=xs
    ys[0]=1
    return xs[0]+ys[0]
}
strict=(xs:array<int64>):>int64=>{
    $explicit_copies
    let ys=xs
    ys[0]=1
    return xs[0]+ys[0]
}
main=()=>{
    let xs:array<int64>=[5]
    printl("{loose(xs)} {strict(xs)}")
}

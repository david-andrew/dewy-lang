# modes: native native-release
# C fills a pointer word; a nonzero one is read back as a pointer.
strtol=(s:ptr<uint8> stop_at:ptr<uint64> base:int32):>int64 => $extern
strlen=(s:ptr<uint8>):>uint64 => $extern
main=():>void=>$unsafe {
    let text:array<uint8>=bytes("123abc")
    text.push(0)
    let slot:array<uint64>=[0]
    let value=strtol(text.ptr slot.ptr 10)
    if slot[0] =? 0 return
    let stop=(slot.ptr as ptr<ptr<uint8>>)[0]
    printl(value strlen(stop) stop[0])
}

# modes: native native-release
# C fills a `char **` out-parameter: the optional pointer is C's nullable pointer, one word.
strtol=(s:ptr<uint8> stop_at:ptr<ptr<uint8>?> base:int32):>int64 => $extern
strlen=(s:ptr<uint8>):>uint64 => $extern
main=():>void=>$unsafe {
    let text:array<uint8>=bytes("123abc")
    text.push(0)
    let slot:array<ptr<uint8>?>=[none]
    let value=strtol(text.ptr slot.ptr 10)
    let stop=slot[0]
    if stop isnt? none {printl(value strlen(stop) stop[0])}
}

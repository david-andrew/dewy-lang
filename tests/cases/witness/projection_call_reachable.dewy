# The reachable call, not the later one in a branch that returned, is named.
C:type = [
    keys:array<int>
    n:int
]

touch = (@c:C s:int):>void => {
    c.keys = fill(0 s)
}

access = (@c:C key:int):>void => {
    let victim = c.n
    if victim <? 0 or victim >=? c.keys.length return
    touch(@c 1)
    if key >? 10 {
        touch(@c 0)
        return
    }
    c.keys[victim] = key
}

main = () => {
    let c = C[keys=[1 2 3] n=0]
    access(@c 4)
    printl("{c.keys.length}")
}

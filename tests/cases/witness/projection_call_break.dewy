# A break out of an inner loop still reaches the index; one out of the loop holding it does not.
C:type = [
    keys:array<int>
    n:int
]

touch = (@c:C s:int):>void => {
    c.n = s
}

access = (@c:C keys:array<int>):>void => {
    loop key in keys {
        let victim = c.n
        if victim <? 0 or victim >=? c.keys.length return
        loop k in keys {
            if k >? 10 {
                touch(@c 0)
                break
            }
        }
        if key >? 10 {
            touch(@c 1)
            break
        }
        c.keys[victim] = key
    }
}

main = () => {
    let c = C[keys=[1 2 3] n=0]
    access(@c [4])
    printl("{c.keys.length}")
}

# A parameter pool's direct update after its membership guard asks nothing
# of its caller: the index it answers is the pool library's invariant.
Item:type = [qty:int64]
use = (@items:Pool<Item> h:Handle) => {
    if not items.has(h) return
    items[h].qty -= 1
}
main = () => {
    let items:Pool<Item> = []
    let a = items.add(Item[5])
    use(@items a)
}

# A nested dictionary's key is spelled through its outer entry.
main = () => {
    let units:dict<string dict<string int64>> = []
    let pairs:array<[string string]> = [["a" "x"] ["a" "y"]]
    loop [p m] in pairs {
        if p not in? units units[p] = []
        units[p][m] += 1
    }
    printl(units)
}

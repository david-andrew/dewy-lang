const N=5
main=()=>{
    let ys:array<int64 length <? 5> = [1]
    let f=(@x:array<int64 length <? N>):>void=>{
        if x.length >? 0 {x[0]=2}
    }
    f(@ys)
    let zs:array<int64<(>=? 0)>> = [1]
    let g=(@x:array<int64<(>=? 0)>>):>void=>{
        if x.length >? 0 {x[0]=7}
    }
    g(@zs)
    let n:int64<(>=? 0)> = 3
    let k=(@x:int64<(>=? 0)>):>void=>{x=4}
    k(@n)
    printl"{ys} {zs} {n}"
}

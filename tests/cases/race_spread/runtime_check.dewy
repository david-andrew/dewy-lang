# exit: 101
# modes: native
# Under $runtime_checks an unproven spread is checked when the call runs: empty, it stops.
$runtime_checks

work = (n:int64):>int64 => n
fastest = (calls:array<():>int64>):>int64 | Canceled | OutOfMemory => race(calls...)
main = () => {
    let r = fastest([@work(1)])
    printl"one {r is? int64}"
    let empty:array<():>int64> = []
    printl"none {fastest(empty)}"
}

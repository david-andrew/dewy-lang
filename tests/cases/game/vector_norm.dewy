# exit: 42
check = ():>int64 => {
    let v = vec3(3 4 0)
    if v.norm not=? 5.0 return 1
    if vec2(3 4).norm not=? 5.0 return 2
    if (v+v).norm not=? 10.0 return 3
    if v.norm(p=1) not=? 7.0 return 4
    if v.norm(p=2) not=? 5.0 return 5
    if vec4(1 -2 2 -4).norm(p=1) not=? 9.0 return 6
    return 42
}
main = ():>void => exit(check())

# modes: native native-release
# args: --top 3 --max-dist 2 recieve teh speling dewy xylophone --lower Wierd
# A spelling checker: write a small word list to disk, read it back with
# frequencies, then suggest corrections for the words on the command line.

UsageError:type = type of error & [message:string]

Options:type = [top:int max_dist:int lower:bool words:array<string>]

WORDS = """# word frequency
receive 120
recipe 40
relieve 33
the 900
tea 60
ten 75
spelling 25
spieling 2
dewy 8
dew 30
weird 44
wired 20
wield 12
"""

parse_args = (argv:array<string>):>Options|UsageError => {
    let opts = Options[5 2 false []]
    let i = 0
    loop i <? argv.length {
        let a = argv[i]
        if a =? "--lower" {
            opts.lower = true
        } else if a =? "--top" or a =? "--max-dist" {
            if i + 1 >=? argv.length return UsageError["{a} needs a number"]
            let n = to_int(argv[i + 1]) ?? return UsageError["{a} needs a number, got '{argv[i + 1]}'"]
            if n <? 0 return UsageError["{a} must not be negative"]
            if a =? "--top" opts.top = n else opts.max_dist = n
            i += 1
        } else if a.startswith("--") {
            return UsageError["unknown option {a}"]
        } else {
            opts.words.push(a)
        }
        i += 1
    }
    if opts.words.is_empty return UsageError["no words to check"]
    opts
}

load = (path:Path) => {
    let counts:dict<string int> = []
    let text = path.read_text or_throw
    loop line in text.lines {
        let s = line.trim()
        if s.is_empty or s.startswith("#") continue
        let parts = s.split()
        if parts.length not=? 2 continue
        counts[parts[0]] = to_int(parts[1]) ?? 0
    }
    counts
}

# classic two-row edit distance
distance = (a:string b:string):>int => {
    let x = a.chars
    let y = b.chars
    let prev:array<int> = [loop j in [0..y.length] j]
    loop i in [1..x.length] {
        let cur:array<int> = [i]
        loop j in [1..y.length] {
            let cost = if x[i - 1] =? y[j - 1] 0 else 1
            cur.push(min(min(prev[j] + 1 cur[j - 1] + 1) prev[j - 1] + cost))
        }
        prev = cur
    }
    prev[y.length]
}

# the k smallest by a key, keeping the original order of ties
smallest = <T>(xs:array<T> k:int key:(T:>int)):>array<T> => {
    let sorted = xs.sorted(key=key)
    sorted[$clamp ..k)
}

Suggestion:type = [word:string dist:int freq:int]

main = () => {
    let opts = parse_args(args()[$clamp 1..]) or_throw
    let path = p"words.txt"
    path.write_text(WORDS) or_throw;
    let counts = load(path) or_throw
    printl("loaded {counts.length} words, top {opts.top}, max distance {opts.max_dist}")
    loop raw in opts.words {
        let w = if opts.lower raw.lower() else raw
        if w in? counts {
            printl("{w}: ok ({counts[w]})")
            continue
        }
        let near:array<Suggestion> = []
        loop [cand freq] in counts {
            let d = distance(w cand)
            if d <=? opts.max_dist near.push(Suggestion[cand d freq])
        }
        let ranked = smallest(near opts.top (s) => s.dist * 10000 - s.freq)
        if ranked.is_empty {
            printl("{w}: no suggestions")
        } else {
            let shown = [loop s in ranked "{s.word}({s.dist})"]
            printl("{w}: {", ".join(shown)}")
        }
    }
    path.unlink or_throw;
}

# A small calculator language: `let name = expr` lines bind variables, other
# lines print a value. Expressions use + - * / ^, parentheses and unary minus,
# and evaluate exactly with fractions. Errors are values, reported per line.

Token:type = [kind:string text:string]

is_letter = (c:string):>bool => "a" <=? c <=? "z" or "A" <=? c <=? "Z" or c =? "_"

CalcError:type = type of error & [message:string]

tokenize = (line:string):>array<Token> | CalcError => {
    let tokens:array<Token> = []
    let i = 0
    let chars = line.chars
    loop i <? chars.length {
        let c = chars[i]
        if c =? " " {
            i += 1
        } else if c in? set"0123456789." {
            let start = i
            loop i <? chars.length and chars[i] in? set"0123456789." i += 1
            tokens.push(Token["num" line[start..i)])
        } else if is_letter(c) {
            let start = i
            loop i <? chars.length and is_letter(chars[i]) i += 1
            tokens.push(Token["name" line[start..i)])
        } else if c in? set"+-*/^()=" {
            tokens.push(Token["op" c])
            i += 1
        } else {
            return CalcError["unexpected '{c}'"]
        }
    }
    tokens
}

Parser:type = [tokens:array<Token> pos:int = 0 vars:dict<string rational>]

peek = (p:Parser):>string => (p.tokens.get(p.pos) ?? Token["end" ""]).text

# expr := term (('+' | '-') term)*
expr = (@p:Parser):>rational | CalcError => {
    let value:rational = term(@p) or_throw
    loop peek(p) =? "+" or peek(p) =? "-" {
        let op = peek(p)
        p.pos += 1
        let rhs = term(@p) or_throw
        value = if op =? "+" value + rhs else value - rhs
    }
    value
}

# term := power (('*' | '/') power)*
term = (@p:Parser):>rational | CalcError => {
    let value:rational = power(@p) or_throw
    loop peek(p) =? "*" or peek(p) =? "/" {
        let op = peek(p)
        p.pos += 1
        let rhs = power(@p) or_throw
        if op =? "*" value = value * rhs
        else {
            if rhs =? 0 return CalcError["division by zero"]
            value = value / rhs
        }
    }
    value
}

# power := unary ('^' power)?   (right associative, whole exponents)
power = (@p:Parser):>rational | CalcError => {
    let base = unary(@p) or_throw
    if peek(p) not=? "^" return base
    p.pos += 1
    let exponent = power(@p) or_throw
    if exponent.denominator not=? 1 return CalcError["exponent must be whole"]
    let n = exponent.numerator
    if not (-1000 <=? n <=? 1000) return CalcError["exponent too large"]
    if base =? 0 and n <? 0 return CalcError["division by zero"]
    if base =? 0 return 0
    base ^ n
}

unary = (@p:Parser):>rational | CalcError => {
    if peek(p) not=? "-" return atom(@p)
    p.pos += 1
    -(unary(@p) or_throw)
}

atom = (@p:Parser):>rational | CalcError => {
    let t = p.tokens.get(p.pos)
    if t is? none return CalcError["unexpected end"]
    p.pos += 1
    if t.kind =? "num" return rational_of(t.text)
    if t.kind =? "name" {
        let found = p.vars.get(t.text)
        if found is? none return CalcError["unknown name '{t.text}'"]
        return found
    }
    if t.text =? "(" {
        let inside = expr(@p) or_throw
        if peek(p) not=? ")" return CalcError["missing ')'"]
        p.pos += 1
        return inside
    }
    CalcError["unexpected '{t.text}'"]
}

# "12.5" -> 25/2: digits after the point scale the denominator
rational_of = (text:string):>rational | CalcError => {
    let parts = text.split(".")
    if parts.length >? 2 return CalcError["bad number '{text}'"]
    let whole = to_int(parts[0]) ?? 0
    if parts.length =? 1 return rational(whole)
    let digits = parts[1]
    let frac = to_int(digits) ?? 0
    rational(whole) + rational(frac 10 ^ digits.length)
}

run_line = (@vars:dict<string rational> line:string):>string | CalcError => {
    let tokens = tokenize(line) or_throw
    let binds = tokens.length >=? 3 and tokens[0].text =? "let" and tokens[2].text =? "="
    let target = if binds tokens[1].text else ""
    let p = Parser[tokens (if binds 3 else 0) vars]
    let value = expr(@p) or_throw
    if p.pos not=? tokens.length return CalcError["unexpected '{peek(p)}'"]
    if target not=? "" {
        vars[target] = value
        return "{target} = {value}"
    }
    "{value}"
}

main = () => {
    let program = [
        "1 + 2 * 3"           "let rate = 0.15"
        "let price = 19.99"   "price * (1 + rate)"
        "1/3 + 1/6"           "2 ^ 10 - 2 ^ -2"
        "-(4 - 6) ^ 2"        "let x = 7 / (3 - 3)"
        "y + 1"               "3 $ 4"
        "(1 + 2"              "2 ^ 0.5"
    ]
    let vars:dict<string rational> = []
    loop line in program {
        let result = run_line(@vars line)
        if result is? CalcError printl"{line:<20} error: {result.message}"
        else printl"{line:<20} {result}"
    }
}

# A todo-list CLI with file persistence.
# Usage: todo add TEXT... | done N | undo N | rm N | list [--all] | clear

Task:type = [id:int text:string done:bool=false]
Store:type = [next_id:int=1 tasks:array<Task>=[]]

store_path = ():>string => "dewy_todo_demo.json"

load = (path:string):>Store => {
    let text = read_text(path)
    if text is? error { return Store() }
    let parsed = from_json<Store>(text)
    if parsed is? TextError {
        printl("warning: ignoring corrupt store: {parsed.message}")
        return Store()
    }
    return parsed
}

save = (path:string store:Store):>void => {
    let result = write_text(path to_json(store 2))
    if result is? error { printl("error: could not save to {path}") }
}

find = (store:Store id:int):>int|none => {
    loop i in 0.. and t in store.tasks {
        if t.id =? id { return i }
    }
    return none
}

show = (t:Task):>string => {
    let mark = if t.done "x" else " "
    return "[{mark}] {format(t.id ">3")}  {t.text}"
}

run_command = (argv:array<string>):>int => {
    let path = store_path()
    let store = load(path)
    if argv.length =? 0 {
        printl("usage: todo add|done|undo|rm|list|clear")
        return 2
    }
    let cmd = argv[0]
    let rest = argv[1..]
    if cmd =? "add" {
        if rest.length =? 0 { printl("add: nothing to add") return 2 }
        let text = rest.join(" ")
        store.tasks.push(Task[store.next_id text])
        printl("added #{store.next_id}: {text}")
        store.next_id += 1
    } else if cmd in? ["done" "undo" "rm"] {
        if rest.length not=? 1 { printl("{cmd}: expected one task id") return 2 }
        let id = to_int(rest[0])
        if id is? none { printl("{cmd}: not a number: {rest[0]}") return 2 }
        let index = find(store id)
        if index is? none { printl("{cmd}: no task #{id}") return 1 }
        if cmd =? "rm" {
            let removed = store.tasks.pop(index)
            printl("removed #{removed.id}")
        } else {
            store.tasks[index].done = cmd =? "done"
            printl(show(store.tasks[index]))
        }
    } else if cmd =? "list" {
        let all = "--all" in? rest
        let shown = 0
        loop t in store.tasks {
            if all or not t.done {
                printl(show(t))
                shown += 1
            }
        }
        let remaining = [loop t in store.tasks if not t.done t].length
        printl("{shown} shown, {remaining} open, {store.tasks.length} total")
    } else if cmd =? "clear" {
        store = Store()
        printl("cleared")
    } else {
        printl("unknown command: {cmd}")
        return 2
    }
    save(path store)
    return 0
}

main = ():>void => {
    let argv = args()
    if argv.length >? 1 { exit(run_command(argv[1..])) }
    # Demo session: each line is one invocation of the CLI.
    let session = [
        ["clear"]
        ["add" "buy" "milk"]
        ["add" "write" "dogfood" "report"]
        ["add" "water" "the" "plants"]
        ["done" "2"]
        ["list"]
        ["list" "--all"]
        ["rm" "1"]
        ["undo" "2"]
        ["done" "9"]
        ["done" "x"]
        ["list" "--all"]
    ]
    loop cmd in session {
        printl("$ todo {cmd.join(" ")}")
        let status = run_command(cmd)
        if status not=? 0 { printl("(exit {status})") }
    }
    remove_file(store_path())
}

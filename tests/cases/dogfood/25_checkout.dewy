# Supermarket checkout simulation: customers arrive at random, join the
# shortest lane, and are served in order. Compare 2, 3 and 4 open lanes.

Customer:type = [id:int64 arrived:float64 items:int64]
Lane:type = [queue:array<Customer> busy_until:float64 = 0.0 served:int64 = 0 busy_time:float64 = 0.0]

Report:type = [
    lanes:int64
    served:int64
    mean_wait:float64
    max_wait:float64
    max_queue:int64
    utilization:float64
    waits:array<float64>
]

percentile = (sorted_values:array<float64> q:float64):>float64 => {
    if sorted_values.is_empty return 0.0
    let at = int64(q * (sorted_values.length - 1))
    sorted_values[at]
}

histogram = (values:array<float64> width:float64) => {
    let buckets:dict<int64 int64> = []
    loop v in values {
        let b = int64((v / width).floor())
        buckets[b] = (buckets.get(b) ?? 0) + 1
    }
    let top = max(buckets.values)
    loop b in buckets.keys.sorted {
        let n = buckets[b]
        let bar = "#" * (n * 40 // top)
        printl("  {b*width:>5.1f}-{(b+1)*width:<5.1f} {n:>4} {bar}")
    }
}

exponential = (@r:Rng mean:float64):>float64 => -mean * log(1.0 - r.next_float())

simulate = (lanes:int64 minutes:float64 seed:int64):>Report => {
    let r = rng(seed)
    let open:array<Lane> = [loop _ in [0..lanes) Lane[[]]]
    let clock:float64 = 0.0
    let next_id = 0
    let next_arrival = exponential(@r 0.8)
    let waits:array<float64> = []
    let max_queue = 0
    loop clock <? minutes {
        # serve: any lane whose current customer is done takes the next one
        loop @lane in open {
            if lane.queue.length >? 0 and lane.busy_until <=? clock {
                let c = lane.queue.pop(0)
                let service = 0.5 + 0.1 * c.items
                waits.push(clock - c.arrived)
                lane.busy_until = clock + service
                lane.busy_time += service
                lane.served += 1
            }
        }
        # arrivals
        loop next_arrival <=? clock {
            let shortest = open.min_by((l) => l.queue.length)
            let at = open.index_of(shortest) ?? 0
            open[at].queue.push(Customer[next_id next_arrival r.next_int(1 30)])
            next_id += 1
            next_arrival += exponential(@r 0.8)
        }
        loop lane in open { max_queue = max(max_queue lane.queue.length) }
        clock += 0.1
    }
    let served = sum([loop l in open l.served])
    let busy = sum([loop l in open l.busy_time])
    return Report[
        lanes = lanes
        served = served
        mean_wait = sum(waits) / waits.length
        max_wait = max(waits)
        max_queue = max_queue
        utilization = busy / (lanes * minutes)
        waits = waits
    ]
}

main = () => {
    let reports = [loop lanes in [2..4] simulate(lanes 480.0 42)]
    printl("lanes  served  mean wait  max wait  max queue  busy")
    loop r in reports {
        printl("{r.lanes:>5}  {r.served:>6}  {r.mean_wait:>9.2f}  {r.max_wait:>8.2f}  {r.max_queue:>9}  {r.utilization:>4.0%}")
    }
    let three = reports[1]
    let sorted = three.waits.sorted
    printl("")
    printl("3 lanes: median wait {percentile(sorted 0.5):.2f}, p90 {percentile(sorted 0.9):.2f}, p99 {percentile(sorted 0.99):.2f}")
    histogram(three.waits 1.0)
}

$runtime_checks

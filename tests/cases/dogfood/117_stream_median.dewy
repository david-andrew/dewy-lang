# Running statistics over a stream of sensor readings: the median after each
# reading from two binary heaps (a max-heap of the low half, a min-heap of the
# high half), plus the three largest readings kept in a small min-heap.

const READINGS = [41 17 63 8 25 99 54 31 70 12 88 46 5 77 60]

# A binary heap of ints ordered by `before`: the root is the first in order.
Heap:type = [items:array<int> max_first:bool]

before = (h:Heap a:int b:int):>bool => if h.max_first a >? b else a <? b

push = (@h:Heap x:int) => {
    h.items.push(x)
    let i = h.items.length - 1
    loop 0 <? i <? h.items.length {
        let parent = (i - 1) // 2
        if not before(h h.items[i] h.items[parent]) break
        h.items.swap(i parent)
        i = parent
    }
}

pop = (@h:Heap):>int? => {
    if h.items.length =? 0 return none
    let top = h.items[0]
    let last = h.items.pop()
    if h.items.length >? 0 {
        h.items[0] = last
        let i = 0
        let n = h.items.length
        loop 2 * i + 1 <? n {
            let child = 2 * i + 1
            if child + 1 <? n and before(h h.items[child + 1] h.items[child]) child += 1
            if not before(h h.items[child] h.items[i]) break
            h.items.swap(i child)
            i = child
        }
    }
    top
}

peek = (h:Heap):>int? => h.items.get(0)

# Keep the halves within one of each other, the low half never smaller.
rebalance = (@low:Heap @high:Heap) => {
    if low.items.length >? high.items.length + 1 {
        let x = pop(@low)
        if x isnt? none push(@high x)
    } else if high.items.length >? low.items.length {
        let x = pop(@high)
        if x isnt? none push(@low x)
    }
}

add = (@low:Heap @high:Heap x:int) => {
    let top = peek(low)
    if top is? none or x <=? top push(@low x) else push(@high x)
    rebalance(@low @high)
}

median = (low:Heap high:Heap):>string => {
    let a = peek(low) ?? 0
    if low.items.length >? high.items.length return "{a}"
    let b = peek(high) ?? 0
    let twice = a + b
    if twice % 2 =? 0 "{twice // 2}" else "{twice // 2}.5"
}

# The k largest readings: a min-heap that drops its smallest past k.
largest = (xs:array<int> k:int):>array<int> => {
    let h = Heap[[] false]
    loop x in xs {
        push(@h x)
        if h.items.length >? k pop(@h);
    }
    let out:array<int> = []
    loop h.items.length >? 0 {
        let x = pop(@h)
        if x isnt? none out.push(x)
    }
    out.reversed
}

main = () => {
    let low = Heap[[] true]
    let high = Heap[[] false]
    let k = 0
    loop x in READINGS {
        add(@low @high x)
        k += 1
        printl"{fmt'>2'(k)}. read {fmt'>2'(x)}  median {fmt'>4'(median(low high))}  halves {low.items.length}/{high.items.length}"
    }
    printl"largest three: {largest(READINGS 3)}"
    let sorted = READINGS.sorted
    printl"check: sorted middle is {sorted[sorted.length // 2]}"
}

# Checksums and hashes on fixed-width integers: Adler-32, FNV-1a, CRC-8,
# a xorshift32 PRNG, hex formatting and a Luhn check digit.

bytes_of = (text:string):>array<uint8> => text as array<uint8>

adler32 = (data:array<uint8>):>uint32 => {
    let a:uint32 = 1
    let b:uint32 = 0
    loop byte in data {
        a = (a + byte) % 65521
        b = (b + a) % 65521
    }
    (b << 16) | a
}

fnv1a = (data:array<uint8>):>uint32 => {
    let h:uint32<overflow='wrap'> = 2166136261
    loop byte in data {
        h = h xor byte
        h = h * 16777619
    }
    h
}

crc8 = (data:array<uint8>):>uint8 => {
    let crc:uint8 = 0
    loop byte in data {
        crc = crc xor byte
        loop _ in [0..8) {
            if (crc and 0x80) not=? 0 crc = ((crc << 1) xor 0x07) and 0xFF
            else crc = (crc << 1) and 0xFF
        }
    }
    crc
}

xorshift32 = (@state:uint32):>uint32 => {
    let x:uint32<overflow='wrap'> = state
    x = x xor (x << 13)
    x = x xor (x >> 17)
    x = x xor (x << 5)
    state = x
    x
}

HEX = "0123456789abcdef"

hex32 = (v:uint32):>string => {
    let out:array<string> = []
    loop shift in [28, 24..0] {
        let nibble = (v >> shift) and 0xF
        out.push(HEX[nibble])
    }
    out.join
}

luhn_digit = (digits:string):>int64 => {
    let total = 0
    let double = true
    loop i in [digits.length-1, digits.length-2..0] {
        let d = to_int(digits[i]) ?? 0
        if double {
            d = d * 2
            if d >? 9 d -= 9
        }
        total += d
        double = not double
    }
    (10 - total % 10) % 10
}

loop text in ["Wikipedia" "hello world" ""] {
    let data = bytes_of(text)
    printl"{text:<12} adler32={hex32(adler32(data))} fnv1a={hex32(fnv1a(data))} crc8={crc8(data)}"
}
let state:uint32 = 2463534242
let rolls:array<int64> = []
loop _ in [0..6) {
    rolls.push(xorshift32(@state) % 6 + 1)
}
printl"dice: {rolls}"
printl"luhn(7992739871) = {luhn_digit("7992739871")}"

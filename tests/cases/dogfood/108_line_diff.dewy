# A line diff: the longest common subsequence of two texts' lines picks what
# stays, then the edits are grouped into unified-diff hunks with one line of
# context around each change.

const BEFORE = """
fn main
let total = 0
loop item in cart
total += item.price
print total
save receipt
email receipt
done
close drawer
lock till
log out
"""

const AFTER = """
fn main
let total = 0
let count = 0
loop item in cart
total += item.price
count += 1
print total
print count
email receipt
done
close drawer
log out
"""

const CONTEXT = 1

Edit:type = [kind:string text:string old_line:int64 new_line:int64]

# table[i][j] is the common length of a's first i lines and b's first j.
# Walk it back from the corner, then put the edits in order.
diff = (a:array<string> b:array<string>):>array<Edit> => {
    let table = [loop i in [0..a.length] [loop j in [0..b.length] 0]]
    loop i in [1..a.length] {
        loop j in [1..b.length] {
            table[i][j] = if a[i - 1] =? b[j - 1] table[i - 1][j - 1] + 1
                else max(table[i - 1][j] table[i][j - 1])
        }
    }
    let edits:array<Edit> = []
    let i = a.length
    let j = b.length
    loop i >? 0 and j >? 0 {
        if a[i - 1] =? b[j - 1] {
            edits.push(Edit[" " a[i - 1] i j])
            i -= 1
            j -= 1
        } else if table[i][j - 1] >=? table[i - 1][j] {
            edits.push(Edit["+" b[j - 1] i + 1 j])
            j -= 1
        } else {
            edits.push(Edit["-" a[i - 1] i j + 1])
            i -= 1
        }
    }
    loop j >? 0 {
        edits.push(Edit["+" b[j - 1] i + 1 j])
        j -= 1
    }
    loop i >? 0 {
        edits.push(Edit["-" a[i - 1] i j + 1])
        i -= 1
    }
    edits.reversed()
}

# Runs of edits to print: each change with CONTEXT unchanged lines around it,
# overlapping runs merged. Each run is [first last] into `edits`.
hunks = (edits:array<Edit>):>array<[int64 int64]> => {
    let runs:array<[int64 int64]> = []
    loop k in [0..edits.length) {
        if edits[k].kind =? " " continue
        let first = max(0 k - CONTEXT)
        let last = min(edits.length - 1 k + CONTEXT)
        if not runs.is_empty and runs.last[1] >=? first - 1 {
            let [start _] = runs.pop()
            runs.push([start last])
        } else runs.push([first last])
    }
    runs
}

main = () => {
    let a = [loop line in BEFORE.lines if not line.is_empty line]
    let b = [loop line in AFTER.lines if not line.is_empty line]
    let edits = diff(a b)
    let kept = edits.count(e => e.kind =? " ")
    printl"{a.length} -> {b.length} lines, {kept} kept"
    loop [first last] in hunks(edits) {
        let part = edits[$clamp first..last]
        let olds = part.count(e => e.kind not=? "+")
        let news = part.count(e => e.kind not=? "-")
        if part.is_empty continue
        let start = part[0]
        printl"@@ -{start.old_line},{olds} +{start.new_line},{news} @@"
        loop e in part printl"{e.kind}{e.text}"
    }
}

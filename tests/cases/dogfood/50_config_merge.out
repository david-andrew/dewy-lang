server:
  host: "example.org"
  port: 9000
  tls: true
log:
  level: "warning"
  file: "app.log"
  rotate:
    days: 7
workers: 8
cache:
  size_mb: 256
  ratio: 0.75

server.port = 9000
log.rotate.days = 7
cache.ratio = 0.75
server.missing: not set
workers.count: not set
rejected override: no-equals-sign

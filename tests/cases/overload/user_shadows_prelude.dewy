# A module's own function replaces the prelude's whole family of that name.
abs = (x:int64):>int64 => 99 + x
max = (a:int64 b:int64):>int64 => a * 100 + b
main = () => {
    printl(abs(-1))
    printl(max(1 2))
    let floor = (x:int64):>int64 => x * 2
    printl(floor(4))
    # Members are found through the value, so the prelude's still serve it.
    printl((2.5).max(1.0))
}

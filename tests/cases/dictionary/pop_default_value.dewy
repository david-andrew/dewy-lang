# `d.pop(key default=v)` gives the value, or v for a missing key; `default=none` an optional.
main=():>int64=>{
    let store:dict<int64 int64>=[]
    store[1]=10
    store[2]=20
    let key=2
    printl(store.pop(key default=0))
    printl(store.pop(key default=0))
    store.pop(1 default=(-1))
    printl(store.length)
    let names=["a"->"one"]
    printl(names.pop("a" default="none"))
    printl(names.pop("a" default="none"))
    printl(names.pop("a" default=none))
    return 0
}

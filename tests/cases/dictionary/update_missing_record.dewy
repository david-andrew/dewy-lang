# exit: 101
# A compound update reads its entry first: a missing key fails as m[k] does and
# no record is invented for it.
Point:type=[x:int64 y:int64]
main=()=>{
    let points:dict<string Point>=["a"->Point[1 2]]
    points["a"].x+=1
    printl("{points}")
    points["b"].x+=1
    printl("not reached")
    return 0
}
$runtime_checks

# exit: 42
run=()=>{
let values:dict<int64 int64?>=[1->none 2->22 3->0 4->none]
values.remove(2)
let keys=[values.keys...]
if keys not=? [1 3 4] or values.values() not=? [none 0 none] return 1
values.remove(1) values.remove(3) values.remove(4)
return if values.keys =? set[] and values.values() =? [] 42 else 2}
main=()=>exit(run())

# Two steps under a guard that leaves room for only one: no bound survives.
prefix = (chars:array<string> i0:int64):>array<string> => {
    let i = i0
    if 0 <=? i and i <? chars.length {
        if i + 1 <? chars.length { i += 3 } else { i += 1 }
        return chars[0..i)
    }
    []
}
printl(prefix(["a" "b" "c"] 0))

# quick
# A `\` at the end of a line cancels that line break: in code, in array literals
# and in strings.
main = () => {
    let total = 1 + \
        2
    printl(total)
    let primes = [2 3 5 \
        7 11]
    printl(primes)
    let text = "ab\
cd"
    printl(text)
    printl(total \
        + 1)
}

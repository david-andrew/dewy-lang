# modes: native native-release
# A task lets a callback wait; the same parameter under `parallel` does not.
apply = (f:(x:int:>int) x:int):>int => f(x)
each = (f:(x:int:>int) xs:array<int>):>array<int> => [parallel x in xs apply(@f x)]
main = () => {
    let c = channel<int>(1)
    concurrent {
        let a = spawn apply((v) => {
            let got = c.receive
            if got is? int got + v else v
        } 7)
        spawn { c.close }
    }
    printl(a or_throw)
    printl(each((v) => {
        let got = c.receive
        if got is? int got + v else v
    } [1]))
}

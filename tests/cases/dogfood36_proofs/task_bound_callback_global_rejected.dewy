# modes: native native-release
counter:int = 0
consume = (f:(x:int:>int) xs:array<int>):>int => {
    let t = 0
    loop x in xs t += f(x)
    t
}
main = () => {
    concurrent {
        let a = spawn consume((v) => {
            counter += v
            v
        } [1 2])
    }
    printl(a or_throw)
}

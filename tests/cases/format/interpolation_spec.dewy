# `fmt` patterns inside interpolations; a quantity's number in a unit is the quantity divided by it.
from units import m, km
main = () => {
    let x = 3.14159
    let y:float64 = 2.5
    let n = 1234567
    let d:dict<string int> = ["a:b"->5]
    let s = "hi"
    printl"[{fmt'.2f'(x)}] [{fmt'.1f'(y)}] [{fmt','(n)}] [{fmt'.1%'(0.256)}] [{fmt'^6'(s)}] [{fmt'*>5'(s)}] [{d["a:b"]}] [{fmt'03'(d["a:b"])}]"
    printl"[{fmt'8.3f'((x))}] [{fmt'>12'("{fmt','(n)}")}] [{fmt'#06x'(255)}] [{fmt'+d'(255)}] [{fmt'.3f'(x*2)}] [{fmt'.2f'(1/8)}] [{fmt'.1f'(1.5km/1m)}] [{fmt'_'(n)}]"
}

# exit: 42
$runtime_checks
Series:type=[values:array<int64>]
let source=Series[[20 22]]
length=(s:Series)=>{source.values[1]=99 return s.values.length}
__index__=(s:Series i:int64)=>s.values[i]
run=()=>{source.values.push(0) let value=source[end-1]
return if value =? 22 and source.values[1] =? 99 42 else 1}
main=()=>exit(run())

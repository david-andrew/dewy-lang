# modes: native native-release
# Named binding keeps the ABI order; index priority follows written waits.
main=(args:array<string>)=>{
    {
        let a=channel<int64>(1)
        let b=channel<int64>(1)
        let c=channel<int64>(1)
        let d=channel<int64>(1)
        a.send(1) or_throw
        b.send(2) or_throw
        c.send(3) or_throw
        d.send(4) or_throw
        printl(select(priority='index' timeout=0s a=@a.receive b=@b.receive c=@c.receive d=@d.receive) or_throw)
    }

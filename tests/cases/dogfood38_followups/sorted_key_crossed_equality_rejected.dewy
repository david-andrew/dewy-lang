# An equality comparing crossed fields: a key need not find itself again.
Pair:type = [a:int64 b:int64]
__eq__ = (x:Pair y:Pair):>bool => x.a =? y.b and x.b =? y.a
main = () => {
    let by:dict<Pair int> = []
    by[Pair[1 2]] = 2
    let ks = by.keys.sorted(key=(k) => -by[k])
    printl(ks.length)
}

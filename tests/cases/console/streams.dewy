# quick
# The prelude console: print/printl/info on standard output; warn, error and debug
# on standard error (not part of this output); print(x file=stream) for either.
main=()=>{
    console.printl("one")
    console.print("two ")
    console.info("three" 3)
    console.warn("careful")
    console.error("failed")
    console.debug("details")
    print("four" file=stdout)
    printl("" file=stdout)
    printl("hidden" file=stderr)
    printl(console.color)
}

# quick
describe=((value:int64 suffix:string):>string=>"integer {value}{suffix}")
        &((value:string suffix:string):>string=>"text {value}{suffix}")
pick=((a:int64 b:int64):>int64=>a+b)
    &((a:int64 label:string):>int64=>a+label.length)
add=<T>(a:T b:T):>T=>a+b
Box:type=[value:int64]
scaled=(box:Box factor:int64):>int64=>box.value*factor
run=()=>{
    let integer=@describe(5)
    let text=@describe("x")
    printl"{integer("!")} {text("?")}"
    let sum:<(b:int64):>int64>=@pick(40)
    let labeled:<(label:string):>int64>=@pick(40)
    printl"{sum(2)} {labeled("ab")}"
    let forty:int64=40
    let plus=@add(forty)
    let typed:<(a:float64 b:float64):>float64>=@add()
    printl"{plus(2)} {typed(1.5 2.0)}"
    let three:int64=3
    let larger=@max(three)
    printl(larger(5))
    let box=Box(7)
    let times=@box.scaled()
    let words="a b c"
    let pieces=@words.split(" ")
    printl"{times(6)} {pieces().length}"
    return 0
}
main=()=>exit(run())

$runtime_checks

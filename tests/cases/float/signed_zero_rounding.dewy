# Rounding keeps the sign of a zero result, and `sign` keeps zeros and NaN.
main=()=>{
    let one:float64=1.0
    let a:float64=-0.4
    let b:float64=0.4
    let nz:float64=-0.0
    printl"{a.ceil()} {a.floor()} {b.floor()} {nz.floor()} {nz.ceil()}"
    printl"{trunc(a)} {trunc(b)} {round(a)} {round(nz)}"
    let zero:float64=0.0
    printl"{sign(nz)} {sign(zero)} {sign(abs(zero/zero))} {sign(-2.0*one)}"
}

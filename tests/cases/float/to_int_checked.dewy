# exit: 101
# Float-to-integer conversion keeps the value: it truncates toward zero, and a
# value outside the target's range (or NaN) is a failed check, never saturated.
main=()=>{
    let f:float64=-2.75
    let g:float64=255.9
    let h:float64=1e20
    printl"{int64(f)} {uint8(g)} {int(h)}"
    let big:float64=1e300
    printl(int64(big))
}

$runtime_checks

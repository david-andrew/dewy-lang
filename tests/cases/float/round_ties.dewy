#
# Floats round to nearest with ties to even (IEEE 754); `rounding=` names another rule.
main=()=>{
    let xs:array<float64>=[2.5 -2.5 3.5 0.5 -0.25 1.4999 -0.5]
    printl"{[loop x in xs round(x)]}"
    loop rounding in (['nearest_even' 'nearest_away' 'nearest_toward_zero' 'nearest_up' 'nearest_down'] as array<'nearest_even'|'nearest_away'|'nearest_toward_zero'|'nearest_up'|'nearest_down'>) {
        printl"{rounding}: {round(xs[0] rounding=rounding)} {round(xs[1] rounding=rounding)} {xs[2].round(rounding=rounding)}"
    }
    let f:float32=2.5
    let huge:float64=1e300
    let zero:float64=0.0
    printl"{round(f)} {round(huge)} {round(zero/zero)}"
}

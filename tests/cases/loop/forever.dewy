# quick
# A loop is `loop condition body`: `loop true` runs until it exits, and a block
# may be the condition.
count=():>int64=>{
    let i=0
    loop true {
        i+=1
        if i =? 2 {continue}
        if i >? 4 {break}
    }
    let j=0
    loop true {j+=1; if j >=? 3 {return i*10+j}}
}
main=()=>{
    printl(count())
    let calls=0
    let total=0
    loop {calls+=1; calls <? 4} {total+=1}
    printl"{calls} {total}"
}

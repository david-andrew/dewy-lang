# quick
# A value whose type has a `next` method (the next element, or none) is an
# iterator, and a loop calls `next` until it gives none.
Countdown:type = [
    left:int64
    next = ():>int64|none => {
        if left <=? 0 return none
        left -= 1
        return left + 1
    }
    skip = ():>void => { left -= 1 }
]
main = () => {
    loop n in Countdown[3] { printl(n) }
    printl([loop n in Countdown[4] n * n])
    $outer
    loop n in Countdown[9] {
        if n =? 7 continue
        if n <? 5 break $outer
        printl(n)
    }
    # Looping over a bound iterator's place lets the body steer it.
    let c=Countdown[6]
    loop n in @c {
        if n =? 5 { c.skip }
        printl(n)
    }
    loop n in Countdown[0] { printl(n) } else { printl("empty") }
    let d=Countdown[0]
    loop n in @d { printl(n) } else { printl("still empty") }
}

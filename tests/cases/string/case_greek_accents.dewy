# quick
# upper and lower map Greek letters with an accent or a diaeresis, and the final sigma.
main = () => {
    printl(upper("ελληνικά άέήίόύώ ϊϋ ς"))
    printl(lower("ΕΛΛΗΝΙΚΆ ΆΈΉΊΌΎΏ ΪΫ Σ"))
    printl(lower(upper("ά έ ή ί ό ύ ώ ϊ ϋ")) =? "ά έ ή ί ό ύ ώ ϊ ϋ")
    # (no one-letter capital: these stay as they are)
    printl(upper("ΐ ΰ"))
}

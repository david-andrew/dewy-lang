# quick
# text.find and text.rfind give grapheme positions, as indexing uses, or none.
main=()=>{
    let s="café b café"
    let i=s.find("b")
    printl(i)
    if i isnt? none { printl(s[i]) }
    printl(s.find("zz"))
    printl(s.rfind("c"))
    printl(s.find("c" 1))
    printl(s.find("é"))
    let m=s.find(regex(r"b"))
    if m isnt? none { printl(m.start) }
}

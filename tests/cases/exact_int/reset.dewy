#
reset=(a:int64 b:int64)=>{
 let x=a+b
 let y=a-b
 let z=a*b
 if x <? 0 or x >=? 100 {x=7}
 if y <? 0 or y >=? 100 {y=8}
 if z <? 0 or z >=? 100 {z=9}
 printl(x y z)
}
inside=(a:int64 b:int64)=>{
 let x=a+b
 if x <? 0 or x >=? 100 {printl(x); x=7}
 printl(x)
}
main=()=>{
 let inputs:array<int64>=[int64.min int64.min int64.max 1 int64.min (-1) 5 6]
 loop i in [0..inputs.length) {
  if i%2 =? 0 {reset(inputs[i] inputs[i+1]) inside(inputs[i] inputs[i+1])}
 }
}

$runtime_checks

# quick
# Named policies on constant text still resolve while compiling.
printl(zoned("2026-03-08T02:30" zone=zone"America/New_York" gap='preserve_displacement'))
printl(zoned("2026-03-08T02:30" zone=zone"America/New_York" gap='next'))
printl(zoned("2026-11-01T01:30" zone=zone"America/New_York" fold='earlier'))
printl(zoned("2026-11-01T01:30" zone=zone"America/New_York" fold='later'))

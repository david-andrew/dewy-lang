# A width alone adds no digits; a precision still gives them.
main = () => {
    let x = rational(120)
    printl("[{x:>7}]")
    printl("[{x:<7}]")
    printl("[{x:^7}]")
    printl("[{x:7}]")
    printl("[{x:*>7}]")
    let price = rational("19.99") ?? x
    printl("[{price:>7}]")
    printl("[{rational(1 3):>5}]")
    printl("[{x:>7.2f}]")
    printl("[{x:.1f}]")
    printl("[{x:07}]")
}

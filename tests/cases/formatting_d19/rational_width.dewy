# A width alone adds no digits; a precision still gives them.
main = () => {
    let x = rational(120)
    printl("[{fmt'>7'(x)}]")
    printl("[{fmt'<7'(x)}]")
    printl("[{fmt'^7'(x)}]")
    printl("[{fmt'7'(x)}]")
    printl("[{fmt'*>7'(x)}]")
    let price = rational("19.99") ?? x
    printl("[{fmt'>7'(price)}]")
    printl("[{fmt'>5'(rational(1 3))}]")
    printl("[{fmt'>7.2f'(x)}]")
    printl("[{fmt'.1f'(x)}]")
    printl("[{fmt'07'(x)}]")
}

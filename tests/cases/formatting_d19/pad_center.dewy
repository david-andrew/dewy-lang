# pad_center beside pad_start and pad_end.
main = () => {
    printl("[{"hi".pad_center(6)}]")
    printl("[{"hi".pad_center(5)}]")
    printl("[{"hi".pad_center(2)}]")
    printl("[{"hi".pad_center(1)}]")
    printl("[{"hi".pad_center(6 "*")}]")
    printl("[{"é".pad_center(3)}]")
    printl("[{"hi".pad_start(4)}]")
    printl("[{"hi".pad_end(4)}]")
}

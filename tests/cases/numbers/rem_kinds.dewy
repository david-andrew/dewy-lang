# quick
# `%` is floored; `.rem(b kind=...)` names the truncated or Euclidean remainder.
main=()=>{
    let a:int64=-7
    let b:int64=3
    printl"{a.rem(b)} {a.rem(b kind='trunc')} {a.rem(b kind='euclid')} {a % b}"
    let c:int64=7
    let d:int64=-3
    printl"{c.rem(d)} {c.rem(d kind='trunc')} {c.rem(d kind='euclid')}"
    printl"{(-7).rem(-3 kind='euclid')} {rem(-7 -3 kind='trunc')}"
    let big:int=-(10^30)
    printl"{big.rem(7)} {big.rem(7 kind='trunc')} {big.rem(-7 kind='euclid')}"
    let k='trunc'
    printl((-7).rem(3 kind=k))
}

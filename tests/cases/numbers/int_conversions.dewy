from_float=(x:float64):>int=>int(x)
const WIDE=from_float(1267650600228229401496703205376.0)
const BACK=float64(WIDE)
const DECIMAL=int(999999999999999999999999999999.9)
const SHIFT=(-2)>>(2^100)
first=(start:int):>int=>{loop i in [start..start+10) return i return 0}
main=()=>{
    printl"{WIDE} {BACK =? 1267650600228229401496703205376.0} {DECIMAL} {SHIFT}"
    let value=999999999999999999999999999999.9
    printl"{int(value)} {int(-value)} {int64(1.99999999999999999999)} {int8(-1.9)}"
    let parse=@to_int
    printl"{parse("1267650600228229401496703205376")}"
    printl(from_text<int>("1267650600228229401496703205376"))
    printl(from_text<array<int>>("[1, 1267650600228229401496703205376, -2]"))
    printl(first(WIDE))
    let point=vec2(2+0.5 3+0.25)
    printl"{point.x} {point.y}"
}

$runtime_checks
main=():>void=>{
    let u:uint64=uint64.max
    printl(uint64(2) - uint64(34))
    printl(0 - u)
    printl(string(uint64(13) - uint64(33)))
    printl"wide={(uint64(255) << 59)}"
    printl(uint64(3) * u)
    printl((u and 7) xor 3)
    printl(u and (u + 14))
    printl(uint64(0) and (uint64(0) - uint64(1)))
    printl((uint64(5) - 39) >> 39)
}

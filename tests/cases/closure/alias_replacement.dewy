# exit: 42
Counter:type=(x:int64):>int64
make=(n:int64)=>{let value=n return (x:int64 $capture value)=>{value+=x; value}}
replace=(@f:Counter)=>{f=make(100); 2}
run=()=>{let current=make(40)
let before=current(replace(@current))
return if before=?42 and current(1)=?101 42 else 1}
main=()=>exit(run())

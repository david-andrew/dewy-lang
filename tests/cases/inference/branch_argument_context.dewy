id=(x:int64<overflow='wrap'>):>int64<overflow='wrap'>=>x
take=(x:int64<overflow='wrap'>):>int64<overflow='wrap'>=>x
wide=(x:uint64<overflow='wrap'>):>uint64<overflow='wrap'>=>x
main=():>void=>{
    let n:int64<overflow='wrap'>=id(int64<overflow='wrap'>.min)
    let k:int64<overflow='wrap'>=id(0)
    let a:int64<overflow='wrap'>=(match k {<-1>=>2 <0>=>(17-n) _=>n})
    printl(a)
    printl(take((match k {<-1>=>2 <0>=>(17-n) _=>n})))
    printl(take((if k =? 0 (17-n) else 2)))
    printl(wide((if k =? 0 9223372036854775808 else 34)))
    printl(take((match k {n:int64<overflow='wrap'>=>{let x:int64<overflow='wrap'>=n; 17-x} })))
}

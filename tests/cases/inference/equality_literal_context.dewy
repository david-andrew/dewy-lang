# quick
main=():>void=>{
    let r:[value:int64 xs:array<int64>]=[value=1 xs=[2]]
    let d:dict<int64 int64>=[1->2]
    printl(r =? [value=1 xs=[2]])
    printl([value=1 xs=[2]] =? r)
    printl(d =? [1->2])
    printl([1->2] =? d)
    printl(r not=? [value=2 xs=[2]])
    printl([1->3] not=? d)
    let nested:dict<string array<int64>>=["x"->[1 2]]
    printl(nested =? ["x"->[1 2]])
    let optional:dict<int64 int64>?=d
    printl(optional =? [1->2])
    printl([1->2] =? optional)
    let empty:dict<int64 int64>=[]
    printl(empty =? [])
    printl([] =? empty)
}

# In a loop, a `timeout=0s` poll's Timeout arm that changes nothing spins: the next turn polls the
# same empty waits (decisions.md, batch 7, the progress rule).
main = () => {
    let a = channel<int64>(2)
    let n = 0
    loop n <? 3 {
        match select(@a.receive timeout=0s) {
            v:int64 => {n += 1}
            <Closed> => break
            <Timeout> => printl"idle"
            <Canceled> => break
        }
    }
}

# modes: native native-release
# A parallel body may call C functions whose declared rows exclude blocking.
$runtime_checks

$extern
labs = (x:int64):>int64 & no_effects
$extern
llabs = (x:int64):>int64 & no blocks

main = ():>void => {
    let xs:array<int64> = []
    loop i in [0..2000) { xs.push(i - 1000) }
    let ys = [parallel x in xs $unsafe labs(x)]
    let zs = [parallel i in [0..2000) $unsafe llabs(1000 - i)]
    let a:int64 = 0
    let b:int64 = 0
    loop y in ys { a += y }
    loop z in zs { b += z }
    printl"{a} {b} {ys[0]} {zs[1999]}"
}

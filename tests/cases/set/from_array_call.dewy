# quick
# set(values) is the set of an array's elements, in first-occurrence order.
main=()=>{
    let xs=[3 1 3 2 1]
    let s=set(xs)
    printl(s)
    printl(s.length)
    printl(2 in? s)
    let words=set(["b" "a" "b"])
    words.push("c")
    printl(words)
    let empty:array<int64>=[]
    printl(set(empty).length)
}

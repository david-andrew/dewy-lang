# quick
# Sets of decimals (rationals) and of big integers under $runtime_checks=false: their hashing
# may not panic (a big integer's limbs are mixed with xor, not raised to a power).
$runtime_checks=false
main=()=>{
    let s=set[0.5 1.5 0.5]
    printl("{s.length} {s.has(1.5)} {s.has(2.5)}")
    let big:int=2^100
    let same:int=2^99*2
    let b=set[big same big+1]
    printl("{b.length} {b.has(2^100)} {hash(big) =? hash(same)}")
}

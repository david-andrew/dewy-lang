# exit: 42
let source=set[20 21] let calls:int64=0
read=()=>{calls=calls*10+1 return source}
change=()=>{calls=calls*10+2 source.remove(20); source.push(22) return 42}
run=()=>{let values=[read()... change() source...]
return if calls =? 12 and values =? [20 21 42 21 22] 42 else 1}
main=()=>exit(run())

$runtime_checks

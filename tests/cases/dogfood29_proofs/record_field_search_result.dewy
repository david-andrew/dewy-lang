# A helper's result bounded by a record parameter's array field bounds an
# index into that field at the caller, as one over a plain array does.
F:type = [hp:int moves:array<int>]
best = (f:F):>int? => {
    if f.moves.length =? 0 return none
    let pick = 0
    loop k in [1..f.moves.length) if f.moves[k] >? f.moves[pick] pick = k
    pick
}
last = (f:F):>int => {
    if f.moves.length =? 0 return -1
    f.moves.length - 1
}
G:type = [names:array<string> needs:array<int>]
intern = (@g:G name:string):>int => {
    loop i in [0..g.names.length) if g.names[i] =? name return i
    g.names.push(name)
    g.names.length - 1
}
main = () => {
    let f = F[1 [3 9 4]]
    let k = best(f)
    if k is? none return
    printl"{f.moves[k]}"
    let fs = [F[2 [5 6]] f]
    let j = last(fs[1])
    if j >=? 0 printl"{fs[1].moves[j]}"
    let g = G[["a" "b"] [0 0]]
    let at = intern(@g "c")
    printl"{g.names[at]} {g.names.length}"
}

# modes: native
# `$no_deadlocks`: looping over an inbox made elsewhere (here, in an opted-out function) is a
# wait on a choice among alternatives.
make = ():>Merged<int64> => {
    $no_deadlocks = false
    let a = mpmc<int64>(1)
    merged(@a.receive)
}
$no_deadlocks
drain = (inbox:Merged<int64>):>void | Canceled => {
    loop item in inbox or_throw { printl(item) }
}
main = () => {}

# modes: native
# `$no_deadlocks`: `serve` has no certificate until a library gate proves it. Its control is
# protocols/request_reply, which runs the protocol with no tag.
$no_deadlocks
square = (n:int64):>int64 => n * n
main = ():>void | Closed | Canceled => {
    let total = serve(@square (s:Service<int64 int64>):>int64 | Closed | Canceled => s.request(3) or_throw) or_throw
    printl"{total}"
}

$runtime_checks

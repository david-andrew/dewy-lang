# modes: native
# `$no_deadlocks` on one function: asking a service waits on `serve`'s protocol, which has no
# certificate until a library gate proves it. The server outside the scope is not checked.
$runtime_checks

square = (n:int64):>int64 => n * n
$no_deadlocks
ask = (s:Service<int64 int64>):>int64 | Closed<int64> | Canceled => {
    s.request(3) or_throw
}
main = ():>void | Closed<int64> | Canceled => {
    let total = serve(@square @ask) or_throw
    printl"{total}"
}

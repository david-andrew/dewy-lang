# modes: native
# `$no_deadlocks`: `inbox.next` of an inbox made elsewhere is a wait on a choice among alternatives.
$no_deadlocks

$no_deadlocks = false
make = ():>Merged<int64> => {
    let a = mpmc<int64>(1)
    merged(@a.receive)
}
take = (inbox:Merged<int64>):>int64 | Canceled | none => inbox.next
main = () => {}

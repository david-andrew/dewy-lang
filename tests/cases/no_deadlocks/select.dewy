# modes: native
# `$no_deadlocks`: `select` waits on a choice among alternatives, which no certificate counts
# (select-v6.md), so a program that may wait forever is an error.
$no_deadlocks
main = () => {
    let a = mpmc<int64>(1)
    let b = mpmc<int64>(1)
    match select(@a.receive @b.receive) {
        _ => printl"x"
    }
}

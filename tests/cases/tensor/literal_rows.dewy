# quick
let a=[1 2 ; 3 4]
printl(a)
printl(a.length)
printl([1 2 3 ; 4 5 6].length)
printl([1 2 3 ;].length)
let cube=[1 2 ; 3 4 ;; 5 6 ; 7 8]
printl(cube.length)
printl(cube[1 0 1])
let xs=[1 2 3]
let ys=[4 5 6]
printl([xs ; ys].length)
let probes:array<float64 length=[2 2]>=[(-1.0) 0.5 ; 0.25 2.0]
printl(probes[0 0] + probes[1 1])

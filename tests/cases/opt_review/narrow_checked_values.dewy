unsigned8 = (x:uint8 y:uint8 n:int64):>int64 => {
    let total:int64=0
    loop i in [0..n) {
        let sum:uint8=x + y
        let difference:uint8=x - y
        let product:uint8=x * y
        total+=int64(sum)+int64(difference)+int64(product)+i
    }
    total
}

unsigned16 = (x:uint16 y:uint16 n:int64):>int64 => {
    let total:int64=0
    loop i in [0..n) {
        let sum:uint16=x + y
        let difference:uint16=x - y
        let product:uint16=x * y
        total+=int64(sum)+int64(difference)+int64(product)+i
    }
    total

unsigned32 = (x:uint32 y:uint32 n:int64):>int64 => {
    let total:int64=0
    loop i in [0..n) {
        let sum:uint32=x + y
        let difference:uint32=x - y
        let product:uint32=x * y
        total+=int64(sum)+int64(difference)+int64(product)+i
    }
    total
}

main = ():>void => {
    printl("{signed8(-127 1 3)} {signed16(-32767 1 3)} {signed32(-2147483647 1 3)}")
    printl("{unsigned8(254 1 3)} {unsigned16(65534 1 3)} {unsigned32(4294967294 1 3)}")
}

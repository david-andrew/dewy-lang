# modes: native native-release
$runtime_checks

signed8 = (x:int8 y:int8 n:int64):>int64 => {
    let total:int64=0
    loop i in [0..n) {
        let sum:int8=x + y
        let difference:int8=x - y
        let product:int8=x * y
        total+=int64(sum)+int64(difference)+int64(product)+i
    }
    total
}

signed16 = (x:int16 y:int16 n:int64):>int64 => {
    let total:int64=0
    loop i in [0..n) {
        let sum:int16=x + y
        let difference:int16=x - y
        let product:int16=x * y
        total+=int64(sum)+int64(difference)+int64(product)+i
    }
    total
}


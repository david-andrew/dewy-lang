# A stepped loop's carried limbs keep the bounds the body re-establishes, so
# their products fit a word.
const LIMB:uint64 = 0x3ffffff
absorb = (h:array<uint64<(<=? 0x7ffffff)> length=2> r:uint64<(<=? 0x3ffffff)> data:array<uint8>):>uint64 => {
    let [h0 h1] = h
    loop at in [0, 16..data.length-1] {
        h0 += (data[at] as uint64) and LIMB
        let d0 = h0*r+h1*r*5
        let d1 = h0*r+h1*r
        let c = d0 >> 26
        h0 = d0 and LIMB
        d1 += c
        c = d1 >> 26
        h1 = d1 and LIMB
        h0 += c*5
        c = h0 >> 26
        h0 = h0 and LIMB
        h1 += c
    }
    return h0+h1
}
main = () => {
    printl(absorb([1 2] 3 [loop i in [0..40) ((i*7) and 255) as uint8]))
}

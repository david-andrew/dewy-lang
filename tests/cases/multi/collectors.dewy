# quick
f=()=>5
c=true
printl([f(); 7])
printl([{ 3 4 5 }])
printl([0 { 3 4 5 } 6])
printl([if c { 1 2 } else { 3 }])
printl([if not c { 1 2 } else { 3 }])
printl([if c 1  2])
printl([if not c 1  2])
printl([loop i in 0..3 { i i*10 }])
printl([loop i in 0..4 { printl(i) if i % 2 =? 0 i }])
let picked=[
    f();
    f()+1
]
printl(picked)
printl([1 2 ; 3 4])

# quick
# A binding's written type may be several values, `(int64 int64)`, as a result's is.
add=(a:int64 b:int64)=>a+b
pair=():>(int64 int64)=>{ 5 6 }
let top:(int64 string)=(1 "x")
run=()=>{
    let p:(int64 int64)=(3 4)
    printl(add(p))
    let q:(int64 int64)=pair()
    printl(add(q))
    let r:(int64 int64)={ 7 8 }
    printl(add(r))
    q=(9 10)
    printl(add(q))
    printl(top)
    let u:(uint8 float64)=(200 1)
    printl(u)
    let (a b)=u
    printl("{a} {b}")
}
run()

$runtime_checks

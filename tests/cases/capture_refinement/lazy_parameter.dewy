# A lazy body keeps its function's refined parameters across pulls from
# another generator: no guard is repeated inside the body.
buckets = (step:int<(>? 0)> times:generator<int>):>generator<int> => lazy loop t in times {
    t - t % step
}

average = (width:int<(>? 0)> xs:generator<int>):>generator<int> => lazy {
    let recent:array<int> = []
    let total = 0
    loop x in xs {
        recent.push(x)
        total += x
        if recent.length >? width total -= recent.pop(0)
        total // recent.length
    }
}

main = () => {
    printl([buckets(300 lazy (5 299 300 601 1199))...])
    printl([average(2 lazy (4 8 10 0 6))...])
}

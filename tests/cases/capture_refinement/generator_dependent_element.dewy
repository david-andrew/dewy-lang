# A generator's element contract may name a by-value parameter: each yield is checked against
# the argument the call captured, and the caller's loop relates each element to it.
G:type = [names:array<string> targets:array<int64<(<? names.length)>>]
all = (g:G):>generator<addr<(<? g.names.length)>> => lazy loop t in g.targets { t }
main = () => {
    let g = G[["a" "b"] [1 0 1]]
    loop t in all(g) printl(g.names[t])
}

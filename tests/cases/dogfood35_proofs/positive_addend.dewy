# A bounded product has no difference rows before the addition.
window = (xs:array<int> row:int<0 <=? row <=? 20> width:int<1 <=? width <=? 40>):>array<int> => {
    let start = row * width
    let stop = start + width
    if stop >? xs.length return []
    xs[start..stop)
}
main = () => {
    printl(window([0 1 2 3 4 5] 1 3))
    printl(window([0 1 2 3 4 5] 2 3))
}

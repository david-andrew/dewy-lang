BaseHandle = type of [
    token:int64
    $__copy__
    duplicate = ():>BaseHandle => BaseHandle[token]
]
# This keeps BaseHandle's identity; it does not mint a child with a parent
# portion. Until composition supports such refinements, diagnose the gap.
Extension:type = BaseHandle & [extra:int64]
copy_handle = (value:Extension):>Extension => value.copy()
main = ():>int64 => 42

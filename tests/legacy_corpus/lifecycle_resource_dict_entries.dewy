# Entry reads call the logical copy hook. Replacement evaluates its new
# owner before dropping the old one; inserted owners remain in the dictionary.
let drops:int64=0
let copies:int64=0
let selections:int64=0
Handle=type of [id:int64 values:array<int64>
$__drop__
release=():>void=>{drops+=id values.clear}
$__copy__
clone=():>Handle=>{copies+=1 Handle[id values.copy()]}
]
select=():>0=>{selections+=1 0}
replacement=():>Handle=>{if drops not=?0 return Handle[999 []] return Handle[20 [2]]}
work=():>int64=>{
    let groups:array<dict<int64 Handle>>=[[1->Handle[10 [1]]]]
    if 1 not in? groups[0] return 3
    let h=groups[0][1]
    groups[select()][1]=replacement()
    groups[0][2]=Handle[30 [3]]
    if selections not=?1 or copies not=?1 or drops not=?10 return 1
    if h.id not=?10 or h.values.length not=?1 return 2
    return 42
}
check=():>int64=>{
    drops=0 copies=0 selections=0
    if work() not=?42 or drops not=?70 return 1
    return 42
}
main=():>int64=>{
    if check() not=?42 return 1
    let before:int64=_arena_live_bytes
    loop i in 0.. and i <?100 {if check() not=?42 return 2}
    $runtime_assert _arena_live_bytes=?before
    return 42
}

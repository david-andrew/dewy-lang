# Entry intervals propose a difference invariant; each backedge must keep it.
work=(start:int64<v=>0<=?v<=?100>):>int64=>{
    let unrelated:int64=0
    let lower:int64=0
    let upper:int64=start
    loop lower<?10 and upper<?int64.max {
        $assert lower<=?upper
        unrelated+=2
        lower+=1
        upper+=1
    }
    $assert lower<=?upper
    $assert upper-lower<=?100
    return 42
}
main=():>int64=>if work(0)=?42 and work(100)=?42 42 else 1

let copies:int64=0
let drops:int64=0
let calls:int64=0
Handle=type of [id:int64 payload:array<int64>
    $__copy__
    duplicate=():>Handle=>{copies+=1 return Handle[id payload.copy()]}
    $__drop__
    release=():>void=>{drops+=1 payload.clear}
]
key=(value:Handle):>int64=>{calls+=1 return value.id}
exercise=():>int64=>{
    let items=[Handle[3 [30]] Handle[1 [10]] Handle[2 [20]]]
    items.sort(key=@key)
    if copies not=?3 or drops not=?3 or calls not=?3 return 1
    if items[0].id not=?1 or items[1].id not=?2 or items[2].id not=?3 return 2
    if items[0].payload.length not=?1 or items[0].payload[0] not=?10 return 3
    return 42
}
verify=():>int64=>{
    copies=0 drops=0 calls=0
    if exercise() not=?42 return 4
    return if copies=?3 and drops=?6 and calls=?3 42 else 5
}
main=():>int64=>{
    if verify() not=?42 return 6
    let before:int64=_arena_live_bytes
    loop i in [0..20) {if verify() not=?42 return 7}
    return if _arena_live_bytes=?before 42 else 8
}

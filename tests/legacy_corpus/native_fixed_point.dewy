# Fixed-point arithmetic: fixed absorbs integers and rationals, keeps a
# quantity's dimension, and converts at a `fixed` boundary.
import units
main=():>int64=>{
    let total:int64 = 0
    let third:fixed = 1/3
    let sum:fixed = third + 2/3 + 1.25
    if sum =? 9/4 { total += 10 }                          # 10
    let scaled:fixed = 2 * third
    if scaled.raw >=? 2863311530 and scaled.raw <=? 2863311532 { total += 5 }   # 15 (2/3 in Q32.32)
    let half:fixed = cos(60°)
    if half.raw >=? 2147483647 and half.raw <=? 2147483649 { total += 7 }     # 22
    let work = 20N * 10m * cos(45°)
    let joules:fixed = work / J
    if 141 <? joules and joules <? 142 { total += 8 }        # 30
    let neg:fixed = -half
    if neg <? 0 and neg + half =? 0 { total += 12 }          # 42
    return total
}

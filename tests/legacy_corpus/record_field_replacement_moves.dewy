$explicit_copies
Pack:type=[text:string values:array<int64>]
make=():>Pack=>{
    let values:array<int64>=[2]
    values.reserve(8)
    return Pack['owned' values]
}
Outer:type=[child:Pack]
exercise=():>int64=>{
    let p=make()
    let outer=Outer[make()]
    let before:int64=_arena_allocated_bytes
    outer.child=p
    outer.child.values.push(40)
    let result=if outer.child.values.length>?1 outer.child.values[0]+outer.child.values[1] else 0
    let allocated:int64=_arena_allocated_bytes-before
    # The inline store must not retain a second live array owner that forces
    # push to detach. Allow the record root or one descriptor, not data copies.
    return if result=?42 and allocated<=?64 0 else -1
}
main=():>int64=>{
    if exercise() not=?0 return 1
    let before:int64=_arena_live_bytes
    loop i in [0..100) {if exercise() not=?0 return 2}
    let retained:int64=_arena_live_bytes-before
    printl(retained)
    return if retained=?0 42 else 3
}

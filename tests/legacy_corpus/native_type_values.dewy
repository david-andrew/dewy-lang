# Types as runtime values: a `type<Lexeme>` value is a type minted under
# `Lexeme`, carried as its brand id. It is stored, compared, tested,
# matched, dispatched on (a static method or a function-typed slot through
# a hidden dispatcher), constructed through (a hidden constructor), and
# named (`typename`, string conversion); `typeof(value)` reads a value's.
Lexeme = $abstract type of any & [
    src:string
    eat:<(src:string):>int64?>
    width = ():>int64 => src.length
]
Blank = type of Lexeme & [
    eat = (src:string):>int64? => if src.startswith(" ") count(src) else none
    count = (src:string):>int64 => {
        i:int64 = 0
        loop i <? src.length { if src[i] not=? " " return i  i += 1 }
        return i
    }
]
Term = type of Lexeme & [
    tag:string = "w"
    eat = (src:string):>int64? => if src.startswith(" ") none else src.length
]
kinds_of = (n:int64):>array<type<Lexeme>> => if n =? 0 [Blank Term] else [Term]
main=():>int64=>{
    let total:int64 = 0
    match Blank.eat("  x") { n:int64 => { total += n }  <none> => { return 1 } }       # 2: off the type name
    let kinds:array<type<Lexeme> length=2> = [Blank Term]
    if kinds[0] =? Blank and kinds[1] not=? Blank and kinds[1] is? Lexeme and kinds[0] isnt? Term total += 1   # 3
    if kinds[1].typename =? "Term" and Blank.typename =? "Blank" and "{kinds[0]}" =? "Blank" total += 1       # 4
    let k:type<Lexeme> = kinds[1]
    if k is? Term total += 1                                                                                  # 5
    let tokens:array<Lexeme> = []
    loop kind in kinds_of(0) {
        match kind.eat(" ab") { n:int64 => { tokens.push(kind(src=" ab")) total += n }  <none> => { total += 10 } }   # 5+1+10 = 16
    }
    loop tok in tokens { match tok { w:Term => { total += w.width * 10 + w.tag.length }  s:Blank => { total += s.width } } }   # 16+3 = 19
    if tokens.length =? 1 and typeof(tokens[0]) =? Blank and typeof(tokens[0]).typename =? "Blank" total += 20    # 39
    match k { <Blank> => { total += 100 }  <Term> => { total += 3 } }                                           # 42
    return total
}

$explicit_copies
Box:type=[items:array<int64> counter:array<int64>]
Pair:type=[items:array<int64> offset:int64]
read=(pair:Pair):>int64 & no_effects=>pair.items.length+pair.offset
forward=(@box:Box):>int64 & reads<box> & mutates<box.counter> & allocates=>{
    box.counter.reserve(0)
    return read(Pair[box.items 40])
}
work=(@box:Box):>int64=>{
    let before:int64=_arena_allocated_bytes
    loop i in 0.. and i<?1000 {if forward(@box) not=?42 return 1}
    return if box.counter.length=?1 and _arena_allocated_bytes=?before 42 else 2
}
main=():>int64=>{let box=Box[[20 22] [1]] return work(@box)}


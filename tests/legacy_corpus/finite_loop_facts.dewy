# Fixed small loops compose state transitions; their bodies are not emitted
# multiple times. The facts hold after every path, including continue/break.
let main=():>int64=>{
    let values:array<int64>=[]
    loop i in 0..2 {values.push(14)}
    let stopped:array<int64>=[]
    loop i in 0..4 {
        if i=?2 break
        stopped.push(i)
    }
    let continued:array<int64>=[]
    loop i in 0..2 {
        if i<?2 continue
        continued.push(i)
    }
    let total:nat64=0
    loop value in [1 2 3] {total+=value}
    if total not=?6 or stopped[1] not=?1 or continued[0] not=?2 return 1
    return values[0]+values[1]+values[2]
}

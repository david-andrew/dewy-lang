# Growth moves stored bits, including signed narrow integers and aggregate
# handles. Saved values must remain independent when a buffer relocates.
Item:type=[values:array<int64 length=1> text:string]
needed=(@calls:int64):>int64=>{calls+=1 return 200}
text=(value:string):>string=>if value.length >? 1 value[1..] else ''
main=():>int64=>{
    let bytes:array<uint8>=[255]
    let shorts:array<int16>=[-1234]
    let words:array<int32>=[-70000]
    let wide:array<uint64>=[18446744073709551615]
    let flags:array<bool>=[false]
    let items:array<Item>=[Item[[42] text('xvalue:42')]]
    let rows:array<array<int64>>=[[42]]
    let strings:array<string>=[text('xvalue:42')]
    let saved=items
    let saved_bytes=bytes
    let calls:int64=0
    bytes.reserve(needed(@calls))
    if calls not=? 1 return 1
    loop i in 0..40 {
        bytes.push(201) shorts.push(-2345) words.push(-80000)
        wide.push(18446744073709551615) flags.push(true)
        items.push(Item[[i] text('xvalue:next')])
        rows.push([i]) strings.push(text('xvalue:next'))
    }
    if bytes[0] not=? 255 or shorts[0] not=? -1234 or words[0] not=? -70000 return 2
    if wide[0] not=? 18446744073709551615 or flags[0] not=? false return 3
    if items[0].text not=? 'value:42' or strings[0] not=? 'value:42' return 4
    items[0].values[0]=99 bytes[0]=99
    if saved[0].values[0] not=? 42 or saved_bytes[0] not=? 255 return 5
    let first=rows[0]
    if first.length =? 0 return 6
    return first[0]
}

$explicit_copies
Box:type=[items:array<int64>]
Holder:type=[box:Box]
wrap=(box:Box):>Holder=>Holder[box]
make=():>array<int64>=>[42]
work=():>int64=>{
 let value=wrap(Box[make()])
 return if value.box.items.length>?0 value.box.items[0] else 1
}
main=():>int64=>{
 loop i in [0..1000) {if work() not=?42 return 1}
 let before:int64=_arena_live_bytes
 loop i in [0..1000) {if work() not=?42 return 2}
 return if _arena_live_bytes=?before 42 else 3
}

$explicit_copies
Box:type=[items:array<int64> counter:int64]
Pair:type=[items:array<int64> offset:int64]
read=(pair:Pair unused:int64):>int64 & no_effects=>pair.items.length+pair.offset
change=(@box:Box):>int64=>{box.items.clear return 0}
forward=(@box:Box @other:Box):>int64 & reads<box> & mutates<box.counter> & mutates<other> & no allocates=>{
    box.counter+=1
    return read(Pair[box.items 40] change(@other))
}
work=(@box:Box):>int64=>{
    let other=Box[[1] 0]
    let before:int64=_arena_allocated_bytes
    loop i in 0.. and i<?1000 {if forward(@box @other) not=?42 return 1}
    return if box.counter=?1000 and _arena_allocated_bytes=?before 42 else 2
}
main=():>int64=>{let box=Box[[20 22] 0] return work(@box)}

# A recursive array owns its finite descendant tree. Hooks run before the
# fields, with array elements released in reverse order.
let trace:int64=0
Node=type of [id:int64 children:array<Node>
    $__drop__ release=():>void=>{trace=trace*10+id}
]
work=():>void=>{let tree=Node[1 [Node[2 []] Node[3 []]]]}
main=():>int64=>{
    let before:int64=_arena_live_bytes
    work()
    return if trace=?132 and before=?_arena_live_bytes 42 else 1
}

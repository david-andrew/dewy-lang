# A field may be refined by a field of its own type: `start:Point<x >=? 0>`
# is an invariant proven where a Segment is built and a fact wherever
# `s.start.x` is read. On a `0 | [...]` type the same spelling refines the
# object member — `Big<sign =? 1>` is a positive Big, nonzero by construction.
let Point:type = [x:int64 y:int64]
let Segment:type = [start:Point<x >=? 0> stop:Point]
let Big:type = 0 | [sign:-1|1 magnitude:uint64]     # the magnitude cannot carry a sign of its own

let first_cell = (s:Segment cells:array<int64 length >? 0>):>int64 => {
    if s.start.x <? cells.length { return cells[s.start.x] }   # `s.start.x >=? 0` is the field's fact
    return 0
}
let width = (s:Segment):>int64 => s.stop.x - s.start.x
let scaled = (b:Big<sign =? 1> k:uint64):>Big<sign =? 1> => [sign = 1 magnitude = b.magnitude * k]
let value_of = (b:Big):>int64 => {
    if b =? 0 { return 0 }
    return b.sign * (b.magnitude transmute int64)
}

let main = (args:array<string>):>int64 => {
    let scale:int64 = 1
    if args.length >? 1000 { scale = 2 }
    let checks:int64 = 0
    let s:Segment = [start = [x = 2 y = 5] stop = [x = 7 y = 1]]          # a literal proves the invariant
    let cells:array<int64> = [10 20 30 40]
    if first_cell(s cells) =? 30 and width(s) =? 5 { checks += 1 }
    let p:Point = [x = 3 * scale y = 0]
    if p.x >=? 0 {                                                         # a guard proves it for a runtime value
        let t:Segment = [start = p stop = [x = 9 y = 9]]
        if first_cell(t cells) =? 40 { checks += 2 }
    }
    let b:Big = [sign = 1 magnitude = (6 * scale) transmute uint64]
    if b not=? 0 {
        if b.sign =? 1 {                                                   # narrowed, then the sign proven
            let twice = scaled(b 2)
            if value_of(twice) =? 12 and twice.sign * (twice.magnitude transmute int64) =? 12 { checks += 4 }
        }
    }
    let q = 1/(3 * scale) - 2/(3 * scale)                                  # -1/3: the denominator stays positive by type
    if q not=? 0 {
        if q.denominator.sign =? 1 and q.numerator.sign =? -1 { checks += 8 }
    }
    return checks
}

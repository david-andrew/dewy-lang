# a slice's length is its endpoints' difference, read with the order facts:
# `src[i..]` under `loop i <? src.length` is at least 1, so it satisfies a
# `string<length >? 0>` parameter; a protocol slot returning a union, called
# through a function-typed field, delivers its result into the caller's cell

let nonempty:type = string<length >? 0>
let Bad = type of error
let Protocol:type = [eat:<(src:nonempty):>int64? | Bad>]
Space = type of Protocol & [eat = (src:nonempty):>int64? | Bad => if src[0] =? " " 1 else none]
Word = type of Protocol & [eat = (src:nonempty):>int64? | Bad => {
    if src[0] =? "!" return Bad
    if src[0] =? " " return none
    return 1
}]

let count = (src:string):>int64 => {
    i:int64 = 0
    total:int64 = 0
    let table:array<Protocol> = [Space Word]
    loop i <? src.length {
        loop protocol in table {
            match protocol.eat(src[i..]) {              # `src[i..]`: length ≥ 1 under the guard
                n:int64 => { total += n }
                <none> => {}
                <Bad> => { total += 100 }
            }
        }
        if i >? 0 { match Word().eat(src[0..i)) { n:int64 => { total += n }  <none> => {}  <Bad> => {} } }   # `[0..i)`: length i ≥ 1
        i += 1
    }
    return total
}
main = () => exit(count("ab c") + 35)    # per position: 1 1 1 1 → 4; prefixes "a" "ab" "ab " → 1 1 1 → 3; 7 + 35 = 42

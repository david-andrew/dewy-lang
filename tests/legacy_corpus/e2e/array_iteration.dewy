sum = (values:array<int64>):>int64 => {
    let total:int64 = 0
    loop value in values { total += value }
    return total
}

main = ():>int64 => {
    let values = [10 20 12]

    let indexes:int64 = 0
    loop i in 0.. and value in values { indexes += i }

    let letters:int64 = 0
    loop letter in ["a" "b"] { letters += letter.length }

    if sum(values) =? 42 and indexes =? 3 and letters =? 2 {
        return 42
    }
    return 1
}

# When every arm of an `if` without `else` diverges, the code after it keeps
# the negated refinements: the early-return idiom narrows the union below.
let describe = (v:int64|string):>int64 => {
    if v is? int64 { return v }
    else { let note = 0 }    # a non-diverging else still narrows below
    return v.length
}
let classify = (v:bool|int64|string):>int64 => {
    if v is? bool { return 1 }
    else if v is? int64 { return 2 }
    return v.length
}
let main = ():>int64 => {
    return describe(30) + describe("abcd") + classify("hello") + classify(1) + classify(true)  # 30+4+5+2+1 = 42
}

let greeting:string = "hello"

let identity = (value:string):>string => value

let choose = (flag:bool):>string|none =>
    if flag identity(greeting) else none

let main = ():>int64 => {
    let box:[value:string] = [value = identity(greeting)]
    let values:array<string> = ["other" box.value]
    let maybe:string|none = choose(true)
    if maybe is? string {
        if values[1] =? maybe and box.value.length =? 5 {
            return 42
        } else {
            return 2
        }
    } else {
        return 1
    }
}

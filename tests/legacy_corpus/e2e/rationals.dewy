# `a / b` on integers is an exact rational; decimal literals are exact too.
# The abstract `rational` has big-integer parts, so its arithmetic is total;
# dividing by a rational needs it proven nonzero (`if q not=? 0`), like
# integer division. `rational<int64>` is the explicit word form.
let third = 1/3
let main = ():>int64 => {
    let half:rational = 2/4
    let sum = third + half             # 5/6
    let scaled = sum * 12              # 10
    let diff = half - 9.8              # -93/10
    if half =? 0 { return 4 }
    let quotient = third / half        # 2/3
    let neg = -quotient                # -2/3
    printl"{sum} {scaled} {diff} {quotient} {neg}"
    let checks:int64 = 0
    if third <? half { checks += 1 }
    if half =? 1/2 { checks += 2 }
    if sum not =? 1 { checks += 4 }
    if scaled =? 10 { checks += 8 }
    if 1/3 >=? third { checks += 16 }
    if diff not=? 0 and scaled not=? 0 {                                    # the parts are big integers, behind the zero case
        if diff.denominator =? 10 and scaled.numerator =? 10 { checks += 32 }
    }
    let word:rational<int64> = 5/6
    if word.numerator + word.denominator =? 11 { checks += 64 }             # the word form has int64 parts
    return checks - 76                                                       # 127 - 76 = 51
}

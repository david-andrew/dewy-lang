# abstract `int`/`uint` in container annotations take the 64-bit word, also inside
# unions and `dict`/`set` parameters: `array<int|none>`, `dict<string int>`

Info:type = [
    name:string
    extra:dict<string int|none>
]

specs:dict<string Info> = [
    'a' -> [ 'x' [] ]
    'b' -> [ 'y' ['T'->(-1) '='->none] ]
]

total:int64 = 0
loop [key info] in specs {
    total += info.name.length
    loop [k v] in info.extra {
        if v is? int64 { total += v + 10 }
        else { total += 20 }
    }
}
# 1 + 1 + (-1 + 10) + 20 = 31

xs:array<int|none> = [1 none 3]
loop x in xs if x is? int64 total += x  # 35

ws:set<uint> = set[1 2 3]
counts:dict<int int> = [7 -> 3]
counts[7] = 3 + ws.length  # 6
main = () => {
    let missing = counts.get(8)
    if missing is? none total += 1  # 36
    return total + counts.get(7 0)    # 42
}

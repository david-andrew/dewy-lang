let drops:int64=0
Handle=type of [token:int64 values:array<int64>
$__drop__
release=():>void=>{drops+=1 token=0 values.clear}
]
make=(yes:bool):>Handle=>{
    let first=Handle[40 [1 2]]
    let second=Handle[1 [3]]
    if yes {first.token+=2 return first}
    second.token=42
    return second
}
from_loop=():>Handle=>{
    let outer=Handle[42 [4]]
    loop i in 0..3 {
        let inner=Handle[1 [5]]
        if i=?1 return outer
    }
    return outer
}
exercise=():>int64=>{
    let first=make(true)
    if drops not=?1 or first.token not=?42 or first.values.length not=?2 return 1
    let second=make(false)
    if drops not=?2 or second.token not=?42 or second.values.length not=?1 return 2
    let third=from_loop()
    if drops not=?4 or third.token not=?42 or third.values.length not=?1 return 3
    return 42
}
main=():>int64=>{
    if exercise() not=?42 or drops not=?7 return 1
    let before:int64=_arena_live_bytes
    loop i in 0.. and i <?100 {
        drops=0
        if exercise() not=?42 or drops not=?7 return 2
    }
    $runtime_assert _arena_live_bytes=?before
    return 42
}

# Pipe operators, statement groups in parentheses, let-form aliases, and
# refined bare-array alias arguments.
let Positive = int64< i => i >? 0 >
let NonEmpty = array< length >? 0 >
double = (x:int64):>int64 => x * 2
first = (items:NonEmpty<int64>):>int64 => items[0]
main=():>int64=>{
    let total:int64 = 0
    total += 5 |> @double                      # 10
    total += @double <| 3                      # 16
    if total >? 0 (total += 4)                 # 20
    if total >? 0 (total += 1 total += 1)      # 22
    let p:Positive = 8
    total += p                                 # 30
    total += first([12 1])                     # 42
    return total
}

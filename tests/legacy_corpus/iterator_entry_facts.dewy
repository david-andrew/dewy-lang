# Iterator inputs execute once. The inner body's writes cannot invalidate
# the enclosing guard before the one-time input pop has executed.
main=():>int64=>{
    let pending:array<int64>=[1]
    let seen:set<int64>=set[]
    let children:dict<int64 set<int64>>=[1->set[42]]
    let result:int64=0
    loop pending.length>?0 {
        loop child in children.get(pending.pop set[]) {
            if child not in? seen {seen.push(child) pending.push(child) result=child}
        }
    }
    return result
}

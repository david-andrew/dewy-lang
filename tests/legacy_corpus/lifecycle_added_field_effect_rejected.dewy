let changed:int64=0
ExtraHandle = type of [
    token:int64
    $__copy__
    duplicate = ():>ExtraHandle => {changed=1 return ExtraHandle[token]}
]
BaseHandle = type of [
    token:int64
    $__copy__
    duplicate = ():>BaseHandle => BaseHandle[token]
]
DerivedHandle = type of BaseHandle & [extra:ExtraHandle]
# Added fields keep their own lifecycle operations, including effects.
copy_handle = ():>DerivedHandle & no mutates => {
    let handle=DerivedHandle[42 ExtraHandle[1]]
    return handle.copy()
}
main = ():>int64 => 42

# Exposing raw storage must isolate existing and future ordinary snapshots.
snapshot=(values:array<int64>):>array<int64>=>values
copied_bytes=():>int64=>_arena_copied_bytes
let main=():>int64=>{
    let values:array<int64>=[]
    values.push(1)
    let before=values
    let raw:int64=values transmute int64
    let copied:int64=copied_bytes()
    let after=snapshot(values)
    printl(copied_bytes()-copied)
    __store_i64__(42 __load_i64__(raw))
    $runtime_assert values.length >? 0 and before.length >? 0 and after.length >? 0
    $runtime_assert values[0]=?42 and before[0]=?1 and after[0]=?1
    # Growing the exposed descriptor must preserve its pinned status.
    loop i in 0.. and i <? 100 {values.push(i)}
    let grown=values
    __store_i64__(99 __load_i64__(raw))
    $runtime_assert values.length >? 0 and grown.length >? 0
    $runtime_assert values[0]=?99 and grown[0]=?42
    # Intrinsic aggregate operands expose storage without a transmute too.
    let direct:array<int64>=[]
    direct.push(1)
    let address=__load_i64__(direct)
    let isolated=snapshot(direct)
    __store_i64__(2 address)
    $runtime_assert direct.length >? 0 and isolated.length >? 0
    $runtime_assert direct[0]=?2 and isolated[0]=?1
    # Source raw access also forces a descriptor for an inferred fixed array.
    let fixed=[1 2]
    let fixed_address=__load_i64__(fixed)
    let fixed_copy=fixed
    __store_i64__(9 fixed_address)
    $runtime_assert fixed[0]=?9 and fixed_copy[0]=?1
    return 42
}

# A recursive forwarding graph with substantial local bodies. Propagating a
# callee's effects must preserve local reads and reach every caller.
from reporting import Span
import p"../../dewy/bootstrap/semantic/hir.dewy" as hir
import p"../../dewy/bootstrap/semantic/ty.dewy" as types
import p"../../dewy/bootstrap/semantic/analyze/effects.dewy" as effects
exercise=(limit:int64):>int64=>{
    let nodes:array<hir.AST>=[]
    let ts:types.Table=types.Table[]
    let loc=Span[0 0]
    let empty=types.primitive('void' @ts)
    let word=types.primitive('int64' @ts)
    let array=types.array_type(word 1 @ts)
    let signature=types.function_type([] [] none empty [] @ts)
    let declarations:array<addr>=[]
    loop i in 0.. and i <? 128 {
        let binding:addr=1000+8*i
        let body:array<addr>=[]
        let value=hir.append_node(@nodes hir.ExpressedIdentifier[loc array 'values' binding])
        loop j in 0.. and j <? 32 {
            body.push(hir.append_node(@nodes hir.ArrayLength[loc word value]))
        }
        if i =? 127 {
            let zero=hir.append_node(@nodes hir.Integer[loc word '0d' 0])
            let index=hir.append_node(@nodes hir.Index[loc word value zero 0])
            body.push(hir.append_node(@nodes hir.IndexAssign[loc empty index zero]))
        }
        let next:addr=if i =? 127 0 else i+1
        let callee=hir.append_node(@nodes hir.ExpressedIdentifier[loc signature 'next' 10000+next])
        let place=hir.append_node(@nodes hir.Place[loc array value])
        let arguments:array<addr>=[place]
        let parameters:array<hir.Param>=[hir.Param['values' array binding place=true]]
        loop offset in [1..8) {
            let parameter:addr=binding+offset
            let read=hir.append_node(@nodes hir.ExpressedIdentifier[loc array 'cold' parameter])
            parameters.push(hir.Param["cold{offset}" array parameter])
            arguments.push(read)
        }
        body.push(hir.append_node(@nodes hir.FunctionCall[loc empty callee arguments []]))
        let block=hir.append_node(@nodes hir.Block[loc empty body true])
        let literal=hir.append_node(@nodes hir.FunctionLiteral[loc signature parameters [] none empty block])
        declarations.push(hir.append_node(@nodes hir.Declare[loc empty 'let' "f{i}" signature literal 10000+i]))
    }
    let root=hir.append_node(@nodes hir.Block[loc empty declarations true])
    let before:int64=_arena_allocated_bytes
    let result=effects.analyze_effects(root nodes ts)
    if _arena_allocated_bytes-before >? limit return 9
    loop i in 0.. and i <? 128 {
        let binding:addr=1000+8*i
        if binding not in? result.by_param_binding return 1
        let summary=result.by_param_binding[binding]
        if summary.reads.length not=? 1 or summary.mutates.length not=? 1 return 2
        if summary.rebinds.length not=? 0 or summary.escapes.length not=? 0 return 3
        if summary.reads[0].steps.length not=? 0 return 4
        let path=summary.mutates[0].steps
        if path.length not=? 1 or path[0] not=? '[]' return 5
        loop offset in [1..8) {
            let parameter:addr=binding+offset
            if parameter not in? result.by_param_binding return 6
            let cold=result.by_param_binding[parameter]
            if cold.reads.length not=?1 or cold.mutates.length not=?0 or cold.rebinds.length not=?0 or cold.escapes.length not=?0 return 7
            if cold.reads[0].steps.length not=?0 return 8
        }
    }
    return 42
}

main=(args:array<string>):>int64=>{
    let limit:int64=if 'native-budget' in? args 3500000 else 16000000
    if exercise(limit) not=?42 return 20
    let before:int64=_arena_live_bytes
    loop i in [0..3) {if exercise(limit) not=?42 return 21}
    return if _arena_live_bytes=?before 42 else 22
}

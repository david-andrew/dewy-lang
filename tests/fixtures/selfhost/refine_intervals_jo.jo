use '../../../compiler/refine_intervals.jo'
use '../../../compiler/checker_types.jo'
use '../../../compiler/checker_tokens.jo'
use '../../../compiler/refinement_types.jo'
read_i = (text: str) -> int: to_int(text) ?? 0
main = () -> int:
    argv = args()
    types = [TypeInfo(), TypeInfo(), TypeInfo(kind = .refined, elem = 1, st = 1), TypeInfo(kind = .var, ref = 2), TypeInfo(kind = .var, ref = 3)]
    predicates: RefAtom[][] = [[], []]
    loop line in split(read_file(argv[1]) ?? "", "\n"):
        p = split(line, " ")
        if p[0] == "T":
            types[1] = TypeInfo(kind = TK(read_i(p[1])), bits = i32(read_i(p[2])), sign = p[3] == "1")
            predicates[1] = []
        else if p[0] == "A":
            a = RefTerm(read_i(p[2]), read_i(p[3]), p[4] == "1", offset = read_i(p[5]))
            b = RefTerm(read_i(p[6]), read_i(p[7]), p[8] == "1", offset = read_i(p[9]))
            if p[10] == "1": a.path = [-1]
            if p[11] == "1": b.path = [-1]
            predicates[1].push(RefAtom(Tok(read_i(p[1])), a, b))
        else if p[0] == "Q":
            t = read_i(p[1]); math_int = read_i(p[2])
            known, low, high = ref_type_intervals_wide(types, predicates, t, math_int)
            narrow, out = ref_type_intervals(types, predicates, t, math_int)
            print("{known} {low} {high} {narrow} {out}")
    0

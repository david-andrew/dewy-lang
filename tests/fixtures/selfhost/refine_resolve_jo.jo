use '../../../compiler/refine_resolve.jo'
use '../../../compiler/refine_resolve_host.jo'
use '../../../compiler/checker_state.jo'
use '../../../compiler/checker_types.jo'
use '../../../compiler/checker_tokens.jo'
use '../../../compiler/refinement_types.jo'
use '../../../compiler/node_store.jo'

nodes: Node[] = [Node()]
types: TypeInfo[] = [TypeInfo(), TypeInfo(kind = .int_, sign = true), TypeInfo(kind = .array), TypeInfo(kind = .str_), TypeInfo(kind = .int_)]
names = ["", "self", "length", "field", "formal", "stable", "constant", "int64", "min", "max", "other"]
bindings = RefineBindings(fields = [3], formals = [4], self = 1, base_type = 1)
host = RefResolveHost(value_term, type_limit, fail)

make = (kind: NK, a: int = 0, b: int = 0, op: Tok = .eof, flags: int = 0, name: int = 0, value: int = 0) -> int:
    nodes.push(Node(kind = kind, a = i32(a), b = i32(b), op = i32(int(op)), flags = i32(flags), name = i32(name), ival = value, pos = 700))
    nodes.len() - 1
lit = (value: int, flags: int = 0) -> int: make(.int_lit, value = value, flags = flags)
ident = (name: int) -> int: make(.ident, name = name)
field = (base: int, name: int) -> int: make(.field, a = base, name = name)
bin = (op: Tok, a: int, b: int) -> int: make(.binary, a, b, op)

fail = (pos: int, message: str):
    print("E {pos} {message}")
    exit(7)

value_term = (n: int) -> RefTerm:
    name = int(nodes[n].name)
    print("V {name}")
    if name == 5: return RefTerm(3, 77)
    if name != 6: fail(nodes[n].pos, "unknown value")
    # Checking a constant can recurse and grow every borrowed arena. Restore
    # only the binders changed; newly checked nodes/types/names must survive.
    saved_formals = bindings.formals
    saved_self = bindings.self
    saved_base = bindings.base_type
    bindings.formals = [10]
    bindings.self = 10
    bindings.base_type = 2
    loop i in [0..300):
        nodes.push(Node())
        types.push(TypeInfo())
        names.push("grown")
    inner = ident(10)
    term = ref_resolve_term(nodes, types, names, bindings, host, inner, 0)
    length = ref_resolve_term(nodes, types, names, bindings, host, ident(2), 10)
    print("N {term.kind} {term.value} {length.path}")
    bindings.formals = saved_formals
    bindings.self = saved_self
    bindings.base_type = saved_base
    return RefTerm(1, 11)

type_limit = (n: int) -> RefResolveLimit:
    base = int(nodes[n].a)
    name = int(nodes[base].name)
    member = int(nodes[n].name)
    print("T {name} {member}")
    if name == 7 and member == 9: return RefResolveLimit(true, RefTerm(1, 9223372036854775807))
    if name == 10 and member == 8: return RefResolveLimit(true, RefTerm(4, 91))
    RefResolveLimit()

show = (term: RefTerm):
    print("{term.kind} {term.value} {term.unsigned} {term.path} {term.offset}")
term = (n: int, binder: int = 1):
    show(ref_resolve_term(nodes, types, names, bindings, host, n, binder))
atoms = (n: int, depth: int = 0):
    out: RefAtom[]
    ref_resolve_atoms(nodes, types, names, bindings, host, n, 1, out, depth)
    print("A {out.len()}")
    loop atom in out:
        print("O {int(atom.op)}")
        show(atom.a)
        show(atom.b)

main = ():
    mode = if args().len() > 1: to_int(args()[1]) ?? 0 else: 0
    x = ident(1)
    zero = lit(0)
    five = lit(5)
    if mode == 0:
        term(x)
        term(ident(3))
        term(ident(4))
        term(ident(5))
        term(ident(6))
        term(lit(-1, 2097152))
        term(bin(.minus, x, five))
        term(bin(.plus, five, ident(4)))
        term(bin(.plus, lit(4294967295), lit(1)))
        term(bin(.minus, lit(-4294967295), lit(1)))
        term(field(x, 3))
        term(field(field(x, 3), 2))
        term(field(ident(7), 9))
        term(field(ident(10), 8))
        bindings.base_type = 2
        term(ident(2))
        bindings.base_type = 3
        term(ident(2))
        bindings.base_type = 1
        atoms(bin(.lt, zero, x))
        atoms(bin(.eq, x, five))
        atoms(make(.not_, bin(.lt, x, five)))
        atoms(make(.and_, bin(.ge, x, zero), bin(.ne, x, five)))
        atoms(bin(.le, bin(.lt, zero, x), five))
        atoms(bin(.ge, bin(.gt, five, x), zero))
        loop flags in [0, 2, 536870912, 536870914]:
            atoms(bin(.kw_in, x, make(.range, zero, five, flags = flags)))
        atoms(bin(.lt, bin(.plus, ident(6), x), bin(.plus, ident(4), lit(15))))
        print("S {bindings.fields} {bindings.formals} {bindings.self} {bindings.base_type}")
    else if mode == 1: term(bin(.plus, lit(-1, 2097152), five))
    else if mode == 2:
        bindings.base_type = 4
        term(bin(.plus, x, five))
    else if mode == 3: term(bin(.plus, lit(4294967296), lit(1)))
    else if mode == 4: term(bin(.plus, x, lit(4294967297)))
    else if mode == 5: term(bin(.plus, bin(.plus, x, lit(4294967296)), lit(1)))
    else if mode == 6: term(bin(.plus, field(ident(10), 8), five))
    else if mode == 7: term(bin(.minus, five, x))
    else if mode == 8: term(field(five, 3))
    else if mode == 9: term(field(bin(.plus, x, five), 3))
    else if mode == 10: term(make(.unary, five, op = .minus))
    else if mode == 11: atoms(make(.or_, bin(.lt, x, five), bin(.gt, x, zero)))
    else if mode == 12: atoms(bin(.plus, x, five))
    else if mode == 13: atoms(bin(.gt, bin(.lt, zero, x), five))
    else if mode == 14: atoms(bin(.kw_in, x, make(.range, x, five)))
    else if mode == 15: atoms(bin(.lt, x, five), 33)
    else if mode == 16:
        tree = bin(.lt, x, five)
        loop i in [0..33): tree = make(.and_, tree, bin(.lt, x, five))
        atoms(tree)
    else if mode == 17:
        tree = bin(.eq, x, five)
        loop i in [0..16): tree = make(.and_, tree, bin(.eq, x, five))
        atoms(tree)
    else if mode == 18: atoms(bin(.lt, ident(6), ident(10)))

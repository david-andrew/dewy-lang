# The compiler's line_table.dewy: `line_table file...` prints each file's line starts,
# then the line and column of offsets across it, forward and back, and of an offset in
# the first file between files (the table's cache moving from file to file).
$runtime_checks
from p"../../../compiler/line_table.dewy" import LineTable, line_starts, line_col_in

main=():>void=>{
    let arguments=args()
    let t=LineTable[[] 0 0 0 0]
    let texts:array<string>=[]
    loop i in [1..arguments.length) {
        let text=read_text(arguments[i])
        if not (text is? string) {exit(1)}
        texts.push(text)
    }
    loop f in [0..texts.length) {
        let src=texts[f]
        let n:int64=(src as array<uint8>).length
        print"{f}:"
        loop s in line_starts(src) {print" {s}"}
        printl""
        let step:int64=if n <=? 64 1 else 97
        let off:int64=0
        loop off <=? n {
            let [l c]=line_col_in(@t int64(f) off src)
            printl"{f} {off} {l} {c}"
            off+=step
        }
        loop off >? 0 {
            off-=step
            let [l c]=line_col_in(@t int64(f) off src)
            printl"{f} {off} {l} {c}"
        }
        let [l c]=line_col_in(@t 0 (texts[0] as array<uint8>).length // 2 texts[0])
        printl"0 . {l} {c}"
    }
}

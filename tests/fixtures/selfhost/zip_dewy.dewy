# The compiler's zip.dewy: `zip out.zip file...` writes the named files.
from p"../../../compiler/zip.dewy" import write_zip

main=():>void=>{
    let arguments=args()
    let names:array<string>=[]
    let contents:array<array<uint8>>=[]
    loop i in [2..arguments.length) {
        let data=read_bytes(arguments[i])
        if not (data is? array<uint8>) {exit(1)}
        names.push(arguments[i])
        contents.push(data)
    }
    if write_zip(arguments[1] names contents) {0} else {1}
}

# One driver over the compiler's dewy_grammar.jo (the frozen twin) or, with this line naming
# dewy_grammar.dewy, over the leaf: `dewy_grammar_jo file` reads the file's lines, tab-separated.
#   T kind,symbol,space,newline ...           the lexemes asked about next (by number, 0 or 1)
#   Q at after_group                          the rules at a lexeme, on a line of its own
#   H at text                                 the hint for another language's operator text
#   O token                                   an operator's power, grouping, prefix powers,
#                                             chain direction and partial application
#   D name                                    a metatag's directive form and whether it is designed
#   S hex start stop                          the format spec's colon in the bytes (hex)
use '../../../compiler/dewy_tokens.dewy'
use '../../../compiler/dewy_lex.dewy'
use '../../../compiler/dewy_grammar.jo'

flag = (b: bool) -> str:
    if b: return "1"
    "0"

unhex = (s: str) -> str:
    out: u8[]
    i = 0
    loop i + 1 < len(s):
        out.push(u8(to_int("0x" + s[i..i + 2)) ?? 0))
        i += 2
    str_from_bytes(out)

main = ():
    text = read_file(args()[1]) ?? ""
    tokens: DewyLexeme[]
    lx = DewyLexer(-1, -1, "", -1, -1)
    loop line in split(text, "\n"):
        f = split(line, "\t")
        if f[0] == "T":
            tokens = []
            loop part in split(f[1], " "):
                v = split(part, ",")
                at = tokens.len()
                tokens.push(DewyLexeme(DewyKind(to_int(v[0]) ?? 0), 0, at * 2, at * 2 + 1, v[2] == "1", v[3] == "1", DewyToken(to_int(v[1]) ?? 0)))
            continue
        if f[0] == "Q":
            at = to_int(f[1]) ?? 0
            out = "{flag(dn_can_start(tokens, at))} {flag(dn_range_bound(tokens, at))} {flag(dn_coefficient_before(tokens, at))} {flag(dn_juxt_factor_next(tokens, at))} {flag(dn_double_closes(tokens, at))}"
            if at + 1 < tokens.len(): out += " {flag(dn_juxtaposed(tokens, at, f[2] == "1"))}"
            excluded = dn_juxt_excluded(tokens, at)
            out += " {flag(excluded)}"
            if excluded: out += " {dn_juxt_excluded_message(tokens, at)}"
            print(out)
        else if f[0] == "H": print("[{dn_operator_habit(tokens, to_int(f[1]) ?? 0, f[2])}]")
        else if f[0] == "O":
            t = DewyToken(to_int(f[1]) ?? 0)
            print("{dn_power(t)} {flag(dn_right_associative(t))} {dn_prefix_power(t, false)} {dn_prefix_power(t, true)} {dw_chain_way(t)} {flag(dn_partial_operator(t))}")
        else if f[0] == "D": print("{dn_directive_form(f[1])} {flag(dw_designed_directive(f[1]))}")
        else if f[0] == "S":
            source = unhex(f[1])
            print("{dn_spec_colon(lx, source, to_int(f[2]) ?? 0, to_int(f[3]) ?? 0)}")

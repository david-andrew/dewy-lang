# Share one checked prelude across the integration cases. Each module keeps
# its own bindings and entry function; every case still has to return 42.
import p"native_sibling_field_facts.dewy" as sibling
import p"native_refined_tag_tests.dewy" as tags
import p"native_stored_refinement_contracts.dewy" as stores
import p"native_parameter_defaults.dewy" as defaults
import p"native_diverging_tails.dewy" as tails
import p"native_array_sharing.dewy" as sharing
import p"native_array_sharing_raw.dewy" as raw
import p"native_borrowed_string_arrays.dewy" as borrowed
import p"native_shared_element_replacement.dewy" as replacements
import p"native_optional_views.dewy" as optionals
import p"native_dict_detach_growth.dewy" as dictionaries
import p"native_optional_flow_join.dewy" as flows
import p"native_range_normalization.dewy" as ranges
import p"native_bigint_membership.dewy" as membership
import p"native_owned_union_temporaries.dewy" as owned
import p"native_read_temporaries.dewy" as reads
import p"native_iterator_temporaries.dewy" as iterators
import p"native_static_strings.dewy" as strings
import p"native_binary_views.dewy" as binaries
import p"native_casefold_scaling.dewy" as casefold
import p"native_argument_lifetimes.dewy" as arguments
import p"native_dict_scalar_widths.dewy" as scalar_dictionaries

let main=():>int64=>{
    printl('Checking dictionary scalar widths')
    if scalar_dictionaries.main() not=?42 return 22
    printl('Checking argument snapshot lifetimes')
    if arguments.main() not=?42 return 21
    printl('Checking sibling field facts')
    if sibling.main() not=? 42 return 1
    printl('Checking refined union tags')
    if tags.main() not=? 42 return 2
    printl('Checking stored refinement contracts')
    if stores.main() not=? 42 return 3
    printl('Checking aggregate sharing')
    if sharing.main() not=? 42 return 4
    printl('Checking exposed array storage')
    if raw.main() not=? 42 return 5
    printl('Checking borrowed string arrays')
    if borrowed.main() not=? 42 return 6
    printl('Checking shared element replacement')
    if replacements.main() not=? 42 return 7
    printl('Checking parameter defaults')
    if defaults.main() not=? 42 return 8
    printl('Checking diverging function tails')
    if tails.main() not=? 42 return 9
    printl('Checking optional array views')
    if optionals.main() not=? 42 return 10
    printl('Checking shared dictionary growth')
    if dictionaries.main() not=? 42 return 11
    printl('Checking joined flow representations')
    if flows.main() not=? 42 return 12
    printl('Checking native range normalization')
    if ranges.main() not=? 42 return 13
    printl('Checking bigint membership')
    if membership.main() not=? 42 return 14
    printl('Checking owned union temporaries')
    if owned.main() not=? 42 return 15
    printl('Checking temporary aggregate reads')
    if reads.main() not=? 42 return 16
    printl('Checking temporary iterables')
    if iterators.main() not=?42 return 17
    printl('Checking static string descriptors')
    if strings.main() not=?42 return 18
    printl('Checking binary table views')
    if binaries.main() not=?42 return 19
    printl('Checking Unicode table read scaling')
    if casefold.main() not=?42 return 20
    return 42
}

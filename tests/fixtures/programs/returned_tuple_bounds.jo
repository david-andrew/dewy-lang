early = (flag: bool) -> (__dewy_int, __dewy_int):
    if flag: return (7, 8)
    (9, 10)

unknown = (flag: bool, n: __dewy_int) -> (__dewy_int, __dewy_int):
    if flag: return (7, 8)
    (n, 10)

choose = (flag: bool) -> (__dewy_int, __dewy_int):
    if flag: (3, 4)
    else: (5, 6)

arrays = (flag: bool) -> (__dewy_int[], __dewy_int[]):
    if flag: ([1, 2], [3])
    else: ([4, 5], [6])

short = (flag: bool) -> (__dewy_int[], __dewy_int[]):
    if flag: ([1, 2], [3])
    else: ([], [6])

main=()=>{
    let picture=render_image(80 20 ()=>{
        clear(WHITE)
        let phase=__chart_dashes(vec2(0 10) vec2(13 10) 10.0 0.0 4.0 BLACK)
        phase=__chart_dashes(vec2(13 10) vec2(27 10) 10.0 phase 4.0 BLACK)
        __chart_dashes(vec2(27 10) vec2(80 10) 10.0 phase 4.0 BLACK)
        # Accumulating distance used to stall near this fractional dash boundary.
        __chart_dashes(vec2(0 3) vec2(20.3 3) 2.1 5695.2 2.0 BLACK)
    })
    loop i in [0..8) {
        let brightness=picture.get(i*10+5 10).x
        if i%2=?0 {if brightness>?0.1 return 1}
        else {if brightness<?0.9 return 2}
    }
    let chart=Chart[title="Saved chart" equal_axes=true legend_at=LegendAt.bottom_left]
    chart.line([0 1 2] [0 2 0] "triangle" dash=3.7)
    chart.annotate(1.0 2.0 "apex")
    let result=chart_image(chart 320 240)
    if result.width not=?320 or result.height not=?240 return 3
    if not save_png(result "chart.png") return 4
    return 42
}

let main = ():>int64 => {
    let result:int64 = 0
    $outer
    loop i in 0,2..6 or j in 10,20..40 {
        loop k in 0,2..2 and l in 1,3..3 {
            if i =? 0 {
                result += 2
                continue $outer
            }
            if i =? 2 {
                result += 10
                break
            }
            result += 30
            break $outer
        }
    }
    return result
}

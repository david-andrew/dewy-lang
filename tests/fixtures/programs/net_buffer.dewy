import net

main=(args:array<string>):>void=>{
    loop i in [0..2) {
        let fd=to_int(args[i+1]) ?? -1
        net.__net_peers.push(net.__NetPeer[id=i fd=fd state=2 client=true])
    }
    let events=net.receive()
    if events.length not=?2 exit(1)
    # The second peer overwrites the scratch buffer before either event is read.
    loop i in [0..2) {
        if events[i].peer not=?i or events[i].kind not=?net.NetKind.message exit(2)
        if events[i].data.length not=?65536+i exit(3)
        loop byte in events[i].data {if byte not=?uint8(40+i) exit(4)}
    }
    exit(42)
}

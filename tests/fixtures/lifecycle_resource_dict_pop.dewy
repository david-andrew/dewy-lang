# Popped resources transfer to their result. Tombstones keep backing storage
# until compaction, but must never acquire another logical copy/drop hook.
let drops:int64=0
let copies:int64=0
Handle=type of [id:int64 values:array<int64>
$__drop__
release=():>void=>{drops+=id values.clear}
$__copy__
clone=():>Handle=>{copies+=1 Handle[id values.copy()]}
]
work=():>int64=>{
 let d:dict<int64 Handle>=[1->Handle[10 [1]] 2->Handle[20 [2]] 3->Handle[30 [3]]]
 let popped=d.pop(1)
 if drops not=?0 or copies not=?0 or popped.id not=?10 or d.length not=?2 return 1
 d.pop(2);
 if drops not=?20 return 2
 d[1]=Handle[40 [4]]
 let saved=d.copy()
 if copies not=?2 return 3
 d.clear
 if drops not=?90 or saved.length not=?2 return 4
 return 42
}
check=():>int64=>{
 drops=0 copies=0
 if work() not=?42 or drops not=?170 return 1
 return 42
}
main=():>int64=>{
 if check() not=?42 return 1
 let before:int64=_arena_live_bytes
 loop i in 0.. and i <?100 {if check() not=?42 return 2}
 $runtime_assert _arena_live_bytes=?before
 return 42
}

R:type=[a:int64 b:int64 c:int64 d:int64 e:int64 f:int64]
read=(r:R unused:int64):>int64=>r.a+r.f
write=(@r:R):>int64=>{r.a=100 r.f=200 return 0}
main=()=>{let a=R[20 0 0 0 0 22] let n=read(r=a unused=write(@a)) a=R[20 0 0 0 0 22] let m=read(unused=write(@a) r=a) return if n=?42 and m=?300 42 else 1}

$runtime_checks
R:type=[a:int64 b:int64 c:int64 d:int64 e:int64 f:int64]
read=(r:R unused:int64):>int64=>r.a+r.f
write=(@r:R):>int64=>{r.a=100 r.f=200 return 0}
M:type=[items:array<int64> word:string]
read_m=(m:M unused:int64)=>m.items[0]+m.word.length
write_m=(@m:M)=>{m.items=[] m.word="" return 0}
main=()=>{let a=M[[40] "hi"] return read_m(a write_m(@a))}

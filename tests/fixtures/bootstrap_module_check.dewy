from reporting import Error
import p"../../dewy/bootstrap/semantic/modules.dewy" as modules
import p"../../dewy/bootstrap/semantic/bindings.dewy" as bindings
import p"../../dewy/bootstrap/semantic/type_display.dewy" as display

# A reusable graph driver accepts the entry followed by an ordered prelude.
# Each invocation owns fresh module and declaration identities.
main = (argv:array<string>):>int64 => {
    $runtime_assert argv.length >=? 2
    let prelude:array<string>=[]
    let roots:array<string>=[]
    let i:addr=2
    loop i <? argv.length {
        if argv[i] =? '--library-root' {
            i+=1
            $runtime_assert i <? argv.length
            roots.push(argv[i])
        } else {prelude.push(argv[i])}
        i+=1
    }
    let engine=modules.Engine[prelude_files=prelude library_roots=roots]
    let entry=modules.load(argv[1] @engine)
    if entry is? Error {entry.fail return 1}
    let module=modules.module_at(entry engine)
    loop [name id] in module.exports {
        let binding=bindings.binding_at(engine.session.registry id)
        let type=if binding.value_type is? none 'type' else display.type_to_dewy(binding.value_type engine.session.types)
        printl("{name}:{type}")
    }
    return 0
}

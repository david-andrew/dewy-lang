let trace:int64=0
let hook_calls:int64=0
Token=type of [id:int64 $__drop__ release=():>void=>{trace=trace*10+id}]
# Moving a field does not invoke these whole-wrapper operations. With no
# wrapper drop hook, cleanup can release just the fields that remain live.
Wrapper=type of [first:Token second:Token
$__copy__ duplicate=():>Wrapper=>{hook_calls+=1 return Wrapper[Token[8] Token[9]]}
$__move__ relocate=():>Wrapper=>{hook_calls+=1 return Wrapper[Token[8] Token[9]]}
]
consume=(value:Token):>int64=>value.id
work=(flag:bool):>int64=>{
    let owner=Wrapper[Token[1] Token[2]]
    if flag {consume(owner.first);}
    return owner.second.id
}
main=():>int64=>{
    if work(true) not=?2 return 1
    let before:int64=_arena_live_bytes
    loop i in [0..100) {
        trace=0
        if work(true) not=?2 or trace not=?12 return 2
        trace=0
        if work(false) not=?2 or trace not=?21 return 3
    }
    return if _arena_live_bytes=?before and hook_calls=?0 42 else 4
}

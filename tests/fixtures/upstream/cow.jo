# copy-on-write must hold even when the optimizer hoists uniqueness checks out of loops
zero_all = (xs: mut int[]):
    loop i in [0..xs.len()): xs[i] = 0

keep = (xs: int[]) -> int[]: xs

g: int[][]

stash = (xs: int[]): g.push(xs)

main = ():
    a = [1, 2, 3]
    b = a                       # shared before the loop
    loop i in [0..3): a[i] = 0
    print(a, b)
    c = [1, 2, 3]
    loop i in [0..3):
        d = c                   # a copy made inside the loop
        c[i] = 9
        print(d, c)
    x = [5, 6]
    y = x
    zero_all(x)
    print(x, y)
    e = [1, 2, 3]
    loop i in [0..3):
        stash(e)                 # escapes through a call
        e[i] = i * 10
    print(e, g)
    f = [1, 2]
    loop i in [0..2):
        h = keep(f)
        f[i] = 7
        print(h)
    m = [3, 1, 2]
    loop i in [0..3):
        m.push(i)
        m[i] = m[i] * 2
    print(m)
    n = [[1, 2], [3, 4]]
    snap = n
    loop i in [0..2): n[i][0] = 0
    print(n, snap)
    k = [1, 2, 3]
    loop v in k: k[0] += v        # iterating over a snapshot of k
    print(k)

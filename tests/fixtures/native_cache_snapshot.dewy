from reporting import SrcFile, Span, Error, Warning
import p"../../dewy/bootstrap/semantic/cache_values.dewy" as codec
import p"../../dewy/bootstrap/semantic/module_state.dewy" as state
import p"../../dewy/bootstrap/semantic/module_directives.dewy" as directives
import p"../../dewy/bootstrap/semantic/context.dewy" as contexts
import p"../../dewy/bootstrap/semantic/bindings.dewy" as bindings
import p"../../dewy/bootstrap/semantic/hir.dewy" as hir
import p"../../dewy/bootstrap/semantic/ty.dewy" as types
import p"../../dewy/bootstrap/semantic/validation_state.dewy" as proofs
import p"../../dewy/bootstrap/semantic/analyze/intervals.dewy" as ranges
import p"../../dewy/bootstrap/parser/p0.dewy" as parser

# Include polymorphic syntax/HIR/type nodes, optional values, a large integer,
# and dictionaries with deleted entries. Physical lookup tables may change;
# their logical insertion order and every arena identity must survive.
main=():>int64=>{
    let source=SrcFile['snapshot.dewy' 'let greet=(name:string)=>"Hello \{name}!"']
    let parsed=parser.parse(source)
    if parsed is? Error return 1
    let session=contexts.Session[]
    session.sources.push(contexts.Source[source parsed.nodes])
    session.scopes.push(bindings.Scope[])
    let context=contexts.Context[0 0]
    let syntax=contexts.syntax_ref(parsed.root context @session)
    let word=types.primitive('int64' @session.types)
    let text=types.string_type(none @session.types)
    let span=Span[0 1]
    let integer=hir.Integer[span word '0d' 123456789012345678901234567890]
    session.hir.push(integer)
    session.hir.push(hir.TargetString[span text 'x86_64'])
    session.hir.push(hir.Declare[span word 'const' 'view' none 0 none view=true])
    session.hir.push(hir.FunctionLiteral[span types.function_type([] [] none word [] @session.types) [] [] none word 0 lifecycle='copy' lifecycle_composition=true])
    session.hir_edits.push(contexts.HirEdit[0 integer])
    let binding=bindings.allocate(@session.registry syntax 'answer' 'value' span)
    let record=bindings.binding_at(session.registry binding)
    record.type_value=types.GenericTypeAlias[[types.GenericParam['T' word]] word]
    record.value_type=word
    bindings.store_binding(@session.registry binding record)
    # Persist both the active page and retired pages, then mutate a decoded
    # copy to check that its pages remain independent of the saved snapshot.
    let last:addr=0
    loop i in 0..129 {last=bindings.allocate_param(@session.registry 'parameter' word span)}
    let route=bindings.route_id(@session.registry binding ['field'] word span)
    session.methods['deleted']=contexts.MethodEntry[binding]
    session.methods.pop('deleted');
    session.methods['retained']=contexts.MethodEntry[binding word true]
    session.retained_read_states.add(0)
    session.warnings.push(Warning[message='preserve this note'])
    let module=state.Module[source.path context 0 ['answer'->binding] prelude=true options=directives.Options[explicit_copies=true]]
    let decision=proofs.Decision[[0->proofs.Unfit[ranges.Interval[-123456789012345678901234567890 none] 'int64']] [1->7] [Warning[message='saved proof note']]]
    let saved=proofs.Prelude[[0] session.hir.length session.hir_edits.length [decision]]
    let original=state.PreludeSnapshot[session [module] [source.path->0] ['answer'->binding] saved]
    let encoded=codec.encode(original)
    if encoded is? codec.CacheMiss return 2
    let restored=codec.decode(encoded)
    if restored is? codec.CacheMiss return 3
    if restored.modules.length not=? 1 return 38
    if not restored.modules[0].options.explicit_copies return 39
    let copy=restored.session
    if types.primitive('int64' @copy.types) not=? word return 4
    if contexts.syntax_ref(parsed.root context @copy) not=? syntax return 5
    if restored.prelude_bindings.get('answer') not=? binding return 6
    if copy.hir.length not=? 4 or copy.sources.length not=? 1 return 7
    let first=copy.hir[0]
    if first isnt? hir.Integer or first.value not=? integer.value return 8
    if copy.hir[1] isnt? hir.TargetString return 9
    let view=copy.hir[2]
    if view isnt? hir.Declare or not view.view return 37
    let composed=copy.hir[3]
    if composed isnt? hir.FunctionLiteral or composed.lifecycle not=?'copy' or not composed.lifecycle_composition return 40
    if copy.methods.length not=? 1 or 'retained' not in? copy.methods return 10
    if not bindings.has_binding(copy.registry last) return 20
    if bindings.binding_at(copy.registry last).name not=?'parameter' return 21
    if bindings.route_at(copy.registry route) is?none return 22
    let prior=copy.registry
    let changed=bindings.binding_at(copy.registry last)
    changed.name='updated'
    bindings.store_binding(@copy.registry last changed)
    if bindings.binding_at(copy.registry last).name not=?'updated' return 23
    if bindings.binding_at(prior last).name not=?'parameter' return 24
    let proof=restored.validation
    if proof is? none or proof.decisions.length not=? 1 return 17
    let unfit=proof.decisions[0].unfit.get(0)
    if unfit is? none or unfit.interval is? none return 18
    let lower=unfit.interval.lower
    if lower is? none or lower not=? -123456789012345678901234567890 or unfit.interval.upper isnt? none return 19
    let again=codec.encode(restored)
    if again is? codec.CacheMiss or again.length not=? encoded.length return 11
    loop i in 0.. and i <? encoded.length {
        if encoded[i] not=? again[i] return 12
    }
    let truncated=encoded
    if truncated.length =? 0 return 13
    truncated.pop;
    if codec.decode(truncated) isnt? codec.CacheMiss return 14
    let trailing=encoded
    trailing.push(0)
    if codec.decode(trailing) isnt? codec.CacheMiss return 15
    let damaged=encoded
    $runtime_assert damaged.length >? 0
    damaged[0]=255
    if codec.decode(damaged) isnt? codec.CacheMiss return 16
    return 42
}

import p"../../dewy/bootstrap/semantic/effect_rows.dewy" as rows
import p"../../dewy/bootstrap/semantic/effect_inference.dewy" as infer

variable=(name:string):>rows.Contract=>rows.Contract[rows.Row[variables=[name]]]
main=():>int64=>{
    let a="{infer.PREFIX}1" let b="{infer.PREFIX}2"
    let pure=rows.Contract[rows.Row[]]
    let allocation=rows.Contract[rows.Row[[rows.Atom['allocates']]]]
    let definitions:dict<string rows.Contract>=[a->variable(b) b->variable(a)]
    let result=infer.solve(definitions)
    $runtime_assert a in? result and b in? result
    if rows.identity(rows.Contract[result[a]]) not=? rows.identity(pure) return 1
    definitions[b]=allocation
    result=infer.solve(definitions)
    $runtime_assert a in? result
    if rows.identity(rows.Contract[result[a]]) not=? rows.identity(allocation) return 2
    definitions[b]=rows.Contract[]
    result=infer.solve(definitions)
    $runtime_assert a in? result
    if not result[a].unknown return 3
    definitions[a]=pure definitions[b]=allocation
    let constraints=[infer.Constraint[variable(b) variable(a)]]
    result=infer.solve(definitions constraints)
    $runtime_assert constraints.length =? 1
    if not infer.satisfied(constraints[0] result) return 4
    if infer.satisfied(infer.Constraint[variable(a) pure] result) return 5
    let forbidden=rows.Contract[excluded=[rows.Atom['allocates']]]
    if infer.satisfied(infer.Constraint[variable(a) forbidden] result) return 6
    let missing=infer.resolve(variable("{infer.PREFIX}missing") result)
    if not infer.pending(missing) return 7
    let names:array<string>=[]
    loop index in [0..100) {names.push"{infer.PREFIX}{index}"}
    definitions.clear
    loop index in 0.. and index <? names.length {
        if index+1 <? names.length {definitions[names[index]]=variable(names[index+1])}
        else {definitions[names[index]]=allocation}
    }
    result=infer.solve(definitions)
    loop name in names {
        $runtime_assert name in? result
        if rows.identity(rows.Contract[result[name]]) not=? rows.identity(allocation) return 8
    }
    return 42
}

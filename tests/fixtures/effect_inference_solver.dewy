import p"../../dewy/bootstrap/semantic/effect_rows.dewy" as rows
import p"../../dewy/bootstrap/semantic/effect_inference.dewy" as infer

variable=(name:string):>rows.Contract=>rows.Contract[rows.Row[variables=[name]]]
main=():>int64=>{
    let a="{infer.PREFIX}1" let b="{infer.PREFIX}2"
    let pure=rows.Contract[rows.Row[]]
    let allocation=rows.Contract[rows.Row[[rows.Atom['allocates']]]]
    let definitions:dict<string rows.Contract>=[a->variable(b) b->variable(a)]
    let result=infer.solve(definitions)
    $runtime_assert a in? result and b in? result
    if rows.identity(rows.Contract[result[a]]) not=? rows.identity(pure) return 1
    definitions[b]=allocation
    result=infer.solve(definitions)
    $runtime_assert a in? result
    if rows.identity(rows.Contract[result[a]]) not=? rows.identity(allocation) return 2
    definitions[b]=rows.Contract[]
    result=infer.solve(definitions)
    $runtime_assert a in? result
    if not result[a].unknown return 3
    definitions[a]=pure definitions[b]=allocation
    let constraints=[infer.Constraint[variable(b) variable(a)]]
    result=infer.solve(definitions constraints)
    $runtime_assert constraints.length =? 1
    if not infer.satisfied(constraints[0] result) return 4
    if infer.satisfied(infer.Constraint[variable(a) pure] result) return 5
    let forbidden=rows.Contract[excluded=[rows.Atom['allocates']]]
    if infer.satisfied(infer.Constraint[variable(a) forbidden] result) return 6
    let missing=infer.resolve(variable("{infer.PREFIX}missing") result)
    if not infer.pending(missing) return 7
    let names:array<string>=[]
    loop index in [0..100) {names.push"{infer.PREFIX}{index}"}
    definitions.clear
    loop index in 0.. and index <? names.length {
        if index+1 <? names.length {definitions[names[index]]=variable(names[index+1])}
        else {definitions[names[index]]=allocation}
    }
    result=infer.solve(definitions)
    loop name in names {
        $runtime_assert name in? result
        if rows.identity(rows.Contract[result[name]]) not=? rows.identity(allocation) return 8
    }
    # Open negative guarantees survive forwarding, but an unknown assignment
    # and an unknown operation in a recursive component invalidate them.
    let fs=rows.Atom['reads' rows.Subject['resource' 'Filesystem']]
    let no_fs=rows.Contract[excluded=[fs]]
    definitions=[a->variable(b) b->no_fs]
    let solved=infer.solve_contracts(definitions)
    if not infer.satisfied_contracts(infer.Constraint[variable(a) no_fs] solved) return 9
    if infer.satisfied_contracts(infer.Constraint[variable(a) pure] solved) return 10
    solved=infer.solve_contracts(definitions [infer.Constraint[none variable(b)]])
    if infer.satisfied_contracts(infer.Constraint[variable(a) no_fs] solved) return 11
    definitions=[a->variable(b) b->rows.join(variable(a) rows.Contract[])]
    solved=infer.solve_contracts(definitions [infer.Constraint[variable(a) no_fs]])
    if infer.satisfied_contracts(infer.Constraint[variable(a) no_fs] solved) return 12
    definitions=[a->pure]
    solved=infer.solve_contracts(definitions [
        infer.Constraint[rows.Contract[rows.Row[[fs]]] rows.Contract[rows.Row[[fs] [a]]]]
        infer.Constraint[variable(a) no_fs]
    ])
    if not infer.satisfied_contracts(infer.Constraint[variable(a) no_fs] solved) return 13
    # A call resolves its source before moving parameter-relative subjects.
    # The same callback can be applied to two different routes and to private
    # storage without widening or renaming its own signature.
    let read=rows.Atom['reads' rows.Subject['parameter' '0']]
    let caller="{infer.PREFIX}call"
    let private_call="{infer.PREFIX}private"
    let projections:dict<string infer.Projection>=[
        caller->infer.Projection[variable(a) ['0'->rows.Subject['parameter' '1' ['field']]]]
        private_call->infer.Projection[variable(a) ['0'->none]]
    ]
    definitions=[a->pure b->rows.Contract[rows.Row[[read]]]]
    solved=infer.solve_contracts(definitions [infer.Constraint[variable(b) variable(a)]] projections)
    let translated=rows.Contract[rows.Row[[rows.Atom['reads' rows.Subject['parameter' '1' ['field']]]]]]
    if not infer.satisfied_contracts(infer.Constraint[variable(caller) translated] solved) return 14
    if not infer.satisfied_contracts(infer.Constraint[variable(private_call) pure] solved) return 15
    if infer.satisfied_contracts(infer.Constraint[variable(caller) pure] solved) return 16
    let excluded=rows.Atom['mutates' rows.Subject['parameter' '0']]
    let destination=rows.Contract[excluded=[rows.Atom['mutates' rows.Subject['parameter' '1' ['field']]]]]
    definitions=[a->rows.Contract[excluded=[excluded]]]
    constraints=[infer.Constraint[variable(caller) destination]]
    solved=infer.solve_contracts(definitions constraints projections)
    $runtime_assert constraints.length =? 1
    if not infer.satisfied_contracts(constraints[0] solved) return 17
    definitions[a]=rows.Contract[]
    solved=infer.solve_contracts(definitions constraints projections)
    if infer.satisfied_contracts(constraints[0] solved) return 18
    return 42
}

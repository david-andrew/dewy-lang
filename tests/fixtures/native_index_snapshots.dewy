# Reading evaluates the array value before evaluating the index. Its data
# must survive replacement or detachment during the second expression.
Table:type=[entries:array<int64> calls:int64=0]
clear=(@table:Table):>int64=>{
    table.entries=[]
    table.calls+=1
    return 0
}
replace=(@table:Table):>int64=>{
    table.entries[0]=99
    table.calls+=1
    return 0
}
append=(@table:Table):>int64=>{
    table.entries.push(99)
    table.calls+=1
    return 0
}
Index:type=(@table:Table):>int64
through_callback=(action:Index):>int64=>{
    let table=Table[[42]]
    let value=table.entries[action(@table)]
    return if value =? 42 and table.calls =? 1 42 else 1
}
Node:type=[value:int64]
Records:type=[entries:array<Node>]
clear_records=(@table:Records):>int64=>{table.entries=[] return 0}
aggregate=():>int64=>{
    let table=Records[[Node[42]]]
    let value=table.entries[clear_records(@table)]
    return value.value
}
let global_table=Table[[42]]
clear_global=():>int64=>{global_table.entries=[] return 0}
# A pure arithmetic index must not acquire descriptors on every iteration.
read_only=(values:array<int64>):>int64=>{
    let total:int64=0
    loop i in 0.. and i <? 128 {total+=values[i%values.length]}
    return total
}
exercise=():>int64=>{
    let table=Table[[42]]
    if table.entries[clear(@table)] not=? 42 or table.calls not=? 1 return 1
    table=Table[[42]]
    if table.entries[replace(@table)] not=? 42 or table.calls not=? 1 return 2
    table=Table[[42]]
    if table.entries[append(@table)] not=? 42 or table.calls not=? 1 return 3
    if through_callback(@clear) not=? 42 return 4
    if aggregate() not=? 42 return 6
    let values:array<int64>=[21 21]
    let before:int64=_arena_allocated_bytes
    if read_only(values) not=? 2688 return 7
    if _arena_allocated_bytes not=? before return 8
    return 42
}
main=():>int64=>{
    if global_table.entries[clear_global()] not=? 42 return 9
    if exercise() not=? 42 return exercise()
    let before:int64=_arena_live_bytes
    loop i in 0.. and i <? 32 {if exercise() not=? 42 return 10}
    if _arena_live_bytes not=? before return 11
    return 42
}

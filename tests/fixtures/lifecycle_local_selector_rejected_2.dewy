let trace:int64=0
Token=type of [id:int64 $__drop__ release=():>void=>{trace=trace*10+id}]
consume=(value:Token):>void=>{}
work=(left:int64 right:int64):>void=>{
    let i:int64=left
    let j:int64=right
    let values=[Token[1] Token[2]]
    if i<?0 or i>=?values.length or j<?0 or j>=?values.length or i=?j return
    consume(values[i])
    i=j
    consume(values[j])
}
main=():>int64=>{
    work(0 1)
    if trace not=?12 return 1
    trace=0
    work(1 0)
    return if trace=?21 42 else 2
}

# Lookup and subtree queries should scale with one binding's fields, not with
# every unrelated route accumulated across the compilation's modules.
from reporting import Span
import p"../../dewy/bootstrap/semantic/bindings.dewy" as bindings
main=():>int64=>{
    let registry=bindings.Registry[]
    let loc=Span[0 0]
    let last:addr=0
    let expected:addr=0
    loop i in 0..511 {
        last=bindings.allocate(@registry none 'owner' 'value' loc)
        expected=bindings.route_id(@registry last ['bag' 'a'] 0 loc)
        bindings.route_id(@registry last ['bag' 'b'] 0 loc);
    }
    let before:int64=_arena_allocated_bytes
    loop i in 0..9999 {
        if bindings.route_id(@registry last ['bag' 'a'] 0 loc) not=? expected return 1
        let selected=bindings.routes_under(registry last ['bag'])
        if selected.length not=? 2 return 2
        if selected[0] not=? expected or selected[1] not=? expected+1 return 3
    }
    printl(_arena_allocated_bytes-before)
    return 42
}

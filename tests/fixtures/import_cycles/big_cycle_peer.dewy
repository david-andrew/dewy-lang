import p"../../cases/import_cycles/big_cycle.dewy" as top
let base=10
printl"base = {base}"
odd=(n:int):>int => if n =? 0 base else top.even(n - 1)
parity=(n:int):>int => top.even(n)
total=(n:int):>int => top.weigh(n) + base
let p0=total(0)
printl"p0 = {p0}"
let p1=total(1) + p0
printl"p1 = {p1}"
let p2=top.weigh(2) - odd(2)
printl"p2 = {p2}"
let p3=parity(3) + p2
printl"p3 = {p3}"
let p4=total(4) + p3
printl"p4 = {p4}"
let p5=top.weigh(5) - odd(5)
printl"p5 = {p5}"
let p6=parity(6) + p5
printl"p6 = {p6}"
let p7=total(7) + p6
printl"p7 = {p7}"
let p8=top.weigh(8) - odd(8)
printl"p8 = {p8}"
let p9=parity(9) + p8
printl"p9 = {p9}"
let p10=total(10) + p9
printl"p10 = {p10}"
let p11=top.weigh(11) - odd(11)
printl"p11 = {p11}"
let p12=parity(12) + p11
printl"p12 = {p12}"
let p13=total(13) + p12
printl"p13 = {p13}"
let p14=top.weigh(14) - odd(14)
printl"p14 = {p14}"
let p15=parity(15) + p14
printl"p15 = {p15}"
let p16=total(16) + p15
printl"p16 = {p16}"
let p17=top.weigh(17) - odd(17)
printl"p17 = {p17}"
let p18=parity(18) + p17
printl"p18 = {p18}"
let p19=total(19) + p18
printl"p19 = {p19}"
let p20=top.weigh(20) - odd(20)
printl"p20 = {p20}"
let p21=parity(21) + p20
printl"p21 = {p21}"
let p22=total(22) + p21
printl"p22 = {p22}"
let p23=top.weigh(23) - odd(23)
printl"p23 = {p23}"
let p24=parity(24) + p23
printl"p24 = {p24}"

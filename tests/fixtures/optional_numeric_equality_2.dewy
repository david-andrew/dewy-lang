
equal=(value:bigint?):>bool=>value=?123456789012345678901234567890
unequal=(value:bigint?):>bool=>value not=?123456789012345678901234567890
main=():>int64=>{
    if equal(none) or equal(0) or equal(4) return 1
    if not equal(123456789012345678901234567890) or unequal(123456789012345678901234567890) return 2
    if not unequal(none) or not unequal(0) or not unequal(4) return 3
    return 42
}

let drops:int64=0
Handle=type of [token:int64 values:array<int64>
$__drop__
release=():>void=>{drops+=1 token=0 values.clear}
$__copy__
copy=():>Handle=>Handle[token values.copy()]
]
consume=(owner:Handle):>int64=>owner.token
explicit=(owner:Handle):>int64=>{return owner.token}
returned=(owner:Handle):>Handle=>owner
callback=(f:(owner:Handle):>int64):>int64=>f(Handle[42 [1]])
defaulted=(owner:Handle=Handle[42 [2]]):>int64=>owner.token
snapshot=(owner:Handle):>array<int64>=>owner.values
exercise=():>int64=>{
    if consume(Handle[42 [1]]) not=?42 or drops not=?1 return 1
    if explicit(Handle[42 [1]]) not=?42 or drops not=?2 return 2
    if callback(@consume) not=?42 or drops not=?3 return 3
    if defaulted() not=?42 or drops not=?4 return 4
    let owner=returned(Handle[42 [3]])
    if owner.token not=?42 or drops not=?4 return 5
    if consume(owner.copy()) not=?42 or drops not=?5 return 6
    let values=snapshot(Handle[42 [40 2]])
    if drops not=?6 return 7
    if values.length not=?2 return 8
    return values[0]+values[1]
}
main=():>int64=>{
    if exercise() not=?42 or drops not=?7 return 1
    let before:int64=_arena_live_bytes
    loop i in 0.. and i <?100 {
        drops=0
        if exercise() not=?42 or drops not=?7 return 2
    }
    $runtime_assert _arena_live_bytes=?before
    return 42
}

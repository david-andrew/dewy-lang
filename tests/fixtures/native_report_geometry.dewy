# Runtime reports clip multiline spans to their first row and retain each
# source's path/first_row. The cache must distinguish equal offsets in files.
from reporting import SrcFile, Span
import p"../../dewy/bootstrap/semantic/context.dewy" as contexts
import p"../../dewy/bootstrap/semantic/bindings.dewy" as bindings
import p"../../dewy/bootstrap/semantic/ty.dewy" as types
import p"../../dewy/bootstrap/semantic/hir.dewy" as hir
import p"../../dewy/bootstrap/semantic/runtime_reports.dewy" as reports
main=():>int64=>{
    let session=contexts.Session[]
    session.sources.push(contexts.Source[SrcFile['left' 'á\r\n👨‍👩‍👧‍👦\nZ' 17] []])
    session.sources.push(contexts.Source[SrcFile['right' '\nlast\n' 30] []])
    let word=types.primitive('int64' @session.types)
    let empty=types.primitive('void' @session.types)
    let never=types.primitive('never' @session.types)
    let loc=Span[0 0]
    let helpers:dict<string addr>=[]
    loop [name arity] in ['_assertion_report'->4 '_expectation_report'->4 '_assertion_render'->4 'exit'->1 '_expect_failed'->0] {
        let args:array<addr>=[]
        loop i in 0.. and i <? arity {args.push(word)}
        let signature=types.positional_function(args word @session.types)
        let id=bindings.allocate(@session.registry none name 'function' loc)
        let binding=bindings.binding_at(session.registry id)
        binding.value_type=signature
        bindings.store_binding(@session.registry id binding)
        helpers[name]=id
    }
    let first=hir.append_node(@session.hir hir.RuntimeFailure[Span[2 5] never 0 'condition' 'assert'])
    let second=hir.append_node(@session.hir hir.RuntimeFailure[Span[1 3] never 1 'condition' 'expect' dimmed=Span[3 4]])
    let third=hir.append_node(@session.hir hir.RuntimeFailure[Span[6 6] never 1 'fail' 'fail'])
    let root=hir.append_node(@session.hir hir.Block[loc empty [first second third] true])
    if reports.lower(root helpers @session) isnt? none return 1
    let count=session.hir.length
    if reports.lower(root helpers @session) isnt? none or session.hir.length not=? count return 2
    let pending:array<addr>=[root]
    let rows:set<int64>=set[]
    let spans:addr=0
    loop pending.length >? 0 {
        let node=hir.node_at(session.hir pending.pop)
        loop child in hir.children(node) {pending.push(child)}
        if node isnt? hir.FunctionCall continue
        let function=hir.node_at(session.hir node.func)
        if function isnt? hir.ExpressedIdentifier continue
        let args=node.pos_args
        if function.name =? '_assertion_render' {
            if args.length not=? 4 return 3
            let path=hir.node_at(session.hir args[1])
            let row=hir.node_at(session.hir args[2])
            let contents=hir.node_at(session.hir args[3])
            if path isnt? hir.String or row isnt? hir.Integer or contents isnt? hir.String return 4
            if row.value =? 18 {
                if path.content not=? 'left' or contents.content not=? '👨‍👩‍👧‍👦' return 5
                rows.add(18)
            } else if row.value =? 31 {
                if path.content not=? 'right' or contents.content not=? 'last' return 6
                rows.add(31)
            } else if row.value =? 32 {
                if path.content not=? 'right' or contents.content not=? '' return 7
                rows.add(32)
            } else return 8
        } else if function.name is? '_assertion_report'|'_expectation_report' {
            if args.length not=? 4 return 9
            let begin=hir.node_at(session.hir args[0])
            let stop=hir.node_at(session.hir args[1])
            let dim=hir.node_at(session.hir args[2])
            if begin isnt? hir.Integer or stop isnt? hir.Integer or dim isnt? hir.Integer return 10
            if begin.value not=? 0 return 11
            if function.name =? '_assertion_report' {
                if stop.value not=? 1 or dim.value not=? 1 return 12
            } else if stop.value =? 2 {
                if dim.value not=? 3 return 13
            } else if stop.value not=? 0 or dim.value not=? 0 return 14
            spans+=1
        }
    }
    if rows.length not=? 3 or spans not=? 3 return 15
    return 42
}

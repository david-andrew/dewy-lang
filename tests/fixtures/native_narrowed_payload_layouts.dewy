# A record local of an abstract parent type, narrowed to a child union and
# stored back as the parent: the narrowed read wraps a copy of the record in
# a temporary cell, and that copy carries the child's layout. Moving it out
# of the temporary as the parent handed a Left-sized block to storage that
# is released with the Node family's size (a wrong arena size class), which
# corrupted later allocations. Such reads keep the ordinary owned copy.
Node=$abstract type of [loc:int64]
Left=type of Node & [value:int64]
Right=type of Node & [a:int64 b:int64 c:int64 d:int64 value:int64]
let live=():>int64=>_arena_live_bytes
let bump=(@nodes:array<Node> id:addr):>void=>{
    if id >=? nodes.length return void
    let node=nodes[id]
    if node is? Left|Right {
        if node is? Left {node.value=node.value+1}
        else if node is? Right {node.value=node.value+1}
        nodes[id]=node
    }
}
let churn=(@nodes:array<Node>):>bool=>{
    loop i in 0.. and i <? nodes.length {bump(@nodes i)}
    # Fresh family-sized records reuse whatever the releases returned.
    let fresh:array<Node>=[]
    loop i in 0.. and i <? 64 {fresh.push(Right[i 1 2 3 4 i])}
    loop i in 0.. and i <? fresh.length {
        let r=fresh[i]
        if r isnt? Right or r.a not=? 1 or r.d not=? 4 or r.value not=? i or r.loc not=? i return false
    }
    return true
}
let main=():>int64=>{
    let nodes:array<Node>=[]
    loop i in 0.. and i <? 64 {
        if i % 2 =? 0 {nodes.push(Left[i 0])} else {nodes.push(Right[i 1 2 3 4 0])}
    }
    let before=live()
    loop round in 0.. and round <? 200 {if not churn(@nodes) return 1}
    if live() not=? before return 2
    loop i in 0.. and i <? nodes.length {
        let node=nodes[i]
        if node is? Left {if node.value not=? 200 return 3}
        else if node is? Right {if node.value not=? 200 or node.c not=? 3 return 4}
        else return 5
    }
    return 42
}

# A resource consumed in one branch is cleaned up by that branch's new
# owner. The untouched branch keeps the original until its lexical exit.
let trace:int64=0
Token=type of [id:int64
$__drop__
release=():>void=>{trace=trace*10+id}
]
consume=(value:Token):>int64=>value.id
probe=(flag:bool):>int64=>{
    let owner=Token[3]
    if flag {let next=owner consume(next);}
    trace=trace*10+1
    return 42
}
choose=(flag:bool):>int64=>{
    let owner=Token[3]
    let selected=if flag owner else Token[4]
    return selected.id
}
main=():>int64=>{
    let before:int64=_arena_live_bytes
    loop i in [0..40) {
        trace=0
        let flag=i%2=?0
        if probe(flag) not=?42 return 1
        if trace not=? (if flag 31 else 13) return 2
        trace=0
        if choose(flag) not=? (if flag 3 else 4) return 3
        if trace not=? (if flag 3 else 43) return 4
    }
    return if before=?_arena_live_bytes 42 else 5
}

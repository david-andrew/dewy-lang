from reporting import Error
import p"../../dewy/bootstrap/paths.dewy" as paths
import p"../../dewy/bootstrap/invocation/platform.dewy" as platform
import p"../../dewy/bootstrap/semantic/modules.dewy" as modules
import p"../../dewy/bootstrap/semantic/prelude.dewy" as prelude
import p"../../dewy/bootstrap/semantic/prelude_cache.dewy" as cache
import p"../../dewy/bootstrap/backend/udewy/graph.dewy" as graph
import p"../../dewy/bootstrap/backend/udewy/program.dewy" as program

# A reusable execution-test driver for programs needing real library modules.
# A shared checked prelude avoids checking Unicode and numeric libraries again
# for every case. Entry modules and all emitted programs remain independent.
main=(argv:array<string>):>int64=>{
    $runtime_assert argv.length >=? 4
    # Match the real CLI's absolute module identities. Mixing a relative
    # entry import with an absolute prelude would check one file twice.
    let cwd=platform.kernel_path(false)
    if cwd is? Error {cwd.fail}
    let library=paths.absolute(argv[2] cwd)
    # DEWY_TEST_TARGET=wasm32 checks against the wasm32 prelude, and with
    # DEWY_TEST_NATIVE writes a wasm32 module instead of an executable.
    let wasm=environment('DEWY_TEST_TARGET') =? 'wasm32'
    let target=if wasm 'wasm32' else 'x86_64'
    let files=prelude.files(library target)
    loop index in 4.. and index <? argv.length {files.push(paths.absolute(argv[index] cwd))}
    let engine=modules.Engine[library_roots=[library] prelude_files=files]
    engine.session.target=target
    engine.prelude_cache=cache.Config[paths.absolute(argv[0] cwd) paths.absolute(argv[3] cwd) target [library] files]
    let entry=modules.load(paths.absolute(argv[1] cwd) @engine)
    if entry is? Error {entry.fail}
    let expected=environment('DEWY_TEST_PRELUDE_CACHE')
    if expected isnt? none and (expected =? 'hit') not=? engine.prelude_cache_restored return 3
    # DEWY_TEST_NATIVE names where to write the program as an executable built
    # by the native route (4: the route does not cover this program yet).
    let native_path=environment('DEWY_TEST_NATIVE')
    let compilation=graph.compile(entry @engine native_code=native_path isnt? none and not wasm native_wasm=native_path isnt? none and wasm)
    if compilation is? Error {compilation.fail}
    loop warning in compilation.analysis.warnings {warning.warn}
    if native_path isnt? none {
        let image=compilation.lowered.native
        if image is? none return 4
        let written=p(native_path).write_bytes(image)
        return if written is? int64 0 else 5
    }
    if environment('DEWY_TEST_ALLOCATOR_NOTES') =? '1' {
        loop note in compilation.lowered.placements {printl(note.reason)}
        return 0
    }
    let emitted=program.render(compilation.lowered.program compilation.lowered.input)
    if emitted is? Error {emitted.fail}
    printl(emitted)
    return 0
}

let copies:int64=0
Owner=type of [value:int64
    $__copy__
    duplicate=():>Owner=>{copies+=1 return Owner[value]}
]
duplicate_owner=():>int64=>{
    let first=Owner[1]
    let second=first.copy()
    return second.value
}
plain=(x:int64):>int64=>x+1
main=()=>{let total=duplicate_owner()+plain(1) assert(total=?3)}

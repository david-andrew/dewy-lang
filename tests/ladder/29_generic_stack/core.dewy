Stack:type=<T>[values:array<T>]
push=<T>(@stack:Stack<T> value:T):>void=>{
    stack.values.push(value)
}
pop=<T>(@stack:Stack<T>):>T|none=>{
    if stack.values.length =? 0 {return none}
    return stack.values.pop()
}
peek=<T>(stack:Stack<T>):>T|none=>{
    if stack.values.length =? 0 {return none}
    return stack.values[end]
}
main=():>int64=>{
    let ints:Stack<int64>=[values=[]]
    loop n in [0..4) {push(@ints n)}
    let snapshot=ints
    assert(pop(@ints) =? 3)
    assert(peek(ints) =? 2)
    assert(peek(snapshot) =? 3)
    let strings:Stack<string>=[values=[]]
    push(@strings "alpha")
    push(@strings "beta")
    assert(pop(@strings) =? "beta")
    assert(pop(@strings) =? "alpha")
    assert(pop(@strings) is? none)
    let sum=0
    loop ints.values.length >? 0 {sum+=pop(@ints) ?? 0}
    assert(sum =? 3)
    printl("{sum} {snapshot.values.length} {strings.values.length}")
    return 0
}

# Deterministic dumps: one line of tokens and one S-expression per statement.
from p"lexer.dewy" import Token, text_of
from p"parser.dewy" import Node, Parsed

# Quoted text with the escapes a reader needs to see.
quoted = (value:string):>string => {
    let out:array<uint8> = [b'"']
    loop b in bytes(value) {
        if b =? b'"' or b =? b'\\' {
            out.push(b'\\')
            out.push(b)
        } else if b =? b'\n' {
            out.extend(bytes("\\n"))
        } else if b =? b'\t' {
            out.extend(bytes("\\t"))
        } else if b <? b' ' {
            out.extend(bytes("\\x{format(b "02x")}"))
        } else {
            out.push(b)
        }
    }
    out.push(b'"')
    return (out as string | none) ?? "?"
}

const KIND_TAGS = ["op"->"" "identifier"->"id" "boolean"->"bool" "quoted"->"str" "rawquoted"->"raw"
    "based_string"->"based" "metatag"->"meta" "source_integer"->"int" "integer"->"radix"
    "source_real"->"real" "eof"->"eof"]

# `tag:text`, prefixed `_` after whitespace and `^` after a line break.
token_line = (source:array<uint8> tokens:array<Token>):>string => {
    let parts:array<string> = []
    loop t in tokens {
        if t.kind =? 'eof' break
        let mark = if t.newline "^" else if t.space "_" else ""
        let tag = KIND_TAGS[t.kind]
        let word = text_of(source t.start t.stop)
        let keyword = t.kind =? 'identifier' and t.symbol isnt? none
        let label = if tag.length =? 0 word else if keyword "kw:{word}" else "{tag}:{word}"
        parts.push("{mark}{label}")
    }
    return parts.join(" ")
}

sexpr = (nodes:array<Node> id:int64):>string => {
    if id =? 0 return "_"
    $runtime_assert 0 <? id and id <? nodes.length
    let n = nodes[id]
    let kids = [loop k in n.kids sexpr(nodes k)]
    if n.kind in? ["identifier" "source_integer" "integer" "source_real" "boolean" "metatag" "based_string"] return n.text
    if n.kind =? "string" or n.kind =? "chunk" return quoted(n.text)
    let head = match n.kind {
        <"interp"> => "interp"
        <"flow"> => "flow"
        <"partial"> => "partial"
        _ => n.op
    }
    if kids.length =? 0 return "({head})"
    return "({head} {kids.join(" ")})"
}

tree_lines = (parsed:Parsed):>array<string> => [loop root in parsed.roots sexpr(parsed.nodes root)]

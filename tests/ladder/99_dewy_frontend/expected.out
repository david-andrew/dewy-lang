  tokens radix:0xFF _+ _radix:0b1010 _+ _radix:0o17 _+ _int:0d99 _+ _int:1_000_000 _+ _based:0x"ff00" _+ _real:6.02e23 _+ _real:1e-3
  tree (+ (+ (+ (+ (+ (+ (+ 0xFF 0b1010) 0o17) 0d99) 1_000_000) 0x"ff00") 6.02e23) 1e-3)
### paths and calls with string arguments
  tokens id:p str:"assets/{name}.png" _+ _id:printl str:"done"
  tree (+ (call p (interp "assets/" name ".png")) (call printl "done"))
### comments are whitespace
  tokens id:a _+ _id:b
  tree (+ a b)
### a multi-line comment separates like a line break
  tokens id:a ^id:b
  tree a
  tree b
### identifiers with Unicode
  tokens id:café _+ _id:π * id:r ^ int:2 _+ _id:x₁
  tree (+ (+ café (* π (^ r 2))) x₁)
### dot operators
  tokens id:a _.+ _id:b _.* _id:c _.=? _id:d
  tree (.=? (.+ a (.* b c)) d)
### references
  tokens id:bump ( @ id:point . id:x ) _+ _@ id:items [ id:i ] . id:count

# Tier 6 / 120 / milestone 54
# Acceptance: Book a small transfer ledger under explicit allocation failure;
# acquire an arena, perform scoped allocations, and surface OutOfMemory as value.
$explicit_allocation_failure

Entry:type = [account:string delta:int]
Result:type = [accepted:int rejected:int total:int]

new_result = ():>Result => Result[0 0 0]

validate = (entry:Entry):>bool => entry.account.length >? 0 and
    entry.delta >=? -50 and entry.delta <=? 50

apply = (@balances:dict<string int> @result:Result entry:Entry):>void | OutOfMemory => {
    if not (validate(entry) or_throw) {
        result.rejected += 1
        return
    }
    balances[entry.account] = (balances.get(entry.account) ?? 0) + entry.delta
    result.accepted += 1
    result.total += entry.delta
}

book = (entries:array<Entry>):>Result | OutOfMemory => {
    let arena = arena(65536) or_throw
    let scratch_count = $allocator(@arena) {
        let scratch = [loop e in entries e.delta]
        scratch.length
    }
    let balances:dict<string int> = []
    let result = Result[0 0 0]
    loop e in entries apply(@balances @result e) or_throw
    printl"balances:"
    loop name in balances.keys.sorted() printl"  {name}: {balances.get(name) ?? 0}"
    result
}


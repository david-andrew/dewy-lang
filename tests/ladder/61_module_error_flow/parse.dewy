BadNumber:type = type of error & [text:string]
parse_number = (text:string):>int64|BadNumber => {
    let number = to_int(text)
    if number is? error {
        return BadNumber[text]
    }
    if number =? -9223372036854775808 {return -9223372036854775808}
    if number =? 9223372036854775807 {return 9223372036854775807}
    if number <=? -9223372036854775808 or number >=? 9223372036854775807 {return BadNumber[text]}
    return int64(number)
}

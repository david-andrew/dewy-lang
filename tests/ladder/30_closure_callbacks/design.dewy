make_counter=(initial:int64)=>{
    let count=initial
    return (step:int64 $capture count)=>{count+=step return count}
}
apply=(items:array<int64> callback:<(value:int64):>int64>):>array<int64>=>{
    let result:array<int64>=[]
    loop item in items {
        result.push(callback(item))
    }
    return result
}
main=():>void=>{
    let counter=make_counter(10)
    let copy=@counter
    $runtime_assert (counter(2) =? 12)
    $runtime_assert (counter(3) =? 15)
    $runtime_assert (copy(1) =? 11)
    let total=0
    let shared=(step:int64 $capture @total)=>{total+=step return total}
    let other=@shared
    $runtime_assert (shared(2) =? 2)
    $runtime_assert (other(3) =? 5)
    $runtime_assert (total =? 5)
    let values=apply([1 2 3] (n)=>n*2)
    $runtime_assert (values =? [2 4 6])
    let private=make_counter(0)
    let cumulative=apply([1 2 3] @private)
    $runtime_assert (cumulative =? [1 3 6])
    $runtime_assert (private(1) =? 1)
    printl("{values} {cumulative} {total}")
}

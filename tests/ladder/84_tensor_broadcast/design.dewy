# Tier 3 / 84_tensor_broadcast / milestone 26
# Acceptance: Contiguous rank-2 arrays, row/column broadcast, transpose, snapshot rows, and reject mismatched shapes.
# OPEN: General multidimensional literals/types, axis broadcasting and view layout are provisional; flat Matrix is an algorithm projection, not the tensor feature.
# This executable projection does not establish the OPEN obligation.
Matrix:type=[rows:int64 cols:int64 cells:array<int64>]
make=(rows:int64 cols:int64):>Matrix=>{
    let cells:array<int64>=[]
    loop r in [0..rows) {
        loop c in [0..cols) {
            cells.push(r*10+c)
        }
    }
    return Matrix[rows cols cells]
}
broadcast=(matrix:Matrix row:array<int64> column:array<int64>):>Matrix=>{
    $runtime_assert row.length =? matrix.cols
    $runtime_assert column.length =? matrix.rows
    loop r in [0..matrix.rows) {
        loop c in [0..matrix.cols) {
            let i=r*matrix.cols+c
            matrix.cells[i]+=row[c]+column[r]
        }
    }
    return matrix
}
transpose=(matrix:Matrix):>Matrix=>{
    let cells:array<int64>=[]
    loop c in [0..matrix.cols) {
        loop r in [0..matrix.rows) {
            cells.push(matrix.cells[r*matrix.cols+c])
        }
    }
    return Matrix[matrix.cols matrix.rows cells]
}
main=():>int64=>{
    let a=make(3 4)
    let b=broadcast(a [1 2 3 4] [100 200 300])
    let t=transpose(b)
    let restored=transpose(t)
    $runtime_assert restored.cells =? b.cells
    $runtime_assert a.cells[0] =? 0
    $runtime_assert b.cells[0] =? 101
    $runtime_assert b.cells[11] =? 327
    $runtime_assert t.rows =? 4
    $runtime_assert t.cols =? 3
    $runtime_assert t.cells[1] =? 211
    $runtime_assert make(0 4).cells.length =? 0
    $runtime_assert make(3 0).cells.length =? 0
    let total:int64=0
    loop value in b.cells {
        total+=value
    }
    $runtime_assert transpose(make(0 4)).rows =? 4
    $runtime_assert transpose(make(0 4)).cols =? 0
    $runtime_assert transpose(make(3 0)).rows =? 0
    $runtime_assert transpose(make(3 0)).cols =? 3
    $runtime_assert broadcast(make(1 1) [2] [3]).cells[0] =? 5
    $runtime_assert transpose(make(1 1)).cells[0] =? 0
    $runtime_assert a.cells.length =? 12
    printl("{total} {t.cells[11]}")
    return 0
}

# Tier 6 / 131 / milestone 49
# Acceptance: Sort and search C-layout records with libc qsort and bsearch, calling
# back into exported Dewy comparators, and check the order against Dewy.
Item:type = [sku:uint32 qty:int16 bin:uint8 price_cents:int64]

qsort = (base:ptr<Item> count:uint64 size:uint64 compare:((a:ptr<Item> b:ptr<Item>):>int32)):>void => $extern
bsearch = (key:ptr<Item> base:ptr<Item> count:uint64 size:uint64 compare:((a:ptr<Item> b:ptr<Item>):>int32)):>ptr<Item>? => $extern

$export
by_sku = (a:ptr<Item> b:ptr<Item>):>int32 => $unsafe {
    if a[0].sku <? b[0].sku -1 else if a[0].sku >? b[0].sku 1 else 0
}

$export
by_value_desc = (a:ptr<Item> b:ptr<Item>):>int32 => $unsafe {
    let va = int64(a[0].qty) * a[0].price_cents
    let vb = int64(b[0].qty) * b[0].price_cents
    if va >? vb -1 else if va <? vb 1 else by_sku(a b)
}

lookup_sku = (items:array<Item> sku:uint32):>Item | none => $unsafe {
    let key:array<Item> = [Item[sku 0 0 0]]
    let sorted = items
    let found = bsearch(key.ptr sorted.ptr uint64(sorted.length) 16 @by_sku)
    if found is? none return none
    let at:ptr<Item> = found
    at[0]
}

main = ():>void => {
    let items:array<Item> = []
    let seed:uint32<overflow='wrap'> = 12345
    loop i in [0..40) {
        seed = seed * 1103515245 + 12345
        let sku = (seed >> 8) % 100000
        let qty = int16((seed >> 4) % 500) - 100
        let bin = uint8(seed % 7)
        let price = int64(seed % 9973) + 99
        items.push(Item[sku qty bin price])
    }
    $unsafe qsort(items.ptr uint64(items.length) 16 @by_sku)
    let sorted = true
    loop i in [1..items.length) {
        if items[i - 1].sku >? items[i].sku sorted = false
    }
    printl"sorted by sku: {sorted} first={items[0].sku} last={items[items.length - 1].sku}"
    let probe = items[17].sku
    let hit = lookup_sku(items probe)
    if hit isnt? none {
        let h:Item = hit
        printl"found {h.sku} qty={h.qty} bin={h.bin} price={h.price_cents}"
    }
    printl"missing: {lookup_sku(items 100001) is? none}"
    $unsafe qsort(items.ptr uint64(items.length) 16 @by_value_desc)
    loop i in [0..5) {
        let it = items[i]
        printl"{it.sku} {it.qty}x{it.price_cents} = {int64(it.qty) * it.price_cents}"
    }
    let negative = 0
    loop it in items if it.qty <? 0 negative += 1
    printl"negative stock lines: {negative}"
}

# Tier 6 / 140 / milestone 1
# Acceptance: A `wc`-plus-frequency command-line tool. Options follow the
# decided argparse convention (`name=value`, `--flag`, `-f`, `--` ends
# options), read by the argparse library into a typed record. Each
# named file is read as text: a missing one is reported on standard error and
# skipped, and the run goes on. It prints per-file line, word and byte counts,
# the longest line, the most frequent words (ties alphabetical), writes the
# same table as tab-separated text to `out=`, and reads it back to check it.

import argparse

Options:type = [
    files = argparse.Positional<array<string>>(help="the files to count")
    top = argparse.Named<int64<n => 1 <=? n and n <=? 1000>>(default=5 help="how many words to list")
    min_length = argparse.Named<int64<n => 1 <=? n and n <=? 80>>(default=1 help="the shortest word counted")
    ignore_case = argparse.Flag(help="count words in any case together")
    exclude = argparse.Named<string>(default="" help="words left out, comma-separated")
    out = argparse.Named<string?>(help="also write the table here, tab-separated")
]

FileStats:type = [name:string lines:int64 words:int64 bytes:int64 longest:int64 longest_at:int64]

# Letters, digits, apostrophes and hyphens make up a word; anything else splits.
word_char = (ch:string):>bool => ch.is_alnum or ch =? "'" or ch =? "-"

words_of = (line:string):>array<string> => {
    let found:array<string> = []
    let current = ""
    loop ch in line {
        if word_char(ch) { current = "{current}{ch}" }
        else if not current.is_empty { found.push(current); current = "" }
    }
    if not current.is_empty found.push(current)
    # A word is never only punctuation: "--ignore-case" counts as "ignore-case".
    [loop w in found {
        let clean = w.trim("'-")
        if not clean.is_empty clean
    }]
}

tally_file = (path:Path ignore_case:bool min_length:int64 exclude:set<string> @counts:dict<string int64>) => {
    let text = path.read_text or_throw
    let stats = FileStats[path.name 0 0 (text as array<uint8>).length 0 0]
    loop number in 1.. and raw in text.lines {
        let line = raw.remove_suffix("\r")
        stats.lines += 1
        if line.length >? stats.longest {
            stats.longest = line.length
            stats.longest_at = number
        }
        loop word in words_of(line) {
            stats.words += 1
            let key = if ignore_case word.lower else word
            if key.length <? min_length or key.lower in? exclude continue
            counts[key] = (counts.get(key) ?? 0) + 1
        }
    }
    stats
}

row = (name:string lines:string words:string bytes:string longest:string):>string => {
    "{fmt'<14'(name)}{fmt'>6'(lines)}{fmt'>7'(words)}{fmt'>7'(bytes)}{fmt'>12'(longest)}"
}

# Most frequent first; equal counts in alphabetical order.
Ranked:type = [word:string count:int64]
ranking = (counts:dict<string int64> top:int64):>array<Ranked> => {
    let all = [loop [word count] in counts Ranked[word count]]
    all.sorted(key=(r:Ranked) => r.word).sorted(key=(r:Ranked) => r.count reverse=true)[$clamp ..top)
}

report = (all:array<FileStats> ranked:array<Ranked>):>string => {
    let lines = ["file\tlines\twords\tbytes\tlongest"]
    loop s in all lines.push("{s.name}\t{s.lines}\t{s.words}\t{s.bytes}\t{s.longest}@{s.longest_at}")
    loop r in ranked lines.push("word\t{r.word}\t{r.count}")
    "{lines.join("\n")}\n"
}

main = (argv:array<string>) => {
    let options = argparse.parse(Options argv about="count lines, words and bytes, and the most frequent words")
    if options.files.is_empty {
        printl("tally: no files given" file=stderr)
        exit(2)
    }
    let exclude:set<string> = set[]
    loop w in options.exclude.split(",") if not w.is_empty exclude.push(w.lower)
    let counts:dict<string int64> = []
    let all:array<FileStats> = []
    let skipped:array<string> = []
    loop name in options.files {
        match tally_file(p(name) options.ignore_case options.min_length exclude @counts) {
            stats:FileStats => all.push(stats)
            <FileNotFound> => {
                printl("tally: {name}: no such file" file=stderr)
                skipped.push(p(name).name)
            }
            failure:exception => return failure
        }
    }

    printl(row("file" "lines" "words" "bytes" "longest"))
    let total = FileStats["total" 0 0 0 0 0]
    loop s in all {
        printl(row(s.name "{s.lines}" "{s.words}" "{s.bytes}" "{s.longest} @{s.longest_at}"))
        total.lines += s.lines
        total.words += s.words
        total.bytes += s.bytes
    }
    printl(row("total" "{total.lines}" "{total.words}" "{total.bytes}" "-"))
    if not skipped.is_empty printl"skipped: {skipped.join(", ")}"

    let case = if options.ignore_case "any case" else "exact case"
    printl"top {options.top} of {counts.length} words ({case}, at least {options.min_length} long):"
    let ranked = ranking(counts options.top)
    loop r in ranked printl"  {fmt'>3'(r.count)}  {r.word}"

    if options.out is? string {
        let target = p(options.out)
        let text = report(all ranked)
        let written = target.write_text(text) or_throw
        let back = target.read_text or_throw
        let same = if back =? text "matches" else "DIFFERS"
        printl"wrote {text.lines.length} rows ({written} bytes) to {target.name}; reread {same}"
    }
}

Edge:type=[src:int64 dst:int64 cost:int64]
shortest=(n:int64 edges:array<Edge> source:int64):>array<int64>=>{
    let dist=fill(1000000 n)
    let done=fill(false n)
    dist[source]=0
    loop step in [0..n) {
        let u=-1
        loop i in [0..n) {
            if not done[i] and (u <? 0 or dist[i] <? dist[u]) {u=i}
        }
        if u <? 0 {break}
        done[u]=true
        loop edge in edges {
            if edge.src not=? u {continue}
            let next=dist[u]+edge.cost
            if next <? dist[edge.dst] {dist[edge.dst]=next}
        }
    }
    return dist
}
main=():>int64=>{
    let edges=[Edge[0 1 4] Edge[0 2 1] Edge[2 1 2] Edge[1 3 1] Edge[2 3 8]]
    let distance=shortest(5 edges 0)
    assert(distance =? [0 3 1 4 1000000])
    let reverse=shortest(5 edges 3)
    assert(reverse[0] =? 1000000)
    assert(reverse[3] =? 0)
    let snapshot=distance
    distance[0]=9
    assert(snapshot[0] =? 0)
    printl(snapshot)
    return 0
}

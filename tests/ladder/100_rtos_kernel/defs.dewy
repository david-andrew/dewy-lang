# Kernel objects: fixed task control blocks, mutexes, mailboxes, the timer
# wheel, the block pool, the bump arena, interrupt vectors and the trace ring.
#
# Every object is inline, fixed-capacity storage: a kernel has no heap. The
# whole kernel is one plain record, so a hosted simulation and a bare-metal
# image would hold the same bytes (the bare-metal image waits on question 24).

$no_hidden_costs

const NTASK:int64 = 8       # task control blocks
const NCODE:int64 = 160     # program words shared by all tasks
const NMUTEX:int64 = 4
const NBOX:int64 = 4        # mailboxes
const BOXCAP:int64 = 4      # messages per mailbox
const WHEEL:int64 = 8       # timer wheel slots
const NBLOCK:int64 = 8      # fixed-size blocks in the pool
const HOLD:int64 = 4        # blocks one task may hold
const ARENA:int64 = 64      # bump arena words
const NIRQ:int64 = 4        # interrupt lines
const LOGCAP:int64 = 64     # trace events between drains
const QUANTUM:int64 = 3     # ticks before an equal-priority task yields its turn
const NONE:int64 = -1       # no task, mutex owner or timer

State:type = 'free'|'ready'|'sleeping'|'lock'|'send'|'recv'|'wait'|'done'

OpKind:type = 'work'|'sleep'|'lock'|'unlock'|'send'|'recv'|'alloc'|'free'|'bump'|'reset'|'yield'|'mask'|'unmask'|'wait'|'repeat'|'exit'

# One program word: an operation and up to two operands. `send` with
# `use_reg` forwards the value the task last received.
Op:type = [kind:OpKind a:int64 b:int64 use_reg:bool]

Tcb:type = [
    state:State
    base:int64          # assigned priority
    eff:int64           # effective priority, raised by inheritance
    entry:int64         # first program word
    size:int64          # program words
    pc:int64            # current word, relative to entry
    left:int64          # ticks still owed to a `work`
    loops:int64         # iterations taken by the current `repeat`
    slice:int64         # consecutive ticks in the current turn
    ready_seq:int64     # FIFO order among equal priorities
    wait_on:int64       # mutex or mailbox a blocked task waits for
    wait_seq:int64      # FIFO order among equal-priority waiters
    reg:int64           # last received message
    outgoing:int64      # message a blocked sender holds
    signaled:bool       # an interrupt signaled before the task waited
    deadline:int64      # wake-up tick while sleeping
    timer_next:int64    # next task in the same wheel slot
    held:array<int64 length=4>  # pool blocks, a stack
    nheld:int64
    ran:int64           # ticks on the CPU
]

Mutex:type = [owner:int64]

Mailbox:type = [items:array<int64 length=4> head:int64 count:int64 peak:int64]

Wheel:type = [head:array<int64 length=8> tail:array<int64 length=8>]

# A free list threaded through the blocks themselves, LIFO.
Pool:type = [next:array<int64 length=8> free:int64 available:int64]

Arena:type = [top:int64 peak:int64]

Action:type = 'none'|'post'|'signal'
Vector:type = [action:Action target:int64 value:int64]

EvKind:type = 'wake'|'irq'|'isr_post'|'isr_deliver'|'overrun'|'isr_signal'|'isr_wake'|'switch'|'idle'|'sleep'|'lock'|'block_lock'|'prio'|'unlock'|'handoff'|'bad_unlock'|'send'|'deliver'|'block_send'|'recv'|'block_recv'|'unblock_send'|'alloc'|'alloc_fail'|'free'|'free_none'|'bump'|'arena_full'|'reset'|'yield'|'mask'|'unmask'|'wait'|'block_wait'|'exit'|'reclaim'|'fault'

Event:type = [tick:int64 kind:EvKind a:int64 b:int64 c:int64]

Log:type = [items:array<Event length=64> head:int64 count:int64 dropped:int64]

Stats:type = [switches:int64 idle:int64 irqs:int64 overruns:int64 boosts:int64 faults:int64]

Kernel:type = [
    now:int64
    tasks:array<Tcb length=8>
    ntasks:int64
    code:array<Op length=160>
    ncode:int64
    mutexes:array<Mutex length=4>
    boxes:array<Mailbox length=4>
    wheel:Wheel
    pool:Pool
    arena:Arena
    vectors:array<Vector length=4>
    pending:array<bool length=4>
    masked:array<bool length=4>
    current:int64
    seq:int64
    log:Log
    stats:Stats
]

# Tier 6 / 119 / milestone 53
# Acceptance: Decode little-endian 64-bit words from a network frame with a
# proved read boundary, and apply the decided wrapping-byte conversion.
Byte:type = uint8<overflow='wrap'>

fold = (part:array<uint8>):>int => {
    let word:int = 0
    loop b in part word = word*256 + int(b)
    word
}

words = (payload:array<uint8>):>array<uint64> => {
    let out:array<uint64> = []
    let i = 0
    loop i + 8 <=? payload.length {
        let w = payload.read<uint64>(i)
        out.push(w)
        i += 8
    }
    out
}

xor_all = (values:array<uint64>):>uint64<overflow='wrap'> => {
    let state:uint64<overflow='wrap'> = 0
    loop x in values state = state xor x
    state
}

checksum8 = (payload:array<uint8>):>Byte => {
    let total:int = 0
    loop b in payload total += int(b)
    Byte(total)
}

header = (payload:array<uint8>):>string => {
    let prefix = [loop b in payload if b <? 32 b]
    "{prefix}"
}


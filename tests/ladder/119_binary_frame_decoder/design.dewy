    ]
    let decoded = words(raw)
    let first = decoded.get(0) ?? 0
    let last = decoded.get(decoded.length-1) ?? 0
    printl"bytes {raw.length}, words {decoded.length}, checksum8 {checksum8(raw)}"
    printl"first {first}; last {last}; xor {xor_all(decoded)}"
    printl"prefix {header(raw)}"
    printl"wrapped 300 to {Byte(300)}; wrapped -1 to {Byte(-1)}"
}

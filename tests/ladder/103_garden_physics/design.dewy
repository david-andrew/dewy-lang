# Tier 5 / 103_garden_physics / milestone 38
# Acceptance: Homework-style garden and kitchen physics with juxtaposed products (2x, a(x)^2, n(n+1)/2, (a+1)(a-1)) on exact quantities, and temperature points versus differences.
from units import m, cm, kg, g, N, J, K, °C, °F

const kJ = 1000J

# Bricks stacked in a triangle: n rows hold n(n+1)/2 bricks.
bricks_in = (n:int) => n(n+1)/2

# A gravel border w wide around a bed: (l+2w)(b+2w) minus the bed.
border_area = (l:(rational * Length) b:(rational * Length) w:(rational * Length)) =>
    (l+2w)(b+2w) - l*b

# A spring trellis stretched by x stores k(x)^2/2.
spring_energy = (k:(rational * Force / Length) x:(rational * Length)) => k(x)^2/2

# The sag of a path edge, modelled as y = 3x^2 - 2x + 1 (in cm).
sag = (x:rational) => 3x^2 - 2x + 1

Force:type = Mass * Length / Time^2

main = () => {
    printl"-- bricks --"
    let brick = 3kg
    let gravity = 10N/kg       # the textbook's round value
    loop rows in [3 5 8] {
        let count = bricks_in(rows)
        let weight = count*brick*gravity
        printl"{rows} rows: {count} bricks, {count*brick}, weighs {weight}"
    }
    $runtime_assert bricks_in(100) =? 5050

    printl"-- gravel border --"
    let bed_l = 3m
    let bed_b = 1.5m
    loop w in [10cm 25cm 40cm] {
        let area = border_area(bed_l bed_b w)
        let depth = 5cm
        printl"border {w}: {format(area/m^2 ".2f")} m^2, {area*depth/m^3*1000} litres of gravel"
    }
    # The same border by hand: 2w(l+b) + 4w^2.
    let w = 25cm
    $runtime_assert border_area(bed_l bed_b w) =? 2w(bed_l+bed_b) + 4w^2

    printl"-- paving around a square pond --"
    let tile = 50cm
    loop n in [2 3 5] {
        let ring = (n+2)^2 - n^2           # tiles in the ring around an n by n pond
        $runtime_assert ring =? 4(n+1)
        printl"{n}x{n} pond: {ring} tiles, {ring*tile*tile/m^2} m^2 of paving"
    }

    printl"-- wheelbarrow ramp --"
    let slope = 3/4
    let load = 40kg
    loop run in [2m 4m] {
        let height = slope(run)
        printl"run {run}: rise {height}, lifting {load} takes {load*gravity*height}"
    }

    printl"-- spring trellis --"
    let k = 400N/m
    loop x in [2cm 5cm 8cm] {
        let e = spring_energy(k x)
        printl"stretch {x}: {e}"
    }
    # Doubling the stretch stores four times the energy.
    $runtime_assert spring_energy(k 10cm) =? 4spring_energy(k 5cm)

    printl"-- path sag --"
    let a = 3
    let b = 2
    loop x in [0 1/3 1 2] {
        printl"x={x}: {sag(x)} cm"
    }
    # Difference of squares and the vertex of the parabola.
    $runtime_assert (a+b)(a-b) =? a^2 - b^2
    let vertex = b/(2a)
    printl"lowest point at x={vertex}, sag {sag(vertex)} cm"

    printl"-- kettle --"
    let water = 2kg
    let c = 4.2J/(g*K)
    let readings = [13 15 16 16]
    let tap = mean[loop r in readings r*°C]
    let boil = 100°C
    let rise = boil - tap
    let heat = water*c*rise
    printl"tap water {tap} ({tap as °F}), rise {rise} ({rise as °F})"
    printl"heat {heat/kJ} kJ"
    let served = boil - 5°C     # it cools a little on the way to the table
    printl"served at {served}, {served as °F}"

    printl"-- greenhouse thermostat --"
    let setpoint = 21°C
    let band = 2°C
    let low = setpoint - band
    let high = setpoint + band
    printl"heater on below {low}, vent above {high} ({band} or {band as °F} either side)"
    loop f in [64 68 71 73 75] {
        let t = f*°F
        let action = if t <? low "heat" else if t >? high "vent" else "hold"
        let side = if t <? setpoint "below" else "at or above"
        printl"{t} = {t as °C}: {action} ({side} the setpoint)"
    }
}

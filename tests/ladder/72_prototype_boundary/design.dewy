# Tier 3 / 72_prototype_boundary / milestone 22
# Acceptance: Prototype-deferred bounds become explicit runtime checks; checked code exports success facts.
# OPEN: GOALS permits ordinary runtime checks until forbidden, while archived no-traps requires proofs; exact $prototype scope and strict-profile interaction need reconciliation.
# This executable projection does not establish the OPEN obligation.
$prototype
read=(xs:array<int64> i:int64):>int64=>{
    return xs[i]
}
checked=(xs:array<int64> i:int64):>int64=>{
    $runtime_assert i >=? 0
    $runtime_assert i <? xs.length
    $assert i >=? 0
    $assert i <? xs.length
    return xs[i]
}
safe_sum=(xs:array<int64>):>int64=>{
    let total:int64=0
    loop i in [0..xs.length) {
        total+=checked(xs i)
    }
    return total
}
main=():>int64=>{
    let xs:array<int64>=[2 3 5 7 11 13]
    let saved=xs.copy()
    let total=safe_sum(xs)
    $runtime_assert read(xs 0) =? 2
    $runtime_assert read(xs 1) =? 3
    $runtime_assert read(xs 2) =? 5
    $runtime_assert read(xs 3) =? 7
    $runtime_assert read(xs 4) =? 11
    $runtime_assert read(xs 5) =? 13
    xs[0]=99
    $runtime_assert checked(saved 0) =? 2
    $runtime_assert checked(xs 0) =? 99
    $runtime_assert safe_sum([]) =? 0
    $runtime_assert safe_sum([7]) =? 7
    $runtime_assert safe_sum([1 2]) =? 3
    $runtime_assert safe_sum([1 2 3]) =? 6
    $runtime_assert total =? 41
    $runtime_assert saved.length =? 6
    $runtime_assert saved[0] =? 2
    $runtime_assert saved[1] =? 3
    $runtime_assert saved[2] =? 5
    $runtime_assert saved[3] =? 7
    $runtime_assert saved[4] =? 11
    $runtime_assert saved[5] =? 13
    $runtime_assert safe_sum(xs) =? 138
    $runtime_assert safe_sum(saved) =? 41
    $runtime_assert checked([0] 0) =? 0
    $runtime_assert checked([9 8] 1) =? 8
    $runtime_assert safe_sum([-3 3]) =? 0
    $runtime_assert safe_sum([-1 -2 -3]) =? -6
    $runtime_assert safe_sum([0 0]) =? 0
    $runtime_assert checked(saved 5) =? 13
    $runtime_assert read(saved 5) =? 13
    $runtime_assert read(saved 0) =? checked(saved 0)
    $runtime_assert safe_sum([100 -100 1]) =? 1
    $runtime_assert read([4] 0) =? 4
    printl("{total}")
    return 0
}

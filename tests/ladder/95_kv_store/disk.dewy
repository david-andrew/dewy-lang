$runtime_checks
# The store's only window onto the file system, with crash injection.
#
# Every durable step the store takes goes through a Disk. A test arms a Fault;
# when the store reaches the armed step the Disk performs only the part of the
# write a power cut would leave behind and reports Crashed. The store gives up
# at once (`or_throw`), exactly as a process killed at that instant would, and
# the driver reopens the store from whatever is on disk.
#
# A completed append is synced to the disk before the commit returns, and a whole
# file (a manifest slot, a compacted or truncated log) is replaced by `write_bytes`,
# which writes beside its name, syncs, then renames over it, so a crash leaves the
# old file or the new one, never a mixture. A crash can still cut an append short at
# any byte.

Crashed:type = type of error & [step:string]
DiskError:type = type of error & [message:string]

# Where the next crash happens. `append` lets only `thousandths`/1000 of the next
# append's bytes reach the disk (always less than all of it); the compaction
# steps crash just before that step starts.
FaultKind:type = 'append' | 'before_manifest' | 'before_cleanup'
Fault:type = [kind:FaultKind thousandths:int64<i => 0 <=? i <? 1000>=0]

Disk:type = [
    root:string
    fault:Fault?=none
    appends:int64=0
    writes:int64=0

    path = (name:string):>string => "{root}/{name}"

    # Crash here if the armed fault is this step.
    step = (kind:FaultKind):>void|Crashed => {
        let armed = fault
        if armed isnt? none and armed.kind =? kind and kind not=? 'append' {
            fault = none
            return Crashed["{kind}"]
        }
    }

    append = (name:string text:string):>void|Crashed|DiskError => {
        let armed = fault
        if armed isnt? none and armed.kind =? 'append' {
            fault = none
            # Only a prefix of the bytes reaches the disk.
            let data = bytes(text)
            let keep = data.length*armed.thousandths//1000
            $runtime_assert 0 <=? keep and keep <=? data.length
            let prefix = data[0..keep)
            let existing = read(name)
            if existing is? (error|Canceled) return DiskError["cannot reread {name}"]
            let written = p(path(name)).write_bytes([existing... prefix...])
            if written is? (error|Canceled) return DiskError["cannot write {name}"]
            return Crashed["append"]
        }
        let file = p(path(name))
        let written = file.append_bytes(bytes(text))
        if written is? (error|Canceled) return DiskError["cannot append to {name}"]
        let synced = file.sync
        if synced is? (error|Canceled) return DiskError["cannot sync {name}"]
        appends += 1
    }

    # Replace a whole file atomically: `write_bytes` puts the new bytes in a side
    # file, syncs it and renames it over the name; the directory's sync makes the
    # rename last.
    write = (name:string data:array<uint8>):>void|DiskError => {
        let written = p(path(name)).write_bytes(data)
        if written is? (error|Canceled) return DiskError["cannot write {name}"]
        let settled = p(root).sync
        if settled is? (error|Canceled) return DiskError["cannot sync {root}"]
        writes += 1
    }

    # The bytes of a file; a missing file reads as empty.
    read = (name:string):>array<uint8>|DiskError => {
        let file = p(path(name))
        if not file.exists return []
        let data = file.read_bytes
        if data is? (error|Canceled) return DiskError["cannot read {name}"]
        return data
    }

    exists = (name:string):>bool => p(path(name)).exists

    remove = (name:string):>void|DiskError => {
        let file = p(path(name))
        if not file.exists return
        let removed = file.unlink
        if removed is? (error|Canceled) return DiskError["cannot remove {name}"]
    }

    list = ():>array<string>|DiskError => {
        let names = p(root).list
        if names is? (error|Canceled) return DiskError["cannot list {root}"]
        names.sort()
        return names
    }
]

open_disk = (root:string):>Disk|DiskError => {
    let dir = p(root)
    if not dir.exists {
        let made = dir.mkdir
        if made is? (error|Canceled) return DiskError["cannot create {root}"]
    }
    return Disk[root]
}

# The write-ahead log: an append-only file of checksummed records.
#
# One record per line of bytes:
#
#     <crc32, 8 hex digits> <txn> <tag> <key length> <value length> <key><value>\n
#
# The tag is P (put), D (delete) or C (commit). Lengths count bytes, so keys and
# values may hold any UTF-8 text, spaces and newlines included. The checksum
# covers everything from <txn> through the value. A transaction is its change
# records followed by one commit record whose key is the number of changes; the
# whole transaction is written with a single append. Recovery keeps exactly the
# transactions whose commit record arrived intact and stops at the first damaged
# or incomplete record: everything after it is a torn write or corruption.

from p"crc32.dewy" import crc32, crc32_range

Op:type='put' | 'del'
Change:type=[op:Op key:string value:string=""]
Txn:type=[id:int64 changes:array<Change>]

hex8=(value:uint32):>string=>format(value "08x")

record=(txn:int64 tag:string key:string value:string):>string=>{
    let body="{txn} {tag} {bytes(key).length} {bytes(value).length} {key}{value}"
    return "{hex8(crc32(bytes(body)))} {body}\n"
}

# The bytes of one transaction: its changes, then the commit.
encode_txn=(txn:Txn):>string=>{
    let parts:array<string>=[]
    loop change in txn.changes {
        let tag=if change.op =? 'put' "P" else "D"
        parts.push(record(txn.id tag change.key change.value))
    }
    parts.push(record(txn.id "C" "{txn.changes.length}" ""))
    return parts.join("")
}

# ---------------------------------------------------------------- reading

LogRecord:type=[txn:int64 tag:uint8 key:string value:string next:int64<(>? 0)>]

Damage:type='torn' | 'checksum' | 'malformed'
Damaged:type=type of error & [kind:Damage]

# What a scan of the log found.
Scan:type=[
    txns:array<Txn>=[]
    records:int64=0
    discarded:int64=0
    valid:int64<(>=? 0)>=0
    damage:Damage | 'none'='none'
]

const MAX_DIGITS:int64=18

# A decimal field ending at `stop` (a space): its value and the position after it.
Field:type=[value:int64 next:int64<(>? 0)>]

field=(data:array<uint8> at:int64<(>=? 0)> stop:uint8):>Field|Damaged=>{
    let value:int64=0
    let i=at
    loop i <? data.length and data[i] not=? stop {
        let c=data[i]
        if c <? 48 or c >? 57 or i-at >=? MAX_DIGITS return Damaged['malformed']
        value=value*10+((c-48) as int64)
        i+=1
    }
    if i >=? data.length return Damaged['torn']
    if i =? at return Damaged['malformed']
    return Field[value i+1]
}

hex_digit=(c:uint8):>int64=>{
    if 48 <=? c <=? 57 return (c-48) as int64
    if 97 <=? c <=? 102 return (c-87) as int64
    return -1
}

# Decode the record starting at `at`.
read_record=(data:array<uint8> at:int64):>LogRecord|Damaged=>{
    if at <? 0 or at >? data.length-9 return Damaged['torn']
    let stored:uint32=0
    loop i in [at..at+8) {
        let d=hex_digit(data[i])
        if d <? 0 return Damaged['malformed']
        stored=(stored << 4) or (d as uint32)
    }
    if data[at+8] not=? 32 return Damaged['malformed']
    let body=at+9
    let txn=field(data body 32) or_throw
    if txn.next >? data.length-2 return Damaged['torn']
    let tag=data[txn.next]
    if data[txn.next+1] not=? 32 return Damaged['malformed']
    let key_length=field(data txn.next+2 32) or_throw
    let value_length=field(data key_length.next 32) or_throw
    let key_start=value_length.next
    let value_start=key_start+key_length.value
    let stop=value_start+value_length.value
    if stop >=? data.length return Damaged['torn']
    if value_start <? key_start or stop <? value_start return Damaged['malformed']
    if data[stop] not=? 10 return Damaged['malformed']
    if crc32_range(data body stop) not=? stored return Damaged['checksum']
    if tag not=? 80 and tag not=? 68 and tag not=? 67 return Damaged['malformed']
    let key=data[key_start..value_start) as string | none
    let value=data[value_start..stop) as string | none
    if key is? none or value is? none return Damaged['malformed']
    return LogRecord[txn.value tag key value stop+1]
}

# Replay a log image: the committed transactions, in order, and where the intact
# prefix ends.
scan=(data:array<uint8>):>Scan=>{
    let result=Scan()
    let pending:array<Change>=[]
    let pending_txn:int64=-1
    let at:int64=0
    loop at <? data.length {
        let next=read_record(data at)
        if next is? Damaged {
            result.damage=next.kind
            break
        }
        result.records+=1
        if next.txn not=? pending_txn {
            # A new transaction id while another is open: the open one never committed.
            result.discarded+=pending.length
            pending=[]
            pending_txn=next.txn
        }
        if next.tag =? 67 {
            if next.key =? "{pending.length}" {
                result.txns.push(Txn[next.txn pending])
                result.valid=next.next
            } else {
                result.discarded+=pending.length
            }
            pending=[]
            pending_txn=-1
        } else {
            let op:Op=if next.tag =? 80 'put' else 'del'
            pending.push(Change[op next.key next.value])
        }
        at=next.next
    }
    result.discarded+=pending.length
    return result
}

# Damage the final record of a log image in place, as failing media would:
# flip one bit in the middle of its body.
damage_last=(@data:array<uint8>):>bool=>{
    if data.length <? 2 return false
    let start=data.length-1
    loop start >? 0 and start <=? data.length and data[start-1] not=? 10 {
        start-=1
    }
    let middle=start+(data.length-start)//2
    $runtime_assert 0 <=? middle and middle <? data.length
    data[middle]=data[middle] xor 4
    return true
}

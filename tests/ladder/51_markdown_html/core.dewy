escape_html=(text:string):>string=> {
    let out=""
    loop ch in text  {
        if ch =? "&"  {
            out="{out}&amp;"
        }
        else if ch =? "<"  {
            out="{out}&lt;"
        }
        else if ch =? ">"  {
            out="{out}&gt;"
        }
        else  {
            out="{out}{ch}"
        }
    }
    return out
}
inline=(text:string):>string=> {
    let out=""
    let strong=false
    let code=false
    let i=0
    loop i <? text.length  {
        let ch=text[i]
        if ch =? "`"  {
            if code  {
                out="{out}</code>"
            }
            else  {
                out="{out}<code>"
            }
            code=not code
        }
        else if not code and ch =? "*" and i+1 <? text.length and text[i+1] =? "*"  {
            if strong  {
                out="{out}</strong>"
            }
            else  {
                out="{out}<strong>"
            }
            strong=not strong
            i+=1
        }
        else  {
            out="{out}{escape_html(ch)}"
        }
        i+=1
    }
    if code  {
        out="{out}</code>"
    }
    if strong  {
        out="{out}</strong>"
    }
    return out
}
render=(source:string):>string=> {
    let result=""
    let list=false
    let paragraph=""
    loop line in source.split("\n")  {
        if line.startswith("- ")  {
            if paragraph not=? ""  {
                result="{result}<p>{inline(paragraph)}</p>"
                paragraph=""
            }
            if not list  {
                result="{result}<ul>"
                list=true
            }
            result="{result}<li>{inline(line.remove_prefix("- "))}</li>"
        }
        else  {
            if list  {
                result="{result}</ul>"
                list=false
            }
            if line =? "" or line.startswith("# ")  {
                if paragraph not=? ""  {
                    result="{result}<p>{inline(paragraph)}</p>"
                    paragraph=""
                }
                if line.startswith("# ")  {
                    result="{result}<h1>{inline(line.remove_prefix("# "))}</h1>"
                }
            }
            else  {
                if paragraph not=? ""  {
                    paragraph="{paragraph} "
                }
                paragraph="{paragraph}{line}"
            }
        }
    }
    if list  {
        result="{result}</ul>"
    }
    if paragraph not=? ""  {
        result="{result}<p>{inline(paragraph)}</p>"
    }
    return result
}
main=():>void=> {
    let source="# Dewy & tools\n\nA **bold** line\nwith `<tag>`.\n\n- one\n- **two**\n\n<script>"
    let output=render(source)
    assert(not output.contains("<script>"))
    assert(render("") =? "")
    assert(render("- a\n- b") =? "<ul><li>a</li><li>b</li></ul>")
    assert(inline("`**x**`") =? "<code>**x**</code>")
    assert(inline("**x") =? "<strong>x</strong>")
    printl(output)
}

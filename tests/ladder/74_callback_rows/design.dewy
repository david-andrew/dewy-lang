# Tier 3 / 74_callback_rows / milestone 23
# Acceptance: Forward nonlocal callback rows while remapping explicit place permissions.
Action:type = <E:Effect>(<(x:int64):>int64 & E>)
map_one = <E:Effect>(f:Action<E> value:int64):>int64 & E => {
    return f(value)
}
forward = <E:Effect>(f:<(@x:int64):>void & mutates<x> & E> @y:int64):>void & mutates<y> & E => {
    f(@y)
}
square = (x:int64):>int64 & no_effects => x*x
negate = (x:int64):>int64 & no_effects => -x
set_seven = (@x:int64):>void & mutates<x> => {
    x = 7
}
quiet = (x:int64):>int64 & no_effects => {
    return map_one(@square x)+map_one(@negate x)
}
fold = <E:Effect>(xs:array<int64> f:Action<E>):>int64 & E => {
    let total:int64 = 0
    loop x in xs {
        total += f(x)
    }
    return total
}
main = ():>void => {
    let total:int64 = 0
    loop n in [0..32) {
        total += quiet(n)
    }
    let cell:int64 = 0
    forward(@set_seven @cell)
    $runtime_assert cell =? 7
    $runtime_assert quiet(0) =? 0
    $runtime_assert quiet(1) =? 0
    $runtime_assert quiet(2) =? 2
    $runtime_assert quiet(3) =? 6
    $runtime_assert quiet(-2) =? 6
    $runtime_assert fold([1 2 3] @square) =? 14
    $runtime_assert fold([1 2 3] @negate) =? -6
    $runtime_assert fold([] @square) =? 0
    $runtime_assert map_one(@square 9) =? 81
    $runtime_assert map_one(@negate 9) =? -9
    $runtime_assert map_one(@square -9) =? 81
    $runtime_assert map_one(@negate -9) =? 9
    $runtime_assert cell =? 7
    $runtime_assert total =? 9920
    $runtime_assert quiet(4) =? 12
    $runtime_assert quiet(-1) =? 2
    $runtime_assert quiet(-3) =? 12
    $runtime_assert fold([0] @square) =? 0
    $runtime_assert fold([-1 1] @negate) =? 0
    $runtime_assert fold([-2 2] @square) =? 8
    $runtime_assert map_one(@square 0) =? 0
    $runtime_assert map_one(@negate 0) =? 0
    $runtime_assert quiet(5) =? 20
    $runtime_assert quiet(-5) =? 30
    $runtime_assert fold([2 2 2] @square) =? 12
    $runtime_assert fold([2 2 2] @negate) =? -6
    $runtime_assert quiet(6) =? 30
    printl("{total} {cell}")
}

$runtime_checks

# Tier 6 / 122 / milestone 56
# Acceptance: A local-only telemetry accumulator can process its batch on the
# caller, but moving that type into a spawned task is rejected by $send=false.
Reading:type = [sequence:int value:int]
LocalAccumulator:type = [
    sum:int
    high:int
    last:int
    $send = false
]

new_accumulator = ():>LocalAccumulator => LocalAccumulator[0 0 0]

observe = (@acc:LocalAccumulator r:Reading):>void => {
    acc.sum += r.value
    if r.value >? acc.high acc.high = r.value
    acc.last = r.sequence
}

scan = (@acc:LocalAccumulator readings:array<Reading>):>void => {
    loop r in readings observe(@acc r)
}

remote_scan = (acc:LocalAccumulator readings:array<Reading>):>int => {
    let copy = acc
    scan(@copy readings)
    copy.sum
}

classify = (r:Reading):>string => {
    if r.value <? 20 return "low"
    if r.value <? 80 return "normal"
    "high"
}

local_report = (acc:LocalAccumulator readings:array<Reading>):>void => {
    let low = 0
    let normal = 0
    let high = 0
    loop r in readings {
        let kind = classify(r)
        if kind =? "low" low += 1
        else if kind =? "normal" normal += 1
        else high += 1
    }
    printl"local sum {acc.sum}, peak {acc.high}, last {acc.last}"
    printl"buckets {low}/{normal}/{high}"
}


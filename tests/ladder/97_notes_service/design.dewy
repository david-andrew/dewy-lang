# Tier 4 / 97_notes_service / milestone 33
# Acceptance: a notes web service and its UI. HTTP/1.1 framing over bytes with
# limits, chunked bodies and pipelining; JSON CRUD routes with validation,
# revisions, conditional requests, atomic batches and static files; a UI state
# machine that talks to the service through the same wire bytes. The same
# transcript runs natively and as wasm (tests/test_flagship_notes_web.py).
$runtime_checks
from p"session.dewy" import transcript

main = ():>void => {
    loop line in transcript() printl(line)
}

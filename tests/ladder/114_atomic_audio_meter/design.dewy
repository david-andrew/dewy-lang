        276
        347
        418
        489
    ]
    let peak = CachePadded[atomic(int64(0))]
    let frames = CachePadded[atomic(int64(0))]
    let ring = process(samples peak frames)
    printl"frames {frames.value.load'acquire'}; peak {peak.value.load'acquire'}"
    printl"ring checksum {checksum(ring)}"
    printl"last 8 left: {[loop i in [0..8) sample_at(ring i).left]}"
    printl"last 8 right: {[loop i in [0..8) sample_at(ring i).right]}"
    let gate = mutex(1)
    let held = @(gate.lock())
    held += 1
    printl"gate {gate_status(gate)}"
}

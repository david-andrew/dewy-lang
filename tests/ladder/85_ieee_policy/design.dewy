# Tier 3 / 85_ieee_policy / milestone 26
# Acceptance: IEEE signed zero, subnormal, overflow/underflow, NaN comparisons and deterministic reduction under an explicit policy.
# OPEN: Formats, literals/conversions, NaN/Inf/divide-by-zero behavior, promotion, FMA and reduction policy need decisions. Exact controls do not satisfy IEEE acceptance.
# This executable projection does not establish the OPEN obligation.
# No IEEE type spelling is selected in the sources. Exact scaled controls follow.
Sample:type=[value:int64 scale:int64]
add=(a:Sample b:Sample):>Sample=>{
    $runtime_assert a.scale =? b.scale
    return Sample[a.value+b.value a.scale]
}
reduce=(xs:array<int64>):>int64=>{
    let total:int64=0
    loop x in xs {
        total+=x
    }
    return total
}
ordered=(xs:array<int64>):>bool=>{
    loop i in [1..xs.length) {
        if xs[i-1] >? xs[i] return false
    }
    return true
}
main=():>void=>{
    let cancellation:array<int64>=[100000000 1 -100000000]
    let reverse:array<int64>=[-100000000 1 100000000]
    let exact=reduce(cancellation)
    $runtime_assert exact =? 1
    $runtime_assert reduce(reverse) =? exact
    $runtime_assert reduce([]) =? 0
    $runtime_assert reduce([0]) =? 0
    $runtime_assert reduce([1 -1]) =? 0
    $runtime_assert ordered([1 2 3])
    $runtime_assert not ordered([1 3 2])
    $runtime_assert ordered([])
    let a=Sample[125 100]
    let b=Sample[-25 100]
    let sum=add(a b)
    $runtime_assert sum.value =? 100
    $runtime_assert sum.scale =? 100
    $runtime_assert a.value =? 125
    $runtime_assert b.value =? -25
    let tiny=Sample[1 1000000]
    let zero=Sample[0 1000000]
    $runtime_assert add(tiny zero).value =? 1
    $runtime_assert add(tiny tiny).value =? 2
    $runtime_assert reduce([7 8 -15]) =? 0
    $runtime_assert reduce([7 8 -14]) =? 1
    $runtime_assert reduce([-7 -8 14]) =? -1
    $runtime_assert ordered([0 0 0])
    $runtime_assert not ordered([0 -1 0])
    $runtime_assert reduce([100000000 1 -100000000]) =? 1
    $runtime_assert reduce([-100000000 100000000 1]) =? 1
    $runtime_assert ordered([-2 -1 0])
    $runtime_assert not ordered([-1 -2 0])
    $runtime_assert add(Sample[1 10] Sample[2 10]).value =? 3
    $runtime_assert add(Sample[1 10] Sample[-1 10]).value =? 0
    $runtime_assert add(zero zero).value =? 0
    $runtime_assert add(tiny zero).scale =? 1000000
    printl("{exact} {sum.value} {tiny.value}")
}

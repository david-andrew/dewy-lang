predict=(x:float64 w:float64 b:float64):>float64=>w*x+b
train=(xs:array<float64> ys:array<float64> epochs:int64):>array<float64>=>{
    if ys.length <? xs.length return [0.0 0.0]
    let w:float64=0.0
    let b:float64=0.0
    let n=xs.length as float64
    loop epoch in [0..epochs) {
        let dw:float64=0.0
        let db:float64=0.0
        loop i in [0..xs.length) {
            let error=predict(xs[i] w b)-ys[i]
            dw+=2.0*error*xs[i]/n
            db+=2.0*error/n
        }
        w-=0.05*dw
        b-=0.05*db
    }
    return [w b]
}
main=():>int64=>{
    let xs:array<float64>=[-2.0 -1.0 0.0 1.0 2.0]
    let ys:array<float64>=[-3.0 -1.0 1.0 3.0 5.0]
    let weights=train(xs ys 1000)
    $runtime_assert (abs(weights[0]-2.0) <? 1e-8)
    $runtime_assert (abs(weights[1]-1.0) <? 1e-8)
    loop i in [0..xs.length) {
        $runtime_assert (abs(predict(xs[i] weights[0] weights[1])-ys[i]) <? 1e-8)
    }
    $runtime_assert (xs[0] =? -2.0)
    printl("{format(weights[0] ".4f")} {format(weights[1] ".4f")}")
    return 0
}

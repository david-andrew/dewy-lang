# Tier 6 / 121 / milestone 55
# Acceptance: A catalog quoting service carries a soft quantity precondition
# and uses members(Tier) as a value to enumerate its allowed service grades.
Tier:type = 'bronze' | 'silver' | 'gold'
Item:type = [sku:string quantity:int tier:Tier]
Quote:type = [units:int bronze:int silver:int gold:int total:int]

new_quote = ():>Quote => Quote[0 0 0 0 0]

$warn_if quantity >? 100 "check unusually large order"
line_price = (quantity:int tier:Tier):>int => {
    let cents = if tier =? 'bronze' 100
        else if tier =? 'silver' 150 else 225
    quantity*cents
}

add = (@q:Quote item:Item):>void => {
    q.units += item.quantity
    let cents = line_price(item.quantity item.tier)
    q.total += cents
    if item.tier =? 'bronze' q.bronze += cents
    else if item.tier =? 'silver' q.silver += cents
    else q.gold += cents
}

show_grades = ():>void => {
    let all:array<Tier> = members(Tier)
    printl"grades {all.length}: {all.get(0) ?? 'bronze'}, {all.get(1) ?? 'bronze'}, {all.get(2) ?? 'bronze'}"
}

show = (q:Quote):>void => {
    printl"units {q.units}; total cents {q.total}"
    printl"bronze {q.bronze}; silver {q.silver}; gold {q.gold}"
}


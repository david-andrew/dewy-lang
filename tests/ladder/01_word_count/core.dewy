Counts:type=[lines:int64 words:int64 graphemes:int64]
count_text=(text:string):>Counts=>{
    let lines=0
    let words=0
    let inside=false
    loop c in text {
        if c =? "\n" {lines+=1}
        let space=c =? " " or c =? "\n" or c =? "\t"
        if not space and not inside {words+=1}
        inside=not space
    }
    if text.length >? 0 and text[end] not=? "\n" {lines+=1}
    return Counts[lines words text.length]
}
show=(c:Counts):>string=>"{c.lines} {c.words} {c.graphemes}"
main=():>int64=>{
    let input="hello world\nhello café\n"
    let argv=args()
    if argv.length >? 1 {
        input=read_file(argv[1]) ?? ""
    }
    let result=count_text(input)
    assert(result.words >=? 0)
    assert(count_text("").words =? 0)
    assert(count_text("one").lines =? 1)
    assert(count_text("café").graphemes =? 4)
    assert(count_text("  x\t y ").words =? 2)
    assert(count_text("no newline").lines =? 1)
    printl(show(result))
    return 0
}

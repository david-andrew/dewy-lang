# Tier 3 / 83_transfer_properties / milestone 25
# Acceptance: Derive structural task-transfer properties; reject an Rc-like non-atomic handle crossing tasks.
# Sequential value oracle; design.dewy checks the rejected concurrent program.
Message:type = [sender:int64 sequence:int64 payload:array<int64>]
make = (sender:int64 n:int64):>Message => {
    let values:array<int64> = []
    loop i in [0..n) {
        values.push(sender*100+i)
    }
    return Message[sender n values]
}
receive = (message:Message):>int64 => {
    let checksum:int64 = 0
    loop i in [0..message.payload.length) {
        $runtime_assert message.payload[i] =? message.sender*100+i
        checksum += message.payload[i]
    }
    return checksum
}
replace = (@message:Message):>void => {
    $runtime_assert message.payload.length >? 0
    message.payload[0] = -1
    message.sender = -1
}
main = ():>void => {
    let total:int64 = 0
    loop sender in [1..9) {
        let message = make(sender 16)
        let saved = message.copy()
        total += receive(message)
        replace(@message)
        $runtime_assert saved.sender =? sender
        $runtime_assert saved.sequence =? 16
        $runtime_assert saved.payload.get(0) =? sender*100
        $runtime_assert message.payload.get(0) =? -1
        $runtime_assert message.sender =? -1
    }
    let empty = make(1 0)
    $runtime_assert receive(empty) =? 0
    let one = make(3 1)
    $runtime_assert receive(one) =? 300
    let nested:array<Message> = [make(1 2) make(2 2)]
    let snapshot = nested.copy()
    $runtime_assert nested[0].payload.length >? 0
    nested[0].payload[0] = 0
    $runtime_assert snapshot[0].payload.get(0) =? 100
    $runtime_assert snapshot[1].payload.get(0) =? 200
    $runtime_assert receive(snapshot[0]) =? 201
    $runtime_assert receive(snapshot[1]) =? 401
    $runtime_assert nested[0].payload.get(0) =? 0
    $runtime_assert snapshot.length =? 2
    $runtime_assert empty.payload.length =? 0
    $runtime_assert receive(make(0 0)) =? 0
    $runtime_assert receive(make(0 1)) =? 0
    $runtime_assert receive(make(0 2)) =? 1
    $runtime_assert receive(make(1 1)) =? 100
    $runtime_assert receive(make(1 3)) =? 303
    $runtime_assert receive(make(2 3)) =? 603
    $runtime_assert receive(make(9 1)) =? 900
    $runtime_assert receive(snapshot[0])+receive(snapshot[1]) =? 602
    let messages = [loop sender in [1..9) make(sender 16)]
    let checksums = [parallel message in messages receive(message)]
    $runtime_assert sum(checksums) =? total
    printl("{total}")
}

$runtime_checks

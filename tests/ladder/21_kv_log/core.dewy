Entry:type=[key:string value:string deleted:bool=false]
append=(path:string entry:Entry):>int64|error=>append_file(path to_json(entry)+"\n")
recover=(path:string):>dict<string string>=>{
    let state:dict<string string>=[]
    let loaded=read_text(path)
    let text=if loaded is? string loaded else ""
    loop line in text.split("\n") {
        if line.length =? 0 {continue}
        let record=from_json<Entry>(line)
        if record is? TextError {continue}
        if record.deleted {state.remove(record.key)}
        else {state[record.key]=record.value}
    }
    return state
}
main=():>int64=>{
    let path="kv.log"
    assert(write_text(path "") isnt? error)
    assert(append(path Entry["a" "one"]) isnt? error)
    assert(append(path Entry["b" "two"]) isnt? error)
    assert(append(path Entry["a" "three"]) isnt? error)
    assert(append(path Entry["b" "" true]) isnt? error)
    let first=recover(path)
    assert(first.length =? 1)
    assert(first["a"] =? "three")
    assert(append_file(path "partial-record") isnt? error)
    let second=recover(path)
    assert(second["a"] =? "three")
    assert(second.length =? first.length)
    let persisted=read_text(path)
    if persisted is? error {return 1}
    printl("{second.length} {second["a"]} {persisted.split("\n").length}")
    return 0
}

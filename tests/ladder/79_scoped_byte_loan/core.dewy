# Current-dialect algorithm projection; does not establish removed design contracts.
# Tier 3 / 79_scoped_byte_loan / milestone 24
# Acceptance: Read scoped bytes, reserve and commit writable bytes, preserve snapshots after detach.
byte_sum = (xs:array<uint8>):>int64 => {
    let total:int64 = 0
    loop x in xs {
        total += x as int64
    }
    return total
}
inspect = (seed:int64):>int64 => {
    let bytes:array<uint8> = [1 2 3 4 5 6 7 8]
    let saved = bytes.copy()
    let first = bytes[0] as int64
    bytes[0] = 9
    $runtime_assert saved[0] =? 1
    $runtime_assert bytes[0] =? 9
    $runtime_assert saved.length =? 8
    $runtime_assert bytes.length =? 8
    return first+seed+byte_sum(saved)
}
rewrite = ():>int64 => {
    let bytes:array<uint8> = [1 2 3 4]
    let saved = bytes.copy()
    bytes.push(9)
    bytes.push(10)
    $runtime_assert saved.length =? 4
    $runtime_assert bytes.length =? 6
    $runtime_assert bytes[4] =? 9
    $runtime_assert bytes[5] =? 10
    return byte_sum(bytes)+byte_sum(saved)
}
main = ():>void => {
    let total:int64 = 0
    loop n in [0..32) {
        total += inspect(n)
    }
    $runtime_assert inspect(0) =? 37
    $runtime_assert inspect(1) =? 38
    $runtime_assert inspect(-1) =? 36
    $runtime_assert rewrite() =? 39
    $runtime_assert byte_sum([]) =? 0
    $runtime_assert byte_sum([0]) =? 0
    $runtime_assert byte_sum([255]) =? 255
    $runtime_assert byte_sum([1 2 3]) =? 6
    $runtime_assert byte_sum([1 1 1 1]) =? 4
    $runtime_assert byte_sum([255 255]) =? 510
    $runtime_assert byte_sum([0 255]) =? 255
    $runtime_assert inspect(10) =? 47
    $runtime_assert inspect(-10) =? 27
    $runtime_assert inspect(100) =? 137
    $runtime_assert rewrite() =? 39
    $runtime_assert byte_sum([8 7 6 5 4 3 2 1]) =? 36
    printl("{total} {rewrite()}")
}

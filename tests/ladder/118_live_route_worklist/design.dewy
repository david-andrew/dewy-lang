        Edge[15 12 "walk"]
        Edge[16 19 "bus"]
        Edge[17 2 "rail"]
        Edge[18 9 "walk"]
        Edge[19 16 "bus"]
        Edge[20 23 "rail"]
        Edge[21 6 "walk"]
        Edge[22 13 "bus"]
        Edge[23 20 "rail"]
        Edge[0 3 "walk"]
        Edge[1 10 "bus"]
        Edge[2 17 "rail"]
        Edge[3 0 "walk"]
        Edge[4 7 "bus"]
        Edge[5 14 "rail"]
        Edge[6 21 "walk"]
        Edge[7 4 "bus"]
        Edge[8 11 "rail"]
        Edge[9 18 "walk"]
        Edge[10 1 "bus"]
        Edge[11 8 "rail"]
        Edge[12 15 "walk"]
        Edge[13 22 "bus"]
        Edge[14 5 "rail"]
        Edge[15 12 "walk"]
        Edge[16 19 "bus"]
        Edge[17 2 "rail"]
        Edge[18 9 "walk"]
        Edge[19 16 "bus"]
        Edge[20 23 "rail"]
        Edge[21 6 "walk"]
        Edge[22 13 "bus"]
        Edge[23 20 "rail"]
        Edge[0 3 "walk"]
        Edge[1 10 "bus"]
        Edge[2 17 "rail"]
        Edge[3 0 "walk"]
        Edge[4 7 "bus"]
        Edge[5 14 "rail"]
        Edge[6 21 "walk"]
        Edge[7 4 "bus"]
        Edge[8 11 "rail"]
        Edge[9 18 "walk"]
        Edge[10 1 "bus"]
        Edge[11 8 "rail"]
        Edge[12 15 "walk"]
    ]
    let visits = reachable(edges 0)
    let counts = mode_counts(edges)
    printl"edges {edges.length}; reached {visits.length}; depth {max_depth(visits)}"
    printl"walk {counts.get("walk") ?? 0}, bus {counts.get("bus") ?? 0}, rail {counts.get("rail") ?? 0}"
    printl"order {[loop v in visits v.node]}"
    show_tree()
}

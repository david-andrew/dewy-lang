        Edge[17 18 "rail"]
        Edge[18 19 "walk"]
        Edge[19 20 "bus"]
        Edge[20 21 "rail"]
        Edge[21 22 "walk"]
        Edge[22 23 "bus"]
        Edge[23 20 "rail"]
        Edge[0 3 "walk"]
        Edge[1 10 "bus"]
        Edge[2 17 "rail"]
        Edge[3 0 "walk"]
        Edge[4 7 "bus"]
        Edge[5 14 "rail"]
        Edge[6 21 "walk"]

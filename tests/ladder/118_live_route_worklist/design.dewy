# Tier 6 / 118 / milestone 52
# Acceptance: Live iteration grows a graph search worklist while a bound tree
# walker skips closed subtrees. The graph traversal uses distinct seen state.
from tree import Tree
Edge:type = [source:int target:int mode:string]
Visit:type = [node:int depth:int]

adjacent = (edges:array<Edge> source:int):>array<int> =>
    [loop edge in edges if edge.source =? source edge.target]

reachable = (edges:array<Edge> start:int):>array<Visit> => {
    let seen:dict<int bool> = []
    let work:array<Visit> = [Visit[start 0]]
    seen[start] = true
    let out:array<Visit> = []
    loop next in @work {
        out.push(next)
        loop target in adjacent(edges next.node) {
            if seen.get(target) ?? false continue
            seen[target] = true
            work.push(Visit[target next.depth+1])
        }
    }
    out
}

max_depth = (visits:array<Visit>):>int => {
    let result = 0
    loop v in visits if v.depth >? result result = v.depth
    result
}

mode_counts = (edges:array<Edge>):>dict<string int> => {
    let counts:dict<string int> = []
    loop e in edges counts[e.mode] = (counts.get(e.mode) ?? 0)+1
    counts
}

show_tree = ():>void => {
    let tree:Tree<string> = []
    let root = tree.add("metro")
    let open = tree.add("open" root)
    tree.add("museum" open);
    tree.add("station" open);
    let closed = tree.add("closed" root)
    tree.add("maintenance" closed);
    tree.add("depot" closed);
    let walk = tree.walk
    let visible:array<string> = []
    loop name in @walk {
        if name =? "closed" walk.skip_children
        visible.push(name)
    }
    printl"visible tree {visible}"
}

main = () => {
    let edges:array<Edge> = [
        Edge[0 1 "walk"]
        Edge[1 2 "bus"]
        Edge[2 3 "rail"]
        Edge[3 4 "walk"]

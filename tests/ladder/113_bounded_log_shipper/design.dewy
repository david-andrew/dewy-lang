    ]
    let wire = channel<Event>(4)
    let summary = make_summary()
    let by_service:dict<string int> = []
    concurrent {
        spawn produce(wire batch)
        loop true {
            match wire.receive() {
                e:Event => record(@summary e @by_service)
                <Closed> => break
                <Canceled> => break
            }
        }
    }
    print_summary(summary by_service)
}

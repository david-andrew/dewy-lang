# Tier 6 / 113 / milestone 47
# Acceptance: A bounded four-slot channel ships an ordered batch of service log events
# from a producer task to a consumer, closes after the batch, and summarizes classes.
Event:type = [seq:int level:string service:string bytes:int]
Summary:type = [seen:int accepted:int dropped:int bytes:int last:int]

make_summary = ():>Summary => Summary[0 0 0 0 0]

valid = (e:Event):>bool =>
    e.level in? ["info" "warn" "error"] and e.bytes >? 0 and e.service.length >? 0

record = (@s:Summary e:Event @by_service:dict<string int>):>void => {
    s.seen += 1
    if not valid(e) {
        s.dropped += 1
        return
    }
    s.accepted += 1
    s.bytes += e.bytes
    s.last = e.seq
    by_service[e.service] = (by_service.get(e.service) ?? 0) + 1
}

produce = (out:Channel<Event> batch:array<Event>):>void | Closed | Canceled => {
    loop e in batch out.send(e) or_throw
    out.close()
}

print_summary = (s:Summary by_service:dict<string int>):>void => {
    printl"received {s.seen}, accepted {s.accepted}, dropped {s.dropped}"
    printl"accepted bytes {s.bytes}; last accepted sequence {s.last}"
    loop name in by_service.keys.sorted() {
        printl"{name}: {by_service.get(name) ?? 0}"
    }
}

main = () => {
    let batch:array<Event> = [
        Event[1 "info" "api" 80]
        Event[2 "info" "billing" 117]
        Event[3 "warn" "search" 154]
        Event[4 "error" "billing" 191]

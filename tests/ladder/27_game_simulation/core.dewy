Ball:type=[x:float64 velocity:float64 hits:int64=0]
tick=(state:Ball dt:float64):>Ball=>{
    let next=state
    next.x+=next.velocity*dt
    if next.x >? 10.0 {
        next.x=20.0-next.x
        next.velocity=-next.velocity
        next.hits+=1
    }
    if next.x <? 0.0 {
        next.x=-next.x
        next.velocity=-next.velocity
        next.hits+=1
    }
    return next
}
simulate=(start:Ball frames:int64):>Ball=>{
    let state=start
    loop frame in [0..frames) {state=tick(state 0.125)}
    return state
}
main=():>int64=>{
    let initial=Ball[1.0 4.0]
    let end=simulate(initial 100)
    assert(end.x =? 9.0)
    assert(end.hits =? 5)
    assert(end.velocity =? -4.0)
    assert(simulate(initial 100) =? end)
    assert(simulate(initial 0) =? initial)
    printl("{end.x} {end.velocity} {end.hits}")
    return 0
}

fnv1a = (text:string):>uint64 => {
    let hash:uint64 = 14695981039346656037
    let prime:uint64 = 1099511628211
    loop byte in bytes(text) {
        hash = (hash xor (byte as uint64))*prime
    }
    return hash
}
combine = (texts:array<string>):>array<uint64> => {
    let hashes:array<uint64> = []
    loop text in texts {
        hashes.push(fnv1a(text))
    }
    return hashes
}
main = ():>void => {
    let words = ["" "a" "hello" "foobar"]
    let expected:array<uint64> = [14695981039346656037 12638187200555641996 11831194018420276491 9625390261332436968]
    let actual = combine(words)
    $runtime_assert(actual =? expected)
    $runtime_assert(fnv1a("hello") not=? fnv1a("Hello"))
    $runtime_assert(fnv1a("a") =? fnv1a("a"))
    let seen:dict<uint64 string> = []
    loop word in words {
        seen[fnv1a(word)] = word
    }
    $runtime_assert(seen.length =? 4)
    $runtime_assert(seen.get(fnv1a("hello")) =? "hello")
    printl(actual)
}

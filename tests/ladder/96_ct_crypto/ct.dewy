# Constant-time building blocks.
#
# The discipline for every kernel in this program: no branch, loop bound or array
# index depends on a secret (key, plaintext, MAC state, scalar). Secrets flow only
# through wrapping fixed-width arithmetic, `and`/`or`/`xor` and shifts by public
# amounts. Choices between secret values are made with all-ones/all-zero masks.
#
# The compiler does not yet check this discipline: Dewy has no spelling for a
# secret value or a "no secret-dependent control flow or addressing" contract.
# The scalar helpers below carry `no_effects`, which the compiler does verify:
# they are pure word arithmetic with no hidden allocation, check or call.

$explicit_copies

# All ones when `bit` is 1, zero when it is 0.
mask32=(bit:uint32):>uint32 & no_effects=>0-bit
mask64=(bit:uint64):>uint64 & no_effects=>0-bit

# `a` where the mask is all ones, `b` where it is zero.
select32=(m:uint32 a:uint32 b:uint32):>uint32 & no_effects=>(a and m) or (b and (not m))
select64=(m:uint64 a:uint64 b:uint64):>uint64 & no_effects=>(a and m) or (b and (not m))

# 1 when x is zero, else 0, without a branch: x-1 borrows into bit 63 only for zero.
is_zero64=(x:uint64):>uint64 & no_effects=>((not x) and (x-1)) >> 63
is_zero32=(x:uint32):>uint32 & no_effects=>((not x) and (x-1)) >> 31

# Compare two byte strings of public length in time independent of their contents.
# The lengths are public (a tag is always 16 bytes); only the final verdict leaves.
equal=(a:array<uint8> b:array<uint8>):>bool=>{
    if a.length not=? b.length return false
    let diff:uint32=0
    loop i in [0..a.length) {
        diff=diff or ((a[i] xor b[i]) as uint32)
    }
    return is_zero32(diff) =? 1
}

# Overwrite a secret buffer before it is released.
wipe=(@buffer:array<uint8>):>void=>{
    loop @b in buffer {
        b=0
    }
}

# Little-endian word loads and stores at public offsets.
load32=(b:array<uint8> at:int64):>uint32=>(b[at] as uint32) or ((b[at+1] as uint32) << 8) or ((b[at+2] as uint32) << 16) or ((b[at+3] as uint32) << 24)

store32=(@out:array<uint8> word:uint32):>void=>{
    out.push((word and 255) as uint8)
    out.push(((word >> 8) and 255) as uint8)
    out.push(((word >> 16) and 255) as uint8)
    out.push((word >> 24) as uint8)
}

store64=(@out:array<uint8> word:uint64):>void=>{
    loop i in [0..8) {
        out.push(((word >> (8*i)) and 255) as uint8)
    }
}

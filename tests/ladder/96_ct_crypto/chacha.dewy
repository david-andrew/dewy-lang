# ChaCha20 (RFC 8439 section 2.3-2.4).
#
# An add-rotate-xor cipher: no table lookups and no data-dependent branches, so
# key and plaintext never select a code path or an address. Loop bounds depend
# only on the message length, which is public.

from p"ct.dewy" import load32

Key:type=array<uint8 length=32>
Nonce:type=array<uint8 length=12>
State:type=array<uint32 length=16>

# "expand 32-byte k"
const SIGMA:array<uint32 length=4>=[0x61707865 0x3320646e 0x79622d32 0x6b206574]
const BLOCK:int64=64

rotl=(x:uint32 n:int64):>uint32 & no_effects=>(x << n) or (x >> (32-n))

quarter=(@s:State a:int64 b:int64 c:int64 d:int64):>void=>{
    s[a]+=s[b]
    s[d]=rotl(s[d] xor s[a] 16)
    s[c]+=s[d]
    s[b]=rotl(s[b] xor s[c] 12)
    s[a]+=s[b]
    s[d]=rotl(s[d] xor s[a] 8)
    s[c]+=s[d]
    s[b]=rotl(s[b] xor s[c] 7)
}

# The input state of block `counter`: constants, key, counter, nonce.
setup=(key:Key counter:uint32 nonce:Nonce):>State=>{
    let s:State=[]
    loop i in [0..4) {
        s[i]=SIGMA[i]
    }
    let k=key as array<uint8>
    loop i in [0..8) {
        s[4+i]=load32(k 4*i)
    }
    s[12]=counter
    let n=nonce as array<uint8>
    loop i in [0..3) {
        s[13+i]=load32(n 4*i)
    }
    return s
}

# Twenty rounds (ten column/diagonal double rounds), then the feed-forward.
permute=(input:State):>State=>{
    let s=input
    loop round in [0..10) {
        quarter(@s 0 4 8 12)
        quarter(@s 1 5 9 13)
        quarter(@s 2 6 10 14)
        quarter(@s 3 7 11 15)
        quarter(@s 0 5 10 15)
        quarter(@s 1 6 11 12)
        quarter(@s 2 7 8 13)
        quarter(@s 3 4 9 14)
    }
    loop i in [0..16) {
        s[i]+=input[i]
    }
    return s
}

# The 64 keystream bytes of one block, serialized little-endian.
block=(key:Key counter:uint32 nonce:Nonce):>array<uint8>=>{
    let words=permute(setup(key counter nonce))
    let out:array<uint8>=[]
    out.reserve(BLOCK)
    loop w in words {
        out.push((w and 255) as uint8)
        out.push(((w >> 8) and 255) as uint8)
        out.push(((w >> 16) and 255) as uint8)
        out.push((w >> 24) as uint8)
    }
    return out
}

# Encrypt or decrypt: XOR the data with the keystream starting at block `counter`.
xor_stream=(key:Key counter:uint32 nonce:Nonce data:array<uint8>):>array<uint8>=>{
    let out:array<uint8>=[]
    out.reserve(data.length)
    let state=setup(key counter nonce)
    let at=0
    loop at <? data.length {
        let words=permute(state)
        let take=min(BLOCK data.length-at)
        loop i in [0..take) {
            let word=words[i//4]
            let byte=((word >> (8*(i%4))) and 255) as uint8
            out.push(data[at+i] xor byte)
        }
        state[12]+=1
        at+=BLOCK
    }
    return out
}

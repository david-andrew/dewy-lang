# A secure channel: X25519 key agreement, HKDF-derived directional keys, and
# ChaCha20-Poly1305 records numbered by a 64-bit sequence that also forms the
# nonce. The receiver keeps a 64-record sliding window, so records may arrive
# out of order but never twice. The sequence number is public (it travels in
# the clear as associated data); only authenticated records move the window.
$runtime_checks

from p"ct.dewy" import store64
from p"sha2.dewy" import hkdf
from p"chacha.dewy" import Key, Nonce
from p"curve.dewy" import Bytes32, x25519, public_key
from p"aead.dewy" import Sealed, Forged, seal, open

Replayed:type = type of error
TooOld:type = type of error
HandshakeFailed:type = type of error

const WINDOW:uint64 = 64

Packet:type = [sequence:uint64 sealed:Sealed]

Channel:type = [
    send_key:Key
    receive_key:Key
    next_send:uint64=0
    # The highest sequence accepted so far, and which of the WINDOW sequences at
    # or below it have been seen (bit i is highest-i).
    highest:uint64=0
    seen:uint64<overflow='wrap'>=0
    accepted:int64=0

    send = (plaintext:array<uint8>):>Packet => {
        let sequence = next_send
        next_send += 1
        return Packet[sequence seal(send_key nonce_for(sequence) header(sequence) plaintext)]
    }

    receive = (packet:Packet):>array<uint8>|Forged|Replayed|TooOld => {
        let s = packet.sequence
        if accepted not=? 0 and s <=? highest {
            let age = highest-s
            if age >=? WINDOW return TooOld
            if ((seen >> age) and 1) =? 1 return Replayed
        }
        let opened = open(receive_key nonce_for(s) header(s) packet.sealed) or_throw
        # Authentic: record it in the window.
        if accepted =? 0 {
            highest = s
            seen = 1
        } else if s >? highest {
            let shift = s-highest
            seen = if shift >=? WINDOW 1 else (seen << shift) or 1
            highest = s
        } else {
            seen = seen or (uint64<overflow='wrap'>(1) << (highest-s))
        }
        accepted += 1
        return opened
    }
]

nonce_for = (sequence:uint64):>Nonce => {
    let n:array<uint8> = [0 0 0 0]
    store64(@n sequence)
    return n
}

header = (sequence:uint64):>array<uint8> => {
    let h:array<uint8> = []
    store64(@h sequence)
    return h
}

# Both sides derive the same pair of keys; the initiator sends with the first.
handshake = (secret:Bytes32 own_public:Bytes32 peer_public:Bytes32 initiator:bool):>Channel|HandshakeFailed => {
    let shared = x25519(secret peer_public)
    let first = if initiator own_public else peer_public
    let second = if initiator peer_public else own_public
    let info = [bytes("dewy channel v1")... (first as array<uint8>)... (second as array<uint8>)...]
    let keys = hkdf([] shared as array<uint8> info 64)
    if keys is? error return HandshakeFailed
    $runtime_assert keys.length =? 64
    let a:Key = keys[0..32)
    let b:Key = keys[32..64)
    return if initiator Channel[a b] else Channel[b a]
}

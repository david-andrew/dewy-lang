        "lima-103"
    ]
    let bucket = new_bucket()
    let ascii = 0
    loop name in names {
        if is_ascii(name) ascii += 1
        record(@bucket name)
    }
    printl"messages {names.length}; ascii {ascii}; length mismatches {bucket.mismatches}"
    printl"short {bucket.short}; medium {bucket.medium}; long {bucket.long}"
    printl"first {names.get(0) ?? ""}: {foreign_length(prepare(names.get(0) ?? ""))}"
    printl"last {names.get(names.length-1) ?? ""}: {foreign_length(prepare(names.get(names.length-1) ?? ""))}"
}

# Tier 6 / 115 / milestone 49
# Acceptance: Pass NUL-terminated byte buffers to libc strlen through ptr<uint8>,
# compare the foreign lengths with Dewy lengths, and classify a realistic batch.
# The array .ptr spelling is provisional: question 25(c).
strlen = (s:ptr<uint8>):>uint64 => $extern

CString:type = [storage:array<uint8> length:uint64]

prepare = (s:string):>CString => {
    let raw = bytes(s)
    raw.push(0)
    CString[raw uint64(s.length)]
}

foreign_length = (s:CString):>uint64 => $unsafe strlen(s.storage.ptr)

is_ascii = (s:string):>bool => {
    loop b in bytes(s) if b >? 128 return false
    true
}

Bucket:type = [short:int64 medium:int64 long:int64 mismatches:int64]
new_bucket = ():>Bucket => Bucket[0 0 0 0]

record = (@b:Bucket s:string):>void => {
    let data = prepare(s)
    let observed = foreign_length(data)
    if observed not=? data.length b.mismatches += 1
    if observed <? 8 b.short += 1
    else if observed <? 12 b.medium += 1
    else b.long += 1
}

main = () => {
    let names:array<string> = [
        "alpha-000"
        "foxtrot-001"
        "kilo-002"
        "delta-003"

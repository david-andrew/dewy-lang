# Tier 6 / 117 / milestone 51
# Acceptance: Parse line-oriented invoice CSV, unpack nested fields and a rest
# segment, swap columns in a reconciliation step, and calculate customer totals.
Order:type = [buyer:string item:string count:int cents:int]
Ledger:type = [rows:int rejected:int gross:int by_buyer:dict<string int>]
BuyerTotal:type = [name:string amount:int]

new_ledger = ():>Ledger => Ledger[0 0 0 []]

parse = (line:string):>Order | none => {
    let cells = line.split(",")
    if cells.length not=? 4 return none
    let [buyer item amount price] = cells
    let count = to_int(amount)
    let cents = to_int(price)
    if count is? error or cents is? error return none
    if buyer.length =? 0 or item.length =? 0 return none
    if count <=? 0 or cents <? 0 return none
    Order[buyer item count cents]
}

record = (@ledger:Ledger order:Order):>void => {
    let [buyer item count cents] = order
    let amount = count*cents
    ledger.rows += 1
    ledger.gross += amount
    ledger.by_buyer[buyer] = (ledger.by_buyer.get(buyer) ?? 0) + amount
}

receive = (@ledger:Ledger line:string):>void => {
    let order = parse(line)
    if order is? none { ledger.rejected += 1; return }
    record(@ledger order)
}

format_cents = (cents:int):>string => {
    let suffix = cents % 100
    let pad = if suffix <? 10 "0" else ""
    "${cents // 100}.{pad}{suffix}"
}

show_top = (ledger:Ledger):>void => {
    let pairs = [loop [name amount] in ledger.by_buyer BuyerTotal[name amount]]
    let ranked = pairs.sorted(key=(p:BuyerTotal) => -p.amount)
    loop pair in ranked {
        let [name amount] = pair
        printl"{name}: {format_cents(amount)}"
    }
}


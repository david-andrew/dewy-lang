    let ledger = new_ledger()
    loop line in lines receive(@ledger line)
    # Reconcile a four-column header with a nested first/last field and rest.
    let columns = ["buyer" "item" "quantity" "price" "source" "batch"]
    let [first second ...middle last] = columns
    let [[nested_a nested_b] nested_tail] = [["buyer" "item"] ["quantity" "price"]]
    [first second] = [second first]
    printl"columns {first}/{second}, extras {middle.length}, tail {last}"
    printl"nested {nested_a}/{nested_b}, tail {nested_tail.length}"
    printl"rows {ledger.rows}, rejected {ledger.rejected}, gross {format_cents(ledger.gross)}"
    show_top(ledger)
}

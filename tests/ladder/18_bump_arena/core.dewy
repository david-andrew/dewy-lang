Arena:type = [bytes:array<uint8 length=64> cursor:int64=0]
allocate = (@a:Arena size:int64 align:int64<(>? 0)>):>int64? => {
    let start = ((a.cursor+align-1)//align)*align
    if size <? 0 or start+size >? a.bytes.length { return none }
    a.cursor = start+size
    return start
}
write_word = (@a:Arena at:int64<0 <=? at and at+4 <=? 64> value:uint32):>void => {
    loop i in [0..4) {
        a.bytes[at+i] = ((value >> (8*i)) and 255) as uint8
    }
}
read_word = (a:Arena at:int64<0 <=? at and at+4 <=? 64>):>uint32 => {
    let result:uint32 = 0
    loop i in [0..4) {
        result = result or ((a.bytes[at+i] as uint32) << (8*i))
    }
    return result
}
main = ():>void => {
    let arena:Arena = [bytes=[]]
    let first = allocate(@arena 3 1) ?? -1
    let second = allocate(@arena 4 4) ?? -1
    $runtime_assert(first =? 0 and second =? 4)
    write_word(@arena second 305419896)
    $runtime_assert(read_word(arena second) =? 305419896)
    $runtime_assert(allocate(@arena 100 8) is? none)
    $runtime_assert(arena.cursor =? 8)
    let snapshot = arena
    write_word(@arena second 0)
    $runtime_assert(read_word(snapshot second) =? 305419896)
    printl("{first} {second} {read_word(snapshot second)}")
}

$runtime_checks

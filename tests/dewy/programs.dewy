let program_exit_status = (name:string expected:int64) => {
    let source = p"dewy/tests/{name}"
    let binary = p"__dewycache__/dewy/tests/{p(name).stem}"
    if not binary.exists { compile_program(source.path) }
    match run_silent(binary.path []) {
        status:int64 => $expect status =? expected, "{name} exited with {status}"
        <SpawnError> => $fail "could not run {binary.path}"
    }
}

# a program's output, captured
$test(cases=[
    [name="hello.dewy" expected="Hello, World!\n"]
    [name="hello_world_syscall.dewy" expected="Hello, World!\n"]
])
let program_output = (name:string expected:string) => {
    let binary = p"__dewycache__/dewy/tests/{p(name).stem}"
    if not binary.exists { compile_program(p"dewy/tests/{name}".path) }
    match capture(binary.path []) {
        result:Output => {
            $expect result.status =? 0, "{name} exited with {result.status}"
            match result.stdout_text {
                text:string => $expect text =? expected, "{name} printed {text}"
                <none> => $fail "{name} printed bytes that are not UTF-8"
            }
        }
        <SpawnError> => $fail "could not run {binary.path}"
    }
}

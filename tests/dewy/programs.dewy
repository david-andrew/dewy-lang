# The end-to-end fixture programs under `dewy/tests`, checked by exit status:
# each case builds the program with the host compiler (when its binary is
# missing — `dewy --compile` puts it under `__dewycache__/dewy/tests/`) and
# runs it. Whole-program behaviour is tested the same way as anything else:
# a test function that builds an executable, runs it, and checks the result.
# The list mirrors `CASES` in `tests/python_misc/test_cleanparse_udewy_e2e.py`
# (`test_dewy_test.py` keeps them in sync). Run from the repository root.

# the compiler's report is the failure message when a fixture does not build
let compile_program = (source:string):>void => {
    match capture("/usr/bin/env" ["python3" "-m" "dewy" "--compile" source]) {
        result:Output => {
            let report:string = ""
            match result.stderr_text { text:string => { report = text }  <none> => {} }
            $expect result.status =? 0, "compiling {source} failed ({result.status}):\n{report}"
        }
        <SpawnError> => $fail "could not start the compiler"
    }
}


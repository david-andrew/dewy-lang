$runtime_checks
from p"string_domains.jo" import (string_set_tests)
from p"optional_fill.dewy" import (opt_unwrap_alias)
from p"checks_thin_expr.dewy" import (opt_rest_expr)
from p"narrowing_checks.dewy" import (narrow_string_set opt_wild_narrow_path)
from p"checker_narrow_writes.dewy" import (narrow_store_register narrowed_var)
from p"checker_scope_symbols.dewy" import (new_local new_sym position_guard_note push_scope_sym)
from p"expression_types.dewy" import (ntype)
from p"type_ops.dewy" import (mk_opt mk_union union_index)
from p"checks_thin.dewy" import (narrow_invalidate)
from p"@lib/core/str.jo" import (starts_with)
from p"checked_expression_nodes.dewy" import (mk_ident_local)
from p"checker_expr.dewy" import (lookup)
from p"ast.jo" import (NF_CHECKED add_flag mk nodes)
from p"check.jo" import (LF_ALIAS LF_UNNARROWED check_scopes ctxs cx game_lookup_ok locals syms)
from p"expr.jo" import (CV opt_rest_aliases path_narrows path_rooted_g path_rooted_l)
from p"types.jo" import (is_union prune telem tkind type_eq types union_members)
from p"util.jo" import (intern name_of)

PathNarrowWord:type=int64<overflow='wrap'>
const PATH_NARROW_LOCAL:int32=1 # SK.local in the frozen node ABI.

# Optional operations keep their declared optional view even when an alias is
# known to hold a value. Ordinary nonoptional operands remain type errors.
narrow_optional_source=(a:int64):>int64=>{
    if nodes[a].kind not=? 'ident' or nodes[a].aux not=? PATH_NARROW_LOCAL {return a}
    let l=PathNarrowWord(nodes[a].sym)
    if PathNarrowWord(locals[l].flags) & LF_ALIAS =? 0 {return a}
    let al=PathNarrowWord(locals[l].alias)
    if al not=? 0 and nodes[al].kind =? 'unwrap' {return int64(nodes[al].a)}
    a
}

# a narrowed path's key as a scope name, its root marked
path_name=(key:string):>PathNarrowWord=>{
    let bytes=key as array<uint8>
    let i:PathNarrowWord=2
    let id:PathNarrowWord=0
    loop i <? bytes.length and bytes[i] >=? b'0' and bytes[i] <=? b'9' {
        id=id*10 + PathNarrowWord(bytes[i] - b'0')
        i += 1
    }
    if bytes[1] =? b'L' {
        if path_rooted_l.length <=? id {path_rooted_l.resize(id*2 + 64)}
        path_rooted_l[id]=true
    }
    else {
        if path_rooted_g.length <=? id {path_rooted_g.resize(id*2 + 64)}
        path_rooted_g[id]=true
    }
    intern(key)
}

narrow_path=(a:PathNarrowWord vi:PathNarrowWord holds:bool):>void=>{
    let key=path_key(a)
    if key =? "" {return}
    let ut=prune(ntype(a))
    let pos=nodes[a].pos
    let count = @path_narrows
    count=PathNarrowWord(count) + 1
    if is_union(ut) {
        let sel:array<int64>=[]
        loop i in 0.. and m in union_members(ut) {
            if (i =? vi) =? holds {sel.push(m)}
        }
        narrow_expr(copy_path(a) sel pos path_name(key))
    }
    else if types[ut].kind =? 'opt' and (vi =? -2) =? holds {
        let e=mk('unwrap' pos)
        nodes[e].a=int32(copy_path(a))
        nodes[e].type=types[ut].elem
        add_flag(e NF_CHECKED)
        let nl=new_local(path_name(key) PathNarrowWord(types[ut].elem) pos)
        locals[nl].flags=int32(LF_ALIAS)
        locals[nl].alias=int32(e)
    }
}

# x is A or x is B ... holding: x is one of those members (when all test the same x)
narrow_some=(tests:array<int64>):>void=>{
    let a0=PathNarrowWord(nodes[tests[0]].a)
    let ut=prune(ntype(a0))
    if not is_union(ut) {return}
    let local=nodes[a0].kind =? 'ident' and nodes[a0].aux =? PATH_NARROW_LOCAL
    let key=""
    if not local {
        key=path_key(a0)
        if key =? "" {return}
    }
    let sel:array<int64>=[]
    loop t in tests {
        let a=PathNarrowWord(nodes[t].a)
        if local {
            if nodes[a].kind not=? 'ident' or nodes[a].aux not=? PATH_NARROW_LOCAL {return}
            if narrow_root_local(PathNarrowWord(nodes[a].sym)) not=? narrow_root_local(PathNarrowWord(nodes[a0].sym)) {return}
        }
        else if path_key(a) not=? key {return}
        let at=prune(ntype(a))
        if not is_union(at) {return}
        let m=union_members(at)[PathNarrowWord(nodes[t].aux)]
        if not sel.contains(m) {sel.push(m)}
    }
    if local {narrow_local(PathNarrowWord(nodes[a0].sym) sel nodes[a0].pos)}
    else {
        let count = @path_narrows
        count=PathNarrowWord(count) + 1
        narrow_expr(copy_path(a0) sel nodes[a0].pos path_name(key))
    }
}

const PATH_NARROW_GLOBAL:int32=2 # SK.global in the frozen node ABI.

# a checked copy of a field path
copy_path=(n:PathNarrowWord):>PathNarrowWord=>$unsafe {
    let copy=nodes.length
    nodes.push(nodes[n])
    if nodes.ptr[n].kind =? 'field' {
        let child=copy_path(PathNarrowWord(nodes.ptr[n].a))
        nodes.ptr[copy].a=int32(child)
    }
    copy
}

# Declaration aliases preserve path identity. Narrowing aliases retain their
# own roots so forgetting a parent can also retire paths below its payload.
# O(alias/path depth), with no allocation for an unrelated local.
path_decl_alias=(l:PathNarrowWord):>PathNarrowWord=>$unsafe {
    if PathNarrowWord(locals.ptr[l].flags) & LF_ALIAS =? 0 {return 0}
    let alias=PathNarrowWord(locals.ptr[l].alias)
    if alias =? 0 {return 0}
    let root=alias
    loop nodes.ptr[root].kind =? 'field' and nodes.ptr[root].a not=? 0 {root=PathNarrowWord(nodes.ptr[root].a)}
    if nodes.ptr[root].kind =? 'ident' {return alias}
    0
}

# might the field path (or name) n have a narrowed scope entry: its root is marked
path_rooted=(n0:PathNarrowWord):>bool=>$unsafe {
    let n=n0
    loop nodes.ptr[n].kind =? 'field' and nodes.ptr[n].a not=? 0 {n=PathNarrowWord(nodes.ptr[n].a)}
    if nodes.ptr[n].kind not=? 'ident' {return false}
    let id=PathNarrowWord(nodes.ptr[n].sym)
    if nodes.ptr[n].aux =? PATH_NARROW_LOCAL {
        let a=path_decl_alias(id)
        if a not=? 0 {return path_rooted(a)}
        return id <? path_rooted_l.length and path_rooted_l.ptr[id]
    }
    if nodes.ptr[n].aux =? PATH_NARROW_GLOBAL {return id <? path_rooted_g.length and path_rooted_g.ptr[id]}
    false
}

# the alias local a field path (or global) is narrowed to here, or -1
path_alias=(n:PathNarrowWord):>PathNarrowWord=>$unsafe {
    if path_narrows =? 0 or not path_rooted(n) {return -1}
    let key=path_key(n)
    if key.length =? 0 {return -1}
    let gok=@game_lookup_ok
    let prev=gok
    gok=false
    let s=lookup(intern(key))
    gok=prev
    if s =? 0 or syms.ptr[s].kind not=? 'local' {return -1}
    let alias=PathNarrowWord(syms.ptr[s].ref)
    if locals.ptr[alias].owner not=? ctxs.ptr[cx].inst or PathNarrowWord(locals.ptr[alias].flags) & LF_UNNARROWED not=? 0 {return -1}
    alias
}

# the `x is M` tests (of members) an or-chain is made of; false: it has something else too
or_tests=(c:PathNarrowWord @out:array<int64>):>bool=>$unsafe {
    let k=nodes.ptr[c].kind
    if k =? 'or_' {return or_tests(PathNarrowWord(nodes.ptr[c].a) @out) and or_tests(PathNarrowWord(nodes.ptr[c].b) @out)}
    if k =? 'istype' and nodes.ptr[c].aux >=? 0 {
        out.push(int64(c))
        return true
    }
    false
}

# from here on, union variable l is known to hold one of members ms: its name stands for that
# member (one) or the smaller union of them (converted from the variable's value when used)
narrow_local=(l:PathNarrowWord ms:array<int64> pos:PathNarrowWord):>void=>$unsafe {
    let root=mk_ident_local(l pos)
    if PathNarrowWord(locals.ptr[l].flags) & LF_ALIAS not=? 0 {
        let a=PathNarrowWord(locals.ptr[l].alias)
        if nodes.ptr[a].kind =? 'conv' and nodes.ptr[a].aux =? int32(int64(CV.union_)) {root=copy_path(PathNarrowWord(nodes.ptr[a].a))}
    }
    narrow_expr(root ms pos PathNarrowWord(locals.ptr[l].name))
}

# the variable a narrowed alias local stands for (l itself when it is not one)
narrow_root_local=(l0:PathNarrowWord):>PathNarrowWord=>{
    let l=l0
    loop PathNarrowWord(locals[l].flags) & LF_ALIAS not=? 0 {
        let al=PathNarrowWord(locals[l].alias)
        if nodes[al].kind not=? 'conv' and nodes[al].kind not=? 'narrow' {return l}
        let inner=PathNarrowWord(nodes[al].a)
        if nodes[inner].kind not=? 'ident' or nodes[inner].aux not=? PATH_NARROW_LOCAL {return l}
        l=PathNarrowWord(nodes[inner].sym)
    }
    l
}

# the path (and paths inside it) may hold another value from here on: forget their narrowing
path_forget=(key:string same_type:PathNarrowWord=0):>void=>{
    if path_narrows =? 0 or key.length =? 0 {return}
    let prefix="{key}."
    let i=PathNarrowWord(check_scopes.names.length) - 1
    let floor=PathNarrowWord(ctxs[cx].floor)
    loop i >=? floor {
        let nm=name_of(check_scopes.names[i])
        if nm =? key or starts_with(nm prefix) {
            let sy=check_scopes.syms[i]
            if syms[sy].kind =? 'local' {
                let l=PathNarrowWord(syms[sy].ref)
                if PathNarrowWord(locals[l].flags) & LF_ALIAS not=? 0 {
                    # Assigning the same member preserves its tag. Its fields can change.
                    let keep=false
                    if nm =? key and same_type not=? 0 {
                        let t=prune(PathNarrowWord(locals[l].type))
                        keep=type_eq(t same_type) or (is_union(t) and union_index(t same_type) >=? 0)
                    }
                    if not keep {narrow_invalidate(l)}
                    path_forget("#L{l}")
                }
            }
        }
        i -= 1
    }
}

path_key=(n:int64):>string=>$unsafe {
    let k=nodes.ptr[n].kind
    if k =? 'ident' {
        if nodes.ptr[n].aux =? 1 {
            let a=path_decl_alias(PathNarrowWord(nodes.ptr[n].sym))
            if a not=? 0 {return path_key(a)}
            return "#L{nodes[n].sym}"
        }
        if nodes.ptr[n].aux =? 2 {return "#G{nodes[n].sym}"}
        return ""
    }
    if k =? 'field' and nodes.ptr[n].aux >=? 0 and nodes.ptr[n].a not=? 0 {
        let a=PathNarrowWord(nodes.ptr[n].a)
        if tkind(ntype(a)) not=? 'struct_' {return ""}
        let b=path_key(a)
        if (b as array<uint8>).length =? 0 {return ""}
        return "{b}.{nodes[n].aux}"
    }
    ""
}

# Only condition-created aliases escape a guard, never locals declared in an arm.
narrow_promote=(first:int64 limit:int64):>void=>$unsafe {
    loop l in [first..limit) {
        if PathNarrowWord(locals.ptr[l].flags) & (LF_ALIAS | LF_UNNARROWED) not=? LF_ALIAS {continue}
        let nm=PathNarrowWord(locals.ptr[l].name)
        if nm not=? 0 {push_scope_sym(nm new_sym(nm 'local' l 0))}
    }
}

narrow_var=(isn:int64 holds:bool):>void=>$unsafe {
    let a=PathNarrowWord(nodes.ptr[isn].a)
    if nodes.ptr[a].kind =? 'field' or (nodes.ptr[a].kind =? 'ident' and nodes.ptr[a].aux =? 2) {
        narrow_path(a PathNarrowWord(nodes.ptr[isn].aux) holds)
        return
    }
    if nodes.ptr[a].kind not=? 'ident' or nodes.ptr[a].aux not=? 1 {return}
    let l=PathNarrowWord(nodes.ptr[a].sym)
    let ut=prune(PathNarrowWord(locals.ptr[l].type))
    let vi=PathNarrowWord(nodes.ptr[isn].aux)
    let pos=nodes.ptr[a].pos
    if is_union(ut) {
        let ms=union_members(ut)
        if holds {narrow_local(l [ms[vi]] pos)}
        else {
            # (not that member: one of the others)
            let rest:array<int64>=[]
            loop i in 0.. and m in ms {
                if i not=? vi {rest.push(m)}
            }
            narrow_local(l rest pos)
        }
        return
    }
    if types.ptr[ut].kind not=? 'opt' or (vi =? -2) not=? holds {return}
    opt_unwrap_alias(l pos);
}

# the name `name` stands for root (a variable or field path) narrowed to members ms of its union
narrow_expr=(root:int64 ms:array<int64> pos:int64 name:int64):>void=>$unsafe {
    let rt=prune(ntype(root))
    if ms.length =? 0 {return}
    let e:PathNarrowWord=0
    let t:PathNarrowWord=0
    if types.ptr[rt].kind =? 'opt' {
        if ms.length not=? 1 or not type_eq(ms[0] telem(rt)) {return}
        e=mk('unwrap' pos)
        t=telem(rt)
    }
    else if not is_union(rt) {return}
    else if ms.length =? 1 {
        e=mk('narrow' pos)
        nodes[e].aux = int32<overflow='wrap'>(union_index(rt ms[0]))
        t=ms[0]
    }
    else {
        t=mk_union(ms)
        if type_eq(t rt) {return}
        e=mk('conv' pos)
        nodes[e].aux = int32<overflow='wrap'>(int64(CV.union_))
    }
    nodes[e].a = int32<overflow='wrap'>(root)
    nodes[e].type = int32<overflow='wrap'>(t)
    add_flag(e NF_CHECKED)
    let nl=new_local(name t pos)
    locals[nl].flags = int32<overflow='wrap'>(LF_ALIAS)
    locals[nl].alias = int32<overflow='wrap'>(e)
    narrow_store_register(nl)
}

# `x is? C` on x: (A | B | C)? is `x != none and x is? C` (check_istype); when it fails,
# x is none or one of the other members: an (A | B)?. x a field path or a global: as the `_`
# arm of a match on it (opt_wild_narrow_path). O(members).
narrow_opt_rest_by=(c:int64):>void=>$unsafe {
    let a=PathNarrowWord(nodes.ptr[c].a)
    if nodes.ptr[a].kind not=? 'binary' or nodes.ptr[a].op not=? 70 or nodes.ptr[PathNarrowWord(nodes.ptr[a].b)].kind not=? 'none_lit' {return}
    let x=PathNarrowWord(nodes.ptr[a].a)
    let local=nodes.ptr[x].kind =? 'ident' and nodes.ptr[x].aux =? 1
    let l:PathNarrowWord=0
    let key=""
    if local {l=PathNarrowWord(nodes.ptr[x].sym)}
    else {
        key=path_key(x)
        if (key as array<uint8>).length =? 0 {return}
    }
    let ut=prune(ntype(x))
    if local {ut=prune(PathNarrowWord(locals.ptr[l].type))}
    if types.ptr[ut].kind not=? 'opt' or not is_union(prune(PathNarrowWord(types.ptr[ut].elem))) {return}
    let u=prune(PathNarrowWord(types.ptr[ut].elem))
    let tests:array<int64>=[]
    if not or_tests(PathNarrowWord(nodes.ptr[c].b) @tests) {return}
    let excluded:array<int64>=[]
    loop t in tests {
        # (each test reads x's payload: the alias `x != none` gave it)
        let ta=PathNarrowWord(nodes.ptr[t].a)
        if nodes.ptr[ta].kind not=? 'ident' or nodes.ptr[ta].aux not=? 1 {return}
        let tl=PathNarrowWord(nodes.ptr[ta].sym)
        if PathNarrowWord(locals.ptr[tl].flags) & LF_ALIAS =? 0 or locals.ptr[tl].alias =? 0 {return}
        let al=PathNarrowWord(locals.ptr[tl].alias)
        if nodes.ptr[al].kind not=? 'unwrap' {return}
        let inner=PathNarrowWord(nodes.ptr[al].a)
        if local and (nodes.ptr[inner].kind not=? 'ident' or PathNarrowWord(nodes.ptr[inner].sym) not=? l) {return}
        if not local and path_key(inner) not=? key {return}
        if not type_eq(prune(ntype(ta)) u) {return}
        excluded.push(union_members(u)[PathNarrowWord(nodes.ptr[t].aux)])
    }
    let keep:array<int64>=[]
    loop m in union_members(u) {
        if not excluded.contains(m) {keep.push(m)}
    }
    if keep.length =? 0 {return}
    let pos=nodes.ptr[x].pos
    if not local {
        opt_wild_narrow_path(x key ut excluded false pos)
        return
    }
    # (x already narrowed so: narrow its variable, as narrow_local does)
    loop PathNarrowWord(locals.ptr[l].flags) & LF_ALIAS not=? 0 and opt_rest_aliases.has(PathNarrowWord(locals.ptr[l].alias)) {l=narrowed_var(l)}
    let inner=keep[0]
    if keep.length >? 1 {inner=mk_union(keep)}
    let nl=new_local(PathNarrowWord(locals.ptr[l].name) mk_opt(inner) pos)
    locals[nl].flags = int32<overflow='wrap'>(LF_ALIAS)
    locals[nl].alias = int32<overflow='wrap'>(opt_rest_expr(l keep pos))
    narrow_store_register(nl)
}

# where condition c is `holds` (true or false), variables it tests with `is` stand for the member
narrow_by=(c:int64 holds:bool):>void=>$unsafe {
    if holds and string_set_tests.length >? 0 and string_set_tests.has(c) {narrow_string_set(c)}
    let k=nodes.ptr[c].kind
    if k =? 'istype' {narrow_var(c holds)}
    else if k =? 'binary' and (nodes.ptr[c].op =? 70 or nodes.ptr[c].op =? 69) and nodes.ptr[PathNarrowWord(nodes.ptr[c].b)].kind =? 'none_lit' {
        # x != none: as `x is T` holding (x is its value from here)
        let isn=mk('istype' nodes.ptr[c].pos)
        nodes[isn].a = nodes.ptr[c].a
        nodes[isn].aux = -2
        narrow_var(isn holds =? (nodes.ptr[c].op =? 70))
    }
    else if k =? 'not_' {narrow_by(PathNarrowWord(nodes.ptr[c].a) not holds)}
    else if k =? 'and_' and holds {
        narrow_by(PathNarrowWord(nodes.ptr[c].a) true)
        narrow_by(PathNarrowWord(nodes.ptr[c].b) true)
    }
    else if k =? 'or_' and not holds {
        narrow_by(PathNarrowWord(nodes.ptr[c].a) false)
        narrow_by(PathNarrowWord(nodes.ptr[c].b) false)
    }
    else if k =? 'or_' and holds {
        # x is A or x is B: x is an A | B
        let tests:array<int64>=[]
        if or_tests(c @tests) {narrow_some(tests)}
    }
    else if k =? 'and_' and not holds {narrow_opt_rest_by(c)}
    else if k =? 'binary' {position_guard_note(c holds)}
}

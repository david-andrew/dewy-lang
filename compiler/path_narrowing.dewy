$runtime_checks
from p"checker_scope_symbols.dewy" import (new_local)
from p"expression_types.dewy" import (ntype)
from p"type_ops.dewy" import (union_index)
from p"checks_thin.dewy" import (narrow_invalidate)
from p"@lib/core/str.jo" import (starts_with)
from p"checked_expression_nodes.dewy" import (mk_ident_local)
from p"checker_expr.dewy" import (lookup)
from p"ast.jo" import (NF_CHECKED add_flag mk nodes)
from p"check.jo" import (LF_ALIAS LF_UNNARROWED check_scopes ctxs cx locals syms)
from p"expr.jo" import (CV narrow_expr path_key path_narrows path_rooted_g path_rooted_l)
from p"types.jo" import (is_union prune type_eq types union_members)
from p"util.jo" import (intern name_of)

PathNarrowWord:type=int64<overflow='wrap'>
const PATH_NARROW_LOCAL:int32=1 # SK.local in the frozen node ABI.

# Optional operations keep their declared optional view even when an alias is
# known to hold a value. Ordinary nonoptional operands remain type errors.
narrow_optional_source=(a:int64):>int64=>{
    if nodes[a].kind not=? 'ident' or nodes[a].aux not=? PATH_NARROW_LOCAL {return a}
    let l=PathNarrowWord(nodes[a].sym)
    if PathNarrowWord(locals[l].flags) & LF_ALIAS =? 0 {return a}
    let al=PathNarrowWord(locals[l].alias)
    if al not=? 0 and nodes[al].kind =? 'unwrap' {return int64(nodes[al].a)}
    a
}

# a narrowed path's key as a scope name, its root marked
path_name=(key:string):>PathNarrowWord=>{
    let bytes=key as array<uint8>
    let i:PathNarrowWord=2
    let id:PathNarrowWord=0
    loop i <? bytes.length and bytes[i] >=? b'0' and bytes[i] <=? b'9' {
        id=id*10 + PathNarrowWord(bytes[i] - b'0')
        i += 1
    }
    if bytes[1] =? b'L' {
        if path_rooted_l.length <=? id {path_rooted_l.resize(id*2 + 64)}
        path_rooted_l[id]=true
    }
    else {
        if path_rooted_g.length <=? id {path_rooted_g.resize(id*2 + 64)}
        path_rooted_g[id]=true
    }
    intern(key)
}

narrow_path=(a:PathNarrowWord vi:PathNarrowWord holds:bool):>void=>{
    let key=path_key(a)
    if key =? "" {return}
    let ut=prune(ntype(a))
    let pos=nodes[a].pos
    let count = @path_narrows
    count=PathNarrowWord(count) + 1
    if is_union(ut) {
        let sel:array<int64>=[]
        loop i in 0.. and m in union_members(ut) {
            if (i =? vi) =? holds {sel.push(m)}
        }
        narrow_expr(copy_path(a) sel pos path_name(key))
    }
    else if types[ut].kind =? 'opt' and (vi =? -2) =? holds {
        let e=mk('unwrap' pos)
        nodes[e].a=int32(copy_path(a))
        nodes[e].type=types[ut].elem
        add_flag(e NF_CHECKED)
        let nl=new_local(path_name(key) PathNarrowWord(types[ut].elem) pos)
        locals[nl].flags=int32(LF_ALIAS)
        locals[nl].alias=int32(e)
    }
}

# x is A or x is B ... holding: x is one of those members (when all test the same x)
narrow_some=(tests:array<int64>):>void=>{
    let a0=PathNarrowWord(nodes[tests[0]].a)
    let ut=prune(ntype(a0))
    if not is_union(ut) {return}
    let local=nodes[a0].kind =? 'ident' and nodes[a0].aux =? PATH_NARROW_LOCAL
    let key=""
    if not local {
        key=path_key(a0)
        if key =? "" {return}
    }
    let sel:array<int64>=[]
    loop t in tests {
        let a=PathNarrowWord(nodes[t].a)
        if local {
            if nodes[a].kind not=? 'ident' or nodes[a].aux not=? PATH_NARROW_LOCAL {return}
            if narrow_root_local(PathNarrowWord(nodes[a].sym)) not=? narrow_root_local(PathNarrowWord(nodes[a0].sym)) {return}
        }
        else if path_key(a) not=? key {return}
        let at=prune(ntype(a))
        if not is_union(at) {return}
        let m=union_members(at)[PathNarrowWord(nodes[t].aux)]
        if not sel.contains(m) {sel.push(m)}
    }
    if local {narrow_local(PathNarrowWord(nodes[a0].sym) sel nodes[a0].pos)}
    else {
        let count = @path_narrows
        count=PathNarrowWord(count) + 1
        narrow_expr(copy_path(a0) sel nodes[a0].pos path_name(key))
    }
}

const PATH_NARROW_GLOBAL:int32=2 # SK.global in the frozen node ABI.

# a checked copy of a field path
copy_path=(n:PathNarrowWord):>PathNarrowWord=>$unsafe {
    let copy=nodes.length
    nodes.push(nodes[n])
    if nodes.ptr[n].kind =? 'field' {
        let child=copy_path(PathNarrowWord(nodes.ptr[n].a))
        nodes.ptr[copy].a=int32(child)
    }
    copy
}

# Declaration aliases preserve path identity. Narrowing aliases retain their
# own roots so forgetting a parent can also retire paths below its payload.
# O(alias/path depth), with no allocation for an unrelated local.
path_decl_alias=(l:PathNarrowWord):>PathNarrowWord=>$unsafe {
    if PathNarrowWord(locals.ptr[l].flags) & LF_ALIAS =? 0 {return 0}
    let alias=PathNarrowWord(locals.ptr[l].alias)
    if alias =? 0 {return 0}
    let root=alias
    loop nodes.ptr[root].kind =? 'field' and nodes.ptr[root].a not=? 0 {root=PathNarrowWord(nodes.ptr[root].a)}
    if nodes.ptr[root].kind =? 'ident' {return alias}
    0
}

# might the field path (or name) n have a narrowed scope entry: its root is marked
path_rooted=(n0:PathNarrowWord):>bool=>$unsafe {
    let n=n0
    loop nodes.ptr[n].kind =? 'field' and nodes.ptr[n].a not=? 0 {n=PathNarrowWord(nodes.ptr[n].a)}
    if nodes.ptr[n].kind not=? 'ident' {return false}
    let id=PathNarrowWord(nodes.ptr[n].sym)
    if nodes.ptr[n].aux =? PATH_NARROW_LOCAL {
        let a=path_decl_alias(id)
        if a not=? 0 {return path_rooted(a)}
        return id <? path_rooted_l.length and path_rooted_l.ptr[id]
    }
    if nodes.ptr[n].aux =? PATH_NARROW_GLOBAL {return id <? path_rooted_g.length and path_rooted_g.ptr[id]}
    false
}

# the alias local a field path (or global) is narrowed to here, or -1
path_alias=(n:PathNarrowWord):>PathNarrowWord=>$unsafe {
    if not path_rooted(n) {return -1}
    let key=path_key(n)
    if key.length =? 0 {return -1}
    let s=lookup(intern(key))
    if s =? 0 or syms.ptr[s].kind not=? 'local' {return -1}
    let alias=PathNarrowWord(syms.ptr[s].ref)
    if locals.ptr[alias].owner not=? ctxs.ptr[cx].inst or PathNarrowWord(locals.ptr[alias].flags) & LF_UNNARROWED not=? 0 {return -1}
    alias
}

# the `x is M` tests (of members) an or-chain is made of; false: it has something else too
or_tests=(c:PathNarrowWord @out:array<int64>):>bool=>$unsafe {
    let k=nodes.ptr[c].kind
    if k =? 'or_' {return or_tests(PathNarrowWord(nodes.ptr[c].a) @out) and or_tests(PathNarrowWord(nodes.ptr[c].b) @out)}
    if k =? 'istype' and nodes.ptr[c].aux >=? 0 {
        out.push(int64(c))
        return true
    }
    false
}

# from here on, union variable l is known to hold one of members ms: its name stands for that
# member (one) or the smaller union of them (converted from the variable's value when used)
narrow_local=(l:PathNarrowWord ms:array<int64> pos:PathNarrowWord):>void=>$unsafe {
    let root=mk_ident_local(l pos)
    if PathNarrowWord(locals.ptr[l].flags) & LF_ALIAS not=? 0 {
        let a=PathNarrowWord(locals.ptr[l].alias)
        if nodes.ptr[a].kind =? 'conv' and nodes.ptr[a].aux =? int32(int64(CV.union_)) {root=copy_path(PathNarrowWord(nodes.ptr[a].a))}
    }
    narrow_expr(root ms pos PathNarrowWord(locals.ptr[l].name))
}

# the variable a narrowed alias local stands for (l itself when it is not one)
narrow_root_local=(l0:PathNarrowWord):>PathNarrowWord=>{
    let l=l0
    loop PathNarrowWord(locals[l].flags) & LF_ALIAS not=? 0 {
        let al=PathNarrowWord(locals[l].alias)
        if nodes[al].kind not=? 'conv' and nodes[al].kind not=? 'narrow' {return l}
        let inner=PathNarrowWord(nodes[al].a)
        if nodes[inner].kind not=? 'ident' or nodes[inner].aux not=? PATH_NARROW_LOCAL {return l}
        l=PathNarrowWord(nodes[inner].sym)
    }
    l
}

# the path (and paths inside it) may hold another value from here on: forget their narrowing
path_forget=(key:string same_type:PathNarrowWord=0):>void=>{
    if path_narrows =? 0 or key.length =? 0 {return}
    let prefix="{key}."
    let i=PathNarrowWord(check_scopes.names.length) - 1
    let floor=PathNarrowWord(ctxs[cx].floor)
    loop i >=? floor {
        let nm=name_of(check_scopes.names[i])
        if nm =? key or starts_with(nm prefix) {
            let sy=check_scopes.syms[i]
            if syms[sy].kind =? 'local' {
                let l=PathNarrowWord(syms[sy].ref)
                if PathNarrowWord(locals[l].flags) & LF_ALIAS not=? 0 {
                    # Assigning the same member preserves its tag. Its fields can change.
                    let keep=false
                    if nm =? key and same_type not=? 0 {
                        let t=prune(PathNarrowWord(locals[l].type))
                        keep=type_eq(t same_type) or (is_union(t) and union_index(t same_type) >=? 0)
                    }
                    if not keep {narrow_invalidate(l)}
                    path_forget("#L{l}")
                }
            }
        }
        i -= 1
    }
}

use 'ast.jo'
use 'check.jo'
use 'directives.jo'
use 'expr.jo'
use 'util.jo'

setting_value_target = (n: int) -> int:
    # A later callable conversion may replace a generated value. Follow only
    # the exact construction tail that was recorded, never stale metadata.
    if nodes[n].kind != .block or nkids(n) == 0: return n
    target = setting_value_targets.get(n) ?? 0
    if target == 0: return n
    tail = kid(n, nkids(n) - 1)
    if nodes[tail].kind == .exprstmt: tail = int(nodes[tail].a)
    if tail == target: return target
    if tail != n and setting_value_target(tail) == target: return target
    n

setting_value_needed = (n: int) -> bool:
    dir_runtime_policies.len() != 0 and not setting_value_wrapped.has(n) and dewy_at(nodes[n].pos) and not pos_in_lib(nodes[n].pos)

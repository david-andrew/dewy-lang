$runtime_checks
from p"ast.jo" import (mk set_list)
from p"check.jo" import (FK_INIT ctxs cx fns module_ctx module_frames modules)
from p"checker_symbol_spelling.dewy" import (sanitize)
from p"checker_state.dewy" import (FnCtx)
from p"checks_thin.dewy" import (new_inst)
from p"types.jo" import (T_VOID)
from p"util.jo" import (mkpos name_of)

ContextWord:type=int64<overflow='wrap'>
ContextI32:type=int32<overflow='wrap'>

ctx_for_inst=(inst:ContextWord):>ContextWord=>{
    let c=cx
    loop c >=? 0 {
        if ctxs[c].inst =? inst {return c}
        c=ContextWord(ctxs[c].parent)
    }
    -1
}

setup_module_contexts=(prelude_init:ContextWord):>void=>{
    loop mi in [module_ctx.length..modules.length) {
        let inst=prelude_init
        if not modules[mi].is_prelude {
            let name=sanitize(name_of(ContextWord(modules[mi].name)))
            inst=new_inst(FK_INIT mi "init_{name}")
            let body=mk('block' mkpos(ContextWord(modules[mi].file) 0))
            set_list(body modules[mi].inits)
            fns[inst].body=ContextI32(body)
        }
        modules[mi].init_fn=ContextI32(inst)
        module_frames.push(FnCtx(ContextI32(inst) (-1) ContextI32(T_VOID) false 0 ContextI32(mi) 0))
        module_ctx.push(-1)
    }
}

push_module_frame=(m:ContextWord):>void=>{
    module_ctx[m]=ctxs.length
    ctxs.push(module_frames[m])
}

# Module state outlives a check, but temporary function contexts are a stack.
# Keep inactive module frames outside that stack so loading another module
# during an expression cannot interfere with its caller's push/pop lifetime.
enter_module_context=(m:ContextWord):>bool=>{
    if module_ctx[m] >=? 0 {return false}
    push_module_frame(m)
    true
}

cur_mod=():>int64=>$unsafe {
    if cx >=? 0 {return int64(ctxs.ptr[cx].mod)}
    0
}

# The current module binds name itself, by a declaration or `from m import name`: its
# choice, which Dewy's own reading of a prelude name (the strict `to_int`, a grapheme
# `find`) does not replace: an import may shadow the prelude's. O(1).
bound_here=(name:ContextWord):>bool=>$unsafe {
    let m=cur_mod()
    m >=? 0 and m <? modules.length and not modules.ptr[m].is_prelude and modules.ptr[m].names.has(name)
}

use 'checker_hooks.dewy'
# Frozen program checking and phase orchestration from check.jo.
use 'check.jo'
use 'checks_thin.dewy'
use 'checks_static.dewy'
use 'checks_program.dewy'
use 'checks_main.dewy'
use 'checks_imports.dewy'
use 'icount.jo'
use 'icount_ops.dewy'
use 'ast.jo'
use 'types.jo'
use 'type_ops.dewy'
use 'arena.jo'
use 'check_constant.jo'
use 'constant_checks.dewy'
use 'concurrency.jo'
use 'expr.jo'
use 'lazy_bodies.jo'
use 'lazy_force.dewy'
use 'deadlock.jo'
use 'deadlock_graph.dewy'
use 'decimals.jo'
use 'decimal_ops.dewy'
use 'dewy_methods.jo'
use 'dewy_method_ops.dewy'
use 'prelude.jo'
use 'prelude_ops.dewy'
use 'definite.jo'
use 'definite_walk.dewy'
use 'directives.jo'
use 'directive_ops.dewy'
use 'effects.jo'
use 'util.jo'
use 'exact.jo'
use 'facts.jo'
use 'facts_lifecycle.dewy'
use 'floats.jo'
use 'float_ops.dewy'
use 'checker_signature.dewy'
use 'ide.jo'
use 'ide_ops.dewy'
use 'import_cycles.jo'
use 'cycle_ops.dewy'
use 'string_domains.jo'
use 'string_domain_ops.dewy'
use 'member_replay.jo'
use 'member_admit.dewy'
use 'ownership.jo'
use 'ownership_hooks.dewy'
use 'module_paths.dewy'
use 'pcheck.jo'
use 'poly_closure.jo'
use 'poly_ops.dewy'
use 'errors.jo'
use 'error_ops.dewy'
use 'proofs.jo'
use 'proof_ops.dewy'
use 'refine.jo'
use 'parse.jo'
use 'safe_paths.jo'
use 'warn_if.jo'
use 'warn_if_ops.dewy'
use 'arena_ops.dewy'
use 'effect_control.dewy'
use 'concurrency_types.dewy'
use 'concurrency_tasks.dewy'

check_program = (main_path: str):
    member_reset()
    console_type_id = -1
    ut_reset()
    wi_reset()
    cc_reset()
    ownership_reset()
    facts_reset()
    refine_reset()
    proof_reset()
    effects_reset()
    arena_reset()
    directives_reset()
    float_keys_reset()
    floats_notes_reset()
    program_name_default(main_path)
    add_universe()
    ic_switch(IC_LOAD, IC_LIB)
    load_prelude()
    ic_switch(IC_LOAD, IC_ROOT)
    mainm = load_module(main_path, false, -1)
    ic_switch(IC_CHECK, IC_SHARED)
    ts_dewy = files[int(modules[mainm].file)].is_dewy
    program_setting_errors(mainm)
    # The editor checks library documents with an empty main. Named libraries
    # are outside the prelude, so load the opened document explicitly as well.
    if ide_on and starts_with(ide_doc, path_norm(lib_dir) + "/") and find_module(ide_doc) < 0:
        load_module(ide_doc, false, -1)
    if stop_after == "lex" or stop_after == "parse": exit(0)
    modules[mainm].is_main = true
    i = 0
    loop i < modules.len():
        icb = ic_mod(IC_CHECK, i)
        register_module(i)
        ic_restore(icb)
        i += 1
    # (dictionaries hash keys with the keyed value hash: lib/core/map.jo)
    runtime_switch_on("__KEYED_HASH")
    runtime_switch_on("__MUL_HI")
    runtime_switch_on("__SECRETS")
    if runtime_switches.len() > 0: runtime_switch()
    bind_from_imports()
    dewy_resolve_inherited()
    if dewy_methods.len() > 0: dc_force_all()
    dewy_infer_methods()
    # (the locks prelude and the outcomes of locks, channels and queues declare nominal errors,
    # `DuplicateLock`, `Busy`, `Closed`, `Unsent`..., so each loads before they close when a Dewy
    # program names it: a probe per name, all asked before any loads, nothing otherwise)
    locks = ts_dewy and prelude_named(["mutex", "Mutex", "lock_all", "DuplicateLock"])
    channels = ts_dewy and prelude_named(["channel", "Channel"])
    queue = ts_dewy and prelude_named(["mpmc", "Mpmc"])
    ring = ts_dewy and prelude_named(["spsc", "Spsc", "SpscSender", "SpscReceiver"])
    protocols = ts_dewy and prelude_named(["serve", "Service", "pipeline"], true)
    # (the outcomes also load for any source naming one, its own type of that name included: a
    # module that does not declare it may still reach the prelude's)
    if locks or channels or queue or ring or protocols or ts_dewy and names_known(["Unsent", "Full", "Empty", "Closed", "Busy"]): dewy_prelude_module(intern("Unsent"))
    if locks: dewy_prelude_module(intern("mutex"))
    if queue or ring: dewy_prelude_file("mpmc.jo")
    if queue: dewy_prelude_module(intern("mpmc"))
    # (the spsc ring's runtime shares mpmc.jo's atomics and waits)
    if ring:
        dewy_prelude_file("spsc.jo")
        dewy_prelude_module(intern("spsc"))
    # (the certified protocols are built on channels: theirs load first)
    if channels or protocols: dewy_prelude_module(intern("channel"))
    if protocols: concurrency_protocol_module = dewy_prelude_module(intern("serve"))
    prepare_nominals()
    check_build_block()
    # (native programs report crashes as they do panics: lib/std/backtrace.jo)
    if not target_wasm and prelude.get(intern("__crash_install")) != none: modules[mainm].inits.insert(0, synth_call("__crash_install", [], 0))
    # programs with update()/draw() run the game loop after main()
    has_upd = game_fn(mainm, "update") != none
    has_drw = game_fn(mainm, "draw") != none
    program_callback_checks(mainm, has_upd, has_drw)
    program_tests(mainm, main_path)
    if (not test_mode or check_all) and (has_upd or has_drw):
        program_game(mainm, has_upd, has_drw)
    prelude_init = new_inst(FK_INIT, 0, "init_prelude")
    prelude_body = mk(.block, 0)
    fns[prelude_init].body = i32(prelude_body)
    fns[prelude_init].ret = i32(T_VOID)
    fns[prelude_init].state = 2
    module_ctx = []
    module_frames = []
    setup_module_contexts(prelude_init)
    # Set up testing after runtime globals, before any user module initializer.
    # Imported initializers must see the original arguments and headless mode too.
    test_start = 0
    if test_mode: test_start = runtime_fn("__test_run_begin")
    order = init_module_order(mainm)
    init_fns = [prelude_init]
    if test_start != 0: init_fns.push(test_start)
    loop m in order:
        if not modules[m].is_prelude: init_fns.push(int(modules[m].init_fn))
    cx = -1
    check_pushers_first()
    decimal_writers_first()
    # (a struct or enum of the program's whose values hold one another without end, a: A, is an
    # error used or not)
    loop m in order:
        if modules[m].is_prelude: continue
        loop nm, s in modules[m].names:
            sk = syms[s].kind
            if (sk == .struct_ or sk == .enum_) and syms[s].decl != 0 and nkids2(int(syms[s].decl)) == 0 and (nodes[int(syms[s].decl)].kind == .struct_ or nodes[int(syms[s].decl)].kind == .enum_):
                layout(get_struct_inst(int(syms[s].decl), []))
    if let s = modules[mainm].names.get(intern("main")):
        # (main() at the end of the file, as in Python: it runs once, there)
        calls_main = false
        loop st in modules[mainm].inits:
            if calls_named(st, "main"):
                # (Dewy runs a program's main by itself, exactly once)
                if files[int(modules[mainm].file)].is_dewy and syms[s].kind == .fns and nodes[st].pos > 0 and not pos_in_lib(nodes[st].pos): program_main_error0(st, s)
                calls_main = true
        if syms[s].kind == .fns and not skip_main and not calls_main:
            main_fn = get_fn_inst(int(syms[s].decl), [], 0)
            rt = prune(int(fns[main_fn].ret))
            if files[int(modules[mainm].file)].is_dewy: dewy_main_result(int(syms[s].decl), rt)
            else if rt != T_VOID and rt != T_NEVER and not is_int(rt):
                program_main_error1(s, rt)
    if let s = game_fn(mainm, "update"):
        if syms[s].kind == .fns:
            # (update = (dt): ..., its parameter untyped: the seconds the game loop gives it)
            ud = int(syms[s].decl)
            if fn_sig(ud).generic and int(fn_sig(ud).ntp) == 1 and nkids(ud) == 1: update_fn = get_fn_inst(ud, [T_FLOAT], 0)
            else: update_fn = get_fn_inst(ud, [], 0)
    if let s = game_fn(mainm, "draw"):
        if syms[s].kind == .fns: draw_fn = get_fn_inst(int(syms[s].decl), [], 0)
    loop d in export_decls:
        if not modules[int(nodes[d].mod)].is_prelude: export_fns.push(get_fn_inst(d, [], nodes[d].pos))
    # the program's own functions are all checked, called or not (errors should not hide in
    # unused code); only what is reachable is compiled
    if ide_on: ide_force = ide_find_file(ide_doc)
    loop m in modules:
        if m.is_prelude and int(m.file) != ide_force: continue
        loop d in m.decls:
            if nodes[d].kind == .fn_ and not has_flag(d, NF_EXTERN) and not fn_sig(d).generic: get_fn_inst(d, [], nodes[d].pos)
    loop nm in runtime_names: runtime_fn(nm)
    runtime_memeq = runtime_fn("__mem_eq")
    runtime_streq = runtime_fn("__str_eq")
    # (__mac_syscall lives in macos.jo's `when TARGET == "macos"`: elsewhere asking parses it for nothing)
    loop nm in optional_runtime:
        if nm != "__mac_syscall" or target_macos: runtime_demand(nm)
    if float_int_demanded: runtime_demand("__float_int_fail")
    # (@cabi functions set __c_threads: lib/core/rt.jo)
    if let ct = prelude.get(intern("__c_threads")):
        if syms[ct].kind == .global: ensure_global(int(syms[ct].ref), 0)
    # (vectorized code reads __cpu_avx2: its initializer must be checked with the rest)
    if want_cpu_flag:
        if let cs = prelude.get(intern("__cpu_avx2")):
            if syms[cs].kind == .global: ensure_global(int(syms[cs].ref), 0)
    # (a web page's loops count down to the watchdog, which stops one that never ends)
    if want_loop_watch:
        if let ls = prelude.get(intern("__loop_budget")):
            if syms[ls].kind == .global:
                ensure_global(int(syms[ls].ref), 0)
                runtime_fn("__loop_watchdog")
    # check everything reachable; library exports join once their module is in use
    k = 0
    exp_added: bool[] = fill(false, export_decls.len())
    loop true:
        k = run_pending_functions(k)
        if runtime_ffi_demand(): continue
        used: {int: bool} = {}
        loop fi in [1..fns.len()):
            if fns[fi].state == 2 and fns[fi].decl != 0: used[int(nodes[int(fns[fi].decl)].mod)] = true
        more = false
        exp_added.resize(export_decls.len())
        loop ei in 0.. and d in export_decls:
            if exp_added[ei] or not modules[int(nodes[d].mod)].is_prelude: continue
            if used.get(int(nodes[d].mod)) != none:
                exp_added[ei] = true
                export_fns.push(get_fn_inst(d, [], nodes[d].pos))
                more = true
        if not more: break
    pc_finish()
    string_domains_finish()
    string_domains_materialize()
    int_domains_finish()
    if poly_families.len() > 1: poly_finish_warnings()
    if open_globals.len() > 0: settle_open_globals()
    # (make_world written and never called: nothing runs it. A file of definitions alone, with
    # no main, update or draw and no statement at its top that does something, is a module that
    # others use: checked by itself, nothing in it is called)
    runs = false
    loop i0 in modules[mainm].inits:
        ik = nodes[i0].kind
        # (statements the file has, not ones made for it: they have no place in it)
        if nodes[i0].pos <= 0 or pos_in_lib(nodes[i0].pos): continue
        if ik != .vardecl and ik != .assign and ik != .const_: runs = true
    loop nm0 in ["main", "update", "draw"]:
        if game_fn(mainm, nm0) != none: runs = true
    # (a const nothing uses is checked too: `const X = no_such(3)` is an error, used or not)
    loop mi in [0..modules.len()):
        if modules[mi].is_prelude: continue
        loop cn, cs in modules[mi].names:
            if syms[cs].kind == .const_ and syms[cs].decl != 0:
                cg = int(syms[cs].ref)
                if globals[cg].decl != 0: ensure_global(cg, nodes[int(syms[cs].decl)].pos)
    # An otherwise unused constant can discover another exact-arithmetic
    # module. Finish its queued bodies before lowering any initialization.
    if k < fns.len():
        k = run_pending_functions(k)
        if runtime_ffi_demand(): k = run_pending_functions(k)
        if open_globals.len() > 0: settle_open_globals()
    ut_run()
    if late_module_imports:
        order = init_module_order(mainm)
        init_fns = [prelude_init]
        if test_start != 0: init_fns.push(test_start)
        loop m in order:
            if not modules[m].is_prelude: init_fns.push(int(modules[m].init_fn))
    merge_cycle_inits(order)
    if dg_globals.len() > 0 and not test_mode:
        later: int[]
        if update_fn > 0: later.push(update_fn)
        if draw_fn > 0: later.push(draw_fn)
        loop f in export_fns: later.push(f)
        dg_check_program(init_fns, main_fn, later)
    program_unused_warnings(mainm, main_path, runs)
    # prelude init: referenced prelude globals in declaration order
    pl: int[]
    loop g in global_ids:
        if modules[int(globals[g].mod)].is_prelude and globals[g].state == 2: pl.push(int(globals[g].decl))
    order_prelude_globals(pl)
    set_list(int(fns[prelude_init].body), pl)
    zonk_tree(int(fns[prelude_init].body))
    # Close declared promises after every checked helper has been discovered,
    # including check-only callers and unreachable checked declarations.
    pc_finish()
    string_domains_finish()
    string_domains_materialize()
    int_domains_finish()
    if not errors_only:
        icb = ic_switch(IC_FACTS, IC_SHARED)
        exact_prepare()
        ic_switch(IC_OWNERSHIP, IC_SHARED)
        ownership_finalize()
        ic_switch(IC_EFFECTS, IC_SHARED)
        concurrency_finalize()
        concurrency_claims_finalize()
        deadlock_finalize()
        effects_finalize()
        ic_restore(icb)

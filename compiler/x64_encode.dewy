$runtime_checks
# Complete native encoding operations; instruction selection stays in x64.jo.
# O(emitted bytes), with existing bounded branch-slot and address decisions.
XWord:type=int64<overflow='wrap'>
const RAX = 0
const RCX = 1
const RDX = 2
const RBX = 3
const RSP = 4
const RBP = 5
const RSI = 6
const RDI = 7
const R8 = 8
const R9 = 9
const R10 = 10
const R11 = 11
const RIPREL = 99
const XMM = 16
const VX = 4
const VY = 5
let frame_size:XWord=0
let x_code:ptr<array<uint8>>=$unsafe (uint64(0) as ptr<array<uint8>>)
let x_data_fix:ptr<array<[int64 int64 int64]>>=$unsafe (uint64(0) as ptr<array<[int64 int64 int64]>>)
x64_encoder_bind=(output:ptr<array<uint8>> fixups:ptr<array<[int64 int64 int64]>>):>XWord=>$unsafe {
    x_code = output
    x_data_fix = fixups
    0
}
let rip_kind:XWord=0
let cur_index:XWord=-1
let cur_scale:XWord=0
use_index=(ix:XWord scale:XWord):>void=>$unsafe {
    cur_index = ix
    cur_scale = scale
}
indexed_base=(base:XWord disp:XWord imm:XWord):>[int64 int64]=>$unsafe {
    if base not=? RIPREL {
        return [base  disp]
    }
    rel_fixup_lea(RCX  rip_kind  disp - imm)
    [RCX  imm]
}
rex=(w:bool r:XWord x:XWord bb0:XWord force:bool):>void=>$unsafe {
    let bb=bb0
    if bb =? RIPREL {
        bb = 0
    }
    let v:XWord=0x40
    if w {
        v |= 8
    }
    if r & 8 not=? 0 {
        v |= 4
    }
    if x & 8 not=? 0 or (cur_index >=? 0 and cur_index & 8 not=? 0) {
        v |= 2
    }
    if bb & 8 not=? 0 {
        v |= 1
    }
    if v not=? 0x40 or force {
        b(v)
    }
}
let rsp_frame = false
let rsp_extra:XWord=0
mem=(reg:XWord base0:XWord disp0:XWord):>void=>$unsafe {
    let base=base0
    let disp=disp0
    if rsp_frame and base =? RBP {
        base = RSP
        disp += frame_size + rsp_extra
    }
    let r=reg & 7
    if cur_index >=? 0 {
        let sib=(cur_scale << 6) | ((cur_index & 7) << 3) | (base & 7)
        if disp =? 0 and base & 7 not=? 5 {
            b((r << 3) | 4)
            b(sib)
        }
        else if disp >=? -128 and disp <=? 127 {
            b(0x40 | (r << 3) | 4)
            b(sib)
            b(disp)
        }
        else {
            b(0x80 | (r << 3) | 4)
            b(sib)
            b32(disp)
        }
        return
    }
    if base =? RIPREL {
        b((r << 3) | 5)
        b32(0)
        x_data_fix[0].push([XWord(x_code[0].length) - 4  rip_kind  disp])
        return
    }
    let bs=base & 7
    if disp =? 0 and bs not=? 5 {
        b((r << 3) | bs)
        if bs =? 4 {
            b(0x24)
        }
    }
    else if disp >=? -128 and disp <=? 127 {
        b(0x40 | (r << 3) | bs)
        if bs =? 4 {
            b(0x24)
        }
        b(disp)
    }
    else {
        b(0x80 | (r << 3) | bs)
        if bs =? 4 {
            b(0x24)
        }
        b32(disp)
    }
}
modrr=(reg:XWord rm:XWord):>void=>$unsafe {
    b(0xC0 | ((reg & 7) << 3) | (rm & 7))
}
op_rm=(opc:XWord w:bool reg:XWord base:XWord disp:XWord):>void=>$unsafe {
    rex(w  reg  0  base  false)
    b(opc)
    mem(reg  base  disp)
}
op_rr=(opc:XWord w:bool reg:XWord rm:XWord):>void=>$unsafe {
    rex(w  reg  0  rm  false)
    b(opc)
    modrr(reg  rm)
}
mov_rm=(r:XWord base:XWord disp:XWord):>void=>$unsafe {
    op_rm(0x8B  true  r  base  disp)
}
mov_mr=(base:XWord disp:XWord r:XWord):>void=>$unsafe {
    op_rm(0x89  true  r  base  disp)
}
mov_rr=(d:XWord s:XWord):>void=>$unsafe {
    op_rr(0x89  true  s  d)
}
lea=(r:XWord base:XWord disp:XWord):>void=>$unsafe {
    op_rm(0x8D  true  r  base  disp)
}
mov_imm=(r:XWord v:XWord):>void=>$unsafe {
    if v >=? 0 and v <=? 0xFFFFFFFF {
        rex(false  0  0  r  false)
        b(0xB8 + (r & 7))
        b32(v)
    }
    else if v >=? -2147483648 and v <=? 2147483647 {
        rex(true  0  0  r  false)
        b(0xC7)
        modrr(0  r)
        b32(v)
    }
    else {
        rex(true  0  0  r  false)
        b(0xB8 + (r & 7))
        b64(v)
    }
}
load_sized=(r:XWord base:XWord disp:XWord size:XWord signed:bool):>void=>$unsafe {
    if size =? 8 {
        mov_rm(r  base  disp)
    }
    else if size =? 4 {
        if signed {
            op_rm(0x63  true  r  base  disp)
        }
        else {
            op_rm(0x8B  false  r  base  disp)
        }
    }
    else if size =? 2 {
        rex(true  r  0  base  false)
        b(0x0F)
        if signed {
            b(0xBF)
        }
        else {
            b(0xB7)
        }
        mem(r  base  disp)
    }
    else {
        rex(true  r  0  base  false)
        b(0x0F)
        if signed {
            b(0xBE)
        }
        else {
            b(0xB6)
        }
        mem(r  base  disp)
    }
}
store_sized=(base:XWord disp:XWord r:XWord size:XWord):>void=>$unsafe {
    if size =? 8 {
        mov_mr(base  disp  r)
    }
    else if size =? 4 {
        op_rm(0x89  false  r  base  disp)
    }
    else if size =? 2 {
        b(0x66)
        op_rm(0x89  false  r  base  disp)
    }
    else {
        rex(false  r  0  base  r >=? 4)
        b(0x88)
        mem(r  base  disp)
    }
}
sse_rm=(prefix:XWord opc:XWord x:XWord base:XWord disp:XWord):>void=>$unsafe {
    if prefix not=? 0 {
        b(prefix)
    }
    rex(false  x  0  base  false)
    b(0x0F)
    b(opc)
    mem(x  base  disp)
}
sse_rr=(prefix:XWord opc:XWord x:XWord y:XWord):>void=>$unsafe {
    if prefix not=? 0 {
        b(prefix)
    }
    rex(false  x  0  y  false)
    b(0x0F)
    b(opc)
    modrr(x  y)
}
is_vreg_vec=(ty:XWord):>bool=>$unsafe {
    ty =? VX or ty =? VY
}
vex=(reg:XWord vvvv:XWord rm:XWord map:XWord pp:XWord w:XWord l:XWord):>void=>$unsafe {
    let rb=rm
    if rb =? RIPREL {
        rb = 0
    }
    let x:XWord=0
    if cur_index >=? 0 and cur_index & 8 not=? 0 {
        x = 1
    }
    b(0xC4)
    b(((1 - ((reg >> 3) & 1)) << 7) | ((1 - x) << 6) | ((1 - ((rb >> 3) & 1)) << 5) | map)
    b((w << 7) | ((15 - (vvvv & 15)) << 3) | (l << 2) | pp)
}
vmov_rr=(x:XWord y:XWord ty:XWord):>void=>$unsafe {
    if x =? y {
        return
    }
    if ty =? VY {
        vex(x  0  y  1  0  0  1)
        b(0x28)
        modrr(x  y)
    }
    else {
        sse_rr(0  0x28  x  y)
    }
}
vmov_rm=(x:XWord base:XWord disp:XWord ty:XWord):>void=>$unsafe {
    if ty =? VY {
        vex(x  0  base  1  0  0  1)
        b(0x10)
        mem(x  base  disp)
    }
    else {
        sse_rm(0  0x10  x  base  disp)
    }
}
vmov_mr=(base:XWord disp:XWord x:XWord ty:XWord):>void=>$unsafe {
    if ty =? VY {
        vex(x  0  base  1  0  0  1)
        b(0x11)
        mem(x  base  disp)
    }
    else {
        sse_rm(0  0x11  x  base  disp)
    }
}
vec_esize=(k:XWord):>XWord=>$unsafe {
    if k =? 0 or k =? 2 {
        return 4
    }
    8
}
jmp32=():>XWord=>$unsafe {
    b(0xE9)
    b32(0)
    XWord(x_code[0].length) - 4
}
jcc32=(cc:XWord):>XWord=>$unsafe {
    b(0x0F)
    b(0x80 + cc)
    b32(0)
    XWord(x_code[0].length) - 4
}
patch_branch=(pos:XWord target:XWord):>void=>$unsafe {
    let bytes=x_code[0].ptr
    let delta=target - pos
    if bytes[pos - 1] =? 0xE9 {
        let offset=(pos - 1) & 31
        let pad:XWord=if offset >=? 30 {32 - offset} else {0}
        let short=delta - 1 - pad
        if offset >=? 27 and short >=? -128 and short <=? 127 {
            if pad =? 1 {
                bytes[pos - 1] = 0x90
            }
            else if pad =? 2 {
                bytes[pos - 1] = 0x66
                bytes[pos] = 0x90
            }
            bytes[pos - 1 + pad] = 0xEB
            bytes[pos + pad] = uint8((short & 255) & 255)
            if pad =? 0 {
                bytes[pos + 1] = 0x0F
                bytes[pos + 2] = 0x1F
                bytes[pos + 3] = 0
            }
            else if pad =? 1 {
                bytes[pos + 2] = 0x66
                bytes[pos + 3] = 0x90
            }
            else {
                bytes[pos + 3] = 0x90
            }
        }
        else {
            patch32(pos  delta - 4)
        }
        return
    }
    let offset=(pos - 2) & 31
    let pad:XWord=if offset >=? 30 {32 - offset} else {0}
    let short=delta - pad
    if pos >=? 2 and offset >=? 26 and (offset <? 30 or delta <? 0) and short >=? -128 and short <=? 127 and bytes[pos - 2] =? 0x0F and bytes[pos - 1] >=? 0x80 and bytes[pos - 1] <=? 0x8F {
        let cc=bytes[pos - 1] - 0x10
        if pad =? 1 {
            bytes[pos - 2] = 0x90
        }
        else if pad =? 2 {
            bytes[pos - 2] = 0x66
            bytes[pos - 1] = 0x90
        }
        bytes[pos - 2 + pad] = cc
        bytes[pos - 1 + pad] = uint8((short & 255) & 255)
        if pad =? 0 {
            patch32(pos  0x00401F0F)
        }
        else if pad =? 1 {
            bytes[pos + 1] = 0x0F
            bytes[pos + 2] = 0x1F
            bytes[pos + 3] = 0
        }
        else {
            bytes[pos + 2] = 0x66
            bytes[pos + 3] = 0x90
        }
        let next=pos + 4
        if next + 1 <? XWord(x_code[0].length) and bytes[next] & 0xF0 =? 0x40 {
            let op=XWord(bytes[next + 1])
            if op =? 0x89 or op =? 0x8B or op =? 0x8D or op =? 0x85 or (op <? 0x40 and (op & 7 =? 1 or op & 7 =? 3)) or (op >=? 0xB8 and op <=? 0xBF) or ((op =? 0x81 or op =? 0x83 or op =? 0xC7) and next + 2 <? XWord(x_code[0].length) and bytes[next + 2] >=? 0xC0) {
                loop i in [pos + pad..pos + 4) {
                    bytes[i] = 0x2E
                }
            }
        }
    }
    else {
        patch32(pos  delta - 4)
    }
}
let x_padding_floor:XWord=0
let x_padding_cmov:XWord=-1
patch_here=(pos:XWord):>void=>$unsafe {
    x_padding_floor = XWord(x_code[0].length)
    patch_branch(pos  XWord(x_code[0].length))
}
jmp_back=(target:XWord):>void=>$unsafe {
    let pos=jmp32()
    patch_branch(pos  target)
}
const CC_E = 4
const CC_NE = 5
const CC_L = 0xC
const CC_GE = 0xD
const CC_LE = 0xE
const CC_G = 0xF
const CC_B = 2
const CC_AE = 3
const CC_BE = 6
const CC_A = 7
const CC_P = 0xA
const CC_NP = 0xB
let NOPS:array<array<int64>>=[[0x90]  [0x66  0x90]  [0x0F  0x1F  0x00]  [0x0F  0x1F  0x40  0x00]  [0x0F  0x1F  0x44  0x00  0x00]  [0x66  0x0F  0x1F  0x44  0x00  0x00]  [0x0F  0x1F  0x80  0x00  0x00  0x00  0x00]  [0x0F  0x1F  0x84  0x00  0x00  0x00  0x00  0x00]  [0x66  0x0F  0x1F  0x84  0x00  0x00  0x00  0x00  0x00]]
nop_pad=(n0:XWord):>void=>$unsafe {
    let n=n0
    loop n >? 0 {
        let k=min(n  14)
        if k >? 9 {
            loop i in [0..k - 8) {
                b(0x66)
            }
            loop x in NOPS[7] {
                b(x)
            }
        }
        else {
            loop x in NOPS[k - 1] {
                b(x)
            }
        }
        n -= k
    }
}
setcc=(cc:XWord):>void=>$unsafe {
    b(0x0F)
    b(0x90 + cc)
    b(0xC0)
    b(0x0F)
    b(0xB6)
    b(0xC0)
}
setcc_reg=(cc:XWord r:XWord):>void=>$unsafe {
    rex(false  0  0  r  r >=? 4)
    b(0x0F)
    b(0x90 + cc)
    modrr(0  r)
    rex(false  r  0  r  r >=? 4)
    b(0x0F)
    b(0xB6)
    modrr(r  r)
}
rel_fixup_lea=(r:XWord kind:XWord off:XWord):>void=>$unsafe {
    rex(true  r  0  0  false)
    b(0x8D)
    b(((r & 7) << 3) | 5)
    b32(0)
    x_data_fix[0].push([XWord(x_code[0].length) - 4  kind  off])
}

# Borrow the stable output-array variable. A reservation detaches shared storage
# or grows capacity, then rereads the header. Byte pointers never survive growth.
x_bytes=(n:XWord):>ptr<uint8>=>$unsafe {
    let slot=x_code as ptr<ptr<XWord>>
    let header=slot[0]
    let old:XWord=0
    if header not=? (uint64(0) as ptr<XWord>) {old=header[1]}
    if header =? (uint64(0) as ptr<XWord>) or header[0] not=? 1 or header[2] <? old + n {
        x_code[0].reserve(old + n)
        header=slot[0]
    }
    header[1]=old + n
    (header as ptr<uint8>) + 24 + old
}
b=(x:XWord):>void=>$unsafe {x_code[0].push(uint8(x & 255))}
b16=(x:XWord):>void=>$unsafe {let p=x_bytes(2) as ptr<uint16>; p[0]=uint16(x & 65535)}
b24=(x:XWord):>void=>$unsafe {
    let p=x_bytes(3)
    let words=p as ptr<uint16>
    words[0]=uint16(x & 65535)
    p[2]=uint8((x >> 16) & 255)
}
b32=(x:XWord):>void=>$unsafe {let p=x_bytes(4) as ptr<uint32>; p[0]=uint32(x & 0xFFFFFFFF)}
b64=(x:XWord):>void=>$unsafe {let p=x_bytes(8) as ptr<XWord>; p[0]=x}
patch32=(pos:XWord v:XWord):>void=>$unsafe {
    if pos <? 0 or pos >? XWord(x_code[0].length) - 4 {panic("fixup outside code buffer")}
    let bytes=x_code[0].ptr
    let word=(bytes + pos) as ptr<uint32>
    word[0]=uint32(v & 0xFFFFFFFF)
}

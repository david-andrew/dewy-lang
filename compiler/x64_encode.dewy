$runtime_checks

# Complete native encoding operations; instruction selection stays in x64.jo.
# O(emitted bytes), with existing bounded branch-slot and address decisions.
XWord:type=int64<overflow='wrap'>
const RAX = 0
const RCX = 1
const RDX = 2
const RBX = 3
const RSP = 4
const RBP = 5
const RSI = 6
const RDI = 7
const R8 = 8
const R9 = 9
const R10 = 10
const R11 = 11
const RIPREL = 99
const XMM = 16
const VX = 4
const VY = 5
let frame_size:XWord=0
let x_pad_track:bool=false
let x_pad0:XWord=-1
let x_pad1:XWord=-1
let x_pad2:XWord=-1
let x_abs_at1:XWord=0
let x_abs_d1:XWord=0
let x_abs_at2:XWord=0
let x_abs_d2:XWord=0
let x_code:ptr<array<uint8>>=$unsafe (uint64(0) as ptr<array<uint8>>)
let x_data_fix:ptr<array<[int64 int64 int64]>>=$unsafe (uint64(0) as ptr<array<[int64 int64 int64]>>)
x64_encoder_bind=(output:ptr<array<uint8>> fixups:ptr<array<[int64 int64 int64]>>):>XWord=>$unsafe {
    x_code = output
    x_data_fix = fixups
    0
}
let rip_kind:XWord=0
let cur_index:XWord=-1
let cur_scale:XWord=0
use_index=(ix:XWord scale:XWord):>void=>$unsafe {
    cur_index = ix
    cur_scale = scale
}
indexed_base=(base:XWord disp:XWord imm:XWord):>[int64 int64]=>$unsafe {
    if base not=? RIPREL {
        return [base  disp]
    }
    rel_fixup_lea(RCX  rip_kind  disp - imm)
    [RCX  imm]
}
rex=(w:bool r:XWord x:XWord bb0:XWord force:bool):>void=>$unsafe {
    let bb=bb0
    if bb =? RIPREL {
        bb = 0
    }
    let v:XWord=0x40
    if w {
        v |= 8
    }
    if r & 8 not=? 0 {
        v |= 4
    }
    if x & 8 not=? 0 or (cur_index >=? 0 and cur_index & 8 not=? 0) {
        v |= 2
    }
    if bb & 8 not=? 0 {
        v |= 1
    }
    if v not=? 0x40 or force {
        b(v)
    }
}
let rsp_frame = false
let rsp_extra:XWord=0
mem=(reg:XWord base0:XWord disp0:XWord):>void=>$unsafe {
    let base=base0
    let disp=disp0
    if rsp_frame and base =? RBP {
        base = RSP
        disp += frame_size + rsp_extra
    }
    let r=reg & 7
    if cur_index >=? 0 {
        let sib=(cur_scale << 6) | ((cur_index & 7) << 3) | (base & 7)
        if disp =? 0 and base & 7 not=? 5 {
            b16(((r << 3) | 4) | (sib << 8))
        }
        else if disp >=? -128 and disp <=? 127 {
            b24((0x40 | (r << 3) | 4) | (sib << 8) | ((disp & 255) << 16))
        }
        else {
            let p=x_bytes(6)
            p[0]=uint8(0x80 | (r << 3) | 4)
            p[1]=uint8(sib)
            let q=(p + 2) as ptr<uint32>
            q[0]=uint32(disp & 0xFFFFFFFF)
        }
        return
    }
    if base =? RIPREL {
        let p=x_bytes(5)
        p[0]=uint8((r << 3) | 5)
        let q=(p + 1) as ptr<uint32>
        q[0]=uint32(0)
        x_data_fix[0].push([XWord(x_code[0].length) - 4  rip_kind  disp])
        return
    }
    let bs=base & 7
    if disp =? 0 and bs not=? 5 {
        if bs =? 4 {
            b16(((r << 3) | 4) | 0x2400)
        }
        else {
            b((r << 3) | bs)
        }
    }
    else if disp >=? -128 and disp <=? 127 {
        if bs =? 4 {
            b24((0x40 | (r << 3) | 4) | 0x2400 | ((disp & 255) << 16))
        }
        else {
            b16((0x40 | (r << 3) | bs) | ((disp & 255) << 8))
        }
    }
    else {
        if bs =? 4 {
            let p=x_bytes(6)
            p[0]=uint8(0x80 | (r << 3) | 4)
            p[1]=uint8(0x24)
            let q=(p + 2) as ptr<uint32>
            q[0]=uint32(disp & 0xFFFFFFFF)
        }
        else {
            let p=x_bytes(5)
            p[0]=uint8(0x80 | (r << 3) | bs)
            let q=(p + 1) as ptr<uint32>
            q[0]=uint32(disp & 0xFFFFFFFF)
        }
    }
}
modrr=(reg:XWord rm:XWord):>void=>$unsafe {
    b(0xC0 | ((reg & 7) << 3) | (rm & 7))
}
op_rm=(opc:XWord w:bool reg:XWord base0:XWord disp0:XWord):>void=>$unsafe {
    let base=base0
    let disp=disp0
    if rsp_frame and base =? RBP {
        base = RSP
        disp += frame_size + rsp_extra
    }
    let r=reg & 7
    let pfx_base:XWord=0x40 | (if w {8} else {0}) | ((reg >> 1) & 4)
    if cur_index <? 0 and base not=? RIPREL {
        let prefix:XWord=pfx_base | ((base >> 3) & 1)
        let has_rex:XWord=if prefix not=? 0x40 {1} else {0}
        let bs=base & 7
        let has_sib:XWord=if bs =? 4 {1} else {0}
        let dmode:XWord=if disp =? 0 and bs not=? 5 {0} else if disp >=? -128 and disp <=? 127 {1} else {4}
        let need=has_rex + 2 + has_sib + dmode
        let header=x_hdr
        let p:ptr<uint8>=if header not=? (uint64(0) as ptr<XWord>) and header[1] + need <=? header[2] {
            let old=header[1]
            header[1]=old + need
            (header as ptr<uint8>) + 24 + old
        } else {x_bytes_grow(need)}
        p[0]=uint8<overflow='wrap'>(prefix)
        let q=p + has_rex
        q[0]=uint8<overflow='wrap'>(opc)
        if dmode =? 0 {
            q[1]=uint8<overflow='wrap'>((r << 3) | bs)
            if has_sib not=? 0 {q[2]=0x24}
        } else if dmode =? 1 {
            q[1]=uint8<overflow='wrap'>(0x40 | (r << 3) | bs)
            if has_sib =? 0 {q[2]=uint8<overflow='wrap'>(disp)}
            else {q[2]=0x24; q[3]=uint8<overflow='wrap'>(disp)}
        } else {
            q[1]=uint8<overflow='wrap'>(0x80 | (r << 3) | bs)
            if has_sib =? 0 {
                let dw=(q + 2) as ptr<uint32>
                dw[0]=uint32<overflow='wrap'>(disp)
            } else {
                q[2]=0x24
                let dw=(q + 3) as ptr<uint32>
                dw[0]=uint32<overflow='wrap'>(disp)
            }
        }
        if x_pad_track {
            let end_=XWord(x_code[0].length)
            x_pad0=x_pad1; x_pad1=x_pad2; x_pad2=(end_ << 32) | (end_ - need)
        }
        return
    }
    let start=if x_pad_track {XWord(x_code[0].length)} else {0}
    rex(w  reg  0  base0  false)
    b(opc)
    mem(reg  base0  disp0)
    if x_pad_track and base0 not=? RIPREL {x_pad_record(start  XWord(x_code[0].length))}
}
op_rr=(opc:XWord w:bool reg:XWord rm:XWord):>void=>$unsafe {
    # One reservation for the complete register encoding. Keep rex's indexed
    # flag behavior even when the caller has left an address index selected.
    let header=x_hdr
    if header =? (uint64(0) as ptr<XWord>) or header[1] + 3 >? header[2] {header=x_grow(3)}
    let prefix:XWord=0x40 | (if w {8} else {0}) | ((reg >> 1) & 4) | (if rm not=? RIPREL {(rm >> 3) & 1} else {0})
    if cur_index >=? 0 and cur_index & 8 not=? 0 {prefix |= 2}
    let modrm=0xC0 | ((reg & 7) << 3) | (rm & 7)
    let has_rex:XWord=if prefix not=? 0x40 {1} else {0}
    let old=header[1]
    let end_=old + has_rex + 2
    header[1]=end_
    let p=(header as ptr<uint8>) + 24 + old
    p[0]=uint8<overflow='wrap'>(prefix)
    let q=p + has_rex
    q[0]=uint8<overflow='wrap'>(opc)
    q[1]=uint8<overflow='wrap'>(modrm)
    if x_pad_track {x_pad0=x_pad1; x_pad1=x_pad2; x_pad2=(end_ << 32) | old}
}
op_rm64_slow=(opc:XWord reg:XWord base0:XWord disp0:XWord):>void=>$unsafe {
    op_rm(opc  true  reg  base0  disp0)
}
op_rm64=(opc:XWord reg:XWord base0:XWord disp0:XWord):>void=>$unsafe {
    let header=x_hdr
    if cur_index >=? 0 or base0 =? RIPREL or header =? (uint64(0) as ptr<XWord>) or header[1] + 9 >? header[2] {
        op_rm64_slow(opc reg base0 disp0)
        return
    }
    let old=header[1]
    let p=(header as ptr<uint8>) + 24 + old
    if base0 =? RBP and not rsp_frame and not x_pad_track and disp0 >=? -128 and disp0 <=? 127 {
        let w:XWord=(0x48 | ((reg >> 1) & 4)) | (opc << 8) | ((0x45 | ((reg & 7) << 3)) << 16) | ((disp0 & 0xFF) << 24)
        let dw=p as ptr<uint32>
        dw[0]=uint32<overflow='wrap'>(w)
        header[1]=old + 4
        return
    }
    let base=base0
    let disp=disp0
    if rsp_frame and base =? RBP {
        base = RSP
        disp += frame_size
        disp += rsp_extra
    }
    p[1]=uint8<overflow='wrap'>(opc)
    let prefix:XWord=0x48 | ((reg >> 1) & 4)
    p[0]=uint8<overflow='wrap'>(prefix | ((base >> 3) & 1))
    let bs=base & 7
    let rm=((reg & 7) << 3) | bs
    let end_:XWord=old
    if disp =? 0 and bs not=? 5 {
        p[2]=uint8<overflow='wrap'>(rm)
        if bs =? 4 {p[3]=0x24; end_=old + 4}
        else {end_=old + 3}
    } else if disp >=? -128 and disp <=? 127 {
        p[2]=uint8<overflow='wrap'>(0x40 | rm)
        if bs =? 4 {p[3]=0x24; p[4]=uint8<overflow='wrap'>(disp); end_=old + 5}
        else {p[3]=uint8<overflow='wrap'>(disp); end_=old + 4}
    } else {
        p[2]=uint8<overflow='wrap'>(0x80 | rm)
        if bs =? 4 {
            p[3]=0x24
            let dw=(p + 4) as ptr<uint32>
            dw[0]=uint32<overflow='wrap'>(disp)
            end_=old + 8
        } else {
            let dw=(p + 3) as ptr<uint32>
            dw[0]=uint32<overflow='wrap'>(disp)
            end_=old + 7
        }
    }
    header[1]=end_
    if x_pad_track {x_pad0=x_pad1; x_pad1=x_pad2; x_pad2=(end_ << 32) | old}
}
mov_rm=(r:XWord base:XWord disp:XWord):>void=>$unsafe {
    op_rm64(0x8B  r  base  disp)
}
mov_mr=(base:XWord disp:XWord r:XWord):>void=>$unsafe {
    op_rm64(0x89  r  base  disp)
}
mov_rr=(d:XWord s:XWord):>void=>$unsafe {
    let header=x_hdr
    if header =? (uint64(0) as ptr<XWord>) or header[1] + 3 >? header[2] {header=x_grow(3)}
    let prefix:XWord=0x48 | ((s >> 1) & 4) | ((d >> 3) & 1) | (if cur_index >=? 0 and cur_index & 8 not=? 0 {2} else {0})
    let old=header[1]
    let end_=old + 3
    header[1]=end_
    let p=(header as ptr<uint8>) + 24 + old
    p[0]=uint8<overflow='wrap'>(prefix)
    p[1]=0x89
    p[2]=uint8<overflow='wrap'>(0xC0 | ((s & 7) << 3) | (d & 7))
    if x_pad_track {x_pad0=x_pad1; x_pad1=x_pad2; x_pad2=(end_ << 32) | old}
}
lea=(r:XWord base:XWord disp:XWord):>void=>$unsafe {
    op_rm64(0x8D  r  base  disp)
}
mov_imm=(r:XWord v:XWord):>void=>$unsafe {
    let header=x_hdr
    if header =? (uint64(0) as ptr<XWord>) or header[1] + 10 >? header[2] {header=x_grow(10)}
    let rx:XWord=if cur_index >=? 0 and cur_index & 8 not=? 0 {2} else {0}
    let old=header[1]
    let p=(header as ptr<uint8>) + 24 + old
    if v >=? 0 and v <=? 0xFFFFFFFF {
        let rb:XWord=((r >> 3) & 1) | rx
        if rb not=? 0 {
            header[1]=old + 6
            p[0]=uint8<overflow='wrap'>(0x40 | rb)
            p[1]=uint8<overflow='wrap'>(0xB8 + (r & 7))
            let q=(p + 2) as ptr<uint32>
            q[0]=uint32<overflow='wrap'>(v)
        }
        else {
            header[1]=old + 5
            p[0]=uint8<overflow='wrap'>(0xB8 + (r & 7))
            let q=(p + 1) as ptr<uint32>
            q[0]=uint32<overflow='wrap'>(v)
        }
    }
    else if v >=? -2147483648 and v <=? 2147483647 {
        header[1]=old + 7
        p[0]=uint8<overflow='wrap'>(0x48 | ((r >> 3) & 1) | rx)
        p[1]=0xC7
        p[2]=uint8<overflow='wrap'>(0xC0 | (r & 7))
        let q=(p + 3) as ptr<uint32>
        q[0]=uint32<overflow='wrap'>(v)
    }
    else {
        header[1]=old + 10
        p[0]=uint8<overflow='wrap'>(0x48 | ((r >> 3) & 1) | rx)
        p[1]=uint8<overflow='wrap'>(0xB8 + (r & 7))
        let q=(p + 2) as ptr<XWord>
        q[0]=v
    }
    if x_pad_track {x_pad0=x_pad1; x_pad1=x_pad2; x_pad2=(header[1] << 32) | old}
}
load_sized=(r:XWord base:XWord disp:XWord size:XWord signed:bool):>void=>$unsafe {
    if size =? 8 {
        mov_rm(r  base  disp)
    }
    else if size =? 4 {
        if signed {
            op_rm(0x63  true  r  base  disp)
        }
        else {
            op_rm(0x8B  false  r  base  disp)
        }
    }
    else if size =? 2 {
        let st=XWord(x_code[0].length)
        rex(true  r  0  base  false)
        b(0x0F)
        if signed {
            b(0xBF)
        }
        else {
            b(0xB7)
        }
        mem(r  base  disp)
        if x_pad_track and base not=? RIPREL {x_pad_record(st XWord(x_code[0].length))}
    }
    else {
        let st=XWord(x_code[0].length)
        rex(true  r  0  base  false)
        b(0x0F)
        if signed {
            b(0xBE)
        }
        else {
            b(0xB6)
        }
        mem(r  base  disp)
        if x_pad_track and base not=? RIPREL {x_pad_record(st XWord(x_code[0].length))}
    }
}
store_sized=(base:XWord disp:XWord r:XWord size:XWord):>void=>$unsafe {
    if size =? 8 {
        mov_mr(base  disp  r)
    }
    else if size =? 4 {
        op_rm(0x89  false  r  base  disp)
    }
    else if size =? 2 {
        b(0x66)
        op_rm(0x89  false  r  base  disp)
        x_pad2=-1
    }
    else {
        rex(false  r  0  base  r >=? 4)
        b(0x88)
        mem(r  base  disp)
    }
}
sse_rm_slow=(prefix:XWord opc:XWord x:XWord base0:XWord disp0:XWord):>void=>$unsafe {
    if prefix not=? 0 {b(prefix)}
    rex(false  x  0  base0  false)
    b(0x0F)
    b(opc)
    mem(x  base0  disp0)
}
sse_rm=(prefix:XWord opc:XWord x:XWord base0:XWord disp0:XWord):>void=>$unsafe {
    let header=x_hdr
    if cur_index >=? 0 or base0 =? RIPREL or header =? (uint64(0) as ptr<XWord>) or header[1] + 11 >? header[2] {
        sse_rm_slow(prefix opc x base0 disp0)
        return
    }
    let base=base0
    let disp=disp0
    if rsp_frame and base =? RBP {
        base = RSP
        disp += frame_size + rsp_extra
    }
    let q=(header as ptr<uint8>) + 24 + header[1]
    if prefix not=? 0 {q[0]=uint8<overflow='wrap'>(prefix); q=q + 1}
    let rv:XWord=0x40 | ((x >> 1) & 4) | ((base >> 3) & 1)
    if rv not=? 0x40 {q[0]=uint8<overflow='wrap'>(rv); q=q + 1}
    q[0]=0x0F
    q[1]=uint8<overflow='wrap'>(opc)
    let bs=base & 7
    let rm=((x & 7) << 3) | bs
    if disp =? 0 and bs not=? 5 {
        q[2]=uint8<overflow='wrap'>(rm)
        if bs =? 4 {q[3]=0x24; q=q + 4}
        else {q=q + 3}
    } else if disp >=? -128 and disp <=? 127 {
        q[2]=uint8<overflow='wrap'>(0x40 | rm)
        if bs =? 4 {q[3]=0x24; q[4]=uint8<overflow='wrap'>(disp); q=q + 5}
        else {q[3]=uint8<overflow='wrap'>(disp); q=q + 4}
    } else {
        q[2]=uint8<overflow='wrap'>(0x80 | rm)
        if bs =? 4 {
            q[3]=0x24
            let dw=(q + 4) as ptr<uint32>
            dw[0]=uint32<overflow='wrap'>(disp)
            q=q + 8
        } else {
            let dw=(q + 3) as ptr<uint32>
            dw[0]=uint32<overflow='wrap'>(disp)
            q=q + 7
        }
    }
    header[1]=(q as int64) - (((header as ptr<uint8>) + 24) as int64)
}
sse_rr=(prefix:XWord opc:XWord x:XWord y:XWord):>void=>$unsafe {
    let header=x_hdr
    if header =? (uint64(0) as ptr<XWord>) or header[1] + 5 >? header[2] {header=x_grow(5)}
    let rv:XWord=0x40 | ((x >> 1) & 4) | (if y not=? RIPREL {(y >> 3) & 1} else {0})
    if cur_index >=? 0 and cur_index & 8 not=? 0 {rv |= 2}
    let has_pre:XWord=if prefix not=? 0 {1} else {0}
    let has_rex:XWord=if rv not=? 0x40 {1} else {0}
    let old=header[1]
    header[1]=old + has_pre + has_rex + 3
    let p=(header as ptr<uint8>) + 24 + old
    let o:XWord=0
    if has_pre not=? 0 {p[0]=uint8<overflow='wrap'>(prefix); o=1}
    if has_rex not=? 0 {p[o]=uint8<overflow='wrap'>(rv); o+=1}
    let q=p + o
    q[0]=0x0F
    q[1]=uint8<overflow='wrap'>(opc)
    q[2]=uint8<overflow='wrap'>(0xC0 | ((x & 7) << 3) | (y & 7))
}
is_vreg_vec=(ty:XWord):>bool=>$unsafe {
    ty =? VX or ty =? VY
}
vex=(reg:XWord vvvv:XWord rm:XWord map:XWord pp:XWord w:XWord l:XWord):>void=>$unsafe {
    let rb=rm
    if rb =? RIPREL {
        rb = 0
    }
    let x:XWord=0
    if cur_index >=? 0 and cur_index & 8 not=? 0 {
        x = 1
    }
    let b1=((1 - ((reg >> 3) & 1)) << 7) | ((1 - x) << 6) | ((1 - ((rb >> 3) & 1)) << 5) | map
    let b2=(w << 7) | ((15 - (vvvv & 15)) << 3) | (l << 2) | pp
    b24(0xC4 | (b1 << 8) | (b2 << 16))
}
vmov_rr=(x:XWord y:XWord ty:XWord):>void=>$unsafe {
    if x =? y {
        return
    }
    if ty =? VY {
        vex(x  0  y  1  0  0  1)
        b(0x28)
        modrr(x  y)
    }
    else {
        sse_rr(0  0x28  x  y)
    }
}
vmov_rm=(x:XWord base:XWord disp:XWord ty:XWord):>void=>$unsafe {
    if ty =? VY {
        vex(x  0  base  1  0  0  1)
        b(0x10)
        mem(x  base  disp)
    }
    else {
        sse_rm(0  0x10  x  base  disp)
    }
}
vmov_mr=(base:XWord disp:XWord x:XWord ty:XWord):>void=>$unsafe {
    if ty =? VY {
        vex(x  0  base  1  0  0  1)
        b(0x11)
        mem(x  base  disp)
    }
    else {
        sse_rm(0  0x11  x  base  disp)
    }
}
vec_esize=(k:XWord):>XWord=>$unsafe {
    if k =? 0 or k =? 2 {
        return 4
    }
    8
}
jmp32=():>XWord=>$unsafe {
    let p=x_bytes(5)
    p[0]=0xE9
    let q=(p + 1) as ptr<uint32>
    q[0]=uint32(0)
    XWord(x_code[0].length) - 4
}
jcc32=(cc:XWord):>XWord=>$unsafe {
    let p=x_bytes(6)
    p[0]=0x0F
    p[1]=uint8(0x80 + cc)
    let q=(p + 2) as ptr<uint32>
    q[0]=uint32(0)
    XWord(x_code[0].length) - 4
}
patch_branch=(pos:XWord target:XWord):>void=>$unsafe {
    let bytes=x_code[0].ptr
    let delta=target - pos
    if bytes[pos - 1] =? 0xE9 {
        let offset=(pos - 1) & 31
        let pad:XWord=if offset >=? 30 {32 - offset} else {0}
        let short=delta - 1 - pad
        if offset >=? 27 and short >=? -128 and short <=? 127 {
            if pad =? 1 {
                bytes[pos - 1] = 0x90
            }
            else if pad =? 2 {
                bytes[pos - 1] = 0x66
                bytes[pos] = 0x90
            }
            bytes[pos - 1 + pad] = 0xEB
            bytes[pos + pad] = uint8((short & 255) & 255)
            if pad =? 0 {
                bytes[pos + 1] = 0x0F
                bytes[pos + 2] = 0x1F
                bytes[pos + 3] = 0
            }
            else if pad =? 1 {
                bytes[pos + 2] = 0x66
                bytes[pos + 3] = 0x90
            }
            else {
                bytes[pos + 3] = 0x90
            }
        }
        else {
            patch32(pos  delta - 4)
        }
        return
    }
    let offset=(pos - 2) & 31
    let pad:XWord=if offset >=? 30 {32 - offset} else {0}
    let short=delta - pad
    if pos >=? 2 and offset >=? 26 and (offset <? 30 or delta <? 0) and short >=? -128 and short <=? 127 and bytes[pos - 2] =? 0x0F and bytes[pos - 1] >=? 0x80 and bytes[pos - 1] <=? 0x8F {
        let cc=bytes[pos - 1] - 0x10
        if pad =? 1 {
            bytes[pos - 2] = 0x90
        }
        else if pad =? 2 {
            bytes[pos - 2] = 0x66
            bytes[pos - 1] = 0x90
        }
        bytes[pos - 2 + pad] = cc
        bytes[pos - 1 + pad] = uint8((short & 255) & 255)
        if pad =? 0 {
            patch32(pos  0x00401F0F)
        }
        else if pad =? 1 {
            bytes[pos + 1] = 0x0F
            bytes[pos + 2] = 0x1F
            bytes[pos + 3] = 0
        }
        else {
            bytes[pos + 2] = 0x66
            bytes[pos + 3] = 0x90
        }
        let next=pos + 4
        if next + 1 <? XWord(x_code[0].length) and bytes[next] & 0xF0 =? 0x40 {
            let op=XWord(bytes[next + 1])
            if op =? 0x89 or op =? 0x8B or op =? 0x8D or op =? 0x85 or (op <? 0x40 and (op & 7 =? 1 or op & 7 =? 3)) or (op >=? 0xB8 and op <=? 0xBF) or ((op =? 0x81 or op =? 0x83 or op =? 0xC7) and next + 2 <? XWord(x_code[0].length) and bytes[next + 2] >=? 0xC0) {
                loop i in [pos + pad..pos + 4) {
                    bytes[i] = 0x2E
                }
            }
        }
    }
    else {
        patch32(pos  delta - 4)
    }
}
let x_padding_floor:XWord=0
let x_padding_cmov:XWord=-1
x_pad_record=(start:XWord end_:XWord):>void=>$unsafe {
    x_pad0=x_pad1
    x_pad1=x_pad2
    x_pad2=(end_ << 32) | start
}
x_pad_ok=(b0:uint8):>bool=>((b0 & 0xF0) =? 0x40) or (b0 >=? 0xB8 and b0 <=? 0xBF) or b0 =? 0x89 or b0 =? 0x8B or b0 =? 0x8D or b0 =? 0x0F or b0 =? 0x63 or b0 =? 0x81 or b0 =? 0x83 or b0 =? 0xC1 or b0 =? 0xC7 or b0 =? 0x01 or b0 =? 0x29 or b0 =? 0x21 or b0 =? 0x09 or b0 =? 0x31
x_shift_pad=(base:ptr<uint8> lo:XWord hi:XWord shift:XWord pad_at:XWord pad_n:XWord):>void=>$unsafe {
    let i=hi - 1
    loop i >=? lo {base[i + shift]=base[i]; i -= 1}
    loop j in [0..pad_n) {base[pad_at + j]=0x2E}
}
x_absorb_recent=(padding:XWord):>bool=>$unsafe {
    if padding <=? 0 or padding >? 15 {return false}
    let cur=XWord(x_code[0].length)
    let p2=x_pad2
    let end2=p2 >> 32
    let at2=p2 & 0xFFFFFFFF
    if end2 not=? cur or at2 <? x_padding_floor {return false}
    let p0=x_code[0].ptr
    let w2=end2 - at2
    if w2 <? 2 or w2 >? 11 or not x_pad_ok(p0[at2]) {return false}
    let cap2=min(6 15 - w2)
    if padding <=? cap2 {
        x_bytes(padding);
        x_shift_pad(x_code[0].ptr at2 end2 padding at2 padding)
        x_pad0=-1; x_pad1=-1; x_pad2=-1
        x_abs_d1=0; x_abs_d2=0
        return true
    }
    let p1=x_pad1
    let end1=p1 >> 32
    let at1=p1 & 0xFFFFFFFF
    if end1 not=? at2 or at1 <? x_padding_floor {return false}
    let w1=end1 - at1
    if w1 <? 2 or w1 >? 11 or not x_pad_ok(p0[at1]) {return false}
    let cap1=min(6 15 - w1)
    if padding <=? cap1 + cap2 {
        let n2=min(cap2 padding)
        let n1=padding - n2
        x_bytes(padding);
        let base=x_code[0].ptr
        x_shift_pad(base at2 end2 padding at2 + n1 n2)
        x_shift_pad(base at1 at2 n1 at1 n1)
        x_pad0=-1; x_pad1=-1; x_pad2=-1
        x_abs_d1=0; x_abs_at2=at2; x_abs_d2=n1
        return true
    }
    let q0=x_pad0
    let end0=q0 >> 32
    let at0=q0 & 0xFFFFFFFF
    if end0 not=? at1 or at0 <? x_padding_floor {return false}
    let w0=end0 - at0
    if w0 <? 2 or w0 >? 11 or not x_pad_ok(p0[at0]) {return false}
    let cap0=min(6 15 - w0)
    if padding >? cap0 + cap1 + cap2 {return false}
    let n2=min(cap2 padding)
    let rem=padding - n2
    let n1=min(cap1 rem)
    let n0=rem - n1
    x_bytes(padding);
    let base=x_code[0].ptr
    x_shift_pad(base at2 end2 padding at2 + n0 + n1 n2)
    x_shift_pad(base at1 at2 n0 + n1 at1 + n0 n1)
    x_shift_pad(base at0 at1 n0 at0 n0)
    x_pad0=-1; x_pad1=-1; x_pad2=-1
    x_abs_at1=at1; x_abs_d1=n0; x_abs_at2=at2; x_abs_d2=n0 + n1
    true
}
patch_here=(pos:XWord):>void=>$unsafe {
    x_padding_floor = XWord(x_code[0].length)
    patch_branch(pos  XWord(x_code[0].length))
}
patch_rel_here=(pos:XWord base:XWord):>void=>$unsafe {
    x_padding_floor = XWord(x_code[0].length)
    patch32(pos  x_padding_floor - base)
}
jmp_back=(target:XWord):>void=>$unsafe {
    let pos=jmp32()
    patch_branch(pos  target)
}
const CC_E = 4
const CC_NE = 5
const CC_L = 0xC
const CC_GE = 0xD
const CC_LE = 0xE
const CC_G = 0xF
const CC_B = 2
const CC_AE = 3
const CC_BE = 6
const CC_A = 7
const CC_P = 0xA
const CC_NP = 0xB
nop_pad=(n0:XWord):>void=>$unsafe {
    let n=n0
    loop n >? 0 {
        let k=min(n  15)
        let p=x_bytes(k)
        if k >? 9 {
            let pre=k - 8
            loop i in [0..pre) {p[i]=0x66}
            let q=(p + pre) as ptr<uint64>
            q[0]=uint64(0x0000000000841F0F)
        }
        else if k =? 8 {
            let q=p as ptr<uint64>
            q[0]=uint64(0x0000000000841F0F)
        }
        else if k =? 9 {
            p[0]=0x66
            let q=(p + 1) as ptr<uint64>
            q[0]=uint64(0x0000000000841F0F)
        }
        else if k =? 4 {
            let q=p as ptr<uint32>
            q[0]=uint32(0x00401F0F)
        }
        else if k =? 5 {
            let q=p as ptr<uint32>
            q[0]=uint32(0x00441F0F)
            p[4]=0x00
        }
        else if k =? 6 {
            let q=p as ptr<uint32>
            q[0]=uint32(0x441F0F66)
            let q2=(p + 4) as ptr<uint16>
            q2[0]=uint16(0)
        }
        else if k =? 7 {
            let q=p as ptr<uint32>
            q[0]=uint32(0x00801F0F)
            let q2=(p + 4) as ptr<uint16>
            q2[0]=uint16(0)
            p[6]=0x00
        }
        else if k =? 3 {
            let q=p as ptr<uint16>
            q[0]=uint16(0x1F0F)
            p[2]=0x00
        }
        else if k =? 2 {
            let q=p as ptr<uint16>
            q[0]=uint16(0x9066)
        }
        else {
            p[0]=0x90
        }
        n -= k
    }
}
setcc=(cc:XWord):>void=>$unsafe {
    let p=x_bytes(6)
    p[0]=0x0F
    p[1]=uint8(0x90 + cc)
    p[2]=0xC0
    p[3]=0x0F
    p[4]=0xB6
    p[5]=0xC0
}
setcc_reg=(cc:XWord r:XWord):>void=>$unsafe {
    let rm=r & 7
    let rx:XWord=if cur_index >=? 0 and cur_index & 8 not=? 0 {2} else {0}
    if r >=? 4 or rx not=? 0 {
        let p=x_bytes(8)
        let rb:XWord=(r >> 3) & 1
        p[0]=uint8(0x40 | rb | rx)
        p[1]=0x0F
        p[2]=uint8(0x90 + cc)
        p[3]=uint8(0xC0 | rm)
        p[4]=uint8(0x40 | (rb << 2) | rb | rx)
        p[5]=0x0F
        p[6]=0xB6
        p[7]=uint8(0xC0 | (rm << 3) | rm)
    }
    else {
        let p=x_bytes(6)
        p[0]=0x0F
        p[1]=uint8(0x90 + cc)
        p[2]=uint8(0xC0 | rm)
        p[3]=0x0F
        p[4]=0xB6
        p[5]=uint8(0xC0 | (rm << 3) | rm)
    }
}
rel_fixup_lea=(r:XWord kind:XWord off:XWord):>void=>$unsafe {
    let rx:XWord=if cur_index >=? 0 and cur_index & 8 not=? 0 {2} else {0}
    let p=x_bytes(7)
    p[0]=uint8(0x48 | ((r >> 1) & 4) | rx)
    p[1]=0x8D
    p[2]=uint8(((r & 7) << 3) | 5)
    let q=(p + 3) as ptr<uint32>
    q[0]=uint32(0)
    x_data_fix[0].push([XWord(x_code[0].length) - 4  kind  off])
}

let x_hdr:ptr<XWord>=$unsafe (uint64(0) as ptr<XWord>)
x_encode_begin=(est:XWord=64):>void=>$unsafe {
    let need=if est >? 64 {est} else {64}
    let h=x_hdr
    if h =? (uint64(0) as ptr<XWord>) {h=(x_code as ptr<ptr<XWord>>)[0]}
    if h =? (uint64(0) as ptr<XWord>) or h[0] not=? 1 or h[1] + need >? h[2] {
        let old=XWord(x_code[0].length)
        let target_cap:XWord=max(old + need 65536)
        x_code[0].reserve(target_cap)
        h=(x_code as ptr<ptr<XWord>>)[0]
    }
    x_hdr=h
    x_pad_track=false
    x_pad0=-1
    x_pad1=-1
    x_pad2=-1
}
x_encode_end=():>void=>$unsafe {
    x_hdr=uint64(0) as ptr<XWord>
}
x_grow=(need:XWord):>ptr<XWord>=>$unsafe {
    let old=XWord(x_code[0].length)
    let h=(x_code as ptr<ptr<XWord>>)[0]
    if h =? (uint64(0) as ptr<XWord>) or h[0] not=? 1 or old + need >? h[2] {
        x_code[0].reserve(max(old + need if h not=? (uint64(0) as ptr<XWord>) {h[2] + 1} else {64}))
        h=(x_code as ptr<ptr<XWord>>)[0]
    }
    if x_hdr not=? (uint64(0) as ptr<XWord>) {x_hdr=h}
    h
}
# Borrow the stable output-array variable. Keep the fast path small and free of
# slow-path reserve calls so byte encoders inline into instruction emitters.
x_bytes_grow=(n:XWord):>ptr<uint8>=>$unsafe {
    let old=XWord(x_code[0].length)
    x_code[0].reserve(old + n)
    let slot=x_code as ptr<ptr<XWord>>
    let header=slot[0]
    header[1]=old + n
    if x_hdr not=? (uint64(0) as ptr<XWord>) {x_hdr=header}
    (header as ptr<uint8>) + 24 + old
}
x_b_grow=(x:XWord):>void=>$unsafe {
    let p=x_bytes_grow(1)
    p[0]=uint8<overflow='wrap'>(x)
}
x_bytes=(n:XWord):>ptr<uint8>=>$unsafe {
    let header=x_hdr
    if header not=? (uint64(0) as ptr<XWord>) {
        let old=header[1]
        if old + n <=? header[2] {
            header[1]=old + n
            return (header as ptr<uint8>) + 24 + old
        }
    }
    x_bytes_grow(n)
}
b=(x:XWord):>void=>$unsafe {
    let header=x_hdr
    if header not=? (uint64(0) as ptr<XWord>) {
        let old=header[1]
        if old <? header[2] {
            header[1]=old + 1
            let p=header as ptr<uint8>
            p[24 + old]=uint8<overflow='wrap'>(x)
            return
        }
    }
    x_b_grow(x)
}
b16=(x:XWord):>void=>$unsafe {let p=x_bytes(2) as ptr<uint16>; p[0]=uint16(x & 65535)}
b24=(x:XWord):>void=>$unsafe {
    let p=x_bytes(3)
    let words=p as ptr<uint16>
    words[0]=uint16(x & 65535)
    p[2]=uint8((x >> 16) & 255)
}
b32=(x:XWord):>void=>$unsafe {let p=x_bytes(4) as ptr<uint32>; p[0]=uint32(x & 0xFFFFFFFF)}
b64=(x:XWord):>void=>$unsafe {let p=x_bytes(8) as ptr<XWord>; p[0]=x}
patch32=(pos:XWord v:XWord):>void=>$unsafe {
    let header=x_hdr
    if header not=? (uint64(0) as ptr<XWord>) {
        if pos <? 0 or pos >? header[1] - 4 {panic("fixup outside x_code[0] buffer")}
        let word=((header as ptr<uint8>) + 24 + pos) as ptr<uint32>
        word[0]=uint32<overflow='wrap'>(v)
        return
    }
    if pos <? 0 or pos >? XWord(x_code[0].length) - 4 {panic("fixup outside x_code[0] buffer")}
    let bytes=x_code[0].ptr
    let word=(bytes + pos) as ptr<uint32>
    word[0]=uint32(v & 0xFFFFFFFF)
}

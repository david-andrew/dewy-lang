# Constant arguments checked while compiling (docs/design/decisions.md: `regex(p)` returns
# `Regex | RegexError`, and a literal pattern is checked at compile time). A library function
# says `@check_constant(validator(param), "message")`: where a call gives `param` a compile-time
# constant string, `validator(argument)` runs at compile time (comptime.jo), the library's own
# code, not a copy of it. Text back is a compile error at the argument ("message: text"); none
# means the call cannot fail, so its result drops its exception members (a `Regex | RegexError`
# is a `Regex`). Any other argument leaves the call as it is.

struct CheckConstant:
    params: int[]       # the parameters checked, as the validator takes them
    validator: int      # the validator's declaration: (values) -> text?, none when they are fine
    message: str

cc_decls: {int: CheckConstant[]} = {}
cc_errors: {int: str} = {}      # declaration -> what `$error_if true` says at a call
cc_any = false

gen_lambda=(e:LGWord stack:bool=false):>Val=>$unsafe {
    let f:LGWord=LGWord(nodes.ptr[e].sym)
    let generic=has_flag(e NF_GENERIC)
    if generic {f=poly_families.ptr[LGWord(nodes.ptr[e].aux)].envfn}
    env_layout(f);
    loop capture in fns.ptr[f].caps {
        if LGWord(locals.ptr[LGWord(capture.inner)].flags) & LF_PARTBORROW not=? 0 {
            fatal(nodes.ptr[e].pos "mutable array parameter captures require a proven-disjoint scoped fork");
        }
    }
    if ownership_callable_cap(LGWord(fns.ptr[f].fntype)) >=? 3 and not stack {

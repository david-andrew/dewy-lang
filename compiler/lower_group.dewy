                let tm=union_members(to)[j]
                if not type_eq(tm m) {e_store(d to_off set_word_moved(e_load(VI src fo tsize(m)) m tm nodes.ptr[e].pos) tsize(tm));}
                else if tsize(m) >? 0 {e_copy(e_addi(d to_off) e_addi(src fo) tsize(m));}
            }
            endc();
        }
        return Val[d true s]
    }
    if cv =? CV.arr2fixed {
        let push=fact_fixed_comprehension(a to)
        if push not=? 0 {return gen_fixed_comprehension(a push to has_flag(e NF_INBOUNDS))}
        if copies_on {copy_components(e to "the fixed array contains heap payloads that must be copied");}
        # Check the shape once, then copy the value into inline storage.
        let src=gen_borrowed(a).v
        let n=fixed_len(to)
        if not has_flag(e NF_INBOUNDS) {
            iff(e_bin('ne' VI arr_len(src) e_iconst(n)));
            e_call_nr1(rt("__panic") e_daddr(str_data("fixed-size array needs {n} elements")) -1);
            endc();
        }
        let s=new_temp(to)
        let d=e_slot(s)
        if ownership_type(to) {
            let et=telem(to)
            let held:array<int64>=[]
            loop i in [0..n) {
                let ea=e_addi(src 24 + i * owner_stride(et))
                let value=own(Val[load_val(et ea 0) false -1] et)
                store_val(et d i * tsize(et) value.v);
                held.push(value.slot);
            }
            loop slot in held {owner_forget_slot(slot);}
            return Val[d true s]
        }
        e_copy(d e_addi(src 24) tsize(to));
        if is_managed(to) {copy_at(d to);}
        return Val[d true s]
    }
    if cv =? CV.fixed2arr {
        if copies_on {copy_components(e source_type "the array conversion duplicates heap payloads");}
        # a new array holding copies of the elements
        let et:LGWord=LGWord(types.ptr[source_type].elem)
        let esz=tsize(et)
        let n=fixed_len(source_type)
        let src=place_addr(gen_place(a false) source_type)
        if ownership_type(to) {return owner_array_from_fixed(src et n to)}
        let arr=vreg(VI)
        e_mov(arr e_call2(rt("__arr_filled") e_iconst(n) e_iconst(esz) VI));
        e_copy(e_addi(arr 24) src n * esz);
        if is_managed(et) {
            let i=vreg(VI)
            e_mov(i e_iconst(0));
            blk();
            lop();
            brif_to(e_bin('ges' VI i e_iconst(n)) ctl - 1);
            copy_at(e_bin('add' VI e_addi(arr 24) e_bin('mul' VI i e_iconst(esz))) et);
            e_mov(i e_addi(i 1));
            br_to(ctl);
            endc();
            endc();
        }
        return V(arr true)
    }
    if cv =? CV.opt {
        if math_optional(to) {
            let value=gen_owned(a)
            return V(e_bin('xor' VI value.v e_iconst(1)) true)
        }
        let inner:LGWord=LGWord(types.ptr[to].elem)
        let s=new_temp(to)
        let d=e_slot(s)
        e_zero(d tsize(to));
        let val=gen_owned(a)
        store_val(inner d 0 val.v);
        e_store(d tsize(inner) e_iconst(1) 1);
        if ownership_type(inner) {owner_forget_slot(val.slot);}
        return Val[d true s]
    }
    fatal(nodes.ptr[e].pos "invalid conversion");
    return V(-1 false)
}
gen_expr=(e:LGWord):>Val=>$unsafe {
    let value=gen_expr_value(e)
    if ff_checks_any {float_check(e value.v ntype(e));}
    if float_keys_any {float_key_check(e value.v ntype(e));}
    if ownership_type(ntype(e)) and value.owned {return owner_value(value ntype(e))}
    return value
}
gen_expr_value=(e:LGWord):>Val=>$unsafe {
    if exact_lower_active and exact_has_node(e) {return V(exact_low_word(e) false)}
    match nodes.ptr[e].kind {
        <'int_lit'> => {return gen_value_int_lit(e)}
        <'float_lit'> => {return gen_value_float_lit(e)}
        <'bool_lit'> => {return V(e_iconst(nodes.ptr[e].ival) false)}
        <'null_lit'> => {return V(e_iconst(0) false)}
        <'none_lit'> => {return gen_value_none_lit(e)}
        <'str_lit'> => {return gen_value_str_lit(e)}
        <'ident'> => {return gen_value_ident(e)}
        <'field'> => {return gen_value_field(e)}
        <'dotname'> => {return gen_value_dotname(e)}
        <'parallel_region'> => {return gen_expr(LGWord(nodes.ptr[e].a))}
        <'index'> => {return gen_value_index(e)}
        <'unwrap' | 'narrow'> => {return gen_value_unwrap(e)}
        <'istype'> => {return gen_value_istype(e)}
        <'call'> => {return gen_value_call(e)}
        <'intrinsic'> => {return gen_intrinsic(e)}
        <'partial'> => {return gen_partial(e)}
        <'lambda'> => {return gen_lambda(e)}
        <'fnref'> => {return gen_fnref(e)}
        <'unary'> => {return gen_value_unary(e)}
        <'not_'> => {return V(gen_not(LGWord(nodes.ptr[e].a)) false)}
        <'and_' | 'or_'> => {return gen_value_and_(e)}
        <'binary'> => {
            let value=gen_binary(e)
            if int_policy(ntype(e)) =? 1 {value.v = norm(value.v ntype(e));}
            return value
        }
        <'conv'> => {return gen_value_conv(e)}
        <'cast'> => {return gen_value_cast(e)}
        <'coalesce'> => {return gen_value_coalesce(e)}
        <'array'> => {return gen_value_array(e)}
        <'map_lit'> => {return gen_value_map_lit(e)}
        <'tuple'> => {return gen_value_tuple(e)}
        <'range'> => {return gen_value_range(e)}
        <'addr'> => {return gen_value_addr(e)}
        <'if_'> => {return gen_value_if_(e)}
        <'iflet'> => {return gen_value_iflet(e)}
        <'match_'> => {return gen_match(e not has_flag(e NF_STMT))}
        <'block'> => {return gen_value_block(e)}
        _ => {fatal(nodes.ptr[e].pos "unsupported expression in codegen ({nodes.ptr[e].kind})");}
    }
    return V(-1 false)
}
gen_value_str_lit=(e:LGWord):>Val=>$unsafe {
    if nodes.ptr[e].aux not=? 0 {return gen_interp(e)}
    let value=e_daddr(str_data(name_of(LGWord(nodes.ptr[e].sval))))
    if member_lower_active >=? 0 {member_lower_text(e value);}
    return V(value false)
}
gen_value_ident=(e:LGWord):>Val=>$unsafe {
    let t=prune(ntype(e))
    if t =? T_MATH_INT and nodes.ptr[e].aux =? LGI32(1) {
        let words=math_static_regs.get(LGWord(nodes.ptr[e].sym))
        if words not=? none {return exact_pack_words(e words)}
        let word=math_word_regs.get(LGWord(nodes.ptr[e].sym))
        if word not=? none {return math_pack_word(e word)}
        if math_word_captures.has(LGWord(nodes.ptr[e].sym)) {return math_pack_word(e read_place(local_place(LGWord(nodes.ptr[e].sym) false) T_INT))}
    }
    if nodes.ptr[e].aux =? LGI32(1) or nodes.ptr[e].aux =? LGI32(2) {
        let p=gen_place(e false)
        return V(read_place(p t) false)
    }
    if tkind(t) =? 'typeval' or tkind(t) =? 'module' {type_as_value(e);}
    fatal(nodes.ptr[e].pos "cannot generate identifier");
    return V(-1 false)
}
gen_value_field=(e:LGWord):>Val=>$unsafe {
    let t=prune(ntype(e))
    if nodes.ptr[e].aux =? -4 {return gen_swizzle(e)}
    let p=gen_place(e false)
    return V(read_place(p t) false)
}
gen_value_index=(e:LGWord):>Val=>$unsafe {
    let t=prune(ntype(e))
    let scalar=parallel_scalar_read(e)
    if scalar >=? 0 {return V(scalar false)}
    if nodes.ptr[e].aux =? 1 {return gen_slice(e)}
    let p=gen_place(e false)
    return V(read_place(p t) false)
}
gen_value_unwrap=(e:LGWord):>Val=>$unsafe {
    let t=prune(ntype(e))
    let p=gen_place(e false)
    return V(read_place(p t) false)
}
gen_value_istype=(e:LGWord):>Val=>$unsafe {
    let a:LGWord=LGWord(nodes.ptr[e].a)
    let at=prune(ntype(a))
    let vi:LGWord=LGWord(nodes.ptr[e].aux)
    if vi =? -3 {return V(e_iconst(1) false)}
    if nodes.ptr[e].aux2 not=? 0 {
        let has=gen_map_presence(a LGWord(nodes.ptr[e].aux2))
        if vi =? -1 {return V(e_bin('eq' VI has e_iconst(0)) false)}
        return V(has false)
    }
    if vi <? 0 {
        let view=held_opt_reg(a)
        if view >=? 0 {
            return V(e_bin((if vi =? -1 {Op.eq} else {Op.ne}) VI view e_iconst(0)) false)
        }
    }
    let p=gen_place(a false)
    let addr=place_addr(p at)
    if vi <? 0 {
        # optional: its has-value flag follows the value
        let has=opt_has(addr LGWord(types.ptr[at].elem))
        if vi =? -1 {return V(e_bin('eq' VI has e_iconst(0)) false)}
        return V(e_bin('ne' VI has e_iconst(0)) false)
    }
    layout(at);
    return V(e_bin('eq' VI e_load(VI addr 0 4) e_iconst(vi)) false)
}
gen_value_call=(e:LGWord):>Val=>$unsafe {
    let t=prune(ntype(e))
    # A guarded numeric map already proved every intermediate fits a word.
    # Keep min/max as a value select so its inlined branch does not extend
    # the live ranges of all the strided input cursors.
    if exact_map_active and exact_representation(t) =? T_INT and nkids(e) =? 2 and (fact_library_call(e "min") or fact_library_call(e "max")) {
        let a=gen_expr(kid(e 0)).v; let b=gen_expr(kid(e 1)).v
        let condition=e_bin('gts' VI a b)
        let result=vreg(VI)
        let maximum=fact_library_call(e "max")
        emit('select' VI result condition (if maximum {a} else {b}) (if maximum {b} else {a}) 0);
        return V(result false)
    # (a call that never comes back, as panic(...), where a value is wanted: "a" + panic("x"))
    }
    if t not=? T_NEVER and vc(t) not=? VC_VOID and LGWord(nodes.ptr[e].aux) =? 0 and nodes.ptr[e].sym >? 0 and prune(LGWord(fns.ptr[LGWord(nodes.ptr[e].sym)].ret)) =? T_NEVER {
        let saved_t=nodes.ptr[e].type
        nodes.ptr[e].type = LGI32(T_NEVER);
        gen_expr(e);
        nodes.ptr[e].type = saved_t;
        return never_value(t)
    }
    if t =? T_MATH_INT and math_word_helper(e) >? 0 {return math_pack_word(e math_word_expr(e))}
    ir_set_pos(nodes.ptr[e].pos);
    let aux:LGWord=LGWord(nodes.ptr[e].aux)
    if aux =? 0 {
        let remainder=gen_positive_mod(e)
        if remainder >=? 0 {return V(remainder false)}
        let arithmetic=gen_constant_floor(e)
        if arithmetic >=? 0 {return V(arithmetic false)}
        let word=gen_byte_read(e)
        if word >=? 0 {return V(word false)}
        if fns.ptr[LGWord(nodes.ptr[e].sym)].parallel_api {race_check(LGWord(nodes.ptr[e].sym) kids(e) nodes.ptr[e].pos);}
        if fns.ptr[LGWord(nodes.ptr[e].sym)].deterministic {
            # Cache ownership follows reachable serial lowering, not worker candidates.
            if fused_on {fz_note(7 0 e 0 0);}
            else {det_check(LGWord(nodes.ptr[e].sym) kids(e) nodes.ptr[e].pos);}
        }
        let order:array<int64>=[]
        if nodes.ptr[e].c not=? 0 {order=call_eval_order(e)}
        let target=if ownership_prints.has(e) {runtime_fn("__owner_print")} else {LGWord(nodes.ptr[e].sym)}
        let r=gen_direct_call(target kids(e) order e)
        if ownership_prints.has(e) and is_union(t) {
            let slot=new_temp(t)
            let value=e_slot(slot)
            e_zero(value tsize(t));
            e_store(value 0 e_iconst(union_index(t T_VOID)) 4);
            return Val[value true slot]
        }
        if vc(t) =? VC_VOID {return V(-1 false)}
        return r
    }
    if aux =? 1 {
        let order:array<int64>=[]
        if nodes.ptr[e].c not=? 0 {order=call_eval_order(e)}
        let r=gen_closure_call(LGWord(nodes.ptr[e].a) kids(e) order)
        if vc(t) =? VC_VOID {return V(-1 false)}
        return r
    }
    if aux =? 4 {return gen_cfn_call(LGWord(nodes.ptr[e].a) kids(e))}
    if aux =? 2 {
        let si:LGWord=LGWord(types.ptr[t].st)
        layout(t);
        let s=new_temp(t)
        let d=e_slot(s)
        e_zero(d tsize(t));
        let tracked=build_slot(s t)
        let owner_fields:array<[int64 int64]>=[]
        loop i in call_eval_order(e) {
            let a=kid(e i)
            if a =? 0 {continue}
            let f:LGWord=LGWord(structs.ptr[si].fields) + i
            let source=a
            if refine_active and nodes.ptr[a].kind =? 'conv' and nodes.ptr[a].aux =? LGI32(14) {source=LGWord(nodes.ptr[a].a)}
            let val=gen_owned(source)
            store_field(f d val.v);
            if ownership_type(ntype(source)) {
                let held_type=ntype(source)
                if fields.ptr[f].boxed {
                    # After boxing, the allocation and payload have one
                    # cleanup authority even before the outer record exists.
                    held_type=field_store_type(f)
                    let boxed=owner_value(V(e_load(VI d LGWord(fields.ptr[f].offset) ptr_size) true) held_type)
                    owner_forget_slot(val.slot);
                    val=boxed
                }
                owner_fields.push([val.slot held_type]);
                building.push(BuildItem[true val.slot held_type]);
            }
        }
        if refine_active {
            let values:array<int64>=[]
            let arg_types:array<int64>=[]
            loop i in [0..nkids(e)) {
                let f:LGWord=LGWord(structs.ptr[si].fields) + i
                let ft:LGWord=LGWord(fields.ptr[f].type)
                values.push(load_val(ft field_val_addr(f d) 0));
                arg_types.push(ft);
            }
            loop i in [0..nkids(e)) {
                let a=kid(e i)
                if a not=? 0 and nodes.ptr[a].kind =? 'conv' and nodes.ptr[a].aux =? LGI32(14) {ref_gen_check(a values.ptr[i] values arg_types);}
            }
        }
        loop field in owner_fields {
            owner_forget_slot(field[0]);
            building.pop();
        }
        if tracked {building.pop();}
        return Val[e_slot(s) true s]
    }
    if aux =? 3 {
        let si:LGWord=LGWord(types.ptr[t].st)
        layout(t);
        let v:LGWord=LGWord(nodes.ptr[e].aux2)
        # (a value made a union member: which member, by its type now that inference is done,
        # since the union's members may have been put in another order)
        if structs.ptr[si].union_ and nkids(e) =? 1 {
            let j=union_index(t ntype(kid(e 0)))
            if j >=? 0 {v=j}
        }
        let vi:LGWord=LGWord(structs.ptr[si].variants) + v
        if structs.ptr[si].simple_enum {return V(e_iconst(variants.ptr[vi].value) false)}
        let s=new_temp(t)
        let d=e_slot(s)
        e_zero(d tsize(t));
        e_store(d 0 e_iconst(v) 4);
        let tracked=build_slot(s t)
        loop i in call_eval_order(e) {
            let f:LGWord=LGWord(variants.ptr[vi].fields) + i
            let val=gen_owned(kid(e i))
            store_field(f d val.v);
        }
        if tracked {building.pop();}
        return Val[e_slot(s) true s]
    }
    fatal(nodes.ptr[e].pos "invalid call");
    return V(-1 false)
}
gen_value_unary=(e:LGWord):>Val=>$unsafe {
    let t=prune(ntype(e))
    let a:LGWord=LGWord(nodes.ptr[e].a)
    if nodes.ptr[e].op =? LGI32(58) {return gen_expr(a)}
    if is_vec(t) {
        let neg=mk('binary' nodes.ptr[e].pos)
        nodes.ptr[neg].op = LGI32(60);
        nodes.ptr[neg].a = LGI32(a);
        let m1=mk('float_lit' nodes.ptr[e].pos)
        nodes.ptr[m1].fval = -1.0;
        nodes.ptr[m1].type = LGI32(T_F32);
        if types.ptr[prune(t)].sign {
            # (an integer vector: times the integer -1, which wraps as the CPU's integers do)
            nodes.ptr[m1].kind = 'int_lit';
            nodes.ptr[m1].ival = -1;
            nodes.ptr[m1].type = LGI32(T_I32);
        }
        nodes.ptr[neg].b = LGI32(m1);
        nodes.ptr[neg].aux = 10;
        nodes.ptr[neg].type = LGI32(t);
        return gen_vec_binary(neg false)
    }
    if t =? T_MATH_INT {
        let base=if nodes.ptr[e].op =? LGI32(59) {0} else {-1}
        return math_binary('minus' math_word(e_iconst(base)).v gen_borrowed(a).v)
    }
    let v=gen_expr(a).v
    if nodes.ptr[e].op =? LGI32(59) {
        if vc(t) =? VC_FLT {return V(e_un('fneg' vt_of(t) v) false)}
        if int_policy(t) =? 2 {return V(saturate_binary('minus' t e_iconst(0) v) false)}
        let value=e_un('neg' VI v)
        if int_policy(t) =? 1 {value=norm(value t)}
        return V(value false)
    }
    return V(norm(e_un('not_' VI v) t) false)
}
gen_value_and_=(e:LGWord):>Val=>$unsafe {
    let k=nodes.ptr[e].kind
    let chain=range_tail(e)
    if chain not=? e {return gen_expr(chain)}
    let range=gen_range_cond(e)
    if range >=? 0 {return V(range false)}
    let r=vreg(VI)
    e_mov(r gen_expr(LGWord(nodes.ptr[e].a)).v);
    if k =? 'and_' {iff(r);}
    else {iff(e_bin('eq' VI r e_iconst(0)));}
    enter_cond();
    e_mov(r gen_expr(LGWord(nodes.ptr[e].b)).v);
    leave_cond();
    endc();
    return V(r false)
}
gen_value_conv=(e:LGWord):>Val=>$unsafe {
    let t=prune(ntype(e))
    # (something that never comes back, as panic(...), taken as a value: done, then any
    # value of the type, never used)
    if prune(ntype(LGWord(nodes.ptr[e].a))) =? T_NEVER and t not=? T_NEVER {
        gen_expr(LGWord(nodes.ptr[e].a));
        return never_value(t)
    }
    return gen_conv(e)
}
gen_value_cast=(e:LGWord):>Val=>$unsafe {
    let t=prune(ntype(e))
    let a:LGWord=LGWord(nodes.ptr[e].a)
    let source_type=prune(ntype(a))
    let val=gen_expr(a)
    # Simple enums store their variant number as a plain word. Mathematical
    # integers use a tagged word, so crossing this boundary must unpack or
    # pack the number rather than reinterpret its representation.
    if source_type =? T_MATH_INT and types.ptr[t].kind =? 'enum_' {return V(math_signed(val.v) false)}
    if types.ptr[source_type].kind =? 'enum_' and t =? T_MATH_INT {return math_pack_word(a val.v)}
    if types.ptr[source_type].kind =? 'float_' and types.ptr[t].kind =? 'int_' {
        let d=vreg(VI)
        emit('f2bits' vt_of(source_type) d val.v 0 0 0);
        return V(norm(d t) false)
    }
    if types.ptr[source_type].kind =? 'int_' and types.ptr[t].kind =? 'float_' {
        let d=vreg(vt_of(t))
        emit('bits2f' vt_of(t) d val.v 0 0 0);
        return V(d false)
    }
    if is_managed(source_type) {borrow(val source_type);}
    if is_managed(t) {return V(val.v true)}
    if types.ptr[t].kind =? 'int_' {return V(norm(val.v t) false)}
    return V(val.v false)
}
gen_value_coalesce=(e:LGWord):>Val=>$unsafe {
    let t=prune(ntype(e))
    let a:LGWord=LGWord(nodes.ptr[e].a)
    let ot=prune(ntype(a))
    let rs=new_temp(t)
    let pa=place_addr(gen_place(a false) ot)
    let inner:LGWord=LGWord(types.ptr[ot].elem)
    let has=opt_has(pa inner)
    iff(has);
    if nodes.ptr[e].aux =? 1 {
        let vv=own_at(a V(load_val(ot pa 0) false) ot)
        store_val(ot e_slot(rs) 0 vv.v);
    }
    else if t =? T_MATH_INT and representation_type(inner) not=? T_MATH_INT {
        # Refined mathematical integers are already tagged. Only an actual
        # stored machine word needs packing at this boundary.
        let word=opt_value(pa inner)
        let storage=representation_type(inner)
        let value=if not types.ptr[storage].sign and types.ptr[storage].bits =? 64 {math_call("__mi_unsigned" [word])} else {math_word(word)}
        store_val(t e_slot(rs) 0 value.v);
    }
    else {
        let vv=own_at(a V(opt_value(pa inner) false) inner)
        store_val(inner e_slot(rs) 0 vv.v);
    }
    els();
    enter_cond();
    let vb=gen_owned(LGWord(nodes.ptr[e].b))
    store_val(t e_slot(rs) 0 vb.v);
    leave_cond();
    endc();
    return result_from_slot(rs t)
}
gen_value_array=(e:LGWord):>Val=>$unsafe {
    let t=prune(ntype(e))
    return gen_array(e t)
}
gen_value_map_lit=(e:LGWord):>Val=>$unsafe {
    let t=prune(ntype(e))
    let s=new_temp(t)
    let d=e_slot(s)
    e_zero(d tsize(t));
    let f:LGWord=LGWord(nodes.ptr[e].sym)
    let tracked=build_slot(s t)
    if ownership_type(t) {owner_register(s t);}
    loop i in [0..nkids(e)) {
        let p=kid(e i)
        let key:LGWord=LGWord(nodes.ptr[p].a)
        let value:LGWord=LGWord(nodes.ptr[p].b)
        let kv=if copy_consumes(f 1) {gen_owned(key)} else {gen_borrowed(key)}
        let vv=if copy_consumes(f 2) {gen_owned(value)} else {gen_borrowed(value)}
        if copy_consumes(f 1) and ownership_type(ntype(key)) {owner_forget_slot(kv.slot);}
        if copy_consumes(f 2) and ownership_type(ntype(value)) {owner_forget_slot(vv.slot);}
        e_call3(lf_of_inst(f) e_slot(s) kv.v vv.v -1);
    }
    if tracked {building.pop();}
    return Val[e_slot(s) true s]
}
gen_value_tuple=(e:LGWord):>Val=>$unsafe {
    let t=prune(ntype(e))
    if vc(t) =? VC_VOID {return V(-1 false)}
    let s=new_temp(t)
    let tracked=build_slot(s t true)
    loop i in [0..LGWord(types.ptr[t].nargs)) {
        let el=targ(t i)
        let val=gen_owned(kid(e i))
        store_val(el e_slot(s) tuple_off(t i) val.v);

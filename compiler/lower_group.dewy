        else {release(pl.v t);}
    }
    write_place(pl t v);
    if ownership_type(t) {
        owner_forget(v);
        if element {owner_element_live(pl.v t);}
        else {owner_register(owner_address_slot(pl.v) t);}
    }
}
gen_assign=(s:LGWord):>void=>$unsafe {

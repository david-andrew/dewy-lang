        ir.code.truncate(record_start);
    }
    let ids:array<int64>=[]
    if copies_on {ids=copy_capture_ids(e)}
    let index:LGWord=0
    loop cap in fns.ptr[f].caps {
        let outer:LGWord=LGWord(cap.outer)
        let inn:LGWord=LGWord(cap.inner)
        if LGWord(locals.ptr[inn].flags) & LF_OWNERBORROW not=? 0 {
            store_val(store_type(inn) env LGWord(locals.ptr[inn].env_off) place_addr(local_place(outer false) LGWord(locals.ptr[outer].type)));
            index += 1;
            if resource {hdr_store(env 24 e_iconst(index));}

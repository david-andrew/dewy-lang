gen_fnref=(e:LGWord):>Val=>$unsafe {
    let f:LGWord=LGWord(nodes.ptr[e].sym)
    parallel_direct(f nodes.ptr[e].pos);
    if nodes.ptr[e].aux =? 2 {
        let source=gen_expr(LGWord(nodes.ptr[e].a))
        borrow(source ntype(LGWord(nodes.ptr[e].a)));
        let s=new_slot(closure_size() ptr_size)
        let a=e_slot(s)
        e_store(a 0 e_faddr(lf_of_inst(f)) ptr_size);
        e_store(a ptr_size e_load(VI source.v ptr_size ptr_size) ptr_size);
        # Selection borrows the existing environment. Binding/returning/passing
        # this value invokes the normal private-state copy machinery.
        return Val[a false s]

    if nodes.ptr[e].aux =? 1 {
        # C function pointer: the raw function
        return V(e_faddr(lf_of_inst(f)) false)
    }
    let s=new_slot(closure_size() ptr_size)
    let a=e_slot(s)
    e_store(a 0 e_faddr(lf_helper(HK.thunk 0 f)) ptr_size);
    e_store(a ptr_size e_iconst(0) ptr_size);
    return Val[a true s]
}
gen_partial=(e:LGWord):>Val=>$unsafe {
    let th:LGWord=LGWord(nodes.ptr[e].d)
    let offs=partial_layout(e)
    let size=offs.ptr[offs.length - 1]
    fns.ptr[th].env_size = LGI32(size);
    let s=new_slot(closure_size() ptr_size)
    let a=e_slot(s)
    e_store(a 0 e_faddr(lf_helper(HK.partial 0 th)) ptr_size);
    let env=e_call1(rt("__alloc") e_iconst(size) VI)
    e_store(a ptr_size env ptr_size);
    hdr_store(env 0 e_iconst(1));
    hdr_store(env 8 e_faddr(lf_helper(HK.envdrop 0 th)));
    hdr_store(env 16 e_faddr(lf_helper(HK.envcopy 0 th)));
    let tracked=build_slot(s ntype(e))
    let target:LGWord=LGWord(nodes.ptr[e].sym)
    if target not=? 0 {parallel_direct(target nodes.ptr[e].pos);}
    if nodes.ptr[e].aux =? 1 {
        let cv=gen_owned(LGWord(nodes.ptr[e].a))
        e_copy(e_addi(env 24) cv.v closure_size());
    }
    loop i in [0..nkids(e)) {
        let arg=kid(e i)
        if nodes.ptr[arg].kind =? 'hole' {continue}
        let is_mut=false
        if target not=? 0 {is_mut=inst_mutmask(target) & (1 << i) not=? 0}
        else {is_mut=LGWord(types.ptr[prune(ntype(LGWord(nodes.ptr[e].a)))].mutmask) & (1 << i) not=? 0}
        if is_mut {fatal(nodes.ptr[arg].pos "cannot partially apply a `mut` argument; use `_` for it");}
        let val=gen_owned(arg)
        store_val(ntype(arg) env offs.ptr[i] val.v);
    }
    if tracked {building.pop();}
    return Val[e_slot(s) true s]
}
gen_interp=(e:LGWord):>Val=>$unsafe {
    let bs=new_slot(8 8)
    let ba=e_slot(bs)
    e_store(ba 0 e_iconst(0) 8);
    building.push(BuildItem[true bs mk_array(T_U8)]);
    loop i in [0..nkids(e)) {
        let p=kid(e i)
        if nodes.ptr[p].kind =? 'str_lit' {
            let s=name_of(LGWord(nodes.ptr[p].sval))
            if (s).length =? 0 {continue}
            e_call2(rt("__buf_append_str") e_slot(bs) e_daddr(str_data(s)) -1);
            continue
        }
        let f:LGWord=LGWord(nodes.ptr[p].sym)
        let x:LGWord=LGWord(nodes.ptr[p].a)
        if exact_word_formats.has(p) or nodes.ptr[p].sval <? 0 and prune(ntype(x)) =? T_MATH_INT and math_proven_word(x) and math_default_formatter(f) {
            e_call2(rt("__fmt_word") e_slot(bs) math_word_expr(x) -1);
            continue
        }
        let val=gen_expr(x)
        # (a __fmt of the program's may change where the value came from)
        if not val.owned and is_managed(ntype(x)) and not in_lib(nodes.ptr[LGWord(fns.ptr[f].decl)].pos) and borrow_may_change(x [] 0 f) {val=own_at(x val ntype(x))}
        borrow(val ntype(x));
        let argv=[e_slot(bs) val.v]
        if nodes.ptr[p].sval >=? 0 {argv.push(e_daddr(str_data(name_of(LGWord(nodes.ptr[p].sval)))));}
        e_call(lf_of_inst(f) argv -1);
    }
    building.pop();
    let r=e_call1(rt("__buf_finish") e_load(VI e_slot(bs) 0 8) VI)
    return V(r true)
}
gen_value_block=(b:LGWord rs:LGWord rt_:LGWord rv:LGWord=-1):>void=>$unsafe {
    let out=exact_join_blocks.get(b)
    if out not=? none {
        let values=exact_extend(exact_value(b) out.length)
        loop i in [0..out.length) {e_mov(out.ptr[i] values.ptr[i]);}
        return
    }
    scope_push();
    let n=nkids(b)
    loop i in [0..n) {
        let s=kid(b i)
        if i =? n - 1 and nodes.ptr[b].aux not=? 0 and (rs >=? 0 or rv >=? 0) {
            stmt_begin();
            let val=gen_owned(LGWord(nodes.ptr[s].a))
            if rv >=? 0 {e_mov(rv norm(val.v rt_));}
            else {
                store_val(rt_ e_slot(rs) 0 val.v);
                if ownership_type(rt_) {
                    owner_forget_slot(val.slot);
                    owner_register(rs rt_);
                }
            }
            stmt_end();
            continue
        }
        gen_stmt(s);
    }
    scope_pop();
}
gen_match_test=(p:LGWord st0:LGWord hidden_addr:LGWord):>LGWord=>$unsafe {
    # Compare a refined payload through its storage representation.
    let st=representation_type(st0)
    let k=nodes.ptr[p].kind
    if k =? 'pwild' {return e_iconst(1)}
    if k =? 'ptype' {
        if is_union(st) {
            let tag=e_load(VI hidden_addr 0 4)
            let result=e_iconst(0)
            loop member in union_members(ntype(p)) {
                let hit=e_bin('eq' VI tag e_iconst(union_index(st member)))
                result=e_bin('or_' VI result hit)
            }
            return result
        }
        if nodes.ptr[p].aux2 =? 1 {
            # (a member of an optional union: present, and holding it)
            let u=prune(telem(st))
            let pt=prune(ntype(p))
            let ms=[pt]
            if is_union(pt) {ms=union_members(pt)}
            let result=vreg(VI)
            e_mov(result e_iconst(0));
            iff(opt_has(hidden_addr u));
            let tag=e_load(VI hidden_addr 0 4)
            let hits=e_iconst(0)
            loop member in ms {hits=e_bin('or_' VI hits e_bin('eq' VI tag e_iconst(union_index(u member))))}
            e_mov(result hits);
            endc();
            return result
        }
        return opt_has(hidden_addr telem(st))
    }
    if k =? 'pvariant' {
        let si:LGWord=LGWord(types.ptr[st].st)
        layout(st);
        let tag=e_load(VI hidden_addr 0 4)
        let want:LGWord=LGWord(nodes.ptr[p].aux2)
        if structs.ptr[si].simple_enum {want=variants.ptr[LGWord(structs.ptr[si].variants) + LGWord(nodes.ptr[p].aux2)].value}
        return e_bin('eq' VI tag e_iconst(want))
    }
    if k =? 'plit' {
        if is_union(st) {
            # Inspect the payload only after its tag matches: another member
            # can hold arbitrary bits where a string pointer would be stored.
            layout(st);
            let vi:LGWord=LGWord(nodes.ptr[p].aux2)
            let variant:LGWord=LGWord(structs.ptr[LGWord(types.ptr[st].st)].variants) + vi
            let field:LGWord=LGWord(variants.ptr[variant].fields)
            let result=vreg(VI)
            e_mov(result e_iconst(0));
            iff(e_bin('eq' VI e_load(VI hidden_addr 0 4) e_iconst(vi)));
            let payload=e_addi(hidden_addr LGWord(fields.ptr[field].offset))
            e_mov(result gen_match_test(p LGWord(fields.ptr[field].type) payload));
            endc();
            return result
        }
        let a:LGWord=LGWord(nodes.ptr[p].a)
        if st =? T_MATH_INT {return math_compare('eq' e_load(VI hidden_addr 0 8) gen_borrowed(a).v)}
        if types.ptr[st].kind =? 'str_' {
            let v=gen_borrowed(a).v
            return e_call2(rt("__str_eq") e_load(VI hidden_addr 0 ptr_size) v VI)
        }
        if types.ptr[st].kind =? 'opt' {
            if nodes.ptr[a].kind =? 'none_lit' {return e_bin('eq' VI opt_has(hidden_addr LGWord(types.ptr[st].elem)) e_iconst(0))}
            let u=prune(LGWord(types.ptr[st].elem))
            if is_union(u) {
                # (a member's literal where the value is an (A | B)?: present, then as for A | B; the
                # union sits in place)
                let result=vreg(VI)
                e_mov(result e_iconst(0));
                iff(opt_has(hidden_addr u));
                e_mov(result gen_match_test(p u hidden_addr));
                endc();
                return result
            }
            let hint=jd(nodes.ptr[p].pos "`if let v = x`" "`if x isnt? none \{ }`")
            fatal(nodes.ptr[p].pos "only `none` and `_` patterns are supported for optionals; use {hint}");
        }
        if vc(st) =? VC_FLT {fatal(nodes.ptr[p].pos "cannot match on floats");}
        if vc(st) =? VC_AGG {fatal(nodes.ptr[p].pos "unsupported pattern for this type");}
        let v=gen_expr(a).v
        return e_bin('eq' VI load_val(st hidden_addr 0) v)
    }
    if k =? 'prange' {
        let sg=types.ptr[representation_type(st)].kind =? 'int_' and types.ptr[representation_type(st)].sign
        let x=load_val(st hidden_addr 0)
        let lo=gen_expr(LGWord(nodes.ptr[p].a)).v
        let hi=gen_expr(LGWord(nodes.ptr[p].b)).v
        let c1=e_bin('ges' VI x lo)
        if not sg {c1=e_bin('geu' VI x lo)}
        let c2:LGWord=0
        if has_flag(p NF_INCLUSIVE) {
            if sg {c2=e_bin('les' VI x hi)}
            else {c2=e_bin('leu' VI x hi)}
        }
        else {
            if sg {c2=e_bin('lts' VI x hi)}
            else {c2=e_bin('ltu' VI x hi)}
        }
        return e_bin('and_' VI c1 c2)
    }
    fatal(nodes.ptr[p].pos "invalid pattern");
    return 0
}
gen_arm_body=(arm:LGWord rs:LGWord rtp:LGWord val:bool):>void=>$unsafe {
    enter_cond();
    let body:LGWord=LGWord(nodes.ptr[arm].b)
    if val {gen_value_block(body rs rtp);}
    else {
        scope_push();
        gen_block_stmts(body);
        scope_pop();
    }
    leave_cond();
}
gen_match_switch=(m:LGWord st0:LGWord rs:LGWord rtp:LGWord val:bool):>bool=>$unsafe {
    let st=prune(st0)
    let is_enum=types.ptr[st].kind =? 'enum_'
    if st =? T_MATH_INT {return false}
    if not is_enum and types.ptr[st].kind not=? 'int_' {return false}
    let na=nkids(m)
    # A grouped constant arm plus a wildcard can cover many alternatives.
    # The lookup threshold depends on those alternatives, not the arm count.
    if na <? 2 or (na <? 3 and (not val or dbg_on)) {return false}
    let vals:array<int64>=[]
    let arms:array<int64>=[]
    let wild:LGWord=-1
    loop i in [0..na) {
        let arm=kid(m i)
        loop k in [0..nkids(arm)) {
            let p=kid(arm k)
            let pk=nodes.ptr[p].kind
            if pk =? 'pwild' {
                if wild <? 0 {wild=i}
            }
            else if pk =? 'pvariant' and is_enum {
                let si:LGWord=LGWord(types.ptr[st].st)
                let v:LGWord=LGWord(nodes.ptr[p].aux2)
                if structs.ptr[si].simple_enum {v=variants.ptr[LGWord(structs.ptr[si].variants) + LGWord(nodes.ptr[p].aux2)].value}
                vals.push(v);
                arms.push(i);
            }
            else if pk =? 'plit' and not is_enum {
                let [ok v]=pat_int(LGWord(nodes.ptr[p].a))
                if not ok {return false}
                vals.push(v);
                arms.push(i);
            }
            else {return false}
        }
    }
    if vals.length <? 3 {return false}
    let lo:LGWord=LGWord(vals.ptr[0])
    let hi:LGWord=LGWord(vals.ptr[0])
    loop v in vals {
        if v <? lo {lo=v}
        if v >? hi {hi=v}
    }
    let span=hi - lo + 1
    if span <=? 0 or span >? 4096 {return false}
    let dense=span <=? 2 * vals.length + 16
    # Large boolean membership sets still need at most 256 bytes. Their
    # otherwise sparse tags should not require a long linear branch chain.
    let small_bool=val and vals.length >=? 8 and span <=? 256 and types.ptr[prune(rtp)].kind =? 'bool_'
    if val and not dbg_on and (dense or small_bool) and gen_match_lookup(m st rs rtp vals arms wild lo span) {return true}
    if na <? 3 or not dense {return false}
    if is_enum {layout(st);}
    # blocks: end, fail, then one per arm (arm 0 innermost)
    blk();
    let end_level=ctl
    blk();
    let fail_level=ctl
    let arm_level=fill(0 na)
    let i=na - 1
    loop i >=? 0 {
        blk();
        arm_level[i] = ctl;
        i -= 1;
    }
    let ha=local_place(LGWord(nodes.ptr[m].sym) false).v
    let x:LGWord=0
    if is_enum {x=e_load(VI ha 0 4)}
    else {x=load_val(st ha 0)}
    let idx=e_bin('sub' VI x e_iconst(lo))
    let table=fill(-1 span)
    loop j in [0..vals.length) and v in vals {
        if table.ptr[v - lo] <? 0 {table.ptr[v - lo] = arms.ptr[j];}
    }
    let def_level=fail_level
    if wild >=? 0 {def_level=arm_level[wild]}
    let depths:array<int64>=[]
    loop t in table {
        if t <? 0 {depths.push(ctl - def_level);}
        else {depths.push(ctl - arm_level[t]);}
    }
    e_brtable(idx depths ctl - def_level);
    loop a in [0..na) {
        endc();
        gen_arm_body(kid(m a) rs rtp val);
        br_to(end_level);
    }
    endc();
    if val {e_call_nr1(rt("__panic") e_daddr(str_data("no match arm matched")) -1);}
    endc();
    return true
}
gen_match=(m:LGWord want:bool):>Val=>$unsafe {
    let hidden:LGWord=LGWord(nodes.ptr[m].sym)
    let st=ntype(LGWord(nodes.ptr[m].a))
    let rtp=ntype(m)
    let val=want and vc(rtp) not=? VC_VOID and rtp not=? T_NEVER
    let rs:LGWord=-1
    if val {
        rs=new_temp(rtp)
        e_zero(e_slot(rs) tsize(rtp));
    }
    scope_push();
    let wide_subject:array<int64>=[]
    if exact_has_node(LGWord(nodes.ptr[m].a)) and exact_match_literals(m) {wide_subject=exact_value(LGWord(nodes.ptr[m].a))}
    if wide_subject.length >? 0 {store_val(st e_slot(LGWord(locals.ptr[hidden].offset)) 0 wide_subject.ptr[0]);}
    else if held_views.contains(hidden) {e_mov(LGWord(locals.ptr[hidden].vreg) held_value_addr(LGWord(nodes.ptr[m].a)));}
    else {
        stmt_begin();
        let sv=gen_owned(LGWord(nodes.ptr[m].a))
        store_val(st e_slot(LGWord(locals.ptr[hidden].offset)) 0 sv.v);
        stmt_end();
        scope_add_local(hidden);
    }
    if wide_subject.length =? 0 and gen_match_switch(m st rs rtp val) {
        scope_pop();
        if val {return result_from_slot(rs rtp)}
        return V(-1 false)
    }
    blk();
    let end_level=ctl
    loop i in [0..nkids(m)) {
        let arm=kid(m i)
        blk();
        let fail_level=ctl
        blk();
        let match_level=ctl
        loop k in [0..nkids(arm)) {
            let p=kid(arm k)
            let ha=local_place(hidden false).v
            enter_cond();
            let ok=if wide_subject.length =? 0 {gen_match_test(p st ha)} else if nodes.ptr[p].kind =? 'pwild' {e_iconst(1)} else {exact_compare('eq' wide_subject exact_value(LGWord(nodes.ptr[p].a)))}
            leave_cond();
            brif_to(ok match_level);
        }
        br_to(fail_level);
        endc();
        enter_cond();
        let body:LGWord=LGWord(nodes.ptr[arm].b)
        if val {gen_value_block(body rs rtp);}
        else {
            scope_push();
            gen_block_stmts(body);
            scope_pop();
        }
        leave_cond();
        br_to(end_level);
        endc();
    }
    if val {e_call_nr1(rt("__panic") e_daddr(str_data("no match arm matched")) -1);}
    endc();
    scope_pop();
    if val {return result_from_slot(rs rtp)}
    return V(-1 false)
}
kept_operand_addr=(x:LGWord t:LGWord):>LGWord=>$unsafe {
    let kv=own_at(x gen_expr(x) t)
    borrow(kv t);
    if vc(t) not=? VC_AGG {
        let ks=new_slot(8 8)
        e_store(e_slot(ks) 0 kv.v 8);
        return e_slot(ks)
    }
    return kv.v
}
left_operand_addr=(a:LGWord t:LGWord keep:bool):>LGWord=>$unsafe {
    if keep {return kept_operand_addr(a t)}
    return place_addr(gen_place(a false) t)
}
gen_byte_eq=(a:LGWord b:LGWord t:LGWord keep_left:bool secret:bool):>LGWord=>$unsafe {
    # (a slice's source need be kept only if evaluating b could change it)
    let keep=keep_left
    if is_slice(a) {keep=not unchanged_by(text_source(LGWord(nodes.ptr[a].a)) b)}
    let [da na]=byte_range(a t keep)
    let [db nb]=byte_range(b t false)
    let r=vreg(VI)
    e_mov(r e_iconst(0));
    iff(e_bin('eq' VI na nb));
    e_mov(r e_call3(rt(if secret {"__ct_mem_eq"} else {"__mem_eq"}) da db e_bin('mul' VI na e_iconst(owner_stride(LGWord(types.ptr[t].elem)))) VI));
    endc();
    return r
}
byte_range=(x:LGWord t:LGWord keep:bool):>[int64 int64]=>$unsafe {
    if not is_slice(x) or tkind(ntype(LGWord(nodes.ptr[x].a))) not=? 'array' {
        # (a fixed array's slice is made: a new array, not a place)
        let v=if keep or is_slice(x) {kept_operand_addr(x t)} else {place_addr(gen_place(x false) t)}
        let p=e_load(VI v 0 ptr_size)
        return [e_addi(p 24) arr_len(p)]
    }
    let source_node:LGWord=LGWord(nodes.ptr[x].a)
    let bt=prune(ntype(source_node))
    let r:LGWord=LGWord(nodes.ptr[x].b)
    let plain=unchanged_by(text_source(source_node) r) or (nodes.ptr[r].a =? 0 or plain_read(LGWord(nodes.ptr[r].a))) and (nodes.ptr[r].b =? 0 or plain_read(LGWord(nodes.ptr[r].b)))
    let source=gen_expr(source_node)
    if keep or not plain {
        source=own(source bt)
        borrow(source bt);
    }
    let p=vreg(VI)
    e_mov(p source.v);
    let [lo hi]=gen_slice_bounds(x p)
    let n=arr_len(p)
    let bad=e_bin('or_' VI e_bin('lts' VI lo e_iconst(0)) e_bin('gts' VI hi n))
    bad=e_bin('or_' VI bad e_bin('gts' VI lo hi))
    iff(bad);
    e_call_nr4(rt("__panic_slice") e_daddr(str_data("slice")) lo hi n -1);
    endc();
    return [e_bin('add' VI e_addi(p 24) e_bin('mul' VI lo e_iconst(owner_stride(LGWord(types.ptr[bt].elem))))) e_bin('sub' VI hi lo)];
}
gen_binary=(e:LGWord):>Val=>$unsafe {
    let a:LGWord=LGWord(nodes.ptr[e].a)
    let b:LGWord=LGWord(nodes.ptr[e].b)
    let lt=prune(ntype(a))
    let op=cx_token_values.ptr[LGWord(nodes.ptr[e].op)]
    let aux:LGWord=LGWord(nodes.ptr[e].aux)
    let is_cmp=op =? 'eq' or op =? 'ne' or op =? 'lt' or op =? 'le' or op =? 'gt' or op =? 'ge'
    # Read the left value before evaluating the right. Explicit mutation of a
    # local (including an intrinsic or assignment inside a block) matters too,
    # and aggregate operations need a copy even for values without references.
    let keep_left=false

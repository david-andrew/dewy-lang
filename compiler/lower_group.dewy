            let hi:LGWord=-1
            let bits:LGWord=LGWord(types.ptr[to].bits)
            if bits <? 64 {hi=(1 << bits) - 1}
            if types.ptr[to].sign {
                hi=LGWord(LGUWord(hi) >> 1)
                lo=-hi - 1
            }
            if types.ptr[source_type].sign and (source_type not=? T_MATH_INT or types.ptr[to].sign) {
                math_int_guard(e_bin('lts' VI v e_iconst(lo)));
                if types.ptr[to].sign or bits <? 64 {math_int_guard(e_bin('gts' VI v e_iconst(hi)));}
            }
            else {math_int_guard(e_bin('gtu' VI v e_iconst(hi)));}
        }
        return V(norm(v to) false)
    }
    if cv =? CV.int2float {
        if source_type =? T_MATH_INT {
            if math_proven_word(a) {
                let v=e_un('i2f' VF math_word_expr(a))
                if to =? T_F32 {v=e_un('f2f' VS v)}
                return V(v false)
            }
            let fast=math_float_binary(a to)
            if fast >=? 0 {return V(fast false)}
        }
        if source_type =? T_MATH_INT {
            let v=e_call1(rt("__mi_float") gen_borrowed(a).v VF)
            if to =? T_F32 {v=e_un('f2f' VS v)}
            return V(v false)
        }
        let v=gen_expr(a).v
        if types.ptr[source_type].kind =? 'int_' and not types.ptr[source_type].sign and LGWord(types.ptr[source_type].bits) =? 64 {return V(e_un('u2f' vt_of(to) v) false)}

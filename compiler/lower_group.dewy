    }
    if k =? 'and_' {
        jump_if_false(LGWord(nodes.ptr[e].a) level);
        jump_if_false(LGWord(nodes.ptr[e].b) level);
        return
    }
    if k =? 'or_' {
        blk();
        let t=ctl
        jump_if_true(LGWord(nodes.ptr[e].a) t);
        jump_if_false(LGWord(nodes.ptr[e].b) level);
        endc();
        return
    }
    if k =? 'not_' {
        jump_if_true(LGWord(nodes.ptr[e].a) level);
        return
    }
    let start=ir.code.length
    let c=cond_leaf(e)
    let last=ir.code.length - 1

            if source_type =? T_F32 {v=e_un('f2f' VF v)}
            return math_call("__mi_from_float" [v])
        }
        let d=vreg(VI)
        let bits:LGWord=64
        let sg=true
        if types.ptr[to].kind =? 'int_' {
            bits=LGWord(types.ptr[to].bits)
            sg=types.ptr[to].sign
        # (Dewy keeps the value: NaN and out-of-range values are checked, not saturated)
        }
        if dewy_at(nodes.ptr[e].pos) and float_int_guard(e v ft to) {
            if bits =? 64 and not sg {return V(float_to_u64(v ft) false)}
            emit('f2i' ft d v 0 0 0);
            return V(norm(d to) false)
        }
        if bits =? 64 and not sg {

        else {ad=place_addr(gen_place(a false) lt)}
        let bd:LGWord=0
        if is_slice(b) {bd=kept_operand_addr(b lt)}
        else {bd=place_addr(gen_place(b false) lt)}
        let r=gen_eq(lt ad bd)
        if op =? 'ne' {r=e_bin('xor' VI r e_iconst(1))}
        return V(r false)

    let arg0:LGWord=LGWord(lists.ptr[arg_start])
    let m:LGWord=0
    # Message construction only runs on the terminating path. Its calls
    # must not make a checked helper look like it calls on successful paths.
    let was=ir_cold
    ir_cold=true
    if arg_count >? 0 {m=gen_borrowed(arg0).v}
    else {m=e_daddr(str_data("panic"))}
    ir_cold=was
    e_call_nr1(rt("__panic") m -1);
    return never_after(e)
}
gen_intrinsic_assert=(e:LGWord arg_start:LGWord arg_count:LGWord):>Val=>$unsafe {
    let arg0:LGWord=LGWord(lists.ptr[arg_start])
    let arg1:LGWord=LGWord(lists.ptr[arg_start + 1])
    let c=gen_expr(arg0).v
    iff(e_bin('eq' VI c e_iconst(0)));
    # (the message is made only when it fails: a temporary made there is a conditional one)
    enter_cond();
    let m:LGWord=0
    if arg_count >? 1 {m=gen_borrowed(arg1).v}
    else {
        let cond=call_args_text(nodes.ptr[e].pos)
        let msg="assertion failed"
        if (cond as array<uint8>).length >? 0 and (cond as array<uint8>).length <=? 200 {msg="assertion failed: {cond}"}
        m=e_daddr(str_data(msg))
    }
    e_call_nr2(rt("__assert_fail") m e_daddr(loc_data(nodes.ptr[e].pos)) -1);
    leave_cond();
    endc();
    return V(-1 false)
}
gen_intrinsic_to_bytes=(e:LGWord arg_start:LGWord):>Val=>$unsafe {
    let arg0:LGWord=LGWord(lists.ptr[arg_start])
    return V(gen_expr(arg0).v false)
}
gen_intrinsic_setjmp=(e:LGWord arg_start:LGWord arg_count:LGWord):>Val=>$unsafe {
    let id=nodes.ptr[e].aux as IN
    let vs:array<int64>=[]
    loop i in [0..arg_count) {vs.push(gen_expr(LGWord(lists.ptr[arg_start + i])).v);}
    let start=ir.args.length
    loop v in vs {ir.args.push(LGI32(v));}
    let d=vreg(VI)
    let code:LGWord=2
    if id =? IN.longjmp {code=3}
    if id =? IN.jump {code=4}
    if id =? IN.clone_thread {code=5}
    if id =? IN.atomic_add {code=6}
    if id =? IN.atomic_cas {code=7}
    if id =? IN.stack_ptr {code=8}
    if id =? IN.cpu_features {code=9}
    if id =? IN.code_sync {code=11}
    emit('intr' VI d LGI32(start) LGI32(vs.length) 0 code);
    return V(d false)
}
gen_intrinsic_mul_hi=(e:LGWord arg_start:LGWord):>Val=>$unsafe {
    let a=gen_expr(LGWord(lists.ptr[arg_start])).v
    let b=gen_expr(LGWord(lists.ptr[arg_start + 1])).v
    if mulh_ok {return V(e_bin('mulhu' VI a b) false)}
    return V(e_call2(rt("__mul_hi_soft") a b VI) false)
}
gen_intrinsic_sqrt=(e:LGWord arg_start:LGWord):>Val=>$unsafe {
    let arg0:LGWord=LGWord(lists.ptr[arg_start])
    let v=gen_expr(arg0).v
    return V(e_un('fsqrt' vt_of(ntype(arg0)) v) false)
}
gen_intrinsic_hash=(e:LGWord arg_start:LGWord):>Val=>$unsafe {
    let arg0:LGWord=LGWord(lists.ptr[arg_start])
    let t=prune(ntype(arg0))
    let pa=place_addr(gen_place(arg0 false) t)
    # (`__hash_value(x, true)`: the dictionaries' keyed hash)
    return V(e_call1(lf_helper(HK.hash t if nkids(e) =? 2 {1} else {0}) pa VI) false)
}
gen_fmt_struct=(e:LGWord):>Val=>$unsafe {
    let args=kids(e)
    let t=prune(ntype(args.ptr[1]))
    let bp=gen_place(args.ptr[0] true)
    let ba=place_addr(bp ntype(args.ptr[0]))
    let va=place_addr(gen_place(args.ptr[1] false) t)
    let fi:LGWord=0
    let k=types.ptr[t].kind
    # (Dewy's literal syntax: [x=1 name="q"], no type name and no commas)
    let dewy=LGWord(nodes.ptr[e].aux2) & FMT_DEWY not=? 0
    if k =? 'struct_' {
        let si:LGWord=LGWord(types.ptr[t].st)
        layout(t);
        # (a minted type with its name: Payload[code=1], or Unit with no fields)
        let name=if not dewy or fmt_minted(si) {structs.ptr[si].name} else {""}
        let shown=nkids2(e)
        if dewy and shown =? 0 and name not=? "" {lit(ba name);}
        else if dewy {lit(ba "{name}[");}
        else {lit(ba "{name}(");}
        loop i in fmt_field_order(si) {
            let f:LGWord=LGWord(structs.ptr[si].fields) + i
            if fmt_hidden(LGWord(fields.ptr[f].type) nodes.ptr[e].aux2) {continue}
            let sep=""
            if fi >? 0 and dewy {sep=" "}
            else if fi >? 0 {sep=", "}
            lit(ba "{sep}{name_of(LGWord(fields.ptr[f].name))}=");
            fmt_field(ba LGWord(nodes.ptr[kid2(e fi)].sym) LGWord(fields.ptr[f].type) field_val_addr(f va));
            fi += 1;
        }
        if not dewy {lit(ba ")");}
        else if shown >? 0 or name =? "" {lit(ba "]");}
    }
    else if k =? 'tuple' {
        # (Dewy writes an array with a type per position as an array, `[1 "a"]`)
        lit(ba (if dewy {"["} else {"("}));
        let tsep=", "
        if dewy {tsep=" "}
        loop i in [0..LGWord(types.ptr[t].nargs)) {
            if i >? 0 {lit(ba tsep);}
            fmt_field(ba LGWord(nodes.ptr[kid2(e fi)].sym) targ(t i) e_addi(va tuple_off(t i)));
            fi += 1;
        }
        lit(ba (if dewy {"]"} else {")"}));
    }
    else if k =? 'enum_' {
        let si:LGWord=LGWord(types.ptr[t].st)
        layout(t);
        let tag=e_load(VI va 0 4)
        loop v in [0..LGWord(structs.ptr[si].nvariants)) {
            let vi:LGWord=LGWord(structs.ptr[si].variants) + v
            let want=v
            if structs.ptr[si].simple_enum {want=variants.ptr[vi].value}
            iff(e_bin('eq' VI tag e_iconst(want)));
            let nf:LGWord=LGWord(variants.ptr[vi].nfields)
            if structs.ptr[si].union_ {
                let f:LGWord=LGWord(variants.ptr[vi].fields)
                if tkind(LGWord(fields.ptr[f].type)) =? 'void_' {lit(ba "void");}
                else {fmt_field(ba LGWord(nodes.ptr[kid2(e fi)].sym) LGWord(fields.ptr[f].type) e_addi(va LGWord(fields.ptr[f].offset)));}
                fi += 1;
                endc();
                continue
            # (a string set's member is its text, quoted inside a structure as a string is)
            }
            if structs.ptr[si].lit_set not=? 0 and dewy and LGWord(nodes.ptr[e].aux2) & 1 not=? 0 {lit(ba __test_jq(name_of(LGWord(variants.ptr[vi].name))));}
            else {lit(ba name_of(LGWord(variants.ptr[vi].name)));}
            if nf >? 0 {
                lit(ba "(");
                loop j in [0..nf) {
                    if j >? 0 {lit(ba ", ");}
                    let f:LGWord=LGWord(variants.ptr[vi].fields) + j
                    fmt_field(ba LGWord(nodes.ptr[kid2(e fi)].sym) LGWord(fields.ptr[f].type) field_val_addr(f va));
                    fi += 1;
                }
                lit(ba ")");
            }
            endc();
        }
    }
    else if k =? 'vec' {
        let n=vec_comps(t)
        lit(ba "{type_str(t)}(");
        loop i in [0..n) {
            if i >? 0 {lit(ba ", ");}
            if types.ptr[t].sign {
                e_call2(rt("__fmt_i32") ba e_load(VI va 4 * i 4 | M_SIGNED) -1);
            }
            else {
                e_call2(rt("__fmt_f32") ba e_load(VS va 4 * i 4 | M_FLOAT) -1);
            }
        }
        lit(ba ")");
    # (a function, which has no runtime value, shows as its type's spelling)
    }
    else {lit(ba if dewy or ts_dewy {type_str(t true)} else {"<fn>"});}
    return V(-1 false)
}
gen_json_fields=(e:LGWord):>Val=>$unsafe {
    let args=kids(e)
    let t=prune(ntype(args.ptr[1]))
    let ba=place_addr(gen_place(args.ptr[0] true) ntype(args.ptr[0]))
    let va=place_addr(gen_place(args.ptr[1] false) t)
    let indent=gen_expr(args.ptr[2]).v
    let level=gen_expr(args.ptr[3]).v
    let child=e_addi(level 1)
    let fi:LGWord=0
    let k=types.ptr[t].kind
    if k =? 'struct_' {
        let si:LGWord=LGWord(types.ptr[t].st)
        layout(t);
        lit(ba "\{");
        loop i in [0..LGWord(structs.ptr[si].nfields)) {
            let f:LGWord=LGWord(structs.ptr[si].fields) + i
            json_key(ba name_of(LGWord(fields.ptr[f].name)) indent level i);
            json_field(ba LGWord(nodes.ptr[kid2(e fi)].sym) LGWord(fields.ptr[f].type) field_val_addr(f va) indent child);
            fi += 1;
        }
        if structs.ptr[si].nfields >? 0 {e_call3(rt("__json_newline") ba indent level -1);}
        lit(ba "}");
    }
    else if k =? 'fixed' {
        lit(ba "[");
        let et:LGWord=LGWord(types.ptr[t].elem)
        let i=fixed_loop_begin(t)
        e_call4(rt("__json_sep") ba indent level i -1);
        json_field(ba LGWord(nodes.ptr[kid2(e 0)].sym) et fixed_elem_addr(va i et) indent child);
        fixed_loop_end(i);
        if fixed_len(t) >? 0 {e_call3(rt("__json_newline") ba indent level -1);}
        lit(ba "]");
    }
    else if k =? 'tuple' or k =? 'vec' {
        let count=if k =? 'tuple' {LGWord(types.ptr[t].nargs)} else {vec_comps(t)}
        lit(ba "[");
        loop i in [0..count) {
            e_call4(rt("__json_sep") ba indent level e_iconst(i) -1);
            let ft=if k =? 'tuple' {targ(t i)} else if types.ptr[t].sign {T_I32} else {T_F32}
            let off=if k =? 'tuple' {tuple_off(t i)} else {i * 4}
            json_field(ba LGWord(nodes.ptr[kid2(e i)].sym) ft e_addi(va off) indent child);
        }
        if count >? 0 {e_call3(rt("__json_newline") ba indent level -1);}
        lit(ba "]");
    }
    else if k =? 'enum_' {
        let si:LGWord=LGWord(types.ptr[t].st)
        layout(t);
        let tag=e_load(VI va 0 4)
        loop v in [0..LGWord(structs.ptr[si].nvariants)) {
            let vi:LGWord=LGWord(structs.ptr[si].variants) + v
            let want=if structs.ptr[si].simple_enum {variants.ptr[vi].value} else {v}
            iff(e_bin('eq' VI tag e_iconst(want)));
            let nf:LGWord=LGWord(variants.ptr[vi].nfields)
            let name=name_of(LGWord(variants.ptr[vi].name))
            if structs.ptr[si].union_ {
                let f:LGWord=LGWord(variants.ptr[vi].fields)
                json_field(ba LGWord(nodes.ptr[kid2(e fi)].sym) LGWord(fields.ptr[f].type) field_val_addr(f va) indent level);
                fi += 1;
            }
            else if nf =? 0 {
                e_call2(rt("__json_write_str") ba e_daddr(str_data(name)) -1);
            }
            else {
                lit(ba "\{");
                json_key(ba name indent level 0);
                lit(ba "[");
                loop j in [0..nf) {
                    e_call4(rt("__json_sep") ba indent child e_iconst(j) -1);
                    let f:LGWord=LGWord(variants.ptr[vi].fields) + j
                    json_field(ba LGWord(nodes.ptr[kid2(e fi)].sym) LGWord(fields.ptr[f].type) field_val_addr(f va) indent e_addi(child 1));
                    fi += 1;
                }
                e_call3(rt("__json_newline") ba indent child -1);
                lit(ba "]");
                e_call3(rt("__json_newline") ba indent level -1);
                lit(ba "}");
            }
            endc();
        }
    }
    return V(-1 false)
}
gen_conv=(e:LGWord):>Val=>$unsafe {
    let to=prune(ntype(e))
    let a:LGWord=LGWord(nodes.ptr[e].a)
    let source_type=prune(ntype(a))
    let cv=nodes.ptr[e].aux as CV
    if exact_map_active and exact_map_stores.has(e) and cv =? CV.int_ {return V(exm_word(a) false)}
    # A proved signed word is unchanged by a signed 64-bit overflow policy.
    # Keep bounded mathematical shift counts in registers, including 32-k.
    if (cv =? CV.wrap_int or cv =? CV.saturate_int) and source_type =? T_MATH_INT and types.ptr[to].bits =? 64 and types.ptr[to].sign and math_proven_word(a) {return V(math_word_expr(a) false)}
    if (cv =? CV.wrap_int or cv =? CV.saturate_int) and exact_has_node(a) {return exact_gen_policy(e)}
    if (cv =? CV.int_ or cv =? CV.none_) and to =? T_MATH_INT and exact_has_node(a) {return exact_gen_math(a)}
    if cv =? CV.fixed_store {return exact_gen_store(e)}
    if exact_word_reads.has(e) or exact_progress_math.length >? 0 and exact_progress_math.has(e) {return V(math_word_expr(a) false)}
    if cv =? CV.int2float and exact_has_node(a) {return exact_gen_float(a to)}
    if cv =? CV.refinement {return refine_gen(e)}
    if cv =? CV.promote {return arena_gen_promote(e)}
    if cv =? CV.explicit_copy {
        if ownership_type(source_type) {
            let value=gen_expr(a)
            borrow(value source_type);
            return own(Val[value.v false -1] source_type)
        }
        if not copies_on {return own(gen_expr(a) source_type)}
        copy_explicit[a] = true;
        let value=gen_expr(a)
        copy_explicit.remove(a);
        return own(value source_type)
    }
    if cv =? CV.none_ or cv =? CV.quantity_const or cv =? CV.ptr {return gen_expr(a)}
    if cv =? CV.set_text {
        # (a string set's member text: the table's offset of it, source_type the table)
        let member=gen_expr(a).v
        let table=e_daddr(set_text_table(LGWord(nodes.ptr[e].aux2)))
        let rel=e_load(VI e_bin('add' VI table e_bin('mul' VI member e_iconst(8))) 0 8)
        return V(e_bin('add' VI table rel) false)
    }
    if cv =? CV.big2math {return math_call("__mi_pack" [gen_borrowed(a).v])}
    if cv =? CV.math2big {return math_call("__mi_big" [gen_borrowed(a).v] to)}
    if cv =? CV.wrap_int or cv =? CV.saturate_int {
        let v=gen_borrowed(a).v
        if cv =? CV.wrap_int {
            if source_type =? T_MATH_INT {v=e_call1(rt("__mi_low_word") v VI)}
            else if types.ptr[source_type].bits =? 32 and not types.ptr[source_type].sign and types.ptr[to].bits =? 64 {v=e_un('zext32' VI v)}
            return V(norm(v to) false)
        }
        let bits:LGWord=LGWord(types.ptr[to].bits)
        let hi=if bits =? 64 {-1} else {(1 << bits) - 1}
        let lo:LGWord=0
        if types.ptr[to].sign {
            hi=LGWord(LGUWord(hi) >> 1)
            lo=-hi - 1
        }
        if source_type =? T_MATH_INT {
            return V(e_call(rt("__mi_clamp_word") [v e_iconst(lo) e_iconst(hi) e_iconst(if types.ptr[to].sign {0} else {1})] VI) false)
        }
        let result=vreg(VI)
        e_mov(result v);
        if types.ptr[source_type].sign {
            iff(e_bin('lts' VI v e_iconst(lo)));
            e_mov(result e_iconst(lo));
            els();
            iff(e_bin((if types.ptr[to].sign {Op.gts} else {Op.gtu}) VI v e_iconst(hi)));
            e_mov(result e_iconst(hi));
            endc();
            endc();
        }
        else {
            iff(e_bin('gtu' VI v e_iconst(hi)));
            e_mov(result e_iconst(hi));
            endc();
        }
        return V(norm(result to) false)
    }
    if cv =? CV.int_ {
        if source_type =? T_MATH_INT and to not=? T_MATH_INT {
            let width=math_static_bits(a)
            if width >? 0 and width <=? 256 {return math_static_narrow(a to)}
        }
        if source_type =? T_MATH_INT and math_proven_word(a) {
            let v=math_word_expr(a)

    let a:LGWord=LGWord(nodes.ptr[s].a)
    let t=quantity_base(ntype(a))
    let aux:LGWord=LGWord(nodes.ptr[s].aux)
    if t =? T_MATH_INT and math_local_is(a LGWord(nodes.ptr[a].sym)) {
        let words=math_static_regs.get(LGWord(nodes.ptr[a].sym))
        if words not=? none {
            let values=exact_extend(math_static_value(LGWord(nodes.ptr[s].b)) words.length)
            loop i in [0..words.length) {e_mov(words.ptr[i] values.ptr[i]);}
            return
        }
        let word=math_word_regs.get(LGWord(nodes.ptr[a].sym))
        if word not=? none {
            e_mov(word math_word_expr(LGWord(nodes.ptr[s].b)));
            return
        }
    }
    if aux =? 1 {
        let tt=prune(ntype(LGWord(nodes.ptr[s].b)))
        let val=gen_owned(LGWord(nodes.ptr[s].b))
        loop i in [0..LGWord(types.ptr[tt].nargs)) {
            let el=targ(tt i)
            let tg=kid(a i)
            let ea=e_addi(val.v tuple_off(tt i))
            if nodes.ptr[tg].kind =? 'hole' {drop_at(ea el);}
            else {assign_to(tg el load_val(el ea 0));}
        }
        return
    }
    if aux =? 2 {
        let v=gen_borrowed(LGWord(nodes.ptr[s].b)).v
        let pl=gen_place(a true)
        let sa=place_addr(pl t)
        e_call2(rt("__str_append") sa v -1);
        if not pl.mem {e_mov(pl.v e_load(VI sa 0 ptr_size));}
        return
    }
    if aux =? 3 {
        let d=e_bin('mul' VI gen_expr(LGWord(nodes.ptr[s].b)).v e_iconst(tsize(LGWord(types.ptr[t].elem))))
        let pl=gen_place(a true)
        let cur=read_place(pl t)
        if nodes.ptr[s].op =? LGI32(48) {write_place(pl t e_bin('add' VI cur d));}
        else {write_place(pl t e_bin('sub' VI cur d));}
        return
    }
    if nodes.ptr[s].op =? LGI32(47) {
        let rhs:LGWord=LGWord(nodes.ptr[s].b)
        if ownership_type(t) and nodes.ptr[rhs].kind =? 'intrinsic' and nodes.ptr[rhs].aux =? LGI32(76) {
            let pl=gen_place(a true)
            owner_element_drop(pl.v t);
            e_zero(pl.v owner_stride(t));
            return
        }
        if nodes.ptr[a].kind =? 'ident' and nodes.ptr[a].aux =? LGI32(1) and held_views.contains(LGWord(nodes.ptr[a].sym)) {
            # (a held view given another part: its address)
            e_mov(LGWord(locals.ptr[LGWord(nodes.ptr[a].sym)].vreg) held_value_addr(LGWord(nodes.ptr[s].b)));
            return
        # (Dewy's xs[f()] = g(): the destination's indices first, then the right side, which may
        # change them or resize the array; the destination is located again with the indices kept)
        }
        let held:array<int64>=[]
        if (nodes.ptr[a].kind =? 'index' or nodes.ptr[a].kind =? 'field') and dewy_at(nodes.ptr[s].pos) and (assign_rhs_effects(rhs) or assign_rhs_effects(a)) {
            let x=a
            let steps:array<int64>=[]
            loop true {
                let xk=nodes.ptr[x].kind
                if xk =? 'index' and nodes.ptr[x].b not=? 0 and not has_flag(x NF_RELOOKUP) and (assign_rhs_effects(LGWord(nodes.ptr[x].b)) or not index_stable(LGWord(nodes.ptr[x].b) rhs)) {steps.insert(LGWord(nodes.ptr[x].b) 0);}
                if xk =? 'field' or xk =? 'index' or xk =? 'unwrap' or xk =? 'narrow' {x=LGWord(nodes.ptr[x].a)}
                else {break}
            }
            loop ib in steps {
                if frozen.has(ib) {continue}
                frozen[ib] = freeze_scalar(gen_index(ib) ntype(ib));
                held.push(ib);
            }
        }
        let val=gen_owned(rhs)
        assign_to(a t val.v);
        loop ib in held {frozen.remove(ib);}
        return
    # compound arithmetic
    }
    let op=cx_token_values.ptr[compound_op(LGWord(nodes.ptr[s].op))]
    let pl=gen_place(a true)
    let cur=read_place(pl t)
    if t =? T_MATH_INT {
        let value=V(0 false)
        if op =? 'shl' or op =? 'shr' {value=math_shift(op cur math_shift_count(LGWord(nodes.ptr[s].b)) types.ptr[prune(ntype(LGWord(nodes.ptr[s].b)))].sign)}
        else {value=math_binary(op cur gen_borrowed(LGWord(nodes.ptr[s].b)).v)}
        release(cur t);
        write_place(pl t value.v);
        return
    }
    let rhs=gen_expr(LGWord(nodes.ptr[s].b)).v
    let r:LGWord=0
    if is_vec(t) {
        ice("compound assignment on vectors should be desugared");
    }
    if vc(t) =? VC_FLT and op =? 'percent' {
        # (x - y * trunc(x / y): the dividend's sign, as % does)
        let ty=vt_of(t)
        let q=e_un('ftrunc' ty e_bin('fdiv' ty cur rhs))
        r=e_bin('fsub' ty cur e_bin('fmul' ty q rhs))
    }
    else if vc(t) =? VC_FLT {
        r=e_bin(float_op(op) vt_of(t) cur rhs)
        if ff_checks_any {float_check(s r t);}
    }
    else {
        let sg=types.ptr[t].kind =? 'int_' and types.ptr[t].sign
        if op =? 'slash' or op =? 'percent' {
            iff(e_bin('eq' VI rhs e_iconst(0)));
            e_call_nr1(rt("__div_zero") e_daddr(loc_data(nodes.ptr[s].pos)) -1);
            endc();
        }
        if int_policy(t) =? 2 and op =? 'shl' {r=saturate_shift(t cur rhs)}
        else if int_policy(t) =? 2 and (op =? 'plus' or op =? 'minus' or op =? 'star') {r=saturate_binary(op t cur rhs)}
        else if types.ptr[t].kind =? 'bool_' {r=e_bin(int_op(op false) VI cur rhs)}
        else if sg and (op =? 'slash' or op =? 'percent') {r=sdiv_wrap(op cur rhs t)}
        else if (op =? 'shl' or op =? 'shr') and dewy_at(nodes.ptr[s].pos) {r=wide_shift(op sg cur rhs LGWord(nodes.ptr[s].b))}
        else {r=e_bin(int_op(op sg) VI cur rhs)}
    }
    if int_policy(t) =? 1 {r=norm(r t)}
    write_place(pl t r);
}
gen_vardecl=(s:LGWord):>void=>$unsafe {
    if exact_lower_active {exm_fresh_array(s);}
    if nodes.ptr[s].nlist >? 0 {
        let tt=prune(ntype(LGWord(nodes.ptr[s].b)))
        let val=gen_owned(LGWord(nodes.ptr[s].b))
        # (a tuple of owners: each element leaves the temporary's cleanup for its binding's)
        let parts=ownership_type(tt) and val.slot >=? 0
        loop i in [0..LGWord(types.ptr[tt].nargs)) {
            let el=targ(tt i)
            let id=kid(s i)
            let ea=e_addi(val.v tuple_off(tt i))
            if parts {owner_forget_field(val.slot "{i}/");}
            if nodes.ptr[id].kind =? 'hole' {
                if parts and ownership_type(el) {e_call1(lf_helper(HK.drop el 0) ea -1);}
                else {drop_at(ea el);}
            }
            else if has_flag(id NF_GLOBAL) {
                let g:LGWord=LGWord(nodes.ptr[id].sym)
                store_val(el e_gaddr(global_addr_off(g)) 0 load_val(el ea 0));
            }
            else {
                let l:LGWord=LGWord(nodes.ptr[id].sym)
                if is_shared(l) {new_cell(l);}
                write_place(local_place(l true) el load_val(el ea 0));
                scope_add_local(l);
            }
        }
        return
    }
    if has_flag(s NF_GLOBAL) {
        let g:LGWord=LGWord(nodes.ptr[s].sym)
        let iv:LGWord=LGWord(nodes.ptr[s].b)
        if iv =? 0 {return}
        if copies_on and copy_shared_global(s g) {return}
        # (also `x = 0`: globals start as zero, but a function called above could have changed it)
        let val=gen_owned(iv)
        store_val(LGWord(globals.ptr[g].type) e_gaddr(global_addr_off(g)) 0 val.v);
        return
    }
    let l:LGWord=LGWord(nodes.ptr[s].sym)
    let t:LGWord=LGWord(locals.ptr[l].type)
    if partition_mode and nodes.ptr[s].aux2 =? 1 and partition_descs.has(l) {return}
    if parallel_scalar_decl(s l) {return}
    if copies_on and copy_bindings.has(l) and nodes.ptr[s].aux2 =? 1 {
        write_place(local_place(l true) t gen_expr(LGWord(nodes.ptr[s].b)).v);
        scope_add_local(l);
        return
    }
    if nodes.ptr[s].aux2 =? 1 and LGWord(locals.ptr[l].flags) & LF_PARAM not=? 0 {return}
    if held_views.contains(l) {
        e_mov(LGWord(locals.ptr[l].vreg) held_value_addr(LGWord(nodes.ptr[s].b)));
        return
    }
    if copies_on and copy_shared_decl(s l) {return}
    if view_decl(s l) {return}
    if exact_map_active and exm_declaration(s) {return}
    if prune(t) =? T_MATH_INT {
        if math_word_local_decl(s) {return}
        if math_reset_local_decl(s) {return}
        if math_static_local_decl(s) {return}
    }
    if exact_lower_active {exact_counter_bound(s);}
    if is_shared(l) {new_cell(l);}
    let pl=local_place(l true)
    if nodes.ptr[s].b not=? 0 {
        let iv:LGWord=LGWord(nodes.ptr[s].b)
        let a=fixed_array_len(iv)
        if a >=? 0 and LGWord(locals.ptr[l].flags) & LF_ASSIGNED =? 0 {len_of_local[l] = a;}
        # A := [x; E]: A's length is E for as long as A is not resized
        if nodes.ptr[iv].kind =? 'array' and nodes.ptr[iv].b not=? 0 and fixed_array_local(l) {array_len_expr[l] = LGWord(nodes.ptr[iv].b);}
        let stack=nodes.ptr[iv].kind =? 'lambda' and files.ptr[pos_file(nodes.ptr[s].pos)].is_dewy and stack_closure_local(l)
        if stack and stack_closure_passed.has(l) {
            stack=not has_flag(iv NF_GENERIC) and closure_env_shareable(LGWord(nodes.ptr[iv].sym))
        }
        if stack {stack_closure_targets[l] = if has_flag(iv NF_GENERIC) {poly_families.ptr[LGWord(nodes.ptr[iv].aux)].envfn} else {LGWord(nodes.ptr[iv].sym)};}
        let val=if stack {gen_lambda(iv true)} else {gen_owned(iv)}
        if stack {locals.ptr[l].offset = LGI32(val.slot);}
        else {write_place(pl t val.v);}
        if ownership_type(t) {owner_forget_slot(val.slot);}
    }
    else {
        if pl.mem {e_zero(pl.v tsize(t));}
        else {e_mov(pl.v zero_val(t));}
    }
    scope_add_local(l);
}
view_decl=(s:LGWord l:LGWord):>bool=>$unsafe {
    if copies_on and copy_strict(s) {return false}
    if not opt_release or cur_block =? 0 or kid(cur_block cur_block_i) not=? s {return false}
    let fl:LGWord=LGWord(locals.ptr[l].flags)
    if fl & (LF_ASSIGNED | LF_ADDR | LF_CAPTURE | LF_CAPTURED | LF_BYREF | LF_ALIAS | LF_PARAM | LF_EXPOSED) not=? 0 or is_shared(l) {return false}
    let t=prune(LGWord(locals.ptr[l].type))
    if types.ptr[t].kind not=? 'struct_' and types.ptr[t].kind not=? 'tuple' and types.ptr[t].kind not=? 'array' {return false}
    if type_has_fn(t) or ownership_type(t) {return false}
    let iv:LGWord=LGWord(nodes.ptr[s].b)
    if iv =? 0 {return false}
    # the element of an array reached by a path (xs[i], w.xs[i], xs[i].part)
    let e=iv
    loop nodes.ptr[e].kind =? 'field' and nodes.ptr[e].aux >=? 0 {e=LGWord(nodes.ptr[e].a)}
    if nodes.ptr[e].kind not=? 'index' or nodes.ptr[e].aux not=? 0 {return false}
    let base:LGWord=LGWord(nodes.ptr[e].a)
    if lpath_key(base) =? 0 or tkind(ntype(base)) not=? 'array' {return false}
    let rn=lpath_root(base)
    let root_global=nodes.ptr[rn].aux =? LGI32(2)
    let r:LGWord=LGWord(nodes.ptr[rn].sym)
    if not root_global {
        let rf:LGWord=LGWord(locals.ptr[r].flags)
        if rf & (LF_ALIAS | LF_CAPTURE | LF_BYREF) not=? 0 or is_shared(r) {return false}
    # the statements that use b: nothing in them may change the root variable
    }
    let last:LGWord=-1
    loop i in [cur_block_i + 1..nkids(cur_block)) {
        if mentions_local(kid(cur_block i) l) {last=i}
    }
    loop i in [cur_block_i + 1..last + 1) {
        if may_write_root(kid(cur_block i) rn) {return false}
    # b is the element's address
    }
    let p=gen_place(iv false)
    if not p.mem {return false}
    let v=vreg(VI)
    # Array values are one pointer. Cache that pointer, rather than an
    # address into the parent; ordinary array loop hoisting then still works.
    # The root remains alive and unchanged through the last use proved above.
    let array=types.ptr[t].kind =? 'array'
    e_mov(v if array {read_place(p t)} else {p.v});
    locals.ptr[l].vreg = LGI32(v);
    locals.ptr[l].flags = LGI32(fl | LF_ELEMENTVIEW | (if array {0} else {LF_BYREF}));
    return true
}
held_value_addr=(e:LGWord):>LGWord=>$unsafe {
    let t=ntype(e)
    if tkind(t) =? 'opt' {
        let view=held_opt_reg(e)
        if view >=? 0 {return view}
        if boxed_field_of(e) >=? 0 {
            box_slot=true
            let slot=gen_place(e false).v
            return e_load(VI slot 0 ptr_size)
        }
    }
    return held_encode_addr(gen_place(e false).v t)
}
gen_loop_body=(b:LGWord):>void=>$unsafe {
    scope_push();
    gen_block_stmts(b);
    scope_pop();
}
gen_stepped_for=(s:LGWord):>void=>$unsafe {
    let it:LGWord=LGWord(nodes.ptr[s].a)
    let l:LGWord=LGWord(nodes.ptr[s].sym)
    let lt=prune(LGWord(locals.ptr[l].type))
    if lt =? T_MATH_INT {scope_add_local(l);}
    let signed=types.ptr[lt].sign
    let less=if signed {Op.lts} else {Op.ltu}
    let greater=if signed {Op.gts} else {Op.gtu}
    let direct=lt not=? T_MATH_INT and stable_loop_index(l) and locals.ptr[l].offset <? 0 and tsize(lt) =? 8
    let ctr=vreg(VI)
    if direct {ctr=LGWord(locals.ptr[l].vreg)}
    let endv=vreg(VI)
    let open_end=nodes.ptr[it].b =? 0
    let inclusive=has_flag(it NF_INCLUSIVE)
    stmt_begin();
    e_mov(ctr math_count(LGWord(nodes.ptr[it].a)));
    let second=math_count(LGWord(nodes.ptr[it].c))
    let up=e_bin(greater VI second ctr)
    let step=e_bin('sub' VI second ctr)
    let step_high=e_iconst(0)
    if open_end {
        let first_high=if signed {e_bin('shrs' VI ctr e_iconst(63))} else {e_iconst(0)}
        let second_high=if signed {e_bin('shrs' VI second e_iconst(63))} else {e_iconst(0)}
        step_high=e_bin('sub' VI e_bin('sub' VI second_high first_high) e_bin('ltu' VI second ctr))
    }
    if not open_end {e_mov(endv math_count(LGWord(nodes.ptr[it].b)));}
    iff(e_bin('eq' VI step e_iconst(0)));
    e_call_nr1(rt("__panic") e_daddr(str_data("range step must be nonzero")) -1);
    endc();
    stmt_end();
    blk();
    let brk=ctl
    if not open_end {brif_to(stepped_done(up ctr endv inclusive signed) brk);}
    let remaining=vreg(VI)
    if not open_end {
        # Count iterations with unsigned distances, once. This covers the full
        # signed/unsigned span without overflow checks on every iteration.
        # A count of zero represents 2^64 iterations (the range is nonempty).
        let distance=vreg(VI)
        let magnitude=vreg(VI)
        iff(up);
        e_mov(distance e_bin('sub' VI endv ctr));
        e_mov(magnitude step);
        els();
        e_mov(distance e_bin('sub' VI ctr endv));
        e_mov(magnitude e_bin('sub' VI e_iconst(0) step));
        endc();
        if not inclusive {e_mov(distance e_addi(distance -1));}
        e_mov(remaining e_addi(e_bin('divu' VI distance magnitude) 1));
    }
    let facts=range_facts_begin(s l)
    lop();
    let top=ctl
    if not direct {
        if lt =? T_MATH_INT {
            drop_at(place_addr(local_place(l true) lt) lt);
            write_place(local_place(l true) lt math_word(ctr).v);
        }
        else {write_place(local_place(l true) lt ctr);}
    }
    blk();
    let cont=ctl
    loops.push(LoopInfo[brk cont scope_locals.length tl_items.length building.length]);
    gen_loop_body(LGWord(nodes.ptr[s].b));
    loops.pop();
    range_facts_end(facts);
    endc();
    let next=e_bin('add' VI ctr step)
    if open_end {
        let high=if signed {e_bin('shrs' VI ctr e_iconst(63))} else {e_iconst(0)}
        high=e_bin('add' VI e_bin('add' VI high step_high) e_bin('ltu' VI next ctr))
        let stored=if lt =? T_MATH_INT {next} else {norm(next lt)}
        let expected=if signed {e_bin('shrs' VI stored e_iconst(63))} else {e_iconst(0)}
        let bad=e_bin('or_' VI e_bin('ne' VI high expected) e_bin('ne' VI next stored))
        iff(bad);
        e_call_nr1(rt("__panic") e_daddr(str_data("range exhausted its integer type")) -1);
        endc();
    }
    e_mov(ctr next);
    if open_end {br_to(top);}
    else {
        e_mov(remaining e_addi(remaining -1));
        brif_to(e_bin('ne' VI remaining e_iconst(0)) top);
    }
    endc();
    endc();
}
gen_fixed_comprehension=(b:LGWord push:LGWord to:LGWord proven:bool):>Val=>$unsafe {
    let n=fixed_len(representation_type(to))
    let s=new_temp(to)
    e_zero(e_slot(s) tsize(to));
    let saved:[int64 int64 int64 int64 bool]=[fixed_fill_push fixed_fill_slot fixed_fill_count fixed_fill_type fixed_fill_exact]
    let count=vreg(VI)
    e_mov(count e_iconst(0));
    let exact=proven or fact_fixed_comprehension_exact(b to)
    fixed_fill_push=push; fixed_fill_slot=s; fixed_fill_count=count; fixed_fill_type=to; fixed_fill_exact=exact
    scope_push();
    gen_stmt(kid(b 0));
    gen_stmt(kid(b 1));
    scope_pop();
    fixed_fill_push=saved[0]; fixed_fill_slot=saved[1]; fixed_fill_count=saved[2]; fixed_fill_type=saved[3]; fixed_fill_exact=saved[4]
    if not exact {
        iff(e_bin('ne' VI count e_iconst(n)));
        e_call_nr1(rt("__panic") e_daddr(str_data("fixed-size array needs {n} elements")) -1);
        endc();
    }
    return Val[e_slot(s) true s]
}
gen_comprehension_reserve=(s:LGWord count:LGWord):>void=>$unsafe {
    if not has_flag(s NF_COMPREHENSION) {return}
    let acc:LGWord=LGWord(nodes.ptr[s].aux2)
    let at=prune(LGWord(locals.ptr[acc].type))
    let pl=local_place(acc true)
    iff(e_bin('gts' VI count e_iconst(0)));
    let sa=place_addr(pl at)
    e_call3(rt("__arr_reserve") sa e_iconst(owner_stride(LGWord(types.ptr[at].elem))) count -1);
    if not pl.mem {e_mov(pl.v e_load(VI sa 0 ptr_size));}
    if has_flag(s NF_INBOUNDS) {hdr_store(read_place(pl at) 8 count);}
    endc();
}
gen_for=(s:LGWord):>void=>$unsafe {
    if eg_stack.length >? 0 {eg_loop();}
    if exact_map_for(s) {return}
    if math_accumulator_for(s) {return}
    let bounded=bounded_open_for(s)
    if bounded not=? 0 {
        gen_for(bounded);
        return
    }
    scope_push();
    let aux:LGWord=LGWord(nodes.ptr[s].aux)
    if aux =? 0 and prune(LGWord(locals.ptr[LGWord(nodes.ptr[s].sym)].type)) =? T_MATH_INT and not math_word_range(s) {
        gen_math_for(s);
        scope_pop();
        return
    }
    if aux =? 0 and has_flag(LGWord(nodes.ptr[s].a) NF_STEP) {
        gen_stepped_for(s);
        scope_pop();
        return
    }
    if aux =? 0 or aux =? 4 {
        let l:LGWord=LGWord(nodes.ptr[s].sym)
        let lt:LGWord=LGWord(locals.ptr[l].type)
        if prune(lt) =? T_MATH_INT and not stable_loop_index(l) {scope_add_local(l);}
        let endv=vreg(VI)
        let ctr=vreg(VI)
        # (a 64-bit loop variable in a register that the body does not assign is the counter)
        let direct=prune(lt) not=? T_MATH_INT and stable_loop_index(l) and locals.ptr[l].offset <? 0 and vc(lt) =? VC_INT and tsize(lt) =? 8
        if direct {ctr=LGWord(locals.ptr[l].vreg)}
        let open_end=false
        let inclusive=false
        stmt_begin();
        if aux =? 0 {
            let it:LGWord=LGWord(nodes.ptr[s].a)
            e_mov(ctr math_count(LGWord(nodes.ptr[it].a)));
            inclusive=has_flag(it NF_INCLUSIVE)
            if nodes.ptr[it].b =? 0 {
                open_end=true
                let bits:LGWord=LGWord(types.ptr[prune(lt)].bits)
                if types.ptr[prune(lt)].sign {bits -= 1;}
                let maxv:LGWord=-1
                if bits <? 64 {maxv=(1 << bits) - 1}
                e_mov(endv e_iconst(maxv));
            }
            else {e_mov(endv math_count(LGWord(nodes.ptr[it].b)));}
        }
        else {
            let r=gen_expr(LGWord(nodes.ptr[s].a)).v
            e_mov(ctr e_load(VI r 0 8));
            e_mov(endv e_load(VI r 8 8));
        }
        gen_comprehension_reserve(s endv);
        stmt_end();
        let sg=types.ptr[prune(lt)].sign
        let facts=range_facts_begin(s l)
        let cmpop=Op.ges
        if not sg {cmpop='geu'}
        let counted=inclusive or open_end
        if counted {cmpop=if sg {Op.gts} else {Op.gtu}}
        let ltop=Op.lts
        if not sg {ltop='ltu'}
        # Exclusive bounds keep their direct comparison. Inclusive/open ranges
        # count remaining representable values, avoiding end+1 overflow. As in
        # stepped loops, a nonempty full-word span has count zero (2^64).
        blk();
        let brk=ctl
        if not open_end {brif_to(e_bin(cmpop VI ctr endv) brk);}
        let remaining:LGWord=0
        if counted {
            remaining=vreg(VI)
            e_mov(remaining e_addi(e_bin('sub' VI endv ctr) 1));
        }
        lop();
        let top=ctl
        if not direct {
            if prune(lt) =? T_MATH_INT {
                if stable_loop_index(l) {math_word_regs[l] = ctr;}
                else {
                    drop_at(place_addr(local_place(l true) lt) lt);
                    write_place(local_place(l true) lt math_word(ctr).v);
                }
            }
            else {write_place(local_place(l true) lt ctr);}
        }
        blk();
        let cont=ctl
        loops.push(LoopInfo[brk cont scope_locals.length tl_items.length building.length]);
        gen_loop_body(LGWord(nodes.ptr[s].b));
        math_word_regs.remove(l);
        loops.pop();
        range_facts_end(facts);
        endc();
        e_mov(ctr e_addi(ctr 1));
        if counted {
            e_mov(remaining e_addi(remaining -1));
            brif_to(e_bin('ne' VI remaining e_iconst(0)) top);
        }
        else {brif_to(e_bin(ltop VI ctr endv) top);}
        endc();
        if open_end {e_call_nr1(rt("__panic") e_daddr(str_data("range exhausted its integer type")) -1);}
        endc();
        scope_pop();
        return
    }
    let idx:LGWord=LGWord(nodes.ptr[s].c)
    let snap:LGWord=LGWord(nodes.ptr[s].d)
    let el:LGWord=LGWord(nodes.ptr[s].sym)
    let ct=prune(ntype(LGWord(nodes.ptr[s].a)))
    let slice_lo:LGWord=-1
    let slice_hi:LGWord=-1
    if aux =? 1 or aux =? 3 {
        # (iterating a variable the loop does not change needs no snapshot of it: the loop
        # borrows the array, with no reference counting)
        let it:LGWord=LGWord(nodes.ptr[s].a)
        let sliced=aux =? 1 and types.ptr[ct].kind =? 'array' and is_slice(it) and tkind(ntype(LGWord(nodes.ptr[it].a))) =? 'array'
        # If the body writes the source, copying its selected range can be
        # cheaper than retaining the full array and forcing a whole-array detach.
        if sliced {sliced=unchanged_by(LGWord(nodes.ptr[it].a) LGWord(nodes.ptr[s].b))}
        let resource_map=aux =? 3 and is_map_type(ct) and ownership_type(ct)
        if resource_map and not unchanged_by(it LGWord(nodes.ptr[s].b)) {
            fatal(nodes.ptr[s].pos "resource dictionary iteration requires stable borrowed storage");
        }
        let borrowed=resource_map or not type_has_fn(ct) and not sliced and not is_slice(it) and aux =? 1 and (not dbg_on or copy_strict(s) or ownership_type(ct)) and unchanged_by(it LGWord(nodes.ptr[s].b))
        stmt_begin();
        if sliced {
            # Iteration needs a retained source and bounds, not a copied slice.
            # Own the source before evaluating bounds that can replace it.
            let val=gen_owned(LGWord(nodes.ptr[it].a))
            write_place(local_place(snap true) ct val.v);
            scope_add_local(snap);
            let p=read_place(local_place(snap false) ct)
            (slice_lo slice_hi)=gen_slice_bounds(it p)
            let n=arr_len(p)
            let bad=e_bin('or_' VI e_bin('lts' VI slice_lo e_iconst(0)) e_bin('gts' VI slice_hi n))
            bad=e_bin('or_' VI bad e_bin('gts' VI slice_lo slice_hi))
            iff(bad);
            e_call_nr4(rt("__panic_slice") e_daddr(str_data("slice")) slice_lo slice_hi n -1);
            endc();
        }
        else {
            let val=if borrowed {gen_borrowed(it)} else {gen_owned(it)}
            write_place(local_place(snap true) ct val.v);
            if not borrowed and ownership_type(ct) {owner_forget_slot(val.slot);}
        }
        stmt_end();
        if not borrowed and not sliced {scope_add_local(snap);}
    }
    let ip=local_place(idx true)
    write_place(ip T_INT e_iconst(0));
    # the snapshot of an array cannot change while iterating: hoist its length and data
    let n_snap:LGWord=0
    let base_snap:LGWord=0
    let map_values:LGWord=0
    let is_fixed=types.ptr[ct].kind =? 'fixed'
    if aux =? 1 {
        let sv=read_place(local_place(snap false) ct)
        if is_fixed {
            # (the snapshot is the elements themselves)
            n_snap=e_iconst(fixed_len(ct))
            base_snap=sv
        }
        else {
            n_snap=arr_len(sv)
            base_snap=e_addi(sv 24)
            if slice_lo >=? 0 {
                n_snap=e_bin('sub' VI slice_hi slice_lo)
                base_snap=e_bin('add' VI base_snap e_bin('mul' VI slice_lo e_iconst(owner_stride(LGWord(types.ptr[ct].elem)))))
            }
        }
        gen_comprehension_reserve(s n_snap);
    }
    else if aux =? 3 and not has_flag(s NF_MUT) {
        # The dense entry snapshot is immutable for this loop. Hoist its array
        # bounds and data just as for an ordinary array snapshot.
        layout(ct);
        let f0:LGWord=LGWord(structs.ptr[LGWord(types.ptr[ct].st)].fields)
        let sa=place_addr(local_place(snap false) ct)
        let keys=e_load(VI sa LGWord(fields.ptr[f0].offset) ptr_size)
        n_snap=arr_len(keys)
        base_snap=e_addi(keys 24)
        map_values=e_addi(e_load(VI sa LGWord(fields.ptr[f0 + 1].offset) ptr_size) 24)
    }
    if aux =? 2 and types.ptr[ct].kind =? 'array' {
        let spelling=mutable_loop_syntax(nodes.ptr[s].pos)
        let key=lpath_key(LGWord(nodes.ptr[s].a))
        if key not=? 0 {
            let at=lm_change_at(LGWord(nodes.ptr[s].b) key)
            if at not=? 0 {
                let p=place_text(LGWord(nodes.ptr[s].a))
                # (respawn(g) in a loop over g.enemies: all of g given to a function that may
                # change it, the array among the rest)
                let why=""
                let src=files.ptr[pos_file(at)].src
                let o=pos_off(at)
                let e=o
                loop e <? (src as array<uint8>).length {
                    let ch=(src as array<uint8>).ptr[e]
                    if not (ch >=? 65 and ch <=? 90 or ch >=? 97 and ch <=? 122 or ch >=? 48 and ch <=? 57 or ch =? 95 or ch =? 46) {break}
                    e += 1
                }
                if e <? (src as array<uint8>).length and e >? o and ((src as array<uint8>).ptr[e] =? 41 or (src as array<uint8>).ptr[e] =? 44) and p.startswith(src.byte_slice(o e)) {
                    why=" (here all of {src.byte_slice(o e)} is given to a function that may change it, with its {p}: set a flag in the loop and call it after)"
                }
                let hint=jd(nodes.ptr[s].pos "(x): keep" "(x) => keep")
                fatal(at "`{spelling}` changes the elements of {p} in place, so its body cannot add, remove or replace elements of {p}{why}: do that after the loop ({p}.retain({hint}) keeps some; push new ones to another array first), or loop over its indexes");
            # (a function called in the body that does it, to a global's array)
            }
            let r=write_root(LGWord(nodes.ptr[s].a))
            if r not=? 0 and nodes.ptr[r].aux =? LGI32(2) {
                let c=lm_resizing_call(LGWord(nodes.ptr[s].b) LGWord(nodes.ptr[r].sym))
                if c not=? 0 {
                    let p=place_text(LGWord(nodes.ptr[s].a))
                    let fname=name_of(LGWord(nodes.ptr[LGWord(fns.ptr[LGWord(nodes.ptr[c].sym)].decl)].name))
                    fatal(nodes.ptr[c].pos "`{spelling}` changes the elements of {p} in place, and {fname} (called here) may add, remove or replace elements of {p}, which the loop cannot have: set a flag in the loop and call it after, push new ones to another array first, or loop over its indexes");
    # (the array of a `loop mut` that the loop cannot replace or resize: its length is read once)
                }
            }
        }
    }
    let nfp:LGWord=0
    let n_fixed:LGWord=0
    if aux =? 2 and is_fixed {
        nfp=fp_begin(s idx 0 0)
        n_fixed=e_iconst(fixed_len(ct))
    }
    else if aux =? 2 {
        let before=fixed_paths.length
        nfp=fp_begin(s idx LGWord(nodes.ptr[s].a) LGWord(nodes.ptr[s].a))
        let fi=fixed_path_of(LGWord(nodes.ptr[s].a))
        if fi >=? before {n_fixed=fixed_paths.ptr[fi].len}
    }
    else {nfp=fp_begin(s idx 0 0)}
    # tested before the loop and then at its bottom, like a range loop
    blk();
    let brk=ctl
    brif_to(each_done(s ct read_place(local_place(idx false) T_INT) n_snap n_fixed false) brk);
    lop();
    let top=ctl
    let i=read_place(local_place(idx false) T_INT)
    if aux =? 1 {
        let et=T_U8
        if types.ptr[ct].kind =? 'array' or is_fixed {et=LGWord(types.ptr[ct].elem)}
        let ea=e_bin('add' VI base_snap e_bin('mul' VI i e_iconst(if is_fixed {tsize(et)} else {owner_stride(et)})))
        e_mov(LGWord(locals.ptr[el].vreg) ea);
    }
    else if aux =? 3 {
        let si:LGWord=LGWord(types.ptr[ct].st)
        layout(ct);
        let f0:LGWord=LGWord(structs.ptr[si].fields)
        let kt=telem(LGWord(fields.ptr[f0].type))
        let vt=telem(LGWord(fields.ptr[f0 + 1].type))
        let sa=place_addr(local_place(snap false) ct)
        let keys=base_snap
        if keys =? 0 {keys=e_addi(e_load(VI sa LGWord(fields.ptr[f0].offset) ptr_size) 24)}
        e_mov(LGWord(locals.ptr[el].vreg) e_bin('add' VI keys e_bin('mul' VI i e_iconst(owner_stride(kt)))));
        let vl:LGWord=LGWord(nodes.ptr[s].aux2)
        if vl not=? 0 and LGWord(locals.ptr[vl].flags) & LF_BYREF not=? 0 {
            let vals=map_values
            if vals =? 0 {vals=e_addi(e_load(VI sa LGWord(fields.ptr[f0 + 1].offset) ptr_size) 24)}
            e_mov(LGWord(locals.ptr[vl].vreg) e_bin('add' VI vals e_bin('mul' VI i e_iconst(owner_stride(vt)))));
        }
    }
    blk();
    let cont=ctl
    loops.push(LoopInfo[brk cont scope_locals.length tl_items.length building.length]);
    if aux =? 3 and is_map_type(ct) and ownership_type(ct) {
        let fs=field_list(ct)
        let sa=place_addr(local_place(snap false) ct)
        let gone=e_load(VI sa fs.ptr[4][1] ptr_size)
        iff(e_bin('lts' VI i arr_len(gone)));
        brif_to(e_load(VI e_bin('add' VI e_addi(gone 24) i) 0 1) cont);
        endc();
    }
    gen_loop_body(LGWord(nodes.ptr[s].b));
    loops.pop();
    endc();
    let ip2=local_place(idx true)
    write_place(ip2 T_INT e_addi(read_place(ip2 T_INT) 1));
    brif_to(each_done(s ct read_place(local_place(idx false) T_INT) n_snap n_fixed true) top);
    endc();
    endc();
    fp_end(nfp);
    scope_pop();
}
each_done=(s:LGWord ct:LGWord i:LGWord n_snap:LGWord n_fixed:LGWord more:bool):>LGWord=>$unsafe {
    let aux:LGWord=LGWord(nodes.ptr[s].aux)
    let n=n_snap
    if aux =? 2 {
        n=n_fixed
        if n =? 0 {n=arr_len(read_place(gen_place(LGWord(nodes.ptr[s].a) false) ct))}
    }
    else if aux =? 3 and n =? 0 {
        let si:LGWord=LGWord(types.ptr[ct].st)
        layout(ct);
        let f0:LGWord=LGWord(structs.ptr[si].fields)
        let sa=place_addr(local_place(LGWord(nodes.ptr[s].d) false) ct)
        n=arr_len(e_load(VI sa LGWord(fields.ptr[f0].offset) ptr_size))
    }
    if more {return e_bin('lts' VI i n)}
    return e_bin('ges' VI i n)
}
fp_begin=(s:LGWord l:LGWord bound:LGWord place:LGWord):>LGWord=>$unsafe {
    if place =? 0 and fns.ptr[cur_fn].no_indexes {return 0}
    let summary=fact_storage_loop(s)
    fp_bases=summary.bases
    fp_kill=summary.kill
    fp_escape=summary.escape
    fp_written=summary.written
    fp_calls=summary.calls
    fp_lambda=summary.opaque
    if place not=? 0 and lpath_key(place) not=? 0 and tkind(ntype(place)) =? 'array' {
        fp_bases.push(place);
        fp_written.push(lpath_key(place));
    }
    if fp_lambda or fp_bases.length =? 0 {return 0}
    let bound_key:LGWord=0
    if bound not=? 0 {bound_key=lpath_key(bound)}
    let added:LGWord=0
    let done:array<int64>=[]
    loop base in fp_bases {
        let key=lpath_key(base)
        if done.contains(key) {continue}
        done.push(key);
        let ok=true
        loop kk in fp_kill {
            if path_within(key kk) {ok=false}
        }
        let rn=lpath_root(base)
        let r:LGWord=LGWord(nodes.ptr[rn].sym)
        let fl:LGWord=0
        let written=fp_written.contains(key)
        if nodes.ptr[rn].aux =? LGI32(2) {
            # (what the loop calls could change the global, or copy it while the loop writes it)
            if fp_calls {ok=false}
        }
        else {
            fl=LGWord(locals.ptr[r].flags)
            if fl & (LF_ALIAS | LF_CAPTURE | LF_BYREF) not=? 0 or is_shared(r) {ok=false}
            if fl & LF_MUTPARAM not=? 0 and fp_calls {ok=false}
            if fl & LF_PARAM =? 0 and not declared_in_scope(r) {ok=false}
        }
        if written {
            loop e in fp_escape {
                if path_within(key e) or path_within(e key) {ok=false}
            }
            if fl & LF_PARAM not=? 0 and fl & LF_MUTPARAM =? 0 {ok=false}
        }
        if not ok {continue}
        let at=prune(ntype(base))
        let desc=partition_descriptor(base)
        if desc >=? 0 {
            let data=e_load(VI desc 0 8)
            let length=e_load(VI desc 8 8)
            fixed_paths.push(FixedPath[key e_addi(data -24) length (if key =? bound_key and stable_loop_index(l) {l} else {-1})]);
            added += 1;
            continue
        }
        if written and not is_uniq_array(base) {arr_unique(gen_place(base true) at);}
        let arr=vreg(VI)
        e_mov(arr read_place(gen_place(base false) at));
        let n=arr_len(arr)
        let lv:LGWord=-1
        if key =? bound_key and stable_loop_index(l) {lv=l}
        fixed_paths.push(FixedPath[key arr n lv]);
        added += 1;
    }
    return added
}
uq_begin=(s:LGWord):>LGWord=>$unsafe {
    if not opt_release {return 0}
    uq_written.clear();
    uq_escaped.clear();
    uq_lambda=false
    uq_calls=false
    uq_scan(s 1);
    if uq_lambda {return 0}
    let added:LGWord=0
    loop l in uq_written {
        if uq_escaped.contains(l) or uniq_locals.contains(l) {continue}
        let t=prune(LGWord(locals.ptr[l].type))
        if types.ptr[t].kind not=? 'array' {continue}
        let fl:LGWord=LGWord(locals.ptr[l].flags)
        if partition_mode and fl & LF_MUTPARAM not=? 0 {continue}
        if fl & (LF_ALIAS | LF_CAPTURE | LF_BYREF) not=? 0 or is_shared(l) {continue}
        if fl & LF_PARAM not=? 0 and fl & LF_MUTPARAM =? 0 {continue}
        # (a mut parameter may be the caller's global, which code the loop calls could copy)
        if fl & LF_MUTPARAM not=? 0 and uq_calls {continue}
        # only variables that exist before the loop: one declared inside it gets a new value
        # (maybe a shared or read-only one) on every iteration
        if fl & LF_PARAM =? 0 and not declared_in_scope(l) {continue}
        arr_unique(local_place(l true) t);
        uniq_locals.push(l);
        added += 1;
    }
    return added
}
gen_while=(s:LGWord):>void=>$unsafe {
    if eg_stack.length >? 0 {eg_loop();}
    if exr_loop(s) {return}
    if gen_scan_loop(s) {return}
    gen_while_scalar(s);
}
gen_while_scalar=(s:LGWord):>void=>$unsafe {
    scope_push();
    let rotate=nodes.ptr[s].aux not=? 1 and simple_cond(LGWord(nodes.ptr[s].a))
    let nfp=fp_begin(s -1 0 0)
    blk();
    let brk=ctl
    # (a simple condition is tested in front and at the bottom: one branch per iteration)
    if rotate {jump_if_false(LGWord(nodes.ptr[s].a) brk);}
    lop();
    let top=ctl
    if nodes.ptr[s].aux =? 1 {
        let l:LGWord=LGWord(nodes.ptr[s].sym)
        let a:LGWord=LGWord(nodes.ptr[s].a)
        let ot=prune(ntype(a))
        let inner:LGWord=LGWord(types.ptr[ot].elem)
        let has=vreg(VI)
        stmt_begin();
        let pa=place_addr(gen_place(a false) ot)
        e_mov(has opt_has(pa inner));
        if held_views.contains(l) {e_mov(LGWord(locals.ptr[l].vreg) held_encode_addr(pa inner));}
        else {
            iff(has);
            let vv=own_at(a V(opt_value(pa inner) false) inner)
            write_place(local_place(l true) inner vv.v);
            endc();
        }
        stmt_end();
        brif_to(e_bin('eq' VI has e_iconst(0)) brk);
        scope_push();
        scope_add_local(l);
        blk();
        let cont=ctl
        loops.push(LoopInfo[brk cont scope_locals.length tl_items.length building.length]);
        gen_block_stmts(LGWord(nodes.ptr[s].b));
        loops.pop();
        endc();
        scope_pop();
        br_to(top);
    }
    else {
        # (others at the top: the condition often computes what the body uses again)
        if not rotate {jump_if_false(LGWord(nodes.ptr[s].a) brk);}
        blk();
        let cont=ctl
        loops.push(LoopInfo[brk cont scope_locals.length tl_items.length building.length]);
        let guard=if eg_active {eg_begin(LGWord(nodes.ptr[s].a) true)} else {0}
        gen_loop_body(LGWord(nodes.ptr[s].b));
        if eg_active {eg_end(guard);}
        loops.pop();
        endc();
        let c:LGWord=LGWord(nodes.ptr[s].a)
        if not rotate or (nodes.ptr[c].kind =? 'bool_lit' and nodes.ptr[c].ival not=? 0) {br_to(top);}
        else {jump_if_true(c top);}
    }
    endc();
    endc();
    fp_end(nfp);
    scope_pop();
}
gen_stmt=(s:LGWord):>void=>$unsafe {
    ir_set_pos(nodes.ptr[s].pos);
    let k=nodes.ptr[s].kind
    if k =? 'vardecl' {
        stmt_begin();
        gen_vardecl(s);
        stmt_end();
    }
    else if k =? 'assign' {
        stmt_begin();
        gen_assign(s);
        if eg_stack.length >? 0 {eg_write(LGWord(nodes.ptr[s].a));}
        stmt_end();
    }
    else if k =? 'exprstmt' {
        let a:LGWord=LGWord(nodes.ptr[s].a)
        let ak=nodes.ptr[a].kind
        if ak =? 'match_' or ak =? 'if_' or ak =? 'iflet' {
            let val=gen_expr(a)
            if val.owned and is_managed(ntype(a)) {
                stmt_begin();
                borrow(val ntype(a));
                stmt_end();
            }
            return
        }
        stmt_begin();
        let val=gen_expr(a)
        borrow(val ntype(a));
        stmt_end();
    }
    else if k =? 'if_' or k =? 'iflet' {gen_expr(s);}
    else if k =? 'while_' or k =? 'for_' {
        let n=uq_begin(s)
        if k =? 'while_' {gen_while(s);}
        else {gen_for(s);}
        uq_end(n);
    }
    else if k =? 'return_' {gen_return(s);}
    else if k =? 'break_' or k =? 'continue_' {
        let lp=loops.ptr[loops.length - 1 - LGWord(nodes.ptr[s].ival)]
        drop_held(lp.items lp.built);
        let i=scope_locals.length - 1
        loop i >=? lp.scope {
            emit_scope_exit(i);
            i -= 1;
        }
        if k =? 'break_' {br_to(lp.brk);}
        else {br_to(lp.cont);}
    }
    else if k =? 'defer_' {scope_defers.ptr[scope_defers.length - 1].push(LGWord(nodes.ptr[s].a));}
    else if k =? 'block' {
        if nodes.ptr[s].aux =? 5 {
            gen_block_stmts(s);
            return
        }
        scope_push();
        gen_block_stmts(s);
        scope_pop();
    }
    else if k =? 'const_' {}
    else {fatal(nodes.ptr[s].pos "unsupported statement in codegen");}
}
gen_block_stmts=(b:LGWord):>void=>$unsafe {
    if member_scopes.length >? 0 and nkids(b) >? 1 and member_lower_block(b) {return}
    let guarded=lower_length_guards.length
    loop i in [0..nkids(b)) {
        cur_block=b
        cur_block_i=i
        gen_stmt(kid(b i));
        lower_length_guard(kid(b i));
    }
    lower_length_guards.truncate(guarded);
}
gen_owner_array=(e:LGWord t:LGWord):>Val=>$unsafe {
    let et=telem(t)
    let s=new_temp(t)
    let sa=e_slot(s)
    e_zero(sa tsize(t));
    owner_register(s t);
    building.push(BuildItem[true s t]);
    if nodes.ptr[e].b not=? 0 {
        let value=gen_owned(kid(e 0))
        let n=gen_expr(LGWord(nodes.ptr[e].b)).v
        e_call3(rt("__arr_reserve") sa e_iconst(owner_stride(et)) n -1);
        let i=vreg(VI)
        e_mov(i e_iconst(0));
        blk();
        lop();
        brif_to(e_bin('ges' VI i n) ctl - 1);
        let element=own(Val[value.v false -1] et)
        let dst=e_call2(rt("__arr_push_slot") sa e_iconst(owner_stride(et)) VI)
        store_val(et dst 0 element.v);
        owner_element_live(dst et);
        owner_forget_slot(element.slot);
        e_mov(i e_addi(i 1));
        br_to(ctl);
        endc();
        endc();
        owner_drop(e_slot(value.slot));
    }
    else {
        e_call3(rt("__arr_reserve") sa e_iconst(owner_stride(et)) e_iconst(nkids(e)) -1);
        loop i in [0..nkids(e)) {
            let value=gen_owned(kid(e i))
            let dst=e_call2(rt("__arr_push_slot") sa e_iconst(owner_stride(et)) VI)
            store_val(et dst 0 value.v);
            owner_element_live(dst et);
            owner_forget_slot(value.slot);
        }
    }
    building.pop();
    let result=e_load(VI sa 0 ptr_size)
    owner_values[result] = s;
    return Val[result true s]
}

assign_to=(target:LGWord t:LGWord v:LGWord):>void=>$unsafe {
    if nodes.ptr[target].kind =? 'field' and nodes.ptr[target].aux =? -4 and not swizzle_run(target) {
        # v.zx = w: each component where it goes
        let a:LGWord=LGWord(nodes.ptr[target].a)
        let bt=ntype(a)
        let ty=VS
        let mode=4 | M_FLOAT
        if types.ptr[prune(bt)].sign {
            ty=VI
            mode=4 | M_SIGNED
        }
        let pa=place_addr(gen_place(a true) bt)
        let nm=name_of(LGWord(nodes.ptr[target].name))
        loop i in [0..(nm as array<uint8>).length) {e_store(pa 4 * swizzle_index((nm as array<uint8>).ptr[i]) e_load(ty v 4 * i mode) mode);}
        return
    }
    let f=boxed_field_of(target)
    if f >=? 0 {

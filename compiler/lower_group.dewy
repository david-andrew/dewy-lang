        if op =? 'plus' {return V(e_bin('add' VI p d) false)}
        return V(e_bin('sub' VI p d) false)
    }
    if aux =? 5 {
        let pa=freeze_scalar(gen_expr(a).v lt)
        let pb=gen_expr(b).v
        let d=e_bin('sub' VI pa pb)

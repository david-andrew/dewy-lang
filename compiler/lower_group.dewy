        # Built-in string comparisons invoke no user code. A plain right-hand
        # read cannot invalidate the left value, even through an indexed place.
        # The borrow ends at this comparison; stores, returns and captures keep
        # their ordinary owning path, as does an effectful right operand.
        let plain_string=aux =? 2 and is_cmp and plain_read(b)
        let plain_resource=aux =? 1 and ownership_type(lt) and plain_read(b)
        if not plain_string and not plain_resource and place_var(a) not=? 0 {keep_left=not unchanged_by(a b)}
    }
    if aux =? 1 and byte_eq_type(lt) {
        let r=gen_byte_eq(a b lt keep_left secret_compares.get(e) not=? none)
        if op =? 'ne' {r=e_bin('xor' VI r e_iconst(1))}
        return V(r false)

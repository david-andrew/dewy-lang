    if lt =? T_MATH_INT {
        if is_cmp or math_static_regs.length >? 0 {
            let aw=math_static_bits(a); let bw=math_static_bits(b)
            if aw >? 0 and bw >? 0 {
                if is_cmp {return V(exact_compare(op math_static_value(a) math_static_value(b)) false)}
                let width=math_static_bits(e)
                if width >? 0 and width <=? 256 {return exact_pack_words(e math_static_value(e))}
            }
        }
        if is_cmp and math_proven_word(a) and math_proven_word(b) {
            return V(e_bin(int_op(op true) VI math_word_expr(a) math_word_expr(b)) false)
        }
        if is_cmp {
            let r=math_sum_compare(e)
            if r >=? 0 {return V(r false)}
        }
        if not is_cmp and math_proven_word(e) {return math_pack_word(e math_word_expr(e))}
        let va=gen_left(a lt keep_left)
        if op =? 'shl' or op =? 'shr' {return math_shift(op va math_shift_count(b) types.ptr[prune(ntype(b))].sign)}
        let vb=gen_borrowed(b).v
        if is_cmp {return V(math_compare(op va vb) false)}
        return math_binary(op va vb)
    }
    if aux >=? 7 {return gen_vec_binary(e keep_left)}
    if vc(lt) =? VC_FLT {
        let ty=vt_of(lt)
        let va=freeze_scalar(gen_expr(a).v lt)
        let vb=gen_expr(b).v
        if op =? 'percent' {
            let q=e_un('ftrunc' ty e_bin('fdiv' ty va vb))
            return V(e_bin('fsub' ty va e_bin('fmul' ty q vb)) false)
        }
        return V(e_bin(float_op(op) ty va vb) false)
    # x % 2^k == 0 (or !=): a test of the low bits, for any sign of x
    }
    if (op =? 'eq' or op =? 'ne') and nodes.ptr[b].kind =? 'int_lit' and nodes.ptr[b].ival =? 0 and nodes.ptr[a].kind =? 'binary' and (cx_token_values.ptr[LGWord(nodes.ptr[a].op)]) =? 'percent' and nodes.ptr[a].aux =? 0 {
        let m:LGWord=LGWord(nodes.ptr[a].b)
        if nodes.ptr[m].kind =? 'int_lit' and nodes.ptr[m].ival >? 0 and nodes.ptr[m].ival & (nodes.ptr[m].ival - 1) =? 0 and vc(ntype(LGWord(nodes.ptr[a].a))) =? VC_INT {
            let low=e_bin('and_' VI gen_expr(LGWord(nodes.ptr[a].a)).v e_iconst(nodes.ptr[m].ival - 1))
            return V(e_bin(int_op(op false) VI low e_iconst(0)) false)
        }
    }
    let va=freeze_scalar(gen_expr(a).v lt)
    if op =? 'shr' and int_policy(lt) =? 1 and not types.ptr[lt].sign and types.ptr[lt].bits =? 32 {va=e_un('zext32' VI va)}
    let vb=if op =? 'shl' or op =? 'shr' {math_shift_count(b)} else {gen_expr(b).v}
    let sg=(types.ptr[lt].kind =? 'int_' and types.ptr[lt].sign)
    if int_policy(ntype(e)) =? 2 and op =? 'shl' {return V(saturate_shift(ntype(e) va vb) false)}
    if int_policy(ntype(e)) =? 2 and (op =? 'plus' or op =? 'minus' or op =? 'star') {return V(saturate_binary(op ntype(e) va vb) false)}
    if op =? 'slash' or op =? 'percent' {
        iff(e_bin('eq' VI vb e_iconst(0)));
        e_call_nr1(rt("__div_zero") e_daddr(loc_data(nodes.ptr[e].pos)) -1);
        endc();
    }
    if nodes.ptr[e].aux2 =? -1 and (op =? 'slash' or op =? 'percent') {
        if not sg {return V(e_bin(int_op(op false) VI va vb) false)}
        # Floor remainder by a positive power of two is its low bits, for
        # negative inputs too. Floor division is the matching arithmetic shift.
        let [known divisor]=integer_constant(b)
        if known and divisor >? 0 and divisor & (divisor - 1) =? 0 {
            if op =? 'percent' {return V(e_bin('and_' VI va e_iconst(divisor - 1)) false)}
            let shift:LGWord=0
            loop divisor >? 1 {
                divisor=divisor >> 1
                shift += 1;
            }
            return V(e_bin('shrs' VI va e_iconst(shift)) false)
        # Reuse the lowering range already computed for every write. A
        # nonnegative dividend needs neither signed correction nor MIN/-1.
        }
        if known and divisor >? 0 and positive_bound(a true) >=? 0 {
            return V(e_bin(int_op(op false) VI va vb) false)
        }
        let result=vreg(VI)
        iff(e_bin('eq' VI vb e_iconst(-1)));
        if op =? 'percent' {e_mov(result e_iconst(0));}
        else if int_policy(lt) =? 2 {e_mov(result saturate_binary('minus' lt e_iconst(0) va));}
        else {e_mov(result e_un('neg' VI va));}
        els();
        let quotient=e_bin('divs' VI va vb)
        let remainder=e_bin('rems' VI va vb)
        e_mov(result if op =? 'slash' {quotient} else {remainder});
        # A positive divisor differs in sign from a remainder exactly when that
        # remainder is negative: one predictable test rather than two.
        if known and divisor >? 0 {iff(e_bin('lts' VI remainder e_iconst(0)));}
        else {
            iff(e_bin('ne' VI remainder e_iconst(0)));
            iff(e_bin('lts' VI e_bin('xor' VI remainder vb) e_iconst(0)));
        }
        e_mov(result if op =? 'slash' {e_addi(quotient -1)} else {e_bin('add' VI remainder vb)});
        endc();
        if not (known and divisor >? 0) {endc();}
        endc();
        return V(result false)
    }
    if types.ptr[lt].kind =? 'bool_' and (op =? 'amp' or op =? 'pipe' or op =? 'caret') {
        return V(e_bin(int_op(op false) VI va vb) false)
    }
    if sg and (op =? 'slash' or op =? 'percent') and not (nodes.ptr[b].kind =? 'int_lit' and nodes.ptr[b].ival not=? -1) {
        return V(sdiv_wrap(op va vb lt) false)
    }
    if (op =? 'shl' or op =? 'shr') and dewy_at(nodes.ptr[e].pos) {return V(wide_shift(op sg va vb b) false)}
    let r=e_bin(int_op(op sg) VI va vb)
    if is_cmp {return V(r false)}
    return V(r false)
}
gen_left=(a:LGWord t:LGWord keep:bool):>LGWord=>$unsafe {
    let v=gen_expr(a)
    if keep {
        v=own_at(a v t)
        if vc(t) not=? VC_AGG {
            # Retaining the object does not freeze a local's mutable register.
            v.v = freeze_scalar(v.v t);
        }
    }
    borrow(v t);
    return v.v
}
gen_vec_binary=(e:LGWord keep_left:bool):>Val=>$unsafe {
    let a:LGWord=LGWord(nodes.ptr[e].a)
    let b:LGWord=LGWord(nodes.ptr[e].b)
    let op=cx_token_values.ptr[LGWord(nodes.ptr[e].op)]
    let aux:LGWord=LGWord(nodes.ptr[e].aux)
    let t=ntype(e)
    let s=new_temp(t)
    let d=e_slot(s)
    if aux =? 7 {
        let pa=left_operand_addr(a T_MAT4 keep_left)
        let pb=place_addr(gen_place(b false) T_MAT4)
        e_call3(rt("__mat4_mul") d pa pb -1);
        return Val[d true s]
    }
    if aux =? 8 {
        let pa=left_operand_addr(a T_MAT4 keep_left)
        let pb=place_addr(gen_place(b false) T_VEC4)
        e_call3(rt("__mat4_mul_vec4") d pa pb -1);
        return Val[d true s]
    }
    let integer=types.ptr[prune(t)].sign
    let ty=VS
    let mode=4 | M_FLOAT
    if integer {
        ty=VI
        mode=4 | M_SIGNED
    }
    let n=vec_comps(t)
    let fop=float_op(op)
    if integer {fop=int_op(op true)}
    # + - * / of float vectors: packed SSE arithmetic
    let vk:LGWord=-1
    if op =? 'plus' {vk=0}
    else if op =? 'minus' {vk=1}
    else if op =? 'star' {vk=2}
    else if op =? 'slash' {vk=3}
    if not integer and vk >=? 0 and n >=? 2 and n <=? 4 {
        if aux =? 9 {
            let pa=left_operand_addr(a t keep_left)
            let pb=place_addr(gen_place(b false) t)
            e_vop(d pa pb vk n 0);
        }
        else if aux =? 10 {
            let pa=left_operand_addr(a t keep_left)
            let y=gen_expr(b).v
            e_vop(d pa y vk n VOP_SPLAT_C);
        }
        else {
            let x=freeze_scalar(gen_expr(a).v ntype(a))
            let pb=place_addr(gen_place(b false) t)
            e_vop(d x pb vk n VOP_SPLAT_B);
        }
        return Val[d true s]
    }
    if aux =? 9 {
        let pa=left_operand_addr(a t keep_left)
        let pb=place_addr(gen_place(b false) t)
        loop i in [0..n) {
            let x=e_load(ty pa 4 * i mode)
            let y=e_load(ty pb 4 * i mode)
            let r=e_bin(fop ty x y)
            if integer {r=e_un('sext32' VI r)}
            e_store(d 4 * i r mode);
        }
        return Val[d true s]
    }
    if aux =? 10 {
        let pa=left_operand_addr(a t keep_left)
        let y=gen_expr(b).v
        loop i in [0..n) {
            let x=e_load(ty pa 4 * i mode)
            let r=e_bin(fop ty x y)
            if integer {r=e_un('sext32' VI r)}
            e_store(d 4 * i r mode);
        }
        return Val[d true s]
    }
    let x=freeze_scalar(gen_expr(a).v ntype(a))
    let pb=place_addr(gen_place(b false) t)
    loop i in [0..n) {
        let y=e_load(ty pb 4 * i mode)
        let r=e_bin(fop ty x y)
        if integer {r=e_un('sext32' VI r)}
        e_store(d 4 * i r mode);
    }
    return Val[d true s]
}
gen_vec_ctor=(e:LGWord):>Val=>$unsafe {
    let t=ntype(e)
    let s=new_temp(t)
    let d=e_slot(s)
    let n=vec_comps(t)
    let integer=types.ptr[prune(t)].sign
    let mode=4 | M_FLOAT
    if integer {mode=4 | M_SIGNED}
    if nkids(e) =? 0 {
        e_zero(d tsize(t));
        if t =? T_MAT4 {
            let one=e_fconst(1.0 VS)
            loop i in [0..4) {e_store(d 4 * (i * 5) one mode);}
        }
        return Val[d true s]
    }
    if nkids(e) =? 1 and vc(ntype(kid(e 0))) not=? VC_AGG {
        let v=gen_expr(kid(e 0)).v
        if t =? T_MAT4 {
            e_zero(d 64);
            loop i in [0..4) {e_store(d 4 * (i * 5) v mode);}
        }
        else {
            loop i in [0..n) {e_store(d 4 * i v mode);}
        }
        return Val[d true s]
    }
    let k:LGWord=0
    loop i in [0..nkids(e)) {
        let a=kid(e i)
        let at=ntype(a)
        if vc(at) =? VC_AGG {
            let pa=gen_expr(a).v
            # (from a vector of the other kind: each component converted, as a scalar would be)
            let from_int=types.ptr[prune(at)].sign
            loop j in [0..vec_comps(at)) {
                let x:LGWord=0
                if from_int {x=e_load(VI pa 4 * j 4 | M_SIGNED)}
                else {x=e_load(VS pa 4 * j 4 | M_FLOAT)}
                if from_int and not integer {x=e_un('i2f' VS x)}
                else if integer and not from_int {x=f2i_i32(x)}
                e_store(d 4 * k x mode);
                k += 1;
            }
        }
        else {
            e_store(d 4 * k gen_expr(a).v mode);
            k += 1;
        }
    }
    return Val[d true s]
}
gen_swizzle=(e:LGWord):>Val=>$unsafe {
    let a:LGWord=LGWord(nodes.ptr[e].a)
    let bt=ntype(a)
    let nm=name_of(LGWord(nodes.ptr[e].name))
    let integer=types.ptr[prune(bt)].sign
    let ty=VS
    let mode=4 | M_FLOAT
    if integer {
        ty=VI
        mode=4 | M_SIGNED
    }
    let pa=place_addr(gen_place(a false) bt)
    if (nm as array<uint8>).length =? 1 {return V(e_load(ty pa 4 * swizzle_index((nm as array<uint8>).ptr[0]) mode) false)}
    let t=ntype(e)
    let s=new_temp(t)
    let d=e_slot(s)
    loop i in [0..(nm as array<uint8>).length) {e_store(d 4 * i e_load(ty pa 4 * swizzle_index((nm as array<uint8>).ptr[i]) mode) mode);}
    return Val[d true s]
}
gen_intrinsic=(e:LGWord):>Val=>$unsafe {
    if (effects_active or effect_policy.prohibitions not=? 0) and e not=? fixed_fill_push {effect_lower_intrinsic(cur_fn e);}
    let id=nodes.ptr[e].aux as IN
    let arg_start:LGWord=LGWord(nodes.ptr[e].list)
    let arg_count=nkids(e)
    if partition_mode and id =? IN.len and arg_count =? 1 {
        let desc=partition_descriptor(LGWord(lists.ptr[arg_start]))
        if desc >=? 0 {return V(partition_lengths[LGWord(nodes.ptr[LGWord(lists.ptr[arg_start])].sym)] false)}
    }
    # Patterns use the frozen IN ordinals; calls stay direct across the group.
    match int64(id) {
        <71> => {return gen_intrinsic_lend(e arg_start)} # IN.lend
        <72> => {return gen_intrinsic_loan_address(e arg_start)} # IN.loan_address
        <73> => {return gen_intrinsic_loan_load(e arg_start)} # IN.loan_load
        <74> => {return gen_intrinsic_loan_store(e arg_start)} # IN.loan_store
        <75> => {return gen_intrinsic_loan_length(e arg_start)} # IN.loan_length
        <1> => {return gen_intrinsic_len(e arg_start)} # IN.len
        <27> => {return gen_intrinsic_len(e arg_start)} # IN.arrcap
        <78> => {return gen_intrinsic_take_slot(e arg_start)} # IN.take_slot
        <77> => {return gen_intrinsic_relocate(e arg_start)} # IN.relocate
        <2> => {return gen_intrinsic_push(e arg_start)} # IN.push
        <3> => {return gen_intrinsic_pop(e arg_start)} # IN.pop
        <4> => {return gen_intrinsic_insert(e arg_start)} # IN.insert
        <5> => {return gen_intrinsic_remove(e arg_start)} # IN.remove
        <6> => {return gen_intrinsic_clear(e arg_start)} # IN.clear
        <43> => {return gen_intrinsic_extend(e arg_start)} # IN.extend
        <7> => {return gen_intrinsic_reserve(e arg_start)} # IN.reserve
        <23> => {return gen_intrinsic_resize(e arg_start)} # IN.resize
        <22> => {return gen_intrinsic_resize(e arg_start)} # IN.truncate
        <21> => {return gen_intrinsic_resize(e arg_start)} # IN.setlen
        <13> => {return gen_intrinsic_arrdata(e arg_start)} # IN.arrdata
        <81> => {return gen_intrinsic_arrdata(e arg_start)} # IN.task_data
        <9> => {return gen_intrinsic_syscall(e arg_start arg_count)} # IN.syscall
        <33> => {return gen_intrinsic_callc(e arg_start arg_count)} # IN.callc
        <10> => {return gen_intrinsic_memcpy(e arg_start)} # IN.memcpy
        <76> => {return gen_intrinsic_zeroed(e arg_start)} # IN.zeroed
        <11> => {return gen_intrinsic_memset(e arg_start)} # IN.memset
        <14> => {return gen_intrinsic_panic(e arg_start arg_count)} # IN.panic
        <26> => {return gen_intrinsic_unreachable(e arg_start)} # IN.unreachable
        <66> => {return V(-1 false)} # IN.static_assert
        <15> => {return gen_intrinsic_assert(e arg_start arg_count)} # IN.assert
        <67> => {return gen_intrinsic_assert(e arg_start arg_count)} # IN.runtime_assert
        <17> => {return gen_intrinsic_embed(e arg_start)} # IN.embed
        <19> => {return gen_intrinsic_to_bytes(e arg_start)} # IN.to_bytes
        <20> => {return gen_intrinsic_argv(e arg_start)} # IN.argv
        <39> => {return gen_intrinsic_setjmp(e arg_start arg_count)} # IN.setjmp
        <40> => {return gen_intrinsic_setjmp(e arg_start arg_count)} # IN.longjmp
        <41> => {return gen_intrinsic_setjmp(e arg_start arg_count)} # IN.jump
        <44> => {return gen_intrinsic_setjmp(e arg_start arg_count)} # IN.clone_thread
        <45> => {return gen_intrinsic_setjmp(e arg_start arg_count)} # IN.atomic_add
        <46> => {return gen_intrinsic_setjmp(e arg_start arg_count)} # IN.atomic_cas
        <47> => {return gen_intrinsic_setjmp(e arg_start arg_count)} # IN.stack_ptr
        <51> => {return gen_intrinsic_setjmp(e arg_start arg_count)} # IN.cpu_features
        <52> => {return gen_intrinsic_setjmp(e arg_start arg_count)} # IN.code_sync
        <29> => {return gen_intrinsic_sqrt(e arg_start)} # IN.sqrt
        <85> => {return gen_intrinsic_mul_hi(e arg_start)} # IN.mul_hi
        <24> => {return gen_intrinsic_hash(e arg_start)} # IN.hash
        <28> => {return gen_fmt_struct(e)} # IN.fmt_struct
        <63> => {return gen_json_fields(e)} # IN.json_fields
        <50> => {return gen_intrinsic_gpu_kernel(e arg_start)} # IN.gpu_kernel
        <54> => {return gen_intrinsic_compute_spirv(e arg_start)} # IN.compute_spirv
        <55> => {return gen_intrinsic_compute_textures(e arg_start)} # IN.compute_textures
        <42> => {return gen_intrinsic_shader(e arg_start)} # IN.shader
        <30> => {return gen_vec_ctor(e)} # IN.vec_ctor
        _ => {fatal(nodes.ptr[e].pos "intrinsic not supported in codegen");}
    }
    return V(-1 false)
}
gen_intrinsic_lend=(e:LGWord arg_start:LGWord):>Val=>$unsafe {
    let arg0:LGWord=LGWord(lists.ptr[arg_start])
    let arg1:LGWord=LGWord(lists.ptr[arg_start + 1])
    let arg2:LGWord=LGWord(lists.ptr[arg_start + 2])
    let extra=gen_expr(arg1).v
    let pl=gen_place(arg0 has_flag(e NF_MUT))
    let at=ntype(arg0)
    let length=arr_len(read_place(pl at))
    let limit=e_bin('add' VI length extra)
    iff(e_bin('or_' VI e_bin('lts' VI extra e_iconst(0)) e_bin('lts' VI limit length)));
    e_call_nr1(rt("__panic") e_daddr(str_data("invalid scoped loan reservation")) -1);
    endc();
    if has_flag(e NF_MUT) {
        arr_unique(pl at);
        let sa=place_addr(pl at)
        e_call3(rt("__arr_reserve") sa e_iconst(1) limit -1);
        if not pl.mem {e_mov(pl.v e_load(VI sa 0 ptr_size));}
    }
    loan_capacities.push(LoanCapacity[place_route(arg0) limit]);
    let result=gen_expr(arg2)
    loan_capacities.pop();
    return result
}
gen_intrinsic_loan_address=(e:LGWord arg_start:LGWord):>Val=>$unsafe {
    let arg0:LGWord=LGWord(lists.ptr[arg_start])
    let p=gen_borrowed(arg0).v
    let r=vreg(VI)
    e_mov(r e_iconst(0));
    iff(e_bin('ne' VI p e_iconst(0)));
    e_mov(r e_addi(p 24));
    endc();
    return V(r false)
}
gen_intrinsic_loan_load=(e:LGWord arg_start:LGWord):>Val=>$unsafe {
    let arg0:LGWord=LGWord(lists.ptr[arg_start])
    return V(e_load(VI gen_expr(arg0).v 0 1) false)
}
gen_intrinsic_loan_store=(e:LGWord arg_start:LGWord):>Val=>$unsafe {
    let arg0:LGWord=LGWord(lists.ptr[arg_start])
    let arg1:LGWord=LGWord(lists.ptr[arg_start + 1])
    let value=gen_expr(arg0).v
    let address=gen_expr(arg1).v
    e_store(address 0 value 1);
    return V(-1 false)
}
gen_intrinsic_loan_length=(e:LGWord arg_start:LGWord):>Val=>$unsafe {
    let arg0:LGWord=LGWord(lists.ptr[arg_start])
    let arg1:LGWord=LGWord(lists.ptr[arg_start + 1])
    let length=gen_expr(arg1).v
    let p=place_route(arg0)
    loop loan in loan_capacities {
        if loan.place =? p {
            iff(e_bin('or_' VI e_bin('lts' VI length e_iconst(0)) e_bin('gts' VI length loan.limit)));
            e_call_nr1(rt("__panic") e_daddr(str_data("scoped loan length exceeds reservation")) -1);
            endc();
        }
    }
    let address=gen_borrowed(arg0).v
    iff(e_bin('ne' VI address e_iconst(0)));
    hdr_store(address 8 length);
    endc();
    return V(-1 false)
}
gen_intrinsic_len=(e:LGWord arg_start:LGWord):>Val=>$unsafe {
    let arg0:LGWord=LGWord(lists.ptr[arg_start])
    let id=nodes.ptr[e].aux as IN
    let at=prune(ntype(arg0))
    if id =? IN.len {
        let scalar=parallel_scalar_length(arg0)
        if scalar >=? 0 {return V(e_iconst(scalar) false)}
    }
    if id =? IN.len and types.ptr[at].kind =? 'fixed' {
        gen_borrowed(arg0);
        return V(e_iconst(fixed_len(at)) false)
    }
    if id =? IN.len {
        let fixed=fixed_path_of(arg0)
        if fixed >=? 0 {return V(fixed_paths.ptr[fixed].len false)}
    }
    let p=gen_borrowed(arg0).v
    let r=vreg(VI)
    e_mov(r e_iconst(0));
    iff(e_bin('ne' VI p e_iconst(0)));
    let off:LGWord=8
    if id =? IN.arrcap {off=16}
    e_mov(r e_load(VI p off 8));
    endc();
    return V(r false)
}
gen_intrinsic_take_slot=(e:LGWord arg_start:LGWord):>Val=>$unsafe {
    let arg0:LGWord=LGWord(lists.ptr[arg_start])
    let arg1:LGWord=LGWord(lists.ptr[arg_start + 1])
    let at=ntype(arg0)
    let et=telem(at)
    let pl=gen_place(arg0 true)
    let index=gen_expr(arg1).v
    arr_unique(pl at);
    let p=read_place(pl at)
    bounds_check(p index nodes.ptr[e].pos);
    let ea=e_bin('add' VI e_addi(p 24) e_bin('mul' VI index e_iconst(owner_stride(et))))
    let slot=new_temp(et)
    store_val(et e_slot(slot) 0 load_val(et ea 0));
    e_zero(ea owner_stride(et));
    return result_from_slot(slot et)
}
gen_intrinsic_relocate=(e:LGWord arg_start:LGWord):>Val=>$unsafe {
    let arg0:LGWord=LGWord(lists.ptr[arg_start])
    let arg1:LGWord=LGWord(lists.ptr[arg_start + 1])
    let arg2:LGWord=LGWord(lists.ptr[arg_start + 2])
    let at=ntype(arg0)
    let et=telem(at)
    let pl=gen_place(arg0 true)
    let dst=gen_expr(arg1).v
    let src=gen_expr(arg2).v
    arr_unique(pl at);
    let p=read_place(pl at)
    let da=e_bin('add' VI e_addi(p 24) e_bin('mul' VI dst e_iconst(owner_stride(et))))

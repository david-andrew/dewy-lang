            if resource {hdr_store(env 24 e_iconst(index));}
            continue
        }
        let t:LGWord=LGWord(locals.ptr[outer].type)
        let id=if copies_on {ids.ptr[index]} else {mk_ident_local(outer nodes.ptr[e].pos)}
        if math_word_captures.has(inn) {

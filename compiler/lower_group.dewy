gen_range_cond=(e:LGWord invert:bool=false):>LGWord=>$unsafe {
    let k=nodes.ptr[e].kind
    if k not=? 'and_' and k not=? 'or_' {return -1}
    let a=range_cmp(LGWord(nodes.ptr[e].a))
    if a[0] =? 0 {return -1}
    let b=range_cmp(LGWord(nodes.ptr[e].b))
    if b[0] =? 0 or not same_range_read(a[0] b[0]) {return -1}
    let first_read=a[0]
    let mathematical=prune(ntype(first_read)) =? T_MATH_INT
    if mathematical and not math_proven_word(first_read) {return -1}
    if k =? 'or_' {
        a[1] = if a[1] =? 'lt' {'ge'} else if a[1] =? 'le' {'gt'} else if a[1] =? 'gt' {'le'} else {'lt'};
        b[1] = if b[1] =? 'lt' {'ge'} else if b[1] =? 'le' {'gt'} else if b[1] =? 'gt' {'le'} else {'lt'};
    }
    if a[1] =? 'lt' or a[1] =? 'le' {
        let tmp=a
        a=b
        b=tmp
    }
    if (a[1] not=? 'gt' and a[1] not=? 'ge') or (b[1] not=? 'lt' and b[1] not=? 'le') {return -1}
    let low:LGWord=LGWord(a[2])
    let high:LGWord=LGWord(b[2])
    let empty=false
    if a[1] =? 'gt' {
        if low =? 9223372036854775807 {empty=true}
        else {low += 1;}
    }
    if b[1] =? 'lt' {
        if high =? -9223372036854775807 - 1 {empty=true}
        else {high -= 1;}
    }
    let outside=(k =? 'or_') not=? invert
    # Even an empty interval must evaluate its first read and retain bounds checks.
    let value=if mathematical {math_word_expr(first_read)} else {gen_expr(first_read).v}
    if empty or low >? high {return e_iconst((if outside {1} else {0}))}
    if low not=? 0 {value=e_bin('sub' VI value e_iconst(low))}
    let op=if outside {Op.gtu} else {Op.leu}
    return e_bin(op VI value e_iconst(high - low))
}
cond_leaf=(e:LGWord):>LGWord=>$unsafe {

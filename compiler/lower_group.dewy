# Direct recursive lowering; shared state has one owner in lower.jo.
LGWord:type=int64<overflow='wrap'>
LGUWord:type=uint64<overflow='wrap'>
LGI32:type=int32<overflow='wrap'>
gen_owned=(e:LGWord):>Val=>$unsafe {
    if copies_on {return copy_own(e gen_expr(e) ntype(e))}
    return own(gen_expr(e) ntype(e))
}
gen_borrowed=(e:LGWord):>Val=>$unsafe {
    let v=gen_expr(e)
    borrow(v ntype(e));
    return Val[v.v false -1]
}
emit_scope_exit=(i:LGWord):>void=>$unsafe {
    let ds=scope_defers.ptr[i]
    let k=ds.length - 1
    loop k >=? 0 {
        let d=ds.ptr[k]
        let saved=scope_defers.ptr[i]
        scope_defers.ptr[i] = ds[..k);
        if concurrency_runtime_needed {e_call0(rt("__task_shield_enter") -1);}
        if nodes.ptr[d].kind =? 'block' {
            scope_push();
            gen_block_stmts(d);
            emit_scope_exit(scope_locals.length - 1);
            scope_locals.pop();
            scope_defers.pop();
        }
        else {gen_stmt(d);}
        if concurrency_runtime_needed {e_call0(rt("__task_shield_leave") -1);}
        scope_defers.ptr[i] = saved;
        k -= 1;
    }
    let ls=scope_locals.ptr[i]
    k=ls.length - 1
    loop k >=? 0 {
        let l=ls.ptr[k]
        let t=store_type(l)
        if parallel_owned.has(l) {
            loop value in parallel_scalars[l] {
                release(value parallel_owned[l]);
                e_mov(value e_iconst(0));
            }
        }
        else if exm_drop_local(l) {}
        else if locals.ptr[l].offset >=? 0 {
            let a=e_slot(LGWord(locals.ptr[l].offset))
            let target=if tkind(t) =? 'fn_' or tkind(t) =? 'polyfn' {stack_closure_target(l)} else {-1}
            if target >=? 0 {drop_stack_closure(a target);}
            else {drop_at(a t);}
            if target <? 0 or not closure_scalar_environment(target) {e_zero(a tsize(t));}
        }
        else {
            release(LGWord(locals.ptr[l].vreg) t);
            e_mov(LGWord(locals.ptr[l].vreg) e_iconst(0));
        }
        k -= 1;
    }
    if i =? 0 {owner_leave_captures()}
}
scope_pop=():>void=>$unsafe {
    emit_scope_exit(scope_locals.length - 1);
    scope_locals.pop();
    scope_defers.pop();
}
local_place=(l:LGWord write:bool):>Place=>$unsafe {
    let f:LGWord=LGWord(locals.ptr[l].flags)
    if f & LF_OWNERBORROW not=? 0 {return Place[true e_load(VI env_v LGWord(locals.ptr[l].env_off) ptr_size)]}
    if f & LF_ALIAS not=? 0 {return gen_place(LGWord(locals.ptr[l].alias) write)}
    if is_shared(l) {return Place[true e_addi(read_place(cell_place(l) store_type(l)) 24)]}
    if f & LF_CAPTURE not=? 0 {return Place[true e_addi(env_v LGWord(locals.ptr[l].env_off))]}
    if f & LF_BYREF not=? 0 {
        let v:LGWord=LGWord(locals.ptr[l].vreg)
        if f & LF_HELDVIEW not=? 0 and tkind(LGWord(locals.ptr[l].type)) =? 'opt' {v=box_val(v LGWord(locals.ptr[l].type))}
        return Place[true v]
    }
    if f & LF_PARAM not=? 0 {
        if f & LF_MUTPARAM not=? 0 or vc(LGWord(locals.ptr[l].type)) =? VC_AGG {return Place[true LGWord(locals.ptr[l].vreg)]}
    }
    if locals.ptr[l].offset >=? 0 {return Place[true e_slot(LGWord(locals.ptr[l].offset))]}
    return Place[false LGWord(locals.ptr[l].vreg)]
}
gen_index=(n:LGWord):>LGWord=>$unsafe {
    if frozen.length >? 0 {
        let v=frozen.get(n)
        if v not=? none {return v}
    }
    return gen_expr(n).v
}
gen_place=(e:LGWord write:bool):>Place=>$unsafe {
    let k=nodes.ptr[e].kind
    if k =? 'ident' {
        if nodes.ptr[e].aux =? LGI32(1) {return local_place(LGWord(nodes.ptr[e].sym) write)}
        if nodes.ptr[e].aux =? LGI32(2) {return Place[true e_gaddr(global_addr_off(LGWord(nodes.ptr[e].sym)))]}
    }
    else if k =? 'field' {
        let a:LGWord=LGWord(nodes.ptr[e].a)
        let bt=prune(ntype(a))
        let slot=box_slot
        box_slot=false
        if nodes.ptr[e].aux =? -3 {
            let base=gen_place(a write)
            let si:LGWord=LGWord(types.ptr[bt].st)
            layout(bt);
            let v:LGWord=LGWord(structs.ptr[si].variants) + LGWord(nodes.ptr[e].aux2)
            return field_place(LGWord(variants.ptr[v].fields) + LGWord(nodes.ptr[e].ival) place_addr(base bt) write slot)
        }
        if nodes.ptr[e].aux =? -4 and swizzle_run(e) {
            let base=gen_place(a write)
            let ci=swizzle_index((name_of(LGWord(nodes.ptr[e].name)) as array<uint8>).ptr[0])
            return Place[true e_addi(place_addr(base bt) ci * 4)]
        # (.zx and the like are no place: read into a temporary, and assign_to writes them a
        # component at a time)
        }
        if nodes.ptr[e].aux =? -4 {
            if write {ice("a swizzle out of order as a place at {pos_str(nodes.ptr[e].pos)}");}
            return Place[true gen_expr(e).v]
        }
        let addr:LGWord=0
        if types.ptr[bt].kind =? 'ptr' {
            ir.raw_mem = true;
            addr=gen_expr(a).v
            bt=prune(LGWord(types.ptr[bt].elem))
        }
        else {
            let base=gen_place(a write)
            addr=place_addr(base bt)
        }
        layout(bt);
        if types.ptr[bt].kind =? 'tuple' {return Place[true e_addi(addr tuple_off(bt nodes.ptr[e].ival))]}
        return field_place(LGWord(structs.ptr[LGWord(types.ptr[bt].st)].fields) + LGWord(nodes.ptr[e].aux) addr write slot)
    }
    else if k =? 'index' {
        if partition_slice(e) {fatal(nodes.ptr[e].pos "mutable slices require a direct nonescaping call");}
        let a:LGWord=LGWord(nodes.ptr[e].a)
        let bt=prune(ntype(a))
        let bk=types.ptr[bt].kind
        if bk =? 'ptr' {
            ir.raw_mem = true;
            let direct=nodes.ptr[a].kind =? 'intrinsic' and (nodes.ptr[a].aux as IN) =? IN.arrdata and nkids(a) =? 1
            let p:LGWord=0
            let i:LGWord=0
            if direct and nodes.ptr[kid(a 0)].kind =? 'ident' {
                # As with checked array indexing, a call in the index may grow the
                # named array. Locate its current elements after that call.
                i=gen_index(LGWord(nodes.ptr[e].b))
                p=arrdata_elements(a)
            } else {
                p=if direct {arrdata_elements(a)} else {gen_expr(a).v}
                i=gen_index(LGWord(nodes.ptr[e].b))
            }
            let sz=tsize(LGWord(types.ptr[bt].elem))
            return Place[true e_bin('add' VI p e_bin('mul' VI i e_iconst(sz)))]
        }
        if bk =? 'array' {
            let desc=partition_descriptor(a)
            if desc >=? 0 {
                let idx=gen_index(LGWord(nodes.ptr[e].b))
                let length=partition_lengths[LGWord(nodes.ptr[a].sym)]
                if not has_flag(e NF_INBOUNDS) and not (partition_proven.get(e) ?? false) and index_safety(a LGWord(nodes.ptr[e].b)) =? 0 {
                    iff(e_bin('geu' VI idx length));
                    e_call_nr3(rt("__panic_bounds") idx length e_daddr(loc_data(nodes.ptr[e].pos)) -1);
                    endc();
                }
                let data=partition_data[LGWord(nodes.ptr[a].sym)]
                return Place[true e_bin('add' VI data e_bin('mul' VI idx e_iconst(tsize(telem(bt)))))]
            }
            let fi=fixed_path_of(a)
            if fi >=? 0 {
                let fp=fixed_paths.ptr[fi]
                let ixn:LGWord=LGWord(nodes.ptr[e].b)
                let idx=gen_index(ixn)
                let by_loopvar=fp.loopvar >=? 0 and nodes.ptr[ixn].kind =? 'ident' and nodes.ptr[ixn].aux =? LGI32(1) and LGWord(nodes.ptr[ixn].sym) =? fp.loopvar
                if not by_loopvar and not has_flag(e NF_INBOUNDS) and index_safety(a ixn) =? 0 {
                    iff(e_bin('geu' VI idx fp.len));
                    e_call_nr3(rt("__panic_bounds") idx fp.len e_daddr(loc_data(nodes.ptr[e].pos)) -1);
                    endc();
                }
                let sz=owner_stride(LGWord(types.ptr[bt].elem))
                return Place[true e_bin('add' VI e_addi(fp.arr 24) e_bin('mul' VI idx e_iconst(sz)))]
            }
            let arr:LGWord=0
            let idx:LGWord=0
            if write {
                let base=gen_place(a true)
                if not is_uniq_array(a) {arr_unique(base bt);}
                idx=gen_index(LGWord(nodes.ptr[e].b))
                arr=read_place(base bt)
                # re-read: evaluating the index cannot change the array place
            }
            else if nodes.ptr[a].kind =? 'ident' {
                # (the index first: a call in it may change the array, as nodes[mk()] grows nodes)
                idx=gen_index(LGWord(nodes.ptr[e].b))
                arr=gen_borrowed(a).v
            }
            else {
                arr=gen_borrowed(a).v
                idx=gen_index(LGWord(nodes.ptr[e].b))
            }
            let safety=index_safety(a LGWord(nodes.ptr[e].b))
            if has_flag(e NF_INBOUNDS) {safety=1}
            if safety =? 0 {bounds_check(arr idx nodes.ptr[e].pos);}
            else if safety =? 2 and opt_release {null_check(arr idx nodes.ptr[e].pos);}
            let sz=owner_stride(LGWord(types.ptr[bt].elem))
            return Place[true e_bin('add' VI e_addi(arr 24) e_bin('mul' VI idx e_iconst(sz)))]
        }
        if bk =? 'str_' {
            let idx:LGWord=0
            let arr:LGWord=0
            if nodes.ptr[a].kind =? 'ident' {
                idx=gen_index(LGWord(nodes.ptr[e].b))
                arr=gen_borrowed(a).v
            }
            else {
                arr=gen_borrowed(a).v
                idx=gen_index(LGWord(nodes.ptr[e].b))
            # (as for arrays: an index a loop keeps below the string's length needs no check)
            }
            let safety=index_safety(a LGWord(nodes.ptr[e].b))
            if has_flag(e NF_INBOUNDS) {safety=1}
            if safety =? 0 {bounds_check(arr idx nodes.ptr[e].pos);}
            else if safety =? 2 and opt_release {null_check(arr idx nodes.ptr[e].pos);}
            return Place[true e_bin('add' VI e_addi(arr 24) idx)]
        }
        if bk =? 'fixed' {
            let base=gen_place(a write)
            let ixn:LGWord=LGWord(nodes.ptr[e].b)
            let idx=gen_index(ixn)
            let n=fixed_len(bt)
            # (a constant index was checked by the compiler)
            if nodes.ptr[ixn].kind not=? 'int_lit' and not has_flag(e NF_INBOUNDS) and not fixed_index_domain(ixn n) {
                iff(e_bin('geu' VI idx e_iconst(n)));
                e_call_nr3(rt("__panic_bounds") idx e_iconst(n) e_daddr(loc_data(nodes.ptr[e].pos)) -1);
                endc();
            }
            let esz=tsize(LGWord(types.ptr[bt].elem))
            return Place[true e_bin('add' VI place_addr(base bt) e_bin('mul' VI idx e_iconst(esz)))]
        }
        if bk =? 'vec' {
            let base=gen_place(a write)
            let idx=gen_index(LGWord(nodes.ptr[e].b))
            let esz:LGWord=4
            if bt =? T_MAT4 {esz=16}
            return Place[true e_bin('add' VI place_addr(base bt) e_bin('mul' VI idx e_iconst(esz)))]
        }
    }
    else if k =? 'unwrap' {
        let a:LGWord=LGWord(nodes.ptr[e].a)
        let ot=prune(ntype(a))
        if math_optional(ot) {
            let base=gen_place(a write)
            iff(e_bin('eq' VI read_place(base ot) e_iconst(0)));
            e_call_nr1(rt("__panic_unwrap") e_daddr(loc_data(nodes.ptr[e].pos)) -1);
            endc();
            return Place[base.mem base.v true]
        }
        let view=held_opt_reg(a)
        let addr:LGWord=0
        let has:LGWord=0
        if view >=? 0 {
            addr=e_addi(view BOX_HDR)
            has=view
        }
        else {
            let base=gen_place(a write)
            addr=place_addr(base ot)
            has=opt_has(addr LGWord(types.ptr[ot].elem))
        }
        iff(e_bin('eq' VI has e_iconst(0)));
        e_call_nr1(rt("__panic_unwrap") e_daddr(loc_data(nodes.ptr[e].pos)) -1);
        endc();
        return Place[true addr math_optional(ot)]
    }
    else if k =? 'narrow' {
        # a union variable known (by `is`) to hold member aux: checked, since a closure could
        # have changed it
        let a:LGWord=LGWord(nodes.ptr[e].a)
        let ut=prune(ntype(a))
        layout(ut);
        let base=gen_place(a write)
        let addr=place_addr(base ut)
        let vi:LGWord=LGWord(nodes.ptr[e].aux)
        iff(e_bin('ne' VI e_load(VI addr 0 4) e_iconst(vi)));
        e_call_nr1(rt("__panic_narrow") e_daddr(loc_data(nodes.ptr[e].pos)) -1);
        endc();
        let v:LGWord=LGWord(structs.ptr[LGWord(types.ptr[ut].st)].variants) + vi
        return Place[true e_addi(addr LGWord(fields.ptr[LGWord(variants.ptr[v].fields)].offset))]
    # not a place: evaluate into a temporary
    }
    let t=ntype(e)
    if tkind(t) =? 'typeval' or tkind(t) =? 'module' {type_as_value(e);}
    let val=gen_expr(e)
    if vc(t) =? VC_AGG {
        borrow(val t);
        return Place[true val.v]
    }
    if val.owned {reg_temp_vreg(val.v t);}
    return Place[false val.v]
}
call_args=(args:array<int64> ptypes:array<int64> mutmask:LGWord @out:array<int64> callee:LGWord=0 order:array<int64>=[] slots:array<int64>=[]):>void=>$unsafe {
    if order.length >? 0 {
        let ordered_args:array<int64>=[]
        let ordered_types:array<int64>=[]
        let ordered_mut:LGWord=0
        loop i in [0..order.length) and slot in order {
            ordered_args.push(args.ptr[slot]);
            ordered_types.push(ptypes.ptr[slot]);
            if mutmask & (1 << slot) not=? 0 {ordered_mut |= 1 << i;}
        }
        let values:array<int64>=[]
        call_args(ordered_args ordered_types ordered_mut @values callee slots = order);
        let base=out.length
        out.resize(base + order.length);
        loop i in [0..order.length) and slot in order {out.ptr[base + slot] = values.ptr[i];}
        return
    }
    let any_mut=mutmask not=? 0
    # Dewy functions initialize their private value parameters on entry. For
    # the last evaluated argument there is no intervening evaluation requiring
    # another callback snapshot. Unknown/implementation callees still borrow
    # parameters, so the caller must give them an independent callable value.
    let dewy_entry=callee >? 0 and fns.ptr[callee].decl not=? 0 and files.ptr[pos_file(nodes.ptr[LGWord(fns.ptr[callee].decl)].pos)].is_dewy
    if any_mut {mut_alias_check(args mutmask callee);}
    loop i in [0..args.length) and a in args {
        if mutmask & (1 << i) not=? 0 {
            if partition_slice(a) {fatal(nodes.ptr[a].pos "mutable slices require a direct nonescaping call");}
            if copy_through(a callee) {
                out.push(copy_in(a));
                continue
            }
            pinned_box=-1
            let p=gen_place(a true)
            out.push(place_addr(p ntype(a)));
            # (a place in a box: the box kept, with a reference of the statement's, while the
            # call runs, which may give what holds it another value)
            if pinned_box >=? 0 {
                let c=vreg(VI)
                e_mov(c pinned_box);
                retain(c pinned_type);
                reg_temp_vreg(c pinned_type);
            }
            continue
        }
        let pt=ntype(a)
        if i <? ptypes.length {pt=ptypes.ptr[i]}
        if copies_on {
            let parameter=if slots.length =? 0 {i} else {slots.ptr[i]}
            if copy_consumes(callee parameter) {
                let val=gen_owned(a)
                out.push(val.v);
                continue
            }
        }
        let value_node=a
        if nodes.ptr[a].kind =? 'conv' and nodes.ptr[a].aux =? LGI32(14) {value_node=LGWord(nodes.ptr[a].a)}
        let parameter=if slots.length =? 0 {i} else {slots.ptr[i]}
        let literal=nodes.ptr[value_node].kind =? 'lambda' and files.ptr[pos_file(nodes.ptr[a].pos)].is_dewy and not has_flag(value_node NF_GENERIC)
        let stack=literal and closure_env_shareable(LGWord(nodes.ptr[value_node].sym)) and closure_borrow_param(callee parameter)
        let val=if stack {gen_lambda(value_node true)} else {gen_expr(value_node)}
        # A scalar can live in a local's mutable vreg. Capture its value before
        # a later argument reassigns that local, just as we retain managed data.
        if i + 1 <? args.length and vc(pt) not=? VC_AGG {val.v = freeze_scalar(val.v pt);}
        if not val.owned and (not dewy_entry or i + 1 <? args.length) and type_has_fn(pt) and not callback_arg_borrow(value_node args i callee parameter) and files.ptr[pos_file(nodes.ptr[a].pos)].is_dewy {val=own_at(a val pt)}
        let mut_snapshot=any_mut
        if copies_on and (copy_strict(a) or ownership_type(pt)) {mut_snapshot=any_mut and shares_mut_root(a args mutmask (if slots.length =? 0 {callee} else {-1}))}
        else if any_mut {mut_snapshot=mut_may_reach(a args mutmask)}
        let snapshot=false
        if not val.owned and is_managed(pt) and (mut_snapshot or borrow_may_change(a args i callee)) {
            val=own_at(a val pt)
            snapshot=true
        # (a struct passed by its address, in memory that a `mut` argument of the same call
        # reaches, f(p, p.hs[0]): the callee writing p would change it, so a copy; or that the
        # callee changes by name)
        }
        else if not val.owned and vc(pt) =? VC_AGG and ((any_mut and shares_mut_root(a args mutmask)) or borrow_may_change(a args i callee)) {
            val=own_at(a val pt)
            snapshot=true
        # Invocation-only callees cannot retain this stack environment. Keep
        # its captures alive through the statement, then destroy them directly.
        }
        if stack {reg_temp_slot(val.slot pt LGWord(nodes.ptr[value_node].sym));}
        else {
            let held=tl_values.length
            borrow(val pt);
            if snapshot and not ownership_type(pt) and tl_items.length >? 0 and tl_values.length =? held + 1 {
                arg_snapshots.push(tl_values.ptr[held]);
            }
        }
        out.push(val.v);
    }
}
copy_in=(a:LGWord):>LGWord=>$unsafe {
    if copies_on {copy_components(a ntype(a) "place writeback needs an independent heap-bearing snapshot");}
    let t=ntype(a)
    let cb=CopyBack[a new_temp(t) []]
    loop st in place_steps(a) {
        if nodes.ptr[st].kind =? 'index' {cb.idx.push([LGWord(nodes.ptr[st].b) gen_expr(LGWord(nodes.ptr[st].b)).v]);}
    }
    loop x in cb.idx {frozen[x[0]] = x[1];}
    let src=place_addr(gen_place(a true) t)
    loop x in cb.idx {frozen.remove(x[0]);}
    let tmp=e_slot(cb.slot)
    store_val(t tmp 0 load_val(t src 0));
    copy_at(tmp t);
    build_slot(cb.slot t);
    copy_backs.push(cb);
    return tmp
}
copy_back=(mark:LGWord):>void=>$unsafe {
    loop copy_backs.length >? mark {
        let cb=copy_backs.pop()
        let t=ntype(cb.arg)
        loop x in cb.idx {frozen[x[0]] = x[1];}
        let dst=gen_place(cb.arg true)
        loop x in cb.idx {frozen.remove(x[0]);}
        if dst.math_opt {release(read_place(dst t) t);}
        else {drop_at(place_addr(dst t) t);}
        write_place(dst t load_val(t e_slot(cb.slot) 0));
        if is_managed(t) {building.pop();}
    }
}
gen_map_presence=(call:LGWord f:LGWord):>LGWord=>$unsafe {
    let order:array<int64>=[]
    if nodes.ptr[call].c not=? 0 {order=call_eval_order(call)}
    return gen_direct_call(f kids(call) order).v
}
gen_positive_mod=(n:LGWord):>LGWord=>$unsafe {
    if prune(ntype(n)) =? T_MATH_INT {return -1}
    let modulus=positive_modulus(n)
    if modulus =? 0 {return -1}
    let a=kid(n 0)
    if positive_bound(a true) <? 0 {return -1}
    # The divisor is a pure literal; the dividend is evaluated exactly once.
    return e_bin('remu' VI gen_expr(a).v e_iconst(modulus))
}
gen_constant_floor=(n:LGWord):>LGWord=>$unsafe {
    # Release inlining exposes the helpers' branches to broader optimization.
    # Direct selects help the fast path but regress some optimized array loops.
    if opt_release {return -1}
    if nkids(n) not=? 2 {return -1}
    let f:LGWord=LGWord(nodes.ptr[n].sym)
    let t=prune(LGWord(fns.ptr[f].ret))
    if t not=? T_INT and t not=? T_U64 {return -1}
    let d:LGWord=LGWord(fns.ptr[f].decl)
    if d =? 0 {return -1}
    let name=name_of(LGWord(nodes.ptr[d].name))
    if name not=? "__floor_mod" and name not=? "__floor_div" and name not=? "__floor_mod_pow2" and name not=? "__floor_div_pow2" {return -1}
    if files.ptr[pos_file(nodes.ptr[d].pos)].path not=? "{lib_dir}/std/date.jo" and files.ptr[pos_file(nodes.ptr[d].pos)].path not=? "{lib_dir}/math_int.jo" {return -1}
    let b=kid(n 1)
    if nodes.ptr[b].kind not=? 'int_lit' or has_flag(b NF_U64) {return -1}
    let divisor=nodes.ptr[b].ival
    if name =? "__floor_div_pow2" {
        if divisor <? 0 or divisor >=? 64 {return -1}
    }
    else if name =? "__floor_mod_pow2" {
        if divisor <? 0 {return -1}
    }
    else if divisor <=? 0 {return -1}
    # The other operand is a pure literal, so source order still evaluates the
    # dividend exactly once, even when the result simplifies to zero or itself.
    let a=gen_expr(kid(n 0)).v
    let constant=e_iconst(divisor)
    if name =? "__floor_div_pow2" {
        let shift_op=if t =? T_U64 {Op.shru} else {Op.shrs}
        return e_bin(shift_op VI a constant)
    }
    if name =? "__floor_mod_pow2" {return e_bin('and_' VI a constant)}
    let modulo=name =? "__floor_mod"
    let op=if modulo {if t =? T_U64 {Op.remu} else {Op.rems}} else {if t =? T_U64 {Op.divu} else {Op.divs}}
    let value=e_bin(op VI a constant)
    if t =? T_U64 {return value}
    let sign_input=if modulo {value} else {a}
    let negative=e_bin('lts' VI sign_input e_iconst(0))
    let adjust=negative
    let corrected:LGWord=0
    if modulo {corrected=e_bin('add' VI value constant)}
    else {
        let remainder=e_bin('ne' VI a e_bin('mul' VI value constant))
        adjust=e_bin('and_' VI negative remainder)
        corrected=e_addi(value -1)
    }
    let result=vreg(VI)
    emit('select' VI result adjust corrected value 0);
    return result
}
gen_byte_read=(e:LGWord):>LGWord=>$unsafe {
    if nkids(e) not=? 2 {return -1}
    let d:LGWord=LGWord(fns.ptr[LGWord(nodes.ptr[e].sym)].decl)
    if d =? 0 {return -1}
    let name=name_of(LGWord(nodes.ptr[d].name))
    let width=if name =? "__dewy_read_u64" {8} else if name =? "__dewy_read_u32" {4} else if name =? "__dewy_read_u16" {2} else {0}
    if width =? 0 or files.ptr[pos_file(nodes.ptr[d].pos)].path not=? "{lib_dir}/std/dewy.jo" {return -1}
    let a=kid(e 0)
    let bt=prune(ntype(a))
    let source=gen_expr(a)
    let root=a
    if nodes.ptr[a].kind =? 'intrinsic' and (nodes.ptr[a].aux as IN) =? IN.to_bytes and nkids(a) =? 1 {root=kid(a 0)}
    if not byte_offset_plain(kid(e 1)) and not unchanged_by(text_source(root) kid(e 1)) {source=own(source bt)}
    borrow(source bt);
    let p=vreg(VI)
    e_mov(p source.v);
    let i=gen_expr(kid(e 1)).v
    let n=arr_len(p)
    # (0 <=? i <=? n - width as one unsigned compare: i below the count of offsets that
    # fit, n - width + 1, or 0 when none do)
    let fits=e_addi(n 1 - width)
    let count=vreg(VI)
    emit('select' VI count e_bin('lts' VI fits e_iconst(0)) e_iconst(0) fits 0);
    iff(e_bin('geu' VI i count));
    e_call_nr3(rt("__dewy_read_out") i n e_iconst(width * 8) -1);
    endc();
    return e_load(VI e_bin('add' VI p i) 24 width)
}
gen_direct_call=(f:LGWord args:array<int64> order:array<int64>=[] call_node:LGWord=0):>Val=>$unsafe {
    if partition_active and partition_call_needed(f args) {return partition_call(f args order)}
    let ret:LGWord=LGWord(fns.ptr[f].ret)
    let rslot:LGWord=-1
    let argv:array<int64>=[]
    if vc(ret) =? VC_AGG {
        rslot=new_temp(ret)
        argv.push(e_slot(rslot));
    }
    let mark=copy_backs.length
    let snaps=arg_snapshots.length
    call_args(args fns.ptr[f].ptypes inst_mutmask(f) @argv f order);
    if refine_active {refine_gen_args(args argv if vc(ret) =? VC_AGG {1} else {0} inst_mutmask(f));}
    # Default builds can inline tiny checked helpers without expanding their
    # failure path. Release keeps its measured whole-function inlining policy.
    # Still unwind lowering's pending copy-back records; their unreachable
    # instructions are discarded by control-flow cleanup.
    if ownership_decls.length not=? 0 {
        let base=if vc(ret) =? VC_AGG {1} else {0}
        loop i in [0..fns.ptr[f].ptypes.length) {
            if copy_consumes(f i) and ownership_type(fns.ptr[f].ptypes.ptr[i]) {owner_forget(argv.ptr[base + i]);}
        }
    }
    let nr=not opt_release and not dbg_on and prune(ret) =? T_NEVER
    let target_lf=if callback_calls.length =? 0 {-1} else {callback_calls.get(callback_key(ir.fn_index call_node)) ?? (-1)}
    if exr_call_target =? f {target_lf=lf_helper(HK.reset_words 0 f)}
    if target_lf <? 0 {target_lf=lf_of_inst(f)}
    let rv=if nr {e_call_nr(target_lf argv -1)} else {e_call(target_lf argv ret_vt(ret))}
    copy_back(mark);
    release_arg_snapshots(snaps);
    return finish_call(ret rv rslot)
}
gen_closure_call=(callee:LGWord args:array<int64> order:array<int64>=[]):>Val=>$unsafe {
    let ft=callable_base(ntype(callee))
    let ret:LGWord=LGWord(types.ptr[ft].elem)
    let source=callee
    let selected=nodes.ptr[callee].kind =? 'fnref' and nodes.ptr[callee].aux =? 2
    if selected {source=LGWord(nodes.ptr[callee].a)}
    let target:LGWord=-1
    if nodes.ptr[source].kind =? 'ident' and nodes.ptr[source].aux =? LGI32(1) {
        target=callback_local(LGWord(nodes.ptr[source].sym))
        if target <? 0 {target=stack_closure_target(LGWord(nodes.ptr[source].sym))}
    }
    let known=if selected {LGWord(nodes.ptr[callee].sym)} else {target}
    let cval=gen_expr(source)
    # A const callable is a saved value: call a temporary copy so its private
    # state cannot change through the const binding. Explicit shared cells stay shared.
    let root=place_var(callee)
    let frozen_value=false
    if root not=? 0 {
        if nodes.ptr[root].aux =? LGI32(1) {frozen_value=LGWord(locals.ptr[LGWord(nodes.ptr[root].sym)].flags) & LF_CONST not=? 0}
        else if nodes.ptr[root].aux =? LGI32(2) {frozen_value=readonly_global(LGWord(nodes.ptr[root].sym))}
    }
    if frozen_value {cval=own_at(source cval ft)}
    borrow(cval ft);
    # Pin the exact environment when arguments or the callback can replace its
    # owner. Owned temporaries already stay alive through statement cleanup, and
    # an unaliased local callable needs no refcount traffic on every invocation.
    # The invocation-only proof also excludes replacing the owner through args.
    let pin=target <? 0 and not cval.owned and (root =? 0 or borrow_may_change(callee args -1 0))
    if target <? 0 and not cval.owned and not pin and root not=? 0 {
        let mm:LGWord=LGWord(types.ptr[ft].mutmask)
        loop i in [0..args.length) and arg in args {
            if mm & (1 << i) not=? 0 or may_write_root(arg root) {pin=true}
        }
    }
    let cv=cval.v
    if pin {
        let saved=new_temp(ft)
        cv=e_slot(saved)
        e_copy(cv cval.v tsize(ft));
        retain(e_load(VI cv ptr_size ptr_size) T_STR);
        reg_temp_slot(saved ft);
    }
    let fp:LGWord=0
    if known <? 0 {
        fp=e_load(VI cv 0 ptr_size)
        # (a field or variable of a function type never given one: none, said as that)
        iff(e_bin('eq' VI fp e_iconst(0)));
        e_call_nr2(rt("__panic_nofn") e_daddr(loc_data(nodes.ptr[callee].pos)) e_daddr(str_data(place_text(callee))) -1);
        endc();
    }
    let env=e_load(VI cv ptr_size ptr_size)
    let rslot:LGWord=-1
    let argv:array<int64>=[]
    if vc(ret) =? VC_AGG {
        rslot=new_temp(ret)
        argv.push(e_slot(rslot));
    }
    argv.push(env);
    let pts:array<int64>=[]
    loop i in [0..LGWord(types.ptr[ft].nargs)) {pts.push(targ(ft i));}
    let mark=copy_backs.length
    let snaps=arg_snapshots.length
    call_args(args pts LGWord(types.ptr[ft].mutmask) @argv order = order);
    if refine_active {refine_gen_args(args argv if vc(ret) =? VC_AGG {2} else {1} LGWord(types.ptr[ft].mutmask));}
    let rv=if known >=? 0 {e_call(lf_of_inst(known) argv ret_vt(ret))} else {e_calli(fp argv ret_vt(ret) false)}
    copy_back(mark);
    release_arg_snapshots(snaps);
    return finish_call(ret rv rslot)
}
gen_cfn_call=(callee:LGWord args:array<int64>):>Val=>$unsafe {
    let ft=callable_base(ntype(callee))
    let ret:LGWord=LGWord(types.ptr[ft].elem)
    let fp=gen_expr(callee).v
    let argv:array<int64>=[]
    loop a in args {
        let val=gen_expr(a)
        borrow(val ntype(a));
        argv.push(val.v);
    }
    let rv=e_calli(fp argv ret_vt(ret) true)
    if vc(ret) =? VC_AGG {ice("C functions returning structs are not supported");}
    return finish_call(ret rv -1)

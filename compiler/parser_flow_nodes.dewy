$runtime_checks
from p"ast.jo" import (NF_FLOW_RETURNS has_flag kids mk nodes)
from p"parse.jo" import (lx_block lx_expr_stmt lx_ident p_toks)
from p"parser_cursor.dewy" import (partner)
from p"util.jo" import (name_of)

ParserFlowWord:type=int64<overflow='wrap'>
# Conservative source control flow: 1 falls through, 2 returns, 4 exits a loop.
# This preserves a loop/else's all-returning arms after introducing its entered
# flag. Nested loop exits may reject a proof, but must never prove a return.
lx_flow_effects=(n:ParserFlowWord):>int64=>$unsafe {
    if n =? 0 {return 1}
    let k=nodes.ptr[n].kind
    if k =? 'lambda' {return 1}
    if k =? 'break_' or k =? 'continue_' {return 4}
    if has_flag(n NF_FLOW_RETURNS) {return 2}
    if k =? 'return_' {
        let e=lx_flow_effects(ParserFlowWord(nodes.ptr[n].a))
        let returned=if e & 1 not=? 0 {2} else {0}
        return (e & 6) | returned
    }
    if k =? 'block' {
        let e:ParserFlowWord=1
        loop item in kids(n) {
            if e & 1 =? 0 {break}
            e=(e & 6) | lx_flow_effects(item)
        }
        return e
    }
    if k =? 'if_' {
        let e=lx_flow_effects(ParserFlowWord(nodes.ptr[n].a))
        if e & 1 =? 0 {return e}
        return (e & 6) | lx_flow_effects(ParserFlowWord(nodes.ptr[n].b)) | lx_flow_effects(ParserFlowWord(nodes.ptr[n].c))
    }
    if k =? 'exprstmt' {return lx_flow_effects(ParserFlowWord(nodes.ptr[n].a))}
    # Other expressions can contain blocks, including loop exits in arguments
    # or conditions. Keep fallthrough possible rather than proving termination.
    let e:ParserFlowWord=1
    e |= lx_flow_effects(ParserFlowWord(nodes.ptr[n].a)) | lx_flow_effects(ParserFlowWord(nodes.ptr[n].b))
    e |= lx_flow_effects(ParserFlowWord(nodes.ptr[n].c)) | lx_flow_effects(ParserFlowWord(nodes.ptr[n].d))
    loop item in kids(n) {e |= lx_flow_effects(item)}
    e
}
lx_or_terms=(h:ParserFlowWord @out:array<int64>):>void=>$unsafe {
    if ParserFlowWord(nodes.ptr[h].op) =? 3 {
        lx_or_terms(ParserFlowWord(nodes.ptr[h].a) @out)
        lx_or_terms(ParserFlowWord(nodes.ptr[h].b) @out)
    }
    else {out.push(h)}
}
# if has: value else: none
lx_opt_value=(has:ParserFlowWord value:ParserFlowWord pos:ParserFlowWord):>int64=>$unsafe {
    let n=mk('if_' pos)
    nodes.ptr[n].a=int32(lx_ident(name_of(has) pos))
    nodes.ptr[n].b=int32(lx_block([lx_expr_stmt(value pos)] pos))
    nodes.ptr[n].c=int32(lx_block([lx_expr_stmt(mk('none_lit' pos) pos)] pos))
    n
}
# does the parenthesized group at i contain a loop binding (`name in`) at its top level?
head_has_binder=(i:ParserFlowWord):>bool=>$unsafe {
    let c=partner(i)
    let j=i + 1
    loop j <? c {
        if p_toks[j].kind =? 'ident' and p_toks[j + 1].kind =? 'kw_in' {
            let pk0=p_toks[j - 1].kind
            if j =? i + 1 or pk0 =? 'kw_and' or pk0 =? 'kw_or' or pk0 =? 'kw_mut' or pk0 =? 'lparen' {return true}
        }
        j += 1
    }
    false
}

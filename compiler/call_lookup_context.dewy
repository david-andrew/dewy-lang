$runtime_checks
from p"checker_call_queries.dewy" import (collect_fns collect_module)
from p"call_argument_checks.dewy" import (match_type)
from p"checker_source_positions.dewy" import (dewy_at)
from p"checker_type_entries.dewy" import (get_fn_inst)
from p"checker_method_receiver.dewy" import (method_modules)
from p"checker_module_lookup.dewy" import (demand_name)
from p"checker_contexts.dewy" import (cur_mod)
from p"prelude_ops.dewy" import (dewy_prelude_lookup)
from p"checker_expr.dewy" import (check_expr)
from p"checker_state.dewy" import (FnCtx)
from p"ast.jo" import (nkids nodes)
from p"check.jo" import (check_scopes ctxs cx fns modules prelude syms)
from p"checker_signature.dewy" import (fn_sig)
from p"expr.jo" import (ci_ids cin_mark id_at named_first rational_reach)
from p"rational_lookup.dewy" import (exact_families_changed rational_module reaches_rational)
from p"types.jo" import (prune structs tkind type_eq types)
from p"util.jo" import (files intern pos_file pos_off)

LookupWord:type=int64<overflow='wrap'>

# Inside a generic instance a local's type may be a function for this instance
# only; its bare name stays a value there.
in_generic_instance=():>bool=>{
    let c:LookupWord=cx
    loop c >=? 0 {
        let inst=LookupWord(ctxs[c].inst)
        if inst >? 0 and fns[inst].targs.length >? 0 {return true}
        c=LookupWord(ctxs[c].parent)
    }
    false
}

# a function of the program's own (not the prelude's) by this name
program_fn_named=(name:LookupWord):>bool=>{
    let own:array<int64>=[]
    collect_fns(name @own)
    loop d in own {
        if not decl_in_prelude(d) {return true}
    }
    false
}

# the program's `str` for type t (str = (b: Big) -> str, beside the type), as an instance, or 0
program_str_fn=(t0:LookupWord pos:LookupWord):>LookupWord=>{
    let t=prune(t0)
    if tkind(t) not=? 'struct_' and tkind(t) not=? 'enum_' {return 0}
    let d0=LookupWord(structs[LookupWord(types[t].st)].decl)
    if d0 =? 0 or modules[LookupWord(nodes[d0].mod)].is_prelude {return 0}
    let fd:array<int64>=[]
    collect_module(LookupWord(nodes[d0].mod) intern("str") @fd)
    loop d in fd {
        if decl_in_prelude(d) or nkids(d) not=? 1 {continue}
        let sig=fn_sig(d)
        if sig.generic or sig.params.length not=? 1 or not type_eq(prune(sig.params[0]) t) {continue}
        return get_fn_inst(d [] pos)
    }
    0
}

# (does a library function `len`, as Heap's and Pool's, take a t first: Dewy's `.length` reads
# it. A `len` written in Dewy is not the protocol: that is a `length` function)
library_len_fits=(t0:LookupWord):>bool=>{
    let t=prune(t0)
    let nm=intern("len")
    demand_name(nm)
    let tables=[modules[cur_mod()].names prelude]
    loop tm in method_modules(t) {
        if tm not=? cur_mod() {tables.push(modules[tm].names)}
    }
    loop tbl in tables {
        let s=tbl.get(nm) ?? 0
        loop s not=? 0 {
            let d=LookupWord(syms[s].decl)
            if syms[s].kind =? 'fns' and d not=? 0 and nkids(d) >? 0 and not files[pos_file(nodes[d].pos)].is_dewy {
                let sig=fn_sig(d)
                if sig.params.length >? 0 {
                    let binds:array<int64>=fill(0 int64(sig.ntp))
                    if match_type(sig.params[0] t @binds 0) >=? 0 {return true}
                }
            }
            s=LookupWord(syms[s].next)
        }
    }
    false
}

check_expr_in_module=(n:LookupWord m:LookupWord expected:LookupWord=0):>LookupWord=>{
    let context = @cx
    let saved=context
    ctxs.push(FnCtx(ctxs[saved].inst int32(saved) ctxs[saved].ret false 0 int32(m) int32(check_scopes.names.length)))
    context=LookupWord(ctxs.length) - 1
    let t=check_expr(n expected)
    ctxs.pop();
    context=saved
    t
}

named_grow=(name:int64):>void=>{named_first.resize(LookupWord(name)*2 + 64)}

# (a function of the Dewy prelude's module dm called from m, such as `rational(1 3)`: m reaches
# what dm's imports do, the bundled rational included)
prelude_reach=(m:int64 dm:int64):>void=>{
    let rm=rational_module()
    if rm <? 0 or not reaches_rational(dm rm) or rational_reach[m] =? 1 {return}
    rational_reach[m]=1
    exact_families_changed()
}

# (is the code being checked Dewy's? the library's own code is Sloppy)
caller_dewy=():>bool=>$unsafe {
    let m=cur_mod()
    m >=? 0 and files.ptr[LookupWord(modules.ptr[m].file)].is_dewy
}

ci=(slot:LookupWord s:string):>LookupWord=>$unsafe {
    if slot <? ci_ids.length and ci_ids.ptr[slot] not=? 0 {return ci_ids.ptr[slot]}
    if ci_ids.length <=? slot {ci_ids.resize(slot + 64)}
    let id=intern(s)
    ci_ids[slot]=id
    id
}

# `p"a/b.txt"` (a `p` written against its quote) is a path literal in Dewy: its `p` is the
# library's, whatever the program binds to p (`let p = r` below it). The library module that
# declares it, or -1 for any other call. O(1).
path_literal_module=(n:LookupWord callee:LookupWord args:array<int64>):>LookupWord=>$unsafe {
    if LookupWord(nodes.ptr[callee].name) not=? ci(43 "p") or args.length not=? 1 or not dewy_at(nodes.ptr[n].pos) {return -1}
    let src_s=files.ptr[pos_file(nodes.ptr[callee].pos)].src
    let off=LookupWord(pos_off(nodes.ptr[callee].pos)) + 1
    if off >=? (src_s as array<uint8>).length or ((src_s as array<uint8>).ptr[off] not=? 34 and (src_s as array<uint8>).ptr[off] not=? 39) {return -1}
    let name=LookupWord(nodes.ptr[callee].name)
    let s=prelude.get(int64(name)) ?? dewy_prelude_lookup(name)
    if s =? 0 or syms.ptr[s].decl =? 0 {return -1}
    LookupWord(nodes.ptr[LookupWord(syms.ptr[s].decl)].mod)
}

cin_grow=(d:int64):>void=>$unsafe {
    cin_mark.resize(max(d + 1 nodes.length) + 1024)
}

decl_in_prelude=(d:int64):>bool=>$unsafe {
    d not=? 0 and modules.ptr[LookupWord(nodes.ptr[d].mod)].is_prelude
}

is_unchecked_at=(n:int64):>bool=>$unsafe {
    let id_at_slot=@id_at
    let callee=LookupWord(nodes.ptr[n].a)
    if nodes.ptr[callee].kind not=? 'ident' or nkids(n) not=? 2 {return false}
    if id_at_slot =? 0 {id_at_slot=intern("__at")}
    LookupWord(nodes.ptr[callee].name) =? id_at_slot and modules.ptr[cur_mod()].is_prelude
}

RangeWord:type=int64<overflow='wrap'>
# A stepped range, `[a, b..c]` (a loop's, or the library's IntRange): its step
# b - a must be nonzero, so b not=? a is an obligation. n: the stepped `for_`,
# or a call of one of the library's range constructors with a literal `true`
# for `stepped` (fact_range_first).
fact_range_call=(n:RangeWord):>bool=>{
    fact_range_first(n true) >=? 0
}
fact_range_first=(n:RangeWord step:bool):>RangeWord=>$unsafe {
    if nodes.ptr[n].kind not=? 'call' or nodes.ptr[n].aux not=? 0 or nodes.ptr[n].sym <=? 0 {return -1}
    let m=nkids(n)
    if m not=? 2 and m not=? 5 and m not=? 7 {return -1}
    let d=RangeWord(fns.ptr[RangeWord(nodes.ptr[n].sym)].decl)
    if d =? 0 {return -1}
    if fact_name_range =? 0 {
        fact_name_range=intern("__dewy_range")
        fact_name_axis_slice=intern("__nd_axis_slice")
        fact_name_slice_range=intern("__dewy_slice_range")
        fact_name_open_range=intern("__dewy_open_range_iter")
    }
    let name=RangeWord(nodes.ptr[d].name)
    let first:RangeWord=-1
    let stepped:RangeWord=-1
    if m =? 5 and name =? fact_name_range {
        first=0
        stepped=3
    }
    else if m =? 7 and name =? fact_name_axis_slice {
        first=0
        stepped=5
    }
    else if m =? 7 and name =? fact_name_slice_range {
        first=1
        stepped=6
    }
    else if m =? 2 and name =? fact_name_open_range {first=0}
    if first <? 0 or not pos_in_lib(nodes.ptr[d].pos) {return -1}
    if stepped <? 0 {return if step {first} else {-1}}
    let flag=kid(n stepped)
    if nodes.ptr[flag].kind not=? 'bool_lit' or (nodes.ptr[flag].ival not=? 0) not=? step {return -1}
    first
}
fact_stepped_loop=(n:RangeWord):>bool=>$unsafe {
    let it=RangeWord(nodes.ptr[n].a)
    nodes.ptr[n].kind =? 'for_' and nodes.ptr[n].aux =? 0 and nodes.ptr[it].kind =? 'range' and has_flag(it NF_STEP) and nodes.ptr[it].c not=? 0
}
# Exhaustion is a separate obligation from a nonzero step. Only a 64-bit
# counter starting well inside its domain with a small fixed step may use the
# progress axiom. Narrow counters and huge steps must prove their backedge safe.
fact_open_range=(n:RangeWord):>bool=>$unsafe {
    if nodes.ptr[n].kind not=? 'for_' or nodes.ptr[n].aux not=? 0 {return false}
    let it=RangeWord(nodes.ptr[n].a)
    # An unbounded semantic-int range lowers with an exact, promoting cursor.
    nodes.ptr[it].kind =? 'range' and nodes.ptr[it].b =? 0 and dewy_at(nodes.ptr[n].pos) and prune(RangeWord(locals.ptr[RangeWord(nodes.ptr[n].sym)].type)) not=? T_MATH_INT
}
# The marked, small-start 64-bit range has a lexical progress axiom. It
# needs no value-flow proof; opt-out scopes and every other range retain
# their ordinary exhaustion obligation. Querying this certificate is O(1).
fact_range_assumed=(n:RangeWord):>bool=>$unsafe {
    nodes.ptr[n].aux2 =? int32(RANGE_EXHAUSTION) and nodes.ptr[n].ival not=? 0 and dir_value(dir_name_assumed_bounds nodes.ptr[n].pos) not=? 1
}
fact_range_exhaustion=(n:RangeWord entry:FactState first:RangeWord second:RangeWord edges:FactLoop):>void=>$unsafe {
    if not fact_open_range(n) or fact_speculating not=? 0 or fact_summary_owner not=? 0 {return}
    fact_validated[n]=true
    let t=fact_type(RangeWord(locals.ptr[RangeWord(nodes.ptr[n].sym)].type))
    let start=fact_bound(entry first)
    let delta=FactBound(1 1)
    if second not=? 0 {
        let stop=fact_bound(entry second)
        delta=FactBound(wide=true)
        if not start.wide and not stop.wide and start.lo not=? FACT_MIN and start.hi not=? FACT_MIN and fact_add_fits(stop.lo (-start.hi)) and fact_add_fits(stop.hi (-start.lo)) {delta=FactBound(stop.lo - start.hi stop.hi - start.lo)}
    }
    let assumed=is_int(t) and types.ptr[t].bits =? 64 and dir_value(dir_name_assumed_bounds nodes.ptr[n].pos) not=? 1 and not start.wide and start.lo >=? -72057594037927936 and start.hi <=? 72057594037927936 and not delta.wide and delta.lo =? delta.hi and delta.lo >=? -65536 and delta.hi <=? 65536
    let proven=assumed or not edges.back.live
    if not proven {
        let back=edges.back
        let l=RangeWord(nodes.ptr[n].sym)
        let binding=fact_binding(back PlaceIdentity('local' RangeWord(locals.ptr[l].owner) l))
        if binding >=? 0 and stable_loop_index(l) {
            let current=fact_bound(back back.bindings[binding].value)
            let domain=fact_domain(t)
            if not current.wide and not delta.wide and fact_add_fits(current.lo delta.lo) and fact_add_fits(current.hi delta.hi) {
                proven=current.lo + delta.lo >=? domain.lo and current.hi + delta.hi <=? domain.hi
            }
        }
    }
    if fact_probe_on {
        fact_probe_record(n proven)
        return
    }
    if not proven {
        if dir_defer(n "cannot prove the open range does not exhaust its integer type" true) {return}
        wit_fail(nodes.ptr[n].pos "cannot prove the open range does not exhaust its integer type")
    }
}
fact_step_check=(n:RangeWord @s:FactState first:RangeWord second:RangeWord first_node:RangeWord second_node:RangeWord):>void=>$unsafe {
    if fact_speculating not=? 0 or not (fact_policy =? 'RequireStatic' or fact_query or fact_probe_on) {return}
    let c=fact_compare(s 'ne' second first)
    if fact_probe_on {
        fact_probe_record(n c =? 1)
        return
    }
    if c =? 1 {return}
    let b=wit_side(second second_node)
    let a=wit_side(first first_node)
    let relation=wit_relation_text('ne' b a)
    let missing=wit_relation(s s 'ne' b a c =? 0)
    wit_context(0)
    if c =? 0 {
        wit_help(relation)
        if dir_defer(n "the range step is zero" true) {return}
        wit_fail(nodes.ptr[n].pos "the range step is zero")
        return
    }
    wit_unknown(n fact_bound(s second) "the range step is nonzero" 0 relation missing)
}
# value (operand's) >= 0, as `what` requires: proven, an error, or a check of its scope.
fact_nonnegative=(n:RangeWord @s:FactState value:RangeWord operand:RangeWord what:string):>void=>$unsafe {
    if fact_speculating not=? 0 or not (fact_policy =? 'RequireStatic' or fact_query or fact_probe_on) {return}
    let zero=fact_constant(@s 0)
    let c=fact_compare(s 'ge' value zero)
    if fact_probe_on {
        fact_probe_record(n c =? 1)
        return
    }
    if c =? 1 {return}
    let side=wit_side(value operand)
    let nil=WitSide(zero 0 "0" false true)
    let missing=wit_relation(s s 'ge' side nil c =? 0)
    wit_context(0)
    if c =? 0 {
        wit_help(wit_relation_text('ge' side nil))
        if dir_defer(n "{what} is negative" true) {return}
        wit_fail(nodes.ptr[n].pos "{what} is negative")
        return
    }
    wit_unknown(n fact_bound(s value) "{what} is >= 0" 0 wit_relation_text('ge' side nil) missing)
}
fact_refinement_covers=(r:RangeWord):>RangeWord=>$unsafe {
    let inner=RangeWord(nodes.ptr[r].a)
    if nodes.ptr[inner].kind not=? 'conv' or nodes.ptr[inner].aux not=? int32(int64(CV.int_)) or prune(ntype(RangeWord(nodes.ptr[inner].a))) not=? T_MATH_INT {return 0}
    let [known allowed]=int_intervals(zonk(RangeWord(nodes.ptr[r].aux2)))
    if not known or allowed.length =? 0 or allowed[0] =? FACT_MIN or allowed[allowed.length - 1] =? FACT_MAX {return 0}
    inner
}
# A captured fixed-width value or singleton has real host endpoints, unlike
# an unconstrained mathematical int. Conversions preserve value identity, so
# widening int64 to int and storing it back need not invent strict bounds.
# O(1), using the existing value-indexed term; wide intermediates never qualify.
fact_host_value=(s:FactState value:RangeWord):>bool=>{
    if value =? 0 {return false}
    let b=fact_bound(s value)
    if b.wide {return false}
    if b.lo =? b.hi {return true}
    let t=fact_type(fact_terms[value].type)
    is_int(t) and t not=? T_MATH_INT and t not=? T_U64
}
# Endpoint sentinels become finite through a current guard too. Inspect only
# this value's indexed incident rows (at most 16), not every value in the body.
# The other endpoint must itself have a finite interval; do not recurse through
# rows, so a cycle of unconstrained values cannot manufacture a bound.
fact_host_endpoint=(s:FactState value:RangeWord upper:bool):>bool=>{
    let b=fact_bound(s value)
    if b.wide {return false}
    let finite=if upper {b.hi not=? FACT_MAX} else {b.lo not=? FACT_MIN}
    if finite or fact_host_value(s value) {return true}
    let side:RangeWord=0
    if upper {side=1}
    let ri=fact_difference_head(s value side)
    loop ri >=? 0 {
        let row=s.differences[ri]
        ri=fact_difference_next(s ri side)
        let other=if upper {row.b} else {row.a}
        let q=fact_bound(s other)
        if q.wide {continue}
        if upper {
            if (q.hi not=? FACT_MAX or fact_host_value(s other)) and fact_add_fits(q.hi row.limit) {return true}
        }
        else if row.limit not=? FACT_MIN {
            if (q.lo not=? FACT_MIN or fact_host_value(s other)) and fact_add_fits(q.lo (-row.limit)) {return true}
        }
    }
    false
}
# An `int` converted to a fixed width (`int32(x)`, `x as int32`, a store into a
# fixed-width place): x must fit, proven, an error or a check of its scope.
# An `int`'s endpoint sentinels need strict bounds unless a captured fixed
# value or current guard establishes that endpoint is finite. True when proven.
fact_narrow_check=(n:RangeWord @s:FactState value:RangeWord):>bool=>$unsafe {
    let to=representation_type(ntype(n))
    let bits=RangeWord(types.ptr[to].bits)
    let sign=types.ptr[to].sign
    let low:RangeWord=if not sign {0} else if bits >=? 64 {FACT_MIN} else {-(RangeWord(1) << (bits - 1))}
    let high:RangeWord=if bits >=? 64 {FACT_MAX} else if sign {(RangeWord(1) << (bits - 1)) - 1} else {(RangeWord(1) << bits) - 1}
    let lo_op=if low =? FACT_MIN and not fact_host_endpoint(s value false) {Tok.gt} else {Tok.ge}
    let hi_op=if high =? FACT_MAX and not fact_host_endpoint(s value true) {Tok.lt} else {Tok.le}
    let lo=fact_constant(@s low)
    let hi=fact_constant(@s high)
    let lc=fact_compare(s lo_op value lo)
    let hc=fact_compare(s hi_op value hi)
    # (uint64's ceiling 2^64-1 is beyond int64: a real int64 end is below it,
    # a guard row to a larger literal caps an open one, nothing refutes it)
    let unsigned=fact_type(to) =? T_U64
    if unsigned and hc not=? 1 {hc=if fact_u64_capped(s value) {1} else {-1}}
    # (a binding's covering set of written values: string_domains.jo)
    let proven=lc =? 1 and hc =? 1 or int_domain_proven.has(n) or exact_progress_math.has(n) or exact_word_reads.has(n)
    if fact_speculating not=? 0 {return proven}
    if fact_probe_on {
        fact_probe_record(n proven)
        return proven
    }
    if proven or n =? fact_covered or not s.live or not (fact_policy =? 'RequireStatic' or fact_query) {return proven}
    let upper=hc not=? 1 and (lc not=? 0 or hc =? 0)
    let side=wit_side(value RangeWord(nodes.ptr[n].a))
    # (an operand with no spelling of its own, as refinements show it)
    if side.text =? "" {side.text="the value"}
    let limit=if upper {high} else {low}
    let shown_limit=if upper and unsigned {"18446744073709551615"} else {"{limit}"}
    let bound_value=if upper {hi} else {lo}
    let bound=WitSide(bound_value 0 shown_limit false true)
    let op=if upper {Tok.le} else {Tok.ge}
    let answer=if upper {hc} else {lc}
    let refuted=answer =? 0
    let missing=wit_relation(s s op side bound refuted)
    let relation=wit_relation_text(op side bound)
    wit_context(0)
    if refuted {
        wit_help(relation)
        let shown=side.text
        if dir_defer(n "{shown} does not fit {dt(ntype(n))}" true) {return false}
        wit_fail(nodes.ptr[n].pos "{shown} does not fit {dt(ntype(n))}")
        return false
    }
    err_notes.push([(-1) "help: widen the destination to `int`, state the domain as a refinement, or choose `overflow='wrap'|'saturate'`"])
    # (only for an error: a check deferred to run time drops its notes, dir_defer)
    let held=if fact_query or dir_policy(nodes.ptr[n].pos) =? DIR_STATIC {fact_pushed_into(n)} else {""}
    if held not=? "" {err_notes.push([(-1) "help: the destination is an element of `{held}`, an array<{dt(ntype(n))}> by the values it was made from: make it hold `int` where it is made, `let {held}:array<int> = ...`"])}
    let repair=if lc not=? 1 and hc not=? 1 {"{low} <=? {side.text} and {side.text} <=? {shown_limit}"} else {relation}
    wit_unknown(n fact_bound(s value) "`{relation}` for the conversion to {dt(ntype(n))}" 0 repair missing)
    false
}
# The local array a narrowed value is pushed onto (`cur.push(x)`, `cur` made by `let cur = [i]`
# with no type written), or "": its element type came from what made it. O(the function's
# body), on the error path only.
fact_pushed_into=(n:RangeWord):>string=>$unsafe {
    if fact_owner <=? 0 or fact_owner >=? fns.length or fns.ptr[fact_owner].body =? 0 or not dewy_at(nodes.ptr[n].pos) {return ""}
    let work=[RangeWord(fns.ptr[fact_owner].body)]
    let visits:RangeWord=0
    let target:RangeWord=0
    let unwritten=dict<int64 bool>()
    loop work.length >? 0 and visits <? 100000 {
        let e=work.pop()
        visits += 1
        if e <=? 0 or e >=? nodes.length or nodes.ptr[e].kind =? 'lambda' {continue}
        # (a `let` with no type written: `.a` holds a written one)
        if nodes.ptr[e].kind =? 'vardecl' and nodes.ptr[e].sym >? 0 {unwritten[RangeWord(nodes.ptr[e].sym)]=nodes.ptr[e].a =? 0}
        if nodes.ptr[e].kind =? 'intrinsic' and nodes.ptr[e].aux =? int32(int64(IN.push)) and nkids(e) =? 2 and kid(e 1) =? n {
            let r=kid(e 0)
            let l=RangeWord(nodes.ptr[r].sym)
            if nodes.ptr[r].kind not=? 'ident' or nodes.ptr[r].aux not=? int32(1) or l <=? 0 or RangeWord(locals.ptr[l].flags) & LF_DECL =? 0 {return ""}
            target=l
        }
        work.push(RangeWord(nodes.ptr[e].a))
        work.push(RangeWord(nodes.ptr[e].b))
        work.push(RangeWord(nodes.ptr[e].c))
        loop i in [0..nkids(e)) {work.push(kid(e i))}
    }
    if target =? 0 or not (unwritten.get(target) ?? false) {return ""}
    name_of(RangeWord(locals.ptr[target].name))
}
# The builtin floor helper a Dewy `//` or `%` resolved to (fact_floor's kind), or 0.
fact_floor_call=(n:RangeWord):>RangeWord=>$unsafe {
    if nodes.ptr[n].aux not=? 0 or nodes.ptr[n].sym <=? 0 or nkids(n) not=? 2 {return 0}
    let f=RangeWord(nodes.ptr[n].sym)
    if fns.ptr[f].decl =? 0 or not pos_in_lib(nodes.ptr[RangeWord(fns.ptr[f].decl)].pos) {return 0}
    if not fact_scalar(ntype(n)) {return 0}
    let name=name_of(RangeWord(nodes.ptr[RangeWord(fns.ptr[f].decl)].name))
    if name =? "__floor_div" {return 1}
    if name =? "__floor_mod" {return 2}
    if name =? "__floor_div_pow2" {return 3}
    if name =? "__floor_mod_pow2" {return 4}
    0
}
# A counted push (one per iteration, fact_counted_pushes) in a range loop: at each
# head the array holds its entry length plus one element per value before the
# loop's, so `let cur = [i]` then `loop j in [1..n] cur.push(cur[j - 1] + 1)` knows
# `cur.length =? j`. The range ascends by one from its first value (fact_range
# serves only unstepped ranges, and its body assumes `lo <=? v`). A constant entry
# length and first value only: two rows per counted array. O(pushes).
fact_range_push_rows=(n:RangeWord @body:FactState lo:RangeWord pushes:array<[int64 int64]>):>void=>$unsafe {
    let l=RangeWord(nodes.ptr[n].sym)
    if l =? 0 or pushes.length =? 0 or not body.live {return}
    let vi=fact_binding(body PlaceIdentity('local' RangeWord(locals.ptr[l].owner) l))
    let x=fact_bound(body lo)
    if vi <? 0 or x.wide or x.lo not=? x.hi or x.lo <? -(1 << 40) or x.lo >? (1 << 40) {return}
    loop entry in pushes {
        let e=fact_bound(body entry[1])
        if e.wide or e.lo not=? e.hi or e.lo <? 0 or e.lo >? (1 << 40) {continue}
        let i=fact_binding(body PlaceIdentity('local' RangeWord(locals.ptr[entry[0]].owner) entry[0]))
        if i <? 0 or body.projections.length >=? FACT_CAP {continue}
        let length=fact_project(@body body.bindings[i].value (-1) false T_INT)
        let v=body.bindings[vi].value
        fact_difference(@body length v RangeWord(e.lo) - RangeWord(x.lo) n)
        fact_difference(@body v length RangeWord(x.lo) - RangeWord(e.lo) n)
    }
}
# The array locals loop n replaces whole (`prev = cur`, a dynamic-programming row),
# declared before it. O(body), once per loop.
fact_replaced_arrays=(n:RangeWord):>array<int64>=>$unsafe {
    let out:array<int64>=[]
    let work=[RangeWord(nodes.ptr[n].b)]
    loop work.length >? 0 and out.length <? 8 {
        let e=work.pop()
        if e =? 0 {continue}
        let k=nodes.ptr[e].kind
        if k =? 'lambda' {continue}
        if k =? 'assign' {
            let a=RangeWord(nodes.ptr[e].a)
            let l=RangeWord(nodes.ptr[a].sym)
            if nodes.ptr[a].kind =? 'ident' and nodes.ptr[a].aux =? int32(1) and l >? 0 and tkind(fact_type(RangeWord(locals.ptr[l].type))) =? 'array' and locals.ptr[l].pos <? nodes.ptr[n].pos and l not in? out {out.push(l)}
        }
        let mask=isolation_children(k)
        if mask <? 0 {continue}
        if mask & 1 not=? 0 {work.push(RangeWord(nodes.ptr[e].a))}
        if mask & 2 not=? 0 {work.push(RangeWord(nodes.ptr[e].b))}
        if mask & 4 not=? 0 {work.push(RangeWord(nodes.ptr[e].c))}
        if mask & 16 not=? 0 {
            loop i in [0..nkids(e)) {work.push(kid(e i))}
        }
    }
    out
}
# The value a length row compares with in state t: an unchanged int local's value, or
# an unchanged array local's length (`y.length`); 0 when it has none. O(1).
fact_row_side=(@t:FactState place:PlaceIdentity length:bool):>RangeWord=>{
    let i=fact_binding(t place)
    if i <? 0 {return 0}
    if not length {return t.bindings[i].value}
    let p=fact_projection_find(t t.bindings[i].value (-1) false)
    if p <? 0 {return 0}
    t.projections[p].value
}
# Length rows a range loop keeps for an array it replaces whole: `prev.length - y.length
# <=? 1` and the reverse, true at entry and kept by every backedge and break, as when
# each iteration builds `cur` one longer than `y` and ends `prev = cur`. Demanded only
# by such a loop whose entry length has rows; at most 8 rows against unchanged int
# locals and array lengths, and two speculative passes (fact_range_invariants'
# Houdini). O(replaced x unchanged bindings) to choose, O(body) per pass.
fact_range_length_rows=(n:RangeWord pre:FactState @s:FactState lo:RangeWord hi:RangeWord):>void=>$unsafe {
    if fact_loop_exhausted {return}
    let replaced=fact_replaced_arrays(n)
    if replaced.length =? 0 {return}
    # (array place, other place, other is a length, array first, limit):
    # len(array) - other <= limit when array first, else other - len(array) <= limit
    let rows:array<[PlaceIdentity PlaceIdentity bool bool int64]>=[]
    loop l in replaced {
        let place=PlaceIdentity('local' RangeWord(locals.ptr[l].owner) l)
        let at=fact_row_side(@pre place true)
        if at =? 0 or fact_incident(pre at) <? 0 {continue}
        loop binding in s.bindings {
            if rows.length >=? 8 {break}
            if binding.place.root not=? 'local' or binding.place =? place {continue}
            let d=binding.place.declaration
            let j=fact_binding(pre binding.place)
            if j <? 0 or pre.bindings[j].value not=? binding.value {continue}
            let t=fact_type(RangeWord(locals.ptr[d].type))
            let length=tkind(t) =? 'array'
            if not length and not (fact_scalar(t) and is_int(t)) {continue}
            let other=fact_row_side(@pre binding.place length)
            if other =? 0 {continue}
            let up=fact_shortest(pre at other)
            let down=fact_shortest(pre other at)
            # (a small offset only, `y.length + 1`: a wide limit says nothing a loop keeps)
            if up not=? FACT_MAX and up >=? -(1 << 32) and up <=? (1 << 32) {rows.push([place binding.place length true up])}
            if down not=? FACT_MAX and down >=? -(1 << 32) and down <=? (1 << 32) and rows.length <? 8 {rows.push([place binding.place length false down])}
        }
    }
    if rows.length =? 0 {return}
    let outer=fact_speculating
    fact_speculating += 1
    let settled=false
    loop round in [0..2) {
        let trial=s
        fact_length_rows_assume(@trial rows n)
        let body=fact_range_body(n trial lo hi)
        let edges=fact_loop_body(n @body)
        if not edges.back.live and not edges.exits.live {break}
        let kept:array<[PlaceIdentity PlaceIdentity bool bool int64]>=[]
        loop row in rows {
            let held=true
            loop t in [edges.back edges.exits] {
                if not t.live {continue}
                if not fact_length_row_holds(@t row) {held=false}
            }
            if held {kept.push(row)}
        }
        if kept.length =? rows.length {
            settled=true
            break
        }
        rows=kept
        if rows.length =? 0 {break}
    }
    fact_speculating=outer
    if settled and not fact_loop_exhausted {fact_length_rows_assume(@s rows n)}
}
fact_length_rows_assume=(@t:FactState rows:array<[PlaceIdentity PlaceIdentity bool bool int64]> at:RangeWord):>void=>{
    loop row in rows {
        let i=fact_binding(t row[0])
        let other=fact_row_side(@t row[1] row[2])
        if i <? 0 or other =? 0 or t.projections.length >=? FACT_CAP {continue}
        let length=fact_project(@t t.bindings[i].value (-1) false T_INT)
        if row[3] {fact_difference(@t length other row[4] at)} else {fact_difference(@t other length row[4] at)}
    }
}
fact_length_row_holds=(@t:FactState row:[PlaceIdentity PlaceIdentity bool bool int64]):>bool=>{
    let length=fact_row_side(@t row[0] true)
    let other=fact_row_side(@t row[1] row[2])
    if length =? 0 or other =? 0 {return false}
    if row[3] {fact_distance(t length other row[4])} else {fact_distance(t other length row[4])}
}
fact_range=(n:RangeWord @s:FactState):>void=>$unsafe {
    let iterator=RangeWord(nodes.ptr[n].a)
    let lo=fact_capture(RangeWord(nodes.ptr[iterator].a) @s)
    let hi=fact_capture(RangeWord(nodes.ptr[iterator].b) @s)
    let pushes=fact_counted_pushes(n @s)
    let growers=fact_growing_pushes(n @s pushes)
    let sums=fact_range_sums(n s lo hi)
    # A local the body sets only to the loop's value (`best=i`, the argmax)
    # holds its entry value or some earlier i: at most hi-1 whenever its
    # entry value is (a sentinel -1, a first index 0).
    let kept:array<[int64 FactBound bool bool]>=[]
    # (an optional set only to it, `let best:int? = none`: a present payload is some i)
    let found:array<int64>=[]
    if nodes.ptr[iterator].b not=? 0 and not has_flag(iterator NF_INCLUSIVE) and RangeWord(nodes.ptr[n].sym) not=? 0 {
        loop l in fact_index_carried(RangeWord(nodes.ptr[n].b) RangeWord(nodes.ptr[n].sym)) {
            let i=fact_binding(s PlaceIdentity('local' RangeWord(locals.ptr[l].owner) l))
            if i <? 0 {continue}
            let e=s.bindings[i].value
            if fact_summary_payload(fact_type(RangeWord(locals.ptr[l].type))) not=? 0 {
                if fact_known_none(s e) {found.push(l)}
                continue
            }
            kept.push([l fact_bound(s e) fact_entails(s e hi (-1)) fact_entails(s e lo 0)])
        }
    }
    # (positions the body keeps below a length, held at entry: fact_loop_bounds)
    let demands=fact_loop_bound_entry(fact_loop_bound_demands(n) @s)
    let pre=s
    let hulls=fact_push_open(n @s)
    let iterated=fact_iterate(n @s true 0 lo hi [pushes... growers...] sums)
    if not iterated {
        fact_changes(n @s n)
        loop sum in sums {
            let i=fact_binding(s PlaceIdentity('local' RangeWord(locals.ptr[sum[0]].owner) sum[0]))
            if i >=? 0 {fact_set_bound(@s s.bindings[i].value sum[1])}
        }
    }
    loop entry in kept {
        let i=fact_binding(s PlaceIdentity('local' RangeWord(locals.ptr[entry[0]].owner) entry[0]))
        if i <? 0 {continue}
        let v=s.bindings[i].value
        let x=fact_bound(s lo)
        let y=fact_bound(s hi)
        let b=fact_bound(s v)
        b.lo=max(b.lo min(entry[1].lo x.lo))
        if y.hi not=? FACT_MIN {b.hi=min(b.hi max(entry[1].hi y.hi - 1))}
        fact_set_bound(@s v b)
        if entry[2] {fact_difference(@s v hi (-1) n)}
    }
    loop l in found {fact_found_payload(@s l lo hi)}
    if s.live and RangeWord(nodes.ptr[n].sym) not=? 0 {fact_range_invariants(n pre @s lo hi)}
    if s.live and RangeWord(nodes.ptr[n].sym) not=? 0 {fact_range_length_rows(n pre @s lo hi)}
    let bounded=demands.length >? 0 and fact_loop_bounds(n @s demands FACT_PREP_RANGE 0 lo hi [pushes... growers...])
    let after=s
    let body=fact_range_body(n s lo hi)
    fact_growing_lengths(@body pushes)
    fact_growing_lengths(@body growers)
    fact_range_push_rows(n @body lo pushes)
    # A nonempty iteration establishes lo < hi. Entry <= lo and every
    # replacement < hi therefore bound the carried value inside the body,
    # even when a zero-iteration exit cannot establish entry < hi.
    loop entry in kept {
        if not entry[3] {continue}
        let i=fact_binding(body PlaceIdentity('local' RangeWord(locals.ptr[entry[0]].owner) entry[0]))
        if i >=? 0 {fact_difference(@body body.bindings[i].value hi (-1) n)}
    }
    let edges=fact_loop_body(n @body)
    fact_range_exhaustion(n pre lo 0 edges)
    s=if iterated or bounded {fact_join(after edges.exits n)} else {after}
    if iterated and fact_speculating =? 0 and after.live and edges.exits.live {
        loop entry in kept {fact_carried_exit(@s entry[0] after @edges.exits)}
    }
    if hulls {fact_push_close(n @s)}
    fact_growing_lengths(@s growers)
    if pushes.length >? 0 and nodes.ptr[iterator].b not=? 0 {
        # (the iteration count, hi-lo or hi-lo+1, when the range is not reversed)
        let extra:RangeWord=if has_flag(iterator NF_INCLUSIVE) {1} else {0}
        let x=fact_bound(s lo)
        let y=fact_bound(s hi)
        # (an inclusive range from a constant may be empty and still count hi-lo+1:
        # `[1..n]` with `n >=? 0` runs n times, the length `y.chars` has)
        let empty_ok=extra =? 1 and x.lo =? x.hi and fact_entails(s lo hi 1)
        if fact_compare(s 'le' lo hi) =? 1 or empty_ok or extra =? 1 and fact_compare(s 'le' lo hi) >=? 0 and x.lo =? x.hi and y.lo =? y.hi and RangeWord(y.lo) + 1 >=? x.lo {
            if x.lo not=? FACT_MIN and y.lo not=? FACT_MIN and fact_add_fits(y.hi extra - RangeWord(x.lo)) and fact_add_fits(y.lo extra - RangeWord(x.hi)) {
                let count=fact_new(@s FactBound(max(0 RangeWord(y.lo) - RangeWord(x.hi) + extra) RangeWord(y.hi) - RangeWord(x.lo) + extra) FactTerm('minus' hi lo n T_INT))
                if x.lo =? x.hi {
                    fact_difference(@s count hi extra - RangeWord(x.lo) n)
                    fact_difference(@s hi count RangeWord(x.lo) - extra n)
                }
                fact_counted_lengths(n @s pushes count)
                return
            }
        }
        # (`[0..n)` runs max(0, n) times, the length `fill(x n)` has)
        if extra =? 0 and x.lo =? 0 and x.hi =? 0 {
            fact_counted_lengths(n @s pushes fact_clamped(@s hi n))
            return
        }
        # (an unknown count is still never negative: the pushes only grow it)
        fact_counted_lengths(n @s pushes fact_new(@s FactBound(0 FACT_MAX)))
    }
}

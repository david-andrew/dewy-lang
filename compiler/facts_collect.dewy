$runtime_checks

from p"ast.jo" import (nodes)
from p"facts.jo" import (FACT_CAP FactDifference FactProjection FactState fact_add_fits fact_bound fact_loans fact_pending fact_projection_after fact_projection_first fact_reindex fact_set_bound fact_slot fact_stamp fact_stamp_gen fact_summary_entry fact_summary_fields fact_terms)
from p"facts_row_queries.dewy" import (fact_difference_head fact_difference_next)
from p"facts_numeric.dewy" import (fact_quotient_divisor)
from p"facts_ranges.dewy" import (fact_floor_call fact_host_value)
from p"refine.jo" import (refine_entry)
from p"refinement_types.dewy" import (FACT_MAX FACT_MIN FactBound)

CollectWord:type=int64<overflow='wrap'>
# A full state drops the values nothing current reaches: bindings and their
# tombstones, result evidence, entry snapshots, loans and the newest values,
# and what their projections and terms reach. A dropped value is unknown from
# then on: it loses its facts, never gains one.
fact_compact=(@s:FactState):>void=>{
    let keep=dict<int64 bool>()
    let work:array<int64>=[]
    loop b in s.bindings {
        work.push(b.value)
        work.push(b.prior)
    }
    loop c in s.conditional {
        work.push(c.result)
        if c.payload not=? 0 {work.push(c.payload)}
        loop x in c.values {work.push(x)}
    }
    loop x in refine_entry {work.push(x)}
    loop loan in fact_loans {work.push(loan.capacity)}
    loop x in fact_pending {work.push(x)}
    # (the newest values: operands of the expression being evaluated)
    loop j in [max(0 s.ids.length - 32)..s.ids.length) {work.push(s.ids[j])}
    # (terms are followed two levels: an accumulator's chain of sums is not
    # kept whole)
    let depth:array<int64>=fill(0 work.length)
    let i:CollectWord=0
    loop i <? work.length {
        let v=work[i]
        let d=depth[i]
        i += 1
        if v <=? 0 or v >=? fact_terms.length or keep.has(v) {continue}
        keep[v]=true
        if d <? 2 {
            work.push(fact_terms[v].a)
            work.push(fact_terms[v].b)
            depth.push(d + 1)
            depth.push(d + 1)
        }
        let pi=fact_projection_first(s v)
        loop pi >=? 0 {
            let p=s.projections[pi]
            pi=fact_projection_after(s pi)
            work.push(p.value)
            depth.push(d)
            if p.element {
                work.push(p.selector)
                depth.push(d)
            }
        }
    }
    let ids:array<int64>=[]
    let bounds:array<FactBound>=[]
    loop j in [0..s.ids.length) {
        if keep.has(s.ids[j]) {
            ids.push(s.ids[j])
            bounds.push(s.bounds[j])
        }
    }
    let projections:array<FactProjection>=[]
    loop p in s.projections {
        if keep.has(p.base) and keep.has(p.value) {projections.push(p)}
    }
    let differences:array<FactDifference>=[]
    loop row in s.differences {
        if keep.has(row.a) and keep.has(row.b) {differences.push(row)}
    }
    s.ids=ids
    s.bounds=bounds
    s.projections=projections
    s.differences=differences
    fact_reindex(@s)
    # (too little freed: stop compacting this state rather than thrash)
    s.full=ids.length >? FACT_CAP - FACT_CAP // 8
}
fact_collect=(@s:FactState boundary:CollectWord result:CollectWord):>void=>{
    let fresh:CollectWord=0
    loop v in s.ids {
        if v >=? boundary {fresh += 1}
    }
    if fresh <? 16 {return}
    if fact_stamp.length <? fact_terms.length {
        let grow=fact_terms.length - fact_stamp.length + 1024
        loop _ in [0..grow) {fact_stamp.push(0)}
    }
    fact_stamp_gen += 1
    let gen=fact_stamp_gen
    let work:array<int64>=[]
    let depth:array<int64>=[]
    work.push(result)
    loop b in s.bindings {
        work.push(b.value)
        work.push(b.prior)
    }
    loop c in s.conditional {
        work.push(c.result)
        if c.payload not=? 0 {work.push(c.payload)}
        loop x in c.values {work.push(x)}
    }
    loop x in refine_entry {work.push(x)}
    loop loan in fact_loans {work.push(loan.capacity)}
    loop x in fact_pending {work.push(x)}
    loop x in fact_summary_entry {work.push(x)}
    loop entry in fact_summary_fields {work.push(entry[2])}
    depth=fill(0 work.length)
    let kept:CollectWord=0
    let i:CollectWord=0
    loop i <? work.length {
        let v=work[i]
        let d=depth[i]
        i += 1
        if v <=? 0 or v >=? fact_terms.length or fact_stamp[v] =? gen {continue}
        fact_stamp[v]=gen
        if v >=? boundary {kept += 1}
        if d <? 2 {
            work.push(fact_terms[v].a)
            work.push(fact_terms[v].b)
            depth.push(d + 1)
            depth.push(d + 1)
        }
        let pi=fact_projection_first(s v)
        loop pi >=? 0 {
            let p=s.projections[pi]
            pi=fact_projection_after(s pi)
            work.push(p.value)
            depth.push(d)
            if p.element {
                work.push(p.selector)
                depth.push(d)
            }
        }
        # (a row relates its endpoints: a temporary between two live values,
        # `i+1 <? n`, still says something about them)
        loop direction in [0..2) {
            let ri=fact_difference_head(s v direction)
            loop ri >=? 0 {
                let row=s.differences[ri]
                ri=fact_difference_next(s ri direction)
                work.push(if direction =? 0 {row.a} else {row.b})
                depth.push(0)
            }
        }
    }
    let total:CollectWord=0
    loop v in s.ids {
        if fact_stamp[v] =? gen {total += 1}
    }
    if (s.ids.length - total) * 4 <? s.ids.length {return}
    let ids:array<int64>=[]
    let bounds:array<FactBound>=[]
    loop j in [0..s.ids.length) {
        if fact_stamp[s.ids[j]] =? gen {
            ids.push(s.ids[j])
            bounds.push(s.bounds[j])
        }
    }
    let projections:array<FactProjection>=[]
    loop p in s.projections {
        if p.base >? 0 and p.base <? fact_terms.length and fact_stamp[p.base] =? gen and p.value >? 0 and p.value <? fact_terms.length and fact_stamp[p.value] =? gen {projections.push(p)}
    }
    let differences:array<FactDifference>=[]
    loop row in s.differences {
        if fact_stamp[row.a] =? gen and fact_stamp[row.b] =? gen {differences.push(row)}
    }
    s.ids=ids
    s.bounds=bounds
    s.projections=projections
    s.differences=differences
    fact_reindex(@s)
}
# A guard decided `d % c` (c a literal above 1, `n % 2 =? 1` false): d is that remainder plus a
# multiple of c, so its ends move in to the nearest such values (n >=? 1 becomes n >=? 2), and a
# quotient of d already held here follows (`mid = n // 2` is then at least 1). O(1), plus the
# values held here only when the dividend's bounds moved: guards that decide a remainder are rare.
fact_remainder_decided=(@s:FactState r:CollectWord):>void=>$unsafe {
    if r <=? 0 or r >=? fact_terms.length {return}
    let t=fact_terms[r]
    if t.op not=? 'eof' or t.a =? 0 or t.b =? 0 or t.origin <=? 0 or t.origin >=? nodes.length {return}
    let o=t.origin
    if not (nodes.ptr[o].kind =? 'binary' and nodes.ptr[o].op =? int32(62) or nodes.ptr[o].kind =? 'call' and fact_floor_call(o) =? 2) {return}
    let left=fact_bound(s r)
    let c=fact_bound(s t.b)
    let d=fact_bound(s t.a)
    if left.wide or left.lo not=? left.hi or c.wide or c.lo not=? c.hi or c.lo <? 2 or left.lo <? 0 or left.lo >=? c.lo or d.wide or fact_slot(s t.a) <? 0 {return}
    let lo=d.lo
    let hi=d.hi
    if lo >? CollectWord(FACT_MIN) + CollectWord(c.lo) {lo=CollectWord(lo) + fact_floor_mod(CollectWord(left.lo) - CollectWord(lo) c.lo)}
    if hi <? CollectWord(FACT_MAX) - CollectWord(c.lo) {hi=CollectWord(hi) - fact_floor_mod(CollectWord(hi) - CollectWord(left.lo) c.lo)}
    if lo =? d.lo and hi =? d.hi {return}
    fact_set_bound(@s t.a FactBound(lo hi d.nz or lo >? 0 or hi <? 0))
    if not s.live {return}
    loop i in [0..s.ids.length) {
        let q=s.ids[i]
        if fact_terms[q].a not=? t.a {continue}
        let k=fact_quotient_divisor(s q)
        if k <=? 0 {continue}
        let b=fact_bound(s q)
        if b.wide {continue}
        fact_set_bound(@s q FactBound(max(b.lo fact_floor_div(lo k)) min(b.hi fact_floor_div(hi k))))
    }
}
fact_floor_mod=(a:CollectWord c:CollectWord):>CollectWord=>{
    a % c
}
fact_floor_div=(a:CollectWord c:CollectWord):>CollectWord=>{
    a // c
}
# Two current bounds can bring a wide intermediate back into the host domain.
# Each endpoint needs a finite captured neighbor, never a cycle of wide terms.
# Demand-only O(incident rows), already capped at 16 per value by fact_difference.
fact_guarded_word=(@s:FactState value:CollectWord):>void=>{
    let bound=fact_bound(s value)
    let lower=bound.lo >? FACT_MIN
    let upper=bound.hi <? FACT_MAX
    loop side in [0..2) {
        let ri=fact_difference_head(s value side)
        loop ri >=? 0 {
            let row=s.differences[ri]
            ri=fact_difference_next(s ri side)
            let other=if side =? 1 {row.b} else {row.a}
            let q=fact_bound(s other)
            if q.wide {continue}
            if side =? 1 {
                if (q.hi not=? FACT_MAX or fact_host_value(s other)) and fact_add_fits(q.hi row.limit) {
                    bound.hi=min(bound.hi CollectWord(q.hi) + CollectWord(row.limit))
                    upper=true
                }
            }
            else if row.limit not=? FACT_MIN {
                if (q.lo not=? FACT_MIN or fact_host_value(s other)) and fact_add_fits(q.lo (-CollectWord(row.limit))) {
                    bound.lo=max(bound.lo CollectWord(q.lo) - CollectWord(row.limit))
                    lower=true
                }
            }
        }
    }
    if lower and upper {
        bound.wide=false
        bound.reason='missing'
        bound.witness=0
        fact_set_bound(@s value bound true)
    }
}

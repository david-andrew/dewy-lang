StartupWord:type=int64<overflow='wrap'>
# The main module m's own function the game calls by this name (main, update, draw), as its
# symbol; a type's method of that name (`Shape:type = [draw = () => ...]`) is not one.
game_fn=(m:StartupWord name:string):>StartupWord | none=>$unsafe {
    let e=modules[m].names.get(intern(name)) ?? 0
    loop e not=? 0 and syms.ptr[e].kind =? 'fns' and syms.ptr[e].decl not=? 0 and dewy_is_method(StartupWord(syms.ptr[e].decl)) {e=StartupWord(syms.ptr[e].next)}
    if e =? 0 {return none}
    if name =? "main" and files[StartupWord(modules[m].file)].is_dewy and (syms.ptr[e].decl =? 0 or StartupWord(node_mod(nodes.ptr[StartupWord(syms.ptr[e].decl)].op_ext)) not=? m) {return none}
    e
}
# a call of the function `name` with no arguments, anywhere in n but inside function literals
calls_named=(n:StartupWord name:string):>bool=>$unsafe {
    if n =? 0 {return false}
    let k=nodes.ptr[n].kind
    if k =? 'lambda' or k =? 'fn_' {return false}
    if k =? 'call' and nkids(n) =? 0 and nodes.ptr[n].a not=? 0 and nodes.ptr[StartupWord(nodes.ptr[n].a)].kind =? 'ident' and name_of(StartupWord(nodes.ptr[StartupWord(nodes.ptr[n].a)].name)) =? name {return true}
    if calls_named(StartupWord(nodes.ptr[n].a) name) or calls_named(StartupWord(nodes.ptr[n].b) name) {return true}
    if k not=? 'for_' and calls_named(StartupWord(nodes.ptr[n].c) name) {return true}
    loop i in [0..nkids(n)) {
        if calls_named(kid(n i) name) {return true}
    }
    false
}
# (enemies = [] at the top level, filled by a function: that function is checked first, so the
# type of what it pushes is known where enemies is read)
check_pushers_first=():>void=>$unsafe {
    let names=dict<int64 bool>()
    loop mi in [0..modules.length) {
        if modules[mi].is_prelude {continue}
        loop d in modules[mi].decls {
            if nodes.ptr[d].kind =? 'vardecl' and nodes.ptr[d].nlist =? 0 and nodes.ptr[d].a =? 0 and nodes.ptr[d].b not=? 0 and nodes.ptr[StartupWord(nodes.ptr[d].b)].kind =? 'array' and nkids(StartupWord(nodes.ptr[d].b)) =? 0 {
                names[StartupWord(nodes.ptr[d].name)]=true
                dc_force_module(mi)
            }
        }
    }
    if names.length =? 0 {return}
    dc_force_all()
    loop m in modules {
        if m.is_prelude {continue}
        loop d in m.decls {
            if nodes.ptr[d].kind =? 'fn_' and not has_flag(d NF_EXTERN) and nodes.ptr[d].b not=? 0 and pushes_into(StartupWord(nodes.ptr[d].b) names) and not fn_sig(d).generic and not decl_has_rest(d) {
                let f=get_fn_inst(d [] nodes.ptr[d].pos)
                # (before the top level's code, too, which may read it)
                if fns.ptr[f].state =? 0 {check_fn_body(f)}
            }
        }
    }
}
# (new instances since the last call: an extern among them brings in what its thunk calls)
let runtime_ffi_strings=false
runtime_string_parameter=(f:StartupWord):>bool=>$unsafe {
    loop t in fns.ptr[f].ptypes {
        if tkind(t) =? 'str_' {return true}
    }
    false
}
runtime_ffi_demand=():>bool=>$unsafe {
    let done = @runtime_ffi_done
    if done {return false}
    let scan = @runtime_ffi_scan
    loop scan <? fns.length {
        let d=StartupWord(fns.ptr[scan].decl)
        # (a `$export` function taking a string passes and takes it as C's `char *` too)
        let strings=fns.ptr[scan].cabi and d not=? 0 and not has_flag(d NF_EXTERN) and runtime_string_parameter(scan)
        scan = StartupWord(scan) + 1
        if strings and not runtime_ffi_strings {
            runtime_ffi_strings=true
            runtime_demand("__c_str")
            runtime_demand("__cstr")
            return true
        }
        if d not=? 0 and has_flag(d NF_EXTERN) {
            done = true
            if prelude_game_pending {load_game_file("dl.jo");}
            loop nm in ["__c_str" "__cstr" "__ffi_resolve" "__ffi_missing"] {runtime_demand(nm)}
            return true
        }
    }
    false
}
register_universe_type=(name:string ty:int64):>void=>{
    let nm = intern(name)
    universe[nm] = new_sym(nm 'type_' ty 0)
}

register_universe_constant=(name:string value:int64 ty:int64):>void=>{
    let nm = intern(name)
    globals.push(Global(name=int32<overflow='wrap'>(nm) is_const=true init=int32<overflow='wrap'>(value) state=2 type=int32<overflow='wrap'>(ty)))
    universe[nm] = new_sym(nm 'const_' (StartupWord(globals.length) - 1) 0)
}

add_universe=():>void=>{
    ml_bump()
    let demand = @demanded
    demand = []
    exception_builtins()
    register_universe_type("__dewy_int" T_MATH_INT)
    register_universe_type("int" T_INT)
    register_universe_type("i8" T_I8)
    register_universe_type("i16" T_I16)
    register_universe_type("i32" T_I32)
    register_universe_type("i64" T_INT)
    register_universe_type("u8" T_U8)
    register_universe_type("byte" T_U8)
    register_universe_type("u16" T_U16)
    register_universe_type("u32" T_U32)
    register_universe_type("u64" T_U64)
    register_universe_type("f64" T_FLOAT)
    register_universe_type("f32" T_F32)
    register_universe_type("int8" T_I8)
    register_universe_type("int16" T_I16)
    register_universe_type("int32" T_I32)
    register_universe_type("int64" T_INT)
    register_universe_type("uint8" T_U8)
    register_universe_type("uint16" T_U16)
    register_universe_type("uint32" T_U32)
    register_universe_type("uint64" T_U64)
    register_universe_type("float32" T_F32)
    register_universe_type("float64" T_FLOAT)
    register_universe_type("string" T_STR)
    register_universe_type("bool" T_BOOL)
    register_universe_type("str" T_STR)
    register_universe_type("void" T_VOID)
    register_universe_type("never" T_NEVER)
    register_universe_type("vec2" T_VEC2)
    register_universe_type("vec3" T_VEC3)
    register_universe_type("vec4" T_VEC4)
    register_universe_type("mat4" T_MAT4)
    register_universe_type("ivec2" T_IVEC2)
    register_universe_type("ivec3" T_IVEC3)
    register_universe_type("ivec4" T_IVEC4)
    let active = @refine_active
    let saved = active
    let addr = @ref_addr_type
    let atoms = [RefAtom('le' RefTerm(1 0) RefTerm()) RefAtom('le' RefTerm() RefTerm(1 ref_addr_max()))]
    addr = mk_refined(T_INT ref_intern(atoms))
    universe[intern("addr")] = new_sym(intern("addr") 'type_' addr 0)
    active = saved
    # An unused MemoryOrder must not enable finite-string-domain analysis.
    let order = mk('typealias' 0)
    nodes[order].name = int32<overflow='wrap'>(intern("MemoryOrder"))
    nodes[order].aux = -7
    universe[intern("MemoryOrder")] = new_sym(intern("MemoryOrder") 'alias_' order order)
    let tv = mk('str_lit' 0)
    nodes[tv].op_ext=node_with_sval(nodes[tv].op_ext (int32<overflow='wrap'>(intern(target_const()))))
    let av = mk('str_lit' 0)
    let arch = "x86_64"
    if target_wasm {arch = "wasm32"}
    if target_arm64 {arch = "arm64"}
    nodes[av].op_ext=node_with_sval(nodes[av].op_ext (int32<overflow='wrap'>(intern(arch))))
    let tr = mk('bool_lit' 0)
    if not release_build {nodes[tr].ival = 1}
    let fl = mk('bool_lit' 0)
    let wv = mk('bool_lit' 0)
    if watch_build {nodes[wv].ival = 1}
    let pn = mk('str_lit' 0)
    nodes[pn].op_ext=node_with_sval(nodes[pn].op_ext (int32<overflow='wrap'>(intern(program_name))))
    let icon = @icon_node
    icon = mk('str_lit' 0)
    nodes[icon].op_ext=node_with_sval(nodes[icon].op_ext (int32<overflow='wrap'>(intern(""))))
    register_universe_constant("TARGET" tv T_STR)
    register_universe_constant("ARCH" av T_STR)
    register_universe_constant("DEBUG" tr T_BOOL)
    register_universe_constant("BOOTSTRAP" fl T_BOOL)
    register_universe_constant("WATCH" wv T_BOOL)
    register_universe_constant("PROGRAM_NAME" pn T_STR)
    register_universe_constant("PROGRAM_ICON" icon T_STR)
    register_quantity_names()
    register_intrinsics()
    ml_bump()
}
# TARGET's value
target_const=():>string=>{
    let tgt="linux"
    if target_wasm {tgt="wasm"}
    if target_windows {tgt="windows"}
    if target_macos {tgt="macos"}
    tgt
}
load_std_file=(n:string):>bool=>{
    if n =? "tasks.jo" {
        load_std_file("task_core.jo");
        load_std_file("thread.jo");
    }
    else if n =? "task_input.jo" {
        load_std_file("task_core.jo");
        load_std_file("files.jo");
    }
    else if n =? "thread.jo" {
        load_std_file("task_core.jo");
        load_std_file("fork_join.jo");
    }
    let path="{lib_dir}/std/{n}"
    if module_by_path.get(module_path_key(path)) not=? none {return false}
    let first=modules.length
    let m:StartupWord=-1
    if defer_prelude(path "std") {m=StartupWord(modules.length) - 1}
    else {m=load_module(path true (-1))}
    let thread_mod=@concurrency_thread_module
    let task_mod=@concurrency_task_module
    let task_core_mod=@concurrency_task_core_module
    if n =? "thread.jo" {thread_mod = m}
    if n =? "tasks.jo" {task_mod = m}
    if n =? "task_core.jo" {task_core_mod = m}
    if registered.length >? 0 {
        loop mi in [first..modules.length) {register_module(mi)}
    }
    if module_ctx.length >? 0 {setup_module_contexts(init_fns[0])}
    loop i in [0..demanded.length) {demanded[i] = false}
    loop i in [0..pn_seen.length) {pn_seen[i] = false}
    ml_bump()
    true
}

load_std_prelude=():>void=>{
    let pending=@prelude_std_pending
    if not pending {return}
    pending=false
    let first=modules.length
    let names_=list_dir("{lib_dir}/std")
    names_.sort()
    let thread_mod=@concurrency_thread_module
    let task_mod=@concurrency_task_module
    let task_core_mod=@concurrency_task_core_module
    loop n in names_ {
        if not ends_with(n ".jo") or not std_optional_file(n) {continue}
        let path="{lib_dir}/std/{n}"
        if module_by_path.get(module_path_key(path)) not=? none {continue}
        let m:StartupWord=-1
        if defer_prelude(path "std") {m=StartupWord(modules.length) - 1}
        else {m=load_module(path true (-1))}
        if n =? "thread.jo" {thread_mod = m}
        if n =? "tasks.jo" {task_mod = m}
        if n =? "task_core.jo" {task_core_mod = m}
    }
    if registered.length >? 0 {
        loop m in [first..modules.length) {register_module(m)}
    }
    if module_ctx.length >? 0 {setup_module_contexts(init_fns[0])}
    loop i in [0..demanded.length) {demanded[i] = false}
    loop i in [0..pn_seen.length) {pn_seen[i] = false}
    ml_bump()
}

load_game_file=(n:string):>bool=>{
    let path="{lib_dir}/game/{n}"
    if module_by_path.get(module_path_key(path)) not=? none {return false}
    let first=modules.length
    if not defer_prelude(path "game") {load_module(path true (-1));}
    if registered.length >? 0 {
        loop m in [first..modules.length) {register_module(m)}
    }
    if module_ctx.length >? 0 {setup_module_contexts(init_fns[0])}
    loop i in [0..demanded.length) {demanded[i] = false}
    loop i in [0..pn_seen.length) {pn_seen[i] = false}
    ml_bump()
    true
}

load_game_prelude=():>void=>{
    let pending=@prelude_game_pending
    if not pending {return}
    pending=false
    if prelude_std_pending {load_std_prelude()}
    let first=modules.length
    let names_=list_dir("{lib_dir}/game")
    names_.sort()
    loop n in names_ {
        if not ends_with(n ".jo") {continue}
        let path="{lib_dir}/game/{n}"
        if module_by_path.get(module_path_key(path)) not=? none {continue}
        if not defer_prelude(path "game") {load_module(path true (-1));}
    }
    if registered.length >? 0 {
        loop m in [first..modules.length) {register_module(m)}
    }
    if module_ctx.length >? 0 {setup_module_contexts(init_fns[0])}
    loop i in [0..demanded.length) {demanded[i] = false}
    loop i in [0..pn_seen.length) {pn_seen[i] = false}
    ml_bump()
}

let prelude_game_extra:StartupWord=-1
let prelude_custom_lib:bool=false
std_file_route=(nm:string):>StartupWord=>$unsafe {
    let n=StartupWord((nm as array<uint8>).length)
    if n =? 0 {return -1}
    let p=(nm as array<uint8>).ptr
    let mask=(StartupWord((STD_PREFIX_SPEC as array<uint8>).length) >> 1) - 2
    let b=(17 * StartupWord(p[0]) + 31 * StartupWord(p[n >> 1]) + 7 * StartupWord(p[n - 1]) + n) & mask
    let off=(STD_PREFIX_SPEC as array<uint8>).ptr as ptr<uint16>
    let i=StartupWord(off[b])
    let stop=StartupWord(off[b + 1])
    let r=(STD_FILE_SPEC as array<uint8>).ptr
    loop i <? stop {
        let size=StartupWord(r[i])
        if size =? n and __mem_eq(p r + i + 2 n) {
            let file=StartupWord(r[i + 1])
            if file >=? 128 {return -2}
            return file
        }
        i += size + 2
    }
    -1
}
std_files_for=(nm:string):>array<string>=>$unsafe {
    let out:array<string>=[]
    let n=StartupWord((nm as array<uint8>).length)
    if n =? 0 {return out}
    let p=(nm as array<uint8>).ptr
    let mask=(StartupWord((STD_PREFIX_SPEC as array<uint8>).length) >> 1) - 2
    let b=(17 * StartupWord(p[0]) + 31 * StartupWord(p[n >> 1]) + 7 * StartupWord(p[n - 1]) + n) & mask
    let off=(STD_PREFIX_SPEC as array<uint8>).ptr as ptr<uint16>
    let i=StartupWord(off[b])
    let stop=StartupWord(off[b + 1])
    let r=(STD_FILE_SPEC as array<uint8>).ptr
    loop i <? stop {
        let size=StartupWord(r[i])
        if size =? n and __mem_eq(p r + i + 2 n) {
            out.push(std_file_init(int64(StartupWord(r[i + 1]) & 127)))
        }
        i += size + 2
    }
    out
}
game_file_route=(nm:string):>StartupWord=>$unsafe {
    let n=StartupWord((nm as array<uint8>).length)
    if n =? 0 {return -1}
    let p=(nm as array<uint8>).ptr
    let mask=(StartupWord((GAME_PREFIX_SPEC as array<uint8>).length) >> 1) - 2
    let b=(17 * StartupWord(p[0]) + 31 * StartupWord(p[n >> 1]) + 7 * StartupWord(p[n - 1]) + n) & mask
    let off=(GAME_PREFIX_SPEC as array<uint8>).ptr as ptr<uint16>
    let i=StartupWord(off[b])
    let stop=StartupWord(off[b + 1])
    let r=(GAME_FILE_SPEC as array<uint8>).ptr
    let dunder=starts_with(nm "__")
    let target:StartupWord=if target_wasm {8} else if target_macos {4} else if target_windows {2} else {1}
    let found=false
    loop i <? stop {
        let size=StartupWord(r[i])
        if size =? n and __mem_eq(p r + i + 3 n) {
            found=true
            if dunder and (StartupWord(r[i + 2]) & target) not=? 0 {return StartupWord(r[i + 1])}
        }
        i += size + 3
    }
    if found {-2} else {-1}
}
prelude_game_has_extra=():>bool=>{
    if prelude_game_extra >=? 0 {return prelude_game_extra =? 1}
    std_file_init(0);
    let names_=list_dir("{lib_dir}/game")
    let extra=false
    loop n in names_ {
        if not ends_with(n ".jo") {continue}
        if not prelude_index_files.contains(n) {
            extra=true
            break
        }
    }
    prelude_game_extra=if extra {1} else {0}
    extra
}
load_std_for_name=(nm:string):>bool=>{
    if not prelude_std_pending {return false}
    let r=std_file_route(nm)
    if r =? -1 {return false}
    if r >=? 0 {return load_std_file(std_file_init(int64(r)))}
    let any=false
    loop f in std_files_for(nm) {
        if load_std_file(f) {any=true}
    }
    any
}
load_game_for_name=(nm:string allow_bulk:bool):>bool=>{
    if not prelude_game_pending {return false}
    let r=game_file_route(nm)
    if r >=? 0 {return load_game_file(std_file_init(int64(r)))}
    if not allow_bulk {return false}
    if r =? -2 or prelude_game_has_extra() {
        load_game_prelude()
        return true
    }
    false
}

load_prelude=():>void=>{
    # all .jo files in lib/core, lib/std and lib/game are loaded into the shared prelude scope
    # (lib/core must stay compilable by the C bootstrap compiler; lib/std need not)
    prelude_game_extra=-1
    prelude_custom_lib=env("DEWY_CORE_LIB") not=? none
    prelude_lazy_setup()
    let game_pending=@prelude_game_pending
    let std_pending=@prelude_std_pending
    game_pending=prelude_lazy and not prelude_game_hint
    std_pending=prelude_lazy and not prelude_game_hint
    let thread_mod = @concurrency_thread_module
    thread_mod = -1
    let task_mod = @concurrency_task_module
    task_mod = -1
    let task_core_mod = @concurrency_task_core_module
    task_core_mod = -1
    let protocol_mod = @concurrency_protocol_module
    protocol_mod = -1
    let first_ok_mod = @concurrency_first_ok_module
    first_ok_mod = -1
    let subs=if prelude_game_pending {["core" "std"]} else {["core" "std" "game"]}
    loop sub in subs {
        let names_=list_dir("{lib_dir}/{sub}")
        names_.sort()
        loop n in names_ {
            if not ends_with(n ".jo") {continue}
            if sub =? "core" and n =? "macos.jo" and not target_macos {continue}
            if sub =? "core" and n =? "windows.jo" and not target_windows {continue}
            if sub =? "std" and prelude_std_pending and std_optional_file(n) {continue}
            let path="{lib_dir}/{sub}/{n}"
            let m:StartupWord=-1
            if defer_prelude(path sub) {m=StartupWord(modules.length) - 1} else {m=load_module(path true (-1))}
            if sub =? "std" {
                if n =? "thread.jo" {thread_mod = m}
                if n =? "tasks.jo" {task_mod = m}
                if n =? "task_core.jo" {task_core_mod = m}
            }
        }
    }
    prelude_known_names()
    # Keep existing fixed-width overloads first for widening ties. Separate from
    # the seed-scanned prelude: old seeds do not know the mathematical type.
    let math = "{lib_dir}/math_int.jo"
    if file_exists(math) {load_module(math true (-1));}
}

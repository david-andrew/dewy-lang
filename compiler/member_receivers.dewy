$runtime_checks
from p"checker_call_queries.dewy" import (collect_fns collect_module ctx_dependent)
from p"call_argument_checks.dewy" import (match_type)
from p"checker_method_receiver.dewy" import (method_modules)
from p"lexer_helpers.dewy" import (is_ident_char)
from p"set_type_queries.dewy" import (is_dewy_set_type)
from p"checker_signature.dewy" import (fn_sig)
from p"diagnostic_exit.dewy" import (fatal)
from p"checks_thin_expr.dewy" import (dewy_set_literal is_map_type)
from p"checker_source_positions.dewy" import (dewy_at)
from p"call_shape_queries.dewy" import (copy_member)
from p"type_ops.dewy" import (simple_enum)
from p"types.jo" import (T_BOOL T_NEVER prune structs telem tkind type_eq types)
from p"poly_closure.jo" import (poly_families)
from p"check.jo" import (lib_dir)
from p"dewy_method_ops.dewy" import (dewy_is_method)
from p"checker_module_lookup.dewy" import (module_lookup)
from p"ast.jo" import (NF_CHECKED dewy_len_members has_flag kid mk nkids nodes)
from p"checker_expr.dewy" import (check_expr)
from p"expr.jo" import (last_checked type_receiver_at)
from p"ffi_checks.dewy" import (ffi_deref)
from p"node_store.dewy" import (Node)
from p"util.jo" import (files intern name_of pos_file pos_off)

MemberReceiverWord:type=int64<overflow='wrap'>

expr_module=(m:int64 name:int64):>int64=>module_lookup(m name)

index_deref=(pos:int64 bt:int64):>void=>{ffi_deref(pos bt)}

# (Dewy's `xs.length` is `xs.len()`; `xs.ptr`, where an array's elements are, is
# `xs.data()`: a ptr<T> for C (provisional spelling))
member_call=(n:MemberReceiverWord data:bool expected:MemberReceiverWord):>int64=>$unsafe {
    let method=mk('field' nodes.ptr[n].pos)
    nodes.ptr[method].a=nodes.ptr[n].a
    nodes.ptr[method].name=int32(intern(if data {"data"} else {"len"}))
    nodes[n]=Node(kind='call' pos=nodes.ptr[n].pos a=int32(method))
    check_expr(n expected)
}

member_receiver=(n:MemberReceiverWord expected:MemberReceiverWord):>int64=>$unsafe {
    let at=@type_receiver_at
    let saved=at
    let receiver=MemberReceiverWord(nodes.ptr[n].a)
    at=receiver
    let bt=check_expr(receiver receiver_literal_hint(receiver MemberReceiverWord(nodes.ptr[n].name) 0 expected nodes.ptr[n].pos))
    at=saved
    nodes.ptr[n].a=int32(last_checked)
    bt
}

is_dewy_range_type=(t:int64 name:string):>bool=>$unsafe {
    let p=prune(t)
    if types.ptr[p].kind not=? 'struct_' {return false}
    let st=MemberReceiverWord(types.ptr[p].st)
    if structs.ptr[st].name not=? name {return false}
    let d=MemberReceiverWord(structs.ptr[st].decl)
    d not=? 0 and files.ptr[pos_file(nodes.ptr[d].pos)].path =? "{lib_dir}/std/dewy_ranges.jo"
}

# A record literal's method: a closure stored in the object, taking the object first.
# (a record literal's method is kept in the object, but it is not one of its fields:
# formatting leaves it out)
dewy_method_field=(t0:int64):>int64=>$unsafe {
    let t=prune(t0)
    if tkind(t) not=? 'polyfn' {return 0}
    let d=poly_families[MemberReceiverWord(types.ptr[t].st)].decl
    if dewy_is_method(d) {d} else {0}
}

is_struct_like=(t0:int64):>bool=>$unsafe {
    let t=prune(t0)
    let k=types.ptr[t].kind
    k =? 'struct_' or k =? 'tuple' or (k =? 'enum_' and not simple_enum(t))
}

# A short spelling of a receiver for a suggested call.
receiver_text=(n:int64):>string=>$unsafe {
    if nodes.ptr[n].kind =? 'ident' {return name_of(MemberReceiverWord(nodes.ptr[n].name))}
    "x"
}

synthetic_copy=(t:int64 name:int64 pos:int64):>bool=>$unsafe {
    if name_of(name) not=? "copy" or not files.ptr[pos_file(pos)].is_dewy {return false}
    let k=tkind(t)
    if k =? 'module' or k =? 'typeval' or k =? 'void_' or t =? T_NEVER {return false}
    if copy_member(t name) {return false}
    # Uniform-call methods are user declarations too.
    let decls:array<int64>=[]
    collect_fns(name @decls)
    loop m in method_modules(t) {collect_module(m name @decls)}
    loop d in decls {
        if nkids(d) =? 0 {continue}
        let sig=fn_sig(d)
        let binds:array<int64>=fill(0 MemberReceiverWord(sig.ntp))
        if match_type(sig.params[0] t @binds 0) >=? 0 {return false}
    }
    true
}

# (`let xs:array<Op> = ['push'].copy`: a collection literal (or a call, `set(['push']).copy`)
# whose method gives a value of its own type, as copy, sorted and reversed do, takes the type
# expected of the result, as the literal written there would; Dewy only, and only when every function of the name
# that could take the arguments gives its first parameter's type)
receiver_literal_hint=(recv:int64 name:int64 nargs:int64 expected:int64 pos:int64):>int64=>$unsafe {
    if expected =? 0 or not dewy_at(pos) {return 0}
    let k=nodes.ptr[recv].kind
    let literal=(k =? 'array' or k =? 'map_lit' or dewy_set_literal(recv)) and ctx_dependent(recv)
    if not literal and not (k =? 'call' and nodes.ptr[recv].type =? 0 and not has_flag(recv NF_CHECKED)) {return 0}
    let want=prune(expected)
    if tkind(want) =? 'opt' {want=prune(telem(want))}
    let wk=tkind(want)
    if wk not=? 'array' and not is_map_type(want) and not is_dewy_set_type(want) {return 0}
    let decls:array<int64>=[]
    collect_fns(name @decls)
    if decls.length =? 0 {return if name_of(name) =? "copy" {want} else {0}}
    let some=false
    loop d in decls {
        let np=nkids(d)
        if np <? nargs + 1 {continue}
        let takes=true
        loop j in [nargs + 1..np) {
            if nodes.ptr[kid(d j)].b =? 0 {takes=false}
        }
        if not takes {continue}
        let sig=fn_sig(d)
        let binds:array<int64>=fill(0 MemberReceiverWord(sig.ntp))
        if match_type(sig.params[0] want @binds 0) <? 0 {continue}
        if sig.ret =? 0 or not type_eq(MemberReceiverWord(sig.ret) sig.params[0]) {return 0}
        some=true
    }
    if some {want} else {0}
}

# The library's names for Dewy's members: `xs.pop(i)` removes by position,
# `xs.insert(value i)` names the value first, `text.startswith(p)`. The
# library's own spellings are not Dewy's.
# (Dewy's length is `.length`: the Sloppy library's `len` of an array, string, dictionary or set,
# written in a Dewy program, is told so)
dewy_len_check=(n:int64 member:bool t0:int64 object:int64):>void=>$unsafe {
    if not dewy_at(nodes.ptr[n].pos) {return}
    let t=prune(t0)
    let k=tkind(t)
    if member and k not=? 'array' and k not=? 'fixed' and k not=? 'str_' and not is_map_type(t) and not is_dewy_set_type(t) {return}
    if member {
        if (dewy_len_members.get(n) ?? -1) not=? nodes.ptr[n].pos {return}
        fatal(nodes.ptr[n].pos "Dewy's length is `.length`: write `{receiver_text(object)}.length`")
    }
    let f=pos_file(nodes.ptr[n].pos)
    let o=pos_off(nodes.ptr[n].pos)
    let src=files.ptr[f].src as array<uint8>
    if o + 3 >? src.length or not (src[o] =? 108 and src[o + 1] =? 101 and src[o + 2] =? 110) or (o + 3 <? src.length and is_ident_char(src[o + 3])) or (o >? 0 and is_ident_char(src[o - 1])) {return}
    fatal(nodes.ptr[n].pos "Dewy's length is `.length`: write `{receiver_text(object)}.length`")
}

dewy_member_name=(callee:int64 rt:int64 fname:int64 args:array<int64>):>int64=>$unsafe {
    let k=types.ptr[rt].kind
    let name=name_of(fname)
    let nlen=(name as array<uint8>).length
    if nlen =? 0 {return fname}
    let c0=(name as array<uint8>).ptr[0]
    if k =? 'array' {
        if c0 =? 112 and nlen =? 3 and args.length =? 1 and name =? "pop" {return intern("remove")}
        if c0 =? 105 {
            if nlen =? 6 and name =? "insert" {return intern("__dewy_insert")}
            if nlen =? 8 and args.length =? 1 and name =? "index_of" {return intern("__dewy_index_of")}
        }
        if c0 =? 114 and nlen =? 6 and name =? "remove" {fatal(nodes.ptr[callee].pos "an array removes by position with pop: `{receiver_text(MemberReceiverWord(nodes.ptr[callee].a))}.pop(i)`")}
        if c0 =? 97 and nlen =? 3 and args.length =? 0 and (name =? "any" or name =? "all") and prune(MemberReceiverWord(types.ptr[rt].elem)) not=? T_BOOL {
            fatal(nodes.ptr[callee].pos "{name} without a predicate is for an array of bools, `{name}(flags)`: give it one, `{receiver_text(MemberReceiverWord(nodes.ptr[callee].a))}.{name}(x => x >? 0)`")
        }
        return fname
    }
    if k =? 'str_' {
        if c0 =? 99 and nlen =? 5 and args.length =? 0 and name =? "chars" {return intern("graphemes")}
        if c0 =? 102 and nlen =? 4 and name =? "find" {return intern("__dewy_find")}
        if c0 =? 114 and nlen =? 5 and name =? "rfind" {return intern("__dewy_rfind")}
        if c0 =? 98 and nlen =? 10 and args.length =? 2 and name =? "byte_slice" {return intern("__dewy_byte_slice")}
        if c0 =? 115 {
            if nlen =? 10 and name =? "startswith" {return intern("starts_with")}
            if nlen =? 11 and name =? "starts_with" {fatal(nodes.ptr[callee].pos "write `{receiver_text(MemberReceiverWord(nodes.ptr[callee].a))}.{replace(name "_" "")}(...)`")}
        }
        if c0 =? 101 {
            if nlen =? 8 and name =? "endswith" {return intern("ends_with")}
            if nlen =? 9 and name =? "ends_with" {fatal(nodes.ptr[callee].pos "write `{receiver_text(MemberReceiverWord(nodes.ptr[callee].a))}.{replace(name "_" "")}(...)`")}
        }
        return fname
    }
    if c0 =? 97 and nlen =? 3 and name =? "add" and is_dewy_set_type(rt) {fatal(nodes.ptr[callee].pos "sets insert with push: replace `{receiver_text(MemberReceiverWord(nodes.ptr[callee].a))}.add(value)` with `{receiver_text(MemberReceiverWord(nodes.ptr[callee].a))}.push(value)`")}
    if c0 =? 107 and nlen =? 4 and args.length =? 0 and name =? "keys" and is_map_type(rt) {return intern("__dewy_keys")}
    fname
}

# Demand-only integer constant names in type syntax; mirrors the checked lane.
named_integer_type = (tn: int, s: int) -> int:
    if nodes[tn].nlist != 0: return 0
    if binding_const_init(syms[s].kind, int(syms[s].ref), nodes[tn].pos) == 0: return 0
    value = mk(.ident, nodes[tn].pos)
    nodes[value].name = nodes[tn].name
    if nodes[tn].sval != 0:
        base = mk(.ident, nodes[tn].pos)
        nodes[base].name = nodes[tn].sval
        nodes[value].kind = .field
        nodes[value].a = i32(base)
    check_expr(value, 0)
    checked = last_checked
    t = representation_type(ntype(checked))
    if not is_int(t): return 0
    result = ct_run(checked)
    v = ct_values[result]
    if t == T_MATH_INT and v.items.len() > 0 or not types[t].sign and v.i < 0:
        fatal(nodes[tn].pos, "an integer type argument must fit int64")
    mk_refined(T_INT, ref_intern([
        RefAtom(.le, RefTerm(1, v.i), RefTerm()),
        RefAtom(.le, RefTerm(), RefTerm(1, v.i))
    ]))

checked_array_length = (n: int) -> int:
    value = clone(n)
    if nodes[value].kind == .tname:
        nodes[value].kind = .ident
        if nodes[value].sval != 0:
            base = mk(.ident, nodes[value].pos)
            nodes[base].name = nodes[value].sval
            nodes[value].kind = .field
            nodes[value].a = i32(base)
    check_expr(value, T_MATH_INT)
    checked = last_checked
    finalize_literal(checked)
    t = representation_type(ntype(checked))
    if not is_int(t): fatal(nodes[n].pos, "an array length must be a compile-time integer")
    result = ct_run(checked)
    v = ct_values[result]
    if t == T_MATH_INT and v.items.len() > 0 or not types[t].sign and v.i < 0 or v.i > (1 << 28):
        fatal(nodes[n].pos, "fixed-size array too large (use array<T> for big arrays)")
    if v.i < 1: fatal(nodes[n].pos, "the size of a fixed-size array must be at least 1 (found {v.i})")
    v.i

# Singleton integer parameters also read as constants in type annotations.
integer_parameter_literal = (n: int) -> int:
    if nodes[n].kind != .ident: return 0
    s = lookup(int(nodes[n].name))
    if s == 0 or syms[s].kind != .type_: return 0
    t = int(syms[s].ref)
    if tkind(t) != .refined: return 0
    known, bounds = int_intervals(t)
    if not known or bounds.len() != 2 or bounds[0] != bounds[1]: return 0
    literal = mk(.int_lit, nodes[n].pos)
    nodes[literal].ival = bounds[0]
    literal

# RefTerm 7 defers an integer value; 8 also holds the fixed-length size bound.
integer_parameter_type = (n: int) -> int:
    if nodes[n].kind != .ident: return 0
    s = lookup(int(nodes[n].name))
    if s == 0 or syms[s].kind != .type_: return 0
    t = int(syms[s].ref)
    if tkind(t) == .param: return t
    0
length_has_parameter = (n: int) -> bool:
    if integer_parameter_type(n) != 0: return true
    k = nodes[n].kind
    if k == .binary: return length_has_parameter(int(nodes[n].a)) or length_has_parameter(int(nodes[n].b))
    false
parameterized_array_type = (tn: int, element: int) -> int:
    length = int(nodes[tn].b)
    if not length_has_parameter(length): return 0
    term = ref_resolve_term(nodes, types, names, refine_bindings, ref_resolve_host, length, 0)
    if term.kind != 7: fatal(nodes[length].pos, "an array length must name a compile-time integer or integer type parameter")
    term.kind = 8 # integer parameter, additionally checked as a fixed-array length
    predicate = ref_intern([RefAtom(.eq, RefTerm(path=[-1]), term)])
    if not ref_spans.has(predicate): ref_spans[predicate] = nodes[tn].pos
    mk_refined(tb_mk_array(element), predicate)

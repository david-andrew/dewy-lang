use 'parse.jo'
use 'lex.jo'
use 'lexer_scan.dewy'
p_lex_unit = (file: int, src: str, from: int = 0, to: int = -1):
    toks = lex(file, src, from, to)
    p_toks = data(toks)
    p_ntoks = toks.len()

p_clear_unit = ():
    if toks.cap() > lx_tok_pool.cap(): lx_tok_pool = toks
    toks = []
    p_toks = null
    p_ntoks = 0

parser_lifetime_bind = (tokens: *int) -> int: 0

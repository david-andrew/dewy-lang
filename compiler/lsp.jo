use 'checker_program.dewy'
# A language server (`dewy lsp`): the Language Server Protocol over standard input and output,
# for editors. Each question about a program is answered by checking it in a child process
# (fork; on Windows, this program again: run_child_w32): the checker then always starts afresh, sees the editor's unsaved text (ide_texts), and
# writes what it learned as lines (see ide.jo). Checks take tens of milliseconds, so there is no
# incremental state to keep right; results of the last check are kept for hover, go to
# definition, references, rename, signature help and inlay hints.

use 'util.jo'
use 'module_paths.dewy'
use 'ast.jo'
use 'types.jo'
use 'type_ops.dewy'
use 'check.jo'
use 'ide.jo'
use 'ide_text.dewy'
use 'fmt.jo'
use 'lex.jo'
use 'main.jo'
use 'json_doc.dewy'
use 'lsp_ops.dewy'
use 'lsp_handlers.dewy'
use 'lsp_text.dewy'
use 'lsp_requests.dewy'

# ---------------- JSON ----------------
# the message being answered (json_doc.dewy), and its values
jdoc: JsonDoc

# ---------------- messages ----------------
inbuf: u8[]
inpos = 0
in_eof = false

lsp_fill = () -> bool:
    if inpos > 0 and inpos == inbuf.len():
        inbuf.clear()
        inpos = 0
    n = inbuf.len()
    inbuf.resize(n + 65536)
    r = __read_fd(0, data(inbuf) + n, 65536)
    if r <= 0:
        inbuf.resize(n)
        in_eof = true
        return false
    inbuf.resize(n + r)
    true

# the end of the headers of the next message (after \r\n\r\n), or -1
lsp_header_end = () -> int:
    i = inpos
    n = inbuf.len()
    loop i + 3 < n:
        if inbuf[i] == '\r' and inbuf[i + 1] == '\n' and inbuf[i + 2] == '\r' and inbuf[i + 3] == '\n': return i + 4
        i += 1
    -1

lsp_body_len = (h0: int, h1: int) -> int:
    hs = lower(str_from_bytes(inbuf[h0..h1)))
    k = find(hs, "content-length:")
    if k < 0: return 0
    e = find_byte(hs, '\r', k)
    to_int(trim(hs[k + 15..e))) ?? 0

# input waiting, or arriving within ms milliseconds?
lsp_wait_input = (ms: int) -> bool:
    if lsp_have_msg(): return true
    when TARGET == "windows":
        # (standard input is a pipe from the editor: look into it until there is something)
        h = GetStdHandle(u32(0xFFFFFFF6))
        avail: u32[] = [0]
        until = time() + f64(ms) / 1000.0
        loop true:
            if PeekNamedPipe(h, null, 0, null, data(avail), null) == 0:
                # (input that cannot be looked into, as under Wine: there is nothing until a read
                # finds something; otherwise the editor is gone, and reading says so)
                return GetLastError() != u32(50)
            if avail[0] > 0: return true
            if time() >= until: return false
            Sleep(1)
        return false
    else:
        fds = [0 | (1 << 32)]                   # struct pollfd: fd 0, events POLLIN
        return syscall(7, data(fds), 1, ms) > 0

lsp_read = () -> str?:
    loop true:
        he = lsp_header_end()
        if he >= 0:
            n = lsp_body_len(inpos, he)
            if inbuf.len() - he >= n:
                body = str_from_bytes(inbuf[he..he + n))
                inpos = he + n
                return body
        if in_eof or not lsp_fill(): return none
    none

# the next message to act on. What has arrived already is read first: a request the editor has
# cancelled since is answered "cancelled", and one about a document changed since "content
# modified" (its answer would be about old text), so a backlog of checks is not worked through
lsp_queue: str[]

lsp_watching = false
lsp_req = ""
lsp_req_uri = ""
lsp_stop = 0
lsp_seen = 0

lsp_send = (body: str):
    msg = "Content-Length: {len(body)}\r\n\r\n{body}"
    __write_fd(1, data(msg), len(msg))

# ---------------- positions ----------------
# LSP positions are lines and UTF-16 code units

struct LPos:
    line: int
    ch: int

# ---------------- documents and check results ----------------

struct Ref:
    file: int
    off: int
    len: int
    decl: str       # "file:offset" of the declaration ("" if none)
    info: str
    alias: str      # a name imported as another (from m import x as y): "file:offset" of y there
    kind: int       # what it names (IK_*; 0: see its declaration)

struct Decl:
    file: int
    off: int
    len: int
    kind: int
    name: str
    snippet: str
    doc: str

struct Diag:
    path: str
    off: int
    msg: str
    warning: bool
    info: bool = false   # (a hint: a `$runtime_checks` obligation that is checked at run time)
    cascade: bool = false   # (an error that only follows from a body left out: never shown)

struct Hint:
    file: int
    off: int
    label: str

# what a check found
struct Result:
    paths: str[]                # by file number
    refs: Ref[]
    decls: {str: Decl}
    hints: Hint[]
    diags: Diag[]
    comps: str[][]              # completions: label, kind, detail
    texts: {str: str}           # the text of the edited files when checked
    skips: str[]                # functions with errors (child positions), skipped in later rounds
    seen: {str: bool}           # refs and hints already taken (later rounds find them again)

struct Doc:
    uri: str
    path: str
    text: str
    version: int
    open: bool
    dirty: bool
    lowered: bool               # checked with lowering (which finds a few more errors)
    res: Result
    good: Result                # the last result with the most references (for broken code)
    has_good: bool
    wide: Result                # the latest result indexing all of the program's files
    has_wide: bool
    diag_uris: str[]            # files this document's errors were published to

docs: Doc[]
doc_by_uri: {str: int} = {}
root_lib = ""
# (a program for checking library files alone: it uses nothing, and is not on disk)
empty_main = "/.dewy-lsp-empty-main.jo"

# "file:offset"
split_pos = (s: str) -> (int, int):
    c = find_byte(s, ':')
    if c < 0: return (-1, -1)
    (to_int(s[..c)) ?? -1, to_int(s[c + 1..]) ?? -1)

struct RunOut:
    lines: str[]
    ok: bool

# check the program in a child process; its findings, as lines
run_child = (main_path: str, doc_path: str, sentinel: bool, skips: str[], lower: bool, wide: bool) -> RunOut:
    if lsp_should_stop(): return RunOut([], false)
    when TARGET == "windows":
        return run_child_w32(main_path, doc_path, sentinel, skips, lower, wide)
    else:
        fds = [0]
        if syscall(293, data(fds), 0x80000) != 0: return RunOut([], false)          # pipe2(O_CLOEXEC)
        rfd = fds[0] & 0xFFFFFFFF
        wfd = fds[0] >> 32
        pid = syscall(57)                                   # fork
        if pid < 0: return RunOut([], false)
        if pid == 0:
            syscall(3, rfd)
            check_child(main_path, doc_path, sentinel, skips, lower, wide, wfd)
        syscall(3, wfd)
        out: u8[]
        deadline = time() + 20.0
        killed = false
        loop true:
            pfd = [rfd | (1 << 32)]
            left = int((deadline - time()) * 1000.0)
            if lsp_should_stop() or left <= 0:
                syscall(62, pid, 9)                         # kill
                killed = true
                break
            pr = syscall(7, data(pfd), 1, min(left, 50))
            if pr < 0: continue
            if pr == 0: continue
            n = out.len()
            out.resize(n + 65536)
            r = syscall(0, rfd, data(out) + n, 65536)
            if r <= 0:
                out.resize(n)
                break
            out.resize(n + r)
        syscall(3, rfd)
        status = [0]
        syscall(61, pid, data(status), 0, 0)                # wait4
        if lsp_stop != 0: return RunOut([], false)
        if killed:
            lsp_log("checking {doc_path} took too long")
            return RunOut([], false)
        st = status[0] & 0xFFFF
        text = str_from_bytes(out)
        ok = st == 0
        if not ok:
            sig = st & 127
            lsp_log("the checker failed on {doc_path} (status {st}, signal {sig})")
        RunOut(split(text, "\n"), ok)

# (the child: check, write the findings to fd, and end)
check_child = (main_path: str, doc_path: str, sentinel: bool, skips: str[], lower: bool, wide: bool, fd: int):
    # Deterministic protocol tests can wait until the child is running before cancelling it.
    if let delay = env("DEWY_LSP_CHECK_DELAY_MS"):
        ms = to_int(delay) ?? 0
        if ms > 0:
            lsp_log("test checker started")
            sleep(f64(ms) / 1000.0)
    ide_on = true
    ide_fd = fd
    ide_doc = doc_path
    ide_wide = wide
    if sentinel: ide_sentinel = intern("__dewy_complete__")
    # (file numbers are the same in every check of the same texts)
    loop s in skips:
        fp = split_pos(s)
        ide_skip[mkpos(fp.0, fp.1)] = true
    test_mode = true
    if lower:
        # (lowering finds some errors too: in shader code, data races)
        lower_only = true
        compile(main_path, "")
    else:
        scan_build_block(main_path)
        setup_target()
        init_types()
        check_program(main_path)
    ide_finish()
    exit(0)

# Windows has no fork: the child is this program again (dewy lsp --child), told what to check,
# and the editor's texts, on its standard input; each string as "<length>:<bytes>"
run_child_w32 = (main_path: str, doc_path: str, sentinel: bool, skips: str[], lower: bool, wide: bool) -> RunOut:
    when TARGET == "windows":
        req: str[]
        put = (s: str):
            req.push("{len(s)}:")
            req.push(s)
        put(main_path)
        put(doc_path)
        put("{int(sentinel)}{int(lower)}{int(wide)}")
        put("{skips.len()}")
        loop s in skips: put(s)
        put("{ide_texts.len()}")
        loop p, t in ide_texts:
            put(p)
            put(t)
        msg = join(req, "")
        # pipes for the child's input and output; this side's ends are not inherited
        sa = fill(0, 3)
        sa[0] = 24
        sa[2] = 1                                       # bInheritHandle
        in_r: *u8[] = [null]
        in_w: *u8[] = [null]
        out_r: *u8[] = [null]
        out_w: *u8[] = [null]
        if CreatePipe(data(in_r), data(in_w), data(sa) as *u8, u32(1 << 16)) == 0: return RunOut([], false)
        if CreatePipe(data(out_r), data(out_w), data(sa) as *u8, u32(1 << 16)) == 0:
            CloseHandle(in_r[0])
            CloseHandle(in_w[0])
            return RunOut([], false)
        SetHandleInformation(in_w[0], 1, 0)
        SetHandleInformation(out_r[0], 1, 0)
        si = fill(0, 13)                                # STARTUPINFOW
        si[0] = 104
        (data(si) as *u32)[15] = u32(0x100)             # STARTF_USESTDHANDLES
        si[10] = in_r[0] as int
        si[11] = out_w[0] as int
        si[12] = GetStdHandle(u32(0xFFFFFFF4)) as int
        pi = fill(0, 3)
        exe = exe_path()
        wcmd = __wide("\"{exe}\" lsp --child")
        wexe = __wide(exe)
        started = CreateProcessW(data(wexe), data(wcmd), null, null, 1, u32(0x08000000), null, null, data(si) as *u8, data(pi) as *u8) != 0   # CREATE_NO_WINDOW
        CloseHandle(in_r[0])
        CloseHandle(out_w[0])
        if not started:
            CloseHandle(in_w[0])
            CloseHandle(out_r[0])
            lsp_log("could not start the checker ({exe})")
            return RunOut([], false)
        proc = pi[0] as *u8
        CloseHandle(pi[1] as *u8)
        w: u32[] = [0]
        off = 0
        loop off < len(msg):
            if WriteFile(in_w[0], data(msg) + off, u32(min(len(msg) - off, 1 << 20)), data(w), null) == 0: break
            off += int(w[0])
        CloseHandle(in_w[0])
        out: u8[]
        deadline = time() + 20.0
        killed = false
        avail: u32[] = [0]
        loop true:
            if lsp_should_stop() or time() > deadline:
                TerminateProcess(proc, 1)
                killed = true
                break
            # (fails once the child has ended and everything it wrote is read)
            if PeekNamedPipe(out_r[0], null, 0, null, data(avail), null) == 0: break
            if avail[0] == 0:
                WaitForSingleObject(proc, 5)
                continue
            n = out.len()
            out.resize(n + int(avail[0]))
            if ReadFile(out_r[0], data(out) + n, avail[0], data(w), null) == 0:
                out.resize(n)
                break
            out.resize(n + int(w[0]))
        CloseHandle(out_r[0])
        WaitForSingleObject(proc, u32(0xFFFFFFFF))
        code: u32[] = [0]
        GetExitCodeProcess(proc, data(code))
        CloseHandle(proc)
        if lsp_stop != 0: return RunOut([], false)
        if killed:
            lsp_log("checking {doc_path} took too long")
            return RunOut([], false)
        ok = code[0] == 0
        if not ok: lsp_log("the checker failed on {doc_path} (exit code {code[0]})")
        return RunOut(split(str_from_bytes(out), "\n"), ok)
    else:
        return RunOut([], false)

# dewy lsp --child: the check run_child_w32 asks for
child_main = ():
    buf: u8[]
    loop true:
        n = buf.len()
        buf.resize(n + 65536)
        r = __read_fd(0, data(buf) + n, 65536)
        if r <= 0:
            buf.resize(n)
            break
        buf.resize(n + r)
    # the strings, in order
    xs: str[]
    at = 0
    loop at < buf.len():
        c = at
        loop c < buf.len() and buf[c] != ':': c += 1
        k = to_int(str_from_bytes(buf[at..c))) ?? 0
        xs.push(str_from_bytes(buf[c + 1..min(c + 1 + k, buf.len()))))
        at = c + 1 + k
    loop xs.len() < 5: xs.push("")
    main_path = xs[0]
    doc_path = xs[1]
    flags = xs[2] + "000"
    ns = to_int(xs[3]) ?? 0
    skips = xs[4..4 + ns)
    at = 4 + ns
    nt = to_int(xs[at]) ?? 0
    loop i in [0..nt): ide_texts[xs[at + 1 + 2 * i]] = xs[at + 2 + 2 * i]
    check_child(main_path, doc_path, flags[0] == '1', skips, flags[1] == '1', flags[2] == '1', 1)

# parse a child's lines into r (files are renumbered into r.paths)
take_lines = (r: mut Result, lines_: str[]):
    fmap: int[]
    # (files first: an error comes before them)
    loop line in lines_:
        if not starts_with(line, "F\t"): continue
        f = esc_split(line)
        if f.len() >= 3:
            i = to_int(f[1]) ?? 0
            loop fmap.len() <= i: fmap.push(-1)
            p = path_norm(f[2])
            j = -1
            loop q in 0.. and pp in r.paths:
                if pp == p: j = q
            if j < 0:
                r.paths.push(p)
                j = r.paths.len() - 1
            fmap[i] = j
    loop line in lines_:
        if len(line) < 2: continue
        f = esc_split(line)
        k = f[0]
        if k == "R" and f.len() >= 5:
            p = remap(fmap, f[1])
            d = ""
            if len(f[3]) > 0: d = remap_key(fmap, f[3])
            key = "R{p.0}:{p.1}:{d}"
            if r.seen.get(key) != none: continue
            r.seen[key] = true
            al = ""
            if f.len() >= 6 and len(f[5]) > 0: al = remap_key(fmap, f[5])
            rk = 0
            if f.len() >= 7: rk = to_int(f[6]) ?? 0
            r.refs.push(Ref(p.0, p.1, to_int(f[2]) ?? 0, d, f[4], al, rk))
        else if k == "D" and f.len() >= 7:
            p = remap(fmap, f[1])
            key = "{p.0}:{p.1}"
            if r.decls.get(key) == none: r.decls[key] = Decl(p.0, p.1, to_int(f[2]) ?? 0, to_int(f[3]) ?? 0, f[4], f[5], f[6])
        else if k == "H" and f.len() >= 3:
            p = remap(fmap, f[1])
            key = "H{p.0}:{p.1}"
            if r.seen.get(key) != none: continue
            r.seen[key] = true
            r.hints.push(Hint(p.0, p.1, f[2]))
        else if k == "C" and f.len() >= 4:
            r.comps.push([f[1], f[2], f[3]])
        else if (k == "E" or k == "W" or k == "I") and f.len() >= 3:
            path = ""
            off = 0
            if f[1] != "-1":
                p = remap(fmap, f[1])
                if p.0 >= 0 and p.0 < r.paths.len(): path = r.paths[p.0]
                off = p.1
            cascade = k == "E" and f.len() >= 5 and f[4] == "cascade"
            r.diags.push(Diag(path, off, f[2], k != "E", k == "I", cascade))
            if k == "E" and f.len() >= 4 and f[3] != "-1": r.skips.push(f[3])

remap = (fmap: int[], s: str) -> (int, int):
    p = split_pos(s)
    f = -1
    if p.0 >= 0 and p.0 < fmap.len(): f = fmap[p.0]
    (f, p.1)

struct Item:
    a: int
    b: int
    name: str

# ---------------- requests ----------------

struct Hit:
    found: bool
    ref: Ref
    res: Result

struct Use:
    res: Result
    decl: str           # the declaration's key in res

no_items = "\{\"isIncomplete\":false,\"items\":[]\}"

# ---------------- semantic tokens (what each name is: the references a check found) ----------------

# token types and modifiers, by index (the legend in the capabilities)
sem_types = ["namespace", "type", "struct", "enum", "parameter", "variable", "property", "enumMember", "function", "method"]
sem_mods = ["declaration", "readonly", "defaultLibrary"]

struct SemTok:
    len: int
    type: int
    mods: int

# ---------------- document symbols (from the text: they work while it does not parse) ----------------

struct Sym2:
    name: str
    kind: int
    line: int
    col: int
    end: int        # last line
    kids: int[]

sy_text = ""
sy_lines: str[]
sy_ls: int[]
sy_ok: bool[]       # by line: it starts a statement (is not inside brackets or a string)
sy_dewy = false

# (workspace symbols: the same scan, flat)
struct WsSym:
    name: str
    kind: int
    line: int
    c0: int         # (UTF-16 columns of the name)
    c1: int
    container: str

sy_flat = false         # sym_json records into ws_found instead
sy_container = ""
ws_found: WsSym[]

# ---------------- workspace symbols: the same, in every .jo file under the workspace's folders ----------------

ws_roots: str[]         # the workspace's folders (from initialize)
ws_files: str[]
ws_scanned = false
ws_cache: {str: WsSym[]} = {}       # by path: a file's symbols, until files change

on_workspace_symbol = (id: int, params: int) -> int:
    q = jstr(jget(params, "query"))
    ws_ensure_scanned()
    out: str[][] = [[], [], []]      # (by how well they match)
    loop f in ws_files:
        syms: WsSym[]
        d = open_doc_at(f)
        if d >= 0: syms = ws_symbols_of(f, docs[d].text)
        else if let c = ws_cache.get(f): syms = c
        else:
            syms = ws_symbols_of(f, read_file(f) ?? "")
            ws_cache[f] = syms
        uri = uri_of(f)
        loop y in syms:
            m = ws_match(y.name, q)
            if y.kind == 24 or m == 3 or out[m].len() >= 1000: continue
            rg = "\{\"start\":\{\"line\":{y.line},\"character\":{y.c0}\},\"end\":\{\"line\":{y.line},\"character\":{y.c1}\}\}"
            e = "\{\"name\":{json_quote(y.name)},\"kind\":{y.kind},\"location\":\{\"uri\":{json_quote(uri)},\"range\":{rg}\}"
            if len(y.container) > 0: e += ",\"containerName\":{json_quote(y.container)}"
            out[m].push(e + "\}")
    all = out[0] + out[1] + out[2]
    lsp_reply(id, "[{join(all[..min(all.len(), 1000)), ",")}]")

# ---------------- code lenses: run a Dewy program or one of its tests ----------------

on_code_lens = (id: int, params: int) -> int:
    d = text_params_doc(params)
    if d < 0 or not ends_with(docs[d].path, ".dewy"): return lsp_reply(id, "[]")
    lenses: (int, str)[]
    u = json_quote(docs[d].uri)
    tests = 0
    # (a `$test` line: the function on the next line is a test, run by its name)
    text_lines = split(docs[d].text, "\n")
    loop i in 0.. and line in text_lines:
        t = trim(line)
        if not starts_with(t, "$test") or (len(t) > 5 and t[5] != '(' and t[5] != ' ' and t[5] != '\r'): continue
        j = i + 1
        loop j < text_lines.len() and (len(trim(text_lines[j])) == 0 or trim(text_lines[j])[0] == '#'): j += 1
        if j >= text_lines.len(): continue
        decl = trim(text_lines[j])
        word = ident_prefix(decl)
        if word == "let" or word == "const": decl = trim(decl[len(word)..])
        name = ident_prefix(decl)
        if len(name) == 0: continue
        if tests == 0: lenses.push((i, lens_json(i, "Run all tests", "dewy.core.test", u)))
        lenses.push((i, lens_json(i, "Run test", "dewy.core.runTest", "{u},{json_quote(name)}")))
        tests += 1
    loop y in ws_symbols_of(docs[d].path, docs[d].text):
        if y.kind == 12 and y.name == "main" and len(y.container) == 0:
            lenses.push((y.line, lens_json(y.line, "Run", "dewy.core.run", u)))
            lenses.push((y.line, lens_json(y.line, "Debug", "dewy.core.debug", u)))
    lenses.sort_by((l: (int, str)): l.0)
    out: str[]
    loop l in lenses: out.push(l.1)
    lsp_reply(id, "[{join(out, ",")}]")

# ---------------- quick fixes: edits that errors suggest ----------------

# the start of the nearest line above p whose text pred accepts (-1: none)
line_above = (text: str, p: int, pred: (str) -> bool) -> int:
    a = p
    loop a > 0 and text[a - 1] != '\n': a -= 1
    loop a > 0:
        b = a - 1
        a = b
        loop a > 0 and text[a - 1] != '\n': a -= 1
        if pred(text[a..b)): return a
    -1

# A Dewy element-update fix must use the declaration actually resolved by the
# checker, not a nearby loop mentioning the same name. Offer it only for the
# supported single-binder, stored-array form with a block body.
qf_dewy_space = (text: str, at: int) -> int:
    i = at
    loop i < len(text):
        if text[i] == ' ' or text[i] == '\t' or text[i] == '\r' or text[i] == '\n': i += 1
        else if text[i] == '#': i = ide_comment_end(text, i, true)
        else: break
    i

# The end of the name declaring the variable used at off, when its declaration has no type
# (`let x=1.5` or `x=1.5`): where `:float64` goes. -1 otherwise.
qf_dewy_untyped_decl = (d: int, off: int) -> int:
    text = docs[d].text
    e = off
    loop e < len(text) and is_ident_char(text[e]): e += 1
    if e == off: return -1
    name = text[off..e)
    h = ref_at(d, off)
    if not h.found or len(h.ref.decl) == 0: return -1
    dp = split_pos(h.ref.decl)
    if dp.0 < 0 or dp.0 >= h.res.paths.len() or h.res.paths[dp.0] != docs[d].path: return -1
    at = unmap_off(h.res, docs[d].path, dp.1)
    if at < 0 or not starts_with(text[at..], name) or (at + len(name) < len(text) and is_ident_char(text[at + len(name)])): return -1
    i = qf_dewy_space(text, at + len(name))
    if i >= len(text) or text[i] != '=' or (i + 1 < len(text) and text[i + 1] == '='): return -1
    at + len(name)

qf_dewy_element = (d: int, off: int, name: str) -> int:
    h = ref_at(d, off)
    if not h.found or len(h.ref.decl) == 0: return -1
    dp = split_pos(h.ref.decl)
    if dp.0 < 0 or dp.0 >= h.res.paths.len() or h.res.paths[dp.0] != docs[d].path: return -1
    at = unmap_off(h.res, docs[d].path, dp.1)
    text = docs[d].text
    if at < 0 or not starts_with(text[at..], name): return -1
    before = at
    loop before > 0 and (text[before - 1] == ' ' or text[before - 1] == '\t' or text[before - 1] == '\n' or text[before - 1] == '\r'): before -= 1
    if before < 4 or text[before - 4..before) != "loop": return -1
    if before > 4 and is_ident_char(text[before - 5]): return -1
    i = qf_dewy_space(text, at + len(name))
    if not starts_with(text[i..], "in") or (i + 2 < len(text) and is_ident_char(text[i + 2])): return -1
    i = qf_dewy_space(text, i + 2)
    root = i
    last = i
    loop true:
        if i >= len(text) or not is_ident_start(text[i]): return -1
        last = i
        loop i < len(text) and is_ident_char(text[i]): i += 1
        i = qf_dewy_space(text, i)
        if i >= len(text) or text[i] != '.': break
        i = qf_dewy_space(text, i + 1)
    if i >= len(text) or text[i] != '{{': return -1
    source = ref_at(d, last)
    if not source.found or not starts_with(source.ref.info, "array<"): return -1
    base = ref_at(d, root)
    if not base.found: return -1
    if let declaration = base.res.decls.get(base.ref.decl):
        if declaration.kind == IK_CONST: return -1
    at

# A fix a Dewy message spells out in backquotes: "write `@f` for the function itself" (an @ before
# the name at p), "write `s.startswith(...)`" or "removes by position with pop: `xs.pop(i)`" (the
# member after `s.` on p's line). [title, start, end, text], or [] when the text does not fit.
dewy_fixit = (d: int, p: int, msg: str) -> str[]:
    if not ends_with(docs[d].path, ".dewy"): return []
    text = docs[d].text
    k = find(msg, "`")
    loop k >= 0:
        e = find(msg, "`", k + 1)
        if e < 0: break
        want = msg[k + 1..e)
        k = find(msg, "`", e + 1)
        if starts_with(want, "@") and len(want) > 1 and is_ident_start(want[1]):
            nm = ident_prefix(want[1..])
            if p < len(text) and starts_with(text[p..], nm) and (p == 0 or text[p - 1] != '@') and name_end(text, p) == p + len(nm):
                return ["Write `@{nm}` for the function itself", "{p}", "{p}", "@"]
            continue
        # recv.member(...)
        dot = find_byte(want, '.')
        open = find_byte(want, '(')
        if dot <= 0 or open <= dot: continue
        recv = want[..dot)
        member = want[dot + 1..open)
        if not is_word(member) or len(member) == 0: continue
        at = word_near(text, p, recv)
        loop at >= 0:
            m0 = at + len(recv)
            if m0 < len(text) and text[m0] == '.':
                m1 = name_end(text, m0 + 1)
                old = text[m0 + 1..m1)
                if len(old) > 0 and old != member: return ["Change '{old}' to '{member}'", "{m0 + 1}", "{m1}", member]
            # (the next use of recv on the line)
            nx = find(text, recv, at + 1)
            le = find(text, "\n", at)
            if nx < 0 or le >= 0 and nx > le: break
            at = nx
    []

on_code_action = (id: int, params: int) -> int:
    d = text_params_doc(params)
    if d < 0: return lsp_reply(id, "[]")
    text = docs[d].text
    ls = line_starts_of(text)
    out: str[]
    loop dg in jitems(jget(jget(params, "context"), "diagnostics")):
        msg = jstr(jget(dg, "message"))
        st = jget(jget(dg, "range"), "start")
        p = off_of(text, ls, jint(jget(st, "line")), jint(jget(st, "character")))
        k = find(msg, "(did you mean '")
        if k >= 0:
            # a name misspelled: the one the message names first
            want = quoted(msg, k)
            bad = quoted(msg, 0)
            at = word_near(text, p, bad)
            if len(want) > 0 and len(bad) > 0 and at >= 0: out.push(qf_json(d, "Change '{bad}' to '{want}'", dg, at, at + len(bad), want))
            continue
        k = find(msg, "(use `")
        if k >= 0:
            # a name from another language: True, append, float
            e = find(msg, "`)", k + 6)
            want = ""
            if e > 0: want = msg[k + 6..e)
            bad = quoted(msg, 0)
            at = word_near(text, p, bad)
            if len(want) > 0 and is_word(want) and len(bad) > 0 and at >= 0:
                out.push(qf_json(d, "Change '{bad}' to '{want}'", dg, at, at + len(bad), want))
                continue
        # operators and keywords from other languages, at the diagnostic's place
        swap = ["use `and`", "&&", "and", "use `or`", "||", "or", "use `else if`", "elif", "else if", "`x ^ y` is x to the power y", "**", "^"]
        si = 0
        loop si < swap.len():
            if starts_with(msg, swap[si]) and starts_with(text[p..], swap[si + 1]): out.push(qf_json(d, "Change '{swap[si + 1]}' to '{swap[si + 2]}'", dg, p, p + len(swap[si + 1]), swap[si + 2]))
            si += 3
        if starts_with(msg, "use `not`") and starts_with(text[p..], "!"): out.push(qf_json(d, "Change '!' to 'not'", dg, p, p + 1, "not "))
        # (`[1 2; 3 4]`: the attached `;` after the value at p meant as a row break)
        if starts_with(msg, "this `;` is attached to the value before it"):
            semi = find(text, ";", p)
            le = find(text, "\n", p)
            if semi > 0 and (le < 0 or semi < le) and text[semi - 1] != ' ':
                out.push(qf_json(d, "Make it a row break: ` ;`", dg, semi, semi, " "))
                continue
        # the spelling a message gives: `@f` for a function itself, `xs.pop(i)` for a member
        fx = dewy_fixit(d, p, msg)
        if len(fx) > 0:
            out.push(qf_json(d, fx[0], dg, to_int(fx[1]) ?? 0, to_int(fx[2]) ?? 0, fx[3]))
            continue
        # (a path not proven to stay inside its base: validate it where it is used)
        k = find(msg, "validate it, `")
        if k >= 0 and (find(msg, "is not proven to stay inside its base") >= 0 or find(msg, "may escape its base") >= 0):
            e = find(msg, " or_throw`", k)
            ci = find(msg, ".confine(", k)
            if e > 0 and ci > 0 and ci < e:
                arg = msg[ci + 9..e - 1)
                fix = msg[k + 14..e + 9)
                if len(arg) > 0 and arg != "..." and starts_with(text[p..], arg):
                    after = p + len(arg)
                    # (a method's receiver: `(root.confine(f) or_throw).read_text`)
                    if after < len(text) and text[after] == '.': fix = "({fix})"
                    out.push(qf_json(d, "Validate it: `{fix}`", dg, p, after, fix))
            continue
        if starts_with(msg, "this exact value grows each iteration") or find(msg, "annotate `float64` (or another explicit representation) to state it") >= 0:
            if ends_with(docs[d].path, ".dewy"):
                ensure_checked(d)
                at = qf_dewy_untyped_decl(d, p)
                if at >= 0: out.push(qf_json(d, "Annotate it `float64`", dg, at, at, ":float64"))
            continue
        if contains(msg, "' is changed here but never read afterwards:") and contains(msg, "`loop @"):
            nm = quoted(msg, 0)
            ensure_checked(d)
            at = qf_dewy_element(d, p, nm)
            if at >= 0: out.push(qf_json(d, "Update stored elements with `@{nm}`", dg, at, at, "@"))
            continue
        if starts_with(msg, "cannot modify loop variable '"):
            nm = quoted(msg, 0)
            if ends_with(docs[d].path, ".dewy"):
                if contains(msg, "`loop @item`"):
                    ensure_checked(d)
                    at = qf_dewy_element(d, p, nm)
                    if at >= 0: out.push(qf_json(d, "Update stored elements with `@{nm}`", dg, at, at, "@"))
                continue
            hd = line_above(text, p, (l: str) -> bool: starts_with(trim(l), "loop ") and not starts_with(trim(l), "loop mut ") and find(l, " {nm} ") >= 0)
            if hd >= 0:
                lp = find(text, "loop ", hd)
                out.push(qf_json(d, "Make it `loop mut`", dg, lp + 5, lp + 5, "mut "))
            continue
        if starts_with(msg, "cannot modify parameter '"):
            nm = quoted(msg, 0)
            hd = line_above(text, p, (l: str) -> bool: find(l, "({nm}:") >= 0 or find(l, ", {nm}:") >= 0)
            if hd >= 0:
                e = find(text, "\n", hd)
                if e < 0: e = len(text)
                c = find(text, "({nm}:", hd)
                if c < 0 or c > e: c = find(text, ", {nm}:", hd) + 1
                c = c + 1 + len(nm) + 1
                loop c < e and text[c] == ' ': c += 1
                if c < e and not starts_with(text[c..e), "mut "): out.push(qf_json(d, "Mark '{nm}' `mut` (changes reach the caller)", dg, c, c, "mut "))
            continue
        ex = find(msg, "expected ")
        el = 9
        if ex < 0:
            ex = find(msg, " expects ")
            el = 9
        fd = find(msg, ", found ")
        if ex >= 0 and fd > ex:
            # a number of another type: a conversion (or 2.0 -> 2), where the value is one word
            to = msg[ex + el..fd)
            fr = msg[fd + 8..]
            sp = find(fr, " ")
            if sp >= 0: fr = fr[..sp)
            nums = ["int", "i64", "i32", "i16", "i8", "u64", "u32", "u16", "u8", "f64", "f32"]
            if not nums.contains(to) or not nums.contains(fr): continue
            e = p
            loop e < len(text) and (is_ident_char(text[e]) or text[e] == '.'): e += 1
            if e == p: continue
            q = e
            loop q < len(text) and text[q] == ' ': q += 1
            if q < len(text) and find(",)]:\n#", text[q..q + 1)) < 0: continue
            w = text[p..e)
            if to[0] != 'f' and is_digit(w[0]) and ends_with(w, ".0") and to_int(w[..len(w) - 2)) != none: out.push(qf_json(d, "Write it as {w[..len(w) - 2)}", dg, p, e, w[..len(w) - 2)))
            else: out.push(qf_json(d, "Convert it: {to}({w})", dg, p, e, "{to}({w})"))
    lsp_reply(id, "[{join(out, ",")}]")

# ---------------- the main loop ----------------

capabilities = "\{\"textDocumentSync\":\{\"openClose\":true,\"change\":1,\"save\":\{\"includeText\":false\}\},\"hoverProvider\":true,\"definitionProvider\":true,\"referencesProvider\":true,\"documentHighlightProvider\":true,\"documentSymbolProvider\":true,\"workspaceSymbolProvider\":true,\"documentFormattingProvider\":true,\"codeActionProvider\":\{\"codeActionKinds\":[\"quickfix\"]\},\"renameProvider\":\{\"prepareProvider\":true\},\"completionProvider\":\{\"triggerCharacters\":[\".\",\"$\",\"/\",\"\\\"\"]\},\"signatureHelpProvider\":\{\"triggerCharacters\":[\"(\",\",\"],\"retriggerCharacters\":[\",\"]\},\"inlayHintProvider\":true,\"codeLensProvider\":\{\"resolveProvider\":false\},\"semanticTokensProvider\":\{\"legend\":\{\"tokenTypes\":{sem_legend(sem_types)},\"tokenModifiers\":{sem_legend(sem_mods)}\},\"full\":true\}\}"

lsp_main = ():
    root_lib = path_norm(lib_dir)
    ide_texts[empty_main] = ""
    a = args()
    if a.len() >= 3 and a[2] == "--child":
        child_main()
        return
    if a.len() >= 4 and a[2] == "--dump":
        # (debugging: what a check of a file reports)
        path = path_norm(os_path(a[3]))
        if not is_abs_path(path): path = path_norm(os_path(cwd()) + "/" + path)
        main_path = path
        if starts_with(path, root_lib + "/"): main_path = empty_main
        sk: str[]
        if let s = env("DEWY_SKIP"): sk.push(s)
        o = run_child(main_path, path, env("DEWY_SENTINEL") != none, sk, env("DEWY_LOWER") != none, env("DEWY_WIDE") != none)
        loop l in o.lines: print(l)
        exit(0)
    shutdown = false
    loop true:
        # check edited documents once the editor has said everything it had to say
        if not lsp_pending():
            loop i in [0..docs.len()):
                if docs[i].open and docs[i].dirty:
                    lsp_watch("", docs[i].uri)
                    refresh(i)
                    if lsp_pending(): break
        # and lower them when it has been quiet for a moment
        loop i in [0..docs.len()):
            if docs[i].open and not docs[i].dirty and not docs[i].lowered:
                if lsp_queue.len() > 0 or lsp_wait_input(300): break
                lsp_watch("", docs[i].uri)
                refresh_lowered(i)
        m = lsp_next()
        if m == none: exit(0)
        root = json_parse(jdoc, m!)
        method = jstr(jget(root, "method"))
        id = jget(root, "id")
        params = jget(root, "params")
        key = ""
        if id != 0: key = jraw(id)
        lsp_watch(key, jstr(jpath(params, "textDocument", "uri")))
        if method == "initialize":
            ws_init(params)
            lsp_reply(id, "\{\"capabilities\":{capabilities},\"serverInfo\":\{\"name\":\"dewy-core\"\}\}")
        else if method == "initialized": pass
        else if method == "shutdown":
            shutdown = true
            lsp_reply(id, "null")
        else if method == "exit":
            if shutdown: exit(0)
            exit(1)
        else if method == "textDocument/didOpen": on_open(params)
        else if method == "textDocument/didChange": on_change(params)
        else if method == "textDocument/didClose": on_close(params)
        else if method == "workspace/symbol": on_workspace_symbol(id, params)
        else if method == "textDocument/formatting": on_formatting(id, params)
        else if method == "textDocument/codeAction": on_code_action(id, params)
        else if method == "workspace/didChangeWorkspaceFolders":
            ev = jget(params, "event")
            loop f in jitems(jget(ev, "removed")):
                k = ws_roots.index_of(uri_to_path(jstr(jget(f, "uri"))))
                if k >= 0: ws_roots.remove(k)
            loop f in jitems(jget(ev, "added")): ws_roots.push(uri_to_path(jstr(jget(f, "uri"))))
            ws_scanned = false
        else if method == "textDocument/didSave" or method == "workspace/didChangeWatchedFiles":
            ws_cache = {}
            if method == "workspace/didChangeWatchedFiles": ws_scanned = false
            # other open files may use this one (or files changed on disk)
            loop i in [0..docs.len()):
                if docs[i].open: docs[i].dirty = true
                docs[i].has_wide = false
        else if method == "textDocument/hover": on_hover(id, params)
        else if method == "textDocument/definition": on_definition(id, params)
        else if method == "textDocument/references": on_references(id, params)
        else if method == "textDocument/documentHighlight": on_highlight(id, params)
        else if method == "textDocument/prepareRename": on_prepare_rename(id, params)
        else if method == "textDocument/rename": on_rename(id, params)
        else if method == "textDocument/completion": on_completion(id, params)
        else if method == "textDocument/signatureHelp": on_signature(id, params)
        else if method == "textDocument/inlayHint": on_inlay(id, params)
        else if method == "textDocument/semanticTokens/full": on_semantic(id, params)
        else if method == "textDocument/documentSymbol": on_symbols(id, params)
        else if method == "textDocument/codeLens": on_code_lens(id, params)
        else if id != 0: lsp_error(id, -32601, "unsupported: {method}")

variant_hint_for = (t: int, name: str) -> str:
    tn = dt(prune(t))
    # (Unity's Input.GetKey and the like: functions here)
    if tn == "Input" and starts_with(name, "Get"):
        if name == "GetKey": return " (a key held is `key_down(.w)`)"
        if name == "GetKeyDown": return " (a key pressed this frame is `key_pressed(.space)`)"
        if name == "GetKeyUp": return " (a key let go this frame is `key_released(.space)`)"
        if name == "GetAxis" or name == "GetAxisRaw": return " (the arrows', WASD's and a stick's direction is `input_axis()`, a vec2)"
        if name == "GetMouseButton": return " (a mouse button held is `mouse_down(.left)`)"
        if name == "GetMouseButtonDown": return " (a mouse button pressed this frame is `mouse_pressed(.left)`)"
        return " (input is asked for with functions: `key_down(.w)`, `key_pressed(.space)`, `input_axis()`, `mouse_pos()`)"
    if tn == "Key":
        w = name
        # (num1, digit1, key_1: n1)
        loop pre in ["num", "digit", "key_", "kp"]:
            if starts_with(w, pre) and len(w) == len(pre) + 1 and is_digit(w[len(pre)]): return " (it is `.n{w[len(pre)..]}`)"
        i = 0
        loop i < KEY_NAMES.len():
            if KEY_NAMES[i] == w: return " (it is `.{KEY_NAMES[i + 1]}`)"
            i += 2
        sg = suggestion(name, variant_names(t))
        if len(sg) > 0: return sg
        return " (keys are named a to z, n0 to n9, f1 to f12, space, enter, escape, tab, backspace, left, right, up, down, shift, ctrl, alt...)"
    suggestion(name, variant_names(t))
# (`title` for `.title`: a variant of an enum, written without its dot; the program's enums first)
bare_variant_hint = (nm: int) -> str:
    prelude_demand_all()
    found = ""
    loop m in modules:
        loop d in m.decls:
            if nodes[d].kind != .enum_: continue
            loop i in [0..nkids(d)):
                v = kid(d, i)
                if nodes[v].kind == .variant and int(nodes[v].name) == nm:
                    en = name_of(int(nodes[d].name))
                    h = " (a variant of {en}: `.{name_of(nm)}` where a {en} is expected, else `{en}.{name_of(nm)}`)"
                    if not m.is_prelude: return h
                    if len(found) == 0: found = h
    found
variant_names = (t: int) -> int[]:
    out: int[]
    si = int(types[prune(t)].st)
    check_struct_fields(si)
    loop vi in [0..int(structs[si].nvariants)): out.push(int(variants[int(structs[si].variants) + vi].name))
    out
# a union, or an optional union
union_or_optional = (t0: int) -> bool:
    t = prune(t0)
    is_union(t) or tkind(t) == .opt and is_union(prune(int(types[t].elem)))
# a == b, a < b with types that do not compare
# An arithmetic or comparison operand that is a union: the member to narrow to, as it
# is spelled, and when the other members are all failures (`to_int(s)`), the fallback.
union_operand_why = (n: int, u: int) -> str:
    if not dewy_at(nodes[n].pos): return " (find out which it holds first: `if x is int: ...` or a `match`)"
    member = 0
    others = 0
    loop m in value_members(prune(u)):
        if exception_member(m):
            if time_core_type(m, "Gap") or time_zone_failure(m): return time_policy_why()
            continue
        if member == 0 and is_numeric(m): member = m
        else: others += 1
    if member != 0 and others == 0: return " (it may hold a failure instead of the {dt(member)}: fall back with `x ?? 0`, pass the failure on with `or_throw`, or test it first, `if x is? {dt(member)} \{ ... }`)"
    shown = if member != 0: dt(member) else: "int64"
    " (find out which it holds first: `if x is? {shown} \{ ... }` or a `match`)"

cmp_error = (n: int, ta: int, tb: int):
    why = variant_hint(int(nodes[n].b), ta)
    a = int(nodes[n].a)
    if tkind(ta) == .bool_ and is_numeric(tb) and nodes[a].kind == .binary:
        aop = nodes[a].op as Tok
        if aop == .lt or aop == .le or aop == .gt or aop == .ge: why = if dewy_at(nodes[n].pos): " (a parenthesized comparison is a bool; the chain `a <? x <? b` goes without parentheses)" else: " (`a < x < b` is written `a < x and x < b`, or `x in a..b`)"
    # (the member compared with: the same type, or a number for a number)
    member = 0
    if is_union(prune(ta)):
        if union_index(prune(ta), prune(tb)) >= 0: member = prune(tb)
        else if is_numeric(tb):
            loop m in union_members(ta):
                if member == 0 and is_numeric(m): member = m
    if len(why) == 0 and member != 0:
        why = if dewy_at(nodes[n].pos): " (find out which it holds first: `x is? {dt(member)} and x =? value`)" else: " (find out which it holds first: `x is {dt(member)} and x == value`)"
    if len(why) == 0 and tkind(ta) == .opt and type_eq(prune(int(types[prune(ta)].elem)), prune(tb)):
        # (env("X") != "": the optional may be none)
        why = if dewy_at(nodes[n].pos): " (it may be none: `(x ?? default) =? value` compares its value, or a default when there is none; `if x isnt? none \{ }` narrows it)" else: " (it may be none: `(x ?? default) == value` compares its value, or a default when there is none; `if let v = x:` names the value)"
    if len(why) == 0 and ((type_eq(prune(ta), T_U8) and tkind(tb) == .str_) or (tkind(ta) == .str_ and type_eq(prune(tb), T_U8))):
        why = " (`s[i]` is a character's code, a number: the character as text is `s[i..i]`)"
    if len(why) == 0 and ((tkind(ta) == .str_ and is_numeric(tb)) or (is_numeric(ta) and tkind(tb) == .str_)):
        why = " (text is not a number, even with digits in it: `to_int(s) ?? 0` or `to_float(s) ?? 0.0` reads one, and `input_int(...)` asks for one)"
    # (n == 1 with n an enum: C's and JavaScript's numbered names)
    if len(why) == 0 and tkind(ta) == .enum_ and not is_union(ta) and is_int(tb): why = if dewy_at(nodes[n].pos): " (`x =? .name` asks which it is)" else: " (`x == .name` asks which it is; `int(x)` is its number, counting from 0)"
    fatal(nodes[n].pos, "cannot compare {dt(ta)} with {dt(tb)}{why}")
# the operator a library function implements, for diagnostics ("" when it is no operator)
dewy_operator_fn_text = (name: str) -> str:
    if name == "__floor_mod" or name == "__floor_mod_pow2": return "%"
    if name == "__floor_div" or name == "__floor_div_pow2": return "//"
    if name == "__dewy_power": return "^"
    if name == "__dewy_divide": return "/"
    ""
# (an exact fraction where a float is wanted, or the other way, through arrays and
# n-dimensional ones: decimal literals such as 0.0 are fractions unless a floating type is
# written)
rational_float_mismatch = (from0: int, to0: int) -> bool:
    f = prune(from0)
    t = prune(to0)
    loop tkind(f) == .array and tkind(t) == .array or is_nd(f) and is_nd(t):
        if is_nd(f):
            f = prune(nd_elem(f))
            t = prune(nd_elem(t))
        else:
            f = prune(int(types[f].elem))
            t = prune(int(types[t].elem))
    (bundled_rational_type(f) and tkind(t) == .float_) or (tkind(f) == .float_ and bundled_rational_type(t))
# (an array of `int` where one of a fixed-width integer is wanted, through nested and
# n-dimensional arrays: integer literals are `int` unless a type is written where they are made)
int_literal_elem_mismatch = (from0: int, to0: int) -> bool:
    f = prune(from0)
    t = prune(to0)
    if not (tkind(f) == .array and tkind(t) == .array or is_nd(f) and is_nd(t)): return false
    loop tkind(f) == .array and tkind(t) == .array or is_nd(f) and is_nd(t):
        if is_nd(f):
            f = prune(nd_elem(f))
            t = prune(nd_elem(t))
        else:
            f = prune(int(types[f].elem))
            t = prune(int(types[t].elem))
    f == T_MATH_INT and tkind(t) == .int_ and t != T_MATH_INT
# the declaration of local l in the subtree at n, or 0 (error path only)
local_decl_in = (n: int, l: int) -> int:
    if n == 0: return 0
    if nodes[n].kind == .vardecl and nodes[n].sym == i32(l) and not has_flag(n, NF_GLOBAL): return n
    loop c in [int(nodes[n].a), int(nodes[n].b), kid_c(n), kid_d(n)]:
        d = local_decl_in(c, l)
        if d != 0: return d
    loop c in kids(n) + kids2(n):
        d = local_decl_in(c, l)
        if d != 0: return d
    0
# (`let b = [3 4 5]` then `pick() ?? b` wanting array<int64>: b's type is written where it is made)
int_literal_elem_hint = (a: int, t: int) -> str:
    if nodes[a].kind != .ident: return ""
    d = 0
    if nodes[a].aux == i32(int(SK.global)): d = int(globals[int(nodes[a].sym)].decl)
    else if nodes[a].aux == i32(int(SK.local)):
        l = int(nodes[a].sym)
        # (a parameter's type is written in the signature; a loop variable's is its source's)
        if int(locals[l].flags) & (LF_PARAM | LF_VALUEPARAM) != 0 or int(locals[l].flags) & LF_DECL == 0: return ""
        d = local_decl_in(int(fns[int(locals[l].owner)].body), l)
    if d == 0 or nodes[d].kind != .vardecl or nodes[d].a != 0 or nodes[d].nlist != 0: return ""
    v = int(nodes[d].b)
    loop v != 0 and nodes[v].kind == .conv: v = int(nodes[v].a)
    if v == 0 or nodes[v].kind != .array: return ""
    kw = if has_flag(d, NF_RDONLY): "const" else: "let"
    nm = name_of(int(nodes[a].name))
    " (integer literals are `int` unless a type is written where they are made, and an array keeps its element type: write it where '{nm}' is made, as `{kw} {nm}:{dt_named(t)} = [...]`)"
variant_hint = (a: int, t0: int) -> str:
    t = prune(t0)
    if nodes[a].type != 0:
        # (a color is a vec4; light and sky colors are vec3s)
        ft = prune(int(nodes[a].type))
        if types[ft].kind == .secret and types[t].kind != .secret: return secret_hint(a)
        if dewy_at(nodes[a].pos) and rational_float_mismatch(ft, t): return " (a decimal literal such as `0.5` is an exact rational: write the floating type where the value is made, as `let x:float64 = 0.5` or `let xs:array<float64> = [1.5 2.5]`)"
        if dewy_at(nodes[a].pos) and int_literal_elem_mismatch(ft, t):
            h = int_literal_elem_hint(a, t)
            if len(h) > 0: return h
        c = "c"
        if nodes[a].kind == .ident: c = name_of(int(nodes[a].name))
        if type_eq(ft, T_VEC4) and type_eq(t, T_VEC3): return " (`{c}.rgb` is a color without its alpha)"
        if type_eq(t, T_VEC2) and (nodes[a].kind == .int_lit or nodes[a].kind == .float_lit): return " (a position or size is one vec2: `vec2(x, y)`)"
        # (load_texture("hero.png"): a file's bytes, not its name)
        if types[t].kind == .array and prune(int(types[t].elem)) == T_U8 and types[ft].kind == .str_:
            if nodes[a].kind == .str_lit and nodes[a].aux == 0:
                f = name_of(int(nodes[a].sval))
                return " (a file's bytes: `embed(\"{f}\")` builds the file into the program, `read_bytes(\"{f}\")!` reads it when the program runs; the `!` stops the program if the file is not there)"
            return " (`bytes(s)` is a string's bytes; `embed(\"file\")` a file's)"
        # (chime = sfx_chime, then play(chime): the function kept, not what it makes)
        if types[ft].kind == .fn_ and int(types[ft].nargs) == 0 and type_eq(prune(int(types[ft].elem)), t) and nodes[a].kind == .ident:
            vn = name_of(int(nodes[a].name))
            return " ('{vn}' holds a function that makes {a_type(t)}, not {a_type(t)}: where it is given its value, call the function, `{vn} = ...()`)"
        # (circle(p, 8, (1, 0.9, 0.5)): a tuple of numbers for a color or a position)
        if types[ft].kind == .tuple and is_vec(t):
            if type_eq(t, T_VEC4) or type_eq(t, T_VEC3): return " (a color is `rgb(1, 0.9, 0.5)`, a position `vec3(x, y, z)`)"
            return " (a position or size is `vec2(x, y)`)"
        # (circle(p, 8, "yellow"): a color is made of numbers)
        if type_eq(t, T_VEC4) and types[ft].kind == .str_:
            if nodes[a].kind == .str_lit and nodes[a].aux == 0:
                cn = upper(name_of(int(nodes[a].sval)))
                if cn == "GREY": cn = "GRAY"
                loop known in ["WHITE", "BLACK", "RED", "GREEN", "BLUE", "YELLOW", "ORANGE", "PURPLE", "CYAN", "MAGENTA", "GRAY"]:
                    if cn == known: return " (a color is made of numbers: `{cn}`, or `rgb(r, g, b)` with each from 0 to 1)"
                if len(cn) > 0 and cn[0] == '#': return " (a color is made of numbers: `hex(\"{name_of(int(nodes[a].sval))}\")`, or `rgb(r, g, b)` with each from 0 to 1)"
            return " (a color is made of numbers: `rgb(r, g, b)` with each from 0 to 1, or a named one such as `YELLOW`)"
        # (sprite(img, ...) with an Image: drawing takes it on the GPU)
        if dt(t) == "Texture" and dt(ft) == "Image": return " (a Texture is an image on the GPU: `texture(img)` makes one, once, at the top level; `load_texture(embed(\"hero.png\"))` loads one from a file)"
        if types[ft].kind == .typeval and types[t].kind == .fn_ and nodes[a].kind == .ident:
            c2 = name_of(int(nodes[a].name))
            return " (`{c2}` is a type; for a function that converts each one, write `(x): {c2}(x)`)"
        if type_eq(ft, T_VEC3) and type_eq(t, T_VEC4): return " (`vec4({c}, 1)` is a vec3 color with its alpha)"
    if types[t].kind != .enum_ or nodes[a].kind != .str_lit or nodes[a].nlist > 0: return ""
    w = name_of(int(nodes[a].sval))
    si = int(types[t].st)
    check_struct_fields(si)
    loop vi in [0..int(structs[si].nvariants)):
        vn = name_of(int(variants[int(structs[si].variants) + vi].name))
        if vn == w or vn == lower(w): return " (write `.{vn}`)"
    ""
# a call of a function that calls itself, taken to give nothing (it has no `return value`):
# what to write instead
# best > 3.0 with best: f64?: said with where best was made, where a default goes
opt_cmp_error = (n: int, a: int, b: int, ta: int, tb: int):
    x = a
    tx = ta
    if tkind(ta) != .opt:
        x = b
        tx = tb
    if tkind(tx) == .opt and nodes[x].kind == .ident:
        nm = name_of(int(nodes[x].name))
        et = prune(int(types[prune(tx)].elem))
        dv = "default"
        if tkind(et) == .str_: dv = "\"\""
        else if tkind(et) == .int_: dv = "0"
        else if tkind(et) == .float_: dv = "0.0"
        at = 0
        s = lookup(int(nodes[x].name))
        if s != 0 and syms[s].kind == .local: at = locals[int(syms[s].ref)].pos
        if s != 0 and syms[s].kind == .global: at = nodes[int(globals[int(syms[s].ref)].decl)].pos
        where = ""
        if at > 0:
            ln, c = line_col(at)
            where = " where line {ln} makes it"
        fatal(nodes[n].pos, "'{nm}' may be none (it is {a_type(tx)}), so it cannot be compared with {jd(nodes[n].pos, "<, >", "<?, >?")}: say what to use then{where} (`... ?? {dv}`), or {jd(nodes[n].pos, "`if let v = {nm}: ...`", "`if {nm} isnt? none \{ ... }`")}")
    fatal(nodes[n].pos, "optionals can only be compared with {op_text(.eq, nodes[n].pos)} and {op_text(.ne, nodes[n].pos)}")
# (play(sfx_chime), input_axis * 400: a function's name where its result was meant)
uncalled_hint = (n: int, want: int) -> str:
    if want != 0 and (tkind(want) == .fn_ or tkind(want) == .cfn): return ""
    nm = ""
    d = 0
    if nodes[n].kind == .fnref and nodes[n].sym > 0 and int(nodes[n].sym) < fns.len() and fns[int(nodes[n].sym)].decl != 0:
        d = int(fns[int(nodes[n].sym)].decl)
        nm = name_of(int(nodes[d].name))
    else if nodes[n].kind == .ident:
        s = lookup(int(nodes[n].name))
        if s != 0 and syms[s].kind == .fns:
            nm = name_of(int(nodes[n].name))
            d = int(syms[s].decl)
    if len(nm) == 0 or starts_with(nm, "__"): return ""
    # (key_down(right): the key, Key.right, written without its dot)
    if want != 0 and tkind(want) == .enum_:
        loop v in variant_names(want):
            if name_of(v) == nm: return " (a {dt(want)} is written with a dot: `.{nm}`)"
    args = ""
    if d != 0 and nkids(d) > 0: args = "..."
    " ('{nm}' is a function and is not called here: `{nm}({args})` calls it)"
void_rec_hint = (n: int) -> str:
    if nodes[n].kind != .call or nodes[n].sym <= 0: return ""
    f = int(nodes[n].sym)
    if f >= fns.len() or not fns[f].aux_void or fns[f].decl == 0: return ""
    nm = name_of(int(nodes[int(fns[f].decl)].name))
    " ('{nm}' calls itself, directly or through another function, with no branch that gives its result's type: write it, {jd(nodes[n].pos, "`{nm} = (...) -> int: ...`", "`{nm} = (...):>int64 => ...`")})"

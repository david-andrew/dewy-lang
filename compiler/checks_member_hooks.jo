# The receiver prelude of `x.f` runs in checker_receivers.dewy; these are its services.
field_juxt = (n: int):
    juxt_member_check(n)
    return
field_reflect_name = (n: int):
    reflect_name(n)
    return
# (c.__peer in a program: a library's own field, which may change or go in any version)
field_private = (n: int) -> int:
    a0 = int(nodes[n].a)
    if pos_in_lib(nodes[n].pos): return a0
    lt = prune(check_expr(a0, 0))
    nodes[n].a = i32(last_checked)
    a0 = last_checked
    add_flag(a0, NF_CHECKED)
    if types[lt].kind == .struct_:
        sd = int(structs[int(types[lt].st)].decl)
        if (concurrency_builtin_type(lt, "Atomic") or concurrency_builtin_type(lt, "Task") or concurrency_builtin_type(lt, "TaskGroup") or concurrency_builtin_type(lt, "__Lock") or concurrency_builtin_type(lt, "__Chan") or concurrency_builtin_type(lt, "__Mpmc") or concurrency_builtin_type(lt, "__Spsc")) and dewy_at(nodes[n].pos): fatal(nodes[n].pos, "shared concurrency storage is private; use its checked operations")
        if sd != 0 and pos_in_lib(nodes[sd].pos): warn(nodes[n].pos, "{name_of(int(nodes[n].name))} is {structs[int(types[lt].st)].name}'s own, inside the library: it may change or go in any version (if something here is missing, it is worth asking for)")
    a0
field_soa_alias = (n: int, a0: int, expected: int) -> int:
    sl = soa_alias_of(a0)
    if sl == 0: return -1
    nodes[n] = nodes[soa_alias_field(n, sl)]
    check_expr(n, expected)
# ps[i].x on a soa array is ps.x[i]
field_soa_index = (n: int, a0: int, expected: int) -> int:
    f = mk(.field, nodes[n].pos)
    nodes[f].a = nodes[a0].a
    nodes[f].name = nodes[n].name
    nodes[n] = Node(kind = .index, pos = nodes[n].pos, a = i32(f), b = nodes[a0].b)
    check_expr(n, expected)
member_copy = (n: int, bt: int) -> int:
    if not synthetic_copy(bt, int(nodes[n].name), nodes[n].pos): return -1
    check_copy(n, int(nodes[n].a), bt)
member_forward = (n: int, bt: int, expected: int) -> int: forward_member(n, int(nodes[n].a), bt, expected)
member_len_check = (n: int, bt: int):
    dewy_len_check(n, true, bt, int(nodes[n].a))
    return
member_module = (n: int, bt: int, expected: int, is_callee: bool) -> int:
    fname = int(nodes[n].name)
    m = int(types[bt].mod)
    s = module_lookup(m, fname)
    qualifier = int(nodes[n].a)
    if nodes[qualifier].kind != .ident or name_of(int(nodes[qualifier].name))[0] != '$':
        if dewy_at(nodes[n].pos): rational_one_spelling(m, fname, nodes[n].pos, "")
    if s == 0:
        if name_of(fname) == "path" and not dewy_at(nodes[n].pos): fatal(nodes[n].pos, "paths are plain functions: `join_path(a, b)`, `file_name(p)`, `dir_name(p)`, `extension(p)`, `file_exists(p)`")
        fatal(nodes[n].pos, "module '{name_of(int(modules[m].name))}' has no member '{name_of(fname)}'")
    nodes[n] = Node(kind = .ident, pos = nodes[n].pos, name = i32(fname), flags = i32(int(nodes[n].flags) & NF_MUT))
    if is_callee: callee_at = n
    t = check_expr_in_module(n, m, expected)
    last_checked = n
    return t
member_type = (n: int, bt: int, expected: int, is_callee: bool, bypass: mut bool) -> int:
    fname = int(nodes[n].name)
    t = 0
    tt = prune(int(types[bt].elem))
    if tt == ref_addr_type and (name_of(fname) == "min" or name_of(fname) == "max"):
        nodes[n] = nodes[bc_int((if name_of(fname) == "max": ref_addr_max() else: 0), nodes[n].pos)]
        bypass = true
        return check_expr(n, T_INT)
    if tt == T_MATH_INT and (name_of(fname) == "min" or name_of(fname) == "max"):
        fatal(nodes[n].pos, "mathematical int has no min or max; int64 describes the interim storage limits")
    if tt != 0 and is_int(tt) and (name_of(fname) == "min" or name_of(fname) == "max"):
        if ide_on: ide_ref(nodes[n].pos, fname, IK_CONST, 0, tt, 0)
        bits = int(types[tt].bits)
        value = 0
        if name_of(fname) == "min":
            if types[tt].sign: value = 1 << (bits - 1)
            if types[tt].sign and bits < 64: value = -value
        else:
            if bits == 64: value = -1
            else: value = (1 << bits) - 1
            if types[tt].sign: value = int(u64(value) >> 1)
        lit = mk(.int_lit, nodes[n].pos)
        nodes[lit].ival = value
        # Keep the bound's type when a constant/default is cloned and checked again.
        nodes[n] = Node(kind = .conv, pos = nodes[n].pos, a = i32(lit), aux = i32(int(CV.int_)), aux2 = 1, type = i32(tt))
        if not types[tt].sign and value < 0: add_flag(lit, NF_U64)
        check_expr(lit, tt)
        t = tt
    else if tt != 0 and is_float(tt) and float_constant_named(name_of(fname)):
        if ide_on: ide_ref(nodes[n].pos, fname, IK_CONST, 0, tt, 0)
        lit = mk(.float_lit, nodes[n].pos)
        nodes[lit].fval = float_constant(name_of(fname), int(types[tt].bits) == 64)
        nodes[n] = Node(kind = .conv, pos = nodes[n].pos, a = i32(lit), aux = i32(int(CV.float_)), aux2 = 1, type = i32(tt))
        check_expr(lit, tt)
        t = tt
    else if tt != 0 and types[tt].kind == .struct_ and not is_callee and dewy_type_method(int(structs[int(types[tt].st)].decl), fname) >= 0:
        # `Type.method`: a static method of no arguments is called by its name
        callee = mk(.field, nodes[n].pos)
        nodes[callee].a = nodes[n].a
        nodes[callee].name = i32(fname)
        nodes[n] = Node(kind = .call, pos = nodes[n].pos, a = i32(callee))
        bypass = true
        return check_expr(n, expected)
    else if tt != 0 and types[tt].kind == .enum_:
        vi = find_variant(int(types[tt].st), fname)
        if vi < 0: fatal(nodes[n].pos, "{dt(tt)} has no variant '{name_of(fname)}'{variant_hint_for(tt, name_of(fname))}")
        if variants[int(structs[int(types[tt].st)].variants) + vi].nfields != 0: fatal(nodes[n].pos, "variant '{name_of(fname)}' needs arguments")
        if ide_on: ide_variant_ref(nodes[n].pos, fname, tt, vi)
        nodes[n].kind = .dotname
        nodes[n].aux = i32(vi)
        nodes[n].a = 0
        t = tt
    else:
        # (vec3.up, Vector3.zero: written out here)
        if tt != 0 and is_vec(tt):
            vn = name_of(fname)
            dims = vec_n(tt)
            lit = ""
            if vn == "zero": lit = "0"
            else if vn == "one": lit = "1"
            else if dims == 3:
                if vn == "up": lit = "0, 1, 0"
                else if vn == "down": lit = "0, -1, 0"
                else if vn == "left": lit = "-1, 0, 0"
                else if vn == "right": lit = "1, 0, 0"
                else if vn == "forward": lit = "0, 0, -1"
                else if vn == "back": lit = "0, 0, 1"
            else if dims == 2:
                if vn == "up": lit = "0, -1"
                else if vn == "down": lit = "0, 1"
                else if vn == "left": lit = "-1, 0"
                else if vn == "right": lit = "1, 0"
            if len(lit) > 0:
                why = ""
                if vn == "forward": why = " (forward is -z, the way a camera looks)"
                if dims == 2 and (vn == "up" or vn == "down"): why = " (y goes down the screen)"
                fatal(nodes[n].pos, "write it out: `{dt(tt)}({lit})`{why}")
        fatal(nodes[n].pos, "type has no member '{name_of(fname)}'")
    t
member_vector = (n: int, bt: int, expected: int, bypass: mut bool) -> int:
    fname = int(nodes[n].name)
    if files[pos_file(nodes[n].pos)].is_dewy and not swizzle_name(fname) and fn_name_for(bt, fname) and member_call_without_arguments(bt, fname):
        # (`v.norm` is `v.norm()`: a vector's function, called with a dot as a container's are)
        method = mk(.field, nodes[n].pos)
        nodes[method].a = nodes[n].a
        nodes[method].name = i32(fname)
        nodes[n] = Node(kind = .call, pos = nodes[n].pos, a = i32(method), aux2 = -9)
        bypass = true
        return check_expr(n, expected)
    t = check_swizzle(n, bt)
    if ide_on: ide_ref(nodes[n].pos, fname, IK_FIELD, 0, t, 0)
    t
member_deref = (pos: int, bt: int):
    ffi_deref(pos, bt)
    return
member_fields = (si: int):
    check_struct_fields(si)
    return
member_field_ref = (n: int, si: int, fi: int, t: int):
    ide_field_ref(nodes[n].pos, int(nodes[n].name), int(structs[si].decl), fi, t)
    return
member_method_value = (n: int, method: int, is_callee: bool, expected: int) -> int:
    text = "{receiver_text(int(nodes[n].a))}.{name_of(int(nodes[n].name))}"
    if not dewy_bare_fn(n, is_callee): fatal(nodes[n].pos, "'{text}' is a method, which is not a value yet: call it, `{text}()`")
    loop i in [1..nkids(method)):
        if nodes[kid(method, i)].b == 0: bare_fn_error(n, text, true)
    add_flag(int(nodes[n].a), NF_CHECKED)
    bare_call(n, expected)
member_fn_value = (n: int, t: int, is_callee: bool, expected: int) -> int:
    if not dewy_bare_fn(n, is_callee): return -1
    add_flag(int(nodes[n].a), NF_CHECKED)
    bare_fn_value(n, t, "{receiver_text(int(nodes[n].a))}.{name_of(int(nodes[n].name))}", expected)
member_narrow_path = (n: int, t: int) -> int:
    al = path_alias(n)
    if al < 0: return t
    nodes[n] = nodes[mk_ident_local(al, nodes[n].pos)]
    int(locals[al].type)
member_error = (n: int, code: int, bt: int):
    if code == 1: fatal(nodes[n].pos, "sets insert with push: replace `.add(value)` with `.push(value)`")
    if code == 2: fatal(nodes[n].pos, "'.{nodes[n].ival}' needs a tuple, found {dt(bt)}")
    fatal(nodes[n].pos, "tuple index out of range")

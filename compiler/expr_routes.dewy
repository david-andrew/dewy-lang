$runtime_checks
from p"@lib/core/rt.jo" import (__str_slice)
from p"ast.jo" import (NF_CHECKED NF_MUT add_flag clone has_flag kid mk nkids nodes set_list)
from p"check.jo" import (LF_READ check_scopes check_struct_fields ctxs cx locals release_build syms)
from p"checker_call_resolve.dewy" import (resolve_fn_call)
from p"checker_call_values.dewy" import (value_call)
from p"checker_expr.dewy" import (check_expr)
from p"checks_builders.dewy" import (bc_block bc_call bc_ident bc_int bc_let bc_stmt bc_str)
from p"checks_text.dewy" import (byte_find byte_rfind)
from p"checks_thin.dewy" import (resolve_type)
from p"dewy_methods.jo" import (dewy_methods)
from p"expr.jo" import (callee_at dewy_literal_method_name last_checked mk_ident_local)
from p"type_ops.dewy" import (dt)
from p"types.jo" import (T_RANGE T_U16 T_U32 T_U64 T_U8 prune structs tkind types)
from p"util.jo" import (files intern line_col name_of pos_file)
from p"diagnostic_exit.dewy" import (fatal)


RouteWord:type=int64<overflow='wrap'>
# `console.printl(x)` and the rest: print and printl as written, info as printl;
# warn and error on standard error, yellow and red where colour is on; debug on
# standard error, and nothing in a release build (its arguments not evaluated)
dewy_console_call=(n:RouteWord member:string args:array<int64> expected:RouteWord):>int64=>$unsafe {
    let pos=nodes.ptr[n].pos
    if member =? "print" or member =? "printl" or member =? "info" {
        let printer="print"
        if member =? "print" {printer="__dewy_print"}
        nodes.ptr[n].a=int32(bc_ident(printer pos))
        set_list(n args)
        return check_expr(n expected)
    }
    let color=""
    if member =? "warn" {color="33"} else if member =? "error" {color="31"}
    else if member not=? "debug" {fatal(pos "console has print, printl, info, warn, error and debug (and the field color), not '{member}'")}
    if member =? "debug" and release_build {
        let replacement=bc_block([] pos)
        nodes.ptr[n]=nodes.ptr[replacement]
        return check_expr(n expected)
    }
    let text=mk('str_lit' pos)
    nodes.ptr[text].aux=1
    let parts:array<int64>=[]
    loop i in 0.. and a in args {
        if nodes.ptr[a].kind =? 'namedarg' {fatal(nodes.ptr[a].pos "console.{member} takes no named arguments (`print(x file=stderr)` chooses a stream)")}
        if i >? 0 {parts.push(bc_str(" " pos))}
        let part=mk('pair' pos)
        nodes.ptr[part].a=int32(a)
        nodes.ptr[part].sval=-1
        parts.push(part)
    }
    set_list(text parts)
    if args.length =? 1 and nodes.ptr[args[0]].kind =? 'str_lit' and nodes.ptr[args[0]].aux =? 0 {text=args[0]}
    let replacement=bc_call("__console_line" [bc_int(2 pos) text bc_str(color pos)] pos)
    nodes.ptr[n]=nodes.ptr[replacement]
    check_expr(n expected)
}
# `bytes.read<uint64>(i)` (also uint32, uint16): the word at byte offset i of an
# array<uint8>, little-endian, without `$unsafe`. `0 <=? i` and `i + 8 <=? bytes.length`
# are the caller's obligation (facts.jo), proven or checked in the library's helper.
# 0 when the receiver is not an array<uint8> (the call is an ordinary one).
dewy_byte_read=(n:RouteWord callee:RouteWord base:RouteWord args:array<int64> expected:RouteWord):>int64=>$unsafe {
    let recv=RouteWord(nodes.ptr[base].a)
    let rt=prune(check_expr(recv 0))
    recv=last_checked
    add_flag(recv NF_CHECKED)
    nodes.ptr[base].a=int32(recv)
    if tkind(rt) not=? 'array' or prune(RouteWord(types.ptr[rt].elem)) not=? T_U8 {return 0}
    let t=prune(resolve_type(kid(callee 0)))
    let helper=if t =? T_U64 {"__dewy_read_u64"} else if t =? T_U32 {"__dewy_read_u32"} else if t =? T_U16 {"__dewy_read_u16"} else {""}
    if helper =? "" {fatal(nodes.ptr[callee].pos "read<T> loads a uint64, uint32 or uint16 (found {dt(t)})")}
    let replacement=bc_call(helper [recv args[0]] nodes.ptr[n].pos)
    nodes.ptr[n]=nodes.ptr[replacement]
    check_expr(n expected)
}
# The receiver route is evaluated again to pass the object: variables, fields, and
# elements at a variable or constant index.
dewy_plain_route=(n:RouteWord):>bool=>$unsafe {
    let k=nodes.ptr[n].kind
    if k =? 'ident' {return true}
    if k =? 'index' and nkids(n) =? 1 {
        let i=kid(n 0)
        loop nodes.ptr[i].kind =? 'conv' {i=RouteWord(nodes.ptr[i].a)}
        return (nodes.ptr[i].kind =? 'ident' or nodes.ptr[i].kind =? 'int_lit') and dewy_plain_route(RouteWord(nodes.ptr[n].a))
    }
    k =? 'field' and nodes.ptr[n].b =? 0 and dewy_plain_route(RouteWord(nodes.ptr[n].a))
}
# `object.method(args)`: the method field's closure, given the object first (as a
# place when the method changes it). A temporary object is named first.
dewy_method_call=(n:RouteWord callee:RouteWord method:RouteWord args:array<int64> expected:RouteWord):>int64=>$unsafe {
    let recv=RouteWord(nodes.ptr[callee].a)
    let name=name_of(RouteWord(nodes.ptr[callee].name))
    let changes=has_flag(kid(method 0) NF_MUT)
    if not dewy_plain_route(recv) {
        if changes {fatal(nodes.ptr[n].pos "'{name}' changes its object, so it is called on a variable or a field, not on a temporary value")}
        let pos=nodes.ptr[n].pos
        let temp="$object{n}"
        let object=bc_ident(temp pos)
        nodes.ptr[callee].a=int32(object)
        let call=mk('call' pos)
        nodes.ptr[call].a=int32(callee)
        set_list(call args)
        let replacement=bc_block([bc_let(temp recv pos) bc_stmt(call pos)] pos)
        nodes.ptr[n]=nodes.ptr[replacement]
        return check_expr(n expected)
    }
    let receiver=clone(recv)
    nodes.ptr[receiver].pos=nodes.ptr[n].pos
    if changes {add_flag(receiver NF_MUT)}
    callee_at=callee
    check_expr(callee 0);
    let saved=dewy_literal_method_name
    dewy_literal_method_name=RouteWord(nodes.ptr[callee].name)
    let t=value_call(n callee [receiver args...] expected)
    dewy_literal_method_name=saved
    t
}
# `Type.method(args)`: a static method, given a placeholder for the object it does
# not reach (its zero value, never read).
dewy_static_call=(n:RouteWord t:RouteWord j:RouteWord args:array<int64> expected:RouteWord):>int64=>$unsafe {
    let decl=dewy_methods[j].decl
    let name=RouteWord(nodes.ptr[decl].name)
    if dewy_methods[j].reads {fatal(nodes.ptr[n].pos "'{name_of(name)}' reaches the members of a {dt(t)}, so it is called on a value of it, not on the type")}
    let si=RouteWord(types.ptr[t].st)
    check_struct_fields(si)
    let placeholder=mk('call' nodes.ptr[n].pos)
    nodes.ptr[placeholder].aux=2
    nodes.ptr[placeholder].type=int32(t)
    set_list(placeholder fill(0 RouteWord(structs.ptr[si].nfields)))
    add_flag(placeholder NF_CHECKED)
    resolve_fn_call(n name [decl] [placeholder args...] expected)
}
# `$breakpoint`: the site, and each live binding of the function as `name = value`
breakpoint_call=(n:RouteWord):>int64=>$unsafe {
    let pos=nodes.ptr[n].pos
    let [line _]=line_col(pos)
    let path=files[pos_file(pos)].path
    let slash=byte_rfind(path "/")
    if slash >=? 0 {path=__str_slice(path slash + 1 (path as array<uint8>).length)}
    let pieces:array<int64>=[]
    let floor=if cx >=? 0 {RouteWord(ctxs[cx].floor)} else {0}
    loop i in [floor..check_scopes.names.length) {
        let nm=check_scopes.names[i]
        if check_scopes.top[nm] not=? i or syms.ptr[check_scopes.syms[i]].kind not=? 'local' {continue}
        let text=name_of(nm)
        if (text as array<uint8>).length =? 0 or (text as array<uint8>)[0] =? b'$' or (text as array<uint8>)[0] =? b'_' or byte_find(text "$") >=? 0 {continue}
        let l=RouteWord(syms.ptr[check_scopes.syms[i]].ref)
        let t=prune(RouteWord(locals.ptr[l].type))
        let k=tkind(t)
        locals.ptr[l].flags=int32(RouteWord(locals.ptr[l].flags) | LF_READ)
        if t =? T_RANGE or k =? 'typeval' or k =? 'module' or k =? 'polyfn' {continue}
        if k =? 'fn_' or k =? 'callable' or k =? 'cfn' {continue}
        let prefix=if pieces.length >? 0 {"\n  "} else {"  "}
        if k =? 'ptr' or k =? 'var' {
            pieces.push(bc_str("{prefix}{text} : {dt(t)}" pos))
            continue
        }
        let quote=if k =? 'str_' {"\""} else {""}
        pieces.push(bc_str("{prefix}{text} = {quote}" pos))
        let part=mk('pair' pos)
        nodes.ptr[part].a=int32(mk_ident_local(l pos))
        nodes.ptr[part].sval=-1
        pieces.push(part)
        if (quote as array<uint8>).length >? 0 {pieces.push(bc_str(quote pos))}
    }
    let snapshot=mk('str_lit' pos)
    if pieces.length >? 0 {
        nodes.ptr[snapshot].aux=1
        set_list(snapshot pieces)
    }
    else {nodes.ptr[snapshot].sval=int32(intern(""))}
    let replacement=bc_call("__dewy_breakpoint" [bc_str("{path}:{line}" pos) snapshot] pos)
    nodes.ptr[n]=nodes.ptr[replacement]
    n
}

use 'lower_storage.dewy'
use 'native_debug.dewy'
use 'pe_format.dewy'
use 'elf_format.dewy'
use 'x64_module.dewy'
use 'x64_emit.dewy'
use 'x64_allocate.dewy'
use 'x64_encode.dewy'
use 'backend_analysis.dewy'
use 'ir_operands.dewy'
use 'ir_types.dewy'
# x86-64 backend: IR -> machine code. Calling convention follows SysV for scalars:
# integer args in rdi, rsi, rdx, rcx, r8, r9; float args in xmm0-7; the rest on the stack.

use 'util.jo'
use 'diagnostic_exit.dewy'
use 'main.jo'
use 'ir.jo'
use 'lower.jo'
use 'types.jo'
use 'type_ops.dewy'
use 'check.jo'
use 'ast.jo'
use 'fused.jo'
use 'fused_ops.dewy'
use 'ir_builders.dewy'
use 'x64_ops.dewy'

code: u8[]
fn_addr: int[]            # lfunc index -> code offset (-1 = not yet)
entry_end_lf = -1         # called by the entry after main (the runtime's __out_flush: what print left)
data_fix: (int, int, int)[]  # (position of rel32, kind 0=rodata 1=data, offset)
x_encoder_binding = x64_encoder_bind(&code, &data_fix)

const WATCH_CODE_AT = 0x50000000
const WATCH_CODE_SIZE = 0x20000000

ra_spill_cost = 0
ra_total = 0
ra_verbose = false

ra_fn_base = 0

fn_len: int[]               # lfunc -> its code's length (dewy watch)

row_line = -1

row_file = -1

x_emit_host = X64EmitHost(fz_note_ro)
x_emit_binding = x64_emitter_bind(&rodata, &ro_starts, &uw_data, &fused_on, &x_emit_host)
x_cabi_flags: bool[]
x_function_binding = x64_function_bind(&ir, &x_cabi_flags, &ir_positions)

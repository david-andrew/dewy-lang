}
x_emit_calli=(pos:XWord ins:ptr<Ins>):>void=>$unsafe {
    let op=ins[0].op
    let a=XWord(ins[0].a)
    let bb=XWord(ins[0].b)
    # (a C struct result: its slot's address is the last operand, not C's; lower_ffi.dewy)
    let result_code:XWord=if op =? 'callc' and ins[0].imm <? 0 {-ins[0].imm - 1} else {0}
    if result_code not=? 0 {bb -= 1}
    if op =? 'callc' and xe_windows {emit_call_args_win64(a  bb  XWord(ins[0].c)  R11)}
    else {
        emit_call_args(a  bb  XWord(ins[0].c)  R11)
        # System V variadic calls report their vector-register count
        # in al, including fixed floating parameters (at most eight).
        if op =? 'callc' and ins[0].imm >? 0 {
            let nvec:XWord=0
            loop k in [0..bb) {
                if xe_vtype(XWord(xe_arguments[a + k])) not=? VI {nvec += 1}
            }
            b(0xB8) # mov eax, nvec
            b32(min(nvec  8))
        }
    }
    b24(0xD3FF41) # call r11
    call_site_pos(XWord(ins[0].pos))
    pop_call_stack()
    if result_code not=? 0 {x_store_c_result(result_code)}
    store_result(ins[0])
}
# A C struct result in rax/rdx and xmm0/xmm1, stored in order into its slot.
x_store_c_result=(code:XWord):>void=>$unsafe {
    let off=xe_slots[code >> 16]
    let ni:XWord=0
    let nf:XWord=0
    loop i in [0..(code & 7)) {
        let e=(code >> (3 + 2 * i)) & 3
        if e =? 0 {
            mov_mr(RBP  off  if ni =? 0 {RAX} else {RDX})
            ni += 1
        }
        else {
            sse_rm(0xF2  0x11  nf  RBP  off) # movsd [rbp + off], xmm(nf)
            nf += 1
        }
        off += 8
    }
    return
}
x_emit_syscall=(pos:XWord ins:ptr<Ins>):>void=>$unsafe {
    let d=XWord(ins[0].dst)
    let a=XWord(ins[0].a)
    let bb=XWord(ins[0].b)
    pm_count=0
    loop k in [0..bb) {pmove(SYSCALL_REGS[k]  XWord(xe_arguments[a + k]))}
    emit_parallel()
    b16(0x050F)
    st(d  RAX)
}
x_emit_intr=(pos:XWord ins:ptr<Ins>):>void=>$unsafe {
    let d=XWord(ins[0].dst)
    let a=XWord(ins[0].a)
    let bb=XWord(ins[0].b)
    if ins[0].imm =? 1 {
        let r=dreg(d  RAX)
        rel_fixup_lea(r  1  0)
        mov_rm(r  r  0)
        st(d  r)
    }
    else if ins[0].imm =? 10 {
        # the function in entry c of the import address table, below the globals (pe_format.dewy)
        let r=dreg(d  RAX)
        rel_fixup_lea(r  1  xe_iat_off(XWord(ins[0].c)))
        mov_rm(r  r  0)
        st(d  r)
    }
    else {
        # setjmp / longjmp / jump: arguments in rdi, rsi then a call to a machine-code stub
        emit_call_args(a  bb  -1  0)
        b(0xE8)
        b32(0)
        stub_fix.push([XWord(x_code[0].length) - 4  XWord(ins[0].imm)])
        pop_call_stack()
        if d >=? 0 and vloc[d] not=? LOC_NONE {st(d  RAX)}

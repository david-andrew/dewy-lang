        let base=XWord(x_code[0].length)
        let p=x_bytes(42)
        let q=p as ptr<uint64>
        q[0]=0x3883482574C08548
        q[1]=0x0D8D4811741F7C01
        q[2]=0x7500398000000000
        q[3]=0x8D480CEB08FF4805
        q[4]=0x0000E8000000000D
        let tail=(p + 40) as ptr<uint16>
        tail[0]=0
        x_data_fix[0].push([base + 16  1  xe_mt_active])
        call_fix.push([base + 33  XWord(ins[0].imm)])
        stub_fix.push([base + 38  12])
        if ipos not=? 0 {call_sites.push(XWord(x_code[0].length)); call_sites.push(ipos)}
    }
    else {
        emit_call_args(a  bb  -1  0)
        b(0xE8)
        b32(0)
        call_fix.push([XWord(x_code[0].length) - 4  XWord(ins[0].imm)])
        if ipos not=? 0 {call_sites.push(XWord(x_code[0].length)); call_sites.push(ipos)}
        if call_stack_bytes >? 0 {pop_call_stack()}
    }
    let d=XWord(ins[0].dst)
    if d >=? 0 and vloc[d] not=? LOC_NONE {
        let ty=xe_vtype(d)
        if ty =? VI {
            if not xe_debug and v_live[d].nuse =? 1 and pos + 1 <? xe_ncode and xe_instructions[pos + 1].op =? 'ret' and XWord(xe_instructions[pos + 1].a) =? d {
                ret_in_rax=pos + 1

        let base=XWord(x_code[0].length)
        let p=x_bytes(23)
        let q0=p as ptr<uint64>
        q0[0]=0x3883481274C08548
        q0[1]=0x00000D8D480C7401
        let q2=(p + 15) as ptr<uint64>
        q2[0]=0x00000000E8000000

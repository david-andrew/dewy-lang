$runtime_checks
from p"ir_types.dewy" import (Ins IrFn Op)
from p"backend_analysis.dewy" import (INLINE_COPY LOC_CONST LOC_FCONST LOC_GLOBAL LOC_NONE LOC_SLOT LOC_SPILL backend_call_like call_pos call_w v_live vcval vgkind vgoff vloc vslot vsoff x_has_narrow32 x_has_overflow_pair)
from p"x64_encode.dewy" import (CC_A CC_AE CC_B CC_BE CC_E CC_G CC_GE CC_L CC_LE CC_NE CC_P R10 R11 R8 R9 RAX RBP RCX RDI RDX RIPREL RSI RSP VX VY XMM XWord b b16 b24 b32 cur_index frame_size indexed_base is_vreg_vec jcc32 jmp32 jmp_back lea load_sized mem modrr mov_imm mov_mr mov_rm mov_rr nop_pad op_rm op_rr patch32 patch_branch patch_here rel_fixup_lea rex rip_kind rsp_extra rsp_frame setcc setcc_reg sse_rm sse_rr store_sized use_index vec_esize vex vmov_mr vmov_rm vmov_rr x_bytes x_code x_padding_cmov x_padding_floor)
from p"x64_allocate.dewy" import (callee_off live_start ra_on save_list slot_off vspill)

# Whole-function x64 instruction selection, call preservation and source rows.
# Final IR and module policy are borrowed for one sequential emission. Arena
# headers survive output growth; no IR element view crosses a growing operation.
# Work follows emitted instructions and bytes, with the existing bounded fusion
# lookaheads and active-save scans. There is no additional whole-IR analysis.
X64EmitHost:type=[note_ro:<(bits:int64 off:int64):>void>]
let xe_host:ptr<X64EmitHost>=$unsafe (uint64(0) as ptr<X64EmitHost>)
let xe_rodata:ptr<array<uint8>>=$unsafe (uint64(0) as ptr<array<uint8>>)
let xe_ro_starts:ptr<array<int64>>=$unsafe (uint64(0) as ptr<array<int64>>)
let xe_uw_data:ptr<array<int64>>=$unsafe (uint64(0) as ptr<array<int64>>)
let xe_fused_on:ptr<bool>=$unsafe (uint64(0) as ptr<bool>)
let xe_ir:ptr<IrFn>=$unsafe (uint64(0) as ptr<IrFn>)
let xe_positions:ptr<array<int64>>=$unsafe (uint64(0) as ptr<array<int64>>)
let xe_cabi:ptr<array<bool>>=$unsafe (uint64(0) as ptr<array<bool>>)
let xe_start:XWord=0
let xe_debug=false
let xe_windows=false
let xe_fused=false
let xe_mt_active:XWord=0
let xe_iat_base:XWord=0
let xe_emit_error=""
x64_emitter_bind=(ro:ptr<array<uint8>> starts:ptr<array<int64>> unwind:ptr<array<int64>> fused:ptr<bool> host:ptr<X64EmitHost>):>XWord=>$unsafe {
    xe_rodata=ro
    xe_ro_starts=starts
    xe_uw_data=unwind
    xe_fused_on=fused
    xe_host=host
    0
}

# Read-only function views, refreshed after allocation and before selection.
let xe_instructions:ptr<Ins>=$unsafe (uint64(0) as ptr<Ins>)
let xe_arguments:ptr<int32>=$unsafe (uint64(0) as ptr<int32>)
let xe_types:ptr<int8>=$unsafe (uint64(0) as ptr<int8>)
let xe_constants:ptr<XWord>=$unsafe (uint64(0) as ptr<XWord>)
let xe_sizes:ptr<int32>=$unsafe (uint64(0) as ptr<int32>)
let xe_spill:ptr<XWord>=$unsafe (uint64(0) as ptr<XWord>)
let xe_slots:ptr<XWord>=$unsafe (uint64(0) as ptr<XWord>)
let xe_saved:ptr<XWord>=$unsafe (uint64(0) as ptr<XWord>)
let xe_ncode:XWord=0
let xe_nparams:XWord=0
let xe_nargs:XWord=0
let xe_nslots:XWord=0
x64_emitter_ir=(input:ptr<IrFn>):>void=>$unsafe {
    xe_ir=input
    xe_ncode=XWord(input[0].code.length)
    xe_nparams=XWord(input[0].nparams)
    xe_nargs=XWord(input[0].args.length)
    xe_nslots=XWord(input[0].slot_size.length)
    xe_instructions=input[0].code.ptr
    xe_arguments=input[0].args.ptr
    xe_types=input[0].vtypes.ptr
    xe_constants=input[0].kval.ptr as ptr<XWord>
    xe_sizes=input[0].slot_size.ptr
    xe_spill=vspill.ptr as ptr<XWord>
    xe_slots=slot_off.ptr as ptr<XWord>
    xe_saved=callee_off.ptr as ptr<XWord>
}

xe_vtype=(v:XWord):>XWord=>$unsafe {
    let t=XWord(xe_types[v])
    if t =? 3 {return 0}
    t
}
xe_is_kv=(v:XWord):>bool=>$unsafe {XWord(xe_types[v]) =? 3}
xe_kv_of=(v:XWord):>XWord=>$unsafe {xe_constants[v]}
xe_mem_scale=(ins:Ins):>XWord=>$unsafe {(XWord(ins.c) >> 8) & 3}
xe_is_cabi=(lf:XWord):>bool=>$unsafe {xe_cabi[0][lf]}
xe_iat_off=(k:XWord):>XWord=>$unsafe {xe_iat_base + 8 * k}
xe_error=(message:string):>void=>{xe_emit_error=message}
const VI=0
const VF=1
const VS=2
const M_SIGNED=16
const M_FLOAT=32
const M_INDEX=128
const VOP_SPLAT_B=256
const VOP_SPLAT_C=512
const CALL_IF_SHARED=3
const CALL_RC_INC=4
const CALL_RC_DEC=5

let x_int_fail:array<int64>=[]
let x_int_fail_fn:XWord=0
let call_fix:array<[int64 int64]>=[] # (position of rel32, lfunc)
let int_arg_regs:array<int64>=[RDI  RSI  RDX  RCX  R8  R9]
let rsp_rows:array<int64>=[]
rsp_row=(depth:XWord):>void=>$unsafe {
    rsp_rows.push(XWord(x_code[0].length))
    rsp_rows.push(depth)
}
rsp_adjust=(delta:XWord):>void=>$unsafe {
    rsp_extra += delta
    if rsp_frame {rsp_row(frame_size + 8 + rsp_extra)}
}
vec_opc=(op:XWord k:XWord):>XWord=>$unsafe {
    if k <? 2 {
        const ops:array<int64>=[0x58 0x5C 0x59 0x5E 0x5D 0x5F 0x54 0x56 0x57]
        return ops[op]
    }
    if op =? 0 and k =? 2 {return 0xFE} # paddd
    if op =? 0 {return 0xD4} # paddq
    if op =? 1 and k =? 2 {return 0xFA} # psubd
    if op =? 1 {return 0xFB} # psubq
    if op =? 6 {return 0xDB} # pand
    if op =? 7 {return 0xEB} # por
    if op =? 8 {return 0xEF} # pxor
    xe_error("vector operation {op} on element kind {k}")
    0
}

# x = x op y (128 bits)
vop2=(op:XWord k:XWord x:XWord y:XWord):>void=>$unsafe {
    if k >=? 2 and op =? 2 {
        # pmulld (SSE4.1: the vectorizer only uses it in 256-bit code, this is for completeness)
        b(0x66)
        rex(false  x  0  y  false)
        b24(0x40380F)
        modrr(x  y)
        return
    }
    let pre:XWord=0
    if k not=? 0 {pre=0x66}
    sse_rr(pre  vec_opc(op  k)  x  y)
}

# x = a op y (256 bits, AVX2)
vop3=(op:XWord k:XWord x:XWord a:XWord y:XWord):>void=>$unsafe {
    if k >=? 2 and op =? 2 {
        vex(x  a  y  2  1  0  1)
        b(0x40) # vpmulld
        modrr(x  y)
        return
    }
    let pp:XWord=0
    if k not=? 0 {pp=1}
    vex(x  a  y  1  pp  0  1)
    b(vec_opc(op  k))
    modrr(x  y)
}
vec_commutes=(op:XWord):>bool=>$unsafe {
    op =? 0 or op =? 2 or op =? 4 or op =? 5 or op =? 6 or op =? 7 or op =? 8
}
fits32=(v:XWord):>bool=>$unsafe {
    v >=? - 2147483648 and v <=? 2147483647
}

# a vector operand into xmm x: n f32 lanes from memory, or a scalar repeated in every lane
vop_operand=(x:XWord v:XWord splat:bool n:XWord scratch:XWord):>void=>$unsafe {
    if splat {
        let s=xreg_of(v  x  VS)
        if s not=? x {sse_rr(0  0x28  x  s)} # movaps
        sse_rr(0  0xC6  x  x) # shufps x, x, 0
        b(0)
        return
    }
    let xe_pair1=addr_reg(v  scratch)
    let base=xe_pair1[0]
    let disp=xe_pair1[1]
    if n =? 4 {sse_rm(0  0x10  x  base  disp)} # movups
    else {
        sse_rm(0xF2  0x10  x  base  disp) # movsd
        if n =? 3 {
            sse_rm(0xF3  0x10  15  base  disp + 8) # movss
            sse_rr(0  0x16  x  15) # movlhps x, xmm15
        }
    }
}
is_xmm=(r:XWord):>bool=>$unsafe {
    r >=? XMM
}
slot_disp=(v:XWord):>XWord=>$unsafe {
    xe_slots[vslot[v]] + vsoff[v]
}

# value of int vreg v into register r
ld=(r:XWord v:XWord):>void=>$unsafe {
    let l=vloc[v]
    if l >=? 0 {
        if l not=? r {mov_rr(r  l)}
    }
    else if l =? LOC_SPILL {mov_rm(r  RBP  xe_spill[v])}
    else if l =? LOC_CONST or l =? LOC_FCONST {mov_imm(r  vcval[v])}
    else if l =? LOC_SLOT {lea(r  RBP  slot_disp(v))}
    else if l =? LOC_GLOBAL {rel_fixup_lea(r  vgkind[v]  vgoff[v])}
    else {mov_imm(r  0)}
}

# register holding int vreg v (loads into scratch if needed)
reg_of=(v:XWord scratch:XWord):>XWord=>$unsafe {
    let l=vloc[v]
    if l >=? 0 and l <? XMM {return l}
    ld(scratch  v)
    scratch
}

# store register r into vreg v
st=(v:XWord r:XWord):>void=>$unsafe {
    let l=vloc[v]
    if l >=? 0 {
        if l not=? r {mov_rr(l  r)}
    }
    else if l =? LOC_SPILL {mov_mr(RBP  xe_spill[v]  r)}
}

# destination register for v (its own register, or scratch)
dreg=(v:XWord scratch:XWord):>XWord=>$unsafe {
    let l=vloc[v]
    if l >=? 0 and l <? XMM {return l}
    scratch
}

# register copies use movaps: movsd/movss would merge into (and wait for) the old destination
movsd_rr=(x:XWord y:XWord ty:XWord):>void=>$unsafe {
    if x =? y {return}
    if ty =? VY {
        vmov_rr(x  y  ty)
        return
    }
    sse_rr(0  0x28  x  y)
}

# break the false dependency of scalar sqrt/convert instructions on their destination
xzero=(x:XWord):>void=>$unsafe {
    sse_rr(0  0x57  x  x)
}
lds=(x:XWord v:XWord ty:XWord):>void=>$unsafe {
    let l=vloc[v]
    if l >=? XMM {movsd_rr(x  l - XMM  ty)}
    else if l =? LOC_SPILL and is_vreg_vec(ty) {vmov_rm(x  RBP  xe_spill[v]  ty)}
    else if l =? LOC_SPILL {
        if ty =? VS {sse_rm(0xF3  0x10  x  RBP  xe_spill[v])}
        else {sse_rm(0xF2  0x10  x  RBP  xe_spill[v])}
    }
    else if l =? LOC_FCONST {
        if vcval[v] =? 0 {xzero(x)}
        else {
            # (rip_kind may be set for a global the instruction this is for accesses)
            let saved=rip_kind
            rip_kind=0
            sse_rm(fpre(ty)  0x10  x  RIPREL  ro_const(vcval[v]))
            rip_kind=saved
        }
    }
    else {
        ld(RAX  v)
        movq_xr(x  RAX)
    }
}
sts=(v:XWord x:XWord ty:XWord):>void=>$unsafe {
    let l=vloc[v]
    if l >=? XMM {movsd_rr(l - XMM  x  ty)}
    else if l =? LOC_SPILL and is_vreg_vec(ty) {vmov_mr(RBP  xe_spill[v]  x  ty)}
    else if l =? LOC_SPILL {
        if ty =? VS {sse_rm(0xF3  0x11  x  RBP  xe_spill[v])}
        else {sse_rm(0xF2  0x11  x  RBP  xe_spill[v])}
    }
}
xreg_of=(v:XWord scratch:XWord ty:XWord):>XWord=>$unsafe {
    let l=vloc[v]
    if l >=? XMM {return l - XMM}
    lds(scratch  v  ty)
    scratch
}
xdreg=(v:XWord scratch:XWord):>XWord=>$unsafe {
    let l=vloc[v]
    if l >=? XMM {return l - XMM}
    scratch
}
movq_xr=(x:XWord r:XWord):>void=>$unsafe {
    b(0x66)
    rex(true  x  0  r  false)
    b(0x0F)
    b(0x6E)
    modrr(x  r)
}
movq_rx=(r:XWord x:XWord):>void=>$unsafe {
    b(0x66)
    rex(true  x  0  r  false)
    b(0x0F)
    b(0x7E)
    modrr(x  r)
}

# ALU r, operand(v): register / memory / imm32 forms
# opc_rr: "op r/m64, r64" opcode (e.g. 0x01 add); ext: /digit for 0x81 imm form
alu_v=(opc_rr:XWord ext:XWord r:XWord v:XWord):>void=>$unsafe {
    let l=vloc[v]
    if l >=? 0 and l <? XMM {op_rr(opc_rr  true  l  r)}
    else if l =? LOC_CONST {
        let c=vcval[v]
        rex(true  0  0  r  false)
        if c >=? - 128 and c <=? 127 {
            b(0x83)
            modrr(ext  r)
            b(c)
        }
        else {
            b(0x81)
            modrr(ext  r)
            b32(c)
        }
    }
    else if l =? LOC_SPILL {op_rm(opc_rr + 2  true  r  RBP  xe_spill[v])}
    else {
        ld(RCX  v)
        op_rr(opc_rr  true  RCX  r)
    }
}

# memory base for an address vreg: returns (base register, displacement)
addr_of=(v:XWord scratch:XWord):>[int64 int64]=>$unsafe {
    if vloc[v] =? LOC_SLOT {return [RBP  slot_disp(v)]}
    if vloc[v] =? LOC_GLOBAL {
        rip_kind=vgkind[v]
        return [RIPREL  vgoff[v]]
    }
    [reg_of(v  scratch)  0]
}

# like addr_of, but never rip-relative (for instructions with two memory operands)
addr_reg=(v:XWord scratch:XWord):>[int64 int64]=>$unsafe {
    if vloc[v] =? LOC_SLOT {return [RBP  slot_disp(v)]}
    [reg_of(v  scratch)  0]
}

# ---------------- parallel moves ----------------
# A demanded call/prologue move plan has at most fourteen ABI registers plus
# one indirect target. Sources are captured once, so prologues never copy or
# temporarily rewrite the function's allocation. Pending membership is a mask;
# cycle breaking visits the same stable order without allocating/removing lists.
PMove:type=[
    dst:XWord=0
    v:XWord=0
    src:XWord=0
]
let pmoves:array<PMove>=fill(PMove[]  16)
let pm_count:XWord=0
pmove_src=(dst:XWord v:XWord src:XWord):>void=>$unsafe {
    let m=(pmoves.ptr + pm_count)
    m[0].dst = dst
    m[0].v = v
    m[0].src = src
    pm_count += 1
}
pmove=(dst:XWord v:XWord):>void=>$unsafe {
    pmove_src(dst  v  vloc[v])
}
emit_moves=(mask:XWord):>void=>$unsafe {
    let pending=mask
    # O(R^3) worst case including cycle recursion, R <= 15; independent of
    # virtual-register population. No move is reclassified after publication.
    loop true {
        let progress=false
        let any_reg=false
        loop k in [0..pm_count) {
            if pending & (XWord(1) << k) =? 0 {continue}
            let m=(pmoves.ptr + k)
            let src=m[0].src
            if src <? 0 or src =? m[0].dst {continue}
            any_reg=true
            let blocked=false
            loop j in [0..pm_count) {
                if pending & (XWord(1) << j) =? 0 {continue}
                let o=(pmoves.ptr + j)
                if o[0].src =? m[0].dst and o[0].dst not=? m[0].dst {blocked=true}
            }
            if not blocked {
                if is_xmm(m[0].dst) {movsd_rr(m[0].dst - XMM  src - XMM  VF)}
                else {mov_rr(m[0].dst  src)}
                pending &= ((XWord(1) << k) xor -1)
                progress=true
            }
        }
        if not any_reg {break}
        if not progress {
            # Save one source, emit the remaining graph, then finish the cycle.
            loop k in [0..pm_count) {
                if pending & (XWord(1) << k) =? 0 {continue}
                let m=(pmoves.ptr + k)
                let src=m[0].src
                if src >=? 0 and src not=? m[0].dst {
                    if is_xmm(src) {
                        movq_rx(RAX  src - XMM)
                        b(0x50)
                    }
                    else {
                        rex(false  0  0  src  false)
                        b(0x50 + (src & 7))
                    }
                    rsp_adjust(8)
                    let dst=m[0].dst
                    emit_moves(pending & ((XWord(1) << k) xor -1))
                    if is_xmm(dst) {
                        b(0x58)
                        movq_xr(dst - XMM  RAX)
                    }
                    else {
                        rex(false  0  0  dst  false)
                        b(0x58 + (dst & 7))
                    }
                    rsp_adjust(-8)
                    return
                }
            }
        }
    }
    loop k in [0..pm_count) {
        if pending & (XWord(1) << k) =? 0 {continue}
        let m=(pmoves.ptr + k)
        if m[0].src =? m[0].dst {continue}
        if is_xmm(m[0].dst) {lds(m[0].dst - XMM  m[0].v  xe_vtype(m[0].v))}
        else {ld(m[0].dst  m[0].v)}
    }
}
emit_parallel=():>void=>$unsafe {
    emit_moves((XWord(1) << pm_count) - 1)
}

# ---------------- function body ----------------
XCtl:type=[
    kind:XWord=0
    start:XWord=0
    fixups:array<int64>=[]
    ifx:array<int64>=[]
]
let xctl:array<XCtl>=[]
let x_loop_depth:XWord=0
let call_stack_bytes:XWord=0
let uw_fo:XWord=0 # (Windows: the function's rbp is rsp + 16 uw_fo, its unwind codes at uw_at)
let uw_at:XWord=0
emit_prologue=():>void=>$unsafe {
    if not rsp_frame {b(0x55)} # push rbp
    let nsave:XWord=0
    loop r in [0..16) {
        if xe_saved[r] not=? 0 {nsave += 1}
    }
    uw_fo=0
    if xe_windows and nsave >? 0 {uw_fo=(8 * nsave + 15) // 16}
    if uw_fo >? 0 {
        # (Windows: rbp is set as rsp + 16 fo, as its unwind codes can say, so the registers
        # saved below rbp are above where unwinding starts and the codes can say where: pe.jo)
        let start=xe_start
        uw_at=XWord(xe_uw_data[0].length)
        xe_uw_data[0].push(frame_size)
        xe_uw_data[0].push(uw_fo)
        rex(true  0  0  RSP  false)
        b(0x83)
        modrr(5  RSP)
        b(16 * uw_fo) # sub rsp, 16 fo
        xe_uw_data[0].push(XWord(x_code[0].length) - start)
        lea(RBP  RSP  16 * uw_fo)
        xe_uw_data[0].push(XWord(x_code[0].length) - start)
        if frame_size >? 16 * uw_fo {
            rex(true  0  0  RSP  false)
            b(0x81)
            modrr(5  RSP)
            b32(frame_size - 16 * uw_fo)
        }
        xe_uw_data[0].push(XWord(x_code[0].length) - start)
        xe_uw_data[0].push(nsave)
        loop r in [0..16) {
            if xe_saved[r] not=? 0 {
                mov_mr(RBP  xe_saved[r]  r)
                xe_uw_data[0].push(XWord(x_code[0].length) - start)
                xe_uw_data[0].push(r)
                xe_uw_data[0].push(xe_saved[r] + 16 * uw_fo)
            }
        }
    }
    else {
        if not rsp_frame {mov_rr(RBP  RSP)}
        if frame_size >? 0 or rsp_frame {
            rex(true  0  0  RSP  false)
            if rsp_frame and frame_size =? 0 {
                b(0x83)
                modrr(5  RSP)
                b(8) # Same four-byte entry span as push rbp / mov rbp,rsp.
            }
            else {
                b(0x81)
                modrr(5  RSP)
                b32(frame_size + (if rsp_frame {8} else {0})) # sub rsp, frame
            }
            if rsp_frame {rsp_row(frame_size + 8)}
        }
        loop r in [0..16) {
            if xe_saved[r] not=? 0 {mov_mr(RBP  xe_saved[r]  r)}
        }
    }
    # Spill incoming registers before moving any; capture register sources in
    # the bounded move plan. Stack parameters are read in a second linear scan.
    let ni:XWord=0
    let nf:XWord=0
    pm_count=0
    loop p in [0..xe_nparams) {
        let ty=xe_vtype(p)
        let src:XWord=-1
        if ty =? VI {
            if ni <? 6 {src=int_arg_regs[ni]}
            ni += 1
        }
        else {
            if nf <? 8 {src=XMM + nf}
            nf += 1
        }
        if src <? 0 {continue}
        let loc=vloc[p]
        if loc =? LOC_NONE {continue}
        if loc =? LOC_SPILL {
            if is_xmm(src) {
                if ty =? VS {sse_rm(0xF3  0x11  src - XMM  RBP  xe_spill[p])}
                else {sse_rm(0xF2  0x11  src - XMM  RBP  xe_spill[p])}
            }
            else {mov_mr(RBP  xe_spill[p]  src)}
        }
        else {pmove_src(loc  p  src)}
    }
    emit_parallel()
    if ni <=? 6 and nf <=? 8 {return}
    ni=0
    nf=0
    let stack_k:XWord=0
    loop p in [0..xe_nparams) {
        let ty=xe_vtype(p)
        if ty =? VI {
            ni += 1
            if ni <=? 6 {continue}
        }
        else {
            nf += 1
            if nf <=? 8 {continue}
        }
        let off=16 + 8 * stack_k
        stack_k += 1
        if vloc[p] =? LOC_NONE {continue}
        if ty =? VI {
            mov_rm(RAX  RBP  off)
            st(p  RAX)
        }
        else {
            sse_rm(0xF2  0x10  0  RBP  off)
            sts(p  0  ty)
        }
    }
}
emit_epilogue=():>void=>$unsafe {
    loop r in [0..16) {
        if xe_saved[r] not=? 0 {mov_rm(r  RBP  xe_saved[r])}
    }
    if rsp_frame {
        rex(true  0  0  RSP  false)
        if frame_size =? 0 {
            b(0x83)
            modrr(0  RSP)
            b(8) # Same five-byte exit span as the compact RBP epilogue.
        }
        else {
            b(0x81)
            modrr(0  RSP)
            b32(frame_size + 8)
        }
        rsp_row(0)
        b(0xC3)
        # Later blocks still enter with the function's frame allocated.
        rsp_row(frame_size + 8)
        return
    }
    # Empty frames leave rsp at rbp. Keep Windows' canonical unwind form.
    let compact=frame_size =? 0 and not xe_windows
    # Ignored CS prefixes keep pop/ret opcodes and every following loop/JCC
    # at their original addresses without executing the redundant move.
    if compact {b24(0x2E2E2E)}
    else {mov_rr(RSP  RBP)}
    b(0x5D) # pop rbp
    if xe_debug {dbg_epis.push(XWord(x_code[0].length))}
    b(0xC3) # ret
}
emit_call_args=(start:XWord n:XWord extra:XWord extra_dst:XWord):>void=>$unsafe {
    let ni:XWord=0
    let nf:XWord=0
    let nstack:XWord=0
    pm_count=0
    loop k in [0..n) {
        let v=XWord(xe_arguments[start + k])
        if xe_vtype(v) =? VI {
            ni += 1
            if ni <=? 6 {
                pmove(int_arg_regs[ni - 1]  v)
                continue
            }
        }
        else {
            nf += 1
            if nf <=? 8 {
                pmove(XMM + nf - 1  v)
                continue
            }
        }
        nstack += 1
    }
    if extra >=? 0 {pmove(extra_dst  extra)}
    let pad=(nstack % 2) * 8
    if pad >? 0 {
        rex(true  0  0  RSP  false)
        b(0x83)
        modrr(5  RSP)
        b(8)
        rsp_adjust(8)
    }
    if nstack >? 0 {
        # Reverse the existing operand span, counting down each register class;
        # this is exactly the old stack-argument order, without a temporary list.
        let i=n - 1
        loop i >=? 0 {
            let v=XWord(xe_arguments[start + i])
            i -= 1
            if xe_vtype(v) =? VI {
                ni -= 1
                if ni <? 6 {continue}
                ld(RAX  v)
            }
            else {
                nf -= 1
                if nf <? 8 {continue}
                lds(0  v  xe_vtype(v))
                movq_rx(RAX  0)
            }
            b(0x50)
            rsp_adjust(8)
        }
    }
    emit_parallel()
    call_stack_bytes=pad + nstack * 8
}

# Win64 uses four argument positions, then the existing span on the stack.
const WIN_ARG_REGS:array<int64>=[RCX  RDX  8  9]
const SYSCALL_REGS:array<int64>=[RAX  RDI  RSI  RDX  R10  R8  R9]
emit_call_args_win64=(start:XWord n:XWord extra:XWord extra_dst:XWord):>void=>$unsafe {
    pm_count=0
    loop k in [0..min(n  4)) {
        let v=XWord(xe_arguments[start + k])
        if xe_vtype(v) =? VI {pmove(WIN_ARG_REGS[k]  v)}
        else {pmove(XMM + k  v)}
    }
    if extra >=? 0 {pmove(extra_dst  extra)}
    let nstack=max(0  n - 4)
    let pad=(nstack % 2) * 8
    if pad >? 0 {
        rex(true  0  0  RSP  false)
        b(0x83)
        modrr(5  RSP)
        b(8)
        rsp_adjust(8)
    }
    let i=n - 1
    loop i >=? 4 {
        let v=XWord(xe_arguments[start + i])
        if xe_vtype(v) =? VI {ld(RAX  v)}
        else {
            lds(0  v  xe_vtype(v))
            movq_rx(RAX  0)
        }
        b(0x50)
        rsp_adjust(8)
        i -= 1
    }
    rex(true  0  0  RSP  false) # sub rsp, 32
    b(0x83)
    modrr(5  RSP)
    b(32)
    rsp_adjust(32)
    emit_parallel()
    loop k in [0..min(n  4)) {
        if xe_vtype(XWord(xe_arguments[start + k])) not=? VI {movq_rx(WIN_ARG_REGS[k]  k)}
    }
    call_stack_bytes=pad + nstack * 8 + 32
}
pop_call_stack=():>void=>$unsafe {
    if call_stack_bytes >? 0 {
        rex(true  0  0  RSP  false)
        b(0x81)
        modrr(0  RSP)
        b32(call_stack_bytes)
        rsp_adjust(-call_stack_bytes)
    }
}
store_result=(ins:Ins):>void=>$unsafe {
    let d=XWord(ins.dst)
    if d <? 0 or vloc[d] =? LOC_NONE {return}
    let ty=xe_vtype(d)
    if ty =? VI {st(d  RAX)}
    else {sts(d  0  ty)}
}
fpre=(ty:XWord):>XWord=>$unsafe {
    if ty =? VS {return 0xF3}
    0xF2
}
let ro_consts:dict<int64 int64>=[]
let ro_new:array<[int64 int64]>=[] # (offset, bits) of each constant ro_const added (par.jo: the workers')

# offset of an 8-byte constant in read-only data (shared between uses)
ro_const=(bits:XWord):>XWord=>$unsafe {
    if bits in? ro_consts {
        let o=ro_consts[bits]
        if xe_fused_on[0] {xe_host[0].note_ro(bits  o)}
        return o
    }
    loop XWord(xe_rodata[0].length) % 8 not=? 0 {xe_rodata[0].push(0)}
    let o=XWord(xe_rodata[0].length)
    xe_ro_starts[0].push(o)
    loop k in [0..8) {xe_rodata[0].push(uint8(((bits >> (8 * k)) & 255) & 0xff))}
    ro_consts[bits] = o
    ro_new.push([o  bits])
    if xe_fused_on[0] {xe_host[0].note_ro(bits  o)}
    o
}
branch_target_fix=(depth:XWord):>void=>$unsafe {
    let c=XWord(xctl.length) - 1 - depth
    if xctl[c].kind =? 1 {jmp_back(xctl[c].start)}
    else {xctl[c].fixups.push(jmp32())}
}
branch_target_jcc=(depth:XWord cc:XWord):>void=>$unsafe {
    let c=XWord(xctl.length) - 1 - depth
    if xctl[c].kind =? 1 {
        let target=xctl[c].start
        b(0x0F)
        b(0x80 + cc)
        let pos=XWord(x_code[0].length)
        b32(0)
        patch_branch(pos  target)
    }
    else {xctl[c].fixups.push(jcc32(cc))}
}

# An end followed only by ends and an unconditional branch is the branch's
# destination. Redirect its incoming jumps now, rather than making each loop
# iteration execute a jump to another jump. Bound the lookahead so deeply nested
# source cannot turn emission into a quadratic scan. No instructions are moved.
patch_control_end=(c:XCtl pos:XWord):>void=>$unsafe {
    if XWord(c.fixups.length) =? 0 and XWord(c.ifx.length) =? 0 {return}
    let next=pos + 1
    let closed:XWord=0
    loop next <? xe_ncode and closed <? 8 and xe_instructions[next].op =? 'end' {
        next += 1
        closed += 1
    }
    let target:XWord=-1
    if next <? xe_ncode and xe_instructions[next].op =? 'br' {
        target=XWord(xctl.length) - closed - 1 - XWord(xe_instructions[next].imm)
    }
    if target >=? 0 {
        if xctl[target].kind =? 1 {
            let addr=xctl[target].start
            loop f in c.fixups {patch_branch(f  addr)}
            loop f in c.ifx {patch_branch(f  addr)}
        }
        else {
            loop f in c.fixups {xctl[target].fixups.push(f)}
            loop f in c.ifx {xctl[target].fixups.push(f)}
        }
        return
    }
    loop f in c.fixups {patch_here(f)}
    loop f in c.ifx {patch_here(f)}
}

# d = a + b (sign -1: a - b, b a constant) into a register other than a's in one instruction:
# lea d, [a + b]
lea_add=(d:XWord a:XWord bb:XWord sign:XWord):>bool=>$unsafe {
    let rd=vloc[d]
    let ra=vloc[a]
    let rb=vloc[bb]
    if rd <? 0 or rd >=? XMM or ra <? 0 or ra >=? XMM or ra =? rd {return false}
    if rb =? LOC_CONST {
        let k=vcval[bb] * sign
        if not fits32(k) {return false}
        lea(rd  ra  k)
        return true
    }
    if rb <? 0 or rb >=? XMM or sign <? 0 {return false}
    use_index(rb  0)
    lea(rd  ra  0)
    cur_index=-1
    true
}
int_bin=(opc_rr:XWord ext:XWord ins:Ins):>void=>$unsafe {
    let d=XWord(ins.dst)
    if vloc[d] =? LOC_NONE {return}
    let a=XWord(ins.a)
    let bb=XWord(ins.b)
    let r=dreg(d  RAX)
    if vloc[bb] =? r and r not=? vloc[a] {
        if opc_rr =? 0x29 {r=RAX}
        else {
            let temp=a
            a=bb
            bb=temp
        }
    }
    ld(r  a)
    alu_v(opc_rr  ext  r  bb)
    st(d  r)
}
let pad_moves=false # the function being emitted has a pad that depends on where it starts
let x_branch_pos:XWord=-1

# Demand-only bounded lookahead at a crossing fused pair: O(24) IR entries.
# Short forward branches can be repaired in place; reserve alignment for larger
# regions. The structured control stack already indexes backward targets.
x_far_if=(pos:XWord):>bool=>$unsafe {
    if pos <? 0 {return false}
    let branch=xe_instructions[pos]
    if branch.op not=? 'if_' and branch.op not=? 'brif' {return false}
    let depth:XWord=0
    if branch.op =? 'brif' {
        depth=XWord(branch.imm)
        if xctl[XWord(xctl.length) - 1 - depth].kind =? 1 {return false}
    }
    loop p in [pos + 1..min(xe_ncode  pos + 25)) {
        let op=xe_instructions[p].op
        if op =? 'block' or op =? 'if_' or op =? 'loop' {depth += 1}
        else if op =? 'end' {
            if depth =? 0 {return false}
            depth -= 1
        }
        else if op =? 'else_' and depth =? 0 and branch.op =? 'if_' {return false}
    }
    true
}

# A preceding register/immediate ALU can absorb up to five ignored CS
# prefixes (as assemblers' branch-prefix padding does): decoders and tools
# such as Valgrind reject an instruction with more than seven prefixes. A bounded O(8) query skips byte-free block/end
# markers; the latest resolved destination prevents moving an entry point.
# Verify the complete encoding, and keep no pointer across buffer growth.
x_absorb_padding=(padding:XWord):>bool=>$unsafe {
    if padding >? 5 or x_branch_pos <? 2 or xe_debug {return false}
    let cmp=xe_instructions[x_branch_pos - 1]
    if not is_icmp(cmp.op) or vloc[XWord(cmp.a)] <? 0 or vloc[XWord(cmp.a)] >=? XMM {return false}
    let bv=vloc[XWord(cmp.b)]
    if bv not=? LOC_CONST and(bv <? 0 or bv >=? XMM) {return false}
    let before=x_branch_pos - 2
    let limit=max(0  before - 8)
    loop before >? limit and(xe_instructions[before].op =? 'block' or xe_instructions[before].op =? 'end') {before -= 1}
    let previous=xe_instructions[before]
    let op=previous.op
    let ext:XWord=if op =? 'add' {0} else {if op =? 'or_' {1} else {if op =? 'and_' {4} else {if op =? 'sub' {5} else {if op =? 'xor' {6} else {-1}}}}}
    if ext <? 0 {return false}
    let r=vloc[XWord(previous.dst)]
    bv=XWord(previous.b)
    if r <? 0 or r >=? XMM or vloc[bv] not=? LOC_CONST {return false}
    let value=vcval[bv]
    if not fits32(value) {return false}
    let narrow=value >=? - 128 and value <=? 127
    let width:XWord=if narrow {4} else {7}
    if width + padding >? 15 {return false}
    let at=XWord(x_code[0].length) - width
    if at <? x_padding_floor {return false}
    let p=x_code[0].ptr + at
    if p[0] not=? uint8((0x48 | (r >> 3)) & 0xff) or p[1] not=? uint8((if narrow {0x83} else {0x81}) & 0xff) or p[2] not=? uint8((0xC0 | (ext << 3) | (r & 7)) & 0xff) {return false}
    if narrow {
        if p[3] not=? uint8((value) & 0xff) {return false}
    }
    else if((p + 3) as ptr<uint32>)[0] not=? uint32((value) & 0xffffffff) {return false}
    let first=(p as ptr<uint32>)[0]
    let second=if narrow {uint16((0) & 0xffff)} else {((p + 4) as ptr<uint16>)[0]}
    let last=if narrow {uint8((0) & 0xff)} else {p[6]}
    x_bytes(padding);
    p=x_code[0].ptr + at
    loop i in [0..padding) {p[i] = 0x2E}
    let xe_store=((p + padding) as ptr<uint32>)
    xe_store[0]=first
    if not narrow {
        let xe_store=((p + padding + 4) as ptr<uint16>)
        xe_store[0]=second
        p[padding + 6] = last
    }
    true
}
cmp_branch_pad=(span:XWord):>void=>$unsafe {
    # Most loop comparisons rely on aligned entries and fixed-size fixups.
    # Crossing backedges may grow the preceding ALU without adding executed
    # instructions. Larger forward regions also permit ordinary alignment.
    if x_loop_depth >? 0 and(XWord(x_code[0].length) & 31) + span <? 32 {return}
    if x_loop_depth >? 0 and not x_far_if(x_branch_pos) {
        if x_branch_pos >=? 0 {
            let branch=xe_instructions[x_branch_pos]
            if branch.op =? 'brif' and xctl[XWord(xctl.length) - 1 - XWord(branch.imm)].kind =? 1 {
                if x_absorb_padding(32 - (XWord(x_code[0].length) & 31)) {pad_moves=true}
            }
        }
        return
    }
    # Keep a fused integer comparison and its near conditional jump within a
    # 32-byte region, including the last byte. Some x86 CPUs are sensitive to
    # crossing or ending on this boundary; pad only an affected pair.
    let offset=XWord(x_code[0].length) % 32
    if offset + span >=? 32 and not x_absorb_padding(32 - offset) {nop_pad(32 - offset)}
    # (par.jo: were the function to start 16 bytes further, would this pad differ?)
    if offset + span >=? 32 or(offset + 16) % 32 + span >=? 32 {pad_moves=true}
}
let cmp_load:XWord=-1 # adjacent integer load consumed by cmp_ops
let cmp_reload:XWord=-1 # original load, repeated only inside a failure arm
let cmp_reload_at:XWord=-1

# A check's diagnostic is often the load's only other use. Sink that copy
# past the branch, before any diagnostic argument setup. This bounded local
# pattern crosses no memory effect or register-producing instruction.
cmp_failure_use=(pos:XWord ins:Ins nx:Ins):>bool=>$unsafe {
    let d=XWord(ins.dst)
    if xe_debug or v_live[d].ndef not=? 1 or v_live[d].nuse not=? 2 or XWord(ins.c) & 15 not=? 8 {return false}
    if pos + 4 >=? xe_ncode or v_live[XWord(nx.dst)].nuse not=? 1 {return false}
    let branch=xe_instructions[pos + 2]
    if branch.op not=? 'if_' or branch.a not=? nx.dst {return false}
    let at=pos + 3
    if xe_instructions[at].op =? 'daddr' {at += 1}
    let call=xe_instructions[at]
    if call.op not=? 'call' or call.c not=? 1 or XWord(call.b) >? 8 or at + 1 >=? xe_ncode or xe_instructions[at + 1].op not=? 'end' {return false}
    let uses:XWord=0
    loop k in [0..XWord(call.b)) {
        if xe_arguments[XWord(call.a) + k] =? ins.dst {uses += 1}
    }
    uses =? 1
}

# Only the immediately following comparison can consume the load. Narrow
# equality with a representable constant preserves the extension's meaning;
# ordered narrow comparisons still need their full-width signedness.
can_cmp_load=(ins:Ins nx:Ins):>bool=>$unsafe {
    if not is_icmp(nx.op) {return false}
    let d=XWord(ins.dst)
    if XWord(nx.a) =? d and XWord(nx.b) =? d {return false}
    if XWord(nx.a) not=? d and XWord(nx.b) not=? d {return false}
    let size=XWord(ins.c) & 15
    if size =? 8 {return true}
    if nx.op not=? 'eq' and nx.op not=? 'ne' {return false}
    let other=if XWord(nx.a) =? d {XWord(nx.b)} else {XWord(nx.a)}
    if vloc[other] not=? LOC_CONST {return false}
    let value=vcval[other]
    let bits=size * 8
    if XWord(ins.c) & M_SIGNED not=? 0 {
        if value <? - (XWord(1) << (bits - 1)) or value >=? XWord(1) << (bits - 1) {return false}
    }
    else if value <? 0 or value >=? XWord(1) << bits {return false}
    # RIP-relative immediate operands need an end-of-instruction relocation.
    # Keep their ordinary load rather than change the shared relocation format.
    vloc[XWord(ins.a)] not=? LOC_GLOBAL
}
cmp_ops=(a:XWord bb:XWord branch:bool=false):>void=>$unsafe {
    if cmp_load >=? 0 {
        let ins=xe_instructions[cmp_load]
        cmp_load=-1
        let left=XWord(ins.dst) =? a
        let other=if left {bb} else {a}
        let size=XWord(ins.c) & 15
        let xe_pair2=addr_of(XWord(ins.a)  RCX)
        let base=xe_pair2[0]
        let disp=xe_pair2[1]
        disp += XWord(ins.imm)
        let ix:XWord=-1
        if XWord(ins.c) & M_INDEX not=? 0 {
            let xe_pair3=indexed_base(base  disp  XWord(ins.imm))
            base=xe_pair3[0]
            disp=xe_pair3[1]
            ix=reg_of(XWord(ins.b)  RDX)
        }
        let immediate=vloc[other] =? LOC_CONST and base not=? RIPREL and(left or size not=? 8)
        let r:XWord=0
        if not immediate {r=reg_of(other  RAX)}
        if branch and ra_on {
            let span:XWord=2 # opcode and ModRM
            if size =? 8 or r & 8 not=? 0 or(base not=? RIPREL and base & 8 not=? 0) or(ix >=? 0 and ix & 8 not=? 0) {span += 1}
            if base =? RIPREL {span += 4}
            else {
                if ix >=? 0 or base & 7 =? 4 {span += 1}
                if disp <? - 128 or disp >? 127 {span += 4}
                else if disp not=? 0 or base & 7 =? 5 {span += 1}
            }
            if immediate {
                if size =? 2 {span += 1}
                let value=vcval[other]
                span += if size =? 1 or(value >=? - 128 and value <=? 127) {1} else {if size =? 2 {2} else {4}}
            }
            cmp_branch_pad(span + 6)
        }
        use_index(ix  xe_mem_scale(ins))
        if immediate {
            let value=vcval[other]
            let short=value >=? - 128 and value <=? 127
            if size =? 2 {b(0x66)}
            rex(size =? 8  0  0  base  false)
            b(if size =? 1 {0x80} else {if short {0x83} else {0x81}})
            mem(7  base  disp)
            if size =? 1 or short {b(value)}
            else if size =? 2 {b16(value)}
            else {b32(value)}
        }
        else {op_rm((if left {0x39} else {0x3B})  true  r  base  disp)}
        cur_index=-1
        return
    }
    # A spill already is a full-width integer operand. Compare its stack slot
    # directly when the other operand fits x64's register/immediate form;
    # keep the original operand order so signed and unsigned flags agree.
    let other=vloc[bb]
    if vloc[a] =? LOC_SPILL and(other =? LOC_CONST or(other >=? 0 and other <? XMM)) {
        let immediate=other =? LOC_CONST
        let short=immediate and vcval[bb] >=? - 128 and vcval[bb] <=? 127
        if branch and ra_on {
            let disp=xe_spill[a]
            let base=RBP
            if rsp_frame {
                base=RSP
                disp += frame_size + rsp_extra
            }
            let span:XWord=3 # REX.W, opcode, ModRM
            if base =? RSP {span += 1} # SIB
            if disp <? - 128 or disp >? 127 {span += 4}
            else if disp not=? 0 or base =? RBP {span += 1}
            if immediate {span += if short {1} else {4}}
            cmp_branch_pad(span + 6)
        }
        if immediate {
            rex(true  0  0  RBP  false)
            b(if short {0x83} else {0x81})
            mem(7  RBP  xe_spill[a])
            if short {b(vcval[bb])}
            else {b32(vcval[bb])}
        }
        else {op_rm(0x39  true  other  RBP  xe_spill[a])}
        return
    }
    let ra=reg_of(a  RAX)
    if branch and ra_on {
        let l=vloc[bb]
        let size:XWord=3 # REX.W, opcode, register ModRM
        if l =? LOC_CONST {
            size=if vcval[bb] >=? - 128 and vcval[bb] <=? 127 {4} else {7}
        }
        else if l =? LOC_SPILL {
            size=if xe_spill[bb] >=? - 128 and xe_spill[bb] <=? 127 {4} else {7}
        }
        else if l <? 0 or l >=? XMM {
            ld(RCX  bb)
            cmp_branch_pad(9)
            op_rr(0x39  true  RCX  ra)
            return
        }
        cmp_branch_pad(size + 6)
    }
    alu_v(0x39  7  ra  bb)
}
icc=(op:Op):>XWord=>$unsafe {
    match op {
        <'eq'> => {CC_E}
        <'ne'> => {CC_NE}
        <'lts'> => {CC_L}
        <'les'> => {CC_LE}
        <'gts'> => {CC_G}
        <'ges'> => {CC_GE}
        <'ltu'> => {CC_B}
        <'leu'> => {CC_BE}
        <'gtu'> => {CC_A}
        <'geu'> => {CC_AE}
        _ => {-1}
    }
}
is_icmp=(op:Op):>bool=>$unsafe {
    icc(op) >=? 0
}
is_fcmp=(op:Op):>bool=>$unsafe {
    op =? 'feq' or op =? 'fne' or op =? 'flt' or op =? 'fle' or op =? 'fgt' or op =? 'fge'
}

# emit float compare flags; returns condition code for "true"
fcmp_flags=(ins:Ins):>XWord=>$unsafe {
    let ty=XWord(ins.ty)
    let pre:XWord=0
    if ty =? VF {pre=0x66}
    let a=XWord(ins.a)
    let bb=XWord(ins.b)
    let op=ins.op
    if op =? 'flt' or op =? 'fle' {
        let x=a
        a=bb
        bb=x
    }
    let xa=xreg_of(a  0  ty)
    let xb=xreg_of(bb  1  ty)
    if pre not=? 0 {b(pre)}
    rex(false  xa  0  xb  false)
    b(0x0F)
    b(0x2E)
    modrr(xa  xb)
    if op =? 'flt' or op =? 'fgt' {return CC_A}
    if op =? 'fle' or op =? 'fge' {return CC_AE}
    if op =? 'feq' {return 100}
    101
}
is_falu=(op:Op):>bool=>$unsafe {
    op =? 'fadd' or op =? 'fsub' or op =? 'fmul' or op =? 'fdiv' or op =? 'fmin' or op =? 'fmax'
}
let fold_load:XWord=-1 # a load the next instruction reads from memory (see load)
falu=(opc:XWord ins:Ins):>void=>$unsafe {
    let ty=XWord(ins.ty)
    let d=XWord(ins.dst)
    if fold_load >=? 0 {
        let ld_ins=xe_instructions[fold_load]
        fold_load=-1
        let xe_pair4=addr_of(XWord(ld_ins.a)  RCX)
        let base=xe_pair4[0]
        let disp=xe_pair4[1]
        disp += XWord(ld_ins.imm)
        let ix:XWord=-1
        if XWord(ld_ins.c) & M_INDEX not=? 0 {
            let xe_pair5=indexed_base(base  disp  XWord(ld_ins.imm))
            base=xe_pair5[0]
            disp=xe_pair5[1]
            ix=reg_of(XWord(ld_ins.b)  RDX)
        }
        let x=xdreg(d  0)
        lds(x  XWord(ins.a)  ty)
        use_index(ix  xe_mem_scale(ld_ins))
        sse_rm(fpre(ty)  opc  x  base  disp)
        cur_index=-1
        sts(d  x  ty)
        return
    }
    let bv=XWord(ins.b)
    if vloc[bv] =? LOC_FCONST and vcval[bv] not=? 0 {
        # op x, [constant]
        let x=xdreg(d  0)
        lds(x  XWord(ins.a)  ty)
        rip_kind=0
        sse_rm(fpre(ty)  opc  x  RIPREL  ro_const(vcval[bv]))
        sts(d  x  ty)
        return
    }
    let x=xdreg(d  0)
    let xb=xreg_of(XWord(ins.b)  1  ty)
    if x =? xb and x not=? 0 {
        # (the result goes where the second operand is)
        if XWord(ins.a) =? XWord(ins.b) {
            sse_rr(fpre(ty)  opc  x  x) # x * x
            return
        }
        if opc =? 0x58 or opc =? 0x59 or opc =? 0x5D or opc =? 0x5F {
            let xa=xreg_of(XWord(ins.a)  1  ty) # commutative: x = x op a
            sse_rr(fpre(ty)  opc  x  xa)
            return
        }
        lds(0  XWord(ins.a)  ty)
        sse_rr(fpre(ty)  opc  0  xb)
        sts(d  0  ty)
        return
    }
    lds(x  XWord(ins.a)  ty)
    sse_rr(fpre(ty)  opc  x  xb)
    sts(d  x  ty)
}
x_unary=(prefix:XWord opc:XWord ins:Ins src_ty:XWord dst_ty:XWord):>void=>$unsafe {
    let d=XWord(ins.dst)
    let x=xdreg(d  0)
    let xa=xreg_of(XWord(ins.a)  1  src_ty)
    if x not=? xa {xzero(x)}
    sse_rr(prefix  opc  x  xa)
    sts(d  x  dst_ty)
}

# A bounded memory comparison, using only reserved scratch registers plus its
# destination. Keeping this operation in IR avoids lowering a runtime loop and
# its control-flow joins at every call site. No read crosses either byte span.
emit_memeq=(d:XWord a:XWord bb:XWord count:XWord flags:bool=false strings:bool=false):>void=>$unsafe {
    if vloc[d] =? LOC_NONE {return}
    # This intrinsic contains its own comparison loops and short-size tree.
    # Keep their fused branches aligned even inside a surrounding source loop.
    let enclosing_depth=x_loop_depth
    x_loop_depth=0
    let mask=dreg(d  R11)
    let saved=vloc[d] <? 0
    if saved {
        b16(0x5341) # push r11 (spilled destination)
        rsp_adjust(8)
    }
    ld(RAX  a)
    ld(RCX  bb)
    let unequal:array<int64>=[]
    let results:array<int64>=[]
    let same:XWord=-1
    let nil_left:XWord=-1
    let nil_right:XWord=-1
    if strings {
        # Runtime strings have length at +8 and bytes at +24. Nil is empty;
        # handle it before reading either header. The input values stay live.
        cmp_branch_pad(9)
        op_rr(0x39  true  RAX  RCX)
        same=jcc32(4)
        cmp_branch_pad(9)
        op_rr(0x85  true  RAX  RAX)
        nil_left=jcc32(4)
        cmp_branch_pad(9)
        op_rr(0x85  true  RCX  RCX)
        nil_right=jcc32(4)
        mov_rm(RDX  RAX  8)
        cmp_branch_pad(10)
        op_rm(0x3B  true  RDX  RCX  8)
        unequal.push(jcc32(5))
        lea(RAX  RAX  24)
        lea(RCX  RCX  24)
    }
    else {ld(RDX  count)}
    cmp_branch_pad(10)
    b24(0xFA8348)
    b(0) # cmp rdx, 0
    let empty=jcc32(14) # jle: portable n <= 0 behavior
    cmp_branch_pad(10)
    b24(0xFA8348)
    b(16)
    let short=jcc32(12) # jl: fewer than 16 bytes
    nop_pad((16 - XWord(x_code[0].length) % 16) % 16)
    let vector_loop=XWord(x_code[0].length)
    sse_rm(0xF3  0x6F  0  RAX  0) # movdqu xmm0, [a]
    sse_rm(0xF3  0x6F  1  RCX  0)
    sse_rr(0x66  0x74  0  1) # pcmpeqb
    sse_rr(0x66  0xD7  mask  0) # pmovmskb mask32, xmm0
    cmp_branch_pad(13)
    rex(false  0  0  mask  false)
    b(0x81)
    modrr(7  mask)
    b32(65535)
    unequal.push(jcc32(5))
    cmp_branch_pad(10)
    b24(0xFA8348)
    b(32)
    let tail=jcc32(14)
    lea(RAX  RAX  16)
    lea(RCX  RCX  16)
    lea(RDX  RDX  -16)
    jmp_back(vector_loop)
    patch_here(tail)
    use_index(RDX  0)
    lea(RAX  RAX  -16)
    lea(RCX  RCX  -16)
    cur_index=-1
    sse_rm(0xF3  0x6F  0  RAX  0)
    sse_rm(0xF3  0x6F  1  RCX  0)
    sse_rr(0x66  0x74  0  1)
    sse_rr(0x66  0xD7  mask  0)
    rex(false  0  0  mask  false)
    b(0x81)
    modrr(7  mask)
    b32(65535)
    results.push(jmp32())
    patch_here(short)
    # Head/tail words cover every short size without reading padding. The
    # overlapping bytes are harmless, including equal head and tail addresses.
    loop width in [8  4  2] {
        cmp_branch_pad(10)
        b24(0xFA8348)
        b(width)
        let smaller=jcc32(12)
        load_sized(mask  RAX  0  width  false)
        cmp_branch_pad(10)
        if width =? 2 {b(0x66)}
        op_rm(0x3B  width =? 8  mask  RCX  0)
        unequal.push(jcc32(5))
        use_index(RDX  0)
        lea(RAX  RAX  -width)
        lea(RCX  RCX  -width)
        cur_index=-1
        load_sized(mask  RAX  0  width  false)
        load_sized(RAX  RCX  0  width  false)
        op_rr(0x39  true  mask  RAX)
        results.push(jmp32())
        patch_here(smaller)
    }
    load_sized(RDX  RAX  0  1  false)
    load_sized(RAX  RCX  0  1  false)
    op_rr(0x39  true  RDX  RAX)
    if strings {
        results.push(jmp32())
        patch_here(nil_left)
        rex(true  0  0  RCX  false)
        b(0x83)
        mem(7  RCX  8)
        b(0) # cmp qword [b+8], 0
        results.push(jmp32())
        patch_here(nil_right)
        rex(true  0  0  RAX  false)
        b(0x83)
        mem(7  RAX  8)
        b(0)
    }
    loop fix in results {patch_here(fix)}
    if flags {
        # All nonempty exits already have ZF = equality. Empty (including the
        # portable negative-count case) must establish true before the join.
        let done=jmp32()
        patch_here(empty)
        if strings {patch_here(same)}
        if not saved {cmp_branch_pad(9)}
        op_rr(0x39  true  RAX  RAX)
        patch_here(done)
        loop fix in unequal {patch_here(fix)}
        if saved {
            b16(0x5B41)
            rsp_adjust(-8)
        }
        x_loop_depth=enclosing_depth
        return
    }
    setcc(4)
    let done_result=jmp32()
    loop fix in unequal {patch_here(fix)}
    mov_imm(RAX  0)
    let done_false=jmp32()
    patch_here(empty)
    if strings {patch_here(same)}
    mov_imm(RAX  1)
    patch_here(done_result)
    patch_here(done_false)
    if saved {
        b16(0x5B41) # pop r11
        rsp_adjust(-8)
    }
    st(d  RAX)
    x_loop_depth=enclosing_depth
}

# Dynamic byte search. Only scratch rax/rcx/rdx, xmm0/xmm1 and the destination
# are clobbered. Unaligned vector reads stay inside the supplied span; the
# tail uses one bounded eight-byte load and 0..7 scalar reads, including
# spans ending at a guard page.
emit_findbyte=(d:XWord p:XWord n:XWord byte:XWord invert:bool):>void=>$unsafe {
    if vloc[d] =? LOC_NONE {return}
    let mask=dreg(d  R11)
    let saved=vloc[d] <? 0
    if saved {
        b16(0x5341)
        rsp_adjust(8)
    }
    ld(RCX  p)
    ld(RDX  n)
    ld(RAX  byte)
    sse_rr(0x66  0x6E  1  RAX) # movd xmm1, eax
    mov_imm(RAX  0) # offset from the original p
    cmp_branch_pad(10)
    b24(0xFA8348)
    b(8) # cmp rdx, 8
    let short=jcc32(CC_L)
    sse_rr(0x66  0x60  1  1) # replicate the low byte
    sse_rr(0x66  0x61  1  1)
    sse_rr(0x66  0x70  1  1)
    b(0)
    cmp_branch_pad(10)
    b24(0xFA8348)
    b(16)
    let word=jcc32(CC_L)
    nop_pad((16 - XWord(x_code[0].length) % 16) % 16)
    let top=XWord(x_code[0].length)
    sse_rm(0xF3  0x6F  0  RCX  0) # movdqu xmm0, [rcx]
    sse_rr(0x66  0x74  0  1) # pcmpeqb
    sse_rr(0x66  0xD7  mask  0) # pmovmskb
    if invert {
        rex(false  0  0  mask  false)
        b(0x81)
        modrr(6  mask)
        b32(65535)
    }
    cmp_branch_pad(9)
    op_rr(0x85  false  mask  mask)
    let found=jcc32(CC_NE)
    lea(RAX  RAX  16)
    lea(RCX  RCX  16)
    lea(RDX  RDX  -16)
    cmp_branch_pad(10)
    b24(0xFA8348)
    b(16)
    patch_branch(jcc32(CC_GE)  top)
    cmp_branch_pad(10)
    b24(0xFA8348)
    b(8)
    let tail_short=jcc32(CC_L)
    patch_here(word)
    sse_rm(0xF3  0x7E  0  RCX  0) # movq: only eight bytes are readable
    sse_rr(0x66  0x74  0  1)
    sse_rr(0x66  0xD7  mask  0)
    if invert {
        rex(false  0  0  mask  false)
        b(0x81)
        modrr(6  mask)
        b32(255)
    }
    # movq zeroes the upper lanes. Ignore them, also when searching for NUL.
    rex(false  0  0  mask  false)
    b(0x81)
    modrr(4  mask)
    b32(255)
    let found_word=jcc32(CC_NE)
    lea(RAX  RAX  8)
    lea(RCX  RCX  8)
    lea(RDX  RDX  -8)
    patch_here(short)
    patch_here(tail_short)
    op_rr(0x01  true  RAX  RDX) # end offset = offset + remainder
    sse_rr(0x66  0x7E  1  mask) # movd mask32, xmm1 (the byte)
    let tail=XWord(x_code[0].length)
    cmp_branch_pad(9)
    op_rr(0x39  true  RDX  RAX)
    let absent=jcc32(CC_GE)
    cmp_branch_pad(9)
    rex(false  mask  0  RCX  true)
    b(0x38)
    mem(mask  RCX  0) # cmp byte [rcx], mask8
    let equal=jcc32(if invert {CC_NE} else {CC_E})
    lea(RAX  RAX  1)
    lea(RCX  RCX  1)
    jmp_back(tail)
    patch_here(found)
    patch_here(found_word)
    rex(false  mask  0  mask  false)
    b16(0xBC0F)
    modrr(mask  mask) # bsf (the mask is nonzero)
    op_rr(0x01  true  mask  RAX)
    let done=jmp32()
    patch_here(absent)
    mov_imm(RAX  -1)
    patch_here(equal)
    patch_here(done)
    if saved {
        b16(0x5B41)
        rsp_adjust(-8)
    }
    st(d  RAX)
}

# The first k in [i, n) whose byte p[k] is one of four (set: packed, low byte first), or n:
# sixteen bytes at a time (pcmpeqb against each, pmovmskb, bsf), then byte by byte. With bit 32
# of set, byte 0 (a line end) counts only before a line indented by at most w columns (bits
# 33..39: w; w = 0 also takes a tab for indentation): compiler/scan.jo's search for the next line
# that is not part of a body. Allocation treats it as a call (backend_call_like): it uses rax, rcx, rdx,
# xmm0-xmm9 and its destination.
emit_findb=(d:XWord p:XWord i:XWord n:XWord set0:XWord):>void=>$unsafe {
    if vloc[d] =? LOC_NONE {return}
    let lines=set0 & (XWord(1) << 32) not=? 0
    let w=(set0 >> 33) & 127
    let set=set0 & 0xFFFFFFFF
    let merged=set =? 0x2723220A
    let single=not lines and(set & 255) * 0x01010101 =? set
    let mask=dreg(d  R11)
    let saved=vloc[d] <? 0
    if saved {
        b16(0x5341) # push r11 (spilled destination)
        rsp_adjust(8)
    }
    ld(RAX  i)
    ld(RCX  p)
    ld(RDX  n)
    op_rr(0x01  true  RAX  RCX) # add rcx, rax: the address of byte k
    # (w = 0: a line end counts unless a byte above space follows it, so blank lines do not;
    # '"' and '#' are one compare (their bytes differ only in bit 0))
    let plain=lines and w =? 0
    mov_imm(mask  if merged {0xFE27220A} else {set})
    sse_rr(0x66  0x6E  2  mask) # movd xmm2, mask
    if not single {
        sse_rr(0x66  0x60  2  2) # punpcklbw: each byte twice
        sse_rr(0x66  0x61  2  2) # punpcklwd: four times
    }
    loop k in [0..(if single {1} else {4})) {
        sse_rr(0x66  0x70  4 + k  2) # pshufd xmm4+k, xmm2: byte k in all sixteen
        b(k * 0x55)
    }
    if plain {
        mov_imm(mask  0x20)
        sse_rr(0x66  0x6E  2  mask)
        sse_rr(0x66  0x60  2  2)
        sse_rr(0x66  0x61  2  2)
        sse_rr(0x66  0x70  8  2)
        b(0)
    }
    else if lines {
        mov_imm(mask  0x0920) # space, tab
        sse_rr(0x66  0x6E  2  mask)
        sse_rr(0x66  0x60  2  2)
        sse_rr(0x66  0x61  2  2)
        sse_rr(0x66  0x70  8  2)
        b(0)
        sse_rr(0x66  0x70  9  2)
        b(0x55)
    }
    nop_pad((16 - XWord(x_code[0].length) % 16) % 16)
    let top=XWord(x_code[0].length)
    lea(mask  RAX  if lines {17 + w} else {16})
    op_rr(0x39  true  RDX  mask) # cmp mask, rdx
    let tail=jcc32(CC_G)
    sse_rm(0xF3  0x6F  0  RCX  0) # movdqu xmm0, [rcx]
    if single {
        sse_rr(0x66  0x74  0  4) # one byte class, one comparison
    }
    else {
        sse_rr(0x66  0x6F  1  0)
        sse_rr(0x66  0x74  1  4)
    }
    if plain {
        sse_rm(0xF3  0x6F  3  RCX  1) # movdqu xmm3, [rcx + 1]
        sse_rr(0x66  0x6F  2  3)
        sse_rr(0x66  0xDA  2  8) # pminub xmm2, xmm8
        sse_rr(0x66  0x74  2  3) # (the byte after is at most a space)
        sse_rr(0x66  0xDF  2  1) # pandn: line ends before others
        sse_rr(0x66  0x6F  1  0)
        sse_rr(0x66  0xDB  1  7) # pand xmm1, 0xFE
        sse_rr(0x66  0x74  1  5) # '"' or '#'
        sse_rr(0x66  0xEB  2  1)
        sse_rr(0x66  0x74  0  6) # '\''
        sse_rr(0x66  0xEB  0  2)
    }
    else if lines {
        # xmm3: the w + 1 bytes after each are indentation (spaces; at w = 0 a tab too)
        sse_rm(0xF3  0x6F  3  RCX  1) # movdqu xmm3, [rcx + 1]
        if w =? 0 {
            sse_rr(0x66  0x6F  2  3)
            sse_rr(0x66  0x74  2  9)
        }
        sse_rr(0x66  0x74  3  8)
        if w =? 0 {sse_rr(0x66  0xEB  3  2)} # por
        loop off in [2..w + 2) {
            sse_rm(0xF3  0x6F  2  RCX  off)
            sse_rr(0x66  0x74  2  8)
            sse_rr(0x66  0xDB  3  2) # pand
        }
        sse_rr(0x66  0xDF  3  1) # pandn: line ends before others
        sse_rr(0x66  0x6F  1  3)
    }
    if not plain and merged {
        sse_rr(0x66  0x6F  3  0)
        sse_rr(0x66  0xDB  3  7) # merge double quote and comment marker
        sse_rr(0x66  0x74  3  5)
        sse_rr(0x66  0xEB  1  3)
        sse_rr(0x66  0x74  0  6) # single quote
        sse_rr(0x66  0xEB  0  1)
    }
    else if not plain and not single {
        loop k in [1..3) {
            sse_rr(0x66  0x6F  3  0)
            sse_rr(0x66  0x74  3  4 + k)
            sse_rr(0x66  0xEB  1  3) # por xmm1, xmm3
        }
        sse_rr(0x66  0x74  0  7)
        sse_rr(0x66  0xEB  0  1)
    }
    sse_rr(0x66  0xD7  mask  0) # pmovmskb mask, xmm0
    op_rr(0x85  false  mask  mask) # test
    let found=jcc32(CC_NE)
    lea(RAX  RAX  16)
    lea(RCX  RCX  16)
    jmp_back(top)
    patch_here(found)
    rex(false  mask  0  mask  false)
    b16(0xBC0F)
    modrr(mask  mask) # bsf mask, mask
    op_rr(0x01  true  mask  RAX) # add rax, mask
    let done=jmp32()
    patch_here(tail)
    let bytes_top=XWord(x_code[0].length)
    op_rr(0x39  true  RDX  RAX) # cmp rax, rdx
    let ends:array<int64>=[]
    let at_end=jcc32(CC_GE)
    load_sized(mask  RCX  0  1  false)
    let first:XWord=0
    let skips:array<int64>=[]
    if lines {
        # a line end: found unless the w + 1 bytes after it are there and indentation
        first=1
        rex(false  0  0  mask  false)
        b(0x83)
        modrr(7  mask)
        b(set & 255)
        let other=jcc32(CC_NE)
        lea(mask  RAX  w + 1)
        op_rr(0x39  true  RDX  mask)
        ends.push(jcc32(CC_GE)) # (fewer bytes left)
        let found_here:array<int64>=[]
        loop off in [1..w + 2) {
            load_sized(mask  RCX  off  1  false)
            rex(false  0  0  mask  false)
            b(0x83)
            modrr(7  mask)
            b(0x20)
            if w =? 0 {found_here.push(jcc32(CC_A))}
            else {found_here.push(jcc32(CC_NE))}
        }
        skips.push(jmp32()) # indented: not one
        loop f in found_here {ends.push(f)}
        patch_here(other)
        load_sized(mask  RCX  0  1  false)
    }
    loop k in [first..(if single {1} else {4})) {
        rex(false  0  0  mask  false)
        b(0x83)
        modrr(7  mask)
        b((set >> (8 * k)) & 255) # cmp mask, byte k
        ends.push(jcc32(CC_E))
    }
    loop sk in skips {patch_here(sk)}
    lea(RAX  RAX  1)
    lea(RCX  RCX  1)
    jmp_back(bytes_top)
    patch_here(at_end)
    mov_rr(RAX  RDX) # (n, also when i was past it)
    loop e in ends {patch_here(e)}
    patch_here(done)
    if saved {
        b16(0x5B41) # pop r11
        rsp_adjust(-8)
    }
    st(d  RAX)
}

# fused compare + branch: next instruction consumes the flag
let fused_cc:XWord=-1
let fuse_skip:XWord=-1 # an instruction folded into the branch after it
let sel_fused:XWord=-1 # adjacent integer comparison consumed by select
let sel_ca:XWord=0
let sel_cb:XWord=0
let sel_cc:XWord=0

# The final IR is immutable through selection. Borrow its instruction records
# and dispatch to case-local encoders, avoiding a giant per-operation frame.
emit_ins=(pos:XWord ins:ptr<Ins>):>void=>$unsafe {
    if pos =? cmp_reload_at {
        let original=cmp_reload
        cmp_reload=-1
        cmp_reload_at=-1
        emit_ins(pos  xe_instructions + original)
    }
    let op=ins[0].op
    if pos =? fuse_skip {return}
    if x_has_narrow32 and x_emit_narrow32(pos  ins) {return}
    if x_has_overflow_pair and x_emit_overflow_pair(pos  ins) {return}
    match op {
        <'nop' | 'assume'> => {}
        <'iconst'> => {x_emit_iconst(pos  ins)}
        <'fconst'> => {x_emit_fconst(pos  ins)}
        <'mov'> => {x_emit_mov(pos  ins)}
        <'overflow_add' | 'overflow_sub' | 'overflow_mul'> => {x_emit_overflow_add(pos  ins)}
        <'checked_add' | 'checked_sub' | 'checked_mul'> => {x_emit_checked_add(pos  ins)}
        <'add'> => {x_emit_add(pos  ins)}
        <'sub'> => {x_emit_sub(pos  ins)}
        <'and_'> => {x_emit_and_(pos  ins)}
        <'or_'> => {x_emit_or_(pos  ins)}
        <'xor'> => {x_emit_xor(pos  ins)}
        <'mul'> => {x_emit_mul(pos  ins)}
        <'mulhs' | 'mulhu'> => {x_emit_mulhs(pos  ins)}
        <'divs' | 'rems' | 'divu' | 'remu'> => {x_emit_divs(pos  ins)}
        <'shl' | 'shrs' | 'shru' | 'rot32'> => {x_emit_shl(pos  ins)}
        <'neg' | 'not_'> => {x_emit_neg(pos  ins)}
        <'eq' | 'ne' | 'lts' | 'les' | 'gts' | 'ges' | 'ltu' | 'leu' | 'gtu' | 'geu'> => {x_emit_eq(pos  ins)}
        <'fadd'> => {x_emit_fadd(pos  ins)}
        <'fsub'> => {x_emit_fsub(pos  ins)}
        <'fmul'> => {x_emit_fmul(pos  ins)}
        <'fdiv'> => {x_emit_fdiv(pos  ins)}
        <'fmin'> => {x_emit_fmin(pos  ins)}
        <'fmax'> => {x_emit_fmax(pos  ins)}
        <'fsqrt'> => {x_emit_fsqrt(pos  ins)}
        <'ffloor' | 'fceil' | 'ftrunc'> => {x_emit_ffloor(pos  ins)}
        <'fneg' | 'fabs'> => {x_emit_fneg(pos  ins)}
        <'feq' | 'fne' | 'flt' | 'fle' | 'fgt' | 'fge'> => {x_emit_feq(pos  ins)}
        <'sext8' | 'sext16' | 'sext32' | 'zext8' | 'zext16' | 'zext32'> => {x_emit_sext8(pos  ins)}
        <'i2f'> => {x_emit_i2f(pos  ins)}
        <'u2f'> => {x_emit_u2f(pos  ins)}
        <'f2i'> => {x_emit_f2i(pos  ins)}
        <'f2f'> => {x_emit_f2f(pos  ins)}
        <'bits2f'> => {x_emit_bits2f(pos  ins)}
        <'f2bits'> => {x_emit_f2bits(pos  ins)}
        <'load'> => {x_emit_load(pos  ins)}
        <'store'> => {x_emit_store(pos  ins)}
        <'slot'> => {x_emit_slot(pos  ins)}
        <'gaddr' | 'daddr'> => {x_emit_gaddr(pos  ins)}
        <'faddr'> => {x_emit_faddr(pos  ins)}
        <'memeq' | 'streq'> => {x_emit_memeq(pos  ins)}
        <'findbyte'> => {emit_findbyte(XWord(ins[0].dst)  XWord(ins[0].a)  XWord(ins[0].b)  XWord(ins[0].c)  ins[0].imm not=? 0)}
        <'scanbytes'> => {emit_scanbytes(ins)}
        <'findb'> => {x_emit_findb(pos  ins)}
        <'copy'> => {x_emit_copy(pos  ins)}
        <'zero'> => {x_emit_zero(pos  ins)}
        <'vld'> => {x_emit_vld(pos  ins)}
        <'vst'> => {x_emit_vst(pos  ins)}
        <'vbin'> => {x_emit_vbin(pos  ins)}
        <'vsplat'> => {x_emit_vsplat(pos  ins)}
        <'vzu'> => {x_emit_vzu(pos  ins)}
        <'vop'> => {x_emit_vop(pos  ins)}
        <'memcpy'> => {x_emit_memcpy(pos  ins)}
        <'memset'> => {x_emit_memset(pos  ins)}
        <'zeroslots'> => {x_emit_zeroslots(pos  ins)}
        <'call'> => {x_emit_call(pos  ins)}
        <'calli' | 'callc'> => {x_emit_calli(pos  ins)}
        <'syscall'> => {x_emit_syscall(pos  ins)}
        <'intr'> => {x_emit_intr(pos  ins)}
        <'block'> => {x_emit_block(pos  ins)}
        <'loop'> => {x_emit_loop(pos  ins)}
        <'if_'> => {x_emit_if_(pos  ins)}
        <'else_'> => {x_emit_else_(pos  ins)}
        <'end'> => {x_emit_end(pos  ins)}
        <'br'> => {x_emit_br(pos  ins)}
        <'brif'> => {x_emit_brif(pos  ins)}
        <'brtable'> => {x_emit_brtable(pos  ins)}
        <'ret'> => {x_emit_ret(pos  ins)}
        <'trap'> => {x_emit_trap(pos  ins)}
        <'select'> => {x_emit_select(pos  ins)}
    }
}
x_emit_iconst=(pos:XWord ins:ptr<Ins>):>void=>$unsafe {
    let d=XWord(ins[0].dst)
    if vloc[d] =? LOC_CONST or vloc[d] =? LOC_NONE {return}
    let r=dreg(d  RAX)
    mov_imm(r  ins[0].imm)
    st(d  r)
}
x_emit_fconst=(pos:XWord ins:ptr<Ins>):>void=>$unsafe {
    let d=XWord(ins[0].dst)
    if vloc[d] =? LOC_NONE or vloc[d] =? LOC_FCONST {return}
    if vloc[d] >=? XMM {
        let x=vloc[d] - XMM
        if ins[0].imm =? 0 {xzero(x)}
        else {
            # float constants live in read-only data: one load, no integer register
            rip_kind=0
            sse_rm(fpre(XWord(ins[0].ty))  0x10  x  RIPREL  ro_const(ins[0].imm))
        }
        return
    }
    mov_imm(RAX  ins[0].imm)
    st(d  RAX)
}
x_emit_mov=(pos:XWord ins:ptr<Ins>):>void=>$unsafe {
    let d=XWord(ins[0].dst)
    let a=XWord(ins[0].a)
    if vloc[d] =? LOC_NONE {return}
    if xe_vtype(d) =? VI {
        let r=dreg(d  RAX)
        ld(r  a)
        st(d  r)
    }
    else {
        let x=xdreg(d  0)
        lds(x  a  xe_vtype(d))
        sts(d  x  xe_vtype(d))
    }
}

# Three-operand IMUL reads the original register or spill directly. Its
# flags are identical to copying that source and multiplying in place.
x_mul_immediate=(r:XWord a:XWord value:XWord):>void=>$unsafe {
    if vloc[a] =? LOC_SPILL {
        rex(true  r  0  RBP  false)
        b(0x69)
        mem(r  RBP  xe_spill[a])
    }
    else {
        let source=reg_of(a  RAX)
        rex(true  r  0  source  false)
        b(0x69)
        modrr(r  source)
    }
    b32(value)
}

# Adjacent value/overflow operations with the same inputs share one flag-
# producing instruction when the flag's only consumer is the following branch.
x_emit_overflow_pair=(pos:XWord ins:ptr<Ins>):>bool=>$unsafe {
    let op=ins[0].op
    if op not=? 'add' and op not=? 'sub' and op not=? 'mul' or pos + 2 >=? xe_ncode {return false}
    let flag=xe_instructions[pos + 1]
    let expected=if op =? 'add' {Op.overflow_add} else {if op =? 'sub' {Op.overflow_sub} else {Op.overflow_mul}}
    if flag.op not=? expected or flag.a not=? ins[0].a or flag.b not=? ins[0].b {return false}
    let branch=xe_instructions[pos + 2]
    if(branch.op not=? 'if_' and branch.op not=? 'brif') or branch.a not=? flag.dst or v_live[XWord(flag.dst)].nuse not=? 1 {return false}
    let d=XWord(ins[0].dst)
    let a=XWord(ins[0].a)
    let bb=XWord(ins[0].b)
    # The overflow operation reads the original operands. A value that
    # redefines one of them is not the same operation and cannot be fused.
    if d =? a or d =? bb {return false}
    let r=dreg(d  RAX)
    if vloc[bb] =? r and r not=? vloc[a] {r=RAX}
    if op =? 'mul' and vloc[bb] =? LOC_CONST and vcval[bb] >=? - 2147483648 and vcval[bb] <=? 2147483647 {
        x_mul_immediate(r  a  vcval[bb])
    }
    else {
        ld(r  a)
        if op =? 'add' {alu_v(0x01  0  r  bb)}
        else if op =? 'sub' {alu_v(0x29  5  r  bb)}
        else {
            let rb=reg_of(bb  RCX)
            rex(true  r  0  rb  false)
            b(0x0F)
            b(0xAF)
            modrr(r  rb)
        }
    }
    st(d  r)
    fused_cc=0
    fuse_skip=pos + 1
    true
}
x_emit_overflow_add=(pos:XWord ins:ptr<Ins>):>void=>$unsafe {
    let op=ins[0].op
    let d=XWord(ins[0].dst)
    let a=XWord(ins[0].a)
    let bb=XWord(ins[0].b)
    ld(RAX  a)
    if op =? 'overflow_add' {alu_v(0x01  0  RAX  bb)}
    else if op =? 'overflow_sub' {alu_v(0x29  5  RAX  bb)}
    else {
        let rb=reg_of(bb  RCX)
        rex(true  RAX  0  rb  false)
        b(0x0F)
        b(0xAF)
        modrr(RAX  rb)
    }
    setcc(0) # OF from the tagged-word operation
    st(d  RAX)
}

# Fuse a word operation with its sole adjacent unsigned-32 storage boundary.
# x86 writes to r32 already clear the upper half. Keep the IR's word semantics
# for every other use; only this one-use pair is emitted as a 32-bit operation.
x_emit_narrow32=(pos:XWord ins:ptr<Ins>):>bool=>$unsafe {
    let op=ins[0].op
    if op not=? 'add' and op not=? 'sub' and op not=? 'mul' and op not=? 'and_' and op not=? 'or_' and op not=? 'xor' and op not=? 'shl' and op not=? 'neg' and op not=? 'not_' {return false}
    let d=XWord(ins[0].dst)
    if pos + 1 >=? xe_ncode or v_live[d].ndef not=? 1 or v_live[d].nuse not=? 1 {return false}
    let next=xe_instructions[pos + 1]
    if next.op not=? 'zext32' or next.a not=? ins[0].dst {return false}
    let a=XWord(ins[0].a)
    let bb=XWord(ins[0].b)
    if op =? 'shl' and(vloc[bb] not=? LOC_CONST or vcval[bb] <? 0 or vcval[bb] >=? 32) {return false}
    let r=dreg(XWord(next.dst)  RAX)
    if op not=? 'neg' and op not=? 'not_' and vloc[bb] =? r and r not=? vloc[a] {r=RAX}
    ld(r  a)
    if op =? 'shl' {
        rex(false  0  0  r  false)
        b(0xC1)
        modrr(4  r)
        b(vcval[bb])
    }
    else if op =? 'neg' or op =? 'not_' {
        rex(false  0  0  r  false)
        b(0xF7)
        modrr((if op =? 'neg' {3} else {2})  r)
    }
    else if op =? 'mul' {
        if vloc[bb] =? LOC_CONST {
            rex(false  r  0  r  false)
            b(0x69)
            modrr(r  r)
            b32(vcval[bb])
        }
        else {
            let rb=reg_of(bb  RCX)
            rex(false  r  0  rb  false)
            b(0x0F)
            b(0xAF)
            modrr(r  rb)
        }
    }
    else {
        let opcode:XWord=if op =? 'add' {0x01} else {if op =? 'sub' {0x29} else {if op =? 'and_' {0x21} else {if op =? 'or_' {0x09} else {0x31}}}}
        let ext:XWord=if op =? 'add' {0} else {if op =? 'sub' {5} else {if op =? 'and_' {4} else {if op =? 'or_' {1} else {6}}}}
        let loc=vloc[bb]
        if loc >=? 0 and loc <? XMM {op_rr(opcode  false  loc  r)}
        else if loc =? LOC_CONST {
            let value=vcval[bb] << 32 >> 32
            rex(false  0  0  r  false)
            b(if value >=? - 128 and value <=? 127 {0x83} else {0x81})
            modrr(ext  r)
            if value >=? - 128 and value <=? 127 {b(value)}
            else {b32(value)}
        }
        else if loc =? LOC_SPILL {op_rm(opcode + 2  false  r  RBP  xe_spill[bb])}
        else {
            ld(RCX  bb)
            op_rr(opcode  false  RCX  r)
        }
    }
    st(XWord(next.dst)  r)
    fuse_skip=pos + 1
    true
}

# Native 32-bit flags decide a 32-bit store without widening and comparing.
# Signed results then extend to the IR's word; unsigned writes already zero it.
x_emit_checked32=(ins:ptr<Ins>):>void=>$unsafe {
    let op=ins[0].op
    let d=XWord(ins[0].dst)
    let a=XWord(ins[0].a)
    let bb=XWord(ins[0].b)
    let unsigned=XWord(ins[0].c) & 1 not=? 0
    let r=dreg(d  RAX)
    if op =? 'checked_mul' and unsigned {
        ld(RAX  a)
        let rb=reg_of(bb  RCX)
        rex(false  0  0  rb  false)
        b(0xF7)
        modrr(4  rb)
        r=RAX
    }
    else {
        if vloc[bb] =? r and r not=? vloc[a] {r=RAX}
        ld(r  a)
        if op =? 'checked_mul' {
            if vloc[bb] =? LOC_CONST {
                rex(false  r  0  r  false)
                b(0x69)
                modrr(r  r)
                b32(vcval[bb])
            }
            else {
                let rb=reg_of(bb  RCX)
                rex(false  r  0  rb  false)
                b(0x0F)
                b(0xAF)
                modrr(r  rb)
            }
        }
        else {
            let opcode:XWord=if op =? 'checked_add' {0x01} else {0x29}
            let ext:XWord=if op =? 'checked_add' {0} else {5}
            let loc=vloc[bb]
            if loc >=? 0 and loc <? XMM {op_rr(opcode  false  loc  r)}
            else if loc =? LOC_CONST {
                let value=vcval[bb] << 32 >> 32
                rex(false  0  0  r  false)
                b(if value >=? - 128 and value <=? 127 {0x83} else {0x81})
                modrr(ext  r)
                if value >=? - 128 and value <=? 127 {b(value)}
                else {b32(value)}
            }
            else if loc =? LOC_SPILL {op_rm(opcode + 2  false  r  RBP  xe_spill[bb])}
            else {op_rr(opcode  false  reg_of(bb  RCX)  r)}
        }
    }
    x_int_fail.push(jcc32(if unsigned {2} else {0}))
    x_int_fail_fn=XWord(ins[0].imm)
    if not unsigned {rex(true  r  0  r  false)
    b(0x63)
    modrr(r  r)}
    st(d  r)
}
x_emit_checked_add=(pos:XWord ins:ptr<Ins>):>void=>$unsafe {
    if XWord(ins[0].c) & 32 not=? 0 {x_emit_checked32(ins)
    return}
    let op=ins[0].op
    let d=XWord(ins[0].dst)
    let a=XWord(ins[0].a)
    let bb=XWord(ins[0].b)
    # No LEA/strength reduction: JO consumes OF, JC consumes unsigned carry.
    let cc:XWord=if ins[0].c not=? 0 {2} else {0}
    if op =? 'checked_mul' and ins[0].c not=? 0 {
        ld(RAX  a)
        let rb=reg_of(bb  RCX)
        rex(true  0  0  rb  false)
        b(0xF7)
        modrr(4  rb)
        x_int_fail.push(jcc32(2))
        x_int_fail_fn=XWord(ins[0].imm)
        st(d  RAX)
        return
    }
    let r=dreg(d  RAX)
    if op =? 'checked_sub' and vloc[a] =? LOC_CONST and vcval[a] =? 0 {
        ld(r  bb)
        rex(true  0  0  r  false)
        b(0xF7)
        modrr(3  r)
        x_int_fail.push(jcc32(cc))
        x_int_fail_fn=XWord(ins[0].imm)
        st(d  r)
        return
    }
    if vloc[bb] =? r and r not=? vloc[a] {r=RAX}
    if op =? 'checked_mul' and vloc[bb] =? LOC_CONST and vcval[bb] >=? - 2147483648 and vcval[bb] <=? 2147483647 {
        x_mul_immediate(r  a  vcval[bb])
    }
    else {
        ld(r  a)
        if op =? 'checked_add' {alu_v(0x01  0  r  bb)}
        else if op =? 'checked_sub' {alu_v(0x29  5  r  bb)}
        else {
            let rb=reg_of(bb  RCX)
            rex(true  r  0  rb  false)
            b(0x0F)
            b(0xAF)
            modrr(r  rb)
        }
    }
    x_int_fail.push(jcc32(cc))
    x_int_fail_fn=XWord(ins[0].imm)
    st(d  r)
}
x_emit_add=(pos:XWord ins:ptr<Ins>):>void=>$unsafe {
    let d=XWord(ins[0].dst)
    let a=XWord(ins[0].a)
    let bb=XWord(ins[0].b)
    if vloc[d] =? LOC_NONE or vloc[d] =? LOC_SLOT {return}
    if lea_add(d  a  bb  1) {return}
    int_bin(0x01  0  ins[0])
}
x_emit_sub=(pos:XWord ins:ptr<Ins>):>void=>$unsafe {
    let d=XWord(ins[0].dst)
    let a=XWord(ins[0].a)
    let bb=XWord(ins[0].b)
    if vloc[bb] =? LOC_CONST and lea_add(d  a  bb  -1) {return}
    int_bin(0x29  5  ins[0])
}

# A mask tested for zero needs flags, not an intermediate integer result.
# Selection inspects at most two successors; no per-function analysis is added.
x_test_ops=(a:XWord bb:XWord branch:bool):>void=>$unsafe {
    let left=a
    let right=bb
    if vloc[left] =? LOC_CONST or(vloc[right] =? LOC_SPILL and vloc[left] not=? LOC_SPILL) {
        left=bb
        right=a
    }
    let immediate=vloc[right] =? LOC_CONST and fits32(vcval[right])
    let memory=vloc[left] =? LOC_SPILL
    let r:XWord=0
    let base=RBP
    let disp:XWord=0
    if memory {disp=xe_spill[left]}
    else {base=reg_of(left  RAX)}
    if not immediate {r=reg_of(right  RCX)}
    if branch and ra_on {
        let span:XWord=3
        if memory {
            let actual=disp
            if rsp_frame {
                actual += frame_size + rsp_extra
                span += 1
            }
            if actual <? - 128 or actual >? 127 {span += 4}
            else {span += 1}
        }
        if immediate {span += 4}
        cmp_branch_pad(span + 6)
    }
    if immediate {
        rex(true  0  0  base  false)
        b(0xF7)
        if memory {mem(0  base  disp)}
        else {modrr(0  base)}
        b32(vcval[right])
    }
    else {
        if memory {op_rm(0x85  true  r  base  disp)}
        else {op_rr(0x85  true  r  base)}
    }
}
x_mask_test=(pos:XWord ins:ptr<Ins>):>bool=>$unsafe {
    let d=XWord(ins[0].dst)
    if xe_debug or pos + 1 >=? xe_ncode or v_live[d].ndef not=? 1 or v_live[d].nuse not=? 1 {return false}
    let next=xe_instructions + pos + 1
    if(next[0].op =? 'if_' or next[0].op =? 'brif') and XWord(next[0].a) =? d {
        x_branch_pos=pos + 1
        x_test_ops(XWord(ins[0].a)  XWord(ins[0].b)  true)
        x_branch_pos=-1
        fused_cc=CC_NE
        return true
    }
    if next[0].op not=? 'eq' and next[0].op not=? 'ne' {return false}
    let other:XWord=-1
    if XWord(next[0].a) =? d {other=XWord(next[0].b)}
    else if XWord(next[0].b) =? d {other=XWord(next[0].a)}
    if other <? 0 or vloc[other] not=? LOC_CONST or vcval[other] not=? 0 {return false}
    let result=XWord(next[0].dst)
    let branch=false
    if pos + 2 <? xe_ncode and v_live[result].nuse =? 1 {
        let consumer=xe_instructions + pos + 2
        branch=(consumer[0].op =? 'if_' or consumer[0].op =? 'brif') and XWord(consumer[0].a) =? result
    }
    if branch {x_branch_pos=pos + 2}
    x_test_ops(XWord(ins[0].a)  XWord(ins[0].b)  branch)
    x_branch_pos=-1
    let cc:XWord=if next[0].op =? 'eq' {CC_E} else {CC_NE}
    if branch {fused_cc=cc}
    else {
        let r=dreg(result  RAX)
        setcc_reg(cc  r)
        st(result  r)
    }
    fuse_skip=pos + 1
    true
}
x_emit_and_=(pos:XWord ins:ptr<Ins>):>void=>$unsafe {
    if x_mask_test(pos  ins) {return}
    int_bin(0x21  4  ins[0])
}
x_emit_or_=(pos:XWord ins:ptr<Ins>):>void=>$unsafe {
    int_bin(0x09  1  ins[0])
}
x_emit_xor=(pos:XWord ins:ptr<Ins>):>void=>$unsafe {
    int_bin(0x31  6  ins[0])
}
x_emit_mul=(pos:XWord ins:ptr<Ins>):>void=>$unsafe {
    let d=XWord(ins[0].dst)
    let a=XWord(ins[0].a)
    let bb=XWord(ins[0].b)
    if vloc[d] =? LOC_NONE {return}
    let r=dreg(d  RAX)
    if vloc[bb] =? r and r not=? vloc[a] {
        let temp=a
        a=bb
        bb=temp
    }
    let l=vloc[bb]
    if l =? LOC_CONST {
        let c=vcval[bb]
        if c =? 3 or c =? 5 or c =? 9 {
            # x + x * {2,4,8}, preserving the same low 64 bits.
            let scale:XWord=1
            if c =? 5 {scale=2}
            else if c =? 9 {scale=3}
            let base=reg_of(a  RAX)
            use_index(base  scale)
            lea(r  base  0)
            cur_index=-1
        }
        else {
            if vloc[a] =? LOC_SPILL {
                rex(true  r  0  RBP  false)
                b(0x69)
                mem(r  RBP  xe_spill[a])
            }
            else {
                let src=reg_of(a  RAX)
                rex(true  r  0  src  false)
                b(0x69)
                modrr(r  src)
            }
            b32(c)
        }
    }
    else {
        ld(r  a)
        let rb=reg_of(bb  RCX)
        rex(true  r  0  rb  false)
        b(0x0F)
        b(0xAF)
        modrr(r  rb)
    }
    st(d  r)
}
x_emit_mulhs=(pos:XWord ins:ptr<Ins>):>void=>$unsafe {
    let op=ins[0].op
    let d=XWord(ins[0].dst)
    let a=XWord(ins[0].a)
    let bb=XWord(ins[0].b)
    # (one-operand imul, or mul: rdx:rax = rax * b)
    ld(RAX  a)
    let rb=reg_of(bb  RCX)
    if rb =? RDX {
        mov_rr(RCX  RDX)
        rb=RCX
    }
    rex(true  0  0  rb  false)
    b(0xF7)
    if op =? 'mulhu' {modrr(4  rb)}
    else {modrr(5  rb)}
    st(d  RDX)
}
x_emit_divs=(pos:XWord ins:ptr<Ins>):>void=>$unsafe {
    let op=ins[0].op
    let d=XWord(ins[0].dst)
    let a=XWord(ins[0].a)
    let bb=XWord(ins[0].b)
    ld(RAX  a)
    let rb=reg_of(bb  RCX)
    if rb =? RDX {
        mov_rr(RCX  RDX)
        rb=RCX
    }
    if op =? 'divs' or op =? 'rems' {
        b(0x48)
        b(0x99) # cqo
    }
    else {
        b(0x31)
        b(0xD2) # xor edx, edx
    }
    rex(true  0  0  rb  false)
    b(0xF7)
    if op =? 'divs' or op =? 'rems' {modrr(7  rb)}
    else {modrr(6  rb)}
    if op =? 'rems' or op =? 'remu' {st(d  RDX)}
    else {st(d  RAX)}
}
x_emit_shl=(pos:XWord ins:ptr<Ins>):>void=>$unsafe {
    let op=ins[0].op
    let d=XWord(ins[0].dst)
    let a=XWord(ins[0].a)
    let bb=XWord(ins[0].b)
    if vloc[d] =? LOC_NONE {return}
    let ext:XWord=7
    if op =? 'rot32' {ext=0}
    else if op =? 'shl' {ext=4}
    else if op =? 'shru' {ext=5}
    if vloc[bb] =? LOC_CONST {
        let r=dreg(d  RAX)
        ld(r  a)
        rex(op not=? 'rot32'  0  0  r  false)
        b(0xC1)
        modrr(ext  r)
        b(vcval[bb] & 63)
        st(d  r)
        return
    }
    ld(RCX  bb)
    let r=dreg(d  RAX)
    if r =? RCX {r=RAX}
    ld(r  a)
    rex(op not=? 'rot32'  0  0  r  false)
    b(0xD3)
    modrr(ext  r)
    st(d  r)
}
x_emit_neg=(pos:XWord ins:ptr<Ins>):>void=>$unsafe {
    let op=ins[0].op
    let d=XWord(ins[0].dst)
    let a=XWord(ins[0].a)
    let r=dreg(d  RAX)
    ld(r  a)
    rex(true  0  0  r  false)
    b(0xF7)
    if op =? 'neg' {modrr(3  r)}
    else {modrr(2  r)}
    st(d  r)
}
x_compare_fused=(pos:XWord ins:ptr<Ins>):>bool=>$unsafe {
    let op=ins[0].op
    let d=XWord(ins[0].dst)
    let a=XWord(ins[0].a)
    let bb=XWord(ins[0].b)
    # fuse with a following if/brif that is the only user
    if pos + 1 <? xe_ncode and v_live[d].nuse =? 1 {
        let nx=xe_instructions[pos + 1]
        # Compare first at the select, then preserve its flags through
        # the operand moves.
        if nx.op =? 'select' and XWord(nx.a) =? d and is_icmp(op) and XWord(nx.b) not=? d and XWord(nx.c) not=? d {
            sel_fused=pos + 1
            sel_ca=a
            sel_cb=bb
            sel_cc=icc(op)
            return true
        }
        if(nx.op =? 'if_' or nx.op =? 'brif') and XWord(nx.a) =? d {
            if is_icmp(op) {
                x_branch_pos=pos + 1
                cmp_ops(a  bb  true)
                x_branch_pos=-1
                fused_cc=icc(op)
            }
            else {fused_cc=fcmp_flags(ins[0])}
            return true
        }
        # A comparison tested for false (c == 0): branch on opposite flags.
        if(is_icmp(op) or is_fcmp(op)) and nx.op =? 'eq' and XWord(nx.a) =? d and vloc[XWord(nx.b)] =? LOC_CONST and vcval[XWord(nx.b)] =? 0 and pos + 2 <? xe_ncode {
            let t=XWord(nx.dst)
            let n2=xe_instructions[pos + 2]
            if v_live[t].nuse =? 1 and(n2.op =? 'if_' or n2.op =? 'brif') and XWord(n2.a) =? t {
                let cc:XWord=0
                if is_icmp(op) {
                    x_branch_pos=pos + 2
                    cmp_ops(a  bb  true)
                    x_branch_pos=-1
                    cc=icc(op)
                }
                else {cc=fcmp_flags(ins[0])}
                if cc =? 100 {cc=101}
                else if cc =? 101 {cc=100}
                else {cc=cc xor 1}
                fused_cc=cc
                fuse_skip=pos + 1
                return true
            }
        }
    }
    false
}
x_emit_eq=(pos:XWord ins:ptr<Ins>):>void=>$unsafe {
    if x_compare_fused(pos  ins) {return}
    let op=ins[0].op
    let d=XWord(ins[0].dst)
    let a=XWord(ins[0].a)
    let bb=XWord(ins[0].b)
    cmp_ops(a  bb)
    let r=dreg(d  RAX)
    setcc_reg(icc(op)  r)
    st(d  r)
}
x_emit_fadd=(pos:XWord ins:ptr<Ins>):>void=>$unsafe {
    falu(0x58  ins[0])
}
x_emit_fsub=(pos:XWord ins:ptr<Ins>):>void=>$unsafe {
    falu(0x5C  ins[0])
}
x_emit_fmul=(pos:XWord ins:ptr<Ins>):>void=>$unsafe {
    falu(0x59  ins[0])
}
x_emit_fdiv=(pos:XWord ins:ptr<Ins>):>void=>$unsafe {
    falu(0x5E  ins[0])
}
x_emit_fmin=(pos:XWord ins:ptr<Ins>):>void=>$unsafe {
    falu(0x5D  ins[0])
}
x_emit_fmax=(pos:XWord ins:ptr<Ins>):>void=>$unsafe {
    falu(0x5F  ins[0])
}
x_emit_fsqrt=(pos:XWord ins:ptr<Ins>):>void=>$unsafe {
    x_unary(fpre(XWord(ins[0].ty))  0x51  ins[0]  XWord(ins[0].ty)  XWord(ins[0].ty))
}
x_emit_ffloor=(pos:XWord ins:ptr<Ins>):>void=>$unsafe {
    let op=ins[0].op
    let d=XWord(ins[0].dst)
    let a=XWord(ins[0].a)
    let ty=XWord(ins[0].ty)
    let mode:XWord=1
    if op =? 'fceil' {mode=2}
    if op =? 'ftrunc' {mode=3}
    let x=xdreg(d  0)
    let xa=xreg_of(a  1  ty)
    b(0x66)
    rex(false  x  0  xa  false)
    b(0x0F)
    b(0x3A)
    if ty =? VS {b(0x0A)}
    else {b(0x0B)}
    modrr(x  xa)
    b(mode)
    sts(d  x  ty)
}
x_emit_fneg=(pos:XWord ins:ptr<Ins>):>void=>$unsafe {
    let op=ins[0].op
    let d=XWord(ins[0].dst)
    let a=XWord(ins[0].a)
    let ty=XWord(ins[0].ty)
    let xa=xreg_of(a  0  ty)
    movq_rx(RAX  xa)
    let bit:XWord=63
    if ty =? VS {bit=31}
    rex(true  0  0  RAX  false)
    b(0x0F)
    b(0xBA)
    if op =? 'fneg' {modrr(7  RAX)}
    else {modrr(6  RAX)}
    b(bit)
    let x=xdreg(d  0)
    movq_xr(x  RAX)
    sts(d  x  ty)
}
x_emit_feq=(pos:XWord ins:ptr<Ins>):>void=>$unsafe {
    if x_compare_fused(pos  ins) {return}
    let d=XWord(ins[0].dst)
    let cc=fcmp_flags(ins[0])
    if cc =? 100 {
        b24(0xC0940F) # sete al
        b24(0xC19B0F) # setnp cl
        b16(0xC820) # and al, cl
        b24(0xC0B60F)
    }
    else if cc =? 101 {
        b24(0xC0950F) # setne al
        b24(0xC19A0F) # setp cl
        b16(0xC808) # or al, cl
        b24(0xC0B60F)
    }
    else {setcc(cc)}
    st(d  RAX)
}
x_emit_sext8=(pos:XWord ins:ptr<Ins>):>void=>$unsafe {
    let op=ins[0].op
    let d=XWord(ins[0].dst)
    let a=XWord(ins[0].a)
    let r=dreg(d  RAX)
    if vloc[a] =? LOC_SPILL {
        if op =? 'sext32' {op_rm(0x63  true  r  RBP  xe_spill[a])}
        else if op =? 'zext32' {op_rm(0x8B  false  r  RBP  xe_spill[a])}
        else {
            let byte=op =? 'sext8' or op =? 'zext8'
            let signed=op =? 'sext8' or op =? 'sext16'
            rex(true  r  0  RBP  false)
            b(0x0F)
            if byte {
                if signed {b(0xBE)}
                else {b(0xB6)}
            }
            else {
                if signed {b(0xBF)}
                else {b(0xB7)}
            }
            mem(r  RBP  xe_spill[a])
        }
        st(d  r)
        return
    }
    let ra=reg_of(a  RAX)
    if op =? 'sext32' {op_rr(0x63  true  r  ra)} # movsxd r, ra32
    else if op =? 'zext32' {op_rr(0x8B  false  r  ra)} # mov r32, ra32
    else {
        let w=op =? 'sext8' or op =? 'zext8'
        let sg=op =? 'sext8' or op =? 'sext16'
        rex(true  r  0  ra  false)
        b(0x0F)
        if w {
            if sg {b(0xBE)}
            else {b(0xB6)}
        }
        else {
            if sg {b(0xBF)}
            else {b(0xB7)}
        }
        modrr(r  ra)
    }
    st(d  r)
}
x_emit_i2f=(pos:XWord ins:ptr<Ins>):>void=>$unsafe {
    let d=XWord(ins[0].dst)
    let a=XWord(ins[0].a)
    let ty=XWord(ins[0].ty)
    let ra=reg_of(a  RAX)
    let x=xdreg(d  0)
    xzero(x)
    b(fpre(ty))
    rex(true  x  0  ra  false)
    b(0x0F)
    b(0x2A)
    modrr(x  ra)
    sts(d  x  ty)
}
x_emit_u2f=(pos:XWord ins:ptr<Ins>):>void=>$unsafe {
    let d=XWord(ins[0].dst)
    let a=XWord(ins[0].a)
    let ty=XWord(ins[0].ty)
    ld(RAX  a)
    xzero(0)
    b24(0xC08548) # test rax, rax
    let j1=jcc32(0x8) # js
    b(fpre(ty))
    b24(0x2A0F48)
    b(0xC0) # cvtsi2sd xmm0, rax
    let j2=jmp32()
    patch_here(j1)
    mov_rr(RCX  RAX)
    b24(0xE9D148) # shr rcx, 1
    b24(0x01E083) # and eax, 1
    b24(0xC10948) # or rcx, rax
    b(fpre(ty))
    b24(0x2A0F48)
    b(0xC1) # cvtsi2sd xmm0, rcx
    b(fpre(ty))
    b24(0xC0580F) # addsd xmm0, xmm0
    patch_here(j2)
    sts(d  0  ty)
}
x_emit_f2i=(pos:XWord ins:ptr<Ins>):>void=>$unsafe {
    let d=XWord(ins[0].dst)
    let a=XWord(ins[0].a)
    # saturating, like wasm's trunc_sat: NaN -> 0, too large -> max, too small -> min
    let ty=XWord(ins[0].ty)
    let xa=xreg_of(a  0  ty)
    let r=dreg(d  RAX)
    b(fpre(ty))
    rex(true  r  0  xa  false)
    b(0x0F)
    b(0x2C)
    modrr(r  xa)
    # cvttsd2si gives INT64_MIN when out of range; `cmp r, 1` overflows only for that value
    rex(true  0  0  r  false)
    b(0x83)
    modrr(7  r)
    b(1)
    let done=jcc32(1) # jno
    if ty =? VS {sse_rr(0  0x2E  xa  xa)} # ucomiss
    else {sse_rr(0x66  0x2E  xa  xa)} # ucomisd
    let nan=jcc32(CC_P)
    sse_rr(0  0x57  XMM + 15  XMM + 15) # xorps xmm15, xmm15
    if ty =? VS {sse_rr(0  0x2E  xa  XMM + 15)}
    else {sse_rr(0x66  0x2E  xa  XMM + 15)}
    let neg=jcc32(CC_BE)
    mov_imm(r  0x7FFFFFFFFFFFFFFF)
    let done2=jmp32()
    patch_here(nan)
    op_rr(0x31  false  r  r) # xor r32, r32
    patch_here(done)
    patch_here(neg)
    patch_here(done2)
    st(d  r)
}
x_emit_f2f=(pos:XWord ins:ptr<Ins>):>void=>$unsafe {
    # ins.ty is the destination type
    if XWord(ins[0].ty) =? VF {x_unary(0xF3  0x5A  ins[0]  VS  VF)}
    else {x_unary(0xF2  0x5A  ins[0]  VF  VS)}
}
x_emit_bits2f=(pos:XWord ins:ptr<Ins>):>void=>$unsafe {
    let d=XWord(ins[0].dst)
    let a=XWord(ins[0].a)
    let ra=reg_of(a  RAX)
    let x=xdreg(d  0)
    movq_xr(x  ra)
    sts(d  x  XWord(ins[0].ty))
}
x_emit_f2bits=(pos:XWord ins:ptr<Ins>):>void=>$unsafe {
    let d=XWord(ins[0].dst)
    let a=XWord(ins[0].a)
    let ty=XWord(ins[0].ty)
    let xa=xreg_of(a  0  ty)
    let r=dreg(d  RAX)
    movq_rx(r  xa)
    if ty =? VS {op_rr(0x8B  false  r  r)} # zero upper half
    st(d  r)
}
x_emit_load=(pos:XWord ins:ptr<Ins>):>void=>$unsafe {
    let op=ins[0].op
    let d=XWord(ins[0].dst)
    let a=XWord(ins[0].a)
    if vloc[d] =? LOC_NONE {return}
    let mode=XWord(ins[0].c)
    let size=mode & 15
    if mode & M_FLOAT =? 0 and v_live[d].nuse <=? 2 and pos + 1 <? xe_ncode and can_cmp_load(ins[0]  xe_instructions[pos + 1]) {
        let failure=cmp_failure_use(pos  ins[0]  xe_instructions[pos + 1])
        if v_live[d].nuse =? 1 or failure {
            cmp_load=pos
            if failure {
                cmp_reload=pos
                cmp_reload_at=pos + 3
            }
            return
        }
    }
    if mode & M_FLOAT not=? 0 and v_live[d].nuse =? 1 and pos + 1 <? xe_ncode {
        # a float load used only as the second operand of the next arithmetic: that
        # instruction reads the memory itself
        let nx=xe_instructions[pos + 1]
        if is_falu(nx.op) and XWord(nx.b) =? d and XWord(nx.a) not=? d and XWord(nx.ty) =? xe_vtype(d) {
            fold_load=pos
            return
        }
    }
    let xe_pair6=addr_of(a  RCX)
    let base=xe_pair6[0]
    let disp=xe_pair6[1]
    disp += XWord(ins[0].imm)
    let ix:XWord=-1
    if mode & M_INDEX not=? 0 {
        let xe_pair7=indexed_base(base  disp  XWord(ins[0].imm))
        base=xe_pair7[0]
        disp=xe_pair7[1]
        ix=reg_of(XWord(ins[0].b)  RDX)
    }
    if mode & M_FLOAT not=? 0 {
        let x=xdreg(d  0)
        use_index(ix  xe_mem_scale(ins[0]))
        if size =? 4 {sse_rm(0xF3  0x10  x  base  disp)}
        else {sse_rm(0xF2  0x10  x  base  disp)}
        cur_index=-1
        sts(d  x  xe_vtype(d))
    }
    else {
        let r=dreg(d  RAX)
        use_index(ix  xe_mem_scale(ins[0]))
        load_sized(r  base  disp  size  mode & M_SIGNED not=? 0)
        cur_index=-1
        st(d  r)
    }
}
x_emit_store=(pos:XWord ins:ptr<Ins>):>void=>$unsafe {
    let a=XWord(ins[0].a)
    let bb=XWord(ins[0].b)
    let mode=XWord(ins[0].c)
    let size=mode & 15
    let xe_pair8=addr_of(a  RCX)
    let base=xe_pair8[0]
    let disp=xe_pair8[1]
    disp += XWord(ins[0].imm)
    let ix:XWord=-1
    if mode & M_INDEX not=? 0 {
        let xe_pair9=indexed_base(base  disp  XWord(ins[0].imm))
        base=xe_pair9[0]
        disp=xe_pair9[1]
        ix=reg_of(XWord(ins[0].dst)  RDX)
    }
    if xe_vtype(bb) not=? VI {
        let xb=xreg_of(bb  0  xe_vtype(bb))
        use_index(ix  xe_mem_scale(ins[0]))
        if size =? 4 {sse_rm(0xF3  0x11  xb  base  disp)}
        else {sse_rm(0xF2  0x11  xb  base  disp)}
    }
    else if vloc[bb] =? LOC_CONST and size >=? 4 and base not=? RIPREL {
        use_index(ix  xe_mem_scale(ins[0]))
        rex(size =? 8  0  0  base  false)
        b(0xC7)
        mem(0  base  disp)
        b32(vcval[bb])
    }
    else {
        let rb=reg_of(bb  RAX)
        use_index(ix  xe_mem_scale(ins[0]))
        store_sized(base  disp  rb  size)
    }
    cur_index=-1
}
x_emit_slot=(pos:XWord ins:ptr<Ins>):>void=>$unsafe {
    let d=XWord(ins[0].dst)
    let a=XWord(ins[0].a)
    if vloc[d] =? LOC_SLOT or vloc[d] =? LOC_NONE {return}
    let r=dreg(d  RAX)
    lea(r  RBP  xe_slots[a])
    st(d  r)
}
x_emit_gaddr=(pos:XWord ins:ptr<Ins>):>void=>$unsafe {
    let op=ins[0].op
    let d=XWord(ins[0].dst)
    if vloc[d] =? LOC_GLOBAL or vloc[d] =? LOC_NONE {return}
    let r=dreg(d  RAX)
    let kind:XWord=1
    if op =? 'daddr' {kind=0}
    rel_fixup_lea(r  kind  XWord(ins[0].imm))
    st(d  r)
}
x_emit_faddr=(pos:XWord ins:ptr<Ins>):>void=>$unsafe {
    let d=XWord(ins[0].dst)
    let r=dreg(d  RAX)
    rex(true  r  0  0  false)
    b(0x8D)
    b(((r & 7) << 3) | 5)
    b32(0)
    if xe_windows and xe_is_cabi(XWord(ins[0].imm)) {cabi_fix.push([XWord(x_code[0].length) - 4  XWord(ins[0].imm)])}
    else {call_fix.push([XWord(x_code[0].length) - 4  XWord(ins[0].imm)])}
    st(d  r)
}
x_emit_memeq=(pos:XWord ins:ptr<Ins>):>void=>$unsafe {
    let op=ins[0].op
    let d=XWord(ins[0].dst)
    let a=XWord(ins[0].a)
    let bb=XWord(ins[0].b)
    if pos + 1 <? xe_ncode and v_live[d].nuse =? 1 {
        let nx=xe_instructions[pos + 1]
        if(nx.op =? 'if_' or nx.op =? 'brif') and XWord(nx.a) =? d {
            emit_memeq(d  a  bb  XWord(ins[0].c)  true  op =? 'streq')
            fused_cc=4
            return
        }
        if nx.op =? 'eq' and XWord(nx.a) =? d and vloc[XWord(nx.b)] =? LOC_CONST and vcval[XWord(nx.b)] =? 0 and pos + 2 <? xe_ncode {
            let t=XWord(nx.dst)
            let n2=xe_instructions[pos + 2]
            if v_live[t].nuse =? 1 and(n2.op =? 'if_' or n2.op =? 'brif') and XWord(n2.a) =? t {
                emit_memeq(d  a  bb  XWord(ins[0].c)  true  op =? 'streq')
                fused_cc=5
                fuse_skip=pos + 1
                return
            }
        }
    }
    emit_memeq(d  a  bb  XWord(ins[0].c)  false  op =? 'streq')
}
x_emit_findb=(pos:XWord ins:ptr<Ins>):>void=>$unsafe {
    let d=XWord(ins[0].dst)
    let a=XWord(ins[0].a)
    let bb=XWord(ins[0].b)
    emit_findb(d  a  bb  XWord(ins[0].c)  XWord(ins[0].imm))
}
x_emit_copy=(pos:XWord ins:ptr<Ins>):>void=>$unsafe {
    let a=XWord(ins[0].a)
    let bb=XWord(ins[0].b)
    let size=XWord(ins[0].imm)
    if size <=? INLINE_COPY {
        let xe_pair10=addr_reg(a  RDX)
        let db=xe_pair10[0]
        let dd=xe_pair10[1]
        let xe_pair11=addr_reg(bb  RCX)
        let sb=xe_pair11[0]
        let sd=xe_pair11[1]
        let k:XWord=0
        loop k + 16 <=? size {
            sse_rm(0xF3  0x6F  XMM + 15  sb  sd + k) # movdqu
            sse_rm(0xF3  0x7F  XMM + 15  db  dd + k)
            k += 16
        }
        loop w in [8  4  2  1] {
            if k + w <=? size {
                load_sized(RAX  sb  sd + k  w  false)
                store_sized(db  dd + k  RAX  w)
                k += w
            }
        }
    }
    else {
        pm_count=0
        pmove(RDI  a)
        pmove(RSI  bb)
        emit_parallel()
        mov_imm(RCX  size)
        b16(0xA4F3) # rep movsb
    }
}
x_emit_zero=(pos:XWord ins:ptr<Ins>):>void=>$unsafe {
    let a=XWord(ins[0].a)
    let size=XWord(ins[0].imm)
    if size <=? INLINE_COPY {
        let xe_pair12=addr_reg(a  RDX)
        let db=xe_pair12[0]
        let dd=xe_pair12[1]
        b16(0xC031) # xor eax, eax
        let k:XWord=0
        if size >=? 16 {sse_rr(0x66  0xEF  XMM + 15  XMM + 15)} # pxor
        loop k + 16 <=? size {
            sse_rm(0xF3  0x7F  XMM + 15  db  dd + k)
            k += 16
        }
        loop w in [8  4  2  1] {
            if k + w <=? size {
                store_sized(db  dd + k  RAX  w)
                k += w
            }
        }
    }
    else {
        ld(RDI  a)
        mov_imm(RCX  size)
        b16(0xC031)
        b16(0xAAF3) # rep stosb
    }
}
x_emit_vld=(pos:XWord ins:ptr<Ins>):>void=>$unsafe {
    if XWord(ins[0].c) >> 8 not=? 0 {x_emit_record_load(ins)
    return}
    let d=XWord(ins[0].dst)
    let a=XWord(ins[0].a)
    let bb=XWord(ins[0].b)
    if vloc[d] =? LOC_NONE {return}
    let ty=XWord(ins[0].ty)
    let xe_pair13=addr_of(a  RCX)
    let base=xe_pair13[0]
    let disp=xe_pair13[1]
    disp += XWord(ins[0].imm)
    let xe_pair14=indexed_base(base  disp  XWord(ins[0].imm))
    base=xe_pair14[0]
    disp=xe_pair14[1]
    let ix=reg_of(bb  RDX)
    let x=xdreg(d  0)
    let sc:XWord=3
    if vec_esize(XWord(ins[0].c)) =? 4 {sc=2}
    use_index(ix  sc)
    vmov_rm(x  base  disp  ty)
    cur_index=-1
    sts(d  x  ty)
}
x_emit_vst=(pos:XWord ins:ptr<Ins>):>void=>$unsafe {
    let d=XWord(ins[0].dst)
    let a=XWord(ins[0].a)
    let bb=XWord(ins[0].b)
    let ty=XWord(ins[0].ty)
    let xe_pair15=addr_of(a  RCX)
    let base=xe_pair15[0]
    let disp=xe_pair15[1]
    disp += XWord(ins[0].imm)
    let xe_pair16=indexed_base(base  disp  XWord(ins[0].imm))
    base=xe_pair16[0]
    disp=xe_pair16[1]
    let ix=reg_of(d  RDX)
    let x=xreg_of(bb  0  ty)
    let sc:XWord=3
    if vec_esize(XWord(ins[0].c)) =? 4 {sc=2}
    use_index(ix  sc)
    vmov_mr(base  disp  x  ty)
    cur_index=-1
}
x_emit_vbin=(pos:XWord ins:ptr<Ins>):>void=>$unsafe {
    if ins[0].c >=? 12 and ins[0].c <=? 14 {x_emit_word_shift(ins)
    return}
    if ins[0].c =? 9 {x_emit_vector_sqrt(ins)
    return}
    if ins[0].c =? 10 or ins[0].c =? 11 {x_emit_ordered_fold(ins)
    return}
    let d=XWord(ins[0].dst)
    let a=XWord(ins[0].a)
    let bb=XWord(ins[0].b)
    if vloc[d] =? LOC_NONE {return}
    let ty=XWord(ins[0].ty)
    let vk=XWord(ins[0].imm)
    let vo=XWord(ins[0].c)
    let x=xdreg(d  0)
    let xa=xreg_of(a  1  ty)
    let xb=xreg_of(bb  15  ty)
    if vk =? 3 and(vo =? 4 or vo =? 5) {
        # Signed qword min/max, including opposite signs and extreme words.
        # Sources live outside the three reserved scratch registers; reload
        # them after making the mask before writing an overlapping destination.
        vmov_rr(1  xa  ty)
        vmov_rr(15  xb  ty)
        if ty =? VY {
            vex(0  1  15  2  1  0  1)
            b(0x37)
            modrr(0  15) # vpcmpgtq
        }
        else {
            # If the high dwords are equal, the sign of b-a is the unsigned
            # low-dword comparison. Otherwise compare the signed high dwords.
            vmov_rr(0  15  VX)
            sse_rr(0x66  0xFB  0  1) # psubq
            sse_rr(0x66  0x76  1  15) # pcmpeqd
            sse_rr(0x66  0x72  4  0)
            b(31) # psrad xmm0, 31
            sse_rr(0x66  0x70  0  0)
            b(0xF5)
            sse_rr(0x66  0x70  1  1)
            b(0xF5)
            vop2(6  3  0  1)
            vmov_rr(1  xreg_of(a  1  VX)  VX)
            sse_rr(0x66  0x66  1  15) # pcmpgtd
            sse_rr(0x66  0x70  1  1)
            b(0xF5)
            vop2(7  3  0  1)
        }
        vmov_rr(1  xreg_of((if vo =? 5 {a} else {bb})  1  ty)  ty)
        vmov_rr(15  xreg_of((if vo =? 5 {bb} else {a})  15  ty)  ty)
        if ty =? VY {
            vop3(6  3  1  1  0)
            vex(0  0  15  1  1  0  1)
            b(0xDF)
            modrr(0  15) # vpandn
            vop3(7  3  x  1  0)
        }
        else {
            vop2(6  3  1  0)
            sse_rr(0x66  0xDF  0  15) # pandn
            vop2(7  3  1  0)
            vmov_rr(x  1  VX)
        }
    }
    else if ty =? VY and vk =? 3 and vo =? 2 {
        # Low qword product: a0*b0 + ((a1*b0 + a0*b1) << 32).
        # AVX2's unsigned dword products give the same low 64 bits for signed
        # operands. Preserve both sources in reserved scratch registers before
        # touching a potentially overlapping destination.
        vmov_rr(1  xa  VY)
        vmov_rr(15  xb  VY)
        vex(2  0  1  1  1  0  1)
        b(0x73)
        modrr(2  1)
        b(32)
        vex(0  0  15  1  1  0  1)
        b(0xF4)
        modrr(0  15)
        vex(2  15  15  1  1  0  1)
        b(0x73)
        modrr(2  15)
        b(32)
        vex(15  15  1  1  1  0  1)
        b(0xF4)
        modrr(15  1)
        vop3(0  3  0  0  15)
        vex(6  0  0  1  1  0  1)
        b(0x73)
        modrr(6  0)
        b(32)
        xb=xreg_of(bb  15  VY)
        vex(1  1  xb  1  1  0  1)
        b(0xF4)
        modrr(1  xb)
        vop3(0  3  x  1  0)
    }
    else if ty =? VY {vop3(vo  vk  x  xa  xb)}
    else if x =? xb and x not=? xa {
        if vec_commutes(vo) {vop2(vo  vk  x  xa)}
        else {
            vmov_rr(1  xa  ty)
            vop2(vo  vk  1  xb)
            vmov_rr(x  1  ty)
        }
    }
    else {
        vmov_rr(x  xa  ty)
        vop2(vo  vk  x  xb)
    }
    sts(d  x  ty)
}
x_emit_vsplat=(pos:XWord ins:ptr<Ins>):>void=>$unsafe {
    let d=XWord(ins[0].dst)
    let a=XWord(ins[0].a)
    if vloc[d] =? LOC_NONE {return}
    let ty=XWord(ins[0].ty)
    let vk=XWord(ins[0].imm)
    let x=xdreg(d  0)
    if vk =? 0 or vk =? 1 {
        let sty=VF
        if vk =? 0 {sty=VS}
        let sx=xreg_of(a  1  sty)
        if ty =? VY {
            vex(x  0  sx  2  1  0  1)
            if vk =? 0 {b(0x18)} # vbroadcastss ymm, xmm
            else {b(0x19)} # vbroadcastsd ymm, xmm
            modrr(x  sx)
        }
        else {
            vmov_rr(x  sx  VX)
            if vk =? 0 {
                sse_rr(0  0xC6  x  x) # shufps x, x, 0
                b(0)
            }
            else {sse_rr(0x66  0x14  x  x)} # unpcklpd x, x
        }
    }
    else {
        let r=reg_of(a  RAX)
        let w:XWord=0
        if vk =? 3 {w=1}
        if ty =? VY {
            vex(x  0  r  1  1  w  0)
            b(0x6E) # vmovd / vmovq xmm, r
            modrr(x  r)
            vex(x  0  x  2  1  0  1)
            if vk =? 2 {b(0x58)} # vpbroadcastd ymm, xmm
            else {b(0x59)} # vpbroadcastq ymm, xmm
            modrr(x  x)
        }
        else {
            b(0x66)
            rex(vk =? 3  x  0  r  false)
            b16(0x6E0F) # movd / movq xmm, r
            modrr(x  r)
            if vk =? 2 {
                sse_rr(0x66  0x70  x  x) # pshufd x, x, 0
                b(0)
            }
            else {sse_rr(0x66  0x6C  x  x)} # punpcklqdq x, x
        }
    }
    sts(d  x  ty)
}
x_emit_vzu=(pos:XWord ins:ptr<Ins>):>void=>$unsafe {
    b24(0x77F8C5) # vzeroupper
}
x_emit_vop=(pos:XWord ins:ptr<Ins>):>void=>$unsafe {
    let a=XWord(ins[0].a)
    let bb=XWord(ins[0].b)
    # packed float vector arithmetic, memory to memory (xmm0, xmm1, xmm15 are scratch)
    let vector_code = XWord(ins[0].imm)
    let n=(vector_code >> 4) & 7
    vop_operand(0  bb  vector_code & VOP_SPLAT_B not=? 0  n  RCX)
    vop_operand(1  XWord(ins[0].c)  vector_code & VOP_SPLAT_C not=? 0  n  RAX)
    const ops:array<int64>=[0x58 0x5C 0x59 0x5E]
    sse_rr(0  ops[vector_code & 3]  0  1) # addps subps mulps divps
    let xe_pair17=addr_reg(a  RDX)
    let db=xe_pair17[0]
    let dd=xe_pair17[1]
    if n =? 4 {sse_rm(0  0x11  0  db  dd)} # movups
    else {
        sse_rm(0xF2  0x11  0  db  dd) # movsd: lanes 0-1
        if n =? 3 {
            sse_rr(0  0x12  15  0) # movhlps xmm15, xmm0
            sse_rm(0xF3  0x11  15  db  dd + 8) # movss: lane 2
        }
    }
}
x_emit_memcpy=(pos:XWord ins:ptr<Ins>):>void=>$unsafe {
    let a=XWord(ins[0].a)
    let bb=XWord(ins[0].b)
    pm_count=0
    pmove(RDI  a)
    pmove(RSI  bb)
    pmove(RCX  XWord(ins[0].c))
    emit_parallel()
    b16(0xA4F3)
}
x_emit_memset=(pos:XWord ins:ptr<Ins>):>void=>$unsafe {
    let a=XWord(ins[0].a)
    let bb=XWord(ins[0].b)
    pm_count=0
    pmove(RDI  a)
    pmove(RAX  bb)
    pmove(RCX  XWord(ins[0].c))
    emit_parallel()
    b16(0xAAF3)
}
x_emit_zeroslots=(pos:XWord ins:ptr<Ins>):>void=>$unsafe {
    let a=XWord(ins[0].a)
    let bb=XWord(ins[0].b)
    b16(0xC031)
    loop k in [0..bb) {
        let item=XWord(xe_arguments[a + k])
        if item & 1 =? 1 {
            let v=item >> 1
            if vloc[v] not=? LOC_NONE {st(v  RAX)}
        }
        else {
            let s=item >> 1
            let size=XWord(xe_sizes[s])
            let off=xe_slots[s]
            let j:XWord=0
            loop j <? size {
                mov_mr(RBP  off + j  RAX)
                j += 8
            }
        }
    }
}
x_emit_call=(pos:XWord ins:ptr<Ins>):>void=>$unsafe {
    let a=XWord(ins[0].a)
    let bb=XWord(ins[0].b)
    if ins[0].c =? CALL_IF_SHARED {
        # x itself, in rax, when it is 0 or its refcount is 1; else f(x) through a stub
        # that keeps every register (so this is no call to the register allocator)
        ld(RAX  XWord(xe_arguments[a]))
        b24(0xC08548) # test rax, rax
        b16(0x0074) # jz done
        let skip0=XWord(x_code[0].length) - 1
        b24(0x388348)
        b(1) # cmp qword [rax], 1
        b16(0x0074) # je done
        let skip1=XWord(x_code[0].length) - 1
        b24(0x0D8D48)
        b32(0) # lea rcx, [rip + f]
        call_fix.push([XWord(x_code[0].length) - 4  XWord(ins[0].imm)])
        b(0xE8)
        b32(0)
        stub_fix.push([XWord(x_code[0].length) - 4  12])
        call_site(ins[0])
        x_code[0][skip0] = uint8((XWord(x_code[0].length) - skip0 - 1) & 0xff)
        x_code[0][skip1] = uint8((XWord(x_code[0].length) - skip1 - 1) & 0xff)
    }
    else if ins[0].c =? CALL_RC_INC or ins[0].c =? CALL_RC_DEC {
        # inline: x's refcount one more, or one less while more than one is left; f(x)
        # through the stub keeping every register when threads run (atomically there) or
        # for the last reference (freeing)
        ld(RAX  XWord(xe_arguments[a]))
        b24(0xC08548) # test rax, rax
        b16(0x0074) # jz done
        let done0=XWord(x_code[0].length) - 1
        b24(0x388348) # cmp qword [rax], ...
        let slow0:XWord=-1
        let done1:XWord=-1
        if ins[0].c =? CALL_RC_INC {
            b(0) # ... 0
            b16(0x007E) # jle done (immortal)
            done1=XWord(x_code[0].length) - 1
        }
        else {
            b(1) # ... 1
            b16(0x007C) # jl done (immortal)
            done1=XWord(x_code[0].length) - 1
            b16(0x0074) # je slow (the last)
            slow0=XWord(x_code[0].length) - 1
        }
        rel_fixup_lea(RCX  1  xe_mt_active) # lea rcx, [rip + __mt_active]
        b24(0x003980) # cmp byte [rcx], 0
        b16(0x0075) # jne slow
        let slow1=XWord(x_code[0].length) - 1
        b16(0xFF48)
        if ins[0].c =? CALL_RC_INC {b(0x00)} # inc qword [rax]
        else {b(0x08)} # dec qword [rax]
        b16(0x00EB) # jmp done
        let done2=XWord(x_code[0].length) - 1
        if slow0 >=? 0 {x_code[0][slow0] = uint8((XWord(x_code[0].length) - slow0 - 1) & 0xff)}
        x_code[0][slow1] = uint8((XWord(x_code[0].length) - slow1 - 1) & 0xff)
        b24(0x0D8D48)
        b32(0) # lea rcx, [rip + f]
        call_fix.push([XWord(x_code[0].length) - 4  XWord(ins[0].imm)])
        b(0xE8)
        b32(0)
        stub_fix.push([XWord(x_code[0].length) - 4  12])
        call_site(ins[0])
        loop j in [done0  done1  done2] {x_code[0][j] = uint8((XWord(x_code[0].length) - j - 1) & 0xff)}
    }
    else {
        emit_call_args(a  bb  -1  0)
        b(0xE8)
        b32(0)
        call_fix.push([XWord(x_code[0].length) - 4  XWord(ins[0].imm)])
        call_site(ins[0])
        pop_call_stack()
    }
    store_result(ins[0])
}
x_emit_calli=(pos:XWord ins:ptr<Ins>):>void=>$unsafe {
    let op=ins[0].op
    let a=XWord(ins[0].a)
    let bb=XWord(ins[0].b)
    if op =? 'callc' and xe_windows {emit_call_args_win64(a  bb  XWord(ins[0].c)  R11)}
    else {
        emit_call_args(a  bb  XWord(ins[0].c)  R11)
        # System V variadic calls report their vector-register count
        # in al, including fixed floating parameters (at most eight).
        if op =? 'callc' and ins[0].imm >? 0 {
            let nvec:XWord=0
            loop k in [0..bb) {
                if xe_vtype(XWord(xe_arguments[a + k])) not=? VI {nvec += 1}
            }
            b(0xB8) # mov eax, nvec
            b32(min(nvec  8))
        }
    }
    b24(0xD3FF41) # call r11
    call_site(ins[0])
    pop_call_stack()
    store_result(ins[0])
}
x_emit_syscall=(pos:XWord ins:ptr<Ins>):>void=>$unsafe {
    let d=XWord(ins[0].dst)
    let a=XWord(ins[0].a)
    let bb=XWord(ins[0].b)
    pm_count=0
    loop k in [0..bb) {pmove(SYSCALL_REGS[k]  XWord(xe_arguments[a + k]))}
    emit_parallel()
    b16(0x050F)
    st(d  RAX)
}
x_emit_intr=(pos:XWord ins:ptr<Ins>):>void=>$unsafe {
    let d=XWord(ins[0].dst)
    let a=XWord(ins[0].a)
    let bb=XWord(ins[0].b)
    if ins[0].imm =? 1 {
        let r=dreg(d  RAX)
        rel_fixup_lea(r  1  0)
        mov_rm(r  r  0)
        st(d  r)
    }
    else if ins[0].imm =? 10 {
        # the function in entry c of the import address table, below the globals (pe.jo)
        let r=dreg(d  RAX)
        rel_fixup_lea(r  1  xe_iat_off(XWord(ins[0].c)))
        mov_rm(r  r  0)
        st(d  r)
    }
    else {
        # setjmp / longjmp / jump: arguments in rdi, rsi then a call to a machine-code stub
        emit_call_args(a  bb  -1  0)
        b(0xE8)
        b32(0)
        stub_fix.push([XWord(x_code[0].length) - 4  XWord(ins[0].imm)])
        pop_call_stack()
        if d >=? 0 and vloc[d] not=? LOC_NONE {st(d  RAX)}
    }
}
x_emit_block=(pos:XWord ins:ptr<Ins>):>void=>$unsafe {
    xctl.push(XCtl[0  XWord(x_code[0].length)  []  []])
}
x_emit_loop=(pos:XWord ins:ptr<Ins>):>void=>$unsafe {
    let a=XWord(ins[0].a)
    # Keep loop layout independent of the containing function's half-line.
    # Padding belongs before the target so the backedge never executes it.
    if ra_on {
        pad_moves=true # moving a function by 16 changes this entry pad
        let padding=(32 - XWord(x_code[0].length) % 32) % 32
        # A register conditional move immediately before the loop can absorb
        # two ignored CS prefixes. Check its complete four-byte encoding and
        # the last resolved entry before growing it; no relocation is moved.
        # This avoids an extra executed NOP for 15/16-byte entry gaps.
        if padding >=? 15 and padding <=? 16 and x_padding_cmov >=? x_padding_floor and XWord(x_code[0].length) =? x_padding_cmov + 4 {
            let at=XWord(x_code[0].length) - 4
            let p=x_code[0].ptr + at
            if p[0] & 0xF8 =? 0x48 and p[1] =? 0x0F and p[2] >=? 0x40 and p[2] <=? 0x4F and p[3] >=? 0xC0 {
                let word=(p as ptr<uint32>)[0]
                x_bytes(2);
                p=x_code[0].ptr + at
                p[0] = 0x2E
                p[1] = 0x2E
                let xe_store=((p + 2) as ptr<uint32>)
                xe_store[0]=word
                padding -= 2
            }
        }
        nop_pad(padding)
    }
    xctl.push(XCtl[1  XWord(x_code[0].length)  []  []])
    x_loop_depth += 1
}
x_emit_if_=(pos:XWord ins:ptr<Ins>):>void=>$unsafe {
    let a=XWord(ins[0].a)
    let fx:array<int64>=[]
    if fused_cc >=? 0 {
        let cc=fused_cc
        fused_cc=-1
        jfalse(cc  @fx)
    }
    else {
        let ra=reg_of(a  RAX)
        x_branch_pos=pos
        if x_loop_depth >? 0 {cmp_branch_pad(9)}
        x_branch_pos=-1
        rex(true  ra  0  ra  false)
        b(0x85)
        modrr(ra  ra) # test r, r
        fx.push(jcc32(CC_E))
    }
    xctl.push(XCtl[2  XWord(x_code[0].length)  []  fx])
}
x_emit_else_=(pos:XWord ins:ptr<Ins>):>void=>$unsafe {
    let c=XWord(xctl.length) - 1
    xctl[c].fixups.push(jmp32())
    loop f in xctl[c].ifx {patch_here(f)}
    xctl[c].ifx = []
}
x_emit_end=(pos:XWord ins:ptr<Ins>):>void=>$unsafe {
    let c=xctl.pop()
    if c.kind =? 1 {x_loop_depth -= 1}
    patch_control_end(c  pos)
}
x_emit_br=(pos:XWord ins:ptr<Ins>):>void=>$unsafe {
    branch_target_fix(XWord(ins[0].imm))
}
x_emit_brif=(pos:XWord ins:ptr<Ins>):>void=>$unsafe {
    let a=XWord(ins[0].a)
    if fused_cc >=? 0 {
        let cc=fused_cc
        fused_cc=-1
        if cc =? 100 {
            # equal and ordered: jump only when ZF=1 and PF=0
            let skip=jcc32(CC_P)
            branch_target_jcc(XWord(ins[0].imm)  CC_E)
            patch_here(skip)
        }
        else if cc =? 101 {
            branch_target_jcc(XWord(ins[0].imm)  CC_P)
            branch_target_jcc(XWord(ins[0].imm)  CC_NE)
        }
        else {branch_target_jcc(XWord(ins[0].imm)  cc)}
    }
    else {
        let ra=reg_of(a  RAX)
        rex(true  ra  0  ra  false)
        b(0x85)
        modrr(ra  ra)
        branch_target_jcc(XWord(ins[0].imm)  CC_NE)
    }
}
x_emit_brtable=(pos:XWord ins:ptr<Ins>):>void=>$unsafe {
    let a=XWord(ins[0].a)
    let bb=XWord(ins[0].b)
    # bounds check, then jump into a table of 5-byte jmp instructions
    ld(RAX  a)
    b16(0x8148)
    modrr(7  RAX)
    b32(bb) # cmp rax, n
    branch_target_jcc(XWord(ins[0].imm)  CC_AE)
    b24(0x0C8D48)
    b(0x80) # lea rcx, [rax + rax*4]
    b24(0x058D48)
    b32(5) # lea rax, [rip + 5]
    b24(0xC80148) # add rax, rcx
    b16(0xE0FF) # jmp rax
    loop k in [0..bb) {branch_target_fix(XWord(xe_arguments[XWord(ins[0].c) + k]))}
}
x_emit_ret=(pos:XWord ins:ptr<Ins>):>void=>$unsafe {
    let a=XWord(ins[0].a)
    if a >=? 0 {
        let ty=xe_vtype(a)
        if ty =? VI {ld(RAX  a)}
        else {lds(0  a  ty)}
    }
    emit_epilogue()
}
x_emit_trap=(pos:XWord ins:ptr<Ins>):>void=>$unsafe {
    b16(0x0B0F)
}
x_emit_select=(pos:XWord ins:ptr<Ins>):>void=>$unsafe {
    let d=XWord(ins[0].dst)
    let a=XWord(ins[0].a)
    let bb=XWord(ins[0].b)
    # d = a != 0 ? b : c (integers): rax = c; test a; cmovne rax, b
    let cc=CC_NE
    let rb:XWord=0
    let r:XWord=0
    if sel_fused =? pos {
        # (its compare first: what follows only moves, which keep the flags)
        sel_fused=-1
        if vloc[d] =? LOC_NONE {return}
        cmp_ops(sel_ca  sel_cb)
        cc=sel_cc
        rb=reg_of(bb  RDX)
        r=dreg(d  RAX)
        if r =? rb {r=RAX}
        ld(r  XWord(ins[0].c))
    }
    else {
        if vloc[d] =? LOC_NONE {return}
        rb=reg_of(bb  RDX)
        let rc=reg_of(a  RCX)
        r=dreg(d  RAX)
        if r =? rb or r =? rc {r=RAX}
        ld(r  XWord(ins[0].c))
        rex(true  rc  0  rc  false)
        b(0x85)
        modrr(rc  rc)
    }
    let at=XWord(x_code[0].length)
    rex(true  r  0  rb  false)
    b(0x0F)
    b(0x40 + cc)
    modrr(r  rb)
    st(d  r)
    x_padding_cmov=if XWord(x_code[0].length) =? at + 4 {at} else {-1}
}

# jumps taken when condition `cc` is false (fixup positions appended to fx)
jfalse=(cc:XWord @fx:array<int64>):>void=>$unsafe {
    if cc =? 100 {
        # not (ZF and !PF): jump if PF or !ZF
        fx.push(jcc32(CC_P))
        fx.push(jcc32(CC_NE))
        return
    }
    if cc =? 101 {
        # not (!ZF or PF): jump if ZF and !PF
        let skip=jcc32(CC_P)
        fx.push(jcc32(CC_E))
        patch_here(skip)
        return
    }
    fx.push(jcc32((cc xor 1)))
}

# (DEWY_RASTAT: what the allocation costs, as loads and stores of spilled values and of values
# saved around calls, each weighted by loop depth like v_weight)
let ra_stat=false
let ra_save_cost:XWord=0
let ra_save_x:XWord=0
let save_next:XWord=0 # (the caller-saved registers spilled around calls: see below)
let row_pos:XWord=-1 # (the line table: line_row)
let dbg_pos:array<int64>=[] # (while a function is emitted: where IR instruction pos starts)

# how each function's frame is made, for debuggers to find its caller's registers (.debug_frame):
# start, length, where its body starts (after the prologue), the callee-saved registers it keeps
# (count, then DWARF number and offset from the CFA each), and where its epilogues take the
# frame pointer back (count, then the offset after each: x86-64 pop rbp, arm64 ldp x29, x30)
let dbg_epis:array<int64>=[] # (while a function is emitted: where its epilogues pop rbp)
let save_active:array<int64>=[]
save_around_call=(pos:XWord before:bool dst:XWord):>void=>$unsafe {
    loop v in save_active {
        if v not=? dst {
            let r=vloc[v]
            if r >=? XMM and is_vreg_vec(xe_vtype(v)) {
                if before {vmov_mr(RBP  xe_spill[v]  r - XMM  xe_vtype(v))}
                else {vmov_rm(r - XMM  RBP  xe_spill[v]  xe_vtype(v))}
            }
            else if r >=? XMM {
                let op:XWord=0x10
                if before {op=0x11}
                sse_rm(fpre(xe_vtype(v))  op  r - XMM  RBP  xe_spill[v])
            }
            else if before {mov_mr(RBP  xe_spill[v]  r)}
            else {mov_rm(r  RBP  xe_spill[v])}
        }
    }
}
let cabi_fix:array<[int64 int64]>=[]
let call_sites:array<int64>=[]

# (code offset, position) where the source position changes: the line table of debuggers
# (dwarf.jo)
let line_rows:array<int64>=[]
line_row=(pos:XWord):>void=>$unsafe {
    if pos =? 0 {return}
    # (fused.jo's programs: by source position, not by id, as ids for one position depend on
    # what was lowered before)
    let at=pos
    if xe_fused {at=xe_positions[0][pos]}
    if at =? row_pos {return}
    row_pos=at
    line_rows.push(XWord(x_code[0].length))
    line_rows.push(pos)
}
call_site=(ins:Ins):>void=>$unsafe {
    if ins.pos =? 0 {return}
    call_sites.push(XWord(x_code[0].length))
    call_sites.push(XWord(ins.pos))
}
let stub_fix:array<[int64 int64]>=[]
x_scan_splat=(x:XWord value:XWord):>void=>$unsafe {
    mov_imm(R8  value * 0x01010101)
    sse_rr(0x66  0x6E  x  R8)
    sse_rr(0x66  0x70  x  x)
    b(0)
}
x_scan_predicate=(offset:XWord invert:bool):>void=>$unsafe {
    if offset <? 0 {
        sse_rr(0x66  0x6F  2  0)
        sse_rr(0x66  0x74  2  4)
    }
    else {
        sse_rr(0x66  0xEF  2  2)
        loop j in [0..XWord(xe_rodata[0][offset])) {
            sse_rr(0x66  0x6F  1  0)
            if xe_rodata[0][offset + 1 + 2 * j] =? xe_rodata[0][offset + 2 + 2 * j] {
                sse_rr(0x66  0x74  1  4 + 2 * j)
            }
            else {
                sse_rr(0x66  0xDE  1  4 + 2 * j) # pmaxub lower
                sse_rr(0x66  0xDA  1  5 + 2 * j) # pminub upper
                sse_rr(0x66  0x74  1  0)
            }
            sse_rr(0x66  0xEB  2  1)
        }
    }
    if invert {sse_rr(0x66  0xEF  2  12)}
}
emit_scanbytes=(ins:ptr<Ins>):>void=>$unsafe {
    let d=XWord(ins[0].dst)
    if vloc[d] =? LOC_NONE {return}
    let offset=(ins[0].imm >> 2) - 1
    let invert=ins[0].imm & 1 not=? 0
    let counting=ins[0].imm & 2 not=? 0
    ld(RCX  XWord(ins[0].a))
    ld(RDX  XWord(ins[0].b))
    if offset <? 0 {
        ld(R8  XWord(ins[0].c))
        sse_rr(0x66  0x6E  4  R8)
        sse_rr(0x66  0x60  4  4)
        sse_rr(0x66  0x61  4  4)
        sse_rr(0x66  0x70  4  4)
        b(0)
    }
    else {
        loop j in [0..XWord(xe_rodata[0][offset])) {
            x_scan_splat(4 + 2 * j  XWord(xe_rodata[0][offset + 1 + 2 * j]))
            x_scan_splat(5 + 2 * j  XWord(xe_rodata[0][offset + 2 + 2 * j]))
        }
    }
    if invert {sse_rr(0x66  0x74  12  12)}
    if counting {
        sse_rr(0x66  0xEF  3  3)
        x_scan_splat(13  1)
    }
    mov_imm(RAX  0)
    let top=XWord(x_code[0].length)
    cmp_branch_pad(10)
    b24(0xFA8348)
    b(16) # cmp rdx, 16
    let tail_jump=jcc32(CC_L)
    sse_rm(0xF3  0x6F  0  RCX  0)
    x_scan_predicate(offset  invert)
    let found:XWord=-1
    if counting {
        sse_rr(0x66  0xDB  2  13) # one per matching byte
        sse_rr(0x66  0xF6  2  3) # psadbw: two eight-byte sums
        b(0x66)
        rex(true  2  0  R8  false)
        b16(0x7E0F)
        modrr(2  R8) # movq r8, xmm2
    }
    else {
        sse_rr(0x66  0xD7  R9  2)
        op_rr(0x85  false  R9  R9)
        found=jcc32(CC_NE)
        lea(RAX  RAX  16)
    }
    if counting {
        sse_rr(0x66  0x73  3  2)
        b(8) # psrldq xmm2, 8
        b(0x66)
        rex(true  2  0  R9  false)
        b16(0x7E0F)
        modrr(2  R9)
        op_rr(0x01  true  R8  RAX)
        op_rr(0x01  true  R9  RAX)
    }
    lea(RCX  RCX  16)
    lea(RDX  RDX  -16)
    jmp_back(top)
    patch_here(tail_jump)
    let tail=XWord(x_code[0].length)
    op_rr(0x85  true  RDX  RDX)
    let absent=jcc32(CC_LE)
    rex(false  R8  0  RCX  false)
    b16(0xB60F)
    mem(R8  RCX  0)
    sse_rr(0x66  0x6E  0  R8)
    x_scan_predicate(offset  invert)
    sse_rr(0x66  0xD7  R9  2)
    rex(false  0  0  R9  false)
    b(0x83)
    modrr(4  R9)
    b(1)
    let equal:XWord=-1
    if counting {op_rr(0x01  true  R9  RAX)}
    else {
        equal=jcc32(CC_NE)
        lea(RAX  RAX  1)
    }
    lea(RCX  RCX  1)
    lea(RDX  RDX  -1)
    jmp_back(tail)
    if not counting {
        patch_here(found)
        rex(false  R9  0  R9  false)
        b16(0xBC0F)
        modrr(R9  R9)
        op_rr(0x01  true  R9  RAX)
        let done=jmp32()
        patch_here(absent)
        mov_imm(RAX  -1)
        patch_here(equal)
        patch_here(done)
    }
    else {patch_here(absent)}
    st(d  RAX)
}
x_emit_record_load=(ins:ptr<Ins>):>void=>$unsafe {
    let d=XWord(ins[0].dst)
    if vloc[d] =? LOC_NONE {return}
    let ty=XWord(ins[0].ty)
    let stride=XWord(ins[0].c) >> 8
    let xe_pair18=addr_of(XWord(ins[0].a)  RCX)
    let base=xe_pair18[0]
    let disp=xe_pair18[1]
    disp += ins[0].imm
    let xe_pair19=indexed_base(base  disp  ins[0].imm)
    base=xe_pair19[0]
    disp=xe_pair19[1]
    let ix=reg_of(XWord(ins[0].b)  RDX)
    let x=xdreg(d  0)
    use_index(ix  0)
    if ty =? VY {
        vex(x  0  base  1  3  0  0)
        b(0x10)
        mem(x  base  disp)
        vex(x  x  base  1  1  0  0)
        b(0x16)
        mem(x  base  disp + stride)
        vex(15  0  base  1  3  0  0)
        b(0x10)
        mem(15  base  disp + 2 * stride)
        vex(15  15  base  1  1  0  0)
        b(0x16)
        mem(15  base  disp + 3 * stride)
        cur_index=-1
        vex(x  x  15  3  1  0  1)
        b(0x18)
        modrr(x  15)
        b(1) # vinsertf128
    }
    else {
        sse_rm(0xF2  0x10  x  base  disp)
        sse_rm(0x66  0x16  x  base  disp + stride)
        cur_index=-1
    }
    sts(d  x  ty)
}
x_emit_vector_sqrt=(ins:ptr<Ins>):>void=>$unsafe {
    let d=XWord(ins[0].dst)
    if vloc[d] =? LOC_NONE {return}
    let ty=XWord(ins[0].ty)
    let x=xdreg(d  0)
    let a=xreg_of(XWord(ins[0].a)  1  ty)
    if ty =? VY {
        vex(x  0  a  1  (if ins[0].imm =? 1 {1} else {0})  0  1)
        b(0x51)
        modrr(x  a)
    }
    else {sse_rr((if ins[0].imm =? 1 {0x66} else {0})  0x51  x  a)}
    sts(d  x  ty)
}

# VEX scalar moves keep an AVX fold free of SSE transition penalties, including
# spills. The scalar source is floating-point storage, never an integer vreg.
x_ordered_scalar=(v:XWord):>void=>$unsafe {
    let l=vloc[v]
    if l >=? XMM {
        vex(1  0  l - XMM  1  0  0  0)
        b(0x28)
        modrr(1  l - XMM)
    }
    else if l =? LOC_SPILL {
        vex(1  0  RBP  1  3  0  0)
        b(0x10)
        mem(1  RBP  xe_spill[v])
    }
    else if l =? LOC_FCONST {
        let saved=rip_kind
        rip_kind=0
        vex(1  0  RIPREL  1  3  0  0)
        b(0x10)
        mem(1  RIPREL  ro_const(vcval[v]))
        rip_kind=saved
    }
    else {xe_error("ordered fold scalar storage")}
}
x_ordered_add=(lane:XWord reverse:bool avx:bool):>void=>$unsafe {
    if avx {
        vex(1  (if reverse {lane} else {1})  (if reverse {1} else {lane})  1  3  0  0)
        b(0x58)
        modrr(1  if reverse {1} else {lane})
    }
    else if reverse {
        # xmm0 holds the selected lane; keep the source vector unchanged.
        if lane not=? 0 {vmov_rr(0  lane  VX)}
        sse_rr(0xF2  0x58  0  1)
        vmov_rr(1  0  VX)
    }
    else {sse_rr(0xF2  0x58  1  lane)}
}
x_emit_ordered_fold=(ins:ptr<Ins>):>void=>$unsafe {
    let d=XWord(ins[0].dst)
    if vloc[d] =? LOC_NONE {return}
    let vector=XWord(ins[0].b)
    let avx=xe_vtype(vector) =? VY
    let a=xreg_of(vector  15  xe_vtype(vector))
    let reverse=ins[0].c =? 11
    if avx {x_ordered_scalar(XWord(ins[0].a))}
    else {lds(1  XWord(ins[0].a)  VF)}
    x_ordered_add(a  reverse  avx)
    if avx {
        vex(0  a  a  1  1  0  0)
        b(0x15)
        modrr(0  a) # lane 1
    }
    else {sse_rr(0  0x12  0  a)} # movhlps: high source double becomes low
    x_ordered_add(0  reverse  avx)
    if avx {
        vex(a  0  0  3  1  0  1)
        b(0x19)
        modrr(a  0)
        b(1) # high 128 bits
        x_ordered_add(0  reverse  true)
        vex(0  0  0  1  1  0  0)
        b(0x15)
        modrr(0  0)
        x_ordered_add(0  reverse  true)
        let dest=vloc[d]
        if dest >=? XMM {
            vex(dest - XMM  0  1  1  0  0  0)
            b(0x28)
            modrr(dest - XMM  1)
        }
        else {
            vex(1  0  RBP  1  3  0  0)
            b(0x11)
            mem(1  RBP  xe_spill[d])
        }
    }
    else {sts(d  1  VF)}
}
x_word_shift=(dst:XWord src:XWord count:XWord left:bool ty:XWord):>void=>$unsafe {
    let ext:XWord=if left {6} else {2}
    if ty =? VY {
        vex(ext  dst  src  1  1  0  1)
        b(0x73)
        modrr(ext  src)
        b(count)
    }
    else {
        vmov_rr(dst  src  ty)
        sse_rr(0x66  0x73  ext  dst)
        b(count)
    }
}
x_emit_word_shift=(ins:ptr<Ins>):>void=>$unsafe {
    let d=XWord(ins[0].dst)
    if vloc[d] =? LOC_NONE {return}
    let ty=XWord(ins[0].ty)
    let count=vcval[XWord(ins[0].b)]
    let x=xdreg(d  0)
    let a=xreg_of(XWord(ins[0].a)  1  ty)
    if ins[0].c not=? 14 or count =? 0 {
        x_word_shift(x  a  count  ins[0].c =? 12  ty)
    }
    else {
        # Preserve the logical part before the reserved source reload register
        # becomes the sign mask. Destinations may overlap either source.
        x_word_shift(0  a  count  false  ty)
        vmov_rr(1  a  ty)
        if ty =? VY {
            vex(4  1  1  1  1  0  1)
            b(0x72)
            modrr(4  1)
            b(31)
            vex(1  0  1  1  1  0  1)
            b(0x70)
            modrr(1  1)
            b(0xF5)
        }
        else {
            sse_rr(0x66  0x72  4  1)
            b(31)
            sse_rr(0x66  0x70  1  1)
            b(0xF5)
        }
        x_word_shift(1  1  64 - count  true  ty)
        if ty =? VY {vop3(7  3  x  0  1)}
        else {
            vop2(7  3  0  1)
            vmov_rr(x  0  ty)
        }
    }
    sts(d  x  ty)
}
x64_emit=(input:ptr<IrFn> start:XWord debug:bool windows:bool fused:bool mt_active:XWord iat_base:XWord cabi:ptr<array<bool>> positions:ptr<array<int64>>):>XWord=>$unsafe {
    x64_emitter_ir(input)
    xe_start=start
    xe_debug=debug
    xe_windows=windows
    xe_fused=fused
    xe_mt_active=mt_active
    xe_iat_base=iat_base
    xe_cabi=cabi
    xe_positions=positions
    xe_emit_error=""
    x_int_fail.clear()
    rsp_extra=0
    if rsp_frame {rsp_row(0)}
    xctl=[]
    x_loop_depth=0
    fused_cc=-1
    cmp_load=-1
    cmp_reload=-1
    cmp_reload_at=-1
    fuse_skip=-1
    sel_fused=-1
    fold_load=-1
    # (the prologue is the declaration's line, the body's first line comes after it: where
    # debuggers put a breakpoint on the function)
    row_pos=-1
    if xe_ir[0].decl_pos not=? 0 {line_row(xe_ir[0].decl_pos)}
    else {
        loop row in xe_ir[0].code {
            if row.pos not=? 0 {
                line_row(XWord(row.pos))
                break
            }
        }
    }
    emit_prologue()
    let body_start=XWord(x_code[0].length)
    if xe_debug and XWord(dbg_pos.length) <? xe_ncode + 1 {dbg_pos=fill(0  xe_ncode + 64)}
    dbg_epis.clear()
    let ci:XWord=0
    save_list.sort(key=(v:int64):>int64=>live_start(v))
    save_next=0
    save_active.clear()
    let instructions=xe_instructions
    let calls=call_pos.ptr as ptr<XWord>
    let ncalls=XWord(call_pos.length)
    let saves=save_list.ptr as ptr<XWord>
    let nsaves=XWord(save_list.length)
    loop pos in [0..xe_ncode) {
        let ins=instructions + pos
        line_row(XWord(ins[0].pos))
        if xe_debug {dbg_pos[pos] = XWord(x_code[0].length)}
        if ci <? ncalls and calls[ci] =? pos and nsaves >? 0 {
            # values in caller-saved registers live across this call (a sweep: calls come in order)
            loop save_next <? nsaves and live_start(saves[save_next]) <? pos {
                save_active.push(saves[save_next])
                save_next += 1
            }
            let k:XWord=0
            loop k <? XWord(save_active.length) {
                if v_live[save_active[k]].last <=? pos {
                    save_active[k] = save_active[XWord(save_active.length) - 1]
                    save_active.pop();
                }
                else {k += 1}
            }
            save_around_call(pos  true  -1)
            emit_ins(pos  ins)
            let d:XWord=-1
            if ins[0].op =? 'call' or ins[0].op =? 'calli' or ins[0].op =? 'callc' or ins[0].op =? 'syscall' or ins[0].op =? 'intr' {d=XWord(ins[0].dst)}
            save_around_call(pos  false  d)
            if ra_stat {
                loop v in save_active {
                    if vloc[v] >=? XMM {ra_save_x += 2 * call_w[ci]}
                    else {ra_save_cost += 2 * call_w[ci]}
                }
            }
        }
        else {emit_ins(pos  ins)}
        if ci <? ncalls and calls[ci] =? pos {ci += 1}
    }
    if XWord(x_int_fail.length) >? 0 {
        loop fix in x_int_fail {patch32(fix  XWord(x_code[0].length) - fix - 4)}
        b(0xE8)
        b32(0)
        call_fix.push([XWord(x_code[0].length) - 4  x_int_fail_fn])
        b(0x0F)
        b(0x0B) # unreachable if the failure helper returns
    }
    if debug {dbg_pos[input[0].code.length] = XWord(x_code[0].length)}
    body_start
}

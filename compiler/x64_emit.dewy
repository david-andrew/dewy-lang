        let p=x_bytes(40)
        let q=p as ptr<uint64>
        q[0]=0x3883482374C08548
        q[1]=0x00000D8D481D7E00
        q[2]=0x4805750039800000
        q[3]=0x000D8D480CEB00FF
        q[4]=0x00000000E8000000
        x_data_fix[0].push([base + 14  1  xe_mt_active])
        call_fix.push([base + 31  XWord(ins[0].imm)])
        stub_fix.push([base + 36  12])
        if ipos not=? 0 {call_sites.push(XWord(x_code[0].length)); call_sites.push(ipos)}
    }
    else if ins[0].c =? CALL_RC_DEC {

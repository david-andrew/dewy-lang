use 'lsp.jo'
use 'lsp_drive.dewy'
use 'lsp_fixes.dewy'
use 'checker_program.dewy'
use 'util.jo'
use 'module_paths.dewy'
use 'ast.jo'
use 'types.jo'
use 'type_ops.dewy'
use 'check.jo'
use 'ide.jo'
use 'ide_decls.dewy'
use 'ide_text.dewy'
use 'fmt.jo'
use 'lex.jo'
use 'main.jo'
use 'json_doc.dewy'
use 'lsp_ops.dewy'
use 'lsp_handlers.dewy'
use 'lsp_text.dewy'

# the top-level item (declaration or statement) around offset off: [a, b) and its name
top_item = (text: str, off: int) -> Item:
    a = max(0, min(off, len(text)))
    loop a > 0 and text[a - 1] != '\n': a -= 1
    loop true:
        e = a
        loop e < len(text) and text[e] != '\n': e += 1
        t = text[a..e)
        if len(t) > 0 and t[0] != ' ' and t[0] != '\t' and t[0] != '#' and not starts_with(t, "else"): break
        if a == 0: return Item(-1, -1, "")
        a -= 1
        loop a > 0 and text[a - 1] != '\n': a -= 1
    first = a
    # (with its @attributes)
    loop a > 0:
        p = a - 1
        loop p > 0 and text[p - 1] != '\n': p -= 1
        if p < a and text[p] == '@': a = p
        else: break
    e = first
    loop e < len(text) and text[e] != '\n': e += 1
    line = text[first..e)
    if starts_with(line, "use ") or starts_with(line, "import ") or starts_with(line, "build:"): return Item(-1, -1, "")
    b = e
    loop b < len(text):
        n = b + 1
        if n >= len(text):
            b = len(text)
            break
        c = text[n]
        if c != ' ' and c != '\t' and c != '\n' and c != '#' and not starts_with(text[n..min(n + 4, len(text))), "else"): break
        b = n
        loop b < len(text) and text[b] != '\n': b += 1
    if b < len(text): b += 1
    name = ""
    t = line
    loop kw in ["struct ", "enum ", "const ", "type ", "extern "]:
        if starts_with(t, kw): t = trim(t[len(kw)..])
    name = ident_prefix(t)
    Item(a, b, name)
# check a document; after an error in a function, again without checking that function's body
# (and after other errors in the program's files, again without that top-level item), for more
# errors and for names and types in the rest of the program. completing >= 0: completions at that
# offset of path are wanted (the item there is never left out)
check_doc = (path: str, completing: int, lower: bool, wide: bool) -> Result:
    r = Result()
    sentinel = completing >= 0
    main_path = path
    if starts_with(path, root_lib + "/"): main_path = empty_main
    skips: str[]
    blanked: str[]                  # names of the items left out
    saved: {str: str} = {}          # texts replaced while checking (to restore)
    unsaved: str[]                  # (paths that had no text in ide_texts)
    t0 = time()
    loop rnd in [0..10):
        o = run_child(main_path, path, sentinel, skips, lower, wide)
        if lsp_stop != 0: break
        nd = r.diags.len()
        nskips = r.skips.len()
        take_lines(r, o.lines)
        if not o.ok and r.diags.len() == nd:
            r.diags.push(Diag(path, 0, "internal compiler error while checking this file", false))
            break
        if sentinel and r.comps.len() > 0: break
        ei = -1
        loop i in [nd..r.diags.len()):
            if not r.diags[i].warning: ei = i
        if ei < 0: break
        e = r.diags[ei]
        # (errors that follow from leaving something out are not the program's)
        follows = e.cascade
        loop nm in blanked:
            if contains(e.msg, "'{nm}'"): follows = true
        if follows:
            r.diags.remove(ei)
            # (in a function: go on without it)
            if r.skips.len() == nskips or skips.contains(r.skips[r.skips.len() - 1]): break
        if r.skips.len() > nskips:
            sk = r.skips[r.skips.len() - 1]
            if skips.contains(sk):
                r.diags.remove(ei)
                break
            skips.push(sk)
        else:
            if len(e.path) == 0 or e.path == empty_main or starts_with(e.path, root_lib + "/") and e.path != path: break
            text = text_of(e.path)
            it = top_item(text, e.off)
            if it.a < 0 or e.path == path and completing >= it.a and completing < it.b: break
            if saved.get(e.path) == none:
                if let old = ide_texts.get(e.path): saved[e.path] = old
                else:
                    saved[e.path] = text
                    unsaved.push(e.path)
            ide_texts[e.path] = blank_out(text, it.a, it.b)
            if len(it.name) > 0: blanked.push(it.name)
        if time() - t0 > 1.5: break
    loop p, t in saved:
        if unsaved.contains(p): ide_texts.remove(p)
        else: ide_texts[p] = t
    r
# the file named by a `use` line at off, or ""
use_target = (d: int, off: int) -> str:
    text = docs[d].text
    a = off
    loop a > 0 and text[a - 1] != '\n': a -= 1
    b = off
    loop b < len(text) and text[b] != '\n': b += 1
    line = trim(text[a..b))
    if not starts_with(line, "use ") and not starts_with(line, "import ") and not starts_with(line, "from "): return ""
    # (from m import a, b: on a name, that name's definition)
    if starts_with(line, "from "):
        im = find(text[a..b), " import ")
        if im >= 0 and off > a + im: return ""
    dir = docs[d].path
    s = rfind(dir, "/")
    if s >= 0: dir = dir[..s)
    q = find_byte(line, '\'')
    if q < 0: q = find_byte(line, '"')
    if q >= 0:
        e = find_byte(line, line[q], q + 1)
        if e < 0: return ""
        rel = line[q + 1..e)
        if is_abs_path(rel): return path_norm(rel)
        return path_norm("{dir}/{rel}")
    nm = trim(line[find_byte(line, ' ') + 1..])
    k = find(nm, " as ")
    if k >= 0: nm = nm[..k)
    rel = replace(nm, ".", "/")
    loop stem in module_search_stems(dir, root_lib, rel):
        if file_exists(stem + ".jo"): return path_norm(stem + ".jo")
    ""
# results with all the uses of what reference h (in document d) is to: d's, and those of the
# other open documents whose programs include the declaration's file
uses_of = (d: int, h: Hit) -> Use[]:
    out: Use[]
    p = split_pos(h.ref.decl)
    if p.0 < 0 or p.0 >= h.res.paths.len(): return out
    path = h.res.paths[p.0]
    loop i in [0..docs.len()):
        r = h.res
        if i != d:
            if not docs[i].open or not docs[i].res.paths.contains(path): continue
            ensure_checked(i)
            r = docs[i].res
        w = wide_of(i, r)
        f = file_in(w, path)
        if f >= 0: out.push(Use(w, "{f}:{p.1}"))
    # (the workspace's other programs that may use it: files not open that name it, checked when
    # they include the declaration's file; not the standard library's users)
    if starts_with(path, root_lib + "/"): return out
    name = ""
    if let dc = h.res.decls.get(h.ref.decl):
        # (a function's locals and parameters stay in its file)
        if dc.kind != IK_LOCAL and dc.kind != IK_PARAM: name = dc.name
    if len(name) == 0: return out
    ws_ensure_scanned()
    t0 = time()
    loop wf in ws_files:
        if time() - t0 > 3.0 or lsp_stop != 0: break
        if wf == path or ends_with(path, ".dewy") and not ends_with(wf, ".dewy"): continue
        if open_doc_at(wf) >= 0: continue
        known = false
        loop u in out:
            if u.res.paths.contains(wf): known = true
        if known: continue
        if not has_word(read_file(wf) ?? "", name): continue
        w = check_doc(wf, -1, false, true)
        if lsp_stop != 0: break
        w.texts = ide_texts
        f = file_in(w, path)
        if f >= 0: out.push(Use(w, "{f}:{p.1}"))
    out
# for each cursor position in text up to b: 1 if it is inside a string or a comment (not in a
# string's {interpolations}), the text read from its start as the lexer reads it
str_mask = (text: str, b0: int, dewy: bool = false) -> u8[]:
    b = max(0, min(b0, len(text)))
    m: u8[]
    m.resize(b + 1)
    i = 0
    loop i < b:
        if text[i] == '#':
            e = ide_comment_end(text, i, dewy)
            # (inside a line comment up to its line end; inside a block comment before its }#)
            last = e
            if dewy and i + 1 < len(text) and text[i + 1] == '{{' and e >= 2 and text[e - 1] == '#': last = e - 1
            loop k in [i + 1..min(last, b) + 1): m[k] = 1
            i = e
        else if ide_str_start(text, i): i = ide_str_end(text, i, m, 0, dewy)
        else: i += 1
    m
# In a Dewy import's path, from p"dir/na|": the .dewy and .jo files and folders there, replacing
# the part after the last / ("" when the cursor is not in one)
import_paths = (d: int, off: int) -> str:
    if not ends_with(docs[d].path, ".dewy"): return ""
    text = docs[d].text
    a = off
    loop a > 0 and text[a - 1] != '\n': a -= 1
    pre = text[a..off)
    t = trim(pre)
    if not starts_with(t, "from ") and not starts_with(t, "import "): return ""
    q = rfind(pre, "p\"")
    if q < 0 or find_byte(pre, '"', q + 2) >= 0: return ""
    typed = pre[q + 2..]
    sl = rfind(typed, "/")
    base = docs[d].path[..rfind(docs[d].path, "/"))
    dir = base
    if sl >= 0:
        if is_abs_path(typed[..sl + 1)): dir = typed[..sl + 1)
        else: dir = path_norm(base + "/" + typed[..sl + 1))
    from = a + q + 2 + sl + 1
    text_ls = line_starts_of(text)
    rg = "\{\"start\":{jpos(lpos_of(text, text_ls, from))},\"end\":{jpos(lpos_of(text, text_ls, off))}\}"
    items: str[]
    loop n in list_dir(dir):
        if starts_with(n, ".") or n == "__dewycache__" or n == "node_modules": continue
        full = dir + "/" + n
        if is_dir(full):
            items.push("\{\"label\":{json_quote(n + "/")},\"kind\":19,\"sortText\":{json_quote("1" + n)},\"textEdit\":\{\"range\":{rg},\"newText\":{json_quote(n + "/")}\},\"command\":\{\"title\":\"\",\"command\":\"editor.action.triggerSuggest\"\}\}")
        else if (ends_with(n, ".dewy") or ends_with(n, ".jo")) and full != docs[d].path:
            items.push("\{\"label\":{json_quote(n)},\"kind\":17,\"sortText\":{json_quote("0" + n)},\"textEdit\":\{\"range\":{rg},\"newText\":{json_quote(n)}\}\}")
    if items.len() == 0: return no_items
    "\{\"isIncomplete\":false,\"items\":[{join(items, ",")}]\}"
on_completion = (id: int, params: int) -> int:
    d = text_params_doc(params)
    if d < 0: return lsp_reply(id, "null")
    text = docs[d].text
    off = req_off(d, params)
    paths = import_paths(d, off)
    if len(paths) > 0: return lsp_reply(id, paths)
    # (typed / or ": only paths are wanted; $: directives)
    trig = jstr(jpath(params, "context", "triggerCharacter"))
    if (trig == "/" or trig == "\"") or trig == "$" and (off < 1 or text[off - 1] != '$'): return lsp_reply(id, no_items)
    if in_comment_or_str(text, off, ends_with(docs[d].path, ".dewy")): return lsp_reply(id, no_items)
    a = name_start(text, off)
    b = name_end(text, off)
    prefix = text[a..off)
    member = a > 0 and text[a - 1] == '.'
    if a > 0 and text[a - 1] == '$' and ends_with(docs[d].path, ".dewy"):
        # (the directives this compiler implements)
        dv: str[]
        loop w in ["assert", "runtime_assert", "expect", "fail", "test", "capture", "include_bytes"]: dv.push("\{\"label\":{json_quote(w)},\"kind\":14,\"detail\":\"directive\"\}")
        return lsp_reply(id, "\{\"isIncomplete\":false,\"items\":[{join(dv, ",")}]\}")
    if member and a > 1 and text[a - 2] == '.': return lsp_reply(id, no_items)     # a range: 0..
    if not member and len(prefix) > 0 and is_digit(prefix[0]): return lsp_reply(id, no_items)
    sent = "__dewy_complete__"
    saved = text
    tries: str[]
    tries.push(text[..a) + sent + text[b..])
    # (an unfinished line: end it after the name, closing what it opened)
    le = b
    loop le < len(text) and text[le] != '\n': le += 1
    ls0 = a
    loop ls0 > 0 and text[ls0 - 1] != '\n': ls0 -= 1
    closers = ""
    loop c in text[ls0..a):
        if c == '(': closers = ")" + closers
        else if c == '[': closers = "]" + closers
        else if c == '{{': closers = "\}" + closers
        else if (c == ')' or c == ']' or c == '}}') and len(closers) > 0: closers = closers[1..]
    line0 = trim(text[ls0..a))
    # (the names after `from m import` are the module's, not statements)
    if starts_with(line0, "from ") and find(line0, " import") >= 0: member = true
    tail = closers
    if (starts_with(line0, "if ") or starts_with(line0, "else if ") or starts_with(line0, "loop ") or starts_with(line0, "match ") or starts_with(line0, "while ")) and find_byte(text[a..le), ':') < 0: tail += ": pass"
    tries.push(text[..a) + sent + tail + text[le..])
    r = Result()
    loop t in tries:
        ide_texts[docs[d].path] = t
        r = check_doc(docs[d].path, a, false, false)
        if lsp_stop != 0 or r.comps.len() > 0: break
    ide_texts[docs[d].path] = saved
    items: str[]
    seen: {str: bool} = {}
    loop c in r.comps:
        label = c[0]
        if seen.get(label) != none or label == sent: continue
        if starts_with(label, "__") and not starts_with(prefix, "_"): continue
        seen[label] = true
        k = to_int(c[1]) ?? 0
        # (the program's own names and fields first, then the library's)
        so = "1"
        if k == IK_LOCAL or k == IK_PARAM or k == IK_FIELD or k == IK_VARIANT: so = "0"
        items.push("\{\"label\":{json_quote(label)},\"kind\":{comp_kind(k)},\"detail\":{json_quote(c[2])},\"sortText\":{json_quote(so + label)}\}")
    if not member and r.comps.len() > 0 or not member and items.len() == 0:
        loop kw in comp_words(ends_with(docs[d].path, ".dewy")):
            if seen.get(kw) == none: items.push("\{\"label\":{json_quote(kw)},\"kind\":14,\"sortText\":{json_quote("2" + kw)}\}")
    lsp_reply(id, "\{\"isIncomplete\":false,\"items\":[{join(items, ",")}]\}")
dewy_arg_at = (text: str, m: u8[], a: int, b: int) -> (int, str):
    words: str[]
    j = a
    depth = 0
    w0 = -1
    loop j < b:
        c = text[j]
        inside = m[j] != 0 and m[j + 1] != 0
        space = not inside and depth == 0 and (c == ' ' or c == '\t' or c == '\n' or c == '\r')
        if space:
            if w0 >= 0:
                words.push(text[w0..j))
                w0 = -1
        else:
            if w0 < 0: w0 = j
            if not inside:
                if c == '(' or c == '[' or c == '{{': depth += 1
                else if (c == ')' or c == ']' or c == '}}') and depth > 0: depth -= 1
        j += 1
    open_word = w0 >= 0
    if open_word:
        words.push(text[w0..b))
    index = -1
    first = -1          # the first word of the current argument
    loop k in [0..words.len()):
        w = words[k]
        if k == 0 or not dewy_joins(words[k - 1], w):
            index += 1
            first = k
    # (after a space that ends a complete argument: the next one)
    if not open_word and words.len() > 0:
        last = words[words.len() - 1]
        if not dewy_op_word(last) and not dewy_ends_op(last):
            index += 1
            first = -1
    if index < 0: index = 0
    name = ""
    if first >= 0:
        w = words[first]
        e = 0
        loop e < len(w) and is_ident_char(w[e]): e += 1
        if e > 0 and e < len(w) and w[e] == '=' and (e + 1 >= len(w) or w[e + 1] != '=' and w[e + 1] != '?' and w[e + 1] != '>'): name = w[..e)
    (index, name)
# the parameters of a signature label (UTF-16 offsets [start, end] of each, and their names):
# Dewy's are separated by spaces, (a:int64 @b:T c=…); the implementation language's by commas
sig_params = (label: str, dewy: bool) -> (str[], str[]):
    ps: str[]
    names: str[]
    a = find_byte(label, '(')
    if a < 0: return (ps, names)
    lm = str_mask(label, len(label))
    k = a + 1
    dep = 0
    st = k
    loop k < len(label):
        c = label[k]
        if lm[k] != 0 or lm[k + 1] != 0:
            k += 1
            continue
        if c == '(' or c == '[' or c == '{{' or c == '<' and dewy: dep += 1
        else if c == ')' or c == ']' or c == '}}' or c == '>' and dewy and label[k - 1] != ':' and label[k - 1] != '=':
            if dep == 0:
                sig_param(label, st, k, ps, names)
                break
            dep -= 1
        else if dep == 0 and (not dewy and c == ',' or dewy and c == ' '):
            split = true
            if dewy:
                pv = k - 1
                loop pv > st and label[pv] == ' ': pv -= 1
                nx = k + 1
                loop nx < len(label) and label[nx] == ' ': nx += 1
                if pv < st or nx >= len(label): split = false
                else if dewy_op_byte(label[pv]) or label[nx] == '=' or label[nx] == ':' or label[nx] == '|' or label[nx] == '&' or label[nx] == ')' or label[nx] >= 0x80: split = false
            if split:
                sig_param(label, st, k, ps, names)
                st = k + 1
        k += 1
    (ps, names)
sig_param = (label: str, x: int, y: int, ps: mut str[], names: mut str[]):
    x0 = x + count_lead(label, x)
    y0 = y - count_trail(label, y)
    if y0 <= x0: return
    ps.push("[{utf16_units(label, 0, x0)},{utf16_units(label, 0, y0)}]")
    q = x0
    if label[q] == '@': q += 1
    e = q
    loop e < y0 and is_ident_char(label[e]): e += 1
    names.push(label[q..e))
on_signature = (id: int, params: int) -> int:
    d = text_params_doc(params)
    if d < 0: return lsp_reply(id, "null")
    text = docs[d].text
    off = req_off(d, params)
    dewy = ends_with(docs[d].path, ".dewy")
    # the call the cursor is in: back to its unmatched ( (past strings and comments)
    m = str_mask(text, off, dewy)
    i = off
    depth = 0
    commas = 0
    stop = max(0, off - 4000)
    loop i > stop:
        i -= 1
        if m[i] != 0 or m[i + 1] != 0: continue
        c = text[i]
        if c == ')' or c == ']' or c == '}}': depth += 1
        else if c == '(' or c == '[' or c == '{{':
            if depth == 0:
                if c != '(': return lsp_reply(id, "null")
                break
            depth -= 1
        else if c == ',' and depth == 0: commas += 1
    if i < stop or i >= len(text) or text[i] != '(': return lsp_reply(id, "null")
    e = i
    loop e > 0 and text[e - 1] == ' ': e -= 1
    # (f<int64>(...): past the type arguments)
    if dewy and e > 0 and text[e - 1] == '>':
        g = e - 1
        dg = 0
        loop g > 0:
            if text[g] == '>': dg += 1
            else if text[g] == '<':
                dg -= 1
                if dg == 0: break
            g -= 1
        if g > 0: e = g
    s = name_start(text, e)
    if s == e: return lsp_reply(id, "null")
    if docs[d].dirty and not lsp_input_ready(): refresh(d)
    h = ref_at(d, s)
    if not h.found: return lsp_reply(id, "null")
    dc = h.res.decls.get(h.ref.decl) ?? Decl()
    if dc.kind != IK_FN or len(dc.snippet) == 0: return lsp_reply(id, "null")
    label = dc.snippet
    # (the instance used here, as hover shows it: its parameters' types)
    if dewy and starts_with(h.ref.info, "(") and len(dc.name) > 0: label = dc.name + "=" + h.ref.info
    sp = sig_params(label, dewy)
    ps = sp.0
    # x.f(a): the receiver is the first argument (m.f(a) of a module m is not)
    active = commas
    named = ""
    if dewy:
        ai = dewy_arg_at(text, m, i + 1, off)
        active = ai.0
        named = ai.1
    if s > 0 and text[s - 1] == '.':
        active += 1
        rs = name_start(text, s - 1)
        if rs < s - 1:
            rh = ref_at(d, rs)
            if rh.found and starts_with(rh.ref.info, "module "): active -= 1
    if len(named) > 0:
        k = sp.1.index_of(named)
        if k >= 0: active = k
    pj: str[]
    loop p in ps: pj.push("\{\"label\":{p}\}")
    sig = "\{\"label\":{json_quote(label)},\"parameters\":[{join(pj, ",")}]"
    if len(dc.doc) > 0: sig += ",\"documentation\":\{\"kind\":\"markdown\",\"value\":{json_quote(dc.doc)}\}"
    sig += "\}"
    lsp_reply(id, "\{\"signatures\":[{sig}],\"activeSignature\":0,\"activeParameter\":{active}\}")
on_semantic = (id: int, params: int) -> int:
    d = text_params_doc(params)
    if d < 0: return lsp_reply(id, "null")
    if docs[d].dirty and not lsp_input_ready(): refresh(d)
    text = docs[d].text
    ls = line_starts_of(text)
    toks: {int: SemTok} = {}
    # (the latest result; then the last good one, for what the latest left out after an error)
    loop which in [0..2):
        r = docs[d].res
        if which == 1:
            if not docs[d].has_good: break
            r = docs[d].good
        f = file_in(r, docs[d].path)
        if f < 0: continue
        loop x in r.refs:
            if x.file != f: continue
            o = unmap_off(r, docs[d].path, x.off)
            if o < 0 or o + x.len > len(text) or toks.get(o) != none: continue
            dco = r.decls.get(x.decl)
            if dco == none:
                # (the language's own types and builtin functions: no declaration to show)
                bt = -1
                if x.kind == IK_TYPE: bt = 1
                else if x.kind == IK_BUILTIN:
                    bt = 8
                    if o > 0 and text[o - 1] == '.':
                        # (xs.length: a property; xs.push(x): a method)
                        bt = 6
                        if o + x.len < len(text) and text[o + x.len] == '(': bt = 9
                if bt >= 0: toks[o] = SemTok(x.len, bt, 4)
                continue
            dc = dco!
            t = sem_type(dc.kind)
            if t < 0: continue
            if t == 8 and o > 0 and text[o - 1] == '.': t = 9
            mods = 0
            if dc.file == f and dc.off == x.off: mods |= 1
            if dc.kind == IK_CONST: mods |= 2
            # (the library's own top-level names)
            top = dc.kind != IK_LOCAL and dc.kind != IK_PARAM and dc.kind != IK_FIELD
            if top and dc.file >= 0 and dc.file < r.paths.len() and starts_with(r.paths[dc.file], root_lib + "/"): mods |= 4
            toks[o] = SemTok(x.len, t, mods)
    offs: int[]
    loop o, _ in toks: offs.push(o)
    offs.sort()
    out: str[]
    line = 0
    ch = 0
    loop o in offs:
        tk = toks[o]
        p = lpos_of(text, ls, o)
        if p.line != line: ch = 0
        out.push("{p.line - line},{p.ch - ch},{utf16_units(text, o, o + tk.len)},{tk.type},{tk.mods}")
        line = p.line
        ch = p.ch
    lsp_reply(id, "\{\"data\":[{join(out, ",")}]\}")
# Which lines start a statement, outside brackets or strings. Sloppy recovers
# an unclosed bracket at its original indentation; Dewy braces ignore indentation.
stmt_lines = (text: str, ls: int[]) -> bool[]:
    ok: bool[]
    loop _ in ls: ok.push(true)
    depth = 0
    ind = 0             # the indentation of the line
    oind = 0            # of the line that opened the outermost bracket
    l = 0
    i = 0
    loop true:
        loop l < ls.len() and ls[l] <= i:
            if ls[l] < i: ok[l] = false
            else:
                ind = indent_of(text[i..min(i + 200, len(text))))
                k = i + ind
                if not sy_dewy and depth > 0 and k < len(text) and text[k] != '\n' and ind <= oind and text[k] != ')' and text[k] != ']' and text[k] != '}}': depth = 0
                ok[l] = depth == 0
            l += 1
        if i >= len(text): break
        c = text[i]
        if c == '#':
            i = ide_comment_end(text, i, sy_dewy)
            continue
        if ide_str_start(text, i):
            marks: u8[]
            i = ide_str_end(text, i, marks, 0, sy_dewy)
            continue
        if c == '(' or c == '[' or c == '{{':
            if depth == 0: oind = ind
            depth += 1
        else if (c == ')' or c == ']' or c == '}}') and depth > 0: depth -= 1
        i += 1
    ok
symbols_in = (lines_: str[], from: int, to: int, ind: int) -> str[]:
    out: str[]
    i = from
    loop i < to:
        raw = lines_[i]
        t = trim(raw)
        if len(t) == 0 or t[0] == '#' or indent_of(raw) != ind or not sy_ok[i]:
            i += 1
            continue
        col = indent_of(raw)
        e = block_end(lines_, i, ind)
        if sy_dewy:
            word = ident_prefix(t)
            constant = word == "const" or word == "local_const"
            if constant or word == "let":
                prefix = skip_blanks(t, len(word))
                col += prefix
                t = t[prefix..]
            nm = ident_prefix(t)
            rest = trim(t[len(nm)..])
            if len(nm) > 0 and keywords.get(nm) == none:
                kind = if constant: 14 else: 13
                declared = starts_with(rest, "=") and not starts_with(rest, "==") or starts_with(rest, ":")
                if fn_decl_at(i, col + len(nm)):
                    kind = 12
                else if starts_with(rest, ":") and ident_prefix(trim(rest[1..])) == "type":
                    kind = 5
                    equal = find_byte(rest, '=')
                    if equal >= 0:
                        value = trim(rest[equal + 1..])
                        if starts_with(value, "<"):
                            close = find_byte(value, '>')
                            if close >= 0: value = trim(value[close + 1..])
                        if starts_with(value, "["): kind = 23
                if declared: out.push(sym_json(nm, kind, i, col, e, []))
            i = e + 1
            continue
        if starts_with(t, "@"):
            i += 1
            continue
        if starts_with(t, "when ") and ends_with(t, ":"):
            j = i + 1
            loop j <= e and len(trim(lines_[j])) == 0: j += 1
            if j <= e:
                loop x in symbols_in(lines_, j, e + 1, indent_of(lines_[j])): out.push(x)
            i = e + 1
            continue
        if starts_with(t, "else:") or starts_with(t, "else "):
            j = i + 1
            loop j <= e and len(trim(lines_[j])) == 0: j += 1
            if j <= e and ind == 0:
                loop x in symbols_in(lines_, j, e + 1, indent_of(lines_[j])): out.push(x)
            i = e + 1
            continue
        if starts_with(t, "struct ") or starts_with(t, "enum "):
            isst = starts_with(t, "struct ")
            rest = t[find_byte(t, ' ') + 1..]
            nm = ident_prefix(rest)
            sy_container = nm
            kids: str[]
            # (enum E: a, b on one line)
            colon = find_byte(t, ':')
            if not isst and colon >= 0 and len(trim(t[colon + 1..])) > 0:
                loop part in split(t[colon + 1..], ","):
                    pn = ident_prefix(trim(part))
                    if len(pn) > 0: kids.push(sym_json(pn, 22, i, col + max(0, find(t, pn, colon)), i, []))
            loop j in [i + 1..e + 1):
                ft = trim(lines_[j])
                if len(ft) == 0 or ft[0] == '#' or not sy_ok[j]: continue
                fc = indent_of(lines_[j])
                if isst:
                    fnm = ident_prefix(ft)
                    if len(fnm) > 0: kids.push(sym_json(fnm, 8, j, fc, j, []))
                else:
                    loop part in split(ft, ","):
                        pn = ident_prefix(trim(part))
                        if len(pn) > 0: kids.push(sym_json(pn, 22, j, fc + max(0, find(ft, pn)), j, []))
            k = 23
            if not isst: k = 10
            sy_container = ""
            out.push(sym_json(nm, k, i, col + find(t, nm), e, kids))
        else if starts_with(t, "const "):
            nm = ident_prefix(t[6..])
            if len(nm) > 0: out.push(sym_json(nm, 14, i, col + 6, e, []))
        else if starts_with(t, "type "):
            nm = ident_prefix(t[5..])
            if len(nm) > 0: out.push(sym_json(nm, 5, i, col + 5, e, []))
        else if starts_with(t, "test "):
            q = trim(t[5..])
            if ends_with(q, ":"): q = q[..len(q) - 1)
            out.push(sym_json("test " + q, 24, i, col, e, []))
        else if starts_with(t, "extern "):
            nm = ident_prefix(t[7..])
            if len(nm) > 0: out.push(sym_json(nm, 12, i, col + 7, e, []))
        else:
            nm = ident_prefix(t)
            rest = trim(t[len(nm)..])
            if len(nm) > 0 and keywords.get(nm) == none:
                # name = (params) ...: a function; name = value or name: T: a variable
                if fn_decl_at(i, col + len(nm)): out.push(sym_json(nm, 12, i, col, e, []))
                else if starts_with(rest, "=") and not starts_with(rest, "==") or starts_with(rest, ":") and not ends_with(rest, ":"):
                    out.push(sym_json(nm, 13, i, col, e, []))
        i = e + 1
    out

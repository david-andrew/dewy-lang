$runtime_checks
from p"node_store.dewy" import Node
from p"checker_types.dewy" import (TypeInfo StructInfo TK)
from p"source_types.dewy" import SrcFile
from p"checker_state.dewy" import (FnInst FnCtx)
from p"type_inference.dewy" import (tu_prune tu_unify)
from p"checker_expr.dewy" import check_expr
from p"expr.jo" import (coerce lit_default can_coerce)
from p"check.jo" import (return_place return_sink return_throws return_note shape_returned union_has_void return_void_value return_error)
from p"error_ops.dewy" import (infer_throw)
# `return` and `return value`: where a return may stand, the value checked at the
# declared result (its refinement's representation, a shaped result's dimensions,
# coercion) or unified with an inferred one, and the exceptions an inferred Dewy
# result throws. O(1) per statement plus the demanded checking of the value; the
# value, the inferred-throw log and body sinks are host services that may grow
# every arena, so nodes and contexts are reread by ID.
XTWord:type=int64<overflow='wrap'>
CheckerReturnInput:type=[
    nodes:ptr<array<Node>>
    types:ptr<array<TypeInfo>>
    structs:ptr<array<StructInfo>>
    files:ptr<array<SrcFile>>
    fns:ptr<array<FnInst>>
    contexts:ptr<array<FnCtx>>
    context:ptr<int64>
    last:ptr<int64>
    sink:ptr<int64>
    void_type:ptr<int64>
    never_type:ptr<int64>
]
let xt_nodes:ptr<array<Node>>=$unsafe (uint64(0) as ptr<array<Node>>)
let xt_types:ptr<array<TypeInfo>>=$unsafe (uint64(0) as ptr<array<TypeInfo>>)
let xt_structs:ptr<array<StructInfo>>=$unsafe (uint64(0) as ptr<array<StructInfo>>)
let xt_files:ptr<array<SrcFile>>=$unsafe (uint64(0) as ptr<array<SrcFile>>)
let xt_fns:ptr<array<FnInst>>=$unsafe (uint64(0) as ptr<array<FnInst>>)
let xt_contexts:ptr<array<FnCtx>>=$unsafe (uint64(0) as ptr<array<FnCtx>>)
let xt_context:ptr<int64>=$unsafe (uint64(0) as ptr<int64>)
let xt_last:ptr<int64>=$unsafe (uint64(0) as ptr<int64>)
let xt_sink:ptr<int64>=$unsafe (uint64(0) as ptr<int64>)
let xt_void_type:ptr<int64>=$unsafe (uint64(0) as ptr<int64>)
let xt_never_type:ptr<int64>=$unsafe (uint64(0) as ptr<int64>)
checker_returns_bind=(input:ptr<CheckerReturnInput>):>XTWord=>$unsafe {
    xt_nodes=input[0].nodes
    xt_types=input[0].types
    xt_structs=input[0].structs
    xt_files=input[0].files
    xt_fns=input[0].fns
    xt_contexts=input[0].contexts
    xt_context=input[0].context
    xt_last=input[0].last
    xt_sink=input[0].sink
    xt_void_type=input[0].void_type
    xt_never_type=input[0].never_type
    0
}
xt_kind=(t:XTWord):>TK=>$unsafe {xt_types[0].ptr[tu_prune(t)].kind}
xt_dewy=(n:XTWord):>bool=>$unsafe {xt_files[0].ptr[xt_nodes[0].ptr[n].pos >> 40].is_dewy}
xt_union=(t:XTWord):>bool=>$unsafe {
    xt_types[0].ptr[t].kind =? 'enum_' and xt_structs[0].ptr[XTWord(xt_types[0].ptr[t].st)].union_
}
# `return @place` (NF_MUT 1) in Dewy: a place is not a value, save a function's.
xt_place=(v:XTWord):>void=>$unsafe {
    let k=xt_nodes[0].ptr[v].kind
    if XTWord(xt_nodes[0].ptr[v].flags) & 1 not=? 0 and (k =? 'ident' or k =? 'field' or k =? 'index') and xt_dewy(v) {return_place(v)}
}
# A function whose written result is shaped (`:>array<T length=[m p]>`) checks the
# value's dimensions as it leaves.
xt_shaped=(value:XTWord rt:XTWord):>XTWord=>$unsafe {
    let d=XTWord(xt_fns[0].ptr[XTWord(xt_contexts[0].ptr[xt_context[0]].inst)].decl)
    if d =? 0 or xt_nodes[0].ptr[d].kind not=? 'fn_' or xt_nodes[0].ptr[d].a =? 0 {return value}
    let tn=XTWord(xt_nodes[0].ptr[d].a)
    if xt_nodes[0].ptr[tn].kind not=? 'tarray' or xt_nodes[0].ptr[tn].ival not=? 1 {return value}
    shape_returned(value rt)
}
# A refined result is represented by its base.
xt_representation=(t:XTWord):>XTWord=>$unsafe {
    if xt_types[0].ptr[t].kind =? 'refined' {return tu_prune(XTWord(xt_types[0].ptr[t].elem))}
    t
}
# Frozen FK_INIT ordinal 4: top-level code.
xt_return=(s:XTWord):>void=>$unsafe {
    let c=xt_context[0]
    let inst=XTWord(xt_contexts[0].ptr[c].inst)
    if xt_fns[0].ptr[inst].kind =? 4 and xt_contexts[0].ptr[c].parent <? 0 {return_error(s 0 1)}
    let ret=XTWord(xt_contexts[0].ptr[c].ret)
    let infer=xt_contexts[0].ptr[c].infer_ret
    if not infer and tu_prune(ret) =? xt_never_type[0] and xt_dewy(s) {return_error(s 0 2)}
    let a=XTWord(xt_nodes[0].ptr[s].a)
    if a =? 0 {
        let rt=tu_prune(ret)
        if infer and return_throws(inst) {return_note(s)}
        let k=xt_types[0].ptr[rt].kind
        if k =? 'var' {tu_unify(rt xt_void_type[0]);}
        # A bare return in a `:>void | E` function gives its void member.
        else if xt_union(rt) and union_has_void(rt) {return_void_value(s rt)}
        else if k not=? 'void_' {return_error(s rt 4)}
        return
    }
    xt_place(a)
    if xt_sink[0] >=? 0 {return_sink(xt_nodes[0].ptr[s].pos)}
    if infer and xt_kind(ret) =? 'var' {
        let t=check_expr(a 0)
        xt_nodes[0][s].a=int32<overflow='wrap'>(xt_last[0])
        if not infer_throw(s t) {
            let v=XTWord(xt_nodes[0].ptr[s].a)
            if XTWord(xt_nodes[0].ptr[v].flags) & 256 not=? 0 {
                t=lit_default(v)
                xt_nodes[0][s].a=int32<overflow='wrap'>(coerce(v t))
            }
            tu_unify(ret t);
            if return_throws(inst) {return_note(s)}
        }
        return
    }
    let rt=tu_prune(ret)
    let inferring=infer and return_throws(inst)
    let is_void=xt_types[0].ptr[rt].kind =? 'void_'
    if is_void and not inferring {return_error(s 0 3)}
    let expected=rt
    if is_void {expected=0}
    let t=check_expr(a expected)
    xt_nodes[0][s].a=int32<overflow='wrap'>(xt_last[0])
    if inferring and not can_coerce(0 t rt) and infer_throw(s t) {return}
    if is_void {return_error(s 0 3)}
    let shaped=xt_shaped(XTWord(xt_nodes[0].ptr[s].a) xt_representation(rt))
    xt_nodes[0][s].a=int32<overflow='wrap'>(coerce(shaped rt))
    if inferring {return_note(s)}
}

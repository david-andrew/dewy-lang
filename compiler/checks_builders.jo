mk_name = (name: int, pos: int) -> int:
    n = mk(.ident, pos)
    nodes[n].name = i32(name)
    n
bc_ident = (name: str, pos: int) -> int:
    n = mk(.ident, pos)
    nodes[n].name = i32(intern(name))
    n
bc_bool = (v: bool, pos: int) -> int:
    n = mk(.bool_lit, pos)
    if v: nodes[n].ival = 1
    n
bc_int = (v: int, pos: int) -> int:
    n = mk(.int_lit, pos)
    nodes[n].ival = v
    add_flag(n, NF_LITERAL)
    n
bc_call = (name: str, args: int[], pos: int) -> int:
    c = mk(.call, pos)
    nodes[c].a = i32(bc_ident(name, pos))
    set_list(c, args)
    c
bc_method = (recv: int, name: str, args: int[], pos: int) -> int:
    f = mk(.field, pos)
    nodes[f].a = i32(recv)
    nodes[f].name = i32(intern(name))
    c = mk(.call, pos)
    nodes[c].a = i32(f)
    set_list(c, args)
    c
bc_field = (recv: int, name: str, pos: int) -> int:
    f = mk(.field, pos)
    nodes[f].a = i32(recv)
    nodes[f].name = i32(intern(name))
    f
# A map's key array, read by a loop's lowering: the library's own member,
# but never the program's, so never warned about.
bc_map_keys = (recv: int, pos: int) -> int:
    f = bc_field(recv, "__keys", pos)
    add_flag(f, NF_LOOPCOUNT)
    f
bc_let = (name: str, v: int, pos: int) -> int:
    d = mk(.vardecl, pos)
    nodes[d].name = i32(intern(name))
    nodes[d].b = i32(v)
    d
bc_stmt = (e: int, pos: int) -> int:
    s = mk(.exprstmt, pos)
    nodes[s].a = i32(e)
    s
bc_block = (stmts: int[], pos: int) -> int:
    b = mk(.block, pos)
    set_list(b, stmts)
    b
bc_str = (s: str, pos: int) -> int:
    n = mk(.str_lit, pos)
    nodes[n].sval = i32(intern(s))
    n
bc_if = (c: int, then: int[], else_: int[], pos: int) -> int:
    n = mk(.if_, pos)
    nodes[n].a = i32(c)
    nodes[n].b = i32(bc_block(then, pos))
    if else_.len() > 0: nodes[n].c = i32(bc_block(else_, pos))
    add_flag(n, NF_STMT)
    n
release_call = (n: int, args: int[], expected: int) -> int:
    pos = nodes[n].pos
    t = prune(check_expr(args[0], 0))
    add_flag(args[0], NF_CHECKED)
    if types[t].kind != .array: fatal(pos, "__release_at needs a growable array")
    zero = mk(.intrinsic, pos)
    nodes[zero].aux = i32(int(IN.zeroed))
    target = mk(.index, pos)
    nodes[target].a = i32(args[0])
    nodes[target].b = i32(args[1])
    nodes[n] = nodes[bc_block([bc_assign(target, zero, pos)], pos)]
    check_expr(n, expected)
relocate_call = (n: int, args: int[]) -> int:
    t = prune(check_expr(args[0], 0))
    if tkind(t) != .array: fatal(nodes[n].pos, "relocation needs a growable array")
    check_place(args[0], false)
    check_expr(args[1], T_INT)
    check_expr(args[2], T_INT)
    nodes[n].kind = .intrinsic
    nodes[n].aux = i32(int(IN.relocate))
    nodes[n].a = 0
    set_list(n, args)
    nodes[n].type = i32(T_VOID)
    T_VOID
take_call = (n: int, args: int[]) -> int:
    t = prune(check_expr(args[0], 0))
    if tkind(t) != .array: fatal(nodes[n].pos, "slot transfer needs a growable array")
    check_place(args[0], false)
    check_expr(args[1], T_INT)
    nodes[n].kind = .intrinsic
    nodes[n].aux = i32(int(IN.take_slot))
    nodes[n].a = 0
    set_list(n, args)
    nodes[n].type = i32(telem(t))
    telem(t)

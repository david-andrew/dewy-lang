use 'ir_types.dewy'
use 'backend_analysis.dewy'
use 'x64_encode.dewy'
# ---------------- register allocation ----------------
# Shared location classifications and use summaries live in backend_analysis.
const INF_POS = 1 << 60

vspill: int[]
slot_off: int[]
callee_off: int[]          # save offset per register (0 = not used)

ra_on = true              # false: spill everything (fast debug codegen)
ra_prio = true            # (release builds: allocate_release; DEWY_RA_LINEAR=1: allocate)
callee_pool = [RBX, 12, 13, 14, 15]
is_callee = [false, false, false, true, false, false, false, false, false, false, false, false, true, true, true, true]
caller_pool = [RSI, RDI, R8, R9, R10, R11]

save_list: int[]
ra_expire_visits = 0
ra_spill_visits = 0
ra_peak_gpr = 0
ra_peak_xmm = 0

# Fixed physical-register workspace, private to one sequential allocation.
# Entries in active are written before their count is published.
ra_active_storage: int[] = fill(0, 24)
ra_byreg_storage: int[] = fill(-1, 32)


const VI = 0
xr_ir: *IrFn
xr_debug = false
xr_stats = false
xr_vtype = (v: int) -> int:
    t = int(xr_ir[0].vtypes[v])
    if t == 3: return VI
    t
xr_is_kv = (v: int) -> bool: int(xr_ir[0].vtypes[v]) == 3
xr_kv_of = (v: int) -> int: xr_ir[0].kval[v]
xr_align = (n: int, a: int) -> int: (n + a - 1) & ~(a - 1)
x64_allocate = (input: *IrFn, priority: bool, debug: bool, stats: bool):
    xr_ir = input
    xr_debug = debug
    xr_stats = stats
    if priority: allocate_release()
    else: allocate()
    layout_frame()

hint_op = (op: Op) -> bool:
    match op:
        mov, add, sub, mul, checked_add, checked_sub, checked_mul, and_, or_, xor, shl, shrs, shru, rot32, neg, not_, load: true
        fadd, fsub, fmul, fdiv, fmin, fmax, fneg, fabs: true
        sext8, sext16, sext32, zext8, zext16, zext32: true
        _: false

# operand whose register the value defined at pos can reuse (-1: none)
hint_operand = (v: int, pos: int) -> int:
    if v < xr_ir[0].nparams or pos >= xr_ir[0].code.len(): return -1
    ins = xr_ir[0].code[pos]
    if int(ins.dst) != v or not hint_op(ins.op): return -1
    a = int(ins.a)
    if ins.op == .checked_sub and xr_is_kv(a) and xr_kv_of(a) == 0: a = int(ins.b)
    if a < 0 or a == v or vloc[a] < 0 or v_live[a].last != pos: return -1
    if (vloc[a] >= XMM) != (xr_vtype(v) != VI): return -1
    a

# params are live on entry, before the first instruction
live_start = (v: int) -> int:
    if v < xr_ir[0].nparams: return -1
    v_live[v].first

crosses_call = (s: int, e: int) -> bool:
    lo = 0
    hi = call_pos.len()
    loop lo < hi:
        mid = (lo + hi) / 2
        if call_pos[mid] <= s: lo = mid + 1
        else: hi = mid
    lo < call_pos.len() and call_pos[lo] < e

# is a cheaper to spill than b: fewer weighted uses per instruction it lives (ties: lives longer)
spills_before = (a: int, b: int) -> bool:
    la = v_live[a].last - live_start(a) + 1
    lb = v_live[b].last - live_start(b) + 1
    x = v_live[a].weight * lb
    y = v_live[b].weight * la
    x < y or (x == y and v_live[a].last > v_live[b].last)

# Remove an active interval while preserving the allocator's tie order. The
# list is bounded by the 24 allocatable registers, so spill/coalescing work is
# O(registers), independent of the function's vreg count. No array growth or
# temporary-list removal participates in the sweep.
ra_remove = (active: *int, byreg: *int, n: int, reg: int) -> int:
    k = byreg[reg]
    byreg[reg] = -1
    loop k + 1 < n:
        v = active[k + 1]
        active[k] = v
        byreg[vloc[v]] = k
        k += 1
    n - 1

allocate = ():
    nv = xr_ir[0].vtypes.len()
    callee_off = fill(0, 16)
    if not ra_on:
        loop v in [0..nv):
            if vloc[v] != LOC_CONST and vloc[v] != LOC_FCONST and vloc[v] != LOC_SLOT and vloc[v] != LOC_GLOBAL: vloc[v] = LOC_SPILL
        return
    n = xr_ir[0].code.len() + 1
    # At most eleven GPRs and thirteen vector registers can be occupied.
    # Membership is indexed by physical register, never by the vreg population.
    free = 0x7FFCFFC8
    active = data(ra_active_storage)
    byreg = data(ra_byreg_storage)
    loop r in [0..32): byreg[r] = -1
    nactive = 0
    min_end = INF_POS      # earliest end among active intervals
    call_next = 0
    loop pos in [0..n):
        loop call_next < call_pos.len() and call_pos[call_next] <= pos: call_next += 1
        v = v_start[pos]
        if v >= 0 and min_end < pos:
            # expire old intervals
            min_end = INF_POS
            k = 0
            if xr_stats: ra_expire_visits += nactive
            loop k < nactive:
                a = active[k]
                if v_live[a].last < pos:
                    r = vloc[a]
                    free |= 1 << r
                    byreg[r] = -1
                    nactive -= 1
                    if k < nactive:
                        active[k] = active[nactive]
                        byreg[vloc[active[k]]] = k
                else:
                    if v_live[a].last < min_end: min_end = v_live[a].last
                    k += 1
        loop v >= 0:
            next_call = call_next
            if v < xr_ir[0].nparams: next_call = 0
            crosses = next_call < call_pos.len() and call_pos[next_call] < v_live[v].last
            reg = -1
            # two-operand forms: take over the register of a first operand that dies here
            h = hint_operand(v, pos)
            # (not a caller-saved register for a value living across calls: a callee-saved one
            # costs a move here, not a save and a reload at every call)
            if h >= 0 and crosses and vloc[h] < XMM and not is_callee[vloc[h]]: h = -1
            if h >= 0 and crosses and xr_debug and dbg_keep[v] and vloc[h] >= XMM: h = -1
            if h >= 0 and byreg[vloc[h]] >= 0 and active[byreg[vloc[h]]] == h:
                reg = vloc[h]
                nactive = ra_remove(active, byreg, nactive, reg)
                vsave[v] = crosses and (reg >= XMM or not is_callee[reg])
                if reg < XMM and is_callee[reg]: callee_off[reg] = 1
            else if xr_vtype(v) != VI:
                # all xmm registers are caller-saved: values living across calls are saved around them
                # (not a variable of -g: in the frame then)
                if not (crosses and xr_debug and dbg_keep[v]):
                    loop x in [2..15):
                        if free & (1 << (XMM + x)) != 0:
                            reg = XMM + x
                            vsave[v] = crosses
                            break
            else:
                if not crosses:
                    loop r in caller_pool:
                        if free & (1 << r) != 0:
                            reg = r
                            break
                if reg < 0:
                    loop r in callee_pool:
                        if free & (1 << r) != 0:
                            reg = r
                            break
                if reg < 0 and crosses and not (xr_debug and dbg_keep[v]):
                    loop r in caller_pool:
                        if free & (1 << r) != 0:
                            reg = r
                            vsave[v] = true
                            break
            if reg < 0:
                # steal from the active value that is cheapest to spill for the span it holds
                # a register (used least, outside loops), if that is cheaper than this one
                # (a value living across calls may take a caller-saved register: it is then
                # saved and restored around the calls, which beats reading it from memory at
                # every use when the calls are rarer than the uses)
                best = -1
                if xr_stats: ra_spill_visits += nactive
                loop k in [0..nactive):
                    a = active[k]
                    ra = vloc[a]
                    if (ra >= XMM) != (xr_vtype(v) != VI): continue
                    if crosses and xr_debug and dbg_keep[v] and (ra >= XMM or not is_callee[ra]): continue
                    if not spills_before(a, v): continue
                    if best < 0 or spills_before(a, best): best = a
                if best >= 0:
                    reg = vloc[best]
                    vloc[best] = LOC_SPILL
                    vsave[v] = crosses and (reg >= XMM or not is_callee[reg])
                    nactive = ra_remove(active, byreg, nactive, reg)
            if reg >= 0:
                vloc[v] = reg
                free &= ~(1 << reg)
                byreg[reg] = nactive
                active[nactive] = v
                nactive += 1
                if xr_stats: ra_pressure(active, nactive, -1)
                if v_live[v].last < min_end: min_end = v_live[v].last
                if reg < XMM and is_callee[reg]: callee_off[reg] = 1
            else: vloc[v] = LOC_SPILL
            v = v_live[v].next_start

# release builds: two passes of linear scan. First the integer values living across calls
# in loops or several of them (not counting those on rarely taken paths) get the callee-saved
# registers (where more want one than
# there are, those used most); then the rest are allocated as by allocate, around them, with a
# value living across calls given a caller-saved register (saved and reloaded around each call)
# only when that costs less than spilling it. A bitmap per register marks the instructions pass
# 1 holds it at.
ra_occ: int[]
ra_words = 0
ra_cw: int[]                # prefix sums of call weights
ra_call_cut_storage: i32[]  # release-only instruction boundary -> call ordinal
ra_call_cut: *i32
ra_dump = ""                # (DEWY_RADUMP=f_name: print the allocation of that function)
ra_only = ""                # (DEWY_RA_ONLY=f_name: allocate only that function this way)

# mask of bits lo..hi (0..63) of a word
ra_mask = (lo: int, hi: int) -> int:
    m = -1 << lo
    if hi < 63: m = m & ((1 << (hi + 1)) - 1)
    m

# is register r free at instructions s..e (shifted by 1: parameters start at -1)?
ra_free = (r: int, s: int, e: int) -> bool:
    if s > e: return true
    base = r * ra_words
    ws = s >> 6
    we = e >> 6
    w = ws
    loop w <= we:
        lo = 0
        hi = 63
        if w == ws: lo = s & 63
        if w == we: hi = e & 63
        if ra_occ[base + w] & ra_mask(lo, hi) != 0: return false
        w += 1
    true

ra_take = (r: int, s: int, e: int):
    base = r * ra_words
    ws = s >> 6
    we = e >> 6
    w = ws
    loop w <= we:
        lo = 0
        hi = 63
        if w == ws: lo = s & 63
        if w == we: hi = e & 63
        ra_occ[base + w] = ra_occ[base + w] | ra_mask(lo, hi)
        w += 1

# Weight of calls strictly inside s..e; -1 means exactly one explicit cold call.
ra_cross_w = (s: int, e: int) -> int:
    if call_pos.len() == 0: return 0
    a = int(ra_call_cut[s + 1])
    lo = int(ra_call_cut[e])
    if lo <= a: return 0
    if lo == a + 1:
        call = xr_ir[0].code[call_pos[a]]
        if call.op == .call and call.c == 2: return -1
    ra_cw[lo] - ra_cw[a]

allocate_release = ():
    nv = xr_ir[0].vtypes.len()
    callee_off = fill(0, 16)
    n = xr_ir[0].code.len() + 1
    ra_cw = fill(0, call_pos.len() + 1)
    loop k in [0..call_pos.len()): ra_cw[k + 1] = ra_cw[k] + call_w[k]
    # Only release allocation asks weighted crossing queries. Build their
    # boundary index in O(instructions + calls), then answer each in O(1).
    # Private scratch is reused; no pointer survives a subsequent resize.
    if call_pos.len() > 0:
        if ra_call_cut_storage.len() < n: ra_call_cut_storage.resize(n)
        ra_call_cut = data(ra_call_cut_storage)
        calls = data(call_pos)
        next = 0
        loop pos in [0..n):
            loop next < call_pos.len() and calls[next] < pos: next += 1
            ra_call_cut[pos] = i32(next)
    cross = fill(0, nv)
    loop v in [0..nv):
        if vloc[v] != LOC_SPILL: continue
        cross[v] = ra_cross_w(live_start(v), v_live[v].last)
    ra_words = (n + 1) / 64 + 1
    ra_occ = fill(0, 32 * ra_words)
    # pass 1: integer values living across calls, into callee-saved registers (in order of
    # start; when there are too many, those used most keep them)
    placed = fill(false, nv)
    active = data(ra_active_storage)
    byreg = data(ra_byreg_storage)
    loop r in [0..32): byreg[r] = -1
    nactive = 0
    free = 0xF008                 # callee-saved GPRs
    loop pos in [0..n):
        v = v_start[pos]
        if v < 0: continue
        k = 0
        if xr_stats: ra_expire_visits += nactive
        loop k < nactive:
            a = active[k]
            if v_live[a].last < pos:
                r = vloc[a]
                free |= 1 << r
                byreg[r] = -1
                nactive -= 1
                if k < nactive:
                    active[k] = active[nactive]
                    byreg[vloc[active[k]]] = k
            else: k += 1
        loop v >= 0:
            # (a value crossing just one call outside loops: a caller-saved register saved
            # around it costs the same when the call is made, and nothing on paths without it,
            # where a callee-saved one is saved and restored on every path).
            # A hot parameter crossing one explicit cold call is the exception:
            # reserving a saved register avoids spilling it throughout nested loops.
            if (cross[v] > 1 or cross[v] == -1 and v < xr_ir[0].nparams and v_live[v].weight > 8 * v_live[v].nuse) and xr_vtype(v) == VI:
                reg = -1
                loop r in callee_pool:
                    if free & (1 << r) != 0:
                        reg = r
                        break
                if reg < 0:
                    best = -1
                    if xr_stats: ra_spill_visits += nactive
                    loop k in [0..nactive):
                        a = active[k]
                        if v_live[a].weight < v_live[v].weight and (best < 0 or v_live[a].weight < v_live[best].weight): best = a
                    if best >= 0:
                        reg = vloc[best]
                        vloc[best] = LOC_SPILL
                        placed[best] = false
                        nactive = ra_remove(active, byreg, nactive, reg)
                if reg >= 0:
                    vloc[v] = reg
                    placed[v] = true
                    free &= ~(1 << reg)
                    byreg[reg] = nactive
                    active[nactive] = v
                    nactive += 1
                    if xr_stats: ra_peak_gpr = max(ra_peak_gpr, nactive)
            v = v_live[v].next_start
    loop v in [0..nv):
        if placed[v]:
            ra_take(vloc[v], live_start(v) + 1, v_live[v].last + 1)
            callee_off[vloc[v]] = 1
    # pass 2: the rest by linear scan, around what pass 1 placed
    free = 0x7FFCFFC8
    loop r in [0..32): byreg[r] = -1
    nactive = 0
    min_end = INF_POS
    loop pos in [0..n):
        v = v_start[pos]
        if v >= 0 and min_end < pos:
            min_end = INF_POS
            k = 0
            if xr_stats: ra_expire_visits += nactive
            loop k < nactive:
                a = active[k]
                if v_live[a].last < pos:
                    r = vloc[a]
                    free |= 1 << r
                    byreg[r] = -1
                    nactive -= 1
                    if k < nactive:
                        active[k] = active[nactive]
                        byreg[vloc[active[k]]] = k
                else:
                    if v_live[a].last < min_end: min_end = v_live[a].last
                    k += 1
        loop v >= 0:
            if placed[v]:
                v = v_live[v].next_start
                continue
            s = live_start(v) + 1
            e = v_live[v].last + 1
            c = abs(cross[v])
            # a caller-saved register for a value living across calls: only if saving and
            # reloading it around them costs less than spilling it
            caller_ok = c == 0 or 4 * c < 2 * v_live[v].weight
            reg = -1
            h = hint_operand(v, pos)
            if h >= 0 and byreg[vloc[h]] >= 0 and active[byreg[vloc[h]]] == h:
                r = vloc[h]
                ok = ra_free(r, s + 1, e)
                if r < XMM and not is_callee[r] and not caller_ok: ok = false
                if r >= XMM and not caller_ok: ok = false
                if ok:
                    reg = r
                    nactive = ra_remove(active, byreg, nactive, reg)
            if reg < 0:
                if xr_vtype(v) != VI:
                    if caller_ok:
                        loop x in [2..15):
                            if free & (1 << (XMM + x)) != 0 and ra_free(XMM + x, s, e):
                                reg = XMM + x
                                break
                else:
                    # (across calls: a callee-saved register; across just one outside loops,
                    # one the prologue saves already, else a caller-saved one first)
                    if c > 0:
                        loop r in callee_pool:
                            if free & (1 << r) != 0 and (c > 1 or callee_off[r] != 0) and ra_free(r, s, e):
                                reg = r
                                break
                    if reg < 0 and caller_ok:
                        loop r in caller_pool:
                            if free & (1 << r) != 0 and ra_free(r, s, e):
                                reg = r
                                break
                    if reg < 0 and c <= 1:
                        loop r in callee_pool:
                            if free & (1 << r) != 0 and ra_free(r, s, e):
                                reg = r
                                break
            if reg < 0 and (c == 0 or caller_ok or xr_vtype(v) == VI):
                # steal from the active value cheapest to spill for the span it holds a
                # register, if that is cheaper than this one and the register is free (of
                # pass 1's values) for all of this one
                best = -1
                if xr_stats: ra_spill_visits += nactive
                loop k in [0..nactive):
                    a = active[k]
                    ra = vloc[a]
                    if (ra >= XMM) != (xr_vtype(v) != VI): continue
                    if not spills_before(a, v): continue
                    if (ra >= XMM or not is_callee[ra]) and not caller_ok: continue
                    if not ra_free(ra, s, e): continue
                    if best < 0 or spills_before(a, best): best = a
                if best >= 0:
                    reg = vloc[best]
                    vloc[best] = LOC_SPILL
                    vsave[best] = false
                    nactive = ra_remove(active, byreg, nactive, reg)
            if reg >= 0:
                vloc[v] = reg
                vsave[v] = c > 0 and (reg >= XMM or not is_callee[reg])
                free &= ~(1 << reg)
                byreg[reg] = nactive
                active[nactive] = v
                nactive += 1
                if xr_stats: ra_pressure(active, nactive, pos)
                if v_live[v].last < min_end: min_end = v_live[v].last
                if reg < XMM and is_callee[reg]: callee_off[reg] = 1
            else: vloc[v] = LOC_SPILL
            v = v_live[v].next_start
    if len(ra_dump) > 0 and xr_ir[0].name == ra_dump:
        loop v in [0..nv):
            if v_live[v].last < 0: continue
            tag = ""
            if placed[v]: tag = " (pass 1)"
            eprint("v{v} {live_start(v)}..{v_live[v].last} w {v_live[v].weight} calls {abs(cross[v])} -> {vloc[v]}{tag}")

layout_frame = ():
    off = 0
    loop r in [0..16):
        if callee_off[r] != 0:
            off += 8
            callee_off[r] = -off
    nv = xr_ir[0].vtypes.len()
    vspill = fill(0, nv)
    save_list = []
    loop v in [0..nv):
        if vloc[v] == LOC_SPILL or (vsave[v] and vloc[v] >= 0):
            off += 8
            if is_vreg_vec(xr_vtype(v)): off += 24      # (vectors take 32 bytes)
            vspill[v] = -off
            if vloc[v] >= 0: save_list.push(v)
    slot_off = fill(0, xr_ir[0].slot_size.len())
    loop s in [0..xr_ir[0].slot_size.len()):
        sz = int(xr_ir[0].slot_size[s])
        al = int(xr_ir[0].slot_align[s])
        off = xr_align(off + sz, al)
        slot_off[s] = -off
    frame_size = xr_align(off, 16)

# Diagnostics only: the bounded active state includes both register classes.
ra_pressure = (active: *int, n: int, pos: int):
    gpr = 0
    loop k in [0..n):
        if vloc[active[k]] < XMM: gpr += 1
    ra_peak_xmm = max(ra_peak_xmm, n - gpr)
    if pos >= 0:
        loop r in callee_pool:
            if ra_occ[r * ra_words + ((pos + 1) >> 6)] & (1 << ((pos + 1) & 63)) != 0: gpr += 1
    ra_peak_gpr = max(ra_peak_gpr, gpr)

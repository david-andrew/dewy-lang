use 'checker_state.dewy'
use 'checker_tokens.dewy'
use 'refinement_types.dewy'
# Reuse a checked members(U) body only when its decisions are uniform across U.
# The first copy is checked normally. Restricted syntax excludes escapes, new type
# inference, compile-time member evaluation and narrowing. Unknown decisions fall
# back before the second copy; the first copy is already the ordinary result.
# Partial destinations and overload scores fall back. The bounded native path
# keeps ordered literal columns and one checked body. Consumers that need
# individual decisions can materialize the original checked bodies on demand.
# DEWY_MEMBERS=reference disables all replay, checked tests only checker replay,
# expanded retains IR matching, and trace reports the selected path.
use 'reflection.jo'
use 'main.jo'
use 'ast.jo'
use 'node_store.dewy'
use 'check.jo'
use 'expr.jo'
use 'types.jo'
use 'facts.jo'
use 'refine.jo'
use 'exact.jo'
use 'warn_if.jo'
use 'ide.jo'
use 'util.jo'
use 'lex.jo'
use 'sibling_types.jo'
use 'isolation.jo'
use 'isolation_ops.dewy'

struct MemberTemplate:
    body: int = 0
    owner: int = 0
    positions: {int: bool}
    bindings: {int: bool}
    dependent: {int: bool}
    texts: str[]
    domain: {str: bool}
    decisions: {int: int}
    locals: int[]
    requests: int[]
    refinements: int[]
    # Ordered scope identities and literal destinations for a parameterized body.
    scopes: int[]
    values: {int: int[]}
    columns: {int: int}       # source position -> string set, or 0 for text
    view_proofs: int[]        # (checked site, site in the executable view) pairs
    view: int = 0
    empty: int = 0
    block: int = 0
    compact: bool = false
    shared_proofs: bool = false
    okay: bool = true

member_templates: MemberTemplate[]
member_scopes: {int: int}
member_scope_locals: {int: int[]}
member_compact_owners: {int: int[]}
member_words: {int: {str: int}}
member_plain_types: {int: bool}
member_record = -1
member_enabled = false
member_compact_enabled = false
member_trace = false

# (Dewy's unions have no numbers; a trace reports the kind by its ordinal)
member_kind_ordinal = (n: int) -> int: int(nodes[n].kind)

use 'checker_state.dewy'
use 'checker_tokens.dewy'
use 'refinement_types.dewy'
# Reuse a checked members(U) body only when its decisions are uniform across U.
# The first copy is checked normally. Restricted syntax excludes escapes, new type
# inference, compile-time member evaluation and narrowing. Unknown decisions fall
# back before the second copy; the first copy is already the ordinary result.
# Literal destinations and overload membership scores cover every member. Replayed
# copies get their own locals, literal values, and deferred proof requests. Facts
# and lowering see exactly those per-member copies, never a union-typed substitute.
# O(B + D + T + M*B + sum(S)) time and storage: B body nodes, D source
# domain, T reachable types, M copies, S destination domains. All relocation and domain
# membership is indexed. No work for non-reflective loops; reference mode is the
# differential oracle (DEWY_MEMBERS=reference, trace prints admission decisions).
use 'reflection.jo'
use 'main.jo'
use 'ast.jo'
use 'node_store.dewy'
use 'check.jo'
use 'expr.jo'
use 'types.jo'
use 'facts.jo'
use 'refine.jo'
use 'exact.jo'
use 'warn_if.jo'
use 'ide.jo'
use 'util.jo'
use 'lex.jo'
use 'sibling_types.jo'
use 'isolation.jo'
use 'isolation_ops.dewy'

struct MemberTemplate:
    body: int = 0
    owner: int = 0
    positions: {int: bool}
    bindings: {int: bool}
    dependent: {int: bool}
    texts: str[]
    domain: {str: bool}
    decisions: {int: int}
    locals: int[]
    requests: int[]
    refinements: int[]
    okay: bool = true

member_templates: MemberTemplate[]
member_scopes: {int: int}
member_scope_locals: {int: int[]}
member_words: {int: {str: int}}
member_plain_types: {int: bool}
member_record = -1
member_enabled = false
member_trace = false

# (Dewy's unions have no numbers; a trace reports the kind by its ordinal)
member_kind_ordinal = (n: int) -> int: int(nodes[n].kind)

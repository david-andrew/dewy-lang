$runtime_checks
from p"ast.jo" import (clone kid kids nkids nodes set_list)
from p"check.jo" import (LF_ALIAS LF_BYREF LF_CAPTURE LF_CAPTURED LF_CONST LF_ELEMALIAS LF_SHARED LF_SOAELEM interp_appends locals syms)
from p"checker_expr.dewy" import (check_expr lookup)
from p"types.jo" import (T_STR prune tkind)

AppendAssignWord:type=int64<overflow='wrap'>
# Frozen Tok ordinals stored in checked nodes.
const append_plus:int32=58
const append_pluseq:int32=48

# s = s + x on text or an array: s += x, which adds to the end in place; the other copies all of
# s each time, and a loop of them takes time growing with the square of the length
append_assign=(s:AppendAssignWord):>void=>{
    let lhs=AppendAssignWord(nodes[s].a)
    if nodes[lhs].kind not=? 'ident' {return}
    let spine:array<int64>=[]
    let n=AppendAssignWord(nodes[s].b)
    loop nodes[n].kind =? 'binary' and nodes[n].op =? append_plus {
        spine.push(n)
        n=AppendAssignWord(nodes[n].a)
    }
    if spine.length =? 0 or nodes[n].kind not=? 'ident' or nodes[n].name not=? nodes[lhs].name {return}
    let sy=lookup(AppendAssignWord(nodes[lhs].name))
    if sy =? 0 or (syms[sy].kind not=? 'local' and syms[sy].kind not=? 'global') {return}
    let kind=tkind(prune(check_expr(clone(lhs) 0)))
    if kind not=? 'str_' and kind not=? 'array' {return}
    # Keep the remaining terms of the left-associative chain in order.
    let rest=nodes[spine[AppendAssignWord(spine.length) - 1]].b
    if spine.length =? 1 {nodes[s].b=rest}
    else {nodes[spine[AppendAssignWord(spine.length) - 2]].a=rest}
    nodes[s].op=append_pluseq
}

interp_append_assign=(s:AppendAssignWord):>void=>{
    let lhs=AppendAssignWord(nodes[s].a)
    let rhs=AppendAssignWord(nodes[s].b)
    if nodes[lhs].kind not=? 'ident' or nodes[rhs].kind not=? 'str_lit' or nodes[rhs].aux not=? 1 or nkids(rhs) <? 2 {return}
    let first=kid(rhs 0)
    if nodes[first].kind not=? 'pair' or nodes[first].sval not=? -1 {return}
    let v=AppendAssignWord(nodes[first].a)
    if nodes[v].kind not=? 'ident' or nodes[v].name not=? nodes[lhs].name {return}
    let sy=lookup(AppendAssignWord(nodes[lhs].name))
    if sy =? 0 or syms[sy].kind not=? 'local' {return}
    let l=AppendAssignWord(syms[sy].ref)
    if AppendAssignWord(locals[l].flags) & (LF_CAPTURED | LF_SHARED | LF_BYREF | LF_CAPTURE | LF_ALIAS | LF_ELEMALIAS | LF_SOAELEM | LF_CONST) not=? 0 {return}
    if prune(AppendAssignWord(locals[l].type)) not=? T_STR {return}
    let rest=kids(rhs)
    rest.pop(0);
    set_list(rhs rest)
    nodes[s].op=append_pluseq
    interp_appends[s]=true
}

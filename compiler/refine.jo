# Scalar contracts are immutable type metadata. Evaluated values and proof
# answers belong to facts.jo and never participate in interning.
use 'ast.jo'
use 'lex.jo'
use 'types.jo'
use 'check.jo'
use 'expr.jo'
use 'facts.jo'
use 'lower.jo'
use 'ir.jo'
use 'util.jo'
use 'witness.jo'

struct RefTerm:
    kind: int = 0 # self, literal, formal ordinal, stable lexical declaration, type limit
    value: int = 0
    unsigned: bool = false
    path: int[]

struct RefAtom:
    op: Tok
    a: RefTerm
    b: RefTerm

ref_predicates: RefAtom[][] = [[]]
# Declaration spans for diagnostics only; never part of predicate identity.
ref_spans: {int: int} = {}
refine_active = false
ref_addr_type = 0
ref_addr_max = () -> int: if ptr_size == 4: 4294967295 else: 281474976710655

refine_fields: int[]
refine_formals: int[]
refine_self = 0
refine_base_type = 0
refine_requests: FactRequest[]
refine_owners: {int: bool} = {}
# refinement checks made by an implicit narrowing, with the width they narrow to
ref_narrowing: {int: int} = {}
refine_entry: int[]
refine_ir_entry: int[]

representation_type = (t0: int) -> int:
    t = prune(t0)
    if types[t].kind == .refined: return prune(int(types[t].elem))
    t

# t with every refinement inside it dropped, as a reader sees it: formatting writes a value out
# and never stores into it, so an array of refined elements reads as an array of their base
representation_deep = (t0: int) -> int:
    t = representation_type(t0)
    k = types[t].kind
    if k == .array: return mk_array(representation_deep(int(types[t].elem)))
    if k == .fixed: return mk_fixed(representation_deep(int(types[t].elem)), fixed_len(t))
    if k == .opt: return mk_opt(representation_deep(int(types[t].elem)))
    if k == .tuple:
        a: int[]
        loop i in [0..int(types[t].nargs)): a.push(representation_deep(targ(t, i)))
        return mk_tuple(a)
    t

# String literal sets (`'a'|'b'`): an enum whose variant i is member i, so a
# value is one word at run time (the member's index); `=?`, `is?` and `match`
# compare that word, and the text is made only where the value meets a string.
str_sets: str[][] = [[]]
str_set_types: int[] = [0]

# (a set keeps its first spelling's order)
str_set_type = (values: str[]) -> int:
    id = 0
    loop i in [1..str_sets.len()):
        if id == 0 and str_sets[i].len() == values.len():
            same = true
            loop value in values:
                if not str_sets[i].contains(value): same = false
            if same: id = i
    if id == 0:
        str_sets.push(values)
        str_set_types.push(0)
        id = str_sets.len() - 1
    if str_set_types[id] != 0: return str_set_types[id]
    si = StructInfo(decl = 0, name = str_set_text(id), resolved = true)
    si.lit_set = i32(id)
    si.variants = i32(variants.len())
    si.nvariants = i32(values.len())
    loop i in 0.. and value in str_sets[id]:
        variants.push(Variant(name = i32(intern(value)), fields = i32(fields.len()), nfields = 0, tag = i32(i), value = i))
    idx = structs.len()
    structs.push(si)
    types.push(TypeInfo(kind = .enum_, st = i32(idx)))
    structs[idx].type = i32(types.len() - 1)
    str_set_types[id] = types.len() - 1
    types.len() - 1

# The written order of a literal union's members (`#1`, `'fast`), by the members
# as a set: interned types forget it, and `members(U)` follows it. (the first
# spelling of a set keeps its order, as `str_sets` do)
literal_orders: {str: str[]} = {}

literal_order_key = (keys: str[]) -> str: join(keys.sorted(), "\x00")

literal_order_note = (written: str[]):
    if written.len() < 2: return
    key = literal_order_key(written)
    if not literal_orders.has(key): literal_orders[key] = written

# the string set a type is, or 0
str_set_of = (t0: int) -> int:
    t = prune(t0)
    if types[t].kind != .enum_: return 0
    int(structs[int(types[t].st)].lit_set)

# totaldict<K V>: a dictionary with an entry for every value of its finite key
# type. A refined Map (marked by bits -1, with no predicate) whose literal is
# checked for every key, which refuses pop and clear, and which a dict that may
# be partial does not become.
total_literals: {int: bool} = {}

total_dict_type = (map: int, pos: int) -> int:
    if not total_dict_keys(struct_targ(int(types[prune(map)].st), 0)).0: fatal(pos, "totaldict needs a finite key type (a union of literals), found {dt(struct_targ(int(types[prune(map)].st), 0))}")
    refine_active = true
    mk_type(TypeInfo(kind = .refined, elem = i32(map), bits = -1), [])

is_total_dict = (t0: int) -> bool:
    t = prune(t0)
    types[t].kind == .refined and types[t].bits == -1

# every value of a finite key type, as text (`'0b'`, `3`): (finite, values)
total_dict_keys = (t0: int) -> (bool, str[]):
    t = prune(t0)
    out: str[]
    if is_union(t):
        loop m in union_members(t):
            ok, values = total_dict_keys(m)
            if not ok: return (false, out)
            out += values
        return (true, out)
    set = str_set_of(t)
    if set != 0:
        loop value in str_sets[set]: out.push("'{value}'")
        return (true, out)
    if types[t].kind != .refined: return (false, out)
    known, intervals = int_intervals(t)
    if not known: return (false, out)
    loop k in [0..intervals.len() / 2):
        if intervals[2 * k + 1] - intervals[2 * k] > 4096: return (false, out)
        loop v in [intervals[2 * k]..intervals[2 * k + 1]]: out.push("{v}")
    (true, out)

# a dictionary literal given for a totaldict: an entry for every key
total_literal_check = (n: int, t: int):
    _, keys = total_dict_keys(struct_targ(int(types[prune(int(types[prune(t)].elem))].st), 0))
    given: str[]
    loop pair in kids(n):
        key = kid_lit(int(nodes[pair].a))
        if nodes[key].kind == .str_lit: given.push("'{name_of(int(nodes[key].sval))}'")
        else if nodes[key].kind == .int_lit: given.push("{nodes[key].ival}")
        else if nodes[key].kind == .unary and nodes[kid_lit(int(nodes[key].a))].kind == .int_lit: given.push("{-nodes[kid_lit(int(nodes[key].a))].ival}")
        else: fatal(nodes[int(nodes[pair].a)].pos, "a totaldict literal's keys are literals, so every key is seen to be there")
    missing: str[]
    loop key in keys:
        if not given.contains(key): missing.push(key)
    if missing.len() > 0: fatal(nodes[n].pos, "this totaldict has no entry for {join(missing, ", ")}")
    total_literals[n] = true

total_dict_coerce = (n: int, t: int) -> int:
    base = int(types[prune(t)].elem)
    if total_literals.has(n):
        coerce(n, base)
        return n
    source = prune(refine_storage(n, ntype(n)))
    if source == prune(t) or nodes[n].kind == .call and is_total_dict(call_result_type(n)) or total_const(n, t):
        coerce(n, base)
        return n
    fatal(nodes[n].pos, "a {dt(representation_type(ntype(n)))} may be missing keys, so it is not a {dt(t)} (a totaldict is made from a literal with every key)")
    n

# a `const` dictionary whose literal has every key is total wherever it is used
total_const = (n: int, t: int) -> bool:
    if nodes[n].kind != .ident or nodes[n].aux != i32(int(SK.global)): return false
    g = globals[int(nodes[n].sym)]
    decl = int(g.decl)
    if decl == 0 or nodes[decl].kind != .vardecl or not has_flag(decl, NF_RDONLY): return false
    init = int(nodes[decl].b)
    if init == 0 or nodes[init].kind != .map_lit: return false
    if not type_eq(representation_type(int(g.type)), int(types[prune(t)].elem)): return false
    _, keys = total_dict_keys(struct_targ(int(types[prune(int(types[prune(t)].elem))].st), 0))
    given: str[]
    loop pair in kids(init):
        key = kid_lit(int(nodes[pair].a))
        if nodes[key].kind == .str_lit: given.push("'{name_of(int(nodes[key].sval))}'")
        else if nodes[key].kind == .dotname and str_set_of(ntype(key)) != 0: given.push("'{str_sets[str_set_of(ntype(key))][int(nodes[key].aux)]}'")
        else if nodes[key].kind == .int_lit: given.push("{nodes[key].ival}")
    loop key in keys:
        if not given.contains(key): return false
    true

call_result_type = (n: int) -> int:
    f = int(nodes[n].sym)
    if f <= 0 or f >= fns.len(): return 0
    int(fns[f].ret)

# member i of set id as a constant
str_set_const = (id: int, i: int, pos: int) -> int:
    c = mk(.dotname, pos)
    nodes[c].name = i32(intern(str_sets[id][i]))
    nodes[c].aux = i32(i)
    nodes[c].type = i32(str_set_types[id])
    add_flag(c, NF_CHECKED)
    c

str_set_text = (id: int) -> str:
    text = ""
    loop value in str_sets[id]:
        if len(text) > 0: text += " | "
        text += "'{value}'"
    text

refine_reset = ():
    str_sets = [[]]
    total_literals = {}
    str_set_types = [0]
    literal_orders = {}
    ref_predicates = [[]]
    refine_active = false
    refine_fields = []
    ref_addr_type = 0
    refine_formals = []
    refine_self = 0
    refine_requests = []
    refine_owners = {}
    ref_narrowing = {}
    ref_spans = {}

ref_span_copy = (from: int, to: int):
    if from != to and not ref_spans.has(to):
        if let at = ref_spans.get(from): ref_spans[to] = at

ref_term_less = (a: RefTerm, b: RefTerm) -> bool:
    if a.kind != b.kind: return a.kind < b.kind
    if a.unsigned != b.unsigned: return not a.unsigned
    if a.value != b.value: return a.value < b.value
    loop i in [0..min(a.path.len(), b.path.len())):
        if a.path[i] != b.path[i]: return a.path[i] < b.path[i]
    a.path.len() < b.path.len()

ref_atom_less = (a: RefAtom, b: RefAtom) -> bool:
    if a.a != b.a: return ref_term_less(a.a, b.a)
    if a.b != b.b: return ref_term_less(a.b, b.b)
    int(a.op) < int(b.op)

ref_intern = (atoms0: RefAtom[]) -> int:
    atoms: RefAtom[]
    loop atom in atoms0:
        i = 0
        loop i < atoms.len() and ref_atom_less(atoms[i], atom): i += 1
        if i == atoms.len() or atoms[i] != atom: atoms.insert(i, atom)
    loop i in [1..ref_predicates.len()):
        if ref_predicates[i] == atoms: return i
    ref_predicates.push(atoms)
    ref_predicates.len() - 1

mk_refined = (base0: int, predicate: int) -> int:
    base = prune(base0)
    declared = predicate
    let predicate = predicate
    if types[base].kind == .refined:
        predicate = ref_intern(ref_predicates[int(types[base].st)] + ref_predicates[predicate])
        base = int(types[base].elem)
    normalized: RefAtom[]
    dependencies: int[]
    loop original in ref_predicates[predicate]:
        atom = original
        atom.a = ref_resolve_limit(atom.a)
        atom.b = ref_resolve_limit(atom.b)
        loop term in [atom.a, atom.b]:
            if term.kind == 4: dependencies.push(term.value)
        normalized.push(atom)
    predicate = ref_intern(normalized)
    ref_span_copy(declared, predicate)
    if not is_int(base) and types[base].kind != .array and not has_var(base): fatal(-1, "refinement requires an integer or array base")
    if not has_var(base) and is_int(base):
        loop atom in ref_predicates[predicate]:
            loop term in [atom.a, atom.b]:
                if term.kind != 1: continue
                if term.unsigned and base != T_U64 or not term.unsigned and not int_fits(term.value, base):
                    fatal(-1, "refinement bound is outside its integer representation")
    refine_active = true
    mk_type(TypeInfo(kind = .refined, elem = i32(base), st = i32(predicate)), dependencies)

ref_term = (n: int, binder: int) -> RefTerm:
    k = nodes[n].kind
    if k == .ident:
        name = int(nodes[n].name)
        if name == binder and binder != 0: return RefTerm()
        if name_of(name) == "length" and tkind(refine_base_type) == .array: return RefTerm(path = [-1])
        loop i in [0..refine_fields.len()):
            if name == refine_fields[i]: return RefTerm(5, i)
        loop i in [0..refine_formals.len()):
            if name == refine_formals[i]: return RefTerm(2, i)
        sym = lookup(name)
        if sym != 0 and syms[sym].kind == .const_:
            value = clone(n)
            check_expr(value, 0)
            if not is_int(ntype(value)): fatal(nodes[n].pos, "refinement bound must be an integer")
            result = ceval(value)
            return RefTerm(1, result.i, ntype(value) == T_U64 and result.i < 0)
        if sym != 0 and syms[sym].kind == .local:
            l = int(syms[sym].ref)
            if cx < 0 or locals[l].owner != ctxs[cx].inst: fatal(nodes[n].pos, "captured refinement dependencies await closure invariant checking")
            if int(locals[l].flags) & LF_CONST == 0: fatal(nodes[n].pos, "refinement dependency must be a stable binding")
            return RefTerm(3, l)
        fatal(nodes[n].pos, "unsupported refinement term '{name_of(name)}'")
    if k == .int_lit: return RefTerm(1, nodes[n].ival, has_flag(n, NF_U64))
    if k == .unary and nodes[n].op == i32(int(Tok.minus)):
        term = ref_term(int(nodes[n].a), binder)
        if term.kind != 1 or term.unsigned: fatal(nodes[n].pos, "unsupported refinement bound")
        term.value = -term.value
        return term
    if k == .field:
        base = int(nodes[n].a)
        if nodes[base].kind == .ident:
            spelling = name_of(int(nodes[base].name))
            ty = T_VOID
            if spelling == "int64": ty = T_INT
            else if spelling == "int8": ty = T_I8
            else if spelling == "int16": ty = T_I16
            else if spelling == "int32": ty = T_I32
            else if spelling == "uint64": ty = T_U64
            else if spelling == "uint8": ty = T_U8
            else if spelling == "uint16": ty = T_U16
            else if spelling == "uint32": ty = T_U32
            if ty == T_VOID:
                symbol = lookup(int(nodes[base].name))
                if symbol != 0 and syms[symbol].kind == .type_: ty = int(syms[symbol].ref)
            member = name_of(int(nodes[n].name))
            if ty != T_VOID and has_var(ty) and (member == "min" or member == "max"): return RefTerm(4, ty, member == "max")
            if ty != T_VOID and (member == "min" or member == "max"):
                if ty == T_U64: return RefTerm(1, (if member == "max": -1 else: 0), member == "max")
                if ty == ref_addr_type: return RefTerm(1, if member == "max": ref_addr_max() else: 0)
                bound = fact_domain(ty)
                return RefTerm(1, if member == "max": bound.hi else: bound.lo)
        term = ref_term(base, binder)
        if term.kind == 1 or term.kind == 4: fatal(nodes[n].pos, "refinement projection requires a value")
        term.path.push(if name_of(int(nodes[n].name)) == "length": -1 else: int(nodes[n].name))
        return term
    fatal(nodes[n].pos, "unsupported refinement term; expected a scalar binding or integer bound")
    RefTerm()

ref_add = (op0: Tok, a0: RefTerm, b0: RefTerm, out: mut RefAtom[]):
    op = op0; a = a0; b = b0
    if op == .gt or op == .ge:
        a = b0; b = a0
        op = if op == .gt: Tok.lt else: Tok.le
    if op == .eq:
        out.push(RefAtom(.le, a, b))
        out.push(RefAtom(.le, b, a))
    else:
        if op == .ne and ref_term_less(b, a): a = b0; b = a0
        out.push(RefAtom(op, a, b))

ref_atoms = (n: int, binder: int, out: mut RefAtom[], depth: int = 0):
    if depth > 32 or out.len() >= 32: fatal(nodes[n].pos, "refinement predicate budget exhausted")
    if nodes[n].kind == .and_:
        ref_atoms(int(nodes[n].a), binder, out, depth + 1)
        ref_atoms(int(nodes[n].b), binder, out, depth + 1)
        return
    if nodes[n].kind == .not_:
        inner = int(nodes[n].a)
        if nodes[inner].kind == .binary and fact_comparison(nodes[inner].op as Tok):
            ref_add(fact_inverse(nodes[inner].op as Tok), ref_term(int(nodes[inner].a), binder), ref_term(int(nodes[inner].b), binder), out)
            return
    if nodes[n].kind != .binary: fatal(nodes[n].pos, "unsupported refinement predicate; expected an integer comparison")
    op = nodes[n].op as Tok
    a = int(nodes[n].a); b = int(nodes[n].b)
    if op == .kw_in and nodes[b].kind == .range:
        lo = ref_term(int(nodes[b].a), binder)
        hi = ref_term(int(nodes[b].b), binder)
        if lo.kind != 1 or hi.kind != 1: fatal(nodes[b].pos, "refinement range needs literal bounds")
        value = ref_term(a, binder)
        ref_add((if has_flag(b, NF_EXCL_FIRST): Tok.lt else: Tok.le), lo, value, out)
        ref_add((if has_flag(b, NF_INCLUSIVE): Tok.le else: Tok.lt), value, hi, out)
        return
    if not fact_comparison(op): fatal(nodes[n].pos, "unsupported refinement predicate; expected an integer comparison")
    if nodes[a].kind == .binary and fact_comparison(nodes[a].op as Tok):
        earlier = nodes[a].op as Tok
        if not ((earlier == .lt or earlier == .le) and (op == .lt or op == .le) or (earlier == .gt or earlier == .ge) and (op == .gt or op == .ge)):
            fatal(nodes[n].pos, "refinement comparison chain must have one direction")
        ref_atoms(a, binder, out, depth + 1)
        a = int(nodes[a].b)
    ref_add(op, ref_term(a, binder), ref_term(b, binder), out)

resolve_refinement = (n: int) -> int:
    base = resolve_type(int(nodes[n].a))
    binder = if nodes[n].name != 0: int(nodes[n].name) else: refine_self
    atoms: RefAtom[]
    previous_base = refine_base_type
    refine_base_type = base
    ref_atoms(int(nodes[n].b), binder, atoms)
    refine_base_type = previous_base
    expected = if tkind(representation_type(base)) == .array: T_INT else: representation_type(base)
    loop atom in atoms:
        loop term in [atom.a, atom.b]:
            if refine_fields.len() > 0 and term.kind == 2: fatal(nodes[n].pos, "record field refinement dependencies must name siblings or stable lexical bindings")
            root = 0
            if term.kind == 0: root = base
            else if term.kind == 3: root = int(locals[term.value].type)
            if root == 0: continue
            actual = ref_projection_type(root, term.path, nodes[n].pos)
            if not has_var(actual) and not is_int(actual): fatal(nodes[n].pos, "refinement comparisons require scalar or length projections")
            if not has_var(actual) and not has_var(expected) and not type_eq(actual, expected): fatal(nodes[n].pos, "dependent scalar refinement requires matching integer representations")
    predicate = ref_intern(atoms)
    if not ref_spans.has(predicate): ref_spans[predicate] = nodes[n].pos
    mk_refined(base, predicate)

refine_storage = (n: int, fallback: int) -> int:
    if nodes[n].kind == .field:
        t = representation_type(ntype(int(nodes[n].a)))
        if types[t].kind == .tuple and nodes[n].aux == -2: return targ(t, nodes[n].ival)
        if types[t].kind == .struct_ and nodes[n].aux >= 0:
            return int(fields[int(structs[int(types[t].st)].fields) + int(nodes[n].aux)].type)
    if nodes[n].kind == .index:
        t = representation_type(ntype(int(nodes[n].a)))
        if types[t].kind == .array or types[t].kind == .fixed: return int(types[t].elem)
    if nodes[n].kind == .ident:
        if nodes[n].aux == i32(int(SK.local)):
            l = int(nodes[n].sym)
            if int(locals[l].flags) & LF_ALIAS != 0 and locals[l].alias != 0: return refine_storage(int(locals[l].alias), fallback)
        if nodes[n].aux == i32(int(SK.local)): return int(locals[int(nodes[n].sym)].type)
        if nodes[n].aux == i32(int(SK.global)): return int(globals[int(nodes[n].sym)].type)
    fallback

# A string stored as a string set: a member literal is its word, another
# literal an error, and any other string is looked up when it runs (a string
# that is not a member panics). A set's value in a smaller or larger set is
# mapped member by member.
str_set_coerce = (n: int, t: int) -> int:
    id = str_set_of(t)
    source = str_set_of(ntype(n))
    pos = nodes[n].pos
    if source == id: return n
    if source != 0:
        if nodes[n].kind == .dotname:
            text = str_sets[source][int(nodes[n].aux)]
            k = str_sets[id].index_of(text)
            if k < 0: fatal(pos, "'{text}' is not one of {str_set_text(id)}")
            nodes[n] = nodes[str_set_const(id, k, pos)]
            return n
        str_set_text_of(n)
    else: coerce(n, T_STR)
    e = kid_lit(n)
    if nodes[e].kind == .str_lit and nodes[e].aux != 1:
        text = name_of(int(nodes[e].sval))
        k = str_sets[id].index_of(text)
        if k < 0: fatal(pos, "'{text}' is not one of {str_set_text(id)}")
        nodes[n] = nodes[str_set_const(id, k, pos)]
        return n
    inner = nodes.len()
    nodes.push(nodes[n])
    held = "__set{inner}"
    out = bc_call("panic", [bc_str("a string that is not one of {str_set_text(id)}", pos)], pos)
    k = str_sets[id].len() - 1
    loop k >= 0:
        same = bc_bin(.eq, bc_ident(held, pos), bc_str(str_sets[id][k], pos), pos)
        out = str_set_choice(same, str_set_const(id, k, pos), out, pos)
        k -= 1
    nodes[n] = nodes[bc_block([bc_assign(bc_ident(held, pos), inner, pos), bc_stmt(out, pos)], pos)]
    check_expr(n, t)
    n

# if c a else b, as a value
str_set_choice = (c: int, a: int, b: int, pos: int) -> int:
    n = mk(.if_, pos)
    nodes[n].a = i32(c)
    nodes[n].b = i32(bc_block([bc_stmt(a, pos)], pos))
    nodes[n].c = i32(bc_block([bc_stmt(b, pos)], pos))
    n

# A set's value where a string is wanted: its member's text
str_set_text_of = (n: int):
    id = str_set_of(ntype(n))
    pos = nodes[n].pos
    if nodes[n].kind == .dotname:
        nodes[n] = nodes[bc_str(str_sets[id][int(nodes[n].aux)], pos)]
        check_expr(n, T_STR)
        return
    inner = nodes.len()
    nodes.push(nodes[n])
    held = "__set{inner}"
    k = str_sets[id].len() - 1
    out = bc_str(str_sets[id][k], pos)
    k -= 1
    loop k >= 0:
        same = bc_bin(.eq, bc_ident(held, pos), str_set_const(id, k, pos), pos)
        out = str_set_choice(same, bc_str(str_sets[id][k], pos), out, pos)
        k -= 1
    nodes[n] = nodes[bc_block([bc_assign(bc_ident(held, pos), inner, pos), bc_stmt(out, pos)], pos)]
    check_expr(n, T_STR)

refine_coerce = (n: int, target: int) -> int:
    t = prune(target)
    if types[t].bits == -1: return total_dict_coerce(n, t)
    coerce(n, int(types[t].elem))
    if nodes[n].kind == .conv and nodes[n].aux == i32(int(CV.refinement)) and nodes[n].aux2 == i32(t): return n
    owner = if cx >= 0: int(ctxs[cx].inst) else: 0
    # A contract on formals is checked against the arguments of a call to its
    # function, or against the entry of the function itself. Elsewhere (a
    # literal compared with a call's optional result) nothing binds them: the
    # value keeps its base type, and the type's contract is not assumed for it.
    if ref_has_formals(t) and t != refine_arg_target and not ref_signature_has(owner, t): return n
    wrap_conv(n, .refinement, int(types[t].elem))
    nodes[n].aux2 = i32(t)
    refine_requests.push(FactRequest(n, owner))
    refine_owners[owner] = true
    n

# uint64 intervals use the signed ordering of (bits xor MIN), never signed
# reinterpretation of an endpoint. Arithmetic remains unknown at this width.
ref_encoded = (value: int, base: int) -> int:
    if representation_type(base) == T_U64: return value xor FACT_MIN
    value

ref_project = (term: RefTerm, value0: int, s: mut FactState) -> int:
    value = value0
    loop selector in term.path:
        t = if value != 0: representation_type(fact_terms[value].type) else: 0
        projected = T_INT
        if selector != -1:
            if t == 0 or types[t].kind != .struct_: return 0
            si = int(types[t].st)
            projected = 0
            loop i in [0..int(structs[si].nfields)):
                field = fields[int(structs[si].fields) + i]
                if int(field.name) == selector: projected = int(field.type)
            if projected == 0: return 0
        value = fact_project(s, value, selector, false, projected)
    value

ref_value = (term: RefTerm, self: int, args: int[], base: int, s: mut FactState) -> int:
    if term.kind == 1: return fact_constant(s, ref_encoded(term.value, base))
    value = self
    if term.kind == 2 or term.kind == 5:
        value = if term.value < args.len(): args[term.value] else: 0
    else if term.kind == 3:
        e = mk_ident_local(term.value, locals[term.value].pos)
        value = fact_read(s, e)
    else if term.kind != 0: fatal(-1, "unresolved generic refinement bound")
    ref_project(term, value, s)

ref_assume = (t0: int, self: int, args: int[], s: mut FactState):
    t = prune(t0)
    if types[t].kind != .refined: return
    base = int(types[t].elem)
    loop atom in ref_predicates[int(types[t].st)]:
        a = ref_value(atom.a, self, args, base, s)
        b = ref_value(atom.b, self, args, base, s)
        v = fact_new(s, fact_domain(T_BOOL), FactTerm(atom.op, a, b))
        fact_assume(s, v, true)

ref_check = (n: int, self: int, args: int[], s: mut FactState):
    if fact_speculating > 0:
        ref_assume(zonk(int(nodes[n].aux2)), self, args, s)
        return
    t = zonk(int(nodes[n].aux2))
    nodes[n].aux2 = i32(t)
    if not s.live: return
    base = int(types[t].elem)
    proven = true
    loop atom in ref_predicates[int(types[t].st)]:
        a = ref_value(atom.a, self, args, base, s)
        b = ref_value(atom.b, self, args, base, s)
        truth = fact_compare(s, atom.op, a, b)
        if truth == 0: wit_refinement(n, t, atom, self, a, b, s, true)
        if truth < 0:
            proven = false
            if fact_policy == .RequireStatic: wit_refinement(n, t, atom, self, a, b, s, false)
    # Keep metadata even when erased so calls can publish checked guarantees.
    nodes[n].ival = if proven: 1 else: 0
    fact_validated[n] = true
    ref_assume(t, self, args, s)

refine_fact_entry = (f: int, s: mut FactState):
    refine_entry = []
    loop l in fns[f].params:
        e = mk_ident_local(l, locals[l].pos)
        refine_entry.push(fact_read(s, e))
    loop i in [0..fns[f].ptypes.len()): ref_assume(fns[f].ptypes[i], refine_entry[i], refine_entry, s)

refine_implies = (from: int, to: int) -> bool:
    if type_eq(from, to): return true
    if not callable_shape_eq(representation_type(from), representation_type(to)): return false
    if types[prune(to)].kind != .refined: return true
    # Formal slots are alpha-normalized; distinct lexical declarations remain
    # distinct terms. Implication never synthesizes a runtime callable wrapper.
    saved = fact_terms
    fact_terms = [FactTerm()]
    s = FactState()
    value = fact_new(s, fact_domain(representation_type(from)))
    args: int[]
    loop _ in [0..32): args.push(fact_new(s, FactBound()))
    ref_assume(from, value, args, s)
    ok = true
    loop atom in ref_predicates[int(types[prune(to)].st)]:
        a = ref_value(atom.a, value, args, to, s)
        b = ref_value(atom.b, value, args, to, s)
        if fact_compare(s, atom.op, a, b) != 1: ok = false
    fact_terms = saved
    ok

ref_ir_term = (term: RefTerm, self: int, args: int[], self_type: int, arg_types: int[]) -> int:
    if term.kind == 1: return e_iconst(term.value)
    value = self
    t = self_type
    if term.kind == 2 or term.kind == 5:
        if term.value >= args.len(): ice("missing refinement entry snapshot")
        value = args[term.value]
        t = arg_types[term.value]
        if value == -1:
            value = gen_expr(mk_ident_local(fns[cur_fn].params[term.value], -1)).v
    else if term.kind == 3:
        t = int(locals[term.value].type)
        value = gen_expr(mk_ident_local(term.value, locals[term.value].pos)).v
    else if term.kind != 0: fatal(-1, "unresolved generic refinement bound")
    loop selector in term.path:
        t = representation_type(t)
        if selector == -1:
            if types[t].kind == .fixed: value = e_iconst(fixed_len(t))
            else: value = arr_len(value)
            t = T_INT
        else:
            si = int(types[t].st)
            fi = -1
            loop i in [0..int(structs[si].nfields)):
                f = int(structs[si].fields) + i
                if int(fields[f].name) == selector: fi = f
            if fi < 0: ice("unresolved refinement field")
            t = int(fields[fi].type)
            value = load_val(t, field_val_addr(fi, value), 0)
    value

ref_gen_check = (n: int, self: int, args: int[], arg_types: int[]):
    if nodes[n].ival == 1: return
    t = zonk(int(nodes[n].aux2))
    unsigned = is_int(representation_type(t)) and not types[representation_type(t)].sign
    message = "refinement failed"
    if let width = ref_narrowing.get(n): message = "integer overflow: value does not fit {dt(width)}"
    loop atom in ref_predicates[int(types[t].st)]:
        a = ref_ir_term(atom.a, self, args, int(types[t].elem), arg_types); b = ref_ir_term(atom.b, self, args, int(types[t].elem), arg_types)
        op = if atom.op == .lt: Op.lts else if atom.op == .le: Op.les else: Op.ne
        if unsigned and atom.op != .ne:
            # Bias both operands for an exact unsigned comparison on every target.
            a = e_bin(.xor, VI, a, e_iconst(FACT_MIN))
            b = e_bin(.xor, VI, b, e_iconst(FACT_MIN))
        condition = e_bin(op, VI, a, b)
        iff(e_bin(.eq, VI, condition, e_iconst(0)))
        e_call_nr(rt("__assert_fail"), [e_daddr(str_data(message)), e_daddr(loc_data(nodes[n].pos))], -1)
        endc()

refine_gen = (n: int) -> Val:
    value = gen_expr(int(nodes[n].a))
    ref_gen_check(n, value.v, refine_ir_entry, fns[cur_fn].ptypes)
    value

refine_gen_args = (args: int[], values: int[], offset: int):
    captured: int[]
    arg_types: int[]
    loop arg in args: arg_types.push(ntype(arg))
    loop i in [offset..values.len()): captured.push(values[i])
    loop i in [0..args.len()):
        n = args[i]
        if nodes[n].kind == .conv and nodes[n].aux == i32(int(CV.refinement)): ref_gen_check(n, captured[i], captured, arg_types)

refine_gen_entry = (f: int):
    refine_ir_entry = []
    if not refine_owners.has(f): return
    loop l in fns[f].params:
        if int(locals[l].flags) & LF_MUTPARAM != 0: refine_ir_entry.push(-1)
        else: refine_ir_entry.push(freeze_scalar(int(locals[l].vreg), representation_type(int(locals[l].type))))

ref_validate_signature = (params: int[], ret: int, mask: int, pos: int):
    loop t in params:
        if ref_nested_formals(t): fatal(pos, "dependent element contracts require instantiated storage authority")
    result = prune(ret)
    loop types[result].kind == .opt: result = prune(int(types[result].elem))
    # (an element contract on formals would escape into the caller's storage,
    # where no call binds them)
    if ref_nested_formals(result): fatal(pos, "a result's element contract cannot depend on parameters")
    all = params + [result]
    loop i in [0..all.len()):
        t = prune(all[i])
        if types[t].kind != .refined: continue
        loop atom in ref_predicates[int(types[t].st)]:
            loop term in [atom.a, atom.b]:
                if term.kind != 2: continue
                j = term.value
                if j >= params.len(): fatal(pos, "missing refinement parameter")
                if mask & (1 << j) != 0 and (i < params.len() or term.path.len() == 0): fatal(pos, "mutable refinement dependencies are only valid in projected postconditions")
                a = if tkind(representation_type(t)) == .array: T_INT else: representation_type(t)
                b = ref_projection_type(params[j], term.path, pos)
                if not has_var(a) and not has_var(b) and not type_eq(a, b): fatal(pos, "dependent scalar refinement requires matching integer representations")
    # Dependency cycles cannot define a self-justifying set of contracts.
    done = fill(false, params.len())
    loop _ in [0..params.len()):
        loop i in [0..params.len()):
            if done[i]: continue
            ready = true
            t = prune(params[i])
            if types[t].kind == .refined:
                loop atom in ref_predicates[int(types[t].st)]:
                    loop term in [atom.a, atom.b]:
                        if term.kind == 2 and not done[term.value]: ready = false
            if ready: done[i] = true
    loop yes in done:
        if not yes: fatal(pos, "cyclic dependent scalar refinements")

ref_has_formals = (t0: int) -> bool:
    t = prune(t0)
    if types[t].kind != .refined: return false
    loop atom in ref_predicates[int(types[t].st)]:
        if atom.a.kind == 2 or atom.b.kind == 2: return true
    false

# (the parameter type finish_arg is coercing an argument to: its formals are that call's)
refine_arg_target = 0

# Does function f's own signature contain the refined type t, so that its
# formals are f's parameters?
ref_signature_has = (f: int, t: int) -> bool:
    if f <= 0 or f >= fns.len(): return false
    if ref_type_contains(int(fns[f].ret), t, 0): return true
    loop p in fns[f].ptypes:
        if ref_type_contains(p, t, 0): return true
    false

ref_type_contains = (t0: int, want: int, depth: int) -> bool:
    t = prune(t0)
    if t == want: return true
    if depth >= 32: return false
    k = types[t].kind
    if k == .refined or k == .opt or k == .array or k == .fixed: return ref_type_contains(int(types[t].elem), want, depth + 1)
    if is_union(t):
        loop m in union_members(t):
            if ref_type_contains(m, want, depth + 1): return true
    false

ref_decl_mask = (decl: int) -> int:
    mask = 0
    loop i in [0..nkids(decl)):
        if has_flag(kid(decl, i), NF_MUT): mask |= 1 << i
    mask

# Generic type limits are substituted together with the base. Dependencies in
# the descriptor's argument list propagate TF_HAS_VAR without a new type field.
ref_resolve_limit = (term: RefTerm) -> RefTerm:
    if term.kind != 4: return term
    t = prune(term.value)
    if has_var(t): return term
    if not is_int(t): fatal(-1, "refinement type limit requires an integer type")
    if t == T_U64: return RefTerm(1, (if term.unsigned: -1 else: 0), term.unsigned)
    domain = fact_domain(t)
    RefTerm(1, if term.unsigned: domain.hi else: domain.lo)

ref_subst = (predicate: int, args: int[], zonking: bool = false) -> int:
    atoms: RefAtom[]
    loop original in ref_predicates[predicate]:
        atom = original
        if atom.a.kind == 4: atom.a.value = if zonking: zonk(atom.a.value) else: subst(atom.a.value, args)
        if atom.b.kind == 4: atom.b.value = if zonking: zonk(atom.b.value) else: subst(atom.b.value, args)
        atoms.push(atom)
    result = ref_intern(atoms)
    ref_span_copy(predicate, result)
    result

# Wrapped element contracts and record fields retain storage authority.
# Callable contracts inside an aggregate remain value types.
ref_storage_contract = (t0: int, seen: int[] = []) -> bool:
    t = prune(t0)
    if seen.contains(t): return false
    if seen.len() >= 32: return true
    let seen = seen
    seen.push(t)
    k = types[t].kind
    if k == .refined: return true
    if k == .opt or k == .array or k == .fixed: return ref_storage_contract(int(types[t].elem), seen)
    if k == .tuple:
        loop i in [0..int(types[t].nargs)):
            if ref_storage_contract(targ(t, i), seen): return true
    if k == .struct_:
        si = int(types[t].st)
        check_struct_fields(si)
        loop i in [0..int(structs[si].nfields)):
            if ref_storage_contract(int(fields[int(structs[si].fields) + i].type), seen): return true
    false

# Resolve a projection against its concrete binder before publishing a contract.
ref_projection_type = (root: int, path: int[], pos: int) -> int:
    t = representation_type(root)
    loop selector in path:
        if has_var(t): return t
        if selector == -1:
            if tkind(t) != .array and tkind(t) != .fixed: fatal(pos, "refinement length requires an array")
            t = T_INT
        else:
            if tkind(t) != .struct_: fatal(pos, "refinement field requires a record")
            si = int(types[t].st)
            check_struct_fields(si)
            next = 0
            loop i in [0..int(structs[si].nfields)):
                f = fields[int(structs[si].fields) + i]
                if int(f.name) == selector: next = int(f.type)
            if next == 0: fatal(pos, "unknown refinement field")
            t = representation_type(next)
    t

ref_fact_current_entry = (s: mut FactState) -> int[]:
    args = refine_entry
    if fact_owner <= 0: return args
    f = fact_owner
    loop i in [0..fns[f].params.len()):
        l = fns[f].params[i]
        if int(locals[l].flags) & LF_MUTPARAM != 0: args[i] = fact_read(s, mk_ident_local(l, locals[l].pos))
    args

ref_has_fields = (t0: int) -> bool:
    t = prune(t0)
    if types[t].kind != .refined: return false
    loop atom in ref_predicates[int(types[t].st)]:
        if atom.a.kind == 5 or atom.b.kind == 5: return true
    false

ref_dependent_record = (t: int) -> bool:
    if tkind(t) != .struct_: return false
    si = int(types[prune(t)].st)
    loop i in [0..int(structs[si].nfields)):
        if ref_has_fields(int(fields[int(structs[si].fields) + i].type)): return true
    false

ref_validate_record = (t: int, pos: int):
    si = int(types[prune(t)].st)
    count = int(structs[si].nfields)
    done = fill(false, count)
    loop _ in [0..count):
        loop i in [0..count):
            if done[i]: continue
            ft = prune(int(fields[int(structs[si].fields) + i].type))
            ready = true
            if types[ft].kind == .refined:
                loop atom in ref_predicates[int(types[ft].st)]:
                    loop term in [atom.a, atom.b]:
                        if term.kind != 5: continue
                        j = term.value
                        if j >= count: fatal(pos, "refinement field is outside its record")
                        if not done[j]: ready = false
                        dep = int(fields[int(structs[si].fields) + j].type)
                        bound = ref_projection_type(dep, term.path, pos)
                        expected = if tkind(representation_type(ft)) == .array: T_INT else: representation_type(ft)
                        if not has_var(bound) and not has_var(expected) and not type_eq(bound, expected): fatal(pos, "dependent field refinement requires matching integer representations")
            if ready: done[i] = true
    loop yes in done:
        if not yes: fatal(pos, "cyclic dependent field refinements")

# Dependent field updates construct a private candidate. Every sibling reads
# the same captured parent; only a validated complete value replaces storage.
ref_field_store = (statement: int, target: int) -> int:
    lhs = int(nodes[statement].a)
    if nodes[lhs].kind != .field: return 0
    parent = int(nodes[lhs].a)
    t = representation_type(ntype(parent))
    if not ref_dependent_record(t) and not ref_dependent_ancestor(parent): return 0
    pos = nodes[statement].pos
    before: int[]
    path = index_update_path(parent)
    # A compound read captures selectors before evaluating the RHS. A plain
    # store evaluates its RHS first, exactly as gen_assign does.
    compound = nodes[statement].op != i32(int(Tok.assign))
    if compound:
        j = path.len() - 1
        loop j >= 0:
            part = path[j]; j -= 1
            if nodes[part].kind == .index and nodes[part].b != 0:
                nodes[part].b = i32(capture_value(int(nodes[part].b), ntype(int(nodes[part].b)), before))
    value = int(nodes[statement].b)
    if compound: value = compound_checked(statement, copy_place(lhs), value, representation_type(target))
    else:
        check_expr(value, representation_type(target))
        value = last_checked
    coerce(value, representation_type(target))
    value = capture_value(value, representation_type(target), before)
    if not compound:
        j = path.len() - 1
        loop j >= 0:
            part = path[j]; j -= 1
            if nodes[part].kind == .index and nodes[part].b != 0:
                nodes[part].b = i32(capture_value(int(nodes[part].b), ntype(int(nodes[part].b)), before))
    snapshot = capture_value(copy_place(parent), t, before)
    si = int(types[t].st)
    args: int[]
    loop i in [0..int(structs[si].nfields)):
        f = int(structs[si].fields) + i
        field = value
        if i != int(nodes[lhs].aux):
            field = bc_field(snapshot, name_of(int(fields[f].name)), pos)
            check_expr(field, 0)
            field = last_checked
        # Distinct AST nodes prevent one field's wrapper modifying another use.
        field = copy_checked(field)
        coerce(field, int(fields[f].type))
        args.push(field)
    ctor = mk(.call, pos)
    nodes[ctor] = Node(kind = .call, pos = pos, aux = 2, type = i32(t), flags = i32(NF_CHECKED))
    set_list(ctor, args)
    store = mk(.assign, pos)
    nodes[store].a = i32(parent)
    nodes[store].b = i32(ctor)
    nodes[store].op = i32(int(Tok.assign))
    store = check_assign(store)
    before.push(store)
    return bc_block(before, pos)

copy_checked = (n: int) -> int:
    copy = nodes.len()
    nodes.push(nodes[n])
    copy

ref_mutable_authority = (n: int):
    value = n
    if nodes[value].kind == .ident and nodes[value].aux == i32(int(SK.local)):
        l = int(nodes[value].sym)
        if int(locals[l].flags) & LF_ALIAS != 0: value = int(locals[l].alias)
    loop nodes[value].kind == .field or nodes[value].kind == .index:
        parent = int(nodes[value].a)
        if ref_dependent_record(representation_type(ntype(parent))): fatal(nodes[n].pos, "mutable refinement access needs the full record invariant authority")
        value = parent

# Length-changing operations execute on a private candidate. Later argument
# effects run before that candidate is published, so callbacks cannot observe
# an intermediate violation of the destination's storage contract.
ref_length_mutation = (n: int, r: int) -> int:
    id = nodes[n].aux as IN
    if id != .push and id != .pop and id != .insert and id != .remove and id != .clear and id != .extend and id != .resize and id != .truncate and id != .setlen: return r
    place = kid(n, 0)
    t = prune(refine_storage(place, ntype(place)))
    if types[t].kind != .refined and not ref_dependent_ancestor(place): return r
    before: int[]
    args = kids(n)
    if id == .insert:
        args[2] = capture_value(args[2], ntype(args[2]), before)
        args[1] = capture_value(args[1], ntype(args[1]), before)
    else:
        loop i in [1..args.len()): args[i] = capture_value(args[i], ntype(args[i]), before)
    # gen_intrinsic evaluates operands before reacquiring receiver storage.
    path = index_update_path(place)
    j = path.len() - 1
    loop j >= 0:
        part = path[j]; j -= 1
        if nodes[part].kind == .index and nodes[part].b != 0: nodes[part].b = i32(capture_value(int(nodes[part].b), ntype(int(nodes[part].b)), before))
    candidate = capture_value(copy_place(place), representation_type(t), before)
    args[0] = candidate
    operation = copy_checked(n)
    add_flag(operation, NF_CHECKED)
    set_list(operation, args)
    result = 0
    if r != T_VOID: result = capture_value(operation, r, before)
    else: before.push(bc_stmt(operation, nodes[n].pos))
    store = bc_assign(place, copy_checked(candidate), nodes[n].pos)
    store = check_assign(store)
    before.push(store)
    if result != 0: before.push(bc_stmt(result, nodes[n].pos))
    nodes[n] = nodes[bc_block(before, nodes[n].pos)]
    nodes[n].type = i32(r)
    nodes[n].aux = 1
    add_flag(n, NF_CHECKED)
    r

# Structural record conversion checks target fields after one source capture.
# Nominal records and mutable element-contract changes retain exact identity.
ref_record_conversion = (from: int, to: int) -> bool:
    if types[from].kind != .struct_ or types[to].kind != .struct_: return false
    fs = int(types[from].st); ts = int(types[to].st)
    if structs[fs].decl != structs[ts].decl or not has_flag(int(structs[fs].decl), NF_RECORD): return false
    if not ref_storage_contract(from) and not ref_storage_contract(to): return false
    check_struct_fields(fs)
    check_struct_fields(ts)
    loop i in [0..int(structs[ts].nfields)):
        a = int(fields[int(structs[fs].fields) + i].type)
        b = int(fields[int(structs[ts].fields) + i].type)
        if not can_coerce(0, a, b): return false
    true

ref_convert_record = (n: int, target: int) -> int:
    source = copy_checked(n)
    before: int[]
    source = capture_value(source, ntype(source), before)
    si = int(types[target].st)
    args: int[]
    loop i in [0..int(structs[si].nfields)):
        field = fields[int(structs[si].fields) + i]
        value = bc_field(source, name_of(int(field.name)), nodes[n].pos)
        check_expr(value, 0)
        value = last_checked
        coerce(value, int(field.type))
        args.push(value)
    ctor = mk(.call, nodes[n].pos)
    nodes[ctor] = Node(kind = .call, pos = nodes[n].pos, aux = 2, type = i32(target), flags = i32(NF_CHECKED))
    set_list(ctor, args)
    before.push(bc_stmt(ctor, nodes[n].pos))
    nodes[n] = nodes[bc_block(before, nodes[n].pos)]
    nodes[n].type = i32(target)
    nodes[n].aux = 1
    add_flag(n, NF_CHECKED)
    n

ref_dependent_ancestor = (n: int) -> bool:
    value = n
    loop nodes[value].kind == .field or nodes[value].kind == .index:
        value = int(nodes[value].a)
        if ref_dependent_record(representation_type(ntype(value))): return true
    false

ref_mutable_result = (f: int) -> bool:
    t = prune(int(fns[f].ret))
    loop types[t].kind == .opt: t = prune(int(types[t].elem))
    if types[t].kind != .refined: return false
    loop atom in ref_predicates[int(types[t].st)]:
        loop term in [atom.a, atom.b]:
            if term.kind != 2 or term.value >= fns[f].params.len(): continue
            if int(locals[fns[f].params[term.value]].flags) & LF_MUTPARAM != 0: return true
    false

ref_nested_formals = (t0: int, nested: bool = false, depth: int = 0) -> bool:
    if depth >= 32: return true
    t = prune(t0)
    k = types[t].kind
    if k == .refined:
        if nested and ref_has_formals(t): return true
        return ref_nested_formals(int(types[t].elem), nested, depth + 1)
    if k == .array or k == .fixed or k == .opt: return ref_nested_formals(int(types[t].elem), true, depth + 1)
    if k == .tuple:
        loop i in [0..int(types[t].nargs)):
            if ref_nested_formals(targ(t, i), true, depth + 1): return true
    false

ref_predicates: RefAtom[][] = [[]]
# Declaration spans for diagnostics only; never part of predicate identity.
ref_spans: {int: int} = {}
refine_active = false
ref_addr_type = 0

refine_bindings = RefineBindings()
refine_requests: FactRequest[]
refine_owners: {int: bool} = {}
# refinement checks made by an implicit narrowing, with the width they narrow to
ref_narrowing: {int: int} = {}
refine_entry: int[]
refine_ir_entry: int[]
# The element type nodes that may name their binding, by node. O(1) per typed binding.
ref_holder_elems: {int: int} = {}
ref_holder_name = 0
# The binding last declared with a type: named by a misplaced refinement, it gets a better error.
ref_declaring = 0
ref_self_active = false
# A self-length array type's stored element type
ref_self_elements: {int: int} = {}
# Candidate publications whose contract holds by what was done to them
ref_self_established: {int: bool} = {}
# Candidate publications that may shorten the array, for their diagnostic: (place, operation)
ref_self_shrinks: {int: (int, IN)} = {}
# `xs` in a `xs.swap(i j)`, which works on the array itself
ref_self_direct: {int: bool} = {}
# A sibling length + c, by length value and c (ref_sib_limit)
ref_sib_sums: {int: int} = {}
ref_fact_holder = 0
ref_gen_site = 0

representation_type = (t0: int) -> int:
    t = prune(t0)
    if types[t].kind == .refined: return prune(int(types[t].elem))
    t

# String literal sets (`'a'|'b'`): an enum whose variant i is member i, so a
# value is one word at run time (the member's index); `=?`, `is?` and `match`
# compare that word, and the text is made only where the value meets a string.
str_sets: str[][] = [[]]
str_set_types: int[] = [0]
substitution_refinements = TypeSubstituteRefinements(&ref_predicates, ref_span_copy)
substitution_refinement_binding = type_substitute_refinements(&substitution_refinements)

# the string set a type is, or 0
str_set_of = (t0: int) -> int:
    t = prune(t0)
    if types[t].kind != .enum_: return 0
    int(structs[int(types[t].st)].lit_set)

# totaldict<K V>: a dictionary with an entry for every value of its finite key
# type. A refined Map (marked by bits -1, with no predicate) whose literal is
# checked for every key, which refuses pop and clear, and which a dict that may
# be partial does not become.
total_literals: {int: bool} = {}

is_total_dict = (t0: int) -> bool:
    t = prune(t0)
    types[t].kind == .refined and types[t].bits == -1

refine_reset = ():
    nd_contracts_reset()
    str_sets = [[]]
    total_literals = {}
    str_set_types = [0]
    ref_predicates = [[]]
    refine_active = false
    refine_bindings.fields = []
    ref_addr_type = 0
    refine_bindings.formals = []
    refine_bindings.self = 0
    refine_requests = []
    refine_owners = {}
    ref_narrowing = {}
    ref_spans = {}
    ref_holder_elems = {}
    ref_holder_name = 0
    ref_self_active = false
    ref_self_elements = {}
    ref_self_established = {}
    ref_self_shrinks = {}
    ref_self_direct = {}
    ref_sib_sums = {}

ref_span_copy = (from: int, to: int):
    if from != to and not ref_spans.has(to):
        if let at = ref_spans.get(from): ref_spans[to] = at

# Predicate tables stay with their owner; the leaf borrows the interner.
ref_intern = (atoms: RefAtom[]) -> int: ref_atoms_intern(ref_predicates, atoms)

mk_refined = (base0: int, predicate: int) -> int: tr_make(base0, predicate)

resolve_refinement = (n: int) -> int:
    if nodes[n].b == 0: return ref_self_resolve(n)
    # (a refinement of a module whose declarations were not asked for yet, met another way)
    if not refine_active and refine_deferred.len() > 0:
        loop m, _ in refine_deferred: refine_resume(m)
    base = resolve_type(int(nodes[n].a))
    binder = if nodes[n].name != 0: int(nodes[n].name) else: refine_bindings.self
    if ref_self_active and ref_self_contract(base): fatal(nodes[n].pos, "a self-length array cannot have a length contract as well")
    atoms: RefAtom[]
    previous_base = refine_bindings.base_type
    refine_bindings.base_type = base
    # (the direct element of an array that names its own binding: that name is the array)
    previous_holder = ref_holder_name
    ref_holder_name = if ref_holder_elems.len() > 0: ref_holder_elems.get(n) ?? 0 else: 0
    fields_before = refine_bindings.fields
    formals_before = refine_bindings.formals
    if ref_holder_name != 0:
        refine_bindings.fields = ref_without_name(refine_bindings.fields, ref_holder_name)
        refine_bindings.formals = ref_without_name(refine_bindings.formals, ref_holder_name)
    ref_resolve_atoms(nodes, types, names, refine_bindings, ref_resolve_host, int(nodes[n].b), binder, atoms, 0)
    ref_holder_name = previous_holder
    refine_bindings.fields = fields_before
    refine_bindings.formals = formals_before
    refine_bindings.base_type = previous_base
    if ref_atoms_have_kind(atoms, 6): ref_self_validate(atoms, base, nodes[n].pos)
    expected = if tkind(representation_type(base)) == .array or tkind(representation_type(base)) == .str_: T_INT else: representation_type(base)
    loop atom in atoms:
        loop term in [atom.a, atom.b]:
            if refine_bindings.fields.len() > 0 and term.kind == 2: fatal(nodes[n].pos, "record field refinement dependencies must name siblings or stable lexical bindings")
            root = 0
            if term.kind == 0: root = base
            else if term.kind == 3: root = int(locals[term.value].type)
            if root == 0: continue
            actual = ref_projection_type(root, term.path, nodes[n].pos)
            if not has_var(actual) and not is_int(actual): fatal(nodes[n].pos, "refinement comparisons require scalar or length projections")
            if not ref_repr_match(actual, expected, term.path): fatal(nodes[n].pos, "dependent scalar refinement requires matching integer representations")
    predicate = ref_intern(atoms)
    if not ref_spans.has(predicate): ref_spans[predicate] = nodes[n].pos
    mk_refined(base, predicate)

refine_storage = (n: int, fallback: int) -> int:
    if nodes[n].kind == .field:
        t = representation_type(ntype(int(nodes[n].a)))
        if types[t].kind == .tuple and nodes[n].aux == -2: return targ(t, nodes[n].ival)
        if types[t].kind == .struct_ and nodes[n].aux >= 0:
            return int(fields[int(structs[int(types[t].st)].fields) + int(nodes[n].aux)].type)
    if nodes[n].kind == .index and nodes[n].aux == 0:
        t = representation_type(ntype(int(nodes[n].a)))
        if ref_self_active and types[t].kind == .array:
            if let element = ref_self_elements.get(prune(refine_storage(int(nodes[n].a), ntype(int(nodes[n].a))))): return element
        if types[t].kind == .array or types[t].kind == .fixed: return int(types[t].elem)
    if nodes[n].kind == .ident:
        if nodes[n].aux == i32(int(SK.local)):
            l = int(nodes[n].sym)
            if int(locals[l].flags) & LF_ALIAS != 0 and locals[l].alias != 0: return refine_storage(int(locals[l].alias), fallback)
        if nodes[n].aux == i32(int(SK.local)): return int(locals[int(nodes[n].sym)].type)
        if nodes[n].aux == i32(int(SK.global)): return int(globals[int(nodes[n].sym)].type)
    if nodes[n].kind == .unwrap:
        # Narrowed aliases read the payload representation, but writes still
        # owe the payload contract declared on the containing optional place.
        a = int(nodes[n].a)
        t = representation_type(refine_storage(a, ntype(a)))
        if types[t].kind == .opt: return int(types[t].elem)
    if nodes[n].kind == .narrow:
        # The tag selects a declared union member even after the payload's
        # read type has erased its outer refinement. Resolve through optional
        # and local aliases first, just as for an unwrapped optional payload.
        a = int(nodes[n].a)
        t = representation_type(refine_storage(a, ntype(a)))
        if is_union(t): return struct_targ(int(types[t].st), int(nodes[n].aux))
    if nodes[n].kind == .conv and nodes[n].aux == i32(int(CV.union_)):
        # A narrowed subset retains its declared member types; the conversion
        # is a view of the same union storage, not an unrefined replacement.
        return ntype(n)
    fallback

# A requested check later wrapped in place (an optional's or union's arm,
# `return i` from `:>addr<…> | none`) moved below its wrapping conversions.
ref_wrapped_check = (n0: int) -> int:
    n = n0
    loop depth in [0..8):
        if nodes[n].kind == .conv and nodes[n].aux != i32(int(CV.refinement)) and nodes[n].a != 0: n = int(nodes[n].a)
        else if nodes[n].kind == .call and nodes[n].aux == 3 and nkids(n) == 1: n = kid(n, 0)
        else: break
    n

refine_coerce = (n: int, target: int) -> int:
    t = prune(target)
    if types[t].bits == -1: return total_dict_coerce(n, t)
    coerce(n, int(types[t].elem))
    if nodes[n].kind == .conv and nodes[n].aux == i32(int(CV.refinement)) and nodes[n].aux2 == i32(t): return n
    owner = if cx >= 0: int(ctxs[cx].inst) else: 0
    # A contract on formals is checked against the arguments of a call to its
    # function, or against the entry of the function itself. Elsewhere (a
    # literal compared with a call's optional result) nothing binds them: the
    # value keeps its base type, and the type's contract is not assumed for it.
    if ref_has_formals(t) and t != refine_arg_target and not ref_signature_has(owner, t): return n
    wrap_conv(n, .refinement, int(types[t].elem))
    nodes[n].aux2 = i32(t)
    if dewy_at(nodes[n].pos): int_domain_conversion(n, t)
    refine_requests.push(FactRequest(n, owner))
    refine_owners[owner] = true
    n

# uint64 intervals use the signed ordering of (bits xor MIN), never signed
# reinterpretation of an endpoint. Arithmetic remains unknown at this width.
ref_encoded = (value: int, base: int) -> int:
    if fact_type(base) == T_U64: return value xor FACT_MIN
    value

ref_project = (term: RefTerm, value0: int, s: mut FactState) -> int:
    value = value0
    loop selector in term.path:
        t = if value != 0: representation_type(fact_terms[value].type) else: 0
        projected = T_INT
        if selector <= -2:
            value = fact_nd_projection(s, value, selector)
            continue
        if selector != -1:
            if t == 0 or types[t].kind != .struct_: return 0
            si = int(types[t].st)
            projected = 0
            loop i in [0..int(structs[si].nfields)):
                field = fields[int(structs[si].fields) + i]
                if int(field.name) == selector: projected = int(field.type)
            if projected == 0: return 0
        value = fact_project(s, value, selector, false, projected)
    value

ref_value = (term: RefTerm, self: int, args: int[], base: int, s: mut FactState) -> int:
    if term.kind == 1: return fact_constant(s, ref_encoded(term.value, base))
    value = self
    if term.kind == 2 or term.kind == 5:
        value = if term.value < args.len(): args[term.value] else: 0
    else if term.kind == 3:
        e = mk_ident_local(term.value, locals[term.value].pos)
        value = fact_read(s, e)
    else if term.kind == 6: value = ref_fact_holder
    else if term.kind != 0: fatal(-1, "unresolved generic refinement bound")
    value = ref_project(term, value, s)
    if value != 0 and term.offset != 0:
        # (a mathematical sum: exact rows, and an interval only where it fits)
        b = fact_bound(s, value)
        shifted = FactBound(wide = true)
        if not b.wide and b.lo != FACT_MIN and b.hi != FACT_MAX and fact_add_fits(b.lo, term.offset) and fact_add_fits(b.hi, term.offset): shifted = FactBound(b.lo + term.offset, b.hi + term.offset)
        sum = fact_new(s, shifted, FactTerm(type = T_INT))
        fact_difference(s, sum, value, term.offset, 0, 16)
        fact_difference(s, value, sum, -term.offset, 0, 16)
        return sum
    if value != 0 and term.path.len() > 0 and term.path[term.path.len() - 1] == -1 and representation_type(base) == T_U64:
        # A length bounding a uint64: its interval in the biased order.
        b = fact_bound(s, value)
        lo = max(b.lo, 0)
        hi = if b.hi < lo: lo else: b.hi
        value = fact_new(s, FactBound(lo xor FACT_MIN, hi xor FACT_MIN, (lo xor FACT_MIN) != 0), FactTerm(type = T_U64))
    value

ref_assume = (t0: int, self: int, args: int[], s: mut FactState):
    t = prune(t0)
    if types[t].kind != .refined: return
    base = int(types[t].elem)
    loop atom in ref_predicates[int(types[t].st)]:
        if atom.a.kind == 6:
            if atom.b.kind == 5 or atom.b.kind == 6: ref_sib_assume(s, self, atom, args)
            else: ref_self_assume(s, self, atom)
            continue
        # (a store's element type says nothing without the array it is stored in)
        if atom.b.kind == 6 and ref_fact_holder == 0: continue
        a = ref_value(atom.a, self, args, base, s)
        b = ref_value(atom.b, self, args, base, s)
        v = fact_new(s, fact_domain(T_BOOL), FactTerm(atom.op, a, b))
        fact_assume(s, v, true)

# b narrowed by the atoms of t's contract that compare the value with a
# literal; relations to other values need a fact state (ref_assume). O(atoms).
ref_interval = (t0: int, b: FactBound) -> FactBound:
    t = prune(t0)
    if types[t].kind != .refined or representation_type(t) == T_U64: return b
    ref_atoms_interval(ref_predicates[int(types[t].st)], b)

ref_check = (n: int, self: int, args: int[], s: mut FactState):
    held = ref_fact_holder
    ref_fact_holder = 0
    if ref_self_active and nodes[n].b != 0:
        ref_fact_holder = fact_capture(int(nodes[n].b), s)
        wit_holder_text = wit_text(int(nodes[n].b))
    ref_check_held(n, self, args, s)
    ref_fact_holder = held

ref_check_held = (n: int, self: int, args: int[], s: mut FactState):
    if fact_speculating > 0:
        ref_assume(zonk(int(nodes[n].aux2)), self, args, s)
        return
    t = zonk(int(nodes[n].aux2))
    nodes[n].aux2 = i32(t)
    if not s.live: return
    # (a permutation of the array, or a growth whose new values were checked: ref_self_establish)
    if ref_self_active and ref_self_established.has(n):
        nodes[n].ival = 1
        fact_validated[n] = true
        ref_assume(t, self, args, s)
        return
    # (a binding whose every written value the type holds: string_domains.jo; a record's tied
    # fields read before a run changes them: ref_pair_reads)
    if int_domain_proven.has(n) or ref_pair_held.len() > 0 and ref_pair_held.has(n):
        nodes[n].ival = 1
        fact_validated[n] = true
        ref_assume(t, self, args, s)
        return
    base = int(types[t].elem)
    proven = true
    loop atom in ref_predicates[int(types[t].st)]:
        if atom.a.kind == 6 and (atom.b.kind == 5 or atom.b.kind == 6):
            truth = ref_sib_truth(s, self, atom, args)
            if truth < 0 and is_map_type(representation_type(t)): truth = ref_sib_literal_truth(s, n, atom, args)
            if truth == 0: ref_sib_fail(n, t, atom, true)
            if truth < 0:
                proven = false
                if fact_policy == .RequireStatic: ref_sib_fail(n, t, atom, false)
            continue
        if atom.a.kind == 6:
            truth = ref_self_truth(s, self, ref_self_k(atom))
            if truth < 0 and ref_self_shrinks.has(n): truth = ref_self_written_truth(s, self, t, ref_self_k(atom))
            if truth == 0: ref_self_fail(n, t, self, s, true)
            if truth < 0:
                proven = false
                if fact_policy == .RequireStatic: ref_self_fail(n, t, self, s, false)
            continue
        a = ref_value(atom.a, self, args, base, s)
        b = ref_value(atom.b, self, args, base, s)
        truth = fact_compare(s, atom.op, a, b)
        if (truth == 0 or truth < 0 and fact_policy == .RequireStatic) and ref_pair_hints.len() > 0 and ref_pair_hints.has(n): err_notes.push((-1, ref_pair_hints[n]))
        if truth == 0: wit_refinement(n, t, atom, self, a, b, s, true)
        if truth < 0:
            proven = false
            if fact_policy == .RequireStatic: wit_refinement(n, t, atom, self, a, b, s, false)
    # Keep metadata even when erased so calls can publish checked guarantees.
    nodes[n].ival = if proven: 1 else: 0
    if fact_probe_on: fact_probe[n] = proven and (fact_probe.get(n) ?? true)
    fact_validated[n] = true
    # (what is proven adds nothing, and its rows would crowd out relations a later proof needs:
    # fact_difference keeps eight per term, and `r[0]` read often is a fresh constant each time)
    if not proven: ref_assume(t, self, args, s)

refine_fact_entry = (f: int, s: mut FactState):
    refine_entry = []
    loop l in fns[f].params:
        e = mk_ident_local(l, locals[l].pos)
        refine_entry.push(fact_read(s, e))
    loop i in [0..fns[f].ptypes.len()): ref_assume(fns[f].ptypes[i], refine_entry[i], refine_entry, s)
    nd_mutable_entry(f, s)

# (the type of the value ref_ir_term last gave: 0 for a constant)
ref_term_type = 0

ref_ir_term = (term: RefTerm, self: int, args: int[], self_type: int, arg_types: int[]) -> int:
    ref_term_type = 0
    if term.kind == 1: return e_iconst(term.value)
    value = self
    t = self_type
    if term.kind == 2 or term.kind == 5:
        if term.value >= args.len(): ice("missing refinement entry snapshot")
        value = args[term.value]
        t = arg_types[term.value]
        if value == -1:
            value = gen_expr(mk_ident_local(fns[cur_fn].params[term.value], -1)).v
    else if term.kind == 3:
        t = int(locals[term.value].type)
        value = gen_expr(mk_ident_local(term.value, locals[term.value].pos)).v
    else if term.kind == 6:
        ref_term_type = T_INT
        return ref_ir_holder_length()
    else if term.kind != 0: fatal(-1, "unresolved generic refinement bound")
    loop selector in term.path:
        t = representation_type(t)
        if selector <= -2:
            value = nd_ir_projection(value, t, selector)
            t = T_INT
        else if selector == -1:
            if types[t].kind == .fixed: value = e_iconst(fixed_len(t))
            else if types[t].kind == .str_: value = e_call(rt("__dewy_string_length"), [value], VI)
            else: value = arr_len(value)
            t = T_INT
        else:
            si = int(types[t].st)
            fi = -1
            loop i in [0..int(structs[si].nfields)):
                f = int(structs[si].fields) + i
                if int(fields[f].name) == selector: fi = f
            if fi < 0: ice("unresolved refinement field")
            t = int(fields[fi].type)
            value = load_val(t, field_val_addr(fi, value), 0)
    ref_term_type = representation_type(t)
    value

ref_gen_check = (n: int, self: int, args: int[], arg_types: int[]):
    if nodes[n].ival == 1: return
    t = zonk(int(nodes[n].aux2))
    unsigned = is_int(representation_type(t)) and not types[representation_type(t)].sign
    shown = wit_text(int(nodes[n].a))
    if shown == "": shown = "the value"
    ref_gen_site = n
    if ref_self_active and nodes[n].b != 0: wit_holder_text = wit_text(int(nodes[n].b))
    loop atom in ref_predicates[int(types[t].st)]:
        if atom.a.kind == 6 and (atom.b.kind == 5 or atom.b.kind == 6):
            ref_sib_gen(n, t, atom, self, args, arg_types)
            continue
        if atom.a.kind == 6:
            ref_self_gen(n, atom, self)
            continue
        a = ref_ir_term(atom.a, self, args, int(types[t].elem), arg_types)
        a_type = ref_term_type
        b = ref_ir_term(atom.b, self, args, int(types[t].elem), arg_types)
        b_type = ref_term_type
        # (a Dewy `int` is a tagged word or a BigInt: both sides compare as ints, exactly)
        math = a_type == T_MATH_INT or b_type == T_MATH_INT
        # (`x not=? k`, k a constant in the tagged range: a value has one representation,
        # so its word decides, and a value failing it is k)
        tagged_ne = 0
        if math and atom.op == .ne and atom.b.offset == 0:
            if atom.a.kind == 1 and b_type == T_MATH_INT and ref_tagged_fits(atom.a.value):
                tagged_ne = e_bin(.ne, VI, b, e_iconst(atom.a.value << 1))
                b = a
            else if atom.b.kind == 1 and a_type == T_MATH_INT and ref_tagged_fits(atom.b.value):
                tagged_ne = e_bin(.ne, VI, a, e_iconst(atom.b.value << 1))
                a = b
            if tagged_ne != 0: math = false
        # The failure names the violated requirement and the observed values,
        # the constrained value first (contracts are stored as `a < b`).
        left = wit_ref_text(atom.a, shown); right = wit_ref_text(atom.b, shown)
        # (a bound from another parameter's entry value has no name here)
        if left == "": left = "the bound"
        if right == "": right = "the bound"
        seen_left = if atom.a.kind == 1: "" else: left
        seen_right = if atom.b.kind == 1: "" else: right
        # (a value on its way into a secret is not shown: secrets.jo)
        if secret_checks.len() > 0 and secret_checks.has(n):
            seen_left = ""
            seen_right = ""
        # (`a op b + c`: the right side's observed value is the sum)
        c = atom.b.offset
        made: int[]
        if math:
            a = ref_math_term(a, a_type, made)
            b = ref_math_term(b, b_type, made)
        sum = b
        if c != 0 and math:
            sum = math_binary(.plus, b, math_word(e_iconst(c)).v).v
            made.push(sum)
        else if c != 0: sum = e_bin(.add, VI, b, e_iconst(c))
        first = a; second = sum
        relation = atom.op
        if atom.b.kind == 0 and atom.a.kind != 0 and (relation == .lt or relation == .le):
            text = left; left = right; right = text
            text = seen_left; seen_left = seen_right; seen_right = text
            first = sum; second = a
            relation = if relation == .lt: Tok.gt else: Tok.ge
        message = "refinement failed: `{left} {wit_op(relation)} {right}`"
        if let width = ref_narrowing.get(n): message = "integer overflow: value does not fit {dt(width)}"
        op = if atom.op == .lt: Op.lts else if atom.op == .le: Op.les else: Op.ne
        condition = 0
        if tagged_ne != 0: condition = tagged_ne
        else if math: condition = math_compare(atom.op, a, sum)
        else if c != 0:
            # Exactly, without comparing a wrapped word: a sum past int64
            # holds (upward) or fails (downward). Offsets are signed only.
            past = if c > 0: e_bin(.lts, VI, e_iconst(FACT_MAX - c), b) else: e_bin(.lts, VI, b, e_iconst(FACT_MIN - c))
            compared = e_bin(op, VI, a, sum)
            condition = if c > 0 or atom.op == .ne: e_bin(.or_, VI, past, compared) else: e_bin(.and_, VI, e_bin(.eq, VI, past, e_iconst(0)), compared)
        else:
            if unsigned and atom.op != .ne:
                # Bias both operands for an exact unsigned comparison on every target.
                a = e_bin(.xor, VI, a, e_iconst(FACT_MIN))
                b = e_bin(.xor, VI, b, e_iconst(FACT_MIN))
            condition = e_bin(op, VI, a, b)
        iff(e_bin(.eq, VI, condition, e_iconst(0)))
        fail = if math: "__mi_requirement_fail" else: "__requirement_fail"
        e_call_nr(rt(fail), [e_daddr(str_data(message)), e_daddr(loc_data(nodes[n].pos)), e_daddr(str_data(seen_left)), first, e_daddr(str_data(seen_right)), second], -1)
        endc()
        loop v in made: release(v, T_MATH_INT)

refine_gen_args = (args: int[], values: int[], offset: int, mutmask: int = 0):
    captured: int[]
    arg_types: int[]
    loop arg in args: arg_types.push(ntype(arg))
    loop i in [offset..values.len()): captured.push(values[i])
    loaded = false
    loop i in [0..args.len()):
        n = args[i]
        if nodes[n].kind != .conv or nodes[n].aux != i32(int(CV.refinement)): continue
        # (a contract may name what a mutable argument projects: that argument is its place's
        # address, so read the value it holds now, before the call)
        if not loaded:
            loaded = true
            loop j in [0..args.len()):
                if j < 62 and mutmask & (1 << j) != 0: captured[j] = load_val(representation_type(arg_types[j]), captured[j], 0)
        ref_gen_check(n, captured[i], captured, arg_types)

refine_gen_entry = (f: int):
    refine_ir_entry = []
    if not refine_owners.has(f): return
    loop l in fns[f].params:
        if int(locals[l].flags) & LF_MUTPARAM != 0: refine_ir_entry.push(-1)
        else: refine_ir_entry.push(freeze_scalar(int(locals[l].vreg), representation_type(int(locals[l].type))))

ref_validate_signature = (params: int[], ret: int, mask: int, pos: int):
    loop t in params:
        if ref_nested_formals(t): fatal(pos, "dependent element contracts require instantiated storage authority")
    result = prune(ret)
    loop types[result].kind == .opt: result = prune(int(types[result].elem))
    # (an element contract on formals would escape into the caller's storage,
    # where no call binds them)
    if ref_nested_formals(result): fatal(pos, "a result's element contract cannot depend on parameters")
    all = params + [result]
    loop i in [0..all.len()):
        t = prune(all[i])
        if types[t].kind != .refined: continue
        loop atom in ref_predicates[int(types[t].st)]:
            loop term in [atom.a, atom.b]:
                if term.kind != 2: continue
                j = term.value
                if j >= params.len(): fatal(pos, "missing refinement parameter")
                # (a by-value parameter may name what a mutable one projects: the contract holds
                # at entry, as a fact about the values it read then, which writes invalidate)
                entry_projection = i < params.len() and term.path.len() > 0 and mask & (1 << i) == 0
                if mask & (1 << j) != 0 and (i < params.len() or term.path.len() == 0) and not entry_projection and not (term.path.len() == 1 and term.path[0] <= -2 and is_nd(representation_type(params[j]))): fatal(pos, "mutable refinement dependencies are only valid in projected postconditions")
                a = if tkind(representation_type(t)) == .array or tkind(representation_type(t)) == .str_ or is_nd(representation_type(t)): T_INT else: representation_type(t)
                b = ref_projection_type(params[j], term.path, pos)
                shape_int = b == T_MATH_INT and nd_shape_predicates.has(int(types[t].st))
                if not shape_int and not ref_repr_match(b, a, term.path): fatal(pos, "dependent scalar refinement requires matching integer representations")
    # Dependency cycles cannot define a self-justifying set of contracts.
    done = fill(false, params.len())
    loop _ in [0..params.len()):
        loop i in [0..params.len()):
            if done[i]: continue
            ready = true
            t = prune(params[i])
            if types[t].kind == .refined:
                loop atom in ref_predicates[int(types[t].st)]:
                    loop term in [atom.a, atom.b]:
                        if term.kind == 2 and not done[term.value]: ready = false
            if ready: done[i] = true
    loop yes in done:
        if not yes: fatal(pos, "cyclic dependent scalar refinements")

ref_has_formals = (t0: int) -> bool:
    t = prune(t0)
    if types[t].kind != .refined: return false
    ref_atoms_have_kind(ref_predicates[int(types[t].st)], 2)

# (the parameter type finish_arg is coercing an argument to: its formals are that call's)
refine_arg_target = 0

# One shared, noncapturing service; resolution owns its reentrant context.
ref_storage_contract = (t0: int) -> bool:
    ref_types_storage(types, structs, fields, type_args, ref_fields_host, t0)

# A length (an int64 fact, never negative) may bound a uint64: its facts are
# mirrored into the biased uint64 order (ref_value).
ref_repr_match = (actual: int, expected: int, path: int[]) -> bool:
    if has_var(actual) or has_var(expected) or type_eq(actual, expected): return true
    expected == T_U64 and path.len() > 0 and path[path.len() - 1] == -1

# Resolve a projection against its concrete binder before publishing a contract.
ref_projection_type = (root: int, path: int[], pos: int) -> int:
    if path.len() == 1 and path[0] <= -2 and is_nd(representation_type(root)): return T_INT
    result = ref_types_projection(types, structs, fields, ref_fields_host, ref_projection_host, root, path, pos, T_INT)
    if result.error == 1: fatal(pos, "refinement length requires an array or a string")
    if result.error == 2: fatal(pos, "refinement field requires a record")
    if result.error == 3: fatal(pos, "unknown refinement field")
    result.type

ref_fact_current_entry = (s: mut FactState) -> int[]:
    args = refine_entry
    if fact_owner <= 0: return args
    f = fact_owner
    loop i in [0..fns[f].params.len()):
        l = fns[f].params[i]
        if int(locals[l].flags) & LF_MUTPARAM != 0: args[i] = fact_read(s, mk_ident_local(l, locals[l].pos))
    args

ref_has_fields = (t0: int) -> bool:
    t = prune(t0)
    if types[t].kind != .refined: return false
    ref_atoms_have_kind(ref_predicates[int(types[t].st)], 5)

ref_dependent_record = (t: int) -> bool:
    if tkind(t) != .struct_: return false
    si = int(types[prune(t)].st)
    loop i in [0..int(structs[si].nfields)):
        if ref_has_fields(int(fields[int(structs[si].fields) + i].type)): return true
    false

# (a record's own declaration errors: the notes of the statement whose type named
# it first, a tuple slot write's among them, are not theirs)
ref_validate_record = (t: int, pos: int):
    held = err_notes
    err_notes = []
    ref_validate_record_fields(t, pos)
    err_notes = held

ref_validate_record_fields = (t: int, pos: int):
    si = int(types[prune(t)].st)
    ref_sib_fields(si, pos)
    count = int(structs[si].nfields)
    done = fill(false, count)
    loop _ in [0..count):
        loop i in [0..count):
            if done[i]: continue
            ft = prune(int(fields[int(structs[si].fields) + i].type))
            if types[ft].kind != .refined: ref_self_misplaced(ft, i, int(fields[int(structs[si].fields) + i].name), pos, 0)
            ready = true
            if types[ft].kind == .refined:
                loop atom in ref_predicates[int(types[ft].st)]:
                    loop term in [atom.a, atom.b]:
                        if term.kind != 5: continue
                        j = term.value
                        if j >= count: fatal(pos, "refinement field is outside its record")
                        # (an alias's free name met the field it types: written on the field,
                        # its own name is its value, but the alias cannot know that name)
                        if j == i:
                            name = name_of(int(fields[int(structs[si].fields) + i].name))
                            fatal(pos, "the refinement of field '{name}' names '{name}', the field itself, through a type alias: name the value with a binder in the alias (`int64<v => 0 <=? v and v <? 10>`), or write the refinement on the field, where its own name is its value")
                        if not done[j]: ready = false
                        dep = int(fields[int(structs[si].fields) + j].type)
                        bound = ref_projection_type(dep, term.path, pos)
                        expected = if tkind(representation_type(ft)) == .array or tkind(representation_type(ft)) == .str_ or is_nd(representation_type(ft)) or is_map_type(representation_type(ft)): T_INT else: representation_type(ft)
                        if not ref_repr_match(bound, expected, term.path):
                            # (`head:int<v => v <? items.length>`: a length is an int64, so the
                            # field holding a position is one too)
                            name = name_of(int(fields[int(structs[si].fields) + i].name))
                            if tkind(ft) == .refined and is_int(expected) and is_int(bound): fatal(pos, "dependent field refinement requires matching integer representations: field '{name}' is {dt(expected)} and what it is compared with is {dt(bound)}, so declare it `{name}:{dt(bound)}<...>`")
                            fatal(pos, "dependent field refinement requires matching integer representations")
            if ready: done[i] = true
    loop yes in done:
        if not yes: fatal(pos, "cyclic dependent field refinements")

# Follow declaration aliases on demand, retaining the checked field/index route.
# O(alias depth); declarations only refer to previously established places.
ref_place_alias = (n: int) -> int:
    value = n
    loop nodes[value].kind == .ident and nodes[value].aux == i32(int(SK.local)):
        l = int(nodes[value].sym)
        if int(locals[l].flags) & LF_ALIAS == 0 or locals[l].alias == 0: break
        value = int(locals[l].alias)
    value

ref_field_store = (statement: int, target: int) -> int:
    lhs = ref_place_alias(int(nodes[statement].a))
    if nodes[lhs].kind != .field: return 0
    parent = int(nodes[lhs].a)
    t = representation_type(ntype(parent))
    if not ref_dependent_record(t) and not ref_dependent_ancestor(parent): return 0
    # (a field no contract mentions, in a record no contract above holds: an ordinary store)
    if ref_dependent_record(t) and not ref_dependent_ancestor(parent) and ref_field_free(t, int(nodes[lhs].aux)): return 0
    pos = nodes[statement].pos
    before: int[]
    path = index_update_path(parent)
    # A compound read captures selectors before evaluating the RHS. A plain
    # store evaluates its RHS first, exactly as gen_assign does.
    compound = nodes[statement].op != i32(int(Tok.assign))
    if compound:
        j = path.len() - 1
        loop j >= 0:
            part = path[j]; j -= 1
            if nodes[part].kind == .index and nodes[part].b != 0:
                nodes[part].b = i32(capture_value(int(nodes[part].b), ntype(int(nodes[part].b)), before))
    value = int(nodes[statement].b)
    if compound: value = compound_checked(statement, copy_place(lhs), value, representation_type(target))
    else:
        check_expr(value, representation_type(target))
        value = last_checked
    coerce(value, representation_type(target))
    value = capture_value(value, representation_type(target), before)
    if not compound:
        j = path.len() - 1
        loop j >= 0:
            part = path[j]; j -= 1
            if nodes[part].kind == .index and nodes[part].b != 0:
                nodes[part].b = i32(capture_value(int(nodes[part].b), ntype(int(nodes[part].b)), before))
    snapshot = capture_value(copy_place(parent), t, before)
    si = int(types[t].st)
    args: int[]
    loop i in [0..int(structs[si].nfields)):
        f = int(structs[si].fields) + i
        field = value
        if i != int(nodes[lhs].aux):
            field = bc_field(snapshot, name_of(int(fields[f].name)), pos)
            check_expr(field, 0)
            field = last_checked
        # Distinct AST nodes prevent one field's wrapper modifying another use.
        field = copy_checked(field)
        coerce(field, int(fields[f].type))
        args.push(field)
    ctor = mk(.call, pos)
    nodes[ctor] = Node(kind = .call, pos = pos, aux = 2, type = i32(t), flags = i32(NF_CHECKED))
    set_list(ctor, args)
    store = mk(.assign, pos)
    nodes[store].a = i32(parent)
    nodes[store].b = i32(ctor)
    nodes[store].op = i32(int(Tok.assign))
    store = check_assign(store)
    before.push(store)
    return bc_block(before, pos)

# (the receiver of a write the compiler made into an N-D array's own elements, `m[i j] = v`,
# `m[[a..b) c] = v`: the library setters keep its shape and storage, so a shaped field's contract
# still holds. Only these nodes, never another `@` argument. O(1))
ref_nd_receivers: {int: bool} = {}

ref_mutable_authority = (n: int):
    if ref_dependent_ancestor(n): fatal(nodes[n].pos, "mutable refinement access needs the full record invariant authority; pass the whole record with `@`")

# ---------------- paired length operations (docs/LANGUAGE.md, records) ----------------
# Fields whose contracts tie their lengths, `values:array<V length =? keys.length>`, change
# together: a run of consecutive statements, each changing one such field of the same record in
# place (`p.keys.push(k)` then `p.values.push(v)`), is checked once, after its last statement,
# against the whole record. Nothing between them can see the record: a later statement's operands
# neither name its root nor call anything, and the root is a local or parameter. Before the run,
# the tied fields' lengths are read while the record still holds its contract; inside it, reading
# a field assumes nothing of the contract (fact_pair_transient). A lone operation keeps the
# private candidate below and is refuted with a note naming the paired one. Demanded: O(run
# statements x operand size), only for a field of a dependent record.
ref_pair_stmts: {int: bool} = {}
ref_pair_checks: {int: bool} = {}
ref_pair_after: {int: int} = {}
ref_pair_hints: {int: str} = {}
fact_pair_transient = false
# (the open run: its record's place, as written in the statement that opened it)
ref_pair_open = 0
ref_pair_block = 0
ref_pair_index = -1

ref_pair_op = (name: str) -> bool:
    name == "push" or name == "pop" or name == "insert" or name == "remove" or name == "clear" or name == "extend" or name == "truncate"

# The array fields of record t whose lengths a contract ties to array field at's, in either
# direction (`values:array<V length =? keys.length>`). O(fields x atoms).
ref_pair_tied = (t: int, at: int) -> int[]:
    tied: int[]
    si = int(types[t].st)
    if at < 0 or at >= int(structs[si].nfields): return tied
    own = prune(int(fields[int(structs[si].fields) + at].type))
    if tkind(representation_type(own)) != .array: return tied
    loop i in [0..int(structs[si].nfields)):
        if i == at: continue
        ft = prune(int(fields[int(structs[si].fields) + i].type))
        if tkind(representation_type(ft)) != .array: continue
        named = false
        if types[ft].kind == .refined:
            loop atom in ref_predicates[int(types[ft].st)]:
                # (a bound on elements leaves the lengths free: ref_sib_in_place)
                if ref_sib_atom(atom): continue
                loop term in [atom.a, atom.b]:
                    if term.kind == 5 and term.value == at and term.path.len() == 1 and term.path[0] == -1: named = true
        if types[own].kind == .refined:
            loop atom in ref_predicates[int(types[own].st)]:
                if ref_sib_atom(atom): continue
                loop term in [atom.a, atom.b]:
                    if term.kind == 5 and term.value == i and term.path.len() == 1 and term.path[0] == -1: named = true
        if named: tied.push(i)
    tied

# The field of record t named name, or -1. O(fields).
ref_pair_field = (t: int, name: int) -> int:
    si = int(types[t].st)
    loop i in [0..int(structs[si].nfields)):
        if int(fields[int(structs[si].fields) + i].name) == name: return i
    -1

# The record whose tied field place is, when place can join a run: an array field whose length
# a contract ties to a sibling's, of a record no contract above holds, reached through names and
# literals. O(route + fields x atoms).
ref_pair_record = (place: int) -> int:
    if nodes[place].kind != .field or nodes[place].aux < 0: return 0
    r = int(nodes[place].a)
    t = representation_type(ntype(r))
    if not ref_dependent_record(t) or ref_dependent_ancestor(r) or ref_pair_tied(t, int(nodes[place].aux)).len() == 0: return 0
    route = r
    loop nodes[route].kind == .field or nodes[route].kind == .index:
        if nodes[route].kind == .index:
            selector = int(nodes[route].b)
            if nodes[route].aux != 0 or selector == 0: return 0
            if nodes[selector].kind != .int_lit and not (nodes[selector].kind == .ident and nodes[selector].aux == i32(int(SK.local))): return 0
        route = int(nodes[route].a)
    if nodes[route].kind != .ident or nodes[route].aux != i32(int(SK.local)): return 0
    r

# Do two routes name the same place: the same names, fields and selectors? Works on checked
# and unchecked nodes alike. O(route).
ref_pair_same = (a0: int, b0: int) -> bool:
    a = a0; b = b0
    loop depth in [0..32):
        ka = nodes[a].kind
        kb = nodes[b].kind
        if ka != kb: return false
        if ka == .ident: return nodes[a].name == nodes[b].name
        if ka == .field:
            if nodes[a].name != nodes[b].name: return false
        else if ka == .index:
            x = int(nodes[a].b); y = int(nodes[b].b)
            if x == 0 or y == 0 or nodes[x].kind != nodes[y].kind: return false
            if nodes[x].kind == .int_lit and nodes[x].ival != nodes[y].ival: return false
            if nodes[x].kind == .ident and nodes[x].name != nodes[y].name: return false
            if nodes[x].kind != .int_lit and nodes[x].kind != .ident: return false
        else: return false
        a = int(nodes[a].a); b = int(nodes[b].a)
    false

# Does an unchecked operand read the name root, call anything or leave? O(operand size).
ref_pair_touches = (n: int, root: int, depth: int) -> bool:
    if n == 0: return false
    if depth > 32: return true
    k = nodes[n].kind
    if k == .ident:
        if nodes[n].name == root: return true
        # (a function's name alone calls it when it takes nothing)
        sym = lookup(int(nodes[n].name))
        return sym != 0 and (syms[sym].kind == .fns or syms[sym].kind == .builtin or syms[sym].kind == .alias_ or syms[sym].kind == .module or syms[sym].kind == .reflected)
    # (values and operators only: no call, block, `or_throw`, `?? return` or other exit, which
    # could see the record or leave it before the run ends)
    plain = k == .int_lit or k == .float_lit or k == .str_lit or k == .bool_lit or k == .none_lit or k == .null_lit or k == .field or k == .dotname or k == .index or k == .unary or k == .binary or k == .and_ or k == .or_ or k == .not_ or k == .coalesce or k == .array or k == .tuple or k == .cast or k == .range or k == .namedarg or k == .pair or k == .hole
    if not plain: return true
    if nodes[n].a != 0 and ref_pair_touches(int(nodes[n].a), root, depth + 1): return true
    if nodes[n].b != 0 and ref_pair_touches(int(nodes[n].b), root, depth + 1): return true
    loop c in kids(n):
        if ref_pair_touches(c, root, depth + 1): return true
    false

# The root name of a route. O(route).
ref_pair_root = (r: int) -> int:
    route = r
    loop nodes[route].kind == .field or nodes[route].kind == .index: route = int(nodes[route].a)
    int(nodes[route].name)

# The statement of block b at i, through an attached `;`.
ref_pair_unwrap = (s0: int) -> int:
    s = s0
    if nodes[s].kind == .block and nkids(s) == 1: s = kid(s, 0)
    s

# (a one-statement discarding block, `p.keys.pop(at);`, opened in the statement i of block b:
# the run is in b, check.jo's block_open)
ref_pair_outer = 0
ref_pair_outer_block = 0
ref_pair_outer_index = -1
ref_pair_discard = (b: int):
    ref_pair_outer = b
    ref_pair_outer_block = sibling_block
    ref_pair_outer_index = sibling_index

# The block and statement being checked, seen through a discarding block.
ref_pair_through = () -> bool:
    ref_pair_outer != 0 and sibling_block == ref_pair_outer
ref_pair_here_block = () -> int:
    if ref_pair_through(): return ref_pair_outer_block
    sibling_block
ref_pair_here_index = () -> int:
    if ref_pair_through(): return ref_pair_outer_index
    sibling_index

# Does the statement after the current one change the length of another tied field of r in
# place, with operands that cannot see r? O(statement).
ref_pair_follows = (r: int) -> bool:
    b = ref_pair_here_block()
    i = ref_pair_here_index()
    if b == 0 or i < 0 or i + 1 >= nkids(b): return false
    s = ref_pair_unwrap(kid(b, i + 1))
    e = 0
    if nodes[s].kind == .exprstmt: e = int(nodes[s].a)
    # (`p.values.pop(at);` drops its value: `_ = p.values.pop(at)` until it is checked)
    if nodes[s].kind == .assign and nodes[s].op == i32(int(Tok.assign)) and nodes[int(nodes[s].a)].kind == .hole: e = int(nodes[s].b)
    if e == 0: return false
    if nodes[e].kind != .call: return false
    callee = int(nodes[e].a)
    if nodes[callee].kind != .field or not ref_pair_op(name_of(int(nodes[callee].name))): return false
    receiver = int(nodes[callee].a)
    if nodes[receiver].kind != .field or not ref_pair_same(int(nodes[receiver].a), r): return false
    # (an untied field's change checks nothing: it cannot close the run)
    if ref_pair_tied(representation_type(ntype(r)), ref_pair_field(representation_type(ntype(r)), int(nodes[receiver].name))).len() == 0: return false
    root = ref_pair_root(r)
    loop c in kids(e):
        if ref_pair_touches(c, root, 0): return false
    true

# The role of the length operation n on place in a run: 0 none, else 1 when it opens the
# run, plus 2 when it closes it. Only the whole expression of the statement being checked.
ref_pair_role = (n: int, place: int) -> int:
    b = ref_pair_here_block()
    i = ref_pair_here_index()
    if b == 0 or i < 0 or i >= nkids(b): return 0
    s = ref_pair_unwrap(kid(b, i))
    if nodes[s].kind != .exprstmt: return 0
    if n != 0 and int(nodes[s].a) != n: return 0
    # (a library operation, `p.keys.insert(k at)`: its receiver is the statement's)
    if n == 0:
        e = int(nodes[s].a)
        if nodes[e].kind != .call or nodes[int(nodes[e].a)].kind != .field: return 0
        if not ref_pair_same(int(nodes[int(nodes[e].a)].a), place): return 0
    r = ref_pair_record(place)
    if r == 0: return 0
    continuing = ref_pair_open != 0 and ref_pair_block == b and ref_pair_index + 1 == i and ref_pair_same(ref_pair_open, r)
    if ref_pair_open != 0 and ref_pair_block == b and ref_pair_index + 1 == i and not continuing: fatal(nodes[place].pos, "this statement was taken to continue the changes to {wit_text(ref_pair_open)}'s tied fields before it, but changes another record: name the record the same way in both")
    more = ref_pair_follows(r)
    ref_pair_open = if more: r else: 0
    ref_pair_block = b
    ref_pair_index = i
    if not continuing and not more: return 0
    role = 4
    if not continuing: role |= 1
    if not more: role |= 2
    role

# The record read whole while it still holds its contract, so the tied fields' relation is
# known before the run changes them: every write outside a run checks the whole record, and
# every run ends with that check, so its checks hold without proof (ref_pair_held). O(fields).
ref_pair_held: {int: bool} = {}
ref_pair_reads = (r: int, before: mut int[], pos: int):
    held = refine_requests.len()
    before.push(ref_pair_validation(r, pos, false))
    loop k in [held..refine_requests.len()): ref_pair_held[refine_requests[k].node] = true

# The whole record r checked as it now is: every field's contract against its siblings, as a
# constructor checks it. The record is not rebuilt. O(fields).
ref_pair_validation = (r: int, pos: int, transient: bool = true) -> int:
    t = representation_type(ntype(r))
    si = int(types[t].st)
    held = refine_requests.len()
    args: int[]
    loop i in [0..int(structs[si].nfields)):
        f = int(structs[si].fields) + i
        field = bc_field(copy_place(r), name_of(int(fields[f].name)), pos)
        check_expr(field, 0)
        field = copy_checked(last_checked)
        coerce(field, int(fields[f].type))
        args.push(field)
    ctor = mk(.call, pos)
    nodes[ctor] = Node(kind = .call, pos = pos, aux = 2, type = i32(t), flags = i32(NF_CHECKED))
    set_list(ctor, args)
    s = bc_stmt(ctor, pos)
    ref_pair_checks[s] = true
    if transient:
        ref_pair_stmts[s] = true
        hint = "help: the statements ending here change {wit_text(r)}'s tied fields together: they must leave every field's contract holding, so change each tied length by the same amount"
        loop k in [held..refine_requests.len()): ref_pair_hints[refine_requests[k].node] = hint
    s

# n, a member of a run, in place: the reads opening it, the operation, and the check closing it.
ref_pair_rewrite = (n: int, r: int, role: int, place: int, result_type: int) -> int:
    pos = nodes[n].pos
    before: int[]
    if role & 1 != 0: ref_pair_reads(int(nodes[place].a), before, pos)
    operation = copy_checked(n)
    add_flag(operation, NF_CHECKED)
    result = 0
    if result_type != T_VOID: result = capture_value(operation, result_type, before)
    else: before.push(bc_stmt(operation, pos))
    ref_pair_stmts[before[before.len() - 1]] = true
    if role & 2 != 0: before.push(ref_pair_validation(int(nodes[place].a), pos))
    if result != 0: before.push(bc_stmt(result, pos))
    nodes[n] = nodes[bc_block(before, pos)]
    nodes[n].type = i32(result_type)
    nodes[n].aux = 1
    add_flag(n, NF_CHECKED)
    result_type

# Is s a record check of a run (ref_pair_validation, ref_pair_reads) whose every contract is
# proven? Then it is facts only, and lowering emits nothing for it. O(fields).
ref_pair_erased = (s: int) -> bool:
    if ref_pair_checks.len() == 0 or not ref_pair_checks.has(s): return false
    loop c in kids(int(nodes[s].a)):
        if nodes[c].kind == .conv and nodes[c].aux == i32(int(CV.refinement)) and nodes[c].ival != 1: return false
    true

# A library operation in a run (`insert`): the call runs on the field itself.
ref_pair_call_finish = (n: int, prepared: RefArrayCall) -> int:
    before = prepared.before
    pos = nodes[n].pos
    before.push(bc_stmt(copy_checked(n), pos))
    ref_pair_stmts[before[before.len() - 1]] = true
    if let check = ref_pair_after.get(prepared.place): before.push(check)
    nodes[n] = nodes[bc_block(before, pos)]
    nodes[n].type = i32(T_VOID)
    add_flag(n, NF_CHECKED)
    T_VOID

# What a lone operation on a tied field is told: the fields its contract ties it to, and
# the paired operation. O(fields x atoms).
ref_pair_hint = (place: int, op: str) -> str:
    t = representation_type(ntype(int(nodes[place].a)))
    at = int(nodes[place].aux)
    si = int(types[t].st)
    tied: str[]
    loop i in ref_pair_tied(t, at): tied.push(name_of(int(fields[int(structs[si].fields) + i].name)))
    if tied.len() == 0: return ""
    record = wit_text(int(nodes[place].a))
    field = name_of(int(fields[int(structs[si].fields) + at].name))
    others = ""
    loop j in [0..tied.len()):
        if j > 0: others += if j == tied.len() - 1: " and " else: ", "
        others += "`{record}.{tied[j]}`"
    them = "it"
    if tied.len() > 1: them = "them"
    first = tied[0]
    root = name_of(ref_pair_root(int(nodes[place].a)))
    "help: `{op}` changes {record}.{field}.length, and the record's contract ties it to {others}: change {them} too, in the statements right after this one (`{record}.{first}.{op}(...)`), with nothing between them and with operands that neither read `{root}`, call a function nor leave early"

# Other length-changing operations execute on a private candidate. Later argument
# effects run before that candidate is published, so callbacks cannot observe
# an intermediate violation of the destination's storage contract.
ref_length_mutation = (n: int, r: int) -> int:
    id = nodes[n].aux as IN
    if id != .push and id != .pop and id != .insert and id != .remove and id != .clear and id != .extend and id != .resize and id != .truncate and id != .setlen: return r
    place = kid(n, 0)
    t = prune(refine_storage(place, ntype(place)))
    if types[t].kind != .refined and not ref_dependent_ancestor(place): return r
    # (a dependent record's sibling may bound this length: it publishes a candidate whole)
    if ref_self_active and ref_self_contract(t) and not ref_dependent_ancestor(place) and ref_self_grow(n, id, place, t): return r
    # (a change that keeps a sibling bound on elements: ref_sib_in_place)
    if ref_self_active and ref_sib_in_place(n, id, place, t): return r
    # (fields whose lengths are tied change in a run of statements: ref_pair_role)
    hints_from = -1
    if id != .resize and id != .setlen and ref_pair_record(place) != 0:
        role = ref_pair_role(n, place)
        if role != 0: return ref_pair_rewrite(n, ref_pair_record(place), role, place, r)
        hints_from = refine_requests.len()
    hint = if hints_from >= 0: ref_pair_hint(place, ref_pair_op_name(id)) else: ""
    before: int[]
    args = kids(n)
    # The receiver's selectors, then the operands, as gen_intrinsic evaluates them.
    path = index_update_path(place)
    j = path.len() - 1
    loop j >= 0:
        part = path[j]; j -= 1
        if nodes[part].kind == .index and nodes[part].b != 0: nodes[part].b = i32(capture_value(int(nodes[part].b), ntype(int(nodes[part].b)), before))
    loop i in [1..args.len()): args[i] = capture_value(args[i], ntype(args[i]), before)
    candidate = 0
    if ref_length_route(place, t):
        direct = ref_length_direct(id, place, t, args, nodes[n].pos)
        if direct > 0: before.push(bc_stmt(direct, nodes[n].pos))
        if direct < 0: candidate = -1
    else: candidate = -1
    if candidate != 0:
        candidate = capture_value(copy_place(place), representation_type(t), before)
        args[0] = candidate
    operation = copy_checked(n)
    add_flag(operation, NF_CHECKED)
    set_list(operation, args)
    result = 0
    if r != T_VOID: result = capture_value(operation, r, before)
    else: before.push(bc_stmt(operation, nodes[n].pos))
    if candidate != 0:
        store = bc_assign(place, copy_checked(candidate), nodes[n].pos)
        assigned = store
        store = check_assign(store)
        before.push(store)
        if ref_self_active and ref_self_contract(t): ref_self_shrink(assigned, place, id)
    if result != 0: before.push(bc_stmt(result, nodes[n].pos))
    nodes[n] = nodes[bc_block(before, nodes[n].pos)]
    nodes[n].type = i32(r)
    nodes[n].aux = 1
    add_flag(n, NF_CHECKED)
    if hint != "":
        loop k in [hints_from..refine_requests.len()): ref_pair_hints[refine_requests[k].node] = hint
    r

ref_pair_op_name = (id: IN) -> str:
    if id == .push: return "push"
    if id == .pop: return "pop"
    if id == .insert: return "insert"
    if id == .remove: return "remove"
    if id == .clear: return "clear"
    if id == .extend: return "extend"
    "truncate"

# Structural record conversion checks target fields after one source capture.
# Nominal records and mutable element-contract changes retain exact identity.
ref_record_conversion = (from: int, to: int) -> bool:
    if types[from].kind != .struct_ or types[to].kind != .struct_: return false
    fs = int(types[from].st); ts = int(types[to].st)
    if structs[fs].decl != structs[ts].decl or not has_flag(int(structs[fs].decl), NF_RECORD): return false
    if not ref_storage_contract(from) and not ref_storage_contract(to): return false
    check_struct_fields(fs)
    check_struct_fields(ts)
    loop i in [0..int(structs[ts].nfields)):
        a = int(fields[int(structs[fs].fields) + i].type)
        b = int(fields[int(structs[ts].fields) + i].type)
        if not can_coerce(0, a, b): return false
    true

ref_dependent_ancestor = (n: int) -> bool:
    value = ref_place_alias(n)
    loop nodes[value].kind == .field or nodes[value].kind == .index:
        value = int(nodes[value].a)
        if ref_dependent_record(representation_type(ntype(value))): return true
        value = ref_place_alias(value)
    false

ref_nested_formals = (t0: int, nested: bool = false, depth: int = 0) -> bool:
    ref_types_nested_formals(types, type_args, ref_predicates, t0, nested, depth)

# Library array mutations on refined storage use the same private-candidate
# boundary as intrinsic mutations. The published value is checked afterward;
# callbacks never gain unrefined authority over the caller's storage. Only
# these at-most-three-argument calls request it: O(receiver route depth).
struct RefArrayCall:
    before: int[]
    place: int = 0
    candidate: int = 0
    self_length: bool = false

ref_array_call_prepare = (decl: int, args: mut int[], ptypes: int[], written: int[]) -> RefArrayCall:
    out = RefArrayCall()
    if args.len() == 0 or not pos_in_lib(nodes[decl].pos): return out
    name = name_of(int(nodes[decl].name))
    if name != "__dewy_insert" and name != "swap" and name != "reverse" and name != "sort" and name != "sort_by" and name != "sort_with": return out
    place = args[0]
    t = prune(refine_storage(place, ntype(place)))
    if tkind(representation_type(t)) != .array or (types[t].kind != .refined and not ref_dependent_ancestor(place)): return out
    if not type_eq(representation_type(t), ptypes[0]): return out
    # (an insertion into a field whose length another's is tied to: a run, ref_pair_role)
    if name == "__dewy_insert" and ref_pair_record(place) != 0:
        role = ref_pair_role(0, place)
        if role == 0:
            lone = ref_pair_hint(place, "insert")
            fatal(nodes[place].pos, lone[6..])
        ref_nd_receivers[place] = true
        if role & 1 != 0: ref_pair_reads(int(nodes[place].a), out.before, nodes[place].pos)
        if role & 2 != 0: ref_pair_after[place] = ref_pair_validation(int(nodes[place].a), nodes[place].pos)
        out.place = place
        out.candidate = -1
        return out
    # (an insertion into a field bounded by a sibling: its value checked, then in place)
    sibling = name == "__dewy_insert" and ref_self_active and ref_sib_free(place, t)
    # (a permutation of a field bounded by a sibling, or of a sibling only such bounds name, keeps
    # the values and lengths, whatever a callback does: in place, as an `@` argument)
    if name != "__dewy_insert" and ref_self_active and ref_sib_permutable(place, t):
        ref_nd_receivers[place] = true
        return out
    if not sibling: ref_mutable_authority(place)
    check_place(place, true)
    self_length = ref_self_active and ref_self_contract(t)
    # (a swap changes neither the length nor the values, and has no callback to see it)
    if name == "swap" and (self_length or ref_length_route(place, t)):
        ref_self_direct[place] = true
        return out
    # Receiver selectors, then explicit operands in source order, once.
    path = index_update_path(place)
    j = path.len() - 1
    loop j >= 0:
        part = path[j]; j -= 1
        if nodes[part].kind == .index and nodes[part].b != 0: nodes[part].b = i32(capture_value(int(nodes[part].b), ntype(int(nodes[part].b)), out.before))
    loop source in written:
        a = unnamed(source)
        loop i in [1..args.len()):
            if args[i] != a: continue
            finish_arg(a, ptypes[i], false)
            args[i] = capture_value(a, representation_type(ptypes[i]), out.before)
            break
    # (an inserted value's check stands alone, after every operand ran: the
    # argument keeps its parameter's type)
    if self_length and name == "__dewy_insert" and args.len() > 1:
        checked = copy_checked(args[1])
        ref_self_value(checked, t, 1, place)
        out.before.push(bc_stmt(checked, nodes[checked].pos))
    if sibling and args.len() > 1:
        checked = copy_checked(args[1])
        ref_self_value(checked, t, 0, place)
        out.before.push(bc_stmt(checked, nodes[checked].pos))
        ref_nd_receivers[place] = true
        out.place = place
        out.candidate = -1
        return out
    out.place = place
    out.self_length = self_length
    out.candidate = capture_value(copy_place(place), representation_type(t), out.before)
    args[0] = copy_checked(out.candidate)
    add_flag(args[0], NF_MUT)
    out

# ---------------- self-length contracts (docs/design/refinement.md) ----------------
# An array type holds `every element op length + c` as one atom on the array,
# with term kind 6 on its left: every element. Stores check a transient element
# type whose atom has term kind 6 on its right: the length of the array stored
# into, named by the check's `.b` (a check with no such place is unproven). All
# of it is demanded: nothing here runs before the first such type is made.

# A binding's declared type: a plain array whose direct element's refinement names
# the binding's length becomes a wrapper (.trefined with no predicate, naming the
# binding) that resolve_refinement turns into the array's contract. Nothing else is
# armed, so any other spot resolves the name as usual. O(1), plus the predicate's
# syntax for a refined element.
# A parameter or field: most have no array type, so O(1) without a call deeper.
ref_holder_candidate = (binding: int):
    tn = int(nodes[binding].a)
    if tn != 0 and (nodes[tn].kind == .tarray or nodes[tn].kind == .trefined): ref_holder_mark(tn, int(nodes[binding].name))

ref_holder_arm = (tn: int, name: int):
    ref_declaring = name
    ref_holder_mark(tn, name)

ref_holder_mark = (tn: int, name: int):
    if tn == 0 or name == 0: return
    node = tn
    if nodes[node].kind == .trefined:
        if nodes[node].b == 0: return
        node = int(nodes[node].a)
    if nodes[node].kind != .tarray or nodes[node].ival != 0 or nodes[node].b != 0 or nodes[node].aux >= 2: return
    element = int(nodes[node].a)
    if element == 0 or nodes[element].kind != .trefined or not ref_holder_mentioned(int(nodes[element].b), name, 0): return
    if node != tn: fatal(nodes[tn].pos, "a self-length array cannot have a length contract as well")
    inner = nodes.len()
    nodes.push(nodes[tn])
    nodes[tn] = Node(kind = .trefined, pos = nodes[inner].pos, a = i32(inner), name = i32(name))

# (a field's name deeper inside its own type than its direct element: it would mean no one array)
ref_self_misplaced = (t0: int, field: int, name: int, pos: int, depth: int):
    t = prune(t0)
    if depth > 32: return
    k = types[t].kind
    if k == .refined:
        loop atom in ref_predicates[int(types[t].st)]:
            loop term in [atom.a, atom.b]:
                if term.kind == 5 and term.value == field and ref_path_length(term.path): fatal(pos, "'{name_of(name)}' is the field being declared: its length can bound the direct element of its array, as in `array<int64<(<? {name_of(name)}.length)>>`, and nothing else")
    if k == .refined or k == .array or k == .fixed or k == .opt: ref_self_misplaced(int(types[t].elem), field, name, pos, depth + 1)

ref_self_fail = (n: int, t: int, self: int, s: FactState, refuted: bool):
    contract = ref_spans.get(int(types[t].st)) ?? 0
    shown = wit_text(int(nodes[n].a))
    if shown == "": shown = "this array"
    what = "cannot prove every element of {shown} is a valid index of it"
    help = "help: a literal, `fill`, a `push` loop or an array with this same contract proves it; a slice or another call's result does not, so build it with `push`, or put `$runtime_checks` on this statement to check every element when it runs"
    if refuted: what = "refinement refuted: an element of {shown} is not a valid index of it"
    if let shrink = ref_self_shrinks.get(n):
        name = wit_text(shrink.0)
        if name == "": name = "this array"
        what = "cannot prove every element of {name} stays a valid index: this makes it shorter, and an element may be past its new end"
        if refuted: what = "refinement refuted: {name} gets shorter, and an element is past its new end"
        help = "help: only `{name}.clear()` shortens it for certain; to shorten it otherwise, build a new array with `push`, or put `$runtime_checks` on this statement to check every element when it runs"
    if not refuted and dir_defer(n, what, true): return
    err_notes.push((-1, help))
    wit_context(contract)
    wit_fail(nodes[n].pos, what)

# Every element of a whole array value: a loop, only under `$runtime_checks`. O(length).
ref_self_gen = (n: int, atom: RefAtom, self: int):
    bound = e_bin(.add, VI, arr_len(self), e_iconst(ref_self_k(atom)))
    if nodes[n].b != 0: bound = e_bin(.add, VI, bound, ref_ir_holder_length())
    at = e_call(rt("__first_element_above"), [self, bound], VI)
    iff(e_bin(.les, VI, e_iconst(0), at))
    message = "refinement failed: an element is not a valid index of its array"
    e_call_nr(rt("__requirement_fail"), [e_daddr(str_data(message)), e_daddr(loc_data(nodes[n].pos)), e_daddr(str_data("the position of the element")), at, e_daddr(str_data("the bound")), bound], -1)
    endc()

ref_selector_message = "a store into a self-length array selects with names, literals, arithmetic, lengths and element reads, none of which can change the array: give this selector a name first, `let at = ...`"

# Does a swap have the array itself, in place of a private candidate?
ref_self_direct_place = (a: int) -> bool: ref_self_direct.len() > 0 and ref_self_direct.has(a)

ref_self_stored = (t0: int) -> bool:
    t = prune(t0)
    types[t].kind == .refined and ref_atoms_have_kind(ref_predicates[int(types[t].st)], 6) and tkind(t) != .array and is_int(representation_type(t))

ref_atoms = (n: int, binder: int, out: mut RefAtom[], depth: int = 0):
    ref_resolve_atoms(nodes, types, names, refine_bindings, ref_resolve_host, n, binder, out, depth)

# ---------------- sibling-length elements (docs/LANGUAGE.md, records) ----------------
# `next:array<int64<(<? nodes.length)>>`: every element of a field is a valid index of a sibling
# array. The bound moves onto the field as one atom, every element (term kind 6) op the
# sibling's length (term kind 5), so it is a dependent field: construction, replacing either
# field and a sibling change made on a candidate check the record whole. A read of the field
# projects the bound as a value (FACT_SIB_BOUND), so an element read relates to the sibling's
# length. Stores and pushes into the field check the value against the sibling, in place;
# growing the sibling keeps the bound, in place. O(fields x atoms) once per record type.
ref_sib_atom = (atom: RefAtom) -> bool: atom.a.kind == 6 and atom.b.kind == 5

# The element a value with a sibling or self-length bound holds: an array's element, or a
# dictionary's value.
ref_held_element = (t: int) -> int:
    r = representation_type(t)
    if is_map_type(r): return struct_targ(int(types[r].st), 1)
    int(types[r].elem)

ref_sib_contract = (t0: int) -> bool:
    t = prune(t0)
    if types[t].kind != .refined: return false
    loop atom in ref_predicates[int(types[t].st)]:
        if ref_sib_atom(atom): return true
    false

# (only an element refinement written on the field's own array: a type argument's, as a
# dictionary's values in its library record, is another record's)
ref_sib_fields = (si: int, pos: int):
    d = int(structs[si].decl)
    if d == 0 or nodes[d].kind != .struct_: return
    loop k in [0..nkids(d)):
        tn = int(nodes[kid(d, k)].a)
        if tn == 0: continue
        if nodes[tn].kind == .trefined and nodes[tn].b != 0: tn = int(nodes[tn].a)
        dict = nodes[tn].kind == .tmap and nodes[tn].b != 0 and nodes[int(nodes[tn].b)].kind == .trefined
        if not dict and (nodes[tn].kind != .tarray or nodes[tn].a == 0 or nodes[int(nodes[tn].a)].kind != .trefined): continue
        name = int(nodes[kid(d, k)].name)
        loop i in [0..int(structs[si].nfields)):
            f = int(structs[si].fields) + i
            if int(fields[f].name) != name: continue
            made = if dict: ref_sib_dict_field(int(fields[f].type), name, pos, nodes[tn].aux == 1) else: ref_sib_field(int(fields[f].type), name, pos)
            if made != 0: fields[f].type = i32(made)

# A field's type with its elements bounded by a sibling's length, as its contract; else 0.
ref_sib_field = (ft0: int, name: int, pos: int) -> int:
    ft = prune(ft0)
    holder = ft
    if types[ft].kind == .refined: holder = prune(int(types[ft].elem))
    if types[holder].kind != .array: return 0
    element = prune(int(types[holder].elem))
    if types[element].kind != .refined: return 0
    made = ref_sib_bound(element, name, pos, holder != ft)
    if made.0 == 0: return 0
    out = mk_refined(mk_array(made.0), made.1)
    ref_self_elements[prune(out)] = made.2
    out

# `edges:dict<string int64<(<? terminal.length)>>`: the values of a dictionary field bounded by a
# sibling's length, as the field's contract over its values, as for an array's elements; else 0.
ref_sib_dict_field = (ft0: int, name: int, pos: int, total: bool) -> int:
    ft = prune(ft0)
    holder = ft
    if types[ft].kind == .refined: holder = prune(int(types[ft].elem))
    if not is_map_type(holder): return 0
    si = int(types[holder].st)
    element = prune(struct_targ(si, 1))
    if types[element].kind != .refined: return 0
    made = ref_sib_bound(element, name, pos, false)
    if made.0 == 0: return 0
    if total or holder != ft: fatal(pos, "field '{name_of(name)}': a dictionary whose values a sibling's length bounds cannot be a totaldict or have a contract of its own as well")
    runtime_fn("__first_live_value_above")
    # (made directly: a dictionary takes no refinement but this one, as a totaldict's)
    out = mk_type(TypeInfo(kind = .refined, elem = i32(get_struct_inst(int(structs[si].decl), [struct_targ(si, 0), made.0])), st = i32(made.1)), [])
    ref_self_elements[prune(out)] = made.2
    out

# A written element refinement naming a sibling's length: the plain element type, the predicate
# every element meets and the stored element's type; (0, 0, 0) when it names no sibling.
ref_sib_bound = (element: int, name: int, pos: int, contracted: bool) -> (int, int, int):
    written = ref_predicates[int(types[element].st)]
    named = false
    loop atom in written:
        if atom.b.kind == 5 and ref_path_length(atom.b.path) or atom.a.kind == 5 and ref_path_length(atom.a.path): named = true
    if not named: return (0, 0, 0)
    field = name_of(name)
    if contracted: fatal(pos, "field '{field}': an array whose elements a sibling's length bounds cannot have a length contract as well")
    base = int(types[element].elem)
    if has_var(base) or not type_eq(representation_type(base), T_INT): fatal(pos, "field '{field}': elements bounded by a sibling's length are int64 or addr, found {dt(base)}")
    rest: RefAtom[]
    whole: RefAtom[]
    stored: RefAtom[]
    loop atom in written:
        if atom.a.kind == 5 or atom.b.kind == 5:
            upper = atom.a.kind == 0 and atom.a.path.len() == 0 and atom.b.kind == 5 and ref_path_length(atom.b.path) and (atom.op == .lt or atom.op == .le)
            if not upper: fatal(pos, "field '{field}': a sibling's length bounds its elements only from above, `<? name.length` or `<=? name.length`, so that growing the sibling keeps it")
            whole.push(RefAtom(atom.op, RefTerm(6), RefTerm(5, atom.b.value, path = [-1], offset = atom.b.offset)))
            stored.push(RefAtom(atom.op, RefTerm(0), RefTerm(6, path = [-1], offset = atom.b.offset)))
        else: rest.push(atom)
    # (an upper bound on a signed index means a valid index, unless a lower bound is written)
    if not ref_self_lower_bound(rest): rest.push(RefAtom(.le, RefTerm(1, 0), RefTerm(0)))
    plain = mk_refined(base, ref_intern(rest))
    predicate = ref_intern(whole)
    span = ref_spans.get(int(types[element].st)) ?? pos
    if not ref_spans.has(predicate): ref_spans[predicate] = span
    ref_self_active = true
    runtime_fn("__first_element_above")
    (plain, predicate, mk_refined(plain, ref_intern(stored)))

# The bound every element of a value with the contract is at most: sibling length + c, as a value.
# One value per length and c, so reading the bound again adds no rows to the length, whose
# rows a tied field's relation needs (fact_difference keeps a few per term).
ref_sib_limit = (atom: RefAtom, args: int[], s: mut FactState, extra: int = 0) -> int:
    # (the sibling of the array a value is added to, as `extend` into it: the holder, kind 6)
    kind = atom.b.kind
    if kind == 5 and (atom.b.value >= args.len() or args[atom.b.value] == 0) or kind == 6 and ref_fact_holder == 0: return 0
    k = atom.b.offset + extra
    if atom.op == .lt: k -= 1
    length = ref_value(RefTerm(kind, atom.b.value, path = [-1]), 0, args, T_INT, s)
    if length == 0 or k == 0 or k < -64 or k > 64: return ref_value(RefTerm(kind, atom.b.value, path = [-1], offset = k), 0, args, T_INT, s)
    # (reused only where this state's rows say it is exactly length + k: values are numbered again
    # for each function)
    key = length * 256 + k + 128
    if let sum = ref_sib_sums.get(key):
        up = fact_row_find(s, sum, length)
        down = fact_row_find(s, length, sum)
        if up >= 0 and down >= 0 and s.differences[up].limit == k and s.differences[down].limit == -k: return sum
    sum = ref_value(RefTerm(kind, atom.b.value, path = [-1], offset = k), 0, args, T_INT, s)
    ref_sib_sums[key] = sum
    sum

# (a value read again with another record, as after a call changed the sibling, holds each bound:
# up to four, each a projection of its own, so a read relates to every one directly)
ref_sib_assume = (s: mut FactState, self: int, atom: RefAtom, args: int[]):
    if self == 0: return
    limit = ref_sib_limit(atom, args, s)
    if limit == 0: return
    count = 0
    j = fact_projection_first(s, self)
    loop j >= 0:
        p = s.projections[j]
        j = fact_projection_after(s, j)
        if p.element or p.selector != FACT_SIB_BOUND: continue
        if p.value == limit or fact_compare(s, .le, p.value, limit) == 1: return
        count += 1
    if count >= 4 or s.projections.len() >= FACT_CAP: return
    fact_add_projection(s, FactProjection(self, FACT_SIB_BOUND, false, limit))
    # (elements read before, as a call's summary keeps them: each is below the bound too)
    j = fact_projection_first(s, self)
    loop j >= 0:
        p = s.projections[j]
        j = fact_projection_after(s, j)
        if p.element: fact_difference(s, p.value, limit, 0, 0, 16)

# An element read from a value known to hold sibling bounds: O(bounds).
ref_sib_element_row = (s: mut FactState, base: int, v: int):
    j = fact_projection_first(s, base)
    loop j >= 0:
        p = s.projections[j]
        j = fact_projection_after(s, j)
        if not p.element and p.selector == FACT_SIB_BOUND: fact_difference(s, v, p.value, 0, 0, 16)

# A value read from a dictionary known to hold sibling bounds (`d[k]`, `d.pop(k)`, or the payload
# of `d.get(k)`): below each. O(bounds), nothing for any other dictionary.
ref_sib_map_read = (s: mut FactState, map: int, result: int, n: int):
    if map == 0 or result == 0 or fact_projection_find(s, map, FACT_SIB_BOUND, false) < 0: return
    v = result
    if tkind(ntype(n)) == .opt: v = fact_project(s, result, -4, false, telem(ntype(n)))
    if is_int(fact_type(ntype(n))) or tkind(ntype(n)) == .opt: ref_sib_element_row(s, map, v)

# A value from `d.pop(k default=x)` or `d.get(k x)` on such a dictionary: an entry's value, or x.
# Below each bound x is below (`none` has no value). O(bounds).
ref_sib_default_read = (s: mut FactState, map: int, result: int, dflt: int, given: int, n: int):
    if map == 0 or result == 0 or dflt == 0 or fact_projection_find(s, map, FACT_SIB_BOUND, false) < 0: return
    v = result
    if tkind(ntype(n)) == .opt: v = fact_project(s, result, -4, false, telem(ntype(n)))
    if not is_int(fact_type(ntype(n))) and tkind(ntype(n)) != .opt: return
    x = dflt
    literal = given
    loop nodes[literal].kind == .conv: literal = int(nodes[literal].a)
    absent = nodes[literal].kind == .none_lit
    if tkind(ntype(given)) == .opt and not absent: x = fact_project(s, dflt, -4, false, telem(ntype(given)))
    if not absent and x == 0: return
    j = fact_projection_first(s, map)
    loop j >= 0:
        p = s.projections[j]
        j = fact_projection_after(s, j)
        if p.element or p.selector != FACT_SIB_BOUND: continue
        if absent or fact_compare(s, .le, x, p.value) == 1: fact_difference(s, v, p.value, 0, 0, 16)

# Does every element of the value stay within the sibling bound? 1, 0 refuted, -1 unknown.
# O(inventory).
ref_sib_truth = (s: mut FactState, value: int, atom: RefAtom, args: int[]) -> int:
    if value == 0: return -1
    limit = ref_sib_limit(atom, args, s)
    if limit == 0: return -1
    j = fact_projection_first(s, value)
    loop j >= 0:
        p = s.projections[j]
        j = fact_projection_after(s, j)
        if not p.element and p.selector == FACT_SIB_BOUND and fact_compare(s, .le, p.value, limit) == 1: return 1
    length = fact_project(s, value, -1, false, T_INT)
    if length != 0 and fact_bound(s, length).hi == 0: return 1
    parts = fact_inventory(s, value)
    if parts.len() > 0:
        truth = 1
        loop part in parts:
            one = fact_compare(s, .le, part, limit)
            if one == 0: return 0
            if one < 0: truth = -1
        return truth
    copy = fact_projection_find(s, value, FACT_ELEMENT_COPY, false)
    if copy >= 0 and fact_compare(s, .le, s.projections[copy].value, limit) == 1: return 1
    hull = fact_projection_find(s, value, FACT_ELEMENT_VALUE, false)
    if hull >= 0:
        hi = fact_bound(s, s.projections[hull].value).hi
        if hi < FACT_MAX and fact_compare(s, .le, fact_constant(s, hi), limit) == 1: return 1
    below = fact_projection_find(s, value, FACT_ELEMENT_BELOW, false)
    if below >= 0 and fact_compare(s, .le, s.projections[below].value, ref_sib_limit(atom, args, s, 1)) == 1: return 1
    -1

# A dictionary literal's values against the bound: each an integer literal; else -1. O(entries).
ref_sib_literal_truth = (s: mut FactState, n: int, atom: RefAtom, args: int[]) -> int:
    v = int(nodes[n].a)
    loop v != 0 and nodes[v].kind == .conv: v = int(nodes[v].a)
    if v == 0 or nodes[v].kind != .map_lit: return -1
    if nkids(v) == 0: return 1
    # (the constants first: a comparison sees the terms its state held before the bound)
    values: int[]
    loop pair in kids(v):
        x = int(nodes[pair].b)
        loop x != 0 and nodes[x].kind == .conv: x = int(nodes[x].a)
        if x == 0 or nodes[x].kind != .int_lit: return -1
        values.push(fact_constant(s, int(nodes[x].ival)))
    limit = ref_sib_limit(atom, args, s)
    if limit == 0: return -1
    truth = 1
    loop value in values:
        one = fact_compare(s, .le, value, limit)
        if one == 0: return 0
        if one < 0: truth = -1
    truth

ref_sib_fail = (n: int, t: int, atom: RefAtom, refuted: bool):
    contract = ref_spans.get(int(types[t].st)) ?? 0
    shown = wit_text(int(nodes[n].a))
    dict = is_map_type(representation_type(t))
    if shown == "": shown = if dict: "this dictionary" else: "this array"
    sibling = ref_sib_name(atom, n)
    item = "element"
    one = "an element"
    if dict:
        item = "value"
        one = "a value"
    what = "cannot prove every {item} of {shown} is a valid index of {sibling}"
    if refuted: what = "refinement refuted: {one} of {shown} is not a valid index of {sibling}"
    help = "help: every element must be below the length of {sibling}: a literal, `fill` or elements known to be below it prove it; to make {sibling} shorter, first clear or shorten the array it bounds, or put `$runtime_checks` on this statement to check every element when it runs"
    if dict: help = "help: every value must be below the length of {sibling}: a literal or values known to be below it prove it; to make {sibling} shorter, put `$runtime_checks` on this statement to check every value when it runs"
    if ref_pair_hints.len() > 0 and ref_pair_hints.has(n): err_notes.push((-1, ref_pair_hints[n]))
    if not refuted and dir_defer(n, what, true): return
    err_notes.push((-1, help))
    wit_context(contract)
    wit_fail(nodes[n].pos, what)

# The sibling's name for a diagnostic, from the record the checked value is a field of.
ref_sib_name = (atom: RefAtom, n: int) -> str:
    if atom.b.kind == 6: return "`{wit_holder_text}`"
    v = int(nodes[n].a)
    if nodes[v].kind == .field:
        t = representation_type(ntype(int(nodes[v].a)))
        if tkind(t) == .struct_:
            si = int(types[t].st)
            if atom.b.value < int(structs[si].nfields): return "`{name_of(int(fields[int(structs[si].fields) + atom.b.value].name))}`"
    "its sibling"

# Every element of a whole array value against the sibling: a loop, only under `$runtime_checks`.
ref_sib_gen = (n: int, t: int, atom: RefAtom, self: int, args: int[], arg_types: int[]):
    length = if atom.b.kind == 6: ref_ir_holder_length() else: ref_ir_term(RefTerm(5, atom.b.value, path = [-1]), self, args, T_INT, arg_types)
    k = atom.b.offset
    if atom.op == .lt: k -= 1
    bound = e_bin(.add, VI, length, e_iconst(k))
    map = representation_type(t)
    at = 0
    if is_map_type(map):
        # (a dictionary's values, but for removed entries': their positions are left zero)
        si = int(types[map].st)
        vals = 0
        gone = 0
        loop i in [0..int(structs[si].nfields)):
            f = int(structs[si].fields) + i
            if name_of(int(fields[f].name)) == "vals": vals = load_val(int(fields[f].type), field_val_addr(f, self), 0)
            if name_of(int(fields[f].name)) == "gone": gone = load_val(int(fields[f].type), field_val_addr(f, self), 0)
        at = e_call(rt("__first_live_value_above"), [vals, gone, bound], VI)
    else: at = e_call(rt("__first_element_above"), [self, bound], VI)
    iff(e_bin(.les, VI, e_iconst(0), at))
    message = "refinement failed: an element is not a valid index of its sibling array"
    if is_map_type(map): message = "refinement failed: a value is not a valid index of its sibling array"
    e_call_nr(rt("__requirement_fail"), [e_daddr(str_data(message)), e_daddr(loc_data(nodes[n].pos)), e_daddr(str_data("the position of the element")), at, e_daddr(str_data("the bound")), bound], -1)
    endc()

# The sibling an element of field place is checked against, read again by the check; else 0.
ref_sib_holder = (place0: int) -> int:
    place = ref_place_alias(place0)
    t = prune(refine_storage(place, ntype(place)))
    if not ref_sib_contract(t) or nodes[place].kind != .field or nodes[place].aux < 0: return 0
    parent = int(nodes[place].a)
    rt0 = representation_type(ntype(parent))
    if tkind(rt0) != .struct_: return 0
    si = int(types[rt0].st)
    j = -1
    loop atom in ref_predicates[int(types[t].st)]:
        if ref_sib_atom(atom): j = atom.b.value
    if j < 0 or j >= int(structs[si].nfields): return 0
    field = bc_field(copy_place(parent), name_of(int(fields[int(structs[si].fields) + j].name)), nodes[place].pos)
    check_expr(field, 0)
    copy_checked(last_checked)

# Is field `at` of record t named by no contract but its own? O(fields x atoms).
ref_sib_unnamed = (t: int, at: int) -> bool:
    si = int(types[t].st)
    loop i in [0..int(structs[si].nfields)):
        if i == at: continue
        ft = prune(int(fields[int(structs[si].fields) + i].type))
        if types[ft].kind != .refined: continue
        loop atom in ref_predicates[int(types[ft].st)]:
            loop term in [atom.a, atom.b]:
                if term.kind == 5 and term.value == at: return false
    true

# Is field `at` of record t named only by sibling bounds on elements? O(fields x atoms).
ref_sib_only_bounds = (t: int, at: int) -> bool:
    si = int(types[t].st)
    seen = false
    loop i in [0..int(structs[si].nfields)):
        if i == at: continue
        ft = prune(int(fields[int(structs[si].fields) + i].type))
        if types[ft].kind != .refined: continue
        loop atom in ref_predicates[int(types[ft].st)]:
            loop term in [atom.a, atom.b]:
                if term.kind != 5 or term.value != at: continue
                if not ref_sib_atom(atom): return false
                seen = true
    seen

# A length change in place on a record's field, when what it changes keeps the record's contract:
# a push or insert into a field bounded by a sibling (its value checked against the sibling), any
# shrink of such a field, or growing a sibling only such bounds name. Else false, for the
# candidate route. O(fields x atoms).
ref_sib_in_place = (n: int, id: IN, place0: int, t: int) -> bool:
    record = ref_sib_record(place0)
    if record == 0: return false
    at = int(nodes[ref_place_alias(place0)].aux)
    if ref_sib_contract(t):
        if not ref_sib_free(place0, t): return false
        if id == .pop or id == .truncate or id == .remove or id == .clear: return true
        if (id == .push or id == .insert) and nkids(n) >= 2:
            ref_self_value(kid(n, 1), t, 0, place0)
            return true
        # (every extended element owes the sibling's length, checked once before it grows)
        if id == .extend and nkids(n) == 2:
            value = kid(n, 1)
            refine_coerce(value, ref_sib_extension(t))
            nodes[value].b = i32(ref_holder_place(place0))
            return true
        return false
    if types[prune(t)].kind == .refined or not ref_sib_only_bounds(record, at): return false
    id == .push or id == .insert or id == .extend

# The type of an array added to a field bounded by a sibling: every element below the sibling's
# length (term kind 6, the array the value goes into), the field's own element bounds as well.
ref_sib_extension = (t0: int) -> int:
    t = prune(t0)
    atoms: RefAtom[]
    loop atom in ref_predicates[int(types[t].st)]:
        atoms.push(RefAtom(atom.op, RefTerm(6), RefTerm(6, path = [-1], offset = atom.b.offset)))
    predicate = ref_intern(atoms)
    ref_span_copy(int(types[t].st), predicate)
    mk_refined(int(types[t].elem), predicate)

# The record type whose field place is, when no contract above that record holds it; else 0.
ref_sib_record = (place0: int) -> int:
    place = ref_place_alias(place0)
    if nodes[place].kind != .field or nodes[place].aux < 0: return 0
    parent = int(nodes[place].a)
    record = representation_type(ntype(parent))
    if tkind(record) != .struct_ or not ref_dependent_record(record) or ref_dependent_ancestor(parent): return 0
    record

# Is place a field whose only contract is a sibling bound on its elements, which no other
# contract names? Then its changes keep the record's contract when its new elements are checked.
ref_sib_free = (place0: int, t: int) -> bool:
    record = ref_sib_record(place0)
    if record == 0 or not ref_sib_contract(t): return false
    loop atom in ref_predicates[int(types[prune(t)].st)]:
        if not ref_sib_atom(atom): return false
    ref_sib_unnamed(record, int(nodes[ref_place_alias(place0)].aux))

# A loop's element of an array with a sibling bound is below it too. O(1) past the loop's own.
ref_sib_loop_elements = (n: int, base: int, s: mut FactState):
    if not ref_self_active or base == 0 or nodes[n].aux != 1 or int(nodes[n].sym) <= 0:
        fact_loop_elements(n, base, s)
        return
    l = int(nodes[n].sym)
    place = PlaceIdentity(.local, int(locals[l].owner), l)
    i = fact_binding(s, place)
    before = if i >= 0: s.bindings[i].value else: 0
    fact_loop_elements(n, base, s)
    if fact_projection_find(s, base, FACT_SIB_BOUND, false) < 0 or not is_int(fact_type(int(locals[l].type))): return
    i = fact_binding(s, place)
    value = if i >= 0: s.bindings[i].value else: 0
    if value == 0 or value == before:
        # (the element type's own bounds: `>=? 0` unless it states another)
        bound = fact_domain(int(locals[l].type))
        iterated = prune(refine_storage(int(nodes[n].a), ntype(int(nodes[n].a))))
        if ref_sib_contract(iterated): bound = ref_interval(int(types[representation_type(iterated)].elem), bound)
        value = fact_new(s, bound, FactTerm(type = int(locals[l].type)))
        fact_bind(s, place, value)
    ref_sib_element_row(s, base, value)

# A dictionary field bounded by a sibling changes in place: a value stored or inserted is checked
# against the sibling's length, as an array's pushed element is; removing entries keeps the bound.
# A change of a value in place (`d[k] += 1`) has no value to check first, so it is refused. O(1).
ref_sib_dict_call = (decl: int, args: mut int[], ptypes: int[]):
    if args.len() == 0 or args[0] == 0 or not ref_self_active: return
    place = args[0]
    t = prune(refine_storage(place, ntype(place)))
    if types[t].kind != .refined or not is_map_type(representation_type(t)) or not ref_sib_free(place, t): return
    name = name_of(int(nodes[decl].name))
    path = files[pos_file(nodes[decl].pos)].path
    if path != lib_dir + "/core/map.jo" and not (name == "pop" and path == lib_dir + "/std/dewy.jo"): return
    if name == "__map_entry" or name == "__map_entry_present":
        err_notes.push((-1, "help: store the new value whole, `d[k] = d[k] + 1`: a stored value is checked against the sibling's length"))
        fatal(nodes[place].pos, "a value of this dictionary is bounded by a sibling's length, so it cannot be changed in place")
    if name == "[]=" or name == "insert_if_absent":
        if args.len() < 3 or args[2] == 0: return
        finish_arg(args[2], ptypes[2], false)
        ref_self_value(args[2], t, 0, place)
    else if name != "remove" and name != "clear" and name != "pop" and name != "reserve" and name != "__map_tidy": return
    ref_nd_receivers[place] = true

ref_sib_permutable = (place: int, t: int) -> bool:
    record = ref_sib_record(place)
    if record == 0: return false
    if ref_sib_contract(t): return ref_sib_free(place, t)
    types[prune(t)].kind != .refined and ref_sib_only_bounds(record, int(nodes[ref_place_alias(place)].aux))

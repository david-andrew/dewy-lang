# rgb(255, 128, 0): colors go from 0 to 1 (more is brighter than white, for glow)
rgb_check = (n: int, args: int[]):
    big = false
    loop i in [0..3):
        # (a little above 1 is brighter than white, as a flash or a glow in 3D: rgb(3, 3, 3))
        if lit_num(args[i]) > 8.0: big = true
    if big: warn(nodes[n].pos, "the parts of a color go from 0 to 1 (above 1: brighter than white): for 0 to 255, divide by 255 or write hex(0xff8000)")
    # (rgba(0, 0, 0, 10): an alpha from 0 to 255)
    else if args.len() >= 4 and lit_num(args[3]) > 1.0: warn(nodes[int(args[3])].pos, "alpha goes from 0 (clear) to 1 (solid): {num_text(lit_num(args[3]))} of 255 is {lit_num(args[3]) / 255.0:.2f}")
# hsv(200, 0.8, 0.9): a hue in degrees, which goes around 0 to 1 here
hsv_check = (n: int, args: int[]):
    h = lit_num(args[0])
    if h > 1.0: warn(nodes[n].pos, "a hue goes from 0 to 1 around the color circle (as 0 to 360 degrees): {num_text(h)} degrees is `{h} / 360.0`")
num_text = (v: f64) -> str:
    if v == floor(v) and abs(v) < 1e15: return "{i64(v)}"
    "{v}"
# a number written as it is (5, 0.5): its value, else -1
lit_num = (a0: int) -> f64:
    if a0 == 0: return -1.0
    a = unnamed(a0)
    if not has_flag(a, NF_LITERAL) and nodes[a].kind != .float_lit: return -1.0
    if nodes[a].kind == .int_lit: return f64(nodes[a].ival)
    if nodes[a].kind == .float_lit: return nodes[a].fval
    if nodes[a].kind == .conv: return lit_num(int(nodes[a].a))
    -1.0
# (is p among the arguments of print, text, window and the like, on its line?)
# (".png" after a name in the source: cat1.png written without its quotes)
# the name after a dot after the n characters at p (this.tweens: "tweens"), or ""
member_after = (p: int, n: int) -> str:
    f = pos_file(p)
    if f < 0 or f >= files.len(): return ""
    src = files[f].src
    o = pos_off(p) + n
    if o >= len(src) or src[o] != '.': return ""
    e = o + 1
    loop e < len(src) and (is_alnum(src[e]) or src[e] == '_'): e += 1
    src[o + 1..e)
# (this.tweens.add, this.time.delayedCall, game.config.width: Phaser's, through its scene)
phaser_hint = (nm: str, member: str) -> str:
    if nm != "this" and nm != "game" and nm != "scene": return ""
    if member == "tweens": return " (a tween is a value: `t = tween(from, to, 0.3, ease = ease_out_back)`, kept in a variable or a field, with `t.update(dt)` and `t.value()` each frame)"
    if member == "time": return " (a wait is `Actions`: `steps.then(0.5, (): drop())` and `steps.update(dt)` in update; or `every(1, 0.5)`)"
    if member == "config" or member == "scale": return " (the screen's size is `screen_width()` and `screen_height()`)"
    if member == "add": return " (things are drawn each frame in draw, `circle(...)`, `sprite(...)`, `text(...)`, not added to a scene)"
    if member == "input": return " (input is asked for in update each frame: `mouse_pressed(.left)`, `mouse_pos()`, `key_pressed(.space)`)"
    if member == "sound": return " (`snd = load_wav(embed(\"pop.wav\"))` at the top, then `play(snd)`; or `sfx_coin()` and the other ready-made sounds)"
    if member == "cameras": return " (`shake` for a screen shake, `camera2d(...)` to move the view)"
    if member == "scene": return " (screens are an enum, `screen = Screen.play`, with a `match screen:` in update and in draw)"
    ""
file_ext_after = (p: int, n: int) -> str:
    f = pos_file(p)
    if f < 0 or f >= files.len(): return ""
    src = files[f].src
    o = pos_off(p) + n
    if o >= len(src) or src[o] != '.': return ""
    e = o + 1
    loop e < len(src) and is_alnum(src[e]): e += 1
    ext = lower(src[o + 1..e))
    loop x in ["png", "jpg", "jpeg", "wav", "ogg", "mp3", "txt", "json", "csv", "ttf", "otf", "glb", "gltf", "tmx", "jo"]:
        if ext == x: return src[o..e)
    ""
# (a name in the source alone between { and }: in a string, an interpolation of just it)
braced_alone = (p: int, n: int) -> bool:
    f = pos_file(p)
    if f < 0 or f >= files.len(): return false
    src = files[f].src
    o = pos_off(p)
    o > 0 and o + n < len(src) and src[o - 1] == '{{' and src[o + n] == '}}'
in_text_call = (p: int) -> bool:
    f = pos_file(p)
    if f < 0 or f >= files.len(): return false
    src = files[f].src
    o = pos_off(p) - 1
    loop o >= 0 and src[o] != '(' and src[o] != '\n' and src[o] != '"': o -= 1
    if o < 0 or src[o] != '(': return false
    e = o
    o -= 1
    loop o >= 0 and (is_alnum(src[o]) or src[o] == '_'): o -= 1
    w = src[o + 1..e)
    w == "print" or w == "text" or w == "text_centered" or w == "window" or w == "write" or w == "ui_button" or w == "ui_text" or w == "eprint"
# (the word w at p is all of an argument, made of letters only: print(hello), not print(totl + 1))
is_word_arg = (p: int, w: str) -> bool:
    loop c in w:
        if not is_alpha(c) or c == u8(95): return false
    src = files[pos_file(p)].src
    e = pos_off(p) + len(w)
    loop e < len(src) and src[e] == ' ': e += 1
    e < len(src) and (src[e] == ')' or src[e] == ',')
# (`thorns = Rect[]`: the name before the `=` on the line of p, "" when there is none)
name_before_eq = (p: int) -> str:
    f = pos_file(p)
    if f < 0 or f >= files.len(): return ""
    src = files[f].src
    o = pos_off(p) - 1
    # (p may be at the `[` after the type's name: that name first)
    loop o >= 0 and (is_alnum(src[o]) or src[o] == '_'): o -= 1
    loop o >= 0 and src[o] == ' ': o -= 1
    if o < 0 or src[o] != '=': return ""
    o -= 1
    loop o >= 0 and src[o] == ' ': o -= 1
    e = o + 1
    loop o >= 0 and (is_alnum(src[o]) or src[o] == '_'): o -= 1
    src[o + 1..e)
# (written in braces in the source: "{4}", not print(4) made into text)
brace_before = (p: int) -> bool:
    f = pos_file(p)
    if f < 0 or f >= files.len(): return false
    o = pos_off(p)
    src = files[f].src
    o > 0 and o <= len(src) and src[o - 1] == u8(123)          # ('{')
# "a str", "an int", "an f64", "a float64": a type named with its article
a_type = (t: int) -> str:
    s = dt(t)
    if len(s) > 0 and (s[0] == 'a' or s[0] == 'e' or s[0] == 'i' or s[0] == 'o' or (s[0] == 'f' and not ts_dewy) or s[0] == 'A' or s[0] == 'E' or s[0] == 'I' or s[0] == 'O'): return "an {s}"
    "a {s}"

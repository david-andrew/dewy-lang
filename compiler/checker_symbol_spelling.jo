use 'check.jo'

sanitize = (s: str) -> str:
    if len(s) > 0 and not is_alnum(s[0]) and s[0] != '_':
        i = 0
        loop i < OP_NAMES.len():
            if OP_NAMES[i] == s: return "op_{OP_NAMES[i + 1]}"
            i += 2
        return "op"
    # (a name of letters and digits, not too long, is its own)
    plain = len(s) <= 41
    loop c in s:
        if not plain: break
        if not is_alnum(c): plain = false
    if plain: return s
    b: u8[]
    loop c in s:
        if is_alnum(c): b.push(c)
        else: b.push('X')
        if b.len() > 40: break
    str_from_bytes(b)

# Frozen `is?` type-test checker extracted from expr.jo.
use 'node_store.dewy'
use 'checker_types.dewy'
use 'type_inference.dewy'
use 'type_unions.dewy'
use 'checker_resolve.dewy'
struct CheckerTypeTestHost:
    check: (int, int) -> int
    finalize: (int) -> int
    original: (int) -> int
    family: (int) -> bool
    family_test: (int, int, int, int) -> int
    members_test: (int, int, int, int, bool) -> int
    set_test: (int, int, int, int) -> int
    member_value: (int, int, int, int, int) -> int
    refined_test: (int, int, int) -> int
    implies: (int, int) -> bool
    presence: (int) -> int
    error: (int, int, int, int) -> void
struct CheckerTypeTestInput:
    nodes: *(Node[])
    types: *(TypeInfo[])
    structs: *(StructInfo[])
    refine: *bool
    last: *int
    string_type: *int
    bool_type: *int
    host: *CheckerTypeTestHost
xi_nodes: *(Node[])
xi_types: *(TypeInfo[])
xi_structs: *(StructInfo[])
xi_refine: *bool
xi_last: *int
xi_string_type: *int
xi_bool_type: *int
xi_host: *CheckerTypeTestHost
checker_type_tests_bind = (input: *CheckerTypeTestInput) -> int:
    xi_nodes = input[0].nodes
    xi_types = input[0].types
    xi_structs = input[0].structs
    xi_refine = input[0].refine
    xi_last = input[0].last
    xi_string_type = input[0].string_type
    xi_bool_type = input[0].bool_type
    xi_host = input[0].host
    0
xi_kind = (t: int) -> TK: xi_types[0][tu_prune(t)].kind
xi_union = (t0: int) -> bool:
    t = int(tu_prune(t0))
    xi_types[0][t].kind == .enum_ and xi_structs[0][int(xi_types[0][t].st)].union_
xi_set = (t0: int) -> int:
    t = int(tu_prune(t0))
    if xi_types[0][t].kind != .enum_: return 0
    int(xi_structs[0][int(xi_types[0][t].st)].lit_set)
xi_representation = (t0: int) -> int:
    t = int(tu_prune(t0))
    if xi_types[0][t].kind == .refined: return int(tu_prune(int(xi_types[0][t].elem)))
    t
xi_check = (n: int) -> int:
    orig = xi_host[0].original(int(xi_nodes[0][n].a))
    xi_host[0].check(int(xi_nodes[0][n].a), 0)
    xi_nodes[0][n].a = i32(xi_last[0])
    xi_host[0].finalize(int(xi_nodes[0][n].a))
    at = int(tu_prune(int(xi_nodes[0][int(xi_nodes[0][n].a)].type)))
    tt = int(ct_resolve_type(int(xi_nodes[0][n].b)))
    tk = xi_kind(tt)
    if xi_nodes[0][int(xi_nodes[0][n].b)].aux != -7 and (xi_union(tt) or tk == .opt) and xi_host[0].family(tt):
        return xi_host[0].family_test(n, orig, at, tt)
    if xi_types[0][at].kind == .opt and xi_union(int(xi_types[0][at].elem)) and xi_types[0][tt].kind != .none_lit:
        r = xi_host[0].members_test(n, orig, int(tu_prune(int(xi_types[0][at].elem))), tt, true)
        if r >= 0: return r
    if xi_union(at) and xi_union(tt) and uu_index(at, tt) < 0:
        r = xi_host[0].members_test(n, orig, at, tt, false)
        if r >= 0: return r
    set = xi_set(tt)
    if set != 0 and not xi_union(at) and (at == xi_string_type[0] or xi_set(at) != 0):
        return xi_host[0].set_test(n, orig, at, set)
    if xi_union(at) and (xi_types[0][tt].kind == .refined or set != 0) and uu_index(at, tt) < 0:
        r = xi_host[0].member_value(n, orig, at, tt, set)
        if r >= 0: return r
    if xi_types[0][tt].kind == .refined and xi_kind(xi_representation(tt)) == .int_ and xi_kind(xi_representation(at)) == .int_ and not xi_union(at):
        return xi_host[0].refined_test(n, orig, tt)
    if xi_union(at):
        vi = int(uu_index(at, tt))
        if vi < 0: xi_host[0].error(n, at, tt, 1)
        xi_nodes[0][n].aux = i32(vi)
    else if xi_types[0][at].kind == .opt:
        elem = int(xi_types[0][at].elem)
        if xi_types[0][tt].kind == .none_lit: xi_nodes[0][n].aux = -1
        else if tu_equal(tt, elem) or (xi_refine[0] and xi_host[0].implies(elem, tt)): xi_nodes[0][n].aux = -2
        else: xi_host[0].error(n, at, tt, 2)
        xi_nodes[0][n].aux2 = i32(xi_host[0].presence(int(xi_nodes[0][n].a)))
    else if tu_equal(at, tt) or (xi_union(tt) and uu_index(tt, at) >= 0): xi_nodes[0][n].aux = -3
    else: xi_host[0].error(n, at, tt, 3)
    xi_bool_type[0]

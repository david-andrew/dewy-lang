# The frozen implementation-language twin of line_table.dewy, for the compilers without
# the Dewy frontend (tools/compiler/build.py). Change both, or neither.

struct LineTable:
    starts: int[][]     # by file: the offset of each line's first byte
    file: int           # the line found last: its file, its first offset,
    start: int          # the offset past it (0 before any) and its number
    stop: int
    line: int

# where each line of src starts: 0, then the offset after each newline. Newlines are
# found a word at a time: only a word holding one is scanned by byte; O(bytes / 8 + lines)
line_starts = (src: str) -> int[]:
    ls = [0]
    n = len(src)
    sp = data(src)
    i = 0
    loop i + 8 <= n:
        w = ((sp + i) as *u64)[0] xor 0x0A0A0A0A0A0A0A0A
        if (w - 0x0101010101010101) & (w xor 0xFFFFFFFFFFFFFFFF) & 0x8080808080808080 != 0:
            loop j in [i..i + 8):
                if sp[j] == 10: ls.push(j + 1)
        i += 8
    loop i < n:
        if sp[i] == 10: ls.push(i + 1)
        i += 1
    ls

# the line and column (from 1) of byte off of file f, whose text is src
line_col_in = (t: mut LineTable, f: int, off: int, src: str) -> (int, int):
    if f == t.file and off >= t.start and off < t.stop: return (t.line, off - t.start + 1)
    loop t.starts.len() <= f: t.starts.push([])
    if t.starts[f].len() == 0: t.starts[f] = line_starts(src)
    # (indexed directly: data() of an element would copy the whole array first)
    ls = t.starts[f]
    lo = 0
    hi = ls.len() - 1
    loop lo < hi:
        mid = (lo + hi + 1) / 2
        if ls[mid] <= off: lo = mid
        else: hi = mid - 1
    t.file = f
    t.start = ls[lo]
    t.stop = 1 << 62
    if lo + 1 < ls.len(): t.stop = ls[lo + 1]
    t.line = lo + 1
    (lo + 1, off - ls[lo] + 1)

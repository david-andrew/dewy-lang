$runtime_checks
from p"expression_types.dewy" import (ntype)

# Checked-node spelling and slice diagnostic entry points. Jo retains the
# witness stores; the pure witness_text leaf retains its state-free contract.
from p"ast.jo" import (NF_U64 has_flag kid nkids nodes)
from p"check.jo" import (LF_ALIAS index_update_sources locals)
from p"checker_tokens.dewy" import Tok
from p"expr.jo" import (CV IN capture_sources union_field_sources)
from p"type_ops.dewy" import int_policy
from p"types.jo" import (is_int prune)
from p"util.jo" import (err_notes name_of)
from p"facts.jo" import FactState
from p"facts_index_writes.dewy" import fact_constant
from p"facts_maps.dewy" import fact_map_call
from p"facts_pools.dewy" import fact_pool_call
from p"facts_ranges.dewy" import fact_floor_call
from p"facts_text.dewy" import fact_string_call
from p"directive_rules.dewy" import dir_defer
from p"witness.jo" import WitSide
from p"witness_ops.dewy" import (wit_call_text wit_clamp_help wit_context wit_fail wit_help wit_operand wit_quoted wit_relation wit_relation_text wit_same_value wit_side)
from p"witness_text.dewy" import wit_hidden_name
from p"@lib/core/str.jo" import starts_with
from p"node_store.dewy" import (node_op)

WitnessNodeWord:type=int64<overflow='wrap'>
# Frozen checked-node symbol/token tags, shared with the Jo reader and twin.
const WN_LOCAL=1
const WN_PERCENT=62
const WN_SLASH=61
const WN_PLUS=58
const WN_MINUS=59
const WN_STAR=60


# Input IDs are valid checked nodes. Reacquire arena elements after services;
# retain scalar IDs/fields, never a pointer across a potentially growing call.
wit_text=(e0:WitnessNodeWord depth:WitnessNodeWord=0):>string=>$unsafe {
    let e:WitnessNodeWord=e0
    if e <=? 0 or depth >? 8 {return ""}
    loop nodes.ptr[e].kind =? 'narrow' or nodes.ptr[e].kind =? 'conv' and (wit_same_value(e) or nodes.ptr[e].aux =? int32(int64(CV.refinement)) or nodes.ptr[e].aux =? int32(int64(CV.set_text))) {
        e=WitnessNodeWord(nodes.ptr[e].a)
    }
    let k=nodes.ptr[e].kind
    if k =? 'block' {
        let source=union_field_sources.get(e)
        if source not=? none {
            let base=wit_text(source[0] depth + 1)
            if base not=? "" {return "{base}.{name_of(source[1])}"}
        }
    }
    if k =? 'ident' and nodes.ptr[e].name =? 0 and nodes.ptr[e].aux =? int32(WN_LOCAL) and nodes.ptr[e].sym >? 0 {
        let source=capture_sources.get(WitnessNodeWord(nodes.ptr[e].sym))
        if source not=? none {
            let shown=wit_text(source depth + 1)
            return if starts_with(shown "__") or starts_with(shown "#") {""} else {shown}
        }
    }
    if k =? 'ident' and nodes.ptr[e].name not=? 0 {
        let name=name_of(WitnessNodeWord(nodes.ptr[e].name))
        let updated=index_update_sources.get(WitnessNodeWord(nodes.ptr[e].name))
        if updated not=? none {return wit_text(updated depth + 1)}
        if nodes.ptr[e].aux =? int32(WN_LOCAL) and (starts_with(name "#L") or starts_with(name "#G")) {
            let l:WitnessNodeWord=WitnessNodeWord(nodes.ptr[e].sym)
            if WitnessNodeWord(locals.ptr[l].flags) & LF_ALIAS not=? 0 and locals.ptr[l].alias not=? 0 {
                let source:WitnessNodeWord=WitnessNodeWord(locals.ptr[l].alias)
                if nodes.ptr[source].kind =? 'unwrap' {source=WitnessNodeWord(nodes.ptr[source].a)}
                return wit_text(source depth + 1)
            }
        }
        return if wit_hidden_name(name) {""} else {name}
    }
    if k =? 'int_lit' and not has_flag(e NF_U64) and int_policy(ntype(e)) =? 0 {return "{nodes.ptr[e].ival}"}
    if k =? 'str_lit' {return wit_quoted(e)}
    if k =? 'field' and nodes.ptr[e].aux >=? 0 {
        let a:WitnessNodeWord=WitnessNodeWord(nodes.ptr[e].a)
        loop nodes.ptr[a].kind =? 'addr' or nodes.ptr[a].kind =? 'conv' {a=WitnessNodeWord(nodes.ptr[a].a)}
        if nodes.ptr[a].kind =? 'ident' and nodes.ptr[a].name not=? 0 and starts_with(name_of(WitnessNodeWord(nodes.ptr[a].name)) "$self") {return name_of(WitnessNodeWord(nodes.ptr[e].name))}
        let base=wit_text(WitnessNodeWord(nodes.ptr[e].a) depth + 1)
        if base not=? "" {return "{base}.{name_of(WitnessNodeWord(nodes.ptr[e].name))}"}
    }
    if k =? 'intrinsic' and nodes.ptr[e].aux =? int32(int64(IN.len)) and nkids(e) >? 0 {
        let base=wit_text(kid(e 0) depth + 1)
        if base not=? "" {return "{base}.length"}
    }
    if k =? 'index' and nodes.ptr[e].b not=? 0 {
        let at:WitnessNodeWord=WitnessNodeWord(nodes.ptr[e].b)
        if nodes.ptr[at].kind =? 'call' and (fact_map_call(at) =? 3 or fact_map_call(at) =? 5) and nkids(at) >=? 2 {
            let base=wit_text(kid(at 0) depth + 1)
            let index=wit_text(kid(at 1) depth + 1)
            return if base not=? "" and index not=? "" {"{base}[{index}]"} else {""}
        }
        let base=wit_text(WitnessNodeWord(nodes.ptr[e].a) depth + 1)
        let index=wit_text(WitnessNodeWord(nodes.ptr[e].b) depth + 1)
        if base not=? "" and index not=? "" {return "{base}[{index}]"}
    }
    if k =? 'binary' and (node_op(nodes.ptr[e].op_ext) =? int32(WN_PERCENT) or node_op(nodes.ptr[e].op_ext) =? int32(WN_SLASH) and is_int(prune(ntype(e)))) {
        let left=wit_operand(WitnessNodeWord(nodes.ptr[e].a) depth + 1)
        let right=wit_operand(WitnessNodeWord(nodes.ptr[e].b) depth + 1)
        if left =? "" or right =? "" {return ""}
        let operator=if node_op(nodes.ptr[e].op_ext) =? int32(WN_PERCENT) {"%"} else {"//"}
        return "{left} {operator} {right}"
    }
    if k =? 'binary' and (node_op(nodes.ptr[e].op_ext) =? int32(WN_PLUS) or node_op(nodes.ptr[e].op_ext) =? int32(WN_MINUS) or node_op(nodes.ptr[e].op_ext) =? int32(WN_STAR)) {
        let star=node_op(nodes.ptr[e].op_ext) =? int32(WN_STAR)
        let left=if star {wit_operand(WitnessNodeWord(nodes.ptr[e].a) depth + 1)} else {wit_text(WitnessNodeWord(nodes.ptr[e].a) depth + 1)}
        let right=if node_op(nodes.ptr[e].op_ext) =? int32(WN_PLUS) {wit_text(WitnessNodeWord(nodes.ptr[e].b) depth + 1)} else {wit_operand(WitnessNodeWord(nodes.ptr[e].b) depth + 1)}
        if left =? "" or right =? "" {return ""}
        if star {return "{left}*{right}"}
        let sign=if node_op(nodes.ptr[e].op_ext) =? int32(WN_PLUS) {"+"} else {"-"}
        return "{left} {sign} {right}"
    }
    if k =? 'block' and nkids(e) >=? 3 and nkids(e) <=? 10 and nodes.ptr[kid(e 0)].kind =? 'vardecl' and starts_with(name_of(WitnessNodeWord(nodes.ptr[kid(e 0)].name)) "$spread") {
        let parts:array<string>=[]
        let stop:WitnessNodeWord=WitnessNodeWord(nkids(e)) - 1
        loop i in [WitnessNodeWord(1)..stop) {
            let call:WitnessNodeWord=kid(e i)
            if nodes.ptr[call].kind =? 'exprstmt' {call=WitnessNodeWord(nodes.ptr[call].a)}
            if nodes.ptr[call].kind not=? 'intrinsic' or nkids(call) not=? 2 or nodes.ptr[call].aux not=? int32(int64(IN.push)) and nodes.ptr[call].aux not=? int32(int64(IN.extend)) {return ""}
            let text=wit_text(kid(call 1) depth + 1)
            if text =? "" {return ""}
            parts.push(if nodes.ptr[call].aux =? int32(int64(IN.extend)) {"{text}..."} else {text})
        }
        return "[{join(parts " ")}]"
    }
    if k =? 'call' {
        if fact_string_call(e) =? 1 {
            let base=wit_text(kid(e 0) depth + 1)
            if base not=? "" {return "{base}.length"}
        }
        let floor:WitnessNodeWord=fact_floor_call(e)
        if floor not=? 0 {
            let left=wit_operand(kid(e 0) depth + 1)
            let divisor:WitnessNodeWord=kid(e 1)
            let right=if floor =? 1 or floor =? 2 {wit_operand(divisor depth + 1)} else if nodes.ptr[divisor].kind not=? 'int_lit' {""} else if floor =? 3 {"{WitnessNodeWord(1) << WitnessNodeWord(nodes.ptr[divisor].ival)}"} else {"{WitnessNodeWord(nodes.ptr[divisor].ival) + 1}"}
            if left =? "" or right =? "" {return ""}
            let operator=if floor =? 1 or floor =? 3 {"//"} else {"%"}
            return "{left} {operator} {right}"
        }
        let m:WitnessNodeWord=fact_map_call(e)
        if m =? 2 or m =? 5 or fact_pool_call(e) =? 2 {
            let base=wit_text(kid(e 0) depth + 1)
            let index=wit_text(kid(e 1) depth + 1)
            if base not=? "" and index not=? "" {return "{base}[{index}]"}
            return ""
        }
        return wit_call_text(e depth)
    }
    ""
}

wit_slice_at=(n:WitnessNodeWord @s:FactState lo:WitnessNodeWord hi:WitnessNodeWord length:WitnessNodeWord checks:array<int64> receiver:WitnessNodeWord lo_node:WitnessNodeWord hi_node:WitnessNodeWord inclusive:bool clamp:bool=false):>void=>$unsafe {
    let base=wit_text(receiver)
    let start=if lo_node not=? 0 {wit_side(lo lo_node)} else {WitSide(lo 0 "0" false true)}
    let stop=if hi_node not=? 0 {wit_side(hi hi_node)} else {WitSide(hi 0 (if base not=? "" {"{base}.length"} else {""}) true)}
    if hi_node not=? 0 and inclusive and stop.text not=? "" {stop.text="{stop.text} + 1"}
    let zero=WitSide(fact_constant(@s 0) 0 "0" false true)
    let size=WitSide(length receiver (if base not=? "" {"{base}.length"} else {""}) true)
    let pairs:array<[WitSide WitSide]>=[[zero start] [start stop] [stop size]]
    let labels:array<string>=["lower bound" "ordered bounds" "upper bound"]
    let refuted=checks.contains(0)
    let relations:array<string>=[]
    let missing:array<string>=[]
    loop i in 0.. and pair in pairs {
        let at:WitnessNodeWord=WitnessNodeWord(i)
        if checks[at] =? 1 or refuted and checks[at] not=? 0 {continue}
        let shown=wit_relation_text(Tok.le pair[0] pair[1])
        if at =? 2 and inclusive and hi_node not=? 0 {
            let plain=wit_side(hi hi_node)
            shown=wit_relation_text(Tok.lt plain pair[1])
        }
        if shown not=? "" and not relations.contains(shown) {relations.push(shown)}
        wit_relation(s s Tok.le pair[0] pair[1] refuted labels[at]);
        missing.push(labels[at]);
    }
    wit_context(0);
    let relation=join(relations "` and `")
    wit_help(relation);
    if clamp and (not inclusive or hi_node =? 0) {wit_clamp_help(base lo_node hi_node)}
    else if clamp and base not=? "" {
        let first=if lo_node not=? 0 {wit_text(lo_node)} else {""}
        let last=wit_text(hi_node)
        if last not=? "" and (lo_node =? 0 or first not=? "") {
            err_notes.push([-1 "help: `{base}[{first}..{last}]` includes position {last}; Python's `{base}[{first}:{last}]` stops before it and truncates to `{base}`: `{base}[$clamp {first}..{last})`"])
        }
    }
    if refuted {
        if dir_defer(n "slice is not in bounds" true) {return}
        wit_fail(nodes.ptr[n].pos "slice is not in bounds");
        return
    }
    if dir_defer(n "cannot prove slice is in bounds: missing {join(missing " and ")}" true) {return}
    wit_fail(nodes.ptr[n].pos "cannot prove slice is in bounds: missing {join(missing " and ")}");
}

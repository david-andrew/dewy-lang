# Deadlock freedom, stage 1 (docs/design/safety_and_concurrency.md, "Deadlock freedom"): with no
# annotations, the compiler infers lock identities, held-lock sets and the order locks are taken
# in, across the program. Errors only for what it demonstrates:
#   - a lock-order cycle (two paths taking the same locks in opposite orders), with a fix-it to
#     take them together with `lock_all`;
#   - waiting for a lock the task already holds (directly, through a call or a callback, or
#     through a copied handle);
#   - holding a lock across a join of tasks, or a `parallel` loop, whose work takes it;
#   - a `parallel` iteration polling an atomic that only a sibling iteration sets.
# Undecided cases (elements of one array taken in an order the indexes decide, a lock held
# across a call of a function value, polling an atomic set elsewhere) are warnings.
#
# Identities. A lock is named by an abstract location: a root and a route of fields and
# elements. Roots are a global, a local's declaration (where its handle was made; copies
# `let m2 = m` and places `@m` follow to it, captures to the enclosing function's local), a
# parameter of the function (symbolic, replaced by the argument's location at each call), or
# unknown. Two locations with the same root and route and no element step are one lock; with an
# element step they may be.
#
# Demand and cost. Nothing runs unless the checker saw a lock taken (deadlock_fns, filled by
# place_methods.jo). Then: one scan of the checked function bodies for the call graph (O(N)),
# the upward closure of the functions taking locks (the only ones whose summaries are not
# empty), and summaries iterated to a fixed point over that set (acquired locations, symbolic
# order edges, callbacks called under a lock), each pass O(N_rel + E_rel * K) with K the
# distinct locations (indexed by key), at most DL_PASSES passes; then one reporting pass and a
# cycle search over the location graph (Tarjan, O(V + E)).
use 'ast.jo'
use 'types.jo'
use 'check.jo'
use 'expr.jo'
use 'util.jo'
use 'lower.jo'
use 'isolation.jo'
use 'concurrency.jo'
use 'effects.jo'
use 'prelude.jo'
use 'errors.jo'
use 'directives.jo'
use 'ownership.jo'

deadlock_fns: {int: bool}       # functions whose bodies take a lock (place_methods.jo)
deadlock_parallel = false        # the program runs `parallel` work (a cycle is reachable by tasks)
deadlock_atomics = false         # the program uses an atomic (concurrency_atomic_call)
dc_fns: {int: bool}              # functions calling a channel operation (dl_scan_calls)
dc_mod = -1                      # the channels prelude's module, once loaded
pc_mod = -2                      # the protocols prelude's module (-1 none; -2 not looked up)

const DL_PASSES = 8

struct DlLoc:
    root: int        # 0 unknown, 1 global, 2 declaration, 3 parameter, 4 a local itself
    id: int          # the global, the declaration node, or the function (parameter)
    k: int           # the parameter's index
    route: str       # ".balance", "[]"
    exact: bool      # no element step, root known: one lock

struct DlAcq:
    loc: DlLoc
    site: int        # where it is taken (the wait)
    wait: bool       # waits for it (lock, lock_all), or only holds it (try_lock)
    via: str         # "" or the chain of calls that takes it

struct DlEdge:
    held: DlLoc
    taken: DlLoc
    held_site: int
    taken_site: int
    via: str
    at: int = 0      # the call (or wait) in the function where it became concrete

struct DlCallback:
    param: int       # the parameter called
    held: DlLoc[]
    sites: int[]
    site: int        # the call

struct DlSummary:
    acqs: DlAcq[]
    acq_keys: {str: bool}
    edges: DlEdge[]
    edge_keys: {str: bool}
    callbacks: DlCallback[]
    cb_keys: {str: bool}

struct DlHeld:
    loc: DlLoc
    site: int
    guard: int       # the guard's local (released at its place's last use), 0 for none

dl_summaries: {int: DlSummary}
dl_relevant: {int: bool}
dl_changed = false
dl_report = false
dl_global_edges: DlEdge[]
dl_global_keys: {str: bool}
dl_param_index: {int: int}       # parameter local -> its index
dl_inits: {int: int}             # local -> its declaration (the relevant functions')
dl_groups: {int: int[]}          # a task group's local -> the functions spawned into it
dl_fn = 0                        # the function being walked
dl_cur: DlSummary

dl_lib = () -> str: lib_dir + "/prelude/locks.dewy"

dl_key = (l: DlLoc) -> str: "{l.root}:{l.id}:{l.k}{l.route}"

dl_name = (l: DlLoc) -> str:
    base = "a lock"
    if l.root == 1: base = name_of(int(globals[l.id].name))
    else if l.root == 2: base = name_of(int(nodes[l.id].name))
    else if l.root == 4: base = name_of(int(locals[l.id].name))
    else if l.root == 3:
        d = int(fns[l.id].decl)
        if l.k < fns[l.id].params.len(): base = name_of(int(locals[fns[l.id].params[l.k]].name))
    if starts_with(base, "$"): base = "a lock"
    "'{base}{l.route}'"

dl_line = (p: int) -> str:
    l, c = line_col(p)
    "line {l}"

# ---------------- the program's call graph and the relevant functions ----------------

dl_callers: {int: int[]}
dl_givens: {int: int[]}          # function -> the function values its calls are given

dl_scan_calls = (f: int, n: int):
    if n == 0: return
    k = nodes[n].kind
    if (k == .call and nodes[n].aux == 0 or k == .lambda or k == .fnref) and nodes[n].sym > 0:
        g = int(nodes[n].sym)
        if g != f and g < fns.len():
            list = dl_callers.get(g) ?? []
            list.push(f)
            dl_callers[g] = list
        # (a function given a function value: what it calls back is part of what it takes)
        if k == .call:
            loop a in kids(n):
                if is_fn_type(ntype(a)):
                    list = dl_givens.get(g) ?? []
                    list.push(a)
                    dl_givens[g] = list
    if k == .vardecl and nodes[n].sym > 0 and nkids(n) == 0 and not has_flag(n, NF_GLOBAL): dl_inits[int(nodes[n].sym)] = n
    # (the certified protocols' own channel waits are the library's, not the program's)
    if dc_mod >= 0 and k == .call and nodes[n].aux == 0 and nodes[n].sym > 0 and int(fns[f].mod) != dc_mod and int(fns[f].mod) != dc_protocols() and dc_chan_call(n) > 0: dc_fns[f] = true
    if k != .lambda and k != .fnref:
        loop g in value_helper_calls(n):
            list = dl_callers.get(g) ?? []
            list.push(f)
            dl_callers[g] = list
    if k == .lambda: return
    if k == .propagate or k == .parallel_region:
        dl_scan_calls(f, int(nodes[n].a))
        return
    mask = isolation_children(k)
    if mask < 0:
        dl_scan_calls(f, int(nodes[n].a))
        dl_scan_calls(f, int(nodes[n].b))
        dl_scan_calls(f, int(nodes[n].c))
        loop c in kids(n): dl_scan_calls(f, c)
        return
    if mask & 1 != 0: dl_scan_calls(f, int(nodes[n].a))
    if mask & 2 != 0: dl_scan_calls(f, int(nodes[n].b))
    if mask & 4 != 0: dl_scan_calls(f, int(nodes[n].c))
    if mask & 16 != 0:
        loop c in kids(n): dl_scan_calls(f, c)
    if mask & 32 != 0:
        loop c in kids2(n): dl_scan_calls(f, c)

# ---------------- locations ----------------

dl_unknown = () -> DlLoc: DlLoc(0, 0, 0, "", false)

dl_extend = (l: DlLoc, step: str, exact: bool) -> DlLoc: DlLoc(l.root, l.id, l.k, l.route + step, l.exact and exact)

# The location of a lock expression in function f.
dl_resolve = (e0: int, f: int, depth: int = 0) -> DlLoc:
    e = e0
    loop e != 0 and (nodes[e].kind == .conv or nodes[e].kind == .addr or nodes[e].kind == .narrow): e = int(nodes[e].a)
    if e == 0 or depth > 32: return dl_unknown()
    k = nodes[e].kind
    if k == .field: return dl_extend(dl_resolve(int(nodes[e].a), f, depth + 1), ".{name_of(int(nodes[e].name))}", true)
    if k == .index: return dl_extend(dl_resolve(int(nodes[e].a), f, depth + 1), "[]", false)
    if k != .ident: return dl_unknown()
    if nodes[e].aux == i32(int(SK.global)): return DlLoc(1, int(nodes[e].sym), 0, "", true)
    if nodes[e].aux != i32(int(SK.local)) or nodes[e].sym <= 0: return dl_unknown()
    dl_resolve_local(int(nodes[e].sym), f, depth)

dl_resolve_local = (l: int, f: int, depth: int) -> DlLoc:
    r = dl_resolve_local_once(l, f, depth)
    # (a variable given another handle after it was made or copied names either: perhaps one lock)
    if int(locals[l].flags) & LF_ASSIGNED != 0: r.exact = false
    r

dl_resolve_local_once = (l: int, f: int, depth: int) -> DlLoc:
    flags = int(locals[l].flags)
    if flags & LF_ALIAS != 0 and locals[l].alias > 0: return dl_resolve(int(locals[l].alias), f, depth + 1)
    if flags & LF_CAPTURE != 0:
        if locals[l].outer <= 0: return dl_unknown()
        return dl_resolve_local(int(locals[l].outer), int(locals[int(locals[l].outer)].owner), depth + 1)
    if let i = dl_param_index.get(l): return DlLoc(3, int(locals[l].owner), i, "", true)
    if let d = dl_inits.get(l):
        init = int(nodes[d].b)
        loop init != 0 and nodes[init].kind == .conv: init = int(nodes[init].a)
        # (a copy of another handle, or a value parameter's binding: the same lock)
        if init != 0 and (nodes[init].kind == .ident or nodes[init].kind == .field or nodes[init].kind == .index):
            return dl_resolve(init, f, depth + 1)
        # (under `$no_deadlocks`, a handle a call gives back may be one made elsewhere: unnamed)
        if dir_deadlocks_any and init != 0 and nodes[init].kind == .call and not dl_makes_handle(init): return dl_unknown()
        return DlLoc(2, d, 0, "", true)
    # (a local whose making is not in view: itself)
    DlLoc(4, l, 0, "", true)

# Whether a call makes a new lock, channel or atomic (and not one made elsewhere): its prelude
# constructor
dl_makes_handle = (n: int) -> bool:
    if nodes[n].aux != 0 or nodes[n].sym <= 0: return false
    d = int(fns[int(nodes[n].sym)].decl)
    if d == 0: return false
    nm = name_of(int(nodes[d].name))
    path = files[pos_file(nodes[d].pos)].path
    nm == "mutex" and path == dl_lib() or nm == "channel" and ends_with(path, "/prelude/channels.dewy") or nm == "atomic" and path == lib_dir + "/std/thread.jo"

# Whether `$no_deadlocks` can place a lock in the checked order: one named by a local or a parameter
# (a handle made by `mutex(...)` where it is declared, or a copy of one), or a global made so.
# Fields and elements are not: two of them, or one and a local, may hold copies of one handle.
dl_named = (l: DlLoc) -> bool:
    if not l.exact or len(l.route) > 0: return false
    if l.root == 2 or l.root == 3: return true
    if l.root != 1: return false
    d = int(globals[l.id].decl)
    init = if d != 0: int(nodes[d].b) else: 0
    loop init != 0 and nodes[init].kind == .conv: init = int(nodes[init].a)
    init != 0 and nodes[init].kind == .call and dl_makes_handle(init)

# The same lock for certain, or perhaps (one array's elements)
dl_must = (a: DlLoc, b: DlLoc) -> bool: a.exact and b.exact and a.root != 0 and dl_key(a) == dl_key(b)
dl_may = (a: DlLoc, b: DlLoc) -> bool: a.root != 0 and dl_key(a) == dl_key(b)

dl_symbolic = (l: DlLoc) -> bool: l.root == 3

# A callee's location seen from the call n in function f
dl_subst = (l: DlLoc, g: int, n: int, f: int) -> DlLoc:
    if l.root != 3 or l.id != g: return l
    if n == 0 or l.k >= nkids(n): return dl_unknown()
    a = kid(n, l.k)
    if nodes[a].kind == .namedarg: a = int(nodes[a].a)
    base = dl_resolve(a, f)
    if base.root == 0: return base
    DlLoc(base.root, base.id, base.k, base.route + l.route, base.exact and l.exact)

# ---------------- summaries ----------------

dl_add_acq = (a: DlAcq):
    mode = if a.wait: "w" else: "h"
    key = dl_key(a.loc) + mode
    if dl_cur.acq_keys.has(key): return
    dl_cur.acq_keys[key] = true
    dl_cur.acqs.push(a)
    dl_changed = true

dl_add_edge = (e: DlEdge):
    if dl_symbolic(e.held) or dl_symbolic(e.taken):
        key = "{dl_key(e.held)}>{dl_key(e.taken)}"
        if dl_cur.edge_keys.has(key): return
        dl_cur.edge_keys[key] = true
        dl_cur.edges.push(e)
        dl_changed = true
        return
    if not dl_report or e.held.root == 0 or e.taken.root == 0: return
    key = "{dl_key(e.held)}>{dl_key(e.taken)}"
    if dl_global_keys.has(key): return
    dl_global_keys[key] = true
    dl_global_edges.push(e)

# What the analysis cannot decide: a warning, but an error where `$no_deadlocks` holds at the site
# or at another of the wait's sites (its certificate is missing).
dl_undecided = (site: int, msg: str, other: int[] = []):
    hit = dir_no_deadlocks(site)
    loop o in other:
        if dir_no_deadlocks(o): hit = true
    if hit: fatal(site, "{msg}. Under `$no_deadlocks` an undecided wait is an error: no certificate covers it")
    warn(site, msg)

# A wait for loc at site while holding held: the self-deadlock check and the order edges.
dl_wait = (held: DlHeld[], loc: DlLoc, site: int, via: str, report_site: int):
    loop h in held:
        if dl_report and dl_must(h.loc, loc):
            how = if len(via) > 0: " ({via}, takes it at {dl_line(site)})" else: ""
            fatal(report_site, "this waits for {dl_name(loc)}, which this task already holds since {dl_line(h.site)}{how}: it would wait forever. Use the place already held, or let it end before taking the lock again")
        if dl_report and dl_may(h.loc, loc) and not dl_must(h.loc, loc):
            dl_undecided(report_site, "this may wait for {dl_name(loc)} while holding another of the same ({dl_line(h.site)}): two tasks taking them in opposite orders would wait forever. Take them together, in one order: `let [a b] = @(lock_all(x y)) or_throw`", [h.site, site])
            continue
        dl_add_edge(DlEdge(h.loc, loc, h.site, site, via, report_site))
    # (a lock the analysis cannot name has no place in the checked order)
    if dl_report and dir_deadlocks_any and held.len() > 0 and (dir_no_deadlocks(report_site) or dir_no_deadlocks(site)):
        loop h in held:
            if dl_named(loc) and dl_named(h.loc): continue
            how = if len(via) > 0: " ({via}, takes it at {dl_line(site)})" else: ""
            fatal(report_site, "this waits for {dl_name(loc)}{how} while holding {dl_name(h.loc)} (since {dl_line(h.site)}), and the compiler cannot name one of them, so no checked lock order covers the wait (`$no_deadlocks`): take them together with `lock_all`, or nest only locks named by a local or a parameter holding a handle `mutex(...)` made (a field, an element or a handle a call gives back may be a copy of another)")

dl_drop = (held: mut DlHeld[], mark: int):
    loop held.len() > mark: held.pop()

dl_summary = (f: int) -> DlSummary:
    if let s = dl_summaries.get(f): return s
    DlSummary([], {}, [], {}, [], {})

# The lock method a call n reaches: "lock", "try_lock$acquire", "__take", "__lock_all", a
# release ("...$release"), or "".
dl_lock_call = (n: int) -> str:
    if nodes[n].kind != .call or nodes[n].aux != 0 or nodes[n].sym <= 0: return ""
    d = int(fns[int(nodes[n].sym)].decl)
    if d == 0 or files[pos_file(nodes[d].pos)].path != dl_lib(): return ""
    nm = name_of(int(nodes[d].name))
    if nm == "lock" or nm == "try_lock$acquire" or nm == "__take" or nm == "__lock_all" or ends_with(nm, "$release"): return nm
    ""

# The receiver of a method call
dl_receiver = (n: int) -> int: if nkids(n) > 0: kid(n, 0) else: 0

# ---------------- the walk ----------------

dl_walk_fn = (f: int):
    dl_fn = f
    dl_cur = dl_summary(f)
    held: DlHeld[]
    dl_groups = {}
    dl_walk(int(fns[f].body), held)
    dl_summaries[f] = dl_cur

dl_walk = (n: int, held: mut DlHeld[]):
    if n == 0: return
    k = nodes[n].kind
    if k == .lambda or k == .fnref: return
    if k == .block:
        mark = held.len()
        loop c in kids(n): dl_walk(c, held)
        if nodes[n].aux != 5: dl_drop(held, mark)
        return
    if k == .vardecl:
        init = int(nodes[n].b)
        loop init != 0 and nodes[init].kind == .conv: init = int(nodes[init].a)
        if init != 0 and nodes[init].kind == .call:
            what = dl_lock_call(init)
            if what == "lock" or what == "try_lock$acquire" or what == "__take":
                loc = dl_resolve(dl_receiver(init), dl_fn)
                if what == "lock":
                    dl_wait(held, loc, nodes[init].pos, "", nodes[init].pos)
                    dl_add_acq(DlAcq(loc, nodes[init].pos, true, ""))
                else: dl_add_acq(DlAcq(loc, nodes[init].pos, false, ""))
                held.push(DlHeld(loc, nodes[init].pos, int(nodes[n].sym)))
                return
            # (a task group: what is spawned into it is joined at its end)
        dl_walk(int(nodes[n].b), held)
        return
    if k == .if_ or k == .iflet:
        dl_walk(int(nodes[n].a), held)
        mark = held.len()
        dl_walk(int(nodes[n].b), held)
        dl_drop(held, mark)
        dl_walk(int(nodes[n].c), held)
        dl_drop(held, mark)
        return
    if k == .call: dl_call(n, held)
    else if k == .propagate or k == .parallel_region:
        dl_walk(int(nodes[n].a), held)
        return
    loop g in value_helper_calls(n): dl_callee(g, 0, held, nodes[n].pos)
    if k == .call: return
    mask = isolation_children(k)
    if mask < 0:
        dl_walk(int(nodes[n].a), held)
        dl_walk(int(nodes[n].b), held)
        dl_walk(int(nodes[n].c), held)
        loop c in kids(n): dl_walk(c, held)
        return
    if mask & 1 != 0: dl_walk(int(nodes[n].a), held)
    if mask & 2 != 0: dl_walk(int(nodes[n].b), held)
    if mask & 4 != 0: dl_walk(int(nodes[n].c), held)
    if mask & 16 != 0:
        mark = held.len()
        loop c in kids(n):
            dl_walk(c, held)
            if k == .match_ or k == .arm: dl_drop(held, mark)
    if mask & 32 != 0:
        loop c in kids2(n): dl_walk(c, held)

# The parameter a local is, or is bound from (Dewy binds value parameters to locals), or -1
dl_param_of = (l0: int) -> int:
    l = l0
    loop depth in [0..8):
        if let i = dl_param_index.get(l): return i
        d = dl_inits.get(l) ?? 0
        if d == 0: return -1
        init = int(nodes[d].b)
        loop init != 0 and nodes[init].kind == .conv: init = int(nodes[init].a)
        if init == 0 or nodes[init].kind != .ident or nodes[init].aux != i32(int(SK.local)): return -1
        l = int(nodes[init].sym)
    -1

# The function a callable argument names, or 0
dl_fn_arg = (a0: int, depth: int = 0) -> int:
    a = a0
    loop nodes[a].kind == .conv or nodes[a].kind == .namedarg: a = int(nodes[a].a)
    if (nodes[a].kind == .lambda or nodes[a].kind == .fnref or nodes[a].kind == .partial) and nodes[a].sym > 0: return int(nodes[a].sym)
    # (a local holding a function literal, or a copy of one)
    if nodes[a].kind == .ident and nodes[a].aux == i32(int(SK.local)) and nodes[a].sym > 0 and depth < 8:
        l = int(nodes[a].sym)
        if int(locals[l].flags) & LF_CAPTURE != 0 and locals[l].outer > 0: l = int(locals[l].outer)
        if let d = dl_inits.get(l): return dl_fn_arg(int(nodes[d].b), depth + 1)
    0

dl_call = (n: int, held: mut DlHeld[]):
    what = dl_lock_call(n)
    pos = nodes[n].pos
    if what == "__lock_all":
        # (lock_all: every lock at once, after the receivers' words are read)
        words = kid(n, 1)
        if nodes[words].kind == .namedarg: words = int(nodes[words].a)
        loop c in kids(words):
            call = c
            loop nodes[call].kind == .conv: call = int(nodes[call].a)
            if nodes[call].kind != .call: continue
            loc = dl_resolve(dl_receiver(call), dl_fn)
            dl_wait(held, loc, pos, "", pos)
            dl_add_acq(DlAcq(loc, pos, true, ""))
        return
    if ends_with(what, "$release"):
        if nkids(n) >= 2:
            g = kid(n, 1)
            if nodes[g].kind == .ident and nodes[g].sym > 0:
                loop i in [0..held.len()):
                    if held[i].guard == int(nodes[g].sym):
                        held.remove(i)
                        break
        return
    if len(what) > 0: return
    loop c in kids(n): dl_walk(c, held)
    if nodes[n].aux == 1 or nodes[n].aux == 4:
        dl_walk(int(nodes[n].a), held)
        # (a function value called while holding a lock: what it takes is known at the calls
        # that give it, for a parameter; otherwise undecided)
        callee = int(nodes[n].a)
        if nodes[callee].kind == .ident and nodes[callee].aux == i32(int(SK.local)):
            i = dl_param_of(int(nodes[callee].sym))
            if i >= 0:
                locs: DlLoc[]
                sites: int[]
                loop h in held:
                    locs.push(h.loc)
                    sites.push(h.site)
                key = "{i}:{pos}"
                if not dl_cur.cb_keys.has(key):
                    dl_cur.cb_keys[key] = true
                    dl_cur.callbacks.push(DlCallback(i, locs, sites, pos))
                    dl_changed = true
                return
        if held.len() > 0 and dl_report: dl_undecided(pos, "this calls a function value while holding {dl_name(held[held.len() - 1].loc)} (since {dl_line(held[held.len() - 1].site)}): if it takes that lock, it waits forever. Call it after the place's last use, or pass a function the compiler can see")
        return
    if nodes[n].aux != 0 or nodes[n].sym <= 0: return
    g = int(nodes[n].sym)
    d = int(fns[g].decl)
    gname = if d != 0: name_of(int(nodes[d].name)) else: ""
    # Task groups: spawned work runs beside the spawner, joined at the group's end.
    if gname == "__task_spawn" and nkids(n) == 2:
        h = dl_fn_arg(kid(n, 1))
        grp = kid(n, 0)
        if h > 0 and nodes[grp].kind == .ident and nodes[grp].sym > 0:
            list = dl_groups.get(int(nodes[grp].sym)) ?? []
            list.push(h)
            dl_groups[int(nodes[grp].sym)] = list
        if h > 0: dl_spawned(h)
        return
    # (the join waits for what its tasks take: the caller of this function holding a lock they
    # take waits forever too)
    if gname == "__task_join" and nkids(n) == 1:
        grp = kid(n, 0)
        if nodes[grp].kind == .ident and nodes[grp].sym > 0:
            loop h in dl_groups.get(int(nodes[grp].sym)) ?? []:
                if held.len() > 0: dl_join(h, held, pos, "its tasks")
                dl_callee(h, 0, held, pos, "a task joined at {dl_line(pos)}")
        return
    # Parallel work: its iterations run while the caller waits for them all.
    if fns[g].parallel_api:
        deadlock_parallel = true
        loop c in kids(n):
            h = dl_fn_arg(c)
            if h <= 0: continue
            if held.len() > 0: dl_join(h, held, pos, "its parallel iterations")
            dl_callee(h, 0, held, pos, "the parallel iterations at {dl_line(pos)}")
        return
    dl_callee(g, n, held, pos)
    # (callbacks the callee calls, possibly under its locks: what they take, here)
    s = dl_summary(g)
    loop cb in s.callbacks:
        if cb.param >= nkids(n): continue
        h = dl_fn_arg(kid(n, cb.param))
        if h <= 0: continue
        inner: DlHeld[]
        loop i in [0..cb.held.len()): inner.push(DlHeld(dl_subst(cb.held[i], g, n, dl_fn), cb.sites[i], 0))
        loop h2 in held: inner.push(h2)
        dl_callee(h, 0, inner, pos, "the function given to {effect_name(g)}, called back at {dl_line(cb.site)}")

# How a call reads in a diagnostic's chain: the library's helpers are "the library", and lines
# are given only in the program's own files.
dl_callee_name = (g: int, n: int, pos: int, named: str) -> str:
    if len(named) > 0: return named
    d = int(fns[g].decl)
    nm = effect_name(g)
    if d != 0 and pos_in_lib(nodes[d].pos) and starts_with(nm, "__"): nm = "the library"
    if n != 0 and not pos_in_lib(pos): return "{nm} at {dl_line(pos)}"
    nm

# A call of g (n: the call, for its arguments; 0 for a hidden call) while holding held.
dl_callee = (g: int, n: int, held: mut DlHeld[], pos: int, named: str = ""):
    if not dl_relevant.has(g): return
    s = dl_summary(g)
    gname = dl_callee_name(g, n, pos, named)
    loop a in s.acqs:
        loc = dl_subst(a.loc, g, n, dl_fn)
        via = if len(a.via) > 0: "{gname} -> {a.via}" else: gname
        if a.wait: dl_wait(held, loc, a.site, via, pos)
        dl_add_acq(DlAcq(loc, a.site, a.wait, via))
    loop e in s.edges:
        dl_add_edge(DlEdge(dl_subst(e.held, g, n, dl_fn), dl_subst(e.taken, g, n, dl_fn), e.held_site, e.taken_site, (if len(e.via) > 0: "{gname} -> {e.via}" else: gname), pos))

# Work run beside the caller (a spawned task, parallel iterations): its own order edges count,
# in the caller's terms; what it takes does not wait while the caller holds anything.
dl_spawned = (h: int):
    if not dl_relevant.has(h): return
    s = dl_summary(h)
    loop e in s.edges: dl_add_edge(e)

# Holding a lock across a join of work that takes it.
dl_join = (h: int, held: DlHeld[], pos: int, what: str):
    if not dl_relevant.has(h) or not dl_report: return
    s = dl_summary(h)
    loop a in s.acqs:
        if not a.wait: continue
        loop hd in held:
            if dl_must(hd.loc, a.loc):
                fatal(pos, "this holds {dl_name(hd.loc)} (since {dl_line(hd.site)}) while waiting for {what}, which take it ({dl_line(a.site)}): neither can go on. Let the place end before the join, or take the lock inside the work only")
            if dl_may(hd.loc, a.loc):
                dl_undecided(pos, "this holds {dl_name(hd.loc)} (since {dl_line(hd.site)}) while waiting for {what}, which may take the same lock ({dl_line(a.site)})", [hd.site])

# ---------------- parallel iterations waiting on siblings ----------------

# A loop polling an atomic in a parallel body (`loop flag.load() =? 0 {}`): an error when
# another part of the same body sets that atomic (a sibling iteration must run first, and the
# runtime may run iterations one after another), a warning when it is set elsewhere.
dl_polling = (h: int):
    body = int(fns[h].body)
    loops: int[]
    dl_find_loops(body, loops)
    loop lp in loops:
        cond = int(nodes[lp].a)
        polled: DlLoc[]
        dl_atomic_reads(cond, h, polled)

        if polled.len() == 0: continue
        loop p in polled:
            if dl_atomic_written(int(nodes[lp].b), h, p): continue
            if dl_atomic_written(body, h, p):
                fatal(nodes[lp].pos, "this parallel iteration waits for {dl_name(p)}, which a sibling iteration sets: iterations may run one after another on one thread, so it may wait forever. Use `concurrent` and `spawn` for work that waits on other work")
            dl_undecided(nodes[lp].pos, "this parallel iteration polls {dl_name(p)}: iterations may run one after another on one thread, so it waits for whatever sets it")

dl_find_loops = (n: int, out: mut int[]):
    if n == 0 or nodes[n].kind == .lambda: return
    if nodes[n].kind == .while_: out.push(n)
    loop c in [int(nodes[n].a), int(nodes[n].b), int(nodes[n].c)]: dl_find_loops(c, out)
    loop c in kids(n): dl_find_loops(c, out)

dl_atomic_name = (n: int, names: str[]) -> bool:
    if nodes[n].kind != .call or nodes[n].aux != 0 or nodes[n].sym <= 0 or nkids(n) == 0: return false
    d = int(fns[int(nodes[n].sym)].decl)
    if d == 0 or not concurrency_builtin_type(ntype(kid(n, 0)), "Atomic"): return false
    names.contains(name_of(int(nodes[d].name)))

dl_atomic_reads = (n: int, f: int, out: mut DlLoc[]):
    if n == 0 or nodes[n].kind == .lambda: return

    if dl_atomic_name(n, ["load", "get"]):
        loc = dl_resolve(kid(n, 0), f)
        if loc.root != 0: out.push(loc)
    loop c in [int(nodes[n].a), int(nodes[n].b), int(nodes[n].c)]: dl_atomic_reads(c, f, out)
    loop c in kids(n): dl_atomic_reads(c, f, out)

dl_atomic_written = (n: int, f: int, loc: DlLoc) -> bool:
    if n == 0 or nodes[n].kind == .lambda: return false
    if dl_atomic_name(n, ["store", "set", "add", "compare_swap", "set_max"]) and dl_may(dl_resolve(kid(n, 0), f), loc): return true
    loop c in [int(nodes[n].a), int(nodes[n].b), int(nodes[n].c)]:
        if dl_atomic_written(c, f, loc): return true
    loop c in kids(n):
        if dl_atomic_written(c, f, loc): return true
    false

# ---------------- order cycles ----------------

dl_cycles = ():
    if dl_global_edges.len() == 0: return
    ids: {str: int} = {}
    names_: str[]
    adj: int[][]
    out_edges: int[][]
    loop i in [0..dl_global_edges.len()):
        e = dl_global_edges[i]
        loop key in [dl_key(e.held), dl_key(e.taken)]:
            if not ids.has(key):
                ids[key] = names_.len()
                names_.push(key)
                adj.push([])
                out_edges.push([])
        a = ids[dl_key(e.held)]
        adj[a].push(ids[dl_key(e.taken)])
        out_edges[a].push(i)
    # (the first edge whose target reaches its source: a breadth-first search back, O(V + E) each,
    # stopping at the first cycle found, which is reported)
    loop i in [0..dl_global_edges.len()):
        e = dl_global_edges[i]
        a = ids[dl_key(e.held)]
        b = ids[dl_key(e.taken)]
        if a == b: continue
        prev = fill(-1, names_.len())
        prev[b] = i
        queue = [b]
        q = 0
        found = false
        loop q < queue.len() and not found:
            v = queue[q]
            q += 1
            loop j in out_edges[v]:
                w = ids[dl_key(dl_global_edges[j].taken)]
                if prev[w] >= 0: continue
                prev[w] = j
                if w == a:
                    found = true
                    break
                queue.push(w)
        if not found: continue
        # the path back from b to a
        back: int[]
        v = a
        loop v != b:
            j = prev[v]
            back.insert(0, j)
            v = ids[dl_key(dl_global_edges[j].held)]
        dl_report_cycle(e, back)
        return

dl_path = (e: DlEdge) -> str:
    who = if len(e.via) > 0: " (in {e.via})" else: ""
    "takes {dl_name(e.held)} ({dl_line(e.held_site)}) and then {dl_name(e.taken)} ({dl_line(e.taken_site)}){who}"

dl_report_cycle = (e: DlEdge, back: int[]):
    msg = "lock order cycle: one path {dl_path(e)}"
    loop j in back: msg += "; another {dl_path(dl_global_edges[j])}"
    msg += ". Two tasks on these paths can each hold one lock and wait forever for the other. Take the locks together, in one order: `let [a b] = @(lock_all(x y)) or_throw`"
    if concurrency_tasks.len() == 0 and not deadlock_parallel:
        # (under `$no_deadlocks` the order itself is the certificate, tasks or not)
        sites = [e.held_site, e.at]
        loop j in back:
            sites.push(dl_global_edges[j].held_site)
            sites.push(dl_global_edges[j].taken_site)
            sites.push(dl_global_edges[j].at)
        dl_undecided(e.taken_site, msg + " (no task runs them at once yet)", sites)
        return
    loop j in back: err_notes.push((dl_global_edges[j].taken_site, "note: the other path takes {dl_name(dl_global_edges[j].taken)} here"))
    fatal(e.taken_site, msg)

# ---------------- the driver ----------------

deadlock_finalize = ():
    # (parallel iterations polling an atomic: only the parallel bodies of a program using atomics)
    if deadlock_atomics:
        dl_report = true
        loop n in concurrency_calls:
            if in_lib(nodes[n].pos): continue
            loop a in kids(n):
                h = dl_fn_arg(a)
                if h > 0 and fns[h].body != 0: dl_polling(h)
        dl_report = false
    # (channels: only once their prelude is loaded; the scan finds the functions calling them)
    dc_mod = dc_module()
    if dc_mod >= 0 and not dc_called(): dc_mod = -1
    # (`$no_deadlocks` asks for a certificate of every wait: joins, foreign calls and protocols too)
    certify = dir_deadlocks_any
    pc_mod = pc_module()
    if deadlock_fns.len() == 0 and dc_mod < 0 and not certify: return
    # (the call graph, the owners of locals and the parameters' indexes: one scan)
    loop f in [1..fns.len()):
        if fns[f].state != 2 or fns[f].body == 0: continue
        loop i in [0..fns[f].params.len()): dl_param_index[fns[f].params[i]] = i
        dl_scan_calls(f, int(fns[f].body))
    # (Dewy's value parameters are bound to locals that lead the body: the binding is the
    # parameter)
    if deadlock_fns.len() == 0 and dc_fns.len() == 0 and not certify: return
    work: int[]
    loop f, on in deadlock_fns:
        if not dl_relevant.has(f):
            dl_relevant[f] = true
            work.push(f)
    loop f, on in dc_fns:
        if not dl_relevant.has(f):
            dl_relevant[f] = true
            work.push(f)
    # (callers of a function taking locks, and functions given one as a value; indexed by
    # what they are given, each looked at once)
    given_to: {int: int[]} = {}
    loop g, values in dl_givens:
        loop a in values:
            h = dl_fn_arg(a)
            if h > 0:
                list = given_to.get(h) ?? []
                list.push(g)
                given_to[h] = list
    i = 0
    loop i < work.len():
        f = work[i]
        i += 1
        loop c in (dl_callers.get(f) ?? []) + (given_to.get(f) ?? []):
            if not dl_relevant.has(c):
                dl_relevant[c] = true
                work.push(c)
    if deadlock_fns.len() > 0:
        passes = 0
        dl_changed = true
        loop dl_changed and passes < DL_PASSES:
            dl_changed = false
            passes += 1
            # (callees before callers: the closure's order)
            loop f in work: dl_walk_fn(f)
        dl_report = true
        loop f in work: dl_walk_fn(f)
        dl_cycles()
    if certify: nd_check()
    if dc_fns.len() > 0: dc_analyze()


# ---------------- channel waits ----------------
# A bounded channel's send waits while it is full and its receive while it is empty, so a task
# waiting on a channel waits for another task's receive or send (or close). Each task (the
# program's thread, and every task spawned, walked from where it is spawned with the calls it
# makes inlined, so a channel handle given down calls or captured is the declaration that made
# it) is read as its waits in order: sends, receives, closes, lock waits and joins, each with
# the loops around it (their iteration counts when literal) and the locks held.
#
# Who holds what a wait needs:
#   - room in channel c: its only drainer (the one spawn site that receives from or closes it)
#     until its first receive; whatever it waits for before that keeps c full;
#   - a value in c: its only filler (sends or closes it) until its first send;
#   - a lock: its holder; a join: every task of the group, until it ends.
# An edge "holding X, waits for Y" comes from each wait before the point a holder gives X up,
# and from each wait while holding a lock. A send waits for certain when the values sent into
# its channel by then (loops counted, the first iteration only for a loop around both) are more
# than the capacity; when the counts or the capacity are not literal it may wait (undecided); when
# they fit, it does not wait. A receive waits (for a filler held up) at the task's first receive
# from that channel. A cycle through a channel or a join among certain edges is an error (a
# demonstrated deadlock); one needing an undecided edge is a warning. Together with the lock
# order edges of stage 1 (a lock held across a channel wait the other side needs).
#
# Demand and cost: nothing runs unless the channels prelude is loaded and a checked function
# calls it. The walk inlines the relevant functions only (the upward closure above), at most
# DC_DEPTH deep and DC_EVENTS waits; a walk cut short, a function value called, or a channel the
# walk cannot name (in a container, given through a field) makes every edge undecided. The edges
# are O(W^2) in a task's W waits; the cycle search is a breadth-first search per channel node,
# O(V(V + E)).

struct DcEvent:
    kind: int        # 1 send, 2 receive, 3 close, 4 lock wait, 5 join
    loc: DlLoc       # the channel, lock or task group
    loops: int[]     # the loops around it, outermost first (indexes into dc_trips)
    branch: bool     # under a condition
    held: DlLoc[]    # the locks held
    held_sites: int[]
    site: int

struct DcActor:
    events: DcEvent[]
    name: str
    multi: bool      # spawned in a loop: several may run at once
    group: str       # the key of the group that joins it ("" for the program's thread)
    ret: int         # its result type (a failure cancels its group), 0 for the program's thread

struct DcSpawn:
    h: int
    ffns: int[]
    fcalls: int[]
    multi: bool
    group: str
    site: int

struct DcEdge:
    src: str
    dst: str
    certain: bool
    text: str
    site: int

const DC_EVENTS = 20000
const DC_DEPTH = 16
const DC_ACTORS = 256

dc_actors: DcActor[]
dc_trips: int[]                  # loop -> its iterations, -1 when not literal
dc_complete = true               # every walk saw every wait it reached
dc_precise = true                # every channel named by the declaration that made it
dc_count = 0
dc_closes = false                # some task closes a channel
dc_cancels = false               # some task cancels a group by hand
# (the walk of one task)
dc_ev: DcEvent[]
dc_ffns: int[]                   # the functions entered, outermost first
dc_fcalls: int[]                 # the calls entering them (0 for a task's body)
dc_loops: int[]
dc_branch = 0
dc_multi = false
dc_held: DlHeld[]
dc_pending: DcSpawn[]
dc_edges: DcEdge[]
dc_edge_at: {str: int}

# The channels prelude's module, if a program loaded it (by its path among the prelude's files)
dc_module = () -> int:
    loop i in [0..dp_paths.len()):
        if ends_with(dp_paths[i], "/prelude/channels.dewy"): return dp_mods[i]
    -1

# The certified protocols' module (lib/prelude/protocols.dewy), if a program loaded it
pc_module = () -> int:
    loop i in [0..dp_paths.len()):
        if ends_with(dp_paths[i], "/prelude/protocols.dewy"): return dp_mods[i]
    -1

dc_protocols = () -> int:
    if pc_mod == -2: pc_mod = pc_module()
    pc_mod

# Whether the checker reached a channel operation (a program can load the prelude for a name it
# uses otherwise, as a module of its own called `channel`): O(functions)
dc_called = () -> bool:
    loop f in [1..fns.len()):
        if int(fns[f].mod) != dc_mod or fns[f].state != 2 or fns[f].decl == 0: continue
        nm = name_of(int(nodes[int(fns[f].decl)].name))
        if nm == "send" or nm == "receive" or nm == "close": return true
    false

# The channel operation a call is: 1 send, 2 receive, 3 close, 0 none
dc_chan_call = (n: int) -> int:
    if dc_mod < 0 or nodes[n].kind != .call or nodes[n].aux != 0 or nodes[n].sym <= 0: return 0
    g = int(nodes[n].sym)
    if int(fns[g].mod) != dc_mod or nkids(n) == 0: return 0
    d = int(fns[g].decl)
    if d == 0: return 0
    nm = name_of(int(nodes[d].name))
    if nm == "send": return 1
    if nm == "receive": return 2
    if nm == "close": return 3
    0

# A location in the function on top of the walk, with its parameters replaced by the arguments
# of the calls that entered it
dc_loc = (e: int) -> DlLoc: dc_concrete(dl_resolve(e, dc_ffns[dc_ffns.len() - 1]), dc_ffns.len() - 1)

dc_concrete = (l: DlLoc, at: int) -> DlLoc:
    if l.root != 3: return l
    i = at
    loop i >= 0 and dc_ffns[i] != l.id: i -= 1
    if i <= 0 or dc_fcalls[i] == 0: return dl_unknown()
    n = dc_fcalls[i]
    if l.k >= nkids(n): return dl_unknown()
    a = kid(n, l.k)
    if nodes[a].kind == .namedarg: a = int(nodes[a].a)
    base = dc_concrete(dl_resolve(a, dc_ffns[i - 1]), i - 1)
    if base.root == 0: return base
    DlLoc(base.root, base.id, base.k, base.route + l.route, base.exact and l.exact)

dc_event = (kind: int, loc: DlLoc, site: int):
    dc_count += 1
    if dc_count > DC_EVENTS:
        dc_complete = false
        return
    loops: int[]
    loop x in dc_loops: loops.push(x)
    locs: DlLoc[]
    sites: int[]
    loop h in dc_held:
        locs.push(h.loc)
        sites.push(h.site)
    dc_ev.push(DcEvent(kind, loc, loops, dc_branch > 0, locs, sites, site))

# An integer literal (through conversions), or none
dc_const = (e0: int) -> int?:
    e = e0
    loop e != 0 and nodes[e].kind == .conv: e = int(nodes[e].a)
    if e == 0 or nodes[e].kind != .int_lit or has_flag(e, NF_U64): return none
    nodes[e].ival

# How many times a loop's body runs: literal range bounds, else -1
dc_trip_count = (n: int) -> int:
    if nodes[n].kind != .for_: return -1
    r = int(nodes[n].a)
    if r == 0 or nodes[r].kind != .range or has_flag(r, NF_STEP) or has_flag(r, NF_EXCL_FIRST): return -1
    lo = dc_const(int(nodes[r].a))
    hi = dc_const(int(nodes[r].b))
    if lo == none or hi == none: return -1
    count = hi! - lo! + (if has_flag(r, NF_INCLUSIVE): 1 else: 0)
    if count < 0: return 0
    count

# Whether a task's result may be a failure (an exception other than Canceled, which only follows
# a cancellation, and Closed, which only follows a close: those are drainers and fillers): the
# group's first failure cancels the rest, so a wait in it may end
dc_may_fail = (t: int) -> bool:
    loop m in value_members(t):
        if not exception_member(m) or m == T_NONE: continue
        if tkind(m) == .struct_:
            d = int(structs[int(types[m].st)].decl)
            nm = if d != 0: name_of(int(nodes[d].name)) else: ""
            if nm == "Canceled" or nm == "Closed" and not dc_closes: continue
        return true
    false

dc_drop = (mark: int):
    loop dc_held.len() > mark: dc_held.pop()

dc_walk = (n: int):
    if n == 0 or dc_count > DC_EVENTS: return
    k = nodes[n].kind
    if k == .lambda or k == .fnref: return
    if k == .block:
        mark = dc_held.len()
        loop c in kids(n): dc_walk(c)
        if nodes[n].aux != 5: dc_drop(mark)
        return
    if k == .vardecl:
        init = int(nodes[n].b)
        loop init != 0 and nodes[init].kind == .conv: init = int(nodes[init].a)
        if init != 0 and nodes[init].kind == .call:
            what = dl_lock_call(init)
            if what == "lock" or what == "try_lock$acquire" or what == "__take":
                loc = dc_loc(dl_receiver(init))
                if what == "lock": dc_event(4, loc, nodes[init].pos)
                dc_held.push(DlHeld(loc, nodes[init].pos, int(nodes[n].sym)))
                return
        dc_walk(int(nodes[n].b))
        return
    if k == .if_ or k == .iflet:
        dc_walk(int(nodes[n].a))
        mark = dc_held.len()
        dc_branch += 1
        dc_walk(int(nodes[n].b))
        dc_drop(mark)
        dc_walk(int(nodes[n].c))
        dc_drop(mark)
        dc_branch -= 1
        return
    if k == .for_ or k == .while_:
        trips = dc_trip_count(n)
        if k == .for_: dc_walk(int(nodes[n].a))
        cond = int(nodes[n].a)
        # (a body that may not run: a loop on a condition, or an empty range)
        maybe = trips == 0 or trips < 0 and not (k == .while_ and nodes[cond].kind == .bool_lit and nodes[cond].ival == 1)
        dc_loops.push(dc_trips.len())
        dc_trips.push(trips)
        if maybe: dc_branch += 1
        if k == .while_: dc_walk(cond)
        mark = dc_held.len()
        dc_walk(int(nodes[n].b))
        dc_drop(mark)
        if maybe: dc_branch -= 1
        dc_loops.pop()
        return
    if k == .call:
        dc_call(n)
        return
    if k == .propagate or k == .parallel_region:
        dc_walk(int(nodes[n].a))
        return
    loop g in value_helper_calls(n): dc_enter(g, 0)
    branches = k == .match_ or k == .arm
    if branches: dc_branch += 1
    mask = isolation_children(k)
    if mask < 0:
        dc_walk(int(nodes[n].a))
        dc_walk(int(nodes[n].b))
        dc_walk(int(nodes[n].c))
        loop c in kids(n): dc_walk(c)
    else:
        if mask & 1 != 0: dc_walk(int(nodes[n].a))
        if mask & 2 != 0: dc_walk(int(nodes[n].b))
        if mask & 4 != 0: dc_walk(int(nodes[n].c))
        if mask & 16 != 0:
            mark = dc_held.len()
            loop c in kids(n):
                dc_walk(c)
                if branches: dc_drop(mark)
        if mask & 32 != 0:
            loop c in kids2(n): dc_walk(c)
    if branches: dc_branch -= 1

dc_call = (n: int):
    pos = nodes[n].pos
    what = dl_lock_call(n)
    if what == "__lock_all":
        words = kid(n, 1)
        if nodes[words].kind == .namedarg: words = int(nodes[words].a)
        loop c in kids(words):
            call = c
            loop nodes[call].kind == .conv: call = int(nodes[call].a)
            if nodes[call].kind == .call: dc_event(4, dc_loc(dl_receiver(call)), pos)
        return
    if ends_with(what, "$release"):
        if nkids(n) >= 2:
            g = kid(n, 1)
            if nodes[g].kind == .ident and nodes[g].sym > 0:
                loop i in [0..dc_held.len()):
                    if dc_held[i].guard == int(nodes[g].sym):
                        dc_held.remove(i)
                        break
        return
    if len(what) > 0: return
    op = dc_chan_call(n)
    if op > 0:
        loop i in [1..nkids(n)): dc_walk(kid(n, i))
        loc = dc_loc(kid(n, 0))
        if loc.root == 0 or not loc.exact or len(loc.route) > 0 or loc.root != 2 and loc.root != 1: dc_precise = false
        if op == 3: dc_closes = true
        dc_event(op, loc, pos)
        return
    loop c in kids(n): dc_walk(c)
    if nodes[n].aux == 1 or nodes[n].aux == 4:
        # (a function value: what it waits for is not in view)
        dc_walk(int(nodes[n].a))
        dc_complete = false
        return
    if nodes[n].aux != 0 or nodes[n].sym <= 0: return
    g = int(nodes[n].sym)
    d = int(fns[g].decl)
    gname = if d != 0: name_of(int(nodes[d].name)) else: ""
    if gname == "__task_spawn" and nkids(n) == 2:
        h = dl_fn_arg(kid(n, 1))
        if h > 0 and dl_relevant.has(h) and fns[h].body != 0:
            if dc_pending.len() >= DC_ACTORS:
                dc_complete = false
                return
            ffns: int[]
            fcalls: int[]
            loop x in dc_ffns: ffns.push(x)
            loop x in dc_fcalls: fcalls.push(x)
            ffns.push(h)
            fcalls.push(0)
            dc_pending.push(DcSpawn(h, ffns, fcalls, dc_multi or dc_loops.len() > 0, dl_key(dc_loc(kid(n, 0))), pos))
        return
    if gname == "cancel" and pos_in_lib(nodes[d].pos): dc_cancels = true
    if gname == "cancel" and pos_in_lib(nodes[d].pos): dc_cancels = true
    if gname == "__task_join" and nkids(n) == 1:
        dc_event(5, dc_loc(kid(n, 0)), pos)
        return
    if fns[g].parallel_api: return
    # (a function given as a value to a call not walked here, as a library helper's)
    if not dl_relevant.has(g):
        loop c in kids(n):
            h = dl_fn_arg(c)
            if h > 0 and dl_relevant.has(h): dc_complete = false
        return
    dc_enter(g, n)

dc_enter = (g: int, n: int):
    if not dl_relevant.has(g) or fns[g].body == 0: return
    if dc_ffns.contains(g) or dc_ffns.len() > DC_DEPTH:
        dc_complete = false
        return
    dc_ffns.push(g)
    dc_fcalls.push(n)
    dc_walk(int(fns[g].body))
    dc_ffns.pop()
    dc_fcalls.pop()

# Every task's waits: the program's thread (top-level code, then main), then each task spawned,
# where it was spawned.
dc_collect = ():
    dc_ev = []
    loop f in init_fns + [main_fn]:
        if f <= 0 or not dl_relevant.has(f): continue
        dc_ffns = []
        dc_fcalls = []
        dc_enter(f, 0)
    dc_actors.push(DcActor(dc_ev, "the program's thread", false, "", 0))
    i = 0
    loop i < dc_pending.len():
        s = dc_pending[i]
        i += 1
        dc_ev = []
        dc_ffns = s.ffns
        dc_fcalls = s.fcalls
        dc_loops = []
        dc_held = []
        dc_branch = 0
        dc_multi = s.multi
        dc_walk(int(fns[s.h].body))
        dc_actors.push(DcActor(dc_ev, "the task spawned at {dl_line(s.site)}", s.multi, s.group, int(fns[s.h].ret)))

# ---------------- what waits for what ----------------

# The capacity a channel was made with, when a literal, else -1
dc_capacity = (l: DlLoc) -> int:
    decl = 0
    if l.root == 2: decl = l.id
    else if l.root == 1: decl = int(globals[l.id].decl)
    if decl == 0 or len(l.route) > 0: return -1
    init = int(nodes[decl].b)
    loop init != 0 and nodes[init].kind == .conv: init = int(nodes[init].a)
    if init == 0 or nodes[init].kind != .call or nodes[init].aux != 0 or nodes[init].sym <= 0: return -1
    g = int(nodes[init].sym)
    if int(fns[g].mod) != dc_mod or name_of(int(nodes[int(fns[g].decl)].name)) != "channel" or nkids(init) != 1: return -1
    c = dc_const(kid(init, 0))
    if c == none: return -1
    c!

# How many times an event at loops ev runs before the first run of one at loops at (loops around
# both are in their first iteration): -1 when not literal
dc_mult = (ev: int[], at: int[]) -> int:
    k = 0
    loop k < ev.len() and k < at.len() and ev[k] == at[k]: k += 1
    m = 1
    loop i in [k..ev.len()):
        t = dc_trips[ev[i]]
        if t < 0: return -1
        m = min(m * t, 1 << 40)
    m

# Whether the sends into ch by actor a, those before event `upto` (all of event `upto`'s runs,
# when through), wait: 2 for certain, 1 perhaps, 0 never.
dc_send_waits = (a: int, ch: str, upto: int, through: bool) -> int:
    evs = dc_actors[a].events
    at: int[] = if through: [] else: evs[upto].loops
    sure = 0
    any = 0
    unknown = false
    last = if through: upto + 1 else: upto
    cap = -1
    loop j in [0..last):
        e = evs[j]
        if e.kind != 1 or dl_key(e.loc) != ch: continue
        cap = dc_capacity(e.loc)
        m = dc_mult(e.loops, at)
        if m < 0: unknown = true
        else:
            any += m
            if not e.branch: sure += m
    if cap >= 0 and not unknown and any <= cap: return 0
    if cap >= 0 and sure > cap and dc_precise and dc_complete: return 2
    1

# Whether event j of actor a is the first receive from its channel
dc_first_receive = (a: int, j: int) -> bool:
    evs = dc_actors[a].events
    key = dl_key(evs[j].loc)
    loop i in [0..j):
        if evs[i].kind == 2 and dl_key(evs[i].loc) == key: return false
    true

# The node a wait (event j of actor a) waits for, and how it reads: ("", ...) when it does not
# wait, or not in a way a cycle can show
dc_wait_node = (a: int, j: int, upto: int, through: bool) -> (str, str, int):
    e = dc_actors[a].events[j]
    if e.loc.root == 0: return ("", "", 0)
    key = dl_key(e.loc)
    if e.kind == 1:
        w = dc_send_waits(a, key, upto, through)
        if w == 0: return ("", "", 0)
        cap = dc_capacity(e.loc)
        if w == 2: return ("S" + key, "sends more values into {dl_name(e.loc)} than the {cap} it holds ({dl_line(e.site)})", 2)
        return ("S" + key, "may wait to send into {dl_name(e.loc)} ({dl_line(e.site)})", 1)
    if e.kind == 2:
        if not dc_first_receive(a, j): return ("", "", 0)
        return ("R" + key, "waits to receive from {dl_name(e.loc)} ({dl_line(e.site)})", if e.loc.exact: 2 else: 1)
    if e.kind == 4: return ("L" + key, "waits for the lock {dl_name(e.loc)} ({dl_line(e.site)})", if e.loc.exact: 2 else: 1)
    if e.kind == 5: return ("J" + key, "waits for the tasks it spawned ({dl_line(e.site)})", 2)
    ("", "", 0)

dc_add_edge = (src: str, dst: str, certain0: bool, text: str, site: int):
    # (that a holder is the only one, and that a count is all there is, needs every wait seen)
    certain = certain0 and dc_precise and dc_complete
    key = "{src}>{dst}"
    if let i = dc_edge_at.get(key):
        if certain and not dc_edges[i].certain: dc_edges[i] = DcEdge(src, dst, certain, text, site)
        return
    dc_edge_at[key] = dc_edges.len()
    dc_edges.push(DcEdge(src, dst, certain, text, site))

# The waits of actor a before event i (or through it) as edges from the node it holds
dc_hold = (a: int, node: str, i: int, through: bool, how: str, ends: bool = false):
    evs = dc_actors[a].events
    last = if through: i + 1 else: i
    loop j in [0..last):
        up = if through: j else: i
        w, text, sure = dc_wait_node(a, j, up, through)
        if len(w) == 0: continue
        dc_add_edge(node, w, sure == 2 and not ends, "{dc_actors[a].name} {text}{how}", evs[j].site)

dc_edges_build = ():
    # (each channel's drainers and fillers, by spawn site)
    drainers: {str: int[]} = {}
    fillers: {str: int[]} = {}
    loop a in [0..dc_actors.len()):
        loop e in dc_actors[a].events:
            if e.kind > 3 or e.loc.root == 0: continue
            key = dl_key(e.loc)
            if e.kind == 2 or e.kind == 3:
                list = drainers.get(key) ?? []
                if not list.contains(a): list.push(a)
                drainers[key] = list
            if e.kind == 1 or e.kind == 3:
                list = fillers.get(key) ?? []
                if not list.contains(a): list.push(a)
                fillers[key] = list
    loop a in [0..dc_actors.len()):
        evs = dc_actors[a].events
        seen_drain: {str: bool} = {}
        seen_fill: {str: bool} = {}
        loop i in [0..evs.len()):
            e = evs[i]
            if e.kind <= 3 and e.loc.root != 0:
                key = dl_key(e.loc)
                # (the only drainer keeps the channel full until its first receive or close)
                if (e.kind == 2 or e.kind == 3) and not seen_drain.has(key):
                    seen_drain[key] = true
                    if (drainers.get(key) ?? []).len() == 1:
                        verb = if e.kind == 2: "receives from" else: "closes"
                        dc_hold(a, "S" + key, i, false, " before it {verb} {dl_name(e.loc)} ({dl_line(e.site)})")
                # (the only filler keeps it empty until its first send or close)
                if (e.kind == 1 or e.kind == 3) and not seen_fill.has(key):
                    seen_fill[key] = true
                    if (fillers.get(key) ?? []).len() == 1:
                        verb = if e.kind == 1: "sends into" else: "closes"
                        dc_hold(a, "R" + key, i, false, " before it {verb} {dl_name(e.loc)} ({dl_line(e.site)})")
            # (a wait while holding a lock)
            if e.held.len() > 0 and e.kind != 3 and e.kind != 4:
                w, text, sure = dc_wait_node(a, i, i, true)
                if len(w) > 0:
                    loop h in [0..e.held.len()):
                        if e.held[h].root == 0: continue
                        dc_add_edge("L" + dl_key(e.held[h]), w, sure == 2 and e.held[h].exact, "{dc_actors[a].name} {text} while holding {dl_name(e.held[h])} (since {dl_line(e.held_sites[h])})", e.site)
        # (a spawned task holds its group's join until it ends)
        if len(dc_actors[a].group) > 0 and evs.len() > 0:
            dc_hold(a, "J" + dc_actors[a].group, evs.len() - 1, true, ", and the join of its group{dc_join_line(dc_actors[a].group)} waits for it", dc_cancelable(dc_actors[a].group))
        # (what nothing drains or fills waits forever)
        loop i in [0..evs.len()):
            e = evs[i]
            if e.kind > 2 or e.loc.root == 0: continue
            key = dl_key(e.loc)
            other = if e.kind == 1: drainers else: fillers
            if other.has(key): continue
            w, text, sure = dc_wait_node(a, i, i, true)
            if len(w) == 0: continue
            what = if e.kind == 1: "nothing receives from it or closes it" else: "nothing sends into it or closes it"
            if sure == 2 and dc_precise and dc_complete: fatal(e.site, "{dc_actors[a].name} {text}, and {what}: it waits forever")
            if dl_report_warn(e.site): dl_undecided(e.site, "{dc_actors[a].name} {text}, and {what}: it may wait forever")
    # (stage 1's lock order: one lock taken while holding another)
    loop e in dl_global_edges:
        dc_add_edge("L" + dl_key(e.held), "L" + dl_key(e.taken), dl_must(e.held, e.held) and dl_must(e.taken, e.taken), dl_path(e), e.taken_site)

# Whether a group may be canceled while its join waits (a task's failure, or a cancel by hand):
# then its waits may end, and a cycle through the join is undecided
dc_cancelable = (group: str) -> bool:
    if dc_cancels: return true
    loop actor in dc_actors:
        if actor.group == group and actor.ret != 0 and dc_may_fail(actor.ret): return true
    false

# " at line N" of a group's join
dc_join_line = (group: str) -> str:
    loop actor in dc_actors:
        loop e in actor.events:
            if e.kind == 5 and dl_key(e.loc) == group: return " at {dl_line(e.site)}"
    ""

dc_warned: {int: bool} = {}
dl_report_warn = (site: int) -> bool:
    if dc_warned.has(site): return false
    dc_warned[site] = true
    true

# A cycle through a channel or join node, among the certain edges (an error), or else among all
# (a warning). Breadth-first from each such node's edges back to it.
dc_cycles = ():
    out: {str: int[]} = {}
    loop i in [0..dc_edges.len()):
        list = out.get(dc_edges[i].src) ?? []
        list.push(i)
        out[dc_edges[i].src] = list
    loop round in [0..2):
        sure = round == 0
        starts: str[]
        loop i in [0..dc_edges.len()):
            s = dc_edges[i].src
            if not starts_with(s, "L") and not starts.contains(s): starts.push(s)
        loop s in starts:
            prev: {str: int} = {}
            queue: str[] = [s]
            q = 0
            found = false
            loop q < queue.len() and not found:
                v = queue[q]
                q += 1
                loop j in out.get(v) ?? []:
                    if sure and not dc_edges[j].certain: continue
                    w = dc_edges[j].dst
                    if prev.has(w): continue
                    prev[w] = j
                    if w == s:
                        found = true
                        break
                    queue.push(w)
            if not found: continue
            path: int[]
            v = s
            loop true:
                j = prev[v]
                path.insert(0, j)
                v = dc_edges[j].src
                if v == s: break
            dc_report(path, sure)
            return

dc_report = (path: int[], sure: bool):
    texts: str[]
    loop j in path: texts.push(dc_edges[j].text)
    first = dc_edges[path[0]]
    fix = "Receive before sending more than a channel holds, give the channel room for what is sent first, or let a lock's place end before a channel wait"
    undecided = " (the compiler cannot tell whether every wait does: a count or capacity that is not literal, a group that a failure or a cancel may end, or a channel or task it cannot follow)"
    if path.len() == 1:
        if sure: fatal(first.site, "{first.text}: it waits for itself forever. {fix}")
        dl_undecided(first.site, "{first.text}: it may wait for itself forever{undecided}")
        return
    msg = "bounded channel cycle: " + join(texts, "; ") + ". Each waits for the next"
    if sure:
        loop k in [1..path.len()): err_notes.push((dc_edges[path[k]].site, "note: {dc_edges[path[k]].text}"))
        fatal(first.site, "{msg}, so none goes on: the program waits forever. {fix}")
    sites: int[]
    loop j in path: sites.push(dc_edges[j].site)
    dl_undecided(first.site, "{msg}, so they may wait forever{undecided}", sites)

dc_analyze = ():
    dc_collect()
    dc_edges_build()
    dc_cycles()


# ---------------- `$no_deadlocks`: certificates ----------------
# In a scope under `$no_deadlocks` (docs/design/safety_and_concurrency.md, "Certificates"), every
# wait needs a certificate, or it is an error naming the wait and what is missing:
#   - a lock wait: the checked lock order (stage 1 above, whose undecided cases are errors here:
#     dl_undecided), with every lock named;
#   - a join (the end of `concurrent`, `within`, `race`): structured, its tasks' functions in view
#     and their waits certified, no lock held across it;
#   - a certified protocol of the library (lib/prelude/protocols.dewy: `request`, `serve`,
#     `pipeline`), with no lock held across it, and a `serve` handler that asks no service;
#   - a foreign call that may block: only inside an audited adapter (`$audited_wait`).
# Uncertified everywhere: a raw channel wait, polling an atomic (an event no certificate covers),
# a function value the compiler cannot follow, a lock held across any wait but another lock, and
# a wait in a lifecycle hook (cleanup runs at exits the order and the joins do not see). What waits
# only on the outside world (I/O, sleep) is not a wait on a task (the theorem's third assumption).
#
# Summaries. A function's summary (what kinds of waits it may make, transitively, and its first
# uncertified one) is built by one walk of its body, with the locks held; calls fold the callee's
# summary in, functions given as arguments count as called at the call (with the locks held), and
# spawned functions count where they are spawned (holding nothing). Recursion: the walk keeps a
# path, and a strongly connected set of functions shares its root's summary (Tarjan's low links),
# a call into the set while holding a lock being uncertified. A wait no certificate covers is
# reported where it is, if that site is under `$no_deadlocks`, or at the first call into it from
# such a site.
#
# Demand and cost: nothing runs unless some scope sets `$no_deadlocks`. Then every function of the
# files that set it is walked once, and the functions they reach once each: O(N + E) over the nodes
# and calls walked.

const ND_LOCK = 1                # takes a lock (the checked order covers it)
const ND_WAIT = 2                # waits on another task otherwise (a join, a protocol, a channel)
const ND_ASK = 4                 # asks a service
const ND_BAD = 8                 # makes a wait no certificate covers

struct NdSum:
    flags: int
    bad: str                     # the first uncertified wait, as it reads after "this"
    bad_site: int
    wait: str                    # the first wait on another task, the same way
    wait_site: int
    ask_site: int                # the first request to a service

nd_sums: {int: NdSum}
nd_index: {int: int}             # a function being summarized -> its place on nd_path
nd_path: int[]
nd_low = 0
nd_stack: NdSum[]                # the summaries being built, innermost last
nd_fns: int[]                    # the functions being walked, innermost last

nd_empty = () -> NdSum: NdSum(0, "", 0, "", 0, 0)

nd_top = () -> int: nd_stack.len() - 1

nd_fn = () -> int: nd_fns[nd_fns.len() - 1]

# Where a site is, seen from another: "line N" in the same file, else "file:N"
nd_where = (site: int, from: int) -> str:
    l, c = line_col(site)
    if pos_file(site) == pos_file(from): return "line {l}"
    path = files[pos_file(site)].path
    base = path[rfind(path, "/") + 1..]
    "{base}:{l}"

# A wait no certificate covers: an error at a site under `$no_deadlocks`; the summary keeps the first
nd_bad = (site: int, text: str, fix: str):
    t = nd_top()
    if nd_stack[t].flags & ND_BAD == 0:
        nd_stack[t].flags |= ND_BAD
        nd_stack[t].bad = text
        nd_stack[t].bad_site = site
    if dir_no_deadlocks(site): fatal(site, "this {text}, and no certificate covers it (`$no_deadlocks`): {fix}")

# A wait on another task, other than a lock
nd_wait = (site: int, text: str):
    t = nd_top()
    nd_stack[t].flags |= ND_WAIT
    if len(nd_stack[t].wait) == 0:
        nd_stack[t].wait = text
        nd_stack[t].wait_site = site

# Locks are the leaves of the waits: one is held only across other locks, taken in order
nd_held_across = (held: DlHeld[], site: int, what: str):
    if held.len() == 0: return
    h = held[held.len() - 1]
    nd_bad(site, "{what} while holding {dl_name(h.loc)} (since {nd_where(h.site, site)})", "a lock is held only across other locks taken in the checked order; let the place end before this wait")

nd_summary = (f: int) -> NdSum:
    if let s = nd_sums.get(f): return s
    if let i = nd_index.get(f):
        nd_low = min(nd_low, i)
        return nd_empty()
    # (the library's own waits are classified at its calls, nd_call)
    if fns[f].body == 0 or pos_in_lib(nodes[int(fns[f].body)].pos): return nd_empty()
    i = nd_path.len()
    nd_index[f] = i
    nd_path.push(f)
    saved = nd_low
    nd_low = i
    nd_stack.push(nd_empty())
    nd_fns.push(f)
    held: DlHeld[]
    nd_walk(int(fns[f].body), held)
    # (cleanup: a lifecycle hook runs where a value ends, unseen by the order and the joins)
    d = int(fns[f].decl)
    t = nd_top()
    if d != 0 and ownership_hooks.has(d) and nd_stack[t].flags & (ND_LOCK | ND_WAIT) != 0 and nd_stack[t].flags & ND_BAD == 0:
        what = if len(nd_stack[t].wait) > 0: "{nd_stack[t].wait} ({nd_where(nd_stack[t].wait_site, nodes[d].pos)})" else: "takes a lock"
        nd_bad(nodes[d].pos, "lifecycle hook waits: it {what}", "cleanup runs where a value ends, which the lock order and the joins do not see; keep waits out of `$__drop__`, `$__copy__` and `$__move__` hooks")
    nd_fns.pop()
    s = nd_stack.pop()
    low = nd_low
    nd_low = min(saved, low)
    if low >= i:
        loop j in [i..nd_path.len()):
            nd_sums[nd_path[j]] = s
            nd_index.remove(nd_path[j])
        loop nd_path.len() > i: nd_path.pop()
    s

# What a call of h (from pos, holding held) adds: its waits, and its uncertified one
nd_callee = (h: int, held: DlHeld[], pos: int, name: str):
    busy = nd_index.has(h)
    s = nd_summary(h)
    t = nd_top()
    nd_stack[t].flags |= s.flags & (ND_LOCK | ND_WAIT | ND_ASK)
    if s.flags & ND_WAIT != 0 and len(nd_stack[t].wait) == 0:
        nd_stack[t].wait = s.wait
        nd_stack[t].wait_site = s.wait_site
    if s.flags & ND_ASK != 0 and nd_stack[t].ask_site == 0: nd_stack[t].ask_site = s.ask_site
    if s.flags & ND_BAD != 0:
        if nd_stack[t].flags & ND_BAD == 0:
            nd_stack[t].flags |= ND_BAD
            nd_stack[t].bad = s.bad
            nd_stack[t].bad_site = s.bad_site
        # (an uncertified wait under `$no_deadlocks` is reported where it is)
        if dir_no_deadlocks(pos) and not dir_no_deadlocks(s.bad_site): fatal(pos, "this calls {name}, which {s.bad} ({nd_where(s.bad_site, pos)}), and no certificate covers that wait (`$no_deadlocks`): give it one, or opt its scope in to see what it lacks")
    if held.len() > 0 and busy: nd_held_across(held, pos, "calls {name} again (recursively), whose waits are not known yet,")
    else if held.len() > 0 and s.flags & ND_WAIT != 0: nd_held_across(held, pos, "calls {name}, which {s.wait} ({nd_where(s.wait_site, pos)}),")

# A local that is a parameter of the function walked (or a capture of one): what a function
# value it holds waits for is counted where it is given
nd_param = (e0: int) -> bool:
    e = e0
    loop nodes[e].kind == .conv or nodes[e].kind == .namedarg: e = int(nodes[e].a)
    if nodes[e].kind != .ident or nodes[e].aux != i32(int(SK.local)) or nodes[e].sym <= 0: return false
    l = int(nodes[e].sym)
    loop depth in [0..8):
        if dl_param_of(l) >= 0: return true
        if int(locals[l].flags) & LF_CAPTURE == 0 or locals[l].outer <= 0: return false
        l = int(locals[l].outer)
    false

# A callable whose type's row excludes waiting
nd_nonblocking = (e: int) -> bool:
    c = callable_contract(ntype(e))
    c != 0 and not effect_allows(c, EffectAtom(.block))

# The functions given as arguments at a call, as if called there
nd_args = (n: int, held: DlHeld[], pos: int, first: int = 0):
    loop i in [first..nkids(n)):
        a = kid(n, i)
        if not is_fn_type(ntype(a)): continue
        h = dl_fn_arg(a)
        if h > 0:
            nd_callee(h, held, pos, "the function given here")
            continue
        if nd_param(a) or nd_nonblocking(a): continue
        nd_bad(pos, "gives a function value the compiler cannot follow, so what it waits for is unknown", "give a function literal or a named function, or a callable type whose row says `no blocks`")

nd_walk = (n: int, held: mut DlHeld[]):
    if n == 0: return
    k = nodes[n].kind
    if k == .lambda or k == .fnref: return
    if k == .block:
        mark = held.len()
        loop c in kids(n): nd_walk(c, held)
        if nodes[n].aux != 5: dl_drop(held, mark)
        return
    if k == .vardecl:
        init = int(nodes[n].b)
        loop init != 0 and nodes[init].kind == .conv: init = int(nodes[init].a)
        if init != 0 and nodes[init].kind == .call:
            what = dl_lock_call(init)
            if what == "lock" or what == "try_lock$acquire" or what == "__take":
                if what == "lock": nd_stack[nd_top()].flags |= ND_LOCK
                held.push(DlHeld(dl_resolve(dl_receiver(init), nd_fn()), nodes[init].pos, int(nodes[n].sym)))
                return
        nd_walk(int(nodes[n].b), held)
        return
    if k == .if_ or k == .iflet:
        nd_walk(int(nodes[n].a), held)
        mark = held.len()
        nd_walk(int(nodes[n].b), held)
        dl_drop(held, mark)
        nd_walk(int(nodes[n].c), held)
        dl_drop(held, mark)
        return
    if k == .while_ and deadlock_atomics: nd_poll(n)
    if k == .intrinsic and nodes[n].aux == i32(int(IN.syscall)): nd_syscall(n)
    if k == .call: nd_call(n, held)
    else if k == .propagate or k == .parallel_region:
        nd_walk(int(nodes[n].a), held)
        return
    loop g in value_helper_calls(n): nd_callee(g, held, nodes[n].pos, "`{effect_name(g)}` (a hidden call)")
    if k == .call: return
    mask = isolation_children(k)
    if mask < 0:
        nd_walk(int(nodes[n].a), held)
        nd_walk(int(nodes[n].b), held)
        nd_walk(int(nodes[n].c), held)
        loop c in kids(n): nd_walk(c, held)
        return
    if mask & 1 != 0: nd_walk(int(nodes[n].a), held)
    if mask & 2 != 0: nd_walk(int(nodes[n].b), held)
    if mask & 4 != 0: nd_walk(int(nodes[n].c), held)
    if mask & 16 != 0:
        mark = held.len()
        loop c in kids(n):
            nd_walk(c, held)
            if k == .match_ or k == .arm: dl_drop(held, mark)
    if mask & 32 != 0:
        loop c in kids2(n): nd_walk(c, held)

# A loop polling an atomic it does not set: waiting for another task to set it, an event
nd_poll = (lp: int):
    polled: DlLoc[]
    dl_atomic_reads(int(nodes[lp].a), nd_fn(), polled)
    loop p in polled:
        if dl_atomic_written(int(nodes[lp].b), nd_fn(), p): continue
        nd_wait(nodes[lp].pos, "polls {dl_name(p)}")
        nd_bad(nodes[lp].pos, "loop waits for another task to set {dl_name(p)}, by polling it", "an atomic set elsewhere is an event no certificate covers; wait for a join or a certified protocol (`serve`, `pipeline`) instead")
        return

# A raw system call that may wait (clocks and process queries do not)
nd_syscall = (n: int):
    op = if nkids(n) > 0: kid(n, 0) else: 0
    number = if op != 0 and nodes[op].kind == .int_lit: nodes[op].ival else: -1
    if number == 39 or number == 60 or number == 186 or number == 204 or number == 228: return
    if dir_audited_wait(nodes[n].pos): return
    nd_bad(nodes[n].pos, "makes a system call that may block", "wrap it in an audited adapter: a function whose body says `$audited_wait`, for a call checked to wait only on the outside world")

nd_call = (n: int, held: mut DlHeld[]):
    pos = nodes[n].pos
    what = dl_lock_call(n)
    if what == "__lock_all":
        nd_stack[nd_top()].flags |= ND_LOCK
        return
    if ends_with(what, "$release"):
        if nkids(n) >= 2:
            g = kid(n, 1)
            if nodes[g].kind == .ident and nodes[g].sym > 0:
                loop i in [0..held.len()):
                    if held[i].guard == int(nodes[g].sym):
                        held.remove(i)
                        break
        return
    if len(what) > 0: return
    op = dc_chan_call(n)
    if op == 1 or op == 2:
        loop i in [1..nkids(n)): nd_walk(kid(n, i), held)
        verb = if op == 1: "waits to send into" else: "waits to receive from"
        nd_wait(pos, "{verb} {dl_name(dl_resolve(kid(n, 0), nd_fn()))}")
        nd_bad(pos, "{verb} the channel {dl_name(dl_resolve(kid(n, 0), nd_fn()))}", "a raw channel's waits are not certified; use a certified protocol: `serve` for request/reply, `pipeline` for a pipeline with feedback")
        return
    loop c in kids(n): nd_walk(c, held)
    if nodes[n].aux == 1 or nodes[n].aux == 4:
        nd_walk(int(nodes[n].a), held)
        nd_value_call(n, held)
        return
    if nodes[n].aux != 0 or nodes[n].sym <= 0: return
    g = int(nodes[n].sym)
    d = int(fns[g].decl)
    if d == 0: return
    gname = name_of(int(nodes[d].name))
    if has_flag(d, NF_EXTERN):
        nd_foreign(n, g, d)
        return
    if pc_mod >= 0 and int(fns[g].mod) == pc_mod:
        nd_protocol(n, gname, held)
        return
    if not pos_in_lib(nodes[d].pos):
        nd_callee(g, held, pos, "`{effect_name(g)}`")
        nd_args(n, held, pos)
        return
    # The library: its own waits are on the outside world, except these.
    if gname == "__task_spawn" and nkids(n) == 2:
        h = dl_fn_arg(kid(n, 1))
        none_held: DlHeld[]
        if h > 0: nd_callee(h, none_held, pos, "the spawned task")
        else: nd_bad(pos, "spawns a function value the compiler cannot follow", "spawn a call the compiler can see")
        return
    if gname == "__task_join" or gname == "__task_cleanup":
        nd_wait(pos, "joins its tasks")
        nd_held_across(held, pos, "joins its tasks")
        return
    if (gname == "within" or gname == "race") and int(fns[g].mod) == concurrency_task_module:
        nd_wait(pos, "waits for the task of `{gname}`")
        nd_held_across(held, pos, "waits for the task of `{gname}`")
        none_held: DlHeld[]
        nd_args(n, none_held, pos)
        return
    nd_args(n, held, pos)

# A function value called
nd_value_call = (n: int, held: DlHeld[]):
    pos = nodes[n].pos
    callee = int(nodes[n].a)
    if nd_nonblocking(callee): return
    h = dl_fn_arg(callee)
    if h > 0:
        nd_callee(h, held, pos, "the function value called here")
        return
    if nd_param(callee):
        if held.len() > 0: nd_held_across(held, pos, "calls a function value it was given")
        return
    nd_bad(pos, "calls a function value the compiler cannot follow, so what it waits for is unknown", "call a function literal or a named function (or a local holding one), or give the value a callable type whose row says `no blocks`")

# A foreign function: opaque, so one that may block needs an audited adapter
nd_foreign = (n: int, g: int, d: int):
    if nodes[d].sval != 0:
        row = int(decl_infos[decl_info(d)].sig.contract)
        if row != 0 and not effect_allows(row, EffectAtom(.block)): return
    if dir_audited_wait(nodes[n].pos): return
    nd_bad(nodes[n].pos, "calls the foreign function '{name_of(int(nodes[d].name))}', which may block", "wrap it in an audited adapter, a function whose body says `$audited_wait` (a person has checked that it waits only on the outside world), or declare it with a row that excludes `blocks` if it never waits")

# The certified protocols (lib/prelude/protocols.dewy)
nd_protocol = (n: int, gname: str, held: DlHeld[]):
    pos = nodes[n].pos
    none_held: DlHeld[]
    if gname == "request":
        nd_wait(pos, "asks a service")
        t = nd_top()
        nd_stack[t].flags |= ND_ASK
        if nd_stack[t].ask_site == 0: nd_stack[t].ask_site = pos
        nd_held_across(held, pos, "asks a service")
        return
    if gname == "serve" and nkids(n) == 2:
        nd_wait(pos, "serves requests")
        nd_held_across(held, pos, "serves requests")
        h = dl_fn_arg(kid(n, 0))
        if h <= 0: nd_bad(pos, "serves requests with a handler the compiler cannot follow", "give `serve` a function literal or a named function as its handler")
        else:
            s = nd_summary(h)
            # (a server that waits on a service may wait on itself)
            if s.flags & ND_ASK != 0: nd_bad(pos, "serves requests with a handler that asks a service itself ({nd_where(s.ask_site, pos)})", "a server waiting on a service may wait on itself; compute the reply in the handler, and ask other services from the body")
            nd_callee(h, none_held, pos, "the handler")
        nd_args(n, none_held, pos, 1)
        return
    if gname == "pipeline":
        nd_wait(pos, "runs a pipeline")
        nd_held_across(held, pos, "runs a pipeline")
        nd_args(n, none_held, pos)
        return
    nd_args(n, held, pos)

nd_check = ():
    if dc_mod < 0: dc_mod = dc_module()
    # (the functions of the files that opt in; what they reach is summarized as they call it)
    files_in: {int: bool} = {}
    loop sc in dir_scopes:
        if sc.setting == dir_name_deadlocks and sc.value == 1: files_in[pos_file(sc.start)] = true
    loop f in [1..fns.len()):
        if fns[f].state != 2 or fns[f].body == 0: continue
        if not files_in.has(pos_file(nodes[int(fns[f].body)].pos)): continue
        nd_summary(f)

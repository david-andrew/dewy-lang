use 'lower_helpers.dewy'
use 'checker_state.dewy'
use 'effect_lattice.dewy'
use 'effect_types.dewy'
# Deadlock freedom, stage 1 (docs/design/safety_and_concurrency.md, "Deadlock freedom"): with no
# annotations, the compiler infers lock identities, held-lock sets and the order locks are taken
# in, across the program. Errors only for what it demonstrates:
#   - a lock-order cycle (two paths taking the same locks in opposite orders), with a fix-it to
#     take them together with `lock_all`;
#   - waiting for a lock the task already holds (directly, through a call or a callback, or
#     through a copied handle);
#   - holding a lock across a join of tasks, or a `parallel` loop, whose work takes it;
#   - a `parallel` iteration polling an atomic that only a sibling iteration sets.
# Undecided cases (elements of one array taken in an order the indexes decide, a lock held
# across a call of a function value, polling an atomic set elsewhere) are warnings.
#
# Identities. A lock is named by an abstract location: a root and a route of fields and
# elements. Roots are a global, a local's declaration (where its handle was made; copies
# `let m2 = m` and places `@m` follow to it, captures to the enclosing function's local), a
# parameter of the function (symbolic, replaced by the argument's location at each call), or
# unknown. Two locations with the same root and route and no element step are one lock; with an
# element step they may be.
#
# Demand and cost. Nothing runs unless the checker saw a lock taken (deadlock_fns, filled by
# place_methods.jo). Then: one scan of the checked function bodies for the call graph (O(N)),
# the upward closure of the functions taking locks (the only ones whose summaries are not
# empty), and summaries iterated to a fixed point over that set (acquired locations, symbolic
# order edges, callbacks called under a lock), each pass O(N_rel + E_rel * K) with K the
# distinct locations (indexed by key), at most DL_PASSES passes; then one reporting pass and a
# cycle search over the location graph (Tarjan, O(V + E)).
use 'ast.jo'
use 'types.jo'
use 'check.jo'
use 'expr.jo'
use 'util.jo'
use 'lower.jo'
use 'isolation.jo'
use 'concurrency.jo'
use 'effects.jo'
use 'prelude.jo'
use 'errors.jo'
use 'directives.jo'
use 'ownership.jo'
use 'lower_races.dewy'
use 'effect_contracts.dewy'
use 'effect_control.dewy'
use 'isolation_ops.dewy'
use 'concurrency_types.dewy'
use 'concurrency_tasks.dewy'

deadlock_fns: {int: bool}       # functions whose bodies take a lock (place_methods.jo)
deadlock_parallel = false        # the program runs `parallel` work (a cycle is reachable by tasks)
deadlock_atomics = false         # the program uses an atomic (concurrency_atomic_call)
dc_fns: {int: bool}              # functions calling a channel operation (dl_scan_calls)
dc_mod = -1                      # the channels prelude's module, once loaded
dc_qmod = -1                     # the mpmc prelude's (lib/prelude/mpmc.dewy), once loaded
dc_smod = -1                     # the spsc prelude's; both ends name the split's ring
pc_mod = -2                      # the protocols prelude's module (-1 none; -2 not looked up)

const DL_PASSES = 8

struct DlLoc:
    root: int        # 0 unknown, 1 global, 2 declaration, 3 parameter, 4 a local itself
    id: int          # the global, the declaration node, or the function (parameter)
    k: int           # the parameter's index
    route: str       # ".balance", "[]"
    exact: bool      # no element step, root known: one lock

struct DlAcq:
    loc: DlLoc
    site: int        # where it is taken (the wait)
    wait: bool       # waits for it (lock, lock_all), or only holds it (try_lock)
    via: str         # "" or the chain of calls that takes it

struct DlEdge:
    held: DlLoc
    taken: DlLoc
    held_site: int
    taken_site: int
    via: str
    at: int = 0      # the call (or wait) in the function where it became concrete

struct DlCallback:
    param: int       # the parameter called
    held: DlLoc[]
    sites: int[]
    site: int        # the call

struct DlSummary:
    acqs: DlAcq[]
    acq_keys: {str: bool}
    edges: DlEdge[]
    edge_keys: {str: bool}
    callbacks: DlCallback[]
    cb_keys: {str: bool}

struct DlHeld:
    loc: DlLoc
    site: int
    guard: int       # the guard's local (released at its place's last use), 0 for none

dl_summaries: {int: DlSummary}
dl_relevant: {int: bool}
dl_changed = false
dl_report = false
dl_global_edges: DlEdge[]
dl_global_keys: {str: bool}
dl_param_index: {int: int}       # parameter local -> its index
dl_inits: {int: int}             # local -> its declaration (the relevant functions')
dl_groups: {int: int[]}          # a task group's local -> the functions spawned into it
dl_fn = 0                        # the function being walked
dl_cur: DlSummary

# ---------------- the program's call graph and the relevant functions ----------------

dl_callers: {int: int[]}
dl_givens: {int: int[]}          # function -> the function values its calls are given

# Abstract locations and demanded resolution execute in deadlock_locations.dewy.

# Summary updates and held-lock trimming execute in deadlock_summaries.dewy.

# Lock/call walks execute in deadlock_walk.dewy; wait diagnostics and atomic
# polling execute in deadlock_waits.dewy.

# Call-graph demand, order cycles and finalization execute in deadlock_graph.dewy.

# ---------------- channel waits ----------------
# A bounded channel's send waits while it is full and its receive while it is empty, so a task
# waiting on a channel waits for another task's receive or send (or close). Each task (the
# program's thread, and every task spawned, walked from where it is spawned with the calls it
# makes inlined, so a channel handle given down calls or captured is the declaration that made
# it) is read as its waits in order: sends, receives, closes, lock waits and joins, each with
# the loops around it (their iteration counts when literal) and the locks held.
#
# Who holds what a wait needs:
#   - room in channel c: its only drainer (the one spawn site that receives from or closes it)
#     until its first receive; whatever it waits for before that keeps c full;
#   - a value in c: its only filler (sends or closes it) until its first send;
#   - a lock: its holder; a join: every task of the group, until it ends.
# An edge "holding X, waits for Y" comes from each wait before the point a holder gives X up,
# and from each wait while holding a lock. A send waits for certain when the values sent into
# its channel by then (loops counted, the first iteration only for a loop around both) are more
# than the capacity; when the counts or the capacity are not literal it may wait (undecided); when
# they fit, it does not wait. A receive waits (for a filler held up) at the task's first receive
# from that channel. A cycle through a channel or a join among certain edges is an error (a
# demonstrated deadlock); one needing an undecided edge is a warning. Together with the lock
# order edges of stage 1 (a lock held across a channel wait the other side needs).
#
# Demand and cost: nothing runs unless the channels prelude is loaded and a checked function
# calls it. The walk inlines the relevant functions only (the upward closure above), at most
# DC_DEPTH deep and DC_EVENTS waits; a walk cut short, a function value called, or a channel the
# walk cannot name (in a container, given through a field) makes every edge undecided. The edges
# are O(W^2) in a task's W waits; the cycle search is a breadth-first search per channel node,
# O(V(V + E)).

struct DcEvent:
    kind: int        # 1 send, 2 receive, 3 close, 4 lock wait, 5 join, 6 try_send, 7 try_receive
    loc: DlLoc       # the channel, lock or task group
    loops: int[]     # the loops around it, outermost first (indexes into dc_trips)
    branch: bool     # under a condition
    held: DlLoc[]    # the locks held
    held_sites: int[]
    site: int

struct DcActor:
    events: DcEvent[]
    name: str
    multi: bool      # spawned in a loop: several may run at once
    group: str       # the key of the group that joins it ("" for the program's thread)
    ret: int         # its result type (a failure cancels its group), 0 for the program's thread

struct DcSpawn:
    h: int
    ffns: int[]
    fcalls: int[]
    multi: bool
    group: str
    site: int

struct DcEdge:
    src: str
    dst: str
    certain: bool
    text: str
    site: int

const DC_EVENTS = 20000
const DC_DEPTH = 16
const DC_ACTORS = 256

dc_actors: DcActor[]
dc_trips: int[]                  # loop -> its iterations, -1 when not literal
dc_complete = true               # every walk saw every wait it reached
dc_precise = true                # every channel named by the declaration that made it
dc_count = 0
dc_closes = false                # some task closes a channel
dc_cancels = false               # some task cancels a group by hand
dc_cancelable_groups: {str: bool}
# (the walk of one task)
dc_ev: DcEvent[]
dc_ffns: int[]                   # the functions entered, outermost first
dc_fcalls: int[]                 # the calls entering them (0 for a task's body)
dc_loops: int[]
dc_branch = 0
dc_multi = false
dc_held: DlHeld[]
dc_pending: DcSpawn[]
dc_edges: DcEdge[]
dc_edge_at: {str: int}
dc_attempts: {str: bool}          # occupancy may change without a blocking event
dc_unknown_attempt = false       # an unresolved alias may affect any queue's occupancy
dc_exclusive: {str: bool}         # one producer, one drainer; no attempt can race an earlier drain
dc_ends: {str: bool}              # SPSC ends can also close through ownership cleanup

# The channels prelude's module, if a program loaded it (by its path among the prelude's files)
dc_module = (path: str = "/prelude/channels.dewy") -> int:
    loop i in [0..dp_paths.len()):
        if ends_with(dp_paths[i], path): return dp_mods[i]
    -1

# Queue identities and verbs are resolved by library identity, never spelling alone.
dc_is = (m: int) -> bool: m >= 0 and (m == dc_mod or m == dc_qmod or m == dc_smod)
dc_on = () -> bool: dc_mod >= 0 or dc_qmod >= 0 or dc_smod >= 0

dc_split = (n0: int) -> bool:
    n = n0
    if dc_smod < 0 or n == 0: return false
    loop nodes[n].kind == .conv: n = int(nodes[n].a)
    if nodes[n].kind != .call or nodes[n].aux != 0 or nodes[n].sym <= 0 or nkids(n) != 1: return false
    g = int(nodes[n].sym)
    fns[g].mod == dc_smod and name_of(int(nodes[int(fns[g].decl)].name)) == "split"

# The certified protocols' module (lib/prelude/protocols.dewy), if a program loaded it
pc_module = () -> int:
    loop i in [0..dp_paths.len()):
        if ends_with(dp_paths[i], "/prelude/protocols.dewy"): return dp_mods[i]
    -1

dc_protocols = () -> int:
    if pc_mod == -2: pc_mod = pc_module()
    pc_mod

# Whether the checker reached a channel operation (a program can load the prelude for a name it
# uses otherwise, as a module of its own called `channel`): O(functions)
dc_called = () -> bool:
    loop f in [1..fns.len()):
        if not dc_is(int(fns[f].mod)) or fns[f].state != 2 or fns[f].decl == 0: continue
        nm = name_of(int(nodes[int(fns[f].decl)].name))
        if nm == "send" or nm == "receive" or nm == "close" or nm == "try_send" or nm == "try_receive": return true
    false

# The channel operation a call is: 1 send, 2 receive, 3 close, 0 none
dc_chan_call = (n: int) -> int:
    if not dc_on() or nodes[n].kind != .call or nodes[n].aux != 0 or nodes[n].sym <= 0: return 0
    g = int(nodes[n].sym)
    if not dc_is(int(fns[g].mod)) or nkids(n) == 0: return 0
    d = int(fns[g].decl)
    if d == 0: return 0
    nm = name_of(int(nodes[d].name))
    if nm == "send": return 1
    if nm == "receive": return 2
    if nm == "close": return 3
    if nm == "try_send": return 6
    if nm == "try_receive": return 7
    0

# A location in the function on top of the walk, with its parameters replaced by the arguments
# of the calls that entered it
dc_loc = (e: int) -> DlLoc:
    l = dc_concrete(dl_resolve(e, dc_ffns[dc_ffns.len() - 1]), dc_ffns.len() - 1)
    # A saved split pair's two fields still share one ring.
    if l.root == 2 and dc_split(int(nodes[l.id].b)): l.route = ""
    # A helper returning a handle need not make a fresh queue. The generic lock
    # resolver names its declaration in ordinary code; queue occupancy must not
    # treat that name as independent of the helper's arguments or other handles.
    decl = 0
    if l.root == 2: decl = l.id
    else if l.root == 1: decl = int(globals[l.id].decl)
    if decl != 0:
        init = int(nodes[decl].b)
        loop init != 0 and nodes[init].kind == .conv: init = int(nodes[init].a)
        if init != 0 and nodes[init].kind == .call and not dc_split(init) and not dl_makes_handle(init): l.exact = false
    l

dc_concrete = (l: DlLoc, at: int) -> DlLoc:
    if l.root != 3: return l
    i = at
    loop i >= 0 and dc_ffns[i] != l.id: i -= 1
    if i <= 0 or dc_fcalls[i] == 0: return dl_unknown()
    n = dc_fcalls[i]
    if l.k >= nkids(n): return dl_unknown()
    a = kid(n, l.k)
    if nodes[a].kind == .namedarg: a = int(nodes[a].a)
    base = dc_concrete(dl_resolve(a, dc_ffns[i - 1]), i - 1)
    if base.root == 0: return base
    DlLoc(base.root, base.id, base.k, base.route + l.route, base.exact and l.exact)

dc_event = (kind: int, loc: DlLoc, site: int):
    dc_count += 1
    if dc_count > DC_EVENTS:
        dc_complete = false
        return
    loops: int[]
    loop x in dc_loops: loops.push(x)
    locs: DlLoc[]
    sites: int[]
    loop h in dc_held:
        locs.push(h.loc)
        sites.push(h.site)
    dc_ev.push(DcEvent(kind, loc, loops, dc_branch > 0, locs, sites, site))

# An integer literal (through conversions), or none
dc_const = (e0: int) -> int?:
    e = e0
    loop e != 0 and nodes[e].kind == .conv: e = int(nodes[e].a)
    if e == 0 or nodes[e].kind != .int_lit or has_flag(e, NF_U64): return none
    nodes[e].ival

# How many times a loop's body runs: literal range bounds, else -1
dc_trip_count = (n: int) -> int:
    if nodes[n].kind != .for_: return -1
    r = int(nodes[n].a)
    if r == 0 or nodes[r].kind != .range or has_flag(r, NF_STEP) or has_flag(r, NF_EXCL_FIRST): return -1
    lo = dc_const(int(nodes[r].a))
    hi = dc_const(int(nodes[r].b))
    if lo == none or hi == none: return -1
    count = hi! - lo! + (if has_flag(r, NF_INCLUSIVE): 1 else: 0)
    if count < 0: return 0
    count

# Whether a task's result may be a failure (an exception other than Canceled, which only follows
# a cancellation, and Closed or a send's Unsent, which follow a close or one: those are drainers
# and fillers): the group's first failure cancels the rest, so a wait in it may end
dc_may_fail = (t: int) -> bool:
    loop m in value_members(t):
        if not exception_member(m) or m == T_NONE: continue
        if tkind(m) == .struct_:
            d = int(structs[int(types[m].st)].decl)
            nm = if d != 0: name_of(int(nodes[d].name)) else: ""
            if nm == "Canceled" or (nm == "Closed" or nm == "Unsent") and not dc_closes: continue
        return true
    false

dc_drop = (mark: int):
    loop dc_held.len() > mark: dc_held.pop()

dc_walk = (n: int):
    if n == 0 or dc_count > DC_EVENTS: return
    k = nodes[n].kind
    if k == .lambda or k == .fnref: return
    if k == .block:
        mark = dc_held.len()
        loop c in kids(n): dc_walk(c)
        if nodes[n].aux != 5: dc_drop(mark)
        return
    if k == .vardecl:
        init = int(nodes[n].b)
        loop init != 0 and nodes[init].kind == .conv: init = int(nodes[init].a)
        if init != 0 and nodes[init].kind == .call:
            what = dl_lock_call(init)
            if what == "lock" or what == "try_lock$acquire" or what == "__take":
                loc = dc_loc(dl_receiver(init))
                if what == "lock": dc_event(4, loc, nodes[init].pos)
                dc_held.push(DlHeld(loc, nodes[init].pos, int(nodes[n].sym)))
                return
        dc_walk(int(nodes[n].b))
        return
    if k == .if_ or k == .iflet:
        dc_walk(int(nodes[n].a))
        mark = dc_held.len()
        dc_branch += 1
        dc_walk(int(nodes[n].b))
        dc_drop(mark)
        dc_walk(int(nodes[n].c))
        dc_drop(mark)
        dc_branch -= 1
        return
    if k == .for_ or k == .while_:
        trips = dc_trip_count(n)
        if k == .for_: dc_walk(int(nodes[n].a))
        cond = int(nodes[n].a)
        # (a body that may not run: a loop on a condition, or an empty range)
        maybe = trips == 0 or trips < 0 and not (k == .while_ and nodes[cond].kind == .bool_lit and nodes[cond].ival == 1)
        dc_loops.push(dc_trips.len())
        dc_trips.push(trips)
        if maybe: dc_branch += 1
        if k == .while_: dc_walk(cond)
        mark = dc_held.len()
        dc_walk(int(nodes[n].b))
        dc_drop(mark)
        if maybe: dc_branch -= 1
        dc_loops.pop()
        return
    if k == .call:
        dc_call(n)
        return
    if k == .propagate or k == .parallel_region:
        dc_walk(int(nodes[n].a))
        return
    loop g in value_helper_calls(n): dc_enter(g, 0)
    branches = k == .match_ or k == .arm
    if branches: dc_branch += 1
    mask = isolation_children(k)
    if mask < 0:
        dc_walk(int(nodes[n].a))
        dc_walk(int(nodes[n].b))
        dc_walk(int(nodes[n].c))
        loop c in kids(n): dc_walk(c)
    else:
        if mask & 1 != 0: dc_walk(int(nodes[n].a))
        if mask & 2 != 0: dc_walk(int(nodes[n].b))
        if mask & 4 != 0: dc_walk(int(nodes[n].c))
        if mask & 16 != 0:
            mark = dc_held.len()
            loop c in kids(n):
                dc_walk(c)
                if branches: dc_drop(mark)
        if mask & 32 != 0:
            loop c in kids2(n): dc_walk(c)
    if branches: dc_branch -= 1

dc_call = (n: int):
    pos = nodes[n].pos
    what = dl_lock_call(n)
    if what == "__lock_all":
        words = kid(n, 1)
        if nodes[words].kind == .namedarg: words = int(nodes[words].a)
        loop c in kids(words):
            call = c
            loop nodes[call].kind == .conv: call = int(nodes[call].a)
            if nodes[call].kind == .call: dc_event(4, dc_loc(dl_receiver(call)), pos)
        return
    if ends_with(what, "$release"):
        if nkids(n) >= 2:
            g = kid(n, 1)
            if nodes[g].kind == .ident and nodes[g].sym > 0:
                loop i in [0..dc_held.len()):
                    if dc_held[i].guard == int(nodes[g].sym):
                        dc_held.remove(i)
                        break
        return
    if len(what) > 0: return
    op = dc_chan_call(n)
    if op > 0:
        loop i in [1..nkids(n)): dc_walk(kid(n, i))
        loc = dc_loc(kid(n, 0))
        if fns[int(nodes[n].sym)].mod == dc_smod: dc_ends[dl_key(loc)] = true
        if loc.root == 0 or not loc.exact or len(loc.route) > 0 or loc.root != 2 and loc.root != 1: dc_precise = false
        if op == 3: dc_closes = true
        if op == 6 or op == 7:
            dc_attempts[dl_key(loc)] = true
            if loc.root != 1 and loc.root != 2 or not loc.exact or len(loc.route) > 0: dc_unknown_attempt = true
        dc_event(op, loc, pos)
        return
    loop c in kids(n): dc_walk(c)
    if nodes[n].aux == 1 or nodes[n].aux == 4:
        # (a function value: what it waits for is not in view)
        dc_walk(int(nodes[n].a))
        dc_complete = false
        return
    if nodes[n].aux != 0 or nodes[n].sym <= 0: return
    g = int(nodes[n].sym)
    d = int(fns[g].decl)
    gname = if d != 0: name_of(int(nodes[d].name)) else: ""
    if gname == "__task_spawn" and nkids(n) == 2:
        h = dl_fn_arg(kid(n, 1))
        if h > 0 and fns[h].body != 0:
            if dc_pending.len() >= DC_ACTORS:
                dc_complete = false
                return
            ffns: int[]
            fcalls: int[]
            loop x in dc_ffns: ffns.push(x)
            loop x in dc_fcalls: fcalls.push(x)
            ffns.push(h)
            fcalls.push(0)
            dc_pending.push(DcSpawn(h, ffns, fcalls, dc_multi or dc_loops.len() > 0, dl_key(dc_loc(kid(n, 0))), pos))
        return
    if gname == "cancel" and pos_in_lib(nodes[d].pos): dc_cancels = true
    if gname == "cancel" and pos_in_lib(nodes[d].pos): dc_cancels = true
    if gname == "__task_join" and nkids(n) == 1:
        dc_event(5, dc_loc(kid(n, 0)), pos)
        return
    if fns[g].parallel_api: return
    # (a function given as a value to a call not walked here, as a library helper's)
    if not dl_relevant.has(g):
        loop c in kids(n):
            h = dl_fn_arg(c)
            if h > 0 and dl_relevant.has(h): dc_complete = false
        return
    dc_enter(g, n)

dc_enter = (g: int, n: int):
    if not dl_relevant.has(g) or fns[g].body == 0: return
    if dc_ffns.contains(g) or dc_ffns.len() > DC_DEPTH:
        dc_complete = false
        return
    dc_ffns.push(g)
    dc_fcalls.push(n)
    dc_walk(int(fns[g].body))
    dc_ffns.pop()
    dc_fcalls.pop()

# Every task's waits: the program's thread (top-level code, then main), then each task spawned,
# where it was spawned.
dc_collect = ():
    dc_ev = []
    loop f in init_fns + [main_fn]:
        if f <= 0 or not dl_relevant.has(f): continue
        dc_ffns = []
        dc_fcalls = []
        dc_enter(f, 0)
    dc_actors.push(DcActor(dc_ev, "the program's thread", false, "", 0))
    i = 0
    loop i < dc_pending.len():
        s = dc_pending[i]
        i += 1
        dc_ev = []
        dc_ffns = s.ffns
        dc_fcalls = s.fcalls
        dc_loops = []
        dc_held = []
        dc_branch = 0
        dc_multi = s.multi
        # Even a task with no waits can cancel its siblings by failing. Keep
        # its result summary, but demand a body walk only for relevant effects.
        if dl_relevant.has(s.h): dc_walk(int(fns[s.h].body))
        dc_actors.push(DcActor(dc_ev, "the task spawned at {dl_line(s.site)}", s.multi, s.group, int(fns[s.h].ret)))

# ---------------- what waits for what ----------------

# The capacity a channel was made with, when a literal, else -1
dc_capacity = (l: DlLoc) -> int:
    decl = 0
    if l.root == 2: decl = l.id
    else if l.root == 1: decl = int(globals[l.id].decl)
    if decl == 0 or len(l.route) > 0: return -1
    init = int(nodes[decl].b)
    loop init != 0 and nodes[init].kind == .conv: init = int(nodes[init].a)
    if init == 0 or nodes[init].kind != .call or nodes[init].aux != 0 or nodes[init].sym <= 0: return -1
    g = int(nodes[init].sym)
    if dc_split(init): return dc_spsc_capacity(ntype(kid(init, 0)))
    if fns[g].mod == dc_smod and name_of(int(nodes[int(fns[g].decl)].name)) == "spsc": return dc_spsc_capacity(ntype(init))
    if not dc_is(int(fns[g].mod)) or name_of(int(nodes[int(fns[g].decl)].name)) not in ["channel", "mpmc"] or nkids(init) != 1: return -1
    c = dc_const(kid(init, 0))
    if c == none: return -1
    c!

dc_spsc_capacity = (t: int) -> int:
    if tkind(t) != .struct_ or structs[int(types[t].st)].ntargs != 2: return -1
    known, values = int_intervals(struct_targ(int(types[t].st), 1))
    if known and values.len() == 2 and values[0] == values[1]: return values[0]
    -1

# How many times an event at loops ev runs before the first run of one at loops at (loops around
# both are in their first iteration): -1 when not literal
dc_mult = (ev: int[], at: int[]) -> int:
    k = 0
    loop k < ev.len() and k < at.len() and ev[k] == at[k]: k += 1
    m = 1
    loop i in [k..ev.len()):
        t = dc_trips[ev[i]]
        if t < 0: return -1
        m = min(m * t, 1 << 40)
    m

# Whether the sends into ch by actor a, those before event `upto` (all of event `upto`'s runs,
# when through), wait: 2 for certain, 1 perhaps, 0 never.
dc_send_waits = (a: int, ch: str, upto: int, through: bool) -> int:
    evs = dc_actors[a].events
    at: int[] = if through: [] else: evs[upto].loops
    sure = 0
    any = 0
    unknown = false
    last = if through: upto + 1 else: upto
    cap = -1
    loop j in [0..last):
        e = evs[j]
        if dl_key(e.loc) != ch or e.kind != 1 and e.kind != 2 and e.kind != 6 and e.kind != 7: continue
        cap = dc_capacity(e.loc)
        m = dc_mult(e.loops, at)
        if m < 0:
            unknown = true
            if e.kind == 2 or e.kind == 7: sure = 0
        else if e.kind == 1 or e.kind == 6:
            any += m
            if not e.branch:
                if e.kind == 1: sure += m
                # With the sole drainer still held up at its first receive, one
                # producer's attempts fill available slots but cannot overfill.
                else if dc_exclusive.get(ch, false) and cap >= 0: sure = min(cap, sure + m)
        else:
            sure = max(0, sure - m)
            if e.kind == 2 and not e.branch: any = max(0, any - m)
    if cap >= 0 and not unknown and any <= cap: return 0
    if cap >= 0 and sure > cap and dc_precise and dc_complete: return 2
    1

# Whether event j of actor a is the first receive from its channel
dc_first_receive = (a: int, j: int) -> bool:
    evs = dc_actors[a].events
    key = dl_key(evs[j].loc)
    loop i in [0..j):
        if evs[i].kind == 2 and dl_key(evs[i].loc) == key: return false
    true

# The node a wait (event j of actor a) waits for, and how it reads: ("", ...) when it does not
# wait, or not in a way a cycle can show
dc_wait_node = (a: int, j: int, upto: int, through: bool) -> (str, str, int):
    e = dc_actors[a].events[j]
    if e.loc.root == 0: return ("", "", 0)
    key = dl_key(e.loc)
    if e.kind == 1:
        w = dc_send_waits(a, key, upto, through)
        if w == 0: return ("", "", 0)
        cap = dc_capacity(e.loc)
        if w == 2: return ("S" + key, "sends more values into {dl_name(e.loc)} than the {cap} it holds ({dl_line(e.site)})", 2)
        return ("S" + key, "may wait to send into {dl_name(e.loc)} ({dl_line(e.site)})", 1)
    if e.kind == 2:
        if not dc_first_receive(a, j): return ("", "", 0)
        sure = if e.loc.exact and not dc_attempts.has(key): 2 else: 1
        return ("R" + key, "waits to receive from {dl_name(e.loc)} ({dl_line(e.site)})", sure)
    if e.kind == 4: return ("L" + key, "waits for the lock {dl_name(e.loc)} ({dl_line(e.site)})", if e.loc.exact: 2 else: 1)
    if e.kind == 5: return ("J" + key, "waits for the tasks it spawned ({dl_line(e.site)})", 2)
    ("", "", 0)

dc_add_edge = (src: str, dst: str, certain0: bool, text: str, site: int):
    # (that a holder is the only one, and that a count is all there is, needs every wait seen)
    certain = certain0 and dc_precise and dc_complete
    key = "{src}>{dst}"
    if let i = dc_edge_at.get(key):
        if certain and not dc_edges[i].certain: dc_edges[i] = DcEdge(src, dst, certain, text, site)
        return
    dc_edge_at[key] = dc_edges.len()
    dc_edges.push(DcEdge(src, dst, certain, text, site))

# The waits of actor a before event i (or through it) as edges from the node it holds
dc_hold = (a: int, node: str, i: int, through: bool, how: str, ends: bool = false):
    evs = dc_actors[a].events
    last = if through: i + 1 else: i
    loop j in [0..last):
        up = if through: j else: i
        w, text, sure = dc_wait_node(a, j, up, through)
        if len(w) == 0: continue
        dc_add_edge(node, w, sure == 2 and not ends, "{dc_actors[a].name} {text}{how}", evs[j].site)

dc_edges_build = ():
    # Demand one indexed cancellation summary per collected group. O(actors
    # plus result members), then O(1) per join or no-peer wait.
    dc_cancelable_groups.clear()
    loop actor in dc_actors:
        if actor.ret != 0 and dc_may_fail(actor.ret): dc_cancelable_groups[actor.group] = true
    # (each channel's drainers and fillers, by spawn site)
    drainers: {str: int[]} = {}
    fillers: {str: int[]} = {}
    loop a in [0..dc_actors.len()):
        loop e in dc_actors[a].events:
            if e.kind == 4 or e.kind == 5 or e.loc.root == 0: continue
            key = dl_key(e.loc)
            if e.kind == 2 or e.kind == 3 or e.kind == 7:
                list = drainers.get(key) ?? []
                if not list.contains(a): list.push(a)
                drainers[key] = list
            if e.kind == 1 or e.kind == 3 or e.kind == 6:
                list = fillers.get(key) ?? []
                if not list.contains(a): list.push(a)
                fillers[key] = list
    loop key, writers in fillers:
        readers = drainers.get(key) ?? []
        if writers.len() == 1 and readers.len() == 1 and not dc_actors[writers[0]].multi and not dc_actors[readers[0]].multi: dc_exclusive[key] = true
    loop actor in dc_actors:
        loop e in actor.events:
            if e.kind == 3 or e.kind == 7: dc_exclusive.remove(dl_key(e.loc))
    loop a in [0..dc_actors.len()):
        evs = dc_actors[a].events
        seen_drain: {str: bool} = {}
        seen_fill: {str: bool} = {}
        tried_drain: {str: bool} = {}
        loop i in [0..evs.len()):
            e = evs[i]
            if (e.kind <= 3 or e.kind == 6 or e.kind == 7) and e.loc.root != 0:
                key = dl_key(e.loc)
                # (the only drainer keeps the channel full until its first receive or close)
                if (e.kind == 2 or e.kind == 3 or e.kind == 7) and not seen_drain.has(key):
                    if e.kind != 7: seen_drain[key] = true
                    if (drainers.get(key) ?? []).len() == 1:
                        verb = if e.kind == 2 or e.kind == 7: "receives from" else: "closes"
                        dc_hold(a, "S" + key, i, false, " before it {verb} {dl_name(e.loc)} ({dl_line(e.site)})", tried_drain.has(key))
                    if e.kind == 7: tried_drain[key] = true
                # (the only filler keeps it empty until its first send or close)
                if (e.kind == 1 or e.kind == 3 or e.kind == 6) and not seen_fill.has(key):
                    if e.kind != 6: seen_fill[key] = true
                    if (fillers.get(key) ?? []).len() == 1:
                        verb = if e.kind == 1 or e.kind == 6: "sends into" else: "closes"
                        dc_hold(a, "R" + key, i, false, " before it {verb} {dl_name(e.loc)} ({dl_line(e.site)})")
            # (a wait while holding a lock)
            if e.held.len() > 0 and e.kind != 3 and e.kind != 4:
                w, text, sure = dc_wait_node(a, i, i, true)
                if len(w) > 0:
                    loop h in [0..e.held.len()):
                        if e.held[h].root == 0: continue
                        dc_add_edge("L" + dl_key(e.held[h]), w, sure == 2 and e.held[h].exact, "{dc_actors[a].name} {text} while holding {dl_name(e.held[h])} (since {dl_line(e.held_sites[h])})", e.site)
        # (a spawned task holds its group's join until it ends)
        if len(dc_actors[a].group) > 0 and evs.len() > 0:
            dc_hold(a, "J" + dc_actors[a].group, evs.len() - 1, true, ", and the join of its group{dc_join_line(dc_actors[a].group)} waits for it", dc_cancelable(dc_actors[a].group))
        # (what nothing drains or fills waits forever)
        loop i in [0..evs.len()):
            e = evs[i]
            if e.kind > 2 or e.loc.root == 0: continue
            key = dl_key(e.loc)
            other = if e.kind == 1: drainers else: fillers
            if other.has(key): continue
            w, text, sure = dc_wait_node(a, i, i, true)
            if len(w) == 0: continue
            what = if e.kind == 1: "nothing receives from it or closes it" else: "nothing sends into it or closes it"
            # An end passed on to a task/helper may close there without an
            # explicit queue verb. Absence of a verb is not absence of a closer.
            implicit = dc_ends.has(key)
            canceled = dc_cancelable(dc_actors[a].group)
            if sure == 2 and dc_precise and dc_complete and not implicit and not canceled: fatal(e.site, "{dc_actors[a].name} {text}, and {what}: it waits forever")
            if implicit: what = "no explicit peer operation was found (an owned end may close on drop)"
            if canceled: what += " (group cancellation may end the wait)"
            if dl_report_warn(e.site): dl_undecided(e.site, "{dc_actors[a].name} {text}, and {what}: it may wait forever")
    # (stage 1's lock order: one lock taken while holding another)
    loop e in dl_global_edges:
        dc_add_edge("L" + dl_key(e.held), "L" + dl_key(e.taken), dl_must(e.held, e.held) and dl_must(e.taken, e.taken), dl_path(e), e.taken_site)

# Whether a group may be canceled while its join waits (a task's failure, or a cancel by hand):
# then its waits may end, and a cycle through the join is undecided
dc_cancelable = (group: str) -> bool:
    dc_cancels or dc_cancelable_groups.has(group)

# " at line N" of a group's join
dc_join_line = (group: str) -> str:
    loop actor in dc_actors:
        loop e in actor.events:
            if e.kind == 5 and dl_key(e.loc) == group: return " at {dl_line(e.site)}"
    ""

dc_warned: {int: bool} = {}
dl_report_warn = (site: int) -> bool:
    if dc_warned.has(site): return false
    dc_warned[site] = true
    true

# A cycle through a channel or join node, among the certain edges (an error), or else among all
# (a warning). Breadth-first from each such node's edges back to it.
dc_cycles = ():
    out: {str: int[]} = {}
    loop i in [0..dc_edges.len()):
        list = out.get(dc_edges[i].src) ?? []
        list.push(i)
        out[dc_edges[i].src] = list
    loop round in [0..2):
        sure = round == 0
        starts: str[]
        loop i in [0..dc_edges.len()):
            s = dc_edges[i].src
            if not starts_with(s, "L") and not starts.contains(s): starts.push(s)
        loop s in starts:
            prev: {str: int} = {}
            queue: str[] = [s]
            q = 0
            found = false
            loop q < queue.len() and not found:
                v = queue[q]
                q += 1
                loop j in out.get(v) ?? []:
                    if sure and not dc_edges[j].certain: continue
                    w = dc_edges[j].dst
                    if prev.has(w): continue
                    prev[w] = j
                    if w == s:
                        found = true
                        break
                    queue.push(w)
            if not found: continue
            path: int[]
            v = s
            loop true:
                j = prev[v]
                path.insert(0, j)
                v = dc_edges[j].src
                if v == s: break
            dc_report(path, sure)
            return

dc_report = (path: int[], sure: bool):
    texts: str[]
    loop j in path: texts.push(dc_edges[j].text)
    first = dc_edges[path[0]]
    fix = "Receive before sending more than a channel holds, give the channel room for what is sent first, or let a lock's place end before a channel wait"
    undecided = " (the compiler cannot tell whether every wait does: a count or capacity that is not literal, a group that a failure or a cancel may end, or a channel or task it cannot follow)"
    if path.len() == 1:
        if sure: fatal(first.site, "{first.text}: it waits for itself forever. {fix}")
        dl_undecided(first.site, "{first.text}: it may wait for itself forever{undecided}")
        return
    msg = "bounded channel cycle: " + join(texts, "; ") + ". Each waits for the next"
    if sure:
        loop k in [1..path.len()): err_notes.push((dc_edges[path[k]].site, "note: {dc_edges[path[k]].text}"))
        fatal(first.site, "{msg}, so none goes on: the program waits forever. {fix}")
    sites: int[]
    loop j in path: sites.push(dc_edges[j].site)
    dl_undecided(first.site, "{msg}, so they may wait forever{undecided}", sites)

dc_analyze = ():
    dc_collect()
    dc_edges_build()
    dc_cycles()
    # An attempt is neither a wait nor a promise to unblock another task. The
    # prefix graph cannot certify its outcome (Busy/Full/Empty, branches, loops,
    # other actors); retain an explicit unresolved-wait diagnostic even when no
    # first-operation cycle represents the later occupancy. Never silently use
    # an attempt as evidence that a later blocking operation will complete.
    loop actor in dc_actors:
        loop e in actor.events:
            if e.kind != 1 and e.kind != 2: continue
            if (e.loc.root != 1 and e.loc.root != 2 or not e.loc.exact or len(e.loc.route) > 0) and dl_report_warn(e.site):
                dl_undecided(e.site, "queue wait with an unresolved queue identity: the compiler cannot follow its peer; it may wait forever")
            if (dc_unknown_attempt or dc_attempts.has(dl_key(e.loc))) and dl_report_warn(e.site):
                dl_undecided(e.site, "queue wait on {dl_name(e.loc)} after non-waiting attempts: the compiler cannot prove the queue's occupancy or that an attempt succeeds; it may wait forever")

# ---------------- `$no_deadlocks`: certificates ----------------
# In a scope under `$no_deadlocks` (docs/design/safety_and_concurrency.md, "Certificates"), every
# wait needs a certificate, or it is an error naming the wait and what is missing:
#   - a lock wait: the checked lock order (stage 1 above, whose undecided cases are errors here:
#     dl_undecided), with every lock named;
#   - a join (the end of `concurrent`, `within`, `race`): structured, its tasks' functions in view
#     and their waits certified, no lock held across it;
#   - a certified protocol of the library (lib/prelude/protocols.dewy: `request`, `serve`,
#     `pipeline`), with no lock held across it, and a `serve` handler that asks no service;
#   - a foreign call that may block: only inside an audited adapter (`$audited_wait`).
# Uncertified everywhere: a raw channel wait, polling an atomic (an event no certificate covers),
# a function value the compiler cannot follow, a lock held across any wait but another lock, and
# a wait in a lifecycle hook (cleanup runs at exits the order and the joins do not see). What waits
# only on the outside world (I/O, sleep) is not a wait on a task (the theorem's third assumption).
#
# Summaries. A function's summary (what kinds of waits it may make, transitively, and its first
# uncertified one) is built by one walk of its body, with the locks held; calls fold the callee's
# summary in, functions given as arguments count as called at the call (with the locks held), and
# spawned functions count where they are spawned (holding nothing). Recursion: the walk keeps a
# path, and a strongly connected set of functions shares its root's summary (Tarjan's low links),
# a call into the set while holding a lock being uncertified. A wait no certificate covers is
# reported where it is, if that site is under `$no_deadlocks`, or at the first call into it from
# such a site.
#
# Demand and cost: nothing runs unless some scope sets `$no_deadlocks`. Then every function of the
# files that set it is walked once, and the functions they reach once each: O(N + E) over the nodes
# and calls walked.

const ND_LOCK = 1                # takes a lock (the checked order covers it)
const ND_WAIT = 2                # waits on another task otherwise (a join, a protocol, a channel)
const ND_ASK = 4                 # asks a service
const ND_BAD = 8                 # makes a wait no certificate covers

struct NdSum:
    flags: int
    bad: str                     # the first uncertified wait, as it reads after "this"
    bad_site: int
    wait: str                    # the first wait on another task, the same way
    wait_site: int
    ask_site: int                # the first request to a service

nd_sums: {int: NdSum}
nd_index: {int: int}             # a function being summarized -> its place on nd_path
nd_path: int[]
nd_low = 0
nd_stack: NdSum[]                # the summaries being built, innermost last
nd_fns: int[]                    # the functions being walked, innermost last

# Certificate execution lives in deadlock_certificates.dewy.

use 'deadlock_locations.dewy'
use 'deadlock_summaries.dewy'
use 'deadlock_walk.dewy'
use 'deadlock_waits.dewy'
use 'deadlock_graph.dewy'
use 'deadlock_certificates.dewy'

$runtime_checks
# Handle validity (docs/design/proposals/handles/round1.md): `h in? c` is a
# membership atom, an opaque fact over the values of c and h whose meaning is
# c's `contains(c h)`. The atom is the element projection of c's value at h's
# value, at least 1 while h is a member: the bundled Pool's model
# (facts_pools.dewy) uses the same representation, so a Pool's add, remove,
# `has` and `[]` and an `in?` on it are one fact.
#
# A `contains` whose body is one membership of projections of its parameters,
# `contains = (w:World b:Body):>bool => b.h in? w.bodies`, delegates: its atom
# is the inner one, on `w.bodies` at `b.h`, so what keeps or removes Pool
# members keeps or removes the World's, and a write to `w.gravity` keeps it.
#
# Everything here is demanded: a `contains` call in a static fact pass, or an
# `<(in? c)>` refinement (refine_transfers). Costs: recognizing a callee is
# O(1) after its first visit (cached per function); a delegation is read once
# per `contains` from at most 16 body nodes; an atom is at most 4 delegation
# steps of O(path) projections; finding the `contains` a refinement means by
# its types scans each function once over the compilation (an indexed list of
# the functions named `contains`), then O(1) per (container, handle) type pair.
from p"expression_types.dewy" import (ntype)
from p"ast.jo" import (kid kid_c kid_d nkids nodes)
from p"check.jo" import (LF_ALIAS LF_BYREF LF_CAPTURE LF_ELEMALIAS LF_MUTPARAM LF_OWNERBORROW LF_PARTBORROW LF_SOAELEM LF_SOAMUT LF_VALUEPARAM fns locals)
from p"expr.jo" import (IN)
from p"place_routes.dewy" import (place_path place_route)
from p"facts_projection_queries.dewy" import (fact_projection_after fact_projection_find fact_projection_first)
from p"facts_summaries.dewy" import (fact_summary_actual)
from p"directive_rules.dewy" import (dir_defer)
from p"effect_control.dewy" import (effects_demand)
from p"effect_lattice.dewy" import (place_base)
from p"effects.jo" import (effect_summaries)
from p"checks_thin_expr.dewy" import (is_map_type)
from p"facts.jo" import (FACT_CAP FactProjection FactState fact_terms)
from p"facts_values.dewy" import (fact_domain fact_type fact_project)
from p"facts_index_writes.dewy" import (fact_add_projection fact_constant fact_new fact_set_bound)
from p"facts_compare.dewy" import (fact_assume)
from p"facts_value_queries.dewy" import (fact_bound)
from p"facts_pools.dewy" import (fact_pool_keep fact_pool_rank fact_pool_type)
from p"predicate_summaries.dewy" import (fact_predicate_apply fact_predicate_summary)
from p"refinement_types.dewy" import (FactBound FactTerm RefAtom)
from p"types.jo" import (T_BOOL T_INT fields prune structs tkind types)
from p"util.jo" import (err_notes intern name_of pos_in_lib)
from p"witness_nodes.dewy" import (wit_text)
from p"witness_ops.dewy" import (wit_context wit_fail)

MemWord:type=int64<overflow='wrap'>

# A parameter of a `contains` and the fields read from it, with each field's type.
MemPath:type=[param:int64=-1 path:array<int64>=[] types:array<int64>=[]]
# A delegating `contains`: the membership it is, and its two operands.
MemDelegate:type=[callee:int64=0 container:MemPath=MemPath[] handle:MemPath=MemPath[]]

# (per function: 1 a membership `contains`, 2 not one; a pure one also 3 when
# its effects were read: 3 pure, 4 not)
let mem_kinds:dict<int64 int64>=dict<int64 int64>()
let mem_delegates:dict<int64 MemDelegate>=dict<int64 MemDelegate>()
let mem_name:int64=0
# (the functions named `contains`, scanned up to mem_scanned, and the answer per type pair)
let mem_named:array<int64>=[]
let mem_scanned:int64=0
let mem_by_types:dict<[int64 int64] int64>=dict<[int64 int64] int64>()

const MEM_KEEPS:int64=1
const MEM_UNLESS:int64=2
const MEM_FORGETS:int64=3
MemEffect:type=[kind:int64=3 key:MemPath=MemPath[]]
let mem_demanded:bool=false
# (the call whose arguments' values before its effects mem_after_call kept, for its result)
let mem_last_call:int64=0
let mem_last_before:array<int64>=[]
let mem_summaries:dict<string MemEffect>=dict<string MemEffect>()
let mem_busy:dict<string bool>=dict<string bool>()
let mem_fresh:dict<int64 MemPath>=dict<int64 MemPath>()
let mem_pool_words:array<int64>=[]
let mem_holders:dict<int64 bool>=dict<int64 bool>()


mem_reset=():>void=>{
    mem_kinds=dict<int64 int64>()
    mem_delegates=dict<int64 MemDelegate>()
    mem_named=[]
    mem_scanned=0
    mem_by_types=dict<[int64 int64] int64>()
    mem_clear_summaries()
}

# A record type's identity for matching (an instance's struct), or the pruned type.
mem_type_key=(t0:MemWord):>MemWord=>$unsafe {
    let t=fact_type(t0)
    if types.ptr[t].kind =? 'struct_' {return MemWord(types.ptr[t].st) + (1 << 40)}
    t
}

# Whether f is a membership `contains(c h):>bool`: two by-value parameters, no
# captures, the container a record (not a dictionary, whose keys keep their own
# rules). O(parameters), once per function.
mem_contains_fn=(f:MemWord):>bool=>$unsafe {
    if f <=? 0 or f >=? fns.length {return false}
    let known=mem_kinds.get(f) ?? 0
    if known not=? 0 {return known not=? 2}
    let d=MemWord(fns.ptr[f].decl)
    if mem_name =? 0 {mem_name=intern("contains")}
    let ok=d not=? 0 and MemWord(nodes.ptr[d].name) =? mem_name and fns.ptr[f].params.length =? 2 and fns.ptr[f].ptypes.length =? 2 and fns.ptr[f].caps.length =? 0 and prune(MemWord(fns.ptr[f].ret)) =? T_BOOL
    if ok {
        loop l in fns.ptr[f].params {
            if MemWord(locals.ptr[l].flags) & LF_MUTPARAM not=? 0 {ok=false}
        }
        let ct=fact_type(fns.ptr[f].ptypes[0])
        if types.ptr[ct].kind not=? 'struct_' or is_map_type(ct) {ok=false}
    }
    mem_kinds[f]=if ok {1} else {2}
    ok
}

# Whether call n is one of a membership `contains`, for the fact slice: O(1),
# an interned name test before the cached one.
mem_call=(n:MemWord):>bool=>$unsafe {
    if nodes.ptr[n].kind not=? 'call' or nodes.ptr[n].aux not=? 0 or nodes.ptr[n].sym <=? 0 or nkids(n) not=? 2 {return false}
    let f=MemWord(nodes.ptr[n].sym)
    let d=MemWord(fns.ptr[f].decl)
    if mem_name =? 0 {mem_name=intern("contains")}
    d not=? 0 and MemWord(nodes.ptr[d].name) =? mem_name and mem_contains_fn(f)
}

# Whether a membership `contains` is a function of its two values alone: it
# writes nothing, does no I/O and reads no global (its settled effect row).
# A delegating one is as pure as its delegate; the bundled Pool's is reviewed
# (docs/design/assumptions.md). O(events), once per function.
mem_pure=(f:MemWord):>bool=>$unsafe {
    let known=mem_kinds.get(f) ?? 0
    if known >=? 3 {return known =? 3}
    if fns.ptr[f].body =? 0 or fns.ptr[f].state not=? 2 or not effects_demand(f true) {return false}
    let ok=true
    loop e in effect_summaries.ptr[f].events {
        let kind=e.atom.kind
        if kind =? 'read' {
            if place_base(e.atom.place).root =? 'global' {ok=false}
        }
        else if kind not=? 'alloc' and kind not=? 'panic' {ok=false}
    }
    mem_kinds[f]=if ok {3} else {4}
    ok
}

# An operand of a delegation: fields read from a parameter, or from a local
# bound once to such a read. O(path), at most 16 steps.
mem_path=(e0:MemWord params:dict<int64 int64> env:dict<int64 MemPath>):>MemPath=>$unsafe {
    let e=e0
    let names:array<int64>=[]
    let tys:array<int64>=[]
    loop _ in [0..16) {
        if e <=? 0 {return MemPath[]}
        let k=nodes.ptr[e].kind
        if k =? 'addr' {
            e=MemWord(nodes.ptr[e].a)
            continue
        }
        if k =? 'field' {
            names.push(MemWord(nodes.ptr[e].name))
            tys.push(ntype(e))
            e=MemWord(nodes.ptr[e].a)
            continue
        }
        if k =? 'ident' and nodes.ptr[e].aux =? 1 {
            let l=MemWord(nodes.ptr[e].sym)
            let out=MemPath[]
            if params.has(l) {out.param=params[l]}
            else if env.has(l) {out=env[l]}
            else {return MemPath[]}
            loop i in [0..names.length) {
                out.path.push(names[names.length - 1 - i])
                out.types.push(tys[tys.length - 1 - i])
            }
            return out
        }
        return MemPath[]
    }
    MemPath[]
}

# The membership a `contains` is, when its body is one: `b.h in? w.bodies`,
# `w.bodies.has(b.h)` or `contains(w.bodies b.h)`, maybe after `let`s naming
# field reads. callee 0 for none. Once per function, at most 16 statements.
mem_delegate=(f:MemWord):>MemDelegate=>$unsafe {
    let known=mem_delegates.get(f)
    if known not=? none {return known}
    let none_=MemDelegate[]
    if fns.ptr[f].body =? 0 or fns.ptr[f].state not=? 2 {return none_}
    mem_delegates[f]=none_
    let params=dict<int64 int64>()
    loop i in 0.. and l in fns.ptr[f].params {params[l]=i}
    let env=dict<int64 MemPath>()
    let e=MemWord(fns.ptr[f].body)
    loop _ in [0..16) {
        if e <=? 0 {return none_}
        let k=nodes.ptr[e].kind
        if k =? 'return_' or k =? 'exprstmt' {
            e=MemWord(nodes.ptr[e].a)
            continue
        }
        if k =? 'block' {
            if nkids(e) =? 0 {return none_}
            loop i in [0..nkids(e) - 1) {
                let c=kid(e i)
                if nodes.ptr[c].kind not=? 'vardecl' or nkids(c) not=? 0 or nodes.ptr[c].b =? 0 {return none_}
                let p=mem_path(MemWord(nodes.ptr[c].b) params env)
                if p.param <? 0 {return none_}
                env[MemWord(nodes.ptr[c].sym)]=p
            }
            e=kid(e nkids(e) - 1)
            continue
        }
        break
    }
    if e <=? 0 or nodes.ptr[e].kind not=? 'call' or nodes.ptr[e].aux not=? 0 or nodes.ptr[e].sym <=? 0 or nkids(e) not=? 2 {return none_}
    let g=MemWord(nodes.ptr[e].sym)
    let first=if fns.ptr[g].ptypes.length >? 0 {MemWord(fns.ptr[g].ptypes[0])} else {0}
    let inner=mem_contains_fn(g) or fns.ptr[g].decl not=? 0 and fact_pool_type(first) and name_of(MemWord(nodes.ptr[MemWord(fns.ptr[g].decl)].name)) =? "has"
    if not inner {return none_}
    let c=mem_path(kid(e 0) params env)
    let h=mem_path(kid(e 1) params env)
    if c.param <? 0 or h.param <? 0 {return none_}
    let out=MemDelegate[g c h]
    mem_delegates[f]=out
    out
}

mem_follow=(@s:FactState p:MemPath c:MemWord h:MemWord):>MemWord=>{
    let v=if p.param =? 0 {c} else {h}
    loop i in [0..p.path.length) {
        if v =? 0 {return 0}
        v=fact_project(@s v p.path[i] false p.types[i])
    }
    v
}

# The atom `h in? c` for the membership function f (0 when f is unknown: an
# opaque atom on the two values). Delegations are followed at most 4 deep.
mem_atom=(@s:FactState f0:MemWord c0:MemWord h0:MemWord):>MemWord=>$unsafe {
    let f=f0
    let c=c0
    let h=h0
    loop depth in [0..4) {
        if c =? 0 or h =? 0 {return 0}
        if f =? 0 {break}
        let d=mem_delegate(f)
        if d.callee =? 0 {break}
        let c2=mem_follow(@s d.container c h)
        let h2=mem_follow(@s d.handle c h)
        c=c2
        h=h2
        f=d.callee
    }
    if c =? 0 or h =? 0 {return 0}
    mem_demanded=true
    fact_project(@s c h true T_INT)
}

# The value of a call of the membership `contains` f: true exactly when the
# atom is at least 1. A predicate summary of its body (predicate_summaries)
# also holds on the true edge. A `contains` that may read more than its two
# values gives no atom. O(atom).
mem_capture=(n:MemWord @s:FactState values:array<int64> f:MemWord):>MemWord=>{
    if values.length not=? 2 {return 0}
    let d=mem_delegate(f)
    if d.callee =? 0 and not fact_pool_type(fact_terms[values[0]].type) and not mem_pure(f) {return 0}
    let atom=mem_atom(@s f values[0] values[1])
    if atom =? 0 {return 0}
    let member=fact_new(@s fact_domain(T_BOOL) FactTerm('gt' atom fact_constant(@s 0)))
    let predicate=fact_predicate_summary(f)
    if predicate =? 0 {return member}
    let unfolded=fact_predicate_apply(predicate values @s)
    if unfolded =? 0 {return member}
    fact_new(@s fact_domain(T_BOOL) FactTerm('kw_and' member unfolded))
}

# The `contains` for a container and handle type: the one function named
# `contains` taking exactly them. 0 when none (or several). Indexed: each
# function is looked at once in a compilation.
mem_find=(ct:MemWord ht:MemWord):>MemWord=>$unsafe {
    let ck=mem_type_key(ct)
    let hk=mem_type_key(ht)
    if mem_scanned =? fns.length {
        let known=mem_by_types.get([ck hk])
        if known not=? none {return known}
    }
    if mem_name =? 0 {mem_name=intern("contains")}
    loop mem_scanned <? fns.length {
        let d=MemWord(fns.ptr[mem_scanned].decl)
        if d not=? 0 and MemWord(nodes.ptr[d].name) =? mem_name {mem_named.push(mem_scanned)}
        mem_scanned += 1
    }
    let found:MemWord=0
    loop f in mem_named {
        if not mem_contains_fn(f) {continue}
        if mem_type_key(fns.ptr[f].ptypes[0]) =? ck and mem_type_key(fns.ptr[f].ptypes[1]) =? hk {
            if found not=? 0 and found not=? f {
                found=0
                break
            }
            found=f
        }
    }
    mem_by_types[[ck hk]]=found
    found
}

# The atom a refinement `<(in? c)>` on a value h names. O(atom).
mem_refined_atom=(@s:FactState h:MemWord c:MemWord base:MemWord):>MemWord=>$unsafe {
    if h =? 0 or c =? 0 {return 0}
    mem_atom(@s mem_find(fact_terms[c].type base) c h)
}

# A refinement assumed: the atom is at least 1, and the body of the container's
# `contains` holds as facts (its predicate summary), so its own indexing proves.
mem_assume=(@s:FactState h:MemWord c:MemWord base:MemWord):>void=>$unsafe {
    let atom=mem_refined_atom(@s h c base)
    if atom =? 0 {return}
    fact_assume(@s fact_new(@s fact_domain(T_BOOL) FactTerm('gt' atom fact_constant(@s 0))) true)
    let f=mem_find(fact_terms[c].type base)
    if f =? 0 {return}
    let predicate=fact_predicate_summary(f)
    if predicate =? 0 {return}
    let unfolded=fact_predicate_apply(predicate [c h] @s)
    if unfolded not=? 0 {fact_assume(@s unfolded true)}
}

# 1 proven, 0 refuted, -1 unknown.
mem_truth=(@s:FactState h:MemWord c:MemWord base:MemWord):>MemWord=>{
    let atom=mem_refined_atom(@s h c base)
    if atom =? 0 {return -1}
    let b=fact_bound(s atom)
    if b.wide {return -1}
    if b.lo >=? 1 {return 1}
    if b.hi <=? 0 {return 0}
    -1
}

# An unproven or refuted membership at check n (the converted value is n's
# operand), named by the handle and the container as written (round1 §4.7).
mem_fail=(n:MemWord container:string refuted:bool):>void=>$unsafe {
    let h=wit_text(MemWord(nodes.ptr[n].a))
    let named=h not=? "" and container not=? ""
    let shown=if h not=? "" {"`{h}`"} else {"this value"}
    let c=if container not=? "" {"`{container}`"} else {"its container"}
    wit_context(0)
    if refuted {
        if named {err_notes.push([(-1) "help: `{container}.get({h})` gives none for a missing one"])}
        wit_fail(nodes.ptr[n].pos "{shown} is no longer in {c}")
        return
    }
    let what="cannot prove {shown} is in {c}"
    if dir_defer(n what true) {return}
    if named {err_notes.push([(-1) "help: test it with `if {h} in? {container}`, require it with a `<(in? {container})>` parameter, or take it as a value with `{container}.get({h})`"])}
    else {err_notes.push([(-1) "help: name it and test it with `in?`, or require it with a `<(in? ...)>` parameter"])}
    wit_fail(nodes.ptr[n].pos what)
}

# ---------------- membership summaries (round1 §4.4-4.5) ----------------
# A call taking `@c` forgets c's members unless its summary keeps them. A
# summary is computed on demand, only at a call where the caller holds a
# membership on a value the call writes, and cached per (callee, parameter,
# path to the container in it). Two steps, each bounded:
#  1. region prefilter, O(events): no settled write of the callee reaches the
#     container's membership tables (for a Pool, writes to `items` and
#     `handles` only, which `contains` does not read) keeps every member;
#  2. otherwise one walk of the callee's body, at most 4096 nodes, reading what
#     each write is: a Pool's `add` or `[]=` keeps, its `remove(k)` keeps
#     every member whose key differs from k's, a call passes the question to
#     its callee's summary (at most 4 deep; a cycle forgets), and anything
#     else (another write, an alias, a callback) forgets.
# A callee whose result is a Pool's `add` on a parameter's container (as the
# whole result or a record field of it) also gives a fresh member: one whose
# key differs from every earlier member's, as Pool's own `add` does.

# The caller holds memberships: summaries may be asked for. O(1).
mem_note=():>void=>{mem_demanded=true}
mem_wanted=():>bool=>mem_demanded

mem_clear_summaries=():>void=>{
    mem_demanded=false
    mem_last_call=0
    mem_last_before=[]
    mem_summaries=dict<string MemEffect>()
    mem_busy=dict<string bool>()
    mem_fresh=dict<int64 MemPath>()
    mem_holders=dict<int64 bool>()
}

mem_words=():>array<int64>=>{
    if mem_pool_words.length =? 0 {mem_pool_words=[intern("add") intern("[]=") intern("remove") intern("items") intern("handles")]}
    mem_pool_words
}

mem_starts=(a:array<int64> prefix:array<int64>):>bool=>{
    if a.length <? prefix.length {return false}
    loop i in [0..prefix.length) {
        if a[i] not=? prefix[i] {return false}
    }
    true
}
mem_overlap=(a:array<int64> b:array<int64>):>bool=>mem_starts(a b) or mem_starts(b a)

# A write at `written` leaves a Pool at `path` with its members: inside its
# public `items` or `handles`. O(path).
mem_public=(written:array<int64> path:array<int64> pool:bool):>bool=>{
    if not pool or written.length <=? path.length or not mem_starts(written path) {return false}
    let w=mem_words()
    written[path.length] =? w[3] or written[path.length] =? w[4]
}

# What expression e of f's body names: a parameter (with a path), -1 a local
# of f's own that aliases nothing, -2 unknown. An element of an array names
# the array (a write to it writes the array). O(path).
mem_root=(f:MemWord e0:MemWord):>MemPath=>$unsafe {
    let e=e0
    let names:array<int64>=[]
    loop _ in [0..32) {
        let k=nodes.ptr[e].kind
        if k =? 'addr' or k =? 'conv' {e=MemWord(nodes.ptr[e].a)}
        else if k =? 'index' {
            names=[]
            e=MemWord(nodes.ptr[e].a)
        }
        else if k =? 'field' and tkind(ntype(MemWord(nodes.ptr[e].a))) =? 'struct_' and nodes.ptr[e].aux >=? 0 {
            names.push(MemWord(nodes.ptr[e].name))
            e=MemWord(nodes.ptr[e].a)
        }
        else {break}
    }
    if nodes.ptr[e].kind not=? 'ident' {return MemPath[param=-2]}
    let out=mem_root_ident(f e)
    if out.param >=? 0 {
        loop j in [0..names.length) {out.path.push(names[names.length - 1 - j])}
    }
    out
}
mem_root_ident=(f:MemWord e:MemWord):>MemPath=>$unsafe {
    let r=place_route(e)
    if r.root not=? 'local' or r.declaration =? 0 {return MemPath[param=-2]}
    let l=r.declaration
    let value_param=MemWord(locals.ptr[l].flags) & LF_VALUEPARAM not=? 0
    loop i in 0.. and p in fns.ptr[f].params {
        # (a by-value parameter's own binding is its parameter: the local of the same name)
        if p =? l or value_param and locals.ptr[p].name =? locals.ptr[l].name {return MemPath[i place_path(r) []]}
    }
    let shared=LF_ELEMALIAS | LF_BYREF | LF_SOAELEM | LF_SOAMUT | LF_CAPTURE | LF_ALIAS | LF_PARTBORROW | LF_OWNERBORROW
    if MemWord(locals.ptr[l].flags) & shared not=? 0 or MemWord(locals.ptr[l].owner) not=? f {return MemPath[param=-2]}
    MemPath[param=-1]
}

mem_join=(a:MemEffect b:MemEffect):>MemEffect=>{
    if a.kind =? MEM_FORGETS or b.kind =? MEM_FORGETS {return MemEffect[]}
    if a.kind =? MEM_UNLESS and b.kind =? MEM_UNLESS {
        if a.key.param =? b.key.param and a.key.path =? b.key.path {return a}
        return MemEffect[]
    }
    if a.kind =? MEM_UNLESS {return a}
    b
}

# A by-value parameter's projection, the key a removal names; param -2 when not one.
mem_key=(f:MemWord e:MemWord):>MemPath=>$unsafe {
    let k=mem_root(f e)
    if k.param <? 0 {return MemPath[param=-2]}
    if MemWord(locals.ptr[fns.ptr[f].params[k.param]].flags) & LF_MUTPARAM not=? 0 {return MemPath[param=-2]}
    k
}

mem_pool_fn=(g:MemWord):>bool=>$unsafe {
    let d=MemWord(fns.ptr[g].decl)
    d not=? 0 and fns.ptr[g].ptypes.length >? 0 and fact_pool_type(fns.ptr[g].ptypes[0]) and pos_in_lib(nodes.ptr[d].pos)
}

# The effect of call e (of g, in f's body) whose argument j is f's parameter
# i at `written`, on the container at `path` of it.
mem_call_effect=(f:MemWord e:MemWord g:MemWord j:MemWord written:array<int64> path:array<int64> pool:bool depth:MemWord):>MemEffect=>$unsafe {
    if mem_pool_fn(g) and j =? 0 {
        if written not=? path {return MemEffect[]}
        let w=mem_words()
        let name=MemWord(nodes.ptr[MemWord(fns.ptr[g].decl)].name)
        if name =? w[0] or name =? w[1] {return MemEffect[MEM_KEEPS]}
        if name =? w[2] and nkids(e) =? 2 {
            let key=mem_key(f kid(e 1))
            if key.param >=? 0 {return MemEffect[MEM_UNLESS key]}
        }
        return MemEffect[]
    }
    if not mem_starts(path written) {
        return if mem_public(written path pool) {MemEffect[MEM_KEEPS]} else {MemEffect[]}
    }
    let sub:array<int64>=[]
    loop i in [written.length..path.length) {sub.push(path[i])}
    let inner=mem_summary(g j sub pool depth + 1)
    if inner.kind not=? MEM_UNLESS {return inner}
    # (the callee's key, a parameter of its own, is an argument here)
    if inner.key.param >=? nkids(e) {return MemEffect[]}
    let key=mem_key(f kid(e inner.key.param))
    if key.param <? 0 {return MemEffect[]}
    loop selector in inner.key.path {key.path.push(selector)}
    MemEffect[MEM_UNLESS key]
}

# The body walk (step 2). O(body nodes), at most 4096.
mem_walk=(f:MemWord i:MemWord path:array<int64> pool:bool depth:MemWord):>MemEffect=>$unsafe {
    let out=MemEffect[MEM_KEEPS]
    let stack=[MemWord(fns.ptr[f].body)]
    let visits:MemWord=0
    loop stack.length >? 0 {
        let e=stack.pop()
        if e <=? 0 {continue}
        visits += 1
        if visits >? 4096 {return MemEffect[]}
        let k=nodes.ptr[e].kind
        if k =? 'lambda' or k =? 'lazy_' or k =? 'parallel_region' {return MemEffect[]}
        if k =? 'call' {
            if nodes.ptr[e].aux =? 0 and nodes.ptr[e].sym >? 0 {
                let g=MemWord(nodes.ptr[e].sym)
                loop j in [0..min(nkids(e) fns.ptr[g].params.length)) {
                    if MemWord(locals.ptr[fns.ptr[g].params[j]].flags) & LF_MUTPARAM =? 0 {continue}
                    let r=mem_root(f kid(e j))
                    if r.param =? -1 or r.param >=? 0 and (r.param not=? i or not mem_overlap(r.path path)) {continue}
                    if r.param =? -2 {return MemEffect[]}
                    out=mem_join(out mem_call_effect(f e g j r.path path pool depth))
                    if out.kind =? MEM_FORGETS {return out}
                }
            }
            else if nodes.ptr[e].aux =? 1 {
                # (a callable value's call: whatever it may write of the parameter's is unknown)
                loop j in [0..nkids(e)) {
                    if nodes.ptr[kid(e j)].kind not=? 'addr' {continue}
                    let r=mem_root(f kid(e j))
                    if r.param =? -2 or r.param =? i and mem_overlap(r.path path) {return MemEffect[]}
                }
            }
        }
        let target:MemWord=0
        if k =? 'assign' {target=MemWord(nodes.ptr[e].a)}
        else if k =? 'intrinsic' and nkids(e) >? 0 {
            let id=nodes.ptr[e].aux
            if id =? int32(int64(IN.push)) or id =? int32(int64(IN.pop)) or id =? int32(int64(IN.insert)) or id =? int32(int64(IN.remove)) or id =? int32(int64(IN.clear)) or id =? int32(int64(IN.extend)) or id =? int32(int64(IN.truncate)) or id =? int32(int64(IN.resize)) or id =? int32(int64(IN.reserve)) {target=kid(e 0)}
        }
        if target not=? 0 {
            let r=mem_root(f target)
            if r.param =? -2 {return MemEffect[]}
            if r.param =? i and mem_overlap(r.path path) and not mem_public(r.path path pool) {return MemEffect[]}
        }
        stack.push(MemWord(nodes.ptr[e].a))
        stack.push(MemWord(nodes.ptr[e].b))
        stack.push(kid_c(e))
        stack.push(kid_d(e))
        loop c in [0..nkids(e)) {stack.push(kid(e c))}
    }
    out
}

# Parameter i's container at `path` across a call of f: keeps, keeps unless a
# key, or forgets (step 1, then step 2). Cached; a cycle forgets.
mem_summary=(f:MemWord i:MemWord path:array<int64> pool:bool depth:MemWord):>MemEffect=>$unsafe {
    if depth >? 4 or f <=? 0 or f >=? fns.length or fns.ptr[f].body =? 0 or fns.ptr[f].state not=? 2 {return MemEffect[]}
    let id="{f}:{i}:{path}:{pool}"
    let known=mem_summaries.get(id)
    if known not=? none {return known}
    if mem_busy.has(id) {return MemEffect[]}
    if not effects_demand(f true) {return MemEffect[]}
    let reaches=false
    loop event in effect_summaries.ptr[f].events {
        let kind=event.atom.kind
        if kind =? 'opaque' or kind =? 'escape' {
            # (one inside the bundled Pool's own functions is its reviewed model's to
            # decide, docs/design/assumptions.md: the walk reads those calls)
            if event.via_fn >? 0 and event.via_fn <? fns.length and mem_pool_fn(event.via_fn) {
                reaches=true
                continue
            }
            # (an element write in the body itself, `w.things[b.h].hp -= 1`: the walk reads its target)
            let w=event.witness
            if event.via_fn =? 0 and w >? 0 and w <? nodes.length and (nodes.ptr[w].kind =? 'field' or nodes.ptr[w].kind =? 'index') {
                reaches=true
                continue
            }
            mem_summaries[id]=MemEffect[]
            return MemEffect[]
        }
        if kind not=? 'write' {continue}
        let p=place_base(event.atom.place)
        if p.root not=? 'formal' or p.declaration - 1 not=? i {continue}
        let written=place_path(event.atom.place)
        if mem_overlap(written path) and not mem_public(written path pool) {reaches=true}
    }
    if not reaches {
        mem_summaries[id]=MemEffect[MEM_KEEPS]
        return MemEffect[MEM_KEEPS]
    }
    mem_busy[id]=true
    let out=mem_walk(f i path pool depth)
    mem_busy.remove(id);
    mem_summaries[id]=out
    out
}

# Keep, at a call n of f, the memberships held on `before` (parameter i's
# argument, at `path` from it) in `after`, the same place's value after the
# call, as f's summary says. Visits tracked record fields at most 4 deep.
mem_keep_walk=(n:MemWord @s:FactState f:MemWord i:MemWord before:MemWord after:MemWord path:array<int64> actuals:array<int64>):>void=>$unsafe {
    if before =? 0 or after =? 0 or before =? after {return}
    let members=false
    let fields:array<int64>=[]
    let q=fact_projection_first(s before)
    loop q >=? 0 {
        let p=s.projections[q]
        q=fact_projection_after(s q)
        if p.element {
            if not members and fact_bound(s p.value).lo >=? 1 {members=true}
        }
        else if p.selector >=? 0 {fields.push(q)}
    }
    if members or mem_refuted(s before) {
        let pool=fact_pool_type(fact_terms[before].type)
        let effect=mem_summary(f i path pool 0)
        # (a handle known to be no member stays none: a call that keeps or removes
        # members adds only fresh ones, never an earlier handle)
        if effect.kind not=? MEM_FORGETS {mem_keep_refuted(@s before after)}
        if effect.kind =? MEM_KEEPS {fact_pool_keep(@s before after)}
        else if effect.kind =? MEM_UNLESS and effect.key.param <? actuals.length and actuals[effect.key.param] not=? 0 {
            let key=actuals[effect.key.param]
            loop selector in effect.key.path {
                let found=fact_projection_find(s key selector false)
                key=if found >=? 0 and key not=? 0 {s.projections[found].value} else {0}
            }
            if key not=? 0 {
                fact_pool_keep(@s before after key)
                if s.projections.length <? FACT_CAP and fact_projection_find(s after key true) <? 0 {fact_add_projection(@s FactProjection(after key true fact_constant(@s 0 n)))}
            }
        }
    }
    if path.length >=? 3 {return}
    # (the record's fields: each one the call may have given a new value)
    let q2=fact_projection_first(s before)
    loop q2 >=? 0 {
        let p=s.projections[q2]
        q2=fact_projection_after(s q2)
        if p.element or p.selector <? 0 {continue}
        let found=fact_projection_find(s after p.selector false)
        let next=if found >=? 0 {s.projections[found].value} else {0}
        # (a field the call's effects gave no value yet: named now, where memberships hang below it)
        if next =? 0 and mem_holds(s p.value 3) {next=fact_project(@s after p.selector false fact_terms[p.value].type)}
        mem_keep_walk(n @s f i p.value next [path... p.selector] actuals)
    }
}

# Whether value v records a handle known to be no member. O(projections of v).
mem_refuted=(s:FactState v:MemWord):>bool=>{
    let q=fact_projection_first(s v)
    loop q >=? 0 {
        let p=s.projections[q]
        q=fact_projection_after(s q)
        if p.element {
            let b=fact_bound(s p.value)
            if b.hi <=? 0 and not b.wide {return true}
        }
    }
    false
}
mem_keep_refuted=(@s:FactState before:MemWord after:MemWord):>void=>{
    let gone:array<FactProjection>=[]
    let q=fact_projection_first(s before)
    loop q >=? 0 {
        let p=s.projections[q]
        q=fact_projection_after(s q)
        if not p.element {continue}
        let b=fact_bound(s p.value)
        if b.hi <=? 0 and not b.wide and fact_projection_find(s after p.selector true) <? 0 {gone.push(FactProjection(after p.selector true p.value))}
    }
    loop p in gone {
        if s.projections.length <? FACT_CAP {fact_add_projection(@s p)}
    }
}

# Whether value v holds a membership, or a field of it does (depth levels). O(projections below).
mem_holds=(s:FactState v:MemWord depth:MemWord):>bool=>{
    let q=fact_projection_first(s v)
    loop q >=? 0 {
        let p=s.projections[q]
        q=fact_projection_after(s q)
        if p.element and (fact_bound(s p.value).lo >=? 1 or fact_bound(s p.value).hi <=? 0) {return true}
        if not p.element and p.selector >=? 0 and depth >? 0 and mem_holds(s p.value depth - 1) {return true}
    }
    false
}

# Whether a value of type t may hold memberships: a Pool, a container some
# `contains` takes, or a record with such a field (3 deep). Cached per type.
mem_holder_type=(t0:MemWord depth:MemWord):>bool=>$unsafe {
    let t=fact_type(t0)
    let known=mem_holders.get(t)
    if known not=? none {return known}
    mem_holders[t]=false
    let held=fact_pool_type(t)
    if not held and types.ptr[t].kind =? 'struct_' {
        if mem_name =? 0 {mem_name=intern("contains")}
        loop mem_scanned <? fns.length {
            let d=MemWord(fns.ptr[mem_scanned].decl)
            if d not=? 0 and MemWord(nodes.ptr[d].name) =? mem_name {mem_named.push(mem_scanned)}
            mem_scanned += 1
        }
        let key=mem_type_key(t)
        loop f in mem_named {
            if fns.ptr[f].ptypes.length =? 2 and mem_type_key(fns.ptr[f].ptypes[0]) =? key {held=true}
        }
        if not held and depth <? 3 and not is_map_type(t) {
            let si=MemWord(types.ptr[t].st)
            loop j in [0..MemWord(structs.ptr[si].nfields)) {
                if mem_holder_type(MemWord(fields.ptr[MemWord(structs.ptr[si].fields) + j].type) depth + 1) {held=true}
            }
        }
    }
    mem_holders[t]=held
    held
}

# A call that may change a membership holder through an `@` argument: the fact
# slice keeps its arguments' values, the keys its summary may name. O(arguments).
mem_holder_call=(n:MemWord):>bool=>$unsafe {
    if nodes.ptr[n].kind not=? 'call' or nodes.ptr[n].aux not=? 0 or nodes.ptr[n].sym <=? 0 {return false}
    let f=MemWord(nodes.ptr[n].sym)
    loop i in [0..min(nkids(n) fns.ptr[f].params.length)) {
        if MemWord(locals.ptr[fns.ptr[f].params[i]].flags) & LF_MUTPARAM not=? 0 and mem_holder_type(ntype(kid(n i)) 0) {
            # (from here on, calls' summaries may be asked for: mem_after_call)
            mem_demanded=true
            return true
        }
    }
    false
}

# After the effects of call n (fact_path_call_effects): each `@` argument's
# memberships, from its value before the call. O(parameters), and a summary
# only where a membership is held on a changed value.
mem_after_call=(n:MemWord @s:FactState before:array<int64>):>void=>$unsafe {
    let f=MemWord(nodes.ptr[n].sym)
    mem_last_call=n
    mem_last_before=before
    loop i in [0..min(before.length fns.ptr[f].params.length)) {
        if before[i] =? 0 or MemWord(locals.ptr[fns.ptr[f].params[i]].flags) & LF_MUTPARAM =? 0 {continue}
        let after=fact_summary_actual(n i @s true)
        mem_keep_walk(n @s f i before[i] after [] before)
    }
}

# Whether f's result is a fresh member of a parameter's Pool: its body ends in
# that Pool's `add`, or a record built with one (the field's path). Once per
# function, at most 16 body steps.
mem_fresh_of=(f:MemWord):>MemPath=>$unsafe {
    let known=mem_fresh.get(f)
    if known not=? none {return known}
    let none_=MemPath[param=-2]
    mem_fresh[f]=none_
    if fns.ptr[f].body =? 0 or fns.ptr[f].state not=? 2 {return none_}
    let e=MemWord(fns.ptr[f].body)
    # (`let`s before the last statement, by local: what a constructor's field may name)
    let bound=dict<int64 int64>()
    loop _ in [0..16) {
        if e <=? 0 {return none_}
        let k=nodes.ptr[e].kind
        if k =? 'return_' or k =? 'exprstmt' or k =? 'conv' {e=MemWord(nodes.ptr[e].a)}
        else if k =? 'block' and nkids(e) >? 0 {
            loop j in [0..nkids(e) - 1) {
                let c=kid(e j)
                if nodes.ptr[c].kind =? 'vardecl' and nodes.ptr[c].b not=? 0 and nkids(c) =? 0 {bound[MemWord(nodes.ptr[c].sym)]=MemWord(nodes.ptr[c].b)}
            }
            e=kid(e nkids(e) - 1)
        }
        else if k =? 'ident' and nodes.ptr[e].aux =? 1 and bound.has(MemWord(nodes.ptr[e].sym)) {e=bound[MemWord(nodes.ptr[e].sym)]}
        else {break}
    }
    if e <=? 0 or nodes.ptr[e].kind not=? 'call' {return none_}
    let field:MemWord=-1
    let add=e
    if nodes.ptr[e].aux =? 2 {
        add=0
        let si=MemWord(types.ptr[fact_type(ntype(e))].st)
        loop j in [0..nkids(e)) {
            let a=kid(e j)
            loop _ in [0..8) {
                if a >? 0 and nodes.ptr[a].kind =? 'conv' {a=MemWord(nodes.ptr[a].a)}
                else if a >? 0 and nodes.ptr[a].kind =? 'ident' and nodes.ptr[a].aux =? 1 and bound.has(MemWord(nodes.ptr[a].sym)) {a=bound[MemWord(nodes.ptr[a].sym)]}
                else {break}
            }
            if a >? 0 and nodes.ptr[a].kind =? 'call' and nodes.ptr[a].aux =? 0 {
                add=a
                field=MemWord(fields.ptr[MemWord(structs.ptr[si].fields) + j].name)
            }
        }
    }
    if add =? 0 or nodes.ptr[add].aux not=? 0 or nodes.ptr[add].sym <=? 0 or nkids(add) <? 1 {return none_}
    let g=MemWord(nodes.ptr[add].sym)
    if not mem_pool_fn(g) or MemWord(nodes.ptr[MemWord(fns.ptr[g].decl)].name) not=? mem_words()[0] {return none_}
    let r=mem_root(f kid(add 0))
    if r.param <? 0 {return none_}
    # (the result's own path to its key, after the container's path)
    let out=MemPath[r.param r.path [field]]
    mem_fresh[f]=out
    out
}

# A fresh result (mem_fresh_of): its key's rank is above every member the
# container held before the call, as Pool's `add` ranks. O(members).
mem_result_fresh=(n:MemWord @s:FactState f:MemWord result:MemWord):>void=>$unsafe {
    if mem_last_call not=? n {return}
    let before=mem_last_before
    mem_last_call=0
    let fresh=mem_fresh_of(f)
    if fresh.param <? 0 or fresh.param >=? before.length or before[fresh.param] =? 0 or result =? 0 {return}
    let old=before[fresh.param]
    let now=fact_summary_actual(n fresh.param @s true)
    loop selector in fresh.path {
        let a=fact_projection_find(s old selector false)
        let b=if now not=? 0 {fact_projection_find(s now selector false)} else {-1}
        if a <? 0 or b <? 0 {return}
        old=s.projections[a].value
        now=s.projections[b].value
    }
    let key=result
    if fresh.types[0] >=? 0 {
        let found=fact_projection_find(s result fresh.types[0] false)
        if found <? 0 {return}
        key=s.projections[found].value
    }
    if old =? now {return}
    let rank=fact_pool_rank(s old) + 1
    let member=fact_projection_find(s now key true)
    if member >=? 0 {fact_set_bound(@s s.projections[member].value FactBound(rank rank))}
    else if s.projections.length <? FACT_CAP {fact_add_projection(@s FactProjection(now key true fact_constant(@s rank n)))}
}

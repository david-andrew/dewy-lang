# A captured or narrowed name's variable, as check_place resolves it.
place_owner = (l: int) -> int:
    r = l
    loop true:
        if int(locals[r].flags) & LF_CAPTURE != 0 and int(locals[r].flags) & LF_VALUECAP == 0: r = int(locals[r].outer)
        else if narrowed_var(r) != 0: r = narrowed_var(r)
        else: break
    r
const_view_declare = (l: int, init: int):
    e = init
    loop nodes[e].kind == .conv: e = int(nodes[e].a)
    if not has_flag(e, NF_MUT): return
    loop (nodes[e].kind == .field or nodes[e].kind == .index) and nodes[e].a != 0: e = int(nodes[e].a)
    if nodes[e].kind != .ident or nodes[e].aux != i32(int(SK.local)): return
    const_views.push(ConstView(l, place_owner(int(nodes[e].sym)), loop_serials.len(), []))
    statement_watch.const_views = const_views.len()
const_view_write = (r: int, pos: int):
    loop i in [0..const_views.len()):
        if const_views[i].root != r: continue
        v = const_views[i]
        loop d in [v.depth..loop_serials.len()):
            if v.used.contains(loop_serials[d]): const_view_conflict(v.view, pos, 0)
        if v.write == 0: const_views[i].write = pos
const_view_use = (l: int, pos: int):
    loop i in [0..const_views.len()):
        if const_views[i].view != l: continue
        if const_views[i].write != 0: const_view_conflict(l, const_views[i].write, pos)
        loop d in [const_views[i].depth..loop_serials.len()): const_views[i].used.push(loop_serials[d])
const_view_conflict = (l: int, write: int, at: int):
    nm = name_of(int(locals[l].name))
    if at != 0: err_notes.push((at, "note: '{nm}' is used here, after the write"))
    else: err_notes.push((-1, "note: the loop repeats a use of '{nm}' after the write"))
    err_notes.push((locals[l].pos, "note: the view is declared here"))
    err_notes.push((-1, "help: write after the view's last use, or take an independent snapshot with `.copy`"))
    fatal(write, "this write conflicts with const view '{nm}', which is still in use")

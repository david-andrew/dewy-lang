use 'effect_lattice.dewy'
use 'ir_types.dewy'
use 'ownership_types.dewy'
use 'ownership_checks.dewy'
use 'prelude.jo'
# Nominal lifecycle metadata. No ownership walk or summary demand for ordinary
# programs; hook identity is deliberately separate from structural equality.
use 'util.jo'
use 'copies.jo'
use 'ast.jo'
use 'types.jo'
use 'check.jo'
use 'effects.jo'
use 'errors.jo'
use 'expr.jo'
use 'places.jo'
use 'refine.jo'

ownership_decls: {int: int}
ownership_contained: {int: bool}
# __Held only releases its lock word after the checked place's last use; it
# cannot run user code. Other lifecycle hooks retain opaque cleanup effects.
ownership_fact_cleanup = false
ownership_hooks: {int: int}
ownership_copies: {int: int}
ownership_moves: {int: int}
ownership_nominals: {int: bool}
owner_map_copies: {int: int}
# Resource-type predicates run in ownership_types.dewy over these tables.
ownership_type_input = OwnershipTypeInput(&types, &structs, &type_args, &fields, &variants, &fns, &ownership_decls, &ownership_copies, &ownership_moves, &ownership_contained, &nominal_parent, &T_MATH_INT)
ownership_type_binding = ownership_types_bind(&ownership_type_input)
# Owning parameters, the validation walk and closure capabilities run in
# ownership_checks.dewy; these are its services.
ownership_functions: {int: bool}
ownership_check_error = (pos: int, message: str): fatal(pos, message)
ownership_check_escapes = (body: int, l: int) -> bool: copy_escapes(body, l)
ownership_check_callable = (t: int, contract: int, capability: int) -> int: mk_callable_contract(t, contract, capability)
ownership_check_host = OwnershipCheckHost(ownership_check_error, ownership_check_escapes, callable_contract, ownership_check_callable)
ownership_check_input = OwnershipCheckInput(&nodes, &lists, &types, &structs, &fields, &locals, &globals, &fns, &files, &names, &ownership_decls, &ownership_hooks, &ownership_functions, &copy_inputs, &copy_bindings, int(IN.arrdata), int(IN.resize), int(IN.setlen), int(CV.explicit_copy), int(SK.local), &ownership_check_host)
ownership_check_binding = ownership_checks_bind(&ownership_check_input)

ownership_declare = (decl: int, hook: int, role: int):
    if nkids(hook) != 1: fatal(nodes[hook].pos, "lifecycle hooks have no explicit parameters")
    if nkids2(hook) != nkids2(decl): fatal(nodes[hook].pos, "lifecycle hooks cannot declare additional type parameters")
    key = decl * 4 + role
    if ownership_decls.has(key):
        name = if role == 1: "drop" else if role == 2: "copy" else: "move"
        fatal(nodes[hook].pos, "duplicate $__{name}__ hook")
    if role != 1 or name_of(int(nodes[decl].name)) != "__Held" or files[pos_file(nodes[decl].pos)].path != lib_dir + "/prelude/locks.dewy": ownership_fact_cleanup = true
    ownership_decls[key] = hook
    ownership_hooks[hook] = role
    add_flag(kid(hook, 0), NF_MUT)

ownership_finalize_hook = (f: int):
    hook = int(fns[f].decl)
    check_fn_body(f)
    role = ownership_hooks[hook]
    if role == 1 and int(fns[f].ret) != T_VOID: fatal(nodes[hook].pos, "a $__drop__ hook must return void")
    t = prune(fns[f].ptypes[0])
    if tkind(t) != .struct_: fatal(nodes[hook].pos, "a lifecycle receiver must be nominal")
    layout(t)
    si = int(types[t].st)
    loop i in [0..int(structs[si].nfields)):
        ft = field_store_type(int(structs[si].fields) + i)
        if not ownership_layout(ft): fatal(nodes[hook].pos, "resource fields currently require an inline record layout")
    if role != 1 and prune(int(fns[f].ret)) != t: fatal(nodes[hook].pos, "copy and move hooks must return the same nominal type")
    if role == 1: structs[si].drop_fn = i32(f)
    else if role == 2: ownership_copies[t] = f
    else: ownership_moves[t] = f
    types[t].flags |= i32(TF_MANAGED)

ownership_finalize = ():
    if ownership_decls.len() == 0: return
    hooks: int[]
    loop key, hook in ownership_decls:
        if nkids2(hook) == 0: hooks.push(get_fn_inst(hook, [], nodes[hook].pos))
    # Instantiation may discover further concrete records in hook bodies.
    next_hook = 0
    next_type = 1
    loop next_hook < hooks.len() or next_type < types.len():
        if next_hook < hooks.len():
            ownership_finalize_hook(hooks[next_hook])
            next_hook += 1
            continue
        t = next_type
        next_type += 1
        if types[t].kind != .struct_ or has_var(t): continue
        si = int(types[t].st)
        decl = int(structs[si].decl)
        if decl == 0 or nkids2(decl) == 0: continue
        args: int[]
        loop i in [0..int(structs[si].ntargs)): args.push(struct_targ(si, i))
        loop role in [1..4):
            if let hook = ownership_decls.get(decl * 4 + role):
                f = get_fn_inst(hook, args, nodes[hook].pos)
                if not hooks.contains(f): hooks.push(f)
    loop child, parent in nominal_parent:
        ownership_inherit(child)
    ownership_contained.clear()
    loop t in [1..types.len()):
        if ownership_type(t):
            types[t].flags |= i32(TF_MANAGED)
            if is_map_type(t) and ownership_copyable(t):
                fs = field_list(t)
                kt = telem(fs[0].0)
                if ownership_type(kt):
                    name = intern("__map_copy_owners")
                    demand_prelude_name(name)
                    decl = int(syms[prelude[name]].decl)
                    f = get_fn_inst(decl, [kt, telem(fs[1].0)], nodes[decl].pos)
                    check_pending_functions(f)
                    owner_map_copies[t] = f
    loop name in ["__owner_link", "__owner_unlink", "__owner_drop", "__owner_print", "__owner_start", "__arr_copy"]:
        f = runtime_fn(name)
        check_pending_functions(f)
    # Hook instantiation can extend a previously demanded refinement graph.
    effect_limit = 0
    effect_serial = 0
    effect_stack = []
    loop f in hooks:
        role = ownership_hooks[int(fns[f].decl)]
        name = if role == 1: "drop" else if role == 2: "copy" else: "move"
        # (a library's own drop hook, as a lock guard's release over raw words, is trusted:
        # docs/design/assumptions.md)
        if role == 1 and pos_in_lib(nodes[int(fns[f].decl)].pos): continue
        if not effects_demand(f): fatal(nodes[int(fns[f].decl)].pos, "{name} hook has no proven no-failure summary")
        loop event in effect_summaries[f].events:
            k = event.atom.kind
            if k == .opaque or k == .panic or k == .alloc or k == .spawn or k == .remainder or k == .detach or k == .escape:
                fatal(nodes[int(fns[f].decl)].pos, "{name} hook requires a proven no-failure summary: {effect_witness(f, event)}")
            if role == 2 and k == .write and place_base(event.atom.place).root == .formal:
                fatal(nodes[int(fns[f].decl)].pos, "a copy hook requires a readonly receiver")

# The call plan records incoming owners separately from borrowed place inputs.
# Synthetic Dewy parameter bindings adopt the incoming value without copying.

# Lowering adapter: sparse stack records, allocated only for demanded owners.
# Linking publishes successful initialization; unlinking consumes ownership.
use 'lower.jo'
use 'ir.jo'
owner_records: {int: int}
owner_adoptions: {int: bool}
owner_values: {int: int}
owner_parts: {int: (str, int)[]} # root slot -> (field path, record)
owner_init = -1

owner_begin = ():
    owner_records.clear()
    owner_parts.clear()
    owner_adoptions.clear()
    owner_values.clear()
    owner_init = -1
    if ownership_decls.len() != 0: owner_init = emit(.nop, 0, 0, 0, 0, 0, 0)

owner_end = ():
    if owner_init < 0 or owner_records.len() == 0: return
    start = ir.args.len()
    loop slot, record in owner_records: ir.args.push(i32(record * 2))
    ir.code[owner_init] = Ins(.zeroslots, 0, 0, i32(start), i32(owner_records.len()), 0, 0)

owner_record = (slot: int) -> int:
    if slot < 0: ice("owner without local storage")
    if let record = owner_records.get(slot): return record
    record = new_slot(32, 8)
    owner_records[slot] = record
    record

# Structural records have independent cleanup authorities for their resource
# leaves. This preserves reverse field order and permits path-dependent moves
# without treating zero bytes as an initialization marker.
owner_register_part = (slot: int, t: int, offset: int, path: str):
    if ownership_type(t) and tkind(t) == .struct_ and not ownership_nominal(t) and not is_map_type(t):
        fs = field_list(t)
        loop i in [0..fs.len()):
            field = fs[i]
            if is_managed(field.0): owner_register_part(slot, field.0, offset + field.1, path + "{i}/")
        return
    parts = owner_parts.get(slot) ?? []
    record = -1
    loop part in parts:
        if part.0 == path: record = part.1
    if record < 0:
        record = owner_record(new_slot(1, 1))
        parts.push((path, record))
        owner_parts[slot] = parts
    e_call(rt("__owner_link"), [e_slot(record), e_addi(e_slot(slot), offset), e_faddr(lf_helper(.drop, t, 0))], -1)

owner_register = (slot: int, t: int):
    if ownership_type(t) and tkind(t) == .struct_ and not ownership_nominal(t) and not is_map_type(t):
        owner_register_part(slot, t, 0, "")
        return
    record = owner_record(slot)
    e_call(rt("__owner_link"), [e_slot(record), e_slot(slot), e_faddr(lf_helper(.drop, t, 0))], -1)

owner_forget_field = (slot: int, path: str):
    if let parts = owner_parts.get(slot):
        loop part in parts:
            if starts_with(part.0, path):
                e_call(rt("__owner_unlink"), [e_slot(part.1)], -1)

owner_forget_slot = (slot: int):
    if let parts = owner_parts.get(slot):
        loop part in parts: e_call(rt("__owner_unlink"), [e_slot(part.1)], -1)
        return
    record = owner_record(slot)
    e_call(rt("__owner_unlink"), [e_slot(record)], -1)

owner_address_slot = (addr: int) -> int:
    i = ir.code.len() - 1
    loop i >= 0:
        ins = ir.code[i]
        if ins.op == .slot and int(ins.dst) == addr: return int(ins.a)
        i -= 1
    ice("owner address is not a whole local")
    -1

owner_forget = (addr: int):
    if let slot = owner_values.get(addr): owner_forget_slot(slot)
    else: owner_forget_slot(owner_address_slot(addr))

owner_value = (value: Val, t: int) -> Val:
    if value.slot >= 0:
        if vc(t) == VC_INT: owner_values[value.v] = value.slot
        owner_register(value.slot, t)
        return value
    slot = new_temp(t)
    store_val(t, e_slot(slot), 0, value.v)
    owner_values[value.v] = slot
    owner_register(slot, t)
    Val(value.v, true, slot)

# Only resource arrays carry a live marker. Vacant map slots are storage,
# never zero-valued owners. Relocation copies the marker with the payload.
owner_stride = (et: int) -> int:
    if ownership_type(et): return align_up(tsize(et) + 1, talign(et))
    tsize(et)

owner_element_live = (addr: int, et: int):
    if ownership_type(et): e_store(addr, tsize(et), e_iconst(1), 1)

owner_element_drop = (addr: int, et: int):
    if ownership_type(et):
        iff(e_load(VI, addr, tsize(et), 1))
        e_store(addr, tsize(et), e_iconst(0), 1)
        drop_embedded(addr, et)
        endc()
    else: drop_embedded(addr, et)

owner_drop = (addr: int):
    # (cleanup in a task runs shielded from cancellation, as deferred code does)
    if concurrency.concurrency_runtime_needed: e_call(rt("__task_shield_enter"), [], -1)
    slot = owner_address_slot(addr)
    if let parts = owner_parts.get(slot):
        loop i in [0..parts.len()):
            e_call(rt("__owner_drop"), [e_slot(parts[parts.len() - 1 - i].1)], -1)
    else: e_call(rt("__owner_drop"), [e_slot(owner_record(slot))], -1)
    if concurrency.concurrency_runtime_needed: e_call(rt("__task_shield_leave"), [], -1)

# The literal-only diagnostic path has no allocation or language failure. It
# flushes earlier output, then uses the runtime's best-effort raw write. Dynamic
# formatting remains subject to the ordinary conservative failure summary.
ownership_prints: {int: bool}
ownership_literal_print = (n: int) -> bool:
    if ownership_decls.len() == 0 or nodes[n].kind != .call or nodes[n].aux != 0 or nkids(n) != 1: return false
    printer = runtime_insts.get("__print_str") ?? 0
    if printer == 0 or int(nodes[n].sym) != printer: return false
    a = kid(n, 0)
    if nodes[a].kind != .str_lit or nodes[a].aux != 0: return false
    ownership_prints[n] = true
    true

ownership_reset = ():
    ownership_decls.clear()
    ownership_hooks.clear()
    ownership_copies.clear()
    ownership_moves.clear()
    ownership_nominals.clear()
    owner_map_copies.clear()
    ownership_functions.clear()
    ownership_contained.clear()
    ownership_prints.clear()

# A hook constructs directly into a fresh result slot. Its result is adopted;
# routing it through ordinary copying would recursively invoke the same hook.
owner_hook_result = (f: int, source: int, t: int) -> Val:
    slot = new_temp(t)
    addr = e_slot(slot)
    owner_hook_into(f, source, t, addr)
    owner_register(slot, t)
    Val(addr, true, slot)

ownership_inherit = (child: int):
    parent = nominal_parent.get(child) ?? 0
    if parent == 0: return
    ownership_inherit(parent)
    if not ownership_type(parent): return
    layout(child)
    si = int(types[child].st)
    loop field in field_list(child):
        if not ownership_layout(field.0):
            fatal(nodes[int(structs[si].decl)].pos, "resource fields currently require an inline record layout")
    if structs[si].drop_fn == 0: structs[si].drop_fn = structs[int(types[parent].st)].drop_fn
    if not ownership_copies.has(child):
        if let hook = ownership_copies.get(parent): ownership_copies[child] = hook
    if not ownership_moves.has(child):
        if let hook = ownership_moves.get(parent): ownership_moves[child] = hook
    types[child].flags |= i32(TF_MANAGED)

owner_hook_into = (f: int, source: int, t: int, dest: int):
    e_call(lf_of_inst(f), [dest, source], -1)
    # An inherited role builds only its declaring parent. Preserve the child's
    # added fields and complete nominal identity at the owning boundary.
    parent = prune(int(fns[f].ret))
    first = int(structs[int(types[parent].st)].nfields)
    fields_ = field_list(t)
    loop i in [first..fields_.len()):
        field = fields_[i]
        dst = e_addi(dest, field.1)
        src = e_addi(source, field.1)
        if ownership_hooks[int(fns[f].decl)] == 3 and ownership_type(field.0):
            e_call(lf_helper(.move, field.0, 0), [dst, src], -1)
        else:
            store_val(field.0, dest, field.1, load_val(field.0, source, field.1))
            if ownership_hooks[int(fns[f].decl)] == 2: copy_at(dst, field.0)

# A hook constructs its result; returning a proved-dead local adopts that
# construction rather than recursively invoking the same lifecycle role.
owner_adopt_result = (n: int):
    if n == 0: return
    k = nodes[n].kind
    if k == .if_:
        owner_adopt_result(int(nodes[n].b))
        owner_adopt_result(int(nodes[n].c))
    else if k == .block and nkids(n) > 0:
        owner_adopt_result(kid(n, nkids(n) - 1))
    else if k == .exprstmt: owner_adopt_result(int(nodes[n].a))
    else: owner_adoptions[n] = true

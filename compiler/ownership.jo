use 'prelude.jo'
# Nominal lifecycle metadata. No ownership walk or summary demand for ordinary
# programs; hook identity is deliberately separate from structural equality.
use 'util.jo'
use 'copies.jo'
use 'ast.jo'
use 'types.jo'
use 'check.jo'
use 'effects.jo'
use 'errors.jo'
use 'expr.jo'
use 'places.jo'
use 'refine.jo'

ownership_decls: {int: int}
ownership_hooks: {int: int}
ownership_copies: {int: int}
ownership_moves: {int: int}
ownership_nominals: {int: bool}
owner_map_copies: {int: int}

ownership_declare = (decl: int, hook: int, role: int):
    if nkids(hook) != 1: fatal(nodes[hook].pos, "lifecycle hooks have no explicit parameters")
    if nkids2(decl) != 0 or nkids2(hook) != 0: fatal(nodes[hook].pos, "generic lifecycle hooks require aggregate ownership support")
    key = decl * 4 + role
    if ownership_decls.has(key):
        name = if role == 1: "drop" else if role == 2: "copy" else: "move"
        fatal(nodes[hook].pos, "duplicate $__{name}__ hook")
    ownership_decls[key] = hook
    ownership_hooks[hook] = role
    add_flag(kid(hook, 0), NF_MUT)

ownership_finalize = ():
    if ownership_decls.len() == 0: return
    hooks: int[]
    loop decl, hook in ownership_decls:
        f = get_fn_inst(hook, [], nodes[hook].pos)
        check_fn_body(f)
        role = ownership_hooks[hook]
        if role == 1 and int(fns[f].ret) != T_VOID: fatal(nodes[hook].pos, "a $__drop__ hook must return void")
        hooks.push(f)
        t = prune(fns[f].ptypes[0])
        if tkind(t) != .struct_: fatal(nodes[hook].pos, "a lifecycle receiver must be nominal")
        layout(t)
        si = int(types[t].st)
        loop i in [0..int(structs[si].nfields)):
            ft = int(fields[int(structs[si].fields) + i].type)
            if not ownership_inline(ft): fatal(nodes[hook].pos, "resource fields currently require an inline record layout")
        if role != 1 and prune(int(fns[f].ret)) != t: fatal(nodes[hook].pos, "copy and move hooks must return the same nominal type")
        if role == 1: structs[si].drop_fn = i32(f)
        else if role == 2: ownership_copies[t] = f
        else: ownership_moves[t] = f
        types[t].flags |= i32(TF_MANAGED)
    loop child, parent in nominal_parent:
        ownership_inherit(child)
    ownership_contained.clear()
    loop t in [1..types.len()):
        if ownership_type(t):
            types[t].flags |= i32(TF_MANAGED)
            if is_map_type(t) and ownership_copyable(t):
                fs = field_list(t)
                kt = telem(fs[0].0)
                if ownership_type(kt):
                    name = intern("__map_copy_owners")
                    demand_prelude_name(name)
                    decl = int(syms[prelude[name]].decl)
                    f = get_fn_inst(decl, [kt, telem(fs[1].0)], nodes[decl].pos)
                    check_pending_functions(f)
                    owner_map_copies[t] = f
    loop name in ["__owner_link", "__owner_unlink", "__owner_drop", "__owner_print", "__owner_start", "__arr_copy"]:
        f = runtime_fn(name)
        check_pending_functions(f)
    # Hook instantiation can extend a previously demanded refinement graph.
    effect_limit = 0
    effect_serial = 0
    effect_stack = []
    loop f in hooks:
        role = ownership_hooks[int(fns[f].decl)]
        name = if role == 1: "drop" else if role == 2: "copy" else: "move"
        if not effects_demand(f): fatal(nodes[int(fns[f].decl)].pos, "{name} hook has no proven no-failure summary")
        loop event in effect_summaries[f].events:
            k = event.atom.kind
            if k == .opaque or k == .panic or k == .alloc or k == .block or k == .spawn or k == .remainder or k == .detach or k == .escape:
                fatal(nodes[int(fns[f].decl)].pos, "{name} hook requires a proven no-failure summary: {effect_witness(f, event)}")
            if role == 2 and k == .write and place_base(event.atom.place).root == .formal:
                fatal(nodes[int(fns[f].decl)].pos, "a copy hook requires a readonly receiver")

ownership_nominal = (t0: int) -> bool:
    if ownership_decls.len() == 0: return false
    t = prune(t0)
    types[t].kind == .struct_ and (structs[int(types[t].st)].drop_fn != 0 or ownership_copies.has(t) or ownership_moves.has(t))

ownership_type = (t0: int) -> bool:
    if ownership_decls.len() == 0: return false
    t = prune(t0)
    (types[t].kind == .struct_ or types[t].kind == .fixed or types[t].kind == .array) and ownership_contains(t)

# The call plan records incoming owners separately from borrowed place inputs.
# Synthetic Dewy parameter bindings adopt the incoming value without copying.
ownership_functions: {int: bool}
ownership_parameters = ():
    if ownership_decls.len() == 0: return
    ownership_library_parameters()
    loop f in [1..fns.len()):
        body = int(fns[f].body)
        loop l in fns[f].locals:
            if ownership_type(int(locals[l].type)): ownership_functions[f] = true
        if body == 0: continue
        loop i in [0..nkids(body)):
            s = kid(body, i)
            if nodes[s].kind != .vardecl or nodes[s].aux2 != 1: break
            if nkids(s) > 0: continue
            l = int(nodes[s].sym)
            if not ownership_type(int(locals[l].type)): continue
            source = int(nodes[s].b)
            if nodes[source].kind != .ident: continue
            p = int(nodes[source].sym)
            if int(locals[p].flags) & LF_MUTPARAM != 0: continue
            if fns[f].cabi or fns[f].has_env or len(fns[f].export_name) != 0:
                fatal(nodes[s].pos, "owning parameters require a closed direct call")
            copy_inputs[p] = true
            copy_bindings[l] = true

# Implementation-library parameters which publish an owner use the same
# consuming ABI as Dewy's private parameter bindings. Propagate through calls.
ownership_library_parameters = ():
    changed = true
    loop changed:
        changed = false
        loop f in [1..fns.len()):
            body = int(fns[f].body)
            if body == 0 or fns[f].decl == 0 or files[pos_file(nodes[int(fns[f].decl)].pos)].is_dewy: continue
            loop p in fns[f].params:
                if copy_inputs.has(p) or int(locals[p].flags) & LF_MUTPARAM != 0 or not ownership_type(int(locals[p].type)): continue
                if copy_escapes(body, p):
                    copy_inputs[p] = true
                    changed = true

# Lowering adapter: sparse stack records, allocated only for demanded owners.
# Linking publishes successful initialization; unlinking consumes ownership.
use 'lower.jo'
use 'ir.jo'
owner_records: {int: int}
owner_adoptions: {int: bool}
owner_values: {int: int}
owner_init = -1

owner_begin = ():
    owner_records.clear()
    owner_adoptions.clear()
    owner_values.clear()
    owner_init = -1
    if ownership_decls.len() != 0: owner_init = emit(.nop, 0, 0, 0, 0, 0, 0)

owner_end = ():
    if owner_init < 0 or owner_records.len() == 0: return
    start = ir.args.len()
    loop slot, record in owner_records: ir.args.push(i32(record * 2))
    ir.code[owner_init] = Ins(.zeroslots, 0, 0, i32(start), i32(owner_records.len()), 0, 0)

owner_record = (slot: int) -> int:
    if slot < 0: ice("owner without local storage")
    if let record = owner_records.get(slot): return record
    record = new_slot(32, 8)
    owner_records[slot] = record
    record

owner_register = (slot: int, t: int):
    record = owner_record(slot)
    e_call(rt("__owner_link"), [e_slot(record), e_slot(slot), e_faddr(lf_helper(.drop, t, 0))], -1)

owner_forget_slot = (slot: int):
    record = owner_record(slot)
    e_call(rt("__owner_unlink"), [e_slot(record)], -1)

owner_address_slot = (addr: int) -> int:
    i = ir.code.len() - 1
    loop i >= 0:
        ins = ir.code[i]
        if ins.op == .slot and int(ins.dst) == addr: return int(ins.a)
        i -= 1
    ice("owner address is not a whole local")
    -1

owner_forget = (addr: int):
    if let slot = owner_values.get(addr): owner_forget_slot(slot)
    else: owner_forget_slot(owner_address_slot(addr))

owner_value = (value: Val, t: int) -> Val:
    if value.slot >= 0:
        if vc(t) == VC_INT: owner_values[value.v] = value.slot
        owner_register(value.slot, t)
        return value
    slot = new_temp(t)
    store_val(t, e_slot(slot), 0, value.v)
    owner_values[value.v] = slot
    owner_register(slot, t)
    Val(value.v, true, slot)

# Only resource arrays carry a live marker. Vacant map slots are storage,
# never zero-valued owners. Relocation copies the marker with the payload.
owner_stride = (et: int) -> int:
    if ownership_type(et): return align_up(tsize(et) + 1, talign(et))
    tsize(et)

owner_element_live = (addr: int, et: int):
    if ownership_type(et): e_store(addr, tsize(et), e_iconst(1), 1)

owner_element_drop = (addr: int, et: int):
    if ownership_type(et):
        iff(e_load(VI, addr, tsize(et), 1))
        e_store(addr, tsize(et), e_iconst(0), 1)
        drop_embedded(addr, et)
        endc()
    else: drop_embedded(addr, et)

owner_drop = (addr: int):
    record = owner_record(owner_address_slot(addr))
    e_call(rt("__owner_drop"), [e_slot(record)], -1)

ownership_contained: {int: bool}
ownership_contains = (t0: int) -> bool:
    t = prune(t0)
    if ownership_nominal(t): return true
    if let found = ownership_contained.get(t): return found
    ownership_contained[t] = false
    found = false
    k = tkind(t)
    if k == .array or k == .fixed or k == .opt or k == .box: found = ownership_contains(telem(t))
    else if k == .tuple:
        loop i in [0..int(types[t].nargs)):
            if ownership_contains(targ(t, i)): found = true
    else if k == .struct_ or k == .enum_:
        layout(t)
        si = int(types[t].st)
        if k == .struct_:
            loop i in [0..int(structs[si].nfields)):
                if ownership_contains(int(fields[int(structs[si].fields) + i].type)): found = true
        else:
            loop i in [0..int(structs[si].nvariants)):
                v = int(structs[si].variants) + i
                loop j in [0..int(variants[v].nfields)):
                    if ownership_contains(int(fields[int(variants[v].fields) + j].type)): found = true
    # False is only the recursion guard, not a settled property: another
    # path through the component may discover a resource after this visit.
    if found: ownership_contained[t] = true
    else: ownership_contained.remove(t)
    found

ownership_validate_node = (n: int, f: int):
    if n == 0: return
    t = ntype(n)
    if t > 0 and ownership_contains(t) and not ownership_type(t):
        fatal(nodes[n].pos, "resource containers require aggregate ownership support")
    if ownership_type(t) and not ownership_layout(t):
        fatal(nodes[n].pos, "resource fields currently require an inline record layout")
    k = nodes[n].kind
    if k == .array and tkind(t) == .fixed and ownership_type(t):
        if nkids(n) == 0 and fixed_len(t) > 0:
            fatal(nodes[n].pos, "owning array elements require completed construction")
        if nodes[n].b != 0 and fixed_len(t) > 1 and not ownership_copyable(telem(t)):
            fatal(nodes[n].pos, "cannot repeat a move-only owner")
    if k == .intrinsic and nkids(n) > 0 and ownership_type(ntype(kid(n, 0))):
        id = nodes[n].aux as IN
        if id == .arrdata: fatal(nodes[n].pos, "raw resource array access requires a live-slot protocol")
        if id == .resize or id == .setlen:
            fatal(nodes[n].pos, "owning array elements require completed construction; use push")
    if k == .call and nodes[n].aux == 0 or k == .fnref:
        g = int(nodes[n].sym)
        if g > 0 and ownership_hooks.has(int(fns[g].decl)):
            fatal(nodes[n].pos, "lifecycle hooks are compiler-only operations")
        if k == .fnref and g > 0 and ownership_functions.has(g):
            fatal(nodes[n].pos, "owners require direct calls; callable ownership is not supported yet")
    if k == .call and nodes[n].aux == 2 and ownership_type(t):
        si = int(types[prune(t)].st)
        loop i in [0..int(structs[si].nfields)):
            if ownership_type(int(fields[int(structs[si].fields) + i].type)) and (i >= nkids(n) or kid(n, i) == 0):
                fatal(nodes[n].pos, "an owning field requires completed construction")
    if k == .vardecl and not has_flag(n, NF_GLOBAL) and nkids(n) == 0 and nodes[n].sym > 0 and ownership_type(int(locals[int(nodes[n].sym)].type)) and nodes[n].b == 0 and tkind(int(locals[int(nodes[n].sym)].type)) != .array and not is_map_type(int(locals[int(nodes[n].sym)].type)):
        fatal(nodes[n].pos, "an owner requires completed construction before registration")
    if k == .assign and ownership_type(ntype(int(nodes[n].a))):
        target = int(nodes[n].a)
        if nodes[target].kind == .ident and nodes[target].aux == i32(int(SK.local)):
            l = int(nodes[target].sym)
            if int(locals[l].flags) & (LF_MUTPARAM | LF_ALIAS | LF_BYREF) != 0:
                fatal(nodes[n].pos, "cannot replace a borrowed owner")
        else if nodes[target].kind != .index or tkind(ntype(int(nodes[target].a))) != .array:
            fatal(nodes[n].pos, "owner replacement requires a whole local or growable array element")
    if k == .defer_ and ownership_functions.has(f):
        fatal(nodes[n].pos, "an owner with defer requires a unified defer unwind plan; transfer is not proven safe")
    if k == .conv and nodes[n].aux == i32(int(CV.explicit_copy)) and ownership_type(ntype(n)) and not ownership_copyable(ntype(n)):
        fatal(nodes[n].pos, "cannot copy a move-only owner: no $__copy__ hook")
    loop c in copy_children(n): ownership_validate_node(c, f)

ownership_validate = ():
    if ownership_decls.len() == 0: return
    loop f, active in ownership_functions:
        if fns[f].cabi or len(fns[f].export_name) != 0:
            fatal(nodes[int(fns[f].decl)].pos, "foreign entry points with owners require per-foreign-thread cleanup storage")
    loop g in globals:
        if g.type > 0 and ownership_contains(int(g.type)):
            fatal(nodes[int(g.decl)].pos, "global owners require a program-lifetime cleanup plan")
    loop f in [1..fns.len()):
        loop l in fns[f].locals:
            t = int(locals[l].type)
            if not ownership_contains(t): continue
            if not ownership_type(t): fatal(locals[l].pos, "resource containers require aggregate ownership support")
            if int(locals[l].flags) & (LF_CAPTURE | LF_CAPTURED | LF_SHARED) != 0:
                fatal(locals[l].pos, "captured owners require closure ownership support")
        ownership_validate_node(int(fns[f].body), f)

# The literal-only diagnostic path has no allocation or language failure. It
# flushes earlier output, then uses the runtime's best-effort raw write. Dynamic
# formatting remains subject to the ordinary conservative failure summary.
ownership_prints: {int: bool}
ownership_literal_print = (n: int) -> bool:
    if ownership_decls.len() == 0 or nodes[n].kind != .call or nodes[n].aux != 0 or nkids(n) != 1: return false
    printer = runtime_insts.get("__print_str") ?? 0
    if printer == 0 or int(nodes[n].sym) != printer: return false
    a = kid(n, 0)
    if nodes[a].kind != .str_lit or nodes[a].aux != 0: return false
    ownership_prints[n] = true
    true


ownership_reset = ():
    ownership_decls.clear()
    ownership_hooks.clear()
    ownership_copies.clear()
    ownership_moves.clear()
    ownership_nominals.clear()
    owner_map_copies.clear()
    ownership_functions.clear()
    ownership_contained.clear()
    ownership_prints.clear()

# A hook constructs directly into a fresh result slot. Its result is adopted;
# routing it through ordinary copying would recursively invoke the same hook.
owner_hook_result = (f: int, source: int, t: int) -> Val:
    slot = new_temp(t)
    addr = e_slot(slot)
    owner_hook_into(f, source, t, addr)
    owner_register(slot, t)
    Val(addr, true, slot)

# Fresh scalar-field results have no allocation/copy adapter. Hook calls are
# inventoried separately; this does not certify a semantic copy as plain data.
ownership_scalar = (t: int) -> bool:
    if not ownership_type(t): return false
    ownership_inline(t)

ownership_inherit = (child: int):
    parent = nominal_parent.get(child) ?? 0
    if parent == 0: return
    ownership_inherit(parent)
    if not ownership_type(parent): return
    layout(child)
    si = int(types[child].st)
    loop field in field_list(child):
        if not ownership_inline(field.0):
            fatal(nodes[int(structs[si].decl)].pos, "resource fields currently require an inline record layout")
    if structs[si].drop_fn == 0: structs[si].drop_fn = structs[int(types[parent].st)].drop_fn
    if not ownership_copies.has(child):
        if let hook = ownership_copies.get(parent): ownership_copies[child] = hook
    if not ownership_moves.has(child):
        if let hook = ownership_moves.get(parent): ownership_moves[child] = hook
    types[child].flags |= i32(TF_MANAGED)

owner_hook_into = (f: int, source: int, t: int, dest: int):
    e_call(lf_of_inst(f), [dest, source], -1)
    # An inherited role builds only its declaring parent. Preserve the child's
    # added fields and complete nominal identity at the owning boundary.
    parent = prune(int(fns[f].ret))
    first = int(structs[int(types[parent].st)].nfields)
    fields_ = field_list(t)
    loop i in [first..fields_.len()):
        field = fields_[i]
        dst = e_addi(dest, field.1)
        src = e_addi(source, field.1)
        if ownership_hooks[int(fns[f].decl)] == 3 and ownership_type(field.0):
            e_call(lf_helper(.move, field.0, 0), [dst, src], -1)
        else:
            store_val(field.0, dest, field.1, load_val(field.0, source, field.1))
            if ownership_hooks[int(fns[f].decl)] == 2: copy_at(dst, field.0)

ownership_declared = (decl: int) -> bool:
    ownership_decls.has(decl * 4 + 1) or ownership_decls.has(decl * 4 + 2) or ownership_decls.has(decl * 4 + 3)

ownership_copyable = (t0: int) -> bool:
    t = prune(t0)
    if tkind(t) == .fixed or tkind(t) == .array: return ownership_copyable(telem(t))
    if not ownership_type(t): return true
    first = 0
    if let hook = ownership_copies.get(t):
        parent = prune(int(fns[hook].ret))
        first = int(structs[int(types[parent].st)].nfields)
    else if structs[int(types[t].st)].drop_fn != 0: return false
    fs = field_list(t)
    loop i in [first..fs.len()):
        if ownership_type(fs[i].0) and not ownership_copyable(fs[i].0): return false
    true

ownership_inline = (t0: int, depth: int = 0) -> bool:
    t = prune(t0)
    if effect_scalar(t) or tkind(t) == .float_: return true
    if depth > 32: return false
    if tkind(t) == .fixed: return ownership_inline(telem(t), depth + 1)
    if tkind(t) != .struct_: return false
    layout(t)
    si = int(types[t].st)
    loop i in [0..int(structs[si].nfields)):
        field = fields[int(structs[si].fields) + i]
        if field.boxed or not ownership_inline(int(field.type), depth + 1): return false
    true

# Fact checking can precede hook instantiation. Consult declarations rather
# than the finalized lowering IDs, keeping ordinary COW values unchanged.
ownership_fact_type = (t0: int, depth: int = 0) -> bool:
    t = representation_type(t0)
    if depth > 32: return true
    if tkind(t) == .fixed or tkind(t) == .array: return ownership_fact_type(telem(t), depth + 1)
    if tkind(t) != .struct_: return false
    si = int(types[t].st)
    if ownership_declared(int(structs[si].decl)): return true
    parent = nominal_parent.get(t) ?? 0
    if parent != 0 and ownership_fact_type(parent, depth + 1): return true
    layout(t)
    loop i in [0..int(structs[si].nfields)):
        if ownership_fact_type(int(fields[int(structs[si].fields) + i].type), depth + 1): return true
    false

# A hook constructs its result; returning a proved-dead local adopts that
# construction rather than recursively invoking the same lifecycle role.
owner_adopt_result = (n: int):
    if n == 0: return
    k = nodes[n].kind
    if k == .if_:
        owner_adopt_result(int(nodes[n].b))
        owner_adopt_result(int(nodes[n].c))
    else if k == .block and nkids(n) > 0:
        owner_adopt_result(kid(n, nkids(n) - 1))
    else if k == .exprstmt: owner_adopt_result(int(nodes[n].a))
    else: owner_adoptions[n] = true

# Containers remain finite layouts, but copying them can allocate. Keep this
# separate from the no-allocation inline predicate used by effect summaries.
ownership_layout = (t0: int, depth: int = 0) -> bool:
    if depth > 32: return false
    t = prune(t0)
    k = tkind(t)
    if k == .array:
        if ownership_type(telem(t)): return ownership_inline(telem(t))
        return ownership_layout(telem(t), depth + 1)
    if k == .fixed: return ownership_inline(telem(t), depth + 1)
    if k == .str_ or effect_scalar(t) or k == .float_: return true
    if k != .struct_: return false
    if not is_map_type(t): return ownership_inline(t, depth)
    loop field in field_list(t):
        if not ownership_layout(field.0, depth + 1): return false
    true

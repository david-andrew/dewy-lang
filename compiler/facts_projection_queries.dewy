$runtime_checks

from p"facts.jo" import (FactProjection FactState)
from p"facts_value_queries.dewy" import (fact_index_get fact_index_get_raw)

ProjectionWord:type=int64<overflow='wrap'>

# Read-only queries over a state's projection records. Below
# FACT_PROJECTION_SCAN records a state has no indexes and is scanned in order;
# the indexes, once built, give the same first records.
fact_projections_indexed=(s:FactState):>bool=>$unsafe {s.index.ptr[0].projection_next.length not=? 0}
fact_projection_find=(s:FactState base:ProjectionWord selector:ProjectionWord element:bool):>int64=>$unsafe {
    if (ProjectionWord(s.proj_base_mask) & (ProjectionWord(1) << (base & 63))) =? 0 {return -1}
    let idx=s.index.ptr
    if idx[0].projection_next.length not=? 0 {return fact_index_get_raw(idx[0].projection_index.ptr idx[0].projection_index.length fact_projection_key(base selector element))}
    let ps=s.projections.ptr
    let n:ProjectionWord=s.projections.length
    loop i in [0..n) {
        if ps[i].base =? base and ps[i].selector =? selector and ps[i].element =? element {return i}
    }
    -1
}
fact_projection_first=(s:FactState base:ProjectionWord):>int64=>$unsafe {
    if (ProjectionWord(s.proj_base_mask) & (ProjectionWord(1) << (base & 63))) =? 0 {return -1}
    let idx=s.index.ptr
    if idx[0].projection_next.length not=? 0 {return fact_index_get_raw(idx[0].projection_head.ptr idx[0].projection_head.length base)}
    let ps=s.projections.ptr
    let n:ProjectionWord=s.projections.length
    loop i in [0..n) {
        if ps[i].base =? base {return i}
    }
    -1
}
fact_projection_after=(s:FactState i:ProjectionWord):>int64=>$unsafe {
    let idx=s.index.ptr
    if idx[0].projection_next.length not=? 0 {return idx[0].projection_next.ptr[i]}
    let ps=s.projections.ptr
    let base=ps[i].base
    let n:ProjectionWord=s.projections.length
    loop j in [i + 1..n) {
        if ps[j].base =? base {return j}
    }
    -1
}
# A write may append projections or compact its state while traversing the
# old projections. Keep the records and links from the same snapshot.
fact_projection_next_in=(projections:array<FactProjection> links:array<int64> i:ProjectionWord):>int64=>$unsafe {
    if links.length not=? 0 {return links.ptr[i]}
    let ps=projections.ptr
    let base=ps[i].base
    let n:ProjectionWord=projections.length
    loop j in [i + 1..n) {
        if ps[j].base =? base {return j}
    }
    -1
}
fact_projection_origin=(s:FactState value:ProjectionWord):>int64=>$unsafe {
    let idx=s.index.ptr
    if idx[0].projection_next.length not=? 0 {return fact_index_get_raw(idx[0].projection_value.ptr idx[0].projection_value.length value)}
    let ps=s.projections.ptr
    let n:ProjectionWord=s.projections.length
    loop i in [0..n) {
        if not ps[i].element and ps[i].value =? value {return i}
    }
    -1
}

from p"facts_values.dewy" import (fact_projection_key)

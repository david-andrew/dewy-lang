use 'ir_types.dewy'
# Inlining for release builds. All functions are lowered and optimized first; then calls to
# small non-recursive functions are replaced by a copy of the callee's body (with renamed
# vregs and frame slots, and `ret` turned into a branch out of a wrapping block), and the
# caller is optimized again.

use 'ir.jo'
use 'check.jo'
use 'opt.jo'
use 'partition.jo'
use 'partition_ops.dewy'
use 'ir_builders.dewy'
use 'callback_specialize.jo'
use 'inline_ops.dewy'

const FAST_CALLBACK_MAX = 256
const INLINE_MAX = 24       # callee size limit, in IR instructions
const INLINE_LOOP_MAX = 96  # ... for a call in a loop to a leaf (a function that calls nothing)
const INLINE_WRAPPER_MAX = 64   # ... for a leaf called once by a function at most this size
const INLINE_LOOPY_CALLER_MAX = 400     # (a leaf with a loop: only into callers this small)
# Extra expansion only when a constant formal controls an entry-region branch.
const INLINE_SPECIALIZE_MAX = 128
const INLINE_SPECIALIZE_GROWTH = 256
const INLINE_SPECIALIZE_CALLER_MAX = 4000
inl_const_growth = 0
inl_const_target = false
inl_calls = 0               # calls (that return, not on rare paths) in the function being inlined into

rel_fns: IrFn[]             # lowered functions, in lowering order
rel_by_index: int[]         # lfunc index -> position in rel_fns (-1: not collected)

# Default builds expand tiny leaves and one layer of small wrappers before
# their one local pass. Wrapper expansion is bounded and uses only original
# leaves, so declaration order cannot grow an arbitrary call chain.
# No callee optimization, call-graph ordering or repeated caller optimization.
fast_fns: IrFn[]
fast_by_index: int[]
fast_loop_only: bool[]
fast_moves: bool[]

# Sites calling each known-callback version: a version with one site moves there.
fast_callback_sites: {int: int}
fast_callback_depth = 0

fast_inline_target = (ins: Ins, in_loop: bool) -> int:
    if ins.op != .call or ins.c != 0 or ins.imm >= fast_by_index.len(): return -1
    j = fast_by_index[int(ins.imm)]
    if j < 0 or fast_fns[j].fn_index == ir.fn_index or int(ins.b) != fast_fns[j].nparams: return -1
    if fast_loop_only[j] and not in_loop: return -1
    j

# (in a large caller, what a moved loop keeps in registers may not get them; asked only of
# a call that has a target, this hot path's target test staying a leaf)
fast_keeps_call = (j: int) -> bool: fast_moves[j] and fast_fns[j].code.len() > 64 and ir.code.len() > INLINE_LOOPY_CALLER_MAX

fast_inline_into = ():
    if fast_fns.len() == 0: return
    found = false
    loop ins in ir.code:
        j = fast_inline_target(ins, true)
        if j >= 0 and not fast_keeps_call(j):
            found = true
            break
    if not found: return
    out: Ins[]
    out.reserve(ir.code.len() * 2)
    old = ir.code
    depth = 0
    loop_depth = 0
    moved = false
    loop ins in old:
        if ins.op == .block or ins.op == .loop or ins.op == .if_: depth += 1
        if ins.op == .loop and loop_depth == 0: loop_depth = depth
        if ins.op == .end:
            if depth == loop_depth: loop_depth = 0
            depth -= 1
        j = fast_inline_target(ins, loop_depth > 0)
        if j >= 0 and not fast_keeps_call(j):
            inline_call(ins, fast_fns[j], out)
            if fast_moves[j]: moved = true
        else: out.push(ins)
    ir.code = out
    # A moved callback version brings its raw calls: its own leaves, and versions nested
    # at most callback_request's four levels.
    if moved and fast_callback_depth < 4:
        fast_callback_depth += 1
        fast_inline_into()
        fast_callback_depth -= 1
        return
    o_copy_forward()

defines_value = (op: Op) -> bool:
    match op:
        nop, block, loop, end, else_, br, brif, brtable, if_, ret, trap, store, copy, zero, memcpy, memset, zeroslots, assume, vop: false
        _: true

# Rename operands using the optimizer's shared operand classification. Maps
# and the callee are borrowed for this call and never resized while borrowed.
remap = (c0: Ins, callee: *IrFn, vm: *int, sm: *int) -> Ins:
    c = c0
    op = c.op
    a = int(c.a)
    bb = int(c.b)
    args = data(callee.args)
    if op == .slot: c.a = i32(sm[a])
    else if op == .zeroslots:
        s = ir.args.len()
        loop k in [0..bb):
            item = int(args[a + k])
            if item & 1 == 1: ir.args.push(i32((vm[item >> 1] << 1) | 1))
            else: ir.args.push(i32(sm[item >> 1] << 1))
        c.a = i32(s)
    else:
        mask = o_decode[int(op)] >> 8
        if mask & 16 != 0:
            s = ir.args.len()
            loop k in [0..bb): ir.args.push(i32(vm[int(args[a + k])]))
            c.a = i32(s)
        else:
            if mask & 1 != 0 or (mask & 32 != 0 and a >= 0): c.a = i32(vm[a])
            if mask & 2 != 0 or (mask & 64 != 0 and int(c.c) & M_INDEX != 0): c.b = i32(vm[bb])
            if mask & 8 != 0 or (mask & 128 != 0 and int(c.c) & M_INDEX != 0): c.dst = i32(vm[int(c.dst)])
        if mask & 4 != 0: c.c = i32(vm[int(c.c)])
        if op == .brtable:
            s = ir.args.len()
            loop k in [0..bb): ir.args.push(args[int(c.c) + k])
            c.c = i32(s)
    if defines_value(op) and c.dst >= 0 and op != .store: c.dst = i32(vm[int(c.dst)])
    c

inline_span = (out: mut Ins[], source: *Ins, start: int, count: int):
    if count == 0: return
    n = out.len()
    out.resize(n + count)
    mem_copy(data(out) + n, source + start, count * size_of(Ins))

# Summaries are built only on demand. Holding the immutable body keeps its
# address a valid cache key (a rewritten body gets a fresh COW allocation).
# Branch analysis is O(body + vregs) once per demanded body, with indexed state.
# Stop before effects/loops: a constant tested only on a slow path does not pay
# for duplicating the hot path. This is a profitability hint, not a proof used
# to remove code; the ordinary optimizer performs all actual constant folding.
inline_branch_cache: int[]
inline_branch_body: Ins[][]

# The same body identity guards the final-IR register summary. O(body + vregs
# + call operands) once per demanded body. Each copy still initializes a dense
# O(vregs) map, but adds only live vregs to the caller's later analyses.
inline_live_cache: int[][]
inline_body_cache: Ins[][]
inline_nv_cache: int[]

inline_live_regs = (callee: IrFn) -> int[]:
    index = callee.fn_index
    loop inline_live_cache.len() <= index:
        inline_live_cache.push([])
        inline_body_cache.push([])
        inline_nv_cache.push(-1)
    if data(inline_body_cache[index]) == data(callee.code) and inline_nv_cache[index] == callee.vtypes.len(): return inline_live_cache[index]
    flags = fill(0, callee.vtypes.len())
    used = data(flags)
    loop p in [0..callee.nparams): used[p] = 1
    # Only final-IR operands need caller registers; lowering leaves dead vregs.
    loop ins in callee.code:
        op = ins.op
        if defines_value(op) and ins.dst >= 0 and op != .store: used[int(ins.dst)] = 1
        mask = o_decode[int(op)] >> 8
        if op == .zeroslots:
            loop k in [int(ins.a)..int(ins.a) + int(ins.b)):
                item = int(callee.args[k])
                if item & 1 == 1: used[item >> 1] = 1
        else if mask & 16 != 0:
            loop k in [int(ins.a)..int(ins.a) + int(ins.b)): used[int(callee.args[k])] = 1
        else:
            if mask & 1 != 0 or (mask & 32 != 0 and ins.a >= 0): used[int(ins.a)] = 1
            if mask & 2 != 0 or (mask & 64 != 0 and int(ins.c) & M_INDEX != 0): used[int(ins.b)] = 1
            if mask & 8 != 0 or (mask & 128 != 0 and int(ins.c) & M_INDEX != 0): used[int(ins.dst)] = 1
        if mask & 4 != 0: used[int(ins.c)] = 1
    live: int[]
    loop v in [0..callee.vtypes.len()):
        if used[v] != 0: live.push(v)
    inline_live_cache[index] = live
    inline_body_cache[index] = callee.code
    inline_nv_cache[index] = callee.vtypes.len()
    live

# splice callee's body in place of `call` (appending to out)
inline_call = (call: Ins, callee: IrFn, out: mut Ins[]):
    vm = fill(0, callee.vtypes.len())
    mapped = data(vm)
    loop v in inline_live_regs(callee):
        if int(callee.vtypes[v]) == VK: mapped[v] = k_vreg(callee.kval[v])
        else: mapped[v] = vreg(int(callee.vtypes[v]))
    sm = fill(0, callee.slot_size.len())
    slots = data(sm)
    loop s in [0..callee.slot_size.len()): slots[s] = new_slot(int(callee.slot_size[s]), int(callee.slot_align[s]))
    loop k in [0..int(call.b)):
        p = mapped[k]
        out.push(Ins(.mov, i32(vtype(p)), i32(p), ir.args[int(call.a) + k], 0, 0, 0))
    if callee.raw_mem: ir.raw_mem = true
    out.push(Ins(.block, 0, 0, 0, 0, 0, 0))
    depth = 0
    loop ci in callee.code:
        op = ci.op
        if op == .ret:
            if ci.a >= 0 and call.dst >= 0:
                out.push(Ins(.mov, i32(vtype(int(call.dst))), call.dst, i32(mapped[int(ci.a)]), 0, 0, 0))
            out.push(Ins(.br, 0, 0, 0, 0, 0, depth))
            continue
        ni = remap(ci, &callee, mapped, slots)
        # (the calls of a callee inlined on a rarely taken path are on it too)
        if call.c == 2 and op == .call and ni.c == 0: ni.c = 2
        # (in a backtrace the inlined code is the call's line of the function it is in now)
        ni.pos = call.pos
        out.push(ni)
        if op == .block or op == .loop or op == .if_: depth += 1
        else if op == .end: depth -= 1
    out.push(Ins(.end, 0, 0, 0, 0, 0, 0))

# inline small callees into the current function (ir); returns true if anything changed
inline_into = (self_pos: int, snap: IrFn[], can: int[]) -> bool:
    inl_const_growth = 0
    inl_calls = 0
    # Plan each call once, then copy unchanged spans in bulk. Planning is linear
    # in the caller and call arguments; the plan stores only selected call sites.
    old = ir.code
    instructions = data(old)
    loop pos in [0..old.len()):
        ins = instructions + pos
        if ins.op == .calli or ins.op == .callc: inl_calls += 1
        else if ins.op == .call and ins.c == 0:
            j = inline_callee(ins[0], self_pos, snap)
            if j < 0 or can[j] != 1: inl_calls += 1
    depth = 0
    kinds: Op[]
    positions: int[]
    targets: int[]
    loop pos in [0..old.len()):
        ins = instructions + pos
        if ins.op == .call:
            j = inline_target(ins[0], depth, self_pos, snap, can)
            if j >= 0:
                positions.push(pos)
                targets.push(j)
                if inl_const_target: inl_const_growth += snap[j].code.len()
        else if ins.op == .block or ins.op == .loop or ins.op == .if_:
            kinds.push(ins.op)
            if ins.op == .loop: depth += 1
        else if ins.op == .end:
            if kinds.pop() == .loop: depth -= 1
    if positions.len() == 0: return false
    out: Ins[]
    out.reserve(old.len() * 2)
    start = 0
    loop k in [0..positions.len()):
        pos = positions[k]
        inline_span(out, instructions, start, pos - start)
        inline_call(instructions[pos], snap[targets[k]], out)
        start = pos + 1
    inline_span(out, instructions, start, old.len() - start)
    ir.code = out
    o_copy_forward()
    true

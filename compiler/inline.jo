use 'opt_copy_forward.dewy'
use 'ir_types.dewy'
# Inlining for release builds. All functions are lowered and optimized first; then calls to
# small non-recursive functions are replaced by a copy of the callee's body (with renamed
# vregs and frame slots, and `ret` turned into a branch out of a wrapping block), and the
# caller is optimized again.

use 'ir.jo'
use 'check.jo'
use 'opt.jo'
use 'partition.jo'
use 'partition_ops.dewy'
use 'ir_builders.dewy'
use 'callback_specialize.jo'
use 'inline_ops.dewy'

const FAST_CALLBACK_MAX = 256
const INLINE_MAX = 24       # callee size limit, in IR instructions
const INLINE_LOOP_MAX = 96  # ... for a call in a loop to a leaf (a function that calls nothing)
const INLINE_WRAPPER_MAX = 64   # ... for a leaf called once by a function at most this size
const INLINE_LOOPY_CALLER_MAX = 400     # (a leaf with a loop: only into callers this small)
# Extra expansion only when a constant formal controls an entry-region branch.
const INLINE_SPECIALIZE_MAX = 128
const INLINE_SPECIALIZE_GROWTH = 256
const INLINE_SPECIALIZE_CALLER_MAX = 4000
inl_const_growth = 0
inl_const_target = false
inl_calls = 0               # calls (that return, not on rare paths) in the function being inlined into

rel_fns: IrFn[]             # lowered functions, in lowering order
rel_by_index: int[]         # lfunc index -> position in rel_fns (-1: not collected)

# Default builds expand tiny leaves and one layer of small wrappers before
# their one local pass. Wrapper expansion is bounded and uses only original
# leaves, so declaration order cannot grow an arbitrary call chain.
# No callee optimization, call-graph ordering or repeated caller optimization.
fast_fns: IrFn[]
fast_by_index: int[]
fast_loop_only: bool[]
fast_moves: bool[]
fast_inline_loop_only = false   # (a wrapper being made that itself goes only into loops)

# Sites calling each known-callback version: a version with one site moves there.
fast_callback_sites: {int: int}
fast_callback_depth = 0

# Summaries are built only on demand. Holding the immutable body keeps its
# address a valid cache key (a rewritten body gets a fresh COW allocation).
# Branch analysis is O(body + vregs) once per demanded body, with indexed state.
# Stop before effects/loops: a constant tested only on a slow path does not pay
# for duplicating the hot path. This is a profitability hint, not a proof used
# to remove code; the ordinary optimizer performs all actual constant folding.
inline_branch_cache: int[]
inline_branch_body: Ins[][]

# The same body identity guards the final-IR register summary. O(body + vregs
# + call operands) once per demanded body. Each copy still initializes a dense
# O(vregs) map, but adds only live vregs to the caller's later analyses.
inline_live_cache: int[][]
inline_body_cache: Ins[][]
inline_nv_cache: int[]

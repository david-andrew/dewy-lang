$runtime_checks
from p"scan.jo" import SU_NOMINAL
from p"scan.jo" import (SC_NAME SC_STR SU_EAGER SU_EXPORT SU_WHEN sc_attr_open sc_cls sc_n sc_p sc_src sc_unit su_end su_flags su_name0 su_name_at su_name_len su_start)

ScanWord:type=int64<overflow='wrap'>
sc_ident_char=(c:uint8):>bool=>$unsafe {
    sc_cls[ScanWord(c)] & SC_NAME not=? 0
}
# past the string whose quote is at i0, as lx_skip_str reads it; -1 if it does not end
sc_skip_str=(i0:ScanWord raw:bool):>ScanWord=>$unsafe {
    let p=sc_p
    let n=sc_n
    let cls=sc_cls
    let q=p[i0]
    let triple=q =? b'"' and i0 + 2 <? n and p[i0 + 1] =? b'"' and p[i0 + 2] =? b'"'
    let i=i0 + 1
    if triple {i=i0 + 3}
    let depth:ScanWord=0
    loop i <? n {
        # (ordinary bytes in bulk)
        loop i <? n and cls[ScanWord(p[i])] & SC_STR =? 0 {i += 1}
        if i >=? n {break}
        let c=p[i]
        if depth =? 0 {
            if c =? b'\\' and not raw {
                i += 2
                continue
            }
            if triple {
                if c =? b'"' and i + 2 <? n and p[i + 1] =? b'"' and p[i + 2] =? b'"' {return i + 3}
            }
            else if c =? q {return i + 1}
            if not raw and c =? 123 {
                if i + 1 <? n and p[i + 1] =? 123 {
                    i += 2
                    continue
                }
                depth=1
            }
        }
        else {
            if c =? 123 {depth += 1}
            else if c =? 125 {depth -= 1}
            else if c =? b'"' or c =? b'\'' {
                let e=sc_skip_str(i false)
                if e <? 0 {return -1}
                i=e
                continue
            }
        }
        i += 1
    }
    -1
}
# the '\n' ending the line that goes on at i (past strings, which may span lines), or the end
sc_line_end=(i0:ScanWord):>ScanWord=>$unsafe {
    let p=sc_p
    let n=sc_n
    let i=i0
    loop true {
        i=__find_delim(p i n)
        if i >=? n {return n}
        let ch=p[i]
        if ch =? b'\n' {return i}
        if ch =? b'#' {return __find_newline(p i n)}
        let raw=i >? 0 and p[i - 1] =? b'r' and (i <? 2 or not sc_ident_char(p[i - 2]))
        i=sc_skip_str(i raw)
        if i <? 0 {return n}
    }
    n
}
sc_word_is=(j:ScanWord w:string):>bool=>$unsafe {
    let k=(w as array<uint8>).length
    let n=sc_n
    if j + k >? n {return false}
    let p=sc_p + j
    let q=data(w)
    loop t in [0..k) {
        if p[t] not=? q[t] {return false}
    }
    j + k >=? n or sc_cls[ScanWord(p[k])] & SC_NAME =? 0
}
sc_spaces=(j0:ScanWord):>ScanWord=>$unsafe {
    let p=sc_p
    let n=sc_n
    let j=j0
    loop j <? n and (p[j] =? b' ' or p[j] =? b'\t') {j += 1}
    j
}
sc_ident_end=(j0:ScanWord):>ScanWord=>$unsafe {
    let p=sc_p
    let n=sc_n
    let cls=sc_cls
    let j=j0
    loop j <? n and cls[ScanWord(p[j])] & SC_NAME not=? 0 {j += 1}
    j
}
# past a bracketed group starting at j ('[' or '('), on this line; -1 when it does not close here
sc_group_end=(j0:ScanWord):>ScanWord=>$unsafe {
    let p=sc_p
    let n=sc_n
    let depth:ScanWord=0
    let j=j0
    loop j <? n and p[j] not=? b'\n' {
        let c=p[j]
        if c =? b'[' or c =? b'(' {depth += 1}
        else if c =? b']' or c =? b')' {
            depth -= 1
            if depth =? 0 {return j + 1}
        }
        j += 1
    }
    -1
}
sc_name=(a:ScanWord b:ScanWord):>void=>$unsafe {
    if b >? a {
        su_name_at.push(a)
        su_name_len.push(b - a)
    }
}
# The declaration (or attributes) on the line at j: its names into the current unit; whether
# the line held attributes alone (the declaration is on a later line)
sc_classify=(src:string j0:ScanWord):>bool=>$unsafe {
    let j=j0
    let p=sc_p
    let n=sc_n
    let attrs=false
    loop j <? n and p[j] =? b'@' {
        let e=sc_ident_end(j + 1)
        let a0=p[j + 1]
        if a0 =? b'n' and sc_word_is(j + 1 "nominal") {su_flags[sc_unit] |= SU_NOMINAL}
        if a0 =? b'e' and sc_word_is(j + 1 "export") {su_flags[sc_unit] |= SU_EXPORT}
        j=e
        if j <? n and p[j] =? b'(' {
            let g=sc_group_end(j)
            if g <? 0 {
                su_flags[sc_unit] |= SU_EAGER
                return false
            }
            j=g
        }
        j=sc_spaces(j)
        attrs=true
    }
    if j >=? n or p[j] =? b'\n' or p[j] =? b'#' or p[j] =? b'\r' {return attrs}
    # (keywords by their first letter: most lines start with a name)
    let c0=p[j]
    if c0 =? b'w' and sc_word_is(j "when") {
        su_flags[sc_unit] |= SU_WHEN
        return false
    }
    if (c0 =? b'c' and sc_word_is(j "const")) or (c0 =? b's' and sc_word_is(j "struct")) or (c0 =? b'e' and ((p[j + 1] =? b'n' and sc_word_is(j "enum")) or (p[j + 1] =? b'x' and sc_word_is(j "extern")))) {
        let k=sc_spaces(sc_ident_end(j))
        sc_name(k sc_ident_end(k))
        return false
    }
    if c0 =? b't' and sc_word_is(j "type") {
        let k=sc_spaces(sc_ident_end(j))
        let e=sc_ident_end(k)
        let a=sc_spaces(e)
        if e >? k and a <? sc_n and (p[a] =? b'=' or p[a] =? b'[') {
            sc_name(k e)
            return false
        }
    }
    if p[j] =? b'(' {
        # an operator's declaration: ([]=)[K, V] = ...
        let k=j + 1
        loop k <? sc_n and p[k] not=? b')' and p[k] not=? b'\n' {k += 1}
        if k <? sc_n and p[k] =? b')' {
            sc_name(j + 1 k)
            return false
        }
        su_flags[sc_unit] |= SU_EAGER
        return false
    }
    if sc_ident_char(p[j]) and not (p[j] >=? b'0' and p[j] <=? b'9') {
        # name [= | : | [T] =], or a, b = ...
        let first=su_name_at.length
        let k=j
        loop true {
            let e=sc_ident_end(k)
            sc_name(k e)
            k=sc_spaces(e)
            if k <? sc_n and p[k] =? b'[' {
                let g=sc_group_end(k)
                if g <? 0 {break}
                k=sc_spaces(g)
            }
            if k <? sc_n and p[k] =? b',' {
                k=sc_spaces(k + 1)
                if k <? sc_n and sc_ident_char(p[k]) {continue}
                break
            }
            if k <? sc_n and ((p[k] =? b'=' and (k + 1 >=? sc_n or p[k + 1] not=? b'=')) or p[k] =? b':') {
                if (c0 =? b'u' and sc_word_is(j "use")) or (c0 =? b'f' and sc_word_is(j "from")) or (c0 =? b'i' and sc_word_is(j "import")) {break}
                return false
            }
            break
        }
        su_name_at.truncate(first)
        su_name_len.truncate(first)
    }
    su_flags[sc_unit] |= SU_EAGER
    false
}
sc_open=(at:ScanWord):>void=>$unsafe {
    if sc_unit >=? 0 {su_end[sc_unit]=at}
    su_start.push(at)
    su_end.push(sc_n)
    su_flags.push(0)
    su_name0.push(su_name_at.length)
    sc_unit=su_start.length - 1
}
# Index src: its units are su_start.len() before the call .. after it (su_name0 gets the closing
# entry too: a unit's names end where the next one's begin). The search goes from one line that is
# not indented to the next (__find_line_delim), following strings and comments; only a `when`
# unit's lines are each looked at, for its branches' declarations.
scan_source=(src:string):>[ScanWord ScanWord]=>$unsafe {
    if (sc_cls as uint64) =? 0 {
        sc_cls=__alloc(256)
        loop c in [0..256) {
            let k:ScanWord=0
            if (c >=? b'a' and c <=? b'z') or (c >=? b'A' and c <=? b'Z') or (c >=? b'0' and c <=? b'9') or c =? b'_' {k=SC_NAME}
            if c =? b'"' or c =? b'\'' or c =? b'\\' or c =? 123 or c =? 125 {k=SC_STR}
            sc_cls[c]=uint8(k)
        }
    }
    sc_src=src
    sc_p=data(src)
    sc_n=(src as array<uint8>).length
    let p=sc_p
    let n=sc_n
    let u0=su_start.length
    if su_name0.length >? u0 {su_name0.truncate(u0)}
    sc_unit=-1
    sc_attr_open=false
    let i:ScanWord=0
    loop i <? n {
        # i: the start of a line that is not indented (or a blank one, or a comment's)
        let c=p[i]
        if c =? b'\n' {
            i += 1
            continue
        }
        if c =? b'#' {
            # (a comment's line: a run of them read one by one, then the search goes on)
            i=__find_newline(p i n)
            if i >=? n {break}
            if i + 1 <? n and p[i + 1] =? b'#' {i += 1}
            else {i=sc_next_line(i 0)}
            continue
        }
        if c =? b' ' or c =? b'\t' or c =? b'\r' {
            # (an indented line here: the file's first)
            i=sc_next_line(i 0)
            continue
        }
        if c =? b'e' and sc_unit >=? 0 and su_flags[sc_unit] & SU_WHEN not=? 0 and sc_word_is(i "else") {
            i=sc_when_lines(i)
            continue
        }
        if c =? b')' or c =? b']' or c =? 125 {
            if sc_unit >=? 0 {su_flags[sc_unit] |= SU_EAGER}
            i=sc_next_line(i 0)
            continue
        }
        if sc_attr_open {sc_attr_open=false}
        else {sc_open(i)}
        sc_attr_open=sc_classify(src i)
        if su_flags[sc_unit] & SU_WHEN not=? 0 {i=sc_when_lines(i)}
        else {i=sc_next_line(i 0)}
    }
    if sc_unit >=? 0 {su_end[sc_unit]=n}
    su_name0.push(su_name_at.length)
    [u0 su_start.length]
}
# The lines of a `when` unit from its header (or an `else` of it) at i: the declarations of its
# branches (at each branch's indentation; a nested `when` opens one more) name the unit. Lines
# deeper than the innermost branch are skipped in bulk where its indentation is 4 or 8. Returns
# where the next line that is not indented starts.
sc_when_lines=(i0:ScanWord):>ScanWord=>$unsafe {
    let p=sc_p
    let n=sc_n
    # (the branches' indentations, innermost last: branch[0..nb), its top bt; -1 until a
    # branch's first line sets it)
    let branch:array<int64>=[-1]
    let nb:ScanWord=1
    let bt:ScanWord=-1
    let i=sc_line_end(i0) + 1
    loop i <? n {
        let j=i
        let ind:ScanWord=0
        loop j <? n and (p[j] =? b' ' or p[j] =? b'\t' or p[j] =? b'\r') {
            if p[j] =? b' ' {ind += 1}
            else if p[j] =? b'\t' {ind=(ind + 4) & ~3}
            j += 1
        }
        if j >=? n {return n}
        let c=p[j]
        if c =? b'\n' or c =? b'#' {
            i=__find_newline(p j n) + 1
            continue
        }
        if ind =? 0 {return i}
        loop nb >? 0 and bt >=? 0 and ind <? bt {
            nb -= 1
            if nb >? 0 {bt=branch[nb - 1]}
        }
        let w:ScanWord=-1
        if nb >? 0 {
            if bt <? 0 {
                bt=ind
                branch[nb - 1]=ind
            }
            if ind =? bt {
                if (c =? b'w' and sc_word_is(j "when")) or (c =? b'e' and p[j + 1] =? b'l' and sc_word_is(j "else")) {
                    if nb <? branch.length {branch[nb]=-1}
                    else {branch.push(-1)}
                    nb += 1
                    bt=-1
                }
                else {
                    let f=su_flags[sc_unit]
                    sc_classify(sc_src j);
                    # (a statement in a branch: the unit is still a `when`, kept whole)
                    su_flags[sc_unit]=su_flags[sc_unit] | (f & SU_WHEN)
                }
            }
            w=bt
        }
        i=sc_next_line(j w)
    }
    n
}
# from i, inside a line, past strings and comments to the start of the next line indented by at
# most w columns (0, 4 or 8; any other w: the next line)
sc_next_line=(i0:ScanWord w:ScanWord):>ScanWord=>$unsafe {
    if w not=? 0 and w not=? 4 and w not=? 8 {return sc_line_end(i0) + 1}
    let p=sc_p
    let n=sc_n
    let i=i0
    loop true {
        if w =? 0 {i=__find_line_delim(p i n)}
        else if w =? 4 {i=__find_line_delim4(p i n)}
        else {i=__find_line_delim8(p i n)}
        if i >=? n {return n}
        let ch=p[i]
        if ch =? b'\n' {return i + 1}
        if ch =? b'#' {i=__find_newline(p i n)}
        else {
            let raw=i >? 0 and p[i - 1] =? b'r' and (i <? 2 or not sc_ident_char(p[i - 2]))
            i=sc_skip_str(i raw)
            if i <? 0 {return n}
        }
    }
    n
}

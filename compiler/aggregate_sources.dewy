AggregateSourceWord:type=int64<overflow='wrap'>
const AGGREGATE_GLOBAL:int32=2 # SK.global
const AGGREGATE_CONST:int32=6 # SK.const_

# make array literal n (already checked as T[]) the fixed-size array type `to`
fixed_literal=(n:AggregateSourceWord to:AggregateSourceWord):>void=>{
    let et=AggregateSourceWord(types[prune(to)].elem)
    if nkids(n) =? 0 and fixed_len(to) >? 0 {concurrency_require_zero(n et)}
    if refine_active and nkids(n) =? 0 and fixed_len(to) >? 0 and ref_storage_contract(et) {
        let value=struct_default(et nodes[n].pos)
        if value not=? 0 {
            set_list(n [value])
            nodes[n].b=int32(bc_int(fixed_len(to) nodes[n].pos))
            nodes[AggregateSourceWord(nodes[n].b)].type=int32(T_INT)
        }
    }
    if nodes[n].b not=? 0 {
        let c=AggregateSourceWord(nodes[n].b)
        let root=c
        loop nodes[root].kind =? 'conv' {root=AggregateSourceWord(nodes[root].a)}
        if nodes[root].kind =? 'ident' and dewy_at(nodes[n].pos) and (nodes[root].aux =? AGGREGATE_GLOBAL and readonly_global(AggregateSourceWord(nodes[root].sym)) or nodes[root].aux =? AGGREGATE_CONST) {
            if ceval(root).i =? fixed_len(to) {
                nodes[n].b=int32(bc_int(fixed_len(to) nodes[n].pos))
                c=AggregateSourceWord(nodes[n].b)
                nodes[c].type=int32(T_INT)
            }
        }
        if nodes[c].kind not=? 'int_lit' or nodes[c].ival not=? fixed_len(to) {fatal(nodes[n].pos "a fixed-size array of {fixed_len(to)} elements needs the count {fixed_len(to)} here")}
        coerce(kid(n 0) et);
    }
    else {
        loop i in [0..nkids(n)) {coerce(kid(n i) et);}
    }
    nodes[n].type=int32(to)
    clear_flag(n NF_LITERAL)
}

# With no written field names, the first spread distinguishes `[xs...]` from
# `[record...]`. Inspect a clone so contextual checking retains the source AST.
dewy_spread_source_type=(n:AggregateSourceWord):>AggregateSourceWord=>{
    if nodes[n].type not=? 0 and has_flag(n NF_CHECKED) {return prune(ntype(n))}
    let copy=clone(n)
    let site = @sink_pack_site
    let saved=site
    site=copy
    let t=check_expr(copy 0)
    site=saved
    let hit = @sink_pack_hit
    hit=0
    prune(t)
}

# (`[f()...]`, f a function or function value by name: it may give several values)
values_spread_call=(c:AggregateSourceWord):>bool=>{
    let callee=AggregateSourceWord(nodes[c].a)
    if nodes[callee].kind not=? 'ident' or has_flag(c NF_CHECKED) {return false}
    let s=lookup(AggregateSourceWord(nodes[callee].name))
    if s =? 0 {return false}
    let k=syms[s].kind
    k =? 'fns' or k =? 'local' or k =? 'global'
}

dewy_classify_spread=(n:int64):>void=>$unsafe {
    if nodes.ptr[n].kind not=? 'array' or nodes.ptr[n].b not=? 0 or nkids(n) =? 0 {return}
    let first=kid(n 0)
    if not has_flag(first NF_SPREAD) or not files.ptr[pos_file(nodes.ptr[n].pos)].is_dewy {return}
    if dewy_set_literal(first) {return}
    # (`[[x]...]`: an array literal spread is an array, never a record)
    if nodes.ptr[first].kind =? 'array' and nodes.ptr[first].b =? 0 {return}
    let t=dewy_spread_source_type(first)
    if types.ptr[t].kind =? 'struct_' and not is_map_type(t) and not is_dewy_set_type(t) {nodes.ptr[n].kind='record_lit'}
}

# `f([Png Jpeg] ...)`, `$named[Png Jpeg]` (decisions.md, batch 7): a call of a Dewy function given
# a sequence of types is specialized on that sequence. Its body is checked in place, the first
# parameter standing for the types and the other arguments bound by name, as a block giving
# its value. -1 when n is no such call. Checked once per call; O(1) for any other call.
type_sequence_call=(n:int64 expected:int64):>int64=>$unsafe {
    if nkids(n) =? 0 {return -1}
    let first=kid(n 0)
    if nodes.ptr[first].kind not=? 'array' or nkids(first) =? 0 or not dewy_at(nodes.ptr[n].pos) or not type_value_expr(kid(first 0)) {return -1}
    let callee=AggregateSourceWord(nodes.ptr[n].a)
    let fname=AggregateSourceWord(nodes.ptr[callee].name)
    let s=lookup(fname)
    # (the prelude's `named`, loaded when first called)
    if s =? 0 {s=dewy_prelude_lookup(fname)}
    if s =? 0 or syms.ptr[s].kind not=? 'fns' {return -1}
    let pos=nodes.ptr[n].pos
    let named_args:array<int64>=[]
    loop i in [1..nkids(n)) {
        let a=kid(n i)
        if nodes.ptr[a].kind not=? 'namedarg' {fatal(nodes.ptr[a].pos "after its types, a call specialized on them takes named arguments")}
        named_args.push(a)
    }
    # (the overload whose parameters are the sequence and those names)
    let d:AggregateSourceWord=0
    let candidates:array<int64>=[]
    loop s not=? 0 {
        if syms.ptr[s].name =? int32<overflow='wrap'>(fname) and syms.ptr[s].kind =? 'fns' and syms.ptr[s].decl not=? 0 {candidates.push(AggregateSourceWord(syms.ptr[s].decl))}
        s=AggregateSourceWord(syms.ptr[s].next)
    }
    loop c in candidates {
        if nodes.ptr[c].kind not=? 'fn_' or nkids(c) not=? named_args.length + 1 {continue}
        let fits=true
        loop a in named_args {
            let found=false
            loop j in [1..nkids(c)) {
                if nodes.ptr[kid(c j)].name =? nodes.ptr[a].name {found=true}
            }
            if not found {fits=false}
        }
        if fits {
            d=c
            break
        }
    }
    if d =? 0 {fatal(pos "no {name_of(AggregateSourceWord(nodes[callee].name))} takes a sequence of types with these arguments")}
    let seq=type_sequence(first)
    # (`$named`'s strict rule, the registry's: every type has a name, and no name twice)
    if pos_in_lib(nodes.ptr[d].pos) and name_of(fname) =? "named" {
        let seen:dict<string bool>=[]
        loop i in 0.. and t in seq {
            let text=type_short_name(t)
            let at=nodes.ptr[kid(first i)].pos
            if (text as array<uint8>).length =? 0 {fatal(at "{dt(t)} has no name of its own, so `$named` cannot name its member (give it one, `Name:type = ...`)")}
            if seen.has(text) {fatal(at "field {text} is listed twice")}
            seen[text] = true
        }
    }
    let mark=scope_mark()
    let g=globals.length
    let pname=AggregateSourceWord(nodes.ptr[kid(d 0)].name)
    globals.push(Global(name = int32<overflow='wrap'>(pname) type = int32<overflow='wrap'>(T_VOID) mod = int32<overflow='wrap'>(cur_mod()) is_const = true state = 2))
    type_sequences[g] = seq
    push_scope_sym(pname new_sym(pname 'const_' g 0))
    let statements:array<int64>=[]
    # (`each=@handle`, a function by name: the specialized body calls it by that name, so a
    # generic one is specialized per type rather than needing a value's type)
    let renames:array<int64>=[]
    loop a in named_args {
        let v=AggregateSourceWord(nodes.ptr[a].a)
        let fs=if nodes.ptr[v].kind =? 'ident' {lookup(AggregateSourceWord(nodes.ptr[v].name))} else {0}
        if fs not=? 0 and syms.ptr[fs].kind =? 'fns' {
            renames.push(AggregateSourceWord(nodes.ptr[a].name))
            renames.push(AggregateSourceWord(nodes.ptr[v].name))
        }
        else {statements.push(bc_let(name_of(AggregateSourceWord(nodes.ptr[a].name)) v nodes.ptr[a].pos))}
    }
    loop st in kids(AggregateSourceWord(nodes.ptr[d].b)) {
        # (the parameters' own bindings: given above)
        if nodes.ptr[st].kind =? 'vardecl' and node_aux2(nodes.ptr[st].op_ext) =? 1 {continue}
        let copy=clone(st)
        if renames.length >? 0 {rename_idents(copy renames)}
        statements.push(copy)
    }
    nodes[n] = Node(kind = 'block' pos = pos aux = 1)
    set_list(n statements)
    let t=check_expr(n expected)
    scope_reset(mark)
    t
}

# the value of a struct type that has default field values (its own, or its fields' structs'),
# as T() makes it with nothing given: what `x: T` and a field left out start as (0: no struct,
# or nothing to set)
struct_default=(t0:int64 pos:int64):>int64=>$unsafe {
    let t=prune(t0)
    if refine_active and types.ptr[t].kind =? 'refined' {
        let d=if tkind(AggregateSourceWord(types.ptr[t].elem)) =? 'array' {mk('array' pos)} else {bc_int(0 pos)}
        check_expr(d AggregateSourceWord(types.ptr[t].elem));
        coerce(d t);
        return d
    }
    if refine_active and types.ptr[t].kind =? 'fixed' and ref_storage_contract(AggregateSourceWord(types.ptr[t].elem)) {
        let value=mk('array' pos)
        nodes[value].type = int32<overflow='wrap'>(t)
        fixed_literal(value t)
        add_flag(value NF_CHECKED)
        return value
    }
    # (an exact quantity starts at zero in its unit, a rational's 0/1, not zeroed words)
    if types.ptr[t].kind =? 'quantity' and types.ptr[quantity_base(t)].kind =? 'struct_' {
        let zero=mk('int_lit' pos)
        quantity_constant(zero 0 1 quantity_dimension(t) t);
        return zero
    }
    if types.ptr[t].kind not=? 'struct_' or is_map_type(t) or is_union(t) {return 0}
    let si=AggregateSourceWord(types.ptr[t].st)
    if not struct_has_defaults(si 0) {return 0}
    let d=mk('call' pos)
    struct_ctor_zero(d t AggregateSourceWord(structs.ptr[si].decl));
    add_flag(d NF_CHECKED)
    d
}

literal_union_member=(n:int64 expected:int64):>int64=>$unsafe {
    let u=prune(expected)
    if u =? 0 {return 0}
    if types.ptr[u].kind =? 'opt' {u=prune(AggregateSourceWord(types.ptr[u].elem))}
    if not is_union(u) {return 0}
    let k=nodes.ptr[n].kind
    let found:AggregateSourceWord=0
    let tuple:AggregateSourceWord=0
    loop m0 in union_members(u) {
        let m=prune(m0)
        let mkind=types.ptr[m].kind
        let fits=false
        if k =? 'record_lit' {
            if mkind =? 'struct_' and not is_map_type(m) and not structs.ptr[AggregateSourceWord(types.ptr[m].st)].union_ {
                let si=AggregateSourceWord(types.ptr[m].st)
                fits=true
                loop j in [0..nkids(n)) {
                    let entry=kid(n j)
                    let named=false
                    loop i in [0..AggregateSourceWord(structs.ptr[si].nfields)) {
                        if fields.ptr[AggregateSourceWord(structs.ptr[si].fields) + i].name =? nodes.ptr[entry].name {named=true}
                    }
                    if not named {fits=false}
                }
                loop i in [0..AggregateSourceWord(structs.ptr[si].nfields)) {
                    let f=fields.ptr[AggregateSourceWord(structs.ptr[si].fields) + i]
                    if f.defval not=? 0 {continue}
                    let given=false
                    loop ki in [0..nkids(n)) {
                        let entry=kid(n ki)
                        if nodes.ptr[entry].name =? f.name {given=true}
                    }
                    if not given {fits=false}
                }
            }
        }
        else if k =? 'map_lit' {fits=is_map_type(m)}
        else if mkind =? 'tuple' {
            if nkids(n) =? AggregateSourceWord(types.ptr[m].nargs) and not array_has_spread(n) {
                if tuple not=? 0 {tuple=-1}
                else {tuple=m}
            }
        }
        else {fits=mkind =? 'array' or mkind =? 'fixed' or nkids(n) =? 0 and is_map_type(m)}
        if fits {
            if found not=? 0 {return 0}
            found=m
        }
    }
    if found =? 0 and tuple >? 0 {return tuple}
    found
}

# (P(1) for struct P: x: f64; y: f64: values given in order stop short of a field without a
# default, which would be zero unnoticed; T() and names only, T(x = 1), leave fields out on purpose)
missing_field_check=(n:int64 decl:int64 si:int64 args:array<int64> mapped:array<int64>):>void=>$unsafe {
    let npos:AggregateSourceWord=0
    loop a in args {
        if nodes.ptr[a].kind not=? 'namedarg' {npos += 1}
    }
    if npos =? 0 or pos_in_lib(nodes.ptr[n].pos) {return}
    let nf=AggregateSourceWord(structs.ptr[si].nfields)
    # (one or two left out: more, as Enemy(pos, kind) of a struct of many fields, is on purpose)
    let left:AggregateSourceWord=0
    loop i in [0..nf) {
        if mapped[i] =? 0 and AggregateSourceWord(fields.ptr[AggregateSourceWord(structs.ptr[si].fields) + i].defval) =? 0 {left += 1}
    }
    if left >? 2 {return}
    loop i in [0..nf) {
        let fi=AggregateSourceWord(structs.ptr[si].fields) + i
        if mapped[i] not=? 0 or AggregateSourceWord(fields.ptr[fi].defval) not=? 0 {continue}
        # (an empty array or map, false, none: as likely meant as not)
        let fk=tkind(AggregateSourceWord(fields.ptr[fi].type))
        let sn=name_of(AggregateSourceWord(nodes.ptr[decl].name))
        let fname=name_of(AggregateSourceWord(fields.ptr[fi].name))
        if fk =? 'fn_' {
            warn(nodes.ptr[n].pos "{sn}(...) leaves its function field '{fname}' with nothing to call (calling it stops the program): give it, as `{sn}(..., {fname} = (): ...)`, or set it before it is called")
            return
        }
        if fk not=? 'int_' and fk not=? 'float_' and fk not=? 'vec' and fk not=? 'str_' and fk not=? 'struct_' {continue}
        warn(nodes.ptr[n].pos "{sn}(...) leaves its field '{fname}' at zero ({npos} of its {nf} fields given in order): give it, give it a default in the struct (`{fname}: {dt(AggregateSourceWord(fields[fi].type))} = ...`), or name the fields given (`{sn}({name_of(AggregateSourceWord(fields[AggregateSourceWord(structs[si].fields)].name))} = ...)`)")
        return
    }
}

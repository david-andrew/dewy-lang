const RAX = 0
const RCX = 1
const RDX = 2
const RBX = 3
const RSP = 4
const RBP = 5
const RSI = 6
const RDI = 7
const R8 = 8
const R9 = 9
const R10 = 10
const R11 = 11

const RIPREL = 99
const XMM = 16
const VX = 4
const VY = 5
frame_size = 0
x_pad_track = false
x_pad0 = -1
x_pad1 = -1
x_pad2 = -1
x_abs_at1 = 0
x_abs_d1 = 0
x_abs_at2 = 0
x_abs_d2 = 0
x_code: *(u8[])
x_data_fix: *((int, int, int)[])
x64_encoder_bind = (output: *(u8[]), fixups: *((int, int, int)[])) -> int:
    x_code = output
    x_data_fix = fixups
    0
x_hdr: *int
x_encode_begin = (est: int = 64):
    slot = &x_code[0] as **u8
    p = slot[0]
    need = if est > 64: est else: 64
    if p == null or (p as *int)[0] != 1:
        __arr_make_unique(slot, 1)
        p = slot[0]
    old = x_code[0].len()
    if p == null or (p as *int)[2] < old + need:
        __arr_grow(slot, 1, old + need)
        p = slot[0]
    x_hdr = p as *int
    x_pad_track = false
    x_pad0 = -1
    x_pad1 = -1
    x_pad2 = -1
x_encode_end = ():
    x_hdr = null

@noinline
x_grow = (need: int) -> *int:
    old = x_code[0].len()
    h = (x_code as **int)[0]
    if h == null or h[0] != 1 or old + need > h[2]:
        x_code[0].reserve(max(old + need, if h != null: h[2] + 1 else: 64))
        h = (x_code as **int)[0]
    if x_hdr != null: x_hdr = h
    h

# Reserve a complete encoding once. The compiler's byte array has the runtime
# header (references, length, capacity); keep COW semantics on the slow path.
# No pointer survives this write or another reservation. All supported hosts
# are little endian and permit unaligned integer stores.
@noinline
x_bytes_grow = (n: int) -> *u8:
    slot = &x_code[0] as **u8
    p = slot[0]
    old = x_code[0].len()
    if p == null or (p as *int)[0] != 1:
        __arr_make_unique(slot, 1)
        p = slot[0]
    if p == null or (p as *int)[2] < old + n:
        __arr_grow(slot, 1, old + n)
        p = slot[0]
    (p as *int)[1] = old + n
    if x_hdr != null: x_hdr = p as *int
    p + 24 + old

x_bytes = (n: int) -> *u8:
    h = x_hdr
    if h != null:
        old = h[1]
        if old + n <= h[2]:
            h[1] = old + n
            return (h as *u8) + 24 + old
    x_bytes_grow(n)

@noinline
x_b_grow = (x: int): x_bytes_grow(1)[0] = u8(x)

b = (x: int):
    h = x_hdr
    if h != null:
        old = h[1]
        if old < h[2]:
            h[1] = old + 1
            ((h as *u8) + 24 + old)[0] = u8(x)
            return
    x_b_grow(x)

b16 = (x: int): (x_bytes(2) as *u16)[0] = u16(x)
b24 = (x: int):
    p = x_bytes(3)
    (p as *u16)[0] = u16(x)
    p[2] = u8(x >> 16)
b32 = (x: int):
    (x_bytes(4) as *u32)[0] = u32(x)
b64 = (x: int):
    (x_bytes(8) as *int)[0] = x
# Patch an already emitted four-byte field. Keep the byte buffer unique before
# taking its address, just as x_bytes does for appended encodings.
patch32 = (pos: int, v: int):
    h = x_hdr
    if h != null:
        if pos < 0 or pos > h[1] - 4: panic("fixup outside x_code[0] buffer")
        (((h as *u8) + 24 + pos) as *u32)[0] = u32(v)
        return
    if pos < 0 or pos > x_code[0].len() - 4: panic("fixup outside x_code[0] buffer")
    slot = &x_code[0] as **u8
    __arr_make_unique(slot, 1)
    ((slot[0] + 24 + pos) as *u32)[0] = u32(v)

rip_kind = 0
# index register for the next memory operand ([base + index << scale + disp]); -1: none
cur_index = -1
cur_scale = 0

use_index = (ix: int, scale: int):
    cur_index = ix
    cur_scale = scale

# an indexed access needs a real base register (rip-relative addressing takes no index)
indexed_base = (base: int, disp: int, imm: int) -> (int, int):
    if base != RIPREL: return (base, disp)
    rel_fixup_lea(RCX, rip_kind, disp - imm)
    (RCX, imm)

rex = (w: bool, r: int, x: int, bb0: int, force: bool):
    bb = bb0
    if bb == RIPREL: bb = 0
    v = 0x40
    if w: v |= 8
    if r & 8 != 0: v |= 4
    if x & 8 != 0 or (cur_index >= 0 and cur_index & 8 != 0): v |= 2
    if bb & 8 != 0: v |= 1
    if v != 0x40 or force: b(v)

# ModRM + optional SIB + displacement for [base + disp]
rsp_frame = false
rsp_extra = 0
mem = (reg: int, base0: int, disp0: int):
    base = base0
    disp = disp0
    if rsp_frame and base == RBP:
        base = RSP
        disp += frame_size + rsp_extra
    r = reg & 7
    if cur_index >= 0:
        sib = (cur_scale << 6) | ((cur_index & 7) << 3) | (base & 7)
        if disp == 0 and base & 7 != 5:
            b16(((r << 3) | 4) | (sib << 8))
        else if disp >= -128 and disp <= 127:
            b24((0x40 | (r << 3) | 4) | (sib << 8) | ((disp & 255) << 16))
        else:
            p = x_bytes(6)
            p[0] = u8(0x80 | (r << 3) | 4)
            p[1] = u8(sib)
            ((p + 2) as *u32)[0] = u32(disp)
        return
    if base == RIPREL:
        p = x_bytes(5)
        p[0] = u8((r << 3) | 5)
        ((p + 1) as *u32)[0] = u32(0)
        x_data_fix[0].push((x_code[0].len() - 4, rip_kind, disp))
        return
    bs = base & 7
    if disp == 0 and bs != 5:
        if bs == 4: b16(((r << 3) | 4) | 0x2400)
        else: b((r << 3) | bs)
    else if disp >= -128 and disp <= 127:
        if bs == 4: b24((0x40 | (r << 3) | 4) | 0x2400 | ((disp & 255) << 16))
        else: b16((0x40 | (r << 3) | bs) | ((disp & 255) << 8))
    else:
        if bs == 4:
            p = x_bytes(6)
            p[0] = u8(0x80 | (r << 3) | 4)
            p[1] = u8(0x24)
            ((p + 2) as *u32)[0] = u32(disp)
        else:
            p = x_bytes(5)
            p[0] = u8(0x80 | (r << 3) | bs)
            ((p + 1) as *u32)[0] = u32(disp)

modrr = (reg: int, rm: int): b(0xC0 | ((reg & 7) << 3) | (rm & 7))

# op r64, [base+disp]   (e.g. 0x8B mov, 0x03 add ...)
op_rm = (opc: int, w: bool, reg: int, base0: int, disp0: int):
    base = base0
    disp = disp0
    if rsp_frame and base == RBP:
        base = RSP
        disp += frame_size + rsp_extra
    r = reg & 7
    pfx_base = 0x40 | (if w: 8 else: 0) | ((reg >> 1) & 4)
    if cur_index < 0 and base != RIPREL:
        prefix = pfx_base | ((base >> 3) & 1)
        has_rex = if prefix != 0x40: 1 else: 0
        bs = base & 7
        has_sib = if bs == 4: 1 else: 0
        dmode = if disp == 0 and bs != 5: 0 else if disp >= -128 and disp <= 127: 1 else: 4
        need = has_rex + 2 + has_sib + dmode
        p = x_bytes(need)
        p[0] = u8(prefix)
        q = p + has_rex
        q[0] = u8(opc)
        if dmode == 0:
            q[1] = u8((r << 3) | bs)
            if has_sib != 0: q[2] = 0x24
        else if dmode == 1:
            q[1] = u8(0x40 | (r << 3) | bs)
            if has_sib == 0: q[2] = u8(disp)
            else: q[2] = 0x24; q[3] = u8(disp)
        else:
            q[1] = u8(0x80 | (r << 3) | bs)
            if has_sib == 0: ((q + 2) as *u32)[0] = u32(disp)
            else:
                q[2] = 0x24
                ((q + 3) as *u32)[0] = u32(disp)
        if x_pad_track:
            end_ = x_code[0].len()
            x_pad0 = x_pad1; x_pad1 = x_pad2; x_pad2 = (end_ << 32) | (end_ - need)
        return
    start = if x_pad_track: x_code[0].len() else: 0
    rex(w, reg, 0, base0, false)
    b(opc)
    mem(reg, base0, disp0)
    if x_pad_track and base0 != RIPREL: x_pad_record(start, x_code[0].len())

op_rr = (opc: int, w: bool, reg: int, rm: int):
    h = x_hdr
    if h == null or h[1] + 3 > h[2]: h = x_grow(3)
    prefix = 0x40 | (if w: 8 else: 0) | ((reg >> 1) & 4) | (if rm != RIPREL: (rm >> 3) & 1 else: 0)
    if cur_index >= 0 and cur_index & 8 != 0: prefix |= 2
    modrm = 0xC0 | ((reg & 7) << 3) | (rm & 7)
    has_rex = if prefix != 0x40: 1 else: 0
    old = h[1]
    end_ = old + has_rex + 2
    h[1] = end_
    p = (h as *u8) + 24 + old
    p[0] = u8(prefix)
    q = p + has_rex
    q[0] = u8(opc)
    q[1] = u8(modrm)
    if x_pad_track: x_pad0 = x_pad1; x_pad1 = x_pad2; x_pad2 = (end_ << 32) | old

@noinline
op_rm64_slow = (opc: int, reg: int, base0: int, disp0: int):
    op_rm(opc, true, reg, base0, disp0)

op_rm64 = (opc: int, reg: int, base0: int, disp0: int):
    h = x_hdr
    if cur_index >= 0 or base0 == RIPREL or h == null or h[1] + 9 > h[2]:
        op_rm64_slow(opc, reg, base0, disp0)
        return
    base = base0
    disp = disp0
    if rsp_frame and base == RBP:
        base = RSP
        disp += frame_size + rsp_extra
    old = h[1]
    p = (h as *u8) + 24 + old
    p[1] = u8(opc)
    prefix = 0x48 | ((reg >> 1) & 4)
    p[0] = u8(prefix | ((base >> 3) & 1))
    bs = base & 7
    rm = ((reg & 7) << 3) | bs
    end_ = old
    if disp == 0 and bs != 5:
        p[2] = u8(rm)
        if bs == 4: p[3] = 0x24; end_ = old + 4
        else: end_ = old + 3
    else if disp >= -128 and disp <= 127:
        p[2] = u8(0x40 | rm)
        if bs == 4: p[3] = 0x24; p[4] = u8(disp); end_ = old + 5
        else: p[3] = u8(disp); end_ = old + 4
    else:
        p[2] = u8(0x80 | rm)
        if bs == 4:
            p[3] = 0x24
            ((p + 4) as *u32)[0] = u32(disp)
            end_ = old + 8
        else:
            ((p + 3) as *u32)[0] = u32(disp)
            end_ = old + 7
    h[1] = end_
    if x_pad_track: x_pad0 = x_pad1; x_pad1 = x_pad2; x_pad2 = (end_ << 32) | old

mov_rm = (r: int, base: int, disp: int): op_rm64(0x8B, r, base, disp)     # mov r, [m]
mov_mr = (base: int, disp: int, r: int): op_rm64(0x89, r, base, disp)     # mov [m], r

mov_rr = (d: int, s: int):
    h = x_hdr
    if h == null or h[1] + 3 > h[2]: h = x_grow(3)
    prefix = 0x48 | ((s >> 1) & 4) | ((d >> 3) & 1) | (if cur_index >= 0 and cur_index & 8 != 0: 2 else: 0)
    old = h[1]
    end_ = old + 3
    h[1] = end_
    p = (h as *u8) + 24 + old
    p[0] = u8(prefix)
    p[1] = 0x89
    p[2] = u8(0xC0 | ((s & 7) << 3) | (d & 7))
    if x_pad_track: x_pad0 = x_pad1; x_pad1 = x_pad2; x_pad2 = (end_ << 32) | old

lea = (r: int, base: int, disp: int): op_rm64(0x8D, r, base, disp)

mov_imm = (r: int, v: int):
    h = x_hdr
    if h == null or h[1] + 10 > h[2]: h = x_grow(10)
    rx = if cur_index >= 0 and cur_index & 8 != 0: 2 else: 0
    old = h[1]
    p = (h as *u8) + 24 + old
    if v >= 0 and v <= 0xFFFFFFFF:
        rb = ((r >> 3) & 1) | rx
        if rb != 0:
            h[1] = old + 6
            p[0] = u8(0x40 | rb)
            p[1] = u8(0xB8 + (r & 7))
            ((p + 2) as *u32)[0] = u32(v)
        else:
            h[1] = old + 5
            p[0] = u8(0xB8 + (r & 7))
            ((p + 1) as *u32)[0] = u32(v)
    else if v >= -2147483648 and v <= 2147483647:
        h[1] = old + 7
        p[0] = u8(0x48 | ((r >> 3) & 1) | rx)
        p[1] = 0xC7
        p[2] = u8(0xC0 | (r & 7))
        ((p + 3) as *u32)[0] = u32(v)
    else:
        h[1] = old + 10
        p[0] = u8(0x48 | ((r >> 3) & 1) | rx)
        p[1] = u8(0xB8 + (r & 7))
        ((p + 2) as *int)[0] = v
    if x_pad_track: x_pad0 = x_pad1; x_pad1 = x_pad2; x_pad2 = (h[1] << 32) | old

# sized load from [base+disp] into r (zero/sign extended to 64 bits)
load_sized = (r: int, base: int, disp: int, size: int, signed: bool):
    if size == 8: mov_rm(r, base, disp)
    else if size == 4:
        if signed: op_rm(0x63, true, r, base, disp)       # movsxd
        else: op_rm(0x8B, false, r, base, disp)           # mov r32
    else if size == 2:
        st = x_code[0].len()
        rex(true, r, 0, base, false)
        b(0x0F)
        if signed: b(0xBF)
        else: b(0xB7)
        mem(r, base, disp)
        if x_pad_track and base != RIPREL: x_pad_record(st, x_code[0].len())
    else:
        st = x_code[0].len()
        rex(true, r, 0, base, false)
        b(0x0F)
        if signed: b(0xBE)
        else: b(0xB6)
        mem(r, base, disp)
        if x_pad_track and base != RIPREL: x_pad_record(st, x_code[0].len())

store_sized = (base: int, disp: int, r: int, size: int):
    if size == 8: mov_mr(base, disp, r)
    else if size == 4: op_rm(0x89, false, r, base, disp)
    else if size == 2:
        b(0x66)
        op_rm(0x89, false, r, base, disp)
        x_pad2 = -1
    else:
        rex(false, r, 0, base, r >= 4)
        b(0x88)
        mem(r, base, disp)

# SSE: prefix (F2 for sd, F3 for ss, 66 for pd), 0F, opc, modrm mem
@noinline
sse_rm_slow = (prefix: int, opc: int, x: int, base0: int, disp0: int):
    if prefix != 0: b(prefix)
    rex(false, x, 0, base0, false)
    b(0x0F)
    b(opc)
    mem(x, base0, disp0)

sse_rm = (prefix: int, opc: int, x: int, base0: int, disp0: int):
    h = x_hdr
    if cur_index >= 0 or base0 == RIPREL or h == null or h[1] + 11 > h[2]:
        sse_rm_slow(prefix, opc, x, base0, disp0)
        return
    base = base0
    disp = disp0
    if rsp_frame and base == RBP:
        base = RSP
        disp += frame_size + rsp_extra
    q = (h as *u8) + 24 + h[1]
    n = 0
    if prefix != 0: q[0] = u8(prefix); q = q + 1; n += 1
    rv = 0x40 | ((x >> 1) & 4) | ((base >> 3) & 1)
    if rv != 0x40: q[0] = u8(rv); q = q + 1; n += 1
    q[0] = 0x0F
    q[1] = u8(opc)
    bs = base & 7
    rm = ((x & 7) << 3) | bs
    if disp == 0 and bs != 5:
        q[2] = u8(rm)
        if bs == 4: q[3] = 0x24; n += 4
        else: n += 3
    else if disp >= -128 and disp <= 127:
        q[2] = u8(0x40 | rm)
        if bs == 4: q[3] = 0x24; q[4] = u8(disp); n += 5
        else: q[3] = u8(disp); n += 4
    else:
        q[2] = u8(0x80 | rm)
        if bs == 4:
            q[3] = 0x24
            ((q + 4) as *u32)[0] = u32(disp)
            n += 8
        else:
            ((q + 3) as *u32)[0] = u32(disp)
            n += 7
    h[1] += n

sse_rr = (prefix: int, opc: int, x: int, y: int):
    h = x_hdr
    if h == null or h[1] + 5 > h[2]: h = x_grow(5)
    rv = 0x40 | ((x >> 1) & 4) | (if y != RIPREL: (y >> 3) & 1 else: 0)
    if cur_index >= 0 and cur_index & 8 != 0: rv |= 2
    has_pre = if prefix != 0: 1 else: 0
    has_rex = if rv != 0x40: 1 else: 0
    old = h[1]
    h[1] = old + has_pre + has_rex + 3
    p = (h as *u8) + 24 + old
    o = 0
    if has_pre != 0: p[0] = u8(prefix); o = 1
    if has_rex != 0: p[o] = u8(rv); o += 1
    q = p + o
    q[0] = 0x0F
    q[1] = u8(opc)
    q[2] = u8(0xC0 | ((x & 7) << 3) | (y & 7))

# ---- vectors ----
is_vreg_vec = (ty: int) -> bool: ty == VX or ty == VY

# VEX prefix (3-byte form): map 1 = 0F, 2 = 0F38; pp 0 none, 1 = 66, 2 = F3, 3 = F2; l 1 for
# 256 bits; reg and vvvv are xmm numbers, rm a register or a memory base (the index is cur_index)
vex = (reg: int, vvvv: int, rm: int, map: int, pp: int, w: int, l: int):
    rb = rm
    if rb == RIPREL: rb = 0
    x = 0
    if cur_index >= 0 and cur_index & 8 != 0: x = 1
    b1 = ((1 - ((reg >> 3) & 1)) << 7) | ((1 - x) << 6) | ((1 - ((rb >> 3) & 1)) << 5) | map
    b2 = (w << 7) | ((15 - (vvvv & 15)) << 3) | (l << 2) | pp
    b24(0xC4 | (b1 << 8) | (b2 << 16))

vmov_rr = (x: int, y: int, ty: int):
    if x == y: return
    if ty == VY:
        vex(x, 0, y, 1, 0, 0, 1)
        b(0x28)                                         # vmovaps ymm, ymm
        modrr(x, y)
    else: sse_rr(0, 0x28, x, y)                         # movaps
vmov_rm = (x: int, base: int, disp: int, ty: int):
    if ty == VY:
        vex(x, 0, base, 1, 0, 0, 1)
        b(0x10)                                         # vmovups ymm, [m]
        mem(x, base, disp)
    else: sse_rm(0, 0x10, x, base, disp)                # movups xmm, [m]
vmov_mr = (base: int, disp: int, x: int, ty: int):
    if ty == VY:
        vex(x, 0, base, 1, 0, 0, 1)
        b(0x11)                                         # vmovups [m], ymm
        mem(x, base, disp)
    else: sse_rm(0, 0x11, x, base, disp)                # movups [m], xmm

vec_esize = (k: int) -> int:
    if k == 0 or k == 2: return 4
    8

# the opcode (after 0F) of vector operation op on element kind k (66 prefix for f64 and ints)
jmp32 = () -> int:
    p = x_bytes(5)
    p[0] = 0xE9
    ((p + 1) as *u32)[0] = u32(0)
    x_code[0].len() - 4
jcc32 = (cc: int) -> int:
    p = x_bytes(6)
    p[0] = 0x0F
    p[1] = u8(0x80 + cc)
    ((p + 2) as *u32)[0] = u32(0)
    x_code[0].len() - 4
# Keep six-byte branch slots fixed. A short encoding avoids a decoder-boundary
# crossing. Backedges at offsets 30/31 move within the slot using NOPs;
# forward conditional branches keep their near encoding when entry NOPs are needed.
patch_branch = (pos: int, target: int):
    delta = target - pos
    if x_code[0][pos - 1] == 0xE9:
        offset = (pos - 1) & 31
        pad = if offset >= 30: 32 - offset else: 0
        short = delta - 1 - pad
        if offset >= 27 and short >= -128 and short <= 127:
            if pad == 1: x_code[0][pos - 1] = 0x90
            else if pad == 2:
                x_code[0][pos - 1] = 0x66
                x_code[0][pos] = 0x90
            x_code[0][pos - 1 + pad] = 0xEB
            x_code[0][pos + pad] = u8(short & 255)
            if pad == 0:
                x_code[0][pos + 1] = 0x0F
                x_code[0][pos + 2] = 0x1F
                x_code[0][pos + 3] = 0
            else if pad == 1:
                x_code[0][pos + 2] = 0x66
                x_code[0][pos + 3] = 0x90
            else: x_code[0][pos + 3] = 0x90
        else: patch32(pos, delta - 4)
        return
    offset = (pos - 2) & 31
    pad = if offset >= 30: 32 - offset else: 0
    short = delta - pad
    if pos >= 2 and offset >= 26 and (offset < 30 or delta < 0) and short >= -128 and short <= 127 and x_code[0][pos - 2] == 0x0F and x_code[0][pos - 1] >= 0x80 and x_code[0][pos - 1] <= 0x8F:
        cc = x_code[0][pos - 1] - 0x10
        if pad == 1: x_code[0][pos - 2] = 0x90
        else if pad == 2:
            x_code[0][pos - 2] = 0x66
            x_code[0][pos - 1] = 0x90
        x_code[0][pos - 2 + pad] = cc
        x_code[0][pos - 1 + pad] = u8(short & 255)
        if pad == 0: patch32(pos, 0x00401F0F)
        else if pad == 1:
            x_code[0][pos + 1] = 0x0F
            x_code[0][pos + 2] = 0x1F
            x_code[0][pos + 3] = 0
        else:
            x_code[0][pos + 2] = 0x66
            x_code[0][pos + 3] = 0x90
        # Fold the unused suffix into a following scalar instruction. CS is
        # ignored for these x86-64 operations; their end (including RIP-relative
        # addressing) stays fixed. Four prefixes keep each encoding below 15 bytes.
        next = pos + 4
        if next + 1 < x_code[0].len() and x_code[0][next] & 0xF0 == 0x40:
            op = int(x_code[0][next + 1])
            if op == 0x89 or op == 0x8B or op == 0x8D or op == 0x85 or (op < 0x40 and (op & 7 == 1 or op & 7 == 3)) or (op >= 0xB8 and op <= 0xBF) or ((op == 0x81 or op == 0x83 or op == 0xC7) and next + 2 < x_code[0].len() and x_code[0][next + 2] >= 0xC0):
                loop i in [pos + pad..pos + 4): x_code[0][i] = 0x2E
    else: patch32(pos, delta - 4)
# A forward entry inside a preceding encoding prevents growing it in place.
x_padding_floor = 0
x_padding_cmov = -1
x_pad_record = (start: int, end_: int):
    x_pad0 = x_pad1
    x_pad1 = x_pad2
    x_pad2 = (end_ << 32) | start
x_pad_ok = (b0: u8) -> bool: ((b0 & 0xF0) == 0x40) or (b0 >= 0xB8 and b0 <= 0xBF) or b0 == 0x89 or b0 == 0x8B or b0 == 0x8D
x_shift_pad = (base: *u8, lo: int, hi: int, shift: int, pad_at: int, pad_n: int):
    i = hi - 1
    loop i >= lo: base[i + shift] = base[i]; i -= 1
    loop j in [0..pad_n): base[pad_at + j] = 0x2E
x_absorb_recent = (padding: int) -> bool:
    if padding <= 0 or padding > 15: return false
    cur = x_code[0].len()
    p2 = x_pad2
    end2 = p2 >> 32
    at2 = p2 & 0xFFFFFFFF
    if end2 != cur or at2 < x_padding_floor: return false
    p0 = data(x_code[0])
    w2 = end2 - at2
    if w2 < 2 or w2 > 11 or not x_pad_ok(p0[at2]): return false
    cap2 = min(6, 15 - w2)
    if padding <= cap2:
        x_bytes(padding)
        x_shift_pad(data(x_code[0]), at2, end2, padding, at2, padding)
        x_pad0 = -1; x_pad1 = -1; x_pad2 = -1
        x_abs_d1 = 0; x_abs_d2 = 0
        return true
    p1 = x_pad1
    end1 = p1 >> 32
    at1 = p1 & 0xFFFFFFFF
    if end1 != at2 or at1 < x_padding_floor: return false
    w1 = end1 - at1
    if w1 < 2 or w1 > 11 or not x_pad_ok(p0[at1]): return false
    cap1 = min(6, 15 - w1)
    if padding <= cap1 + cap2:
        n2 = min(cap2, padding)
        n1 = padding - n2
        x_bytes(padding)
        base = data(x_code[0])
        x_shift_pad(base, at2, end2, padding, at2 + n1, n2)
        x_shift_pad(base, at1, at2, n1, at1, n1)
        x_pad0 = -1; x_pad1 = -1; x_pad2 = -1
        x_abs_d1 = 0; x_abs_at2 = at2; x_abs_d2 = n1
        return true
    q0 = x_pad0
    end0 = q0 >> 32
    at0 = q0 & 0xFFFFFFFF
    if end0 != at1 or at0 < x_padding_floor: return false
    w0 = end0 - at0
    if w0 < 2 or w0 > 11 or not x_pad_ok(p0[at0]): return false
    cap0 = min(6, 15 - w0)
    if padding > cap0 + cap1 + cap2: return false
    n2 = min(cap2, padding)
    rem = padding - n2
    n1 = min(cap1, rem)
    n0 = rem - n1
    x_bytes(padding)
    base = data(x_code[0])
    x_shift_pad(base, at2, end2, padding, at2 + n0 + n1, n2)
    x_shift_pad(base, at1, at2, n0 + n1, at1 + n0, n1)
    x_shift_pad(base, at0, at1, n0, at0, n0)
    x_pad0 = -1; x_pad1 = -1; x_pad2 = -1
    x_abs_at1 = at1; x_abs_d1 = n0; x_abs_at2 = at2; x_abs_d2 = n0 + n1
    true
patch_here = (pos: int):
    x_padding_floor = x_code[0].len()
    patch_branch(pos, x_code[0].len())
patch_rel_here = (pos: int, base: int):
    x_padding_floor = x_code[0].len()
    patch32(pos, x_padding_floor - base)
jmp_back = (target: int):
    pos = jmp32()
    patch_branch(pos, target)

const CC_E = 4
const CC_NE = 5
const CC_L = 0xC
const CC_GE = 0xD
const CC_LE = 0xE
const CC_G = 0xF
const CC_B = 2
const CC_AE = 3
const CC_BE = 6
const CC_A = 7
const CC_P = 0xA
const CC_NP = 0xB

# n bytes of no-ops, in as few instructions as possible
const NOPS = [[0x90], [0x66, 0x90], [0x0F, 0x1F, 0x00], [0x0F, 0x1F, 0x40, 0x00], [0x0F, 0x1F, 0x44, 0x00, 0x00], [0x66, 0x0F, 0x1F, 0x44, 0x00, 0x00], [0x0F, 0x1F, 0x80, 0x00, 0x00, 0x00, 0x00], [0x0F, 0x1F, 0x84, 0x00, 0x00, 0x00, 0x00, 0x00], [0x66, 0x0F, 0x1F, 0x84, 0x00, 0x00, 0x00, 0x00, 0x00]]
nop_pad = (n0: int):
    n = n0
    loop n > 0:
        # Up to six operand-size prefixes plus the eight-byte NOP stay
        # within x86's 15-byte instruction and decoder prefix limits.
        k = min(n, 14)
        p = x_bytes(k)
        j = 0
        if k > 9:
            loop i in [0..k - 8):
                p[j] = 0x66
                j += 1
            loop x in NOPS[7]:
                p[j] = u8(x)
                j += 1
        else:
            loop x in NOPS[k - 1]:
                p[j] = u8(x)
                j += 1
        n -= k

setcc = (cc: int):
    p = x_bytes(6)
    p[0] = 0x0F
    p[1] = u8(0x90 + cc)
    p[2] = 0xC0
    p[3] = 0x0F
    p[4] = 0xB6
    p[5] = 0xC0

# A Boolean result can be produced directly in its assigned register. The
# 32-bit zero-extension writes the complete 64-bit value, including high GPRs.
setcc_reg = (cc: int, r: int):
    rm = r & 7
    rx = if cur_index >= 0 and cur_index & 8 != 0: 2 else: 0
    if r >= 4 or rx != 0:
        p = x_bytes(8)
        rb = (r >> 3) & 1
        p[0] = u8(0x40 | rb | rx)
        p[1] = 0x0F
        p[2] = u8(0x90 + cc)
        p[3] = u8(0xC0 | rm)
        p[4] = u8(0x40 | (rb << 2) | rb | rx)
        p[5] = 0x0F
        p[6] = 0xB6
        p[7] = u8(0xC0 | (rm << 3) | rm)
    else:
        p = x_bytes(6)
        p[0] = 0x0F
        p[1] = u8(0x90 + cc)
        p[2] = u8(0xC0 | rm)
        p[3] = 0x0F
        p[4] = 0xB6
        p[5] = u8(0xC0 | (rm << 3) | rm)

rel_fixup_lea = (r: int, kind: int, off: int):
    rx = if cur_index >= 0 and cur_index & 8 != 0: 2 else: 0
    p = x_bytes(7)
    p[0] = u8(0x48 | ((r >> 1) & 4) | rx)
    p[1] = 0x8D
    p[2] = u8(((r & 7) << 3) | 5)
    ((p + 3) as *u32)[0] = u32(0)
    x_data_fix[0].push((x_code[0].len() - 4, kind, off))

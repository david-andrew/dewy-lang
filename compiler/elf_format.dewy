$runtime_checks

# ELF64 layout and complete image construction; filesystem publication stays
# with the driver. Word arithmetic preserves the historical format contract.
ElfWord:type=int64<overflow='wrap'>

# Static ELF64 executable writer (Linux on x86-64 and arm64).
const ELF_BASE=0x400000
put16=(@b:array<uint8> v:ElfWord):>void=>$unsafe {
    b.push(uint8((v & 255) & 0xff))
    b.push(uint8(((v >> 8) & 255) & 0xff))
}
put32=(@b:array<uint8> v:ElfWord):>void=>$unsafe {
    put16(@b  v)
    put16(@b  v >> 16)
}
put64=(@b:array<uint8> v:ElfWord):>void=>$unsafe {
    put32(@b  v)
    put32(@b  v >> 32)
}

# the machine (x86-64; arm64: 183) and the page size segments are aligned to (arm64: 64 KB,
# the largest a Linux kernel there uses)
let elf_machine:ElfWord=62
let elf_page:ElfWord=0x1000
page_up=(x:ElfWord):>ElfWord=>$unsafe {
    (x + elf_page - 1) & ((elf_page - 1) xor -1)
}

# file layout: [headers][pad][text][pad][rodata]; data is pure bss after rodata
elf_layout=(text_len:ElfWord ro_len:ElfWord):>[int64 int64 int64]=>$unsafe {
    let text_off=elf_page
    let ro_off=page_up(text_off + text_len)
    let data_off=page_up(ro_off + ro_len)
    [text_off  ro_off  data_off]
}

# function symbols for debuggers/profilers: (name, offset in text, size)
let elf_syms:array<[string int64 int64]>=[]

# sections not loaded, after .symtab and .strtab: the line table backtraces read
# (.dewy_lines: x64_line_table) and the debugging information (.debug_*: dwarf.jo)
let elf_extra:array<[string array<uint8>]>=[]
elf_image=(text:array<uint8> entry_off:ElfWord ro:array<uint8> data_size:ElfWord):>array<uint8>=>$unsafe {
    let xe_pair1=elf_layout(ElfWord(text.length)  ElfWord(ro.length))
    let text_off=ElfWord(xe_pair1[0])
    let ro_off=ElfWord(xe_pair1[1])
    let data_off=ElfWord(xe_pair1[2])
    let out:array<uint8>=[]
    out.reserve(ro_off + ElfWord(ro.length))
    # ELF header
    loop c in [uint8(0x7f) 69 76 70 2 1 1 0] {out.push(uint8((c) & 0xff))}
    loop i in [0..8) {out.push(0)}
    put16(@out  2) # ET_EXEC
    put16(@out  elf_machine)
    put32(@out  1)
    put64(@out  ELF_BASE + text_off + entry_off)
    put64(@out  64) # phoff
    let shoff_pos=ElfWord(out.length)
    put64(@out  0) # shoff (patched below)
    put32(@out  0)
    put16(@out  64) # ehsize
    put16(@out  56) # phentsize
    put16(@out  3) # phnum
    put16(@out  64) # shentsize
    let nsec:ElfWord=0
    if ElfWord(elf_syms.length) >? 0 {nsec=5 + ElfWord(elf_extra.length)}
    put16(@out  nsec)
    put16(@out  nsec - 1) # shstrndx
    # text segment (includes headers)
    put32(@out  1)
    put32(@out  5) # R+X
    put64(@out  0)
    put64(@out  ELF_BASE)
    put64(@out  ELF_BASE)
    put64(@out  text_off + ElfWord(text.length))
    put64(@out  text_off + ElfWord(text.length))
    put64(@out  elf_page)
    # rodata
    put32(@out  1)
    put32(@out  4) # R
    put64(@out  ro_off)
    put64(@out  ELF_BASE + ro_off)
    put64(@out  ELF_BASE + ro_off)
    put64(@out  ElfWord(ro.length))
    put64(@out  ElfWord(ro.length))
    put64(@out  elf_page)
    # data (bss)
    put32(@out  1)
    put32(@out  6) # R+W
    put64(@out  data_off)
    put64(@out  ELF_BASE + data_off)
    put64(@out  ELF_BASE + data_off)
    put64(@out  0)
    put64(@out  data_size + 8)
    put64(@out  elf_page)
    out.resize(text_off)
    elf_append_bytes(@out  text)
    out.resize(ro_off)
    elf_append_bytes(@out  ro)
    if ElfWord(elf_syms.length) >? 0 {
        # .symtab / .strtab / .shstrtab for debuggers
        loop ElfWord(out.length) % 8 not=? 0 {out.push(0)}
        let strtab:array<uint8>=[0]
        let symtab:array<uint8>=[]
        loop i in [0..24) {symtab.push(0)}
        loop sym in elf_syms {
            let name_off=ElfWord(strtab.length)
            loop c in (sym[0] as array<uint8>) {strtab.push(c)}
            strtab.push(0)
            put32(@symtab  name_off)
            symtab.push(0x12) # STB_GLOBAL | STT_FUNC
            symtab.push(0)
            put16(@symtab  1) # section .text
            put64(@symtab  ELF_BASE + text_off + sym[1])
            put64(@symtab  sym[2])
        }
        let symtab_off=ElfWord(out.length)
        elf_append_bytes(@out  symtab)
        let strtab_off=ElfWord(out.length)
        elf_append_bytes(@out  strtab)
        let extra_off:array<int64>=[]
        loop x in elf_extra {
            extra_off.push(ElfWord(out.length))
            elf_append_bytes(@out  x[1])
        }
        let shstr="\0.text\0.symtab\0.strtab\0.shstrtab\0"
        let extra_name:array<int64>=[]
        loop x in elf_extra {
            extra_name.push(ElfWord((shstr as array<uint8>).length))
            shstr="{shstr}{x[0]}\0"
        }
        let shstr_off=ElfWord(out.length)
        loop c in (shstr as array<uint8>) {out.push(c)}
        loop ElfWord(out.length) % 8 not=? 0 {out.push(0)}
        let sh=ElfWord(out.length)
        loop k in [0..8) {out[shoff_pos + k] = uint8(((sh >> (8 * k)) & 255) & 0xff)}
        # null section
        loop i in [0..64) {out.push(0)}
        # .text
        sec(@out  1  1  6  ELF_BASE + text_off  text_off  ElfWord(text.length)  0  0  16  0)
        # .symtab
        sec(@out  7  2  0  0  symtab_off  ElfWord(symtab.length)  3  1  8  24)
        # .strtab
        sec(@out  15  3  0  0  strtab_off  ElfWord(strtab.length)  0  0  1  0)
        loop i in [ElfWord(0)..ElfWord(elf_extra.length)) {sec(@out extra_name[i] 1 0 0 extra_off[i] elf_extra[i][1].length 0 0 1 0)}
        # .shstrtab
        sec(@out  23  3  0  0  shstr_off  ElfWord((shstr as array<uint8>).length)  0  0  1  0)
    }
    out
}
sec=(@out:array<uint8> name:ElfWord kind:ElfWord flags:ElfWord addr:ElfWord off:ElfWord size:ElfWord link:ElfWord info:ElfWord align:ElfWord entsize:ElfWord):>void=>$unsafe {
    put32(@out  name)
    put32(@out  kind)
    put64(@out  flags)
    put64(@out  addr)
    put64(@out  off)
    put64(@out  size)
    put32(@out  link)
    put32(@out  info)
    put64(@out  align)
    put64(@out  entsize)
}
elf_append_bytes=(@out:array<uint8> src:array<uint8>):>void=>{out.extend(src)}

use 'expression_types.dewy'
use 'check.jo'
use 'ast.jo'
use 'checker_expr.dewy'
use 'checks_thin.dewy'
use 'expr.jo'
use 'types.jo'

pool_update_read = (n: int) -> bool:
    k = nodes[n].kind
    if k == .ident or k == .int_lit or k == .float_lit or k == .bool_lit: return true
    if k == .field: return pool_update_read(int(nodes[n].a))
    if k == .index and nodes[n].b != 0:
        at = tkind(ntype(int(nodes[n].a)))
        return (at == .array or at == .fixed) and pool_update_read(int(nodes[n].a)) and pool_update_read(int(nodes[n].b))
    # Inspect checked scalar operators: an overloaded operator has become a
    # call. Do not admit aggregate comparisons or conversions on this basis.
    if k == .unary or k == .not_ or k == .conv:
        a = int(nodes[n].a)
        return pool_update_scalar(n) and pool_update_scalar(a) and pool_update_read(a)
    if k == .binary or k == .and_ or k == .or_:
        a = int(nodes[n].a)
        b = int(nodes[n].b)
        return pool_update_scalar(n) and pool_update_scalar(a) and pool_update_scalar(b) and pool_update_read(a) and pool_update_read(b)
    false
# A selector that may run code or have effects (a block, a call, an operator
# on records). A plain read (a name, a literal, a field, scalar arithmetic over
# those) gives the same value at the read and the write: it is left in place so
# facts keep following it. A syntactically plain selector is checked on a copy.
compound_selector_runs = (n: int) -> bool:
    k = nodes[n].kind
    # A Dewy name can invoke a function, including a captured callable. Resolve
    # it before deciding that its selectors or destination survive the RHS.
    if k == .int_lit or k == .float_lit or k == .bool_lit: return false
    if k == .str_lit and nkids(n) == 0: return false
    if not compound_selector_plain(n, 0): return true
    check_expr(clone(n), 0)
    if nodes[last_checked].kind == .str_lit and nkids(last_checked) == 0: return false
    not pool_update_read(last_checked)
compound_selector_plain = (n: int, depth: int) -> bool:
    if n == 0 or depth > 16: return false
    k = nodes[n].kind
    if k == .ident or k == .int_lit or k == .float_lit or k == .bool_lit: return true
    if k == .str_lit: return nkids(n) == 0
    if k == .field: return compound_selector_plain(int(nodes[n].a), depth + 1)
    if k == .unary or k == .not_: return compound_selector_plain(int(nodes[n].a), depth + 1)
    if k == .binary or k == .and_ or k == .or_ or k == .index:
        return compound_selector_plain(int(nodes[n].a), depth + 1) and compound_selector_plain(int(nodes[n].b), depth + 1)
    false

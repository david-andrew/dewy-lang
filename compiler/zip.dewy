# Zip archives, deflated as the PNG writer does (stored when that is no smaller):
# `dewy build --target wasm32 -o game.zip` writes the page as index.html in one, the
# shape itch.io and similar sites take a web game in.
#
# The first module of the compiler written in Dewy. zip.jo is its frozen twin for
# the compilers without the Dewy frontend (tools/compiler/build.py); the two keep
# the same interface and write the same bytes (tests/test_selfhost_zip.py).

from p"@lib/game/image.jo" import deflate

let crc_table:array<int64>=[]

crc32=(b:array<uint8>):>int64=>{
    if crc_table.length =? 0 {
        loop n in [0..256) {
            let c:int64=n
            loop k in [0..8) {
                if c & 1 not=? 0 {c = 0xEDB88320 xor (c >> 1)}
                else {c = c >> 1}
            }
            crc_table.push(c)
        }
    }
    let c:int64=0xFFFFFFFF
    loop x in b {c = crc_table[(c xor int64(x)) & 255] xor (c >> 8)}
    c xor 0xFFFFFFFF
}

# (elf.jo's: a Dewy module stays outside the implementation's import cycle)
put16=(@b:array<uint8> v:int64):>void=>{
    b.push(uint8(v & 255))
    b.push(uint8((v >> 8) & 255))
}

put32=(@b:array<uint8> v:int64):>void=>{
    put16(@b v)
    put16(@b v >> 16)
}

# names[i] is the name in the archive of contents[i]
write_zip=(path:string names:array<string> contents:array<array<uint8>>):>bool=>{
    let out:array<uint8>=[]
    let central:array<uint8>=[]
    loop i in [0..names.length) {
        let data=contents[i]
        let off=out.length
        let crc=crc32(data)
        let packed=deflate(data)
        let method=8
        if packed.length >=? data.length {
            packed=data
            method=0
        }
        let name=names[i] as array<uint8>
        let header=(sig:int64 at_central:bool):>array<uint8>=>{
            let h:array<uint8>=[]
            put32(@h sig)
            if at_central {put16(@h 20)}                # made by
            put16(@h 20)                                 # version needed
            put16(@h 0x800)                              # flags: names are UTF-8
            put16(@h method)                             # 8: deflated, 0: stored
            put16(@h 0)                                  # time
            put16(@h 0x21)                               # date: 1980-01-01
            put32(@h crc)
            put32(@h packed.length)
            put32(@h data.length)
            put16(@h name.length)
            put16(@h 0)                                  # extra
            if at_central {
                put16(@h 0)                              # comment
                put16(@h 0)                              # disk
                put16(@h 0)                              # internal attributes
                put32(@h 0)                              # external attributes
                put32(@h off)
            }
            h.extend(name)
            h
        }
        out.extend(header(0x04034B50 false))
        out.extend(packed)
        central.extend(header(0x02014B50 true))
    }
    let cd_off=out.length
    out.extend(central)
    put32(@out 0x06054B50)
    put16(@out 0)
    put16(@out 0)
    put16(@out names.length)
    put16(@out names.length)
    put32(@out central.length)
    put32(@out cd_off)
    put16(@out 0)
    write_bytes(path out) is? int64
}

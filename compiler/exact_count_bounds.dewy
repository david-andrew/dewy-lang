$runtime_checks

from p"ast.jo" import (NF_U64 has_flag kid nkids nodes)
from p"check.jo" import (LF_ADDR LF_ALIAS LF_ASSIGNED LF_BYREF LF_CAPTURE LF_EXPOSED LF_MUTPARAM LF_PARAM LF_SHARED LF_VALUECAP fns globals locals sa_fits)
from p"checked_eval.dewy" import (cx_token_values)
from p"checks_thin.dewy" import (readonly_global)
from p"directive_queries.dewy" import (dir_assumed_bounds_file)
from p"exact.jo" import (exact_count_bounds exact_count_index exact_has_node exact_initializers exact_operation exact_representation exact_type_values exact_type_width exact_type_widths)
from p"expr.jo" import (CV IN integer_constant ntype)
from p"facts.jo" import (fact_add_fits fact_domain)
from p"lower_scalars.dewy" import (positive_modulus)
from p"refine.jo" import (ref_predicates)
from p"refinement_types.dewy" import (FACT_MAX FACT_MIN FactBound)
from p"types.jo" import (T_MATH_INT is_int prune telem tkind tsize types)
from p"word_overflow.dewy" import (math_word_overflow)

# Endpoint arithmetic keeps the frozen twin's machine-word behaviour: every
# operation that could leave int64 is either guarded or wraps as it did there.
CountWord:type=int64<overflow='wrap'>

exact_count_refined=(t0:CountWord):>FactBound=>$unsafe {
    let t=prune(t0)
    let out=FactBound(wide=true)
    if types.ptr[t].kind not=? 'refined' {return out}
    loop atom in ref_predicates[CountWord(types.ptr[t].st)] {
        if atom.a.path.length not=? 0 or atom.b.path.length not=? 0 or atom.a.offset not=? 0 or atom.b.offset not=? 0 or atom.a.unsigned or atom.b.unsigned {continue}
        if atom.a.kind =? 0 and atom.b.kind =? 1 {
            if atom.op =? 'lt' and atom.b.value >? FACT_MIN {out.hi=min(out.hi CountWord(atom.b.value) - 1)} else if atom.op =? 'le' or atom.op =? 'eq' {out.hi=min(out.hi atom.b.value)}
            if atom.op =? 'eq' {out.lo=max(out.lo atom.b.value)}
        }
        else if atom.a.kind =? 1 and atom.b.kind =? 0 {
            if atom.op =? 'lt' and atom.a.value <? FACT_MAX {out.lo=max(out.lo CountWord(atom.a.value) + 1)} else if atom.op =? 'le' or atom.op =? 'eq' {out.lo=max(out.lo atom.a.value)}
            if atom.op =? 'eq' {out.hi=min(out.hi atom.a.value)}
        }
    }
    out.wide=out.lo =? FACT_MIN or out.hi =? FACT_MAX
    out
}
# A signed bound of a machine integer that its type admits, or none.
exact_count_fits=(lo:CountWord hi:CountWord t:CountWord):>bool=>$unsafe {
    if types.ptr[t].sign {return sa_fits(lo t) and sa_fits(hi t)}
    lo >=? 0 and (types.ptr[t].bits =? 64 or hi <? CountWord(1) << CountWord(types.ptr[t].bits))
}
exact_count_bound=(n:CountWord):>FactBound=>$unsafe {
    if n =? 0 {return FactBound(wide=true)}
    if n <? exact_count_index.length and exact_count_index[n] not=? 0 {return exact_count_bounds[exact_count_index[n] - 1]}
    let out=FactBound(wide=true)
    if n >=? exact_count_index.length {exact_count_index.resize(nodes.length)}
    let slot=exact_count_bounds.length
    exact_count_bounds.push(out)
    exact_count_index[n]=slot + 1
    let k=nodes.ptr[n].kind
    let t=exact_representation(ntype(n))
    if k =? 'int_lit' and not (has_flag(n NF_U64) and nodes.ptr[n].ival <? 0) {out=FactBound(nodes.ptr[n].ival nodes.ptr[n].ival)} else if k =? 'ident' and nodes.ptr[n].aux =? int32(2) {
        let g=CountWord(nodes.ptr[n].sym)
        if readonly_global(g) and not globals.ptr[g].exposed {
            let initial=CountWord(nodes.ptr[CountWord(globals.ptr[g].decl)].b)
            let width=exact_type_width(initial true)
            let index=CountWord(exact_type_widths[initial])
            if index <? -1 and width // 2 <=? 64 {
                let value=CountWord(exact_type_values[initial])
                if index & 1 =? 0 {value=-value}
                out=FactBound(min(0 value) max(0 value))
            }
        }
    }
    else if k =? 'ident' and nodes.ptr[n].aux =? int32(1) {
        let l=CountWord(nodes.ptr[n].sym)
        let flags=CountWord(locals.ptr[l].flags)
        loop flags & LF_CAPTURE not=? 0 and flags & LF_VALUECAP not=? 0 and flags & (LF_ASSIGNED | LF_SHARED | LF_ADDR | LF_BYREF | LF_ALIAS | LF_EXPOSED) =? 0 {
            l=CountWord(locals.ptr[l].outer)
            flags=CountWord(locals.ptr[l].flags)
        }
        if flags & (LF_ASSIGNED | LF_MUTPARAM | LF_CAPTURE | LF_ALIAS | LF_BYREF | LF_ADDR | LF_SHARED | LF_EXPOSED) =? 0 {
            if flags & LF_PARAM not=? 0 {
                let f=CountWord(locals.ptr[l].owner)
                loop i in [0..CountWord(fns.ptr[f].params.length)) {
                    if fns.ptr[f].params[i] =? l {out=exact_count_refined(fns.ptr[f].ptypes[i])}
                }
            }
            else if l <? exact_initializers.length {out=exact_count_bound(exact_initializers[l])}
        }
    }
    else if k =? 'conv' and nodes.ptr[n].aux =? int32(int64(CV.refinement)) {out=exact_count_refined(CountWord(nodes.ptr[n].aux2))} else if k =? 'conv' and (nodes.ptr[n].aux =? int32(int64(CV.int_)) or nodes.ptr[n].aux =? int32(int64(CV.none_)) or nodes.ptr[n].aux =? int32(int64(CV.fixed_store)) or nodes.ptr[n].aux =? int32(int64(CV.wrap_int))) {
        let source=exact_count_bound(CountWord(nodes.ptr[n].a))
        if not source.wide and (t =? T_MATH_INT or is_int(t) and exact_count_fits(source.lo source.hi t)) {out=source}
    }
    else if k =? 'unary' and cx_token_values.ptr[CountWord(nodes.ptr[n].op)] =? 'tilde' {
        let source=exact_count_bound(CountWord(nodes.ptr[n].a))
        if not source.wide {out=FactBound(CountWord(-1) - CountWord(source.hi) CountWord(-1) - CountWord(source.lo))}
    }
    else if k =? 'intrinsic' and nodes.ptr[n].aux =? int32(int64(IN.len)) and nkids(n) =? 1 and tkind(ntype(kid(n 0))) =? 'array' and not dir_assumed_bounds_file(CountWord(nodes.ptr[n].pos) >> 40) {
        let bytes:CountWord=tsize(telem(ntype(kid(n 0))))
        out=FactBound(0 (if bytes >? 0 {(CountWord(1) << 56) // bytes} else {FACT_MAX}))
    }
    else {
        let modulus:CountWord=positive_modulus(n)
        if modulus >? 0 {out=FactBound(0 modulus - 1)} else if k =? 'binary' and nodes.ptr[n].aux =? 0 {
            let op=cx_token_values.ptr[CountWord(nodes.ptr[n].op)]
            if op =? 'plus' or op =? 'minus' {
                let a=exact_count_bound(CountWord(nodes.ptr[n].a))
                let b=exact_count_bound(CountWord(nodes.ptr[n].b))
                if not a.wide and not b.wide and (op not=? 'minus' or b.lo not=? FACT_MIN) {
                    if op =? 'minus' {
                        let low=-CountWord(b.hi)
                        b.hi=-CountWord(b.lo)
                        b.lo=low
                    }
                    if fact_add_fits(a.lo b.lo) and fact_add_fits(a.hi b.hi) {out=FactBound(CountWord(a.lo) + CountWord(b.lo) CountWord(a.hi) + CountWord(b.hi))}
                }
            }
            else if op =? 'star' {
                let a=exact_count_bound(CountWord(nodes.ptr[n].a))
                let b=exact_count_bound(CountWord(nodes.ptr[n].b))
                if not a.wide and not b.wide and not math_word_overflow(2 a.lo b.lo) and not math_word_overflow(2 a.lo b.hi) and not math_word_overflow(2 a.hi b.lo) and not math_word_overflow(2 a.hi b.hi) {
                    let ll=CountWord(a.lo) * CountWord(b.lo)
                    let lh=CountWord(a.lo) * CountWord(b.hi)
                    let hl=CountWord(a.hi) * CountWord(b.lo)
                    let hh=CountWord(a.hi) * CountWord(b.hi)
                    out=FactBound(min(min(ll lh) min(hl hh)) max(max(ll lh) max(hl hh)))
                }
            }
            else if op =? 'slash' {
                let a=exact_count_bound(CountWord(nodes.ptr[n].a))
                let b=exact_count_bound(CountWord(nodes.ptr[n].b))
                # Division by zero has its own obligation. For every nonzero
                # integer divisor, floor division is bounded by |a| + 1.
                if not a.wide and a.lo >? FACT_MIN and a.hi <? FACT_MAX {
                    let magnitude:CountWord=max(abs(a.lo) abs(a.hi))
                    if magnitude <? FACT_MAX {out=FactBound(-magnitude - 1 magnitude + 1)}
                    if not b.wide and b.lo >? 0 and a.lo >=? 0 {out=FactBound(0 a.hi)}
                }
            }
            else if op =? 'shr' {
                let a=exact_count_bound(CountWord(nodes.ptr[n].a))
                let [known count0]=integer_constant(CountWord(nodes.ptr[n].b))
                if not a.wide and known and count0 >=? 0 {
                    let count:CountWord=min(count0 63)
                    out=FactBound(CountWord(a.lo) >> count CountWord(a.hi) >> count)
                }
            }
            else if op =? 'amp' {
                let a=exact_count_bound(CountWord(nodes.ptr[n].a))
                let b=exact_count_bound(CountWord(nodes.ptr[n].b))
                if not a.wide and a.lo >=? 0 {out=FactBound(0 a.hi)}
                if not b.wide and b.lo >=? 0 {out=FactBound(0 (if out.wide {b.hi} else {min(out.hi b.hi)}))}
            }
        }
    }
    if out.wide and is_int(t) and t not=? T_MATH_INT and not exact_has_node(n) and (types.ptr[t].sign or types.ptr[t].bits <? 64) {out=fact_domain(t)}
    if not out.wide and is_int(t) and t not=? T_MATH_INT and not exact_has_node(n) and not exact_count_fits(out.lo out.hi t) {out=FactBound(wide=true)}
    exact_count_bounds[slot]=out
    out
}
# The cost scan can discharge a tagged-int allocation only after exact
# preparation has marked its unrounded source. The same cached signed bounds
# drive word lowering. A magnitude strictly below 2^62 fits the tagged payload.
exact_small_math=(n:CountWord):>int64=>{
    if not exact_has_node(n) and prune(ntype(n)) not=? T_MATH_INT and exact_operation(n) {return -1}
    let bound=exact_count_bound(n)
    if bound.wide or bound.lo <=? -(CountWord(1) << 62) or bound.hi >=? CountWord(1) << 62 {return -1}
    max(abs(bound.lo) abs(bound.hi))
}
# A checked count refinement can retain the finite exact lowering path. The
# ordinary obligation pass still proves its width after all writes are known.
exact_bounded_count=(n:CountWord):>bool=>{
    let bound=exact_count_bound(n)
    not bound.wide and bound.lo >=? 0 and bound.hi <? 1048576
}

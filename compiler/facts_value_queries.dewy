$runtime_checks

from p"effect_types.dewy" import (PlaceIdentity)
from p"facts.jo" import (FactState fact_root_key fact_terms fact_type)
from p"refinement_types.dewy" import (FactBound)
from p"types.jo" import (T_U64)

ValueWord:type=int64<overflow='wrap'>

# A compact open-address index: (key, record+1) pairs after an entry count.
# Empty slots have record=0, so all signed keys are usable. Doubling at half
# occupancy gives amortized O(1) insertion and expected O(1) lookup. These
# arrays copy with the fact state; there is no mutable cross-branch cache.
fact_index_hash=(key:ValueWord mask:ValueWord):>int64=>((key xor (key >> 32)) * 0x9e3779b1) & mask
# The slot count is a power of two and 1 + 2 * slot + 1 < length for every
# slot <= mask, so the probe reads stay inside the index it was given.
fact_index_get=(index:array<int64> key:ValueWord):>int64=>$unsafe {
    if index.length =? 0 {return -1}
    let mask:ValueWord=((ValueWord(index.length) - 1) >> 1) - 1
    let slot:ValueWord=fact_index_hash(key mask)
    loop true {
        let i:ValueWord=1 + slot * 2
        if index.ptr[i + 1] =? 0 {return -1}
        if index.ptr[i] =? key {return ValueWord(index.ptr[i + 1]) - 1}
        slot=(slot + 1) & mask
    }
    -1
}
fact_slot=(s:FactState v:ValueWord):>int64=>{
    # A value's latest insertion is a hint, never cross-branch evidence.
    # Validate against this frame before falling back to its own index.
    if v >? 0 and v <? fact_terms.length {
        let hint:ValueWord=fact_terms[v].slot
        if hint >=? 0 and hint <? s.ids.length and s.ids[hint] =? v {return hint}
    }
    # (a hashed index may be shared with a longer ancestor: an entry counts
    # only when it still names v's position)
    if s.index[0].slots.length not=? 0 {
        let i:ValueWord=fact_index_get(s.index[0].slots v)
        if i >=? 0 and i <? s.ids.length and s.ids[i] =? v {return i}
        return -1
    }
    if s.ids.length =? 0 or v <? s.ids[0] or v >? s.ids[s.ids.length - 1] {return -1}
    let lo:ValueWord=0
    let hi:ValueWord=s.ids.length
    loop lo <? hi {
        let mid=(lo + hi) >> 1
        if s.ids[mid] <? v {lo=mid + 1} else {hi=mid}
    }
    if lo <? s.ids.length and s.ids[lo] =? v {return lo}
    -1
}
fact_bound=(s:FactState v:ValueWord):>FactBound=>{
    let i=fact_slot(s v)
    if i <? 0 {return FactBound(reason='budget' wide=true)}
    s.bounds[i]
}
# (a join's root index may be shared with a predecessor holding more
# bindings: an entry counts only when it still names p's position)
fact_binding=(s:FactState p:PlaceIdentity):>int64=>{
    let i:ValueWord=fact_index_get(s.index[0].roots fact_root_key(p))
    if i >=? 0 and i <? s.bindings.length and s.bindings[i].place =? p {return i}
    -1
}
fact_truth=(s:FactState v:ValueWord):>int64=>{
    let b=fact_bound(s v)
    if b.lo =? 0 and b.hi =? 0 {return 0}
    if b.nz or b.lo >? 0 or b.hi <? 0 {return 1}
    -1
}
# v's interval as signed values: a uint64's biased ends count as unknown (wide).
fact_signed_bound=(s:FactState v:ValueWord):>FactBound=>{
    let b=fact_bound(s v)
    if v not=? 0 and fact_type(fact_terms[v].type) =? T_U64 {b.wide=true}
    b
}

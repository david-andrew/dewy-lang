$runtime_checks
from p"checker_call_queries.dewy" import (cl_demand cl_prelude_module collect_in intrinsic_of)
from p"call_argument_checks.dewy" import (match_type)
from p"call_lookup_context.dewy" import (decl_in_prelude)
from p"@lib/core/str.jo" import (contains lower starts_with upper)
from p"ast.jo" import (NF_EXTERN NF_MUT has_flag kid nkids nodes)
from p"check.jo" import (dewy_target_dropped discarding fns globals locals modules syms)
from p"checker_expr.dewy" import (lookup)
from p"checker_signature.dewy" import (fn_sig)
from p"checker_startup.dewy" import (load_std_file)
from p"checks_thin.dewy" import (hidden_method_message)
from p"expr.jo" import (intrinsics)
from p"prelude.jo" import (prelude_std_pending std_file_for)
from p"source_warnings.dewy" import (warn)
from p"spelling.dewy" import (edit_distance)
from p"type_ops.dewy" import (dt)
from p"types.jo" import (T_NEVER has_var prune tkind type_eq types)
from p"util.jo" import (files name_of pos_file)

WarningWord:type=int64<overflow='wrap'>
# xs.sorted(), s.trim() as a statement: a library function that gives a new value of its first
# argument's type, changing none of its arguments, called for nothing (it changes nothing)
unused_result=(x:int64 pos:int64):>void=>$unsafe {
    if discarding {return}
    if nodes.ptr[x].kind not=? 'call' or nodes.ptr[x].a not=? 0 or nodes.ptr[x].sym <=? 0 or nkids(x) =? 0 {return}
    let f=WarningWord(nodes.ptr[x].sym)
    let d=WarningWord(fns.ptr[f].decl)
    # (the library's: a program's own may well do more, as writing files, and give back something)
    if d =? 0 or not modules[WarningWord(nodes.ptr[d].mod)].is_prelude {return}
    if fns.ptr[f].ptypes.length =? 0 or nkids(d) not=? fns.ptr[f].ptypes.length or has_flag(d NF_EXTERN) {return}
    let r=prune(WarningWord(fns.ptr[f].ret))
    if tkind(r) =? 'void_' or r =? T_NEVER or not type_eq(r prune(fns.ptr[f].ptypes[0])) {return}
    # (values: a number or a flag given back is as often a handle or how it went)
    let rk=tkind(r)
    if rk not=? 'str_' and rk not=? 'array' and rk not=? 'vec' and rk not=? 'struct_' and rk not=? 'fixed' {return}
    if starts_with(name_of(WarningWord(nodes.ptr[d].name)) "__") {return}
    loop i in [0..nkids(d)) {
        if has_flag(kid(d i) NF_MUT) {return}
    }
    # (at the interactive prompt the value is shown: that is what it is for)
    if files[pos_file(pos)].path =? "<input>" {return}
    let fname=name_of(WarningWord(nodes.ptr[d].name))
    let a0=kid(x 0)
    let how=""
    if nodes.ptr[a0].kind =? 'ident' {
        let v=name_of(WarningWord(nodes.ptr[a0].name))
        how=" (`{v} = {v}.{fname}(...)` keeps it)"
    }
    warn(pos "{fname} gives a new {dt(r)} and leaves its argument as it was: this does nothing{how}")
}

# Dewy suggestions use names visible here, including explicit import aliases.
# A similarly named global in an unrelated loaded file is not a useful hint.
dewy_unused_name_hint=(name:string module:WarningWord):>string=>$unsafe {
    if module <? 0 or modules[module].is_prelude or (name as array<uint8>).length <? 3 {return ""}
    let limit=if (name as array<uint8>).length >=? 6 {2} else {1}
    loop [nm sym] in modules[module].names {
        if syms.ptr[sym].kind not=? 'global' or globals.ptr[WarningWord(syms.ptr[sym].ref)].is_const or lookup(nm) not=? sym {continue}
        let candidate=name_of(nm)
        if candidate =? name or (candidate as array<uint8>).length =? 0 or (candidate as array<uint8>)[0] not=? (name as array<uint8>)[0] {continue}
        if candidate =? upper(candidate) or lower(candidate) =? lower(name) {continue}
        if edit_distance(candidate name limit) <=? limit {
            return " (did you mean the visible variable '{candidate}'?)"
        }
    }
    ""
}

# (local l of function f is named in an arm its target or build mode leaves out: a
# parameter only a debug build reads is not unused; f spans to the next declaration)
target_dropped_use=(f:WarningWord l:WarningWord):>bool=>$unsafe {
    let uses=dewy_target_dropped.get(WarningWord(locals.ptr[l].name)) ?? []
    if uses.length =? 0 or fns.ptr[f].decl =? 0 {return false}
    let start=nodes.ptr[WarningWord(fns.ptr[f].decl)].pos
    let file=pos_file(start)
    let next_decl:WarningWord=-1
    if WarningWord(fns.ptr[f].mod) >=? 0 {
        loop d in modules[WarningWord(fns.ptr[f].mod)].decls {
            let p=nodes.ptr[d].pos
            if pos_file(p) =? file and p >? start and (next_decl <? 0 or p <? next_decl) {next_decl=p}
        }
    }
    loop u in uses {
        if pos_file(u) =? file and u >? start and (next_decl <? 0 or u <? next_decl) {return true}
    }
    false
}

# A program function named as a library method, taking the same kind of first argument:
# `x.name` calls the program's everywhere in the module, which may surprise. Demanded by the
# program's own functions: a name lookup and a signature match each.
hidden_method_warnings=(m:WarningWord):>void=>$unsafe {
    loop d in modules[m].decls {
        if nodes.ptr[d].kind not=? 'fn_' or nkids(d) =? 0 or has_flag(d NF_EXTERN) {continue}
        let name=WarningWord(nodes.ptr[d].name)
        let dn=name_of(name)
        if starts_with(dn "_") or starts_with(dn "(") or starts_with(dn "op_") or dn =? "main" {continue}
        # (a built-in array or string method, not a library function)
        let ii=intrinsic_of(name)
        if ii >=? 0 and intrinsics[ii].arr {
            let own=fn_sig(d)
            let at=if own.params.length >? 0 {tkind(own.params[0])} else {'void_'}
            if at =? 'array' or at =? 'str_' {
                warn(nodes.ptr[d].pos hidden_method_message(dn own.params[0]))
                continue
            }
        }
        if prelude_std_pending {
            let sf=std_file_for(dn)
            if (sf as array<uint8>).length >? 0 {load_std_file(sf); cl_demand(name);}
        }
        let found:array<int64>=[]
        let dm=cl_prelude_module(name)
        if dm >=? 0 {collect_in(dm name 0 @found)} else {collect_in((-1) name 2 @found)}
        loop c in found {
            if c =? d or not decl_in_prelude(c) or nkids(c) not=? nkids(d) {continue}
            let mine=fn_sig(d)
            let theirs=fn_sig(c)
            if theirs.params.length =? 0 or mine.params.length =? 0 {continue}
            let first=prune(theirs.params[0])
            if types.ptr[first].kind =? 'param' or contains(files[pos_file(nodes.ptr[c].pos)].path "/game/") {continue}
            # (an argument conversion is an overload, not the same method)
            let binds:array<int64>=fill(0 int64(theirs.ntp))
            if has_var(first) {
                if match_type(first mine.params[0] @binds 1) <? 0 {continue}
            } else if not type_eq(first mine.params[0]) {continue}
            warn(nodes.ptr[d].pos hidden_method_message(dn mine.params[0]))
            break
        }
    }
}

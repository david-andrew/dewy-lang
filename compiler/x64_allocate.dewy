$runtime_checks

# Complete linear/priority allocation and frame layout. Final IR is borrowed
# once; no pass, operand or metadata request calls back into the host.
# Linear scan is O(N + V*R), with R <= 24; priority reservation additionally
# scans occupied span words. Its call index is demanded only for priority mode.
from p"ir_types.dewy" import (IrFn Ins Op)
let xr_types:ptr<int8>=$unsafe (uint64(0) as ptr<int8>)
let xr_code:ptr<Ins>=$unsafe (uint64(0) as ptr<Ins>)
let xr_kval:ptr<XWord>=$unsafe (uint64(0) as ptr<XWord>)
from p"x64_encode.dewy" import (XWord XMM RBX RSI RDI R8 R9 R10 R11 frame_size is_vreg_vec)
from p"backend_analysis.dewy" import (LOC_SPILL LOC_CONST LOC_SLOT LOC_NONE LOC_GLOBAL LOC_FCONST vloc vsave dbg_keep v_live v_start call_pos call_w x_has_slot)
const INF_POS = 1 << 60
let vspill:array<int64>=[]
let slot_off:array<int64>=[]
let callee_off:array<int64>=fill(0 16)
let ra_cross_storage:array<int64>=[]
let ra_placed_storage:array<bool>=[]
let ra_on = true
let ra_prio = true
let callee_pool:array<int64>= [RBX  12  13  14  15]
let is_callee = [false  false  false  true  false  false  false  false  false  false  false  false  true  true  true  true]
let caller_pool:array<int64>= [R10  R11  R8  R9  RSI  RDI]
let param_pref_pool:array<int64>= [RDI  RSI  R10  R11  R8  R9]
let save_list:array<int64>=[]
let ra_expire_visits:XWord=0
let ra_spill_visits:XWord=0
let ra_peak_gpr:XWord=0
let ra_peak_xmm:XWord=0
let ra_active_storage:array<int64>=fill(0 24)
let ra_byreg_storage:array<int64>=fill(-1 32)
let ra_ctz_tab:array<int64>=[0 1 28 2 29 14 24 3 30 22 20 15 25 17 4 8 31 27 13 23 21 19 16 7 26 12 18 6 11 5 10 9]
const VI = 0
let xr_ir:ptr<IrFn>=$unsafe (uint64(0) as ptr<IrFn>)
let xr_debug = false
let xr_stats = false
xr_vtype=(v:XWord):>XWord=>$unsafe {
    let t:XWord=XWord(xr_types[v])
    if t =? 3 {
        return VI
    }
    t
}
xr_is_kv=(v:XWord):>bool=>$unsafe {
    XWord(xr_types[v]) =? 3
}
xr_kv_of=(v:XWord):>XWord=>$unsafe {
    xr_kval[v]
}
xr_align=(n:XWord a:XWord):>XWord=>$unsafe {
    (n + a - 1) & ((a - 1) xor -1)
}
let hint_op_tab:array<bool>=[]
let comm_op_tab:array<bool>=[]
let ra_saved_flags_p:ptr<bool>=$unsafe (uint64(0) as ptr<bool>)
let ra_ctz_p:ptr<int64>=$unsafe (uint64(0) as ptr<int64>)
let ra_htab_p:ptr<bool>=$unsafe (uint64(0) as ptr<bool>)
let ra_ctab_p:ptr<bool>=$unsafe (uint64(0) as ptr<bool>)
let ra_active_p:ptr<int64>=$unsafe (uint64(0) as ptr<int64>)
let ra_byreg_p:ptr<int64>=$unsafe (uint64(0) as ptr<int64>)
let ra_callee_off_p:ptr<int64>=$unsafe (uint64(0) as ptr<int64>)
hint_op_init=():>void=>$unsafe {
    if hint_op_tab.length >? 0 {return}
    loop op in [ \
        Op.nop Op.iconst Op.fconst Op.mov Op.add Op.sub Op.mul Op.divs \
        Op.divu Op.rems Op.remu Op.and_ Op.or_ Op.xor Op.shl Op.shrs \
        Op.shru Op.neg Op.not_ Op.eq Op.ne Op.lts Op.les Op.gts \
        Op.ges Op.ltu Op.leu Op.gtu Op.geu Op.fadd Op.fsub Op.fmul \
        Op.fdiv Op.fneg Op.fsqrt Op.fmin Op.fmax Op.ffloor Op.fceil Op.fabs \
        Op.ftrunc Op.feq Op.fne Op.flt Op.fle Op.fgt Op.fge Op.sext8 \
        Op.sext16 Op.sext32 Op.zext8 Op.zext16 Op.zext32 Op.i2f Op.u2f Op.f2i \
        Op.f2f Op.bits2f Op.f2bits Op.load Op.store Op.slot Op.gaddr Op.daddr \
        Op.faddr Op.copy Op.zero Op.memcpy Op.memset Op.zeroslots Op.vop Op.call \
        Op.calli Op.callc Op.syscall Op.intr Op.block Op.loop Op.if_ Op.else_ \
        Op.end Op.br Op.brif Op.ret Op.trap Op.select Op.assume Op.brtable \
        Op.vld Op.vst Op.vbin Op.vsplat Op.vzu Op.mulhs Op.mulhu Op.memeq \
        Op.checked_add Op.checked_sub Op.checked_mul Op.overflow_add Op.overflow_sub Op.overflow_mul Op.rot32 Op.streq \
        Op.findbyte Op.scanbytes Op.findb \
    ] {
        hint_op_tab.push(hint_op(op))
        comm_op_tab.push(op =? 'add' or op =? 'mul' or op =? 'and_' or op =? 'or_' or op =? 'xor' or op =? 'fadd' or op =? 'fmul' or op =? 'fmin' or op =? 'fmax')
    }
    if callee_off.length <? 16 {callee_off.resize(16)}
    ra_saved_flags_p=is_callee.ptr
    ra_ctz_p=ra_ctz_tab.ptr
    ra_htab_p=hint_op_tab.ptr
    ra_ctab_p=comm_op_tab.ptr
    ra_active_p=ra_active_storage.ptr
    ra_byreg_p=ra_byreg_storage.ptr
    ra_callee_off_p=callee_off.ptr
}
x64_allocate=(input:ptr<IrFn> priority:bool debug:bool stats:bool):>void=>$unsafe {
    if hint_op_tab.length =? 0 {hint_op_init()}
    xr_ir = input
    xr_types=input[0].vtypes.ptr
    xr_code=input[0].code.ptr
    xr_kval=input[0].kval.ptr as ptr<XWord>
    xr_debug = debug
    xr_stats = stats
    if priority {
        allocate_release()
    }
    else {
        allocate()
    }
    layout_frame()
}
hint_op=(op:Op):>bool=>$unsafe {
    match op {
        <'mov' | 'add' | 'sub' | 'mul' | 'checked_add' | 'checked_sub' | 'checked_mul' | 'and_' | 'or_' | 'xor' | 'shl' | 'shrs' | 'shru' | 'rot32' | 'neg' | 'not_' | 'load' | 'select'> => {
            true
        }
        <'fadd' | 'fsub' | 'fmul' | 'fdiv' | 'fmin' | 'fmax' | 'fneg' | 'fabs'> => {
            true
        }
        <'sext8' | 'sext16' | 'sext32' | 'zext8' | 'zext16' | 'zext32'> => {
            true
        }
        _ => {
            false
        }
    }
}
hint_operand=(v:XWord pos:XWord):>XWord=>$unsafe {
    if v <? xr_ir[0].nparams or pos >=? XWord(xr_ir[0].code.length) {
        return -1
    }
    let ins=xr_code + pos
    let tag=int64((ins as ptr<uint32>)[0])
    if XWord(ins[0].dst) not=? v or not hint_op_tab.ptr[tag] {
        return -1
    }
    let vec=xr_vtype(v) not=? VI
    let a:XWord=XWord(ins[0].a)
    if ins[0].op =? 'select' {
        a = XWord(ins[0].c)
    }
    if ins[0].op =? 'checked_sub' and xr_is_kv(a) and xr_kv_of(a) =? 0 {
        a = XWord(ins[0].b)
    }
    if a >=? 0 and a not=? v and vloc[a] >=? 0 and XWord(v_live[a].last) =? pos and (vloc[a] >=? XMM) =? vec {
        return a
    }
    if ra_ctab_p[tag] {
        let b:XWord=XWord(ins[0].b)
        if b >=? 0 and b not=? v and vloc[b] >=? 0 and XWord(v_live[b].last) =? pos and (vloc[b] >=? XMM) =? vec {
            return b
        }
    }
    -1
}
live_start=(v:XWord):>XWord=>$unsafe {
    if v <? xr_ir[0].nparams {
        return -1
    }
    XWord(v_live[v].first)
}
crosses_call=(s:XWord e:XWord):>bool=>$unsafe {
    let lo:XWord=0
    let hi:XWord=call_pos.length
    loop lo <? hi {
        let mid:XWord=(lo + hi) // 2
        if call_pos[mid] <=? s {
            lo = mid + 1
        }
        else {
            hi = mid
        }
    }
    lo <? call_pos.length and call_pos[lo] <? e
}
spills_before=(a:XWord b:XWord):>bool=>$unsafe {
    let la:XWord=XWord(v_live[a].last) - live_start(a) + 1
    let lb:XWord=XWord(v_live[b].last) - live_start(b) + 1
    let x:XWord=XWord(v_live[a].weight) * lb
    let y:XWord=XWord(v_live[b].weight) * la
    x <? y or (x =? y and v_live[a].last >? v_live[b].last)
}
ra_remove=(active:ptr<int64> byreg:ptr<int64> n:XWord reg:XWord):>XWord=>$unsafe {
    let k:XWord=byreg[reg]
    byreg[reg] = -1
    loop k + 1 <? n {
        let v:XWord=active[k + 1]
        active[k] = v
        byreg[vloc[v]] = k
        k += 1
    }
    n - 1
}
ra_spill_pick=(v:XWord vector:bool crosses:bool active:ptr<int64> @nactive:XWord byreg:ptr<int64> loc_arr:ptr<int64> save_arr:ptr<bool> saved_flags:ptr<bool> keep:ptr<bool> dbg:bool stats:bool):>XWord=>$unsafe {
    let best:XWord=-1
    if stats {ra_spill_visits += nactive}
    loop k in [0..nactive) {
        let a:XWord=active[k]
        let ra:XWord=loc_arr[a]
        if (ra >=? XMM) not=? vector {continue}
        if crosses and dbg and keep[v] and (ra >=? XMM or not saved_flags[ra]) {continue}
        if not spills_before(a v) {continue}
        if best <? 0 or spills_before(a best) {best = a}
    }
    if best <? 0 {return -1}
    let reg:XWord=loc_arr[best]
    loc_arr[best] = LOC_SPILL
    save_arr[v] = crosses and (reg >=? XMM or not saved_flags[reg])
    let rk=byreg[reg]
    byreg[reg] = -1
    nactive -= 1
    if rk <? nactive {
        let moved:XWord=active[nactive]
        active[rk] = moved
        byreg[loc_arr[moved]] = rk
    }
    reg
}

allocate=():>void=>$unsafe {
    let saved_flags=ra_saved_flags_p
    let dbg=xr_debug
    let keep=if dbg {dbg_keep.ptr} else {uint64(0) as ptr<bool>}
    let ncalls:XWord=call_pos.length
    let calls=if ncalls >? 0 {call_pos.ptr} else {uint64(0) as ptr<int64>}
    let ctz=ra_ctz_p
    let vl=v_live
    let loc_arr=vloc
    let save_arr=vsave
    let start_arr=v_start
    let np:XWord=xr_ir[0].nparams
    let nv:XWord=XWord(xr_ir[0].vtypes.length)
    let saved=ra_callee_off_p
    mem_set(saved as ptr<uint8> 0 128)
    if not ra_on {
        loop v in [0..nv) {
            if loc_arr[v] not=? LOC_CONST and loc_arr[v] not=? LOC_FCONST and loc_arr[v] not=? LOC_SLOT and loc_arr[v] not=? LOC_GLOBAL {
                loc_arr[v] = LOC_SPILL
            }
        }
        return
    }
    let nc:XWord=XWord(xr_ir[0].code.length)
    let n:XWord=nc + 1
    let code=xr_code
    let types=xr_types
    let kval=xr_kval
    let stats=xr_stats
    let htab=ra_htab_p
    let free:XWord=0x7FFCFFC8
    let active=ra_active_p
    let byreg=ra_byreg_p
    mem_set(byreg as ptr<uint8> 255 256)
    let nactive:XWord=0
    let min_end:XWord=INF_POS
    let call_next:XWord=0
    let param_call:XWord=if ncalls >? 0 {calls[0]} else {INF_POS}
    let cur_call:XWord=param_call
    loop pos in [0..n) {
        let v:XWord=start_arr[pos]
        if v <? 0 {continue}
        if cur_call <=? pos {
            loop call_next <? ncalls and calls[call_next] <=? pos {
                call_next += 1
            }
            cur_call = if call_next <? ncalls {calls[call_next]} else {INF_POS}
        }
        if min_end <? pos {
            min_end = INF_POS
            let k:XWord=0
            if stats {
                ra_expire_visits += nactive
            }
            loop k <? nactive {
                let a:XWord=active[k]
                let alast:XWord=XWord(vl[a].last)
                if alast <? pos {
                    let r:XWord=loc_arr[a]
                    free |= 1 << r
                    byreg[r] = -1
                    nactive -= 1
                    if k <? nactive {
                        let moved:XWord=active[nactive]
                        active[k] = moved
                        byreg[loc_arr[moved]] = k
                    }
                }
                else {
                    if alast <? min_end {
                        min_end = alast
                    }
                    k += 1
                }
            }
        }
        loop v >=? 0 {
            let h:XWord=-1
            let vt=XWord(types[v])
            let vector=vt not=? 0 and vt not=? 3
            if v >=? np and pos <? nc {
                let ins=code + pos
                if XWord(ins[0].dst) =? v {
                    let tag=int64((ins as ptr<uint32>)[0])
                    if not dbg and pos + 1 <? nc and tag >=? 19 and tag <=? 28 and vl[v].ndef =? 1 and vl[v].nuse =? 1 {
                        let nop=(ins + 1)[0].op
                        if (nop =? 'if_' or nop =? 'brif') and XWord((ins + 1)[0].a) =? v {
                            loc_arr[v] = LOC_NONE
                            v = XWord(vl[v].next_start)
                            continue
                        }
                    }
                    if htab[tag] {
                        let a:XWord=XWord(ins[0].a)
                        if ins[0].op =? 'select' {a = XWord(ins[0].c)}
                        else if ins[0].op =? 'checked_sub' and XWord(types[a]) =? 3 and kval[a] =? 0 {a = XWord(ins[0].b)}
                        if a >=? 0 and a not=? v {
                            let al=loc_arr[a]
                            if al >=? 0 and XWord(vl[a].last) =? pos and (al >=? XMM) =? vector {h = a}
                        }
                        if h <? 0 and ra_ctab_p[tag] {
                            let b:XWord=XWord(ins[0].b)
                            if b >=? 0 and b not=? v {
                                let bl=loc_arr[b]
                                if bl >=? 0 and XWord(vl[b].last) =? pos and (bl >=? XMM) =? vector {h = b}
                            }
                        }
                    }
                }
            }
            let vlast:XWord=XWord(vl[v].last)
            let crosses=(if v <? np {param_call} else {cur_call}) <? vlast
            let reg:XWord=-1
            if h >=? 0 {
                let hl:XWord=loc_arr[h]
                if crosses and hl <? XMM and not saved_flags[hl] {
                    h = -1
                }
                else if crosses and dbg and keep[v] and hl >=? XMM {
                    h = -1
                }
                else {
                    let rk=byreg[hl]
                    if rk >=? 0 and active[rk] =? h {
                        reg = hl
                        byreg[hl] = -1
                        nactive -= 1
                        if rk <? nactive {
                            let moved:XWord=active[nactive]
                            active[rk] = moved
                            byreg[loc_arr[moved]] = rk
                        }
                        save_arr[v] = crosses and (reg >=? XMM or not saved_flags[reg])
                        if reg <? XMM and saved_flags[reg] {
                            saved[reg] = 1
                        }
                    }
                }
            }
            if reg <? 0 {
                if not vector {
                    if not crosses {
                        if v <? np {
                            let ip:XWord=0
                            loop k in [0..v) {
                                let kt=XWord(types[k])
                                if kt =? 0 or kt =? 3 {ip += 1}
                            }
                            if ip <? 6 {
                                let pr=param_pref_pool.ptr[ip]
                                if free & (1 << pr) not=? 0 {reg = pr}
                            }
                        }
                        if reg <? 0 {
                            let avail=free & 0x0FC0
                            if avail not=? 0 {
                                let bit=avail & (0 - avail)
                                reg = ctz[(((bit * 0x077CB531) & 0xFFFFFFFF) >> 27)]
                            }
                        }
                    }
                    if reg <? 0 {
                        let avail=free & 0xF008
                        if avail not=? 0 {
                            let bit=avail & (0 - avail)
                            reg = ctz[(((bit * 0x077CB531) & 0xFFFFFFFF) >> 27)]
                        }
                    }
                    if reg <? 0 and crosses and not (dbg and keep[v]) {
                        let avail=free & 0x0FC0
                        if avail not=? 0 {
                            let bit=avail & (0 - avail)
                            reg = ctz[(((bit * 0x077CB531) & 0xFFFFFFFF) >> 27)]
                            save_arr[v] = true
                        }
                    }
                }
                else {
                    let avail=free & 0x7FFC0000
                    if avail not=? 0 and not (crosses and dbg and keep[v]) {
                        let bit=avail & (0 - avail)
                        reg = ctz[(((bit * 0x077CB531) & 0xFFFFFFFF) >> 27)]
                        save_arr[v] = crosses
                    }
                }
            }
            if reg <? 0 {
                reg = ra_spill_pick(v vector crosses active @nactive byreg loc_arr save_arr saved_flags keep dbg stats)
            }
            if reg >=? 0 {
                loc_arr[v] = reg
                free &= ((1 << reg) xor -1)
                byreg[reg] = nactive
                active[nactive] = v
                nactive += 1
                if stats {
                    ra_pressure(active  nactive  -1)
                }
                if vlast <? min_end {
                    min_end = vlast
                }
                if reg <? XMM and saved_flags[reg] {
                    saved[reg] = 1
                }
            }
            else {
                loc_arr[v] = LOC_SPILL
            }
            v = XWord(vl[v].next_start)
        }
    }
}
let ra_occ:array<int64>=[]
let ra_words:XWord=0
let ra_cw:array<int64>=[]
let ra_call_cut_storage:array<int32>=[]
let ra_call_cut:ptr<int32>=$unsafe (uint64(0) as ptr<int32>)
let ra_dump = ""
let ra_only = ""
ra_mask=(lo:XWord hi:XWord):>XWord=>$unsafe {
    let m:XWord=-1 << lo
    if hi <? 63 {
        m = m & ((1 << (hi + 1)) - 1)
    }
    m
}
ra_free=(r:XWord s:XWord e:XWord):>bool=>$unsafe {
    let occupied=ra_occ.ptr as ptr<XWord>
    if s >? e {
        return true
    }
    let base:XWord=r * ra_words
    let ws:XWord=s >> 6
    let we:XWord=e >> 6
    let w:XWord=ws
    loop w <=? we {
        let lo:XWord=0
        let hi:XWord=63
        if w =? ws {
            lo = s & 63
        }
        if w =? we {
            hi = e & 63
        }
        if occupied[base + w] & ra_mask(lo  hi) not=? 0 {
            return false
        }
        w += 1
    }
    true
}
ra_take=(r:XWord s:XWord e:XWord):>void=>$unsafe {
    let occupied=ra_occ.ptr as ptr<XWord>
    let base:XWord=r * ra_words
    let ws:XWord=s >> 6
    let we:XWord=e >> 6
    let w:XWord=ws
    loop w <=? we {
        let lo:XWord=0
        let hi:XWord=63
        if w =? ws {
            lo = s & 63
        }
        if w =? we {
            hi = e & 63
        }
        occupied[base + w] = occupied[base + w] | ra_mask(lo  hi)
        w += 1
    }
}
ra_cross_w=(s:XWord e:XWord):>XWord=>$unsafe {
    if call_pos.length =? 0 {
        return 0
    }
    let a:XWord=XWord(ra_call_cut[s + 1])
    let lo:XWord=XWord(ra_call_cut[e])
    if lo <=? a {
        return 0
    }
    if lo =? a + 1 {
        let call=xr_code[call_pos[a]]
        if call.op =? 'call' and call.c =? 2 {
            return -1
        }
    }
    XWord(ra_cw[lo]) - XWord(ra_cw[a])
}
allocate_release=():>void=>$unsafe {
    let xr_callee_pool=callee_pool.ptr as ptr<XWord>
    let xr_caller_pool=caller_pool.ptr as ptr<XWord>
    let saved_flags=is_callee.ptr
    let nv:XWord=XWord(xr_ir[0].vtypes.length)
    if callee_off.length <? 16 {callee_off.resize(16)}
    loop r in [0..16) {callee_off.ptr[r] = 0}
    let n:XWord=XWord(xr_ir[0].code.length) + 1
    let ncw:XWord=call_pos.length + 1
    if ra_cw.length <? ncw {ra_cw.resize(ncw)}
    ra_cw.ptr[0] = 0
    loop k in [0..call_pos.length) {
        ra_cw.ptr[k + 1] = ra_cw.ptr[k] + call_w.ptr[k]
    }
    if call_pos.length >? 0 {
        if ra_call_cut_storage.length <? n {
            ra_call_cut_storage.resize(n)
        }
        ra_call_cut = ra_call_cut_storage.ptr
        let calls=call_pos.ptr
        let next:XWord=0
        loop pos in [0..n) {
            loop next <? call_pos.length and calls[next] <? pos {
                next += 1
            }
            ra_call_cut[pos] = int32(next)
        }
    }
    if ra_cross_storage.length <? nv {ra_cross_storage.resize(nv)}
    let cross=ra_cross_storage.ptr as ptr<XWord>
    let nc_rel:XWord=XWord(xr_ir[0].code.length)
    let np_rel:XWord=xr_ir[0].nparams
    loop v in [0..nv) {
        if vloc[v] not=? LOC_SPILL {
            cross[v] = 0
            continue
        }
        if not xr_debug and v >=? np_rel and v_live[v].ndef =? 1 and v_live[v].nuse =? 1 {
            let p0=XWord(v_live[v].first)
            if p0 + 1 <? nc_rel {
                let ins0=xr_code + p0
                let tag0=int64((ins0 as ptr<uint32>)[0])
                if tag0 >=? 19 and tag0 <=? 28 and XWord(ins0[0].dst) =? v {
                    let nop0=(ins0 + 1)[0].op
                    if (nop0 =? 'if_' or nop0 =? 'brif') and XWord((ins0 + 1)[0].a) =? v {
                        vloc[v] = LOC_NONE
                        cross[v] = 0
                        continue
                    }
                }
            }
        }
        cross[v] = ra_cross_w(live_start(v)  XWord(v_live[v].last))
    }
    ra_words = (n + 1) // 64 + 1
    let nocc:XWord=32 * ra_words
    if ra_occ.length <? nocc {ra_occ.resize(nocc)}
    mem_set(ra_occ.ptr as ptr<uint8> 0 nocc * 8)
    if ra_placed_storage.length <? nv {ra_placed_storage.resize(nv)}
    let placed=ra_placed_storage.ptr
    if nv >? 0 {mem_set(placed as ptr<uint8> 0 nv)}
    let active=ra_active_storage.ptr
    let byreg=ra_byreg_storage.ptr
    mem_set(byreg as ptr<uint8> 255 256)
    let nactive:XWord=0
    let free:XWord=0xF008
    loop pos in [0..n) {
        let v:XWord=v_start[pos]
        if v <? 0 {
            continue
        }
        let k:XWord=0
        if xr_stats {
            ra_expire_visits += nactive
        }
        loop k <? nactive {
            let a:XWord=active[k]
            if XWord(v_live[a].last) <? pos {
                let r:XWord=vloc[a]
                free |= 1 << r
                byreg[r] = -1
                nactive -= 1
                if k <? nactive {
                    active[k] = active[nactive]
                    byreg[vloc[active[k]]] = k
                }
            }
            else {
                k += 1
            }
        }
        loop v >=? 0 {
            if (cross[v] >? 1 or cross[v] =? -1 and v <? xr_ir[0].nparams and v_live[v].weight >? 8 * int64(v_live[v].nuse)) and xr_vtype(v) =? VI {
                let reg:XWord=-1
                loop ri in [XWord(0)..XWord(5)) {
                    let r:XWord=xr_callee_pool[ri]
                    if free & (1 << r) not=? 0 {
                        reg = r
                        break
                    }
                }
                if reg <? 0 {
                    let best:XWord=-1
                    if xr_stats {
                        ra_spill_visits += nactive
                    }
                    loop k in [0..nactive) {
                        let a:XWord=active[k]
                        if v_live[a].weight <? v_live[v].weight and (best <? 0 or v_live[a].weight <? v_live[best].weight) {
                            best = a
                        }
                    }
                    if best >=? 0 {
                        reg = vloc[best]
                        vloc[best] = LOC_SPILL
                        placed[best] = false
                        nactive = ra_remove(active  byreg  nactive  reg)
                    }
                }
                if reg >=? 0 {
                    vloc[v] = reg
                    placed[v] = true
                    free &= ((1 << reg) xor -1)
                    byreg[reg] = nactive
                    active[nactive] = v
                    nactive += 1
                    if xr_stats {
                        ra_peak_gpr = max(ra_peak_gpr  nactive)
                    }
                }
            }
            v = XWord(v_live[v].next_start)
        }
    }
    loop v in [0..nv) {
        if placed[v] {
            ra_take(vloc[v]  live_start(v) + 1  XWord(v_live[v].last) + 1)
            callee_off[vloc[v]] = 1
        }
    }
    free = 0x7FFCFFC8
    loop r in [0..32) {
        byreg[r] = -1
    }
    nactive = 0
    let min_end:XWord=INF_POS
    loop pos in [0..n) {
        let v:XWord=v_start[pos]
        if v >=? 0 and min_end <? pos {
            min_end = INF_POS
            let k:XWord=0
            if xr_stats {
                ra_expire_visits += nactive
            }
            loop k <? nactive {
                let a:XWord=active[k]
                if XWord(v_live[a].last) <? pos {
                    let r:XWord=vloc[a]
                    free |= 1 << r
                    byreg[r] = -1
                    nactive -= 1
                    if k <? nactive {
                        active[k] = active[nactive]
                        byreg[vloc[active[k]]] = k
                    }
                }
                else {
                    if XWord(v_live[a].last) <? min_end {
                        min_end = XWord(v_live[a].last)
                    }
                    k += 1
                }
            }
        }
        loop v >=? 0 {
            if placed[v] or vloc[v] =? LOC_NONE {
                v = XWord(v_live[v].next_start)
                continue
            }
            let s:XWord=live_start(v) + 1
            let e:XWord=XWord(v_live[v].last) + 1
            let c:XWord=abs(cross[v])
            let caller_ok=c =? 0 or c <? v_live[v].weight
            let reg:XWord=-1
            let h:XWord=hint_operand(v  pos)
            if h >=? 0 and byreg[vloc[h]] >=? 0 and active[byreg[vloc[h]]] =? h {
                let r:XWord=vloc[h]
                let ok=ra_free(r  s + 1  e)
                if r <? XMM and not saved_flags[r] and not caller_ok {
                    ok = false
                }
                if r >=? XMM and not caller_ok {
                    ok = false
                }
                if ok {
                    reg = r
                    nactive = ra_remove(active  byreg  nactive  reg)
                }
            }
            if reg <? 0 {
                if xr_vtype(v) not=? VI {
                    if caller_ok {
                        loop x in [2..15) {
                            if free & (1 << (XMM + x)) not=? 0 and ra_free(XMM + x  s  e) {
                                reg = XMM + x
                                break
                            }
                        }
                    }
                }
                else {
                    if c >? 0 {
                        loop ri in [XWord(0)..XWord(5)) {
                    let r:XWord=xr_callee_pool[ri]
                            if free & (1 << r) not=? 0 and (c >? 1 or callee_off[r] not=? 0) and ra_free(r  s  e) {
                                reg = r
                                break
                            }
                        }
                    }
                    if reg <? 0 and caller_ok {
                        if v <? np_rel {
                            let ip:XWord=0
                            loop k in [0..v) {
                                if xr_vtype(k) =? VI {ip += 1}
                            }
                            if ip <? 6 {
                                let pr=param_pref_pool.ptr[ip]
                                if free & (1 << pr) not=? 0 and ra_free(pr s e) {reg = pr}
                            }
                        }
                        if reg <? 0 {
                            loop ri in [XWord(0)..XWord(6)) {
                        let r:XWord=xr_caller_pool[ri]
                                if free & (1 << r) not=? 0 and ra_free(r  s  e) {
                                    reg = r
                                    break
                                }
                            }
                        }
                    }
                    if reg <? 0 and c <=? 1 {
                        loop ri in [XWord(0)..XWord(5)) {
                    let r:XWord=xr_callee_pool[ri]
                            if free & (1 << r) not=? 0 and ra_free(r  s  e) {
                                reg = r
                                break
                            }
                        }
                    }
                }
            }
            if reg <? 0 and (c =? 0 or caller_ok or xr_vtype(v) =? VI) {
                let best:XWord=-1
                if xr_stats {
                    ra_spill_visits += nactive
                }
                loop k in [0..nactive) {
                    let a:XWord=active[k]
                    let ra:XWord=vloc[a]
                    if (ra >=? XMM) not=? (xr_vtype(v) not=? VI) {
                        continue
                    }
                    if not spills_before(a  v) {
                        continue
                    }
                    if (ra >=? XMM or not saved_flags[ra]) and not caller_ok {
                        continue
                    }
                    if not ra_free(ra  s  e) {
                        continue
                    }
                    if best <? 0 or spills_before(a  best) {
                        best = a
                    }
                }
                if best >=? 0 {
                    reg = vloc[best]
                    vloc[best] = LOC_SPILL
                    vsave[best] = false
                    nactive = ra_remove(active  byreg  nactive  reg)
                }
            }
            if reg >=? 0 {
                vloc[v] = reg
                vsave[v] = c >? 0 and (reg >=? XMM or not saved_flags[reg])
                free &= ((1 << reg) xor -1)
                byreg[reg] = nactive
                active[nactive] = v
                nactive += 1
                if xr_stats {
                    ra_pressure(active  nactive  pos)
                }
                if XWord(v_live[v].last) <? min_end {
                    min_end = XWord(v_live[v].last)
                }
                if reg <? XMM and saved_flags[reg] {
                    callee_off[reg] = 1
                }
            }
            else {
                vloc[v] = LOC_SPILL
            }
            v = XWord(v_live[v].next_start)
        }
    }
    if ra_dump not=? "" and xr_ir[0].name =? ra_dump {
        loop v in [0..nv) {
            if v_live[v].last <? 0 {
                continue
            }
            let tag=""
            if placed[v] {
                tag = " (pass 1)"
            }
            printl("v{v} {live_start(v)}..{v_live[v].last} w {v_live[v].weight} calls {abs(cross[v])} -> {vloc[v]}{tag}" file=stderr)
        }
    }
}
layout_frame=():>void=>$unsafe {
    let off:XWord=0
    let saved=callee_off.ptr as ptr<XWord>
    loop r in [0..16) {
        if saved[r] not=? 0 {
            off += 8
            saved[r] = -off
        }
    }
    let nv:XWord=XWord(xr_ir[0].vtypes.length)
    if vspill.length <? nv {vspill.resize(nv)}
    else if vspill.length >? nv {vspill.truncate(nv)}
    let spill=vspill.ptr as ptr<XWord>
    let loc_arr=vloc
    let save_arr=vsave
    let types=xr_types
    save_list.clear()
    loop v in [0..nv) {
        let lv=loc_arr[v]
        if lv =? LOC_SPILL or (lv >=? 0 and save_arr[v]) {
            off += 8
            let vt=XWord(types[v])
            if vt =? 4 or vt =? 5 {off += 24}
            spill[v] = -off
            if lv >=? 0 {save_list.push(v)}
        } else {spill[v] = 0}
    }
    let ns:XWord=if x_has_slot {XWord(xr_ir[0].slot_size.length)} else {0}
    if ns >? 0 {
        if slot_off.length <? ns {slot_off.resize(ns)}
        else if slot_off.length >? ns {slot_off.truncate(ns)}
        let slots=slot_off.ptr as ptr<XWord>
        let sizes=xr_ir[0].slot_size.ptr
        let aligns=xr_ir[0].slot_align.ptr
        loop s in [0..ns) {
            let sz:XWord=XWord(sizes[s])
            let al:XWord=XWord(aligns[s])
            off = (off + sz + al - 1) & ((al - 1) xor -1)
            slots[s] = -off
        }
    } else if slot_off.length >? 0 {slot_off.clear()}
    frame_size = (off + 15) & -16
}
ra_pressure=(active:ptr<int64> n:XWord pos:XWord):>void=>$unsafe {
    let xr_callee_pool=callee_pool.ptr as ptr<XWord>
    let gpr:XWord=0
    loop k in [0..n) {
        if vloc[active[k]] <? XMM {
            gpr += 1
        }
    }
    ra_peak_xmm = max(ra_peak_xmm  n - gpr)
    if pos >=? 0 {
        loop ri in [XWord(0)..XWord(5)) {
                    let r:XWord=xr_callee_pool[ri]
            if ra_occ[r * ra_words + ((pos + 1) >> 6)] & (1 << ((pos + 1) & 63)) not=? 0 {
                gpr += 1
            }
        }
    }
    ra_peak_gpr = max(ra_peak_gpr  gpr)
}

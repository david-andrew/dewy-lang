$runtime_checks
# Complete linear/priority allocation and frame layout. Final IR is borrowed
# once; no pass, operand or metadata request calls back into the host.
# Linear scan is O(N + V*R), with R <= 24; priority reservation additionally
# scans occupied span words. Its call index is demanded only for priority mode.
from p"ir_types.dewy" import (IrFn Ins Op)
let xr_types:ptr<int8>=$unsafe (uint64(0) as ptr<int8>)
let xr_code:ptr<Ins>=$unsafe (uint64(0) as ptr<Ins>)
let xr_kval:ptr<XWord>=$unsafe (uint64(0) as ptr<XWord>)
from p"x64_encode.dewy" import (XWord XMM RBX RSI RDI R8 R9 R10 R11 frame_size is_vreg_vec)
from p"backend_analysis.dewy" import (LOC_SPILL LOC_CONST LOC_SLOT LOC_GLOBAL LOC_FCONST vloc vsave dbg_keep v_live v_start call_pos call_w)
const INF_POS = 1 << 60
let vspill:array<int64>=[]
let slot_off:array<int64>=[]
let callee_off:array<int64>=[]
let ra_on = true
let ra_prio = true
let callee_pool:array<int64>= [RBX  12  13  14  15]
let is_callee = [false  false  false  true  false  false  false  false  false  false  false  false  true  true  true  true]
let caller_pool:array<int64>= [RSI  RDI  R8  R9  R10  R11]
let save_list:array<int64>=[]
let ra_expire_visits:XWord=0
let ra_spill_visits:XWord=0
let ra_peak_gpr:XWord=0
let ra_peak_xmm:XWord=0
let ra_active_storage:array<int64>=fill(0 24)
let ra_byreg_storage:array<int64>=fill(-1 32)
const VI = 0
let xr_ir:ptr<IrFn>=$unsafe (uint64(0) as ptr<IrFn>)
let xr_debug = false
let xr_stats = false
xr_vtype=(v:XWord):>XWord=>$unsafe {
    let t:XWord=XWord(xr_types[v])
    if t =? 3 {
        return VI
    }
    t
}
xr_is_kv=(v:XWord):>bool=>$unsafe {
    XWord(xr_types[v]) =? 3
}
xr_kv_of=(v:XWord):>XWord=>$unsafe {
    xr_kval[v]
}
xr_align=(n:XWord a:XWord):>XWord=>$unsafe {
    (n + a - 1) & ((a - 1) xor -1)
}
x64_allocate=(input:ptr<IrFn> priority:bool debug:bool stats:bool):>void=>$unsafe {
    xr_ir = input
    xr_types=input[0].vtypes.ptr
    xr_code=input[0].code.ptr
    xr_kval=input[0].kval.ptr as ptr<XWord>
    xr_debug = debug
    xr_stats = stats
    if priority {
        allocate_release()
    }
    else {
        allocate()
    }
    layout_frame()
}
hint_op=(op:Op):>bool=>$unsafe {
    match op {
        <'mov' | 'add' | 'sub' | 'mul' | 'checked_add' | 'checked_sub' | 'checked_mul' | 'and_' | 'or_' | 'xor' | 'shl' | 'shrs' | 'shru' | 'rot32' | 'neg' | 'not_' | 'load'> => {
            true
        }
        <'fadd' | 'fsub' | 'fmul' | 'fdiv' | 'fmin' | 'fmax' | 'fneg' | 'fabs'> => {
            true
        }
        <'sext8' | 'sext16' | 'sext32' | 'zext8' | 'zext16' | 'zext32'> => {
            true
        }
        _ => {
            false
        }
    }
}
hint_operand=(v:XWord pos:XWord):>XWord=>$unsafe {
    if v <? xr_ir[0].nparams or pos >=? XWord(xr_ir[0].code.length) {
        return -1
    }
    let ins=xr_code + pos
    if XWord(ins[0].dst) not=? v or not hint_op(ins[0].op) {
        return -1
    }
    let a:XWord=XWord(ins[0].a)
    if ins[0].op =? 'checked_sub' and xr_is_kv(a) and xr_kv_of(a) =? 0 {
        a = XWord(ins[0].b)
    }
    if a <? 0 or a =? v or vloc[a] <? 0 or v_live[a].last not=? pos {
        return -1
    }
    if (vloc[a] >=? XMM) not=? (xr_vtype(v) not=? VI) {
        return -1
    }
    a
}
live_start=(v:XWord):>XWord=>$unsafe {
    if v <? xr_ir[0].nparams {
        return -1
    }
    v_live[v].first
}
crosses_call=(s:XWord e:XWord):>bool=>$unsafe {
    let lo:XWord=0
    let hi:XWord=call_pos.length
    loop lo <? hi {
        let mid:XWord=(lo + hi) // 2
        if call_pos[mid] <=? s {
            lo = mid + 1
        }
        else {
            hi = mid
        }
    }
    lo <? call_pos.length and call_pos[lo] <? e
}
spills_before=(a:XWord b:XWord):>bool=>$unsafe {
    let la:XWord=XWord(v_live[a].last) - live_start(a) + 1
    let lb:XWord=XWord(v_live[b].last) - live_start(b) + 1
    let x:XWord=XWord(v_live[a].weight) * lb
    let y:XWord=XWord(v_live[b].weight) * la
    x <? y or (x =? y and v_live[a].last >? v_live[b].last)
}
ra_remove=(active:ptr<int64> byreg:ptr<int64> n:XWord reg:XWord):>XWord=>$unsafe {
    let k:XWord=byreg[reg]
    byreg[reg] = -1
    loop k + 1 <? n {
        let v:XWord=active[k + 1]
        active[k] = v
        byreg[vloc[v]] = k
        k += 1
    }
    n - 1
}
allocate=():>void=>$unsafe {
    # These arrays stay fixed for this allocation. Borrow once, preserving COW
    # on the saved-register writes; the scan introduces no additional pass.
    let saved_flags=is_callee.ptr
    let keep=dbg_keep.ptr
    let calls=call_pos.ptr
    let ncalls:XWord=call_pos.length
    let caller_regs=caller_pool.ptr
    let callee_regs=callee_pool.ptr
    let ncaller:XWord=caller_pool.length
    let ncallee:XWord=callee_pool.length
    let np:XWord=xr_ir[0].nparams
    let nv:XWord=XWord(xr_ir[0].vtypes.length)
    callee_off = fill(0  16)
    let saved=callee_off.ptr
    if not ra_on {
        loop v in [0..nv) {
            if vloc[v] not=? LOC_CONST and vloc[v] not=? LOC_FCONST and vloc[v] not=? LOC_SLOT and vloc[v] not=? LOC_GLOBAL {
                vloc[v] = LOC_SPILL
            }
        }
        return
    }
    let n:XWord=XWord(xr_ir[0].code.length) + 1
    let free:XWord=0x7FFCFFC8
    let active=ra_active_storage.ptr
    let byreg=ra_byreg_storage.ptr
    loop r in [0..32) {
        byreg[r] = -1
    }
    let nactive:XWord=0
    let min_end:XWord=INF_POS
    let call_next:XWord=0
    loop pos in [0..n) {
        loop call_next <? ncalls and calls[call_next] <=? pos {
            call_next += 1
        }
        let v:XWord=v_start[pos]
        if v >=? 0 and min_end <? pos {
            min_end = INF_POS
            let k:XWord=0
            if xr_stats {
                ra_expire_visits += nactive
            }
            loop k <? nactive {
                let a:XWord=active[k]
                if v_live[a].last <? pos {
                    let r:XWord=vloc[a]
                    free |= 1 << r
                    byreg[r] = -1
                    nactive -= 1
                    if k <? nactive {
                        active[k] = active[nactive]
                        byreg[vloc[active[k]]] = k
                    }
                }
                else {
                    if v_live[a].last <? min_end {
                        min_end = v_live[a].last
                    }
                    k += 1
                }
            }
        }
        loop v >=? 0 {
            let vector=xr_vtype(v) not=? VI
            let next_call:XWord=call_next
            if v <? np {
                next_call = 0
            }
            let crosses=next_call <? ncalls and calls[next_call] <? v_live[v].last
            let reg:XWord=-1
            let h:XWord=hint_operand(v  pos)
            if h >=? 0 and crosses and vloc[h] <? XMM and not saved_flags[vloc[h]] {
                h = -1
            }
            if h >=? 0 and crosses and xr_debug and keep[v] and vloc[h] >=? XMM {
                h = -1
            }
            if h >=? 0 and byreg[vloc[h]] >=? 0 and active[byreg[vloc[h]]] =? h {
                reg = vloc[h]
                nactive = ra_remove(active  byreg  nactive  reg)
                vsave[v] = crosses and (reg >=? XMM or not saved_flags[reg])
                if reg <? XMM and saved_flags[reg] {
                    saved[reg] = 1
                }
            }
            else if vector {
                if not (crosses and xr_debug and keep[v]) {
                    loop x in [2..15) {
                        if free & (1 << (XMM + x)) not=? 0 {
                            reg = XMM + x
                            vsave[v] = crosses
                            break
                        }
                    }
                }
            }
            else {
                if not crosses {
                    loop ri in [0..ncaller) {
                        let r:XWord=caller_regs[ri]
                        if free & (1 << r) not=? 0 {
                            reg = r
                            break
                        }
                    }
                }
                if reg <? 0 {
                    loop ri in [0..ncallee) {
                        let r:XWord=callee_regs[ri]
                        if free & (1 << r) not=? 0 {
                            reg = r
                            break
                        }
                    }
                }
                if reg <? 0 and crosses and not (xr_debug and keep[v]) {
                    loop ri in [0..ncaller) {
                        let r:XWord=caller_regs[ri]
                        if free & (1 << r) not=? 0 {
                            reg = r
                            vsave[v] = true
                            break
                        }
                    }
                }
            }
            if reg <? 0 {
                let best:XWord=-1
                if xr_stats {
                    ra_spill_visits += nactive
                }
                loop k in [0..nactive) {
                    let a:XWord=active[k]
                    let ra:XWord=vloc[a]
                    if (ra >=? XMM) not=? (vector) {
                        continue
                    }
                    if crosses and xr_debug and keep[v] and (ra >=? XMM or not saved_flags[ra]) {
                        continue
                    }
                    if not spills_before(a  v) {
                        continue
                    }
                    if best <? 0 or spills_before(a  best) {
                        best = a
                    }
                }
                if best >=? 0 {
                    reg = vloc[best]
                    vloc[best] = LOC_SPILL
                    vsave[v] = crosses and (reg >=? XMM or not saved_flags[reg])
                    nactive = ra_remove(active  byreg  nactive  reg)
                }
            }
            if reg >=? 0 {
                vloc[v] = reg
                free &= ((1 << reg) xor -1)
                byreg[reg] = nactive
                active[nactive] = v
                nactive += 1
                if xr_stats {
                    ra_pressure(active  nactive  -1)
                }
                if v_live[v].last <? min_end {
                    min_end = v_live[v].last
                }
                if reg <? XMM and saved_flags[reg] {
                    saved[reg] = 1
                }
            }
            else {
                vloc[v] = LOC_SPILL
            }
            v = v_live[v].next_start
        }
    }
}
let ra_occ:array<int64>=[]
let ra_words:XWord=0
let ra_cw:array<int64>=[]
let ra_call_cut_storage:array<int32>=[]
let ra_call_cut:ptr<int32>=$unsafe (uint64(0) as ptr<int32>)
let ra_dump = ""
let ra_only = ""
ra_mask=(lo:XWord hi:XWord):>XWord=>$unsafe {
    let m:XWord=-1 << lo
    if hi <? 63 {
        m = m & ((1 << (hi + 1)) - 1)
    }
    m
}
ra_free=(r:XWord s:XWord e:XWord):>bool=>$unsafe {
    let occupied=ra_occ.ptr as ptr<XWord>
    if s >? e {
        return true
    }
    let base:XWord=r * ra_words
    let ws:XWord=s >> 6
    let we:XWord=e >> 6
    let w:XWord=ws
    loop w <=? we {
        let lo:XWord=0
        let hi:XWord=63
        if w =? ws {
            lo = s & 63
        }
        if w =? we {
            hi = e & 63
        }
        if occupied[base + w] & ra_mask(lo  hi) not=? 0 {
            return false
        }
        w += 1
    }
    true
}
ra_take=(r:XWord s:XWord e:XWord):>void=>$unsafe {
    let occupied=ra_occ.ptr as ptr<XWord>
    let base:XWord=r * ra_words
    let ws:XWord=s >> 6
    let we:XWord=e >> 6
    let w:XWord=ws
    loop w <=? we {
        let lo:XWord=0
        let hi:XWord=63
        if w =? ws {
            lo = s & 63
        }
        if w =? we {
            hi = e & 63
        }
        occupied[base + w] = occupied[base + w] | ra_mask(lo  hi)
        w += 1
    }
}
ra_cross_w=(s:XWord e:XWord):>XWord=>$unsafe {
    if call_pos.length =? 0 {
        return 0
    }
    let a:XWord=XWord(ra_call_cut[s + 1])
    let lo:XWord=XWord(ra_call_cut[e])
    if lo <=? a {
        return 0
    }
    if lo =? a + 1 {
        let call=xr_code[call_pos[a]]
        if call.op =? 'call' and call.c =? 2 {
            return -1
        }
    }
    XWord(ra_cw[lo]) - XWord(ra_cw[a])
}
allocate_release=():>void=>$unsafe {
    let xr_callee_pool=callee_pool.ptr as ptr<XWord>
    let xr_caller_pool=caller_pool.ptr as ptr<XWord>
    let saved_flags=is_callee.ptr
    let nv:XWord=XWord(xr_ir[0].vtypes.length)
    callee_off = fill(0  16)
    let n:XWord=XWord(xr_ir[0].code.length) + 1
    ra_cw = fill(0  call_pos.length + 1)
    loop k in [0..call_pos.length) {
        ra_cw[k + 1] = ra_cw[k] + call_w[k]
    }
    if call_pos.length >? 0 {
        if ra_call_cut_storage.length <? n {
            ra_call_cut_storage.resize(n)
        }
        ra_call_cut = ra_call_cut_storage.ptr
        let calls=call_pos.ptr
        let next:XWord=0
        loop pos in [0..n) {
            loop next <? call_pos.length and calls[next] <? pos {
                next += 1
            }
            ra_call_cut[pos] = int32(next)
        }
    }
    let cross_storage:array<int64>=fill(0 nv)
    let cross=cross_storage.ptr as ptr<XWord>
    loop v in [0..nv) {
        if vloc[v] not=? LOC_SPILL {
            continue
        }
        cross[v] = ra_cross_w(live_start(v)  v_live[v].last)
    }
    ra_words = (n + 1) // 64 + 1
    ra_occ = fill(0  32 * ra_words)
    let placed_storage:array<bool>=fill(false nv)
    let placed=placed_storage.ptr
    let active=ra_active_storage.ptr
    let byreg=ra_byreg_storage.ptr
    loop r in [0..32) {
        byreg[r] = -1
    }
    let nactive:XWord=0
    let free:XWord=0xF008
    loop pos in [0..n) {
        let v:XWord=v_start[pos]
        if v <? 0 {
            continue
        }
        let k:XWord=0
        if xr_stats {
            ra_expire_visits += nactive
        }
        loop k <? nactive {
            let a:XWord=active[k]
            if v_live[a].last <? pos {
                let r:XWord=vloc[a]
                free |= 1 << r
                byreg[r] = -1
                nactive -= 1
                if k <? nactive {
                    active[k] = active[nactive]
                    byreg[vloc[active[k]]] = k
                }
            }
            else {
                k += 1
            }
        }
        loop v >=? 0 {
            if (cross[v] >? 1 or cross[v] =? -1 and v <? xr_ir[0].nparams and v_live[v].weight >? 8 * v_live[v].nuse) and xr_vtype(v) =? VI {
                let reg:XWord=-1
                loop ri in [XWord(0)..XWord(5)) {
                    let r:XWord=xr_callee_pool[ri]
                    if free & (1 << r) not=? 0 {
                        reg = r
                        break
                    }
                }
                if reg <? 0 {
                    let best:XWord=-1
                    if xr_stats {
                        ra_spill_visits += nactive
                    }
                    loop k in [0..nactive) {
                        let a:XWord=active[k]
                        if v_live[a].weight <? v_live[v].weight and (best <? 0 or v_live[a].weight <? v_live[best].weight) {
                            best = a
                        }
                    }
                    if best >=? 0 {
                        reg = vloc[best]
                        vloc[best] = LOC_SPILL
                        placed[best] = false
                        nactive = ra_remove(active  byreg  nactive  reg)
                    }
                }
                if reg >=? 0 {
                    vloc[v] = reg
                    placed[v] = true
                    free &= ((1 << reg) xor -1)
                    byreg[reg] = nactive
                    active[nactive] = v
                    nactive += 1
                    if xr_stats {
                        ra_peak_gpr = max(ra_peak_gpr  nactive)
                    }
                }
            }
            v = v_live[v].next_start
        }
    }
    loop v in [0..nv) {
        if placed[v] {
            ra_take(vloc[v]  live_start(v) + 1  v_live[v].last + 1)
            callee_off[vloc[v]] = 1
        }
    }
    free = 0x7FFCFFC8
    loop r in [0..32) {
        byreg[r] = -1
    }
    nactive = 0
    let min_end:XWord=INF_POS
    loop pos in [0..n) {
        let v:XWord=v_start[pos]
        if v >=? 0 and min_end <? pos {
            min_end = INF_POS
            let k:XWord=0
            if xr_stats {
                ra_expire_visits += nactive
            }
            loop k <? nactive {
                let a:XWord=active[k]
                if v_live[a].last <? pos {
                    let r:XWord=vloc[a]
                    free |= 1 << r
                    byreg[r] = -1
                    nactive -= 1
                    if k <? nactive {
                        active[k] = active[nactive]
                        byreg[vloc[active[k]]] = k
                    }
                }
                else {
                    if v_live[a].last <? min_end {
                        min_end = v_live[a].last
                    }
                    k += 1
                }
            }
        }
        loop v >=? 0 {
            if placed[v] {
                v = v_live[v].next_start
                continue
            }
            let s:XWord=live_start(v) + 1
            let e:XWord=v_live[v].last + 1
            let c:XWord=abs(cross[v])
            let caller_ok=c =? 0 or 4 * c <? 2 * v_live[v].weight
            let reg:XWord=-1
            let h:XWord=hint_operand(v  pos)
            if h >=? 0 and byreg[vloc[h]] >=? 0 and active[byreg[vloc[h]]] =? h {
                let r:XWord=vloc[h]
                let ok=ra_free(r  s + 1  e)
                if r <? XMM and not saved_flags[r] and not caller_ok {
                    ok = false
                }
                if r >=? XMM and not caller_ok {
                    ok = false
                }
                if ok {
                    reg = r
                    nactive = ra_remove(active  byreg  nactive  reg)
                }
            }
            if reg <? 0 {
                if xr_vtype(v) not=? VI {
                    if caller_ok {
                        loop x in [2..15) {
                            if free & (1 << (XMM + x)) not=? 0 and ra_free(XMM + x  s  e) {
                                reg = XMM + x
                                break
                            }
                        }
                    }
                }
                else {
                    if c >? 0 {
                        loop ri in [XWord(0)..XWord(5)) {
                    let r:XWord=xr_callee_pool[ri]
                            if free & (1 << r) not=? 0 and (c >? 1 or callee_off[r] not=? 0) and ra_free(r  s  e) {
                                reg = r
                                break
                            }
                        }
                    }
                    if reg <? 0 and caller_ok {
                        loop ri in [XWord(0)..XWord(6)) {
                    let r:XWord=xr_caller_pool[ri]
                            if free & (1 << r) not=? 0 and ra_free(r  s  e) {
                                reg = r
                                break
                            }
                        }
                    }
                    if reg <? 0 and c <=? 1 {
                        loop ri in [XWord(0)..XWord(5)) {
                    let r:XWord=xr_callee_pool[ri]
                            if free & (1 << r) not=? 0 and ra_free(r  s  e) {
                                reg = r
                                break
                            }
                        }
                    }
                }
            }
            if reg <? 0 and (c =? 0 or caller_ok or xr_vtype(v) =? VI) {
                let best:XWord=-1
                if xr_stats {
                    ra_spill_visits += nactive
                }
                loop k in [0..nactive) {
                    let a:XWord=active[k]
                    let ra:XWord=vloc[a]
                    if (ra >=? XMM) not=? (xr_vtype(v) not=? VI) {
                        continue
                    }
                    if not spills_before(a  v) {
                        continue
                    }
                    if (ra >=? XMM or not saved_flags[ra]) and not caller_ok {
                        continue
                    }
                    if not ra_free(ra  s  e) {
                        continue
                    }
                    if best <? 0 or spills_before(a  best) {
                        best = a
                    }
                }
                if best >=? 0 {
                    reg = vloc[best]
                    vloc[best] = LOC_SPILL
                    vsave[best] = false
                    nactive = ra_remove(active  byreg  nactive  reg)
                }
            }
            if reg >=? 0 {
                vloc[v] = reg
                vsave[v] = c >? 0 and (reg >=? XMM or not saved_flags[reg])
                free &= ((1 << reg) xor -1)
                byreg[reg] = nactive
                active[nactive] = v
                nactive += 1
                if xr_stats {
                    ra_pressure(active  nactive  pos)
                }
                if v_live[v].last <? min_end {
                    min_end = v_live[v].last
                }
                if reg <? XMM and saved_flags[reg] {
                    callee_off[reg] = 1
                }
            }
            else {
                vloc[v] = LOC_SPILL
            }
            v = v_live[v].next_start
        }
    }
    if ra_dump not=? "" and xr_ir[0].name =? ra_dump {
        loop v in [0..nv) {
            if v_live[v].last <? 0 {
                continue
            }
            let tag=""
            if placed[v] {
                tag = " (pass 1)"
            }
            printl("v{v} {live_start(v)}..{v_live[v].last} w {v_live[v].weight} calls {abs(cross[v])} -> {vloc[v]}{tag}" file=stderr)
        }
    }
}
layout_frame=():>void=>$unsafe {
    let off:XWord=0
    let saved=callee_off.ptr as ptr<XWord>
    loop r in [0..16) {
        if saved[r] not=? 0 {
            off += 8
            saved[r] = -off
        }
    }
    let nv:XWord=XWord(xr_ir[0].vtypes.length)
    vspill = fill(0 nv)
    let spill=vspill.ptr as ptr<XWord>
    save_list = []
    loop v in [0..nv) {
        if vloc[v] =? LOC_SPILL or (vsave[v] and vloc[v] >=? 0) {
            off += 8
            if is_vreg_vec(xr_vtype(v)) {
                off += 24
            }
            spill[v] = -off
            if vloc[v] >=? 0 {
                save_list.push(v)
            }
        }
    }
    slot_off = fill(0 xr_ir[0].slot_size.length)
    let slots=slot_off.ptr as ptr<XWord>
    let sizes=xr_ir[0].slot_size.ptr
    let aligns=xr_ir[0].slot_align.ptr
    loop s in [0..xr_ir[0].slot_size.length) {
        let sz:XWord=XWord(sizes[s])
        let al:XWord=XWord(aligns[s])
        off = xr_align(off + sz  al)
        slots[s] = -off
    }
    frame_size = xr_align(off  16)
}
ra_pressure=(active:ptr<int64> n:XWord pos:XWord):>void=>$unsafe {
    let xr_callee_pool=callee_pool.ptr as ptr<XWord>
    let gpr:XWord=0
    loop k in [0..n) {
        if vloc[active[k]] <? XMM {
            gpr += 1
        }
    }
    ra_peak_xmm = max(ra_peak_xmm  n - gpr)
    if pos >=? 0 {
        loop ri in [XWord(0)..XWord(5)) {
                    let r:XWord=xr_callee_pool[ri]
            if ra_occ[r * ra_words + ((pos + 1) >> 6)] & (1 << ((pos + 1) & 63)) not=? 0 {
                gpr += 1
            }
        }
    }
    ra_peak_gpr = max(ra_peak_gpr  gpr)
}

use 'diagnostic_exit.dewy'
use 'check.jo'
use 'ast.jo'
use 'checker_state.dewy'
use 'util.jo'

route_text = (n: int) -> str:
    k = nodes[n].kind
    if k == .ident and (nodes[n].aux == i32(int(SK.local)) or nodes[n].aux == i32(int(SK.global))):
        nm = name_of(int(nodes[n].name))
        return if len(nm) > 0 and nm[0] != '$': nm else: ""
    if k == .field:
        base = route_text(int(nodes[n].a))
        return if base == "": "" else: "{base}.{name_of(int(nodes[n].name))}"
    ""

same_route = (a: int, b: int) -> bool:
    k = nodes[a].kind
    if k != nodes[b].kind: return false
    if k == .ident: return nodes[a].aux == nodes[b].aux and nodes[a].sym == nodes[b].sym
    if k == .field: return nodes[a].name == nodes[b].name and same_route(int(nodes[a].a), int(nodes[b].a))
    false

value_loop_resize = (receiver: int, operation: str, pos: int):
    i = value_loops.len() - 1
    loop i >= 0:
        v = value_loops[i]
        if v.context == cx and same_route(v.route, receiver):
            src = route_text(v.route)
            el = if v.name != 0: name_of(v.name) else: "item"
            fatal(pos, "`{operation}` changes the length of `{src}`, which `loop {el} in {src}` iterates by its value at loop entry, so the loop would not see the change: write `loop {el} in @{src}` to iterate the live array, or bind a snapshot first (`let snapshot = {src}` then `loop {el} in snapshot`)")
        i -= 1

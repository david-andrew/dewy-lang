        # divisor is a possible failure, as for words)
        }
        if not supported and nodes.ptr[n].aux =? 0 and prune(ntype(n)) =? T_MATH_INT and effect_integer(EffectScanWord(nodes.ptr[n].a)) and effect_integer(EffectScanWord(nodes.ptr[n].b)) and (nodes.ptr[n].op =? int32<overflow='wrap'>(61) or nodes.ptr[n].op =? int32<overflow='wrap'>(62)) {
            supported=true
            effect_plan_cost(f n 1 << 2);
            let divisor:EffectScanWord=EffectScanWord(nodes.ptr[n].b)
            if nodes.ptr[divisor].kind not=? 'int_lit' or nodes.ptr[divisor].ival =? 0 {effect_failure(f n);}
        # (an `int` shifted may grow into a big integer, which allocates; a
        # negative signed count fails unless the owner's facts show it is not)
        }
        if not supported and shift and nodes.ptr[n].aux =? 0 and prune(ntype(n)) =? T_MATH_INT and effect_integer(EffectScanWord(nodes.ptr[n].a)) and effect_integer(EffectScanWord(nodes.ptr[n].b)) {
            supported=true
            effect_plan_cost(f n 1 << 2);
            if fact_shift_obliged(n) and not effect_count_literal(EffectScanWord(nodes.ptr[n].b)) {effect_failure(f n);}
    # (a match on a share copies it into a private hidden local and tests that
    # copy's tag or compares it with literals: reads only. A valued match with
    # no wildcard arm may find no arm, which fails. Bindings and arm bodies
    # answer for their own operations)
        }
    }
    else if k =? 'match_' {
        let subject:EffectScanWord=EffectScanWord(nodes.ptr[n].sym)
        supported=effect_share(ntype(EffectScanWord(nodes.ptr[n].a))) and (subject <=? 0 or EffectScanWord(locals.ptr[subject].flags) & (LF_CAPTURE | LF_CAPTURED | LF_SHARED | LF_BYREF) =? 0)
        let wild=false
        loop j in [0..nkids(n)) {
            let arm=kid(n j)
            loop q in [0..nkids(arm)) {
                if nodes.ptr[kid(arm q)].kind =? 'pwild' {wild=true}
            }
        }
        if supported and not wild and not has_flag(n NF_STMT) and vc(ntype(n)) not=? VC_VOID and ntype(n) not=? T_NEVER {effect_failure(f n);}
    # (an optional's payload, `x!` or a match binding's: an inline read that
    # fails when the value is none)
    }
    else if k =? 'unwrap' {
        supported=effect_share(ntype(EffectScanWord(nodes.ptr[n].a))) and effect_share(ntype(n))
        if supported {effect_failure(f n);}
    }
    else if k =? 'arm' {supported=nodes.ptr[n].a =? 0 and nodes.ptr[n].c =? 0}
    else if k =? 'pwild' or k =? 'ptype' or k =? 'plit' or k =? 'prange' {supported=true}
    else if k =? 'dotname' or k =? 'none_lit' {supported=effect_share(ntype(n))}
    # (an optional's or union's tag test, payload and fallback are inline reads)
    else if k =? 'istype' or k =? 'narrow' or k =? 'coalesce' {supported=effect_share(ntype(EffectScanWord(nodes.ptr[n].a))) and (k =? 'istype' or effect_share(ntype(n)))}
    else if k =? 'unary' {
        supported=effect_scalar(ntype(n)) and (nodes.ptr[n].op =? int32<overflow='wrap'>(59) or nodes.ptr[n].op =? int32<overflow='wrap'>(58) or nodes.ptr[n].op =? int32<overflow='wrap'>(66))
        supported=supported or effect_float(ntype(n)) and (nodes.ptr[n].op =? int32<overflow='wrap'>(59) or nodes.ptr[n].op =? int32<overflow='wrap'>(58))
        # (negating an `int` may grow it: -(-2^63))
        if not supported and prune(ntype(n)) =? T_MATH_INT and (nodes.ptr[n].op =? int32<overflow='wrap'>(59) or nodes.ptr[n].op =? int32<overflow='wrap'>(58)) {
            supported=true
            effect_plan_cost(f n 1 << 2);
        }
    }
    else if k =? 'conv' and nodes.ptr[n].aux =? int32<overflow='wrap'>(13) and ownership_scalar(ntype(n)) {supported=true}
    else if k =? 'conv' and nodes.ptr[n].aux =? int32<overflow='wrap'>(14) {
        # A proven refinement check is erased; an unproven one may fail.
        supported=effect_plain(ntype(n)) or effect_footprints_only and nd_shape_predicates.has(EffectScanWord(types.ptr[zonk(EffectScanWord(nodes.ptr[n].aux2))].st)) and effect_value(ntype(n))
        # (a self-contained contract on a value, `denominator:int<(>? 0)>`:
        # its check compares the value, or its length or fields, with
        # constants; it reads only that value and writes nothing, though an
        # `int` comparison may make a big constant: an allocation)
        if not supported and effect_value(ntype(n)) and effect_self_contract(EffectScanWord(nodes.ptr[n].aux2)) {
            supported=true
            if not type_eq(ntype(EffectScanWord(nodes.ptr[n].a)) EffectScanWord(nodes.ptr[n].aux2)) {effect_plan_cost(f n 1 << 2);}
        }
        if supported and not type_eq(ntype(EffectScanWord(nodes.ptr[n].a)) EffectScanWord(nodes.ptr[n].aux2)) {effect_failure(f n);}
    # (wrapping a value as an optional, or one union as a wider one, fills the
    # flag or tag and the payload in place)
    }
    else if k =? 'conv' and (nodes.ptr[n].aux =? int32<overflow='wrap'>(5) or nodes.ptr[n].aux =? int32<overflow='wrap'>(9)) {supported=effect_share(ntype(n)) and effect_share(ntype(EffectScanWord(nodes.ptr[n].a)))}
    else if k =? 'conv' and nodes.ptr[n].aux =? int32<overflow='wrap'>(11) {
        supported=effect_share(ntype(n))
        if not has_flag(n NF_INBOUNDS) {effect_failure(f n);}
    }
    else if k =? 'conv' and nodes.ptr[n].aux =? int32<overflow='wrap'>(17) {supported=true}
    # (a word widened to an `int` may need a big payload: an allocation)
    else if k =? 'conv' and nodes.ptr[n].aux =? int32<overflow='wrap'>(1) and prune(ntype(n)) =? T_MATH_INT and effect_scalar(ntype(EffectScanWord(nodes.ptr[n].a))) {
        supported=true
        if effect_small(EffectScanWord(nodes.ptr[n].a)) <? 0 {effect_plan_cost(f n 1 << 2);}
    # (an `int` narrowed to a fixed width fails unless the owner's facts show it fits)
    }
    else if k =? 'conv' and nodes.ptr[n].aux =? int32<overflow='wrap'>(1) and prune(ntype(EffectScanWord(nodes.ptr[n].a))) =? T_MATH_INT and effect_scalar(ntype(n)) and effect_small(EffectScanWord(nodes.ptr[n].a)) <? 0 {
        supported=true
        effect_failure(f n);
    # (an `int` wrapped or saturated to a fixed width is total: a read of its
    # low limbs, lib/math_runtime.jo __mi_low_word and __mi_clamp_word)
    }
    else if k =? 'conv' and (nodes.ptr[n].aux =? int32<overflow='wrap'>(19) or nodes.ptr[n].aux =? int32<overflow='wrap'>(20)) and prune(ntype(EffectScanWord(nodes.ptr[n].a))) =? T_MATH_INT and effect_scalar(ntype(n)) {supported=true}
    # (a float to an integer fails for NaN, an infinity or a value out of
    # range unless the owner's float facts show it fits, floats.jo; an `int`
    # result may need a big payload)
    else if k =? 'conv' and nodes.ptr[n].aux =? int32<overflow='wrap'>(3) and effect_float(ntype(EffectScanWord(nodes.ptr[n].a))) and (effect_scalar(ntype(n)) or prune(ntype(n)) =? T_MATH_INT) {
        supported=true
        if prune(ntype(n)) =? T_MATH_INT {effect_plan_cost(f n 1 << 2);}
        effect_failure(f n);
    # (a word to a float, or one float width to another: one instruction; a
    # float to an integer is checked, and a semantic integer's is a call)
    }
    else if k =? 'conv' and (nodes.ptr[n].aux =? int32<overflow='wrap'>(2) and effect_scalar(ntype(EffectScanWord(nodes.ptr[n].a))) or nodes.ptr[n].aux =? int32<overflow='wrap'>(4)) {supported=effect_float(ntype(n))}
    # (an `int` to a float, `i * 40.0`: a word conversion, or a read of its big
    # payload that writes nothing (lib/math_runtime.jo __mi_float); that read
    # keeps a possible allocation and failure)
    else if k =? 'conv' and nodes.ptr[n].aux =? int32<overflow='wrap'>(2) and prune(ntype(EffectScanWord(nodes.ptr[n].a))) =? T_MATH_INT and effect_float(ntype(n)) {
        supported=true
        if effect_small(EffectScanWord(nodes.ptr[n].a)) <? 0 {
            effect_plan_cost(f n 1 << 2);
            effect_failure(f n);
    # (a number's bits read as another number of the same width, as the
    # library's float `abs` and `min` do: one move, never a pointer. A write
    # footprint only; full summaries keep it opaque)
        }
    }
    else if k =? 'cast' and effect_footprints_only and not raw_view(n) and (effect_scalar(ntype(n)) or effect_float(ntype(n))) and (effect_scalar(ntype(EffectScanWord(nodes.ptr[n].a))) or effect_float(ntype(EffectScanWord(nodes.ptr[n].a)))) {supported=true}
    else if k =? 'conv' {
        supported=(effect_scalar(ntype(n)) and effect_word(EffectScanWord(nodes.ptr[n].a)) or effect_small(n) >=? 0 or is_fn_type(ntype(n)) and effect_bare(EffectScanWord(nodes.ptr[n].a))) and (nodes.ptr[n].aux =? int32<overflow='wrap'>(0) or nodes.ptr[n].aux =? int32<overflow='wrap'>(1) or nodes.ptr[n].aux =? int32<overflow='wrap'>(19) or nodes.ptr[n].aux =? int32<overflow='wrap'>(20) or nodes.ptr[n].aux =? int32<overflow='wrap'>(21))
    }
    if not supported {effect_opaque(f n);}
    # Hidden calls cannot be trusted by annotation or pathname. They remain
    # explicit dependencies for witnesses and legacy isolation even when this
    # pilot's cost inventory has already rejected their containing operation.
    loop g in hidden {effect_summaries.ptr[f].edges.push(EffectEdge[g n []]);}
    if hidden.length >? 0 and (k =? 'binary' or k =? 'intrinsic') {
        let operand=if k =? 'binary' {EffectScanWord(nodes.ptr[n].a)} else if nkids(n) >? 0 {kid(n 0)} else {0}
        if operand not=? 0 and is_managed(representation_type(ntype(operand))) {
            # Callback snapshots may copy managed values. No uniqueness proof
            # is available at this boundary yet, so retain the residual cost.
            effect_plan_cost(f n 1 << 2);
        }
    }
    let mask=isolation_children(k)
    if mask <? 0 {return}
    if mask & 1 not=? 0 {effect_scan_node(f EffectScanWord(nodes.ptr[n].a));}
    if mask & 2 not=? 0 {effect_scan_node(f EffectScanWord(nodes.ptr[n].b));}
    if mask & 4 not=? 0 {effect_scan_node(f EffectScanWord(nodes.ptr[n].c));}
    if mask & 16 not=? 0 {
        loop j in [0..nkids(n)) {effect_scan_node(f kid(n j));}
    }
    if mask & 32 not=? 0 {
        loop j in [0..nkids2(n)) {effect_scan_node(f kid2(n j));}
    }
}

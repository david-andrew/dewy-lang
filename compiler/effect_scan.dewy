            supported=fact_comparison(cx_token_values.ptr[EffectScanWord(nodes.ptr[n].op)]) or nodes.ptr[n].op =? int32<overflow='wrap'>(58)
            if nodes.ptr[n].op =? int32<overflow='wrap'>(58) {effect_plan_cost(f n 1 << 2);}
        }
        if not supported and nodes.ptr[n].aux =? 0 and fact_comparison(cx_token_values.ptr[EffectScanWord(nodes.ptr[n].op)]) and effect_integer(EffectScanWord(nodes.ptr[n].a)) and effect_integer(EffectScanWord(nodes.ptr[n].b)) {supported=true}
        if not supported and nodes.ptr[n].aux =? 0 and prune(ntype(n)) =? T_MATH_INT and effect_integer(EffectScanWord(nodes.ptr[n].a)) and effect_integer(EffectScanWord(nodes.ptr[n].b)) and (nodes.ptr[n].op =? int32<overflow='wrap'>(58) or nodes.ptr[n].op =? int32<overflow='wrap'>(59) or nodes.ptr[n].op =? int32<overflow='wrap'>(60)) {

            return
        }
        let inner:array<int64>=[]
        if isolation_effect(loop_ @inner) not=? IsolationReason.none_ {effect_isolation_block(f IsolationReason.node loop_);}
        loop g in inner {effect_summaries.ptr[f].edges.push(EffectEdge[g loop_ []]);}
        let it:EffectScanWord=EffectScanWord(nodes.ptr[loop_].a)

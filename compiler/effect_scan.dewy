        }
    }
    if k =? 'array' and (nkids(n) >? 0 or nodes.ptr[n].b not=? 0) and not effect_fixed_literal(n) {effect_plan_cost(f n 1 << 2);}
    if k =? 'str_lit' and nkids(n) >? 0 {effect_plan_cost(f n 1 << 2);}
    # (an interpolated part: its formatter writes the interpolation's own buffer)
    if k =? 'pair' and nodes.ptr[n].sym >? 0 and nodes.ptr[n].b =? 0 {
        effect_summaries.ptr[f].edges.push(EffectEdge[EffectScanWord(nodes.ptr[n].sym) n [PlaceIdentity['local' f n]]]);
        effect_scan_node(f EffectScanWord(nodes.ptr[n].a));
        return
    }
    if k =? 'lambda' and nodes.ptr[n].sym >? 0 and fns.ptr[EffectScanWord(nodes.ptr[n].sym)].caps.length not=? 0 {
        effect_plan_cost(f n 1 << 2);
    }
    if k =? 'partial' {effect_plan_cost(f n 1 << 2);}
    if k =? 'conv' and (nodes.ptr[n].aux =? int32<overflow='wrap'>(10) or nodes.ptr[n].aux =? int32<overflow='wrap'>(8) or nodes.ptr[n].aux =? int32<overflow='wrap'>(13) and not effect_plain(ntype(n)) and not ownership_scalar(ntype(n))) {
        effect_plan_cost(f n 1 << 2);
    }
    if k =? 'call' and nodes.ptr[n].aux =? 2 {
        effect_cleanup(f ntype(n) n PlaceIdentity['local' f n]);
        let t=representation_type(ntype(n))
        layout(t);
        if EffectScanWord(types.ptr[t].flags) & TF_BOXED not=? 0 {effect_plan_cost(f n 1 << 2);}
    }
    if k =? 'vardecl' and not has_flag(n NF_GLOBAL) and nodes.ptr[n].sym >? 0 {

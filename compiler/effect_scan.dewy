        # (small semantic integers: arithmetic that cannot promote, comparisons)
        }
        if not supported and nodes.ptr[n].aux =? 0 and effect_word(EffectScanWord(nodes.ptr[n].a)) and effect_word(EffectScanWord(nodes.ptr[n].b)) {

            let a=effect_unwidened(EffectScanWord(nodes.ptr[n].a))
            let b=effect_unwidened(EffectScanWord(nodes.ptr[n].b))
            if (a not=? EffectScanWord(nodes.ptr[n].a) or b not=? EffectScanWord(nodes.ptr[n].b)) and effect_word(a) and effect_word(b) {
                loop g in hidden {effect_summaries.ptr[f].edges.push(EffectEdge[g n []]);}

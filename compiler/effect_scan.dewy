# Demanded body and place scanning; shared state has one owner in effects.jo.
EffectScanWord:type=int64<overflow='wrap'>
# Locals never cross call edges. Externally visible roots use owner-qualified
# formal ordinals, global declarations, or conservatively opaque provenance.
effect_export=(f:EffectScanWord p0:PlaceIdentity):>PlaceIdentity=>$unsafe {
    let p=place_base(p0)
    if p.root =? 'local' {
        let l=p.declaration
        if l <=? 0 or l >=? locals.length {return PlaceIdentity['local' 0 0]}
        let fl:EffectScanWord=EffectScanWord(locals.ptr[l].flags)
        if fl & (LF_CAPTURE | LF_SHARED | LF_CAPTURED) not=? 0 {return PlaceIdentity['local' 0 0]}
        if fl & LF_MUTPARAM not=? 0 {
            loop i in [0..fns.ptr[f].params.length) {
                if fns.ptr[f].params.ptr[i] =? l {return place_append(PlaceIdentity['formal' f i + 1] p0)}
            }
            return PlaceIdentity['local' 0 0]
        }
    }
    return p0
}
# Identity alone is not a storage proof. Recursive fields can introduce
# box_unique (allocation/detach) while taking the address of a scalar leaf.
# Consult the same layout/boxed-field decision as both lowerers.
effect_place_inventory=(n:EffectScanWord depth:EffectScanWord=0):>bool=>$unsafe {
    if n =? 0 or depth >? 32 {return false}
    let k=nodes.ptr[n].kind
    if k =? 'addr' {return effect_place_inventory(EffectScanWord(nodes.ptr[n].a) depth + 1)}
    if effect_fixed_index(n) {return effect_place_inventory(EffectScanWord(nodes.ptr[n].a) depth + 1)}
    if k =? 'field' {
        let t=prune(ntype(EffectScanWord(nodes.ptr[n].a)))
        # A swizzle accesses inline lanes of its vector, with no hooks or box.
        if nodes.ptr[n].aux =? -4 and is_vec(t) {return effect_place_inventory(EffectScanWord(nodes.ptr[n].a) depth + 1)}
        # (a tuple's element, `a[0]`, is inline storage of the tuple)
        if nodes.ptr[n].aux =? -2 and tkind(representation_type(t)) =? 'tuple' {return effect_place_inventory(EffectScanWord(nodes.ptr[n].a) depth + 1)}
        if types.ptr[t].kind not=? 'struct_' or nodes.ptr[n].aux <? 0 {return false}
        layout(t);
        let fi:EffectScanWord=EffectScanWord(structs.ptr[EffectScanWord(types.ptr[t].st)].fields) + EffectScanWord(nodes.ptr[n].aux)
        if fields.ptr[fi].boxed {return false}
        return effect_place_inventory(EffectScanWord(nodes.ptr[n].a) depth + 1)
    }
    if k not=? 'ident' {return false}
    if nodes.ptr[n].aux =? int32<overflow='wrap'>(2) {return true}
    if nodes.ptr[n].aux not=? int32<overflow='wrap'>(1) {return false}
    let l:EffectScanWord=EffectScanWord(nodes.ptr[n].sym)
    let flags:EffectScanWord=EffectScanWord(locals.ptr[l].flags)
    if flags & LF_ALIAS not=? 0 {
        # (a binding narrowed by `is?` names its payload, or the union's
        # remaining members: the test proved the tag)
        return effect_place_inventory(effect_narrowed(EffectScanWord(locals.ptr[l].alias)) depth + 1)
    }
    return flags & (LF_CAPTURE | LF_CAPTURED | LF_SHARED | LF_BYREF | LF_EXPOSED) =? 0
}
# `mk(i).x`, `rect(i).w`: a field of a direct call's result reads the
# temporary only, never a place. Every level is an inline value (no hook,
# box or owner), so the read adds nothing to the call's own effects. O(depth).
effect_field_root=(n0:EffectScanWord):>int64=>$unsafe {
    let n=n0
    loop depth in [0..32) {
        if nodes.ptr[n].kind not=? 'field' {return n}
        n=EffectScanWord(nodes.ptr[n].a)
    }
    return 0
}
effect_temporary_field=(n0:EffectScanWord):>bool=>$unsafe {
    let root=effect_field_root(n0)
    if root =? 0 or nodes.ptr[root].kind not=? 'call' or nodes.ptr[root].aux not=? 0 {return false}
    let n=n0
    loop n not=? root {
        let t=representation_type(ntype(EffectScanWord(nodes.ptr[n].a)))
        if not effect_value(ntype(n)) or not effect_value(t) {return false}
        if nodes.ptr[n].aux =? -4 {
            if not is_vec(t) {return false}
        }
        else if nodes.ptr[n].aux =? -2 {
            if tkind(t) not=? 'tuple' {return false}
        }
        else {
            if tkind(t) not=? 'struct_' or nodes.ptr[n].aux <? 0 {return false}
            layout(t);
            if fields.ptr[EffectScanWord(structs.ptr[EffectScanWord(types.ptr[t].st)].fields) + EffectScanWord(nodes.ptr[n].aux)].boxed {return false}
        }
        n=EffectScanWord(nodes.ptr[n].a)
    }
    return true
}
# A refinement whose atoms name only the value itself, literals and type
# limits: no formal or lexical dependency to read. O(atoms).
effect_self_contract=(t0:EffectScanWord):>bool=>$unsafe {
    let t=zonk(t0)
    if types.ptr[t].kind not=? 'refined' {return false}
    loop atom in ref_predicates.ptr[EffectScanWord(types.ptr[t].st)] {
        loop term in [atom.a atom.b] {
            if term.kind not=? 0 and term.kind not=? 1 and term.kind not=? 4 {return false}
        }
    }
    return true
}
# The value a narrowing alias reads: an optional's payload, a union's member,
# or the union's remaining members re-tagged in place; n itself otherwise.
effect_narrowed=(n:EffectScanWord):>int64=>$unsafe {
    let k=nodes.ptr[n].kind
    if k =? 'unwrap' or k =? 'narrow' or k =? 'conv' and nodes.ptr[n].aux =? int32<overflow='wrap'>(9) and effect_share(ntype(n)) and effect_share(ntype(EffectScanWord(nodes.ptr[n].a))) {return EffectScanWord(nodes.ptr[n].a)}
    return n
}
# `xs[i]`: one index. The checker keeps the written selector as the only kid
# (a compound update reads a captured copy); scanning both is conservative.
effect_single_index=(n:EffectScanWord):>bool=>$unsafe {
    return nodes.ptr[n].kind =? 'index' and nodes.ptr[n].b not=? 0 and nkids(n) <=? 1
}
# An element of a fixed array is inline storage of the array: `xs[i]` with a
# word index. Element routes are coarse (the whole array), never invented.
effect_fixed_index=(n:EffectScanWord):>bool=>$unsafe {
    if not effect_single_index(n) {return false}
    let t=representation_type(ntype(EffectScanWord(nodes.ptr[n].a)))
    return tkind(t) =? 'fixed' and effect_plain(EffectScanWord(types.ptr[t].elem)) and effect_word(EffectScanWord(nodes.ptr[n].b))
}
# A read-only element read: a fixed array's, or an array of shares' (a
# shared immutable view; reading it neither detaches nor allocates).
effect_index_read=(n:EffectScanWord):>bool=>$unsafe {
    if effect_fixed_index(n) {return true}
    if not effect_single_index(n) {return false}
    let t=representation_type(ntype(EffectScanWord(nodes.ptr[n].a)))
    return tkind(t) =? 'array' and effect_share(telem(t)) and effect_word(EffectScanWord(nodes.ptr[n].b))
}
effect_route=(n:EffectScanWord depth:EffectScanWord=0):>PlaceIdentity=>$unsafe {
    if depth >? 32 {return PlaceIdentity['local' 0 0]}
    let k=nodes.ptr[n].kind
    if k =? 'addr' or effect_fixed_index(n) {return effect_route(EffectScanWord(nodes.ptr[n].a) depth + 1)}
    # A write of any lane conservatively writes the whole vector place.
    if k =? 'field' and nodes.ptr[n].aux =? -4 and is_vec(ntype(EffectScanWord(nodes.ptr[n].a))) {return effect_route(EffectScanWord(nodes.ptr[n].a) depth + 1)}
    # (and a tuple element's, the whole tuple's)
    if k =? 'field' and nodes.ptr[n].aux =? -2 and tkind(representation_type(ntype(EffectScanWord(nodes.ptr[n].a)))) =? 'tuple' {return effect_route(EffectScanWord(nodes.ptr[n].a) depth + 1)}
    if k =? 'field' and tkind(ntype(EffectScanWord(nodes.ptr[n].a))) =? 'struct_' {return place_project(effect_route(EffectScanWord(nodes.ptr[n].a) depth + 1) EffectScanWord(nodes.ptr[n].name))}
    if k =? 'ident' and nodes.ptr[n].aux =? int32<overflow='wrap'>(1) and EffectScanWord(locals.ptr[EffectScanWord(nodes.ptr[n].sym)].flags) & LF_ALIAS not=? 0 {
        # (a binding narrowed by `is?` reads the optional's or union's own storage)
        let alias:EffectScanWord=EffectScanWord(locals.ptr[EffectScanWord(nodes.ptr[n].sym)].alias)
        if effect_narrowed(alias) not=? alias {return effect_route(effect_narrowed(alias) depth + 1)}
    }
    if k =? 'field' or k =? 'ident' and nodes.ptr[n].aux =? int32<overflow='wrap'>(1) and EffectScanWord(locals.ptr[EffectScanWord(nodes.ptr[n].sym)].flags) & LF_ALIAS not=? 0 {return place_route(n depth)}
    return place_scalar_root(n)
}
# The selectors a target place evaluates: element indices and their bounds.
effect_target_parts=(f:EffectScanWord n:EffectScanWord depth:EffectScanWord=0):>void=>$unsafe {
    if n =? 0 or depth >? 32 {return}
    let k=nodes.ptr[n].kind
    if effect_fixed_index(n) {
        effect_scan_node(f EffectScanWord(nodes.ptr[n].b));
        loop i in [0..nkids(n)) {effect_scan_node(f kid(n i));}
        effect_bounds(f n);
    }
    if k =? 'addr' or k =? 'field' or effect_fixed_index(n) {effect_target_parts(f EffectScanWord(nodes.ptr[n].a) depth + 1);}
}
# A semantic integer that provably stays a small immediate (no promotion, no
# check): a nonnegative literal, a small counter, and sums, differences and
# products of them. Its magnitude bound, or -1.
effect_small=(n:EffectScanWord depth:EffectScanWord=0):>int64=>$unsafe {
    if n =? 0 or depth >? 8 {return -1}
    let bounded=exact_small_math(n)
    if bounded >=? 0 {return bounded}
    let k=nodes.ptr[n].kind
    if k =? 'int_lit' and is_int(ntype(n)) and not has_flag(n NF_U64) and nodes.ptr[n].ival >=? 0 {return if nodes.ptr[n].ival <? (1 << 31) {nodes.ptr[n].ival} else {-1}}
    if k =? 'ident' and nodes.ptr[n].aux =? int32<overflow='wrap'>(1) and prune(ntype(n)) =? T_MATH_INT {return effect_counters.get(EffectScanWord(nodes.ptr[n].sym)) ?? (-1)}
    # (a value-preserving integer conversion of a small value)
    if k =? 'conv' and (nodes.ptr[n].aux =? int32<overflow='wrap'>(1) or nodes.ptr[n].aux =? int32<overflow='wrap'>(0)) and is_int(ntype(n)) {return effect_small(EffectScanWord(nodes.ptr[n].a) depth + 1)}
    if k not=? 'binary' or nodes.ptr[n].aux not=? 0 or prune(ntype(n)) not=? T_MATH_INT {return -1}
    let op=cx_token_values.ptr[EffectScanWord(nodes.ptr[n].op)]
    if op not=? 'plus' and op not=? 'minus' and op not=? 'star' {return -1}
    let a:EffectScanWord=effect_small(EffectScanWord(nodes.ptr[n].a) depth + 1)
    let b:EffectScanWord=effect_small(EffectScanWord(nodes.ptr[n].b) depth + 1)
    if a <? 0 or b <? 0 {return -1}
    let r=if op =? 'star' {a * b} else {a + b}
    if r >=? (1 << 40) {return -1}
    return r
}
# A word operand, or a semantic integer that stays a small immediate.
effect_word=(n:EffectScanWord):>bool=>$unsafe {
    return effect_scalar(ntype(n)) or effect_small(n) >=? 0
}
# An integer: a word or an `int`.
effect_integer=(n:EffectScanWord):>bool=>$unsafe {
    let t=representation_type(ntype(n))
    return t =? T_MATH_INT or effect_scalar(t) and types.ptr[t].kind =? 'int_'
}
# The word inside a value-preserving widening of a word to `int`, or n.
effect_unwidened=(n:EffectScanWord):>int64=>$unsafe {
    if nodes.ptr[n].kind =? 'conv' and (nodes.ptr[n].aux =? int32<overflow='wrap'>(1) or nodes.ptr[n].aux =? int32<overflow='wrap'>(0)) and prune(ntype(n)) =? T_MATH_INT and effect_scalar(ntype(EffectScanWord(nodes.ptr[n].a))) {return EffectScanWord(nodes.ptr[n].a)}
    return n
}
# A counted loop over a word range: its bounds are evaluated once, and its
# counter is a private word (or a small semantic integer, recorded).
effect_range_loop=(n:EffectScanWord):>bool=>$unsafe {
    let it:EffectScanWord=EffectScanWord(nodes.ptr[n].a)
    if nodes.ptr[it].kind not=? 'range' or nodes.ptr[n].sym <=? 0 {return false}
    let l:EffectScanWord=EffectScanWord(nodes.ptr[n].sym)
    let small=prune(EffectScanWord(locals.ptr[l].type)) =? T_MATH_INT
    if not small and not effect_scalar(EffectScanWord(locals.ptr[l].type)) {return false}
    if EffectScanWord(locals.ptr[l].flags) & (LF_ASSIGNED | LF_CAPTURE | LF_CAPTURED | LF_SHARED | LF_BYREF | LF_ADDR | LF_EXPOSED) not=? 0 {return false}
    let bound:EffectScanWord=0
    loop c in [EffectScanWord(nodes.ptr[it].a) EffectScanWord(nodes.ptr[it].b) EffectScanWord(nodes.ptr[it].c)] {
        if c =? 0 {continue}
        if small {
            let m=effect_small(c)
            if m <? 0 {return false}
            bound=max(bound m + 1)
        }
        else if not effect_scalar(ntype(c)) and not effect_count_literal(c) {return false}
    }
    if small {effect_counters[l] = bound;}
    return true
}
# A counted loop over an `int` range whose bounds are not proven small, `loop
# c in [a[0]..b[0]]`: the same private counter, whose steps and comparisons
# may make a big integer (an allocation). O(1).
effect_big_range_loop=(n:EffectScanWord):>bool=>$unsafe {
    let it:EffectScanWord=EffectScanWord(nodes.ptr[n].a)
    if nodes.ptr[it].kind not=? 'range' or nodes.ptr[n].sym <=? 0 {return false}
    let l:EffectScanWord=EffectScanWord(nodes.ptr[n].sym)
    if prune(EffectScanWord(locals.ptr[l].type)) not=? T_MATH_INT {return false}
    if EffectScanWord(locals.ptr[l].flags) & (LF_ASSIGNED | LF_CAPTURE | LF_CAPTURED | LF_SHARED | LF_BYREF | LF_ADDR | LF_EXPOSED) not=? 0 {return false}
    loop c in [EffectScanWord(nodes.ptr[it].a) EffectScanWord(nodes.ptr[it].b) EffectScanWord(nodes.ptr[it].c)] {
        if c not=? 0 and prune(ntype(c)) not=? T_MATH_INT and not effect_scalar(ntype(c)) {return false}
    }
    return true
}
# A fixed array literal is built in place: its elements, or zeros.
effect_fixed_literal=(n:EffectScanWord):>bool=>$unsafe {
    let t=representation_type(ntype(n))
    if nodes.ptr[n].kind not=? 'array' or nodes.ptr[n].b not=? 0 or tkind(t) not=? 'fixed' or not effect_plain(t) {return false}
    loop i in [0..nkids(n)) {
        let c=kid(n i)
        if has_flag(c NF_SPREAD) {return false}
    }
    return true
}
# Proven immutable startup constants need no external read: a literal word,
# or a fixed array of literal words.
effect_const_literal=(g:EffectScanWord):>bool=>$unsafe {
    if globals.ptr[g].is_const {
        let init:EffectScanWord=EffectScanWord(globals.ptr[g].init)
        return init not=? 0 and (nodes.ptr[init].kind =? 'int_lit' or nodes.ptr[init].kind =? 'bool_lit')
    }
    if not readonly_global(g) {return false}
    let init:EffectScanWord=EffectScanWord(nodes.ptr[EffectScanWord(globals.ptr[g].decl)].b)
    if init =? 0 {return false}
    if nodes.ptr[init].kind =? 'conv' and nodes.ptr[init].aux =? int32<overflow='wrap'>(0) {init=EffectScanWord(nodes.ptr[init].a)}
    if nodes.ptr[init].kind not=? 'array' or nodes.ptr[init].b not=? 0 or tkind(representation_type(EffectScanWord(globals.ptr[g].type))) not=? 'fixed' {return false}
    loop i in [0..nkids(init)) {
        let c=kid(init i)
        if nodes.ptr[c].kind not=? 'int_lit' and nodes.ptr[c].kind not=? 'bool_lit' or has_flag(c NF_SPREAD) {return false}
    }
    return true
}
effect_access=(f:EffectScanWord n:EffectScanWord write:bool):>void=>$unsafe {
    if not effect_value(ntype(n)) or not effect_place_inventory(n) {effect_opaque(f n);}
    if write and nodes.ptr[n].kind =? 'field' {
        let t=representation_type(ntype(EffectScanWord(nodes.ptr[n].a)))
        layout(t);
        if EffectScanWord(types.ptr[t].flags) & TF_BOXED not=? 0 {effect_plan_cost(f n 1 << 2);}
    }
    let p=effect_export(f effect_route(n))
    if p.declaration =? 0 {
        effect_opaque(f n);
        return
    }
    if p.root =? 'local' {return}
    if p.root =? 'global' and not write and effect_const_literal(p.declaration) {return}
    let kind=if write {'write'} else {'read'}
    effect_add(f EffectEvent[EffectAtom[kind p] n]);
}
effect_isolation_block=(f:EffectScanWord reason:IsolationReason n:EffectScanWord):>void=>$unsafe {
    if effect_summaries.ptr[f].isolation =? IsolationReason.none_ {
        effect_summaries.ptr[f].isolation = reason;
        effect_summaries.ptr[f].isolation_witness = n;
    }
}
# One full collection even after a blocker. Legacy isolation reuses the
# conservative blocker and direct edges from this scan, never a row permission.
# A bounded backward proof for storage costs only. An invocation contract does
# not prove that copying an arbitrary environment is free. Join every source;
# lost provenance, recursion or an exposed entry point remains unknown.
effect_bare=(n:EffectScanWord depth:EffectScanWord=0):>bool=>$unsafe {
    if n =? 0 or depth >? 16 {return false}
    let k=nodes.ptr[n].kind
    if k =? 'conv' {return effect_bare(EffectScanWord(nodes.ptr[n].a) depth + 1)}
    if k =? 'lambda' and not has_flag(n NF_GENERIC) {return nodes.ptr[n].sym >? 0 and fns.ptr[EffectScanWord(nodes.ptr[n].sym)].caps.length =? 0}
    if k =? 'fnref' {return nodes.ptr[n].aux not=? 1 and nodes.ptr[n].aux not=? 2 and nodes.ptr[n].sym >? 0 and not fns.ptr[EffectScanWord(nodes.ptr[n].sym)].has_env}
    if k not=? 'ident' or nodes.ptr[n].aux not=? int32<overflow='wrap'>(1) {return false}
    let l:EffectScanWord=EffectScanWord(nodes.ptr[n].sym)
    let flags:EffectScanWord=EffectScanWord(locals.ptr[l].flags)
    if flags & (LF_CAPTURE | LF_CAPTURED | LF_SHARED | LF_ADDR | LF_EXPOSED) not=? 0 {return false}
    if flags & LF_PARAM not=? 0 {
        let owner:EffectScanWord=EffectScanWord(locals.ptr[l].owner)
        let slot:EffectScanWord=-1
        loop i in [0..fns.ptr[owner].params.length) {
            if fns.ptr[owner].params.ptr[i] =? l {slot=i}
        }
        if slot <? 0 or fns.ptr[owner].cabi or (fns.ptr[owner].export_name).length not=? 0 {return false}
        let found=false
        loop q in effect_use_sites(owner) {
            if nodes.ptr[q].kind =? 'fnref' and nodes.ptr[q].sym =? int32<overflow='wrap'>(owner) {return false}
            if nodes.ptr[q].kind not=? 'call' or nodes.ptr[q].aux not=? 0 or nodes.ptr[q].sym not=? int32<overflow='wrap'>(owner) {continue}
            if slot >=? nkids(q) or not effect_bare(kid(q slot) depth + 1) {return false}
            found=true
        }
        return found
    }
    let found=false
    loop q in effect_scalar_sites(l) {
        if nodes.ptr[q].kind =? 'vardecl' and not has_flag(q NF_GLOBAL) and nodes.ptr[q].sym =? int32<overflow='wrap'>(l) {
            if not effect_bare(EffectScanWord(nodes.ptr[q].b) depth + 1) {return false}
            found=true
        }
        if nodes.ptr[q].kind =? 'assign' and place_scalar_root(EffectScanWord(nodes.ptr[q].a)) =? PlaceIdentity['local' EffectScanWord(locals.ptr[l].owner) l] {
            if not effect_bare(EffectScanWord(nodes.ptr[q].b) depth + 1) {return false}
        }
    }
    return found
}
effect_readonly_binding=(n:EffectScanWord):>bool=>$unsafe {
    if nodes.ptr[n].kind not=? 'vardecl' or nodes.ptr[n].aux2 not=? 1 {return false}
    if dbg_on and (not copies_on or not copy_strict(n)) {return false}
    let l:EffectScanWord=EffectScanWord(nodes.ptr[n].sym)
    let a:EffectScanWord=EffectScanWord(nodes.ptr[n].b)
    if a =? 0 or nodes.ptr[a].kind not=? 'ident' or nodes.ptr[a].aux not=? int32<overflow='wrap'>(1) {return false}
    let p:EffectScanWord=EffectScanWord(nodes.ptr[a].sym)
    if EffectScanWord(locals.ptr[p].flags) & LF_PARAM =? 0 or EffectScanWord(locals.ptr[p].flags) & (LF_MUTPARAM | LF_ADDR | LF_CAPTURE | LF_CAPTURED) not=? 0 {return false}
    if locals.ptr[p].owner not=? locals.ptr[l].owner or locals.ptr[p].name not=? locals.ptr[l].name or not type_eq(EffectScanWord(locals.ptr[p].type) EffectScanWord(locals.ptr[l].type)) {return false}
    if copies_on and copy_bindings.has(l) {return false}
    if EffectScanWord(locals.ptr[l].flags) & (LF_ASSIGNED | LF_ADDR | LF_CAPTURE | LF_CAPTURED | LF_BYREF | LF_ALIAS | LF_EXPOSED | LF_SHARED) not=? 0 {return false}
    let t=representation_type(EffectScanWord(locals.ptr[l].type))
    if tkind(t) =? 'array' and effect_scalar(telem(t)) {return true}
    return is_fn_type(t) and effect_bare(a)
}
effect_indirect=(f:EffectScanWord n:EffectScanWord):>void=>$unsafe {
    let callee:EffectScanWord=EffectScanWord(nodes.ptr[n].a)
    let contract=callable_contract(ntype(callee))
    if contract =? 0 and (effects_active or effect_policy.prohibitions not=? 0) {contract=effect_source_row(callee)}
    effect_scan_node(f callee);
    let ft=callable_base(ntype(callee))
    loop i in [0..nkids(n)) {
        let a=kid(n i)
        if EffectScanWord(types.ptr[ft].mutmask) & (1 << i) =? 0 {effect_scan_node(f a);}
        else if not effect_place_inventory(a) {effect_opaque(f a);}
    }
    if contract =? 0 {
        effect_opaque(f n);
        return
    }
    let row=effect_contracts.ptr[contract]
    if row.variables.length not=? 0 {effect_opaque(f n);}
    if row.open {
        # Preserve proven nonlocal exclusions instead of turning an open bound
        # into an unconstrained opaque call. Formal exclusions need remapping.
        let exclusions:array<EffectAtom>=[]
        loop ex in row.exclusions {
            if place_base(ex.place).root not=? 'formal' {exclusions.push(ex);}
        }
        let remainder=effect_intern([] exclusions [] true)
        effect_add(f EffectEvent[EffectAtom['remainder' row = remainder] n]);
    }
    loop atom0 in row.atoms {
        let atom=atom0
        let base=place_base(atom.place)
        if base.root =? 'formal' {
            let i:EffectScanWord=EffectScanWord(base.declaration) - 1
            if i <? 0 or i >=? nkids(n) {atom=EffectAtom['opaque']}
            else {
                let actual=effect_export(f place_route(kid(n i)))
                atom.place = place_append(actual atom.place);
                if atom.place.declaration =? 0 {atom=EffectAtom['opaque']}
                else if atom.place.root =? 'local' {continue}
            }
        }
        effect_add(f EffectEvent[atom n]);
    }
}
# A call of the frame compiler/oom.jo wraps an allocating function's body in
# under `$explicit_allocation_failure` (`__setjmp(__oom_frame())` included).
effect_oom_frame=(n:EffectScanWord):>bool=>$unsafe {
    let k=nodes.ptr[n].kind
    if k =? 'intrinsic' and nodes.ptr[n].aux =? int32<overflow='wrap'>(39) and nkids(n) =? 1 {return effect_oom_frame(kid(n 0))}
    if k not=? 'call' or nodes.ptr[n].aux not=? 0 or nodes.ptr[n].sym <=? 0 or nkids(n) not=? 0 {return false}
    let g:EffectScanWord=EffectScanWord(nodes.ptr[n].sym)
    if g >=? fns.length or fns.ptr[g].decl =? 0 or not fn_in_lib(g) {return false}
    let name=effect_name(g)
    return name in? ["__oom_frame" "__oom_caught" "__oom_release" "__oom_unsupported"]
}
effect_scan_node=(f:EffectScanWord n:EffectScanWord):>void=>$unsafe {
    if n =? 0 or effect_footprints_only and effect_summaries.ptr[f].footprint_opaque {return}
    if effect_seen.ptr[n] =? f {return}
    effect_seen.ptr[n] = f;
    let k=nodes.ptr[n].kind
    let exact_rep=effect_exact_rep
    if exact_rep and (k =? 'vardecl' or k =? 'assign' or k =? 'binary' or k =? 'conv') {exact_effect_representation(n);}
    if k =? 'for_' {
        let marks=effect_for_marks.get(EffectScanWord(nodes.ptr[n].sym)) ?? []
        if not marks.contains(n) {
            marks.push(n);
            effect_for_marks[EffectScanWord(nodes.ptr[n].sym)] = marks;
    # These shortened place walks omit evaluated-root visits. Keep the legacy
    # adapter conservative rather than accidentally proving a global/alias pure.
        }
    }
    if k =? 'field' or k =? 'assign' {effect_isolation_block(f IsolationReason.node n);}
    let hidden:array<int64>=[]
    let reason=isolation_effect(n @hidden)
    if reason not=? IsolationReason.none_ {effect_isolation_block(f reason n);}
    if k =? 'ident' {
        if nodes.ptr[n].aux =? int32<overflow='wrap'>(2) {effect_isolation_block(f IsolationReason.global_ n);}
        else if nodes.ptr[n].aux not=? int32<overflow='wrap'>(1) {effect_isolation_block(f IsolationReason.node n);}
        else if EffectScanWord(locals.ptr[EffectScanWord(nodes.ptr[n].sym)].flags) & (LF_CAPTURE | LF_ADDR) not=? 0 {effect_isolation_block(f IsolationReason.capture n);}
    }
    if ownership_decls.length not=? 0 {
        let source:EffectScanWord=0
        if k =? 'vardecl' or k =? 'assign' {source=EffectScanWord(nodes.ptr[n].b)}
        else if k =? 'return_' or k =? 'conv' and nodes.ptr[n].aux =? int32<overflow='wrap'>(13) {source=EffectScanWord(nodes.ptr[n].a)}
        if source not=? 0 {effect_owner_init(f source n);}
    # (`$assert` is erased: proven at compile time, its operands never run)

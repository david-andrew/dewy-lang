use 'checker_type_entries.dewy'
use 'checker_module_lookup.dewy'
use 'diagnostic_exit.dewy'
use 'checks_thin.dewy'
use 'util.jo'
use 'ast.jo'
use 'check.jo'

runtime_fn = (name: str) -> int:
    if let f = runtime_insts.get(name): return f
    demand_name(intern(name))
    s = prelude.get(intern(name)) ?? 0
    if s == 0 or syms[s].kind != .fns: ice("missing runtime function {name}")
    f = get_fn_inst(int(syms[s].decl), [], nodes[int(syms[s].decl)].pos)
    runtime_insts[name] = f
    if starts_with(name, "__mi_") or starts_with(name, "__exact_"): check_pending_functions(f)
    f

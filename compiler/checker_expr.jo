struct CheckerExprInput:
    nodes: *(Node[])
    types: *(TypeInfo[])
    files: *(SrcFile[])
    syms: *(Sym[])
    scopes: *CheckerScope
    contexts: *(FnCtx[])
    context: *int
    ml_at: *(int[])
    ml_mod: *(int[])
    ml_sym: *(int[])
    ml_tick: *(int[])
    ml_struct: *int
    sentinel: *int
    temperature: *bool
    values: *bool
    watch: *StatementWatch
    last: *int
    bool_type: *int
    int_type: *int
    u64_type: *int
    math_int: *int
    quantity_right: *int
xe_nodes: *(Node[])
xe_types: *(TypeInfo[])
xe_files: *(SrcFile[])
xe_syms: *(Sym[])
xe_scopes: *CheckerScope
xe_contexts: *(FnCtx[])
xe_context: *int
xe_ml_at: *(int[])
xe_ml_mod: *(int[])
xe_ml_sym: *(int[])
xe_ml_tick: *(int[])
xe_ml_struct: *int
xe_sentinel: *int
xe_temperature: *bool
xe_values: *bool
xe_watch: *StatementWatch
xe_last: *int
xe_bool_type: *int
xe_int_type: *int
xe_u64_type: *int
xe_math_int: *int
xe_quantity_right: *int
checker_expr_bind = (input: *CheckerExprInput) -> int:
    xe_nodes = input[0].nodes
    xe_types = input[0].types
    xe_files = input[0].files
    xe_syms = input[0].syms
    xe_scopes = input[0].scopes
    xe_contexts = input[0].contexts
    xe_context = input[0].context
    xe_ml_at = input[0].ml_at
    xe_ml_mod = input[0].ml_mod
    xe_ml_sym = input[0].ml_sym
    xe_ml_tick = input[0].ml_tick
    xe_ml_struct = input[0].ml_struct
    xe_sentinel = input[0].sentinel
    xe_temperature = input[0].temperature
    xe_values = input[0].values
    xe_watch = input[0].watch
    xe_last = input[0].last
    xe_bool_type = input[0].bool_type
    xe_int_type = input[0].int_type
    xe_u64_type = input[0].u64_type
    xe_math_int = input[0].math_int
    xe_quantity_right = input[0].quantity_right
    0
xe_module = (name: int) -> int:
    c = xe_context[0]
    m = -1
    if c >= 0: m = int(xe_contexts[0][c].mod)
    if name < xe_ml_at[0].len():
        stamp = xe_ml_struct[0]
        if name < xe_ml_tick[0].len() and xe_ml_tick[0][name] > xe_ml_struct[0]: stamp = xe_ml_tick[0][name]
        if xe_ml_at[0][name] == stamp and xe_ml_mod[0][name] == m: return xe_ml_sym[0][name]
    expr_module(m, name)
lookup = (name: int) -> int:
    c = xe_context[0]
    floor = 0
    if c >= 0: floor = int(xe_contexts[0][c].floor)
    if name < xe_scopes[0].top.len():
        i = xe_scopes[0].top[name]
        if i >= floor: return xe_scopes[0].syms[i]
    xe_module(name)
finish_arg = (a: int, pt: int, is_mut: bool):
    if is_mut:
        xe_arg(a, pt, true)
        return
    if xe_nodes[0][a].kind == .hole:
        xe_nodes[0][a].type = i32(pt)
        return
    if int(xe_nodes[0][a].flags) & 128 == 0 or xe_nodes[0][a].type == 0:
        check_expr(a, pt)
        xe_nodes[0][a].flags |= 128
    if int(xe_nodes[0][a].flags) & 1 != 0 or not cq_settled(xe_nodes, xe_types, a, pt): xe_arg(a, pt, false)
xe_arg = (a: int, pt: int, is_mut: bool): arg_finish_rest(a, pt, is_mut)
struct CheckerCallHost:
    members: (int) -> void
    spread: (int) -> void
struct CheckerCallInput:
    lists: *(i32[])
    locals: *(Local[])
    members_name: *int
    set_name: *int
    host: *CheckerCallHost
    names: *(str[])
    values_hit: *(bool[])
    spread_call: *(bool[])
    functions: *(FnInst[])
xe_lists: *(i32[])
xe_locals: *(Local[])
xe_members_name: *int
xe_set_name: *int
xe_call_host: *CheckerCallHost
xe_names: *(str[])
xe_values_hit: *(bool[])
xe_spread_call: *(bool[])
xe_functions: *(FnInst[])
checker_call_bind = (input: *CheckerCallInput) -> int:
    xe_lists = input[0].lists
    xe_locals = input[0].locals
    xe_members_name = input[0].members_name
    xe_set_name = input[0].set_name
    xe_call_host = input[0].host
    xe_names = input[0].names
    xe_values_hit = input[0].values_hit
    xe_spread_call = input[0].spread_call
    xe_functions = input[0].functions
    0
xe_marked = (marks: *(bool[]), a: int) -> bool: a < marks[0].len() and marks[0][a]
xe_one_value = (a: int) -> bool:
    if int(xe_nodes[0][a].flags) & 1 != 0: return true
    s = lookup(int(xe_nodes[0][a].name))
    if s == 0: return true
    sk = xe_syms[0][s].kind
    if sk == .local:
        held = int(xe_locals[0][int(xe_syms[0][s].ref)].type)
        if held == 0: return true
        k = xe_kind_of(held)
        return k == .bool_ or k == .int_ or k == .float_ or k == .str_ or k == .array or k == .enum_ or k == .fixed or k == .range or k == .vec or k == .quantity or k == .ptr
    sk != .global and sk != .fns
values_settled = (n: int) -> bool:
    callee = int(xe_nodes[0][n].a)
    if xe_nodes[0][callee].kind == .ident:
        text = xe_names[0][int(xe_nodes[0][callee].name)]
        if starts_with(text, "__") or starts_with(text, "$") and text != "$": return true
    count = int(xe_nodes[0][n].nlist)
    base = int(xe_nodes[0][n].list)
    loop i in [0..count):
        original = int(xe_lists[0][base + i])
        named = xe_nodes[0][original].kind == .namedarg
        a = original
        if named: a = int(xe_nodes[0][original].a)
        k = xe_nodes[0][a].kind
        flags = int(xe_nodes[0][a].flags)
        if k == .call:
            m = xe_members_name[0]
            if m == 0 or int(xe_nodes[0][int(xe_nodes[0][a].a)].name) == m: return false
        if not named:
            if k == .tuple and xe_nodes[0][a].aux == 7: return false
            if flags & 1024 != 0 or xe_marked(xe_values_hit, a): return false
        if flags & 128 == 0:
            if k == .ident:
                if not named and not xe_one_value(a): return false
            else if k == .call:
                if not ctx_dependent(a) and not xe_marked(xe_spread_call, a): return false
    true
check_args_untyped = (args: int[]):
    loop a in args: xe_untyped(a)
xe_untyped_kids = (n: int):
    base = int(xe_nodes[0][n].list)
    count = int(xe_nodes[0][n].nlist)
    loop i in [0..count): xe_untyped(int(xe_lists[0][base + i]))
xe_untyped_pairs = (n: int):
    base = int(xe_nodes[0][n].list)
    count = int(xe_nodes[0][n].nlist)
    loop i in [0..count):
        pair = int(xe_lists[0][base + i])
        xe_untyped(int(xe_nodes[0][pair].a))
        xe_untyped(int(xe_nodes[0][pair].b))
xe_set_call = (a: int) -> bool:
    if xe_nodes[0][a].type != 0 or xe_nodes[0][a].nlist != 1: return false
    callee = int(xe_nodes[0][a].a)
    xe_nodes[0][callee].kind == .ident and int(xe_nodes[0][callee].name) == xe_set_name[0]
xe_spread = (a: int):
    if xe_nodes[0][a].b != 0 or xe_nodes[0][a].nlist == 0: return
    first = int(xe_lists[0][int(xe_nodes[0][a].list)])
    if int(xe_nodes[0][first].flags) & 1024 == 0: return
    xe_call_host[0].spread(a)
xe_fn_kind = (t: int) -> bool:
    k = xe_kind_of(t)
    k == .fn_ or k == .cfn or k == .polyfn or k == .callable
xe_untyped = (a0: int):
    a = a0
    if xe_nodes[0][a].kind == .namedarg: a = int(xe_nodes[0][a].a)
    if xe_nodes[0][a].kind == .call:
        m = xe_members_name[0]
        if m == 0 or int(xe_nodes[0][int(xe_nodes[0][a].a)].name) == m: xe_call_host[0].members(a)
        if xe_nodes[0][a].kind == .call and xe_set_call(a):
            xe_untyped_kids(a)
            return
    if xe_nodes[0][a].kind == .array: xe_spread(a)
    k = xe_nodes[0][a].kind
    if k == .record_lit:
        xe_untyped_kids(a)
        return
    if k == .map_lit and ctx_dependent(a):
        xe_untyped_pairs(a)
        return
    if k == .array and xe_files[0][int(xe_nodes[0][a].pos) >> 40].is_dewy and ctx_dependent(a):
        xe_untyped_kids(a)
        return
    base = a
    if k == .typeapply: base = int(xe_nodes[0][a].a)
    if not xe_flag(a, 128):
        bk = xe_nodes[0][base].kind
        if bk == .ident: xe_fnref(a, base)
        if bk == .field and xe_nodes[0][int(xe_nodes[0][base].a)].kind == .ident: xe_module_fn(a, base)
    if ctx_dependent(a) or xe_flag(a, 128): return
    check_expr(a, 0)
    xe_add_flag(a, 128)
xe_fnref = (a: int, base: int):
    s = lookup(int(xe_nodes[0][base].name))
    if s == 0: return
    sk = xe_syms[0][s].kind
    if sk == .fns: xe_add_flag(a, 4096)
    if sk == .local and a == base and not xe_flag(a, 1) and xe_files[0][int(xe_nodes[0][a].pos) >> 40].is_dewy and xe_fn_kind(int(xe_locals[0][int(xe_syms[0][s].ref)].type)): xe_add_flag(a, 4096)
xe_module_fn = (a: int, base: int):
    ms = lookup(int(xe_nodes[0][int(xe_nodes[0][base].a)].name))
    if ms == 0 or xe_syms[0][ms].kind != .module: return
    fs = expr_module(int(xe_syms[0][ms].ref), int(xe_nodes[0][base].name))
    if fs != 0 and xe_syms[0][fs].kind == .fns: xe_add_flag(a, 4096)
xe_kind = (k: SK) -> int: int(k)
xe_complete = (): expr_complete()
xe_unknown = (n: int, expected: int, name: int): ident_unknown(n, expected, name)
xe_read = (n: int, t: int) -> int:
    it = t
    if xe_temperature[0]: it = temperature_read(n, it)
    if xe_values[0]: expr_values_use(n, it)
    it
xe_ident = (n: int, expected: int) -> int:
    nm = int(xe_nodes[0][n].name)
    if xe_sentinel[0] != 0 and nm == xe_sentinel[0]: xe_complete()
    c = xe_context[0]
    floor = 0
    if c >= 0: floor = int(xe_contexts[0][c].floor)
    i = -1
    if nm < xe_scopes[0].top.len(): i = xe_scopes[0].top[nm]
    s = 0
    if i >= floor: s = xe_scopes[0].syms[i]
    else: s = xe_module(nm)
    if s == 0: xe_unknown(n, expected, nm)
    flags = 0
    if xe_watch[0].const_views > 0: flags = 1
    if xe_watch[0].decimal_globals > 0: flags = flags | 2
    t = xj_ident(n, expected, xe_kind(xe_syms[0][s].kind), int(xe_syms[0][s].ref), s, flags).type
    if xe_temperature[0] or xe_values[0]: return xe_read(n, t)
    t
xe_other = (n: int, expected: int) -> int:
    k = xe_nodes[0][n].kind
    if k == .float_lit or k == .bool_lit or k == .none_lit or k == .null_lit: return xl_check_scalar(n, expected)
    ex = xl_expected(expected)
    if k == .array or (ex != 0 and (k == .map_lit or k == .record_lit or k == .tuple)): ex = expr_literal(n, expected, ex)
    t = 0
    if k == .dotname: t = xv_check(n, ex)
    else if k == .typeapply:
        r = xa_check(n, expected, ex)
        if r.bypass: return r.type
        t = r.type
    else if k == .unary:
        r = xu_check(n, expected, ex)
        if r.bypass: return r.type
        t = r.type
    else if k == .and_ or k == .or_ or k == .not_:
        r = xg_check(n, expected, ex)
        if r.bypass: return r.type
        t = r.type
    else if k == .istype: t = xi_check(n)
    else if k == .coalesce or k == .unwrap:
        r = xo_check(n, expected, ex)
        if r.bypass: return r.type
        t = r.type
    else if k == .array or k == .record_lit:
        r = xr_check(n, expected, ex)
        if r.bypass: return r.type
        t = r.type
    else if k == .map_lit or k == .tuple:
        r = xk_check(n, expected, ex)
        if r.bypass: return r.type
        t = r.type
    else if k == .iflet: t = xf_iflet(n, ex)
    else if k == .cast:
        r = xc_check(n, expected)
        if r.bypass: return r.type
        t = r.type
    else if k == .addr or k == .conv or k == .fnref or k == .parallel_region or k == .hole or k == .namedarg: t = xp_check(n, expected)
    else: return expr_other(n, expected)
    xl_finish(n, t, expected)
xe_kind_of = (t: int) -> TK: xe_types[0][int(tu_prune(t))].kind
xe_flag = (n: int, f: int) -> bool: int(xe_nodes[0][n].flags) & f != 0
xe_add_flag = (n: int, f: int): xe_nodes[0][n].flags = i32(int(xe_nodes[0][n].flags) | f)
xe_dewy_at = (pos: int) -> bool:
    f = pos >> 40
    pos > 0 and f < xe_files[0].len() and xe_files[0][f].is_dewy
xe_charlike = (n: int) -> bool: xe_nodes[0][n].kind == .str_lit and xe_flag(n, 512)
xe_quantity_literal = (e: int) -> bool:
    if e == 0 or xe_flag(e, 128): return false
    if xe_nodes[0][e].kind == .unary: return xe_quantity_literal(int(xe_nodes[0][e].a))
    if xe_nodes[0][e].kind == .binary and xe_nodes[0][e].op == 60:
        x = xe_nodes[0][int(xe_nodes[0][e].a)].kind
        return (x == .int_lit or x == .float_lit) and xe_nodes[0][int(xe_nodes[0][e].b)].kind == .ident
    false
xe_quantity_name = (e: int) -> bool:
    if e == 0 or xe_flag(e, 128): return false
    k = xe_nodes[0][e].kind
    k == .ident or (k == .field and xe_nodes[0][int(xe_nodes[0][e].a)].kind == .ident)
xe_literal_operand = (e: int) -> bool:
    k = xe_nodes[0][e].kind
    if k == .array or k == .record_lit or k == .map_lit: return true
    k == .call and xe_nodes[0][e].type == 0 and xe_nodes[0][e].nlist == 1 and xe_nodes[0][int(xe_nodes[0][e].a)].kind == .ident and dewy_set_literal(e)
xe_xor = (n: int, expected: int) -> int:
    ta = int(tu_prune(check_expr(int(xe_nodes[0][n].a), 0)))
    xe_nodes[0][n].a = i32(xe_last[0])
    xe_add_flag(int(xe_nodes[0][n].a), 128)
    xe_nodes[0][n].op = 65
    if ta == xe_bool_type[0]: xe_nodes[0][n].op = 70
    check_expr(n, expected)
xe_char = (n: int):
    if not xe_charlike(int(xe_nodes[0][n].a)) or xe_charlike(int(xe_nodes[0][n].b)): return
    tb = check_expr(int(xe_nodes[0][n].b), 0)
    xe_nodes[0][n].b = i32(xe_last[0])
    xe_add_flag(int(xe_nodes[0][n].b), 128)
    if xe_kind_of(tb) == .int_: binary_char_code(int(xe_nodes[0][n].a))
xe_in = (n: int, expected: int) -> int:
    b = int(xe_nodes[0][n].b)
    if xe_nodes[0][b].kind == .range and not xe_flag(b, 32768): return int(xy_check(n, expected))
    binary_membership(n, expected)
xe_decimals = (a: int, b: int):
    binary_decimal(a)
    binary_decimal(b)
xe_literal_hint = (e: int, t: int, op: int, hint: int) -> int:
    if not binary_context(e, t, op): return hint
    p = int(tu_prune(t))
    if xe_types[0][p].kind == .opt: return int(xe_types[0][p].elem)
    p
xe_first = (b: int) -> int:
    t = int(tu_prune(check_expr(b, 0)))
    xe_add_flag(b, 128)
    t
xe_binary = (n: int, expected: int) -> int:
    op = int(xe_nodes[0][n].op)
    if op == 85: return check_dotted(n, expected)
    if op == 60 and xe_flag(n, 536870912): binary_juxt(n)
    if op == 82: return xe_xor(n, expected)
    if op != 58 and op != 60 and xe_nodes[0][int(xe_nodes[0][n].a)].kind == .str_lit: xe_char(n)
    if op == 12: return xe_in(n, expected)
    is_cmp = op >= 69 and op <= 74
    is_shift = op == 67 or op == 68
    hint = 0
    if not is_cmp and expected != 0:
        ek = xe_kind_of(expected)
        if ek == .int_ or ek == .float_ or ek == .vec: hint = expected
        else if ek == .quantity: hint = binary_quantity_hint(expected)
    a = int(xe_nodes[0][n].a)
    b = int(xe_nodes[0][n].b)
    if (op == 69 or op == 70) and xe_watch[0].decimal_adapted > 0: xe_decimals(a, b)
    flags = 0
    if op == 58 or op == 59:
        if xe_quantity_literal(a): flags = 1
        if xe_quantity_literal(b) or (b == xe_quantity_right[0] and b != 0): flags = flags | 2
    else if op == 60:
        if xe_quantity_name(a): flags = 1
        if xe_quantity_name(b): flags = flags | 2
        ca = xe_charlike(a)
        cb = xe_charlike(b)
        if ca and not cb: xe_nodes[0][a].flags = i32(int(xe_nodes[0][a].flags) & ~512)
        if cb and not ca: xe_nodes[0][b].flags = i32(int(xe_nodes[0][b].flags) & ~512)
    if op == 58:
        ca = xe_charlike(a)
        cb = xe_charlike(b)
        if ca: flags = flags | 4
        if cb: flags = flags | 8
        if ca and not cb and hint == 0 and xe_flag(a, 8):
            tb0 = xe_first(b)
            if xe_types[0][tb0].kind == .int_: hint = tb0
    literal_op = (op == 69 or op == 70 or op == 63 or op == 64 or op == 65 or op == 59) and xe_files[0][xe_nodes[0][n].pos >> 40].is_dewy
    a_literal = literal_op and xe_literal_operand(a)
    b_literal = literal_op and xe_literal_operand(b)
    if a_literal and not b_literal: hint = xe_literal_hint(a, xe_first(b), op, hint)
    ta = int(tu_prune(check_expr(a, hint)))
    tb = 0
    bk = xe_nodes[0][b].kind
    if bk == .none_lit or bk == .null_lit or bk == .dotname: tb = int(tu_prune(check_expr(b, ta)))
    else:
        h = 0
        tk = xe_types[0][ta].kind
        if not xe_flag(a, 256) and not is_shift and (tk == .int_ or tk == .float_):
            h = ta
            if is_cmp and (bk == .int_lit or bk == .unary) and exact_potential(a):
                h = xe_int_type[0]
                if xe_flag(b, 2097152): h = xe_u64_type[0]
        if not a_literal and b_literal: h = xe_literal_hint(b, ta, op, h)
        if bk == .array and tk == .struct_ and (op == 69 or op == 70 or op == 60): h = binary_nd_hint(n, ta, h)
        tb = int(tu_prune(check_expr(b, h)))
    if xe_types[0][ta].kind == .secret or xe_types[0][tb].kind == .secret: return binary_secret(n, a, b)
    mi = xe_math_int[0]
    if (int(xe_nodes[0][a].type) == mi or int(xe_nodes[0][b].type) == mi) and xe_dewy_at(xe_nodes[0][n].pos):
        wa = exact_math_operand(a)
        wb = exact_math_operand(b)
        ua = int(xe_nodes[0][wa].type)
        ub = int(xe_nodes[0][wb].type)
        if ua != mi and ub != mi and xe_word(ua) and xe_word(ub):
            a = wa
            b = wb
            xe_nodes[0][n].a = i32(a)
            xe_nodes[0][n].b = i32(b)
            ta = int(tu_prune(ua))
            tb = int(tu_prune(ub))
    if not is_shift and ta != mi and tb != mi:
        fka = xe_types[0][ta].kind
        fkb = xe_types[0][tb].kind
        if (fka == .int_ or fka == .float_) and (fkb == .int_ or fkb == .float_) and not (op == 69 and fka == .float_):
            ak = xe_nodes[0][a].kind
            bk2 = xe_nodes[0][b].kind
            if ak != .float_lit and bk2 != .float_lit and ak != .str_lit and bk2 != .str_lit: return int(xw_numeric(n, i32(op), a, b, ta, tb, is_cmp))
    binary_rest(n, expected, a, b, ta, tb, hint, flags)
xe_word = (t0: int) -> bool:
    t = int(tu_prune(t0))
    xe_types[0][t].kind == .int_ and (t == xe_math_int[0] or xe_types[0][t].st == 0)
check_call_expr = (n: int, expected: int) -> int:
    ex = 0
    if expected != 0: ex = xl_expected(expected)
    if xe_nodes[0][n].aux2 == -1:
        r = call_int_literal(n, ex)
        if r >= 0: return r
    if xe_flag(n, 16384): return check_dotted(n, expected)
    callee = int(xe_nodes[0][n].a)
    if ex != 0 and xe_nodes[0][callee].kind == .ident:
        count = int(xe_nodes[0][n].nlist)
        if count == 2 and (xe_types[0][ex].kind == .array or is_nd(ex)) and xe_names[0][int(xe_nodes[0][callee].name)] == "__shape_value":
            check_expr(xe_kid(n, 0), ex)
            xe_set_kid(n, 0, xe_last[0])
        if count == 1 and xe_names[0][int(xe_nodes[0][callee].name)] == "__map_of": call_map_rows(n, ex)
    if is_unchecked_at(n):
        xs = xe_kid(n, 0)
        i = xe_kid(n, 1)
        xe_nodes[0][n].kind = .index
        xe_nodes[0][n].a = i32(xs)
        xe_nodes[0][n].b = i32(i)
        xe_add_flag(n, 524288)
        return check_expr(n, expected)
    if xe_nodes[0][n].aux2 == -10:
        if xe_flag(n, 536870912) and juxt_head_numeric(n): juxt_factor(n)
        return dewy_partial(n, expected)
    if xe_nodes[0][n].nlist > 0 and xe_nodes[0][n].aux2 == 0 and xe_dewy_at(xe_nodes[0][n].pos) and not xe_numeric_head(n):
        if not values_settled(n):
            vt = values_call(n, expected)
            if vt >= 0: return xl_finish(n, vt, expected)
    t = check_call(n, expected)
    if xe_nodes[0][n].kind != .call: return xl_finish(n, t, expected)
    if xe_nodes[0][n].aux == 2 and xe_nodes[0][n].nlist > 1 and not xe_dewy_at(xe_nodes[0][n].pos): dewy_data_after_give(n)
    if xe_called(n) > 0:
        if xe_functions[0][xe_called(n)].atomic_api: concurrency_atomic_call(n)
        if xe_functions[0][xe_called(n)].task_api:
            concurrency_tasks.push(n)
            concurrency_runtime_needed = true
    if xe_nodes[0][n].nlist == 2 and xe_called(n) > 0 and xe_functions[0][xe_called(n)].parallel_api:
        concurrency_calls.push(n)
        parallel_prepare(n)
    if xe_called(n) > 0 and xe_nodes[0][n].nlist >= 1 and xe_dewy_at(xe_nodes[0][n].pos): map_float_key(n)
    if xe_called(n) > 0 and xe_functions[0][xe_called(n)].pack != 0: sink_pack_call(n)
    else if xe_nodes[0][n].aux == 1 and xe_fn_pack(callable_base(int(tu_prune(int(xe_nodes[0][int(xe_nodes[0][n].a)].type))))): sink_pack_call(n)
    xl_finish(n, t, expected)
check_call = (n: int, expected: int) -> int:
    head = call_head(n, expected)
    if head >= 0: return head
    callee = int(xe_nodes[0][n].a)
    ck = xe_nodes[0][callee].kind
    if ck == .typeapply: return call_typeapply(n, expected)
    if ck == .ident:
        special = call_ident_special(n, expected)
        if special >= 0: return special
        name = int(xe_nodes[0][callee].name)
        args = node_kids(mut xe_nodes[0], mut xe_lists[0], n)
        if not pos_in_lib(xe_nodes[0][n].pos): habit_call_check(n, name, args)
        return call_by_name(n, name, path_literal_module(n, callee, args), args, expected, false)
    if ck == .dotname: return call_dotname(n, expected)
    if ck == .field: return call_member(n, expected)
    if ck == .index:
        indexed = call_index(n, expected)
        if indexed >= 0: return indexed
    call_value(n, expected)
# Receiver checking and member dispatch; diagnostics and unusual receiver forms
# remain services. Re-read the checked receiver because checking may replace it.
call_member = (n: int, expected: int) -> int:
    callee = int(xe_nodes[0][n].a)
    args = node_kids(mut xe_nodes[0], mut xe_lists[0], n)
    if xe_flag(callee, 536870912): juxt_member_check(callee)
    if xe_flag(n, 536870912) and juxt_head_numeric(n):
        juxt_product(n)
        return check_expr(n, expected)
    recv = int(xe_nodes[0][callee].a)
    saved_receiver = type_receiver_at
    type_receiver_at = recv
    rt = tu_prune(check_expr(recv, receiver_literal_hint(recv, int(xe_nodes[0][callee].name), args.len(), expected, xe_nodes[0][n].pos)))
    type_receiver_at = saved_receiver
    recv = xe_last[0]
    xe_nodes[0][callee].a = i32(recv)
    fname = int(xe_nodes[0][callee].name)
    prepared = call_member_prepare(n, callee, recv, mut rt, args, expected)
    if prepared >= 0: return prepared
    rk = xe_types[0][rt].kind
    if rk == .module: return call_by_name(n, fname, int(xe_types[0][rt].mod), args, expected, false)
    if rk == .typeval: return call_member_type(n, callee, rt, fname, args, expected)
    if is_soa(rt): return check_soa_method(n, recv, fname, args, expected)
    if fname == id_dewy_len: dewy_len_check(callee, true, rt, recv)
    if rk == .struct_ or rk == .ptr:
        field = call_member_callable(n, callee, recv, rt, fname, args, expected)
        if field >= 0: return field
    tail = call_member_tail(n, callee, recv, rt, mut fname, mut args, expected)
    if tail >= 0: return tail
    xe_add_flag(recv, 128)
    nl = [recv]
    loop a in args: nl.push(a)
    node_set_list(mut xe_nodes[0], mut xe_lists[0], n, nl)
    call_by_name(n, fname, -1, nl, expected, true)

call_by_name = (n: int, name: int, mod_scope: int, args: int[], expected: int, ufcs: bool) -> int:
    early = call_name_early(n, name, mod_scope, args, expected, ufcs)
    if early >= 0: return early
    ii0 = if intrinsic_of(name) < 0: -1 else: call_name_intrinsic(n, intrinsic_of(name))
    hidden = ii0 == -2
    ii = if hidden: -1 else: ii0
    if ii >= 0 and args.len() > 0:
        arr = call_name_array(n, name, mod_scope, args, expected, ufcs, ii)
        if arr >= 0: return arr
    decls: int[]
    if not ufcs:
        s = if mod_scope >= 0: module_lookup(mod_scope, name) else: lookup(name)
        if s != 0 and (xe_syms[0][s].kind != .fns or xe_fns_special(name, args.len())):
            named = call_name_sym(n, name, mod_scope, s, args, expected, hidden, mut decls)
            if named >= 0: return named
    collected = call_name_collect(n, name, mod_scope, args, expected, ufcs, mut decls)
    if collected >= 0: return collected
    if decls.len() == 0: return call_name_unknown(n, name, mod_scope, args, expected, ufcs, ii, hidden)
    resolve_fn_call(n, name, decls, args, expected, 0, ufcs)
xe_fns_special = (name: int, count: int) -> bool: count == 1 or (count == 2 and (name == take_name or name == release_name)) or (count == 3 and name == relocate_name)
xe_kid = (n: int, i: int) -> int: int(xe_lists[0][int(xe_nodes[0][n].list) + i])
xe_set_kid = (n: int, i: int, v: int): xe_lists[0][int(xe_nodes[0][n].list) + i] = i32(v)
xe_called = (n: int) -> int: if xe_nodes[0][n].aux == 0 and xe_nodes[0][n].sym > 0: int(xe_nodes[0][n].sym) else: 0
xe_numeric_head = (n: int) -> bool:
    if not xe_flag(n, 536870912): return false
    k = xe_nodes[0][int(xe_nodes[0][n].a)].kind
    (k == .ident or k == .field) and juxt_head_numeric(n)
xe_fn_pack = (t: int) -> bool: xe_types[0][t].kind == .fn_ and xe_types[0][t].sign
check_expr = (n: int, expected: int) -> int:
    xe_last[0] = n
    if xe_nodes[0][n].type != 0 and int(xe_nodes[0][n].flags) & 128 != 0: return int(xe_nodes[0][n].type)
    k = xe_nodes[0][n].kind
    if k == .ident: return xe_ident(n, expected)
    if k == .int_lit: return xl_check_int(n, expected)
    if k == .binary: return xl_finish(n, xe_binary(n, expected), expected)
    if k == .call: return check_call_expr(n, expected)
    if k == .field: return xs_field(n, expected)
    if k == .if_: return xl_finish(n, xf_if(n, xl_expected(expected)), expected)
    if k == .index:
        it = xs_index(n, expected)
        if xe_watch[0].sibling_known != 0: return expr_sibling(n, it)
        return it
    if k == .str_lit: return xl_check_str(n, expected)
    xe_other(n, expected)
struct CheckerIntrinsicHost:
    rest: (int, int, int[], int) -> int
    nargs: (int, int, int, int, str) -> void
    error: (int, int, int) -> void
    coerce: (int, int) -> int
    length: (int, int, int, int) -> int
    resize: (int, str, int) -> void
    place: (int, bool) -> void
    length_mutation: (int, int) -> int
struct CheckerIntrinsicInput:
    nodes: *(Node[])
    lists: *(i32[])
    types: *(TypeInfo[])
    structs: *(StructInfo[])
    files: *(SrcFile[])
    value_loops: *(ValueLoop[])
    refine: *(bool)
    void_type: *(int)
    int_type: *(int)
    str_type: *(int)
    u8_type: *(int)
    rawptr_type: *(int)
    never_type: *(int)
    host: *(CheckerIntrinsicHost)
xn_nodes: *(Node[])
xn_lists: *(i32[])
xn_types: *(TypeInfo[])
xn_structs: *(StructInfo[])
xn_files: *(SrcFile[])
xn_value_loops: *(ValueLoop[])
xn_refine: *(bool)
xn_void_type: *(int)
xn_int_type: *(int)
xn_str_type: *(int)
xn_u8_type: *(int)
xn_rawptr_type: *(int)
xn_never_type: *(int)
xn_host: *(CheckerIntrinsicHost)
checker_intrinsics_bind = (input: *CheckerIntrinsicInput) -> int:
    xn_nodes = input[0].nodes
    xn_lists = input[0].lists
    xn_types = input[0].types
    xn_structs = input[0].structs
    xn_files = input[0].files
    xn_value_loops = input[0].value_loops
    xn_refine = input[0].refine
    xn_void_type = input[0].void_type
    xn_int_type = input[0].int_type
    xn_str_type = input[0].str_type
    xn_u8_type = input[0].u8_type
    xn_rawptr_type = input[0].rawptr_type
    xn_never_type = input[0].never_type
    xn_host = input[0].host
    0
xn_kind = (t: int) -> TK: xn_types[0][t].kind
xn_arg = (args: int[], i: int, expected: int) -> int:
    a = args[i]
    if xn_nodes[0][a].kind == .namedarg: xn_host[0].error(a, 6, 0)
    if int(xn_nodes[0][a].flags) & 128 == 0 or xn_nodes[0][a].type == 0:
        check_expr(a, expected)
        xn_nodes[0][a].flags |= 128
    if expected != 0 and not cq_settled(xn_nodes, xn_types, a, expected): xn_host[0].coerce(a, expected)
    tu_prune(int(xn_nodes[0][a].type))
xn_resized = (n: int, a: int, operation: str):
    if xn_value_loops[0].len() > 0: xn_host[0].resize(a, operation, xn_nodes[0][n].pos)
    xn_host[0].place(a, false)
xn_syscall_arg = (args: int[], i: int):
    t = xn_arg(args, i, 0)
    a = args[i]
    if int(xn_nodes[0][a].flags) & 256 != 0:
        xn_host[0].coerce(a, xn_int_type[0])
        return
    k = xn_kind(t)
    if k == .null_: xn_nodes[0][a].type = i32(xn_rawptr_type[0])
    else if k == .int_:
        if t != xn_int_type[0]: xn_host[0].coerce(a, xn_int_type[0])
    else if k != .ptr and k != .bool_: xn_host[0].error(a, 9, 0)
check_intrinsic = (n: int, id: int, args: int[], expected: int) -> int:
    if id != 1 and id != 2 and id != 3 and id != 6 and id != 27 and id != 9 and id != 10 and id != 11 and id != 14 and id != 19: return xn_host[0].rest(n, id, args, expected)
    xn_nodes[0][n].kind = .intrinsic
    xn_nodes[0][n].aux = i32(id)
    node_set_list(mut xn_nodes[0], mut xn_lists[0], n, args)
    xn_nodes[0][n].a = 0
    nargs = args.len()
    r = xn_void_type[0]
    if id == 1 or id == 27:
        if nargs != 1: xn_host[0].nargs(n, nargs, 1, 1, "len")
        t = xn_arg(args, 0, 0)
        k = xn_kind(t)
        if k == .struct_ and xn_structs[0][int(xn_types[0][t].st)].soa_ or id == 1 and k == .str_ and xn_files[0][int(xn_nodes[0][n].pos) >> 40].is_dewy: return xn_host[0].length(n, args[0], t, expected)
        if k != .array and k != .str_ and not (id == 1 and k == .fixed): xn_host[0].error(n, 1, t)
        xn_nodes[0][n].type = i32(xn_int_type[0])
        return xn_int_type[0]
    if id == 2:
        if nargs > 2: xn_host[0].error(n, 2, 0)
        if nargs != 2: xn_host[0].nargs(n, nargs, 2, 2, "push")
        t = xn_arg(args, 0, 0)
        if xn_kind(t) != .array: xn_host[0].error(n, 3, t)
        xn_resized(n, args[0], "push")
        xn_arg(args, 1, int(xn_types[0][t].elem))
    else if id == 3:
        if nargs != 1: xn_host[0].nargs(n, nargs, 1, 1, "pop")
        t = xn_arg(args, 0, 0)
        if xn_kind(t) != .array: xn_host[0].error(n, 4, t)
        xn_resized(n, args[0], "pop")
        r = int(xn_types[0][t].elem)
    else if id == 6:
        if nargs != 1: xn_host[0].nargs(n, nargs, 1, 1, "clear")
        t = xn_arg(args, 0, 0)
        if xn_kind(t) != .array: xn_host[0].error(n, 5, t)
        xn_resized(n, args[0], "clear")
    else if id == 9:
        if nargs < 1 or nargs > 7: xn_host[0].error(n, 8, 0)
        loop i in [0..nargs): xn_syscall_arg(args, i)
        r = xn_int_type[0]
    else if id == 10 or id == 11:
        if nargs != 3:
            if id == 10: xn_host[0].nargs(n, nargs, 3, 3, "mem_copy")
            else: xn_host[0].nargs(n, nargs, 3, 3, "mem_set")
        if xn_kind(xn_arg(args, 0, 0)) != .ptr: xn_host[0].error(args[0], 7, 0)
        if id == 10:
            if xn_kind(xn_arg(args, 1, 0)) != .ptr: xn_host[0].error(args[1], 7, 0)
        else: xn_arg(args, 1, xn_int_type[0])
        xn_arg(args, 2, xn_int_type[0])
    else if id == 14:
        if nargs > 1: xn_host[0].nargs(n, nargs, 0, 1, "panic")
        if nargs > 0: xn_arg(args, 0, xn_str_type[0])
        r = xn_never_type[0]
    else:
        if nargs != 1: xn_host[0].nargs(n, nargs, 1, 1, "bytes")
        xn_arg(args, 0, xn_str_type[0])
        r = int(tb_mk_array(xn_u8_type[0]))
    xn_nodes[0][n].type = i32(r)
    if xn_refine[0]: return xn_host[0].length_mutation(n, r)
    r

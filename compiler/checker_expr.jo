# Frozen expression dispatcher extracted from expr.jo.
use 'node_store.dewy'
use 'checker_types.dewy'
use 'source_types.dewy'
use 'type_inference.dewy'
use 'checker_state.dewy'
use 'checker_literals.dewy'
use 'checker_idents.dewy'
use 'checker_conditionals.dewy'
use 'checker_receivers.dewy'
use 'checker_variants.dewy'
use 'checker_type_apply.dewy'
use 'checker_unary.dewy'
use 'checker_logic.dewy'
use 'checker_type_tests.dewy'
use 'checker_optional.dewy'
use 'checker_aggregates.dewy'
use 'checker_collections.dewy'
use 'checker_cast.dewy'
use 'checker_places.dewy'
use 'checker_in_range.dewy'
use 'checker_numeric.dewy'
use 'checker_exact.dewy'
struct CheckerExprHost:
    complete: () -> void
    unknown: (int, int, int) -> void
    module: (int, int) -> int
    temperature: (int, int) -> int
    values_use: (int, int) -> void
    dotted: (int, int) -> int
    juxt: (int) -> void
    char_code: (int) -> void
    membership: (int, int) -> int
    quantity_hint: (int) -> int
    decimal: (int) -> void
    set_literal: (int) -> bool
    literal_context: (int, int, int) -> bool
    nd_hint: (int, int, int) -> int
    secret: (int, int, int) -> int
    binary_rest: (int, int, int, int, int, int, int, int) -> int
    call: (int, int) -> int
    sibling: (int, int) -> int
    literal: (int, int, int) -> int
    other: (int, int) -> int
struct CheckerExprInput:
    nodes: *(Node[])
    types: *(TypeInfo[])
    files: *(SrcFile[])
    syms: *(Sym[])
    scopes: *CheckerScope
    contexts: *(FnCtx[])
    context: *int
    ml_at: *(int[])
    ml_mod: *(int[])
    ml_sym: *(int[])
    ml_tick: *(int[])
    ml_struct: *int
    sentinel: *int
    temperature: *bool
    values: *bool
    watch: *StatementWatch
    last: *int
    bool_type: *int
    int_type: *int
    u64_type: *int
    math_int: *int
    quantity_right: *int
    host: *CheckerExprHost
xe_nodes: *(Node[])
xe_types: *(TypeInfo[])
xe_files: *(SrcFile[])
xe_syms: *(Sym[])
xe_scopes: *CheckerScope
xe_contexts: *(FnCtx[])
xe_context: *int
xe_ml_at: *(int[])
xe_ml_mod: *(int[])
xe_ml_sym: *(int[])
xe_ml_tick: *(int[])
xe_ml_struct: *int
xe_sentinel: *int
xe_temperature: *bool
xe_values: *bool
xe_watch: *StatementWatch
xe_last: *int
xe_bool_type: *int
xe_int_type: *int
xe_u64_type: *int
xe_math_int: *int
xe_quantity_right: *int
xe_host: *CheckerExprHost
checker_expr_bind = (input: *CheckerExprInput) -> int:
    xe_nodes = input[0].nodes
    xe_types = input[0].types
    xe_files = input[0].files
    xe_syms = input[0].syms
    xe_scopes = input[0].scopes
    xe_contexts = input[0].contexts
    xe_context = input[0].context
    xe_ml_at = input[0].ml_at
    xe_ml_mod = input[0].ml_mod
    xe_ml_sym = input[0].ml_sym
    xe_ml_tick = input[0].ml_tick
    xe_ml_struct = input[0].ml_struct
    xe_sentinel = input[0].sentinel
    xe_temperature = input[0].temperature
    xe_values = input[0].values
    xe_watch = input[0].watch
    xe_last = input[0].last
    xe_bool_type = input[0].bool_type
    xe_int_type = input[0].int_type
    xe_u64_type = input[0].u64_type
    xe_math_int = input[0].math_int
    xe_quantity_right = input[0].quantity_right
    xe_host = input[0].host
    0
xe_module = (name: int) -> int:
    c = xe_context[0]
    m = -1
    if c >= 0: m = int(xe_contexts[0][c].mod)
    if name < xe_ml_at[0].len():
        stamp = xe_ml_struct[0]
        if name < xe_ml_tick[0].len() and xe_ml_tick[0][name] > xe_ml_struct[0]: stamp = xe_ml_tick[0][name]
        if xe_ml_at[0][name] == stamp and xe_ml_mod[0][name] == m: return xe_ml_sym[0][name]
    xe_host[0].module(m, name)
xe_kind = (k: SK) -> int: int(k)
xe_complete = (): xe_host[0].complete()
xe_unknown = (n: int, expected: int, name: int): xe_host[0].unknown(n, expected, name)
xe_read = (n: int, t: int) -> int:
    it = t
    if xe_temperature[0]: it = xe_host[0].temperature(n, it)
    if xe_values[0]: xe_host[0].values_use(n, it)
    it
xe_ident = (n: int, expected: int) -> int:
    nm = int(xe_nodes[0][n].name)
    if xe_sentinel[0] != 0 and nm == xe_sentinel[0]: xe_complete()
    c = xe_context[0]
    floor = 0
    if c >= 0: floor = int(xe_contexts[0][c].floor)
    i = -1
    if nm < xe_scopes[0].top.len(): i = xe_scopes[0].top[nm]
    s = 0
    if i >= floor: s = xe_scopes[0].syms[i]
    else: s = xe_module(nm)
    if s == 0: xe_unknown(n, expected, nm)
    flags = 0
    if xe_watch[0].const_views > 0: flags = 1
    if xe_watch[0].decimal_globals > 0: flags = flags | 2
    t = xj_ident(n, expected, xe_kind(xe_syms[0][s].kind), int(xe_syms[0][s].ref), s, flags).type
    if xe_temperature[0] or xe_values[0]: return xe_read(n, t)
    t
xe_other = (n: int, expected: int) -> int:
    k = xe_nodes[0][n].kind
    if k == .float_lit or k == .bool_lit or k == .none_lit or k == .null_lit: return xl_check_scalar(n, expected)
    ex = xl_expected(expected)
    if k == .array or (ex != 0 and (k == .map_lit or k == .record_lit or k == .tuple)): ex = xe_host[0].literal(n, expected, ex)
    t = 0
    if k == .dotname: t = xv_check(n, ex)
    else if k == .typeapply:
        r = xa_check(n, expected, ex)
        if r.bypass: return r.type
        t = r.type
    else if k == .unary:
        r = xu_check(n, expected, ex)
        if r.bypass: return r.type
        t = r.type
    else if k == .and_ or k == .or_ or k == .not_:
        r = xg_check(n, expected, ex)
        if r.bypass: return r.type
        t = r.type
    else if k == .istype: t = xi_check(n)
    else if k == .coalesce or k == .unwrap:
        r = xo_check(n, expected, ex)
        if r.bypass: return r.type
        t = r.type
    else if k == .array or k == .record_lit:
        r = xr_check(n, expected, ex)
        if r.bypass: return r.type
        t = r.type
    else if k == .map_lit or k == .tuple:
        r = xk_check(n, expected, ex)
        if r.bypass: return r.type
        t = r.type
    else if k == .iflet: t = xf_iflet(n, ex)
    else if k == .cast:
        r = xc_check(n, expected)
        if r.bypass: return r.type
        t = r.type
    else if k == .addr or k == .conv or k == .fnref or k == .parallel_region or k == .hole or k == .namedarg: t = xp_check(n, expected)
    else: return xe_host[0].other(n, expected)
    xl_finish(n, t, expected)
xe_kind_of = (t: int) -> TK: xe_types[0][int(tu_prune(t))].kind
xe_flag = (n: int, f: int) -> bool: int(xe_nodes[0][n].flags) & f != 0
xe_add_flag = (n: int, f: int): xe_nodes[0][n].flags = i32(int(xe_nodes[0][n].flags) | f)
xe_dewy_at = (pos: int) -> bool:
    f = pos >> 40
    pos > 0 and f < xe_files[0].len() and xe_files[0][f].is_dewy
xe_charlike = (n: int) -> bool: xe_nodes[0][n].kind == .str_lit and xe_flag(n, 512)
xe_quantity_literal = (e: int) -> bool:
    if e == 0 or xe_flag(e, 128): return false
    if xe_nodes[0][e].kind == .unary: return xe_quantity_literal(int(xe_nodes[0][e].a))
    if xe_nodes[0][e].kind == .binary and xe_nodes[0][e].op == 60:
        x = xe_nodes[0][int(xe_nodes[0][e].a)].kind
        return (x == .int_lit or x == .float_lit) and xe_nodes[0][int(xe_nodes[0][e].b)].kind == .ident
    false
xe_quantity_name = (e: int) -> bool:
    if e == 0 or xe_flag(e, 128): return false
    k = xe_nodes[0][e].kind
    k == .ident or (k == .field and xe_nodes[0][int(xe_nodes[0][e].a)].kind == .ident)
xe_literal_operand = (e: int) -> bool:
    k = xe_nodes[0][e].kind
    if k == .array or k == .record_lit or k == .map_lit: return true
    k == .call and xe_nodes[0][e].type == 0 and xe_nodes[0][e].nlist == 1 and xe_nodes[0][int(xe_nodes[0][e].a)].kind == .ident and xe_host[0].set_literal(e)
xe_xor = (n: int, expected: int) -> int:
    ta = int(tu_prune(check_expr(int(xe_nodes[0][n].a), 0)))
    xe_nodes[0][n].a = i32(xe_last[0])
    xe_add_flag(int(xe_nodes[0][n].a), 128)
    xe_nodes[0][n].op = 65
    if ta == xe_bool_type[0]: xe_nodes[0][n].op = 70
    check_expr(n, expected)
xe_char = (n: int):
    if not xe_charlike(int(xe_nodes[0][n].a)) or xe_charlike(int(xe_nodes[0][n].b)): return
    tb = check_expr(int(xe_nodes[0][n].b), 0)
    xe_nodes[0][n].b = i32(xe_last[0])
    xe_add_flag(int(xe_nodes[0][n].b), 128)
    if xe_kind_of(tb) == .int_: xe_host[0].char_code(int(xe_nodes[0][n].a))
xe_in = (n: int, expected: int) -> int:
    b = int(xe_nodes[0][n].b)
    if xe_nodes[0][b].kind == .range and not xe_flag(b, 32768): return int(xy_check(n, expected))
    xe_host[0].membership(n, expected)
xe_decimals = (a: int, b: int):
    xe_host[0].decimal(a)
    xe_host[0].decimal(b)
xe_literal_hint = (e: int, t: int, op: int, hint: int) -> int:
    if not xe_host[0].literal_context(e, t, op): return hint
    p = int(tu_prune(t))
    if xe_types[0][p].kind == .opt: return int(xe_types[0][p].elem)
    p
xe_first = (b: int) -> int:
    t = int(tu_prune(check_expr(b, 0)))
    xe_add_flag(b, 128)
    t
xe_binary = (n: int, expected: int) -> int:
    op = int(xe_nodes[0][n].op)
    if op == 85: return xe_host[0].dotted(n, expected)
    if op == 60 and xe_flag(n, 536870912): xe_host[0].juxt(n)
    if op == 82: return xe_xor(n, expected)
    if op != 58 and op != 60 and xe_nodes[0][int(xe_nodes[0][n].a)].kind == .str_lit: xe_char(n)
    if op == 12: return xe_in(n, expected)
    is_cmp = op >= 69 and op <= 74
    is_shift = op == 67 or op == 68
    hint = 0
    if not is_cmp and expected != 0:
        ek = xe_kind_of(expected)
        if ek == .int_ or ek == .float_ or ek == .vec: hint = expected
        else if ek == .quantity: hint = xe_host[0].quantity_hint(expected)
    a = int(xe_nodes[0][n].a)
    b = int(xe_nodes[0][n].b)
    if (op == 69 or op == 70) and xe_watch[0].decimal_adapted > 0: xe_decimals(a, b)
    flags = 0
    if op == 58 or op == 59:
        if xe_quantity_literal(a): flags = 1
        if xe_quantity_literal(b) or (b == xe_quantity_right[0] and b != 0): flags = flags | 2
    else if op == 60:
        if xe_quantity_name(a): flags = 1
        if xe_quantity_name(b): flags = flags | 2
        ca = xe_charlike(a)
        cb = xe_charlike(b)
        if ca and not cb: xe_nodes[0][a].flags = i32(int(xe_nodes[0][a].flags) & ~512)
        if cb and not ca: xe_nodes[0][b].flags = i32(int(xe_nodes[0][b].flags) & ~512)
    if op == 58:
        ca = xe_charlike(a)
        cb = xe_charlike(b)
        if ca: flags = flags | 4
        if cb: flags = flags | 8
        if ca and not cb and hint == 0 and xe_flag(a, 8):
            tb0 = xe_first(b)
            if xe_types[0][tb0].kind == .int_: hint = tb0
    literal_op = (op == 69 or op == 70 or op == 63 or op == 64 or op == 65 or op == 59) and xe_files[0][xe_nodes[0][n].pos >> 40].is_dewy
    a_literal = literal_op and xe_literal_operand(a)
    b_literal = literal_op and xe_literal_operand(b)
    if a_literal and not b_literal: hint = xe_literal_hint(a, xe_first(b), op, hint)
    ta = int(tu_prune(check_expr(a, hint)))
    tb = 0
    bk = xe_nodes[0][b].kind
    if bk == .none_lit or bk == .null_lit or bk == .dotname: tb = int(tu_prune(check_expr(b, ta)))
    else:
        h = 0
        tk = xe_types[0][ta].kind
        if not xe_flag(a, 256) and not is_shift and (tk == .int_ or tk == .float_):
            h = ta
            if is_cmp and (bk == .int_lit or bk == .unary) and exact_potential(a):
                h = xe_int_type[0]
                if xe_flag(b, 2097152): h = xe_u64_type[0]
        if not a_literal and b_literal: h = xe_literal_hint(b, ta, op, h)
        if bk == .array and tk == .struct_ and (op == 69 or op == 70 or op == 60): h = xe_host[0].nd_hint(n, ta, h)
        tb = int(tu_prune(check_expr(b, h)))
    if xe_types[0][ta].kind == .secret or xe_types[0][tb].kind == .secret: return xe_host[0].secret(n, a, b)
    mi = xe_math_int[0]
    if (int(xe_nodes[0][a].type) == mi or int(xe_nodes[0][b].type) == mi) and xe_dewy_at(xe_nodes[0][n].pos):
        wa = exact_math_operand(a)
        wb = exact_math_operand(b)
        ua = int(xe_nodes[0][wa].type)
        ub = int(xe_nodes[0][wb].type)
        if ua != mi and ub != mi and xe_word(ua) and xe_word(ub):
            a = wa
            b = wb
            xe_nodes[0][n].a = i32(a)
            xe_nodes[0][n].b = i32(b)
            ta = int(tu_prune(ua))
            tb = int(tu_prune(ub))
    if not is_shift and ta != mi and tb != mi:
        fka = xe_types[0][ta].kind
        fkb = xe_types[0][tb].kind
        if (fka == .int_ or fka == .float_) and (fkb == .int_ or fkb == .float_) and not (op == 69 and fka == .float_):
            ak = xe_nodes[0][a].kind
            bk2 = xe_nodes[0][b].kind
            if ak != .float_lit and bk2 != .float_lit and ak != .str_lit and bk2 != .str_lit: return int(xw_numeric(n, i32(op), a, b, ta, tb, is_cmp))
    xe_host[0].binary_rest(n, expected, a, b, ta, tb, hint, flags)
xe_word = (t0: int) -> bool:
    t = int(tu_prune(t0))
    xe_types[0][t].kind == .int_ and (t == xe_math_int[0] or xe_types[0][t].st == 0)
check_expr = (n: int, expected: int) -> int:
    xe_last[0] = n
    if xe_nodes[0][n].type != 0 and int(xe_nodes[0][n].flags) & 128 != 0: return int(xe_nodes[0][n].type)
    k = xe_nodes[0][n].kind
    if k == .ident: return xe_ident(n, expected)
    if k == .int_lit: return xl_check_int(n, expected)
    if k == .binary: return xl_finish(n, xe_binary(n, expected), expected)
    if k == .call: return xe_host[0].call(n, expected)
    if k == .field: return xs_field(n, expected)
    if k == .if_: return xl_finish(n, xf_if(n, xl_expected(expected)), expected)
    if k == .index:
        it = xs_index(n, expected)
        if xe_watch[0].sibling_known != 0: return xe_host[0].sibling(n, it)
        return it
    if k == .str_lit: return xl_check_str(n, expected)
    xe_other(n, expected)

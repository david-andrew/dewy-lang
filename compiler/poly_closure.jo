use 'lower_storage.dewy'
use 'checker_signature.dewy'
use 'checker_expr.dewy'
use 'checker_state.dewy'
use 'checker_types.dewy'
use 'types.jo'
use 'ast.jo'
use 'util.jo'
# Explicitly generic local closures. A family has one lexical environment and
# compile-time identity; each concrete signature gets ordinary lambda code.
use 'check.jo'
use 'expr.jo'
use 'lower.jo'
use 'effects.jo'
use 'dewy_methods.jo'
use 'effect_contracts.dewy'

struct PolyScope:
    frames: FnCtx[]
    names: int[]
    symbols: int[]
    loops: int[]

struct PolyFamily:
    decl: int
    envfn: int
    scope: PolyScope

struct PolyActivation:
    current: int
    frames: int
    mark: int
    loops: int[]

poly_families: PolyFamily[] = [PolyFamily()]
poly_pending_warnings: {int: bool} = {}










struct PolyDefaultKey:
    decl: int
    omitted: int[]

poly_defaults: {PolyDefaultKey: int} = {}




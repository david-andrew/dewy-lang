$runtime_checks

from p"effects.jo" import (EffectEdge effect_summaries)
from p"effect_scan.dewy" import (effect_export)
from p"effect_types.dewy" import (EffectEvent PlaceIdentity)
from p"effect_graph.dewy" import (effect_opaque)
from p"effect_control.dewy" import (effects_demand)
from p"diagnostic_exit.dewy" import (fatal)
from p"types.jo" import (fields prune structs telem tkind types)
from p"ast.jo" import (nodes)
from p"expr.jo" import (ntype)
from p"ownership.jo" import (owner_map_copies ownership_copies ownership_moves)
from p"ownership_types.dewy" import (ownership_type)
from p"place_routes.dewy" import (place_append place_route)
# Scoped-loan services and ownership hook edges; shared state has one owner in effects.jo.
EffectOwnersWord:type=int64<overflow='wrap'>
# Scoped byte loans run in effect_loans.dewy for functions holding byte
# operations (loan_owners); these are its services.
loan_error=(n:int64 reason:string):>void=>$unsafe {
    fatal(nodes.ptr[n].pos "scoped loan: {reason}");
}
loan_host_error=(n:int64 message:string):>void=>$unsafe {
    fatal(nodes.ptr[n].pos message);
}
loan_host_append=(n:int64 p:PlaceIdentity):>PlaceIdentity=>$unsafe {
    return place_append(place_route(n) p)
}
loan_host_route=(n:int64):>PlaceIdentity=>$unsafe {
    return place_route(n)
}
loan_host_demand=(f:int64):>bool=>$unsafe {
    return effects_demand(f)
}
loan_host_events=(f:int64):>array<EffectEvent>=>$unsafe {
    return effect_summaries.ptr[f].events
}
# Owning boundaries must publish every optional hook edge before verification.
# Last-use elision never grants permission to omit a hook's possible effects.
effect_owner_init=(f:EffectOwnersWord source:EffectOwnersWord origin:EffectOwnersWord):>void=>$unsafe {
    let t=prune(ntype(source))
    if not ownership_type(t) {return}
    let k=nodes.ptr[source].kind
    let move=nodes.ptr[origin].kind not=? 'conv' or nodes.ptr[origin].aux not=? int32<overflow='wrap'>(13)
    if k not=? 'ident' and k not=? 'field' and move {return}
    let p=if k =? 'ident' or k =? 'field' {effect_export(f place_route(source))} else {PlaceIdentity['local' f source]}
    effect_owner_components(f t origin p move);
}
effect_owner_components=(f:EffectOwnersWord t:EffectOwnersWord origin:EffectOwnersWord p:PlaceIdentity move:bool depth:EffectOwnersWord=0):>void=>$unsafe {
    if depth >? 32 {
        effect_opaque(f origin);
        return
    }
    if tkind(t) =? 'array' or tkind(t) =? 'fixed' {
        effect_owner_components(f telem(t) origin p move and tkind(t) =? 'fixed' depth + 1);
        return
    }
    let copier=owner_map_copies.get(t)
    if copier not=? none {
        effect_summaries.ptr[f].edges.push(EffectEdge[copier origin [p]]);
        return
    }
    let copy_hook=ownership_copies.get(t)
    if copy_hook not=? none {effect_summaries.ptr[f].edges.push(EffectEdge[copy_hook origin [p]]);}
    if move {
        let move_hook=ownership_moves.get(t)
        if move_hook not=? none {effect_summaries.ptr[f].edges.push(EffectEdge[move_hook origin [p]]);}
    }
    let si:EffectOwnersWord=EffectOwnersWord(types.ptr[prune(t)].st)
    loop i in [0..EffectOwnersWord(structs.ptr[si].nfields)) {
        let ft:EffectOwnersWord=EffectOwnersWord(fields.ptr[EffectOwnersWord(structs.ptr[si].fields) + i].type)
        if ownership_type(ft) {effect_owner_components(f ft origin p move depth + 1);}
    }
}

# Dewy methods: which ones change their object.
# A method reaches its object only through bare member names, which the frontend
# reads through a hidden receiver parameter (`$self...`). A method that assigns or
# grows a member, places one with `@`, or calls a method that does, takes its
# receiver as a place: it must be called on a variable or field. This is decided
# from the bodies before checking, so every call sees the final signature.
use 'prelude.jo'
use 'util.jo'
use 'dewy_context.jo'
use 'ast.jo'
use 'check.jo'
use 'expr.jo'
use 'ownership.jo'
use 'errors.jo'
use 'types.jo'

struct DewyMethod:
    decl: int
    members: {int: int} = {}  # the object's members: a method's index, -1 for any other row
    state: int = 0            # 0 not inferred, 1 inferring, 2 reads its object, 3 changes it
    reads: bool = false       # reaches a member, or calls a method that does; otherwise static

dewy_methods: DewyMethod[]
dewy_type_members: {int: {int: int}} = {}   # a type's declaration -> its members
dewy_methods_inferred = 0
dewy_receivers: {int: int[]} = {}   # function name -> declarations taking an argument first
dewy_module_of_file: {int: int} = {}
dewy_reachable: {int: {int: bool}} = {}   # module -> the modules it can name types from

# A minted type whose parent is in another module (or declared later) learns what it
# inherits only once every module is read. Bare names its methods leave unresolved
# are kept; those naming an inherited member then become that member of the object.
dewy_decl_members: {int: {int: int}} = {}   # a type's declaration -> its members
dewy_decl_methods: {int: int[]} = {}         # a type's declaration -> its own methods' [first, end)
dewy_deferred: {int: int[]} = {}             # such a type's declaration -> the names left
dewy_deferred_order: int[]
dewy_deferred_names: {int: int} = {}         # a name's node -> the name written
dewy_deferred_callees: {int: bool} = {}      # names called, whose object may be a place
dewy_deferred_files: {int: {int: bool}} = {} # file -> names of its types read so

dewy_inherited_key = () -> int: intern("$inherited")

dewy_defer_type = (decl: int, file: int):
    if not dewy_deferred.has(decl):
        dewy_deferred[decl] = []
        dewy_deferred_order.push(decl)
    here = dewy_deferred_files.get(file) ?? {}
    here[int(nodes[decl].name)] = true
    dewy_deferred_files[file] = here

dewy_deferred_here = (file: int, name: int) -> bool:
    if let here = dewy_deferred_files.get(file): return here.has(name)
    false

dewy_defer_name = (decl: int, n: int, name: int):
    left = dewy_deferred[decl]
    left.push(n)
    dewy_deferred[decl] = left
    dewy_deferred_names[n] = name

dewy_defer_callee = (n: int):
    if dewy_deferred_names.has(n): dewy_deferred_callees[n] = true

dewy_resolve_inherited = ():
    if dewy_deferred_order.len() == 0: return
    done: {int: bool} = {}
    loop decl in dewy_deferred_order: dewy_inherit(decl, done)
    dewy_deferred_order = []
    dewy_deferred = {}
    dewy_deferred_names = {}
    dewy_deferred_callees = {}

# The members of the type declared by decl, with those it inherits.
dewy_inherit = (decl: int, done: mut {int: bool}) -> {int: int}:
    own = dewy_decl_members.get(decl) ?? {}
    if not dewy_deferred.has(decl) or done.has(decl): return own
    done[decl] = true
    members: {int: int} = {}
    parent = dewy_parent_decl(decl)
    if parent != 0:
        loop name, member in dewy_inherit(parent, done): members[name] = member
    loop name, member in own: members[name] = member
    dewy_decl_members[decl] = members
    if dewy_type_members.has(decl): dewy_type_members[decl] = members
    if let range = dewy_decl_methods.get(decl):
        loop i in [range[0]..range[1]): dewy_methods[i].members = members
    receiver = intern("$self")
    loop n in dewy_deferred[decl]:
        name = dewy_deferred_names[n]
        if not members.has(name): continue
        base = mk(.ident, nodes[n].pos)
        nodes[base].name = i32(receiver)
        if dewy_deferred_callees.has(n): add_flag(base, NF_MUT)
        field = mk(.field, nodes[n].pos)
        nodes[field].a = i32(base)
        nodes[field].name = i32(name)
        nodes[field].flags = nodes[n].flags
        nodes[n] = nodes[field]
    members

# The declaration of the type decl is minted under (0: none, or not a record type).
dewy_parent_decl = (decl: int) -> int:
    p = int(nodes[decl].a)
    if p == 0 or mint_of_any(decl): return 0
    saved = cx
    ctxs.push(FnCtx(i32(new_inst(FK_INIT, int(nodes[decl].mod), "nominal")), -1, i32(T_VOID), false, 0, nodes[decl].mod, i32(sc_names.len())))
    cx = ctxs.len() - 1
    t = prune(resolve_type(p))
    ctxs.pop()
    cx = saved
    if types[t].kind != .struct_: return 0
    int(structs[int(types[t].st)].decl)

dewy_is_method = (decl: int) -> bool:
    nkids(decl) > 0 and starts_with(name_of(int(nodes[kid(decl, 0)].name)), "$self")

# The rows of one object (a type or a record literal), in order: decls[i] is the
# method declared by names[i], or 0 for a field or a function stored as a value.
# A minted type also has the members it inherits. Gives the object's members.
dewy_method_group = (names: int[], decls: int[], inherited: {int: int} = {}) -> {int: int}:
    members: {int: int} = {}
    loop name, member in inherited: members[name] = member
    first = dewy_methods.len()
    loop i in 0.. and name in names:
        members[name] = -1
        if decls[i] != 0:
            members[name] = dewy_methods.len()
            dewy_methods.push(DewyMethod(decl = decls[i]))
    loop i in [first..dewy_methods.len()): dewy_methods[i].members = members
    members

# (the prelude's declarations of name, parsed now if they were not, are candidates too: with
# every declaration the prelude has parsed since the candidates were listed)
dewy_seen_new = 0
dewy_demand_receivers = (name: int):
    demand_prelude_name(name)
    loop dewy_seen_new < prelude_new_decls.len():
        d = prelude_new_decls[dewy_seen_new]
        dewy_seen_new += 1
        if nodes[d].kind != .fn_ or nkids(d) == 0: continue
        nm = int(nodes[d].name)
        ds = dewy_receivers.get(nm) ?? []
        ds.push(d)
        dewy_receivers[nm] = ds

# A least fixed point: a method changes its object if its body does, given what the
# methods found so far do (so mutual recursion settles).
dewy_infer_methods = ():
    if dewy_methods_inferred == dewy_methods.len(): return
    dewy_receivers = {}
    dewy_module_of_file = {}
    dewy_reachable = {}
    loop m in [0..modules.len()):
        dewy_module_of_file[int(modules[m].file)] = m
        loop d in modules[m].decls:
            if nodes[d].kind != .fn_ or nkids(d) == 0: continue
            name = int(nodes[d].name)
            ds = dewy_receivers.get(name) ?? []
            ds.push(d)
            dewy_receivers[name] = ds
    dewy_seen_new = prelude_new_decls.len()
    loop true:
        progress = false
        loop i in [dewy_methods_inferred..dewy_methods.len()):
            if dewy_methods[i].state == 3: continue
            decl = dewy_methods[i].decl
            receiver = int(nodes[kid(decl, 0)].name)
            changes = dewy_changes(int(nodes[decl].b), receiver, i, false)
            loop param in kids(decl):
                if dewy_changes(int(nodes[param].b), receiver, i, false): changes = true
            if changes:
                dewy_methods[i].state = 3
                progress = true
        if not progress: break
    loop i in [dewy_methods_inferred..dewy_methods.len()):
        if dewy_methods[i].state == 3: add_flag(kid(dewy_methods[i].decl, 0), NF_MUT)
        else: dewy_methods[i].state = 2
        if dc_parser.reach.captures.len() > 0: dewy_member_closures(int(nodes[dewy_methods[i].decl].b))
    # A method is static unless it reaches a member other than a static method:
    # a least fixed point again, so static methods may call one another.
    loop true:
        progress = false
        loop i in [dewy_methods_inferred..dewy_methods.len()):
            if dewy_methods[i].reads: continue
            decl = dewy_methods[i].decl
            receiver = int(nodes[kid(decl, 0)].name)
            reads = ownership_hooks.has(decl) or dewy_reads(int(nodes[decl].b), receiver, i)
            loop param in kids(decl):
                if dewy_reads(int(nodes[param].b), receiver, i): reads = true
            if reads:
                dewy_methods[i].reads = true
                progress = true
        if not progress: break
    dewy_methods_inferred = dewy_methods.len()

# Whether n reaches the object through `receiver` other than to call a static method.
dewy_reads = (n: int, receiver: int, i: int) -> bool:
    if n == 0: return false
    k = nodes[n].kind
    if k == .ident: return int(nodes[n].name) == receiver
    if k == .field:
        base = int(nodes[n].a)
        if nodes[base].kind == .ident and int(nodes[base].name) == receiver:
            if let j = dewy_methods[i].members.get(int(nodes[n].name)):
                if j >= 0 and not dewy_methods[j].reads: return false
            return true
        return dewy_reads(base, receiver, i)
    if dewy_reads(int(nodes[n].a), receiver, i) or dewy_reads(int(nodes[n].b), receiver, i): return true
    if dewy_reads(int(nodes[n].c), receiver, i) or dewy_reads(int(nodes[n].d), receiver, i): return true
    loop child in kids(n):
        if dewy_reads(child, receiver, i): return true
    if k != .lambda and k != .fn_:
        loop child in kids2(n):
            if dewy_reads(child, receiver, i): return true
    false

# The method `name` of the type declared by `decl` (an index of dewy_methods), or -1.
dewy_type_method = (decl: int, name: int) -> int:
    if let members = dewy_type_members.get(decl):
        if let j = members.get(name): return j
    -1

dewy_method_changes = (i: int) -> bool: dewy_methods[i].state == 3

# The modules whose functions a member of an object reachable from `m` may be:
# m, what it uses (transitively) and the prelude.
dewy_reachable_from = (m: int) -> {int: bool}:
    if let known = dewy_reachable.get(m): return known
    seen: {int: bool} = {}
    stack = [m]
    loop stack.len() > 0:
        x = stack.pop()
        if seen.has(x): continue
        seen[x] = true
        loop u in modules[x].uses: stack.push(u)
    loop p in [0..modules.len()):
        if modules[p].is_prelude: seen[p] = true
    dewy_reachable[m] = seen
    seen

# The variable a route of fields and elements starts from.
dewy_route_root = (n: int) -> int:
    let n = n
    loop n != 0 and (nodes[n].kind == .field or nodes[n].kind == .index): n = int(nodes[n].a)
    n

dewy_reaches = (n: int, receiver: int) -> bool:
    root = dewy_route_root(n)
    root != 0 and nodes[root].kind == .ident and int(nodes[root].name) == receiver

# Member `name` of the route `base` (from the receiver), called or read: whether that
# changes it. The object's own members are known; anything else is judged by name.
dewy_member_changes = (base: int, name: int, receiver: int, i: int) -> bool:
    if nodes[base].kind == .ident:
        if let j = dewy_methods[i].members.get(name):
            if j < 0: return false
            return dewy_method_changes(j)
    ii = intrinsic_of(name)
    if ii >= 0 and intrinsics[ii].arr:
        id = intrinsics[ii].id
        if id != .len and id != .arrcap and id != .slice: return true
    m = dewy_module_of_file.get(pos_file(nodes[dewy_methods[i].decl].pos)) ?? -1
    dewy_demand_receivers(name)
    if let ds = dewy_receivers.get(name):
        loop d in ds:
            if m >= 0:
                dm = dewy_module_of_file.get(pos_file(nodes[d].pos)) ?? -1
                if dm >= 0 and not dewy_reachable_from(m).has(dm): continue
            if has_flag(kid(d, 0), NF_MUT): return true
            if dewy_is_method(d):
                loop j in [0..dewy_methods.len()):
                    if dewy_methods[j].decl == d and dewy_method_changes(j): return true
    false

# Members a closure captured by place (`$capture @count`), by lambda node, and
# those of the closure being walked.
dewy_allowed_members: int[]

dewy_change_found = (n: int, nested: bool, member: int = 0) -> bool:
    if nested and (member == 0 or not dewy_allowed_members.contains(member)):
        if member != 0: fatal(nodes[n].pos, "a function inside a method changes the object's member '{name_of(member)}' only through an explicit capture: `($capture @{name_of(member)}) => ...`")
        fatal(nodes[n].pos, "a function inside a method cannot change the object itself (it would change its own copy); change it in the method, or capture the members it changes: `($capture @name) => ...`")
    true

# A closure that captured members by place holds the caller's object: it is
# bound with `let` and only called in the method (a bare name calls; `@f` would
# let it escape). O(method body), only for methods with such closures.
dewy_member_closures = (body: int):
    names: int[]
    dewy_member_closure_names(body, 0, names)
    if names.len() > 0: dewy_member_closure_handles(body, names)

dewy_member_closure_names = (n: int, parent: int, names: mut int[]):
    if n == 0: return
    k = nodes[n].kind
    if k == .lambda and dc_parser.reach.captures.has(n):
        if parent == 0 or nodes[parent].kind != .vardecl or int(nodes[parent].b) != n: fatal(nodes[n].pos, "a closure that changes the object's members runs inside the method: bind it with `let` and call it there")
        names.push(int(nodes[parent].name))
    dewy_member_closure_names(int(nodes[n].a), n, names)
    dewy_member_closure_names(int(nodes[n].b), n, names)
    dewy_member_closure_names(int(nodes[n].c), n, names)
    dewy_member_closure_names(int(nodes[n].d), n, names)
    loop child in kids(n): dewy_member_closure_names(child, n, names)

dewy_member_closure_handles = (n: int, names: int[]):
    if n == 0: return
    k = nodes[n].kind
    escapes = k == .ident and has_flag(n, NF_MUT) and names.contains(int(nodes[n].name))
    if k == .call and nodes[n].aux2 == i32(AUX2_PARTIAL) and nodes[int(nodes[n].a)].kind == .ident and names.contains(int(nodes[int(nodes[n].a)].name)): escapes = true
    if escapes:
        named = n
        if k == .call: named = int(nodes[n].a)
        fatal(nodes[n].pos, "'{name_of(int(nodes[named].name))}' changes the object's members, so it cannot leave the method: call it there")
    dewy_member_closure_handles(int(nodes[n].a), names)
    dewy_member_closure_handles(int(nodes[n].b), names)
    dewy_member_closure_handles(int(nodes[n].c), names)
    dewy_member_closure_handles(int(nodes[n].d), names)
    loop child in kids(n): dewy_member_closure_handles(child, names)

# The object's member a route from the receiver starts with (0 for the object itself).
dewy_route_member = (n: int, receiver: int) -> int:
    let n = n
    member = 0
    loop n != 0 and (nodes[n].kind == .field or nodes[n].kind == .index):
        if nodes[n].kind == .field: member = int(nodes[n].name)
        else: member = 0
        if nodes[int(nodes[n].a)].kind == .ident and int(nodes[int(nodes[n].a)].name) == receiver: return member
        n = int(nodes[n].a)
    0

# Whether n changes the object reached through `receiver`. `nested` is set inside a
# function written in the method's body, whose captured copy of the object is its own.
dewy_changes = (n: int, receiver: int, i: int, nested: bool) -> bool:
    if n == 0: return false
    k = nodes[n].kind
    found = false
    inner = nested or k == .lambda
    if k == .lambda:
        saved = dewy_allowed_members
        dewy_allowed_members = dc_parser.reach.captures.get(n) ?? []
        found = dewy_changes_within(n, receiver, i, true) or dewy_allowed_members.len() > 0
        dewy_allowed_members = saved
        return found
    if k == .assign:
        target = int(nodes[n].a)
        targets = if nodes[target].kind == .tuple: binding_leaves(kids(target)) else: [target]
        loop t in targets:
            if dewy_reaches(t, receiver): found = dewy_change_found(n, nested, dewy_route_member(t, receiver))
    if (k == .for_ or k == .lhead) and has_flag(n, NF_MUT) and dewy_reaches(int(nodes[n].a), receiver):
        found = dewy_change_found(n, nested, dewy_route_member(int(nodes[n].a), receiver))
    if k == .call and nodes[int(nodes[n].a)].kind == .field:
        callee = int(nodes[n].a)
        base = int(nodes[callee].a)
        if dewy_reaches(base, receiver) and dewy_member_changes(base, int(nodes[callee].name), receiver, i):
            found = dewy_change_found(n, nested, dewy_route_member(base, receiver))
        # The receiver of a member call is marked as a possible place; judged above.
        if dewy_changes_within(base, receiver, i, inner): found = true
        loop arg in kids(n):
            if dewy_changes(arg, receiver, i, inner): found = true
        return found
    if k == .field and nodes[n].name != 0 and dewy_reaches(int(nodes[n].a), receiver):
        if dewy_member_changes(int(nodes[n].a), int(nodes[n].name), receiver, i): found = dewy_change_found(n, nested, dewy_route_member(int(nodes[n].a), receiver))
    if has_flag(n, NF_MUT) and (k == .ident or k == .field or k == .index) and dewy_reaches(n, receiver):
        found = dewy_change_found(n, nested, dewy_route_member(n, receiver))
    if dewy_changes_within(n, receiver, i, inner): found = true
    found

dewy_changes_within = (n: int, receiver: int, i: int, nested: bool) -> bool:
    found = false
    k = nodes[n].kind
    if dewy_changes(int(nodes[n].a), receiver, i, nested): found = true
    if k == .field: return found
    if dewy_changes(int(nodes[n].b), receiver, i, nested): found = true
    if dewy_changes(int(nodes[n].c), receiver, i, nested): found = true
    if dewy_changes(int(nodes[n].d), receiver, i, nested): found = true
    loop child in kids(n):
        if dewy_changes(child, receiver, i, nested): found = true
    if k != .lambda and k != .fn_:
        loop child in kids2(n):
            if dewy_changes(child, receiver, i, nested): found = true
    found

$runtime_checks
from p"checker_types.dewy" import (TypeInfo StructInfo)
from p"refinement_types.dewy" import (RefAtom RefTerm FactBound FactReason)
from p"refine_predicates.dewy" import (ref_atoms_intern ref_atoms_length_only)
from p"type_inference.dewy" import (TypeInferenceInput tu_prune tu_has_var tu_targ)
from p"type_constructors.dewy" import (tb_mk_array tb_mk_fixed tb_mk_opt tb_mk_tuple)
# Demand-only construction and representation walks. Deep representation visits
# requested type occurrences; construction scans predicate atoms and uses the
# existing indexed type interner. Borrow headers across recursive host calls,
# reacquiring element views after callbacks that may grow the arenas.
RWord:type=int64<overflow='wrap'>
TypeRefinementHost:type=[
    copy_span:<(source:int64 dest:int64):>void>
    domain:<(type_id:int64 reason:FactReason at:int64):>FactBound>
    int_fits:<(value:int64 type_id:int64):>bool>
    fatal:<(position:int64 message:string):>void>
]
let tr_types:ptr<array<TypeInfo>>=$unsafe (uint64(0) as ptr<array<TypeInfo>>)
let tr_structs:ptr<array<StructInfo>>=$unsafe (uint64(0) as ptr<array<StructInfo>>)
let tr_predicates:ptr<array<array<RefAtom>>>=$unsafe (uint64(0) as ptr<array<array<RefAtom>>>)
let tr_inference:ptr<TypeInferenceInput>=$unsafe (uint64(0) as ptr<TypeInferenceInput>)
let tr_active:ptr<bool>=$unsafe (uint64(0) as ptr<bool>)
let tr_u64:ptr<int64>=$unsafe (uint64(0) as ptr<int64>)
let tr_host:ptr<TypeRefinementHost>=$unsafe (uint64(0) as ptr<TypeRefinementHost>)
type_refinement_bind=(input:ptr<TypeInferenceInput> predicates:ptr<array<array<RefAtom>>> active:ptr<bool> u64_type:ptr<int64> host:ptr<TypeRefinementHost>):>RWord=>$unsafe {
    tr_inference=input; tr_types=input[0].types; tr_structs=input[0].structs
    tr_predicates=predicates; tr_active=active; tr_u64=u64_type; tr_host=host; 0
}
tr_intern=(atoms:array<RefAtom>):>RWord=>$unsafe {ref_atoms_intern(@tr_predicates[0] atoms)}
tr_length_only=(predicate:RWord):>bool=>$unsafe {ref_atoms_length_only(tr_predicates[0][predicate])}
tr_fixed_len=(t:RWord):>RWord=>$unsafe {RWord(tr_types[0].ptr[tu_prune(t)].bits)}
tr_is_int=(t:RWord):>bool=>$unsafe {tr_types[0].ptr[tu_prune(t)].kind =? 'int_'}
tr_is_nd=(t0:RWord):>bool=>$unsafe {
    let t=tu_prune(t0)
    tr_types[0].ptr[t].kind =? 'struct_' and tr_structs[0].ptr[RWord(tr_types[0].ptr[t].st)].name =? "NDArray"
}
tr_representation=(t0:RWord):>RWord=>$unsafe {
    let t=tu_prune(t0)
    if tr_types[0].ptr[t].kind =? 'refined' {return tu_prune(RWord(tr_types[0].ptr[t].elem))}
    t
}
tr_deep=(t0:RWord):>RWord=>$unsafe {
    let t=tr_representation(t0)
    let k=tr_types[0].ptr[t].kind
    if k =? 'array' {return tb_mk_array(tr_deep(RWord(tr_types[0].ptr[t].elem)))}
    if k =? 'fixed' {return tb_mk_fixed(tr_deep(RWord(tr_types[0].ptr[t].elem))  tr_fixed_len(t))}
    if k =? 'opt' {return tb_mk_opt(tr_deep(RWord(tr_types[0].ptr[t].elem)))}
    if k =? 'tuple' {
        let a:array<int64>=[]
        loop i in [0..RWord(tr_types[0].ptr[t].nargs)) {a.push(tr_deep(tu_targ(t  i)))}
        return tb_mk_tuple(a  tr_types[0].ptr[t].sign)
    }
    t
}
tr_make=(base0:RWord predicate0:RWord):>RWord=>$unsafe {
    let base=tu_prune(base0)
    let declared=predicate0
    let predicate = predicate0
    if tr_types[0].ptr[base].kind =? 'refined' {
        predicate=tr_intern([tr_predicates[0][RWord(tr_types[0].ptr[base].st)]... tr_predicates[0][predicate]...])
        base=RWord(tr_types[0].ptr[base].elem)
    }
    let normalized:array<RefAtom>=[]
    let dependencies:array<int64>=[]
    loop original in tr_predicates[0][predicate] {
        let atom=original
        atom.a = tr_limit(atom.a)
        atom.b = tr_limit(atom.b)
        loop term in [atom.a  atom.b] {
            if term.kind =? 4 {dependencies.push(term.value)}
        }
        # A length cannot reach 2^63; uint64.max bounds normalize to int64.max.
        if tr_types[0].ptr[base].kind =? 'array' or tr_types[0].ptr[base].kind =? 'str_' {
            if atom.a.kind =? 1 and atom.a.unsigned and atom.a.value <? 0 {atom.a = RefTerm[1  9223372036854775807]}
            if atom.b.kind =? 1 and atom.b.unsigned and atom.b.value <? 0 {atom.b = RefTerm[1  9223372036854775807]}
        }
        normalized.push(atom)
    }
    predicate=tr_intern(normalized)
    tr_host[0].copy_span(declared  predicate)
    if not tr_is_int(base) and tr_types[0].ptr[base].kind not=? 'array' and not tu_has_var(base) and not tr_is_nd(base) and not(tr_types[0].ptr[base].kind =? 'str_' and tr_length_only(predicate)) {tr_host[0].fatal(-1  "refinement requires an integer, array or string base")}
    if not tu_has_var(base) and tr_is_int(base) {
        loop atom in tr_predicates[0][predicate] {
            loop term in [atom.a  atom.b] {
                if term.kind not=? 1 {continue}
                if term.unsigned and base not=? tr_u64[0] or not term.unsigned and not tr_host[0].int_fits(term.value  base) {
                    tr_host[0].fatal(-1  "refinement bound is outside its integer representation")
                }
            }
        }
    }
    tr_active[0] = true
    tr_inference[0].host[0].mk_type(TypeInfo[kind='refined'  elem = int32(base)  st = int32(predicate)]  dependencies)
}
tr_limit=(term:RefTerm):>RefTerm=>$unsafe {
    if term.kind not=? 4 {return term}
    let t=tu_prune(term.value)
    if tu_has_var(t) {return term}
    if not tr_is_int(t) {tr_host[0].fatal(-1  "refinement type limit requires an integer type")}
    if t =? tr_u64[0] {return RefTerm[1  (if term.unsigned {-1} else {0})  term.unsigned]}
    let domain=tr_host[0].domain(t 'missing' 0)
    RefTerm[1  if term.unsigned {domain.hi} else {domain.lo}]
}

$runtime_checks
from p"node_store.dewy" import Node
from p"source_types.dewy" import SrcFile
from p"checker_state.dewy" import (FnInst Sym FnCtx)
# Questions the call checker asks of a call's names and arguments: which intrinsic a
# name is, whether an argument takes its type from the parameter it meets (so it is
# checked after the overload is picked), and the common cases of two per-call checks
# (argument order, overlapping mutable arguments, float keys of library sets and maps),
# whose rare cases are host services.
# Jo callers call them directly; the call group will. O(1); an array literal or a
# call's arguments O(their count).
# Frozen ordinals: Tok.minus 59; NF_CHECKED 128, NF_FNREF_ARG 4096, NF_COMPREHENSION
# 67108864.
CGWord:type=int64<overflow='wrap'>
CheckerCallQueryHost:type=[
    order:<(node:int64 given:array<int64> final:array<int64>):>void>
    overlap:<(args:array<int64> mask:int64 pos:int64):>void>
    float_key:<(node:int64):>void>
    habit:<(node:int64 name:int64 args:array<int64>):>void>
]
CheckerCallQueryInput:type=[
    nodes:ptr<array<Node>>
    lists:ptr<array<int32>>
    files:ptr<array<SrcFile>>
    intrinsic_names:ptr<array<int64>>
    set_name:ptr<int64>
    fns:ptr<array<FnInst>>
    float_key_names:ptr<array<int64>>
    host:ptr<CheckerCallQueryHost>
    syms:ptr<array<Sym>>
    names:ptr<array<string>>
    prelude_syms:ptr<array<int64>>
    name_first:ptr<array<int64>>
    name_mod:ptr<array<int64>>
    name_sym:ptr<array<int64>>
    name_next:ptr<array<int64>>
    habit_names:ptr<array<int64>>
]
let cg_nodes:ptr<array<Node>>=$unsafe (uint64(0) as ptr<array<Node>>)
let cg_lists:ptr<array<int32>>=$unsafe (uint64(0) as ptr<array<int32>>)
let cg_files:ptr<array<SrcFile>>=$unsafe (uint64(0) as ptr<array<SrcFile>>)
let cg_intrinsic_names:ptr<array<int64>>=$unsafe (uint64(0) as ptr<array<int64>>)
let cg_set_name:ptr<int64>=$unsafe (uint64(0) as ptr<int64>)
let cg_fns:ptr<array<FnInst>>=$unsafe (uint64(0) as ptr<array<FnInst>>)
let cg_float_key_names:ptr<array<int64>>=$unsafe (uint64(0) as ptr<array<int64>>)
let cg_host:ptr<CheckerCallQueryHost>=$unsafe (uint64(0) as ptr<CheckerCallQueryHost>)
let cg_syms:ptr<array<Sym>>=$unsafe (uint64(0) as ptr<array<Sym>>)
let cg_names:ptr<array<string>>=$unsafe (uint64(0) as ptr<array<string>>)
let cg_prelude_syms:ptr<array<int64>>=$unsafe (uint64(0) as ptr<array<int64>>)
let cg_name_first:ptr<array<int64>>=$unsafe (uint64(0) as ptr<array<int64>>)
let cg_name_mod:ptr<array<int64>>=$unsafe (uint64(0) as ptr<array<int64>>)
let cg_name_sym:ptr<array<int64>>=$unsafe (uint64(0) as ptr<array<int64>>)
let cg_name_next:ptr<array<int64>>=$unsafe (uint64(0) as ptr<array<int64>>)
let cg_habit_names:ptr<array<int64>>=$unsafe (uint64(0) as ptr<array<int64>>)
checker_call_queries_bind=(input:ptr<CheckerCallQueryInput>):>CGWord=>$unsafe {
    cg_nodes=input[0].nodes
    cg_lists=input[0].lists
    cg_files=input[0].files
    cg_intrinsic_names=input[0].intrinsic_names
    cg_set_name=input[0].set_name
    cg_fns=input[0].fns
    cg_float_key_names=input[0].float_key_names
    cg_host=input[0].host
    cg_syms=input[0].syms
    cg_names=input[0].names
    cg_prelude_syms=input[0].prelude_syms
    cg_name_first=input[0].name_first
    cg_name_mod=input[0].name_mod
    cg_name_sym=input[0].name_sym
    cg_name_next=input[0].name_next
    cg_habit_names=input[0].habit_names
    0
}
# The intrinsic (its index in the table) an interned name names, or -1.
intrinsic_of=(name:CGWord):>CGWord=>$unsafe {
    if name >=? 0 and name <? cg_intrinsic_names[0].length {return cg_intrinsic_names[0].ptr[name] - 1}
    -1
}
# A literal too wide for a word (a call the reader marked), possibly negated.
cg_oversized=(a:CGWord):>bool=>$unsafe {
    let node=cg_nodes[0].ptr + a
    if node[0].kind =? 'unary' and node[0].op =? 59 {return cg_oversized(CGWord(node[0].a))}
    node[0].kind =? 'call' and node[0].aux2 =? -1
}
cg_dewy=(pos:int64):>bool=>$unsafe {cg_files[0][pos >> 40].is_dewy}
# Does argument a take its type from its parameter: an unchecked Dewy literal (array,
# map, set, record, conditional, comprehension), a lambda, `none`, a hole, `.v`, a
# function named as a value, an oversized literal?
ctx_dependent=(a:CGWord):>bool=>$unsafe {
    let node=cg_nodes[0].ptr + a
    let k=node[0].kind
    let flags=CGWord(node[0].flags)
    if k =? 'unary' {return node[0].op =? 59 and cg_oversized(CGWord(node[0].a))}
    if k =? 'call' {
        if node[0].aux2 =? -1 {return true}
        if node[0].type =? 0 {
            let callee=cg_nodes[0].ptr + CGWord(node[0].a)
            let ck=callee[0].kind
            if node[0].nlist =? 1 and ck =? 'ident' and CGWord(callee[0].name) =? cg_set_name[0] {return true}
            if ck =? 'dotname' {return true}
        }
        return false
    }
    if k =? 'ident' or k =? 'field' or k =? 'typeapply' {return (flags & 4096) not=? 0}
    if k =? 'dotname' {return node[0].type =? 0}
    if k =? 'lambda' or k =? 'none_lit' or k =? 'hole' or k =? 'record_lit' {return true}
    if k =? 'if_' or k =? 'match_' {return (flags & 128) =? 0 and cg_dewy(node[0].pos)}
    if k =? 'block' {return (flags & 67108864) not=? 0 and (flags & 128) =? 0}
    if k =? 'array' {
        let count=CGWord(node[0].nlist)
        if count =? 0 {return node[0].b =? 0}
        if node[0].type =? 0 and (flags & 128) =? 0 and cg_dewy(node[0].pos) {return true}
        let base=CGWord(node[0].list)
        let i:CGWord=0
        loop i <? count {
            if ctx_dependent(CGWord(cg_lists[0].ptr[base + i])) {return true}
            i=i + 1
        }
        return false
    }
    if k =? 'map_lit' {return node[0].nlist =? 0 or (node[0].type =? 0 and (flags & 128) =? 0 and cg_dewy(node[0].pos))}
    false
}
cg_unnamed=(a:CGWord):>CGWord=>$unsafe {
    if cg_nodes[0].ptr[a].kind =? 'namedarg' {return CGWord(cg_nodes[0].ptr[a].a)}
    a
}
cg_order=(n:CGWord given:array<int64> final:array<int64>):>void=>$unsafe {cg_host[0].order(n given final)}
# A Dewy call's argument order (given as written, final by parameter): nothing to record
# when the written arguments are already in parameter order (omitted trailing defaults
# follow them); otherwise the host records the order.
save_call_order=(n:CGWord given:array<int64> final:array<int64>):>void=>$unsafe {
    if not cg_dewy(cg_nodes[0].ptr[n].pos) {return}
    let count=given.length
    if count >? final.length {
        cg_order(n given final)
        return
    }
    let i:CGWord=0
    loop i <? count {
        if cg_unnamed(given[i]) not=? final[i] {
            cg_order(n given final)
            return
        }
        i=i + 1
    }
}
# Mutable arguments (the parameters in mask) must be disjoint places: with fewer than
# two there is nothing to compare; otherwise the host compares them.
check_mutable_arguments=(args:array<int64> mask:CGWord pos:CGWord):>void=>$unsafe {
    if mask =? 0 or (mask & (mask - 1)) =? 0 {return}
    cg_host[0].overlap(args mask pos)
}
# A call of a library set or map whose key type holds floats owes a key proof (floats.jo).
# Without a host call: a declaration with no parameters; one argument to a function not
# named `__dewy_make_set` or `set`; parameter 1 not named `k` or `value` (the interned
# names, in that order). The host tests the library and the key type.
map_float_key=(n:CGWord):>void=>$unsafe {
    let d=CGWord(cg_fns[0].ptr[CGWord(cg_nodes[0].ptr[n].sym)].decl)
    if d =? 0 {return}
    let decl=cg_nodes[0].ptr + d
    let nd=CGWord(decl[0].nlist)
    if nd <? 1 {return}
    let nn=CGWord(cg_nodes[0].ptr[n].nlist)
    let names=cg_float_key_names[0].ptr
    if nn =? 1 {
        let nm=CGWord(decl[0].name)
        if nm not=? names[0] and nm not=? names[1] {return}
    } else {
        if nd <? 2 or nn <? 2 {return}
        let p=CGWord(cg_nodes[0].ptr[CGWord(cg_lists[0].ptr[CGWord(decl[0].list) + 1])].name)
        if p not=? names[2] and p not=? names[3] {return}
    }
    cg_host[0].float_key(n)
}
# The function family a module's own table binds an interned name to (m < 0: the
# prelude's), read from the indexed tables check.jo keeps beside its maps: the family's
# first binding, or 0 when there is none, the name binds something else, or it is a
# private name hidden (hide 1: `_x` hidden; hide 2: only a used module's, the library's
# `__x` kept). O(modules binding the name).
name_family=(m:CGWord name:CGWord hide:CGWord):>CGWord=>$unsafe {
    let s:CGWord=0
    if m <? 0 {
        if name <? cg_prelude_syms[0].length {s=cg_prelude_syms[0].ptr[name]}
    } else {
        if name <? cg_name_first[0].length {
            let e=cg_name_first[0].ptr[name]
            loop e not=? 0 {
                if cg_name_mod[0].ptr[e - 1] =? m {
                    s=cg_name_sym[0].ptr[e - 1]
                    e=0
                } else {
                    e=cg_name_next[0].ptr[e - 1]
                }
            }
        }
    }
    if s =? 0 {return 0}
    if hide not=? 0 {
        let text=cg_names[0].ptr[name]
        if text.startswith("_") and not (hide =? 2 and text.startswith("__")) {return 0}
    }
    if cg_syms[0].ptr[s].kind not=? 'fns' {return 0}
    s
}
# A call written as another language's habit (`push()` for push_transform, `line` with
# four numbers...) is told Dewy's spelling by the host (expr.jo habit_rest). Without a
# host call: a name that is none of them (interned line, text, clear, fill, push, pop,
# map, atan, random, in that order), or an argument count the habit cannot have.
habit_call_check=(n:CGWord name:CGWord args:array<int64>):>void=>$unsafe {
    let h=cg_habit_names[0].ptr
    let na=args.length
    let maybe=false
    if name =? h[0] {maybe=na >=? 4}
    if name =? h[1] or name =? h[3] {maybe=na >=? 3}
    if name =? h[2] or name =? h[8] {maybe=na =? 1}
    if name =? h[4] or name =? h[5] {maybe=na =? 0}
    if name =? h[6] {maybe=na =? 5}
    if name =? h[7] {maybe=na =? 2}
    if maybe {cg_host[0].habit(n name args)}
}
# A call's function family by name, gathered in `out` (each declaration once): the
# current module's (collect_fns) or a given module's (collect_module) own table, its
# uses', the Dewy prelude's for a Dewy module, the shared prelude's, and the bundled
# rational's exact members. Declarations the caller's language does not see go to
# surface_hidden. The tables are check.jo's and prelude.jo's, indexed (mod_bits: 1 a
# prelude module, 2 a Dewy file); the host loads what a name demands first, builds the
# use homes once, loads a Dewy prelude module, and answers the rational reach.
# O(declarations collected + modules binding the name + uses).
CheckerCollectHost:type=[
    demand:<(name:int64):>void>
    use_home:<(m:int64 name:int64):>int64>
    prelude_module:<(name:int64):>int64>
    prelude_reach:<(m:int64 dm:int64):>void>
    rational:<(m:int64 name:int64 out:ptr<array<int64>>):>void>
    cin_grow:<(d:int64):>void>
    named_grow:<(name:int64):>void>
]
# A collect_named family kept while its name's stamp stands: by name through next (an entry
# + 1; 0 ends it), for the module asked from (-1 the current one's) and the module checked in,
# its declarations and the spellings it hid (spans of named_decls and named_hidden).
NamedFamily:type=[
    next:int64=0
    mod:int64=0
    cur:int64=0
    gen:int64=0
    decls:int64=0
    ndecls:int64=0
    hidden:int64=0
    nhidden:int64=0
]
CheckerCollectInput:type=[
    contexts:ptr<array<FnCtx>>
    context:ptr<int64>
    mod_bits:ptr<array<int64>>
    mod_uses:ptr<array<array<int64>>>
    homes_built:ptr<bool>
    prelude_used:ptr<array<bool>>
    home_first:ptr<array<int64>>
    home_mod:ptr<array<int64>>
    home_next:ptr<array<int64>>
    demanded:ptr<array<bool>>
    dp_scanned:ptr<bool>
    dp_by_name:ptr<array<int64>>
    dp_mods:ptr<array<int64>>
    rational_found:ptr<int64>
    rational_probed:ptr<int64>
    rational_reach:ptr<array<int64>>
    exact_named:ptr<array<bool>>
    cin_mark:ptr<array<int32>>
    surface_hidden:ptr<array<int64>>
    host:ptr<CheckerCollectHost>
    ide:ptr<bool>
    ml_name_tick:ptr<array<int64>>
    ml_struct:ptr<int64>
    named_first:ptr<array<int64>>
    named:ptr<array<NamedFamily>>
    named_decls:ptr<array<int64>>
    named_hidden:ptr<array<int64>>
]
let cl_in:ptr<CheckerCollectInput>=$unsafe (uint64(0) as ptr<CheckerCollectInput>)
let cl_pass:CGWord=0
checker_collect_bind=(input:ptr<CheckerCollectInput>):>CGWord=>$unsafe {
    cl_in=input
    0
}
cl_cur_mod=():>CGWord=>$unsafe {
    let c=cl_in[0].context[0]
    if c >=? 0 {return CGWord(cl_in[0].contexts[0].ptr[c].mod)}
    0
}
cl_demand=(name:CGWord):>void=>$unsafe {
    if name <? cl_in[0].demanded[0].length and cl_in[0].demanded[0].ptr[name] {return}
    cl_in[0].host[0].demand(name)
}
cl_marked=(d:CGWord):>bool=>$unsafe {d <? cl_in[0].cin_mark[0].length and CGWord(cl_in[0].cin_mark[0].ptr[d]) =? cl_pass}
cl_mark=(d:CGWord):>void=>$unsafe {
    if d >=? cl_in[0].cin_mark[0].length {cl_in[0].host[0].cin_grow(d)}
    cl_in[0].cin_mark[0].ptr[d]=int32<overflow='wrap'>(cl_pass)
}
# Module m's family of name (m < 0: the prelude's; hide as name_family's), the
# declarations not in `out` yet.
collect_in=(m:CGWord name:CGWord hide:CGWord out:ptr<array<int64>>):>void=>$unsafe {
    let s=name_family(m name hide)
    if s =? 0 {return}
    let cm=cl_cur_mod()
    let dewy=cm >=? 0 and (cl_in[0].mod_bits[0].ptr[cm] & 2) not=? 0
    cl_pass=cl_pass + 1
    let i:CGWord=0
    let count=out[0].length
    loop i <? count {
        cl_mark(out[0].ptr[i])
        i=i + 1
    }
    let o=s
    loop o not=? 0 {
        let sym=cg_syms[0].ptr + o
        let d=CGWord(sym[0].decl)
        let surface=CGWord(sym[0].surface)
        let hidden=false
        if surface =? 1 {hidden=not dewy}
        if surface not=? 0 and surface not=? 1 {hidden=dewy}
        if hidden {cl_in[0].surface_hidden[0].push(d)}
        else if not cl_marked(d) {
            out[0].push(d)
            cl_mark(d)
        }
        o=CGWord(sym[0].next)
    }
}
# (the one use of m whose table can bind name, -1 none, -2 each use asked in order)
cl_use_home=(m:CGWord name:CGWord):>CGWord=>$unsafe {
    if not cl_in[0].homes_built[0] {return cl_in[0].host[0].use_home(m name)}
    if m <? cl_in[0].prelude_used[0].length and cl_in[0].prelude_used[0].ptr[m] {return -2}
    if name >=? cl_in[0].home_first[0].length {return -1}
    let h=cl_in[0].home_first[0].ptr[name]
    if h =? 0 {return -1}
    h=h - 1
    if cl_in[0].home_next[0].ptr[h] not=? 0 {return -2}
    let hm=cl_in[0].home_mod[0].ptr[h]
    let uses=cl_in[0].mod_uses[0].ptr + m
    let i:CGWord=0
    loop i <? uses[0].length {
        if uses[0].ptr[i] =? hm {return hm}
        i=i + 1
    }
    -1
}
cl_bound_in=(m:CGWord name:CGWord):>bool=>$unsafe {
    if name >=? cl_in[0].home_first[0].length {return false}
    let h=cl_in[0].home_first[0].ptr[name]
    loop h not=? 0 {
        if cl_in[0].home_mod[0].ptr[h - 1] =? m {return true}
        h=cl_in[0].home_next[0].ptr[h - 1]
    }
    false
}
collect_module=(m:CGWord name:CGWord out:ptr<array<int64>>):>void=>$unsafe {
    if m <? 0 {return}
    cl_demand(name)
    if (cl_in[0].mod_bits[0].ptr[m] & 1) not=? 0 {
        collect_in(-1 name 0 out)
        return
    }
    collect_in(m name 0 out)
    let nu=cl_in[0].mod_uses[0].ptr[m].length
    if nu =? 0 {return}
    let h=cl_use_home(m name)
    if h >=? 0 {
        collect_in(h name 1 out)
        return
    }
    if h not=? -2 {return}
    let i:CGWord=0
    loop i <? nu {
        let u=cl_in[0].mod_uses[0].ptr[m].ptr[i]
        if (cl_in[0].mod_bits[0].ptr[u] & 1) not=? 0 {collect_in(-1 name 2 out)}
        else if cl_bound_in(u name) {collect_in(u name 1 out)}
        i=i + 1
    }
}
# (the Dewy prelude module declaring name, -1 none: the host's until it is loaded)
cl_prelude_module=(name:CGWord):>CGWord=>$unsafe {
    if cl_in[0].dp_scanned[0] and name <? cl_in[0].dp_by_name[0].length {
        let f=cl_in[0].dp_by_name[0].ptr[name]
        if f =? 1 {return -1}
        if f >=? 2 {
            let dm=cl_in[0].dp_mods[0].ptr[f - 2]
            if dm >=? 0 {return dm}
        }
    }
    cl_in[0].host[0].prelude_module(name)
}
# (m calls a function of the Dewy prelude's module dm: nothing to record while the bundled
# rational is not loaded, or once m reaches it)
cl_prelude_reach=(m:CGWord dm:CGWord):>void=>$unsafe {
    if cl_in[0].rational_found[0] <? 0 and cl_in[0].mod_bits[0].length =? cl_in[0].rational_probed[0] {return}
    if m <? cl_in[0].rational_reach[0].length and cl_in[0].rational_reach[0].ptr[m] =? 1 {return}
    cl_in[0].host[0].prelude_reach(m dm)
}
collect_fns=(name:CGWord out:ptr<array<int64>>):>void=>$unsafe {
    cl_demand(name)
    let m=cl_cur_mod()
    collect_module(m name out)
    let user=false
    let dewy=false
    if m >=? 0 {
        let bits=cl_in[0].mod_bits[0].ptr[m]
        user=(bits & 1) =? 0
        dewy=user and (bits & 2) not=? 0
    }
    if dewy and not cg_names[0].ptr[name].startswith("_") {
        let dm=cl_prelude_module(name)
        if dm >=? 0 and name_family(dm name 0) not=? 0 {
            if dm not=? m {
                collect_in(dm name 0 out)
                cl_prelude_reach(m dm)
            }
            return
        }
    }
    let hide:CGWord=0
    if user {hide=2}
    collect_in(-1 name hide out)
    if dewy {
        let ex=cl_in[0].exact_named
        if ex[0].length =? 0 or (name <? ex[0].length and ex[0].ptr[name]) {cl_in[0].host[0].rational(m name out)}
    }
}
# (the tick as of which name's module-level answers stand: check.jo's ml_stamp)
cl_stamp=(name:CGWord):>CGWord=>$unsafe {
    let ticks=cl_in[0].ml_name_tick
    let base=cl_in[0].ml_struct[0]
    if name <? ticks[0].length and ticks[0].ptr[name] >? base {return ticks[0].ptr[name]}
    base
}
# (a Dewy method: its first parameter is `$self...`)
cl_method=(d:CGWord):>bool=>$unsafe {
    let decl=cg_nodes[0].ptr + d
    if decl[0].nlist <? 1 {return false}
    let p=CGWord(cg_lists[0].ptr[CGWord(decl[0].list)])
    cg_names[0].ptr[CGWord(cg_nodes[0].ptr[p].name)].startswith("$self")
}
# A bare name in a Dewy module names one binding: the module's own declarations of it
# shadow the families it would otherwise see, as a whole (methods, reached through their
# object, stay).
cl_named_now=(name:CGWord mod:CGWord out:ptr<array<int64>>):>void=>$unsafe {
    if mod >=? 0 {collect_module(mod name out)} else {collect_fns(name out)}
    let m=if mod >=? 0 {mod} else {cl_cur_mod()}
    if m <? 0 {return}
    let bits=cl_in[0].mod_bits[0].ptr[m]
    if (bits & 1) not=? 0 or (bits & 2) =? 0 {return}
    let s=name_family(m name 0)
    if s =? 0 {return}
    let owned=false
    let o=s
    loop o not=? 0 {
        let d=CGWord(cg_syms[0].ptr[o].decl)
        if d not=? 0 and not cl_method(d) {owned=true}
        o=CGWord(cg_syms[0].ptr[o].next)
    }
    if not owned {return}
    let kept:CGWord=0
    let i:CGWord=0
    let count=out[0].length
    loop i <? count {
        let d=out[0].ptr[i]
        let keep=cl_method(d)
        let e=s
        loop not keep and e not=? 0 {
            let ed=CGWord(cg_syms[0].ptr[e].decl)
            if ed =? d and ed not=? 0 and not cl_method(ed) {keep=true}
            e=CGWord(cg_syms[0].ptr[e].next)
        }
        if keep {
            out[0].ptr[kept]=d
            kept=kept + 1
        }
        i=i + 1
    }
    loop out[0].length >? kept {out[0].pop();}
}
# collect_fns (mod < 0) or collect_module(mod), with the Dewy module's own binding
# shadowing, into an empty `out`: kept by name, module and current module while the
# name's stamp stands. O(entries for the name) a hit, plus the declarations copied.
collect_named=(name:CGWord mod:CGWord out:ptr<array<int64>>):>void=>$unsafe {
    if out[0].length >? 0 or cl_in[0].ide[0] {
        cl_named_now(name mod out)
        return
    }
    let cur=cl_cur_mod()
    let gen=cl_stamp(name)
    let fams=cl_in[0].named
    let found:CGWord=-1
    if name <? cl_in[0].named_first[0].length {
        let e=cl_in[0].named_first[0].ptr[name]
        loop e not=? 0 {
            let f=fams[0].ptr + (e - 1)
            if f[0].mod =? mod and f[0].cur =? cur {
                if f[0].gen =? gen {
                    let decls=cl_in[0].named_decls
                    let i=f[0].decls
                    let stop=i + f[0].ndecls
                    loop i <? stop {
                        out[0].push(decls[0].ptr[i])
                        i=i + 1
                    }
                    let hidden=cl_in[0].named_hidden
                    i=f[0].hidden
                    stop=i + f[0].nhidden
                    loop i <? stop {
                        cl_in[0].surface_hidden[0].push(hidden[0].ptr[i])
                        i=i + 1
                    }
                    return
                }
                found=e - 1
                e=0
            } else {
                e=f[0].next
            }
        }
    }
    let mark=cl_in[0].surface_hidden[0].length
    cl_named_now(name mod out)
    if cl_stamp(name) not=? gen {return}
    let decls=cl_in[0].named_decls
    let start=decls[0].length
    let i:CGWord=0
    loop i <? out[0].length {
        decls[0].push(out[0].ptr[i])
        i=i + 1
    }
    let hidden=cl_in[0].named_hidden
    let hstart=hidden[0].length
    let surface=cl_in[0].surface_hidden
    i=mark
    loop i <? surface[0].length {
        hidden[0].push(surface[0].ptr[i])
        i=i + 1
    }
    let nd=out[0].length
    let nh=hidden[0].length - hstart
    if found >=? 0 {
        let f=fams[0].ptr + found
        f[0].gen=gen
        f[0].decls=start
        f[0].ndecls=nd
        f[0].hidden=hstart
        f[0].nhidden=nh
        return
    }
    if name >=? cl_in[0].named_first[0].length {cl_in[0].host[0].named_grow(name)}
    fams[0].push(NamedFamily[cl_in[0].named_first[0].ptr[name] mod cur gen start nd hstart nh])
    cl_in[0].named_first[0].ptr[name]=fams[0].length
}

# SHA-256 and SHA-1 (FIPS 180-4): a macOS program's code signature hashes each page,
# its LC_UUID is a hash of its code, and an app bundle's CodeResources seals its icon
# with both (SHA-1 is the older hash it keeps beside SHA-256).
#
# A module of the compiler written in Dewy. sha.jo is its frozen twin for the
# compilers without the Dewy frontend (tools/compiler/build.py); the two keep the same
# interface and give the same digests (tests/test_selfhost_sha.py).
$runtime_checks

Word32:type=uint32<overflow='wrap'>
Word64:type=uint64<overflow='wrap'>

const SHA_K:array<Word32 length=64>=[
    0x428a2f98 0x71374491 0xb5c0fbcf 0xe9b5dba5 0x3956c25b 0x59f111f1 0x923f82a4 0xab1c5ed5
    0xd807aa98 0x12835b01 0x243185be 0x550c7dc3 0x72be5d74 0x80deb1fe 0x9bdc06a7 0xc19bf174
    0xe49b69c1 0xefbe4786 0x0fc19dc6 0x240ca1cc 0x2de92c6f 0x4a7484aa 0x5cb0a9dc 0x76f988da
    0x983e5152 0xa831c66d 0xb00327c8 0xbf597fc7 0xc6e00bf3 0xd5a79147 0x06ca6351 0x14292967
    0x27b70a85 0x2e1b2138 0x4d2c6dfc 0x53380d13 0x650a7354 0x766a0abb 0x81c2c92e 0x92722c85
    0xa2bfe8a1 0xa81a664b 0xc24b8b70 0xc76c51a3 0xd192e819 0xd6990624 0xf40e3585 0x106aa070
    0x19a4c116 0x1e376c08 0x2748774c 0x34b0bcb5 0x391c0cb3 0x4ed8aa4a 0x5b9cca4f 0x682e6ff3
    0x748f82ee 0x78a5636f 0x84c87814 0x8cc70208 0x90befffa 0xa4506ceb 0xbef9a3f7 0xc67178f2
]

# x twice over: its low 32 bits shifted right n are x rotated right n. Each sigma below
# shifts one of these three times, rather than rotating x three times.
sha_dup=(x:Word32):>Word64=>Word64(x) | (Word64(x) << 32)

sha_rotr=(x:Word32 n:int64):>Word32=>Word32(sha_dup(x) >> n)

# fold the 64-byte block data[at..at + 64) into hs (w: room for the message schedule)
sha256_block=(@hs:array<Word32> @w:array<Word32 length=64> data:array<uint8> at:int64):>void=>{
    # (the block's big-endian words)
    loop t in [0..16) {
        let q:int64=at + t * 4
        w[t]=(Word32(data[q]) << 24) | (Word32(data[q + 1]) << 16) | (Word32(data[q + 2]) << 8) | Word32(data[q + 3])
    }
    loop t in [16..64) {
        let x0=w[t - 15]
        let d0=sha_dup(x0)
        let x1=w[t - 2]
        let d1=sha_dup(x1)
        let s0=Word32((d0 >> 7) xor (d0 >> 18)) xor (x0 >> 3)
        let s1=Word32((d1 >> 17) xor (d1 >> 19)) xor (x1 >> 10)
        w[t]=w[t - 16] + s0 + w[t - 7] + s1
    }
    let a=hs[0]
    let b=hs[1]
    let c=hs[2]
    let d=hs[3]
    let e=hs[4]
    let f=hs[5]
    let g=hs[6]
    let h=hs[7]
    loop t in [0..64) {
        let de=sha_dup(e)
        let t1=h + Word32((de >> 6) xor (de >> 11) xor (de >> 25)) + (g xor (e & (f xor g))) + SHA_K[t] + w[t]
        let da=sha_dup(a)
        let t2=Word32((da >> 2) xor (da >> 13) xor (da >> 22)) + ((a & (b | c)) | (b & c))
        h=g
        g=f
        f=e
        e=d + t1
        d=c
        c=b
        b=a
        a=t1 + t2
    }
    hs[0]+=a
    hs[1]+=b
    hs[2]+=c
    hs[3]+=d
    hs[4]+=e
    hs[5]+=f
    hs[6]+=g
    hs[7]+=h
}

# the message's last block or two: b[start..stop), 0x80, zeros, then its length in bits
sha_tail=(b:array<uint8> start:int64 stop:int64 n:int64):>array<uint8>=>{
    let tail:array<uint8>=[]
    loop i in [start..stop) {tail.push(b[i])}
    tail.push(0x80)
    loop tail.length % 64 not=? 56 {tail.push(0)}
    let bits:int64=n * 8
    loop k in [0..8) {tail.push(uint8((bits >> (56 - 8 * k)) & 255))}
    tail
}

# the digest: each word, big-endian
sha_digest=(hs:array<Word32>):>array<uint8>=>{
    let out:array<uint8>=[]
    loop x in hs {
        loop k in [0..4) {out.push(uint8((x >> (24 - 8 * k)) & 255))}
    }
    out
}

# the SHA-256 of b[off..off + n)
sha256=(b:array<uint8> off:int64 n:int64):>array<uint8>=>{
    let hs:array<Word32>=[0x6a09e667 0xbb67ae85 0x3c6ef372 0xa54ff53a 0x510e527f 0x9b05688c 0x1f83d9ab 0x5be0cd19]
    let w:array<Word32 length=64>=fill(Word32(0) 64)
    let full:int64=n // 64
    loop k in [0..full) {sha256_block(@hs @w b off + k * 64)}
    let tail=sha_tail(b off + full * 64 off + n n)
    loop k in [0..tail.length // 64) {sha256_block(@hs @w tail k * 64)}
    sha_digest(hs)
}

sha1_block=(@hs:array<Word32> @w:array<Word32 length=80> data:array<uint8> at:int64):>void=>{
    # (the block's big-endian words)
    loop t in [0..16) {
        let q:int64=at + t * 4
        w[t]=(Word32(data[q]) << 24) | (Word32(data[q + 1]) << 16) | (Word32(data[q + 2]) << 8) | Word32(data[q + 3])
    }
    loop t in [16..80) {w[t]=sha_rotr(w[t - 3] xor w[t - 8] xor w[t - 14] xor w[t - 16] 31)}
    let a=hs[0]
    let b=hs[1]
    let c=hs[2]
    let d=hs[3]
    let e=hs[4]
    loop t in [0..80) {
        let f:Word32=if t <? 20 (b & c) | ((not b) & d) else if t <? 40 b xor c xor d else if t <? 60 (b & c) | (b & d) | (c & d) else b xor c xor d
        let k:Word32=if t <? 20 0x5A827999 else if t <? 40 0x6ED9EBA1 else if t <? 60 0x8F1BBCDC else 0xCA62C1D6
        let x=sha_rotr(a 27) + f + e + k + w[t]
        e=d
        d=c
        c=sha_rotr(b 2)
        b=a
        a=x
    }
    hs[0]+=a
    hs[1]+=b
    hs[2]+=c
    hs[3]+=d
    hs[4]+=e
}

# the SHA-1 of b
sha1=(b:array<uint8>):>array<uint8>=>{
    let hs:array<Word32>=[0x67452301 0xEFCDAB89 0x98BADCFE 0x10325476 0xC3D2E1F0]
    let w:array<Word32 length=80>=fill(Word32(0) 80)
    let n=b.length
    let full:int64=n // 64
    loop k in [0..full) {sha1_block(@hs @w b k * 64)}
    let tail=sha_tail(b full * 64 n n)
    loop k in [0..tail.length // 64) {sha1_block(@hs @w tail k * 64)}
    sha_digest(hs)
}

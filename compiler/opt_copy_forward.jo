use 'ir.jo'
use 'ir_builders.dewy'
use 'opt.jo'

# A final register copy before leaving one arm does not execute on its sibling
# path. Restore that register's version there, then invalidate it at the real
# join. The bounded recognizer handles the common cursor/counter update without
# snapshotting optimizer state or adding a control-flow pass.

o_copy_forward = ():
    if ir.raw_mem or ir.slot_size.len() == 0: return
    code = data(ir.code)
    n = ir.code.len()
    has_prev = false
    prev_a = i32(0)
    prev_imm = 0
    found = false
    loop i in [0..n):
        p = code + i
        op = p.op
        if op == .copy:
            if has_prev and p.b == prev_a and p.imm == prev_imm:
                found = true
                break
            has_prev = true
            prev_a = p.a
            prev_imm = p.imm
        else if has_prev and (not o_defines(op) or kills_memory(op)): has_prev = false
    if not found: return
    nv = ir.vtypes.len()
    ns = ir.slot_size.len()
    ndef = fill(0, nv)
    nuse = fill(0, nv)
    slot = fill(-1, nv)
    addresses = fill(0, ns)
    args = data(ir.args)
    loop i in [0..n):
        p = code + i
        d = ir_operands(p[0])
        if d >= 0: ndef[d] += 1
        loop k in [0..ir_use_count): nuse[ir_use(k)] += 1
        op = p.op
        if op == .slot:
            slot[int(p.dst)] = int(p.a)
            addresses[int(p.a)] += 1
        else if op == .zeroslots:
            a0 = int(p.a)
            loop k in [0..int(p.b)):
                item = int(args[a0 + k])
                if item & 1 == 1: ndef[item >> 1] += 1
    previous = -1
    sizes = data(ir.slot_size)
    loop i in [0..n):
        p = code + i
        op = p.op
        if op != .copy:
            if previous >= 0 and (not o_defines(op) or kills_memory(op)): previous = -1
            continue
        first_pos = previous
        previous = i
        if first_pos < 0: continue
        first = code + first_pos
        tmp = int(p.b)
        src = int(first.b)
        dst = int(p.a)
        if tmp != int(first.a) or p.imm != first.imm or tmp < 0 or src < 0 or dst < 0: continue
        t = slot[tmp]
        s = slot[src]
        d = slot[dst]
        if t < 0 or s < 0 or d < 0 or t == s or t == d or s == d: continue
        if ndef[tmp] != 1 or ndef[src] != 1 or ndef[dst] != 1 or nuse[tmp] != 2 or addresses[t] != 1: continue
        if p.imm != int(sizes[t]) or p.imm != int(sizes[s]) or p.imm != int(sizes[d]): continue
        first.op = .nop
        p.b = first.b

# Dewy's `+` never joins text or containers: interpolation or `join` for text, a spread literal
# for containers (`+` on arrays is reserved for elementwise math)
concat_piece = (n: int, text: bool, second: bool = false) -> str:
    k = nodes[n].kind
    if text and k == .str_lit and nodes[n].aux == 0 and nkids(n) == 0:
        s = name_of(int(nodes[n].sval))
        if find(s, "\"") < 0 and find(s, "\\") < 0 and find(s, "\{") < 0 and find(s, "}") < 0 and find(s, "\n") < 0: return s
    nm = ""
    if k == .ident: nm = name_of(int(nodes[n].name))
    else if k == .field and nodes[n].aux == -2 and nodes[int(nodes[n].a)].kind == .ident: nm = "{name_of(int(nodes[int(nodes[n].a)].name))}[{nodes[n].ival}]"
    else if k == .field and nodes[int(nodes[n].a)].kind == .ident: nm = name_of(int(nodes[int(nodes[n].a)].name)) + "." + name_of(int(nodes[n].name))
    else if k == .int_lit: nm = "{nodes[n].ival}"
    else if k == .call and nkids(n) <= 1:
        # (d.keys, as written, or as its library function: __dewy_keys(d))
        c = int(nodes[n].a)
        if nkids(n) == 0 and nodes[c].kind == .field and nodes[int(nodes[c].a)].kind == .ident: nm = name_of(int(nodes[int(nodes[c].a)].name)) + "." + name_of(int(nodes[c].name))
        else if nkids(n) == 1 and nodes[c].kind == .ident and nodes[kid(n, 0)].kind == .ident: nm = name_of(int(nodes[kid(n, 0)].name)) + "." + shown_fn_name(name_of(int(nodes[c].name)))
        else if nkids(n) == 1 and c == 0 and nodes[n].sym > 0 and int(nodes[n].sym) < fns.len() and fns[int(nodes[n].sym)].decl != 0 and nodes[kid(n, 0)].kind == .ident: nm = name_of(int(nodes[kid(n, 0)].name)) + "." + shown_fn_name(name_of(int(nodes[int(fns[int(nodes[n].sym)].decl)].name)))
    # (any other operand as written, `wrap(x "b")` or `line[2..]`, when it prints)
    if len(nm) == 0 and text: nm = wit_text(n)
    if len(nm) == 0 and text and fact_string_call(n) == 3: nm = concat_slice_text(n)
    if len(nm) == 0 or nm[0] == '$' or nm[0] == '_': nm = if text and second: "y" else if text: "x" else if second: "ys" else: "xs"
    if text: "\{{nm}}" else: nm
# A text slice as written, `line[2..]`, `s[a..b)`; "" when a part does not print.
concat_slice_text = (n: int) -> str:
    base = wit_text(kid(n, 0))
    start = wit_text(kid(n, 1))
    inclusive = nodes[kid(n, 3)].kind == .bool_lit and nodes[kid(n, 3)].ival != 0
    stop = nodes[kid(n, 4)].kind != .bool_lit or nodes[kid(n, 4)].ival != 0
    end = if stop: wit_text(kid(n, 2)) else: ""
    if base == "" or start == "" or stop and end == "": return ""
    if not stop: return "{base}[{start}..]"
    if inclusive: "{base}[{start}..{end}]" else: "{base}[{start}..{end})"
no_concat_error = (n: int, a: int, b: int, text: bool):
    if text:
        fatal(nodes[n].pos, "`+` does not join text: interpolate, `\"{concat_piece(a, true)}{concat_piece(b, true, true)}\"`, or join many pieces, `pieces.join`")
    ka = tkind(ntype(a))
    kb = tkind(ntype(b))
    if not ((ka == .array or ka == .fixed) and (kb == .array or kb == .fixed)):
        fatal(nodes[n].pos, "`+` is reserved for elementwise math on arrays, not yet defined: `.+` adds element by element (`xs .+ 1`), and a spread literal joins arrays, `[xs... ys...]`")
    fatal(nodes[n].pos, "`+` does not join arrays (on arrays it is reserved for elementwise math): spread them into one, `[{concat_piece(a, false)}... {concat_piece(b, false, true)}...]`; `.+` adds element by element")

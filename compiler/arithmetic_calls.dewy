$runtime_checks
from p"checker_call_queries.dewy" import (collect_fns)
from p"parser_ops.dewy" import (tok_ordinal)
from p"checks_thin.dewy" import (runtime_demand)
from p"checker_call_resolve.dewy" import (resolve_fn_call)
from p"refine_metadata.dewy" import (representation_type)
from p"checks_thin_expr.dewy" import (quantity_record_operand)
from p"unit_ops.dewy" import (quantity_arithmetic quantity_name_syntax)
from p"operator_lookup.dewy" import (op_overload)
from p"expression_types.dewy" import (ntype)
from p"member_receivers.dewy" import (is_struct_like)
from p"units.jo" import (is_quantity quantity_base quantity_left_literal quantity_right_literal)
from p"util.jo" import (intern)
from p"literal_context.dewy" import (finalize_literal is_lit)
from p"diagnostic_exit.dewy" import (fatal)
from p"facts.jo" import (fact_divisors)
from p"checker_exact.dewy" import (exact_math_operand exact_potential)
from p"exact_check_hooks.dewy" import (exact_int_result exact_type)
from p"rational_literals.dewy" import (exact_decimal rational_constant rational_constant_parts)
from p"checker_import_discovery.dewy" import (ensure_bundled_import)
from p"type_ops.dewy" import (dt int_policy)
from p"directive_rules.dewy" import (dir_panics_demanded)
from p"integer_call_folds.dewy" import (dewy_math_fold)
from p"checker_source_positions.dewy" import (dewy_at)
from p"checker_expr.dewy" import (check_expr)
from p"expr.jo" import (last_checked rational_constants rational_shown)
from p"coerce_expression.dewy" import (coerce)
from p"integer_conversions.dewy" import (integer_constant)
from p"coercion_queries.dewy" import (join_types num_join)
from p"unit_rare.dewy" import (calendar_period_why)
from p"rational_types.dewy" import (bundled_rational_type)
from p"numeric_library_types.dewy" import (bundled_bigint_type)
from p"checks_builders.dewy" import (bc_call bc_field bc_ident)
from p"checker_tokens.dewy" import (Tok)
from p"types.jo" import (T_INT T_MATH_INT is_float is_int is_numeric prune types)
from p"node_store.dewy" import (Node)
from p"ast.jo" import (NF_CHECKED NF_U64 add_flag has_flag mk nodes set_list)

ArithmeticCallsWord:type=int64<overflow='wrap'>

dewy_arithmetic_call=(n:int64 name:int64 args:array<int64> expected:int64):>int64=>$unsafe {
    let literal_divisor=nodes.ptr[args[1]].kind =? 'int_lit'
    # (t/°C: a unit written by name)
    let q_name_a=quantity_name_syntax(args[0])
    let q_name_b=quantity_name_syntax(args[1])
    let checked:array<int64>=[]
    loop i in 0.. and arg in args {
        let hint:ArithmeticCallsWord=0
        if i =? 0 and is_quantity(expected) and is_float(quantity_base(expected)) {hint=expected}
        if expected not=? 0 and is_float(expected) and nodes.ptr[arg].kind =? 'float_lit' {hint=expected}
        else if i =? 0 and expected not=? 0 and is_numeric(expected) and name not=? intern("__dewy_divide") {hint=expected}
        check_expr(arg hint);
        checked.push(last_checked)
        add_flag(last_checked NF_CHECKED)
    }
    let a=checked[0]
    let b=checked[1]
    if (ntype(a) =? T_MATH_INT or ntype(b) =? T_MATH_INT) and dewy_at(nodes.ptr[n].pos) {
        let wa=exact_math_operand(a)
        let wb=exact_math_operand(b)
        if is_int(ntype(wa)) and is_int(ntype(wb)) and ntype(wa) not=? T_MATH_INT and ntype(wb) not=? T_MATH_INT and int_policy(ntype(wa)) =? 0 and int_policy(ntype(wb)) =? 0 and num_join(ntype(wa) ntype(wb)) =? T_INT {
            a=wa; b = wb
            checked[0] = a; checked[1] = b
        }
    }
    let exact_operands=(is_numeric(ntype(a)) or bundled_rational_type(ntype(a)) or bundled_bigint_type(ntype(a))) and (is_numeric(ntype(b)) or bundled_rational_type(ntype(b)) or bundled_bigint_type(ntype(b)))
    if exact_operands and not is_float(expected) and not (is_float(ntype(a)) and not is_lit(a)) and not (is_float(ntype(b)) and not is_lit(b)) {
        if nodes.ptr[a].kind =? 'float_lit' and nodes.ptr[a].sval not=? 0 and is_lit(a) {exact_decimal(a);}
        if nodes.ptr[b].kind =? 'float_lit' and nodes.ptr[b].sval not=? 0 and is_lit(b) {exact_decimal(b);}
    }
    if (is_quantity(ntype(a)) or is_quantity(ntype(b))) and quantity_record_operand(prune(ntype(a)) prune(ntype(b))) {
        let op=if name =? intern("__dewy_divide") {"/"} else if name =? intern("__floor_div") {"//"} else if name =? intern("__floor_mod") {"%"} else {"**"}
        nodes[n] = Node(kind = 'binary' pos = nodes.ptr[n].pos a = int32<overflow='wrap'>(a) b = int32<overflow='wrap'>(b))
        let r=op_overload(n op)
        if r not=? 0 {return r}
        fatal(nodes.ptr[n].pos "operator {op} is not defined for {dt(ntype(a))} and {dt(ntype(b))}{calendar_period_why(a b)}")
    }
    if is_quantity(ntype(a)) or is_quantity(ntype(b)) {
        let quantity_left_literal_slot=@quantity_left_literal
        quantity_left_literal_slot=q_name_a
        let quantity_right_literal_slot=@quantity_right_literal
        quantity_right_literal_slot=q_name_b
        return quantity_arithmetic(n name a b expected)
    }
    if name =? intern("__dewy_divide") {
        let ta=prune(ntype(a))
        let tb=prune(ntype(b))
        let pos=nodes.ptr[n].pos
        if (is_int(ta) or bundled_bigint_type(ta)) and (is_int(tb) or bundled_bigint_type(tb)) {
            let [known_b divisor]=integer_constant(b)
            if known_b and divisor =? 0 {fatal(nodes.ptr[b].pos "division by zero: the divisor of `/` is the constant 0")}
            let [known_a dividend]=integer_constant(a)
            let minimum=-9223372036854775807 - 1
            if known_a and known_b and dividend not=? minimum and divisor not=? minimum and (dividend >=? 0 or types.ptr[ta].sign) and (divisor >=? 0 or types.ptr[tb].sign) {
                nodes[n] = nodes.ptr[rational_constant(dividend divisor pos shown = 2)]
                let t=check_expr(n expected)
                rational_constants[n] = rational_constant_parts(dividend divisor)
                rational_shown[n] = 2
                return t
            }
            # Resolve exact arithmetic only after the operand types are known;
            # ordinary floating division does not load either exact library.
            ensure_bundled_import("rational.dewy" "$dewy_rational" pos)
            let callee=bc_field(bc_ident("$dewy_rational" pos) "_fraction" pos)
            nodes[n] = Node(kind = 'call' pos = pos a = int32<overflow='wrap'>(callee))
            set_list(n checked)
            # (a nonzero divisor is the caller's obligation, as an integer
            # division's: the fraction's only failure)
            if dir_panics_demanded() {fact_divisors[n] = 1}
        }
        else {
            nodes[n] = Node(kind = 'binary' pos = pos op = 61 a = int32<overflow='wrap'>(a) b = int32<overflow='wrap'>(b))
        }
        return check_expr(n expected)
    }
    let modulo=name =? intern("__floor_mod")
    let power=name =? intern("__dewy_power")
    # (an integer base with a negative constant exponent is a rational: 2^(-2) is 1/(2^2))
    if power and (is_int(prune(ntype(a))) or bundled_bigint_type(prune(ntype(a)))) {
        let [known k]=integer_constant(b)
        if known and k <? 0 and k not=? -9223372036854775807 - 1 and types.ptr[representation_type(ntype(b))].sign {
            let pos=nodes.ptr[n].pos
            let exponent=mk('int_lit' pos)
            nodes[exponent].ival = -k
            let one=mk('int_lit' pos)
            nodes[one].ival = 1
            nodes[n] = nodes.ptr[bc_call("__dewy_divide" [one bc_call("__dewy_power" [a exponent] pos)] pos)]
            return check_expr(n expected)
        }
    }
    if is_struct_like(ntype(a)) or is_struct_like(ntype(b)) {
        let op=if power {"**"} else if modulo {"%"} else {"//"}
        nodes[n] = Node(kind = 'binary' pos = nodes.ptr[n].pos a = int32<overflow='wrap'>(a) b = int32<overflow='wrap'>(b))
        let result=op_overload(n op)
        if result =? 0 {
            let label=if power {"^"} else {op}
            fatal(nodes.ptr[n].pos "operator {label} is not defined for {dt(ntype(a))} and {dt(ntype(b))}")
        }
        return result
    }
    if is_numeric(ntype(a)) and is_numeric(ntype(b)) {
        if power {finalize_literal(a);}
        else {join_types(a b nodes.ptr[n].pos);}
        if dewy_math_fold(n a b power modulo) {return T_MATH_INT}
        # A word exponent must not select the wrapping word-base overload.
        if power and prune(ntype(a)) =? T_MATH_INT and is_int(ntype(b)) {coerce(b T_MATH_INT);}
    }
    # (`//` and `%` are integer and exact operations; floats have no floor quotient)
    if not power and (is_float(ntype(a)) or is_float(ntype(b))) {
        let ft=if is_float(ntype(a)) {ntype(a)} else {ntype(b)}
        if modulo {fatal(nodes.ptr[n].pos "`%` is not defined for {dt(ft)}: the remainder is an integer and exact-number operation")}
        fatal(nodes.ptr[n].pos "`//` is not defined for {dt(ft)}: floor division is an integer and exact-number operation; `(a / b).floor()` rounds a float quotient down")
    }
    # Only built-in arithmetic may replace a literal divisor with a shift or
    # mask. Custom protocols receive the original operand, including 1 or 2^k.
    let helper=name
    let policy=int_policy(ntype(a))
    if power and ntype(a) =? T_INT and dewy_at(nodes.ptr[n].pos) {
        let [known exponent]=integer_constant(b)
        if not known or exponent >=? 1048576 {
            coerce(a T_MATH_INT);
            coerce(b T_MATH_INT);
        }
    }
    if power and exact_type(ntype(a) nodes.ptr[n].pos) and is_int(ntype(b)) {
        let t=prune(ntype(a))
        if is_lit(b) and ntype(b) =? T_MATH_INT {
            [known exponent]=integer_constant(b)
            if known {coerce(b T_INT);}
        }
        nodes[n] = Node(kind = 'binary' pos = nodes.ptr[n].pos a = int32<overflow='wrap'>(a) b = int32<overflow='wrap'>(b) type = int32<overflow='wrap'>(t) op = 79 flags = int32<overflow='wrap'>(NF_CHECKED))
        return exact_int_result(n)
    }
    if policy not=? 0 or not power and exact_type(ntype(a) nodes.ptr[n].pos) {
        if power {helper=intern("__dewy_policy_power")}
        else {
            let t=prune(ntype(a))
            coerce(b t);
            if modulo and policy =? 0 and exact_potential(a) {
                let [known_modulus modulus]=integer_constant(b)
                if known_modulus and modulus >? 0 and modulus & (modulus - 1) not=? 0 {runtime_demand("__exact_i128_mod_pos")}
            }
            nodes[n] = Node(kind = 'binary' pos = nodes.ptr[n].pos a = int32<overflow='wrap'>(a) b = int32<overflow='wrap'>(b) type = int32<overflow='wrap'>(t) op = tok_ordinal(if modulo {Tok.percent} else {Tok.slash}) aux2 = -1 flags = int32<overflow='wrap'>(NF_CHECKED))
            return if policy =? 0 {exact_int_result(n)} else {t}
        }
    }
    let divisor=nodes.ptr[b].ival
    if not power and literal_divisor and nodes.ptr[b].kind =? 'int_lit' and divisor >? 0 and not has_flag(b NF_U64) and (divisor & (divisor - 1)) =? 0 {
        if modulo {
            helper=intern("__floor_mod_pow2")
            nodes[b].ival = divisor - 1
        }
        else {
            helper=intern("__floor_div_pow2")
            let shift:ArithmeticCallsWord=0
            loop divisor >? 1 {
                divisor=divisor >> 1
                shift += 1
            }
            nodes[b].ival = shift
            nodes[b].type = int32<overflow='wrap'>(T_INT) # generated shift count, not the divisor
        }
    }
    if nodes.ptr[n].a not=? 0 {nodes[ArithmeticCallsWord(nodes[n].a)].name = int32<overflow='wrap'>(helper)}
    let declarations:array<int64>=[]
    collect_fns(helper @declarations)
    let result=resolve_fn_call(n helper declarations checked expected)
    # Internal scalar policy: retain the builtin operation's captured actuals.
    # Custom operators and the proven positive power-of-two path are separate.
    if dir_panics_demanded() and not power and helper =? name and is_int(ntype(a)) and is_int(ntype(b)) {
        fact_divisors[n] = if modulo {2} else {1}
    }
    result
}

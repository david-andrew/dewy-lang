# Frozen bootstrap twin of refine_storage.dewy. Change both, or neither.
use 'checker_types.dewy'
use 'checker_services.dewy'
use 'refine_queries.dewy'

ref_types_storage = (types: mut TypeInfo[], structs: mut StructInfo[], fields: mut Field[], args: mut i32[], host: mut CheckerFieldsHost, t0: int) -> bool:
    seen: int[]
    ref_types_storage_visit(types, structs, fields, args, host, t0, seen)

ref_types_storage_visit = (types: mut TypeInfo[], structs: mut StructInfo[], fields: mut Field[], args: mut i32[], host: mut CheckerFieldsHost, t0: int, seen: mut int[]) -> bool:
    t = ref_query_prune(types, t0)
    if seen.contains(t): return false
    if seen.len() >= 32: return true
    k = types[t].kind
    if k == .refined: return true
    if k != .opt and k != .array and k != .fixed and k != .tuple and k != .struct_: return false
    seen.push(t)
    found = ref_types_storage_children(types, structs, fields, args, host, t, k, seen)
    seen.pop()
    found

ref_types_storage_children = (types: mut TypeInfo[], structs: mut StructInfo[], fields: mut Field[], args: mut i32[], host: mut CheckerFieldsHost, t: int, k: TK, seen: mut int[]) -> bool:
    if k == .opt or k == .array or k == .fixed: return ref_types_storage_visit(types, structs, fields, args, host, int(types[t].elem), seen)
    if k == .tuple:
        loop i in [0..int(types[t].nargs)):
            if ref_types_storage_visit(types, structs, fields, args, host, int(args[int(types[t].args) + i]), seen): return true
    if k == .struct_:
        si = int(types[t].st)
        if not structs[si].resolved: host.resolve_fields(si)
        loop i in [0..int(structs[si].nfields)):
            if ref_types_storage_visit(types, structs, fields, args, host, int(fields[int(structs[si].fields) + i].type), seen): return true
    false

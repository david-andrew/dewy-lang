use 'ownership_lower.dewy'
use 'lower_closures.dewy'
use 'lower_storage.dewy'
use 'lower_helpers.dewy'
use 'lower_group.dewy'
use 'checker_state.dewy'
use 'checker_tokens.dewy'
use 'checker_types.dewy'
# Source copy policy. Nothing is scanned unless a source module opts in.
# Cost is a property of the value, never of backend placement or optimization.
use 'lower.jo'
use 'isolation.jo'
use 'util.jo'
use 'ast.jo'
use 'lex.jo'
use 'check.jo'
use 'types.jo'
use 'expr.jo'
use 'ir.jo'
use 'ownership.jo'
use 'poly_closure.jo'
use 'directives.jo'
use 'arena.jo'
use 'ownership_types.dewy'
use 'ownership_checks.dewy'
use 'lower_primitives.dewy'
use 'lower_races.dewy'
use 'ir_builders.dewy'
use 'arena_ops.dewy'
use 'isolation_ops.dewy'
use 'copy_ops.dewy'

copies_on = false
copy_costs: {int: int}
copy_moves: {int: bool}
copy_blocked: {int: bool}
copy_explicit: {int: bool}
copy_inputs: {int: bool} # owned ABI: actual parameter local -> true
copy_bindings: {int: bool} # synthetic local initialized by ownership transfer
copy_loop_after: {int: bool}[]
copy_loop_back: {int: bool}[]
copy_proof_budget = -1
copy_fields: (int, str)[] # local and field path; negative liveness keys
copy_capture_nodes: {int: int[]} # only the function currently being lowered
copy_noenv: {int: bool}
# a name narrowed from a union or optional owner -> the local it narrows (its part is moved out of it)
copy_part_roots: {int: int}
copy_parts = false # (copy_part_roots is not empty: the hot ident walk reads only this)
# owning variables a match or `if let` declares for itself: fresh each loop iteration
copy_owner_hidden: int[]
copy_hidden = false # (copy_owner_hidden is not empty)
copy_borrowed: {int: bool} # analyzed parameter local whose snapshot binding stays borrowed


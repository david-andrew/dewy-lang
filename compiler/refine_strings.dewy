$runtime_checks

from p"checker_types.dewy" import TypeInfo, StructInfo, Variant
from p"checker_services.dewy" import CheckerInternHost
from p"node_store.dewy" import Node, node_mk, NODE_CHECKED

let ref_set_hashes:array<int64>=[]

ref_str_hash=(s:string):>int64=>$unsafe {
    let b=s as array<uint8>
    let n=b.length
    let p=b.ptr
    let h:int64<overflow='wrap'>=int64<overflow='wrap'>(0x811c9dc5) xor int64<overflow='wrap'>(n)
    loop i in [0..n) {
        h=(h xor int64<overflow='wrap'>(p[i])) * int64<overflow='wrap'>(0x01000193)
    }
    h
}

ref_set_sig=(values:array<string>):>int64=>$unsafe {
    let vn=values.length
    let vp=values.ptr
    let x:int64<overflow='wrap'>=0
    let sum:int64<overflow='wrap'>=0
    loop i in [0..vn) {
        let h=int64<overflow='wrap'>(ref_str_hash(vp[i]))
        x=x xor h
        sum=sum + h
    }
    (x xor (sum * int64<overflow='wrap'>(0x9e3779b1))) xor (int64<overflow='wrap'>(vn) << 48)
}

# The owner lends all published arenas. Preserve first-spelled set order and
# the existing O(S * M^2) membership search; only a new set calls the host.
ref_string_set_type=(@sets:array<array<string>> @set_types:array<int64> @types:array<TypeInfo> @structs:array<StructInfo> @variants:array<Variant> @host:CheckerInternHost field_count:int64 values:array<string>):>int64=>$unsafe {
    let id:int64=0
    let vn=values.length
    let vp=values.ptr
    let vh=ref_set_sig(values)
    if ref_set_hashes.length not=? sets.length {
        ref_set_hashes.clear()
        loop i in [0..sets.length) {ref_set_hashes.push(ref_set_sig(sets.ptr[i]))}
    }
    let hp=ref_set_hashes.ptr
    loop i in [1..sets.length) {
        if hp[i] not=? vh {continue}
        let si=sets.ptr[i]
        if si.length =? vn {
            let sp=si.ptr
            let same=true
            loop j in [0..vn) {
                if sp[j] not=? vp[j] {same=false; break}
            }
            if not same {
                same=true
                loop j in [0..vn) {
                    if not si.contains(vp[j]) {same=false; break}
                }
            }
            if same {id=i; break}
        }
    }
    if id =? 0 {
        sets.push(values)
        set_types.push(0)
        ref_set_hashes.push(vh)
        id=sets.length - 1
    }
    if set_types.ptr[id] not=? 0 {return set_types.ptr[id]}
    let vs=sets.ptr[id]
    let vsp=vs.ptr
    let vlen=vs.length
    let text=""
    if vlen >? 0 {
        let total:int64=vlen * 2 + (vlen - 1) * 3
        loop i in [0..vlen) {total += (vsp[i] as array<uint8>).length}
        let buf:array<uint8>=fill(uint8(0) total)
        let bp=buf.ptr
        let off:int64=0
        loop i in [0..vlen) {
            if i >? 0 {
                bp[off]=32
                bp[off + 1]=124
                bp[off + 2]=32
                off += 3
            }
            bp[off]=39
            off += 1
            let sb=vsp[i] as array<uint8>
            if sb.length >? 0 {
                mem_copy(bp + off sb.ptr sb.length)
                off += sb.length
            }
            bp[off]=39
            off += 1
        }
        text=buf as string ?? ""
    }
    let si=StructInfo[name=text resolved=true lit_set=int32(id) variants=int32(variants.length) nvariants=int32(values.length)]
    if vlen >? 0 {variants.reserve(variants.length + vlen)}
    loop i in [0..vlen) {
        let name=host.intern_name(sets.ptr[id].ptr[i])
        variants.push(Variant[name=int32(name) fields=int32(field_count) tag=int32(i) value=i])
    }
    let idx=structs.length
    structs.push(si)
    types.push(TypeInfo[kind='enum_' st=int32(idx)])
    structs.ptr[idx].type=int32(types.length - 1)
    set_types.ptr[id]=types.length - 1
    types.length - 1
}

# Construct the checked enum value directly, without a per-field host accessor.
ref_string_set_const=(@sets:array<array<string>> @set_types:array<int64> @store:array<Node> @host:CheckerInternHost id:int64 i:int64 pos:int64):>int64=>{
    let c=node_mk(@store 'dotname' pos)
    let name=host.intern_name(sets[id][i])
    store[c].name=int32(name)
    store[c].aux=int32(i)
    store[c].type=int32(set_types[id])
    store[c].flags=int32(int64(store[c].flags) | NODE_CHECKED)
    c
}

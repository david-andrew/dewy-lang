from p"facts_index_proofs.dewy" import (fact_storage_loop)
$runtime_checks
from p"checker_narrow_writes.dewy" import (alias_global)
from p"expression_types.dewy" import (ntype)

from p"lower_scalars.dewy" import (all_const)
from p"lower.jo" import (BOX_HDR LF_ELEMENTVIEW LF_HELDVIEW VC_AGG VC_INT comprehension_push_index cur_fn fixed_paths held_views hv_bad hv_cand hv_given hv_lambda opt_release scope_locals uniq_globals uniq_locals)
from p"expr.jo" import (IN)
from p"check.jo" import (LF_ADDR LF_ALIAS LF_ASSIGNED LF_BYREF LF_CAPTURE LF_CAPTURED LF_EXPOSED LF_MUTPARAM LF_PARAM LF_SHARED fns global_ids globals init_fns locals modules)
from p"ast.jo" import (NF_ALIASDECL NF_COMPREHENSION NF_GLOBAL NF_INBOUNDS NF_INCLUSIVE NF_MUT NF_STEP add_flag clear_flag has_flag kid kid2 kids lists mk nkids nkids2 nodes set_list)
from p"types.jo" import (TF_BOXED)
from p"types.jo" import (T_INT T_MATH_INT is_int prune telem tkind type_eq types)
from p"type_ops.dewy" import (is_managed type_has_fn)
from p"checked_eval.dewy" import (cx_token_values)
from p"ir.jo" import (VI dbg_on)
from p"callback_ops.dewy" import (callback_local)
from p"lower_analysis.dewy" import (checked_call_mutmask lpath_key lpath_root path_within place_var raw_view)
from p"copies.jo" import (copies_on copy_bindings copy_inputs)
from p"copy_ops.dewy" import (copy_strict)
from p"facts_index_proofs.dewy" import (fixed_array_len stable_loop_index word_integer_value)
from p"util.jo" import (files pos_file)
from p"lower_storage.dewy" import (is_shared opt_has vc)
from p"ownership_types.dewy" import (ownership_type)

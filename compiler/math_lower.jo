use 'lower.jo'
use 'lex.jo'
use 'ast.jo'
use 'check.jo'
use 'types.jo'
use 'expr.jo'
use 'ir.jo'
use 'util.jo'
use 'facts.jo'
use 'refine.jo'

# Boundary values occupy one register. Even words encode signed 63-bit
# integers; odd words own an immutable BigInt allocation. Word proofs keep
# nonescaping locals untagged and convert only at these boundaries.
math_word = (word: int) -> Val:
    if is_kv(word):
        value = kv_of(word)
        if value >= -4611686018427387904 and value <= 4611686018427387903:
            return V(e_iconst(value << 1), false)
        return math_call("__mi_word", [word])
    out = vreg(VI)
    tagged = e_bin(.shl, VI, word, e_iconst(1))
    iff(e_bin(.eq, VI, e_bin(.shrs, VI, tagged, e_iconst(1)), word))
    e_mov(out, tagged)
    els()
    old = ir_cold
    ir_cold = true
    e_mov(out, e_call(rt("__mi_word"), [word], VI))
    ir_cold = old
    endc()
    V(out, true)

# Existing scalar domains prove narrow inputs fit the immediate payload.
# Local/range upper bounds are demanded only at an actual tagged boundary.
math_pack_word = (e: int, word: int) -> Val:
    t = representation_type(ntype(e))
    if t != T_MATH_INT and is_int(t) and types[t].bits < 63:
        bound = fact_domain(t)
        if bound.lo >= -4611686018427387904 and bound.hi <= 4611686018427387903:
            return V(e_bin(.shl, VI, word, e_iconst(1)), false)
    limit = positive_bound(e, true)
    if limit >= 0 and limit <= 4611686018427387903: return V(e_bin(.shl, VI, word, e_iconst(1)), false)
    math_word(word)

math_call = (name: str, args: int[], result: int = 0) -> Val:
    t = if result == 0: T_MATH_INT else: result
    if vc(t) != VC_AGG: return V(e_call(rt(name), args, vt_of(t)), true)
    s = new_temp(t)
    a = e_slot(s)
    e_zero(a, tsize(t))
    e_call(rt(name), [a] + args, -1)
    Val(a, true, s)

math_payload_type = () -> int:
    f = runtime_fn("__mi_payload")
    mk_array(telem(prune(int(fns[f].ret))))

math_tag = (a: int) -> int: e_bin(.and_, VI, a, e_iconst(1))
math_untag = (a: int) -> int: e_bin(.shrs, VI, a, e_iconst(1))

math_signed = (a: int) -> int:
    result = vreg(VI)
    e_mov(result, math_untag(a))
    iff(math_tag(a))
    old = ir_cold
    ir_cold = true
    e_mov(result, e_call(rt("__mi_signed"), [a], VI))
    ir_cold = old
    endc()
    result

math_count = (e: int) -> int:
    if prune(ntype(e)) == T_MATH_INT and math_proven_word(e): return math_word_expr(e)
    value = gen_expr(e)
    borrow(value, ntype(e))
    if prune(ntype(e)) == T_MATH_INT: return math_signed(value.v)
    value.v

math_compare = (op: Tok, a: int, b: int) -> int:
    result = vreg(VI)
    tag = math_tag(e_bin(.or_, VI, a, b))
    iff(e_bin(.eq, VI, tag, e_iconst(0)))
    e_mov(result, e_bin(int_op(op, true), VI, a, b))
    els()
    old = ir_cold
    ir_cold = true
    comparison = e_call(rt("__mi_compare"), [a, b], VI)
    e_mov(result, e_bin(int_op(op, true), VI, comparison, e_iconst(0)))
    ir_cold = old
    endc()
    result

math_binary = (op: Tok, a: int, b: int) -> Val:
    out = vreg(VI)
    e_mov(out, e_iconst(0))
    tag = math_tag(e_bin(.or_, VI, a, b))
    operation = if op == .plus: 0 else if op == .minus: 1 else if op == .star: 2 else if op == .slash: 3 else if op == .percent: 4 else if op == .amp: 5 else if op == .pipe: 6 else: 7
    blk()
    done = ctl
    iff(e_bin(.eq, VI, tag, e_iconst(0)))
    x = a
    y = b
    if op == .star: x = math_untag(a)
    if op == .slash or op == .percent:
        x = math_untag(a)
        y = math_untag(b)
    result = 0
    bad = e_iconst(0)
    if op == .plus or op == .minus:
        result = e_bin(int_op(op, true), VI, x, y)
        if not target_wasm:
            bad = e_bin((if op == .plus: Op.overflow_add else: Op.overflow_sub), VI, x, y)
        else:
            left = e_bin(.xor, VI, x, result)
            right = e_bin(.xor, VI, (if op == .plus: y else: x), (if op == .plus: result else: y))
            bad = e_bin(.lts, VI, e_bin(.and_, VI, left, right), e_iconst(0))
    else if op == .star:
        result = e_bin(.mul, VI, x, y)
        if not target_wasm:
            bad = e_bin(.overflow_mul, VI, x, y)
        else:
            bad = vreg(VI)
            e_mov(bad, e_iconst(0))
            iff(e_bin(.eq, VI, x, e_iconst(-1)))
            e_mov(bad, e_bin(.eq, VI, y, e_iconst(-9223372036854775807 - 1)))
            els()
            iff(e_bin(.ne, VI, x, e_iconst(0)))
            e_mov(bad, e_bin(.ne, VI, e_bin(.divs, VI, result, x), y))
            endc()
            endc()
    else if op == .slash or op == .percent:
        bad = e_bin(.or_, VI, e_bin(.eq, VI, y, e_iconst(0)), e_bin(.and_, VI, e_bin(.eq, VI, x, e_iconst(-4611686018427387904)), e_bin(.eq, VI, y, e_iconst(-1))))
        # The hardware division must remain inside the proven-safe arm.
    else: result = e_bin(int_op(op, true), VI, x, y)
    iff(e_bin(.eq, VI, bad, e_iconst(0)))
    if op == .slash or op == .percent: result = e_bin(int_op(op, true), VI, x, y)
    if op == .slash or op == .percent: result = e_bin(.shl, VI, result, e_iconst(1))
    e_mov(out, result)
    br_to(done)
    endc()
    endc()
    # Both source values are still live here, including their original words.
    old = ir_cold
    ir_cold = true
    e_mov(out, e_call(rt("__mi_slow"), [a, b, e_iconst(operation)], VI))
    ir_cold = old
    endc()
    V(out, true)

math_shift = (op: Tok, a: int, count: int, signed_count: bool) -> Val:
    if signed_count: math_int_guard(e_bin(.lts, VI, count, e_iconst(0)))
    out = vreg(VI)
    e_mov(out, e_iconst(0))
    blk()
    done = ctl
    iff(e_bin(.eq, VI, math_tag(a), e_iconst(0)))
    x = a
    iff(e_bin(.geu, VI, count, e_iconst(64)))
    if op == .shr:
        e_mov(out, e_bin(.and_, VI, e_bin(.shrs, VI, x, e_iconst(63)), e_iconst(-2)))
        br_to(done)
    else:
        brif_to(e_bin(.eq, VI, x, e_iconst(0)), done)
    els()
    result = e_bin(int_op(op, true), VI, x, count)
    if op == .shl: iff(e_bin(.eq, VI, e_bin(.shrs, VI, result, count), x))
    if op == .shr: result = e_bin(.and_, VI, result, e_iconst(-2))
    e_mov(out, result)
    br_to(done)
    if op == .shl: endc()
    endc()
    endc()
    old = ir_cold
    ir_cold = true
    e_mov(out, e_call(rt("__mi_shift"), [a, count, e_iconst(int(op == .shr))], VI))
    ir_cold = old
    endc()
    V(out, true)

math_main = (f: int):
    helper_params(0)
    ir.ret = VI
    a = e_call(lf_of_inst(f), [], VI)
    result = math_signed(a)
    release(a, T_MATH_INT)
    e_ret(result)

math_word_bound = (e: int) -> bool:
    if e == 0: return false
    t = prune(ntype(e))
    if t != T_MATH_INT: return is_int(t) and (types[t].sign or int(types[t].bits) < 64)
    if nodes[e].kind == .int_lit: return not has_flag(e, NF_U64) or nodes[e].ival >= 0
    if nodes[e].kind == .conv and nodes[e].aux == i32(int(CV.int_)): return math_word_bound(int(nodes[e].a))
    false

math_word_range = (s: int) -> bool:
    it = int(nodes[s].a)
    if not math_word_bound(int(nodes[it].a)) or not math_word_bound(int(nodes[it].b)): return false
    if has_flag(it, NF_STEP): return math_word_bound(int(nodes[it].c))
    true

# Unknown bounds may themselves have promoted. Keep the hidden counter exact;
# changing the exposed loop variable never changes the range's progression.
math_loop_slot = () -> int:
    slot = new_temp(T_MATH_INT)
    l = locals.len()
    locals.push(Local(type = i32(T_MATH_INT), owner = i32(cur_fn), offset = i32(slot)))
    scope_add_local(l)
    address = e_slot(slot)
    e_zero(address, 8)
    address

gen_math_for = (s: int):
    it = int(nodes[s].a)
    l = int(nodes[s].sym)
    # Scope ownership also releases promoted bounds on return and outer break.
    ctr = math_loop_slot()
    endv = math_loop_slot()
    step = math_loop_slot()
    stmt_begin()
    e_store(ctr, 0, gen_owned(int(nodes[it].a)).v, 8)
    open_end = nodes[it].b == 0
    if not open_end: e_store(endv, 0, gen_owned(int(nodes[it].b)).v, 8)
    if has_flag(it, NF_STEP):
        second = gen_borrowed(int(nodes[it].c)).v
        e_store(step, 0, math_binary(.minus, second, e_load(VI, ctr, 0, 8)).v, 8)
    else: e_store(step, 0, math_word(e_iconst(1)).v, 8)
    zero = math_word(e_iconst(0)).v
    iff(math_compare(.eq, e_load(VI, step, 0, 8), zero))
    e_call_nr(rt("__panic"), [e_daddr(str_data("range step must be nonzero"))], -1)
    endc()
    up = math_compare(.gt, e_load(VI, step, 0, 8), zero)
    stmt_end()
    scope_add_local(l)
    blk()
    brk = ctl
    lop()
    top = ctl
    if not open_end:
        inclusive = has_flag(it, NF_INCLUSIVE)
        iff(up)
        brif_to(math_compare((if inclusive: Tok.gt else: Tok.ge), e_load(VI, ctr, 0, 8), e_load(VI, endv, 0, 8)), brk)
        els()
        brif_to(math_compare((if inclusive: Tok.lt else: Tok.le), e_load(VI, ctr, 0, 8), e_load(VI, endv, 0, 8)), brk)
        endc()
    target = local_place(l, true)
    release(read_place(target, T_MATH_INT), T_MATH_INT)
    value = e_load(VI, ctr, 0, 8)
    retain(value, T_MATH_INT)
    write_place(target, T_MATH_INT, value)
    blk()
    cont = ctl
    loops.push(LoopInfo(brk, cont, scope_locals.len(), tl_items.len(), building.len()))
    gen_loop_body(int(nodes[s].b))
    loops.pop()
    endc()
    next = math_binary(.plus, e_load(VI, ctr, 0, 8), e_load(VI, step, 0, 8))
    drop_at(ctr, T_MATH_INT)
    e_store(ctr, 0, next.v, 8)
    br_to(top)
    endc()
    endc()

# Local representation proofs are scoped to an unmodified bounded induction
# variable. Semantic types and escaping values still use the stable boundary.
math_word_regs: {int: int}

math_proven_word = (e: int) -> bool:
    if math_word_updates.has(e): return true
    if math_word_bound(e): return true
    if nodes[e].kind == .ident and nodes[e].aux == i32(int(SK.local)) and math_word_regs.has(int(nodes[e].sym)): return true
    if positive_bound(e, true) >= 0: return true
    if math_word_helper(e) > 0: return true
    if nodes[e].kind == .binary and nodes[e].aux == 0:
        op = nodes[e].op as Tok
        if op == .amp or op == .pipe or op == .caret:
            return math_proven_word(int(nodes[e].a)) and math_proven_word(int(nodes[e].b))
    false

math_word_expr = (e: int) -> int:
    if prune(ntype(e)) != T_MATH_INT: return gen_expr(e).v
    k = nodes[e].kind
    if k == .int_lit: return e_iconst(nodes[e].ival)
    if k == .ident and nodes[e].aux == i32(int(SK.local)):
        if let word = math_word_regs.get(int(nodes[e].sym)): return word
    if k == .conv and nodes[e].aux == i32(int(CV.int_)): return math_word_expr(int(nodes[e].a))
    if k == .unary and nodes[e].op == i32(int(Tok.minus)): return e_un(.neg, VI, math_word_expr(int(nodes[e].a)))
    if k == .if_:
        result = vreg(VI)
        iff(gen_expr(int(nodes[e].a)).v)
        e_mov(result, math_word_expr(math_value_arm(int(nodes[e].b))))
        els()
        e_mov(result, math_word_expr(math_value_arm(int(nodes[e].c))))
        endc()
        return result
    helper = math_word_helper(e)
    if helper > 0:
        a = if helper == 1: math_low_word(kid(e, 0)) else: math_word_expr(kid(e, 0))
        b = e_iconst(nodes[kid(e, 1)].ival)
        if helper == 1: return e_bin(.and_, VI, a, b)
        if helper == 2: return e_bin(.shrs, VI, a, b)
        r = e_bin(.rems, VI, a, b)
        if helper == 3:
            result = vreg(VI)
            e_mov(result, r)
            iff(e_bin(.lts, VI, r, e_iconst(0)))
            e_mov(result, e_bin(.add, VI, r, b))
            endc()
            return result
        result = vreg(VI)
        e_mov(result, e_bin(.divs, VI, a, b))
        iff(e_bin(.lts, VI, r, e_iconst(0)))
        e_mov(result, e_addi(result, -1))
        endc()
        return result
    if k == .binary and nodes[e].aux == 0:
        if nodes[e].op == i32(int(Tok.amp)):
            return e_bin(.and_, VI, math_low_word(int(nodes[e].a)), math_low_word(int(nodes[e].b)))
        a = math_word_expr(int(nodes[e].a))
        b = math_word_expr(int(nodes[e].b))
        return e_bin(int_op(nodes[e].op as Tok, true), VI, a, b)
    math_signed(gen_borrowed(e).v)

math_word_helper = (e: int) -> int:
    if nodes[e].kind != .call or nodes[e].aux != 0 or nkids(e) != 2: return 0
    f = int(nodes[e].sym)
    if f <= 0 or prune(int(fns[f].ret)) != T_MATH_INT: return 0
    d = int(fns[f].decl)
    if d == 0 or files[pos_file(nodes[d].pos)].path != lib_dir + "/math_int.jo": return 0
    b = kid(e, 1)
    if nodes[b].kind != .int_lit or nodes[b].ival < 0 or has_flag(b, NF_U64): return 0
    name = name_of(int(nodes[d].name))
    if name == "__floor_mod_pow2": return 1
    if not math_proven_word(kid(e, 0)): return 0
    if name == "__floor_div_pow2": return 2
    if nodes[b].ival == 0: return 0
    if name == "__floor_mod": return 3
    if name == "__floor_div": return 4
    0

math_low_word = (e: int) -> int:
    if math_proven_word(e): return math_word_expr(e)
    value = gen_borrowed(e).v
    result = vreg(VI)
    e_mov(result, math_untag(value))
    iff(math_tag(value))
    old = ir_cold
    ir_cold = true
    e_mov(result, e_call(rt("__mi_low_word"), [value], VI))
    ir_cold = old
    endc()
    result

math_shift_count = (e: int) -> int:
    if prune(ntype(e)) != T_MATH_INT or math_proven_word(e): return math_count(e)
    e_call(rt("__mi_count"), [gen_borrowed(e).v], VI)

# Structural representation proofs, deliberately limited to one local and its
# lexical suffix. A local cannot escape by address/capture. Every write is
# inspected; nested-loop updates and multiple increment sites are rejected.
math_word_limits: {int: int}
math_word_updates: {int: bool}

math_local_is = (n: int, l: int) -> bool:
    nodes[n].kind == .ident and nodes[n].aux == i32(int(SK.local)) and nodes[n].sym == i32(l)

# Build the write index only when a mutable mathematical local demands it.
# Loop ancestry is relative to each declaration, including declarations inside
# an outer loop; sibling scopes cannot refer to that declaration.
math_writes_ready = false
math_has_mutable = false
math_writes: {int: (int, int)[]}
math_decl_depth: {int: int}
math_loop_sites: {int: int}

math_prepare_writes = ():
    if math_writes_ready: return
    math_writes_ready = true
    positive_bounds_fn = cur_fn
    positive_bounds.clear()
    enclosing: int[]
    # Finalization already visited these bodies. Replay only writes and
    # control boundaries, evaluating bounds with the current lowering state.
    if fns[cur_fn].writes_ready:
        loop n in fns[cur_fn].write_sites:
            if n < 0: enclosing.pop()
            else: math_index_site(n, enclosing)
    else: math_index_writes(int(fns[cur_fn].body), enclosing)

math_index_writes = (n: int, enclosing: mut int[]):
    if n == 0: return
    k = nodes[n].kind
    is_loop = k == .for_ or k == .while_
    math_index_site(n, enclosing)
    if k == .lambda or k == .fn_: return
    math_index_writes(int(nodes[n].a), enclosing)
    math_index_writes(int(nodes[n].b), enclosing)
    if k != .for_:
        math_index_writes(int(nodes[n].c), enclosing)
        if k != .partial: math_index_writes(int(nodes[n].d), enclosing)
    loop i in [0..nkids(n)): math_index_writes(kid(n, i), enclosing)
    loop i in [0..nkids2(n)): math_index_writes(kid2(n, i), enclosing)
    if is_loop: enclosing.pop()

math_index_site = (n: int, enclosing: mut int[]):
    k = nodes[n].kind
    is_loop = k == .for_ or k == .while_
    if enclosing.len() > 0 and (is_loop or k == .lambda or k == .fn_ or k == .return_ or k == .break_ or k == .continue_):
        math_loop_sites[enclosing[enclosing.len() - 1]] = -1
    if k == .lambda or k == .fn_: return
    positive_write(n)
    if k == .vardecl and nkids(n) == 0 and not has_flag(n, NF_GLOBAL):
        l = int(nodes[n].sym)
        if l > 0 and prune(int(locals[l].type)) == T_MATH_INT: math_decl_depth[l] = enclosing.len()
    if k == .assign:
        a = int(nodes[n].a)
        if nodes[a].kind == .ident and nodes[a].aux == i32(int(SK.local)):
            l = int(nodes[a].sym)
            if enclosing.len() > 0 and prune(ntype(a)) == T_MATH_INT:
                loop_ = enclosing[enclosing.len() - 1]
                old = math_loop_sites.get(loop_) ?? 0
                math_loop_sites[loop_] = if old == 0: n else: -1
            if let depth = math_decl_depth.get(l):
                loop_ = if enclosing.len() == depth: 0 else if enclosing.len() == depth + 1: enclosing[depth] else: -1
                writes = math_writes.get(l) ?? []
                writes.push((n, loop_))
                math_writes[l] = writes
    if is_loop: enclosing.push(n)


math_update_value = (s: int, l: int) -> int:
    if nodes[s].op != i32(int(Tok.assign)) or nodes[s].aux != 0: return 0
    e = int(nodes[s].b)
    if nodes[e].kind != .binary or nodes[e].aux != 0 or not math_local_is(int(nodes[e].a), l): return 0
    e

math_counter_limit = (s: int, writes: (int, int)[]) -> int:
    l = int(nodes[s].sym)
    init = int(nodes[s].b)
    if nodes[init].kind != .int_lit or nodes[init].ival != 0: return -1
    increased = false
    limit = 0
    loop pair in writes:
        update = math_update_value(pair.0, l)
        loop_ = pair.1
        if update == 0 or loop_ <= 0: return -1
        rhs = int(nodes[update].b)
        if nodes[rhs].kind != .int_lit or has_flag(rhs, NF_U64): return -1
        amount = nodes[rhs].ival
        if nodes[update].op == i32(int(Tok.plus)):
            if increased or amount != 1 or nodes[loop_].kind != .for_ or nodes[loop_].aux != 0: return -1
            it = int(nodes[loop_].a)
            start = int(nodes[it].a)
            if nodes[start].kind != .int_lit or nodes[start].ival != 0 or has_flag(it, NF_STEP) or has_flag(it, NF_INCLUSIVE) or not math_word_range(loop_): return -1
            limit = positive_bound(int(nodes[it].b), true)
            if limit < 0: limit = 9223372036854775807
            increased = true
        else if nodes[update].op == i32(int(Tok.minus)):
            if amount < 0 or nodes[loop_].kind != .while_: return -1
            cond = int(nodes[loop_].a)
            if nodes[cond].kind != .binary or nodes[cond].aux != 0 or not math_local_is(int(nodes[cond].a), l): return -1
            bound = int(nodes[cond].b)
            if nodes[bound].kind != .int_lit or has_flag(bound, NF_U64) or nodes[bound].ival < 0: return -1
            floor = nodes[bound].ival
            if nodes[cond].op == i32(int(Tok.gt)) and floor < 9223372036854775807: floor += 1
            else if nodes[cond].op != i32(int(Tok.ge)): return -1
            if amount > floor: return -1
            # The guard only protects one update in each iteration.
            loop other in writes:
                if other.1 == loop_ and other.0 != pair.0: return -1
        else: return -1
    if increased: return limit
    -1

math_length_counter_limit = (s: int, writes: (int, int)[]) -> int:
    if writes.len() != 1: return -1
    l = int(nodes[s].sym)
    update = math_update_value(writes[0].0, l)
    loop_ = writes[0].1
    if update == 0 or loop_ <= 0 or nodes[loop_].kind != .while_ or nodes[update].op != i32(int(Tok.plus)): return -1
    init = positive_bound(int(nodes[s].b), true)
    step = positive_bound(int(nodes[update].b), true)
    if init < 0 or step < 0: return -1
    cond = int(nodes[loop_].a)
    if nodes[cond].kind != .binary or nodes[cond].aux != 0 or nodes[cond].op != i32(int(Tok.lt)) or not math_local_is(int(nodes[cond].a), l): return -1
    end = positive_bound(int(nodes[cond].b), true)
    if end <= 0 or step > 9223372036854775807 - end: return -1
    max(init, end + step)

math_word_local_decl = (s: int) -> bool:
    l = int(nodes[s].sym)
    if prune(int(locals[l].type)) != T_MATH_INT or dbg_on: return false
    fl = int(locals[l].flags)
    if fl & (LF_PARAM | LF_MUTPARAM | LF_CAPTURE | LF_CAPTURED | LF_ALIAS | LF_BYREF | LF_ADDR | LF_SHARED | LF_QUIET | LF_EXPOSED | LF_SOAELEM | LF_ELEMALIAS) != 0: return false
    init = int(nodes[s].b)
    if init == 0 or not math_proven_word(init): return false
    limit = positive_bound(init, true)
    writes: (int, int)[]
    if fl & LF_ASSIGNED != 0:
        if cur_block == 0 or kid(cur_block, cur_block_i) != s: return false
        math_prepare_writes()
        writes = math_writes.get(l) ?? []
        if writes.len() == 0: return false
        limit = math_counter_limit(s, writes)
        if limit < 0: limit = math_length_counter_limit(s, writes)
        if limit < 0 and not math_decrement_counter(s, writes): return false
    word = vreg(VI)
    e_mov(word, math_word_expr(init))
    math_word_regs[l] = word
    if limit >= 0: math_word_limits[l] = limit
    loop pair in writes: math_word_updates[int(nodes[pair.0].b)] = true
    true

# A strict comparison against any word establishes room for subtracting one,
# even when the comparison's lower bound is negative. Do not claim positivity.
math_decrement_counter = (s: int, writes: (int, int)[]) -> bool:
    if writes.len() != 1: return false
    l = int(nodes[s].sym)
    update = math_update_value(writes[0].0, l)
    loop_ = writes[0].1
    if update == 0 or loop_ <= 0 or nodes[loop_].kind != .while_ or nodes[update].op != i32(int(Tok.minus)): return false
    step = int(nodes[update].b)
    if nodes[step].kind != .int_lit or nodes[step].ival != 1: return false
    cond = int(nodes[loop_].a)
    if nodes[cond].kind != .binary or nodes[cond].aux != 0: return false
    a = int(nodes[cond].a)
    b = int(nodes[cond].b)
    if nodes[cond].op == i32(int(Tok.gt)): return math_local_is(a, l) and math_proven_word(b)
    if nodes[cond].op == i32(int(Tok.lt)): return math_local_is(b, l) and math_proven_word(a)
    false

# A nonescaping integer result immediately consumed as a float needs no tagged
# temporary. The word arm still checks overflow; the cold arm computes the
# exact integer first and rounds it once, just like the ordinary conversion.
math_float_binary = (e: int, to: int) -> int:
    if nodes[e].kind != .binary or nodes[e].aux != 0 or target_wasm: return -1
    op = nodes[e].op as Tok
    if op != .plus and op != .minus and op != .star: return -1
    a = int(nodes[e].a)
    b = int(nodes[e].b)
    if not math_proven_word(a) or not math_proven_word(b): return -1
    x = freeze_scalar(math_word_expr(a), T_INT)
    y = math_word_expr(b)
    value = e_bin(int_op(op, true), VI, x, y)
    bad = 0
    if op == .star:
        bad = e_bin(.ne, VI, e_bin(.mulhs, VI, x, y), e_bin(.shrs, VI, value, e_iconst(63)))
    else:
        left = e_bin(.xor, VI, x, value)
        right = e_bin(.xor, VI, (if op == .plus: y else: x), (if op == .plus: value else: y))
        bad = e_bin(.lts, VI, e_bin(.and_, VI, left, right), e_iconst(0))
    out = vreg(VF)
    iff(e_bin(.eq, VI, bad, e_iconst(0)))
    e_mov(out, e_un(.i2f, VF, value))
    els()
    old = ir_cold
    ir_cold = true
    operation = if op == .plus: 0 else if op == .minus: 1 else: 2
    e_mov(out, e_call(rt("__mi_word_float"), [x, y, e_iconst(operation)], VF))
    ir_cold = old
    endc()
    if to == T_FLOAT: return out
    e_un(.f2f, VS, out)

math_versioning = false

math_value_arm = (b: int) -> int:
    if nodes[b].kind != .block or nodes[b].aux == 0 or nkids(b) != 1: return 0
    s = kid(b, 0)
    if nodes[s].kind != .exprstmt: return 0
    int(nodes[s].a)

# Absolute addend bound for the narrow accumulator pattern: constants, the
# stable induction variable, sign changes, and a conditional choosing them.
math_addend_bound = (e0: int, index: int, bound: int) -> int:
    e = word_integer_value(e0)
    if e == 0: return -1
    if math_local_is(e, index): return bound
    if nodes[e].kind == .int_lit and not has_flag(e, NF_U64) and nodes[e].ival != -9223372036854775807 - 1: return abs(nodes[e].ival)
    if nodes[e].kind == .unary and nodes[e].op == i32(int(Tok.minus)): return math_addend_bound(int(nodes[e].a), index, bound)
    if nodes[e].kind == .if_:
        a = math_addend_bound(math_value_arm(int(nodes[e].b)), index, bound)
        b = math_addend_bound(math_value_arm(int(nodes[e].c)), index, bound)
        if a >= 0 and b >= 0: return max(a, b)
    -1

math_accumulator_for = (s: int) -> bool:
    if not math_has_mutable or math_versioning or dbg_on or nodes[s].aux != 0: return false
    it = int(nodes[s].a)
    start = int(nodes[it].a)
    end = int(nodes[it].b)
    index = int(nodes[s].sym)
    if nodes[start].kind != .int_lit or nodes[start].ival != 0 or end == 0 or has_flag(it, NF_STEP) or has_flag(it, NF_INCLUSIVE): return false
    if not stable_loop_index(index) or not math_word_bound(end) or not plain_read(word_integer_value(end)): return false
    math_prepare_writes()
    site = math_loop_sites.get(s) ?? 0
    if site <= 0: return false
    l = int(nodes[int(nodes[site].a)].sym)
    active = false
    loop scope in scope_locals:
        if scope.contains(l): active = true
    if math_word_regs.has(l) or not active: return false
    flags = int(locals[l].flags)
    if flags & (LF_PARAM | LF_MUTPARAM | LF_CAPTURE | LF_CAPTURED | LF_ALIAS | LF_BYREF | LF_ADDR | LF_SHARED | LF_EXPOSED) != 0: return false
    update = math_update_value(site, l)
    if update == 0 or nodes[update].op != i32(int(Tok.plus)): return false
    # This inexpensive guard permits over two billion trips. Larger ranges,
    # existing big values, and sums too close to a word boundary stay exact.
    cap = 2147483647
    addend = int(nodes[update].b)
    bound = math_addend_bound(addend, index, cap)
    if bound < 0 or bound > 9223372036854775807 / cap: return false
    room = 9223372036854775807 - cap * bound
    place = local_place(l, true)
    initial = read_place(place, T_MATH_INT)
    word = math_untag(initial)
    guard = e_bin(.eq, VI, math_tag(initial), e_iconst(0))
    guard = e_bin(.and_, VI, guard, e_bin(.les, VI, math_count(end), e_iconst(cap)))
    guard = e_bin(.and_, VI, guard, e_bin(.and_, VI, e_bin(.ges, VI, word, e_iconst(-room)), e_bin(.les, VI, word, e_iconst(room))))
    saved_regs = math_word_regs
    saved_limits = math_word_limits
    saved_updates = math_word_updates
    iff(guard)
    acc = vreg(VI)
    e_mov(acc, word)
    math_word_regs[l] = acc
    math_word_updates[update] = true
    math_word_updates[addend] = true
    math_versioning = true
    math_fresh_loop_regs(s)
    gen_for(s)
    write_place(place, T_MATH_INT, math_word(acc).v)
    math_word_regs = saved_regs
    math_word_limits = saved_limits
    math_word_updates = saved_updates
    els()
    math_fresh_loop_regs(s)
    gen_for(s)
    math_versioning = false
    math_word_regs = saved_regs
    math_word_limits = saved_limits
    math_word_updates = saved_updates
    endc()
    true

# Distinct loop copies must not share scalar virtual registers: otherwise a
# later definition in the cold copy extends live intervals through hot calls.
math_fresh_loop_regs = (n: int):
    if n == 0: return
    k = nodes[n].kind
    if k == .lambda or k == .fn_: return
    if k == .vardecl or k == .for_:
        l = int(nodes[n].sym)
        if l > 0 and int(locals[l].owner) == cur_fn and locals[l].offset < 0 and int(locals[l].flags) & (LF_ALIAS | LF_BYREF | LF_CAPTURE | LF_PARAM) == 0:
            locals[l].vreg = i32(vreg(vt_of(int(locals[l].type))))
    math_fresh_loop_regs(int(nodes[n].a))
    math_fresh_loop_regs(int(nodes[n].b))
    if k != .for_:
        math_fresh_loop_regs(int(nodes[n].c))
        if k != .partial: math_fresh_loop_regs(int(nodes[n].d))
    loop i in [0..nkids(n)): math_fresh_loop_regs(kid(n, i))
    loop i in [0..nkids2(n)): math_fresh_loop_regs(kid2(n, i))

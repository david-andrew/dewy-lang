use 'exact_reset_loop.jo'
use 'ir_types.dewy'
use 'isolation.jo'
use 'watch.jo'
use 'checker_state.dewy'
use 'checker_tokens.dewy'
use 'facts.jo'
use 'exact.jo'
use 'lower.jo'
use 'lex.jo'
use 'ast.jo'
use 'check.jo'
use 'types.jo'
use 'expr.jo'
use 'ir.jo'
use 'util.jo'
use 'facts.jo'
use 'refine.jo'

# Boundary values occupy one register. Even words encode signed 63-bit
# integers; odd words own an immutable BigInt allocation. Word proofs keep
# nonescaping locals untagged and convert only at these boundaries.
math_word = (word: int) -> Val:
    if is_kv(word):
        value = kv_of(word)
        if value >= -4611686018427387904 and value <= 4611686018427387903:
            return V(e_iconst(value << 1), false)
        return math_call("__mi_word", [word])
    out = vreg(VI)
    tagged = e_bin(.shl, VI, word, e_iconst(1))
    iff(e_bin(.eq, VI, e_bin(.shrs, VI, tagged, e_iconst(1)), word))
    e_mov(out, tagged)
    els()
    old = ir_cold
    ir_cold = true
    e_mov(out, e_call(rt("__mi_word"), [word], VI))
    ir_cold = old
    endc()
    V(out, true)

# Existing scalar domains prove narrow inputs fit the immediate payload.
# Local/range upper bounds are demanded only at an actual tagged boundary.
math_pack_word = (e: int, word: int) -> Val:
    if exact_small_math(e) >= 0: return V(e_bin(.shl, VI, word, e_iconst(1)), false)
    t = representation_type(ntype(e))
    if t != T_MATH_INT and is_int(t) and types[t].bits < 63:
        bound = fact_domain(t)
        if bound.lo >= -4611686018427387904 and bound.hi <= 4611686018427387903:
            return V(e_bin(.shl, VI, word, e_iconst(1)), false)
    limit = positive_bound(e, true)
    if limit >= 0 and limit <= 4611686018427387903: return V(e_bin(.shl, VI, word, e_iconst(1)), false)
    math_word(word)

math_call = (name: str, args: int[], result: int = 0) -> Val:
    t = if result == 0: T_MATH_INT else: result
    if vc(t) != VC_AGG: return V(e_call(rt(name), args, vt_of(t)), true)
    s = new_temp(t)
    a = e_slot(s)
    e_zero(a, tsize(t))
    e_call(rt(name), [a] + args, -1)
    Val(a, true, s)

math_payload_type = () -> int:
    f = runtime_fn("__mi_payload")
    mk_array(telem(prune(int(fns[f].ret))))

math_tag = (a: int) -> int: e_bin(.and_, VI, a, e_iconst(1))
math_untag = (a: int) -> int: e_bin(.shrs, VI, a, e_iconst(1))

math_signed = (a: int) -> int:
    result = vreg(VI)
    e_mov(result, math_untag(a))
    iff(math_tag(a))
    old = ir_cold
    ir_cold = true
    e_mov(result, e_call(rt("__mi_signed"), [a], VI))
    ir_cold = old
    endc()
    result

math_count = (e: int) -> int:
    if prune(ntype(e)) == T_MATH_INT and math_proven_word(e): return math_word_expr(e)
    value = gen_expr(e)
    borrow(value, ntype(e))
    if prune(ntype(e)) == T_MATH_INT: return math_signed(value.v)
    value.v

math_compare = (op: Tok, a: int, b: int) -> int:
    result = vreg(VI)
    tag = math_tag(e_bin(.or_, VI, a, b))
    iff(e_bin(.eq, VI, tag, e_iconst(0)))
    e_mov(result, e_bin(int_op(op, true), VI, a, b))
    els()
    old = ir_cold
    ir_cold = true
    comparison = e_call(rt("__mi_compare"), [a, b], VI)
    e_mov(result, e_bin(int_op(op, true), VI, comparison, e_iconst(0)))
    ir_cold = old
    endc()
    result

math_binary = (op: Tok, a: int, b: int) -> Val:
    out = vreg(VI)
    e_mov(out, e_iconst(0))
    tag = math_tag(e_bin(.or_, VI, a, b))
    operation = if op == .plus: 0 else if op == .minus: 1 else if op == .star: 2 else if op == .slash: 3 else if op == .percent: 4 else if op == .amp: 5 else if op == .pipe: 6 else: 7
    blk()
    done = ctl
    iff(e_bin(.eq, VI, tag, e_iconst(0)))
    x = a
    y = b
    if op == .star: x = math_untag(a)
    if op == .slash or op == .percent:
        x = math_untag(a)
        y = math_untag(b)
    result = 0
    bad = e_iconst(0)
    if op == .plus or op == .minus:
        result = e_bin(int_op(op, true), VI, x, y)
        if not target_wasm:
            bad = e_bin((if op == .plus: Op.overflow_add else: Op.overflow_sub), VI, x, y)
        else:
            left = e_bin(.xor, VI, x, result)
            right = e_bin(.xor, VI, (if op == .plus: y else: x), (if op == .plus: result else: y))
            bad = e_bin(.lts, VI, e_bin(.and_, VI, left, right), e_iconst(0))
    else if op == .star:
        result = e_bin(.mul, VI, x, y)
        if not target_wasm:
            bad = e_bin(.overflow_mul, VI, x, y)
        else:
            bad = vreg(VI)
            e_mov(bad, e_iconst(0))
            iff(e_bin(.eq, VI, x, e_iconst(-1)))
            e_mov(bad, e_bin(.eq, VI, y, e_iconst(-9223372036854775807 - 1)))
            els()
            iff(e_bin(.ne, VI, x, e_iconst(0)))
            e_mov(bad, e_bin(.ne, VI, e_bin(.divs, VI, result, x), y))
            endc()
            endc()
    else if op == .slash or op == .percent:
        bad = e_bin(.or_, VI, e_bin(.eq, VI, y, e_iconst(0)), e_bin(.and_, VI, e_bin(.eq, VI, x, e_iconst(-4611686018427387904)), e_bin(.eq, VI, y, e_iconst(-1))))
        # The hardware division must remain inside the proven-safe arm.
    else: result = e_bin(int_op(op, true), VI, x, y)
    iff(e_bin(.eq, VI, bad, e_iconst(0)))
    if op == .slash or op == .percent: result = e_bin(int_op(op, true), VI, x, y)
    if op == .slash or op == .percent: result = e_bin(.shl, VI, result, e_iconst(1))
    e_mov(out, result)
    br_to(done)
    endc()
    endc()
    # Both source values are still live here, including their original words.
    old = ir_cold
    ir_cold = true
    e_mov(out, e_call(rt("__mi_slow"), [a, b, e_iconst(operation)], VI))
    ir_cold = old
    endc()
    V(out, true)

math_shift = (op: Tok, a: int, count: int, signed_count: bool) -> Val:
    if signed_count: math_int_guard(e_bin(.lts, VI, count, e_iconst(0)))
    out = vreg(VI)
    e_mov(out, e_iconst(0))
    blk()
    done = ctl
    iff(e_bin(.eq, VI, math_tag(a), e_iconst(0)))
    x = a
    iff(e_bin(.geu, VI, count, e_iconst(64)))
    if op == .shr:
        e_mov(out, e_bin(.and_, VI, e_bin(.shrs, VI, x, e_iconst(63)), e_iconst(-2)))
        br_to(done)
    else:
        brif_to(e_bin(.eq, VI, x, e_iconst(0)), done)
    els()
    result = e_bin(int_op(op, true), VI, x, count)
    if op == .shl: iff(e_bin(.eq, VI, e_bin(.shrs, VI, result, count), x))
    if op == .shr: result = e_bin(.and_, VI, result, e_iconst(-2))
    e_mov(out, result)
    br_to(done)
    if op == .shl: endc()
    endc()
    endc()
    old = ir_cold
    ir_cold = true
    e_mov(out, e_call(rt("__mi_shift"), [a, count, e_iconst(int(op == .shr))], VI))
    ir_cold = old
    endc()
    V(out, true)

math_main = (f: int):
    helper_params(0)
    ir.ret = VI
    a = e_call(lf_of_inst(f), [], VI)
    result = math_signed(a)
    release(a, T_MATH_INT)
    e_ret(result)

math_word_bound = (e: int) -> bool:
    if e == 0: return false
    if e < exact_ranges.len() and exact_ranges[e] > 0 and exact_ranges[e] <= 64: return true
    # An expanded fixed-width expression keeps its storage type in the AST.
    # That type cannot justify discarding its high words at an int boundary.
    if exact_has_node(e):
        if exact_bits(e) <= 64: return true
        return not exact_count_bound(e).wide
    t = prune(ntype(e))
    if t != T_MATH_INT: return is_int(t) and (types[t].sign or int(types[t].bits) < 64)
    if nodes[e].kind == .int_lit: return not has_flag(e, NF_U64) or nodes[e].ival >= 0
    if not exact_count_bound(e).wide: return true
    if nodes[e].kind == .conv and nodes[e].aux == i32(int(CV.int_)): return math_word_bound(int(nodes[e].a))
    false

# (bounds proven to be words: a counter's loop over [i..i + 8) stays in words too)
math_word_range = (s: int) -> bool:
    it = int(nodes[s].a)
    if not math_proven_word(int(nodes[it].a)) or not math_proven_word(int(nodes[it].b)): return false
    if has_flag(it, NF_STEP): return math_proven_word(int(nodes[it].c))
    true

# Unknown bounds may themselves have promoted. Keep the hidden counter exact;
# changing the exposed loop variable never changes the range's progression.
math_loop_slot = () -> int:
    slot = new_temp(T_MATH_INT)
    l = locals.len()
    locals.push(Local(type = i32(T_MATH_INT), owner = i32(cur_fn), offset = i32(slot)))
    scope_add_local(l)
    address = e_slot(slot)
    e_zero(address, 8)
    address

gen_math_for = (s: int):
    it = int(nodes[s].a)
    l = int(nodes[s].sym)
    # Scope ownership also releases promoted bounds on return and outer break.
    ctr = math_loop_slot()
    endv = math_loop_slot()
    step = math_loop_slot()
    stmt_begin()
    e_store(ctr, 0, gen_owned(int(nodes[it].a)).v, 8)
    open_end = nodes[it].b == 0
    if not open_end: e_store(endv, 0, gen_owned(int(nodes[it].b)).v, 8)
    if has_flag(it, NF_STEP):
        second = gen_borrowed(int(nodes[it].c)).v
        e_store(step, 0, math_binary(.minus, second, e_load(VI, ctr, 0, 8)).v, 8)
    else: e_store(step, 0, math_word(e_iconst(1)).v, 8)
    zero = math_word(e_iconst(0)).v
    iff(math_compare(.eq, e_load(VI, step, 0, 8), zero))
    e_call_nr(rt("__panic"), [e_daddr(str_data("range step must be nonzero"))], -1)
    endc()
    up = math_compare(.gt, e_load(VI, step, 0, 8), zero)
    stmt_end()
    scope_add_local(l)
    blk()
    brk = ctl
    lop()
    top = ctl
    if not open_end:
        inclusive = has_flag(it, NF_INCLUSIVE)
        iff(up)
        brif_to(math_compare((if inclusive: Tok.gt else: Tok.ge), e_load(VI, ctr, 0, 8), e_load(VI, endv, 0, 8)), brk)
        els()
        brif_to(math_compare((if inclusive: Tok.lt else: Tok.le), e_load(VI, ctr, 0, 8), e_load(VI, endv, 0, 8)), brk)
        endc()
    target = local_place(l, true)
    release(read_place(target, T_MATH_INT), T_MATH_INT)
    value = e_load(VI, ctr, 0, 8)
    retain(value, T_MATH_INT)
    write_place(target, T_MATH_INT, value)
    blk()
    cont = ctl
    loops.push(LoopInfo(brk, cont, scope_locals.len(), tl_items.len(), building.len()))
    gen_loop_body(int(nodes[s].b))
    loops.pop()
    endc()
    next = math_binary(.plus, e_load(VI, ctr, 0, 8), e_load(VI, step, 0, 8))
    drop_at(ctr, T_MATH_INT)
    e_store(ctr, 0, next.v, 8)
    br_to(top)
    endc()
    endc()

# Local representation proofs are scoped to an unmodified bounded induction
# variable. Semantic types and escaping values still use the stable boundary.
# Immutable captured ints with a proven signed-word domain use a raw word in
# the private environment. Selection happens once at ordinary environment
# layout; generic shared layouts retain their established representation.
# The local-indexed table and cached initializer bounds cost O(captures +
# demanded initializer nodes), with no scan of unrelated function bodies.
math_word_captures: {int: bool}
math_prepare_capture = (l: int):
    if prune(int(locals[l].type)) != T_MATH_INT or dbg_on or watch_build: return
    fl = int(locals[l].flags)
    if fl & (LF_CAPTURE | LF_VALUECAP) != LF_CAPTURE | LF_VALUECAP or fl & (LF_ASSIGNED | LF_ADDR | LF_EXPOSED | LF_SHARED | LF_ALIAS | LF_BYREF | LF_OWNERBORROW | LF_PARTBORROW) != 0: return
    n = mk_ident_local(l, locals[l].pos)
    if not exact_count_bound(n).wide: math_word_captures[l] = true

math_word_regs: {int: int}

# Nonescaping int locals with finite source widths use a vector of registers.
# Demand starts at a declaration; its indexed writes must preserve the initial
# width. No growing recurrence is guessed. Expression traversal has a fixed
# depth budget, and width is capped at four words; other values stay tagged.
math_static_regs: {int: int[]}
math_static_widths: {int: int}

math_static_bits = (n: int, depth: int = 0) -> int:
    if n == 0 or depth > 32: return 0
    if math_proven_word(n): return 64
    if math_local_is(n, int(nodes[n].sym)):
        if let width = math_static_widths.get(int(nodes[n].sym)): return width
    if exact_has_node(n): return exact_bits(n)
    if is_int(ntype(n)) and prune(ntype(n)) != T_MATH_INT: return exact_bits(n)
    k = nodes[n].kind
    if k == .int_lit: return if has_flag(n, NF_U64) and nodes[n].ival < 0: 65 else: 64
    if k == .conv and (nodes[n].aux == i32(int(CV.int_)) or nodes[n].aux == i32(int(CV.none_))): return math_static_bits(int(nodes[n].a), depth + 1)
    if k == .binary and nodes[n].aux == 0:
        a = math_static_bits(int(nodes[n].a), depth + 1)
        b = math_static_bits(int(nodes[n].b), depth + 1)
        if a == 0 or b == 0: return 0
        op = nodes[n].op as Tok
        if op == .plus or op == .minus: return max(a, b) + 1
        if op == .star: return a + b
        if op == .amp or op == .pipe or op == .caret: return max(a, b)
    if k == .call and nodes[n].aux == 0:
        helper = fact_floor_call(n)
        if helper == 3 or helper == 4:
            a = math_static_bits(kid(n, 0), depth + 1)
            known, amount = integer_constant(kid(n, 1))
            if a > 0 and known and amount >= 0:
                if helper == 3: return max(1, a - amount)
                return min(a, exact_type_width(kid(n, 1)) / 2)
    if k == .unary:
        a = math_static_bits(int(nodes[n].a), depth + 1)
        return if a > 0: a + int(nodes[n].op == i32(int(Tok.minus))) else: 0
    if k == .block and nodes[n].aux != 0: return math_static_bits(block_value(n), depth + 1)
    if k == .if_:
        a = math_static_bits(int(nodes[n].b), depth + 1)
        b = math_static_bits(int(nodes[n].c), depth + 1)
        return if a > 0 and b > 0: max(a, b) else: 0
    0

math_static_value = (n: int) -> int[]:
    if math_local_is(n, int(nodes[n].sym)):
        if let words = math_static_regs.get(int(nodes[n].sym)):
            out: int[]
            loop word in words: out.push(freeze_scalar(word, T_INT))
            return out
    if math_proven_word(n): return [freeze_scalar(math_word_expr(n), T_INT)]
    if exact_has_node(n) or prune(ntype(n)) != T_MATH_INT: return exact_value(n)
    k = nodes[n].kind
    if k == .int_lit: return [e_iconst(nodes[n].ival), e_iconst(0)]
    if k == .conv: return math_static_value(int(nodes[n].a))
    count = (math_static_bits(n) + 63) / 64
    if k == .unary:
        words = math_static_value(int(nodes[n].a))
        if nodes[n].op == i32(int(Tok.minus)): return exact_neg(words, count)
        if nodes[n].op == i32(int(Tok.tilde)):
            loop i in [0..words.len()): words[i] = e_un(.not_, VI, words[i])
        return words
    if k == .binary:
        a = math_static_value(int(nodes[n].a)); b = math_static_value(int(nodes[n].b))
        op = nodes[n].op as Tok
        if op == .plus or op == .minus: return exact_add(a, b, count, op == .minus)
        if op == .star: return exact_mul(a, b, count)
        a = exact_extend(a, count); b = exact_extend(b, count)
        out: int[]
        loop i in [0..count): out.push(e_bin(int_op(op, true), VI, a[i], b[i]))
        return out
    if k == .call:
        a = math_static_value(kid(n, 0))
        known, amount = integer_constant(kid(n, 1))
        if fact_floor_call(n) == 4: return [e_bin(.and_, VI, a[0], e_iconst(amount))]
        return exact_extend(exact_shift_literal(a, amount, a.len(), true), count)
    if k == .block:
        scope_push()
        out: int[]
        loop i in [0..nkids(n)):
            statement = kid(n, i)
            if i == nkids(n) - 1:
                stmt_begin()
                loop word in math_static_value(int(nodes[statement].a)): out.push(freeze_scalar(word, T_INT))
                stmt_end()
            else: gen_stmt(statement)
        scope_pop()
        return out
    out: int[]
    loop i in [0..count): out.push(vreg(VI))
    iff(gen_expr(int(nodes[n].a)).v)
    yes = exact_extend(math_static_value(int(nodes[n].b)), count)
    loop i in [0..count): e_mov(out[i], yes[i])
    els()
    no = exact_extend(math_static_value(int(nodes[n].c)), count)
    loop i in [0..count): e_mov(out[i], no[i])
    endc()
    out

# A bounded reset guard observes only whether a fresh exact value is outside
# an interval of words. An overflow can use the interval's upper endpoint as
# a temporary representative: either value selects the reset arm. The sole
# write replaces it with a word before any other use can observe it.
# Demand is one nonescaping declaration; the existing local-indexed writes
# require one reset. At most eight following statements / 128 syntax nodes
# are inspected, O(1) bounded work per candidate and no whole-body read scan.
math_reset_unused = (n: int, l: int, budget: mut int) -> bool:
    if n == 0: return true
    budget -= 1
    if budget < 0: return false
    k = nodes[n].kind
    if math_local_is(n, l): return false
    if k == .lambda or k == .fn_ or k == .defer_ or k == .return_ or k == .break_ or k == .continue_ or k == .for_ or k == .while_: return false
    mask = isolation_children(k)
    if mask < 0: return false
    if mask & 1 != 0 and not math_reset_unused(int(nodes[n].a), l, budget): return false
    if mask & 2 != 0 and not math_reset_unused(int(nodes[n].b), l, budget): return false
    if mask & 4 != 0 and not math_reset_unused(int(nodes[n].c), l, budget): return false
    if mask & 16 != 0:
        loop child in kids(n):
            if not math_reset_unused(child, l, budget): return false
    if mask & 32 != 0:
        loop child in kids2(n):
            if not math_reset_unused(child, l, budget): return false
    true

math_reset_interval = (n: int, l: int) -> (bool, int):
    if nodes[n].kind != .or_: return (false, 0)
    left = int(nodes[n].a); right = int(nodes[n].b)
    if nodes[left].kind != .binary or nodes[right].kind != .binary or nodes[left].aux != 0 or nodes[right].aux != 0: return (false, 0)
    if nodes[left].op != i32(int(Tok.lt)) or nodes[right].op != i32(int(Tok.ge)): return (false, 0)
    if not math_local_is(word_integer_value(int(nodes[left].a)), l) or not math_local_is(word_integer_value(int(nodes[right].a)), l): return (false, 0)
    known_lo, lo = integer_constant(int(nodes[left].b))
    known_hi, hi = integer_constant(int(nodes[right].b))
    if not known_lo or not known_hi or lo >= hi or has_flag(int(nodes[left].b), NF_U64) or has_flag(int(nodes[right].b), NF_U64): return (false, 0)
    if exact_count_bound(int(nodes[left].b)).wide or exact_count_bound(int(nodes[right].b)).wide: return (false, 0)
    (true, hi)

math_reset_local_decl = (s: int) -> bool:
    l = int(nodes[s].sym)
    if prune(int(locals[l].type)) != T_MATH_INT or dbg_on or target_wasm or cur_block == 0 or kid(cur_block, cur_block_i) != s: return false
    fl = int(locals[l].flags)
    if fl & LF_ASSIGNED == 0 or fl & (LF_PARAM | LF_MUTPARAM | LF_CAPTURE | LF_CAPTURED | LF_ALIAS | LF_BYREF | LF_ADDR | LF_SHARED | LF_QUIET | LF_EXPOSED | LF_SOAELEM | LF_ELEMALIAS) != 0: return false
    init = word_integer_value(int(nodes[s].b))
    if nodes[init].kind != .binary or nodes[init].aux != 0: return false
    op = nodes[init].op as Tok
    if op != .plus and op != .minus and op != .star: return false
    a = int(nodes[init].a); b = int(nodes[init].b)
    if not math_proven_word(a) or not math_proven_word(b): return false
    math_prepare_writes()
    writes = math_writes.get(l) ?? []
    if writes.len() != 1 or writes[0].1 != 0: return false
    reset = writes[0].0
    if nodes[reset].op != i32(int(Tok.assign)) or nodes[reset].aux != 0 or not math_proven_word(int(nodes[reset].b)): return false
    budget = 128
    loop i in [cur_block_i + 1..min(nkids(cur_block), cur_block_i + 9)):
        next = kid(cur_block, i)
        if nodes[next].kind == .exprstmt: next = int(nodes[next].a)
        if nodes[next].kind == .if_:
            known, replacement = math_reset_interval(int(nodes[next].a), l)
            if known:
                otherwise = int(nodes[next].c)
                if otherwise != 0 and (nodes[otherwise].kind != .block or nkids(otherwise) != 0): return false
                body = int(nodes[next].b)
                if nodes[body].kind != .block or nkids(body) == 0 or kid(body, nkids(body) - 1) != reset: return false
                loop j in [0..nkids(body) - 1):
                    if not math_reset_unused(kid(body, j), l, budget): return false
                av = freeze_scalar(math_word_expr(a), T_INT)
                bv = freeze_scalar(math_word_expr(b), T_INT)
                word = vreg(VI)
                e_mov(word, e_bin((if op == .plus: Op.add else if op == .minus: Op.sub else: Op.mul), VI, av, bv))
                if not exr_fast or not exr_locals.contains(l):
                    iff(e_bin((if op == .plus: Op.overflow_add else if op == .minus: Op.overflow_sub else: Op.overflow_mul), VI, av, bv))
                    e_mov(word, e_iconst(replacement))
                    endc()
                math_word_regs[l] = word
                return true
        if not math_reset_unused(next, l, budget): return false
    false

math_static_local_decl = (s: int) -> bool:
    l = int(nodes[s].sym)
    if prune(int(locals[l].type)) != T_MATH_INT or dbg_on and exact_local_width(l) == 0: return false
    fl = int(locals[l].flags)
    if fl & (LF_PARAM | LF_MUTPARAM | LF_CAPTURE | LF_CAPTURED | LF_ALIAS | LF_BYREF | LF_ADDR | LF_SHARED | LF_QUIET | LF_EXPOSED | LF_SOAELEM | LF_ELEMALIAS) != 0: return false
    init = int(nodes[s].b)
    width = math_static_bits(init)
    if width <= 0 or width > 256: return false
    math_static_widths[l] = width
    if fl & LF_ASSIGNED != 0:
        math_prepare_writes()
        writes = math_writes.get(l) ?? []
        if writes.len() == 0:
            math_static_widths.remove(l)
            return false
        loop pair in writes:
            w = math_static_bits(int(nodes[pair.0].b))
            if nodes[pair.0].op != i32(int(Tok.assign)) or nodes[pair.0].aux != 0 or w <= 0 or w > width:
                math_static_widths.remove(l)
                return false
    words = exact_extend(math_static_value(init), (width + 63) / 64)
    regs: int[]
    loop word in words:
        r = vreg(VI)
        e_mov(r, word)
        regs.push(r)
    math_static_regs[l] = regs
    true

math_static_narrow = (n: int, to: int) -> Val:
    if to == T_INT and math_proven_word(n): return V(math_word_expr(n), false)
    # A direct word operation narrowed to int64 has the same checked IR as
    # fixed storage. Loop guards can discharge that boundary without tagging.
    if to == T_INT and nodes[n].kind == .binary and nodes[n].aux == 0:
        op = nodes[n].op as Tok
        a = int(nodes[n].a); b = int(nodes[n].b)
        if (op == .plus or op == .minus or op == .star) and math_proven_word(a) and math_proven_word(b):
            av = freeze_scalar(math_word_expr(a), T_INT); bv = math_word_expr(b)
            result = vreg(VI)
            emit((if op == .plus: Op.checked_add else if op == .minus: Op.checked_sub else: Op.checked_mul), VI, result, av, bv, 0, rt("__int_overflow"))
            return V(result, false)
    words = math_static_value(n)
    normalized = norm(words[0], to)
    bad = e_bin(.ne, VI, normalized, words[0])
    sign = if types[to].sign: e_bin(.shrs, VI, normalized, e_iconst(63)) else: e_iconst(0)
    loop i in [1..words.len()): bad = e_bin(.or_, VI, bad, e_bin(.ne, VI, words[i], sign))
    if not types[to].sign and words.len() == 1: bad = e_bin(.or_, VI, bad, e_bin(.lts, VI, words[0], e_iconst(0)))
    math_int_guard(bad)
    V(normalized, false)


math_proven_word = (e: int) -> bool:
    if math_word_updates.has(e): return true
    if math_word_bound(e): return true
    if nodes[e].kind == .ident and nodes[e].aux == i32(int(SK.local)) and math_word_regs.has(int(nodes[e].sym)): return true
    if positive_bound(e, true) >= 0: return true
    if math_word_helper(e) > 0: return true
    if nodes[e].kind == .binary and nodes[e].aux == 0:
        op = nodes[e].op as Tok
        if op == .amp or op == .pipe or op == .caret:
            return math_proven_word(int(nodes[e].a)) and math_proven_word(int(nodes[e].b))
        # (a difference of two values in [0, 2^63): within (-2^63, 2^63))
        if op == .minus: return positive_bound(int(nodes[e].a), true) >= 0 and positive_bound(int(nodes[e].b), true) >= 0
    false

# `x + k` compared with y, all words but the sum perhaps not: the sum in a word with its
# overflow flag. A sum past the largest word is greater than any word, and one past the
# smallest is less, so the comparison stays exact. -1 when e is not of that shape.
math_sum_compare = (e: int) -> int:
    op = nodes[e].op as Tok
    x = int(nodes[e].a)
    y = int(nodes[e].b)
    flipped = false
    if not math_sum_shape(x):
        if not math_sum_shape(y): return -1
        swap = x
        x = y
        y = swap
        flipped = true
    if not math_proven_word(y): return -1
    a = math_word_expr(int(nodes[x].a))
    k = math_word_expr(int(nodes[x].b))
    sum = e_bin(.add, VI, a, k)
    over = e_bin(.lts, VI, e_bin(.and_, VI, e_bin(.xor, VI, a, sum), e_bin(.xor, VI, k, sum)), e_iconst(0))
    w = math_word_expr(y)
    exact = if flipped: e_bin(int_op(op, true), VI, w, sum) else: e_bin(int_op(op, true), VI, sum, w)
    # (on overflow the sum is past the end its wrapped sign does not show)
    above = e_bin(.lts, VI, sum, e_iconst(0))
    beyond = 0
    if op == .eq: beyond = e_iconst(0)
    else if op == .ne: beyond = e_iconst(1)
    else:
        sum_greater = (op == .gt or op == .ge) != flipped
        beyond = if sum_greater: above else: e_bin(.eq, VI, above, e_iconst(0))
    r = vreg(VI)
    e_mov(r, exact)
    iff(over)
    e_mov(r, beyond)
    endc()
    r

math_sum_shape = (x: int) -> bool:
    nodes[x].kind == .binary and nodes[x].aux == 0 and nodes[x].op == i32(int(Tok.plus)) and prune(ntype(x)) == T_MATH_INT and math_proven_word(int(nodes[x].a)) and math_proven_word(int(nodes[x].b))

math_word_expr = (e: int) -> int:
    if prune(ntype(e)) != T_MATH_INT: return gen_expr(e).v
    k = nodes[e].kind
    if k == .int_lit: return e_iconst(nodes[e].ival)
    if k == .ident and nodes[e].aux == i32(int(SK.local)):
        l = int(nodes[e].sym)
        if let word = math_word_regs.get(l): return word
        if let words = math_static_regs.get(l): return words[0]
        if math_word_captures.has(l): return read_place(local_place(l, false), T_INT)
    if k == .conv and nodes[e].aux == i32(int(CV.int_)): return math_word_expr(int(nodes[e].a))
    if k == .unary and nodes[e].op == i32(int(Tok.minus)): return e_un(.neg, VI, math_word_expr(int(nodes[e].a)))
    if k == .if_:
        result = vreg(VI)
        iff(gen_expr(int(nodes[e].a)).v)
        e_mov(result, math_word_expr(math_value_arm(int(nodes[e].b))))
        els()
        e_mov(result, math_word_expr(math_value_arm(int(nodes[e].c))))
        endc()
        return result
    helper = math_word_helper(e)
    if helper > 0:
        a = if helper == 1: math_low_word(kid(e, 0)) else: math_word_expr(kid(e, 0))
        b = e_iconst(nodes[kid(e, 1)].ival)
        if helper == 1: return e_bin(.and_, VI, a, b)
        if helper == 2: return e_bin(.shrs, VI, a, b)
        if positive_bound(kid(e, 0), true) >= 0:
            return e_bin((if helper == 3: Op.remu else: Op.divu), VI, a, b)
        r = e_bin(.rems, VI, a, b)
        if helper == 3:
            result = vreg(VI)
            e_mov(result, r)
            iff(e_bin(.lts, VI, r, e_iconst(0)))
            e_mov(result, e_bin(.add, VI, r, b))
            endc()
            return result
        result = vreg(VI)
        e_mov(result, e_bin(.divs, VI, a, b))
        iff(e_bin(.lts, VI, r, e_iconst(0)))
        e_mov(result, e_addi(result, -1))
        endc()
        return result
    if k == .binary and nodes[e].aux == 0:
        if nodes[e].op == i32(int(Tok.amp)):
            a = freeze_scalar(math_low_word(int(nodes[e].a)), T_INT)
            return e_bin(.and_, VI, a, math_low_word(int(nodes[e].b)))
        a = freeze_scalar(math_word_expr(int(nodes[e].a)), T_INT)
        b = math_word_expr(int(nodes[e].b))
        return e_bin(int_op(nodes[e].op as Tok, true), VI, a, b)
    value = gen_borrowed(e).v
    if exact_small_math(e) >= 0: return math_untag(value)
    math_signed(value)

math_word_helper = (e: int) -> int:
    if nodes[e].kind != .call or nodes[e].aux != 0 or nkids(e) != 2: return 0
    f = int(nodes[e].sym)
    if f <= 0 or prune(int(fns[f].ret)) != T_MATH_INT: return 0
    d = int(fns[f].decl)
    if d == 0 or files[pos_file(nodes[d].pos)].path != lib_dir + "/math_int.jo": return 0
    b = kid(e, 1)
    if nodes[b].kind != .int_lit or nodes[b].ival < 0 or has_flag(b, NF_U64): return 0
    name = name_of(int(nodes[d].name))
    if name == "__floor_mod_pow2": return 1
    if not math_proven_word(kid(e, 0)): return 0
    if name == "__floor_div_pow2": return 2
    if nodes[b].ival == 0: return 0
    if name == "__floor_mod": return 3
    if name == "__floor_div": return 4
    0

math_low_word = (e: int) -> int:
    if math_proven_word(e): return math_word_expr(e)
    value = gen_borrowed(e).v
    result = vreg(VI)
    e_mov(result, math_untag(value))
    iff(math_tag(value))
    old = ir_cold
    ir_cold = true
    e_mov(result, e_call(rt("__mi_low_word"), [value], VI))
    ir_cold = old
    endc()
    result

math_shift_count = (e: int) -> int:
    if prune(ntype(e)) != T_MATH_INT or math_proven_word(e): return math_count(e)
    e_call(rt("__mi_count"), [gen_borrowed(e).v], VI)

# Structural representation proofs, deliberately limited to one local and its
# lexical suffix. A local cannot escape by address/capture. Every write is
# inspected; nested-loop updates and multiple increment sites are rejected.
math_word_limits: {int: int}
math_word_updates: {int: bool}

math_local_is = (n: int, l: int) -> bool:
    nodes[n].kind == .ident and nodes[n].aux == i32(int(SK.local)) and nodes[n].sym == i32(l)

# Build the write index only when a mutable mathematical local demands it.
# Loop ancestry is relative to each declaration, including declarations inside
# an outer loop; sibling scopes cannot refer to that declaration.
math_writes_ready = false
math_has_mutable = false
math_writes: {int: (int, int)[]}
math_decl_depth: {int: int}
math_loop_sites: {int: int}
math_write_loop: {int: int}     # a write of a mathematical local -> its innermost loop (0: none)
math_loop_parent: {int: int}    # a loop -> the loop it is in (0: none)

math_prepare_writes = ():
    if math_writes_ready: return
    math_writes_ready = true
    positive_bounds_fn = cur_fn
    positive_bounds.clear()
    enclosing: int[]
    positive_collecting_writes = true
    # Finalization already visited these bodies. Replay only writes and
    # control boundaries, evaluating bounds with the current lowering state.
    if fns[cur_fn].writes_ready:
        loop n in fns[cur_fn].write_sites:
            if n < 0: enclosing.pop()
            else: math_index_site(n, enclosing)
    else: math_index_writes(int(fns[cur_fn].body), enclosing)
    positive_collecting_writes = false

math_index_writes = (n: int, enclosing: mut int[]):
    if n == 0: return
    k = nodes[n].kind
    is_loop = k == .for_ or k == .while_
    math_index_site(n, enclosing)
    if k == .lambda or k == .fn_: return
    math_index_writes(int(nodes[n].a), enclosing)
    math_index_writes(int(nodes[n].b), enclosing)
    if k != .for_:
        math_index_writes(int(nodes[n].c), enclosing)
        if k != .partial: math_index_writes(int(nodes[n].d), enclosing)
    loop i in [0..nkids(n)): math_index_writes(kid(n, i), enclosing)
    loop i in [0..nkids2(n)): math_index_writes(kid2(n, i), enclosing)
    if is_loop: enclosing.pop()

math_index_site = (n: int, enclosing: mut int[]):
    k = nodes[n].kind
    is_loop = k == .for_ or k == .while_
    if enclosing.len() > 0 and (is_loop or k == .lambda or k == .fn_ or k == .return_ or k == .break_ or k == .continue_):
        math_loop_sites[enclosing[enclosing.len() - 1]] = -1
    if k == .lambda or k == .fn_: return
    positive_write(n)
    if k == .vardecl and nkids(n) == 0 and not has_flag(n, NF_GLOBAL):
        l = int(nodes[n].sym)
        if l > 0 and (prune(int(locals[l].type)) == T_MATH_INT or prune(int(locals[l].type)) == T_INT): math_decl_depth[l] = enclosing.len()
    if k == .assign:
        a = int(nodes[n].a)
        # Tuple writes use the ordinary place ABI. Record them as unsupported
        # writes so a direct assignment elsewhere cannot hide the mutation.
        if nodes[a].kind == .tuple:
            loop target in kids(a):
                if nodes[target].kind == .ident and nodes[target].aux == i32(int(SK.local)):
                    l = int(nodes[target].sym)
                    writes = math_writes.get(l) ?? []
                    writes.push((n, -2))
                    math_writes[l] = writes
        if nodes[a].kind == .ident and nodes[a].aux == i32(int(SK.local)):
            l = int(nodes[a].sym)
            if enclosing.len() > 0 and prune(ntype(a)) == T_MATH_INT:
                loop_ = enclosing[enclosing.len() - 1]
                old = math_loop_sites.get(loop_) ?? 0
                math_loop_sites[loop_] = if old == 0: n else: -1
            if let depth = math_decl_depth.get(l):
                loop_ = if enclosing.len() == depth: 0 else if enclosing.len() == depth + 1: enclosing[depth] else: -1
                math_write_loop[n] = if enclosing.len() > depth: enclosing[enclosing.len() - 1] else: 0
                writes = math_writes.get(l) ?? []
                writes.push((n, loop_))
                math_writes[l] = writes
    if is_loop:
        math_loop_parent[n] = if enclosing.len() > 0: enclosing[enclosing.len() - 1] else: 0
        enclosing.push(n)


math_update_value = (s: int, l: int) -> int:
    if nodes[s].op != i32(int(Tok.assign)) or nodes[s].aux != 0: return 0
    e = int(nodes[s].b)
    loop nodes[e].kind == .conv and (nodes[e].aux == i32(int(CV.fixed_store)) or nodes[e].aux == i32(int(CV.none_)) or nodes[e].aux == i32(int(CV.int_))): e = int(nodes[e].a)
    if nodes[e].kind != .binary or nodes[e].aux != 0 or not math_local_is(int(nodes[e].a), l): return 0
    e

math_counter_limit = (s: int, writes: (int, int)[]) -> int:
    l = int(nodes[s].sym)
    init = int(nodes[s].b)
    if nodes[init].kind != .int_lit or nodes[init].ival != 0: return -1
    increased = false
    limit = 0
    loop pair in writes:
        update = math_update_value(pair.0, l)
        loop_ = pair.1
        if update == 0 or loop_ <= 0: return -1
        rhs = int(nodes[update].b)
        if nodes[rhs].kind != .int_lit or has_flag(rhs, NF_U64): return -1
        amount = nodes[rhs].ival
        if nodes[update].op == i32(int(Tok.plus)):
            if increased or amount != 1 or nodes[loop_].kind != .for_ or nodes[loop_].aux != 0: return -1
            it = int(nodes[loop_].a)
            start = int(nodes[it].a)
            if nodes[start].kind != .int_lit or nodes[start].ival != 0 or has_flag(it, NF_STEP) or has_flag(it, NF_INCLUSIVE) or not math_word_range(loop_): return -1
            limit = positive_bound(int(nodes[it].b), true)
            if limit < 0: limit = 9223372036854775807
            increased = true
        else if nodes[update].op == i32(int(Tok.minus)):
            if amount < 0 or nodes[loop_].kind != .while_: return -1
            cond = int(nodes[loop_].a)
            if nodes[cond].kind != .binary or nodes[cond].aux != 0 or not math_local_is(int(nodes[cond].a), l): return -1
            bound = int(nodes[cond].b)
            if nodes[bound].kind != .int_lit or has_flag(bound, NF_U64) or nodes[bound].ival < 0: return -1
            floor = nodes[bound].ival
            if nodes[cond].op == i32(int(Tok.gt)) and floor < 9223372036854775807: floor += 1
            else if nodes[cond].op != i32(int(Tok.ge)): return -1
            if amount > floor: return -1
            # The guard only protects one update in each iteration.
            loop other in writes:
                if other.1 == loop_ and other.0 != pair.0: return -1
        else: return -1
    if increased: return limit
    -1

# A counter stepped up only in loops it guards: `loop i + k <? E { ... i += s }`, one
# update directly in each loop (several loops may share the counter: a word-at-a-time scan,
# then its tail; a token's loop inside a line's). The guard held at the start of the
# iteration; before the update only loops nested in this one changed i, so after it
# i <= max(E - k - 1, what those left) + s. From a nonnegative start, i stays in
# [0, the largest such bound]. O(writes x depth).
math_length_counter_limit = (s: int, writes: (int, int)[]) -> int:
    l = int(nodes[s].sym)
    limit = positive_bound(int(nodes[s].b), true)
    if limit < 0: return -1
    guarded: int[]
    loop pair in writes:
        update = math_update_value(pair.0, l)
        loop_ = math_write_loop.get(pair.0) ?? 0
        if update == 0 or pair.1 == 0 or loop_ <= 0 or nodes[loop_].kind != .while_ or nodes[loop_].aux == 1 or nodes[update].op != i32(int(Tok.plus)): return -1
        if guarded.contains(loop_): return -1
        guarded.push(loop_)
    loop pair in writes:
        after = math_counter_after(pair.0, l, writes)
        if after < 0: return -1
        limit = max(limit, after)
    limit

# the largest value of l after update w (in its loop's guard, after the updates in loops
# nested in that loop), or -1
math_counter_after = (w: int, l: int, writes: (int, int)[]) -> int:
    loop_ = math_write_loop[w]
    before = math_guard_limit(int(nodes[loop_].a), l)
    if before < 0: return -1
    loop pair in writes:
        if pair.0 == w or not math_loop_within(math_write_loop[pair.0], loop_): continue
        inner = math_counter_after(pair.0, l, writes)
        if inner < 0: return -1
        before = max(before, inner)
    step = positive_bound(int(nodes[math_update_value(w, l)].b), true)
    if step < 0 or step > 9223372036854775807 - before: return -1
    before + step

# is loop a nested (at any depth) in loop b, and not b itself?
math_loop_within = (a: int, b: int) -> bool:
    x = math_loop_parent.get(a) ?? 0
    loop x > 0:
        if x == b: return true
        x = math_loop_parent.get(x) ?? 0
    false

math_type_max = (t: int) -> int:
    if types[t].kind != .int_ or t == T_MATH_INT: return -1
    bits = int(types[t].bits)
    if types[t].sign: bits -= 1
    if bits > 63: return -1
    if bits == 63: return 9223372036854775807
    (1 << bits) - 1

# The largest value of local l for which loop condition c can hold, or -1 when c does not
# bound l from above: `l + k <? E` or `l + k <=? E` (k a nonnegative literal, E with a
# nonnegative bound), or a conjunction with one such side.
math_guard_limit = (c: int, l: int) -> int:
    if nodes[c].kind == .and_:
        a = math_guard_limit(int(nodes[c].a), l)
        b = math_guard_limit(int(nodes[c].b), l)
        if a >= 0 and b >= 0: return min(a, b)
        return max(a, b)
    if nodes[c].kind != .binary or nodes[c].aux != 0: return -1
    op = nodes[c].op as Tok
    if op != .lt and op != .le: return -1
    x = int(nodes[c].a)
    k = 0
    if nodes[x].kind == .binary and nodes[x].aux == 0 and nodes[x].op == i32(int(Tok.plus)):
        y = int(nodes[x].b)
        if nodes[y].kind != .int_lit or has_flag(y, NF_U64) or nodes[y].ival < 0: return -1
        k = nodes[y].ival
        x = int(nodes[x].a)
    if not math_local_is(x, l): return -1
    e = int(nodes[c].b)
    end = positive_bound(e, true)
    # (a fixed-width bound is at most its type's largest value)
    loop end < 0 and nodes[e].kind == .conv and nodes[e].aux == i32(int(CV.int_)): e = int(nodes[e].a)
    if end < 0 and prune(ntype(e)) != T_MATH_INT and not exact_has_node(e): end = math_type_max(prune(ntype(e)))
    if end < 0: return -1
    end -= k
    if op == .lt: end -= 1
    max(end, 0)

# Prove a word invariant from the indexed writes, including resetting counters:
# i = if i < limit i+1 else 0. Each update is guarded at the update itself, so
# multiple writes and nested loops are safe. O(written expression nodes), with
# no scan of unrelated statements and no assumptions about escaping locals.
math_guarded_word = (n0: int, l: int, condition: int = 0, holds: bool = true, depth: int = 0) -> bool:
    if depth > 32: return false
    n = n0
    loop nodes[n].kind == .conv and nodes[n].aux == i32(int(CV.int_)): n = int(nodes[n].a)
    if nodes[n].kind == .block and nodes[n].aux != 0:
        # Statements before the value may change the guarded local.
        if nkids(n) != 1: return false
        return math_guarded_word(block_value(n), l, condition, holds, depth + 1)
    if math_local_is(n, l): return true
    if nodes[n].kind == .if_:
        return math_guarded_word(int(nodes[n].b), l, int(nodes[n].a), true, depth + 1) and math_guarded_word(int(nodes[n].c), l, int(nodes[n].a), false, depth + 1)
    if math_proven_word(n): return true
    if condition == 0 or nodes[n].kind != .binary or nodes[n].aux != 0: return false
    op = nodes[n].op as Tok
    if op != .plus and op != .minus or not math_local_is(fact_progress_strip(int(nodes[n].a)), l): return false
    known, step = integer_constant(int(nodes[n].b))
    if not known or step != 1: return false
    if nodes[condition].kind != .binary or nodes[condition].aux != 0: return false
    cmp = nodes[condition].op as Tok
    a = fact_progress_strip(int(nodes[condition].a)); b = int(nodes[condition].b)
    if not math_local_is(a, l): return false
    if not plain_read(b) or not math_proven_word(b): return false
    if op == .plus: return holds and cmp == .lt or not holds and cmp == .ge
    holds and cmp == .gt or not holds and cmp == .le

# Prove [0, limit] inductive over every indexed write. Hypothetical bounds
# remain on this recursion's stack, never in the shared expression caches.
# O(written expression edges x loop depth), bounded to 32 expression levels.
math_recurrence_bound = (n: int, l: int, limit: int, loop_: int, depth: int = 0) -> int:
    if n == 0 or depth > 32: return -1
    if math_local_is(n, l): return limit
    k = nodes[n].kind
    if k == .conv and nodes[n].aux == i32(int(CV.int_)):
        return math_recurrence_bound(int(nodes[n].a), l, limit, loop_, depth + 1)
    if k == .ident and nodes[n].aux == i32(int(SK.local)):
        at = loop_
        loop at > 0:
            if nodes[at].kind == .for_ and nodes[at].aux == 0 and nodes[at].sym == nodes[n].sym and stable_loop_index(int(nodes[n].sym)):
                it = int(nodes[at].a)
                if nodes[it].kind != .range: return -1
                start = int(nodes[it].a)
                end = exact_count_bound(int(nodes[it].b))
                if nodes[start].kind == .int_lit and nodes[start].ival == 0 and not has_flag(it, NF_STEP) and not end.wide and end.lo >= 0: return end.hi
            at = math_loop_parent.get(at) ?? 0
    bound = exact_count_bound(n)
    if not bound.wide and bound.lo >= 0: return bound.hi
    if k == .binary and nodes[n].aux == 0 and nodes[n].op == i32(int(Tok.plus)):
        a = math_recurrence_bound(int(nodes[n].a), l, limit, loop_, depth + 1)
        b = math_recurrence_bound(int(nodes[n].b), l, limit, loop_, depth + 1)
        if a >= 0 and b >= 0 and a <= 9223372036854775807 - b: return a + b
    if k == .call and nodes[n].aux == 0 and nkids(n) == 2:
        f = int(nodes[n].sym)
        if f <= 0: return -1
        d = int(fns[f].decl)
        if d == 0 or files[pos_file(nodes[d].pos)].path != lib_dir + "/math_int.jo" or name_of(int(nodes[d].name)) != "__floor_div": return -1
        known, divisor = integer_constant(kid(n, 1))
        if not known or divisor <= 0: return -1
        a = math_recurrence_bound(kid(n, 0), l, limit, loop_, depth + 1)
        if a >= 0: return a / divisor
    -1

math_recurrence_limit = (s: int, writes: (int, int)[]) -> int:
    initial = exact_count_bound(int(nodes[s].b))
    if initial.wide or initial.lo < 0: return -1
    l = int(nodes[s].sym)
    loop pair in writes:
        w = pair.0
        if nodes[w].op != i32(int(Tok.assign)) or nodes[w].aux != 0: return -1
        bound = math_recurrence_bound(int(nodes[w].b), l, initial.hi, math_write_loop.get(w) ?? 0)
        if bound < 0 or bound > initial.hi: return -1
    initial.hi

math_word_local_decl = (s: int) -> bool:
    l = int(nodes[s].sym)
    if prune(int(locals[l].type)) != T_MATH_INT or dbg_on: return false
    fl = int(locals[l].flags)
    if fl & (LF_PARAM | LF_MUTPARAM | LF_CAPTURE | LF_ALIAS | LF_BYREF | LF_ADDR | LF_SHARED | LF_EXPOSED | LF_SOAELEM | LF_ELEMALIAS) != 0: return false
    # Generated loop bindings are ordinary immutable copies. Mutable quiet
    # bindings can have implicit writes absent from the assignment index.
    if fl & (LF_QUIET | LF_ASSIGNED) == LF_QUIET | LF_ASSIGNED: return false
    init = int(nodes[s].b)
    if init == 0 or not math_proven_word(init): return false
    limit = positive_bound(init, true)
    writes: (int, int)[]
    if fl & LF_ASSIGNED != 0:
        if cur_block == 0 or kid(cur_block, cur_block_i) != s: return false
        math_prepare_writes()
        writes = math_writes.get(l) ?? []
        if writes.len() == 0: return false
        limit = math_counter_limit(s, writes)
        if limit < 0: limit = math_length_counter_limit(s, writes)
        if limit < 0: limit = math_recurrence_limit(s, writes)
        if limit < 0 and not math_decrement_counter(s, writes):
            loop pair in writes:
                if nodes[pair.0].op != i32(int(Tok.assign)) or nodes[pair.0].aux != 0: return false
                if not math_guarded_word(int(nodes[pair.0].b), l): return false
    word = vreg(VI)
    e_mov(word, math_word_expr(init))
    math_word_regs[l] = word
    if limit >= 0: math_word_limits[l] = limit
    loop pair in writes: math_word_updates[int(nodes[pair.0].b)] = true
    true

# A strict comparison against any word establishes room for subtracting one,
# even when the comparison's lower bound is negative. Do not claim positivity.
math_decrement_counter = (s: int, writes: (int, int)[]) -> bool:
    if writes.len() != 1: return false
    l = int(nodes[s].sym)
    update = math_update_value(writes[0].0, l)
    loop_ = writes[0].1
    if update == 0 or loop_ <= 0 or nodes[loop_].kind != .while_ or nodes[update].op != i32(int(Tok.minus)): return false
    step = int(nodes[update].b)
    if nodes[step].kind != .int_lit or nodes[step].ival != 1: return false
    math_decrement_guard(int(nodes[loop_].a), l)

math_decrement_guard = (cond: int, l: int, depth: int = 0) -> bool:
    if depth > 32: return false
    if nodes[cond].kind == .and_:
        return math_decrement_guard(int(nodes[cond].a), l, depth + 1) or math_decrement_guard(int(nodes[cond].b), l, depth + 1)
    if nodes[cond].kind != .binary or nodes[cond].aux != 0: return false
    a = word_integer_value(int(nodes[cond].a))
    b = word_integer_value(int(nodes[cond].b))
    if nodes[cond].op == i32(int(Tok.gt)): return math_local_is(a, l) and math_proven_word(b)
    if nodes[cond].op == i32(int(Tok.lt)): return math_local_is(b, l) and math_proven_word(a)
    false

# A nonescaping integer result immediately consumed as a float needs no tagged
# temporary. The word arm still checks overflow; the cold arm computes the
# exact integer first and rounds it once, just like the ordinary conversion.
math_float_binary = (e: int, to: int) -> int:
    if nodes[e].kind != .binary or nodes[e].aux != 0 or target_wasm: return -1
    op = nodes[e].op as Tok
    if op != .plus and op != .minus and op != .star: return -1
    a = int(nodes[e].a)
    b = int(nodes[e].b)
    if not math_proven_word(a) or not math_proven_word(b): return -1
    x = freeze_scalar(math_word_expr(a), T_INT)
    y = math_word_expr(b)
    value = e_bin(int_op(op, true), VI, x, y)
    bad = 0
    if op == .star:
        bad = e_bin(.ne, VI, e_bin(.mulhs, VI, x, y), e_bin(.shrs, VI, value, e_iconst(63)))
    else:
        left = e_bin(.xor, VI, x, value)
        right = e_bin(.xor, VI, (if op == .plus: y else: x), (if op == .plus: value else: y))
        bad = e_bin(.lts, VI, e_bin(.and_, VI, left, right), e_iconst(0))
    out = vreg(VF)
    iff(e_bin(.eq, VI, bad, e_iconst(0)))
    e_mov(out, e_un(.i2f, VF, value))
    els()
    old = ir_cold
    ir_cold = true
    operation = if op == .plus: 0 else if op == .minus: 1 else: 2
    e_mov(out, e_call(rt("__mi_word_float"), [x, y, e_iconst(operation)], VF))
    ir_cold = old
    endc()
    if to == T_FLOAT: return out
    e_un(.f2f, VS, out)

math_versioning = false

math_value_arm = (b: int) -> int:
    if nodes[b].kind != .block or nodes[b].aux == 0 or nkids(b) != 1: return 0
    s = kid(b, 0)
    if nodes[s].kind != .exprstmt: return 0
    int(nodes[s].a)

# Absolute addend bound for the narrow accumulator pattern: constants, the
# stable induction variable, sign changes, and a conditional choosing them.
math_addend_bound = (e0: int, index: int, bound: int) -> int:
    e = word_integer_value(e0)
    if e == 0: return -1
    if math_local_is(e, index): return bound
    if nodes[e].kind == .int_lit and not has_flag(e, NF_U64) and nodes[e].ival != -9223372036854775807 - 1: return abs(nodes[e].ival)
    if nodes[e].kind == .unary and nodes[e].op == i32(int(Tok.minus)): return math_addend_bound(int(nodes[e].a), index, bound)
    if nodes[e].kind == .if_:
        a = math_addend_bound(math_value_arm(int(nodes[e].b)), index, bound)
        b = math_addend_bound(math_value_arm(int(nodes[e].c)), index, bound)
        if a >= 0 and b >= 0: return max(a, b)
    -1

math_accumulator_for = (s: int) -> bool:
    if not math_has_mutable or math_versioning or dbg_on or nodes[s].aux != 0: return false
    it = int(nodes[s].a)
    start = int(nodes[it].a)
    end = int(nodes[it].b)
    index = int(nodes[s].sym)
    if nodes[start].kind != .int_lit or nodes[start].ival != 0 or end == 0 or has_flag(it, NF_STEP) or has_flag(it, NF_INCLUSIVE): return false
    if not stable_loop_index(index) or not math_word_bound(end) or not plain_read(word_integer_value(end)): return false
    math_prepare_writes()
    site = math_loop_sites.get(s) ?? 0
    if site <= 0: return false
    l = int(nodes[int(nodes[site].a)].sym)
    active = false
    loop scope in scope_locals:
        if scope.contains(l): active = true
    if math_word_regs.has(l) or not active: return false
    flags = int(locals[l].flags)
    if flags & (LF_PARAM | LF_MUTPARAM | LF_CAPTURE | LF_CAPTURED | LF_ALIAS | LF_BYREF | LF_ADDR | LF_SHARED | LF_EXPOSED) != 0: return false
    update = math_update_value(site, l)
    if update == 0 or nodes[update].op != i32(int(Tok.plus)): return false
    # This inexpensive guard permits over two billion trips. Larger ranges,
    # existing big values, and sums too close to a word boundary stay exact.
    cap = 2147483647
    addend = int(nodes[update].b)
    bound = math_addend_bound(addend, index, cap)
    if bound < 0 or bound > 9223372036854775807 / cap: return false
    room = 9223372036854775807 - cap * bound
    place = local_place(l, true)
    initial = read_place(place, T_MATH_INT)
    word = math_untag(initial)
    guard = e_bin(.eq, VI, math_tag(initial), e_iconst(0))
    guard = e_bin(.and_, VI, guard, e_bin(.les, VI, math_count(end), e_iconst(cap)))
    guard = e_bin(.and_, VI, guard, e_bin(.and_, VI, e_bin(.ges, VI, word, e_iconst(-room)), e_bin(.les, VI, word, e_iconst(room))))
    saved_regs = math_word_regs
    saved_limits = math_word_limits
    saved_updates = math_word_updates
    iff(guard)
    acc = vreg(VI)
    e_mov(acc, word)
    math_word_regs[l] = acc
    math_word_updates[update] = true
    math_word_updates[addend] = true
    math_versioning = true
    math_fresh_loop_regs(s)
    gen_for(s)
    write_place(place, T_MATH_INT, math_word(acc).v)
    math_word_regs = saved_regs
    math_word_limits = saved_limits
    math_word_updates = saved_updates
    els()
    was_cold = ir_cold
    ir_cold = true
    math_fresh_loop_regs(s)
    gen_for(s)
    ir_cold = was_cold
    math_versioning = false
    math_word_regs = saved_regs
    math_word_limits = saved_limits
    math_word_updates = saved_updates
    endc()
    true

# Distinct loop copies must not share scalar virtual registers: otherwise a
# later definition in the cold copy extends live intervals through hot calls.
math_fresh_loop_regs = (n: int):
    if n == 0: return
    k = nodes[n].kind
    if k == .lambda or k == .fn_: return
    if k == .vardecl or k == .for_:
        l = int(nodes[n].sym)
        if l > 0 and int(locals[l].owner) == cur_fn and locals[l].offset < 0 and int(locals[l].flags) & (LF_ALIAS | LF_BYREF | LF_CAPTURE | LF_PARAM) == 0:
            locals[l].vreg = i32(vreg(vt_of(int(locals[l].type))))
    math_fresh_loop_regs(int(nodes[n].a))
    math_fresh_loop_regs(int(nodes[n].b))
    if k != .for_:
        math_fresh_loop_regs(int(nodes[n].c))
        if k != .partial: math_fresh_loop_regs(int(nodes[n].d))
    loop i in [0..nkids(n)): math_fresh_loop_regs(kid(n, i))
    loop i in [0..nkids2(n)): math_fresh_loop_regs(kid2(n, i))

# Bypass only the bundled default decimal formatter, following its checked
# forwarding wrappers. A user formatter or a format spec keeps its own call.
math_default_formatter = (f0: int) -> bool:
    f = f0
    loop _ in [0..4):
        if f <= 0 or fns[f].decl == 0: return false
        d = int(fns[f].decl)
        path = files[pos_file(nodes[d].pos)].path
        name = name_of(int(nodes[d].name))
        if path == lib_dir + "/math_int.jo" and name == "__fmt": return true
        if path != lib_dir + "/core/fmt.jo" or name != "__dewy_fmt": return false
        body = int(fns[f].body)
        if nodes[body].kind != .block or nkids(body) != 1: return false
        statement = kid(body, 0)
        if nodes[statement].kind != .exprstmt: return false
        call = int(nodes[statement].a)
        if nodes[call].kind != .call or nodes[call].aux != 0: return false
        f = int(nodes[call].sym)
    false

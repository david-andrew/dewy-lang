$runtime_checks
from p"checked_expression_nodes.dewy" import (capture_value)
from p"ast.jo" import (NF_BROADCAST NF_INDEX_CAPTURED NF_LIB_INDEX NF_LOOPCOUNT NF_MAP_KEY NF_MUT NF_RELOOKUP add_flag has_flag kid kids nkids nodes set_kid set_list)
from p"check.jo" import (index_update_sources)
from p"checker_update_selectors.dewy" import (compound_selector_runs)
from p"checks_builders.dewy" import (bc_block bc_ident bc_let)
from p"checks_thin.dewy" import (check_stmt)
from p"expr.jo" import (bc_count copy_place map_place_index ntype)
from p"util.jo" import (intern)

SelectorCaptureWord:type=int64<overflow='wrap'>
SelectorCaptureI32:type=int32<overflow='wrap'>

# The path from an expression back to its root, outermost access first.
index_update_path=(n:SelectorCaptureWord):>array<int64>=>{
    let path:array<int64>=[]
    let part=n
    loop nodes[part].kind =? 'field' or nodes[part].kind =? 'index' {
        path.push(part)
        part=SelectorCaptureWord(nodes[part].a)
    }
    path
}

# A compound update reads its target and writes it back. Each selector that
# can run code is evaluated exactly once, from the root outward (left to
# right), before both: `d[f()]["x"] += 1` calls f once. O(path).
compound_selector_capture=(s:SelectorCaptureWord):>SelectorCaptureWord=>{
    if nodes[s].op =? 47 or has_flag(s NF_BROADCAST) or has_flag(s NF_INDEX_CAPTURED) {return 0}
    let lhs=SelectorCaptureWord(nodes[s].a)
    if nodes[lhs].kind not=? 'index' and nodes[lhs].kind not=? 'field' {return 0}
    let pos=nodes[s].pos
    let stmts:array<int64>=[]
    let path=index_update_path(lhs)
    let i=SelectorCaptureWord(path.length) - 1
    let counter = @bc_count
    loop i >=? 0 {
        let part=path[i]
        i -= 1
        if nodes[part].kind not=? 'index' or has_flag(part NF_LIB_INDEX) {continue}
        let selectors:array<int64>=if nodes[part].b not=? 0 {[int64(nodes[part].b)]} else {kids(part)}
        let captured:array<int64>=[]
        loop selector in selectors {
            if nodes[selector].kind =? 'range' or nodes[selector].kind =? 'hole' or not compound_selector_runs(selector) {
                captured.push(selector)
                continue
            }
            let name="$selector{counter}"
            counter += 1
            index_update_sources[intern(name)]=selector
            stmts.push(bc_let(name selector pos))
            captured.push(bc_ident(name pos))
        }
        if nodes[part].b not=? 0 {nodes[part].b=SelectorCaptureI32(captured[0])}
        else {set_list(part captured)}
    }
    if stmts.length =? 0 {return 0}
    let update=SelectorCaptureWord(nodes.length)
    nodes.push(nodes[s])
    stmts.push(update)
    let block=bc_block(stmts pos)
    check_stmt(block)
    block
}

# Only dictionary update paths need this work. O(path^2 + RHS): capture keys
# and ordinary indices before the old-value read/RHS, never entry positions.
# Each dictionary's receiver copy contains at most the preceding path.
# Plain RHSs retain the existing single-lookup compound update.
map_update_capture=(lhs:SelectorCaptureWord rhs:SelectorCaptureWord @before:array<int64>):>void=>{
    if nodes[lhs].kind not=? 'field' and nodes[lhs].kind not=? 'index' {return}
    let path=index_update_path(lhs)
    let found=false
    loop part in path {
        if map_place_index(part) {found=true}
    }
    if not found or not compound_selector_runs(rhs) {return}
    let i=SelectorCaptureWord(path.length) - 1
    loop i >=? 0 {
        let part=path[i]
        i -= 1
        if nodes[part].kind not=? 'index' or nodes[part].b =? 0 {continue}
        let entry=map_place_index(part)
        let selector=if entry {kid(SelectorCaptureWord(nodes[part].b) 1)} else {SelectorCaptureWord(nodes[part].b)}
        let kept=selector
        let kind=nodes[selector].kind
        let literal=kind =? 'int_lit' or kind =? 'float_lit' or kind =? 'bool_lit' or kind =? 'str_lit' and nkids(selector) =? 0
        if not literal {
            kept=capture_value(selector ntype(selector) @before)
            if entry {
                add_flag(before[SelectorCaptureWord(before.length) - 1] NF_MAP_KEY)
                add_flag(kept NF_MAP_KEY)
            }
        }
        if entry {
            let call=SelectorCaptureWord(nodes[part].b)
            # The copied receiver must use the captured selectors as well.
            let receiver=copy_place(SelectorCaptureWord(nodes[SelectorCaptureWord(nodes[part].a)].a))
            add_flag(receiver NF_MUT)
            set_kid(call 0 receiver)
            set_kid(call 1 kept)
            add_flag(part NF_RELOOKUP)
        } else {nodes[part].b=SelectorCaptureI32(kept)}
    }
}

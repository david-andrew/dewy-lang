# Scoped settings written as metatags: `$name`, `$name=true`, `$name=false`.
# A setting holds throughout the scope it is written in (a module, a function
# body or another block), position ranges standing for scopes. A bundle
# (lib/directives.dewy) is one metatag for several settings, held throughout
# its scope; `$bundle=false` opts a nested scope out of all of them.
# Nothing here costs anything until a program writes one of these settings.
use 'ast.jo'
use 'util.jo'
use 'facts.jo'
use 'effects.jo'
use 'proofs.jo'
use 'ide.jo'
use 'check.jo'
use 'expr.jo'
use 'witness.jo'

struct DirScope:
    start: int
    end: int
    setting: int
    value: int        # 1 on, 0 off, -1 the default (a bundle's opt-out); a row: its syntax
    bundle: int = 0   # the bundle that set it; 0 when written directly
    at: int = 0

struct DirBundle:
    name: int
    settings: int[]
    values: int[]
    row: int = 0      # effect_syntax index of the row its functions default to
    at: int = 0
    includes: int[]   # the bundles it includes (names), merged in by dir_bundle_resolve
    include_at: int[]
    state: int = 0    # 0 its includes not merged yet, 1 merging (a cycle if met again), 2 merged
    allocation_failure: bool = false   # it sets `$explicit_allocation_failure` (a module policy)

struct DirSite:
    at: int
    what: str
    policy: int

# How an unproven obligation compiles at a site.
const DIR_STATIC = 0       # a compile error: no hidden trap
const DIR_RUNTIME = 1      # `$runtime_checks`: a runtime check
const DIR_PROTOTYPE = 2    # `$prototype`: a runtime check and a warning
const DIR_IMPLICIT = 3     # the default, while it is still runtime checks
# The policy outside `$runtime_checks`/`$prototype` scopes. DIR_STATIC makes
# no traps the default.
const DIR_DEFAULT = 3

dir_scopes: DirScope[]
dir_bundles: DirBundle[]
dir_sites: DirSite[]
dir_proven: {int: bool}        # index node -> proven at every visit
dir_panic_sites: DirSite[]     # calls of code that may panic, where checks are allowed
dir_row_scopes: {int: int}     # function declaration -> the scope giving its row
dir_obligations = false        # `check --obligations`
dir_forced = false             # this module turned the static analysis on
dir_prior_static = false       # and it was on before (an internal policy)
dir_copies_any = false
dir_rows_any = false
dir_floats_any = false         # some scope sets `$no_nan` or `$no_inf` (compiler/floats.jo)
dir_deadlocks_any = false      # some scope sets `$no_deadlocks` (compiler/deadlock.jo, certificates)
dir_bundles_loaded = false

dir_name_runtime = 0
dir_name_prototype = 0
dir_name_warnings = 0
dir_name_copies = 0
dir_name_row = 0
dir_name_no_nan = 0
dir_name_no_inf = 0
dir_name_local_asserts = 0
dir_name_confine = 0
dir_name_deadlocks = 0
dir_name_audited = 0

directives_reset = ():
    dir_scopes = []
    dir_bundles = []
    dir_sites = []
    dir_proven = {}
    dir_row_scopes = {}
    dir_panic_sites = []
    dir_forced = false
    dir_prior_static = false
    dir_copies_any = false
    dir_rows_any = false
    dir_floats_any = false
    dir_deadlocks_any = false
    dir_bundles_loaded = false
    dir_name_runtime = 0
    fact_policy_default = DIR_DEFAULT == DIR_STATIC and fact_policy == .RuntimeAllowed
    if DIR_DEFAULT == DIR_STATIC: fact_policy = .RequireStatic
    if dir_obligations: dir_force()

# (names are interned on first use: an ordinary program interns none)
dir_names = ():
    if dir_name_runtime != 0: return
    dir_name_runtime = intern("runtime_checks")
    dir_name_prototype = intern("prototype")
    dir_name_warnings = intern("prototype_warnings")
    dir_name_copies = intern("explicit_copies")
    dir_name_row = intern("default_row")
    dir_name_no_nan = intern("no_nan")
    dir_name_no_inf = intern("no_inf")
    dir_name_local_asserts = intern("assume_local_asserts")
    dir_name_confine = intern("confine_external_paths")
    dir_name_deadlocks = intern("no_deadlocks")
    dir_name_audited = intern("audited_wait")

# Metatags the compiler gives a meaning of its own; any other `$name` in a
# source may be a bundle (or a loop label), so the bundles are read first.
dw_dir_known = (name: str) -> bool:
    name in ["assert", "runtime_assert", "expect", "fail", "breakpoint", "lend", "test", "proof", "capture", "include_bytes", "clamp", "target", "build", "supported_targets", "field", "unsafe_assume", "abstract", "allocator", "no_prelude", "runtime_checks", "prototype", "prototype_warnings", "explicit_copies", "fast_math", "no_nan", "no_inf", "unsafe", "assume_local_asserts", "extern", "intrinsic", "export", "realtime", "explicit_allocation_failure", "warn_if", "confine_external_paths", "no_deadlocks", "audited_wait", "__copy__", "__drop__", "__move__", "send", "sync"]

# The builtin boolean settings. (`$fast_math` permits reassociation and FMA
# contraction; the backends do neither yet, so it changes no code. `$unsafe` is
# the unsafe boundary: compiler/ffi.jo.)
dir_builtin = (name: str) -> bool:
    name == "runtime_checks" or name == "prototype" or name == "prototype_warnings" or name == "explicit_copies" or name == "fast_math" or name == "no_nan" or name == "no_inf" or name == "unsafe" or name == "assume_local_asserts" or name == "confine_external_paths" or name == "no_deadlocks" or name == "audited_wait"

dir_bundle_index = (name: int) -> int:
    loop i in [0..dir_bundles.len()):
        if dir_bundles[i].name == name: return i
    -1

# A bundle's included bundles, merged into its own settings and row, transitively, once.
# O(bundles x settings): a handful of each.
dir_bundle_resolve = (b: int, chain: mut int[]):
    if dir_bundles[b].state == 2: return
    name = dir_bundles[b].name
    if dir_bundles[b].state == 1:
        cycle = ""
        on = false
        loop c in chain:
            if c == name: on = true
            if on: cycle += "`${name_of(c)}` includes "
        fatal(dir_bundles[b].at, "bundles include each other: {cycle}`${name_of(name)}`")
    dir_bundles[b].state = 1
    chain.push(name)
    loop k in [0..dir_bundles[b].includes.len()):
        member = dir_bundles[b].includes[k]
        at = dir_bundles[b].include_at[k]
        inner = dir_bundle_index(member)
        if inner < 0: fatal(at, "unknown member `${name_of(member)}` in the bundle `${name_of(name)}`: a bundle lists builtin settings, other bundles and `$default_row`")
        dir_bundle_resolve(inner, chain)
        included = dir_bundles[inner]
        loop i in [0..included.settings.len()):
            dir_bundle_merge(b, included.settings[i], included.values[i], member, at)
        if included.allocation_failure: dir_bundles[b].allocation_failure = true
        if included.row != 0:
            if dir_bundles[b].row != 0 and dir_bundles[b].row != included.row: fatal(at, "the bundle `${name_of(name)}` gets a second `$default_row` from `${name_of(member)}`: a bundle has one default effect row")
            dir_bundles[b].row = included.row
    chain.pop()
    dir_bundles[b].state = 2

# One setting an included bundle brings; two members may not disagree on it.
dir_bundle_merge = (b: int, setting: int, value: int, member: int, at: int):
    loop i in [0..dir_bundles[b].settings.len()):
        if dir_bundles[b].settings[i] != setting: continue
        if dir_bundles[b].values[i] == value: return
        spelled = if value == 0: "=false" else: ""
        other = if value == 0: "on" else: "off"
        fatal(at, "`${name_of(member)}` sets `${name_of(setting)}{spelled}` in the bundle `${name_of(dir_bundles[b].name)}`, which already sets it {other}")
    dir_bundles[b].settings.push(setting)
    dir_bundles[b].values.push(value)

# Every bundle defined so far, resolved: an unknown member or a cycle is reported where it is
# defined, used or not.
dir_bundles_resolve = ():
    loop b in [0..dir_bundles.len()):
        if dir_bundles[b].state != 2:
            chain: int[]
            dir_bundle_resolve(b, chain)

# Unproven obligations are analyzed when some scope needs them decided.
dir_force = ():
    if dir_forced: return
    dir_forced = true
    dir_prior_static = fact_policy == .RequireStatic
    fact_policy = .RequireStatic

dir_module_start = (file: int) -> int: file << 40
dir_module_end = (file: int) -> int: (file << 40) | 0xFFFFFFFFFF

# The innermost scope of a setting at a position (-1: none). A setting written
# directly wins over a bundle's at the same scope.
dir_find = (setting: int, p: int, skip: int = -1) -> int:
    best = -1
    loop i in [0..dir_scopes.len()):
        if i == skip: continue
        s = dir_scopes[i]
        if s.setting != setting or p < s.start or p > s.end: continue
        if best >= 0:
            b = dir_scopes[best]
            if s.start < b.start: continue
            if s.start == b.start and s.bundle != 0 and b.bundle == 0: continue
        best = i
    best

dir_value = (setting: int, p: int) -> int:
    if dir_scopes.len() == 0: return -1
    i = dir_find(setting, p)
    if i < 0: return -1
    dir_scopes[i].value

dir_spelled = (s: DirScope) -> str:
    v = if s.value == 1: "" else if s.value == 0: "=false" else: "=default"
    "`${name_of(s.setting)}{v}`"

# A setting written directly inside a bundle's scope cannot undo the bundle.
dir_conflict = (i: int):
    s = dir_scopes[i]
    if s.bundle != 0: return
    o = dir_find(s.setting, s.start, i)
    if o < 0: return
    outer = dir_scopes[o]
    if outer.end < s.end: return
    if outer.bundle == 0 and outer.start == s.start:
        where = if s.start == dir_module_start(pos_file(s.start)): "module" else: "scope"
        fatal(s.at, "`${name_of(s.setting)}` may be set only once per {where}")
    if outer.bundle == 0 or outer.value == -1 or outer.value == s.value: return
    b = name_of(outer.bundle)
    fatal(s.at, "{dir_spelled(s)} is not allowed inside `${b}`, which sets {dir_spelled(outer)}; opt this scope out first with `${b}=false`")

dir_push = (s: DirScope):
    dir_scopes.push(s)
    if s.setting == dir_name_copies and s.value == 1: dir_copies_any = true
    if s.setting == dir_name_row and s.value > 0: dir_rows_any = true
    if (s.setting == dir_name_no_nan or s.setting == dir_name_no_inf) and s.value == 1: dir_floats_any = true
    if s.setting == dir_name_deadlocks and s.value == 1: dir_deadlocks_any = true
    if s.setting == dir_name_runtime and s.value == 0 or s.setting == dir_name_prototype and s.value == 1: dir_force()
    if s.setting == dir_name_runtime and s.value == 1 and ide_on: dir_force()
    if s.bundle == 0:
        dir_conflict(dir_scopes.len() - 1)
        return
    # (a bundle written after a setting it governs: check that setting again)
    loop i in [0..dir_scopes.len() - 1):
        if dir_scopes[i].bundle == 0 and dir_scopes[i].start >= s.start and dir_scopes[i].end <= s.end: dir_conflict(i)

# `$realtime` and the bundles: a scope for each of a bundle's settings.
dir_set = (name: int, value: int, start: int, end: int, at: int):
    dir_names()
    text = name_of(name)
    if text == "realtime": fatal(at, "`$realtime` is reserved for a future bundle stronger than `$no_hidden_costs` (no blocking, a bounded stack); use `$no_hidden_costs`")
    if dir_builtin(text):
        # (an audit covers the adapter it is written in, never a whole module)
        if text == "audited_wait" and start == dir_module_start(pos_file(start)): fatal(at, "`$audited_wait` marks one audited adapter: write it in the body of the function that wraps the foreign call, not for a whole module")
        dir_push(DirScope(start, end, name, value, 0, at))
        return
    b = dir_bundle_index(name)
    if b < 0: fatal(at, "unknown directive `${text}`")
    if dir_bundles[b].state != 2:
        chain: int[]
        dir_bundle_resolve(b, chain)
    bundle = dir_bundles[b]
    dir_push(DirScope(start, end, name, value, 0, at))
    loop i in [0..bundle.settings.len()):
        dir_push(DirScope(start, end, bundle.settings[i], (if value == 1: bundle.values[i] else: -1), name, at))
    if bundle.row != 0: dir_push(DirScope(start, end, dir_name_row, (if value == 1: bundle.row else: -1), name, at))

# How an unproven obligation at p compiles: the innermost of `$runtime_checks`
# and `$prototype` decides.
dir_policy = (p: int) -> int:
    r = -1
    q = -1
    if dir_scopes.len() > 0:
        r = dir_find(dir_name_runtime, p)
        q = dir_find(dir_name_prototype, p)
    rv = if r >= 0: dir_scopes[r].value else: -1
    qv = if q >= 0: dir_scopes[q].value else: -1
    if qv == 1 and (rv == -1 or dir_scopes[q].start >= dir_scopes[r].start): return DIR_PROTOTYPE
    if rv == 1: return DIR_RUNTIME
    if rv == 0: return DIR_STATIC
    if qv == 1: return DIR_PROTOTYPE
    # (the library's own obligations keep their checks unless it says otherwise,
    # however its function came to be analyzed: not every function is, and a
    # library function analyzed for one request is no different)
    if pos_in_lib(p): return DIR_IMPLICIT
    if DIR_DEFAULT == DIR_STATIC: return DIR_STATIC
    static = if dir_forced: dir_prior_static else: fact_policy == .RequireStatic
    if static: DIR_STATIC else: DIR_IMPLICIT

# The decision for an unproven (or refuted) obligation the analysis reports:
# true when its scope defers it to a runtime check, which lowering keeps.
dir_defer = (n: int, what: str, deferrable: bool) -> bool:
    # (an `$assert` condition, and what it reads, must be proven)
    if not deferrable or n <= 0 or fact_query: return false
    # (erased proofs have no runtime fallback)
    if proof_active and fact_owner > 0 and fact_owner < fns.len() and proof_decls.has(int(fns[fact_owner].decl)): return false
    p = nodes[n].pos
    # (`pool[h].hp -= 1` indexes `items` at `__pool_index`'s answer: the
    # library's invariant, which keeps its check, as the library's own do)
    policy = if nodes[n].kind == .index and has_flag(n, NF_LIB_INDEX): DIR_IMPLICIT else: dir_policy(p)
    if policy == DIR_STATIC: return false
    err_notes = []
    dir_sites.push(DirSite(p, what, policy))
    owner = fact_retry_owner
    if fact_owner > 0: owner = fact_owner
    effect_panic_note(owner, n, what)
    if policy == DIR_PROTOTYPE and dir_value(dir_name_warnings, p) != 0: warn(p, "prototype: {what}; it is checked at run time")
    if ide_on and policy == DIR_RUNTIME:
        hint = "runtime check: " + dir_obligation_text(what)
        ide_emit("I\t{ide_pos_str(p)}\t{ide_esc(hint)}")
    true

dir_obligation_text = (what: str) -> str:
    if starts_with(what, "cannot prove "): return what[13..]
    what

# Every analyzed visit of an index must prove it before its check is dropped.
dir_index = (n: int, proven: bool):
    if fact_speculating > 0: return
    if not proven: dir_proven[n] = false
    else if not dir_proven.has(n): dir_proven[n] = true

# After the analysis: proven indexes lose their checks; the listing.
directives_after_facts = ():
    loop n, proven in dir_proven:
        if proven: add_flag(n, NF_INBOUNDS)
    dir_proven = {}

dir_policy_name = (policy: int) -> str:
    if policy == DIR_RUNTIME: return "$runtime_checks"
    if policy == DIR_PROTOTYPE: return "$prototype"
    "default"

# `check --obligations`: each unproven obligation that compiles to a runtime
# check, in source order, with the setting that made it one.
dir_print_obligations = ():
    dir_sites += dir_panic_sites
    order: int[]
    loop i in [0..dir_sites.len()):
        if pos_in_lib(dir_sites[i].at): continue
        seen = false
        loop j in order:
            if dir_sites[j].at == dir_sites[i].at and dir_sites[j].what == dir_sites[i].what: seen = true
        if not seen: order.push(i)
    # (insertion sort: a handful of sites)
    loop i in [1..order.len()):
        j = i
        loop j > 0 and dir_sites[order[j - 1]].at > dir_sites[order[j]].at:
            t = order[j]
            order[j] = order[j - 1]
            order[j - 1] = t
            j -= 1
    loop i in order:
        s = dir_sites[i]
        kind = if starts_with(s.what, "may panic: "): "" else: "runtime check: "
        print("{pos_str(s.at)}: {kind}{dir_obligation_text(s.what)} ({dir_policy_name(s.policy)})")

# ---------------- panics ----------------
# After facts settle which obligations became runtime checks: a no-traps scope
# may not call (or hand out a handle to) code that may panic, and a row that
# excludes panics holds. Only the program's own bodies are walked for sites;
# effect_panics walks a callee once. O(reached nodes + call edges).
dir_panics_demanded = () -> bool: effect_panics_demanded or fact_policy == .RequireStatic

dir_panics_finalize = ():
    dir_panic_sites = []
    if not dir_panics_demanded(): return
    effect_panics_settled = true
    loop f in [1..fns.len()):
        if fns[f].body == 0 or fns[f].state != 2 or fn_in_lib(f): continue
        effect_panics(f)
        loop i in [0..(panic_edge_end[f] - panic_edge_at[f]) / 2):
            e = panic_edge_at[f] + 2 * i
            g = panic_edges[e]
            n = panic_edges[e + 1]
            # (a closure written here: its own body answers for its calls)
            if nodes[n].kind == .lambda or not panic_reaches(f, g): continue
            p = nodes[n].pos
            # (code the compiler made, as the test runner: no source scope)
            if p <= 0: continue
            policy = dir_policy(p)
            if policy != DIR_STATIC:
                # (listed where the program calls the library: its own panics are its sites)
                if (dir_obligations or ide_on and policy == DIR_RUNTIME) and fn_in_lib(g) and not pos_in_lib(p):
                    what = "may panic: {dir_panic_call(n, g)}"
                    dir_panic_sites.push(DirSite(p, what, policy))
                    if ide_on and policy == DIR_RUNTIME: ide_emit("I\t{ide_pos_str(p)}\t{ide_esc(what)}")
                continue
            # (the deepest such call: a callee of the program's own that panics only
            # through a call its own no-traps scope forbids is reported there)
            loop depth in [0..64):
                h = panic_via[g]
                w = panic_witness[g]
                if h == 0 or fn_in_lib(g) or nodes[w].kind == .lambda or dir_policy(nodes[w].pos) != DIR_STATIC or not panic_reaches(g, h): break
                n = w
                g = h
            p = nodes[n].pos
            # (the measuring harness builds anyway: it reports the analysis's cost)
            if wit_measure: continue
            fatal(p, "{dir_panic_call(n, g)} may panic ({effect_panic_reason(g)}), and this scope has no runtime checks (no traps): {dir_panic_fix(p)}")
    loop f in [1..fns.len()):
        d = int(fns[f].decl)
        if d == 0 or nodes[d].sval == 0 or fns[f].state != 2 or fns[f].body == 0: continue
        contract = if fns[f].kind == FK_LAMBDA and not has_flag(d, NF_GENERIC): callable_contract(int(fns[f].fntype)) else: effect_subst(int(decl_infos[decl_info(d)].sig.contract), fns[f].targs)
        if contract == 0 or not effect_contracts[contract].exclusions.contains(EffectAtom(.panic)): continue
        if not effect_panics(f) or wit_measure: continue
        n = panic_witness[f]
        at = if n != 0 and not pos_in_lib(nodes[n].pos): nodes[n].pos else: nodes[d].pos
        fatal(at, "effect contract violation in '{effect_name(f)}': it may panic, and its row excludes panics; {effect_panic_reason(f)}{dir_row_origin(d)}")
    # (a callable bound that excludes panics: each reaching source)
    loop obligation in effect_obligations:
        bound = obligation.bound
        if bound == 0 or not effect_contracts[bound].exclusions.contains(EffectAtom(.panic)): continue
        dir_panic_source(obligation.source, 0)

dir_panic_source = (n: int, depth: int):
    if n == 0: return
    k = nodes[n].kind
    if k == .conv:
        dir_panic_source(int(nodes[n].a), depth + 1)
        return
    c = callable_contract(ntype(n))
    if c != 0 and effect_contracts[c].exclusions.contains(EffectAtom(.panic)): return
    if (k == .fnref or k == .lambda or k == .partial and nodes[n].aux == 0) and nodes[n].sym > 0:
        g = int(nodes[n].sym)
        if not effect_panics(g): return
        fatal(nodes[n].pos, "cannot prove callable effect contract: '{effect_name(g)}' may panic, and the row excludes panics; {effect_panic_reason(g)}")
    fatal(nodes[n].pos, "cannot prove callable effect contract: this function value may panic, and the row excludes panics (declare `& no panics` where it comes from)")

dir_panic_call = (n: int, g: int) -> str:
    k = nodes[n].kind
    if k == .fnref or k == .partial: return "a handle to `{effect_shown_name(g)}`, which may be called,"
    name = effect_shown_name(g)
    if name == "[]": return "indexing with `[]`"
    "calling `{name}`"

# The repairs: prove what the callee checks (a guard, a refined parameter, or
# a value-returning form such as `xs.get(i)`), or opt in to runtime checks.
dir_panic_fix = (p: int) -> str:
    i = dir_find(dir_name_runtime, p)
    if i >= 0 and dir_scopes[i].bundle != 0:
        b = name_of(dir_scopes[i].bundle)
        return "prove what it checks before the call (a guard, a refined parameter, or a form that returns the failure as a value), or opt this function out of `${b}` with `${b}=false` and add `$runtime_checks`"
    "prove what it checks before the call (a guard, a refined parameter, or a form that returns the failure as a value), or opt in to the check with `$runtime_checks` on a line of its own in this function or block"

# A `$runtime_assert` at p is its module's own handling, not `panics` for the
# module's callers, unless the scope says `$assume_local_asserts=false`
# (docs/design/assumptions.md).
dir_assume_local_asserts = (p: int) -> bool:
    if dir_scopes.len() == 0: return true
    dir_names()
    dir_value(dir_name_local_asserts, p) != 0

# `$confine_external_paths` (provisional spelling, docs/design/assumptions.md): a path taken
# whole from outside must be proven inside a base too, where a file-system call gets it.
dir_confine_paths = (p: int) -> bool:
    if dir_scopes.len() == 0: return false
    dir_names()
    dir_value(dir_name_confine, p) == 1

# `$no_deadlocks` (docs/design/safety_and_concurrency.md, "Deadlock freedom"): every wait at p
# needs a certificate (compiler/deadlock.jo).
dir_no_deadlocks = (p: int) -> bool:
    if not dir_deadlocks_any: return false
    dir_value(dir_name_deadlocks, p) == 1

# `$audited_wait` (provisional spelling, docs/design/assumptions.md): a foreign call at p that may
# block is audited to wait only on the outside world, never on a task of this program.
dir_audited_wait = (p: int) -> bool:
    if dir_scopes.len() == 0: return false
    dir_names()
    dir_value(dir_name_audited, p) == 1

# `$explicit_copies`, written for the module, a function or a block.
dir_explicit_copies = (p: int) -> bool:
    if not dir_copies_any: return false
    dir_value(dir_name_copies, p) == 1

# A declared function without an effect row takes its scope's default row.
dir_apply_rows = (first: int):
    if not dir_rows_any: return
    loop f in [first..nodes.len()):
        if nodes[f].kind != .fn_ or nodes[f].sval != 0: continue
        body = int(nodes[f].b)
        p = if body != 0: nodes[body].pos else: nodes[f].pos
        i = dir_find(dir_name_row, p)
        if i < 0 or dir_scopes[i].value <= 0: continue
        nodes[f].sval = i32(dir_scopes[i].value)
        dir_row_scopes[f] = i
        effects_active = true
        loop entry in effect_syntax[dir_scopes[i].value]:
            if entry.kind == .panic: effect_panics_demanded = true

# Where a function's row came from, for an effect diagnostic.
dir_row_origin = (d: int) -> str:
    i = dir_row_scopes.get(d) ?? -1
    if i < 0: return ""
    b = name_of(dir_scopes[i].bundle)
    "; `${b}` gives functions without a row of their own this one (opt a function out with `${b}=false` in its body)"

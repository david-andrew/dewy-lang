const VC_VOID = 0
const VC_INT = 1
const VC_FLT = 2
const VC_AGG = 3

const LK_INST = 0
const LK_HELPER = 1

enum HK: drop, copy, move, arrrel, arruniq, arrcopy, eq, hash, thunk, envdrop, partial, envcopy, stackenvdrop, boxrel, boxdrop, boxuniq, math_main, owner_boxcopy, parallel_serial, parallel_job, partition, promote, reset_words, capture_drop

struct LFunc:
    kind: int
    inst: int
    hkind: HK
    htype: int
    name: str

lfuncs: LFunc[]
inst_lf: {int: int} = {}
helper_lf: {str: int} = {}
# Demanded helpers are inventoried by their existing LFunc identity. The string
# map remains the cold publication interface for fused-worker reconciliation;
# ordinary lowering probes integer keys without formatting or allocating.
# Open addressing: expected O(1) lookup, amortized O(1) insertion.
helper_slots: i32[]

helper_count = 0

# data segments
rodata: u8[]
ro_starts: int[]            # where each item (a string, a constant, an array) in rodata starts
str_off: {str: int} = {}
data_size = 8     # offset 0 holds the initial stack pointer
# data words keeping the C functions found: their offsets and library|name
ffi_offs: int[]
ffi_keys: str[]
ffi_slot: {int: int} = {}       # offset -> index
glsl_of: {int: str} = {}        # (sloppy watch) shader() node -> the GLSL made for it
global_off: {int: int} = {}
entry_points: int[]

# relocations inside rodata/data that hold function addresses or data addresses are not needed:
# all addresses are computed by code.

# object header words (refcount, length, capacity, closure drop function): a memory class of
# their own, so stores to elements do not invalidate what the optimizer knows about them
# value of a runtime global (by name, from the prelude)
# call to a function that never returns (panics): registers need not survive it
# Fixed-arity calls append evaluated operands directly to the shared IR span.
# A string set's texts as one read-only block: each member's offset from the
# block's start, then the members as static strings (str_data's layout). The
# block refers only within itself, so it moves as a whole. (fused.jo's layout:
# a block per use, the same bytes however the functions are shared out)
set_text_tables: {int: int} = {}
# ---------------- type helpers ----------------
# Representation plans belong to one lowering invocation. Only demanded types
# acquire entries; epochs avoid a types-by-functions clearing pass. Lazy helper
# discovery may append types, and a later lowering (watch/replay included) never
# reuses a previous invocation's classification.
struct LowerTypePlan:
    epoch: int
    value_class: int
    vtype: int

lower_types: LowerTypePlan[]
lower_epoch = 0
lower_planning = false

# ---------------- function state ----------------
struct Val:
    v: int
    owned: bool
    slot: int

struct Place:
    mem: bool
    v: int
    math_opt: bool = false

struct TempItem:
    is_slot: bool
    ref: int
    t: int
    cond: bool
    stack_target: int = -1

struct LoopInfo:
    brk: int
    cont: int
    scope: int
    items: int
    built: int

# A value whose children are still being evaluated. init is a deferred zero
# instruction (slots) or the allocation call (arrays), patched only if an early
# exit actually needs to drop an incompletely initialized managed value.
struct BuildItem:
    is_slot: bool
    ref: int
    t: int
    init: int = -1

building: BuildItem[]

cur_fn = 0
cur_ret = 0
sret_v = -1
env_v = -1
ctl = 0
cond_depth = 0
scope_locals: int[][]
scope_defers: int[][]
loops: LoopInfo[]
# Statement marks index one reusable temporary arena. No per-statement array
# is allocated; cleanup visits each held value once in reverse creation order.
tl_items: int[]
tl_values: TempItem[]
tl_nop: int[]
tl_cond: int[]

# A statement normally needs no entry-time initialization. Record a compact
# insertion boundary, and publish a zero request only for conditional temps.
# Unlike placeholder instructions these records do not enter the optimizer IR.
struct LowerZero:
    mark: int
    start: int
    count: int
lower_zeros: LowerZero[]
lower_mark_serial = 0
lower_has_nops = false

# ---------------- reference counting ----------------
# release builds (`opt = release`) inline the fast paths of refcounting, uniqueness and bounds
# checks; debug builds keep them out of line so the IR (and compile time) stays small.
opt_release = false

# (where __mt_active is among the globals, for the code generator's CALL_RC_INC and CALL_RC_DEC)
mt_active_off = -1
# v was just computed as a read-only datum's address (e_daddr, a fresh vreg defined once): an
# immortal object, as every object in read-only data is (str_data, const_array). A bounded look
# back over the last few instructions; constant time.
# rc <= 0 marks immortal objects
# (the call dropping a reference to v, freeing it with the last: an array's elements and a box's
# value are released by a helper for the type)
# A function value's one managed part is its environment, and its drop and copy helpers
# (helper_drop) do nothing to a value without one (a plain function's: env 0). Test that inline
# and call the helper only for an environment. (Owner-capturing callables keep their hooks.)
# Arrays containing callable values must copy their environments too. Ordinary
# data arrays retain the normal COW path. This eager path is deliberately small:
# it also works when a callback is invoked by a borrowed implementation-library API.
# ---------------- temps ----------------
# Keep ordinary construction unchanged: a placeholder becomes a zero only
# when return/break/continue can bypass writes to some managed fields.
# ---------------- structured control ----------------
# branch to the construct opened at nesting level `level` (1-based count of open constructs)
# ---------------- scopes ----------------
# ---------------- places ----------------
# ---------------- boxes ----------------
# A boxed field (types.jo, decide_boxes) holds a pointer to [rc][value], null until it is given a
# value: an empty box reads as its type's default (box_dflt_off). Copies of what holds it share
# the box, and a write through it first makes the box the writer's own (box_unique), as an array
# is; a new value for the whole field is a new box (box_put).
const BOX_HDR = 8

# the type a field's memory holds: its value, or the box keeping it
# the boxed field (an index into fields) that field node e reads, or -1
box_dflt_data: {int: int} = {}

# (the rodata offset of) the value an empty box of type t reads as
# the address of the value in box p (of a value of type t), or of the default when p is empty
# the box at slot made the writer's own (a new one holding the default when it is empty, a copy
# when it is shared), for a write through it: the address of its value
# the owned value v of type t put in the box at slot (empty, or its box already released): a new
# box, or none for none (an empty box reads as none)
# owned value v stored in field f of the value at addr (whose memory there is zero, or released)
# the address of field f's value in the value at addr, for reading
# (gen_place of a boxed field gives the field's own memory, the box pointer, when this is set:
# assign_to, giving it a new box)
box_slot = false
# (the last box a place for writing went through, made the writer's own, and its type)
pinned_box = -1
pinned_type = 0

# ---------------- shared variables ----------------
# A variable that closures share by reference (LF_SHARED, see check.jo) lives in a cell: a
# one-element array. The variable (and each capture) holds the cell, and every access goes to its
# element, without copy-on-write, so all holders see the same value.
# the type of what the variable's storage holds: the value, or the cell
# the part of a bounds check that later checks build on: the array exists (release builds
# then know this for the rest of the scope)
# rodata offset of the "file:line" string for a position (consecutive checks share a line)
loc_last_file = -1
loc_last_line = -1
loc_last_off = 0

# A library position names no line of the program: the backtrace shows the
# program's call instead (`a // 0` fails in the caller, not in the library).
# length of an array/string object pointer (0 for null)
# indexes computed beforehand (a `mut` element passed as a copy finds its place again after the
# call with the same index)
frozen: {int: int}
# A fixed array covering an unsigned index's entire domain needs no check.
# Follow only value-preserving integer widenings. Stripping arbitrary casts
# would miss negative values introduced by signed narrowing (u16 -> i8 -> int).
# ---------------- calls ----------------
# A scalar expression can name a local's mutable register. Keep the value
# already read before evaluating a later operand/argument that can assign it.
# A snapshot taken only to keep an argument stable while the callee runs. The
# result is owned, so nothing refers to the snapshot once the call returns;
# release it there rather than at the end of the statement. A snapshot kept
# alive across a later mutating call in the same statement (`add(@p
# Node[text(p t)])`) would make that call detach and copy p's buffers.
arg_snapshots: TempItem[]

# (a is part of the same variable as one of the call's `mut` arguments; for the
# copy policy (callee 0 or more), unless their field paths part, or a checked
# callee spares a's place inside that argument: a method passing its own field)
# The callee's settled summary writes no place of formal j that overlaps a's
# field path below the actual b (`absorb(pending ...)` writing only `h`).
# Two inline field paths from one variable that name different fields at some
# step are different storage: a write through one cannot reach the other.
mwr_direct = false             # (may_write_root: only what the code itself does, not its calls)

# A `mut` element of a global array (or of a `mut` parameter's, which may be a global) is passed
# as a copy, written back after the call, when the call may run a function value: the callee
# itself, or one it calls. That code could resize the array, which would move the element. (What
# the callee changes by name is checked by mut_alias_check.)
struct CopyBack:
    arg: int
    slot: int
    idx: (int, int)[]          # the place's index nodes and their values
copy_backs: CopyBack[]

# after a call: the copies made since copy_backs had `mark` entries go back to their places (the
# copy's references move there)
# could the place argument i was read from (without a reference of its own) be given another
# value before the call returns, by the callee or a later argument, freeing what was read? It
# can for globals, variables closures share, captures and mut parameters; a plain local or
# parameter cannot be reached from elsewhere (and a parameter's caller keeps its value alive).
# Release builds leave out the reference to a global that neither the callee nor the later
# arguments can change.
# Could a `mut` argument of the call reach the storage argument a is read from (borrowed, without
# a reference of its own), and release it? A plain local, or a read-only parameter (its caller
# keeps the value), is reached only through its own variable (shares_mut_root); a global or a
# `mut` parameter also through a `mut` parameter or an alias, but not through another global or
# plain local. O(arguments).
# a local whose storage no other variable's place reaches (no alias, view, capture or address)
# A `mut` argument that is an element of an array or map (xs[i], xs[i].f) is written through
# its address in the array's memory, which must not move or be shared while the call runs: the
# same call may not be given the array itself, and a global array may not be one the callee
# (or a later argument) can change. (Other elements, as in swap(xs[i], xs[j]), are fine.)
# Could a mutable parameter of code at pos be one of these globals? Dewy code
# cannot name the implementation's private state (the allocator, diagnostics,
# I/O status: `__` globals of implementation modules), so a Dewy parameter is
# never one of those, however many library calls write them.
# a place as written (xs[i].pos), for messages
# The variable a place belongs to: through fields, indexing, `!`, narrowing and the names that
# stand for a place (a narrowed variable or field, `loop mut`'s element). pw_heap: some step
# indexes an array or map; pw_box: some step is a boxed field; pw_depth: how many fields and
# indexes. 0 (no variable) for a place reached through a raw pointer, or a value that is no place.
pw_heap = false
pw_box = false
pw_depth = 0
# the fields and indexes of a place, from its variable on (as place_var follows them)
# could one of two places (steps from the same variable) hold the other: is the shorter a
# prefix of the longer, as far as the compiler can tell (xs[i] and xs[j] may be the same)?
# the variable (ident node) whose array or map, or box, holds the element place n is in, or 0
# does expression n name the variable of ident node r?
# A checked method receiver may still carry syntactic NF_MUT permission even
# when overload resolution selected a read-only parameter. Effects follow the
# resolved signature, just as argument lowering does; keep syntax flags intact.
# ---------------- data races ----------------
# A function given to a parallel call (parallel_map, `parallel`...) runs on many threads at once:
# it must not change the variables it captured, or globals -- also not in the functions it calls.
# A callback parameter given on is its function's callers' to check (concurrency.jo, parsafe).
race_done: {int: bool} = {}     # named functions known not to change globals

race_check = (callee: int, args: int[], pos: int):
    # (the library's own calls take care of threads themselves)
    if in_lib(pos): return
    who = name_of(int(nodes[int(fns[callee].decl)].name))
    loop a in args:
        if tkind(ntype(a)) == .fn_ and not concurrency.parsafe_vouched(a): race_arg(a, who)

# the function value a: the compiler must see which function it is, to check it
race_arg = (a: int, who: str):
    k = nodes[a].kind
    if k == .conv: race_arg(int(nodes[a].a), who)
    else if k == .lambda: race_scan(int(fns[int(nodes[a].sym)].body), int(nodes[a].sym), who, true)
    else if k == .fnref:
        f = int(nodes[a].sym)
        if nodes[a].aux == 2: race_scan(int(fns[f].body), f, who, true)
        else: race_named(f, who)
    else if k == .partial:
        if nodes[a].aux == 1: race_arg(int(nodes[a].a), who)
        else: race_named(int(nodes[a].sym), who)
    else: fatal(nodes[a].pos, "{who} runs this function on many threads at once, so the compiler checks it for data races, which it can only do for a function it can see: pass a function by name or a lambda")

# a @parallel function is checked at its calls: it cannot be used as a value
parallel_direct = (f: int, pos: int):
    if f > 0 and fns[f].parallel_api and not in_lib(pos):
        fatal(pos, "'{name_of(int(nodes[int(fns[f].decl)].name))}' runs the function it is given on many threads at once, so it can only be called directly (where the compiler checks that function), not used as a value or partially applied")

# (a type or module where a value is wanted: P, Box[int])
type_as_value = (e: int):
    what = "a type"
    if tkind(ntype(e)) == .module: what = "a module"
    fatal(nodes[e].pos, "this is {what}, not a value (a value of a type is made by calling it: `T()`)")

# is position pos in the library (lib_dir)?
in_lib = (pos: int) -> bool:
    fi = pos_file(pos)
    fi >= 0 and fi < files.len() and starts_with(files[fi].path, lib_dir + "/")

race_named = (f: int, who: str):
    if race_done.contains(f) or fns[f].body == 0: return
    race_done[f] = true
    # (the core and standard libraries take care of threads themselves)
    if fns[f].decl != 0:
        fi = pos_file(int(nodes[int(fns[f].decl)].pos))
        if fi >= 0 and fi < files.len() and starts_with(files[fi].path, lib_dir + "/") and (find(files[fi].path, "/core/") >= 0 or find(files[fi].path, "/std/") >= 0): return
    race_scan(int(fns[f].body), f, who, false)

# a place that changes: the variable it belongs to, if that is shared with other threads
race_target = (t: int, f: int, who: str, captures: bool, pos: int):
    # (writing through a pointer changes memory the program manages itself, not the variable)
    n = place_var(t)
    if n == 0: return
    nm = name_of(int(nodes[n].name))
    if nodes[n].aux == i32(int(SK.global)):
        fatal(pos, "{who} runs this function on many threads at once, so it must not change the global '{nm}' (a data race): return values instead")
    if captures and nodes[n].aux == i32(int(SK.local)):
        l = int(nodes[n].sym)
        if int(locals[l].owner) != f or int(locals[l].flags) & LF_CAPTURE != 0:
            fatal(pos, "{who} runs this function on many threads at once, so it must not change '{nm}', a variable it captured (a data race): return values instead")

race_scan = (n: int, f: int, who: str, captures: bool):
    if n == 0: return
    loop called in value_helper_calls(n): race_named(called, who)
    k = nodes[n].kind
    if k == .lambda: return
    if k == .assign: race_target(int(nodes[n].a), f, who, captures, nodes[n].pos)
    else if k == .intrinsic and nkids(n) > 0:
        id = nodes[n].aux as IN
        if id == .push or id == .pop or id == .insert or id == .remove or id == .clear or id == .reserve or id == .resize or id == .truncate or id == .extend:
            race_target(kid(n, 0), f, who, captures, nodes[n].pos)
    else if k == .call:
        mm = checked_call_mutmask(n)
        loop i in [0..nkids(n)):
            if mm & (1 << i) != 0: race_target(kid(n, i), f, who, captures, nodes[kid(n, i)].pos)
        aux = int(nodes[n].aux)
        if aux == 0 and nodes[n].sym > 0: race_named(int(nodes[n].sym), who)
        # (calling a function value: which one, the compiler cannot tell; the library's are its own,
        # and a callback parameter's are its function's callers' to check)
        else if aux == 1 and not in_lib(nodes[n].pos) and not concurrency.parsafe_vouched(int(nodes[n].a)):
            fatal(nodes[n].pos, "{who} runs this code on many threads at once, so the compiler checks it for data races, which it cannot do through a call of a function value: call a function by name")
    else if k == .for_ and has_flag(n, NF_MUT): race_target(int(nodes[n].a), f, who, captures, nodes[n].pos)
    # (a part of "...{x}...": formatted by a __fmt function, which may be the program's)
    else if k == .pair and nodes[n].sym > 0: race_named(int(nodes[n].sym), who)
    race_scan(int(nodes[n].a), f, who, captures)
    race_scan(int(nodes[n].b), f, who, captures)
    if k != .for_:
        race_scan(int(nodes[n].c), f, who, captures)
        if k != .partial: race_scan(int(nodes[n].d), f, who, captures)
    loop i in [0..nkids(n)): race_scan(kid(n, i), f, who, captures)
    loop i in [0..nkids2(n)): race_scan(kid2(n, i), f, who, captures)

# A positive floor remainder bounds its result even when its input wraps.
# Recognize the bundled signed helper, never a user overload with this name.
# Keep ordinary integer arithmetic cheap without requiring whole-program
# inlining. Only bundled helpers and literal positive divisors are eligible;
# zero, negative divisors and user overloads keep their ordinary call paths.
# `bytes.read<uint64>(i)` (the library's __dewy_read_u64, u32 and u16): its check and an
# unaligned load in place of the call, which a default build would not expand. The
# receiver is kept alive only when the offset's evaluation could change it.
# (an offset of plain reads, literals and builtin integer arithmetic: it calls nothing and
# writes nothing, so the receiver read before it stands)
# ---------------- ticks that must agree ----------------
# A function given to a @deterministic function (netplay.session's tick) must give the same game
# on every machine from the same game and inputs: no random numbers but from a seed in the game,
# no clock, no input read there (it comes as the tick's input), and no globals changed (a
# rollback does not put them back) -- also not in the functions it calls. Warnings: random()
# after seed() from the game, say, is the same everywhere.
# ---------------- closures ----------------
# A direct local closure may keep its environment in this activation when every
# reference is a direct invocation, or an immutable environment is passed to
# an invocation-only parameter. Copies, returns, captures, rebinding and
# address-taking retain the ordinary heap representation.
lower_entry: Ins[]
stack_closure_fn = -1
stack_closure_locals: {int: bool} = {}
stack_closure_targets: {int: int} = {}
stack_closure_passed: {int: bool} = {}

# Match envcopy's retain-only case. A mutable or owner environment must still
# use the heap: its copy helper may allocate and copy the environment header.
# Invocation pins have ended before scope cleanup. No value can retain this
# environment, so only its managed captures need destruction, with no RC dispatch.
# ---------------- string interpolation ----------------
# ---------------- value blocks ----------------
# ---------------- match ----------------
# constant value of an integer literal pattern
# A dense match whose arms are scalar constants needs a data lookup, not
# one machine-code branch per arm. Keep the subject's existing evaluation and
# lifetime, and leave effectful/converting bodies on the ordinary path.
# matches on enum tags or integer literals with a dense value range dispatch through a jump table
# ---------------- binary ----------------
# The address of x's value, kept through later operand evaluation.
# A failed conversion of an `int` to a narrower width. (`int` arithmetic itself
# never fails: math_binary promotes, MIN // -1 included.)
# Arrays of plain integers or bools are equal when their bytes are: the lengths, then
# __mem_eq (expanded inline) over the elements where they are. A slice, xs[i..j) =? ys,
# is a range of its source, not a new array.
# the string a byte view of it is (`s as array<uint8>`: the same storage), or n
# where an array operand's elements start, and how many: a slice's checked range of its
# source (kept alive while later evaluation could release it)
# High unsigned product without allocating, including targets without mulhu.
# Saturating policy arithmetic detects word overflow before narrowing. Widening
# multiplication uses the target's high-half instruction, or its inline 32-bit decomposition.
# A Dewy shift count is unsigned, and a count of at least the register width
# reaches the shift's continuation bits: 0, or the sign for a signed right
# shift. Narrower types are already 0 or sign-filled past their width once
# normalized. The machine masks the count, so a count not known to be below
# 64 pays for a branch-free mask shared by shifts of the same count: all ones
# within range, else zero. A left or unsigned right shift is ANDed with it; a
# signed right shift sets the count's low bits, making the machine shift by 63.
# An unsigned bound on a shift count from its syntax: the literal itself (64
# for any count of at least 64, or a negative one), or the mask of
# `count & mask`; -1 when unknown.
# signed / and % of 64-bit integers wrap like other arithmetic: the smallest integer / -1 is
# itself and % -1 is 0 (the machine's division would trap on the quotient)
# the offsets of the Textures in a value of type t (at offset base), into out
# does expression n call a function (directly, or formatting a part of a string)?
# can evaluating n change what an assignment's destination indices read: a call, an assignment
# or a statement inside it, or an operation that resizes or formats through user code?
# does index n read the same before and after rhs runs, with nothing of its own to run or trap:
# literals and plain locals rhs does not write, under arithmetic with no storage check?
# Checked exact stores are conversion nodes and must be captured. O(nodes of n x nodes of rhs)
# ---------------- vectors ----------------
# f32 x as an i32: toward zero, saturating, NaN to 0
# ---------------- intrinsics ----------------
struct LoanCapacity:
    place: PlaceIdentity
    limit: int
loan_capacities: LoanCapacity[]

# O(1) intrinsic dispatch and indexed operand reads. Each handler performs
# only its own lowering and helper work; list offsets survive AST/list growth.
# `xs.ptr[i]`'s base: the elements' address without data()'s null test. A nil array has
# no element to reach, so the indexed address is out of bounds either way.
# the array's header pointer for data() node e (null for a nil array)
# Typed JSON writing uses the field writers selected by the checker. It emits
# directly into the caller's buffer, without a text round trip or a Json tree.
# ---------------- conversions ----------------
# a string set's word w as the word of the same member in set type `to` (members are
# unordered: one set's word for a member is not another's); a member `to` lacks panics
# ---------------- expressions ----------------
# (after code that never comes back: a value of n's type when it is taken as one, "a" + panic(...))
# any value of type t, where one is wanted after code that never comes back (it is never used)
# Dispatch once by the checked AST kind. Case-local scratch is constructed
# only in the selected handler; recursive children still lower exactly once.
# a struct constructor whose arguments cannot run code (so it may be built in place)
# [a, b, c], [] (zeros) or [v] * N as a fixed-size array: built in place
# Completed element temporaries remain the cleanup authorities until the
# whole fixed array is constructed. Zero-filled storage is never a live owner.
# ---------------- conditions as branches ----------------
# A constant interval test on the same ordinary integer read needs one
# unsigned comparison: low <= x <= high is (u64(x) - u64(low)) <= u64(high-low).
# The subtraction wraps, so negative values and intervals crossing zero work.
# Two ordinary reads with no intervening user code. Keep this deliberately
# shallow: array loads use a local receiver and a local/literal index, and no
# raw pointers, deferred aliases or mutable parameters are admitted.
# Recognize the adjacent comparisons at the end of a guarded chain without
# evaluating their array read before the guard: (guard and low) and high becomes
# guard and (low and high). The same grouping preserves ordered `or` evaluation.
# `and` / `or` / `not` in if/while conditions become jumps instead of boolean values.
# Each leaf is its own small statement, so its temporaries are dropped before branching.
# A fresh integer comparison can produce its complement directly. Keep the
# boolean inversion for other values, including unordered float comparisons.
# continue when e is true, branch to `level` when it is false
# continue when e is false, branch to `level` when it is true
# ---------------- statements ----------------
# Dewy gives each value parameter a same-named mutable local. When that local
# stays read-only, it can use the borrowed parameter storage instead of copying
# and retaining it again. Calls already preserve borrowed parameter snapshots.
# The checker records writes and raw exposures when checking those operations;
# captures, address-taking and buffer access retain their owned local storage.
# ---------------- views ----------------
# `b = agents[j]` copies a struct out of an array (and retains what it holds), but when b is
# only read, and nothing can change agents while b is used, b can be the element itself: a
# pointer into the array, with no copy and no reference counting (release builds).
cur_block = 0                  # the block whose statement is being lowered, and its index
cur_block_i = 0

# Only direct reads: custom getters, calls and computed indexes outside this
# whitelist stay on the ordinary snapshot path. Alias identifiers
# can expand into expressions, so do not assume that reading them is inert.
# A walk down a tree, `cur = n` and then `loop let c = cur: cur = c.left`, or a match on a
# parameter, `match e: .bin(op, l, r): ...`, would copy each node it passes into a variable (and
# retain what the node holds, to release it after). What a parameter holds stays as it is for the
# whole call: the function cannot change it, and a caller gives a copy of what the call could
# change (borrow_may_change). So a variable only ever given parts of a parameter (through fields,
# boxed ones too, `!` and narrowing), or parts of other such variables, and never changed through,
# can be the address of the part: no copy and no reference counting (release builds, and
# recursive records in default builds). These
# held views are plain variables (given another part by assignment), the names of `if let` and
# `loop let`, and the value a match or a variant `if let` / `loop let` looks at, whose names stand
# for its fields.
const LF_HELDVIEW = 2097152    # lowering-only; reset before a repeated lowering
const LF_ELEMENTVIEW = 4194304 # array element address, protected through its last use
held_views: {int: bool}         # the held views of the function being lowered
hv_given: (int, int)[]          # (finding them) each variable and a value it is given
hv_cand: {int: bool}            # ... the variables given values
hv_bad: {int: bool}             # ... those that cannot be views
hv_lambda = false               # ... a closure is made (none then: it may change what it captures)

# Optional held views use null for none, otherwise an address biased by BOX_HDR.
# A recursive optional field already stores exactly that pointer, so advancing
# a read-only cursor becomes one pointer load. Its presence check needs no tag
# load or default-address selection. Only general value reads materialize the
# ordinary optional address; this representation never escapes the function.
# a parameter whose parts can be views: a value in memory the function cannot change
# place p is written: what it is in cannot be a view
# is p a part of a parameter or of a view (as views are assumed so far)?
# is e a variable (or a field path of one) that code n cannot change?
# the variable a path of writes starts at (through fields and indexes); 0 if none
# could code n change the variable at ident node rn (a global, or a local)?
# a conversion of an array or string to a raw pointer (through which it may be written)
# do the calls in n leave the variable at ident node rn (a global or a mut parameter) alone:
# not change it, nor (written: the code writes its elements in place) copy it?
# ---- the globals a function may write ----
# Itself or through the functions it calls; `all` when it calls a function value (anything).
struct FnWrites:
    all: bool
    globals: int[]
    calls: int[]
    mentions: int[]             # the globals it names at all
fw_direct: {int: FnWrites}      # by function: what its own body does
fw_total: {int: FnWrites}       # ... and with everything it calls

# the globals f and the functions it calls by name write, also past calls of function values
# (fn_writes stops at the first of those: `all`)
fw_named: {int: FnWrites}
# ---- the global arrays a function may resize ----
# (for `loop mut` over a global's array: a function called in its body that adds to it, removes
# from it or replaces it, itself or through the functions it calls by name)
fr_direct: {int: int[]}
fr_total: {int: int[]}
# (a global whose array this may resize: push and the like on it, a whole array or a field path
# of it assigned, or it given to a function as mut)
# the first call in n (not in a function written in it) of a function that may resize global g
# ---- bounds checks that cannot fail ----
# In `for j in K..A.len()` (K a non-negative literal; the bound may also be a variable declared
# as `n := A.len()` and never changed) where A is never modified in the function, A[j] is in
# Stepped ranges compare the original endpoint, without end+1 arithmetic.
# Open ranges retain the exact two-word step. Each next value has a storage
# obligation; bounded ranges use a proven iteration count instead.
# Element replacement can detach storage but cannot change its length. Reuse
# the loop's storage inventory for this narrower question; an opaque use,
# replacement, resize or an ambient call that can reach the root refuses it.
# A leading `if not (i < stop): break` on an open unit range is a bounded
# range when stop cannot change. Combined Dewy loop headers produce exactly
# this guard. Reuse bounded lowering (including its index facts) without an
# extra exhaustion counter, and leave dynamic/effectful headers alone.
# A comprehension into a fixed-size array of plain elements fills the array's
# own storage: its accumulator stays empty, and a count it does not reach (or
# would pass) is the length mismatch the copy would report.
fixed_fill_push = 0
fixed_fill_slot = 0
fixed_fill_count = 0
fixed_fill_type = 0
fixed_fill_exact = false

# Straight-line Dewy comprehensions own an unnameable accumulator and append
# one result per iteration. Reserve once from a range bound or array snapshot.
# a comprehension's in-bounds push (NF_COMPREHENSION) -> the loop's index local, the slot it writes
comprehension_push_index: {int: int} = {}

# is an element loop done: index i past the end (more: is there more instead)
# ---------------- array paths fixed during a loop ----------------
# In a range loop (release builds), an array reached by a path -- a local variable or mut
# parameter and fields of it: xs, w.xs, ps.x -- that the loop cannot replace, resize or hand to
# anything that could, has its data pointer and length read once in front of the loop: indexing
# it then costs one compare, none when the index is the variable of a loop up to its length.
# A path the loop writes elements of gets its copy-on-write check there too, unless a copy of
# it (or of what holds it) is made in the loop.
struct FixedPath:
    key: int
    arr: int            # vreg: the array
    len: int            # vreg: its length
    loopvar: int        # local: indexes by this loop variable are in bounds (-1: none)
fixed_paths: FixedPath[]

fp_bases: int[]         # index bases in the loop that are paths
fp_kill: int[]          # paths the loop may replace or resize (with everything inside them)
fp_escape: int[]        # paths copied or handed on by value in the loop
fp_written: int[]       # paths whose elements the loop writes
fp_calls = false        # the loop calls code that might reach a mut parameter's variable
fp_lambda = false

# Canonical paths live for one lowered function. Roots use the low 32 bits
# (symbol index plus local/global tag); field edges use a nonzero parent ID in
# the high 32 bits and the field index below it. Symbol/field indexes are i32.
# Zero is not a path. Walking parents replaces string-prefix comparisons.
lpath_ids: {int: int} = {}
lpath_parents: int[] = [0]

# the variable a path starts at (its ident node)
# k is p or a path that p is inside of
# where loop body n changes how many elements path `key` has, or replaces it, by itself (not
# through what it calls): 0 if it does not. (`loop mut` writes the elements in place: a body
# adding or removing them would skip or repeat elements.)
# the paths of loop s (with variable l) fixed during it; returns how many were added
# (place: the array of a `loop mut x in place`, whose elements the loop writes)
# ---------------- uniqueness hoisting ----------------
# A loop that writes elements of a local array but never lets the array escape (it is only
# indexed, measured or changed in place) keeps the array uniquely owned, so one copy-on-write
# check before the loop replaces the check at every element write (release builds).
uniq_locals: int[]          # locals known to be unique while lowering the current loop

# hoist the uniqueness checks of a loop's arrays in front of it; returns how many were added
# Closed-program array ownership. A global whose storage is always fresh and
# never copied or exposed cannot require detaching at an element write. Keep
# this separate from loop-local uniqueness: it holds across calls as well.
uniq_globals: bool[]

# a loop condition that is cheap to test twice and computes nothing the body could reuse:
# comparisons of variables and literals (i < j, k != 0, done), and/or/not of those
use 'scanloops.jo'
use 'exact_reset_loop.jo'
use 'lower_ffi.dewy'
use 'lower_functions.dewy'
use 'lower_primitives.dewy'
use 'lower_intrinsics.dewy'

# ---------------- functions ----------------
find_ids: int[]
# (the bytes Op.findb looks for, packed, for a runtime function so made (lib/core/str.jo); -1:
# not one; -2: the dynamic-byte __memchr)
lop_watch = false       # (loops in this function count down to the web page's watchdog)

# Only functions with demanded insertions or construction/owner placeholders
# need a final IR walk. P requested zeros cost O(P log P) ordering and one
# O(IR + P) merge; the ordinary path is O(1), with no full-code copy or scan.
# Equal instruction boundaries retain statement-entry order through the serial.
# ---------------- generated helper functions ----------------
# a loop over the elements of fixed-size array type t: i counts 0..N (the body goes between)
# Value equality/hash can call user-defined member operations. Keep the
# enclosing value alive and independent throughout those calls, including a
# surrounding array whose owner a callback could replace. When all reachable
# member operations leave global state alone, helpers keep the pure read path.
value_member_cache: {int: int[]} = {}

# Calls made by generated aggregate helpers still participate in ordinary
# alias/effect analysis, just like calls written explicitly in the source.
# a box's last reference gone: its value dropped and the box freed. Boxes that dropping it frees
# wait their turn (__box_defer), so a list a million long is freed in a loop, not a million calls
# deep: the first box dropped on a thread drops those after it (__box_next)
# (the box p's value dropped, and the box freed)
# takes a box, gives back one with no other reference: itself, or a copy holding what it holds
# compare members at addresses a and b; branch to `fail` level when different
# Keyed (a dictionary's slots, lib/core/map.jo): every member word mixed under the process's
# secret key (__hk_mix), strings by __hk_bytes, and a type's own hash's result under the key.
hk_key = 0          # (the key's register in the keyed helper being lowered, else 0)

# the bits of float v, with -0.0 as 0.0 (they are equal)
# does helper_hash for t do more than hash_member for t (which would call it again)?
# A spawn body (dewy_nodes.jo's dw_task_spawn, aux2 17) runs once, in its task: the
# task runtime's copies of it share one environment, whose captures, owners among them,
# are dropped once, with the last copy.
# Only owned, unshared resource captures can move out of a run-once body.
# Nested shared captures and borrowed places keep their existing restrictions.
# native FFI: a thunk that resolves the C function on first use and calls it
# macOS: the C functions dyld puts in their slots when the program starts: (slot's offset in the
# data, library, symbol) -- compiler/macho.jo writes them as binds
mac_imports: (int, str, str)[]

# (macOS: the library dyld binds a C function from when the program starts, or "" for one loaded
# when first called (dlopen): system libraries by path, and Linux's libc as libSystem)
# (macOS: code compiled for a program already running -- the prompt's inputs, sloppy watch's
# later builds -- finds C functions when first called: dyld bound only what the program used.
# Not the functions that finding them takes, dlopen and dlsym: those programs have them bound,
# lib/std/repl.jo and lib/std/watch.jo)
late_binding = false

# An optional raw pointer (Dewy's ptr<T>?), null at the C boundary when none.
# Embedded values have no independent stack record: their complete enclosing
# owner is the cleanup authority. Partial construction retains the field's
# temporary owner until the enclosing object is complete.
# Publish only successfully initialized elements. The array owns the prefix
# during failures in later constructors; each pending element owns itself.
# Eager resource snapshots never retain the source. Allocation may fail before
# any new element exists; inline element copy hooks have no-failure summaries.
# Unlike inline hooks, recursive copies can allocate. Hold each completed
# child independently until the complete result can be handed to the caller.

use 'exact_guards.jo'
use 'exact_loop.jo'
use 'exact.jo'
use 'pcheck.jo'
use 'icount.jo'
use 'places.jo'
use 'facts.jo'
use 'refine.jo'
use 'units.jo'
use 'poly_closure.jo'
import 'concurrency.jo' as concurrency
use 'isolation.jo'
use 'fused.jo'
# Lowering: typed AST -> IR, including reference counting, copy-on-write and closures.
use 'copies.jo'
use 'ownership.jo'
# Ownership rules: function parameters are borrowed; results of calls and constructors are
# owned. Owned temporaries used in borrowing positions are released at the end of the
# statement. Copying a borrowed value into storage retains it.

use 'util.jo'
use 'lex.jo'
use 'ast.jo'
use 'types.jo'
use 'check.jo'
use 'expr.jo'
use 'effects.jo'
use 'ir.jo'
use 'glsl.jo'
use 'spirv.jo'
use 'msl.jo'
use 'pe.jo'
use 'math_lower.jo'
use 'callback_specialize.jo'
use 'parallel_lower.jo'
use 'partition.jo'
use 'floats.jo'
use 'arena.jo'

const VC_VOID = 0
const VC_INT = 1
const VC_FLT = 2
const VC_AGG = 3

const LK_INST = 0
const LK_HELPER = 1

enum HK: drop, copy, move, arrrel, arruniq, arrcopy, eq, hash, thunk, envdrop, partial, envcopy, stackenvdrop, boxrel, boxdrop, boxuniq, math_main, owner_boxcopy, parallel_serial, parallel_job, partition, promote

struct LFunc:
    kind: int
    inst: int
    hkind: HK
    htype: int
    name: str

lfuncs: LFunc[]
inst_lf: {int: int} = {}
helper_lf: {str: int} = {}
# Demanded helpers are inventoried by their existing LFunc identity. The string
# map remains the cold publication interface for fused-worker reconciliation;
# ordinary lowering probes integer keys without formatting or allocating.
# Open addressing: expected O(1) lookup, amortized O(1) insertion.
helper_slots: i32[]

helper_key_hash = (hk: HK, t: int, p: int) -> int:
    (int(hk) * 73856093) xor (t * 19349663) xor (p * 83492791)

helper_slot = (hk: HK, t: int, p: int) -> int:
    mask = helper_slots.len() - 1
    i = helper_key_hash(hk, t, p) & mask
    loop helper_slots[i] != 0:
        h = &lfuncs[int(helper_slots[i]) - 1]
        if h.hkind == hk and h.htype == t and h.inst == p: return i
        i = (i + 1) & mask
    i

helper_count = 0

# data segments
rodata: u8[]
ro_starts: int[]            # where each item (a string, a constant, an array) in rodata starts
str_off: {str: int} = {}
data_size = 8     # offset 0 holds the initial stack pointer
# data words keeping the C functions found: their offsets and library|name
ffi_offs: int[]
ffi_keys: str[]
ffi_slot: {int: int} = {}       # offset -> index
glsl_of: {int: str} = {}        # (sloppy watch) shader() node -> the GLSL made for it
global_off: {int: int} = {}
entry_points: int[]

# relocations inside rodata/data that hold function addresses or data addresses are not needed:
# all addresses are computed by code.

lf_of_inst = (f: int) -> int:
    if parallel_serial and not modules[int(fns[f].mod)].is_prelude and fns[f].kind != FK_PARTIAL and fns[f].body != 0:
        return lf_helper(.parallel_serial, 0, f)
    if let x = inst_lf.get(f):
        if fused_on and x >= fz_lf0: fz_note(0, x, f, 0, 0)
        return x
    lfuncs.push(LFunc(LK_INST, f, .drop, 0, fns[f].sym))
    x = lfuncs.len() - 1
    inst_lf[f] = x
    if fused_on: fz_note(0, x, f, 0, 0)
    x

lf_helper = (hk: HK, t0: int, p: int) -> int:
    # (a secret's helpers are its value's: secrets.jo)
    t = if secrets_seen: secret_repr(t0) else: t0
    if helper_slots.len() == 0: helper_slots = fill(0, 64)
    slot = helper_slot(hk, t, p)
    if helper_slots[slot] != 0:
        x = int(helper_slots[slot]) - 1
        if fused_on and x >= fz_lf0: fz_note(1, x, int(hk), t, p)
        return x
    lfuncs.push(LFunc(LK_HELPER, p, hk, t, "__h_{hk}_{lfuncs.len()}"))
    x = lfuncs.len() - 1
    helper_slots[slot] = i32(x + 1)
    helper_lf["{int(hk)}:{t}:{p}"] = x
    helper_count += 1
    if helper_count * 2 > helper_slots.len():
        old = helper_slots
        helper_slots = fill(0, helper_slots.len() * 2)
        loop entry in old:
            if entry == 0: continue
            h = &lfuncs[int(entry) - 1]
            helper_slots[helper_slot(h.hkind, h.htype, h.inst)] = entry
    if fused_on: fz_note(1, x, int(hk), t, p)
    x

rt = (name: str) -> int: lf_of_inst(runtime_fn(name))

# object header words (refcount, length, capacity, closure drop function): a memory class of
# their own, so stores to elements do not invalidate what the optimizer knows about them
hdr_load = (p: int, off: int) -> int: e_load(VI, p, off, 8 | M_HDR)
hdr_store = (p: int, off: int, v: int): e_store(p, off, v, 8 | M_HDR)

# value of a runtime global (by name, from the prelude)
rt_global = (name: str) -> int:
    s = prelude.get(intern(name)) ?? 0
    if s == 0 or syms[s].kind != .global: ice("missing runtime global {name}")
    e_load(VI, e_gaddr(global_addr_off(int(syms[s].ref))), 0, 1)

# call to a function that never returns (panics): registers need not survive it
# Fixed-arity calls append evaluated operands directly to the shared IR span.
e_call_nr0 = (f: int, rtype: int) -> int:
    start = ir.args.len()
    emit(.call, rtype, -1, start, 0, 1, f)
    -1

e_call_nr1 = (f: int, a0: int, rtype: int) -> int:
    start = ir.args.len()
    ir.args.push(i32(a0))
    emit(.call, rtype, -1, start, 1, 1, f)
    -1

e_call_nr2 = (f: int, a0: int, a1: int, rtype: int) -> int:
    start = ir.args.len()
    ir.args.push(i32(a0))
    ir.args.push(i32(a1))
    emit(.call, rtype, -1, start, 2, 1, f)
    -1

e_call_nr3 = (f: int, a0: int, a1: int, a2: int, rtype: int) -> int:
    start = ir.args.len()
    ir.args.push(i32(a0))
    ir.args.push(i32(a1))
    ir.args.push(i32(a2))
    emit(.call, rtype, -1, start, 3, 1, f)
    -1

e_call_nr4 = (f: int, a0: int, a1: int, a2: int, a3: int, rtype: int) -> int:
    start = ir.args.len()
    ir.args.push(i32(a0))
    ir.args.push(i32(a1))
    ir.args.push(i32(a2))
    ir.args.push(i32(a3))
    emit(.call, rtype, -1, start, 4, 1, f)
    -1

e_call_nr = (f: int, args: int[], rtype: int) -> int:
    start = ir.args.len()
    loop a in args: ir.args.push(i32(a))
    emit(.call, rtype, -1, i32(start), i32(args.len()), 1, f)
    -1

str_data = (s: str) -> int:
    if let o = str_off.get(s):
        if fused_on and o >= fz_r0: fz_note_text(2, o, s)
        return o
    loop rodata.len() % 8 != 0: rodata.push(0)
    o = rodata.len()
    ro_starts.push(o)
    push_i64(rodata, -1)
    push_i64(rodata, len(s))
    push_i64(rodata, len(s) + 1)
    n = rodata.len()
    rodata.resize(n + len(s))
    if len(s) > 0: mem_copy(data(rodata) + n, data(s), len(s))
    rodata.push(0)
    str_off[s] = o
    if fused_on: fz_note_text(2, o, s)
    o

# A string set's texts as one read-only block: each member's offset from the
# block's start, then the members as static strings (str_data's layout). The
# block refers only within itself, so it moves as a whole. (fused.jo's layout:
# a block per use, the same bytes however the functions are shared out)
set_text_tables: {int: int} = {}
set_text_table = (id: int) -> int:
    if not fz_layout:
        if let o = set_text_tables.get(id): return o
    loop rodata.len() % 8 != 0: rodata.push(0)
    o = rodata.len()
    ro_starts.push(o)
    texts = str_sets[id]
    at = 8 * texts.len()
    loop text in texts:
        push_i64(rodata, at)
        at += (24 + len(text) + 1 + 7) / 8 * 8
    loop text in texts:
        push_i64(rodata, -1)
        push_i64(rodata, len(text))
        push_i64(rodata, len(text) + 1)
        n = rodata.len()
        rodata.resize(n + len(text))
        if len(text) > 0: mem_copy(data(rodata) + n, data(text), len(text))
        rodata.push(0)
        loop rodata.len() % 8 != 0: rodata.push(0)
    if fused_on: fz_note_raw(o, 8)
    set_text_tables[id] = o
    o

push_i64 = (b: mut u8[], v: int):
    loop i in [0..8): b.push(u8((v >> (8 * i)) & 255))

global_addr_off = (g: int) -> int:
    if let o = global_off.get(g):
        if fused_on and o >= fz_d0: fz_note(3, o, g, 0, 0)
        return o
    t = int(globals[g].type)
    al = talign(t)
    if al < 8: al = 8
    data_size = align_up(data_size, al)
    o = data_size
    sz = tsize(t)
    if sz < 8: sz = 8
    data_size += sz
    global_off[g] = o
    if fused_on: fz_note(3, o, g, 0, 0)
    o

# ---------------- type helpers ----------------
# Representation plans belong to one lowering invocation. Only demanded types
# acquire entries; epochs avoid a types-by-functions clearing pass. Lazy helper
# discovery may append types, and a later lowering (watch/replay included) never
# reuses a previous invocation's classification.
struct LowerTypePlan:
    epoch: int
    value_class: int
    vtype: int

lower_types: LowerTypePlan[]
lower_epoch = 0
lower_planning = false

lower_type_plan = (t0: int) -> *LowerTypePlan:
    if t0 >= lower_types.len(): lower_types.resize(max(t0 + 1, lower_types.len() * 2))
    plan = &lower_types[t0]
    if plan.epoch == lower_epoch: return plan
    t = quantity_base(t0)
    k = types[t].kind
    c = VC_INT
    v = VI
    if k == .void_ or k == .typeval or k == .module: c = VC_VOID
    else if k == .float_:
        c = VC_FLT
        v = if int(types[t].bits) == 32: VS else: VF
    else if is_aggregate(t): c = VC_AGG
    plan.value_class = c
    plan.vtype = v
    plan.epoch = lower_epoch
    plan

vc = (t0: int) -> int:
    if lower_planning: return lower_type_plan(t0).value_class
    t = quantity_base(t0)
    k = types[t].kind
    if k == .void_ or k == .typeval or k == .module: return VC_VOID
    if k == .float_: return VC_FLT
    if is_aggregate(t): return VC_AGG
    VC_INT

vt_of = (t0: int) -> int:
    if lower_planning: return lower_type_plan(t0).vtype
    t = quantity_base(t0)
    if types[t].kind == .float_:
        if int(types[t].bits) == 32: return VS
        return VF
    VI

mem_mode = (t0: int) -> int:
    t = quantity_base(t0)
    k = types[t].kind
    s = tsize(t)
    if k == .float_: return s | M_FLOAT
    if k == .int_ and types[t].sign: return s | M_SIGNED
    s

load_val = (t: int, addr: int, off: int) -> int:
    if vc(t) == VC_AGG: return e_addi(addr, off)
    if vc(t) == VC_VOID: return -1
    e_load(vt_of(t), addr, off, mem_mode(t))

store_val = (t: int, addr: int, off: int, v: int):
    c = vc(t)
    if c == VC_AGG: e_copy(e_addi(addr, off), v, tsize(t))
    else if c != VC_VOID: e_store(addr, off, v, mem_mode(t))

norm = (v: int, t0: int) -> int:
    t = quantity_base(t0)
    k = types[t].kind
    if k == .bool_: return e_un(.zext8, VI, v)
    if k != .int_: return v
    s = tsize(t)
    sg = types[t].sign
    if s == 1:
        if sg: return e_un(.sext8, VI, v)
        return e_un(.zext8, VI, v)
    if s == 2:
        if sg: return e_un(.sext16, VI, v)
        return e_un(.zext16, VI, v)
    if s == 4:
        if sg: return e_un(.sext32, VI, v)
        return e_un(.zext32, VI, v)
    v

zero_val = (t: int) -> int:
    if vt_of(t) == VI: return e_iconst(0)
    e_fconst(0.0, vt_of(t))

# ---------------- function state ----------------
struct Val:
    v: int
    owned: bool
    slot: int

struct Place:
    mem: bool
    v: int
    math_opt: bool = false

struct TempItem:
    is_slot: bool
    ref: int
    t: int
    cond: bool
    stack_target: int = -1

struct LoopInfo:
    brk: int
    cont: int
    scope: int
    items: int
    built: int

# A value whose children are still being evaluated. init is a deferred zero
# instruction (slots) or the allocation call (arrays), patched only if an early
# exit actually needs to drop an incompletely initialized managed value.
struct BuildItem:
    is_slot: bool
    ref: int
    t: int
    init: int = -1

building: BuildItem[]

cur_fn = 0
cur_ret = 0
sret_v = -1
env_v = -1
ctl = 0
cond_depth = 0
scope_locals: int[][]
scope_defers: int[][]
loops: LoopInfo[]
# Statement marks index one reusable temporary arena. No per-statement array
# is allocated; cleanup visits each held value once in reverse creation order.
tl_items: int[]
tl_values: TempItem[]
tl_nop: int[]
tl_cond: int[]

# A statement normally needs no entry-time initialization. Record a compact
# insertion boundary, and publish a zero request only for conditional temps.
# Unlike placeholder instructions these records do not enter the optimizer IR.
struct LowerZero:
    mark: int
    start: int
    count: int
lower_zeros: LowerZero[]
lower_mark_serial = 0
lower_has_nops = false

V = (v: int, owned: bool) -> Val: Val(v, owned, -1)

# ---------------- reference counting ----------------
# release builds (`opt = release`) inline the fast paths of refcounting, uniqueness and bounds
# checks; debug builds keep them out of line so the IR (and compile time) stays small.
opt_release = false

# (where __mt_active is among the globals, for the code generator's CALL_RC_INC and CALL_RC_DEC)
mt_active_off = -1
note_mt_active = ():
    # (a fused worker notes each function's use: fused.jo)
    if mt_active_off >= 0 and not fused_on: return
    s = prelude.get(intern("__mt_active")) ?? 0
    if s == 0 or syms[s].kind != .global: ice("missing runtime global __mt_active")
    mt_active_off = global_addr_off(int(syms[s].ref))

# rc <= 0 marks immortal objects
retain = (v: int, t0: int):
    t = quantity_base(t0)
    if math_optional(t):
        retain(e_bin(.xor, VI, v, e_iconst(1)), T_MATH_INT)
        return
    if t == T_MATH_INT:
        iff(math_tag(v))
        was = ir_cold
        ir_cold = true
        retain(e_addi(v, -1), math_payload_type())
        ir_cold = was
        endc()
        return
    if not opt_release:
        # (one call in the IR, which the code generator does inline when it can: CALL_RC_INC)
        e_call1(rt("__rc_inc"), v, -1)
        ir.code[ir.code.len() - 1].c = CALL_RC_INC
        note_mt_active()
        return
    # during a parallel job refcounts must be updated atomically (out of line)
    blk()
    done = ctl
    iff(rt_global("__mt_active"))
    was = ir_cold
    ir_cold = true
    e_call1(rt("__rc_inc"), v, -1)
    ir_cold = was
    br_to(done)
    endc()
    iff(e_bin(.ne, VI, v, e_iconst(0)))
    rc = hdr_load(v, 0)
    iff(e_bin(.gts, VI, rc, e_iconst(0)))
    hdr_store(v, 0, e_addi(rc, 1))
    endc()
    endc()
    endc()

release = (v: int, t0: int):
    t = quantity_base(t0)
    if math_optional(t):
        release(e_bin(.xor, VI, v, e_iconst(1)), T_MATH_INT)
        return
    if t == T_MATH_INT:
        iff(math_tag(v))
        was = ir_cold
        ir_cold = true
        release_call(e_addi(v, -1), math_payload_type())
        ir_cold = was
        endc()
        return
    if not opt_release:
        release_call(v, t)
        ir.code[ir.code.len() - 1].c = CALL_RC_DEC
        note_mt_active()
        return
    blk()
    done = ctl
    iff(rt_global("__mt_active"))
    was = ir_cold
    ir_cold = true
    release_call(v, t)
    ir_cold = was
    br_to(done)
    endc()
    iff(e_bin(.ne, VI, v, e_iconst(0)))
    rc = hdr_load(v, 0)
    iff(e_bin(.gts, VI, rc, e_iconst(1)))
    hdr_store(v, 0, e_addi(rc, -1))
    els()
    # last reference: the out-of-line path frees (and releases elements)
    iff(e_bin(.eq, VI, rc, e_iconst(1)))
    release_call(v, t)
    endc()
    endc()
    endc()
    endc()

# (the call dropping a reference to v, freeing it with the last: an array's elements and a box's
# value are released by a helper for the type)
release_call = (v: int, t: int):
    if types[t].kind == .array and is_managed(int(types[t].elem)): e_call1(lf_helper(.arrrel, t, 0), v, -1)
    else if types[t].kind == .box: e_call1(lf_helper(.boxrel, t, 0), v, -1)
    else: e_call1(rt("__rc_dec"), v, -1)

drop_at = (addr: int, t0: int):
    if ownership_type(t0):
        owner_drop(addr)
        return
    t = quantity_base(t0)
    if not is_managed(t): return
    if ownership_type(t):
        owner_drop(addr)
        return
    if vc(t) == VC_INT:
        release(e_load(VI, addr, 0, ptr_size), t)
        return
    e_call1(lf_helper(.drop, t, 0), addr, -1)

copy_at = (addr: int, t0: int):
    t = quantity_base(t0)
    if not is_managed(t): return
    if vc(t) == VC_INT:
        e_store(addr, 0, copy_ref(e_load(VI, addr, 0, ptr_size), t), ptr_size)
        return
    e_call1(lf_helper(.copy, t, 0), addr, -1)

# Arrays containing callable values must copy their environments too. Ordinary
# data arrays retain the normal COW path. This eager path is deliberately small:
# it also works when a callback is invoked by a borrowed implementation-library API.
copy_ref = (v: int, t: int) -> int:
    if ownership_type(t):
        if tkind(t) == .array: return e_call1(lf_helper(.arrcopy, t, 0), v, VI)
        if tkind(t) == .box: return e_call1(lf_helper(.owner_boxcopy, t, 0), v, VI)
    retain(v, t)
    k = types[prune(t)].kind
    if (k == .array or k == .box) and type_has_fn(t):
        return e_call1(lf_helper((if k == .array: HK.arruniq else: HK.boxuniq), t, 0), v, VI)
    v

# ---------------- temps ----------------
new_temp = (t: int) -> int: new_slot(tsize(t), talign(t))

reg_temp_slot = (s: int, t: int, stack_target: int = -1):
    if stack_target >= 0 and closure_scalar_environment(stack_target): return
    if not is_managed(t) or tl_items.len() == 0: return
    tl_values.push(TempItem(true, s, t, cond_depth > tl_cond[tl_cond.len() - 1], stack_target))

reg_temp_vreg = (v: int, t: int):
    if not is_managed(t) or tl_items.len() == 0: return
    # An empty literal is an immutable null constant. It owns no allocation,
    # and conditional cleanup must not try to clear its constant register.
    if is_kv(v) and kv_of(v) == 0: return
    tl_values.push(TempItem(false, v, t, cond_depth > tl_cond[tl_cond.len() - 1]))

borrow = (val: Val, t: int):
    if not val.owned or not is_managed(t): return
    if vc(t) == VC_AGG or ownership_type(t):
        if val.slot < 0: ice("owned aggregate without slot")
        reg_temp_slot(val.slot, t)
    else:
        # copy into a fresh vreg so later reassignment of the original can't confuse release
        # (the value may sit in a local's own vreg, which statement cleanup must not touch)
        c = vreg(VI)
        e_mov(c, val.v)
        reg_temp_vreg(c, t)

own = (val: Val, t: int) -> Val:
    if val.owned: return val
    if ownership_type(t):
        if not ownership_copyable(t): fatal(ir_pos, "cannot copy a move-only owner")
        if vc(t) == VC_INT: return owner_value(V(copy_ref(val.v, t), true), t)
        if let hook = ownership_copies.get(prune(t)): return owner_hook_result(hook, val.v, t)
        if let copier = owner_map_copies.get(prune(t)):
            slot = new_temp(t)
            addr = e_slot(slot)
            e_call2(lf_of_inst(copier), addr, val.v, -1)
            owner_register(slot, t)
            return Val(addr, true, slot)
        if is_map_type(t):
            slot = new_temp(t)
            addr = e_slot(slot)
            e_zero(addr, tsize(t))
            owner_register(slot, t)
            loop field in field_list(t):
                child = own(Val(load_val(field.0, val.v, field.1), false, -1), field.0)
                store_val(field.0, addr, field.1, child.v)
                if ownership_type(field.0): owner_forget_slot(child.slot)
            return Val(addr, true, slot)
        slot = new_temp(t)
        addr = e_slot(slot)
        e_copy(addr, val.v, tsize(t))
        copy_at(addr, t)
        owner_register(slot, t)
        return Val(addr, true, slot)
    if vc(t) == VC_AGG:
        s = new_temp(t)
        a = e_slot(s)
        e_copy(a, val.v, tsize(t))
        if is_managed(t): copy_at(a, t)
        return Val(a, true, s)
    if is_managed(t): return Val(copy_ref(val.v, t), true, -1)
    Val(val.v, true, -1)

gen_owned = (e: int) -> Val:
    if copies_on: return copy_own(e, gen_expr(e), ntype(e))
    own(gen_expr(e), ntype(e))
gen_borrowed = (e: int) -> Val:
    v = gen_expr(e)
    borrow(v, ntype(e))
    Val(v.v, false, -1)

stmt_begin = ():
    positive_epoch += 1
    tl_items.push(tl_values.len())
    lower_mark_serial += 1
    tl_nop.push((ir.code.len() << 32) | lower_mark_serial)
    tl_cond.push(cond_depth)

stmt_end = ():
    start = tl_items.pop()
    end = tl_values.len()
    nop = tl_nop.pop()
    tl_cond.pop()
    # Append the demanded zero inventory directly into the IR argument arena.
    args_start = ir.args.len()
    loop i in [start..end):
        it = tl_values[i]
        if it.cond: ir.args.push(i32(it.ref * 2 + int(not it.is_slot)))
    count = ir.args.len() - args_start
    if count > 0:
        lower_zeros.push(LowerZero(nop, args_start, count))
    i = end - 1
    loop i >= start:
        it = tl_values[i]
        if it.is_slot:
            a = e_slot(it.ref)
            if it.stack_target >= 0: drop_stack_closure(a, it.stack_target)
            else: drop_at(a, it.t)
            if it.cond: e_zero(a, tsize(it.t))
        else:
            release(it.ref, it.t)
            if it.cond: e_mov(it.ref, e_iconst(0))
        i -= 1
    tl_values.truncate(start)

# Keep ordinary construction unchanged: a placeholder becomes a zero only
# when return/break/continue can bypass writes to some managed fields.
build_slot = (s: int, t: int, needs_zero: bool = false) -> bool:
    if not is_managed(t): return false
    at = -1
    if needs_zero:
        lower_has_nops = true
        at = emit(.nop, 0, 0, e_slot(s), 0, 0, 0)
    building.push(BuildItem(true, s, t, at))
    true

drop_held = (items: int, built: int):
    k = building.len() - 1
    loop k >= built:
        it = building[k]
        if it.init >= 0:
            ins = ir.code[it.init]
            if it.is_slot:
                ins.op = .zero
                ins.imm = tsize(it.t)
            else: ins.imm = rt("__arr_repeat")
            ir.code[it.init] = ins
        if it.is_slot: drop_at(e_slot(it.ref), it.t)
        else: release(it.ref, it.t)
        k -= 1
    if items < tl_items.len():
        start = tl_items[items]
        k = tl_values.len() - 1
        loop k >= start:
            it = tl_values[k]
            if it.is_slot:
                if it.stack_target >= 0: drop_stack_closure(e_slot(it.ref), it.stack_target)
                else: drop_at(e_slot(it.ref), it.t)
            else: release(it.ref, it.t)
            k -= 1

enter_cond = (): cond_depth += 1
leave_cond = (): cond_depth -= 1

# ---------------- structured control ----------------
blk = ():
    e_block()
    ctl += 1
lop = ():
    e_loop()
    ctl += 1
    if lop_watch:
        # (a web page: each pass counts down, and every million the watchdog asks how long the
        # page has been running without a break: a loop that never ends is stopped, its output
        # shown, rather than the page hanging)
        g = e_gaddr(global_addr_off(int(syms[prelude.get(intern("__loop_budget")) ?? 0].ref)))
        v = e_bin(.sub, VI, e_load(VI, g, 0, 8), e_iconst(1))
        e_store(g, 0, v, 8)
        iff(e_bin(.lts, VI, v, e_iconst(0)))
        e_call0(rt("__loop_watchdog"), -1)
        endc()
iff = (c: int):
    e_if(c)
    ctl += 1
els = (): e_else()
endc = ():
    e_end()
    ctl -= 1
# branch to the construct opened at nesting level `level` (1-based count of open constructs)
br_to = (level: int): e_br(ctl - level)
brif_to = (c: int, level: int): e_brif(c, ctl - level)

# ---------------- scopes ----------------
scope_push = ():
    scope_locals.push([])
    scope_defers.push([])

scope_add_local = (l: int):
    if scope_locals.len() == 0: return
    f = int(locals[l].flags)
    if not is_managed(store_type(l)) or f & (LF_CAPTURE | LF_ALIAS | LF_BYREF) != 0: return
    if f & LF_PARAM != 0 and not copy_inputs.has(l): return
    if ownership_type(store_type(l)): owner_register(int(locals[l].offset), store_type(l))
    scope_locals[scope_locals.len() - 1].push(l)

emit_scope_exit = (i: int):
    ds = scope_defers[i]
    k = ds.len() - 1
    loop k >= 0:
        d = ds[k]
        saved = scope_defers[i]
        scope_defers[i] = ds[..k)
        if concurrency.concurrency_runtime_needed: e_call0(rt("__task_shield_enter"), -1)
        if nodes[d].kind == .block:
            scope_push()
            gen_block_stmts(d)
            emit_scope_exit(scope_locals.len() - 1)
            scope_locals.pop()
            scope_defers.pop()
        else: gen_stmt(d)
        if concurrency.concurrency_runtime_needed: e_call0(rt("__task_shield_leave"), -1)
        scope_defers[i] = saved
        k -= 1
    ls = scope_locals[i]
    k = ls.len() - 1
    loop k >= 0:
        l = ls[k]
        t = store_type(l)
        if parallel_owned.has(l):
            loop value in parallel_scalars[l]:
                release(value, parallel_owned[l])
                e_mov(value, e_iconst(0))
        else if locals[l].offset >= 0:
            a = e_slot(int(locals[l].offset))
            target = if tkind(t) == .fn_ or tkind(t) == .polyfn: stack_closure_target(l) else: -1
            if target >= 0: drop_stack_closure(a, target)
            else: drop_at(a, t)
            if target < 0 or not closure_scalar_environment(target): e_zero(a, tsize(t))
        else:
            release(int(locals[l].vreg), t)
            e_mov(int(locals[l].vreg), e_iconst(0))
        k -= 1

scope_pop = ():
    emit_scope_exit(scope_locals.len() - 1)
    scope_locals.pop()
    scope_defers.pop()

opt_has = (addr: int, inner: int) -> int:
    if quantity_base(inner) == T_MATH_INT: return e_bin(.ne, VI, e_load(VI, addr, 0, 8), e_iconst(0))
    e_load(VI, addr, tsize(inner), 1)

opt_value = (addr: int, inner: int) -> int:
    if quantity_base(inner) == T_MATH_INT: return e_bin(.xor, VI, e_load(VI, addr, 0, 8), e_iconst(1))
    load_val(inner, addr, 0)

# ---------------- places ----------------
read_place = (p: Place, t: int) -> int:
    if p.math_opt: return e_bin(.xor, VI, (if p.mem: e_load(VI, p.v, 0, 8) else: p.v), e_iconst(1))
    if not p.mem: return p.v
    load_val(t, p.v, 0)

write_place = (p: Place, t: int, v: int):
    if p.math_opt:
        encoded = e_bin(.xor, VI, v, e_iconst(1))
        if p.mem: e_store(p.v, 0, encoded, 8)
        else: e_mov(p.v, encoded)
        return
    if not p.mem:
        e_mov(p.v, v)
        return
    store_val(t, p.v, 0, v)

place_addr = (p: Place, t: int) -> int:
    if p.mem and not p.math_opt: return p.v
    # a value in a register: spill to a temporary slot
    s = new_temp(t)
    a = e_slot(s)
    store_val(t, a, 0, read_place(p, t))
    a

# ---------------- boxes ----------------
# A boxed field (types.jo, decide_boxes) holds a pointer to [rc][value], null until it is given a
# value: an empty box reads as its type's default (box_dflt_off). Copies of what holds it share
# the box, and a write through it first makes the box the writer's own (box_unique), as an array
# is; a new value for the whole field is a new box (box_put).
const BOX_HDR = 8

# the type a field's memory holds: its value, or the box keeping it
field_store_type = (f: int) -> int:
    if fields[f].boxed: return mk_box(int(fields[f].type))
    int(fields[f].type)

# the boxed field (an index into fields) that field node e reads, or -1
boxed_field_of = (e: int) -> int:
    if nodes[e].kind != .field: return -1
    aux = int(nodes[e].aux)
    bt = prune(ntype(int(nodes[e].a)))
    if types[bt].kind == .ptr: bt = prune(int(types[bt].elem))
    f = -1
    if aux == -3:
        layout(bt)
        f = int(variants[int(structs[int(types[bt].st)].variants) + int(nodes[e].aux2)].fields) + int(nodes[e].ival)
    else if aux >= 0 and types[bt].kind == .struct_:
        layout(bt)
        f = int(structs[int(types[bt].st)].fields) + aux
    if f >= 0 and fields[f].boxed: return f
    -1

box_dflt_data: {int: int} = {}

# (the rodata offset of) the value an empty box of type t reads as
box_dflt_off = (t0: int) -> int:
    t = prune(t0)
    if let o = box_dflt_data.get(t):
        if fused_on and o >= fz_r0: fz_note(4, o, t, 0, 0)
        return o
    loop rodata.len() % 8 != 0: rodata.push(0)
    o = rodata.len()
    ro_starts.push(o)
    rodata.resize(o + max(tsize(t), 8))
    v = box_default(t)
    if v > 0:
        loop i in [0..4): rodata[o + i] = u8((v >> (8 * i)) & 255)
    box_dflt_data[t] = o
    if fused_on: fz_note(4, o, t, 0, 0)
    o

# the address of the value in box p (of a value of type t), or of the default when p is empty
box_val = (p: int, t: int) -> int:
    r = vreg(VI)
    e_mov(r, e_daddr(box_dflt_off(t)))
    iff(e_bin(.ne, VI, p, e_iconst(0)))
    e_mov(r, e_addi(p, BOX_HDR))
    endc()
    r

# the box at slot made the writer's own (a new one holding the default when it is empty, a copy
# when it is shared), for a write through it: the address of its value
box_unique = (slot: int, t: int) -> int:
    sz = tsize(t)
    iff(e_bin(.eq, VI, e_load(VI, slot, 0, ptr_size), e_iconst(0)))
    was = ir_cold
    ir_cold = true
    np = e_call1(rt("__box_new"), e_iconst(sz), VI)
    e_copy(e_addi(np, BOX_HDR), e_daddr(box_dflt_off(t)), sz)
    e_store(slot, 0, np, ptr_size)
    ir_cold = was
    endc()
    p = e_load(VI, slot, 0, ptr_size)
    bt = mk_box(t)
    if not opt_release:
        # (one call, which the code generator skips for a box with one reference: CALL_IF_SHARED)
        q = e_call1(lf_helper(.boxuniq, bt, 0), p, VI)
        ir.code[ir.code.len() - 1].c = CALL_IF_SHARED
        e_store(slot, 0, q, ptr_size)
        return e_addi(q, BOX_HDR)
    r = vreg(VI)
    e_mov(r, p)
    iff(e_bin(.ne, VI, hdr_load(p, 0), e_iconst(1)))
    was2 = ir_cold
    ir_cold = true
    e_mov(r, e_call1(lf_helper(.boxuniq, bt, 0), p, VI))
    e_store(slot, 0, r, ptr_size)
    ir_cold = was2
    endc()
    e_addi(r, BOX_HDR)

# the owned value v of type t put in the box at slot (empty, or its box already released): a new
# box, or none for none (an empty box reads as none)
box_put = (slot: int, t0: int, v: int):
    t = prune(t0)
    sz = tsize(t)
    is_opt = types[t].kind == .opt
    if is_opt:
        e_store(slot, 0, e_iconst(0), ptr_size)
        iff(e_load(VI, v, tsize(int(types[t].elem)), 1))
    p = e_call1(rt("__box_new"), e_iconst(sz), VI)
    e_copy(e_addi(p, BOX_HDR), v, sz)
    e_store(slot, 0, p, ptr_size)
    if is_opt: endc()

# owned value v stored in field f of the value at addr (whose memory there is zero, or released)
store_field = (f: int, addr: int, v: int):
    if fields[f].boxed: box_put(e_addi(addr, int(fields[f].offset)), int(fields[f].type), v)
    else: store_val(int(fields[f].type), addr, int(fields[f].offset), v)

# the address of field f's value in the value at addr, for reading
field_val_addr = (f: int, addr: int) -> int:
    a = e_addi(addr, int(fields[f].offset))
    if not fields[f].boxed: return a
    box_val(e_load(VI, a, 0, ptr_size), int(fields[f].type))

# (gen_place of a boxed field gives the field's own memory, the box pointer, when this is set:
# assign_to, giving it a new box)
box_slot = false
# (the last box a place for writing went through, made the writer's own, and its type)
pinned_box = -1
pinned_type = 0

field_place = (f: int, addr: int, write: bool, slot: bool) -> Place:
    a = e_addi(addr, int(fields[f].offset))
    if not fields[f].boxed or slot: return Place(true, a)
    if write:
        v = box_unique(a, int(fields[f].type))
        pinned_box = e_load(VI, a, 0, ptr_size)
        pinned_type = mk_box(int(fields[f].type))
        return Place(true, v)
    Place(true, box_val(e_load(VI, a, 0, ptr_size), int(fields[f].type)))

# ---------------- shared variables ----------------
# A variable that closures share by reference (LF_SHARED, see check.jo) lives in a cell: a
# one-element array. The variable (and each capture) holds the cell, and every access goes to its
# element, without copy-on-write, so all holders see the same value.
share_root = (l: int) -> int:
    r = l
    loop int(locals[r].flags) & LF_CAPTURE != 0 and int(locals[r].flags) & LF_VALUECAP == 0: r = int(locals[r].outer)
    r

is_shared = (l: int) -> bool: int(locals[share_root(l)].flags) & LF_SHARED != 0

# the type of what the variable's storage holds: the value, or the cell
store_type = (l: int) -> int:
    t = int(locals[l].type)
    if int(locals[l].flags) & (LF_OWNERBORROW | LF_PARTBORROW) != 0: return mk_ptr(t)
    if is_shared(l): return mk_array(t)
    t

cell_place = (l: int) -> Place:
    if int(locals[l].flags) & LF_CAPTURE != 0: return Place(true, e_addi(env_v, int(locals[l].env_off)))
    if locals[l].offset >= 0: return Place(true, e_slot(int(locals[l].offset)))
    Place(false, int(locals[l].vreg))

check_cell_type = (l: int):
    # (a cell holding a closure that holds the cell would never be freed: values that can hold
    # functions are not shared like this)
    if type_has_fn(int(locals[l].type)):
        nm = name_of(int(locals[l].name))
        fatal(int(locals[l].pos), "'{nm}' is changed after a closure captured it, and it can hold functions ({dt(int(locals[l].type))}): a closure kept in it would keep it alive forever. Make it a global, or pass it to the closure as {jd(int(locals[l].pos), "a `mut`", "an `@`")} parameter")
new_cell = (l: int):
    check_cell_type(l)
    sz = tsize(int(locals[l].type))
    if sz < 1: sz = 1
    write_place(cell_place(l), store_type(l), e_call2(rt("__arr_repeat"), e_iconst(1), e_iconst(sz), VI))

local_place = (l: int, write: bool) -> Place:
    f = int(locals[l].flags)
    if f & LF_OWNERBORROW != 0: return Place(true, e_load(VI, env_v, int(locals[l].env_off), ptr_size))
    if f & LF_ALIAS != 0: return gen_place(int(locals[l].alias), write)
    if is_shared(l): return Place(true, e_addi(read_place(cell_place(l), store_type(l)), 24))
    if f & LF_CAPTURE != 0: return Place(true, e_addi(env_v, int(locals[l].env_off)))
    if f & LF_BYREF != 0:
        v = int(locals[l].vreg)
        if f & LF_HELDVIEW != 0 and tkind(int(locals[l].type)) == .opt: v = box_val(v, int(locals[l].type))
        return Place(true, v)
    if f & LF_PARAM != 0:
        if f & LF_MUTPARAM != 0 or vc(int(locals[l].type)) == VC_AGG: return Place(true, int(locals[l].vreg))
    if locals[l].offset >= 0: return Place(true, e_slot(int(locals[l].offset)))
    Place(false, int(locals[l].vreg))

bounds_check = (arr: int, idx: int, pos: int):
    # arr: array object pointer (may be null), idx: index
    loc = loc_data(pos)
    if not opt_release:
        n = 0
        if target_wasm or target_arm64: n = arr_len(arr)
        else:
            # Select a real zero-length header for nil, without a hot branch.
            # Keep the comparison next to select so native lowering reuses flags.
            selected = vreg(VI)
            empty = e_daddr(str_data(""))
            condition = e_bin(.ne, VI, arr, e_iconst(0))
            emit(.select, VI, selected, condition, arr, empty, 0)
            n = hdr_load(selected, 8)
        iff(e_bin(.geu, VI, idx, n))
        e_call_nr3(rt("__panic_bounds"), idx, n, e_daddr(loc), -1)
        endc()
        return
    iff(e_bin(.eq, VI, arr, e_iconst(0)))
    e_call_nr3(rt("__panic_bounds"), idx, e_iconst(0), e_daddr(loc), -1)
    endc()
    n = hdr_load(arr, 8)
    iff(e_bin(.geu, VI, idx, n))
    e_call_nr3(rt("__panic_bounds"), idx, n, e_daddr(loc), -1)
    endc()

# the part of a bounds check that later checks build on: the array exists (release builds
# then know this for the rest of the scope)
null_check = (arr: int, idx: int, pos: int):
    iff(e_bin(.eq, VI, arr, e_iconst(0)))
    e_call_nr3(rt("__panic_bounds"), idx, e_iconst(0), e_daddr(loc_data(pos)), -1)
    endc()

# rodata offset of the "file:line" string for a position (consecutive checks share a line)
loc_last_file = -1
loc_last_line = -1
loc_last_off = 0

loc_data = (pos: int) -> int:
    f = pos_file(pos)
    l, c = line_col(pos)
    if f == loc_last_file and l == loc_last_line and not fused_on: return loc_last_off
    loc_last_file = f
    loc_last_line = l
    loc_last_off = str_data(loc_str(pos))
    loc_last_off

# A library position names no line of the program: the backtrace shows the
# program's call instead (`a // 0` fails in the caller, not in the library).
loc_str = (pos: int) -> str:
    if pos_in_lib(pos): return ""
    f = pos_file(pos)
    path = files[f].path
    s = rfind(path, "/")
    if s >= 0: path = path[s + 1..]
    l, c = line_col(pos)
    "{path}:{l}"

e_daddr = (off: int) -> int:
    d = vreg(VI)
    emit(.daddr, VI, d, 0, 0, 0, off)
    d

e_gaddr = (off: int) -> int:
    d = vreg(VI)
    emit(.gaddr, VI, d, 0, 0, 0, off)
    d

e_faddr = (lf: int) -> int:
    d = vreg(VI)
    emit(.faddr, VI, d, 0, 0, 0, lf)
    d

# length of an array/string object pointer (0 for null)
arr_len = (p: int) -> int:
    r = vreg(VI)
    emit(.iconst, VI, r, 0, 0, 0, 0)
    iff(e_bin(.ne, VI, p, e_iconst(0)))
    e_mov(r, hdr_load(p, 8))
    endc()
    r

arr_unique = (slot_addr_or_place: Place, at: int):
    # ensure the array in the place is uniquely owned
    # (fast path inline: a non-null array with refcount 1 is already unique. Debug builds keep
    # the IR one call, which the code generator skips in those cases (CALL_IF_SHARED): out of
    # line, every element write cost a call, half of nbody's time)
    p = read_place(slot_addr_or_place, at)
    if not opt_release:
        np0 = e_call1(lf_helper(.arruniq, at, 0), p, VI)
        ir.code[ir.code.len() - 1].c = CALL_IF_SHARED
        write_place(slot_addr_or_place, at, np0)
        return
    iff(e_bin(.ne, VI, p, e_iconst(0)))
    iff(e_bin(.ne, VI, hdr_load(p, 0), e_iconst(1)))
    was = ir_cold
    ir_cold = true
    np = e_call1(lf_helper(.arruniq, at, 0), p, VI)
    ir_cold = was
    write_place(slot_addr_or_place, at, np)
    endc()
    endc()
    emit(.assume, 0, 0, read_place(slot_addr_or_place, at), 0, 0, A_RC1)

# indexes computed beforehand (a `mut` element passed as a copy finds its place again after the
# call with the same index)
frozen: {int: int}
gen_index = (n: int) -> int:
    if frozen.len() > 0:
        if let v = frozen.get(n): return v
    gen_expr(n).v

# A fixed array covering an unsigned index's entire domain needs no check.
# Follow only value-preserving integer widenings. Stripping arbitrary casts
# would miss negative values introduced by signed narrowing (u16 -> i8 -> int).
fixed_index_domain = (index: int, length: int) -> bool:
    n = index
    loop true:
        t = prune(ntype(n))
        if types[t].kind != .int_: return false
        bits = int(types[t].bits)
        if not types[t].sign and bits < 32: return (1 << bits) <= length
        if nodes[n].kind != .conv or nodes[n].aux != i32(int(CV.int_)): return false
        inner = int(nodes[n].a)
        source = prune(ntype(inner))
        if types[source].kind != .int_: return false
        from_bits = int(types[source].bits)
        if bits < from_bits: return false
        if types[t].sign != types[source].sign and not (types[t].sign and bits > from_bits): return false
        n = inner
    false

gen_place = (e: int, write: bool) -> Place:
    k = nodes[e].kind
    if k == .ident:
        if nodes[e].aux == i32(int(SK.local)): return local_place(int(nodes[e].sym), write)
        if nodes[e].aux == i32(int(SK.global)): return Place(true, e_gaddr(global_addr_off(int(nodes[e].sym))))
    else if k == .field:
        a = int(nodes[e].a)
        bt = prune(ntype(a))
        slot = box_slot
        box_slot = false
        if nodes[e].aux == -3:
            base = gen_place(a, write)
            si = int(types[bt].st)
            layout(bt)
            v = int(structs[si].variants) + int(nodes[e].aux2)
            return field_place(int(variants[v].fields) + int(nodes[e].ival), place_addr(base, bt), write, slot)
        if nodes[e].aux == -4 and swizzle_run(e):
            base = gen_place(a, write)
            ci = swizzle_index(name_of(int(nodes[e].name))[0])
            return Place(true, e_addi(place_addr(base, bt), ci * 4))
        # (.zx and the like are no place: read into a temporary, and assign_to writes them a
        # component at a time)
        if nodes[e].aux == -4:
            if write: ice("a swizzle out of order as a place at {pos_str(nodes[e].pos)}")
            return Place(true, gen_expr(e).v)
        addr = 0
        if types[bt].kind == .ptr:
            ir.raw_mem = true
            addr = gen_expr(a).v
            bt = prune(int(types[bt].elem))
        else:
            base = gen_place(a, write)
            addr = place_addr(base, bt)
        layout(bt)
        if types[bt].kind == .tuple: return Place(true, e_addi(addr, tuple_off(bt, nodes[e].ival)))
        return field_place(int(structs[int(types[bt].st)].fields) + int(nodes[e].aux), addr, write, slot)
    else if k == .index:
        if partition_slice(e): fatal(nodes[e].pos, "mutable slices require a direct nonescaping call")
        a = int(nodes[e].a)
        bt = prune(ntype(a))
        bk = types[bt].kind
        if bk == .ptr:
            ir.raw_mem = true
            p = gen_expr(a).v
            i = gen_index(int(nodes[e].b))
            sz = tsize(int(types[bt].elem))
            return Place(true, e_bin(.add, VI, p, e_bin(.mul, VI, i, e_iconst(sz))))
        if bk == .array:
            desc = partition_descriptor(a)
            if desc >= 0:
                idx = gen_index(int(nodes[e].b))
                length = partition_lengths[int(nodes[a].sym)]
                if not has_flag(e, NF_INBOUNDS) and not (partition_proven.get(e) ?? false) and index_safety(a, int(nodes[e].b)) == 0:
                    iff(e_bin(.geu, VI, idx, length))
                    e_call_nr3(rt("__panic_bounds"), idx, length, e_daddr(loc_data(nodes[e].pos)), -1)
                    endc()
                data = partition_data[int(nodes[a].sym)]
                return Place(true, e_bin(.add, VI, data, e_bin(.mul, VI, idx, e_iconst(tsize(telem(bt))))))
            fi = fixed_path_of(a)
            if fi >= 0:
                fp = fixed_paths[fi]
                ixn = int(nodes[e].b)
                idx = gen_index(ixn)
                by_loopvar = fp.loopvar >= 0 and nodes[ixn].kind == .ident and nodes[ixn].aux == i32(int(SK.local)) and int(nodes[ixn].sym) == fp.loopvar
                if not by_loopvar and not has_flag(e, NF_INBOUNDS) and index_safety(a, ixn) == 0:
                    iff(e_bin(.geu, VI, idx, fp.len))
                    e_call_nr3(rt("__panic_bounds"), idx, fp.len, e_daddr(loc_data(nodes[e].pos)), -1)
                    endc()
                sz = owner_stride(int(types[bt].elem))
                return Place(true, e_bin(.add, VI, e_addi(fp.arr, 24), e_bin(.mul, VI, idx, e_iconst(sz))))
            arr = 0
            idx = 0
            if write:
                base = gen_place(a, true)
                if not is_uniq_array(a): arr_unique(base, bt)
                idx = gen_index(int(nodes[e].b))
                arr = read_place(base, bt)
                # re-read: evaluating the index cannot change the array place
            else if nodes[a].kind == .ident:
                # (the index first: a call in it may change the array, as nodes[mk()] grows nodes)
                idx = gen_index(int(nodes[e].b))
                arr = gen_borrowed(a).v
            else:
                arr = gen_borrowed(a).v
                idx = gen_index(int(nodes[e].b))
            safety = index_safety(a, int(nodes[e].b))
            if has_flag(e, NF_INBOUNDS): safety = 1
            if safety == 0: bounds_check(arr, idx, nodes[e].pos)
            else if safety == 2 and opt_release: null_check(arr, idx, nodes[e].pos)
            sz = owner_stride(int(types[bt].elem))
            return Place(true, e_bin(.add, VI, e_addi(arr, 24), e_bin(.mul, VI, idx, e_iconst(sz))))
        if bk == .str_:
            idx = 0
            arr = 0
            if nodes[a].kind == .ident:
                idx = gen_index(int(nodes[e].b))
                arr = gen_borrowed(a).v
            else:
                arr = gen_borrowed(a).v
                idx = gen_index(int(nodes[e].b))
            # (as for arrays: an index a loop keeps below the string's length needs no check)
            safety = index_safety(a, int(nodes[e].b))
            if has_flag(e, NF_INBOUNDS): safety = 1
            if safety == 0: bounds_check(arr, idx, nodes[e].pos)
            else if safety == 2 and opt_release: null_check(arr, idx, nodes[e].pos)
            return Place(true, e_bin(.add, VI, e_addi(arr, 24), idx))
        if bk == .fixed:
            base = gen_place(a, write)
            ixn = int(nodes[e].b)
            idx = gen_index(ixn)
            n = fixed_len(bt)
            # (a constant index was checked by the compiler)
            if nodes[ixn].kind != .int_lit and not has_flag(e, NF_INBOUNDS) and not fixed_index_domain(ixn, n):
                iff(e_bin(.geu, VI, idx, e_iconst(n)))
                e_call_nr3(rt("__panic_bounds"), idx, e_iconst(n), e_daddr(loc_data(nodes[e].pos)), -1)
                endc()
            esz = tsize(int(types[bt].elem))
            return Place(true, e_bin(.add, VI, place_addr(base, bt), e_bin(.mul, VI, idx, e_iconst(esz))))
        if bk == .vec:
            base = gen_place(a, write)
            idx = gen_index(int(nodes[e].b))
            esz = 4
            if bt == T_MAT4: esz = 16
            return Place(true, e_bin(.add, VI, place_addr(base, bt), e_bin(.mul, VI, idx, e_iconst(esz))))
    else if k == .unwrap:
        a = int(nodes[e].a)
        ot = prune(ntype(a))
        if math_optional(ot):
            base = gen_place(a, write)
            iff(e_bin(.eq, VI, read_place(base, ot), e_iconst(0)))
            e_call_nr1(rt("__panic_unwrap"), e_daddr(loc_data(nodes[e].pos)), -1)
            endc()
            return Place(base.mem, base.v, true)
        view = held_opt_reg(a)
        addr = 0
        has = 0
        if view >= 0:
            addr = e_addi(view, BOX_HDR)
            has = view
        else:
            base = gen_place(a, write)
            addr = place_addr(base, ot)
            has = opt_has(addr, int(types[ot].elem))
        iff(e_bin(.eq, VI, has, e_iconst(0)))
        e_call_nr1(rt("__panic_unwrap"), e_daddr(loc_data(nodes[e].pos)), -1)
        endc()
        return Place(true, addr, math_optional(ot))
    else if k == .narrow:
        # a union variable known (by `is`) to hold member aux: checked, since a closure could
        # have changed it
        a = int(nodes[e].a)
        ut = prune(ntype(a))
        layout(ut)
        base = gen_place(a, write)
        addr = place_addr(base, ut)
        vi = int(nodes[e].aux)
        iff(e_bin(.ne, VI, e_load(VI, addr, 0, 4), e_iconst(vi)))
        e_call_nr1(rt("__panic_narrow"), e_daddr(loc_data(nodes[e].pos)), -1)
        endc()
        v = int(structs[int(types[ut].st)].variants) + vi
        return Place(true, e_addi(addr, int(fields[int(variants[v].fields)].offset)))
    # not a place: evaluate into a temporary
    t = ntype(e)
    if tkind(t) == .typeval or tkind(t) == .module: type_as_value(e)
    val = gen_expr(e)
    if vc(t) == VC_AGG:
        borrow(val, t)
        return Place(true, val.v)
    if val.owned: reg_temp_vreg(val.v, t)
    Place(false, val.v)

tuple_off = (t: int, idx: int) -> int:
    off = 0
    loop i in [0..idx + 1):
        el = targ(t, i)
        off = align_up(off, talign(el))
        if i < idx: off += tsize(el)
    off

# ---------------- calls ----------------
call_eval_order = (n: int) -> int[]:
    order: int[]
    metadata = int(nodes[n].c)
    if metadata != 0:
        loop e in kids(metadata): order.push(nodes[e].ival)
    else:
        loop i in [0..nkids(n)): order.push(i)
    order

# A scalar expression can name a local's mutable register. Keep the value
# already read before evaluating a later operand/argument that can assign it.
freeze_scalar = (v: int, t: int) -> int:
    if v < 0 or is_kv(v): return v
    saved = vreg(vt_of(t))
    e_mov(saved, v)
    saved

call_args = (args: int[], ptypes: int[], mutmask: int, out: mut int[], callee: int = 0, order: int[] = [], slots: int[] = []):
    if order.len() > 0:
        ordered_args: int[]
        ordered_types: int[]
        ordered_mut = 0
        loop i in 0.. and slot in order:
            ordered_args.push(args[slot])
            ordered_types.push(ptypes[slot])
            if mutmask & (1 << slot) != 0: ordered_mut |= 1 << i
        values: int[]
        call_args(ordered_args, ordered_types, ordered_mut, values, callee, slots = order)
        base = out.len()
        out.resize(base + order.len())
        loop i in 0.. and slot in order: out[base + slot] = values[i]
        return
    any_mut = mutmask != 0
    # Dewy functions initialize their private value parameters on entry. For
    # the last evaluated argument there is no intervening evaluation requiring
    # another callback snapshot. Unknown/implementation callees still borrow
    # parameters, so the caller must give them an independent callable value.
    dewy_entry = callee > 0 and fns[callee].decl != 0 and files[pos_file(nodes[int(fns[callee].decl)].pos)].is_dewy
    if any_mut: mut_alias_check(args, mutmask, callee)
    loop i in 0.. and a in args:
        if mutmask & (1 << i) != 0:
            if partition_slice(a): fatal(nodes[a].pos, "mutable slices require a direct nonescaping call")
            if copy_through(a, callee):
                out.push(copy_in(a))
                continue
            pinned_box = -1
            p = gen_place(a, true)
            out.push(place_addr(p, ntype(a)))
            # (a place in a box: the box kept, with a reference of the statement's, while the
            # call runs, which may give what holds it another value)
            if pinned_box >= 0:
                c = vreg(VI)
                e_mov(c, pinned_box)
                retain(c, pinned_type)
                reg_temp_vreg(c, pinned_type)
            continue
        pt = ntype(a)
        if i < ptypes.len(): pt = ptypes[i]
        if copies_on:
            parameter = if slots.len() == 0: i else: slots[i]
            if copy_consumes(callee, parameter):
                val = gen_owned(a)
                out.push(val.v)
                continue
        value_node = a
        if nodes[a].kind == .conv and nodes[a].aux == i32(int(CV.refinement)): value_node = int(nodes[a].a)
        parameter = if slots.len() == 0: i else: slots[i]
        literal = nodes[value_node].kind == .lambda and files[pos_file(nodes[a].pos)].is_dewy and not has_flag(value_node, NF_GENERIC)
        stack = literal and closure_env_shareable(int(nodes[value_node].sym)) and closure_borrow_param(callee, parameter)
        val = if stack: gen_lambda(value_node, true) else: gen_expr(value_node)
        # A scalar can live in a local's mutable vreg. Capture its value before
        # a later argument reassigns that local, just as we retain managed data.
        if i + 1 < args.len() and vc(pt) != VC_AGG: val.v = freeze_scalar(val.v, pt)
        if not val.owned and (not dewy_entry or i + 1 < args.len()) and type_has_fn(pt) and not callback_arg_borrow(value_node, args, i, callee, parameter) and files[pos_file(nodes[a].pos)].is_dewy: val = own_at(a, val, pt)
        mut_snapshot = any_mut
        if copies_on and (copy_strict(a) or ownership_type(pt)): mut_snapshot = any_mut and shares_mut_root(a, args, mutmask, (if slots.len() == 0: callee else: -1))
        else if any_mut: mut_snapshot = mut_may_reach(a, args, mutmask)
        snapshot = false
        if not val.owned and is_managed(pt) and (mut_snapshot or borrow_may_change(a, args, i, callee)):
            val = own_at(a, val, pt)
            snapshot = true
        # (a struct passed by its address, in memory that a `mut` argument of the same call
        # reaches, f(p, p.hs[0]): the callee writing p would change it, so a copy; or that the
        # callee changes by name)
        else if not val.owned and vc(pt) == VC_AGG and ((any_mut and shares_mut_root(a, args, mutmask)) or borrow_may_change(a, args, i, callee)):
            val = own_at(a, val, pt)
            snapshot = true
        # Invocation-only callees cannot retain this stack environment. Keep
        # its captures alive through the statement, then destroy them directly.
        if stack: reg_temp_slot(val.slot, pt, int(nodes[value_node].sym))
        else:
            held = tl_values.len()
            borrow(val, pt)
            if snapshot and not ownership_type(pt) and tl_items.len() > 0 and tl_values.len() == held + 1:
                arg_snapshots.push(tl_values[held])
        out.push(val.v)

# A snapshot taken only to keep an argument stable while the callee runs. The
# result is owned, so nothing refers to the snapshot once the call returns;
# release it there rather than at the end of the statement. A snapshot kept
# alive across a later mutating call in the same statement (`add(@p
# Node[text(p t)])`) would make that call detach and copy p's buffers.
arg_snapshots: TempItem[]

release_arg_snapshots = (mark: int):
    loop arg_snapshots.len() > mark:
        it = arg_snapshots.pop()
        k = tl_values.len() - 1
        found = false
        loop k >= 0 and not found:
            x = tl_values[k]
            if x.is_slot == it.is_slot and x.ref == it.ref:
                tl_values.remove(k)
                # An early release can belong to an enclosing statement.
                # Preserve the offsets of every still-active nested statement.
                loop j in [0..tl_items.len()):
                    if tl_items[j] > k: tl_items[j] -= 1
                found = true
            k -= 1
        if not found: continue
        if it.is_slot: drop_at(e_slot(it.ref), it.t)
        else: release(it.ref, it.t)

# (a is part of the same variable as one of the call's `mut` arguments; for the
# copy policy (callee 0 or more), unless their field paths part, or a checked
# callee spares a's place inside that argument: a method passing its own field)
shares_mut_root = (a: int, args: int[], mutmask: int, callee: int = -2) -> bool:
    ra = place_var(a)
    if ra == 0: return false
    loop j in 0.. and b in args:
        if mutmask & (1 << j) == 0: continue
        rb = place_var(b)
        if rb == 0 or not same_var(ra, rb): continue
        if callee > -2 and (disjoint_fields(a, b) or mut_arg_spares(a, b, j, callee)): continue
        return true
    false

# The callee's settled summary writes no place of formal j that overlaps a's
# field path below the actual b (`absorb(pending ...)` writing only `h`).
mut_arg_spares = (a: int, b: int, j: int, callee: int) -> bool:
    if callee <= 0 or j >= fns[callee].params.len(): return false
    sa = place_steps(a)
    sb = place_steps(b)
    if sa.len() <= sb.len(): return false
    loop i in [0..sb.len()):
        if nodes[sa[i]].kind != .field or nodes[sb[i]].kind != .field or nodes[sa[i]].aux != nodes[sb[i]].aux: return false
    rest: int[]
    loop i in [sb.len()..sa.len()):
        x = sa[i]
        if nodes[x].kind != .field or nodes[x].aux < 0 or tkind(ntype(int(nodes[x].a))) != .struct_ or boxed_field_of(x) >= 0: return false
        rest.push(int(nodes[x].name))
    if not effects_demand_late(callee): return false
    loop event in effect_summaries[callee].events:
        k = event.atom.kind
        if k == .opaque or k == .remainder or k == .escape: return false
        if k != .write: continue
        base = place_base(event.atom.place)
        if base.root == .capture or base.root == .local and base.declaration == 0: return false
        if base.root != .formal or base.declaration - 1 != j: continue
        path = place_path(event.atom.place)
        n = min(path.len(), rest.len())
        same = true
        loop i in [0..n):
            if path[i] != rest[i]: same = false
        if same: return false
    true

# Two inline field paths from one variable that name different fields at some
# step are different storage: a write through one cannot reach the other.
disjoint_fields = (a: int, b: int) -> bool:
    sa = place_steps(a)
    sb = place_steps(b)
    loop i in [0..min(sa.len(), sb.len())):
        x = sa[i]
        y = sb[i]
        if nodes[x].kind != .field or nodes[y].kind != .field or nodes[x].aux < 0 or nodes[y].aux < 0: return false
        if tkind(ntype(int(nodes[x].a))) != .struct_ or boxed_field_of(x) >= 0 or boxed_field_of(y) >= 0: return false
        if nodes[x].aux != nodes[y].aux: return true
    false

mwr_direct = false             # (may_write_root: only what the code itself does, not its calls)

# A `mut` element of a global array (or of a `mut` parameter's, which may be a global) is passed
# as a copy, written back after the call, when the call may run a function value: the callee
# itself, or one it calls. That code could resize the array, which would move the element. (What
# the callee changes by name is checked by mut_alias_check.)
struct CopyBack:
    arg: int
    slot: int
    idx: (int, int)[]          # the place's index nodes and their values
copy_backs: CopyBack[]

copy_through = (a: int, callee: int) -> bool:
    alias = a
    loop nodes[alias].kind == .ident and nodes[alias].aux == i32(int(SK.local)) and int(locals[int(nodes[alias].sym)].flags) & LF_ALIAS != 0:
        alias = int(locals[int(nodes[alias].sym)].alias)
    if nodes[alias].kind == .unwrap and math_optional(prune(ntype(int(nodes[alias].a)))): return true
    r = place_var(a)
    if r == 0 or not pw_heap: return false
    if nodes[r].aux != i32(int(SK.global)):
        if nodes[r].aux != i32(int(SK.local)) or int(locals[int(nodes[r].sym)].flags) & LF_MUTPARAM == 0: return false
    callee <= 0 or fn_writes(callee).all

copy_in = (a: int) -> int:
    if copies_on: copy_components(a, ntype(a), "place writeback needs an independent heap-bearing snapshot")
    t = ntype(a)
    cb = CopyBack(a, new_temp(t), [])
    loop st in place_steps(a):
        if nodes[st].kind == .index: cb.idx.push((int(nodes[st].b), gen_expr(int(nodes[st].b)).v))
    loop x in cb.idx: frozen[x.0] = x.1
    src = place_addr(gen_place(a, true), t)
    loop x in cb.idx: frozen.remove(x.0)
    tmp = e_slot(cb.slot)
    store_val(t, tmp, 0, load_val(t, src, 0))
    copy_at(tmp, t)
    build_slot(cb.slot, t)
    copy_backs.push(cb)
    tmp

# after a call: the copies made since copy_backs had `mark` entries go back to their places (the
# copy's references move there)
copy_back = (mark: int):
    loop copy_backs.len() > mark:
        cb = copy_backs.pop()
        t = ntype(cb.arg)
        loop x in cb.idx: frozen[x.0] = x.1
        dst = gen_place(cb.arg, true)
        loop x in cb.idx: frozen.remove(x.0)
        if dst.math_opt: release(read_place(dst, t), t)
        else: drop_at(place_addr(dst, t), t)
        write_place(dst, t, load_val(t, e_slot(cb.slot), 0))
        if is_managed(t): building.pop()

# could the place argument i was read from (without a reference of its own) be given another
# value before the call returns, by the callee or a later argument, freeing what was read? It
# can for globals, variables closures share, captures and mut parameters; a plain local or
# parameter cannot be reached from elsewhere (and a parameter's caller keeps its value alive).
# Release builds leave out the reference to a global that neither the callee nor the later
# arguments can change.
borrow_may_change = (a: int, args: int[], i: int, callee: int) -> bool:
    n = place_var(a)
    if n == 0: return false
    heap_place = pw_heap
    if nodes[n].aux == i32(int(SK.global)):
        # (a global only top-level code changes cannot change during a call, only in the
        # arguments after this one)
        if not globals[int(nodes[n].sym)].fn_written:
            mwr_direct = true
            w = false
            loop j in [i + 1..args.len()):
                if may_write_root(args[j], n): w = true
            mwr_direct = false
            return w
        if not opt_release or callee <= 0: return true
        w = fn_writes(callee)
        if w.all or w.globals.contains(int(nodes[n].sym)): return true
        loop j in [i + 1..args.len()):
            if may_write_root(args[j], n): return true
        return false
    if nodes[n].aux != i32(int(SK.local)): return false
    if held_views.contains(int(nodes[n].sym)): return false
    flags = int(locals[int(nodes[n].sym)].flags)
    # view_decl proved that the array root cannot change through the last use,
    # including this call and its remaining arguments. The view needs no retain.
    if flags & LF_ELEMENTVIEW != 0: return false
    # An immutable value capture is kept alive by the active closure. Passing
    # it to a reader needs no per-invocation retain, including across workers.
    immutable_capture = flags & (LF_CAPTURE | LF_VALUECAP) == (LF_CAPTURE | LF_VALUECAP) and flags & (LF_ASSIGNED | LF_CAPTURED | LF_ADDR | LF_EXPOSED | LF_OWNERBORROW | LF_SHARED) == 0 and not is_shared(int(nodes[n].sym))
    if flags & (LF_SHARED | LF_BYREF | LF_ALIAS) != 0 or flags & LF_CAPTURE != 0 and not immutable_capture: return true
    # Even an ordinary local can be changed by evaluating a later argument.
    # Disjoint fields keep borrowing. A dynamic element also borrows its
    # container's storage: a sibling write may detach it, and later code may
    # release the old backing storage's last other owner. Treat that ownership
    # place as overlapping, even when the logical elements are disjoint.
    loop j in [i + 1..args.len()):
        if may_write_root(args[j], n, (if heap_place: 0 else: a)): return true
    if flags & LF_MUTPARAM == 0: return false
    # A mutable parameter may alias a caller's global. A read-only direct call
    # cannot replace it when it writes no globals and invokes no unknown code.
    # Keep the snapshot if a later argument can write the parameter itself.
    resource = ownership_type(ntype(n))
    # Owners cannot be global, captured, or exported. A readonly argument
    # cannot be reached by the callee except through another actual; those
    # aliases and later argument writes are checked above/by shares_mut_root.
    if resource: return false
    # (the source copy policy cannot depend on the build: it consults writes always)
    if not opt_release and not (copies_on and copy_strict(a)) or callee <= 0: return true
    w = fn_writes(callee)
    if w.all or w.globals.len() > 0: return true
    loop j in [i + 1..args.len()):
        if may_write_root(args[j], n): return true
    false

# Could a `mut` argument of the call reach the storage argument a is read from (borrowed, without
# a reference of its own), and release it? A plain local, or a read-only parameter (its caller
# keeps the value), is reached only through its own variable (shares_mut_root); a global or a
# `mut` parameter also through a `mut` parameter or an alias, but not through another global or
# plain local. O(arguments).
mut_may_reach = (a: int, args: int[], mutmask: int) -> bool:
    ra = place_var(a)
    if ra == 0 or shares_mut_root(a, args, mutmask): return true
    if nodes[ra].aux == i32(int(SK.local)):
        if mut_plain_root(ra): return false
    else if nodes[ra].aux != i32(int(SK.global)): return true
    loop j in 0.. and b in args:
        if mutmask & (1 << j) == 0: continue
        rb = place_var(b)
        if rb == 0: return true
        if nodes[rb].aux == i32(int(SK.global)) and nodes[ra].aux == i32(int(SK.global)): continue
        if nodes[rb].aux != i32(int(SK.local)) or not mut_plain_root(rb): return true
    false

# a local whose storage no other variable's place reaches (no alias, view, capture or address)
mut_plain_root = (r: int) -> bool:
    l = int(nodes[r].sym)
    fl = int(locals[l].flags)
    fl & (LF_MUTPARAM | LF_SHARED | LF_BYREF | LF_ALIAS | LF_CAPTURE | LF_CAPTURED | LF_ADDR | LF_ELEMALIAS | LF_SOAELEM | LF_ELEMENTVIEW | LF_OWNERBORROW) == 0 and not is_shared(l) and not held_views.contains(l)

# A `mut` argument that is an element of an array or map (xs[i], xs[i].f) is written through
# its address in the array's memory, which must not move or be shared while the call runs: the
# same call may not be given the array itself, and a global array may not be one the callee
# (or a later argument) can change. (Other elements, as in swap(xs[i], xs[j]), are fine.)
mut_alias_check = (args: int[], mutmask: int, callee: int):
    loop i in 0.. and a in args:
        if mutmask & (1 << i) == 0: continue
        r = elem_root(a)
        if r == 0: continue
        # (a place only in a box, not an array: the box is kept while the call runs, call_args)
        in_arr = pw_heap
        hint = ""
        if in_arr: hint = " (pass the index instead)"
        sa = place_steps(a)
        nm = name_of(int(nodes[r].name))
        loop j in 0.. and b in args:
            if j == i: continue
            bmut = mutmask & (1 << j) != 0
            w = place_var(b)
            # (another place that holds this one or is inside it: xs and xs[0], xs[0] and
            # xs[0][0]; other elements and fields are fine, as in swap(xs[i], xs[j]), and so is
            # reading numbers out of the array)
            nested = false
            if w != 0 and same_var(w, r) and (bmut or is_managed(ntype(b))):
                sb = place_steps(b)
                nested = steps_overlap(sa, sb) and not (bmut and sa.len() == sb.len())
            if nested or may_write_root(b, r):
                fatal(nodes[b].pos, "{place_text(a)} is passed as {jd(nodes[b].pos, "a `mut` argument", "an `@` argument")}, so this argument cannot also hold or change '{nm}'{hint}")
        glob = nodes[r].aux == i32(int(SK.global))
        lf = 0
        if not glob: lf = int(locals[int(nodes[r].sym)].flags)
        mutparam = lf & LF_MUTPARAM != 0
        # (a variable a closure changes: the callee may be that closure, or call it)
        if lf & LF_SHARED != 0 and (callee <= 0 or fn_writes(callee).all):
            fatal(nodes[a].pos, "'{nm}' is changed by a closure, which this call may run, so {place_text(a)} cannot be passed as {jd(nodes[a].pos, "a `mut` argument", "an `@` argument")}{hint}")
        if glob or mutparam:
            who = "the function called"
            if callee > 0: who = "'{name_of(int(nodes[int(fns[callee].decl)].name))}'"
            # (what the callee changes, as far as it names it; a call of a function value it
            # makes is not counted, or nearly every call into a library would be refused)
            fw = FnWrites(false, [], [], [])
            if callee > 0: fw = fn_writes_named(callee)
            if glob and fw.globals.contains(int(nodes[r].sym)):
                fatal(nodes[a].pos, "{who} may change the global '{nm}' (or call something that does), so {place_text(a)} cannot be passed to it as {jd(nodes[a].pos, "a `mut` argument", "an `@` argument")}{hint}")
            if mutparam and in_arr and param_may_alias(fw.globals, nodes[a].pos):
                fatal(nodes[a].pos, "{who} changes globals, and '{nm}' ({jd(nodes[a].pos, "a `mut` parameter", "an `@` parameter")}) may be one of them, so {place_text(a)} cannot be passed to it as {jd(nodes[a].pos, "a `mut` argument", "an `@` argument")}{hint}")

# Could a mutable parameter of code at pos be one of these globals? Dewy code
# cannot name the implementation's private state (the allocator, diagnostics,
# I/O status: `__` globals of implementation modules), so a Dewy parameter is
# never one of those, however many library calls write them.
param_may_alias = (written: int[], pos: int) -> bool:
    if not files[pos_file(pos)].is_dewy: return written.len() > 0
    loop g in written:
        d = int(globals[g].decl)
        if d == 0 or files[pos_file(nodes[d].pos)].is_dewy or not starts_with(name_of(int(globals[g].name)), "__"): return true
    false

# a place as written (xs[i].pos), for messages
place_text = (n: int) -> str:
    k = nodes[n].kind
    if k == .ident:
        nm = name_of(int(nodes[n].name))
        # (a narrowed field or global: the place it stands for)
        if starts_with(nm, "#") and nodes[n].aux == i32(int(SK.local)) and locals[int(nodes[n].sym)].alias != 0: return place_text(int(locals[int(nodes[n].sym)].alias))
        return nm
    if k == .narrow or k == .conv: return place_text(int(nodes[n].a))
    if k == .field: return "{place_text(int(nodes[n].a))}.{name_of(int(nodes[n].name))}"
    if k == .unwrap: return "{place_text(int(nodes[n].a))}!"
    if k == .index:
        b = int(nodes[n].b)
        i = "..."
        if nodes[b].kind == .ident: i = name_of(int(nodes[b].name))
        else if nodes[b].kind == .int_lit: i = "{nodes[b].ival}"
        # (a dictionary entry is stored in its values array: written as the dictionary's)
        a = int(nodes[n].a)
        if nodes[a].kind == .field and is_map_type(ntype(int(nodes[a].a))): return "{place_text(int(nodes[a].a))}[{i}]"
        return "{place_text(a)}[{i}]"
    "..."

# The variable a place belongs to: through fields, indexing, `!`, narrowing and the names that
# stand for a place (a narrowed variable or field, `loop mut`'s element). pw_heap: some step
# indexes an array or map; pw_box: some step is a boxed field; pw_depth: how many fields and
# indexes. 0 (no variable) for a place reached through a raw pointer, or a value that is no place.
pw_heap = false
pw_box = false
pw_depth = 0
place_var = (n0: int) -> int:
    n = n0
    pw_heap = false
    pw_box = false
    pw_depth = 0
    loop true:
        k = nodes[n].kind
        if k == .field or k == .index:
            bk = tkind(ntype(int(nodes[n].a)))
            if bk == .ptr: return 0
            if k == .index and bk != .fixed and bk != .vec: pw_heap = true
            if k == .field and boxed_field_of(n) >= 0: pw_box = true
            pw_depth += 1
            n = int(nodes[n].a)
        else if k == .unwrap or k == .narrow or (k == .fnref and nodes[n].aux == 2) or (k == .conv and nodes[n].aux == i32(int(CV.union_))): n = int(nodes[n].a)
        else if k == .ident and nodes[n].aux == i32(int(SK.local)) and int(locals[int(nodes[n].sym)].flags) & LF_ALIAS != 0 and locals[int(nodes[n].sym)].alias != 0:
            n = int(locals[int(nodes[n].sym)].alias)
        else: break
    if nodes[n].kind == .ident: return n
    0

# the fields and indexes of a place, from its variable on (as place_var follows them)
place_steps = (n0: int) -> int[]:
    out: int[]
    n = n0
    loop true:
        k = nodes[n].kind
        if k == .field or k == .index:
            out.insert(0, n)
            n = int(nodes[n].a)
        else if k == .unwrap or k == .narrow or (k == .conv and nodes[n].aux == i32(int(CV.union_))): n = int(nodes[n].a)
        else if k == .ident and nodes[n].aux == i32(int(SK.local)) and int(locals[int(nodes[n].sym)].flags) & LF_ALIAS != 0 and locals[int(nodes[n].sym)].alias != 0:
            n = int(locals[int(nodes[n].sym)].alias)
        else: break
    out

# could one of two places (steps from the same variable) hold the other: is the shorter a
# prefix of the longer, as far as the compiler can tell (xs[i] and xs[j] may be the same)?
steps_overlap = (a: int[], b: int[]) -> bool:
    loop k in [0..min(a.len(), b.len())):
        x = a[k]
        y = b[k]
        if nodes[x].kind != nodes[y].kind: return false
        if nodes[x].kind == .field and nodes[x].aux != nodes[y].aux: return false
        if nodes[x].kind == .index:
            bx = int(nodes[x].b)
            by = int(nodes[y].b)
            if nodes[bx].kind == .int_lit and nodes[by].kind == .int_lit and nodes[bx].ival != nodes[by].ival: return false
    true

# the variable (ident node) whose array or map, or box, holds the element place n is in, or 0
elem_root = (n: int) -> int:
    r = place_var(n)
    if pw_heap or pw_box: return r
    0

# does expression n name the variable of ident node r?
mentions_var = (n: int, r: int) -> bool:
    if n <= 0: return false
    if nodes[n].kind == .ident and same_var(n, r): return true
    if nodes[n].kind == .lambda: return false
    child_a = int(nodes[n].a)
    child_b = int(nodes[n].b)
    child_c = int(nodes[n].c)
    child_d = int(nodes[n].d)
    more_children = nodes[n].kind != .for_
    if mentions_var(child_a, r): return true
    if mentions_var(child_b, r): return true
    if more_children:
        if mentions_var(child_c, r): return true
        if mentions_var(child_d, r): return true
    loop i in [0..nkids(n)):
        if mentions_var(kid(n, i), r): return true
    loop i in [0..nkids2(n)):
        if mentions_var(kid2(n, i), r): return true
    false

ret_vt = (t: int) -> int:
    c = vc(t)
    if c == VC_VOID: return -1
    if c == VC_AGG: return -1
    vt_of(t)

finish_call = (ret: int, rv: int, rslot: int) -> Val:
    c = vc(ret)
    if c == VC_AGG: return Val(e_slot(rslot), true, rslot)
    if c == VC_VOID: return V(-1, false)
    if c == VC_INT: return V(norm(rv, ret), true)
    V(rv, true)

inst_mutmask = (f: int) -> int:
    d = int(fns[f].decl)
    if d == 0 or nodes[d].kind != .fn_: return 0
    di = int(nodes[d].sym)
    if di > 0 and decl_infos[di].sig.done: return int(decl_infos[di].sig.mutmask)
    mm = 0
    loop i in [0..fns[f].ptypes.len()):
        if has_flag(kid(d, i), NF_MUT): mm |= 1 << i
    mm

# A checked method receiver may still carry syntactic NF_MUT permission even
# when overload resolution selected a read-only parameter. Effects follow the
# resolved signature, just as argument lowering does; keep syntax flags intact.
checked_call_mutmask = (n: int) -> int:
    k = nodes[n].kind
    if k == .pair and nodes[n].sym > 0: return inst_mutmask(int(nodes[n].sym))
    if k != .call: return 0
    aux = int(nodes[n].aux)
    if aux == 0 and nodes[n].sym > 0: return inst_mutmask(int(nodes[n].sym))
    if aux == 1 or aux == 4:
        ft = prune(ntype(int(nodes[n].a)))
        return int(types[ft].mutmask)
    0

# ---------------- data races ----------------
# A function given to a @parallel function (parallel_map...) runs on many threads at once: it
# must not change the variables it captured, or globals -- also not in the functions it calls.
race_done: {int: bool} = {}     # named functions known not to change globals

race_check = (callee: int, args: int[], pos: int):
    # (the library's own calls take care of threads themselves)
    if in_lib(pos): return
    who = name_of(int(nodes[int(fns[callee].decl)].name))
    loop a in args:
        if tkind(ntype(a)) == .fn_: race_arg(a, who)

# the function value a: the compiler must see which function it is, to check it
race_arg = (a: int, who: str):
    k = nodes[a].kind
    if k == .conv: race_arg(int(nodes[a].a), who)
    else if k == .lambda: race_scan(int(fns[int(nodes[a].sym)].body), int(nodes[a].sym), who, true)
    else if k == .fnref:
        f = int(nodes[a].sym)
        if nodes[a].aux == 2: race_scan(int(fns[f].body), f, who, true)
        else: race_named(f, who)
    else if k == .partial:
        if nodes[a].aux == 1: race_arg(int(nodes[a].a), who)
        else: race_named(int(nodes[a].sym), who)
    else:
        # (a @parallel function may pass on the functions it is given: its callers are checked)
        param = k == .ident and nodes[a].aux == i32(int(SK.local)) and int(locals[int(nodes[a].sym)].owner) == cur_fn and int(locals[int(nodes[a].sym)].flags) & LF_PARAM != 0
        if param and fns[cur_fn].parallel: return
        hint = ""
        if param: hint = ", or mark '{name_of(int(nodes[int(fns[cur_fn].decl)].name))}' @parallel so that the functions given to it are checked"
        fatal(nodes[a].pos, "{who} runs this function on many threads at once, so the compiler checks it for data races, which it can only do for a function it can see: pass a function by name or a lambda{hint}")

# a @parallel function is checked at its calls: it cannot be used as a value
parallel_direct = (f: int, pos: int):
    if f > 0 and fns[f].parallel and not in_lib(pos):
        fatal(pos, "'{name_of(int(nodes[int(fns[f].decl)].name))}' runs the function it is given on many threads at once, so it can only be called directly (where the compiler checks that function), not used as a value or partially applied")

# (a type or module where a value is wanted: P, Box[int])
type_as_value = (e: int):
    what = "a type"
    if tkind(ntype(e)) == .module: what = "a module"
    fatal(nodes[e].pos, "this is {what}, not a value (a value of a type is made by calling it: `T()`)")

# is position pos in the library (lib_dir)?
in_lib = (pos: int) -> bool:
    fi = pos_file(pos)
    fi >= 0 and fi < files.len() and starts_with(files[fi].path, lib_dir + "/")

race_named = (f: int, who: str):
    if race_done.contains(f) or fns[f].body == 0: return
    race_done[f] = true
    # (the core and standard libraries take care of threads themselves)
    if fns[f].decl != 0:
        fi = pos_file(int(nodes[int(fns[f].decl)].pos))
        if fi >= 0 and fi < files.len() and starts_with(files[fi].path, lib_dir + "/") and (find(files[fi].path, "/core/") >= 0 or find(files[fi].path, "/std/") >= 0): return
    race_scan(int(fns[f].body), f, who, false)

# a place that changes: the variable it belongs to, if that is shared with other threads
race_target = (t: int, f: int, who: str, captures: bool, pos: int):
    # (writing through a pointer changes memory the program manages itself, not the variable)
    n = place_var(t)
    if n == 0: return
    nm = name_of(int(nodes[n].name))
    if nodes[n].aux == i32(int(SK.global)):
        fatal(pos, "{who} runs this function on many threads at once, so it must not change the global '{nm}' (a data race): return values instead")
    if captures and nodes[n].aux == i32(int(SK.local)):
        l = int(nodes[n].sym)
        if int(locals[l].owner) != f or int(locals[l].flags) & LF_CAPTURE != 0:
            fatal(pos, "{who} runs this function on many threads at once, so it must not change '{nm}', a variable it captured (a data race): return values instead")

race_scan = (n: int, f: int, who: str, captures: bool):
    if n == 0: return
    loop called in value_helper_calls(n): race_named(called, who)
    k = nodes[n].kind
    if k == .lambda: return
    if k == .assign: race_target(int(nodes[n].a), f, who, captures, nodes[n].pos)
    else if k == .intrinsic and nkids(n) > 0:
        id = nodes[n].aux as IN
        if id == .push or id == .pop or id == .insert or id == .remove or id == .clear or id == .reserve or id == .resize or id == .truncate or id == .extend:
            race_target(kid(n, 0), f, who, captures, nodes[n].pos)
    else if k == .call:
        mm = checked_call_mutmask(n)
        loop i in [0..nkids(n)):
            if mm & (1 << i) != 0: race_target(kid(n, i), f, who, captures, nodes[kid(n, i)].pos)
        aux = int(nodes[n].aux)
        if aux == 0 and nodes[n].sym > 0: race_named(int(nodes[n].sym), who)
        # (calling a function value: which one, the compiler cannot tell; the library's are its own)
        else if aux == 1 and not in_lib(nodes[n].pos):
            fatal(nodes[n].pos, "{who} runs this code on many threads at once, so the compiler checks it for data races, which it cannot do through a call of a function value: call a function by name")
    else if k == .for_ and has_flag(n, NF_MUT): race_target(int(nodes[n].a), f, who, captures, nodes[n].pos)
    # (a part of "...{x}...": formatted by a __fmt function, which may be the program's)
    else if k == .pair and nodes[n].sym > 0: race_named(int(nodes[n].sym), who)
    race_scan(int(nodes[n].a), f, who, captures)
    race_scan(int(nodes[n].b), f, who, captures)
    if k != .for_:
        race_scan(int(nodes[n].c), f, who, captures)
        if k != .partial: race_scan(int(nodes[n].d), f, who, captures)
    loop i in [0..nkids(n)): race_scan(kid(n, i), f, who, captures)
    loop i in [0..nkids2(n)): race_scan(kid2(n, i), f, who, captures)

gen_map_presence = (call: int, f: int) -> int:
    order: int[]
    if nodes[call].c != 0: order = call_eval_order(call)
    gen_direct_call(f, kids(call), order).v

# A positive floor remainder bounds its result even when its input wraps.
# Recognize the bundled signed helper, never a user overload with this name.
positive_modulus = (n: int) -> int:
    if nodes[n].kind == .binary and nodes[n].aux == 0 and nodes[n].op == i32(int(Tok.percent)) and nodes[n].aux2 == -1:
        known, divisor = integer_constant(int(nodes[n].b))
        return if known and divisor > 0: divisor else: 0
    if nodes[n].kind != .call or nodes[n].aux != 0 or nkids(n) != 2: return 0
    f = int(nodes[n].sym)
    if prune(int(fns[f].ret)) != T_INT and prune(int(fns[f].ret)) != T_MATH_INT: return 0
    d = int(fns[f].decl)
    if d == 0: return 0
    masked = nodes[d].name == intern("__floor_mod_pow2")
    if nodes[d].name != intern("__floor_mod") and not masked: return 0
    if files[pos_file(nodes[d].pos)].path != lib_dir + "/std/date.jo" and files[pos_file(nodes[d].pos)].path != lib_dir + "/math_int.jo": return 0
    b = kid(n, 1)
    if nodes[b].kind != .int_lit or has_flag(b, NF_U64) or nodes[b].ival <= 0: return 0
    if masked:
        if nodes[b].ival == 9223372036854775807: return 0
        return nodes[b].ival + 1
    nodes[b].ival

gen_positive_mod = (n: int) -> int:
    if prune(ntype(n)) == T_MATH_INT: return -1
    modulus = positive_modulus(n)
    if modulus == 0: return -1
    a = kid(n, 0)
    if positive_bound(a, true) < 0: return -1
    # The divisor is a pure literal; the dividend is evaluated exactly once.
    e_bin(.remu, VI, gen_expr(a).v, e_iconst(modulus))

# Keep ordinary integer arithmetic cheap without requiring whole-program
# inlining. Only bundled helpers and literal positive divisors are eligible;
# zero, negative divisors and user overloads keep their ordinary call paths.
gen_constant_floor = (n: int) -> int:
    # Release inlining exposes the helpers' branches to broader optimization.
    # Direct selects help the fast path but regress some optimized array loops.
    if opt_release: return -1
    if nkids(n) != 2: return -1
    f = int(nodes[n].sym)
    t = prune(int(fns[f].ret))
    if t != T_INT and t != T_U64: return -1
    d = int(fns[f].decl)
    if d == 0: return -1
    name = name_of(int(nodes[d].name))
    if name != "__floor_mod" and name != "__floor_div" and name != "__floor_mod_pow2" and name != "__floor_div_pow2": return -1
    if files[pos_file(nodes[d].pos)].path != lib_dir + "/std/date.jo" and files[pos_file(nodes[d].pos)].path != lib_dir + "/math_int.jo": return -1
    b = kid(n, 1)
    if nodes[b].kind != .int_lit or has_flag(b, NF_U64): return -1
    divisor = nodes[b].ival
    if name == "__floor_div_pow2":
        if divisor < 0 or divisor >= 64: return -1
    else if name == "__floor_mod_pow2":
        if divisor < 0: return -1
    else if divisor <= 0: return -1
    # The other operand is a pure literal, so source order still evaluates the
    # dividend exactly once, even when the result simplifies to zero or itself.
    a = gen_expr(kid(n, 0)).v
    constant = e_iconst(divisor)
    if name == "__floor_div_pow2":
        shift_op = if t == T_U64: Op.shru else: Op.shrs
        return e_bin(shift_op, VI, a, constant)
    if name == "__floor_mod_pow2": return e_bin(.and_, VI, a, constant)
    modulo = name == "__floor_mod"
    op = if modulo: (if t == T_U64: Op.remu else: Op.rems) else: (if t == T_U64: Op.divu else: Op.divs)
    value = e_bin(op, VI, a, constant)
    if t == T_U64: return value
    sign_input = if modulo: value else: a
    negative = e_bin(.lts, VI, sign_input, e_iconst(0))
    adjust = negative
    corrected = 0
    if modulo: corrected = e_bin(.add, VI, value, constant)
    else:
        remainder = e_bin(.ne, VI, a, e_bin(.mul, VI, value, constant))
        adjust = e_bin(.and_, VI, negative, remainder)
        corrected = e_addi(value, -1)
    result = vreg(VI)
    emit(.select, VI, result, adjust, corrected, value, 0)
    result

# `bytes.read<uint64>(i)` (the library's __dewy_read_u64, u32 and u16): its check and an
# unaligned load in place of the call, which a default build would not expand. The
# receiver is kept alive only when the offset's evaluation could change it.
gen_byte_read = (e: int) -> int:
    if nkids(e) != 2: return -1
    d = int(fns[int(nodes[e].sym)].decl)
    if d == 0: return -1
    name = name_of(int(nodes[d].name))
    width = if name == "__dewy_read_u64": 8 else if name == "__dewy_read_u32": 4 else if name == "__dewy_read_u16": 2 else: 0
    if width == 0 or files[pos_file(nodes[d].pos)].path != lib_dir + "/std/dewy.jo": return -1
    a = kid(e, 0)
    bt = prune(ntype(a))
    source = gen_expr(a)
    root = a
    if nodes[a].kind == .intrinsic and (nodes[a].aux as IN) == .to_bytes and nkids(a) == 1: root = kid(a, 0)
    if not byte_offset_plain(kid(e, 1)) and not unchanged_by(text_source(root), kid(e, 1)): source = own(source, bt)
    borrow(source, bt)
    p = vreg(VI)
    e_mov(p, source.v)
    i = gen_expr(kid(e, 1)).v
    n = arr_len(p)
    # (0 <=? i <=? n - width as one unsigned compare: i below the count of offsets that
    # fit, n - width + 1, or 0 when none do)
    fits = e_addi(n, 1 - width)
    count = vreg(VI)
    emit(.select, VI, count, e_bin(.lts, VI, fits, e_iconst(0)), e_iconst(0), fits, 0)
    iff(e_bin(.geu, VI, i, count))
    e_call_nr3(rt("__dewy_read_out"), i, n, e_iconst(width * 8), -1)
    endc()
    e_load(VI, e_bin(.add, VI, p, i), 24, width)

# (an offset of plain reads, literals and builtin integer arithmetic: it calls nothing and
# writes nothing, so the receiver read before it stands)
byte_offset_plain = (n: int) -> bool:
    if plain_read(n): return true
    k = nodes[n].kind
    if k == .binary and nodes[n].aux == 0 and is_int(ntype(n)): return byte_offset_plain(int(nodes[n].a)) and byte_offset_plain(int(nodes[n].b))
    if k == .conv and nodes[n].aux == i32(int(CV.int_)): return byte_offset_plain(int(nodes[n].a))
    false

# ---------------- ticks that must agree ----------------
# A function given to a @deterministic function (netplay.session's tick) must give the same game
# on every machine from the same game and inputs: no random numbers but from a seed in the game,
# no clock, no input read there (it comes as the tick's input), and no globals changed (a
# rollback does not put them back) -- also not in the functions it calls. Warnings: random()
# after seed() from the game, say, is the same everywhere.
det_done: {int: bool} = {}
DET_CALLS = ["random", "random_int", "random_normal", "random_direction", "random_point", "random_in_circle", "random_color", "rand", "randn", "shuffle",
             "time", "elapsed", "frame_time", "fps", "frame_number", "unix_time", "now",
             "mouse_pos", "mouse_down", "mouse_pressed", "mouse_delta", "key_down", "key_pressed", "action_down", "action_pressed", "action_axis",
             "action_value", "input_axis", "touches", "gamepad_down", "gamepad_pressed", "gamepad_axis"]

# Check mode can type-check entry functions without scheduling them for lowering.
# Visit their checked calls so its diagnostics agree with a normal build.
det_check_program = ():
    enabled = false
    loop f in fns:
        if f.deterministic: enabled = true; break
    if not enabled: return
    loop f in fns:
        if f.body != 0 and f.state == 2 and not in_lib(nodes[int(f.body)].pos): det_calls(int(f.body))

det_calls = (n: int):
    if n == 0 or nodes[n].kind == .lambda: return
    k = nodes[n].kind
    if k == .call and nodes[n].aux == 0 and nodes[n].sym > 0:
        f = int(nodes[n].sym)
        if fns[f].deterministic: det_check(f, kids(n), nodes[n].pos)
    det_calls(int(nodes[n].a))
    det_calls(int(nodes[n].b))
    if k != .for_:
        det_calls(int(nodes[n].c))
        if k != .partial: det_calls(int(nodes[n].d))
    loop child in kids(n): det_calls(child)
    loop child in kids2(n): det_calls(child)

det_check = (callee: int, args: int[], pos: int):
    if in_lib(pos): return
    d = int(fns[callee].decl)
    whose = "{name_of(int(modules[int(nodes[d].mod)].name))}.{name_of(int(nodes[d].name))}'s tick"
    loop a in args:
        if tkind(ntype(a)) == .fn_: det_arg(a, whose)

# (who: "tick is netplay.session's tick", said in each warning)
det_arg = (a: int, whose: str):
    k = nodes[a].kind
    if k == .conv: det_arg(int(nodes[a].a), whose)
    else if k == .lambda: det_scan(int(fns[int(nodes[a].sym)].body), "this function is " + whose)
    else if k == .fnref: det_named(int(nodes[a].sym), "{name_of(int(nodes[int(fns[int(nodes[a].sym)].decl)].name))} is {whose}")
    else if k == .partial:
        if nodes[a].aux == 1: det_arg(int(nodes[a].a), whose)
        else: det_named(int(nodes[a].sym), "{name_of(int(nodes[int(fns[int(nodes[a].sym)].decl)].name))} is {whose}")

det_named = (f: int, who: str):
    if det_done.contains(f) or fns[f].body == 0 or fns[f].decl == 0: return
    det_done[f] = true
    if in_lib(int(nodes[int(fns[f].decl)].pos)): return
    det_scan(int(fns[f].body), who)

det_scan = (n: int, who: str):
    if n == 0: return
    k = nodes[n].kind
    if k == .lambda: return
    if k == .assign: det_target(int(nodes[n].a), who, nodes[n].pos)
    else if k == .intrinsic and nkids(n) > 0:
        id = nodes[n].aux as IN
        if id == .push or id == .pop or id == .insert or id == .remove or id == .clear or id == .reserve or id == .resize or id == .truncate or id == .extend:
            det_target(kid(n, 0), who, nodes[n].pos)
    else if k == .call:
        mm = checked_call_mutmask(n)
        loop i in [0..nkids(n)):
            if mm & (1 << i) != 0: det_target(kid(n, i), who, nodes[kid(n, i)].pos)
        g = int(nodes[n].sym)
        if int(nodes[n].aux) == 0 and g > 0 and fns[g].decl != 0:
            d = int(fns[g].decl)
            nm = name_of(int(nodes[d].name))
            if in_lib(int(nodes[d].pos)):
                # (shuffle(rng, xs) and the like, from an Rng kept in the game, are the same everywhere)
                # unix_time(Date) converts a supplied value; only unix_time() reads the clock.
                clock_conversion = nm == "unix_time" and fns[g].ptypes.len() > 0
                if DET_CALLS.contains(nm) and not det_has_rng(g) and not clock_conversion:
                    what = "reads the clock"
                    if starts_with(nm, "rand") or nm == "shuffle": what = "takes random numbers"
                    else if nm == "frame_number" or nm == "fps": what = "reads the frame count"
                    else if nm != "time" and nm != "elapsed" and nm != "frame_time" and nm != "unix_time" and nm != "now": what = "reads the input"
                    warn(nodes[n].pos, "{who}, and here it {what} ({nm}()), which can differ between machines and cause a desync; {det_hint(nm)}")
            else: det_named(g, who)
    else if k == .for_ and has_flag(n, NF_MUT): det_target(int(nodes[n].a), who, nodes[n].pos)
    det_scan(int(nodes[n].a), who)
    det_scan(int(nodes[n].b), who)
    if k != .for_:
        det_scan(int(nodes[n].c), who)
        if k != .partial: det_scan(int(nodes[n].d), who)
    loop i in [0..nkids(n)): det_scan(kid(n, i), who)
    loop i in [0..nkids2(n)): det_scan(kid2(n, i), who)

det_hint = (nm: str) -> str:
    if starts_with(nm, "rand") or nm == "shuffle": return "make them from the game (`hash(g.tick * 7 + i)`), or from an Rng kept in it"
    if nm == "time" or nm == "elapsed" or nm == "frame_time" or nm == "unix_time" or nm == "now" or nm == "frame_number" or nm == "fps": return "count ticks in the game and use a fixed timestep"
    "read it in update, and give it to the tick as the player's input"

# (a function with an Rng among its parameters takes its numbers from that)
det_has_rng = (g: int) -> bool:
    loop t in fns[g].ptypes:
        tt = prune(int(t))
        if tkind(tt) == .struct_ and type_str(tt) == "Rng": return true
    false

det_target = (t: int, who: str, pos: int):
    n = place_var(t)
    if n == 0 or nodes[n].aux != i32(int(SK.global)): return
    warn(pos, "{who}, and here it changes the global '{name_of(int(nodes[n].name))}', which a rollback does not put back (ticks are played again from an earlier game): keep it in the game")

gen_direct_call = (f: int, args: int[], order: int[] = [], call_node: int = 0) -> Val:
    if partition_active and partition_call_needed(f, args): return partition_call(f, args, order)
    ret = int(fns[f].ret)
    rslot = -1
    argv: int[]
    if vc(ret) == VC_AGG:
        rslot = new_temp(ret)
        argv.push(e_slot(rslot))
    mark = copy_backs.len()
    snaps = arg_snapshots.len()
    call_args(args, fns[f].ptypes, inst_mutmask(f), argv, f, order)
    if refine_active: refine_gen_args(args, argv, if vc(ret) == VC_AGG: 1 else: 0)
    # Default builds can inline tiny checked helpers without expanding their
    # failure path. Release keeps its measured whole-function inlining policy.
    # Still unwind lowering's pending copy-back records; their unreachable
    # instructions are discarded by control-flow cleanup.
    if ownership_decls.len() != 0:
        base = if vc(ret) == VC_AGG: 1 else: 0
        loop i in [0..fns[f].ptypes.len()):
            if copy_consumes(f, i) and ownership_type(fns[f].ptypes[i]): owner_forget(argv[base + i])
    nr = not opt_release and not dbg_on and prune(ret) == T_NEVER
    target_lf = if callback_calls.len() == 0: -1 else: callback_calls.get(callback_key(ir.fn_index, call_node)) ?? -1
    if target_lf < 0: target_lf = lf_of_inst(f)
    rv = if nr: e_call_nr(target_lf, argv, -1) else: e_call(target_lf, argv, ret_vt(ret))
    copy_back(mark)
    release_arg_snapshots(snaps)
    finish_call(ret, rv, rslot)

gen_closure_call = (callee: int, args: int[], order: int[] = []) -> Val:
    ft = callable_base(ntype(callee))
    ret = int(types[ft].elem)
    source = callee
    selected = nodes[callee].kind == .fnref and nodes[callee].aux == 2
    if selected: source = int(nodes[callee].a)
    target = -1
    if nodes[source].kind == .ident and nodes[source].aux == i32(int(SK.local)):
        target = callback_local(int(nodes[source].sym))
        if target < 0: target = stack_closure_target(int(nodes[source].sym))
    known = if selected: int(nodes[callee].sym) else: target
    cval = gen_expr(source)
    # A const callable is a saved value: call a temporary copy so its private
    # state cannot change through the const binding. Explicit shared cells stay shared.
    root = place_var(callee)
    frozen_value = false
    if root != 0:
        if nodes[root].aux == i32(int(SK.local)): frozen_value = int(locals[int(nodes[root].sym)].flags) & LF_CONST != 0
        else if nodes[root].aux == i32(int(SK.global)): frozen_value = readonly_global(int(nodes[root].sym))
    if frozen_value: cval = own_at(source, cval, ft)
    borrow(cval, ft)
    # Pin the exact environment when arguments or the callback can replace its
    # owner. Owned temporaries already stay alive through statement cleanup, and
    # an unaliased local callable needs no refcount traffic on every invocation.
    # The invocation-only proof also excludes replacing the owner through args.
    pin = target < 0 and not cval.owned and (root == 0 or borrow_may_change(callee, args, -1, 0))
    if target < 0 and not cval.owned and not pin and root != 0:
        mm = int(types[ft].mutmask)
        loop i in 0.. and arg in args:
            if mm & (1 << i) != 0 or may_write_root(arg, root): pin = true
    cv = cval.v
    if pin:
        saved = new_temp(ft)
        cv = e_slot(saved)
        e_copy(cv, cval.v, tsize(ft))
        retain(e_load(VI, cv, ptr_size, ptr_size), T_STR)
        reg_temp_slot(saved, ft)
    fp = 0
    if known < 0:
        fp = e_load(VI, cv, 0, ptr_size)
        # (a field or variable of a function type never given one: none, said as that)
        iff(e_bin(.eq, VI, fp, e_iconst(0)))
        e_call_nr2(rt("__panic_nofn"), e_daddr(loc_data(nodes[callee].pos)), e_daddr(str_data(place_text(callee))), -1)
        endc()
    env = e_load(VI, cv, ptr_size, ptr_size)
    rslot = -1
    argv: int[]
    if vc(ret) == VC_AGG:
        rslot = new_temp(ret)
        argv.push(e_slot(rslot))
    argv.push(env)
    pts: int[]
    loop i in [0..int(types[ft].nargs)): pts.push(targ(ft, i))
    mark = copy_backs.len()
    snaps = arg_snapshots.len()
    call_args(args, pts, int(types[ft].mutmask), argv, order = order)
    if refine_active: refine_gen_args(args, argv, if vc(ret) == VC_AGG: 2 else: 1)
    rv = if known >= 0: e_call(lf_of_inst(known), argv, ret_vt(ret)) else: e_calli(fp, argv, ret_vt(ret), false)
    copy_back(mark)
    release_arg_snapshots(snaps)
    finish_call(ret, rv, rslot)

gen_cfn_call = (callee: int, args: int[]) -> Val:
    ft = callable_base(ntype(callee))
    ret = int(types[ft].elem)
    fp = gen_expr(callee).v
    argv: int[]
    loop a in args:
        val = gen_expr(a)
        borrow(val, ntype(a))
        argv.push(val.v)
    rv = e_calli(fp, argv, ret_vt(ret), true)
    if vc(ret) == VC_AGG: ice("C functions returning structs are not supported")
    finish_call(ret, rv, -1)

# ---------------- closures ----------------
env_layout = (f: int):
    if fns[f].env_size != 0: return
    if fns[f].kind == FK_LAMBDA and fns[f].target != 0:
        poly_env_layout(int(fns[f].target))
        return
    off = if ownership_callable_cap(int(fns[f].fntype)) != 0: 32 else: 24
    loop cap in fns[f].caps:
        inn = int(cap.inner)
        if is_shared(inn): check_cell_type(inn)
        t = store_type(inn)
        al = talign(t)
        if al < 8: al = 8
        off = align_up(off, al)
        locals[inn].env_off = i32(off)
        off += tsize(t)
    fns[f].env_size = i32(align_up(off, 8))

closure_size = () -> int: 2 * ptr_size

# A direct local closure may keep its environment in this activation when every
# reference is a direct invocation, or an immutable environment is passed to
# an invocation-only parameter. Copies, returns, captures, rebinding and
# address-taking retain the ordinary heap representation.
lower_entry: Ins[]
stack_closure_fn = -1
stack_closure_locals: {int: bool} = {}
stack_closure_targets: {int: int} = {}
stack_closure_passed: {int: bool} = {}
stack_closure_params: {int: bool} = {}

# Fail closed: a parameter may only be invoked or forwarded to another proven
# invocation-only parameter. In-progress summaries are false, closing cycles.
# Aggregates, escaping captures, rebinding and return values remain excluded.
closure_invoked_only = (n: int, l: int, called: bool = false) -> bool:
    if n == 0: return true
    k = nodes[n].kind
    if k == .fn_: return true
    if k == .lambda:
        f = int(nodes[n].sym)
        if f <= 0 or has_flag(n, NF_GENERIC): return false
        loop cap in fns[f].caps:
            if cap.outer != i32(l): continue
            inn = int(cap.inner)
            if not called or int(locals[inn].flags) & (LF_ASSIGNED | LF_ADDR | LF_EXPOSED | LF_SHARED) != 0: return false
            if not closure_invoked_only(int(fns[f].body), inn): return false
        return true
    if k == .ident: return called or nodes[n].aux != i32(int(SK.local)) or nodes[n].sym != i32(l)
    a = int(nodes[n].a)
    direct = k == .call and nodes[n].aux == 1
    if not closure_invoked_only(a, l, direct): return false
    if not closure_invoked_only(int(nodes[n].b), l): return false
    if k != .for_:
        if not closure_invoked_only(int(nodes[n].c), l): return false
        if k != .partial and not closure_invoked_only(int(nodes[n].d), l): return false
    loop i in [0..nkids(n)):
        arg = kid(n, i)
        forwarded = k == .call and nodes[n].aux == 0 and (nodes[arg].kind == .lambda or nodes[arg].kind == .ident and nodes[arg].aux == i32(int(SK.local)) and nodes[arg].sym == i32(l)) and closure_borrow_param(int(nodes[n].sym), i)
        if not closure_invoked_only(arg, l, forwarded): return false
    loop i in [0..nkids2(n)):
        if not closure_invoked_only(kid2(n, i), l): return false
    true

closure_borrow_param = (f: int, i: int) -> bool:
    if f <= 0 or i >= fns[f].params.len() or fns[f].cabi: return false
    d = int(fns[f].decl)
    if d == 0 or copy_consumes(f, i): return false
    # The fork-join runtime borrows this closure's raw address only until its
    # scoped join returns. AST address-taking cannot express that contract.
    if i == 1 and modules[int(fns[f].mod)].is_prelude and name_of(int(nodes[d].name)) == "__parallel_run": return true
    p = fns[f].params[i]
    if stack_closure_params.has(p): return stack_closure_params[p]
    stack_closure_params[p] = false
    if int(locals[p].flags) & (LF_MUTPARAM | LF_ASSIGNED | LF_ADDR | LF_EXPOSED) != 0: return false
    body = int(fns[f].body)
    if not files[pos_file(nodes[d].pos)].is_dewy:
        ok = closure_invoked_only(body, p)
        stack_closure_params[p] = ok
        return ok
    loop j in [0..nkids(body)):
        s = kid(body, j)
        if nodes[s].kind != .vardecl or nodes[s].aux2 != 1: break
        iv = int(nodes[s].b)
        if iv == 0 or nodes[iv].kind != .ident or nodes[iv].aux != i32(int(SK.local)) or nodes[iv].sym != i32(p): continue
        l = int(nodes[s].sym)
        if int(locals[l].flags) & (LF_ASSIGNED | LF_ADDR | LF_EXPOSED | LF_SHARED) != 0: return false
        ok = closure_invoked_only(body, l)
        stack_closure_params[p] = ok
        return ok
    false

# Match envcopy's retain-only case. A mutable or owner environment must still
# use the heap: its copy helper may allocate and copy the environment header.
closure_env_shareable = (f: int) -> bool:
    if ownership_callable_cap(int(fns[f].fntype)) != 0: return false
    loop cap in fns[f].caps:
        inn = int(cap.inner)
        flags = int(locals[inn].flags)
        if flags & LF_VALUECAP != 0 and (flags & (LF_ASSIGNED | LF_EXPOSED) != 0 or is_shared(inn) or type_has_fn(int(locals[inn].type)) or ownership_type(int(locals[inn].type))): return false
    true

stack_closure_target = (l: int) -> int:
    if stack_closure_fn != cur_fn: return -1
    stack_closure_targets.get(l) ?? -1

# Invocation pins have ended before scope cleanup. No value can retain this
# environment, so only its managed captures need destruction, with no RC dispatch.
closure_managed_captures = (f: int) -> bool:
    loop cap in fns[f].caps:
        if is_managed(store_type(int(cap.inner))): return true
    false

closure_scalar_environment = (f: int) -> bool:
    ownership_callable_cap(int(fns[f].fntype)) == 0 and not closure_managed_captures(f)

drop_stack_closure = (addr: int, f: int):
    if not closure_managed_captures(f): return
    env = e_load(VI, addr, ptr_size, ptr_size)
    iff(env)
    e_call1(lf_helper(.stackenvdrop, 0, f), env, -1)
    endc()

stack_closure_uses = (n: int, called: bool = false):
    if n == 0: return
    k = nodes[n].kind
    if k == .lambda or k == .fn_: return
    if k == .fnref and nodes[n].aux == 2:
        stack_closure_uses(int(nodes[n].a), called)
        return
    if k == .ident:
        if not called and nodes[n].aux == i32(int(SK.local)):
            l = int(nodes[n].sym)
            if stack_closure_locals.has(l): stack_closure_locals[l] = false
        return
    a = int(nodes[n].a)
    direct = k == .call and nodes[n].aux == 1 and a != 0 and (nodes[a].kind == .ident or nodes[a].kind == .fnref and nodes[a].aux == 2)
    stack_closure_uses(a, direct)
    stack_closure_uses(int(nodes[n].b))
    if k != .for_:
        stack_closure_uses(int(nodes[n].c))
        if k != .partial: stack_closure_uses(int(nodes[n].d))
    loop i in [0..nkids(n)):
        arg = kid(n, i)
        safe = k == .call and nodes[n].aux == 0 and nodes[arg].kind == .ident and nodes[arg].aux == i32(int(SK.local)) and stack_closure_locals.has(int(nodes[arg].sym)) and closure_borrow_param(int(nodes[n].sym), i)
        if safe: stack_closure_passed[int(nodes[arg].sym)] = true
        stack_closure_uses(arg, safe)
    loop i in [0..nkids2(n)): stack_closure_uses(kid2(n, i))

stack_closure_local = (l: int) -> bool:
    if stack_closure_fn != cur_fn:
        stack_closure_fn = cur_fn
        stack_closure_locals.clear()
        stack_closure_targets.clear()
        stack_closure_passed.clear()
        stack_closure_params.clear()
        skip = LF_CONST | LF_PARAM | LF_MUTPARAM | LF_ASSIGNED | LF_CAPTURE | LF_CAPTURED | LF_ADDR | LF_BYREF | LF_ALIAS | LF_SHARED
        loop candidate in fns[cur_fn].locals:
            if int(locals[candidate].flags) & skip != 0: continue
            if is_fn_type(int(locals[candidate].type)) or tkind(int(locals[candidate].type)) == .polyfn: stack_closure_locals[candidate] = true
        if stack_closure_locals.len() > 0: stack_closure_uses(int(fns[cur_fn].body))
    stack_closure_locals.get(l) ?? false

gen_lambda = (e: int, stack: bool = false) -> Val:
    f = int(nodes[e].sym)
    generic = has_flag(e, NF_GENERIC)
    if generic: f = poly_families[int(nodes[e].aux)].envfn
    env_layout(f)
    loop capture in fns[f].caps:
        if int(locals[int(capture.inner)].flags) & LF_PARTBORROW != 0:
            fatal(nodes[e].pos, "mutable array parameter captures require a proven-disjoint scoped fork")
    if ownership_callable_cap(int(fns[f].fntype)) >= 3 and not stack:
        fatal(nodes[e].pos, "borrowed owner captures require a nonescaping directly invoked local closure")
    hoist = stack and ownership_callable_cap(int(fns[f].fntype)) == 0
    record_start = ir.code.len()
    s = new_slot(closure_size(), ptr_size)
    a = e_slot(s)
    e_store(a, 0, (if generic: e_iconst(0) else: e_faddr(lf_of_inst(f))), ptr_size)
    if fns[f].caps.len() == 0:
        e_store(a, ptr_size, e_iconst(0), ptr_size)
        if hoist:
            lower_entry += ir.code[record_start..]
            ir.code.truncate(record_start)
        return Val(a, true, s)
    env = 0
    env_slot = -1
    if stack:
        env_slot = new_slot(int(fns[f].env_size), 8)
        env = e_slot(env_slot)
    else: env = e_call1(rt("__alloc"), e_iconst(int(fns[f].env_size)), VI)
    e_store(a, ptr_size, env, ptr_size)
    if not hoist: hdr_store(env, 0, e_iconst(1))
    # A stack slot has one closure layout throughout this activation. Its
    # destructor/copy pointers never change. Temporary retains are balanced
    # before its next lifetime, so its refcount starts and ends at one too.
    # Resource environments retain their ordinary construction protocol.
    metadata_start = ir.code.len()
    header = if hoist: e_slot(env_slot) else: env
    if hoist: hdr_store(header, 0, e_iconst(1))
    drop_kind = if stack: HK.stackenvdrop else: HK.envdrop
    hdr_store(header, 8, e_faddr(lf_helper(drop_kind, 0, f)))
    # Stack environments are never retained beyond the activation. Callback
    # parameters may temporarily retain an immutable one while invoking it.
    resource = ownership_callable_cap(int(fns[f].fntype)) != 0
    if resource and not ownership_copyable(int(fns[f].fntype)):
        hdr_store(header, 16, e_iconst(0))
    else: hdr_store(header, 16, e_faddr(lf_helper(.envcopy, 0, f)))
    if hoist:
        lower_entry += ir.code[metadata_start..]
        ir.code.truncate(metadata_start)
    if resource:
        hdr_store(env, 24, e_iconst(0))
        owner_register(s, ntype(e))
    if hoist and closure_scalar_environment(f):
        lower_entry += ir.code[record_start..]
        ir.code.truncate(record_start)
    ids: int[]
    if copies_on: ids = copy_capture_ids(e)
    index = 0
    loop cap in fns[f].caps:
        outer = int(cap.outer)
        inn = int(cap.inner)
        if int(locals[inn].flags) & LF_OWNERBORROW != 0:
            store_val(store_type(inn), env, int(locals[inn].env_off), place_addr(local_place(outer, false), int(locals[outer].type)))
            index += 1
            if resource: hdr_store(env, 24, e_iconst(index))
            continue
        if is_shared(inn) and int(locals[inn].flags) & LF_VALUECAP == 0:
            # An explicit shared capture holds the original cell.
            st = store_type(outer)
            c = read_place(cell_place(outer), st)
            retain(c, st)
            store_val(st, env, int(locals[inn].env_off), c)
            index += 1
            if resource: hdr_store(env, 24, e_iconst(index))
            continue
        t = int(locals[outer].type)
        id = if copies_on: ids[index] else: mk_ident_local(outer, nodes[e].pos)
        val = own_at(id, gen_expr(id), t)
        if is_shared(inn):
            # A nested explicit capture may share this private snapshot. Give
            # it a fresh cell, never the enclosing variable's cell.
            cell = e_call2(rt("__arr_repeat"), e_iconst(1), e_iconst(max(1, tsize(t))), VI)
            store_val(t, cell, 24, val.v)
            store_val(store_type(inn), env, int(locals[inn].env_off), cell)
        else: store_val(t, env, int(locals[inn].env_off), val.v)
        if resource:
            if ownership_type(t): owner_forget_slot(val.slot)
            hdr_store(env, 24, e_iconst(index + 1))
        index += 1
    Val(e_slot(s), true, s)

gen_fnref = (e: int) -> Val:
    f = int(nodes[e].sym)
    parallel_direct(f, nodes[e].pos)
    if nodes[e].aux == 2:
        source = gen_expr(int(nodes[e].a))
        borrow(source, ntype(int(nodes[e].a)))
        s = new_slot(closure_size(), ptr_size)
        a = e_slot(s)
        e_store(a, 0, e_faddr(lf_of_inst(f)), ptr_size)
        e_store(a, ptr_size, e_load(VI, source.v, ptr_size, ptr_size), ptr_size)
        # Selection borrows the existing environment. Binding/returning/passing
        # this value invokes the normal private-state copy machinery.
        return Val(a, false, s)
    if nodes[e].aux == 1:
        # C function pointer: the raw function
        return V(e_faddr(lf_of_inst(f)), false)
    s = new_slot(closure_size(), ptr_size)
    a = e_slot(s)
    e_store(a, 0, e_faddr(lf_helper(.thunk, 0, f)), ptr_size)
    e_store(a, ptr_size, e_iconst(0), ptr_size)
    Val(a, true, s)

partial_layout = (e: int) -> int[]:
    offs: int[]
    off = 24
    if nodes[e].aux == 1: off += closure_size()
    loop i in [0..nkids(e)):
        a = kid(e, i)
        if nodes[a].kind == .hole:
            offs.push(-1)
            continue
        t = ntype(a)
        al = talign(t)
        if al < 8: al = 8
        off = align_up(off, al)
        offs.push(off)
        off += tsize(t)
    offs.push(align_up(off, 8))
    offs

gen_partial = (e: int) -> Val:
    th = int(nodes[e].d)
    offs = partial_layout(e)
    size = offs[offs.len() - 1]
    fns[th].env_size = i32(size)
    s = new_slot(closure_size(), ptr_size)
    a = e_slot(s)
    e_store(a, 0, e_faddr(lf_helper(.partial, 0, th)), ptr_size)
    env = e_call1(rt("__alloc"), e_iconst(size), VI)
    e_store(a, ptr_size, env, ptr_size)
    hdr_store(env, 0, e_iconst(1))
    hdr_store(env, 8, e_faddr(lf_helper(.envdrop, 0, th)))
    hdr_store(env, 16, e_faddr(lf_helper(.envcopy, 0, th)))
    tracked = build_slot(s, ntype(e))
    target = int(nodes[e].sym)
    if target != 0: parallel_direct(target, nodes[e].pos)
    if nodes[e].aux == 1:
        cv = gen_owned(int(nodes[e].a))
        e_copy(e_addi(env, 24), cv.v, closure_size())
    loop i in [0..nkids(e)):
        arg = kid(e, i)
        if nodes[arg].kind == .hole: continue
        is_mut = false
        if target != 0: is_mut = inst_mutmask(target) & (1 << i) != 0
        else: is_mut = int(types[prune(ntype(int(nodes[e].a)))].mutmask) & (1 << i) != 0
        if is_mut: fatal(nodes[arg].pos, "cannot partially apply a `mut` argument; use `_` for it")
        val = gen_owned(arg)
        store_val(ntype(arg), env, offs[i], val.v)
    if tracked: building.pop()
    Val(e_slot(s), true, s)

# ---------------- string interpolation ----------------
gen_interp = (e: int) -> Val:
    bs = new_slot(8, 8)
    ba = e_slot(bs)
    e_store(ba, 0, e_iconst(0), 8)
    building.push(BuildItem(true, bs, mk_array(T_U8)))
    loop i in [0..nkids(e)):
        p = kid(e, i)
        if nodes[p].kind == .str_lit:
            s = name_of(int(nodes[p].sval))
            if len(s) == 0: continue
            e_call2(rt("__buf_append_str"), e_slot(bs), e_daddr(str_data(s)), -1)
            continue
        f = int(nodes[p].sym)
        x = int(nodes[p].a)
        val = gen_expr(x)
        # (a __fmt of the program's may change where the value came from)
        if not val.owned and is_managed(ntype(x)) and not in_lib(nodes[int(fns[f].decl)].pos) and borrow_may_change(x, [], 0, f): val = own_at(x, val, ntype(x))
        borrow(val, ntype(x))
        argv = [e_slot(bs), val.v]
        if nodes[p].sval >= 0: argv.push(e_daddr(str_data(name_of(int(nodes[p].sval)))))
        e_call(lf_of_inst(f), argv, -1)
    building.pop()
    r = e_call1(rt("__buf_finish"), e_load(VI, e_slot(bs), 0, 8), VI)
    V(r, true)

# ---------------- value blocks ----------------
gen_value_block = (b: int, rs: int, rt_: int, rv: int = -1):
    if let out = exact_join_blocks.get(b):
        values = exact_extend(exact_value(b), out.len())
        loop i in [0..out.len()): e_mov(out[i], values[i])
        return
    scope_push()
    n = nkids(b)
    loop i in [0..n):
        s = kid(b, i)
        if i == n - 1 and nodes[b].aux != 0 and (rs >= 0 or rv >= 0):
            stmt_begin()
            val = gen_owned(int(nodes[s].a))
            if rv >= 0: e_mov(rv, norm(val.v, rt_))
            else:
                store_val(rt_, e_slot(rs), 0, val.v)
                if ownership_type(rt_):
                    owner_forget_slot(val.slot)
                    owner_register(rs, rt_)
            stmt_end()
            continue
        gen_stmt(s)
    scope_pop()

result_from_slot = (rs: int, t: int) -> Val:
    a = e_slot(rs)
    if vc(t) == VC_AGG: return Val(a, true, rs)
    value = load_val(t, a, 0)
    if ownership_type(t): return Val(value, true, rs)
    V(value, true)

# ---------------- match ----------------
gen_match_test = (p: int, st0: int, hidden_addr: int) -> int:
    # returns a vreg that is nonzero when the pattern matches
    st = prune(st0)
    k = nodes[p].kind
    if k == .pwild: return e_iconst(1)
    if k == .ptype:
        if is_union(st):
            tag = e_load(VI, hidden_addr, 0, 4)
            result = e_iconst(0)
            loop member in union_members(ntype(p)):
                hit = e_bin(.eq, VI, tag, e_iconst(union_index(st, member)))
                result = e_bin(.or_, VI, result, hit)
            return result
        if nodes[p].aux2 == 1:
            # (a member of an optional union: present, and holding it)
            u = prune(telem(st))
            pt = prune(ntype(p))
            ms = [pt]
            if is_union(pt): ms = union_members(pt)
            result = vreg(VI)
            e_mov(result, e_iconst(0))
            iff(opt_has(hidden_addr, u))
            tag = e_load(VI, hidden_addr, 0, 4)
            hits = e_iconst(0)
            loop member in ms: hits = e_bin(.or_, VI, hits, e_bin(.eq, VI, tag, e_iconst(union_index(u, member))))
            e_mov(result, hits)
            endc()
            return result
        return opt_has(hidden_addr, telem(st))
    if k == .pvariant:
        si = int(types[st].st)
        layout(st)
        tag = e_load(VI, hidden_addr, 0, 4)
        want = int(nodes[p].aux2)
        if structs[si].simple_enum: want = variants[int(structs[si].variants) + int(nodes[p].aux2)].value
        return e_bin(.eq, VI, tag, e_iconst(want))
    if k == .plit:
        if is_union(st):
            # Inspect the payload only after its tag matches: another member
            # can hold arbitrary bits where a string pointer would be stored.
            layout(st)
            vi = int(nodes[p].aux2)
            variant = int(structs[int(types[st].st)].variants) + vi
            field = int(variants[variant].fields)
            result = vreg(VI)
            e_mov(result, e_iconst(0))
            iff(e_bin(.eq, VI, e_load(VI, hidden_addr, 0, 4), e_iconst(vi)))
            payload = e_addi(hidden_addr, int(fields[field].offset))
            e_mov(result, gen_match_test(p, int(fields[field].type), payload))
            endc()
            return result
        a = int(nodes[p].a)
        if st == T_MATH_INT: return math_compare(.eq, e_load(VI, hidden_addr, 0, 8), gen_borrowed(a).v)
        if types[st].kind == .str_:
            v = gen_borrowed(a).v
            return e_call2(rt("__str_eq"), e_load(VI, hidden_addr, 0, ptr_size), v, VI)
        if types[st].kind == .opt:
            if nodes[a].kind == .none_lit: return e_bin(.eq, VI, opt_has(hidden_addr, int(types[st].elem)), e_iconst(0))
            u = prune(int(types[st].elem))
            if is_union(u):
                # (a member's literal where the value is an (A | B)?: present, then as for A | B; the
                # union sits in place)
                result = vreg(VI)
                e_mov(result, e_iconst(0))
                iff(opt_has(hidden_addr, u))
                e_mov(result, gen_match_test(p, u, hidden_addr))
                endc()
                return result
            fatal(nodes[p].pos, "only `none` and `_` patterns are supported for optionals; use {jd(nodes[p].pos, "`if let v = x`", "`if x isnt? none \{ }`")}")
        if vc(st) == VC_FLT: fatal(nodes[p].pos, "cannot match on floats")
        if vc(st) == VC_AGG: fatal(nodes[p].pos, "unsupported pattern for this type")
        v = gen_expr(a).v
        return e_bin(.eq, VI, load_val(st, hidden_addr, 0), v)
    if k == .prange:
        sg = types[representation_type(st)].kind == .int_ and types[representation_type(st)].sign
        x = load_val(st, hidden_addr, 0)
        lo = gen_expr(int(nodes[p].a)).v
        hi = gen_expr(int(nodes[p].b)).v
        c1 = e_bin(.ges, VI, x, lo)
        if not sg: c1 = e_bin(.geu, VI, x, lo)
        c2 = 0
        if has_flag(p, NF_INCLUSIVE):
            if sg: c2 = e_bin(.les, VI, x, hi)
            else: c2 = e_bin(.leu, VI, x, hi)
        else:
            if sg: c2 = e_bin(.lts, VI, x, hi)
            else: c2 = e_bin(.ltu, VI, x, hi)
        return e_bin(.and_, VI, c1, c2)
    fatal(nodes[p].pos, "invalid pattern")
    0

# constant value of an integer literal pattern
pat_int = (a0: int) -> (bool, int):
    a = a0
    if nodes[a].kind == .conv: a = int(nodes[a].a)
    if nodes[a].kind == .int_lit: return (true, nodes[a].ival)
    (false, 0)

gen_arm_body = (arm: int, rs: int, rtp: int, val: bool):
    enter_cond()
    body = int(nodes[arm].b)
    if val: gen_value_block(body, rs, rtp)
    else:
        scope_push()
        gen_block_stmts(body)
        scope_pop()
    leave_cond()

# A dense match whose arms are scalar constants needs a data lookup, not
# one machine-code branch per arm. Keep the subject's existing evaluation and
# lifetime, and leave effectful/converting bodies on the ordinary path.
match_arm_constant = (arm: int) -> (bool, int):
    body = int(nodes[arm].b)
    if nodes[body].aux == 0 or nkids(body) != 1: return (false, 0)
    statement = kid(body, 0)
    if nodes[statement].kind != .exprstmt: return (false, 0)
    value = int(nodes[statement].a)
    kind = nodes[value].kind
    if kind == .int_lit or kind == .bool_lit: return (true, nodes[value].ival)
    if kind == .dotname:
        t = prune(ntype(value))
        si = int(types[t].st)
        if structs[si].simple_enum: return (true, variants[int(structs[si].variants) + int(nodes[value].aux)].value)
    (false, 0)

gen_match_lookup = (m: int, st: int, rs: int, rtp: int, vals: int[], arms: int[], wild: int, lo: int, span: int) -> bool:
    if exact_has_node(m) or wild < 0: return false
    # Arbitrary-precision int results aren't plain words.
    if quantity_base(prune(rtp)) == T_MATH_INT: return false
    result_kind = types[prune(rtp)].kind
    if result_kind != .int_ and result_kind != .bool_ and result_kind != .enum_: return false
    if result_kind == .enum_ and not structs[int(types[prune(rtp)].st)].simple_enum: return false
    results: int[]
    low = 0
    high = 0
    loop i in [0..nkids(m)):
        ok, value = match_arm_constant(kid(m, i))
        if not ok: return false
        results.push(value)
        if value < low: low = value
        if value > high: high = value
    width = 8
    signed = low < 0
    if low >= 0:
        if high <= 255: width = 1
        else if high <= 65535: width = 2
        else if high <= 4294967295: width = 4
    else:
        if low >= -128 and high <= 127: width = 1
        else if low >= -32768 and high <= 32767: width = 2
        else if low >= -2147483648 and high <= 2147483647: width = 4
    fallback = results[wild]
    table = fill(fallback, span)
    # Earlier arms win, including an earlier wildcard.
    j = vals.len() - 1
    loop j >= 0:
        if arms[j] < wild: table[vals[j] - lo] = results[arms[j]]
        j -= 1
    loop rodata.len() % width != 0: rodata.push(0)
    offset = rodata.len()
    ro_starts.push(offset)
    loop value in table:
        loop byte in [0..width): rodata.push(u8((value >> (8 * byte)) & 255))
    if fused_on: fz_note_raw(offset, width)
    ha = e_slot(int(locals[int(nodes[m].sym)].offset))
    x = if types[st].kind == .enum_: e_load(VI, ha, 0, 4) else: load_val(st, ha, 0)
    index = e_bin(.sub, VI, x, e_iconst(lo))
    result = vreg(VI)
    e_mov(result, e_iconst(fallback))
    iff(e_bin(.ltu, VI, index, e_iconst(span)))
    address = e_bin(.add, VI, e_daddr(offset), e_bin(.mul, VI, index, e_iconst(width)))
    e_mov(result, e_load(VI, address, 0, width | (if signed: M_SIGNED else: 0)))
    endc()
    store_val(rtp, e_slot(rs), 0, result)
    true

# matches on enum tags or integer literals with a dense value range dispatch through a jump table
gen_match_switch = (m: int, st0: int, rs: int, rtp: int, val: bool) -> bool:
    st = prune(st0)
    is_enum = types[st].kind == .enum_
    if st == T_MATH_INT: return false
    if not is_enum and types[st].kind != .int_: return false
    na = nkids(m)
    # A grouped constant arm plus a wildcard can cover many alternatives.
    # The lookup threshold depends on those alternatives, not the arm count.
    if na < 2 or (na < 3 and (not val or dbg_on)): return false
    vals: int[]
    arms: int[]
    wild = -1
    loop i in [0..na):
        arm = kid(m, i)
        loop k in [0..nkids(arm)):
            p = kid(arm, k)
            pk = nodes[p].kind
            if pk == .pwild:
                if wild < 0: wild = i
            else if pk == .pvariant and is_enum:
                si = int(types[st].st)
                v = int(nodes[p].aux2)
                if structs[si].simple_enum: v = variants[int(structs[si].variants) + int(nodes[p].aux2)].value
                vals.push(v)
                arms.push(i)
            else if pk == .plit and not is_enum:
                ok, v = pat_int(int(nodes[p].a))
                if not ok: return false
                vals.push(v)
                arms.push(i)
            else: return false
    if vals.len() < 3: return false
    lo = vals[0]
    hi = vals[0]
    loop v in vals:
        if v < lo: lo = v
        if v > hi: hi = v
    span = hi - lo + 1
    if span <= 0 or span > 4096: return false
    dense = span <= 2 * vals.len() + 16
    # Large boolean membership sets still need at most 256 bytes. Their
    # otherwise sparse tags should not require a long linear branch chain.
    small_bool = val and vals.len() >= 8 and span <= 256 and types[prune(rtp)].kind == .bool_
    if val and not dbg_on and (dense or small_bool) and gen_match_lookup(m, st, rs, rtp, vals, arms, wild, lo, span): return true
    if na < 3 or not dense: return false
    if is_enum: layout(st)
    # blocks: end, fail, then one per arm (arm 0 innermost)
    blk()
    end_level = ctl
    blk()
    fail_level = ctl
    arm_level = fill(0, na)
    i = na - 1
    loop i >= 0:
        blk()
        arm_level[i] = ctl
        i -= 1
    ha = local_place(int(nodes[m].sym), false).v
    x = 0
    if is_enum: x = e_load(VI, ha, 0, 4)
    else: x = load_val(st, ha, 0)
    idx = e_bin(.sub, VI, x, e_iconst(lo))
    table = fill(-1, span)
    loop j in 0.. and v in vals:
        if table[v - lo] < 0: table[v - lo] = arms[j]
    def_level = fail_level
    if wild >= 0: def_level = arm_level[wild]
    depths: int[]
    loop t in table:
        if t < 0: depths.push(ctl - def_level)
        else: depths.push(ctl - arm_level[t])
    e_brtable(idx, depths, ctl - def_level)
    loop a in [0..na):
        endc()
        gen_arm_body(kid(m, a), rs, rtp, val)
        br_to(end_level)
    endc()
    if val: e_call_nr1(rt("__panic"), e_daddr(str_data("no match arm matched")), -1)
    endc()
    true

gen_match = (m: int, want: bool) -> Val:
    hidden = int(nodes[m].sym)
    st = ntype(int(nodes[m].a))
    rtp = ntype(m)
    val = want and vc(rtp) != VC_VOID and rtp != T_NEVER
    rs = -1
    if val:
        rs = new_temp(rtp)
        e_zero(e_slot(rs), tsize(rtp))
    scope_push()
    wide_subject: int[]
    if exact_has_node(int(nodes[m].a)) and exact_match_literals(m): wide_subject = exact_value(int(nodes[m].a))
    if wide_subject.len() > 0: store_val(st, e_slot(int(locals[hidden].offset)), 0, wide_subject[0])
    else if held_views.contains(hidden): e_mov(int(locals[hidden].vreg), held_value_addr(int(nodes[m].a)))
    else:
        stmt_begin()
        sv = gen_owned(int(nodes[m].a))
        store_val(st, e_slot(int(locals[hidden].offset)), 0, sv.v)
        stmt_end()
        scope_add_local(hidden)
    if wide_subject.len() == 0 and gen_match_switch(m, st, rs, rtp, val):
        scope_pop()
        if val: return result_from_slot(rs, rtp)
        return V(-1, false)
    blk()
    end_level = ctl
    loop i in [0..nkids(m)):
        arm = kid(m, i)
        blk()
        fail_level = ctl
        blk()
        match_level = ctl
        loop k in [0..nkids(arm)):
            p = kid(arm, k)
            ha = local_place(hidden, false).v
            enter_cond()
            ok = if wide_subject.len() == 0: gen_match_test(p, st, ha) else if nodes[p].kind == .pwild: e_iconst(1) else: exact_compare(.eq, wide_subject, exact_value(int(nodes[p].a)))
            leave_cond()
            brif_to(ok, match_level)
        br_to(fail_level)
        endc()
        enter_cond()
        body = int(nodes[arm].b)
        if val: gen_value_block(body, rs, rtp)
        else:
            scope_push()
            gen_block_stmts(body)
            scope_pop()
        leave_cond()
        br_to(end_level)
        endc()
    if val: e_call_nr1(rt("__panic"), e_daddr(str_data("no match arm matched")), -1)
    endc()
    scope_pop()
    if val: return result_from_slot(rs, rtp)
    V(-1, false)

# ---------------- binary ----------------
gen_eq = (t: int, a: int, b: int) -> int: e_call2(lf_helper(.eq, prune(t), 0), a, b, VI)

int_op = (op: Tok, sg: bool) -> Op:
    match op:
        plus: .add
        minus: .sub
        star: .mul
        slash:
            if sg: return .divs
            .divu
        percent:
            if sg: return .rems
            .remu
        amp: .and_
        pipe: .or_
        caret: .xor
        shl: .shl
        shr:
            if sg: return .shrs
            .shru
        eq: .eq
        ne: .ne
        lt:
            if sg: return .lts
            .ltu
        le:
            if sg: return .les
            .leu
        gt:
            if sg: return .gts
            .gtu
        ge:
            if sg: return .ges
            .geu
        _: .nop

float_op = (op: Tok) -> Op:
    match op:
        plus: .fadd
        minus: .fsub
        star: .fmul
        slash: .fdiv
        eq: .feq
        ne: .fne
        lt: .flt
        le: .fle
        gt: .fgt
        ge: .fge
        _: .nop

is_slice = (x: int) -> bool: nodes[x].kind == .index and nodes[x].aux == 1

# The address of x's value, kept through later operand evaluation.
kept_operand_addr = (x: int, t: int) -> int:
    kv = own_at(x, gen_expr(x), t)
    borrow(kv, t)
    if vc(t) != VC_AGG:
        ks = new_slot(8, 8)
        e_store(e_slot(ks), 0, kv.v, 8)
        return e_slot(ks)
    kv.v

left_operand_addr = (a: int, t: int, keep: bool) -> int:
    if keep: return kept_operand_addr(a, t)
    place_addr(gen_place(a, false), t)

# A failed conversion of an `int` to a narrower width. (`int` arithmetic itself
# never fails: math_binary promotes, MIN // -1 included.)
math_int_guard = (bad: int):
    iff(bad)
    e_call_nr0(rt("__int_overflow"), -1)
    endc()

# Arrays of plain integers or bools are equal when their bytes are: the lengths, then
# __mem_eq (expanded inline) over the elements where they are. A slice, xs[i..j) =? ys,
# is a range of its source, not a new array.
byte_eq_type = (t: int) -> bool:
    if tkind(t) != .array: return false
    et = prune(int(types[t].elem))
    (types[et].kind == .int_ and et != T_MATH_INT) or types[et].kind == .bool_

gen_byte_eq = (a: int, b: int, t: int, keep_left: bool) -> int:
    # (a slice's source need be kept only if evaluating b could change it)
    keep = keep_left
    if is_slice(a): keep = not unchanged_by(text_source(int(nodes[a].a)), b)
    da, na = byte_range(a, t, keep)
    db, nb = byte_range(b, t, false)
    r = vreg(VI)
    e_mov(r, e_iconst(0))
    iff(e_bin(.eq, VI, na, nb))
    e_mov(r, e_call3(rt("__mem_eq"), da, db, e_bin(.mul, VI, na, e_iconst(owner_stride(int(types[t].elem)))), VI))
    endc()
    r

# the string a byte view of it is (`s as array<uint8>`: the same storage), or n
text_source = (n: int) -> int:
    k = nodes[n].kind
    if (k == .conv or k == .cast) and tkind(ntype(n)) == .array and tkind(ntype(int(nodes[n].a))) == .str_: return int(nodes[n].a)
    n

# where an array operand's elements start, and how many: a slice's checked range of its
# source (kept alive while later evaluation could release it)
byte_range = (x: int, t: int, keep: bool) -> (int, int):
    if not is_slice(x) or tkind(ntype(int(nodes[x].a))) != .array:
        # (a fixed array's slice is made: a new array, not a place)
        v = if keep or is_slice(x): kept_operand_addr(x, t) else: place_addr(gen_place(x, false), t)
        p = e_load(VI, v, 0, ptr_size)
        return (e_addi(p, 24), arr_len(p))
    source_node = int(nodes[x].a)
    bt = prune(ntype(source_node))
    r = int(nodes[x].b)
    plain = unchanged_by(text_source(source_node), r) or (nodes[r].a == 0 or plain_read(int(nodes[r].a))) and (nodes[r].b == 0 or plain_read(int(nodes[r].b)))
    source = gen_expr(source_node)
    if keep or not plain:
        source = own(source, bt)
        borrow(source, bt)
    p = vreg(VI)
    e_mov(p, source.v)
    lo, hi = gen_slice_bounds(x, p)
    n = arr_len(p)
    bad = e_bin(.or_, VI, e_bin(.lts, VI, lo, e_iconst(0)), e_bin(.gts, VI, hi, n))
    bad = e_bin(.or_, VI, bad, e_bin(.gts, VI, lo, hi))
    iff(bad)
    e_call_nr4(rt("__panic_slice"), e_daddr(str_data("slice")), lo, hi, n, -1)
    endc()
    (e_bin(.add, VI, e_addi(p, 24), e_bin(.mul, VI, lo, e_iconst(owner_stride(int(types[bt].elem))))), e_bin(.sub, VI, hi, lo))

# High unsigned product without allocating, including targets without mulhu.
fixed_mul_high = (a: int, b: int) -> int:
    if mulh_ok: return e_bin(.mulhu, VI, a, b)
    mask = e_iconst(4294967295)
    shift = e_iconst(32)
    al = e_bin(.and_, VI, a, mask); ah = e_bin(.shru, VI, a, shift)
    bl = e_bin(.and_, VI, b, mask); bh = e_bin(.shru, VI, b, shift)
    low = e_bin(.mul, VI, al, bl)
    cross = e_bin(.add, VI, e_bin(.mul, VI, ah, bl), e_bin(.shru, VI, low, shift))
    next = e_bin(.add, VI, e_bin(.mul, VI, al, bh), e_bin(.and_, VI, cross, mask))
    e_bin(.add, VI, e_bin(.mul, VI, ah, bh), e_bin(.add, VI, e_bin(.shru, VI, cross, shift), e_bin(.shru, VI, next, shift)))

# Saturating policy arithmetic detects word overflow before narrowing. Widening
# multiplication uses the target's high-half instruction, or its inline 32-bit decomposition.
saturate_binary = (op: Tok, t: int, a: int, b: int) -> int:
    signed = types[t].sign
    bits = int(types[t].bits)
    hi = if bits == 64: -1 else: (1 << bits) - 1
    lo = 0
    if signed:
        hi = int(u64(hi) >> 1)
        lo = -hi - 1
    value = e_bin(int_op(op, signed), VI, a, b)
    bad = e_iconst(0)
    negative = e_iconst(0)
    if signed:
        if op == .plus:
            bad = e_bin(.lts, VI, e_bin(.and_, VI, e_bin(.xor, VI, a, value), e_bin(.xor, VI, b, value)), e_iconst(0))
            negative = e_bin(.lts, VI, a, e_iconst(0))
        else if op == .minus:
            bad = e_bin(.lts, VI, e_bin(.and_, VI, e_bin(.xor, VI, a, b), e_bin(.xor, VI, a, value)), e_iconst(0))
            negative = e_bin(.lts, VI, a, e_iconst(0))
        else:
            high = if mulh_ok: e_bin(.mulhs, VI, a, b) else: fixed_mul_high(a, b)
            if not mulh_ok:
                high = e_bin(.sub, VI, high, e_bin(.and_, VI, e_bin(.shrs, VI, a, e_iconst(63)), b))
                high = e_bin(.sub, VI, high, e_bin(.and_, VI, e_bin(.shrs, VI, b, e_iconst(63)), a))
            bad = e_bin(.ne, VI, high, e_bin(.shrs, VI, value, e_iconst(63)))
            negative = e_bin(.lts, VI, e_bin(.xor, VI, a, b), e_iconst(0))
    else:
        if op == .plus: bad = e_bin(.ltu, VI, value, a)
        else if op == .minus:
            bad = e_bin(.ltu, VI, a, b)
            negative = e_iconst(1)
        else:
            high = fixed_mul_high(a, b)
            bad = e_bin(.ne, VI, high, e_iconst(0))
    out = vreg(VI)
    e_mov(out, value)
    iff(bad)
    iff(negative)
    e_mov(out, e_iconst(lo))
    els()
    e_mov(out, e_iconst(hi))
    endc()
    els()
    if signed:
        iff(e_bin(.lts, VI, value, e_iconst(lo)))
        e_mov(out, e_iconst(lo))
        endc()
    iff(e_bin((if signed: Op.gts else: Op.gtu), VI, value, e_iconst(hi)))
    e_mov(out, e_iconst(hi))
    endc()
    endc()
    out

saturate_shift = (t: int, a: int, count: int) -> int:
    signed = types[t].sign
    bits = int(types[t].bits)
    hi = if bits == 64: -1 else: (1 << bits) - 1
    lo = 0
    if signed:
        hi = int(u64(hi) >> 1)
        lo = -hi - 1
    out = vreg(VI)
    endpoint = vreg(VI)
    e_mov(endpoint, e_iconst(hi))
    if signed:
        iff(e_bin(.lts, VI, a, e_iconst(0)))
        e_mov(endpoint, e_iconst(lo))
        endc()
    e_mov(out, e_iconst(0))
    iff(e_bin(.ne, VI, a, e_iconst(0)))
    iff(e_bin(.geu, VI, count, e_iconst(64)))
    e_mov(out, endpoint)
    els()
    shifted = e_bin(.shl, VI, a, count)
    restored = e_bin((if signed: Op.shrs else: Op.shru), VI, shifted, count)
    iff(e_bin(.ne, VI, a, restored))
    e_mov(out, endpoint)
    els()
    e_mov(out, saturate_binary(.plus, t, shifted, e_iconst(0)))
    endc()
    endc()
    endc()
    out

gen_binary = (e: int) -> Val:
    a = int(nodes[e].a)
    b = int(nodes[e].b)
    lt = prune(ntype(a))
    op = nodes[e].op as Tok
    aux = int(nodes[e].aux)
    is_cmp = op == .eq or op == .ne or op == .lt or op == .le or op == .gt or op == .ge
    # Read the left value before evaluating the right. Explicit mutation of a
    # local (including an intrinsic or assignment inside a block) matters too,
    # and aggregate operations need a copy even for values without references.
    keep_left = false
    if is_managed(lt) or vc(lt) == VC_AGG:
        # Built-in string equality invokes no user code. A plain right-hand
        # read cannot invalidate the left value, even through an indexed place.
        plain_string = aux == 2 and (op == .eq or op == .ne) and plain_read(b)
        plain_resource = aux == 1 and ownership_type(lt) and plain_read(b)
        if not plain_string and not plain_resource and place_var(a) != 0: keep_left = not unchanged_by(a, b)
    if aux == 1 and byte_eq_type(lt):
        r = gen_byte_eq(a, b, lt, keep_left)
        if op == .ne: r = e_bin(.xor, VI, r, e_iconst(1))
        return V(r, false)
    if aux == 1:
        ad = 0
        # (a slice, xs[a..b) == ys: a new array, not a place to take the address of)
        if keep_left or is_slice(a): ad = kept_operand_addr(a, lt)
        else: ad = place_addr(gen_place(a, false), lt)
        bd = 0
        if is_slice(b): bd = kept_operand_addr(b, lt)
        else: bd = place_addr(gen_place(b, false), lt)
        r = gen_eq(lt, ad, bd)
        if op == .ne: r = e_bin(.xor, VI, r, e_iconst(1))
        return V(r, false)
    if aux == 6:
        if nodes[e].aux2 != 0:
            has = gen_map_presence(a, int(nodes[e].aux2))
            if op == .eq: return V(e_bin(.eq, VI, has, e_iconst(0)), false)
            return V(has, false)
        pa = gen_place(a, false)
        has = opt_has(place_addr(pa, lt), int(types[lt].elem))
        if op == .eq: return V(e_bin(.eq, VI, has, e_iconst(0)), false)
        return V(e_bin(.ne, VI, has, e_iconst(0)), false)
    if aux == 2:
        va = gen_left(a, lt, keep_left)
        vb = gen_borrowed(b).v
        if op == .plus: return V(e_call2(rt("__str_concat"), va, vb, VI), true)
        if op == .eq or op == .ne:
            r = e_call2(rt("__str_eq"), va, vb, VI)
            if op == .ne: r = e_bin(.xor, VI, r, e_iconst(1))
            return V(r, false)
        c = e_call2(rt("__str_cmp"), va, vb, VI)
        return V(e_bin(int_op(op, true), VI, c, e_iconst(0)), false)
    if aux == 3:
        va = gen_left(a, lt, keep_left)
        vb = gen_borrowed(b).v
        et = int(types[lt].elem)
        if ownership_type(et) and not ownership_copyable(et): fatal(nodes[e].pos, "cannot concatenate move-only owners; transfer with extend")
        r = e_call3(rt("__arr_concat"), va, vb, e_iconst(owner_stride(et)), VI)
        if is_managed(et): retain_elems(r, et)
        return V(r, true)
    if aux == 4:
        p = freeze_scalar(gen_expr(a).v, lt)
        i = gen_expr(b).v
        d = e_bin(.mul, VI, i, e_iconst(tsize(int(types[lt].elem))))
        if op == .plus: return V(e_bin(.add, VI, p, d), false)
        return V(e_bin(.sub, VI, p, d), false)
    if aux == 5:
        pa = freeze_scalar(gen_expr(a).v, lt)
        pb = gen_expr(b).v
        d = e_bin(.sub, VI, pa, pb)
        sz = tsize(int(types[lt].elem))
        if sz > 1: d = e_bin(.divs, VI, d, e_iconst(sz))
        return V(d, false)
    if lt == T_MATH_INT:
        if is_cmp and math_proven_word(a) and math_proven_word(b):
            return V(e_bin(int_op(op, true), VI, math_word_expr(a), math_word_expr(b)), false)
        if is_cmp:
            r = math_sum_compare(e)
            if r >= 0: return V(r, false)
        if not is_cmp and math_proven_word(e): return math_pack_word(e, math_word_expr(e))
        va = gen_left(a, lt, keep_left)
        if op == .shl or op == .shr: return math_shift(op, va, math_shift_count(b), types[prune(ntype(b))].sign)
        vb = gen_borrowed(b).v
        if is_cmp: return V(math_compare(op, va, vb), false)
        return math_binary(op, va, vb)
    if aux >= 7: return gen_vec_binary(e, keep_left)
    if vc(lt) == VC_FLT:
        ty = vt_of(lt)
        va = freeze_scalar(gen_expr(a).v, lt)
        vb = gen_expr(b).v
        if op == .percent:
            q = e_un(.ftrunc, ty, e_bin(.fdiv, ty, va, vb))
            return V(e_bin(.fsub, ty, va, e_bin(.fmul, ty, q, vb)), false)
        return V(e_bin(float_op(op), ty, va, vb), false)
    # x % 2^k == 0 (or !=): a test of the low bits, for any sign of x
    if (op == .eq or op == .ne) and nodes[b].kind == .int_lit and nodes[b].ival == 0 and nodes[a].kind == .binary and (nodes[a].op as Tok) == .percent and nodes[a].aux == 0:
        m = int(nodes[a].b)
        if nodes[m].kind == .int_lit and nodes[m].ival > 0 and nodes[m].ival & (nodes[m].ival - 1) == 0 and vc(ntype(int(nodes[a].a))) == VC_INT:
            low = e_bin(.and_, VI, gen_expr(int(nodes[a].a)).v, e_iconst(nodes[m].ival - 1))
            return V(e_bin(int_op(op, false), VI, low, e_iconst(0)), false)
    va = freeze_scalar(gen_expr(a).v, lt)
    if op == .shr and int_policy(lt) == 1 and not types[lt].sign and types[lt].bits == 32: va = e_un(.zext32, VI, va)
    vb = if op == .shl or op == .shr: math_shift_count(b) else: gen_expr(b).v
    sg = (types[lt].kind == .int_ and types[lt].sign)
    if int_policy(ntype(e)) == 2 and op == .shl: return V(saturate_shift(ntype(e), va, vb), false)
    if int_policy(ntype(e)) == 2 and (op == .plus or op == .minus or op == .star): return V(saturate_binary(op, ntype(e), va, vb), false)
    if op == .slash or op == .percent:
        iff(e_bin(.eq, VI, vb, e_iconst(0)))
        e_call_nr1(rt("__div_zero"), e_daddr(loc_data(nodes[e].pos)), -1)
        endc()
    if nodes[e].aux2 == -1 and (op == .slash or op == .percent):
        if not sg: return V(e_bin(int_op(op, false), VI, va, vb), false)
        # Floor remainder by a positive power of two is its low bits, for
        # negative inputs too. Floor division is the matching arithmetic shift.
        known, divisor = integer_constant(b)
        if known and divisor > 0 and divisor & (divisor - 1) == 0:
            if op == .percent: return V(e_bin(.and_, VI, va, e_iconst(divisor - 1)), false)
            shift = 0
            loop divisor > 1:
                divisor = divisor >> 1
                shift += 1
            return V(e_bin(.shrs, VI, va, e_iconst(shift)), false)
        # Reuse the lowering range already computed for every write. A
        # nonnegative dividend needs neither signed correction nor MIN/-1.
        if known and divisor > 0 and positive_bound(a, true) >= 0:
            return V(e_bin(int_op(op, false), VI, va, vb), false)
        result = vreg(VI)
        iff(e_bin(.eq, VI, vb, e_iconst(-1)))
        if op == .percent: e_mov(result, e_iconst(0))
        else if int_policy(lt) == 2: e_mov(result, saturate_binary(.minus, lt, e_iconst(0), va))
        else: e_mov(result, e_un(.neg, VI, va))
        els()
        quotient = e_bin(.divs, VI, va, vb)
        remainder = e_bin(.rems, VI, va, vb)
        e_mov(result, if op == .slash: quotient else: remainder)
        iff(e_bin(.ne, VI, remainder, e_iconst(0)))
        iff(e_bin(.lts, VI, e_bin(.xor, VI, remainder, vb), e_iconst(0)))
        e_mov(result, if op == .slash: e_addi(quotient, -1) else: e_bin(.add, VI, remainder, vb))
        endc()
        endc()
        endc()
        return V(result, false)
    if types[lt].kind == .bool_ and (op == .amp or op == .pipe or op == .caret):
        return V(e_bin(int_op(op, false), VI, va, vb), false)
    if sg and (op == .slash or op == .percent) and not (nodes[b].kind == .int_lit and nodes[b].ival != -1):
        return V(sdiv_wrap(op, va, vb, lt), false)
    if (op == .shl or op == .shr) and dewy_at(nodes[e].pos): return V(wide_shift(op, sg, va, vb, b), false)
    r = e_bin(int_op(op, sg), VI, va, vb)
    if is_cmp: return V(r, false)
    V(r, false)

# A Dewy shift count is unsigned, and a count of at least the register width
# reaches the shift's continuation bits: 0, or the sign for a signed right
# shift. Narrower types are already 0 or sign-filled past their width once
# normalized. The machine masks the count, so a count not known to be below
# 64 pays for a branch-free mask shared by shifts of the same count: all ones
# within range, else zero. A left or unsigned right shift is ANDed with it; a
# signed right shift sets the count's low bits, making the machine shift by 63.
wide_shift = (op: Tok, sg: bool, va: int, vb: int, count: int) -> int:
    k = shift_count_bound(count)
    if k >= 64:
        if op == .shr and sg: return e_bin(.shrs, VI, va, e_iconst(63))
        return e_iconst(0)
    if k >= 0: return e_bin(int_op(op, sg), VI, va, vb)
    # ((count >> 6) - 1) >> 63: all ones exactly when count < 64, unsigned
    within = e_bin(.shrs, VI, e_addi(e_bin(.shru, VI, vb, e_iconst(6)), -1), e_iconst(63))
    if op == .shr and sg:
        beyond = e_bin(.and_, VI, e_un(.not_, VI, within), e_iconst(63))
        return e_bin(.shrs, VI, va, e_bin(.or_, VI, vb, beyond))
    e_bin(.and_, VI, e_bin(int_op(op, sg), VI, va, vb), within)

# An unsigned bound on a shift count from its syntax: the literal itself (64
# for any count of at least 64, or a negative one), or the mask of
# `count & mask`; -1 when unknown.
shift_count_bound = (n: int) -> int:
    let n = n
    loop nodes[n].kind == .conv: n = int(nodes[n].a)
    k = nodes[n].kind
    if k == .int_lit: return if nodes[n].ival < 0: 64 else: min(nodes[n].ival, 64)
    if k == .binary and (nodes[n].op as Tok) == .amp:
        a = shift_count_bound(int(nodes[n].a))
        b = shift_count_bound(int(nodes[n].b))
        if nodes[int(nodes[n].b)].kind == .int_lit and b >= 0 and b < 64: return b
        if nodes[int(nodes[n].a)].kind == .int_lit and a >= 0 and a < 64: return a
    -1

# signed / and % of 64-bit integers wrap like other arithmetic: the smallest integer / -1 is
# itself and % -1 is 0 (the machine's division would trap on the quotient)
sdiv_wrap = (op: Tok, va: int, vb: int, t: int) -> int:
    if tsize(t) < 8: return e_bin(int_op(op, true), VI, va, vb)
    d = vreg(VI)
    iff(e_bin(.eq, VI, vb, e_iconst(-1)))
    if op == .slash: e_mov(d, e_un(.neg, VI, va))
    else: e_mov(d, e_iconst(0))
    els()
    e_mov(d, e_bin(int_op(op, true), VI, va, vb))
    endc()
    d

gen_left = (a: int, t: int, keep: bool) -> int:
    v = gen_expr(a)
    if keep:
        v = own_at(a, v, t)
        if vc(t) != VC_AGG:
            # Retaining the object does not freeze a local's mutable register.
            v.v = freeze_scalar(v.v, t)
    borrow(v, t)
    v.v

# the offsets of the Textures in a value of type t (at offset base), into out
texture_offsets = (t0: int, base: int, out: mut int[]):
    t = prune(t0)
    k = types[t].kind
    if k == .fixed:
        et = int(types[t].elem)
        loop i in [0..fixed_len(t)): texture_offsets(et, base + i * tsize(et), out)
    else if k == .struct_ and not is_union(t):
        si = int(types[t].st)
        if is_lib_texture(si):
            out.push(base)
            return
        loop fo in field_list(t): texture_offsets(fo.0, base + fo.1, out)

# does expression n call a function (directly, or formatting a part of a string)?
has_call = (n: int) -> bool:
    if n <= 0: return false
    k = nodes[n].kind
    if k == .call or (k == .pair and nodes[n].sym > 0): return true
    if k == .lambda: return false
    child_a = int(nodes[n].a)
    child_b = int(nodes[n].b)
    child_c = int(nodes[n].c)
    child_d = int(nodes[n].d)
    more_children = k != .for_
    if has_call(child_a): return true
    if has_call(child_b): return true
    if more_children:
        if has_call(child_c): return true
        if has_call(child_d): return true
    loop i in [0..nkids(n)):
        if has_call(kid(n, i)): return true
    loop i in [0..nkids2(n)):
        if has_call(kid2(n, i)): return true
    false

# can evaluating n change what an assignment's destination indices read: a call, an assignment
# or a statement inside it, or an operation that resizes or formats through user code?
assign_rhs_effects = (n: int) -> bool:
    if n <= 0: return false
    k = nodes[n].kind
    if k == .call or (k == .pair and nodes[n].sym > 0) or k == .assign or k == .block or k == .for_ or k == .while_: return true
    if k == .lambda: return false
    if k == .intrinsic:
        id = nodes[n].aux as IN
        if id == .fmt_struct or id == .json_fields or id == .push or id == .pop or id == .insert or id == .remove or id == .clear or id == .reserve or id == .resize or id == .truncate or id == .extend: return true
    if assign_rhs_effects(int(nodes[n].a)) or assign_rhs_effects(int(nodes[n].b)): return true
    if assign_rhs_effects(int(nodes[n].c)) or assign_rhs_effects(int(nodes[n].d)): return true
    loop i in [0..nkids(n)):
        if assign_rhs_effects(kid(n, i)): return true
    loop i in [0..nkids2(n)):
        if assign_rhs_effects(kid2(n, i)): return true
    false

# does index n read the same before and after rhs runs, with nothing of its own to run or trap:
# literals and plain locals rhs does not write, under arithmetic with no storage check?
# Checked exact stores are conversion nodes and must be captured. O(nodes of n x nodes of rhs)
index_stable = (n: int, rhs: int) -> bool:
    k = nodes[n].kind
    if k == .int_lit: return true
    if k == .ident: return nodes[n].aux == i32(int(SK.local)) and mut_plain_root(n) and not may_write_root(rhs, n)
    if k != .binary or not is_int(ntype(n)) or prune(ntype(n)) == T_MATH_INT or int_policy(ntype(n)) != 0: return false
    op = nodes[n].op as Tok
    if op != .plus and op != .minus and op != .star and op != .amp and op != .pipe and op != .caret and op != .kw_xor: return false
    index_stable(int(nodes[n].a), rhs) and index_stable(int(nodes[n].b), rhs)

retain_elems = (arr: int, et: int):
    # retain every element of a freshly copied array
    n = arr_len(arr)
    i = vreg(VI)
    e_mov(i, e_iconst(0))
    blk()
    lop()
    brif_to(e_bin(.ges, VI, i, n), ctl - 1)
    ea = e_bin(.add, VI, e_addi(arr, 24), e_bin(.mul, VI, i, e_iconst(owner_stride(et))))
    if ownership_type(et): iff(e_load(VI, ea, tsize(et), 1))
    copy_at(ea, et)
    if ownership_type(et): endc()
    e_mov(i, e_addi(i, 1))
    br_to(ctl)
    endc()
    endc()

# ---------------- vectors ----------------
vec_comps = (t: int) -> int:
    if prune(t) == T_MAT4: return 16
    int(types[prune(t)].bits)

gen_vec_binary = (e: int, keep_left: bool) -> Val:
    a = int(nodes[e].a)
    b = int(nodes[e].b)
    op = nodes[e].op as Tok
    aux = int(nodes[e].aux)
    t = ntype(e)
    s = new_temp(t)
    d = e_slot(s)
    if aux == 7:
        pa = left_operand_addr(a, T_MAT4, keep_left)
        pb = place_addr(gen_place(b, false), T_MAT4)
        e_call3(rt("__mat4_mul"), d, pa, pb, -1)
        return Val(d, true, s)
    if aux == 8:
        pa = left_operand_addr(a, T_MAT4, keep_left)
        pb = place_addr(gen_place(b, false), T_VEC4)
        e_call3(rt("__mat4_mul_vec4"), d, pa, pb, -1)
        return Val(d, true, s)
    integer = types[prune(t)].sign
    ty = VS
    mode = 4 | M_FLOAT
    if integer:
        ty = VI
        mode = 4 | M_SIGNED
    n = vec_comps(t)
    fop = float_op(op)
    if integer: fop = int_op(op, true)
    # + - * / of float vectors: packed SSE arithmetic
    vk = -1
    if op == .plus: vk = 0
    else if op == .minus: vk = 1
    else if op == .star: vk = 2
    else if op == .slash: vk = 3
    if not integer and vk >= 0 and n >= 2 and n <= 4:
        if aux == 9:
            pa = left_operand_addr(a, t, keep_left)
            pb = place_addr(gen_place(b, false), t)
            e_vop(d, pa, pb, vk, n, 0)
        else if aux == 10:
            pa = left_operand_addr(a, t, keep_left)
            y = gen_expr(b).v
            e_vop(d, pa, y, vk, n, VOP_SPLAT_C)
        else:
            x = freeze_scalar(gen_expr(a).v, ntype(a))
            pb = place_addr(gen_place(b, false), t)
            e_vop(d, x, pb, vk, n, VOP_SPLAT_B)
        return Val(d, true, s)
    if aux == 9:
        pa = left_operand_addr(a, t, keep_left)
        pb = place_addr(gen_place(b, false), t)
        loop i in [0..n):
            x = e_load(ty, pa, 4 * i, mode)
            y = e_load(ty, pb, 4 * i, mode)
            r = e_bin(fop, ty, x, y)
            if integer: r = e_un(.sext32, VI, r)
            e_store(d, 4 * i, r, mode)
        return Val(d, true, s)
    if aux == 10:
        pa = left_operand_addr(a, t, keep_left)
        y = gen_expr(b).v
        loop i in [0..n):
            x = e_load(ty, pa, 4 * i, mode)
            r = e_bin(fop, ty, x, y)
            if integer: r = e_un(.sext32, VI, r)
            e_store(d, 4 * i, r, mode)
        return Val(d, true, s)
    x = freeze_scalar(gen_expr(a).v, ntype(a))
    pb = place_addr(gen_place(b, false), t)
    loop i in [0..n):
        y = e_load(ty, pb, 4 * i, mode)
        r = e_bin(fop, ty, x, y)
        if integer: r = e_un(.sext32, VI, r)
        e_store(d, 4 * i, r, mode)
    Val(d, true, s)

gen_vec_ctor = (e: int) -> Val:
    t = ntype(e)
    s = new_temp(t)
    d = e_slot(s)
    n = vec_comps(t)
    integer = types[prune(t)].sign
    mode = 4 | M_FLOAT
    if integer: mode = 4 | M_SIGNED
    if nkids(e) == 0:
        e_zero(d, tsize(t))
        if t == T_MAT4:
            one = e_fconst(1.0, VS)
            loop i in [0..4): e_store(d, 4 * (i * 5), one, mode)
        return Val(d, true, s)
    if nkids(e) == 1 and vc(ntype(kid(e, 0))) != VC_AGG:
        v = gen_expr(kid(e, 0)).v
        if t == T_MAT4:
            e_zero(d, 64)
            loop i in [0..4): e_store(d, 4 * (i * 5), v, mode)
        else:
            loop i in [0..n): e_store(d, 4 * i, v, mode)
        return Val(d, true, s)
    k = 0
    loop i in [0..nkids(e)):
        a = kid(e, i)
        at = ntype(a)
        if vc(at) == VC_AGG:
            pa = gen_expr(a).v
            # (from a vector of the other kind: each component converted, as a scalar would be)
            from_int = types[prune(at)].sign
            loop j in [0..vec_comps(at)):
                x = 0
                if from_int: x = e_load(VI, pa, 4 * j, 4 | M_SIGNED)
                else: x = e_load(VS, pa, 4 * j, 4 | M_FLOAT)
                if from_int and not integer: x = e_un(.i2f, VS, x)
                else if integer and not from_int: x = f2i_i32(x)
                e_store(d, 4 * k, x, mode)
                k += 1
        else:
            e_store(d, 4 * k, gen_expr(a).v, mode)
            k += 1
    Val(d, true, s)

# f32 x as an i32: toward zero, saturating, NaN to 0
f2i_i32 = (x: int) -> int:
    d = vreg(VI)
    emit(.f2i, VS, d, x, 0, 0, 0)
    iff(e_bin(.lts, VI, d, e_iconst(-2147483647 - 1)))
    e_mov(d, e_iconst(-2147483647 - 1))
    endc()
    iff(e_bin(.gts, VI, d, e_iconst(2147483647)))
    e_mov(d, e_iconst(2147483647))
    endc()
    d

gen_swizzle = (e: int) -> Val:
    a = int(nodes[e].a)
    bt = ntype(a)
    nm = name_of(int(nodes[e].name))
    integer = types[prune(bt)].sign
    ty = VS
    mode = 4 | M_FLOAT
    if integer:
        ty = VI
        mode = 4 | M_SIGNED
    pa = place_addr(gen_place(a, false), bt)
    if len(nm) == 1: return V(e_load(ty, pa, 4 * swizzle_index(nm[0]), mode), false)
    t = ntype(e)
    s = new_temp(t)
    d = e_slot(s)
    loop i in [0..len(nm)): e_store(d, 4 * i, e_load(ty, pa, 4 * swizzle_index(nm[i]), mode), mode)
    Val(d, true, s)

data_writable = (e: int) -> bool:
    k = nodes[e].kind
    if k == .field or k == .index or k == .unwrap or k == .narrow:
        # A field/element of owned storage needs the same detachment as a named
        # array. Slices are temporary values, not writable storage paths.
        if k == .index and nodes[e].aux == 1: return false
        return data_writable(int(nodes[e].a))
    if k != .ident: return false
    if nodes[e].aux == i32(int(SK.global)): return true
    if nodes[e].aux != i32(int(SK.local)): return false
    l = int(nodes[e].sym)
    f = int(locals[l].flags)
    if f & LF_ALIAS != 0: return locals[l].alias != 0 and data_writable(int(locals[l].alias))
    if f & LF_BYREF != 0: return false
    if f & LF_CAPTURE != 0: return f & LF_VALUECAP != 0 or is_shared(l)
    f & LF_PARAM == 0 or f & LF_MUTPARAM != 0

# ---------------- intrinsics ----------------
struct LoanCapacity:
    place: PlaceIdentity
    limit: int
loan_capacities: LoanCapacity[]

# O(1) intrinsic dispatch and indexed operand reads. Each handler performs
# only its own lowering and helper work; list offsets survive AST/list growth.
gen_intrinsic = (e: int) -> Val:
    if (effects_active or effect_policy.prohibitions != 0) and e != fixed_fill_push: effect_lower_intrinsic(cur_fn, e)
    id = nodes[e].aux as IN
    arg_start = int(nodes[e].list)
    arg_count = nkids(e)
    if partition_mode and id == .len and arg_count == 1:
        desc = partition_descriptor(int(lists[arg_start]))
        if desc >= 0: return V(partition_lengths[int(nodes[int(lists[arg_start])].sym)], false)
    match id:
        lend: return gen_intrinsic_lend(e, arg_start)
        loan_address: return gen_intrinsic_loan_address(e, arg_start)
        loan_load: return gen_intrinsic_loan_load(e, arg_start)
        loan_store: return gen_intrinsic_loan_store(e, arg_start)
        loan_length: return gen_intrinsic_loan_length(e, arg_start)
        len, arrcap: return gen_intrinsic_len(e, arg_start)
        take_slot: return gen_intrinsic_take_slot(e, arg_start)
        relocate: return gen_intrinsic_relocate(e, arg_start)
        push: return gen_intrinsic_push(e, arg_start)
        pop: return gen_intrinsic_pop(e, arg_start)
        insert: return gen_intrinsic_insert(e, arg_start)
        remove: return gen_intrinsic_remove(e, arg_start)
        clear: return gen_intrinsic_clear(e, arg_start)
        extend: return gen_intrinsic_extend(e, arg_start)
        reserve: return gen_intrinsic_reserve(e, arg_start)
        resize, truncate, setlen: return gen_intrinsic_resize(e, arg_start)
        arrdata, task_data: return gen_intrinsic_arrdata(e, arg_start)
        syscall: return gen_intrinsic_syscall(e, arg_start, arg_count)
        callc: return gen_intrinsic_callc(e, arg_start, arg_count)
        memcpy: return gen_intrinsic_memcpy(e, arg_start)
        zeroed: return gen_intrinsic_zeroed(e, arg_start)
        memset: return gen_intrinsic_memset(e, arg_start)
        panic: return gen_intrinsic_panic(e, arg_start, arg_count)
        unreachable: return gen_intrinsic_unreachable(e, arg_start)
        static_assert: return V(-1, false)
        assert, runtime_assert: return gen_intrinsic_assert(e, arg_start, arg_count)
        embed: return gen_intrinsic_embed(e, arg_start)
        to_bytes: return gen_intrinsic_to_bytes(e, arg_start)
        argv: return gen_intrinsic_argv(e, arg_start)
        setjmp, longjmp, jump, clone_thread, atomic_add, atomic_cas, stack_ptr, cpu_features, code_sync: return gen_intrinsic_setjmp(e, arg_start, arg_count)
        sqrt: return gen_intrinsic_sqrt(e, arg_start)
        mul_hi: return gen_intrinsic_mul_hi(e, arg_start)
        hash: return gen_intrinsic_hash(e, arg_start)
        fmt_struct: return gen_fmt_struct(e)
        json_fields: return gen_json_fields(e)
        gpu_kernel: return gen_intrinsic_gpu_kernel(e, arg_start)
        compute_spirv: return gen_intrinsic_compute_spirv(e, arg_start)
        compute_textures: return gen_intrinsic_compute_textures(e, arg_start)
        shader: return gen_intrinsic_shader(e, arg_start)
        vec_ctor: return gen_vec_ctor(e)
        _: fatal(nodes[e].pos, "intrinsic not supported in codegen")
    V(-1, false)

gen_intrinsic_lend = (e: int, arg_start: int) -> Val:
    arg0 = int(lists[arg_start])
    arg1 = int(lists[arg_start + 1])
    arg2 = int(lists[arg_start + 2])
    extra = gen_expr(arg1).v
    pl = gen_place(arg0, has_flag(e, NF_MUT))
    at = ntype(arg0)
    length = arr_len(read_place(pl, at))
    limit = e_bin(.add, VI, length, extra)
    iff(e_bin(.or_, VI, e_bin(.lts, VI, extra, e_iconst(0)), e_bin(.lts, VI, limit, length)))
    e_call_nr1(rt("__panic"), e_daddr(str_data("invalid scoped loan reservation")), -1)
    endc()
    if has_flag(e, NF_MUT):
        arr_unique(pl, at)
        sa = place_addr(pl, at)
        e_call3(rt("__arr_reserve"), sa, e_iconst(1), limit, -1)
        if not pl.mem: e_mov(pl.v, e_load(VI, sa, 0, ptr_size))
    loan_capacities.push(LoanCapacity(place_route(arg0), limit))
    result = gen_expr(arg2)
    loan_capacities.pop()
    return result

gen_intrinsic_loan_address = (e: int, arg_start: int) -> Val:
    arg0 = int(lists[arg_start])
    p = gen_borrowed(arg0).v
    r = vreg(VI)
    e_mov(r, e_iconst(0))
    iff(e_bin(.ne, VI, p, e_iconst(0)))
    e_mov(r, e_addi(p, 24))
    endc()
    return V(r, false)

gen_intrinsic_loan_load = (e: int, arg_start: int) -> Val:
    arg0 = int(lists[arg_start])
    return V(e_load(VI, gen_expr(arg0).v, 0, 1), false)

gen_intrinsic_loan_store = (e: int, arg_start: int) -> Val:
    arg0 = int(lists[arg_start])
    arg1 = int(lists[arg_start + 1])
    value = gen_expr(arg0).v
    address = gen_expr(arg1).v
    e_store(address, 0, value, 1)
    return V(-1, false)

gen_intrinsic_loan_length = (e: int, arg_start: int) -> Val:
    arg0 = int(lists[arg_start])
    arg1 = int(lists[arg_start + 1])
    length = gen_expr(arg1).v
    p = place_route(arg0)
    loop loan in loan_capacities:
        if loan.place == p:
            iff(e_bin(.or_, VI, e_bin(.lts, VI, length, e_iconst(0)), e_bin(.gts, VI, length, loan.limit)))
            e_call_nr1(rt("__panic"), e_daddr(str_data("scoped loan length exceeds reservation")), -1)
            endc()
    address = gen_borrowed(arg0).v
    iff(e_bin(.ne, VI, address, e_iconst(0)))
    hdr_store(address, 8, length)
    endc()
    return V(-1, false)

gen_intrinsic_len = (e: int, arg_start: int) -> Val:
    arg0 = int(lists[arg_start])
    id = nodes[e].aux as IN
    at = prune(ntype(arg0))
    if id == .len and types[at].kind == .fixed:
        gen_borrowed(arg0)
        return V(e_iconst(fixed_len(at)), false)
    if id == .len:
        fixed = fixed_path_of(arg0)
        if fixed >= 0: return V(fixed_paths[fixed].len, false)
    p = gen_borrowed(arg0).v
    r = vreg(VI)
    e_mov(r, e_iconst(0))
    iff(e_bin(.ne, VI, p, e_iconst(0)))
    off = 8
    if id == .arrcap: off = 16
    e_mov(r, e_load(VI, p, off, 8))
    endc()
    return V(r, false)

gen_intrinsic_take_slot = (e: int, arg_start: int) -> Val:
    arg0 = int(lists[arg_start])
    arg1 = int(lists[arg_start + 1])
    at = ntype(arg0)
    et = telem(at)
    index = gen_expr(arg1).v
    pl = gen_place(arg0, true)
    arr_unique(pl, at)
    p = read_place(pl, at)
    bounds_check(p, index, nodes[e].pos)
    ea = e_bin(.add, VI, e_addi(p, 24), e_bin(.mul, VI, index, e_iconst(owner_stride(et))))
    slot = new_temp(et)
    store_val(et, e_slot(slot), 0, load_val(et, ea, 0))
    e_zero(ea, owner_stride(et))
    return result_from_slot(slot, et)

gen_intrinsic_relocate = (e: int, arg_start: int) -> Val:
    arg0 = int(lists[arg_start])
    arg1 = int(lists[arg_start + 1])
    arg2 = int(lists[arg_start + 2])
    at = ntype(arg0)
    et = telem(at)
    dst = gen_expr(arg1).v
    src = gen_expr(arg2).v
    pl = gen_place(arg0, true)
    arr_unique(pl, at)
    p = read_place(pl, at)
    da = e_bin(.add, VI, e_addi(p, 24), e_bin(.mul, VI, dst, e_iconst(owner_stride(et))))
    sa = e_bin(.add, VI, e_addi(p, 24), e_bin(.mul, VI, src, e_iconst(owner_stride(et))))
    iff(e_bin(.ne, VI, dst, src))
    owner_element_drop(da, et)
    e_copy(da, sa, owner_stride(et))
    e_zero(sa, owner_stride(et))
    endc()
    return V(-1, false)

gen_intrinsic_push = (e: int, arg_start: int) -> Val:
    arg0 = int(lists[arg_start])
    arg1 = int(lists[arg_start + 1])
    if fixed_fill_push == e:
        # (a fixed comprehension's element goes straight to its next slot)
        et = int(types[representation_type(fixed_fill_type)].elem)
        val = gen_owned(arg1)
        if not fixed_fill_exact:
            iff(e_bin(.ges, VI, fixed_fill_count, e_iconst(fixed_len(representation_type(fixed_fill_type)))))
            e_call_nr1(rt("__panic"), e_daddr(str_data("fixed-size array needs {fixed_len(representation_type(fixed_fill_type))} elements")), -1)
            endc()
        store_val(et, e_bin(.add, VI, e_slot(fixed_fill_slot), e_bin(.mul, VI, fixed_fill_count, e_iconst(tsize(et)))), 0, val.v)
        e_mov(fixed_fill_count, e_addi(fixed_fill_count, 1))
        return V(-1, false)
    at = prune(ntype(arg0))
    et = int(types[at].elem)
    esz = owner_stride(et)
    # xs.push(S(...)) with side-effect-free fields: build the element in place
    in_place = not ownership_type(et) and is_plain_ctor(arg1)
    val = V(-1, false)
    if not in_place: val = gen_owned(arg1)
    pl = gen_place(arg0, true)
    p = read_place(pl, at)
    slotp = vreg(VI)
    if has_flag(e, NF_INBOUNDS):
        # (generated code that reserved room in an array of its own: no checks)
        n0 = 0
        if has_flag(e, NF_COMPREHENSION):
            n0 = read_place(local_place(int(nodes[e].d), false), T_INT)
        else:
            n0 = hdr_load(p, 8)
            hdr_store(p, 8, e_addi(n0, 1))
        e_mov(slotp, e_bin(.add, VI, e_addi(p, 24), e_bin(.mul, VI, n0, e_iconst(esz))))
    else:
        # fast path: a unique array with spare capacity; anything else branches to the slow path
        blk()
        done = ctl
        blk()
        slow = ctl
        brif_to(e_bin(.eq, VI, p, e_iconst(0)), slow)
        brif_to(e_bin(.ne, VI, hdr_load(p, 0), e_iconst(1)), slow)
        n = hdr_load(p, 8)
        brif_to(e_bin(.ges, VI, n, hdr_load(p, 16)), slow)
        hdr_store(p, 8, e_addi(n, 1))
        e_mov(slotp, e_bin(.add, VI, e_addi(p, 24), e_bin(.mul, VI, n, e_iconst(esz))))
        br_to(done)
        endc()
        # slow path: copy if shared, then grow
        was = ir_cold
        ir_cold = true
        write_place(pl, at, e_call1(lf_helper(.arruniq, at, 0), read_place(pl, at), VI))
        sa = place_addr(pl, at)
        e_mov(slotp, e_call2(rt("__arr_push_slot"), sa, e_iconst(esz), VI))
        ir_cold = was
        if not pl.mem: e_mov(pl.v, e_load(VI, sa, 0, ptr_size))
        endc()
    if in_place:
        ce = arg1
        t = prune(ntype(ce))
        si = int(types[t].st)
        layout(t)
        e_zero(slotp, tsize(t))
        loop i in [0..int(structs[si].nfields)):
            a = kid(ce, i)
            if a == 0: continue
            f = int(structs[si].fields) + i
            fv = gen_owned(a)
            store_field(f, slotp, fv.v)
        return V(-1, false)
    store_val(et, slotp, 0, val.v)
    owner_element_live(slotp, et)
    if ownership_type(et): owner_forget_slot(val.slot)
    return V(-1, false)

gen_intrinsic_pop = (e: int, arg_start: int) -> Val:
    arg0 = int(lists[arg_start])
    at = prune(ntype(arg0))
    et = int(types[at].elem)
    pl = gen_place(arg0, true)
    arr_unique(pl, at)
    p = read_place(pl, at)
    n = arr_len(p)
    iff(e_bin(.eq, VI, n, e_iconst(0)))
    e_call_nr1(rt("__panic"), e_daddr(str_data("pop() from an empty array")), -1)
    endc()
    nn = e_bin(.sub, VI, n, e_iconst(1))
    hdr_store(p, 8, nn)
    sz = owner_stride(et)
    ea = e_bin(.add, VI, e_addi(p, 24), e_bin(.mul, VI, nn, e_iconst(sz)))
    if vc(et) == VC_AGG:
        s = new_temp(et)
        d = e_slot(s)
        e_copy(d, ea, tsize(et))
        e_zero(ea, sz)
        return Val(d, true, s)
    v = load_val(et, ea, 0)
    e_zero(ea, sz)
    return V(v, true)

gen_intrinsic_insert = (e: int, arg_start: int) -> Val:
    arg0 = int(lists[arg_start])
    arg1 = int(lists[arg_start + 1])
    arg2 = int(lists[arg_start + 2])
    at = prune(ntype(arg0))
    et = int(types[at].elem)
    val = gen_owned(arg2)
    idx = gen_expr(arg1).v
    pl = gen_place(arg0, true)
    arr_unique(pl, at)
    sa = place_addr(pl, at)
    slotp = e_call3(rt("__arr_insert_slot"), sa, e_iconst(owner_stride(et)), idx, VI)
    if not pl.mem: e_mov(pl.v, e_load(VI, sa, 0, ptr_size))
    store_val(et, slotp, 0, val.v)
    owner_element_live(slotp, et)
    if ownership_type(et): owner_forget_slot(val.slot)
    return V(-1, false)

gen_intrinsic_remove = (e: int, arg_start: int) -> Val:
    arg0 = int(lists[arg_start])
    arg1 = int(lists[arg_start + 1])
    at = prune(ntype(arg0))
    et = int(types[at].elem)
    sz = owner_stride(et)
    idx = gen_expr(arg1).v
    pl = gen_place(arg0, true)
    arr_unique(pl, at)
    p = read_place(pl, at)
    bounds_check(p, idx, nodes[e].pos)
    ea = e_bin(.add, VI, e_addi(p, 24), e_bin(.mul, VI, idx, e_iconst(sz)))
    s = new_temp(et)
    d = e_slot(s)
    e_copy(d, ea, tsize(et))
    sa = place_addr(pl, at)
    e_call3(rt("__arr_remove_slot"), sa, e_iconst(sz), idx, -1)
    if vc(et) == VC_AGG: return Val(d, true, s)
    return V(load_val(et, d, 0), true)

gen_intrinsic_clear = (e: int, arg_start: int) -> Val:
    arg0 = int(lists[arg_start])
    at = prune(ntype(arg0))
    et = int(types[at].elem)
    pl = gen_place(arg0, true)
    p = read_place(pl, at)
    iff(e_bin(.ne, VI, p, e_iconst(0)))
    iff(e_bin(.eq, VI, hdr_load(p, 0), e_iconst(1)))
    # unique: drop the elements but keep the storage
    if is_managed(et):
        n = hdr_load(p, 8)
        i = vreg(VI)
        e_mov(i, e_iconst(0))
        blk()
        lop()
        brif_to(e_bin(.ges, VI, i, n), ctl - 1)
        ea = e_bin(.add, VI, e_addi(p, 24), e_bin(.mul, VI, (if ownership_type(et): e_bin(.sub, VI, e_addi(n, -1), i) else: i), e_iconst(owner_stride(et))))
        owner_element_drop(ea, et)
        e_zero(ea, owner_stride(et))
        e_mov(i, e_addi(i, 1))
        br_to(ctl)
        endc()
        endc()
    hdr_store(p, 8, e_iconst(0))
    els()
    release(p, at)
    write_place(pl, at, e_iconst(0))
    endc()
    endc()
    return V(-1, false)

gen_intrinsic_extend = (e: int, arg_start: int) -> Val:
    arg0 = int(lists[arg_start])
    arg1 = int(lists[arg_start + 1])
    if ownership_type(ntype(arg0)):
        at = ntype(arg0)
        et = telem(at)
        source = gen_owned(arg1)
        pl = gen_place(arg0, true)
        sa = place_addr(pl, at)
        e_call3(rt("__arr_extend"), sa, source.v, e_iconst(owner_stride(et)), VI)
        iff(e_bin(.ne, VI, source.v, e_iconst(0)))
        hdr_store(source.v, 8, e_iconst(0))
        endc()
        owner_drop(e_slot(source.slot))
        return V(-1, false)
    # append all of ys: one copy of the bytes, then retain managed elements
    at = prune(ntype(arg0))
    et = int(types[at].elem)
    esz = owner_stride(et)
    sliced = is_slice(arg1)
    if sliced:
        src_root = write_root(int(nodes[arg1].a))
        dst_root = write_root(arg0)
        # A small self-append should copy the selected range rather than
        # retaining the entire source and forcing a full COW detach.
        if src_root != 0 and dst_root != 0 and same_var(src_root, dst_root): sliced = false
    ys = V(-1, false)
    data = -1
    cnt = -1
    if sliced:
        source_node = int(nodes[arg1].a)
        bt = prune(ntype(source_node))
        # The retained source is only read: the selected elements are the
        # copy extend makes, so `$explicit_copies` asks for no `.copy` here.
        if copies_on: copy_explicit[source_node] = true
        source = gen_owned(source_node)
        if copies_on: copy_explicit.remove(source_node)
        borrow(source, bt)
        p = vreg(VI)
        e_mov(p, source.v)
        lo, hi = gen_slice_bounds(arg1, p)
        n = if types[bt].kind == .fixed: e_iconst(fixed_len(bt)) else: arr_len(p)
        bad = e_bin(.or_, VI, e_bin(.lts, VI, lo, e_iconst(0)), e_bin(.gts, VI, hi, n))
        bad = e_bin(.or_, VI, bad, e_bin(.gts, VI, lo, hi))
        iff(bad)
        e_call_nr4(rt("__panic_slice"), e_daddr(str_data("slice")), lo, hi, n, -1)
        endc()
        # Freeze both bounds before destination evaluation, which may run
        # user code or replace the source (including a self-append).
        cnt = e_bin(.sub, VI, hi, lo)
        base = if types[bt].kind == .fixed: p else: e_addi(p, 24)
        data = e_bin(.add, VI, base, e_bin(.mul, VI, lo, e_iconst(esz)))
    else:
        # Finish a materialized slice's source snapshot before mutating
        # the destination. The owned slice itself survives this scope.
        if is_slice(arg1): stmt_begin()
        # (a whole source is only read, as a slice's is above: its elements
        # are the copy extend makes, which spreading `[xs... ys...]` uses)
        whole = copies_on and not is_slice(arg1) and not costly_copy(et) and not copy_explicit.has(arg1)
        if whole: copy_explicit[arg1] = true
        ys = gen_owned(arg1)
        if whole: copy_explicit.remove(arg1)
        if is_managed(et): cnt = arr_len(ys.v)
        if is_slice(arg1): stmt_end()
    pl = gen_place(arg0, true)
    arr_unique(pl, at)
    sa = place_addr(pl, at)
    first = 0
    if sliced: first = e_call4(rt("__arr_extend_raw"), sa, data, cnt, e_iconst(esz), VI)
    else: first = e_call3(rt("__arr_extend"), sa, ys.v, e_iconst(esz), VI)
    if not pl.mem: e_mov(pl.v, e_load(VI, sa, 0, ptr_size))
    if is_managed(et):
        i = vreg(VI)
        e_mov(i, e_iconst(0))
        blk()
        lop()
        brif_to(e_bin(.ges, VI, i, cnt), ctl - 1)
        copy_at(e_bin(.add, VI, first, e_bin(.mul, VI, i, e_iconst(esz))), et)
        e_mov(i, e_addi(i, 1))
        br_to(ctl)
        endc()
        endc()
    if not sliced: release(ys.v, at)
    return V(-1, false)

gen_intrinsic_reserve = (e: int, arg_start: int) -> Val:
    arg0 = int(lists[arg_start])
    arg1 = int(lists[arg_start + 1])
    at = prune(ntype(arg0))
    n = gen_expr(arg1).v
    pl = gen_place(arg0, true)
    arr_unique(pl, at)
    sa = place_addr(pl, at)
    e_call3(rt("__arr_reserve"), sa, e_iconst(owner_stride(int(types[at].elem))), n, -1)
    if not pl.mem: e_mov(pl.v, e_load(VI, sa, 0, ptr_size))
    return V(-1, false)

gen_intrinsic_resize = (e: int, arg_start: int) -> Val:
    arg0 = int(lists[arg_start])
    arg1 = int(lists[arg_start + 1])
    id = nodes[e].aux as IN
    at = prune(ntype(arg0))
    et = int(types[at].elem)
    n = gen_expr(arg1).v
    if id == .truncate and files[pos_file(nodes[arg1].pos)].is_dewy:
        # (a count below zero keeps no elements and is a mistake, not `clear`)
        iff(e_bin(.lts, VI, n, e_iconst(0)))
        e_call_nr1(rt("__panic"), e_daddr(str_data("{loc_str(nodes[arg1].pos)}: truncate keeps a count of elements, which cannot be negative")), -1)
        endc()
    pl = gen_place(arg0, true)
    arr_unique(pl, at)
    # (elements past an array's length are not zeroed: for elements that hold references
    # the new ones are zeroed, as the stores that write them drop what they replace)
    if id == .setlen and not is_managed(et):
        p = read_place(pl, at)
        # reserve(0) leaves an empty array null; it has no length header.
        iff(e_bin(.ne, VI, p, e_iconst(0)))
        hdr_store(p, 8, n)
        endc()
        return V(-1, false)
    if is_managed(et):
        # drop elements beyond the new length
        blk()
        lop()
        p = read_place(pl, at)
        cur = arr_len(p)
        brif_to(e_bin(.les, VI, cur, n), ctl - 1)
        last = e_bin(.sub, VI, cur, e_iconst(1))
        hdr_store(p, 8, last)
        ea = e_bin(.add, VI, e_addi(p, 24), e_bin(.mul, VI, last, e_iconst(owner_stride(et))))
        owner_element_drop(ea, et)
        e_zero(ea, owner_stride(et))
        br_to(ctl)
        endc()
        endc()
    if id == .truncate:
        p = read_place(pl, at)
        iff(e_bin(.ne, VI, p, e_iconst(0)))
        iff(e_bin(.lts, VI, n, hdr_load(p, 8)))
        hdr_store(p, 8, n)
        endc()
        endc()
        return V(-1, false)
    sa = place_addr(pl, at)
    e_call3(rt("__arr_resize"), sa, e_iconst(owner_stride(et)), n, -1)
    if not pl.mem: e_mov(pl.v, e_load(VI, sa, 0, ptr_size))
    return V(-1, false)

# ---- pointers only read through ----
# `xs.ptr` (data(xs)) detaches xs's elements from any other value sharing them only when
# the pointer may be written through: read through, it needs no copy of its own. One walk
# over a function's body follows each pointer where it goes: indexed and read, offset,
# converted to another pointer type, compared, or kept in a local (whose uses then count).
# Anything else (a write through it, a call, a return, a store elsewhere, a capture) is
# taken as a write. A call to a function that only reads its pointer parameter is a read.
# The walk also tells which locals are exposed only by such reads, so a Dewy parameter's
# binding can stay a view of the parameter. O(body) per function, once.
# (one union-find for all functions: its keys, nodes and locals, are each one function's)
pr_parent: {int: int}          # data() node n as n, local l as -l -> its class's next key
pr_written: {int: bool}        # class root -> a pointer of the class may be written
pr_exposed: {int: bool}        # locals exposed other than by a data() only read through
pr_done: {int: int}            # function -> the body walked
pr_busy: {int: bool}
pr_sites: int[]                # the data() nodes of the function being walked

pr_find = (k: int) -> int:
    if not pr_parent.has(k):
        pr_parent[k] = k
        # (a local another place reaches, or a closure, may do anything with its pointer)
        if k < 0 and int(locals[-k].flags) & (LF_CAPTURED | LF_CAPTURE | LF_SHARED | LF_ADDR | LF_BYREF | LF_ALIAS | LF_MUTPARAM) != 0: pr_written[k] = true
        return k
    x = k
    loop pr_parent[x] != x: x = pr_parent[x]
    x

pr_union = (a: int, b: int) -> int:
    if a == 0: return b
    if b == 0: return a
    ra = pr_find(a)
    rb = pr_find(b)
    if ra == rb: return ra
    pr_parent[ra] = rb
    if pr_written.has(ra): pr_written[rb] = true
    rb

pr_write = (k: int):
    if k != 0: pr_written[pr_find(k)] = true

# the class of the pointer e's value comes from (0: none followed)
pr_origin = (e: int) -> int:
    k = nodes[e].kind
    if k == .ident and nodes[e].aux == i32(int(SK.local)): return pr_find(-int(nodes[e].sym))
    if k == .intrinsic and (nodes[e].aux as IN) == .arrdata: return pr_find(e)
    if k == .binary and nodes[e].aux == 4: return pr_origin(int(nodes[e].a))
    if (k == .conv or k == .cast) and tkind(ntype(int(nodes[e].a))) == .ptr: return pr_origin(int(nodes[e].a))
    if k == .if_: return pr_union(pr_origin(int(nodes[e].b)), pr_origin(int(nodes[e].c)))
    0

# the local whose storage place n is in (as note_storage_access finds it), or 0
pr_root = (n0: int) -> int:
    n = n0
    loop nodes[n].kind == .field or nodes[n].kind == .index or nodes[n].kind == .unwrap or nodes[n].kind == .narrow: n = int(nodes[n].a)
    if nodes[n].kind != .ident or nodes[n].aux != i32(int(SK.local)): return 0
    int(nodes[n].sym)

pr_expose = (n: int):
    l = pr_root(n)
    loop l != 0:
        pr_exposed[l] = true
        if int(locals[l].flags) & LF_ALIAS == 0 or locals[l].alias == 0: return
        l = pr_root(int(locals[l].alias))

# a place written: pointers indexed on its way are written through
pr_target = (n0: int):
    n = n0
    loop nodes[n].kind == .field or nodes[n].kind == .index or nodes[n].kind == .unwrap or nodes[n].kind == .narrow:
        if nodes[n].kind == .index and tkind(ntype(int(nodes[n].a))) == .ptr: pr_write(pr_origin(int(nodes[n].a)))
        n = int(nodes[n].a)

pr_is_ptr = (c: int) -> bool: c > 0 and nodes[c].type != 0 and tkind(ntype(c)) == .ptr

# child c of n, a pointer: what n does with it
pr_use = (n: int, c: int, call_index: int):
    k = nodes[n].kind
    if k == .index and int(nodes[n].a) == c and not has_flag(n, NF_MUT) and not has_flag(n, NF_AT): return
    if k == .binary:
        # (offsetting gives the same pointer on; comparing only reads it)
        if nodes[n].aux == 4 or nodes[n].type != 0 and tkind(ntype(n)) == .bool_: return
    if (k == .conv or k == .cast) and pr_is_ptr(n): return
    if k == .if_ and int(nodes[n].a) != c and pr_is_ptr(n): return
    if k == .vardecl and nkids(n) == 0 and not has_flag(n, NF_GLOBAL):
        pr_union(-int(nodes[n].sym), pr_origin(c))
        return
    if k == .assign and nodes[n].aux == 0 and int(nodes[n].b) == c:
        t = int(nodes[n].a)
        if nodes[t].kind == .ident and nodes[t].aux == i32(int(SK.local)):
            pr_union(-int(nodes[t].sym), pr_origin(c))
            return
    if k == .call and call_index >= 0 and nodes[n].aux == 0 and checked_call_mutmask(n) & (1 << call_index) == 0 and not has_flag(c, NF_MUT) and not has_flag(c, NF_AT) and ptr_param_read(int(nodes[n].sym), call_index, nkids(n)): return
    pr_write(pr_origin(c))

pr_walk = (n: int):
    if n <= 0: return
    k = nodes[n].kind
    if k == .lambda or k == .fn_: return
    if k == .intrinsic and (nodes[n].aux as IN) == .arrdata and nkids(n) == 1:
        pr_find(n)
        pr_sites.push(n)
    else if k == .addr or ((k == .cast or k == .conv) and raw_view(n)): pr_expose(int(nodes[n].a))
    if k == .assign or k == .addr:
        t = int(nodes[n].a)
        if nodes[t].kind == .tuple:
            loop i in [0..nkids(t)): pr_target(kid(t, i))
        else: pr_target(t)
    else if k == .call:
        mm = checked_call_mutmask(n)
        loop i in [0..nkids(n)):
            if mm & (1 << i) != 0 or has_flag(kid(n, i), NF_MUT) or has_flag(kid(n, i), NF_AT): pr_target(kid(n, i))
    else if k == .intrinsic and nkids(n) > 0: pr_target(kid(n, 0))
    pr_child(n, int(nodes[n].a), -1)
    pr_child(n, int(nodes[n].b), -1)
    if k != .for_:
        pr_child(n, int(nodes[n].c), -1)
        if k != .partial: pr_child(n, int(nodes[n].d), -1)
    m = nkids(n)
    if m > 0:
        positional = k == .call
        if positional:
            loop i in [0..m):
                if nodes[kid(n, i)].kind == .namedarg: positional = false
        loop i in [0..m): pr_child(n, kid(n, i), if positional: i else: -1)
    loop i in [0..nkids2(n)): pr_child(n, kid2(n, i), -1)

pr_child = (n: int, c: int, i: int):
    if c <= 0: return
    if nodes[c].type != 0 and tkind(ntype(c)) == .ptr: pr_use(n, c, i)
    pr_walk(c)

# walk function f's body, once
ptr_reads = (f: int):
    body = if f > 0 and f < fns.len(): int(fns[f].body) else: 0
    if (pr_done.get(f) ?? -1) == body: return
    pr_done[f] = body
    saved = pr_sites
    pr_sites = []
    pr_busy[f] = true
    pr_walk(body)
    pr_busy.remove(f)
    loop site in pr_sites:
        if pr_written.has(pr_find(site)): pr_expose(kid(site, 0))
    pr_sites = saved

# is the pointer from data() node e only read through?
ptr_read_only = (e: int) -> bool:
    ptr_reads(cur_fn)
    pr_parent.has(e) and not pr_written.has(pr_find(e))

# does function f only read through its pointer parameter i (of a call with n arguments)?
ptr_param_read = (f: int, i: int, n: int) -> bool:
    if f <= 0 or f >= fns.len() or fns[f].body == 0 or fns[f].decl == 0 or has_flag(int(fns[f].decl), NF_EXTERN) or fns[f].cabi: return false
    if i >= fns[f].params.len() or n != fns[f].params.len() or pr_busy.has(f): return false
    ptr_reads(f)
    # (a Dewy parameter is read through its binding, which the walk joined to it)
    not pr_written.has(pr_find(-fns[f].params[i]))

gen_intrinsic_arrdata = (e: int, arg_start: int) -> Val:
    arg0 = int(lists[arg_start])
    id = nodes[e].aux as IN
    # a raw pointer into a variable's array may be written through: give the variable its own
    # copy first (a literal, or a shared one, must not change). One only read through needs none.
    a0 = arg0
    at = prune(ntype(a0))
    p = 0
    if id == .arrdata and types[at].kind == .array and data_writable(a0) and not ptr_read_only(e):
        pl = gen_place(a0, true)
        arr_unique(pl, at)
        # gen_place also detaches containing arrays and evaluates indexes.
        # Read that place directly; evaluating a side-effectful index again
        # could select another element or run the user's code twice.
        p = read_place(pl, at)
    else: p = gen_borrowed(a0).v
    r = vreg(VI)
    e_mov(r, e_iconst(0))
    iff(e_bin(.ne, VI, p, e_iconst(0)))
    e_mov(r, e_addi(p, 24))
    endc()
    return V(r, false)

gen_intrinsic_syscall = (e: int, arg_start: int, arg_count: int) -> Val:
    arg0 = int(lists[arg_start])
    # (an error only where it is used: the compiler has Linux's in code Windows programs leave out)
    if target_windows: fatal(nodes[e].pos, "syscall() is Linux's: a Windows program calls the system's DLL functions (lib/core/windows.jo)")
    vs: int[]
    loop i in [0..arg_count): vs.push(gen_expr(int(lists[arg_start + i])).v)
    # (macOS: done with libSystem's functions, lib/core/macos.jo)
    if target_macos:
        loop vs.len() < 7: vs.push(e_iconst(0))
        return V(e_call(rt("__mac_syscall"), vs, VI), false)
    interruptible = false
    if concurrency.concurrency_runtime_needed and nodes[arg0].kind == .int_lit and files[pos_file(nodes[e].pos)].path != lib_dir + "/std/tasks.jo" and files[pos_file(nodes[e].pos)].path != lib_dir + "/std/fork_join.jo":
        number = nodes[arg0].ival
        interruptible = number in [0, 1, 2, 7, 16, 17, 19, 20, 35, 42, 43, 44, 45, 46, 47, 61, 74, 75, 202, 288]
    if interruptible:
        result = vreg(VI)
        e_mov(result, e_iconst(-125))
        blk()
        done = ctl
        lop()
        retry = ctl
        brif_to(e_call0(rt("__task_canceled"), VI), done)
        start = ir.args.len()
        loop v in vs: ir.args.push(i32(v))
        raw = vreg(VI)
        emit(.syscall, VI, raw, i32(start), i32(vs.len()), 0, 0)
        brif_to(e_bin(.eq, VI, raw, e_iconst(-4)), retry)
        # Completed syscalls may transfer a descriptor or reap a process.
        # Let the public boundary account for that result before reporting
        # cancellation; only EINTR retries consult the scope here.
        e_mov(result, raw)
        endc()
        endc()
        return V(result, false)
    start = ir.args.len()
    loop v in vs: ir.args.push(i32(v))
    d = vreg(VI)
    emit(.syscall, VI, d, i32(start), i32(vs.len()), 0, 0)
    return V(d, false)

gen_intrinsic_callc = (e: int, arg_start: int, arg_count: int) -> Val:
    arg0 = int(lists[arg_start])
    fp = gen_expr(arg0).v
    vs: int[]
    loop i in [1..arg_count): vs.push(gen_expr(int(lists[arg_start + (i)])).v)
    e_calli(fp, vs, -1, false)
    return V(-1, false)

gen_intrinsic_memcpy = (e: int, arg_start: int) -> Val:
    arg0 = int(lists[arg_start])
    arg1 = int(lists[arg_start + 1])
    arg2 = int(lists[arg_start + 2])
    d = gen_expr(arg0).v
    s = gen_expr(arg1).v
    n = gen_expr(arg2).v
    emit(.memcpy, VI, 0, d, s, n, 0)
    return V(-1, false)

gen_intrinsic_zeroed = (e: int, arg_start: int) -> Val:
    t = ntype(e)
    if vc(t) != VC_AGG: return V(zero_val(t), true)
    z = e_slot(new_temp(t))
    e_zero(z, tsize(t))
    return V(z, true)

gen_intrinsic_memset = (e: int, arg_start: int) -> Val:
    arg0 = int(lists[arg_start])
    arg1 = int(lists[arg_start + 1])
    arg2 = int(lists[arg_start + 2])
    d = gen_expr(arg0).v
    b = gen_expr(arg1).v
    n = gen_expr(arg2).v
    emit(.memset, VI, 0, d, b, n, 0)
    return V(-1, false)

gen_intrinsic_panic = (e: int, arg_start: int, arg_count: int) -> Val:
    arg0 = int(lists[arg_start])
    m = 0
    # Message construction only runs on the terminating path. Its calls
    # must not make a checked helper look like it calls on successful paths.
    was = ir_cold
    ir_cold = true
    if arg_count > 0: m = gen_borrowed(arg0).v
    else: m = e_daddr(str_data("panic"))
    ir_cold = was
    e_call_nr1(rt("__panic"), m, -1)
    return never_after(e)

gen_intrinsic_unreachable = (e: int, arg_start: int) -> Val:
    e_call_nr1(rt("__panic"), e_daddr(str_data("unreachable code reached")), -1)
    return never_after(e)

gen_intrinsic_assert = (e: int, arg_start: int, arg_count: int) -> Val:
    arg0 = int(lists[arg_start])
    arg1 = int(lists[arg_start + 1])
    c = gen_expr(arg0).v
    iff(e_bin(.eq, VI, c, e_iconst(0)))
    # (the message is made only when it fails: a temporary made there is a conditional one)
    enter_cond()
    m = 0
    if arg_count > 1: m = gen_borrowed(arg1).v
    else:
        cond = call_args_text(nodes[e].pos)
        msg = "assertion failed"
        if len(cond) > 0 and len(cond) <= 200: msg = "assertion failed: {cond}"
        m = e_daddr(str_data(msg))
    e_call_nr2(rt("__assert_fail"), m, e_daddr(loc_data(nodes[e].pos)), -1)
    leave_cond()
    endc()
    return V(-1, false)

gen_intrinsic_embed = (e: int, arg_start: int) -> Val:
    s = name_of(int(nodes[e].sval))
    return V(e_daddr(str_data(s)), false)

gen_intrinsic_to_bytes = (e: int, arg_start: int) -> Val:
    arg0 = int(lists[arg_start])
    return V(gen_expr(arg0).v, false)

gen_intrinsic_argv = (e: int, arg_start: int) -> Val:
    d = vreg(VI)
    emit(.intr, VI, d, 0, 0, 0, 1)
    return V(d, false)

gen_intrinsic_setjmp = (e: int, arg_start: int, arg_count: int) -> Val:
    id = nodes[e].aux as IN
    vs: int[]
    loop i in [0..arg_count): vs.push(gen_expr(int(lists[arg_start + i])).v)
    start = ir.args.len()
    loop v in vs: ir.args.push(i32(v))
    d = vreg(VI)
    code = 2
    if id == .longjmp: code = 3
    if id == .jump: code = 4
    if id == .clone_thread: code = 5
    if id == .atomic_add: code = 6
    if id == .atomic_cas: code = 7
    if id == .stack_ptr: code = 8
    if id == .cpu_features: code = 9
    if id == .code_sync: code = 11
    emit(.intr, VI, d, i32(start), i32(vs.len()), 0, code)
    return V(d, false)

gen_intrinsic_mul_hi = (e: int, arg_start: int) -> Val:
    a = gen_expr(int(lists[arg_start])).v
    b = gen_expr(int(lists[arg_start + 1])).v
    if mulh_ok: return V(e_bin(.mulhu, VI, a, b), false)
    return V(e_call2(rt("__mul_hi_soft"), a, b, VI), false)

gen_intrinsic_sqrt = (e: int, arg_start: int) -> Val:
    arg0 = int(lists[arg_start])
    v = gen_expr(arg0).v
    return V(e_un(.fsqrt, vt_of(ntype(arg0)), v), false)

gen_intrinsic_hash = (e: int, arg_start: int) -> Val:
    arg0 = int(lists[arg_start])
    t = prune(ntype(arg0))
    pa = place_addr(gen_place(arg0, false), t)
    # (`__hash_value(x, true)`: the dictionaries' keyed hash)
    return V(e_call1(lf_helper(.hash, t, int(nkids(e) == 2)), pa, VI), false)

gen_intrinsic_gpu_kernel = (e: int, arg_start: int) -> Val:
    arg0 = int(lists[arg_start])
    arg1 = int(lists[arg_start + 1])
    # (the GLSL program, then, past a 0 byte, the SPIR-V one for Vulkan: not on the web)
    kf = int(nodes[arg0].sym)
    kd = name_of(int(nodes[arg1].sval))
    ks = glsl_kernel(kf, kd)
    # (on macOS, Metal's in place of SPIR-V)
    if target_macos: ks = ks + str_from_bytes([u8(0)]) + msl_kernel(kf, kd)
    else if not target_wasm: ks = ks + str_from_bytes([u8(0)]) + spirv_kernel(kf, kd)
    return V(e_daddr(str_data(ks)), false)

gen_intrinsic_compute_spirv = (e: int, arg_start: int) -> Val:
    arg0 = int(lists[arg_start])
    cs = ""
    if target_macos: cs = msl_compute(int(nodes[arg0].sym))
    else if not target_wasm: cs = spirv_compute(int(nodes[arg0].sym))
    return V(e_daddr(str_data(cs)), false)

gen_intrinsic_compute_textures = (e: int, arg_start: int) -> Val:
    arg0 = int(lists[arg_start])
    # where the parameters hold Textures (their GL names, given slots when dispatched): "8,40"
    offs: int[]
    texture_offsets(fns[int(nodes[arg0].sym)].ptypes[1], 0, offs)
    ts = ""
    loop i in 0.. and o in offs:
        if i > 0: ts += ","
        ts += "{o}"
    return V(e_daddr(str_data(ts)), false)

gen_intrinsic_shader = (e: int, arg_start: int) -> Val:
    arg0 = int(lists[arg_start])
    arg1 = int(lists[arg_start + 1])
    vsf = int(nodes[arg0].sym)
    fsf = int(nodes[arg1].sym)
    vs, fs, lay = glsl_build(vsf, fsf)
    if watch_build: glsl_of[e] = vs + fs + lay
    t = ntype(e)
    si = int(types[prune(t)].st)
    layout(t)
    s = new_temp(t)
    d = e_slot(s)
    e_zero(d, tsize(t))
    srcs = [vs, fs, lay]
    loop i in [0..3): e_store(d, int(fields[int(structs[si].fields) + i].offset), e_daddr(str_data(srcs[i])), ptr_size)
    # for the software renderer: the shader functions themselves (callable through C function
    # pointers: the result pointer comes first, then the arguments' addresses) and the size of
    # the vertex function's output (the values interpolated across triangles)
    if int(structs[si].nfields) >= 7:
        fo = int(structs[si].fields)
        e_store(d, int(fields[fo + 3].offset), e_faddr(lf_of_inst(vsf)), ptr_size)
        e_store(d, int(fields[fo + 4].offset), e_faddr(lf_of_inst(fsf)), ptr_size)
        e_store(d, int(fields[fo + 5].offset), e_iconst(tsize(int(fns[vsf].ret))), 8)
        e_store(d, int(fields[fo + 6].offset), e_iconst(fns[vsf].ptypes.len()), 8)
        if int(structs[si].nfields) >= 8:
            # per 4-byte slot of the output: 'i' if it holds integer (or f64) data, which is
            # passed on unchanged ("flat") instead of interpolated
            rt = int(fns[vsf].ret)
            mask = fill(u8('f'), max(tsize(rt) / 4, 1))
            flat_slots(rt, 0, mask)
            e_store(d, int(fields[fo + 7].offset), e_daddr(str_data(str_from_bytes(mask))), ptr_size)
        if int(structs[si].nfields) >= 10:
            vk = ("", "")
            if target_macos: vk = msl_build(vsf, fsf)
            else if not target_wasm: vk = spirv_build(vsf, fsf)
            e_store(d, int(fields[fo + 8].offset), e_daddr(str_data(vk.0)), ptr_size)
            e_store(d, int(fields[fo + 9].offset), e_daddr(str_data(vk.1)), ptr_size)
    return Val(d, true, s)

flat_slots = (t0: int, base: int, mask: mut u8[]):
    t = prune(t0)
    k = types[t].kind
    if k == .quantity:
        flat_slots(int(types[t].elem), base, mask)
        return
    if k == .float_ and int(types[t].bits) == 32: return
    if k == .vec and not types[t].sign: return
    if k == .struct_:
        si = int(types[t].st)
        layout(t)
        loop i in [0..int(structs[si].nfields)):
            f = fields[int(structs[si].fields) + i]
            flat_slots(int(f.type), base + int(f.offset), mask)
        return
    loop b in [base / 4..(base + tsize(t) + 3) / 4):
        if b < mask.len(): mask[b] = 'i'

gen_fmt_struct = (e: int) -> Val:
    args = kids(e)
    t = prune(ntype(args[1]))
    bp = gen_place(args[0], true)
    ba = place_addr(bp, ntype(args[0]))
    va = place_addr(gen_place(args[1], false), t)
    fi = 0
    k = types[t].kind
    # (Dewy's literal syntax: [x=1 name="q"], no type name and no commas)
    dewy = int(nodes[e].aux2) & FMT_DEWY != 0
    if k == .struct_:
        si = int(types[t].st)
        layout(t)
        # (a minted type with its name: Payload[code=1], or Unit with no fields)
        name = if not dewy or fmt_minted(si): structs[si].name else: ""
        shown = nkids2(e)
        if dewy and shown == 0 and name != "": lit(ba, name)
        else if dewy: lit(ba, "{name}[")
        else: lit(ba, "{name}(")
        loop i in fmt_field_order(si):
            f = int(structs[si].fields) + i
            if fmt_hidden(int(fields[f].type), nodes[e].aux2): continue
            sep = ""
            if fi > 0 and dewy: sep = " "
            else if fi > 0: sep = ", "
            lit(ba, "{sep}{name_of(int(fields[f].name))}=")
            fmt_field(ba, int(nodes[kid2(e, fi)].sym), int(fields[f].type), field_val_addr(f, va))
            fi += 1
        if not dewy: lit(ba, ")")
        else if shown > 0 or name == "": lit(ba, "]")
    else if k == .tuple:
        # (Dewy writes an array with a type per position as an array, `[1 "a"]`)
        lit(ba, (if dewy: "[" else: "("))
        tsep = ", "
        if dewy: tsep = " "
        loop i in [0..int(types[t].nargs)):
            if i > 0: lit(ba, tsep)
            fmt_field(ba, int(nodes[kid2(e, fi)].sym), targ(t, i), e_addi(va, tuple_off(t, i)))
            fi += 1
        lit(ba, (if dewy: "]" else: ")"))
    else if k == .enum_:
        si = int(types[t].st)
        layout(t)
        tag = e_load(VI, va, 0, 4)
        loop v in [0..int(structs[si].nvariants)):
            vi = int(structs[si].variants) + v
            want = v
            if structs[si].simple_enum: want = variants[vi].value
            iff(e_bin(.eq, VI, tag, e_iconst(want)))
            nf = int(variants[vi].nfields)
            if structs[si].union_:
                f = int(variants[vi].fields)
                fmt_field(ba, int(nodes[kid2(e, fi)].sym), int(fields[f].type), e_addi(va, int(fields[f].offset)))
                fi += 1
                endc()
                continue
            # (a string set's member is its text, quoted inside a structure as a string is)
            if structs[si].lit_set != 0 and dewy and int(nodes[e].aux2) & 1 != 0: lit(ba, __test_jq(name_of(int(variants[vi].name))))
            else: lit(ba, name_of(int(variants[vi].name)))
            if nf > 0:
                lit(ba, "(")
                loop j in [0..nf):
                    if j > 0: lit(ba, ", ")
                    f = int(variants[vi].fields) + j
                    fmt_field(ba, int(nodes[kid2(e, fi)].sym), int(fields[f].type), field_val_addr(f, va))
                    fi += 1
                lit(ba, ")")
            endc()
    else if k == .vec:
        n = vec_comps(t)
        lit(ba, "{type_str(t)}(")
        loop i in [0..n):
            if i > 0: lit(ba, ", ")
            if types[t].sign:
                e_call2(rt("__fmt_i32"), ba, e_load(VI, va, 4 * i, 4 | M_SIGNED), -1)
            else:
                e_call2(rt("__fmt_f32"), ba, e_load(VS, va, 4 * i, 4 | M_FLOAT), -1)
        lit(ba, ")")
    # (a function, which has no runtime value, shows as its type's spelling)
    else: lit(ba, if dewy or ts_dewy: type_str(t, true) else: "<fn>")
    V(-1, false)

lit = (ba: int, s: str): e_call2(rt("__buf_append_str"), ba, e_daddr(str_data(s)), -1)
fmt_field = (ba: int, f: int, t: int, addr: int): e_call2(lf_of_inst(f), ba, load_val(t, addr, 0), -1)

# Typed JSON writing uses the field writers selected by the checker. It emits
# directly into the caller's buffer, without a text round trip or a Json tree.
gen_json_fields = (e: int) -> Val:
    args = kids(e)
    t = prune(ntype(args[1]))
    ba = place_addr(gen_place(args[0], true), ntype(args[0]))
    va = place_addr(gen_place(args[1], false), t)
    indent = gen_expr(args[2]).v
    level = gen_expr(args[3]).v
    child = e_addi(level, 1)
    fi = 0
    k = types[t].kind
    if k == .struct_:
        si = int(types[t].st)
        layout(t)
        lit(ba, "{{")
        loop i in [0..int(structs[si].nfields)):
            f = int(structs[si].fields) + i
            json_key(ba, name_of(int(fields[f].name)), indent, level, i)
            json_field(ba, int(nodes[kid2(e, fi)].sym), int(fields[f].type), field_val_addr(f, va), indent, child)
            fi += 1
        if structs[si].nfields > 0: e_call3(rt("__json_newline"), ba, indent, level, -1)
        lit(ba, "}}")
    else if k == .fixed:
        lit(ba, "[")
        et = int(types[t].elem)
        i = fixed_loop_begin(t)
        e_call4(rt("__json_sep"), ba, indent, level, i, -1)
        json_field(ba, int(nodes[kid2(e, 0)].sym), et, fixed_elem_addr(va, i, et), indent, child)
        fixed_loop_end(i)
        if fixed_len(t) > 0: e_call3(rt("__json_newline"), ba, indent, level, -1)
        lit(ba, "]")
    else if k == .tuple or k == .vec:
        count = if k == .tuple: int(types[t].nargs) else: vec_comps(t)
        lit(ba, "[")
        loop i in [0..count):
            e_call4(rt("__json_sep"), ba, indent, level, e_iconst(i), -1)
            ft = if k == .tuple: targ(t, i) else if types[t].sign: T_I32 else: T_F32
            off = if k == .tuple: tuple_off(t, i) else: i * 4
            json_field(ba, int(nodes[kid2(e, i)].sym), ft, e_addi(va, off), indent, child)
        if count > 0: e_call3(rt("__json_newline"), ba, indent, level, -1)
        lit(ba, "]")
    else if k == .enum_:
        si = int(types[t].st)
        layout(t)
        tag = e_load(VI, va, 0, 4)
        loop v in [0..int(structs[si].nvariants)):
            vi = int(structs[si].variants) + v
            want = if structs[si].simple_enum: variants[vi].value else: v
            iff(e_bin(.eq, VI, tag, e_iconst(want)))
            nf = int(variants[vi].nfields)
            name = name_of(int(variants[vi].name))
            if structs[si].union_:
                f = int(variants[vi].fields)
                json_field(ba, int(nodes[kid2(e, fi)].sym), int(fields[f].type), field_val_addr(f, va), indent, level)
                fi += 1
            else if nf == 0:
                e_call2(rt("__json_write_str"), ba, e_daddr(str_data(name)), -1)
            else:
                lit(ba, "{{")
                json_key(ba, name, indent, level, 0)
                lit(ba, "[")
                loop j in [0..nf):
                    e_call4(rt("__json_sep"), ba, indent, child, e_iconst(j), -1)
                    f = int(variants[vi].fields) + j
                    json_field(ba, int(nodes[kid2(e, fi)].sym), int(fields[f].type), field_val_addr(f, va), indent, e_addi(child, 1))
                    fi += 1
                e_call3(rt("__json_newline"), ba, indent, child, -1)
                lit(ba, "]")
                e_call3(rt("__json_newline"), ba, indent, level, -1)
                lit(ba, "}}")
            endc()
    V(-1, false)

json_key = (ba: int, name: str, indent: int, level: int, index: int):
    e_call(rt("__json_key"), [ba, e_daddr(str_data(name)), indent, level, e_iconst(index)], -1)

json_field = (ba: int, f: int, t: int, addr: int, indent: int, level: int):
    e_call4(lf_of_inst(f), ba, load_val(t, addr, 0), indent, level, -1)

# ---------------- conversions ----------------
# a string set's word w as the word of the same member in set type `to` (members are
# unordered: one set's word for a member is not another's); a member `to` lacks panics
set_word_moved = (w: int, from: int, to: int, pos: int) -> int:
    fs = str_set_of(from)
    ts = str_set_of(to)
    d = vreg(VI)
    e_mov(d, w)
    lacks = false
    loop k in 0.. and value in str_sets[fs]:
        j = str_sets[ts].index_of(value)
        if j < 0: lacks = true
        else if j != k:
            iff(e_bin(.eq, VI, w, e_iconst(k)))
            e_mov(d, e_iconst(j))
            endc()
    if lacks:
        loop k in 0.. and value in str_sets[fs]:
            if not str_sets[ts].contains(value):
                iff(e_bin(.eq, VI, w, e_iconst(k)))
                e_call_nr1(rt("__panic_narrow"), e_daddr(loc_data(pos)), -1)
                endc()
    d

gen_conv = (e: int) -> Val:
    to = prune(ntype(e))
    a = int(nodes[e].a)
    from = prune(ntype(a))
    cv = nodes[e].aux as CV
    if (cv == .wrap_int or cv == .saturate_int) and exact_has_node(a): return exact_gen_policy(e)
    if (cv == .int_ or cv == .none_) and to == T_MATH_INT and exact_has_node(a): return exact_gen_math(a)
    if cv == .fixed_store: return exact_gen_store(e)
    if exact_progress_math.len() > 0 and exact_progress_math.has(e): return V(math_word_expr(a), false)
    if cv == .int2float and exact_has_node(a): return exact_gen_float(a, to)
    if cv == .refinement: return refine_gen(e)
    if cv == .promote: return arena_gen_promote(e)
    if cv == .explicit_copy:
        if ownership_type(from):
            value = gen_expr(a)
            borrow(value, from)
            return own(Val(value.v, false, -1), from)
        if not copies_on: return own(gen_expr(a), from)
        copy_explicit[a] = true
        value = gen_expr(a)
        copy_explicit.remove(a)
        return own(value, from)
    if cv == .none_ or cv == .quantity_const or cv == .ptr: return gen_expr(a)
    if cv == .set_text:
        # (a string set's member text: the table's offset of it, from the table)
        member = gen_expr(a).v
        table = e_daddr(set_text_table(int(nodes[e].aux2)))
        rel = e_load(VI, e_bin(.add, VI, table, e_bin(.mul, VI, member, e_iconst(8))), 0, 8)
        return V(e_bin(.add, VI, table, rel), false)
    if cv == .big2math: return math_call("__mi_pack", [gen_borrowed(a).v])
    if cv == .math2big: return math_call("__mi_big", [gen_borrowed(a).v], to)
    if cv == .wrap_int or cv == .saturate_int:
        v = gen_borrowed(a).v
        if cv == .wrap_int:
            if from == T_MATH_INT: v = e_call1(rt("__mi_low_word"), v, VI)
            else if types[from].bits == 32 and not types[from].sign and types[to].bits == 64: v = e_un(.zext32, VI, v)
            return V(norm(v, to), false)
        bits = int(types[to].bits)
        hi = if bits == 64: -1 else: (1 << bits) - 1
        lo = 0
        if types[to].sign:
            hi = int(u64(hi) >> 1)
            lo = -hi - 1
        if from == T_MATH_INT:
            return V(e_call(rt("__mi_clamp_word"), [v, e_iconst(lo), e_iconst(hi), e_iconst(int(not types[to].sign))], VI), false)
        result = vreg(VI)
        e_mov(result, v)
        if types[from].sign:
            iff(e_bin(.lts, VI, v, e_iconst(lo)))
            e_mov(result, e_iconst(lo))
            els()
            iff(e_bin((if types[to].sign: Op.gts else: Op.gtu), VI, v, e_iconst(hi)))
            e_mov(result, e_iconst(hi))
            endc()
            endc()
        else:
            iff(e_bin(.gtu, VI, v, e_iconst(hi)))
            e_mov(result, e_iconst(hi))
            endc()
        return V(norm(result, to), false)
    if cv == .int_:
        if from == T_MATH_INT and math_proven_word(a):
            v = math_word_expr(a)
            # The proof removes only the representation check, not narrowing.
            bits = int(types[to].bits)
            if not types[to].sign: math_int_guard(e_bin(.lts, VI, v, e_iconst(0)))
            if bits < 64:
                hi = (1 << (bits - int(types[to].sign))) - 1
                lo = if types[to].sign: -hi - 1 else: 0
                math_int_guard(e_bin(.lts, VI, v, e_iconst(lo)))
                math_int_guard(e_bin(.gts, VI, v, e_iconst(hi)))
            return V(norm(v, to), false)
        v = gen_borrowed(a).v
        if to == T_MATH_INT:
            if is_int(from) and not types[from].sign and types[from].bits == 64: return math_call("__mi_unsigned", [v])
            return math_pack_word(a, v)
        if from == T_MATH_INT:
            v = if types[to].sign: math_signed(v) else: e_call1(rt("__mi_to_unsigned"), v, VI)
        if (from == T_MATH_INT or to == T_MATH_INT) and not int_widens(from, to):
            lo = 0
            hi = -1
            bits = int(types[to].bits)
            if bits < 64: hi = (1 << bits) - 1
            if types[to].sign:
                hi = int(u64(hi) >> 1)
                lo = -hi - 1
            if types[from].sign and (from != T_MATH_INT or types[to].sign):
                math_int_guard(e_bin(.lts, VI, v, e_iconst(lo)))
                if types[to].sign or bits < 64: math_int_guard(e_bin(.gts, VI, v, e_iconst(hi)))
            else: math_int_guard(e_bin(.gtu, VI, v, e_iconst(hi)))
        return V(norm(v, to), false)
    if cv == .int2float:
        if from == T_MATH_INT:
            if math_proven_word(a):
                v = e_un(.i2f, VF, math_word_expr(a))
                if to == T_F32: v = e_un(.f2f, VS, v)
                return V(v, false)
            fast = math_float_binary(a, to)
            if fast >= 0: return V(fast, false)
        if from == T_MATH_INT:
            v = e_call1(rt("__mi_float"), gen_borrowed(a).v, VF)
            if to == T_F32: v = e_un(.f2f, VS, v)
            return V(v, false)
        v = gen_expr(a).v
        if types[from].kind == .int_ and not types[from].sign and int(types[from].bits) == 64: return V(e_un(.u2f, vt_of(to), v), false)
        return V(e_un(.i2f, vt_of(to), v), false)
    if cv == .float2int:
        # f2i saturates to i64; narrower and unsigned types saturate to their own range
        v = gen_expr(a).v
        ft = vt_of(from)
        if to == T_MATH_INT:
            if from == T_F32: v = e_un(.f2f, VF, v)
            return math_call("__mi_from_float", [v])
        d = vreg(VI)
        bits = 64
        sg = true
        if types[to].kind == .int_:
            bits = int(types[to].bits)
            sg = types[to].sign
        # (Dewy keeps the value: NaN and out-of-range values are checked, not saturated)
        if dewy_at(nodes[e].pos) and float_int_guard(e, v, ft, to):
            if bits == 64 and not sg: return V(float_to_u64(v, ft), false)
            emit(.f2i, ft, d, v, 0, 0, 0)
            return V(norm(d, to), false)
        if bits == 64 and not sg:
            # at 2^63 and above (no i64 holds them): convert v - 2^63 and set the top bit
            two63 = e_fconst(9223372036854775808.0, ft)
            iff(e_bin(.fge, ft, v, two63))
            t = vreg(VI)
            emit(.f2i, ft, t, e_bin(.fsub, ft, v, two63), 0, 0, 0)
            e_mov(d, e_bin(.xor, VI, t, e_iconst(-9223372036854775807 - 1)))
            els()
            emit(.f2i, ft, d, v, 0, 0, 0)
            iff(e_bin(.lts, VI, d, e_iconst(0)))
            e_mov(d, e_iconst(0))
            endc()
            endc()
            return V(d, false)
        emit(.f2i, ft, d, v, 0, 0, 0)
        if bits < 64:
            lo = 0
            hi = (1 << bits) - 1
            if sg:
                lo = -(1 << (bits - 1))
                hi = (1 << (bits - 1)) - 1
            iff(e_bin(.lts, VI, d, e_iconst(lo)))
            e_mov(d, e_iconst(lo))
            endc()
            iff(e_bin(.gts, VI, d, e_iconst(hi)))
            e_mov(d, e_iconst(hi))
            endc()
        return V(norm(d, to), false)
    if cv == .float_:
        v = gen_expr(a).v
        if vt_of(from) == vt_of(to): return V(v, false)
        d = vreg(vt_of(to))
        emit(.f2f, vt_of(to), d, v, 0, 0, 0)
        return V(d, false)
    if cv == .union_:
        # the same value in a union with other members: the tag maps to the member's new
        # index and the payload moves along (a member the new union lacks cannot be here)
        layout(from)
        layout(to)
        s = new_temp(to)
        d = e_slot(s)
        e_zero(d, tsize(to))
        src = gen_owned(a).v
        tag = e_load(VI, src, 0, 4)
        fsi = int(types[from].st)
        tsi = int(types[to].st)
        loop i in 0.. and m in union_members(from):
            iff(e_bin(.eq, VI, tag, e_iconst(i)))
            j = union_holder(to, m, false)
            if j < 0: e_call_nr1(rt("__panic_narrow"), e_daddr(loc_data(nodes[e].pos)), -1)
            else:
                e_store(d, 0, e_iconst(j), 4)
                fo = int(fields[int(variants[int(structs[fsi].variants) + i].fields)].offset)
                to_off = int(fields[int(variants[int(structs[tsi].variants) + j].fields)].offset)
                tm = union_members(to)[j]
                if not type_eq(tm, m): e_store(d, to_off, set_word_moved(e_load(VI, src, fo, tsize(m)), m, tm, nodes[e].pos), tsize(tm))
                else if tsize(m) > 0: e_copy(e_addi(d, to_off), e_addi(src, fo), tsize(m))
            endc()
        return Val(d, true, s)
    if cv == .arr2fixed:
        push = fact_fixed_comprehension(a, to)
        if push != 0: return gen_fixed_comprehension(a, push, to)
        if copies_on: copy_components(e, to, "the fixed array contains heap payloads that must be copied")
        # Check the shape once, then copy the value into inline storage.
        src = gen_borrowed(a).v
        n = fixed_len(to)
        iff(e_bin(.ne, VI, arr_len(src), e_iconst(n)))
        e_call_nr1(rt("__panic"), e_daddr(str_data("fixed-size array needs {n} elements")), -1)
        endc()
        s = new_temp(to)
        d = e_slot(s)
        if ownership_type(to):
            et = telem(to)
            held: int[]
            loop i in [0..n):
                ea = e_addi(src, 24 + i * owner_stride(et))
                value = own(Val(load_val(et, ea, 0), false, -1), et)
                store_val(et, d, i * tsize(et), value.v)
                held.push(value.slot)
            loop slot in held: owner_forget_slot(slot)
            return Val(d, true, s)
        e_copy(d, e_addi(src, 24), tsize(to))
        if is_managed(to): copy_at(d, to)
        return Val(d, true, s)
    if cv == .fixed2arr:
        if copies_on: copy_components(e, from, "the array conversion duplicates heap payloads")
        # a new array holding copies of the elements
        et = int(types[from].elem)
        esz = tsize(et)
        n = fixed_len(from)
        src = place_addr(gen_place(a, false), from)
        if ownership_type(to): return owner_array_from_fixed(src, et, n, to)
        arr = vreg(VI)
        e_mov(arr, e_call2(rt("__arr_filled"), e_iconst(n), e_iconst(esz), VI))
        e_copy(e_addi(arr, 24), src, n * esz)
        if is_managed(et):
            i = vreg(VI)
            e_mov(i, e_iconst(0))
            blk()
            lop()
            brif_to(e_bin(.ges, VI, i, e_iconst(n)), ctl - 1)
            copy_at(e_bin(.add, VI, e_addi(arr, 24), e_bin(.mul, VI, i, e_iconst(esz))), et)
            e_mov(i, e_addi(i, 1))
            br_to(ctl)
            endc()
            endc()
        return V(arr, true)
    if cv == .opt:
        if math_optional(to):
            value = gen_owned(a)
            return V(e_bin(.xor, VI, value.v, e_iconst(1)), true)
        inner = int(types[to].elem)
        s = new_temp(to)
        d = e_slot(s)
        e_zero(d, tsize(to))
        val = gen_owned(a)
        store_val(inner, d, 0, val.v)
        e_store(d, tsize(inner), e_iconst(1), 1)
        if ownership_type(inner): owner_forget_slot(val.slot)
        return Val(d, true, s)
    fatal(nodes[e].pos, "invalid conversion")
    V(-1, false)

# ---------------- expressions ----------------
# (after code that never comes back: a value of n's type when it is taken as one, "a" + panic(...))
never_after = (n: int) -> Val:
    t = prune(ntype(n))
    if t == T_NEVER or vc(t) == VC_VOID: return V(-1, false)
    never_value(t)

# any value of type t, where one is wanted after code that never comes back (it is never used)
never_value = (t: int) -> Val:
    if vc(t) == VC_AGG:
        s = new_temp(t)
        d = e_slot(s)
        e_zero(d, tsize(t))
        return Val(d, true, s)
    if vc(t) == VC_FLT: return V(e_fconst(0.0, vt_of(t)), false)
    V(e_iconst(0), false)

gen_expr = (e: int) -> Val:
    value = gen_expr_value(e)
    if ff_checks_any: float_check(e, value.v, ntype(e))
    if float_keys_any: float_key_check(e, value.v, ntype(e))
    if ownership_type(ntype(e)) and value.owned: return owner_value(value, ntype(e))
    value

# Dispatch once by the checked AST kind. Case-local scratch is constructed
# only in the selected handler; recursive children still lower exactly once.
gen_expr_value = (e: int) -> Val:
    if exact_lower_active and exact_has_node(e): return V(exact_low_word(e), false)
    match nodes[e].kind:
        int_lit: return gen_value_int_lit(e)
        float_lit: return gen_value_float_lit(e)
        bool_lit: return V(e_iconst(nodes[e].ival), false)
        null_lit: return V(e_iconst(0), false)
        none_lit: return gen_value_none_lit(e)
        str_lit: return gen_value_str_lit(e)
        ident: return gen_value_ident(e)
        field: return gen_value_field(e)
        dotname: return gen_value_dotname(e)
        parallel_region: return gen_expr(int(nodes[e].a))
        index: return gen_value_index(e)
        unwrap, narrow: return gen_value_unwrap(e)
        istype: return gen_value_istype(e)
        call: return gen_value_call(e)
        intrinsic: return gen_intrinsic(e)
        partial: return gen_partial(e)
        lambda: return gen_lambda(e)
        fnref: return gen_fnref(e)
        unary: return gen_value_unary(e)
        not_: return V(e_bin(.xor, VI, gen_expr(int(nodes[e].a)).v, e_iconst(1)), false)
        and_, or_: return gen_value_and_(e)
        binary:
            value = gen_binary(e)
            if int_policy(ntype(e)) == 1: value.v = norm(value.v, ntype(e))
            return value
        conv: return gen_value_conv(e)
        cast: return gen_value_cast(e)
        coalesce: return gen_value_coalesce(e)
        array: return gen_value_array(e)
        map_lit: return gen_value_map_lit(e)
        tuple: return gen_value_tuple(e)
        range: return gen_value_range(e)
        addr: return gen_value_addr(e)
        if_: return gen_value_if_(e)
        iflet: return gen_value_iflet(e)
        match_: return gen_match(e, not has_flag(e, NF_STMT))
        block: return gen_value_block(e)
        _: fatal(nodes[e].pos, "unsupported expression in codegen ({nodes[e].kind})")
    V(-1, false)

gen_value_int_lit = (e: int) -> Val:
    t = prune(ntype(e))
    if quantity_base(t) == T_MATH_INT:
        if has_flag(e, NF_U64) and nodes[e].ival < 0: return math_call("__mi_unsigned", [e_iconst(nodes[e].ival)])
        return math_word(e_iconst(nodes[e].ival))
    if vc(t) == VC_FLT: return V(e_fconst(f64(nodes[e].ival), vt_of(t)), false)
    return V(e_iconst(nodes[e].ival), false)

gen_value_float_lit = (e: int) -> Val:
    t = prune(ntype(e))
    return V(e_fconst(nodes[e].fval, vt_of(t)), false)

gen_value_none_lit = (e: int) -> Val:
    t = prune(ntype(e))
    if vc(t) != VC_AGG: return V(e_iconst(0), false)
    s = new_temp(t)
    d = e_slot(s)
    e_zero(d, tsize(t))
    return Val(d, true, s)

gen_value_str_lit = (e: int) -> Val:
    if nodes[e].aux != 0: return gen_interp(e)
    return V(e_daddr(str_data(name_of(int(nodes[e].sval)))), false)

gen_value_ident = (e: int) -> Val:
    t = prune(ntype(e))
    if t == T_MATH_INT and nodes[e].aux == i32(int(SK.local)):
        if let word = math_word_regs.get(int(nodes[e].sym)): return math_pack_word(e, word)
    if nodes[e].aux == i32(int(SK.local)) or nodes[e].aux == i32(int(SK.global)):
        p = gen_place(e, false)
        return V(read_place(p, t), false)
    if tkind(t) == .typeval or tkind(t) == .module: type_as_value(e)
    fatal(nodes[e].pos, "cannot generate identifier")
    V(-1, false)  # unreachable; the C seed does not infer fatal as never

gen_value_field = (e: int) -> Val:
    t = prune(ntype(e))
    if nodes[e].aux == -4: return gen_swizzle(e)
    p = gen_place(e, false)
    return V(read_place(p, t), false)

gen_value_dotname = (e: int) -> Val:
    t = prune(ntype(e))
    si = int(types[t].st)
    layout(t)
    if structs[si].simple_enum: return V(e_iconst(variants[int(structs[si].variants) + int(nodes[e].aux)].value), false)
    s = new_temp(t)
    d = e_slot(s)
    e_zero(d, tsize(t))
    e_store(d, 0, e_iconst(int(nodes[e].aux)), 4)
    return Val(d, true, s)

gen_value_index = (e: int) -> Val:
    t = prune(ntype(e))
    scalar = parallel_scalar_read(e)
    if scalar >= 0: return V(scalar, false)
    if nodes[e].aux == 1: return gen_slice(e)
    p = gen_place(e, false)
    return V(read_place(p, t), false)

gen_value_unwrap = (e: int) -> Val:
    t = prune(ntype(e))
    p = gen_place(e, false)
    return V(read_place(p, t), false)

gen_value_istype = (e: int) -> Val:
    a = int(nodes[e].a)
    at = prune(ntype(a))
    vi = int(nodes[e].aux)
    if vi == -3: return V(e_iconst(1), false)
    if nodes[e].aux2 != 0:
        has = gen_map_presence(a, int(nodes[e].aux2))
        if vi == -1: return V(e_bin(.eq, VI, has, e_iconst(0)), false)
        return V(has, false)
    if vi < 0:
        view = held_opt_reg(a)
        if view >= 0:
            return V(e_bin((if vi == -1: Op.eq else: Op.ne), VI, view, e_iconst(0)), false)
    p = gen_place(a, false)
    addr = place_addr(p, at)
    if vi < 0:
        # optional: its has-value flag follows the value
        has = opt_has(addr, int(types[at].elem))
        if vi == -1: return V(e_bin(.eq, VI, has, e_iconst(0)), false)
        return V(e_bin(.ne, VI, has, e_iconst(0)), false)
    layout(at)
    return V(e_bin(.eq, VI, e_load(VI, addr, 0, 4), e_iconst(vi)), false)

gen_value_call = (e: int) -> Val:
    t = prune(ntype(e))
    # A guarded numeric map already proved every intermediate fits a word.
    # Keep min/max as a value select so its inlined branch does not extend
    # the live ranges of all the strided input cursors.
    if exact_map_active and exact_representation(t) == T_INT and nkids(e) == 2 and (fact_library_call(e, "min") or fact_library_call(e, "max")):
        a = gen_expr(kid(e, 0)).v; b = gen_expr(kid(e, 1)).v
        condition = e_bin(.gts, VI, a, b)
        result = vreg(VI)
        maximum = fact_library_call(e, "max")
        emit(.select, VI, result, condition, (if maximum: a else: b), (if maximum: b else: a), 0)
        return V(result, false)
    # (a call that never comes back, as panic(...), where a value is wanted: "a" + panic("x"))
    if t != T_NEVER and vc(t) != VC_VOID and int(nodes[e].aux) == 0 and nodes[e].sym > 0 and prune(int(fns[int(nodes[e].sym)].ret)) == T_NEVER:
        saved_t = nodes[e].type
        nodes[e].type = i32(T_NEVER)
        gen_expr(e)
        nodes[e].type = saved_t
        return never_value(t)
    if t == T_MATH_INT and math_word_helper(e) > 0: return math_pack_word(e, math_word_expr(e))
    ir_set_pos(nodes[e].pos)
    aux = int(nodes[e].aux)
    if aux == 0:
        remainder = gen_positive_mod(e)
        if remainder >= 0: return V(remainder, false)
        arithmetic = gen_constant_floor(e)
        if arithmetic >= 0: return V(arithmetic, false)
        word = gen_byte_read(e)
        if word >= 0: return V(word, false)
        if fns[int(nodes[e].sym)].parallel: race_check(int(nodes[e].sym), kids(e), nodes[e].pos)
        if fns[int(nodes[e].sym)].deterministic:
            # Cache ownership follows reachable serial lowering, not worker candidates.
            if fused_on: fz_note(7, 0, e, 0, 0)
            else: det_check(int(nodes[e].sym), kids(e), nodes[e].pos)
        order: int[]
        if nodes[e].c != 0: order = call_eval_order(e)
        target = if ownership_prints.has(e): runtime_fn("__owner_print") else: int(nodes[e].sym)
        r = gen_direct_call(target, kids(e), order, e)
        if ownership_prints.has(e) and is_union(t):
            slot = new_temp(t)
            value = e_slot(slot)
            e_zero(value, tsize(t))
            e_store(value, 0, e_iconst(union_index(t, T_VOID)), 4)
            return Val(value, true, slot)
        if vc(t) == VC_VOID: return V(-1, false)
        return r
    if aux == 1:
        order: int[]
        if nodes[e].c != 0: order = call_eval_order(e)
        r = gen_closure_call(int(nodes[e].a), kids(e), order)
        if vc(t) == VC_VOID: return V(-1, false)
        return r
    if aux == 4: return gen_cfn_call(int(nodes[e].a), kids(e))
    if aux == 2:
        si = int(types[t].st)
        layout(t)
        s = new_temp(t)
        d = e_slot(s)
        e_zero(d, tsize(t))
        tracked = build_slot(s, t)
        owner_fields: (int, int)[]
        loop i in call_eval_order(e):
            a = kid(e, i)
            if a == 0: continue
            f = int(structs[si].fields) + i
            source = a
            if refine_active and nodes[a].kind == .conv and nodes[a].aux == i32(int(CV.refinement)): source = int(nodes[a].a)
            val = gen_owned(source)
            store_field(f, d, val.v)
            if ownership_type(ntype(source)):
                held_type = ntype(source)
                if fields[f].boxed:
                    # After boxing, the allocation and payload have one
                    # cleanup authority even before the outer record exists.
                    held_type = field_store_type(f)
                    boxed = owner_value(V(e_load(VI, d, int(fields[f].offset), ptr_size), true), held_type)
                    owner_forget_slot(val.slot)
                    val = boxed
                owner_fields.push((val.slot, held_type))
                building.push(BuildItem(true, val.slot, held_type))
        if refine_active:
            values: int[]
            arg_types: int[]
            loop i in [0..nkids(e)):
                f = int(structs[si].fields) + i
                ft = int(fields[f].type)
                values.push(load_val(ft, field_val_addr(f, d), 0))
                arg_types.push(ft)
            loop i in [0..nkids(e)):
                a = kid(e, i)
                if a != 0 and nodes[a].kind == .conv and nodes[a].aux == i32(int(CV.refinement)): ref_gen_check(a, values[i], values, arg_types)
        loop field in owner_fields:
            owner_forget_slot(field.0)
            building.pop()
        if tracked: building.pop()
        return Val(e_slot(s), true, s)
    if aux == 3:
        si = int(types[t].st)
        layout(t)
        v = int(nodes[e].aux2)
        # (a value made a union member: which member, by its type now that inference is done,
        # since the union's members may have been put in another order)
        if structs[si].union_ and nkids(e) == 1:
            j = union_index(t, ntype(kid(e, 0)))
            if j >= 0: v = j
        vi = int(structs[si].variants) + v
        if structs[si].simple_enum: return V(e_iconst(variants[vi].value), false)
        s = new_temp(t)
        d = e_slot(s)
        e_zero(d, tsize(t))
        e_store(d, 0, e_iconst(v), 4)
        tracked = build_slot(s, t)
        loop i in call_eval_order(e):
            f = int(variants[vi].fields) + i
            val = gen_owned(kid(e, i))
            store_field(f, d, val.v)
        if tracked: building.pop()
        return Val(e_slot(s), true, s)
    fatal(nodes[e].pos, "invalid call")
    V(-1, false)  # unreachable; the C seed does not infer fatal as never

gen_value_unary = (e: int) -> Val:
    t = prune(ntype(e))
    a = int(nodes[e].a)
    if nodes[e].op == i32(int(Tok.plus)): return gen_expr(a)
    if is_vec(t):
        neg = mk(.binary, nodes[e].pos)
        nodes[neg].op = i32(int(Tok.star))
        nodes[neg].a = i32(a)
        m1 = mk(.float_lit, nodes[e].pos)
        nodes[m1].fval = -1.0
        nodes[m1].type = i32(T_F32)
        if types[prune(t)].sign:
            # (an integer vector: times the integer -1, which wraps as the CPU's integers do)
            nodes[m1].kind = .int_lit
            nodes[m1].ival = -1
            nodes[m1].type = i32(T_I32)
        nodes[neg].b = i32(m1)
        nodes[neg].aux = 10
        nodes[neg].type = i32(t)
        return gen_vec_binary(neg, false)
    if t == T_MATH_INT:
        base = if nodes[e].op == i32(int(Tok.minus)): 0 else: -1
        return math_binary(.minus, math_word(e_iconst(base)).v, gen_borrowed(a).v)
    v = gen_expr(a).v
    if nodes[e].op == i32(int(Tok.minus)):
        if vc(t) == VC_FLT: return V(e_un(.fneg, vt_of(t), v), false)
        if int_policy(t) == 2: return V(saturate_binary(.minus, t, e_iconst(0), v), false)
        value = e_un(.neg, VI, v)
        if int_policy(t) == 1: value = norm(value, t)
        return V(value, false)
    return V(norm(e_un(.not_, VI, v), t), false)

gen_value_and_ = (e: int) -> Val:
    k = nodes[e].kind
    chain = range_tail(e)
    if chain != e: return gen_expr(chain)
    range = gen_range_cond(e)
    if range >= 0: return V(range, false)
    r = vreg(VI)
    e_mov(r, gen_expr(int(nodes[e].a)).v)
    if k == .and_: iff(r)
    else: iff(e_bin(.eq, VI, r, e_iconst(0)))
    enter_cond()
    e_mov(r, gen_expr(int(nodes[e].b)).v)
    leave_cond()
    endc()
    return V(r, false)

gen_value_conv = (e: int) -> Val:
    t = prune(ntype(e))
    # (something that never comes back, as panic(...), taken as a value: done, then any
    # value of the type, never used)
    if prune(ntype(int(nodes[e].a))) == T_NEVER and t != T_NEVER:
        gen_expr(int(nodes[e].a))
        return never_value(t)
    return gen_conv(e)

gen_value_cast = (e: int) -> Val:
    t = prune(ntype(e))
    a = int(nodes[e].a)
    from = prune(ntype(a))
    val = gen_expr(a)
    if types[from].kind == .float_ and types[t].kind == .int_:
        d = vreg(VI)
        emit(.f2bits, vt_of(from), d, val.v, 0, 0, 0)
        return V(norm(d, t), false)
    if types[from].kind == .int_ and types[t].kind == .float_:
        d = vreg(vt_of(t))
        emit(.bits2f, vt_of(t), d, val.v, 0, 0, 0)
        return V(d, false)
    if is_managed(from): borrow(val, from)
    if is_managed(t): return V(val.v, true)
    if types[t].kind == .int_: return V(norm(val.v, t), false)
    return V(val.v, false)

gen_value_coalesce = (e: int) -> Val:
    t = prune(ntype(e))
    a = int(nodes[e].a)
    ot = prune(ntype(a))
    rs = new_temp(t)
    pa = place_addr(gen_place(a, false), ot)
    inner = int(types[ot].elem)
    has = opt_has(pa, inner)
    iff(has)
    if nodes[e].aux == 1:
        vv = own_at(a, V(pa, false), ot)
        store_val(ot, e_slot(rs), 0, vv.v)
    else:
        vv = own_at(a, V(opt_value(pa, inner), false), inner)
        store_val(inner, e_slot(rs), 0, vv.v)
    els()
    enter_cond()
    vb = gen_owned(int(nodes[e].b))
    store_val(t, e_slot(rs), 0, vb.v)
    leave_cond()
    endc()
    return result_from_slot(rs, t)

gen_value_array = (e: int) -> Val:
    t = prune(ntype(e))
    return gen_array(e, t)

gen_value_map_lit = (e: int) -> Val:
    t = prune(ntype(e))
    s = new_temp(t)
    d = e_slot(s)
    e_zero(d, tsize(t))
    f = int(nodes[e].sym)
    tracked = build_slot(s, t)
    if ownership_type(t): owner_register(s, t)
    loop i in [0..nkids(e)):
        p = kid(e, i)
        key = int(nodes[p].a)
        value = int(nodes[p].b)
        kv = if copy_consumes(f, 1): gen_owned(key) else: gen_borrowed(key)
        vv = if copy_consumes(f, 2): gen_owned(value) else: gen_borrowed(value)
        if copy_consumes(f, 1) and ownership_type(ntype(key)): owner_forget_slot(kv.slot)
        if copy_consumes(f, 2) and ownership_type(ntype(value)): owner_forget_slot(vv.slot)
        e_call3(lf_of_inst(f), e_slot(s), kv.v, vv.v, -1)
    if tracked: building.pop()
    return Val(e_slot(s), true, s)

gen_value_tuple = (e: int) -> Val:
    t = prune(ntype(e))
    if vc(t) == VC_VOID: return V(-1, false)
    s = new_temp(t)
    tracked = build_slot(s, t, true)
    loop i in [0..int(types[t].nargs)):
        el = targ(t, i)
        val = gen_owned(kid(e, i))
        store_val(el, e_slot(s), tuple_off(t, i), val.v)
    if tracked: building.pop()
    return Val(e_slot(s), true, s)

gen_value_range = (e: int) -> Val:
    s = new_temp(T_RANGE)
    d = e_slot(s)
    lo = 0
    if nodes[e].a != 0: lo = gen_expr(int(nodes[e].a)).v
    else: lo = e_iconst(0)
    e_store(d, 0, lo, 8)
    hi = 0
    if nodes[e].b != 0:
        hi = gen_expr(int(nodes[e].b)).v
        if has_flag(e, NF_INCLUSIVE): hi = e_addi(hi, 1)
    else: hi = e_iconst(0x7fffffffffffffff)
    e_store(d, 8, hi, 8)
    return Val(d, false, -1)

gen_value_addr = (e: int) -> Val:
    p = gen_place(int(nodes[e].a), true)
    return V(place_addr(p, ntype(int(nodes[e].a))), false)

gen_value_if_ = (e: int) -> Val:
    t = prune(ntype(e))
    return gen_if(e, t)

gen_value_iflet = (e: int) -> Val:
    t = prune(ntype(e))
    return gen_iflet(e, t)

gen_value_block = (e: int) -> Val:
    t = prune(ntype(e))
    reserve_comprehension(e)
    rs = -1
    if vc(t) != VC_VOID:
        rs = new_temp(t)
        e_zero(e_slot(rs), tsize(t))
    gen_value_block(e, rs, t)
    if rs >= 0: return result_from_slot(rs, t)
    return V(-1, false)

gen_slice_bounds = (e: int, p: int) -> (int, int):
    r = int(nodes[e].b)
    lo = 0
    if nodes[r].a != 0:
        value = gen_expr(int(nodes[r].a)).v
        lo = vreg(VI)
        e_mov(lo, value)  # the upper bound may assign the lower-bound variable
    else: lo = e_iconst(0)
    hi = 0
    if nodes[r].b != 0:
        hi = gen_expr(int(nodes[r].b)).v
        if has_flag(r, NF_INCLUSIVE): hi = e_addi(hi, 1)
    else:
        bt = prune(ntype(int(nodes[e].a)))
        hi = if types[bt].kind == .fixed: e_iconst(fixed_len(bt)) else: arr_len(p)
    (lo, hi)

gen_slice = (e: int) -> Val:
    a = int(nodes[e].a)
    bt = prune(ntype(a))
    if copies_on and copy_strict(e) and tkind(bt) != .str_ and not copy_explicit.has(e):
        copy_error(e, "an array slice duplicates its selected elements")
    # Bounds can call code that mutates or replaces the source. Keep the value
    # read before those calls alive, independently of the original variable.
    source = own(gen_expr(a), bt)
    borrow(source, bt)
    p = vreg(VI)
    e_mov(p, source.v)
    lo, hi = gen_slice_bounds(e, p)
    if types[bt].kind == .str_: return V(e_call3(rt("__str_slice"), p, lo, hi, VI), true)
    et = int(types[bt].elem)
    q = 0
    if types[bt].kind == .fixed and ownership_type(bt):
        # The ordinary helper checks bounds; resource elements then acquire
        # their live markers in the growable representation.
        raw = e_call(rt("__fixed_slice"), [p, e_iconst(fixed_len(bt)), lo, hi, e_iconst(tsize(et))], VI)
        value = owner_array_from_fixed(e_addi(raw, 24), et, e_bin(.sub, VI, hi, lo), ntype(e), true)
        e_call1(rt("__free_obj"), raw, -1)
        return value
    if types[bt].kind == .fixed:
        q = e_call(rt("__fixed_slice"), [p, e_iconst(fixed_len(bt)), lo, hi, e_iconst(tsize(et))], VI)
    else: q = e_call4(rt("__arr_slice"), p, lo, hi, e_iconst(owner_stride(et)), VI)
    if is_managed(et): retain_elems(q, et)
    V(q, true)

# a struct constructor whose arguments cannot run code (so it may be built in place)
is_plain_ctor = (e: int) -> bool:
    if refine_active and ref_storage_contract(ntype(e)): return false
    if nodes[e].kind != .call or nodes[e].aux != 2: return false
    t = prune(ntype(e))
    if types[t].kind != .struct_: return false
    loop i in [0..nkids(e)):
        a = kid(e, i)
        if a != 0 and not is_plain_expr(a): return false
        # (a value that could hold the array being pushed to is read before it grows: xs.push(S(xs)))
        if a != 0 and is_managed(ntype(a)) and types[prune(ntype(a))].kind != .str_: return false
    true

is_plain_expr = (e: int) -> bool:
    k = nodes[e].kind
    if k == .int_lit or k == .float_lit or k == .bool_lit or k == .str_lit or k == .null_lit or k == .dotname: return nodes[e].nlist == 0
    if k == .ident: return nodes[e].aux == i32(int(SK.local)) or nodes[e].aux == i32(int(SK.global)) or nodes[e].aux == i32(int(SK.const_))
    if k == .conv or k == .unary or k == .not_: return is_plain_expr(int(nodes[e].a))
    # arithmetic and reads cannot touch the array being pushed to (only calls could)
    if k == .binary or k == .and_ or k == .or_: return nodes[e].aux == 0 and is_plain_expr(int(nodes[e].a)) and is_plain_expr(int(nodes[e].b))
    if k == .field: return nodes[e].aux >= 0 and is_plain_expr(int(nodes[e].a)) and types[prune(ntype(int(nodes[e].a)))].kind == .struct_
    false

# [a, b, c], [] (zeros) or [v] * N as a fixed-size array: built in place
gen_fixed_array = (e: int, t: int) -> Val:
    et = int(types[t].elem)
    esz = tsize(et)
    n = fixed_len(t)
    s = new_temp(t)
    d = e_slot(s)
    if ownership_type(t): return gen_owner_fixed(e, t, s)
    if nodes[e].b != 0:
        if copies_on and n > 1: copy_components(e, et, "array repetition duplicates its heap-bearing element")
        val = gen_owned(kid(e, 0))
        store_val(et, d, 0, val.v)
        if n > 1:
            # the other elements are copies of the first
            i = vreg(VI)
            e_mov(i, e_iconst(1))
            blk()
            lop()
            brif_to(e_bin(.ges, VI, i, e_iconst(n)), ctl - 1)
            ea = e_bin(.add, VI, d, e_bin(.mul, VI, i, e_iconst(esz)))
            e_copy(ea, d, esz)
            if is_managed(et): copy_at(ea, et)
            e_mov(i, e_addi(i, 1))
            br_to(ctl)
            endc()
            endc()
    else if nkids(e) == 0: e_zero(d, tsize(t))
    else:
        tracked = build_slot(s, t, true)
        loop i in [0..nkids(e)):
            val = gen_owned(kid(e, i))
            store_val(et, d, i * esz, val.v)
        if tracked: building.pop()
    Val(e_slot(s), true, s)

# Completed element temporaries remain the cleanup authorities until the
# whole fixed array is constructed. Zero-filled storage is never a live owner.
gen_owner_fixed = (e: int, t: int, s: int) -> Val:
    et = telem(t)
    d = e_slot(s)
    held: int[]
    if nodes[e].b != 0:
        val = gen_owned(kid(e, 0))
        if fixed_len(t) == 0:
            drop_at(val.v, et)
        else:
            store_val(et, d, 0, val.v)
            # Copy hooks are verified no-failure, so the remaining copies
            # cannot interrupt this construction before ownership handoff.
            if fixed_len(t) > 1:
                i = fixed_loop_begin(t)
                iff(e_bin(.ne, VI, i, e_iconst(0)))
                ea = fixed_elem_addr(d, i, et)
                e_copy(ea, d, tsize(et))
                copy_at(ea, et)
                endc()
                fixed_loop_end(i)
            owner_forget_slot(val.slot)
    else:
        loop i in [0..nkids(e)):
            val = gen_owned(kid(e, i))
            store_val(et, d, i * tsize(et), val.v)
            held.push(val.slot)
            building.push(BuildItem(true, val.slot, et))
        loop slot in held:
            owner_forget_slot(slot)
            building.pop()
    Val(d, true, s)

gen_array = (e: int, t: int) -> Val:
    if types[prune(t)].kind == .fixed: return gen_fixed_array(e, prune(t))
    et = int(types[t].elem)
    esz = owner_stride(et)
    if ownership_type(t): return gen_owner_array(e, t)
    if nodes[e].b != 0:
        if copies_on: copy_components(e, et, "array repetition may duplicate its heap-bearing element")
        # fresh heap memory is zeroed, so [0; n] needs no fill loop
        z = kid(e, 0)
        if nodes[z].kind == .conv and (nodes[z].aux != i32(int(CV.refinement)) or nodes[z].ival == 1): z = int(nodes[z].a)
        zk = nodes[z].kind
        if not math_optional(prune(et)) and ((zk == .int_lit and nodes[z].ival == 0) or (zk == .bool_lit and nodes[z].ival == 0) or zk == .null_lit or (zk == .float_lit and nodes[z].fval == 0.0 and f64_bits(nodes[z].fval) == 0)):
            n = gen_expr(int(nodes[e].b)).v
            return V(e_call2(rt("__arr_repeat"), n, e_iconst(esz), VI), true)
        val = gen_owned(kid(e, 0))
        if vc(et) != VC_AGG and not is_managed(et):
            n = gen_expr(int(nodes[e].b)).v
            res = vreg(VI)
            e_mov(res, e_call2(rt("__arr_filled"), n, e_iconst(esz), VI))
            i = vreg(VI)
            e_mov(i, e_iconst(0))
            cnt = arr_len(res)
            blk()
            lop()
            brif_to(e_bin(.ges, VI, i, cnt), ctl - 1)
            store_val(et, e_bin(.add, VI, e_addi(res, 24), e_bin(.mul, VI, i, e_iconst(esz))), 0, val.v)
            e_mov(i, e_addi(i, 1))
            br_to(ctl)
            endc()
            endc()
            return V(res, true)
        vs = new_temp(et)
        va = e_slot(vs)
        store_val(et, va, 0, val.v)
        tracked = build_slot(vs, et)
        n = gen_expr(int(nodes[e].b)).v
        if tracked: building.pop()
        arr = e_call2(rt("__arr_filled"), n, e_iconst(esz), VI)
        res = vreg(VI)
        e_mov(res, arr)
        i = vreg(VI)
        e_mov(i, e_iconst(0))
        cnt = arr_len(res)
        blk()
        lop()
        brif_to(e_bin(.ges, VI, i, cnt), ctl - 1)
        ea = e_bin(.add, VI, e_addi(res, 24), e_bin(.mul, VI, i, e_iconst(esz)))
        e_copy(ea, e_slot(vs), esz)
        if is_managed(et): copy_at(ea, et)
        e_mov(i, e_addi(i, 1))
        br_to(ctl)
        endc()
        endc()
        drop_at(e_slot(vs), et)
        return V(res, true)
    n = nkids(e)
    if n == 0: return V(e_iconst(0), true)
    if all_const(e, et):
        # immutable static array: lives in rodata, copied on first write
        return V(e_daddr(const_array(e, et)), false)
    arr = e_call2(rt("__arr_filled"), e_iconst(n), e_iconst(esz), VI)
    init = -1
    if is_managed(et): init = ir.code.len() - 1
    res = vreg(VI)
    e_mov(res, arr)
    building.push(BuildItem(false, res, t, init))
    loop i in [0..n):
        val = gen_owned(kid(e, i))
        store_val(et, res, 24 + i * esz, val.v)
    building.pop()
    V(res, true)

all_const = (e: int, et: int) -> bool:
    k = types[quantity_base(et)].kind
    if k != .int_ and k != .float_ and k != .bool_: return false
    loop i in [0..nkids(e)):
        item = kid(e, i)
        if quantity_base(et) == T_MATH_INT and (has_flag(item, NF_U64) or nodes[item].ival < -4611686018427387904 or nodes[item].ival > 4611686018427387903): return false
        ck = nodes[item].kind
        if ck != .int_lit and ck != .float_lit and ck != .bool_lit: return false
    true

const_array = (e: int, et: int) -> int:
    loop rodata.len() % 8 != 0: rodata.push(0)
    o = rodata.len()
    ro_starts.push(o)
    n = nkids(e)
    sz = tsize(et)
    push_i64(rodata, -1)
    push_i64(rodata, n)
    push_i64(rodata, n)
    loop i in [0..n):
        c = kid(e, i)
        bits = 0
        if nodes[c].kind == .float_lit:
            if sz == 4: bits = int(f32_bits(f32(nodes[c].fval)))
            else: bits = int(f64_bits(nodes[c].fval))
        else:
            bits = nodes[c].ival
            if quantity_base(et) == T_MATH_INT: bits = bits << 1
        loop b in [0..sz): rodata.push(if b >= 8: u8(0) else: u8((bits >> (8 * b)) & 255))
    if fused_on: fz_note_raw(o, 8)
    o

# ---------------- conditions as branches ----------------
# A constant interval test on the same ordinary integer read needs one
# unsigned comparison: low <= x <= high is (u64(x) - u64(low)) <= u64(high-low).
# The subtraction wraps, so negative values and intervals crossing zero work.
# Two ordinary reads with no intervening user code. Keep this deliberately
# shallow: array loads use a local receiver and a local/literal index, and no
# raw pointers, deferred aliases or mutable parameters are admitted.
same_range_local = (a: int, b: int) -> bool:
    if nodes[a].kind != .ident or nodes[b].kind != .ident: return false
    if nodes[a].aux != i32(int(SK.local)) or not same_var(a, b): return false
    int(locals[int(nodes[a].sym)].flags) & (LF_ALIAS | LF_MUTPARAM) == 0

same_range_read = (a: int, b: int) -> bool:
    if same_range_local(a, b): return true
    if nodes[a].kind != .index or nodes[b].kind != .index or nodes[a].aux != 0 or nodes[b].aux != 0: return false
    x = int(nodes[a].a)
    y = int(nodes[b].a)
    if not same_range_local(x, y): return false
    kind = tkind(ntype(x))
    if kind != .array and kind != .fixed: return false
    i = int(nodes[a].b)
    j = int(nodes[b].b)
    if i == 0 or j == 0: return false
    if same_range_local(i, j): return true
    nodes[i].kind == .int_lit and nodes[j].kind == .int_lit and nodes[i].ival == nodes[j].ival

range_cmp = (e: int) -> (int, Tok, int):
    if nodes[e].kind != .binary or nodes[e].aux != 0: return (0, .eq, 0)
    op = nodes[e].op as Tok
    if op != .lt and op != .le and op != .gt and op != .ge: return (0, .eq, 0)
    a = int(nodes[e].a)
    b = int(nodes[e].b)
    if nodes[a].kind == .int_lit:
        tmp = a
        a = b
        b = tmp
        op = if op == .lt: .gt else if op == .le: .ge else if op == .gt: .lt else: .le
    if nodes[b].kind != .int_lit: return (0, .eq, 0)
    at = prune(ntype(a))
    bt = prune(ntype(b))
    if not is_int(at) or not is_int(bt) or at == T_U64 or bt == T_U64: return (0, .eq, 0)
    if not same_range_read(a, a): return (0, .eq, 0)
    (a, op, nodes[b].ival)

# Recognize the adjacent comparisons at the end of a guarded chain without
# evaluating their array read before the guard: (guard and low) and high becomes
# guard and (low and high). The same grouping preserves ordered `or` evaluation.
range_tail = (e: int) -> int:
    k = nodes[e].kind
    if k != .and_ and k != .or_: return e
    left = int(nodes[e].a)
    right = int(nodes[e].b)
    if nodes[left].kind != k or nodes[right].kind != .binary: return e
    a = range_cmp(int(nodes[left].b))
    if a.0 == 0: return e
    b = range_cmp(right)
    if b.0 == 0 or not same_range_read(a.0, b.0): return e
    pair = nodes.len()
    nodes.push(nodes[e])
    nodes[pair].a = nodes[left].b
    head = nodes.len()
    nodes.push(nodes[e])
    nodes[head].a = nodes[left].a
    nodes[head].b = i32(pair)
    head

gen_range_cond = (e: int, invert: bool = false) -> int:
    k = nodes[e].kind
    if k != .and_ and k != .or_: return -1
    a = range_cmp(int(nodes[e].a))
    if a.0 == 0: return -1
    b = range_cmp(int(nodes[e].b))
    if b.0 == 0 or not same_range_read(a.0, b.0): return -1
    first_read = a.0
    if prune(ntype(first_read)) == T_MATH_INT: return -1
    if k == .or_:
        a.1 = if a.1 == .lt: .ge else if a.1 == .le: .gt else if a.1 == .gt: .le else: .lt
        b.1 = if b.1 == .lt: .ge else if b.1 == .le: .gt else if b.1 == .gt: .le else: .lt
    if a.1 == .lt or a.1 == .le:
        tmp = a
        a = b
        b = tmp
    if (a.1 != .gt and a.1 != .ge) or (b.1 != .lt and b.1 != .le): return -1
    low = a.2
    high = b.2
    empty = false
    if a.1 == .gt:
        if low == 9223372036854775807: empty = true
        else: low += 1
    if b.1 == .lt:
        if high == -9223372036854775807 - 1: empty = true
        else: high -= 1
    outside = (k == .or_) != invert
    # Even an empty interval must evaluate its first read and retain bounds checks.
    value = gen_expr(first_read).v
    if empty or low > high: return e_iconst((if outside: 1 else: 0))
    if low != 0: value = e_bin(.sub, VI, value, e_iconst(low))
    op = if outside: Op.gtu else: Op.leu
    e_bin(op, VI, value, e_iconst(high - low))

# `and` / `or` / `not` in if/while conditions become jumps instead of boolean values.
# Each leaf is its own small statement, so its temporaries are dropped before branching.
cond_leaf = (e: int) -> int:
    stmt_begin()
    c = gen_expr(e).v
    if tl_values.len() == tl_items[tl_items.len() - 1]:
        stmt_end()
        return c
    cv = vreg(VI)
    e_mov(cv, c)
    stmt_end()
    cv

negate_cmp = (op: Op) -> Op:
    match op:
        eq: .ne
        ne: .eq
        lts: .ges
        les: .gts
        gts: .les
        ges: .lts
        ltu: .geu
        leu: .gtu
        gtu: .leu
        geu: .ltu
        _: .nop

# continue when e is true, branch to `level` when it is false
jump_if_false = (e: int, level: int):
    chain = range_tail(e)
    if chain != e:
        jump_if_false(chain, level)
        return
    k = nodes[e].kind
    range = gen_range_cond(e, true)
    if range >= 0:
        brif_to(range, level)
        return
    if k == .and_:
        jump_if_false(int(nodes[e].a), level)
        jump_if_false(int(nodes[e].b), level)
        return
    if k == .or_:
        blk()
        t = ctl
        jump_if_true(int(nodes[e].a), t)
        jump_if_false(int(nodes[e].b), level)
        endc()
        return
    if k == .not_:
        jump_if_true(int(nodes[e].a), level)
        return
    start = ir.code.len()
    c = cond_leaf(e)
    last = ir.code.len() - 1
    if last >= start and int(ir.code[last].dst) == c and negate_cmp(ir.code[last].op) != .nop:
        # flip an integer comparison so the branch can use it directly
        ir.code[last].op = negate_cmp(ir.code[last].op)
        brif_to(c, level)
        return
    brif_to(e_bin(.eq, VI, c, e_iconst(0)), level)

# continue when e is false, branch to `level` when it is true
jump_if_true = (e: int, level: int):
    chain = range_tail(e)
    if chain != e:
        jump_if_true(chain, level)
        return
    k = nodes[e].kind
    range = gen_range_cond(e)
    if range >= 0:
        brif_to(range, level)
        return
    if k == .or_:
        jump_if_true(int(nodes[e].a), level)
        jump_if_true(int(nodes[e].b), level)
        return
    if k == .and_:
        blk()
        f = ctl
        jump_if_false(int(nodes[e].a), f)
        jump_if_true(int(nodes[e].b), level)
        endc()
        return
    if k == .not_:
        jump_if_false(int(nodes[e].a), level)
        return
    brif_to(cond_leaf(e), level)

gen_if = (e: int, t: int) -> Val:
    val = vc(t) != VC_VOID and t != T_NEVER and not has_flag(e, NF_STMT)
    has_else = nodes[e].c != 0
    rs = -1
    rv = -1
    if val:
        # Scalar results need no address. Keep the join value in a vreg so
        # each loop iteration does not spill an expression to a stack slot.
        if vc(t) != VC_AGG and not is_managed(t):
            rv = vreg(vt_of(t))
            # Two value arms overwrite the result on every returning path.
            # Leaving out the dead initial write also lets a later scalar
            # selection become a single definition after branch folding.
            if not has_else or nodes[int(nodes[e].b)].aux == 0 or nodes[int(nodes[e].c)].aux == 0: e_mov(rv, zero_val(t))
        else:
            rs = new_temp(t)
            e_zero(e_slot(rs), tsize(t))
    blk()
    end_level = ctl
    if has_else: blk()
    else_level = ctl
    jump_if_false(int(nodes[e].a), else_level)
    enter_cond()
    guard = if eg_active: eg_begin(int(nodes[e].a), true) else: 0
    if val: gen_value_block(int(nodes[e].b), rs, t, rv)
    else:
        scope_push()
        gen_block_stmts(int(nodes[e].b))
        scope_pop()
    if eg_active: eg_end(guard)
    if has_else:
        guard = if eg_active: eg_begin(int(nodes[e].a), false) else: 0
        br_to(end_level)
        endc()
        if val: gen_value_block(int(nodes[e].c), rs, t, rv)
        else:
            scope_push()
            gen_block_stmts(int(nodes[e].c))
            scope_pop()
    if has_else and eg_active: eg_end(guard)
    leave_cond()
    endc()
    if rv >= 0: return V(rv, false)
    if val: return result_from_slot(rs, t)
    V(-1, false)

gen_iflet = (e: int, t: int) -> Val:
    val = vc(t) != VC_VOID and t != T_NEVER and not has_flag(e, NF_STMT)
    rs = -1
    if val:
        rs = new_temp(t)
        e_zero(e_slot(rs), tsize(t))
    l = int(nodes[e].sym)
    a = int(nodes[e].a)
    ot = prune(ntype(a))
    inner = int(types[ot].elem)
    scope_push()
    has = vreg(VI)
    if held_views.contains(l):
        pa = gen_place(a, false).v
        e_mov(int(locals[l].vreg), held_encode_addr(pa, inner))
        e_mov(has, opt_has(pa, inner))
    else:
        stmt_begin()
        # Move an owned optional's value into the local, without another copy.
        ov = gen_owned(a)
        pa = ov.v
        if math_optional(ot):
            pa = e_slot(new_temp(ot))
            e_store(pa, 0, ov.v, 8)
        e_mov(has, opt_has(pa, inner))
        iff(has)
        write_place(local_place(l, true), inner, opt_value(pa, inner))
        endc()
        stmt_end()
        scope_add_local(l)
    iff(has)
    enter_cond()
    if val: gen_value_block(int(nodes[e].b), rs, t)
    else:
        scope_push()
        gen_block_stmts(int(nodes[e].b))
        scope_pop()
    if nodes[e].c != 0:
        els()
        if val: gen_value_block(int(nodes[e].c), rs, t)
        else:
            scope_push()
            gen_block_stmts(int(nodes[e].c))
            scope_pop()
    leave_cond()
    endc()
    scope_pop()
    if val: return result_from_slot(rs, t)
    V(-1, false)

# ---------------- statements ----------------
gen_return = (s: int):
    rtp = prune(cur_ret)
    a = int(nodes[s].a)
    rv = -1
    owner_result = -1
    if a != 0 and vc(rtp) != VC_VOID:
        stmt_begin()
        if ownership_decls.len() != 0 and (ownership_hooks.get(int(fns[cur_fn].decl)) ?? 0) > 1:
            owner_adopt_result(a)
        val = gen_owned(a)
        if ownership_type(rtp): owner_result = val.slot
        if vc(rtp) == VC_AGG: store_val(rtp, sret_v, 0, val.v)
        else:
            rv = vreg(vt_of(rtp))
            e_mov(rv, val.v)
        stmt_end()
    else if a != 0:
        stmt_begin()
        val = gen_expr(a)
        borrow(val, ntype(a))
        stmt_end()
    drop_held(0, 0)
    i = scope_locals.len() - 1
    loop i >= 0:
        emit_scope_exit(i)
        i -= 1
    if owner_result >= 0: owner_forget_slot(owner_result)
    if vc(rtp) == VC_AGG: e_ret(sret_v)
    else: e_ret(rv)

assign_to = (target: int, t: int, v: int):
    if nodes[target].kind == .field and nodes[target].aux == -4 and not swizzle_run(target):
        # v.zx = w: each component where it goes
        a = int(nodes[target].a)
        bt = ntype(a)
        ty = VS
        mode = 4 | M_FLOAT
        if types[prune(bt)].sign:
            ty = VI
            mode = 4 | M_SIGNED
        pa = place_addr(gen_place(a, true), bt)
        nm = name_of(int(nodes[target].name))
        loop i in [0..len(nm)): e_store(pa, 4 * swizzle_index(nm[i]), e_load(ty, v, 4 * i, mode), mode)
        return
    f = boxed_field_of(target)
    if f >= 0:
        # (a boxed field given a value: a new box, and the old one released)
        box_slot = true
        sa = gen_place(target, true).v
        old = e_load(VI, sa, 0, ptr_size)
        box_put(sa, t, v)
        release(old, mk_box(int(fields[f].type)))
        return
    pl = gen_place(target, true)
    element = nodes[target].kind == .index and tkind(ntype(int(nodes[target].a))) == .array and ownership_type(t)
    if element:
        owner_element_drop(pl.v, t)
    else if is_managed(t):
        if pl.math_opt: release(read_place(pl, t), t)
        else if pl.mem: drop_at(pl.v, t)
        else: release(pl.v, t)
    write_place(pl, t, v)
    if ownership_type(t):
        owner_forget(v)
        if element: owner_element_live(pl.v, t)
        else: owner_register(owner_address_slot(pl.v), t)

gen_assign = (s: int):
    a = int(nodes[s].a)
    t = quantity_base(ntype(a))
    aux = int(nodes[s].aux)
    if t == T_MATH_INT and math_local_is(a, int(nodes[a].sym)):
        if let word = math_word_regs.get(int(nodes[a].sym)):
            e_mov(word, math_word_expr(int(nodes[s].b)))
            return
    if aux == 1:
        tt = prune(ntype(int(nodes[s].b)))
        val = gen_owned(int(nodes[s].b))
        loop i in [0..int(types[tt].nargs)):
            el = targ(tt, i)
            tg = kid(a, i)
            ea = e_addi(val.v, tuple_off(tt, i))
            if nodes[tg].kind == .hole: drop_at(ea, el)
            else: assign_to(tg, el, load_val(el, ea, 0))
        return
    if aux == 2:
        v = gen_borrowed(int(nodes[s].b)).v
        pl = gen_place(a, true)
        sa = place_addr(pl, t)
        e_call2(rt("__str_append"), sa, v, -1)
        if not pl.mem: e_mov(pl.v, e_load(VI, sa, 0, ptr_size))
        return
    if aux == 3:
        d = e_bin(.mul, VI, gen_expr(int(nodes[s].b)).v, e_iconst(tsize(int(types[t].elem))))
        pl = gen_place(a, true)
        cur = read_place(pl, t)
        if nodes[s].op == i32(int(Tok.pluseq)): write_place(pl, t, e_bin(.add, VI, cur, d))
        else: write_place(pl, t, e_bin(.sub, VI, cur, d))
        return
    if nodes[s].op == i32(int(Tok.assign)):
        rhs = int(nodes[s].b)
        if ownership_type(t) and nodes[rhs].kind == .intrinsic and nodes[rhs].aux == i32(int(IN.zeroed)):
            pl = gen_place(a, true)
            owner_element_drop(pl.v, t)
            e_zero(pl.v, owner_stride(t))
            return
        if nodes[a].kind == .ident and nodes[a].aux == i32(int(SK.local)) and held_views.contains(int(nodes[a].sym)):
            # (a held view given another part: its address)
            e_mov(int(locals[int(nodes[a].sym)].vreg), held_value_addr(int(nodes[s].b)))
            return
        # (Dewy's xs[f()] = g(): the destination's indices first, then the right side, which may
        # change them or resize the array; the destination is located again with the indices kept)
        held: int[]
        if (nodes[a].kind == .index or nodes[a].kind == .field) and dewy_at(nodes[s].pos) and assign_rhs_effects(rhs):
            x = a
            steps: int[]
            loop true:
                xk = nodes[x].kind
                if xk == .index and nodes[x].b != 0 and not index_stable(int(nodes[x].b), rhs): steps.insert(0, int(nodes[x].b))
                if xk == .field or xk == .index or xk == .unwrap or xk == .narrow: x = int(nodes[x].a)
                else: break
            loop ib in steps:
                if frozen.has(ib): continue
                frozen[ib] = freeze_scalar(gen_index(ib), ntype(ib))
                held.push(ib)
        val = gen_owned(rhs)
        assign_to(a, t, val.v)
        loop ib in held: frozen.remove(ib)
        return
    # compound arithmetic
    op = compound_op(int(nodes[s].op)) as Tok
    pl = gen_place(a, true)
    cur = read_place(pl, t)
    if t == T_MATH_INT:
        value = V(0, false)
        if op == .shl or op == .shr: value = math_shift(op, cur, math_shift_count(int(nodes[s].b)), types[prune(ntype(int(nodes[s].b)))].sign)
        else: value = math_binary(op, cur, gen_borrowed(int(nodes[s].b)).v)
        release(cur, t)
        write_place(pl, t, value.v)
        return
    rhs = gen_expr(int(nodes[s].b)).v
    r = 0
    if is_vec(t):
        ice("compound assignment on vectors should be desugared")
    if vc(t) == VC_FLT and op == .percent:
        # (x - y * trunc(x / y): the dividend's sign, as % does)
        ty = vt_of(t)
        q = e_un(.ftrunc, ty, e_bin(.fdiv, ty, cur, rhs))
        r = e_bin(.fsub, ty, cur, e_bin(.fmul, ty, q, rhs))
    else if vc(t) == VC_FLT:
        r = e_bin(float_op(op), vt_of(t), cur, rhs)
        if ff_checks_any: float_check(s, r, t)
    else:
        sg = types[t].kind == .int_ and types[t].sign
        if op == .slash or op == .percent:
            iff(e_bin(.eq, VI, rhs, e_iconst(0)))
            e_call_nr1(rt("__div_zero"), e_daddr(loc_data(nodes[s].pos)), -1)
            endc()
        if int_policy(t) == 2 and op == .shl: r = saturate_shift(t, cur, rhs)
        else if int_policy(t) == 2 and (op == .plus or op == .minus or op == .star): r = saturate_binary(op, t, cur, rhs)
        else if types[t].kind == .bool_: r = e_bin(int_op(op, false), VI, cur, rhs)
        else if sg and (op == .slash or op == .percent): r = sdiv_wrap(op, cur, rhs, t)
        else if (op == .shl or op == .shr) and dewy_at(nodes[s].pos): r = wide_shift(op, sg, cur, rhs, int(nodes[s].b))
        else: r = e_bin(int_op(op, sg), VI, cur, rhs)
    if int_policy(t) == 1: r = norm(r, t)
    write_place(pl, t, r)

gen_vardecl = (s: int):
    if nodes[s].nlist > 0:
        tt = prune(ntype(int(nodes[s].b)))
        val = gen_owned(int(nodes[s].b))
        loop i in [0..int(types[tt].nargs)):
            el = targ(tt, i)
            id = kid(s, i)
            ea = e_addi(val.v, tuple_off(tt, i))
            if nodes[id].kind == .hole: drop_at(ea, el)
            else if has_flag(id, NF_GLOBAL):
                g = int(nodes[id].sym)
                store_val(el, e_gaddr(global_addr_off(g)), 0, load_val(el, ea, 0))
            else:
                l = int(nodes[id].sym)
                if is_shared(l): new_cell(l)
                write_place(local_place(l, true), el, load_val(el, ea, 0))
                scope_add_local(l)
        return
    if has_flag(s, NF_GLOBAL):
        g = int(nodes[s].sym)
        iv = int(nodes[s].b)
        if iv == 0: return
        if copies_on and copy_shared_global(s, g): return
        # (also `x = 0`: globals start as zero, but a function called above could have changed it)
        val = gen_owned(iv)
        store_val(int(globals[g].type), e_gaddr(global_addr_off(g)), 0, val.v)
        return
    l = int(nodes[s].sym)
    t = int(locals[l].type)
    if partition_mode and nodes[s].aux2 == 1 and partition_descs.has(l): return
    if parallel_scalar_decl(s, l): return
    if copies_on and copy_bindings.has(l) and nodes[s].aux2 == 1:
        write_place(local_place(l, true), t, gen_expr(int(nodes[s].b)).v)
        scope_add_local(l)
        return
    if nodes[s].aux2 == 1 and int(locals[l].flags) & LF_PARAM != 0: return
    if held_views.contains(l):
        e_mov(int(locals[l].vreg), held_value_addr(int(nodes[s].b)))
        return
    if copies_on and copy_shared_decl(s, l): return
    if view_decl(s, l): return
    if math_word_local_decl(s): return
    if exact_lower_active: exact_counter_bound(s)
    if is_shared(l): new_cell(l)
    pl = local_place(l, true)
    if nodes[s].b != 0:
        iv = int(nodes[s].b)
        a = fixed_array_len(iv)
        if a >= 0 and int(locals[l].flags) & LF_ASSIGNED == 0: len_of_local[l] = a
        # A := [x; E]: A's length is E for as long as A is not resized
        if nodes[iv].kind == .array and nodes[iv].b != 0 and fixed_array_local(l): array_len_expr[l] = int(nodes[iv].b)
        stack = nodes[iv].kind == .lambda and files[pos_file(nodes[s].pos)].is_dewy and stack_closure_local(l)
        if stack and stack_closure_passed.has(l):
            stack = not has_flag(iv, NF_GENERIC) and closure_env_shareable(int(nodes[iv].sym))
        if stack: stack_closure_targets[l] = if has_flag(iv, NF_GENERIC): poly_families[int(nodes[iv].aux)].envfn else: int(nodes[iv].sym)
        val = if stack: gen_lambda(iv, true) else: gen_owned(iv)
        if stack: locals[l].offset = i32(val.slot)
        else: write_place(pl, t, val.v)
        if ownership_type(t): owner_forget_slot(val.slot)
    else:
        if pl.mem: e_zero(pl.v, tsize(t))
        else: e_mov(pl.v, zero_val(t))
    scope_add_local(l)

# Dewy gives each value parameter a same-named mutable local. When that local
# stays read-only, it can use the borrowed parameter storage instead of copying
# and retaining it again. Calls already preserve borrowed parameter snapshots.
# The checker records writes and raw exposures when checking those operations;
# captures, address-taking and buffer access retain their owned local storage.
param_view_decl = (s: int, l: int) -> bool:
    if (dbg_on and (not copies_on or not copy_strict(s))) or nodes[s].aux2 != 1: return false
    if copies_on and copy_bindings.has(l): return false
    fl = int(locals[l].flags)
    if fl & (LF_ASSIGNED | LF_ADDR | LF_CAPTURE | LF_CAPTURED | LF_BYREF | LF_ALIAS | LF_PARAM) != 0 or is_shared(l): return false
    # (exposed only by pointers read through, it can read the parameter's storage)
    if fl & LF_EXPOSED != 0:
        ptr_reads(cur_fn)
        if pr_exposed.has(l): return false
    # Most local initializers are not the parameter binding introduced by the
    # frontend. Reject their shape before asking about layouts or closure types.
    iv = int(nodes[s].b)
    if iv == 0 or nodes[iv].kind != .ident or nodes[iv].aux != i32(int(SK.local)): return false
    source = int(nodes[iv].sym)
    flags = int(locals[source].flags)
    if flags & LF_PARAM == 0 or flags & (LF_MUTPARAM | LF_ADDR | LF_CAPTURE | LF_CAPTURED) != 0: return false
    if locals[source].owner != i32(cur_fn) or locals[source].name != locals[l].name: return false
    t = prune(int(locals[l].type))
    if not is_managed(t) and vc(t) != VC_AGG: return false
    if (type_has_fn(t) and callback_local(l) < 0) or not type_eq(ntype(iv), t): return false
    # Treat this binding as another read-only view of the parameter. It owns
    # no reference and must not be dropped as a separately initialized local.
    locals[l].vreg = locals[source].vreg
    locals[l].offset = locals[source].offset
    locals[l].flags = i32(fl | LF_PARAM)
    true

# ---------------- views ----------------
# `b = agents[j]` copies a struct out of an array (and retains what it holds), but when b is
# only read, and nothing can change agents while b is used, b can be the element itself: a
# pointer into the array, with no copy and no reference counting (release builds).
cur_block = 0                  # the block whose statement is being lowered, and its index
cur_block_i = 0

view_decl = (s: int, l: int) -> bool:
    if copies_on and copy_strict(s): return false
    if not opt_release or cur_block == 0 or kid(cur_block, cur_block_i) != s: return false
    fl = int(locals[l].flags)
    if fl & (LF_ASSIGNED | LF_ADDR | LF_CAPTURE | LF_CAPTURED | LF_BYREF | LF_ALIAS | LF_PARAM | LF_EXPOSED) != 0 or is_shared(l): return false
    t = prune(int(locals[l].type))
    if types[t].kind != .struct_ and types[t].kind != .tuple and types[t].kind != .array: return false
    if type_has_fn(t) or ownership_type(t): return false
    iv = int(nodes[s].b)
    if iv == 0: return false
    # the element of an array reached by a path (xs[i], w.xs[i], xs[i].part)
    e = iv
    loop nodes[e].kind == .field and nodes[e].aux >= 0: e = int(nodes[e].a)
    if nodes[e].kind != .index or nodes[e].aux != 0: return false
    base = int(nodes[e].a)
    if lpath_key(base) == 0 or tkind(ntype(base)) != .array: return false
    rn = lpath_root(base)
    root_global = nodes[rn].aux == i32(int(SK.global))
    r = int(nodes[rn].sym)
    if not root_global:
        rf = int(locals[r].flags)
        if rf & (LF_ALIAS | LF_CAPTURE | LF_BYREF) != 0 or is_shared(r): return false
    # the statements that use b: nothing in them may change the root variable
    last = -1
    loop i in [cur_block_i + 1..nkids(cur_block)):
        if mentions_local(kid(cur_block, i), l): last = i
    loop i in [cur_block_i + 1..last + 1):
        if may_write_root(kid(cur_block, i), rn): return false
    # b is the element's address
    p = gen_place(iv, false)
    if not p.mem: return false
    v = vreg(VI)
    # Array values are one pointer. Cache that pointer, rather than an
    # address into the parent; ordinary array loop hoisting then still works.
    # The root remains alive and unchanged through the last use proved above.
    array = types[t].kind == .array
    e_mov(v, if array: read_place(p, t) else: p.v)
    locals[l].vreg = i32(v)
    locals[l].flags = i32(fl | LF_ELEMENTVIEW | (if array: 0 else: LF_BYREF))
    true

# Only direct reads: custom getters, calls, conversions and computed indexes
# outside this whitelist stay on the ordinary snapshot path. Alias identifiers
# can expand into expressions, so do not assume that reading them is inert.
plain_read = (n: int) -> bool:
    if n <= 0: return false
    k = nodes[n].kind
    if k == .int_lit or k == .str_lit: return true
    if k == .ident:
        if nodes[n].aux == i32(int(SK.global)): return true
        if nodes[n].aux == i32(int(SK.local)): return int(locals[int(nodes[n].sym)].flags) & LF_ALIAS == 0
        return false
    if k == .field:
        a = int(nodes[n].a)
        return nodes[n].aux >= 0 and tkind(ntype(a)) == .struct_ and plain_read(a)
    if k == .index:
        a = int(nodes[n].a)
        kind = tkind(ntype(a))
        return (kind == .array or kind == .fixed) and plain_read(a) and plain_read(int(nodes[n].b))
    false

# A walk down a tree, `cur = n` and then `loop let c = cur: cur = c.left`, or a match on a
# parameter, `match e: .bin(op, l, r): ...`, would copy each node it passes into a variable (and
# retain what the node holds, to release it after). What a parameter holds stays as it is for the
# whole call: the function cannot change it, and a caller gives a copy of what the call could
# change (borrow_may_change). So a variable only ever given parts of a parameter (through fields,
# boxed ones too, `!` and narrowing), or parts of other such variables, and never changed through,
# can be the address of the part: no copy and no reference counting (release builds, and
# recursive records in default builds). These
# held views are plain variables (given another part by assignment), the names of `if let` and
# `loop let`, and the value a match or a variant `if let` / `loop let` looks at, whose names stand
# for its fields.
const LF_HELDVIEW = 2097152    # lowering-only; reset before a repeated lowering
const LF_ELEMENTVIEW = 4194304 # array element address, protected through its last use
held_views: {int: bool}         # the held views of the function being lowered
hv_given: (int, int)[]          # (finding them) each variable and a value it is given
hv_cand: {int: bool}            # ... the variables given values
hv_bad: {int: bool}             # ... those that cannot be views
hv_lambda = false               # ... a closure is made (none then: it may change what it captures)

# Optional held views use null for none, otherwise an address biased by BOX_HDR.
# A recursive optional field already stores exactly that pointer, so advancing
# a read-only cursor becomes one pointer load. Its presence check needs no tag
# load or default-address selection. Only general value reads materialize the
# ordinary optional address; this representation never escapes the function.
held_opt_reg = (e: int) -> int:
    if held_views.len() == 0 or nodes[e].kind != .ident or nodes[e].aux != i32(int(SK.local)): return -1
    l = int(nodes[e].sym)
    if int(locals[l].flags) & LF_HELDVIEW == 0 or tkind(int(locals[l].type)) != .opt: return -1
    int(locals[l].vreg)

held_encode_addr = (addr: int, t: int) -> int:
    if tkind(t) != .opt: return addr
    value = e_addi(addr, 0 - BOX_HDR)
    has = opt_has(addr, telem(t))
    result = vreg(VI)
    emit(.select, VI, result, has, value, e_iconst(0), 0)
    result

held_value_addr = (e: int) -> int:
    t = ntype(e)
    if tkind(t) == .opt:
        view = held_opt_reg(e)
        if view >= 0: return view
        if boxed_field_of(e) >= 0:
            box_slot = true
            slot = gen_place(e, false).v
            return e_load(VI, slot, 0, ptr_size)
    held_encode_addr(gen_place(e, false).v, t)

find_views = (f: int):
    held_views = {}
    loop l in fns[f].locals:
        if int(locals[l].flags) & (LF_HELDVIEW | LF_ELEMENTVIEW) != 0: locals[l].flags &= i32(~(LF_HELDVIEW | LF_ELEMENTVIEW | LF_BYREF))
    hv_bad = {}
    # (what C gives a function it calls is C's, which may change it meanwhile)
    if dbg_on or fns[f].body == 0 or fns[f].cabi or (copies_on and copy_strict(int(fns[f].body))): return
    rooted = false
    loop l in fns[f].params:
        # Recursive walks need this even in the fast development mode. Other
        # managed aggregates retain release-only analysis; their layout flag
        # lets default builds skip scanning unrelated function bodies.
        if opt_release or int(types[prune(int(locals[l].type))].flags) & TF_BOXED != 0:
            if hv_root(l): rooted = true
    if not rooted: return
    hv_given = []
    hv_cand = {}
    hv_bad = {}
    hv_lambda = false
    hv_scan(int(fns[f].body))
    if hv_lambda or hv_given.len() == 0: return
    # (assumed views until a value given cannot be one: what is left gives each other only parts)
    changed = true
    loop changed:
        changed = false
        loop g in hv_given:
            if not hv_bad.contains(g.0) and not hv_part(g.1):
                hv_bad[g.0] = true
                changed = true
    loop l in hv_cand.keys():
        if hv_bad.contains(l): continue
        held_views[l] = true
        locals[l].flags = i32(int(locals[l].flags) | LF_BYREF | LF_HELDVIEW)

# a parameter whose parts can be views: a value in memory the function cannot change
hv_root = (l: int) -> bool:
    if copy_inputs.has(l): return false
    fl = int(locals[l].flags)
    fl & (LF_MUTPARAM | LF_CAPTURE | LF_CAPTURED | LF_ASSIGNED | LF_ADDR | LF_EXPOSED | LF_SHARED) == 0 and vc(int(locals[l].type)) == VC_AGG and is_managed(int(locals[l].type)) and not type_has_fn(int(locals[l].type))

hv_give = (l: int, v: int):
    if ownership_type(int(locals[l].type)):
        hv_bad[l] = true
        return
    fl = int(locals[l].flags)
    # (a match's own variable is LF_ADDR: the match reads it in memory)
    ok = v != 0 and fl & (LF_CAPTURE | LF_CAPTURED | LF_BYREF | LF_ALIAS | LF_PARAM | LF_EXPOSED) == 0 and (fl & LF_ADDR == 0 or locals[l].name == 0)
    if not ok or is_shared(l) or not is_managed(int(locals[l].type)) or type_has_fn(int(locals[l].type)):
        hv_bad[l] = true
        return
    hv_given.push((l, v))
    hv_cand[l] = true

# place p is written: what it is in cannot be a view
hv_spoil = (p: int):
    r = place_var(p)
    if r != 0 and nodes[r].aux == i32(int(SK.local)): hv_bad[int(nodes[r].sym)] = true

hv_scan = (n: int):
    if n <= 0: return
    k = nodes[n].kind
    if k == .lambda:
        hv_lambda = true
        return
    if k == .vardecl:
        if nodes[n].nlist > 0:
            loop i in [0..nkids(n)): hv_spoil(kid(n, i))
        else if not has_flag(n, NF_GLOBAL):
            l = int(nodes[n].sym)
            # param_view_decl already proved this synthetic Dewy binding is
            # the borrowed parameter itself. It is a root, not a candidate
            # local whose LF_PARAM flag would disqualify every walk from it.
            if nodes[n].aux2 != 1 or int(locals[l].flags) & LF_PARAM == 0: hv_give(l, int(nodes[n].b))
    else if k == .iflet or k == .match_ or (k == .while_ and nodes[n].aux == 1): hv_give(int(nodes[n].sym), int(nodes[n].a))
    else if k == .assign:
        a = int(nodes[n].a)
        if nodes[n].aux == 1:
            loop i in [0..nkids(a)): hv_spoil(kid(a, i))
        else if nodes[n].aux == 0 and nodes[n].op == i32(int(Tok.assign)) and nodes[a].kind == .ident and nodes[a].aux == i32(int(SK.local)) and int(locals[int(nodes[a].sym)].flags) & LF_ALIAS == 0: hv_give(int(nodes[a].sym), int(nodes[n].b))
        else: hv_spoil(a)
    else if k == .intrinsic and nkids(n) > 0:
        id = nodes[n].aux as IN
        if id == .push or id == .pop or id == .insert or id == .remove or id == .clear or id == .reserve or id == .resize or id == .truncate or id == .setlen or id == .extend or id == .arrdata: hv_spoil(kid(n, 0))
    else if k == .addr or (k == .cast or k == .conv) and raw_view(n): hv_spoil(int(nodes[n].a))
    else if k == .for_ and has_flag(n, NF_MUT): hv_spoil(int(nodes[n].a))
    fs = [int(nodes[n].a), int(nodes[n].b), int(nodes[n].c), int(nodes[n].d)]
    if k == .for_: fs = [int(nodes[n].a), int(nodes[n].b)]
    loop c in fs: hv_scan(c)
    loop i in [0..nkids(n)):
        c = kid(n, i)
        if has_flag(c, NF_MUT): hv_spoil(c)
        hv_scan(c)
    loop i in [0..nkids2(n)): hv_scan(kid2(n, i))

# is p a part of a parameter or of a view (as views are assumed so far)?
hv_part = (p: int) -> bool:
    k = nodes[p].kind
    if k == .ident:
        if nodes[p].aux != i32(int(SK.local)): return false
        l = int(nodes[p].sym)
        fl = int(locals[l].flags)
        if fl & LF_ALIAS != 0: return locals[l].alias != 0 and hv_part(int(locals[l].alias))
        if fl & LF_PARAM != 0: return not hv_bad.contains(l) and hv_root(l)
        return hv_cand.contains(l) and not hv_bad.contains(l)
    if k == .field:
        a = int(nodes[p].a)
        tk = tkind(ntype(a))
        return (nodes[p].aux == -3 or nodes[p].aux >= 0 and (tk == .struct_ or tk == .tuple)) and hv_part(a)
    if k == .unwrap or k == .narrow: return hv_part(int(nodes[p].a))
    false

# is e a variable (or a field path of one) that code n cannot change?
unchanged_by = (e: int, n: int) -> bool:
    if lpath_key(e) == 0: return false
    rn = lpath_root(e)
    if nodes[rn].aux != i32(int(SK.global)):
        r = int(nodes[rn].sym)
        if int(locals[r].flags) & (LF_ALIAS | LF_CAPTURE | LF_BYREF) != 0 or is_shared(r): return false
    not may_write_root(n, rn)

mentions_local = (n: int, l: int) -> bool:
    if n <= 0: return false
    k = nodes[n].kind
    if k == .ident: return nodes[n].aux == i32(int(SK.local)) and int(nodes[n].sym) == l
    child_a = int(nodes[n].a)
    child_b = int(nodes[n].b)
    child_c = int(nodes[n].c)
    child_d = int(nodes[n].d)
    more_children = k != .for_
    if mentions_local(child_a, l): return true
    if mentions_local(child_b, l): return true
    if more_children:
        if mentions_local(child_c, l): return true
        if mentions_local(child_d, l): return true
    loop i in [0..nkids(n)):
        if mentions_local(kid(n, i), l): return true
    loop i in [0..nkids2(n)):
        if mentions_local(kid2(n, i), l): return true
    false

# the variable a path of writes starts at (through fields and indexes); 0 if none
write_root = (n0: int) -> int:
    n = n0
    loop nodes[n].kind == .field or nodes[n].kind == .index or nodes[n].kind == .unwrap: n = int(nodes[n].a)
    if nodes[n].kind == .ident: return n
    0

same_var = (a: int, b: int) -> bool: nodes[a].aux == nodes[b].aux and nodes[a].sym == nodes[b].sym

# could code n change the variable at ident node rn (a global, or a local)?
# a conversion of an array or string to a raw pointer (through which it may be written)
raw_view = (n: int) -> bool:
    a = int(nodes[n].a)
    if a == 0 or nodes[n].type == 0 or nodes[a].type == 0: return false
    tk = tkind(ntype(n))
    fk = tkind(ntype(a))
    (tk == .ptr or tk == .int_) and (fk == .array or fk == .str_)

write_overlaps = (target: int, root: int, place: int) -> bool:
    w = place_var(target)
    w != 0 and same_var(w, root) and (place == 0 or steps_overlap(place_steps(target), place_steps(place)))

may_write_root = (n: int, rn: int, place: int = 0) -> bool:
    if n <= 0: return false
    k = nodes[n].kind
    if k == .lambda: return false
    glob = nodes[rn].aux == i32(int(SK.global))
    mutparam = not glob and int(locals[int(nodes[rn].sym)].flags) & LF_MUTPARAM != 0
    if not mwr_direct and (glob or mutparam):
        loop f in value_helper_calls(n):
            w = fn_writes(f)
            if w.all or (glob and w.globals.contains(int(nodes[rn].sym))) or (mutparam and w.globals.len() > 0): return true
    if k == .assign:
        if write_overlaps(int(nodes[n].a), rn, place): return true
    if k == .intrinsic and nkids(n) > 0:
        id = nodes[n].aux as IN
        if (id == .fmt_struct or id == .json_fields) and (glob or mutparam): return true
        if id == .push or id == .pop or id == .insert or id == .remove or id == .clear or id == .reserve or id == .resize or id == .truncate or id == .extend or id == .arrdata:
            if write_overlaps(kid(n, 0), rn, place): return true
    if k == .addr or (k == .cast or k == .conv) and raw_view(n):
        if write_overlaps(int(nodes[n].a), rn, place): return true
    if k == .for_ and has_flag(n, NF_MUT):
        if write_overlaps(int(nodes[n].a), rn, place): return true
    if k == .call or (k == .pair and nodes[n].sym > 0):
        mm = checked_call_mutmask(n)
        loop i in [0..nkids(n)):
            if mm & (1 << i) != 0:
                if write_overlaps(kid(n, i), rn, place): return true
        aux = if k == .pair: 0 else: int(nodes[n].aux)
        if mwr_direct: pass
        else if aux == 1 or aux == 4:
            if glob or mutparam: return true
        else if aux == 0 and (glob or mutparam):
            # (what the function and everything it calls may write; a mut parameter may be the
            # caller's global)
            w = fn_writes(int(nodes[n].sym))
            if w.all or (glob and w.globals.contains(int(nodes[rn].sym))) or (mutparam and w.globals.len() > 0): return true
    child_a = int(nodes[n].a)
    child_b = int(nodes[n].b)
    child_c = int(nodes[n].c)
    child_d = int(nodes[n].d)
    more_children = k != .for_
    if may_write_root(child_a, rn, place): return true
    if may_write_root(child_b, rn, place): return true
    if more_children:
        if may_write_root(child_c, rn, place): return true
        if may_write_root(child_d, rn, place): return true
    loop i in [0..nkids(n)):
        if may_write_root(kid(n, i), rn, place): return true
    loop i in [0..nkids2(n)):
        if may_write_root(kid2(n, i), rn, place): return true
    false

# do the calls in n leave the variable at ident node rn (a global or a mut parameter) alone:
# not change it, nor (written: the code writes its elements in place) copy it?
calls_leave = (n: int, rn: int, written: bool) -> bool:
    if n <= 0: return true
    k = nodes[n].kind
    if k == .lambda: return true
    loop f in value_helper_calls(n):
        w = fn_writes(f)
        if w.all: return false
        if nodes[rn].aux == i32(int(SK.global)):
            g = int(nodes[rn].sym)
            if w.globals.contains(g) or (written and w.mentions.contains(g)): return false
        else if w.globals.len() > 0 or (written and w.mentions.len() > 0): return false
    if k == .intrinsic and (nodes[n].aux == i32(int(IN.fmt_struct)) or nodes[n].aux == i32(int(IN.json_fields))): return false
    if k == .call or (k == .pair and nodes[n].sym > 0):
        aux = if k == .pair: 0 else: int(nodes[n].aux)
        if aux == 1 or aux == 4: return false
        if aux == 0:
            w = fn_writes(int(nodes[n].sym))
            if w.all: return false
            if nodes[rn].aux == i32(int(SK.global)):
                g = int(nodes[rn].sym)
                if w.globals.contains(g) or (written and w.mentions.contains(g)): return false
            else:
                # (a mut parameter may be any of the caller's globals)
                if w.globals.len() > 0 or (written and w.mentions.len() > 0): return false
    child_a = int(nodes[n].a)
    child_b = int(nodes[n].b)
    child_c = int(nodes[n].c)
    child_d = int(nodes[n].d)
    more_children = k != .for_
    if not calls_leave(child_a, rn, written): return false
    if not calls_leave(child_b, rn, written): return false
    if more_children:
        if not calls_leave(child_c, rn, written): return false
        if not calls_leave(child_d, rn, written): return false
    loop i in [0..nkids(n)):
        if not calls_leave(kid(n, i), rn, written): return false
    loop i in [0..nkids2(n)):
        if not calls_leave(kid2(n, i), rn, written): return false
    true

# ---- the globals a function may write ----
# Itself or through the functions it calls; `all` when it calls a function value (anything).
struct FnWrites:
    all: bool
    globals: int[]
    calls: int[]
    mentions: int[]             # the globals it names at all
fw_direct: {int: FnWrites}      # by function: what its own body does
fw_total: {int: FnWrites}       # ... and with everything it calls

# the globals f and the functions it calls by name write, also past calls of function values
# (fn_writes stops at the first of those: `all`)
fw_named: {int: FnWrites}
fn_writes_named = (f: int) -> FnWrites:
    if let w = fw_named.get(f): return w
    total = FnWrites(false, [], [], [])
    seen: {int: bool}
    todo = [f]
    loop todo.len() > 0:
        g = todo.pop()
        if seen.get(g, false): continue
        seen[g] = true
        d = fn_writes_direct(g)
        loop x in d.globals:
            if not total.globals.contains(x): total.globals.push(x)
        loop c in d.calls: todo.push(c)
    fw_named[f] = total
    total

fn_writes = (f: int) -> FnWrites:
    if let w = fw_total.get(f): return w
    total = FnWrites(false, [], [], [])
    seen: {int: bool}
    todo = [f]
    loop todo.len() > 0:
        g = todo.pop()
        if seen.get(g, false): continue
        seen[g] = true
        d = fn_writes_direct(g)
        if d.all: total.all = true
        loop x in d.globals:
            if not total.globals.contains(x): total.globals.push(x)
        loop x in d.mentions:
            if not total.mentions.contains(x): total.mentions.push(x)
        loop c in d.calls: todo.push(c)
        if total.all: break
    fw_total[f] = total
    total

fn_writes_direct = (f: int) -> FnWrites:
    if let w = fw_direct.get(f): return w
    w = FnWrites(false, [], [], [])
    if f > 0 and f < fns.len() and fns[f].body != 0: fw_scan(int(fns[f].body), w)
    # A foreign function may call back into the program; its body is opaque. The core runtime's
    # own host imports and system functions (lib/core: write, clock, files) never do.
    if f > 0 and f < fns.len() and fns[f].decl != 0 and has_flag(int(fns[f].decl), NF_EXTERN) and not starts_with(files[pos_file(nodes[int(fns[f].decl)].pos)].path, lib_dir + "/core/"): w.all = true
    fw_direct[f] = w
    w

fw_global = (n: int, w: mut FnWrites):
    r = write_root(n)
    if r != 0 and nodes[r].aux == i32(int(SK.global)) and not w.globals.contains(int(nodes[r].sym)): w.globals.push(int(nodes[r].sym))

fw_scan = (n: int, w: mut FnWrites):
    if n <= 0: return
    k = nodes[n].kind
    if k == .lambda: return
    loop f in value_helper_calls(n):
        if not w.calls.contains(f): w.calls.push(f)
    if k == .ident and nodes[n].aux == i32(int(SK.global)) and not w.mentions.contains(int(nodes[n].sym)): w.mentions.push(int(nodes[n].sym))
    if k == .assign: fw_global(int(nodes[n].a), w)
    if k == .intrinsic and nkids(n) > 0:
        id = nodes[n].aux as IN
        # Field formatting invokes type-specific formatters selected by the
        # checker. Treat it conservatively, including nested user formatters.
        if id == .fmt_struct or id == .json_fields: w.all = true
        if id == .push or id == .pop or id == .insert or id == .remove or id == .clear or id == .reserve or id == .resize or id == .truncate or id == .extend: fw_global(kid(n, 0), w)
    if k == .for_ and has_flag(n, NF_MUT): fw_global(int(nodes[n].a), w)
    if k == .call or (k == .pair and nodes[n].sym > 0):
        mm = checked_call_mutmask(n)
        loop i in [0..nkids(n)):
            if mm & (1 << i) != 0: fw_global(kid(n, i), w)
        aux = if k == .pair: 0 else: int(nodes[n].aux)
        if aux == 1 or aux == 4: w.all = true
        else if aux == 0 and not w.calls.contains(int(nodes[n].sym)): w.calls.push(int(nodes[n].sym))
    fw_scan(int(nodes[n].a), w)
    fw_scan(int(nodes[n].b), w)
    if k != .for_:
        fw_scan(int(nodes[n].c), w)
        fw_scan(int(nodes[n].d), w)
    loop i in [0..nkids(n)): fw_scan(kid(n, i), w)
    loop i in [0..nkids2(n)): fw_scan(kid2(n, i), w)

# ---- the global arrays a function may resize ----
# (for `loop mut` over a global's array: a function called in its body that adds to it, removes
# from it or replaces it, itself or through the functions it calls by name)
fr_direct: {int: int[]}
fr_total: {int: int[]}
fn_resizes = (f: int) -> int[]:
    if let r = fr_total.get(f): return r
    total: int[]
    seen: {int: bool}
    todo = [f]
    loop todo.len() > 0:
        g = todo.pop()
        if seen.get(g, false): continue
        seen[g] = true
        loop x in fn_resizes_direct(g):
            if not total.contains(x): total.push(x)
        loop c in fn_writes_direct(g).calls: todo.push(c)
    fr_total[f] = total
    total

fn_resizes_direct = (f: int) -> int[]:
    if let r = fr_direct.get(f): return r
    out: int[]
    if f > 0 and f < fns.len() and fns[f].body != 0: fr_scan(int(fns[f].body), out)
    fr_direct[f] = out
    out

# (a global whose array this may resize: push and the like on it, a whole array or a field path
# of it assigned, or it given to a function as mut)
fr_root = (n: int, out: mut int[]):
    r = write_root(n)
    if r != 0 and nodes[r].aux == i32(int(SK.global)) and not out.contains(int(nodes[r].sym)): out.push(int(nodes[r].sym))

fr_scan = (n: int, out: mut int[]):
    if n <= 0: return
    k = nodes[n].kind
    if k == .lambda: return
    if k == .assign:
        # (a whole value replaced, not an element's field: g.enemies = [], g = Game())
        t = int(nodes[n].a)
        whole = true
        u = t
        loop nodes[u].kind == .field:
            u = int(nodes[u].a)
        if nodes[u].kind != .ident: whole = false
        if whole: fr_root(t, out)
    if k == .intrinsic and nkids(n) > 0:
        id = nodes[n].aux as IN
        if id == .push or id == .pop or id == .insert or id == .remove or id == .clear or id == .resize or id == .truncate or id == .extend: fr_root(kid(n, 0), out)
    if k == .call:
        mm = checked_call_mutmask(n)
        loop i in [0..nkids(n)):
            if mm & (1 << i) != 0: fr_root(kid(n, i), out)
    fr_scan(int(nodes[n].a), out)
    fr_scan(int(nodes[n].b), out)
    if k != .for_:
        fr_scan(int(nodes[n].c), out)
        fr_scan(int(nodes[n].d), out)
    loop i in [0..nkids(n)): fr_scan(kid(n, i), out)
    loop i in [0..nkids2(n)): fr_scan(kid2(n, i), out)

# the first call in n (not in a function written in it) of a function that may resize global g
lm_resizing_call = (n: int, g: int) -> int:
    if n <= 0: return 0
    loop called in value_helper_calls(n):
        if fn_resizes(called).contains(g): return n
    k = nodes[n].kind
    if k == .lambda: return 0
    if k == .call and int(nodes[n].aux) == 0 and nodes[n].sym > 0 and fn_resizes(int(nodes[n].sym)).contains(g): return n
    r = lm_resizing_call(int(nodes[n].a), g)
    if r == 0: r = lm_resizing_call(int(nodes[n].b), g)
    if r == 0 and k != .for_:
        r = lm_resizing_call(int(nodes[n].c), g)
        if r == 0: r = lm_resizing_call(int(nodes[n].d), g)
    loop i in [0..nkids(n)):
        if r == 0: r = lm_resizing_call(kid(n, i), g)
    loop i in [0..nkids2(n)):
        if r == 0: r = lm_resizing_call(kid2(n, i), g)
    r

# ---- bounds checks that cannot fail ----
# In `for j in K..A.len()` (K a non-negative literal; the bound may also be a variable declared
# as `n := A.len()` and never changed) where A is never modified in the function, A[j] is in
gen_loop_body = (b: int) -> void:
    scope_push()
    gen_block_stmts(b)
    scope_pop()

# Stepped ranges compare the original endpoint, without end+1 arithmetic.
# Open ranges retain the exact two-word step. Each next value has a storage
# obligation; bounded ranges use a proven iteration count instead.
stepped_done = (up: int, ctr: int, endv: int, inclusive: bool, signed: bool) -> int:
    above = if signed: Op.ges else: Op.geu
    below = if signed: Op.les else: Op.leu
    if inclusive:
        above = if signed: Op.gts else: Op.gtu
        below = if signed: Op.lts else: Op.ltu
    e_bin(.or_, VI,
        e_bin(.and_, VI, up, e_bin(above, VI, ctr, endv)),
        e_bin(.and_, VI, e_bin(.xor, VI, up, e_iconst(1)), e_bin(below, VI, ctr, endv)))

gen_stepped_for = (s: int):
    it = int(nodes[s].a)
    l = int(nodes[s].sym)
    lt = prune(int(locals[l].type))
    if lt == T_MATH_INT: scope_add_local(l)
    signed = types[lt].sign
    less = if signed: Op.lts else: Op.ltu
    greater = if signed: Op.gts else: Op.gtu
    direct = lt != T_MATH_INT and stable_loop_index(l) and locals[l].offset < 0 and tsize(lt) == 8
    ctr = vreg(VI)
    if direct: ctr = int(locals[l].vreg)
    endv = vreg(VI)
    open_end = nodes[it].b == 0
    inclusive = has_flag(it, NF_INCLUSIVE)
    stmt_begin()
    e_mov(ctr, math_count(int(nodes[it].a)))
    second = math_count(int(nodes[it].c))
    up = e_bin(greater, VI, second, ctr)
    step = e_bin(.sub, VI, second, ctr)
    step_high = e_iconst(0)
    if open_end:
        first_high = if signed: e_bin(.shrs, VI, ctr, e_iconst(63)) else: e_iconst(0)
        second_high = if signed: e_bin(.shrs, VI, second, e_iconst(63)) else: e_iconst(0)
        step_high = e_bin(.sub, VI, e_bin(.sub, VI, second_high, first_high), e_bin(.ltu, VI, second, ctr))
    if not open_end: e_mov(endv, math_count(int(nodes[it].b)))
    iff(e_bin(.eq, VI, step, e_iconst(0)))
    e_call_nr1(rt("__panic"), e_daddr(str_data("range step must be nonzero")), -1)
    endc()
    stmt_end()
    blk()
    brk = ctl
    if not open_end: brif_to(stepped_done(up, ctr, endv, inclusive, signed), brk)
    remaining = vreg(VI)
    if not open_end:
        # Count iterations with unsigned distances, once. This covers the full
        # signed/unsigned span without overflow checks on every iteration.
        # A count of zero represents 2^64 iterations (the range is nonempty).
        distance = vreg(VI)
        magnitude = vreg(VI)
        iff(up)
        e_mov(distance, e_bin(.sub, VI, endv, ctr))
        e_mov(magnitude, step)
        els()
        e_mov(distance, e_bin(.sub, VI, ctr, endv))
        e_mov(magnitude, e_bin(.sub, VI, e_iconst(0), step))
        endc()
        if not inclusive: e_mov(distance, e_addi(distance, -1))
        e_mov(remaining, e_addi(e_bin(.divu, VI, distance, magnitude), 1))
    facts = range_facts_begin(s, l)
    lop()
    top = ctl
    if not direct:
        if lt == T_MATH_INT:
            drop_at(place_addr(local_place(l, true), lt), lt)
            write_place(local_place(l, true), lt, math_word(ctr).v)
        else: write_place(local_place(l, true), lt, ctr)
    blk()
    cont = ctl
    loops.push(LoopInfo(brk, cont, scope_locals.len(), tl_items.len(), building.len()))
    gen_loop_body(int(nodes[s].b))
    loops.pop()
    range_facts_end(facts)
    endc()
    next = e_bin(.add, VI, ctr, step)
    if open_end:
        high = if signed: e_bin(.shrs, VI, ctr, e_iconst(63)) else: e_iconst(0)
        high = e_bin(.add, VI, e_bin(.add, VI, high, step_high), e_bin(.ltu, VI, next, ctr))
        stored = if lt == T_MATH_INT: next else: norm(next, lt)
        expected = if signed: e_bin(.shrs, VI, stored, e_iconst(63)) else: e_iconst(0)
        bad = e_bin(.or_, VI, e_bin(.ne, VI, high, expected), e_bin(.ne, VI, next, stored))
        iff(bad)
        e_call_nr1(rt("__panic"), e_daddr(str_data("range exhausted its integer type")), -1)
        endc()
    e_mov(ctr, next)
    if open_end: br_to(top)
    else:
        e_mov(remaining, e_addi(remaining, -1))
        brif_to(e_bin(.ne, VI, remaining, e_iconst(0)), top)
    endc()
    endc()

# Element replacement can detach storage but cannot change its length. Reuse
# the loop's storage inventory for this narrower question; an opaque use,
# replacement, resize or an ambient call that can reach the root refuses it.
bounded_array_length = (array: int, loop_: int) -> bool:
    if not plain_read(array): return false
    key = lpath_key(array)
    if key == 0: return false
    summary = fact_storage_loop(loop_)
    if summary.opaque: return false
    loop killed in summary.kill:
        if path_within(key, killed): return false
    root = lpath_root(array)
    if nodes[root].aux == i32(int(SK.global)): return not summary.calls
    l = int(nodes[root].sym)
    flags = int(locals[l].flags)
    if flags & (LF_ALIAS | LF_CAPTURE | LF_BYREF) != 0 or is_shared(l): return false
    flags & LF_MUTPARAM == 0 or not summary.calls

# A leading `if not (i < stop): break` on an open unit range is a bounded
# range when stop cannot change. Combined Dewy loop headers produce exactly
# this guard. Reuse bounded lowering (including its index facts) without an
# extra exhaustion counter, and leave dynamic/effectful headers alone.
bounded_open_for = (s: int) -> int:
    if nodes[s].aux != 0: return 0
    it = int(nodes[s].a)
    if nodes[it].kind != .range or nodes[it].b != 0 or has_flag(it, NF_STEP): return 0
    l = int(nodes[s].sym)
    if not stable_loop_index(l) or (prune(int(locals[l].type)) != T_INT and prune(int(locals[l].type)) != T_MATH_INT): return 0
    body = int(nodes[s].b)
    if nkids(body) == 0: return 0
    guard = kid(body, 0)
    if nodes[guard].kind != .if_ or nodes[guard].c != 0: return 0
    condition = int(nodes[guard].a)
    if nodes[condition].kind != .not_: return 0
    condition = int(nodes[condition].a)
    if nodes[condition].kind != .binary or nodes[condition].aux != 0 or nodes[condition].op != i32(int(Tok.lt)): return 0
    index = word_integer_value(int(nodes[condition].a))
    if nodes[index].kind != .ident or nodes[index].aux != i32(int(SK.local)) or int(nodes[index].sym) != l: return 0
    stop = word_integer_value(int(nodes[condition].b))
    if prune(ntype(stop)) != T_INT and prune(ntype(stop)) != T_MATH_INT: return 0
    stable = nodes[stop].kind == .int_lit or fixed_array_len(stop) >= 0
    if nodes[stop].kind == .ident and nodes[stop].aux == i32(int(SK.local)):
        end_local = int(nodes[stop].sym)
        stable = stable_loop_index(end_local) and int(locals[end_local].flags) & LF_MUTPARAM == 0
    if not stable and nodes[stop].kind == .intrinsic and nodes[stop].aux == i32(int(IN.len)) and nkids(stop) == 1:
        array = kid(stop, 0)
        stable = bounded_array_length(array, s)
    if not stable: return 0
    exit = int(nodes[guard].b)
    if nodes[exit].kind == .block and nkids(exit) == 1: exit = kid(exit, 0)
    if nodes[exit].kind != .break_ or nodes[exit].ival != 0 or nodes[exit].name != 0: return 0
    # Make a lowering-only view; retain the checked source tree for tooling.
    range = mk(.range, nodes[it].pos)
    nodes[range] = nodes[it]
    nodes[range].b = i32(stop)
    clear_flag(range, NF_INCLUSIVE)
    statements: int[]
    loop i in [1..nkids(body)): statements.push(kid(body, i))
    block = mk(.block, nodes[body].pos)
    nodes[block] = nodes[body]
    set_list(block, statements)
    result = mk(.for_, nodes[s].pos)
    nodes[result] = nodes[s]
    nodes[result].a = i32(range)
    nodes[result].b = i32(block)
    result

# A comprehension into a fixed-size array of plain elements fills the array's
# own storage: its accumulator stays empty, and a count it does not reach (or
# would pass) is the length mismatch the copy would report.
fixed_fill_push = 0
fixed_fill_slot = 0
fixed_fill_count = 0
fixed_fill_type = 0
fixed_fill_exact = false

gen_fixed_comprehension = (b: int, push: int, to: int) -> Val:
    n = fixed_len(representation_type(to))
    s = new_temp(to)
    e_zero(e_slot(s), tsize(to))
    saved = (fixed_fill_push, fixed_fill_slot, fixed_fill_count, fixed_fill_type, fixed_fill_exact)
    count = vreg(VI)
    e_mov(count, e_iconst(0))
    exact = fact_fixed_comprehension_exact(b, to)
    fixed_fill_push = push; fixed_fill_slot = s; fixed_fill_count = count; fixed_fill_type = to; fixed_fill_exact = exact
    scope_push()
    gen_stmt(kid(b, 0))
    gen_stmt(kid(b, 1))
    scope_pop()
    fixed_fill_push = saved.0; fixed_fill_slot = saved.1; fixed_fill_count = saved.2; fixed_fill_type = saved.3; fixed_fill_exact = saved.4
    if not exact:
        iff(e_bin(.ne, VI, count, e_iconst(n)))
        e_call_nr1(rt("__panic"), e_daddr(str_data("fixed-size array needs {n} elements")), -1)
        endc()
    Val(e_slot(s), true, s)

# Straight-line Dewy comprehensions own an unnameable accumulator and append
# one result per iteration. Reserve once from a range bound or array snapshot.
comprehension_value = (n: int) -> bool:
    if n == 0: return true
    k = nodes[n].kind
    if k == .block or k == .lambda or k == .if_ or k == .iflet or k == .match_ or k == .for_ or k == .while_ or k == .return_ or k == .break_ or k == .continue_: return false
    if not comprehension_value(int(nodes[n].a)) or not comprehension_value(int(nodes[n].b)) or not comprehension_value(int(nodes[n].c)): return false
    loop child in kids(n):
        if not comprehension_value(child): return false
    true

reserve_comprehension = (b: int):
    if not has_flag(b, NF_COMPREHENSION) or nkids(b) != 3 or not files[pos_file(nodes[b].pos)].is_dewy: return
    decl = kid(b, 0)
    loop_ = kid(b, 1)
    if nodes[decl].kind != .vardecl or nodes[loop_].kind != .for_: return
    init = int(nodes[decl].b)
    if nodes[init].kind != .array or nkids(init) != 0: return
    it = int(nodes[loop_].a)
    idx = int(nodes[loop_].sym)
    if nodes[loop_].aux == 0:
        if nodes[it].kind != .range or nodes[it].b == 0 or has_flag(it, NF_STEP) or has_flag(it, NF_INCLUSIVE): return
        start = int(nodes[it].a)
        if nodes[start].kind != .int_lit or nodes[start].ival != 0 or prune(ntype(int(nodes[it].b))) != T_INT: return
    else if nodes[loop_].aux == 1:
        k = tkind(ntype(it))
        if k != .array and k != .fixed: return
        idx = int(nodes[loop_].c)
        # Unlike range loops, an array loop advances this actual index. It
        # must stay unchanged even when the result uses incremental append.
        if not stable_loop_index(idx): return
    else: return
    body = int(nodes[loop_].b)
    nb = nkids(body)
    if nb == 0 or nodes[kid(body, nb - 1)].kind != .exprstmt: return
    # Combined index/value loops introduce local index bindings. Ordinary
    # straight-line local declarations have the same one-result guarantee.
    loop i in [0..nb - 1):
        item = kid(body, i)
        if nodes[item].kind != .vardecl or not comprehension_value(int(nodes[item].b)): return
    push = int(nodes[kid(body, nb - 1)].a)
    if nodes[push].kind != .intrinsic or nodes[push].aux != i32(int(IN.push)) or nkids(push) != 2: return
    recv = kid(push, 0)
    if nodes[recv].kind != .ident or nodes[recv].sym != nodes[decl].sym or not comprehension_value(kid(push, 1)): return
    # aux2 is unused by range/array loops; d already owns the array snapshot.
    nodes[loop_].aux2 = nodes[decl].sym
    add_flag(loop_, NF_COMPREHENSION)
    add_flag(push, NF_INBOUNDS)
    # Plain elements need no partial-initialization cleanup. With an unchanged
    # index, set the result length once and write directly to that index.
    at = prune(int(locals[int(nodes[decl].sym)].type))
    if not is_managed(int(types[at].elem)) and stable_loop_index(idx):
        add_flag(loop_, NF_INBOUNDS)
        add_flag(push, NF_COMPREHENSION)
        # The generic write walker observes d as a child. If its first demand
        # is after this lowering annotation, retain that walk's exact input.
        fns[cur_fn].writes_ready = false
        nodes[push].d = i32(idx)

gen_comprehension_reserve = (s: int, count: int):
    if not has_flag(s, NF_COMPREHENSION): return
    acc = int(nodes[s].aux2)
    at = prune(int(locals[acc].type))
    pl = local_place(acc, true)
    iff(e_bin(.gts, VI, count, e_iconst(0)))
    sa = place_addr(pl, at)
    e_call3(rt("__arr_reserve"), sa, e_iconst(owner_stride(int(types[at].elem))), count, -1)
    if not pl.mem: e_mov(pl.v, e_load(VI, sa, 0, ptr_size))
    if has_flag(s, NF_INBOUNDS): hdr_store(read_place(pl, at), 8, count)
    endc()

gen_for = (s: int):
    if eg_stack.len() > 0: eg_loop()
    if exact_map_for(s): return
    if math_accumulator_for(s): return
    bounded = bounded_open_for(s)
    if bounded != 0:
        gen_for(bounded)
        return
    scope_push()
    aux = int(nodes[s].aux)
    if aux == 0 and prune(int(locals[int(nodes[s].sym)].type)) == T_MATH_INT and not math_word_range(s):
        gen_math_for(s)
        scope_pop()
        return
    if aux == 0 and has_flag(int(nodes[s].a), NF_STEP):
        gen_stepped_for(s)
        scope_pop()
        return
    if aux == 0 or aux == 4:
        l = int(nodes[s].sym)
        lt = int(locals[l].type)
        if prune(lt) == T_MATH_INT and not stable_loop_index(l): scope_add_local(l)
        endv = vreg(VI)
        ctr = vreg(VI)
        # (a 64-bit loop variable in a register that the body does not assign is the counter)
        direct = prune(lt) != T_MATH_INT and stable_loop_index(l) and locals[l].offset < 0 and vc(lt) == VC_INT and tsize(lt) == 8
        if direct: ctr = int(locals[l].vreg)
        open_end = false
        inclusive = false
        stmt_begin()
        if aux == 0:
            it = int(nodes[s].a)
            e_mov(ctr, math_count(int(nodes[it].a)))
            inclusive = has_flag(it, NF_INCLUSIVE)
            if nodes[it].b == 0:
                open_end = true
                bits = int(types[prune(lt)].bits)
                if types[prune(lt)].sign: bits -= 1
                maxv = -1
                if bits < 64: maxv = (1 << bits) - 1
                e_mov(endv, e_iconst(maxv))
            else: e_mov(endv, math_count(int(nodes[it].b)))
        else:
            r = gen_expr(int(nodes[s].a)).v
            e_mov(ctr, e_load(VI, r, 0, 8))
            e_mov(endv, e_load(VI, r, 8, 8))
        gen_comprehension_reserve(s, endv)
        stmt_end()
        sg = types[prune(lt)].sign
        facts = range_facts_begin(s, l)
        cmpop = Op.ges
        if not sg: cmpop = .geu
        counted = inclusive or open_end
        if counted: cmpop = if sg: Op.gts else: Op.gtu
        ltop = Op.lts
        if not sg: ltop = .ltu
        # Exclusive bounds keep their direct comparison. Inclusive/open ranges
        # count remaining representable values, avoiding end+1 overflow. As in
        # stepped loops, a nonempty full-word span has count zero (2^64).
        blk()
        brk = ctl
        if not open_end: brif_to(e_bin(cmpop, VI, ctr, endv), brk)
        remaining = 0
        if counted:
            remaining = vreg(VI)
            e_mov(remaining, e_addi(e_bin(.sub, VI, endv, ctr), 1))
        lop()
        top = ctl
        if not direct:
            if prune(lt) == T_MATH_INT:
                if stable_loop_index(l): math_word_regs[l] = ctr
                else:
                    drop_at(place_addr(local_place(l, true), lt), lt)
                    write_place(local_place(l, true), lt, math_word(ctr).v)
            else: write_place(local_place(l, true), lt, ctr)
        blk()
        cont = ctl
        loops.push(LoopInfo(brk, cont, scope_locals.len(), tl_items.len(), building.len()))
        gen_loop_body(int(nodes[s].b))
        math_word_regs.remove(l)
        loops.pop()
        range_facts_end(facts)
        endc()
        e_mov(ctr, e_addi(ctr, 1))
        if counted:
            e_mov(remaining, e_addi(remaining, -1))
            brif_to(e_bin(.ne, VI, remaining, e_iconst(0)), top)
        else: brif_to(e_bin(ltop, VI, ctr, endv), top)
        endc()
        if open_end: e_call_nr1(rt("__panic"), e_daddr(str_data("range exhausted its integer type")), -1)
        endc()
        scope_pop()
        return
    idx = int(nodes[s].c)
    snap = int(nodes[s].d)
    el = int(nodes[s].sym)
    ct = prune(ntype(int(nodes[s].a)))
    slice_lo = -1
    slice_hi = -1
    if aux == 1 or aux == 3:
        # (iterating a variable the loop does not change needs no snapshot of it: the loop
        # borrows the array, with no reference counting)
        it = int(nodes[s].a)
        sliced = aux == 1 and types[ct].kind == .array and is_slice(it) and tkind(ntype(int(nodes[it].a))) == .array
        # If the body writes the source, copying its selected range can be
        # cheaper than retaining the full array and forcing a whole-array detach.
        if sliced: sliced = unchanged_by(int(nodes[it].a), int(nodes[s].b))
        resource_map = aux == 3 and is_map_type(ct) and ownership_type(ct)
        if resource_map and not unchanged_by(it, int(nodes[s].b)):
            fatal(nodes[s].pos, "resource dictionary iteration requires stable borrowed storage")
        borrowed = resource_map or not type_has_fn(ct) and not sliced and not is_slice(it) and aux == 1 and (not dbg_on or copy_strict(s) or ownership_type(ct)) and unchanged_by(it, int(nodes[s].b))
        stmt_begin()
        if sliced:
            # Iteration needs a retained source and bounds, not a copied slice.
            # Own the source before evaluating bounds that can replace it.
            val = gen_owned(int(nodes[it].a))
            write_place(local_place(snap, true), ct, val.v)
            scope_add_local(snap)
            p = read_place(local_place(snap, false), ct)
            slice_lo, slice_hi = gen_slice_bounds(it, p)
            n = arr_len(p)
            bad = e_bin(.or_, VI, e_bin(.lts, VI, slice_lo, e_iconst(0)), e_bin(.gts, VI, slice_hi, n))
            bad = e_bin(.or_, VI, bad, e_bin(.gts, VI, slice_lo, slice_hi))
            iff(bad)
            e_call_nr4(rt("__panic_slice"), e_daddr(str_data("slice")), slice_lo, slice_hi, n, -1)
            endc()
        else:
            val = if borrowed: gen_borrowed(it) else: gen_owned(it)
            write_place(local_place(snap, true), ct, val.v)
            if not borrowed and ownership_type(ct): owner_forget_slot(val.slot)
        stmt_end()
        if not borrowed and not sliced: scope_add_local(snap)
    ip = local_place(idx, true)
    write_place(ip, T_INT, e_iconst(0))
    # the snapshot of an array cannot change while iterating: hoist its length and data
    n_snap = 0
    base_snap = 0
    map_values = 0
    is_fixed = types[ct].kind == .fixed
    if aux == 1:
        sv = read_place(local_place(snap, false), ct)
        if is_fixed:
            # (the snapshot is the elements themselves)
            n_snap = e_iconst(fixed_len(ct))
            base_snap = sv
        else:
            n_snap = arr_len(sv)
            base_snap = e_addi(sv, 24)
            if slice_lo >= 0:
                n_snap = e_bin(.sub, VI, slice_hi, slice_lo)
                base_snap = e_bin(.add, VI, base_snap, e_bin(.mul, VI, slice_lo, e_iconst(owner_stride(int(types[ct].elem)))))
        gen_comprehension_reserve(s, n_snap)
    else if aux == 3 and not has_flag(s, NF_MUT):
        # The dense entry snapshot is immutable for this loop. Hoist its array
        # bounds and data just as for an ordinary array snapshot.
        layout(ct)
        f0 = int(structs[int(types[ct].st)].fields)
        sa = place_addr(local_place(snap, false), ct)
        keys = e_load(VI, sa, int(fields[f0].offset), ptr_size)
        n_snap = arr_len(keys)
        base_snap = e_addi(keys, 24)
        map_values = e_addi(e_load(VI, sa, int(fields[f0 + 1].offset), ptr_size), 24)
    if aux == 2 and types[ct].kind == .array:
        spelling = mutable_loop_syntax(nodes[s].pos)
        key = lpath_key(int(nodes[s].a))
        if key != 0:
            at = lm_change_at(int(nodes[s].b), key)
            if at != 0:
                p = place_text(int(nodes[s].a))
                # (respawn(g) in a loop over g.enemies: all of g given to a function that may
                # change it, the array among the rest)
                why = ""
                src = files[pos_file(at)].src
                o = pos_off(at)
                e = o
                loop e < len(src) and (is_alnum(src[e]) or src[e] == '_' or src[e] == '.'): e += 1
                if e < len(src) and e > o and (src[e] == ')' or src[e] == ',') and starts_with(p, src[o..e)):
                    why = " (here all of {src[o..e)} is given to a function that may change it, with its {p}: set a flag in the loop and call it after)"
                fatal(at, "`{spelling}` changes the elements of {p} in place, so its body cannot add, remove or replace elements of {p}{why}: do that after the loop ({p}.retain({jd(nodes[s].pos, "(x): keep", "(x) => keep")}) keeps some; push new ones to another array first), or loop over its indexes")
            # (a function called in the body that does it, to a global's array)
            r = write_root(int(nodes[s].a))
            if r != 0 and nodes[r].aux == i32(int(SK.global)):
                c = lm_resizing_call(int(nodes[s].b), int(nodes[r].sym))
                if c != 0:
                    p = place_text(int(nodes[s].a))
                    fname = name_of(int(nodes[int(fns[int(nodes[c].sym)].decl)].name))
                    fatal(nodes[c].pos, "`{spelling}` changes the elements of {p} in place, and {fname} (called here) may add, remove or replace elements of {p}, which the loop cannot have: set a flag in the loop and call it after, push new ones to another array first, or loop over its indexes")
    # (the array of a `loop mut` that the loop cannot replace or resize: its length is read once)
    nfp = 0
    n_fixed = 0
    if aux == 2 and is_fixed:
        nfp = fp_begin(s, idx, 0, 0)
        n_fixed = e_iconst(fixed_len(ct))
    else if aux == 2:
        before = fixed_paths.len()
        nfp = fp_begin(s, idx, int(nodes[s].a), int(nodes[s].a))
        fi = fixed_path_of(int(nodes[s].a))
        if fi >= before: n_fixed = fixed_paths[fi].len
    else: nfp = fp_begin(s, idx, 0, 0)
    # tested before the loop and then at its bottom, like a range loop
    blk()
    brk = ctl
    brif_to(each_done(s, ct, read_place(local_place(idx, false), T_INT), n_snap, n_fixed, false), brk)
    lop()
    top = ctl
    i = read_place(local_place(idx, false), T_INT)
    if aux == 1:
        et = T_U8
        if types[ct].kind == .array or is_fixed: et = int(types[ct].elem)
        ea = e_bin(.add, VI, base_snap, e_bin(.mul, VI, i, e_iconst(if is_fixed: tsize(et) else: owner_stride(et))))
        e_mov(int(locals[el].vreg), ea)
    else if aux == 3:
        si = int(types[ct].st)
        layout(ct)
        f0 = int(structs[si].fields)
        kt = telem(int(fields[f0].type))
        vt = telem(int(fields[f0 + 1].type))
        sa = place_addr(local_place(snap, false), ct)
        keys = base_snap
        if keys == 0: keys = e_addi(e_load(VI, sa, int(fields[f0].offset), ptr_size), 24)
        e_mov(int(locals[el].vreg), e_bin(.add, VI, keys, e_bin(.mul, VI, i, e_iconst(owner_stride(kt)))))
        vl = int(nodes[s].aux2)
        if vl != 0 and int(locals[vl].flags) & LF_BYREF != 0:
            vals = map_values
            if vals == 0: vals = e_addi(e_load(VI, sa, int(fields[f0 + 1].offset), ptr_size), 24)
            e_mov(int(locals[vl].vreg), e_bin(.add, VI, vals, e_bin(.mul, VI, i, e_iconst(owner_stride(vt)))))
    blk()
    cont = ctl
    loops.push(LoopInfo(brk, cont, scope_locals.len(), tl_items.len(), building.len()))
    if aux == 3 and is_map_type(ct) and ownership_type(ct):
        fs = field_list(ct)
        sa = place_addr(local_place(snap, false), ct)
        gone = e_load(VI, sa, fs[4].1, ptr_size)
        iff(e_bin(.lts, VI, i, arr_len(gone)))
        brif_to(e_load(VI, e_bin(.add, VI, e_addi(gone, 24), i), 0, 1), cont)
        endc()
    gen_loop_body(int(nodes[s].b))
    loops.pop()
    endc()
    ip2 = local_place(idx, true)
    write_place(ip2, T_INT, e_addi(read_place(ip2, T_INT), 1))
    brif_to(each_done(s, ct, read_place(local_place(idx, false), T_INT), n_snap, n_fixed, true), top)
    endc()
    endc()
    fp_end(nfp)
    scope_pop()

# is an element loop done: index i past the end (more: is there more instead)
each_done = (s: int, ct: int, i: int, n_snap: int, n_fixed: int, more: bool) -> int:
    aux = int(nodes[s].aux)
    n = n_snap
    if aux == 2:
        n = n_fixed
        if n == 0: n = arr_len(read_place(gen_place(int(nodes[s].a), false), ct))
    else if aux == 3 and n == 0:
        si = int(types[ct].st)
        layout(ct)
        f0 = int(structs[si].fields)
        sa = place_addr(local_place(int(nodes[s].d), false), ct)
        n = arr_len(e_load(VI, sa, int(fields[f0].offset), ptr_size))
    if more: return e_bin(.lts, VI, i, n)
    e_bin(.ges, VI, i, n)

# ---------------- array paths fixed during a loop ----------------
# In a range loop (release builds), an array reached by a path -- a local variable or mut
# parameter and fields of it: xs, w.xs, ps.x -- that the loop cannot replace, resize or hand to
# anything that could, has its data pointer and length read once in front of the loop: indexing
# it then costs one compare, none when the index is the variable of a loop up to its length.
# A path the loop writes elements of gets its copy-on-write check there too, unless a copy of
# it (or of what holds it) is made in the loop.
struct FixedPath:
    key: int
    arr: int            # vreg: the array
    len: int            # vreg: its length
    loopvar: int        # local: indexes by this loop variable are in bounds (-1: none)
fixed_paths: FixedPath[]

fp_bases: int[]         # index bases in the loop that are paths
fp_kill: int[]          # paths the loop may replace or resize (with everything inside them)
fp_escape: int[]        # paths copied or handed on by value in the loop
fp_written: int[]       # paths whose elements the loop writes
fp_calls = false        # the loop calls code that might reach a mut parameter's variable
fp_lambda = false

# Canonical paths live for one lowered function. Roots use the low 32 bits
# (symbol index plus local/global tag); field edges use a nonzero parent ID in
# the high 32 bits and the field index below it. Symbol/field indexes are i32.
# Zero is not a path. Walking parents replaces string-prefix comparisons.
lpath_ids: {int: int} = {}
lpath_parents: int[] = [0]

lpath_intern = (parent: int, part: int) -> int:
    edge = (parent << 32) | part
    if let id = lpath_ids.get(edge): return id
    id = lpath_parents.len()
    lpath_parents.push(parent)
    lpath_ids[edge] = id
    id

lpath_key = (n: int) -> int:
    k = nodes[n].kind
    if k == .ident:
        if nodes[n].aux == i32(int(SK.local)): return lpath_intern(0, int(nodes[n].sym) * 2)
        if nodes[n].aux == i32(int(SK.global)): return lpath_intern(0, int(nodes[n].sym) * 2 + 1)
    if k == .field and nodes[n].aux >= 0:
        a = int(nodes[n].a)
        if tkind(ntype(a)) != .struct_ or boxed_field_of(n) >= 0: return 0
        parent = lpath_key(a)
        if parent == 0: return 0
        return lpath_intern(parent, int(nodes[n].aux))
    0

# the variable a path starts at (its ident node)
lpath_root = (n0: int) -> int:
    n = n0
    loop nodes[n].kind == .field: n = int(nodes[n].a)
    n

# k is p or a path that p is inside of
path_within = (p: int, k: int) -> bool:
    path = p
    loop path != 0:
        if path == k: return true
        path = lpath_parents[path]
    false

# where loop body n changes how many elements path `key` has, or replaces it, by itself (not
# through what it calls): 0 if it does not. (`loop mut` writes the elements in place: a body
# adding or removing them would skip or repeat elements.)
lm_change_at = (n: int, key: int) -> int:
    if n == 0: return 0
    k = nodes[n].kind
    if k == .lambda: return 0
    if k == .assign:
        tk = lpath_key(int(nodes[n].a))
        if tk != 0 and path_within(key, tk): return nodes[n].pos
    if k == .intrinsic and nkids(n) > 0:
        id = nodes[n].aux as IN
        if id == .push or id == .pop or id == .insert or id == .remove or id == .clear or id == .resize or id == .truncate or id == .extend:
            tk = lpath_key(kid(n, 0))
            if tk != 0 and path_within(key, tk): return nodes[n].pos
    if k == .call:
        mm = checked_call_mutmask(n)
        loop i in [0..nkids(n)):
            if mm & (1 << i) != 0:
                tk = lpath_key(kid(n, i))
                if tk != 0 and path_within(key, tk): return nodes[kid(n, i)].pos
    r = lm_change_at(int(nodes[n].a), key)
    if r == 0: r = lm_change_at(int(nodes[n].b), key)
    if r == 0 and k != .for_:
        r = lm_change_at(int(nodes[n].c), key)
        if r == 0 and k != .partial: r = lm_change_at(int(nodes[n].d), key)
    loop i in [0..nkids(n)):
        if r == 0: r = lm_change_at(kid(n, i), key)
    loop i in [0..nkids2(n)):
        if r == 0: r = lm_change_at(kid2(n, i), key)
    r

# the paths of loop s (with variable l) fixed during it; returns how many were added
# (place: the array of a `loop mut x in place`, whose elements the loop writes)
fp_begin = (s: int, l: int, bound: int, place: int) -> int:
    if place == 0 and fns[cur_fn].no_indexes: return 0
    summary = fact_storage_loop(s)
    fp_bases = summary.bases
    fp_kill = summary.kill
    fp_escape = summary.escape
    fp_written = summary.written
    fp_calls = summary.calls
    fp_lambda = summary.opaque
    if place != 0 and lpath_key(place) != 0 and tkind(ntype(place)) == .array:
        fp_bases.push(place)
        fp_written.push(lpath_key(place))
    if fp_lambda or fp_bases.len() == 0: return 0
    bound_key = 0
    if bound != 0: bound_key = lpath_key(bound)
    added = 0
    done: int[]
    loop base in fp_bases:
        key = lpath_key(base)
        if done.contains(key): continue
        done.push(key)
        ok = true
        loop kk in fp_kill:
            if path_within(key, kk): ok = false
        rn = lpath_root(base)
        r = int(nodes[rn].sym)
        fl = 0
        written = fp_written.contains(key)
        if nodes[rn].aux == i32(int(SK.global)):
            # (what the loop calls could change the global, or copy it while the loop writes it)
            if fp_calls: ok = false
        else:
            fl = int(locals[r].flags)
            if fl & (LF_ALIAS | LF_CAPTURE | LF_BYREF) != 0 or is_shared(r): ok = false
            if fl & LF_MUTPARAM != 0 and fp_calls: ok = false
            if fl & LF_PARAM == 0 and not declared_in_scope(r): ok = false
        if written:
            loop e in fp_escape:
                if path_within(key, e) or path_within(e, key): ok = false
            if fl & LF_PARAM != 0 and fl & LF_MUTPARAM == 0: ok = false
        if not ok: continue
        at = prune(ntype(base))
        desc = partition_descriptor(base)
        if desc >= 0:
            data = e_load(VI, desc, 0, 8)
            length = e_load(VI, desc, 8, 8)
            fixed_paths.push(FixedPath(key, e_addi(data, -24), length, (if key == bound_key and stable_loop_index(l): l else: -1)))
            added += 1
            continue
        if written and not is_uniq_array(base): arr_unique(gen_place(base, true), at)
        arr = vreg(VI)
        e_mov(arr, read_place(gen_place(base, false), at))
        n = arr_len(arr)
        lv = -1
        if key == bound_key and stable_loop_index(l): lv = l
        fixed_paths.push(FixedPath(key, arr, n, lv))
        added += 1
    added

fp_end = (n: int):
    loop _ in [0..n): fixed_paths.pop()

fixed_path_of = (a: int) -> int:
    if fixed_paths.len() == 0: return -1
    key = lpath_key(a)
    if key == 0: return -1
    i = fixed_paths.len() - 1
    loop i >= 0:
        if fixed_paths[i].key == key: return i
        i -= 1
    -1

# ---------------- uniqueness hoisting ----------------
# A loop that writes elements of a local array but never lets the array escape (it is only
# indexed, measured or changed in place) keeps the array uniquely owned, so one copy-on-write
# check before the loop replaces the check at every element write (release builds).
uq_written: int[]
uq_escaped: int[]
uq_lambda = false
uq_calls = false            # the loop calls code that might copy a mut parameter's variable
uniq_locals: int[]          # locals known to be unique while lowering the current loop

uq_scan = (n: int, ctx: int):
    # ctx: 0 = the value escapes (copied, passed, captured), 1 = indexed read, 2 = indexed write
    if n == 0: return
    k = nodes[n].kind
    # An unclassified operation may also affect its local actuals. Merely
    # marking ambient calls would still allow caching a private local array.
    mask = isolation_children(k)
    if mask < 0 or k == .intrinsic and not isolation_intrinsic(nodes[n].aux as IN):
        uq_lambda = true
        return
    if k == .lambda:
        uq_lambda = true
        return
    if not ambient_sharing_stable(n): uq_calls = true
    if k == .ident and nodes[n].aux == i32(int(SK.local)) and int(locals[int(nodes[n].sym)].flags) & LF_ELEMALIAS != 0:
        # (as fp_scan: its array is written where the body does not show; left as it is)
        b = int(nodes[int(locals[int(nodes[n].sym)].alias)].a)
        if nodes[b].kind == .ident and nodes[b].aux == i32(int(SK.local)): uq_escaped.push(int(nodes[b].sym))
        return
    if k == .ident:
        if nodes[n].aux == i32(int(SK.local)):
            if ctx == 2: uq_written.push(int(nodes[n].sym))
            else if ctx == 0: uq_escaped.push(int(nodes[n].sym))
        return
    if k == .index:
        uq_scan(int(nodes[n].a), if nodes[n].aux == 1: 0 else: 1)
        uq_scan(int(nodes[n].b), 0)
        return
    if k == .field:
        uq_scan(int(nodes[n].a), 1)
        return
    if k == .assign:
        uq_target(int(nodes[n].a))
        uq_scan(int(nodes[n].b), 0)
        return
    if k == .intrinsic:
        id = nodes[n].aux as IN
        if nkids(n) > 0 and (id == .len or id == .arrcap or id == .push or id == .pop or id == .insert or id == .remove or id == .clear or id == .reserve or id == .resize or id == .truncate or id == .extend):
            uq_scan(kid(n, 0), 1)
            loop i in [1..nkids(n)): uq_scan(kid(n, i), 0)
            return
    if mask & 1 != 0: uq_scan(int(nodes[n].a), 0)
    if mask & 2 != 0: uq_scan(int(nodes[n].b), 0)
    if mask & 4 != 0: uq_scan(int(nodes[n].c), 0)
    if mask & 16 != 0:
        loop i in [0..nkids(n)): uq_scan(kid(n, i), 0)
    if mask & 32 != 0:
        loop i in [0..nkids2(n)): uq_scan(kid2(n, i), 0)

# assignment target: elements of an indexed array (possibly a field of one) are writes
uq_target = (t: int):
    if not ambient_sharing_stable(t): uq_calls = true
    k = nodes[t].kind
    if k == .index:
        uq_scan(int(nodes[t].a), 2)
        uq_scan(int(nodes[t].b), 0)
    else if k == .field: uq_target(int(nodes[t].a))
    else: uq_scan(t, 0)

# hoist the uniqueness checks of a loop's arrays in front of it; returns how many were added
uq_begin = (s: int) -> int:
    if not opt_release: return 0
    uq_written.clear()
    uq_escaped.clear()
    uq_lambda = false
    uq_calls = false
    uq_scan(s, 1)
    if uq_lambda: return 0
    added = 0
    loop l in uq_written:
        if uq_escaped.contains(l) or uniq_locals.contains(l): continue
        t = prune(int(locals[l].type))
        if types[t].kind != .array: continue
        fl = int(locals[l].flags)
        if partition_mode and fl & LF_MUTPARAM != 0: continue
        if fl & (LF_ALIAS | LF_CAPTURE | LF_BYREF) != 0 or is_shared(l): continue
        if fl & LF_PARAM != 0 and fl & LF_MUTPARAM == 0: continue
        # (a mut parameter may be the caller's global, which code the loop calls could copy)
        if fl & LF_MUTPARAM != 0 and uq_calls: continue
        # only variables that exist before the loop: one declared inside it gets a new value
        # (maybe a shared or read-only one) on every iteration
        if fl & LF_PARAM == 0 and not declared_in_scope(l): continue
        arr_unique(local_place(l, true), t)
        uniq_locals.push(l)
        added += 1
    added

declared_in_scope = (l: int) -> bool:
    # Borrowed element locals have no destructor entry in scope_locals. Their
    # marker is installed only when their declaration has been lowered.
    if int(locals[l].flags) & LF_ELEMENTVIEW != 0: return true
    loop sl in scope_locals:
        if sl.contains(l): return true
    false

uq_end = (n: int):
    loop _ in [0..n): uniq_locals.pop()

# Closed-program array ownership. A global whose storage is always fresh and
# never copied or exposed cannot require detaching at an element write. Keep
# this separate from loop-local uniqueness: it holds across calls as well.
uniq_globals: bool[]

ug_fresh = (n: int, t: int) -> bool:
    if n == 0: return true   # a typed, uninitialized array starts empty
    if nodes[n].kind != .array: return false
    nodes[n].b != 0 or nkids(n) == 0 or not all_const(n, int(types[prune(t)].elem))

ug_scan = (n: int, ctx: int):
    # 0: value can escape, 1: only its storage is inspected/changed,
    # -1: an address or mutable argument can expose the containing storage.
    if n == 0: return
    k = nodes[n].kind
    if k == .lambda: return  # checked bodies are scanned through fns
    if k == .ident:
        if nodes[n].aux == i32(int(SK.global)):
            g = int(nodes[n].sym)
            if ctx != 1 and g < uniq_globals.len(): uniq_globals[g] = false
        else if nodes[n].aux == i32(int(SK.local)):
            g = alias_global(int(nodes[n].sym))
            if g >= 0 and g < uniq_globals.len(): uniq_globals[g] = false
        return
    if k == .index:
        ug_scan(int(nodes[n].a), if ctx == -1: -1 else: if nodes[n].aux == 1: 0 else: 1)
        ug_scan(int(nodes[n].b), 0)
        return
    if k == .addr:
        ug_scan(int(nodes[n].a), -1)
        return
    if k == .assign:
        a = int(nodes[n].a)
        b = int(nodes[n].b)
        if nodes[a].kind == .ident and nodes[a].aux == i32(int(SK.global)) and tkind(ntype(a)) == .array and ug_fresh(b, ntype(a)):
            ug_scan(a, 1)
        else: ug_scan(a, 0)
        ug_scan(b, 0)
        return
    if k == .vardecl and has_flag(n, NF_ALIASDECL):
        ug_scan(int(nodes[n].b), -1)
        return
    if k == .intrinsic:
        id = nodes[n].aux as IN
        if nkids(n) > 0 and (id == .len or id == .arrcap or id == .push or id == .pop or id == .insert or id == .remove or id == .clear or id == .reserve or id == .resize or id == .truncate or id == .extend):
            ug_scan(kid(n, 0), if ctx == -1: -1 else: 1)
            loop i in [1..nkids(n)): ug_scan(kid(n, i), 0)
            return
    ug_scan(int(nodes[n].a), if ctx == -1: -1 else: 0)
    ug_scan(int(nodes[n].b), if ctx == -1: -1 else: 0)
    if k != .for_:
        ug_scan(int(nodes[n].c), if ctx == -1: -1 else: 0)
        if k != .partial: ug_scan(int(nodes[n].d), if ctx == -1: -1 else: 0)
    mm = if k == .call or k == .pair: checked_call_mutmask(n) else: 0
    loop i in [0..nkids(n)):
        arg = kid(n, i)
        ug_scan(arg, if ctx == -1 or mm & (1 << i) != 0: -1 else: 0)
    loop i in [0..nkids2(n)): ug_scan(kid2(n, i), 0)

find_unique_globals = (closed: bool):
    uniq_globals.clear()
    # Future interactive code can introduce copies. Late runtime helpers may
    # reference prelude globals, so those are excluded from this closed world.
    if not closed: return
    uniq_globals.resize(globals.len())
    any = false
    loop g in global_ids:
        if globals[g].state != 2 or globals[g].is_const or modules[int(globals[g].mod)].is_prelude: continue
        t = prune(int(globals[g].type))
        d = int(globals[g].decl)
        if types[t].kind != .array or nkids(d) != 0: continue
        if ug_fresh(int(nodes[d].b), t):
            uniq_globals[g] = true
            any = true
    if not any: return
    # Initializers commonly expose every candidate (for example by passing a
    # global array to a function). Disprove those before walking other bodies.
    loop fi in init_fns: ug_scan(int(fns[fi].body), 0)
    any = false
    loop g in global_ids:
        if uniq_globals[g]: any = true
    if not any: return
    loop f in fns:
        if f.state == 2 and not f.no_user_globals: ug_scan(int(f.body), 0)

is_uniq_array = (e: int) -> bool:
    if nodes[e].kind != .ident: return false
    r = int(nodes[e].sym)
    if nodes[e].aux == i32(int(SK.local)): return uniq_locals.contains(r)
    nodes[e].aux == i32(int(SK.global)) and r < uniq_globals.len() and uniq_globals[r]

# a loop condition that is cheap to test twice and computes nothing the body could reuse:
# comparisons of variables and literals (i < j, k != 0, done), and/or/not of those
simple_cond = (e: int) -> bool:
    k = nodes[e].kind
    if k == .bool_lit: return true
    if k == .ident: return nodes[e].aux == i32(int(SK.local))
    if k == .not_: return simple_cond(int(nodes[e].a))
    if k == .and_ or k == .or_: return simple_cond(int(nodes[e].a)) and simple_cond(int(nodes[e].b))
    if k == .binary and nodes[e].aux == 0:
        op = nodes[e].op as Tok
        if not (op == .eq or op == .ne or op == .lt or op == .le or op == .gt or op == .ge): return false
        loop x in [int(nodes[e].a), int(nodes[e].b)]:
            xk = nodes[x].kind
            if not (xk == .int_lit or xk == .bool_lit or (xk == .ident and nodes[x].aux == i32(int(SK.local)))): return false
            if vc(ntype(x)) != VC_INT: return false
        return true
    false

gen_while = (s: int):
    if eg_stack.len() > 0: eg_loop()
    scope_push()
    rotate = nodes[s].aux != 1 and simple_cond(int(nodes[s].a))
    nfp = fp_begin(s, -1, 0, 0)
    blk()
    brk = ctl
    # (a simple condition is tested in front and at the bottom: one branch per iteration)
    if rotate: jump_if_false(int(nodes[s].a), brk)
    lop()
    top = ctl
    if nodes[s].aux == 1:
        l = int(nodes[s].sym)
        a = int(nodes[s].a)
        ot = prune(ntype(a))
        inner = int(types[ot].elem)
        has = vreg(VI)
        stmt_begin()
        pa = place_addr(gen_place(a, false), ot)
        e_mov(has, opt_has(pa, inner))
        if held_views.contains(l): e_mov(int(locals[l].vreg), held_encode_addr(pa, inner))
        else:
            iff(has)
            vv = own_at(a, V(opt_value(pa, inner), false), inner)
            write_place(local_place(l, true), inner, vv.v)
            endc()
        stmt_end()
        brif_to(e_bin(.eq, VI, has, e_iconst(0)), brk)
        scope_push()
        scope_add_local(l)
        blk()
        cont = ctl
        loops.push(LoopInfo(brk, cont, scope_locals.len(), tl_items.len(), building.len()))
        gen_block_stmts(int(nodes[s].b))
        loops.pop()
        endc()
        scope_pop()
        br_to(top)
    else:
        # (others at the top: the condition often computes what the body uses again)
        if not rotate: jump_if_false(int(nodes[s].a), brk)
        blk()
        cont = ctl
        loops.push(LoopInfo(brk, cont, scope_locals.len(), tl_items.len(), building.len()))
        guard = if eg_active: eg_begin(int(nodes[s].a), true) else: 0
        gen_loop_body(int(nodes[s].b))
        if eg_active: eg_end(guard)
        loops.pop()
        endc()
        c = int(nodes[s].a)
        if not rotate or (nodes[c].kind == .bool_lit and nodes[c].ival != 0): br_to(top)
        else: jump_if_true(c, top)
    endc()
    endc()
    fp_end(nfp)
    scope_pop()

gen_stmt = (s: int):
    ir_set_pos(nodes[s].pos)
    k = nodes[s].kind
    if k == .vardecl:
        stmt_begin()
        gen_vardecl(s)
        stmt_end()
    else if k == .assign:
        stmt_begin()
        gen_assign(s)
        if eg_stack.len() > 0: eg_write(int(nodes[s].a))
        stmt_end()
    else if k == .exprstmt:
        a = int(nodes[s].a)
        ak = nodes[a].kind
        if ak == .match_ or ak == .if_ or ak == .iflet:
            val = gen_expr(a)
            if val.owned and is_managed(ntype(a)):
                stmt_begin()
                borrow(val, ntype(a))
                stmt_end()
            return
        stmt_begin()
        val = gen_expr(a)
        borrow(val, ntype(a))
        stmt_end()
    else if k == .if_ or k == .iflet: gen_expr(s)
    else if k == .while_ or k == .for_:
        n = uq_begin(s)
        if k == .while_: gen_while(s)
        else: gen_for(s)
        uq_end(n)
    else if k == .return_: gen_return(s)
    else if k == .break_ or k == .continue_:
        lp = loops[loops.len() - 1 - int(nodes[s].ival)]
        drop_held(lp.items, lp.built)
        i = scope_locals.len() - 1
        loop i >= lp.scope:
            emit_scope_exit(i)
            i -= 1
        if k == .break_: br_to(lp.brk)
        else: br_to(lp.cont)
    else if k == .defer_: scope_defers[scope_defers.len() - 1].push(int(nodes[s].a))
    else if k == .block:
        if nodes[s].aux == 5:
            gen_block_stmts(s)
            return
        scope_push()
        gen_block_stmts(s)
        scope_pop()
    else if k == .const_: pass
    else: fatal(nodes[s].pos, "unsupported statement in codegen")

gen_block_stmts = (b: int) -> void:
    guarded = lower_length_guards.len()
    loop i in [0..nkids(b)):
        cur_block = b
        cur_block_i = i
        gen_stmt(kid(b, i))
        lower_length_guard(kid(b, i))
    lower_length_guards.truncate(guarded)

# ---------------- functions ----------------
begin_fn = (name: str, idx: int):
    ir_begin(name, idx)
    exact_lower_active = exact_nodes.len() > 0
    eg_active = false
    lower_length_guards = []
    parallel_scalars.clear()
    parallel_owned.clear()
    stack_closure_fn = -1
    stack_closure_params.clear()
    math_word_regs.clear()
    math_word_limits.clear()
    math_word_updates.clear()
    math_writes_ready = false
    math_has_mutable = false
    math_writes.clear()
    math_decl_depth.clear()
    math_loop_sites.clear()
    math_write_loop.clear()
    math_loop_parent.clear()
    ctl = 0
    cond_depth = 0
    scope_locals = []
    scope_defers = []
    loops = []
    tl_items.clear()
    tl_values.clear()
    tl_nop.clear()
    lower_zeros.clear()
    lower_mark_serial = 0
    lower_has_nops = ownership_decls.len() != 0
    tl_cond.clear()
    building = []
    sret_v = -1
    env_v = -1

find_ids: int[]
# (the bytes Op.findb looks for, packed, for a runtime function so made (lib/core/str.jo); -1:
# not one)
find_bytes_set = (name: int) -> int:
    if find_ids.len() == 0:
        loop nm in ["__find_delim", "__find_newline", "__find_line_delim", "__find_line_delim4", "__find_line_delim8"]: find_ids.push(intern(nm))
    delims = 0x0A | (0x22 << 8) | (0x23 << 16) | (0x27 << 24)
    if name == find_ids[0]: return delims
    if name == find_ids[1]: return 0x0A0A0A0A
    if name == find_ids[2]: return delims | (1 << 32)
    if name == find_ids[3]: return delims | (1 << 32) | (4 << 33)
    if name == find_ids[4]: return delims | (1 << 32) | (8 << 33)
    -1

lower_inst = (lf: int, f: int):
    positive_epoch += 1
    begin_fn(lfuncs[lf].name, lf)
    owner_begin()
    if fns[f].decl != 0:
        ir_set_pos(nodes[int(fns[f].decl)].pos)
        ir.decl_pos = ir_pos
    cur_fn = f
    exact_lower_active = exact_owners.has(f)
    eg_active = f < eg_demanded.len() and eg_demanded[f]
    cur_ret = int(fns[f].ret)
    ir.cabi = fns[f].cabi
    ir.noinline = fns[f].noinline
    ir.export_name = if parallel_serial: "" else: fns[f].export_name
    if vc(cur_ret) == VC_AGG: sret_v = vreg(VI)
    if fns[f].has_env: env_v = vreg(VI)
    if fns[f].kind == FK_LAMBDA: env_layout(f)
    # parameters
    loop i in 0.. and l in fns[f].params:
        t = int(locals[l].type)
        pv = 0
        if int(locals[l].flags) & LF_MUTPARAM != 0 or vc(t) == VC_AGG: pv = vreg(VI)
        else: pv = vreg(vt_of(t))
        locals[l].vreg = i32(pv)
        locals[l].offset = -1
    ir.nparams = ir.vtypes.len()
    partition_begin(f)
    if refine_active: refine_gen_entry(f)
    ir.ret = ret_vt(cur_ret)
    if fns[f].decl != 0 and not target_arm64 and not target_wasm and not dbg_on and modules[int(fns[f].mod)].is_prelude:
        # (the declaration scanner's searches, lib/core/str.jo: sixteen bytes at a time)
        set = find_bytes_set(int(nodes[int(fns[f].decl)].name))
        if set >= 0:
            ir.raw_mem = true
            result = vreg(VI)
            emit(.findb, VI, result, 0, 1, 2, set)
            e_ret(result)
            return
    if (f == runtime_memeq or f == runtime_streq) and not target_arm64 and not target_wasm and not dbg_on:
        # Ordinary scalar body remains available to the bootstrap, debugger and
        # other targets. Select only the exact private runtime instances.
        ir.raw_mem = true
        result = vreg(VI)
        operation = Op.memeq
        count = 2
        if f == runtime_streq:
            operation = .streq
            count = 0
        emit(operation, VI, result, 0, 1, count, 0)
        e_ret(result)
        return
    # (called from C, whose callers leave the upper bits of narrow integers undefined: made
    # what Sloppy code expects of them)
    if fns[f].cabi:
        # (C may call it from a thread of its own: the allocator tells threads apart from now on)
        if let ct = prelude.get(intern("__c_threads")):
            if syms[ct].kind == .global: e_store(e_gaddr(global_addr_off(int(syms[ct].ref))), 0, e_iconst(1), 1)
        loop l in fns[f].params:
            t = prune(int(locals[l].type))
            if types[t].kind == .int_ and tsize(t) < 8 and int(locals[l].flags) & LF_MUTPARAM == 0: e_mov(int(locals[l].vreg), norm(int(locals[l].vreg), t))
    # Bind read-only Dewy value parameters before allocating local storage.
    # These declarations form a contiguous synthetic prefix. Rebind on every
    # lowering so watch/repl and debug builds cannot reuse old virtual registers.
    body = int(fns[f].body)
    loop i in [0..nkids(body)):
        s = kid(body, i)
        if nodes[s].kind != .vardecl or nodes[s].aux2 != 1: break
        if nkids(s) > 0 or has_flag(s, NF_GLOBAL): continue
        l = int(nodes[s].sym)
        if l < 0: continue
        locals[l].flags &= i32(~LF_PARAM)
        param_view_decl(s, l)
    find_views(f)
    if copies_on:
        icb = ic_phase(IC_OWNERSHIP)
        copies_prepare(f)
        ic_restore(icb)
    # locals
    loop l in fns[f].locals:
        fl = int(locals[l].flags)
        t = int(locals[l].type)
        if t == T_MATH_INT and fl & LF_ASSIGNED != 0: math_has_mutable = true
        if fl & (LF_CAPTURE | LF_ALIAS) != 0: continue
        if fl & LF_PARAM != 0:
            if copy_inputs.has(l) and not files[pos_file(nodes[int(fns[f].decl)].pos)].is_dewy:
                s = new_temp(t)
                store_val(t, e_slot(s), 0, int(locals[l].vreg))
                locals[l].offset = i32(s)
                continue
            if fl & LF_ADDR != 0 and fl & LF_MUTPARAM == 0 and vc(t) != VC_AGG:
                # address-taken scalar parameter: move to memory
                s = new_slot(8, 8)
                store_val(t, e_slot(s), 0, int(locals[l].vreg))
                locals[l].offset = i32(s)
            continue
        locals[l].offset = -1
        if fl & LF_BYREF != 0:
            locals[l].vreg = i32(vreg(VI))
            continue
        t = store_type(l)
        if vc(t) == VC_AGG or fl & LF_ADDR != 0 or ownership_type(t):
            s = new_slot(tsize(t), talign(t))
            locals[l].offset = i32(s)
            if is_managed(t): e_zero(e_slot(s), tsize(t))
            continue
        locals[l].vreg = i32(vreg(vt_of(t)))
        if is_managed(t): e_mov(int(locals[l].vreg), e_iconst(0))
    exm_censuses = {}; lower_entry = []
    exm_start = ir.code.len()
    if exact_loop_plan(f, body):
        guard = exact_loop_guard(body)
        iff(guard)
        exact_loop_fast = true
        lower_inst_body(f, body)
        exact_loop_fast = false
        endc()
    lower_inst_body(f, body)
    if lower_entry.len() > 0:
        loop i in [0..lower_zeros.len()):
            if lower_zeros[i].mark >> 32 >= exm_start: lower_zeros[i].mark += lower_entry.len() << 32
        ir.code = ir.code[..exm_start) + lower_entry + ir.code[exm_start..]
    if vc(cur_ret) == VC_AGG: e_ret(sret_v)
    else if vc(cur_ret) == VC_VOID: e_ret(-1)
    else: e_trap()
    owner_end()
    if dbg_on:
        loop l in fns[f].params: ir.dbg_locals.push(l)
        loop l in fns[f].locals:
            if int(locals[l].flags) & LF_PARAM == 0: ir.dbg_locals.push(l)

lower_inst_body = (f: int, body: int) -> void:
    guarded = lower_length_guards.len()
    scope_push()
    if ownership_decls.len() != 0 and fns[f].decl != 0 and not files[pos_file(nodes[int(fns[f].decl)].pos)].is_dewy:
        loop p in fns[f].params:
            if copy_inputs.has(p): scope_add_local(p)
    if fns[f].kind == FK_INIT:
        gen_block_stmts(body)
    else:
        n = nkids(body)
        loop i in [0..n):
            cur_block = body
            cur_block_i = i
            s = kid(body, i)
            if i == n - 1 and nodes[body].aux != 0 and vc(cur_ret) != VC_VOID:
                r = mk(.return_, nodes[s].pos)
                nodes[r].a = nodes[s].a
                # (its line, as a statement's: for backtraces and debuggers)
                ir_set_pos(nodes[s].pos)
                gen_return(r)
                continue
            gen_stmt(s)
            lower_length_guard(s)
    lower_length_guards.truncate(guarded)
    scope_pop()

lop_watch = false       # (loops in this function count down to the web page's watchdog)

lower_function = (lf: int):
    lower_epoch += 1
    lower_planning = true
    parallel_serial = lfuncs[lf].kind == LK_HELPER and (lfuncs[lf].hkind == HK.parallel_serial or lfuncs[lf].hkind == HK.partition and lfuncs[lf].htype == 1)
    partition_mode = lfuncs[lf].kind == LK_HELPER and lfuncs[lf].hkind == HK.partition
    if lfuncs[lf].kind == LK_INST or parallel_serial or partition_mode: pc_restore(lfuncs[lf].inst)
    fact_storage_cache.clear()
    lpath_ids.clear()
    lpath_parents.truncate(1)
    f = lfuncs[lf]
    lop_watch = false
    if want_loop_watch and f.kind == LK_INST and prelude.get(intern("__loop_budget")) != none:
        fi0 = f.inst
        d0 = int(fns[fi0].decl)
        if d0 != 0: lop_watch = not pos_in_lib(nodes[d0].pos)
        else: lop_watch = fns[fi0].kind == FK_INIT and not modules[int(fns[fi0].mod)].is_prelude
    # (generated helpers have no place in the source)
    ir_pos = 0
    if f.kind == LK_INST:
        fi = f.inst
        if fns[fi].kind == FK_PARTIAL: lower_partial_thunk(lf, fi)
        else: lower_inst(lf, fi)
    else if parallel_serial or partition_mode: lower_inst(lf, f.inst)
    else: lower_helper(lf)
    parallel_serial = false
    partition_mode = false
    lower_finish()
    lower_planning = false

# Only functions with demanded insertions or construction/owner placeholders
# need a final IR walk. P requested zeros cost O(P log P) ordering and one
# O(IR + P) merge; the ordinary path is O(1), with no full-code copy or scan.
# Equal instruction boundaries retain statement-entry order through the serial.
lower_finish = ():
    if lower_zeros.len() == 0:
        if not lower_has_nops: return
        k = 0
        loop ins in ir.code:
            if ins.op != .nop:
                ir.code[k] = ins
                k += 1
        ir.code.truncate(k)
        return
    lower_zeros.sort_by((z: LowerZero) -> int: z.mark)
    out: Ins[]
    out.reserve(ir.code.len() + lower_zeros.len())
    next = 0
    loop i in [0..ir.code.len() + 1):
        loop next < lower_zeros.len() and lower_zeros[next].mark >> 32 == i:
            z = lower_zeros[next]
            out.push(Ins(.zeroslots, 0, 0, i32(z.start), i32(z.count), 0, 0))
            next += 1
        if i < ir.code.len() and ir.code[i].op != .nop: out.push(ir.code[i])
    ir.code = out

# ---------------- generated helper functions ----------------
lower_partial_thunk = (lf: int, th: int):
    pass

helper_params = (n: int) -> int[]:
    ps: int[]
    loop i in [0..n): ps.push(vreg(VI))
    ir.nparams = n
    ps

each_field = (t0: int, addr: int, f: (int, int) -> void):
    pass

field_list = (t0: int) -> (int, int)[]:
    # (type, offset) of each member of a struct/tuple
    t = quantity_base(t0)
    layout(t)
    out: (int, int)[]
    if types[t].kind == .struct_:
        si = int(types[t].st)
        loop i in [0..int(structs[si].nfields)):
            f = int(structs[si].fields) + i
            out.push((field_store_type(f), int(fields[f].offset)))
    else if types[t].kind == .tuple:
        loop i in [0..int(types[t].nargs)): out.push((targ(t, i), tuple_off(t, i)))
    out

helper_drop = (t: int, copy: bool):
    ps = helper_params(1)
    a = ps[0]
    k = types[t].kind
    if ownership_type(t):
        if copy:
            if not ownership_copyable(t): ice("copy helper requested for move-only owner")
            if let hook = ownership_copies.get(t):
                result = e_slot(new_temp(t))
                owner_hook_into(hook, a, t, result)
                e_copy(a, result, tsize(t))
                return e_ret(-1)
            if k == .struct_ and not ownership_inline(t):
                return helper_owner_record_copy(a, t)
        else if k == .struct_:
            hook = int(structs[int(types[t].st)].drop_fn)
            if hook != 0: e_call1(lf_of_inst(hook), a, -1)
    if k == .array or k == .box:
        if copy: copy_at(a, t)
        else: release(e_load(VI, a, 0, ptr_size), t)
    else if k == .fn_ or k == .polyfn or k == .callable:
        env = e_load(VI, a, ptr_size, ptr_size)
        if copy:
            iff(e_bin(.ne, VI, env, e_iconst(0)))
            cf = e_load(VI, env, 16, ptr_size)
            e_store(a, ptr_size, e_calli(cf, [env], VI, false), ptr_size)
            endc()
        else:
            iff(e_call1(rt("__rc_dec_test"), env, VI))
            df = e_load(VI, env, 8, ptr_size)
            e_calli(df, [env], -1, false)
            endc()
    else if k == .opt:
        inner = int(types[t].elem)
        iff(e_bin(.ne, VI, opt_has(a, inner), e_iconst(0)))
        if copy: copy_at(a, inner)
        else: drop_embedded(a, inner)
        endc()
    else if k == .enum_:
        si = int(types[t].st)
        layout(t)
        tag = e_load(VI, a, 0, 4)
        loop v in [0..int(structs[si].nvariants)):
            vi = int(structs[si].variants) + v
            any = false
            loop i in [0..int(variants[vi].nfields)):
                if is_managed(field_store_type(int(variants[vi].fields) + i)): any = true
            if not any: continue
            iff(e_bin(.eq, VI, tag, e_iconst(v)))
            loop i in [0..int(variants[vi].nfields)):
                f = int(variants[vi].fields) + i
                ft = field_store_type(f)
                if copy: copy_at(e_addi(a, int(fields[f].offset)), ft)
                else: drop_at(e_addi(a, int(fields[f].offset)), ft)
            endc()
    else if k == .fixed:
        et = int(types[t].elem)
        if is_managed(et):
            i = fixed_loop_begin(t)
            index = if copy: i else: e_bin(.sub, VI, e_iconst(fixed_len(t) - 1), i)
            ea = fixed_elem_addr(a, index, et)
            if copy: copy_at(ea, et)
            else: drop_embedded(ea, et)
            fixed_loop_end(i)
    else:
        fs = field_list(t)
        loop i in [0..fs.len()):
            fo = fs[if copy: i else: fs.len() - 1 - i]
            if not is_managed(fo.0): continue
            if copy: copy_at(e_addi(a, fo.1), fo.0)
            else: drop_embedded(e_addi(a, fo.1), fo.0)
    e_ret(-1)

# a loop over the elements of fixed-size array type t: i counts 0..N (the body goes between)
fixed_loop_begin = (t: int) -> int:
    i = vreg(VI)
    e_mov(i, e_iconst(0))
    blk()
    lop()
    brif_to(e_bin(.ges, VI, i, e_iconst(fixed_len(t))), ctl - 1)
    i

fixed_loop_end = (i: int):
    e_mov(i, e_addi(i, 1))
    br_to(ctl)
    endc()
    endc()

fixed_elem_addr = (a: int, i: int, et: int) -> int: e_bin(.add, VI, a, e_bin(.mul, VI, i, e_iconst(tsize(et))))

helper_arrrel = (t: int):
    ps = helper_params(1)
    p = ps[0]
    et = int(types[t].elem)
    iff(e_call1(rt("__rc_dec_test"), p, VI))
    n = hdr_load(p, 8)
    i = vreg(VI)
    e_mov(i, e_iconst(0))
    blk()
    lop()
    brif_to(e_bin(.ges, VI, i, n), ctl - 1)
    owner_element_drop(e_bin(.add, VI, e_addi(p, 24), e_bin(.mul, VI, (if ownership_type(et): e_bin(.sub, VI, e_addi(n, -1), i) else: i), e_iconst(owner_stride(et)))), et)
    e_mov(i, e_addi(i, 1))
    br_to(ctl)
    endc()
    endc()
    e_call1(rt("__free_obj"), p, -1)
    endc()
    e_ret(-1)

helper_arruniq = (t: int):
    # takes the array pointer, returns a uniquely owned array pointer
    ps = helper_params(1)
    ir.ret = VI
    p = ps[0]
    et = int(types[t].elem)
    r = vreg(VI)
    e_mov(r, p)
    iff(e_bin(.ne, VI, p, e_iconst(0)))
    iff(e_bin(.ne, VI, hdr_load(p, 0), e_iconst(1)))
    e_mov(r, e_call2(rt("__arr_clone"), p, e_iconst(owner_stride(et)), VI))
    if is_managed(et) and ownership_copyable(et): retain_elems(r, et)
    endc()
    endc()
    e_ret(r)

# Value equality/hash can call user-defined member operations. Keep the
# enclosing value alive and independent throughout those calls, including a
# surrounding array whose owner a callback could replace. When all reachable
# member operations leave global state alone, helpers keep the pure read path.
value_member_cache: {int: int[]} = {}

helper_value_members = (t: int, hashing: bool = false) -> int[]:
    if value_equal_fns.len() == 0 and value_hash_fns.len() == 0: return []
    key = t * 2 + int(hashing)
    if let cached = value_member_cache.get(key): return cached
    result: int[]
    pending = [t]
    seen: {int: bool} = {}
    loop pending.len() > 0:
        current = prune(pending.pop())
        if seen.has(current): continue
        seen[current] = true
        f = value_equal_fns.get(current) ?? 0
        if hashing: f = value_hash_fns.get(current) ?? 0
        if f != 0:
            result.push(f)
            continue
        k = types[current].kind
        if k == .array or k == .fixed or k == .opt or k == .box: pending.push(int(types[current].elem))
        else if k == .struct_ or k == .tuple:
            loop field in field_list(current): pending.push(field.0)
        else if k == .enum_:
            layout(current)
            si = int(types[current].st)
            loop i in [0..int(structs[si].nvariants)):
                vi = int(structs[si].variants) + i
                loop j in [0..int(variants[vi].nfields)):
                    pending.push(int(fields[int(variants[vi].fields) + j].type))
    value_member_cache[key] = result
    result

helper_callback_snapshot = (t: int, hashing: bool = false) -> bool:
    loop f in helper_value_members(t, hashing):
        writes = fn_writes(f)
        if writes.all or writes.globals.len() > 0: return true
    false

# Calls made by generated aggregate helpers still participate in ordinary
# alias/effect analysis, just like calls written explicitly in the source.
value_helper_calls = (n: int) -> int[]:
    if value_equal_fns.len() == 0 and value_hash_fns.len() == 0: return []
    t = 0
    hashing = false
    if nodes[n].kind == .intrinsic and nodes[n].aux == i32(int(IN.hash)) and nkids(n) > 0:
        t = ntype(kid(n, 0))
        hashing = true
    else if nodes[n].kind == .binary and nodes[n].aux == 1:
        op = nodes[n].op as Tok
        if op == .eq or op == .ne: t = ntype(int(nodes[n].a))
    if t == 0: return []
    helper_value_members(t, hashing)

helper_value_snapshot = (t: int, source: int) -> int:
    result = e_slot(new_temp(t))
    e_copy(result, source, tsize(t))
    copy_at(result, t)
    result

# a box's last reference gone: its value dropped and the box freed. Boxes that dropping it frees
# wait their turn (__box_defer), so a list a million long is freed in a loop, not a million calls
# deep: the first box dropped on a thread drops those after it (__box_next)
helper_boxrel = (t: int):
    ps = helper_params(1)
    p = ps[0]
    drop = lf_helper(.boxdrop, t, 0)
    iff(e_call1(rt("__rc_dec_test"), p, VI))
    iff(e_bin(.eq, VI, e_call2(rt("__box_defer"), p, e_faddr(drop), VI), e_iconst(0)))
    e_call1(drop, p, -1)
    blk()
    lop()
    q = e_call0(rt("__box_next"), VI)
    brif_to(e_bin(.eq, VI, q, e_iconst(0)), ctl - 1)
    e_calli(e_load(VI, q, ptr_size, ptr_size), [e_load(VI, q, 0, ptr_size)], -1, false)
    br_to(ctl)
    endc()
    endc()
    endc()
    endc()
    e_ret(-1)

# (the box p's value dropped, and the box freed)
helper_boxdrop = (t: int):
    ps = helper_params(1)
    p = ps[0]
    drop_embedded(e_addi(p, BOX_HDR), int(types[t].elem))
    e_call2(rt("__box_free"), p, e_iconst(tsize(int(types[t].elem))), -1)
    e_ret(-1)

# takes a box, gives back one with no other reference: itself, or a copy holding what it holds
helper_boxuniq = (t: int):
    ps = helper_params(1)
    ir.ret = VI
    p = ps[0]
    et = int(types[t].elem)
    # Resource snapshots copy eagerly, so mutable access never detaches a
    # shared resource box or invents a copy of a move-only payload.
    if ownership_type(t): return e_ret(p)
    r = vreg(VI)
    e_mov(r, p)
    iff(e_bin(.ne, VI, p, e_iconst(0)))
    iff(e_bin(.ne, VI, hdr_load(p, 0), e_iconst(1)))
    e_mov(r, e_call2(rt("__box_clone"), p, e_iconst(tsize(et)), VI))
    copy_at(e_addi(r, BOX_HDR), et)
    endc()
    endc()
    e_ret(r)

helper_eq = (t: int):
    ps = helper_params(2)
    if t == T_MATH_INT:
        ir.ret = VI
        e_ret(math_compare(.eq, e_load(VI, ps[0], 0, 8), e_load(VI, ps[1], 0, 8)))
        return
    ir.ret = VI
    a = ps[0]
    b = ps[1]
    snapshot = helper_callback_snapshot(t)
    if snapshot:
        a = helper_value_snapshot(t, a)
        b = helper_value_snapshot(t, b)
    f = value_equal_fns.get(t) ?? 0
    if f != 0:
        result = e_call2(lf_of_inst(f), a, b, VI)
        if snapshot:
            drop_at(a, t)
            drop_at(b, t)
        e_ret(result)
        return
    r = vreg(VI)
    e_mov(r, e_iconst(0))
    blk()
    fail = ctl
    k = types[t].kind
    if k == .struct_ or k == .tuple:
        loop fo in field_list(t): eq_member(fo.0, e_addi(a, fo.1), e_addi(b, fo.1), fail)
    else if k == .fixed:
        et = int(types[t].elem)
        i = fixed_loop_begin(t)
        eq_member(et, fixed_elem_addr(a, i, et), fixed_elem_addr(b, i, et), fail)
        fixed_loop_end(i)
    else if k == .opt:
        inner = int(types[t].elem)
        ha = opt_has(a, inner)
        hb = opt_has(b, inner)
        brif_to(e_bin(.ne, VI, ha, hb), fail)
        iff(ha)
        if math_optional(t):
            brif_to(e_bin(.eq, VI, math_compare(.eq, opt_value(a, inner), opt_value(b, inner)), e_iconst(0)), fail)
        else: eq_member(inner, a, b, fail)
        endc()
    else if k == .enum_:
        si = int(types[t].st)
        layout(t)
        ta = e_load(VI, a, 0, 4)
        brif_to(e_bin(.ne, VI, ta, e_load(VI, b, 0, 4)), fail)
        loop v in [0..int(structs[si].nvariants)):
            vi = int(structs[si].variants) + v
            if variants[vi].nfields == 0: continue
            iff(e_bin(.eq, VI, ta, e_iconst(v)))
            loop i in [0..int(variants[vi].nfields)):
                f = int(variants[vi].fields) + i
                eq_member(field_store_type(f), e_addi(a, int(fields[f].offset)), e_addi(b, int(fields[f].offset)), fail)
            endc()
    else if k == .array:
        et = int(types[t].elem)
        pa = e_load(VI, a, 0, ptr_size)
        pb = e_load(VI, b, 0, ptr_size)
        na = arr_len(pa)
        brif_to(e_bin(.ne, VI, na, arr_len(pb)), fail)
        ek = types[prune(et)].kind
        bits_equal = (ek == .int_ and et != T_MATH_INT) or ek == .bool_
        if bits_equal:
            # A single scalar needs neither a word loop nor a tail loop.
            iff(e_bin(.eq, VI, na, e_iconst(1)))
            eq_member(et, e_addi(pa, 24), e_addi(pb, 24), fail)
            e_mov(r, e_iconst(1))
            br_to(fail)
            endc()
            # Only reflexive scalar equality: floats may contain NaN, and a
            # record protocol may have effects even when storage is shared.
            iff(e_bin(.eq, VI, pa, pb))
            e_mov(r, e_iconst(1))
            br_to(fail)
            endc()
        if bits_equal and owner_stride(et) < 8:
            # Emit the word loop here so the equality helper stays a leaf and
            # release builds can inline it. Finish with whole element loads.
            bytes = e_bin(.mul, VI, na, e_iconst(owner_stride(et)))
            i = vreg(VI)
            e_mov(i, e_iconst(0))
            blk()
            lop()
            brif_to(e_bin(.gts, VI, e_addi(i, 8), bytes), ctl - 1)
            aa = e_bin(.add, VI, e_addi(pa, 24), i)
            bb = e_bin(.add, VI, e_addi(pb, 24), i)
            brif_to(e_bin(.ne, VI, e_load(VI, aa, 0, 8), e_load(VI, bb, 0, 8)), fail)
            e_mov(i, e_addi(i, 8))
            br_to(ctl)
            endc()
            endc()
            blk()
            lop()
            brif_to(e_bin(.ges, VI, i, bytes), ctl - 1)
            eq_member(et, e_bin(.add, VI, e_addi(pa, 24), i), e_bin(.add, VI, e_addi(pb, 24), i), fail)
            e_mov(i, e_addi(i, owner_stride(et)))
            br_to(ctl)
            endc()
            endc()
        else:
            i = vreg(VI)
            e_mov(i, e_iconst(0))
            blk()
            lop()
            brif_to(e_bin(.ges, VI, i, na), ctl - 1)
            off = e_bin(.mul, VI, i, e_iconst(owner_stride(et)))
            eq_member(et, e_bin(.add, VI, e_addi(pa, 24), off), e_bin(.add, VI, e_addi(pb, 24), off), fail)
            e_mov(i, e_addi(i, 1))
            br_to(ctl)
            endc()
            endc()
    else if k == .vec:
        loop i in [0..vec_comps(t)):
            if types[t].sign:
                brif_to(e_bin(.ne, VI, e_load(VI, a, 4 * i, 4), e_load(VI, b, 4 * i, 4)), fail)
            else:
                brif_to(e_bin(.fne, VS, e_load(VS, a, 4 * i, 4 | M_FLOAT), e_load(VS, b, 4 * i, 4 | M_FLOAT)), fail)
    else: eq_member(t, a, b, fail)
    e_mov(r, e_iconst(1))
    endc()
    if snapshot:
        drop_at(a, t)
        drop_at(b, t)
    e_ret(r)

# compare members at addresses a and b; branch to `fail` level when different
eq_member = (t0: int, a: int, b: int, fail: int):
    t = quantity_base(t0)
    k = types[t].kind
    if k == .box:
        # (the same box, or both empty: equal without looking inside)
        pa = e_load(VI, a, 0, ptr_size)
        pb = e_load(VI, b, 0, ptr_size)
        blk()
        same = ctl
        brif_to(e_bin(.eq, VI, pa, pb), same)
        et = prune(int(types[t].elem))
        va = box_val(pa, et)
        vb = box_val(pb, et)
        if types[et].kind == .opt:
            # (an optional's flags here, its value by the value's helper: one call deep for each
            # node of a list, not two)
            inner = int(types[et].elem)
            ha = opt_has(va, inner)
            brif_to(e_bin(.ne, VI, ha, opt_has(vb, inner)), fail)
            brif_to(e_bin(.eq, VI, ha, e_iconst(0)), same)
            et = prune(inner)
        r = e_call2(lf_helper(.eq, et, 0), va, vb, VI)
        brif_to(e_bin(.eq, VI, r, e_iconst(0)), fail)
        endc()
        return
    if k == .str_:
        r = e_call2(rt("__str_eq"), e_load(VI, a, 0, ptr_size), e_load(VI, b, 0, ptr_size), VI)
        brif_to(e_bin(.eq, VI, r, e_iconst(0)), fail)
        return
    c = vc(t)
    if math_optional(t):
        brif_to(e_bin(.eq, VI, e_call2(lf_helper(.eq, t, 0), a, b, VI), e_iconst(0)), fail)
        return
    if t == T_MATH_INT:
        brif_to(e_bin(.eq, VI, math_compare(.eq, load_val(t, a, 0), load_val(t, b, 0)), e_iconst(0)), fail)
        return
    if c == VC_INT and k != .array:
        brif_to(e_bin(.ne, VI, load_val(t, a, 0), load_val(t, b, 0)), fail)
        return
    if c == VC_FLT:
        brif_to(e_bin(.fne, vt_of(t), load_val(t, a, 0), load_val(t, b, 0)), fail)
        return
    if k == .fn_ or k == .polyfn or k == .callable:
        brif_to(e_bin(.ne, VI, e_load(VI, a, 0, ptr_size), e_load(VI, b, 0, ptr_size)), fail)
        return
    r = e_call2(lf_helper(.eq, t, 0), a, b, VI)
    brif_to(e_bin(.eq, VI, r, e_iconst(0)), fail)

# Keyed (a dictionary's slots, lib/core/map.jo): every member word mixed under the process's
# secret key (__hk_mix), strings by __hk_bytes, and a type's own hash's result under the key.
hk_key = 0          # (the key's register in the keyed helper being lowered, else 0)

helper_hash = (t: int, keyed: bool = false):
    ps = helper_params(1)
    if t == T_MATH_INT:
        ir.ret = VI
        e_ret(e_call1(rt(if keyed: "__mi_khash" else: "__mi_hash"), e_load(VI, ps[0], 0, 8), VI))
        return
    ir.ret = VI
    a = ps[0]
    snapshot = helper_callback_snapshot(t, true)
    if snapshot: a = helper_value_snapshot(t, a)
    f = value_hash_fns.get(t) ?? 0
    if f != 0:
        result = e_call1(lf_of_inst(f), a, VI)
        if keyed: result = e_call1(rt("__hk_word"), result, VI)
        if snapshot: drop_at(a, t)
        e_ret(result)
        return
    h = vreg(VI)
    hk_key = 0
    if keyed:
        # (no check that it is drawn: before a dictionary's first entry is added, __map_add
        # draws it and hashes that key again; an empty dictionary reads no slots)
        s = prelude.get(intern("__hash_key")) ?? 0
        if s == 0 or syms[s].kind != .global: ice("missing runtime global __hash_key")
        hk_key = e_load(VI, e_gaddr(global_addr_off(int(syms[s].ref))), 0, 8)
        e_mov(h, e_iconst(0))
    else: e_mov(h, e_iconst(0xcbf29ce484222325))
    # (what helper_eq compares, and nothing else: equal values hash alike)
    k = types[t].kind
    if k == .struct_ or k == .tuple:
        loop fo in field_list(t): hash_member(h, fo.0, e_addi(a, fo.1))
    else if k == .fixed:
        et = int(types[t].elem)
        i = fixed_loop_begin(t)
        hash_member(h, et, fixed_elem_addr(a, i, et))
        fixed_loop_end(i)
    else if k == .opt:
        inner = int(types[t].elem)
        has = opt_has(a, inner)
        hash_mix(h, has)
        iff(has)
        if math_optional(t): hash_mix(h, e_call1(rt(if hk_key != 0: "__mi_khash" else: "__mi_hash"), opt_value(a, inner), VI))
        else: hash_member(h, inner, a)
        endc()
    else if k == .enum_:
        si = int(types[t].st)
        layout(t)
        tag = e_load(VI, a, 0, 4)
        hash_mix(h, tag)
        loop v in [0..int(structs[si].nvariants)):
            vi = int(structs[si].variants) + v
            if variants[vi].nfields == 0: continue
            iff(e_bin(.eq, VI, tag, e_iconst(v)))
            loop i in [0..int(variants[vi].nfields)):
                f = int(variants[vi].fields) + i
                hash_member(h, field_store_type(f), e_addi(a, int(fields[f].offset)))
            endc()
    else if k == .array:
        et = int(types[t].elem)
        p = e_load(VI, a, 0, ptr_size)
        n = arr_len(p)
        hash_mix(h, n)
        i = vreg(VI)
        e_mov(i, e_iconst(0))
        blk()
        lop()
        brif_to(e_bin(.ges, VI, i, n), ctl - 1)
        hash_member(h, et, e_bin(.add, VI, e_addi(p, 24), e_bin(.mul, VI, i, e_iconst(owner_stride(et)))))
        e_mov(i, e_addi(i, 1))
        br_to(ctl)
        endc()
        endc()
    else if k == .vec:
        loop i in [0..vec_comps(t)):
            if types[t].sign: hash_mix(h, e_load(VI, a, 4 * i, 4))
            else: hash_mix(h, hash_float(e_load(VS, a, 4 * i, 4 | M_FLOAT), VS))
    else: hash_member(h, t, a)
    if snapshot: drop_at(a, t)
    hk_key = 0
    e_ret(h)

hash_mix = (h: int, x: int):
    if hk_key != 0:
        # (__hk_mix(key, h xor x): the folded 128-bit product of h ^ x ^ key and key ^ C)
        a = e_bin(.xor, VI, e_bin(.xor, VI, h, x), hk_key)
        b = e_bin(.xor, VI, hk_key, e_iconst(0xE7037ED1A0B428DB))
        if mulh_ok: e_mov(h, e_bin(.xor, VI, e_bin(.mul, VI, a, b), e_bin(.mulhu, VI, a, b)))
        else: e_mov(h, e_call2(rt("__hk_mix"), hk_key, e_bin(.xor, VI, h, x), VI))
        return
    m = e_bin(.mul, VI, e_bin(.xor, VI, h, x), e_iconst(0x100000001b3))
    e_mov(h, e_bin(.xor, VI, m, e_bin(.shru, VI, m, e_iconst(29))))

# the bits of float v, with -0.0 as 0.0 (they are equal)
hash_float = (v: int, ty: int) -> int:
    d = vreg(VI)
    emit(.f2bits, ty, d, e_bin(.fadd, ty, v, e_fconst(0.0, ty)), 0, 0, 0)
    d

hash_member = (h: int, t0: int, a: int):
    t = quantity_base(t0)
    k = types[t].kind
    c = vc(t)
    x = 0
    hp = int(hk_key != 0)
    if k == .str_: x = e_call1(rt(if hp != 0: "__str_khash" else: "__str_hash"), e_load(VI, a, 0, ptr_size), VI)
    else if k == .box:
        et = prune(int(types[t].elem))
        va = box_val(e_load(VI, a, 0, ptr_size), et)
        if types[et].kind == .opt:
            # (as helper_hash does for an optional, but one call deep for each node of a list)
            inner = int(types[et].elem)
            has = opt_has(va, inner)
            hash_mix(h, has)
            iff(has)
            hash_mix(h, e_call1(lf_helper(.hash, prune(inner), hp), va, VI))
            endc()
            return
        x = e_call1(lf_helper(.hash, et, hp), va, VI)
    else if math_optional(t): x = e_call1(lf_helper(.hash, t, hp), a, VI)
    else if t == T_MATH_INT: x = e_call1(rt(if hp != 0: "__mi_khash" else: "__mi_hash"), load_val(t, a, 0), VI)
    else if c == VC_INT and k != .array: x = load_val(t, a, 0)
    else if c == VC_FLT: x = hash_float(load_val(t, a, 0), vt_of(t))
    else if k == .fn_ or k == .polyfn or k == .callable: x = e_load(VI, a, 0, ptr_size)
    else if (c == VC_AGG or k == .array) and helper_hash_differs(t): x = e_call1(lf_helper(.hash, t, hp), a, VI)
    else: return
    hash_mix(h, x)

# does helper_hash for t do more than hash_member for t (which would call it again)?
helper_hash_differs = (t: int) -> bool:
    if t == T_MATH_INT: return true
    k = types[t].kind
    k == .struct_ or k == .tuple or k == .fixed or k == .opt or k == .enum_ or k == .array or k == .vec

helper_thunk = (f: int):
    # (sret?, env, args...) -> f(sret?, args...)
    ret = int(fns[f].ret)
    sret = vc(ret) == VC_AGG
    n = fns[f].ptypes.len()
    argv: int[]
    if sret: argv.push(vreg(VI))
    vreg(VI) # env (ignored)
    mm = inst_mutmask(f)
    loop i in [0..n):
        t = fns[f].ptypes[i]
        if mm & (1 << i) != 0 or vc(t) == VC_AGG: argv.push(vreg(VI))
        else: argv.push(vreg(vt_of(t)))
    ir.nparams = ir.vtypes.len()
    ir.ret = ret_vt(ret)
    r = e_call(lf_of_inst(f), argv, ret_vt(ret))
    if sret: e_ret(argv[0])
    else: e_ret(r)

helper_partial = (th: int):
    e = int(fns[th].partial)
    target = int(nodes[e].sym)
    offs = partial_layout(e)
    ret = int(fns[th].ret)
    sret = vc(ret) == VC_AGG
    sv = -1
    if sret: sv = vreg(VI)
    env = vreg(VI)
    hole_vs: int[]
    hmm = int(types[prune(ntype(e))].mutmask)
    loop i in 0.. and t in fns[th].ptypes:
        if hmm & (1 << i) != 0 or vc(t) == VC_AGG: hole_vs.push(vreg(VI))
        else: hole_vs.push(vreg(vt_of(t)))
    ir.nparams = ir.vtypes.len()
    ir.ret = ret_vt(ret)
    argv: int[]
    if sret: argv.push(sv)
    if nodes[e].aux == 1: argv.push(e_load(VI, env, 24 + ptr_size, ptr_size))
    hk = 0
    loop i in [0..nkids(e)):
        a = kid(e, i)
        if nodes[a].kind == .hole:
            argv.push(hole_vs[hk])
            hk += 1
        else:
            t = ntype(a)
            if vc(t) == VC_AGG: argv.push(e_addi(env, offs[i]))
            else: argv.push(load_val(t, env, offs[i]))
    r = 0
    if target != 0: r = e_call(lf_of_inst(target), argv, ret_vt(ret))
    else:
        fp = e_load(VI, env, 24, ptr_size)
        r = e_calli(fp, argv, ret_vt(ret), false)
    if sret: e_ret(sv)
    else: e_ret(r)

helper_envdrop = (f: int, heap: bool = true):
    ps = helper_params(1)
    env = ps[0]
    if fns[f].kind == FK_PARTIAL:
        e = int(fns[f].partial)
        offs = partial_layout(e)
        if nodes[e].aux == 1: drop_at(e_addi(env, 24), ntype(int(nodes[e].a)))
        loop i in [0..nkids(e)):
            if offs[i] < 0: continue
            drop_at(e_addi(env, offs[i]), ntype(kid(e, i)))
    else:
        env_layout(f)
        resource = ownership_callable_cap(int(fns[f].fntype)) != 0
        loop i in [0..fns[f].caps.len()):
            index = fns[f].caps.len() - 1 - i
            inn = int(fns[f].caps[index].inner)
            t = store_type(inn)
            if is_managed(t):
                if resource: iff(e_bin(.gtu, VI, e_load(VI, env, 24, 8), e_iconst(index)))
                drop_embedded(e_addi(env, int(locals[inn].env_off)), t)
                if resource: endc()
    if heap: e_call1(rt("__free"), env, -1)
    e_ret(-1)

helper_envcopy = (f: int):
    ps = helper_params(1)
    ir.ret = VI
    src = ps[0]
    d = int(fns[f].decl)
    if fns[f].kind == FK_PARTIAL: d = int(fns[f].partial)
    if d == 0 or not files[pos_file(nodes[d].pos)].is_dewy:
        retain(src, T_STR)
        return e_ret(src)
    if fns[f].kind != FK_PARTIAL:
        env_layout(f)
        mutable = false
        loop cap in fns[f].caps:
            inn = int(cap.inner)
            flags = int(locals[inn].flags)
            if flags & LF_VALUECAP != 0 and (flags & (LF_ASSIGNED | LF_EXPOSED) != 0 or is_shared(inn) or type_has_fn(int(locals[inn].type)) or ownership_type(int(locals[inn].type))): mutable = true
        if not mutable:
            retain(src, T_STR)
            return e_ret(src)
    if ownership_callable_cap(int(fns[f].fntype)) != 0:
        return helper_owner_envcopy(f, src)
    env = e_call1(rt("__alloc"), e_iconst(int(fns[f].env_size)), VI)
    e_copy(env, src, int(fns[f].env_size))
    hdr_store(env, 0, e_iconst(1))
    if fns[f].kind == FK_PARTIAL:
        offs = partial_layout(d)
        if nodes[d].aux == 1: copy_at(e_addi(env, 24), ntype(int(nodes[d].a)))
        loop i in [0..nkids(d)):
            if offs[i] >= 0: copy_at(e_addi(env, offs[i]), ntype(kid(d, i)))
    else:
        loop cap in fns[f].caps:
            inn = int(cap.inner)
            t = store_type(inn)
            addr = e_addi(env, int(locals[inn].env_off))
            if is_shared(inn):
                cell = e_load(VI, addr, 0, ptr_size)
                retain(cell, t)
                if int(locals[inn].flags) & LF_VALUECAP != 0:
                    e_store(addr, 0, e_call1(lf_helper(.arruniq, t, 0), cell, VI), ptr_size)
            else: copy_at(addr, t)
    e_ret(env)

lower_helper = (lf: int):
    h = lfuncs[lf]
    begin_fn(h.name, lf)
    t = quantity_base(h.htype)
    match h.hkind:
        drop: helper_drop(t, false)
        copy: helper_drop(t, true)
        move: helper_move(t)
        arrrel: helper_arrrel(t)
        arruniq: helper_arruniq(t)
        arrcopy: helper_owner_arrcopy(t)
        eq: helper_eq(t)
        hash: helper_hash(t, h.inst != 0)
        thunk: helper_thunk(h.inst)
        partial: helper_partial(h.inst)
        envdrop: helper_envdrop(h.inst)
        stackenvdrop: helper_envdrop(h.inst, false)
        envcopy: helper_envcopy(h.inst)

        boxrel: helper_boxrel(t)
        boxdrop: helper_boxdrop(t)
        boxuniq: helper_boxuniq(t)
        math_main: math_main(h.inst)
        owner_boxcopy: helper_owner_boxcopy(t)
        parallel_serial, partition: ice("borrowed region helper must lower as an instance")
        parallel_job: parallel_job_helper(h.inst, h.htype & 1 != 0, h.htype & 2 != 0)
        promote: helper_promote(t)

# native FFI: a thunk that resolves the C function on first use and calls it
# macOS: the C functions dyld puts in their slots when the program starts: (slot's offset in the
# data, library, symbol) -- compiler/macho.jo writes them as binds
mac_imports: (int, str, str)[]

# (macOS: the library dyld binds a C function from when the program starts, or "" for one loaded
# when first called (dlopen): system libraries by path, and Linux's libc as libSystem)
# (macOS: code compiled for a program already running -- the prompt's inputs, sloppy watch's
# later builds -- finds C functions when first called: dyld bound only what the program used.
# Not the functions that finding them takes, dlopen and dlsym: those programs have them bound,
# lib/std/repl.jo and lib/std/watch.jo)
late_binding = false

mac_bound_lib = (lib: str) -> str:
    if starts_with(lib, "/"): return lib
    if lib == "libc.so.6" or lib == "libm.so.6" or lib == "libdl.so.2" or lib == "libpthread.so.0": return "/usr/lib/libSystem.B.dylib"
    ""

# An optional raw pointer (Dewy's ptr<T>?), null at the C boundary when none.
c_nullable = (t0: int) -> bool:
    t = prune(t0)
    types[t].kind == .opt and tkind(int(types[t].elem)) == .ptr

lower_extern_thunk = (lf: int, f: int):
    begin_fn(fns[f].sym, lf)
    lib = fns[f].clib
    nm = name_of(int(nodes[int(fns[f].decl)].name))
    if len(fns[f].csym) > 0: nm = fns[f].csym
    ret = int(fns[f].ret)
    # (Dewy's ptr<T>?: an optional held as a value, null to C when it is none)
    sret = if c_nullable(ret): vreg(VI) else: -1
    ps: int[]
    loop t in fns[f].ptypes:
        if vc(t) == VC_AGG and not c_nullable(t): fatal(nodes[int(fns[f].decl)].pos, "C functions can only take scalar or pointer arguments")
        if tkind(t) == .array: fatal(nodes[int(fns[f].decl)].pos, "a C function cannot take an array: declare the parameter as a pointer (*f32) and pass data(xs)")
        ps.push(vreg(vt_of(t)))
    ir.nparams = ir.vtypes.len()
    # (a str goes to C as its bytes, ending in a zero byte: a char *)
    cps: int[]
    loop i in 0.. and t in fns[f].ptypes:
        if c_nullable(t):
            p = vreg(VI)
            e_mov(p, e_iconst(0))
            iff(opt_has(ps[i], int(types[prune(t)].elem)))
            e_mov(p, e_load(VI, ps[i], 0, 8))
            endc()
            cps.push(p)
        else if tkind(t) == .str_: cps.push(e_call1(rt("__c_str"), ps[i], VI))
        else if fns[f].cvariadic > 0 and i >= int(fns[f].cvariadic) - 1 and vt_of(t) == VS:
            # C promotes variadic floats to double. Fixed f32 parameters keep
            # their declared type; narrow integers already use extended registers.
            d = vreg(VF)
            emit(.f2f, VF, d, ps[i], 0, 0, 0)
            cps.push(d)
        else: cps.push(ps[i])
    if vc(ret) == VC_AGG and sret < 0: fatal(nodes[int(fns[f].decl)].pos, "C functions can only return scalars or pointers")
    ir.ret = ret_vt(ret)
    data_size = align_up(data_size, 8)
    slot = data_size
    data_size += 8
    ffi_slot[slot] = ffi_offs.len()
    ffi_offs.push(slot)
    ffi_keys.push("ffi|{lib}|{nm}")
    fp = vreg(VI)
    imp = -1
    if target_windows and lower(lib) == "kernel32.dll": imp = pe_imports.index_of(nm)
    if imp >= 0:
        # (one of the functions the program imports: from the import table, compiler/pe.jo)
        emit(.intr, VI, fp, 0, 0, i32(imp), 10)
    else if target_macos and len(mac_bound_lib(lib)) > 0 and (not late_binding or nm == "dlopen" or nm == "dlsym" or nm == "dlerror"):
        # (dyld has put it in the slot, or null where its library is missing)
        mac_imports.push((slot, mac_bound_lib(lib), nm))
        e_mov(fp, e_load(VI, e_gaddr(slot), 0, 8))
        iff(e_bin(.eq, VI, fp, e_iconst(0)))
        e_call2(rt("__ffi_missing"), e_daddr(str_data(lib)), e_daddr(str_data(nm)), -1)
        endc()
    else:
        rlib = lib
        if target_macos and len(mac_bound_lib(lib)) > 0: rlib = mac_bound_lib(lib)
        e_mov(fp, e_load(VI, e_gaddr(slot), 0, 8))
        iff(e_bin(.eq, VI, fp, e_iconst(0)))
        e_mov(fp, e_call2(rt("__ffi_resolve"), e_daddr(str_data(rlib)), e_daddr(str_data(nm)), VI))
        e_store(e_gaddr(slot), 0, fp, 8)
        endc()
    r = e_calli(fp, cps, (if sret >= 0: VI else: ret_vt(ret)), true)
    # (C's variadic arguments: on Apple's arm64 they go on the stack)
    if fns[f].cvariadic > 0: ir.code[ir.code.len() - 1].imm = int(fns[f].cvariadic)
    if sret >= 0:
        e_zero(sret, tsize(ret))
        e_store(sret, 0, r, 8)
        e_store(sret, 8, e_bin(.ne, VI, r, e_iconst(0)), 1)
        e_ret(sret)
        return
    if vc(ret) == VC_INT: r = norm(r, ret)
    e_ret(r)

# Embedded values have no independent stack record: their complete enclosing
# owner is the cleanup authority. Partial construction retains the field's
# temporary owner until the enclosing object is complete.
drop_embedded = (addr: int, t: int):
    if not is_managed(t): return
    if vc(t) == VC_INT: release(e_load(VI, addr, 0, ptr_size), t)
    else: e_call1(lf_helper(.drop, t, 0), addr, -1)

helper_move = (t: int):
    ps = helper_params(2)
    dest = ps[0]
    source = ps[1]
    if tkind(t) == .array or tkind(t) == .box or is_fn_type(t):
        e_copy(dest, source, tsize(t))
    else if tkind(t) == .opt:
        inner = telem(t)
        e_zero(dest, tsize(t))
        iff(opt_has(source, inner))
        e_call2(lf_helper(.move, inner, 0), dest, source, -1)
        e_store(dest, tsize(inner), e_iconst(1), 1)
        endc()
    else if tkind(t) == .fixed:
        et = telem(t)
        i = fixed_loop_begin(t)
        dst = fixed_elem_addr(dest, i, et)
        src = fixed_elem_addr(source, i, et)
        if ownership_type(et): e_call2(lf_helper(.move, et, 0), dst, src, -1)
        else: e_copy(dst, src, tsize(et))
        fixed_loop_end(i)
    else if let hook = ownership_moves.get(t):
        owner_hook_into(hook, source, t, dest)
        # A custom move consumes the outer owner. Its borrowed receiver's
        # fields still own their values unless transferred separately.
        parent = prune(int(fns[hook].ret))
        fs = field_list(parent)
        loop i in [0..fs.len()):
            field = fs[fs.len() - 1 - i]
            drop_embedded(e_addi(source, field.1), field.0)
    else:
        loop field in field_list(t):
            dst = e_addi(dest, field.1)
            src = e_addi(source, field.1)
            if ownership_type(field.0): e_call2(lf_helper(.move, field.0, 0), dst, src, -1)
            else: e_copy(dst, src, tsize(field.0))
    e_ret(-1)

# Publish only successfully initialized elements. The array owns the prefix
# during failures in later constructors; each pending element owns itself.
gen_owner_array = (e: int, t: int) -> Val:
    et = telem(t)
    s = new_temp(t)
    sa = e_slot(s)
    e_zero(sa, tsize(t))
    owner_register(s, t)
    building.push(BuildItem(true, s, t))
    if nodes[e].b != 0:
        value = gen_owned(kid(e, 0))
        n = gen_expr(int(nodes[e].b)).v
        e_call3(rt("__arr_reserve"), sa, e_iconst(owner_stride(et)), n, -1)
        i = vreg(VI)
        e_mov(i, e_iconst(0))
        blk()
        lop()
        brif_to(e_bin(.ges, VI, i, n), ctl - 1)
        element = own(Val(value.v, false, -1), et)
        dst = e_call2(rt("__arr_push_slot"), sa, e_iconst(owner_stride(et)), VI)
        store_val(et, dst, 0, element.v)
        owner_element_live(dst, et)
        owner_forget_slot(element.slot)
        e_mov(i, e_addi(i, 1))
        br_to(ctl)
        endc()
        endc()
        owner_drop(e_slot(value.slot))
    else:
        e_call3(rt("__arr_reserve"), sa, e_iconst(owner_stride(et)), e_iconst(nkids(e)), -1)
        loop i in [0..nkids(e)):
            value = gen_owned(kid(e, i))
            dst = e_call2(rt("__arr_push_slot"), sa, e_iconst(owner_stride(et)), VI)
            store_val(et, dst, 0, value.v)
            owner_element_live(dst, et)
            owner_forget_slot(value.slot)
    building.pop()
    result = e_load(VI, sa, 0, ptr_size)
    owner_values[result] = s
    Val(result, true, s)

owner_array_from_fixed = (source: int, et: int, count: int, t: int, dynamic: bool = false) -> Val:
    s = new_temp(t)
    sa = e_slot(s)
    e_zero(sa, tsize(t))
    owner_register(s, t)
    n = if dynamic: count else: e_iconst(count)
    e_call3(rt("__arr_reserve"), sa, e_iconst(owner_stride(et)), n, -1)
    i = vreg(VI)
    e_mov(i, e_iconst(0))
    blk()
    lop()
    brif_to(e_bin(.ges, VI, i, n), ctl - 1)
    ea = e_bin(.add, VI, source, e_bin(.mul, VI, i, e_iconst(tsize(et))))
    value = own(Val(load_val(et, ea, 0), false, -1), et)
    dst = e_call2(rt("__arr_push_slot"), sa, e_iconst(owner_stride(et)), VI)
    store_val(et, dst, 0, value.v)
    owner_element_live(dst, et)
    owner_forget_slot(value.slot)
    e_mov(i, e_addi(i, 1))
    br_to(ctl)
    endc()
    endc()
    result = e_load(VI, sa, 0, ptr_size)
    owner_values[result] = s
    Val(result, true, s)

# Eager resource snapshots never retain the source. Allocation may fail before
# any new element exists; inline element copy hooks have no-failure summaries.
helper_owner_arrcopy = (t: int):
    ps = helper_params(1)
    ir.ret = VI
    et = telem(t)
    r = vreg(VI)
    e_mov(r, e_iconst(0))
    iff(e_bin(.ne, VI, ps[0], e_iconst(0)))
    e_mov(r, e_call2(rt("__arr_copy"), ps[0], e_iconst(owner_stride(et)), VI))
    retain_elems(r, et)
    endc()
    e_ret(r)

# Unlike inline hooks, recursive copies can allocate. Hold each completed
# child independently until the complete result can be handed to the caller.
helper_owner_record_copy = (source: int, t: int):
    owner_begin()
    dest = e_slot(new_temp(t))
    held: int[]
    loop field in field_list(t):
        child = own(V(load_val(field.0, source, field.1), false), field.0)
        store_val(field.0, dest, field.1, child.v)
        if is_managed(field.0):
            if not ownership_type(field.0): child = owner_value(child, field.0)
            held.push(child.slot)
    e_copy(source, dest, tsize(t))
    loop slot in held: owner_forget_slot(slot)
    owner_end()
    e_ret(-1)

helper_owner_boxcopy = (t: int):
    owner_begin()
    ps = helper_params(1)
    ir.ret = VI
    et = telem(t)
    result = vreg(VI)
    e_mov(result, e_iconst(0))
    iff(e_bin(.ne, VI, ps[0], e_iconst(0)))
    child = own(V(load_val(et, e_addi(ps[0], BOX_HDR), 0), false), et)
    e_mov(result, e_call1(rt("__box_new"), e_iconst(tsize(et)), VI))
    store_val(et, e_addi(result, BOX_HDR), 0, child.v)
    owner_forget_slot(child.slot)
    endc()
    owner_end()
    e_ret(result)

helper_owner_envcopy = (f: int, src: int):
    owner_begin()
    t = int(fns[f].fntype)
    env = e_call1(rt("__alloc"), e_iconst(int(fns[f].env_size)), VI)
    e_copy(env, src, 24)
    hdr_store(env, 0, e_iconst(1))
    hdr_store(env, 24, e_iconst(0))
    slot = new_temp(t)
    e_zero(e_slot(slot), tsize(t))
    e_store(e_slot(slot), ptr_size, env, ptr_size)
    owner_register(slot, t)
    loop i in [0..fns[f].caps.len()):
        inn = int(fns[f].caps[i].inner)
        ct = store_type(inn)
        off = int(locals[inn].env_off)
        value = own(Val(load_val(ct, src, off), false, -1), ct)
        store_val(ct, env, off, value.v)
        if ownership_type(ct): owner_forget_slot(value.slot)
        hdr_store(env, 24, e_iconst(i + 1))
    owner_forget_slot(slot)
    owner_end()
    e_ret(env)


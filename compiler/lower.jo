use 'member_replay.jo'
# Lowering: typed AST -> IR, including reference counting, copy-on-write and closures.
use 'copies.jo'
use 'ownership.jo'
# Ownership rules: function parameters are borrowed; results of calls and constructors are
# owned. Owned temporaries used in borrowing positions are released at the end of the
# statement. Copying a borrowed value into storage retains it.

use 'util.jo'
use 'lex.jo'
use 'ast.jo'
use 'types.jo'
use 'check.jo'
use 'expr.jo'
use 'effects.jo'
use 'ir.jo'
use 'glsl.jo'
use 'spirv.jo'
use 'msl.jo'
use 'pe.jo'
use 'math_lower.jo'
use 'callback_specialize.jo'
use 'parallel_lower.jo'
use 'partition.jo'
use 'floats.jo'
use 'arena.jo'
use 'ownership_types.dewy'

const VC_VOID = 0
const VC_INT = 1
const VC_FLT = 2
const VC_AGG = 3

const LK_INST = 0
const LK_HELPER = 1

enum HK: drop, copy, move, arrrel, arruniq, arrcopy, eq, hash, thunk, envdrop, partial, envcopy, stackenvdrop, boxrel, boxdrop, boxuniq, math_main, owner_boxcopy, parallel_serial, parallel_job, partition, promote, reset_words

struct LFunc:
    kind: int
    inst: int
    hkind: HK
    htype: int
    name: str

lfuncs: LFunc[]
inst_lf: {int: int} = {}
helper_lf: {str: int} = {}
# Demanded helpers are inventoried by their existing LFunc identity. The string
# map remains the cold publication interface for fused-worker reconciliation;
# ordinary lowering probes integer keys without formatting or allocating.
# Open addressing: expected O(1) lookup, amortized O(1) insertion.
helper_slots: i32[]

helper_key_hash = (hk: HK, t: int, p: int) -> int:
    (int(hk) * 73856093) xor (t * 19349663) xor (p * 83492791)

helper_slot = (hk: HK, t: int, p: int) -> int:
    mask = helper_slots.len() - 1
    i = helper_key_hash(hk, t, p) & mask
    loop helper_slots[i] != 0:
        h = &lfuncs[int(helper_slots[i]) - 1]
        if h.hkind == hk and h.htype == t and h.inst == p: return i
        i = (i + 1) & mask
    i

helper_count = 0

# data segments
rodata: u8[]
ro_starts: int[]            # where each item (a string, a constant, an array) in rodata starts
str_off: {str: int} = {}
data_size = 8     # offset 0 holds the initial stack pointer
# data words keeping the C functions found: their offsets and library|name
ffi_offs: int[]
ffi_keys: str[]
ffi_slot: {int: int} = {}       # offset -> index
glsl_of: {int: str} = {}        # (sloppy watch) shader() node -> the GLSL made for it
global_off: {int: int} = {}
entry_points: int[]

# relocations inside rodata/data that hold function addresses or data addresses are not needed:
# all addresses are computed by code.

lf_of_inst = (f: int) -> int:
    if parallel_serial and not modules[int(fns[f].mod)].is_prelude and fns[f].kind != FK_PARTIAL and fns[f].body != 0:
        return lf_helper(.parallel_serial, 0, f)
    if let x = inst_lf.get(f):
        if fused_on and x >= fz_lf0: fz_note(0, x, f, 0, 0)
        return x
    lfuncs.push(LFunc(LK_INST, f, .drop, 0, fns[f].sym))
    x = lfuncs.len() - 1
    inst_lf[f] = x
    if fused_on: fz_note(0, x, f, 0, 0)
    x

lf_helper = (hk: HK, t0: int, p: int) -> int:
    # (a secret's helpers are its value's: secrets.jo)
    t = if secrets_seen: secret_repr(t0) else: t0
    if helper_slots.len() == 0: helper_slots = fill(0, 64)
    slot = helper_slot(hk, t, p)
    if helper_slots[slot] != 0:
        x = int(helper_slots[slot]) - 1
        if fused_on and x >= fz_lf0: fz_note(1, x, int(hk), t, p)
        return x
    lfuncs.push(LFunc(LK_HELPER, p, hk, t, "__h_{hk}_{lfuncs.len()}"))
    x = lfuncs.len() - 1
    helper_slots[slot] = i32(x + 1)
    helper_lf["{int(hk)}:{t}:{p}"] = x
    helper_count += 1
    if helper_count * 2 > helper_slots.len():
        old = helper_slots
        helper_slots = fill(0, helper_slots.len() * 2)
        loop entry in old:
            if entry == 0: continue
            h = &lfuncs[int(entry) - 1]
            helper_slots[helper_slot(h.hkind, h.htype, h.inst)] = entry
    if fused_on: fz_note(1, x, int(hk), t, p)
    x

rt = (name: str) -> int: lf_of_inst(runtime_fn(name))

# object header words (refcount, length, capacity, closure drop function): a memory class of
# their own, so stores to elements do not invalidate what the optimizer knows about them
hdr_load = (p: int, off: int) -> int: e_load(VI, p, off, 8 | M_HDR)
hdr_store = (p: int, off: int, v: int): e_store(p, off, v, 8 | M_HDR)

# value of a runtime global (by name, from the prelude)
rt_global = (name: str) -> int:
    s = prelude.get(intern(name)) ?? 0
    if s == 0 or syms[s].kind != .global: ice("missing runtime global {name}")
    e_load(VI, e_gaddr(global_addr_off(int(syms[s].ref))), 0, 1)

# call to a function that never returns (panics): registers need not survive it
# Fixed-arity calls append evaluated operands directly to the shared IR span.
e_call_nr0 = (f: int, rtype: int) -> int:
    start = ir.args.len()
    emit(.call, rtype, -1, start, 0, 1, f)
    -1

e_call_nr1 = (f: int, a0: int, rtype: int) -> int:
    start = ir.args.len()
    ir.args.push(i32(a0))
    emit(.call, rtype, -1, start, 1, 1, f)
    -1

e_call_nr2 = (f: int, a0: int, a1: int, rtype: int) -> int:
    start = ir.args.len()
    ir.args.push(i32(a0))
    ir.args.push(i32(a1))
    emit(.call, rtype, -1, start, 2, 1, f)
    -1

e_call_nr3 = (f: int, a0: int, a1: int, a2: int, rtype: int) -> int:
    start = ir.args.len()
    ir.args.push(i32(a0))
    ir.args.push(i32(a1))
    ir.args.push(i32(a2))
    emit(.call, rtype, -1, start, 3, 1, f)
    -1

e_call_nr4 = (f: int, a0: int, a1: int, a2: int, a3: int, rtype: int) -> int:
    start = ir.args.len()
    ir.args.push(i32(a0))
    ir.args.push(i32(a1))
    ir.args.push(i32(a2))
    ir.args.push(i32(a3))
    emit(.call, rtype, -1, start, 4, 1, f)
    -1

e_call_nr = (f: int, args: int[], rtype: int) -> int:
    start = ir.args.len()
    loop a in args: ir.args.push(i32(a))
    emit(.call, rtype, -1, i32(start), i32(args.len()), 1, f)
    -1

str_data = (s: str) -> int:
    if let o = str_off.get(s):
        if fused_on and o >= fz_r0: fz_note_text(2, o, s)
        return o
    loop rodata.len() % 8 != 0: rodata.push(0)
    o = rodata.len()
    ro_starts.push(o)
    push_i64(rodata, -1)
    push_i64(rodata, len(s))
    push_i64(rodata, len(s) + 1)
    n = rodata.len()
    rodata.resize(n + len(s))
    if len(s) > 0: mem_copy(data(rodata) + n, data(s), len(s))
    rodata.push(0)
    str_off[s] = o
    if fused_on: fz_note_text(2, o, s)
    o

# A string set's texts as one read-only block: each member's offset from the
# block's start, then the members as static strings (str_data's layout). The
# block refers only within itself, so it moves as a whole. (fused.jo's layout:
# a block per use, the same bytes however the functions are shared out)
set_text_tables: {int: int} = {}
set_text_table = (id: int) -> int:
    if not fz_layout:
        if let o = set_text_tables.get(id): return o
    loop rodata.len() % 8 != 0: rodata.push(0)
    o = rodata.len()
    ro_starts.push(o)
    texts = str_sets[id]
    at = 8 * texts.len()
    loop text in texts:
        push_i64(rodata, at)
        at += (24 + len(text) + 1 + 7) / 8 * 8
    loop text in texts:
        push_i64(rodata, -1)
        push_i64(rodata, len(text))
        push_i64(rodata, len(text) + 1)
        n = rodata.len()
        rodata.resize(n + len(text))
        if len(text) > 0: mem_copy(data(rodata) + n, data(text), len(text))
        rodata.push(0)
        loop rodata.len() % 8 != 0: rodata.push(0)
    if fused_on: fz_note_raw(o, 8)
    set_text_tables[id] = o
    o

push_i64 = (b: mut u8[], v: int):
    loop i in [0..8): b.push(u8((v >> (8 * i)) & 255))

global_addr_off = (g: int) -> int:
    if let o = global_off.get(g):
        if fused_on and o >= fz_d0: fz_note(3, o, g, 0, 0)
        return o
    t = int(globals[g].type)
    al = talign(t)
    if al < 8: al = 8
    data_size = align_up(data_size, al)
    o = data_size
    sz = tsize(t)
    if sz < 8: sz = 8
    data_size += sz
    global_off[g] = o
    if fused_on: fz_note(3, o, g, 0, 0)
    o

# ---------------- type helpers ----------------
# Representation plans belong to one lowering invocation. Only demanded types
# acquire entries; epochs avoid a types-by-functions clearing pass. Lazy helper
# discovery may append types, and a later lowering (watch/replay included) never
# reuses a previous invocation's classification.
struct LowerTypePlan:
    epoch: int
    value_class: int
    vtype: int

lower_types: LowerTypePlan[]
lower_epoch = 0
lower_planning = false

lower_type_plan = (t0: int) -> *LowerTypePlan:
    if t0 >= lower_types.len(): lower_types.resize(max(t0 + 1, lower_types.len() * 2))
    plan = &lower_types[t0]
    if plan.epoch == lower_epoch: return plan
    t = quantity_base(t0)
    k = types[t].kind
    c = VC_INT
    v = VI
    if k == .void_ or k == .typeval or k == .module: c = VC_VOID
    else if k == .float_:
        c = VC_FLT
        v = if int(types[t].bits) == 32: VS else: VF
    else if is_aggregate(t): c = VC_AGG
    plan.value_class = c
    plan.vtype = v
    plan.epoch = lower_epoch
    plan

vc = (t0: int) -> int:
    if lower_planning: return lower_type_plan(t0).value_class
    t = quantity_base(t0)
    k = types[t].kind
    if k == .void_ or k == .typeval or k == .module: return VC_VOID
    if k == .float_: return VC_FLT
    if is_aggregate(t): return VC_AGG
    VC_INT

vt_of = (t0: int) -> int:
    if lower_planning: return lower_type_plan(t0).vtype
    t = quantity_base(t0)
    if types[t].kind == .float_:
        if int(types[t].bits) == 32: return VS
        return VF
    VI

mem_mode = (t0: int) -> int:
    t = quantity_base(t0)
    k = types[t].kind
    s = tsize(t)
    if k == .float_: return s | M_FLOAT
    if k == .int_ and types[t].sign: return s | M_SIGNED
    s

load_val = (t: int, addr: int, off: int) -> int:
    if vc(t) == VC_AGG: return e_addi(addr, off)
    if vc(t) == VC_VOID: return -1
    e_load(vt_of(t), addr, off, mem_mode(t))

store_val = (t: int, addr: int, off: int, v: int):
    c = vc(t)
    if c == VC_AGG: e_copy(e_addi(addr, off), v, tsize(t))
    else if c != VC_VOID: e_store(addr, off, v, mem_mode(t))

norm = (v: int, t0: int) -> int:
    t = quantity_base(t0)
    k = types[t].kind
    if k == .bool_: return e_un(.zext8, VI, v)
    if k != .int_: return v
    s = tsize(t)
    sg = types[t].sign
    if s == 1:
        if sg: return e_un(.sext8, VI, v)
        return e_un(.zext8, VI, v)
    if s == 2:
        if sg: return e_un(.sext16, VI, v)
        return e_un(.zext16, VI, v)
    if s == 4:
        if sg: return e_un(.sext32, VI, v)
        return e_un(.zext32, VI, v)
    v

zero_val = (t: int) -> int:
    if vt_of(t) == VI: return e_iconst(0)
    e_fconst(0.0, vt_of(t))

# ---------------- function state ----------------
struct Val:
    v: int
    owned: bool
    slot: int

struct Place:
    mem: bool
    v: int
    math_opt: bool = false

struct TempItem:
    is_slot: bool
    ref: int
    t: int
    cond: bool
    stack_target: int = -1

struct LoopInfo:
    brk: int
    cont: int
    scope: int
    items: int
    built: int

# A value whose children are still being evaluated. init is a deferred zero
# instruction (slots) or the allocation call (arrays), patched only if an early
# exit actually needs to drop an incompletely initialized managed value.
struct BuildItem:
    is_slot: bool
    ref: int
    t: int
    init: int = -1

building: BuildItem[]

cur_fn = 0
cur_ret = 0
sret_v = -1
env_v = -1
ctl = 0
cond_depth = 0
scope_locals: int[][]
scope_defers: int[][]
loops: LoopInfo[]
# Statement marks index one reusable temporary arena. No per-statement array
# is allocated; cleanup visits each held value once in reverse creation order.
tl_items: int[]
tl_values: TempItem[]
tl_nop: int[]
tl_cond: int[]

# A statement normally needs no entry-time initialization. Record a compact
# insertion boundary, and publish a zero request only for conditional temps.
# Unlike placeholder instructions these records do not enter the optimizer IR.
struct LowerZero:
    mark: int
    start: int
    count: int
lower_zeros: LowerZero[]
lower_mark_serial = 0
lower_has_nops = false

V = (v: int, owned: bool) -> Val: Val(v, owned, -1)

# ---------------- reference counting ----------------
# release builds (`opt = release`) inline the fast paths of refcounting, uniqueness and bounds
# checks; debug builds keep them out of line so the IR (and compile time) stays small.
opt_release = false

# (where __mt_active is among the globals, for the code generator's CALL_RC_INC and CALL_RC_DEC)
mt_active_off = -1
note_mt_active = ():
    # (a fused worker notes each function's use: fused.jo)
    if mt_active_off >= 0 and not fused_on: return
    s = prelude.get(intern("__mt_active")) ?? 0
    if s == 0 or syms[s].kind != .global: ice("missing runtime global __mt_active")
    mt_active_off = global_addr_off(int(syms[s].ref))

# v was just computed as a read-only datum's address (e_daddr, a fresh vreg defined once): an
# immortal object, as every object in read-only data is (str_data, const_array). A bounded look
# back over the last few instructions; constant time.
static_datum = (v: int) -> bool:
    i = ir.code.len() - 1
    floor = i - 4
    loop i >= 0 and i >= floor:
        if int(ir.code[i].dst) == v and ir.code[i].op == .daddr: return true
        i -= 1
    false

# rc <= 0 marks immortal objects
retain = (v: int, t0: int):
    if static_datum(v): return
    t = quantity_base(t0)
    if math_optional(t):
        retain(e_bin(.xor, VI, v, e_iconst(1)), T_MATH_INT)
        return
    if t == T_MATH_INT:
        iff(math_tag(v))
        was = ir_cold
        ir_cold = true
        retain(e_addi(v, -1), math_payload_type())
        ir_cold = was
        endc()
        return
    if not opt_release:
        # (one call in the IR, which the code generator does inline when it can: CALL_RC_INC)
        e_call1(rt("__rc_inc"), v, -1)
        ir.code[ir.code.len() - 1].c = CALL_RC_INC
        note_mt_active()
        return
    # during a parallel job refcounts must be updated atomically (out of line)
    blk()
    done = ctl
    iff(rt_global("__mt_active"))
    was = ir_cold
    ir_cold = true
    e_call1(rt("__rc_inc"), v, -1)
    ir_cold = was
    br_to(done)
    endc()
    iff(e_bin(.ne, VI, v, e_iconst(0)))
    rc = hdr_load(v, 0)
    iff(e_bin(.gts, VI, rc, e_iconst(0)))
    hdr_store(v, 0, e_addi(rc, 1))
    endc()
    endc()
    endc()

release = (v: int, t0: int):
    t = quantity_base(t0)
    if math_optional(t):
        release(e_bin(.xor, VI, v, e_iconst(1)), T_MATH_INT)
        return
    if t == T_MATH_INT:
        iff(math_tag(v))
        was = ir_cold
        ir_cold = true
        release_call(e_addi(v, -1), math_payload_type())
        ir_cold = was
        endc()
        return
    if not opt_release:
        release_call(v, t)
        ir.code[ir.code.len() - 1].c = CALL_RC_DEC
        note_mt_active()
        return
    blk()
    done = ctl
    iff(rt_global("__mt_active"))
    was = ir_cold
    ir_cold = true
    release_call(v, t)
    ir_cold = was
    br_to(done)
    endc()
    iff(e_bin(.ne, VI, v, e_iconst(0)))
    rc = hdr_load(v, 0)
    iff(e_bin(.gts, VI, rc, e_iconst(1)))
    hdr_store(v, 0, e_addi(rc, -1))
    els()
    # last reference: the out-of-line path frees (and releases elements)
    iff(e_bin(.eq, VI, rc, e_iconst(1)))
    release_call(v, t)
    endc()
    endc()
    endc()
    endc()

# (the call dropping a reference to v, freeing it with the last: an array's elements and a box's
# value are released by a helper for the type)
release_call = (v: int, t: int):
    if types[t].kind == .array and is_managed(int(types[t].elem)): e_call1(lf_helper(.arrrel, t, 0), v, -1)
    else if types[t].kind == .box: e_call1(lf_helper(.boxrel, t, 0), v, -1)
    else: e_call1(rt("__rc_dec"), v, -1)

drop_at = (addr: int, t0: int):
    if ownership_type(t0):
        owner_drop(addr)
        return
    t = quantity_base(t0)
    if not is_managed(t): return
    if ownership_type(t):
        owner_drop(addr)
        return
    if vc(t) == VC_INT:
        release(e_load(VI, addr, 0, ptr_size), t)
        return
    env_guard(addr, t)
    e_call1(lf_helper(.drop, t, 0), addr, -1)
    if env_guarded(t): endc()

copy_at = (addr: int, t0: int):
    t = quantity_base(t0)
    if not is_managed(t): return
    if vc(t) == VC_INT:
        e_store(addr, 0, copy_ref(e_load(VI, addr, 0, ptr_size), t), ptr_size)
        return
    env_guard(addr, t)
    e_call1(lf_helper(.copy, t, 0), addr, -1)
    if env_guarded(t): endc()

# A function value's one managed part is its environment, and its drop and copy helpers
# (helper_drop) do nothing to a value without one (a plain function's: env 0). Test that inline
# and call the helper only for an environment. (Owner-capturing callables keep their hooks.)
env_guarded = (t: int) -> bool:
    k = types[t].kind
    (k == .fn_ or k == .polyfn or k == .callable) and not ownership_type(t)

env_guard = (addr: int, t: int):
    if env_guarded(t): iff(e_bin(.ne, VI, e_load(VI, addr, ptr_size, ptr_size), e_iconst(0)))

# Arrays containing callable values must copy their environments too. Ordinary
# data arrays retain the normal COW path. This eager path is deliberately small:
# it also works when a callback is invoked by a borrowed implementation-library API.
copy_ref = (v: int, t: int) -> int:
    if ownership_type(t):
        if tkind(t) == .array: return e_call1(lf_helper(.arrcopy, t, 0), v, VI)
        if tkind(t) == .box: return e_call1(lf_helper(.owner_boxcopy, t, 0), v, VI)
    retain(v, t)
    k = types[prune(t)].kind
    if (k == .array or k == .box) and type_has_fn(t):
        return e_call1(lf_helper((if k == .array: HK.arruniq else: HK.boxuniq), t, 0), v, VI)
    v

# ---------------- temps ----------------
new_temp = (t: int) -> int: new_slot(tsize(t), talign(t))

reg_temp_slot = (s: int, t: int, stack_target: int = -1):
    if stack_target >= 0 and closure_scalar_environment(stack_target): return
    if not is_managed(t) or tl_items.len() == 0: return
    tl_values.push(TempItem(true, s, t, cond_depth > tl_cond[tl_cond.len() - 1], stack_target))

reg_temp_vreg = (v: int, t: int):
    if not is_managed(t) or tl_items.len() == 0: return
    # An empty literal is an immutable null constant. It owns no allocation,
    # and conditional cleanup must not try to clear its constant register.
    if is_kv(v) and kv_of(v) == 0: return
    tl_values.push(TempItem(false, v, t, cond_depth > tl_cond[tl_cond.len() - 1]))

borrow = (val: Val, t: int):
    if not val.owned or not is_managed(t): return
    if vc(t) == VC_AGG or ownership_type(t):
        if val.slot < 0: ice("owned aggregate without slot")
        reg_temp_slot(val.slot, t)
    else:
        # copy into a fresh vreg so later reassignment of the original can't confuse release
        # (the value may sit in a local's own vreg, which statement cleanup must not touch)
        c = vreg(VI)
        e_mov(c, val.v)
        reg_temp_vreg(c, t)

own = (val: Val, t: int) -> Val:
    if val.owned: return val
    if ownership_type(t):
        if not ownership_copyable(t): fatal(ir_pos, "cannot copy a move-only owner")
        if vc(t) == VC_INT: return owner_value(V(copy_ref(val.v, t), true), t)
        if let hook = ownership_copies.get(prune(t)): return owner_hook_result(hook, val.v, t)
        if let copier = owner_map_copies.get(prune(t)):
            slot = new_temp(t)
            addr = e_slot(slot)
            e_call2(lf_of_inst(copier), addr, val.v, -1)
            owner_register(slot, t)
            return Val(addr, true, slot)
        if is_map_type(t):
            slot = new_temp(t)
            addr = e_slot(slot)
            e_zero(addr, tsize(t))
            owner_register(slot, t)
            loop field in field_list(t):
                child = own(Val(load_val(field.0, val.v, field.1), false, -1), field.0)
                store_val(field.0, addr, field.1, child.v)
                if ownership_type(field.0): owner_forget_slot(child.slot)
            return Val(addr, true, slot)
        slot = new_temp(t)
        addr = e_slot(slot)
        e_copy(addr, val.v, tsize(t))
        copy_at(addr, t)
        owner_register(slot, t)
        return Val(addr, true, slot)
    if vc(t) == VC_AGG:
        s = new_temp(t)
        a = e_slot(s)
        e_copy(a, val.v, tsize(t))
        if is_managed(t): copy_at(a, t)
        return Val(a, true, s)
    if is_managed(t): return Val(copy_ref(val.v, t), true, -1)
    Val(val.v, true, -1)

stmt_begin = ():
    positive_epoch += 1
    tl_items.push(tl_values.len())
    lower_mark_serial += 1
    tl_nop.push((ir.code.len() << 32) | lower_mark_serial)
    tl_cond.push(cond_depth)

stmt_end = ():
    start = tl_items.pop()
    end = tl_values.len()
    nop = tl_nop.pop()
    tl_cond.pop()
    # Append the demanded zero inventory directly into the IR argument arena.
    args_start = ir.args.len()
    loop i in [start..end):
        it = tl_values[i]
        if it.cond: ir.args.push(i32(it.ref * 2 + int(not it.is_slot)))
    count = ir.args.len() - args_start
    if count > 0:
        lower_zeros.push(LowerZero(nop, args_start, count))
    i = end - 1
    loop i >= start:
        it = tl_values[i]
        if it.is_slot:
            a = e_slot(it.ref)
            if it.stack_target >= 0: drop_stack_closure(a, it.stack_target)
            else: drop_at(a, it.t)
            if it.cond: e_zero(a, tsize(it.t))
        else:
            release(it.ref, it.t)
            if it.cond: e_mov(it.ref, e_iconst(0))
        i -= 1
    tl_values.truncate(start)

# Keep ordinary construction unchanged: a placeholder becomes a zero only
# when return/break/continue can bypass writes to some managed fields.
build_slot = (s: int, t: int, needs_zero: bool = false) -> bool:
    if not is_managed(t): return false
    at = -1
    if needs_zero:
        lower_has_nops = true
        at = emit(.nop, 0, 0, e_slot(s), 0, 0, 0)
    building.push(BuildItem(true, s, t, at))
    true

drop_held = (items: int, built: int):
    k = building.len() - 1
    loop k >= built:
        it = building[k]
        if it.init >= 0:
            ins = ir.code[it.init]
            if it.is_slot:
                ins.op = .zero
                ins.imm = tsize(it.t)
            else: ins.imm = rt("__arr_repeat")
            ir.code[it.init] = ins
        if it.is_slot: drop_at(e_slot(it.ref), it.t)
        else: release(it.ref, it.t)
        k -= 1
    if items < tl_items.len():
        start = tl_items[items]
        k = tl_values.len() - 1
        loop k >= start:
            it = tl_values[k]
            if it.is_slot:
                if it.stack_target >= 0: drop_stack_closure(e_slot(it.ref), it.stack_target)
                else: drop_at(e_slot(it.ref), it.t)
            else: release(it.ref, it.t)
            k -= 1

enter_cond = (): cond_depth += 1
leave_cond = (): cond_depth -= 1

# ---------------- structured control ----------------
blk = ():
    e_block()
    ctl += 1
lop = ():
    e_loop()
    ctl += 1
    if lop_watch:
        # (a web page: each pass counts down, and every million the watchdog asks how long the
        # page has been running without a break: a loop that never ends is stopped, its output
        # shown, rather than the page hanging)
        g = e_gaddr(global_addr_off(int(syms[prelude.get(intern("__loop_budget")) ?? 0].ref)))
        v = e_bin(.sub, VI, e_load(VI, g, 0, 8), e_iconst(1))
        e_store(g, 0, v, 8)
        iff(e_bin(.lts, VI, v, e_iconst(0)))
        e_call0(rt("__loop_watchdog"), -1)
        endc()
iff = (c: int):
    e_if(c)
    ctl += 1
els = (): e_else()
endc = ():
    e_end()
    ctl -= 1
# branch to the construct opened at nesting level `level` (1-based count of open constructs)
br_to = (level: int): e_br(ctl - level)
brif_to = (c: int, level: int): e_brif(c, ctl - level)

# ---------------- scopes ----------------
scope_push = ():
    scope_locals.push([])
    scope_defers.push([])

scope_add_local = (l: int):
    if scope_locals.len() == 0: return
    f = int(locals[l].flags)
    if not is_managed(store_type(l)) or f & (LF_CAPTURE | LF_ALIAS | LF_BYREF) != 0: return
    if f & LF_PARAM != 0 and not copy_inputs.has(l): return
    if ownership_type(store_type(l)): owner_register(int(locals[l].offset), store_type(l))
    scope_locals[scope_locals.len() - 1].push(l)

opt_has = (addr: int, inner: int) -> int:
    if quantity_base(inner) == T_MATH_INT: return e_bin(.ne, VI, e_load(VI, addr, 0, 8), e_iconst(0))
    e_load(VI, addr, tsize(inner), 1)

opt_value = (addr: int, inner: int) -> int:
    if quantity_base(inner) == T_MATH_INT: return e_bin(.xor, VI, e_load(VI, addr, 0, 8), e_iconst(1))
    load_val(inner, addr, 0)

# ---------------- places ----------------
read_place = (p: Place, t: int) -> int:
    if p.math_opt: return e_bin(.xor, VI, (if p.mem: e_load(VI, p.v, 0, 8) else: p.v), e_iconst(1))
    if not p.mem: return p.v
    load_val(t, p.v, 0)

write_place = (p: Place, t: int, v: int):
    if p.math_opt:
        encoded = e_bin(.xor, VI, v, e_iconst(1))
        if p.mem: e_store(p.v, 0, encoded, 8)
        else: e_mov(p.v, encoded)
        return
    if not p.mem:
        e_mov(p.v, v)
        return
    store_val(t, p.v, 0, v)

place_addr = (p: Place, t: int) -> int:
    if p.mem and not p.math_opt: return p.v
    # a value in a register: spill to a temporary slot
    s = new_temp(t)
    a = e_slot(s)
    store_val(t, a, 0, read_place(p, t))
    a

# ---------------- boxes ----------------
# A boxed field (types.jo, decide_boxes) holds a pointer to [rc][value], null until it is given a
# value: an empty box reads as its type's default (box_dflt_off). Copies of what holds it share
# the box, and a write through it first makes the box the writer's own (box_unique), as an array
# is; a new value for the whole field is a new box (box_put).
const BOX_HDR = 8

# the type a field's memory holds: its value, or the box keeping it
field_store_type = (f: int) -> int:
    if fields[f].boxed: return mk_box(int(fields[f].type))
    int(fields[f].type)

# the boxed field (an index into fields) that field node e reads, or -1
boxed_field_of = (e: int) -> int:
    if nodes[e].kind != .field: return -1
    aux = int(nodes[e].aux)
    bt = prune(ntype(int(nodes[e].a)))
    if types[bt].kind == .ptr: bt = prune(int(types[bt].elem))
    f = -1
    if aux == -3:
        layout(bt)
        f = int(variants[int(structs[int(types[bt].st)].variants) + int(nodes[e].aux2)].fields) + int(nodes[e].ival)
    else if aux >= 0 and types[bt].kind == .struct_:
        layout(bt)
        f = int(structs[int(types[bt].st)].fields) + aux
    if f >= 0 and fields[f].boxed: return f
    -1

box_dflt_data: {int: int} = {}

# (the rodata offset of) the value an empty box of type t reads as
box_dflt_off = (t0: int) -> int:
    t = prune(t0)
    if let o = box_dflt_data.get(t):
        if fused_on and o >= fz_r0: fz_note(4, o, t, 0, 0)
        return o
    loop rodata.len() % 8 != 0: rodata.push(0)
    o = rodata.len()
    ro_starts.push(o)
    rodata.resize(o + max(tsize(t), 8))
    v = box_default(t)
    if v > 0:
        loop i in [0..4): rodata[o + i] = u8((v >> (8 * i)) & 255)
    box_dflt_data[t] = o
    if fused_on: fz_note(4, o, t, 0, 0)
    o

# the address of the value in box p (of a value of type t), or of the default when p is empty
box_val = (p: int, t: int) -> int:
    r = vreg(VI)
    e_mov(r, e_daddr(box_dflt_off(t)))
    iff(e_bin(.ne, VI, p, e_iconst(0)))
    e_mov(r, e_addi(p, BOX_HDR))
    endc()
    r

# the box at slot made the writer's own (a new one holding the default when it is empty, a copy
# when it is shared), for a write through it: the address of its value
box_unique = (slot: int, t: int) -> int:
    sz = tsize(t)
    iff(e_bin(.eq, VI, e_load(VI, slot, 0, ptr_size), e_iconst(0)))
    was = ir_cold
    ir_cold = true
    np = e_call1(rt("__box_new"), e_iconst(sz), VI)
    e_copy(e_addi(np, BOX_HDR), e_daddr(box_dflt_off(t)), sz)
    e_store(slot, 0, np, ptr_size)
    ir_cold = was
    endc()
    p = e_load(VI, slot, 0, ptr_size)
    bt = mk_box(t)
    if not opt_release:
        # (one call, which the code generator skips for a box with one reference: CALL_IF_SHARED)
        q = e_call1(lf_helper(.boxuniq, bt, 0), p, VI)
        ir.code[ir.code.len() - 1].c = CALL_IF_SHARED
        e_store(slot, 0, q, ptr_size)
        return e_addi(q, BOX_HDR)
    r = vreg(VI)
    e_mov(r, p)
    iff(e_bin(.ne, VI, hdr_load(p, 0), e_iconst(1)))
    was2 = ir_cold
    ir_cold = true
    e_mov(r, e_call1(lf_helper(.boxuniq, bt, 0), p, VI))
    e_store(slot, 0, r, ptr_size)
    ir_cold = was2
    endc()
    e_addi(r, BOX_HDR)

# the owned value v of type t put in the box at slot (empty, or its box already released): a new
# box, or none for none (an empty box reads as none)
box_put = (slot: int, t0: int, v: int):
    t = prune(t0)
    sz = tsize(t)
    is_opt = types[t].kind == .opt
    if is_opt:
        e_store(slot, 0, e_iconst(0), ptr_size)
        iff(e_load(VI, v, tsize(int(types[t].elem)), 1))
    p = e_call1(rt("__box_new"), e_iconst(sz), VI)
    e_copy(e_addi(p, BOX_HDR), v, sz)
    e_store(slot, 0, p, ptr_size)
    if is_opt: endc()

# owned value v stored in field f of the value at addr (whose memory there is zero, or released)
store_field = (f: int, addr: int, v: int):
    if fields[f].boxed: box_put(e_addi(addr, int(fields[f].offset)), int(fields[f].type), v)
    else: store_val(int(fields[f].type), addr, int(fields[f].offset), v)

# the address of field f's value in the value at addr, for reading
field_val_addr = (f: int, addr: int) -> int:
    a = e_addi(addr, int(fields[f].offset))
    if not fields[f].boxed: return a
    box_val(e_load(VI, a, 0, ptr_size), int(fields[f].type))

# (gen_place of a boxed field gives the field's own memory, the box pointer, when this is set:
# assign_to, giving it a new box)
box_slot = false
# (the last box a place for writing went through, made the writer's own, and its type)
pinned_box = -1
pinned_type = 0

field_place = (f: int, addr: int, write: bool, slot: bool) -> Place:
    a = e_addi(addr, int(fields[f].offset))
    if not fields[f].boxed or slot: return Place(true, a)
    if write:
        v = box_unique(a, int(fields[f].type))
        pinned_box = e_load(VI, a, 0, ptr_size)
        pinned_type = mk_box(int(fields[f].type))
        return Place(true, v)
    Place(true, box_val(e_load(VI, a, 0, ptr_size), int(fields[f].type)))

# ---------------- shared variables ----------------
# A variable that closures share by reference (LF_SHARED, see check.jo) lives in a cell: a
# one-element array. The variable (and each capture) holds the cell, and every access goes to its
# element, without copy-on-write, so all holders see the same value.
share_root = (l: int) -> int:
    r = l
    loop int(locals[r].flags) & LF_CAPTURE != 0 and int(locals[r].flags) & LF_VALUECAP == 0: r = int(locals[r].outer)
    r

is_shared = (l: int) -> bool: int(locals[share_root(l)].flags) & LF_SHARED != 0

# the type of what the variable's storage holds: the value, or the cell
store_type = (l: int) -> int:
    t = int(locals[l].type)
    if int(locals[l].flags) & (LF_OWNERBORROW | LF_PARTBORROW) != 0: return mk_ptr(t)
    if is_shared(l): return mk_array(t)
    if math_word_captures.has(l): return T_INT
    t

cell_place = (l: int) -> Place:
    if int(locals[l].flags) & LF_CAPTURE != 0: return Place(true, e_addi(env_v, int(locals[l].env_off)))
    if locals[l].offset >= 0: return Place(true, e_slot(int(locals[l].offset)))
    Place(false, int(locals[l].vreg))

check_cell_type = (l: int):
    # (a cell holding a closure that holds the cell would never be freed: values that can hold
    # functions are not shared like this)
    if type_has_fn(int(locals[l].type)):
        nm = name_of(int(locals[l].name))
        fatal(int(locals[l].pos), "'{nm}' is changed after a closure captured it, and it can hold functions ({dt(int(locals[l].type))}): a closure kept in it would keep it alive forever. Make it a global, or pass it to the closure as {jd(int(locals[l].pos), "a `mut`", "an `@`")} parameter")
new_cell = (l: int):
    check_cell_type(l)
    sz = tsize(int(locals[l].type))
    if sz < 1: sz = 1
    write_place(cell_place(l), store_type(l), e_call2(rt("__arr_repeat"), e_iconst(1), e_iconst(sz), VI))

bounds_check = (arr: int, idx: int, pos: int):
    # arr: array object pointer (may be null), idx: index
    loc = loc_data(pos)
    if not opt_release:
        n = 0
        if target_wasm or target_arm64: n = arr_len(arr)
        else:
            # Select a real zero-length header for nil, without a hot branch.
            # Keep the comparison next to select so native lowering reuses flags.
            selected = vreg(VI)
            empty = e_daddr(str_data(""))
            condition = e_bin(.ne, VI, arr, e_iconst(0))
            emit(.select, VI, selected, condition, arr, empty, 0)
            n = hdr_load(selected, 8)
        iff(e_bin(.geu, VI, idx, n))
        e_call_nr3(rt("__panic_bounds"), idx, n, e_daddr(loc), -1)
        endc()
        return
    iff(e_bin(.eq, VI, arr, e_iconst(0)))
    e_call_nr3(rt("__panic_bounds"), idx, e_iconst(0), e_daddr(loc), -1)
    endc()
    n = hdr_load(arr, 8)
    iff(e_bin(.geu, VI, idx, n))
    e_call_nr3(rt("__panic_bounds"), idx, n, e_daddr(loc), -1)
    endc()

# the part of a bounds check that later checks build on: the array exists (release builds
# then know this for the rest of the scope)
null_check = (arr: int, idx: int, pos: int):
    iff(e_bin(.eq, VI, arr, e_iconst(0)))
    e_call_nr3(rt("__panic_bounds"), idx, e_iconst(0), e_daddr(loc_data(pos)), -1)
    endc()

# rodata offset of the "file:line" string for a position (consecutive checks share a line)
loc_last_file = -1
loc_last_line = -1
loc_last_off = 0

loc_data = (pos: int) -> int:
    f = pos_file(pos)
    l, c = line_col(pos)
    if f == loc_last_file and l == loc_last_line and not fused_on: return loc_last_off
    loc_last_file = f
    loc_last_line = l
    loc_last_off = str_data(loc_str(pos))
    loc_last_off

# A library position names no line of the program: the backtrace shows the
# program's call instead (`a // 0` fails in the caller, not in the library).
loc_str = (pos: int) -> str:
    if pos_in_lib(pos): return ""
    f = pos_file(pos)
    path = files[f].path
    s = rfind(path, "/")
    if s >= 0: path = path[s + 1..]
    l, c = line_col(pos)
    "{path}:{l}"

e_daddr = (off: int) -> int:
    d = vreg(VI)
    emit(.daddr, VI, d, 0, 0, 0, off)
    d

e_gaddr = (off: int) -> int:
    d = vreg(VI)
    emit(.gaddr, VI, d, 0, 0, 0, off)
    d

e_faddr = (lf: int) -> int:
    d = vreg(VI)
    emit(.faddr, VI, d, 0, 0, 0, lf)
    d

# length of an array/string object pointer (0 for null)
arr_len = (p: int) -> int:
    r = vreg(VI)
    emit(.iconst, VI, r, 0, 0, 0, 0)
    iff(e_bin(.ne, VI, p, e_iconst(0)))
    e_mov(r, hdr_load(p, 8))
    endc()
    r

arr_unique = (slot_addr_or_place: Place, at: int):
    # ensure the array in the place is uniquely owned
    # (fast path inline: a non-null array with refcount 1 is already unique. Debug builds keep
    # the IR one call, which the code generator skips in those cases (CALL_IF_SHARED): out of
    # line, every element write cost a call, half of nbody's time)
    p = read_place(slot_addr_or_place, at)
    if not opt_release:
        np0 = e_call1(lf_helper(.arruniq, at, 0), p, VI)
        ir.code[ir.code.len() - 1].c = CALL_IF_SHARED
        write_place(slot_addr_or_place, at, np0)
        return
    iff(e_bin(.ne, VI, p, e_iconst(0)))
    iff(e_bin(.ne, VI, hdr_load(p, 0), e_iconst(1)))
    was = ir_cold
    ir_cold = true
    np = e_call1(lf_helper(.arruniq, at, 0), p, VI)
    ir_cold = was
    write_place(slot_addr_or_place, at, np)
    endc()
    endc()
    emit(.assume, 0, 0, read_place(slot_addr_or_place, at), 0, 0, A_RC1)

# indexes computed beforehand (a `mut` element passed as a copy finds its place again after the
# call with the same index)
frozen: {int: int}
# A fixed array covering an unsigned index's entire domain needs no check.
# Follow only value-preserving integer widenings. Stripping arbitrary casts
# would miss negative values introduced by signed narrowing (u16 -> i8 -> int).
fixed_index_domain = (index: int, length: int) -> bool:
    n = index
    loop true:
        t = prune(ntype(n))
        if types[t].kind != .int_: return false
        bits = int(types[t].bits)
        if not types[t].sign and bits < 32: return (1 << bits) <= length
        if nodes[n].kind != .conv or nodes[n].aux != i32(int(CV.int_)): return false
        inner = int(nodes[n].a)
        source = prune(ntype(inner))
        if types[source].kind != .int_: return false
        from_bits = int(types[source].bits)
        if bits < from_bits: return false
        if types[t].sign != types[source].sign and not (types[t].sign and bits > from_bits): return false
        n = inner
    false

tuple_off = (t: int, idx: int) -> int:
    off = 0
    loop i in [0..idx + 1):
        el = targ(t, i)
        off = align_up(off, talign(el))
        if i < idx: off += tsize(el)
    off

# ---------------- calls ----------------
call_eval_order = (n: int) -> int[]:
    order: int[]
    metadata = int(nodes[n].c)
    if metadata != 0:
        loop e in kids(metadata): order.push(nodes[e].ival)
    else:
        loop i in [0..nkids(n)): order.push(i)
    order

# A scalar expression can name a local's mutable register. Keep the value
# already read before evaluating a later operand/argument that can assign it.
freeze_scalar = (v: int, t: int) -> int:
    if v < 0 or is_kv(v): return v
    saved = vreg(vt_of(t))
    e_mov(saved, v)
    saved

# A snapshot taken only to keep an argument stable while the callee runs. The
# result is owned, so nothing refers to the snapshot once the call returns;
# release it there rather than at the end of the statement. A snapshot kept
# alive across a later mutating call in the same statement (`add(@p
# Node[text(p t)])`) would make that call detach and copy p's buffers.
arg_snapshots: TempItem[]

release_arg_snapshots = (mark: int):
    loop arg_snapshots.len() > mark:
        it = arg_snapshots.pop()
        k = tl_values.len() - 1
        found = false
        loop k >= 0 and not found:
            x = tl_values[k]
            if x.is_slot == it.is_slot and x.ref == it.ref:
                tl_values.remove(k)
                # An early release can belong to an enclosing statement.
                # Preserve the offsets of every still-active nested statement.
                loop j in [0..tl_items.len()):
                    if tl_items[j] > k: tl_items[j] -= 1
                found = true
            k -= 1
        if not found: continue
        if it.is_slot: drop_at(e_slot(it.ref), it.t)
        else: release(it.ref, it.t)

# (a is part of the same variable as one of the call's `mut` arguments; for the
# copy policy (callee 0 or more), unless their field paths part, or a checked
# callee spares a's place inside that argument: a method passing its own field)
shares_mut_root = (a: int, args: int[], mutmask: int, callee: int = -2) -> bool:
    ra = place_var(a)
    if ra == 0: return false
    loop j in 0.. and b in args:
        if mutmask & (1 << j) == 0: continue
        rb = place_var(b)
        if rb == 0 or not same_var(ra, rb): continue
        if callee > -2 and (disjoint_fields(a, b) or mut_arg_spares(a, b, j, callee)): continue
        return true
    false

# The callee's settled summary writes no place of formal j that overlaps a's
# field path below the actual b (`absorb(pending ...)` writing only `h`).
mut_arg_spares = (a: int, b: int, j: int, callee: int) -> bool:
    if callee <= 0 or j >= fns[callee].params.len(): return false
    sa = place_steps(a)
    sb = place_steps(b)
    if sa.len() <= sb.len(): return false
    loop i in [0..sb.len()):
        if nodes[sa[i]].kind != .field or nodes[sb[i]].kind != .field or nodes[sa[i]].aux != nodes[sb[i]].aux: return false
    rest: int[]
    loop i in [sb.len()..sa.len()):
        x = sa[i]
        if nodes[x].kind != .field or nodes[x].aux < 0 or tkind(ntype(int(nodes[x].a))) != .struct_ or boxed_field_of(x) >= 0: return false
        rest.push(int(nodes[x].name))
    if not effects_demand_late(callee): return false
    loop event in effect_summaries[callee].events:
        k = event.atom.kind
        if k == .opaque or k == .remainder or k == .escape: return false
        if k != .write: continue
        base = place_base(event.atom.place)
        if base.root == .capture or base.root == .local and base.declaration == 0: return false
        if base.root != .formal or base.declaration - 1 != j: continue
        path = place_path(event.atom.place)
        n = min(path.len(), rest.len())
        same = true
        loop i in [0..n):
            if path[i] != rest[i]: same = false
        if same: return false
    true

# Two inline field paths from one variable that name different fields at some
# step are different storage: a write through one cannot reach the other.
disjoint_fields = (a: int, b: int) -> bool:
    sa = place_steps(a)
    sb = place_steps(b)
    loop i in [0..min(sa.len(), sb.len())):
        x = sa[i]
        y = sb[i]
        if nodes[x].kind != .field or nodes[y].kind != .field or nodes[x].aux < 0 or nodes[y].aux < 0: return false
        if tkind(ntype(int(nodes[x].a))) != .struct_ or boxed_field_of(x) >= 0 or boxed_field_of(y) >= 0: return false
        if nodes[x].aux != nodes[y].aux: return true
    false

mwr_direct = false             # (may_write_root: only what the code itself does, not its calls)

# A `mut` element of a global array (or of a `mut` parameter's, which may be a global) is passed
# as a copy, written back after the call, when the call may run a function value: the callee
# itself, or one it calls. That code could resize the array, which would move the element. (What
# the callee changes by name is checked by mut_alias_check.)
struct CopyBack:
    arg: int
    slot: int
    idx: (int, int)[]          # the place's index nodes and their values
copy_backs: CopyBack[]

copy_through = (a: int, callee: int) -> bool:
    alias = a
    loop nodes[alias].kind == .ident and nodes[alias].aux == i32(int(SK.local)) and int(locals[int(nodes[alias].sym)].flags) & LF_ALIAS != 0:
        alias = int(locals[int(nodes[alias].sym)].alias)
    if nodes[alias].kind == .unwrap and math_optional(prune(ntype(int(nodes[alias].a)))): return true
    r = place_var(a)
    if r == 0 or not pw_heap: return false
    if nodes[r].aux != i32(int(SK.global)):
        if nodes[r].aux != i32(int(SK.local)) or int(locals[int(nodes[r].sym)].flags) & LF_MUTPARAM == 0: return false
    callee <= 0 or fn_writes(callee).all

# after a call: the copies made since copy_backs had `mark` entries go back to their places (the
# copy's references move there)
# could the place argument i was read from (without a reference of its own) be given another
# value before the call returns, by the callee or a later argument, freeing what was read? It
# can for globals, variables closures share, captures and mut parameters; a plain local or
# parameter cannot be reached from elsewhere (and a parameter's caller keeps its value alive).
# Release builds leave out the reference to a global that neither the callee nor the later
# arguments can change.
borrow_may_change = (a: int, args: int[], i: int, callee: int) -> bool:
    n = place_var(a)
    if n == 0: return false
    heap_place = pw_heap
    if nodes[n].aux == i32(int(SK.global)):
        # (a global only top-level code changes cannot change during a call, only in the
        # arguments after this one)
        if not globals[int(nodes[n].sym)].fn_written:
            mwr_direct = true
            w = false
            loop j in [i + 1..args.len()):
                if may_write_root(args[j], n): w = true
            mwr_direct = false
            return w
        if not opt_release or callee <= 0: return true
        w = fn_writes(callee)
        if w.all or w.globals.contains(int(nodes[n].sym)): return true
        loop j in [i + 1..args.len()):
            if may_write_root(args[j], n): return true
        return false
    if nodes[n].aux != i32(int(SK.local)): return false
    if held_views.contains(int(nodes[n].sym)): return false
    flags = int(locals[int(nodes[n].sym)].flags)
    # view_decl proved that the array root cannot change through the last use,
    # including this call and its remaining arguments. The view needs no retain.
    if flags & LF_ELEMENTVIEW != 0: return false
    # An immutable value capture is kept alive by the active closure. Passing
    # it to a reader needs no per-invocation retain, including across workers.
    immutable_capture = flags & (LF_CAPTURE | LF_VALUECAP) == (LF_CAPTURE | LF_VALUECAP) and flags & (LF_ASSIGNED | LF_CAPTURED | LF_ADDR | LF_EXPOSED | LF_OWNERBORROW | LF_SHARED) == 0 and not is_shared(int(nodes[n].sym))
    if flags & (LF_SHARED | LF_BYREF | LF_ALIAS) != 0 or flags & LF_CAPTURE != 0 and not immutable_capture: return true
    # Even an ordinary local can be changed by evaluating a later argument.
    # Disjoint fields keep borrowing. A dynamic element also borrows its
    # container's storage: a sibling write may detach it, and later code may
    # release the old backing storage's last other owner. Treat that ownership
    # place as overlapping, even when the logical elements are disjoint.
    loop j in [i + 1..args.len()):
        if may_write_root(args[j], n, (if heap_place: 0 else: a)): return true
    if flags & LF_MUTPARAM == 0: return false
    # A mutable parameter may alias a caller's global. A read-only direct call
    # cannot replace it when it writes no globals and invokes no unknown code.
    # Keep the snapshot if a later argument can write the parameter itself.
    resource = ownership_type(ntype(n))
    # Owners cannot be global, captured, or exported. A readonly argument
    # cannot be reached by the callee except through another actual; those
    # aliases and later argument writes are checked above/by shares_mut_root.
    if resource: return false
    # (the source copy policy cannot depend on the build: it consults writes always)
    if not opt_release and not (copies_on and copy_strict(a)) or callee <= 0: return true
    w = fn_writes(callee)
    if w.all or w.globals.len() > 0: return true
    loop j in [i + 1..args.len()):
        if may_write_root(args[j], n): return true
    false

# Could a `mut` argument of the call reach the storage argument a is read from (borrowed, without
# a reference of its own), and release it? A plain local, or a read-only parameter (its caller
# keeps the value), is reached only through its own variable (shares_mut_root); a global or a
# `mut` parameter also through a `mut` parameter or an alias, but not through another global or
# plain local. O(arguments).
mut_may_reach = (a: int, args: int[], mutmask: int) -> bool:
    ra = place_var(a)
    if ra == 0 or shares_mut_root(a, args, mutmask): return true
    if nodes[ra].aux == i32(int(SK.local)):
        if mut_plain_root(ra): return false
    else if nodes[ra].aux != i32(int(SK.global)): return true
    loop j in 0.. and b in args:
        if mutmask & (1 << j) == 0: continue
        rb = place_var(b)
        if rb == 0: return true
        if nodes[rb].aux == i32(int(SK.global)) and nodes[ra].aux == i32(int(SK.global)): continue
        if nodes[rb].aux != i32(int(SK.local)) or not mut_plain_root(rb): return true
    false

# a local whose storage no other variable's place reaches (no alias, view, capture or address)
mut_plain_root = (r: int) -> bool:
    l = int(nodes[r].sym)
    fl = int(locals[l].flags)
    fl & (LF_MUTPARAM | LF_SHARED | LF_BYREF | LF_ALIAS | LF_CAPTURE | LF_CAPTURED | LF_ADDR | LF_ELEMALIAS | LF_SOAELEM | LF_ELEMENTVIEW | LF_OWNERBORROW) == 0 and not is_shared(l) and not held_views.contains(l)

# A `mut` argument that is an element of an array or map (xs[i], xs[i].f) is written through
# its address in the array's memory, which must not move or be shared while the call runs: the
# same call may not be given the array itself, and a global array may not be one the callee
# (or a later argument) can change. (Other elements, as in swap(xs[i], xs[j]), are fine.)
mut_alias_check = (args: int[], mutmask: int, callee: int):
    loop i in 0.. and a in args:
        if mutmask & (1 << i) == 0: continue
        r = elem_root(a)
        if r == 0: continue
        # (a place only in a box, not an array: the box is kept while the call runs, call_args)
        in_arr = pw_heap
        hint = ""
        if in_arr: hint = " (pass the index instead)"
        sa = place_steps(a)
        nm = name_of(int(nodes[r].name))
        loop j in 0.. and b in args:
            if j == i: continue
            bmut = mutmask & (1 << j) != 0
            w = place_var(b)
            # (another place that holds this one or is inside it: xs and xs[0], xs[0] and
            # xs[0][0]; other elements and fields are fine, as in swap(xs[i], xs[j]), and so is
            # reading numbers out of the array)
            nested = false
            if w != 0 and same_var(w, r) and (bmut or is_managed(ntype(b))):
                sb = place_steps(b)
                nested = steps_overlap(sa, sb) and not (bmut and sa.len() == sb.len())
            if nested or may_write_root(b, r):
                fatal(nodes[b].pos, "{place_text(a)} is passed as {jd(nodes[b].pos, "a `mut` argument", "an `@` argument")}, so this argument cannot also hold or change '{nm}'{hint}")
        glob = nodes[r].aux == i32(int(SK.global))
        lf = 0
        if not glob: lf = int(locals[int(nodes[r].sym)].flags)
        mutparam = lf & LF_MUTPARAM != 0
        # (a variable a closure changes: the callee may be that closure, or call it)
        if lf & LF_SHARED != 0 and (callee <= 0 or fn_writes(callee).all):
            fatal(nodes[a].pos, "'{nm}' is changed by a closure, which this call may run, so {place_text(a)} cannot be passed as {jd(nodes[a].pos, "a `mut` argument", "an `@` argument")}{hint}")
        if glob or mutparam:
            who = "the function called"
            if callee > 0: who = "'{name_of(int(nodes[int(fns[callee].decl)].name))}'"
            # (what the callee changes, as far as it names it; a call of a function value it
            # makes is not counted, or nearly every call into a library would be refused)
            fw = FnWrites(false, [], [], [])
            if callee > 0: fw = fn_writes_named(callee)
            if glob and fw.globals.contains(int(nodes[r].sym)):
                fatal(nodes[a].pos, "{who} may change the global '{nm}' (or call something that does), so {place_text(a)} cannot be passed to it as {jd(nodes[a].pos, "a `mut` argument", "an `@` argument")}{hint}")
            if mutparam and in_arr and param_may_alias(fw.globals, nodes[a].pos):
                fatal(nodes[a].pos, "{who} changes globals, and '{nm}' ({jd(nodes[a].pos, "a `mut` parameter", "an `@` parameter")}) may be one of them, so {place_text(a)} cannot be passed to it as {jd(nodes[a].pos, "a `mut` argument", "an `@` argument")}{hint}")

# Could a mutable parameter of code at pos be one of these globals? Dewy code
# cannot name the implementation's private state (the allocator, diagnostics,
# I/O status: `__` globals of implementation modules), so a Dewy parameter is
# never one of those, however many library calls write them.
param_may_alias = (written: int[], pos: int) -> bool:
    if not files[pos_file(pos)].is_dewy: return written.len() > 0
    loop g in written:
        d = int(globals[g].decl)
        if d == 0 or files[pos_file(nodes[d].pos)].is_dewy or not starts_with(name_of(int(globals[g].name)), "__"): return true
    false

# a place as written (xs[i].pos), for messages
place_text = (n: int) -> str:
    k = nodes[n].kind
    if k == .ident:
        nm = name_of(int(nodes[n].name))
        # (a narrowed field or global: the place it stands for)
        if starts_with(nm, "#") and nodes[n].aux == i32(int(SK.local)) and locals[int(nodes[n].sym)].alias != 0: return place_text(int(locals[int(nodes[n].sym)].alias))
        return nm
    if k == .narrow or k == .conv: return place_text(int(nodes[n].a))
    if k == .field: return "{place_text(int(nodes[n].a))}.{name_of(int(nodes[n].name))}"
    if k == .unwrap: return "{place_text(int(nodes[n].a))}!"
    if k == .index:
        b = int(nodes[n].b)
        i = "..."
        if nodes[b].kind == .ident: i = name_of(int(nodes[b].name))
        else if nodes[b].kind == .int_lit: i = "{nodes[b].ival}"
        # (a dictionary entry is stored in its values array: written as the dictionary's)
        a = int(nodes[n].a)
        if nodes[a].kind == .field and is_map_type(ntype(int(nodes[a].a))): return "{place_text(int(nodes[a].a))}[{i}]"
        return "{place_text(a)}[{i}]"
    "..."

# The variable a place belongs to: through fields, indexing, `!`, narrowing and the names that
# stand for a place (a narrowed variable or field, `loop mut`'s element). pw_heap: some step
# indexes an array or map; pw_box: some step is a boxed field; pw_depth: how many fields and
# indexes. 0 (no variable) for a place reached through a raw pointer, or a value that is no place.
pw_heap = false
pw_box = false
pw_depth = 0
place_var = (n0: int) -> int:
    n = n0
    pw_heap = false
    pw_box = false
    pw_depth = 0
    loop true:
        k = nodes[n].kind
        if k == .field or k == .index:
            bk = tkind(ntype(int(nodes[n].a)))
            if bk == .ptr: return 0
            if k == .index and bk != .fixed and bk != .vec: pw_heap = true
            if k == .field and boxed_field_of(n) >= 0: pw_box = true
            pw_depth += 1
            n = int(nodes[n].a)
        else if k == .unwrap or k == .narrow or (k == .fnref and nodes[n].aux == 2) or (k == .conv and nodes[n].aux == i32(int(CV.union_))): n = int(nodes[n].a)
        else if k == .ident and nodes[n].aux == i32(int(SK.local)) and int(locals[int(nodes[n].sym)].flags) & LF_ALIAS != 0 and locals[int(nodes[n].sym)].alias != 0:
            n = int(locals[int(nodes[n].sym)].alias)
        else: break
    if nodes[n].kind == .ident: return n
    0

# the fields and indexes of a place, from its variable on (as place_var follows them)
place_steps = (n0: int) -> int[]:
    out: int[]
    n = n0
    loop true:
        k = nodes[n].kind
        if k == .field or k == .index:
            out.insert(0, n)
            n = int(nodes[n].a)
        else if k == .unwrap or k == .narrow or (k == .conv and nodes[n].aux == i32(int(CV.union_))): n = int(nodes[n].a)
        else if k == .ident and nodes[n].aux == i32(int(SK.local)) and int(locals[int(nodes[n].sym)].flags) & LF_ALIAS != 0 and locals[int(nodes[n].sym)].alias != 0:
            n = int(locals[int(nodes[n].sym)].alias)
        else: break
    out

# could one of two places (steps from the same variable) hold the other: is the shorter a
# prefix of the longer, as far as the compiler can tell (xs[i] and xs[j] may be the same)?
steps_overlap = (a: int[], b: int[]) -> bool:
    loop k in [0..min(a.len(), b.len())):
        x = a[k]
        y = b[k]
        if nodes[x].kind != nodes[y].kind: return false
        if nodes[x].kind == .field and nodes[x].aux != nodes[y].aux: return false
        if nodes[x].kind == .index:
            bx = int(nodes[x].b)
            by = int(nodes[y].b)
            if nodes[bx].kind == .int_lit and nodes[by].kind == .int_lit and nodes[bx].ival != nodes[by].ival: return false
    true

# the variable (ident node) whose array or map, or box, holds the element place n is in, or 0
elem_root = (n: int) -> int:
    r = place_var(n)
    if pw_heap or pw_box: return r
    0

# does expression n name the variable of ident node r?
mentions_var = (n: int, r: int) -> bool:
    if n <= 0: return false
    if nodes[n].kind == .ident and same_var(n, r): return true
    if nodes[n].kind == .lambda: return false
    child_a = int(nodes[n].a)
    child_b = int(nodes[n].b)
    # (kid_c and kid_d, with the kind in hand)
    child_c = if nodes[n].kind == .for_: 0 else: int(nodes[n].c)
    child_d = if nodes[n].kind == .for_ or nodes[n].kind == .partial: 0 else: int(nodes[n].d)
    if mentions_var(child_a, r): return true
    if mentions_var(child_b, r): return true
    if mentions_var(child_c, r): return true
    if mentions_var(child_d, r): return true
    loop i in [0..nkids(n)):
        if mentions_var(kid(n, i), r): return true
    loop i in [0..nkids2(n)):
        if mentions_var(kid2(n, i), r): return true
    false

ret_vt = (t: int) -> int:
    c = vc(t)
    if c == VC_VOID: return -1
    if c == VC_AGG: return -1
    vt_of(t)

finish_call = (ret: int, rv: int, rslot: int) -> Val:
    c = vc(ret)
    if c == VC_AGG: return Val(e_slot(rslot), true, rslot)
    if c == VC_VOID: return V(-1, false)
    if c == VC_INT: return V(norm(rv, ret), true)
    V(rv, true)

inst_mutmask = (f: int) -> int:
    d = int(fns[f].decl)
    if d == 0 or nodes[d].kind != .fn_: return 0
    di = int(nodes[d].sym)
    if di > 0 and decl_infos[di].sig.done: return int(decl_infos[di].sig.mutmask)
    mm = 0
    loop i in [0..fns[f].ptypes.len()):
        if has_flag(kid(d, i), NF_MUT): mm |= 1 << i
    mm

# A checked method receiver may still carry syntactic NF_MUT permission even
# when overload resolution selected a read-only parameter. Effects follow the
# resolved signature, just as argument lowering does; keep syntax flags intact.
checked_call_mutmask = (n: int) -> int:
    k = nodes[n].kind
    if k == .pair and nodes[n].sym > 0: return inst_mutmask(int(nodes[n].sym))
    if k != .call: return 0
    aux = int(nodes[n].aux)
    if aux == 0 and nodes[n].sym > 0: return inst_mutmask(int(nodes[n].sym))
    if aux == 1 or aux == 4:
        ft = prune(ntype(int(nodes[n].a)))
        return int(types[ft].mutmask)
    0

# ---------------- data races ----------------
# A function given to a parallel call (parallel_map, `parallel`...) runs on many threads at once:
# it must not change the variables it captured, or globals -- also not in the functions it calls.
# A callback parameter given on is its function's callers' to check (concurrency.jo, parsafe).
race_done: {int: bool} = {}     # named functions known not to change globals

race_check = (callee: int, args: int[], pos: int):
    # (the library's own calls take care of threads themselves)
    if in_lib(pos): return
    who = name_of(int(nodes[int(fns[callee].decl)].name))
    loop a in args:
        if tkind(ntype(a)) == .fn_ and not concurrency.parsafe_vouched(a): race_arg(a, who)

# the function value a: the compiler must see which function it is, to check it
race_arg = (a: int, who: str):
    k = nodes[a].kind
    if k == .conv: race_arg(int(nodes[a].a), who)
    else if k == .lambda: race_scan(int(fns[int(nodes[a].sym)].body), int(nodes[a].sym), who, true)
    else if k == .fnref:
        f = int(nodes[a].sym)
        if nodes[a].aux == 2: race_scan(int(fns[f].body), f, who, true)
        else: race_named(f, who)
    else if k == .partial:
        if nodes[a].aux == 1: race_arg(int(nodes[a].a), who)
        else: race_named(int(nodes[a].sym), who)
    else: fatal(nodes[a].pos, "{who} runs this function on many threads at once, so the compiler checks it for data races, which it can only do for a function it can see: pass a function by name or a lambda")

# a @parallel function is checked at its calls: it cannot be used as a value
parallel_direct = (f: int, pos: int):
    if f > 0 and fns[f].parallel_api and not in_lib(pos):
        fatal(pos, "'{name_of(int(nodes[int(fns[f].decl)].name))}' runs the function it is given on many threads at once, so it can only be called directly (where the compiler checks that function), not used as a value or partially applied")

# (a type or module where a value is wanted: P, Box[int])
type_as_value = (e: int):
    what = "a type"
    if tkind(ntype(e)) == .module: what = "a module"
    fatal(nodes[e].pos, "this is {what}, not a value (a value of a type is made by calling it: `T()`)")

# is position pos in the library (lib_dir)?
in_lib = (pos: int) -> bool:
    fi = pos_file(pos)
    fi >= 0 and fi < files.len() and starts_with(files[fi].path, lib_dir + "/")

race_named = (f: int, who: str):
    if race_done.contains(f) or fns[f].body == 0: return
    race_done[f] = true
    # (the core and standard libraries take care of threads themselves)
    if fns[f].decl != 0:
        fi = pos_file(int(nodes[int(fns[f].decl)].pos))
        if fi >= 0 and fi < files.len() and starts_with(files[fi].path, lib_dir + "/") and (find(files[fi].path, "/core/") >= 0 or find(files[fi].path, "/std/") >= 0): return
    race_scan(int(fns[f].body), f, who, false)

# a place that changes: the variable it belongs to, if that is shared with other threads
race_target = (t: int, f: int, who: str, captures: bool, pos: int):
    # (writing through a pointer changes memory the program manages itself, not the variable)
    n = place_var(t)
    if n == 0: return
    nm = name_of(int(nodes[n].name))
    if nodes[n].aux == i32(int(SK.global)):
        fatal(pos, "{who} runs this function on many threads at once, so it must not change the global '{nm}' (a data race): return values instead")
    if captures and nodes[n].aux == i32(int(SK.local)):
        l = int(nodes[n].sym)
        if int(locals[l].owner) != f or int(locals[l].flags) & LF_CAPTURE != 0:
            fatal(pos, "{who} runs this function on many threads at once, so it must not change '{nm}', a variable it captured (a data race): return values instead")

race_scan = (n: int, f: int, who: str, captures: bool):
    if n == 0: return
    loop called in value_helper_calls(n): race_named(called, who)
    k = nodes[n].kind
    if k == .lambda: return
    if k == .assign: race_target(int(nodes[n].a), f, who, captures, nodes[n].pos)
    else if k == .intrinsic and nkids(n) > 0:
        id = nodes[n].aux as IN
        if id == .push or id == .pop or id == .insert or id == .remove or id == .clear or id == .reserve or id == .resize or id == .truncate or id == .extend:
            race_target(kid(n, 0), f, who, captures, nodes[n].pos)
    else if k == .call:
        mm = checked_call_mutmask(n)
        loop i in [0..nkids(n)):
            if mm & (1 << i) != 0: race_target(kid(n, i), f, who, captures, nodes[kid(n, i)].pos)
        aux = int(nodes[n].aux)
        if aux == 0 and nodes[n].sym > 0: race_named(int(nodes[n].sym), who)
        # (calling a function value: which one, the compiler cannot tell; the library's are its own,
        # and a callback parameter's are its function's callers' to check)
        else if aux == 1 and not in_lib(nodes[n].pos) and not concurrency.parsafe_vouched(int(nodes[n].a)):
            fatal(nodes[n].pos, "{who} runs this code on many threads at once, so the compiler checks it for data races, which it cannot do through a call of a function value: call a function by name")
    else if k == .for_ and has_flag(n, NF_MUT): race_target(int(nodes[n].a), f, who, captures, nodes[n].pos)
    # (a part of "...{x}...": formatted by a __fmt function, which may be the program's)
    else if k == .pair and nodes[n].sym > 0: race_named(int(nodes[n].sym), who)
    race_scan(int(nodes[n].a), f, who, captures)
    race_scan(int(nodes[n].b), f, who, captures)
    if k != .for_:
        race_scan(int(nodes[n].c), f, who, captures)
        if k != .partial: race_scan(int(nodes[n].d), f, who, captures)
    loop i in [0..nkids(n)): race_scan(kid(n, i), f, who, captures)
    loop i in [0..nkids2(n)): race_scan(kid2(n, i), f, who, captures)

# A positive floor remainder bounds its result even when its input wraps.
# Recognize the bundled signed helper, never a user overload with this name.
positive_modulus = (n: int) -> int:
    if nodes[n].kind == .binary and nodes[n].aux == 0 and nodes[n].op == i32(int(Tok.percent)) and nodes[n].aux2 == -1:
        known, divisor = integer_constant(int(nodes[n].b))
        return if known and divisor > 0: divisor else: 0
    if nodes[n].kind != .call or nodes[n].aux != 0 or nkids(n) != 2: return 0
    f = int(nodes[n].sym)
    if prune(int(fns[f].ret)) != T_INT and prune(int(fns[f].ret)) != T_MATH_INT: return 0
    d = int(fns[f].decl)
    if d == 0: return 0
    masked = nodes[d].name == intern("__floor_mod_pow2")
    if nodes[d].name != intern("__floor_mod") and not masked: return 0
    if files[pos_file(nodes[d].pos)].path != lib_dir + "/std/date.jo" and files[pos_file(nodes[d].pos)].path != lib_dir + "/math_int.jo": return 0
    b = kid(n, 1)
    if nodes[b].kind != .int_lit or has_flag(b, NF_U64) or nodes[b].ival <= 0: return 0
    if masked:
        if nodes[b].ival == 9223372036854775807: return 0
        return nodes[b].ival + 1
    nodes[b].ival

# Keep ordinary integer arithmetic cheap without requiring whole-program
# inlining. Only bundled helpers and literal positive divisors are eligible;
# zero, negative divisors and user overloads keep their ordinary call paths.
# `bytes.read<uint64>(i)` (the library's __dewy_read_u64, u32 and u16): its check and an
# unaligned load in place of the call, which a default build would not expand. The
# receiver is kept alive only when the offset's evaluation could change it.
# (an offset of plain reads, literals and builtin integer arithmetic: it calls nothing and
# writes nothing, so the receiver read before it stands)
byte_offset_plain = (n: int) -> bool:
    if plain_read(n): return true
    k = nodes[n].kind
    if k == .binary and nodes[n].aux == 0 and is_int(ntype(n)): return byte_offset_plain(int(nodes[n].a)) and byte_offset_plain(int(nodes[n].b))
    if k == .conv and nodes[n].aux == i32(int(CV.int_)): return byte_offset_plain(int(nodes[n].a))
    false

# ---------------- ticks that must agree ----------------
# A function given to a @deterministic function (netplay.session's tick) must give the same game
# on every machine from the same game and inputs: no random numbers but from a seed in the game,
# no clock, no input read there (it comes as the tick's input), and no globals changed (a
# rollback does not put them back) -- also not in the functions it calls. Warnings: random()
# after seed() from the game, say, is the same everywhere.
# ---------------- closures ----------------
env_layout = (f: int):
    if fns[f].env_size != 0: return
    if fns[f].kind == FK_LAMBDA and fns[f].target != 0:
        poly_env_layout(int(fns[f].target))
        return
    off = if ownership_callable_cap(int(fns[f].fntype)) != 0: 32 else: 24
    loop cap in fns[f].caps:
        inn = int(cap.inner)
        math_prepare_capture(inn)
        if is_shared(inn): check_cell_type(inn)
        t = store_type(inn)
        al = talign(t)
        if al < 8: al = 8
        off = align_up(off, al)
        # A run-once task may transfer a capture on one branch only. Keep its
        # live bit beside the payload; the construction prefix still guards it.
        if spawn_owned_capture(f, inn): off = align_up(off + 8, al)
        locals[inn].env_off = i32(off)
        off += tsize(t)
    fns[f].env_size = i32(align_up(off, 8))

closure_size = () -> int: 2 * ptr_size

# A direct local closure may keep its environment in this activation when every
# reference is a direct invocation, or an immutable environment is passed to
# an invocation-only parameter. Copies, returns, captures, rebinding and
# address-taking retain the ordinary heap representation.
lower_entry: Ins[]
stack_closure_fn = -1
stack_closure_locals: {int: bool} = {}
stack_closure_targets: {int: int} = {}
stack_closure_passed: {int: bool} = {}

# Match envcopy's retain-only case. A mutable or owner environment must still
# use the heap: its copy helper may allocate and copy the environment header.
closure_env_shareable = (f: int) -> bool:
    if ownership_callable_cap(int(fns[f].fntype)) != 0: return false
    loop cap in fns[f].caps:
        inn = int(cap.inner)
        flags = int(locals[inn].flags)
        if flags & LF_VALUECAP != 0 and (flags & (LF_ASSIGNED | LF_EXPOSED) != 0 or is_shared(inn) or type_has_fn(int(locals[inn].type)) or ownership_type(int(locals[inn].type))): return false
    true

stack_closure_target = (l: int) -> int:
    if stack_closure_fn != cur_fn: return -1
    stack_closure_targets.get(l) ?? -1

# Invocation pins have ended before scope cleanup. No value can retain this
# environment, so only its managed captures need destruction, with no RC dispatch.
closure_managed_captures = (f: int) -> bool:
    loop cap in fns[f].caps:
        if is_managed(store_type(int(cap.inner))): return true
    false

closure_scalar_environment = (f: int) -> bool:
    ownership_callable_cap(int(fns[f].fntype)) == 0 and not closure_managed_captures(f)

drop_stack_closure = (addr: int, f: int):
    if not closure_managed_captures(f): return
    env = e_load(VI, addr, ptr_size, ptr_size)
    iff(env)
    e_call1(lf_helper(.stackenvdrop, 0, f), env, -1)
    endc()

stack_closure_uses = (n: int, called: bool = false):
    if n == 0: return
    k = nodes[n].kind
    if k == .lambda or k == .fn_: return
    if k == .fnref and nodes[n].aux == 2:
        stack_closure_uses(int(nodes[n].a), called)
        return
    if k == .ident:
        if not called and nodes[n].aux == i32(int(SK.local)):
            l = int(nodes[n].sym)
            if stack_closure_locals.has(l): stack_closure_locals[l] = false
        return
    a = int(nodes[n].a)
    direct = k == .call and nodes[n].aux == 1 and a != 0 and (nodes[a].kind == .ident or nodes[a].kind == .fnref and nodes[a].aux == 2)
    stack_closure_uses(a, direct)
    stack_closure_uses(int(nodes[n].b))
    if k != .for_:
        stack_closure_uses(int(nodes[n].c))
        if k != .partial: stack_closure_uses(int(nodes[n].d))
    loop i in [0..nkids(n)):
        arg = kid(n, i)
        safe = k == .call and nodes[n].aux == 0 and nodes[arg].kind == .ident and nodes[arg].aux == i32(int(SK.local)) and stack_closure_locals.has(int(nodes[arg].sym)) and closure_borrow_param(int(nodes[n].sym), i)
        if safe: stack_closure_passed[int(nodes[arg].sym)] = true
        stack_closure_uses(arg, safe)
    loop i in [0..nkids2(n)): stack_closure_uses(kid2(n, i))

stack_closure_local = (l: int) -> bool:
    if stack_closure_fn != cur_fn:
        stack_closure_fn = cur_fn
        stack_closure_locals.clear()
        stack_closure_targets.clear()
        stack_closure_passed.clear()
        stack_closure_params.clear()
        skip = LF_CONST | LF_PARAM | LF_MUTPARAM | LF_ASSIGNED | LF_CAPTURE | LF_CAPTURED | LF_ADDR | LF_BYREF | LF_ALIAS | LF_SHARED
        loop candidate in fns[cur_fn].locals:
            if int(locals[candidate].flags) & skip != 0: continue
            if is_fn_type(int(locals[candidate].type)) or tkind(int(locals[candidate].type)) == .polyfn: stack_closure_locals[candidate] = true
        if stack_closure_locals.len() > 0: stack_closure_uses(int(fns[cur_fn].body))
    stack_closure_locals.get(l) ?? false

partial_layout = (e: int) -> int[]:
    offs: int[]
    off = 24
    if nodes[e].aux == 1: off += closure_size()
    loop i in [0..nkids(e)):
        a = kid(e, i)
        if nodes[a].kind == .hole:
            offs.push(-1)
            continue
        t = ntype(a)
        al = talign(t)
        if al < 8: al = 8
        off = align_up(off, al)
        offs.push(off)
        off += tsize(t)
    offs.push(align_up(off, 8))
    offs

# ---------------- string interpolation ----------------
# ---------------- value blocks ----------------
result_from_slot = (rs: int, t: int) -> Val:
    a = e_slot(rs)
    if vc(t) == VC_AGG: return Val(a, true, rs)
    value = load_val(t, a, 0)
    if ownership_type(t): return Val(value, true, rs)
    V(value, true)

# ---------------- match ----------------
# constant value of an integer literal pattern
pat_int = (a0: int) -> (bool, int):
    a = a0
    if nodes[a].kind == .conv: a = int(nodes[a].a)
    if nodes[a].kind == .int_lit: return (true, nodes[a].ival)
    (false, 0)

# A dense match whose arms are scalar constants needs a data lookup, not
# one machine-code branch per arm. Keep the subject's existing evaluation and
# lifetime, and leave effectful/converting bodies on the ordinary path.
match_arm_constant = (arm: int) -> (bool, int):
    body = int(nodes[arm].b)
    if nodes[body].aux == 0 or nkids(body) != 1: return (false, 0)
    statement = kid(body, 0)
    if nodes[statement].kind != .exprstmt: return (false, 0)
    value = int(nodes[statement].a)
    kind = nodes[value].kind
    if kind == .int_lit or kind == .bool_lit: return (true, nodes[value].ival)
    if kind == .dotname:
        t = prune(ntype(value))
        si = int(types[t].st)
        if structs[si].simple_enum: return (true, variants[int(structs[si].variants) + int(nodes[value].aux)].value)
    (false, 0)

gen_match_lookup = (m: int, st: int, rs: int, rtp: int, vals: int[], arms: int[], wild: int, lo: int, span: int) -> bool:
    if exact_has_node(m) or wild < 0: return false
    # Arbitrary-precision int results aren't plain words.
    if quantity_base(prune(rtp)) == T_MATH_INT: return false
    result_kind = types[prune(rtp)].kind
    if result_kind != .int_ and result_kind != .bool_ and result_kind != .enum_: return false
    if result_kind == .enum_ and not structs[int(types[prune(rtp)].st)].simple_enum: return false
    results: int[]
    low = 0
    high = 0
    loop i in [0..nkids(m)):
        ok, value = match_arm_constant(kid(m, i))
        if not ok: return false
        results.push(value)
        if value < low: low = value
        if value > high: high = value
    width = 8
    signed = low < 0
    if low >= 0:
        if high <= 255: width = 1
        else if high <= 65535: width = 2
        else if high <= 4294967295: width = 4
    else:
        if low >= -128 and high <= 127: width = 1
        else if low >= -32768 and high <= 32767: width = 2
        else if low >= -2147483648 and high <= 2147483647: width = 4
    fallback = results[wild]
    table = fill(fallback, span)
    # Earlier arms win, including an earlier wildcard.
    j = vals.len() - 1
    loop j >= 0:
        if arms[j] < wild: table[vals[j] - lo] = results[arms[j]]
        j -= 1
    loop rodata.len() % width != 0: rodata.push(0)
    offset = rodata.len()
    ro_starts.push(offset)
    loop value in table:
        loop byte in [0..width): rodata.push(u8((value >> (8 * byte)) & 255))
    if fused_on: fz_note_raw(offset, width)
    ha = e_slot(int(locals[int(nodes[m].sym)].offset))
    x = if types[st].kind == .enum_: e_load(VI, ha, 0, 4) else: load_val(st, ha, 0)
    index = e_bin(.sub, VI, x, e_iconst(lo))
    result = vreg(VI)
    e_mov(result, e_iconst(fallback))
    iff(e_bin(.ltu, VI, index, e_iconst(span)))
    address = e_bin(.add, VI, e_daddr(offset), e_bin(.mul, VI, index, e_iconst(width)))
    e_mov(result, e_load(VI, address, 0, width | (if signed: M_SIGNED else: 0)))
    endc()
    store_val(rtp, e_slot(rs), 0, result)
    true

# matches on enum tags or integer literals with a dense value range dispatch through a jump table
# ---------------- binary ----------------
gen_eq = (t: int, a: int, b: int) -> int: e_call2(lf_helper(.eq, prune(t), 0), a, b, VI)

int_op = (op: Tok, sg: bool) -> Op:
    match op:
        plus: .add
        minus: .sub
        star: .mul
        slash:
            if sg: return .divs
            .divu
        percent:
            if sg: return .rems
            .remu
        amp: .and_
        pipe: .or_
        caret: .xor
        shl: .shl
        shr:
            if sg: return .shrs
            .shru
        eq: .eq
        ne: .ne
        lt:
            if sg: return .lts
            .ltu
        le:
            if sg: return .les
            .leu
        gt:
            if sg: return .gts
            .gtu
        ge:
            if sg: return .ges
            .geu
        _: .nop

float_op = (op: Tok) -> Op:
    match op:
        plus: .fadd
        minus: .fsub
        star: .fmul
        slash: .fdiv
        eq: .feq
        ne: .fne
        lt: .flt
        le: .fle
        gt: .fgt
        ge: .fge
        _: .nop

is_slice = (x: int) -> bool: nodes[x].kind == .index and nodes[x].aux == 1

# The address of x's value, kept through later operand evaluation.
# A failed conversion of an `int` to a narrower width. (`int` arithmetic itself
# never fails: math_binary promotes, MIN // -1 included.)
math_int_guard = (bad: int):
    iff(bad)
    e_call_nr0(rt("__int_overflow"), -1)
    endc()

# Arrays of plain integers or bools are equal when their bytes are: the lengths, then
# __mem_eq (expanded inline) over the elements where they are. A slice, xs[i..j) =? ys,
# is a range of its source, not a new array.
byte_eq_type = (t: int) -> bool:
    if tkind(t) != .array: return false
    et = prune(int(types[t].elem))
    (types[et].kind == .int_ and et != T_MATH_INT) or types[et].kind == .bool_

# the string a byte view of it is (`s as array<uint8>`: the same storage), or n
text_source = (n: int) -> int:
    k = nodes[n].kind
    if (k == .conv or k == .cast) and tkind(ntype(n)) == .array and tkind(ntype(int(nodes[n].a))) == .str_: return int(nodes[n].a)
    n

# where an array operand's elements start, and how many: a slice's checked range of its
# source (kept alive while later evaluation could release it)
# High unsigned product without allocating, including targets without mulhu.
fixed_mul_high = (a: int, b: int) -> int:
    if mulh_ok: return e_bin(.mulhu, VI, a, b)
    mask = e_iconst(4294967295)
    shift = e_iconst(32)
    al = e_bin(.and_, VI, a, mask); ah = e_bin(.shru, VI, a, shift)
    bl = e_bin(.and_, VI, b, mask); bh = e_bin(.shru, VI, b, shift)
    low = e_bin(.mul, VI, al, bl)
    cross = e_bin(.add, VI, e_bin(.mul, VI, ah, bl), e_bin(.shru, VI, low, shift))
    next = e_bin(.add, VI, e_bin(.mul, VI, al, bh), e_bin(.and_, VI, cross, mask))
    e_bin(.add, VI, e_bin(.mul, VI, ah, bh), e_bin(.add, VI, e_bin(.shru, VI, cross, shift), e_bin(.shru, VI, next, shift)))

# Saturating policy arithmetic detects word overflow before narrowing. Widening
# multiplication uses the target's high-half instruction, or its inline 32-bit decomposition.
saturate_binary = (op: Tok, t: int, a: int, b: int) -> int:
    signed = types[t].sign
    bits = int(types[t].bits)
    hi = if bits == 64: -1 else: (1 << bits) - 1
    lo = 0
    if signed:
        hi = int(u64(hi) >> 1)
        lo = -hi - 1
    value = e_bin(int_op(op, signed), VI, a, b)
    bad = e_iconst(0)
    negative = e_iconst(0)
    if signed:
        if op == .plus:
            bad = e_bin(.lts, VI, e_bin(.and_, VI, e_bin(.xor, VI, a, value), e_bin(.xor, VI, b, value)), e_iconst(0))
            negative = e_bin(.lts, VI, a, e_iconst(0))
        else if op == .minus:
            bad = e_bin(.lts, VI, e_bin(.and_, VI, e_bin(.xor, VI, a, b), e_bin(.xor, VI, a, value)), e_iconst(0))
            negative = e_bin(.lts, VI, a, e_iconst(0))
        else:
            high = if mulh_ok: e_bin(.mulhs, VI, a, b) else: fixed_mul_high(a, b)
            if not mulh_ok:
                high = e_bin(.sub, VI, high, e_bin(.and_, VI, e_bin(.shrs, VI, a, e_iconst(63)), b))
                high = e_bin(.sub, VI, high, e_bin(.and_, VI, e_bin(.shrs, VI, b, e_iconst(63)), a))
            bad = e_bin(.ne, VI, high, e_bin(.shrs, VI, value, e_iconst(63)))
            negative = e_bin(.lts, VI, e_bin(.xor, VI, a, b), e_iconst(0))
    else:
        if op == .plus: bad = e_bin(.ltu, VI, value, a)
        else if op == .minus:
            bad = e_bin(.ltu, VI, a, b)
            negative = e_iconst(1)
        else:
            high = fixed_mul_high(a, b)
            bad = e_bin(.ne, VI, high, e_iconst(0))
    out = vreg(VI)
    e_mov(out, value)
    iff(bad)
    iff(negative)
    e_mov(out, e_iconst(lo))
    els()
    e_mov(out, e_iconst(hi))
    endc()
    els()
    if signed:
        iff(e_bin(.lts, VI, value, e_iconst(lo)))
        e_mov(out, e_iconst(lo))
        endc()
    iff(e_bin((if signed: Op.gts else: Op.gtu), VI, value, e_iconst(hi)))
    e_mov(out, e_iconst(hi))
    endc()
    endc()
    out

saturate_shift = (t: int, a: int, count: int) -> int:
    signed = types[t].sign
    bits = int(types[t].bits)
    hi = if bits == 64: -1 else: (1 << bits) - 1
    lo = 0
    if signed:
        hi = int(u64(hi) >> 1)
        lo = -hi - 1
    out = vreg(VI)
    endpoint = vreg(VI)
    e_mov(endpoint, e_iconst(hi))
    if signed:
        iff(e_bin(.lts, VI, a, e_iconst(0)))
        e_mov(endpoint, e_iconst(lo))
        endc()
    e_mov(out, e_iconst(0))
    iff(e_bin(.ne, VI, a, e_iconst(0)))
    iff(e_bin(.geu, VI, count, e_iconst(64)))
    e_mov(out, endpoint)
    els()
    shifted = e_bin(.shl, VI, a, count)
    restored = e_bin((if signed: Op.shrs else: Op.shru), VI, shifted, count)
    iff(e_bin(.ne, VI, a, restored))
    e_mov(out, endpoint)
    els()
    e_mov(out, saturate_binary(.plus, t, shifted, e_iconst(0)))
    endc()
    endc()
    endc()
    out

# A Dewy shift count is unsigned, and a count of at least the register width
# reaches the shift's continuation bits: 0, or the sign for a signed right
# shift. Narrower types are already 0 or sign-filled past their width once
# normalized. The machine masks the count, so a count not known to be below
# 64 pays for a branch-free mask shared by shifts of the same count: all ones
# within range, else zero. A left or unsigned right shift is ANDed with it; a
# signed right shift sets the count's low bits, making the machine shift by 63.
wide_shift = (op: Tok, sg: bool, va: int, vb: int, count: int) -> int:
    k = shift_count_bound(count)
    if k >= 64:
        if op == .shr and sg: return e_bin(.shrs, VI, va, e_iconst(63))
        return e_iconst(0)
    if k >= 0: return e_bin(int_op(op, sg), VI, va, vb)
    # ((count >> 6) - 1) >> 63: all ones exactly when count < 64, unsigned
    within = e_bin(.shrs, VI, e_addi(e_bin(.shru, VI, vb, e_iconst(6)), -1), e_iconst(63))
    if op == .shr and sg:
        beyond = e_bin(.and_, VI, e_un(.not_, VI, within), e_iconst(63))
        return e_bin(.shrs, VI, va, e_bin(.or_, VI, vb, beyond))
    e_bin(.and_, VI, e_bin(int_op(op, sg), VI, va, vb), within)

# An unsigned bound on a shift count from its syntax: the literal itself (64
# for any count of at least 64, or a negative one), or the mask of
# `count & mask`; -1 when unknown.
shift_count_bound = (n: int) -> int:
    let n = n
    loop nodes[n].kind == .conv: n = int(nodes[n].a)
    k = nodes[n].kind
    if k == .int_lit: return if nodes[n].ival < 0: 64 else: min(nodes[n].ival, 64)
    if k == .binary and (nodes[n].op as Tok) == .amp:
        a = shift_count_bound(int(nodes[n].a))
        b = shift_count_bound(int(nodes[n].b))
        if nodes[int(nodes[n].b)].kind == .int_lit and b >= 0 and b < 64: return b
        if nodes[int(nodes[n].a)].kind == .int_lit and a >= 0 and a < 64: return a
    -1

# signed / and % of 64-bit integers wrap like other arithmetic: the smallest integer / -1 is
# itself and % -1 is 0 (the machine's division would trap on the quotient)
sdiv_wrap = (op: Tok, va: int, vb: int, t: int) -> int:
    if tsize(t) < 8: return e_bin(int_op(op, true), VI, va, vb)
    d = vreg(VI)
    iff(e_bin(.eq, VI, vb, e_iconst(-1)))
    if op == .slash: e_mov(d, e_un(.neg, VI, va))
    else: e_mov(d, e_iconst(0))
    els()
    e_mov(d, e_bin(int_op(op, true), VI, va, vb))
    endc()
    d

# the offsets of the Textures in a value of type t (at offset base), into out
texture_offsets = (t0: int, base: int, out: mut int[]):
    t = prune(t0)
    k = types[t].kind
    if k == .fixed:
        et = int(types[t].elem)
        loop i in [0..fixed_len(t)): texture_offsets(et, base + i * tsize(et), out)
    else if k == .struct_ and not is_union(t):
        si = int(types[t].st)
        if is_lib_texture(si):
            out.push(base)
            return
        loop fo in field_list(t): texture_offsets(fo.0, base + fo.1, out)

# does expression n call a function (directly, or formatting a part of a string)?
has_call = (n: int) -> bool:
    if n <= 0: return false
    k = nodes[n].kind
    if k == .call or (k == .pair and nodes[n].sym > 0): return true
    if k == .lambda: return false
    child_a = int(nodes[n].a)
    child_b = int(nodes[n].b)
    # (kid_c and kid_d, with the kind in hand)
    child_c = if nodes[n].kind == .for_: 0 else: int(nodes[n].c)
    child_d = if nodes[n].kind == .for_ or nodes[n].kind == .partial: 0 else: int(nodes[n].d)
    if has_call(child_a): return true
    if has_call(child_b): return true
    if has_call(child_c): return true
    if has_call(child_d): return true
    loop i in [0..nkids(n)):
        if has_call(kid(n, i)): return true
    loop i in [0..nkids2(n)):
        if has_call(kid2(n, i)): return true
    false

# can evaluating n change what an assignment's destination indices read: a call, an assignment
# or a statement inside it, or an operation that resizes or formats through user code?
assign_rhs_effects = (n: int) -> bool:
    if n <= 0: return false
    k = nodes[n].kind
    if k == .call or (k == .pair and nodes[n].sym > 0) or k == .assign or k == .block or k == .for_ or k == .while_: return true
    if k == .lambda: return false
    if k == .intrinsic:
        id = nodes[n].aux as IN
        if id == .fmt_struct or id == .json_fields or id == .push or id == .pop or id == .insert or id == .remove or id == .clear or id == .reserve or id == .resize or id == .truncate or id == .extend: return true
    if assign_rhs_effects(int(nodes[n].a)) or assign_rhs_effects(int(nodes[n].b)): return true
    if assign_rhs_effects(kid_c(n)) or assign_rhs_effects(kid_d(n)): return true
    loop i in [0..nkids(n)):
        if assign_rhs_effects(kid(n, i)): return true
    loop i in [0..nkids2(n)):
        if assign_rhs_effects(kid2(n, i)): return true
    false

# does index n read the same before and after rhs runs, with nothing of its own to run or trap:
# literals and plain locals rhs does not write, under arithmetic with no storage check?
# Checked exact stores are conversion nodes and must be captured. O(nodes of n x nodes of rhs)
index_stable = (n: int, rhs: int) -> bool:
    k = nodes[n].kind
    if k == .int_lit: return true
    if k == .ident: return nodes[n].aux == i32(int(SK.local)) and mut_plain_root(n) and not may_write_root(rhs, n)
    if k != .binary or not is_int(ntype(n)) or prune(ntype(n)) == T_MATH_INT or int_policy(ntype(n)) != 0: return false
    op = nodes[n].op as Tok
    if op != .plus and op != .minus and op != .star and op != .amp and op != .pipe and op != .caret and op != .kw_xor: return false
    index_stable(int(nodes[n].a), rhs) and index_stable(int(nodes[n].b), rhs)

retain_elems = (arr: int, et: int):
    # retain every element of a freshly copied array
    n = arr_len(arr)
    i = vreg(VI)
    e_mov(i, e_iconst(0))
    blk()
    lop()
    brif_to(e_bin(.ges, VI, i, n), ctl - 1)
    ea = e_bin(.add, VI, e_addi(arr, 24), e_bin(.mul, VI, i, e_iconst(owner_stride(et))))
    if ownership_type(et): iff(e_load(VI, ea, tsize(et), 1))
    copy_at(ea, et)
    if ownership_type(et): endc()
    e_mov(i, e_addi(i, 1))
    br_to(ctl)
    endc()
    endc()

# ---------------- vectors ----------------
vec_comps = (t: int) -> int:
    if prune(t) == T_MAT4: return 16
    int(types[prune(t)].bits)

# f32 x as an i32: toward zero, saturating, NaN to 0
f2i_i32 = (x: int) -> int:
    d = vreg(VI)
    emit(.f2i, VS, d, x, 0, 0, 0)
    iff(e_bin(.lts, VI, d, e_iconst(-2147483647 - 1)))
    e_mov(d, e_iconst(-2147483647 - 1))
    endc()
    iff(e_bin(.gts, VI, d, e_iconst(2147483647)))
    e_mov(d, e_iconst(2147483647))
    endc()
    d

data_writable = (e: int) -> bool:
    k = nodes[e].kind
    if k == .field or k == .index or k == .unwrap or k == .narrow:
        # A field/element of owned storage needs the same detachment as a named
        # array. Slices are temporary values, not writable storage paths.
        if k == .index and nodes[e].aux == 1: return false
        return data_writable(int(nodes[e].a))
    if k != .ident: return false
    if nodes[e].aux == i32(int(SK.global)): return true
    if nodes[e].aux != i32(int(SK.local)): return false
    l = int(nodes[e].sym)
    f = int(locals[l].flags)
    if f & LF_ALIAS != 0: return locals[l].alias != 0 and data_writable(int(locals[l].alias))
    if f & LF_BYREF != 0: return false
    if f & LF_CAPTURE != 0: return f & LF_VALUECAP != 0 or is_shared(l)
    f & LF_PARAM == 0 or f & LF_MUTPARAM != 0

# ---------------- intrinsics ----------------
struct LoanCapacity:
    place: PlaceIdentity
    limit: int
loan_capacities: LoanCapacity[]

# O(1) intrinsic dispatch and indexed operand reads. Each handler performs
# only its own lowering and helper work; list offsets survive AST/list growth.
# `xs.ptr[i]`'s base: the elements' address without data()'s null test. A nil array has
# no element to reach, so the indexed address is out of bounds either way.
# the array's header pointer for data() node e (null for a nil array)
gen_intrinsic_zeroed = (e: int, arg_start: int) -> Val:
    t = ntype(e)
    if vc(t) != VC_AGG: return V(zero_val(t), true)
    z = e_slot(new_temp(t))
    e_zero(z, tsize(t))
    return V(z, true)

gen_intrinsic_unreachable = (e: int, arg_start: int) -> Val:
    e_call_nr1(rt("__panic"), e_daddr(str_data("unreachable code reached")), -1)
    return never_after(e)

gen_intrinsic_embed = (e: int, arg_start: int) -> Val:
    s = name_of(int(nodes[e].sval))
    return V(e_daddr(str_data(s)), false)

gen_intrinsic_argv = (e: int, arg_start: int) -> Val:
    d = vreg(VI)
    emit(.intr, VI, d, 0, 0, 0, 1)
    return V(d, false)

gen_intrinsic_gpu_kernel = (e: int, arg_start: int) -> Val:
    arg0 = int(lists[arg_start])
    arg1 = int(lists[arg_start + 1])
    # (the GLSL program, then, past a 0 byte, the SPIR-V one for Vulkan: not on the web)
    kf = int(nodes[arg0].sym)
    kd = name_of(int(nodes[arg1].sval))
    ks = glsl_kernel(kf, kd)
    # (on macOS, Metal's in place of SPIR-V)
    if target_macos: ks = ks + str_from_bytes([u8(0)]) + msl_kernel(kf, kd)
    else if not target_wasm: ks = ks + str_from_bytes([u8(0)]) + spirv_kernel(kf, kd)
    return V(e_daddr(str_data(ks)), false)

gen_intrinsic_compute_spirv = (e: int, arg_start: int) -> Val:
    arg0 = int(lists[arg_start])
    cs = ""
    if target_macos: cs = msl_compute(int(nodes[arg0].sym))
    else if not target_wasm: cs = spirv_compute(int(nodes[arg0].sym))
    return V(e_daddr(str_data(cs)), false)

gen_intrinsic_compute_textures = (e: int, arg_start: int) -> Val:
    arg0 = int(lists[arg_start])
    # where the parameters hold Textures (their GL names, given slots when dispatched): "8,40"
    offs: int[]
    texture_offsets(fns[int(nodes[arg0].sym)].ptypes[1], 0, offs)
    ts = ""
    loop i in 0.. and o in offs:
        if i > 0: ts += ","
        ts += "{o}"
    return V(e_daddr(str_data(ts)), false)

gen_intrinsic_shader = (e: int, arg_start: int) -> Val:
    arg0 = int(lists[arg_start])
    arg1 = int(lists[arg_start + 1])
    vsf = int(nodes[arg0].sym)
    fsf = int(nodes[arg1].sym)
    vs, fs, lay = glsl_build(vsf, fsf)
    if watch_build: glsl_of[e] = vs + fs + lay
    t = ntype(e)
    si = int(types[prune(t)].st)
    layout(t)
    s = new_temp(t)
    d = e_slot(s)
    e_zero(d, tsize(t))
    srcs = [vs, fs, lay]
    loop i in [0..3): e_store(d, int(fields[int(structs[si].fields) + i].offset), e_daddr(str_data(srcs[i])), ptr_size)
    # for the software renderer: the shader functions themselves (callable through C function
    # pointers: the result pointer comes first, then the arguments' addresses) and the size of
    # the vertex function's output (the values interpolated across triangles)
    if int(structs[si].nfields) >= 7:
        fo = int(structs[si].fields)
        e_store(d, int(fields[fo + 3].offset), e_faddr(lf_of_inst(vsf)), ptr_size)
        e_store(d, int(fields[fo + 4].offset), e_faddr(lf_of_inst(fsf)), ptr_size)
        e_store(d, int(fields[fo + 5].offset), e_iconst(tsize(int(fns[vsf].ret))), 8)
        e_store(d, int(fields[fo + 6].offset), e_iconst(fns[vsf].ptypes.len()), 8)
        if int(structs[si].nfields) >= 8:
            # per 4-byte slot of the output: 'i' if it holds integer (or f64) data, which is
            # passed on unchanged ("flat") instead of interpolated
            rt = int(fns[vsf].ret)
            mask = fill(u8('f'), max(tsize(rt) / 4, 1))
            flat_slots(rt, 0, mask)
            e_store(d, int(fields[fo + 7].offset), e_daddr(str_data(str_from_bytes(mask))), ptr_size)
        if int(structs[si].nfields) >= 10:
            vk = ("", "")
            if target_macos: vk = msl_build(vsf, fsf)
            else if not target_wasm: vk = spirv_build(vsf, fsf)
            e_store(d, int(fields[fo + 8].offset), e_daddr(str_data(vk.0)), ptr_size)
            e_store(d, int(fields[fo + 9].offset), e_daddr(str_data(vk.1)), ptr_size)
    return Val(d, true, s)

flat_slots = (t0: int, base: int, mask: mut u8[]):
    t = prune(t0)
    k = types[t].kind
    if k == .quantity:
        flat_slots(int(types[t].elem), base, mask)
        return
    if k == .float_ and int(types[t].bits) == 32: return
    if k == .vec and not types[t].sign: return
    if k == .struct_:
        si = int(types[t].st)
        layout(t)
        loop i in [0..int(structs[si].nfields)):
            f = fields[int(structs[si].fields) + i]
            flat_slots(int(f.type), base + int(f.offset), mask)
        return
    loop b in [base / 4..(base + tsize(t) + 3) / 4):
        if b < mask.len(): mask[b] = 'i'

lit = (ba: int, s: str): e_call2(rt("__buf_append_str"), ba, e_daddr(str_data(s)), -1)
fmt_field = (ba: int, f: int, t: int, addr: int): e_call2(lf_of_inst(f), ba, load_val(t, addr, 0), -1)

# Typed JSON writing uses the field writers selected by the checker. It emits
# directly into the caller's buffer, without a text round trip or a Json tree.
json_key = (ba: int, name: str, indent: int, level: int, index: int):
    e_call(rt("__json_key"), [ba, e_daddr(str_data(name)), indent, level, e_iconst(index)], -1)

json_field = (ba: int, f: int, t: int, addr: int, indent: int, level: int):
    e_call4(lf_of_inst(f), ba, load_val(t, addr, 0), indent, level, -1)

# ---------------- conversions ----------------
# a string set's word w as the word of the same member in set type `to` (members are
# unordered: one set's word for a member is not another's); a member `to` lacks panics
set_word_moved = (w: int, from: int, to: int, pos: int) -> int:
    fs = str_set_of(from)
    ts = str_set_of(to)
    d = vreg(VI)
    e_mov(d, w)
    lacks = false
    loop k in 0.. and value in str_sets[fs]:
        j = str_sets[ts].index_of(value)
        if j < 0: lacks = true
        else if j != k:
            iff(e_bin(.eq, VI, w, e_iconst(k)))
            e_mov(d, e_iconst(j))
            endc()
    if lacks:
        loop k in 0.. and value in str_sets[fs]:
            if not str_sets[ts].contains(value):
                iff(e_bin(.eq, VI, w, e_iconst(k)))
                e_call_nr1(rt("__panic_narrow"), e_daddr(loc_data(pos)), -1)
                endc()
    d

# ---------------- expressions ----------------
# (after code that never comes back: a value of n's type when it is taken as one, "a" + panic(...))
never_after = (n: int) -> Val:
    t = prune(ntype(n))
    if t == T_NEVER or vc(t) == VC_VOID: return V(-1, false)
    never_value(t)

# any value of type t, where one is wanted after code that never comes back (it is never used)
never_value = (t: int) -> Val:
    if vc(t) == VC_AGG:
        s = new_temp(t)
        d = e_slot(s)
        e_zero(d, tsize(t))
        return Val(d, true, s)
    if vc(t) == VC_FLT: return V(e_fconst(0.0, vt_of(t)), false)
    V(e_iconst(0), false)

# Dispatch once by the checked AST kind. Case-local scratch is constructed
# only in the selected handler; recursive children still lower exactly once.
gen_value_int_lit = (e: int) -> Val:
    t = prune(ntype(e))
    if quantity_base(t) == T_MATH_INT:
        if has_flag(e, NF_U64) and nodes[e].ival < 0: return math_call("__mi_unsigned", [e_iconst(nodes[e].ival)])
        return math_word(e_iconst(nodes[e].ival))
    if vc(t) == VC_FLT: return V(e_fconst(f64(nodes[e].ival), vt_of(t)), false)
    return V(e_iconst(nodes[e].ival), false)

gen_value_float_lit = (e: int) -> Val:
    t = prune(ntype(e))
    return V(e_fconst(nodes[e].fval, vt_of(t)), false)

gen_value_none_lit = (e: int) -> Val:
    t = prune(ntype(e))
    if vc(t) != VC_AGG: return V(e_iconst(0), false)
    s = new_temp(t)
    d = e_slot(s)
    e_zero(d, tsize(t))
    return Val(d, true, s)

gen_value_dotname = (e: int) -> Val:
    t = prune(ntype(e))
    si = int(types[t].st)
    layout(t)
    if structs[si].simple_enum:
        value = variants[int(structs[si].variants) + int(nodes[e].aux)].value
        if member_lower_active >= 0 and member_templates[member_lower_active].positions.has(nodes[e].pos): return V(member_lower_word(e, value), false)
        return V(e_iconst(value), false)
    s = new_temp(t)
    d = e_slot(s)
    e_zero(d, tsize(t))
    e_store(d, 0, e_iconst(int(nodes[e].aux)), 4)
    return Val(d, true, s)

# a struct constructor whose arguments cannot run code (so it may be built in place)
is_plain_ctor = (e: int) -> bool:
    if refine_active and ref_storage_contract(ntype(e)): return false
    if nodes[e].kind != .call or nodes[e].aux != 2: return false
    t = prune(ntype(e))
    if types[t].kind != .struct_: return false
    loop i in [0..nkids(e)):
        a = kid(e, i)
        if a != 0 and not is_plain_expr(a): return false
        # (a value that could hold the array being pushed to is read before it grows: xs.push(S(xs)))
        if a != 0 and is_managed(ntype(a)) and types[prune(ntype(a))].kind != .str_: return false
    true

is_plain_expr = (e: int) -> bool:
    k = nodes[e].kind
    if k == .int_lit or k == .float_lit or k == .bool_lit or k == .str_lit or k == .null_lit or k == .dotname: return nodes[e].nlist == 0
    if k == .ident: return nodes[e].aux == i32(int(SK.local)) or nodes[e].aux == i32(int(SK.global)) or nodes[e].aux == i32(int(SK.const_))
    if k == .conv or k == .unary or k == .not_: return is_plain_expr(int(nodes[e].a))
    # arithmetic and reads cannot touch the array being pushed to (only calls could)
    if k == .binary or k == .and_ or k == .or_: return nodes[e].aux == 0 and is_plain_expr(int(nodes[e].a)) and is_plain_expr(int(nodes[e].b))
    if k == .field: return nodes[e].aux >= 0 and is_plain_expr(int(nodes[e].a)) and types[prune(ntype(int(nodes[e].a)))].kind == .struct_
    false

# [a, b, c], [] (zeros) or [v] * N as a fixed-size array: built in place
# Completed element temporaries remain the cleanup authorities until the
# whole fixed array is constructed. Zero-filled storage is never a live owner.
all_const = (e: int, et: int) -> bool:
    k = types[quantity_base(et)].kind
    if k != .int_ and k != .float_ and k != .bool_: return false
    loop i in [0..nkids(e)):
        item = kid(e, i)
        if quantity_base(et) == T_MATH_INT and (has_flag(item, NF_U64) or nodes[item].ival < -4611686018427387904 or nodes[item].ival > 4611686018427387903): return false
        ck = nodes[item].kind
        if ck != .int_lit and ck != .float_lit and ck != .bool_lit: return false
    true

const_array = (e: int, et: int) -> int:
    loop rodata.len() % 8 != 0: rodata.push(0)
    o = rodata.len()
    ro_starts.push(o)
    n = nkids(e)
    sz = tsize(et)
    push_i64(rodata, -1)
    push_i64(rodata, n)
    push_i64(rodata, n)
    loop i in [0..n):
        c = kid(e, i)
        bits = 0
        if nodes[c].kind == .float_lit:
            if sz == 4: bits = int(f32_bits(f32(nodes[c].fval)))
            else: bits = int(f64_bits(nodes[c].fval))
        else:
            bits = nodes[c].ival
            if quantity_base(et) == T_MATH_INT: bits = bits << 1
        loop b in [0..sz): rodata.push(if b >= 8: u8(0) else: u8((bits >> (8 * b)) & 255))
    if fused_on: fz_note_raw(o, 8)
    o

# ---------------- conditions as branches ----------------
# A constant interval test on the same ordinary integer read needs one
# unsigned comparison: low <= x <= high is (u64(x) - u64(low)) <= u64(high-low).
# The subtraction wraps, so negative values and intervals crossing zero work.
# Two ordinary reads with no intervening user code. Keep this deliberately
# shallow: array loads use a local receiver and a local/literal index, and no
# raw pointers, deferred aliases or mutable parameters are admitted.
same_range_local = (a: int, b: int) -> bool:
    if nodes[a].kind != .ident or nodes[b].kind != .ident: return false
    if nodes[a].aux != i32(int(SK.local)) or not same_var(a, b): return false
    int(locals[int(nodes[a].sym)].flags) & (LF_ALIAS | LF_MUTPARAM) == 0

same_range_read = (a: int, b: int) -> bool:
    if same_range_local(a, b): return true
    if nodes[a].kind != .index or nodes[b].kind != .index or nodes[a].aux != 0 or nodes[b].aux != 0: return false
    x = int(nodes[a].a)
    y = int(nodes[b].a)
    if not same_range_local(x, y): return false
    kind = tkind(ntype(x))
    if kind != .array and kind != .fixed: return false
    i = int(nodes[a].b)
    j = int(nodes[b].b)
    if i == 0 or j == 0: return false
    if same_range_local(i, j): return true
    nodes[i].kind == .int_lit and nodes[j].kind == .int_lit and nodes[i].ival == nodes[j].ival

range_cmp = (e: int) -> (int, Tok, int):
    if nodes[e].kind != .binary or nodes[e].aux != 0: return (0, .eq, 0)
    op = nodes[e].op as Tok
    if op != .lt and op != .le and op != .gt and op != .ge: return (0, .eq, 0)
    a = word_integer_value(int(nodes[e].a))
    b = word_integer_value(int(nodes[e].b))
    if nodes[a].kind == .int_lit:
        tmp = a
        a = b
        b = tmp
        op = if op == .lt: .gt else if op == .le: .ge else if op == .gt: .lt else: .le
    if nodes[b].kind != .int_lit or has_flag(b, NF_U64) and nodes[b].ival < 0: return (0, .eq, 0)
    at = prune(ntype(a))
    bt = prune(ntype(b))
    if not is_int(at) or not is_int(bt) or at == T_U64 or bt == T_U64: return (0, .eq, 0)
    if not same_range_read(a, a): return (0, .eq, 0)
    (a, op, nodes[b].ival)

# Recognize the adjacent comparisons at the end of a guarded chain without
# evaluating their array read before the guard: (guard and low) and high becomes
# guard and (low and high). The same grouping preserves ordered `or` evaluation.
range_tail = (e: int) -> int:
    k = nodes[e].kind
    if k != .and_ and k != .or_: return e
    left = int(nodes[e].a)
    right = int(nodes[e].b)
    if nodes[left].kind != k or nodes[right].kind != .binary: return e
    a = range_cmp(int(nodes[left].b))
    if a.0 == 0: return e
    b = range_cmp(right)
    if b.0 == 0 or not same_range_read(a.0, b.0): return e
    pair = nodes.len()
    nodes.push(nodes[e])
    nodes[pair].a = nodes[left].b
    head = nodes.len()
    nodes.push(nodes[e])
    nodes[head].a = nodes[left].a
    nodes[head].b = i32(pair)
    head

# `and` / `or` / `not` in if/while conditions become jumps instead of boolean values.
# Each leaf is its own small statement, so its temporaries are dropped before branching.
negate_cmp = (op: Op) -> Op:
    match op:
        eq: .ne
        ne: .eq
        lts: .ges
        les: .gts
        gts: .les
        ges: .lts
        ltu: .geu
        leu: .gtu
        gtu: .leu
        geu: .ltu
        _: .nop

# A fresh integer comparison can produce its complement directly. Keep the
# boolean inversion for other values, including unordered float comparisons.
# continue when e is true, branch to `level` when it is false
# continue when e is false, branch to `level` when it is true
# ---------------- statements ----------------
# Dewy gives each value parameter a same-named mutable local. When that local
# stays read-only, it can use the borrowed parameter storage instead of copying
# and retaining it again. Calls already preserve borrowed parameter snapshots.
# The checker records writes and raw exposures when checking those operations;
# captures, address-taking and buffer access retain their owned local storage.
param_view_decl = (s: int, l: int) -> bool:
    if (dbg_on and (not copies_on or not copy_strict(s))) or nodes[s].aux2 != 1: return false
    if copies_on and copy_bindings.has(l): return false
    fl = int(locals[l].flags)
    if fl & (LF_ASSIGNED | LF_ADDR | LF_CAPTURE | LF_CAPTURED | LF_BYREF | LF_ALIAS | LF_PARAM) != 0 or is_shared(l): return false
    # (exposed only by pointers read through, it can read the parameter's storage)
    if fl & LF_EXPOSED != 0:
        ptr_reads(cur_fn)
        if pr_exposed.has(l): return false
    # Most local initializers are not the parameter binding introduced by the
    # frontend. Reject their shape before asking about layouts or closure types.
    iv = int(nodes[s].b)
    if iv == 0 or nodes[iv].kind != .ident or nodes[iv].aux != i32(int(SK.local)): return false
    source = int(nodes[iv].sym)
    flags = int(locals[source].flags)
    if flags & LF_PARAM == 0 or flags & (LF_MUTPARAM | LF_ADDR | LF_CAPTURE | LF_CAPTURED) != 0: return false
    if locals[source].owner != i32(cur_fn) or locals[source].name != locals[l].name: return false
    t = prune(int(locals[l].type))
    if not is_managed(t) and vc(t) != VC_AGG: return false
    if (type_has_fn(t) and callback_local(l) < 0) or not type_eq(ntype(iv), t): return false
    # Treat this binding as another read-only view of the parameter. It owns
    # no reference and must not be dropped as a separately initialized local.
    locals[l].vreg = locals[source].vreg
    locals[l].offset = locals[source].offset
    locals[l].flags = i32(fl | LF_PARAM)
    true

# ---------------- views ----------------
# `b = agents[j]` copies a struct out of an array (and retains what it holds), but when b is
# only read, and nothing can change agents while b is used, b can be the element itself: a
# pointer into the array, with no copy and no reference counting (release builds).
cur_block = 0                  # the block whose statement is being lowered, and its index
cur_block_i = 0

# Only direct reads: custom getters, calls and computed indexes outside this
# whitelist stay on the ordinary snapshot path. Alias identifiers
# can expand into expressions, so do not assume that reading them is inert.
plain_read = (n: int) -> bool:
    if n <= 0: return false
    k = nodes[n].kind
    if k == .int_lit or k == .str_lit: return true
    if k == .ident:
        if nodes[n].aux == i32(int(SK.global)): return true
        if nodes[n].aux == i32(int(SK.local)): return int(locals[int(nodes[n].sym)].flags) & LF_ALIAS == 0
        return false
    # An implicit integer index narrowing reads its value without user code.
    if k == .conv and nodes[n].aux == i32(int(CV.int_)) and prune(ntype(n)) == T_INT and is_int(ntype(int(nodes[n].a))):
        return plain_read(int(nodes[n].a))
    if k == .field:
        a = int(nodes[n].a)
        return nodes[n].aux >= 0 and tkind(ntype(a)) == .struct_ and plain_read(a)
    if k == .index:
        a = int(nodes[n].a)
        kind = tkind(ntype(a))
        return (kind == .array or kind == .fixed) and plain_read(a) and plain_read(int(nodes[n].b))
    false

# A walk down a tree, `cur = n` and then `loop let c = cur: cur = c.left`, or a match on a
# parameter, `match e: .bin(op, l, r): ...`, would copy each node it passes into a variable (and
# retain what the node holds, to release it after). What a parameter holds stays as it is for the
# whole call: the function cannot change it, and a caller gives a copy of what the call could
# change (borrow_may_change). So a variable only ever given parts of a parameter (through fields,
# boxed ones too, `!` and narrowing), or parts of other such variables, and never changed through,
# can be the address of the part: no copy and no reference counting (release builds, and
# recursive records in default builds). These
# held views are plain variables (given another part by assignment), the names of `if let` and
# `loop let`, and the value a match or a variant `if let` / `loop let` looks at, whose names stand
# for its fields.
const LF_HELDVIEW = 2097152    # lowering-only; reset before a repeated lowering
const LF_ELEMENTVIEW = 4194304 # array element address, protected through its last use
held_views: {int: bool}         # the held views of the function being lowered
hv_given: (int, int)[]          # (finding them) each variable and a value it is given
hv_cand: {int: bool}            # ... the variables given values
hv_bad: {int: bool}             # ... those that cannot be views
hv_lambda = false               # ... a closure is made (none then: it may change what it captures)

# Optional held views use null for none, otherwise an address biased by BOX_HDR.
# A recursive optional field already stores exactly that pointer, so advancing
# a read-only cursor becomes one pointer load. Its presence check needs no tag
# load or default-address selection. Only general value reads materialize the
# ordinary optional address; this representation never escapes the function.
held_opt_reg = (e: int) -> int:
    if held_views.len() == 0 or nodes[e].kind != .ident or nodes[e].aux != i32(int(SK.local)): return -1
    l = int(nodes[e].sym)
    if int(locals[l].flags) & LF_HELDVIEW == 0 or tkind(int(locals[l].type)) != .opt: return -1
    int(locals[l].vreg)

held_encode_addr = (addr: int, t: int) -> int:
    if tkind(t) != .opt: return addr
    value = e_addi(addr, 0 - BOX_HDR)
    has = opt_has(addr, telem(t))
    result = vreg(VI)
    emit(.select, VI, result, has, value, e_iconst(0), 0)
    result

find_views = (f: int):
    held_views = {}
    loop l in fns[f].locals:
        if int(locals[l].flags) & (LF_HELDVIEW | LF_ELEMENTVIEW) != 0: locals[l].flags &= i32(~(LF_HELDVIEW | LF_ELEMENTVIEW | LF_BYREF))
    hv_bad = {}
    # (what C gives a function it calls is C's, which may change it meanwhile)
    if dbg_on or fns[f].body == 0 or fns[f].cabi or (copies_on and copy_strict(int(fns[f].body))): return
    rooted = false
    loop l in fns[f].params:
        # Recursive walks need this even in the fast development mode. Other
        # managed aggregates retain release-only analysis; their layout flag
        # lets default builds skip scanning unrelated function bodies.
        if opt_release or int(types[prune(int(locals[l].type))].flags) & TF_BOXED != 0:
            if hv_root(l): rooted = true
    if not rooted: return
    hv_given = []
    hv_cand = {}
    hv_bad = {}
    hv_lambda = false
    hv_scan(int(fns[f].body))
    if hv_lambda or hv_given.len() == 0: return
    # (assumed views until a value given cannot be one: what is left gives each other only parts)
    changed = true
    loop changed:
        changed = false
        loop g in hv_given:
            if not hv_bad.contains(g.0) and not hv_part(g.1):
                hv_bad[g.0] = true
                changed = true
    loop l in hv_cand.keys():
        if hv_bad.contains(l): continue
        held_views[l] = true
        locals[l].flags = i32(int(locals[l].flags) | LF_BYREF | LF_HELDVIEW)

# a parameter whose parts can be views: a value in memory the function cannot change
hv_root = (l: int) -> bool:
    if copy_inputs.has(l): return false
    fl = int(locals[l].flags)
    fl & (LF_MUTPARAM | LF_CAPTURE | LF_CAPTURED | LF_ASSIGNED | LF_ADDR | LF_EXPOSED | LF_SHARED) == 0 and vc(int(locals[l].type)) == VC_AGG and is_managed(int(locals[l].type)) and not type_has_fn(int(locals[l].type))

hv_give = (l: int, v: int):
    if ownership_type(int(locals[l].type)):
        hv_bad[l] = true
        return
    fl = int(locals[l].flags)
    # (a match's own variable is LF_ADDR: the match reads it in memory)
    ok = v != 0 and fl & (LF_CAPTURE | LF_CAPTURED | LF_BYREF | LF_ALIAS | LF_PARAM | LF_EXPOSED) == 0 and (fl & LF_ADDR == 0 or locals[l].name == 0)
    if not ok or is_shared(l) or not is_managed(int(locals[l].type)) or type_has_fn(int(locals[l].type)):
        hv_bad[l] = true
        return
    hv_given.push((l, v))
    hv_cand[l] = true

# place p is written: what it is in cannot be a view
hv_spoil = (p: int):
    r = place_var(p)
    if r != 0 and nodes[r].aux == i32(int(SK.local)): hv_bad[int(nodes[r].sym)] = true

hv_scan = (n: int):
    if n <= 0: return
    k = nodes[n].kind
    if k == .lambda:
        hv_lambda = true
        return
    if k == .vardecl:
        if nodes[n].nlist > 0:
            loop i in [0..nkids(n)): hv_spoil(kid(n, i))
        else if not has_flag(n, NF_GLOBAL):
            l = int(nodes[n].sym)
            # param_view_decl already proved this synthetic Dewy binding is
            # the borrowed parameter itself. It is a root, not a candidate
            # local whose LF_PARAM flag would disqualify every walk from it.
            if nodes[n].aux2 != 1 or int(locals[l].flags) & LF_PARAM == 0: hv_give(l, int(nodes[n].b))
    else if k == .iflet or k == .match_ or (k == .while_ and nodes[n].aux == 1): hv_give(int(nodes[n].sym), int(nodes[n].a))
    else if k == .assign:
        a = int(nodes[n].a)
        if nodes[n].aux == 1:
            loop i in [0..nkids(a)): hv_spoil(kid(a, i))
        else if nodes[n].aux == 0 and nodes[n].op == i32(int(Tok.assign)) and nodes[a].kind == .ident and nodes[a].aux == i32(int(SK.local)) and int(locals[int(nodes[a].sym)].flags) & LF_ALIAS == 0: hv_give(int(nodes[a].sym), int(nodes[n].b))
        else: hv_spoil(a)
    else if k == .intrinsic and nkids(n) > 0:
        id = nodes[n].aux as IN
        if id == .push or id == .pop or id == .insert or id == .remove or id == .clear or id == .reserve or id == .resize or id == .truncate or id == .setlen or id == .extend or id == .arrdata: hv_spoil(kid(n, 0))
    else if k == .addr or (k == .cast or k == .conv) and raw_view(n): hv_spoil(int(nodes[n].a))
    else if k == .for_ and has_flag(n, NF_MUT): hv_spoil(int(nodes[n].a))
    fs = [int(nodes[n].a), int(nodes[n].b)]
    if k != .for_: fs = [int(nodes[n].a), int(nodes[n].b), int(nodes[n].c), if k == .partial: 0 else: int(nodes[n].d)]
    loop c in fs: hv_scan(c)
    loop i in [0..nkids(n)):
        c = kid(n, i)
        if has_flag(c, NF_MUT): hv_spoil(c)
        hv_scan(c)
    loop i in [0..nkids2(n)): hv_scan(kid2(n, i))

# is p a part of a parameter or of a view (as views are assumed so far)?
hv_part = (p: int) -> bool:
    k = nodes[p].kind
    if k == .ident:
        if nodes[p].aux != i32(int(SK.local)): return false
        l = int(nodes[p].sym)
        fl = int(locals[l].flags)
        if fl & LF_ALIAS != 0: return locals[l].alias != 0 and hv_part(int(locals[l].alias))
        if fl & LF_PARAM != 0: return not hv_bad.contains(l) and hv_root(l)
        return hv_cand.contains(l) and not hv_bad.contains(l)
    if k == .field:
        a = int(nodes[p].a)
        tk = tkind(ntype(a))
        return (nodes[p].aux == -3 or nodes[p].aux >= 0 and (tk == .struct_ or tk == .tuple)) and hv_part(a)
    if k == .unwrap or k == .narrow: return hv_part(int(nodes[p].a))
    false

# is e a variable (or a field path of one) that code n cannot change?
unchanged_by = (e: int, n: int) -> bool:
    if lpath_key(e) == 0: return false
    rn = lpath_root(e)
    if nodes[rn].aux != i32(int(SK.global)):
        r = int(nodes[rn].sym)
        if int(locals[r].flags) & (LF_ALIAS | LF_CAPTURE | LF_BYREF) != 0 or is_shared(r): return false
    not may_write_root(n, rn)

mentions_local = (n: int, l: int) -> bool:
    if n <= 0: return false
    k = nodes[n].kind
    if k == .ident: return nodes[n].aux == i32(int(SK.local)) and int(nodes[n].sym) == l
    child_a = int(nodes[n].a)
    child_b = int(nodes[n].b)
    # (kid_c and kid_d, with the kind in hand)
    child_c = if nodes[n].kind == .for_: 0 else: int(nodes[n].c)
    child_d = if nodes[n].kind == .for_ or nodes[n].kind == .partial: 0 else: int(nodes[n].d)
    if mentions_local(child_a, l): return true
    if mentions_local(child_b, l): return true
    if mentions_local(child_c, l): return true
    if mentions_local(child_d, l): return true
    loop i in [0..nkids(n)):
        if mentions_local(kid(n, i), l): return true
    loop i in [0..nkids2(n)):
        if mentions_local(kid2(n, i), l): return true
    false

# the variable a path of writes starts at (through fields and indexes); 0 if none
write_root = (n0: int) -> int:
    n = n0
    loop nodes[n].kind == .field or nodes[n].kind == .index or nodes[n].kind == .unwrap: n = int(nodes[n].a)
    if nodes[n].kind == .ident: return n
    0

same_var = (a: int, b: int) -> bool: nodes[a].aux == nodes[b].aux and nodes[a].sym == nodes[b].sym

# could code n change the variable at ident node rn (a global, or a local)?
# a conversion of an array or string to a raw pointer (through which it may be written)
raw_view = (n: int) -> bool:
    a = int(nodes[n].a)
    if a == 0 or nodes[n].type == 0 or nodes[a].type == 0: return false
    tk = tkind(ntype(n))
    fk = tkind(ntype(a))
    (tk == .ptr or tk == .int_) and (fk == .array or fk == .str_)

write_overlaps = (target: int, root: int, place: int) -> bool:
    w = place_var(target)
    w != 0 and same_var(w, root) and (place == 0 or steps_overlap(place_steps(target), place_steps(place)))

may_write_root = (n: int, rn: int, place: int = 0) -> bool:
    if n <= 0: return false
    k = nodes[n].kind
    if k == .lambda: return false
    glob = nodes[rn].aux == i32(int(SK.global))
    mutparam = not glob and int(locals[int(nodes[rn].sym)].flags) & LF_MUTPARAM != 0
    if not mwr_direct and (glob or mutparam):
        loop f in value_helper_calls(n):
            w = fn_writes(f)
            if w.all or (glob and w.globals.contains(int(nodes[rn].sym))) or (mutparam and w.globals.len() > 0): return true
    if k == .assign:
        if write_overlaps(int(nodes[n].a), rn, place): return true
    if k == .intrinsic and nkids(n) > 0:
        id = nodes[n].aux as IN
        if (id == .fmt_struct or id == .json_fields) and (glob or mutparam): return true
        if id == .push or id == .pop or id == .insert or id == .remove or id == .clear or id == .reserve or id == .resize or id == .truncate or id == .extend or id == .arrdata:
            if write_overlaps(kid(n, 0), rn, place): return true
    if k == .addr or (k == .cast or k == .conv) and raw_view(n):
        if write_overlaps(int(nodes[n].a), rn, place): return true
    if k == .for_ and has_flag(n, NF_MUT):
        if write_overlaps(int(nodes[n].a), rn, place): return true
    if k == .call or (k == .pair and nodes[n].sym > 0):
        mm = checked_call_mutmask(n)
        loop i in [0..nkids(n)):
            if mm & (1 << i) != 0:
                if write_overlaps(kid(n, i), rn, place): return true
        aux = if k == .pair: 0 else: int(nodes[n].aux)
        if mwr_direct: pass
        else if aux == 1 or aux == 4:
            if glob or mutparam: return true
        else if aux == 0 and (glob or mutparam):
            # (what the function and everything it calls may write; a mut parameter may be the
            # caller's global)
            w = fn_writes(int(nodes[n].sym))
            if w.all or (glob and w.globals.contains(int(nodes[rn].sym))) or (mutparam and w.globals.len() > 0): return true
    child_a = int(nodes[n].a)
    child_b = int(nodes[n].b)
    # (kid_c and kid_d, with the kind in hand)
    child_c = if nodes[n].kind == .for_: 0 else: int(nodes[n].c)
    child_d = if nodes[n].kind == .for_ or nodes[n].kind == .partial: 0 else: int(nodes[n].d)
    if may_write_root(child_a, rn, place): return true
    if may_write_root(child_b, rn, place): return true
    if may_write_root(child_c, rn, place): return true
    if may_write_root(child_d, rn, place): return true
    loop i in [0..nkids(n)):
        if may_write_root(kid(n, i), rn, place): return true
    loop i in [0..nkids2(n)):
        if may_write_root(kid2(n, i), rn, place): return true
    false

# do the calls in n leave the variable at ident node rn (a global or a mut parameter) alone:
# not change it, nor (written: the code writes its elements in place) copy it?
calls_leave = (n: int, rn: int, written: bool) -> bool:
    if n <= 0: return true
    k = nodes[n].kind
    if k == .lambda: return true
    loop f in value_helper_calls(n):
        w = fn_writes(f)
        if w.all: return false
        if nodes[rn].aux == i32(int(SK.global)):
            g = int(nodes[rn].sym)
            if w.globals.contains(g) or (written and w.mentions.contains(g)): return false
        else if w.globals.len() > 0 or (written and w.mentions.len() > 0): return false
    if k == .intrinsic and (nodes[n].aux == i32(int(IN.fmt_struct)) or nodes[n].aux == i32(int(IN.json_fields))): return false
    if k == .call or (k == .pair and nodes[n].sym > 0):
        aux = if k == .pair: 0 else: int(nodes[n].aux)
        if aux == 1 or aux == 4: return false
        if aux == 0:
            w = fn_writes(int(nodes[n].sym))
            if w.all: return false
            if nodes[rn].aux == i32(int(SK.global)):
                g = int(nodes[rn].sym)
                if w.globals.contains(g) or (written and w.mentions.contains(g)): return false
            else:
                # (a mut parameter may be any of the caller's globals)
                if w.globals.len() > 0 or (written and w.mentions.len() > 0): return false
    child_a = int(nodes[n].a)
    child_b = int(nodes[n].b)
    # (kid_c and kid_d, with the kind in hand)
    child_c = if nodes[n].kind == .for_: 0 else: int(nodes[n].c)
    child_d = if nodes[n].kind == .for_ or nodes[n].kind == .partial: 0 else: int(nodes[n].d)
    if not calls_leave(child_a, rn, written): return false
    if not calls_leave(child_b, rn, written): return false
    if not calls_leave(child_c, rn, written): return false
    if not calls_leave(child_d, rn, written): return false
    loop i in [0..nkids(n)):
        if not calls_leave(kid(n, i), rn, written): return false
    loop i in [0..nkids2(n)):
        if not calls_leave(kid2(n, i), rn, written): return false
    true

# ---- the globals a function may write ----
# Itself or through the functions it calls; `all` when it calls a function value (anything).
struct FnWrites:
    all: bool
    globals: int[]
    calls: int[]
    mentions: int[]             # the globals it names at all
fw_direct: {int: FnWrites}      # by function: what its own body does
fw_total: {int: FnWrites}       # ... and with everything it calls

# the globals f and the functions it calls by name write, also past calls of function values
# (fn_writes stops at the first of those: `all`)
fw_named: {int: FnWrites}
fn_writes_named = (f: int) -> FnWrites:
    if let w = fw_named.get(f): return w
    total = FnWrites(false, [], [], [])
    seen: {int: bool}
    todo = [f]
    loop todo.len() > 0:
        g = todo.pop()
        if seen.get(g, false): continue
        seen[g] = true
        d = fn_writes_direct(g)
        loop x in d.globals:
            if not total.globals.contains(x): total.globals.push(x)
        loop c in d.calls: todo.push(c)
    fw_named[f] = total
    total

fn_writes = (f: int) -> FnWrites:
    if let w = fw_total.get(f): return w
    total = FnWrites(false, [], [], [])
    seen: {int: bool}
    todo = [f]
    loop todo.len() > 0:
        g = todo.pop()
        if seen.get(g, false): continue
        seen[g] = true
        d = fn_writes_direct(g)
        if d.all: total.all = true
        loop x in d.globals:
            if not total.globals.contains(x): total.globals.push(x)
        loop x in d.mentions:
            if not total.mentions.contains(x): total.mentions.push(x)
        loop c in d.calls: todo.push(c)
        if total.all: break
    fw_total[f] = total
    total

fn_writes_direct = (f: int) -> FnWrites:
    if let w = fw_direct.get(f): return w
    w = FnWrites(false, [], [], [])
    if f > 0 and f < fns.len() and fns[f].body != 0: fw_scan(int(fns[f].body), w)
    # A foreign function may call back into the program; its body is opaque. The core runtime's
    # own host imports and system functions (lib/core: write, clock, files) never do.
    if f > 0 and f < fns.len() and fns[f].decl != 0 and has_flag(int(fns[f].decl), NF_EXTERN) and not starts_with(files[pos_file(nodes[int(fns[f].decl)].pos)].path, lib_dir + "/core/"): w.all = true
    fw_direct[f] = w
    w

fw_global = (n: int, w: mut FnWrites):
    r = write_root(n)
    if r != 0 and nodes[r].aux == i32(int(SK.global)) and not w.globals.contains(int(nodes[r].sym)): w.globals.push(int(nodes[r].sym))

fw_scan = (n: int, w: mut FnWrites):
    if n <= 0: return
    k = nodes[n].kind
    if k == .lambda: return
    loop f in value_helper_calls(n):
        if not w.calls.contains(f): w.calls.push(f)
    if k == .ident and nodes[n].aux == i32(int(SK.global)) and not w.mentions.contains(int(nodes[n].sym)): w.mentions.push(int(nodes[n].sym))
    if k == .assign: fw_global(int(nodes[n].a), w)
    if k == .intrinsic and nkids(n) > 0:
        id = nodes[n].aux as IN
        # Field formatting invokes type-specific formatters selected by the
        # checker. Treat it conservatively, including nested user formatters.
        if id == .fmt_struct or id == .json_fields: w.all = true
        if id == .push or id == .pop or id == .insert or id == .remove or id == .clear or id == .reserve or id == .resize or id == .truncate or id == .extend: fw_global(kid(n, 0), w)
    if k == .for_ and has_flag(n, NF_MUT): fw_global(int(nodes[n].a), w)
    if k == .call or (k == .pair and nodes[n].sym > 0):
        mm = checked_call_mutmask(n)
        loop i in [0..nkids(n)):
            if mm & (1 << i) != 0: fw_global(kid(n, i), w)
        aux = if k == .pair: 0 else: int(nodes[n].aux)
        if aux == 1 or aux == 4: w.all = true
        else if aux == 0 and not w.calls.contains(int(nodes[n].sym)): w.calls.push(int(nodes[n].sym))
    fw_scan(int(nodes[n].a), w)
    fw_scan(int(nodes[n].b), w)
    fw_scan(kid_c(n), w)
    fw_scan(kid_d(n), w)
    loop i in [0..nkids(n)): fw_scan(kid(n, i), w)
    loop i in [0..nkids2(n)): fw_scan(kid2(n, i), w)

# ---- the global arrays a function may resize ----
# (for `loop mut` over a global's array: a function called in its body that adds to it, removes
# from it or replaces it, itself or through the functions it calls by name)
fr_direct: {int: int[]}
fr_total: {int: int[]}
fn_resizes = (f: int) -> int[]:
    if let r = fr_total.get(f): return r
    total: int[]
    seen: {int: bool}
    todo = [f]
    loop todo.len() > 0:
        g = todo.pop()
        if seen.get(g, false): continue
        seen[g] = true
        loop x in fn_resizes_direct(g):
            if not total.contains(x): total.push(x)
        loop c in fn_writes_direct(g).calls: todo.push(c)
    fr_total[f] = total
    total

fn_resizes_direct = (f: int) -> int[]:
    if let r = fr_direct.get(f): return r
    out: int[]
    if f > 0 and f < fns.len() and fns[f].body != 0: fr_scan(int(fns[f].body), out)
    fr_direct[f] = out
    out

# (a global whose array this may resize: push and the like on it, a whole array or a field path
# of it assigned, or it given to a function as mut)
fr_root = (n: int, out: mut int[]):
    r = write_root(n)
    if r != 0 and nodes[r].aux == i32(int(SK.global)) and not out.contains(int(nodes[r].sym)): out.push(int(nodes[r].sym))

fr_scan = (n: int, out: mut int[]):
    if n <= 0: return
    k = nodes[n].kind
    if k == .lambda: return
    if k == .assign:
        # (a whole value replaced, not an element's field: g.enemies = [], g = Game())
        t = int(nodes[n].a)
        whole = true
        u = t
        loop nodes[u].kind == .field:
            u = int(nodes[u].a)
        if nodes[u].kind != .ident: whole = false
        if whole: fr_root(t, out)
    if k == .intrinsic and nkids(n) > 0:
        id = nodes[n].aux as IN
        if id == .push or id == .pop or id == .insert or id == .remove or id == .clear or id == .resize or id == .truncate or id == .extend: fr_root(kid(n, 0), out)
    if k == .call:
        mm = checked_call_mutmask(n)
        loop i in [0..nkids(n)):
            if mm & (1 << i) != 0: fr_root(kid(n, i), out)
    fr_scan(int(nodes[n].a), out)
    fr_scan(int(nodes[n].b), out)
    fr_scan(kid_c(n), out)
    fr_scan(kid_d(n), out)
    loop i in [0..nkids(n)): fr_scan(kid(n, i), out)
    loop i in [0..nkids2(n)): fr_scan(kid2(n, i), out)

# the first call in n (not in a function written in it) of a function that may resize global g
lm_resizing_call = (n: int, g: int) -> int:
    if n <= 0: return 0
    loop called in value_helper_calls(n):
        if fn_resizes(called).contains(g): return n
    k = nodes[n].kind
    if k == .lambda: return 0
    if k == .call and int(nodes[n].aux) == 0 and nodes[n].sym > 0 and fn_resizes(int(nodes[n].sym)).contains(g): return n
    r = lm_resizing_call(int(nodes[n].a), g)
    if r == 0: r = lm_resizing_call(int(nodes[n].b), g)
    if r == 0: r = lm_resizing_call(kid_c(n), g)
    if r == 0: r = lm_resizing_call(kid_d(n), g)
    loop i in [0..nkids(n)):
        if r == 0: r = lm_resizing_call(kid(n, i), g)
    loop i in [0..nkids2(n)):
        if r == 0: r = lm_resizing_call(kid2(n, i), g)
    r

# ---- bounds checks that cannot fail ----
# In `for j in K..A.len()` (K a non-negative literal; the bound may also be a variable declared
# as `n := A.len()` and never changed) where A is never modified in the function, A[j] is in
# Stepped ranges compare the original endpoint, without end+1 arithmetic.
# Open ranges retain the exact two-word step. Each next value has a storage
# obligation; bounded ranges use a proven iteration count instead.
stepped_done = (up: int, ctr: int, endv: int, inclusive: bool, signed: bool) -> int:
    above = if signed: Op.ges else: Op.geu
    below = if signed: Op.les else: Op.leu
    if inclusive:
        above = if signed: Op.gts else: Op.gtu
        below = if signed: Op.lts else: Op.ltu
    e_bin(.or_, VI,
        e_bin(.and_, VI, up, e_bin(above, VI, ctr, endv)),
        e_bin(.and_, VI, e_bin(.xor, VI, up, e_iconst(1)), e_bin(below, VI, ctr, endv)))

# Element replacement can detach storage but cannot change its length. Reuse
# the loop's storage inventory for this narrower question; an opaque use,
# replacement, resize or an ambient call that can reach the root refuses it.
bounded_array_length = (array: int, loop_: int) -> bool:
    if not plain_read(array): return false
    key = lpath_key(array)
    if key == 0: return false
    summary = fact_storage_loop(loop_)
    if summary.opaque: return false
    loop killed in summary.kill:
        if path_within(key, killed): return false
    root = lpath_root(array)
    if nodes[root].aux == i32(int(SK.global)): return not summary.calls
    l = int(nodes[root].sym)
    flags = int(locals[l].flags)
    if flags & (LF_ALIAS | LF_CAPTURE | LF_BYREF) != 0 or is_shared(l): return false
    flags & LF_MUTPARAM == 0 or not summary.calls

# A leading `if not (i < stop): break` on an open unit range is a bounded
# range when stop cannot change. Combined Dewy loop headers produce exactly
# this guard. Reuse bounded lowering (including its index facts) without an
# extra exhaustion counter, and leave dynamic/effectful headers alone.
bounded_open_for = (s: int) -> int:
    if nodes[s].aux != 0: return 0
    it = int(nodes[s].a)
    if nodes[it].kind != .range or nodes[it].b != 0 or has_flag(it, NF_STEP): return 0
    l = int(nodes[s].sym)
    if not stable_loop_index(l) or (prune(int(locals[l].type)) != T_INT and prune(int(locals[l].type)) != T_MATH_INT): return 0
    body = int(nodes[s].b)
    if nkids(body) == 0: return 0
    guard = kid(body, 0)
    if nodes[guard].kind != .if_ or nodes[guard].c != 0: return 0
    condition = int(nodes[guard].a)
    if nodes[condition].kind != .not_: return 0
    condition = int(nodes[condition].a)
    if nodes[condition].kind != .binary or nodes[condition].aux != 0 or nodes[condition].op != i32(int(Tok.lt)): return 0
    index = word_integer_value(int(nodes[condition].a))
    if nodes[index].kind != .ident or nodes[index].aux != i32(int(SK.local)) or int(nodes[index].sym) != l: return 0
    stop = word_integer_value(int(nodes[condition].b))
    if prune(ntype(stop)) != T_INT and prune(ntype(stop)) != T_MATH_INT: return 0
    stable = nodes[stop].kind == .int_lit or fixed_array_len(stop) >= 0
    if nodes[stop].kind == .ident and nodes[stop].aux == i32(int(SK.local)):
        end_local = int(nodes[stop].sym)
        stable = stable_loop_index(end_local) and int(locals[end_local].flags) & LF_MUTPARAM == 0
    if not stable and nodes[stop].kind == .intrinsic and nodes[stop].aux == i32(int(IN.len)) and nkids(stop) == 1:
        array = kid(stop, 0)
        stable = bounded_array_length(array, s)
    if not stable: return 0
    exit = int(nodes[guard].b)
    if nodes[exit].kind == .block and nkids(exit) == 1: exit = kid(exit, 0)
    if nodes[exit].kind != .break_ or nodes[exit].ival != 0 or nodes[exit].name != 0: return 0
    # Make a lowering-only view; retain the checked source tree for tooling.
    range = mk(.range, nodes[it].pos)
    nodes[range] = nodes[it]
    nodes[range].b = i32(stop)
    clear_flag(range, NF_INCLUSIVE)
    statements: int[]
    loop i in [1..nkids(body)): statements.push(kid(body, i))
    block = mk(.block, nodes[body].pos)
    nodes[block] = nodes[body]
    set_list(block, statements)
    result = mk(.for_, nodes[s].pos)
    nodes[result] = nodes[s]
    nodes[result].a = i32(range)
    nodes[result].b = i32(block)
    result

# A comprehension into a fixed-size array of plain elements fills the array's
# own storage: its accumulator stays empty, and a count it does not reach (or
# would pass) is the length mismatch the copy would report.
fixed_fill_push = 0
fixed_fill_slot = 0
fixed_fill_count = 0
fixed_fill_type = 0
fixed_fill_exact = false

# Straight-line Dewy comprehensions own an unnameable accumulator and append
# one result per iteration. Reserve once from a range bound or array snapshot.
comprehension_value = (n: int) -> bool:
    if n == 0: return true
    k = nodes[n].kind
    if k == .block or k == .lambda or k == .if_ or k == .iflet or k == .match_ or k == .for_ or k == .while_ or k == .return_ or k == .break_ or k == .continue_: return false
    if not comprehension_value(int(nodes[n].a)) or not comprehension_value(int(nodes[n].b)) or not comprehension_value(int(nodes[n].c)): return false
    loop child in kids(n):
        if not comprehension_value(child): return false
    true

# a comprehension's in-bounds push (NF_COMPREHENSION) -> the loop's index local, the slot it writes
comprehension_push_index: {int: int} = {}

reserve_comprehension = (b: int):
    if not has_flag(b, NF_COMPREHENSION) or nkids(b) != 3 or not files[pos_file(nodes[b].pos)].is_dewy: return
    decl = kid(b, 0)
    loop_ = kid(b, 1)
    if nodes[decl].kind != .vardecl or nodes[loop_].kind != .for_: return
    init = int(nodes[decl].b)
    if nodes[init].kind != .array or nkids(init) != 0: return
    it = int(nodes[loop_].a)
    idx = int(nodes[loop_].sym)
    if nodes[loop_].aux == 0:
        if nodes[it].kind != .range or nodes[it].b == 0 or has_flag(it, NF_STEP) or has_flag(it, NF_INCLUSIVE): return
        start = int(nodes[it].a)
        if nodes[start].kind != .int_lit or nodes[start].ival != 0 or prune(ntype(int(nodes[it].b))) != T_INT: return
    else if nodes[loop_].aux == 1:
        k = tkind(ntype(it))
        if k != .array and k != .fixed: return
        idx = int(nodes[loop_].c)
        # Unlike range loops, an array loop advances this actual index. It
        # must stay unchanged even when the result uses incremental append.
        if not stable_loop_index(idx): return
    else: return
    body = int(nodes[loop_].b)
    nb = nkids(body)
    if nb == 0 or nodes[kid(body, nb - 1)].kind != .exprstmt: return
    # Combined index/value loops introduce local index bindings. Ordinary
    # straight-line local declarations have the same one-result guarantee.
    loop i in [0..nb - 1):
        item = kid(body, i)
        if nodes[item].kind != .vardecl or not comprehension_value(int(nodes[item].b)): return
    push = int(nodes[kid(body, nb - 1)].a)
    if nodes[push].kind != .intrinsic or nodes[push].aux != i32(int(IN.push)) or nkids(push) != 2: return
    recv = kid(push, 0)
    if nodes[recv].kind != .ident or nodes[recv].sym != nodes[decl].sym or not comprehension_value(kid(push, 1)): return
    # aux2 is unused by range/array loops; d already owns the array snapshot.
    nodes[loop_].aux2 = nodes[decl].sym
    add_flag(loop_, NF_COMPREHENSION)
    add_flag(push, NF_INBOUNDS)
    # Plain elements need no partial-initialization cleanup. With an unchanged
    # index, set the result length once and write directly to that index.
    at = prune(int(locals[int(nodes[decl].sym)].type))
    if not is_managed(int(types[at].elem)) and stable_loop_index(idx):
        add_flag(loop_, NF_INBOUNDS)
        add_flag(push, NF_COMPREHENSION)
        comprehension_push_index[push] = idx

# is an element loop done: index i past the end (more: is there more instead)
# ---------------- array paths fixed during a loop ----------------
# In a range loop (release builds), an array reached by a path -- a local variable or mut
# parameter and fields of it: xs, w.xs, ps.x -- that the loop cannot replace, resize or hand to
# anything that could, has its data pointer and length read once in front of the loop: indexing
# it then costs one compare, none when the index is the variable of a loop up to its length.
# A path the loop writes elements of gets its copy-on-write check there too, unless a copy of
# it (or of what holds it) is made in the loop.
struct FixedPath:
    key: int
    arr: int            # vreg: the array
    len: int            # vreg: its length
    loopvar: int        # local: indexes by this loop variable are in bounds (-1: none)
fixed_paths: FixedPath[]

fp_bases: int[]         # index bases in the loop that are paths
fp_kill: int[]          # paths the loop may replace or resize (with everything inside them)
fp_escape: int[]        # paths copied or handed on by value in the loop
fp_written: int[]       # paths whose elements the loop writes
fp_calls = false        # the loop calls code that might reach a mut parameter's variable
fp_lambda = false

# Canonical paths live for one lowered function. Roots use the low 32 bits
# (symbol index plus local/global tag); field edges use a nonzero parent ID in
# the high 32 bits and the field index below it. Symbol/field indexes are i32.
# Zero is not a path. Walking parents replaces string-prefix comparisons.
lpath_ids: {int: int} = {}
lpath_parents: int[] = [0]

lpath_intern = (parent: int, part: int) -> int:
    edge = (parent << 32) | part
    if let id = lpath_ids.get(edge): return id
    id = lpath_parents.len()
    lpath_parents.push(parent)
    lpath_ids[edge] = id
    id

lpath_key = (n: int) -> int:
    k = nodes[n].kind
    if k == .ident:
        if nodes[n].aux == i32(int(SK.local)): return lpath_intern(0, int(nodes[n].sym) * 2)
        if nodes[n].aux == i32(int(SK.global)): return lpath_intern(0, int(nodes[n].sym) * 2 + 1)
    if k == .field and nodes[n].aux >= 0:
        a = int(nodes[n].a)
        if tkind(ntype(a)) != .struct_ or boxed_field_of(n) >= 0: return 0
        parent = lpath_key(a)
        if parent == 0: return 0
        return lpath_intern(parent, int(nodes[n].aux))
    0

# the variable a path starts at (its ident node)
lpath_root = (n0: int) -> int:
    n = n0
    loop nodes[n].kind == .field: n = int(nodes[n].a)
    n

# k is p or a path that p is inside of
path_within = (p: int, k: int) -> bool:
    path = p
    loop path != 0:
        if path == k: return true
        path = lpath_parents[path]
    false

# where loop body n changes how many elements path `key` has, or replaces it, by itself (not
# through what it calls): 0 if it does not. (`loop mut` writes the elements in place: a body
# adding or removing them would skip or repeat elements.)
lm_change_at = (n: int, key: int) -> int:
    if n == 0: return 0
    k = nodes[n].kind
    if k == .lambda: return 0
    if k == .assign:
        tk = lpath_key(int(nodes[n].a))
        if tk != 0 and path_within(key, tk): return nodes[n].pos
    if k == .intrinsic and nkids(n) > 0:
        id = nodes[n].aux as IN
        if id == .push or id == .pop or id == .insert or id == .remove or id == .clear or id == .resize or id == .truncate or id == .extend:
            tk = lpath_key(kid(n, 0))
            if tk != 0 and path_within(key, tk): return nodes[n].pos
    if k == .call:
        mm = checked_call_mutmask(n)
        loop i in [0..nkids(n)):
            if mm & (1 << i) != 0:
                tk = lpath_key(kid(n, i))
                if tk != 0 and path_within(key, tk): return nodes[kid(n, i)].pos
    r = lm_change_at(int(nodes[n].a), key)
    if r == 0: r = lm_change_at(int(nodes[n].b), key)
    if r == 0 and k != .for_:
        r = lm_change_at(int(nodes[n].c), key)
        if r == 0 and k != .partial: r = lm_change_at(int(nodes[n].d), key)
    loop i in [0..nkids(n)):
        if r == 0: r = lm_change_at(kid(n, i), key)
    loop i in [0..nkids2(n)):
        if r == 0: r = lm_change_at(kid2(n, i), key)
    r

# the paths of loop s (with variable l) fixed during it; returns how many were added
# (place: the array of a `loop mut x in place`, whose elements the loop writes)
fp_end = (n: int):
    loop _ in [0..n): fixed_paths.pop()

fixed_path_of = (a: int) -> int:
    if fixed_paths.len() == 0: return -1
    key = lpath_key(a)
    if key == 0: return -1
    i = fixed_paths.len() - 1
    loop i >= 0:
        if fixed_paths[i].key == key: return i
        i -= 1
    -1

# ---------------- uniqueness hoisting ----------------
# A loop that writes elements of a local array but never lets the array escape (it is only
# indexed, measured or changed in place) keeps the array uniquely owned, so one copy-on-write
# check before the loop replaces the check at every element write (release builds).
uniq_locals: int[]          # locals known to be unique while lowering the current loop

# hoist the uniqueness checks of a loop's arrays in front of it; returns how many were added
declared_in_scope = (l: int) -> bool:
    # Borrowed element locals have no destructor entry in scope_locals. Their
    # marker is installed only when their declaration has been lowered.
    if int(locals[l].flags) & LF_ELEMENTVIEW != 0: return true
    loop sl in scope_locals:
        if sl.contains(l): return true
    false

uq_end = (n: int):
    loop _ in [0..n): uniq_locals.pop()

# Closed-program array ownership. A global whose storage is always fresh and
# never copied or exposed cannot require detaching at an element write. Keep
# this separate from loop-local uniqueness: it holds across calls as well.
uniq_globals: bool[]

ug_fresh = (n: int, t: int) -> bool:
    if n == 0: return true   # a typed, uninitialized array starts empty
    if nodes[n].kind != .array: return false
    nodes[n].b != 0 or nkids(n) == 0 or not all_const(n, int(types[prune(t)].elem))

ug_scan = (n: int, ctx: int):
    # 0: value can escape, 1: only its storage is inspected/changed,
    # -1: an address or mutable argument can expose the containing storage.
    if n == 0: return
    k = nodes[n].kind
    if k == .lambda: return  # checked bodies are scanned through fns
    if k == .ident:
        if nodes[n].aux == i32(int(SK.global)):
            g = int(nodes[n].sym)
            if ctx != 1 and g < uniq_globals.len(): uniq_globals[g] = false
        else if nodes[n].aux == i32(int(SK.local)):
            g = alias_global(int(nodes[n].sym))
            if g >= 0 and g < uniq_globals.len(): uniq_globals[g] = false
        return
    if k == .index:
        ug_scan(int(nodes[n].a), if ctx == -1: -1 else: if nodes[n].aux == 1: 0 else: 1)
        ug_scan(int(nodes[n].b), 0)
        return
    if k == .addr:
        ug_scan(int(nodes[n].a), -1)
        return
    if k == .assign:
        a = int(nodes[n].a)
        b = int(nodes[n].b)
        if nodes[a].kind == .ident and nodes[a].aux == i32(int(SK.global)) and tkind(ntype(a)) == .array and ug_fresh(b, ntype(a)):
            ug_scan(a, 1)
        else: ug_scan(a, 0)
        ug_scan(b, 0)
        return
    if k == .vardecl and has_flag(n, NF_ALIASDECL):
        ug_scan(int(nodes[n].b), -1)
        return
    if k == .intrinsic:
        id = nodes[n].aux as IN
        if nkids(n) > 0 and (id == .len or id == .arrcap or id == .push or id == .pop or id == .insert or id == .remove or id == .clear or id == .reserve or id == .resize or id == .truncate or id == .extend):
            ug_scan(kid(n, 0), if ctx == -1: -1 else: 1)
            loop i in [1..nkids(n)): ug_scan(kid(n, i), 0)
            return
    ug_scan(int(nodes[n].a), if ctx == -1: -1 else: 0)
    ug_scan(int(nodes[n].b), if ctx == -1: -1 else: 0)
    if k != .for_:
        ug_scan(int(nodes[n].c), if ctx == -1: -1 else: 0)
        if k != .partial: ug_scan(int(nodes[n].d), if ctx == -1: -1 else: 0)
    mm = if k == .call or k == .pair: checked_call_mutmask(n) else: 0
    loop i in [0..nkids(n)):
        arg = kid(n, i)
        ug_scan(arg, if ctx == -1 or mm & (1 << i) != 0: -1 else: 0)
    loop i in [0..nkids2(n)): ug_scan(kid2(n, i), 0)

find_unique_globals = (closed: bool):
    uniq_globals.clear()
    # Future interactive code can introduce copies. Late runtime helpers may
    # reference prelude globals, so those are excluded from this closed world.
    if not closed: return
    uniq_globals.resize(globals.len())
    any = false
    loop g in global_ids:
        if globals[g].state != 2 or globals[g].is_const or modules[int(globals[g].mod)].is_prelude: continue
        t = prune(int(globals[g].type))
        d = int(globals[g].decl)
        if types[t].kind != .array or nkids(d) != 0: continue
        if ug_fresh(int(nodes[d].b), t):
            uniq_globals[g] = true
            any = true
    if not any: return
    # Initializers commonly expose every candidate (for example by passing a
    # global array to a function). Disprove those before walking other bodies.
    loop fi in init_fns: ug_scan(int(fns[fi].body), 0)
    any = false
    loop g in global_ids:
        if uniq_globals[g]: any = true
    if not any: return
    loop f in fns:
        if f.state == 2 and not f.no_user_globals: ug_scan(int(f.body), 0)

is_uniq_array = (e: int) -> bool:
    if nodes[e].kind != .ident: return false
    r = int(nodes[e].sym)
    if nodes[e].aux == i32(int(SK.local)): return uniq_locals.contains(r)
    nodes[e].aux == i32(int(SK.global)) and r < uniq_globals.len() and uniq_globals[r]

# a loop condition that is cheap to test twice and computes nothing the body could reuse:
# comparisons of variables and literals (i < j, k != 0, done), and/or/not of those
simple_cond = (e: int) -> bool:
    k = nodes[e].kind
    if k == .bool_lit: return true
    if k == .ident: return nodes[e].aux == i32(int(SK.local))
    if k == .not_: return simple_cond(int(nodes[e].a))
    if k == .and_ or k == .or_: return simple_cond(int(nodes[e].a)) and simple_cond(int(nodes[e].b))
    if k == .binary and nodes[e].aux == 0:
        op = nodes[e].op as Tok
        if not (op == .eq or op == .ne or op == .lt or op == .le or op == .gt or op == .ge): return false
        loop x in [int(nodes[e].a), int(nodes[e].b)]:
            xk = nodes[x].kind
            if not (xk == .int_lit or xk == .bool_lit or (xk == .ident and nodes[x].aux == i32(int(SK.local)))): return false
            if vc(ntype(x)) != VC_INT: return false
        return true
    false

use 'scanloops.jo'
use 'exact_reset_loop.jo'

# ---------------- functions ----------------
begin_fn = (name: str, idx: int):
    ir_begin(name, idx)
    exact_lower_active = exact_nodes.len() > 0
    eg_active = false
    lower_length_guards = []
    parallel_scalars.clear()
    parallel_owned.clear()
    stack_closure_fn = -1
    stack_closure_params.clear()
    math_word_regs.clear()
    math_static_regs.clear()
    math_static_widths.clear()
    math_word_limits.clear()
    math_word_updates.clear()
    math_writes_ready = false
    math_has_mutable = false
    math_writes.clear()
    math_decl_depth.clear()
    math_loop_sites.clear()
    math_write_loop.clear()
    math_loop_parent.clear()
    ctl = 0
    cond_depth = 0
    scope_locals = []
    scope_defers = []
    loops = []
    tl_items.clear()
    tl_values.clear()
    tl_nop.clear()
    lower_zeros.clear()
    lower_mark_serial = 0
    lower_has_nops = ownership_decls.len() != 0
    tl_cond.clear()
    building = []
    sret_v = -1
    env_v = -1

find_ids: int[]
# (the bytes Op.findb looks for, packed, for a runtime function so made (lib/core/str.jo); -1:
# not one; -2: the dynamic-byte __memchr)
find_bytes_set = (name: int) -> int:
    if find_ids.len() == 0:
        loop nm in ["__find_delim", "__find_newline", "__find_line_delim", "__find_line_delim4", "__find_line_delim8", "__memchr"]: find_ids.push(intern(nm))
    if name == find_ids[5]: return -2
    delims = 0x0A | (0x22 << 8) | (0x23 << 16) | (0x27 << 24)
    if name == find_ids[0]: return delims
    if name == find_ids[1]: return 0x0A0A0A0A
    if name == find_ids[2]: return delims | (1 << 32)
    if name == find_ids[3]: return delims | (1 << 32) | (4 << 33)
    if name == find_ids[4]: return delims | (1 << 32) | (8 << 33)
    -1

lower_inst = (lf: int, f: int):
    positive_epoch += 1
    begin_fn(lfuncs[lf].name, lf)
    owner_begin()
    if fns[f].decl != 0:
        ir_set_pos(nodes[int(fns[f].decl)].pos)
        ir.decl_pos = ir_pos
    cur_fn = f
    exact_lower_active = exact_owners.has(f)
    eg_active = f < eg_demanded.len() and eg_demanded[f]
    cur_ret = int(fns[f].ret)
    ir.cabi = fns[f].cabi
    ir.noinline = fns[f].noinline
    ir.export_name = if parallel_serial: "" else: fns[f].export_name
    if vc(cur_ret) == VC_AGG: sret_v = vreg(VI)
    if fns[f].has_env: env_v = vreg(VI)
    if fns[f].kind == FK_LAMBDA: env_layout(f)
    # parameters
    loop i in 0.. and l in fns[f].params:
        t = int(locals[l].type)
        pv = 0
        if int(locals[l].flags) & LF_MUTPARAM != 0 or vc(t) == VC_AGG: pv = vreg(VI)
        else: pv = vreg(vt_of(t))
        locals[l].vreg = i32(pv)
        locals[l].offset = -1
    ir.nparams = ir.vtypes.len()
    partition_begin(f)
    if refine_active: refine_gen_entry(f)
    ir.ret = ret_vt(cur_ret)
    if fns[f].decl != 0 and not target_arm64 and not target_wasm and not dbg_on and modules[int(fns[f].mod)].is_prelude:
        # Private bounded byte searches from lib/core/str.jo.
        set = find_bytes_set(int(nodes[int(fns[f].decl)].name))
        if set == -2:
            # __memchr(p, from, n, byte): guard the span before subtracting or
            # forming its address. The intrinsic returns a relative offset.
            ir.raw_mem = true
            e_if(e_bin(.ges, VI, 1, 2))
            e_ret(e_iconst(-1))
            e_end()
            pointer = e_bin(.add, VI, 0, 1)
            length = e_bin(.sub, VI, 2, 1)
            result = vreg(VI)
            emit(.findbyte, VI, result, pointer, length, 3, 0)
            e_if(e_bin(.ges, VI, result, e_iconst(0)))
            e_ret(e_bin(.add, VI, result, 1))
            e_end()
            e_ret(e_iconst(-1))
            return
        if set >= 0:
            ir.raw_mem = true
            result = vreg(VI)
            emit(.findb, VI, result, 0, 1, 2, set)
            e_ret(result)
            return
    if (f == runtime_memeq or f == runtime_streq) and not target_arm64 and not target_wasm and not dbg_on:
        # Ordinary scalar body remains available to the bootstrap, debugger and
        # other targets. Select only the exact private runtime instances.
        ir.raw_mem = true
        result = vreg(VI)
        operation = Op.memeq
        count = 2
        if f == runtime_streq:
            operation = .streq
            count = 0
        emit(operation, VI, result, 0, 1, count, 0)
        e_ret(result)
        return
    # (called from C, whose callers leave the upper bits of narrow integers undefined: made
    # what Sloppy code expects of them)
    if fns[f].cabi:
        # (C may call it from a thread of its own: the allocator tells threads apart from now on)
        if let ct = prelude.get(intern("__c_threads")):
            if syms[ct].kind == .global: e_store(e_gaddr(global_addr_off(int(syms[ct].ref))), 0, e_iconst(1), 1)
        loop l in fns[f].params:
            t = prune(int(locals[l].type))
            if types[t].kind == .int_ and tsize(t) < 8 and int(locals[l].flags) & LF_MUTPARAM == 0: e_mov(int(locals[l].vreg), norm(int(locals[l].vreg), t))
    # Bind read-only Dewy value parameters before allocating local storage.
    # These declarations form a contiguous synthetic prefix. Rebind on every
    # lowering so watch/repl and debug builds cannot reuse old virtual registers.
    body = int(fns[f].body)
    loop i in [0..nkids(body)):
        s = kid(body, i)
        if nodes[s].kind != .vardecl or nodes[s].aux2 != 1: break
        if nkids(s) > 0 or has_flag(s, NF_GLOBAL): continue
        l = int(nodes[s].sym)
        if l < 0: continue
        locals[l].flags &= i32(~LF_PARAM)
        param_view_decl(s, l)
    find_views(f)
    if copies_on:
        icb = ic_phase(IC_OWNERSHIP)
        copies_prepare(f)
        ic_restore(icb)
    # locals
    loop l in fns[f].locals:
        fl = int(locals[l].flags)
        t = int(locals[l].type)
        if t == T_MATH_INT and fl & LF_ASSIGNED != 0: math_has_mutable = true
        if fl & (LF_CAPTURE | LF_ALIAS) != 0: continue
        if fl & LF_PARAM != 0:
            if copy_inputs.has(l) and (not files[pos_file(nodes[int(fns[f].decl)].pos)].is_dewy or ownership_consumers.len() != 0 and ownership_consumers.has(int(fns[f].decl))):
                s = new_temp(t)
                store_val(t, e_slot(s), 0, int(locals[l].vreg))
                locals[l].offset = i32(s)
                continue
            if fl & LF_ADDR != 0 and fl & LF_MUTPARAM == 0 and vc(t) != VC_AGG:
                # address-taken scalar parameter: move to memory
                s = new_slot(8, 8)
                store_val(t, e_slot(s), 0, int(locals[l].vreg))
                locals[l].offset = i32(s)
            continue
        locals[l].offset = -1
        if fl & LF_BYREF != 0:
            locals[l].vreg = i32(vreg(VI))
            continue
        t = store_type(l)
        if vc(t) == VC_AGG or fl & LF_ADDR != 0 or ownership_type(t):
            s = new_slot(tsize(t), talign(t))
            locals[l].offset = i32(s)
            if is_managed(t): e_zero(e_slot(s), tsize(t))
            continue
        locals[l].vreg = i32(vreg(vt_of(t)))
        if is_managed(t): e_mov(int(locals[l].vreg), e_iconst(0))
    exm_censuses = {}; lower_entry = []
    exm_produced_flags = {}; exm_produced_widths = {}
    exm_start = ir.code.len()
    if exact_loop_plan(f, body):
        guard = exact_loop_guard(body)
        iff(guard)
        exact_loop_fast = true
        lower_inst_body(f, body)
        exact_loop_fast = false
        endc()
    lower_inst_body(f, body)
    if lower_entry.len() > 0:
        loop i in [0..lower_zeros.len()):
            if lower_zeros[i].mark >> 32 >= exm_start: lower_zeros[i].mark += lower_entry.len() << 32
        ir.code = ir.code[..exm_start) + lower_entry + ir.code[exm_start..]
    if vc(cur_ret) == VC_AGG: e_ret(sret_v)
    else if vc(cur_ret) == VC_VOID: e_ret(-1)
    else: e_trap()
    owner_end()
    if dbg_on:
        loop l in fns[f].params: ir.dbg_locals.push(l)
        loop l in fns[f].locals:
            if int(locals[l].flags) & LF_PARAM == 0: ir.dbg_locals.push(l)

lower_inst_body = (f: int, body: int) -> void:
    guarded = lower_length_guards.len()
    scope_push()
    if ownership_decls.len() != 0 and fns[f].decl != 0 and not files[pos_file(nodes[int(fns[f].decl)].pos)].is_dewy:
        loop p in fns[f].params:
            if copy_inputs.has(p): scope_add_local(p)
    # (a `$__consume__` method owns its receiver, which no binding of Dewy's takes)
    else if ownership_consumers.len() != 0 and fns[f].params.len() > 0 and ownership_consumers.has(int(fns[f].decl)) and copy_inputs.has(fns[f].params[0]): scope_add_local(fns[f].params[0])
    if fns[f].kind == FK_INIT:
        gen_block_stmts(body)
    else:
        n = nkids(body)
        loop i in [0..n):
            cur_block = body
            cur_block_i = i
            s = kid(body, i)
            if i == n - 1 and nodes[body].aux != 0 and vc(cur_ret) != VC_VOID:
                r = mk(.return_, nodes[s].pos)
                nodes[r].a = nodes[s].a
                # (its line, as a statement's: for backtraces and debuggers)
                ir_set_pos(nodes[s].pos)
                gen_return(r)
                continue
            gen_stmt(s)
            lower_length_guard(s)
    lower_length_guards.truncate(guarded)
    scope_pop()

lop_watch = false       # (loops in this function count down to the web page's watchdog)

lower_function = (lf: int):
    lower_epoch += 1
    lower_planning = true
    exr_fast = lfuncs[lf].kind == LK_HELPER and lfuncs[lf].hkind == HK.reset_words
    parallel_serial = lfuncs[lf].kind == LK_HELPER and (lfuncs[lf].hkind == HK.parallel_serial or lfuncs[lf].hkind == HK.partition and lfuncs[lf].htype == 1)
    partition_mode = lfuncs[lf].kind == LK_HELPER and lfuncs[lf].hkind == HK.partition
    if lfuncs[lf].kind == LK_INST or parallel_serial or partition_mode or exr_fast: pc_restore(lfuncs[lf].inst)
    exr_locals = if exr_fast: exr_plan(lfuncs[lf].inst) else: []
    fact_storage_cache.clear()
    lpath_ids.clear()
    lpath_parents.truncate(1)
    f = lfuncs[lf]
    lop_watch = false
    if want_loop_watch and f.kind == LK_INST and prelude.get(intern("__loop_budget")) != none:
        fi0 = f.inst
        d0 = int(fns[fi0].decl)
        if d0 != 0: lop_watch = not pos_in_lib(nodes[d0].pos)
        else: lop_watch = fns[fi0].kind == FK_INIT and not modules[int(fns[fi0].mod)].is_prelude
    # (generated helpers have no place in the source)
    ir_pos = 0
    if f.kind == LK_INST:
        fi = f.inst
        if fns[fi].kind == FK_PARTIAL: lower_partial_thunk(lf, fi)
        else: lower_inst(lf, fi)
    else if parallel_serial or partition_mode or exr_fast: lower_inst(lf, f.inst)
    else: lower_helper(lf)
    parallel_serial = false
    partition_mode = false
    lower_finish()
    lower_planning = false
    exr_fast = false

# Only functions with demanded insertions or construction/owner placeholders
# need a final IR walk. P requested zeros cost O(P log P) ordering and one
# O(IR + P) merge; the ordinary path is O(1), with no full-code copy or scan.
# Equal instruction boundaries retain statement-entry order through the serial.
lower_finish = ():
    if lower_zeros.len() == 0:
        if not lower_has_nops: return
        k = 0
        loop ins in ir.code:
            if ins.op != .nop:
                ir.code[k] = ins
                k += 1
        ir.code.truncate(k)
        return
    lower_zeros.sort_by((z: LowerZero) -> int: z.mark)
    out: Ins[]
    out.reserve(ir.code.len() + lower_zeros.len())
    next = 0
    loop i in [0..ir.code.len() + 1):
        loop next < lower_zeros.len() and lower_zeros[next].mark >> 32 == i:
            z = lower_zeros[next]
            out.push(Ins(.zeroslots, 0, 0, i32(z.start), i32(z.count), 0, 0))
            next += 1
        if i < ir.code.len() and ir.code[i].op != .nop: out.push(ir.code[i])
    ir.code = out

# ---------------- generated helper functions ----------------
lower_partial_thunk = (lf: int, th: int):
    pass

each_field = (t0: int, addr: int, f: (int, int) -> void):
    pass

# a loop over the elements of fixed-size array type t: i counts 0..N (the body goes between)
# Value equality/hash can call user-defined member operations. Keep the
# enclosing value alive and independent throughout those calls, including a
# surrounding array whose owner a callback could replace. When all reachable
# member operations leave global state alone, helpers keep the pure read path.
value_member_cache: {int: int[]} = {}

# Calls made by generated aggregate helpers still participate in ordinary
# alias/effect analysis, just like calls written explicitly in the source.
# a box's last reference gone: its value dropped and the box freed. Boxes that dropping it frees
# wait their turn (__box_defer), so a list a million long is freed in a loop, not a million calls
# deep: the first box dropped on a thread drops those after it (__box_next)
# (the box p's value dropped, and the box freed)
# takes a box, gives back one with no other reference: itself, or a copy holding what it holds
# compare members at addresses a and b; branch to `fail` level when different
# Keyed (a dictionary's slots, lib/core/map.jo): every member word mixed under the process's
# secret key (__hk_mix), strings by __hk_bytes, and a type's own hash's result under the key.
hk_key = 0          # (the key's register in the keyed helper being lowered, else 0)

# the bits of float v, with -0.0 as 0.0 (they are equal)
# does helper_hash for t do more than hash_member for t (which would call it again)?
# A spawn body (dewy_nodes.jo's dw_task_spawn, aux2 17) runs once, in its task: the
# task runtime's copies of it share one environment, whose captures, owners among them,
# are dropped once, with the last copy.
spawn_body = (f: int) -> bool:
    d = int(fns[f].decl)
    # (the conversion to the task's callable type wraps the literal in place)
    loop d != 0 and nodes[d].kind == .conv: d = int(nodes[d].a)
    d != 0 and nodes[d].kind == .lambda and nodes[d].aux2 == 17

# Only owned, unshared resource captures can move out of a run-once body.
# Nested shared captures and borrowed places keep their existing restrictions.
spawn_owned_capture = (f: int, l: int) -> bool:
    flags = int(locals[l].flags)
    flags & LF_CAPTURE != 0 and flags & (LF_OWNERBORROW | LF_PARTBORROW) == 0 and not is_shared(l) and ownership_type(int(locals[l].type)) and spawn_body(f)

# native FFI: a thunk that resolves the C function on first use and calls it
# macOS: the C functions dyld puts in their slots when the program starts: (slot's offset in the
# data, library, symbol) -- compiler/macho.jo writes them as binds
mac_imports: (int, str, str)[]

# (macOS: the library dyld binds a C function from when the program starts, or "" for one loaded
# when first called (dlopen): system libraries by path, and Linux's libc as libSystem)
# (macOS: code compiled for a program already running -- the prompt's inputs, sloppy watch's
# later builds -- finds C functions when first called: dyld bound only what the program used.
# Not the functions that finding them takes, dlopen and dlsym: those programs have them bound,
# lib/std/repl.jo and lib/std/watch.jo)
late_binding = false

mac_bound_lib = (lib: str) -> str:
    if starts_with(lib, "/"): return lib
    if lib == "libc.so.6" or lib == "libm.so.6" or lib == "libdl.so.2" or lib == "libpthread.so.0": return "/usr/lib/libSystem.B.dylib"
    ""

# An optional raw pointer (Dewy's ptr<T>?), null at the C boundary when none.
c_nullable = (t0: int) -> bool:
    t = prune(t0)
    types[t].kind == .opt and tkind(int(types[t].elem)) == .ptr

lower_extern_thunk = (lf: int, f: int):
    begin_fn(fns[f].sym, lf)
    lib = fns[f].clib
    nm = name_of(int(nodes[int(fns[f].decl)].name))
    if len(fns[f].csym) > 0: nm = fns[f].csym
    ret = int(fns[f].ret)
    # (Dewy's ptr<T>?: an optional held as a value, null to C when it is none)
    sret = if c_nullable(ret): vreg(VI) else: -1
    ps: int[]
    loop t in fns[f].ptypes:
        if vc(t) == VC_AGG and not c_nullable(t): fatal(nodes[int(fns[f].decl)].pos, "C functions can only take scalar or pointer arguments")
        if tkind(t) == .array: fatal(nodes[int(fns[f].decl)].pos, "a C function cannot take an array: declare the parameter as a pointer (*f32) and pass data(xs)")
        ps.push(vreg(vt_of(t)))
    ir.nparams = ir.vtypes.len()
    # (a str goes to C as its bytes, ending in a zero byte: a char *)
    cps: int[]
    loop i in 0.. and t in fns[f].ptypes:
        if c_nullable(t):
            p = vreg(VI)
            e_mov(p, e_iconst(0))
            iff(opt_has(ps[i], int(types[prune(t)].elem)))
            e_mov(p, e_load(VI, ps[i], 0, 8))
            endc()
            cps.push(p)
        else if tkind(t) == .str_: cps.push(e_call1(rt("__c_str"), ps[i], VI))
        else if fns[f].cvariadic > 0 and i >= int(fns[f].cvariadic) - 1 and vt_of(t) == VS:
            # C promotes variadic floats to double. Fixed f32 parameters keep
            # their declared type; narrow integers already use extended registers.
            d = vreg(VF)
            emit(.f2f, VF, d, ps[i], 0, 0, 0)
            cps.push(d)
        else: cps.push(ps[i])
    if vc(ret) == VC_AGG and sret < 0: fatal(nodes[int(fns[f].decl)].pos, "C functions can only return scalars or pointers")
    ir.ret = ret_vt(ret)
    data_size = align_up(data_size, 8)
    slot = data_size
    data_size += 8
    ffi_slot[slot] = ffi_offs.len()
    ffi_offs.push(slot)
    ffi_keys.push("ffi|{lib}|{nm}")
    fp = vreg(VI)
    imp = -1
    if target_windows and lower(lib) == "kernel32.dll": imp = pe_imports.index_of(nm)
    if imp >= 0:
        # (one of the functions the program imports: from the import table, compiler/pe.jo)
        emit(.intr, VI, fp, 0, 0, i32(imp), 10)
    else if target_macos and len(mac_bound_lib(lib)) > 0 and (not late_binding or nm == "dlopen" or nm == "dlsym" or nm == "dlerror"):
        # (dyld has put it in the slot, or null where its library is missing)
        mac_imports.push((slot, mac_bound_lib(lib), nm))
        e_mov(fp, e_load(VI, e_gaddr(slot), 0, 8))
        iff(e_bin(.eq, VI, fp, e_iconst(0)))
        e_call2(rt("__ffi_missing"), e_daddr(str_data(lib)), e_daddr(str_data(nm)), -1)
        endc()
    else:
        rlib = lib
        if target_macos and len(mac_bound_lib(lib)) > 0: rlib = mac_bound_lib(lib)
        e_mov(fp, e_load(VI, e_gaddr(slot), 0, 8))
        iff(e_bin(.eq, VI, fp, e_iconst(0)))
        e_mov(fp, e_call2(rt("__ffi_resolve"), e_daddr(str_data(rlib)), e_daddr(str_data(nm)), VI))
        e_store(e_gaddr(slot), 0, fp, 8)
        endc()
    r = e_calli(fp, cps, (if sret >= 0: VI else: ret_vt(ret)), true)
    # (C's variadic arguments: on Apple's arm64 they go on the stack)
    if fns[f].cvariadic > 0: ir.code[ir.code.len() - 1].imm = int(fns[f].cvariadic)
    if sret >= 0:
        e_zero(sret, tsize(ret))
        e_store(sret, 0, r, 8)
        e_store(sret, 8, e_bin(.ne, VI, r, e_iconst(0)), 1)
        e_ret(sret)
        return
    if vc(ret) == VC_INT: r = norm(r, ret)
    e_ret(r)

# Embedded values have no independent stack record: their complete enclosing
# owner is the cleanup authority. Partial construction retains the field's
# temporary owner until the enclosing object is complete.
# Publish only successfully initialized elements. The array owns the prefix
# during failures in later constructors; each pending element owns itself.
owner_array_from_fixed = (source: int, et: int, count: int, t: int, dynamic: bool = false) -> Val:
    s = new_temp(t)
    sa = e_slot(s)
    e_zero(sa, tsize(t))
    owner_register(s, t)
    n = if dynamic: count else: e_iconst(count)
    e_call3(rt("__arr_reserve"), sa, e_iconst(owner_stride(et)), n, -1)
    i = vreg(VI)
    e_mov(i, e_iconst(0))
    blk()
    lop()
    brif_to(e_bin(.ges, VI, i, n), ctl - 1)
    ea = e_bin(.add, VI, source, e_bin(.mul, VI, i, e_iconst(tsize(et))))
    value = own(Val(load_val(et, ea, 0), false, -1), et)
    dst = e_call2(rt("__arr_push_slot"), sa, e_iconst(owner_stride(et)), VI)
    store_val(et, dst, 0, value.v)
    owner_element_live(dst, et)
    owner_forget_slot(value.slot)
    e_mov(i, e_addi(i, 1))
    br_to(ctl)
    endc()
    endc()
    result = e_load(VI, sa, 0, ptr_size)
    owner_values[result] = s
    Val(result, true, s)

# Eager resource snapshots never retain the source. Allocation may fail before
# any new element exists; inline element copy hooks have no-failure summaries.
# Unlike inline hooks, recursive copies can allocate. Hold each completed
# child independently until the complete result can be handed to the caller.

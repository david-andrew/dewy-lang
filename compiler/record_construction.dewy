$runtime_checks
from p"ast.jo" import (NF_GENERIC NF_RECORD add_flag mk nodes set_list set_list2)
from p"check.jo" import (check_struct_fields ctxs cx)
from p"checks_thin_expr.dewy" import (is_map_type)
from p"expr.jo" import (dewy_record_shapes ntype struct_defaults_known)
from p"refine.jo" import (refine_active)
from p"refine_metadata.dewy" import (ref_storage_contract)
from p"type_ops.dewy" import (get_struct_inst)
from p"types.jo" import (fields is_union prune structs types)
from p"util.jo" import (intern name_of)

RecordCtorWord:type=int64<overflow='wrap'>

struct_has_defaults=(si:RecordCtorWord depth:RecordCtorWord):>bool=>{
    let cached=struct_defaults_known.get(si)
    if cached not=? none {return cached}
    if depth >? 16 {return false}
    check_struct_fields(si)
    let has=false
    loop i in [0..RecordCtorWord(structs[si].nfields)) {
        let f=fields[RecordCtorWord(structs[si].fields) + i]
        if f.defval not=? 0 or refine_active and ref_storage_contract(RecordCtorWord(f.type)) {has=true}
        else {
            let ft=prune(RecordCtorWord(f.type))
            if types[ft].kind =? 'struct_' and not is_map_type(ft) and not is_union(ft) and struct_has_defaults(RecordCtorWord(types[ft].st) depth + 1) {has=true}
        }
        if has {break}
    }
    struct_defaults_known[si]=has
    has
}

# Type annotations and inferred literals share the same structural identity.
# Each member carries its resolved type; source values remain separate.
dewy_record_schema=(n:RecordCtorWord args:array<int64>):>RecordCtorWord=>{
    # Small schemas use insertion sort on a separate set of indices.
    let ordered:array<int64>=[]
    loop field in args {
        ordered.push(field)
        let i=RecordCtorWord(ordered.length) - 1
        loop i >? 0 and name_of(RecordCtorWord(nodes[ordered[i - 1]].name)) >? name_of(RecordCtorWord(nodes[field].name)) {
            ordered[i]=ordered[i - 1]
            i -= 1
        }
        ordered[i]=field
    }
    let key=""
    let targs:array<int64>=[]
    loop field in ordered {
        key="{key}{RecordCtorWord(nodes[field].name)};"
        targs.push(prune(ntype(field)))
    }
    let decl=dewy_record_shapes.get(key) ?? 0
    if decl =? 0 {
        decl=mk('struct_' nodes[n].pos)
        nodes[decl].name=int32(intern("<record>"))
        nodes[decl].mod=ctxs[cx].mod
        add_flag(decl NF_RECORD)
        add_flag(decl NF_GENERIC)
        let members:array<int64>=[]
        let params:array<int64>=[]
        loop i in 0.. and field in ordered {
            let param=mk('ident' nodes[field].pos)
            nodes[param].name=int32(intern("__Field{i}"))
            params.push(param)
            let member=mk('vardecl' nodes[field].pos)
            nodes[member].name=nodes[field].name
            let tn=mk('tname' nodes[field].pos)
            nodes[tn].name=nodes[param].name
            nodes[member].a=int32(tn)
            members.push(member)
        }
        set_list(decl members)
        set_list2(decl params)
        dewy_record_shapes[key]=decl
    }
    let t=get_struct_inst(decl targs)
    check_struct_fields(RecordCtorWord(types[t].st))
    t
}

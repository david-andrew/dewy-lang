# The frozen implementation-language twin of dewy_syntax.dewy, for the compilers without the
# Dewy frontend (tools/compiler/build.py). Change both, or neither.
use 'dewy_tokens.dewy'
use 'targets.dewy'

struct DewySyntax:
    kind: DewyKind
    text: str
    pos: int
    children: int[]
    symbol: DewyToken = .none
    name: i32 = 0
    child_mode: int = 0
    child_left: int = 0
    child_right: int = 0

struct SyntaxProblem:
    message: str
    at: int
    unsupported: bool

dw_kind_name = (kind: DewyKind) -> str:
    match kind:
        unknown: "Unknown"
        op: "op"
        identifier: "Identifier"
        boolean: "Bool"
        metatag: "Metatag"
        based_string: "BasedString"
        integer: "Integer"
        source_integer: "Integer"
        source_real: "Real"
        quoted: "quoted"
        rawquoted: "rawquoted"
        eof: "eof"
        atom: "Atom"
        ambiguous: "Ambiguous"
        binary: "BinOp"
        block: "Block"
        combined_assignment: "CombinedAssignmentOp"
        flat: "Flat"
        flow: "Flow"
        interpolated_string: "IString"
        inverted_comparison: "InvertedComparisonOp"
        keyword: "Keyword"
        keyword_expr: "KeywordExpr"
        operator: "Operator"
        postfix: "Postfix"
        prefix: "Prefix"
        string: "String"
        string_chunk: "StringChunk"
        directive: "Directive"
        compact_expr: "CompactExpression"
        compact_stmt: "CompactStatement"
        lazy_body: "LazyBody"

syntax_node = (tree: mut DewySyntax[], kind: DewyKind, text: str, pos: int, children: int[], name: i32) -> int:
    id = tree.len()
    tree.push(DewySyntax(kind, text, pos, children, .none, name))
    id

syntax_op_node = (tree: mut DewySyntax[], kind: DewyKind, symbol: DewyToken, pos: int, children: int[]) -> int:
    id = tree.len()
    tree.push(DewySyntax(kind, "", pos, children, symbol))
    id

syntax_operator = (tree: mut DewySyntax[], kind: DewyKind, op: DewyToken, left: int, right: int) -> int:
    scalar = dn_token_uninvert(op)
    sentinel = 0
    if scalar != op: sentinel = 1
    id = tree.len()
    pos = tree[left].pos
    if kind == .binary: tree.push(DewySyntax(kind, "", pos, [], scalar, 0, sentinel + 1, left, right))
    else: tree.push(DewySyntax(kind, "", pos, [sentinel, left, right], scalar))
    id

syntax_child = (tree: mut DewySyntax[], id: int, at: int) -> int:
    mode = tree[id].child_mode
    if mode == 0: return tree[id].children[at]
    if at == 0: return mode - 1
    if at == 1: return tree[id].child_left
    tree[id].child_right

syntax_children = (tree: mut DewySyntax[], id: int) -> int[]:
    mode = tree[id].child_mode
    if mode == 0: return tree[id].children
    [mode - 1, tree[id].child_left, tree[id].child_right]

syntax_count = (tree: mut DewySyntax[], id: int) -> int:
    if tree[id].child_mode != 0: return 3
    tree[id].children.len()

syntax_multiplications = (tree: mut DewySyntax[], id: int) -> int:
    score = 0
    if tree[id].text == "MultiplyJuxtapose": score = 1
    loop child in syntax_children(tree, id): score += syntax_multiplications(tree, child)
    score

syntax_unwrap = (tree: mut DewySyntax[], id0: int) -> int:
    id = id0
    loop true:
        kind = tree[id].kind
        if kind == .atom:
            id = syntax_child(tree, id, 0)
            continue
        if kind != .ambiguous: return id
        best = -1
        score = 1000000000
        tied = false
        loop child in syntax_children(tree, id):
            next = syntax_multiplications(tree, child)
            if next < score:
                best = child
                score = next
                tied = false
            else if next == score: tied = true
        if best < 0 or tied: return 0 - id - 1
        id = best
    id

syntax_op = (tree: mut DewySyntax[], id: int) -> DewyToken:
    kind = tree[id].kind
    if kind != .binary and kind != .prefix and kind != .postfix and kind != .flat: return .none
    symbol = tree[id].symbol
    if symbol != .none: return symbol
    op = syntax_child(tree, id, 0)
    if kind == .binary and tree[op].kind == .combined_assignment: return dn_token_kind(tree[syntax_child(tree, op, 0)].text + "=")
    tree[op].symbol

syntax_fail = (p: mut SyntaxProblem, at: int, message: str, unsupported: bool):
    if len(p.message) > 0: return
    p.message = message
    p.at = at
    p.unsupported = unsupported

unwrapped = (tree: mut DewySyntax[], p: mut SyntaxProblem, id: int) -> int:
    u = syntax_unwrap(tree, id)
    if u >= 0: return u
    syntax_fail(p, tree[0 - u - 1].pos, "an ambiguous expression; use explicit multiplication or parentheses", true)
    0

op_of = (tree: mut DewySyntax[], p: mut SyntaxProblem, id: int) -> DewyToken: syntax_op(tree, unwrapped(tree, p, id))

name_of = (tree: mut DewySyntax[], p: mut SyntaxProblem, id: int) -> str:
    u = unwrapped(tree, p, id)
    if tree[u].kind == .identifier: return tree[u].text
    ""

metatag_named = (tree: mut DewySyntax[], p: mut SyntaxProblem, id: int, name: str) -> bool:
    u = unwrapped(tree, p, id)
    tree[u].kind == .metatag and tree[u].text == name

syntax_is_target = (tree: mut DewySyntax[], p: mut SyntaxProblem, id: int) -> bool: metatag_named(tree, p, id, "target")
syntax_is_build = (tree: mut DewySyntax[], p: mut SyntaxProblem, id: int) -> bool: metatag_named(tree, p, id, "build")

syntax_target_field = (tree: mut DewySyntax[], p: mut SyntaxProblem, id0: int) -> int:
    id = unwrapped(tree, p, id0)
    if syntax_is_target(tree, p, id): return 0
    if syntax_op(tree, id) != .dot or syntax_count(tree, id) != 3: return -1
    member = name_of(tree, p, syntax_child(tree, id, 2))
    if syntax_is_build(tree, p, syntax_child(tree, id, 1)):
        if member == "mode": return 3
        if member == "debug":
            syntax_fail(p, tree[id].pos, "`$build` has `mode` ('debug' or 'release'), not `debug`: test `$build.mode =? 'debug'`", false)
            return -1
        syntax_fail(p, tree[id].pos, "`$build` has `mode` ('debug' or 'release'), not `{member}`", false)
        return -1
    if not syntax_is_target(tree, p, syntax_child(tree, id, 1)): return -1
    if member == "arch": return 1
    if member == "os": return 2
    -1

syntax_target_field_value = (field: int, target: str, mode: str) -> str:
    if field == 1: return target_arch_of(target)
    if field == 2: return target_os_of(target)
    if field == 3: return mode
    target

syntax_target_literal = (tree: mut DewySyntax[], p: mut SyntaxProblem, id0: int, field: int) -> str:
    id = unwrapped(tree, p, id0)
    if tree[id].kind != .string: return ""
    name = tree[id].text
    at = tree[id].pos
    if field == 3:
        if name != "release" and name != "debug": syntax_fail(p, at, "unknown build mode \"{name}\": `$build.mode` is \"release\" or \"debug\"", false)
        return name
    if field == 1:
        if not (name in target_arches()): syntax_fail(p, at, "unknown processor \"{name}\": `$target.arch` is one of {join(target_arches(), ", ")}", false)
        return name
    if field == 2:
        if not (name in target_oses()): syntax_fail(p, at, "unknown system \"{name}\": `$target.os` is one of {join(target_oses(), ", ")}", false)
        return name
    if not (name in target_names()):
        syntax_fail(p, at, "unknown target \"{name}\": `$target` is one of {join(target_names(), ", ")}", false)
        return name
    if target_os_of(name) == "none" and name != "wasm32" and name != "c89":
        syntax_fail(p, at, "`$target` is a full target name, never \"{name}\" alone (which asks for the current machine): test the processor with `$target.arch =? \"{name}\"`, or name the system too, as \"{name}-linux\"", false)
    name

# (1 true, 0 false, -1 no such condition: the Dewy module's bool | none)
target_fold = (tree: mut DewySyntax[], p: mut SyntaxProblem, id0: int, target: str, mode: str) -> int:
    id = unwrapped(tree, p, id0)
    if len(p.message) > 0: return -1
    kind = tree[id].kind
    if kind == .block and tree[id].text == "():" and syntax_count(tree, id) == 1: return target_fold(tree, p, syntax_child(tree, id, 0), target, mode)
    op = syntax_op(tree, id)
    if kind == .prefix and op == .kw_not:
        inner = target_fold(tree, p, syntax_child(tree, id, 1), target, mode)
        if inner < 0: return -1
        return 1 - inner
    if kind != .binary: return -1
    if op == .kw_and or op == .kw_or:
        left = target_fold(tree, p, syntax_child(tree, id, 1), target, mode)
        if left < 0: return -1
        right = target_fold(tree, p, syntax_child(tree, id, 2), target, mode)
        if right < 0: return -1
        if op == .kw_and: return left & right
        return left | right
    inverted = tree[syntax_child(tree, id, 0)].kind == .inverted_comparison or op == .not_eq or op == .not_contains
    left = syntax_child(tree, id, 1)
    right = syntax_child(tree, id, 2)
    found = false
    if op == .eq or op == .not_eq:
        if syntax_target_field(tree, p, right) >= 0:
            right = left
            left = syntax_child(tree, id, 2)
        field = syntax_target_field(tree, p, left)
        if field < 0 or len(p.message) > 0: return -1
        name = syntax_target_literal(tree, p, right, field)
        if len(name) == 0 or len(p.message) > 0: return -1
        found = name == syntax_target_field_value(field, target, mode)
    else if op == .contains or op == .not_contains:
        field = syntax_target_field(tree, p, left)
        if field < 0 or len(p.message) > 0: return -1
        list = unwrapped(tree, p, right)
        if tree[list].kind != .block or tree[list].text != "[]:": return -1
        loop entry in syntax_children(tree, list):
            name = syntax_target_literal(tree, p, entry, field)
            if len(name) == 0 or len(p.message) > 0: return -1
            if name == syntax_target_field_value(field, target, mode): found = true
    else: return -1
    if inverted: found = not found
    if found: return 1
    0

syntax_target_condition = (tree: mut DewySyntax[], p: mut SyntaxProblem, id: int, target: str, mode: str) -> int: target_fold(tree, p, id, target, mode)

syntax_target_live = (tree: mut DewySyntax[], p: mut SyntaxProblem, id0: int, target: str, mode: str) -> int:
    id = unwrapped(tree, p, id0)
    if tree[id].kind != .flow: return -1
    loop arm in syntax_children(tree, id):
        if tree[arm].kind != .keyword_expr: return arm
        if tree[syntax_child(tree, arm, 0)].text != "if" or syntax_count(tree, arm) != 3: return -1
        fold = target_fold(tree, p, syntax_child(tree, arm, 1), target, mode)
        if fold < 0: return -1
        if fold == 1: return syntax_child(tree, arm, 2)
    0

syntax_setting_place = (tree: mut DewySyntax[], p: mut SyntaxProblem, id0: int) -> bool:
    id = unwrapped(tree, p, id0)
    if syntax_is_target(tree, p, id) or syntax_is_build(tree, p, id): return true
    syntax_op(tree, id) == .dot and syntax_count(tree, id) == 3 and (syntax_is_build(tree, p, syntax_child(tree, id, 1)) or syntax_is_target(tree, p, syntax_child(tree, id, 1)))

syntax_setting_text = (tree: mut DewySyntax[], p: mut SyntaxProblem, id0: int) -> str:
    id = unwrapped(tree, p, id0)
    if syntax_is_target(tree, p, id): return "$target"
    if syntax_is_build(tree, p, id): return "$build"
    base = "$target"
    if syntax_is_build(tree, p, syntax_child(tree, id, 1)): base = "$build"
    "{base}.{name_of(tree, p, syntax_child(tree, id, 2))}"

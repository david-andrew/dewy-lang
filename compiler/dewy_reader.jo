rd_dc_body = (p: mut ParserContext, nodes: mut Node[]) -> int: rt_dc_body()
rd_dc_flush_report = (p: mut ParserContext): rt_dc_flush_report()
rd_dc_report = (p: mut ParserContext, pos: int, msg: str): rt_dc_report(pos, msg)
rd_dc_unread = (p: mut ParserContext, at: int): rt_dc_unread(at)
rd_dn_edits_clear = (p: mut ParserContext, mark: int = 0): rt_dn_edits_clear(mark)
rd_dn_statement = (p: mut ParserContext, nodes: mut Node[], top: bool = false) -> int: rt_dn_statement(top)

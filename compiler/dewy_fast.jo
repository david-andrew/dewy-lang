# In-process Dewy frontend. Value expressions construct compact AST nodes;
# unmigrated grammar uses the syntax projection. Unsupported syntax is an error.
use 'util.jo'
use 'lex.jo'
use 'ast.jo'
use 'dewy_parse.jo'
use 'dewy_tokens.jo'
use 'dewy_direct.jo'

struct DewyLexeme:
    kind: DewyKind
    name: i32
    start: int
    stop: int
    space: bool
    newline: bool
    symbol: DewyToken = .none

dn_tokens: DewyLexeme[]
dn_at = 0
dn_file = 0
dn_angles = 0
dn_depth = 0
# Set while an assertion directive parses its condition: the directive owns
# the top-level comma that separates the condition from its message.
dn_comma_stop = false

# Like the implementation-language lexer, classify interned words by ID. Names
# added after this table cannot be keywords; formatting keeps its noninterning
# path so editing a document does not grow the compiler's persistent name pool.
dn_word_tokens: DewyToken[]
dn_true_id = 0
dn_false_id = 0
dn_is_id = 0
dn_isnt_id = 0
dn_in_id = 0
dn_notin_id = 0

dn_init_words = ():
    dn_true_id = intern("true")
    dn_false_id = intern("false")
    dn_is_id = intern("is")
    dn_isnt_id = intern("isnt")
    dn_in_id = intern("in")
    dn_notin_id = intern("notin")
    words = ["as", "and", "break", "const", "continue", "else", "from", "import", "if", "in", "let", "loop", "match", "not", "of", "or", "or_throw", "return", "test", "transmute", "xor"]
    loop word in words: intern(word)
    dn_word_tokens = fill(DewyToken.none, names.len())
    loop word in words: dn_word_tokens[intern(word)] = dn_token_kind(word)

dn_error = (offset: int, message: str) -> int:
    fatal(mkpos(dn_file, offset), message)
    0

dn_ident_start = (c: u8) -> bool: is_alpha(c) or c == '_' or c >= 128
dn_ident_part = (c: u8) -> bool: dn_ident_start(c) or is_digit(c)

dn_quote_width = (source: str, start: int, stop: int) -> int:
    if start + 2 < stop and source[start + 1] == source[start] and source[start + 2] == source[start]: return 3
    1

# Find a closing interpolation brace, skipping nested strings and comments.
# Both token scanning and string construction use this, including unsaved text.
dn_interpolation_end = (source: str, start: int, stop: int, nesting: int, allow_incomplete: bool = false) -> int:
    i = start
    depth = 1
    loop i < stop:
        c = source[i]
        if c == '#' and i + 1 < stop and source[i + 1] == '{':
            e = dewy_block_comment_end(source, i, stop)
            if e < 0:
                if allow_incomplete: return -1
                return dn_block_comment_error(i)
            i = e
            continue
        if c == '#':
            loop i < stop and source[i] != '\n': i += 1
            continue
        if c == 'r' and i + 1 < stop and (source[i + 1] == '"' or source[i + 1] == '\'') and (i == start or not dn_ident_part(source[i - 1])):
            i = dn_quote_end(source, i + 1, stop, nesting, true, allow_incomplete)
            if i < 0: return -1
            continue
        if c == '"' or c == '\'':
            i = dn_quote_end(source, i, stop, nesting, false, allow_incomplete)
            if i < 0: return -1
            continue
        if c == '{': depth += 1
        else if c == '}':
            depth -= 1
            if depth == 0: return i
        i += 1
    if allow_incomplete: return -1
    dn_error(start, "unterminated string interpolation")

# Skip a quoted token, including nested quoted strings inside interpolation.
dn_quote_end = (source: str, start: int, stop: int, nesting: int = 0, raw: bool = false, allow_incomplete: bool = false) -> int:
    if nesting >= 256:
        if allow_incomplete: return -1
        return dn_error(start, "string interpolation is nested too deeply")
    quote = source[start]
    width = dn_quote_width(source, start, stop)
    i = start + width
    loop i < stop:
        c = source[i]
        if not raw and c == '\\': i += 2; continue
        if c == quote:
            if width == 1: return i + 1
            if i + 2 < stop and source[i + 1] == quote and source[i + 2] == quote: return i + 3
        if not raw and c == '{':
            end = dn_interpolation_end(source, i + 1, stop, nesting + 1, allow_incomplete)
            if end < 0: return -1
            i = end + 1
            continue
        i += 1
    if allow_incomplete: return -1
    dn_error(start, "unterminated string")

dn_block_comment_error = (start: int) -> int:
    dn_error(start, "unterminated block comment: `#\{` needs a matching `\}#` (block comments nest)")

# Block comments seen by the last lexing pass ([start, end) pairs), for layout.
dn_block_comments: int[]

dn_matches = (source: *u8, at: int, stop: int, value: str) -> bool:
    if len(value) > stop - at: return false
    loop i in [0..len(value)):
        if source[at + i] != value[i]: return false
    true

# Dispatch punctuation by its leading byte, trying only relevant longer
# spellings. Canonical token text avoids allocating a string per punctuation.
dn_lex_symbol = (source: *u8, at: int, stop: int) -> DewyToken:
    match source[at]:
        '%':
            if dn_matches(source, at, stop, "%="): return .percent_assign
        '*':
            if dn_matches(source, at, stop, "*="): return .star_assign
        '+':
            if dn_matches(source, at, stop, "+="): return .plus_assign
        '-':
            if dn_matches(source, at, stop, "->"): return .arrow
            if dn_matches(source, at, stop, "-="): return .minus_assign
        '.':
            if at + 1 < stop:
                match source[at + 1]:
                    '%':
                        if dn_matches(source, at, stop, ".%="): return .dot_percent_assign
                        if dn_matches(source, at, stop, ".%"): return .dot_percent
                    '*':
                        if dn_matches(source, at, stop, ".*="): return .dot_star_assign
                        if dn_matches(source, at, stop, ".*"): return .dot_star
                    '+':
                        if dn_matches(source, at, stop, ".+="): return .dot_plus_assign
                        if dn_matches(source, at, stop, ".+"): return .dot_plus
                    '-':
                        if dn_matches(source, at, stop, ".-="): return .dot_minus_assign
                        if dn_matches(source, at, stop, ".-"): return .dot_minus
                    '.':
                        if dn_matches(source, at, stop, "..."): return .ellipsis
                        if dn_matches(source, at, stop, ".."): return .range
                    '/':
                        if dn_matches(source, at, stop, ".//="): return .dot_floor_assign
                        if dn_matches(source, at, stop, "./="): return .dot_slash_assign
                        if dn_matches(source, at, stop, ".//"): return .dot_floor
                        if dn_matches(source, at, stop, "./"): return .dot_slash
                    '<':
                        if dn_matches(source, at, stop, ".<=?"): return .dot_le
                        if dn_matches(source, at, stop, ".<?"): return .dot_lt
                    '=':
                        if dn_matches(source, at, stop, ".=?"): return .dot_eq
                    '>':
                        if dn_matches(source, at, stop, ".>=?"): return .dot_ge
                        if dn_matches(source, at, stop, ".>?"): return .dot_gt
                    '^':
                        if dn_matches(source, at, stop, ".^="): return .dot_power_assign
                        if dn_matches(source, at, stop, ".^"): return .dot_caret
                    'n':
                        if dn_matches(source, at, stop, ".not>=?"): return .dot_not_ge
                        if dn_matches(source, at, stop, ".not<=?"): return .dot_not_le
                        if dn_matches(source, at, stop, ".not=?"): return .dot_not_eq
                        if dn_matches(source, at, stop, ".not>?"): return .dot_not_gt
                        if dn_matches(source, at, stop, ".not<?"): return .dot_not_lt
        '/':
            if dn_matches(source, at, stop, "//="): return .floor_assign
            if dn_matches(source, at, stop, "/="): return .slash_assign
            if dn_matches(source, at, stop, "//"): return .floor
        ':':
            if dn_matches(source, at, stop, ":>"): return .returns
        '<':
            if dn_matches(source, at, stop, "<=?"): return .le
            if dn_matches(source, at, stop, "<<="): return .shl_assign
            if dn_matches(source, at, stop, "<?"): return .lt
            if dn_matches(source, at, stop, "<<"): return .shl
            if dn_matches(source, at, stop, "<|"): return .pipe_left
        '=':
            if dn_matches(source, at, stop, "=>"): return .function
            if dn_matches(source, at, stop, "=?"): return .eq
        '>':
            if dn_matches(source, at, stop, ">=?"): return .ge
            # Nested generic closers before => are >> then =>, not >>= then >.
            if dn_matches(source, at, stop, ">>=") and not dn_matches(source, at, stop, ">>=>"): return .shr_assign
            if dn_matches(source, at, stop, ">?"): return .gt
            if dn_matches(source, at, stop, ">>"): return .shr
        '?':
            if dn_matches(source, at, stop, "??"): return .coalesce
        '^':
            if dn_matches(source, at, stop, "^="): return .power_assign
        '|':
            if dn_matches(source, at, stop, "|>"): return .pipe_right
    dn_single_token(source[at])

# The hot punctuation path needs only two bounded byte loads and a table
# lookup. A negative entry delegates longer spellings to the complete scanner.
# Store width beside the token so scanning does not materialize token text.
dn_classes: u8[]
dn_symbols: i32[]
dn_symbol_widths: int[]
dn_init_symbols = ():
    dn_classes = fill(u8(0), 256)
    loop c in [0..256):
        bits = int(lx_cls[c])
        if is_digit(u8(c)) or c == '_': bits |= 4
        if is_digit(u8(c)) or is_alpha(u8(c)) or c == '_': bits |= 8
        if c == ' ' or c == '\t' or c == '\r' or c == '\n': bits |= 16
        dn_classes[c] = u8(bits)
    dn_symbols = fill(i32(0), 128 * 128)
    dn_symbol_widths = fill(0, int(DewyToken.kw_or_throw) + 1)
    loop i in [1..int(DewyToken.kw_or_throw) + 1):
        text = dn_token_text(DewyToken(i))
        width = len(text)
        dn_symbol_widths[i] = width
        if width == 0 or dn_ident_start(text[0]): continue
        first = int(text[0]) * 128
        if width == 1:
            loop next in [0..128): dn_symbols[first + next] = i32(i)
    loop i in [1..int(DewyToken.kw_or_throw) + 1):
        text = dn_token_text(DewyToken(i))
        if len(text) < 2 or dn_ident_start(text[0]): continue
        slot = int(text[0]) * 128 + int(text[1])
        if len(text) > 2: dn_symbols[slot] = -1
        else if dn_symbols[slot] != -1: dn_symbols[slot] = i32(i)

dn_lex = (file: int, begin: int, stop: int, intern_names: bool = true) -> DewyLexeme[]:
    if intern_names and dn_word_tokens.len() == 0: dn_init_words()
    source = files[file].src
    # Hold the immutable string while scanning its bounded byte span. The
    # guards below are against stop, including interpolation subexpressions.
    assert(begin >= 0 and begin <= stop and stop <= len(source))
    bytes = source.data()
    if lx_cls == null: lx_init_classes()
    if dn_symbols.len() == 0: dn_init_symbols()
    classes = data(dn_classes)
    symbols = data(dn_symbols)
    widths = data(dn_symbol_widths)
    out: DewyLexeme[]
    out.resize((stop - begin) / 2 + 1)
    slots = data(out)
    count = 0
    dn_block_comments = []
    i = begin
    spaced = false
    newline = false
    loop i < stop:
        c = bytes[i]
        if classes[c] & 16 != 0:
            spaced = true
            if c == '\n': newline = true
            i += 1
            loop i < stop:
                c = bytes[i]
                if c == '\n': newline = true
                else if classes[c] & 16 == 0: break
                i += 1
            continue
        if c == '#' and i + 1 < stop and bytes[i + 1] == '{':
            e = dewy_block_comment_end(source, i, stop)
            if e < 0: dn_block_comment_error(i)
            dn_block_comments.push(i)
            dn_block_comments.push(e)
            # (a comment over several lines separates like a line break)
            if find_byte(source[i..e), '\n') >= 0: newline = true
            spaced = true
            i = e
            continue
        if c == '#':
            loop i < stop and bytes[i] != '\n': i += 1
            spaced = true
            continue
        start = i
        kind = DewyKind.op
        symbol = DewyToken.none
        name: i32 = 0
        value = ""
        if c == 'r' and i + 1 < stop and (bytes[i + 1] == '"' or bytes[i + 1] == '\''):
            i = dn_quote_end(source, i + 1, stop, 0, true)
            kind = .rawquoted
        else if classes[c] & 1 != 0:
            i += 1
            loop i < stop and classes[bytes[i]] & 2 != 0: i += 1
            kind = .identifier
            if intern_names:
                id = intern_sub(source, start, i - start)
                name = i32(id)
                if id < dn_word_tokens.len(): symbol = dn_word_tokens[id]
                if id == dn_true_id or id == dn_false_id: kind = .boolean
                if i < stop and bytes[i] == '?':
                    query = DewyToken.none
                    if id == dn_is_id: query = .is_type
                    else if id == dn_isnt_id: query = .isnt_type
                    else if id == dn_in_id: query = .contains
                    else if id == dn_notin_id: query = .not_contains
                    if query != .none:
                        symbol = query
                        kind = .op
                        i += 1
            else:
                value = source[start..i)
                if value == "true" or value == "false": kind = .boolean
                if (value == "is" or value == "isnt" or value == "in" or value == "notin") and i < stop and bytes[i] == '?':
                    value += "?"
                    i += 1
                    kind = .op
        else if c == '$':
            i += 1
            loop i < stop and classes[bytes[i]] & 2 != 0: i += 1
            if i == start + 1: dn_error(start, "expected a name after $")
            kind = .metatag
        else if is_digit(c):
            decimal = true
            digits = start
            if c == '0' and i + 1 < stop and find_byte("btqsodzxug", bytes[i + 1]) >= 0:
                decimal = bytes[i + 1] == 'd'
                i += 2
                digits = i
            if i < stop and (bytes[i] == '"' or bytes[i] == '\''):
                i = dn_quote_end(source, i, stop)
                kind = .based_string
            else:
                mask: u8 = if decimal: 4 else: 8
                loop i < stop and classes[bytes[i]] & mask != 0: i += 1
                if i == digits: dn_error(start, "expected digits after the base prefix")
                kind = if decimal: DewyKind.source_integer else: DewyKind.integer
                if decimal and i + 1 < stop and bytes[i] == '.' and is_digit(bytes[i + 1]):
                    i += 1
                    loop i < stop and classes[bytes[i]] & 4 != 0: i += 1
                    kind = .source_real
                if decimal and i + 1 < stop and (bytes[i] == 'e' or bytes[i] == 'E') and (is_digit(bytes[i + 1]) or bytes[i + 1] == '+' or bytes[i + 1] == '-'):
                    i += 1
                    if i < stop and (bytes[i] == '+' or bytes[i] == '-'): i += 1
                    first = i
                    loop i < stop and classes[bytes[i]] & 4 != 0: i += 1
                    if i == first: dn_error(start, "expected exponent digits")
                    kind = .source_real
        else if c == '"' or c == '\'':
            i = dn_quote_end(source, i, stop)
            kind = .quoted
        else:
            next: u8 = 0
            if start + 1 < stop: next = bytes[start + 1]
            code: i32 = -1
            if c < 128 and next < 128: code = symbols[int(c) * 128 + int(next)]
            if code < 0: symbol = dn_lex_symbol(bytes, start, stop)
            else: symbol = DewyToken(code)
            if symbol == .none: dn_error(start, "unexpected character in Dewy source")
            i += widths[int(symbol)]
        if not intern_names and symbol == .none and (kind == .op or kind == .identifier): symbol = dn_token_kind(value)
        if count == out.len():
            out.resize(out.len() * 2)
            slots = data(out)
        slots[count].kind = kind
        slots[count].name = name
        slots[count].start = start
        slots[count].stop = i
        slots[count].space = spaced
        slots[count].newline = newline
        slots[count].symbol = symbol
        count += 1
        spaced = false
        newline = false
    out.truncate(count)
    out.push(DewyLexeme(.eof, 0, stop, stop, spaced, newline))
    out

# Tokens contain only scalar tags, name IDs and source spans. Materialize text
# only when projection needs a literal payload; grammar lookahead copies no
# reference-counted strings. Formatting uses the spans and tags directly.
dn_payload = (token: DewyLexeme) -> str:
    if token.symbol != .none: return dn_token_text(token.symbol)
    if token.name != 0: return name_of(int(token.name))
    source = files[dn_file].src
    first = token.start
    if token.kind == .metatag: return source[first + 1..token.stop)
    if token.kind == .integer:
        return source[first..first + 2) + ":" + source[first + 2..token.stop)
    if token.kind == .based_string:
        return source[first..first + 2) + ":" + source[first + 3..token.stop - 1)
    if (token.kind == .source_integer or token.kind == .source_real) and first + 1 < token.stop and source[first] == '0' and source[first + 1] == 'd': first += 2
    source[first..token.stop)

dn_peek = () -> DewyToken: dn_tokens[dn_at].symbol
dn_take = () -> DewyLexeme:
    value = dn_tokens[dn_at]
    dn_at += 1
    value

dn_accept = (symbol: DewyToken) -> bool:
    if dn_peek() != symbol: return false
    dn_at += 1
    true

dn_expect = (symbol: DewyToken):
    if not dn_accept(symbol): dn_error(dn_tokens[dn_at].start, "expected '{dn_token_text(symbol)}'")

dn_node = (kind: DewyKind, text: str, offset: int, children: int[] = [], name: i32 = 0) -> int:
    id = dewy_syntax.len()
    dewy_syntax.push(DewySyntax(kind, text, mkpos(dn_file, offset), children, .none, name))
    id

# Expression operators are scalar tags on their parent node. Child zero is
# the shared ordinary/inverted sentinel; operands retain indices one onward.
dn_op_node = (kind: DewyKind, symbol: DewyToken, offset: int, children: int[]) -> int:
    id = dewy_syntax.len()
    dewy_syntax.push(DewySyntax(kind, "", mkpos(dn_file, offset), children, symbol))
    id

dn_operator = (kind: DewyKind, op: DewyToken, left: int, right: int) -> int:
    scalar = dn_token_uninvert(op)
    sentinel = if scalar != op: 1 else: 0
    if kind == .binary:
        id = dewy_syntax.len()
        dewy_syntax.push(DewySyntax(kind, "", dewy_syntax[left].pos, [], scalar, 0, sentinel + 1, left, right))
        return id
    dn_op_node(kind, scalar, pos_off(dewy_syntax[left].pos), [sentinel, left, right])

# The supported precedence follows Dewy's user-facing operators. A whitespace
# boundary between values ends an element; applications use adjacent brackets.
dn_power = (op: DewyToken) -> int:
    match op:
        assign, plus_assign, minus_assign, star_assign, slash_assign, power_assign, floor_assign, percent_assign, shl_assign, shr_assign, dot_plus_assign, dot_minus_assign, dot_star_assign, dot_slash_assign, dot_power_assign, dot_floor_assign, dot_percent_assign: 10
        arrow: 20
        function: 30
        returns: 40
        colon: 45
        kw_or_throw: 48
        kw_as, kw_transmute: 50
        kw_or: 60
        kw_xor: 65
        kw_and: 70
        eq, not_eq, lt, not_lt, gt, not_gt, le, not_le, ge, not_ge, is_type, isnt_type, contains, not_contains, dot_eq, dot_not_eq, dot_lt, dot_not_lt, dot_gt, dot_not_gt, dot_le, dot_not_le, dot_ge, dot_not_ge: 80
        coalesce: 82
        pipe: 85
        amp: 90
        kw_in: 95
        range: 100
        comma: 105
        shl, shr: 110
        plus, minus, dot_plus, dot_minus: 120
        star, slash, floor, percent, dot_star, dot_slash, dot_floor, dot_percent: 130
        caret, dot_caret: 140
        _: 0

dn_can_start = () -> bool:
    t = dn_tokens[dn_at]
    if t.kind == .eof: return false
    if (t.symbol == .rparen or t.symbol == .rbrack or t.symbol == .rbrace or t.symbol == .rangle or t.symbol == .shr or t.symbol == .kw_else or t.symbol == .semi or t.symbol == .comma): return false
    true

dn_range_bound = () -> bool:
    if not dn_can_start(): return false
    symbol = dn_peek()
    if (symbol == .lbrace or symbol == .kw_let or symbol == .kw_const or symbol == .kw_return or symbol == .kw_break or symbol == .kw_continue or symbol == .kw_if or symbol == .kw_loop or symbol == .kw_match): return false
    dn_power(symbol) == 0 or symbol == .plus or symbol == .minus

# Static Unicode scalar escapes: four hex digits, or one to six in braces.
dn_unicode_escape = (source: str, start: int, stop: int) -> (int, int):
    i = start + 1
    braced = i < stop and source[i] == '{'
    if braced: i += 1
    first = i
    value = 0
    loop i < stop:
        if braced and source[i] == '}': break
        if not braced and i - first == 4: break
        digit = hexval(source[i])
        if digit < 0: return (dn_error(i, "expected hexadecimal digits in Unicode escape"), i)
        if i - first >= 6: return (dn_error(start, "Unicode escape has too many digits"), i)
        value = value * 16 + digit
        i += 1
    if braced:
        if i == first or i >= stop or source[i] != '}': return (dn_error(start, "expected 1–6 hex digits and '}' in Unicode escape"), i)
        i += 1
    else if i - first != 4: return (dn_error(start, "Unicode escape needs four hex digits"), i)
    if value > 0x10FFFF or (value >= 0xD800 and value <= 0xDFFF): return (dn_error(start, "Unicode escape must name a scalar value, not a surrogate or out-of-range code point"), i)
    (value, i)

dn_string = (token: DewyLexeme) -> int:
    source = files[dn_file].src
    raw = token.kind == .rawquoted
    opening = token.start
    if raw: opening += 1
    width = dn_quote_width(source, opening, token.stop)
    i = opening + width
    stop = token.stop - width
    if raw: return dn_node(.string, source[i..stop), token.start)
    chunks: int[]
    bytes_: u8[]
    chunk_start = i
    interpolated = false
    loop i < stop:
        c = source[i]
        if c == '\\':
            i += 1
            if i >= stop: dn_error(i, "incomplete string escape")
            c = source[i]
            if c == 'n': bytes_.push(10)
            else if c == 'r': bytes_.push(13)
            else if c == 't': bytes_.push(9)
            else if c == '0': bytes_.push(0)
            else if c == 'a': bytes_.push(7)
            else if c == 'b': bytes_.push(8)
            else if c == 'v': bytes_.push(11)
            else if c == 'f': bytes_.push(12)
            else if c == '\n': pass
            else if c == '\r' and i + 1 < stop and source[i + 1] == '\n': i += 1
            else if c == 'u' or c == 'U':
                scalar = dn_unicode_escape(source, i, stop)
                loop byte in chr(scalar.0): bytes_.push(byte)
                i = scalar.1
                continue
            else if c == '\\' or c == '"' or c == '\'' or c == '{' or c == '}': bytes_.push(c)
            else: dn_error(i, "unsupported string escape")
            i += 1
            continue
        if c == '{':
            interpolated = true
            if bytes_.len() > 0:
                chunks.push(dn_node(.string_chunk, str_from_bytes(bytes_), chunk_start))
                bytes_.clear()
            first = i + 1
            i = dn_interpolation_end(source, first, stop, 0)
            saved_tokens = dn_tokens
            saved_at = dn_at
            saved_angles = dn_angles
            saved_comma = dn_comma_stop
            dn_tokens = dn_lex(dn_file, first, i)
            dn_at = 0
            dn_angles = 0
            dn_comma_stop = false
            expression = dn_expr(0)
            if dn_tokens[dn_at].kind != .eof: dn_error(dn_tokens[dn_at].start, "expected one interpolation expression")
            dn_tokens = saved_tokens
            dn_at = saved_at
            dn_angles = saved_angles
            dn_comma_stop = saved_comma
            chunks.push(dn_node(.block, "{{}}:", first, [expression]))
            i += 1
            chunk_start = i
            continue
        bytes_.push(c)
        i += 1
    if not interpolated: return dn_node(.string, str_from_bytes(bytes_), token.start)
    if bytes_.len() > 0: chunks.push(dn_node(.string_chunk, str_from_bytes(bytes_), chunk_start))
    dn_node(.interpolated_string, "", token.start, chunks)

# A right operand in parentheses supplies a unary function. Operators with
# prefix meanings remain ordinary expressions: (-1) is still negation.
dn_partial_operator = (op: DewyToken) -> bool:
    match op:
        eq, not_eq, lt, not_lt, gt, not_gt, le, not_le, ge, not_ge, is_type, isnt_type, contains, not_contains, dot, kw_as, kw_transmute, star, slash, floor, percent, caret: true
        _: false

dn_partial = (opening: DewyLexeme) -> int:
    # Reuse the just-consumed opening token as a synthetic left operand. This
    # preserves normal precedence without inserting/shifting the token array
    # or adding work to the ordinary expression loop. Restore it after parsing.
    slot = dn_at - 1
    name = "$partial"
    id = i32(intern(name))
    dn_tokens[slot] = DewyLexeme(.identifier, id, opening.start, opening.stop, opening.space, opening.newline)
    dn_at = slot
    saved_angles = dn_angles
    dn_angles = 0
    body = dn_expr(0)
    dn_angles = saved_angles
    dn_tokens[slot] = opening
    dn_expect(.rparen)
    parameter = dn_node(.identifier, name, opening.start, name = id)
    params = dn_node(.block, "():", opening.start, [parameter])
    fn = dn_operator(.binary, .function, params, body)
    dn_node(.block, "():", opening.start, [fn])

# Brackets start a fresh comma context, even inside an assertion condition.
dn_block = () -> int:
    # Square brackets may define record function fields. Their sibling scope
    # is established during projection, after all field names are known.
    direct = dc_enabled
    if dn_peek() == .lbrack: dc_enabled = false
    saved = dn_comma_stop
    dn_comma_stop = false
    block = dn_bracketed()
    dn_comma_stop = saved
    dc_enabled = direct
    block

dn_bracketed = () -> int:
    opening = dn_take()
    if opening.symbol == .lparen:
        op = dn_peek()
        if dn_partial_operator(op) or (op == .kw_not and dn_at + 1 < dn_tokens.len() and dn_token_invert(dn_tokens[dn_at + 1].symbol) != .none): return dn_partial(opening)
    if opening.symbol == .langle: dn_angles += 1
    close = if opening.symbol == .lparen: DewyToken.rparen else if opening.symbol == .lbrack: DewyToken.rbrack else if opening.symbol == .langle: DewyToken.rangle else: DewyToken.rbrace
    children: int[]
    loop true:
        if dn_tokens[dn_at].kind == .eof: dn_error(opening.start, "expected '{dn_token_text(close)}' before end of file")
        # Split adjacent generic closers, assignments and optional suffixes.
        # Consume one angle at a time, leaving the rest for its parent.
        # A spaced ` >? ` stays a comparison inside a refinement.
        if close == .rangle and ((dn_peek() == .shr or dn_peek() == .shr_assign or dn_peek() == .angle_assign) or (dn_peek() == .gt and not dn_tokens[dn_at].space)):
            dn_tokens[dn_at].start += 1
            tail = dn_tokens[dn_at]
            dn_tokens[dn_at].symbol = dn_token_kind(files[dn_file].src[tail.start..tail.stop))
            break
        if dn_accept(close): break
        if ((opening.symbol == .lbrack and dn_peek() == .rparen) or (opening.symbol == .lparen and dn_peek() == .rbrack)) and children.len() == 1 and dw_op(children[0]) == .range_apply:
            close = dn_peek()
            dn_at += 1
            break
        before = dn_at
        children.push(if opening.symbol == .lbrace: dn_statement() else: dn_stmt())
        if dn_at == before: dn_error(dn_tokens[dn_at].start, "expected a block element")
    if opening.symbol == .langle: dn_angles -= 1
    label = dn_token_text(opening.symbol) + dn_token_text(close) + ":"
    dn_node(.block, label, opening.start, children)

dn_flow = () -> int:
    start = dn_tokens[dn_at].start
    arms: int[]
    loop true:
        keyword = dn_take()
        key = dn_node(.keyword, dn_token_text(keyword.symbol), keyword.start)
        condition = if keyword.symbol == .kw_loop: dn_expr(0) else: dn_value(0)
        if not dn_can_start(): dn_error(dn_tokens[dn_at].start, "expected a body after '{dn_token_text(keyword.symbol)}'")
        body = dn_expr(0)
        arms.push(dn_node(.keyword_expr, "", keyword.start, [key, condition, body]))
        if not dn_accept(.kw_else): break
        if dn_peek() == .kw_if or dn_peek() == .kw_match: continue
        arms.push(dn_expr(0))
        break
    dn_node(.flow, "", start, arms)

# Directive forms with their own argument grammar, as `if` and `return` have:
# 1 takes a condition and an optional message, 2 only an optional message and
# 3 nothing. Other metatags stay single tokens: labels, settings, `$capture`.
dn_directive_form = (name: str) -> int:
    if name == "assert" or name == "runtime_assert" or name == "expect" or name == "unsafe_assume": return 1
    if name == "fail": return 2
    if name == "breakpoint": return 3
    0

# Children: the condition, the message and the condition's source text (each
# 0 when absent). The text gives a failed check its default description.
dn_directive = (token: DewyLexeme, form: int) -> int:
    dn_at += 1
    name = dn_payload(token)
    next = dn_tokens[dn_at]
    present = not next.newline and dn_can_start()
    if form == 3 or not present:
        if form == 1: return dn_error(token.start, "`${name}` needs a condition: `${name} condition` or `${name} condition, \"message\"`")
        return dn_node(.directive, name, token.start, [0, 0, 0])
    saved = dn_comma_stop
    dn_comma_stop = true
    condition = 0
    text = 0
    message = 0
    if form == 1:
        # `$assert(condition, "message")`: an adjacent group is the argument
        # list, as for other directives, with the same comma.
        listed = next.symbol == .lparen and not next.space
        if listed: dn_at += 1
        first = dn_tokens[dn_at].start
        condition = dn_expr(0)
        text = dn_node(.string, files[dn_file].src[first..dn_tokens[dn_at - 1].stop), first)
        if dn_accept(.comma): message = dn_expr(0)
        if listed: dn_expect(.rparen)
    else: message = dn_expr(0)
    dn_comma_stop = saved
    dn_node(.directive, name, token.start, [condition, message, text])

dn_atom = () -> int:
    token = dn_tokens[dn_at]
    symbol = token.symbol
    if token.kind == .eof: return dn_error(token.start, "expected an expression")
    if token.kind == .metatag:
        form = dn_directive_form(dn_payload(token))
        if form != 0: return dn_directive(token, form)
    if symbol == .lparen or symbol == .lbrack or symbol == .lbrace or symbol == .langle: return dn_block()
    if symbol == .kw_if or symbol == .kw_loop or symbol == .kw_match: return dn_flow()
    if (symbol == .kw_let or symbol == .kw_const or symbol == .kw_return or symbol == .kw_break or symbol == .kw_continue or symbol == .kw_import or symbol == .kw_from): return dn_stmt()
    dn_at += 1
    if token.kind == .quoted or token.kind == .rawquoted: return dn_string(token)
    if (symbol == .tilde or symbol == .plus or symbol == .minus or symbol == .dot_plus or symbol == .dot_minus or symbol == .at or symbol == .kw_not):
        power = 125
        # A reference covers the full postfix place: @point.x, @items[i].x.
        if symbol == .at: power = 160
        if symbol == .kw_not: power = 75
        return dn_op_node(.prefix, symbol, token.start, [0, dn_expr(power)])
    if symbol == .range:
        dots = dn_node(.identifier, "..", token.start)
        if not dn_range_bound(): return dots
        bound = dn_expr(101)
        return dn_op_node(.flat, .range_apply, token.start, [0, dots, bound])
    text = dn_payload(token)
    if text == "type" and dn_accept(.kw_of):
        return dn_op_node(.prefix, .kw_of, token.start, [0, dn_expr(91)])
    if token.kind == .op: return dn_error(token.start, "expected an expression, found '{text}'")
    dn_node(token.kind, text, token.start, name = token.name)

dn_expr = (minimum: int) -> int:
    dn_depth += 1
    if dn_depth > 256: return dn_error(dn_tokens[dn_at].start, "expression is nested too deeply")
    left = dn_atom()
    loop true:
        token = dn_tokens[dn_at]
        op = token.symbol
        if token.kind == .eof: break
        if token.newline and dn_power(op) == 0 and op != .kw_not: break
        if dn_angles > 0 and ((op == .shr or op == .shr_assign or op == .angle_assign) or (op == .gt and not token.space)): break
        if op == .kw_or_throw and minimum <= 48:
            dn_at += 1
            left = dn_op_node(.postfix, .kw_or_throw, pos_off(dewy_syntax[left].pos), [0, left])
            continue
        if op == .ellipsis and minimum <= 170:
            dn_at += 1
            left = dn_op_node(.postfix, .ellipsis, pos_off(dewy_syntax[left].pos), [0, left])
            continue
        # Literal coefficients are unambiguous: 2x and 2(x + 1). General
        # adjacent names remain separate arguments or block elements.
        if not token.space and minimum <= 135 and (dw_integer_kind(dewy_syntax[left].kind) or dewy_syntax[left].kind == .source_real) and (token.kind == .identifier or op == .lparen):
            left = dn_operator(.binary, .multiply_apply, left, dn_expr(136))
            continue
        if op == .dot and minimum <= 170:
            dn_at += 1
            if dn_peek() == .lparen and not dn_tokens[dn_at].space:
                left = dn_operator(.binary, .broadcast_call, left, dn_block())
                continue
            right = dn_take()
            if right.kind == .metatag and dn_payload(right) == "field":
                member = dn_node(.metatag, "field", right.start)
                if dn_peek() != .lparen: return dn_error(right.start, "expected `$field(name)`")
                member = dn_operator(.binary, .call, member, dn_block())
                left = dn_operator(.binary, .dot, left, member)
                continue
            if right.kind == .metatag and dw_designed_directive(dn_payload(right)): return dn_error(right.start, "`${dn_payload(right)}` is part of the design but not implemented yet")
            if right.kind != .identifier: return dn_error(right.start, "expected a member name")
            left = dn_operator(.binary, .dot, left, dn_node(.identifier, dn_payload(right), right.start, name = right.name))
            continue
        if not token.space and (op == .lparen or op == .lbrack) and minimum <= 170:
            right = dn_block()
            label = if op == .lparen: DewyToken.call else: DewyToken.index
            left = dn_operator(.binary, label, left, right)
            continue
        if not token.space and (token.kind == .quoted or token.kind == .rawquoted) and minimum <= 170:
            dn_at += 1
            left = dn_operator(.binary, .call, left, dn_string(token))
            continue
        if not token.space and op == .langle and minimum <= 160:
            left = dn_operator(.binary, .type_apply, left, dn_block())
            continue
        if op == .question and minimum <= 140:
            dn_at += 1
            left = dn_op_node(.postfix, .question, pos_off(dewy_syntax[left].pos), [0, left])
            continue
        # An inverted comparison may be written with a space after `not`.
        if op == .kw_not and dn_at + 1 < dn_tokens.len():
            inverted = dn_token_invert(dn_tokens[dn_at + 1].symbol)
            if inverted != .none:
                op = inverted
                token.stop = dn_tokens[dn_at + 1].stop
        if op == .comma and dn_comma_stop: break
        power = dn_power(op)
        if power == 0 or power < minimum: break
        if (op == .plus or op == .minus) and token.space and not dn_tokens[dn_at + 1].space: break
        dn_at += 1
        if token.symbol == .kw_not: dn_at += 1
        if op == .range:
            parts = [0, left, dn_node(.identifier, "..", token.start)]
            if dn_range_bound(): parts.push(dn_expr(power + 1))
            left = dn_op_node(.flat, .range_apply, pos_off(dewy_syntax[left].pos), parts)
            continue
        value_rhs = dn_token_assignment(op) or (op == .assign and dw_name(left) != "")
        right = if value_rhs: dn_value(power + 1) else: dn_expr(if op == .function or op == .caret or op == .dot_caret or op == .coalesce: power else: power + 1)
        if op == .comma:
            parts: int[]
            if dw_op(left) == .comma: parts = dw_children(left)
            else: parts = [0, left]
            parts.push(right)
            left = dn_op_node(.flat, .comma, pos_off(dewy_syntax[left].pos), parts)
        else: left = dn_operator(.binary, op, left, right)
    dn_depth -= 1
    left

dn_stmt = () -> int:
    token = dn_tokens[dn_at]
    word = dn_token_text(token.symbol)
    symbol = token.symbol
    result = 0
    # Contextual keyword: ordinary bindings/calls named `test` still work.
    if symbol == .kw_test and dn_tokens[dn_at + 1].space and (dn_tokens[dn_at + 1].kind == .quoted or dn_tokens[dn_at + 1].kind == .rawquoted) and not dn_tokens[dn_at + 1].newline:
        dn_at += 1
        name = dn_string(dn_take())
        if dewy_syntax[name].kind != .string: return dn_error(token.start, "a test name must be a constant string")
        if dn_peek() != .lbrace: return dn_error(dn_tokens[dn_at].start, "expected '{{' after the test name")
        result = dn_node(.keyword_expr, "", token.start, [dn_node(.keyword, word, token.start), name, dn_block()])
    else if (symbol == .kw_let or symbol == .kw_const or symbol == .kw_return or symbol == .kw_break or symbol == .kw_continue or symbol == .kw_import or symbol == .kw_from):
        dn_at += 1
        parts = [dn_node(.keyword, word, token.start)]
        if symbol != .kw_break and symbol != .kw_continue:
            if symbol != .kw_return or (dn_can_start() and not dn_tokens[dn_at].newline): parts.push(if symbol == .kw_return: dn_value(0) else: dn_expr(0))
        else if dn_tokens[dn_at].kind == .metatag and not dn_tokens[dn_at].newline:
            parts.push(dn_atom())
        if symbol == .kw_from:
            keyword = dn_tokens[dn_at]
            dn_expect(.kw_import)
            parts.push(dn_node(.keyword, "import", keyword.start))
            parts.push(dn_expr(0))
        result = dn_node(.keyword_expr, "", token.start, parts)
    else: result = dn_expr(0)
    if dn_accept(.semi): result = dn_operator(.binary, .statement_end, result, 0)
    result

dewy_fast_file = (file: int) -> int[]:
    dw_bigint_import = 0
    dc_enabled = (env("DEWY_FRONTEND") ?? "") != "old"
    dc_compare = (env("DEWY_FRONTEND") ?? "") == "compare"
    dn_file = file
    dn_tokens = dn_lex(file, 0, len(files[file].src))
    dn_at = 0
    dn_angles = 0
    dn_depth = 0
    dewy_syntax = [DewySyntax(), DewySyntax(.inverted_comparison)]
    declarations: int[]
    loop dn_tokens[dn_at].kind != .eof:
        before = dn_at
        syntax = dn_statement(true)
        loop declaration in dw_top_declarations(syntax): declarations.push(declaration)
        # Projection owns the retained data in the compact AST. Discard each
        # declaration's temporary syntax before parsing the next declaration.
        dewy_syntax.truncate(2)
        if dn_at == before: dn_error(dn_tokens[dn_at].start, "expected a declaration")
    dn_tokens = []
    dewy_syntax = []
    dw_finish_declarations(declarations)

use 'lazy_bodies.jo'
# In-process Dewy frontend. Value expressions construct compact AST nodes;
# unmigrated grammar uses the syntax projection. Unsupported syntax is an error.
use 'util.jo'
use 'lex.jo'
use 'parse.jo'
use 'ast.jo'
use 'dewy_parse.jo'
use 'oom.jo'
use 'proofs.jo'
use 'dewy_tokens.dewy'
use 'dewy_syntax.dewy'
use 'dewy_grammar.dewy'
use 'dewy_direct.jo'
use 'dewy_directives.jo'
use 'directives.jo'
use 'dewy_ffi.jo'
use 'literals.dewy'
use 'dewy_lex.dewy'

dn_tokens: DewyLexeme[]
dn_at = 0
dn_file = 0
dn_angles = 0
dn_depth = 0
# Set while an assertion directive parses its condition: the directive owns
# the top-level comma that separates the condition from its message.
dn_comma_stop = false

# Like the implementation-language lexer, classify interned words by ID. Names
# added after this table cannot be keywords; formatting keeps its noninterning
# path so editing a document does not grow the compiler's persistent name pool.
dn_word_tokens: DewyToken[]
dn_true_id = 0
dn_false_id = 0
dn_is_id = 0
dn_isnt_id = 0
dn_in_id = 0
dn_no_id = 0
dn_end_id = 0
dn_type_id = 0
dn_none_id = 0
dn_new_id = 0
dn_void_id = 0

# Reserved words cannot be bound; the reference grammar reports them.
dn_reserved_words: bool[]
dn_reserved = (name: int) -> bool: name < dn_reserved_words.len() and dn_reserved_words[name]

dn_init_words = ():
    dn_no_id = intern("no")
    dn_end_id = intern("end")
    dn_type_id = intern("type")
    dn_none_id = intern("none")
    dn_new_id = intern("new")
    dn_void_id = intern("void")
    dn_reserved_words = fill(false, names.len())
    loop word in [dn_end_id, dn_new_id, dn_none_id, dn_void_id]: dn_reserved_words[word] = true
    dn_true_id = intern("true")
    dn_false_id = intern("false")
    dn_is_id = intern("is")
    dn_isnt_id = intern("isnt")
    dn_in_id = intern("in")
    words = ["as", "and", "break", "const", "continue", "else", "from", "import", "if", "in", "let", "loop", "parallel", "concurrent", "spawn", "match", "not", "of", "or", "or_throw", "return", "test", "transmute", "xor", "nand", "nor", "xnor"]
    loop word in words: intern(word)
    dn_word_tokens = fill(DewyToken.none, names.len())
    loop word in words: dn_word_tokens[intern(word)] = dn_token_kind(word)

# (above 0: parsing the expression of a string interpolation)
dn_in_interpolation = 0
DN_BRACE_HINT = "`\{...}` in a string holds an expression: write `\\\{` and `\\\}` for literal braces, or use a raw string `r\"...\"`"

dn_error = (offset: int, message: str) -> int:
    if dn_in_interpolation > 0: fatal(mkpos(dn_file, offset), "{message}, inside a string interpolation ({DN_BRACE_HINT}; `format(value \".2f\")` formats a number)")
    fatal(mkpos(dn_file, offset), message)
    0

# The scanners' state (dewy_lex.dewy): the braces a string's mistake notes, and the mistake
dn_lexer = DewyLexer(-1, -1, "", -1, -1)

# Block comments seen by the last lexing pass ([start, end) pairs), for layout.
dn_block_comments: int[]

# (metatag tokens lexed since the count was reset: a source without any holds no settings)
dn_metatags = 0

# A library module's function bodies (`=> {...}` outside any bracket) lexed as one lazy_body
# token each, its braces included: their bytes are skipped, not tokenized (dewy_direct.jo's
# dc_lib_lazy). A body with what parsing must see at once (dewy_lex.dewy dx_lazy_end) is lexed.
dn_skip_bodies = false

# the lexer's mistake (dewy_lex.dewy), reported
dn_lex_problem = () -> int:
    if dn_lexer.note_at >= 0:
        err_notes.push((mkpos(dn_file, dn_lexer.note_at), "note: this `\{` starts a string interpolation; for a literal brace write `\\\{`"))
    dn_error(dn_lexer.problem_at, dn_lexer.problem)

# (a closing interpolation brace: dewy_lex.dewy dn_interpolation_end)
dn_interpolation_close = (source: str, start: int, stop: int) -> int:
    e = dn_interpolation_end(dn_lexer, source, start, stop, 0, false)
    if e < 0: dn_lex_problem()
    e

# (the end of the quoted string at start in the bytes being lexed: dewy_lex.dewy dx_quote_end)
dn_quote_close = (bytes: *u8, start: int, stop: int, raw: bool) -> int:
    e = dx_quote_end(dn_lexer, bytes, start, stop, 0, raw, false)
    if e < 0: dn_lex_problem()
    e

dn_ident_start = (c: u8) -> bool: is_alpha(c) or c == '_' or c >= 128
dn_ident_part = (c: u8) -> bool: dn_ident_start(c) or is_digit(c)

dn_matches = (source: *u8, at: int, stop: int, value: str) -> bool:
    if len(value) > stop - at: return false
    loop i in [0..len(value)):
        if source[at + i] != value[i]: return false
    true

# Dispatch punctuation by its leading byte, trying only relevant longer
# spellings. Canonical token text avoids allocating a string per punctuation.
dn_lex_symbol = (source: *u8, at: int, stop: int) -> DewyToken:
    match source[at]:
        '%':
            if dn_matches(source, at, stop, "%="): return .percent_assign
        '*':
            if dn_matches(source, at, stop, "*="): return .star_assign
        '+':
            if dn_matches(source, at, stop, "+="): return .plus_assign
        '-':
            if dn_matches(source, at, stop, "->"): return .arrow
            if dn_matches(source, at, stop, "-="): return .minus_assign
        '.':
            if at + 1 < stop:
                match source[at + 1]:
                    '%':
                        if dn_matches(source, at, stop, ".%="): return .dot_percent_assign
                        if dn_matches(source, at, stop, ".%"): return .dot_percent
                    '*':
                        if dn_matches(source, at, stop, ".*="): return .dot_star_assign
                        if dn_matches(source, at, stop, ".*"): return .dot_star
                    '+':
                        if dn_matches(source, at, stop, ".+="): return .dot_plus_assign
                        if dn_matches(source, at, stop, ".+"): return .dot_plus
                    '-':
                        if dn_matches(source, at, stop, ".-="): return .dot_minus_assign
                        if dn_matches(source, at, stop, ".-"): return .dot_minus
                    '.':
                        if dn_matches(source, at, stop, "..."): return .ellipsis
                        if dn_matches(source, at, stop, ".."): return .range
                    '/':
                        if dn_matches(source, at, stop, ".//="): return .dot_floor_assign
                        if dn_matches(source, at, stop, "./="): return .dot_slash_assign
                        if dn_matches(source, at, stop, ".//"): return .dot_floor
                        if dn_matches(source, at, stop, "./"): return .dot_slash
                    '<':
                        if dn_matches(source, at, stop, ".<=?"): return .dot_le
                        if dn_matches(source, at, stop, ".<?"): return .dot_lt
                    '=':
                        if dn_matches(source, at, stop, ".=?"): return .dot_eq
                    '>':
                        if dn_matches(source, at, stop, ".>=?"): return .dot_ge
                        if dn_matches(source, at, stop, ".>?"): return .dot_gt
                    '^':
                        if dn_matches(source, at, stop, ".^="): return .dot_power_assign
                        if dn_matches(source, at, stop, ".^"): return .dot_caret
                    'n':
                        if dn_matches(source, at, stop, ".not>=?"): return .dot_not_ge
                        if dn_matches(source, at, stop, ".not<=?"): return .dot_not_le
                        if dn_matches(source, at, stop, ".not=?"): return .dot_not_eq
                        if dn_matches(source, at, stop, ".not>?"): return .dot_not_gt
                        if dn_matches(source, at, stop, ".not<?"): return .dot_not_lt
        '/':
            if dn_matches(source, at, stop, "//="): return .floor_assign
            if dn_matches(source, at, stop, "/="): return .slash_assign
            if dn_matches(source, at, stop, "//"): return .floor
        ':':
            if dn_matches(source, at, stop, ":>"): return .returns
        '<':
            if dn_matches(source, at, stop, "<=?"): return .le
            if dn_matches(source, at, stop, "<<="): return .shl_assign
            if dn_matches(source, at, stop, "<?"): return .lt
            if dn_matches(source, at, stop, "<<"): return .shl
            if dn_matches(source, at, stop, "<|"): return .pipe_left
        '=':
            if dn_matches(source, at, stop, "=>"): return .function
            if dn_matches(source, at, stop, "=?"): return .eq
        '>':
            if dn_matches(source, at, stop, ">=?"): return .ge
            # Nested generic closers before => are >> then =>, not >>= then >.
            if dn_matches(source, at, stop, ">>=") and not dn_matches(source, at, stop, ">>=>"): return .shr_assign
            if dn_matches(source, at, stop, ">?"): return .gt
            if dn_matches(source, at, stop, ">>"): return .shr
        '?':
            if dn_matches(source, at, stop, "??"): return .coalesce
        '^':
            if dn_matches(source, at, stop, "^="): return .power_assign
        '|':
            if dn_matches(source, at, stop, "|>"): return .pipe_right
            if dn_matches(source, at, stop, "|="): return .pipe_assign
        '&':
            if dn_matches(source, at, stop, "&="): return .amp_assign
    dn_single_token(source[at])

# The hot punctuation path needs only two bounded byte loads and a table
# lookup. A `none` entry delegates longer spellings (and errors) to the
# complete scanner. Store width beside the token so scanning does not
# materialize token text.
dn_classes: u8[]
dn_symbols: DewyToken[]
dn_symbol_widths: int[]
dn_init_symbols = ():
    dn_classes = fill(u8(0), 256)
    loop c in [0..256):
        bits = int(lx_cls[c])
        if is_digit(u8(c)) or c == '_': bits |= 4
        if is_digit(u8(c)) or is_alpha(u8(c)) or c == '_': bits |= 8
        if c == ' ' or c == '\t' or c == '\r' or c == '\n': bits |= 16
        # (an identifier byte whose name needs no second look: see dn_identifier_canonical)
        # (a non-ASCII name byte ends the ordinary scan: the name has another spelling to settle)
        if bits & 2 != 0 and c >= 0x80: bits = (bits & ~2) | 32
        dn_classes[c] = u8(bits)
    dn_symbols = fill(DewyToken.none, 128 * 128)
    longer = fill(false, 128 * 128)
    dn_symbol_widths = fill(0, int(DewyToken.kw_or_throw) + 1)
    loop i in [1..int(DewyToken.kw_or_throw) + 1):
        text = dn_token_text(DewyToken(i))
        width = len(text)
        dn_symbol_widths[i] = width
        if width == 0 or dn_ident_start(text[0]): continue
        first = int(text[0]) * 128
        if width == 1:
            token = DewyToken(i)
            loop next in [0..128): dn_symbols[first + next] = token
    loop i in [1..int(DewyToken.kw_or_throw) + 1):
        text = dn_token_text(DewyToken(i))
        if len(text) < 2 or dn_ident_start(text[0]): continue
        slot = int(text[0]) * 128 + int(text[1])
        if len(text) > 2:
            longer[slot] = true
            dn_symbols[slot] = .none
        else if not longer[slot]: dn_symbols[slot] = DewyToken(i)

# One spelling per name: subscript digits are `_` and digits (`x₁₂` is `x_12`, and
# adjacent runs combine: `x₁_2`), superscript digits `‾` and digits (`x¹²` is `x‾12`),
# and the micro sign is Greek mu. (Only names with non-ASCII bytes come here.)
dn_identifier_canonical = (s: str) -> str:
    out = ""
    run = 0             # 1 after subscript digits, 2 after superscript digits
    i = 0
    n = len(s)
    loop i < n:
        c = s[i]
        digit = -1
        kind = 0
        width = 1
        if c == 0xE2 and i + 2 < n and s[i + 1] == 0x82 and s[i + 2] >= 0x80 and s[i + 2] <= 0x89:
            digit = int(s[i + 2]) - 0x80; kind = 1; width = 3
        else if c == 0xE2 and i + 2 < n and s[i + 1] == 0x81 and (s[i + 2] == 0xB0 or s[i + 2] >= 0xB4 and s[i + 2] <= 0xB9):
            digit = int(s[i + 2]) - 0xB0; kind = 2; width = 3
        else if c == 0xC2 and i + 1 < n and (s[i + 1] == 0xB9 or s[i + 1] == 0xB2 or s[i + 1] == 0xB3):
            digit = if s[i + 1] == 0xB9: 1 else if s[i + 1] == 0xB2: 2 else: 3
            kind = 2; width = 2
        else if (c == '_' or c == 0xE2 and i + 2 < n and s[i + 1] == 0x80 and s[i + 2] == 0xBE) and i + (if c == '_': 1 else: 3) < n and is_digit(s[i + (if c == '_': 1 else: 3)]):
            # (`_12` and `‾12`: the marker, then its digits)
            kind = if c == '_': 1 else: 2
            i += if c == '_': 1 else: 3
            if run != kind: out += if kind == 1: "_" else: "‾"
            loop i < n and is_digit(s[i]):
                out += s[i..i + 1)
                i += 1
            run = kind
            continue
        if digit >= 0:
            if run != kind: out += if kind == 1: "_" else: "‾"
            out += "{digit}"
            run = kind
            i += width
            continue
        if c == 0xC2 and i + 1 < n and s[i + 1] == 0xB5:
            out += "μ"
            i += 2
            run = 0
            continue
        out += s[i..i + 1)
        run = 0
        i += 1
    out

# `and=` `or=` `xor=`: a word operator directly followed by `=` (not `=?` or `=>`).
dn_word_assign = (word: DewyToken, bytes: *u8, at: int, stop: int) -> DewyToken:
    if at >= stop or bytes[at] != '=': return .none
    if at + 1 < stop and (bytes[at + 1] == '?' or bytes[at + 1] == '>' or bytes[at + 1] == '='): return .none
    if word == .kw_and: return .and_assign
    if word == .kw_or: return .or_assign
    if word == .kw_xor: return .xor_assign
    .none

dn_lex = (file: int, begin: int, stop: int, intern_names: bool = true) -> DewyLexeme[]:
    if intern_names and dn_word_tokens.len() == 0: dn_init_words()
    source = files[file].src
    # Hold the immutable string while scanning its bounded byte span. The
    # guards below are against stop, including interpolation subexpressions.
    assert(begin >= 0 and begin <= stop and stop <= len(source))
    bytes = source.data()
    if lx_cls == null: lx_init_classes()
    if dn_symbols.len() == 0: dn_init_symbols()
    classes = data(dn_classes)
    symbols = data(dn_symbols)
    widths = data(dn_symbol_widths)
    out: DewyLexeme[]
    capacity = (stop - begin) / 2 + 1
    out.resize(capacity)
    slots = data(out)
    count = 0
    dn_block_comments = []
    i = begin
    spaced = false
    newline = false
    skip = dn_skip_bodies
    nesting = 0
    loop i < stop:
        c = bytes[i]
        if classes[c] & 16 != 0:
            spaced = true
            if c == '\n': newline = true
            i += 1
            loop i < stop:
                c = bytes[i]
                if c == '\n': newline = true
                else if classes[c] & 16 == 0: break
                i += 1
            continue
        # (a `\` ending a line cancels that line break: the next line continues this one)
        if c == '\\':
            e = i + 1
            loop e < stop and (bytes[e] == ' ' or bytes[e] == '\t' or bytes[e] == '\r'): e += 1
            if e < stop and bytes[e] == '\n':
                spaced = true
                i = e + 1
                continue
        if c == '#' and i + 1 < stop and bytes[i + 1] == '{':
            e = dx_block_comment_end(bytes, i, stop)
            if e < 0:
                dx_block_comment_error(dn_lexer, i)
                dn_lex_problem()
            dn_block_comments.push(i)
            dn_block_comments.push(e)
            # (a comment over several lines separates like a line break)
            if find_byte(source[i..e), '\n') >= 0: newline = true
            spaced = true
            i = e
            continue
        if c == '#':
            loop i < stop and bytes[i] != '\n': i += 1
            spaced = true
            continue
        start = i
        kind = DewyKind.op
        symbol = DewyToken.none
        name: i32 = 0
        if c == 'r' and i + 1 < stop and (bytes[i + 1] == '"' or bytes[i + 1] == '\''):
            i = dn_quote_close(bytes, i + 1, stop, true)
            kind = .rawquoted
        else if classes[c] & 1 != 0:
            if c >= 0x80:
                # (`x₁₂`: the ASCII scan stopped at `₁`; the name is the token before and this)
                if count > 0 and slots[count - 1].stop == start and slots[count - 1].kind == .identifier:
                    count -= 1
                    start = slots[count].start
                    spaced = slots[count].space
                    newline = slots[count].newline
                    i = start
                loop i < stop and classes[bytes[i]] & 34 != 0: i += 1
            else:
                i += 1
                loop i < stop and classes[bytes[i]] & 2 != 0: i += 1
            kind = .identifier
            if intern_names:
                id = if c >= 0x80: intern(dn_identifier_canonical(source[start..i))) else: intern_sub(source, start, i - start)
                name = i32(id)
                if id < dn_word_tokens.len(): symbol = dn_word_tokens[id]
                if id == dn_true_id or id == dn_false_id: kind = .boolean
                combined = dn_word_assign(symbol, bytes, i, stop)
                if combined != .none:
                    symbol = combined
                    kind = .op
                    i += 1
                if i < stop and bytes[i] == '?':
                    query = DewyToken.none
                    if id == dn_is_id: query = .is_type
                    else if id == dn_isnt_id: query = .isnt_type
                    else if id == dn_in_id: query = .contains
                    if query != .none:
                        symbol = query
                        kind = .op
                        i += 1
            else:
                value = source[start..i)
                if value == "true" or value == "false": kind = .boolean
                if (value == "is" or value == "isnt" or value == "in") and i < stop and bytes[i] == '?':
                    value += "?"
                    i += 1
                    kind = .op
                if kind != .boolean: symbol = dn_token_kind(value)
                combined = dn_word_assign(symbol, bytes, i, stop)
                if combined != .none:
                    symbol = combined
                    kind = .op
                    i += 1
        else if c == '$':
            dn_metatags += 1
            i += 1
            loop i < stop and classes[bytes[i]] & 2 != 0: i += 1
            if i == start + 1: dn_error(start, "expected a name after $")
            kind = .metatag
        else if is_digit(c):
            decimal = true
            digits = start
            if c == '0' and i + 1 < stop and find_byte("btqsodzxug", bytes[i + 1]) >= 0:
                decimal = bytes[i + 1] == 'd'
                i += 2
                digits = i
            if i < stop and (bytes[i] == '"' or bytes[i] == '\''):
                i = dn_quote_close(bytes, i, stop, false)
                kind = .based_string
            else:
                mask: u8 = if decimal: 4 else: 8
                loop i < stop and classes[bytes[i]] & mask != 0: i += 1
                if i == digits: dn_error(start, "expected digits after the base prefix")
                kind = if decimal: DewyKind.source_integer else: DewyKind.integer
                if decimal and i + 1 < stop and bytes[i] == '.' and is_digit(bytes[i + 1]):
                    i += 1
                    loop i < stop and classes[bytes[i]] & 4 != 0: i += 1
                    kind = .source_real
                if decimal and i + 1 < stop and (bytes[i] == 'e' or bytes[i] == 'E') and (is_digit(bytes[i + 1]) or bytes[i + 1] == '+' or bytes[i + 1] == '-'):
                    i += 1
                    if i < stop and (bytes[i] == '+' or bytes[i] == '-'): i += 1
                    first = i
                    loop i < stop and classes[bytes[i]] & 4 != 0: i += 1
                    if i == first: dn_error(start, "expected exponent digits")
                    kind = .source_real
        else if c == '"' or c == '\'':
            i = dn_quote_close(bytes, i, stop, false)
            kind = .quoted
        else:
            next: u8 = 0
            if start + 1 < stop: next = bytes[start + 1]
            if c < 128 and next < 128: symbol = symbols[int(c) * 128 + int(next)]
            if symbol == .none:
                symbol = dn_lex_symbol(bytes, start, stop)
                if symbol == .none: dn_error(start, "unexpected character in Dewy source")
            i += widths[int(symbol)]
        if count == capacity:
            capacity *= 2
            out.resize(capacity)
            slots = data(out)
        slots[count].kind = kind
        slots[count].name = name
        slots[count].start = start
        slots[count].stop = i
        slots[count].space = spaced
        slots[count].newline = newline
        slots[count].symbol = symbol
        count += 1
        spaced = false
        newline = false
        if skip and symbol != .none:
            if symbol == .lparen or symbol == .lbrack or symbol == .lbrace: nesting += 1
            else if symbol == .rparen or symbol == .rbrack or symbol == .rbrace: nesting -= 1
            else if symbol == .function and nesting == 0:
                j = i
                loop j < stop and (bytes[j] == ' ' or bytes[j] == '\t'): j += 1
                if j < stop and bytes[j] == '{':
                    e = dx_lazy_end(bytes, j, stop)
                    if e > 0:
                        if count == capacity:
                            capacity *= 2
                            out.resize(capacity)
                            slots = data(out)
                        slots[count].kind = .lazy_body
                        slots[count].name = 0
                        slots[count].start = j
                        slots[count].stop = e
                        slots[count].space = j > i
                        slots[count].newline = false
                        slots[count].symbol = .none
                        count += 1
                        dn_lazy_left = true
                        i = e
    out.truncate(count)
    out.push(DewyLexeme(.eof, 0, stop, stop, spaced, newline))
    out

# Tokens contain only scalar tags, name IDs and source spans. Materialize text
# only when projection needs a literal payload; grammar lookahead copies no
# reference-counted strings. Formatting uses the spans and tags directly.
dn_payload = (token: DewyLexeme) -> str:
    if token.symbol != .none: return dn_token_text(token.symbol)
    if token.name != 0: return name_of(int(token.name))
    source = files[dn_file].src
    first = token.start
    if token.kind == .metatag: return source[first + 1..token.stop)
    if token.kind == .integer:
        return source[first..first + 2) + ":" + source[first + 2..token.stop)
    if token.kind == .based_string:
        return source[first..first + 2) + ":" + source[first + 3..token.stop - 1)
    if (token.kind == .source_integer or token.kind == .source_real) and first + 1 < token.stop and source[first] == '0' and source[first + 1] == 'd': first += 2
    source[first..token.stop)

dn_peek = () -> DewyToken: dn_tokens[dn_at].symbol
dn_take = () -> DewyLexeme:
    value = dn_tokens[dn_at]
    dn_at += 1
    value

dn_accept = (symbol: DewyToken) -> bool:
    if dn_peek() != symbol: return false
    dn_at += 1
    true

# A statement's `;` is attached to it, `f();`: an unattached one (after a space or
# on its own line) ends a row of an array literal, `[1 2 ; 3 4]`
dn_rows = false
dn_accept_semi = () -> bool:
    if dn_peek() != .semi: return false
    token = dn_tokens[dn_at]
    if dn_rows and (token.space or token.newline): return false
    if token.space or token.newline: dn_error(token.start, "an unattached `;` is reserved for array-dimension selection: attach it to the statement it ends, `f();`, or leave it out")
    dn_at += 1
    true

dn_expect = (symbol: DewyToken):
    if not dn_accept(symbol): dn_error(dn_tokens[dn_at].start, "expected '{dn_token_text(symbol)}'")

dn_node = (kind: DewyKind, text: str, offset: int, children: int[] = [], name: i32 = 0) -> int: syntax_node(dewy_syntax, kind, text, mkpos(dn_file, offset), children, name)

# Expression operators are scalar tags on their parent node. Child zero is
# the shared ordinary/inverted sentinel; operands retain indices one onward.
dn_op_node = (kind: DewyKind, symbol: DewyToken, offset: int, children: int[]) -> int: syntax_op_node(dewy_syntax, kind, symbol, mkpos(dn_file, offset), children)

dn_operator = (kind: DewyKind, op: DewyToken, left: int, right: int) -> int: syntax_operator(dewy_syntax, kind, op, left, right)

# String decoding is shared; the construction target selects syntax nodes for
# the reference parser or compact nodes for the value parser.
dn_text = (kind: DewyKind, text: str, offset: int, direct: bool) -> int:
    if not direct: return dn_node(kind, text, offset)
    n = mk(.str_lit, mkpos(dn_file, offset))
    nodes[n].sval = i32(intern(text))
    n

# (a mistake in a string's escapes: one stops the compile)
dn_string_problem = LiteralProblem("", 0, false)
dn_string = (token: DewyLexeme, direct: bool = false) -> int:
    source = files[dn_file].src
    raw = token.kind == .rawquoted
    opening = token.start
    if raw: opening += 1
    width = dn_quote_width(source, opening, token.stop)
    i = opening + width
    stop = token.stop - width
    if raw: return dn_text(.string, source[i..stop), token.start, direct)
    chunks: int[]
    bytes_: u8[]
    chunk_start = i
    interpolated = false
    loop i < stop:
        # (literals.dewy reads the text up to an interpolation)
        i = literal_string_text(dn_string_problem, bytes_, source, i, stop)
        if len(dn_string_problem.message) > 0: dn_error(dn_string_problem.at, dn_string_problem.message)
        if i >= stop: break
        interpolated = true
        if bytes_.len() > 0:
            chunks.push(dn_text(.string_chunk, str_from_bytes(bytes_), chunk_start, direct))
            bytes_.clear()
        first = i + 1
        i = dn_interpolation_close(source, first, stop)
        # (`{x:.2f}`: a format spec after the value's last top-level colon)
        colon = dn_spec_colon(dn_lexer, source, first, i)
        saved_tokens = dn_tokens
        saved_at = dn_at
        saved_angles = dn_angles
        saved_comma = dn_comma_stop
        dn_tokens = dn_lex(dn_file, first, if colon >= 0: colon else: i)
        dn_at = 0
        dn_angles = 0
        dn_comma_stop = false
        dn_in_interpolation += 1
        expression = if direct: dc_expr(0) else: dn_expr(0)
        if expression != 0 and dn_tokens[dn_at].kind != .eof: dn_error(dn_tokens[dn_at].start, "expected one interpolation expression")
        dn_in_interpolation -= 1
        dn_tokens = saved_tokens
        dn_at = saved_at
        dn_angles = saved_angles
        dn_comma_stop = saved_comma
        spec = if colon >= 0: source[colon + 1..i) else: ""
        if direct:
            if expression == 0: return 0
            part = mk(.pair, mkpos(dn_file, first))
            nodes[part].a = i32(expression)
            nodes[part].sval = if colon >= 0: i32(intern(spec)) else: -1
            chunks.push(part)
        else if colon >= 0: chunks.push(dn_node(.block, "{{}}:", first, [expression, dn_node(.string, spec, colon + 1)]))
        else: chunks.push(dn_node(.block, "{{}}:", first, [expression]))
        i += 1
        chunk_start = i
    if not interpolated: return dn_text(.string, str_from_bytes(bytes_), token.start, direct)
    if bytes_.len() > 0: chunks.push(dn_text(.string_chunk, str_from_bytes(bytes_), chunk_start, direct))
    if direct:
        n = mk(.str_lit, mkpos(dn_file, token.start))
        nodes[n].aux = 1
        set_list(n, chunks)
        return n
    dn_node(.interpolated_string, "", token.start, chunks)

dn_partial = (opening: DewyLexeme) -> int:
    # Reuse the just-consumed opening token as a synthetic left operand. This
    # preserves normal precedence without inserting/shifting the token array
    # or adding work to the ordinary expression loop. Restore it after parsing.
    slot = dn_at - 1
    name = "$partial"
    id = i32(intern(name))
    dn_tokens[slot] = DewyLexeme(.identifier, id, opening.start, opening.stop, opening.space, opening.newline)
    dn_at = slot
    saved_angles = dn_angles
    dn_angles = 0
    body = dn_expr(0)
    dn_angles = saved_angles
    dn_tokens[slot] = opening
    dn_expect(.rparen)
    parameter = dn_node(.identifier, name, opening.start, name = id)
    params = dn_node(.block, "():", opening.start, [parameter])
    fn = dn_operator(.binary, .function, params, body)
    dn_node(.block, "():", opening.start, [fn])

# Brackets start a fresh comma context, even inside an assertion condition.
dn_block = () -> int:
    # Square brackets may define record function fields. Their sibling scope
    # is established during projection, after all field names are known.
    direct = dc_enabled
    if dn_peek() == .lbrack: dc_enabled = false
    saved = dn_comma_stop
    dn_comma_stop = false
    block = dn_bracketed()
    dn_comma_stop = saved
    dc_enabled = direct
    block

dn_bracketed = () -> int: dn_bracketed_from(dn_take())

# Splitting a generic closer edits its token in place. While a direct declaration
# may still retry the reference grammar, the original tokens are kept to restore.
dn_edits_on = false
dn_edit_at: int[]
dn_edit_was: DewyLexeme[]

dn_token_edit = (at: int):
    if not dn_edits_on: return
    dn_edit_at.push(at)
    dn_edit_was.push(dn_tokens[at])

# Undo the edits recorded after `mark` (an abandoned attempt's), the latest first. An entry
# -(k + 1) is a setting scope the attempt set (dc_unsafe_scope): scopes from k on go.
dn_edits_undo = (mark: int = 0):
    i = dn_edit_at.len() - 1
    loop i >= mark:
        at = dn_edit_at[i]
        if at < 0: dir_scopes.truncate(-at - 1)
        else: dn_tokens[at] = dn_edit_was[i]
        i -= 1
    dn_edits_clear(mark)

dn_edits_clear = (mark: int = 0):
    dn_edit_at.truncate(mark)
    dn_edit_was.truncate(mark)

# A generic closer joined to what follows (`>>`, `>=`, `>?` unspaced) closes one angle:
# its first `>` is consumed in place, leaving the rest for the enclosing grammar.
dn_closer_joined = () -> bool:
    op = dn_peek()
    op == .shr or op == .shr_assign or op == .angle_assign or (op == .gt and not dn_tokens[dn_at].space)

dn_split_closer = ():
    dn_token_edit(dn_at)
    dn_tokens[dn_at].start += 1
    tail = dn_tokens[dn_at]
    dn_tokens[dn_at].symbol = dn_token_kind(files[dn_file].src[tail.start..tail.stop))

# `array<<(x:int64):>int64>>`: an adjacent `<<` opens two type-argument blocks
dn_double_angle = () -> int:
    outer = dn_tokens[dn_at]
    outer.symbol = .langle
    outer.stop = outer.start + 1
    dn_token_edit(dn_at)
    dn_tokens[dn_at].start += 1
    dn_tokens[dn_at].symbol = .langle
    dn_bracketed_from(outer)

dn_bracketed_from = (opening: DewyLexeme) -> int:
    if opening.symbol == .lparen:
        op = dn_peek()
        if dn_partial_operator(op) or (op == .kw_not and dn_at + 1 < dn_tokens.len() and dn_token_invert(dn_tokens[dn_at + 1].symbol) != .none): return dn_partial(opening)
    if opening.symbol == .langle: dn_angles += 1
    rows = dn_rows
    dn_rows = opening.symbol == .lbrack
    close = if opening.symbol == .lparen: DewyToken.rparen else if opening.symbol == .lbrack: DewyToken.rbrack else if opening.symbol == .langle: DewyToken.rangle else: DewyToken.rbrace
    children: int[]
    loop true:
        if dn_tokens[dn_at].kind == .eof: dn_error(opening.start, "expected '{dn_token_text(close)}' before end of file")
        # Split adjacent generic closers, assignments and optional suffixes.
        # Consume one angle at a time, leaving the rest for its parent.
        # A spaced ` >? ` stays a comparison inside a refinement.
        if close == .rangle and dn_closer_joined():
            dn_split_closer()
            break
        if dn_accept(close): break
        # (`xs[$clamp a..b)`: an in-index metatag before the range)
        if ((opening.symbol == .lbrack and dn_peek() == .rparen) or (opening.symbol == .lparen and dn_peek() == .rbrack)) and (children.len() == 1 and dw_op(children[0]) == .range_apply or children.len() == 2 and dewy_syntax[children[0]].kind == .metatag and dw_op(children[1]) == .range_apply):
            close = dn_peek()
            dn_at += 1
            break
        # ([0..n as int64): `as` binds more loosely than `..`, so it took the whole range)
        if opening.symbol == .lbrack and dn_peek() == .rparen and children.len() == 1 and (dw_op(children[0]) == .kw_as or dw_op(children[0]) == .kw_transmute) and dw_op(dw_child(children[0], 1)) == .range_apply:
            return dn_error(dn_tokens[dn_at].start, "expected an expression, found ')': `{dn_token_text(dw_op(children[0]))}` binds more loosely than `..`, so here it converts the whole range; parenthesize the bound, as in `[0..(n as int64))`")
        # (a standalone `;` in an array literal ends a row: `[1 2 ; 3 4]`, and `;;` a block)
        if dn_rows and dn_peek() == .semi:
            children.push(dn_node(.keyword, ";", dn_take().start))
            continue
        before = dn_at
        children.push(if opening.symbol == .lbrace: dn_statement() else: dn_stmt())
        if dn_at == before: dn_error(dn_tokens[dn_at].start, "expected a block element")
    dn_rows = rows
    if opening.symbol == .langle: dn_angles -= 1
    label = dn_token_text(opening.symbol) + dn_token_text(close) + ":"
    dn_node(.block, label, opening.start, children)

dn_flow = () -> int:
    start = dn_tokens[dn_at].start
    arms: int[]
    loop true:
        keyword = dn_take()
        key = dn_node(.keyword, dn_token_text(keyword.symbol), keyword.start)
        condition = if keyword.symbol == .kw_loop or keyword.symbol == .kw_parallel: dn_expr(0) else: dn_value(0)
        if not dn_can_start(dn_tokens, dn_at):
            # (a loop has one form, `loop condition body`: `loop { ... }` alone has no body)
            if keyword.symbol == .kw_loop and dewy_syntax[condition].kind == .block and dewy_syntax[condition].text == "{{}}:": dn_error(dn_tokens[dn_at].start, "expected a body after this loop's condition: a loop is `loop condition body`, so a loop that runs until `break` or `return` is `loop true \{ ... }`")
            next = dn_peek()
            habit = ""
            if next == .gt or next == .lt or next == .rangle or next == .ge or next == .le: habit = " (comparisons end with `?`: `x >? y`, `x <=? y`)"
            else if dw_op(condition) == .colon: habit = " (a condition takes no colon: its body goes in braces, `{dn_token_text(keyword.symbol)} x >? 3 \{ ... }`)"
            dn_error(dn_tokens[dn_at].start, "expected a body after '{dn_token_text(keyword.symbol)}'{habit}")
        # (`loop { ... }` then a new line: the block is the condition and the next line the body)
        if keyword.symbol == .kw_loop and dewy_syntax[condition].kind == .block and dewy_syntax[condition].text == "{{}}:" and dn_tokens[dn_at].newline:
            warn(mkpos(dn_file, dn_tokens[dn_at].start), "this line is the body of the loop above, whose block is its condition: a loop is `loop condition body`, so a loop that runs until `break` or `return` is `loop true \{ ... }`; to keep this meaning, start the body on the condition's line")
        body = dn_expr(0)
        arms.push(dn_node(.keyword_expr, "", keyword.start, [key, condition, body]))
        if not dn_accept(.kw_else): break
        if dn_peek() == .kw_if or dn_peek() == .kw_match: continue
        arms.push(dn_expr(0))
        break
    dn_node(.flow, "", start, arms)

# Children: the condition, the message and the condition's source text (each
# 0 when absent). The text gives a failed check its default description.
dn_directive = (token: DewyLexeme, form: int) -> int:
    dn_at += 1
    name = dn_payload(token)
    if form == 6:
        # `$unsafe expression`: the boundary covers the next expression, on this line or the
        # next (`$unsafe { ... }` several); `$unsafe=false` and a type's `$unsafe` row stay settings
        next = dn_tokens[dn_at]
        if not dn_can_start(dn_tokens, dn_at) or next.symbol == .assign or next.kind == .metatag: return dn_node(token.kind, name, token.start, name = token.name)
        return dn_node(.directive, name, token.start, [dn_expr(0)])
    if form == 4:
        dn_expect(.lparen)
        owner = dn_expr(0)
        reservation = 0
        if dn_payload(dn_tokens[dn_at]) == "reserve":
            dn_at += 1
            dn_expect(.assign)
            reservation = dn_expr(0)
        dn_expect(.rparen)
        body = dn_expr(0)
        return dn_node(.directive, name, token.start, [owner, reservation, body])
    if form == 5:
        # `$allocator(@arena) expression`: the arena lent to the whole next expression
        dn_expect(.lparen)
        arena = dn_expr(0)
        dn_expect(.rparen)
        return dn_node(.directive, name, token.start, [arena, 0, dn_expr(0)])
    next = dn_tokens[dn_at]
    present = not next.newline and dn_can_start(dn_tokens, dn_at)
    if form == 3 or not present:
        if form == 1: return dn_error(token.start, "`${name}` needs a condition: `${name} condition` or `${name} condition, \"message\"`")
        return dn_node(.directive, name, token.start, [0, 0, 0])
    saved = dn_comma_stop
    dn_comma_stop = true
    condition = 0
    text = 0
    message = 0
    if form == 7:
        # `$warn_if condition "message"`: the message follows the condition (a comma may
        # separate them)
        condition = dn_expr(0)
        dn_accept(.comma)
        if dn_tokens[dn_at].newline or not dn_can_start(dn_tokens, dn_at): return dn_error(token.start, "`$warn_if` needs a message after its condition: `$warn_if condition \"message\"`")
        message = dn_expr(0)
    else if form == 1:
        # `$assert(condition, "message")`: an adjacent group is the argument
        # list, as for other directives, with the same comma.
        listed = next.symbol == .lparen and not next.space
        if listed: dn_at += 1
        first = dn_tokens[dn_at].start
        condition = dn_expr(0)
        text = dn_node(.string, files[dn_file].src[first..dn_tokens[dn_at - 1].stop), first)
        if dn_accept(.comma): message = dn_expr(0)
        if listed: dn_expect(.rparen)
    else: message = dn_expr(0)
    dn_comma_stop = saved
    dn_node(.directive, name, token.start, [condition, message, text])

dn_atom = () -> int:
    token = dn_tokens[dn_at]
    symbol = token.symbol
    # Effect negation is contextual; ordinary bindings named `no` remain valid.
    effect_no = false
    if token.kind == .identifier and (token.name == i32(dn_no_id) or token.name == 0 and dn_payload(token) == "no") and dn_at + 1 < dn_tokens.len():
        following = dn_payload(dn_tokens[dn_at + 1])
        if following == "reads" or following == "mutates" or following == "allocates" or following == "blocks" or following == "panics":
            symbol = .kw_not
            effect_no = true
    if token.kind == .eof: return dn_error(token.start, "expected an expression")
    # (`(... amount:int64)`: a bare `...` opening a parameter list)
    # (`[...rest last] = xs`, `[... last] = xs`: a pattern's rest, or bare `...`, opening it)
    if symbol == .ellipsis and dn_at > 0 and dn_tokens[dn_at - 1].symbol == .lbrack and dn_at + 1 < dn_tokens.len() and (dn_tokens[dn_at + 1].symbol == .rbrack or dn_tokens[dn_at + 1].kind == .identifier):
        dn_at += 1
        return dn_node(.identifier, "...", token.start)
    if symbol == .ellipsis and dn_at > 0 and dn_tokens[dn_at - 1].symbol == .lparen and dn_at + 1 < dn_tokens.len() and (dn_tokens[dn_at + 1].symbol == .rparen or dn_tokens[dn_at + 1].kind == .identifier and dn_at + 2 < dn_tokens.len() and (dn_tokens[dn_at + 2].symbol == .colon or dn_tokens[dn_at + 2].kind == .identifier or dn_tokens[dn_at + 2].symbol == .rparen)):
        dn_at += 1
        return dn_node(.identifier, "...", token.start)
    if token.kind == .metatag:
        form = dn_directive_form(dn_payload(token))
        if form != 0: return dn_directive(token, form)
    if symbol == .lparen or symbol == .lbrack or symbol == .lbrace or symbol == .langle: return dn_block()
    if symbol == .kw_if or symbol == .kw_loop or symbol == .kw_parallel or symbol == .kw_match: return dn_flow()
    if (symbol == .kw_let or symbol == .kw_const or symbol == .kw_return or symbol == .kw_break or symbol == .kw_continue or symbol == .kw_import or symbol == .kw_from): return dn_stmt()
    dn_at += 1
    if token.kind == .quoted or token.kind == .rawquoted: return dn_string(token)
    if (symbol == .tilde or symbol == .plus or symbol == .minus or symbol == .dot_plus or symbol == .dot_minus or symbol == .at or symbol == .kw_not):
        # (`no reads & no blocks` is `(no reads) & (no blocks)`)
        return dn_op_node(.prefix, symbol, token.start, [0, dn_expr(dn_prefix_power(symbol, effect_no))])
    if symbol == .range:
        dots = dn_node(.identifier, "..", token.start)
        if not dn_range_bound(dn_tokens, dn_at): return dots
        bound = dn_expr(101)
        return dn_op_node(.flat, .range_apply, token.start, [0, dots, bound])
    text = dn_payload(token)
    if symbol == .kw_concurrent:
        group = 0
        if dn_peek() != .lbrace:
            token = dn_take()
            if token.kind != .identifier: return dn_error(token.start, "concurrent needs a group name or a braced body")
            group = dn_node(.identifier, dn_payload(token), token.start, name = token.name)
        if dn_peek() != .lbrace: return dn_error(dn_tokens[dn_at].start, "concurrent needs a braced body")
        body = dn_block()
        return dn_node(.directive, "concurrent", token.start, [group, body])
    if symbol == .kw_spawn and (dn_peek() == .assign or dn_peek() == .colon): return dn_node(.identifier, text, token.start)
    if symbol == .kw_spawn:
        group = 0
        if dn_peek() == .lparen and not dn_tokens[dn_at].space:
            arguments = dn_block()
            # The established process API is still an ordinary completed call.
            # Task spawning has an expression after its one group argument.
            if dw_nchildren(arguments) != 1 or not dn_can_start(dn_tokens, dn_at) or dn_tokens[dn_at].newline or dn_power(dn_peek()) > 0 or dn_peek() == .kw_return or dn_peek() == .kw_let or dn_peek() == .kw_const or dn_peek() == .kw_break or dn_peek() == .kw_continue:
                callee = dn_node(.identifier, "spawn", token.start)
                return dn_operator(.binary, .call, callee, arguments)
            group = dw_child(arguments, 0)
        value = dn_expr(0)
        return dn_node(.directive, "spawn", token.start, [group, value])
    if text == "type" and dn_accept(.kw_of):
        return dn_op_node(.prefix, .kw_of, token.start, [0, dn_expr(dn_prefix_power(.kw_of, false))])
    if token.kind == .op:
        # (xs[1:], xs[::-1]: Python's slices)
        after_colon = symbol == .colon or dn_at >= 2 and dn_tokens[dn_at - 2].symbol == .colon
        # (`(from:int64)`, `let loop = 1`: a keyword where a name was meant)
        # (not `else:` or `loop:`, other languages' block colons)
        if (symbol == .colon or symbol == .assign) and dn_at >= 2 and dn_tokens[dn_at - 2].symbol != .none and not dn_tokens[dn_at - 1].newline:
            word = dn_token_text(dn_tokens[dn_at - 2].symbol)
            named = symbol == .assign or dn_tokens[dn_at - 2].stop == token.start and not (word in ["else", "loop", "if", "match"])
            if named and len(word) > 0 and word[0] >= 'a' and word[0] <= 'z':
                return dn_error(dn_tokens[dn_at - 2].start, "`{word}` is a keyword, so it cannot name a variable, parameter or field: choose another name")
        if after_colon and (symbol == .colon or symbol == .rbrack): return dn_error(token.start, "expected an expression, found '{text}' (a slice is a range in the brackets: `xs[1..]`, `xs[..n)`, `xs[a..b)`; `xs.reversed()` reverses; `:` gives a type)")
        habit = dn_operator_habit(dn_tokens, dn_at, text)
        return dn_error(token.start, "expected an expression, found '{text}'{habit}")
    dn_node(token.kind, text, token.start, name = token.name)

dn_expr = (minimum: int) -> int:
    dn_depth += 1
    if dn_depth > 256: return dn_error(dn_tokens[dn_at].start, "expression is nested too deeply")
    opening = dn_tokens[dn_at].symbol
    left = dn_atom()
    # (a parenthesized group, while nothing has applied to it: `(5)x`, `(x)2` multiply)
    group = if opening == .lparen and dn_tokens[dn_at - 1].symbol == .rparen: left else: -1
    loop true:
        token = dn_tokens[dn_at]
        op = token.symbol
        if token.kind == .eof: break
        if token.newline and dn_power(op) == 0 and op != .kw_not: break
        if dn_angles > 0 and ((op == .shr or op == .shr_assign or op == .angle_assign) or (op == .gt and not token.space)): break
        if op == .kw_or_throw and minimum <= 48:
            dn_at += 1
            left = dn_op_node(.postfix, .kw_or_throw, pos_off(dewy_syntax[left].pos), [0, left])
            continue
        if op == .ellipsis and minimum <= 170:
            dn_at += 1
            left = dn_op_node(.postfix, .ellipsis, pos_off(dewy_syntax[left].pos), [0, left])
            continue
        # A numeric literal against a name or a group is a coefficient (`2x`, `2(x+1)`,
        # `2^3x`), binding below `^` and above `*` (docs/design/juxtaposition.md).
        # Whitespace always separates expressions.
        if not token.space and (token.kind == .identifier or op == .lparen or token.kind == .source_integer or token.kind == .source_real or token.kind == .integer):
            # (`2()` is a call: an empty `()` after any expression calls it; most such lexemes follow
            # no number and no group, the inline test)
            pk = dn_tokens[dn_at - 1].kind
            if (left == group or pk == .source_integer or pk == .source_real or pk == .integer) and dn_juxtaposed(dn_tokens, dn_at, left == group):
                if minimum > 135: break
                left = dn_operator(.binary, .multiply_apply, left, dn_expr(136))
                continue
            if op != .lparen and dn_juxt_excluded(dn_tokens, dn_at): return dn_error(token.start, dn_juxt_excluded_message(dn_tokens, dn_at))
        if op == .dot and minimum <= 170:
            dn_at += 1
            if dn_peek() == .lparen and not dn_tokens[dn_at].space:
                left = dn_operator(.binary, .broadcast_call, left, dn_block())
                continue
            right = dn_take()
            if right.kind == .metatag and dn_payload(right) == "field":
                member = dn_node(.metatag, "field", right.start)
                if dn_peek() != .lparen: return dn_error(right.start, "expected `$field(name)`")
                member = dn_operator(.binary, .call, member, dn_block())
                left = dn_operator(.binary, .dot, left, member)
                continue
            if right.kind == .metatag and dw_designed_directive(dn_payload(right)): return dn_error(right.start, "`${dn_payload(right)}` is part of the design but not implemented yet")
            if right.kind != .identifier: return dn_error(right.start, "expected a member name")
            left = dn_operator(.binary, .dot, left, dn_node(.identifier, dn_payload(right), right.start, name = right.name))
            continue
        if not token.space and (op == .lparen or op == .lbrack) and minimum <= 170:
            right = dn_block()
            label = if op == .lparen: DewyToken.call else: DewyToken.index
            left = dn_operator(.binary, label, left, right)
            continue
        if not token.space and (token.kind == .quoted or token.kind == .rawquoted) and minimum <= 170:
            dn_at += 1
            left = dn_operator(.binary, .call, left, dn_string(token))
            continue
        if not token.space and op == .langle and minimum <= 160:
            left = dn_operator(.binary, .type_apply, left, dn_block())
            continue
        if not token.space and op == .shl and minimum <= 160 and dewy_syntax[left].kind == .identifier and dn_double_closes(dn_tokens, dn_at):
            left = dn_operator(.binary, .type_apply, left, dn_double_angle())
            continue
        if op == .question and minimum <= 140:
            dn_at += 1
            left = dn_op_node(.postfix, .question, pos_off(dewy_syntax[left].pos), [0, left])
            continue
        # An inverted comparison may be written with a space after `not`.
        if op == .kw_not and dn_at + 1 < dn_tokens.len():
            inverted = dn_token_invert(dn_tokens[dn_at + 1].symbol)
            if inverted != .none:
                op = inverted
                token.stop = dn_tokens[dn_at + 1].stop
        if op == .comma and dn_comma_stop: break
        power = dn_power(op)
        if power == 0 or power < minimum: break
        if (op == .plus or op == .minus) and token.space and not dn_tokens[dn_at + 1].space: break
        dn_at += 1
        if token.symbol == .kw_not: dn_at += 1
        if op == .range:
            parts = [0, left, dn_node(.identifier, "..", token.start)]
            if dn_range_bound(dn_tokens, dn_at): parts.push(dn_expr(power + 1))
            left = dn_op_node(.flat, .range_apply, pos_off(dewy_syntax[left].pos), parts)
            continue
        # `x ??<Missing | ParseError> 0`: the fallback only for the kinds listed
        if op == .coalesce and not dn_tokens[dn_at].space and (dn_tokens[dn_at].symbol == .langle or dn_tokens[dn_at].symbol == .lt):
            if dn_tokens[dn_at].symbol == .lt: dn_tokens[dn_at].symbol = .langle
            kinds = dn_block()
            fallback = dn_expr(power)
            left = dn_op_node(.flat, .coalesce, pos_off(dewy_syntax[left].pos), [0, left, fallback, kinds])
            continue
        value_rhs = dn_token_assignment(op) or (op == .assign and dw_name(left) != "")
        right = if value_rhs: dn_value(power + 1) else: dn_expr(if dn_right_associative(op): power else: power + 1)
        if op == .kw_as or op == .kw_transmute:
            # (`loop c in text as array<uint8>`: `as` binds more loosely than `in`)
            last = left
            loop dewy_syntax[last].kind == .binary and (dw_op(last) == .kw_and or dw_op(last) == .kw_or): last = dewy_syntax[last].child_right
            if dewy_syntax[last].kind == .binary and dw_op(last) == .kw_in: return dn_error(token.start, "`{dn_token_text(op)}` binds more loosely than `in`, so this converts the whole loop header: parenthesize the source, as in `loop c in (text {dn_token_text(op)} array<uint8>)`")
            # `bytes as string ?? ""`: no type has a fallback, so this converts to an
            # optional and falls back, as `(bytes as string | none) ?? ""`
            if op == .kw_as and dewy_syntax[right].kind == .binary and dw_op(right) == .coalesce:
                target = dewy_syntax[right].child_left
                optional = dn_operator(.binary, .pipe, target, dn_node(.identifier, "none", pos_off(dewy_syntax[target].pos)))
                left = dn_operator(.binary, .coalesce, dn_operator(.binary, op, left, optional), dewy_syntax[right].child_right)
                continue
        if op == .comma:
            parts: int[]
            if dw_op(left) == .comma: parts = dw_children(left)
            else: parts = [0, left]
            parts.push(right)
            left = dn_op_node(.flat, .comma, pos_off(dewy_syntax[left].pos), parts)
        # (`a nand b` is `not (a and b)`, as `nor` and `xnor` are of `or` and `xor`)
        else if op == .kw_nand or op == .kw_nor or op == .kw_xnor:
            base = if op == .kw_nand: DewyToken.kw_and else if op == .kw_nor: DewyToken.kw_or else: DewyToken.kw_xor
            left = dn_op_node(.prefix, .kw_not, token.start, [0, dn_operator(.binary, base, left, right)])
        else: left = dn_operator(.binary, op, left, right)
    dn_depth -= 1
    left

dn_stmt = () -> int:
    token = dn_tokens[dn_at]
    word = dn_token_text(token.symbol)
    symbol = token.symbol
    result = 0
    # Contextual keyword: ordinary bindings/calls named `test` still work.
    if symbol == .kw_test and dn_tokens[dn_at + 1].space and (dn_tokens[dn_at + 1].kind == .quoted or dn_tokens[dn_at + 1].kind == .rawquoted) and not dn_tokens[dn_at + 1].newline:
        # (the test block of other languages: a Dewy test is a function marked `$test`)
        return dn_error(token.start, "a test is a function marked `$test` on the line before it: `$test` then `let adds_numbers = () => $expect add(20 22) =? 42`")
    if (symbol == .kw_let or symbol == .kw_const or symbol == .kw_return or symbol == .kw_break or symbol == .kw_continue or symbol == .kw_import or symbol == .kw_from):
        dn_at += 1
        parts = [dn_node(.keyword, word, token.start)]
        if symbol != .kw_break and symbol != .kw_continue:
            if symbol != .kw_return or (dn_can_start(dn_tokens, dn_at) and not dn_tokens[dn_at].newline): parts.push(if symbol == .kw_return: dn_value(0) else: dn_expr(0))
        else if dn_tokens[dn_at].kind == .metatag and not dn_tokens[dn_at].newline:
            parts.push(dn_atom())
        if symbol == .kw_from:
            keyword = dn_tokens[dn_at]
            dn_expect(.kw_import)
            parts.push(dn_node(.keyword, "import", keyword.start))
            parts.push(dn_expr(0))
        else if symbol == .kw_import and dn_tokens[dn_at].symbol == .kw_from and not dn_tokens[dn_at].newline:
            # (`import (a b) from p"x"`, the other order)
            keyword = dn_take()
            parts.push(dn_node(.keyword, "from", keyword.start))
            parts.push(dn_expr(0))
        # (`from m import a b`: names listed without commas or parentheses; `import m n`: two modules)
        if (symbol == .kw_import or symbol == .kw_from) and not dn_tokens[dn_at].newline and dn_can_start(dn_tokens, dn_at):
            if parts.len() == 2: return dn_error(dn_tokens[dn_at].start, "an `import` line takes one module: put the next on a line of its own, or take names from a module with `from m import a, b`")
            return dn_error(dn_tokens[dn_at].start, "imported names are separated by commas, `import a, b`, or listed in parentheses, `import (a b)`")
        result = dn_node(.keyword_expr, "", token.start, parts)
    else: result = dn_expr(0)
    if dn_accept_semi(): result = dn_operator(.binary, .statement_end, result, 0)
    result


dewy_fast_file = (file: int) -> int[]:
    dw_bigint_import = 0
    if not dc_mode_read:
        dc_mode_read = true
        mode = env("DEWY_FRONTEND") ?? ""
        dc_selected = mode != "old"
        dc_compare = mode == "compare"
    dc_enabled = dc_selected
    # (a direct attempt may split generic closers: a retry restores them, dn_edits_undo)
    saved_edits_on = dn_edits_on
    dn_edits_on = dc_enabled
    dn_file = file
    dn_lexer.suspect_brace = -1
    dn_in_interpolation = 0
    dn_metatags = 0
    lib_lazy = dc_lib_lazy_allowed(file) and not dc_lazy_allowed(file)
    dn_lazy_left = false
    dn_skip_bodies = lib_lazy
    dn_tokens = dn_lex(file, 0, len(files[file].src))
    dn_skip_bodies = false
    dw_dir_lexed(file)
    dc_lazy_on = dc_lazy_allowed(file)
    dc_lib_lazy = lib_lazy and not dc_lazy_on
    if dc_lazy_on:
        # Buffer even warnings preceding the first deferred declaration.
        dc_lazy_used = true
        dc_lazy_tokens[file] = dn_tokens
    if dc_lib_lazy: dc_lib_lazy_files[file] = true
    dn_at = 0
    dn_angles = 0
    dn_depth = 0
    dewy_syntax = [DewySyntax(.unknown, "", 0, []), DewySyntax(.inverted_comparison, "", 0, [])]
    declarations: int[]
    marked = 0
    shadowable_pos = 0
    loop dn_tokens[dn_at].kind != .eof:
        before = dn_at
        syntax = dn_statement(true)
        tag = dw_test_tag(syntax)
        if tag != 0:
            if marked != 0: fatal(dewy_syntax[tag].pos, "a second `$test` line: one marks the function just after it")
            marked = dw_test_spec(tag)
            dewy_syntax.truncate(2)
            if dn_at == before: dn_error(dn_tokens[dn_at].start, "expected a declaration")
            continue
        shadow_tag = dw_shadowable_tag(syntax)
        if shadow_tag != 0:
            if shadowable_pos != 0: fatal(dewy_syntax[shadow_tag].pos, "a second `$shadowable`: one marks the const just after it")
            if dn_tokens[dn_at].symbol != .kw_const: fatal(dewy_syntax[shadow_tag].pos, "`$shadowable` marks a module-level const: `$shadowable const name = ...`")
            shadowable_pos = dewy_syntax[shadow_tag].pos
            dewy_syntax.truncate(2)
            continue
        made = dw_top_declarations(syntax)
        if oom_files.len() > 0: made = oom_wrap_all(made)
        if shadowable_pos != 0:
            loop declaration in made: shadowable_decls[declaration] = true
            shadowable_pos = 0
        loop declaration in made: declarations.push(declaration)
        if marked != 0:
            dw_test_attach(marked, made)
            declarations.push(marked)
            marked = 0
        # Projection owns the retained data in the compact AST. Discard each
        # declaration's temporary syntax before parsing the next declaration.
        dewy_syntax.truncate(2)
        if dn_at == before: dn_error(dn_tokens[dn_at].start, "expected a declaration")
    if proof_pending: dn_error(dn_tokens[dn_at].start, "$proof requires a following function declaration")
    if dir_bundles.len() > 0: dir_bundles_resolve()
    if dw_export_pos != 0: fatal(dw_export_pos, "`$export` marks a module-level function: put it before one, on its line or the line above")
    if marked != 0: fatal(nodes[marked].pos, "`$test` marks a module-level function: put it on the line just before one")
    if shadowable_pos != 0: fatal(shadowable_pos, "`$shadowable` marks a module-level const: put it just before one")
    if dc_lib_lazy:
        dc_lazy_tokens[file] = dn_tokens
        dc_lib_lazy = false
    dn_tokens = []
    dewy_syntax = []
    dn_edits_on = saved_edits_on
    dw_finish_declarations(declarations)

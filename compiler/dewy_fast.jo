use 'dewy_parser.dewy'
use 'dewy_methods.jo'
use 'lazy_bodies.jo'
# In-process Dewy frontend. Value expressions construct compact AST nodes;
# unmigrated grammar uses the syntax projection. Unsupported syntax is an error.
use 'util.jo'
use 'lex.jo'
use 'parse.jo'
use 'ast.jo'
use 'dewy_nodes.jo'
use 'oom.jo'
use 'proofs.jo'
use 'dewy_tokens.dewy'
use 'dewy_syntax.dewy'
use 'dewy_grammar.dewy'
use 'dewy_direct.jo'
use 'place_methods.jo'
use 'dewy_directives.jo'
use 'directives.jo'
use 'dewy_ffi.jo'
use 'literals.dewy'
use 'dewy_lex.dewy'

# Active reader state; nested interpolation and lazy-body reads save/restore the
# same individual fields as before. The name-class cache survives file changes.
dc_parser: ParserContext
dn_angles = 0
dn_depth = 0

# Like the implementation-language lexer, classify interned words by ID. Names
# added after this table cannot be keywords; formatting keeps its noninterning
# path so editing a document does not grow the compiler's persistent name pool.
dn_word_tokens: DewyToken[]
dn_true_id = 0
dn_false_id = 0
dn_is_id = 0
dn_isnt_id = 0
dn_in_id = 0
dn_no_id = 0
dn_end_id = 0
dn_type_id = 0
dn_none_id = 0
dn_new_id = 0
dn_void_id = 0

# Reserved words cannot be bound; the reference grammar reports them.
dn_reserved_words: bool[]
dn_reserved = (name: int) -> bool: name < dn_reserved_words.len() and dn_reserved_words[name]

dn_init_words = ():
    dn_no_id = intern("no")
    dn_end_id = intern("end")
    dn_type_id = intern("type")
    dn_none_id = intern("none")
    dn_new_id = intern("new")
    dn_void_id = intern("void")
    dn_reserved_words = fill(false, names.len())
    loop word in [dn_end_id, dn_new_id, dn_none_id, dn_void_id]: dn_reserved_words[word] = true
    dn_true_id = intern("true")
    dn_false_id = intern("false")
    dn_is_id = intern("is")
    dn_isnt_id = intern("isnt")
    dn_in_id = intern("in")
    words = ["as", "and", "break", "const", "continue", "else", "from", "import", "if", "in", "let", "loop", "parallel", "concurrent", "spawn", "match", "not", "of", "or", "or_throw", "return", "test", "transmute", "xor", "nand", "nor", "xnor"]
    loop word in words: intern(word)
    dn_word_tokens = fill(DewyToken.none, names.len())
    loop word in words: dn_word_tokens[intern(word)] = dn_token_kind(word)

# (above 0: parsing the expression of a string interpolation)
dn_in_interpolation = 0
DN_BRACE_HINT = "`\{...}` in a string holds an expression: write `\\\{` and `\\\}` for literal braces, or use a raw string `r\"...\"`"

dn_error = (offset: int, message: str) -> int:
    if dn_in_interpolation > 0: fatal(mkpos(dc_parser.file, offset), "{message}, inside a string interpolation ({DN_BRACE_HINT}; `format(value \".2f\")` formats a number)")
    fatal(mkpos(dc_parser.file, offset), message)
    0

# The scanners' state (dewy_lex.dewy): the braces a string's mistake notes, and the mistake
dn_lexer = DewyLexer(-1, -1, "", -1, -1)

# Block comments seen by the last lexing pass ([start, end) pairs), for layout.
dn_block_comments: int[]

# (metatag tokens lexed since the count was reset: a source without any holds no settings)
dn_metatags = 0

# A library module's function bodies (`=> {...}` outside any bracket) lexed as one lazy_body
# token each, its braces included: their bytes are skipped, not tokenized (dewy_direct.jo's
# dc_lib_lazy). A body with what parsing must see at once (dewy_lex.dewy dx_lazy_end) is lexed.
dn_skip_bodies = false

# the lexer's mistake (dewy_lex.dewy), reported
dn_lex_problem = () -> int:
    if dn_lexer.note_at >= 0:
        err_notes.push((mkpos(dc_parser.file, dn_lexer.note_at), "note: this `\{` starts a string interpolation; for a literal brace write `\\\{`"))
    dn_error(dn_lexer.problem_at, dn_lexer.problem)

# (a closing interpolation brace: dewy_lex.dewy dn_interpolation_end)
dn_interpolation_close = (source: str, start: int, stop: int) -> int:
    e = dn_interpolation_end(dn_lexer, source, start, stop, 0, false)
    if e < 0: dn_lex_problem()
    e

# (the end of the quoted string at start in the bytes being lexed: dewy_lex.dewy dx_quote_end)
dn_quote_close = (bytes: *u8, start: int, stop: int, raw: bool) -> int:
    e = dx_quote_end(dn_lexer, bytes, start, stop, 0, raw, false)
    if e < 0: dn_lex_problem()
    e

dn_ident_start = (c: u8) -> bool: is_alpha(c) or c == '_' or c >= 128

dn_matches = (source: *u8, at: int, stop: int, value: str) -> bool:
    if len(value) > stop - at: return false
    loop i in [0..len(value)):
        if source[at + i] != value[i]: return false
    true

# Dispatch punctuation by its leading byte, trying only relevant longer
# spellings. Canonical token text avoids allocating a string per punctuation.
dn_lex_symbol = (source: *u8, at: int, stop: int) -> DewyToken:
    match source[at]:
        '%':
            if dn_matches(source, at, stop, "%="): return .percent_assign
        '*':
            if dn_matches(source, at, stop, "*="): return .star_assign
        '+':
            if dn_matches(source, at, stop, "+="): return .plus_assign
        '-':
            if dn_matches(source, at, stop, "->"): return .arrow
            if dn_matches(source, at, stop, "-="): return .minus_assign
        '.':
            if at + 1 < stop:
                match source[at + 1]:
                    '%':
                        if dn_matches(source, at, stop, ".%="): return .dot_percent_assign
                        if dn_matches(source, at, stop, ".%"): return .dot_percent
                    '*':
                        if dn_matches(source, at, stop, ".*="): return .dot_star_assign
                        if dn_matches(source, at, stop, ".*"): return .dot_star
                    '+':
                        if dn_matches(source, at, stop, ".+="): return .dot_plus_assign
                        if dn_matches(source, at, stop, ".+"): return .dot_plus
                    '-':
                        if dn_matches(source, at, stop, ".-="): return .dot_minus_assign
                        if dn_matches(source, at, stop, ".-"): return .dot_minus
                    '.':
                        if dn_matches(source, at, stop, "..."): return .ellipsis
                        if dn_matches(source, at, stop, ".."): return .range
                    '/':
                        if dn_matches(source, at, stop, ".//="): return .dot_floor_assign
                        if dn_matches(source, at, stop, "./="): return .dot_slash_assign
                        if dn_matches(source, at, stop, ".//"): return .dot_floor
                        if dn_matches(source, at, stop, "./"): return .dot_slash
                    '<':
                        if dn_matches(source, at, stop, ".<=?"): return .dot_le
                        if dn_matches(source, at, stop, ".<?"): return .dot_lt
                    '=':
                        if dn_matches(source, at, stop, ".=?"): return .dot_eq
                    '>':
                        if dn_matches(source, at, stop, ".>=?"): return .dot_ge
                        if dn_matches(source, at, stop, ".>?"): return .dot_gt
                    '^':
                        if dn_matches(source, at, stop, ".^="): return .dot_power_assign
                        if dn_matches(source, at, stop, ".^"): return .dot_caret
                    'n':
                        if dn_matches(source, at, stop, ".not>=?"): return .dot_not_ge
                        if dn_matches(source, at, stop, ".not<=?"): return .dot_not_le
                        if dn_matches(source, at, stop, ".not=?"): return .dot_not_eq
                        if dn_matches(source, at, stop, ".not>?"): return .dot_not_gt
                        if dn_matches(source, at, stop, ".not<?"): return .dot_not_lt
        '/':
            if dn_matches(source, at, stop, "//="): return .floor_assign
            if dn_matches(source, at, stop, "/="): return .slash_assign
            if dn_matches(source, at, stop, "//"): return .floor
        ':':
            if dn_matches(source, at, stop, ":>"): return .returns
        '<':
            if dn_matches(source, at, stop, "<=?"): return .le
            if dn_matches(source, at, stop, "<<="): return .shl_assign
            if dn_matches(source, at, stop, "<?"): return .lt
            if dn_matches(source, at, stop, "<<"): return .shl
            if dn_matches(source, at, stop, "<|"): return .pipe_left
        '=':
            if dn_matches(source, at, stop, "=>"): return .function
            if dn_matches(source, at, stop, "=?"): return .eq
        '>':
            if dn_matches(source, at, stop, ">=?"): return .ge
            # Nested generic closers before => are >> then =>, not >>= then >.
            if dn_matches(source, at, stop, ">>=") and not dn_matches(source, at, stop, ">>=>"): return .shr_assign
            if dn_matches(source, at, stop, ">?"): return .gt
            if dn_matches(source, at, stop, ">>"): return .shr
        '?':
            if dn_matches(source, at, stop, "??"): return .coalesce
        '^':
            if dn_matches(source, at, stop, "^="): return .power_assign
        '|':
            if dn_matches(source, at, stop, "|>"): return .pipe_right
            if dn_matches(source, at, stop, "|="): return .pipe_assign
        '&':
            if dn_matches(source, at, stop, "&="): return .amp_assign
    dn_single_token(source[at])

# The hot punctuation path needs only two bounded byte loads and a table
# lookup. A `none` entry delegates longer spellings (and errors) to the
# complete scanner. Store width beside the token so scanning does not
# materialize token text.
dn_classes: u8[]
dn_symbols: DewyToken[]
dn_symbol_widths: int[]
dn_init_symbols = ():
    dn_classes = fill(u8(0), 256)
    loop c in [0..256):
        bits = int(lx_cls[c])
        if is_digit(u8(c)) or c == '_': bits |= 4
        if is_digit(u8(c)) or is_alpha(u8(c)) or c == '_': bits |= 8
        if c == ' ' or c == '\t' or c == '\r' or c == '\n': bits |= 16
        # (an identifier byte whose name needs no second look: see dn_identifier_canonical)
        # (a non-ASCII name byte ends the ordinary scan: the name has another spelling to settle)
        if bits & 2 != 0 and c >= 0x80: bits = (bits & ~2) | 32
        dn_classes[c] = u8(bits)
    dn_symbols = fill(DewyToken.none, 128 * 128)
    longer = fill(false, 128 * 128)
    dn_symbol_widths = fill(0, int(DewyToken.kw_or_throw) + 1)
    loop i in [1..int(DewyToken.kw_or_throw) + 1):
        text = dn_token_text(DewyToken(i))
        width = len(text)
        dn_symbol_widths[i] = width
        if width == 0 or dn_ident_start(text[0]): continue
        first = int(text[0]) * 128
        if width == 1:
            token = DewyToken(i)
            loop next in [0..128): dn_symbols[first + next] = token
    loop i in [1..int(DewyToken.kw_or_throw) + 1):
        text = dn_token_text(DewyToken(i))
        if len(text) < 2 or dn_ident_start(text[0]): continue
        slot = int(text[0]) * 128 + int(text[1])
        if len(text) > 2:
            longer[slot] = true
            dn_symbols[slot] = .none
        else if not longer[slot]: dn_symbols[slot] = DewyToken(i)

# One spelling per name: subscript digits are `_` and digits (`x₁₂` is `x_12`, and
# adjacent runs combine: `x₁_2`), superscript digits `‾` and digits (`x¹²` is `x‾12`),
# and the micro sign is Greek mu. (Only names with non-ASCII bytes come here.)
dn_identifier_canonical = (s: str) -> str:
    out = ""
    run = 0             # 1 after subscript digits, 2 after superscript digits
    i = 0
    n = len(s)
    loop i < n:
        c = s[i]
        digit = -1
        kind = 0
        width = 1
        if c == 0xE2 and i + 2 < n and s[i + 1] == 0x82 and s[i + 2] >= 0x80 and s[i + 2] <= 0x89:
            digit = int(s[i + 2]) - 0x80; kind = 1; width = 3
        else if c == 0xE2 and i + 2 < n and s[i + 1] == 0x81 and (s[i + 2] == 0xB0 or s[i + 2] >= 0xB4 and s[i + 2] <= 0xB9):
            digit = int(s[i + 2]) - 0xB0; kind = 2; width = 3
        else if c == 0xC2 and i + 1 < n and (s[i + 1] == 0xB9 or s[i + 1] == 0xB2 or s[i + 1] == 0xB3):
            digit = if s[i + 1] == 0xB9: 1 else if s[i + 1] == 0xB2: 2 else: 3
            kind = 2; width = 2
        else if (c == '_' or c == 0xE2 and i + 2 < n and s[i + 1] == 0x80 and s[i + 2] == 0xBE) and i + (if c == '_': 1 else: 3) < n and is_digit(s[i + (if c == '_': 1 else: 3)]):
            # (`_12` and `‾12`: the marker, then its digits)
            kind = if c == '_': 1 else: 2
            i += if c == '_': 1 else: 3
            if run != kind: out += if kind == 1: "_" else: "‾"
            loop i < n and is_digit(s[i]):
                out += s[i..i + 1)
                i += 1
            run = kind
            continue
        if digit >= 0:
            if run != kind: out += if kind == 1: "_" else: "‾"
            out += "{digit}"
            run = kind
            i += width
            continue
        if c == 0xC2 and i + 1 < n and s[i + 1] == 0xB5:
            out += "μ"
            i += 2
            run = 0
            continue
        out += s[i..i + 1)
        run = 0
        i += 1
    out

# `and=` `or=` `xor=`: a word operator directly followed by `=` (not `=?` or `=>`).
dn_word_assign = (word: DewyToken, bytes: *u8, at: int, stop: int) -> DewyToken:
    if at >= stop or bytes[at] != '=': return .none
    if at + 1 < stop and (bytes[at + 1] == '?' or bytes[at + 1] == '>' or bytes[at + 1] == '='): return .none
    if word == .kw_and: return .and_assign
    if word == .kw_or: return .or_assign
    if word == .kw_xor: return .xor_assign
    .none

dn_lex = (file: int, begin: int, stop: int, intern_names: bool = true) -> DewyLexeme[]:
    if intern_names and dn_word_tokens.len() == 0: dn_init_words()
    source = files[file].src
    # Hold the immutable string while scanning its bounded byte span. The
    # guards below are against stop, including interpolation subexpressions.
    assert(begin >= 0 and begin <= stop and stop <= len(source))
    bytes = source.data()
    if lx_cls == null: lx_init_classes()
    if dn_symbols.len() == 0: dn_init_symbols()
    classes = data(dn_classes)
    symbols = data(dn_symbols)
    widths = data(dn_symbol_widths)
    out: DewyLexeme[]
    capacity = (stop - begin) / 2 + 1
    out.resize(capacity)
    slots = data(out)
    count = 0
    dn_block_comments = []
    i = begin
    spaced = false
    newline = false
    skip = dn_skip_bodies
    nesting = 0
    loop i < stop:
        c = bytes[i]
        if classes[c] & 16 != 0:
            spaced = true
            if c == '\n': newline = true
            i += 1
            loop i < stop:
                c = bytes[i]
                if c == '\n': newline = true
                else if classes[c] & 16 == 0: break
                i += 1
            continue
        # (a `\` ending a line cancels that line break: the next line continues this one)
        if c == '\\':
            e = i + 1
            loop e < stop and (bytes[e] == ' ' or bytes[e] == '\t' or bytes[e] == '\r'): e += 1
            if e < stop and bytes[e] == '\n':
                spaced = true
                i = e + 1
                continue
        if c == '#' and i + 1 < stop and bytes[i + 1] == '{':
            e = dx_block_comment_end(bytes, i, stop)
            if e < 0:
                dx_block_comment_error(dn_lexer, i)
                dn_lex_problem()
            dn_block_comments.push(i)
            dn_block_comments.push(e)
            # (a comment over several lines separates like a line break)
            if find_byte(source[i..e), '\n') >= 0: newline = true
            spaced = true
            i = e
            continue
        if c == '#':
            loop i < stop and bytes[i] != '\n': i += 1
            spaced = true
            continue
        start = i
        kind = DewyKind.op
        symbol = DewyToken.none
        name: i32 = 0
        if c == 'r' and i + 1 < stop and (bytes[i + 1] == '"' or bytes[i + 1] == '\''):
            i = dn_quote_close(bytes, i + 1, stop, true)
            kind = .rawquoted
        else if classes[c] & 1 != 0:
            if c >= 0x80:
                # (`x₁₂`: the ASCII scan stopped at `₁`; the name is the token before and this)
                if count > 0 and slots[count - 1].stop == start and slots[count - 1].kind == .identifier:
                    count -= 1
                    start = slots[count].start
                    spaced = slots[count].space
                    newline = slots[count].newline
                    i = start
                loop i < stop and classes[bytes[i]] & 34 != 0: i += 1
            else:
                i += 1
                loop i < stop and classes[bytes[i]] & 2 != 0: i += 1
            kind = .identifier
            if intern_names:
                id = if c >= 0x80: intern(dn_identifier_canonical(source[start..i))) else: intern_sub(source, start, i - start)
                name = i32(id)
                if id < dn_word_tokens.len(): symbol = dn_word_tokens[id]
                if id == dn_true_id or id == dn_false_id: kind = .boolean
                combined = dn_word_assign(symbol, bytes, i, stop)
                if combined != .none:
                    symbol = combined
                    kind = .op
                    i += 1
                if i < stop and bytes[i] == '?':
                    query = DewyToken.none
                    if id == dn_is_id: query = .is_type
                    else if id == dn_isnt_id: query = .isnt_type
                    else if id == dn_in_id: query = .contains
                    if query != .none:
                        symbol = query
                        kind = .op
                        i += 1
            else:
                value = source[start..i)
                if value == "true" or value == "false": kind = .boolean
                if (value == "is" or value == "isnt" or value == "in") and i < stop and bytes[i] == '?':
                    value += "?"
                    i += 1
                    kind = .op
                if kind != .boolean: symbol = dn_token_kind(value)
                combined = dn_word_assign(symbol, bytes, i, stop)
                if combined != .none:
                    symbol = combined
                    kind = .op
                    i += 1
        else if c == '$':
            dn_metatags += 1
            i += 1
            loop i < stop and classes[bytes[i]] & 2 != 0: i += 1
            if i == start + 1: dn_error(start, "expected a name after $")
            kind = .metatag
        else if is_digit(c):
            decimal = true
            digits = start
            if c == '0' and i + 1 < stop and find_byte("btqsodzxug", bytes[i + 1]) >= 0:
                decimal = bytes[i + 1] == 'd'
                i += 2
                digits = i
            if i < stop and (bytes[i] == '"' or bytes[i] == '\''):
                i = dn_quote_close(bytes, i, stop, false)
                kind = .based_string
            else:
                mask: u8 = if decimal: 4 else: 8
                loop i < stop and classes[bytes[i]] & mask != 0: i += 1
                if i == digits: dn_error(start, "expected digits after the base prefix")
                kind = if decimal: DewyKind.source_integer else: DewyKind.integer
                if decimal and i + 1 < stop and bytes[i] == '.' and is_digit(bytes[i + 1]):
                    i += 1
                    loop i < stop and classes[bytes[i]] & 4 != 0: i += 1
                    kind = .source_real
                if decimal and i + 1 < stop and (bytes[i] == 'e' or bytes[i] == 'E') and (is_digit(bytes[i + 1]) or bytes[i + 1] == '+' or bytes[i + 1] == '-'):
                    i += 1
                    if i < stop and (bytes[i] == '+' or bytes[i] == '-'): i += 1
                    first = i
                    loop i < stop and classes[bytes[i]] & 4 != 0: i += 1
                    if i == first: dn_error(start, "expected exponent digits")
                    kind = .source_real
        else if c == '"' or c == '\'':
            i = dn_quote_close(bytes, i, stop, false)
            kind = .quoted
        else:
            next: u8 = 0
            if start + 1 < stop: next = bytes[start + 1]
            if c < 128 and next < 128: symbol = symbols[int(c) * 128 + int(next)]
            if symbol == .none:
                symbol = dn_lex_symbol(bytes, start, stop)
                if symbol == .none: dn_error(start, "unexpected character in Dewy source")
            i += widths[int(symbol)]
        if count == capacity:
            capacity *= 2
            out.resize(capacity)
            slots = data(out)
        slots[count].kind = kind
        slots[count].name = name
        slots[count].start = start
        slots[count].stop = i
        slots[count].space = spaced
        slots[count].newline = newline
        slots[count].symbol = symbol
        count += 1
        spaced = false
        newline = false
        if skip and symbol != .none:
            if symbol == .lparen or symbol == .lbrack or symbol == .lbrace: nesting += 1
            else if symbol == .rparen or symbol == .rbrack or symbol == .rbrace: nesting -= 1
            else if symbol == .function and nesting == 0:
                j = i
                loop j < stop and (bytes[j] == ' ' or bytes[j] == '\t'): j += 1
                if j < stop and bytes[j] == '{':
                    e = dx_lazy_end(bytes, j, stop)
                    if e > 0:
                        if count == capacity:
                            capacity *= 2
                            out.resize(capacity)
                            slots = data(out)
                        slots[count].kind = .lazy_body
                        slots[count].name = 0
                        slots[count].start = j
                        slots[count].stop = e
                        slots[count].space = j > i
                        slots[count].newline = false
                        slots[count].symbol = .none
                        count += 1
                        dn_lazy_left = true
                        i = e
    out.truncate(count)
    out.push(DewyLexeme(.eof, 0, stop, stop, spaced, newline))
    out

# Tokens contain only scalar tags, name IDs and source spans. Materialize text
# only when projection needs a literal payload; grammar lookahead copies no
# reference-counted strings. Formatting uses the spans and tags directly.
dn_payload = (token: DewyLexeme) -> str:
    if token.symbol != .none: return dn_token_text(token.symbol)
    if token.name != 0: return name_of(int(token.name))
    source = files[dc_parser.file].src
    first = token.start
    if token.kind == .metatag: return source[first + 1..token.stop)
    if token.kind == .integer:
        return source[first..first + 2) + ":" + source[first + 2..token.stop)
    if token.kind == .based_string:
        return source[first..first + 2) + ":" + source[first + 3..token.stop - 1)
    if (token.kind == .source_integer or token.kind == .source_real) and first + 1 < token.stop and source[first] == '0' and source[first + 1] == 'd': first += 2
    source[first..token.stop)

dn_peek = () -> DewyToken: dc_parser.tokens[dc_parser.at].symbol
dn_take = () -> DewyLexeme:
    value = dc_parser.tokens[dc_parser.at]
    dc_parser.at += 1
    value

dn_accept = (symbol: DewyToken) -> bool:
    if dn_peek() != symbol: return false
    dc_parser.at += 1
    true

# A statement's `;` is attached to it, `f();`: an unattached one (after a space or
# on its own line) ends a row of an array literal, `[1 2 ; 3 4]`
dn_rows = false
dn_accept_semi = () -> bool:
    if dn_peek() != .semi: return false
    token = dc_parser.tokens[dc_parser.at]
    if dn_rows and (token.space or token.newline): return false
    if token.space or token.newline: dn_error(token.start, "an unattached `;` is reserved for array-dimension selection: attach it to the statement it ends, `f();`, or leave it out")
    dc_parser.at += 1
    true

dn_node = (kind: DewyKind, text: str, offset: int, children: int[] = [], name: i32 = 0) -> int: syntax_node(dewy_syntax, kind, text, mkpos(dc_parser.file, offset), children, name)

# String decoding is shared; the construction target selects syntax nodes for
# the reference parser or compact nodes for the value parser.
dn_text = (text: str, offset: int) -> int:
    n = mk(.str_lit, mkpos(dc_parser.file, offset))
    nodes[n].sval = i32(intern(text))
    n

# (a mistake in a string's escapes: one stops the compile)
dn_string_problem = LiteralProblem("", 0, false)
dn_string = (token: DewyLexeme) -> int:
    source = files[dc_parser.file].src
    raw = token.kind == .rawquoted
    opening = token.start
    if raw: opening += 1
    width = dn_quote_width(source, opening, token.stop)
    i = opening + width
    stop = token.stop - width
    if raw: return dn_text(source[i..stop), token.start)
    chunks: int[]
    bytes_: u8[]
    chunk_start = i
    interpolated = false
    loop i < stop:
        # (literals.dewy reads the text up to an interpolation)
        i = literal_string_text(dn_string_problem, bytes_, source, i, stop)
        if len(dn_string_problem.message) > 0: dn_error(dn_string_problem.at, dn_string_problem.message)
        if i >= stop: break
        interpolated = true
        if bytes_.len() > 0:
            chunks.push(dn_text(str_from_bytes(bytes_), chunk_start))
            bytes_.clear()
        first = i + 1
        i = dn_interpolation_close(source, first, stop)
        # (`{x:.2f}`: a format spec after the value's last top-level colon)
        colon = dn_spec_colon(dn_lexer, source, first, i)
        saved_tokens = dc_parser.tokens
        saved_at = dc_parser.at
        saved_angles = dn_angles
        saved_comma = dc_parser.flags.comma_stop
        dc_parser.tokens = dn_lex(dc_parser.file, first, if colon >= 0: colon else: i)
        dc_parser.at = 0
        dn_angles = 0
        dc_parser.flags.comma_stop = false
        dn_in_interpolation += 1
        expression = dc_expr(0)
        if expression != 0 and dc_parser.tokens[dc_parser.at].kind != .eof: dn_error(dc_parser.tokens[dc_parser.at].start, "expected one interpolation expression")
        dn_in_interpolation -= 1
        dc_parser.tokens = saved_tokens
        dc_parser.at = saved_at
        dn_angles = saved_angles
        dc_parser.flags.comma_stop = saved_comma
        spec = if colon >= 0: source[colon + 1..i) else: ""
        if expression == 0: return 0
        part = mk(.pair, mkpos(dc_parser.file, first))
        nodes[part].a = i32(expression)
        nodes[part].sval = if colon >= 0: i32(intern(spec)) else: -1
        chunks.push(part)
        i += 1
        chunk_start = i
    if not interpolated: return dn_text(str_from_bytes(bytes_), token.start)
    if bytes_.len() > 0: chunks.push(dn_text(str_from_bytes(bytes_), chunk_start))
    n = mk(.str_lit, mkpos(dc_parser.file, token.start))
    nodes[n].aux = 1
    set_list(n, chunks)
    n

# Splitting a generic closer edits its token in place. While a direct declaration
# may still retry the reference grammar, the original tokens are kept to restore.
dn_edits_on = false
dn_edit_at: int[]
dn_edit_was: DewyLexeme[]

dn_token_edit = (at: int):
    if not dn_edits_on: return
    dn_edit_at.push(at)
    dn_edit_was.push(dc_parser.tokens[at])

# Undo the edits recorded after `mark` (an abandoned attempt's), the latest first. An entry
# -(k + 1) is a setting scope the attempt set (dc_unsafe_scope): scopes from k on go;
# DN_EDIT_BIGINT, the module's bigint import the attempt asked for (dc_bigint_value); below it,
# DN_EDIT_BIGINT - n, the place type written for function n (dc_function_literal); below
# DN_EDIT_LIVE, DN_EDIT_LIVE - n, node n marked a live loop's source (dc_head_term).
const DN_EDIT_BIGINT = -1099511627776
const DN_EDIT_LIVE = -1125899906842624
# (below DN_EDIT_METHODS, DN_EDIT_METHODS - k: the method groups from k on, dc_literal_methods)
const DN_EDIT_METHODS = -36028797018963968
# (`kept`: the direct nodes stay, compare mode's: their place and live-source marks stay too)
dn_edits_undo = (mark: int = 0, kept: bool = false):
    i = dn_edit_at.len() - 1
    loop i >= mark:
        at = dn_edit_at[i]
        if at == DN_EDIT_BIGINT: dw_bigint_import = 0
        else if at < DN_EDIT_BIGINT:
            if kept: at = 0
            else if at <= DN_EDIT_METHODS: dewy_methods.truncate(DN_EDIT_METHODS - at)
            else if at <= DN_EDIT_LIVE: dewy_live_sources.remove(DN_EDIT_LIVE - at)
            else: place_written.remove(DN_EDIT_BIGINT - at)
        else if at < 0: dir_scopes.truncate(-at - 1)
        else: dc_parser.tokens[at] = dn_edit_was[i]
        i -= 1
    dn_edits_clear(mark)

dn_edits_clear = (mark: int = 0):
    dn_edit_at.truncate(mark)
    dn_edit_was.truncate(mark)

# A generic closer joined to what follows (`>>`, `>=`, `>?` unspaced) closes one angle:
# its first `>` is consumed in place, leaving the rest for the enclosing grammar.
dn_closer_joined = () -> bool:
    op = dn_peek()
    op == .shr or op == .shr_assign or op == .angle_assign or (op == .gt and not dc_parser.tokens[dc_parser.at].space)

dn_split_closer = ():
    dn_token_edit(dc_parser.at)
    dc_parser.tokens[dc_parser.at].start += 1
    tail = dc_parser.tokens[dc_parser.at]
    dc_parser.tokens[dc_parser.at].symbol = dn_token_kind(files[dc_parser.file].src[tail.start..tail.stop))

dewy_fast_file = (file: int) -> int[]:
    dw_bigint_import = 0
    # (a reading may split generic closers: a retry restores them, dn_edits_undo)
    saved_edits_on = dn_edits_on
    dn_edits_on = true
    dc_parser.file = file
    dn_lexer.suspect_brace = -1
    dn_in_interpolation = 0
    dn_metatags = 0
    lib_lazy = dc_lib_lazy_allowed(file) and not dc_lazy_allowed(file)
    dn_lazy_left = false
    dn_skip_bodies = lib_lazy
    dc_parser.tokens = dn_lex(file, 0, len(files[file].src))
    dn_skip_bodies = false
    dw_dir_lexed(file)
    dc_lazy_on = dc_lazy_allowed(file)
    dc_lib_lazy = lib_lazy and not dc_lazy_on
    if dc_lazy_on:
        # Buffer even warnings preceding the first deferred declaration.
        dc_lazy_used = true
        dc_lazy_tokens[file] = dc_parser.tokens
    if dc_lib_lazy: dc_lib_lazy_files[file] = true
    dc_parser.at = 0
    dn_angles = 0
    dn_depth = 0
    dewy_syntax = [DewySyntax(.unknown, "", 0, []), DewySyntax(.inverted_comparison, "", 0, [])]
    declarations: int[]
    marked = 0
    shadowable_pos = 0
    loop dc_parser.tokens[dc_parser.at].kind != .eof:
        before = dc_parser.at
        syntax = dn_statement(true)
        tag = dw_test_tag(syntax)
        if tag != 0:
            if marked != 0: fatal(dewy_syntax[tag].pos, "a second `$test` line: one marks the function just after it")
            marked = dw_test_spec(tag)
            dewy_syntax.truncate(2)
            if dc_parser.at == before: dn_error(dc_parser.tokens[dc_parser.at].start, "expected a declaration")
            continue
        shadow_tag = dw_shadowable_tag(syntax)
        if shadow_tag != 0:
            if shadowable_pos != 0: fatal(dewy_syntax[shadow_tag].pos, "a second `$shadowable`: one marks the const just after it")
            if dc_parser.tokens[dc_parser.at].symbol != .kw_const: fatal(dewy_syntax[shadow_tag].pos, "`$shadowable` marks a module-level const: `$shadowable const name = ...`")
            shadowable_pos = dewy_syntax[shadow_tag].pos
            dewy_syntax.truncate(2)
            continue
        made = dw_top_declarations(syntax)
        if oom_files.len() > 0: made = oom_wrap_all(made)
        if shadowable_pos != 0:
            loop declaration in made: shadowable_decls[declaration] = true
            shadowable_pos = 0
        loop declaration in made: declarations.push(declaration)
        if marked != 0:
            dw_test_attach(marked, made)
            declarations.push(marked)
            marked = 0
        # Projection owns the retained data in the compact AST. Discard each
        # declaration's temporary syntax before parsing the next declaration.
        dewy_syntax.truncate(2)
        if dc_parser.at == before: dn_error(dc_parser.tokens[dc_parser.at].start, "expected a declaration")
    if proof_pending: dn_error(dc_parser.tokens[dc_parser.at].start, "$proof requires a following function declaration")
    if dir_bundles.len() > 0: dir_bundles_resolve()
    if dw_export_pos != 0: fatal(dw_export_pos, "`$export` marks a module-level function: put it before one, on its line or the line above")
    if marked != 0: fatal(nodes[marked].pos, "`$test` marks a module-level function: put it on the line just before one")
    if shadowable_pos != 0: fatal(shadowable_pos, "`$shadowable` marks a module-level const: put it just before one")
    if dc_lib_lazy:
        dc_lazy_tokens[file] = dc_parser.tokens
        dc_lib_lazy = false
    dc_parser.tokens = []
    dewy_syntax = []
    dn_edits_on = saved_edits_on
    dw_finish_declarations(declarations)

use 'checker_state.dewy'
byte_find = (s: str, sub: str, start: int = 0) -> int: find(s, sub, start)
byte_rfind = (s: str, sub: str) -> int: rfind(s, sub)
byte_match = (s: str, sub: str, at: int) -> bool:
    k = 0
    loop k < len(sub):
        if s[at + k] != sub[k]: return false
        k += 1
    true
sym_kinds = 0
sym_kind_of = (ordinal: int) -> SK: ordinal as SK

RefineSibWord:type=int64<overflow='wrap'>
ref_pair_op=(name:string):>bool=>{
    name =? "push" or name =? "pop" or name =? "insert" or name =? "remove" or name =? "clear" or name =? "extend" or name =? "truncate"
}
# The array fields of record t whose lengths a contract ties to array field at's, in either
# direction (`values:array<V length =? keys.length>`). O(fields x atoms).
ref_pair_tied=(t:RefineSibWord at:RefineSibWord):>array<int64>=>$unsafe {
    let tied:array<int64>=[]
    let si=RefineSibWord(types.ptr[t].st)
    if at <? 0 or at >=? RefineSibWord(structs.ptr[si].nfields) {return tied}
    let own=prune(RefineSibWord(fields.ptr[RefineSibWord(structs.ptr[si].fields) + at].type))
    if tkind(representation_type(own)) not=? 'array' {return tied}
    loop i in [0..RefineSibWord(structs.ptr[si].nfields)) {
        if i =? at {continue}
        let ft=prune(RefineSibWord(fields.ptr[RefineSibWord(structs.ptr[si].fields) + i].type))
        if tkind(representation_type(ft)) not=? 'array' {continue}
        let named=false
        if types.ptr[ft].kind =? 'refined' {
            loop atom in ref_predicates[RefineSibWord(types.ptr[ft].st)] {
                # (a bound on elements leaves the lengths free: ref_sib_in_place)
                if ref_sib_atom(atom) {continue}
                loop term in [atom.a atom.b] {
                    if term.kind =? 5 and term.value =? at and term.path.length =? 1 and term.path[0] =? -1 {named=true}
                }
            }
        }
        if types.ptr[own].kind =? 'refined' {
            loop atom in ref_predicates[RefineSibWord(types.ptr[own].st)] {
                if ref_sib_atom(atom) {continue}
                loop term in [atom.a atom.b] {
                    if term.kind =? 5 and term.value =? i and term.path.length =? 1 and term.path[0] =? -1 {named=true}
                }
            }
        }
        if named {tied.push(i)}
    }
    tied
}
# The field of record t named name, or -1. O(fields).
ref_pair_field=(t:RefineSibWord name:RefineSibWord):>int64=>$unsafe {
    let si=RefineSibWord(types.ptr[t].st)
    loop i in [0..RefineSibWord(structs.ptr[si].nfields)) {
        if RefineSibWord(fields.ptr[RefineSibWord(structs.ptr[si].fields) + i].name) =? name {return i}
    }
    -1
}
# The record whose tied field place is, when place can join a run: an array field whose length
# a contract ties to a sibling's, of a record no contract above holds, reached through names and
# literals. O(route + fields x atoms).
ref_pair_record=(place:RefineSibWord):>int64=>$unsafe {
    if nodes.ptr[place].kind not=? 'field' or nodes.ptr[place].aux <? 0 {return 0}
    let r=RefineSibWord(nodes.ptr[place].a)
    let t=representation_type(ntype(r))
    if not ref_dependent_record(t) or ref_dependent_ancestor(r) or ref_pair_tied(t RefineSibWord(nodes.ptr[place].aux)).length =? 0 {return 0}
    let route=r
    loop nodes.ptr[route].kind =? 'field' or nodes.ptr[route].kind =? 'index' {
        if nodes.ptr[route].kind =? 'index' {
            let selector=RefineSibWord(nodes.ptr[route].b)
            if nodes.ptr[route].aux not=? 0 or selector =? 0 {return 0}
            if nodes.ptr[selector].kind not=? 'int_lit' and not (nodes.ptr[selector].kind =? 'ident' and nodes.ptr[selector].aux =? int32(1)) {return 0}
        }
        route=RefineSibWord(nodes.ptr[route].a)
    }
    if nodes.ptr[route].kind not=? 'ident' or nodes.ptr[route].aux not=? int32(1) {return 0}
    r
}
# Do two routes name the same place: the same names, fields and selectors? Works on checked
# and unchecked nodes alike. O(route).
ref_pair_same=(a0:RefineSibWord b0:RefineSibWord):>bool=>$unsafe {
    let a=a0
    let b=b0
    loop depth in [0..32) {
        let ka=nodes.ptr[a].kind
        let kb=nodes.ptr[b].kind
        if ka not=? kb {return false}
        if ka =? 'ident' {return nodes.ptr[a].name =? nodes.ptr[b].name}
        if ka =? 'field' {
            if nodes.ptr[a].name not=? nodes.ptr[b].name {return false}
        }
        else if ka =? 'index' {
            let x=RefineSibWord(nodes.ptr[a].b)
            let y=RefineSibWord(nodes.ptr[b].b)
            if x =? 0 or y =? 0 or nodes.ptr[x].kind not=? nodes.ptr[y].kind {return false}
            if nodes.ptr[x].kind =? 'int_lit' and nodes.ptr[x].ival not=? nodes.ptr[y].ival {return false}
            if nodes.ptr[x].kind =? 'ident' and nodes.ptr[x].name not=? nodes.ptr[y].name {return false}
            if nodes.ptr[x].kind not=? 'int_lit' and nodes.ptr[x].kind not=? 'ident' {return false}
        }
        else {return false}
        a=RefineSibWord(nodes.ptr[a].a)
        b=RefineSibWord(nodes.ptr[b].a)
    }
    false
}
# Does an unchecked operand read the name root, call anything or leave? O(operand size).
ref_pair_touches=(n:RefineSibWord root:RefineSibWord depth:RefineSibWord):>bool=>$unsafe {
    if n =? 0 {return false}
    if depth >? 32 {return true}
    let k=nodes.ptr[n].kind
    if k =? 'ident' {
        if nodes.ptr[n].name =? root {return true}
        # (a function's name alone calls it when it takes nothing)
        let sym=lookup(RefineSibWord(nodes.ptr[n].name))
        return sym not=? 0 and (syms.ptr[sym].kind =? 'fns' or syms.ptr[sym].kind =? 'builtin' or syms.ptr[sym].kind =? 'alias_' or syms.ptr[sym].kind =? 'module' or syms.ptr[sym].kind =? 'reflected')
    }
    # (values and operators only: no call, block, `or_throw`, `?? return` or other exit, which
    # could see the record or leave it before the run ends)
    let plain=k =? 'int_lit' or k =? 'float_lit' or k =? 'str_lit' or k =? 'bool_lit' or k =? 'none_lit' or k =? 'null_lit' or k =? 'field' or k =? 'dotname' or k =? 'index' or k =? 'unary' or k =? 'binary' or k =? 'and_' or k =? 'or_' or k =? 'not_' or k =? 'coalesce' or k =? 'array' or k =? 'tuple' or k =? 'cast' or k =? 'range' or k =? 'namedarg' or k =? 'pair' or k =? 'hole'
    if not plain {return true}
    if nodes.ptr[n].a not=? 0 and ref_pair_touches(RefineSibWord(nodes.ptr[n].a) root depth + 1) {return true}
    if nodes.ptr[n].b not=? 0 and ref_pair_touches(RefineSibWord(nodes.ptr[n].b) root depth + 1) {return true}
    loop c in kids(n) {
        if ref_pair_touches(c root depth + 1) {return true}
    }
    false
}
# The root name of a route. O(route).
ref_pair_root=(r:RefineSibWord):>int64=>$unsafe {
    let route=r
    loop nodes.ptr[route].kind =? 'field' or nodes.ptr[route].kind =? 'index' {route=RefineSibWord(nodes.ptr[route].a)}
    RefineSibWord(nodes.ptr[route].name)
}
# The statement of block b at i, through an attached `;`.
ref_pair_unwrap=(s0:RefineSibWord):>int64=>$unsafe {
    let s=s0
    if nodes.ptr[s].kind =? 'block' and nkids(s) =? 1 {s=kid(s 0)}
    s
}
ref_pair_discard=(b:RefineSibWord):>void=>{
    ref_pair_outer=b
    ref_pair_outer_block=sibling_block
    ref_pair_outer_index=sibling_index
}
# The block and statement being checked, seen through a discarding block.
ref_pair_through=():>bool=>{
    ref_pair_outer not=? 0 and sibling_block =? ref_pair_outer
}
ref_pair_here_block=():>int64=>{
    if ref_pair_through() {return ref_pair_outer_block}
    sibling_block
}
ref_pair_here_index=():>int64=>{
    if ref_pair_through() {return ref_pair_outer_index}
    sibling_index
}
# Does the statement after the current one change the length of another tied field of r in
# place, with operands that cannot see r? O(statement).
ref_pair_follows=(r:RefineSibWord):>bool=>$unsafe {
    let b=ref_pair_here_block()
    let i=ref_pair_here_index()
    if b =? 0 or i <? 0 or i + 1 >=? nkids(b) {return false}
    let s=ref_pair_unwrap(kid(b i + 1))
    let e:RefineSibWord=0
    if nodes.ptr[s].kind =? 'exprstmt' {e=RefineSibWord(nodes.ptr[s].a)}
    # (`p.values.pop(at);` drops its value: `_ = p.values.pop(at)` until it is checked)
    if nodes.ptr[s].kind =? 'assign' and nodes.ptr[s].op =? int32(47) and nodes.ptr[RefineSibWord(nodes.ptr[s].a)].kind =? 'hole' {e=RefineSibWord(nodes.ptr[s].b)}
    if e =? 0 {return false}
    if nodes.ptr[e].kind not=? 'call' {return false}
    let callee=RefineSibWord(nodes.ptr[e].a)
    if nodes.ptr[callee].kind not=? 'field' or not ref_pair_op(name_of(RefineSibWord(nodes.ptr[callee].name))) {return false}
    let receiver=RefineSibWord(nodes.ptr[callee].a)
    if nodes.ptr[receiver].kind not=? 'field' or not ref_pair_same(RefineSibWord(nodes.ptr[receiver].a) r) {return false}
    # (an untied field's change checks nothing: it cannot close the run)
    if ref_pair_tied(representation_type(ntype(r)) ref_pair_field(representation_type(ntype(r)) RefineSibWord(nodes.ptr[receiver].name))).length =? 0 {return false}
    let root=ref_pair_root(r)
    loop c in kids(e) {
        if ref_pair_touches(c root 0) {return false}
    }
    true
}
# The role of the length operation n on place in a run: 0 none, else 1 when it opens the
# run, plus 2 when it closes it. Only the whole expression of the statement being checked.
ref_pair_role=(n:RefineSibWord place:RefineSibWord):>int64=>$unsafe {
    let b=ref_pair_here_block()
    let i=ref_pair_here_index()
    if b =? 0 or i <? 0 or i >=? nkids(b) {return 0}
    let s=ref_pair_unwrap(kid(b i))
    if nodes.ptr[s].kind not=? 'exprstmt' {return 0}
    if n not=? 0 and RefineSibWord(nodes.ptr[s].a) not=? n {return 0}
    # (a library operation, `p.keys.insert(k at)`: its receiver is the statement's)
    if n =? 0 {
        let e=RefineSibWord(nodes.ptr[s].a)
        if nodes.ptr[e].kind not=? 'call' or nodes.ptr[RefineSibWord(nodes.ptr[e].a)].kind not=? 'field' {return 0}
        if not ref_pair_same(RefineSibWord(nodes.ptr[RefineSibWord(nodes.ptr[e].a)].a) place) {return 0}
    }
    let r=ref_pair_record(place)
    if r =? 0 {return 0}
    let continuing=ref_pair_open not=? 0 and ref_pair_block =? b and ref_pair_index + 1 =? i and ref_pair_same(ref_pair_open r)
    if ref_pair_open not=? 0 and ref_pair_block =? b and ref_pair_index + 1 =? i and not continuing {fatal(nodes.ptr[place].pos "this statement was taken to continue the changes to {wit_text(ref_pair_open)}'s tied fields before it, but changes another record: name the record the same way in both")}
    let more=ref_pair_follows(r)
    ref_pair_open=if more {r} else {0}
    ref_pair_block=b
    ref_pair_index=i
    if not continuing and not more {return 0}
    let role:RefineSibWord=4
    if not continuing {role |= 1}
    if not more {role |= 2}
    role
}
ref_pair_reads=(r:RefineSibWord @before:array<int64> pos:RefineSibWord):>void=>{
    let held=refine_requests.length
    before.push(ref_pair_validation(r pos false))
    loop k in [held..refine_requests.length) {ref_pair_held[refine_requests[k].node]=true}
}
# The whole record r checked as it now is: every field's contract against its siblings, as a
# constructor checks it. The record is not rebuilt. O(fields).
ref_pair_validation=(r:RefineSibWord pos:RefineSibWord transient:bool=true):>int64=>$unsafe {
    let t=representation_type(ntype(r))
    let si=RefineSibWord(types.ptr[t].st)
    let held=refine_requests.length
    let args:array<int64>=[]
    loop i in [0..RefineSibWord(structs.ptr[si].nfields)) {
        let f=RefineSibWord(structs.ptr[si].fields) + i
        let field=bc_field(copy_place(r) name_of(RefineSibWord(fields.ptr[f].name)) pos)
        check_expr(field 0);
        field=copy_checked(last_checked)
        coerce(field RefineSibWord(fields.ptr[f].type));
        args.push(field)
    }
    let ctor=mk('call' pos)
    nodes.ptr[ctor]=Node(kind='call' pos=pos aux=2 type=int32(t) flags=int32(NF_CHECKED))
    set_list(ctor args)
    let s=bc_stmt(ctor pos)
    ref_pair_checks[s]=true
    if transient {
        ref_pair_stmts[s]=true
        let hint="help: the statements ending here change {wit_text(r)}'s tied fields together: they must leave every field's contract holding, so change each tied length by the same amount"
        loop k in [held..refine_requests.length) {ref_pair_hints[refine_requests[k].node]=hint}
    }
    s
}
# n, a member of a run, in place: the reads opening it, the operation, and the check closing it.
ref_pair_rewrite=(n:RefineSibWord r:RefineSibWord role:RefineSibWord place:RefineSibWord result_type:RefineSibWord):>int64=>$unsafe {
    let pos=nodes.ptr[n].pos
    let before:array<int64>=[]
    if role & 1 not=? 0 {ref_pair_reads(RefineSibWord(nodes.ptr[place].a) @before pos)}
    let operation=copy_checked(n)
    add_flag(operation NF_CHECKED)
    let result:RefineSibWord=0
    if result_type not=? T_VOID {result=capture_value(operation result_type @before)} else {before.push(bc_stmt(operation pos))}
    ref_pair_stmts[before[before.length - 1]]=true
    if role & 2 not=? 0 {before.push(ref_pair_validation(RefineSibWord(nodes.ptr[place].a) pos))}
    if result not=? 0 {before.push(bc_stmt(result pos))}
    let block=bc_block(before pos)
    nodes.ptr[n]=nodes.ptr[block]
    nodes.ptr[n].type=int32(result_type)
    nodes.ptr[n].aux=1
    add_flag(n NF_CHECKED)
    result_type
}
# A library operation in a run (`insert`): the call runs on the field itself.
ref_pair_call_finish=(n:RefineSibWord prepared:RefArrayCall):>int64=>$unsafe {
    let before=prepared.before
    let pos=nodes.ptr[n].pos
    before.push(bc_stmt(copy_checked(n) pos))
    ref_pair_stmts[before[before.length - 1]]=true
    let check=ref_pair_after.get(prepared.place)
    if check not=? none {before.push(check)}
    let block=bc_block(before pos)
    nodes.ptr[n]=nodes.ptr[block]
    nodes.ptr[n].type=int32(T_VOID)
    add_flag(n NF_CHECKED)
    T_VOID
}
# What a lone operation on a tied field is told: the fields its contract ties it to, and
# the paired operation. O(fields x atoms).
ref_pair_hint=(place:RefineSibWord op:string):>string=>$unsafe {
    let t=representation_type(ntype(RefineSibWord(nodes.ptr[place].a)))
    let at=RefineSibWord(nodes.ptr[place].aux)
    let si=RefineSibWord(types.ptr[t].st)
    let tied:array<string>=[]
    loop i in ref_pair_tied(t at) {tied.push(name_of(RefineSibWord(fields.ptr[RefineSibWord(structs.ptr[si].fields) + i].name)))}
    if tied.length =? 0 {return ""}
    let record=wit_text(RefineSibWord(nodes.ptr[place].a))
    let field=name_of(RefineSibWord(fields.ptr[RefineSibWord(structs.ptr[si].fields) + at].name))
    let others=""
    loop j in [0..tied.length) {
        let sep=if j =? 0 {""} else if j =? tied.length - 1 {" and "} else {", "}
        others="{others}{sep}`{record}.{tied[j]}`"
    }
    let them="it"
    if tied.length >? 1 {them="them"}
    let first=tied[0]
    let root=name_of(ref_pair_root(RefineSibWord(nodes.ptr[place].a)))
    "help: `{op}` changes {record}.{field}.length, and the record's contract ties it to {others}: change {them} too, in the statements right after this one (`{record}.{first}.{op}(...)`), with nothing between them and with operands that neither read `{root}`, call a function nor leave early"
}
ref_pair_op_name=(id:IN):>string=>{
    if id =? IN.push {return "push"}
    if id =? IN.pop {return "pop"}
    if id =? IN.insert {return "insert"}
    if id =? IN.remove {return "remove"}
    if id =? IN.clear {return "clear"}
    if id =? IN.extend {return "extend"}
    "truncate"
}
# ---------------- sibling-length elements (docs/LANGUAGE.md, records) ----------------
# `next:array<int64<(<? nodes.length)>>`: every element of a field is a valid index of a sibling
# array. The bound moves onto the field as one atom, every element (term kind 6) op the
# sibling's length (term kind 5), so it is a dependent field: construction, replacing either
# field and a sibling change made on a candidate check the record whole. A read of the field
# projects the bound as a value (FACT_SIB_BOUND), so an element read relates to the sibling's
# length. Stores and pushes into the field check the value against the sibling, in place;
# growing the sibling keeps the bound, in place. O(fields x atoms) once per record type.
ref_sib_atom=(atom:RefAtom):>bool=>{
    atom.a.kind =? 6 and atom.b.kind =? 5
}
# The element a value with a sibling or self-length bound holds: an array's element, or a
# dictionary's value.
ref_held_element=(t:RefineSibWord):>int64=>$unsafe {
    let r=representation_type(t)
    if is_map_type(r) {return struct_targ(RefineSibWord(types.ptr[r].st) 1)}
    RefineSibWord(types.ptr[r].elem)
}
ref_sib_contract=(t0:RefineSibWord):>bool=>$unsafe {
    let t=prune(t0)
    if types.ptr[t].kind not=? 'refined' {return false}
    loop atom in ref_predicates[RefineSibWord(types.ptr[t].st)] {
        if ref_sib_atom(atom) {return true}
    }
    false
}
# A field's type with its elements bounded by a sibling's length, as its contract; else 0.
ref_sib_field=(ft0:RefineSibWord name:RefineSibWord pos:RefineSibWord):>int64=>$unsafe {
    let ft=prune(ft0)
    let holder=ft
    if types.ptr[ft].kind =? 'refined' {holder=prune(RefineSibWord(types.ptr[ft].elem))}
    if types.ptr[holder].kind not=? 'array' {return 0}
    let element=prune(RefineSibWord(types.ptr[holder].elem))
    if types.ptr[element].kind not=? 'refined' {return 0}
    let made=ref_sib_bound(element name pos holder not=? ft)
    if made[0] =? 0 {return 0}
    let out=mk_refined(mk_array(made[0]) made[1])
    ref_self_elements[prune(out)]=made[2]
    out
}
# `edges:dict<string int64<(<? terminal.length)>>`: the values of a dictionary field bounded by a
# sibling's length, as the field's contract over its values, as for an array's elements; else 0.
ref_sib_dict_field=(ft0:RefineSibWord name:RefineSibWord pos:RefineSibWord total:bool):>int64=>$unsafe {
    let ft=prune(ft0)
    let holder=ft
    if types.ptr[ft].kind =? 'refined' {holder=prune(RefineSibWord(types.ptr[ft].elem))}
    if not is_map_type(holder) {return 0}
    let si=RefineSibWord(types.ptr[holder].st)
    let element=prune(struct_targ(si 1))
    if types.ptr[element].kind not=? 'refined' {return 0}
    let made=ref_sib_bound(element name pos false)
    if made[0] =? 0 {return 0}
    if total or holder not=? ft {fatal(pos "field '{name_of(name)}': a dictionary whose values a sibling's length bounds cannot be a totaldict or have a contract of its own as well")}
    runtime_fn("__first_live_value_above");
    # (made directly: a dictionary takes no refinement but this one, as a totaldict's)
    let out=mk_type(TypeInfo(kind='refined' elem=int32(get_struct_inst(RefineSibWord(structs.ptr[si].decl) [struct_targ(si 0) made[0]])) st=int32(made[1])) [])
    ref_self_elements[prune(out)]=made[2]
    out
}
# A written element refinement naming a sibling's length: the plain element type, the predicate
# every element meets and the stored element's type; (0, 0, 0) when it names no sibling.
ref_sib_bound=(element:RefineSibWord name:RefineSibWord pos:RefineSibWord contracted:bool):>[int64 int64 int64]=>$unsafe {
    let written=ref_predicates[RefineSibWord(types.ptr[element].st)]
    let named=false
    loop atom in written {
        if atom.b.kind =? 5 and ref_path_length(atom.b.path) or atom.a.kind =? 5 and ref_path_length(atom.a.path) {named=true}
    }
    if not named {return [0 0 0]}
    let field=name_of(name)
    if contracted {fatal(pos "field '{field}': an array whose elements a sibling's length bounds cannot have a length contract as well")}
    let base=RefineSibWord(types.ptr[element].elem)
    if has_var(base) or not type_eq(representation_type(base) T_INT) {fatal(pos "field '{field}': elements bounded by a sibling's length are int64 or addr, found {dt(base)}")}
    let rest:array<RefAtom>=[]
    let whole:array<RefAtom>=[]
    let stored:array<RefAtom>=[]
    loop atom in written {
        if atom.a.kind =? 5 or atom.b.kind =? 5 {
            let upper=atom.a.kind =? 0 and atom.a.path.length =? 0 and atom.b.kind =? 5 and ref_path_length(atom.b.path) and (atom.op =? 'lt' or atom.op =? 'le')
            if not upper {fatal(pos "field '{field}': a sibling's length bounds its elements only from above, `<? name.length` or `<=? name.length`, so that growing the sibling keeps it")}
            whole.push(RefAtom(atom.op RefTerm(6) RefTerm(5 atom.b.value path=[-1] offset=atom.b.offset)))
            stored.push(RefAtom(atom.op RefTerm(0) RefTerm(6 path=[-1] offset=atom.b.offset)))
        }
        else {rest.push(atom)}
    }
    # (an upper bound on a signed index means a valid index, unless a lower bound is written)
    if not ref_self_lower_bound(rest) {rest.push(RefAtom('le' RefTerm(1 0) RefTerm(0)))}
    let plain=mk_refined(base ref_intern(rest))
    let predicate=ref_intern(whole)
    let span=ref_spans.get(RefineSibWord(types.ptr[element].st)) ?? pos
    if not ref_spans.has(predicate) {ref_spans[predicate]=span}
    ref_self_active=true
    runtime_fn("__first_element_above");
    [plain predicate mk_refined(plain ref_intern(stored))]
}
# The bound every element of a value with the contract is at most: sibling length + c, as a value.
# One value per length and c, so reading the bound again adds no rows to the length, whose
# rows a tied field's relation needs (fact_difference keeps a few per term).
ref_sib_limit=(atom:RefAtom args:array<int64> @s:FactState extra:RefineSibWord=0):>int64=>{
    # (the sibling of the array a value is added to, as `extend` into it: the holder, kind 6)
    let kind=atom.b.kind
    if kind =? 5 and (atom.b.value >=? args.length or args[atom.b.value] =? 0) or kind =? 6 and ref_fact_holder =? 0 {return 0}
    let k=atom.b.offset + extra
    if atom.op =? 'lt' {k -= 1}
    let length=ref_value(RefTerm(kind atom.b.value path=[-1]) 0 args T_INT @s)
    if length =? 0 or k =? 0 or k <? -64 or k >? 64 {return ref_value(RefTerm(kind atom.b.value path=[-1] offset=k) 0 args T_INT @s)}
    # (reused only where this state's rows say it is exactly length + k: values are numbered again
    # for each function)
    let key=length * 256 + k + 128
    let cached=ref_sib_sums.get(key)
    if cached not=? none {
        let sum:RefineSibWord=cached
        let up=fact_row_find(s sum length)
        let down=fact_row_find(s length sum)
        if up >=? 0 and down >=? 0 and s.differences[up].limit =? k and s.differences[down].limit =? -k {return sum}
    }
    let sum=ref_value(RefTerm(kind atom.b.value path=[-1] offset=k) 0 args T_INT @s)
    ref_sib_sums[key]=sum
    sum
}
# (a value read again with another record, as after a call changed the sibling, holds each bound:
# up to four, each a projection of its own, so a read relates to every one directly)
ref_sib_assume=(@s:FactState self:RefineSibWord atom:RefAtom args:array<int64>):>void=>{
    if self =? 0 {return}
    let limit=ref_sib_limit(atom args @s)
    if limit =? 0 {return}
    let count:RefineSibWord=0
    let j=fact_projection_first(s self)
    loop j >=? 0 {
        let p=s.projections[j]
        j=fact_projection_after(s j)
        if p.element or p.selector not=? FACT_SIB_BOUND {continue}
        if p.value =? limit or fact_compare(s 'le' p.value limit) =? 1 {return}
        count += 1
    }
    if count >=? 4 or s.projections.length >=? FACT_CAP {return}
    fact_add_projection(@s FactProjection(self FACT_SIB_BOUND false limit))
    # (elements read before, as a call's summary keeps them: each is below the bound too)
    j=fact_projection_first(s self)
    loop j >=? 0 {
        let p=s.projections[j]
        j=fact_projection_after(s j)
        if p.element {fact_difference(@s p.value limit 0 0 16)}
    }
}
# An element read from a value known to hold sibling bounds: O(bounds).
ref_sib_element_row=(@s:FactState base:RefineSibWord v:RefineSibWord):>void=>{
    let j=fact_projection_first(s base)
    loop j >=? 0 {
        let p=s.projections[j]
        j=fact_projection_after(s j)
        if not p.element and p.selector =? FACT_SIB_BOUND {fact_difference(@s v p.value 0 0 16)}
    }
}
# A value read from a dictionary known to hold sibling bounds (`d[k]`, `d.pop(k)`, or the payload
# of `d.get(k)`): below each. O(bounds), nothing for any other dictionary.
ref_sib_map_read=(@s:FactState map:RefineSibWord result:RefineSibWord n:RefineSibWord):>void=>{
    if map =? 0 or result =? 0 or fact_projection_find(s map FACT_SIB_BOUND false) <? 0 {return}
    let v=result
    if tkind(ntype(n)) =? 'opt' {v=fact_project(@s result (-4) false telem(ntype(n)))}
    if is_int(fact_type(ntype(n))) or tkind(ntype(n)) =? 'opt' {ref_sib_element_row(@s map v)}
}
# A value from `d.pop(k default=x)` or `d.get(k x)` on such a dictionary: an entry's value, or x.
# Below each bound x is below (`none` has no value). O(bounds).
ref_sib_default_read=(@s:FactState map:RefineSibWord result:RefineSibWord dflt:RefineSibWord given:RefineSibWord n:RefineSibWord):>void=>$unsafe {
    if map =? 0 or result =? 0 or dflt =? 0 or fact_projection_find(s map FACT_SIB_BOUND false) <? 0 {return}
    let v=result
    if tkind(ntype(n)) =? 'opt' {v=fact_project(@s result (-4) false telem(ntype(n)))}
    if not is_int(fact_type(ntype(n))) and tkind(ntype(n)) not=? 'opt' {return}
    let x=dflt
    let literal=given
    loop nodes.ptr[literal].kind =? 'conv' {literal=RefineSibWord(nodes.ptr[literal].a)}
    let absent=nodes.ptr[literal].kind =? 'none_lit'
    if tkind(ntype(given)) =? 'opt' and not absent {x=fact_project(@s dflt (-4) false telem(ntype(given)))}
    if not absent and x =? 0 {return}
    let j=fact_projection_first(s map)
    loop j >=? 0 {
        let p=s.projections[j]
        j=fact_projection_after(s j)
        if p.element or p.selector not=? FACT_SIB_BOUND {continue}
        if absent or fact_compare(s 'le' x p.value) =? 1 {fact_difference(@s v p.value 0 0 16)}
    }
}
# Does every element of the value stay within the sibling bound? 1, 0 refuted, -1 unknown.
# O(inventory).
ref_sib_truth=(@s:FactState value:RefineSibWord atom:RefAtom args:array<int64>):>int64=>{
    if value =? 0 {return -1}
    let limit=ref_sib_limit(atom args @s)
    if limit =? 0 {return -1}
    let j=fact_projection_first(s value)
    loop j >=? 0 {
        let p=s.projections[j]
        j=fact_projection_after(s j)
        if not p.element and p.selector =? FACT_SIB_BOUND and fact_compare(s 'le' p.value limit) =? 1 {return 1}
    }
    let length=fact_project(@s value (-1) false T_INT)
    if length not=? 0 and fact_bound(s length).hi =? 0 {return 1}
    let parts=fact_inventory(s value)
    if parts.length >? 0 {
        let truth:RefineSibWord=1
        loop part in parts {
            let one=fact_compare(s 'le' part limit)
            if one =? 0 {return 0}
            if one <? 0 {truth=-1}
        }
        return truth
    }
    let copy=fact_projection_find(s value FACT_ELEMENT_COPY false)
    if copy >=? 0 and fact_compare(s 'le' s.projections[copy].value limit) =? 1 {return 1}
    let hull=fact_projection_find(s value FACT_ELEMENT_VALUE false)
    if hull >=? 0 {
        let hi=fact_bound(s s.projections[hull].value).hi
        if hi <? FACT_MAX and fact_compare(s 'le' fact_constant(@s hi) limit) =? 1 {return 1}
    }
    let below=fact_projection_find(s value FACT_ELEMENT_BELOW false)
    if below >=? 0 and fact_compare(s 'le' s.projections[below].value ref_sib_limit(atom args @s 1)) =? 1 {return 1}
    -1
}
# A dictionary literal's values against the bound: each an integer literal; else -1. O(entries).
ref_sib_literal_truth=(@s:FactState n:RefineSibWord atom:RefAtom args:array<int64>):>int64=>$unsafe {
    let v=RefineSibWord(nodes.ptr[n].a)
    loop v not=? 0 and nodes.ptr[v].kind =? 'conv' {v=RefineSibWord(nodes.ptr[v].a)}
    if v =? 0 or nodes.ptr[v].kind not=? 'map_lit' {return -1}
    if nkids(v) =? 0 {return 1}
    # (the constants first: a comparison sees the terms its state held before the bound)
    let values:array<int64>=[]
    loop pair in kids(v) {
        let x=RefineSibWord(nodes.ptr[pair].b)
        loop x not=? 0 and nodes.ptr[x].kind =? 'conv' {x=RefineSibWord(nodes.ptr[x].a)}
        if x =? 0 or nodes.ptr[x].kind not=? 'int_lit' {return -1}
        values.push(fact_constant(@s RefineSibWord(nodes.ptr[x].ival)))
    }
    let limit=ref_sib_limit(atom args @s)
    if limit =? 0 {return -1}
    let truth:RefineSibWord=1
    loop value in values {
        let one=fact_compare(s 'le' value limit)
        if one =? 0 {return 0}
        if one <? 0 {truth=-1}
    }
    truth
}
ref_sib_fail=(n:RefineSibWord t:RefineSibWord atom:RefAtom refuted:bool):>void=>$unsafe {
    let contract=ref_spans.get(RefineSibWord(types.ptr[t].st)) ?? 0
    let shown=wit_text(RefineSibWord(nodes.ptr[n].a))
    let dict=is_map_type(representation_type(t))
    if shown =? "" {shown=if dict {"this dictionary"} else {"this array"}}
    let sibling=ref_sib_name(atom n)
    let item="element"
    let one="an element"
    if dict {
        item="value"
        one="a value"
    }
    let what="cannot prove every {item} of {shown} is a valid index of {sibling}"
    if refuted {what="refinement refuted: {one} of {shown} is not a valid index of {sibling}"}
    let help="help: every element must be below the length of {sibling}: a literal, `fill` or elements known to be below it prove it; to make {sibling} shorter, first clear or shorten the array it bounds, or put `$runtime_checks` on this statement to check every element when it runs"
    if dict {help="help: every value must be below the length of {sibling}: a literal or values known to be below it prove it; to make {sibling} shorter, put `$runtime_checks` on this statement to check every value when it runs"}
    if ref_pair_hints.length >? 0 and ref_pair_hints.has(n) {err_notes.push([(-1) ref_pair_hints[n]])}
    if not refuted and dir_defer(n what true) {return}
    err_notes.push([(-1) help])
    wit_context(contract)
    wit_fail(nodes.ptr[n].pos what)
}
# The sibling's name for a diagnostic, from the record the checked value is a field of.
ref_sib_name=(atom:RefAtom n:RefineSibWord):>string=>$unsafe {
    if atom.b.kind =? 6 {return "`{wit_holder_text}`"}
    let v=RefineSibWord(nodes.ptr[n].a)
    if nodes.ptr[v].kind =? 'field' {
        let t=representation_type(ntype(RefineSibWord(nodes.ptr[v].a)))
        if tkind(t) =? 'struct_' {
            let si=RefineSibWord(types.ptr[t].st)
            if atom.b.value <? RefineSibWord(structs.ptr[si].nfields) {return "`{name_of(RefineSibWord(fields.ptr[RefineSibWord(structs.ptr[si].fields) + atom.b.value].name))}`"}
        }
    }
    "its sibling"
}
# Every element of a whole array value against the sibling: a loop, only under `$runtime_checks`.
ref_sib_gen=(n:RefineSibWord t:RefineSibWord atom:RefAtom self:RefineSibWord args:array<int64> arg_types:array<int64>):>void=>$unsafe {
    let length=if atom.b.kind =? 6 {ref_ir_holder_length()} else {ref_ir_term(RefTerm(5 atom.b.value path=[-1]) self args T_INT arg_types)}
    let k=atom.b.offset
    if atom.op =? 'lt' {k -= 1}
    let bound=e_bin('add' VI length e_iconst(k))
    let map=representation_type(t)
    let at:RefineSibWord=0
    if is_map_type(map) {
        # (a dictionary's values, but for removed entries': their positions are left zero)
        let si=RefineSibWord(types.ptr[map].st)
        let vals:RefineSibWord=0
        let gone:RefineSibWord=0
        loop i in [0..RefineSibWord(structs.ptr[si].nfields)) {
            let f=RefineSibWord(structs.ptr[si].fields) + i
            if name_of(RefineSibWord(fields.ptr[f].name)) =? "vals" {vals=load_val(RefineSibWord(fields.ptr[f].type) field_val_addr(f self) 0)}
            if name_of(RefineSibWord(fields.ptr[f].name)) =? "gone" {gone=load_val(RefineSibWord(fields.ptr[f].type) field_val_addr(f self) 0)}
        }
        at=e_call(rt("__first_live_value_above") [vals gone bound] VI)
    }
    else {at=e_call(rt("__first_element_above") [self bound] VI)}
    iff(e_bin('les' VI e_iconst(0) at));
    let message="refinement failed: an element is not a valid index of its sibling array"
    if is_map_type(map) {message="refinement failed: a value is not a valid index of its sibling array"}
    e_call_nr(rt("__requirement_fail") [e_daddr(str_data(message)) e_daddr(loc_data(nodes.ptr[n].pos)) e_daddr(str_data("the position of the element")) at e_daddr(str_data("the bound")) bound] (-1));
    endc();
}
# The sibling an element of field place is checked against, read again by the check; else 0.
ref_sib_holder=(place0:RefineSibWord):>int64=>$unsafe {
    let place=ref_place_alias(place0)
    let t=prune(refine_storage(place ntype(place)))
    if not ref_sib_contract(t) or nodes.ptr[place].kind not=? 'field' or nodes.ptr[place].aux <? 0 {return 0}
    let parent=RefineSibWord(nodes.ptr[place].a)
    let rt0=representation_type(ntype(parent))
    if tkind(rt0) not=? 'struct_' {return 0}
    let si=RefineSibWord(types.ptr[rt0].st)
    let j:RefineSibWord=-1
    loop atom in ref_predicates[RefineSibWord(types.ptr[t].st)] {
        if ref_sib_atom(atom) {j=atom.b.value}
    }
    if j <? 0 or j >=? RefineSibWord(structs.ptr[si].nfields) {return 0}
    let field=bc_field(copy_place(parent) name_of(RefineSibWord(fields.ptr[RefineSibWord(structs.ptr[si].fields) + j].name)) nodes.ptr[place].pos)
    check_expr(field 0);
    copy_checked(last_checked)
}
# Is field `at` of record t named by no contract but its own? O(fields x atoms).
ref_sib_unnamed=(t:RefineSibWord at:RefineSibWord):>bool=>$unsafe {
    let si=RefineSibWord(types.ptr[t].st)
    loop i in [0..RefineSibWord(structs.ptr[si].nfields)) {
        if i =? at {continue}
        let ft=prune(RefineSibWord(fields.ptr[RefineSibWord(structs.ptr[si].fields) + i].type))
        if types.ptr[ft].kind not=? 'refined' {continue}
        loop atom in ref_predicates[RefineSibWord(types.ptr[ft].st)] {
            loop term in [atom.a atom.b] {
                if term.kind =? 5 and term.value =? at {return false}
            }
        }
    }
    true
}
# Is field `at` of record t named only by sibling bounds on elements? O(fields x atoms).
ref_sib_only_bounds=(t:RefineSibWord at:RefineSibWord):>bool=>$unsafe {
    let si=RefineSibWord(types.ptr[t].st)
    let seen=false
    loop i in [0..RefineSibWord(structs.ptr[si].nfields)) {
        if i =? at {continue}
        let ft=prune(RefineSibWord(fields.ptr[RefineSibWord(structs.ptr[si].fields) + i].type))
        if types.ptr[ft].kind not=? 'refined' {continue}
        loop atom in ref_predicates[RefineSibWord(types.ptr[ft].st)] {
            loop term in [atom.a atom.b] {
                if term.kind not=? 5 or term.value not=? at {continue}
                if not ref_sib_atom(atom) {return false}
                seen=true
            }
        }
    }
    seen
}
# A length change in place on a record's field, when what it changes keeps the record's contract:
# a push or insert into a field bounded by a sibling (its value checked against the sibling), any
# shrink of such a field, or growing a sibling only such bounds name. Else false, for the
# candidate route. O(fields x atoms).
ref_sib_in_place=(n:RefineSibWord id:IN place0:RefineSibWord t:RefineSibWord):>bool=>$unsafe {
    let record=ref_sib_record(place0)
    if record =? 0 {return false}
    let at=RefineSibWord(nodes.ptr[ref_place_alias(place0)].aux)
    if ref_sib_contract(t) {
        if not ref_sib_free(place0 t) {return false}
        if id =? IN.pop or id =? IN.truncate or id =? IN.remove or id =? IN.clear {return true}
        if (id =? IN.push or id =? IN.insert) and nkids(n) >=? 2 {
            ref_self_value(kid(n 1) t 0 place0)
            return true
        }
        # (every extended element owes the sibling's length, checked once before it grows)
        if id =? IN.extend and nkids(n) =? 2 {
            let value=kid(n 1)
            refine_coerce(value ref_sib_extension(t));
            nodes.ptr[value].b=int32(ref_holder_place(place0))
            return true
        }
        return false
    }
    if types.ptr[prune(t)].kind =? 'refined' or not ref_sib_only_bounds(record at) {return false}
    id =? IN.push or id =? IN.insert or id =? IN.extend
}
# The type of an array added to a field bounded by a sibling: every element below the sibling's
# length (term kind 6, the array the value goes into), the field's own element bounds as well.
ref_sib_extension=(t0:RefineSibWord):>int64=>$unsafe {
    let t=prune(t0)
    let atoms:array<RefAtom>=[]
    loop atom in ref_predicates[RefineSibWord(types.ptr[t].st)] {
        atoms.push(RefAtom(atom.op RefTerm(6) RefTerm(6 path=[-1] offset=atom.b.offset)))
    }
    let predicate=ref_intern(atoms)
    ref_span_copy(RefineSibWord(types.ptr[t].st) predicate)
    mk_refined(RefineSibWord(types.ptr[t].elem) predicate)
}
# The record type whose field place is, when no contract above that record holds it; else 0.
ref_sib_record=(place0:RefineSibWord):>int64=>$unsafe {
    let place=ref_place_alias(place0)
    if nodes.ptr[place].kind not=? 'field' or nodes.ptr[place].aux <? 0 {return 0}
    let parent=RefineSibWord(nodes.ptr[place].a)
    let record=representation_type(ntype(parent))
    if tkind(record) not=? 'struct_' or not ref_dependent_record(record) or ref_dependent_ancestor(parent) {return 0}
    record
}
# Is place a field whose only contract is a sibling bound on its elements, which no other
# contract names? Then its changes keep the record's contract when its new elements are checked.
ref_sib_free=(place0:RefineSibWord t:RefineSibWord):>bool=>$unsafe {
    let record=ref_sib_record(place0)
    if record =? 0 or not ref_sib_contract(t) {return false}
    loop atom in ref_predicates[RefineSibWord(types.ptr[prune(t)].st)] {
        if not ref_sib_atom(atom) {return false}
    }
    ref_sib_unnamed(record RefineSibWord(nodes.ptr[ref_place_alias(place0)].aux))
}
# A loop's element of an array with a sibling bound is below it too. O(1) past the loop's own.
ref_sib_loop_elements=(n:RefineSibWord base:RefineSibWord @s:FactState):>void=>$unsafe {
    if not ref_self_active or base =? 0 or nodes.ptr[n].aux not=? 1 or RefineSibWord(nodes.ptr[n].sym) <=? 0 {
        fact_loop_elements(n base @s)
        return
    }
    let l=RefineSibWord(nodes.ptr[n].sym)
    let place=PlaceIdentity('local' RefineSibWord(locals.ptr[l].owner) l)
    let i=fact_binding(s place)
    let before=if i >=? 0 {s.bindings[i].value} else {0}
    fact_loop_elements(n base @s)
    if fact_projection_find(s base FACT_SIB_BOUND false) <? 0 or not is_int(fact_type(RefineSibWord(locals.ptr[l].type))) {return}
    i=fact_binding(s place)
    let value=if i >=? 0 {s.bindings[i].value} else {0}
    if value =? 0 or value =? before {
        # (the element type's own bounds: `>=? 0` unless it states another)
        let bound=fact_domain(RefineSibWord(locals.ptr[l].type))
        let iterated=prune(refine_storage(RefineSibWord(nodes.ptr[n].a) ntype(RefineSibWord(nodes.ptr[n].a))))
        if ref_sib_contract(iterated) {bound=ref_interval(RefineSibWord(types.ptr[representation_type(iterated)].elem) bound)}
        value=fact_new(@s bound FactTerm(type=RefineSibWord(locals.ptr[l].type)))
        fact_bind(@s place value)
    }
    ref_sib_element_row(@s base value)
}
ref_sib_permutable=(place:RefineSibWord t:RefineSibWord):>bool=>$unsafe {
    let record=ref_sib_record(place)
    if record =? 0 {return false}
    if ref_sib_contract(t) {return ref_sib_free(place t)}
    types.ptr[prune(t)].kind not=? 'refined' and ref_sib_only_bounds(record RefineSibWord(nodes.ptr[ref_place_alias(place)].aux))
}

use 'refine_predicates.dewy'
use 'checker_tokens.dewy'
use 'refinement_types.dewy'
# Soft preconditions (docs/design/decisions.md, "Soft preconditions"): `$warn_if condition
# "message"` on the line before a function declaration (`@warn_if(condition, "message")` in a
# Sloppy library source). A call from the program's own code warns, with the message, where the
# compiler cannot prove the condition false. It never stops a build and adds no code.
#
# The condition is read once per declaration (fn_sig, in its own scope), as one of:
# - a type test of a parameter, `x is? T` or `x isnt? T`: the argument's checked (narrowed) type
#   at the call decides, while checking;
# - `x isnt? SafePath` (or `p(x) isnt? SafePath`, for text a path is made of): the path brand,
#   decided by the walk in compiler/safe_paths.jo;
# - integer comparisons of parameters (and their `.length`) and constants, joined by `and`, `or`
#   and `not` where the negation stays a conjunction: the facts at the call
#   (compiler/facts.jo) must prove the negation, as they prove a refined parameter.
# Demand-driven: nothing is read unless a declaration has one, and the facts pass visits only
# the functions that call such a declaration. Cost: O(condition) per declaration, O(1) per
# call while checking, and one comparison per atom where the facts pass meets the call.
use 'util.jo'
use 'ast.jo'
use 'lex.jo'
use 'types.jo'
use 'check.jo'
use 'expr.jo'
use 'refine.jo'
use 'facts.jo'
use 'safe_paths.jo'

const WI_TYPE = 1
const WI_FACTS = 2
const WI_PATH = 3

struct WarnIf:
    kind: int
    param: int = -1       # WI_TYPE, WI_PATH: the parameter tested
    wrapped: bool = false # WI_PATH: `p(x) isnt? SafePath`, x the text of a path
    negated: bool = false # WI_TYPE: `isnt?`
    type: int = 0         # WI_TYPE: the type tested
    atoms: RefAtom[]      # WI_FACTS: a conjunction proving the condition false
    message: str = ""

wi_decls: {int: WarnIf[]} = {}
wi_any = false
wi_fact_calls: {int: int} = {}      # call node -> 1 while unproven at some visit, 2 proven
wi_fact_requests: FactRequest[]
wi_fact_targs: {int: int} = {}      # call node -> the callee instance (its parameter types)

wi_reset = ():
    wi_decls = {}
    wi_any = false
    wi_fact_calls = {}
    wi_fact_requests = []
    wi_fact_targs = {}

# fn_sig, with the declaration's type parameters in scope: its conditions, read once.
wi_read_decl = (decl: int):
    if nodes[decl].c == 0 or wi_decls.has(decl): return
    out: WarnIf[]
    loop at in kids(int(nodes[decl].c)):
        if name_of(int(nodes[at].name)) != "warn_if": continue
        cond = int(nodes[at].a)
        msg = int(nodes[at].b)
        if cond == 0 or msg == 0 or nodes[msg].kind != .str_lit or nodes[msg].aux != 0: fatal(nodes[at].pos, "a soft precondition takes a condition and a message string: `$warn_if condition \"message\"`")
        w = wi_read(decl, cond)
        w.message = name_of(int(nodes[msg].sval))
        out.push(w)
    if out.len() == 0: return
    wi_decls[decl] = out
    wi_any = true

wi_param = (decl: int, n: int) -> int:
    if nodes[n].kind != .ident: return -1
    loop i in [0..nkids(decl)):
        if int(nodes[kid(decl, i)].name) == int(nodes[n].name): return i
    -1

wi_unsupported = (n: int):
    fatal(nodes[n].pos, "unsupported `$warn_if` condition: a parameter's type test (`x isnt? T`), or integer comparisons of parameters and constants whose negation is a conjunction")

wi_read = (decl: int, cond: int) -> WarnIf:
    c = cond
    negated = false
    if nodes[c].kind == .not_ and nodes[int(nodes[c].a)].kind == .istype:
        negated = true
        c = int(nodes[c].a)
    if nodes[c].kind == .istype:
        subject = int(nodes[c].a)
        tn = int(nodes[c].b)
        if ut_names_safe(tn):
            wrapped = false
            if nodes[subject].kind == .call and nkids(subject) == 1 and nodes[subject].a != 0 and nodes[int(nodes[subject].a)].kind == .ident and int(nodes[int(nodes[subject].a)].name) == ut_p_name:
                wrapped = true
                subject = kid(subject, 0)
            i = wi_param(decl, subject)
            if i < 0 or not negated: wi_unsupported(c)
            return WarnIf(WI_PATH, i, wrapped)
        i = wi_param(decl, subject)
        if i < 0: wi_unsupported(c)
        return WarnIf(WI_TYPE, i, false, negated, resolve_type(tn))
    w = WarnIf(WI_FACTS)
    wi_negation(decl, cond, w.atoms)
    w

# what proves c false: the atoms of not c
wi_negation = (decl: int, c: int, out: mut RefAtom[]):
    k = nodes[c].kind
    if k == .or_:
        wi_negation(decl, int(nodes[c].a), out)
        wi_negation(decl, int(nodes[c].b), out)
        return
    if k == .not_:
        wi_affirm(decl, int(nodes[c].a), out)
        return
    if k == .binary and fact_comparison(nodes[c].op as Tok):
        ref_add(fact_inverse(nodes[c].op as Tok), wi_term(decl, int(nodes[c].a)), wi_term(decl, int(nodes[c].b)), out)
        return
    wi_unsupported(c)

# what proves c true
wi_affirm = (decl: int, c: int, out: mut RefAtom[]):
    k = nodes[c].kind
    if k == .and_:
        wi_affirm(decl, int(nodes[c].a), out)
        wi_affirm(decl, int(nodes[c].b), out)
        return
    if k == .not_:
        wi_negation(decl, int(nodes[c].a), out)
        return
    if k == .binary and fact_comparison(nodes[c].op as Tok):
        ref_add(nodes[c].op as Tok, wi_term(decl, int(nodes[c].a)), wi_term(decl, int(nodes[c].b)), out)
        return
    wi_unsupported(c)

wi_term = (decl: int, n: int) -> RefTerm:
    k = nodes[n].kind
    if k == .int_lit: return RefTerm(1, nodes[n].ival)
    if k == .unary and nodes[n].op == i32(int(Tok.minus)) and nodes[int(nodes[n].a)].kind == .int_lit: return RefTerm(1, -nodes[int(nodes[n].a)].ival)
    if k == .field and name_of(int(nodes[n].name)) == "length":
        i = wi_param(decl, int(nodes[n].a))
        if i >= 0: return RefTerm(2, i, path = [-1])
    i = wi_param(decl, n)
    if i < 0: wi_unsupported(n)
    RefTerm(2, i)

# expr.jo, a call of f (declaration decl) just checked
wi_call = (n: int, f: int, decl: int):
    if pos_in_lib(nodes[n].pos): return
    if not wi_decls.has(decl): return
    loop w in wi_decls[decl]:
        if w.kind == WI_PATH:
            ut_paths_used = true
            continue
        if w.kind == WI_FACTS:
            if not wi_fact_calls.has(n):
                wi_fact_calls[n] = 0
                wi_fact_targs[n] = f
                wi_fact_requests.push(FactRequest(n, if cx >= 0: int(ctxs[cx].inst) else: 0))
            continue
        if w.param >= nkids(n): continue
        x = kid(n, w.param)
        r = wi_is(wi_arg_type(x), subst(w.type, fns[f].targs))
        if w.negated and r == 1 or not w.negated and r == 0: continue
        warn(nodes[x].pos, w.message)

# (the argument's own type, under the conversion to the parameter's)
wi_arg_type = (x0: int) -> int:
    x = x0
    loop i in [0..16):
        if nodes[x].kind == .conv and nodes[x].a != 0: x = int(nodes[x].a)
        else if nodes[x].kind == .call and nodes[x].sym == 0 and nodes[x].aux == 3 and nkids(x) == 1: x = kid(x, 0)
        else: break
    ntype(x)

# a value of type a is a T: always 1, never 0, -1 when it depends on the value
wi_is = (a0: int, t0: int) -> int:
    a = prune(a0)
    t = prune(t0)
    if a == 0 or t == 0 or has_var(a) or has_var(t): return -1
    if type_eq(a, t): return 1
    if types[a].kind == .opt or types[t].kind == .opt: return -1
    am = if is_union(a): union_members(a) else: [a]
    tm = if is_union(t): union_members(t) else: [t]
    some = false
    every = true
    loop m in am:
        found = false
        loop u in tm:
            if type_eq(m, u): found = true
        if found: some = true
        else: every = false
    if every: return 1
    if not some: return 0
    -1

# facts.jo: the call n, its arguments' values in s
wi_fact_check = (n: int, values: int[], s: mut FactState):
    if fact_speculating > 0 or not s.live: return
    f = wi_fact_targs.get(n) ?? 0
    if f == 0 or not wi_decls.has(int(fns[f].decl)): return
    proven = true
    loop w in wi_decls[int(fns[f].decl)]:
        if w.kind != WI_FACTS: continue
        loop atom in w.atoms:
            base = T_INT
            if atom.a.kind == 2 and atom.a.path.len() == 0 and atom.a.value < fns[f].ptypes.len(): base = fns[f].ptypes[atom.a.value]
            a = ref_value(atom.a, 0, values, base, s)
            b = ref_value(atom.b, 0, values, base, s)
            if a == 0 or b == 0 or fact_compare(s, atom.op, a, b) != 1: proven = false
    if not proven: wi_fact_calls[n] = 1
    else if wi_fact_calls[n] == 0: wi_fact_calls[n] = 2

# facts.jo, after the walks: a call never proven at some visit warns
wi_fact_finish = ():
    loop n, state in wi_fact_calls:
        if state == 2: continue
        f = wi_fact_targs[n]
        loop w in wi_decls[int(fns[f].decl)]:
            if w.kind == WI_FACTS: warn(nodes[n].pos, w.message)
    wi_fact_calls = {}
    wi_fact_requests = []

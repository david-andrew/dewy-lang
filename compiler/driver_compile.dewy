from p"icount.jo" import (IC_EFFECTS IC_EMIT IC_FACTS IC_LOWER IC_OTHER IC_OWNERSHIP IC_SHARED)
from p"icount_ops.dewy" import (ic_lf ic_lines_report ic_report ic_restore ic_start ic_switch)
from p"ide.jo" import (ide_skip)
from p"inline_ops.dewy" import (rel_collect)
from p"ir.jo" import (checked_flags dbg_on ir_pos main_code main_exit_lf mulh_ok rotate32_ok)
from p"ir_operands.dewy" import (ba_fuse_enabled)

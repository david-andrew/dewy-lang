from p"lazy_force.dewy" import (dc_flush_warnings)
from p"loops.jo" import (lx_vec_on)
from p"lower.jo" import (LK_INST data_size global_off late_binding lfuncs lower_epoch mt_active_off opt_release rodata)
from p"opt_workspace.dewy" import (opt_allow_cse)

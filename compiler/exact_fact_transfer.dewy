$runtime_checks
from p"checker_source_positions.dewy" import (dewy_at)
from p"expression_types.dewy" import (ntype)

from p"ast.jo" import (kid nodes)
from p"checker_constant_queries.dewy" import (sa_fits)
from p"checker_tokens.dewy" import (Tok)
from p"exact_static_widths.dewy" import (exact_width_bits)
from p"diagnostic_exit.dewy" import (fatal)
from p"directive_ops.dewy" import (dir_panic_fix)
from p"directive_rules.dewy" import (dir_defer)
from p"exact.jo" import (exact_marks exact_measure_on exact_measure_sites exact_range_meta exact_ranges exact_shader_owners exact_shifts exact_stores)
from p"exact_marks.dewy" import (exact_decide exact_decided exact_has_node exact_proved)
from p"exact_check_hooks.dewy" import (HOOK_TOK_MINUS HOOK_TOK_PLUS exact_representation)
from p"exact_count_bounds.dewy" import (exact_count_bound)
from p"expr.jo" import (IN)
from p"integer_conversions.dewy" import (integer_constant)
from p"facts.jo" import (FACT_MEMBER FACT_VALUE FactState fact_speculating fact_terms)
from p"facts_arith.dewy" import (fact_relational)
from p"facts_compare.dewy" import (fact_compare fact_open_endpoint)
from p"facts_index_proofs.dewy" import (positive_bound)
from p"facts_index_writes.dewy" import (fact_constant fact_new fact_set_bound)
from p"facts_joins.dewy" import (fact_host_finite)
from p"facts_slice_prep.dewy" import (fact_slice_flags)
from p"facts_lengths.dewy" import (fact_difference)
from p"facts_value_queries.dewy" import (fact_bound)
from p"facts_values.dewy" import (fact_domain fact_type fact_unmodeled)
from p"refinement_types.dewy" import (FACT_MAX FACT_MIN FactBound FactTerm)
from p"type_ops.dewy" import (dt)
from p"types.jo" import (T_I32 T_INT T_MATH_INT T_U32 T_U64 prune types)
from p"util.jo" import (err_notes)
from p"witness_nodes.dewy" import (wit_text)
from p"witness_ops.dewy" import (wit_help wit_operand_changed wit_side wit_unsupported)

TransferWord:type=int64<overflow='wrap'>
TransferUnsigned:type=uint64<overflow='wrap'>

exact_shift_fact=(n:TransferWord value:TransferWord s:FactState):>void=>$unsafe {
    # Tok.shl and Tok.starstar in the checked node's operator field.
    if fact_speculating >? 0 or not exact_has_node(n) {return}
    let op=nodes.ptr[n].op
    if op not=? 67 and op not=? 79 {return}
    let b=fact_bound(s value)
    let hi=fact_relational(s value true)
    let bounded=not b.wide
    if value not=? 0 and fact_type(fact_terms[value].type) =? T_U64 {
        if b.lo <? 0 and hi <? 0 {
            b.lo=b.lo xor FACT_MIN
            hi=hi xor FACT_MIN
        } else {bounded=false}
    }
    let limit:TransferWord=if bounded and hi <? 1048576 {max(0 hi)} else {-1}
    # A sliced proof can omit the count while preparation retains an immutable bound.
    if limit <? 0 {
        let bound=exact_count_bound(int64(nodes.ptr[n].b))
        if not bound.wide and bound.hi <? 1048576 {
            exact_shifts[n]=max(0 bound.hi)
            return
        }
    }
    if exact_shifts.has(n) {
        let previous=exact_shifts[n]
        if previous <? 0 or limit <? 0 {limit=-1} else {limit=max(previous limit)}
    }
    exact_shifts[n]=limit
}

exact_fits_relation=(@s:FactState value:TransferWord t:TransferWord):>bool=>$unsafe {
    let bits=TransferWord(types.ptr[t].bits)
    let sign=types.ptr[t].sign
    if bits <=? 0 or bits >? 64 {return false}
    let low:TransferWord=if not sign {0} else if bits >=? 64 {TransferWord(FACT_MIN) + 1} else {-(TransferWord(1) << (bits - 1))}
    let high:TransferWord=if bits >=? 64 {TransferWord(FACT_MAX) - 1} else if sign {(TransferWord(1) << (bits - 1)) - 1} else {(TransferWord(1) << bits) - 1}
    let b=fact_bound(s value)
    let lo_real=b.lo not=? FACT_MIN and b.lo >=? low or b.lo =? FACT_MIN and sign and bits >=? 64 and not fact_open_endpoint(s value false)
    let hi_real=b.hi not=? FACT_MAX and b.hi <=? high or b.hi =? FACT_MAX and bits >=? 64 and not fact_open_endpoint(s value true)
    if not lo_real {
        let floor=fact_constant(@s low)
        if fact_compare(s 'ge' value floor) not=? 1 {return false}
    }
    if hi_real {return true}
    let ceiling=fact_constant(@s high)
    fact_compare(s 'le' value ceiling) =? 1
}

# Name the input endpoint for an operation that can overflow in just one
# direction. Only a failed store requests the checked operand's spelling.
exact_operand_guard=(n:TransferWord t:TransferWord):>string=>$unsafe {
    let k=nodes.ptr[n].kind
    let operand=TransferWord(nodes.ptr[n].a)
    let negate=k =? 'unary' and nodes.ptr[n].op =? HOOK_TOK_MINUS
    let add=false
    let step:TransferWord=0
    if k =? 'intrinsic' and nodes.ptr[n].aux =? int32(int64(IN.fixed_abs)) {
        operand=kid(n 0)
        negate=true
    } else if k =? 'binary' and nodes.ptr[n].aux =? 0 {
        add=nodes.ptr[n].op =? HOOK_TOK_PLUS
        if not add and nodes.ptr[n].op not=? HOOK_TOK_MINUS {return ""}
        let right=TransferWord(nodes.ptr[n].b)
        let [known amount]=integer_constant(right)
        if not known {
            [known amount]=integer_constant(operand)
            if not known or not add and amount not=? 0 {return ""}
            operand=right
            negate=not add
        }
        step=amount
    } else if not negate {return ""}
    let side=wit_side(0 operand)
    if side.text =? "" or side.node <=? 0 or side.length or exact_representation(ntype(side.node)) not=? t {return ""}
    let kind=nodes.ptr[side.node].kind
    if kind not=? 'ident' and kind not=? 'field' {return ""}
    let width=dt(t)
    if negate {return if types.ptr[t].sign {"{side.text} >? {width}.min"} else {""}}
    if step <=? 0 or not sa_fits(step t) {return ""}
    if add {return if step =? 1 {"{side.text} <? {width}.max"} else {"{side.text} <=? {width}.max - {step}"}}
    if step =? 1 {"{side.text} >? {width}.min"} else {"{side.text} >=? {width}.min + {step}"}
}

exact_fact_store=(n:TransferWord value:TransferWord @s:FactState):>int64=>$unsafe {
    # A whole-body probe can already have proved this store. A later slice
    # can visit it for its operand's effects alone, with no result to check.
    # Only reuse the proof when the plan explicitly dropped the value (one
    # indexed lookup); an evaluated but unknown value still has to fit.
    if value =? 0 and exact_proved(n) and fact_speculating =? 0 and fact_slice_flags(TransferWord(nodes.ptr[n].a)) & (FACT_MEMBER | FACT_VALUE) =? FACT_MEMBER {return value}
    if not s.live {
        if not exact_decided(n) {exact_decide(n true);}
        return value
    }
    let t=exact_representation(ntype(n))
    # (GPU code holds a 64-bit integer in a 32-bit word: a store there must fit the word)
    let shader=exact_shader_owners.has(exact_stores.get(n) ?? 0)
    let stored=t
    if shader and types.ptr[t].kind =? 'int_' and types.ptr[t].bits >? 32 {t=if types.ptr[t].sign {T_I32} else {T_U32}}
    let b=fact_bound(s value)
    let ok=not b.wide and b.reason not=? 'unsupported' and sa_fits(b.lo t) and sa_fits(b.hi t)
    if ok and value not=? 0 and (b.hi =? FACT_MAX and fact_open_endpoint(s value true) or b.lo =? FACT_MIN and fact_open_endpoint(s value false)) {ok=false}
    if not ok and value not=? 0 and t not=? T_U64 and not b.wide and b.reason not=? 'unsupported' {ok=exact_fits_relation(@s value t)}
    if t =? T_U64 {ok=not b.wide and value not=? 0 and fact_terms[value].type =? T_U64 and b.reason not=? 'unsupported'}
    if exact_marks[n] & 32 not=? 0 {
        if ok {return value}
        let bounded=fact_domain(t)
        if types.ptr[t].sign {
            bounded.lo=max(bounded.lo b.lo)
            bounded.hi=min(bounded.hi b.hi)
        }
        if value not=? 0 {
            fact_set_bound(@s value bounded)
            return value
        }
        return fact_new(@s bounded FactTerm(type=t))
    }
    if not ok {
        let independent=exact_count_bound(int64(nodes.ptr[n].a))
        if not independent.wide and sa_fits(independent.lo t) and sa_fits(independent.hi t) {ok=true}
    }
    if not ok {
        let syntax_bound=positive_bound(int64(nodes.ptr[n].a) false)
        if syntax_bound >=? 0 and sa_fits(syntax_bound t) {ok=true}
    }
    if fact_speculating =? 0 {
        if exact_decided(n) {ok=ok and exact_proved(n)}
        exact_decide(n ok)
        if exact_measure_on {
            let site=exact_measure_sites[n]
            site.category=if ok {"proven"} else {"runtime-check"}
            site.lo=b.lo
            site.hi=b.hi
            exact_measure_sites[n]=site
        }
        if not ok {
            let what="cannot prove exact integer result fits {dt(t)}"
            if not dir_defer(n what true) {
                let shown=wit_text(n)
                let inner=n
                loop inner not=? 0 and nodes.ptr[inner].kind =? 'conv' {inner=TransferWord(nodes.ptr[inner].a)}
                let guard=exact_operand_guard(inner t)
                if shown not=? "" {
                    err_notes.push([(-1) "note: nothing bounds `{shown}` within {dt(t)} here"])
                    if guard =? "" and dewy_at(nodes.ptr[n].pos) {
                        let operand=wit_unsupported(inner)
                        if operand not=? "this operation is outside the fact language" {err_notes.push([(-1) "note: {operand}"])}
                    }
                    wit_operand_changed(int64(nodes.ptr[n].a) s)
                }
                if guard not=? "" {wit_help(guard)}
                else if shown not=? "" {wit_help("{dt(t)}.min <=? ({shown}) and ({shown}) <=? {dt(t)}.max")}
                if t not=? stored {err_notes.push([(-1) "note: GPU code holds {dt(stored)} values in 32-bit words, so this must fit {dt(t)}"])}
                if shader {err_notes.push([(-1) "help: state the domain as a refinement or prove it with a guard before the operation, or choose `overflow='wrap'` (GPU code cannot check it)"])}
                else {
                    let width=dt(t)
                    err_notes.push([(-1) "help: widen the destination to `int` or state the domain as a refinement. For wrapping use `{width}<overflow='wrap'>`. For saturation use `{width}<overflow='saturate'>`"])
                    err_notes.push([(-1) "help: {dir_panic_fix(nodes.ptr[n].pos true)}"])
                }
                fatal(nodes.ptr[n].pos what)
            }
        }
    }
    if ok {return value}
    let bounded=fact_domain(t)
    if value not=? 0 and fact_type(fact_terms[value].type) =? fact_type(t) {
        bounded.lo=max(bounded.lo b.lo)
        bounded.hi=min(bounded.hi b.hi)
    }
    fact_new(@s bounded FactTerm(type=t))
}

# Whether a representation owner's facts record n's range (exact_value_fact): an exact `int`'s,
# or in GPU code a 64-bit integer's, which a shader holds in a 32-bit word (sl_exact_range).
exact_rep_value=(n:TransferWord owner:TransferWord):>bool=>$unsafe {
    let t=prune(ntype(n))
    t =? T_MATH_INT or types.ptr[t].kind =? 'int_' and types.ptr[t].bits >? 32 and exact_shader_owners.has(owner)
}
exact_value_fact=(n:TransferWord value:TransferWord s:FactState):>void=>$unsafe {
    if not s.live {return}
    if n >=? exact_ranges.length {
        let need=max(max(n + 1 nodes.length) exact_ranges.length * 2)
        exact_ranges.resize(need)
        exact_range_meta.resize(need)
    }
    let t=if value =? 0 {T_U64} else {exact_representation(ntype(n))}
    if t =? T_U64 {
        exact_ranges[n]=-1
        exact_range_meta[n]=4
        return
    }
    let b=fact_bound(s value)
    let flags:TransferWord=(if not b.wide and b.lo >=? 0 {1} else {0}) | (if not b.wide and b.lo >? FACT_MIN {2} else {0})
    let old=TransferWord(exact_range_meta[n])
    if old & 4 not=? 0 {flags &= old}
    exact_range_meta[n]=uint8(flags | 4)
    if b.wide or b.reason =? 'unsupported' or (t =? T_MATH_INT or fact_type(fact_terms[value].type) =? T_MATH_INT) and not fact_host_finite(s value) {
        exact_ranges[n]=-1
        return
    }
    if exact_ranges[n] <? 0 {return}
    let low:TransferWord=if b.lo <? 0 {-(TransferWord(b.lo) + 1)} else {b.lo}
    let high:TransferWord=if b.hi <? 0 {-(TransferWord(b.hi) + 1)} else {b.hi}
    let width=exact_width_bits(TransferUnsigned(max(low high)))
    exact_ranges[n]=max(exact_ranges[n] width)
}

# An exact unsigned sum or product beyond a word never wraps to zero: a
# positive addend, or two positive factors, keep it nonzero.
exact_unsigned_wide=(@s:FactState n:TransferWord positive:bool):>int64=>{
    let v=fact_unmodeled(@s n 'unsupported')
    let b=fact_bound(s v)
    if positive and b.wide {
        b.nz=true
        fact_set_bound(@s v b)
    }
    v
}
exact_unsigned_fact=(@s:FactState n:TransferWord op:Tok a:TransferWord b:TransferWord):>int64=>{
    let x=fact_bound(s a)
    let y=fact_bound(s b)
    if x.wide or y.wide {return fact_unmodeled(@s n 'unsupported')}
    let m=TransferUnsigned(18446744073709551615)
    let xl=TransferUnsigned(x.lo xor FACT_MIN)
    let xh=TransferUnsigned(x.hi xor FACT_MIN)
    let yl=TransferUnsigned(y.lo xor FACT_MIN)
    let yh=TransferUnsigned(y.hi xor FACT_MIN)
    let lo=TransferUnsigned(0)
    let hi=TransferUnsigned(0)
    if op =? 'plus' {
        if xh >? m - yh {xh=TransferUnsigned(fact_relational(s a true) xor FACT_MIN)}
        if xh >? m - yh {yh=TransferUnsigned(fact_relational(s b true) xor FACT_MIN)}
        if xh >? m - yh {return exact_unsigned_wide(@s n xl not=? 0 or yl not=? 0)}
        lo=xl + yl
        hi=xh + yh
    } else if op =? 'minus' {
        if not (xl >=? yh or fact_compare(s 'ge' a b) =? 1) {return fact_unmodeled(@s n 'unsupported')}
        lo=if xl >=? yh {xl - yh} else {TransferUnsigned(0)}
        hi=if xh >=? yl {xh - yl} else {TransferUnsigned(0)}
    } else if op =? 'star' {
        if xh not=? 0 and yh >? m // xh {return exact_unsigned_wide(@s n xl not=? 0 and yl not=? 0)}
        lo=xl * yl
        hi=xh * yh
    } else {return fact_unmodeled(@s n 'unsupported')}
    let v=fact_new(@s FactBound(TransferWord(lo) xor FACT_MIN TransferWord(hi) xor FACT_MIN) FactTerm(type=T_U64))
    let small=TransferUnsigned(1) << TransferUnsigned(62)
    if (op =? 'plus' or op =? 'minus') and yl =? yh and yl <? small {
        let d=if op =? 'plus' {TransferWord(yl)} else {-TransferWord(yl)}
        fact_difference(@s v a d)
        fact_difference(@s a v (-d))
    }
    if op =? 'plus' and xl =? xh and xl <? small {
        fact_difference(@s v b TransferWord(xl))
        fact_difference(@s b v (-TransferWord(xl)))
    }
    v
}

exact_fact_signed=(@s:FactState value:TransferWord):>int64=>{
    let b=fact_bound(s value)
    if b.wide or b.hi >=? 0 {return fact_new(@s FactBound(wide=true) FactTerm(type=T_INT))}
    b.lo=b.lo xor FACT_MIN
    b.hi=b.hi xor FACT_MIN
    # The encoded nonzero flag excludes 2^63. Recompute it for signed zero.
    b.nz=b.lo >? 0
    fact_new(@s b FactTerm(type=T_INT))
}

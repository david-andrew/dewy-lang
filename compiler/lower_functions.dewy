# Direct recursive lowering; shared state has one owner in lower.jo.
LFnWord:type=int64<overflow='wrap'>
begin_fn=(name:string idx:LFnWord):>void=>$unsafe {
    ir_begin(name idx);
    exact_lower_active=exact_nodes.length >? 0
    eg_active=false
    lower_length_guards=[]
    parallel_scalars.clear();
    parallel_owned.clear();
    stack_closure_fn=-1
    stack_closure_params.clear();
    math_word_regs.clear();
    math_static_regs.clear();
    math_static_widths.clear();
    math_word_limits.clear();
    math_word_updates.clear();
    math_writes_ready=false
    math_has_mutable=false
    math_writes.clear();
    math_decl_depth.clear();
    math_loop_sites.clear();
    math_write_loop.clear();
    math_loop_parent.clear();
    ctl=0
    cond_depth=0
    scope_locals=[]
    scope_defers=[]
    loops=[]
    tl_items.clear();
    tl_values.clear();
    tl_nop.clear();
    lower_zeros.clear();
    lower_mark_serial=0
    lower_has_nops=ownership_decls.length not=? 0
    tl_cond.clear();
    building=[]
    sret_v=-1
    env_v=-1
}
find_bytes_set=(name:LFnWord):>int64=>$unsafe {
    if find_ids.length =? 0 {
        loop nm in ["__find_delim" "__find_newline" "__find_line_delim" "__find_line_delim4" "__find_line_delim8" "__memchr"] {find_ids.push(intern(nm));}
    }
    if name =? find_ids.ptr[5] {return -2}
    let delims:LFnWord=0x0A | (0x22 << 8) | (0x23 << 16) | (0x27 << 24)
    if name =? find_ids.ptr[0] {return delims}
    if name =? find_ids.ptr[1] {return 0x0A0A0A0A}
    if name =? find_ids.ptr[2] {return delims | (1 << 32)}
    if name =? find_ids.ptr[3] {return delims | (1 << 32) | (4 << 33)}
    if name =? find_ids.ptr[4] {return delims | (1 << 32) | (8 << 33)}
    return -1
}
lower_inst=(lf:LFnWord f:LFnWord):>void=>$unsafe {
    positive_epoch += 1;
    begin_fn(lfuncs.ptr[lf].name lf);
    owner_begin();
    if fns.ptr[f].decl not=? 0 {
        ir_set_pos(nodes.ptr[LFnWord(fns.ptr[f].decl)].pos);
        ir.decl_pos = ir_pos;
    }
    cur_fn=f
    exact_lower_active=exact_owners.has(f)
    eg_active=f <? eg_demanded.length and eg_demanded.ptr[f]
    cur_ret=LFnWord(fns.ptr[f].ret)
    ir.cabi = fns.ptr[f].cabi;
    ir.noinline = fns.ptr[f].noinline;
    ir.export_name = if parallel_serial {""} else {fns.ptr[f].export_name};
    if vc(cur_ret) =? VC_AGG {sret_v=vreg(VI)}
    if fns.ptr[f].has_env {env_v=vreg(VI)}
    if fns.ptr[f].kind =? FK_LAMBDA {env_layout(f);}
    # parameters
    loop i in [0..fns.ptr[f].params.length) and l in fns.ptr[f].params {
        let t:LFnWord=LFnWord(locals.ptr[l].type)
        let pv:LFnWord=0
        if LFnWord(locals.ptr[l].flags) & LF_MUTPARAM not=? 0 or vc(t) =? VC_AGG {pv=vreg(VI)}
        else {pv=vreg(vt_of(t))}
        locals.ptr[l].vreg = int32<overflow='wrap'>(pv);
        locals.ptr[l].offset = -1;
    }
    ir.nparams = ir.vtypes.length;
    partition_begin(f);
    if refine_active {refine_gen_entry(f);}
    ir.ret = ret_vt(cur_ret);
    if fns.ptr[f].decl not=? 0 and not target_arm64 and not target_wasm and not dbg_on and modules.ptr[LFnWord(fns.ptr[f].mod)].is_prelude {
        # Private bounded byte searches from lib/core/str.jo.
        let set=find_bytes_set(LFnWord(nodes.ptr[LFnWord(fns.ptr[f].decl)].name))
        if set =? -2 {
            # __memchr(p, from, n, byte): guard the span before subtracting or
            # forming its address. The intrinsic returns a relative offset.
            ir.raw_mem = true;
            e_if(e_bin('ges' VI 1 2));
            e_ret(e_iconst(-1));
            e_end();
            let pointer=e_bin('add' VI 0 1)
            let length=e_bin('sub' VI 2 1)
            let result=vreg(VI)
            if want_cpu_flag {
                # Long spans on AVX2 scan wider; the flag is read once, not per step.
                e_if(rt_global("__cpu_avx2"));
                emit('findbyte' VI result pointer length 3 2);
                e_else();
                emit('findbyte' VI result pointer length 3 0);
                e_end();
            }
            else {emit('findbyte' VI result pointer length 3 0);}
            e_if(e_bin('ges' VI result e_iconst(0)));
            e_ret(e_bin('add' VI result 1));
            e_end();
            e_ret(e_iconst(-1));
            return
        }
        if set >=? 0 {
            ir.raw_mem = true;
            let result=vreg(VI)
            emit('findb' VI result 0 1 2 set);
            e_ret(result);
            return
        }
    }
    if (f =? runtime_memeq or f =? runtime_streq) and not target_arm64 and not target_wasm and not dbg_on {
        # Ordinary scalar body remains available to the bootstrap, debugger and
        # other targets. Select only the exact private runtime instances.
        ir.raw_mem = true;
        let result=vreg(VI)
        let operation=Op.memeq
        let count:LFnWord=2
        if f =? runtime_streq {
            operation='streq'
            count=0
        }
        emit(operation VI result 0 1 count 0);
        e_ret(result);
        return
    # (called from C, whose callers leave the upper bits of narrow integers undefined: made
    # what the language expects of them)
    }
    if fns.ptr[f].cabi {
        # (C may call it from a thread of its own: the allocator tells threads apart from now on)
        let ct=prelude.get(intern("__c_threads"))
        if ct not=? none {
            if syms.ptr[ct].kind =? SK.global {e_store(e_gaddr(global_addr_off(LFnWord(syms.ptr[ct].ref))) 0 e_iconst(1) 1);}
        }
        loop l in fns.ptr[f].params {
            let t=prune(LFnWord(locals.ptr[l].type))
            if types.ptr[t].kind =? 'int_' and tsize(t) <? 8 and LFnWord(locals.ptr[l].flags) & LF_MUTPARAM =? 0 {e_mov(LFnWord(locals.ptr[l].vreg) norm(LFnWord(locals.ptr[l].vreg) t));}
    # Bind read-only Dewy value parameters before allocating local storage.
    # These declarations form a contiguous synthetic prefix. Rebind on every
    # lowering so watch/repl and debug builds cannot reuse old virtual registers.
        }
    }
    let body:LFnWord=LFnWord(fns.ptr[f].body)
    loop i in [0..nkids(body)) {
        let s=kid(body i)
        if nodes.ptr[s].kind not=? 'vardecl' or nodes.ptr[s].aux2 not=? 1 {break}
        if nkids(s) >? 0 or has_flag(s NF_GLOBAL) {continue}
        let l:LFnWord=LFnWord(nodes.ptr[s].sym)
        if l <? 0 {continue}
        locals.ptr[l].flags &= int32<overflow='wrap'>(~LF_PARAM);
        param_view_decl(s l);
    }
    find_views(f);
    if copies_on {
        let icb=ic_phase(IC_OWNERSHIP)
        copies_prepare(f);
        ic_restore(icb);
    # locals
    }
    loop l in fns.ptr[f].locals {
        let fl:LFnWord=LFnWord(locals.ptr[l].flags)
        let t:LFnWord=LFnWord(locals.ptr[l].type)
        if t =? T_MATH_INT and fl & LF_ASSIGNED not=? 0 {math_has_mutable=true}
        if fl & (LF_CAPTURE | LF_ALIAS) not=? 0 {continue}
        if fl & LF_PARAM not=? 0 {
            if copy_inputs.has(l) and (not files.ptr[pos_file(nodes.ptr[LFnWord(fns.ptr[f].decl)].pos)].is_dewy or ownership_consumers.length not=? 0 and ownership_consumers.has(LFnWord(fns.ptr[f].decl))) {
                let s=new_temp(t)
                # (a place parameter's vreg is the caller's address: the value copied from there)
                let v=LFnWord(locals.ptr[l].vreg)
                if fl & LF_MUTPARAM not=? 0 and vc(t) not=? VC_AGG {v = load_val(t v 0);}
                store_val(t e_slot(s) 0 v);
                locals.ptr[l].offset = int32<overflow='wrap'>(s);
                # (the body reads and writes the owned copy, which its drop then sees)
                if fl & LF_MUTPARAM not=? 0 or vc(t) =? VC_AGG {e_mov(LFnWord(locals.ptr[l].vreg) e_slot(s));}
                continue
            }
            if fl & LF_ADDR not=? 0 and fl & LF_MUTPARAM =? 0 and vc(t) not=? VC_AGG {
                # address-taken scalar parameter: move to memory
                let s=new_slot(8 8)
                store_val(t e_slot(s) 0 LFnWord(locals.ptr[l].vreg));
                locals.ptr[l].offset = int32<overflow='wrap'>(s);
            }
            continue
        }
        locals.ptr[l].offset = -1;
        if fl & LF_BYREF not=? 0 {
            locals.ptr[l].vreg = int32<overflow='wrap'>(vreg(VI));
            continue
        }
        t=store_type(l)
        if vc(t) =? VC_AGG or fl & LF_ADDR not=? 0 or ownership_type(t) {
            let s=new_slot(tsize(t) talign(t))
            locals.ptr[l].offset = int32<overflow='wrap'>(s);
            if is_managed(t) {e_zero(e_slot(s) tsize(t));}
            continue
        }
        locals.ptr[l].vreg = int32<overflow='wrap'>(vreg(vt_of(t)));
        if is_managed(t) {e_mov(LFnWord(locals.ptr[l].vreg) e_iconst(0));}
    }
    exm_censuses.clear(); lower_entry=[]
    exm_produced_flags.clear(); exm_produced_widths.clear()
    let exm_start=ir.code.length
    if exact_loop_plan(f body) {
        let guard=exact_loop_guard(body)
        iff(guard);
        exact_loop_fast=true
        lower_inst_body(f body);
        exact_loop_fast=false
        endc();
    }
    lower_inst_body(f body);
    if lower_entry.length >? 0 {
        loop i in [0..lower_zeros.length) {
            if lower_zeros.ptr[i].mark >> 32 >=? exm_start {lower_zeros.ptr[i].mark += lower_entry.length << 32;}
        }
        ir.code = [ir.code[..exm_start)... lower_entry... ir.code[exm_start..]...];
    }
    if vc(cur_ret) =? VC_AGG {e_ret(sret_v);}
    else if vc(cur_ret) =? VC_VOID {e_ret(-1);}
    else {e_trap();}
    owner_end();
    if dbg_on {
        loop l in fns.ptr[f].params {ir.dbg_locals.push(l);}
        loop l in fns.ptr[f].locals {
            if LFnWord(locals.ptr[l].flags) & LF_PARAM =? 0 {ir.dbg_locals.push(l);}
        }
    }
}
lower_inst_body=(f:LFnWord body:LFnWord):>void=>$unsafe {
    let guarded=lower_length_guards.length
    scope_push();
    owner_enter_captures(f);
    if ownership_decls.length not=? 0 and fns.ptr[f].decl not=? 0 and not files.ptr[pos_file(nodes.ptr[LFnWord(fns.ptr[f].decl)].pos)].is_dewy {
        loop p in fns.ptr[f].params {
            if copy_inputs.has(p) {scope_add_local(p);}
    # (a `$__consume__` method owns its receiver, which no binding of Dewy's takes)
        }
    }
    else if ownership_consumers.length not=? 0 and fns.ptr[f].params.length >? 0 and ownership_consumers.has(LFnWord(fns.ptr[f].decl)) and copy_inputs.has(fns.ptr[f].params.ptr[0]) {scope_add_local(fns.ptr[f].params.ptr[0]);}
    if fns.ptr[f].kind =? FK_INIT {
        gen_block_stmts(body);
    }
    else {
        let n=nkids(body)
        loop i in [0..n) {
            cur_block=body
            cur_block_i=i
            let s=kid(body i)
            if i =? n - 1 and nodes.ptr[body].aux not=? 0 and vc(cur_ret) not=? VC_VOID {
                let r=mk(NK.return_ nodes.ptr[s].pos)
                nodes.ptr[r].a = nodes.ptr[s].a;
                # (its line, as a statement's: for backtraces and debuggers)
                ir_set_pos(nodes.ptr[s].pos);
                gen_return(r);
                continue
            }
            gen_stmt(s);
            lower_length_guard(s);
        }
    }
    lower_length_guards.truncate(guarded);
    scope_pop();
}
lower_function=(lf:LFnWord):>void=>$unsafe {
    if dir_code_any {dir_code_owner=int64(lfuncs.ptr[lf].inst)}
    lower_epoch += 1;
    lower_planning=true
    exr_fast=lfuncs.ptr[lf].kind =? LK_HELPER and lfuncs.ptr[lf].hkind =? HK.reset_words
    parallel_serial=lfuncs.ptr[lf].kind =? LK_HELPER and (lfuncs.ptr[lf].hkind =? HK.parallel_serial or lfuncs.ptr[lf].hkind =? HK.partition and lfuncs.ptr[lf].htype =? 1)
    partition_mode=lfuncs.ptr[lf].kind =? LK_HELPER and lfuncs.ptr[lf].hkind =? HK.partition
    if lfuncs.ptr[lf].kind =? LK_INST or parallel_serial or partition_mode or exr_fast {pc_restore(lfuncs.ptr[lf].inst);}
    exr_locals=if exr_fast {exr_plan(lfuncs.ptr[lf].inst)} else {[]}
    fact_storage_cache.clear();
    lpath_ids.clear();
    lpath_parents.truncate(1);
    let f=lfuncs.ptr[lf]
    lop_watch=false
    if want_loop_watch and f.kind =? LK_INST and prelude.get(intern("__loop_budget")) not=? none {
        let fi0=f.inst
        let d0:LFnWord=LFnWord(fns.ptr[fi0].decl)
        if d0 not=? 0 {lop_watch=not pos_in_lib(nodes.ptr[d0].pos)}
        else {lop_watch=fns.ptr[fi0].kind =? FK_INIT and not modules.ptr[LFnWord(fns.ptr[fi0].mod)].is_prelude}
    # (generated helpers have no place in the source)
    }
    ir_pos=0
    if f.kind =? LK_INST {
        let fi=f.inst
        if fns.ptr[fi].kind =? FK_PARTIAL {lower_partial_thunk(lf fi);}
        else {lower_inst(lf fi);}
    }
    else if parallel_serial or partition_mode or exr_fast {lower_inst(lf f.inst);}
    else {lower_helper(lf);}
    parallel_serial=false
    partition_mode=false
    lower_finish();
    lower_planning=false
    exr_fast=false
    dir_code_owner=0
}
lower_finish=():>void=>$unsafe {
    if lower_zeros.length =? 0 {
        if not lower_has_nops {return}
        let k:LFnWord=0
        loop ins in ir.code {
            if ins.op not=? 'nop' {
                ir.code.ptr[k] = ins;
                k += 1;
            }
        }
        ir.code.truncate(k);
        return
    }
    lower_zeros.sort(key=(z:LowerZero):>int64=>z.mark);
    let out:array<Ins>=[]
    out.reserve(ir.code.length + lower_zeros.length);
    let next:LFnWord=0
    loop i in [0..ir.code.length + 1) {
        loop next <? lower_zeros.length and lower_zeros.ptr[next].mark >> 32 =? i {
            let z=lower_zeros.ptr[next]
            out.push(Ins['zeroslots' 0 0 int32<overflow='wrap'>(z.start) int32<overflow='wrap'>(z.count) 0 0]);
            next += 1;
        }
        if i <? ir.code.length and ir.code.ptr[i].op not=? 'nop' {out.push(ir.code.ptr[i]);}
    }
    ir.code = out;
}
lower_partial_thunk=(lf:LFnWord th:LFnWord):>void=>$unsafe {

}
each_field=(t0:LFnWord addr:LFnWord f:<(a:int64 b:int64):>void>):>void=>$unsafe {

}

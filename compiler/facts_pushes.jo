# Element value/length hulls of arrays comprehensions build (filtered or not):
# the accumulator, empty or hulled at entry, that the loop's body changes only
# by pushing. Every push site must record a value, in any of the loop's
# passes, which therefore all describe its elements; then the exit value's
# elements lie in the hull. Demand: comprehension loops only, whose pushed
# values the slice demands; O(body) per such loop, O(frames) per push.
# Whether n changes l only by `l.push(v)`, collecting those pushes. Reads are
# free; any other mention by a write, call or mutating intrinsic fails.
fact_push_only = (n: int, l: int, sites: mut int[]) -> bool:
    if n == 0: return true
    k = nodes[n].kind
    if k == .intrinsic and nodes[n].aux == i32(int(IN.push)) and nkids(n) == 2 and fact_push_receiver(kid(n, 0)) == l:
        sites.push(n)
        return fact_push_only(kid(n, 1), l, sites)
    if k == .intrinsic and nodes[n].aux == i32(int(IN.len)): return true
    if k == .assign and fact_mentions(int(nodes[n].a), l): return false
    if (k == .call or k == .addr or k == .intrinsic) and fact_mentions(n, l): return false
    if k == .for_ and nodes[n].aux == 2 and fact_mentions(int(nodes[n].a), l): return false
    mask = isolation_children(k)
    if mask < 0: return k == .lambda or not fact_mentions(n, l)
    if mask & 1 != 0 and not fact_push_only(int(nodes[n].a), l, sites): return false
    if mask & 2 != 0 and not fact_push_only(int(nodes[n].b), l, sites): return false
    if mask & 4 != 0 and not fact_push_only(int(nodes[n].c), l, sites): return false
    if mask & 16 != 0:
        loop i in [0..nkids(n)):
            c = kid(n, i)
            if not fact_push_only(c, l, sites): return false
    true
fact_push_open = (n: int, s: mut FactState, base: int = 0) -> bool:
    acc = fact_comprehensions.get(n) ?? 0
    candidates = if fact_slice.rows: fact_pushed_rows(n) else: []
    if acc > 0 and acc not in candidates: candidates = [acc] + candidates
    if candidates.len() == 0: return false
    frame = FactPushes(n, acc = acc)
    loop l in candidates:
        if int(locals[l].flags) & (LF_CAPTURED | LF_SHARED | LF_ADDR | LF_BYREF | LF_ALIAS | LF_MUTPARAM | LF_EXPOSED) != 0: continue
        t = fact_type(int(locals[l].type))
        if tkind(t) != .array: continue
        e = fact_type(int(types[t].elem))
        sized = e == T_STR or tkind(e) == .array
        components = fact_int_components(e)
        if not sized and components == 0 and (not fact_scalar(e) or not is_int(e) or e == T_U64): continue
        i = fact_binding(s, PlaceIdentity(.local, int(locals[l].owner), l))
        if i < 0: continue
        value = s.bindings[i].value
        if components > 0:
            fact_push_open_components(n, s, frame, l, e, value)
            continue
        bound = FactBound()
        seen = false
        selector = if sized: FACT_ELEMENT_LENGTH else: FACT_ELEMENT_VALUE
        hull = fact_projection_find(s, value, selector, false)
        if hull >= 0:
            bound = fact_bound(s, s.projections[hull].value)
            seen = true
        else if fact_bound(s, fact_project(s, value, -1, false, T_INT)).hi != 0: continue
        sites: int[]
        if fact_mentions(int(nodes[n].a), l) or not fact_push_only(int(nodes[n].b), l, sites) or sites.len() == 0: continue
        # Only empty, one-push-per-iteration row maps can preserve positions.
        # The forward transfer below must additionally prove every row length.
        if l == acc and base != 0 and tkind(e) == .array and nodes[n].aux == 1 and not seen and tkind(fact_type(telem(fact_type(ntype(int(nodes[n].a)))))) == .array:
            flow = fact_push_flow(int(nodes[n].b), l)
            if flow.0 == 1 and flow.1 == -2:
                frame.rows = base
                frame.matching = true
        frame.locals.push(l)
        frame.lengths.push(sized)
        frame.bounds.push(bound)
        frame.seen.push(seen)
        frame.sites.push(sites)
        same = -1
        if tkind(e) == .array:
            held = fact_projection_find(s, value, FACT_ELEMENT_SAME_LENGTH, false)
            if held >= 0: same = s.projections[held].value
            else if not seen: same = 0
            if same >= 0 and not frame.entry.live: frame.entry = s
        frame.same.push(same)
        frame.same_base.push(0)
        frame.same_offset.push(0)
        below = -1
        if not sized:
            held = fact_projection_find(s, value, FACT_ELEMENT_BELOW, false)
            if held >= 0: below = s.projections[held].value
            else if not seen: below = 0
        frame.below.push(below)
        frame.parts.push(-1)
        if fact_int_rows(t): fact_push_open_rows(s, frame, l, value, sites)
    if frame.locals.len() == 0: return false
    frame.mark = fact_terms.len()
    fact_push_frames.push(frame)
    true
# (an array of tuples, as `[loop i in [0..n) [i i]]`: each integer component a
# candidate of its own, with its hull and a value it is below)
fact_push_open_components = (n: int, s: mut FactState, frame: mut FactPushes, l: int, e: int, value: int):
    empty = fact_bound(s, fact_project(s, value, -1, false, T_INT)).hi == 0
    sites: int[]
    if fact_mentions(int(nodes[n].a), l) or not fact_push_only(int(nodes[n].b), l, sites) or sites.len() == 0: return
    loop c in [0..fact_int_components(e)):
        if not fact_int_component(e, c): continue
        bound = FactBound()
        seen = false
        hull = fact_projection_find(s, value, fact_component_selector(c, false), false)
        if hull >= 0:
            bound = fact_bound(s, s.projections[hull].value)
            seen = true
        else if not empty: continue
        below = -1
        held = fact_projection_find(s, value, fact_component_selector(c, true), false)
        if held >= 0: below = s.projections[held].value
        else if not seen: below = 0
        frame.locals.push(l)
        frame.lengths.push(false)
        frame.bounds.push(bound)
        frame.seen.push(seen)
        frame.sites.push(sites)
        frame.same.push(-1)
        frame.same_base.push(0)
        frame.same_offset.push(0)
        frame.below.push(below)
        frame.parts.push(c)
# (an array of integer rows, as `[loop i in [0..n) [i i]]`: every element of every row, a
# candidate of its own beside the rows' lengths)
fact_push_open_rows = (s: mut FactState, frame: mut FactPushes, l: int, value: int, sites: int[]):
    bound = FactBound()
    seen = false
    hull = fact_projection_find(s, value, fact_component_selector(FACT_ROW_ELEMENTS, false), false)
    if hull >= 0:
        bound = fact_bound(s, s.projections[hull].value)
        seen = true
    else if fact_bound(s, fact_project(s, value, -1, false, T_INT)).hi != 0: return
    below = -1
    held = fact_projection_find(s, value, fact_component_selector(FACT_ROW_ELEMENTS, true), false)
    if held >= 0: below = s.projections[held].value
    else if not seen: below = 0
    frame.locals.push(l)
    frame.lengths.push(false)
    frame.bounds.push(bound)
    frame.seen.push(seen)
    frame.sites.push(sites)
    frame.same.push(-1)
    frame.same_base.push(0)
    frame.same_offset.push(0)
    frame.below.push(below)
    frame.parts.push(FACT_ROW_ELEMENTS)
# Any element of the pushed row: a value within their hull, and below a value the loop's
# entry evaluated when each of them is (a literal's elements, or a row with such facts).
# A row with neither gives a value with no facts. O(row's inventory).
fact_push_row_value = (s: mut FactState, row: int, mark: int) -> int:
    e = fact_type(telem(fact_type(fact_terms[row].type)))
    parts = fact_inventory(s, row)
    if parts.len() == 0:
        v = fact_new(s, fact_element_hull(s, row, e), FactTerm(type = e))
        below = fact_projection_find(s, row, FACT_ELEMENT_BELOW, false)
        if below >= 0: fact_difference(s, v, s.projections[below].value, -1, 0, 16)
        return v
    b = fact_bound(s, parts[0])
    loop i in [1..parts.len()): b = fact_hull(b, fact_bound(s, parts[i]), 0)
    v = fact_new(s, b, FactTerm(type = e))
    top = fact_push_below(s, parts[0], mark)
    if top < 0: return v
    loop part in parts:
        if fact_compare(s, .lt, part, top) != 1: return v
    fact_difference(s, v, top, -1, 0, 16)
    v
# The pushed length v is a value equal to one loop entry held, or to the
# length of a value it held (`if cells.length not=? header.length continue`
# then `rows.push(cells)`): immutable, so the same at every iteration. Kept
# as (value, 0), or (0, that value) for its length. Its rows only; O(rows of v).
# (two steps, each at a small exact offset: a comprehension's length is its
# count, which is its range's end, one more for an inclusive one,
# `[loop j in [0..b.length] 0]`). Kept as (value, 0, offset) or (0, that
# value, offset) for its length plus offset.
fact_push_same = (s: mut FactState, v: int, entry: FactState, depth: int = 0) -> (int, int, int):
    found = fact_push_invariant(s, v, entry)
    if found.0 != 0 or found.1 != 0: return (found.0, found.1, 0)
    loop direction in [0..2):
        ri = fact_difference_head(s, v, direction)
        loop ri >= 0:
            row = s.differences[ri]
            ri = fact_difference_next(s, ri, direction)
            w = if direction == 0: row.a else: row.b
            if w == v or row.limit < -16 or row.limit > 16: continue
            # (v = w + d exactly)
            d = if direction == 0: -row.limit else: row.limit
            if d == 0:
                if fact_compare(s, .eq, v, w) != 1: continue
            else if not (fact_entails(s, v, w, d) and fact_entails(s, w, v, -d)): continue
            if depth == 0:
                deeper = fact_push_same(s, w, entry, 1)
                if deeper.0 > 0 or deeper.1 > 0: return (deeper.0, deeper.1, deeper.2 + d)
            else:
                found = fact_push_invariant(s, w, entry)
                if found.0 != 0 or found.1 != 0: return (found.0, found.1, d)
    (-1, 0, 0)
fact_push_invariant = (s: FactState, w: int, entry: FactState) -> (int, int):
    if fact_slot(entry, w) >= 0: return (w, 0)
    pi = fact_projection_origin(s, w)
    if pi >= 0 and s.projections[pi].selector == -1 and not s.projections[pi].element and fact_slot(entry, s.projections[pi].base) >= 0: return (0, s.projections[pi].base)
    (0, 0)
# A value v is below that the loop's entry evaluated (its id precedes the
# frame's mark, so it is one value at every iteration): `i <? hi` of the
# range `[lo..hi)`. v's rows only, O(rows of v); -1 none.
fact_push_below = (s: FactState, v: int, mark: int) -> int:
    ri = fact_difference_head(s, v, 1)
    loop ri >= 0:
        row = s.differences[ri]
        ri = fact_difference_next(s, ri, 1)
        if row.b < mark and row.limit <= -1 and fact_slot(s, row.b) >= 0: return row.b
    -1
# The shared length in s (fact_push_same's triple), or 0.
fact_push_same_value = (s: mut FactState, same: int, base: int, offset: int = 0) -> int:
    held = 0
    if same > 0 and fact_slot(s, same) >= 0: held = same
    else if base > 0 and fact_slot(s, base) >= 0: held = fact_project(s, base, -1, false, T_INT)
    if held == 0 or offset == 0: return held
    b = fact_bound(s, held)
    if not fact_add_fits(b.lo, offset) or not fact_add_fits(b.hi, offset): return 0
    shifted = fact_new(s, FactBound(max(0, b.lo + offset), min(b.hi + offset, fact_length_max())), FactTerm(.plus, held, fact_constant(s, offset), 0, T_INT))
    fact_difference(s, shifted, held, offset, 0)
    fact_difference(s, held, shifted, -offset, 0)
    shifted
# An array of rows (arrays).
fact_row_array = (t0: int) -> bool:
    t = fact_type(t0)
    tkind(t) == .array and tkind(fact_type(int(types[t].elem))) == .array
fact_pushed_rows = (n: int) -> int[]:
    if let known = fact_pushed_rows_cache.get(n): return known
    out: int[]
    work = [int(nodes[n].b)]
    loop work.len() > 0:
        e = work.pop()
        if e == 0: continue
        k = nodes[e].kind
        if k == .lambda: continue
        if k == .intrinsic and nodes[e].aux == i32(int(IN.push)) and nkids(e) == 2:
            l = fact_push_receiver(kid(e, 0))
            if l > 0 and locals[l].pos < nodes[n].pos and l not in out:
                if fact_row_array(int(locals[l].type)): out.push(l)
        mask = isolation_children(k)
        if mask < 0: continue
        if mask & 1 != 0: work.push(int(nodes[e].a))
        if mask & 2 != 0: work.push(int(nodes[e].b))
        if mask & 4 != 0: work.push(int(nodes[e].c))
        if mask & 16 != 0:
            loop i in [0..nkids(e)): work.push(kid(e, i))
    fact_pushed_rows_cache[n] = out
    out
fact_push_record = (n: int, s: mut FactState, value: int):
    l = fact_push_receiver(kid(n, 0))
    if l <= 0: return
    loop f in [0..fact_push_frames.len()):
        loop j in [0..fact_push_frames[f].locals.len()):
            if fact_push_frames[f].locals[j] != l: continue
            v = if fact_push_frames[f].lengths[j]: fact_project(s, value, -1, false, T_INT) else: value
            c = fact_push_frames[f].parts[j]
            if c == FACT_ROW_ELEMENTS: v = fact_push_row_value(s, value, fact_push_frames[f].mark)
            else if c >= 0:
                e = fact_type(int(types[fact_type(int(locals[l].type))].elem))
                v = fact_project(s, value, c, false, fact_type(targ(e, c)))
            same = fact_push_frames[f].same[j]
            base = fact_push_frames[f].same_base[j]
            offset = fact_push_frames[f].same_offset[j]
            if same == 0 and base == 0:
                found = fact_push_same(s, v, fact_push_frames[f].entry)
                fact_push_frames[f].same[j] = found.0
                fact_push_frames[f].same_base[j] = found.1
                fact_push_frames[f].same_offset[j] = found.2
            else if same >= 0:
                held = fact_push_same_value(s, same, base)
                kept = held != 0
                if kept and offset == 0: kept = fact_compare(s, .eq, v, held) == 1
                else if kept: kept = fact_entails(s, v, held, offset) and fact_entails(s, held, v, -offset)
                if not kept:
                    fact_push_frames[f].same[j] = -1
                    fact_push_frames[f].same_base[j] = 0
            if fact_push_frames[f].matching and l == fact_push_frames[f].acc:
                loop_ = fact_push_frames[f].at
                index = fact_binding(s, PlaceIdentity(.local, fact_owner, int(nodes[loop_].c)))
                if index < 0: fact_push_frames[f].matching = false
                else:
                    row = fact_project(s, fact_push_frames[f].rows, s.bindings[index].value, true, int(locals[int(nodes[loop_].sym)].type))
                    length = fact_project(s, row, -1, false, T_INT)
                    if fact_compare(s, .eq, v, length) != 1: fact_push_frames[f].matching = false
            below = fact_push_frames[f].below[j]
            if below == 0: fact_push_frames[f].below[j] = fact_push_below(s, v, fact_push_frames[f].mark)
            else if below > 0 and fact_compare(s, .lt, v, below) != 1: fact_push_frames[f].below[j] = -1
            b = fact_bound(s, v)
            fact_push_frames[f].bounds[j] = if fact_push_frames[f].seen[j]: fact_hull(fact_push_frames[f].bounds[j], b, n) else: b
            fact_push_frames[f].seen[j] = true
            fact_push_frames[f].recorded[n] = true
# Close loop n's frame: each candidate every push site recorded gets its hull.
fact_push_close = (n: int, s: mut FactState):
    frame = fact_push_frames.pop()
    loop j in [0..frame.locals.len()):
        all = frame.seen[j]
        loop site in frame.sites[j]:
            if not frame.recorded.has(site): all = false
        b = frame.bounds[j]
        if not all or s.projections.len() >= FACT_CAP: continue
        l = frame.locals[j]
        i = fact_binding(s, PlaceIdentity(.local, int(locals[l].owner), l))
        if i >= 0 and frame.same[j] >= 0 and fact_projection_find(s, s.bindings[i].value, FACT_ELEMENT_SAME_LENGTH, false) < 0:
            same = fact_push_same_value(s, frame.same[j], frame.same_base[j], frame.same_offset[j])
            if same != 0 and s.projections.len() < FACT_CAP: fact_add_projection(s, FactProjection(s.bindings[i].value, FACT_ELEMENT_SAME_LENGTH, false, same))
        if i >= 0 and frame.matching and l == frame.acc:
            source = frame.rows
            prior = fact_projection_find(s, source, FACT_ROW_SOURCE, false)
            if prior >= 0: source = s.projections[prior].value
            fact_add_projection(s, FactProjection(s.bindings[i].value, FACT_ROW_SOURCE, false, source))
        below = frame.below[j]
        c = frame.parts[j]
        below_selector = FACT_ELEMENT_BELOW
        if c >= 0: below_selector = fact_component_selector(c, true)
        if i >= 0 and below > 0 and fact_slot(s, below) >= 0 and fact_projection_find(s, s.bindings[i].value, below_selector, false) < 0 and s.projections.len() < FACT_CAP:
            fact_add_projection(s, FactProjection(s.bindings[i].value, below_selector, false, below))
        if b.wide: continue
        selector = if frame.lengths[j]: FACT_ELEMENT_LENGTH else: FACT_ELEMENT_VALUE
        if c >= 0: selector = fact_component_selector(c, false)
        if i < 0 or fact_projection_find(s, s.bindings[i].value, selector, false) >= 0: continue
        b.reason = .loop_; b.witness = n
        fact_hull_owner = fact_owner
        fact_add_projection(s, FactProjection(s.bindings[i].value, selector, false, fact_new(s, b)))
# A local the loop sets only to its index (`found = i` before a `break`)
# that still holds a constant K where the range ran out: past the join,
# `found >? K` means a break exit, where found was that exit's index. What the
# exit held of the element at that index (its value or its length) against a
# value both states share, or a constant, becomes an implication of
# `found >? K`, which a later guard applies (`if found <? 0 continue`). Sound:
# the joined state is the disjunction of the two, the antecedent refutes the
# exhausted one, and values present in both are the same evaluations.
# Demand: range loops with such a local and a live break exit. O(P + rows of
# each element), at most 8 implications in a state (fact_either's budget).
fact_carried_exit = (s: mut FactState, l: int, after: FactState, exits: mut FactState):
    place = PlaceIdentity(.local, int(locals[l].owner), l)
    ai = fact_binding(after, place); xi = fact_binding(exits, place); si = fact_binding(s, place)
    if ai < 0 or xi < 0 or si < 0: return
    k = fact_bound(after, after.bindings[ai].value)
    found = exits.bindings[xi].value
    phi = s.bindings[si].value
    if k.wide or k.lo != k.hi or phi == found or fact_bound(exits, found).lo <= k.lo: return
    held = 0
    loop evidence in s.conditional: held += int(evidence.tag == -2)
    ante = (Tok.gt, 0, phi, 1, k.lo)
    loop pi in [0..exits.projections.len()):
        p = exits.projections[pi]
        if not p.element or p.selector != found or fact_slot(s, p.base) < 0 or s.projections.len() + 32 >= FACT_CAP: continue
        element = fact_project(s, p.base, phi, true, fact_terms[p.value].type)
        # (and its parts: a length, fields, elements at shared positions; at most 16)
        parts = [(p.value, element)]
        at = 0
        loop at < parts.len() and parts.len() < 16:
            qi = fact_projection_first(exits, parts[at].0)
            loop qi >= 0 and parts.len() < 16:
                q = exits.projections[qi]
                qi = fact_projection_after(exits, qi)
                if q.element and q.selector != found and fact_slot(s, q.selector) < 0: continue
                if not q.element and q.selector != -1 and q.selector < 0: continue
                selector = if q.element and q.selector == found: phi else: q.selector
                parts.push((q.value, fact_project(s, parts[at].1, selector, q.element, (if not q.element and q.selector == -1: T_INT else: fact_terms[q.value].type))))
            at += 1
        loop part in parts:
            x = part.0
            b = fact_bound(exits, x)
            d = fact_bound(s, part.1)
            consequents: (Tok, int, int, int, int)[]
            if not b.wide and b.lo > d.lo: consequents.push((Tok.ge, 0, part.1, 1, b.lo))
            if not b.wide and b.hi < d.hi: consequents.push((Tok.le, 0, part.1, 1, b.hi))
            if b.nz and not d.nz and b.lo <= 0 and b.hi >= 0: consequents.push((Tok.ne, 0, part.1, 1, 0))
            loop direction in [0..2):
                ri = fact_difference_head(exits, x, direction)
                loop ri >= 0:
                    row = exits.differences[ri]
                    ri = fact_difference_next(exits, ri, direction)
                    if row.limit != 0 and row.limit != -1: continue
                    w = if direction == 0: row.a else: row.b
                    if w == found: w = phi
                    else if fact_slot(s, w) < 0: continue
                    op = if row.limit == 0: Tok.le else: Tok.lt
                    if direction == 0: consequents.push((op, 0, w, 0, part.1))
                    else: consequents.push((op, 0, part.1, 0, w))
            loop then in consequents:
                if held >= 8 or s.conditional.len() >= 32: return
                fact_implication(s, ante, then)
                held += 1

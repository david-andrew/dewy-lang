# A counted push: a local array the loop body pushes onto exactly once on
# every completed iteration, with readonly uses but no other mutation (no
# break), so after the loop its length is its entry length plus the
# iteration count (a comprehension's accumulator, `out.push(f(x))`).
fact_mentions = (n: int, l: int) -> bool:
    if n == 0: return false
    k = nodes[n].kind
    if k == .ident: return nodes[n].aux == i32(int(SK.local)) and nodes[n].sym == i32(l)
    mask = isolation_children(k)
    if mask < 0: return k != .lambda
    if mask & 1 != 0 and fact_mentions(int(nodes[n].a), l): return true
    if mask & 2 != 0 and fact_mentions(int(nodes[n].b), l): return true
    if mask & 4 != 0 and fact_mentions(int(nodes[n].c), l): return true
    if mask & 16 != 0:
        loop i in [0..nkids(n)):
            c = kid(n, i)
            if fact_mentions(c, l): return true
    false
fact_labeled_exit = (n: int) -> bool:
    if n == 0: return false
    k = nodes[n].kind
    if k == .break_ or k == .continue_: return nodes[n].name != 0
    mask = isolation_children(k)
    if mask < 0: return k != .lambda
    if mask & 1 != 0 and fact_labeled_exit(int(nodes[n].a)): return true
    if mask & 2 != 0 and fact_labeled_exit(int(nodes[n].b)): return true
    if mask & 4 != 0 and fact_labeled_exit(int(nodes[n].c)): return true
    if mask & 16 != 0:
        loop i in [0..nkids(n)):
            c = kid(n, i)
            if fact_labeled_exit(c): return true
    false
fact_push_receiver = (e: int) -> int:
    if nodes[e].kind == .ident and nodes[e].aux == i32(int(SK.local)): return int(nodes[e].sym)
    0
# Counts on normal and continue edges (-2: absent; -1: unknown). Returning
# paths leave the function, so only completed iterations constrain the count.
# A break or other mutation still refuses the counted-loop proof. O(body)
# per demanded candidate (at most eight); no new loop iterations or budget.
fact_push_merge = (a: int, b: int) -> int:
    if a == -2: b else if b == -2: a else if a == b: a else: -1
fact_push_then = (a: (int, int), b: (int, int)) -> (int, int):
    if a.0 == -2: return a
    if a.0 < 0 or a.1 == -1 or b.0 == -1 or b.1 == -1: return (-1, -1)
    normal = if b.0 == -2: -2 else: a.0 + b.0
    continued = fact_push_merge(a.1, (if b.1 == -2: -2 else: a.0 + b.1))
    (normal, continued)
fact_push_flow = (n: int, l: int) -> (int, int):
    if n == 0: return (0, -2)
    k = nodes[n].kind
    if k == .break_: return (-1, -1)
    if k == .continue_:
        if nodes[n].name != 0 or nodes[n].ival != 0: return (-1, -1)
        return (-2, 0)
    if k == .return_: return fact_push_then(fact_push_flow(int(nodes[n].a), l), (-2, -2))
    if k == .lambda: return (0, -2)
    if k == .intrinsic and nodes[n].aux == i32(int(IN.push)) and nkids(n) == 2 and fact_push_receiver(kid(n, 0)) == l:
        return fact_push_then(fact_push_flow(kid(n, 1), l), (1, -2))
    if k == .assign and fact_mentions(int(nodes[n].a), l): return (-1, -1)
    if (k == .call or k == .addr or k == .intrinsic and nodes[n].aux != i32(int(IN.len))) and fact_mentions(n, l): return (-1, -1)
    # A nested loop may exit this one only with a labeled edge. Any return
    # in it ends the function; a normal exit makes no change to this array.
    if k == .while_ or k == .for_:
        if fact_mentions(n, l) or fact_labeled_exit(n): return (-1, -1)
        return (0, -2)
    if k == .and_ or k == .or_ or k == .coalesce:
        if fact_mentions(n, l): return (-1, -1)
        a = fact_push_flow(int(nodes[n].a), l)
        b = fact_push_flow(int(nodes[n].b), l)
        return fact_push_then(a, (fact_push_merge(0, b.0), b.1))
    if k == .if_ or k == .iflet:
        condition = fact_push_flow(int(nodes[n].a), l)
        if fact_mentions(int(nodes[n].a), l): return (-1, -1)
        y = fact_push_flow(int(nodes[n].b), l)
        z = fact_push_flow(int(nodes[n].c), l)
        return fact_push_then(condition, (fact_push_merge(y.0, z.0), fact_push_merge(y.1, z.1)))
    if k == .match_:
        if fact_mentions(int(nodes[n].a), l): return (-1, -1)
        common = (-2, -2)
        exhaustive = false
        loop i in [0..nkids(n)):
            arm = kid(n, i)
            if fact_mentions(int(nodes[arm].a), l) or fact_mentions(int(nodes[arm].c), l): return (-1, -1)
            loop guard in [int(nodes[arm].a), int(nodes[arm].c)]:
                g = fact_push_flow(guard, l)
                if g.0 == -1 or g.1 != -2: return (-1, -1)
            loop j in [0..nkids(arm)):
                p = kid(arm, j)
                if fact_mentions(p, l): return (-1, -1)
                if nodes[p].kind == .pwild and nodes[arm].a == 0 and nodes[arm].c == 0: exhaustive = true
            c = fact_push_flow(int(nodes[arm].b), l)
            common = (fact_push_merge(common.0, c.0), fact_push_merge(common.1, c.1))
        if not exhaustive: common.0 = fact_push_merge(common.0, 0)
        return fact_push_then(fact_push_flow(int(nodes[n].a), l), common)
    if k == .ident: return (0, -2)
    mask = isolation_children(k)
    if mask < 0: return (-1, -1)
    total = (0, -2)
    parts: int[]
    if mask & 1 != 0: parts.push(int(nodes[n].a))
    if mask & 2 != 0: parts.push(int(nodes[n].b))
    if mask & 4 != 0: parts.push(int(nodes[n].c))
    if mask & 16 != 0: parts += kids(n)
    loop c in parts:
        if total.0 == -2: break
        total = fact_push_then(total, fact_push_flow(c, l))
        if total.0 == -1 or total.1 == -1: return (-1, -1)
    total
fact_push_count = (n: int, l: int) -> int:
    flow = fact_push_flow(n, l)
    fact_push_merge(flow.0, flow.1)
# Each counted-push local of loop n with its entry length.
fact_counted_pushes = (n: int, s: mut FactState) -> (int, int)[]:
    found: (int, int)[]
    body = int(nodes[n].b)
    candidates: int[]
    fact_push_candidates(body, candidates)
    loop l in candidates:
        if int(locals[l].flags) & (LF_CAPTURED | LF_SHARED | LF_ADDR | LF_BYREF | LF_ALIAS | LF_MUTPARAM | LF_EXPOSED) != 0: continue
        if tkind(fact_type(int(locals[l].type))) != .array: continue
        if fact_mentions(int(nodes[n].a), l) or fact_push_count(body, l) != 1: continue
        i = fact_binding(s, PlaceIdentity(.local, int(locals[l].owner), l))
        if i < 0: continue
        found.push((l, fact_project(s, s.bindings[i].value, -1, false, T_INT)))
    found
# Each local of loop n that every iteration pushes onto a fixed k >= 2 times
# (`[loop x in xs {x x*x}]`), with its entry length and k. O(candidate arrays).
fact_scaled_pushes = (n: int, s: mut FactState) -> (int, int, int)[]:
    found: (int, int, int)[]
    body = int(nodes[n].b)
    candidates: int[]
    fact_push_candidates(body, candidates)
    loop l in candidates:
        if int(locals[l].flags) & (LF_CAPTURED | LF_SHARED | LF_ADDR | LF_BYREF | LF_ALIAS | LF_MUTPARAM | LF_EXPOSED) != 0: continue
        if tkind(fact_type(int(locals[l].type))) != .array or fact_mentions(int(nodes[n].a), l): continue
        k = fact_push_count(body, l)
        if k < 2 or k > 64: continue
        i = fact_binding(s, PlaceIdentity(.local, int(locals[l].owner), l))
        if i < 0: continue
        found.push((l, fact_project(s, s.bindings[i].value, -1, false, T_INT), k))
    found
# After the loop: each such local's length is its entry length plus k times the count.
fact_scaled_lengths = (n: int, s: mut FactState, pushes: (int, int, int)[], count: int):
    loop entry in pushes:
        if s.projections.len() >= FACT_CAP: return
        i = fact_binding(s, PlaceIdentity(.local, int(locals[entry.0].owner), entry.0))
        if i < 0: continue
        c = fact_bound(s, count)
        e = fact_bound(s, entry.1)
        k = entry.2
        if c.wide or e.wide or c.lo < 0 or e.lo < 0 or e.lo != e.hi or c.hi > fact_length_max(): continue
        # (the array holds count*k elements, so the product is a length too:
        # within the enabled ceiling)
        cap = fact_length_max()
        added = fact_new(s, FactBound(min(c.lo * k, cap), min(c.hi * k, cap)), FactTerm(.star, count, fact_constant(s, k), n, T_INT))
        total = added
        if e.lo != 0:
            total = fact_new(s, FactBound(min(c.lo * k + e.lo, cap), min(c.hi * k + e.lo, cap)), FactTerm(.plus, entry.1, added, n, T_INT))
            fact_difference(s, total, added, e.lo, n)
            fact_difference(s, added, total, -e.lo, n)
        fact_add_projection(s, FactProjection(s.bindings[i].value, -1, false, total))
# A counted push never shrinks its receiver. Seed the entry lower bound at
# each head; its upper bound remains unknown until the counted exit. An entry
# length with rows (`d <=? out.length`) is also at most the current length,
# so those rows reach it (LZ77's `out[out.length - d]` while pushing).
# O(candidate arrays), using the same checked inventory as counted lengths.
fact_growing_lengths = (s: mut FactState, pushes: (int, int)[]):
    loop item in pushes:
        lower = fact_bound(s, item.1).lo
        related = fact_slot(s, item.1) >= 0 and fact_incident(s, item.1) >= 0
        if lower <= 0 and not related: continue
        i = fact_binding(s, PlaceIdentity(.local, int(locals[item.0].owner), item.0))
        if i < 0: continue
        length = fact_project(s, s.bindings[i].value, -1, false, T_INT)
        b = fact_bound(s, length)
        b.lo = max(b.lo, lower)
        fact_set_bound(s, length, b)
        if related: fact_difference(s, item.1, length, 0)
# Each other local of loop n that the body changes only by pushes, however
# many (`if keep(x) out.push(x)`), with its entry length when that has a
# positive lower bound or rows: a length that never shrinks keeps it at every head
# and exit (fact_growing_lengths). O(candidate arrays x body).
fact_growing_pushes = (n: int, s: mut FactState, counted: (int, int)[]) -> (int, int)[]:
    found: (int, int)[]
    body = int(nodes[n].b)
    candidates: int[]
    fact_push_candidates(body, candidates)
    loop l in candidates:
        known = false
        loop c in counted:
            if c.0 == l: known = true
        if known or int(locals[l].flags) & (LF_CAPTURED | LF_SHARED | LF_ADDR | LF_BYREF | LF_ALIAS | LF_MUTPARAM | LF_EXPOSED) != 0: continue
        if tkind(fact_type(int(locals[l].type))) != .array or fact_mentions(int(nodes[n].a), l): continue
        i = fact_binding(s, PlaceIdentity(.local, int(locals[l].owner), l))
        if i < 0: continue
        length = fact_project(s, s.bindings[i].value, -1, false, T_INT)
        if fact_bound(s, length).lo <= 0 and fact_incident(s, length) < 0: continue
        sites: int[]
        if fact_push_only(body, l, sites): found.push((l, length))
    found
fact_push_candidates = (n: int, out: mut int[]):
    if n == 0 or out.len() >= 8: return
    k = nodes[n].kind
    if k == .intrinsic and nodes[n].aux == i32(int(IN.push)) and nkids(n) == 2:
        l = fact_push_receiver(kid(n, 0))
        if l > 0 and not out.contains(l): out.push(l)
    mask = isolation_children(k)
    if mask < 0: return
    if mask & 1 != 0: fact_push_candidates(int(nodes[n].a), out)
    if mask & 2 != 0: fact_push_candidates(int(nodes[n].b), out)
    if mask & 4 != 0: fact_push_candidates(int(nodes[n].c), out)
    if mask & 16 != 0:
        loop i in [0..nkids(n)): fact_push_candidates(kid(n, i), out)
# After the loop: each counted local's length is its entry length plus count.
fact_counted_lengths = (n: int, s: mut FactState, pushes: (int, int)[], count: int):
    if count == 0: return
    c = fact_bound(s, count)
    if c.lo < 0: return
    loop entry in pushes:
        i = fact_binding(s, PlaceIdentity(.local, int(locals[entry.0].owner), entry.0))
        if i < 0: continue
        e = fact_bound(s, entry.1)
        lo = if fact_add_fits(e.lo, c.lo): e.lo + c.lo else: 0
        hi = if fact_add_fits(e.hi, c.hi): e.hi + c.hi else: FACT_MAX
        total = fact_new(s, FactBound(min(max(lo, 0), fact_length_max()), min(hi, fact_length_max())), FactTerm(.plus, entry.1, count, n, T_INT))
        if e.lo == e.hi:
            fact_difference(s, total, count, e.lo, n)
            fact_difference(s, count, total, -e.lo, n)
        if s.projections.len() < FACT_CAP: fact_add_projection(s, FactProjection(s.bindings[i].value, -1, false, total))
# Relations a range loop keeps between scalars it changes (`low <=? high`
# while tracking a minimum and maximum): pairs of changed scalar places whose
# entry values a row (or one shared value) relates. Candidates only, to be
# validated by fact_range_invariants. A value with one known value (a
# constant start) is left to its interval. At most 8 places, 8 rows.
fact_range_candidates = (pre: FactState, s: FactState) -> (PlaceIdentity, PlaceIdentity, int)[]:
    out: (PlaceIdentity, PlaceIdentity, int)[]
    places: PlaceIdentity[]
    starts: int[]
    loop binding in s.bindings:
        if places.len() >= 8: break
        if binding.place.root != .local: continue
        i = fact_binding(pre, binding.place)
        if i < 0 or pre.bindings[i].value == binding.value or not fact_scalar(int(locals[binding.place.declaration].type)): continue
        start = pre.bindings[i].value
        b = fact_bound(pre, start)
        if b.lo == b.hi: continue
        places.push(binding.place)
        starts.push(start)
    if places.len() < 2: return out
    loop i in [0..places.len()):
        loop j in [0..places.len()):
            if i == j or out.len() >= 8: continue
            d = fact_shortest(pre, starts[i], starts[j])
            if d != FACT_MAX: out.push((places[i], places[j], d))
    out
fact_range_assume = (s: mut FactState, rows: (PlaceIdentity, PlaceIdentity, int)[], at: int):
    loop row in rows:
        i = fact_binding(s, row.0)
        j = fact_binding(s, row.1)
        if i >= 0 and j >= 0: fact_difference(s, s.bindings[i].value, s.bindings[j].value, row.2, at)
# The candidates every backedge and break keeps (a state that is not live
# keeps them all).
fact_range_kept = (edges: FactLoop, rows: (PlaceIdentity, PlaceIdentity, int)[]) -> (PlaceIdentity, PlaceIdentity, int)[]:
    out: (PlaceIdentity, PlaceIdentity, int)[]
    loop row in rows:
        held = true
        loop t in [edges.back, edges.exits]:
            if not t.live: continue
            i = fact_binding(t, row.0)
            j = fact_binding(t, row.1)
            if i < 0 or j < 0 or not fact_distance(t, t.bindings[i].value, t.bindings[j].value, row.2): held = false
        if held: out.push(row)
    out
# A range loop's body with its loop value bound and bounded by the range.
fact_range_body = (n: int, s: FactState, lo: int, hi: int) -> FactState:
    iterator = int(nodes[n].a)
    body = s
    l = int(nodes[n].sym)
    v = fact_fresh(body, int(locals[l].type))
    fact_bind(body, PlaceIdentity(.local, int(locals[l].owner), l), v)
    lower = fact_new(body, fact_domain(T_BOOL), FactTerm(.ge, v, lo))
    upper = fact_new(body, fact_domain(T_BOOL), FactTerm((if has_flag(iterator, NF_INCLUSIVE): Tok.le else: Tok.lt), v, hi))
    fact_assume(body, lower, true)
    if nodes[iterator].b != 0: fact_assume(body, upper, true)
    body
# Houdini over the candidates: a speculative pass with all of them assumed at
# the head drops those a backedge or break loses, and a second pass must keep
# the rest, or none is kept. Each kept row holds at entry and is preserved, so
# it holds at every head and at the exit. At most two extra body passes, only
# for a loop with related changing scalars.
fact_range_invariants = (n: int, pre: FactState, s: mut FactState, lo: int, hi: int):
    if fact_loop_exhausted: return
    rows = fact_range_candidates(pre, s)
    if rows.len() == 0: return
    outer = fact_speculating
    fact_speculating += 1
    settled = false
    loop round in [0..2):
        trial = s
        fact_range_assume(trial, rows, n)
        body = fact_range_body(n, trial, lo, hi)
        edges = fact_loop_body(n, body)
        if not edges.back.live and not edges.exits.live: break
        kept = fact_range_kept(edges, rows)
        if kept.len() == rows.len():
            settled = true
            break
        rows = kept
        if rows.len() == 0: break
    fact_speculating = outer
    if settled and not fact_loop_exhausted: fact_range_assume(s, rows, n)
# A bounded range can update a private scalar at most once per iteration.
# Use declared operand ranges, not a speculative backedge: even conditional
# updates stay within entry + [0,count] * delta. O(body nodes); nested loops
# and exposed locals remain unknown. Fixed-width targets are demanded only by
# static exact stores. A mathematical int counter (`count += 1`) needs no
# store proof; its sum bounds later narrowing of the counter.
fact_range_sums = (n: int, s: FactState, lo: int, hi: int) -> (int, FactBound)[]:
    it = int(nodes[n].a)
    if nodes[it].b == 0: return []
    x = fact_bound(s, lo); y = fact_bound(s, hi)
    if x.wide or y.wide or x.lo == FACT_MIN or y.hi == FACT_MAX or not fact_add_fits(y.hi, -x.lo): return []
    count = max(0, y.hi - x.lo)
    if has_flag(it, NF_INCLUSIVE):
        if count == FACT_MAX: return []
        count += 1
    fact_counted_sums(n, s, count)
# The sums of a loop that runs at most count times (see fact_range_sums).
fact_counted_sums = (n: int, s: FactState, count: int) -> (int, FactBound)[]:
    out: (int, FactBound)[]
    exact = exact_proof_demands.has(fact_owner) and count <= 1048576
    work = [int(nodes[n].b)]
    stores: (int, int)[]
    seen: {int: bool} = {}
    bad: {int: bool} = {}
    loop work.len() > 0:
        e = work.pop()
        if e == 0: continue
        k = nodes[e].kind
        # (creating a partial application, like a handle, writes nothing; its
        # calls write only places the flags below exclude)
        if k == .while_ or k == .for_ or k == .lambda or k == .partial and fact_partial_opaque(e) or k == .defer_: return out
        if k == .assign:
            a = int(nodes[e].a)
            if nodes[a].kind == .tuple: return out
            if nodes[a].kind == .ident and nodes[a].aux == i32(int(SK.local)):
                l = int(nodes[a].sym)
                if seen.has(l): bad[l] = true
                seen[l] = true
                store = int(nodes[e].b)
                operation = 0
                if exact_has_store(store):
                    if exact and fact_exact_demand(store): operation = fact_progress_strip(int(nodes[store].a))
                else if fact_type(int(locals[l].type)) == T_MATH_INT: operation = fact_progress_strip(store)
                if operation > 0 and nodes[operation].kind == .binary and nodes[operation].aux == 0 and (nodes[operation].op == i32(int(Tok.plus)) or nodes[operation].op == i32(int(Tok.minus))) and fact_progress_same(a, int(nodes[operation].a)) and not exact_has_node(int(nodes[operation].b)):
                    stores.push((l, operation))
                else: bad[l] = true
        mask = isolation_children(k)
        if mask < 0: return out
        if mask & 1 != 0: work.push(int(nodes[e].a))
        if mask & 2 != 0: work.push(int(nodes[e].b))
        if mask & 4 != 0: work.push(int(nodes[e].c))
        if mask & 16 != 0:
            loop j in [0..nkids(e)): work.push(kid(e, j))
    loop item in stores:
        l = item.0; e = item.1
        if bad.has(l) or int(locals[l].flags) & (LF_CAPTURE | LF_CAPTURED | LF_SHARED | LF_ADDR | LF_BYREF | LF_ALIAS | LF_MUTPARAM | LF_EXPOSED) != 0: continue
        i = fact_binding(s, PlaceIdentity(.local, int(locals[l].owner), l))
        if i < 0: continue
        entry = fact_bound(s, s.bindings[i].value)
        rhs = int(nodes[e].b)
        # A widening conversion keeps the operand's declared interval.
        loop nodes[rhs].kind == .conv and nodes[rhs].aux == i32(int(CV.int_)):
            before = fact_domain(ntype(int(nodes[rhs].a)))
            after = fact_domain(ntype(rhs))
            if before.wide or after.wide or before.lo < after.lo or before.hi > after.hi: break
            rhs = int(nodes[rhs].a)
        delta = fact_domain(ntype(rhs))
        # (a literal step is its own interval; a mathematical int is unbounded)
        if nodes[rhs].kind == .int_lit and not oversized_literal(rhs) and not has_flag(rhs, NF_U64): delta = FactBound(nodes[rhs].ival, nodes[rhs].ival)
        else if fact_type(ntype(rhs)) == T_MATH_INT: continue
        if entry.wide or delta.wide or delta.lo < -2147483648 or delta.hi > 2147483647: continue
        low = min(0, delta.lo); high = max(0, delta.hi)
        if nodes[e].op == i32(int(Tok.minus)):
            low = min(0, -delta.hi); high = max(0, -delta.lo)
        if count > 0 and (-low > FACT_MAX / count or high > FACT_MAX / count): continue
        low *= count; high *= count
        # (a mathematical int's endpoint sentinels mean unbounded: keep them)
        if low != 0 and entry.lo == FACT_MIN or high != 0 and entry.hi == FACT_MAX: continue
        if not fact_add_fits(entry.lo, low) or not fact_add_fits(entry.hi, high): continue
        out.push((l, FactBound(entry.lo + low, entry.hi + high)))
    out
fact_carried_assigns = (n: int) -> int[]:
    if let known = fact_carried_cache.get(n): return known
    out: int[]
    work = [int(nodes[n].b)]
    loop work.len() > 0:
        e = work.pop()
        if e == 0: continue
        k = nodes[e].kind
        if k == .assign:
            a = int(nodes[e].a)
            # (declared before the loop, so not in its body; the loop's own
            # element and hidden position are not carried)
            l = int(nodes[a].sym)
            if nodes[a].kind == .ident and nodes[a].aux == i32(int(SK.local)) and l != int(nodes[n].sym) and l != int(nodes[n].c) and (fact_scalar(int(locals[l].type)) and is_int(int(locals[l].type)) or is_nd(fact_type(int(locals[l].type)))) and locals[l].pos < nodes[n].pos: out.push(e)
        mask = isolation_children(k)
        if mask < 0: continue
        if mask & 1 != 0: work.push(int(nodes[e].a))
        if mask & 2 != 0: work.push(int(nodes[e].b))
        if mask & 4 != 0: work.push(int(nodes[e].c))
        if mask & 16 != 0:
            loop i in [0..nkids(e)): work.push(kid(e, i))
    fact_carried_cache[n] = out
    out
# A carried local a loop's havoc leaves without a useful bound: a mathematical
# int (unbounded), or a fixed-width signed one where the function has exact
# results to decide (its domain's far endpoint). O(1).
fact_carried_type = (t0: int, f: int) -> bool:
    t = fact_type(t0)
    # (an N-D array a counted loop replaces, `m = m * p`: its shape settles as a while loop's does)
    t == T_MATH_INT or is_nd(t) or exact_demands.has(f) and fact_scalar(t) and is_int(t) and types[t].sign
# Whether a range or array loop needs its header iterated: an active carried
# assignment that no counted sum already bounds.
fact_iterates = (n: int, sums: (int, FactBound)[]) -> bool:
    if not fact_slice.carried: return false
    loop e in fact_carried_assigns(n):
        if fact_slice_flags(e) & (FACT_MEMBER | FACT_ACTIVE) == FACT_MEMBER: continue
        l = int(nodes[int(nodes[e].a)].sym)
        if not fact_carried_type(int(locals[l].type), fact_owner): continue
        counted = false
        loop sum in sums:
            if sum.0 == l: counted = true
        if not counted: return true
    false
# Each counted sum bounds every head of its loop: intersect it.
fact_counted_bounds = (s: mut FactState, sums: (int, FactBound)[]):
    loop sum in sums:
        i = fact_binding(s, PlaceIdentity(.local, int(locals[sum.0].owner), sum.0))
        if i < 0: continue
        b = fact_bound(s, s.bindings[i].value)
        b.lo = max(b.lo, sum.1.lo); b.hi = min(b.hi, sum.1.hi)
        fact_set_bound(s, s.bindings[i].value, b)
# One speculative body state of a range (range) or array (base) loop.
fact_iteration_body = (n: int, header: FactState, range: bool, base: int, lo: int, hi: int, pushes: (int, int)[]) -> FactState:
    body = if range: fact_range_body(n, header, lo, hi) else: header
    fact_growing_lengths(body, pushes)
    if not range:
        fact_loop_index(n, base, body)
        fact_loop_elements(n, base, body)
    body
# A range or array loop's header from entry by fact_while's iteration: at most
# four widening rounds, then one narrowing round. Narrowing is sound because
# the settled header holds at every head, so entry joined with the backedge
# from it does too. Counted sums bound every head. Demanded by fact_iterates;
# unsettled or exhausted, the caller havocs instead. O(rounds x body), within
# the nest's shared speculation budget.
fact_iterate = (n: int, s: mut FactState, range: bool, base: int, lo: int, hi: int, pushes: (int, int)[], sums: (int, FactBound)[]) -> bool:
    if fact_loop_exhausted or not fact_iterates(n, sums): return false
    # (a summary run that skips the body has no backedge to iterate)
    if fact_summary_owner != 0 and not fact_may_return(int(nodes[n].b)): return false
    outer = fact_speculating
    entry = s
    header = s
    settled = false
    edges = FactLoop()
    fact_speculating += 1
    loop iteration in [0..4):
        if fact_loop_exhausted: break
        body = fact_iteration_body(n, header, range, base, lo, hi, pushes)
        edges = fact_loop_body(n, body)
        next = fact_loop_header(entry, edges.back, header, n, true)
        fact_counted_bounds(next, sums)
        settled = fact_loop_stable(header, next)
        header = next
        if settled: break
    if settled and not fact_loop_exhausted:
        header = fact_loop_header(entry, edges.back, header, n, false)
        fact_counted_bounds(header, sums)
    fact_speculating = outer
    if not settled or fact_loop_exhausted: return false
    # A place the loop's syntactic changes leave alone keeps its entry value
    # at every head, even where the body's transfer forgets it (an unsafe
    # write): both are sound, so their meet is. O(body + bindings).
    havoc = entry
    fact_changes(n, havoc, n)
    loop binding in entry.bindings:
        i = fact_binding(havoc, binding.place)
        if i < 0 or havoc.bindings[i].value != binding.value: continue
        h = fact_binding(header, binding.place)
        if h < 0 or header.bindings[h].value != binding.value: fact_bind(header, binding.place, binding.value)
    s = header

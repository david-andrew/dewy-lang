use 'spirv.jo'
use 'spirv_stmts.dewy'
use 'spirv_emit.dewy'
use 'checker_state.dewy'
use 'checker_tokens.dewy'
use 'util.jo'
use 'diagnostic_exit.dewy'
use 'lex.jo'
use 'ast.jo'
use 'types.jo'
use 'check.jo'
use 'checks_assign_hooks.dewy'
use 'expr.jo'
use 'checks_thin_expr.dewy'
use 'glsl.jo'
use 'glsl_ops.dewy'
use 'type_ops.dewy'

sv_err = (pos: int, msg: str): fatal(pos, "in shader code: {msg}")
sv_pick = (c: bool, a: int, b: int) -> int:
    if c: return a
    b
# ---------------- instructions ----------------
sv_ins = (o: mut int[], op: int, args: int[]):
    o.push(((args.len() + 1) << 16) | op)
    loop a in args: o.push(a)
sv_new = () -> int:
    sv_bound += 1
    sv_bound
sv_deco = (id: int, d: int, extra: int[]):
    a: int[] = [id, d]
    loop x in extra: a.push(x)
    sv_ins(sv_dec, 71, a)
sv_mdeco = (st: int, member: int, d: int, extra: int[]):
    a: int[] = [st, member, d]
    loop x in extra: a.push(x)
    sv_ins(sv_dec, 72, a)
# an instruction in the function being translated (in a new, unreachable block after a branch)
sv_code = (op: int, args: int[]):
    if sv_dead: sv_begin(sv_new())
    sv_ins(sv_body, op, args)
sv_begin = (label: int):
    sv_ins(sv_body, 248, [label])
    sv_label = label
    sv_dead = false
sv_cond_branch = (c: int, a: int, b: int):
    sv_code(250, [c, a, b])
    sv_dead = true
sv_void = () -> int: sv_type_key("void", 19, [])
sv_bool = () -> int: sv_type_key("bool", 20, [])
sv_f32 = () -> int: sv_type_key("f32", 22, [32])
sv_i32 = () -> int: sv_type_key("i32", 21, [32, 1])
sv_u32 = () -> int: sv_type_key("u32", 21, [32, 0])
sv_vecf = (n: int) -> int: sv_type_key("v{n}", 23, [sv_f32(), n])
sv_veci = (n: int) -> int: sv_type_key("iv{n}", 23, [sv_i32(), n])
sv_vecb = (n: int) -> int: sv_type_key("bv{n}", 23, [sv_bool(), n])
sv_mat4 = () -> int: sv_type_key("m4", 24, [sv_vecf(4), 4])
sv_ptr = (sc: int, t: int) -> int: sv_type_key("p{sc},{t}", 32, [sc, t])
sv_ci = (v: int) -> int: sv_const(sv_i32(), v & 0xFFFFFFFF)
sv_cu = (v: int) -> int: sv_const(sv_u32(), v & 0xFFFFFFFF)
# a variable of the current function (declared at the start of its first block)
sv_var = (ty: int) -> int:
    id = sv_new()
    sv_ins(sv_vars, 59, [sv_ptr(SC_FUNCTION, ty), id, SC_FUNCTION])
    id
sv_load = (ty: int, p: int) -> int: sv_val(61, ty, [p])
sv_store = (p: int, v: int): sv_code(62, [p, v])
sv_pc_types = () -> int[]:
    r = sv_rawptr()
    [r, r, r, sv_i32(), sv_i32(), sv_f32(), sv_i32()]
sv_pc_get = (i: int) -> int:
    ty = sv_pc_types()[i]
    p = sv_val(65, sv_ptr(SC_PUSH, ty), [sv_pc_var(), sv_ci(i)])
    sv_load(ty, p)
sv_builtin_var = (ty: int, sc: int, builtin: int) -> int:
    v = sv_global(sv_ptr(sc, ty), sc)
    sv_deco(v, 11, [builtin])
    v
sv_vertex_id = () -> int:
    if sv_vid == 0: sv_vid = sv_builtin_var(sv_i32(), SC_INPUT, 42)
    sv_load(sv_i32(), sv_vid)
sv_instance_id = () -> int:
    if sv_iid == 0: sv_iid = sv_builtin_var(sv_i32(), SC_INPUT, 43)
    sv_load(sv_i32(), sv_iid)
sv_image_type = () -> int: sv_type_key("img2d", 25, [sv_f32(), 1, 0, 0, 0, 1, 0])
sv_sampled_type = () -> int: sv_type_key("simg2d", 27, [sv_image_type()])
# ---------------- statements ----------------
sv_stmts = (b: int):
    loop i in [0..nkids(b)): sv_stmt(kid(b, i))
# ---------------- expressions ----------------
sv_is_floaty = (t0: int) -> bool:
    t = sl_type(t0)
    types[t].kind == .float_ or (types[t].kind == .vec and not types[t].sign)
sv_is_vector = (t0: int) -> bool:
    t = sl_type(t0)
    types[t].kind == .vec and t != T_MAT4
sv_ncomp = (t0: int) -> int:
    t = sl_type(t0)
    if types[t].kind == .vec: return int(types[t].bits)
    1
# a scalar as a vector of type t (all components equal)
sv_splat = (t: int, v: int, pos: int) -> int:
    parts: int[]
    loop i in [0..sv_ncomp(t)): parts.push(v)
    sv_val(80, sv_type(t, pos), parts)
# integers are 32 bits in shaders; an unsigned one (u8 u16 u32 u64) is held in the same bits
sv_unsigned = (t0: int) -> bool:
    t = sl_type(t0)
    types[t].kind == .int_ and not types[t].sign
# ---------------- GPU buffers (lib/game/gpubuffer.jo) ----------------
# A GpuBuffer here is (its address, its length): struct { uvec2, i32 }. Reads past either end read
# the nearest element; writes (and atomics) past them do nothing. Only compute programs write.
sv_uv2 = () -> int: sv_type_key("uv2", 23, [sv_u32(), 2])
sv_gbuf_type = () -> int: sv_type_key("gbuf", 30, [sv_uv2(), sv_i32()])
sv_gbuf_ptr = (b: int) -> int: sv_val(124, sv_rawptr_w(), [sv_val(81, sv_uv2(), [b, 0])])
sv_gbuf_len = (b: int) -> int: sv_val(81, sv_i32(), [b, 1])
# e is a call of the library's operation `name` on a GpuBuffer (its first argument)
sv_is_gbuf_op = (e: int, name: str) -> bool:
    if nodes[e].kind != .call or nodes[e].aux != 0 or nkids(e) == 0: return false
    decl = int(fns[int(nodes[e].sym)].decl)
    decl != 0 and modules[int(nodes[decl].mod)].is_prelude and name_of(int(nodes[decl].name)) == name and is_gpu_buffer(ntype(kid(e, 0)))
sv_store_word = (base: int, c: int, d: int, w: int): sv_code(62, [sv_word_ptr(base, c, d), w, 2, 4])
# ---------------- subgroups ----------------
sv_cap = (c: int):
    if sv_cache.get("cap{c}") != none: return
    sv_cache["cap{c}"] = 1
    sv_ins(sv_caps, 17, [c])
sv_is_int_leaf = (t0: int) -> bool:
    t = sl_type(t0)
    if types[t].kind == .fixed: return sv_is_int_leaf(int(types[t].elem))
    types[t].kind == .int_ or (types[t].kind == .vec and types[t].sign) or (types[t].kind == .struct_ and is_lib_texture(int(types[t].st)))
# a buffer address from two words (low, high) of the parameters
sv_addr_at = (params: int, word: int, ptrty: int) -> int:
    v = sv_val(80, sv_type_key("uv2", 23, [sv_u32(), 2]), [sv_word(params, word * 4, 0), sv_word(params, word * 4 + 4, 0)])
    sv_val(124, ptrty, [v])

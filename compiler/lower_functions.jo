begin_fn = (name: str, idx: int):
    ir_begin(name, idx)
    exact_lower_active = exact_nodes.len() > 0
    eg_active = false
    lower_length_guards = []
    parallel_scalars.clear()
    parallel_owned.clear()
    stack_closure_fn = -1
    stack_closure_params.clear()
    math_word_regs.clear()
    math_static_regs.clear()
    math_static_widths.clear()
    math_word_limits.clear()
    math_word_updates.clear()
    math_writes_ready = false
    math_has_mutable = false
    math_writes.clear()
    math_decl_depth.clear()
    math_loop_sites.clear()
    math_write_loop.clear()
    math_loop_parent.clear()
    ctl = 0
    cond_depth = 0
    scope_locals = []
    scope_defers = []
    loops = []
    tl_items.clear()
    tl_values.clear()
    tl_nop.clear()
    lower_zeros.clear()
    lower_mark_serial = 0
    lower_has_nops = ownership_decls.len() != 0
    tl_cond.clear()
    building = []
    sret_v = -1
    env_v = -1


find_bytes_set = (name: int) -> int:
    if find_ids.len() == 0:
        loop nm in ["__find_delim", "__find_newline", "__find_line_delim", "__find_line_delim4", "__find_line_delim8", "__memchr"]: find_ids.push(intern(nm))
    if name == find_ids[5]: return -2
    delims = 0x0A | (0x22 << 8) | (0x23 << 16) | (0x27 << 24)
    if name == find_ids[0]: return delims
    if name == find_ids[1]: return 0x0A0A0A0A
    if name == find_ids[2]: return delims | (1 << 32)
    if name == find_ids[3]: return delims | (1 << 32) | (4 << 33)
    if name == find_ids[4]: return delims | (1 << 32) | (8 << 33)
    -1


lower_inst = (lf: int, f: int):
    positive_epoch += 1
    begin_fn(lfuncs[lf].name, lf)
    owner_begin()
    if fns[f].decl != 0:
        ir_set_pos(nodes[int(fns[f].decl)].pos)
        ir.decl_pos = ir_pos
    cur_fn = f
    exact_lower_active = exact_owners.has(f)
    eg_active = f < eg_demanded.len() and eg_demanded[f]
    cur_ret = int(fns[f].ret)
    ir.cabi = fns[f].cabi
    ir.noinline = fns[f].noinline
    ir.export_name = if parallel_serial: "" else: fns[f].export_name
    if vc(cur_ret) == VC_AGG: sret_v = vreg(VI)
    if fns[f].has_env: env_v = vreg(VI)
    if fns[f].kind == FK_LAMBDA: env_layout(f)
    # parameters
    loop i in 0.. and l in fns[f].params:
        t = int(locals[l].type)
        pv = 0
        if int(locals[l].flags) & LF_MUTPARAM != 0 or vc(t) == VC_AGG: pv = vreg(VI)
        else: pv = vreg(vt_of(t))
        locals[l].vreg = i32(pv)
        locals[l].offset = -1
    ir.nparams = ir.vtypes.len()
    partition_begin(f)
    if refine_active: refine_gen_entry(f)
    ir.ret = ret_vt(cur_ret)
    if fns[f].decl != 0 and not target_arm64 and not target_wasm and not dbg_on and modules[int(fns[f].mod)].is_prelude:
        # Private bounded byte searches from lib/core/str.jo.
        set = find_bytes_set(int(nodes[int(fns[f].decl)].name))
        if set == -2:
            # __memchr(p, from, n, byte): guard the span before subtracting or
            # forming its address. The intrinsic returns a relative offset.
            ir.raw_mem = true
            e_if(e_bin(.ges, VI, 1, 2))
            e_ret(e_iconst(-1))
            e_end()
            pointer = e_bin(.add, VI, 0, 1)
            length = e_bin(.sub, VI, 2, 1)
            result = vreg(VI)
            if want_cpu_flag:
                e_if(rt_global("__cpu_avx2"))
                emit(.findbyte, VI, result, pointer, length, 3, 2)
                e_else()
                emit(.findbyte, VI, result, pointer, length, 3, 0)
                e_end()
            else: emit(.findbyte, VI, result, pointer, length, 3, 0)
            e_if(e_bin(.ges, VI, result, e_iconst(0)))
            e_ret(e_bin(.add, VI, result, 1))
            e_end()
            e_ret(e_iconst(-1))
            return
        if set >= 0:
            ir.raw_mem = true
            result = vreg(VI)
            emit(.findb, VI, result, 0, 1, 2, set)
            e_ret(result)
            return
    if (f == runtime_memeq or f == runtime_streq) and not target_arm64 and not target_wasm and not dbg_on:
        # Ordinary scalar body remains available to the bootstrap, debugger and
        # other targets. Select only the exact private runtime instances.
        ir.raw_mem = true
        result = vreg(VI)
        operation = Op.memeq
        count = 2
        if f == runtime_streq:
            operation = .streq
            count = 0
        emit(operation, VI, result, 0, 1, count, 0)
        e_ret(result)
        return
    # (called from C, whose callers leave the upper bits of narrow integers undefined: made
    # what Sloppy code expects of them)
    if fns[f].cabi:
        # (C may call it from a thread of its own: the allocator tells threads apart from now on)
        if let ct = prelude.get(intern("__c_threads")):
            if syms[ct].kind == .global: e_store(e_gaddr(global_addr_off(int(syms[ct].ref))), 0, e_iconst(1), 1)
        loop l in fns[f].params:
            t = prune(int(locals[l].type))
            if types[t].kind == .int_ and tsize(t) < 8 and int(locals[l].flags) & LF_MUTPARAM == 0: e_mov(int(locals[l].vreg), norm(int(locals[l].vreg), t))
    # Bind read-only Dewy value parameters before allocating local storage.
    # These declarations form a contiguous synthetic prefix. Rebind on every
    # lowering so watch/repl and debug builds cannot reuse old virtual registers.
    body = int(fns[f].body)
    loop i in [0..nkids(body)):
        s = kid(body, i)
        if nodes[s].kind != .vardecl or nodes[s].aux2 != 1: break
        if nkids(s) > 0 or has_flag(s, NF_GLOBAL): continue
        l = int(nodes[s].sym)
        if l < 0: continue
        locals[l].flags &= i32(~LF_PARAM)
        param_view_decl(s, l)
    find_views(f)
    if copies_on:
        icb = ic_phase(IC_OWNERSHIP)
        copies_prepare(f)
        ic_restore(icb)
    # locals
    loop l in fns[f].locals:
        fl = int(locals[l].flags)
        t = int(locals[l].type)
        if t == T_MATH_INT and fl & LF_ASSIGNED != 0: math_has_mutable = true
        if fl & (LF_CAPTURE | LF_ALIAS) != 0: continue
        if fl & LF_PARAM != 0:
            if copy_inputs.has(l) and (not files[pos_file(nodes[int(fns[f].decl)].pos)].is_dewy or ownership_consumers.len() != 0 and ownership_consumers.has(int(fns[f].decl))):
                s = new_temp(t)
                # (a place parameter's vreg is the caller's address: the value copied from there)
                v = int(locals[l].vreg)
                if fl & LF_MUTPARAM != 0 and vc(t) != VC_AGG: v = load_val(t, v, 0)
                store_val(t, e_slot(s), 0, v)
                locals[l].offset = i32(s)
                # (the body reads and writes the owned copy, which its drop then sees)
                if fl & LF_MUTPARAM != 0 or vc(t) == VC_AGG: e_mov(int(locals[l].vreg), e_slot(s))
                continue
            if fl & LF_ADDR != 0 and fl & LF_MUTPARAM == 0 and vc(t) != VC_AGG:
                # address-taken scalar parameter: move to memory
                s = new_slot(8, 8)
                store_val(t, e_slot(s), 0, int(locals[l].vreg))
                locals[l].offset = i32(s)
            continue
        locals[l].offset = -1
        if fl & LF_BYREF != 0:
            locals[l].vreg = i32(vreg(VI))
            continue
        t = store_type(l)
        if vc(t) == VC_AGG or fl & LF_ADDR != 0 or ownership_type(t):
            s = new_slot(tsize(t), talign(t))
            locals[l].offset = i32(s)
            if is_managed(t): e_zero(e_slot(s), tsize(t))
            continue
        locals[l].vreg = i32(vreg(vt_of(t)))
        if is_managed(t): e_mov(int(locals[l].vreg), e_iconst(0))
    exm_censuses = {}; lower_entry = []
    exm_produced_flags = {}; exm_produced_widths = {}
    exm_start = ir.code.len()
    if exact_loop_plan(f, body):
        guard = exact_loop_guard(body)
        iff(guard)
        exact_loop_fast = true
        lower_inst_body(f, body)
        exact_loop_fast = false
        endc()
    lower_inst_body(f, body)
    if lower_entry.len() > 0:
        loop i in [0..lower_zeros.len()):
            if lower_zeros[i].mark >> 32 >= exm_start: lower_zeros[i].mark += lower_entry.len() << 32
        ir.code = ir.code[..exm_start) + lower_entry + ir.code[exm_start..]
    if vc(cur_ret) == VC_AGG: e_ret(sret_v)
    else if vc(cur_ret) == VC_VOID: e_ret(-1)
    else: e_trap()
    owner_end()
    if dbg_on:
        loop l in fns[f].params: ir.dbg_locals.push(l)
        loop l in fns[f].locals:
            if int(locals[l].flags) & LF_PARAM == 0: ir.dbg_locals.push(l)


lower_inst_body = (f: int, body: int) -> void:
    guarded = lower_length_guards.len()
    scope_push()
    owner_enter_captures(f)
    if ownership_decls.len() != 0 and fns[f].decl != 0 and not files[pos_file(nodes[int(fns[f].decl)].pos)].is_dewy:
        loop p in fns[f].params:
            if copy_inputs.has(p): scope_add_local(p)
    # (a `$__consume__` method owns its receiver, which no binding of Dewy's takes)
    else if ownership_consumers.len() != 0 and fns[f].params.len() > 0 and ownership_consumers.has(int(fns[f].decl)) and copy_inputs.has(fns[f].params[0]): scope_add_local(fns[f].params[0])
    if fns[f].kind == FK_INIT:
        gen_block_stmts(body)
    else:
        n = nkids(body)
        loop i in [0..n):
            cur_block = body
            cur_block_i = i
            s = kid(body, i)
            if i == n - 1 and nodes[body].aux != 0 and vc(cur_ret) != VC_VOID:
                r = mk(.return_, nodes[s].pos)
                nodes[r].a = nodes[s].a
                # (its line, as a statement's: for backtraces and debuggers)
                ir_set_pos(nodes[s].pos)
                gen_return(r)
                continue
            gen_stmt(s)
            lower_length_guard(s)
    lower_length_guards.truncate(guarded)
    scope_pop()


lower_function = (lf: int):
    lower_epoch += 1
    lower_planning = true
    exr_fast = lfuncs[lf].kind == LK_HELPER and lfuncs[lf].hkind == HK.reset_words
    parallel_serial = lfuncs[lf].kind == LK_HELPER and (lfuncs[lf].hkind == HK.parallel_serial or lfuncs[lf].hkind == HK.partition and lfuncs[lf].htype == 1)
    partition_mode = lfuncs[lf].kind == LK_HELPER and lfuncs[lf].hkind == HK.partition
    if lfuncs[lf].kind == LK_INST or parallel_serial or partition_mode or exr_fast: pc_restore(lfuncs[lf].inst)
    exr_locals = if exr_fast: exr_plan(lfuncs[lf].inst) else: []
    fact_storage_cache.clear()
    lpath_ids.clear()
    lpath_parents.truncate(1)
    f = lfuncs[lf]
    lop_watch = false
    if want_loop_watch and f.kind == LK_INST and prelude.get(intern("__loop_budget")) != none:
        fi0 = f.inst
        d0 = int(fns[fi0].decl)
        if d0 != 0: lop_watch = not pos_in_lib(nodes[d0].pos)
        else: lop_watch = fns[fi0].kind == FK_INIT and not modules[int(fns[fi0].mod)].is_prelude
    # (generated helpers have no place in the source)
    ir_pos = 0
    if f.kind == LK_INST:
        fi = f.inst
        if fns[fi].kind == FK_PARTIAL: lower_partial_thunk(lf, fi)
        else: lower_inst(lf, fi)
    else if parallel_serial or partition_mode or exr_fast: lower_inst(lf, f.inst)
    else: lower_helper(lf)
    parallel_serial = false
    partition_mode = false
    lower_finish()
    lower_planning = false
    exr_fast = false


lower_finish = ():
    if lower_zeros.len() == 0:
        if not lower_has_nops: return
        k = 0
        loop ins in ir.code:
            if ins.op != .nop:
                ir.code[k] = ins
                k += 1
        ir.code.truncate(k)
        return
    lower_zeros.sort_by((z: LowerZero) -> int: z.mark)
    out: Ins[]
    out.reserve(ir.code.len() + lower_zeros.len())
    next = 0
    loop i in [0..ir.code.len() + 1):
        loop next < lower_zeros.len() and lower_zeros[next].mark >> 32 == i:
            z = lower_zeros[next]
            out.push(Ins(.zeroslots, 0, 0, i32(z.start), i32(z.count), 0, 0))
            next += 1
        if i < ir.code.len() and ir.code[i].op != .nop: out.push(ir.code[i])
    ir.code = out


lower_partial_thunk = (lf: int, th: int):
    pass


each_field = (t0: int, addr: int, f: (int, int) -> void):
    pass

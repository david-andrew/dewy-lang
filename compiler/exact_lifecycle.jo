use 'exact.jo'
use 'exact_guards.jo'
use 'exact_loop.jo'
use 'exact_reset_loop.jo'
use 'facts.jo'
use 'fixed_index.dewy'
use 'format_word_observations.dewy'
use 'math_lower.jo'

exact_reset = ():
    exr_plans.clear()
    exr_call_target = 0
    exr_fast = false
    exr_locals = []
    format_word_reset()
    fi_reset()
    exact_rep_demands = []
    exact_rep_owners = []
    exact_effect_owners = []
    exact_local_widths = []
    exact_raw_values = []
    math_word_captures = {}
    eg_lo = []; eg_hi = []; eg_owner = []; eg_version = []; eg_stack = []; eg_demanded = []
    exact_map_functions = []
    exact_progress_assignments = []; exact_write_heads = []; exact_write_values = []; exact_write_next = []; exact_write_targets = []; exact_write_seen = []; exact_progress_opaque = []
    exact_dependency_seen = []; exact_dependency_epoch = 0
    positive_collecting_writes = false
    positive_cache = []; positive_stamp = []; positive_epoch += 1
    exact_measure_on = env("DEWY_NOWRAP_MEASURE") != none
    exact_measure_sites = {}
    exact_owners = {}
    exact_full_owners = {}
    exact_candidate_heads = []; exact_candidate_nodes = []; exact_candidate_next = []
    exact_float_purity = []
    exact_lower_sites = []; exact_collect_writes = false
    exact_demands = {}
    exact_proof_demands = {}
    exact_shader_roots = []
    exact_shader_owners = {}
    exact_progress_math = {}
    exact_word_reads = {}
    exact_initializers = []
    exact_iteration_sources = []
    exact_nodes = []
    exact_stores = {}
    exact_widths = []
    exact_type_widths = []
    exact_type_values = []
    exact_shifts = {}
    exact_count_nodes = []
    exact_count_index = []
    exact_count_bounds = []
    exact_marks = []
    exact_ranges = []
    exact_range_meta = []
    exact_join_blocks = {}

use 'checker_module_lookup.dewy'
use 'checker_startup.dewy'
use 'checks_thin.dewy'
use 'prelude_ops.dewy'
use 'prelude.jo'
use 'types.jo'
use 'util.jo'
use 'check.jo'

universe_syms: int[]
universe_syms_len = 0
universe_sym_lookup = (name: int) -> int:
    if universe.len() != universe_syms_len:
        universe_syms_len = universe.len()
        loop k, v in universe:
            if universe_syms.len() <= k: universe_syms.resize(k * 2 + 64)
            universe_syms[k] = v
    if name < universe_syms.len(): data(universe_syms)[name] else: 0

mod_name_sym = (m: int, name: int) -> int:
    if name >= name_first.len(): return 0
    e = data(name_first)[name]
    nm = data(name_mod)
    ns = data(name_sym)
    nx = data(name_next)
    loop e != 0:
        if nm[e - 1] == m: return ns[e - 1]
        e = nx[e - 1]
    0

home_add = (m: int, name: int):
    if home_first.len() <= name: home_first.resize(name * 2 + 64)
    h = home_first[name]
    if h != 0 and home_mod[h - 1] == m: return
    home_mod.push(m)
    home_next.push(h)
    home_first[name] = home_mod.len()
homes_build = ():
    homes_built = true
    loop m in [0..modules.len()):
        if modules[m].is_prelude: continue
        loop k, v in modules[m].names: home_add(m, k)

bound_in = (m: int, name: int) -> bool:
    if name >= home_first.len(): return false
    h = home_first[name]
    loop h != 0:
        if home_mod[h - 1] == m: return true
        h = home_next[h - 1]
    false

# The one use of module m whose table can bind name, -1 for none; -2 when its uses must each be
# asked in order (a prelude among them, or more than one module binding the name; bound_in
# tells which may). O(uses).
use_home = (m: int, name: int) -> int:
    if modules[m].uses.len() == 0: return -1
    if not homes_built: homes_build()
    if m < prelude_used.len() and prelude_used[m]: return -2
    if name >= home_first.len() or home_first[name] == 0: return -1
    h = home_first[name] - 1
    if home_next[h] != 0: return -2
    if modules[m].uses.contains(home_mod[h]): home_mod[h] else: -1

module_lookup_now = (m: int, name: int) -> int:
    demand_name(name)
    user = m >= 0 and not modules[m].is_prelude
    if m >= 0:
        if modules[m].is_prelude:
            if name < prelude_syms.len():
                s = data(prelude_syms)[name]
                if s != 0: return s
        else:
            s0 = mod_name_sym(m, name)
            if s0 != 0: return s0
            h = use_home(m, name)
            if h >= 0 and not is_private(name):
                sh = mod_name_sym(h, name)
                if sh != 0: return sh
            if h == -2:
                loop u in modules[m].uses:
                    if modules[u].is_prelude:
                        if name < prelude_syms.len():
                            s = data(prelude_syms)[name]
                            if s != 0 and not lib_private(name): return s
                    else if bound_in(u, name):
                        su = mod_name_sym(u, name)
                        if su != 0 and not is_private(name): return su
            if files[int(modules[m].file)].is_dewy and not is_private(name):
                s = dewy_prelude_lookup(name)
                if s != 0: return s
    if name < prelude_syms.len():
        s = data(prelude_syms)[name]
        if s != 0 and (not user or not lib_private(name)): return s
    us = universe_sym_lookup(name)
    if us != 0:
        if prelude_game_pending and game_lookup_ok and (m < 0 or not modules[m].is_prelude) and syms[us].kind == .type_:
            tr = int(syms[us].ref)
            if types[tr].kind == .vec or tr == T_MAT4: load_game_file("vmath.jo")
        return us
    if prelude_std_pending or prelude_game_pending:
        dunder = false
        if not game_lookup_ok:
            sp = (data(names) as **u8)[name]
            if sp == null or (sp as *int)[1] < 2 or (sp + 24)[0] != 95 or (sp + 24)[1] != 95: return 0
            dunder = true
        if not game_lookup_skip(name):
            nm_s = data(names)[name]
            if prelude_std_pending:
                sf = std_file_for(nm_s)
                if len(sf) > 0 and load_std_file(sf):
                    return module_lookup_now(m, name)
                if game_lookup_ok and (m < 0 or not modules[m].is_prelude):
                    load_std_prelude()
                    return module_lookup_now(m, name)
            if prelude_game_pending:
                if (m < 0 or not modules[m].is_prelude) or dunder or (len(nm_s) >= 2 and nm_s[0] == '_' and nm_s[1] == '_'):
                    gf = game_file_for(nm_s)
                    if len(gf) > 0 and load_game_file(gf):
                        return module_lookup_now(m, name)
                    if game_lookup_ok and (m < 0 or not modules[m].is_prelude):
                        load_game_prelude()
                        return module_lookup_now(m, name)
    0

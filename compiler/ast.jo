# Abstract syntax tree. Nodes live in one global array and refer to each other by index.
# Node 0 is the "no node" sentinel. The node record, the kinds and the store's builders are
# node_store.dewy's; the arrays are here, passed to it by place.

use 'util.jo'
use 'node_store.dewy'

# Generic lambdas retain type parameters in kids2, as module functions do.
# Their explicit captures use a child block so cloning preserves both lists.
lambda_captures = (n: int) -> int[]:
    if has_flag(n, NF_GENERIC): return kids(int(nodes[n].d))
    kids2(n)

# node flags
const NF_MUT = 1
const NF_INCLUSIVE = 2
const NF_EXTERN = 4
const NF_STMT = 16
const NF_TERMINATED = 32
const NF_GENERIC = 64
const NF_CHECKED = 128
const NF_LITERAL = 256
const NF_GLOBAL = 2048
const NF_FNREF_ARG = 4096
const NF_CABI = 8192
const NF_SQUOTE = 8          # a one-character literal in single quotes ('a': a character more than text)
const NF_CHARLIKE = 512       # a one-character string literal (an integer where one is expected)
const NF_SPREAD = 1024        # collection literal spread `value...`
const NF_BROADCAST = 16384    # f.(x): applied elementwise
const NF_STEP = 32768         # range `a,b..c`: c holds the second value
const NF_BARE = 65536         # a range written without brackets (while parsing)
const NF_SOA = 131072         # array type `soa T[]`: stored as one array per field of T
                              # (on a vardecl: the element alias of a loop over a soa array)
const NF_RDONLY = 262144      # an element of a soa array reached through a read-only loop variable
const NF_INBOUNDS = 524288    # an index the compiler generated knowing it is in bounds
const NF_TYPE_EXPR = 1048576  # `T[]` written where an expression goes: a type (a type argument)
const NF_DISCARD = NF_SQUOTE  # (Dewy) block: an attached `;` discards what its one statement expresses
const NF_U64 = 2097152        # an integer literal above the i64 range (written so, or computed from one)
const NF_VOID = 4194304       # a function written `-> void` (it returns nothing, whatever its body says)
const NF_ALIASDECL = 8388608  # a vardecl whose name stands for the place b (`mut x in xs` in a combined loop)
const NF_LAZY = 16777216      # a library function's body not parsed yet: tokens from ival in lazy_toks[aux] (parse.jo)
const NF_LOOPCOUNT = 33554432 # a vardecl a combined loop is rewritten with (`i in 0..`): never warned as unused;
                              # a field: a library member a loop's lowering reads (a map's keys), never warned as the library's own
const NF_LANG_BODY = NF_LOOPCOUNT # lambda: a parallel or spawn body, whose writes their own checks govern
const NF_MAP_PAIR = NF_LOOPCOUNT  # tuple: a dictionary comprehension's (key, value)
const NF_LIB_INDEX = NF_LOOPCOUNT # index: a library helper's checked position (a pool's direct update): its bounds are the library's obligation
const NF_COMPREHENSION = 67108864 # block: first declaration is the collection accumulator
const NF_RECORD = 134217728 # anonymous structural record declaration
const NF_INDEX_CAPTURED = 268435456 # compound custom-index update already captured its indices
const NF_WRITTEN_VOID = NF_INDEX_CAPTURED # fn_/lambda: a result written `:>void`, so its body may express no value
const NF_EXCL_FIRST = 536870912 # Dewy range excludes its first specified value
# (Dewy, docs/design/juxtaposition.md) call: `head(...)` with a name, field route or
# parenthesized group head, which may be a coefficient; `^` (its __dewy_power call), field or
# index: written right after a call's parentheses; binary: a product written by juxtaposition
const NF_JUXT = NF_EXCL_FIRST
const NF_FLOW_RETURNS = 1073741824 # lowered loop/else block: every source path returns
const NF_EXPLICIT_INTEGER = NF_RECORD # conv: a written fixed-width conversion narrows immediately
const NF_AT = 2147483648        # (Dewy) a place written with a leading `@`: `@x`, `@r.a`, `@xs[i]`

# (Dewy) a `.tuple` node with this aux is a group of several values, `(a b)`: not a
# container (docs/design/multi_expressions.md)
const TUPLE_VALUES = 7
# (an `$assert` intrinsic with this aux2: an obligation the compiler made, an unpacking's or a
# spread's length, which becomes a runtime check where the scope allows one)
const UNPACK_OBLIGATION = 31
const RANGE_EXHAUSTION = 32

nodes: Node[] = [Node()]
lists: i32[]

# (the one-line field reads and flag tests stay here, where they inline into their callers)
mk = (kind: NK, pos: int) -> int: node_mk(nodes, kind, pos)
mklist = (xs: int[]) -> int: node_run(lists, xs)
set_list = (n: int, xs: int[]): node_set_list(nodes, lists, n, xs)
set_list2 = (n: int, xs: int[]): node_set_list2(nodes, lists, n, xs)
kid = (n: int, i: int) -> int: int(lists[int(nodes[n].list) + i])
kid2 = (n: int, i: int) -> int: int(lists[int(nodes[n].list2) + i])
nkids = (n: int) -> int: int(nodes[n].nlist)
nkids2 = (n: int) -> int: int(nodes[n].nlist2)
set_kid = (n: int, i: int, v: int): lists[int(nodes[n].list) + i] = i32(v)
set_kid2 = (n: int, i: int, v: int): lists[int(nodes[n].list2) + i] = i32(v)
kids = (n: int) -> int[]: node_kids(nodes, lists, n)
kids2 = (n: int) -> int[]: node_kids2(nodes, lists, n)
has_flag = (n: int, f: int) -> bool: int(nodes[n].flags) & f != 0
add_flag = (n: int, f: int): nodes[n].flags = i32(int(nodes[n].flags) | f)
clear_flag = (n: int, f: int): nodes[n].flags = i32(int(nodes[n].flags) & ~f)
# (a deep copy of a subtree: generic functions are instantiated so)
clone = (n: int) -> int: node_clone(nodes, lists, n)

# Declarations marked `$shadowable const`: an inner scope or an importing module
# may bind the name anew (a plain `name = ...` there declares): decl_shadowable
shadowable_decls: {int: bool}

# `loop item in @place`: the place's node, iterated live (check_live_loop)
dewy_live_sources: {int: bool}

# Members `x.len` a Dewy program wrote, as the frontends made them (not the checker's own
# `.len()`, for `.length`): node -> its position, in case the node is made again
dewy_len_members: {int: int}
id_dewy_len = intern("len")
# (Dewy's `xs.ptr`: an array's raw pointer, for C)
id_dewy_ptr = intern("ptr")
# (Dewy calls of the library's searches and chars: Dewy's versions)
id_find = intern("find")
id_rfind = intern("rfind")
id_index_of = intern("index_of")
id_chars = intern("chars")
dewy_note_member = (n: int):
    if int(nodes[n].name) == id_dewy_len: dewy_len_members[n] = nodes[n].pos

# per Dewy function node: its parameters' kinds, 1 keyword-only (after `...`),
# 2 position-only (`<v:T>`), for map_args
dewy_param_kinds: {int: int[]} = {}

use 'checker_expr.dewy'
use 'checker_state.dewy'
use 'quantity_algebra.dewy'
use 'type_properties.dewy'
use 'checker_tokens.dewy'
use 'checker_types.dewy'
use 'refine.jo'
use 'temperature_kinds.jo'
use 'check.jo'
use 'ast.jo'
use 'lex.jo'
use 'util.jo'
# Physical dimensions are canonical semantic qualifiers. Numeric operations and
# storage use their underlying representation; specialization keeps the qualifier.
use 'types.jo'
use 'type_ops.dewy'
use 'expr.jo'
use 'checks_builders.dewy'
use 'node_store.dewy'
use 'unit_ops.dewy'
use 'unit_rare.dewy'

quantity_dimensions: int[][] = [[0, 0, 0, 0, 0, 0, 0, 0]]
quantity_dimension_names: str[] = ["Time", "Length", "Mass", "Current", "Temperature", "Amount", "Luminosity", "Angle"]
# Dimension powers are rational (V/sqrt(Hz) has Time^(1/2)): each is stored times this
# denominator, so roots down to a 16th (and thirds, fifths, sevenths...) stay exact.
const QUANTITY_POWER_DEN = 720720
const QUANTITY_POWER_MAX = 32767 * 720720

quantity_scales: QuantityScale[]

is_quantity = (t: int) -> bool: types[prune(t)].kind == .quantity
quantity_base = (t0: int) -> int: tp_base(t0)

bundled_word_rational_type = (t0: int) -> bool:
    t = prune(t0)
    if types[t].kind != .struct_: return false
    si = int(types[t].st)
    d = int(structs[si].decl)
    d != 0 and structs[si].name == "RationalWord" and files[pos_file(nodes[d].pos)].path == lib_dir + "/rational.dewy"

bundled_rational_type = (t0: int) -> bool:
    t = prune(t0)
    if types[t].kind != .struct_: return false
    si = int(types[t].st)
    d = int(structs[si].decl)
    d != 0 and structs[si].name == "Rational" and files[pos_file(nodes[d].pos)].path == lib_dir + "/rational.dewy"

# ---------------- display units, offset scales and differences ----------------
# A quantity type may carry a tag (in TypeInfo.bits) saying which unit it shows in and,
# for an offset scale such as Celsius, which unit's zero it was measured from. Tags never
# change the runtime number, which stays canonical (kelvins for a temperature point or
# difference); they decide how a value prints and how offset values combine.
quantity_units: QuantityUnit[] = [QuantityUnit("", 1, 1, 0, 1)]

quantity_tags: QuantityTag[] = [QuantityTag(0, 0, false)]

quantity_update_right = 0      # the right side of a compound update being checked
quantity_left_literal = false
quantity_right_literal = false

quantity_internal = 0

quantity_unary_literal = false  # the operand of the unary being checked is written as a literal

# ---------------- display ----------------
# A quantity prints in a unit chosen for its kind: each base dimension and each named
# derived unit (N, J, W, ...) has a list of candidate units, and the value's magnitude picks
# one at runtime (1500.0 m prints as 1.5 km, 3/10 s as 300 ms). Other dimensions print in
# canonical units composed from a named unit and base units (m/s, N*s, V*s^(1/2)).
# `x as unit` and offset scales print in their own unit.

quantity_si_prefixes: str[] = ["n", "µ", "m", "", "k", "M", "G"]

# base symbols, in the order composite units are written (kg*m^2/s^2)
quantity_base_order: int[] = [2, 1, 0, 3, 4, 5, 6, 7]
quantity_base_symbols: str[] = ["s", "m", "kg", "A", "K", "mol", "cd", "turn"]
quantity_named_symbols: str[] = ["Hz", "N", "Pa", "J", "W", "C", "V", "Ω"]
# powers of Time, Length, Mass, Current for each named unit
quantity_named_powers: int[][] = [[-1, 0, 0, 0], [-2, 1, 1, 0], [-2, -1, 1, 0], [-2, 2, 1, 0], [-3, 2, 1, 0], [1, 0, 0, 1], [-3, 2, 1, -1], [-3, 2, 1, -2]]
quantity_algebra_input = QuantityAlgebraInput(&quantity_dimensions, &quantity_dimension_names, &quantity_scales, &quantity_units, &quantity_tags, &quantity_si_prefixes, &quantity_base_order, &quantity_base_symbols, &quantity_named_symbols, &quantity_named_powers, fatal)
quantity_algebra_binding = quantity_algebra_bind(&quantity_algebra_input)

register_quantity_names = ():
    loop i in [0..8):
        dim = base_dimension(i)
        nm = intern(quantity_dimension_names[i])
        universe[nm] = new_sym(nm, .type_, mk_dimension(dim), 0)
    # Time is prelude surface. Other unit values live in units.dewy.
    loop item in [("s", 1, 1), ("second", 1, 1), ("seconds", 1, 1),
        ("ms", 1, 1000), ("millisecond", 1, 1000), ("milliseconds", 1, 1000),
        ("us", 1, 1000000), ("microsecond", 1, 1000000), ("microseconds", 1, 1000000),
        ("ns", 1, 1000000000), ("nanosecond", 1, 1000000000), ("nanoseconds", 1, 1000000000),
        ("minute", 60, 1), ("hour", 3600, 1)]:
        nm = intern(item.0)
        n = mk(.unit_lit, 0)
        nodes[n].ival = item.1
        nodes[n].aux = i32(item.2)
        nodes[n].aux2 = 1
        globals.push(Global(name = i32(nm), is_const = true, init = i32(n), state = 2))
        universe[nm] = new_sym(nm, .const_, globals.len() - 1, 0)

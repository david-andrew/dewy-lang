use 'refine.jo'
use 'check.jo'
use 'ast.jo'
use 'lex.jo'
use 'util.jo'
# Physical dimensions are canonical semantic qualifiers. Numeric operations and
# storage use their underlying representation; specialization keeps the qualifier.
use 'types.jo'
use 'expr.jo'

quantity_dimensions: int[][] = [[0, 0, 0, 0, 0, 0, 0, 0]]
quantity_dimension_names: str[] = ["Time", "Length", "Mass", "Current", "Temperature", "Amount", "Luminosity", "Angle"]
# Dimension powers are rational (V/sqrt(Hz) has Time^(1/2)): each is stored times this
# denominator, so roots down to a 16th (and thirds, fifths, sevenths...) stay exact.
const QUANTITY_POWER_DEN = 720720
const QUANTITY_POWER_MAX = 32767 * 720720

struct QuantityScale:
    numerator: int
    denominator: int
quantity_scales: QuantityScale[]

is_quantity = (t: int) -> bool: types[prune(t)].kind == .quantity
quantity_base = (t0: int) -> int:
    t = prune(t0)
    if types[t].kind == .callable: t = prune(int(types[t].elem))
    if refine_active and types[t].kind == .refined: t = prune(int(types[t].elem))
    if types[t].kind == .quantity: return prune(int(types[t].elem))
    t
quantity_dimension = (t0: int) -> int:
    t = prune(t0)
    if types[t].kind == .quantity or types[t].kind == .dimension: return int(types[t].st)
    0

intern_dimension = (powers: int[]) -> int:
    loop i in [0..quantity_dimensions.len()):
        same = true
        loop j in [0..8):
            if quantity_dimensions[i][j] != powers[j]: same = false
        if same: return i
    quantity_dimensions.push(powers)
    quantity_dimensions.len() - 1

combine_dimensions = (a: int, b: int, sign: int, pos: int) -> int:
    powers: int[]
    loop i in [0..8):
        power = quantity_dimensions[a][i] + sign * quantity_dimensions[b][i]
        if power < -QUANTITY_POWER_MAX or power > QUANTITY_POWER_MAX: fatal(pos, "physical dimension exponent is too large")
        powers.push(power)
    intern_dimension(powers)

# (dim raised to num/den; a root finer than the stored denominator is an error)
power_dimension = (dim: int, num: int, pos: int, den: int = 1) -> int:
    if num < -32767 or num > 32767 or den < 1 or den > 32767: fatal(pos, "physical dimension exponent is too large")
    powers: int[]
    loop i in [0..8):
        value = quantity_dimensions[dim][i] * num
        if value < -QUANTITY_POWER_MAX or value > QUANTITY_POWER_MAX: fatal(pos, "physical dimension exponent is too large")
        if value % den != 0: fatal(pos, "physical dimension exponent {quantity_power_text(quantity_dimensions[dim][i])} divided by {den} is finer than Dewy tracks")
        powers.push(value / den)
    intern_dimension(powers)

# (a stored power as written: 2, -1, 1/2 or -3/2)
quantity_power_text = (stored: int) -> str:
    g = quantity_gcd(stored, QUANTITY_POWER_DEN)
    num = stored / g
    den = QUANTITY_POWER_DEN / g
    if den == 1: return "{num}"
    "{num}/{den}"

quantity_numeric = (t0: int) -> bool:
    t = prune(t0)
    k = types[t].kind
    if k == .param or k == .var or is_numeric(t): return true
    if bundled_bigint_type(t): return true
    if k != .struct_: return false
    si = int(types[t].st)
    d = int(structs[si].decl)
    d != 0 and structs[si].name == "Rational" and files[pos_file(nodes[d].pos)].path == lib_dir + "/rational.dewy"

# (tag: how the quantity shows and where an offset scale's zero is; see quantity_tags)
mk_quantity = (base: int, dim: int, pos: int = 0, tag: int = 0) -> int:
    if dim == 0: return base
    if not quantity_numeric(base): fatal(pos, "physical quantities need a numeric representation, found {dt(base)}")
    mk_type(TypeInfo(kind = .quantity, elem = i32(base), st = i32(dim), bits = i32(tag)), [])

mk_dimension = (dim: int) -> int: mk_type(TypeInfo(kind = .dimension, st = i32(dim)), [])

dimension_str = (dim: int) -> str:
    text = ""
    loop i in [0..8):
        power = quantity_dimensions[dim][i]
        if power == 0: continue
        if text != "": text += " * "
        text += quantity_dimension_names[i]
        if power != QUANTITY_POWER_DEN:
            shown = quantity_power_text(power)
            if find_byte(shown, '/') >= 0: text += "^({shown})"
            else: text += "^{shown}"
    if text == "": return "dimensionless"
    text

quantity_mismatch = (pos: int, a: int, b: int):
    fatal(pos, "dimension mismatch: {dimension_str(quantity_dimension(a))} and {dimension_str(quantity_dimension(b))} ({dt(a)} and {dt(b)})")

resolve_quantity_type = (n: int) -> int:
    a = resolve_type(int(nodes[n].a))
    ad = quantity_dimension(a)
    op = nodes[n].op as Tok
    if op == .caret:
        if types[a].kind != .dimension: fatal(nodes[n].pos, "raise the dimension factor to a power, not its numeric representation")
        e = int(nodes[n].b)
        if nodes[e].kind == .binary and nodes[e].op == i32(int(Tok.slash)):
            return mk_dimension(power_dimension(ad, ceval(int(nodes[e].a)).i, nodes[n].pos, ceval(int(nodes[e].b)).i))
        if nodes[e].kind == .call and nodes[int(nodes[e].a)].kind == .ident and nodes[int(nodes[e].a)].name == i32(intern("__dewy_divide")) and nkids(e) == 2:
            return mk_dimension(power_dimension(ad, ceval(kid(e, 0)).i, nodes[n].pos, ceval(kid(e, 1)).i))
        power = ceval(e).i
        return mk_dimension(power_dimension(ad, power, nodes[n].pos))
    b = resolve_type(int(nodes[n].b))
    bd = quantity_dimension(b)
    sign = if op == .slash: -1 else: 1
    dim = combine_dimensions(ad, bd, sign, nodes[n].pos)
    ak = types[a].kind
    bk = types[b].kind
    if ak == .dimension and bk == .dimension: return mk_dimension(dim)
    if bk == .dimension: return mk_quantity(quantity_base(a), dim, nodes[n].pos)
    if ak == .dimension and op == .star: return mk_quantity(quantity_base(b), dim, nodes[n].pos)
    fatal(nodes[n].pos, "a quantity type combines one numeric representation with physical dimensions")
    0

register_quantity_names = ():
    loop i in [0..8):
        dim = base_dimension(i)
        nm = intern(quantity_dimension_names[i])
        universe[nm] = new_sym(nm, .type_, mk_dimension(dim), 0)
    # Time is prelude surface. Other unit values live in units.dewy.
    loop item in [("s", 1, 1), ("second", 1, 1), ("seconds", 1, 1),
        ("ms", 1, 1000), ("millisecond", 1, 1000), ("milliseconds", 1, 1000),
        ("us", 1, 1000000), ("microsecond", 1, 1000000), ("microseconds", 1, 1000000),
        ("ns", 1, 1000000000), ("nanosecond", 1, 1000000000), ("nanoseconds", 1, 1000000000),
        ("minute", 60, 1), ("hour", 3600, 1)]:
        nm = intern(item.0)
        n = mk(.unit_lit, 0)
        nodes[n].ival = item.1
        nodes[n].aux = i32(item.2)
        nodes[n].aux2 = 1
        globals.push(Global(name = i32(nm), is_const = true, init = i32(n), state = 2))
        universe[nm] = new_sym(nm, .const_, globals.len() - 1, 0)

quantity_gcd = (a0: int, b0: int) -> int:
    a = abs(a0)
    b = abs(b0)
    loop b != 0:
        r = a % b
        a = b
        b = r
    if a == 0: return 1
    a

quantity_scale = (num0: int, den0: int) -> int:
    num = num0
    den = den0
    if den < 0:
        num = -num
        den = -den
    g = quantity_gcd(num, den)
    quantity_scales.push(QuantityScale(num / g, den / g))
    quantity_scales.len() - 1

# A marked, representation-preserving conversion retains exact constant data
# through ordinary AST cloning. Its child is the same numeric value as a plain
# program would use; there is no runtime unit descriptor.
quantity_constant = (n: int, num: int, den: int, dim: int, expected: int) -> int:
    if den == 0: fatal(nodes[n].pos, "division by zero in a physical quantity constant")
    scale = quantity_scale(num, den)
    value = quantity_scales[scale]
    pos = nodes[n].pos
    hint = if dim != 0 and not is_quantity(expected): 0 else: quantity_base(expected)
    a = 0
    if is_float(hint):
        a = mk(.float_lit, pos)
        nodes[a].fval = f64(value.numerator) / f64(value.denominator)
        check_expr(a, hint)
    else if value.denominator == 1 and not bundled_rational_type(hint):
        a = bc_int(value.numerator, pos)
        check_expr(a, if is_int(hint): hint else: 0)
    else:
        ensure_bundled_import("rational.dewy", "$dewy_rational", pos)
        callee = bc_field(bc_ident("$dewy_rational", pos), "rational", pos)
        a = mk(.call, pos)
        nodes[a].a = i32(callee)
        set_list(a, [bc_int(value.numerator, pos), bc_int(value.denominator, pos)])
        check_expr(a, 0)
    tag = if dim != 0 and is_quantity(expected) and quantity_dimension(expected) == dim: quantity_tag(expected) else: 0
    t = mk_quantity(ntype(a), dim, 0, tag)
    nodes[n] = Node(kind = .conv, pos = pos, a = i32(a), aux = i32(int(CV.quantity_const)), aux2 = i32(scale), type = i32(t), flags = i32(NF_CHECKED))
    last_checked = n
    t

quantity_constant_scale = (n: int) -> int:
    if nodes[n].kind == .conv and nodes[n].aux == i32(int(CV.quantity_const)):
        if is_float(quantity_base(ntype(n))): return -1
        return int(nodes[n].aux2)
    if nodes[n].kind == .ident and nodes[n].type != 0:
        source = binding_const_init(nodes[n].aux as SK, int(nodes[n].sym), nodes[n].pos)
        if source != 0: return quantity_constant_scale(source)
    if nodes[n].kind == .int_lit and not has_flag(n, NF_U64) and nodes[n].ival != (-9223372036854775807 - 1): return quantity_scale(nodes[n].ival, 1)
    # (an exact decimal literal, 0.001 in 0.001s)
    if let parts = rational_constants.get(n): return quantity_scale(parts.0, parts.1)
    -1

quantity_number = (n: int) -> int:
    if not is_quantity(ntype(n)): return n
    if nodes[n].kind == .conv and (nodes[n].aux == i32(int(CV.none_)) or nodes[n].aux == i32(int(CV.quantity_const))):
        inner = int(nodes[n].a)
        if is_quantity(ntype(inner)): return quantity_number(inner)
        return inner
    a = mk(.conv, nodes[n].pos)
    nodes[a].a = i32(n)
    nodes[a].aux = i32(int(CV.none_))
    nodes[a].type = i32(quantity_base(ntype(n)))
    add_flag(a, NF_CHECKED)
    a

quantity_result = (n: int, dim: int) -> int:
    finalize_literal(n)
    t = mk_quantity(ntype(n), dim)
    if dim != 0: wrap_conv(n, .none_, t)
    add_flag(n, NF_CHECKED)
    last_checked = n
    t

quantity_constant_fits = (n: int, target: int) -> bool:
    if n == 0 or not is_quantity(ntype(n)) or not is_quantity(target): return false
    if quantity_dimension(ntype(n)) != quantity_dimension(target): return false
    scale = quantity_constant_scale(n)
    if scale < 0: return false
    base = quantity_base(target)
    q = quantity_scales[scale]
    if is_float(base) or bundled_rational_type(base): return true
    is_int(base) and q.denominator == 1 and int_fits(q.numerator, base)

quantity_coerce = (n: int, target: int) -> int:
    source = ntype(n)
    if quantity_dimension(source) != quantity_dimension(target): quantity_mismatch(nodes[n].pos, source, target)
    if type_eq(source, target): return n
    # (a temperature point and a difference are different values: neither holds the other)
    if quantity_internal == 0 and ((quantity_point(target) and quantity_is_delta(source)) or (quantity_is_delta(target) and quantity_point(source))):
        point = if quantity_point(target): target else: source
        unit = quantity_point_unit(point)
        if quantity_point(target): fatal(nodes[n].pos, "a temperature difference cannot stand for a point: add it to one (`ref + d`), or keep it as a difference")
        fatal(nodes[n].pos, "a temperature point cannot stand for a difference: subtract two points (`let rise = 25{unit} - 5{unit}`), or use kelvin (`5K`)")
    constant = quantity_constant_scale(n)
    if constant >= 0 and (is_numeric(quantity_base(target)) or bundled_rational_type(quantity_base(target))):
        scale = quantity_scales[constant]
        if scale.denominator != 1 and is_int(quantity_base(target)): fatal(nodes[n].pos, "fractional quantity cannot convert to {dt(target)}")
        quantity_constant(n, scale.numerator, scale.denominator, quantity_dimension(target), target)
        return n
    # Save the source before introducing an erasing conversion: that conversion
    # must not point back to n after n is replaced by the converted result.
    source_copy = nodes.len()
    nodes.push(nodes[n])
    a = quantity_number(source_copy)
    # Do not mutate a source node that may be shared with a place or another use.
    copy = nodes.len()
    nodes.push(nodes[a])
    coerce(copy, quantity_base(target))
    nodes[n] = nodes[copy]
    wrap_conv(n, .none_, target)
    add_flag(n, NF_CHECKED)
    n

quantity_transmute = (n: int, a: int, from: int, to: int) -> int:
    fb = quantity_base(from)
    tb = quantity_base(to)
    if not type_eq(fb, tb): fatal(nodes[n].pos, "quantity transmute must preserve its numeric representation ({dt(fb)} to {dt(tb)})")
    scale = quantity_constant_scale(a)
    if scale >= 0:
        q = quantity_scales[scale]
        return quantity_constant(n, q.numerator, q.denominator, quantity_dimension(to), to)
    nodes[n] = nodes[a]
    wrap_conv(n, .none_, to)
    add_flag(n, NF_CHECKED)
    last_checked = n
    to

quantity_product_fits = (a: int, b: int) -> bool:
    # The minimum signed value is excluded from the small constant evaluator.
    if a == (-9223372036854775807 - 1) or b == (-9223372036854775807 - 1): return false
    b == 0 or abs(a) <= 9223372036854775807 / abs(b)

quantity_fold = (n: int, a: int, b: int, dim: int, op: Tok, expected: int) -> bool:
    # Explicit machine widths use their ordinary wrapping arithmetic.
    if is_quantity(ntype(a)) and is_int(quantity_base(ntype(a))) and quantity_base(ntype(a)) != T_INT and quantity_base(ntype(a)) != T_MATH_INT: return false
    if is_quantity(ntype(b)) and is_int(quantity_base(ntype(b))) and quantity_base(ntype(b)) != T_INT and quantity_base(ntype(b)) != T_MATH_INT: return false
    ai = quantity_constant_scale(a)
    bi = quantity_constant_scale(b)
    if ai < 0 or bi < 0: return false
    av = quantity_scales[ai]
    bv = quantity_scales[bi]
    an = av.numerator
    ad = av.denominator
    bn = bv.numerator
    bd = bv.denominator
    if op == .slash:
        if bn == 0: fatal(nodes[n].pos, "division by zero in a physical quantity constant")
        swap = bn
        bn = bd
        bd = swap
    if op == .star or op == .slash:
        g = quantity_gcd(an, bd)
        an /= g
        bd /= g
        g = quantity_gcd(bn, ad)
        bn /= g
        ad /= g
        if not quantity_product_fits(an, bn) or not quantity_product_fits(ad, bd): return false
        quantity_constant(n, an * bn, ad * bd, dim, expected)
        return true
    if op == .plus or op == .minus:
        g = quantity_gcd(ad, bd)
        if not quantity_product_fits(an, bd / g) or not quantity_product_fits(bn, ad / g) or not quantity_product_fits(ad, bd / g): return false
        left = an * (bd / g)
        right = bn * (ad / g)
        if op == .minus: right = -right
        if right > 0 and left > 9223372036854775807 - right: return false
        if right < 0 and left < -9223372036854775807 - right: return false
        quantity_constant(n, left + right, ad * (bd / g), dim, expected)
        return true
    false

quantity_operands = (a: int, b: int) -> int[]:
    aa = quantity_number(a)
    bb = quantity_number(b)
    # Exact scales are rounded only where a floating representation requests it.
    ai = quantity_constant_scale(a)
    bi = quantity_constant_scale(b)
    if is_float(ntype(bb)) and ai >= 0:
        q = quantity_scales[ai]
        aa = mk(.unit_lit, nodes[a].pos)
        quantity_constant(aa, q.numerator, q.denominator, 0, ntype(bb))
    if is_float(ntype(aa)) and bi >= 0:
        q = quantity_scales[bi]
        bb = mk(.unit_lit, nodes[b].pos)
        quantity_constant(bb, q.numerator, q.denominator, 0, ntype(aa))
    add_flag(aa, NF_CHECKED)
    add_flag(bb, NF_CHECKED)
    [aa, bb]

quantity_binary_plain = (n: int, a: int, b: int, expected: int) -> int:
    op = nodes[n].op as Tok
    ad = quantity_dimension(ntype(a))
    bd = quantity_dimension(ntype(b))
    dim = ad
    cmp = op == .eq or op == .ne or op == .lt or op == .le or op == .gt or op == .ge
    if op == .star: dim = combine_dimensions(ad, bd, 1, nodes[n].pos)
    else if op == .slash: dim = combine_dimensions(ad, bd, -1, nodes[n].pos)
    else if op == .plus or op == .minus or cmp:
        if ad != bd: quantity_mismatch(nodes[n].pos, ntype(a), ntype(b))
    else: fatal(nodes[n].pos, "operator {op_text(op, nodes[n].pos)} is not defined for physical quantities")
    if quantity_fold(n, a, b, dim, op, expected): return ntype(n)
    # Attaching/removing a canonical unit does not perform arithmetic at all.
    # In particular float * 1 must not survive as an otherwise unoptimized fmul.
    unit = if op == .star and is_quantity(ntype(a)) and quantity_constant_scale(a) >= 0: a else: b
    value = if unit == a: b else: a
    scale = quantity_constant_scale(unit)
    if scale >= 0 and is_quantity(ntype(unit)) and (op == .star or (op == .slash and is_float(quantity_base(ntype(value))))):
        q = quantity_scales[scale]
        if q.numerator == 1 and q.denominator == 1:
            nodes[n] = nodes[quantity_number(value)]
            return quantity_result(n, dim)
    operands = quantity_operands(a, b)
    nodes[n].a = i32(operands[0])
    nodes[n].b = i32(operands[1])
    check_expr(n, quantity_base(expected))
    if cmp: return T_BOOL
    quantity_result(n, dim)

quantity_arithmetic_plain = (n: int, name: int, a: int, b: int, expected: int) -> int:
    dim = quantity_dimension(ntype(a))
    bd = quantity_dimension(ntype(b))
    power = name == intern("__dewy_power")
    divide = name == intern("__dewy_divide")
    if power:
        if bd != 0: fatal(nodes[b].pos, "a physical quantity exponent must be a dimensionless constant integer")
        bi = quantity_constant_scale(b)
        if bi < 0 or quantity_scales[bi].denominator != 1: fatal(nodes[b].pos, "a physical quantity exponent must be a constant integer")
        exponent = quantity_scales[bi].numerator
        dim = power_dimension(dim, exponent, nodes[n].pos)
        ai = quantity_constant_scale(a)
        if ai >= 0 and exponent >= -64 and exponent <= 64:
            q = quantity_scales[ai]
            if exponent < 0:
                if q.numerator == 0: fatal(nodes[n].pos, "division by zero in a physical quantity constant")
                q = QuantityScale(q.denominator, q.numerator)
            num = 1
            den = 1
            fits = true
            loop i in [0..abs(exponent)):
                if not quantity_product_fits(num, q.numerator) or not quantity_product_fits(den, q.denominator):
                    fits = false
                    break
                num *= q.numerator
                den *= q.denominator
            if fits: return quantity_constant(n, num, den, dim, expected)
    else if divide:
        dim = combine_dimensions(dim, bd, -1, nodes[n].pos)
        if quantity_fold(n, a, b, dim, .slash, expected): return ntype(n)
        scale = quantity_constant_scale(b)
        if scale >= 0 and is_quantity(ntype(b)) and is_float(quantity_base(ntype(a))):
            q = quantity_scales[scale]
            if q.numerator == 1 and q.denominator == 1:
                nodes[n] = nodes[quantity_number(a)]
                return quantity_result(n, dim)
    else: fatal(nodes[n].pos, "floor division and remainder are not defined for physical quantities")
    operands = quantity_operands(a, b)
    if power and quantity_scales[quantity_constant_scale(b)].numerator < 0 and is_int(ntype(operands[0])):
        pos = nodes[n].pos
        ensure_bundled_import("rational.dewy", "$dewy_rational", pos)
        value = mk(.call, pos)
        nodes[value].a = i32(bc_field(bc_ident("$dewy_rational", pos), "rational", pos))
        set_list(value, [operands[0]])
        check_expr(value, 0)
        add_flag(value, NF_CHECKED)
        operands[0] = value
    set_list(n, operands)
    check_expr(n, quantity_base(expected))
    quantity_result(n, dim)

quantity_unary_plain = (n: int, expected: int) -> int:
    a = int(nodes[n].a)
    dim = quantity_dimension(ntype(a))
    op = nodes[n].op as Tok
    if op != .minus and op != .plus: fatal(nodes[n].pos, "operator {op_text(op, nodes[n].pos)} is not defined for physical quantities")
    scale = quantity_constant_scale(a)
    if scale >= 0:
        q = quantity_scales[scale]
        numerator = if op == .minus: -q.numerator else: q.numerator
        return quantity_constant(n, numerator, q.denominator, dim, expected)
    nodes[n].a = i32(quantity_number(a))
    check_expr(n, quantity_base(expected))
    quantity_result(n, dim)

# Preserve the scalar compound-update path after checking the qualifier. The
# indexed/field path still captures and reacquires places in the usual checker.
quantity_compound = (s: int, target: int) -> bool:
    if quantity_base(target) == T_MATH_INT: return false
    if not is_numeric(quantity_base(target)) or nodes[s].sval != 0 or has_flag(s, NF_BROADCAST): return false
    if nodes[int(nodes[s].a)].kind != .ident: return false
    if nodes[s].op != i32(int(Tok.pluseq)) and nodes[s].op != i32(int(Tok.minuseq)): return false
    right = int(nodes[s].b)
    literal = quantity_literal_syntax(right)
    check_expr(right, target)
    right = last_checked
    # (t += 5°C: what is added to or taken from a temperature point is a difference)
    quantity_update_check(nodes[s].pos, nodes[s].op == i32(int(Tok.minuseq)), int(nodes[s].a), right, target, literal)
    if quantity_offset_tagged(target) or quantity_offset_tagged(ntype(right)): right = quantity_delta_reading(right)
    nodes[s].b = i32(quantity_number(coerce(right, target)))
    true

# t += x and t -= x on a temperature: a point moves by a difference (a literal is read as
# one); a difference moves by a difference.
quantity_update_check = (pos: int, minus: bool, place: int, right: int, target: int, literal: bool):
    tr = ntype(right)
    if quantity_dimension(target) != base_dimension(4) or quantity_dimension(tr) != base_dimension(4): return
    what = if minus: "take a point from a difference" else: "add a point to a difference"
    if quantity_is_delta(target) and quantity_point(tr): quantity_difference_point(pos, right, tr, what)
    if not quantity_point(target) or not quantity_point(tr) or literal: return
    if not minus: quantity_points_added(pos, place, right, target)
    p = quantity_operand_text(place, "t")
    r = quantity_operand_text(right, "ref")
    fatal(pos, "`{p} - {r}` is a difference, not a temperature point, so `{p}` cannot hold it: write `let rise = {p} - {r}`, or subtract a difference (`5K`)")

bundled_word_rational_type = (t0: int) -> bool:
    t = prune(t0)
    if types[t].kind != .struct_: return false
    si = int(types[t].st)
    d = int(structs[si].decl)
    d != 0 and structs[si].name == "RationalWord" and files[pos_file(nodes[d].pos)].path == lib_dir + "/rational.dewy"

bundled_rational_type = (t0: int) -> bool:
    t = prune(t0)
    if types[t].kind != .struct_: return false
    si = int(types[t].st)
    d = int(structs[si].decl)
    d != 0 and structs[si].name == "Rational" and files[pos_file(nodes[d].pos)].path == lib_dir + "/rational.dewy"

base_dimension = (i: int) -> int:
    powers = fill(0, 8)
    powers[i] = QUANTITY_POWER_DEN
    intern_dimension(powers)

# (n calls the runtime function fname with the checked arguments args)
runtime_call = (n: int, fname: str, args: int[], result: int) -> int:
    nodes[n].kind = .call
    nodes[n].aux = 0
    set_list(n, args)
    nodes[n].sym = i32(runtime_fn(fname))
    nodes[n].type = i32(result)
    add_flag(n, NF_CHECKED)
    last_checked = n
    result

# (the bundled rational module's helper fname applied to the checked value a, at n)
rational_helper_call = (n: int, fname: str, a: int, expected: int) -> int:
    pos = nodes[n].pos
    ensure_bundled_import("rational.dewy", "$dewy_rational", pos)
    c = mk(.call, pos)
    nodes[c].a = i32(bc_field(bc_ident("$dewy_rational", pos), fname, pos))
    set_list(c, [a])
    t = check_expr(c, expected)
    nodes[n] = nodes[last_checked]
    last_checked = n
    t

# (the checked number a as a float64)
quantity_float = (a: int) -> int:
    t = prune(ntype(a))
    if type_eq(t, T_FLOAT): return a
    if not is_float(t) and not is_int(t): return 0
    c = mk(.conv, nodes[a].pos)
    nodes[c].a = i32(a)
    nodes[c].aux = i32(int(CV.int2float))
    if is_float(t): nodes[c].aux = i32(int(CV.float_))
    nodes[c].type = i32(T_FLOAT)
    add_flag(c, NF_CHECKED)
    c

# Dewy's sleep and its trigonometry take quantities (physical-quantities.md): sleep a time,
# converted to whole nanoseconds; sin, cos and tan an angle, which counts whole turns, reduced
# exactly before evaluation; a plain number is an error (radians are `x*rad`). a is the
# checked argument.
dewy_quantity_call = (n: int, name: int, a: int, expected: int) -> int:
    fname = name_of(name)
    t = prune(ntype(a))
    base = quantity_base(t)
    number = quantity_number(a)
    add_flag(number, NF_CHECKED)
    if fname == "sleep":
        if not is_quantity(t) or quantity_dimension(t) != base_dimension(0):
            fatal(nodes[a].pos, "sleep takes a time, such as `sleep(300ms)` or `sleep(2s)` (found {dt(t)})")
        if target_wasm: no_web_check(int(syms[lookup(name)].decl), nodes[n].pos)
        if bundled_rational_type(base):
            ns = mk(.call, nodes[n].pos)
            rational_helper_call(ns, "_whole_nanoseconds", number, T_INT)
            return runtime_call(n, "__task_sleep_ns", [coerce(ns, T_INT)], task_sleep_type())
        if is_int(base):
            whole = mk(.conv, nodes[a].pos)
            nodes[whole].a = i32(number)
            nodes[whole].aux = i32(int(CV.int_))
            nodes[whole].type = i32(T_INT)
            add_flag(whole, NF_CHECKED)
            ns = bc_bin(.star, whole, bc_int(1000000000, nodes[a].pos), nodes[a].pos)
            check_expr(ns, T_INT)
            return runtime_call(n, "__task_sleep_ns", [last_checked], task_sleep_type())
        if is_float(base): return runtime_call(n, "__task_sleep_seconds", [quantity_float(number)], task_sleep_type())
        fatal(nodes[a].pos, "sleep takes a time counted in an integer, rational or float (found {dt(t)})")
    if not is_quantity(t): fatal(nodes[a].pos, "{fname} takes an angle, not a plain number: `{fname}(x*rad)` for radians, or `{fname}(45°)`, `{fname}(t*turn)` (`from units import rad`; found {dt(t)})")
    if quantity_dimension(t) != base_dimension(7): fatal(nodes[a].pos, "{fname} takes an angle, such as `{fname}(45°)` (found {dt(t)})")
    if bundled_rational_type(base): return rational_helper_call(n, "_{fname}_turns", number, expected)
    turns = quantity_float(number)
    if turns == 0: fatal(nodes[a].pos, "{fname} takes an angle counted in an integer, rational or float (found {dt(t)})")
    runtime_call(n, "__{fname}_turns", [turns], T_FLOAT)

# ---------------- display units, offset scales and differences ----------------
# A quantity type may carry a tag (in TypeInfo.bits) saying which unit it shows in and,
# for an offset scale such as Celsius, which unit's zero it was measured from. Tags never
# change the runtime number, which stays canonical (kelvins for a temperature point or
# difference); they decide how a value prints and how offset values combine.
struct QuantityUnit:
    sym: str
    num: int        # one unit is num/den canonical units
    den: int
    onum: int       # the unit's zero, in canonical units (0 °C is 5463/20 K)
    oden: int
quantity_units: QuantityUnit[] = [QuantityUnit("", 1, 1, 0, 1)]

struct QuantityTag:
    display: int    # the unit it shows in (0: chosen from the dimension and magnitude)
    origin: int     # the offset unit it was written in (0: none)
    delta: bool     # a difference of temperatures: shown without the unit's offset
quantity_tags: QuantityTag[] = [QuantityTag(0, 0, false)]

intern_quantity_unit = (sym: str, num: int, den: int, onum: int, oden: int) -> int:
    loop i in [1..quantity_units.len()):
        u = quantity_units[i]
        if u.sym == sym and u.num == num and u.den == den and u.onum == onum and u.oden == oden: return i
    quantity_units.push(QuantityUnit(sym, num, den, onum, oden))
    quantity_units.len() - 1

intern_quantity_tag = (display: int, origin: int, delta: bool) -> int:
    loop i in [0..quantity_tags.len()):
        q = quantity_tags[i]
        if q.display == display and q.origin == origin and q.delta == delta: return i
    quantity_tags.push(QuantityTag(display, origin, delta))
    quantity_tags.len() - 1

quantity_tag = (t0: int) -> int:
    t = prune(t0)
    if types[t].kind == .quantity: return int(types[t].bits)
    0

# (a temperature written in an offset unit, or a difference of temperatures)
quantity_offset_tagged = (t: int) -> bool:
    q = quantity_tags[quantity_tag(t)]
    q.origin != 0 or q.delta

quantity_is_delta = (t: int) -> bool: quantity_tags[quantity_tag(t)].delta

# (the checked quantity n given tag; its number is unchanged)
quantity_retag = (n: int, tag: int) -> int:
    t = ntype(n)
    if not is_quantity(t) or quantity_tag(t) == tag: return t
    to = mk_quantity(quantity_base(t), quantity_dimension(t), nodes[n].pos, tag)
    if nodes[n].kind == .conv and (nodes[n].aux == i32(int(CV.none_)) or nodes[n].aux == i32(int(CV.quantity_const))): nodes[n].type = i32(to)
    else: wrap_conv(n, .none_, to)
    add_flag(n, NF_CHECKED)
    last_checked = n
    to

# (the checked constant num/den canonical units of dim, in the number type of like)
quantity_offset_constant = (num: int, den: int, dim: int, like: int, pos: int) -> int:
    c = mk(.unit_lit, pos)
    quantity_constant(c, num, den, dim, mk_quantity(quantity_base(like), dim))
    c

# (n read as a difference: a temperature written in °C counts from 0 °C, so 20°C is 20 K)
quantity_delta_reading = (n: int) -> int:
    t = ntype(n)
    if not is_quantity(t): return n
    q = quantity_tags[quantity_tag(t)]
    quantity_retag(n, 0)
    if q.delta or q.origin == 0 or quantity_units[q.origin].onum == 0: return n
    u = quantity_units[q.origin]
    pos = nodes[n].pos
    e = bc_bin(.minus, n, quantity_offset_constant(u.onum, u.oden, quantity_dimension(t), t, pos), pos)
    quantity_internal_check(e)

# (n read as a point: its canonical number)
quantity_point_reading = (n: int) -> int:
    quantity_retag(n, 0)
    n

# (x scaled in its own unit: (x - zero) op k + zero, so 20°C * 2 is 40°C)
quantity_scaled = (x: int, k: int, op: Tok, x_first: bool, pos: int) -> int:
    t = ntype(x)
    q = quantity_tags[quantity_tag(t)]
    reading = quantity_delta_reading(x)
    left = if x_first: reading else: k
    right = if x_first: k else: reading
    e = quantity_operation(op, left, right, pos)
    if q.delta or q.origin == 0: return e
    u = quantity_units[q.origin]
    sum = bc_bin(.plus, e, quantity_offset_constant(u.onum, u.oden, quantity_dimension(t), t, pos), pos)
    quantity_internal_check(sum)

# (a op b checked; Dewy division is exact)
quantity_operation = (op: Tok, a: int, b: int, pos: int) -> int:
    e = 0
    if op == .slash and dewy_at(pos): e = bc_call("__dewy_divide", [a, b], pos)
    else: e = bc_bin(op, a, b, pos)
    quantity_internal_check(e)

# (n becomes the checked e, tagged)
quantity_become = (n: int, e: int, tag: int) -> int:
    nodes[n] = nodes[e]
    last_checked = n
    if is_quantity(ntype(n)): return quantity_retag(n, tag)
    ntype(n)

# Literal-looking operands (`20°C`, `-5°F`), before they are checked. A converted one,
# `(20°C as °F)`, is a value of its own: a point.
quantity_literal_syntax = (e: int) -> bool:
    if e == 0 or has_flag(e, NF_CHECKED): return false
    k = nodes[e].kind
    if k == .unary: return quantity_literal_syntax(int(nodes[e].a))
    if k == .binary and nodes[e].op == i32(int(Tok.star)):
        x = nodes[int(nodes[e].a)].kind
        return (x == .int_lit or x == .float_lit) and nodes[int(nodes[e].b)].kind == .ident
    false

# A unit written by name (`°C`, `units.°C`), before it is checked: `c*°C` makes a point
# from a number, where scaling a point is an error.
quantity_name_syntax = (e: int) -> bool:
    if e == 0 or has_flag(e, NF_CHECKED): return false
    k = nodes[e].kind
    k == .ident or (k == .field and nodes[int(nodes[e].a)].kind == .ident)

quantity_update_right = 0      # the right side of a compound update being checked
quantity_left_literal = false
quantity_right_literal = false

# (the checked value of e, built here from checked operands without tags)
quantity_internal_check = (e: int) -> int:
    quantity_internal += 1
    check_expr(e, 0)
    quantity_internal -= 1
    last_checked

quantity_internal = 0

quantity_binary = (n: int, a: int, b: int, expected: int) -> int:
    a_lit = quantity_left_literal
    b_lit = quantity_right_literal
    quantity_left_literal = false
    quantity_right_literal = false
    if quantity_internal > 0: return quantity_binary_plain(n, a, b, expected)
    ta = ntype(a)
    tb = ntype(b)
    op = nodes[n].op as Tok
    # (a temperature minus a temperature is a difference unless a literal is taken away)
    temperatures = op == .minus and quantity_dimension(ta) == base_dimension(4) and quantity_dimension(tb) == base_dimension(4)
    if quantity_tag(ta) == 0 and quantity_tag(tb) == 0 and not temperatures: return quantity_binary_plain(n, a, b, expected)
    pos = nodes[n].pos
    aq = is_quantity(ta)
    bq = is_quantity(tb)
    cmp = op == .eq or op == .ne or op == .lt or op == .le or op == .gt or op == .ge
    if not quantity_offset_tagged(ta) and not quantity_offset_tagged(tb) and not temperatures:
        # Display units only: a sum keeps its first operand's, scaling keeps the quantity's.
        keep = 0
        if op == .plus or op == .minus: keep = if quantity_tag(ta) != 0: quantity_tag(ta) else: quantity_tag(tb)
        else if (op == .star or op == .slash) and not bq: keep = quantity_tag(ta)
        else if op == .star and not aq: keep = quantity_tag(tb)
        quantity_retag(a, 0)
        quantity_retag(b, 0)
        t = quantity_binary_plain(n, a, b, expected)
        if cmp or not is_quantity(t): return t
        return quantity_retag(n, keep)
    if op == .plus or op == .minus or cmp:
        if not aq or not bq or quantity_dimension(ta) != quantity_dimension(tb): quantity_mismatch(pos, ta, tb)
    da = quantity_is_delta(ta)
    db = quantity_is_delta(tb)
    pa = quantity_point(ta)
    pb = quantity_point(tb)
    if op == .plus:
        # A point and a difference; a temperature written as an operand next to a point is
        # one (start + 20°C). Two points do not add.
        if da and db: return quantity_become(n, quantity_operation(.plus, quantity_point_reading(a), quantity_point_reading(b), pos), quantity_tag(ta))
        if pa and pb and not a_lit and not b_lit: quantity_points_added(pos, a, b, ta)
        a_point = not da and (db or not a_lit or b_lit)
        if a_point: return quantity_become(n, quantity_operation(.plus, quantity_point_reading(a), quantity_delta_reading(b), pos), quantity_tag(ta))
        return quantity_become(n, quantity_operation(.plus, quantity_delta_reading(a), quantity_point_reading(b), pos), quantity_tag(tb))
    if op == .minus:
        if da and pb: quantity_difference_point(pos, b, tb, "take a point from a difference")
        if db or da: return quantity_become(n, quantity_operation(.minus, quantity_point_reading(a), quantity_delta_reading(b), pos), quantity_tag(ta))
        if b_lit and not a_lit: return quantity_become(n, quantity_operation(.minus, quantity_point_reading(a), quantity_delta_reading(b), pos), quantity_tag(ta))
        # point - point = difference, shown in the first point's unit
        q = quantity_tags[quantity_tag(ta)]
        unit = if q.display != 0: q.display else: q.origin
        return quantity_become(n, quantity_operation(.minus, quantity_point_reading(a), quantity_point_reading(b), pos), intern_quantity_tag(unit, 0, true))
    if cmp:
        if pa and db: quantity_difference_point(pos, a, ta, "compare a point with a difference")
        if da and pb: quantity_difference_point(pos, b, tb, "compare a point with a difference")
        if da == db: return quantity_become(n, quantity_operation(op, quantity_point_reading(a), quantity_point_reading(b), pos), 0)
        return quantity_become(n, quantity_operation(op, quantity_delta_reading(a), quantity_delta_reading(b), pos), 0)
    if op == .star or op == .slash: return quantity_offset_product(n, a, b, op, expected, a_lit, b_lit)
    quantity_retag(a, 0)
    quantity_retag(b, 0)
    quantity_binary_plain(n, a, b, expected)

# (a temperature point: written in an offset unit, or shown in one, and not a difference)
quantity_point = (t: int) -> bool:
    if not is_quantity(t): return false
    q = quantity_tags[quantity_tag(t)]
    not q.delta and (q.origin != 0 or quantity_units[q.display].onum != 0)

# (the checked x is the offset unit itself, as its name was written: °C in c*°C)
quantity_is_unit = (x: int, named: bool) -> bool:
    if not named: return false
    t = ntype(x)
    q = quantity_tags[quantity_tag(t)]
    if q.delta or q.origin == 0 or q.display != q.origin: return false
    scale = quantity_constant_scale(x)
    if scale < 0: return false
    u = quantity_units[q.origin]
    v = quantity_scales[scale]
    # (one degree: its zero plus its size)
    v.numerator * u.den * u.oden == (u.onum * u.den + u.num * u.oden) * v.denominator

# (the text of the checked operand x for a diagnostic, or alt)
quantity_operand_text = (x: int, alt: str) -> str:
    if nodes[x].kind == .ident:
        nm = name_of(int(nodes[x].name))
        if len(nm) > 0 and nm[0] != '_' and nm[0] != '$': return nm
    alt

# (the unit a point of type t was written or shown in, for a fix-it: °C)
quantity_point_unit = (t: int) -> str:
    q = quantity_tags[quantity_tag(t)]
    u = if q.origin != 0: q.origin else: q.display
    if u == 0: return "K"
    quantity_units[u].sym

quantity_points_added = (pos: int, a: int, b: int, t: int):
    x = quantity_operand_text(a, "t1")
    y = quantity_operand_text(b, "t2")
    unit = quantity_point_unit(t)
    fatal(pos, "cannot add two temperatures: both are points on the {unit} scale, and their sum depends on where its zero sits (20{unit} + 20{unit} is not 40{unit}). For an average write `mean[{x} {y}]`; to add a difference, subtract two points (`{x} + ({y} - ref)`) or use kelvin (`5K`)")

quantity_difference_point = (pos: int, point: int, t: int, what: str):
    unit = quantity_point_unit(t)
    fatal(pos, "cannot {what}: one side is a temperature point (a reading on the {unit} scale) and the other a difference between two. Write the difference as a subtraction of two points (`let rise = 25{unit} - 5{unit}`) or in kelvin (`5K`); a literal added to or taken from a point is read as a difference (`t + 5{unit}`)")

quantity_point_scaled = (pos: int, point: int, t: int):
    p = quantity_operand_text(point, "t")
    unit = quantity_point_unit(t)
    fatal(pos, "cannot scale a temperature point: `{p}` is a reading on the {unit} scale, and scaling one depends on where the scale's zero sits (2 × 20°C is 40°C, but 2 × 68°F, the same temperature, is 136°F). Scale a difference instead (`({p} - ref)*2`); for an average write `mean[t1 t2]`; `{p}/K` is its reading in kelvins")

# Products and quotients with an offset temperature: a plain number scales a difference;
# another quantity combines with a difference's or a unit's own size (J/°C); a temperature
# over a temperature unit counts in that unit (t/°C is t's reading in Celsius). A point
# itself is not scaled: only a unit written by name makes one from a number (c*°C).
quantity_offset_product = (n: int, a: int, b: int, op: Tok, expected: int, a_name: bool = false, b_name: bool = false) -> int:
    pos = nodes[n].pos
    ta = ntype(a)
    tb = ntype(b)
    aq = is_quantity(ta)
    bq = is_quantity(tb)
    if op == .slash and aq and bq and quantity_dimension(ta) == quantity_dimension(tb) and not quantity_is_delta(tb) and (not quantity_point(tb) or quantity_is_unit(b, b_name)):
        u = quantity_units[quantity_tags[quantity_tag(tb)].origin]
        top = a
        if not quantity_is_delta(ta) and u.onum == 0: quantity_retag(a, 0)
        else if not quantity_is_delta(ta):
            quantity_retag(a, 0)
            top = bc_bin(.minus, a, quantity_offset_constant(u.onum, u.oden, quantity_dimension(ta), ta, pos), pos)
            top = quantity_internal_check(top)
        else: quantity_retag(a, 0)
        return quantity_become(n, quantity_operation(.slash, top, quantity_delta_reading(b), pos), 0)
    if quantity_point(ta) and not quantity_is_unit(a, a_name): quantity_point_scaled(pos, a, ta)
    if quantity_point(tb) and not quantity_is_unit(b, b_name): quantity_point_scaled(pos, b, tb)
    if aq and not bq: return quantity_become(n, quantity_scaled(a, b, op, true, pos), quantity_tag(ta))
    if bq and not aq and op == .star: return quantity_become(n, quantity_scaled(b, a, op, false, pos), quantity_tag(tb))
    return quantity_become(n, quantity_operation(op, quantity_delta_reading(a), quantity_delta_reading(b), pos), 0)

quantity_arithmetic = (n: int, name: int, a: int, b: int, expected: int) -> int:
    a_name = quantity_left_literal
    b_name = quantity_right_literal
    quantity_left_literal = false
    quantity_right_literal = false
    ta = ntype(a)
    tb = ntype(b)
    if quantity_tag(ta) == 0 and quantity_tag(tb) == 0: return quantity_arithmetic_plain(n, name, a, b, expected)
    if name == intern("__dewy_divide"):
        if quantity_offset_tagged(ta) or quantity_offset_tagged(tb): return quantity_offset_product(n, a, b, .slash, expected, a_name, b_name)
        keep = if not is_quantity(tb): quantity_tag(ta) else: 0
        quantity_retag(a, 0)
        quantity_retag(b, 0)
        t = quantity_arithmetic_plain(n, name, a, b, expected)
        if not is_quantity(t): return t
        return quantity_retag(n, keep)
    if quantity_point(ta) and not quantity_is_unit(a, a_name): quantity_point_scaled(nodes[n].pos, a, ta)
    reading = quantity_delta_reading(a)
    quantity_retag(b, 0)
    quantity_arithmetic_plain(n, name, reading, b, expected)

quantity_unary_literal = false  # the operand of the unary being checked is written as a literal

quantity_unary = (n: int, expected: int) -> int:
    literal = quantity_unary_literal
    quantity_unary_literal = false
    a = int(nodes[n].a)
    t = ntype(a)
    tag = quantity_tag(t)
    if tag == 0: return quantity_unary_plain(n, expected)
    q = quantity_tags[tag]
    op = nodes[n].op as Tok
    if op == .minus and not q.delta and q.origin != 0:
        # (negating a reading: -(20°C) is -20°C; a point's value is not negated)
        if not literal and quantity_point(t): quantity_point_scaled(nodes[n].pos, a, t)
        u = quantity_units[q.origin]
        pos = nodes[n].pos
        quantity_retag(a, 0)
        twice = quantity_offset_constant(2 * u.onum, u.oden, quantity_dimension(t), t, pos)
        return quantity_become(n, quantity_operation(.minus, twice, a, pos), tag)
    quantity_retag(a, 0)
    quantity_unary_plain(n, expected)
    quantity_retag(n, tag)

# `const °C = __offset_unit("°C" K 5463K/20)`: a unit of the given size whose zero sits at
# origin; its value, one degree, is origin + size.
quantity_offset_unit = (n: int, sym: str, size: int, origin: int) -> int:
    pos = nodes[n].pos
    ss = quantity_constant_scale(size)
    os = quantity_constant_scale(origin)
    if ss < 0 or os < 0: fatal(pos, "an offset unit needs an exact constant size and origin")
    dim = quantity_dimension(ntype(size))
    if dim == 0 or quantity_dimension(ntype(origin)) != dim: quantity_mismatch(pos, ntype(size), ntype(origin))
    s = quantity_scales[ss]
    o = quantity_scales[os]
    u = intern_quantity_unit(sym, s.numerator, s.denominator, o.numerator, o.denominator)
    g = quantity_gcd(s.denominator, o.denominator)
    den = s.denominator / g * o.denominator
    num = s.numerator * (den / s.denominator) + o.numerator * (den / o.denominator)
    quantity_constant(n, num, den, dim, 0)
    quantity_retag(n, intern_quantity_tag(u, u, false))

# ---------------- x as unit ----------------
# (the written unit of `x as km/h`: names of constants joined by * / ^)
quantity_unit_text = (e: int) -> str:
    k = nodes[e].kind
    if k == .tname or k == .ident: return name_of(int(nodes[e].name))
    if k == .tquantity:
        op = nodes[e].op as Tok
        if op == .caret:
            p = int(nodes[e].b)
            if nodes[p].kind == .int_lit: return "{quantity_unit_text(int(nodes[e].a))}^{nodes[p].ival}"
            return ""
        left = quantity_unit_text(int(nodes[e].a))
        right = quantity_unit_text(int(nodes[e].b))
        if left == "" or right == "": return ""
        if op == .slash: return "{left}/{right}"
        return "{left}*{right}"
    ""

# (does the type syntax e name unit values, as in `x as km` or `x as (km/hour)`?)
quantity_unit_syntax = (e: int) -> bool:
    k = nodes[e].kind
    if k == .tname:
        s = lookup(int(nodes[e].name))
        if s < 0: return false
        sk = syms[s].kind
        return sk == .global or sk == .const_ or sk == .local
    if k == .tquantity:
        if nodes[e].op == i32(int(Tok.caret)): return quantity_unit_syntax(int(nodes[e].a))
        return quantity_unit_syntax(int(nodes[e].a)) and quantity_unit_syntax(int(nodes[e].b))
    false

# (the unit syntax e as an expression)
quantity_unit_expr = (e: int) -> int:
    pos = nodes[e].pos
    if nodes[e].kind == .tname:
        x = mk(.ident, pos)
        nodes[x].name = nodes[e].name
        return x
    op = nodes[e].op as Tok
    if op == .caret: return bc_call("__dewy_power", [quantity_unit_expr(int(nodes[e].a)), int(nodes[e].b)], pos)
    if op == .slash and dewy_at(pos): return bc_call("__dewy_divide", [quantity_unit_expr(int(nodes[e].a)), quantity_unit_expr(int(nodes[e].b))], pos)
    bc_bin(op, quantity_unit_expr(int(nodes[e].a)), quantity_unit_expr(int(nodes[e].b)), pos)

# `x as unit`: the same quantity, shown in unit. A temperature keeps the scale it was
# written in, so (20°C as °F) shows 68°F and still reads as a 20 K difference.
quantity_as_unit = (n: int) -> int:
    pos = nodes[n].pos
    text = quantity_unit_text(int(nodes[n].b))
    unit = quantity_unit_expr(int(nodes[n].b))
    check_expr(unit, 0)
    unit = last_checked
    ut = ntype(unit)
    if not is_quantity(ut): fatal(nodes[unit].pos, "`as` converts to a unit of measure here, but {text} is a {dt(ut)}")
    scale = quantity_constant_scale(unit)
    if scale < 0: fatal(nodes[unit].pos, "`as` converts to a constant unit, such as `km` or `km/hour`")
    check_expr(int(nodes[n].a), 0)
    x = last_checked
    xt = ntype(x)
    if not is_quantity(xt): fatal(pos, "{dt(xt)} has no unit to convert; multiply by a unit to give it one, as in `3*{text}`")
    if quantity_dimension(xt) != quantity_dimension(ut): fatal(pos, "cannot convert a {dimension_str(quantity_dimension(xt))} to {text}, a unit of {dimension_str(quantity_dimension(ut))}")
    uq = quantity_tags[quantity_tag(ut)]
    shown = 0
    if uq.origin != 0 and uq.display == uq.origin: shown = uq.origin
    else:
        q = quantity_scales[scale]
        if q.numerator == 0: fatal(nodes[unit].pos, "a unit cannot be zero")
        shown = intern_quantity_unit(text, q.numerator, q.denominator, 0, 1)
    xq = quantity_tags[quantity_tag(xt)]
    tag = if xq.delta: intern_quantity_tag(shown, 0, true) else: intern_quantity_tag(shown, xq.origin, false)
    nodes[n] = nodes[x]
    last_checked = n
    quantity_retag(n, tag)

# ---------------- display ----------------
# A quantity prints in a unit chosen for its kind: each base dimension and each named
# derived unit (N, J, W, ...) has a list of candidate units, and the value's magnitude picks
# one at runtime (1500.0 m prints as 1.5 km, 3/10 s as 300 ms). Other dimensions print in
# canonical units composed from a named unit and base units (m/s, N*s, V*s^(1/2)).
# `x as unit` and offset scales print in their own unit.

struct QuantityLadder:
    units: int[]
    base: int

quantity_si_prefixes: str[] = ["n", "µ", "m", "", "k", "M", "G"]

# (sym with SI prefixes from n to G, sym itself worth one canonical unit)
quantity_si_ladder = (sym: str) -> QuantityLadder:
    units: int[]
    loop i in [0..7):
        num = 1
        den = 1
        loop j in [i..3): den *= 1000
        loop j in [3..i): num *= 1000
        units.push(intern_quantity_unit(quantity_si_prefixes[i] + sym, num, den, 0, 1))
    QuantityLadder(units, 3)

quantity_one_unit = (sym: str, num: int, den: int) -> QuantityLadder:
    QuantityLadder([intern_quantity_unit(sym, num, den, 0, 1)], 0)

# base symbols, in the order composite units are written (kg*m^2/s^2)
quantity_base_order: int[] = [2, 1, 0, 3, 4, 5, 6, 7]
quantity_base_symbols: str[] = ["s", "m", "kg", "A", "K", "mol", "cd", "turn"]
quantity_named_symbols: str[] = ["Hz", "N", "Pa", "J", "W", "C", "V", "Ω"]
# powers of Time, Length, Mass, Current for each named unit
quantity_named_powers: int[][] = [[-1, 0, 0, 0], [-2, 1, 1, 0], [-2, -1, 1, 0], [-2, 2, 1, 0], [-3, 2, 1, 0], [1, 0, 0, 1], [-3, 2, 1, -1], [-3, 2, 1, -2]]

quantity_named_dimension = (i: int) -> int:
    powers = fill(0, 8)
    loop j in [0..4): powers[j] = quantity_named_powers[i][j] * QUANTITY_POWER_DEN
    intern_dimension(powers)

quantity_power_suffix = (stored: int) -> str:
    if stored == QUANTITY_POWER_DEN: return ""
    shown = quantity_power_text(stored)
    if find_byte(shown, '/') >= 0 or stored < 0: return "^({shown})"
    "^{shown}"

# (named, or "", times base units with the stored powers; "" when nothing is left)
quantity_composite_text = (named: str, powers: int[]) -> str:
    top = named
    bottom = ""
    loop i in quantity_base_order:
        p = powers[i]
        # (a fractional power of time is one of frequency: V/Hz^(1/2), not V*s^(1/2))
        if i == 0 and p % QUANTITY_POWER_DEN != 0: p = -p
        sym = if i == 0 and p != powers[i]: "Hz" else: quantity_base_symbols[i]
        if p > 0:
            if top != "": top += "*"
            top += sym + quantity_power_suffix(p)
        else if p < 0: bottom += "/" + sym + quantity_power_suffix(-p)
    if top == "" and bottom == "": return ""
    if top == "": top = "1"
    top + bottom

quantity_factor_count = (powers: int[]) -> int:
    count = 0
    loop p in powers:
        if p != 0: count += 1
    count

quantity_ladder = (dim: int) -> QuantityLadder:
    powers = quantity_dimensions[dim]
    if dim == base_dimension(0):
        units: int[]
        loop item in [("ns", 1, 1000000000), ("µs", 1, 1000000), ("ms", 1, 1000), ("s", 1, 1), ("min", 60, 1), ("h", 3600, 1)]:
            units.push(intern_quantity_unit(item.0, item.1, item.2, 0, 1))
        return QuantityLadder(units, 3)
    if dim == base_dimension(1):
        ladder = quantity_si_ladder("m")
        return QuantityLadder(ladder.units[0..5), 3)
    if dim == base_dimension(2):
        units: int[]
        loop item in [("mg", 1, 1000000), ("g", 1, 1000), ("kg", 1, 1)]:
            units.push(intern_quantity_unit(item.0, item.1, item.2, 0, 1))
        return QuantityLadder(units, 2)
    if dim == base_dimension(7): return quantity_one_unit("°", 1, 360)
    if dim == base_dimension(4): return quantity_one_unit("K", 1, 1)
    if dim == base_dimension(6): return quantity_one_unit("cd", 1, 1)
    if dim == base_dimension(3): return quantity_si_ladder("A")
    if dim == base_dimension(5): return quantity_si_ladder("mol")
    loop i in [0..quantity_named_symbols.len()):
        if quantity_named_dimension(i) == dim: return quantity_si_ladder(quantity_named_symbols[i])
    # Fewest factors: base units alone, or one named unit times base units.
    best = quantity_composite_text("", powers)
    cost = quantity_factor_count(powers)
    loop i in [0..quantity_named_symbols.len()):
        rest = quantity_dimensions[combine_dimensions(dim, quantity_named_dimension(i), -1, 0)]
        if quantity_factor_count(rest) + 1 < cost:
            cost = quantity_factor_count(rest) + 1
            best = quantity_composite_text(quantity_named_symbols[i], rest)
    # (angles in degrees, as alone: 90°/s, not 1/4 turn/s)
    if powers[7] == QUANTITY_POWER_DEN or powers[7] == -QUANTITY_POWER_DEN:
        rest = fill(0, 8)
        loop i in [0..7): rest[i] = powers[i]
        if powers[7] > 0: return quantity_one_unit(quantity_composite_text("°", rest), 1, 360)
        return quantity_one_unit(quantity_composite_text("", rest) + "/°", 360, 1)
    quantity_one_unit(best, 1, 1)

# (the text after the number: " km", but "°C" and "°" attach)
quantity_shown_symbol = (sym: str) -> str:
    if starts_with(sym, "°"): return sym
    " " + sym

# The text of the checked quantity x, as a checked string expression; 0 for a number
# Dewy cannot divide exactly or in floating point (it then prints as a plain number).
quantity_display = (x: int) -> int:
    t = prune(ntype(x))
    base = prune(quantity_base(t))
    exact = is_int(base) or base == T_MATH_INT or bundled_rational_type(base) or bundled_bigint_type(base)
    if not exact and not is_float(base): return 0
    pos = nodes[x].pos
    q = quantity_tags[quantity_tag(t)]
    ladder = QuantityLadder([], 0)
    shown = if q.display != 0: q.display else: q.origin
    if shown != 0: ladder = QuantityLadder([shown], 0)
    else: ladder = quantity_ladder(quantity_dimension(t))
    onum = 0
    oden = 1
    if shown != 0 and not q.delta:
        onum = quantity_units[shown].onum
        oden = quantity_units[shown].oden
    ensure_bundled_import("rational.dewy", "$dewy_rational", pos)
    syms: int[]
    nums: int[]
    dens: int[]
    loop u in ladder.units:
        syms.push(bc_str(quantity_shown_symbol(quantity_units[u].sym), pos))
        nums.push(bc_int(quantity_units[u].num, pos))
        dens.push(bc_int(quantity_units[u].den, pos))
    number = quantity_number(x)
    add_flag(number, NF_CHECKED)
    fname = "_quantity_exact"
    offset = 0
    if exact:
        if not bundled_rational_type(base):
            r = mk(.call, pos)
            nodes[r].a = i32(bc_field(bc_ident("$dewy_rational", pos), "rational", pos))
            set_list(r, [number])
            number = r
        offset = mk(.call, pos)
        nodes[offset].a = i32(bc_field(bc_ident("$dewy_rational", pos), "rational", pos))
        set_list(offset, [bc_int(onum, pos), bc_int(oden, pos)])
    else:
        if base == T_F32: fname = "_quantity_float32"
        else:
            fname = "_quantity_float"
            number = quantity_float(number)
        offset = mk(.float_lit, pos)
        scaled = quantity_scale(onum * quantity_units[ladder.units[0]].den, oden)
        nodes[offset].fval = f64(quantity_scales[scaled].numerator) / f64(quantity_scales[scaled].denominator)
    c = mk(.call, pos)
    nodes[c].a = i32(bc_field(bc_ident("$dewy_rational", pos), fname, pos))
    set_list(c, [number, quantity_array(syms, T_STR, pos), quantity_array(nums, T_INT, pos), quantity_array(dens, T_INT, pos), bc_int(ladder.base, pos), offset])
    check_expr(c, T_STR)
    last_checked

quantity_array = (items: int[], elem: int, pos: int) -> int:
    a = mk(.array, pos)
    set_list(a, items)
    check_expr(a, mk_array(elem))
    last_checked

task_sleep_type = () -> int:
    mk_union([T_VOID, int(syms[universe[intern("Canceled")]].ref)])

task_duration_value = (n: int, a0: int) -> int:
    t = check_expr(a0, 0)
    a = last_checked
    add_flag(a, NF_CHECKED)
    if not is_quantity(t) or quantity_dimension(t) != base_dimension(0): fatal(nodes[a].pos, "a deadline takes a time, such as within(2s @get(url))")
    number = quantity_number(a)
    add_flag(number, NF_CHECKED)
    base = quantity_base(t)
    ns = 0
    if bundled_rational_type(base):
        ns = mk(.call, nodes[n].pos)
        rational_helper_call(ns, "_whole_nanoseconds", number, T_INT)
    else if is_int(base):
        whole = mk(.conv, nodes[a].pos)
        nodes[whole].a = i32(number)
        nodes[whole].aux = i32(int(CV.int_))
        nodes[whole].type = i32(T_INT)
        add_flag(whole, NF_CHECKED)
        ns = bc_bin(.star, whole, bc_int(1000000000, nodes[a].pos), nodes[a].pos)
    else if is_float(base): ns = bc_call("__task_seconds", [quantity_float(number)], nodes[n].pos)
    else: fatal(nodes[a].pos, "unsupported time representation for a deadline")
    nodes[n] = nodes[ns]
    check_expr(n, T_INT)

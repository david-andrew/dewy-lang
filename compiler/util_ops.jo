use 'util.jo'
use 'intern.dewy'

# Frozen bootstrap twin of util_ops.dewy.
util_intern = (s: str) -> int: util_intern_sub(s, 0, len(s))

# Intern s[start..start + n] without allocating unless the name is new (an existing name is
# found by its bytes alone, s not passed beside the table: no reference counting)
util_intern_sub = (s: str, start: int, n: int) -> int:
    p = data(s) + start
    h = hash_bytes(p, n)
    id = name_find(names, name_hash, name_tab, p, n, h)
    if id >= 0: return id
    util_intern_new(s, start, n, h)

# (a new name: cut from s unless it is all of s)
util_intern_new = (s: str, start: int, n: int, h: int) -> int:
    if start == 0 and n == len(s): return name_add(names, name_hash, name_tab, s, h)
    name_add(names, name_hash, name_tab, s[start..start + n), h)

util_name_of = (id: int) -> str: names[id]

# Whether s is an interned name already, without interning it
util_name_known = (s: str) -> bool: name_find(names, name_hash, name_tab, data(s), len(s), hash_bytes(data(s), len(s))) >= 0

# position encoding: file index in the high bits, byte offset in the low 40 bits
util_mkpos = (file: int, off: int) -> int: (file << 40) | off
util_pos_file = (p: int) -> int: p >> 40
util_pos_off = (p: int) -> int: p & 0xFFFFFFFFFF

file_in_lib_cache: i8[]
file_in_lib_p: *i8 = null
file_in_lib_n = 0
file_in_lib_root = ""
file_in_lib_root_p: *u8 = null

util_file_in_lib_slow = (f: int) -> bool:
    if len(lib_root) == 0 or f < 0 or f >= files.len(): return false
    if data(file_in_lib_root) != data(lib_root) and file_in_lib_root != lib_root:
        file_in_lib_root = lib_root
        file_in_lib_cache = []
        file_in_lib_p = null
        file_in_lib_n = 0
    file_in_lib_root_p = data(lib_root)
    if f < file_in_lib_cache.len():
        c = data(file_in_lib_cache)[f]
        if c != 0: return c == 2
    else:
        file_in_lib_cache.resize(f + 64)
        file_in_lib_p = data(file_in_lib_cache)
        file_in_lib_n = file_in_lib_cache.len()
    in_lib = starts_with(files[f].path, lib_root)
    file_in_lib_p[f] = if in_lib: i8(2) else: i8(1)
    in_lib

util_file_in_lib = (f: int) -> bool:
    if f >= 0 and f < file_in_lib_n and data(lib_root) == file_in_lib_root_p:
        c = file_in_lib_p[f]
        if c != 0: return c == 2
    util_file_in_lib_slow(f)

util_pos_in_lib = (p: int) -> bool:
    if p <= 0: return false
    util_file_in_lib(util_pos_file(p))

$runtime_checks

from p"@lib/core/rt.jo" import (__str_from_bytes)
from p"ast.jo" import (kid nkids nodes)
from p"check.jo" import (LF_ADDR LF_ALIAS LF_ASSIGNED LF_BYREF LF_CAPTURED LF_MUTPARAM LF_PARAM check_struct_fields locals sanitize)
from p"checks_thin_expr.dewy" import (is_gpu_buffer)
from p"expr.jo" import (ntype)
from p"glsl.jo" import (gl_decls gl_done_structs gl_float gl_out gl_param_copies gl_temps)
from p"glsl_stmts.dewy" import (gl_expr gl_read gl_stmt)
from p"glsl_ops.dewy" import (gl_err gl_first gl_wrap gl_wrapped ind sl_type)
from p"type_ops.dewy" import (dt fixed_len is_lib_texture layout tsd)
from p"types.jo" import (T_I32 T_MAT4 fields is_vec prune structs tsize types)
from p"util.jo" import (name_of)


GlslEmitWord:type=int64<overflow='wrap'>
gl_elem_type=(t:GlslEmitWord pos:GlslEmitWord):>string=>$unsafe {
    if types.ptr[prune(t)].kind not=? 'fixed' {return gl_type(t pos)}
    let nm="SA_{prune(t)}"
    if gl_first(nm) {
        let inner=gl_type(t pos)
        gl_decls.push("struct {nm} \{\n    {inner} v;\n};\n")
    }
    nm
}
gl_type=(t0:GlslEmitWord pos:GlslEmitWord):>string=>$unsafe {
    let t=sl_type(t0)
    let k=types.ptr[t].kind
    if k =? 'float_' {return "float"}
    if k =? 'int_' {return "int"}
    if k =? 'bool_' {return "bool"}
    if k =? 'vec' {
        if t =? T_MAT4 {return "mat4"}
        if types.ptr[t].sign {return "ivec{types.ptr[t].bits}"}
        return "vec{types.ptr[t].bits}"
    }
    if k =? 'struct_' {
        let si=GlslEmitWord(types.ptr[t].st)
        if is_lib_texture(si) {return "sampler2D"}
        if is_gpu_buffer(t) {
            gl_gbuf_decls()
            return "S_GB"
        }
        gl_struct(t pos)
        return "S_{gl_name(structs.ptr[si].name)}_{si}"
    }
    if k =? 'void_' {return "void"}
    if k =? 'fixed' {return "{gl_elem_type(GlslEmitWord(types.ptr[t].elem) pos)}[{fixed_len(t)}]"}
    gl_err(pos "type {dt(t)} cannot be used in shaders (use numbers, bools, vectors, matrices, structs and Texture)")
    ""
}
gl_struct=(t:GlslEmitWord pos:GlslEmitWord):>void=>$unsafe {
    let si=GlslEmitWord(types.ptr[t].st)
    if gl_done_structs.get(si) not=? none {return}
    gl_done_structs[si]=true
    check_struct_fields(si)
    let s="struct S_{gl_name(structs.ptr[si].name)}_{si} \{\n"
    loop i in [0..GlslEmitWord(structs.ptr[si].nfields)) {
        let f=GlslEmitWord(structs.ptr[si].fields) + i
        s="{s}    {gl_type(GlslEmitWord(fields.ptr[f].type) pos)} {name_of(GlslEmitWord(fields.ptr[f].name))}_;\n"
    }
    gl_decls.push("{s}};\n")
}
# a name GLSL accepts as part of an identifier: no "__" anywhere (reserved in GLSL ES), and none
# at the ends (the generated names put "_" around it)
gl_name=(s:string):>string=>{
    let b:array<uint8>=[]
    loop c in (sanitize(s) as array<uint8>) {
        if c =? b'_' and (b.length =? 0 or b[b.length - 1] =? b'_') {continue}
        b.push(c)
    }
    if b.length >? 0 and b[b.length - 1] =? b'_' {b.pop();}
    if b.length =? 0 {return "a"}
    __str_from_bytes(b)
}
# Dewy introduces a local value copy for each ordinary parameter. A read-only
# copy can use the parameter directly. This is required for uniform records
# containing samplers, which GLSL cannot assign into a local variable.
gl_param_copy=(s:GlslEmitWord):>bool=>$unsafe {
    let l=GlslEmitWord(nodes.ptr[s].sym)
    let value=GlslEmitWord(nodes.ptr[s].b)
    if value =? 0 or nodes.ptr[value].kind not=? 'ident' or nodes.ptr[value].aux not=? int32(1) {return false}
    let forbidden=LF_ASSIGNED | LF_ADDR | LF_BYREF | LF_CAPTURED | LF_MUTPARAM | LF_ALIAS
    if GlslEmitWord(locals.ptr[l].flags) & forbidden not=? 0 {return false}
    let source=GlslEmitWord(nodes.ptr[value].sym)
    if GlslEmitWord(locals.ptr[source].flags) & (LF_PARAM | LF_MUTPARAM) not=? LF_PARAM {return false}
    if prune(GlslEmitWord(locals.ptr[l].type)) not=? prune(GlslEmitWord(locals.ptr[source].type)) {return false}
    gl_param_copies[l]=source
    true
}
gl_block=(b:GlslEmitWord depth:GlslEmitWord ret_value:bool):>void=>$unsafe {
    let n=nkids(b)
    loop i in [0..n) {
        let s=kid(b i)
        if i =? n - 1 and ret_value and nodes.ptr[b].aux not=? 0 {
            gl_out.push("{ind(depth)}return {gl_expr(GlslEmitWord(nodes.ptr[s].a))};\n")
            continue
        }
        gl_stmt(s depth)
    }
}
gl_target=(n:GlslEmitWord pre:string):>string=>$unsafe {
    let k=nodes.ptr[n].kind
    if k =? 'index' {
        let base=gl_target(GlslEmitWord(nodes.ptr[n].a) pre)
        let ix=GlslEmitWord(nodes.ptr[n].b)
        let v=""
        if gl_wrapped(ntype(GlslEmitWord(nodes.ptr[n].a))) {v=".v"}
        if nodes.ptr[ix].kind =? 'int_lit' {return "{base}[{gl_expr(ix)}]{v}"}
        # (a variable too: the right side may change it)
        let x=gl_expr(ix)
        gl_temps += 1
        let t=gl_temps
        gl_out.push("{pre}int sl_t{t} = {x};\n")
        return "{base}[sl_t{t}]{v}"
    }
    if k =? 'field' and nodes.ptr[n].aux =? -4 {return "{gl_target(GlslEmitWord(nodes.ptr[n].a) pre)}.{name_of(GlslEmitWord(nodes.ptr[n].name))}"}
    if k =? 'field' and nodes.ptr[n].aux >=? 0 {return "{gl_target(GlslEmitWord(nodes.ptr[n].a) pre)}.{name_of(GlslEmitWord(nodes.ptr[n].name))}_"}
    gl_expr(n)
}
gl_stmt_if=(e:GlslEmitWord depth:GlslEmitWord):>void=>$unsafe {
    if nodes.ptr[e].kind not=? 'if_' {gl_err(nodes.ptr[e].pos "match is not supported in shaders")}
    let pre=ind(depth)
    gl_out.push("{pre}if ({gl_expr(GlslEmitWord(nodes.ptr[e].a))}) \{\n")
    gl_block(GlslEmitWord(nodes.ptr[e].b) depth + 1 false)
    if nodes.ptr[e].c not=? 0 {
        gl_out.push("{pre}} else \{\n")
        gl_block(GlslEmitWord(nodes.ptr[e].c) depth + 1 false)
    }
    gl_out.push("{pre}}\n")
}
gl_zero=(t0:GlslEmitWord pos:GlslEmitWord):>string=>$unsafe {
    let t=sl_type(t0)
    let k=types.ptr[t].kind
    if k =? 'float_' {return "0.0"}
    if k =? 'int_' {return "0"}
    if k =? 'bool_' {return "false"}
    if k =? 'vec' {
        if t =? T_MAT4 {return "mat4(0.0)"}
        return "{gl_type(t pos)}(0)"
    }
    if k =? 'struct_' {
        let si=GlslEmitWord(types.ptr[t].st)
        let parts:array<string>=[]
        loop i in [0..GlslEmitWord(structs.ptr[si].nfields)) {parts.push(gl_zero(GlslEmitWord(fields.ptr[GlslEmitWord(structs.ptr[si].fields) + i].type) pos))}
        return "{gl_type(t pos)}({join(parts ", ")})"
    }
    if k =? 'fixed' {
        let z=gl_wrap(gl_zero(GlslEmitWord(types.ptr[t].elem) pos) GlslEmitWord(types.ptr[t].elem) pos)
        let parts:array<string>=[]
        loop i in [0..fixed_len(t)) {parts.push(z)}
        return "{gl_type(t pos)}({join(parts ", ")})"
    }
    gl_err(pos "cannot zero-initialize {dt(t)} in a shader")
    ""
}
# the name of a helper dividing signed integers (or integer vectors, by a vector or a number)
# that by -1 divides by 1 and negates: the smallest integer / -1 is itself, as on the CPU
gl_sdiv=(ta:GlslEmitWord tb:GlslEmitWord):>string=>$unsafe {
    if gl_first("sdiv") {gl_decls.push("int sl_sdiv(int a, int b) \{\n    int q = a / (b == -1 ? 1 : b);\n    return b == -1 ? int(-uint(a)) : q;\n}\n")}
    if types.ptr[ta].kind =? 'int_' {return "sl_sdiv"}
    let n=GlslEmitWord(types.ptr[ta].bits)
    let sc=tb not=? 0 and not is_vec(tb)
    let nm="sl_sdiv{n}"
    let bty="ivec{n}"
    if sc {
        nm="sl_sdiv{n}s"
        bty="int"
    }
    if gl_first(nm) {
        let sw=["x" "y" "z" "w"]
        let cs:array<string>=[]
        loop j in [0..n) {
            if sc {cs.push("sl_sdiv(a.{sw[j]}, b)")} else {cs.push("sl_sdiv(a.{sw[j]}, b.{sw[j]})")}
        }
        gl_decls.push("ivec{n} {nm}(ivec{n} a, {bty} b) \{\n    return ivec{n}({join(cs ", ")});\n}\n")
    }
    nm
}
# the name of a helper for Dewy's floor `//` (or `%`) of signed integers: the truncating quotient
# (sl_sdiv's) one lower, and the remainder plus the divisor, where the remainder's sign is not the divisor's
gl_floor=(percent:bool):>string=>{
    gl_sdiv(T_I32 0);
    if percent {
        if gl_first("fmod") {gl_decls.push("int sl_fmod(int a, int b) \{\n    int r = int(uint(a) - uint(sl_sdiv(a, b)) * uint(b));\n    return (r != 0 && (r ^ b) < 0) ? int(uint(r) + uint(b)) : r;\n}\n")}
        return "sl_fmod"
    }
    if gl_first("fdiv") {gl_decls.push("int sl_fdiv(int a, int b) \{\n    int q = sl_sdiv(a, b);\n    int r = int(uint(a) - uint(q) * uint(b));\n    return (r != 0 && (r ^ b) < 0) ? q - 1 : q;\n}\n")}
    "sl_fdiv"
}
# (the body of sl_abs: x below 0 negated through unsigned numbers, which wrap; by component)
sl_abs_body=(t:GlslEmitWord un:string):>string=>$unsafe {
    if not is_vec(t) {return "x < 0 ? -uint(x) : uint(x)"}
    let sw=["x" "y" "z" "w"]
    let cs:array<string>=[]
    loop j in [0..GlslEmitWord(types.ptr[t].bits)) {cs.push("x.{sw[j]} < 0 ? -uint(x.{sw[j]}) : uint(x.{sw[j]})")}
    "{un}({join(cs ", ")})"
}
gl_shift_decls=():>void=>{
    if not gl_first("shift") {return}
    gl_decls.push("int sl_shl(int x, int c) \{\n    c &= 63;\n    return c >= 32 ? 0 : x << c;\n}\n")
    gl_decls.push("int sl_shr(int x, int c) \{\n    c &= 63;\n    return c >= 32 ? x >> 31 : x >> c;\n}\n")
    gl_decls.push("int sl_shru(int x, int c) \{\n    c &= 63;\n    return c >= 32 ? 0 : int(uint(x) >> uint(c));\n}\n")
}
# x (32 bits) wrapped to the range of a narrower integer type t
gl_narrow=(x:string t0:GlslEmitWord):>string=>$unsafe {
    let t=sl_type(t0)
    if types.ptr[t].kind not=? 'int_' {return x}
    let bits=GlslEmitWord(types.ptr[t].bits)
    if bits >=? 32 {return x}
    if not types.ptr[t].sign {return "({x} & {(GlslEmitWord(1) << bits) - 1})"}
    "(({x} << {32 - bits}) >> {32 - bits})"
}
# float x to integer type t, as on the CPU: toward zero, saturating at t's range (32 bits at
# most), NaN to 0
gl_float_to_int=(x:string t0:GlslEmitWord):>string=>$unsafe {
    let t=sl_type(t0)
    let bits=GlslEmitWord(types.ptr[t].bits)
    if bits >? 32 {bits=32}
    let sg=types.ptr[t].sign
    let lo:GlslEmitWord=0
    let hi=(GlslEmitWord(1) << bits) - 1
    if sg {
        lo=-(GlslEmitWord(1) << (bits - 1))
        hi=(GlslEmitWord(1) << (bits - 1)) - 1
    }
    if gl_first("f2i") {
        # (2^31 - 1 and 2^32 - 1 are not floats: clamped to the largest float below, the top tested apart)
        gl_decls.push("int sl_f2i(float x, float lo, float top, float hi1, int him) \{\n    if (isnan(x)) return 0;\n    if (x >= hi1) return him;\n    return int(clamp(x, lo, top));\n}\n")
        gl_decls.push("int sl_f2u(float x, float top) \{\n    if (isnan(x)) return 0;\n    if (x >= 4294967296.0) return -1;\n    return int(uint(clamp(x, 0.0, top)));\n}\n")
    }
    if bits =? 32 and not sg {return "sl_f2u({x}, 4294967040.0)"}
    let top=float64(hi)
    if bits =? 32 {top=2147483520.0}
    "sl_f2i({x}, {gl_float(float64(lo))}, {gl_float(top)}, {gl_float(float64(hi) + 1.0)}, {hi})"
}
# ---------------- GPU buffers ----------------
gl_gbuf_decls=():>void=>{
    if not gl_first("gbuf") {return}
    gl_decls.push("struct S_GB \{\n    highp isampler2D t_;\n    int n_;\n};\n")
    gl_decls.push("uint gb_w(highp isampler2D t, int i) \{\n    return uint(texelFetch(t, ivec2((i >> 2) & 1023, i >> 12), 0)[i & 3]);\n}\n")
    # (bits of the word holding byte a, from bit 8 * (a & 3); sign-extended if sgn)
    gl_decls.push("int gb_sub(highp isampler2D t, int a, int bits, bool sgn) \{\n    uint w = gb_w(t, a >> 2) >> uint((a & 3) * 8);\n    int sh = 32 - bits;\n    if (sgn) return int(w << uint(sh)) >> sh;\n    return int((w << uint(sh)) >> uint(sh));\n}\n")
    # (an f64 from its two words, rounded to an f32 as compiler/spirv.jo does)
    gl_decls.push("float gb_f64(uint lo, uint hi) \{\n    uint e = (hi >> 20) & 0x7FFu;\n    uint m = ((hi & 0xFFFFFu) << 3) | (lo >> 29);\n    uint bits = (((e - 896u) << 23) | m) + ((lo >> 28) & 1u);\n    if (e >= 1151u || bits >= 0x7F800000u) bits = 0x7F800000u;\n    if (e <= 896u) bits = 0u;\n    if (e == 0x7FFu && (m | lo) != 0u) bits = 0x7FC00000u;\n    return uintBitsToFloat(bits | (hi & 0x80000000u));\n}\n")
}
# the name of a function reading element i of a buffer of t (made once per type and stage); past
# either end it reads the nearest element, as with Vulkan
gl_gbuf_reader=(t:GlslEmitWord pos:GlslEmitWord):>string=>{
    let nm="gbr_{prune(t)}"
    if not gl_first(nm) {return nm}
    layout(t)
    let ty=gl_type(t pos)
    gl_decls.push("{ty} {nm}(S_GB b, int i) \{\n    int o = clamp(i, 0, max(b.n_ - 1, 0)) * {tsize(t)};\n    return {gl_read(t "o" 0 pos)};\n}\n")
    nm
}
# ---------------- stage wrappers ----------------
gl_struct_fields=(t:GlslEmitWord):>array<[string int64]>=>$unsafe {
    let si=GlslEmitWord(types.ptr[prune(t)].st)
    check_struct_fields(si)
    let out:array<[string int64]>=[]
    loop i in [0..GlslEmitWord(structs.ptr[si].nfields)) {
        let f=GlslEmitWord(structs.ptr[si].fields) + i
        out.push([name_of(GlslEmitWord(fields.ptr[f].name)) GlslEmitWord(fields.ptr[f].type)])
    }
    out
}
gl_attrib_comps=(t:GlslEmitWord pos:GlslEmitWord):>int64=>$unsafe {
    let tt=sl_type(t)
    if types.ptr[tt].kind =? 'float_' and GlslEmitWord(types.ptr[tt].bits) =? 32 {return 1}
    if types.ptr[tt].kind =? 'vec' and tt not=? T_MAT4 and not types.ptr[tt].sign {return GlslEmitWord(types.ptr[tt].bits)}
    gl_err(pos "vertex attributes must be {tsd("f32" "float32")}, vec2, vec3 or vec4 (found {dt(tt)})")
    0
}
uniform_kind=(t0:GlslEmitWord pos:GlslEmitWord):>string=>$unsafe {
    let t=sl_type(t0)
    let k=types.ptr[t].kind
    if k =? 'float_' {
        if GlslEmitWord(types.ptr[t].bits) =? 32 {return "f"}
        return "d"
    }
    if k =? 'int_' {return "i"}
    if k =? 'bool_' {return "b"}
    if k =? 'vec' {
        if t =? T_MAT4 {return "m"}
        if types.ptr[t].sign {return "I"}
        return "v{types.ptr[t].bits}"
    }
    if k =? 'struct_' and is_lib_texture(GlslEmitWord(types.ptr[t].st)) {return "t"}
    if is_gpu_buffer(t) {return "B"}
    gl_err(pos "uniform fields must be numbers, vectors, mat4 or Texture, or fixed-size arrays of them (found {dt(t)})")
    ""
}
# the uniforms' layout entries for struct type t at byte offset base: ";name,kind,offset" (an
# array: ",count,stride" more); a struct inside them by its fields, named "field_.inner"
gl_udesc=(t:GlslEmitWord prefix:string base:GlslEmitWord pos:GlslEmitWord):>string=>$unsafe {
    let out=""
    let si=GlslEmitWord(types.ptr[prune(t)].st)
    layout(t)
    loop i in 0.. and f in gl_struct_fields(t) {
        let [fname ftype]=f
        let fo=base + GlslEmitWord(fields.ptr[GlslEmitWord(structs.ptr[si].fields) + i].offset)
        let ft=sl_type(ftype)
        if types.ptr[ft].kind =? 'fixed' {
            # an array: its element kind, then the count and the bytes per element
            let et=GlslEmitWord(types.ptr[ft].elem)
            if is_gpu_buffer(et) {gl_err(pos "uniforms cannot hold arrays of GPU buffers")}
            out="{out};{prefix}{fname},{uniform_kind(et pos)},{fo},{fixed_len(ft)},{tsize(et)}"
        }
        else if types.ptr[ft].kind =? 'struct_' and not is_lib_texture(GlslEmitWord(types.ptr[ft].st)) and not is_gpu_buffer(ft) {
            out="{out}{gl_udesc(ft "{prefix}{fname}_." fo pos)}"
        }
        else {out="{out};{prefix}{fname},{uniform_kind(ftype pos)},{fo}"}
    }
    out
}

# Bounded single-source relaxation, never an all-pairs closure. Exhaustion
# simply declines additional inference; every discovered path is still valid.
fd_terms: int[]
fd_distances: int[]
fd_pending: int[]
fd_seen_gen: i32[]
fd_seen_slot: i32[]
fd_gen: i32 = 0

fd_next_gen = (need: int) -> i32:
    if fd_seen_gen.len() < need:
        sz = max(need + 256, fd_seen_gen.len() * 2 + 256)
        fd_seen_gen.resize(sz)
        fd_seen_slot.resize(sz)
    fd_gen = i32(int(fd_gen) + 1)
    if fd_gen == 0:
        mem_set(data(fd_seen_gen) as *u8, 0, fd_seen_gen.len() * 4)
        fd_gen = 1
    fd_gen

fd_slot_raw = (v: int, gterms: *FactTerm, ngterms: int, ids: *int, n_ids: int, slots_p: *int, slots_n: int) -> int:
    if v > 0 and v < ngterms:
        h = gterms[v].slot
        if h >= 0 and h < n_ids and ids[h] == v: return h
    fact_slot_slow_raw(slots_p, slots_n, v, n_ids, ids)
fd_gap_ok = (v: int, x_hi: int, distance: int, limit: int, bounds: *FactBound, gterms: *FactTerm, ngterms: int, ids: *int, n_ids: int, slots_p: *int, slots_n: int) -> bool:
    si = fd_slot_raw(v, gterms, ngterms, ids, n_ids, slots_p, slots_n)
    if si < 0: return false
    yp = bounds + si
    ylo = yp.lo
    if yp.wide or ylo == FACT_MIN: return false
    neg_ylo = -ylo
    gap = x_hi + neg_ylo
    if ((x_hi xor gap) & (neg_ylo xor gap)) < 0: return false
    tot = gap + distance
    ((gap xor tot) & (distance xor tot)) >= 0 and tot <= limit
fact_distance = (s: FactState, a: int, b: int, limit: int) -> bool:
    if a == 0 or b == 0: return false
    if a == b: return limit >= 0
    if s.differences.len() == 0: return false
    bbit = 1 << (b & 63)
    if (s.diff_b_mask & bbit) == 0:
        if (s.diff_a_mask & bbit) == 0: return false
        if data(s.index)[0].difference_next.len() == 0: return false
    fact_distance_slow(s, a, b, limit, FACT_MIN)
fact_distance_slow = (s: FactState, a: int, b: int, limit: int, x_hi_hint: int) -> bool:
    from_cmp = x_hi_hint != FACT_MIN
    ndiffs = s.differences.len()
    amask = s.diff_a_mask
    bmask = s.diff_b_mask
    b_has_in = from_cmp or (bmask & (1 << (b & 63))) != 0
    idx = data(s.index)
    indexed = idx[0].difference_next.len() != 0
    diffs = data(s.differences)
    if indexed and b_has_in and (amask & (1 << (a & 63))) != 0:
        direct = fact_index_get_raw(data(idx[0].difference_index), idx[0].difference_index.len(), fact_pair_key(a, b))
        if direct >= 0 and diffs[direct].limit <= limit: return true
    n_ids = s.ids.len()
    ids = data(s.ids)
    bounds = data(s.bounds)
    slots_p = data(idx[0].slots)
    slots_n = idx[0].slots.len()
    gterms = data(fact_terms)
    ngterms = fact_terms.len()
    dval_p = data(idx[0].difference_value)
    dval_n = idx[0].difference_value.len()
    drec = data(idx[0].difference_record)
    dnext = data(idx[0].difference_next)
    first_ri = -1
    has_a = false
    if indexed:
        rv0 = fact_index_get_raw(dval_p, dval_n, b)
        if rv0 < 0: return false
        first_ri = drec[rv0 * FACT_RECORD + 1]
        if first_ri < 0 and from_cmp: return false
    else:
        i = 0
        loop i < ndiffs:
            rp = diffs + i
            if rp.a == a:
                has_a = true
                if rp.b == b and rp.limit <= limit: return true
            if rp.b == b and first_ri < 0: first_ri = i
            i += 1
        if first_ri < 0: return false
    x_ok = false
    x_hi = 0
    if from_cmp:
        if x_hi_hint != FACT_MAX:
            x_ok = true
            x_hi = x_hi_hint
    else if n_ids > 0:
        ai = fd_slot_raw(a, gterms, ngterms, ids, n_ids, slots_p, slots_n)
        if ai >= 0:
            xp = bounds + ai
            if not xp.wide and xp.hi != FACT_MAX:
                x_ok = true
                x_hi = xp.hi
    if indexed:
        if first_ri < 0:
            return x_ok and fd_gap_ok(b, x_hi, 0, limit, bounds, gterms, ngterms, ids, n_ids, slots_p, slots_n)
        if not x_ok:
            if (amask & (1 << (a & 63))) == 0: return false
            rva = fact_index_get_raw(dval_p, dval_n, a)
            if rva < 0 or drec[rva * FACT_RECORD + 3] < 0: return false
    else:
        if not x_ok and not has_a: return false
    if fd_terms.len() < 32:
        fd_terms.resize(32)
        fd_distances.resize(32)
        fd_pending.resize(320)
    need_g = ngterms + 1
    gen: i32 = 0
    if fd_seen_gen.len() >= need_g and fd_gen != i32(-1):
        fd_gen = i32(int(fd_gen) + 1)
        gen = fd_gen
    else:
        gen = fd_next_gen(need_g)
    seen_g = data(fd_seen_gen)
    seen_s = data(fd_seen_slot)
    terms = data(fd_terms)
    distances = data(fd_distances)
    pending = data(fd_pending)
    terms[0] = b
    distances[0] = 0
    pending[0] = 0
    seen_g[b] = gen; seen_s[b] = 0
    nterms = 1
    npend = 1
    cursor = 0
    visits = 0
    loop cursor < npend and visits < 256:
        index = pending[cursor]
        cursor += 1
        source = terms[index]
        distance = distances[index]
        if x_ok and (not from_cmp or cursor > 1) and fd_gap_ok(source, x_hi, distance, limit, bounds, gterms, ngterms, ids, n_ids, slots_p, slots_n): return true
        if cursor > 1 and (bmask & (1 << (source & 63))) == 0: continue
        if indexed:
            ri = -1
            if cursor == 1:
                ri = first_ri
            else:
                rv = fact_index_get_raw(dval_p, dval_n, source)
                if rv >= 0: ri = drec[rv * FACT_RECORD + 1]
            loop ri >= 0:
                rp = diffs + ri
                ra = rp.a
                rlim = rp.limit
                visits += 1
                ri = dnext[ri * 2]
                if visits > 256: return false
                value = distance + rlim
                if ((distance xor value) & (rlim xor value)) < 0: continue
                if ra == a and value <= limit: return true
                slot = if seen_g[ra] == gen: int(seen_s[ra]) else: -1
                if slot < 0:
                    if nterms >= 32: continue
                    slot = nterms
                    nterms += 1
                    terms[slot] = ra
                    distances[slot] = value
                    pending[npend] = slot
                    npend += 1
                    seen_g[ra] = gen; seen_s[ra] = i32(slot)
                else if value < distances[slot]:
                    distances[slot] = value
                    pending[npend] = slot
                    npend += 1
        else:
            k = if cursor == 1: first_ri else: 0
            loop k < ndiffs:
                rp = diffs + k
                k += 1
                if rp.b != source: continue
                ra = rp.a
                rlim = rp.limit
                visits += 1
                if visits > 256: return false
                value = distance + rlim
                if ((distance xor value) & (rlim xor value)) < 0: continue
                if ra == a and value <= limit: return true
                slot = if seen_g[ra] == gen: int(seen_s[ra]) else: -1
                if slot < 0:
                    if nterms >= 32: continue
                    slot = nterms
                    nterms += 1
                    terms[slot] = ra
                    distances[slot] = value
                    pending[npend] = slot
                    npend += 1
                    seen_g[ra] = gen; seen_s[ra] = i32(slot)
                else if value < distances[slot]:
                    distances[slot] = value
                    pending[npend] = slot
                    npend += 1
    false
# The smallest d found with a - b <= d (FACT_MAX: none), by fact_distance's
# bounded relaxation.
fact_shortest = (s: FactState, a: int, b: int) -> int:
    if a == 0 or b == 0: return FACT_MAX
    if a == b: return 0
    ndiffs = s.differences.len()
    if ndiffs == 0: return FACT_MAX
    amask = s.diff_a_mask
    bmask = s.diff_b_mask
    if (bmask & (1 << (b & 63))) == 0 or (amask & (1 << (a & 63))) == 0: return FACT_MAX
    best = FACT_MAX
    diffs = data(s.differences)
    idx = data(s.index)
    indexed = idx[0].difference_next.len() != 0
    dval_p = data(idx[0].difference_value)
    dval_n = idx[0].difference_value.len()
    drec = data(idx[0].difference_record)
    dnext = data(idx[0].difference_next)
    first_ri = -1
    if indexed:
        direct = fact_index_get_raw(data(idx[0].difference_index), idx[0].difference_index.len(), fact_pair_key(a, b))
        if direct >= 0: best = diffs[direct].limit
        rv0 = fact_index_get_raw(dval_p, dval_n, b)
        if rv0 < 0: return best
        first_ri = drec[rv0 * FACT_RECORD + 1]
        if first_ri < 0: return best
        rva = fact_index_get_raw(dval_p, dval_n, a)
        if rva < 0 or drec[rva * FACT_RECORD + 3] < 0: return best
    else:
        has_a = false
        i = 0
        loop i < ndiffs:
            rp = diffs + i
            if rp.a == a:
                has_a = true
                if rp.b == b and rp.limit < best: best = rp.limit
            if rp.b == b and first_ri < 0: first_ri = i
            i += 1
        if first_ri < 0 or not has_a: return best
    if fd_terms.len() < 32:
        fd_terms.resize(32)
        fd_distances.resize(32)
        fd_pending.resize(320)
    gen = fd_next_gen(fact_terms.len() + 1)
    seen_g = data(fd_seen_gen)
    seen_s = data(fd_seen_slot)
    seen_n = fd_seen_gen.len()
    terms = data(fd_terms)
    distances = data(fd_distances)
    pending = data(fd_pending)
    terms[0] = b
    distances[0] = 0
    pending[0] = 0
    if b >= 0 and b < seen_n: seen_g[b] = gen; seen_s[b] = 0
    nterms = 1
    npend = 1
    cursor = 0
    visits = 0
    loop cursor < npend and visits < 256:
        index = pending[cursor]
        cursor += 1
        source = terms[index]
        distance = distances[index]
        ri = -1
        if cursor == 1:
            ri = first_ri
        else if indexed:
            rv = fact_index_get_raw(dval_p, dval_n, source)
            if rv >= 0: ri = drec[rv * FACT_RECORD + 1]
        else:
            k = 0
            loop k < ndiffs:
                if diffs[k].b == source: ri = k; break
                k += 1
        loop ri >= 0:
            rp = diffs + ri
            ra = rp.a
            rlim = rp.limit
            visits += 1
            if indexed:
                ri = dnext[ri * 2]
            else:
                k = ri + 1
                ri = -1
                loop k < ndiffs:
                    if diffs[k].b == source: ri = k; break
                    k += 1
            if visits > 256: return best
            if not fact_add_fits(distance, rlim): continue
            value = distance + rlim
            if ra == a:
                best = min(best, value)
                continue
            slot = -1
            if ra >= 0 and ra < seen_n:
                if seen_g[ra] == gen: slot = int(seen_s[ra])
            else:
                loop t in [0..nterms):
                    if terms[t] == ra: slot = t; break
            if slot < 0:
                if nterms >= 32: continue
                slot = nterms
                nterms += 1
                terms[slot] = ra
                distances[slot] = value
                pending[npend] = slot
                npend += 1
                if ra >= 0 and ra < seen_n: seen_g[ra] = gen; seen_s[ra] = i32(slot)
            else if value < distances[slot]:
                distances[slot] = value
                pending[npend] = slot
                npend += 1
    best
# Rows for a sum of two symbolic operands, v = a + b, through terms already
# evaluated (a guard's `first+n <=? xs.length`, a range's `n-col`): with
# w = a + c, b - c <= d gives v - w <= d; with t = c - a, b - t <= d gives
# v - c <= d (each mirrored). Found before v exists, so a bounded sum is no
# possible wrap. O(terms) candidates, two bounded relaxations each.
fact_sum_rows = (s: FactState, a: int, b: int) -> FactDifference[]:
    rows: FactDifference[]
    loop i in [0..s.ids.len()):
        t = s.ids[i]
        term = fact_terms[t]
        if term.a == 0 or term.b == 0: continue
        loop side in [0..2):
            mine = if side == 0: a else: b
            other = if side == 0: b else: a
            if term.op == .plus and (term.a == mine or term.b == mine):
                c = if term.a == mine: term.b else: term.a
                up = fact_shortest(s, other, c)
                if up != FACT_MAX: rows.push(FactDifference(0, t, up))
                down = fact_shortest(s, c, other)
                if down != FACT_MAX: rows.push(FactDifference(t, 0, down))
            else if term.op == .minus and term.b == mine:
                up = fact_shortest(s, other, t)
                if up != FACT_MAX: rows.push(FactDifference(0, term.a, up))
                down = fact_shortest(s, t, other)
                if down != FACT_MAX: rows.push(FactDifference(term.a, 0, down))
            if rows.len() >= 8: return rows
    rows
# Compose two independently bounded operands only when a comparison needs
# them. No speculative rows consume the ordinary graph's incident budgets.
# O(active terms), with bounded indexed distance queries, no state changes.
fact_sum_compare = (s: FactState, a: int, b: int, limit: int) -> bool:
    if a == 0 or b == 0: return false
    ft = data(fact_terms)
    sum = ft + a
    if sum.op != .plus or sum.a == 0 or sum.b == 0: return false
    sa = sum.a
    sb = sum.b
    loop side in [0..2):
        mine = if side == 0: sa else: sb
        other = if side == 0: sb else: sa
        difference = ft + mine
        if difference.op == .minus and difference.a != 0 and difference.b != 0:
            up = fact_shortest(s, other, difference.b)
            tail = if up == FACT_MAX: FACT_MAX else: fact_shortest(s, difference.a, b)
            if up != FACT_MAX and tail != FACT_MAX and fact_add_fits(up, tail) and up + tail <= limit: return true
    b_has_in = (s.diff_b_mask & (1 << (b & 63))) != 0
    if not b_has_in:
        if b == a: return false
        term = ft + b
        if term.op != .plus or term.a == 0 or term.b == 0: return false
        loop side in [0..2):
            x = if side == 0: term.a else: term.b
            y = if side == 0: term.b else: term.a
            up = fact_shortest(s, sa, x)
            if up == FACT_MAX: continue
            down = fact_shortest(s, sb, y)
            if down == FACT_MAX or not fact_add_fits(up, down): continue
            if up + down <= limit: return true
        return false
    amask = s.diff_a_mask
    idp = data(s.ids)
    nids = s.ids.len()
    loop i in [0..nids):
        t = idp[i]
        if t == a: continue
        if t != b and (amask & (1 << (t & 63))) == 0: continue
        term = ft + t
        if term.op != .plus or term.a == 0 or term.b == 0: continue
        tail = if t == b: 0 else: fact_shortest(s, t, b)
        if tail == FACT_MAX: continue
        loop side in [0..2):
            x = if side == 0: term.a else: term.b
            y = if side == 0: term.b else: term.a
            up = fact_shortest(s, sa, x)
            if up == FACT_MAX: continue
            down = fact_shortest(s, sb, y)
            if down == FACT_MAX or not fact_add_fits(up, down): continue
            total = up + down
            if fact_add_fits(total, tail) and total + tail <= limit: return true
    false
# y - h <= d: the shortest row path, else the operands' intervals. FACT_MAX: none.
fact_gap = (s: FactState, y: int, h: int) -> int:
    if y == h: return 0
    best = fact_shortest(s, y, h)
    p = fact_signed_bound(s, y)
    q = fact_signed_bound(s, h)
    if not p.wide and not q.wide and p.hi != FACT_MAX and q.lo != FACT_MIN and fact_add_fits(p.hi, -q.lo): best = min(best, p.hi - q.lo)
    best
# v - b <= d: a bounded row path, else v's interval or one row from v to an
# interval, against b's lower end (`h*w <=? INT64_MAX` through
# `xs.length =? h*w`). O(fact_distance + 16 incident rows).
fact_below = (s: FactState, v: int, b: int, d: int) -> bool:
    if fact_distance(s, v, b, d): return true
    low = fact_signed_bound(s, b)
    top = fact_signed_bound(s, v)
    if low.wide or top.wide or low.lo == FACT_MIN: return false
    best = top.hi
    ri = fact_difference_head(s, v, 1)
    seen = 0
    loop ri >= 0 and seen < 16:
        row = s.differences[ri]
        ri = fact_difference_next(s, ri, 1)
        seen += 1
        o = fact_signed_bound(s, row.b)
        if not o.wide and o.hi != FACT_MAX and fact_add_fits(o.hi, row.limit): best = min(best, o.hi + row.limit)
    best != FACT_MAX and fact_add_fits(best, -low.lo) and best - low.lo <= d
# A product with a shared factor, on demand: a = y*w (+ x) against a
# retained t = h*w, then t - b. With w >= wl >= 0 and y - h <= dy <= 0,
# a - t = (y-h)*w + x <= dy*wl + x, and with dy <= -1 and x - w <= dx,
# also <= (dy+1)*wl + dx: `r*w + c <? xs.length` from `xs.length =? h*w`,
# `0 <=? c <? w` and `r <? h`. Retained arithmetic terms are exact (a product
# that may wrap is never kept), so the algebra is the mathematical one.
# Only a compare whose left side is a product, or a sum with one (nested
# once, `(k*n + col) + j`), gets here.
# O(active terms) per factor order, plus two bounded relaxations and 16
# incident rows per retained product sharing w.
fact_product_compare = (s: FactState, a: int, b: int, limit: int) -> bool:
    if a == 0 or b == 0: return false
    t = fact_terms[a]
    if t.a == 0 or t.b == 0: return false
    if t.op != .star and t.op != .plus: return false
    if fact_bound(s, a).wide: return false
    # (the product and up to two addends: `p`, `p + x`, `(p + x) + x2`)
    loop pick in [0..6):
        p = a
        x = 0
        x2 = 0
        if t.op == .star:
            if pick > 0: break
        else if pick < 2:
            p = if pick == 0: t.a else: t.b
            x = if pick == 0: t.b else: t.a
        else:
            u = if pick < 4: t.a else: t.b
            x2 = if pick < 4: t.b else: t.a
            ut = fact_terms[u]
            if ut.op != .plus or ut.a == 0 or ut.b == 0: continue
            p = if pick % 2 == 0: ut.a else: ut.b
            x = if pick % 2 == 0: ut.b else: ut.a
        pt = fact_terms[p]
        if pt.op != .star or pt.a == 0 or pt.b == 0: continue
        if fact_bound(s, p).wide: continue
        xb = if x == 0: FactBound(0, 0) else: fact_signed_bound(s, x)
        if x2 != 0:
            extra = fact_signed_bound(s, x2)
            xb.wide = xb.wide or extra.wide
            xb.lo = if xb.lo != FACT_MIN and extra.lo != FACT_MIN and fact_add_fits(xb.lo, extra.lo): xb.lo + extra.lo else: FACT_MIN
            xb.hi = if xb.hi != FACT_MAX and extra.hi != FACT_MAX and fact_add_fits(xb.hi, extra.hi): xb.hi + extra.hi else: FACT_MAX
        if xb.wide: continue
        loop side in [0..2):
            y = if side == 0: pt.a else: pt.b
            w = if side == 0: pt.b else: pt.a
            if side == 1 and y == w: break
            wb = fact_signed_bound(s, w)
            if wb.wide: continue
            wl = wb.lo
            dx = if x == 0: FACT_MAX else if x2 == 0: fact_gap(s, x, w) else: fact_pair_gap(s, x, x2, w)
            # (x <= w + dx with x >= x.lo: w >= x.lo - dx)

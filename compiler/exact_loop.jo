use 'lower_scalars.dewy'
use 'lower_storage.dewy'
use 'lower_group.dewy'
use 'checker_state.dewy'
use 'ir_types.dewy'
use 'checker_tokens.dewy'
# Guarded nonnegative reductions. Only exact functions with a small straight-line
# nest of counted loops and read-only word arrays are candidates. One O(N+E)
# syntax walk builds the plan; indexed local/array bounds generate one entry
# guard. Each array is scanned once per invocation, outside every counted loop.
# The guard proves all scalar intermediates and every reduction prefix fit a
# signed word. Otherwise the original function runs, with its failures in order.
use 'ast.jo'
use 'types.jo'
use 'type_ops.dewy'
use 'expr.jo'
use 'check.jo'
use 'checks_assign_hooks.dewy'
use 'ir.jo'
use 'facts.jo'
use 'facts_library.dewy'
use 'facts_pushes.dewy'
use 'facts_progress.dewy'
use 'refine.jo'
use 'util.jo'
use 'main.jo'
use 'ownership.jo'
use 'lex.jo'
use 'exact.jo'
use 'math_lower.jo'
use 'lower.jo'
use 'ownership_types.dewy'
use 'ir_builders.dewy'
use 'math_ops.dewy'
use 'exact_loop_ops.dewy'
use 'exact_loop_rare.dewy'

exact_loop_fast = false
exl_arrays: {int: int} = {}
exl_aliases: {int: int} = {}
exl_locals: {int: bool} = {}
exl_upper: {int: int} = {}
exl_array_upper: {int: int} = {}
exl_bad = 0
exl_reductions = 0
exl_target = 0

# A generated broadcast's fresh output cannot alias its input arrays. For a
# straight-line map, one vectorizable range census per input selects an unchecked
# loop or the original exact loop. Plans cost O(body nodes/edges), at most eight
# inputs; the census costs O(input elements) and uses constant indexed state.
exm_emitting = false
exm_arrays: int[]
exm_elements: int[]
exm_indices: int[]
exm_steps: int[]
exact_map_active = false
exact_map_functions: bool[]
exact_map_stores: {int: bool} = {}
exm_scalars: int[]
exm_broadcast = false
exm_obligation = false
exm_math_output = false
exm_assignment = 0

# Private generated arrays may carry their producer's bound into a later map.
# The flag starts true at each allocation and every scalar fallback clears it.
# Alias traversal accepts only unchanged, unexposed value bindings; the terminal
# array itself is private generated storage. No property is cached by address.
exm_produced_flags: {int: int} = {}
exm_produced_widths: {int: int} = {}

# Demand-created per-function censuses of immutable word-array parameters.
# One scan on the first reached map, then one register read per map use.
# Each requested signed width has its own vectorizable biased-bit census.
exm_censuses: {int: (int, int)} = {}

# Carry the immediate's factor of two through linear arithmetic. The map's
# census proves every intermediate fits the signed payload; multiplication
# needs that factor on only one operand. No tagged value crosses the guard.
exm_tagged_sources: {int: bool} = {}

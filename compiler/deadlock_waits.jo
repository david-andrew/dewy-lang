use 'deadlock.jo'
use 'ast.jo'
use 'check.jo'
use 'expr.jo'
use 'util.jo'
use 'directives.jo'
use 'directive_ops.dewy'
use 'concurrency_types.dewy'
use 'deadlock_locations.dewy'
use 'deadlock_summaries.dewy'

dl_undecided = (site: int, msg: str, other: int[] = []):
    hit = dir_no_deadlocks(site)
    loop o in other:
        if dir_no_deadlocks(o): hit = true
    if hit: fatal(site, "{msg}. Under `$no_deadlocks` an undecided wait is an error: no certificate covers it")
    warn(site, msg)

dl_wait = (held: DlHeld[], loc: DlLoc, site: int, via: str, report_site: int):
    loop h in held:
        if dl_report and dl_must(h.loc, loc):
            how = if len(via) > 0: " ({via}, takes it at {dl_line(site)})" else: ""
            fatal(report_site, "this waits for {dl_name(loc)}, which this task already holds since {dl_line(h.site)}{how}: it would wait forever. Use the place already held, or let it end before taking the lock again")
        if dl_report and dl_may(h.loc, loc) and not dl_must(h.loc, loc):
            dl_undecided(report_site, "this may wait for {dl_name(loc)} while holding another of the same ({dl_line(h.site)}): two tasks taking them in opposite orders would wait forever. Take them together, in one order: `let [a b] = @(lock_all(x y)) or_throw`", [h.site, site])
            continue
        dl_add_edge(DlEdge(h.loc, loc, h.site, site, via, report_site))
    # (a lock the analysis cannot name has no place in the checked order)
    if dl_report and dir_deadlocks_any and held.len() > 0 and (dir_no_deadlocks(report_site) or dir_no_deadlocks(site)):
        loop h in held:
            if dl_named(loc) and dl_named(h.loc): continue
            how = if len(via) > 0: " ({via}, takes it at {dl_line(site)})" else: ""
            fatal(report_site, "this waits for {dl_name(loc)}{how} while holding {dl_name(h.loc)} (since {dl_line(h.site)}), and the compiler cannot name one of them, so no checked lock order covers the wait (`$no_deadlocks`): take them together with `lock_all`, or nest only locks named by a local or a parameter holding a handle `mutex(...)` made (a field, an element or a handle a call gives back may be a copy of another)")

dl_join = (h: int, held: DlHeld[], pos: int, what: str):
    if not dl_relevant.has(h) or not dl_report: return
    s = dl_summary(h)
    loop a in s.acqs:
        if not a.wait: continue
        loop hd in held:
            if dl_must(hd.loc, a.loc):
                fatal(pos, "this holds {dl_name(hd.loc)} (since {dl_line(hd.site)}) while waiting for {what}, which take it ({dl_line(a.site)}): neither can go on. Let the place end before the join, or take the lock inside the work only")
            if dl_may(hd.loc, a.loc):
                dl_undecided(pos, "this holds {dl_name(hd.loc)} (since {dl_line(hd.site)}) while waiting for {what}, which may take the same lock ({dl_line(a.site)})", [hd.site])

dl_polling = (h: int):
    body = int(fns[h].body)
    loops: int[]
    dl_find_loops(body, loops)
    loop lp in loops:
        cond = int(nodes[lp].a)
        polled: DlLoc[]
        dl_atomic_reads(cond, h, polled)

        if polled.len() == 0: continue
        loop p in polled:
            if dl_atomic_written(int(nodes[lp].b), h, p): continue
            if dl_atomic_written(body, h, p):
                fatal(nodes[lp].pos, "this parallel iteration waits for {dl_name(p)}, which a sibling iteration sets: iterations may run one after another on one thread, so it may wait forever. Use `concurrent` and `spawn` for work that waits on other work")
            dl_undecided(nodes[lp].pos, "this parallel iteration polls {dl_name(p)}: iterations may run one after another on one thread, so it waits for whatever sets it")

dl_find_loops = (n: int, out: mut int[]):
    if n == 0 or nodes[n].kind == .lambda: return
    if nodes[n].kind == .while_: out.push(n)
    loop c in [int(nodes[n].a), int(nodes[n].b), int(nodes[n].c)]: dl_find_loops(c, out)
    loop c in kids(n): dl_find_loops(c, out)

dl_atomic_name = (n: int, names: str[]) -> bool:
    if nodes[n].kind != .call or nodes[n].aux != 0 or nodes[n].sym <= 0 or nkids(n) == 0: return false
    d = int(fns[int(nodes[n].sym)].decl)
    if d == 0 or not concurrency_builtin_type(ntype(kid(n, 0)), "Atomic"): return false
    names.contains(name_of(int(nodes[d].name)))

dl_atomic_reads = (n: int, f: int, out: mut DlLoc[]):
    if n == 0 or nodes[n].kind == .lambda: return

    if dl_atomic_name(n, ["load", "get"]):
        loc = dl_resolve(kid(n, 0), f)
        if loc.root != 0: out.push(loc)
    loop c in [int(nodes[n].a), int(nodes[n].b), int(nodes[n].c)]: dl_atomic_reads(c, f, out)
    loop c in kids(n): dl_atomic_reads(c, f, out)

dl_atomic_written = (n: int, f: int, loc: DlLoc) -> bool:
    if n == 0 or nodes[n].kind == .lambda: return false
    if dl_atomic_name(n, ["store", "set", "add", "compare_swap", "set_max"]) and dl_may(dl_resolve(kid(n, 0), f), loc): return true
    loop c in [int(nodes[n].a), int(nodes[n].b), int(nodes[n].c)]:
        if dl_atomic_written(c, f, loc): return true
    loop c in kids(n):
        if dl_atomic_written(c, f, loc): return true
    false

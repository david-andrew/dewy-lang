use 'par.jo'
use 'native_debug.dewy'
use 'pe_format.dewy'
use 'elf_format.dewy'
use 'x64_module.dewy'
use 'x64_emit.dewy'
use 'driver_pipeline.dewy'
use 'x64_allocate.dewy'
use 'ir_types.dewy'
use 'main.jo'
use 'util.jo'
use 'ir.jo'
use 'x64.jo'
use 'check.jo'
use 'watch.jo'
use 'lower.jo'
use 'types.jo'
use 'ast.jo'
use 'fused.jo'
use 'par_ops.dewy'

# true when the queued functions' code was made in parallel (and joined)
emit_parallel = (q: IrFn[], fin: bool[]) -> bool:
    when TARGET == "windows" or TARGET == "wasm":
        return false
    else:
        if target_wasm or target_arm64 or ra_stat or watch_build or repl_image or len(ra_dump) > 0: return false
        total = 0
        loop f in q: total += f.code.len()
        n = emit_workers()
        # (each worker should have enough to make the fork worth it)
        n = min(n, total / 20000)
        forced = env("DEWY_EMIT_FORCE") != none
        if forced: n = max(emit_workers(), 1)
        if (n < 2 and not forced) or q.len() < n: return false
        # runs of consecutive functions with about the same amount of IR each
        cuts = [0]
        acc = 0
        loop k in 0.. and f in q:
            acc += f.code.len()
            if acc * n >= total * cuts.len() and cuts.len() < n and k + 1 < q.len(): cuts.push(k + 1)
        cuts.push(q.len())
        # (forked one by one and read in order: each pipe holds what a worker writes until read)
        r0 = rodata.len()
        tm = env("DEWY_PAR_TIME") != none
        ta = time()
        pids: int[]
        fds: int[]
        loop w in [0..cuts.len() - 1):
            pfd = [0]
            if syscall(293, data(pfd), 0x80000) != 0:
                pids.push(-1)
                fds.push(-1)
                continue
            rfd = pfd[0] & 0xFFFFFFFF
            wfd = pfd[0] >> 32
            pid = syscall(57)
            if pid == 0:
                syscall(3, rfd)
                if (env("DEWY_EMIT_FAIL_WORKER") ?? "") == "{w}": exit(1)
                par_worker(q, fin, cuts[w], cuts[w + 1], r0, wfd)
            syscall(3, wfd)
            if pid < 0:
                syscall(3, rfd)
                pids.push(-1)
                fds.push(-1)
            else:
                pids.push(pid)
                fds.push(rfd)
        tb = time()
        tread = 0.0
        tjoin = 0.0
        loop w in [0..cuts.len() - 1):
            got: u8[]
            ok = fds[w] >= 0
            if ok:
                t_0 = time()
                got = par_read(fds[w])
                tread += time() - t_0
                syscall(3, fds[w])
                st = [0]
                syscall(61, pids[w], data(st), 0, 0)
                ok = st[0] & 0xFFFF == 0 and got.len() >= 8
            if ok:
                t_1 = time()
                par_join(got, r0, q, fin, cuts[w])
                tjoin += time() - t_1
            else:
                # (that run, here)
                loop k in [cuts[w]..cuts[w + 1]):
                    ir = q[k]
                    emit_now(fin[k])
        if tm: eprint("emit: {cuts.len() - 1} workers, fork {(tb - ta) * 1000.0:.1} ms, waiting and reading {tread * 1000.0:.1} ms, joining {tjoin * 1000.0:.1} ms, {par_here} functions again here")
        true
# ---- a worker: emit q[a..b), write what came of it to fd, end ----
par_worker = (q: IrFn[], fin: bool[], a: int, b: int, r0: int, fd: int):
    code = []
    call_fix = []
    data_fix = []
    stub_fix = []
    cabi_fix = []
    cabi_adapter = {}
    elf_syms = []
    line_rows = []
    call_sites = []
    unwind_fns = []
    uw_data = []
    dbg_raw = []
    dbg_cfi = []
    ro_new = []
    rsp_rows = []
    tw0 = time()
    out: u8[]
    pw(out, b - a)
    loop k in [a..b):
        ir = q[k]
        # (where it starts in each table: par_join's marks)
        at: int[] = [code.len(), call_fix.len(), data_fix.len(), stub_fix.len(), cabi_fix.len(), elf_syms.len(), line_rows.len(), call_sites.len(), unwind_fns.len(), uw_data.len(), dbg_raw.len(), dbg_cfi.len(), ro_new.len(), rsp_rows.len()]
        emit_now(fin[k])
        pw(out, ir.fn_index)
        pw(out, fn_addr[ir.fn_index])
        pw(out, fn_len[ir.fn_index])
        moved = 0
        if pad_moves: moved = 1
        pw(out, moved)
        loop x in at: pw(out, x)
    tw1 = time()
    pw(out, code.len())
    out.reserve(out.len() + code.len() + 16 * (call_fix.len() + data_fix.len() + line_rows.len() + call_sites.len()) + 1024)
    when BOOTSTRAP:
        loop c in code: out.push(c)
    else: out.extend(code)
    pw(out, call_fix.len())
    loop f in call_fix:
        pw(out, f.0)
        pw(out, f.1)
    pw(out, data_fix.len())
    loop f in data_fix:
        pw(out, f.0)
        pw(out, f.1)
        pw(out, f.2)
    pw(out, stub_fix.len())
    loop f in stub_fix:
        pw(out, f.0)
        pw(out, f.1)
    pw(out, cabi_fix.len())
    loop f in cabi_fix:
        pw(out, f.0)
        pw(out, f.1)
    pw(out, cabi_adapter.len())
    loop k2, v in cabi_adapter:
        pw(out, k2)
        pw(out, v)
    pw(out, elf_syms.len())
    loop s in elf_syms:
        pw(out, len(s.0))
        loop c in bytes(s.0): out.push(c)
        pw(out, s.1)
        pw(out, s.2)
    pw_ints(out, line_rows)
    pw_ints(out, call_sites)
    pw(out, unwind_fns.len())
    loop u in unwind_fns:
        pw(out, u.0)
        pw(out, u.1)
        pw(out, u.2)
        pw(out, u.3)
    pw_ints(out, uw_data)
    pw_ints(out, dbg_raw)
    pw_ints(out, dbg_cfi)
    news: int[]
    loop c in ro_new:
        news.push(c.0)
        news.push(c.1)
    pw_ints(out, news)
    pw_ints(out, rsp_rows)
    tw2 = time()
    __olen = 0                      # (the compiler's own output, not yet written, is the parent's to write)
    __write_fd(fd, data(out), out.len())
    if env("DEWY_PAR_TIME") != none: eprint("  worker {a}..{b}: emit {(tw1 - tw0) * 1000.0:.1} ms, pack {(tw2 - tw1) * 1000.0:.1} ms, write {(time() - tw2) * 1000.0:.1} ms, {out.len()} bytes")
    exit(0)

use 'ast.jo'
use 'checker_sinks.dewy'
use 'checks_assign_hooks.dewy'
use 'checks_thin.dewy'
use 'refine.jo'
use 'refine_siblings.dewy'

expand_when = (out: mut int[], s: int):
    if nodes[s].kind != .when_:
        out.push(s)
        return
    blk = int(nodes[s].c)
    if const_eval_bool(int(nodes[s].a)): blk = int(nodes[s].b)
    if blk == 0: return
    loop i in [0..nkids(blk)): expand_when(out, kid(blk, i))

block_open = (b: int, mode: int) -> int:
    if mode >= 0:
        sink_open(b, mode)
        return mode
    if refine_active and nkids(b) == 1: ref_pair_discard(b)
    block_sink_mode(b, mode == -2)

use 'coerce_expression.dewy'
use 'format_word_observations.dewy'
# Frozen literal checker extracted from expr.jo.
use 'node_store.dewy'
use 'checker_types.dewy'
use 'source_types.dewy'
use 'type_inference.dewy'
use 'type_constructors.dewy'
use 'checker_exact.dewy'
use 'expr.jo'
use 'literal_context.dewy'
use 'character_literals.dewy'
use 'checks_thin_expr.dewy'
use 'effects.jo'
use 'exact.jo'
use 'exact_check_hooks.dewy'
use 'checker_expr.dewy'
use 'effect_sources.dewy'
struct CheckerLiteralInput:
    nodes: *(Node[])
    lists: *(i32[])
    types: *(TypeInfo[])
    files: *(SrcFile[])
    refine: *(bool)
    effects: *(bool)
    exact_measure: *(bool)
    last: *(int)
    string_type: *(int)
    float_type: *(int)
    bool_type: *(int)
    null_type: *(int)
    int_type: *(int)
    math_int: *(int)
xl_nodes: *(Node[])
xl_lists: *(i32[])
xl_types: *(TypeInfo[])
xl_files: *(SrcFile[])
xl_refine: *(bool)
xl_effects: *(bool)
xl_exact_measure: *(bool)
xl_last: *(int)
xl_string_type: *(int)
xl_float_type: *(int)
xl_bool_type: *(int)
xl_null_type: *(int)
xl_int_type: *(int)
xl_math_int: *(int)
xl_exact_nk: u8[]
xl_exact_nk_p: *u8
checker_literals_bind = (input: *CheckerLiteralInput) -> int:
    xl_nodes = input[0].nodes
    xl_lists = input[0].lists
    xl_types = input[0].types
    xl_files = input[0].files
    xl_refine = input[0].refine
    xl_effects = input[0].effects
    xl_exact_measure = input[0].exact_measure
    xl_last = input[0].last
    xl_string_type = input[0].string_type
    xl_float_type = input[0].float_type
    xl_bool_type = input[0].bool_type
    xl_null_type = input[0].null_type
    xl_int_type = input[0].int_type
    xl_math_int = input[0].math_int
    if xl_exact_nk.len() == 0:
        xl_exact_nk.reserve(128)
        loop xl_exact_nk.len() < 128: xl_exact_nk.push(u8(0))
        xl_exact_nk[int(NK.binary)] = u8(1)
        xl_exact_nk[int(NK.unary)] = u8(1)
        xl_exact_nk[int(NK.intrinsic)] = u8(1)
        xl_exact_nk[int(NK.conv)] = u8(1)
        xl_exact_nk_p = data(xl_exact_nk)
    0
xl_representation = (t0: int) -> int:
    t = tu_prune(t0)
    if xl_types[0][t].kind == .refined: return tu_prune(int(xl_types[0][t].elem))
    t
xl_numeric = (t: int) -> bool:
    k = xl_types[0][tu_prune(t)].kind
    k == .int_ or k == .float_
xl_expected = (expected: int) -> int:
    if expected == 0: return 0
    ex = tu_prune(expected)
    if xl_refine[0]: ex = xl_representation(ex)
    ex

# (an expression's type, recorded once its kind is checked)
xl_publish = (node: mut Node, t: int):
    node.type = i32(t)
    node.flags |= 128
xl_finish_slow = (n: int, t0: int, expected: int) -> int:
    t = t0
    tp = data(xl_types[0])
    if xl_refine[0] and tp[t].kind == .refined and tp[t].bits != -2: t = int(tp[t].elem)
    # (without an expected type, callable inference returns the type as published)
    if xl_effects[0] and expected != 0:
        xl_nodes[0][n].type = i32(t)
        t = effect_infer_callable(n, expected)
    node = data(xl_nodes[0]) + n
    node[0].type = i32(t)
    node[0].flags |= i32(128)
    k = node[0].kind
    if xl_exact_measure[0] or ((k == .binary or k == .unary or k == .intrinsic or (k == .conv and node[0].aux == 2)) and exact_candidate(n)): exact_note(n)
    xl_last[0] = n
    t
xl_finish = (n: int, t0: int, expected: int) -> int:
    node = data(xl_nodes[0]) + n
    if (xl_effects[0] and expected != 0) or xl_exact_measure[0] or xl_exact_nk_p[int(node[0].kind)] != u8(0) or (xl_refine[0] and xl_types[0][t0].kind == .refined and xl_types[0][t0].bits != -2):
        return xl_finish_slow(n, t0, expected)
    node[0].type = i32(t0)
    node[0].flags |= i32(128)
    xl_last[0] = n
    t0

# (an integer literal's default type: the semantic integer in Dewy source)
xl_int_default = (n: int) -> int:
    if xl_files[0][int(xl_nodes[0][n].pos) >> 40].is_dewy: return xl_math_int[0]
    xl_int_type[0]

xl_word_fits = (n: int, t: int) -> bool:
    node = data(xl_nodes[0]) + n
    if node[0].kind != .int_lit: return false
    ty = data(xl_types[0]) + t
    bits = int(ty[0].bits)
    sign = ty[0].sign
    if int(node[0].flags) & 2097152 != 0: return bits >= 64
    v = node[0].ival
    if bits >= 64: return sign or v >= 0
    if sign: return v >= -(1 << (bits - 1)) and v < (1 << (bits - 1))
    v >= 0 and v < (1 << bits)

xl_check_int = (n: int, expected: int) -> int:
    node = data(xl_nodes[0]) + n
    node[0].flags |= i32(256)
    initial = if xl_files[0][int(node[0].pos) >> 40].is_dewy: xl_math_int[0] else: xl_int_type[0]
    node[0].type = i32(initial)
    if expected == 0:
        node[0].flags |= i32(128)
        if xl_exact_measure[0]: exact_note(n)
        xl_last[0] = n
        return initial
    ex = xl_expected(expected)
    exk = TK.void_
    if ex != 0: exk = xl_types[0][ex].kind
    t = 0
    if exk == .int_ and initial != xl_math_int[0] and ex != xl_math_int[0] and xl_word_fits(n, ex):
        node[0].type = i32(ex)
        node[0].flags &= ~256
        t = ex
    else if ex != 0 and exk == .int_:
        coerce(n, ex)
        t = ex
    else if ex != 0 and exk == .float_:
        coerce(n, ex)
        t = ex
    else if ex != 0 and exk == .opt and xl_numeric(int(xl_types[0][ex].elem)):
        coerce(n, tu_prune(int(xl_types[0][ex].elem)))
        t = int(xl_nodes[0][n].type)
    else:
        t = initial
    xl_finish(n, t, expected)

xl_check_str = (n: int, expected: int) -> int:
    ex = xl_expected(expected)
    t = 0
    if int(xl_nodes[0][n].flags) & 512 != 0 and ex != 0 and xl_types[0][tu_prune(ex)].kind == .int_:
        charlike_to_int(n)
        return check_expr(n, expected)
    else:
        if xl_nodes[0][n].aux != 0:
            loop i in [0..int(xl_nodes[0][n].nlist)):
                part = int(xl_lists[0][int(xl_nodes[0][n].list) + i])
                if xl_nodes[0][part].kind != .pair: continue
                e = int(xl_nodes[0][part].a)
                literal_interpolation_warning(e)
                check_expr(e, 0)
                finalize_literal(e)
                fmt_part(part, xl_nodes[0][part].pos)
        t = xl_string_type[0]
    xl_finish(n, t, expected)

xl_check_scalar = (n: int, expected: int) -> int:
    ex = xl_expected(expected)
    exk = TK.void_
    if ex != 0: exk = xl_types[0][ex].kind
    node = data(xl_nodes[0]) + n
    k = node[0].kind
    t = 0
    if k == .float_lit:
        if ex != 0 and exk == .float_:
            if node[0].sval != 0 and node[0].fval - node[0].fval != 0.0: literal_float_error(n)
            node[0].flags &= ~256
            t = ex
        else if ex != 0 and exk == .opt and xl_types[0][tu_prune(int(xl_types[0][ex].elem))].kind == .float_:
            node[0].flags &= ~256
            t = tu_prune(int(xl_types[0][ex].elem))
        else:
            node[0].flags |= 256
            t = xl_float_type[0]
    else if k == .bool_lit: t = xl_bool_type[0]
    else if k == .none_lit:
        if ex != 0 and exk == .opt: t = ex
        else: t = tb_mk_opt(tb_mk_var())
    else if k == .null_lit:
        if ex != 0 and (exk == .ptr or exk == .cfn): t = ex
        else: t = xl_null_type[0]
    xl_finish(n, t, expected)

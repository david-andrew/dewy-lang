# The frozen implementation-language twin of node_store.dewy, for the compilers without the
# Dewy frontend (tools/compiler/build.py). Change both, or neither.

enum NK:
    nil,
    # expressions
    int_lit, float_lit, str_lit, bool_lit, none_lit, null_lit, ident, field, dotname, call, index,
    unary, binary, and_, or_, not_, coalesce, unwrap, lambda, array, map_lit, tuple, if_, match_, cast,
    range, addr, hole, namedarg, pair, block, iflet,
    # produced by the checker
    conv, fnref, partial, intrinsic,
    # statements
    vardecl, assign, exprstmt, while_, for_, return_, break_, continue_, defer_, when_, arm,
    # declarations
    fn_, param, struct_, enum_, variant, const_, import_, test_, build_,
    # type expressions
    tname, tarray, tmap, ttuple, topt, tptr, tfn,
    # patterns
    pwild, plit, prange, pvariant,
    # added with syntax revision 2
    tunion, istype, loopx, lhead,
    narrow,         # a: a union (or optional) value known to hold member aux (type is the member's)
    typealias,      # type Name[T] = a
    ptype,          # Dewy type pattern: a is the type, name is an optional value binding
    record_lit,     # Dewy [field=value ...], contextual or inferred structural record
    matrix,         # [1 2 ; 3 4]: the elements row by row; ival = elements per row
    trecord,        # Dewy inline structural type [field: Type ...]
    propagate,     # postfix or_throw; checker expands to a checked return
    unit_lit,       # exact built-in unit: ival numerator, aux denominator, aux2 dimension
    tquantity,      # type product/division/power: a and b type syntax (power b is expression)
    reflect_scope, # internal: a specialized iteration's binding and body
    record_loop,   # literal fields expanded in a compile-time iteration scope
    trefined,      # a: base type, b: pure predicate, name: optional self binder
    typeapply,      # Dewy f<T> / Type<T>: a is the base, c the type syntax, kids the type arguments
    pshape,         # Dewy object pattern [f g:T h:1]: kids are field patterns named by their fields
    pseq,           # Dewy sequence pattern (p q r): kids are the element patterns
    parallel_region, # a: checked library call; retains the scoped fork/join boundary
    new_axis        # Dewy xs[new ..]: a is the receiver, kids the entries (`new` is the ident $new)

struct Node:
    kind: NK
    op: i32
    flags: i32
    pos: int
    a: i32
    b: i32
    c: i32
    d: i32
    list: i32
    nlist: i32
    list2: i32
    nlist2: i32
    name: i32
    sval: i32
    ival: int
    fval: f64
    type: i32
    sym: i32
    aux: i32
    aux2: i32         # vardecl: 1 for a synthesized Dewy value-parameter binding
    mod: i32

const NODE_CHECKED = 128

node_mk = (store: mut Node[], kind: NK, pos: int) -> int:
    idx = store.len()
    store.push(Node(kind = kind, pos = pos))
    idx

node_run = (runs: mut i32[], xs: int[]) -> int:
    start = runs.len()
    count = xs.len()
    if count > 0:
        need = start + count
        if runs.cap() < need: runs.reserve(need)
        __set_len(runs, need)
        dst = data(runs) + start
        src = data(xs)
        loop i in [0..count): dst[i] = i32(src[i])
    start

node_set_list = (store: mut Node[], runs: mut i32[], n: int, xs: int[]):
    start = runs.len()
    count = xs.len()
    if count > 0:
        need = start + count
        if runs.cap() < need: runs.reserve(need)
        __set_len(runs, need)
        dst = data(runs) + start
        src = data(xs)
        loop i in [0..count): dst[i] = i32(src[i])
    store[n].list = i32(start)
    store[n].nlist = i32(count)

node_set_list2 = (store: mut Node[], runs: mut i32[], n: int, xs: int[]):
    start = runs.len()
    count = xs.len()
    if count > 0:
        need = start + count
        if runs.cap() < need: runs.reserve(need)
        __set_len(runs, need)
        dst = data(runs) + start
        src = data(xs)
        loop i in [0..count): dst[i] = i32(src[i])
    store[n].list2 = i32(start)
    store[n].nlist2 = i32(count)

node_append_raw = (runs: mut i32[], src: *int, count: int) -> int:
    start = runs.len()
    if count > 0:
        need = start + count
        if runs.cap() < need: runs.reserve(need)
        __set_len(runs, need)
        dst = data(runs) + start
        loop i in [0..count): dst[i] = i32(src[i])
    start

node_set_list_span = (store: mut Node[], runs: mut i32[], n: int, buf: mut int[], base: int):
    count = buf.len() - base
    start = node_append_raw(runs, data(buf) + base, count)
    if count > 0: __set_len(buf, base)
    store[n].list = i32(start)
    store[n].nlist = i32(count)

node_run_of = (runs: mut i32[], start: int, count: int) -> int[]:
    out: int[]
    if count > 0:
        out.reserve(count)
        __set_len(out, count)
        dst = data(out)
        src = data(runs) + start
        loop i in [0..count): dst[i] = int(src[i])
    out

node_kids = (store: mut Node[], runs: mut i32[], n: int) -> int[]: node_run_of(runs, int(store[n].list), int(store[n].nlist))
node_kids2 = (store: mut Node[], runs: mut i32[], n: int) -> int[]: node_run_of(runs, int(store[n].list2), int(store[n].nlist2))

node_clone_buf: int[]
node_clone = (store: mut Node[], runs: mut i32[], n: int) -> int:
    if n == 0: return 0
    sp = data(store)
    sh = (sp as *int) - 3
    if sp == null or sh[0] != 1 or sh[1] >= sh[2]:
        oc = store.len()
        ncap = oc * 2
        if oc + 1 > ncap: ncap = oc + 1
        store.reserve(ncap)
        sp = data(store)
        sh = (sp as *int) - 3
    c = sh[1]
    sh[1] = c + 1
    dst = sp + c
    mem_copy(dst as *u8, (sp + n) as *u8, size_of(Node))
    k = dst[0].kind
    if k != .fn_ and k != .struct_ and k != .enum_: dst[0].sym = 0
    if k != .conv: dst[0].type = 0
    dst[0].flags = i32(int(dst[0].flags) & ~NODE_CHECKED)
    na = int(dst[0].a)
    nb = int(dst[0].b)
    nc = int(dst[0].c)
    nd_ = int(dst[0].d)
    nl1 = int(dst[0].nlist)
    nl2 = int(dst[0].nlist2)
    if (na | nb | nc | nd_ | nl1 | nl2) == 0: return c
    l1 = int(dst[0].list)
    l2 = int(dst[0].list2)
    if na != 0:
        ra = i32(node_clone(store, runs, na))
        data(store)[c].a = ra
    if nb != 0:
        rb = i32(node_clone(store, runs, nb))
        data(store)[c].b = rb
    if nc != 0:
        rc = i32(node_clone(store, runs, nc))
        data(store)[c].c = rc
    if nd_ != 0:
        rd = i32(node_clone(store, runs, nd_))
        data(store)[c].d = rd
    if nl1 > 0:
        if nl1 == 1:
            c0 = i32(node_clone(store, runs, int(runs[l1])))
            lp = data(runs)
            lh = (lp as *int) - 3
            if lp == null or lh[0] != 1 or lh[1] >= lh[2]:
                os = runs.len()
                ncap = os * 2
                if os + 1 > ncap: ncap = os + 1
                runs.reserve(ncap)
                lp = data(runs)
                lh = (lp as *int) - 3
            start = lh[1]
            lh[1] = start + 1
            lp[start] = c0
            np = data(store) + c
            np[0].list = i32(start)
            np[0].nlist = i32(1)
        else if nl1 == 2:
            k0 = int(runs[l1])
            k1 = int(runs[l1 + 1])
            c0 = i32(node_clone(store, runs, k0))
            c1 = i32(node_clone(store, runs, k1))
            lp = data(runs)
            lh = (lp as *int) - 3
            if lp == null or lh[0] != 1 or lh[1] + 2 > lh[2]:
                os = runs.len()
                ncap = os * 2
                if os + 2 > ncap: ncap = os + 2
                runs.reserve(ncap)
                lp = data(runs)
                lh = (lp as *int) - 3
            start = lh[1]
            lh[1] = start + 2
            lp1 = lp + start
            lp1[0] = c0
            lp1[1] = c1
            np = data(store) + c
            np[0].list = i32(start)
            np[0].nlist = i32(2)
        else:
            base = node_clone_buf.len()
            loop i in [0..nl1):
                child = node_clone(store, runs, int(runs[l1 + i]))
                node_clone_buf.push(child)
            count = node_clone_buf.len() - base
            start = node_append_raw(runs, data(node_clone_buf) + base, count)
            __set_len(node_clone_buf, base)
            np = data(store) + c
            np[0].list = i32(start)
            np[0].nlist = i32(count)
    if nl2 > 0:
        base = node_clone_buf.len()
        loop i in [0..nl2):
            child = node_clone(store, runs, int(runs[l2 + i]))
            node_clone_buf.push(child)
        count = node_clone_buf.len() - base
        start = node_append_raw(runs, data(node_clone_buf) + base, count)
        __set_len(node_clone_buf, base)
        np = data(store) + c
        np[0].list2 = i32(start)
        np[0].nlist2 = i32(count)
    c

call_waits_never: bool[]
call_waits_none = (node: int) -> int: 0
call_waits_hook: (int) -> int = call_waits_none
call_waits_bind = (f: (int) -> int) -> int:
    call_waits_hook = f
    0

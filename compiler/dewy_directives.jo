# Dewy spellings of scoped settings and bundles (compiler/directives.jo).
use 'util.jo'
use 'ast.jo'
use 'ide.jo'
use 'check.jo'
use 'effects.jo'
use 'directives.jo'
use 'dewy_parse.jo'
use 'dewy_fast.jo'
use 'dewy_direct.jo'
use 'isolation.jo'

dw_dir_ident = (c: u8) -> bool:
    c >= 'a' and c <= 'z' or c >= 'A' and c <= 'Z' or c >= '0' and c <= '9' or c == '_'

# Before a Dewy source is parsed: read lib/directives.dewy when the source
# names a metatag the compiler does not know (a bundle, or a loop label).
dw_dir_dollars = true   # (the source being parsed has a metatag: blocks may hold settings)

# After a Dewy source is lexed: read lib/directives.dewy first when it names a
# metatag the compiler does not know (a bundle, or a loop label).
dw_dir_lexed = (file: int):
    dw_dir_dollars = dn_metatags > 0
    if not dw_dir_dollars or dir_bundles_loaded: return
    seen = 0
    unknown = false
    loop t in dn_tokens:
        if t.kind != .metatag: continue
        if not dw_dir_known(dn_payload(t)):
            unknown = true
            break
        seen += 1
        if seen >= dn_metatags: break
    if not unknown: return
    # (the lexed source waits while the bundles are parsed)
    tokens = dn_tokens
    at_file = dn_file
    suspect = dn_suspect_brace
    interpolation = dn_in_interpolation
    bigint = dw_bigint_import
    # (and the lexer's state: lazily lexed bodies left to expand, metatags seen)
    lazy_left = dn_lazy_left
    metatags = dn_metatags
    comments = dn_block_comments
    dw_dir_load()
    dn_lazy_left = lazy_left
    dn_metatags = metatags
    dn_block_comments = comments
    dn_tokens = tokens
    dn_file = at_file
    dn_suspect_brace = suspect
    dn_in_interpolation = interpolation
    dw_bigint_import = bigint
    dw_dir_dollars = true

dw_dir_load = ():
    dir_bundles_loaded = true
    path = lib_dir + "/directives.dewy"
    src = read_source(path)
    if src == none: return
    file = files.len()
    files.push(SrcFile(path, lib_dir, src!, true))
    made = dewy_fast_file(file)
    if made.len() != 0: fatal(nodes[made[0]].pos, "lib/directives.dewy defines bundles only")

# A directive statement's metatag and value syntax ((0, 0) when it is not one).
dw_dir_parts = (id0: int) -> (int, int):
    id = dw_unwrap(id0)
    if dewy_syntax[id].kind == .metatag: return (id, 0)
    if dw_op(id) == .assign:
        tag = dw_unwrap(dw_child(id, 1))
        if dewy_syntax[tag].kind == .metatag: return (tag, dw_unwrap(dw_child(id, 2)))
    (0, 0)

dw_dir_name = (name: str) -> bool:
    dir_builtin(name) or name == "realtime" or dir_bundle_index(intern(name)) >= 0

dw_dir_boolean = (name: str, value: int) -> int:
    if value == 0: return 1
    if dewy_syntax[value].kind != .boolean: fatal(dewy_syntax[value].pos, "`${name}` takes a literal true or false")
    if dewy_syntax[value].text == "false": 0 else: 1

# A setting or bundle written in a scope [start, end]; false when the
# statement is not one (labels and other directives keep their meaning).
dw_dir_statement = (statement: int, start: int, end: int, module: bool) -> bool:
    parts = dw_dir_parts(statement)
    tag = parts.0
    value = parts.1
    if tag == 0: return false
    name = dewy_syntax[tag].text
    if value != 0 and module and dewy_syntax[value].kind == .block and dewy_syntax[value].text == "{{}}:" and not dw_dir_known(name):
        dw_dir_define(name, tag, value)
        return true
    if not dw_dir_name(name): return false
    dir_set(intern(name), dw_dir_boolean(name, value), start, end, dewy_syntax[tag].pos)
    true

# The last source position inside a syntax tree (a scope's end).
dw_dir_last = (id: int) -> int:
    if id <= 0: return 0
    last = dewy_syntax[id].pos
    # (a compact statement or expression holds its syntax as nodes)
    k = dewy_syntax[id].kind
    if k == .compact_stmt or k == .compact_expr: return max(last, dw_dir_node_last(dewy_syntax[id].child_left))
    loop i in [0..dw_nchildren(id)):
        p = dw_dir_last(dw_child(id, i))
        if p > last: last = p
    last

dw_dir_node_last = (n: int) -> int:
    if n <= 0 or n >= nodes.len(): return 0
    last = nodes[n].pos
    mask = isolation_children(nodes[n].kind)
    if mask < 0: mask = 1 | 2 | 4 | 16
    if mask & 1 != 0: last = max(last, dw_dir_node_last(int(nodes[n].a)))
    if mask & 2 != 0: last = max(last, dw_dir_node_last(int(nodes[n].b)))
    if mask & 4 != 0: last = max(last, dw_dir_node_last(int(nodes[n].c)))
    if mask & 16 != 0:
        loop c in kids(n): last = max(last, dw_dir_node_last(c))
    # (a position in another file is not this scope's)
    if pos_file(last) != pos_file(nodes[n].pos): return nodes[n].pos
    last

# A block's settings hold throughout the block, wherever they are written.
dw_dir_block = (block: int, children: int[]) -> int[]:
    if not dw_dir_dollars: return children
    found = false
    loop child in children:
        tag = dw_dir_parts(child).0
        if tag != 0 and dw_dir_name(dewy_syntax[tag].text): found = true
    if not found: return children
    start = dewy_syntax[block].pos
    end = dw_dir_last(block)
    rest: int[]
    loop child in children:
        if not dw_dir_statement(child, start, end, false): rest.push(child)
    rest

# `$name = { $setting  $setting=false  $default_row = <row> }`
dw_dir_define = (name: str, tag: int, block: int):
    at = dewy_syntax[tag].pos
    if dir_builtin(name) or name == "realtime": fatal(at, "`${name}` is a builtin setting, not a bundle")
    if dir_bundle_index(intern(name)) >= 0: fatal(at, "the bundle `${name}` is already defined")
    bundle = DirBundle(intern(name), [], [], 0, at)
    loop child in dw_children(block):
        parts = dw_dir_parts(child)
        member = parts.0
        value = parts.1
        if member == 0: fatal(dewy_syntax[child].pos, "a bundle lists settings: `$name`, `$name=false`, or `$default_row = <effect row>`")
        text = dewy_syntax[member].text
        if text == "default_row":
            if value == 0 or bundle.row != 0: fatal(dewy_syntax[member].pos, "`$default_row` takes one effect row, as written after `&` on a function: `$default_row = no allocates`")
            entries: EffectSyntax[]
            empty = false
            # (a bundle's row demands what it excludes only where it is applied: dir_apply_rows)
            saved_demand = effect_panics_demanded
            dw_dir_row(value, entries, empty)
            effect_panics_demanded = saved_demand
            effect_syntax.push(entries)
            bundle.row = effect_syntax.len() - 1
            continue
        if text == "unsafe": fatal(dewy_syntax[member].pos, "`$unsafe` cannot be bundled: write it where the unsafe code is, so each boundary is visible")
        if text == "audited_wait": fatal(dewy_syntax[member].pos, "`$audited_wait` cannot be bundled: write it in each audited adapter, so each audit is visible")
        if not dir_builtin(text): fatal(dewy_syntax[member].pos, "a bundle lists builtin settings (`$runtime_checks`, `$prototype`, `$prototype_warnings`, `$explicit_copies`) and `$default_row`, not `${text}`")
        bundle.settings.push(intern(text))
        bundle.values.push(dw_dir_boolean(text, value))
    dir_bundles.push(bundle)

dw_dir_row = (id0: int, entries: mut EffectSyntax[], empty: mut bool):
    id = dw_unwrap(id0)
    if dw_op(id) == .amp:
        dw_dir_row(dw_child(id, 1), entries, empty)
        dw_dir_row(dw_child(id, 2), entries, empty)
        return
    dw_effect_atom(id, entries, empty)

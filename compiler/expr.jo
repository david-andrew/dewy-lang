        else if k == .secret: fatal(nodes[n].pos, "a {dt(t)} is never written as JSON: its value is hidden (a field holding `x.reveal` writes it, where showing it is intended)")
        else: fatal(nodes[n].pos, "a value of type {dt(t)} cannot be written as JSON")
        refs: int[]
        loop ft in fts:

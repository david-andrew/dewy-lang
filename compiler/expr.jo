        if not fmt_plain.has(n) and int(nodes[n].aux2) & FMT_DEWY == 0: sf = program_str_fn(t, nodes[n].pos)
        if sf != 0:
            pos = nodes[n].pos
            plain = nodes.len()
            nodes.push(nodes[n])
            fmt_plain[plain] = true
            pt = check_intrinsic(plain, .fmt_struct, args, 0)
            if nodes[plain].type == 0: nodes[plain].type = i32(pt)
            add_flag(plain, NF_CHECKED)
            inner = mk(.call, pos)
            nodes[inner].a = i32(bc_ident("str", pos))
            set_list(inner, [args[1]])
            nodes[inner].sym = i32(sf)
            nodes[inner].type = i32(T_STR)
            add_flag(inner, NF_CHECKED)
            b0 = clone(args[0])
            clear_flag(b0, NF_CHECKED)
            shown = bc_call("__buf_append_str", [b0, inner], pos)
            iff = mk(.if_, pos)

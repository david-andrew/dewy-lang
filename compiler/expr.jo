        if sf != 0:
            pos = nodes[n].pos
            plain = nodes.len()
            nodes.push(nodes[n])
            fmt_plain[plain] = true
            pt = check_intrinsic(plain, int(IN.fmt_struct), args, 0)
            if nodes[plain].type == 0: nodes[plain].type = i32(pt)
            add_flag(plain, NF_CHECKED)
            inner = mk(.call, pos)
            nodes[inner].a = i32(bc_ident("str", pos))
            set_list(inner, [args[1]])
            nodes[inner].sym = i32(sf)
            nodes[inner].type = i32(T_STR)
            add_flag(inner, NF_CHECKED)
            b0 = clone(args[0])
            clear_flag(b0, NF_CHECKED)
            shown = bc_call("__buf_append_str", [b0, inner], pos)
            iff = mk(.if_, pos)
            nodes[iff].a = i32(bc_ident("__text_exact", pos))
            nodes[iff].b = i32(bc_block([bc_stmt(plain, pos)], pos))
            nodes[iff].c = i32(bc_block([bc_stmt(shown, pos)], pos))
            nodes[n] = nodes[iff]
            return check_expr(n, 0)
        bt = mk_array(T_U8)
        fts: int[]
        k = types[t].kind
        if k == .struct_:
            si = int(types[t].st)
            check_struct_fields(si)
            loop i in fmt_field_order(si):
                ft = int(fields[int(structs[si].fields) + i].type)
                if not fmt_hidden(ft, nodes[n].aux2): fts.push(ft)
        else if k == .tuple:
            loop i in [0..int(types[t].nargs)): fts.push(targ(t, i))
        else if k == .enum_:
            si = int(types[t].st)
            check_struct_fields(si)
            loop v in [0..int(structs[si].nvariants)):
                vi = int(structs[si].variants) + v
                loop i in [0..int(variants[vi].nfields)): fts.push(int(fields[int(variants[vi].fields) + i].type))
        else if k == .vec: runtime_demand(if types[t].sign: "__fmt_i32" else: "__fmt_f32")
        else if k == .fn_: pass
        else: fatal(nodes[n].pos, "cannot format a value of type {dt(t)}")
        refs: int[]
        # (a union shows just its value: quoted inside a container, as a string would be)
        dewy = int(nodes[n].aux2) & FMT_DEWY != 0
        top = is_union(t) and int(nodes[n].aux2) & 1 == 0
        fname = ci(20, "__fmt_elem")
        if top: fname = ci(21, "__fmt")
        if dewy and top: fname = ci(22, "__dewy_fmt")
        else if dewy: fname = ci(23, "__dewy_fmt_elem")
        loop ft in fts:
            ref = mk(.fnref, nodes[n].pos)
            # (a union's void member shows as `void`: the text lowering appends)
            if is_union(t) and tkind(ft) == .void_: nodes[ref].sym = i32(resolve_by_types(intern("__buf_append_str"), [bt, T_STR], nodes[n].pos, true))
            else: nodes[ref].sym = i32(resolve_by_types(fname, [bt, ft], nodes[n].pos, true))
            refs.push(ref)
        set_list2(n, refs)
    else if id == .hash:
        # (a second argument, `true`: the dictionaries' keyed hash, lib/core/map.jo)
        nargs_check(n, nargs, 1, 2, "__hash_value")
        hashed = arg_type(args, 0, 0)
        if nargs == 1 and (is_union(hashed) or tkind(hashed) == .opt): return union_hash(n, args[0], hashed, expected)
        note_value_helpers(hashed, true)
        if nargs == 2:
            arg_type(args, 1, T_BOOL)
            if nodes[args[1]].kind != .bool_lit: fatal(nodes[args[1]].pos, "__hash_value's second argument is a literal `true` (keyed)")
            demand_name(intern("__hash_key"))
            loop name in ["__hk_word", "__hk_mix", "__str_khash"]: runtime_demand(name)
        r = T_U64
    else if id == .shader:
        nargs_check(n, nargs, 2, 2, "shader")
        # (the fragment function first: a generic vertex function, as the library's effect_vs[U],
        # is made for its input and uniforms)
        loop i in [1, 0]:
            a = args[i]
            if nodes[a].kind != .ident: fatal(nodes[a].pos, "shader() takes the names of a vertex and a fragment function")
            want = 0
            if i == 0 and nodes[args[1]].kind == .fnref:
                ff = int(nodes[args[1]].sym)
                vd: int[]
                collect_fns(int(nodes[a].name), &vd)
                if vd.len() == 1 and fn_sig(vd[0]).generic and nkids(vd[0]) == 2 and fns[ff].ptypes.len() == 2:
                    want = mk_fn([fn_sig(vd[0]).params[0], fns[ff].ptypes[1]], fns[ff].ptypes[0], 0)
            check_expr(a, want)
            if nodes[a].kind != .fnref: fatal(nodes[a].pos, "expected a function name")
            f = int(nodes[a].sym)
            np = fns[f].ptypes.len()
            if np != 2 and not (i == 0 and np == 3): fatal(nodes[a].pos, "shader functions take (input, uniforms); vertex functions may also take (input, instance, uniforms)")
        vsf = int(nodes[args[0]].sym)
        fsf = int(nodes[args[1]].sym)
        if not type_eq(int(fns[vsf].ret), fns[fsf].ptypes[0]): fatal(nodes[n].pos, "the fragment function's input must be the vertex function's output type")
        if not type_eq(fns[vsf].ptypes[fns[vsf].ptypes.len() - 1], fns[fsf].ptypes[1]): fatal(nodes[n].pos, "both shader functions must take the same uniforms type")
        if not type_eq(int(fns[fsf].ret), T_VEC4): fatal(nodes[n].pos, "the fragment function must return a vec4 color")
        # The shader intrinsic synthesizes this type without a source-level
        # reference, so it must demand the module just like an ordinary name.
        s = module_lookup(-1, ci(24, "ShaderSource"))
        if s == 0: fatal(nodes[n].pos, "ShaderSource is not available")
        r = get_struct_inst(int(syms[s].ref), [])
    else if id == .setjmp:
        nargs_check(n, nargs, 1, 1, "__setjmp")
        arg_type(args, 0, T_RAWPTR)
        r = T_INT
    else if id == .longjmp:
        nargs_check(n, nargs, 2, 2, "__longjmp")
        arg_type(args, 0, T_RAWPTR)
        arg_type(args, 1, T_INT)
        r = T_NEVER
    else if id == .jump:
        nargs_check(n, nargs, 2, 2, "__jump")
        arg_type(args, 0, T_RAWPTR)
        arg_type(args, 1, T_RAWPTR)
        r = T_NEVER
    else if id == .clone_thread:
        nargs_check(n, nargs, 3, 3, "__clone_thread")
        arg_type(args, 0, T_RAWPTR)
        arg_type(args, 1, T_INT)
        arg_type(args, 2, T_RAWPTR)
        r = T_INT
    else if id == .atomic_add:
        nargs_check(n, nargs, 2, 2, "__atomic_add")
        arg_type(args, 0, mk_ptr(T_INT))
        arg_type(args, 1, T_INT)
        r = T_INT
    else if id == .atomic_cas:
        nargs_check(n, nargs, 3, 3, "__atomic_cas")
        arg_type(args, 0, mk_ptr(T_INT))
        arg_type(args, 1, T_INT)
        arg_type(args, 2, T_INT)
        r = T_INT
    else if id == .gpu_kernel:
        # __gpu_kernel(lambda, desc): the GLSL fragment program (see glsl_kernel)
        nargs_check(n, nargs, 2, 2, "__gpu_kernel")
        if nodes[args[0]].kind != .lambda or nodes[args[1]].kind != .str_lit: fatal(nodes[n].pos, "__gpu_kernel takes a function literal and a string")
        check_expr(args[0], 0)
        exact_shader_roots.push(int(nodes[args[0]].sym))
        r = T_STR
    else if id == .compute:
        # compute(f): a GPU program run once per element, f(id: int, params: P) (lib/game/gpubuffer.jo),
        # or once per cell of a grid, f(id: ivec2 or ivec3, params: P); becomes
        # __compute(__compute_spirv(f), f) (__compute2 or __compute3 for a grid): the program for
        # Vulkan, and f itself for the CPU
        nargs_check(n, nargs, 1, 1, "compute")
        a = args[0]
        if nodes[a].kind != .ident: fatal(nodes[a].pos, "compute() takes the name of a function (id: int, params: P)")
        # (of the functions with that name, the one shaped like a compute function)
        want = 0
        decls: int[]
        collect_fns(int(nodes[a].name), &decls)
        loop d in decls:
            sig = fn_sig(d)
            if not sig.generic and sig.params.len() == 2 and (prune(sig.params[0]) == T_INT or prune(sig.params[0]) == T_IVEC2 or prune(sig.params[0]) == T_IVEC3) and tkind(sig.params[1]) == .struct_ and tkind(int(sig.ret)) == .void_:
                want = mk_fn(sig.params, T_VOID, 0)
        check_expr(a, want)
        if nodes[a].kind != .fnref: fatal(nodes[a].pos, "expected a function name")
        f = int(nodes[a].sym)
        it0 = prune(fns[f].ptypes[0])
        if fns[f].ptypes.len() != 2 or (it0 != T_INT and it0 != T_IVEC2 and it0 != T_IVEC3) or tkind(fns[f].ptypes[1]) != .struct_:
            fatal(nodes[a].pos, "a compute function takes (id: int, params: P), P a struct (or id: ivec2 or ivec3, over a grid)")
        if tkind(int(fns[f].ret)) != .void_: fatal(nodes[a].pos, "a compute function returns nothing: it writes its results into GPU buffers")
        if fns[f].decl != 0 and files[pos_file(nodes[int(fns[f].decl)].pos)].is_dewy and not pos_in_lib(nodes[int(fns[f].decl)].pos):
            gpu_word_memory(fns[f].ptypes[1], dt(prune(fns[f].ptypes[1])), nodes[a].pos, 0)
        exact_shader_roots.push(f)
        ref = mk(.fnref, nodes[a].pos)
        nodes[ref].sym = nodes[a].sym
        nodes[ref].type = nodes[a].type
        ref2 = mk(.fnref, nodes[a].pos)
        nodes[ref2].sym = nodes[a].sym
        nodes[ref2].type = nodes[a].type
        mkname = "__compute"
        if prune(fns[f].ptypes[0]) == T_IVEC2: mkname = "__compute2"
        if prune(fns[f].ptypes[0]) == T_IVEC3: mkname = "__compute3"
        call = bc_call(mkname, [bc_call("__compute_spirv", [ref], nodes[n].pos), bc_call("__compute_textures", [ref2], nodes[n].pos), a], nodes[n].pos)
        nodes[n] = nodes[call]
        return check_expr(n, expected)
    else if id == .compute_spirv or id == .compute_textures:
        nargs_check(n, nargs, 1, 1, "__compute_spirv")
        if nodes[args[0]].kind != .fnref: fatal(nodes[n].pos, "__compute_spirv takes a function")
        r = T_STR
    else if id == .default_init:
        # __default_init(x): a struct gets its fields' default values (anything else is zero already)
        nargs_check(n, nargs, 1, 1, "__default_init")
        t = prune(arg_type(args, 0, 0))
        pos = nodes[n].pos
        stmts: int[]
        if types[t].kind == .struct_ and not is_map_type(t):
            si = int(types[t].st)
            check_struct_fields(si)
            has_def = false
            loop i in [0..int(structs[si].nfields)):
                if fields[int(structs[si].fields) + i].defval != 0: has_def = true
            if has_def:
                d = mk(.call, pos)
                struct_ctor_zero(d, t, int(structs[si].decl))
                add_flag(d, NF_CHECKED)
                stmts.push(bc_assign(bc_ident(name_of(int(nodes[args[0]].name)), pos), d, pos))
        nodes[n] = nodes[bc_block(stmts, pos)]
        return check_expr(n, expected)
    else if id == .setting_read:
        # __setting_read("time.zone"), `$time.zone`: the setting where this is read, or at the
        # call a parameter's default is filled in for; none when no scope sets it
        pos = nodes[n].pos
        scope = dir_find(int(nodes[args[0]].sval), if setting_site != 0: setting_site else: pos)
        if dir_program_setting(name_of(int(nodes[args[0]].sval))):
            scope = dir_program_values.get(int(nodes[args[0]].sval)) ?? -1
        if scope < 0 or dir_scopes[scope].value < 2:
            nodes[n] = Node(kind = .none_lit, pos = pos)
            return check_expr(n, expected)
        value = dir_scopes[scope].value - 2
        # (`$time.zone = 'build'`: the machine doing this build, pinned now)
        if value == intern("build") and name_of(int(nodes[args[0]].sval)) == "time.zone":
            host = __system_zone_name()
            if len(host) == 0: fatal(dir_scopes[scope].at, "`$time.zone = 'build'` pins the zone of the machine building this, and this machine does not name one: name the zone instead, as `$time.zone = 'America/New_York'`")
            value = intern(host)
        nodes[n] = Node(kind = .str_lit, pos = pos, sval = i32(value))
        return check_expr(n, expected)
    else if id == .read_fields:
        # __read_fields(r, x): the code that reads a struct, tuple, enum, union, vector or fixed-size
        # array from text, field by field (lib/std/text.jo)
        nargs_check(n, nargs, 2, 2, "__read_fields")
        arg_type(args, 0, 0)
        t = prune(arg_type(args, 1, 0))
        pos = nodes[n].pos
        stmts = read_code(t, name_of(int(nodes[args[0]].name)), name_of(int(nodes[args[1]].name)), pos)
        nodes[n] = nodes[bc_block(stmts, pos)]
        return check_expr(n, expected)
    else if id == .fmt_elem:
        # __fmt_elem_value(buf, x): x inside a container (strings quoted): a union formats its
        # member that way; anything else is __fmt(buf, x)
        nargs_check(n, nargs, 2, 2, "__fmt_elem_value")
        t = arg_type(args, 1, 0)
        if is_union(t):
            nodes[n].aux = i32(int(IN.fmt_struct))
            nodes[n].aux2 = 1
            return check_intrinsic(n, int(IN.fmt_struct), args, expected)
        # (a Dewy object with its own text, `__as__` to string, as a rational in a matrix: that text)
        if tkind(t) == .struct_ and as_conversion(prune(t), T_STR) != 0:
            nodes[n] = nodes[bc_call("__dewy_fmt_elem", args, nodes[n].pos)]
            return check_expr(n, expected)
        c = mk(.call, nodes[n].pos)
        callee = mk(.ident, nodes[n].pos)
        nodes[callee].name = i32(ci(25, "__fmt"))
        nodes[c].a = i32(callee)
        set_list(c, args)
        nodes[n] = nodes[c]
        return check_expr(n, expected)
    else if id == .dewy_fmt or id == .dewy_fmt_elem:
        # __dewy_fmt_value(buf, x): Dewy's text for what the library's overloads leave: an
        # object through its `__as__` to string, or field by field as [x=1 name="q"]; a union
        # as its member; anything else (numbers, library types) as the library writes it
        elem = id == .dewy_fmt_elem
        nargs_check(n, nargs, 2, 2, "__dewy_fmt_value")
        arg_type(args, 0, 0)
        t = arg_type(args, 1, 0)
        pos = nodes[n].pos
        if is_quantity(t):
            shown = quantity_display(args[1])
            if shown == 0: shown = quantity_number(args[1])
            nodes[n] = nodes[bc_call("__dewy_fmt", [args[0], shown], pos)]
            return check_expr(n, 0)
        bt = mk_array(T_U8)
        k = types[t].kind
        own = is_union(t) or k == .tuple or str_set_of(t) != 0
        if k == .struct_:
            conv = as_conversion(t, T_STR)
            if conv != 0:
                inner = mk(.call, pos)
                nodes[inner].a = i32(bc_ident("__as__", pos))
                set_list(inner, [args[1]])
                nodes[inner].type = i32(resolve_fn_call(inner, ci(26, "__as__"), [conv], [args[1]], T_STR))
                add_flag(inner, NF_CHECKED)
                nodes[n] = nodes[bc_call("__buf_append_str", [args[0], inner], pos)]
                return check_expr(n, 0)
            # (a library type the library writes, as a BigInt: as it writes it)
            jo = resolve_by_types(ci(27, "__fmt"), [bt, t], pos, false)
            own = jo == 0 or fmt_fallback(jo)
        if own:
            nodes[n].aux = i32(int(IN.fmt_struct))
            nodes[n].aux2 = i32(FMT_DEWY)
            if elem: nodes[n].aux2 = i32(FMT_DEWY | 1)
            return check_intrinsic(n, int(IN.fmt_struct), args, expected)
        # (inside a structure, a container as it is on its own: a call, which copies a
        # fixed-size array into the T[] the library's overload takes)
        writer = "__fmt"
        # (a matrix in a list: on one line, as the library writes one inside a structure, not
        # as a T[], which it is only when 1-D)
        if elem: writer = if is_nd(t): "__fmt_elem" else: "__dewy_fmt"
        # (refined elements are written as their base: the library's overloads take the base)
        plain = representation_deep(t)
        if not type_eq(plain, t): wrap_conv(args[1], .none_, plain)
        c = bc_call(writer, args, pos)
        nodes[n] = nodes[c]
        return check_expr(n, expected)
    else if id == .fill:
        # fill(value, n): an array of n copies of value
        nargs_check(n, nargs, 2, 2, "fill")
        arr = mk(.array, nodes[n].pos)
        set_list(arr, [args[0]])
        nodes[arr].b = i32(args[1])
        nodes[n] = nodes[arr]
        return check_expr(n, expected)
    else if id == .cpu_features:
        # bit 0: AVX2 can be used (the processor has it and the system saves its registers)
        nargs_check(n, nargs, 0, 0, "__cpu_features")
        r = T_INT
    else if id == .code_sync:
        # machine code written at p (n bytes) made ready to run (arm64: through the caches)
        nargs_check(n, nargs, 2, 2, "__code_sync")
        arg_type(args, 0, T_RAWPTR)
        arg_type(args, 1, T_INT)
        r = T_INT
    else if id == .stack_ptr:
        nargs_check(n, nargs, 0, 0, "__stack_ptr")
        r = T_RAWPTR
    else if id == .callc:
        # __call_raw(f, args...): call the code at f the way Sloppy functions are called (the
        # software renderer's shader functions: the address of a function with pointer arguments)
        if nargs < 1: fatal(nodes[n].pos, "__call_raw takes a function's address and its arguments")
        loop i in [0..nargs): arg_type(args, i, T_RAWPTR)
        r = T_VOID
    else: fatal(nodes[n].pos, "unsupported intrinsic")
    nodes[n].type = i32(r)
    if refine_active: return ref_length_mutation(n, r)
    r

check_vec_ctor = (n: int, t: int, args: int[]) -> int:
    # vecN(x, y, ...) with scalars and/or smaller vectors; vecN(s) splats; mat4(...) 16 floats or none
    total = 0
    ct = vec_comp_type(t)
    loop a in args:
        if nodes[a].kind == .namedarg: fatal(nodes[a].pos, "named arguments are not supported here")
        at = prune(check_expr(a, ct))
        add_flag(a, NF_CHECKED)
        if types[at].kind == .vec:
            total += vec_n(at)
        else:
            if is_int(ct) and is_int(at) and not is_lit(a) and not can_coerce(a, at, ct):
                # (ivec2(x, y) with ints: their i32s, as i32(x) makes them)
                c = mk(.call, nodes[a].pos)
                nodes[c].a = i32(bc_ident(type_str(ct), nodes[a].pos))
                inner = nodes.len()
                nodes.push(nodes[a])
                set_list(c, [inner])
                nodes[a] = nodes[c]
                check_expr(a, ct)
            else if is_lit(a) or is_numeric(at) or (is_float(ct) and bundled_rational_type(at)): coerce(a, ct)
            else: fatal(nodes[a].pos, "expected a number or vector, found {dt(at)}")
            total += 1
    want = vec_n(t)
    if args.len() != 0 and total != want and not (args.len() == 1 and total == 1):
        fatal(nodes[n].pos, "{dt(t)}(...) needs {want} components, got {total}")
    nodes[n].kind = .intrinsic
    nodes[n].aux = i32(int(IN.vec_ctor))
    set_list(n, args)
    nodes[n].a = 0
    nodes[n].type = i32(t)
    t

swizzle_chars = "xyzwrgbastpq"
# whether every letter of a member name is a vector component letter (`xy`, `rgb`)
swizzle_name = (name: int) -> bool:
    s = name_of(name)
    if len(s) < 1 or len(s) > 4: return false
    loop i in [0..len(s)):
        if swizzle_index(s[i]) < 0: return false
    true

# ---------------- operators ----------------
# a call with n arguments can go to declaration d (as many parameters, or fewer with defaults)
args_fit = (d: int, n: int) -> bool:
    np = nkids(d)
    if n > np: return false
    loop i in [n..np):
        if nodes[kid(d, i)].b == 0: return false
    true

# d's first parameter is an array or a string as written (or has no type: generic)
takes_seq = (d: int) -> bool:
    if nkids(d) == 0: return false
    tn = int(nodes[kid(d, 0)].a)
    if tn == 0: return true
    nodes[tn].kind == .tarray or (nodes[tn].kind == .tname and name_of(int(nodes[tn].name)) == "str")

decl_in_prelude = (d: int) -> bool: d != 0 and modules[int(nodes[d].mod)].is_prelude

# Dewy's named operator functions use the same overloads and specialization as
# implementation-language symbolic declarations. Keep their real names intact
# so explicit calls, imports and editor references remain ordinary functions.
dewy_operator_name = (op: str, unary: bool) -> str:
    if unary:
        if op == "-": return "__unary_sub__"
        if op == "~": return "__not__"
        return ""
    match op:
        "+": "__add__"
        "-": "__sub__"
        "*": "__mul__"
        "/": "__truediv__"
        "//": "__floordiv__"
        "**": "__pow__"
        "%": "__mod__"
        "==": "__eq__"
        "!=": "__ne__"
        "<": "__lt__"
        "<=": "__le__"
        ">": "__gt__"
        ">=": "__ge__"
        "<<": "__lshift__"
        ">>": "__rshift__"
        "&": "__and__"
        "|": "__or__"
        "^": "__xor__"
        _: ""

op_overload = (n: int, opname: str) -> int:
    decls: int[]
    nm = intern(opname)
    collect_fns(nm, &decls)
    tm = module_of_type(ntype(int(nodes[n].a)))
    if tm >= 0: collect_module(tm, nm, &decls)
    if nodes[n].b != 0:
        tm2 = module_of_type(ntype(int(nodes[n].b)))
        if tm2 >= 0: collect_module(tm2, nm, &decls)
    protocol = dewy_operator_name(opname, nodes[n].b == 0)
    if protocol != "":
        pn = intern(protocol)
        collect_fns(pn, &decls)
        if tm >= 0: collect_module(tm, pn, &decls)
        if nodes[n].b != 0:
            pm = module_of_type(ntype(int(nodes[n].b)))
            if pm >= 0: collect_module(pm, pn, &decls)
    if decls.len() == 0: return 0
    a = int(nodes[n].a)
    b = int(nodes[n].b)
    # (only overloads the operands could be given to: otherwise the operator is just undefined
    # for these types, which says more than why some unrelated overload does not fit)
    ops = [a]
    if b != 0: ops.push(b)
    fit: int[]
    loop d in decls:
        if nkids(d) < ops.len(): continue
        # (parameters past the operands take their defaults: a caller's `$time.fold`)
        defaulted = true
        loop i in [ops.len()..nkids(d)):
            if nodes[kid(d, i)].b == 0: defaulted = false
        if not defaulted: continue
        sig = fn_sig(d)
        binds = fill(0, int(sig.ntp))
        ok = true
        loop i in 0.. and x in ops:
            if arg_cost(x, sig.params[i], binds) < 0: ok = false
        if ok: fit.push(d)
    if fit.len() == 0: return 0
    decls = fit
    add_flag(a, NF_CHECKED)
    args = [a]
    if b != 0:
        add_flag(b, NF_CHECKED)
        args.push(b)
    nodes[n] = Node(kind = .call, pos = nodes[n].pos)
    set_list(n, args)
    result = resolve_fn_call(n, nm, decls, args, 0)
    if b != 0 and (opname == "/" or opname == "//" or opname == "%") and dir_panics_demanded(): rational_divisor(n)
    if opname in ["==", "!=", "<", "<=", ">", ">="] and prune(result) != T_BOOL:
        fatal(nodes[n].pos, "comparison operator {opname} must return bool, found {dt(result)}")
    result

is_struct_like = (t0: int) -> bool:
    t = prune(t0)
    k = types[t].kind
    k == .struct_ or k == .tuple or (k == .enum_ and not simple_enum(t))

spread_count = 0

# a type expression node for an already resolved type (for synthesized declarations)
type_node_of = (t: int, pos: int) -> int:
    n = mk(.tname, pos)
    nodes[n].aux = -7
    nodes[n].ival = t
    n

# a one-character string literal standing for its character code
# the character of the source at position p (0 past its end)
# (the value of an argument written as a whole number alone, 6 and not 6.0 or 5 + 1, even where
# it became a float; -1 for anything else: 5 + 1 says the number is meant)
written_int = (a: int) -> int:
    if a == 0 or not is_lit(a): return -1
    if nodes[a].kind != .int_lit and nodes[a].kind != .float_lit: return -1
    f = pos_file(nodes[a].pos)
    if f < 0 or f >= files.len(): return -1
    src = files[f].src
    o = pos_off(nodes[a].pos)
    if o >= len(src) or not is_digit(src[o]): return -1
    loop o < len(src) and is_digit(src[o]): o += 1
    loop o < len(src) and src[o] == ' ': o += 1
    if o >= len(src) or (src[o] != ')' and src[o] != ','): return -1
    if nodes[a].kind == .int_lit: return nodes[a].ival
    int(nodes[a].fval)

charlike = (n: int) -> bool: nodes[n].kind == .str_lit and has_flag(n, NF_CHARLIKE)

charlike_to_int = (n: int):
    s = name_of(int(nodes[n].sval))
    v = int(s[0])
    if len(s) > 1:
        # UTF-8 sequence -> code point
        v = v & (0x3f >> (len(s) - 1))
        loop i in [1..len(s)): v = (v << 6) | (int(s[i]) & 0x3f)
    nodes[n].kind = .int_lit
    nodes[n].ival = v
    nodes[n].aux = 1
    add_flag(n, NF_LITERAL)
    clear_flag(n, NF_CHARLIKE)

# Collection literals take their element context from a typed operand.
# Unwrap an optional only for the literal; the normal equality path adds its tag.
binary_literal_context = (n: int, t0: int, op: Tok) -> bool:
    t = prune(t0)
    if types[t].kind == .opt: t = prune(int(types[t].elem))
    if dewy_set_literal(n): return is_dewy_set_type(t)
    if op != .eq and op != .ne: return false
    if nodes[n].kind == .record_lit: return dewy_record_target(t) != 0
    if nodes[n].kind == .map_lit: return is_map_type(t)
    if nodes[n].kind == .array:
        if nkids(n) == 0 and (is_map_type(t) or dewy_record_target(t) != 0): return true
        return types[t].kind == .array or types[t].kind == .fixed or types[t].kind == .tuple and nkids(n) == int(types[t].nargs)
    false

# the string-literal union a container's members or keys are (0 if not one)
membership_str_set_of = (t0: int) -> int:
    t = prune(t0)
    k = types[t].kind
    if k == .array or k == .fixed: return if str_set_of(int(types[t].elem)) != 0: prune(int(types[t].elem)) else: 0
    if is_map_type(t) or is_dewy_set_type(t):
        key = struct_targ(int(types[t].st), 0)
        return if str_set_of(key) != 0: prune(key) else: 0
    0

# `word in? members(Op)` with a plain string: a text that is no member is simply not in the
# container, so it is tested first, `word is? Op and ...`, rather than converted (which fails).
# The needle and then the container are evaluated once each, in that order. 0: not this case.
membership_str_set = (n: int) -> int:
    needle = int(nodes[n].a)
    container = int(nodes[n].b)
    pos = nodes[n].pos
    tc = prune(check_expr(container, 0))
    container = last_checked
    nodes[n].b = i32(container)
    add_flag(container, NF_CHECKED)
    u = membership_str_set_of(tc)
    if u == 0: return 0
    tn = prune(check_expr(needle, 0))
    needle = last_checked
    nodes[n].a = i32(needle)
    add_flag(needle, NF_CHECKED)
    if tn != T_STR: return 0
    statements: int[]
    held = int(nodes[capture_value(needle, T_STR, statements)].sym)
    source = int(nodes[capture_value(container, tc, statements)].sym)
    call = mk(.call, pos)
    callee = mk(.field, pos)
    nodes[callee].a = i32(mk_ident_local(source, pos))
    nodes[callee].name = i32(intern("contains"))
    nodes[call].a = i32(callee)
    key = mk_ident_local(held, pos)
    add_flag(key, NF_CHECKED)
    str_set_coerce(key, u, true)  # the generated membership guard dominates this use
    set_list(call, [key])
    guarded = bc_logic(.and_, shape_is(mk_ident_local(held, pos), u, pos), call, pos)
    if prune(check_expr(guarded, T_BOOL)) != T_BOOL: fatal(pos, "membership's contains function must return bool")
    result = mk(.exprstmt, pos)
    nodes[result].a = i32(last_checked)
    statements.push(result)
    nodes[n] = Node(kind = .block, pos = pos, type = i32(T_BOOL))
    nodes[n].aux = 1
    set_list(n, statements)
    add_flag(n, NF_CHECKED)
    last_checked = n
    T_BOOL

# `d.get(word)` with d:dict<Op V> (or a set or array of Op) and a plain string: as for `in?`, a
# text that is no member is no key, so it is tested first and the method's result for an
# absent key given: none, the default, false, 0 or Missing. The receiver, the key and the rest
# are evaluated once each, in that order. 0: not this case (the key converts as before).
method_str_set_key = (n: int, recv: int, rt: int, fname: int, args: mut int[], expected: int) -> int:
    u = membership_str_set_of(rt)
    if u == 0 or args.len() == 0 or args.len() > 2 or nodes[args[0]].kind == .namedarg or nodes[args[0]].kind == .str_lit: return 0
    name = name_of(fname)
    one = args.len() == 1
    keyed = is_map_type(rt) or is_dewy_set_type(rt)
    k = types[prune(rt)].kind
    listed = k == .array or k == .fixed
    # (what an absent key gives: 1 none, 2 the default, 3 false, 4 zero, 5 Missing)
    miss = 0
    if is_map_type(rt) and name == "get": miss = if one: 1 else: 2
    else if keyed and name == "pop" and not one: miss = 2
    else if keyed and one and (name == "contains" or name == "has" or name == "remove"): miss = 3
    else if listed and one and name == "contains": miss = 3
    else if listed and one and name == "count": miss = 4
    else if listed and one and name == "index_of": miss = 5
    if miss == 0 or program_fn_named(fname): return 0
    changes = name == "pop" or name == "remove"
    if changes and not dewy_plain_route(recv): return 0
    pos = nodes[n].pos
    tk = prune(check_expr(args[0], 0))
    args[0] = last_checked
    add_flag(args[0], NF_CHECKED)
    if tk != T_STR: return 0
    statements: int[]
    # (a receiver changed in place is a variable or field, read where it is used)
    target = recv
    if not changes: target = capture_value(recv, rt, statements)
    held = int(nodes[capture_value(args[0], T_STR, statements)].sym)
    # (in the test's true branch the text is a member: converted, it is no string)
    key = mk_ident_local(held, pos)
    add_flag(key, NF_CHECKED)
    str_set_coerce(key, u, true)  # checked by the generated shape_is guard below
    rest: int[] = [key]
    absent = 0
    if not one:
        rest.push(args[1])
        absent = clone(unnamed(args[1]))
    if miss == 1: absent = mk(.none_lit, pos)
    else if miss == 3: absent = bc_bool(false, pos)
    else if miss == 4: absent = bc_int(0, pos)
    else if miss == 5: absent = bc_call("Missing", [], pos)
    call = mk(.call, pos)
    callee = mk(.field, pos)
    nodes[callee].a = i32(target)
    nodes[callee].name = i32(fname)
    nodes[call].a = i32(callee)
    set_list(call, rest)
    rt_call = check_expr(call, expected)
    call = last_checked
    check_expr(absent, rt_call)
    absent = last_checked
    coerce(absent, rt_call)
    choice = str_set_choice(shape_is(mk_ident_local(held, pos), u, pos), call, absent, pos)
    check_expr(choice, rt_call)
    result = mk(.exprstmt, pos)
    nodes[result].a = i32(last_checked)
    statements.push(result)
    nodes[n] = Node(kind = .block, pos = pos, type = i32(rt_call))
    nodes[n].aux = 1
    set_list(n, statements)
    add_flag(n, NF_CHECKED)
    last_checked = n
    rt_call

# `needle in container`, other than a range: the container's contains function.
binary_membership = (n: int, expected: int) -> int:
    needle = int(nodes[n].a)
    container = int(nodes[n].b)
    dewy = files[pos_file(nodes[n].pos)].is_dewy
    if dewy and str_sets.len() > 1 and nodes[needle].kind != .str_lit:
        members = membership_str_set(n)
        if members != 0: return members
        needle = int(nodes[n].a)
        container = int(nodes[n].b)
    call = mk(.call, nodes[n].pos)
    callee = mk(.field, nodes[n].pos)
    nodes[callee].a = nodes[n].b
    nodes[callee].name = i32(intern("contains"))
    nodes[call].a = i32(callee)
    set_list(call, [int(nodes[n].a)])
    nodes[n] = nodes[call]
    t = check_expr(n, 0)
    if dewy:
        # Method syntax puts the receiver first. Membership reads the
        # needle first, preserving snapshots and side effects in that order.
        if nodes[n].kind == .call and nodes[n].aux == 0:
            save_call_order(n, [needle, container], kids(n))
        else if nodes[n].kind == .block and nkids(n) >= 3 and nodes[kid(n, 0)].kind == .vardecl and nodes[kid(n, 1)].kind == .vardecl and nodes[kid(n, 0)].b == i32(container) and nodes[kid(n, 1)].b == i32(needle):
            # Dependent defaults already captured the two explicit values.
            statements = kids(n)
            first = statements[0]
            statements[0] = statements[1]
            statements[1] = first
            set_list(n, statements)
        else: fatal(nodes[n].pos, "membership needs a contains function, not a callable field")
        if t != T_BOOL: fatal(nodes[n].pos, "membership's contains function must return bool")
    return t
binary_decimal = (e: int): decimal_compared(e)
# Every operand pair but two plain numbers, both checked (flags: 1 and 2 a quantity
# literal written left and right, 4 and 8 a character added left and right).
binary_rest = (n: int, expected: int, a0: int, b0: int, ta0: int, tb0: int, hint: int, flags: int) -> int:
    a = a0
    b = b0
    ta = ta0
    tb = tb0
    op = nodes[n].op as Tok
    is_cmp = op == .eq or op == .ne or op == .lt or op == .le or op == .gt or op == .ge
    is_shift = op == .shl or op == .shr
    q_lit_a = flags & 1 != 0
    q_lit_b = flags & 2 != 0
    a_char = flags & 4 != 0
    b_char = flags & 8 != 0
    if (op == .eq or op == .ne) and types[ta].kind == .fixed and types[tb].kind == .fixed and fixed_len(ta) != fixed_len(tb) and type_eq(int(types[ta].elem), int(types[tb].elem)):
        # (arrays of different exact lengths are unequal, compared as arrays)
        ta = mk_array(int(types[ta].elem))
        coerce(a, ta)
        coerce(b, ta)
        tb = ta
    # (x =? 'member' or x =? y with x a literal union's optional: the literal is that member,
    # y is one already, and the optional compares)
    if (op == .eq or op == .ne) and str_sets.len() > 1:
        if tkind(ta) == .opt and str_set_of(prune(telem(ta))) != 0 and (nodes[kid_lit(b)].kind == .str_lit or prune(telem(ta)) == tb):
            if tb != prune(telem(ta)): coerce(b, prune(telem(ta)))
            nodes[n].b = i32(coerce(b, ta))
            b = int(nodes[n].b)
            tb = ta
        else if tkind(tb) == .opt and str_set_of(prune(telem(tb))) != 0 and (nodes[kid_lit(a)].kind == .str_lit or prune(telem(tb)) == ta):
            if ta != prune(telem(tb)): coerce(a, prune(telem(tb)))
            nodes[n].a = i32(coerce(a, tb))
            a = int(nodes[n].a)
            ta = tb
    # (Dewy's, and the library's inside a call Dewy made, are errors: a set's members are unordered)
    if is_cmp and op != .eq and op != .ne and str_sets.len() > 1 and (str_set_of(ta) != 0 or str_set_of(tb) != 0) and dewy_ordering(nodes[n].pos):
        str_set_unordered(nodes[n].pos, ta, tb)
    # (Sloppy orders a set's members as its enum's: by position, as its frozen twin does)
    sloppy_order = ta == tb and op != .eq and op != .ne and not dewy_at(nodes[n].pos)
    if str_sets.len() > 1 and (str_set_of(ta) != 0 or str_set_of(tb) != 0) and not sloppy_order:
        # (a set's word against a member literal or the same set: compared as words; else as text)
        same = ta == tb
        if (op == .eq or op == .ne) and not same:
            if str_set_of(ta) != 0 and nodes[kid_lit(b)].kind == .str_lit:
                coerce(b, ta)
                tb = ta
                same = true
            else if str_set_of(tb) != 0 and nodes[kid_lit(a)].kind == .str_lit:
                coerce(a, tb)
                ta = tb
                same = true
        # (a number against a set's word: told while the set is still known, before it is made text)
        if is_cmp and not same and (str_set_of(ta) != 0 and is_numeric(tb) or str_set_of(tb) != 0 and is_numeric(ta)): cmp_error(n, ta, tb)
        if not same or op != .eq and op != .ne:
            if str_set_of(ta) != 0:
                coerce(a, T_STR)
                ta = T_STR
            if str_set_of(tb) != 0:
                coerce(b, T_STR)
                tb = T_STR
    # (`"#" * n` of an `int`: a count of zero or less repeats nothing and one past any memory
    # cannot be made, so the count saturates into a word rather than narrowing with a check)
    if op == .star and dewy_at(nodes[n].pos) and (ta == T_STR and tb == T_MATH_INT and not is_lit(b) or tb == T_STR and ta == T_MATH_INT and not is_lit(a)):
        count = if ta == T_STR: b else: a
        word = policy_int(T_INT, 2, nodes[n].pos)
        coerce(count, word)
        if ta == T_STR: tb = word else: ta = word
    pending_decimal = (nodes[a].kind == .float_lit and nodes[a].sval != 0 and is_lit(a)) or (nodes[b].kind == .float_lit and nodes[b].sval != 0 and is_lit(b))
    # (a quantity operand is exact or floating by its number: 0.5 * 2s stays exact)
    na = if types[ta].kind == .quantity: quantity_base(ta) else: ta
    nb = if types[tb].kind == .quantity: quantity_base(tb) else: tb
    exact_operands = pending_decimal and (is_numeric(na) or bundled_rational_type(na) or bundled_bigint_type(na)) and (is_numeric(nb) or bundled_rational_type(nb) or bundled_bigint_type(nb))
    if exact_operands and not is_float(hint) and not (is_float(na) and not is_lit(a)) and not (is_float(nb) and not is_lit(b)):
        if nodes[a].kind == .float_lit and nodes[a].sval != 0 and is_lit(a): ta = exact_decimal(a)
        if nodes[b].kind == .float_lit and nodes[b].sval != 0 and is_lit(b): tb = exact_decimal(b)
    # (a record's own operators take a quantity, Instant + 90minute: the record case below)
    if (types[ta].kind == .quantity or types[tb].kind == .quantity) and not quantity_record_operand(ta, tb):
        quantity_left_literal = q_lit_a
        quantity_right_literal = q_lit_b
        return quantity_binary(n, a, b, expected)
    if not is_shift and ta == T_MATH_INT and (bundled_bigint_type(tb) or bundled_rational_type(tb)):
        coerce(a, tb)
        ta = tb
    # (`q / n` keeps an `int` divisor for the library's `(Rational int)` division, so a
    # guard on n proves it nonzero, as for a word divisor: rational_divisor)
    else if not is_shift and tb == T_MATH_INT and (bundled_bigint_type(ta) or bundled_rational_type(ta)) and not (op == .slash and bundled_rational_type(ta)):
        coerce(b, ta)
        tb = ta
    if is_float(tb) and bundled_rational_type(ta):
        coerce(a, tb)
        ta = tb
    else if is_float(ta) and bundled_rational_type(tb):
        coerce(b, ta)
        tb = ta
    # (y == 650 in update, y moved by speed * dt: it steps over 650, never on it)
    if op == .eq and is_float(ta) and (nodes[a].kind == .ident or nodes[a].kind == .field) and (nodes[b].kind == .int_lit or nodes[b].kind == .float_lit) and cx >= 0 and not pos_in_lib(nodes[n].pos):
        lv = 0.0
        if nodes[b].kind == .int_lit: lv = f64(nodes[b].ival)
        else if nodes[b].kind == .float_lit: lv = nodes[b].fval
        ci = int(ctxs[cx].inst)
        if lv != 0.0 and ci > 0 and fns[ci].decl != 0 and name_of(int(nodes[int(fns[ci].decl)].name)) == "update" and not dewy_is_method(int(fns[ci].decl)):
            lt = "{lv}"
            if lv == floor(lv) and abs(lv) < 1e15: lt = "{i64(lv)}"
            nm = "it"
            if nodes[a].kind == .ident: nm = name_of(int(nodes[a].name))
            else if nodes[a].kind == .field: nm = "." + name_of(int(nodes[a].name))
            warn(nodes[n].pos, "a number with a fraction, moved a little each frame, steps past {lt} ({lv - 0.3}, then {lv + 0.2}) and is rarely exactly {lt}: `>=` (or `<=`) is true once {nm} gets there")
    # (s[0] + "!": a byte and a character's code added, which reads like text joined)
    if b_char and is_int(ta) and not is_lit(a) and is_int(tb) and not has_flag(b, NF_SQUOTE):
        ch = name_of(int(nodes[b].sval))
        if nodes[a].kind == .ident:
            an = name_of(int(nodes[a].name))
            warn(nodes[n].pos, "this adds the character code of {ch} to a number, not text to text: for text, write `\"\{{an}}{ch}\"` (and when {an} is a character from s[i], `chr({an}) + \"{ch}\"`)")
        else: warn(nodes[n].pos, "this adds the character code of {ch} to a number, not text to text (s[i] is a character's code): `chr(s[i]) + \"{ch}\"` joins text")
    if a_char and is_int(tb) and not is_lit(b) and is_int(ta) and not has_flag(a, NF_SQUOTE):
        warn(nodes[n].pos, "this adds a character code and a number: for text, ... + chr(x)")
    # (`types = Png | Jpeg`, `r.types & (Tick | Closed)`: a type made of types, decisions.md batch 7)
    if (op == .pipe or op == .amp) and types[ta].kind == .typeval and types[tb].kind == .typeval and dewy_at(nodes[n].pos):
        if op == .pipe: return type_member_type(mk_union([telem(ta), telem(tb)]))
        return type_member_type(type_meet([telem(ta), telem(tb)], nodes[n].pos))
    if types[ta].kind == .typeval or types[tb].kind == .typeval: fatal(nodes[n].pos, "a type name cannot be used as a value here")
    # vectors
    if is_cmp and (op == .eq or op == .ne):
        note_value_helpers(ta)
        note_value_helpers(tb)
        # (x == v with x: T? and v: T: v as a T?, so none is never equal to it)
        if tkind(ta) == .opt and tkind(tb) != .opt and tkind(tb) != .none_lit and type_eq(prune(int(types[ta].elem)), tb):
            nodes[n].b = i32(coerce(b, ta))
            b = int(nodes[n].b)
            tb = ta
        else if tkind(tb) == .opt and tkind(ta) != .opt and tkind(ta) != .none_lit and type_eq(prune(int(types[tb].elem)), ta):
            nodes[n].a = i32(coerce(a, tb))
            a = int(nodes[n].a)
            ta = tb
        # (a union and one of its members, `back =? n`: the member joins the
        # union, so a different member compares unequal)
        else if not type_eq(ta, tb) and union_or_optional(ta) and not union_or_optional(tb) and can_coerce(b, tb, ta):
            nodes[n].b = i32(coerce(b, ta))
            b = int(nodes[n].b)
            tb = ta
        else if not type_eq(ta, tb) and union_or_optional(tb) and not union_or_optional(ta) and can_coerce(a, ta, tb):
            nodes[n].a = i32(coerce(a, tb))
            a = int(nodes[n].a)
            ta = tb
    # ("v is " + v: a vector joined to text)
    if op == .plus and (tkind(ta) == .str_ and is_vec(tb) or is_vec(ta) and tkind(tb) == .str_):
        vt = tb
        if is_vec(ta): vt = ta
        fatal(nodes[n].pos, "cannot add a {dt(vt)} to text: put the value inside the string (\"v is \{v}\")")
    if is_vec(ta) or is_vec(tb): return check_vec_binary(n, op, ta, tb)
    if types[ta].kind == .fixed or types[tb].kind == .fixed:
        if op != .eq and op != .ne: fatal(nodes[n].pos, "operator {op_text(op, nodes[n].pos)} is not defined for {dt(ta)} and {dt(tb)} (fixed-size arrays can be compared with {op_text(.eq, nodes[n].pos)} and {op_text(.ne, nodes[n].pos)})")
        if types[ta].kind == .fixed: coerce(b, ta)
        else: coerce(a, tb)
        nodes[n].aux = 1
        nodes[n].type = i32(T_BOOL)
        return T_BOOL
    if is_struct_like(ta) or is_struct_like(tb):
        opn = tok_text(op)
        r = op_overload(n, opn)
        if r != 0: return r
        if op == .ne:
            eqn = mk(.binary, nodes[n].pos)
            nodes[eqn].op = i32(int(Tok.eq))
            nodes[eqn].a = i32(a)
            nodes[eqn].b = i32(b)
            r2 = op_overload(eqn, "==")
            if r2 != 0:
                nodes[n] = Node(kind = .not_, pos = nodes[n].pos, a = i32(eqn), type = i32(T_BOOL))
                return T_BOOL
        if op == .gt or op == .le or op == .ge:
            # from `<` alone: a > b is b < a, a <= b is not (b < a), a >= b is not (a < b)
            ltn = mk(.binary, nodes[n].pos)
            nodes[ltn].op = i32(int(Tok.lt))
            nodes[ltn].a = i32(b)
            nodes[ltn].b = i32(a)
            if op == .ge:
                nodes[ltn].a = i32(a)
                nodes[ltn].b = i32(b)
            r2 = op_overload(ltn, "<")
            if r2 != 0:
                # Deriving > / <= reverses the parameter slots, not the
                # evaluation order of the source operands.
                save_call_order(ltn, [a, b], kids(ltn))
                if op == .gt: nodes[n] = nodes[ltn]
                else: nodes[n] = Node(kind = .not_, pos = nodes[n].pos, a = i32(ltn), type = i32(T_BOOL))
                return r2
        if op == .eq or op == .ne:
            if not type_eq(ta, tb): cmp_error(n, ta, tb)
            nodes[n].aux = 1
            nodes[n].type = i32(T_BOOL)
            return T_BOOL
        why = ""
        if is_union(ta) or is_union(tb): why = union_operand_why(n, if is_union(ta): ta else: tb)
        else if type_eq(ta, tb) and types[ta].kind == .struct_ and not is_map_type(ta):
            why = " (a struct has the operators defined for it: `({opn}) = (a: {dt(ta)}, b: {dt(ta)}) -> ...`)"
            if op == .gt or op == .le or op == .ge: why = " (define `(<) = (a: {dt(ta)}, b: {dt(ta)}) -> bool: ...` and >, <= and >= come from it)"
            if dewy_at(nodes[n].pos): why = " (a record has the operators defined for it, such as `__add__ = (a:{dt(ta)} b:{dt(ta)}):>{dt(ta)} => ...` for + or `__lt__` for <?)"
        never_cascade(nodes[n].pos, ta)
        never_cascade(nodes[n].pos, tb)
        if dewy_at(nodes[n].pos):
            if nodes[n].a != 0 and nodes[n].b != 0: why += calendar_period_why(int(nodes[n].a), int(nodes[n].b)) + hidden_unit_why(n, int(nodes[n].a), int(nodes[n].b))
        fatal(nodes[n].pos, "operator {opn} is not defined for {dt(ta)} and {dt(tb)}{why}")
    if is_shift and dewy_at(nodes[n].pos) and nodes[b].kind == .int_lit and nodes[b].ival < 0 and not has_flag(b, NF_U64):
        fatal(nodes[b].pos, "a shift count is unsigned, and {nodes[b].ival} is negative")
    if is_shift and not (is_lit(a) and is_lit(b)):
        finalize_literal(a)
        finalize_literal(b)
        ta = prune(ntype(a))
        tb = prune(ntype(b))
        if not is_int(ta) or not is_int(tb): fatal(nodes[n].pos, "shift operands must be integers")
        # An unsigned subtraction may be negative before the shift. Keep its
        # exact signed value instead of first narrowing it to an unsigned word.
        if op == .shr and ta == T_U64 and nodes[a].kind == .binary and nodes[a].op == i32(int(Tok.minus)) and exact_operation(a):
            ta = exact_int_result(a, true)
        if ta == T_MATH_INT:
            known_b, y = integer_constant(b)
            if known_b and y < 0 and types[tb].sign: fatal(nodes[n].pos, "shift count must be nonnegative")
        # Fixed shifts only distinguish counts below their word width. Saturating
        # a mathematical count to a signed word preserves that distinction,
        # including negative counts interpreted as unsigned continuation counts.
        if ta != T_MATH_INT and (ta != T_INT or op == .shr) and tb == T_MATH_INT and dewy_at(nodes[n].pos):
            known, count = integer_constant(b)
            coerce(b, (if known: T_INT else: policy_int(T_INT, 2, nodes[n].pos)))
        nodes[n].type = i32(ta)
        if ta == T_INT and dewy_at(nodes[n].pos):
            known, count = integer_constant(b)
            if op == .shl and (not known or count >= 1048576):
                # Preserve the fixed operand's unsigned count interpretation.
                # Counts beyond a realizable bigint saturate before conversion;
                # in particular zero shifted by a negative runtime count is zero.
                if prune(ntype(b)) == T_MATH_INT: coerce(b, policy_int(T_INT, 2, nodes[n].pos))
                coerce(b, policy_int(T_U64, 1, nodes[n].pos))
                coerce(a, T_MATH_INT)
                nodes[n].type = i32(T_MATH_INT)
                return T_MATH_INT
            return exact_int_result(n)
        return ta
    tka = types[ta].kind
    tkb = types[tb].kind
    # (an elementwise mask, `xs .* (ys .>? 0.0)`: a bool counts as 1 or 0, as in NumPy)
    if op == .star and has_flag(n, NF_BROADCAST) and ((tka == .bool_ and is_numeric(tb)) or (tkb == .bool_ and is_numeric(ta))):
        value = if tka == .bool_: b else: a
        keep = if tka == .bool_: a else: b
        nodes[n] = nodes[bc_call("__mask_mul", [value, keep], nodes[n].pos)]
        return check_expr(n, expected)
    if op == .plus and dewy_at(nodes[n].pos) and (tka == .str_ or tkb == .str_ or tka == .array or tka == .fixed or tkb == .array or tkb == .fixed):
        no_concat_error(n, a, b, tka == .str_ or tkb == .str_)
    if op == .plus and tka == .str_:
        if is_numeric(tb) or tkb == .bool_: fatal(nodes[b].pos, "cannot add this {dt(tb)} to text: put the value inside the string (\"...\{x}\") or convert it ({jd(nodes[b].pos, "str(x)", "string(x)")})")
        coerce(b, T_STR)
        nodes[n].aux = 2
        nodes[n].type = i32(T_STR)
        return T_STR
    if op == .plus and tka == .array:
        if tkb != .array and is_numeric(int(types[ta].elem)) and (is_numeric(tb) or is_lit(b)):
            fatal(nodes[n].pos, "+ joins two arrays; to add {dt(tb)} to each element, use .+ (xs .+ 1.0)")
        coerce(b, ta)
        nodes[n].aux = 3
        nodes[n].type = i32(ta)
        return ta
    if tka == .ptr and (op == .plus or op == .minus) and (is_int(tb) or is_lit(b)):
        coerce(b, T_INT)
        nodes[n].aux = 4
        nodes[n].type = i32(ta)
        return ta
    if tka == .ptr and tkb == .ptr and op == .minus:
        nodes[n].aux = 5
        nodes[n].type = i32(T_INT)
        return T_INT
    if is_cmp:
        if tka == .str_ or tkb == .str_:
            if not type_eq(ta, tb): cmp_error(n, ta, tb)
            nodes[n].aux = 2
            nodes[n].type = i32(T_BOOL)
            return T_BOOL
        if tka == .opt or tkb == .opt or tka == .none_lit or tkb == .none_lit:
            if op != .eq and op != .ne: opt_cmp_error(n, a, b, ta, tb)
            if nodes[b].kind == .none_lit or nodes[a].kind == .none_lit:
                if nodes[a].kind == .none_lit:
                    nodes[n].a = i32(b)
                    nodes[n].b = i32(a)
                if tkind(ntype(int(nodes[n].a))) != .opt: fatal(nodes[n].pos, "only optionals can be compared with none")
                nodes[n].aux = 6
                nodes[n].aux2 = i32(map_presence_fn(int(nodes[n].a)))
                nodes[n].type = i32(T_BOOL)
                return T_BOOL
            join_types(a, b, nodes[n].pos)
            nodes[n].aux = 1
            nodes[n].type = i32(T_BOOL)
            return T_BOOL
        if tka == .array or tkb == .array:
            if op != .eq and op != .ne:
                why = ""
                ot = op_text(op, nodes[n].pos)
                if (tka == .array and is_numeric(int(types[ta].elem))) or (tkb == .array and is_numeric(int(types[tb].elem))): why = " (for each element: .{ot}, as in xs .{ot} 2.0, gives {dt(mk_array(T_BOOL))})"
                # (a sort key written `[a b]` is an array: Python's tuple key is a Dewy tuple)
                if pos_in_lib(nodes[n].pos) and err_trail_names.len() > 0 and err_trail_names[0] in ["sort", "sorted", "min_by", "max_by"]:
                    why = ""
                    err_notes.push((-1, "help: a key of several parts is a tuple, which orders part by part: give the key function a tuple result, `key=(x):>[T T] => [a b]`"))
                fatal(nodes[n].pos, "arrays can only be compared with {op_text(.eq, nodes[n].pos)} and {op_text(.ne, nodes[n].pos)}{why}")
            if not can_coerce(b, tb, ta) and tkb != .array and tka == .array and is_numeric(int(types[ta].elem)) and (is_numeric(tb) or is_lit(b)):
                ot = op_text(op, nodes[n].pos)
                fatal(nodes[n].pos, "an array compared with {dt(tb)}: for each element use .{ot} (xs .{ot} 2.0 gives {dt(mk_array(T_BOOL))})")
            if not can_coerce(b, tb, ta): cmp_error(n, ta, tb)
            coerce(b, ta)
            nodes[n].aux = 1
            nodes[n].type = i32(T_BOOL)
            return T_BOOL
        if tka == .bool_ or tka == .enum_ or tka == .ptr or tka == .null_ or tka == .fn_ or tka == .cfn:
            if tka == .null_:
                nodes[n].a = i32(b)
                nodes[n].b = i32(a)
                a = int(nodes[n].a)
                b = int(nodes[n].b)
                x = ta
                ta = tb
                tb = x
            if not can_coerce(b, tb, ta) and not type_eq(ta, tb): cmp_error(n, ta, tb)
            if types[ta].kind == .fn_: fatal(nodes[n].pos, "functions cannot be compared")
            coerce(b, ta)
            nodes[n].type = i32(T_BOOL)
            return T_BOOL
    if op == .amp or op == .pipe or op == .caret:
        if tka == .bool_ and tkb == .bool_:
            nodes[n].type = i32(T_BOOL)
            return T_BOOL
    if not is_numeric(ta) or not is_numeric(tb):
        r = op_overload(n, tok_text(op))
        if r != 0: return r
        if tka == .opt and is_numeric(int(types[ta].elem)): fatal(nodes[n].pos, "this {dt(ta)} may be none (nothing), so {tok_text(op)} cannot use it: say what to use then (`x ?? 0`){jd(nodes[n].pos, ", or `x!` when it cannot be none", ", or check it first: `if x isnt? none \{ ... }`")}")
        why = ""
        if is_union(ta) or is_union(tb): why = union_operand_why(n, if is_union(ta): ta else: tb)
        if tka == .array and is_int(tb) and op == .star:
            why = " (fill(x, n) makes an array of n copies of x)"
            if is_numeric(int(types[ta].elem)): why = " (fill(x, n) makes an array of n copies of x; xs .* n multiplies each element)"
        else if (tka == .array and is_numeric(int(types[ta].elem))) or (tkb == .array and is_numeric(int(types[tb].elem))):
            if op == .plus or op == .minus or op == .star or op == .slash or op == .percent: why = " (for each element: .{tok_text(op)}, as in xs .{tok_text(op)} 2.0)"
        if len(why) == 0 and op == .percent and tka == .str_: why = " (a value goes into text inside braces, with its format: \"\{x:.2f}\")"
        # (age + 1 with age from read_line: text, not a number)
        if len(why) == 0:
            sa = tka == .str_ or (tka == .opt and tkind(int(types[ta].elem)) == .str_)
            sb = tkb == .str_ or (tkb == .opt and tkind(int(types[tb].elem)) == .str_)
            if (sa and is_numeric(tb)) or (sb and is_numeric(ta)): why = " (text is not a number, even when it holds digits: `to_int(s)` or `input_int(...)` makes a number, and `\"\{x}\"` puts a number in text)"
        if len(why) == 0: why = void_rec_hint(a) + void_rec_hint(b) + uncalled_hint(a, 0) + uncalled_hint(b, 0)
        # (`x and 1 =? 1`: the word operators join two truth values or two integers, and a test binds tighter)
        if (op == .amp or op == .pipe or op == .caret) and dewy_at(nodes[n].pos) and (tkb == .bool_ and is_int(ta) or tka == .bool_ and is_int(tb)):
            word = if op == .amp: "and" else if op == .pipe: "or" else: "xor"
            tested = if tkb == .bool_: b else: a
            other = if tkb == .bool_: a else: b
            shown = wit_text(other)
            left = if nodes[tested].kind == .binary and fact_comparison(nodes[tested].op as Tok): wit_text(int(nodes[tested].a)) else: ""
            right = if nodes[tested].kind == .binary and fact_comparison(nodes[tested].op as Tok): wit_text(int(nodes[tested].b)) else: ""
            mask = if shown != "" and left != "" and right != "": ": to test a mask, group it first, `({shown} {word} {left}) {op_text(nodes[tested].op as Tok, nodes[n].pos)} {right}`" else: ""
            fatal(nodes[n].pos, "`{word}` joins two truth values or two integers, not {dt(ta)} and {dt(tb)}, and a test binds tighter than it{mask}; to test an integer, compare it, as `x not=? 0`")
        # (square(4) + 1 with a square that prints: it gives nothing back)
        if len(why) == 0:
            loop x in [a, b]:
                if tkind(ntype(x)) == .void_ and nodes[x].kind == .call and nodes[x].sym > 0 and int(nodes[x].sym) < fns.len() and fns[int(nodes[x].sym)].decl != 0:
                    fnm = name_of(int(nodes[int(fns[int(nodes[x].sym)].decl)].name))
                    why = " ('{fnm}' gives nothing back (printing is not giving back): end it with the value it should give, and write {jd(nodes[n].pos, "`-> int`", "`:>int64`")} after its parameters)"
                    break
        never_cascade(nodes[n].pos, ta)
        never_cascade(nodes[n].pos, tb)
        if dewy_at(nodes[n].pos): why += calendar_period_why(a, b) + hidden_unit_why(n, a, b)
        fatal(nodes[n].pos, "operator {tok_text(op)} is not defined for {dt(ta)} and {dt(tb)}{why}")
    binary_numeric(n, op, a, b, ta, tb, is_cmp)

# (q1 * q2 for quaternions, which are vec4s: * multiplies their parts one by one, which is no
# rotation; values from quat_* functions, and variables made from them, are known to be ones)
quat_nodes: {int: bool} = {}
quat_locals: {int: bool} = {}
quat_globals: {int: bool} = {}

check_vec_binary = (n: int, op: Tok, ta: int, tb: int) -> int:
    a = int(nodes[n].a)
    b = int(nodes[n].b)
    if op == .star and not pos_in_lib(nodes[n].pos):
        if type_eq(ta, T_VEC4) and type_eq(tb, T_VEC4) and (is_quat(a) or is_quat(b)):
            warn(nodes[n].pos, "* multiplies the parts of two vec4s one by one, which for quaternions is no rotation: quat_mul(a, b) turns by b, then by a")
        if type_eq(ta, T_VEC4) and type_eq(tb, T_VEC3): fatal(nodes[n].pos, "cannot apply * to vec4 and vec3 (a quaternion turns a vector with quat_rotate(q, v))")
        if ta == T_MAT4 and type_eq(tb, T_VEC3): fatal(nodes[n].pos, "cannot apply * to mat4 and vec3 (transform_point(m, p) moves a point, transform_dir(m, d) turns a direction; or m * vec4(p, 1))")
    if op == .eq or op == .ne:
        if not type_eq(ta, tb): cmp_error(n, ta, tb)
        nodes[n].aux = 1
        nodes[n].type = i32(T_BOOL)
        return T_BOOL
    if op != .plus and op != .minus and op != .star and op != .slash: fatal(nodes[n].pos, "operator {op_text(op, nodes[n].pos)} is not defined for vectors")
    if is_vec(ta) and is_vec(tb):
        if ta == T_MAT4 and tb == T_MAT4:
            if op != .star: fatal(nodes[n].pos, "matrices only support *")
            runtime_demand("__mat4_mul")
            nodes[n].aux = 7
            nodes[n].type = i32(T_MAT4)
            return T_MAT4
        if ta == T_MAT4 and tb == T_VEC4 and op == .star:
            runtime_demand("__mat4_mul_vec4")
            nodes[n].aux = 8
            nodes[n].type = i32(T_VEC4)
            return T_VEC4
        if not type_eq(ta, tb):
            # (a point on the ground, 2D, into 3D: x and z)
            g = ""
            if (ta == T_VEC3 and tb == T_VEC2) or (ta == T_VEC2 and tb == T_VEC3): g = " (a 2D vector into 3D, on the ground: `vec3(p.x, 0, p.y)`; or `vec3(p, 0)` for x and y)"
            fatal(nodes[n].pos, "cannot apply {op_text(op, nodes[n].pos)} to {dt(ta)} and {dt(tb)}{g}")
        nodes[n].aux = 9
        nodes[n].type = i32(ta)
        return ta
    # vector op scalar / scalar op vector
    if is_vec(ta):
        coerce(b, vec_comp_type(ta))
        nodes[n].aux = 10
        nodes[n].type = i32(ta)
        return ta
    if op != .star and op != .slash and op != .plus and op != .minus: fatal(nodes[n].pos, "invalid vector operation")
    coerce(a, vec_comp_type(tb))
    nodes[n].aux = 11
    nodes[n].type = i32(tb)
    tb

# a literal behind the conversions checking gave it
kid_lit = (e0: int) -> int:
    e = e0
    loop nodes[e].kind == .conv: e = int(nodes[e].a)
    e

# A refined integer type pattern on an integer scrutinee (`<-1|1>`,
# `small:int64<small <? 100>`): range patterns over the values it admits. high: a uint64
# scrutinee's values from 2^63 on (int_intervals_wide), besides those of domain.
refined_patterns = (arm: int, domain: int[], st: int, high: int[] = []):
    out: int[]
    loop p in kids(arm):
        if nodes[p].kind != .ptype:
            out.push(p)
            continue
        pt = prune(resolve_type(int(nodes[p].a)))
        known, values, wide = int_intervals_wide(pt)
        if types[pt].kind != .refined or not known:
            out.push(p)
            continue
        values = interval_meet(values, domain)
        # (the values from 2^63 on both admit: their bits, negative, ordered as the values are;
        # one range across 2^63 when they join)
        above = interval_meet(wide, high)
        if above.len() > 0 and values.len() > 0 and values[values.len() - 1] == FACT_MAX and above[0] == FACT_MIN:
            values[values.len() - 1] = above[1]
            above.remove(0)
            above.remove(0)
        values += above
        if values.len() == 0: fatal(nodes[p].pos, "this arm is unreachable: no {dt(st)} is a {type_str(pt, true)}")
        loop k in [0..values.len() / 2):
            r = mk(.prange, nodes[p].pos)
            nodes[r].a = i32(bc_int(values[2 * k], nodes[p].pos))
            nodes[r].b = i32(bc_int(values[2 * k + 1], nodes[p].pos))
            if high.len() > 0 and values[2 * k] < 0: add_flag(int(nodes[r].a), NF_U64)
            if high.len() > 0 and values[2 * k + 1] < 0: add_flag(int(nodes[r].b), NF_U64)
            add_flag(r, NF_INCLUSIVE)
            if k == 0: nodes[r].name = nodes[p].name
            out.push(r)
    set_list(arm, out)

# A string set type pattern (`<'n'|'s'>`, `other:'e'|'w'`) on a string: one
# literal pattern per member the scrutinee can hold and no earlier arm matches
# (`covered`, or `union_lits` on a union); the first keeps the binding, typed as the set.
str_set_patterns = (arm: int, st: int, covered: str[], union_lits: str[]):
    out: int[]
    loop p in kids(arm):
        pt = if nodes[p].kind == .ptype: prune(resolve_type(int(nodes[p].a))) else: 0
        set = if pt != 0: str_set_of(pt) else: 0
        if set == 0 or type_eq(pt, st) and str_set_of(st) == 0 or is_union(st) and union_index(st, pt) >= 0:
            out.push(p)
            continue
        # (only the members the scrutinee can hold: `x:'a'|'b'|'c'` on `'b'|'c' | int64`)
        held = str_set_of(st)
        prefix = ""
        if is_union(st):
            loop vi in 0.. and m in union_members(st):
                if str_set_of(m) != 0:
                    held = str_set_of(m)
                    prefix = "{vi}"
        values: str[]
        any = false
        loop value in str_sets[set]:
            if held != 0 and not str_sets[held].contains(value): continue
            any = true
            if covered.contains(value) or held != 0 and union_lits.contains("{prefix}'{value}"): continue
            values.push(value)
        if not any:
            out.push(p)
            continue
        if values.len() == 0: fatal(nodes[p].pos, "this arm is unreachable: earlier arms already match every value it does")
        loop k in 0.. and value in values:
            q = mk(.plit, nodes[p].pos)
            nodes[q].a = i32(bc_str(value, nodes[p].pos))
            if k == 0:
                nodes[q].name = nodes[p].name
                nodes[q].type = i32(pt)
            out.push(q)
    set_list(arm, out)

# lo..hi holds at most limit + 1 values (without overflowing on wide intervals)
small_span = (lo: int, hi: int, limit: int) -> bool: lo >= -(1 << 40) and hi <= (1 << 40) and hi - lo <= limit

has_lambda = (n: int) -> bool:
    if n == 0: return false
    if nodes[n].kind == .lambda: return true
    if has_lambda(int(nodes[n].a)) or has_lambda(int(nodes[n].b)): return true
    loop k in kids(n):
        if has_lambda(k): return true
    false

struct ShapeArm:
    cond: int      # the condition (0: always)
    record: int    # the record whose field values it tests
    decls: int[]   # the names it binds
    member: int    # the union member (or record) it covers whole, 0 none, -1 everything
    field: int     # one literal-tested field of that member (its name), else 0
    values: str[]  # the values that field's tests take
    gmember: int   # a guard on one union member (`small:int64<small <? 100>`): that member
    guard: int[]   # and the intervals of its values the guard admits

# `(a b) => f(a b)` in place of `@f`, checked against the expected function type.
fn_adapter = (n: int, et: int, expected: int) -> int:
    pos = nodes[n].pos
    params: int[]
    args: int[]
    loop i in [0..int(types[et].nargs)):
        param = mk(.param, pos)
        nodes[param].name = i32(intern("$arg{i}"))
        nodes[param].a = i32(type_node_of(targ(et, i), pos))
        params.push(param)
        args.push(bc_ident("$arg{i}", pos))
    callee = mk(.ident, pos)
    nodes[callee].name = nodes[n].name
    call = mk(.call, pos)
    nodes[call].a = i32(callee)
    set_list(call, args)
    lam = mk(.lambda, pos)
    set_list(lam, params)
    nodes[lam].b = i32(bc_block([bc_stmt(call, pos)], pos))
    nodes[n] = nodes[lam]
    check_expr(n, expected)

fn_value = (n: int, expected: int, explicit_types: int[] = [], mod: int = -1, closure: int = 0) -> int:
    decls: int[]
    if closure != 0: decls.push(poly_families[int(types[prune(ntype(closure))].st)].decl)
    else: collect_named(int(nodes[n].name), mod, &decls)
    if mod < 0 and closure == 0 and nodes[n].name == i32(intern("to_int")) and dewy_at(nodes[n].pos) and not bound_here(int(nodes[n].name)):
        own = false
        loop d in decls:
            if not decl_in_prelude(d): own = true
        if not own:
            parser = intern("__mi_parse")
            demand_name(parser)
            decls = []
            collect_fns(parser, &decls)
    if proof_active:
        loop d in decls:
            if proof_decls.has(d): fatal(nodes[n].pos, "a proof cannot be used as a value")
    # (`@sin`: the trigonometry takes angles, so it is no function of a plain number)
    if mod < 0 and closure == 0 and dewy_quantity_name(int(nodes[n].name)) and nodes[n].name != i32(quantity_call_names[0]) and dewy_at(nodes[n].pos) and decls.len() > 0 and decl_in_prelude(decls[0]) and not bound_here(int(nodes[n].name)):
        fname = name_of(int(nodes[n].name))
        fatal(nodes[n].pos, "{fname} takes an angle, so `@{fname}` is no function of a plain number: write `(x:float64) => {fname}(x * rad)` for radians (`from units import rad`)")
    et = callable_base(expected)
    if expected == 0: et = 0
    # Only inferred Dewy handles prefer a concrete program declaration.
    # Keep Sloppy implementation-library values and contextual overload matching
    # on their existing resolution path.
    if explicit_types.len() == 0 and files[pos_file(nodes[n].pos)].is_dewy and (et == 0 or (types[et].kind != .fn_ and types[et].kind != .cfn)):
        own: int[]
        loop d in decls:
            if not decl_in_prelude(d) and not fn_sig(d).generic: own.push(d)
        if own.len() == 1: decls = own
    f = 0
    selected = 0
    selected_binds: int[]
    loop d in decls:
        sig = fn_sig(d)
        if explicit_types.len() > 0 and explicit_types.len() != int(sig.nexplicit): continue
        binds = fill(0, int(sig.ntp))
        loop i in [0..explicit_types.len()): binds[i] = explicit_types[i]
        if et != 0 and (types[et].kind == .fn_ or types[et].kind == .cfn):
            if int(types[et].nargs) != nkids(d): continue
            ok = true
            loop i in [0..int(types[et].nargs)):
                r = match_type(sig.params[i], targ(et, i), binds, 0)
                if r < 0 or r == 1:
                    ok = false
                    break
            if not ok: continue
            # (type parameters only in the result: from the expected result, zero = () -> T)
            if sig.ret != 0 and types[et].kind == .fn_ and int(types[et].elem) != 0:
                rb = binds
                if match_type(int(sig.ret), int(types[et].elem), rb, 0) >= 0: binds = rb
            loop b in binds:
                if b == 0: ok = false
            loop i in [0..explicit_types.len()):
                if not type_eq(binds[i], explicit_types[i]): ok = false
            if not ok: continue
            f = get_fn_inst(d, binds, nodes[n].pos)
            break
        else if explicit_types.len() > 0:
            complete = true
            loop b in binds:
                if b == 0: complete = false
            if not complete: continue
            if selected != 0: fatal(nodes[n].pos, "multiple versions of '{name_of(int(nodes[n].name))}' match these type arguments; give the function value a callable type")
            selected = d
            selected_binds = binds
        else if not sig.generic and decls.len() == 1: f = get_fn_inst(d, [], nodes[n].pos)
    if selected != 0: f = get_fn_inst(selected, selected_binds, nodes[n].pos)
    # (a function whose parameters accept the expected ones and whose result
    # fits the expected result stands in through a wrapper: `@f` with
    # f:(x:int64|string):>uint64? where <(x:int64):>uint64?|E> is expected)
    if explicit_types.len() == 0 and mod < 0 and closure == 0 and et != 0 and types[et].kind == .fn_ and files[pos_file(nodes[n].pos)].is_dewy:
        fits = 0
        if f != 0:
            ret = int(fns[f].ret)
            want = int(types[et].elem)
            if want != 0 and ret != 0 and tkind(want) != .refined and not type_eq(prune(ret), prune(want)) and can_coerce(0, ret, want): fits = 1
        else:
            loop d in decls:
                if fn_adapts(d, et): fits += 1
        if fits == 1: return fn_adapter(n, et, expected)
    if f == 0:
        if explicit_types.len() > 0: fatal(nodes[n].pos, "no version of '{name_of(int(nodes[n].name))}' matches these type arguments and callable type")
        if et != 0 and types[et].kind == .fn_:
            nm = name_of(int(nodes[n].name))
            hint = ""
            if nm == "update": hint = " (the game calls update each frame with the seconds since the last one: {jd(nodes[n].pos, "`update = (dt: f64): ...`", "`update = (dt:float64) => ...`")}{game_name_hint(nodes[n].pos, nm)})"
            if nm == "draw": hint = " (the game calls draw with nothing: {jd(nodes[n].pos, "`draw = (): ...`", "`draw = () => ...`")}{game_name_hint(nodes[n].pos, nm)})"
            fatal(nodes[n].pos, "no version of '{nm}' matches {dt(et)}{hint}")
        fatal(nodes[n].pos, "cannot use overloaded or generic function '{name_of(int(nodes[n].name))}' as a value without a known type{bare_variant_hint(int(nodes[n].name))}")
    mm = 0
    d = int(fns[f].decl)
    if d != 0: fn_used[d] = true
    if dir_floats_any: ff_note_ref(d)
    loop i in [0..fns[f].ptypes.len()):
        if has_flag(kid(d, i), NF_MUT): mm |= 1 << i
    nodes[n].kind = .fnref
    nodes[n].sym = i32(f)
    if closure != 0:
        nodes[n].a = i32(closure)
        nodes[n].aux = 2
    # (with no contract to fit, the handle keeps the function's defaults:
    # `g = @f` then `g(1)` fills f's later parameters as `f(1)` would)
    keeps = 0
    if et == 0 and closure == 0 and fn_has_defaults(d): keeps = f
    labels = if et != 0 and types[et].kind == .fn_: int(types[et].st) else: decl_fn_labels(d)
    if et != 0 and types[et].kind == .fn_ and fn_type_pack(et) != (fns[f].pack != 0):
        fname = name_of(int(nodes[n].name))
        fatal(nodes[n].pos, if fns[f].pack != 0: "'{fname}' gives several values, and {dt(et)} gives one" else: "'{fname}' gives one value, and {dt(et)} gives several")
    t = mk_fn(fns[f].ptypes, int(fns[f].ret), mm, labels, keeps, fns[f].pack != 0)
    if et != 0 and types[et].kind == .cfn:
        if not fns[f].cabi: fatal(nodes[n].pos, "'{name_of(int(nodes[n].name))}' must be marked {jd(nodes[n].pos, "@cabi", "`$export`")} to be used as a C function pointer")
        t = mk_cfn(fns[f].ptypes, int(fns[f].ret))
        nodes[n].aux = 1
    if nodes[d].sval != 0: t = mk_callable_contract(t, effect_subst(int(fn_sig(d).contract), fns[f].targs))
    nodes[n].type = i32(t)
    if effects_active: t = effect_infer_callable(n, expected)
    if callable_contract(expected) != 0 and not has_var(expected) and not effect_contract_fits(t, expected): fatal(nodes[n].pos, "cannot prove callable effect contract")
    nodes[n].type = i32(t)
    t

# Dewy function names. A bare name calls its function; `@f` is the function
# itself, and `@f(args)` partially evaluates it.

# Whether a name or member read at n is a bare Dewy function use: not `@f`,
# not a callee, not an assignment target.
dewy_bare_type_value = (n: int, tt: int, is_callee: bool, expected: int) -> bool:
    if is_callee or n == type_receiver_at or not dewy_at(nodes[n].pos) or types[tt].kind != .struct_: return false
    if expected != 0 and tkind(expected) == .typeval: return false
    if is_map_type(tt) or is_dewy_set_type(tt): return false
    si = int(types[tt].st)
    d = int(structs[si].decl)
    # (the program's own types, by the names it wrote: the library's are built on as types)
    if d == 0 or nodes[d].kind != .struct_ or pos_in_lib(nodes[d].pos) or starts_with(name_of(int(nodes[n].name)), "$"): return false
    check_struct_fields(si)
    loop i in [0..int(structs[si].nfields)):
        if fields[int(structs[si].fields) + i].defval == 0: return false
    true

capture_decl = 0 # a `$capture name` being checked: names a binding, never calls it

dewy_bare_fn = (n: int, is_callee: bool) -> bool:
    # (a member call's receiver is marked as a place it may change: `names.join(", ")` still calls names)
    receiver = n == type_receiver_at and not has_flag(n, NF_AT)
    if is_callee or (has_flag(n, NF_MUT) and not receiver) or n == assign_root or n == capture_decl: return false
    if nodes[n].kind == .ident:
        # A synthesized parameter copy or temporary.
        if nodes[n].aux2 == 1 or starts_with(name_of(int(nodes[n].name)), "$"): return false
    if cur_assign != 0 and int(nodes[cur_assign].a) == n: return false
    files[pos_file(nodes[n].pos)].is_dewy

# Inside a generic instance a local's type may be a function for this instance
# only; its bare name stays a value there.
in_generic_instance = () -> bool:
    c = cx
    loop c >= 0:
        inst = int(ctxs[c].inst)
        if inst > 0 and fns[inst].targs.len() > 0: return true
        c = int(ctxs[c].parent)
    false

# How a bare use of the visible functions `name` behaves: 0 when none can be
# called with no arguments, 1 when one can, 2 when that call makes a function.
bare_fns_call = (name: int, mod: int) -> int:
    decls: int[]
    collect_named(name, mod, &decls)
    loop d in decls:
        required = 0
        loop i in [0..nkids(d)):
            if nodes[kid(d, i)].b == 0: required += 1
        if required == 0:
            sig = fn_sig(d)
            return if sig.ret != 0 and is_fn_type(int(sig.ret)): 2 else: 1
    0

# `f` alone: the call f(), checked in place of n.
bare_call = (n: int, expected: int) -> int:
    callee = nodes.len()
    nodes.push(nodes[n])
    clear_flag(callee, NF_CHECKED)
    nodes[callee].type = 0
    nodes[n] = Node(kind = .call, pos = nodes[n].pos, a = i32(callee))
    t = check_expr(n, expected)
    call_style_implicit(n, int(nodes[callee].name) * 8 + 1, t)
    last_checked = n
    t

# The walk of one function body for a named wait (rules 3 and 4). In source order it finds w's
# declaration and the call, and every assignment and `$capture @x` closure on w or a place its
# receiver path overlaps. From the declaration through the call, and around any loop the call is
# in that the declaration is not (the loop back to the next match), none may change them.
# O(the body), once per named wait.
nw_local = 0
nw_name = 0
nw_call = 0
nw_decl = 0
nw_receiver = 0
nw_at = 0
nw_decl_at = -1
nw_call_at = -1
nw_call_end = -1
nw_loops: int[]
nw_decl_loops: int[]
nw_call_loops: int[]
nw_loop_start: {int: int} = {}
nw_loop_end: {int: int} = {}
nw_writes: int[]
nw_write_at: int[]

# `if cond @w else none` as a select argument (decisions.md, batch 7): w, or a wait turned off,
# written `__select_when(cond, @w)`. When every wait may be off, the select needs one on: the
# obligation "select needs a wait", proven from facts, else an error (a runtime check where the
# scope allows one). -1 when n has no such argument; O(arguments) for select's calls only.
select_name_id = 0
select_id = () -> int:
    if select_name_id == 0: select_name_id = intern("select")
    select_name_id

# `race(xs...)` and `first_ok(xs...)` (decisions.md batch 7, select-v6.md): a spread may be
# empty, and the call needs a call to run, as select needs a wait. When every positional argument
# is a spread, each is bound once and the obligation "needs a call" is that one is not empty:
# proven from facts, else an error (a runtime check where the scope allows one). No positional
# argument at all is an error. -1 for any other call; O(arguments), for these calls only.
race_name_ids: int[] = []
race_needs_id = 0
race_spread = (n: int, expected: int) -> int:
    if race_name_ids.len() == 0:
        race_name_ids = [intern("race"), intern("first_ok")]
        race_needs_id = intern("$race_needs")
    callee = int(nodes[n].a)
    name = int(nodes[callee].name)
    if name == race_needs_id: return race_needs(n)
    if not race_name_ids.contains(name): return -1
    ds: int[]
    call_collect_named(name, -1, ds)
    if concurrency_first_ok_module < 0 or not dewy_at(nodes[n].pos): return -1
    if ds.len() == 0: return -1
    loop d in ds:
        if int(nodes[d].mod) != concurrency_first_ok_module: return -1
    args = kids(n)
    spreads: int[]
    loop i in [0..args.len()):
        a = args[i]
        if nodes[a].kind == .namedarg: continue
        if not has_flag(a, NF_SPREAD): return -1
        # (already bound: this is the call the rewrite below made)
        if nodes[a].kind == .ident and starts_with(name_of(int(nodes[a].name)), "$race_spread"): return -1
        spreads.push(i)
    pos = nodes[n].pos
    word = name_of(name)
    if spreads.len() == 0: fatal(pos, "{word} needs a call to run: give it calls, or spread an array of them")
    stmts: int[]
    held: int[]
    loop i in spreads:
        e = args[i]
        held_name = "$race_spread{bc_count}"
        bc_count += 1
        clear_flag(e, NF_SPREAD)
        stmts.push(bc_let(held_name, e, nodes[e].pos))
        spread = bc_ident(held_name, nodes[e].pos)
        add_flag(spread, NF_SPREAD)
        args[i] = spread
        held.push(bc_ident(held_name, nodes[e].pos))
    needs = bc_call("$race_needs", held, pos)
    nodes[needs].ival = name
    call = clone(n)
    set_list(call, args)
    stmts.push(bc_stmt(needs, pos))
    stmts.push(bc_stmt(call, pos))
    nodes[n] = Node(kind = .block, pos = pos, aux = 1)
    set_list(n, stmts)
    check_expr(n, expected)

# (the per-wait matches source_match made: select_progress checks them as on select)
select_source_matches: {int: bool} = {}

type_name_id = 0

# `T.name` on a name that is a type (a type parameter, a `loop t in members(U)` binder, a
# declared type): its short name, as a checked text literal. A member of that name the type
# has wins, as an ordinary read. O(1) unless the member is `name`.
type_name_member = (n: int) -> bool:
    if type_name_id == 0: type_name_id = intern("name")
    if nodes[n].name != i32(type_name_id) or nodes[n].b != 0: return false
    receiver = int(nodes[n].a)
    if nodes[receiver].kind != .ident or not dewy_at(nodes[n].pos): return false
    s = lookup(int(nodes[receiver].name))
    if s == 0: return false
    k = syms[s].kind
    if k != .type_ and k != .struct_ and k != .enum_ and k != .alias_: return false
    t = if k == .type_: int(syms[s].ref) else: prune(expr_as_type(receiver))
    if tkind(t) == .struct_:
        si = int(types[t].st)
        if structs[si].decl != 0 and dewy_type_method(int(structs[si].decl), type_name_id) >= 0: return false
        check_struct_fields(si)
        loop i in [0..int(structs[si].nfields)):
            if fields[int(structs[si].fields) + i].name == i32(type_name_id): return false
    text = type_short_name(t)
    # (`Img:type = Png | Jpeg`: an alias whose right side has no name gives its own)
    if len(text) == 0 and k == .alias_: text = name_of(int(nodes[receiver].name))
    if len(text) == 0: fatal(nodes[n].pos, "{dt(t)} has no name of its own: an anonymous record, a union or a computed type has none (give it one, `Name:type = ...`)")
    nodes[n] = Node(kind = .str_lit, pos = nodes[n].pos, sval = i32(intern(text)), type = i32(T_STR), flags = i32(NF_CHECKED))
    last_checked = n
    true

# (the select call a match on select reads: the call itself, or the one a per-wait match was
# made from; is it a poll, its timeout a literal zero?)
select_source_calls: {int: int} = {}

# `@x.method` (decisions.md, batch 4): the method as a function of its remaining
# parameters, with x evaluated now, as `@x.method()` gives; a data member stays a place.
# -1 when n is not such a handle. O(the record's fields), only for `@` on a member.
dewy_method_handle = (n: int, expected: int) -> int:
    if not has_flag(n, NF_AT) or nodes[n].b != 0 or nodes[n].aux2 == i32(AUX2_PLACE) or not dewy_at(nodes[n].pos): return -1
    rt = prune(check_expr(int(nodes[n].a), 0))
    nodes[n].a = i32(last_checked)
    add_flag(last_checked, NF_CHECKED)
    st = if types[rt].kind == .ptr: prune(int(types[rt].elem)) else: rt
    if types[st].kind != .struct_: return -1
    si = int(types[st].st)
    if structs[si].decl == 0 or dewy_type_method(int(structs[si].decl), int(nodes[n].name)) < 0: return -1
    check_struct_fields(si)
    loop i in [0..int(structs[si].nfields)):
        if fields[int(structs[si].fields) + i].name == nodes[n].name: return -1
    callee = nodes.len()
    nodes.push(nodes[n])
    clear_flag(callee, NF_AT | NF_MUT | NF_CHECKED)
    nodes[callee].type = 0
    nodes[n] = Node(kind = .call, pos = nodes[n].pos, a = i32(callee), aux2 = i32(AUX2_PARTIAL))
    dewy_partial(n, expected)

# Sloppy: `S(cell, data(cell))` gives the array cell to the record, then data(cell) reads cell
# after that move: it unshares the variable's own copy from the one given, so the pointer points
# into storage the record does not hold (and that goes with the variable). The arguments in
# their evaluation order; one walk of each.
dewy_data_after_give = (n: int):
    given: int[]
    order: int[]
    meta = int(nodes[n].c)
    if meta != 0:
        loop e in kids(meta): order.push(nodes[e].ival)
    else:
        loop i in [0..nkids(n)): order.push(i)
    loop i in order:
        a = kid(n, i)
        if a == 0: continue
        a = unnamed(a)
        v = a
        loop nodes[v].kind == .conv: v = int(nodes[v].a)
        if nodes[v].kind == .ident and (nodes[v].aux == i32(int(SK.local)) or nodes[v].aux == i32(int(SK.global))) and tkind(ntype(v)) == .array:
            given.push(int(nodes[v].aux) * 1000000000 + int(nodes[v].sym))
            continue
        if given.len() > 0: dewy_data_of_given(a, given, n)

dewy_data_of_given = (e: int, given: int[], call: int):
    if e == 0: return
    k = nodes[e].kind
    if k == .lambda or k == .fn_: return
    if k == .intrinsic and (nodes[e].aux as IN) == .arrdata and nkids(e) == 1:
        x = kid(e, 0)
        loop nodes[x].kind == .conv: x = int(nodes[x].a)
        if nodes[x].kind == .ident and given.contains(int(nodes[x].aux) * 1000000000 + int(nodes[x].sym)):
            nm = name_of(int(nodes[x].name))
            what = dt(ntype(call))
            fatal(nodes[e].pos, "data({nm}) reads '{nm}' after it was moved into the {what} (an earlier argument): it unshares the variable's own copy, so the pointer would not point into the array the {what} holds; take `p = data({nm})` before, and pass p")
    mask = isolation_children(k)
    if mask < 0: return
    if mask & 1 != 0: dewy_data_of_given(int(nodes[e].a), given, call)
    if mask & 2 != 0: dewy_data_of_given(int(nodes[e].b), given, call)
    if mask & 4 != 0: dewy_data_of_given(int(nodes[e].c), given, call)
    if mask & 16 != 0:
        loop c in kids(e): dewy_data_of_given(c, given, call)

mk_ident_local = (l: int, pos: int) -> int:
    n = mk(.ident, pos)
    nodes[n].name = locals[l].name
    nodes[n].sym = i32(l)
    nodes[n].type = locals[l].type
    nodes[n].aux = i32(int(SK.local))
    add_flag(n, NF_CHECKED)
    n

# The interpolation checked last, for an unknown name inside one: ident_unknown.
interpolation_last = 0

member_receiver = (n: int, expected: int) -> int:
    saved_receiver = type_receiver_at
    type_receiver_at = int(nodes[n].a)
    bt = check_expr(int(nodes[n].a), receiver_literal_hint(int(nodes[n].a), int(nodes[n].name), 0, expected, nodes[n].pos))
    type_receiver_at = saved_receiver
    nodes[n].a = i32(last_checked)
    bt
# (Dewy's `xs.length` is `xs.len()`; `xs.ptr`, where an array's elements are, is
# `xs.data()`: a ptr<T> for C (provisional spelling))
member_call = (n: int, data: bool, expected: int) -> int:
    method = mk(.field, nodes[n].pos)
    nodes[method].a = nodes[n].a
    if data: nodes[method].name = i32(intern("data"))
    else: nodes[method].name = i32(intern("len"))
    nodes[n] = Node(kind = .call, pos = nodes[n].pos, a = i32(method))
    check_expr(n, expected)

member_missing = (n: int, bt: int, expected: int, bypass: mut bool) -> int:
    fname = int(nodes[n].name)
    bk = types[bt].kind
    t = 0
    # (`pair.length` of a `[int64 string]`: its number of positions)
    if t == 0 and bk == .tuple and (fname == id_dewy_len or name_of(fname) == "length") and files[pos_file(nodes[n].pos)].is_dewy:
        receiver = int(nodes[n].a)
        add_flag(receiver, NF_CHECKED)
        count = bc_int(int(types[bt].nargs), nodes[n].pos)
        # (a receiver that could do something still runs)
        if nodes[receiver].kind != .ident: count = bc_block([bc_stmt(receiver, nodes[n].pos), bc_stmt(count, nodes[n].pos)], nodes[n].pos)
        nodes[n] = nodes[count]
        bypass = true
        return check_expr(n, expected)
    if t == 0:
        if bk == .opt:
            et = prune(int(types[bt].elem))
            has = false
            if types[et].kind == .struct_:
                esi = int(types[et].st)
                check_struct_fields(esi)
                loop i in [0..int(structs[esi].nfields)):
                    if int(fields[int(structs[esi].fields) + i].name) == fname: has = true
            if has:
                if files[pos_file(nodes[n].pos)].is_dewy:
                    fatal(nodes[n].pos, "this {dt(bt)} may be none (nothing), which has no {name_of(fname)}: check it with `is?none` before accessing the field")
                fatal(nodes[n].pos, "this {dt(bt)} may be none (nothing), which has no {name_of(fname)}: `x!.{name_of(fname)}` when it cannot be none, or `if let v = x: v.{name_of(fname)}`")
        # (transform.position: a function's name, with a field after it)
        if tkind(bt) == .fn_:
            bn = int(nodes[n].a)
            fnn = ""
            if nodes[bn].kind == .ident: fnn = name_of(int(nodes[bn].name))
            else if nodes[bn].kind == .fnref and nodes[bn].sym > 0 and fns[int(nodes[bn].sym)].decl != 0: fnn = name_of(int(nodes[int(fns[int(nodes[bn].sym)].decl)].name))
            if fnn == "transform": fatal(nodes[n].pos, "there are no GameObjects or transforms: where a thing is, is a field of your struct (`pos: vec3`), drawn with `draw_mesh(mesh, translation(pos))`")
            if len(fnn) > 0: fatal(nodes[n].pos, "'{fnn}' is a function, which has no field '{name_of(fname)}': `{fnn}(...)` gives what it makes")
        # (b.velocity, b.position on a physics Body: a handle, asked of its world)
        if types[bt].kind == .struct_ and dt(bt) == "Body" and pos_in_lib(nodes[int(structs[int(types[bt].st)].decl)].pos):
            fatal(nodes[n].pos, "a Body is a handle into its world: ask the world, `w.pos(b)`, `w.velocity(b)`, `w.rotation(b)`, and change it there, `w.set_pos(b, p)`, `w.set_velocity(b, v)`, `w.push(b, impulse)`")
        # (Dewy's length of an n-dimensional array: its shape, tensors.md)
        if name_of(fname) == "length" and is_nd(bt) and files[pos_file(nodes[n].pos)].is_dewy and not (cur_assign != 0 and int(nodes[cur_assign].a) == n):
            nodes[n] = nodes[bc_call("__nd_length", [int(nodes[n].a)], nodes[n].pos)]
            bypass = true
            return check_expr(n, expected)
        # (Dewy's length of a library container or a sequence, as Heap and Pool: its `len`)
        if files[pos_file(nodes[n].pos)].is_dewy and name_of(fname) == "length" and fn_name_for(bt, intern("len")) and library_len_fits(bt) and not (cur_assign != 0 and int(nodes[cur_assign].a) == n):
            # (a member: found through the object, as methods are, whatever `len` names here)
            method = mk(.field, nodes[n].pos)
            nodes[method].a = nodes[n].a
            nodes[method].name = i32(intern("len"))
            nodes[n] = Node(kind = .call, pos = nodes[n].pos, a = i32(method))
            bypass = true
            return check_expr(n, expected)
        if fn_name_for(bt, fname):
            if files[pos_file(nodes[n].pos)].is_dewy:
                # Zero-argument calls may omit their parentheses:
                # `xs.pop` is `xs.pop()`. A field of that name wins.
                if member_call_without_arguments(bt, fname, true):
                    add_flag(int(nodes[n].a), NF_MUT)
                    method = mk(.field, nodes[n].pos)
                    nodes[method].a = nodes[n].a
                    nodes[method].name = i32(fname)
                    nodes[n] = Node(kind = .call, pos = nodes[n].pos, a = i32(method), aux2 = -9)
                    bypass = true
                    t = check_expr(n, expected)
                    call_style_implicit(n, fname * 8 + 5, t)
                    return t
                fatal(nodes[n].pos, "'{name_of(fname)}' needs arguments: `{receiver_text(int(nodes[n].a))}.{name_of(fname)}(...)`")
            fatal(nodes[n].pos, "'{name_of(fname)}' is a function: call it, `x.{name_of(fname)}()`")
        if is_union(bt):
            # (a field every member has, of one type: read from whichever it holds)
            if not (cur_assign != 0 and int(nodes[cur_assign].a) == n):
                uf = union_field(n, bt, fname)
                if uf >= 0:
                    last_checked = n
                    bypass = true
                    return check_expr(n, expected)
            fatal(nodes[n].pos, "{dt(bt)} has no field '{name_of(fname)}' (it is one of its members: find out which first, with {jd(nodes[n].pos, "`match x:` and an arm for each, or `if x is ...:`", "`match x \{ ... }` and an arm for each, or `if x is? ... \{ }`")})")
        if is_map_type(bt): fatal(nodes[n].pos, "{dt(bt)} has no field '{name_of(fname)}' (a map's entries are `m[\"{name_of(fname)}\"]`; for fields by name, make a struct)")
        # (an element of enemies = [] read before anything checked so far pushed one)
        loop g in open_globals:
            gt = prune(int(globals[g].type))
            if tkind(gt) == .array and prune(int(types[gt].elem)) == bt:
                gn = name_of(int(globals[g].name))
                et = pushed_type(gn)
                if len(et) == 0: et = "Thing"
                fatal(nodes[n].pos, "the type of what '{gn}' holds is not known here (it starts empty): write it where '{gn}' is made, as {jd(nodes[n].pos, "`{gn}: {et}[] = []`", "`let {gn}:array<{et}> = []`")}")
        never_cascade(nodes[n].pos, bt)
        cands = fn_names_for(bt)
        if types[bt].kind == .struct_:
            si = int(types[bt].st)
            loop i in [0..int(structs[si].nfields)): cands.push(int(fields[int(structs[si].fields) + i].name))
        fatal(nodes[n].pos, "{dt(bt)} has no field '{name_of(fname)}'{suggestion(name_of(fname), surface_names(cands, nodes[n].pos), bt)}")
    0

# `mean[t1 t2]`: a function named before an array literal is called with it, as with a
# string literal (`printl"hi"`). A function that takes nothing is called first instead
# (f[0] indexes f()).
dewy_bracket_call = (n: int) -> bool:
    base = int(nodes[n].a)
    if nodes[base].kind != .ident or nodes[n].sval != 0 or nkids(n) == 0 or not dewy_at(nodes[n].pos): return false
    nm = int(nodes[base].name)
    s = lookup(nm)
    if s == 0 or syms[s].kind != .fns or bare_fns_call(nm, -1) != 0: return false
    loop x in kids(n):
        k = nodes[x].kind
        if k == .range or k == .namedarg or (k == .ident and name_of(int(nodes[x].name)) == "$new"): return false
    items = if nkids(n) == 1 and dewy_whole_collection(kid(n, 0)): kid(n, 0) else: mk(.array, nodes[n].pos)
    if items != kid(n, 0): set_list(items, kids(n))
    nodes[n].kind = .call
    nodes[n].b = 0
    set_list(n, [items])
    true

index_deref = (pos: int, bt: int):
    ffi_deref(pos, bt)
    return

expr_module = (m: int, name: int) -> int: module_lookup(m, name)

# a swizzle whose components follow each other in memory (.x, .xy, .yzw): a place of its own
swizzle_run = (n: int) -> bool:
    s = name_of(int(nodes[n].name))
    loop i in [1..len(s)):
        if swizzle_index(s[i]) != swizzle_index(s[i - 1]) + 1: return false
    true

check_swizzle = (n: int, bt: int) -> int:
    s = name_of(int(nodes[n].name))
    nb = vec_n(bt)
    if bt == T_MAT4: fatal(nodes[n].pos, "use m[i] to access matrix columns")
    # (v.normalized, v.magnitude: Unity's properties, functions here)
    if s == "normalized": fatal(nodes[n].pos, "a vector's direction is `normalize(v)`")
    if s == "magnitude" or s == "length" or s == "Length": fatal(nodes[n].pos, "a vector's length is `v.norm`")
    if s == "sqrMagnitude" or s == "lengthSquared": fatal(nodes[n].pos, "a vector's length squared is `length_sq(v)`")
    if len(s) < 1 or len(s) > 4: fatal(nodes[n].pos, "invalid vector component '{s}' (a vector has x, y, z and w; `v.norm`, `normalize(v)`, `dot(a, b)` and the like are functions)")
    loop i in [0..len(s)):
        ci = swizzle_index(s[i])
        if ci < 0 or ci >= nb: fatal(nodes[n].pos, "{dt(bt)} has no component '{byte_str(int(s[i]))}'")
    nodes[n].aux = -4
    if len(s) == 1: return vec_comp_type(bt)
    if types[bt].sign:
        if len(s) == 2: return T_IVEC2
        if len(s) == 3: return T_IVEC3
        return T_IVEC4
    if len(s) == 2: return T_VEC2
    if len(s) == 3: return T_VEC3
    T_VEC4

# The statements `if v is? none` checking their then-branch, whose top level may fill v
# (opt_fill_subject): v (a variable, global or field path), the branch, and the alias of
# v's latest fill there.
# (OptFill: checker_state.dewy)
opt_fill_watch: OptFill[]

# A Dewy statement `if v is? none` (or `v =? none`) over an optional v, a variable not
# narrowed or a global or field path: v, else 0. A then-branch that fills v at its top level
# (opt_fill_at) and keeps it filled leaves v holding a value after the if. O(path length).
opt_fill_subject = (cond: int) -> int:
    k = nodes[cond].kind
    a = 0
    if k == .istype and nodes[cond].aux == -1: a = int(nodes[cond].a)
    else if k == .binary and nodes[cond].op == i32(int(Tok.eq)) and nodes[int(nodes[cond].b)].kind == .none_lit: a = int(nodes[cond].a)
    if a == 0 or not files[pos_file(nodes[cond].pos)].is_dewy or types[prune(ntype(a))].kind != .opt: return 0
    if nodes[a].kind == .ident and nodes[a].aux == i32(int(SK.local)):
        if int(locals[int(nodes[a].sym)].flags) & LF_ALIAS != 0: return 0
        return a
    if (nodes[a].kind == .field or nodes[a].kind == .ident and nodes[a].aux == i32(int(SK.global))) and len(path_key(a)) > 0: return a
    0

# v = value (value not optional) at the top level of a branch watching v: its watch, else -1.
# O(nesting of watching ifs * path length).
opt_fill_at = (lhs: int, rt: int, value: int) -> int:
    if types[rt].kind == .opt: return -1
    local = nodes[lhs].kind == .ident and nodes[lhs].aux == i32(int(SK.local))
    key = ""
    if not local:
        key = path_key(lhs)
        if len(key) == 0: return -1
    loop j in [0..opt_fill_watch.len()):
        w = opt_fill_watch[j]
        if int(w.block) != sibling_block: continue
        sub = int(w.subject)
        if local and nodes[sub].kind == .ident and nodes[sub].aux == i32(int(SK.local)) and nodes[sub].sym == nodes[lhs].sym or not local and path_key(sub) == key:
            if can_coerce(value, rt, int(types[prune(ntype(sub))].elem)): return j
            return -1
    -1

# after that assignment: v holds a value from here on, until written again (a path: as the
# assignment narrowed it)
opt_fill = (j: int, lhs: int, pos: int):
    sub = int(opt_fill_watch[j].subject)
    al = 0
    if nodes[sub].kind == .ident and nodes[sub].aux == i32(int(SK.local)): al = opt_unwrap_alias(int(nodes[sub].sym), pos)
    else:
        al = path_alias(lhs)
        if al < 0 or nodes[int(locals[al].alias)].kind != .unwrap: al = 0
    opt_fill_watch[j].alias = i32(al)

# from here on, optional variable l's name stands for its value
opt_unwrap_alias = (l: int, pos: int) -> int:
    e = mk(.unwrap, pos)
    t = int(types[prune(int(locals[l].type))].elem)
    nodes[e].a = i32(mk_ident_local(l, pos))
    nodes[e].type = i32(t)
    add_flag(e, NF_CHECKED)
    nl = new_local(int(locals[l].name), t, pos)
    locals[nl].flags = i32(LF_ALIAS)
    locals[nl].alias = i32(e)
    narrow_store_register(nl)
    nl

# `if` and `if let` run in checker_conditionals.dewy; these are its services.
cond_block = (b: int, expected: int, value: bool, jumps: mut int) -> int:
    jumps = narrow_jumps.len()
    check_block(b, expected, value)
cond_narrow = (cond: int, holds: bool) -> void: narrow_by(cond, holds)
# (the writes an earlier branch logged, restored for its sibling and merged after it;
# a stack, as conditionals nest)
cond_restored: int[][]

# (a literal made only of literals: checking it twice has no other effect)
literal_tree = (e: int) -> bool:
    k = nodes[e].kind
    if k == .int_lit or k == .float_lit or k == .str_lit or k == .bool_lit or k == .none_lit: return true
    if k == .unary: return literal_tree(int(nodes[e].a))
    if k == .map_lit:
        loop pair in kids(e):
            if not literal_tree(int(nodes[pair].a)) or not literal_tree(int(nodes[pair].b)): return false
        return true
    if k != .array or nodes[e].a != 0 or nodes[e].b != 0: return false
    loop i in [0..nkids(e)):
        if not literal_tree(kid(e, i)): return false
    true

# ---------------- struct-of-arrays ----------------
# soa P[] is a struct with an array per field of P; these rewrite its array operations into
# operations on the field arrays

# ---------------- elementwise operations ----------------
# A dotted expression (a .* b .+ c, f.(xs), ...) becomes one loop over the elements: its operands
# that are not themselves dotted operations are evaluated once, and the operation applies to their
# elements, broadcast like numpy (a dimension of length 1, or a missing leading one, stretches).
bc_count = 0

# Brackets also construct records and call user-defined indexing operators. Keep
# range syntax until the receiver type is known: NDArray uses axis slices, while
# other multi-argument brackets receive ordinary stored range values.
dewy_index_ranges = (n: int, receiver: int):
    if not files[pos_file(nodes[n].pos)].is_dewy or is_nd(receiver): return
    if nkids(n) < 2 and types[receiver].kind != .typeval: return
    loop i in [0..nkids(n)):
        r = kid(n, i)
        if nodes[r].kind == .range:
            value = dewy_range_value(r)
            set_kid(n, i, value)
            if nodes[n].b == r: nodes[n].b = i32(value)

# The zone rules this program uses: the pack a Dewy version ships, unless the main file says
# `$time.rules = 'file'` (beside the main file, made with tools/time/gen_rules.py).
time_rules_path = (path: str) -> str:
    if path != path_norm(lib_dir + "/time/rules/current.bin"): return path
    setting = intern("time.rules")
    scope = dir_program_values.get(setting) ?? -1
    if scope < 0 or dir_scopes[scope].value < 2: return path
    rel = name_of(dir_scopes[scope].value - 2)
    i = pos_file(dir_scopes[scope].start)
    chosen = if is_abs_path(rel): rel else: "{files[i].dir}/{rel}"
    d = read_file(chosen)
    if d == none: fatal(dir_scopes[scope].at, "`$time.rules`: cannot read '{chosen}'")
    if len(d!) < 4 or d![..4) != "DZP2": fatal(dir_scopes[scope].at, "`$time.rules`: '{chosen}' is not a rule pack; tools/time/gen_rules.py makes one")
    path_norm(chosen)

# A matrix part can use literal ranges, stored IntRange values or index arrays.
is_part_index = (n: int, receiver: int = 0) -> bool:
    ixs = kids(n)
    if nodes[n].b != 0: ixs = [int(nodes[n].b)]
    loop x in ixs:
        if nodes[x].kind == .range: return true
    if is_nd(receiver):
        loop x in ixs:
            t = representation_type(check_expr(clone(x), 0))
            if is_dewy_range_type(t, "IntRange"): return true
            if (tkind(t) == .array or tkind(t) == .fixed) and is_int(telem(t)): return true
    false

bc_bin = (op: Tok, a: int, b: int, pos: int) -> int:
    n = mk(.binary, pos)
    nodes[n].op = i32(int(op))
    nodes[n].a = i32(a)
    nodes[n].b = i32(b)
    n

# (xs[-1], s[-3..]: counting from the end, as Python and JavaScript do)
neg_index_check = (b: int):
    if nodes[b].kind != .int_lit or nodes[b].ival >= 0: return
    k = -nodes[b].ival
    e = "end"
    if k > 1: e = "end - {k - 1}"
    fatal(nodes[b].pos, "an index counts from 0; from the end it is `{e}` (`xs[end]` is the last, `xs[end - 2..]` the last three)")

# Integer arithmetic around `end` cannot change the receiver. Other index
# expressions retain a value snapshot before invoking user code.
dewy_end_arithmetic = (n: int, name: int) -> bool:
    if n == 0: return true
    k = nodes[n].kind
    if k == .int_lit: return true
    if k == .ident:
        if nodes[n].name == i32(name): return true
        s = lookup(int(nodes[n].name))
        if s == 0 or syms[s].kind != .local: return false
        l = int(syms[s].ref)
        # An alias can stand for a getter or a deferred element read. Keep its
        # snapshot; an ordinary local (including a parameter) is just a value.
        if int(locals[l].flags) & (LF_ALIAS | LF_UNNARROWED) != 0: return false
        return is_int(int(locals[l].type))
    if k == .binary or k == .unary or k == .range:
        return dewy_end_arithmetic(int(nodes[n].a), name) and dewy_end_arithmetic(int(nodes[n].b), name) and dewy_end_arithmetic(int(nodes[n].c), name)
    false

dewy_end_substitute = (e: int, names: int[], source: int, pos: int):
    if e == 0: return
    if nodes[e].kind == .ident and names.contains(int(nodes[e].name)):
        nodes[e] = nodes[dewy_index_end(clone(source), nodes[e].pos)]
        return
    loop c in [int(nodes[e].a), int(nodes[e].b), kid_c(e), kid_d(e)]: dewy_end_substitute(c, names, source, pos)
    loop c in kids(e):
        if c != int(nodes[e].b): dewy_end_substitute(c, names, source, pos)

# xs[b] with b a bool[] (a mask) or int[] (indexes): the function that picks (or sets) them
index_array_fn = (b: int, base: str) -> str:
    expected = if nodes[b].kind == .array and nkids(b) == 0 and nodes[b].b == 0: mk_array(T_INT) else: T_INT
    it = prune(check_expr(b, expected))
    if is_dewy_range_type(it, "IntRange"): return base
    if types[it].kind != .array and types[it].kind != .fixed: return ""
    et = prune(int(types[it].elem))
    if types[et].kind == .bool_: return base + "_mask"
    if et == T_INT or et == T_MATH_INT: return base + "_indices"
    fatal(nodes[b].pos, jd(nodes[b].pos, "an array of indexes is int[], or a mask bool[] (found {dt(it)})", "an array of indexes is array<int64>, or a mask array<bool> (found {dt(it)})"))
    ""

bc_assign = (target: int, v: int, pos: int) -> int:
    a = mk(.assign, pos)
    nodes[a].op = i32(int(Tok.assign))
    nodes[a].a = i32(target)
    nodes[a].b = i32(v)
    a

# The library's `__release_at(xs, i)` (lib/core/map.jo), when a call resolves to that
# declaration: xs[i] = the zero bytes of its element type, an intrinsic that makes no checked
# value, so the element's contract and defaults are not consulted. The store lets go of what
# the element held. The declaration's own body serves earlier compilers.
release_name = intern("__release_at")

callable_fits = (from0: int, to0: int) -> bool:
    if ownership_callable_cap(from0) > ownership_callable_cap(to0): return false
    if not effect_contract_fits(from0, to0): return false
    from = callable_base(from0)
    to = callable_base(to0)
    if types[from].kind != .fn_ or types[to].kind != .fn_: return false
    # (one value and several are different results: `<():>array<int64>>` is not `<():>(int64 int64)>`)
    if types[from].sign != types[to].sign: return false
    if types[from].mutmask != types[to].mutmask or types[from].nargs != types[to].nargs: return false
    if types[to].bits != 0 and types[from].bits != types[to].bits: return false
    loop i in [0..int(types[from].nargs)):
        if types[from].mutmask & i32(1 << i) != 0:
            if not type_eq(targ(from, i), targ(to, i)): return false
        else if is_fn_type(targ(to, i)) and is_fn_type(targ(from, i)):
            if not callable_fits(targ(to, i), targ(from, i)): return false
        else if not refine_implies(targ(to, i), targ(from, i)): return false
    if is_fn_type(int(types[from].elem)) and is_fn_type(int(types[to].elem)): return callable_fits(int(types[from].elem), int(types[to].elem))
    prune(int(types[from].elem)) == T_NEVER or refine_implies(int(types[from].elem), int(types[to].elem))

is_nd = (t0: int) -> bool:
    t = prune(t0)
    types[t].kind == .struct_ and structs[int(types[t].st)].name == "NDArray"

# ---------------- unions: `is` and narrowing ----------------
# x is T: aux = the member's index for a union; -1 (is none) or -2 (has a value) for an optional
# When only Map.get's outer optional tag is observed, use its presence query.
# Keep the checked expression intact for types and conservative effect analysis;
# lowering uses the original arguments and their written evaluation order.
map_presence_fn = (call: int) -> int:
    if nodes[call].kind != .call or nodes[call].aux != 0 or nkids(call) != 2: return 0
    f = int(nodes[call].sym)
    d = int(fns[f].decl)
    if d == 0 or nodes[d].name != intern("get"): return 0
    path = lib_dir + "/core/map.jo"
    if files[pos_file(nodes[d].pos)].path != path: return 0
    decls: int[]
    collect_module(int(nodes[d].mod), intern("has"), &decls)
    loop candidate in decls:
        if files[pos_file(nodes[candidate].pos)].path == path:
            return get_fn_inst(candidate, fns[f].targs, nodes[call].pos)
    0

# Optional operations keep their declared optional view even when an alias is
# known to hold a value. Ordinary nonoptional operands remain type errors.
narrow_optional_source = (a: int) -> int:
    if nodes[a].kind != .ident or nodes[a].aux != i32(int(SK.local)): return a
    l = int(nodes[a].sym)
    if int(locals[l].flags) & LF_ALIAS == 0: return a
    al = int(locals[l].alias)
    if al != 0 and nodes[al].kind == .unwrap: return int(nodes[al].a)
    a

# Only condition-created aliases escape a guard, never locals declared in an arm.
narrow_promote = (first: int, limit: int):
    loop l in [first..limit):
        if int(locals[l].flags) & (LF_ALIAS | LF_UNNARROWED) != LF_ALIAS: continue
        nm = int(locals[l].name)
        if nm != 0: push_scope_sym(nm, new_sym(nm, .local, l, 0))

# where condition c is `holds` (true or false), variables it tests with `is` stand for the member
narrow_by = (c: int, holds: bool):
    if holds and string_set_tests.has(c): narrow_string_set(c)
    k = nodes[c].kind
    if k == .istype: narrow_var(c, holds)
    else if k == .binary and (nodes[c].op == i32(int(Tok.ne)) or nodes[c].op == i32(int(Tok.eq))) and nodes[int(nodes[c].b)].kind == .none_lit:
        # x != none: as `x is T` holding (x is its value from here)
        isn = mk(.istype, nodes[c].pos)
        nodes[isn].a = nodes[c].a
        nodes[isn].aux = -2
        narrow_var(isn, holds == (nodes[c].op == i32(int(Tok.ne))))
    else if k == .not_: narrow_by(int(nodes[c].a), not holds)
    else if k == .and_ and holds:
        narrow_by(int(nodes[c].a), true)
        narrow_by(int(nodes[c].b), true)
    else if k == .or_ and not holds:
        narrow_by(int(nodes[c].a), false)
        narrow_by(int(nodes[c].b), false)
    else if k == .or_ and holds:
        # x is A or x is B: x is an A | B
        tests: int[]
        if or_tests(c, tests): narrow_some(tests)
    else if k == .and_ and not holds: narrow_opt_rest_by(c)
    else if k == .binary: position_guard_note(c, holds)

# `x is? C` on x: (A | B | C)? is `x != none and x is? C` (check_istype); when it fails,
# x is none or one of the other members: an (A | B)?. x a field path or a global: as the `_`
# arm of a match on it (opt_wild_narrow_path). O(members).
narrow_opt_rest_by = (c: int):
    a = int(nodes[c].a)
    if nodes[a].kind != .binary or nodes[a].op != i32(int(Tok.ne)) or nodes[int(nodes[a].b)].kind != .none_lit: return
    x = int(nodes[a].a)
    local = nodes[x].kind == .ident and nodes[x].aux == i32(int(SK.local))
    l = 0
    key = ""
    if local: l = int(nodes[x].sym)
    else:
        key = path_key(x)
        if len(key) == 0: return
    ut = prune(ntype(x))
    if local: ut = prune(int(locals[l].type))
    if types[ut].kind != .opt or not is_union(prune(int(types[ut].elem))): return
    u = prune(int(types[ut].elem))
    tests: int[]
    if not or_tests(int(nodes[c].b), tests): return
    excluded: int[]
    loop t in tests:
        # (each test reads x's payload: the alias `x != none` gave it)
        ta = int(nodes[t].a)
        if nodes[ta].kind != .ident or nodes[ta].aux != i32(int(SK.local)): return
        tl = int(nodes[ta].sym)
        if int(locals[tl].flags) & LF_ALIAS == 0 or locals[tl].alias == 0: return
        al = int(locals[tl].alias)
        if nodes[al].kind != .unwrap: return
        inner = int(nodes[al].a)
        if local and (nodes[inner].kind != .ident or int(nodes[inner].sym) != l): return
        if not local and path_key(inner) != key: return
        if not type_eq(prune(ntype(ta)), u): return
        excluded.push(union_members(u)[int(nodes[t].aux)])
    keep: int[]
    loop m in union_members(u):
        if not excluded.contains(m): keep.push(m)
    if keep.len() == 0: return
    pos = nodes[x].pos
    if not local:
        opt_wild_narrow_path(x, key, ut, excluded, false, pos)
        return
    # (x already narrowed so: narrow its variable, as narrow_local does)
    loop int(locals[l].flags) & LF_ALIAS != 0 and opt_rest_aliases.has(int(locals[l].alias)): l = narrowed_var(l)
    inner = keep[0]
    if keep.len() > 1: inner = mk_union(keep)
    nl = new_local(int(locals[l].name), mk_opt(inner), pos)
    locals[nl].flags = i32(LF_ALIAS)
    locals[nl].alias = i32(opt_rest_expr(l, keep, pos))
    narrow_store_register(nl)

# Optional-union narrowing aliases: `if x != none: some(payload as the kept members) else none`,
# an expression of x (narrowed_var finds x in its condition)
opt_rest_aliases: {int: bool} = {}

narrow_var = (isn: int, holds: bool):
    a = int(nodes[isn].a)
    if nodes[a].kind == .field or (nodes[a].kind == .ident and nodes[a].aux == i32(int(SK.global))):
        narrow_path(a, int(nodes[isn].aux), holds)
        return
    if nodes[a].kind != .ident or nodes[a].aux != i32(int(SK.local)): return
    l = int(nodes[a].sym)
    ut = prune(int(locals[l].type))
    vi = int(nodes[isn].aux)
    pos = nodes[a].pos
    if is_union(ut):
        ms = union_members(ut)
        if holds: narrow_local(l, [ms[vi]], pos)
        else:
            # (not that member: one of the others)
            rest: int[]
            loop i in 0.. and m in ms:
                if i != vi: rest.push(m)
            narrow_local(l, rest, pos)
        return
    if types[ut].kind != .opt or (vi == -2) != holds: return
    opt_unwrap_alias(l, pos)

# from here on, union variable l is known to hold one of members ms: its name stands for that
# member (one) or the smaller union of them (converted from the variable's value when used)
narrow_local = (l: int, ms: int[], pos: int):
    # (a variable already narrowed to some of its members: narrow the variable itself)
    root = mk_ident_local(l, pos)
    if int(locals[l].flags) & LF_ALIAS != 0:
        al = int(locals[l].alias)
        if nodes[al].kind == .conv and nodes[al].aux == i32(int(CV.union_)): root = copy_path(int(nodes[al].a))
    narrow_expr(root, ms, pos, int(locals[l].name))

# the name `name` stands for root (a variable or field path) narrowed to members ms of its union
narrow_expr = (root: int, ms: int[], pos: int, name: int):
    rt = prune(ntype(root))
    if ms.len() == 0: return
    e = 0
    t = 0
    if types[rt].kind == .opt:
        if ms.len() != 1 or not type_eq(ms[0], telem(rt)): return
        e = mk(.unwrap, pos)
        t = telem(rt)
    else if not is_union(rt): return
    else if ms.len() == 1:
        e = mk(.narrow, pos)
        nodes[e].aux = i32(union_index(rt, ms[0]))
        t = ms[0]
    else:
        t = mk_union(ms)
        if type_eq(t, rt): return
        e = mk(.conv, pos)
        nodes[e].aux = i32(int(CV.union_))
    nodes[e].a = i32(root)
    nodes[e].type = i32(t)
    add_flag(e, NF_CHECKED)
    nl = new_local(name, t, pos)
    locals[nl].flags = i32(LF_ALIAS)
    locals[nl].alias = i32(e)
    narrow_store_register(nl)

# ---- narrowing field paths (x.f, x.f.g, a global g) ----
# a narrowed path is a scope entry named by its key ("#L<local>.<field>...", "#G<global>..."),
# standing for an alias local; the tag is still checked when the value is used (a call or a
# closure may have changed it)
path_narrows = 0                # (none yet: field accesses need not look)
no_narrow_at = 0                # (the target of an assignment: the field or global itself, not what it narrows to; a narrowed
                                # path it is a part of, as x in x.hp = 7, is still narrowed)

# Declaration aliases preserve path identity. Narrowing aliases retain their
# own roots so forgetting a parent can also retire paths below its payload.
# O(alias/path depth), with no allocation for an unrelated local.
path_decl_alias = (l: int) -> int:
    if int(locals[l].flags) & LF_ALIAS == 0: return 0
    a = int(locals[l].alias)
    if a == 0: return 0
    # Path keys represent declaration roots and fields, not array selectors.
    # Keep an element alias's own stable root for narrowing inside its value.
    root = a
    loop nodes[root].kind == .field and nodes[root].a != 0: root = int(nodes[root].a)
    if nodes[root].kind == .ident: return a
    0

path_key = (n: int) -> str:
    k = nodes[n].kind
    if k == .ident:
        if nodes[n].aux == i32(int(SK.local)):
            a = path_decl_alias(int(nodes[n].sym))
            if a != 0: return path_key(a)
            return "#L{nodes[n].sym}"
        if nodes[n].aux == i32(int(SK.global)): return "#G{nodes[n].sym}"
        return ""
    if k == .field and nodes[n].aux >= 0 and nodes[n].a != 0:
        a = int(nodes[n].a)
        if tkind(ntype(a)) != .struct_: return ""
        b = path_key(a)
        if len(b) == 0: return ""
        return "{b}.{nodes[n].aux}"
    ""

# The locals and globals some narrowed path starts from (path_name marks them): a path from
# any other has no scope entry, so there is nothing to look up or forget for it
path_rooted_l: bool[]
path_rooted_g: bool[]

# a narrowed path's key as a scope name, its root marked
path_name = (key: str) -> int:
    i = 2
    id = 0
    loop i < len(key) and key[i] >= '0' and key[i] <= '9':
        id = id * 10 + int(key[i] - '0')
        i += 1
    if key[1] == 'L':
        if path_rooted_l.len() <= id: path_rooted_l.resize(id * 2 + 64)
        path_rooted_l[id] = true
    else:
        if path_rooted_g.len() <= id: path_rooted_g.resize(id * 2 + 64)
        path_rooted_g[id] = true
    intern(key)

# might the field path (or name) n have a narrowed scope entry: its root is marked
path_rooted = (n0: int) -> bool:
    n = n0
    loop nodes[n].kind == .field and nodes[n].a != 0: n = int(nodes[n].a)
    if nodes[n].kind != .ident: return false
    id = int(nodes[n].sym)
    if nodes[n].aux == i32(int(SK.local)):
        a = path_decl_alias(id)
        if a != 0: return path_rooted(a)
        return id < path_rooted_l.len() and path_rooted_l[id]
    if nodes[n].aux == i32(int(SK.global)): return id < path_rooted_g.len() and path_rooted_g[id]
    false

# a checked copy of a field path
copy_path = (n: int) -> int:
    c = nodes.len()
    nodes.push(nodes[n])
    if nodes[n].kind == .field: nodes[c].a = i32(copy_path(int(nodes[n].a)))
    c

# the alias local a field path (or global) is narrowed to here, or -1
path_alias = (n: int) -> int:
    if not path_rooted(n): return -1
    key = path_key(n)
    if len(key) == 0: return -1
    s = lookup(intern(key))
    if s == 0 or syms[s].kind != .local: return -1
    al = int(syms[s].ref)
    if int(locals[al].owner) != int(ctxs[cx].inst) or int(locals[al].flags) & LF_UNNARROWED != 0: return -1
    al

narrow_path = (a: int, vi: int, holds: bool):
    key = path_key(a)
    if len(key) == 0: return
    ut = prune(ntype(a))
    pos = nodes[a].pos
    path_narrows += 1
    if is_union(ut):
        sel: int[]
        loop i in 0.. and m in union_members(ut):
            if (i == vi) == holds: sel.push(m)
        narrow_expr(copy_path(a), sel, pos, path_name(key))
    else if types[ut].kind == .opt and (vi == -2) == holds:
        e = mk(.unwrap, pos)
        nodes[e].a = i32(copy_path(a))
        nodes[e].type = types[ut].elem
        add_flag(e, NF_CHECKED)
        nl = new_local(path_name(key), int(types[ut].elem), pos)
        locals[nl].flags = i32(LF_ALIAS)
        locals[nl].alias = i32(e)

# the `x is M` tests (of members) an or-chain is made of; false: it has something else too
or_tests = (c: int, out: mut int[]) -> bool:
    k = nodes[c].kind
    if k == .or_: return or_tests(int(nodes[c].a), out) and or_tests(int(nodes[c].b), out)
    if k == .istype and nodes[c].aux >= 0:
        out.push(c)
        return true
    false

# x is A or x is B ... holding: x is one of those members (when all test the same x)
narrow_some = (tests: int[]):
    a0 = int(nodes[tests[0]].a)
    ut = prune(ntype(a0))
    if not is_union(ut): return
    local = nodes[a0].kind == .ident and nodes[a0].aux == i32(int(SK.local))
    key = ""
    if not local:
        key = path_key(a0)
        if len(key) == 0: return
    sel: int[]
    loop t in tests:
        a = int(nodes[t].a)
        if local:
            # (a later test sees the variable narrowed by the earlier ones failing)
            if nodes[a].kind != .ident or nodes[a].aux != i32(int(SK.local)): return
            if narrow_root_local(int(nodes[a].sym)) != narrow_root_local(int(nodes[a0].sym)): return
        else if path_key(a) != key: return
        at = prune(ntype(a))
        if not is_union(at): return
        m = union_members(at)[int(nodes[t].aux)]
        if not sel.contains(m): sel.push(m)
    if local: narrow_local(int(nodes[a0].sym), sel, nodes[a0].pos)
    else:
        path_narrows += 1
        narrow_expr(copy_path(a0), sel, nodes[a0].pos, path_name(key))

# the variable a narrowed alias local stands for (l itself when it is not one)
narrow_root_local = (l0: int) -> int:
    l = l0
    loop int(locals[l].flags) & LF_ALIAS != 0:
        al = int(locals[l].alias)
        if nodes[al].kind != .conv and nodes[al].kind != .narrow: return l
        inner = int(nodes[al].a)
        if nodes[inner].kind != .ident or nodes[inner].aux != i32(int(SK.local)): return l
        l = int(nodes[inner].sym)
    l

# the path (and paths inside it) may hold another value from here on: forget their narrowing
path_forget = (key: str, same_type: int = 0):
    if path_narrows == 0 or len(key) == 0: return
    prefix = key + "."
    i = check_scopes.names.len() - 1
    floor = int(ctxs[cx].floor)
    loop i >= floor:
        nm = name_of(check_scopes.names[i])
        if nm == key or starts_with(nm, prefix):
            sy = check_scopes.syms[i]
            if syms[sy].kind == .local:
                l = int(syms[sy].ref)
                if int(locals[l].flags) & LF_ALIAS != 0:
                    # Replacing a known member with the same member preserves
                    # its tag, but invalidates any facts about fields inside it.
                    keep = false
                    if nm == key and same_type != 0:
                        t = prune(int(locals[l].type))
                        keep = type_eq(t, same_type) or (is_union(t) and union_index(t, same_type) >= 0)
                    if not keep: narrow_invalidate(l)
                    # Nested paths can use this alias as their root after the
                    # parent was narrowed, rather than the original path text.
                    path_forget("#L{l}")
        i -= 1

relocate_name = intern("__relocate_at")

take_name = intern("__take_at")

call_totaldict_member = (name: int) -> bool: name_of(name) == "pop" or name_of(name) == "clear"

call_numeric_member = (name: int) -> bool: name_of(name) == "wrap" or name_of(name) == "bitcast"

call_collect_module = (mod: int, name: int, out: mut int[]): collect_module(mod, name, &out)

call_collect_named = (name: int, mod: int, out: mut int[]): collect_named(name, mod, &out)

call_collect_fns = (name: int, out: mut int[]): collect_fns(name, &out)

binary_context = (e: int, t: int, op: int) -> bool: binary_literal_context(e, t, op as Tok)

# (check_binary's end for numbers: division, literal folding, the joined type; it runs in
# checker_numeric.dewy, these are its services)
binary_numeric = (n: int, op: Tok, a: int, b: int, ta: int, tb: int, is_cmp: bool) -> int: xw_numeric(n, i32(int(op)), a, b, ta, tb, is_cmp)

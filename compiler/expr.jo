    Intrinsic("len", .len, true), Intrinsic("cap", .arrcap, true), Intrinsic("push", .push, true),
    Intrinsic("pop", .pop, true), Intrinsic("insert", .insert, true), Intrinsic("remove", .remove, true),
    Intrinsic("clear", .clear, true), Intrinsic("reserve", .reserve, true), Intrinsic("resize", .resize, true),
    Intrinsic("extend", .extend, true),
    Intrinsic("truncate", .truncate, true), Intrinsic("data", .arrdata, true),
    Intrinsic("__permutable_data", .arrdata_permute, false),
    Intrinsic("fill", .fill, false), Intrinsic("syscall", .syscall, false), Intrinsic("mem_copy", .memcpy, false), Intrinsic("mem_set", .memset, false),
    Intrinsic("__integer_mode", .integer_mode, false), Intrinsic("size_of", .sizeof, false), Intrinsic("align_of", .alignof, false), Intrinsic("panic", .panic, false),
    Intrinsic("assert", .assert, false), Intrinsic("print", .print, false), Intrinsic("embed", .embed, false), Intrinsic("embed_dir", .embed_dir, false),
    Intrinsic("str_from_bytes", .from_bytes, false), Intrinsic("bytes", .to_bytes, false), Intrinsic("__argv", .argv, false),
    Intrinsic("unreachable", .unreachable, false), Intrinsic("sqrt", .sqrt, false), Intrinsic("__offset_unit", .offset_unit, false), Intrinsic("__fmt_fields", .fmt_struct, false), Intrinsic("__fmt_elem_value", .fmt_elem, false), Intrinsic("__gpu_kernel", .gpu_kernel, false),
    Intrinsic("__mul_hi", .mul_hi, false), Intrinsic("__hash_value", .hash, false), Intrinsic("__set_len", .setlen, false), Intrinsic("__call_raw", .callc, false),
    Intrinsic("shader", .shader, false), Intrinsic("__setjmp", .setjmp, false), Intrinsic("__longjmp", .longjmp, false), Intrinsic("__jump", .jump, false),
    Intrinsic("__clone_thread", .clone_thread, false), Intrinsic("__atomic_add", .atomic_add, false),
    Intrinsic("__atomic_cas", .atomic_cas, false), Intrinsic("__stack_ptr", .stack_ptr, false),
    Intrinsic("__cpu_features", .cpu_features, false), Intrinsic("__code_sync", .code_sync, false), Intrinsic("compute", .compute, false), Intrinsic("__compute_spirv", .compute_spirv, false), Intrinsic("__compute_textures", .compute_textures, false),
    Intrinsic("__read_fields", .read_fields, false), Intrinsic("__setting_read", .setting_read, false), Intrinsic("__default_init", .default_init, false),
    Intrinsic("__json_fields", .json_fields, false), Intrinsic("__task_report", .task_report, false), Intrinsic("__task_data", .task_data, false), Intrinsic("__task_nanoseconds", .task_duration, false),
]

last_checked = 0
setting_site = 0               # the call whose parameter default is being filled in
const AUX2_PARTIAL = -10       # a call node that `@` makes a partial evaluation

const AUX2_EMPTY_PARENS = -13   # a call written `f()` or `x.f()` with no arguments whose `()` a style hint may ask to drop (call_style.dewy)
const AUX2_PLACE = -11         # a call `@(m.lock())` taking the place a method returns (place_methods.jo)
callee_at = 0                  # the callee a call is resolving: a Dewy function name there is not called by itself
embedded_files: str[]          # actual compile-time inputs, including those used inside functions
intrinsic_names: int[]         # interned name -> intrinsic index + 1; 0 means no intrinsic
dewy_set_name = -1             # the interned `__dewy_set`
float_key_names: int[]         # interned `__dewy_make_set`, `set`, `k`, `value` (map_float_key)
habit_names: int[]             # interned line, text, clear, fill, push, pop, map, atan, random (habit_call_check)

register_intrinsics = ():
    intrinsic_names = []
    loop i in 0.. and it in intrinsics:
        nm = intern(it.name)
        loop intrinsic_names.len() <= nm: intrinsic_names.push(0)
        intrinsic_names[nm] = i + 1
        if it.id == .dewy_set: dewy_set_name = nm
        universe[nm] = new_sym(nm, .builtin, int(it.id), 0)
    float_key_names = [intern("__dewy_make_set"), intern("set"), intern("k"), intern("value")]
    habit_names = [intern("line"), intern("text"), intern("clear"), intern("fill"), intern("push"), intern("pop"), intern("map"), intern("atan"), intern("random")]

is_lit = (n: int) -> bool: has_flag(n, NF_LITERAL)
lit_default = (n: int) -> int:
    k = nodes[n].kind
    if k == .float_lit and nodes[n].sval != 0: return decimal_type(nodes[n].pos)
    if k == .float_lit: return T_FLOAT
    if k == .unary or k == .conv: return lit_default(int(nodes[n].a))
    if k == .binary:
        if lit_default(int(nodes[n].a)) == T_FLOAT or lit_default(int(nodes[n].b)) == T_FLOAT: return T_FLOAT
    if files[pos_file(nodes[n].pos)].is_dewy: return T_MATH_INT
    T_INT

ntype = (n: int) -> int: int(nodes[n].type)

# Decimal source text survives parsing until its numeric context is known.
# A float context consumes fval directly; otherwise construct exact BigInt
# parts, without parsing text or rounding through a float at run time.
decimal_cached_type = 0

decimal_type = (pos: int) -> int:
    if decimal_cached_type != 0: return decimal_cached_type
    ensure_bundled_import("rational.dewy", "$dewy_rational", pos)
    ty = bc_field(bc_ident("$dewy_rational", pos), "Rational", pos)
    decimal_cached_type = telem(check_expr(ty, 0))
    decimal_cached_type

word_rational_cached_type = 0

word_rational_type = (pos: int) -> int:
    if word_rational_cached_type != 0: return word_rational_cached_type
    ensure_bundled_import("rational.dewy", "$dewy_rational", pos)
    ty = bc_field(bc_ident("$dewy_rational", pos), "RationalWord", pos)
    word_rational_cached_type = telem(check_expr(ty, 0))
    word_rational_cached_type

# Rationals folded at compilation, by node: their normalized word parts, and how
# they print (the library's `_shown`: 1 a decimal literal, 2 a written fraction).
rational_constants: {int: (int, int)}
rational_shown: {int: int}

# Does the value n of type from fit rational<int64> exactly, for every value?
word_rational_source = (n: int, from0: int) -> bool:
    from = prune(from0)
    if rational_constants.has(n): return true
    if not is_int(from): return false
    known, value = integer_constant(n)
    if known: return value >= 0 or types[from].sign or from == T_MATH_INT
    if from == T_MATH_INT: return false
    int_widens(from, T_INT)

# An exact division's only failure is a zero divisor: the caller's obligation,
# as an integer division's (facts.jo fact_divisor): an integer divisor, or a
# rational one, whose numerator a constant or a guard (`b not=? 0`) gives.
rational_divisor = (n: int):
    if nodes[n].kind != .call or nodes[n].aux != 0 or nodes[n].sym <= 0 or nkids(n) != 2: return
    d = int(fns[int(nodes[n].sym)].decl)
    if d == 0 or files[pos_file(nodes[d].pos)].path != lib_dir + "/rational.dewy": return
    e = kid(n, 1)
    loop nodes[e].kind == .conv: e = int(nodes[e].a)
    # (a quantity divides as its number: the same obligation, said as one)
    t = quantity_base(prune(ntype(e)))
    if is_int(t) or t == T_MATH_INT or rational_constants.has(e) or bundled_rational_type(t): fact_divisors[n] = 1

decimal_part = (digits: str, pos: int) -> int:
    ensure_bundled_import("bigint.dewy", "$dewy_decimal_bigint", pos)
    negative = len(digits) > 0 and digits[0] == '-'
    limbs: u64[]
    loop c in digits:
        if c == '-' or c == '+': continue
        carry = u64(c - '0')
        loop i in [0..limbs.len()):
            word = limbs[i] * 10 + carry
            limbs[i] = word & 0xFFFFFFFF
            carry = word >> 32
        if carry != 0: limbs.push(carry)
    items: int[]
    loop limb in limbs:
        item = mk(.int_lit, pos)
        nodes[item].ival = int(limb)
        items.push(item)
    magnitude = mk(.array, pos)
    set_list(magnitude, items)
    sign = mk(.int_lit, pos)
    nodes[sign].ival = if limbs.len() == 0: 0 else if negative: -1 else: 1
    result = mk(.call, pos)
    nodes[result].a = i32(bc_field(bc_ident("$dewy_decimal_bigint", pos), "BigInt", pos))
    set_list(result, [sign, magnitude])
    result

# The normalized constant numerator/denominator (denominator nonzero, both
# above the minimum word) as a direct construction: no runtime reduction.
rational_constant_parts = (numerator: int, denominator: int) -> (int, int):
    let numerator = numerator
    let denominator = denominator
    if denominator < 0:
        numerator = -numerator
        denominator = -denominator
    common = quantity_gcd(numerator, denominator)
    if common > 1:
        numerator = numerator / common
        denominator = denominator / common
    if numerator == 0: denominator = 1
    (numerator, denominator)

rational_constant = (numerator: int, denominator: int, pos: int, word: bool = false, shown: int = 0) -> int:
    parts = rational_constant_parts(numerator, denominator)
    ensure_bundled_import("rational.dewy", "$dewy_rational", pos)
    decimal_type(pos)
    type_name = if word: "RationalWord" else: "Rational"
    result = mk(.call, pos)
    nodes[result].a = i32(bc_field(bc_ident("$dewy_rational", pos), type_name, pos))
    set_list(result, [bc_int(parts.0, pos), bc_int(parts.1, pos), bc_int(shown, pos)])
    result

exact_decimal = (n: int) -> int:
    pos = nodes[n].pos
    text = lower(name_of(int(nodes[n].sval)))
    exponent = 0
    parts = split(text, "e")
    if parts.len() == 2:
        parsed = to_int(parts[1])
        if parsed == none: fatal(pos, "decimal exponent is too large")
        exponent = parsed!
    digits = parts[0]
    fraction = split(digits, ".")
    if fraction.len() == 2:
        exponent -= len(fraction[1])
        digits = fraction[0] + fraction[1]
    denominator = "1"
    if exponent > 0: digits += repeat("0", exponent)
    else if exponent < 0: denominator += repeat("0", -exponent)
    # Word-sized decimals fold to their reduced fraction at compilation.
    magnitude = digits
    negative = len(magnitude) > 0 and magnitude[0] == '-'
    if len(magnitude) > 0 and (magnitude[0] == '-' or magnitude[0] == '+'): magnitude = magnitude[1..]
    loop len(magnitude) > 1 and magnitude[0] == '0': magnitude = magnitude[1..]
    if len(magnitude) <= 18 and len(denominator) <= 19:
        if let top = to_int(magnitude):
            if let bottom = to_int(denominator):
                signed = if negative: -top else: top
                nodes[n] = nodes[rational_constant(signed, bottom, pos, shown = 1)]
                t = check_expr(n, 0)
                rational_constants[n] = rational_constant_parts(signed, bottom)
                rational_shown[n] = 1
                return t
    ensure_bundled_import("rational.dewy", "$dewy_rational", pos)
    decimal_type(pos)
    numerator = decimal_part(digits, pos)
    divisor = decimal_part(denominator, pos)
    nodes[n] = Node(kind = .call, pos = pos, a = i32(bc_field(bc_ident("$dewy_rational", pos), "_decimal", pos)))
    set_list(n, [numerator, divisor])
    check_expr(n, 0)

# replace node n by a conversion of its old content
wrap_conv = (n: int, cv: CV, to: int):
    if cv == .int2float and exact_potential(n): runtime_demand(if to == T_F32: "__exact_i128_f32" else: "__exact_i128_f64")
    inner = nodes.len()
    nodes.push(nodes[n])
    move_divisor(n, inner)
    nodes[n] = Node(kind = .conv, pos = nodes[inner].pos, a = i32(inner), aux = i32(int(cv)), type = i32(to), flags = i32(NF_CHECKED))
    if (cv == .int_ and to == T_INT or (cv == .wrap_int or cv == .saturate_int) and ntype(inner) == T_MATH_INT and exact_constant_use(inner)) and representation_type(ntype(inner)) == T_MATH_INT and dewy_at(nodes[n].pos) and cx >= 0:
        owner = int(ctxs[cx].inst)
        if owner > 0:
            exact_owners[owner] = true
            exact_full_owners[owner] = true

# ---------------- coercion ----------------
# Values already fixed to a scalar type can still be compile-time constants.
# This deliberately excludes calls and reads, whose effects must remain visible.
integer_constant = (n: int) -> (bool, int):
    if nodes[n].kind == .int_lit:
        # (an `int` literal above the i64 range holds only its low word: not a word constant)
        if has_flag(n, NF_U64) and prune(ntype(n)) == T_MATH_INT: return (false, 0)
        return (true, nodes[n].ival)
    if nodes[n].kind != .conv or nodes[n].aux != i32(int(CV.int_)): return (false, 0)
    known, value = integer_constant(int(nodes[n].a))
    if not known: return (false, 0)
    t = prune(ntype(n))
    bits = int(types[t].bits)
    if bits < 64:
        if types[t].sign: value = (value << (64 - bits)) >> (64 - bits)
        else: value = value & ((1 << bits) - 1)
    (true, value)

check_integer_boundary = (n: int, from: int, to: int):
    if to == T_MATH_INT: return
    if from != T_MATH_INT and to != T_MATH_INT: return
    if int_widens(from, to): return
    known, value = integer_constant(n)
    if not known: return
    fits = int_fits(value, to)
    if not types[from].sign and value < 0 and types[to].sign: fits = false
    if not fits: fatal(nodes[n].pos, "integer overflow in constant conversion to {dt(to)}")

# An integer stored into a width that cannot hold every value of its own:
# the proven conversion, a refinement of the source to the target's range
# (proven from facts, or checked when the program runs), then the conversion.
narrow_int = (n: int, from: int, to: int):
    if exact_potential(n):
        wrap_conv(n, .int_, to)
        return
    atoms: RefAtom[]
    fbits = int(types[from].bits)
    tbits = int(types[to].bits)
    if types[from].sign and (not types[to].sign or tbits < fbits):
        lo = if types[to].sign: -(1 << (tbits - 1)) else: 0
        atoms.push(RefAtom(.le, RefTerm(1, lo), RefTerm()))
    hi = if types[to].sign: (1 << (tbits - 1)) - 1 else if tbits < 64: (1 << tbits) - 1 else: -1
    from_hi = if types[from].sign: (1 << (fbits - 1)) - 1 else if fbits < 64: (1 << fbits) - 1 else: -1
    if hi >= 0 and (from_hi < 0 or hi < from_hi): atoms.push(RefAtom(.le, RefTerm(), RefTerm(1, hi)))
    inner = nodes.len()
    nodes.push(nodes[n])
    # (a width's range is a local obligation, solved where it is demanded: it does not turn on
    # the program-wide refinement machinery that declared refinements need)
    active = refine_active
    refine_coerce(inner, mk_refined(from, ref_intern(atoms)))
    refine_active = active
    ref_narrowing[inner] = to
    nodes[n] = Node(kind = .conv, pos = nodes[inner].pos, a = i32(inner), aux = i32(int(CV.int_)), type = i32(to), flags = i32(NF_CHECKED))

int_widens = (f: int, t: int) -> bool:
    if t == T_MATH_INT: return true
    if f == T_MATH_INT: return false
    fb = int(types[f].bits)
    tb = int(types[t].bits)
    if types[f].sign == types[t].sign: return tb >= fb
    if not types[f].sign and types[t].sign: return tb > fb
    false

# A literal can take the bundled BigInt's expected type without a runtime
# decimal conversion. Ordinary integer variables keep their fixed-width type.
dewy_bigint_literal_target = (n: int, t0: int) -> bool:
    if n == 0 or nodes[n].kind != .int_lit or not is_lit(n): return false
    if not files[pos_file(nodes[n].pos)].is_dewy: return false
    bundled_bigint_type(t0)

bundled_bigint_type = (t0: int) -> bool:
    t = prune(t0)
    if types[t].kind != .struct_: return false
    decl = int(structs[int(types[t].st)].decl)
    if name_of(int(nodes[decl].name)) != "BigInt": return false
    files[pos_file(nodes[decl].pos)].path == "{lib_dir}/bigint.dewy"

math_rep_type = (t0: int) -> bool:
    t = prune(t0)
    if types[t].kind != .struct_: return false
    decl = int(structs[int(types[t].st)].decl)
    name_of(int(nodes[decl].name)) == "__CTMathRep" and files[pos_file(nodes[decl].pos)].path == "{lib_dir}/math_eval.jo"

can_coerce = (n: int, from0: int, to0: int) -> bool:
    from = prune(from0)
    to = prune(to0)
    if type_eq(from, to): return true
    if from == T_MATH_INT and (math_rep_type(to) or (n != 0 and bundled_bigint_type(to))): return true
    if to == T_MATH_INT and (math_rep_type(from) or (n != 0 and bundled_bigint_type(from))): return true
    if n != 0 and is_float(to) and bundled_rational_type(from): return true
    # An integer promotes to the exact rational with the same value.
    if n != 0 and is_int(from) and bundled_rational_type(to): return true
    # rational<int64> widens to rational and rounds into a float context; a
    # value enters it only when it always fits (a word, a folded constant).
    if n != 0 and bundled_word_rational_type(from) and (bundled_rational_type(to) or is_float(to)): return true
    if n != 0 and bundled_word_rational_type(to) and word_rational_source(n, from): return true
    if from == T_NEVER: return true
    fk = types[from].kind
    tk = types[to].kind
    if fk == .secret or tk == .secret:
        r = secret_can_coerce(n, from, to)
        if r >= 0: return r == 1
    if fk == .tuple and tk == .array and n != 0 and sibling_array_source(n, from, int(types[to].elem)): return true
    if fk == .quantity and tk == .struct_ and time_constant_duration(n, from, to): return true
    if str_sets.len() > 1:
        fs = str_set_of(from)
        ts = str_set_of(to)
        # (by type alone, as library overloads are chosen, a set is not its text)
        if ts != 0 and (fk == .str_ and n != 0 or fs != 0 and (str_set_within(fs, ts) or n != 0 and dewy_at(nodes[n].pos))): return true
        if fs != 0 and tk == .str_ and n != 0: return true
    if fk == .refined or tk == .refined: return can_coerce(n, representation_type(from), representation_type(to))
    if (fk == .array or fk == .fixed) and fk == tk and array_elems_subsume(from, to): return true
    if refine_active and fk == .struct_ and tk == .struct_ and ref_record_conversion(from, to): return true
    if fk == .struct_ and tk == .struct_ and record_int_conversion(from, to): return true
    if fk == .struct_ and tk == .struct_ and intersection_parts.len() > 0 and intersection_within(from, to): return true
    if fk == .quantity or tk == .quantity:
        if fk == .var or tk == .var: return true
        if fk == .quantity and tk == .quantity:
            if types[from].st != types[to].st: return false
            # (an int quantity promotes to the exact rational one, as an int does)
            if n != 0 and quantity_int_promotes(from, to): return true
            return quantity_constant_fits(n, to) or can_coerce(0, quantity_base(from), quantity_base(to))
        if tk != .opt and not is_union(to): return false
    if fk == .polyfn and tk == .fn_: return poly_matches(from, to)
    if has_var(from) or has_var(to):
        if fk == .var or tk == .var: return true
        if fk == tk and fk == .array:
            fe = prune(int(types[from].elem))
            te = prune(int(types[to].elem))
            return types[fe].kind == .var or types[te].kind == .var or type_eq(fe, te)
        if fk == .opt and tk == .opt: return true
    if n != 0 and is_lit(n):
        if nodes[n].kind == .float_lit and nodes[n].sval != 0 and bundled_rational_type(to): return true
        if dewy_bigint_literal_target(n, to): return true
        if nodes[n].kind == .int_lit and (tk == .int_ or tk == .float_): return true
        if nodes[n].kind == .float_lit and tk == .float_: return true
    if fk == .int_ and tk == .int_: return from == T_MATH_INT or to == T_MATH_INT or int_widens(from, to) or n != 0 and dewy_at(nodes[n].pos)
    if fk == .int_ and tk == .float_: return true
    if fk == .float_ and tk == .float_: return true
    if tk == .enum_ and not is_union(from) and is_union(to): return union_target(n, from, to) >= 0
    if is_union(from) and is_union(to): return union_within(from, to)
    if fk == .array and is_soa(to): return can_coerce(0, int(types[from].elem), soa_elem(to))
    if fk == .fixed and tk == .array: return elem_subsumes(int(types[from].elem), int(types[to].elem))
    if tk == .array and is_nd(from): return type_eq(nd_elem(from), int(types[to].elem))
    if (fk == .callable or tk == .callable) and callable_fits(from, to): return true
    if fk == .fn_ and tk == .fn_ and (callable_fits(from, to) or n != 0 and fn_value_adapts(n, from, to)): return true
    if fk == .array and tk == .fixed:
        if n != 0 and fixed_literal_ok(n, to): return true
        return n != 0 and nodes[n].kind != .array and elem_subsumes(int(types[from].elem), int(types[to].elem))
    if tk == .opt:
        if fk == .none_lit: return true
        if type_eq(from, int(types[to].elem)): return true
        if fk == .opt: return can_coerce(0, telem(from), telem(to))
        return can_coerce(n, from, int(types[to].elem))
    if fk == .null_ and (tk == .ptr or tk == .cfn): return true
    if fk == .ptr and tk == .ptr and (to == T_RAWPTR or from == T_RAWPTR): return true
    false

# An array whose elements carry a tighter refinement, read where a looser one is
# wanted: every value its element type admits, the wanted element type admits
# (constant bounds), with the same representation and length; arrays nested inside
# follow the same rule. The value is an immutable share, so no write through the
# looser type can reach the tighter array; `@` places stay invariant (refine.jo).
# O(intervals) per level.
array_elems_subsume = (from0: int, to0: int) -> bool:
    from = prune(from0)
    to = prune(to0)
    fk = types[from].kind
    if fk != types[to].kind or fk != .array and fk != .fixed: return false
    if fk == .fixed and types[from].bits != types[to].bits: return false
    elem_subsumes(int(types[from].elem), int(types[to].elem))

elem_subsumes = (f0: int, t0: int) -> bool:
    f = prune(f0)
    t = prune(t0)
    if f == t or type_eq(f, t): return true
    fk = types[f].kind
    tk = types[t].kind
    if fk != .refined and tk != .refined: return array_elems_subsume(f, t)
    if fk == .refined and types[f].bits == -1 or tk == .refined and types[t].bits == -1: return false
    base = representation_type(f)
    if base != representation_type(t) or types[base].kind != .int_ or base == T_MATH_INT: return false
    fknown, flow, fhigh = int_intervals_wide(f)
    tknown, tlow, thigh = int_intervals_wide(t)
    fknown and tknown and interval_missing(flow, tlow).len() == 0 and interval_missing(fhigh, thigh).len() == 0

# n coerced to `to` where a string set is on either side: true when done (a
# string or set into a set; a set into a string), and a set going where only
# its text fits (an optional string, a union with a string) is made text first
str_set_coerced = (n: int, to: int) -> bool:
    from = prune(ntype(n))
    if from == to: return false
    if str_set_of(to) != 0:
        if types[from].kind == .str_ or str_set_of(from) != 0:
            str_set_coerce(n, to)
            return true
        return false
    fs = str_set_of(from)
    if fs == 0: return false
    tk = types[to].kind
    if tk == .str_:
        str_set_text_of(n)
        return true
    if tk == .opt and types[prune(int(types[to].elem))].kind == .str_: str_set_text_of(n)
    else if is_union(to) and union_index(to, from) < 0:
        fits = false
        loop m in union_members(to):
            ms = str_set_of(m)
            if ms != 0 and str_set_within(fs, ms): fits = true
        if not fits: str_set_text_of(n)
    false

# ordering at pos is the program's Dewy code's: Dewy source, or the library's code inside an
# instance the innermost program call that made it is Dewy's
dewy_ordering = (pos: int) -> bool:
    if not pos_in_lib(pos): return dewy_at(pos)
    k = err_trail.len() - 1
    loop k >= 0 and (err_trail[k] <= 0 or pos_in_lib(err_trail[k])): k -= 1
    k >= 0 and dewy_at(err_trail[k])

# An anonymous record whose numeric fields convert as scalars do (`[x:int]` where
# `[x:int64]` or `[x:float64]` is wanted): field by field, each `int` field the
# proven narrowing, an integer to a float as a scalar converts. O(fields); other
# field types must agree.
record_int_conversion = (from: int, to: int) -> bool:
    fs = int(types[from].st); ts = int(types[to].st)
    if structs[fs].decl != structs[ts].decl or not has_flag(int(structs[fs].decl), NF_RECORD): return false
    check_struct_fields(fs)
    check_struct_fields(ts)
    loop i in [0..int(structs[ts].nfields)):
        a = prune(int(fields[int(structs[fs].fields) + i].type))
        b = prune(int(fields[int(structs[ts].fields) + i].type))
        if type_eq(a, b): continue
        if types[a].kind == .int_ and types[b].kind == .float_: continue
        if types[a].kind != .int_ or types[b].kind != .int_: return false
        if a != T_MATH_INT and b != T_MATH_INT and not int_widens(a, b): return false
    true

# a function of the program's own (not the prelude's) by this name
program_fn_named = (name: int) -> bool:
    own: int[]
    collect_fns(name, &own)
    loop d in own:
        if not decl_in_prelude(d): return true
    false

# the member of union u a value of type `from` becomes (an exact match first), or -1
union_target = (n: int, from: int, u: int) -> int:
    f = from
    if n != 0 and is_lit(n): f = lit_default(n)
    ms = union_members(u)
    loop i in 0.. and m in ms:
        if type_eq(m, f): return i
    if str_sets.len() > 1 and prune(from) == T_STR: return union_text_target(n, ms)
    loop i in 0.. and m in ms:
        if can_coerce(n, from, m): return i
    -1

# Text going into a union with a string set: a literal the set lists is its word, a literal it
# does not list is not offered to it, and other text prefers a member that takes any text, since
# a set would look it up and panic.
union_text_target = (n: int, ms: int[]) -> int:
    e = if n != 0: kid_lit(n) else: 0
    literal = e != 0 and nodes[e].kind == .str_lit and nodes[e].aux != 1
    text = if literal: name_of(int(nodes[e].sval)) else: ""
    if literal:
        loop i in 0.. and m in ms:
            set = str_set_of(m)
            if set != 0 and str_sets[set].contains(text): return i
    looked_up = -1
    loop i in 0.. and m in ms:
        if str_set_of(m) != 0:
            if not literal and looked_up < 0: looked_up = i
            continue
        if can_coerce(n, T_STR, m): return i
    looked_up

# (a wrapper replaces node n and the old content moves to inner: the divisor
# obligation belongs to the moved call)
move_divisor = (n: int, inner: int):
    if let kind = fact_divisors.get(n):
        fact_divisors.remove(n)
        fact_divisors[inner] = kind

# replace node n by the union value holding it as member vi
wrap_union = (n: int, vi: int, to: int):
    inner = nodes.len()
    nodes.push(nodes[n])
    move_divisor(n, inner)
    nodes[n] = Node(kind = .call, pos = nodes[inner].pos, aux = 3, aux2 = i32(vi), type = i32(to), flags = i32(NF_CHECKED))
    set_list(n, [inner])

# can integer type t hold v?
int_fits = (v: int, t: int) -> bool:
    bits = int(types[t].bits)
    if bits >= 64: return types[t].sign or v >= 0
    if types[t].sign: return v >= -(1 << (bits - 1)) and v <= (1 << (bits - 1)) - 1
    v >= 0 and v <= (1 << bits) - 1

# can integer type t hold literal n? (one above the i64 range fits u64, and the 64-bit signed
# types as its bits, e.g. hash constants)
lit_fits = (n: int, t: int) -> bool:
    if t == T_MATH_INT: return true
    if has_flag(n, NF_U64):
        if files[pos_file(nodes[n].pos)].is_dewy:
            return int(types[t].bits) >= 64 and not types[t].sign
        return int(types[t].bits) >= 64
    int_fits(nodes[n].ival, t)

coerce_int_literal = (n: int, to: int) -> int:
    v = nodes[n].ival
    if not lit_fits(n, to):
        if has_flag(n, NF_U64): fatal(nodes[n].pos, "value {u64(v)} does not fit in {dt(to)}")
        fatal(nodes[n].pos, "value {v} does not fit in {dt(to)}")
    nodes[n].type = i32(to)
    clear_flag(n, NF_LITERAL)
    n

# A cast node takes its coerced operand's node (xc_take): the operand's pending
# fixed-size boundary, registered just before by coerce, now lives at `to`.
fact_fixed_moved = (from: int, to: int):
    last = fact_fixed_requests.len() - 1
    if last >= 0 and fact_fixed_requests[last].node == from: fact_fixed_requests[last].node = to

coerce = (n: int, target: int) -> int:
    if target == 0: return n
    # (a settled value already of the type: none of the cases below applies but to literals,
    # refinements and callables)
    if nodes[n].type != 0 and not is_lit(n) and nodes[n].kind != .str_lit and nodes[n].kind != .float_lit:
        to = prune(target)
        if prune(ntype(n)) == to and types[to].kind != .refined and types[to].kind != .callable: return n
    # (an integer literal into a fixed-width integer type: none of the cases before the
    # literal's below applies; its range is checked there and here alike)
    if nodes[n].kind == .int_lit and is_lit(n):
        to = prune(target)
        from = prune(ntype(n))
        if from != 0 and from != T_MATH_INT and to != T_MATH_INT and types[from].kind == .int_ and types[to].kind == .int_: return coerce_int_literal(n, to)
    if refine_active and types[prune(target)].kind == .refined: return refine_coerce(n, target)
    if nodes[n].kind == .float_lit and nodes[n].sval != 0 and is_lit(n) and tkind(target) == .struct_:
        exact_decimal(n)
    if charlike(n) and is_int(target):
        charlike_to_int(n)
        nodes[n].type = i32(target)
        return n
    if effects_active and callable_contract(target) != 0: nodes[n].type = i32(effect_infer_callable(n, target))
    if str_sets.len() > 1 and str_set_coerced(n, prune(target)): return n
    from = prune(ntype(n))
    to = prune(target)
    if from == 0: ice("unchecked expression at {pos_str(nodes[n].pos)}")
    # An immediately consumed exact arithmetic result needs no tagged boundary.
    # The fixed-width consumer below remains the sole narrowing obligation.
    if from == T_MATH_INT and (is_int(representation_type(to)) and representation_type(to) != T_MATH_INT or is_float(to)):
        if not is_lit(n) and is_int(to) and int_policy(to) == 0: check_integer_boundary(n, from, to)
        if exact_narrow_control(n, to): return n
        source = exact_math_operand(n)
        if source != n:
            nodes[n] = nodes[source]
            from = prune(ntype(n))
    if from != to and int_policy(to) != 0 and is_int(from):
        if is_lit(n):
            if nodes[n].kind == .int_lit:
                nodes[n].type = i32(if has_flag(n, NF_U64): T_U64 else: T_INT)
                clear_flag(n, NF_LITERAL)
            else: finalize_literal(n)
        wrap_conv(n, (if int_policy(to) == 1: CV.wrap_int else: CV.saturate_int), to)
        return n
    # Settled identical scalar/aggregate types require no conversion node.
    if from == to and not is_lit(n): return n
    if from == T_NEVER:
        # (what never comes back taken as a value, "a" + panic(...): marked, so code is made for
        # it as for any value of that type, never used)
        if to != T_NEVER and types[to].kind != .void_ and types[to].kind != .var and types[to].kind != .param: wrap_conv(n, CV.none_, to)
        return n
    tk = types[to].kind
    if tk == .secret or types[from].kind == .secret:
        r = secret_coerce(n, from, to)
        if r >= 0: return r
    if types[from].kind == .tuple and tk == .array and sibling_array_source(n, from, int(types[to].elem)): return sibling_to_array(n, from, to)
    if (from == T_MATH_INT and math_rep_type(to)) or (to == T_MATH_INT and math_rep_type(from)):
        wrap_conv(n, .none_, to)
        return n
    if to == T_MATH_INT and bundled_bigint_type(from):
        wrap_conv(n, .big2math, to)
        return n
    if from == T_MATH_INT and bundled_bigint_type(to):
        wrap_conv(n, .math2big, to)
        return n
    if types[from].kind == .quantity and tk == .quantity:
        return quantity_coerce(n, to)
    if types[from].kind == .quantity and tk == .struct_ and time_constant_duration(n, from, to):
        pos = nodes[n].pos
        source = nodes.len()
        nodes.push(nodes[n])
        add_flag(source, NF_CHECKED)
        ensure_bundled_import("time/core.dewy", "$dewy_time", pos)
        nodes[n] = Node(kind = .call, pos = pos, a = i32(bc_field(bc_ident("$dewy_time", pos), "duration_of", pos)))
        set_list(n, [source])
        check_expr(n, to)
        return n
    if bundled_word_rational_type(from) and bundled_rational_type(to): return rational_wrap(n, "_widen", to)
    if bundled_word_rational_type(from) and tk == .float_:
        convert = if to == T_F32: "_word_float32" else: "_word_float64"
        return rational_wrap(n, convert, to)
    if bundled_word_rational_type(to) and word_rational_source(n, from):
        pos = nodes[n].pos
        ensure_bundled_import("rational.dewy", "$dewy_rational", pos)
        if let parts = rational_constants.get(n):
            nodes[n] = nodes[rational_constant(parts.0, parts.1, pos, true, rational_shown.get(n) ?? 0)]
        else:
            source = nodes.len()
            nodes.push(nodes[n])
            add_flag(source, NF_CHECKED)
            nodes[n] = Node(kind = .call, pos = pos, a = i32(bc_field(bc_ident("$dewy_rational", pos), "RationalWord", pos)))
            set_list(n, [source, bc_int(1, pos)])
        check_expr(n, to)
        return n
    if tk == .struct_ and is_int(from) and bundled_rational_type(to):
        # (an integer constant is a rational constant: `x/2` divides by a known nonzero)
        known, value = integer_constant(n)
        if known and (value >= 0 or types[from].sign or from == T_MATH_INT):
            nodes[n] = nodes[rational_constant(value, 1, nodes[n].pos)]
            check_expr(n, to)
            rational_constants[n] = rational_constant_parts(value, 1)
            return n
        source = nodes.len()
        nodes.push(nodes[n])
        pos = nodes[n].pos
        ensure_bundled_import("rational.dewy", "$dewy_rational", pos)
        nodes[n] = Node(kind = .call, pos = pos, a = i32(bc_field(bc_ident("$dewy_rational", pos), "rational", pos)))
        set_list(n, [source])
        check_expr(n, to)
        return n
    if tk == .float_ and bundled_rational_type(from):
        source = nodes.len()
        nodes.push(nodes[n])
        move_divisor(n, source)
        # (checked already: an operator's call, `-x`, has no callee to check again)
        add_flag(source, NF_CHECKED)
        name = if to == T_F32: "to_float32" else: "to_float64"
        callee = bc_field(source, name, nodes[n].pos)
        nodes[n] = Node(kind = .call, pos = nodes[n].pos, a = i32(callee))
        check_expr(n, to)
        return n
    if types[from].kind == .polyfn and tk == .fn_:
        source = nodes.len()
        nodes.push(nodes[n])
        fn_value(n, to, closure = source)
        from = prune(ntype(n))
    if types[from].kind == .fn_ and tk == .fn_ and not callable_fits(from, to) and fn_value_adapts(n, from, to): return fn_value_adapter(n, to)
    if dewy_bigint_literal_target(n, to):
        dewy_coerce_bigint_literal(n, to)
        return n
    if is_lit(n):
        k = nodes[n].kind
        if k == .int_lit and tk == .int_: return coerce_int_literal(n, to)
        if k == .int_lit and tk == .float_:
            nodes[n].kind = .float_lit
            nodes[n].fval = f64(nodes[n].ival)
            if has_flag(n, NF_U64): nodes[n].fval = f64(u64(nodes[n].ival))
            nodes[n].type = i32(to)
            clear_flag(n, NF_LITERAL)
            return n
        if k == .float_lit and tk == .float_:
            if nodes[n].sval != 0 and nodes[n].fval - nodes[n].fval != 0.0: fatal(nodes[n].pos, "real literal exceeds float64")
            nodes[n].type = i32(to)
            clear_flag(n, NF_LITERAL)
            return n
        if tk == .opt and is_numeric(int(types[to].elem)):
            coerce(n, int(types[to].elem))
            wrap_conv(n, .opt, to)
            return n
        if tk == .var:
            d = lit_default(n)
            # Defaulting must construct the value too: an exact decimal's
            # rational representation is not its parsed floating-point bits.
            coerce(n, d)
            unify(to, d)
            return n
        if tk == .vec and nodes[n].kind == .int_lit or tk == .vec and nodes[n].kind == .float_lit: pass
    if type_eq(from, to):
        clear_flag(n, NF_LITERAL)
        return n
    fk = types[from].kind
    # (the same storage read at the looser type: no conversion node, so copies, moves and
    # facts see the value itself)
    if (fk == .array or fk == .fixed) and fk == tk and array_elems_subsume(from, to):
        nodes[n].type = i32(to)
        return n
    if refine_active and fk == .struct_ and tk == .struct_ and ref_record_conversion(from, to): return ref_convert_record(n, to)
    if fk == .struct_ and tk == .struct_ and record_int_conversion(from, to): return ref_convert_record(n, to)
    # (an intersection's value where one of its operand records is wanted: those fields)
    if fk == .struct_ and tk == .struct_ and intersection_parts.len() > 0 and intersection_within(from, to): return ref_convert_record(n, to)
    if fk == .array and is_soa(to) and can_coerce(0, int(types[from].elem), soa_elem(to)):
        soa_from_array(n, to)
        return n
    if fk == .fixed and tk == .array and elem_subsumes(int(types[from].elem), int(types[to].elem)):
        wrap_conv(n, .fixed2arr, to)
        return n
    if fk == .callable or tk == .callable:
        # (a spawn body is called once and released by its task, which so owns its captures)
        spawned = nodes[n].kind == .lambda and nodes[n].aux2 == 17
        if ownership_callable_cap(from) > ownership_callable_cap(to) and not spawned: fatal(nodes[n].pos, "callable conversion would erase capture ownership")
        fits = if spawned: mk_callable_contract(callable_base(from), callable_contract(from)) else: from
        if not callable_fits(fits, to): fatal(nodes[n].pos, "cannot prove callable effect contract")
        wrap_conv(n, .none_, to)
        return n
    if fk == .fn_ and tk == .fn_ and callable_fits(from, to):
        nodes[n].type = i32(to)
        return n
    if tk == .array and is_nd(from) and type_eq(nd_elem(from), int(types[to].elem)):
        # a 1-D T[,] where a T[] is expected: its elements (checked to be 1-D when it runs)
        inner = nodes.len()
        nodes.push(nodes[n])
        nodes[n] = nodes[bc_call("__nd_1d", [inner], nodes[n].pos)]
        check_expr(n, to)
        return n
    if fk == .array and tk == .fixed:
        if nodes[n].kind != .array and elem_subsumes(int(types[from].elem), int(types[to].elem)):
            wrap_conv(n, .arr2fixed, to)
            # Register the boundary, including deferred/opaque control paths.
            # Its operand's evaluated length is proved only by the facts pass.
            fact_fixed_requests.push(FactRequest(n, if cx >= 0: int(ctxs[cx].inst) else: 0))
            return n
        if not fixed_literal_ok(n, to):
            els = "{fixed_len(to)} elements"
            if fixed_len(to) == 1: els = "1 element"
            fatal(nodes[n].pos, "type mismatch: expected {dt_named(to)}, found {dt_named(from)} (a fixed-size array is made from a literal with {els})")
        fixed_literal(n, to)
        return n
    if tk == .enum_ and not is_union(from) and is_union(to):
        vi = union_target(n, from, to)
        if vi < 0: fatal(nodes[n].pos, "type mismatch: expected {dt_named(to)}, found {dt_named(from)}{duration_hint(n, from, to)}")
        coerce(n, union_members(to)[vi])
        wrap_union(n, vi, to)
        return n
    if is_union(from) and is_union(to) and union_within(from, to):
        wrap_conv(n, .union_, to)
        return n
    if has_var(from) or has_var(to):
        if unify(from, to): return n
        if tk == .opt and unify(from, int(types[to].elem)):
            wrap_conv(n, .opt, to)
            return n
    if fk == .int_ and tk == .int_:
        if from == T_MATH_INT or to == T_MATH_INT:
            check_integer_boundary(n, from, to)
            wrap_conv(n, .int_, to)
            if from == T_MATH_INT and dewy_at(nodes[n].pos): int_domain_conversion(n, to)
            return n
        if int_widens(from, to):
            wrap_conv(n, .int_, to)
            return n
        if dewy_at(nodes[n].pos):
            narrow_int(n, from, to)
            return n
        fatal(nodes[n].pos, "cannot implicitly convert {dt(from)} to {dt(to)} (use {dt(to)}(x) to convert explicitly)")
    if fk == .int_ and tk == .float_:
        if nodes[n].kind == .binary and nodes[n].op == i32(int(Tok.slash)):
            # (hits / shots * 100.0: the division drops the fraction before it becomes a float)
            a = int(nodes[n].a)
            an = "a"
            if nodes[a].kind == .ident: an = name_of(int(nodes[a].name))
            warn(nodes[n].pos, "this divides whole numbers, dropping the fraction (7 / 2 is 3) before it becomes a float: `f64({an}) / ...` keeps the fraction")
        wrap_conv(n, .int2float, to)
        return n
    if fk == .float_ and tk == .float_:
        wrap_conv(n, .float_, to)
        return n
    if tk == .opt:
        if fk == .none_lit:
            nodes[n].type = i32(to)
            return n
        # T may itself be optional: wrapping it must preserve a present none.
        # A bare none above still means the outer optional is absent.
        if type_eq(from, int(types[to].elem)):
            wrap_conv(n, .opt, to)
            return n
        if fk == .opt:
            if tkind(int(types[from].elem)) == .var:
                unify(int(types[from].elem), int(types[to].elem))
                nodes[n].type = i32(to)
                return n
            if can_coerce(0, telem(from), telem(to)):
                source = nodes.len()
                nodes.push(nodes[n])
                add_flag(source, NF_CHECKED)
                pos = nodes[n].pos
                name = "$optional{n}"
                yes = bc_block([bc_stmt(bc_ident(name, pos), pos)], pos)
                no = bc_block([bc_stmt(mk(.none_lit, pos), pos)], pos)
                nodes[n] = Node(kind = .iflet, pos = pos, a = i32(source), b = i32(yes), c = i32(no), name = i32(intern(name)))
                check_expr(n, to)
                return n
            fatal(nodes[n].pos, "type mismatch: expected {dt_named(to)}, found {dt_named(from)}")

        coerce(n, int(types[to].elem))
        wrap_conv(n, .opt, to)
        return n
    if fk == .null_ and (tk == .ptr or tk == .cfn):
        nodes[n].type = i32(to)
        return n
    if fk == .ptr and tk == .ptr and (to == T_RAWPTR or from == T_RAWPTR):
        wrap_conv(n, .ptr, to)
        return n
    # (a type member's value, `[Png = Png]`, where that member's type is expected)
    if fk == .typeval and tk == .typeval and type_eq(prune(telem(from)), prune(telem(to))):
        nodes[n].type = i32(to)
        return n
    if fk == .typeval: fatal(nodes[n].pos, "expected a value of type {dt(to)}, found a type name")
    why = variant_hint(n, to)
    # (`let d:Duration = q`, q a time known at run time or a float: only a constant is known to fit)
    if fk == .quantity:
        hint = duration_hint(n, from, to)
        if hint != "": why = hint
    if fk == .opt and tk != .opt: why = if dewy_at(nodes[n].pos): optional_hint(n, from) else: " (this value may be none; narrow it before using its value)"
    # (shown += c with c from a loop over a string: a character's code)
    if len(why) == 0 and tkind(to) == .str_ and type_eq(prune(from), T_U8): why = " (a string's elements are character codes, numbers: `chr(c)` is the character as text)"
    if fk == .void_: why = void_rec_hint(n)
    if fk == .null_: why = " (`null` is for C's pointers; a value that may be missing is `none`)"
    if fk == .fn_ and tk == .fn_ and int(types[prune(from)].nargs) == int(types[prune(to)].nargs):
        # (which part differs: update = (dt: f32) where (dt: f64) is wanted)
        loop i in [0..int(types[prune(from)].nargs)):
            if not type_eq(targ(prune(from), i), targ(prune(to), i)):
                why = " (parameter {i + 1} is {dt(targ(prune(from), i))}, where {dt(targ(prune(to), i))} is wanted)"
                break
    dewy = dewy_at(nodes[n].pos)
    if fk == .opt and tk == .bool_: why = if dewy: " (an optional is not true or false: `x isnt? none` asks, and narrows x inside `if x isnt? none \{ }`)" else: " (an optional is not true or false: `if let v = x:` runs when there is a value and names it, `x != none` asks)"
    if fk == .float_ and tk == .int_: why = if dewy: " (int64(x) makes it a whole number, dropping the fraction)" else: " (int(x) makes it a whole number, dropping the fraction)"
    if tk == .int_ and (fk == .float_ or bundled_rational_type(from)) and int_update_lhs != 0 and nodes[n].pos == int_update_pos: var_type_error(int_update_lhs, to, from, int_update_pos)
    if dewy and tk == .int_ and bundled_rational_type(from): why = " (`/` gives an exact fraction: `//` divides whole numbers, and `q.floor()` or `q.round()` gives a whole number)"
    if tk == .bool_ and (fk == .array or fk == .str_ or is_map_type(from)): why = if dewy: " (not true or false: `xs.length >? 0` asks if it has anything)" else: " (not true or false: `xs.len() > 0` asks if it has anything)"
    if tk == .bool_ and (fk == .int_ or fk == .float_): why = if dewy: " (a number is not true or false: `x not=? 0` asks)" else: " (a number is not true or false: `x != 0` asks)"
    if tk == .bool_ and fk == .int_ and nodes[n].kind == .int_lit: why = if dewy: " (to do something {nodes[n].ival} times: `loop i in [1..{nodes[n].ival}] \{ }`)" else: " (to do something {nodes[n].ival} times: `loop i in [1..{nodes[n].ival}]:`)"
    # (`words.is_empty` with words from read_line(): the exceptions forwarded through members)
    if dewy and len(why) == 0 and tk == .bool_ and is_union(from):
        failures: str[]
        rest = 0
        loop m in union_members(from):
            if exception_member(prune(m)): failures.push(dt(m))
            else if can_coerce(0, m, to): rest += 1
        if failures.len() > 0 and rest > 0: why = " (it may be {join(failures, " | ")}, carried along from where the value was made: handle that there, with `if x is? exception ...`, `or_throw` or `?? fallback`)"
    # (an array of looser refined elements where tighter ones are wanted: the values in between)
    if dewy and len(why) == 0: why = array_elems_gap_text(from, to)
    # (`out.push(ready)`, ready an `array<int64>` comprehension where an
    # `array<int>` is wanted: arrays never convert element by element)
    if dewy and len(why) == 0 and fk == .array and tk == .array:
        fe = telem(prune(from))
        te = telem(prune(to))
        loop tkind(fe) == .array and tkind(te) == .array:
            fe = telem(prune(fe)); te = telem(prune(te))
        if not type_eq(prune(fe), prune(te)) and can_coerce(0, fe, te):
            named = if nodes[n].kind == .ident: name_of(int(nodes[n].name)) else: "xs"
            why = " (an array's elements are not converted one by one: give it its type where it is made, `let {named}:{dt(to)} = ...`, so its elements are {dt(te)} from the start)"
    # (a parameter named like a function, as that function's default: the name is the parameter's)
    if dewy and len(why) == 0 and tk == .fn_ and fk != .fn_ and nodes[n].kind == .ident:
        shadowed: int[]
        collect_fns(int(nodes[n].name), &shadowed)
        if len(shadowed) > 0:
            held = name_of(int(nodes[n].name))
            why = " (`{held}` names a {dt(from)} here, not the function `{held}`: give that {dt(from)} another name to reach the function)"
    # (`[1 2 ; 3 4]` where one row is wanted: a row break makes the literal 2-D)
    if dewy and tk == .array and is_nd(from) and pos_off(nodes[n].pos) < len(files[pos_file(nodes[n].pos)].src) and files[pos_file(nodes[n].pos)].src[pos_off(nodes[n].pos)] == '[': why = " (this literal has rows, so it is 2-D: for one row, leave out the row breaks, and end a line with `\\` to continue the row on the next line)"
    regroup_note(n)
    fatal(nodes[n].pos, "type mismatch: expected {dt_named(to)}, found {dt_named(from)}{why}{coerce_hint}")
    n

# make array literal n (already checked as T[]) the fixed-size array type `to`
fixed_literal = (n: int, to: int):
    et = int(types[prune(to)].elem)
    if nkids(n) == 0 and fixed_len(to) > 0: concurrency_require_zero(n, et)
    if refine_active and nkids(n) == 0 and fixed_len(to) > 0 and ref_storage_contract(et):
        value = struct_default(et, nodes[n].pos)
        if value != 0:
            set_list(n, [value])
            nodes[n].b = i32(bc_int(fixed_len(to), nodes[n].pos))
            nodes[int(nodes[n].b)].type = i32(T_INT)
    if nodes[n].b != 0:
        c = int(nodes[n].b)
        # (a module const's count, `fill(1 N)` with `const N = NAMES.length`: its value)
        root = c
        loop nodes[root].kind == .conv: root = int(nodes[root].a)
        if nodes[root].kind == .ident and dewy_at(nodes[n].pos) and (nodes[root].aux == i32(int(SK.global)) and readonly_global(int(nodes[root].sym)) or nodes[root].aux == i32(int(SK.const_))):
            if ceval(root).i == fixed_len(to):
                nodes[n].b = i32(bc_int(fixed_len(to), nodes[n].pos))
                c = int(nodes[n].b)
                nodes[c].type = i32(T_INT)
        if nodes[c].kind != .int_lit or nodes[c].ival != fixed_len(to): fatal(nodes[n].pos, "a fixed-size array of {fixed_len(to)} elements needs the count {fixed_len(to)} here")
        coerce(kid(n, 0), et)
    else:
        loop i in [0..nkids(n)): coerce(kid(n, i), et)
    nodes[n].type = i32(to)
    clear_flag(n, NF_LITERAL)

check_to = (n: int, target: int) -> int:
    check_expr(n, target)
    coerce(n, target)
    target

finalize_literal = (n: int) -> int:
    if is_lit(n): coerce(n, lit_default(n))
    ntype(n)

num_join = (a0: int, b0: int) -> int:
    a = prune(a0)
    b = prune(b0)
    if type_eq(a, b): return a
    ka = types[a].kind
    kb = types[b].kind
    if ka == .float_ and kb == .float_:
        if int(types[a].bits) >= int(types[b].bits): return a
        return b
    if ka == .float_ and kb == .int_: return a
    if kb == .float_ and ka == .int_: return b
    if ka == .int_ and kb == .int_:
        if a == T_MATH_INT or b == T_MATH_INT: return T_MATH_INT
        # (one width and sign: a policy on either side decides; two different ones have no join)
        if int_policy(a) != int_policy(b) and types[a].bits == types[b].bits and types[a].sign == types[b].sign:
            if int_policy(b) == 0: return a
            if int_policy(a) == 0: return b
            return 0
        if int_widens(a, b): return b
        if int_widens(b, a): return a
    0

join_types = (a: int, b: int, pos: int) -> int:
    ta = prune(ntype(a))
    tb = prune(ntype(b))
    if ta == T_NEVER: return finalize_literal(b)
    if tb == T_NEVER: return finalize_literal(a)
    la = is_lit(a)
    lb = is_lit(b)
    # (two values of one number type, neither a literal: nothing to convert)
    if ta == tb and not la and not lb and is_numeric(ta) and nodes[a].kind != .str_lit and nodes[b].kind != .str_lit: return ta
    if la and not lb and can_coerce(a, ta, tb):
        coerce(a, tb)
        return tb
    if lb and not la and can_coerce(b, tb, ta):
        coerce(b, ta)
        return ta
    if la and lb:
        t = lit_default(a)
        if nodes[a].kind == .float_lit: t = lit_default(a)
        else if nodes[b].kind == .float_lit: t = lit_default(b)
        coerce(a, t)
        coerce(b, t)
        return t
    if is_numeric(ta) and is_numeric(tb):
        j = num_join(ta, tb)
        if j == 0: fatal(pos, "cannot mix {dt(ta)} and {dt(tb)}; convert one explicitly")
        coerce(a, j)
        coerce(b, j)
        return j
    if types[ta].kind == .none_lit or (types[ta].kind == .opt and tkind(int(types[ta].elem)) == .var):
        t = tb
        if types[tb].kind != .opt: t = mk_opt(tb)
        coerce(a, t)
        coerce(b, t)
        return t
    if types[tb].kind == .none_lit or (types[tb].kind == .opt and tkind(int(types[tb].elem)) == .var):
        t = ta
        if types[ta].kind != .opt: t = mk_opt(ta)
        coerce(a, t)
        coerce(b, t)
        return t
    if types[ta].kind == .opt and can_coerce(b, tb, ta):
        coerce(b, ta)
        return ta
    if types[tb].kind == .opt and can_coerce(a, ta, tb):
        coerce(a, tb)
        return tb
    # (handles of two functions with defaults: the joined value keeps neither's)
    if types[ta].kind == .fn_ and types[tb].kind == .fn_ and types[ta].bits != types[tb].bits:
        t = fn_without_defaults(ta)
        coerce(a, t)
        coerce(b, t)
        return t
    # (branches failing in different ways: `int | Bad` and `int | Worse` give `int | Bad | Worse`)
    if not type_eq(ta, tb) and not can_coerce(b, tb, ta) and files[pos_file(nodes[a].pos)].is_dewy:
        if can_coerce(a, ta, tb):
            coerce(a, tb)
            return tb
        t = exception_join(ta, tb)
        # Distinct anonymous shapes are distinct union members. Compatible
        # numeric fields still use the ordinary structural conversion above.
        if types[ta].kind == .struct_ and types[tb].kind == .struct_ and structs[int(types[ta].st)].record_ and structs[int(types[tb].st)].record_: t = mk_union([ta, tb])
        if t != 0:
            coerce(a, t)
            coerce(b, t)
            return t
    coerce(b, ta)
    ta

# ---------------- places ----------------
cp_inner = 0           # > 0 while checking the base of an element or field being written

# m[k] for a map m (a call of its `[]`)
is_map_get = (n: int) -> bool:
    if nodes[n].kind != .call or nodes[n].aux != 0 or nkids(n) != 2 or nodes[n].sym == 0: return false
    d = int(fns[int(nodes[n].sym)].decl)
    if d == 0 or name_of(int(nodes[d].name)) != "[]" or not decl_in_prelude(d): return false
    mt = prune(ntype(kid(n, 0)))
    types[mt].kind == .struct_ and structs[int(types[mt].st)].name == "Map"

# a copy of a place expression (variables, fields, elements) to evaluate it again
copy_place = (n: int) -> int:
    c = nodes.len()
    nodes.push(nodes[n])
    k = nodes[n].kind
    if k == .field or k == .index: nodes[c].a = i32(copy_place(int(nodes[n].a)))
    else if k == .call and nkids(n) > 0: set_list(c, [copy_place(kid(n, 0))] + kids(n)[1..])
    c

# m[k] changed in place (m[k] += 1, m[k].push(x), m[k].x = 5, loop mut x in m[k]): the value
# stored in m, m.vals[__map_entry_present(m, k)] in Dewy (a missing key fails)
map_elem_place = (n: int):
    pos = nodes[n].pos
    m = kid(n, 0)
    key = kid(n, 1)
    mt = prune(ntype(m))
    vt = struct_targ(int(types[mt].st), 1)
    mc = copy_place(m)
    add_flag(mc, NF_MUT)
    args = [mc, key]
    pv = prune(vt)
    # (Dewy: the key must be there, as for reading m[k]; nothing is invented for a missing one)
    present = files[pos_file(pos)].is_dewy
    if present: pass
    else if types[pv].kind == .struct_ and not is_map_type(pv):
        # (a struct with default field values starts with them)
        si = int(types[pv].st)
        check_struct_fields(si)
        has_def = false
        loop i in [0..int(structs[si].nfields)):
            if fields[int(structs[si].fields) + i].defval != 0: has_def = true
        if has_def:
            d = mk(.call, pos)
            struct_ctor_zero(d, pv, int(structs[si].decl))
            add_flag(d, NF_CHECKED)
            args.push(d)
    entry = "__map_entry"
    if present: entry = "__map_entry_present"
    call = bc_call(entry, args, pos)
    check_expr(call, 0)
    call = last_checked
    f = mk(.field, pos)
    nodes[f].a = i32(m)
    nodes[f].name = i32(intern("vals"))
    check_expr(f, 0)
    f = last_checked
    # (a refined value reads as its base, as an array element does; stores into it are checked)
    rt = if refine_active: representation_type(vt) else: vt
    nodes[n] = Node(kind = .index, pos = pos, a = i32(f), b = i32(call), type = i32(rt), flags = i32(NF_CHECKED | NF_INBOUNDS))

# The generated entry-position selector of a dictionary place, not a user's
# array index. Its key can survive a call; its position cannot.
map_place_index = (n: int) -> bool:
    if nodes[n].kind != .index or not has_flag(n, NF_INBOUNDS): return false
    call = int(nodes[n].b)
    if nodes[call].kind != .call or nodes[call].aux != 0 or nodes[call].sym <= 0 or nkids(call) != 2: return false
    d = int(fns[int(nodes[call].sym)].decl)
    d != 0 and decl_in_prelude(d) and name_of(int(nodes[d].name)) == "__map_entry_present"

is_map_entries_type = (t: int) -> bool:
    p = prune(t)
    if types[p].kind != .struct_: return false
    st = int(types[p].st)
    if structs[st].name != "__MapEntries": return false
    d = int(structs[st].decl)
    d != 0 and files[pos_file(nodes[d].pos)].path == lib_dir + "/core/map.jo"

# The method whose object is being checked as a place, for its diagnostics.
place_method = 0

place_write_pos = 0 # the written name, when a narrowed alias is resolved to its variable

check_place = (n: int, for_mut: bool):
    if is_map_get(n): map_elem_place(n)
    k = nodes[n].kind
    if k == .ident:
        if nodes[n].aux == i32(int(SK.local)):
            l = int(nodes[n].sym)
            f = int(locals[l].flags)
            nm = name_of(int(locals[l].name))
            if f & LF_ALIAS != 0 and locals[l].alias != 0 and narrowed_var(l) == 0:
                alias = int(locals[l].alias)
                if nodes[alias].kind == .unwrap or nodes[alias].kind == .narrow:
                    # A narrowed field path still writes its owning binding.
                    # In particular, a private capture's environment must be
                    # copied when mutation goes through an optional child.
                    locals[l].flags |= i32(LF_ASSIGNED)
                    saved = place_write_pos
                    if saved == 0: place_write_pos = nodes[n].pos
                    check_place(alias, for_mut)
                    place_write_pos = saved
                    return
            if f & LF_SOAELEM != 0: fatal(nodes[n].pos, "'{nm}' stands for an element of a soa array: assign it a whole value (in `loop mut`) or change its fields")
            # a closure modifying a variable it captured modifies the variable itself
            # (and a narrowed name stands for its variable, which a closure may have captured)
            r = l
            via_closure = false
            loop true:
                if int(locals[r].flags) & LF_CAPTURE != 0 and int(locals[r].flags) & LF_VALUECAP == 0:
                    r = int(locals[r].outer)
                    via_closure = true
                else if narrowed_var(r) != 0: r = narrowed_var(r)
                else: break
            rf = int(locals[r].flags)
            if (rf & LF_BYREF != 0 or loop_copy_writes.len() > 0 and loop_copy_writes.has(r)) and dewy_at(nodes[n].pos):
                # (`loop x in xs`: x is the loop's own copy, which this write makes real)
                loop_copy_write(r, nodes[n].pos, via_closure, for_mut)
                rf = int(locals[r].flags)
                if r == l: f = rf
            if rf & LF_CONST != 0: place_fatal(nodes[n].pos, "cannot modify const '{nm}'; copy it with `let {nm} = {nm}`")
            if rf & (LF_CAPTURE | LF_VALUECAP) == LF_CAPTURE | LF_VALUECAP and implicit_capture(r): implicit_capture_write(r, if place_write_pos != 0: place_write_pos else: nodes[n].pos)
            ag = alias_global(r)
            if ag >= 0 and readonly_global(ag): place_fatal(nodes[n].pos, "cannot modify const '{nm}'")
            if rf & LF_PARAM != 0 and rf & LF_MUTPARAM == 0 and not consumed_receiver(r): place_fatal(nodes[n].pos, "cannot modify parameter '{nm}' (parameters are read-only; {jd(nodes[n].pos, "mark it `mut`", "take it by place, `@{nm}`,")} or copy it with `let {nm} = {nm}`)")
            if rf & LF_BYREF != 0 and via_closure: fatal(nodes[n].pos, "cannot modify loop variable '{nm}', a copy of an element, and the function changing it runs later: change the element by its position, `loop i in 0.. and {nm} in xs:` and then `(): xs[i]...` in the function")
            if rf & LF_BYREF != 0: place_fatal(nodes[n].pos, "cannot modify loop variable '{nm}' (use `{mutable_loop_syntax(nodes[n].pos)}` to modify elements)")
            nf = f | LF_ASSIGNED
            if cp_inner == 0: nf |= LF_RESIZED
            if for_mut and f & LF_CAPTURE == 0: nf |= LF_ADDR
            locals[l].flags = i32(nf)
            if r != l:
                rf |= LF_ASSIGNED
                if cp_inner == 0: rf |= LF_RESIZED
                locals[r].flags = i32(rf)
            if const_views.len() > 0: const_view_write(r, nodes[n].pos)
            if for_mut and string_domains.len() > 0 and ntype(n) == T_STR: string_domain_write(n, 0)
            if for_mut and ntype(n) == T_MATH_INT: int_domain_write(n, 0, -1)
            note_write(r, via_closure, nodes[n].pos)
            if sibling_known.len() > 0: sibling_forget(r)
            if ag >= 0: note_global_write(ag)
            return
        if nodes[n].aux == i32(int(SK.global)):
            if readonly_global(int(nodes[n].sym)): place_fatal(nodes[n].pos, "cannot modify const '{name_of(int(nodes[n].name))}'")
            if for_mut and string_domains.len() > 0 and ntype(n) == T_STR: string_domain_write(n, 0)
            if for_mut and ntype(n) == T_MATH_INT: int_domain_write(n, 0, -1)
            if for_mut and not is_map_type(ntype(n)): globals[int(nodes[n].sym)].exposed = true
            note_global_write(int(nodes[n].sym))
            return
        fatal(nodes[n].pos, "cannot assign to '{name_of(int(nodes[n].name))}'")
    if k == .field:
        bt = prune(ntype(int(nodes[n].a)))
        if types[bt].kind == .ptr: return
        if nodes[n].aux == -4:
            s = name_of(int(nodes[n].name))
            loop i in [0..len(s)):
                loop j in [0..i):
                    if s[i] == s[j]: fatal(nodes[n].pos, "cannot assign to '.{s}': it names a component twice")
            if for_mut and not swizzle_run(n): fatal(nodes[n].pos, "'.{s}' is not a run of components in order (as .xy or .yzw are), so it cannot be passed as {jd(nodes[n].pos, "a `mut`", "an `@`")} argument")
        cp_inner += 1
        check_place(int(nodes[n].a), for_mut)
        cp_inner -= 1
        return
    if k == .index:
        if has_flag(n, NF_RDONLY): fatal(nodes[n].pos, "cannot modify loop variable '{name_of(int(nodes[n].name))}' (use `{mutable_loop_syntax(nodes[n].pos)}`)")
        bt = prune(ntype(int(nodes[n].a)))
        bk = types[bt].kind
        if bk == .ptr: return
        if bk == .str_: fatal(nodes[n].pos, "a string's characters cannot be changed in place: make a new string, `s = s[..i) + \"x\" + s[i + 1..]`, or change `cs = chars(s)` and `join(cs)` it back")
        if bk == .fixed and nodes[n].aux == 1: fatal(nodes[n].pos, "a fixed-array slice is a copy; pass the whole array as a mutable argument")
        cp_inner += 1
        if bk == .vec or bk == .fixed:
            check_place(int(nodes[n].a), for_mut)
            cp_inner -= 1
            return
        if bk != .array: fatal(nodes[n].pos, "cannot assign to this index expression")
        if nodes[n].aux == 1 and not for_mut: fatal(nodes[n].pos, "cannot assign to a slice")
        check_place(int(nodes[n].a), for_mut)
        cp_inner -= 1
        return
    if k == .unwrap or k == .narrow:
        # (x!.hp = 7: the value inside the optional or union, in place)
        cp_inner += 1
        check_place(int(nodes[n].a), for_mut)
        cp_inner -= 1
        return
    if for_mut and place_method != 0: fatal(nodes[n].pos, "'{name_of(place_method)}' changes its object, so it is called on a variable or a field, not on a temporary value")
    if for_mut: fatal(nodes[n].pos, "{jd(nodes[n].pos, "a `mut`", "an `@`")} argument must be a variable, field or element")
    # (w.pos(b).y = 3: a value a function gave back, changed where nothing keeps it)
    if k == .call:
        fnm = ""
        fm = -1
        cal = int(nodes[n].a)
        if cal != 0 and (nodes[cal].kind == .ident or nodes[cal].kind == .field): fnm = name_of(int(nodes[cal].name))
        if nodes[n].sym > 0 and int(nodes[n].sym) < fns.len() and fns[int(nodes[n].sym)].decl != 0:
            fd = int(fns[int(nodes[n].sym)].decl)
            fnm = name_of(int(nodes[fd].name))
            fm = int(nodes[fd].mod)
        if dewy_at(nodes[n].pos) and fnm == "__dewy_string_index": fatal(nodes[n].pos, "a string cannot be changed in place: make a new one")
        if dewy_at(nodes[n].pos) and starts_with(fnm, "__"): fatal(nodes[n].pos, "this is a copy, so changing it changes nothing")
        # (`pool[h].items.push(x)`: a container's `[]` gives its entry back as a value)
        if dewy_at(nodes[n].pos) and fnm == "[]":
            shown = ""
            if nkids(n) == 2:
                parts = [kid(n, 0), kid(n, 1)]
                loop i in [0..2):
                    loop parts[i] > 0 and (nodes[parts[i]].kind == .addr or nodes[parts[i]].kind == .narrow or nodes[parts[i]].kind == .conv): parts[i] = int(nodes[parts[i]].a)
                if nodes[parts[0]].kind == .ident and nodes[parts[1]].kind == .ident and nodes[parts[0]].name != 0 and nodes[parts[1]].name != 0:
                    container = name_of(int(nodes[parts[0]].name))
                    key = name_of(int(nodes[parts[1]].name))
                    if not starts_with(container, "$") and not starts_with(container, "__") and not starts_with(key, "$") and not starts_with(key, "__"): shown = "{container}[{key}]"
            entry = "this entry"
            place = "pool[h]"
            if shown != "":
                entry = "`{shown}`"
                place = shown
            fatal(nodes[n].pos, "{entry} is a copy of the entry, so changing it changes nothing: copy it out, change the copy and store it back (`let e = {place}` ... `{place} = e`)")
        if len(fnm) > 0:
            setter = ""
            if lookup(intern("set_{fnm}")) != 0 or (fm >= 0 and modules[fm].names.get(intern("set_{fnm}")) != none): setter = ": `set_{fnm}(...)` changes it"
            fatal(nodes[n].pos, "this is a copy that {fnm}(...) gave back, so changing it changes nothing{setter}")
    # (const gens = [1, 2], then gens.push(3): a const is its value, written where it is used)
    if k == .array or k == .int_lit or k == .float_lit or k == .str_lit or k == .map_lit or (k == .ident and nodes[n].aux == i32(int(SK.const_))):
        fatal(nodes[n].pos, "this is a const, which never changes: made without `const`, it is a variable, which can")
    fatal(nodes[n].pos, "cannot assign to this expression")

# Raw addresses can write without a checked assignment. Keep their
# owning bindings out of read-only view optimizations, and make copied private
# closure environments independent even when their only write is through a pointer.
note_storage_access = (n: int):
    if string_domains.len() > 0 and ntype(n) == T_STR: string_domain_write(n, 0)
    if ntype(n) == T_MATH_INT: int_domain_write(n, 0, -1)
    k = nodes[n].kind
    if k == .field or k == .index or k == .unwrap or k == .narrow:
        note_storage_access(int(nodes[n].a))
    else if k == .ident and nodes[n].aux == i32(int(SK.global)):
        globals[int(nodes[n].sym)].exposed = true
    else if k == .ident and nodes[n].aux == i32(int(SK.local)):
        l = int(nodes[n].sym)
        locals[l].flags |= i32(LF_EXPOSED)
        if int(locals[l].flags) & LF_ALIAS != 0 and locals[l].alias != 0:
            note_storage_access(int(locals[l].alias))

# ---------------- type expressions written as expressions ----------------
expr_as_type = (e: int) -> int:
    k = nodes[e].kind
    if k == .field and reflect_active and reflect_member(e): return telem(ntype(e))
    if k == .ident:
        tn = mk(.tname, nodes[e].pos)
        nodes[tn].name = nodes[e].name
        return resolve_type(tn)
    if k == .index and nodes[int(nodes[e].a)].kind == .ident:
        s = lookup(int(nodes[int(nodes[e].a)].name))
        if s == 0 or (syms[s].kind != .struct_ and syms[s].kind != .enum_): fatal(nodes[e].pos, "expected a type")
        targs: int[]
        if nodes[e].b != 0: targs.push(expr_as_type(int(nodes[e].b)))
        else:
            loop i in [0..nkids(e)): targs.push(expr_as_type(kid(e, i)))
        d = int(syms[s].ref)
        if targs.len() != nkids2(d): fatal(nodes[e].pos, "wrong number of type arguments")
        return get_struct_inst(d, targs)
    if k == .array and nkids(e) == 1: return mk_array(expr_as_type(kid(e, 0)))
    # ({str: P}: a map type, written where an expression is parsed, as from_json[{str: P}])
    if k == .map_lit and nkids(e) == 1:
        pr = kid(e, 0)
        s = prelude.get(intern("Map")) ?? 0
        if s != 0: return get_struct_inst(int(syms[s].ref), [expr_as_type(int(nodes[pr].a)), expr_as_type(int(nodes[pr].b))])
    fatal(nodes[e].pos, "expected a type")
    0

# ---------------- calls ----------------
# a candidate turned down at an argument, its message made only if no candidate fits: of
# argument fi (from 0), a, whose parameter's type there is ptx (d negative: a mutable
# parameter's, needing an exact match)
struct Rejection:
    d: int
    fi: int
    a: int
    ptx: int
    cd: Cand

# the enum `.name` means where a value of type t is expected: t itself, or (t a union) the one
# member enum with that variant
variant_enum = (t0: int, name: int) -> int:
    t = prune(t0)
    if not is_union(t): return t
    found = 0
    loop m in union_members(t):
        pm = prune(m)
        if types[pm].kind == .enum_ and not is_union(pm) and find_variant(int(types[pm].st), name) >= 0:
            if found != 0: return t
            found = pm
    if found == 0: return t
    found

unnamed = (a: int) -> int:
    if nodes[a].kind == .namedarg: return int(nodes[a].a)
    a

# how many of a candidate's arguments (not literals) have exactly their parameter's type
exact_args = (cd: Cand) -> int:
    k = 0
    loop i in 0.. and a in cd.args:
        if i >= cd.sig.params.len(): break
        if a == 0 or is_lit(a) or nodes[a].type == 0: continue
        if type_eq(prune(ntype(a)), prune(subst(cd.sig.params[i], cd.binds))): k += 1
    k

# (`let s:set<Op> = set(['push'])`, `let x:Box<Op> = box('push')`: a type parameter bound only by arguments that take their
# type from where they go, as the text in an array literal, takes what the expected result
# gives it, as such a literal written there would; only where the call as bound would not
# give the expected type, so a call that fits keeps its types)
expected_binds = (cd: mut Cand, expected: int, given: int[]):
    held = cd.binds
    # (a match can rest on a literal's own type coercing inside a container, `Box<string>` for
    # `Box<Choice>`: such a result still would not fit, so the literal takes the expected one)
    if match_type(int(cd.sig.ret), expected, held, 0) >= 0:
        fitted = subst_partial(int(cd.sig.ret), held)
        if has_var(fitted) or can_coerce(0, fitted, expected):
            loop i in 0.. and b in held:
                if cd.binds[i] == 0 and expected_bind_fits(b): cd.binds[i] = b
            return
    ret = subst_partial(int(cd.sig.ret), cd.binds)
    if not has_var(ret) and can_coerce(0, ret, expected): return
    eb = fill(0, int(cd.sig.ntp))
    loop i in 0.. and t in given: eb[i] = t
    loop i in 0.. and a in cd.args:
        if a == 0 or is_lit(a) or ctx_dependent(a) or nodes[a].type == 0 or text_literal(a): continue
        if match_type(cd.sig.params[i], ntype(a), eb, 0) < 0: return
    if match_type(int(cd.sig.ret), expected, eb, 0) < 0: return
    loop i in 0.. and b in eb:
        if expected_bind_fits(b): cd.binds[i] = b

# Does the unchecked call a take its type from the parameter it meets, as a literal does
# (node_store.dewy)? 1: the name's one function has a type parameter no parameter mentions
# (`text=<A>(s:string):>Node<A>`); 2: a bare literal alone gives one, and a is an element of an
# array literal argument. An array literal argument marks those elements and answers 0.
# O(parameters) once per name, then skipped (call_waits_never) when the answer was no.
call_waits = (a: int) -> int:
    if nodes[a].kind == .array:
        loop i in [0..nkids(a)):
            e = kid(a, i)
            if nodes[e].kind == .call and nodes[e].type == 0 and nodes[int(nodes[e].a)].kind == .ident and not call_waits_skips(int(nodes[int(nodes[e].a)].name)) and literal_typed_call(e):
                literal_typed_elements[e] = true
                literal_typed_names[int(nodes[int(nodes[e].a)].name)] = true
                if int(nodes[int(nodes[e].a)].name) < call_waits_never.len(): call_waits_never[int(nodes[int(nodes[e].a)].name)] = false
        return 0
    if nodes[a].kind != .call or nodes[a].type != 0 or nodes[int(nodes[a].a)].kind != .ident: return 0
    if literal_typed_elements.has(a): return 2
    name = int(nodes[int(nodes[a].a)].name)
    s = lookup(name)
    if s != 0 and syms[s].kind == .local: return 0
    if s == 0 or syms[s].kind != .fns or syms[s].decl == 0 or nodes[int(syms[s].decl)].nlist2 == 0:
        call_waits_mark(name)
        return 0
    found = false
    d = call_waits_decl(name)
    if d != 0:
        sig = fn_sig(d)
        if sig.ret != 0:
            loop id in [0..int(nodes[d].nlist2)):
                binds = call_waits_binds(int(sig.ntp), id)
                mentioned = false
                loop p in sig.params:
                    if subst_partial(p, binds) != p: mentioned = true
                if not mentioned and subst_partial(int(sig.ret), binds) != int(sig.ret): found = true
    # (a generic function of the same name in another module may be missed: its call then says
    # `cannot infer`, not wrong code)
    if not found: call_waits_mark(name)
    if found: 1 else: 0

literal_typed_names: {int: bool} = {}
literal_typed_elements: {int: bool} = {}

# (the name's one generic function, or 0)
call_waits_decl = (name: int) -> int:
    own: int[]
    collect_fns(name, &own)
    if own.len() != 1 or nodes[own[0]].nlist2 == 0: return 0
    own[0]

literal_typed_call = (e: int) -> bool:
    if nodes[int(nodes[e].a)].kind != .ident: return false
    name = int(nodes[int(nodes[e].a)].name)
    if call_waits_local(name): return false
    s = lookup(name)
    if s == 0 or syms[s].kind != .fns or syms[s].decl == 0 or nodes[int(syms[s].decl)].nlist2 == 0:
        call_waits_mark(name)
        return false
    d = call_waits_decl(name)
    if d == 0:
        call_waits_mark(name)
        return false
    sig = fn_sig(d)
    if nkids(e) > sig.params.len(): return false
    loop id in [0..int(nodes[d].nlist2)):
        literal = false
        other = false
        binds = call_waits_binds(int(sig.ntp), id)
        loop i in 0.. and p in sig.params:
            given = subst_partial(p, binds)
            if given == p: continue
            if i >= nkids(e) or given != T_INT or not (is_lit(kid(e, i)) or text_literal(kid(e, i))): other = true
            else: literal = true
        if literal and not other: return true
    false

# map call args to parameter slots; returns error message ("" on success)
# kinds: per parameter, 1 keyword-only (after `...`), 2 position-only (`<v:T>`), 3 rest
# (`...rest:T`: the positional arguments left, and spreads, gathered into an array literal made
# here, rest_bundle)
# explain: false gives "?" for any error, its message left unbuilt (overload resolution tries
# many and reports few: map_args_text builds the one reported)
map_args = (pnames: int[], has_default: bool[], args: int[], out: mut int[], kinds: int[] = [], explain: bool = true, decl: int = 0) -> str:
    np = pnames.len()
    out.clear()
    out.resize(np)
    rest = -1
    loop i in [0..kinds.len()):
        if kinds[i] == 3 and i < np: rest = i
    gathered: int[]
    pos = 0
    loop a in args:
        if nodes[a].kind == .namedarg:
            k = -1
            loop j in [0..np):
                if pnames[j] == int(nodes[a].name): k = j
            if k >= 0 and k < kinds.len() and kinds[k] == 2:
                if not explain: return "?"
                return "parameter '{name_of(pnames[k])}' is position-only: pass it without its name"
            if k >= 0 and k == rest:
                if not explain: return "?"
                return "parameter '{name_of(pnames[k])}' collects the positional arguments left: pass them without its name, or spread an array into it (`xs...`)"
            if k < 0:
                if not explain: return "?"
                an = name_of(int(nodes[a].name))
                if (an == "key" or an == "reverse") and not caller_dewy(): return "no parameter named '{an}' (by a key: `max_by(xs, (x): len(x))`, `min_by`, `sorted_by(xs, (x): x.age)`, `sort_by`; `descending = true` sorts largest first)"
                return "no parameter named '{an}'{suggestion(an, pnames)}"
            if out[k] != 0:
                if not explain: return "?"
                return "parameter '{name_of(int(nodes[a].name))}' given twice"
            out[k] = int(nodes[a].a)
        else:
            loop pos < np and out[pos] != 0: pos += 1
            if rest >= 0 and pos >= rest:
                gathered.push(a)
                continue
            if pos < np and pos < kinds.len() and kinds[pos] == 1:
                if not explain: return "?"
                return "too many positional arguments: '{name_of(pnames[pos])}' takes its name (`{name_of(pnames[pos])}=...`)"
            if pos >= np:
                if not explain: return "?"
                return "too many arguments (expected {np})"
            if has_flag(a, NF_SPREAD):
                if not explain: return "?"
                return "an array of unknown length spreads only into a rest parameter"
            out[pos] = a
            pos += 1
    if rest >= 0: out[rest] = rest_bundle(gathered, decl, rest)
    loop i in [0..np):
        if out[i] == 0 and not has_default[i]:
            if not explain: return "?"
            return "missing argument '{name_of(pnames[i])}'"
    ""

# The type arguments of a call's instance: a function with a rest parameter adds the type its
# rest argument has (rest_bundle), a fixed array when its length is written (no spread). Each
# count then has its own instance, whose indexing that length proves, and the arguments are
# passed in place, off the heap. The rest parameter is marked NF_SPREAD for the instance
# (checker_instances: its parameter type is this extra argument).
rest_inst_binds = (decl: int, args: int[], params: int[], binds: int[]) -> int[]:
    if rest_bundles.len() == 0: return binds
    kinds = dewy_param_kinds.get(decl) ?? []
    if kinds.len() == 0: return binds
    loop i in [0..kinds.len()):
        if kinds[i] != 3 or i >= args.len() or i >= params.len(): continue
        b = args[i]
        if b == 0 or not rest_bundles.has(b): return binds
        add_flag(kid(decl, i), NF_SPREAD)
        t = prune(subst(params[i], binds))
        if tkind(t) != .array: return binds
        k = rest_bundles[b]
        if k <= 0: return binds + [t]
        return binds + [mk_fixed(telem(t), k)]
    binds

# Keep parameter slots canonical for types/ABI, but evaluate explicitly supplied
# Dewy arguments in source order, then omitted defaults in parameter order.
# c holds a list of integer-literal slot numbers only when reordering is needed.
# checker_call_queries.dewy's save_call_order leaves the host the calls whose arguments
# are not written in parameter order.
call_order_rest = (n: int, given: int[], final: int[]):
    if not files[pos_file(nodes[n].pos)].is_dewy: return
    # Most calls already have their written arguments in parameter order.
    # Omitted trailing defaults follow them without any ordering metadata.
    ordered = given.len() <= final.len()
    if ordered:
        loop i in [0..given.len()):
            if unnamed(given[i]) != final[i]:
                ordered = false
                break
    if ordered: return
    order: int[]
    loop a in given:
        value = unnamed(a)
        loop i in 0.. and f in final:
            if f == value: order.push(i)
    loop i in [0..final.len()):
        if not order.contains(i): order.push(i)
    changed = false
    loop i in 0.. and slot in order:
        if i != slot: changed = true
    if not changed: return
    entries: int[]
    loop slot in order:
        e = mk(.int_lit, nodes[n].pos)
        nodes[e].ival = slot
        nodes[e].type = i32(T_INT)
        add_flag(e, NF_CHECKED)
        entries.push(e)
    metadata = mk(.array, nodes[n].pos)
    set_list(metadata, entries)
    nodes[n].c = i32(metadata)

match_type = (pat0: int, a0: int, binds: mut int[], depth: int) -> int: tm_match(pat0, a0, binds, depth)

find_variant = (si: int, name: int) -> int:
    check_struct_fields(si)
    loop v in [0..int(structs[si].nvariants)):
        if int(variants[int(structs[si].variants) + v].name) == name: return v
    -1

# Recognize scalar arithmetic without checking or folding it before context is
# known. This also lets numeric branches rule out nonnumeric overloads.
branch_numeric = (a: int, hidden: int[]) -> bool:
    k = nodes[a].kind
    if k == .int_lit or k == .float_lit: return true
    if k == .ident and not (int(nodes[a].name) in hidden):
        sym = lookup(int(nodes[a].name))
        if sym != 0 and syms[sym].kind == .local: return is_numeric(int(locals[int(syms[sym].ref)].type))
        if sym != 0 and syms[sym].kind == .global and globals[int(syms[sym].ref)].type != 0: return is_numeric(int(globals[int(syms[sym].ref)].type))
    if k == .unary: return branch_numeric(int(nodes[a].a), hidden)
    if k == .binary:
        op = nodes[a].op as Tok
        if op != .plus and op != .minus and op != .star and op != .slash and op != .percent: return false
        return branch_numeric(int(nodes[a].a), hidden) and branch_numeric(int(nodes[a].b), hidden)
    false

# Branch bodies must be checked in their own scopes, with the selected parameter
# type. Only score literal results here; bindings and statements wait until then.
call_string_cost = (a: int, p: int, sp: int, binds: mut int[]) -> int:
    let p = p
    if str_sets.len() > 1 and nodes[a].type != 0 and types[sp].kind == .str_ and str_set_of(ntype(a)) != 0: return 1
    if str_sets.len() > 1 and types[sp].kind == .opt and str_set_of(int(types[sp].elem)) != 0 and (nodes[a].kind == .str_lit or nodes[a].type != 0 and str_text_or_set(ntype(a))):
        # (a string for an optional string set: as for the set, then wrapped)
        r = arg_cost(a, int(types[sp].elem), binds)
        return if r < 0: -1 else: r + 2
    if str_sets.len() > 1 and str_set_of(sp) != 0 and (nodes[a].type != 0 or nodes[a].kind == .str_lit):
        # (a member literal fits a string set; another string carries a proof obligation)
        p = sp
        ps = str_set_of(p)
        if nodes[a].kind == .str_lit and nodes[a].aux != 1:
            if member_record >= 0: member_string_decision(a, ps)
            return if str_sets[ps].contains(name_of(int(nodes[a].sval))): 0 else: -1
        at = prune(ntype(a))
        if at == p: return 0
        if str_set_of(at) != 0: return if str_set_within(str_set_of(at), ps): 1 else if dewy_at(nodes[a].pos): 2 else: -1
        if at != T_STR: return -1
        e = kid_lit(a)
        if nodes[e].kind == .str_lit and nodes[e].aux != 1:
            if member_record >= 0: member_string_decision(e, ps)
            return if str_sets[ps].contains(name_of(int(nodes[e].sval))): 0 else: -1
        return 2
    -2

call_refined_literal_cost = (a: int, pat: int) -> int:
    # (a literal for a refined integer parameter, `d:0` or `d:int64 & ~0`: the overload
    # whose values hold it, ahead of a plain integer one)
    v = 0
    lit = true
    if nodes[a].kind == .int_lit and not has_flag(a, NF_U64): v = nodes[a].ival
    else if nodes[a].kind == .unary and nodes[a].op == i32(int(Tok.minus)) and nodes[int(nodes[a].a)].kind == .int_lit: v = -nodes[int(nodes[a].a)].ival
    else: lit = false
    known, intervals = int_intervals(pat)
    if lit and known:
        loop k in [0..intervals.len() / 2):
            if v >= intervals[2 * k] and v <= intervals[2 * k + 1]: return 0
        return -1
    -2

# Check unchecked comprehension arguments whose elements need no context, so
# overload selection sees their own element type. O(argument syntax).
comprehension_settle = (args: int[]) -> bool:
    settled = false
    loop a0 in args:
        a = unnamed(a0)
        if nodes[a].kind != .block or not has_flag(a, NF_COMPREHENSION) or has_flag(a, NF_CHECKED) or nkids(a) != 3: continue
        if not dewy_at(nodes[a].pos) or not comprehension_self_typed(kid(a, 1)): continue
        check_expr(a, 0)
        add_flag(a, NF_CHECKED)
        settled = true
    settled

# check_args_untyped (each argument's literal shape and function-value marks before an
# overload is picked) is checker_expr.dewy's; members(U) and spread records are host services.

# A place route starts at its owning binding. Narrowing aliases and shared
# captures still designate that same storage; private captures are independent.
mutable_route = (n: int, route: mut int[]) -> int:
    k = nodes[n].kind
    if k == .field or k == .index:
        root = mutable_route(int(nodes[n].a), route)
        route.push(n)
        return root
    if k == .unwrap or k == .narrow or k == .conv:
        return mutable_route(int(nodes[n].a), route)
    if k == .ident and nodes[n].aux == i32(int(SK.local)):
        l = int(nodes[n].sym)
        if int(locals[l].flags) & LF_ALIAS != 0 and locals[l].alias != 0:
            return mutable_route(int(locals[l].alias), route)
        if int(locals[l].flags) & LF_CAPTURE != 0 and int(locals[l].flags) & LF_VALUECAP == 0:
            return mutable_route(mk_ident_local(int(locals[l].outer), nodes[n].pos), route)
    n

mutable_overlap = (a: int, b: int) -> bool:
    left: int[]
    right: int[]
    ar = mutable_route(a, left)
    br = mutable_route(b, right)
    if nodes[ar].kind != .ident or nodes[br].kind != .ident: return false
    if nodes[ar].aux != nodes[br].aux or nodes[ar].sym != nodes[br].sym: return mutable_borrowed_overlap(ar, br)
    loop i in [0..min(left.len(), right.len())):
        x = left[i]
        y = right[i]
        if nodes[x].kind != nodes[y].kind: return true
        if nodes[x].kind == .field:
            if nodes[x].aux >= 0 and nodes[y].aux >= 0 and nodes[x].aux != nodes[y].aux: return false
            if nodes[x].aux == -2 and nodes[y].aux == -2 and nodes[x].ival != nodes[y].ival: return false
        else:
            xi = mutable_index(int(nodes[x].b))
            yi = mutable_index(int(nodes[y].b))
            if nodes[xi].kind == .int_lit and nodes[yi].kind == .int_lit and nodes[xi].ival != nodes[yi].ival: return false
    # Equal routes and parent/child routes overlap. Unknown indices can overlap.
    true

# Two different roots are different storage, except that an `@` parameter
# borrows its caller's place: a global or another function's variable (a
# shared capture) may be that same place. Distinct `@` parameters of one
# function were proven apart where it was called.
mutable_borrowed_overlap = (a: int, b: int) -> bool:
    x = if nodes[a].aux == i32(int(SK.local)): int(nodes[a].sym) else: 0
    y = if nodes[b].aux == i32(int(SK.local)): int(nodes[b].sym) else: 0
    bx = x != 0 and int(locals[x].flags) & LF_MUTPARAM != 0
    by = y != 0 and int(locals[y].flags) & LF_MUTPARAM != 0
    if not bx and not by: return false
    x == 0 or y == 0 or locals[x].owner != locals[y].owner

# checker_call_queries.dewy's check_mutable_arguments leaves the host two or more.
mutable_arguments_rest = (args: int[], mask: int, pos: int):
    if mask == 0 or mask & (mask - 1) == 0 or not dewy_at(pos): return
    loop i in [0..args.len()):
        if mask & (1 << i) == 0 or nodes[args[i]].kind == .hole: continue
        loop j in [0..i):
            if mask & (1 << j) == 0 or nodes[args[j]].kind == .hole: continue
            if not partition_disjoint(args[j], args[i]) and mutable_overlap(args[j], args[i]):
                fatal(nodes[args[i]].pos, "mutable arguments {j + 1} and {i + 1} overlap; pass disjoint places")

# checker_expr.dewy's finish_arg leaves the host mutable arguments, values written with
# `@` and coercions that change something; the steps already done are skipped here.

default_arg = (decl: int, i: int, pt: int, given: int[] = [], captured: bool = false, targs: int[] = []) -> int:
    d = clone(int(nodes[kid(decl, i)].b))
    # (h: f64 = w: a default naming an earlier parameter takes that argument)
    if given.len() > 0 and not captured: subst_params(d, decl, given)
    saved = cx
    ctxs.push(FnCtx(ctxs[cx].inst, -1, i32(T_VOID), false, 0, nodes[decl].mod, i32(check_scopes.names.len())))
    cx = ctxs.len() - 1
    mark = scope_mark()
    push_type_params(decl, targs)
    if captured:
        loop j in 0.. and value in given:
            name = int(nodes[kid(decl, j)].name)
            push_scope_sym(name, new_sym(name, .local, int(nodes[value].sym), kid(decl, j)))
    check_expr(d, pt)
    if pt != 0: coerce(d, pt)
    else: finalize_literal(d)
    scope_reset(mark)
    ctxs.pop()
    cx = saved
    d

# a default value's names of earlier parameters (of function decl) replaced by their arguments
subst_params = (n: int, decl: int, given: int[]):
    if n == 0: return
    k = nodes[n].kind
    if k == .lambda: return
    if k == .ident:
        loop j in 0.. and v in given:
            if v != 0 and int(nodes[kid(decl, j)].name) == int(nodes[n].name):
                if not simple_arg(v): fatal(nodes[v].pos, "the default of a later parameter uses this argument, so it is computed again there: give a variable or a value (`w = make_w()` first)")
                nodes[n] = nodes[clone(v)]
                return
        return
    subst_params(int(nodes[n].a), decl, given)
    subst_params(int(nodes[n].b), decl, given)
    if k != .for_:
        subst_params(int(nodes[n].c), decl, given)
        if k != .partial: subst_params(int(nodes[n].d), decl, given)
    loop i in [0..nkids(n)): subst_params(kid(n, i), decl, given)

default_uses_params = (n: int, decl: int, before: int) -> bool:
    if n == 0: return false
    names: int[]
    loop i in [0..before): names.push(int(nodes[kid(decl, i)].name))
    default_uses_names(n, names)

# Whether a default names one of `names` (earlier parameters or fields), outside
# the bindings it makes itself.
default_uses_names = (n: int, names: int[], hidden: int[] = []) -> bool:
    if n == 0: return false
    if nodes[n].kind == .ident:
        if hidden.contains(int(nodes[n].name)): return false
        return names.contains(int(nodes[n].name))
    if nodes[n].kind == .vardecl:
        return default_uses_names(int(nodes[n].b), names, hidden)
    if nodes[n].kind == .lambda:
        local_hidden = hidden
        loop i in [0..nkids(n)):
            param = kid(n, i)
            if default_uses_names(int(nodes[param].b), names, local_hidden): return true
            local_hidden.push(int(nodes[param].name))
        return default_uses_names(int(nodes[n].b), names, local_hidden)
    if nodes[n].kind == .block:
        local_hidden = hidden
        loop i in [0..nkids(n)):
            statement = kid(n, i)
            if default_uses_names(statement, names, local_hidden): return true
            if nodes[statement].kind == .vardecl:
                local_hidden.push(int(nodes[statement].name))
                loop binding in binding_leaves(kids(statement)): local_hidden.push(int(nodes[binding].name))
        return false
    if nodes[n].kind == .for_:
        if default_uses_names(int(nodes[n].a), names, hidden): return true
        local_hidden = hidden
        loop binder in binding_leaves(kids(n)): local_hidden.push(int(nodes[binder].name))
        return default_uses_names(int(nodes[n].b), names, local_hidden)
    if nodes[n].kind == .match_:
        if default_uses_names(int(nodes[n].a), names, hidden): return true
        loop i in [0..nkids(n)):
            arm = kid(n, i)
            local_hidden = hidden
            loop j in [0..nkids(arm)):
                pattern = kid(arm, j)
                if nodes[pattern].name != 0: local_hidden.push(int(nodes[pattern].name))
            if default_uses_names(int(nodes[arm].b), names, local_hidden): return true
        return false
    if default_uses_names(int(nodes[n].a), names, hidden) or default_uses_names(int(nodes[n].b), names, hidden): return true
    if default_uses_names(int(nodes[n].c), names, hidden) or default_uses_names(int(nodes[n].d), names, hidden): return true
    loop i in [0..nkids(n)):
        child = kid(n, i)
        if default_uses_names(child, names, hidden): return true
    false

# A captured value's unnamed local -> the expression it holds (for messages).
capture_sources: {int: int} = {}

capture_value = (a: int, pt: int, statements: mut int[]) -> int:
    local = new_local(0, pt, nodes[a].pos)
    capture_sources[local] = a
    locals[local].flags = i32(LF_DECL | LF_QUIET | LF_READ)
    binding = mk(.vardecl, nodes[a].pos)
    nodes[binding].a = i32(type_node_of(pt, nodes[a].pos))
    nodes[binding].b = i32(a)
    nodes[binding].sym = i32(local)
    nodes[binding].type = i32(pt)
    add_flag(binding, NF_CHECKED)
    statements.push(binding)
    mk_ident_local(local, nodes[a].pos)

call_targs: int[]              # type arguments written at the call being resolved (f[T](...))
cur_assign = 0                 # the assignment whose target is being checked (`x = ...`, `x += ...`)
early_set: {int: bool} = {}    # globals top-level code assigns above their own line

# Whether parameter i of declaration d is written as a builtin integer type (refined or not),
# read from its annotation alone
written_int_param = (d: int, i: int) -> bool:
    if i >= nkids(d): return false
    tn = int(nodes[kid(d, i)].a)
    if tn != 0 and nodes[tn].kind == .trefined: tn = int(nodes[tn].a)
    if tn == 0 or nodes[tn].kind != .tname or nkids(tn) != 0 or nodes[tn].sval != 0: return false
    s = universe.get(int(nodes[tn].name)) ?? 0
    if s == 0 or syms[s].kind != .type_ or module_lookup(int(nodes[d].mod), int(nodes[tn].name)) != s: return false
    tkind(int(syms[s].ref)) == .int_

# `upper = (s:string):>string => s.upper`: a Dewy function whose whole body calls
# itself again with its own parameters or literals never ends. O(1) per call.
self_call_is_body = (n: int, decl: int, args: int[]) -> bool:
    ci = int(ctxs[cx].inst)
    if ci <= 0 or int(fns[ci].decl) != decl or nodes[decl].kind != .fn_: return false
    b = int(nodes[decl].b)
    loop b != 0 and b != n and nodes[b].kind != .call:
        k = nodes[b].kind
        if k == .return_ or k == .exprstmt: b = int(nodes[b].a)
        else if k == .block and nkids(b) > 0:
            # (after the copies of the parameters a Dewy body starts with)
            last = nkids(b) - 1
            loop i in [0..last):
                c = kid(b, i)
                if nodes[c].kind != .vardecl or nodes[c].b == 0 or nodes[int(nodes[c].b)].kind != .ident: return false
            b = kid(b, last)
        else: return false
    if b != n: return false
    loop a in args:
        k = nodes[unnamed(a)].kind
        if k != .ident and k != .int_lit and k != .bool_lit and not (k == .str_lit and nkids(unnamed(a)) == 0): return false
    true

struct CallFailure:
    last_err: str
    last_err_pos: int
    last_err_arg: int
    last_err_tie: bool
    last_err_map: int
    rejected: Rejection[]

call_tie_error = (n: int, name: int, args: int[], cands: Cand[], best: int):
    loop ci in 0.. and cd in cands:
        if ci != best and cd.cost == cands[best].cost and cd.sig.generic == cands[best].sig.generic and decl_in_prelude(cd.decl) == decl_in_prelude(cands[best].decl) and (rest_bundles.len() == 0 or decl_has_rest(cd.decl) == decl_has_rest(cands[best].decl)):
            ats = ""
            loop ai in 0.. and a0 in args:
                if ai > 0: ats += ", "
                if nodes[unnamed(a0)].type != 0: ats += dt(ntype(unnamed(a0)))
            if nodes[n].aux2 == i32(AUX2_PARTIAL) and dewy_at(nodes[n].pos):
                fatal(nodes[n].pos, "ambiguous partial application of '{name_of(name)}': more than one overload takes these arguments (candidates at {pos_str(nodes[cands[best].decl].pos)} and {pos_str(nodes[cd.decl].pos)}); annotate the binding with the callable type it should have, as in `let f:(b:string:>string) = @{name_of(name)}(...)`")
            fatal(nodes[n].pos, "ambiguous call to '{name_of(name)}({ats})': candidates at {pos_str(nodes[cands[best].decl].pos)} and {pos_str(nodes[cd.decl].pos)}")

call_decl_checks = (n: int, name: int, decl: int, args: int[], cd: Cand, np: int, ufcs: bool):
    # (draw() inside draw: as a way to draw it again, it calls itself without end)
    if (name == id_draw or name == id_update) and modules[int(nodes[decl].mod)].is_main and cx >= 0:
        ci = int(ctxs[cx].inst)
        if ci > 0 and int(fns[ci].decl) == decl:
            fatal(nodes[n].pos, "{name_of(name)} calls itself here, which repeats without end: the game calls {name_of(name)} by itself, each frame")
    if cx >= 0 and caller_dewy() and self_call_is_body(n, decl, args): self_call_error(n, name, ufcs, args)
    if nodes[n].aux2 == i32(AUX2_PLACE) or nodes[n].aux2 == i32(AUX2_PLACE_TAKEN) or place_methods.has(decl): place_call_seen(n, decl)
    if (name == id_rgb or name == id_rgba) and np >= 3 and decl_in_prelude(decl): rgb_check(n, cd.args)
    if name == id_hsv and np >= 3 and decl_in_prelude(decl): hsv_check(n, cd.args)
    if not decl_in_prelude(decl) and cx >= 0:
        # (make_world never called: a function of the program's, used from somewhere else)
        ci0 = int(ctxs[cx].inst)
        if ci0 <= 0 or int(fns[ci0].decl) != decl: fn_used[decl] = true
    if decl_in_prelude(decl) and not pos_in_lib(nodes[n].pos):
        frame_call_check(n, decl)
        shader_draw_check(decl, cd.args)
        angle_check(decl, cd.args)
        qn = name_of(int(nodes[decl].name))
        if (starts_with(qn, "quat_") and qn != "quat_rotate" and qn != "quat_to_mat4") or qn == "slerp":
            quat_nodes[n] = true
            statement_watch.quaternions = quat_nodes.len()
        # (random_int(1, 6) for a die: its upper end is left out, as in [1..6))
        rhi = -1
        if name_of(int(nodes[decl].name)) == "random_int" and cd.args.len() == 2 and written_int(cd.args[0]) == 1: rhi = written_int(cd.args[1])
        if rhi == 6 or rhi == 10 or rhi == 12 or rhi == 20 or rhi == 100:
            # (a die's, or a percent's, upper end, as people write it: random_int(1, 7) is quiet,
            # and random_int(1, 5 + 1) says 1 to 5 is meant)
            warn(nodes[n].pos, "random_int(1, {rhi}) gives 1 to {rhi - 1}: its upper end is left out, as in [1..{rhi}); random_int(1, {rhi + 1}) gives 1 to {rhi} (and random_int(1, {rhi - 1} + 1) says 1 to {rhi - 1} is meant)")
        # (random(1, 6) for a die, as Python's randint: a number with a fraction)
        if name_of(int(nodes[decl].name)) == "random" and cd.args.len() == 2 and written_int(cd.args[0]) == 1:
            hi = written_int(cd.args[1])
            if hi == 6 or hi == 10 or hi == 12 or hi == 20 or hi == 100: warn(nodes[n].pos, "random(1, {hi}) gives a number with a fraction (such as 3.7); a whole number from 1 to {hi} is random_int(1, {hi + 1})")
        # (read_bytes("assets/hero.png") in a web page: it has no disk to read the file from)
        if target_wasm and cd.args.len() > 0 and cd.args[0] != 0 and nodes[cd.args[0]].kind == .str_lit and nodes[cd.args[0]].aux == 0:
            fnm = name_of(int(nodes[decl].name))
            if fnm == "read_file" or fnm == "read_bytes":
                f = name_of(int(nodes[cd.args[0]].sval))
                warn(nodes[n].pos, "a web page has no files from the disk: {fnm}(\"{f}\") finds only what the page wrote itself; `embed(\"{f}\")` builds the file into the program")

call_map_candidate = (d: int, args: int[], cd: mut Cand, kinds: int[], ufcs: bool, recv_fits: mut bool, failure: mut CallFailure) -> bool:
    np = nkids(d)
    cd.missing = true
    pnames: int[]
    hasdef: bool[]
    loop i in [0..np):
        pnames.push(int(nodes[kid(d, i)].name))
        hasdef.push(nodes[kid(d, i)].b != 0)
    if len(map_args(pnames, hasdef, args, cd.args, kinds, false, d)) > 0:
        if failure.last_err_arg == 0:
            failure.last_err = ""
            failure.last_err_map = d
        if ufcs and not recv_fits and np > 0 and nodes[unnamed(args[0])].type != 0:
            rb = fill(0, int(cd.sig.ntp))
            if match_type(cd.sig.params[0], ntype(unnamed(args[0])), rb, 0) >= 0: recv_fits = true
        return false
    true

call_reject_candidate = (cd: Cand, failed: int, failure: mut CallFailure):
    let cd = cd
    d = cd.decl
    i = abs(failed) - 1
    if i + 1 < failure.last_err_arg: return
    if failed < 0:
        if failure.last_err_arg < i + 1: failure.rejected.clear()
        failure.last_err_arg = i + 1
        failure.rejected.push(Rejection(-cd.decl, i, 0, subst(cd.sig.params[i], cd.binds), cd))
        return
    # Of the candidates, blame the one that got furthest; among its literals,
    # a failure before this argument is the first mistake.
    fi = i
    if not cd.sig.generic:
        loop j in [0..i):
            aj = cd.args[j]
            if aj == 0 or not is_lit(aj) or ctx_dependent(aj): continue
            if arg_cost(aj, cd.sig.params[j], cd.binds) < 0:
                fi = j
                break
    a = cd.args[fi]
    if failure.last_err_arg < i + 1: failure.rejected.clear()
    failure.last_err_arg = i + 1
    failure.rejected.push(Rejection(d, fi, a, subst(cd.sig.params[fi], cd.binds), cd))
    failure.last_err_pos = nodes[a].pos
    return

call_note_contracts = (n: int, f: int, decl: int, partial: bool, closure: int):
    if proof_active and proof_decls.has(decl):
        if partial: fatal(nodes[n].pos, "a proof cannot be used as a value; use a direct statement call")
        proof_calls.push(FactRequest(n, int(ctxs[cx].inst)))
    if wi_any and nodes[decl].c != 0 and not partial and closure == 0 and not cc_decls.has(decl): wi_call(n, f, decl)
    if dir_floats_any and not partial and closure == 0: ff_note_call(f, decl)

# the value of a struct type that has default field values (its own, or its fields' structs'),
# as T() makes it with nothing given: what `x: T` and a field left out start as (0: no struct,
# or nothing to set)
struct_default = (t0: int, pos: int) -> int:
    t = prune(t0)
    if refine_active and types[t].kind == .refined:
        d = if tkind(int(types[t].elem)) == .array: mk(.array, pos) else: bc_int(0, pos)
        check_expr(d, int(types[t].elem))
        coerce(d, t)
        return d
    if refine_active and types[t].kind == .fixed and ref_storage_contract(int(types[t].elem)):
        value = mk(.array, pos)
        nodes[value].type = i32(t)
        fixed_literal(value, t)
        add_flag(value, NF_CHECKED)
        return value
    # (an exact quantity starts at zero in its unit, a rational's 0/1, not zeroed words)
    if types[t].kind == .quantity and types[quantity_base(t)].kind == .struct_:
        zero = mk(.int_lit, pos)
        quantity_constant(zero, 0, 1, quantity_dimension(t), t)
        return zero
    if types[t].kind != .struct_ or is_map_type(t) or is_union(t): return 0
    si = int(types[t].st)
    if not struct_has_defaults(si, 0): return 0
    d = mk(.call, pos)
    struct_ctor_zero(d, t, int(structs[si].decl))
    add_flag(d, NF_CHECKED)
    d

struct_defaults_known: {int: bool} = {}
struct_has_defaults = (si: int, depth: int) -> bool:
    if let k = struct_defaults_known.get(si): return k
    if depth > 16: return false
    check_struct_fields(si)
    has = false
    loop i in [0..int(structs[si].nfields)):
        f = fields[int(structs[si].fields) + i]
        if f.defval != 0 or refine_active and ref_storage_contract(int(f.type)): has = true
        else:
            ft = prune(int(f.type))
            if types[ft].kind == .struct_ and not is_map_type(ft) and not is_union(ft) and struct_has_defaults(int(types[ft].st), depth + 1): has = true
        if has: break
    struct_defaults_known[si] = has
    has

dewy_record_shapes: {str: int} = {}

dewy_record_target = (expected: int) -> int:
    target = prune(expected)
    if target == 0: return 0
    if types[target].kind == .opt: target = prune(int(types[target].elem))
    if types[target].kind == .struct_ and not is_map_type(target): return target
    0

# The one member of an expected union a literal builds, or 0 when none or
# several could: a record literal takes the record whose fields it names
# (every field without a default among them), a dictionary literal the
# dictionary, any other array literal the array (or, when the union has
# none, the positional array type with as many positions: `[string int64]`).
# A lambda where an optional or a union of function types is wanted: the function member with its
# parameter count gives its parameters their types (a union with two has no one answer). O(members).
lambda_member = (n: int, expected: int) -> int:
    found = function_member(expected, nkids(n))
    if found != 0: found else: expected

# (of an optional or a union, the one function member taking `count` parameters, any number at -1; 0
# for none or two)
function_member = (expected: int, count: int = -1) -> int:
    u = prune(expected)
    if u == 0: return 0
    if types[u].kind == .opt: u = prune(int(types[u].elem))
    members = if is_union(u): union_members(u) else: [u]
    found = 0
    loop m0 in members:
        m = prune(m0)
        base = if types[m].kind == .callable: prune(callable_base(m)) else: m
        if types[base].kind == .fn_ and (count < 0 or int(types[base].nargs) == count):
            if found != 0: return 0
            found = m
    found

literal_union_member = (n: int, expected: int) -> int:
    u = prune(expected)
    if u == 0: return 0
    if types[u].kind == .opt: u = prune(int(types[u].elem))
    if not is_union(u): return 0
    k = nodes[n].kind
    found = 0
    tuple = 0
    loop m0 in union_members(u):
        m = prune(m0)
        mkind = types[m].kind
        fits = false
        if k == .record_lit:
            if mkind == .struct_ and not is_map_type(m) and not structs[int(types[m].st)].union_:
                si = int(types[m].st)
                fits = true
                loop j in [0..nkids(n)):
                    entry = kid(n, j)
                    named = false
                    loop i in [0..int(structs[si].nfields)):
                        if fields[int(structs[si].fields) + i].name == nodes[entry].name: named = true
                    if not named: fits = false
                loop i in [0..int(structs[si].nfields)):
                    f = fields[int(structs[si].fields) + i]
                    if f.defval != 0: continue
                    given = false
                    loop ki in [0..nkids(n)):
                        entry = kid(n, ki)
                        if nodes[entry].name == f.name: given = true
                    if not given: fits = false
        else if k == .map_lit: fits = is_map_type(m)
        else if mkind == .tuple:
            if nkids(n) == int(types[m].nargs) and not array_has_spread(n):
                if tuple != 0: tuple = -1
                else: tuple = m
        else: fits = mkind == .array or mkind == .fixed or nkids(n) == 0 and is_map_type(m)
        if fits:
            if found != 0: return 0
            found = m
    if found == 0 and tuple > 0: return tuple
    found

# With no written field names, the first spread distinguishes `[xs...]` from
# `[record...]`. Inspect a clone so contextual checking retains the source AST.
dewy_spread_source_type = (n: int) -> int:
    # Call arguments may already have become checked constructor calls. Their
    # original type syntax is gone; retain the checked type instead of cloning
    # them as unchecked syntax and trying to resolve them again.
    if nodes[n].type != 0 and has_flag(n, NF_CHECKED): return prune(ntype(n))
    copy = clone(n)
    # (`[pair()...]`: a function expressing several values spreads them as an array would)
    saved_site = sink_pack_site
    sink_pack_site = copy
    t = check_expr(copy, 0)
    sink_pack_site = saved_site
    sink_pack_hit = 0
    prune(t)

# (`[f()...]`, f a function or function value by name: it may give several values)
values_spread_call = (c: int) -> bool:
    callee = int(nodes[c].a)
    if nodes[callee].kind != .ident or has_flag(c, NF_CHECKED): return false
    s = lookup(int(nodes[callee].name))
    if s == 0: return false
    k = syms[s].kind
    k == .fns or k == .local or k == .global

dewy_classify_spread = (n: int):
    if nodes[n].kind != .array or nodes[n].b != 0 or nkids(n) == 0: return
    first = kid(n, 0)
    if not has_flag(first, NF_SPREAD) or not files[pos_file(nodes[n].pos)].is_dewy: return
    # Leave set literals contextual, including an empty set whose member type
    # comes from the surrounding array/set or a selected overload.
    if dewy_set_literal(first): return
    t = dewy_spread_source_type(first)
    if types[t].kind == .struct_ and not is_map_type(t) and not is_dewy_set_type(t): nodes[n].kind = .record_lit

# A record field whose value is a type (decisions.md, batch 7): one interned typeval per type, so
# records with the same type members share one shape instance. It has no runtime storage.
type_member_types: {int: int} = {}

# Is e written as a type (a type's name, or `r.Png` naming a type member)? Such a record
# field's value is not captured: it has no storage.
type_value_expr = (e: int) -> bool:
    k = nodes[e].kind
    if k == .ident:
        s = lookup(int(nodes[e].name))
        if s == 0: return false
        sk = syms[s].kind
        return sk == .type_ or sk == .struct_ or sk == .enum_ or sk == .alias_
    if k == .binary and (nodes[e].op as Tok == .pipe or nodes[e].op as Tok == .amp): return type_value_expr(int(nodes[e].a)) and type_value_expr(int(nodes[e].b))
    if k == .field and nodes[e].b == 0 and nodes[int(nodes[e].a)].kind == .ident:
        s = lookup(int(nodes[int(nodes[e].a)].name))
        return s != 0 and syms[s].kind != .module and value_type_member(s, int(nodes[e].name), nodes[e].pos) != 0
    false

# `f([Png Jpeg] ...)`, `$named[Png Jpeg]` (decisions.md, batch 7): a call of a Dewy function given
# a sequence of types is specialized on that sequence. Its body is checked in place, the first
# parameter standing for the types and the other arguments bound by name, as a block giving
# its value. -1 when n is no such call. Checked once per call; O(1) for any other call.
type_sequence_call = (n: int, expected: int) -> int:
    if nkids(n) == 0: return -1
    first = kid(n, 0)
    if nodes[first].kind != .array or nkids(first) == 0 or not dewy_at(nodes[n].pos) or not type_value_expr(kid(first, 0)): return -1
    callee = int(nodes[n].a)
    fname = int(nodes[callee].name)
    s = lookup(fname)
    # (the prelude's `named`, loaded when first called)
    if s == 0: s = dewy_prelude_lookup(fname)
    if s == 0 or syms[s].kind != .fns: return -1
    pos = nodes[n].pos
    named_args: int[]
    loop i in [1..nkids(n)):
        a = kid(n, i)
        if nodes[a].kind != .namedarg: fatal(nodes[a].pos, "after its types, a call specialized on them takes named arguments")
        named_args.push(a)
    # (the overload whose parameters are the sequence and those names)
    d = 0
    candidates: int[]
    loop s != 0:
        if syms[s].name == i32(fname) and syms[s].kind == .fns and syms[s].decl != 0: candidates.push(int(syms[s].decl))
        s = int(syms[s].next)
    loop c in candidates:
        if nodes[c].kind != .fn_ or nkids(c) != named_args.len() + 1: continue
        fits = true
        loop a in named_args:
            found = false
            loop j in [1..nkids(c)):
                if nodes[kid(c, j)].name == nodes[a].name: found = true
            if not found: fits = false
        if fits:
            d = c
            break
    if d == 0: fatal(pos, "no {name_of(int(nodes[callee].name))} takes a sequence of types with these arguments")
    seq = type_sequence(first)
    # (`$named`'s strict rule, the registry's: every type has a name, and no name twice)
    if pos_in_lib(nodes[d].pos) and name_of(fname) == "named":
        seen: {str: bool} = {}
        loop i in 0.. and t in seq:
            text = type_short_name(t)
            at = nodes[kid(first, i)].pos
            if len(text) == 0: fatal(at, "{dt(t)} has no name of its own, so `$named` cannot name its member (give it one, `Name:type = ...`)")
            if seen.has(text): fatal(at, "field {text} is listed twice")
            seen[text] = true
    mark = scope_mark()
    g = globals.len()
    pname = int(nodes[kid(d, 0)].name)
    globals.push(Global(name = i32(pname), type = i32(T_VOID), mod = i32(cur_mod()), is_const = true, state = 2))
    type_sequences[g] = seq
    push_scope_sym(pname, new_sym(pname, .const_, g, 0))
    statements: int[]
    # (`each=@handle`, a function by name: the specialized body calls it by that name, so a
    # generic one is specialized per type rather than needing a value's type)
    renames: int[]
    loop a in named_args:
        v = int(nodes[a].a)
        fs = if nodes[v].kind == .ident: lookup(int(nodes[v].name)) else: 0
        if fs != 0 and syms[fs].kind == .fns:
            renames.push(int(nodes[a].name))
            renames.push(int(nodes[v].name))
        else: statements.push(bc_let(name_of(int(nodes[a].name)), v, nodes[a].pos))
    loop st in kids(int(nodes[d].b)):
        # (the parameters' own bindings: given above)
        if nodes[st].kind == .vardecl and nodes[st].aux2 == 1: continue
        copy = clone(st)
        if renames.len() > 0: rename_idents(copy, renames)
        statements.push(copy)
    nodes[n] = Node(kind = .block, pos = pos, aux = 1)
    set_list(n, statements)
    t = check_expr(n, expected)
    scope_reset(mark)
    t

# (a global that stands for a sequence of types: its types)
type_sequences: {int: int[]} = {}

# A generic type's name written bare where values are tested (decisions.md, batch 7): `<Closed>`,
# `is? Closed`, `or_throw<Closed>` take every `Closed<T>`. While a test's type is resolved
# (ct_resolve_family) a bare generic name is the union of that type's instances, a family the
# test narrows to the tested value's members; elsewhere it still needs its arguments.
bare_generic_ok = false
bare_generic_set = (on: bool) -> bool:
    was = bare_generic_ok
    bare_generic_ok = on
    was

# A field-less generic exception's erased instance (`Closed<void>`, errors.jo): the member of
# `exception` every instance is reported as, since that family lists no generic instance.
nominal_erased = (d: int) -> int: get_struct_inst(d, fill(T_VOID, nkids2(d)))

# The statements reporting a task's failure `vn` (a name), known to hold member, to the group
# named gn: the value itself; a field-less generic exception's erased instance; `Unsent<T>`'s
# reason, each of its members reported the same way.
task_failure_calls = (gn: str, vn: str, member: int, pos: int) -> int[]:
    if member == T_NONE: return [bc_stmt(bc_call("__task_fail", [bc_ident(gn, pos), mk(.none_lit, pos)], pos), pos)]
    if not nominal_generic_instance(member): return [bc_stmt(bc_call("__task_fail", [bc_ident(gn, pos), bc_ident(vn, pos)], pos), pos)]
    si = int(types[prune(member)].st)
    check_struct_fields(si)
    if structs[si].nfields == 0:
        erased = nominal_erased(int(structs[si].decl))
        value = mk(.call, pos)
        struct_ctor(value, erased, int(structs[int(types[erased].st)].decl), [], 0)
        add_flag(value, NF_CHECKED)
        return [bc_stmt(bc_call("__task_fail", [bc_ident(gn, pos), value], pos), pos)]
    reason = 0
    loop i in [0..int(structs[si].nfields)):
        if name_of(int(fields[int(structs[si].fields) + i].name)) == "reason": reason = int(fields[int(structs[si].fields) + i].type)
    if reason == 0: fatal(pos, "a task's failure {dt(member)} cannot be reported: a generic exception reports its `reason`")
    rn = "{vn}_reason"
    out = [bc_let(rn, bc_field(bc_ident(vn, pos), "reason", pos), pos)]
    held = value_members(reason)
    loop m in held:
        if not exception_member(m): continue
        calls = task_failure_calls(gn, rn, m, pos)
        if held.len() == 1:
            out += calls
            continue
        condition = mk(.istype, pos)
        nodes[condition].a = i32(bc_ident(rn, pos))
        nodes[condition].b = i32(type_node_of(m, pos))
        branch = mk(.if_, pos)
        nodes[branch].a = i32(condition)
        nodes[branch].b = i32(bc_block(calls, pos))
        add_flag(branch, NF_STMT)
        out.push(branch)
    out

# The instances of generic declaration d made so far, as one type: a family when there are
# several (nominal_families, under d's own negative key), 0 when there is none. O(structs).
generic_family_cache: {int: (int, int)} = {}

# A wait handle's outcomes (decisions.md, batch 7, `heart.types`: everything the source can
# produce): the result of its type's own zero-argument `receive`, or else `next` (a channel's
# `T | Closed | Canceled`, a ticker's `Tick | Canceled`); 0 when it has neither. Once per type.
handle_outcomes_cache: {int: int} = {}

# `r.Png` written as a type, r a local or global: the type its member holds, 0 when r is no such
# value or that member is no type.
value_type_member = (s: int, name: int, pos: int) -> int:
    k = syms[s].kind
    t = 0
    if k == .local: t = int(locals[int(syms[s].ref)].type)
    else if k == .global:
        ensure_global(int(syms[s].ref), pos)
        t = int(globals[int(syms[s].ref)].type)
    if t == 0: return 0
    member = record_type_member(t, name)
    if member == 0 and not record_has_member(t, name): member = handle_type_member(t, name)
    if member != 0 and k == .local: locals[int(syms[s].ref)].flags |= i32(LF_READ)
    if handle_outcomes(t) != 0: handle_clash_warning(t, pos)
    member

# The clash rule (decisions.md, batch 7): an outcome whose short name the handle's type already
# has as a member gets no shorthand; the member wins, with this warning, once per type.
handle_clash_warned: {int: bool} = {}

# Type annotations and inferred literals share the same structural identity.
# Each member carries its resolved type; source values remain separate.
dewy_record_schema = (n: int, args: int[]) -> int:
    # Small record schemas use insertion sort; source argument storage is separate.
    ordered: int[]
    loop field in args:
        ordered.push(field)
        i = ordered.len() - 1
        loop i > 0 and name_of(int(nodes[ordered[i - 1]].name)) > name_of(int(nodes[field].name)):
            ordered[i] = ordered[i - 1]
            i -= 1
        ordered[i] = field
    # Intern the shape once. Its field types are ordinary type arguments, so
    # generic matching, substitution and specialization need no separate path.
    key = ""
    targs: int[]
    loop field in ordered:
        key += "{int(nodes[field].name)};"
        targs.push(prune(ntype(field)))
    decl = dewy_record_shapes.get(key) ?? 0
    if decl == 0:
        decl = mk(.struct_, nodes[n].pos)
        nodes[decl].name = i32(intern("<record>"))
        nodes[decl].mod = ctxs[cx].mod
        add_flag(decl, NF_RECORD)
        add_flag(decl, NF_GENERIC)
        members: int[]
        params: int[]
        loop i in 0.. and field in ordered:
            param = mk(.ident, nodes[field].pos)
            nodes[param].name = i32(intern("__Field{i}"))
            params.push(param)
            member = mk(.vardecl, nodes[field].pos)
            nodes[member].name = nodes[field].name
            tn = mk(.tname, nodes[field].pos)
            nodes[tn].name = nodes[param].name
            nodes[member].a = i32(tn)
            members.push(member)
        set_list(decl, members)
        set_list2(decl, params)
        dewy_record_shapes[key] = decl
    t = get_struct_inst(decl, targs)
    check_struct_fields(int(types[t].st))
    t

# (set by the compiler's own default-value constructions, T() as `x: T` starts: those fill what
# has no default with zero; a construction written in Dewy may not)
ctor_fills_zero = false

struct_ctor = (n: int, st_type: int, decl: int, args: int[], expected: int) -> int:
    if decl != 0 and dewy_at(nodes[n].pos):
        module = int(nodes[decl].mod)
        if module == concurrency_thread_module and name_of(int(nodes[decl].name)) == "Atomic":
            fatal(nodes[n].pos, "construct Atomic with atomic(value); its storage is private")
        if module == concurrency_task_module or module == concurrency_task_core_module:
            name = name_of(int(nodes[decl].name))
            if name == "Task" or name == "TaskGroup": fatal(nodes[n].pos, "task handles are created by concurrent and spawn; their storage is private")
    fills_zero = ctor_fills_zero
    ctor_fills_zero = false
    t = st_type
    if t == 0 and nkids2(decl) == 0: t = get_struct_inst(decl, [])
    if t == 0:
        ntp = nkids2(decl)
        binds = fill(0, ntp)
        ex = prune(expected)
        if expected != 0 and types[ex].kind == .struct_ and int(structs[int(types[ex].st)].decl) == decl: t = ex
        else:
            mark = scope_mark()
            loop i in [0..ntp):
                nm = int(nodes[kid2(decl, i)].name)
                push_scope_sym(nm, new_sym(nm, .type_, mk_param(i), 0))
            check_args_untyped(args)
            pnames: int[]
            hasdef: bool[]
            loop i in [0..nkids(decl)):
                pnames.push(int(nodes[kid(decl, i)].name))
                hasdef.push(true)
            mapped: int[]
            err = map_args(pnames, hasdef, args, mapped, dewy_param_kinds.get(decl) ?? [])
            if len(err) > 0: fatal(nodes[n].pos, err)
            loop i in [0..nkids(decl)):
                a = mapped[i]
                if a == 0 or ctx_dependent(a) or is_lit(a): continue
                f = kid(decl, i)
                if nodes[f].a == 0: continue
                pat = resolve_type(int(nodes[f].a))
                match_type(pat, ntype(a), binds, 0)
            # A literal does not override a declared type default. Known
            # nonliteral fields constrain the type before defaults are filled.
            loop i in [0..nkids(decl)):
                a = mapped[i]
                if a == 0 or not is_lit(a): continue
                f = kid(decl, i)
                if nodes[f].a == 0: continue
                inferred = binds
                match_type(resolve_type(int(nodes[f].a)), lit_default(a), inferred, 0)
                loop j in [0..ntp):
                    if binds[j] == 0 and nodes[kid2(decl, j)].b == 0: binds[j] = inferred[j]
            defaults = type_param_defaults(decl, [], binds)
            loop i in [0..defaults.len()):
                if binds[i] == 0: binds[i] = defaults[i]
            loop i in [0..nkids(decl)):
                a = mapped[i]
                if a == 0 or not is_lit(a): continue
                f = kid(decl, i)
                if nodes[f].a == 0: continue
                pat = resolve_type(int(nodes[f].a))
                hint = subst_partial(pat, binds)
                if has_var(hint): finalize_literal(a)
                else: coerce(a, hint)
                match_type(pat, ntype(a), binds, 0)
            # As with function calls, first collect known argument types, then
            # check contextual literals/callbacks against the partially bound
            # field types. Empty collections can use another field's type.
            loop i in [0..nkids(decl)):
                a = mapped[i]
                if a == 0 or not ctx_dependent(a) or nodes[a].kind == .hole: continue
                f = kid(decl, i)
                if nodes[f].a == 0: continue
                pat = resolve_type(int(nodes[f].a))
                check_expr(a, subst_partial(pat, binds))
                add_flag(a, NF_CHECKED)
                match_type(pat, ntype(a), binds, 0)
            scope_reset(mark)
            loop i in [0..ntp):
                if binds[i] == 0:
                    sn = name_of(int(nodes[decl].name))
                    more = ""
                    if ntp > 1: more = " ..."
                    how = ""
                    if dewy_at(nodes[n].pos): how = " (nothing given says what it is: name it, as in `{sn}<int64{more}>[...]`, or annotate the variable)"
                    fatal(nodes[n].pos, "cannot infer type parameter '{name_of(int(nodes[kid2(decl, i)].name))}' of {sn}{how}")
            t = get_struct_inst(decl, binds)
    si = int(types[prune(t)].st)
    check_struct_fields(si)
    nf = int(structs[si].nfields)
    pnames: int[]
    hasdef: bool[]
    loop i in [0..nf):
        pnames.push(int(fields[int(structs[si].fields) + i].name))
        hasdef.push(true)
    mapped: int[]
    err = map_args(pnames, hasdef, args, mapped)
    if len(err) > 0: fatal(nodes[n].pos, "in {name_of(int(nodes[decl].name))}(...): {err}")
    if not fills_zero and files[pos_file(nodes[decl].pos)].is_dewy:
        # (a Dewy object is built from what is given and its defaults, never from invented zeros)
        loop i in [0..nf):
            fi = int(structs[si].fields) + i
            # (an optional field defaults to none)
            if mapped[i] == 0 and int(fields[fi].defval) == 0 and tkind(int(fields[fi].type)) != .opt:
                fatal(nodes[n].pos, "{dt(t)} needs its field '{name_of(int(fields[fi].name))}', which has no default")
    missing_field_check(n, decl, si, args, mapped)
    if ide_on:
        fts: int[]
        loop i in [0..nf): fts.push(int(fields[int(structs[si].fields) + i].type))
        ide_named_args(args, decl, IK_FIELD, fts)
    # (a struct that holds itself, a: A, says so before its fields' defaults are made: they would
    # make one another without end)
    layout(t)
    # A default naming an earlier field takes the value this construction gives it:
    # explicit values are kept first, in written order, then defaults in field order.
    dependent = false
    if files[pos_file(nodes[decl].pos)].is_dewy:
        names: int[]
        loop i in [0..nf):
            fi = int(structs[si].fields) + i
            if mapped[i] == 0 and default_uses_names(int(fields[fi].defval), names): dependent = true
            names.push(int(fields[fi].name))
    captured = fill(0, nf)
    statements: int[]
    if dependent:
        loop source in args:
            a = unnamed(source)
            loop i in [0..nf):
                if mapped[i] != a and mapped[i] != source: continue
                if nodes[a].kind == .hole: fatal(nodes[a].pos, "partial application of constructors is not supported")
                ft = representation_type(int(fields[int(structs[si].fields) + i].type))
                finish_arg(a, ft, false)
                captured[i] = capture_value(a, ft, statements)
                break
    fin: int[]
    loop i in [0..nf):
        fi = int(structs[si].fields) + i
        a = mapped[i]
        if dependent and a != 0:
            finish_arg(captured[i], int(fields[fi].type), false)
            fin.push(captured[i])
            continue
        if a == 0:
            dv = int(fields[fi].defval)
            if dv != 0 and not dependent and default_is_zero(dv, int(fields[fi].type)):
                concurrency_require_zero(n, int(fields[fi].type))
                # (filled in place with zeros, not built aside and copied in)
                fin.push(0)
                continue
            if dv != 0:
                d = clone(dv)
                saved = cx
                ctxs.push(FnCtx(ctxs[cx].inst, -1, i32(T_VOID), false, 0, nodes[decl].mod, i32(check_scopes.names.len())))
                cx = ctxs.len() - 1
                mark = scope_mark()
                targs: int[]
                loop j in [0..int(structs[si].ntargs)): targs.push(struct_targ(si, j))
                push_type_params(decl, targs)
                if dependent:
                    loop j in [0..i):
                        if captured[j] == 0: continue
                        name = int(fields[int(structs[si].fields) + j].name)
                        push_scope_sym(name, new_sym(name, .local, int(nodes[captured[j]].sym), 0))
                check_expr(d, representation_type(int(fields[fi].type)))
                coerce(d, representation_type(int(fields[fi].type)))
                scope_reset(mark)
                ctxs.pop()
                cx = saved
                if dependent:
                    d = capture_value(d, representation_type(int(fields[fi].type)), statements)
                    finish_arg(d, int(fields[fi].type), false)
                finish_arg(d, int(fields[fi].type), false)
                captured[i] = d
                fin.push(d)
            else:
                d = struct_default(int(fields[fi].type), nodes[n].pos)
                if d == 0: concurrency_require_zero(n, int(fields[fi].type))
                if dependent and d != 0:
                    d = capture_value(d, representation_type(int(fields[fi].type)), statements)
                    finish_arg(d, int(fields[fi].type), false)
                captured[i] = d
                fin.push(d)
            continue
        if nodes[a].kind == .hole: fatal(nodes[a].pos, "partial application of constructors is not supported")
        # (a type member has no storage: nothing is evaluated or stored for it)
        if tkind(int(fields[fi].type)) == .typeval:
            fin.push(0)
            continue
        finish_arg(a, int(fields[fi].type), false)
        fin.push(a)
    nodes[n].kind = .call
    nodes[n].aux = 2
    if not dependent: save_call_order(n, args, fin)
    set_list(n, fin)
    nodes[n].type = i32(t)
    nodes[n].a = 0
    if dependent:
        call = nodes.len()
        nodes.push(nodes[n])
        result = mk(.exprstmt, nodes[n].pos)
        nodes[result].a = i32(call)
        statements.push(result)
        nodes[n] = Node(kind = .block, pos = nodes[n].pos, type = i32(t), aux = 1)
        set_list(n, statements)
    t

# A field default whose value is the zero bytes, which the slot's fill already wrote: `none` for
# an optional, `[]` for a fixed array, a machine integer's 0, 0.0 (not -0.0), false, an
# enumeration's first member
default_is_zero = (dv: int, ft: int) -> bool:
    k = nodes[dv].kind
    fk = tkind(ft)
    if k == .none_lit: return fk == .opt
    if k == .int_lit and nodes[dv].ival == 0 and not has_flag(dv, NF_U64): return fk == .int_ and prune(ft) != T_MATH_INT
    if k == .float_lit and fk == .float_: return nodes[dv].fval == 0.0 and 1.0 / nodes[dv].fval > 0.0
    if k == .bool_lit and nodes[dv].ival == 0: return fk == .bool_
    # (`'first'` in Dewy, `.first` in Sloppy)
    word = if k == .str_lit and nodes[dv].nlist == 0: int(nodes[dv].sval) else: if k == .dotname: int(nodes[dv].name) else: 0
    if word != 0 and fk == .enum_ and not is_union(ft):
        si = int(types[prune(ft)].st)
        check_struct_fields(si)
        return int(structs[si].nvariants) > 0 and int(variants[int(structs[si].variants)].name) == word
    k == .array and nkids(dv) == 0 and nodes[dv].b == 0 and fk == .fixed

# (P(1) for struct P: x: f64; y: f64: values given in order stop short of a field without a
# default, which would be zero unnoticed; T() and names only, T(x = 1), leave fields out on purpose)
missing_field_check = (n: int, decl: int, si: int, args: int[], mapped: int[]):
    npos = 0
    loop a in args:
        if nodes[a].kind != .namedarg: npos += 1
    if npos == 0 or pos_in_lib(nodes[n].pos): return
    nf = int(structs[si].nfields)
    # (one or two left out: more, as Enemy(pos, kind) of a struct of many fields, is on purpose)
    left = 0
    loop i in [0..nf):
        if mapped[i] == 0 and int(fields[int(structs[si].fields) + i].defval) == 0: left += 1
    if left > 2: return
    loop i in [0..nf):
        fi = int(structs[si].fields) + i
        if mapped[i] != 0 or int(fields[fi].defval) != 0: continue
        # (an empty array or map, false, none: as likely meant as not)
        fk = tkind(int(fields[fi].type))
        sn = name_of(int(nodes[decl].name))
        fname = name_of(int(fields[fi].name))
        if fk == .fn_:
            warn(nodes[n].pos, "{sn}(...) leaves its function field '{fname}' with nothing to call (calling it stops the program): give it, as `{sn}(..., {fname} = (): ...)`, or set it before it is called")
            return
        if fk != .int_ and fk != .float_ and fk != .vec and fk != .str_ and fk != .struct_: continue
        warn(nodes[n].pos, "{sn}(...) leaves its field '{fname}' at zero ({npos} of its {nf} fields given in order): give it, give it a default in the struct (`{fname}: {dt(int(fields[fi].type))} = ...`), or name the fields given (`{sn}({name_of(int(fields[int(structs[si].fields)].name))} = ...)`)")
        return

conversion = (n: int, to0: int, args: int[]) -> int:
    to = prune(to0)
    tk = types[to].kind
    if args.len() == 1 and charlike(args[0]) and tk == .int_:
        # (int("5") reads as the number 5 to a Python programmer, but a one-character string is its code)
        a0 = args[0]
        if nodes[a0].kind == .str_lit and not type_eq(to, T_U8) and src_char(nodes[a0].pos) == '"':
            # (int('0') in single quotes, as character arithmetic writes it, is the code)
            w = name_of(int(nodes[a0].sval))
            if len(w) == 1 and w[0] >= '0' and w[0] <= '9':
                fatal(nodes[n].pos, "{dt(to0)}(\"{w}\") would be the code of the character {w} ({int(w[0])}): `to_int(\"{w}\")` reads the number, and `{jd(nodes[n].pos, "u8", "uint8")}('{w}')` is the code")
        charlike_to_int(args[0])
    if tk == .vec: return check_vec_ctor(n, to, args)
    if args.len() != 1 or nodes[args[0]].kind == .namedarg: fatal(nodes[n].pos, "{dt(to0)}(...) takes one argument")
    if tk == .str_:
        if dewy_at(nodes[n].pos) and not pos_in_lib(nodes[n].pos):
            ft = prune(check_expr(args[0], 0))
            add_flag(args[0], NF_CHECKED)
            bytes_text_warning(n, ft)
        part = mk(.pair, nodes[n].pos)
        nodes[part].a = i32(args[0])
        nodes[part].sval = -1
        nodes[n] = Node(kind = .str_lit, pos = nodes[n].pos, aux = 1)
        set_list(n, [part])
        return check_expr(n, 0)
    a = args[0]
    check_expr(a, if tk == .float_ and nodes[a].kind == .float_lit: to else: 0)
    ft = prune(ntype(a))
    if ft == T_MATH_INT and to != T_MATH_INT and (is_int(to) or is_float(to)):
        if not is_lit(a) and is_int(to) and int_policy(to) == 0: check_integer_boundary(a, ft, to)
        a = exact_math_operand(a)
        ft = prune(ntype(a))
    if to != T_MATH_INT and int_policy(to) == 0 and is_int(to) and is_int(ft) and ft != T_MATH_INT and exact_potential(a):
        nodes[n] = Node(kind = .conv, pos = nodes[n].pos, a = i32(a), aux = i32(int(CV.int_)), type = i32(to), flags = i32(NF_CHECKED | NF_EXPLICIT_INTEGER))
        return to
    if int_policy(to) != 0 and not is_int(ft): fatal(nodes[n].pos, "overflow policy conversion requires an integer")
    if int_policy(to) != 0 and is_int(ft):
        nodes[n] = nodes[a]
        wrap_conv(n, (if int_policy(to) == 1: CV.wrap_int else: CV.saturate_int), to)
        return to
    if tk == .int_ and nodes[a].kind == .float_lit and nodes[a].sval != 0: ft = exact_decimal(a)
    if tk == .int_ and (bundled_rational_type(ft) or bundled_word_rational_type(ft)):
        source = nodes.len()
        nodes.push(nodes[a])
        add_flag(source, NF_CHECKED)
        rational_helper_call(a, "_truncate", source, T_MATH_INT)
        if to != T_MATH_INT: coerce(a, to)
        nodes[n] = nodes[a]
        return to
    if (ft == T_MATH_INT and (bundled_bigint_type(to) or math_rep_type(to))) or (to == T_MATH_INT and (bundled_bigint_type(ft) or math_rep_type(ft))):
        coerce(a, to)
        nodes[n] = nodes[a]
        return to
    if bundled_rational_type(ft) and tk == .float_:
        coerce(a, to)
        nodes[n] = nodes[a]
        return to
    if is_lit(a) and nodes[a].kind == .float_lit and tk == .int_ and to == T_MATH_INT:
        coerce(a, T_FLOAT)
        nodes[n] = nodes[a]
        wrap_conv(n, .float2int, to)
        return to
    if is_lit(a) and nodes[a].kind == .float_lit and tk == .int_:
        nodes[a].kind = .int_lit
        nodes[a].ival = int(nodes[a].fval)
    if is_lit(a) and is_numeric(to):
        coerce(a, to)
        nodes[n] = nodes[a]
        return to
    fk = types[ft].kind
    cv = -1
    # (uint64(x) between fixed widths keeps the value: proven from facts, or checked
    # when it runs; an overflow='wrap' type keeps the bits)
    if tk == .int_ and fk == .int_ and ft != T_MATH_INT and to != T_MATH_INT and not int_widens(ft, to) and dewy_at(nodes[n].pos):
        nodes[n] = nodes[a]
        narrow_int(n, ft, to)
        return to
    if tk == .int_:
        if fk == .int_: check_integer_boundary(a, ft, to)
        if fk == .int_ or fk == .bool_: cv = int(CV.int_)
        else if fk == .float_:
            cv = int(CV.float2int)
            # (a checked conversion's failure report: demanded by its first use)
            if to != T_MATH_INT and dewy_at(nodes[n].pos): float_int_demanded = true
            # (an obligation: floats.jo ff_int_obligation)
            if dewy_at(nodes[n].pos) and not pos_in_lib(nodes[n].pos): ff_note_conversion()
        else if fk == .enum_ and simple_enum(ft):
            if str_set_of(ft) != 0 and dewy_at(nodes[n].pos) and not pos_in_lib(nodes[n].pos): str_set_unnumbered(nodes[n].pos, ft)
            cv = int(CV.int_)
        else if fk == .ptr: cv = int(CV.ptr)
    else if tk == .float_:
        if fk == .int_:
            cv = int(CV.int2float)
            if exact_potential(a): runtime_demand(if to == T_F32: "__exact_i128_f32" else: "__exact_i128_f64")
        else if fk == .float_: cv = int(CV.float_)
    else if tk == .bool_:
        if fk == .bool_: cv = int(CV.none_)
    if cv < 0:
        hint = ""
        read_int = if dewy_at(nodes[n].pos): T_MATH_INT else: T_INT
        if fk == .str_ and tk == .int_:
            hint = " (`to_int(s)` reads a number from text: it gives {a_type(mk_opt(read_int))}, none when the text is not one)"
            if dewy_at(nodes[n].pos): hint = " (`to_int(s)` reads a number from text: it gives an int, or `NotAnInteger` when the text is not one; `to_int(s) ?? 0` falls back)"
        if fk == .str_ and tk == .float_: hint = " (`to_float(s)` reads a number from text: it gives {a_type(mk_opt(T_FLOAT))}, none when the text is not one)"
        # (`int(input("n? "))`: what a failure there would mean is the program's to say)
        if hint == "" and dewy_at(nodes[n].pos) and is_union(ft):
            loop m in union_members(ft):
                if exception_member(prune(m)): hint = " (it may hold a failure such as {dt(m)}: handle that first, with `?? fallback` or `or_throw`)"
        fatal(nodes[n].pos, "cannot convert {dt(ft)} to {dt(to)}{hint}")
    if type_eq(ft, to):
        nodes[n] = nodes[a]
        return to
    nodes[n] = Node(kind = .conv, pos = nodes[n].pos, a = i32(a), aux = i32(cv), type = i32(to), flags = i32(NF_CHECKED))
    if ft == T_MATH_INT and tk == .int_ and dewy_at(nodes[n].pos): int_domain_conversion(n, to)
    to

# (Key(n): a simple enum's variant by its number, as int(Key.a) gives it, its variants numbered
# 0, 1, 2... in order; one that is not there stops the program, saying which)
enum_from_int = (n: int, et: int, a: int) -> int:
    si = int(types[prune(et)].st)
    nv = int(structs[si].nvariants)
    loop v in [0..nv):
        if variants[int(structs[si].variants) + v].value != v: fatal(nodes[n].pos, "{dt(et)}(n) needs its variants numbered 0, 1, 2... in order (some are given numbers of their own)")
    pos = nodes[n].pos
    c = bc_call("__enum_from", [a, bc_int(nv, pos), bc_str(dt(et), pos)], pos)
    check_expr(c, T_INT)
    nodes[n] = Node(kind = .conv, pos = pos, a = i32(last_checked), aux = i32(int(CV.int_)), type = i32(et), flags = i32(NF_CHECKED))
    et

# (collect_in's marks, by declaration: the pass that found it in `out` already;
# checker_call_queries.dewy keeps the passes, and asks here for room)
cin_mark: i32[]
cin_grow = (d: int): cin_mark.resize(max(d + 1, nodes.len()) + 1024)

# Library operations Dewy spells differently from the Sloppy library underneath. For these
# names, the definitions in lib/std/files.jo are Dewy's (`read_bytes` gives a value or a file
# error) and the others stay the Sloppy library's, which a Dewy program does not see. (One
# spelling per operation: the Sloppy names are not Dewy's, and nothing points from them to
# Dewy's; only the Python builtins `zip` and `enumerate` are told the Dewy way.)
dewy_surface_hints: {int: str}
dewy_surface_table = () -> {int: str}:
    if dewy_surface_hints.len() == 0:
        loop word in ["read_file", "write_file", "read_bytes", "write_bytes", "append_file", "is_dir", "mkdir", "delete_file", "delete_dir", "list_dir", "run_program", "run_shell", "file_name", "dir_name", "extension", "without_extension", "join_path", "sort_by", "sorted_by", "eprint"]:
            dewy_surface_hints[intern(word)] = ""
        dewy_surface_hints[intern("unix_time")] = "`now.nominal` is the wall clock as an `Instant`; subtract two `Instant`s for the time between them"
        dewy_surface_hints[intern("parse_date")] = "`instant(text)` for a time with an offset, `date(text)` for a date, `zoned(text)` for a local time"
        dewy_surface_hints[intern("date_text")] = "a `Date` or `Instant` prints as ISO 8601"
        dewy_surface_hints[intern("utc_offset")] = "`zoned(text zone=z).offset`"
        dewy_surface_hints[intern("zip")] = "loop over both at once, `loop x in xs and y in ys \{...}`, or pair them in a comprehension, `[loop x in xs and y in ys [x y]]`"
        dewy_surface_hints[intern("enumerate")] = "count alongside, `loop i in 0.. and x in xs \{...}`"
    dewy_surface_hints

# (for a library declaration of the name: 1 when only Dewy sees it, 2 when only Sloppy does, 0 both;
# the Sloppy library's are those of a path's text, `read_bytes(f: File n)` stays both's)
# (Dewy's cancelable spellings of these: lib/std/task_input.jo's, and files.jo's read_bytes; and
# lib/prelude/process.dewy's `exit`, which takes a code from 0 to 255)
task_surface_names: {int: bool}
dewy_surface = (name: int, decl: int) -> int:
    if task_surface_names.len() == 0:
        loop word in ["read_line", "read_stdin", "input", "input_int", "input_float", "open_file", "read_bytes", "exit"]: task_surface_names[intern(word)] = true
    if task_surface_names.has(name):
        path = files[pos_file(nodes[decl].pos)].path
        if path == lib_dir + "/std/task_input.jo" or path == lib_dir + "/std/files.jo" or path == lib_dir + "/prelude/process.dewy": return 1
        if path == lib_dir + "/core/os.jo": return 2
    if not dewy_surface_table().has(name): return 0
    if dewy_renamed(name): return 2
    if files[pos_file(nodes[decl].pos)].path == lib_dir + "/std/files.jo": return 1
    if nkids(decl) == 0: return 0
    t = int(nodes[kid(decl, 0)].a)
    if t != 0 and nodes[t].kind == .tname and name_of(int(nodes[t].name)) == "str": return 2
    0

# (is the code being checked Dewy's? the library's own code is Sloppy)
caller_dewy = () -> bool:
    m = cur_mod()
    m >= 0 and files[int(modules[m].file)].is_dewy

# (declarations collect_in left out for the caller's language, since the last call_by_name)
surface_hidden: int[]

# A Dewy call of a Python builtin the Sloppy library has (zip, enumerate): the Dewy way.
dewy_surface_check = (n: int, name: int):
    if surface_hidden.len() == 0 or not caller_dewy(): return
    # (the program's own function of that name is simply called)
    own = lookup(name)
    if own != 0 and syms[own].kind == .fns and surface_sees(own, true): return
    hint = dewy_surface_table().get(name) ?? ""
    if hint != "": fatal(nodes[n].pos, "'{name_of(name)}' is not Dewy's: {hint}")

# (checker_call_queries.dewy's collect_fns in a Dewy module: the bundled rational's exact
# members of an exact family name, when the module's imports reach it)
collect_rational = (m: int, name: int, out: *(int[])):
    if not exact_family_name(name): return
    rm = rational_module()
    if rm >= 0 and rm != m and reaches_rational(m, rm): collect_in(rm, name, 0, out)

# (by name: abs, min, max or sign; built on first use)
exact_named: bool[]
exact_family_name = (name: int) -> bool:
    if exact_named.len() == 0:
        ids = [ci(28, "abs"), ci(44, "min"), ci(45, "max"), ci(46, "sign")]
        top = 0
        loop id in ids:
            if id > top: top = id
        exact_named = fill(false, top + 1)
        loop id in ids: exact_named[id] = true
    name < exact_named.len() and exact_named[name]

# The bundled rational's module, or -1 while it is not loaded: probed again only once more
# modules are loaded. O(1) amortized.
rational_module_found = -1
rational_module_probed = 0
rational_module = () -> int:
    if rational_module_found >= 0 or modules.len() == rational_module_probed: return rational_module_found
    rational_module_probed = modules.len()
    rational_module_found = find_module(lib_dir + "/rational.dewy")
    rational_module_found

# By module, whether its imports reach the bundled rational module: 1 for good (imports only
# grow), else 2 + the import count as of which they do not (0: not asked). A walk is
# O(modules + imports), again for a module only once imports are added.
rational_reach: int[]
import_edges = 0

exact_families_changed = ():
    ml_bump_name(ci(28, "abs"))
    ml_bump_name(ci(44, "min"))
    ml_bump_name(ci(45, "max"))
    ml_bump_name(ci(46, "sign"))

# (a function of the Dewy prelude's module dm called from m, such as `rational(1 3)`: m reaches
# what dm's imports do, the bundled rational included)
prelude_reach = (m: int, dm: int):
    rm = rational_module()
    if rm < 0 or not reaches_rational(dm, rm) or rational_reach[m] == 1: return
    rational_reach[m] = 1
    exact_families_changed()

reaches_rational = (m: int, rm: int) -> bool:
    if rational_reach.len() < modules.len(): rational_reach.resize(modules.len())
    r = rational_reach[m]
    if r == 1 or r == import_edges + 2: return r == 1
    seen = fill(false, modules.len())
    found = reach_walk(m, rm, seen)
    rational_reach[m] = if found: 1 else: import_edges + 2
    found

# (a fraction passed where the module's imports do not reach the bundled rational, as to an
# instance of a generic helper: its exact members join the prelude's family for the call, as
# its imports' would. Calls of numbers alone keep the prelude's members)
exact_members_for = (decls: int[], name: int, args: int[]) -> int[]:
    rm = rational_module()
    m = cur_mod()
    if rm < 0 or m < 0 or m == rm or decls.len() == 0 or modules[m].is_prelude: return decls
    if not modules[int(nodes[decls[0]].mod)].is_prelude or not files[int(modules[m].file)].is_dewy: return decls
    loop d in decls:
        if int(nodes[d].mod) == rm: return decls
    if reaches_rational(m, rm): return decls
    loop a0 in args:
        a = unnamed(a0)
        if is_lit(a): continue
        t = 0
        if has_flag(a, NF_CHECKED): t = prune(ntype(a))
        else if nodes[a].kind == .ident:
            s = lookup(int(nodes[a].name))
            if s != 0 and syms[s].kind == .local: t = prune(int(locals[int(syms[s].ref)].type))
        if t != 0 and (bundled_rational_type(t) or bundled_word_rational_type(t)):
            out = decls
            collect_in(rm, name, 0, &out)
            return out
    decls

reach_walk = (m: int, rm: int, seen: mut bool[]) -> bool:
    if m == rm or rational_reach[m] == 1: return true
    seen[m] = true
    loop edge in modules[m].imports:
        # (the shared prelude's imports are no module's own)
        if not seen[edge.0] and not modules[edge.0].is_prelude and reach_walk(edge.0, rm, seen): return true
    false

# (collect_named, checker_call_queries.dewy: its families by name, kept while the name's
# stamp stands, with the spellings they hid)
named_first: int[]
named_families: NamedFamily[]
named_decls: int[]
named_hidden: int[]
named_grow = (name: int): named_first.resize(name * 2 + 64)

# Fold mathematical powers and floor operations before selecting their runtime
# overload. Every intermediate is checked, including exponentiation by squaring.
dewy_math_fold = (n: int, a: int, b: int, power: bool, modulo: bool) -> bool:
    if prune(ntype(a)) != T_MATH_INT: return false
    known_a, x = integer_constant(a)
    known_b, y = integer_constant(b)
    if not known_a or not known_b: return false
    value = 0
    if power:
        if y < 0: return false
        value = 1
        loop y > 0:
            if y & 1 == 1:
                if math_word_overflow(2, value, x): return false
                value *= x
            y = y >> 1
            if y > 0:
                if math_word_overflow(2, x, x): return false
                x *= x
    else:
        if y == 0: fatal(nodes[n].pos, "integer division by zero in constant expression")
        if not modulo and math_word_overflow(3, x, y): return false
        if modulo:
            if y != -1: value = x % y
            if value != 0 and (value < 0) != (y < 0): value += y
        else:
            value = x / y
            if x - value * y != 0 and (x < 0) != (y < 0): value -= 1
    nodes[n] = Node(kind = .int_lit, pos = nodes[n].pos, ival = value, type = i32(T_MATH_INT), flags = i32(NF_CHECKED))
    true

dewy_arithmetic_call = (n: int, name: int, args: int[], expected: int) -> int:
    literal_divisor = nodes[args[1]].kind == .int_lit
    # (t/°C: a unit written by name)
    q_name_a = quantity_name_syntax(args[0])
    q_name_b = quantity_name_syntax(args[1])
    checked: int[]
    loop i in 0.. and arg in args:
        hint = 0
        if i == 0 and is_quantity(expected) and is_float(quantity_base(expected)): hint = expected
        if expected != 0 and is_float(expected) and nodes[arg].kind == .float_lit: hint = expected
        else if i == 0 and expected != 0 and is_numeric(expected) and name != intern("__dewy_divide"): hint = expected
        check_expr(arg, hint)
        checked.push(last_checked)
        add_flag(last_checked, NF_CHECKED)
    a = checked[0]
    b = checked[1]
    if (ntype(a) == T_MATH_INT or ntype(b) == T_MATH_INT) and dewy_at(nodes[n].pos):
        wa = exact_math_operand(a); wb = exact_math_operand(b)
        if is_int(ntype(wa)) and is_int(ntype(wb)) and ntype(wa) != T_MATH_INT and ntype(wb) != T_MATH_INT and int_policy(ntype(wa)) == 0 and int_policy(ntype(wb)) == 0 and num_join(ntype(wa), ntype(wb)) == T_INT:
            a = wa; b = wb
            checked[0] = a; checked[1] = b
    exact_operands = (is_numeric(ntype(a)) or bundled_rational_type(ntype(a)) or bundled_bigint_type(ntype(a))) and (is_numeric(ntype(b)) or bundled_rational_type(ntype(b)) or bundled_bigint_type(ntype(b)))
    if exact_operands and not is_float(expected) and not (is_float(ntype(a)) and not is_lit(a)) and not (is_float(ntype(b)) and not is_lit(b)):
        if nodes[a].kind == .float_lit and nodes[a].sval != 0 and is_lit(a): exact_decimal(a)
        if nodes[b].kind == .float_lit and nodes[b].sval != 0 and is_lit(b): exact_decimal(b)
    if (is_quantity(ntype(a)) or is_quantity(ntype(b))) and quantity_record_operand(prune(ntype(a)), prune(ntype(b))):
        op = if name == intern("__dewy_divide"): "/" else if name == intern("__floor_div"): "//" else if name == intern("__floor_mod"): "%" else: "**"
        nodes[n] = Node(kind = .binary, pos = nodes[n].pos, a = i32(a), b = i32(b))
        r = op_overload(n, op)
        if r != 0: return r
        fatal(nodes[n].pos, "operator {op} is not defined for {dt(ntype(a))} and {dt(ntype(b))}{calendar_period_why(a, b)}")
    if is_quantity(ntype(a)) or is_quantity(ntype(b)):
        quantity_left_literal = q_name_a
        quantity_right_literal = q_name_b
        return quantity_arithmetic(n, name, a, b, expected)
    if name == intern("__dewy_divide"):
        ta = prune(ntype(a))
        tb = prune(ntype(b))
        pos = nodes[n].pos
        if (is_int(ta) or bundled_bigint_type(ta)) and (is_int(tb) or bundled_bigint_type(tb)):
            known_b, divisor = integer_constant(b)
            if known_b and divisor == 0: fatal(nodes[b].pos, "division by zero: the divisor of `/` is the constant 0")
            known_a, dividend = integer_constant(a)
            minimum = -9223372036854775807 - 1
            if known_a and known_b and dividend != minimum and divisor != minimum and (dividend >= 0 or types[ta].sign) and (divisor >= 0 or types[tb].sign):
                nodes[n] = nodes[rational_constant(dividend, divisor, pos, shown = 2)]
                t = check_expr(n, expected)
                rational_constants[n] = rational_constant_parts(dividend, divisor)
                rational_shown[n] = 2
                return t
            # Resolve exact arithmetic only after the operand types are known;
            # ordinary floating division does not load either exact library.
            ensure_bundled_import("rational.dewy", "$dewy_rational", pos)
            callee = bc_field(bc_ident("$dewy_rational", pos), "_fraction", pos)
            nodes[n] = Node(kind = .call, pos = pos, a = i32(callee))
            set_list(n, checked)
            # (a nonzero divisor is the caller's obligation, as an integer
            # division's: the fraction's only failure)
            if dir_panics_demanded(): fact_divisors[n] = 1
        else:
            nodes[n] = Node(kind = .binary, pos = pos, op = i32(int(Tok.slash)), a = i32(a), b = i32(b))
        return check_expr(n, expected)
    modulo = name == intern("__floor_mod")
    power = name == intern("__dewy_power")
    # (an integer base with a negative constant exponent is a rational: 2^(-2) is 1/(2^2))
    if power and (is_int(prune(ntype(a))) or bundled_bigint_type(prune(ntype(a)))):
        known, k = integer_constant(b)
        if known and k < 0 and k != -9223372036854775807 - 1 and types[representation_type(ntype(b))].sign:
            pos = nodes[n].pos
            exponent = mk(.int_lit, pos)
            nodes[exponent].ival = -k
            one = mk(.int_lit, pos)
            nodes[one].ival = 1
            nodes[n] = nodes[bc_call("__dewy_divide", [one, bc_call("__dewy_power", [a, exponent], pos)], pos)]
            return check_expr(n, expected)
    if is_struct_like(ntype(a)) or is_struct_like(ntype(b)):
        op = if power: "**" else if modulo: "%" else: "//"
        nodes[n] = Node(kind = .binary, pos = nodes[n].pos, a = i32(a), b = i32(b))
        result = op_overload(n, op)
        if result == 0:
            label = if power: "^" else: op
            fatal(nodes[n].pos, "operator {label} is not defined for {dt(ntype(a))} and {dt(ntype(b))}")
        return result
    if is_numeric(ntype(a)) and is_numeric(ntype(b)):
        if power: finalize_literal(a)
        else: join_types(a, b, nodes[n].pos)
        if dewy_math_fold(n, a, b, power, modulo): return T_MATH_INT
        # A word exponent must not select the wrapping word-base overload.
        if power and prune(ntype(a)) == T_MATH_INT and is_int(ntype(b)): coerce(b, T_MATH_INT)
    # (`//` and `%` are integer and exact operations; floats have no floor quotient)
    if not power and (is_float(ntype(a)) or is_float(ntype(b))):
        ft = if is_float(ntype(a)): ntype(a) else: ntype(b)
        if modulo: fatal(nodes[n].pos, "`%` is not defined for {dt(ft)}: the remainder is an integer and exact-number operation")
        fatal(nodes[n].pos, "`//` is not defined for {dt(ft)}: floor division is an integer and exact-number operation; `(a / b).floor()` rounds a float quotient down")
    # Only built-in arithmetic may replace a literal divisor with a shift or
    # mask. Custom protocols receive the original operand, including 1 or 2^k.
    helper = name
    policy = int_policy(ntype(a))
    if power and ntype(a) == T_INT and dewy_at(nodes[n].pos):
        known, exponent = integer_constant(b)
        if not known or exponent >= 1048576:
            coerce(a, T_MATH_INT)
            coerce(b, T_MATH_INT)
    if power and exact_type(ntype(a), nodes[n].pos) and is_int(ntype(b)):
        t = prune(ntype(a))
        if is_lit(b) and ntype(b) == T_MATH_INT:
            (known, exponent) = integer_constant(b)
            if known: coerce(b, T_INT)
        nodes[n] = Node(kind = .binary, pos = nodes[n].pos, a = i32(a), b = i32(b), type = i32(t), op = i32(int(Tok.starstar)), flags = i32(NF_CHECKED))
        return exact_int_result(n)
    if policy != 0 or not power and exact_type(ntype(a), nodes[n].pos):
        if power: helper = intern("__dewy_policy_power")
        else:
            t = prune(ntype(a))
            coerce(b, t)
            if modulo and policy == 0 and exact_potential(a):
                known_modulus, modulus = integer_constant(b)
                if known_modulus and modulus > 0 and modulus & (modulus - 1) != 0: runtime_demand("__exact_i128_mod_pos")
            nodes[n] = Node(kind = .binary, pos = nodes[n].pos, a = i32(a), b = i32(b), type = i32(t), op = i32(int(if modulo: Tok.percent else: Tok.slash)), aux2 = -1, flags = i32(NF_CHECKED))
            return if policy == 0: exact_int_result(n) else: t
    divisor = nodes[b].ival
    if not power and literal_divisor and nodes[b].kind == .int_lit and divisor > 0 and not has_flag(b, NF_U64) and (divisor & (divisor - 1)) == 0:
        if modulo:
            helper = intern("__floor_mod_pow2")
            nodes[b].ival = divisor - 1
        else:
            helper = intern("__floor_div_pow2")
            shift = 0
            loop divisor > 1:
                divisor = divisor >> 1
                shift += 1
            nodes[b].ival = shift
            nodes[b].type = i32(T_INT) # generated shift count, not the divisor
    if nodes[n].a != 0: nodes[int(nodes[n].a)].name = i32(helper)
    declarations: int[]
    collect_fns(helper, &declarations)
    result = resolve_fn_call(n, helper, declarations, checked, expected)
    # Internal scalar policy: retain the builtin operation's captured actuals.
    # Custom operators and the proven positive power-of-two path are separate.
    if dir_panics_demanded() and not power and helper == name and is_int(ntype(a)) and is_int(ntype(b)):
        fact_divisors[n] = if modulo: 2 else: 1
    result

# (literal numbers and arithmetic on them: their type comes from the call)
number_literal_tree = (n: int) -> bool:
    k = nodes[n].kind
    if k == .int_lit or k == .float_lit: return true
    if k == .unary: return number_literal_tree(int(nodes[n].a))
    if k == .binary: return number_literal_tree(int(nodes[n].a)) and number_literal_tree(int(nodes[n].b))
    false

# (a constant index's position)
dewy_position_known = (b: int, pos: int) -> (bool, int):
    if nodes[b].kind == .int_lit and not has_flag(b, NF_U64): return (true, nodes[b].ival)
    if nodes[b].kind == .ident:
        s = lookup(int(nodes[b].name))
        if s != 0:
            init = binding_const_init(syms[s].kind, int(syms[s].ref), pos)
            if init != 0 and nodes[init].kind == .int_lit and not has_flag(init, NF_U64): return (true, nodes[init].ival)
    (false, 0)

# `pair[i]` of a `[int64 string]`: a constant position reads that position's
# element, with its own type; any other index the union of the element types,
# from a fixed array of them, so its bounds are proven as an array index's are.
dewy_position_index = (n: int, bt: int, expected: int) -> int:
    pos = nodes[n].pos
    b = int(nodes[n].b)
    count = int(types[bt].nargs)
    if b == 0 or nkids(n) != 1 or nodes[b].kind == .range or nodes[b].kind == .namedarg: fatal(pos, "an array with a type per position takes one index (`pair[0]`); unpack it to take its parts (`let [a b] = pair`)")
    known, at = dewy_position_known(b, pos)
    if known:
        if at < 0 or at >= count: fatal(nodes[b].pos, "index {at} is outside this {dt(bt)}: its positions are 0 to {count - 1}")
        nodes[n].kind = .field
        nodes[n].aux = -2
        nodes[n].ival = at
        nodes[n].b = 0
        set_list(n, [])
        return check_expr(n, expected)
    members: int[]
    loop i in [0..count): members.push(targ(bt, i))
    source = "$positions{n}"
    elements = "$position_values{n}"
    reads: int[]
    loop i in [0..count):
        f = mk(.field, pos)
        nodes[f].a = i32(bc_ident(source, pos))
        nodes[f].aux = -2
        nodes[f].ival = i
        reads.push(f)
    values = mk(.array, pos)
    set_list(values, reads)
    shape = mk(.tname, pos)
    nodes[shape].aux = -7
    nodes[shape].ival = mk_fixed(mk_union(members), count)
    declared = bc_let(elements, values, pos)
    nodes[declared].a = i32(shape)
    read = mk(.index, pos)
    nodes[read].a = i32(bc_ident(elements, pos))
    nodes[read].b = i32(b)
    set_list(read, [b])
    nodes[n] = nodes[bc_block([bc_let(source, int(nodes[n].a), pos), declared, bc_stmt(read, pos)], pos)]
    check_expr(n, expected)

# literal numbers with a decimal literal among them (`2.5`, `-2.5`, `1.5*3`):
# exact until a float context makes them floats
decimal_literal_tree = (n: int) -> bool:
    k = nodes[n].kind
    if k == .float_lit: return nodes[n].sval != 0
    if k == .unary: return decimal_literal_tree(int(nodes[n].a))
    if k == .binary: return number_literal_tree(n) and (decimal_literal_tree(int(nodes[n].a)) or decimal_literal_tree(int(nodes[n].b)))
    false

# (the library functions Dewy calls with physical quantities: dewy_quantity_call)
quantity_call_names: int[]
dewy_quantity_name = (name: int) -> bool:
    if quantity_call_names.len() == 0: quantity_call_names = [intern("sleep"), intern("sin"), intern("cos"), intern("tan")]
    name == quantity_call_names[0] or name == quantity_call_names[1] or name == quantity_call_names[2] or name == quantity_call_names[3]

# (a constant name, interned the first time it is asked for, as `intern` would: its id kept by slot)
ci_ids: int[]
ci = (slot: int, s: str) -> int:
    if slot < ci_ids.len() and ci_ids[slot] != 0: return ci_ids[slot]
    if ci_ids.len() <= slot: ci_ids.resize(slot + 64)
    id = intern(s)
    ci_ids[slot] = id
    id

# `p"a/b.txt"` (a `p` written against its quote) is a path literal in Dewy: its `p` is the
# library's, whatever the program binds to p (`let p = r` below it). The library module that
# declares it, or -1 for any other call. O(1).
path_literal_module = (n: int, callee: int, args: int[]) -> int:
    if int(nodes[callee].name) != ci(43, "p") or args.len() != 1 or not dewy_at(nodes[n].pos): return -1
    src = files[pos_file(nodes[callee].pos)].src
    off = pos_off(nodes[callee].pos) + 1
    if off >= len(src) or (src[off] != '"' and src[off] != '\''): return -1
    s = prelude.get(int(nodes[callee].name)) ?? dewy_prelude_lookup(int(nodes[callee].name))
    if s == 0 or syms[s].decl == 0: return -1
    int(nodes[int(syms[s].decl)].mod)

# call_by_name's services (checker_expr.dewy runs it). Each answers a type, or -1 to go on.
# The core library's rewrites by name: completion, searches, saturating get, Dewy arithmetic,
# quantities and abs.
# Intrinsic ii, or -2 for the implementation language's `assert` written in Dewy (Dewy's
# assertions are directives). O(1).
# An array intrinsic ii (len, push, ...) of an array, text or fixed-size receiver.
# The name's symbol s when it is not a function family: a variable holding a function, a
# constructor, a conversion, the library's take/relocate/release; a builtin's functions
# are collected into decls. -1 to go on to the families.
# The families a name calls: a method's receiver modules, index operators' protocols, and
# Dewy's to_int parsers; hidden Dewy names are reported. -1 to go on and pick from decls.
# No function of the name: an intrinsic, else the diagnostics. Never returns otherwise.
call_name_unknown = (n: int, name: int, mod_scope: int, args: int[], expected: int, ufcs: bool, ii: int, hidden_assert: bool) -> int:
    if ii >= 0 and not intrinsics[ii].arr:
        if ide_on: ide_builtin_ref(n, name)
        return check_intrinsic(n, int(intrinsics[ii].id), args, expected)
    if ii >= 0 and intrinsics[ii].arr and args.len() > 0: fatal(nodes[n].pos, "'{name_of(name)}' expects an array or string, found {dt(ntype(args[0]))}")
    if ufcs:
        t0 = prune(ntype(args[0]))
        # (`lookup(id).scaled(2)`, where only the value's own module has `scaled`)
        if caller_dewy() and forwards_exceptions(t0): return forward_call(n, name, args, expected)
        # (step.1() for a tuple whose element 1 is a function: that element, called)
        nm0 = name_of(name)
        if types[t0].kind == .tuple and len(nm0) > 0 and is_digit(nm0[0]):
            if let k = to_int(nm0):
                if k < int(types[t0].nargs) and tkind(targ(t0, k)) == .fn_:
                    el = mk(.field, nodes[n].pos)
                    nodes[el].a = i32(args[0])
                    nodes[el].aux = -2
                    nodes[el].ival = k
                    check_expr(el, 0)
                    add_flag(el, NF_CHECKED)
                    return value_call(n, el, args[1..])
        cands = fn_names_for(t0)
        if types[t0].kind == .struct_:
            si = int(types[t0].st)
            loop i in [0..int(structs[si].nfields)): cands.push(int(fields[int(structs[si].fields) + i].name))
        if is_map_type(t0) and len(map_habit_name(name_of(name))) > 0: fatal(nodes[n].pos, "no field or function '{name_of(name)}' for type {dt(t0)} (use {map_habit_name(name_of(name))})")
        # (m.groups(): a field, called as a method)
        if types[t0].kind == .struct_:
            si = int(types[t0].st)
            loop i in [0..int(structs[si].nfields)):
                if int(fields[int(structs[si].fields) + i].name) == name: fatal(nodes[n].pos, "'{name_of(name)}' is a field, not a function: `x.{name_of(name)}`, without ()")
        never_cascade(nodes[n].pos, t0)
        tsh = dt(ntype(args[0]))
        # (xs = [] with nothing in it yet: its type is not known, and its name for it means nothing)
        if has_var(prune(ntype(args[0]))):
            tsh = "this value (its type is not known yet)"
            if types[t0].kind == .array: tsh = "an array"
            fatal(nodes[n].pos, "no field or function '{name_of(name)}' for {tsh}{suggestion(name_of(name), surface_names(cands, nodes[n].pos), t0)}")
        fatal(nodes[n].pos, "no field or function '{name_of(name)}' for type {tsh}{suggestion(name_of(name), surface_names(cands, nodes[n].pos), t0)}")
    # a variable of the same name hides the function or type (m.x(...): m's x)
    qualified = mod_scope >= 0 and not ufcs
    hs = if qualified: module_lookup(mod_scope, name) else: lookup(name)
    if hs != 0 and syms[hs].kind == .local:
        if starts_with(name_of(name), "$index_end"): fatal(nodes[n].pos, "end is the last index inside brackets; it cannot be called")
        fatal(nodes[n].pos, "'{name_of(name)}' is a variable of type {dt(int(locals[int(syms[hs].ref)].type))} here (it hides the function or type of that name){juxt_string_call_hint(n)}; rename the variable")
    if hs != 0 and syms[hs].kind == .global:
        g = int(syms[hs].ref)
        ensure_global(g, nodes[n].pos)
        fatal(nodes[n].pos, "'{name_of(name)}' is a variable of type {dt(int(globals[g].type))}, not a function{juxt_string_call_hint(n)}")
    # (m.Reading(n): the alias as its module has it)
    ts = hs
    # (Msg(Move(3)), Msg a union: its members are Msgs as they are)
    if ts != 0 and syms[ts].kind == .alias_ and nkids2(int(syms[ts].ref)) == 0:
        at = resolve_alias(int(syms[ts].ref), [], nodes[n].pos)
        if is_int(at): return conversion(n, at, args)
        # (Reading(n), Reading a refined alias: the conversion `n as Reading`, its
        # refinement an obligation; Color('red'), Color a union of string literals:
        # likewise `'red' as Color`)
        if str_set_of(at) != 0 and dewy_at(nodes[n].pos) and args.len() == 1 and nodes[args[0]].kind != .namedarg:
            return str_set_read(n, args[0], at, expected)
        if (tkind(at) == .refined) and dewy_at(nodes[n].pos) and args.len() == 1 and nodes[args[0]].kind != .namedarg:
            target = mk(.tname, nodes[n].pos)
            nodes[target].name = i32(name)
            if qualified and lookup(name) != ts:
                nodes[target].aux = -7
                nodes[target].ival = nominal_family(at)
            nodes[n] = Node(kind = .cast, pos = nodes[n].pos, a = i32(args[0]), b = i32(target))
            return check_expr(n, expected)
        if is_union(at):
            ms: str[]
            loop m in union_members(at): ms.push(dt(m))
            un = name_of(name)
            fatal(nodes[n].pos, "'{un}' is a union ({join(ms, " | ")}): a {ms[0]} is a {un} as it is, with nothing around it: {jd(nodes[n].pos, "`m: {un} = {ms[0]}(...)`", "`let m:{un} = {ms[0]}[...]`")}")
    if hidden_assert: fatal(nodes[n].pos, "unknown function 'assert' (assertions are directives: `$assert condition` must be proven while compiling, `$runtime_assert condition` checks while running, and `$expect condition` states what a `$test` checks)")
    all = visible_names()
    loop it in intrinsics:
        if it.id != .assert or not dewy_at(nodes[n].pos): all.push(intern(it.name))
    # (physics3d.world(): the names of that module, World among them)
    if mod_scope >= 0 and not ufcs and not modules[mod_scope].is_prelude:
        all = []
        loop k, v in modules[mod_scope].names: all.push(k)
    # (import net, then tcp_connect(...): the module's, written with its name; not a
    # name this file sees, nor one of the module it is written with)
    if ts == 0:
        loop mi in [0..modules.len()):
            if modules[mi].is_prelude or mi == mod_scope or mi == cur_mod() or modules[mi].names.get(name) == none: continue
            mn = name_of(int(modules[mi].name))
            ms = lookup(intern(mn))
            if ms != 0 and syms[ms].kind == .module and int(syms[ms].ref) == mi: fatal(nodes[n].pos, "unknown function '{name_of(name)}' (it is {mn}'s: `{mn}.{name_of(name)}(...)`)")
        uh = unused_file_hint(name)
        if len(uh) > 0: fatal(nodes[n].pos, "unknown function '{name_of(name)}'{uh}")
    # (Python's f-strings: f"hello {name}")
    if name_of(name) == "f" and not ufcs and args.len() == 1 and nodes[args[0]].kind == .str_lit and dewy_at(nodes[n].pos):
        fatal(nodes[n].pos, "unknown function 'f' (drop the f: every string interpolates, as in `\"hello \{name}\"`)")
    fatal(nodes[n].pos, "unknown function '{name_of(name)}'{private_hint(name)}{suggestion(name_of(name), surface_names(all, nodes[n].pos))}")
    -1

id_rgb = intern("rgb")
id_rgba = intern("rgba")
id_hsv = intern("hsv")
id_draw = intern("draw")
id_update = intern("update")

coerce_hint = ""     # (said after a type mismatch, by what asked for the type)

# `as` and `??` bind looser and tighter than the operators beside them (docs/LANGUAGE.md's operator
# table): `ok and b[0..4) as string` converts all of `ok and b[0..4)`, and `m ?? x >? 3` is
# `(m ?? x) >? 3`. Nothing is recorded while checking: when a type error is reported, regroup_note
# looks through the nodes for an `as`, or a comparison, `and` or `or`, written around the node at
# fault so that the other grouping would have held it, and says what to parenthesize.

fn_used: {int: bool}            # the program's functions called or used as a value (by decl)
drew_in: {int: bool}            # (functions, by instance, that have drawn something so far)
draw_to_at: {int: int}          # (draw's first draw_to, by instance)
back_to_screen: {int: bool}     # (draw calls draw_to_screen)

DRAWING_FNS = ["circle", "rect", "line", "text", "text_centered", "text_wrapped", "sprite", "polygon", "polyline",
    "circle_gradient", "rect_gradient", "quad_gradient", "triangle", "arc", "draw_mesh", "draw_tilemap", "draw_anim",
    "draw_model", "draw_sprite", "image_draw"]

# drawing in update, clearing after drawing, sleeping in a frame: done where it shows nothing,
# covers what was drawn, or stops the game
frame_call_check = (n: int, decl: int):
    if cx < 0: return
    ci = int(ctxs[cx].inst)
    if ci <= 0 or fns[ci].decl == 0: return
    fd = int(fns[ci].decl)
    if not modules[int(nodes[fd].mod)].is_main: return
    # (a type's method named update or draw is not the game's)
    here = if dewy_is_method(fd): "" else: name_of(int(nodes[fd].name))
    fnm = name_of(int(nodes[decl].name))
    drawing = false
    loop d in DRAWING_FNS:
        if d == fnm: drawing = true
    if drawing:
        if here == "update":
            mm = int(nodes[fd].mod)
            if modules[mm].names.get(intern("draw")) != none: warn(nodes[n].pos, "{fnm} draws, and update is for changing things: what it draws here is covered when draw clears the screen; draw it in `draw`")
            else: warn(nodes[n].pos, "{fnm} draws, and update is for changing things: drawing goes in a function of its own, `draw = ():`, which the game calls each frame after update")
        drew_in[ci] = true
    # (into a render target, then the screen: clearing that is the start of another picture)
    if fnm == "draw_to" or fnm == "draw_to_screen" or starts_with(fnm, "begin_") or fnm == "camera3d": drew_in.remove(ci)
    # (draw_to(rt) in draw and never draw_to_screen(): the rest of the frame goes into rt)
    if here == "draw" and fnm == "draw_to" and not draw_to_at.has(ci): draw_to_at[ci] = nodes[n].pos
    if here == "draw" and fnm == "draw_to_screen": back_to_screen[ci] = true
    if fnm == "clear" and drew_in.get(ci) != none and here == "draw": warn(nodes[n].pos, "clear covers everything drawn before it in this frame: clear the screen first, at the top of draw")
    if (fnm == "input" or fnm == "input_int" or fnm == "input_float" or fnm == "read_line" and nkids(decl) == 0) and (here == "update" or here == "draw"):
        warn(nodes[n].pos, "{fnm} waits for a line typed in the terminal, and the game stops while it waits: in the window, `hud_text_field(rect, name)` is a box to type in (or `text_input()`, what was typed this frame)")
    if fnm == "sleep" and (here == "update" or here == "draw"): warn(nodes[n].pos, "sleep stops the whole game, every frame: to wait, count down a timer (`wait -= dt`, act when it is below 0), or `every(1, 2.0)`")

fmt_plain: {int: bool} = {}       # (__fmt_fields nodes that format the fields, not the program's str)

# (an __fmt_fields node's aux2: 1 inside a container, FMT_DEWY in Dewy's literal syntax)
const FMT_DEWY = 2

# the program's `str` for type t (str = (b: Big) -> str, beside the type), as an instance, or 0
program_str_fn = (t0: int, pos: int) -> int:
    t = prune(t0)
    if tkind(t) != .struct_ and tkind(t) != .enum_: return 0
    d0 = int(structs[int(types[t].st)].decl)
    if d0 == 0 or modules[int(nodes[d0].mod)].is_prelude: return 0
    fd: int[]
    collect_module(int(nodes[d0].mod), intern("str"), &fd)
    loop d in fd:
        if decl_in_prelude(d) or nkids(d) != 1: continue
        sig = fn_sig(d)
        if sig.generic or sig.params.len() != 1 or not type_eq(prune(sig.params[0]), t): continue
        return get_fn_inst(d, [], pos)
    0

# a library function called as another language's of the same name is (p5's line(x1, y1, x2,
# y2), fill(r, g, b) and push(); atan(y, x)): what it is here, before its overloads are tried
# checker_call_queries.dewy's habit_call_check leaves the host the names and argument
# counts a habit may have.
habit_rest = (n: int, name: int, args: int[]):
    nm = name_of(name)
    # (the program's own function of the name: its call)
    own: int[]
    collect_fns(name, &own)
    loop d in own:
        if not decl_in_prelude(d): return
    na = args.len()
    num = (a: int) -> bool:
        k = nodes[unnamed(a)].kind
        k == .int_lit or k == .float_lit or (k == .unary and (nodes[int(nodes[unnamed(a)].a)].kind == .int_lit or nodes[int(nodes[unnamed(a)].a)].kind == .float_lit))
    pos = nodes[n].pos
    if nm == "line" and na >= 4 and num(args[0]) and num(args[1]): fatal(pos, "line takes two points: `line(vec2(x1, y1), vec2(x2, y2), width, color)`")
    if nm == "text" and na >= 3 and num(args[1]) and num(args[2]): fatal(pos, "where text goes is one vec2: `text(s, vec2(x, y), size, color)`")
    if nm == "clear" and na == 1 and nodes[unnamed(args[0])].kind == .tuple: fatal(pos, "clear takes a color: `clear(rgb(0.1, 0.1, 0.1))` (each from 0 to 1)")
    if nm == "fill" and na >= 3 and num(args[0]) and num(args[1]) and num(args[2]): fatal(pos, "there is no fill color: each shape takes its color, `circle(pos, r, rgb(1, 0, 0))` (fill(x, n) makes an array of n copies of x)")
    if nm == "push" and na == 0: fatal(pos, "push() here is push_transform() (and pop() is pop_transform()); xs.push(x) adds to an array")
    if nm == "pop" and na == 0: fatal(pos, "pop() here is pop_transform(), after push_transform(); xs.pop() takes from an array")
    if nm == "map" and na == 5: fatal(pos, "the range a..b moved to c..d is `remap(x, a, b, c, d)`; map(xs, f) is f of each element")
    if nm == "atan" and na == 2: fatal(pos, "the angle of (x, y) is `atan2(y, x)`; atan takes one number")
    if nm == "random" and na == 1:
        if nodes[unnamed(args[0])].kind == .array: fatal(pos, "a random element is `random_item(xs)`")
        if num(args[0]): fatal(pos, "random takes where it starts and ends: `random(0, 10)` (a whole number: `random_int(0, 10)`)")

# draw(prog, quad, Other(...)) where prog = make_shader(shader(vs, fs)) takes U: a Shader does not
# carry its uniforms' type, so the one its functions take is found where the global is made
shader_draw_check = (decl: int, args: int[]):
    fnm = name_of(int(nodes[decl].name))
    if fnm != "draw" and not starts_with(fnm, "draw_instanced") and not starts_with(fnm, "draw_indirect"): return
    if args.len() < 3 or args[0] == 0: return
    a0 = unnamed(args[0])
    if nodes[a0].kind != .ident or nodes[a0].aux != i32(int(SK.global)) or nodes[a0].type == 0 or dt(ntype(a0)) != "Shader": return
    g = int(nodes[a0].sym)
    if g <= 0 or globals[g].decl == 0: return
    ut = shader_uniforms_in(int(nodes[int(globals[g].decl)].b))
    if ut == 0: return
    loop i in [0..min(args.len(), nkids(decl))):
        if name_of(int(nodes[kid(decl, i)].name)) != "params" or args[i] == 0: continue
        a = unnamed(args[i])
        if nodes[a].type == 0 or type_eq(prune(ntype(a)), prune(ut)): return
        gn = name_of(int(globals[g].name))
        fatal(nodes[a].pos, "{gn}'s shader functions take {dt(ut)} as their uniforms, and this is {dt(ntype(a))}: give it a {dt(ut)}")

# the uniforms type of the shader functions named in e (make_shader(shader(vs, fs))), or 0
shader_uniforms_in = (e: int) -> int:
    if e == 0: return 0
    if nodes[e].kind == .fnref:
        f = int(nodes[e].sym)
        if f > 0 and fns[f].ptypes.len() == 2 and type_eq(int(fns[f].ret), T_VEC4): return fns[f].ptypes[1]
        return 0
    if nodes[e].kind == .lambda or nodes[e].kind == .fn_: return 0
    r = shader_uniforms_in(int(nodes[e].a))
    if r != 0: return r
    loop i in [0..nkids(e)):
        r = shader_uniforms_in(kid(e, i))
        if r != 0: return r
    0

# rotation_y(45): an angle in degrees given where radians go
angle_check = (decl: int, args: int[]):
    fnm = name_of(int(nodes[decl].name))
    loop i in [0..min(args.len(), nkids(decl))):
        a = args[i]
        if a == 0 or not has_flag(a, NF_LITERAL): continue
        txt = ""
        v = 0.0
        if nodes[a].kind == .int_lit:
            v = f64(nodes[a].ival)
            txt = "{nodes[a].ival}"
        else if nodes[a].kind == .float_lit:
            v = nodes[a].fval
            txt = "{v}"
        else: continue
        if abs(v) <= 6.3: continue
        pn = name_of(int(nodes[kid(decl, i)].name))
        if pn == "angle" or pn == "yaw" or pn == "pitch" or pn == "roll" or (pn == "a" and (starts_with(fnm, "rotation") or starts_with(fnm, "quat_"))):
            warn(nodes[a].pos, "{txt} radians is more than a whole turn: angles are in radians (a turn is TAU, 6.28); `{txt}deg` is {txt} degrees")

# x.f where x is a union whose members are all structs with a field f of one type: n becomes
# `let u = x; if u is A: u.f else ...` (x itself when it is a variable or field); -1 if not
# Common-field lowering retains its source route for witnesses and stable keys.
# Indexed only for these generated blocks; no extra whole-program traversal.
union_field_sources: {int: (int, int)} = {}
union_field = (n: int, ut: int, fname: int) -> int:
    ms = union_members(ut)
    ft = 0
    loop m in ms:
        pm = prune(m)
        if types[pm].kind != .struct_: return -1
        si = int(types[pm].st)
        check_struct_fields(si)
        found = 0
        loop i in [0..int(structs[si].nfields)):
            f = int(structs[si].fields) + i
            if int(fields[f].name) == fname: found = int(fields[f].type)
        if found == 0: return -1
        if ft == 0: ft = found
        else if not type_eq(ft, found): return -1
    a = int(nodes[n].a)
    pos = nodes[n].pos
    place = nodes[a].kind == .ident or (nodes[a].kind == .field and len(path_key(a)) > 0)
    un = "__uf{bc_count}"
    bc_count += 1
    chain = 0
    j = ms.len() - 1
    loop j >= 0:
        base = 0
        if place: base = ud_path(a)
        else: base = bc_ident(un, pos)
        body = bc_block([bc_stmt(bc_field(base, name_of(fname), pos), pos)], pos)
        if chain == 0: chain = body
        else:
            it = mk(.istype, pos)
            if place: nodes[it].a = i32(ud_path(a))
            else: nodes[it].a = i32(bc_ident(un, pos))
            ty = mk(.tname, pos)
            nodes[ty].aux = -7
            nodes[ty].ival = ms[j]
            nodes[it].b = i32(ty)
            f = mk(.if_, pos)
            nodes[f].a = i32(it)
            nodes[f].b = i32(body)
            if nodes[chain].kind == .block: nodes[f].c = i32(chain)
            else: nodes[f].c = i32(bc_block([chain], pos))
            chain = f
        j -= 1
    blk = 0
    if place: blk = bc_block([chain], pos)
    else: blk = bc_block([bc_let(un, a, pos), chain], pos)
    union_field_sources[n] = (a, fname)
    nodes[n] = nodes[blk]
    n

# for an enum's missing variant: the one with the name other places use (Key.esc: escape), the
# nearest spelling, or (keys) how they are named
KEY_NAMES = ["esc", "escape", "return", "enter", "spacebar", "space", "del", "delete", "ins", "insert", "pgup", "page_up",
    "pageup", "page_up", "pgdn", "page_down", "pagedown", "page_down", "control", "ctrl", "lctrl", "ctrl", "rctrl", "ctrl",
    "left_ctrl", "ctrl", "right_ctrl", "ctrl", "lshift", "shift", "rshift", "shift", "left_shift", "shift", "right_shift", "shift",
    "lalt", "alt", "ralt", "alt", "option", "alt", "cmd", "super", "command", "super", "meta", "super", "win", "super", "windows", "super",
    "left_arrow", "left", "right_arrow", "right", "up_arrow", "up", "down_arrow", "down", "arrow_left", "left", "arrow_right", "right",
    "arrow_up", "up", "arrow_down", "down", "plus", "equals", "equal", "equals", "dash", "minus", "hyphen", "minus", "dot", "period",
    "apostrophe", "quote", "backquote", "grave", "backtick", "grave", "tilde", "grave", "open_bracket", "lbracket", "close_bracket", "rbracket",
    "zero", "n0", "one", "n1", "two", "n2", "three", "n3", "four", "n4", "five", "n5", "six", "n6", "seven", "n7", "eight", "n8", "nine", "n9",
    "numpad0", "kp0", "numpad1", "kp1", "numpad2", "kp2", "numpad3", "kp3", "numpad4", "kp4", "numpad5", "kp5", "numpad6", "kp6",
    "numpad7", "kp7", "numpad8", "kp8", "numpad9", "kp9", "keypad0", "kp0", "keypad1", "kp1", "keypad2", "kp2", "keypad3", "kp3",
    "keypad4", "kp4", "keypad5", "kp5", "keypad6", "kp6", "keypad7", "kp7", "keypad8", "kp8", "keypad9", "kp9", "kp_0", "kp0",
    "kp_1", "kp1", "kp_2", "kp2", "kp_3", "kp3", "kp_4", "kp4", "kp_5", "kp5", "kp_6", "kp6", "kp_7", "kp7", "kp_8", "kp8", "kp_9", "kp9",
    "kp_enter", "enter", "numpad_enter", "enter", "kp_add", "kp_plus", "kp_subtract", "kp_minus", "kp_multiply", "kp_star", "kp_divide", "kp_slash",
    "kp_decimal", "kp_period", "kp_dot", "kp_period"]

# (the prelude's Console, the type of `console`; 0 before the library is loaded)
console_type_id = -1
console_type = () -> int:
    if console_type_id >= 0: return console_type_id
    s = prelude.get(intern("Console")) ?? 0
    if s == 0 or syms[s].kind != .struct_: return 0
    console_type_id = get_struct_inst(int(syms[s].decl), [])
    console_type_id

# Generated collector arguments retain their original syntax for contextual
# overload selection. The expression flag demands one indexed callback only.
collection_contributions: {int: bool} = {}
collection_check = (n: int, expected: int) -> int:
    if not collection_contributions.has(n): return -1
    pack = collection_contributions[n]
    collection_contributions.remove(n)
    clear_flag(n, NF_CABI)
    t = check_expr(n, expected)
    if pack: collection_array(n, t) else: collection_value(n, t)

# A collector's direct contribution forwards cancellation, never storing it as
# an element. Indexed type membership is demand-only; O(type members + rewrite).
collection_value = (n: int, t: int) -> int:
    if not dewy_at(nodes[n].pos): return t
    if not is_union(t) and tkind(t) != .opt and tkind(t) != .struct_: return t
    canceled = int(syms[universe[intern("Canceled")]].ref)
    members = value_members(t)
    if not members.contains(canceled): return t
    pos = nodes[n].pos
    if dir_explicit_cancellation(pos): cancel_reject(n, false, "this collector")
    inner = nodes.len()
    nodes.push(nodes[n])
    add_flag(inner, NF_CHECKED)
    name = "$collect{n}"
    ret = mk(.return_, pos)
    or_throw_returns[pos] = true
    nodes[ret].a = i32(bc_ident(name, pos))
    stmts = [bc_let(name, inner, pos)]
    if members.len() == 1: stmts.push(ret)
    else:
        condition = mk(.istype, pos)
        nodes[condition].a = i32(bc_ident(name, pos))
        nodes[condition].b = i32(type_node_of(canceled, pos))
        branch = mk(.if_, pos)
        nodes[branch].a = i32(condition)
        nodes[branch].b = i32(bc_block([ret], pos))
        add_flag(branch, NF_STMT)
        stmts.push(branch)
        stmts.push(bc_stmt(bc_ident(name, pos), pos))
    nodes[n] = nodes[bc_block(stmts, pos)]
    check_expr(n, 0)

# A spread or parallel collector drains the retained array contributions before
# exposing its result. O(element-type members) checking; O(elements) at runtime,
# only for an element type that includes Canceled.
collection_array = (n: int, t0: int) -> int:
    t = prune(t0)
    if not dewy_at(nodes[n].pos): return t0
    kind = tkind(t)
    set_source = kind == .struct_ and is_dewy_set_type(t)
    if kind != .array and kind != .fixed and not set_source: return t0
    elem = if set_source: struct_targ(int(types[t].st), 0) else: int(types[t].elem)
    if not is_union(elem) and tkind(elem) != .opt and tkind(elem) != .struct_: return t0
    canceled = int(syms[universe[intern("Canceled")]].ref)
    members = value_members(elem)
    if not members.contains(canceled): return t0
    if dir_explicit_cancellation(nodes[n].pos): cancel_reject(n, false, "this collector")
    # Normalize only a demanded failure-bearing spread, preserving ordinary
    # fixed-array and set contextual typing on the common path.
    if kind == .fixed: coerce(n, mk_array(elem))
    else if set_source:
        source_node = nodes.len()
        nodes.push(nodes[n])
        add_flag(source_node, NF_CHECKED)
        nodes[n] = nodes[bc_call("__dewy_set_values", [source_node], nodes[n].pos)]
        check_expr(n, mk_array(elem))
    kept: int[]
    loop m in members:
        if m != canceled: kept.push(m)
    success = if kept.len() == 0: T_NEVER else if kept.len() == 1: kept[0] else: mk_union(kept)
    pos = nodes[n].pos
    inner = nodes.len()
    nodes.push(nodes[n])
    add_flag(inner, NF_CHECKED)
    source = "$collect_array{n}"
    item = "$collect_item{n}"
    result = "$collect_result{n}"
    empty = mk(.array, pos)
    output = bc_let(result, empty, pos)
    nodes[output].a = i32(type_node_of(mk_array(success), pos))
    each = mk(.for_, pos)
    set_list(each, [bc_ident(item, pos)])
    nodes[each].a = i32(bc_ident(source, pos))
    condition = mk(.istype, pos)
    nodes[condition].a = i32(bc_ident(item, pos))
    nodes[condition].b = i32(type_node_of(canceled, pos))
    ret = mk(.return_, pos)
    or_throw_returns[pos] = true
    nodes[ret].a = i32(bc_ident(item, pos))
    branch = mk(.if_, pos)
    nodes[branch].a = i32(condition)
    nodes[branch].b = i32(bc_block([ret], pos))
    add_flag(branch, NF_STMT)
    body = [branch]
    if success != T_NEVER: body.push(bc_stmt(bc_method(bc_ident(result, pos), "push", [bc_ident(item, pos)], pos), pos))
    nodes[each].b = i32(bc_block(body, pos))
    nodes[n] = nodes[bc_block([bc_let(source, inner, pos), output, each, bc_stmt(bc_ident(result, pos), pos)], pos)]
    check_expr(n, 0)

# `??<A | B>` (nodes[n].c, the kinds' type) covers only those kinds (none only when listed),
# and what it does not cover passes through as a value.
coalesce_failures = (n: int, at: int, expected: int) -> int:
    pos = nodes[n].pos
    a = last_checked
    add_flag(a, NF_CHECKED)
    name = "$coalesce{n}"
    members = value_members(at)
    canceled = int(syms[universe[intern("Canceled")]].ref)
    cancel_named = nodes[n].c != 0 and coalesce_names_canceled(int(nodes[n].c), canceled)
    listed: int[]
    if nodes[n].c != 0:
        lt = prune(resolve_type(int(nodes[n].c)))
        listed = if is_union(lt) or tkind(lt) == .opt: value_members(lt) else: [lt]
        loop l in listed:
            if not exception_member(l): fatal(pos, "`??<...>` lists the failures it covers: {dt(l)} is not an exception or none")
            held = false
            loop m in members:
                if m == l or m != T_NONE and l != T_NONE and nominal_descends(m, l): held = true
            if not held and not family_annotation(lt): fatal(pos, "`??<...>` lists {dt(l)}, which {dt(at)} never holds")
    covered: str[]
    passed: str[]
    covers: bool[]
    loop m in members:
        c = false
        if listed.len() == 0: c = exception_member(m)
        else:
            loop l in listed:
                if m == l or m != T_NONE and l != T_NONE and nominal_descends(m, l): c = true
        if m == canceled and not cancel_named: c = false
        covers.push(c)
        if c: covered.push(if m == T_NONE: "none" else: dt(m))
        else if exception_member(m): passed.push(if m == T_NONE: "none" else: dt(m))
    if members.contains(canceled) and not cancel_named and dir_explicit_cancellation(pos): cancel_reject(a, covered.len() > 0, "this `??`")
    if ide_on and not pos_in_lib(pos):
        text = "?? gives the fallback for " + join(covered, ", ")
        if passed.len() > 0: text += "; passes on " + join(passed, ", ")
        ide_emit("I\t{ide_pos_str(pos)}\t{ide_esc(text)}")
    fallback = int(nodes[n].b)
    void_fallback = nodes[fallback].kind == .ident and nodes[fallback].name == i32(intern("void"))
    if void_fallback: fallback = bc_block([], nodes[fallback].pos)
    # (the fallback converts to the value's type, as an optional's does; an optional
    # fallback keeps the result optional)
    values: int[]
    loop i in 0.. and m in members:
        if not covers[i] and (m != canceled or cancel_named): values.push(m)
    target = if expected != 0 and is_union(expected): expected else if values.len() == 1: values[0] else: mk_union(values)
    probe = clone(fallback)
    # (`sleep(1s) ?? 0`: the call gives nothing when it succeeds, so there is no value to default)
    held_hint = coerce_hint
    if values.len() == 1 and prune(values[0]) == T_VOID and dewy_at(pos):
        called = if nodes[a].kind == .call and nodes[a].a != 0 and nodes[int(nodes[a].a)].kind == .ident: "`{name_of(int(nodes[int(nodes[a].a)].name))}`" else: "this call"
        coerce_hint = " ({called} gives no value when it succeeds, so `??` has no value to default: `or_throw` passes its failure on, or `match` it)"
    pt = prune(check_expr(probe, target))
    if prune(target) == T_VOID and pt != T_VOID and pt != T_NEVER: coerce(probe, T_VOID)
    if tkind(pt) == .opt or pt == T_NONE: target = mk_opt(target)
    chain = 0
    j = members.len() - 1
    used = false
    loop j >= 0:
        member = members[j]
        failure = covers[j]
        value = bc_ident(name, pos)
        if member == canceled and not cancel_named:
            ret = mk(.return_, pos)
            or_throw_returns[pos] = true
            nodes[ret].a = i32(value)
            value = bc_block([ret], pos)
        else if failure and (void_fallback or prune(target) == T_VOID):
            value = if used: clone(fallback) else: fallback
            used = true
        else if failure:
            typed = bc_let("{name}_fallback", (if used: clone(fallback) else: fallback), pos)
            nodes[typed].a = i32(type_node_of(target, pos))
            value = bc_block([typed, bc_stmt(bc_ident("{name}_fallback", pos), pos)], pos)
            used = true
        body = bc_block([bc_stmt(value, pos)], pos)
        if chain == 0: chain = body
        else:
            condition = mk(.istype, pos)
            nodes[condition].a = i32(bc_ident(name, pos))
            nodes[condition].b = i32(type_node_of(member, pos))
            branch = mk(.if_, pos)
            nodes[branch].a = i32(condition)
            nodes[branch].b = i32(body)
            nodes[branch].c = i32(chain)
            if values.len() > 1: nodes[branch].aux2 = -8  # explicit union join, not numeric branch promotion
            chain = bc_block([bc_stmt(branch, pos)], pos)
        j -= 1
    nodes[n] = nodes[bc_block([bc_let(name, a, pos), bc_stmt(chain, pos)], pos)]
    result = check_expr(n, expected)
    coerce_hint = held_hint
    result

# the member a Dewy program wrote, for a library function standing for it
shown_fn_name = (name: str) -> str:
    if name == "__dewy_find": return "find"
    if name == "__dewy_rfind": return "rfind"
    if name == "__dewy_index_of": return "index_of"
    if name == "__dewy_insert": return "insert"
    if name == "__dewy_byte_slice": return "byte_slice"
    if name == "__dewy_read_u64": return "read<uint64>"
    if name == "__dewy_read_u32": return "read<uint32>"
    if name == "__dewy_read_u16": return "read<uint16>"
    if name == "__dewy_keys": return "keys"
    name

# the functions that may be called with a dot on a value of type t (for messages)
# Whether `x.name` alone can call a function of x: an array or text builtin
# that takes nothing else, or a visible function whose other parameters all
# have defaults.
# A result with nothing in it: `void`, or `void` with the errors a call may give (the zero-argument
# call style check, call_style.dewy).
call_style_nothing = (t0: int) -> bool:
    t = prune(t0)
    if tkind(t) == .void_: return true
    if not is_union(t) and tkind(t) != .opt: return false
    loop m in value_members(t):
        if not (tkind(m) == .void_ or exception_member(m)): return false
    true

# Whether the receiver type t has a field called name: `x.name` then reads the field, not a call
# of the function (the call style check, call_style.dewy).
call_style_has_field = (t0: int, name: int) -> bool:
    t = prune(t0)
    if tkind(t) == .ptr: t = prune(int(types[t].elem))
    if tkind(t) != .struct_: return false
    si = int(types[t].st)
    check_struct_fields(si)
    loop i in [0..int(structs[si].nfields)):
        if int(fields[int(structs[si].fields) + i].name) == name: return true
    false

# (the Dewy prelude's module declaring name, as a table of the methods a Dewy module's `x.name`
# finds beside the receiver's own: `p.modified` of a Path, lib/prelude/files.dewy; -1 for none)
dewy_prelude_method_module = (name: int) -> int:
    if not caller_dewy(): return -1
    m = dewy_prelude_module(name)
    if m == cur_mod(): return -1
    m

member_call_without_arguments = (t: int, name: int, prelude_methods: bool = false) -> bool:
    tk = types[t].kind
    ii = intrinsic_of(name)
    if ii >= 0 and intrinsics[ii].arr and (tk == .array or tk == .str_):
        id = intrinsics[ii].id
        return id == .len or id == .arrcap or id == .pop or id == .clear or id == .arrdata
    demand_name(name)
    tables = [modules[cur_mod()].names, prelude]
    loop tm in method_modules(t):
        if tm != cur_mod(): tables.push(modules[tm].names)
    # (the zero-argument call style check leaves them out: it has never asked of `x.to_int64()`)
    dm = if prelude_methods: dewy_prelude_method_module(name) else: -1
    if dm >= 0: tables.push(modules[dm].names)
    loop table in tables:
        if not table.has(name): continue
        s = table[name]
        loop s != 0:
            if syms[s].kind == .fns and syms[s].decl != 0:
                d = int(syms[s].decl)
                required = 0
                loop i in [0..nkids(d)):
                    if nodes[kid(d, i)].b == 0: required += 1
                if nkids(d) >= 1 and required <= 1: return true
            s = int(syms[s].next)
    ii >= 0 and not intrinsics[ii].arr

# A short spelling of a receiver for a suggested call.
receiver_text = (n: int) -> str:
    if nodes[n].kind == .ident: return name_of(int(nodes[n].name))
    "x"

# (does a library function `len`, as Heap's and Pool's, take a t first: Dewy's `.length` reads
# it. A `len` written in Dewy is not the protocol: that is a `length` function)
library_len_fits = (t0: int) -> bool:
    t = prune(t0)
    nm = intern("len")
    demand_name(nm)
    tables = [modules[cur_mod()].names, prelude]
    loop tm in method_modules(t):
        if tm != cur_mod(): tables.push(modules[tm].names)
    loop tbl in tables:
        s = tbl.get(nm) ?? 0
        loop s != 0:
            if syms[s].kind == .fns and syms[s].decl != 0 and nkids(int(syms[s].decl)) > 0 and not files[pos_file(nodes[int(syms[s].decl)].pos)].is_dewy:
                sig = fn_sig(int(syms[s].decl))
                if sig.params.len() > 0:
                    rb = fill(0, int(sig.ntp))
                    if match_type(sig.params[0], t, rb, 0) >= 0: return true
            s = int(syms[s].next)
    false

# Membership in fn_names_for without building a diagnostic's complete list.
fn_name_for = (t: int, name: int) -> bool:
    if method_name_for(t, name): return true
    ii = intrinsic_of(name)
    if ii < 0: return false
    tk = types[t].kind
    intrinsics[ii].arr == (tk == .array or tk == .str_)

check_expr_in_module = (n: int, m: int, expected: int = 0) -> int:
    saved = cx
    ctxs.push(FnCtx(ctxs[cx].inst, i32(cx), ctxs[cx].ret, false, 0, i32(m), i32(check_scopes.names.len())))
    cx = ctxs.len() - 1
    t = check_expr(n, expected)
    ctxs.pop()
    cx = saved
    t

id_len = 0
# (the object of `x.member` or `x[...]` being checked: a type there is the type)
type_receiver_at = 0
empty_index_receiver = 0      # the receiver of an empty index, `E[]`: a type there is constructed by it

# A declared member wins over the synthesized value operation, including on
# an alternative of a union. Leave those unions to ordinary member forwarding.
copy_member = (t0: int, name: int) -> bool:
    t = prune(t0)
    if is_union(t):
        loop m in union_members(t):
            if copy_member(m, name): return true
    else if tkind(t) == .opt: return copy_member(telem(t), name)
    else if tkind(t) == .struct_:
        si = int(types[t].st)
        check_struct_fields(si)
        loop i in [0..int(structs[si].nfields)):
            if fields[int(structs[si].fields) + i].name == i32(name): return true
    false

synthetic_copy = (t: int, name: int, pos: int) -> bool:
    if name_of(name) != "copy" or not files[pos_file(pos)].is_dewy: return false
    k = tkind(t)
    if k == .module or k == .typeval or k == .void_ or t == T_NEVER: return false
    if copy_member(t, name): return false
    # Uniform-call methods are user declarations too.
    decls: int[]
    collect_fns(name, &decls)
    loop m in method_modules(t): collect_module(m, name, &decls)
    loop d in decls:
        if nkids(d) == 0: continue
        sig = fn_sig(d)
        binds = fill(0, int(sig.ntp))
        if match_type(sig.params[0], t, binds, 0) >= 0: return false
    true

# (`let xs:array<Op> = ['push'].copy`: a collection literal (or a call, `set(['push']).copy`)
# whose method gives a value of its own type, as copy, sorted and reversed do, takes the type
# expected of the result, as the literal written there would; Dewy only, and only when every function of the name
# that could take the arguments gives its first parameter's type)
receiver_literal_hint = (recv: int, name: int, nargs: int, expected: int, pos: int) -> int:
    if expected == 0 or not dewy_at(pos): return 0
    k = nodes[recv].kind
    literal = (k == .array or k == .map_lit or dewy_set_literal(recv)) and ctx_dependent(recv)
    if not literal and not (k == .call and nodes[recv].type == 0 and not has_flag(recv, NF_CHECKED)): return 0
    want = prune(expected)
    if tkind(want) == .opt: want = prune(telem(want))
    wk = tkind(want)
    if wk != .array and not is_map_type(want) and not is_dewy_set_type(want): return 0
    decls: int[]
    collect_fns(name, &decls)
    if decls.len() == 0: return if name_of(name) == "copy": want else: 0
    some = false
    loop d in decls:
        np = nkids(d)
        if np < nargs + 1: continue
        takes = true
        loop j in [nargs + 1..np):
            if nodes[kid(d, j)].b == 0: takes = false
        if not takes: continue
        sig = fn_sig(d)
        binds = fill(0, int(sig.ntp))
        if match_type(sig.params[0], want, binds, 0) < 0: continue
        if sig.ret == 0 or not type_eq(int(sig.ret), sig.params[0]): return 0
        some = true
    if some: want else: 0

id_at = 0
# The library's names for Dewy's members: `xs.pop(i)` removes by position,
# `xs.insert(value i)` names the value first, `text.startswith(p)`. The
# library's own spellings are not Dewy's.
# (Dewy's length is `.length`: the Sloppy library's `len` of an array, string, dictionary or set,
# written in a Dewy program, is told so)
dewy_len_check = (n: int, member: bool, t0: int, object: int):
    if not dewy_at(nodes[n].pos): return
    t = prune(t0)
    k = tkind(t)
    if member and k != .array and k != .fixed and k != .str_ and not is_map_type(t) and not is_dewy_set_type(t): return
    if member:
        if (dewy_len_members.get(n) ?? -1) != nodes[n].pos: return
        fatal(nodes[n].pos, "Dewy's length is `.length`: write `{receiver_text(object)}.length`")
    f = pos_file(nodes[n].pos)
    o = pos_off(nodes[n].pos)
    src = files[f].src
    if o + 3 > len(src) or src[o..o + 3) != "len" or (o + 3 < len(src) and is_ident_char(src[o + 3])) or (o > 0 and is_ident_char(src[o - 1])): return
    fatal(nodes[n].pos, "Dewy's length is `.length`: write `{receiver_text(object)}.length`")

dewy_member_name = (callee: int, rt: int, fname: int, args: int[]) -> int:
    name = name_of(fname)
    k = types[rt].kind
    pos = nodes[callee].pos
    recv = receiver_text(int(nodes[callee].a))
    if name == "add" and is_dewy_set_type(rt): fatal(pos, "sets insert with push: replace `{recv}.add(value)` with `{recv}.push(value)`")
    if k == .array:
        if name == "pop" and args.len() == 1: return intern("remove")
        if name == "insert": return intern("__dewy_insert")
        if name == "remove": fatal(pos, "an array removes by position with pop: `{recv}.pop(i)`")
        if name == "index_of" and args.len() == 1: return intern("__dewy_index_of")
        if (name == "any" or name == "all") and args.len() == 0 and prune(int(types[rt].elem)) != T_BOOL:
            fatal(pos, "{name} without a predicate is for an array of bools, `{name}(flags)`: give it one, `{recv}.{name}(x => x >? 0)`")
    if name == "keys" and args.len() == 0 and is_map_type(rt): return intern("__dewy_keys")
    if k == .str_:
        if name == "chars" and args.len() == 0: return intern("graphemes")
        if name == "find": return intern("__dewy_find")
        if name == "rfind": return intern("__dewy_rfind")
        if name == "byte_slice" and args.len() == 2: return intern("__dewy_byte_slice")
        if name == "startswith": return intern("starts_with")
        if name == "endswith": return intern("ends_with")
        if name == "starts_with" or name == "ends_with": fatal(pos, "write `{recv}.{replace(name, "_", "")}(...)`")
    fname

# A record literal's method: a closure stored in the object, taking the object first.
# (a record literal's method is kept in the object, but it is not one of its fields:
# formatting leaves it out)
dewy_method_field = (t0: int) -> int:
    t = prune(t0)
    if tkind(t) != .polyfn: return 0
    d = poly_families[int(types[t].st)].decl
    if dewy_is_method(d): d else: 0

dewy_literal_method_name = 0

is_unchecked_at = (n: int) -> bool:
    callee = int(nodes[n].a)
    if nodes[callee].kind != .ident or nkids(n) != 2: return false
    if id_at == 0: id_at = intern("__at")
    int(nodes[callee].name) == id_at and modules[cur_mod()].is_prelude

id_breakpoint = 0

# check_call (checker_expr.dewy) services, by the callee's kind. Every call head first:
# fields(T) misused, members(U), $breakpoint, a member's reflection, the generated
# coordinate helper; -1 goes on.
# `f[T](...)`, `rational<int64>(x)`, `T<...>(...)`: a type application called.
# A named call's juxtaposed products and len of a soa array; -1 goes on to the name.
# `.variant(...)`: an enum variant made.
# `x.f(...)`: a module function, a type's variant or method, a function field, or
# uniform call syntax.

# `T[...](...)` and `f[T](...)`; -1 goes on to the value call.
# A callee that is a value: a juxtaposed product, or the value called.
# resolve_by_types' choices (a formatting function for each value type a string puts in, say):
# by name, module and settled argument types, kept while the name's stamp stands (ml_stamp).
# A hit makes the same instance request and leaves the same hidden spellings as the search.
struct ByTypesKey:
    name: int
    mod: int
    ts: int[]

struct ByTypesChoice:
    gen: int
    decl: int
    binds: int[]
    hidden: int[]

by_types_seen: {ByTypesKey: ByTypesChoice} = {}
by_types_decl = 0
by_types_binds: int[]

resolve_by_types = (name: int, ts: int[], pos: int, required: bool, choice_only: bool = false) -> int:
    settled = not ide_on
    loop t in ts:
        if has_var(t): settled = false
    key = ByTypesKey(name, cur_mod(), ts)
    if settled:
        if let c = by_types_seen.get(key):
            if c.gen == ml_stamp(name):
                loop d in c.hidden: surface_hidden.push(d)
                return if choice_only: c.decl else: get_fn_inst(c.decl, c.binds, pos)
    gen = ml_stamp(name)
    hidden_mark = surface_hidden.len()
    decls: int[]
    collect_fns(name, &decls)
    collect_in(-1, name, 0, &decls)
    if ts.len() > 0:
        tm = module_of_type(ts[ts.len() - 1])
        if tm >= 0: collect_module(tm, name, &decls)
    if not choose_from_types(name, decls, ts, pos, required): return 0
    decl = by_types_decl
    binds = by_types_binds
    if settled and ml_stamp(name) == gen: by_types_seen[key] = ByTypesChoice(gen, decl, binds, surface_hidden[hidden_mark..])
    if choice_only: decl else: get_fn_inst(decl, binds, pos)

# (the cheapest of decls for arguments of types ts: by_types_decl and its by_types_binds; false
# when none fits and none is required)
choose_from_types = (name: int, decls: int[], ts: int[], pos: int, required: bool) -> bool:
    best = -1
    bestcost = 1 << 30
    bestb: int[]
    bestgen = false
    loop k in 0.. and d in decls:
        sig = fn_sig(d)
        if nkids(d) != ts.len(): continue
        binds = fill(0, int(sig.ntp))
        cost = 0
        ok = true
        loop i in [0..ts.len()):
            r = match_type(sig.params[i], ts[i], binds, 0)
            if r < 0 or (int(sig.mutmask) & (1 << i) != 0 and r == 1):
                ok = false
                break
            cost += r
        if not ok: continue
        # (a tie: the one without type parameters, as __fmt(m: f64[,]) over __fmt[T](m: T[,]))
        if cost < bestcost or (cost == bestcost and sig.ntp == 0 and bestgen):
            best = k
            bestcost = cost
            bestb = binds
            bestgen = sig.ntp > 0
    if best < 0:
        if not required: return false
        last = "()"
        if ts.len() > 0: last = dt(ts[ts.len() - 1])
        fatal(pos, "no function '{name_of(name)}' accepting {last}")
    by_types_decl = decls[best]
    by_types_binds = bestb
    true

# ---------------- intrinsics ----------------
arg_type = (args: int[], i: int, expected: int) -> int:
    a = args[i]
    if nodes[a].kind == .namedarg: fatal(nodes[a].pos, "named arguments are not supported here")
    if not has_flag(a, NF_CHECKED) or nodes[a].type == 0:
        check_expr(a, expected)
        add_flag(a, NF_CHECKED)
    if expected != 0: coerce(a, expected)
    prune(ntype(a))

nargs_check = (n: int, nargs: int, lo: int, hi: int, name: str):
    if nargs < lo or nargs > hi:
        if lo == hi: fatal(nodes[n].pos, "{name} expects {lo} argument(s), got {nargs}")
        fatal(nodes[n].pos, "{name} expects {lo} to {hi} arguments, got {nargs}")

fmt_part = (part: int, pos: int):
    # Formatting observes the exact result; it is not a uint64 store.
    # Reveal an unsigned arithmetic node to mathematical int before overload selection.
    observed = int(nodes[part].a)
    if dewy_at(pos) and exact_type(ntype(observed), pos) and not types[exact_representation(ntype(observed))].sign and exact_potential(observed): exact_int_result(observed, true)
    t = prune(ntype(int(nodes[part].a)))
    oom_unhandled(t, pos, "showing it")
    shown = if is_quantity(t) and nodes[part].sval < 0 and dewy_at(pos): quantity_display(int(nodes[part].a)) else: 0
    if shown != 0:
        nodes[part].a = i32(shown)
        t = T_STR
    else if is_quantity(t):
        reading = if dewy_at(pos): quantity_shown_number(int(nodes[part].a)) else: 0
        if reading != 0:
            nodes[part].a = i32(reading)
            t = prune(ntype(reading))
        else:
            nodes[part].a = i32(quantity_number(int(nodes[part].a)))
            t = quantity_base(t)
    if types[t].kind == .fixed:
        # (shown like an array: [1, 2, 3])
        t = mk_array(int(types[t].elem))
        coerce(int(nodes[part].a), t)
    # (never: what does not come back, as panic(...), or a function skipped after its error)
    if t == T_NEVER:
        coerce(int(nodes[part].a), T_STR)
        t = T_STR
    if types[t].kind == .void_:
        why = void_rec_hint(int(nodes[part].a))
        # (print(xs.reverse()): Python's in-place methods give None)
        if why == "" and dewy_at(nodes[part].pos) and nodes[int(nodes[part].a)].kind != .ident: why = " (this gives nothing: a method that changes its object, as `xs.sort()` or `xs.reverse()`, gives no value; show the object afterwards, or make a new one with `xs.sorted()` or `xs.reversed()`)"
        fatal(nodes[int(nodes[part].a)].pos, "cannot format a value of type void{why}")
    # (a type shown is its spelling: `"{int64}"`, `printl(Point)`)
    if types[t].kind == .typeval and dewy_at(nodes[part].pos):
        e = int(nodes[part].a)
        nodes[e] = nodes[bc_str(type_str(int(types[t].elem), true), nodes[e].pos)]
        check_expr(e, T_STR)
        t = T_STR
    if types[t].kind == .typeval or types[t].kind == .module: fatal(nodes[int(nodes[part].a)].pos, "this is a type or module, not a value (a value of a type is made by calling it: `T()`)")
    if types[t].kind == .ptr or types[t].kind == .cfn: fatal(nodes[int(nodes[part].a)].pos, "a {dt(t)} is not printed: its address is `int(p as *u8)` (in hex, \"\{int(p as *u8):#x}\")")
    bt = mk_array(T_U8)
    if nodes[part].sval >= 0:
        # ({hits / shots:.1%} with whole numbers: the fraction is gone before it is shown)
        e = int(nodes[part].a)
        spec = name_of(int(nodes[part].sval))
        if is_int(t) and nodes[e].kind == .binary and nodes[e].op == i32(int(Tok.slash)) and len(spec) > 0 and (spec[len(spec) - 1] == '%' or spec[len(spec) - 1] == 'f' or find_byte(spec, '.') >= 0):
            warn(nodes[e].pos, "this divides whole numbers, dropping the fraction before it is formatted: `f64(a) / b` keeps it")
        nodes[part].sym = i32(resolve_by_types(intern("__fmt_spec"), [bt, t, T_STR], pos, true))
    else:
        writer = "__fmt"
        if dewy_at(pos): writer = "__dewy_fmt"
        # Select the representation before instantiating the generic formatter.
        # The semantic overload is still chosen first; only the bundled default
        # may use a proved word, with no new fixed-width storage obligation.
        if t == T_MATH_INT and exact_format_word(int(nodes[part].a), writer, bt, pos):
            exact_word_formats[part] = true
            nodes[part].sym = i32(runtime_fn("__fmt_word"))
        else: nodes[part].sym = i32(resolve_by_types(intern(writer), [bt, t], pos, true))

is_dewy_range_type = (t: int, name: str) -> bool:
    p = prune(t)
    if types[p].kind != .struct_: return false
    st = int(types[p].st)
    if structs[st].name != name: return false
    d = int(structs[st].decl)
    d != 0 and files[pos_file(nodes[d].pos)].path == lib_dir + "/std/dewy_ranges.jo"

is_dewy_set_type = (t: int) -> bool:
    p = prune(t)
    if types[p].kind != .struct_: return false
    st = int(types[p].st)
    if structs[st].name != "Set": return false
    d = int(structs[st].decl)
    d != 0 and files[pos_file(nodes[d].pos)].path == lib_dir + "/std/dewy_sets.jo"

is_value_collection_type = (t: int) -> bool:
    if is_dewy_set_type(t): return true
    p = prune(t)
    if types[p].kind != .struct_: return false
    st = int(types[p].st)
    if structs[st].name != "Map": return false
    d = int(structs[st].decl)
    d != 0 and files[pos_file(nodes[d].pos)].path == lib_dir + "/core/map.jo"

# The intrinsics checker_expr.dewy's check_intrinsic leaves to the host: every one but len, cap, push,
# pop, clear, syscall, mem_copy, mem_set, panic and bytes.
intrinsic_rest = (n: int, iid: int, args0: int[], expected: int) -> int:
    let id = iid as IN
    if id == .range_max:
        t = representation_type(check_expr(args0[0], 0))
        bits = int(types[t].bits)
        value = if bits == 64: -1 else: (1 << bits) - 1
        if types[t].sign: value = int(u64(value) >> 1)
        nodes[n] = Node(kind = .int_lit, pos = nodes[n].pos, type = i32(t), ival = value, flags = i32(NF_CHECKED))
        if not types[t].sign and value < 0: add_flag(n, NF_U64)
        return t
    let args = args0
    # `__permutable_data(xs)`: data() for code that only moves elements between slots (the
    # library's swap and reorderings), so an element's refinement holds without a proof per
    # element: refined storage is not refused
    permute = id == .arrdata_permute
    if permute:
        if not pos_in_lib(nodes[n].pos): fatal(nodes[n].pos, "__permutable_data is the library's")
        id = .arrdata
    nodes[n].kind = .intrinsic
    nodes[n].aux = i32(int(id))
    set_list(n, args)
    nodes[n].a = 0
    nargs = args.len()
    r = T_VOID
    if id == .secret_wrap:
        # secret(x): x's value as a secret (secrets.jo)
        nargs_check(n, nargs, 1, 1, "secret")
        want = 0
        if expected != 0 and tkind(expected) == .secret: want = prune(telem(expected))
        t = prune(arg_type(args, 0, want))
        if is_lit(args[0]): t = prune(finalize_literal(args[0]))
        nodes[n] = nodes[args[0]]
        if types[t].kind == .secret: return t
        return secret_wrap(n, t)
    if id == .secret_value:
        # __secret_value(x): x, or a secret's value (the library's: a dictionary hashes a
        # secret key as its value)
        nargs_check(n, nargs, 1, 1, "__secret_value")
        if not pos_in_lib(nodes[n].pos): fatal(nodes[n].pos, "__secret_value is the library's: `x.reveal` gives a secret's value")
        t = prune(arg_type(args, 0, expected))
        nodes[n] = nodes[args[0]]
        if types[t].kind != .secret: return t
        secret_reveal(n)
        return prune(ntype(n))
    if id == .task_duration:
        nargs_check(n, nargs, 1, 1, "__task_nanoseconds")
        return task_duration_value(n, args[0])
    if id == .task_report:
        nargs_check(n, nargs, 2, 2, "__task_report")
        return concurrency_report(n, args)
    if id == .arena_result:
        nargs_check(n, nargs, 2, 2, "$allocator_result")
        return arena_check_result(n, args[0], arg_type(args, 0, expected), nodes[args[1]].ival != 0)
    if id == .lend:
        nargs_check(n, nargs, 3, 3, "$lend")
        if has_flag(args[0], NF_MUT): add_flag(n, NF_MUT)
        if nodes[args[0]].kind == .addr:
            add_flag(n, NF_MUT)
            args[0] = int(nodes[args[0]].a)
            set_list(n, args)
        t = arg_type(args, 0, 0)
        if t != mk_array(T_U8): fatal(nodes[n].pos, "$lend needs a named array<uint8> owner")
        if nodes[args[0]].kind != .ident: fatal(nodes[n].pos, "$lend needs stable named storage")
        if has_flag(n, NF_MUT): check_place(args[0], false)
        arg_type(args, 1, T_INT)
        if not has_flag(n, NF_MUT) and (nodes[args[1]].kind != .int_lit or nodes[args[1]].ival != 0): fatal(nodes[n].pos, "reservation requires a writable loan")
        nodes[n].ival = locals.len()
        r = arg_type(args, 2, expected)
        loan_owners[if cx >= 0: int(ctxs[cx].inst) else: 0] = true
    else if id == .loan_address or id == .loan_load or id == .loan_store or id == .loan_length:
        nargs_check(n, nargs, (if id == .loan_store or id == .loan_length: 2 else: 1), (if id == .loan_store or id == .loan_length: 2 else: 1), "scoped byte operation")
        if id == .loan_address or id == .loan_length:
            if arg_type(args, 0, 0) != mk_array(T_U8): fatal(nodes[n].pos, "scoped byte operation needs array<uint8>")
        else: arg_type(args, 0, T_INT)
        if nargs == 2: arg_type(args, 1, T_INT)
        if id == .loan_address: r = T_INT
        if id == .loan_load: r = T_U8
        loan_owners[if cx >= 0: int(ctxs[cx].inst) else: 0] = true
    else if id == .dewy_set:
        nargs_check(n, nargs, 1, 1, "set literal")
        ex = prune(expected)
        if types[ex].kind == .opt: ex = prune(int(types[ex].elem))
        if is_union(ex):
            selected = 0
            loop member in union_members(ex):
                if is_dewy_set_type(member):
                    if selected != 0: selected = 0; break
                    selected = member
            if selected != 0: ex = selected
        if is_dewy_set_type(ex):
            check_to(args[0], mk_array(struct_targ(int(types[ex].st), 0)))
            add_flag(args[0], NF_CHECKED)
        else if nodes[args[0]].kind == .array and nkids(args[0]) == 0:
            fatal(nodes[n].pos, "cannot infer the type of an empty set; add a type annotation: `let values:set<int64> = set[]`")
        nodes[n] = nodes[bc_call("__dewy_make_set", args, nodes[n].pos)]
        return check_expr(n, expected)
    else if id == .dewy_iter:
        nargs_check(n, nargs, 1, 1, "__dewy_iter")
        # (`loop x in inbox or_throw {`: for an iterator the failures are each step's, not the iterator's)
        if nodes[args[0]].kind == .propagate and dewy_at(nodes[n].pos):
            inner = int(nodes[args[0]].a)
            if dewy_iterator_type(prune(check_expr(inner, 0))):
                add_flag(last_checked, NF_CHECKED)
                throwing_iters[n] = int(nodes[args[0]].b)
                args[0] = last_checked
        t = arg_type(args, 0, 0)
        add_flag(args[0], NF_CHECKED)
        if tkind(t) == .str_:
            nodes[n] = nodes[bc_call("__dewy_grapheme_iter", args, nodes[n].pos)]
        else if is_dewy_range_type(t, "IntRange"):
            nodes[n] = nodes[bc_call("__dewy_range_iter", args, nodes[n].pos)]
        else if is_dewy_set_type(t):
            # (loop k in d.keys: the dictionary's keys in order, without making the set)
            src = args[0]
            if nodes[src].kind == .call and nkids(src) == 1 and nodes[src].a == 0 and nodes[src].sym > 0 and int(nodes[src].sym) < fns.len() and fns[int(nodes[src].sym)].decl != 0 and name_of(int(nodes[int(fns[int(nodes[src].sym)].decl)].name)) == "__dewy_keys":
                m = kid(src, 0)
                add_flag(m, NF_CHECKED)
                nodes[n] = nodes[bc_call("keys", [m], nodes[n].pos)]
            else: nodes[n] = nodes[bc_call("__dewy_set_values", args, nodes[n].pos)]
        else if is_map_type(t) and not ownership_fact_type(t):
            # Combined loops index a retained dense entry list. Compact deleted
            # entries once, just as ordinary dictionary iteration does.
            nodes[n] = nodes[bc_call("__map_entries", args, nodes[n].pos)]
        else: nodes[n] = nodes[args[0]]
        return check_expr(n, expected)
    else if id == .dewy_iter_done or id == .dewy_iter_value or id == .dewy_iter_pair:
        nargs_check(n, nargs, 2, 2, "Dewy loop iterator")
        t = arg_type(args, 0, 0)
        add_flag(args[0], NF_CHECKED)
        pos = nodes[n].pos
        if is_dewy_cursor_iter(t):
            prefix = if is_dewy_grapheme_iter(t): "__dewy_grapheme" else if is_dewy_range_type(t, "__DewyOpenRangeIter"): "__dewy_open_range" else: "__dewy_range"
            name = prefix + "_done"
            if id != .dewy_iter_done:
                name = prefix + "_value"
                add_flag(args[0], NF_MUT)
            nodes[n] = nodes[bc_call(name, [args[0]], pos)]
        else if id == .dewy_iter_done:
            # (an entry list's length is its key array's, which the value reads)
            length = if is_map_entries_type(t): bc_call("len", [bc_map_keys(args[0], pos)], pos) else if tkind(t) == .struct_: bc_method(args[0], sequence_length_name(t), [], pos) else: bc_call("len", [args[0]], pos)
            nodes[n] = nodes[bc_bin(.ge, args[1], length, pos)]
        else if (is_map_type(t) or is_map_entries_type(t)) and id == .dewy_iter_pair:
            nodes[n] = nodes[bc_call("__map_pair_at", args, pos)]
        else:
            ix = mk(.index, pos)
            nodes[ix].a = i32(if is_map_type(t) or is_map_entries_type(t): bc_map_keys(args[0], pos) else: args[0])
            nodes[ix].b = i32(args[1])
            nodes[n] = nodes[ix]
        return check_expr(n, expected)
    else if id == .live_len:
        t = prune(arg_type(args, 0, 0))
        if types[t].kind != .array: fatal(nodes[n].pos, "`loop item in @items` iterates a growable array or a bound iterator live, not {dt(t)}; iterate its value with `loop item in items`")
        nodes[n].aux = i32(int(IN.len))
        r = T_INT
    else if id == .insert:
        nargs_check(n, nargs, 3, 3, "insert")
        t = arg_type(args, 0, 0)
        if types[t].kind != .array: fatal(nodes[n].pos, "insert() needs an array")
        if value_loops.len() > 0: value_loop_resize(args[0], "insert", nodes[n].pos)
        check_place(args[0], false)
        arg_type(args, 1, T_INT)
        arg_type(args, 2, int(types[t].elem))
    else if id == .remove:
        nargs_check(n, nargs, 2, 2, "remove")
        t = arg_type(args, 0, 0)
        if types[t].kind != .array: fatal(nodes[n].pos, "remove() needs an array")
        if value_loops.len() > 0: value_loop_resize(args[0], "remove", nodes[n].pos)
        check_place(args[0], false)
        # (gems.remove(g): by value, as C#'s List.Remove; here by position)
        coerce_hint = if dewy_at(nodes[n].pos): " (remove takes a position. To take out things that are done: mark them in the loop (`a.gone = true`), then after it `xs.retain((a) => not a.gone)`; or `xs.retain((y) => y not=? x)` for what is equal to x)" else: " (remove takes a position. To take out things that are done, as Scratch's \"delete this clone\": mark them in the loop (`a.gone = true`), then after it `xs.retain((a): not a.gone)`; or `xs.retain((y): y != x)` for what is equal to x)"
        arg_type(args, 1, T_INT)
        coerce_hint = ""
        r = int(types[t].elem)
    else if id == .extend:
        nargs_check(n, nargs, 2, 2, "extend")
        t = arg_type(args, 0, 0)
        if types[t].kind != .array: fatal(nodes[n].pos, "extend() needs an array")
        if value_loops.len() > 0: value_loop_resize(args[0], "extend", nodes[n].pos)
        check_place(args[0], false)
        source = args[1]
        if dewy_set_literal(source) and nodes[kid(source, 0)].kind == .array and nkids(kid(source, 0)) == 0:
            # Empty-set spreading contributes no elements or effects. Avoid
            # instantiating Set[T] before a later element can infer T.
            source = kid(source, 0)
        hint = t
        if dewy_set_literal(source):
            set_sym = prelude.get(ci(18, "Set")) ?? 0
            if set_sym == 0: fatal(nodes[source].pos, "Set type is not available")
            hint = get_struct_inst(int(syms[set_sym].ref), [int(types[t].elem)])
        source_type = prune(check_expr(source, hint))
        source = last_checked
        add_flag(source, NF_CHECKED)
        if is_map_type(source_type) and dewy_at(nodes[n].pos): fatal(nodes[source].pos, "a dictionary cannot be spread into an array or added to one: take its keys (`[d.keys...]`), its values (`d.values`), or its entries as records (`[loop [key value] in d [key=key value=value]]`)")
        if is_dewy_set_type(source_type): source = bc_call("__dewy_set_values", [source], nodes[source].pos)
        if types[source_type].kind == .fixed and has_var(int(types[t].elem)):
            unify(int(types[t].elem), int(types[source_type].elem))
        expanded = [args[0], source]
        arg_type(expanded, 1, t)
        set_list(n, expanded)
    else if id == .reserve or id == .resize or id == .truncate or id == .setlen:
        nargs_check(n, nargs, 2, 2, "reserve/resize/truncate")
        t = arg_type(args, 0, 0)
        if types[t].kind != .array: fatal(nodes[n].pos, "this operation needs an array")
        if value_loops.len() > 0 and id != .reserve: value_loop_resize(args[0], (if id == .resize: "resize" else if id == .truncate: "truncate" else: "set_length"), nodes[n].pos)
        check_place(args[0], false)
        arg_type(args, 1, T_INT)
        if id == .resize or id == .setlen: concurrency_require_zero(n, int(types[t].elem))
        # Generated dotted output is private reserved storage, filled once
        # by checked element stores before it becomes a value. Its temporary
        # zeroed slots are never exposed as inhabitants of the element type.
        private_output = id == .setlen and has_flag(n, NF_PRIVATE_SETLEN)
        if refine_active and (id == .resize or id == .setlen) and not private_output and ref_storage_contract(int(types[t].elem)):
            fatal(nodes[n].pos, "refined elements cannot be created by unchecked zero initialization")
    else if id == .task_data:
        nargs_check(n, nargs, 1, 1, "__task_data")
        if not pos_in_lib(nodes[n].pos): fatal(nodes[n].pos, "shared raw storage is private to the trusted task runtime")
        t = arg_type(args, 0, 0)
        if tkind(t) != .array: fatal(nodes[n].pos, "task storage must be an array")
        r = mk_ptr(telem(t))
    else if id == .arrdata:
        nargs_check(n, nargs, 1, 1, "data")
        # A pointer reaches the elements, never the descriptor's length.
        t = arg_type(args, 0, 0)
        if tkind(representation_type(t)) == .array: t = representation_type(t)
        if types[t].kind == .str_: r = T_RAWPTR
        else if types[t].kind == .array: r = mk_ptr(int(types[t].elem))
        else: fatal(nodes[n].pos, "data() needs an array or string")
        if not permute and refine_active and ref_storage_contract(t): fatal(nodes[n].pos, "mutable refinement access through raw data is not supported")
        note_storage_access(args[0])
        if cx >= 0 and types[t].kind == .array: data_access_note(n, args[0], int(ctxs[cx].inst))
    else if id == .integer_mode:
        # Private library dispatch: signedness and overflow policy, erased now.
        nargs_check(n, nargs, 1, 1, "__integer_mode")
        t = representation_type(expr_as_type(args[0]))
        mode = if t == T_MATH_INT: -2 else if not is_int(t): -1 else: 2 * int_policy(t) + int(types[t].sign)
        nodes[n] = Node(kind = .int_lit, pos = nodes[n].pos, ival = mode, type = i32(T_INT), flags = i32(NF_LITERAL | NF_CHECKED))
        return T_INT
    else if id == .sizeof or id == .alignof:
        nargs_check(n, nargs, 1, 1, "size_of")
        if files[pos_file(nodes[n].pos)].is_dewy:
            nm = if id == .sizeof: "size_of" else: "align_of"
            fatal(nodes[n].pos, "write `{nm}<T>`: the type goes in angle brackets")
        t = expr_as_type(args[0])
        layout(t)
        v = tsize(t)
        if id == .alignof: v = talign(t)
        nodes[n] = Node(kind = .int_lit, pos = nodes[n].pos, ival = v, type = i32(T_INT), flags = i32(NF_LITERAL | NF_CHECKED))
        return T_INT
    else if id == .unreachable: r = T_NEVER
    else if id == .assert or id == .runtime_assert:
        if nodes[n].aux2 == i32(RANGE_EXHAUSTION):
            t = representation_type(arg_type(args, 2, 0))
            initial = integer_constant(args[2])
            nodes[n].ival = int(is_int(t) and types[t].bits == 64 and initial.0 and (types[t].sign or initial.1 >= 0) and initial.1 >= -72057594037927936 and initial.1 <= 72057594037927936)
            args = [args[0], args[1]]
            set_list(n, args)
            nargs = 2
            if not fact_range_assumed(n): fact_requests.push(FactRequest(n, int(ctxs[cx].inst)))
        nargs_check(n, nargs, 1, 2, "assert")
        arg_type(args, 0, T_BOOL)
        if nargs == 2: arg_type(args, 1, T_STR)
        # A runtime assertion whose condition is known to fail is an error.
        if id == .runtime_assert and static_truth(args[0]) == 0: assertion_refuted(args[0], 0)
        # Execution continues only where the condition held: narrow as after
        # `if not cond return` (`$runtime_assert r isnt? Oops`).
        if id == .runtime_assert: narrow_by(args[0], true)
    else if id == .static_assert:
        nargs_check(n, nargs, 1, 2, "$assert")
        captures_before = if cx >= 0: fns[int(ctxs[cx].inst)].caps.len() else: 0
        arg_type(args, 0, T_BOOL)
        if nargs == 2: arg_type(args, 1, T_STR)
        # An erased read must not introduce an environment allocation. Existing
        # runtime/explicit captures are supported; proof-only captures await a
        # separate compile-time binding representation.
        if cx >= 0 and fns[int(ctxs[cx].inst)].caps.len() > captures_before and fact_open(args[0]):
            err_notes.push((nodes[args[0]].pos, "note: an erased operand would introduce a runtime capture here"))
            fatal(nodes[n].pos, "cannot prove assertion: unsupported erased operand; erased operand would introduce a runtime capture")
        if string_set_obligations.has(n):
            owner = if cx >= 0: int(ctxs[cx].inst) else: 0
            string_set_owners[owner] = true
            fact_requests.push(FactRequest(n, owner))
        else: fact_queue(n, args[0], if nargs == 2: args[1] else: 0)
    else if id == .print or id == .dewy_print:
        # (Dewy's print: no line break; its printl is the library's print)
        s = mk(.str_lit, nodes[n].pos)
        nodes[s].aux = 1
        parts: int[]
        # (Dewy's `print(x file=stderr)`: the stream it goes to)
        stream = 0
        values: int[]
        loop a in args:
            if nodes[a].kind == .namedarg and dewy_at(nodes[a].pos) and name_of(int(nodes[a].name)) == "file" and stream == 0: stream = int(nodes[a].a)
            else: values.push(a)
        loop i in 0.. and a in values:
            if nodes[a].kind == .namedarg:
                if dewy_at(nodes[a].pos): fatal(nodes[a].pos, "print's only named argument is `file=`, the stream: `print(x file=stderr)`")
                fatal(nodes[a].pos, "print() does not take named arguments (`write(s)` prints without a line break; print puts a space between its values)")
            if i > 0:
                sp = mk(.str_lit, nodes[n].pos)
                nodes[sp].sval = i32(ci(19, " "))
                parts.push(sp)
            part = mk(.pair, nodes[n].pos)
            nodes[part].a = i32(a)
            nodes[part].sval = -1
            parts.push(part)
        set_list(s, parts)
        if values.len() == 1 and nodes[values[0]].kind == .str_lit and nodes[values[0]].aux == 0: s = values[0]
        if stream != 0:
            put = bc_call("__console_put", [stream, s, bc_bool(id == .print, nodes[n].pos)], nodes[n].pos)
            nodes[n] = nodes[put]
            return check_expr(n, expected)
        check_expr(s, 0)
        nodes[n].kind = .call
        nodes[n].aux = 0
        set_list(n, [s])
        printer = "__print_str"
        if id == .dewy_print: printer = "write"
        nodes[n].sym = i32(runtime_fn(printer))
        nodes[n].type = i32(T_VOID)
        return T_VOID
    else if id == .embed:
        nargs_check(n, nargs, 1, 1, "embed")
        a = args[0]
        if nodes[a].kind != .str_lit or nodes[a].aux != 0: fatal(nodes[n].pos, "embed() needs a string literal path")
        rel = name_of(int(nodes[a].sval))
        path = rel
        if not is_abs_path(rel): path = "{files[pos_file(nodes[n].pos)].dir}/{rel}"
        path = path_norm(path)
        path = time_rules_path(path)
        if not embedded_files.contains(path): embedded_files.push(path)
        d = read_file(path)
        if d == none:
            # (Cat1.png for cat1.png: a file's name with its capitals another way)
            dir = path[..max(rfind(path, "/"), 0))
            base = path[max(rfind(path, "/"), -1) + 1..]
            if len(dir) > 0:
                loop f in list_dir(dir):
                    if lower(f) == lower(base) and f != base: fatal(nodes[n].pos, "embed: there is no '{base}' next to the program, but there is '{f}': file names care about capital letters")
            fatal(nodes[n].pos, "embed: cannot read '{path}'")
        nodes[n].sval = i32(intern(d!))
        r = mk_array(T_U8)
    else if id == .embed_dir:
        # embed_dir("assets"): {"a.png": embed("assets/a.png"), "sfx/hit.wav": ...}, every file under
        # it (sub-directories' with their path; hidden ones left out)
        nargs_check(n, nargs, 1, 1, "embed_dir")
        a = args[0]
        if nodes[a].kind != .str_lit or nodes[a].aux != 0: fatal(nodes[n].pos, "embed_dir() needs a string literal path")
        rel = name_of(int(nodes[a].sval))
        path = rel
        if not is_abs_path(rel): path = "{files[pos_file(nodes[n].pos)].dir}/{rel}"
        if not is_dir(path): fatal(nodes[n].pos, "embed_dir: '{path}' is not a directory")
        names: str[]
        embed_dir_walk(path, "", names)
        pos = nodes[n].pos
        pairs: int[]
        loop nm in names:
            pr = mk(.pair, pos)
            nodes[pr].a = i32(bc_str(nm, pos))
            nodes[pr].b = i32(bc_call("embed", [bc_str("{rel}/{nm}", pos)], pos))
            pairs.push(pr)
        if pairs.len() == 0: fatal(nodes[n].pos, "embed_dir: '{path}' has no files")
        m = mk(.map_lit, pos)
        set_list(m, pairs)
        nodes[n] = nodes[m]
        return check_expr(n, expected)
    else if id == .from_bytes:
        nargs_check(n, nargs, 1, 1, "str_from_bytes")
        arg_type(args, 0, mk_array(T_U8))
        nodes[n].kind = .call
        nodes[n].aux = 0
        nodes[n].sym = i32(runtime_fn("__str_from_bytes"))
        nodes[n].type = i32(T_STR)
        return T_STR
    else if id == .argv: r = T_RAWPTR
    else if id == .offset_unit:
        nargs_check(n, nargs, 3, 3, "__offset_unit")
        if nodes[args[0]].kind != .str_lit: fatal(nodes[args[0]].pos, "an offset unit's symbol is a string literal")
        arg_type(args, 1, 0)
        arg_type(args, 2, 0)
        return quantity_offset_unit(n, name_of(int(nodes[args[0]].sval)), args[1], args[2])
    else if id == .mul_hi:
        # (the high 64 bits of a 128-bit product: the dictionaries' keyed hash, lib/core/map.jo)
        nargs_check(n, nargs, 2, 2, "__mul_hi")
        arg_type(args, 0, T_U64)
        arg_type(args, 1, T_U64)
        runtime_demand("__mul_hi_soft")      # (WebAssembly has no high multiply)
        r = T_U64
    else if id == .sqrt:
        nargs_check(n, nargs, 1, 1, "sqrt")
        t = arg_type(args, 0, 0)
        # (the root of a temperature is of its difference reading)
        if is_quantity(t) and quantity_tag(t) != 0:
            args[0] = quantity_delta_reading(args[0])
            t = prune(ntype(args[0]))
        # (the root of a quantity halves its dimension's powers: sqrt of an area is a length)
        if is_quantity(t) and dewy_at(nodes[n].pos):
            # (odd powers give rational ones: sqrt of a frequency is Time^(-1/2), as in V/sqrt(Hz))
            dim = power_dimension(quantity_dimension(t), 1, nodes[n].pos, 2)
            number = quantity_number(args[0])
            base = quantity_base(t)
            if types[base].kind != .float_:
                coerce(number, T_FLOAT)
                base = T_FLOAT
            args[0] = number
            set_list(n, args)
            nodes[n].type = i32(base)
            add_flag(n, NF_CHECKED)
            wrap_conv(n, .none_, mk_quantity(base, dim))
            last_checked = n
            return ntype(n)
        if is_lit(args[0]) or types[t].kind == .int_ or bundled_rational_type(t):
            coerce(args[0], T_FLOAT)
            t = T_FLOAT
        if types[t].kind != .float_: fatal(nodes[n].pos, jd(nodes[n].pos, "sqrt() needs a float", "sqrt needs a float64 or float32 (found {dt(t)})"))
        r = t
    else if id == .json_fields:

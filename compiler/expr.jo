use 'units.jo'
use 'errors.jo'
use 'poly_closure.jo'
# Expression checking: type inference, coercions, overload resolution, generics, lambdas.
# Nodes are rewritten in place (wrapping moves the old content to a fresh node).

use 'util.jo'
use 'lex.jo'
use 'ast.jo'
use 'types.jo'
use 'check.jo'
use 'facts.jo'
use 'refine.jo'
use 'effects.jo'
use 'reflection.jo'
use 'prelude.jo'
use 'ide.jo'
use 'dewy_methods.jo'

enum IN:
    none_, len, push, pop, insert, remove, clear, reserve, slice, syscall, memcpy, memset, sizeof,
    arrdata, panic, assert, print, embed, from_bytes, to_bytes, argv, setlen, truncate, resize,
    hash, alignof, unreachable, arrcap, fmt_struct, sqrt, vec_ctor, cfn_cast, wasm_call, callc, floor_,
    ceil_, fabs, fmin, fmax, setjmp, longjmp, jump, shader, extend, clone_thread, atomic_add, atomic_cas, stack_ptr, fill, fmt_elem, gpu_kernel, cpu_features, code_sync, compute, compute_spirv, compute_textures,
    read_fields, default_init, embed_dir, dewy_iter, dewy_iter_done, dewy_iter_value, json_fields, dewy_iter_pair, dewy_set,
    static_assert, runtime_assert, dewy_print, dewy_fmt, dewy_fmt_elem, lend, loan_address, loan_load, loan_store, loan_length

# (fixed2arr: T[N] -> T[], a new array holding a copy of the elements)
enum CV: none_, int_, int2float, float2int, float_, opt, ptr, bits, fn2clos, union_, fixed2arr, arr2fixed, quantity_const, explicit_copy, refinement, big2math, math2big

struct Intrinsic:
    name: str
    id: IN
    arr: bool

intrinsics = [
    Intrinsic("$lend", .lend, false),
    Intrinsic("__load_i64__", .loan_address, false),
    Intrinsic("__load_u8__", .loan_load, false),
    Intrinsic("__store_u8__", .loan_store, false),
    Intrinsic("set_length", .loan_length, true),
    Intrinsic("$dewy_range_exhausted", .panic, false),
    Intrinsic("$assert", .static_assert, false),
    Intrinsic("$runtime_assert", .runtime_assert, false),
    Intrinsic("__dewy_iter", .dewy_iter, false),
    Intrinsic("__dewy_iter_done", .dewy_iter_done, false),
    Intrinsic("__dewy_iter_value", .dewy_iter_value, false),
    Intrinsic("__dewy_iter_pair", .dewy_iter_pair, false),
    Intrinsic("__dewy_set", .dewy_set, false),
    Intrinsic("__dewy_print", .dewy_print, false),
    Intrinsic("__dewy_fmt_value", .dewy_fmt, false),
    Intrinsic("__dewy_fmt_elem_value", .dewy_fmt_elem, false),
    Intrinsic("len", .len, true), Intrinsic("cap", .arrcap, true), Intrinsic("push", .push, true),
    Intrinsic("pop", .pop, true), Intrinsic("insert", .insert, true), Intrinsic("remove", .remove, true),
    Intrinsic("clear", .clear, true), Intrinsic("reserve", .reserve, true), Intrinsic("resize", .resize, true),
    Intrinsic("extend", .extend, true),
    Intrinsic("truncate", .truncate, true), Intrinsic("data", .arrdata, true),
    Intrinsic("fill", .fill, false), Intrinsic("syscall", .syscall, false), Intrinsic("mem_copy", .memcpy, false), Intrinsic("mem_set", .memset, false),
    Intrinsic("size_of", .sizeof, false), Intrinsic("align_of", .alignof, false), Intrinsic("panic", .panic, false),
    Intrinsic("assert", .assert, false), Intrinsic("print", .print, false), Intrinsic("embed", .embed, false), Intrinsic("embed_dir", .embed_dir, false),
    Intrinsic("str_from_bytes", .from_bytes, false), Intrinsic("bytes", .to_bytes, false), Intrinsic("__argv", .argv, false),
    Intrinsic("unreachable", .unreachable, false), Intrinsic("sqrt", .sqrt, false), Intrinsic("__fmt_fields", .fmt_struct, false), Intrinsic("__fmt_elem_value", .fmt_elem, false), Intrinsic("__gpu_kernel", .gpu_kernel, false),
    Intrinsic("__hash_value", .hash, false), Intrinsic("__set_len", .setlen, false), Intrinsic("__call_raw", .callc, false),
    Intrinsic("shader", .shader, false), Intrinsic("__setjmp", .setjmp, false), Intrinsic("__longjmp", .longjmp, false), Intrinsic("__jump", .jump, false),
    Intrinsic("__clone_thread", .clone_thread, false), Intrinsic("__atomic_add", .atomic_add, false),
    Intrinsic("__atomic_cas", .atomic_cas, false), Intrinsic("__stack_ptr", .stack_ptr, false),
    Intrinsic("__cpu_features", .cpu_features, false), Intrinsic("__code_sync", .code_sync, false), Intrinsic("compute", .compute, false), Intrinsic("__compute_spirv", .compute_spirv, false), Intrinsic("__compute_textures", .compute_textures, false),
    Intrinsic("__read_fields", .read_fields, false), Intrinsic("__default_init", .default_init, false),
    Intrinsic("__json_fields", .json_fields, false),
]

last_checked = 0
const AUX2_PARTIAL = -10       # a call node that `@` makes a partial evaluation
callee_at = 0                  # the callee a call is resolving: a Dewy function name there is not called by itself
embedded_files: str[]          # actual compile-time inputs, including those used inside functions
intrinsic_names: int[]         # interned name -> intrinsic index + 1; 0 means no intrinsic

register_intrinsics = ():
    intrinsic_names = []
    loop i in 0.. and it in intrinsics:
        nm = intern(it.name)
        loop intrinsic_names.len() <= nm: intrinsic_names.push(0)
        intrinsic_names[nm] = i + 1
        universe[nm] = new_sym(nm, .builtin, int(it.id), 0)

intrinsic_of = (name: int) -> int:
    if name >= 0 and name < intrinsic_names.len(): return intrinsic_names[name] - 1
    -1

is_lit = (n: int) -> bool: has_flag(n, NF_LITERAL)
lit_default = (n: int) -> int:
    k = nodes[n].kind
    if k == .float_lit and nodes[n].sval != 0: return decimal_type(nodes[n].pos)
    if k == .float_lit: return T_FLOAT
    if k == .unary or k == .conv: return lit_default(int(nodes[n].a))
    if k == .binary:
        if lit_default(int(nodes[n].a)) == T_FLOAT or lit_default(int(nodes[n].b)) == T_FLOAT: return T_FLOAT
    if files[pos_file(nodes[n].pos)].is_dewy: return T_MATH_INT
    T_INT

ntype = (n: int) -> int: int(nodes[n].type)

# Decimal source text survives parsing until its numeric context is known.
# A float context consumes fval directly; otherwise construct exact BigInt
# parts, without parsing text or rounding through a float at run time.
decimal_cached_type = 0

decimal_type = (pos: int) -> int:
    if decimal_cached_type != 0: return decimal_cached_type
    ensure_bundled_import("rational.dewy", "$dewy_rational", pos)
    ty = bc_field(bc_ident("$dewy_rational", pos), "Rational", pos)
    decimal_cached_type = telem(check_expr(ty, 0))
    decimal_cached_type

word_rational_cached_type = 0

word_rational_type = (pos: int) -> int:
    if word_rational_cached_type != 0: return word_rational_cached_type
    ensure_bundled_import("rational.dewy", "$dewy_rational", pos)
    ty = bc_field(bc_ident("$dewy_rational", pos), "RationalWord", pos)
    word_rational_cached_type = telem(check_expr(ty, 0))
    word_rational_cached_type

# Rationals folded at compilation, by node: their normalized word parts.
rational_constants: {int: (int, int)}

# Does the value n of type from fit rational<int64> exactly, for every value?
word_rational_source = (n: int, from0: int) -> bool:
    from = prune(from0)
    if rational_constants.has(n): return true
    if not is_int(from): return false
    known, value = integer_constant(n)
    if known: return value >= 0 or types[from].sign or from == T_MATH_INT
    if from == T_MATH_INT: return false
    int_widens(from, T_INT)

# (node n, replaced by the bundled rational module's fname applied to its old content)
rational_wrap = (n: int, fname: str, to: int) -> int:
    source = nodes.len()
    nodes.push(nodes[n])
    add_flag(source, NF_CHECKED)
    pos = nodes[n].pos
    ensure_bundled_import("rational.dewy", "$dewy_rational", pos)
    nodes[n] = Node(kind = .call, pos = pos, a = i32(bc_field(bc_ident("$dewy_rational", pos), fname, pos)))
    set_list(n, [source])
    check_expr(n, to)
    n

decimal_part = (digits: str, pos: int) -> int:
    ensure_bundled_import("bigint.dewy", "$dewy_decimal_bigint", pos)
    negative = len(digits) > 0 and digits[0] == '-'
    limbs: u64[]
    loop c in digits:
        if c == '-' or c == '+': continue
        carry = u64(c - '0')
        loop i in [0..limbs.len()):
            word = limbs[i] * 10 + carry
            limbs[i] = word & 0xFFFFFFFF
            carry = word >> 32
        if carry != 0: limbs.push(carry)
    items: int[]
    loop limb in limbs:
        item = mk(.int_lit, pos)
        nodes[item].ival = int(limb)
        items.push(item)
    magnitude = mk(.array, pos)
    set_list(magnitude, items)
    sign = mk(.int_lit, pos)
    nodes[sign].ival = if limbs.len() == 0: 0 else if negative: -1 else: 1
    result = mk(.call, pos)
    nodes[result].a = i32(bc_field(bc_ident("$dewy_decimal_bigint", pos), "BigInt", pos))
    set_list(result, [sign, magnitude])
    result

# The normalized constant numerator/denominator (denominator nonzero, both
# above the minimum word) as a direct construction: no runtime reduction.
rational_constant_parts = (numerator: int, denominator: int) -> (int, int):
    let numerator = numerator
    let denominator = denominator
    if denominator < 0:
        numerator = -numerator
        denominator = -denominator
    common = quantity_gcd(numerator, denominator)
    if common > 1:
        numerator = numerator / common
        denominator = denominator / common
    if numerator == 0: denominator = 1
    (numerator, denominator)

rational_constant = (numerator: int, denominator: int, pos: int, word: bool = false) -> int:
    parts = rational_constant_parts(numerator, denominator)
    ensure_bundled_import("rational.dewy", "$dewy_rational", pos)
    decimal_type(pos)
    type_name = if word: "RationalWord" else: "Rational"
    result = mk(.call, pos)
    nodes[result].a = i32(bc_field(bc_ident("$dewy_rational", pos), type_name, pos))
    set_list(result, [bc_int(parts.0, pos), bc_int(parts.1, pos)])
    result

exact_decimal = (n: int) -> int:
    pos = nodes[n].pos
    text = lower(name_of(int(nodes[n].sval)))
    exponent = 0
    parts = split(text, "e")
    if parts.len() == 2:
        parsed = to_int(parts[1])
        if parsed == none: fatal(pos, "decimal exponent is too large")
        exponent = parsed!
    digits = parts[0]
    fraction = split(digits, ".")
    if fraction.len() == 2:
        exponent -= len(fraction[1])
        digits = fraction[0] + fraction[1]
    denominator = "1"
    if exponent > 0: digits += repeat("0", exponent)
    else if exponent < 0: denominator += repeat("0", -exponent)
    # Word-sized decimals fold to their reduced fraction at compilation.
    magnitude = digits
    negative = len(magnitude) > 0 and magnitude[0] == '-'
    if len(magnitude) > 0 and (magnitude[0] == '-' or magnitude[0] == '+'): magnitude = magnitude[1..]
    loop len(magnitude) > 1 and magnitude[0] == '0': magnitude = magnitude[1..]
    if len(magnitude) <= 18 and len(denominator) <= 19:
        if let top = to_int(magnitude):
            if let bottom = to_int(denominator):
                signed = if negative: -top else: top
                nodes[n] = nodes[rational_constant(signed, bottom, pos)]
                t = check_expr(n, 0)
                rational_constants[n] = rational_constant_parts(signed, bottom)
                return t
    ensure_bundled_import("rational.dewy", "$dewy_rational", pos)
    decimal_type(pos)
    numerator = decimal_part(digits, pos)
    divisor = decimal_part(denominator, pos)
    nodes[n] = Node(kind = .call, pos = pos, a = i32(bc_field(bc_ident("$dewy_rational", pos), "rational", pos)))
    set_list(n, [numerator, divisor])
    check_expr(n, 0)

# replace node n by a conversion of its old content
wrap_conv = (n: int, cv: CV, to: int):
    inner = nodes.len()
    nodes.push(nodes[n])
    nodes[n] = Node(kind = .conv, pos = nodes[inner].pos, a = i32(inner), aux = i32(int(cv)), type = i32(to), flags = i32(NF_CHECKED))

# ---------------- coercion ----------------
# Values already fixed to a scalar type can still be compile-time constants.
# This deliberately excludes calls and reads, whose effects must remain visible.
integer_constant = (n: int) -> (bool, int):
    if nodes[n].kind == .int_lit: return (true, nodes[n].ival)
    if nodes[n].kind != .conv or nodes[n].aux != i32(int(CV.int_)): return (false, 0)
    known, value = integer_constant(int(nodes[n].a))
    if not known: return (false, 0)
    t = prune(ntype(n))
    bits = int(types[t].bits)
    if bits < 64:
        if types[t].sign: value = (value << (64 - bits)) >> (64 - bits)
        else: value = value & ((1 << bits) - 1)
    (true, value)

check_integer_boundary = (n: int, from: int, to: int):
    if to == T_MATH_INT: return
    if from != T_MATH_INT and to != T_MATH_INT: return
    if int_widens(from, to): return
    known, value = integer_constant(n)
    if not known: return
    fits = int_fits(value, to)
    if not types[from].sign and value < 0 and types[to].sign: fits = false
    if not fits: fatal(nodes[n].pos, "integer overflow in constant conversion to {dt(to)}")

int_widens = (f: int, t: int) -> bool:
    if t == T_MATH_INT: return true
    if f == T_MATH_INT: return false
    fb = int(types[f].bits)
    tb = int(types[t].bits)
    if types[f].sign == types[t].sign: return tb >= fb
    if not types[f].sign and types[t].sign: return tb > fb
    false

# A literal can take the bundled BigInt's expected type without a runtime
# decimal conversion. Ordinary integer variables keep their fixed-width type.
dewy_bigint_literal_target = (n: int, t0: int) -> bool:
    if n == 0 or nodes[n].kind != .int_lit or not is_lit(n): return false
    if not files[pos_file(nodes[n].pos)].is_dewy: return false
    bundled_bigint_type(t0)

bundled_bigint_type = (t0: int) -> bool:
    t = prune(t0)
    if types[t].kind != .struct_: return false
    decl = int(structs[int(types[t].st)].decl)
    if name_of(int(nodes[decl].name)) != "BigInt": return false
    files[pos_file(nodes[decl].pos)].path == "{lib_dir}/bigint.dewy"

math_rep_type = (t0: int) -> bool:
    t = prune(t0)
    if types[t].kind != .struct_: return false
    decl = int(structs[int(types[t].st)].decl)
    name_of(int(nodes[decl].name)) == "__CTMathRep" and files[pos_file(nodes[decl].pos)].path == "{lib_dir}/math_eval.jo"

dewy_coerce_bigint_literal = (n: int, t: int):
    pos = nodes[n].pos
    negative = nodes[n].ival < 0 and not has_flag(n, NF_U64)
    magnitude = u64(nodes[n].ival)
    if negative: magnitude = 0 - magnitude
    sign = mk(.int_lit, pos)
    nodes[sign].type = i32(T_INT)
    nodes[sign].ival = if magnitude == 0: 0 else if negative: -1 else: 1
    add_flag(sign, NF_CHECKED)
    items: int[]
    loop magnitude != 0:
        item = mk(.int_lit, pos)
        nodes[item].type = i32(T_U64)
        nodes[item].ival = int(magnitude & 0xFFFFFFFF)
        add_flag(item, NF_CHECKED)
        items.push(item)
        magnitude = magnitude >> 32
    limbs = mk(.array, pos)
    nodes[limbs].type = i32(mk_array(T_U64))
    add_flag(limbs, NF_CHECKED)
    set_list(limbs, items)
    layout(t)
    nodes[n] = Node(kind = .call, pos = pos, aux = 2, type = i32(t), flags = i32(NF_CHECKED))
    set_list(n, [sign, limbs])

can_coerce = (n: int, from0: int, to0: int) -> bool:
    from = prune(from0)
    to = prune(to0)
    if type_eq(from, to): return true
    if from == T_MATH_INT and (math_rep_type(to) or (n != 0 and bundled_bigint_type(to))): return true
    if to == T_MATH_INT and (math_rep_type(from) or (n != 0 and bundled_bigint_type(from))): return true
    if n != 0 and is_float(to) and bundled_rational_type(from): return true
    # An integer promotes to the exact rational with the same value.
    if n != 0 and is_int(from) and bundled_rational_type(to): return true
    # rational<int64> widens to rational and rounds into a float context; a
    # value enters it only when it always fits (a word, a folded constant).
    if n != 0 and bundled_word_rational_type(from) and (bundled_rational_type(to) or is_float(to)): return true
    if n != 0 and bundled_word_rational_type(to) and word_rational_source(n, from): return true
    if from == T_NEVER: return true
    fk = types[from].kind
    tk = types[to].kind
    if fk == .refined or tk == .refined: return can_coerce(n, representation_type(from), representation_type(to))
    if refine_active and fk == .struct_ and tk == .struct_ and ref_record_conversion(from, to): return true
    if fk == .quantity or tk == .quantity:
        if fk == .var or tk == .var: return true
        if fk == .quantity and tk == .quantity:
            return types[from].st == types[to].st and (quantity_constant_fits(n, to) or can_coerce(0, quantity_base(from), quantity_base(to)))
        if tk != .opt and not is_union(to): return false
    if fk == .polyfn and tk == .fn_: return poly_matches(from, to)
    if has_var(from) or has_var(to):
        if fk == .var or tk == .var: return true
        if fk == tk and fk == .array:
            fe = prune(int(types[from].elem))
            te = prune(int(types[to].elem))
            return types[fe].kind == .var or types[te].kind == .var or type_eq(fe, te)
        if fk == .opt and tk == .opt: return true
    if n != 0 and is_lit(n):
        if nodes[n].kind == .float_lit and nodes[n].sval != 0 and bundled_rational_type(to): return true
        if dewy_bigint_literal_target(n, to): return true
        if nodes[n].kind == .int_lit and (tk == .int_ or tk == .float_): return true
        if nodes[n].kind == .float_lit and tk == .float_: return true
    if fk == .int_ and tk == .int_: return from == T_MATH_INT or to == T_MATH_INT or int_widens(from, to)
    if fk == .int_ and tk == .float_: return true
    if fk == .float_ and tk == .float_: return true
    if tk == .enum_ and not is_union(from) and is_union(to): return union_target(n, from, to) >= 0
    if is_union(from) and is_union(to): return union_within(from, to)
    if fk == .array and is_soa(to): return can_coerce(0, int(types[from].elem), soa_elem(to))
    if fk == .fixed and tk == .array: return type_eq(int(types[from].elem), int(types[to].elem))
    if tk == .array and is_nd(from): return type_eq(nd_elem(from), int(types[to].elem))
    if (fk == .callable or tk == .callable) and callable_fits(from, to): return true
    if fk == .fn_ and tk == .fn_ and callable_fits(from, to): return true
    if fk == .array and tk == .fixed:
        if n != 0 and fixed_literal_ok(n, to): return true
        return n != 0 and nodes[n].kind != .array and type_eq(int(types[from].elem), int(types[to].elem))
    if tk == .opt:
        if fk == .none_lit: return true
        if type_eq(from, int(types[to].elem)): return true
        if fk == .opt: return can_coerce(0, telem(from), telem(to))
        return can_coerce(n, from, int(types[to].elem))
    if fk == .null_ and (tk == .ptr or tk == .cfn): return true
    if fk == .ptr and tk == .ptr and (to == T_RAWPTR or from == T_RAWPTR): return true
    false

# every member of union a is one of union b's
union_within = (a: int, b: int) -> bool:
    loop m in union_members(a):
        if union_index(b, m) < 0: return false
    true

# the member of union u a value of type `from` becomes (an exact match first), or -1
union_target = (n: int, from: int, u: int) -> int:
    f = from
    if n != 0 and is_lit(n): f = lit_default(n)
    ms = union_members(u)
    loop i in 0.. and m in ms:
        if type_eq(m, f): return i
    loop i in 0.. and m in ms:
        if can_coerce(n, from, m): return i
    -1

# replace node n by the union value holding it as member vi
wrap_union = (n: int, vi: int, to: int):
    inner = nodes.len()
    nodes.push(nodes[n])
    nodes[n] = Node(kind = .call, pos = nodes[inner].pos, aux = 3, aux2 = i32(vi), type = i32(to), flags = i32(NF_CHECKED))
    set_list(n, [inner])

# can integer type t hold v?
int_fits = (v: int, t: int) -> bool:
    bits = int(types[t].bits)
    if bits >= 64: return types[t].sign or v >= 0
    if types[t].sign: return v >= -(1 << (bits - 1)) and v <= (1 << (bits - 1)) - 1
    v >= 0 and v <= (1 << bits) - 1

# can integer type t hold literal n? (one above the i64 range fits u64, and the 64-bit signed
# types as its bits, e.g. hash constants)
lit_fits = (n: int, t: int) -> bool:
    if t == T_MATH_INT: return true
    if has_flag(n, NF_U64):
        if files[pos_file(nodes[n].pos)].is_dewy:
            return int(types[t].bits) >= 64 and not types[t].sign
        return int(types[t].bits) >= 64
    int_fits(nodes[n].ival, t)

# coerce node n to `target` (rewrites n in place); returns n
coerce = (n: int, target: int) -> int:
    if target == 0: return n
    if refine_active and types[prune(target)].kind == .refined: return refine_coerce(n, target)
    if nodes[n].kind == .float_lit and nodes[n].sval != 0 and is_lit(n) and tkind(target) == .struct_:
        exact_decimal(n)
    if charlike(n) and is_int(target):
        charlike_to_int(n)
        nodes[n].type = i32(target)
        return n
    if effects_active and callable_contract(target) != 0: nodes[n].type = i32(effect_infer_callable(n, target))
    from = prune(ntype(n))
    to = prune(target)
    if from == 0: ice("unchecked expression at {pos_str(nodes[n].pos)}")
    # Settled identical scalar/aggregate types require no conversion node.
    if from == to and not is_lit(n): return n
    if from == T_NEVER:
        # (what never comes back taken as a value, "a" + panic(...): marked, so code is made for
        # it as for any value of that type, never used)
        if to != T_NEVER and types[to].kind != .void_ and types[to].kind != .var and types[to].kind != .param: wrap_conv(n, CV.none_, to)
        return n
    tk = types[to].kind
    if (from == T_MATH_INT and math_rep_type(to)) or (to == T_MATH_INT and math_rep_type(from)):
        wrap_conv(n, .none_, to)
        return n
    if to == T_MATH_INT and bundled_bigint_type(from):
        wrap_conv(n, .big2math, to)
        return n
    if from == T_MATH_INT and bundled_bigint_type(to):
        wrap_conv(n, .math2big, to)
        return n
    if types[from].kind == .quantity and tk == .quantity:
        return quantity_coerce(n, to)
    if bundled_word_rational_type(from) and bundled_rational_type(to): return rational_wrap(n, "_widen", to)
    if bundled_word_rational_type(from) and tk == .float_:
        convert = if to == T_F32: "_word_float32" else: "_word_float64"
        return rational_wrap(n, convert, to)
    if bundled_word_rational_type(to) and word_rational_source(n, from):
        pos = nodes[n].pos
        ensure_bundled_import("rational.dewy", "$dewy_rational", pos)
        if let parts = rational_constants.get(n):
            nodes[n] = nodes[rational_constant(parts.0, parts.1, pos, true)]
        else:
            source = nodes.len()
            nodes.push(nodes[n])
            add_flag(source, NF_CHECKED)
            nodes[n] = Node(kind = .call, pos = pos, a = i32(bc_field(bc_ident("$dewy_rational", pos), "RationalWord", pos)))
            set_list(n, [source, bc_int(1, pos)])
        check_expr(n, to)
        return n
    if tk == .struct_ and is_int(from) and bundled_rational_type(to):
        source = nodes.len()
        nodes.push(nodes[n])
        pos = nodes[n].pos
        ensure_bundled_import("rational.dewy", "$dewy_rational", pos)
        nodes[n] = Node(kind = .call, pos = pos, a = i32(bc_field(bc_ident("$dewy_rational", pos), "rational", pos)))
        set_list(n, [source])
        check_expr(n, to)
        return n
    if tk == .float_ and bundled_rational_type(from):
        source = nodes.len()
        nodes.push(nodes[n])
        name = if to == T_F32: "to_float32" else: "to_float64"
        callee = bc_field(source, name, nodes[n].pos)
        nodes[n] = Node(kind = .call, pos = nodes[n].pos, a = i32(callee))
        check_expr(n, to)
        return n
    if types[from].kind == .polyfn and tk == .fn_:
        source = nodes.len()
        nodes.push(nodes[n])
        fn_value(n, to, closure = source)
        from = prune(ntype(n))
    if dewy_bigint_literal_target(n, to):
        dewy_coerce_bigint_literal(n, to)
        return n
    if is_lit(n):
        k = nodes[n].kind
        if k == .int_lit and tk == .int_:
            v = nodes[n].ival
            if not lit_fits(n, to):
                if has_flag(n, NF_U64): fatal(nodes[n].pos, "value {u64(v)} does not fit in {dt(to)}")
                fatal(nodes[n].pos, "value {v} does not fit in {dt(to)}")
            nodes[n].type = i32(to)
            clear_flag(n, NF_LITERAL)
            return n
        if k == .int_lit and tk == .float_:
            nodes[n].kind = .float_lit
            nodes[n].fval = f64(nodes[n].ival)
            if has_flag(n, NF_U64): nodes[n].fval = f64(u64(nodes[n].ival))
            nodes[n].type = i32(to)
            clear_flag(n, NF_LITERAL)
            return n
        if k == .float_lit and tk == .float_:
            if nodes[n].sval != 0 and nodes[n].fval - nodes[n].fval != 0.0: fatal(nodes[n].pos, "real literal exceeds float64")
            nodes[n].type = i32(to)
            clear_flag(n, NF_LITERAL)
            return n
        if tk == .opt and is_numeric(int(types[to].elem)):
            coerce(n, int(types[to].elem))
            wrap_conv(n, .opt, to)
            return n
        if tk == .var:
            d = lit_default(n)
            nodes[n].type = i32(d)
            clear_flag(n, NF_LITERAL)
            unify(to, d)
            return n
        if tk == .vec and nodes[n].kind == .int_lit or tk == .vec and nodes[n].kind == .float_lit: pass
    if type_eq(from, to):
        clear_flag(n, NF_LITERAL)
        return n
    fk = types[from].kind
    if refine_active and fk == .struct_ and tk == .struct_ and ref_record_conversion(from, to): return ref_convert_record(n, to)
    if fk == .array and is_soa(to) and can_coerce(0, int(types[from].elem), soa_elem(to)):
        soa_from_array(n, to)
        return n
    if fk == .fixed and tk == .array and type_eq(int(types[from].elem), int(types[to].elem)):
        wrap_conv(n, .fixed2arr, to)
        return n
    if fk == .callable or tk == .callable:
        if not callable_fits(from, to): fatal(nodes[n].pos, "cannot prove callable effect contract")
        wrap_conv(n, .none_, to)
        return n
    if fk == .fn_ and tk == .fn_ and callable_fits(from, to):
        nodes[n].type = i32(to)
        return n
    if tk == .array and is_nd(from) and type_eq(nd_elem(from), int(types[to].elem)):
        # a 1-D T[,] where a T[] is expected: its elements (checked to be 1-D when it runs)
        inner = nodes.len()
        nodes.push(nodes[n])
        nodes[n] = nodes[bc_call("__nd_1d", [inner], nodes[n].pos)]
        check_expr(n, to)
        return n
    if fk == .array and tk == .fixed:
        if nodes[n].kind != .array and type_eq(int(types[from].elem), int(types[to].elem)):
            wrap_conv(n, .arr2fixed, to)
            return n
        if not fixed_literal_ok(n, to):
            els = "{fixed_len(to)} elements"
            if fixed_len(to) == 1: els = "1 element"
            fatal(nodes[n].pos, "type mismatch: expected {dt(to)}, found {dt(from)} (a fixed-size array is made from a literal with {els})")
        fixed_literal(n, to)
        return n
    if tk == .enum_ and not is_union(from) and is_union(to):
        vi = union_target(n, from, to)
        if vi < 0: fatal(nodes[n].pos, "type mismatch: expected {dt(to)}, found {dt(from)}")
        coerce(n, union_members(to)[vi])
        wrap_union(n, vi, to)
        return n
    if is_union(from) and is_union(to) and union_within(from, to):
        wrap_conv(n, .union_, to)
        return n
    if has_var(from) or has_var(to):
        if unify(from, to): return n
        if tk == .opt and unify(from, int(types[to].elem)):
            wrap_conv(n, .opt, to)
            return n
    if fk == .int_ and tk == .int_:
        if from == T_MATH_INT or to == T_MATH_INT:
            check_integer_boundary(n, from, to)
            wrap_conv(n, .int_, to)
            return n
        if int_widens(from, to):
            # (a + b with a, b: u8, put in an int: added as u8s first, so 200 + 200 is 144)
            if nodes[n].kind == .binary and int(types[from].bits) <= 16 and int(types[to].bits) > int(types[from].bits) and not pos_in_lib(nodes[n].pos):
                bop = nodes[n].op as Tok
                if bop == .plus or bop == .minus or bop == .star or bop == .shl:
                    an = "x"
                    if nodes[int(nodes[n].a)].kind == .ident: an = name_of(int(nodes[int(nodes[n].a)].name))
                    art = if dt(to)[0] == 'i': "an" else: "a"
                    warn(nodes[n].pos, "this is worked out as a {dt(from)}, which wraps around past its range, before it becomes {art} {dt(to)}: `{dt(to)}({an}) {tok_text(bop)} ...` works in {dt(to)}")
            wrap_conv(n, .int_, to)
            return n
        fatal(nodes[n].pos, "cannot implicitly convert {dt(from)} to {dt(to)} (use {dt(to)}(x) to convert explicitly)")
    if fk == .int_ and tk == .float_:
        if nodes[n].kind == .binary and nodes[n].op == i32(int(Tok.slash)):
            # (hits / shots * 100.0: the division drops the fraction before it becomes a float)
            a = int(nodes[n].a)
            an = "a"
            if nodes[a].kind == .ident: an = name_of(int(nodes[a].name))
            warn(nodes[n].pos, "this divides whole numbers, dropping the fraction (7 / 2 is 3) before it becomes a float: `f64({an}) / ...` keeps the fraction")
        wrap_conv(n, .int2float, to)
        return n
    if fk == .float_ and tk == .float_:
        wrap_conv(n, .float_, to)
        return n
    if tk == .opt:
        if fk == .none_lit:
            nodes[n].type = i32(to)
            return n
        # T may itself be optional: wrapping it must preserve a present none.
        # A bare none above still means the outer optional is absent.
        if type_eq(from, int(types[to].elem)):
            wrap_conv(n, .opt, to)
            return n
        if fk == .opt:
            if tkind(int(types[from].elem)) == .var:
                unify(int(types[from].elem), int(types[to].elem))
                nodes[n].type = i32(to)
                return n
            if can_coerce(0, telem(from), telem(to)):
                source = nodes.len()
                nodes.push(nodes[n])
                add_flag(source, NF_CHECKED)
                pos = nodes[n].pos
                name = "$optional{n}"
                yes = bc_block([bc_stmt(bc_ident(name, pos), pos)], pos)
                no = bc_block([bc_stmt(mk(.none_lit, pos), pos)], pos)
                nodes[n] = Node(kind = .iflet, pos = pos, a = i32(source), b = i32(yes), c = i32(no), name = i32(intern(name)))
                check_expr(n, to)
                return n
            fatal(nodes[n].pos, "type mismatch: expected {dt(to)}, found {dt(from)}")

        coerce(n, int(types[to].elem))
        wrap_conv(n, .opt, to)
        return n
    if fk == .null_ and (tk == .ptr or tk == .cfn):
        nodes[n].type = i32(to)
        return n
    if fk == .ptr and tk == .ptr and (to == T_RAWPTR or from == T_RAWPTR):
        wrap_conv(n, .ptr, to)
        return n
    if fk == .typeval: fatal(nodes[n].pos, "expected a value of type {dt(to)}, found a type name")
    why = variant_hint(n, to)
    if fk == .opt and tk != .opt: why = if dewy_at(nodes[n].pos): " (this value may be none; check it with `is?none` before using its value)" else: " (this value may be none; narrow it before using its value)"
    # (shown += c with c from a loop over a string: a character's code)
    if len(why) == 0 and tkind(to) == .str_ and type_eq(prune(from), T_U8): why = " (a string's elements are character codes, numbers: `chr(c)` is the character as text)"
    if fk == .void_: why = void_rec_hint(n)
    if fk == .null_: why = " (`null` is for C's pointers; a value that may be missing is `none`)"
    if fk == .fn_ and tk == .fn_ and int(types[prune(from)].nargs) == int(types[prune(to)].nargs):
        # (which part differs: update = (dt: f32) where (dt: f64) is wanted)
        loop i in [0..int(types[prune(from)].nargs)):
            if not type_eq(targ(prune(from), i), targ(prune(to), i)):
                why = " (parameter {i + 1} is {dt(targ(prune(from), i))}, where {dt(targ(prune(to), i))} is wanted)"
                break
    dewy = dewy_at(nodes[n].pos)
    if fk == .opt and tk == .bool_: why = if dewy: " (an optional is not true or false: `x isnt? none` asks, and narrows x inside `if x isnt? none \{ }`)" else: " (an optional is not true or false: `if let v = x:` runs when there is a value and names it, `x != none` asks)"
    if fk == .float_ and tk == .int_: why = if dewy: " (int64(x) makes it a whole number, dropping the fraction)" else: " (int(x) makes it a whole number, dropping the fraction)"
    if tk == .bool_ and (fk == .array or fk == .str_ or is_map_type(from)): why = if dewy: " (not true or false: `xs.length >? 0` asks if it has anything)" else: " (not true or false: `xs.len() > 0` asks if it has anything)"
    if tk == .bool_ and (fk == .int_ or fk == .float_): why = if dewy: " (a number is not true or false: `x not=? 0` asks)" else: " (a number is not true or false: `x != 0` asks)"
    if tk == .bool_ and fk == .int_ and nodes[n].kind == .int_lit: why = if dewy: " (to do something {nodes[n].ival} times: `loop i in [1..{nodes[n].ival}] \{ }`)" else: " (to do something {nodes[n].ival} times: `loop i in [1..{nodes[n].ival}]:`)"
    fatal(nodes[n].pos, "type mismatch: expected {dt(to)}, found {dt(from)}{why}{coerce_hint}")
    n

# an array literal that can be the fixed-size array type `to` (its elements are checked later)
fixed_literal_ok = (n: int, to: int) -> bool:
    if nodes[n].kind != .array or nodes[n].aux == 2: return false
    if nodes[n].b != 0: return true
    nkids(n) == 0 or nkids(n) == fixed_len(to)

# make array literal n (already checked as T[]) the fixed-size array type `to`
fixed_literal = (n: int, to: int):
    et = int(types[prune(to)].elem)
    if refine_active and nkids(n) == 0 and fixed_len(to) > 0 and ref_storage_contract(et):
        value = struct_default(et, nodes[n].pos)
        if value != 0:
            set_list(n, [value])
            nodes[n].b = i32(bc_int(fixed_len(to), nodes[n].pos))
            nodes[int(nodes[n].b)].type = i32(T_INT)
    if nodes[n].b != 0:
        c = int(nodes[n].b)
        if nodes[c].kind != .int_lit or nodes[c].ival != fixed_len(to): fatal(nodes[n].pos, "a fixed-size array of {fixed_len(to)} elements needs the count {fixed_len(to)} here")
        coerce(kid(n, 0), et)
    else:
        loop i in [0..nkids(n)): coerce(kid(n, i), et)
    nodes[n].type = i32(to)
    clear_flag(n, NF_LITERAL)

check_to = (n: int, target: int) -> int:
    check_expr(n, target)
    coerce(n, target)
    target

finalize_literal = (n: int) -> int:
    if is_lit(n): coerce(n, lit_default(n))
    ntype(n)

num_join = (a0: int, b0: int) -> int:
    a = prune(a0)
    b = prune(b0)
    if type_eq(a, b): return a
    ka = types[a].kind
    kb = types[b].kind
    if ka == .float_ and kb == .float_:
        if int(types[a].bits) >= int(types[b].bits): return a
        return b
    if ka == .float_ and kb == .int_: return a
    if kb == .float_ and ka == .int_: return b
    if ka == .int_ and kb == .int_:
        if a == T_MATH_INT or b == T_MATH_INT: return T_MATH_INT
        if int_widens(a, b): return b
        if int_widens(b, a): return a
    0

join_types = (a: int, b: int, pos: int) -> int:
    ta = prune(ntype(a))
    tb = prune(ntype(b))
    if ta == T_NEVER: return finalize_literal(b)
    if tb == T_NEVER: return finalize_literal(a)
    la = is_lit(a)
    lb = is_lit(b)
    if la and not lb and can_coerce(a, ta, tb):
        coerce(a, tb)
        return tb
    if lb and not la and can_coerce(b, tb, ta):
        coerce(b, ta)
        return ta
    if la and lb:
        t = lit_default(a)
        if nodes[a].kind == .float_lit: t = lit_default(a)
        else if nodes[b].kind == .float_lit: t = lit_default(b)
        coerce(a, t)
        coerce(b, t)
        return t
    if is_numeric(ta) and is_numeric(tb):
        j = num_join(ta, tb)
        if j == 0: fatal(pos, "cannot mix {dt(ta)} and {dt(tb)}; convert one explicitly")
        coerce(a, j)
        coerce(b, j)
        return j
    if types[ta].kind == .none_lit or (types[ta].kind == .opt and tkind(int(types[ta].elem)) == .var):
        t = tb
        if types[tb].kind != .opt: t = mk_opt(tb)
        coerce(a, t)
        coerce(b, t)
        return t
    if types[tb].kind == .none_lit or (types[tb].kind == .opt and tkind(int(types[tb].elem)) == .var):
        t = ta
        if types[ta].kind != .opt: t = mk_opt(ta)
        coerce(a, t)
        coerce(b, t)
        return t
    if types[ta].kind == .opt and can_coerce(b, tb, ta):
        coerce(b, ta)
        return ta
    if types[tb].kind == .opt and can_coerce(a, ta, tb):
        coerce(a, tb)
        return tb
    coerce(b, ta)
    ta

# ---------------- places ----------------
cp_inner = 0           # > 0 while checking the base of an element or field being written

# (a private name of a module this one uses: say so)
private_hint = (name: int) -> str:
    m = cur_mod()
    if m < 0 or not is_private(name) or modules[m].is_prelude: return ""
    loop u in modules[m].uses:
        if not modules[u].is_prelude and modules[u].names.get(name) != none:
            f = files[int(modules[u].file)].path
            s = rfind(f, "/")
            if s >= 0: f = f[s + 1..]
            return " (it is private to {f}: `use` leaves out names starting with _; `from '{f}' import {name_of(name)}` brings it in)"
    ""

# (helper() whose file the program has, but not `use`d by this one: `use` brings in the names of
# the file it names only, not those of the files that one uses)
unused_file_hint = (name: int) -> str:
    m = cur_mod()
    if m < 0 or modules[m].is_prelude or is_private(name): return ""
    loop o in [0..modules.len()):
        if o == m or modules[o].is_prelude or modules[o].names.get(name) == none or modules[o].decls.len() == 0: continue
        gf = int(modules[o].file)
        lf = int(modules[m].file)
        if gf < 0 or lf < 0 or pos_in_lib(nodes[modules[o].decls[0]].pos): continue
        # (a module this file imports: its names are written after its name)
        loop k, sy in modules[m].names:
            if syms[sy].kind == .module and int(syms[sy].ref) == o: return " (it is {name_of(k)}'s: `{name_of(k)}.{name_of(name)}`)"
        shown = files[gf].path
        if starts_with(shown, files[lf].dir + "/"): shown = shown[len(files[lf].dir) + 1..]
        return " (it is in {shown}, which this file does not use: `use '{shown}'` at its top)"
    ""

# m[k] for a map m (a call of its `[]`)
is_map_get = (n: int) -> bool:
    if nodes[n].kind != .call or nodes[n].aux != 0 or nkids(n) != 2 or nodes[n].sym == 0: return false
    d = int(fns[int(nodes[n].sym)].decl)
    if d == 0 or name_of(int(nodes[d].name)) != "[]" or not decl_in_prelude(d): return false
    mt = prune(ntype(kid(n, 0)))
    types[mt].kind == .struct_ and structs[int(types[mt].st)].name == "Map"

# a copy of a place expression (variables, fields, elements) to evaluate it again
copy_place = (n: int) -> int:
    c = nodes.len()
    nodes.push(nodes[n])
    k = nodes[n].kind
    if k == .field or k == .index: nodes[c].a = i32(copy_place(int(nodes[n].a)))
    else if k == .call and nkids(n) > 0: set_list(c, [copy_place(kid(n, 0))] + kids(n)[1..])
    c

# m[k] changed in place (m[k] += 1, m[k].push(x), m[k].x = 5, loop mut x in m[k]): the value
# stored in m, m.vals[__map_entry(m, k)], where a missing key is added first
map_elem_place = (n: int):
    pos = nodes[n].pos
    m = kid(n, 0)
    key = kid(n, 1)
    mt = prune(ntype(m))
    vt = struct_targ(int(types[mt].st), 1)
    mc = copy_place(m)
    add_flag(mc, NF_MUT)
    args = [mc, key]
    pv = prune(vt)
    # (Dewy: the key must be there, as for reading m[k]; nothing is invented for a missing one)
    present = files[pos_file(pos)].is_dewy
    if present: pass
    else if types[pv].kind == .struct_ and not is_map_type(pv):
        # (a struct with default field values starts with them)
        si = int(types[pv].st)
        check_struct_fields(si)
        has_def = false
        loop i in [0..int(structs[si].nfields)):
            if fields[int(structs[si].fields) + i].defval != 0: has_def = true
        if has_def:
            d = mk(.call, pos)
            struct_ctor_zero(d, pv, int(structs[si].decl))
            add_flag(d, NF_CHECKED)
            args.push(d)
    entry = "__map_entry"
    if present: entry = "__map_entry_present"
    call = bc_call(entry, args, pos)
    check_expr(call, 0)
    call = last_checked
    f = mk(.field, pos)
    nodes[f].a = i32(m)
    nodes[f].name = i32(intern("vals"))
    check_expr(f, 0)
    f = last_checked
    nodes[n] = Node(kind = .index, pos = pos, a = i32(f), b = i32(call), type = i32(vt), flags = i32(NF_CHECKED | NF_INBOUNDS))

is_map_type = (t: int) -> bool: types[prune(t)].kind == .struct_ and structs[int(types[prune(t)].st)].name == "Map"

is_map_entries_type = (t: int) -> bool:
    p = prune(t)
    if types[p].kind != .struct_: return false
    st = int(types[p].st)
    if structs[st].name != "__MapEntries": return false
    d = int(structs[st].decl)
    d != 0 and files[pos_file(nodes[d].pos)].path == lib_dir + "/core/map.jo"

# The method whose object is being checked as a place, for its diagnostics.
place_method = 0
place_fatal = (pos: int, message: str):
    if place_method != 0: fatal(pos, "'{name_of(place_method)}' changes its object: {message}")
    fatal(pos, message)

check_place = (n: int, for_mut: bool):
    if is_map_get(n): map_elem_place(n)
    k = nodes[n].kind
    if k == .ident:
        if nodes[n].aux == i32(int(SK.local)):
            l = int(nodes[n].sym)
            f = int(locals[l].flags)
            nm = name_of(int(locals[l].name))
            if f & LF_ALIAS != 0 and locals[l].alias != 0 and narrowed_var(l) == 0:
                alias = int(locals[l].alias)
                if nodes[alias].kind == .unwrap or nodes[alias].kind == .narrow:
                    # A narrowed field path still writes its owning binding.
                    # In particular, a private capture's environment must be
                    # copied when mutation goes through an optional child.
                    locals[l].flags |= i32(LF_ASSIGNED)
                    check_place(alias, for_mut)
                    return
            if f & LF_SOAELEM != 0: fatal(nodes[n].pos, "'{nm}' stands for an element of a soa array: assign it a whole value (in `loop mut`) or change its fields")
            # a closure modifying a variable it captured modifies the variable itself
            # (and a narrowed name stands for its variable, which a closure may have captured)
            r = l
            via_closure = false
            loop true:
                if int(locals[r].flags) & LF_CAPTURE != 0 and int(locals[r].flags) & LF_VALUECAP == 0:
                    r = int(locals[r].outer)
                    via_closure = true
                else if narrowed_var(r) != 0: r = narrowed_var(r)
                else: break
            rf = int(locals[r].flags)
            if rf & LF_CONST != 0: place_fatal(nodes[n].pos, "cannot modify const '{nm}'; copy it with `let {nm} = {nm}`")
            ag = alias_global(r)
            if ag >= 0 and readonly_global(ag): place_fatal(nodes[n].pos, "cannot modify const '{nm}'")
            if rf & LF_PARAM != 0 and rf & LF_MUTPARAM == 0: place_fatal(nodes[n].pos, "cannot modify parameter '{nm}' (parameters are read-only; {jd(nodes[n].pos, "mark it `mut`", "take it by place, `@{nm}`,")} or copy it with `let {nm} = {nm}`)")
            if rf & LF_BYREF != 0 and via_closure: fatal(nodes[n].pos, "cannot modify loop variable '{nm}', a copy of an element, and the function changing it runs later: change the element by its position, {jd(nodes[n].pos, "`loop i in 0.. and {nm} in xs:` and then `(): xs[i]...`", "`loop i in 0.. and {nm} in xs \{ ... }` and then `() => xs[i]...`")} in the function")
            if rf & LF_BYREF != 0: place_fatal(nodes[n].pos, "cannot modify loop variable '{nm}' (use `{mutable_loop_syntax(nodes[n].pos)}` to modify elements)")
            nf = f | LF_ASSIGNED
            if cp_inner == 0: nf |= LF_RESIZED
            if for_mut and f & LF_CAPTURE == 0: nf |= LF_ADDR
            locals[l].flags = i32(nf)
            if r != l:
                rf |= LF_ASSIGNED
                if cp_inner == 0: rf |= LF_RESIZED
                locals[r].flags = i32(rf)
            note_write(r, via_closure, nodes[n].pos)
            if ag >= 0: note_global_write(ag)
            return
        if nodes[n].aux == i32(int(SK.global)):
            if readonly_global(int(nodes[n].sym)): place_fatal(nodes[n].pos, "cannot modify const '{name_of(int(nodes[n].name))}'")
            note_global_write(int(nodes[n].sym))
            return
        fatal(nodes[n].pos, "cannot assign to '{name_of(int(nodes[n].name))}'")
    if k == .field:
        bt = prune(ntype(int(nodes[n].a)))
        if types[bt].kind == .ptr: return
        if nodes[n].aux == -4:
            s = name_of(int(nodes[n].name))
            loop i in [0..len(s)):
                loop j in [0..i):
                    if s[i] == s[j]: fatal(nodes[n].pos, "cannot assign to '.{s}': it names a component twice")
            if for_mut and not swizzle_run(n): fatal(nodes[n].pos, "'.{s}' is not a run of components in order (as .xy or .yzw are), so it cannot be passed as {jd(nodes[n].pos, "a `mut`", "an `@`")} argument")
        cp_inner += 1
        check_place(int(nodes[n].a), for_mut)
        cp_inner -= 1
        return
    if k == .index:
        if has_flag(n, NF_RDONLY): fatal(nodes[n].pos, "cannot modify loop variable '{name_of(int(nodes[n].name))}' (use `{mutable_loop_syntax(nodes[n].pos)}`)")
        bt = prune(ntype(int(nodes[n].a)))
        bk = types[bt].kind
        if bk == .ptr: return
        if bk == .str_: fatal(nodes[n].pos, "a string's characters cannot be changed in place: make a new string, `s = s[..i) + \"x\" + s[i + 1..]`, or change `cs = chars(s)` and `join(cs)` it back")
        if bk == .fixed and nodes[n].aux == 1: fatal(nodes[n].pos, "a fixed-array slice is a copy; pass the whole array as a mutable argument")
        cp_inner += 1
        if bk == .vec or bk == .fixed:
            check_place(int(nodes[n].a), for_mut)
            cp_inner -= 1
            return
        if bk != .array: fatal(nodes[n].pos, "cannot assign to this index expression")
        if nodes[n].aux == 1: fatal(nodes[n].pos, "cannot assign to a slice")
        check_place(int(nodes[n].a), for_mut)
        cp_inner -= 1
        return
    if k == .unwrap or k == .narrow:
        # (x!.hp = 7: the value inside the optional or union, in place)
        cp_inner += 1
        check_place(int(nodes[n].a), for_mut)
        cp_inner -= 1
        return
    if for_mut and place_method != 0: fatal(nodes[n].pos, "'{name_of(place_method)}' changes its object, so it is called on a variable or a field, not on a temporary value")
    if for_mut: fatal(nodes[n].pos, "{jd(nodes[n].pos, "a `mut`", "an `@`")} argument must be a variable, field or element")
    # (w.pos(b).y = 3: a value a function gave back, changed where nothing keeps it)
    if k == .call:
        fnm = ""
        fm = -1
        cal = int(nodes[n].a)
        if cal != 0 and (nodes[cal].kind == .ident or nodes[cal].kind == .field): fnm = name_of(int(nodes[cal].name))
        if nodes[n].sym > 0 and int(nodes[n].sym) < fns.len() and fns[int(nodes[n].sym)].decl != 0:
            fd = int(fns[int(nodes[n].sym)].decl)
            fnm = name_of(int(nodes[fd].name))
            fm = int(nodes[fd].mod)
        if len(fnm) > 0:
            setter = ""
            if lookup(intern("set_{fnm}")) != 0 or (fm >= 0 and modules[fm].names.get(intern("set_{fnm}")) != none): setter = ": `set_{fnm}(...)` changes it"
            fatal(nodes[n].pos, "this is a copy that {fnm}(...) gave back, so changing it changes nothing{setter}")
    # (const gens = [1, 2], then gens.push(3): a const is its value, written where it is used)
    if k == .array or k == .int_lit or k == .float_lit or k == .str_lit or k == .map_lit or (k == .ident and nodes[n].aux == i32(int(SK.const_))):
        fatal(nodes[n].pos, "this is a const, which never changes: made without `const`, it is a variable, which can")
    fatal(nodes[n].pos, "cannot assign to this expression")

# Raw addresses can write without a checked assignment. Keep their
# owning bindings out of read-only view optimizations, and make copied private
# closure environments independent even when their only write is through a pointer.
note_storage_access = (n: int):
    k = nodes[n].kind
    if k == .field or k == .index or k == .unwrap or k == .narrow:
        note_storage_access(int(nodes[n].a))
    else if k == .ident and nodes[n].aux == i32(int(SK.local)):
        l = int(nodes[n].sym)
        locals[l].flags |= i32(LF_EXPOSED)
        if int(locals[l].flags) & LF_ALIAS != 0 and locals[l].alias != 0:
            note_storage_access(int(locals[l].alias))

# ---------------- type expressions written as expressions ----------------
expr_as_type = (e: int) -> int:
    k = nodes[e].kind
    if k == .field and reflect_active and reflect_member(e): return telem(ntype(e))
    if k == .ident:
        tn = mk(.tname, nodes[e].pos)
        nodes[tn].name = nodes[e].name
        return resolve_type(tn)
    if k == .index and nodes[int(nodes[e].a)].kind == .ident:
        s = lookup(int(nodes[int(nodes[e].a)].name))
        if s == 0 or (syms[s].kind != .struct_ and syms[s].kind != .enum_): fatal(nodes[e].pos, "expected a type")
        targs: int[]
        if nodes[e].b != 0: targs.push(expr_as_type(int(nodes[e].b)))
        else:
            loop i in [0..nkids(e)): targs.push(expr_as_type(kid(e, i)))
        d = int(syms[s].ref)
        if targs.len() != nkids2(d): fatal(nodes[e].pos, "wrong number of type arguments")
        return get_struct_inst(d, targs)
    if k == .array and nkids(e) == 1: return mk_array(expr_as_type(kid(e, 0)))
    # ({str: P}: a map type, written where an expression is parsed, as from_json[{str: P}])
    if k == .map_lit and nkids(e) == 1:
        pr = kid(e, 0)
        s = prelude.get(intern("Map")) ?? 0
        if s != 0: return get_struct_inst(int(syms[s].ref), [expr_as_type(int(nodes[pr].a)), expr_as_type(int(nodes[pr].b))])
    fatal(nodes[e].pos, "expected a type")
    0

# ---------------- calls ----------------
struct Cand:
    decl: int
    sig: FnSig
    args: int[]
    binds: int[]
    cost: int
    ok: bool

# the enum `.name` means where a value of type t is expected: t itself, or (t a union) the one
# member enum with that variant
variant_enum = (t0: int, name: int) -> int:
    t = prune(t0)
    if not is_union(t): return t
    found = 0
    loop m in union_members(t):
        pm = prune(m)
        if types[pm].kind == .enum_ and not is_union(pm) and find_variant(int(types[pm].st), name) >= 0:
            if found != 0: return t
            found = pm
    if found == 0: return t
    found

dewy_set_literal = (a: int) -> bool:
    nodes[a].kind == .call and nodes[a].type == 0 and nkids(a) == 1 and nodes[int(nodes[a].a)].kind == .ident and name_of(int(nodes[int(nodes[a].a)].name)) == "__dewy_set"

oversized_literal = (a: int) -> bool:
    if nodes[a].kind == .unary and nodes[a].op == i32(int(Tok.minus)): return oversized_literal(int(nodes[a].a))
    nodes[a].kind == .call and nodes[a].aux2 == -1

ctx_dependent = (a: int) -> bool:
    if oversized_literal(a): return true
    k = nodes[a].kind
    if dewy_set_literal(a): return true
    if k == .ident or k == .field or k == .typeapply: return has_flag(a, NF_FNREF_ARG)
    if k == .dotname: return nodes[a].type == 0        # (E.v is a dotname already typed)
    if k == .call and nodes[a].type == 0 and nodes[int(nodes[a].a)].kind == .dotname: return true     # .v(args)
    if k == .lambda or k == .none_lit or k == .hole: return true
    if k == .record_lit: return true
    if (k == .if_ or k == .match_) and not has_flag(a, NF_CHECKED) and files[pos_file(nodes[a].pos)].is_dewy: return true
    if k == .block and has_flag(a, NF_COMPREHENSION): return true
    if k == .array:
        if nkids(a) == 0: return nodes[a].b == 0
        # Dewy array literals take their element type from the selected call.
        # Check their children first, but do not freeze the array at int[] just
        # because its numeric literals have not received a parameter type yet.
        if nodes[a].type == 0 and not has_flag(a, NF_CHECKED) and files[pos_file(nodes[a].pos)].is_dewy: return true
        # ([.key(.space), .button(.a)]: its elements take their type from the parameter's)
        loop e in kids(a):
            if ctx_dependent(e): return true
        return false
    if k == .map_lit: return nkids(a) == 0 or (nodes[a].type == 0 and not has_flag(a, NF_CHECKED) and files[pos_file(nodes[a].pos)].is_dewy)
    false

unnamed = (a: int) -> int:
    if nodes[a].kind == .namedarg: return int(nodes[a].a)
    a

# how many of a candidate's arguments (not literals) have exactly their parameter's type
exact_args = (cd: Cand) -> int:
    k = 0
    loop i in 0.. and a in cd.args:
        if i >= cd.sig.params.len(): break
        if a == 0 or is_lit(a) or nodes[a].type == 0: continue
        if type_eq(prune(ntype(a)), prune(subst(cd.sig.params[i], cd.binds))): k += 1
    k

# map call args to parameter slots; returns error message ("" on success)
map_args = (pnames: int[], has_default: bool[], args: int[], out: mut int[]) -> str:
    np = pnames.len()
    out.clear()
    out.resize(np)
    pos = 0
    loop a in args:
        if nodes[a].kind == .namedarg:
            k = -1
            loop j in [0..np):
                if pnames[j] == int(nodes[a].name): k = j
            if k < 0:
                an = name_of(int(nodes[a].name))
                if (an == "key" or an == "reverse") and not caller_dewy(): return "no parameter named '{an}' (by a key: `max_by(xs, (x): len(x))`, `min_by`, `sorted_by(xs, (x): x.age)`, `sort_by`; `descending = true` sorts largest first)"
                return "no parameter named '{an}'{suggestion(an, pnames)}"
            if out[k] != 0: return "parameter '{name_of(int(nodes[a].name))}' given twice"
            out[k] = int(nodes[a].a)
        else:
            loop pos < np and out[pos] != 0: pos += 1
            if pos >= np: return "too many arguments (expected {np})"
            out[pos] = a
            pos += 1
    loop i in [0..np):
        if out[i] == 0 and not has_default[i]: return "missing argument '{name_of(pnames[i])}'"
    ""

# Keep parameter slots canonical for types/ABI, but evaluate explicitly supplied
# Dewy arguments in source order, then omitted defaults in parameter order.
# c holds a list of integer-literal slot numbers only when reordering is needed.
save_call_order = (n: int, given: int[], final: int[]):
    if not files[pos_file(nodes[n].pos)].is_dewy: return
    # Most calls already have their written arguments in parameter order.
    # Omitted trailing defaults follow them without any ordering metadata.
    ordered = given.len() <= final.len()
    if ordered:
        loop i in [0..given.len()):
            if unnamed(given[i]) != final[i]:
                ordered = false
                break
    if ordered: return
    order: int[]
    loop a in given:
        value = unnamed(a)
        loop i in 0.. and f in final:
            if f == value: order.push(i)
    loop i in [0..final.len()):
        if not order.contains(i): order.push(i)
    changed = false
    loop i in 0.. and slot in order:
        if i != slot: changed = true
    if not changed: return
    entries: int[]
    loop slot in order:
        e = mk(.int_lit, nodes[n].pos)
        nodes[e].ival = slot
        nodes[e].type = i32(T_INT)
        add_flag(e, NF_CHECKED)
        entries.push(e)
    metadata = mk(.array, nodes[n].pos)
    set_list(metadata, entries)
    nodes[n].c = i32(metadata)

match_type = (pat0: int, a0: int, binds: mut int[], depth: int) -> int:
    pat = prune(pat0)
    a = prune(a0)
    if types[pat].kind == .callable:
        if not effect_match(callable_contract(a), callable_contract(pat), binds): return -1
        return match_type(callable_base(pat), callable_base(a), binds, depth)
    if types[a].kind == .callable: a = callable_base(a)
    if refine_active:
        pat = representation_type(pat)
        a = representation_type(a)
    if a == T_NEVER: return 0
    pk = types[pat].kind
    ak = types[a].kind
    if pk == .param:
        id = int(types[pat].id)
        if binds[id] == 0:
            binds[id] = a
            if depth == 0: return 3
            return 0
        if type_eq(binds[id], a): return 0
        if has_var(prune(binds[id])) and unify(binds[id], a): return 0
        if can_coerce(0, a, binds[id]): return 1
        return -1
    if not has_var(pat):
        if type_eq(pat, a): return 0
        if has_var(a):
            if ak == .var: return 0
            if ak == pk and ak == .array and match_type(int(types[pat].elem), int(types[a].elem), binds, depth + 1) >= 0: return 0
            if ak == .opt and pk == .opt: return 0
        if ak == .none_lit and pk == .opt: return 0
        if can_coerce(0, a, pat):
            if pat == T_MATH_INT and ak == .int_: return 2
            if a == T_MATH_INT and pk == .int_ and not int_widens(a, pat): return 2
            if ak == .float_ and pk == .float_:
                if int(types[a].bits) < int(types[pat].bits): return 4
                return 5
            if (ak == .int_ and pk == .float_) or pk == .opt: return 2
            return 1
        return -1
    if ak == .var: return 0
    if is_union(pat): return match_union(pat, a, binds, depth)
    if pk == .opt and ak != .opt:
        if ak == .none_lit: return 0
        r = match_type(int(types[pat].elem), a, binds, depth + 1)
        if r < 0: return -1
        return r + 4
    if pk == .quantity:
        if ak != .quantity or types[pat].st != types[a].st: return -1
        return match_type(quantity_base(pat), quantity_base(a), binds, depth + 1)
    if pk == .array and ak == .fixed:
        # (passed as a copy in a new array)
        r = match_type(int(types[pat].elem), int(types[a].elem), binds, depth + 1)
        if r < 0: return -1
        return r + 2
    if pk != ak: return -1
    if pk == .array or pk == .ptr or pk == .opt: return match_type(int(types[pat].elem), int(types[a].elem), binds, depth + 1)
    if pk == .fixed:
        if types[pat].bits != types[a].bits: return -1
        return match_type(int(types[pat].elem), int(types[a].elem), binds, depth + 1)
    if pk == .fn_ or pk == .tuple or pk == .cfn:
        if types[pat].nargs != types[a].nargs: return -1
        cost = 0
        loop i in [0..int(types[pat].nargs)):
            r = match_type(targ(pat, i), targ(a, i), binds, depth + 1)
            if r < 0: return -1
            cost += r
        if pk != .tuple:
            r = match_type(int(types[pat].elem), int(types[a].elem), binds, depth + 1)
            if r < 0: return -1
            cost += r
        return cost
    if pk == .struct_ or pk == .enum_:
        sp = int(types[pat].st)
        sa = int(types[a].st)
        if structs[sp].decl != structs[sa].decl: return -1
        cost = 0
        loop i in [0..int(structs[sp].ntargs)):
            r = match_type(struct_targ(sp, i), struct_targ(sa, i), binds, depth + 1)
            if r < 0: return -1
            cost += r
        return cost
    -1

# type parameter id is a member of a union in type t
param_in_union = (t0: int, id: int) -> bool:
    t = prune(t0)
    if not has_var(t): return false
    k = types[t].kind
    if is_union(t):
        loop m in union_members(t):
            if types[prune(m)].kind == .param and int(types[prune(m)].id) == id: return true
    if k == .array or k == .opt or k == .ptr: return param_in_union(int(types[t].elem), id)
    if k == .struct_ or k == .enum_:
        si = int(types[t].st)
        loop j in [0..int(structs[si].ntargs)):
            if param_in_union(struct_targ(si, j), id): return true
    false

# T | Err against int | str | Err: the members the pattern names match themselves, and its type
# parameter stands for the rest (int | str); a lone member (Err, or int) matches the same way
match_union = (pat: int, a: int, binds: mut int[], depth: int) -> int:
    pms = union_members(pat)
    ams = [a]
    if is_union(a): ams = union_members(a)
    rest: int[]
    loop m in ams:
        named = false
        loop pm in pms:
            if not has_var(pm) and type_eq(pm, m): named = true
        if not named: rest.push(m)
    params: int[]
    loop pm in pms:
        if has_var(pm): params.push(pm)
    if params.len() != 1 or types[prune(params[0])].kind != .param: return -1
    widen = 0
    if not is_union(a): widen = 1
    if rest.len() == 0: return widen        # (the parameter is decided by other arguments)
    r = match_type(params[0], mk_union(rest), binds, depth + 1)
    if r < 0: return -1
    r + widen

subst_partial = (pat0: int, binds: mut int[]) -> int:
    pat = prune(pat0)
    if not has_var(pat): return pat
    k = types[pat].kind
    if k == .param:
        id = int(types[pat].id)
        if binds[id] == 0: binds[id] = mk_var()
        return binds[id]
    if k == .array: return mk_array(subst_partial(int(types[pat].elem), binds))
    if k == .callable: return mk_callable_contract(subst_partial(int(types[pat].elem), binds), effect_subst(int(types[pat].st), binds))
    if k == .refined: return mk_refined(subst_partial(int(types[pat].elem), binds), ref_subst(int(types[pat].st), binds))
    if k == .quantity: return mk_quantity(subst_partial(int(types[pat].elem), binds), int(types[pat].st))
    if k == .fixed: return mk_fixed(subst_partial(int(types[pat].elem), binds), fixed_len(pat))
    if k == .ptr: return mk_ptr(subst_partial(int(types[pat].elem), binds))
    if k == .opt: return mk_opt(subst_partial(int(types[pat].elem), binds))
    if k == .fn_ or k == .tuple:
        a: int[]
        loop i in [0..int(types[pat].nargs)): a.push(subst_partial(targ(pat, i), binds))
        if k == .tuple: return mk_tuple(a)
        return mk_fn(a, subst_partial(int(types[pat].elem), binds), int(types[pat].mutmask), int(types[pat].st))
    if k == .struct_ or k == .enum_:
        si = int(types[pat].st)
        a: int[]
        loop i in [0..int(structs[si].ntargs)): a.push(subst_partial(struct_targ(si, i), binds))
        return get_struct_inst(int(structs[si].decl), a)
    pat

find_variant = (si: int, name: int) -> int:
    check_struct_fields(si)
    loop v in [0..int(structs[si].nvariants)):
        if int(variants[int(structs[si].variants) + v].name) == name: return v
    -1

# Recognize scalar arithmetic without checking or folding it before context is
# known. This also lets numeric branches rule out nonnumeric overloads.
branch_numeric = (a: int, hidden: int[]) -> bool:
    k = nodes[a].kind
    if k == .int_lit or k == .float_lit: return true
    if k == .ident and not (int(nodes[a].name) in hidden):
        sym = lookup(int(nodes[a].name))
        if sym != 0 and syms[sym].kind == .local: return is_numeric(int(locals[int(syms[sym].ref)].type))
        if sym != 0 and syms[sym].kind == .global and globals[int(syms[sym].ref)].type != 0: return is_numeric(int(globals[int(syms[sym].ref)].type))
    if k == .unary: return branch_numeric(int(nodes[a].a), hidden)
    if k == .binary:
        op = nodes[a].op as Tok
        if op != .plus and op != .minus and op != .star and op != .slash and op != .percent: return false
        return branch_numeric(int(nodes[a].a), hidden) and branch_numeric(int(nodes[a].b), hidden)
    false

# Branch bodies must be checked in their own scopes, with the selected parameter
# type. Only score literal results here; bindings and statements wait until then.
branch_arg_cost = (a: int, pat: int, binds: mut int[], hidden: int[] = []) -> int:
    k = nodes[a].kind
    if k == .block:
        if nkids(a) == 0: return 0
        local_hidden = hidden
        loop statement in kids(a):
            if nodes[statement].kind == .vardecl:
                local_hidden.push(int(nodes[statement].name))
                loop binding in binding_leaves(kids(statement)): local_hidden.push(int(nodes[binding].name))
        last = kid(a, nkids(a) - 1)
        if nodes[last].kind == .exprstmt: return branch_arg_cost(int(nodes[last].a), pat, binds, local_hidden)
        if nodes[last].kind == .if_: return branch_arg_cost(last, pat, binds, local_hidden)
        return 0
    if k == .if_ or k == .match_:
        bodies: int[]
        local_hidden = hidden
        if k == .if_:
            bodies.push(int(nodes[a].b))
            if nodes[a].c != 0: bodies.push(int(nodes[a].c))
        else:
            loop arm in kids(a):
                bodies.push(int(nodes[arm].b))
                loop pattern in kids(arm):
                    if nodes[pattern].name != 0: local_hidden.push(int(nodes[pattern].name))
        cost = 0
        loop body in bodies:
            r = branch_arg_cost(body, pat, binds, local_hidden)
            if r < 0: return -1
            cost = max(cost, r)
        return cost
    if k == .int_lit or k == .float_lit or k == .str_lit or k == .bool_lit or k == .none_lit:
        probe = clone(a)
        check_expr(probe, 0)
        return arg_cost(probe, pat, binds)
    if k == .unary and (nodes[int(nodes[a].a)].kind == .int_lit or nodes[int(nodes[a].a)].kind == .float_lit):
        # The sign is part of a literal's range, e.g. -128 fits int8 but 128 does not.
        probe = clone(a)
        check_expr(probe, 0)
        return arg_cost(probe, pat, binds)
    if (k == .binary or k == .unary) and branch_numeric(a, hidden):
        left = branch_arg_cost(int(nodes[a].a), pat, binds, hidden)
        if left < 0 or k == .unary: return left
        right = branch_arg_cost(int(nodes[a].b), pat, binds, hidden)
        if right < 0: return -1
        return max(left, right)
    if k == .ident and not (int(nodes[a].name) in hidden):
        sym = lookup(int(nodes[a].name))
        t = 0
        if sym != 0 and syms[sym].kind == .local: t = int(locals[int(syms[sym].ref)].type)
        else if sym != 0 and syms[sym].kind == .global: t = int(globals[int(syms[sym].ref)].type)
        # Type-test branches may narrow optionals/unions; let their own scope
        # establish that view. Ordinary typed values already constrain overloads.
        if t != 0 and not has_var(t) and not is_union(t) and tkind(t) != .opt and not is_fn_type(t):
            probe = clone(a)
            nodes[probe].type = i32(t)
            add_flag(probe, NF_CHECKED)
            return arg_cost(probe, pat, binds)
    if types[prune(pat)].kind == .param: return 3
    0

arg_cost = (a: int, pat: int, binds: mut int[]) -> int:
    if effects_active and nodes[a].type != 0 and callable_contract(pat) != 0: nodes[a].type = i32(effect_infer_callable(a, pat))
    p = representation_type(pat)
    pk = types[p].kind
    target = p
    if pk == .param and binds[int(types[p].id)] != 0: target = prune(binds[int(types[p].id)])
    if nodes[a].kind == .float_lit and nodes[a].sval != 0 and bundled_rational_type(target): return 0
    if is_float(target) and nodes[a].type != 0 and bundled_rational_type(ntype(a)): return 10
    if bundled_rational_type(target) and (nodes[a].kind == .int_lit or (nodes[a].type != 0 and is_int(ntype(a)))): return 10
    if nodes[a].type != 0 and bundled_word_rational_type(ntype(a)) and (bundled_rational_type(target) or is_float(target)): return 10
    # (a constant beside a word fraction takes its form, as a literal beside a word integer does)
    if bundled_word_rational_type(target) and nodes[a].type != 0 and word_rational_source(a, ntype(a)): return 5
    if not is_lit(a) and nodes[a].type != 0 and ntype(a) == T_MATH_INT and bundled_bigint_type(target): return 1
    if ctx_dependent(a):
        if oversized_literal(a):
            target = prune(subst_partial(p, binds))
            if types[target].kind == .opt: target = prune(int(types[target].elem))
            if bundled_bigint_type(target): return 0
            if target == T_MATH_INT: return 1
            return -1
        k = nodes[a].kind
        if k == .if_ or k == .match_: return branch_arg_cost(a, pat, binds)
        if dewy_set_literal(a):
            target = p
            if pk == .param and binds[int(types[p].id)] != 0: target = prune(binds[int(types[p].id)])
            cost = 0
            if types[target].kind == .opt:
                target = prune(int(types[target].elem))
                cost = 2
            if is_dewy_set_type(target):
                r = arg_cost(kid(a, 0), mk_array(struct_targ(int(types[target].st), 0)), binds)
                if r < 0: return -1
                return cost + r
            if pk == .param: return 3
            return -1
        if k == .hole: return 0
        if k == .ident or k == .field or k == .typeapply:
            if pk == .fn_ or pk == .callable: return 0
            if pk == .cfn: return 0             # (a @cabi function for C: checked when given)
            if pk == .param: return 3        # a function passed to a generic parameter
            return -1
        if k == .lambda:
            if pk == .param:
                if nkids(a) > 0 and nodes[kid(a, 0)].a != 0: return 3
                return -1
            if pk == .callable: p = callable_base(p); pk = types[p].kind
            if pk != .fn_ or int(types[p].nargs) != nkids(a): return -1
            if has_flag(a, NF_GENERIC): return 0
            # (a parameter the lambda gives a type must have that type)
            loop i in [0..nkids(a)):
                pn = kid(a, i)
                if nodes[pn].a == 0: continue
                at = prune(resolve_type(int(nodes[pn].a)))
                pt = prune(targ(p, i))
                if not has_var(at) and not has_var(pt) and not type_eq(at, pt): return -1
            return 0
        if k == .dotname or k == .call:
            name = int(nodes[a].name)
            if k == .call: name = int(nodes[int(nodes[a].a)].name)
            # (m[k] = .wood for a map of an enum: the parameter's type as the arguments before
            # bound it)
            e = p
            if has_var(p): e = prune(subst(p, binds))
            if types[e].kind == .opt: e = prune(int(types[e].elem))
            e = variant_enum(e, name)
            if types[e].kind != .enum_: return -1
            if find_variant(int(types[e].st), name) >= 0: return 0
            return -1
        if k == .none_lit:
            if pk == .opt: return 0
            if pk == .param: return 3
            return -1
        if k == .array and nkids(a) > 0 and files[pos_file(nodes[a].pos)].is_dewy:
            target = p
            if pk == .param and binds[int(types[p].id)] != 0: target = prune(binds[int(types[p].id)])
            cost = 0
            if types[target].kind == .opt:
                target = prune(int(types[target].elem))
                cost = 2
            tk = types[target].kind
            if tk == .array or (tk == .fixed and (fixed_literal_ok(a, target) or array_has_spread(a))):
                et = int(types[target].elem)
                # Settle a generic element from the first typed value before
                # scoring literals, including literals written before it.
                if types[prune(et)].kind == .param and binds[int(types[prune(et)].id)] == 0:
                    loop element in kids(a):
                        if ctx_dependent(element) or is_lit(element): continue
                        inferred = prune(ntype(element))
                        if has_flag(element, NF_SPREAD):
                            if is_dewy_set_type(inferred): inferred = struct_targ(int(types[inferred].st), 0)
                            else if types[inferred].kind == .array or types[inferred].kind == .fixed: inferred = int(types[inferred].elem)
                            else: continue
                        if match_type(et, inferred, binds, 1) < 0: return -1
                        break
                element_cost = 0
                loop element in kids(a):
                    ep = et
                    if has_flag(element, NF_SPREAD): ep = mk_array(et)
                    if types[prune(ep)].kind == .param:
                        bound = binds[int(types[prune(ep)].id)]
                        # Once another element determines T, charge its actual
                        # conversion cost rather than a generic-parameter cost.
                        if bound != 0 and not has_var(prune(bound)): ep = bound
                    r = 0
                    if has_flag(element, NF_SPREAD) and dewy_set_literal(element):
                        r = arg_cost(kid(element, 0), ep, binds)
                    else if has_flag(element, NF_SPREAD) and is_dewy_set_type(ntype(element)):
                        r = match_type(et, struct_targ(int(types[prune(ntype(element))].st), 0), binds, 0)
                    else if types[prune(ep)].kind == .param and binds[int(types[prune(ep)].id)] == 0 and not ctx_dependent(element):
                        # Inferring an array element is cheaper than changing
                        # an integer to float. Literals wait for the whole array;
                        # a typed element can supply T, in either source order.
                        if is_lit(element): r = if lit_default(element) == T_MATH_INT: 2 else: 1
                        else:
                            r = match_type(ep, ntype(element), binds, 1)
                            if r >= 0: r += 1
                    else: r = arg_cost(element, ep, binds)
                    if r < 0: return -1
                    # One array is one argument. Adding more elements must not
                    # make a typed-array overload lose to a catch-all T.
                    element_cost = max(element_cost, r)
                return cost + element_cost
            # (a positional object literal, Point(3 4) written [3 4]: its items against the
            # fields in order)
            if tk == .struct_ and not has_var(target) and not is_map_type(target) and dewy_positional_fits(a, target):
                si = int(types[target].st)
                check_struct_fields(si)
                if nkids(a) > int(structs[si].nfields): return -1
                element_cost = 0
                loop i in 0.. and element in kids(a):
                    r = arg_cost(element, int(fields[int(structs[si].fields) + i].type), binds)
                    if r < 0: return -1
                    element_cost = max(element_cost, r)
                return cost + element_cost
            # A bound scalar parameter cannot accept an array literal. Do not
            # let its generic fallback compete with the matching T[] overload.
            if pk == .param and has_var(target): return 3
            return -1
        if k == .array or (k == .block and has_flag(a, NF_COMPREHENSION)):
            if pk == .array: return 0
            # A checked method receiver is already an array, though its empty
            # element type can still be inferred from the other arguments.
            if nkids(a) == 0 and not has_flag(a, NF_CHECKED) and dewy_record_target(p) != 0 and files[pos_file(nodes[a].pos)].is_dewy: return 0
            if pk == .param: return 3
            return -1
        if k == .record_lit:
            target = p
            if pk == .opt: target = prune(int(types[p].elem))
            if types[target].kind == .struct_ and not is_map_type(target):
                si = int(types[target].st)
                check_struct_fields(si)
                cost = 0
                members = kids(a)
                if array_has_spread(a):
                    unused: int[]
                    members = dewy_record_spread_entries(a, 0, unused, false)
                loop field in members:
                    fi = -1
                    loop i in [0..int(structs[si].nfields)):
                        at = int(structs[si].fields) + i
                        if fields[at].name == nodes[field].name: fi = at; break
                    if fi < 0: return -1
                    r = arg_cost(int(nodes[field].a), int(fields[fi].type), binds)
                    if r < 0: return -1
                    cost += r
                return cost
            if pk == .param: return 3
            return -1
        if k == .map_lit:
            target = prune(subst_partial(p, binds))
            if types[target].kind == .opt: target = prune(int(types[target].elem))
            if is_map_type(target):
                si = int(types[target].st)
                cost = 0
                loop pair in kids(a):
                    key = arg_cost(int(nodes[pair].a), struct_targ(si, 0), binds)
                    value = arg_cost(int(nodes[pair].b), struct_targ(si, 1), binds)
                    if key < 0 or value < 0: return -1
                    cost = max(cost, key + value)
                return cost
            if pk == .param: return 3
            return -1
        return -1
    if charlike(a) and pk == .int_: return 1
    if pk == .enum_ and not has_var(p) and is_union(p) and not is_union(ntype(a)):
        # a member value passed for a union parameter
        if union_target(a, ntype(a), p) >= 0: return 1
        return -1
    if is_lit(a):
        # Prefer the literal's default integer width/sign, but only among types
        # that can represent it; Dewy literals prefer mathematical int.
        if pk == .param:
            b = binds[int(types[p].id)]
            if b == 0: return 3
            if can_coerce(a, ntype(a), b): return 0
            return -1
        if is_union(p) and has_var(p): return match_type(pat, lit_default(a), binds, 0)
        if pk == .int_:
            if nodes[a].kind == .int_lit:
                if not lit_fits(a, p): return -1
                if p == lit_default(a): return 0
                if p == T_U64 and has_flag(a, NF_U64): return 1
                if lit_default(a) == T_MATH_INT and p != T_INT: return 2
                return 1
            return -1
        if dewy_bigint_literal_target(a, p): return 3
        if pk == .float_:
            if p == T_FLOAT:
                if nodes[a].kind == .int_lit: return if lit_default(a) == T_MATH_INT: 3 else: 2
                return 0
            if nodes[a].kind == .int_lit: return if lit_default(a) == T_MATH_INT: 4 else: 3
            return 1
        if pk == .opt and not has_var(p) and can_coerce(a, ntype(a), p): return 2
        if pk == .vec: return -1
        return -1
    fp = p
    if pk == .param and binds[int(types[p].id)] != 0: fp = prune(binds[int(types[p].id)])
    if types[fp].kind == .quantity and quantity_constant_fits(a, fp):
        if type_eq(ntype(a), fp): return 0
        return 2
    if types[fp].kind == .fixed and nodes[a].kind == .array and tkind(ntype(a)) == .array and fixed_literal_ok(a, fp):
        # an array literal for a fixed-size array parameter
        et = int(types[fp].elem)
        if has_var(prune(et)):
            r = match_type(et, int(types[prune(ntype(a))].elem), binds, 1)
            if r < 0: return -1
            return r + 1
        loop i in [0..nkids(a)):
            if not can_coerce(kid(a, i), ntype(kid(a, i)), et): return -1
        return 1
    if types[fp].kind == .fixed and nodes[a].kind != .array and tkind(ntype(a)) == .array:
        r = match_type(int(types[fp].elem), int(types[prune(ntype(a))].elem), binds, 1)
        if r >= 0: return r + 1
        return -1
    if tkind(ntype(a)) == .polyfn and types[fp].kind == .fn_ and poly_matches(prune(ntype(a)), fp): return 0
    r = match_type(pat, ntype(a), binds, 0)
    if r < 0 and types[fp].kind == .array and is_nd(ntype(a)):
        # a 1-D T[,] (a row, a column) for a T[] parameter
        r = match_type(pat, mk_array(nd_elem(ntype(a))), binds, 0)
        if r >= 0: return r + 2
    r

check_args_untyped = (args: int[]):
    loop a0 in args:
        a = unnamed(a0)
        if dewy_set_literal(a):
            check_args_untyped(kids(a))
            continue
        if nodes[a].kind == .array: dewy_classify_spread(a)
        if nodes[a].kind == .record_lit:
            check_args_untyped(kids(a))
            continue
        if nodes[a].kind == .map_lit and ctx_dependent(a):
            loop pair in kids(a): check_args_untyped([int(nodes[pair].a), int(nodes[pair].b)])
            continue
        if nodes[a].kind == .array and files[pos_file(nodes[a].pos)].is_dewy and ctx_dependent(a):
            check_args_untyped(kids(a))
            continue
        base = a
        if nodes[a].kind == .typeapply: base = int(nodes[a].a)
        if nodes[base].kind == .ident and not has_flag(a, NF_CHECKED):
            s = lookup(int(nodes[base].name))
            if s != 0 and syms[s].kind == .fns: add_flag(a, NF_FNREF_ARG)
            # A Dewy function-valued local named alone: its parameter's type
            # says whether that is a call or a mistaken `@`.
            if s != 0 and syms[s].kind == .local and a == base and not has_flag(a, NF_MUT) and is_fn_type(int(locals[int(syms[s].ref)].type)) and files[pos_file(nodes[a].pos)].is_dewy: add_flag(a, NF_FNREF_ARG)
        # (cm.step: a module's function, checked with the parameter's type as a plain one is)
        if nodes[base].kind == .field and not has_flag(a, NF_CHECKED) and nodes[int(nodes[base].a)].kind == .ident:
            ms = lookup(int(nodes[int(nodes[base].a)].name))
            if ms != 0 and syms[ms].kind == .module:
                fs = module_lookup(int(syms[ms].ref), int(nodes[base].name))
                if fs != 0 and syms[fs].kind == .fns: add_flag(a, NF_FNREF_ARG)
        if ctx_dependent(a) or has_flag(a, NF_CHECKED): continue
        check_expr(a, 0)
        add_flag(a, NF_CHECKED)

# A place route starts at its owning binding. Narrowing aliases and shared
# captures still designate that same storage; private captures are independent.
mutable_route = (n: int, route: mut int[]) -> int:
    k = nodes[n].kind
    if k == .field or k == .index:
        root = mutable_route(int(nodes[n].a), route)
        route.push(n)
        return root
    if k == .unwrap or k == .narrow or k == .conv:
        return mutable_route(int(nodes[n].a), route)
    if k == .ident and nodes[n].aux == i32(int(SK.local)):
        l = int(nodes[n].sym)
        if int(locals[l].flags) & LF_ALIAS != 0 and locals[l].alias != 0:
            return mutable_route(int(locals[l].alias), route)
        if int(locals[l].flags) & LF_CAPTURE != 0 and int(locals[l].flags) & LF_VALUECAP == 0:
            return mutable_route(mk_ident_local(int(locals[l].outer), nodes[n].pos), route)
    n

mutable_index = (n: int) -> int:
    let n = n
    loop nodes[n].kind == .conv: n = int(nodes[n].a)
    n

mutable_overlap = (a: int, b: int) -> bool:
    left: int[]
    right: int[]
    ar = mutable_route(a, left)
    br = mutable_route(b, right)
    if nodes[ar].kind != .ident or nodes[br].kind != .ident: return false
    if nodes[ar].aux != nodes[br].aux or nodes[ar].sym != nodes[br].sym: return false
    loop i in [0..min(left.len(), right.len())):
        x = left[i]
        y = right[i]
        if nodes[x].kind != nodes[y].kind: return true
        if nodes[x].kind == .field:
            if nodes[x].aux >= 0 and nodes[y].aux >= 0 and nodes[x].aux != nodes[y].aux: return false
            if nodes[x].aux == -2 and nodes[y].aux == -2 and nodes[x].ival != nodes[y].ival: return false
        else:
            xi = mutable_index(int(nodes[x].b))
            yi = mutable_index(int(nodes[y].b))
            if nodes[xi].kind == .int_lit and nodes[yi].kind == .int_lit and nodes[xi].ival != nodes[yi].ival: return false
    # Equal routes and parent/child routes overlap. Unknown indices can overlap.
    true

check_mutable_arguments = (args: int[], mask: int, pos: int):
    if mask == 0 or mask & (mask - 1) == 0 or not dewy_at(pos): return
    loop i in [0..args.len()):
        if mask & (1 << i) == 0 or nodes[args[i]].kind == .hole: continue
        loop j in [0..i):
            if mask & (1 << j) == 0 or nodes[args[j]].kind == .hole: continue
            if mutable_overlap(args[j], args[i]):
                fatal(nodes[args[i]].pos, "mutable arguments {j + 1} and {i + 1} overlap; pass disjoint places")

finish_arg = (a: int, pt: int, is_mut: bool):
    if is_mut and refine_active:
        ref_mutable_authority(a)
        storage = refine_storage(a, ntype(a))
        if ref_storage_contract(storage) or ref_storage_contract(pt):
            if not type_eq(storage, pt): fatal(nodes[a].pos, "mutable refinement access requires an equivalent storage contract")
    if is_mut and not has_flag(a, NF_MUT) and files[pos_file(nodes[a].pos)].is_dewy:
        fatal(nodes[a].pos, "a mutable argument needs `@` at the call site")
    if nodes[a].kind == .hole:
        nodes[a].type = i32(pt)
        return
    if not has_flag(a, NF_CHECKED) or nodes[a].type == 0:
        check_expr(a, pt)
        add_flag(a, NF_CHECKED)
    if is_mut:
        check_place(a, true)
        if path_narrows > 0: path_forget(path_key(a))
        actual = if refine_active: refine_storage(a, ntype(a)) else: ntype(a)
        if not type_eq(actual, pt) and not unify(actual, pt): fatal(nodes[a].pos, "{jd(nodes[a].pos, "`mut`", "an `@`")} argument must have type {dt(pt)} exactly, found {dt(ntype(a))}")
        add_flag(a, NF_MUT)
        return
    saved = refine_arg_target
    refine_arg_target = prune(pt)
    coerce(a, pt)
    refine_arg_target = saved

default_arg = (decl: int, i: int, pt: int, given: int[] = [], captured: bool = false, targs: int[] = []) -> int:
    d = clone(int(nodes[kid(decl, i)].b))
    # (h: f64 = w: a default naming an earlier parameter takes that argument)
    if given.len() > 0 and not captured: subst_params(d, decl, given)
    saved = cx
    ctxs.push(FnCtx(ctxs[cx].inst, -1, i32(T_VOID), false, 0, nodes[decl].mod, i32(sc_names.len())))
    cx = ctxs.len() - 1
    mark = scope_mark()
    push_type_params(decl, targs)
    if captured:
        loop j in 0.. and value in given:
            name = int(nodes[kid(decl, j)].name)
            push_scope_sym(name, new_sym(name, .local, int(nodes[value].sym), kid(decl, j)))
    check_expr(d, pt)
    if pt != 0: coerce(d, pt)
    else: finalize_literal(d)
    scope_reset(mark)
    ctxs.pop()
    cx = saved
    d

# a default value's names of earlier parameters (of function decl) replaced by their arguments
subst_params = (n: int, decl: int, given: int[]):
    if n == 0: return
    k = nodes[n].kind
    if k == .lambda: return
    if k == .ident:
        loop j in 0.. and v in given:
            if v != 0 and int(nodes[kid(decl, j)].name) == int(nodes[n].name):
                if not simple_arg(v): fatal(nodes[v].pos, "the default of a later parameter uses this argument, so it is computed again there: give a variable or a value (`w = make_w()` first)")
                nodes[n] = nodes[clone(v)]
                return
        return
    subst_params(int(nodes[n].a), decl, given)
    subst_params(int(nodes[n].b), decl, given)
    if k != .for_:
        subst_params(int(nodes[n].c), decl, given)
        if k != .partial: subst_params(int(nodes[n].d), decl, given)
    loop i in [0..nkids(n)): subst_params(kid(n, i), decl, given)

default_uses_params = (n: int, decl: int, before: int) -> bool:
    if n == 0: return false
    names: int[]
    loop i in [0..before): names.push(int(nodes[kid(decl, i)].name))
    default_uses_names(n, names)

# Whether a default names one of `names` (earlier parameters or fields), outside
# the bindings it makes itself.
default_uses_names = (n: int, names: int[], hidden: int[] = []) -> bool:
    if n == 0: return false
    if nodes[n].kind == .ident:
        if hidden.contains(int(nodes[n].name)): return false
        return names.contains(int(nodes[n].name))
    if nodes[n].kind == .vardecl:
        return default_uses_names(int(nodes[n].b), names, hidden)
    if nodes[n].kind == .lambda:
        local_hidden = hidden
        loop param in kids(n):
            if default_uses_names(int(nodes[param].b), names, local_hidden): return true
            local_hidden.push(int(nodes[param].name))
        return default_uses_names(int(nodes[n].b), names, local_hidden)
    if nodes[n].kind == .block:
        local_hidden = hidden
        loop statement in kids(n):
            if default_uses_names(statement, names, local_hidden): return true
            if nodes[statement].kind == .vardecl:
                local_hidden.push(int(nodes[statement].name))
                loop binding in binding_leaves(kids(statement)): local_hidden.push(int(nodes[binding].name))
        return false
    if nodes[n].kind == .for_:
        if default_uses_names(int(nodes[n].a), names, hidden): return true
        local_hidden = hidden
        loop binder in binding_leaves(kids(n)): local_hidden.push(int(nodes[binder].name))
        return default_uses_names(int(nodes[n].b), names, local_hidden)
    if nodes[n].kind == .match_:
        if default_uses_names(int(nodes[n].a), names, hidden): return true
        loop arm in kids(n):
            local_hidden = hidden
            loop pattern in kids(arm):
                if nodes[pattern].name != 0: local_hidden.push(int(nodes[pattern].name))
            if default_uses_names(int(nodes[arm].b), names, local_hidden): return true
        return false
    if default_uses_names(int(nodes[n].a), names, hidden) or default_uses_names(int(nodes[n].b), names, hidden): return true
    if default_uses_names(int(nodes[n].c), names, hidden) or default_uses_names(int(nodes[n].d), names, hidden): return true
    loop child in kids(n):
        if default_uses_names(child, names, hidden): return true
    false

capture_value = (a: int, pt: int, statements: mut int[]) -> int:
    local = new_local(0, pt, nodes[a].pos)
    locals[local].flags = i32(LF_DECL | LF_QUIET | LF_READ)
    binding = mk(.vardecl, nodes[a].pos)
    nodes[binding].a = i32(type_node_of(pt, nodes[a].pos))
    nodes[binding].b = i32(a)
    nodes[binding].sym = i32(local)
    nodes[binding].type = i32(pt)
    add_flag(binding, NF_CHECKED)
    statements.push(binding)
    mk_ident_local(local, nodes[a].pos)

# an argument that can be computed twice: a literal, a variable, a field of one
simple_arg = (v: int) -> bool:
    k = nodes[v].kind
    if k == .int_lit or k == .float_lit or k == .str_lit or k == .bool_lit or k == .ident or k == .none_lit: return true
    if k == .conv or k == .unary: return simple_arg(int(nodes[v].a))
    if k == .field: return simple_arg(int(nodes[v].a))
    false

has_hole = (args: int[]) -> bool:
    loop a in args:
        if nodes[unnamed(a)].kind == .hole: return true
    false

finish_partial = (n: int, ptypes: int[], mutmask: int, ret: int) -> int:
    if refine_active:
        loop t in ptypes + [ret]:
            if ref_has_formals(t): fatal(nodes[n].pos, "dependent refinement partial application is not yet supported")
    hp: int[]
    mm = 0
    loop i in [0..nkids(n)):
        a = kid(n, i)
        if nodes[a].kind == .hole:
            if mutmask & (1 << i) != 0: mm |= 1 << hp.len()
            hp.push(ptypes[i])
    nodes[n].kind = .partial
    th = new_inst(FK_PARTIAL, cur_mod(), "partial")
    fns[th].ptypes = hp
    fns[th].ret = i32(ret)
    fns[th].has_env = true
    fns[th].partial = i32(n)
    fns[th].state = 2
    t = mk_fn(hp, ret, mm)
    nodes[n].type = i32(t)
    nodes[n].d = i32(th)
    t

call_targs: int[]              # type arguments written at the call being resolved (f[T](...))
cur_assign = 0                 # the assignment whose target is being checked (`x = ...`, `x += ...`)
early_set: {int: bool} = {}    # globals top-level code assigns above their own line

resolve_fn_call = (n: int, name: int, decls: int[], args: int[], expected: int, closure: int = 0) -> int:
    # (this call's own type arguments: a call among its arguments has none, from_text[S](f(x)))
    targs_here = call_targs
    call_targs = []
    check_args_untyped(args)
    positional = true
    loop arg in args:
        if arg == 0 or nodes[arg].kind == .namedarg:
            positional = false
            break
    cands: Cand[]
    last_err = ""
    last_err_pos = 0          # (where the argument it is about is: the error points there)
    last_err_arg = 0          # (which argument, from 1)
    best = -1
    # (an argument that is a number of a known type, the first such, rules out before anything is
    # made for them the overloads whose parameter there is a number type it cannot become: abs(x)
    # with x: f64 looks at abs(f64) alone, max(0.0, x) at the float ones)
    a0t = 0
    a0i = 0
    if decls.len() > 1:
        loop i in 0.. and a in args:
            if nodes[a].kind == .namedarg: break
            if nodes[a].type == 0 or is_lit(a) or ctx_dependent(a): continue
            k = tkind(ntype(a))
            if k == .int_ or k == .float_ or k == .vec:
                a0t = prune(ntype(a))
                a0i = i
            break
    loop d in decls:
        di = decl_info(d)
        if not decl_infos[di].sig.done: fn_sig(d)
        if a0t != 0 and not decl_infos[di].sig.generic and decl_infos[di].sig.params.len() > a0i:
            p0 = prune(decl_infos[di].sig.params[a0i])
            pk0 = tkind(p0)
            # (last_err is for a name with one function only; sin(v) with v: vec3 looks at
            # sin(vec3) alone)
            if p0 != a0t and (pk0 == .vec or pk0 == .int_ or pk0 == .float_) and not can_coerce(0, a0t, p0): continue
        cd = Cand(decl = d, sig = decl_infos[di].sig)
        np = nkids(d)
        if positional and args.len() == np:
            cd.args = args
        else:
            pnames: int[]
            hasdef: bool[]
            loop i in [0..np):
                pnames.push(int(nodes[kid(d, i)].name))
                hasdef.push(nodes[kid(d, i)].b != 0)
            err = map_args(pnames, hasdef, args, cd.args)
            if len(err) > 0:
                if last_err_arg == 0: last_err = err
                continue
        cd.binds = fill(0, int(cd.sig.ntp))
        if targs_here.len() > 0:
            # f[T](...): the declared type parameters, given
            if nkids2(d) != targs_here.len():
                if last_err_arg == 0: last_err = "'{name_of(name)}' takes {nkids2(d)} type argument(s), given {targs_here.len()}"
                continue
            loop i in 0.. and t in targs_here: cd.binds[i] = t
        cost = 0
        ok = true
        loop phase in [0..3):
            if not ok: break
            loop i in [0..np):
                a = cd.args[i]
                if a == 0: continue
                cls = 0
                if ctx_dependent(a): cls = 2
                else if is_lit(a): cls = 1
                if cls != phase: continue
                pt = cd.sig.params[i]
                if int(cd.sig.mutmask) & (1 << i) != 0 and not ctx_dependent(a):
                    r = match_type(pt, ntype(a), cd.binds, 0)
                    ok2 = r >= 0
                    if ok2:
                        ptx = subst(pt, cd.binds)
                        actual = ntype(a)
                        shape = ptx
                        if refine_active: actual = representation_type(actual); shape = representation_type(shape)
                        if not has_var(prune(shape)) and not has_var(prune(actual)) and not type_eq(shape, actual): ok2 = false
                    if not ok2:
                        ok = false
                        if i + 1 < last_err_arg: break
                        last_err_arg = i + 1
                        mutable = "mut parameters"
                        if caller_dewy(): mutable = "`@` parameters"
                        last_err = "argument {i + 1} must have type {dt(subst(pt, cd.binds))} ({mutable} need an exact match)"
                        break
                    cost += r
                    continue
                r = arg_cost(a, pt, cd.binds)
                if r < 0:
                    ok = false
                    # (of the overloads, the one that got furthest is the one meant: m[k] = v
                    # with the wrong v is about the map's, not a GPU buffer's)
                    if i + 1 < last_err_arg: break
                    # (literals are tried after the rest: a literal written before this argument
                    # that does not fit either is the first mistake, as 100 in circle(100, 100, 20, RED))
                    fi = i
                    if not cd.sig.generic:
                        loop j in [0..i):
                            aj = cd.args[j]
                            if aj == 0 or not is_lit(aj) or ctx_dependent(aj): continue
                            if arg_cost(aj, cd.sig.params[j], cd.binds) < 0:
                                fi = j
                                break
                    a = cd.args[fi]
                    last_err_arg = i + 1
                    ptx = subst(cd.sig.params[fi], cd.binds)
                    if nodes[a].type != 0: last_err = "argument '{name_of(int(nodes[kid(d, fi)].name))}' expects {dt(ptx)}, found {dt(ntype(a))}{variant_hint(a, ptx)}"
                    else if nodes[a].kind == .dotname and tkind(ptx) == .enum_:
                        vn = int(nodes[a].name)
                        last_err = "{dt(ptx)} has no variant '{name_of(vn)}'{variant_hint_for(ptx, name_of(vn))}"
                    else: last_err = "argument '{name_of(int(nodes[kid(d, fi)].name))}' has the wrong type (expects {dt(ptx)})"
                    last_err += uncalled_hint(a, ptx)
                    fnm = name_of(int(nodes[int(cd.decl)].name))
                    # (text("Score:", score, pos): Scratch's join, or Python's print, pieces in a row)
                    if (fnm == "text" or fnm == "text_centered") and fi == 1 and nodes[cd.args[0]].kind == .str_lit and nodes[a].type != 0 and tkind(ntype(a)) != .vec:
                        last_err = "text takes one piece of text, then where it goes: put the value inside it, `\"Score: \{score}\"`"
                    # (play("meow.wav"): a sound's file, not loaded)
                    if (fnm == "play" or fnm == "play_music") and nodes[a].kind == .str_lit:
                        last_err = "load the sound first, at the top of the file (`meow = load_wav(embed(\"meow.wav\"))`, or load_ogg), then `play(meow)`"
                    # (load_texture("cat.png"): a file's name where its bytes go)
                    if starts_with(fnm, "load_") and nodes[a].type != 0 and tkind(ntype(a)) == .str_ and tkind(ptx) == .array:
                        fln = "name.png"
                        if nodes[a].kind == .str_lit and nodes[a].aux == 0: fln = name_of(int(nodes[a].sval))
                        last_err = "{fnm} takes the file's contents: `{fnm}(embed(\"{fln}\"))` builds the file into the program (read_bytes(path) reads one at run time)"
                    # (xs.map((x, i): ...): JavaScript's map, which passes the position too)
                    if (fnm == "map" or fnm == "filter" or fnm == "each" or fnm == "any" or fnm == "all") and nodes[a].kind == .lambda and nkids(a) == 2:
                        last_err = "{fnm} gives the function each element alone; with its position too: `[loop i in 0.. and x in xs: ...]`, or `loop i in 0.. and x in xs:`"
                    # (xs.reduce((a, b): a + b, 0): JavaScript's order)
                    if fnm == "reduce" and cd.args.len() == 3 and cd.args[1] != 0 and nodes[unnamed(cd.args[1])].kind == .lambda:
                        last_err = "reduce takes the start value first, then the function: `xs.reduce(0, (a, b): a + b)` (or `sum(xs)`)"
                    # (overlaps(apple, cat_picture): a picture or a thing where a box goes)
                    if nodes[a].type != 0 and tkind(ptx) == .struct_ and dt(ptx) == "Rect" and not pos_in_lib(nodes[a].pos):
                        at = prune(ntype(a))
                        if dt(at) == "Texture": last_err += " (a picture has no place of its own: the box where it is drawn is `Rect(pos.x, pos.y, f64(pic.width), f64(pic.height))`)"
                        else if tkind(at) == .struct_:
                            sn = dt(at)
                            art = "a"
                            if len(sn) > 0 and find("AEIOU", sn[..1)) >= 0: art = "an"
                            last_err += " ({art} {sn} is not a box: `Rect(x, y, width, height)` makes the box around it)"
                    # (xs.sort((a, b): ...): a comparison, as JavaScript sorts)
                    if nodes[a].kind == .lambda and nkids(a) == 2 and name_of(int(nodes[int(cd.decl)].name)) == "sort": last_err += " (`sort_with(xs, (a, b): a.hp > b.hp)` sorts by a comparison, `sort_by(xs, (x): x.hp)` by a key)"
                    if tkind(ptx) == .cfn and (nodes[a].kind == .lambda or (nodes[a].type != 0 and tkind(ntype(a)) == .fn_)):
                        last_err = "argument '{name_of(int(nodes[kid(d, fi)].name))}' is called from C: give it a top-level function marked @cabi (a function value made in the program cannot be)"
                    last_err_pos = nodes[a].pos
                    break
                cost += r
        if not ok: continue
        cd.ok = true
        cd.cost = cost
        cands.push(cd)
    # pick the cheapest candidate; prefer non-generic ones, then the program's own definitions
    # over the standard library's; report real ties (the library's are settled by how many
    # arguments have exactly a parameter's type, then which comes first: min(x, 5) with x: i32
    # takes min(i32, i32), and min(a, b) with a: i8 and b: u8 still takes min(int, int))
    loop ci in 0.. and cd in cands:
        if best < 0 or cd.cost < cands[best].cost: best = ci
        else if cd.cost == cands[best].cost:
            bc = cands[best]
            if bc.sig.generic and not cd.sig.generic: best = ci
            else if bc.sig.generic == cd.sig.generic and decl_in_prelude(bc.decl) and not decl_in_prelude(cd.decl): best = ci
            else if bc.sig.generic == cd.sig.generic and decl_in_prelude(bc.decl) and decl_in_prelude(cd.decl) and exact_args(cd) > exact_args(bc): best = ci
    if best >= 0 and not decl_in_prelude(cands[best].decl):
        loop ci in 0.. and cd in cands:
            if ci != best and cd.cost == cands[best].cost and cd.sig.generic == cands[best].sig.generic and decl_in_prelude(cd.decl) == decl_in_prelude(cands[best].decl):
                ats = ""
                loop ai in 0.. and a0 in args:
                    if ai > 0: ats += ", "
                    if nodes[unnamed(a0)].type != 0: ats += dt(ntype(unnamed(a0)))
                fatal(nodes[n].pos, "ambiguous call to '{name_of(name)}({ats})': candidates at {pos_str(nodes[cands[best].decl].pos)} and {pos_str(nodes[cd.decl].pos)}")
    if best < 0:
        # (f(e) with e a union and an overload of f for each of its members: chosen by what e holds)
        ud = union_dispatch(n, name, decls, args, expected)
        if ud >= 0: return ud
        if nodes[n].aux2 == -9 and args.len() > 0:
            fatal(nodes[n].pos, "{dt(ntype(unnamed(args[0])))} has no field '{name_of(name)}' or matching zero-argument member: {last_err}")
        # (x.f() with an x that may be none: the function is there for its value)
        if args.len() > 0 and nodes[unnamed(args[0])].type != 0 and types[prune(ntype(unnamed(args[0])))].kind == .opt:
            at = prune(ntype(unnamed(args[0])))
            a0 = unnamed(args[0])
            # (to_float(load_data("best")): what to use when there is nothing, said where it is made)
            if nodes[a0].kind == .call and nodes[a0].sym > 0 and int(nodes[a0].sym) < fns.len() and fns[int(nodes[a0].sym)].decl != 0:
                gn = name_of(int(nodes[int(fns[int(nodes[a0].sym)].decl)].name))
                et0 = prune(int(types[at].elem))
                dv = "default"
                if tkind(et0) == .str_: dv = "\"\""
                else if tkind(et0) == .int_: dv = "0"
                else if tkind(et0) == .float_: dv = "0.0"
                else if tkind(et0) == .bool_: dv = "false"
                fatal(nodes[a0].pos, "{gn} may give none (nothing) rather than a {dt(et0)}: say what to use then, as `{gn}(...) ?? {dv}`, before calling '{name_of(name)}'")
            fatal(nodes[a0].pos, "this {dt(at)} may be none (nothing) rather than a {dt(int(types[at].elem))}: before calling '{name_of(name)}', say what to use then (`x ?? default`){jd(nodes[a0].pos, ", or `x!` when it cannot be none, or `if let v = x: ...`", ", or check it first: `if x isnt? none \{ ... }`")}")
        # (atomic_add(&x, 1): the atomics are for GPU buffers)
        if starts_with(name_of(name), "atomic_") and args.len() > 0 and nodes[unnamed(args[0])].type != 0 and tkind(ntype(unnamed(args[0]))) == .ptr:
            fatal(nodes[n].pos, "{name_of(name)} changes an element of a GpuBuffer in a compute function; threads on the CPU do not share variables: parallel_map gives each one's result back, and a count or flag they share is an Atomic (`done = atomic(0)`, `done.add(1)`)")
        # (xs ^ 2 on an array: the power of each element is .^)
        if name_of(name) == "pow" and args.len() == 2 and nodes[unnamed(args[0])].type != 0:
            t0 = prune(ntype(unnamed(args[0])))
            if types[t0].kind == .array and is_numeric(int(types[t0].elem)): fatal(nodes[n].pos, "^ is not defined for {dt(t0)} (for each element: .^, as in xs .^ 2)")
        # (rect(x, y, w, h) for Rect(x, y, w, h): the drawing function, where the type was meant)
        fnm = name_of(name)
        if len(fnm) > 1 and fnm[0] >= 'a' and fnm[0] <= 'z':
            cap = capitalize(fnm)
            cs = lookup(intern(cap))
            nums = args.len() > 0
            loop a0 in args:
                if nodes[unnamed(a0)].type == 0 or not is_numeric(prune(ntype(unnamed(a0)))): nums = false
            if cs != 0 and syms[cs].kind == .struct_ and nums:
                ot = overloads_text(decls, "")
                fatal(nodes[n].pos, "no version of '{fnm}' takes these arguments (`{cap}(...)` makes a {cap}){ot}")
        # (range(3), set(): Python's, which mean other things here)
        if name_of(name) == "range" and args.len() == 1: fatal(nodes[n].pos, "the numbers from 0 to n - 1 are `[0..n)` ({jd(nodes[n].pos, "`loop i in [0..3):`", "`loop i in [0..3) \{ }`")}); range(a, b) is [a..b)")
        if name_of(name) == "set" and args.len() == 0:
            if dewy_at(nodes[n].pos): fatal(nodes[n].pos, "an empty set is `set[]` with its element type: `let seen:set<string> = set[]`")
            fatal(nodes[n].pos, "there is no set type: a map to bool (`seen: \{str: bool} = \{}`, `seen[x] = true`, `x in seen`), or `unique(xs)`")
        if name_of(name) == "join" and args.len() == 2 and nodes[unnamed(args[1])].type != 0 and tkind(prune(ntype(unnamed(args[1])))) == .array:
            fatal(nodes[n].pos, "join puts text together: {jd(nodes[n].pos, "`[loop x in xs: str(x)]`", "`[loop x in xs string(x)]`")} makes text of each first")
        # (xs.size() and the like: a name that means something else here)
        hh = habit_name(name_of(name))
        if args.len() > 0 and nodes[unnamed(args[0])].type != 0:
            t0 = prune(ntype(unnamed(args[0])))
            mh = ""
            if is_map_type(t0): mh = map_habit_name(name_of(name))
            if len(mh) > 0: fatal(nodes[n].pos, "no '{name_of(name)}' for {dt(t0)} (use {mh})")
            if len(hh) > 0 and types[t0].kind == .array and has_var(t0):
                # (xs = [] then xs.add(5): its type, not known yet, is no help)
                fatal(nodes[n].pos, "no '{name_of(name)}' for a list (use {hh})")
            if len(hh) > 0 and (types[t0].kind == .array or types[t0].kind == .str_): fatal(nodes[n].pos, "no '{name_of(name)}' for {dt(t0)} (use {hh})")
        if decls.len() > 1:
            # (when none fits, the program's own function is the one meant: its error is the one shown)
            own: int[]
            loop d in decls:
                if not decl_in_prelude(d): own.push(d)
            if own.len() == 1: resolve_fn_call(n, name, own, args, expected)
        if decls.len() == 1:
            if len(last_err) == 0: last_err = "arguments do not match"
            ep = nodes[n].pos
            if last_err_pos > 0: ep = last_err_pos
            fatal(ep, "in call to {call_text(decls[0])}: {last_err}")
        ts = ""
        loop i in 0.. and a0 in args:
            a = unnamed(a0)
            if i > 0: ts += if caller_dewy(): " " else: ", "
            if nodes[a].type != 0: ts += dt(ntype(a))
            else: ts += "?"
        sep = ""
        if len(last_err) > 0: sep = ": "
        ot = overloads_text(decls, last_err)
        # (rect(0, 616, 1280, 120): none takes 4, said of them all rather than of the last one tried)
        if len(ot) > 0 and (starts_with(last_err, "too many") or starts_with(last_err, "missing")):
            an = "{args.len()} arguments"
            if args.len() == 1: an = "1 argument"
            fatal(nodes[n].pos, "no version of '{name_of(name)}' takes {an}{ot}")
        what = "({ts})"
        if find(ts, "?") >= 0: what = "these arguments"
        fatal(nodes[n].pos, "no version of '{name_of(name)}' takes {what}{sep}{last_err}{ot}")
    cd = cands[best]
    decl = cd.decl
    # (draw() inside draw: as a way to draw it again, it calls itself without end)
    if (name == id_draw or name == id_update) and modules[int(nodes[decl].mod)].is_main and cx >= 0:
        ci = int(ctxs[cx].inst)
        if ci > 0 and int(fns[ci].decl) == decl:
            fatal(nodes[n].pos, "{name_of(name)} calls itself here, which repeats without end: the game calls {name_of(name)} by itself, each frame")
    np = nkids(decl)
    if (name == id_rgb or name == id_rgba) and np >= 3 and decl_in_prelude(decl): rgb_check(n, cd.args)
    if name == id_hsv and np >= 3 and decl_in_prelude(decl): hsv_check(n, cd.args)
    if not decl_in_prelude(decl) and cx >= 0:
        # (make_world never called: a function of the program's, used from somewhere else)
        ci0 = int(ctxs[cx].inst)
        if ci0 <= 0 or int(fns[ci0].decl) != decl: fn_used[decl] = true
    if decl_in_prelude(decl) and not pos_in_lib(nodes[n].pos):
        frame_call_check(n, decl)
        shader_draw_check(decl, cd.args)
        angle_check(decl, cd.args)
        qn = name_of(int(nodes[decl].name))
        if (starts_with(qn, "quat_") and qn != "quat_rotate" and qn != "quat_to_mat4") or qn == "slerp": quat_nodes[n] = true
        # (random_int(1, 6) for a die: its upper end is left out, as in [1..6))
        rhi = -1
        if name_of(int(nodes[decl].name)) == "random_int" and cd.args.len() == 2 and written_int(cd.args[0]) == 1: rhi = written_int(cd.args[1])
        if rhi == 6 or rhi == 10 or rhi == 12 or rhi == 20 or rhi == 100:
            # (a die's, or a percent's, upper end, as people write it: random_int(1, 7) is quiet,
            # and random_int(1, 5 + 1) says 1 to 5 is meant)
            warn(nodes[n].pos, "random_int(1, {rhi}) gives 1 to {rhi - 1}: its upper end is left out, as in [1..{rhi}); random_int(1, {rhi + 1}) gives 1 to {rhi} (and random_int(1, {rhi - 1} + 1) says 1 to {rhi - 1} is meant)")
        # (random(1, 6) for a die, as Python's randint: a number with a fraction)
        if name_of(int(nodes[decl].name)) == "random" and cd.args.len() == 2 and written_int(cd.args[0]) == 1:
            hi = written_int(cd.args[1])
            if hi == 6 or hi == 10 or hi == 12 or hi == 20 or hi == 100: warn(nodes[n].pos, "random(1, {hi}) gives a number with a fraction (such as 3.7); a whole number from 1 to {hi} is random_int(1, {hi + 1})")
        # (read_bytes("assets/hero.png") in a web page: it has no disk to read the file from)
        if target_wasm and cd.args.len() > 0 and cd.args[0] != 0 and nodes[cd.args[0]].kind == .str_lit and nodes[cd.args[0]].aux == 0:
            fnm = name_of(int(nodes[decl].name))
            if fnm == "read_file" or fnm == "read_bytes":
                f = name_of(int(nodes[cd.args[0]].sval))
                warn(nodes[n].pos, "a web page has no files from the disk: {fnm}(\"{f}\") finds only what the page wrote itself; `embed(\"{f}\")` builds the file into the program")
    partial = has_hole(args) or nodes[n].aux2 == i32(AUX2_PARTIAL)
    if partial and expected != 0 and tkind(expected) == .fn_:
        # (a partial evaluation's expected type is the function it makes: the open parameters
        # in order, then the result)
        rb = cd.binds
        ok = true
        j = 0
        loop i in [0..np):
            a = cd.args[i]
            if a == 0 or nodes[a].kind != .hole: continue
            if j >= int(types[prune(expected)].nargs) or match_type(cd.sig.params[i], targ(prune(expected), j), rb, 0) < 0: ok = false
            j += 1
        if ok and cd.sig.ret != 0 and match_type(int(cd.sig.ret), int(types[prune(expected)].elem), rb, 0) < 0: ok = false
        if ok: cd.binds = rb
    loop i in [0..np):
        a = cd.args[i]
        if a == 0 or not is_lit(a): continue
        p = prune(cd.sig.params[i])
        if types[p].kind == .param and cd.binds[int(types[p].id)] == 0: cd.binds[int(types[p].id)] = lit_default(a)
    loop i in [0..np):
        a = cd.args[i]
        if a == 0 or not ctx_dependent(a) or nodes[a].kind == .hole: continue
        pt = subst_partial(cd.sig.params[i], cd.binds)
        if has_var(pt) and expected != 0 and cd.sig.ret != 0:
            # (a lambda whose parameter types are still open: what the result must be may
            # settle them, as in `x: int = make((v): v + 1)`)
            rb = cd.binds
            if match_type(int(cd.sig.ret), expected, rb, 0) >= 0:
                cd.binds = rb
                pt = subst_partial(cd.sig.params[i], cd.binds)
        # Shared E is a join over callbacks, not a bound frozen by the first
        # argument. Keep its rigid binder in the checking hint until matching.
        row = callable_contract(cd.sig.params[i])
        if row != 0 and effect_contracts[row].variables.len() != 0: pt = mk_callable_contract(callable_base(pt), row)
        check_expr(a, pt)
        add_flag(a, NF_CHECKED)
        matched = match_type(cd.sig.params[i], ntype(a), cd.binds, 0)
        if matched < 0 and callable_contract(cd.sig.params[i]) != 0: fatal(nodes[a].pos, "cannot prove callable effect contract; callback-place permissions cannot flow into E")
    if not partial and expected != 0 and cd.sig.ret != 0:
        rb = cd.binds
        if match_type(int(cd.sig.ret), expected, rb, 0) >= 0: cd.binds = rb
    loop i in [0..targs_here.len()):
        if not type_eq(cd.binds[i], targs_here[i]): fatal(nodes[n].pos, "callback effects exceed the explicit generic argument")
    # (show = false, an untyped parameter, left out: its type is its default's)
    loop i in [0..np):
        if cd.args[i] != 0: continue
        p = prune(cd.sig.params[i])
        if types[p].kind != .param or cd.binds[int(types[p].id)] != 0: continue
        dv = int(nodes[kid(decl, i)].b)
        if dv == 0: continue
        dk = nodes[dv].kind
        if is_lit(dv): cd.binds[int(types[p].id)] = lit_default(dv)
        else if dk == .bool_lit: cd.binds[int(types[p].id)] = T_BOOL
        else if dk == .str_lit: cd.binds[int(types[p].id)] = T_STR
        else if dk == .ident and files[pos_file(nodes[n].pos)].is_dewy:
            loop j in [0..i):
                if nodes[dv].name != nodes[kid(decl, j)].name: continue
                earlier = subst_partial(cd.sig.params[j], cd.binds)
                if not has_var(earlier): cd.binds[int(types[p].id)] = earlier
        # Nonliteral defaults (including large integer literals lowered to
        # constructors) have their ordinary expression type. Resolve names in
        # the declaration's module, just as when emitting the actual default.
        if cd.binds[int(types[p].id)] == 0 and files[pos_file(nodes[n].pos)].is_dewy and (closure != 0 or not default_uses_params(dv, decl, i)):
            ready = true
            loop j in [0..nkids2(decl)):
                if cd.binds[j] == 0 or has_var(cd.binds[j]): ready = false
            if ready:
                inferred = if closure != 0: poly_default_type(decl, i, cd.binds) else: default_arg(decl, i, 0, targs = cd.binds)
                cd.binds[int(types[p].id)] = ntype(inferred)
    loop i in [0..int(cd.sig.ntp)):
        b = cd.binds[i]
        if b == 0:
            # T | Err given just an Err: T is nothing (the union is just Err)
            loop pt in cd.sig.params:
                if param_in_union(pt, i): cd.binds[i] = T_NEVER
            b = cd.binds[i]
        if b == 0 or tkind(b) == .var:
            if partial: fatal(nodes[n].pos, jd(nodes[n].pos, "cannot infer generic types for partial application of '{name_of(name)}'; annotate the arguments", "cannot infer the type parameters of '{name_of(name)}' for this partial evaluation; give the result a function type (`let f:<(b:int64):>int64> = @{name_of(name)}(...)`)"))
            tp = "{i + 1}"
            if int(nodes[decl].nlist2) > i: tp = "'{name_of(int(nodes[kid2(decl, i)].name))}'"
            fatal(nodes[n].pos, "cannot infer type parameter {tp} of '{name_of(name)}' from the arguments")
    if closure != 0:
        variant = poly_default_variant(decl, cd.args)
        if variant != decl:
            decl = variant
            cd.sig = fn_sig(decl)
            supplied: int[]
            loop arg in cd.args:
                if arg != 0: supplied.push(arg)
            cd.args = supplied
            np = supplied.len()
    f = get_fn_inst(decl, cd.binds, nodes[n].pos)
    if ide_on:
        if nodes[n].a != 0: ide_fn_ref(nodes[int(nodes[n].a)].pos, name, f)
        ide_named_args(args, decl, IK_PARAM, fns[f].ptypes)
    capture_defaults = false
    dewy_call = files[pos_file(nodes[n].pos)].is_dewy
    if not partial and dewy_call:
        loop i in [0..np):
            if cd.args[i] == 0 and default_uses_params(int(nodes[kid(decl, i)].b), decl, i): capture_defaults = true
    if capture_defaults and cd.sig.mutmask != 0:
        fatal(nodes[n].pos, "defaults referring to earlier parameters cannot yet be combined with mutable arguments; supply those defaults explicitly")
    captured: int[]
    statements: int[]
    if capture_defaults:
        captured = fill(0, np)
        # Explicit values first, in written order; defaults follow in parameter
        # order. These ordinary locals provide both snapshots and ownership.
        loop source in args:
            a = unnamed(source)
            loop i in [0..np):
                if cd.args[i] != a: continue
                finish_arg(a, representation_type(fns[f].ptypes[i]), false)
                captured[i] = capture_value(a, representation_type(fns[f].ptypes[i]), statements)
                break
    fin: int[]
    loop i in [0..np):
        a = cd.args[i]
        is_mut = has_flag(kid(decl, i), NF_MUT)
        if a == 0:
            earlier = if dewy_call and not capture_defaults: [] else: fin
            a = default_arg(decl, i, (if capture_defaults: representation_type(fns[f].ptypes[i]) else: fns[f].ptypes[i]), earlier, capture_defaults, fns[f].targs)
            if capture_defaults:
                a = capture_value(a, representation_type(fns[f].ptypes[i]), statements)
                finish_arg(a, fns[f].ptypes[i], false)
            fin.push(a)
            continue
        if capture_defaults:
            finish_arg(captured[i], fns[f].ptypes[i], false)
            fin.push(captured[i])
            continue
        if i == 0 and is_mut and dewy_is_method(decl) and place_method == 0:
            place_method = if nodes[decl].kind == .fn_: int(nodes[decl].name) else: dewy_literal_method_name
            finish_arg(a, fns[f].ptypes[i], is_mut)
            place_method = 0
        else: finish_arg(a, fns[f].ptypes[i], is_mut)
        fin.push(a)
    check_mutable_arguments(fin, int(cd.sig.mutmask), nodes[n].pos)
    set_list(n, fin)
    nodes[n].sym = i32(f)
    nodes[n].aux = 0
    nodes[n].kind = .call
    nodes[n].a = 0
    if closure != 0:
        nodes[n].a = i32(poly_fnref(closure, f))
        nodes[n].sym = 0
        nodes[n].aux = 1
    if partial:
        nodes[n].aux2 = 0
        return finish_partial(n, fns[f].ptypes, int(cd.sig.mutmask), int(fns[f].ret))
    if not capture_defaults: save_call_order(n, args, fin)
    nodes[n].type = i32(representation_type(int(fns[f].ret)))
    if capture_defaults:
        call = nodes.len()
        nodes.push(nodes[n])
        result = mk(.exprstmt, nodes[n].pos)
        nodes[result].a = i32(call)
        statements.push(result)
        nodes[n] = Node(kind = .block, pos = nodes[n].pos, type = fns[f].ret)
        if tkind(int(fns[f].ret)) != .void_ and int(fns[f].ret) != T_NEVER: nodes[n].aux = 1
        set_list(n, statements)
    representation_type(int(fns[f].ret))

value_call = (n: int, callee: int, args: int[], expected: int = 0) -> int:
    ft = prune(ntype(callee))
    if types[ft].kind == .polyfn:
        d = poly_families[int(types[ft].st)].decl
        return resolve_fn_call(n, intern("lambda"), [d], args, expected, callee)
    ft = callable_base(ft)
    if types[ft].kind != .fn_ and types[ft].kind != .cfn: fatal(nodes[n].pos, "cannot call a value of type {dt(ft)}")
    na = int(types[ft].nargs)
    if args.len() != na: fatal(nodes[n].pos, "function value expects {na} argument(s), got {args.len()}")
    named = false
    loop a in args:
        if nodes[a].kind == .namedarg: named = true
    final = args
    if named:
        if types[ft].kind == .cfn or types[ft].st == 0: fatal(nodes[n].pos, "this callable has no parameter names; use positional arguments or give it a named function type")
        let names = fn_label_names(int(types[ft].st), na)
        message = map_args(names, fill(false, na), args, final)
        if message != "": fatal(nodes[n].pos, message)
    loop i in 0.. and a in final:
        finish_arg(a, targ(ft, i), int(types[ft].mutmask) & (1 << i) != 0)
    check_mutable_arguments(final, int(types[ft].mutmask), nodes[n].pos)
    set_list(n, final)
    if named: save_call_order(n, args, final)
    nodes[n].a = i32(callee)
    nodes[n].sym = 0
    nodes[n].aux = 1
    if types[ft].kind == .cfn: nodes[n].aux = 4
    if has_hole(args) or nodes[n].aux2 == i32(AUX2_PARTIAL):
        nodes[n].aux2 = 0
        if types[ft].kind == .cfn: fatal(nodes[n].pos, "partial application of C function pointers is not supported")
        pts: int[]
        loop i in [0..na): pts.push(targ(ft, i))
        return finish_partial(n, pts, int(types[ft].mutmask), int(types[ft].elem))
    nodes[n].type = i32(representation_type(int(types[ft].elem)))
    representation_type(int(types[ft].elem))

slot_of = (args: int[], a: int) -> int:
    loop x in args:
        if x == a or (nodes[x].kind == .namedarg and int(nodes[x].a) == a): return a
    a

# the value of a struct type that has default field values (its own, or its fields' structs'),
# as T() makes it with nothing given: what `x: T` and a field left out start as (0: no struct,
# or nothing to set)
struct_default = (t0: int, pos: int) -> int:
    t = prune(t0)
    if refine_active and types[t].kind == .refined:
        d = if tkind(int(types[t].elem)) == .array: mk(.array, pos) else: bc_int(0, pos)
        check_expr(d, int(types[t].elem))
        coerce(d, t)
        return d
    if refine_active and types[t].kind == .fixed and ref_storage_contract(int(types[t].elem)):
        value = mk(.array, pos)
        nodes[value].type = i32(t)
        fixed_literal(value, t)
        add_flag(value, NF_CHECKED)
        return value
    if types[t].kind != .struct_ or is_map_type(t) or is_union(t): return 0
    si = int(types[t].st)
    if not struct_has_defaults(si, 0): return 0
    d = mk(.call, pos)
    struct_ctor_zero(d, t, int(structs[si].decl))
    add_flag(d, NF_CHECKED)
    d

struct_defaults_known: {int: bool} = {}
struct_has_defaults = (si: int, depth: int) -> bool:
    if let k = struct_defaults_known.get(si): return k
    if depth > 16: return false
    check_struct_fields(si)
    has = false
    loop i in [0..int(structs[si].nfields)):
        f = fields[int(structs[si].fields) + i]
        if f.defval != 0 or refine_active and ref_storage_contract(int(f.type)): has = true
        else:
            ft = prune(int(f.type))
            if types[ft].kind == .struct_ and not is_map_type(ft) and not is_union(ft) and struct_has_defaults(int(types[ft].st), depth + 1): has = true
        if has: break
    struct_defaults_known[si] = has
    has

dewy_record_shapes: {str: int} = {}
# an anonymous record shape's fields in the order first written ([y=2 x=1]: y, x), for printing:
# the shape itself is kept by name
dewy_record_order: {int: int[]} = {}

# the order a struct's fields print in: as written for an anonymous record, else as declared
fmt_field_order = (si: int) -> int[]:
    if let order = dewy_record_order.get(int(structs[si].decl)): return order
    order: int[]
    loop i in [0..int(structs[si].nfields)): order.push(i)
    order

dewy_record_target = (expected: int) -> int:
    target = prune(expected)
    if target == 0: return 0
    if types[target].kind == .opt: target = prune(int(types[target].elem))
    if types[target].kind == .struct_ and not is_map_type(target): return target
    0

# The object type a positional literal `[3 4]` builds, or 0: one declared in Dewy, expected
# here, and a literal of plain items (no spread).
dewy_positional_record = (n: int, expected: int) -> int:
    target = dewy_record_target(expected)
    if target == 0 or not dewy_positional_fits(n, target): return 0
    target

dewy_positional_fits = (n: int, target: int) -> bool:
    if not files[pos_file(nodes[n].pos)].is_dewy or array_has_spread(n): return false
    d = int(structs[int(types[target].st)].decl)
    if d == 0 or not files[pos_file(nodes[d].pos)].is_dewy: return false
    loop i in [0..nkids(n)):
        if nodes[kid(n, i)].kind == .namedarg: return false
    true

# With no written field names, the first spread distinguishes `[xs...]` from
# `[record...]`. Inspect a clone so contextual checking retains the source AST.
dewy_spread_source_type = (n: int) -> int:
    # Call arguments may already have become checked constructor calls. Their
    # original type syntax is gone; retain the checked type instead of cloning
    # them as unchecked syntax and trying to resolve them again.
    if nodes[n].type != 0 and has_flag(n, NF_CHECKED): return prune(ntype(n))
    prune(check_expr(clone(n), 0))

dewy_classify_spread = (n: int):
    if nodes[n].kind != .array or nodes[n].b != 0 or nkids(n) == 0: return
    first = kid(n, 0)
    if not has_flag(first, NF_SPREAD) or not files[pos_file(nodes[n].pos)].is_dewy: return
    # Leave set literals contextual, including an empty set whose member type
    # comes from the surrounding array/set or a selected overload.
    if dewy_set_literal(first): return
    t = dewy_spread_source_type(first)
    if types[t].kind == .struct_ and not is_map_type(t) and not is_dewy_set_type(t): nodes[n].kind = .record_lit

# Expand record fields for overload scoring, or capture operands in source
# order for construction. Later entries replace earlier fields; even overwritten
# operands are evaluated. Captured records retain their independent values.
dewy_record_spread_entries = (n: int, expected: int, stmts: mut int[], capture: bool) -> int[]:
    out: int[]
    positions: {int: int} = {}
    field_decls: {int: int} = {}
    target = dewy_record_target(expected)
    target_si = -1
    if target != 0:
        target_si = int(types[target].st)
        check_struct_fields(target_si)
    loop entry in kids(n):
        pos = nodes[entry].pos
        members: int[]
        if has_flag(entry, NF_SPREAD):
            source = entry
            st = dewy_spread_source_type(entry)
            if types[st].kind != .struct_ or is_map_type(st) or is_dewy_set_type(st): fatal(pos, "only records can be spread into a record (found {dt(st)})")
            si = int(types[st].st)
            check_struct_fields(si)
            if capture:
                name = "$record_spread{bc_count}"
                bc_count += 1
                clear_flag(entry, NF_SPREAD)
                stmts.push(bc_let(name, entry, pos))
                source = bc_ident(name, pos)
            loop i in [0..int(structs[si].nfields)):
                fi = int(structs[si].fields) + i
                field = mk(.namedarg, pos)
                nodes[field].name = fields[fi].name
                value = bc_field(source, name_of(int(fields[fi].name)), pos)
                if not capture:
                    nodes[value].type = fields[fi].type
                    add_flag(value, NF_CHECKED)
                nodes[field].a = i32(value)
                members.push(field)
        else:
            if nodes[entry].kind != .namedarg: fatal(pos, "a record literal needs named fields or record spreads")
            field = entry
            if capture:
                name = "$record_field{bc_count}"
                bc_count += 1
                decl = bc_let(name, int(nodes[entry].a), pos)
                stmts.push(decl)
                field = mk(.namedarg, pos)
                nodes[field].name = nodes[entry].name
                nodes[field].a = i32(bc_ident(name, pos))
                field_decls[field] = decl
            members.push(field)
        loop field in members:
            name = int(nodes[field].name)
            if let at = positions.get(name): out[at] = field
            else:
                positions[name] = out.len()
                out.push(field)
    # Context belongs to the surviving fields. An overwritten value still runs,
    # but need not have the type of the field that eventually replaces it.
    if capture and target_si >= 0:
        loop field in out:
            if let decl = field_decls.get(field):
                loop i in [0..int(structs[target_si].nfields)):
                    fi = int(structs[target_si].fields) + i
                    if fields[fi].name == nodes[field].name: nodes[decl].a = i32(type_node_of(int(fields[fi].type), nodes[field].pos)); break
    out

# Canonical field order gives structurally equal anonymous records one type.
# Values are still checked/evaluated in source order by the ordinary constructor.
dewy_record_type = (n: int) -> int:
    args = kids(n)
    names: {int: bool} = {}
    loop field in args:
        name = int(nodes[field].name)
        if names.has(name): fatal(nodes[field].pos, "duplicate record field '{name_of(name)}'")
        names[name] = true
        value = int(nodes[field].a)
        check_expr(value, 0)
        t = finalize_literal(value)
        if has_var(t) or tkind(t) == .void_ or tkind(t) == .typeval:
            fatal(nodes[value].pos, "cannot infer record field '{name_of(name)}'; give the record a type annotation")
        add_flag(value, NF_CHECKED)
        nodes[field].type = i32(t)
    dewy_record_schema(n, args)

# Type annotations and inferred literals share the same structural identity.
# Each member carries its resolved type; source values remain separate.
dewy_record_schema = (n: int, args: int[]) -> int:
    # Small record schemas use insertion sort; source argument storage is separate.
    ordered: int[]
    loop field in args:
        ordered.push(field)
        i = ordered.len() - 1
        loop i > 0 and name_of(int(nodes[ordered[i - 1]].name)) > name_of(int(nodes[field].name)):
            ordered[i] = ordered[i - 1]
            i -= 1
        ordered[i] = field
    # Intern the shape once. Its field types are ordinary type arguments, so
    # generic matching, substitution and specialization need no separate path.
    key = ""
    targs: int[]
    loop field in ordered:
        key += "{int(nodes[field].name)};"
        targs.push(prune(ntype(field)))
    decl = dewy_record_shapes.get(key) ?? 0
    if decl == 0:
        decl = mk(.struct_, nodes[n].pos)
        nodes[decl].name = i32(intern("<record>"))
        nodes[decl].mod = ctxs[cx].mod
        add_flag(decl, NF_RECORD)
        add_flag(decl, NF_GENERIC)
        members: int[]
        params: int[]
        loop i in 0.. and field in ordered:
            param = mk(.ident, nodes[field].pos)
            nodes[param].name = i32(intern("__Field{i}"))
            params.push(param)
            member = mk(.vardecl, nodes[field].pos)
            nodes[member].name = nodes[field].name
            tn = mk(.tname, nodes[field].pos)
            nodes[tn].name = nodes[param].name
            nodes[member].a = i32(tn)
            members.push(member)
        set_list(decl, members)
        set_list2(decl, params)
        dewy_record_shapes[key] = decl
        written: int[]
        loop field in args:
            loop i in 0.. and other in ordered:
                if other == field: written.push(i)
        dewy_record_order[decl] = written
    t = get_struct_inst(decl, targs)
    check_struct_fields(int(types[t].st))
    t

# (set by the compiler's own default-value constructions, T() as `x: T` starts: those fill what
# has no default with zero; a construction written in Dewy may not)
ctor_fills_zero = false

# T() for the compiler's own use: the type's defaults, zero where it has none
struct_ctor_zero = (n: int, st_type: int, decl: int) -> int:
    ctor_fills_zero = true
    struct_ctor(n, st_type, decl, [], st_type)

struct_ctor = (n: int, st_type: int, decl: int, args: int[], expected: int) -> int:
    fills_zero = ctor_fills_zero
    ctor_fills_zero = false
    t = st_type
    if t == 0 and nkids2(decl) == 0: t = get_struct_inst(decl, [])
    if t == 0:
        ntp = nkids2(decl)
        binds = fill(0, ntp)
        ex = prune(expected)
        if expected != 0 and types[ex].kind == .struct_ and int(structs[int(types[ex].st)].decl) == decl: t = ex
        else:
            mark = scope_mark()
            loop i in [0..ntp):
                nm = int(nodes[kid2(decl, i)].name)
                push_scope_sym(nm, new_sym(nm, .type_, mk_param(i), 0))
            check_args_untyped(args)
            pnames: int[]
            hasdef: bool[]
            loop i in [0..nkids(decl)):
                pnames.push(int(nodes[kid(decl, i)].name))
                hasdef.push(true)
            mapped: int[]
            err = map_args(pnames, hasdef, args, mapped)
            if len(err) > 0: fatal(nodes[n].pos, err)
            loop i in [0..nkids(decl)):
                a = mapped[i]
                if a == 0 or ctx_dependent(a): continue
                f = kid(decl, i)
                if nodes[f].a == 0: continue
                pat = resolve_type(int(nodes[f].a))
                if is_lit(a): finalize_literal(a)
                match_type(pat, ntype(a), binds, 0)
            # As with function calls, first collect known argument types, then
            # check contextual literals/callbacks against the partially bound
            # field types. Empty collections can use another field's type.
            loop i in [0..nkids(decl)):
                a = mapped[i]
                if a == 0 or not ctx_dependent(a) or nodes[a].kind == .hole: continue
                f = kid(decl, i)
                if nodes[f].a == 0: continue
                pat = resolve_type(int(nodes[f].a))
                check_expr(a, subst_partial(pat, binds))
                add_flag(a, NF_CHECKED)
                match_type(pat, ntype(a), binds, 0)
            scope_reset(mark)
            loop i in [0..ntp):
                if binds[i] == 0: fatal(nodes[n].pos, "cannot infer type parameter '{name_of(int(nodes[kid2(decl, i)].name))}' of {name_of(int(nodes[decl].name))}")
            t = get_struct_inst(decl, binds)
    si = int(types[prune(t)].st)
    check_struct_fields(si)
    nf = int(structs[si].nfields)
    pnames: int[]
    hasdef: bool[]
    loop i in [0..nf):
        pnames.push(int(fields[int(structs[si].fields) + i].name))
        hasdef.push(true)
    mapped: int[]
    err = map_args(pnames, hasdef, args, mapped)
    if len(err) > 0: fatal(nodes[n].pos, "in {name_of(int(nodes[decl].name))}(...): {err}")
    if not fills_zero and files[pos_file(nodes[decl].pos)].is_dewy:
        # (a Dewy object is built from what is given and its defaults, never from invented zeros)
        loop i in [0..nf):
            fi = int(structs[si].fields) + i
            if mapped[i] == 0 and int(fields[fi].defval) == 0:
                fatal(nodes[n].pos, "{dt(t)} needs its field '{name_of(int(fields[fi].name))}', which has no default")
    missing_field_check(n, decl, si, args, mapped)
    if ide_on:
        fts: int[]
        loop i in [0..nf): fts.push(int(fields[int(structs[si].fields) + i].type))
        ide_named_args(args, decl, IK_FIELD, fts)
    # (a struct that holds itself, a: A, says so before its fields' defaults are made: they would
    # make one another without end)
    layout(t)
    # A default naming an earlier field takes the value this construction gives it:
    # explicit values are kept first, in written order, then defaults in field order.
    dependent = false
    if files[pos_file(nodes[decl].pos)].is_dewy:
        names: int[]
        loop i in [0..nf):
            fi = int(structs[si].fields) + i
            if mapped[i] == 0 and default_uses_names(int(fields[fi].defval), names): dependent = true
            names.push(int(fields[fi].name))
    captured = fill(0, nf)
    statements: int[]
    if dependent:
        loop source in args:
            a = unnamed(source)
            loop i in [0..nf):
                if mapped[i] != a and mapped[i] != source: continue
                if nodes[a].kind == .hole: fatal(nodes[a].pos, "partial application of constructors is not supported")
                ft = representation_type(int(fields[int(structs[si].fields) + i].type))
                finish_arg(a, ft, false)
                captured[i] = capture_value(a, ft, statements)
                break
    fin: int[]
    loop i in [0..nf):
        fi = int(structs[si].fields) + i
        a = mapped[i]
        if dependent and a != 0:
            finish_arg(captured[i], int(fields[fi].type), false)
            fin.push(captured[i])
            continue
        if a == 0:
            dv = int(fields[fi].defval)
            if dv != 0 and not dependent and default_is_zero(dv, int(fields[fi].type)):
                # (filled in place with zeros, not built aside and copied in)
                fin.push(0)
                continue
            if dv != 0:
                d = clone(dv)
                saved = cx
                ctxs.push(FnCtx(ctxs[cx].inst, -1, i32(T_VOID), false, 0, nodes[decl].mod, i32(sc_names.len())))
                cx = ctxs.len() - 1
                mark = scope_mark()
                targs: int[]
                loop j in [0..int(structs[si].ntargs)): targs.push(struct_targ(si, j))
                push_type_params(decl, targs)
                if dependent:
                    loop j in [0..i):
                        if captured[j] == 0: continue
                        name = int(fields[int(structs[si].fields) + j].name)
                        push_scope_sym(name, new_sym(name, .local, int(nodes[captured[j]].sym), 0))
                check_expr(d, representation_type(int(fields[fi].type)))
                coerce(d, representation_type(int(fields[fi].type)))
                scope_reset(mark)
                ctxs.pop()
                cx = saved
                if dependent:
                    d = capture_value(d, representation_type(int(fields[fi].type)), statements)
                    finish_arg(d, int(fields[fi].type), false)
                finish_arg(d, int(fields[fi].type), false)
                captured[i] = d
                fin.push(d)
            else:
                d = struct_default(int(fields[fi].type), nodes[n].pos)
                if dependent and d != 0:
                    d = capture_value(d, representation_type(int(fields[fi].type)), statements)
                    finish_arg(d, int(fields[fi].type), false)
                captured[i] = d
                fin.push(d)
            continue
        if nodes[a].kind == .hole: fatal(nodes[a].pos, "partial application of constructors is not supported")
        finish_arg(a, int(fields[fi].type), false)
        fin.push(a)
    nodes[n].kind = .call
    nodes[n].aux = 2
    if not dependent: save_call_order(n, args, fin)
    set_list(n, fin)
    nodes[n].type = i32(t)
    nodes[n].a = 0
    if dependent:
        call = nodes.len()
        nodes.push(nodes[n])
        result = mk(.exprstmt, nodes[n].pos)
        nodes[result].a = i32(call)
        statements.push(result)
        nodes[n] = Node(kind = .block, pos = nodes[n].pos, type = i32(t), aux = 1)
        set_list(n, statements)
    t

# A field default whose value is the zero bytes: `none` for an optional, `[]` for a fixed array
default_is_zero = (dv: int, ft: int) -> bool:
    k = nodes[dv].kind
    fk = tkind(ft)
    if k == .none_lit: return fk == .opt
    k == .array and nkids(dv) == 0 and nodes[dv].b == 0 and fk == .fixed

# (P(1) for struct P: x: f64; y: f64: values given in order stop short of a field without a
# default, which would be zero unnoticed; T() and names only, T(x = 1), leave fields out on purpose)
missing_field_check = (n: int, decl: int, si: int, args: int[], mapped: int[]):
    npos = 0
    loop a in args:
        if nodes[a].kind != .namedarg: npos += 1
    if npos == 0 or pos_in_lib(nodes[n].pos): return
    nf = int(structs[si].nfields)
    # (one or two left out: more, as Enemy(pos, kind) of a struct of many fields, is on purpose)
    left = 0
    loop i in [0..nf):
        if mapped[i] == 0 and int(fields[int(structs[si].fields) + i].defval) == 0: left += 1
    if left > 2: return
    loop i in [0..nf):
        fi = int(structs[si].fields) + i
        if mapped[i] != 0 or int(fields[fi].defval) != 0: continue
        # (an empty array or map, false, none: as likely meant as not)
        fk = tkind(int(fields[fi].type))
        sn = name_of(int(nodes[decl].name))
        fname = name_of(int(fields[fi].name))
        if fk == .fn_:
            warn(nodes[n].pos, "{sn}(...) leaves its function field '{fname}' with nothing to call (calling it stops the program): give it, as `{sn}(..., {fname} = (): ...)`, or set it before it is called")
            return
        if fk != .int_ and fk != .float_ and fk != .vec and fk != .str_ and fk != .struct_: continue
        warn(nodes[n].pos, "{sn}(...) leaves its field '{fname}' at zero ({npos} of its {nf} fields given in order): give it, give it a default in the struct (`{fname}: {dt(int(fields[fi].type))} = ...`), or name the fields given (`{sn}({name_of(int(fields[int(structs[si].fields)].name))} = ...)`)")
        return

variant_ctor = (n: int, et: int, vi: int, args: int[]) -> int:
    si = int(types[prune(et)].st)
    v = int(structs[si].variants) + vi
    nf = int(variants[v].nfields)
    pnames: int[]
    hasdef: bool[]
    loop i in [0..nf):
        pnames.push(int(fields[int(variants[v].fields) + i].name))
        hasdef.push(false)
    mapped: int[]
    err = map_args(pnames, hasdef, args, mapped)
    if len(err) > 0: fatal(nodes[n].pos, "in {name_of(int(variants[v].name))}(...): {err}")
    loop i in [0..nf): finish_arg(mapped[i], int(fields[int(variants[v].fields) + i].type), false)
    nodes[n].kind = .call
    nodes[n].aux = 3
    nodes[n].aux2 = i32(vi)
    save_call_order(n, args, mapped)
    set_list(n, mapped)
    nodes[n].type = i32(et)
    nodes[n].a = 0
    et

conversion = (n: int, to0: int, args: int[]) -> int:
    to = prune(to0)
    tk = types[to].kind
    if args.len() == 1 and charlike(args[0]) and tk == .int_:
        # (int("5") reads as the number 5 to a Python programmer, but a one-character string is its code)
        a0 = args[0]
        if nodes[a0].kind == .str_lit and not type_eq(to, T_U8) and src_char(nodes[a0].pos) == '"':
            # (int('0') in single quotes, as character arithmetic writes it, is the code)
            w = name_of(int(nodes[a0].sval))
            if len(w) == 1 and w[0] >= '0' and w[0] <= '9':
                fatal(nodes[n].pos, "{dt(to0)}(\"{w}\") would be the code of the character {w} ({int(w[0])}): `to_int(\"{w}\")` reads the number, and `{jd(nodes[n].pos, "u8", "uint8")}('{w}')` is the code")
        charlike_to_int(args[0])
    if tk == .vec: return check_vec_ctor(n, to, args)
    if args.len() != 1 or nodes[args[0]].kind == .namedarg: fatal(nodes[n].pos, "{dt(to0)}(...) takes one argument")
    if tk == .str_:
        part = mk(.pair, nodes[n].pos)
        nodes[part].a = i32(args[0])
        nodes[part].sval = -1
        nodes[n] = Node(kind = .str_lit, pos = nodes[n].pos, aux = 1)
        set_list(n, [part])
        return check_expr(n, 0)
    a = args[0]
    check_expr(a, if tk == .float_ and nodes[a].kind == .float_lit: to else: 0)
    ft = prune(ntype(a))
    if tk == .int_ and nodes[a].kind == .float_lit and nodes[a].sval != 0: ft = exact_decimal(a)
    if tk == .int_ and (bundled_rational_type(ft) or bundled_word_rational_type(ft)):
        source = nodes.len()
        nodes.push(nodes[a])
        add_flag(source, NF_CHECKED)
        rational_helper_call(a, "_truncate", source, T_MATH_INT)
        if to != T_MATH_INT: coerce(a, to)
        nodes[n] = nodes[a]
        return to
    if (ft == T_MATH_INT and (bundled_bigint_type(to) or math_rep_type(to))) or (to == T_MATH_INT and (bundled_bigint_type(ft) or math_rep_type(ft))):
        coerce(a, to)
        nodes[n] = nodes[a]
        return to
    if bundled_rational_type(ft) and tk == .float_:
        coerce(a, to)
        nodes[n] = nodes[a]
        return to
    if is_lit(a) and nodes[a].kind == .float_lit and tk == .int_ and to == T_MATH_INT:
        coerce(a, T_FLOAT)
        nodes[n] = nodes[a]
        wrap_conv(n, .float2int, to)
        return to
    if is_lit(a) and nodes[a].kind == .float_lit and tk == .int_:
        nodes[a].kind = .int_lit
        nodes[a].ival = int(nodes[a].fval)
    if is_lit(a) and is_numeric(to):
        coerce(a, to)
        nodes[n] = nodes[a]
        return to
    fk = types[ft].kind
    cv = -1
    if tk == .int_:
        if fk == .int_: check_integer_boundary(a, ft, to)
        if fk == .int_ or fk == .bool_: cv = int(CV.int_)
        else if fk == .float_: cv = int(CV.float2int)
        else if fk == .enum_ and simple_enum(ft): cv = int(CV.int_)
        else if fk == .ptr: cv = int(CV.ptr)
    else if tk == .float_:
        if fk == .int_: cv = int(CV.int2float)
        else if fk == .float_: cv = int(CV.float_)
    else if tk == .bool_:
        if fk == .bool_: cv = int(CV.none_)
    if cv < 0:
        hint = ""
        read_int = if dewy_at(nodes[n].pos): T_MATH_INT else: T_INT
        if fk == .str_ and tk == .int_: hint = " (`to_int(s)` reads a number from text: it gives {a_type(mk_opt(read_int))}, none when the text is not one)"
        if fk == .str_ and tk == .float_: hint = " (`to_float(s)` reads a number from text: it gives {a_type(mk_opt(T_FLOAT))}, none when the text is not one)"
        fatal(nodes[n].pos, "cannot convert {dt(ft)} to {dt(to)}{hint}")
    if type_eq(ft, to):
        nodes[n] = nodes[a]
        return to
    nodes[n] = Node(kind = .conv, pos = nodes[n].pos, a = i32(a), aux = i32(cv), type = i32(to), flags = i32(NF_CHECKED))
    to

# (Key(n): a simple enum's variant by its number, as int(Key.a) gives it, its variants numbered
# 0, 1, 2... in order; one that is not there stops the program, saying which)
enum_from_int = (n: int, et: int, a: int) -> int:
    si = int(types[prune(et)].st)
    nv = int(structs[si].nvariants)
    loop v in [0..nv):
        if variants[int(structs[si].variants) + v].value != v: fatal(nodes[n].pos, "{dt(et)}(n) needs its variants numbered 0, 1, 2... in order (some are given numbers of their own)")
    pos = nodes[n].pos
    c = bc_call("__enum_from", [a, bc_int(nv, pos), bc_str(dt(et), pos)], pos)
    check_expr(c, T_INT)
    nodes[n] = Node(kind = .conv, pos = pos, a = i32(last_checked), aux = i32(int(CV.int_)), type = i32(et), flags = i32(NF_CHECKED))
    et

collect_in = (table: {int: int}, name: int, out: mut int[]):
    s = table.get(name) ?? 0
    if s != 0 and hide_private and is_private(name) and (not hide_lib_only or name_of(name)[1] != '_'): return
    if s == 0 or syms[s].kind != .fns: return
    o = s
    loop o != 0:
        d = int(syms[o].decl)
        if not surface_sees(o, caller_dewy()): surface_hidden.push(d)
        else if not out.contains(d): out.push(d)
        o = int(syms[o].next)

# Library operations Dewy spells differently from the Jo library underneath. For these
# names, the definitions in lib/std/files.jo are Dewy's (`read_bytes` gives a value or a file
# error) and the others stay the Jo library's; a Dewy program calling a Jo spelling is told
# Dewy's. (One spelling per operation: the Jo names are not Dewy's.)
dewy_surface_hints: {int: str}
dewy_surface_table = () -> {int: str}:
    if dewy_surface_hints.len() == 0:
        loop entry in [
            ("read_file", "`read_text(path)` (or `p\"file\".read_text`) gives the text or a file error"),
            ("write_file", "`write_text(path text)` (or `p\"file\".write_text(text)`) gives the byte count or a file error"),
            ("read_bytes", "`read_bytes(path)` (or `p\"file\".read_bytes`) gives the bytes or a file error"),
            ("write_bytes", "`write_bytes(path bytes)` (or `p\"file\".write_bytes(bytes)`) gives the byte count or a file error"),
            ("append_file", "`append_file(path text)` adds to the end of the file and gives the byte count or a file error"),
            ("is_dir", "`is_directory(path)` (or `p\"dir\".is_dir`)"),
            ("mkdir", "`make_directory(path)` (or `p\"dir\".mkdir`) gives `true` or a file error"),
            ("delete_file", "`remove_file(path)` (or `p\"file\".unlink`) gives `true` or a file error"),
            ("delete_dir", "`remove_directory(path)` (or `p\"dir\".rmdir`) gives `true` or a file error"),
            ("list_dir", "`list_directory(path)` (or `p\"dir\".list`) gives the entries or a file error"),
            ("run_program", "`run(program args)` gives the exit status or SpawnError, and `capture(program args)` the output too; a program is a path (`run(\"/usr/bin/env\" [name ...])` searches PATH)"),
            ("run_shell", "`run(\"/bin/sh\" [\"-c\" command])` (or `capture` for its output)"),
            ("file_name", "`p(path).name`"),
            ("dir_name", "`p(path).parent`"),
            ("extension", "`p(path).suffix`"),
            ("without_extension", "`p(path).with_suffix(\"\")`"),
            ("join_path", "`p\"\{a}/\{b}\"`: a path interpolates as its text"),
            ("sort_by", "`xs.sort(key=f)` sorts by a key (`reverse=true` for largest first)"),
            ("sorted_by", "`xs.sorted(key=f)` gives a copy sorted by a key (`reverse=true` for largest first)")]:
            dewy_surface_hints[intern(entry.0)] = entry.1
    dewy_surface_hints

# (for a library declaration of the name: 1 when only Dewy sees it, 2 when only Jo does, 0 both;
# the Jo library's are those of a path's text, `read_bytes(f: File n)` stays both's)
dewy_surface = (name: int, decl: int) -> int:
    if not dewy_surface_table().has(name): return 0
    if dewy_renamed(name): return 2
    if files[pos_file(nodes[decl].pos)].path == lib_dir + "/std/files.jo": return 1
    if nkids(decl) == 0: return 0
    t = int(nodes[kid(decl, 0)].a)
    if t != 0 and nodes[t].kind == .tname and name_of(int(nodes[t].name)) == "str": return 2
    0

# (a Jo library operation that Dewy spells another way whatever its arguments)
dewy_renamed = (name: int) -> bool: name == intern("sort_by") or name == intern("sorted_by")

# Suggested names as the source at pos spells them: Dewy's own words for the
# implementation's builtin types and sequence length.
surface_names = (names: int[], pos: int) -> int[]:
    if not dewy_at(pos): return names
    out: int[]
    loop nm in names:
        w = name_of(nm)
        d = if w == "len": "length" else if w == "str": "string" else if w == "f64": "float64" else if w == "f32": "float32" else: ""
        if d == "" and len(w) >= 2 and len(w) <= 3 and (w[0] == 'i' or w[0] == 'u') and is_digit(w[1]):
            if w == "i8" or w == "i16" or w == "i32" or w == "i64": d = "int" + w[1..]
            if w == "u8" or w == "u16" or w == "u32" or w == "u64": d = "uint" + w[1..]
        out.push(if d != "": intern(d) else: nm)
    out

# (does code in Dewy (dewy) or Jo see the library declaration of symbol o? see dewy_surface)
surface_sees = (o: int, dewy: bool) -> bool: syms[o].surface == 0 or (syms[o].surface == 1) == dewy

# (is the code being checked Dewy's? the library's own code is Jo)
caller_dewy = () -> bool:
    m = cur_mod()
    m >= 0 and files[int(modules[m].file)].is_dewy

# (declarations collect_in left out for the caller's language, since the last call_by_name)
surface_hidden: int[]

# A Dewy call that only a Jo spelling would take: Dewy's spelling instead.
dewy_surface_check = (n: int, name: int, decls: int[], args: int[]):
    if surface_hidden.len() == 0 or not caller_dewy(): return
    hint = dewy_surface_table().get(name) ?? ""
    if hint == "": return
    if dewy_renamed(name): fatal(nodes[n].pos, "'{name_of(name)}' is not Dewy's: {hint}")
    # (checking an argument may check other calls, which collect their own)
    hidden: int[]
    loop d in surface_hidden: hidden.push(d)
    # (only the first argument, the path, when a Dewy spelling may take these arguments: the
    # others stay unchecked for its parameters to guide them)
    count = args.len()
    loop d in decls:
        if nkids(d) >= args.len() and count > 1: count = 1
    ts: int[]
    loop a in args[..count):
        if nodes[a].kind == .namedarg: return
        if not has_flag(a, NF_CHECKED):
            check_expr(a, 0)
            add_flag(a, NF_CHECKED)
        ts.push(ntype(a))
    if decl_takes(decls, ts) or not decl_takes(hidden, ts): return
    fatal(nodes[n].pos, "'{name_of(name)}' is not Dewy's: {hint}")

decl_takes = (decls: int[], ts: int[]) -> bool:
    loop d in decls:
        sig = fn_sig(d)
        if nkids(d) < ts.len(): continue
        binds = fill(0, int(sig.ntp))
        ok = true
        loop i in [0..ts.len()):
            if match_type(sig.params[i], ts[i], binds, 0) < 0:
                ok = false
                break
        if ok: return true
    false

# (while set, collect_in leaves out private names: those of used modules, or with
# hide_lib_only those of the library)
hide_private = false
hide_lib_only = false

collect_module = (m: int, name: int, out: mut int[]):
    if m < 0: return
    if modules[m].is_prelude: collect_in(prelude, name, out)
    else:
        collect_in(modules[m].names, name, out)
        hide_private = true
        loop u in modules[m].uses:
            hide_lib_only = modules[u].is_prelude
            if modules[u].is_prelude: collect_in(prelude, name, out)
            else: collect_in(modules[u].names, name, out)
        hide_private = false

collect_fns = (name: int, out: mut int[]):
    m = cur_mod()
    collect_module(m, name, out)
    hide_private = m >= 0 and not modules[m].is_prelude
    hide_lib_only = true
    collect_in(prelude, name, out)
    hide_private = false

# Fold mathematical powers and floor operations before selecting their runtime
# overload. Every intermediate is checked, including exponentiation by squaring.
dewy_math_fold = (n: int, a: int, b: int, power: bool, modulo: bool) -> bool:
    if prune(ntype(a)) != T_MATH_INT: return false
    known_a, x = integer_constant(a)
    known_b, y = integer_constant(b)
    if not known_a or not known_b: return false
    value = 0
    if power:
        if y < 0: return false
        value = 1
        loop y > 0:
            if y & 1 == 1:
                if math_word_overflow(2, value, x): return false
                value *= x
            y = y >> 1
            if y > 0:
                if math_word_overflow(2, x, x): return false
                x *= x
    else:
        if y == 0: fatal(nodes[n].pos, "integer division by zero in constant expression")
        if not modulo and math_word_overflow(3, x, y): return false
        if modulo:
            if y != -1: value = x % y
            if value != 0 and (value < 0) != (y < 0): value += y
        else:
            value = x / y
            if x - value * y != 0 and (x < 0) != (y < 0): value -= 1
    nodes[n] = Node(kind = .int_lit, pos = nodes[n].pos, ival = value, type = i32(T_MATH_INT), flags = i32(NF_CHECKED))
    true

dewy_arithmetic_call = (n: int, name: int, args: int[], expected: int) -> int:
    literal_divisor = nodes[args[1]].kind == .int_lit
    checked: int[]
    loop i in 0.. and arg in args:
        hint = 0
        if i == 0 and is_quantity(expected) and is_float(quantity_base(expected)): hint = expected
        if expected != 0 and is_float(expected) and nodes[arg].kind == .float_lit: hint = expected
        else if i == 0 and expected != 0 and is_numeric(expected) and name != intern("__dewy_divide"): hint = expected
        check_expr(arg, hint)
        checked.push(last_checked)
        add_flag(last_checked, NF_CHECKED)
    a = checked[0]
    b = checked[1]
    exact_operands = (is_numeric(ntype(a)) or bundled_rational_type(ntype(a)) or bundled_bigint_type(ntype(a))) and (is_numeric(ntype(b)) or bundled_rational_type(ntype(b)) or bundled_bigint_type(ntype(b)))
    if exact_operands and not is_float(expected) and not (is_float(ntype(a)) and not is_lit(a)) and not (is_float(ntype(b)) and not is_lit(b)):
        if nodes[a].kind == .float_lit and nodes[a].sval != 0 and is_lit(a): exact_decimal(a)
        if nodes[b].kind == .float_lit and nodes[b].sval != 0 and is_lit(b): exact_decimal(b)
    if is_quantity(ntype(a)) or is_quantity(ntype(b)):
        return quantity_arithmetic(n, name, a, b, expected)
    if name == intern("__dewy_divide"):
        ta = prune(ntype(a))
        tb = prune(ntype(b))
        pos = nodes[n].pos
        if (is_int(ta) or bundled_bigint_type(ta)) and (is_int(tb) or bundled_bigint_type(tb)):
            known_b, divisor = integer_constant(b)
            if known_b and divisor == 0: fatal(nodes[b].pos, "division by zero: the divisor of `/` is the constant 0")
            known_a, dividend = integer_constant(a)
            minimum = -9223372036854775807 - 1
            if known_a and known_b and dividend != minimum and divisor != minimum and (dividend >= 0 or types[ta].sign) and (divisor >= 0 or types[tb].sign):
                nodes[n] = nodes[rational_constant(dividend, divisor, pos)]
                t = check_expr(n, expected)
                rational_constants[n] = rational_constant_parts(dividend, divisor)
                return t
            # Resolve exact arithmetic only after the operand types are known;
            # ordinary floating division does not load either exact library.
            ensure_bundled_import("rational.dewy", "$dewy_rational", pos)
            callee = bc_field(bc_ident("$dewy_rational", pos), "rational", pos)
            nodes[n] = Node(kind = .call, pos = pos, a = i32(callee))
            set_list(n, checked)
        else:
            nodes[n] = Node(kind = .binary, pos = pos, op = i32(int(Tok.slash)), a = i32(a), b = i32(b))
        return check_expr(n, expected)
    modulo = name == intern("__floor_mod")
    power = name == intern("__dewy_power")
    if is_struct_like(ntype(a)) or is_struct_like(ntype(b)):
        op = if power: "**" else if modulo: "%" else: "//"
        nodes[n] = Node(kind = .binary, pos = nodes[n].pos, a = i32(a), b = i32(b))
        result = op_overload(n, op)
        if result == 0:
            label = if power: "^" else: op
            fatal(nodes[n].pos, "operator {label} is not defined for {dt(ntype(a))} and {dt(ntype(b))}")
        return result
    if is_numeric(ntype(a)) and is_numeric(ntype(b)):
        if power: finalize_literal(a)
        else: join_types(a, b, nodes[n].pos)
        if dewy_math_fold(n, a, b, power, modulo): return T_MATH_INT
    # (`//` and `%` are integer and exact operations; floats have no floor quotient)
    if not power and (is_float(ntype(a)) or is_float(ntype(b))):
        ft = if is_float(ntype(a)): ntype(a) else: ntype(b)
        if modulo: fatal(nodes[n].pos, "`%` is not defined for {dt(ft)}: the remainder is an integer and exact-number operation")
        fatal(nodes[n].pos, "`//` is not defined for {dt(ft)}: floor division is an integer and exact-number operation; `(a / b).floor()` rounds a float quotient down")
    # Only built-in arithmetic may replace a literal divisor with a shift or
    # mask. Custom protocols receive the original operand, including 1 or 2^k.
    helper = name
    divisor = nodes[b].ival
    if not power and literal_divisor and nodes[b].kind == .int_lit and divisor > 0 and not has_flag(b, NF_U64) and (divisor & (divisor - 1)) == 0:
        if modulo:
            helper = intern("__floor_mod_pow2")
            nodes[b].ival = divisor - 1
        else:
            helper = intern("__floor_div_pow2")
            shift = 0
            loop divisor > 1:
                divisor = divisor >> 1
                shift += 1
            nodes[b].ival = shift
            nodes[b].type = i32(T_INT) # generated shift count, not the divisor
    if nodes[n].a != 0: nodes[int(nodes[n].a)].name = i32(helper)
    declarations: int[]
    collect_fns(helper, declarations)
    result = resolve_fn_call(n, helper, declarations, checked, expected)
    # Internal scalar policy: retain the builtin operation's captured actuals.
    # Custom operators and the proven positive power-of-two path are separate.
    if fact_policy == .RequireStatic and not power and helper == name and is_int(ntype(a)) and is_int(ntype(b)):
        fact_divisors[n] = if modulo: 2 else: 1
    result

# (literal numbers and arithmetic on them: their type comes from the call)
number_literal_tree = (n: int) -> bool:
    k = nodes[n].kind
    if k == .int_lit or k == .float_lit: return true
    if k == .unary: return number_literal_tree(int(nodes[n].a))
    if k == .binary: return number_literal_tree(int(nodes[n].a)) and number_literal_tree(int(nodes[n].b))
    false

# (the library functions Dewy calls with physical quantities: dewy_quantity_call)
quantity_call_names: int[]
dewy_quantity_name = (name: int) -> bool:
    if quantity_call_names.len() == 0: quantity_call_names = [intern("sleep"), intern("sin"), intern("cos"), intern("tan")]
    name == quantity_call_names[0] or name == quantity_call_names[1] or name == quantity_call_names[2] or name == quantity_call_names[3]

call_by_name = (n: int, name: int, mod_scope: int, args: int[], expected: int, ufcs: bool) -> int:
    if ide_sentinel != 0 and name == ide_sentinel:
        if ufcs and args.len() > 0:
            check_expr(args[0], 0)
            ide_complete_members(ntype(args[0]))
        ide_complete_names()
    # `rational(...)`: the builtin exact type's constructor, unless a binding shadows it.
    if not ufcs and mod_scope < 0 and name == intern("rational") and lookup(name) == 0 and files[pos_file(nodes[n].pos)].is_dewy:
        pos = nodes[n].pos
        ensure_bundled_import("rational.dewy", "$dewy_rational", pos)
        fname = "rational"
        # (of a float: its exact binary value)
        if args.len() == 1 and nodes[args[0]].kind != .namedarg:
            if tkind(check_expr(args[0], 0)) == .float_:
                fname = "_from_float"
                set_kid(n, 0, last_checked)
        nodes[n].a = i32(bc_field(bc_ident("$dewy_rational", pos), fname, pos))
        return check_expr(n, expected)
    if not ufcs and mod_scope < 0 and args.len() == 2 and (name == intern("__floor_div") or name == intern("__floor_mod") or name == intern("__dewy_power") or name == intern("__dewy_divide")) and files[pos_file(nodes[n].pos)].is_dewy:
        if nodes[args[0]].kind != .namedarg and nodes[args[1]].kind != .namedarg:
            return dewy_arithmetic_call(n, name, args, expected)
    if not ufcs and mod_scope < 0 and args.len() == 1 and dewy_quantity_name(name) and (name == quantity_call_names[0] or not number_literal_tree(args[0])) and nodes[args[0]].kind != .namedarg and files[pos_file(nodes[n].pos)].is_dewy:
        s = lookup(name)
        if s != 0 and syms[s].kind == .fns and decl_in_prelude(int(syms[s].decl)):
            a0 = args[0]
            check_expr(a0, 0)
            add_flag(a0, NF_CHECKED)
            r = dewy_quantity_call(n, name, a0, expected)
            if r != 0: return r
    ii = intrinsic_of(name)
    if ii >= 0 and intrinsics[ii].arr and args.len() > 0:
        a0 = args[0]
        if not has_flag(a0, NF_CHECKED):
            check_expr(a0, 0)
            add_flag(a0, NF_CHECKED)
        t0 = prune(ntype(a0))
        if types[t0].kind == .array or types[t0].kind == .str_:
            # (the program's own insert(t: mut T[], k) and the like, taking that many arguments: its)
            own: int[]
            cm = cur_mod()
            if (not ufcs or mod_scope < 0) and cm >= 0 and not modules[cm].is_prelude:
                all_d: int[]
                collect_module(cm, name, all_d)
                loop d in all_d:
                    if not decl_in_prelude(d) and args_fit(d, args.len()) and takes_seq(d): own.push(d)
            if own.len() > 0: return resolve_fn_call(n, name, own, args, expected)
            if ide_on: ide_builtin_ref(n, name)
            return check_intrinsic(n, intrinsics[ii].id, args, expected)
        if types[t0].kind == .fixed:
            if intrinsics[ii].id == .arrdata: fatal(nodes[n].pos, "data() is for a growable array T[]; a fixed-size one is stored in place: `&x` is where its first element is (what C wants)")
            if intrinsics[ii].id != .len:
                member = name
                if ide_dewy_alt(name) != 0: member = ide_dewy_alt(name)
                fatal(nodes[n].pos, jd(nodes[n].pos, "{name_of(name)}() needs a growable array T[]; {dt(t0)} has a fixed size", "`.{name_of(member)}` needs a growable array (`array<T>`); {dt(t0)} has a fixed length"))
            # Calls and indexed receivers still evaluate, even though the
            # resulting length is statically known.
            if nodes[a0].kind != .ident: return check_intrinsic(n, .len, args, expected)
            # (the size is part of the type)
            nodes[n] = Node(kind = .int_lit, pos = nodes[n].pos, ival = fixed_len(t0), type = i32(T_INT), flags = i32(NF_CHECKED))
            return T_INT
    decls: int[]
    if not ufcs:
        s = 0
        if mod_scope >= 0: s = module_lookup(mod_scope, name)
        else: s = lookup(name)
        if s != 0:
            sk = syms[s].kind
            if ide_on and (sk == .struct_ or sk == .type_ or sk == .enum_) and nodes[n].a != 0: ide_sym_ref(int(nodes[n].a), s)
            if sk == .local or sk == .global:
                vt = 0
                if sk == .local: vt = int(locals[int(syms[s].ref)].type)
                else:
                    ensure_global(int(syms[s].ref), nodes[n].pos)
                    vt = int(globals[int(syms[s].ref)].type)
                if tkind(vt) == .fn_ or tkind(vt) == .cfn or tkind(vt) == .polyfn or tkind(vt) == .callable:
                    callee = mk(.ident, nodes[n].pos)
                    nodes[callee].name = i32(name)
                    callee_at = callee
                    if mod_scope >= 0:
                        check_expr_in_module(callee, mod_scope)
                    else: check_expr(callee, 0)
                    return value_call(n, callee, args, expected)
            else if sk == .struct_: return struct_ctor(n, 0, int(syms[s].ref), args, expected)
            else if sk == .enum_:
                ed = int(syms[s].ref)
                if nkids2(ed) == 0 and args.len() == 1 and nodes[args[0]].kind != .namedarg:
                    et = get_struct_inst(ed, [])
                    if simple_enum(et): return enum_from_int(n, et, args[0])
                fatal(nodes[n].pos, "use {name_of(name)}.variant(...) to construct an enum")
            else if sk == .type_: return conversion(n, int(syms[s].ref), args)
            else if sk == .fns and args.len() == 1 and nodes[args[0]].kind != .namedarg and universe.get(name) != none:
                # (str(5) beside the program's str = (b: Big) -> str: the type's conversion, when
                # no function of the name takes the value)
                at = prune(check_expr(args[0], 0))
                add_flag(args[0], NF_CHECKED)
                fd: int[]
                collect_fns(name, fd)
                takes = false
                loop d in fd:
                    sig = fn_sig(d)
                    if sig.params.len() >= 1 and (sig.generic or can_coerce(args[0], at, sig.params[0])): takes = true
                if not takes: return conversion(n, int(syms[universe[name]].ref), args)
            else if sk == .const_ or sk == .module: fatal(nodes[n].pos, "'{name_of(name)}' is not a function")
            else if sk == .builtin:
                collect_fns(name, decls)
                if decls.len() == 0:
                    if ide_on: ide_builtin_ref(n, name)
                    return check_intrinsic(n, int(syms[s].ref) as IN, args, expected)
    surface_hidden.clear()
    if mod_scope >= 0: collect_module(mod_scope, name, decls)
    else: collect_fns(name, decls)
    if name == intern("to_int") and mod_scope < 0 and files[pos_file(nodes[n].pos)].is_dewy:
        own = false
        loop d in decls:
            if not decl_in_prelude(d): own = true
        if not own:
            parser = intern("__mi_parse")
            demand_prelude_name(parser)
            decls = []
            collect_fns(parser, decls)
            return resolve_fn_call(n, parser, decls, args, expected)
    # Index operators belong to the receiver's module, just like methods. A
    # selected import of a container type must also make its operators usable.
    indexed = name == intern("[]") or name == intern("[]=")
    if (ufcs or indexed) and args.len() > 0:
        if indexed and not has_flag(args[0], NF_CHECKED):
            check_expr(args[0], 0)
            add_flag(args[0], NF_CHECKED)
        tm = module_of_type(ntype(args[0]))
        if tm >= 0: collect_module(tm, name, decls)
        if indexed:
            protocol = intern(if name == intern("[]"): "__index__" else: "__setindex__")
            if mod_scope >= 0: collect_module(mod_scope, protocol, decls)
            else: collect_fns(protocol, decls)
            if tm >= 0: collect_module(tm, protocol, decls)
    if surface_hidden.len() > 0: dewy_surface_check(n, name, decls, args)
    if decls.len() == 0:
        if ii >= 0 and not intrinsics[ii].arr:
            if ide_on: ide_builtin_ref(n, name)
            return check_intrinsic(n, intrinsics[ii].id, args, expected)
        if ii >= 0 and intrinsics[ii].arr and args.len() > 0: fatal(nodes[n].pos, "'{name_of(name)}' expects an array or string, found {dt(ntype(args[0]))}")
        if ufcs:
            t0 = prune(ntype(args[0]))
            # (step.1() for a tuple whose element 1 is a function: that element, called)
            nm0 = name_of(name)
            if types[t0].kind == .tuple and len(nm0) > 0 and is_digit(nm0[0]):
                if let k = to_int(nm0):
                    if k < int(types[t0].nargs) and tkind(targ(t0, k)) == .fn_:
                        el = mk(.field, nodes[n].pos)
                        nodes[el].a = i32(args[0])
                        nodes[el].aux = -2
                        nodes[el].ival = k
                        check_expr(el, 0)
                        add_flag(el, NF_CHECKED)
                        return value_call(n, el, args[1..])
            cands = fn_names_for(t0)
            if types[t0].kind == .struct_:
                si = int(types[t0].st)
                loop i in [0..int(structs[si].nfields)): cands.push(int(fields[int(structs[si].fields) + i].name))
            if is_map_type(t0) and len(map_habit_name(name_of(name))) > 0: fatal(nodes[n].pos, "no field or function '{name_of(name)}' for type {dt(t0)} (use {map_habit_name(name_of(name))})")
            # (m.groups(): a field, called as a method)
            if types[t0].kind == .struct_:
                si = int(types[t0].st)
                loop i in [0..int(structs[si].nfields)):
                    if int(fields[int(structs[si].fields) + i].name) == name: fatal(nodes[n].pos, "'{name_of(name)}' is a field, not a function: `x.{name_of(name)}`, without ()")
            tsh = dt(ntype(args[0]))
            # (xs = [] with nothing in it yet: its type is not known, and its name for it means nothing)
            if has_var(prune(ntype(args[0]))):
                tsh = "this value (its type is not known yet)"
                if types[t0].kind == .array: tsh = "an array"
                fatal(nodes[n].pos, "no field or function '{name_of(name)}' for {tsh}{suggestion(name_of(name), surface_names(cands, nodes[n].pos))}")
            fatal(nodes[n].pos, "no field or function '{name_of(name)}' for type {tsh}{suggestion(name_of(name), surface_names(cands, nodes[n].pos))}")
        # a variable of the same name hides the function or type
        hs = lookup(name)
        if hs != 0 and syms[hs].kind == .local:
            if starts_with(name_of(name), "$index_end"): fatal(nodes[n].pos, "end is the last index inside brackets; it cannot be called")
            fatal(nodes[n].pos, "'{name_of(name)}' is a variable of type {dt(int(locals[int(syms[hs].ref)].type))} here (it hides the function or type of that name); rename the variable")
        if hs != 0 and syms[hs].kind == .global:
            g = int(syms[hs].ref)
            ensure_global(g, nodes[n].pos)
            fatal(nodes[n].pos, "'{name_of(name)}' is a variable of type {dt(int(globals[g].type))}, not a function")
        # (Msg(Move(3)), Msg a union: its members are Msgs as they are)
        if hs != 0 and syms[hs].kind == .alias_ and nkids2(int(syms[hs].ref)) == 0:
            at = resolve_alias(int(syms[hs].ref), [], nodes[n].pos)
            if is_union(at):
                ms: str[]
                loop m in union_members(at): ms.push(dt(m))
                un = name_of(name)
                fatal(nodes[n].pos, "'{un}' is a union ({join(ms, " | ")}): a {ms[0]} is a {un} as it is, with nothing around it: {jd(nodes[n].pos, "`m: {un} = {ms[0]}(...)`", "`let m:{un} = {ms[0]}[...]`")}")
        all = visible_names()
        loop it in intrinsics: all.push(intern(it.name))
        # (physics3d.world(): the names of that module, World among them)
        if mod_scope >= 0 and not ufcs and not modules[mod_scope].is_prelude:
            all = []
            loop k, v in modules[mod_scope].names: all.push(k)
        # (import net, then tcp_connect(...): the module's, written with its name)
        loop mi in [0..modules.len()):
            if modules[mi].is_prelude or modules[mi].names.get(name) == none: continue
            mn = name_of(int(modules[mi].name))
            if lookup(intern(mn)) != 0: fatal(nodes[n].pos, "unknown function '{name_of(name)}' (it is {mn}'s: `{mn}.{name_of(name)}(...)`)")
        uh = unused_file_hint(name)
        if len(uh) > 0: fatal(nodes[n].pos, "unknown function '{name_of(name)}'{uh}")
        fatal(nodes[n].pos, "unknown function '{name_of(name)}'{private_hint(name)}{suggestion(name_of(name), surface_names(all, nodes[n].pos))}")
    resolve_fn_call(n, name, decls, args, expected)

id_rgb = intern("rgb")
id_rgba = intern("rgba")
id_hsv = intern("hsv")
id_draw = intern("draw")
id_update = intern("update")

# rgb(255, 128, 0): colors go from 0 to 1 (more is brighter than white, for glow)
rgb_check = (n: int, args: int[]):
    big = false
    loop i in [0..3):
        # (a little above 1 is brighter than white, as a flash or a glow in 3D: rgb(3, 3, 3))
        if lit_num(args[i]) > 8.0: big = true
    if big: warn(nodes[n].pos, "the parts of a color go from 0 to 1 (above 1: brighter than white): for 0 to 255, divide by 255 or write hex(0xff8000)")
    # (rgba(0, 0, 0, 10): an alpha from 0 to 255)
    else if args.len() >= 4 and lit_num(args[3]) > 1.0: warn(nodes[int(args[3])].pos, "alpha goes from 0 (clear) to 1 (solid): {num_text(lit_num(args[3]))} of 255 is {lit_num(args[3]) / 255.0:.2f}")

# hsv(200, 0.8, 0.9): a hue in degrees, which goes around 0 to 1 here
hsv_check = (n: int, args: int[]):
    h = lit_num(args[0])
    if h > 1.0: warn(nodes[n].pos, "a hue goes from 0 to 1 around the color circle (as 0 to 360 degrees): {num_text(h)} degrees is `{h} / 360.0`")

num_text = (v: f64) -> str:
    if v == floor(v) and abs(v) < 1e15: return "{i64(v)}"
    "{v}"

# a number written as it is (5, 0.5): its value, else -1
lit_num = (a0: int) -> f64:
    if a0 == 0: return -1.0
    a = unnamed(a0)
    if not has_flag(a, NF_LITERAL) and nodes[a].kind != .float_lit: return -1.0
    if nodes[a].kind == .int_lit: return f64(nodes[a].ival)
    if nodes[a].kind == .float_lit: return nodes[a].fval
    if nodes[a].kind == .conv: return lit_num(int(nodes[a].a))
    -1.0

# (is p among the arguments of print, text, window and the like, on its line?)
# (".png" after a name in the source: cat1.png written without its quotes)
# the name after a dot after the n characters at p (this.tweens: "tweens"), or ""
member_after = (p: int, n: int) -> str:
    f = pos_file(p)
    if f < 0 or f >= files.len(): return ""
    src = files[f].src
    o = pos_off(p) + n
    if o >= len(src) or src[o] != '.': return ""
    e = o + 1
    loop e < len(src) and (is_alnum(src[e]) or src[e] == '_'): e += 1
    src[o + 1..e)

# (this.tweens.add, this.time.delayedCall, game.config.width: Phaser's, through its scene)
phaser_hint = (nm: str, member: str) -> str:
    if nm != "this" and nm != "game" and nm != "scene": return ""
    if member == "tweens": return " (a tween is a value: `t = tween(from, to, 0.3, ease = ease_out_back)`, kept in a variable or a field, with `t.update(dt)` and `t.value()` each frame)"
    if member == "time": return " (a wait is `Actions`: `steps.then(0.5, (): drop())` and `steps.update(dt)` in update; or `every(1, 0.5)`)"
    if member == "config" or member == "scale": return " (the screen's size is `screen_width()` and `screen_height()`)"
    if member == "add": return " (things are drawn each frame in draw, `circle(...)`, `sprite(...)`, `text(...)`, not added to a scene)"
    if member == "input": return " (input is asked for in update each frame: `mouse_pressed(.left)`, `mouse_pos()`, `key_pressed(.space)`)"
    if member == "sound": return " (`snd = load_wav(embed(\"pop.wav\"))` at the top, then `play(snd)`; or `sfx_coin()` and the other ready-made sounds)"
    if member == "cameras": return " (`shake` for a screen shake, `camera2d(...)` to move the view)"
    if member == "scene": return " (screens are an enum, `screen = Screen.play`, with a `match screen:` in update and in draw)"
    ""

file_ext_after = (p: int, n: int) -> str:
    f = pos_file(p)
    if f < 0 or f >= files.len(): return ""
    src = files[f].src
    o = pos_off(p) + n
    if o >= len(src) or src[o] != '.': return ""
    e = o + 1
    loop e < len(src) and is_alnum(src[e]): e += 1
    ext = lower(src[o + 1..e))
    loop x in ["png", "jpg", "jpeg", "wav", "ogg", "mp3", "txt", "json", "csv", "ttf", "otf", "glb", "gltf", "tmx", "jo"]:
        if ext == x: return src[o..e)
    ""

# (a name in the source alone between { and }: in a string, an interpolation of just it)
braced_alone = (p: int, n: int) -> bool:
    f = pos_file(p)
    if f < 0 or f >= files.len(): return false
    src = files[f].src
    o = pos_off(p)
    o > 0 and o + n < len(src) and src[o - 1] == '{{' and src[o + n] == '}}'

in_text_call = (p: int) -> bool:
    f = pos_file(p)
    if f < 0 or f >= files.len(): return false
    src = files[f].src
    o = pos_off(p) - 1
    loop o >= 0 and src[o] != '(' and src[o] != '\n' and src[o] != '"': o -= 1
    if o < 0 or src[o] != '(': return false
    e = o
    o -= 1
    loop o >= 0 and (is_alnum(src[o]) or src[o] == '_'): o -= 1
    w = src[o + 1..e)
    w == "print" or w == "text" or w == "text_centered" or w == "window" or w == "write" or w == "ui_button" or w == "ui_text" or w == "eprint"

# (the word w at p is all of an argument, made of letters only: print(hello), not print(totl + 1))
is_word_arg = (p: int, w: str) -> bool:
    loop c in w:
        if not is_alpha(c) or c == u8(95): return false
    src = files[pos_file(p)].src
    e = pos_off(p) + len(w)
    loop e < len(src) and src[e] == ' ': e += 1
    e < len(src) and (src[e] == ')' or src[e] == ',')

# (`thorns = Rect[]`: the name before the `=` on the line of p, "" when there is none)
name_before_eq = (p: int) -> str:
    f = pos_file(p)
    if f < 0 or f >= files.len(): return ""
    src = files[f].src
    o = pos_off(p) - 1
    # (p may be at the `[` after the type's name: that name first)
    loop o >= 0 and (is_alnum(src[o]) or src[o] == '_'): o -= 1
    loop o >= 0 and src[o] == ' ': o -= 1
    if o < 0 or src[o] != '=': return ""
    o -= 1
    loop o >= 0 and src[o] == ' ': o -= 1
    e = o + 1
    loop o >= 0 and (is_alnum(src[o]) or src[o] == '_'): o -= 1
    src[o + 1..e)

# (written in braces in the source: "{4}", not print(4) made into text)
brace_before = (p: int) -> bool:
    f = pos_file(p)
    if f < 0 or f >= files.len(): return false
    o = pos_off(p)
    src = files[f].src
    o > 0 and o <= len(src) and src[o - 1] == u8(123)          # ('{')

# "a str", "an int", "an f64", "a float64": a type named with its article
a_type = (t: int) -> str:
    s = dt(t)
    if len(s) > 0 and (s[0] == 'a' or s[0] == 'e' or s[0] == 'i' or s[0] == 'o' or (s[0] == 'f' and not ts_dewy) or s[0] == 'A' or s[0] == 'E' or s[0] == 'I' or s[0] == 'O'): return "an {s}"
    "a {s}"

coerce_hint = ""     # (said after a type mismatch, by what asked for the type)

fn_used: {int: bool}            # the program's functions called or used as a value (by decl)
drew_in: {int: bool}            # (functions, by instance, that have drawn something so far)
draw_to_at: {int: int}          # (draw's first draw_to, by instance)
back_to_screen: {int: bool}     # (draw calls draw_to_screen)

DRAWING_FNS = ["circle", "rect", "line", "text", "text_centered", "text_wrapped", "sprite", "polygon", "polyline",
    "circle_gradient", "rect_gradient", "quad_gradient", "triangle", "arc", "draw_mesh", "draw_tilemap", "draw_anim",
    "draw_model", "draw_sprite", "image_draw"]

# drawing in update, clearing after drawing, sleeping in a frame: done where it shows nothing,
# covers what was drawn, or stops the game
frame_call_check = (n: int, decl: int):
    if cx < 0: return
    ci = int(ctxs[cx].inst)
    if ci <= 0 or fns[ci].decl == 0: return
    fd = int(fns[ci].decl)
    if not modules[int(nodes[fd].mod)].is_main: return
    here = name_of(int(nodes[fd].name))
    fnm = name_of(int(nodes[decl].name))
    drawing = false
    loop d in DRAWING_FNS:
        if d == fnm: drawing = true
    if drawing:
        if here == "update":
            mm = int(nodes[fd].mod)
            if modules[mm].names.get(intern("draw")) != none: warn(nodes[n].pos, "{fnm} draws, and update is for changing things: what it draws here is covered when draw clears the screen; draw it in `draw`")
            else: warn(nodes[n].pos, "{fnm} draws, and update is for changing things: drawing goes in a function of its own, `draw = ():`, which the game calls each frame after update")
        drew_in[ci] = true
    # (into a render target, then the screen: clearing that is the start of another picture)
    if fnm == "draw_to" or fnm == "draw_to_screen" or starts_with(fnm, "begin_") or fnm == "camera3d": drew_in.remove(ci)
    # (draw_to(rt) in draw and never draw_to_screen(): the rest of the frame goes into rt)
    if here == "draw" and fnm == "draw_to" and not draw_to_at.has(ci): draw_to_at[ci] = nodes[n].pos
    if here == "draw" and fnm == "draw_to_screen": back_to_screen[ci] = true
    if fnm == "clear" and drew_in.get(ci) != none and here == "draw": warn(nodes[n].pos, "clear covers everything drawn before it in this frame: clear the screen first, at the top of draw")
    if (fnm == "input" or fnm == "input_int" or fnm == "input_float" or fnm == "read_line" and nkids(decl) == 0) and (here == "update" or here == "draw"):
        warn(nodes[n].pos, "{fnm} waits for a line typed in the terminal, and the game stops while it waits: in the window, `hud_text_field(rect, name)` is a box to type in (or `text_input()`, what was typed this frame)")
    if fnm == "sleep" and (here == "update" or here == "draw"): warn(nodes[n].pos, "sleep stops the whole game, every frame: to wait, count down a timer (`wait -= dt`, act when it is below 0), or `every(1, 2.0)`")

fmt_plain: {int: bool} = {}       # (__fmt_fields nodes that format the fields, not the program's str)

# (an __fmt_fields node's aux2: 1 inside a container, FMT_DEWY in Dewy's literal syntax)
const FMT_DEWY = 2

# a field formatting leaves out: a record literal's method, and in Dewy any function
fmt_hidden = (ft: int, aux2: i32) -> bool:
    dewy_method_field(ft) != 0 or (int(aux2) & FMT_DEWY != 0 and is_fn_type(ft))

# a minted Dewy type (`type of error & [...]`): its values print with its name, Name[x=1]
fmt_minted = (si: int) -> bool:
    d = int(structs[si].decl)
    d != 0 and nodes[d].kind == .struct_ and nodes[d].a != 0 and dewy_at(nodes[d].pos)

# the library's last-resort __fmt, (buf, x): __fmt_fields(buf, x), rather than one for the type
fmt_fallback = (inst: int) -> bool:
    sig = fn_sig(int(fns[inst].decl))
    sig.params.len() == 2 and tkind(sig.params[1]) == .param

# the program's `str` for type t (str = (b: Big) -> str, beside the type), as an instance, or 0
program_str_fn = (t0: int, pos: int) -> int:
    t = prune(t0)
    if tkind(t) != .struct_ and tkind(t) != .enum_: return 0
    d0 = int(structs[int(types[t].st)].decl)
    if d0 == 0 or modules[int(nodes[d0].mod)].is_prelude: return 0
    fd: int[]
    collect_module(int(nodes[d0].mod), intern("str"), fd)
    loop d in fd:
        if decl_in_prelude(d) or nkids(d) != 1: continue
        sig = fn_sig(d)
        if sig.generic or sig.params.len() != 1 or not type_eq(prune(sig.params[0]), t): continue
        return get_fn_inst(d, [], pos)
    0

# a library function called as another language's of the same name is (p5's line(x1, y1, x2,
# y2), fill(r, g, b) and push(); atan(y, x)): what it is here, before its overloads are tried
habit_call_names: {int: bool} = {}
habit_call_check = (n: int, name: int, args: int[]):
    if habit_call_names.len() == 0:
        loop w in ["line", "text", "clear", "fill", "push", "pop", "map", "atan", "random"]: habit_call_names[intern(w)] = true
    if not habit_call_names.has(name): return
    nm = name_of(name)
    # (the program's own function of the name: its call)
    own: int[]
    collect_fns(name, own)
    loop d in own:
        if not decl_in_prelude(d): return
    na = args.len()
    num = (a: int) -> bool:
        k = nodes[unnamed(a)].kind
        k == .int_lit or k == .float_lit or (k == .unary and (nodes[int(nodes[unnamed(a)].a)].kind == .int_lit or nodes[int(nodes[unnamed(a)].a)].kind == .float_lit))
    pos = nodes[n].pos
    if nm == "line" and na >= 4 and num(args[0]) and num(args[1]): fatal(pos, "line takes two points: `line(vec2(x1, y1), vec2(x2, y2), width, color)`")
    if nm == "text" and na >= 3 and num(args[1]) and num(args[2]): fatal(pos, "where text goes is one vec2: `text(s, vec2(x, y), size, color)`")
    if nm == "clear" and na == 1 and nodes[unnamed(args[0])].kind == .tuple: fatal(pos, "clear takes a color: `clear(rgb(0.1, 0.1, 0.1))` (each from 0 to 1)")
    if nm == "fill" and na >= 3 and num(args[0]) and num(args[1]) and num(args[2]): fatal(pos, "there is no fill color: each shape takes its color, `circle(pos, r, rgb(1, 0, 0))` (fill(x, n) makes an array of n copies of x)")
    if nm == "push" and na == 0: fatal(pos, "push() here is push_transform() (and pop() is pop_transform()); xs.push(x) adds to an array")
    if nm == "pop" and na == 0: fatal(pos, "pop() here is pop_transform(), after push_transform(); xs.pop() takes from an array")
    if nm == "map" and na == 5: fatal(pos, "the range a..b moved to c..d is `remap(x, a, b, c, d)`; map(xs, f) is f of each element")
    if nm == "atan" and na == 2: fatal(pos, "the angle of (x, y) is `atan2(y, x)`; atan takes one number")
    if nm == "random" and na == 1:
        if nodes[unnamed(args[0])].kind == .array: fatal(pos, "a random element is `random_item(xs)`")
        if num(args[0]): fatal(pos, "random takes where it starts and ends: `random(0, 10)` (a whole number: `random_int(0, 10)`)")

# draw(prog, quad, Other(...)) where prog = make_shader(shader(vs, fs)) takes U: a Shader does not
# carry its uniforms' type, so the one its functions take is found where the global is made
shader_draw_check = (decl: int, args: int[]):
    fnm = name_of(int(nodes[decl].name))
    if fnm != "draw" and not starts_with(fnm, "draw_instanced") and not starts_with(fnm, "draw_indirect"): return
    if args.len() < 3 or args[0] == 0: return
    a0 = unnamed(args[0])
    if nodes[a0].kind != .ident or nodes[a0].aux != i32(int(SK.global)) or nodes[a0].type == 0 or dt(ntype(a0)) != "Shader": return
    g = int(nodes[a0].sym)
    if g <= 0 or globals[g].decl == 0: return
    ut = shader_uniforms_in(int(nodes[int(globals[g].decl)].b))
    if ut == 0: return
    loop i in [0..min(args.len(), nkids(decl))):
        if name_of(int(nodes[kid(decl, i)].name)) != "params" or args[i] == 0: continue
        a = unnamed(args[i])
        if nodes[a].type == 0 or type_eq(prune(ntype(a)), prune(ut)): return
        gn = name_of(int(globals[g].name))
        fatal(nodes[a].pos, "{gn}'s shader functions take {dt(ut)} as their uniforms, and this is {dt(ntype(a))}: give it a {dt(ut)}")

# the uniforms type of the shader functions named in e (make_shader(shader(vs, fs))), or 0
shader_uniforms_in = (e: int) -> int:
    if e == 0: return 0
    if nodes[e].kind == .fnref:
        f = int(nodes[e].sym)
        if f > 0 and fns[f].ptypes.len() == 2 and type_eq(int(fns[f].ret), T_VEC4): return fns[f].ptypes[1]
        return 0
    if nodes[e].kind == .lambda or nodes[e].kind == .fn_: return 0
    r = shader_uniforms_in(int(nodes[e].a))
    if r != 0: return r
    loop i in [0..nkids(e)):
        r = shader_uniforms_in(kid(e, i))
        if r != 0: return r
    0

# rotation_y(45): an angle in degrees given where radians go
angle_check = (decl: int, args: int[]):
    fnm = name_of(int(nodes[decl].name))
    loop i in [0..min(args.len(), nkids(decl))):
        a = args[i]
        if a == 0 or not has_flag(a, NF_LITERAL): continue
        txt = ""
        v = 0.0
        if nodes[a].kind == .int_lit:
            v = f64(nodes[a].ival)
            txt = "{nodes[a].ival}"
        else if nodes[a].kind == .float_lit:
            v = nodes[a].fval
            txt = "{v}"
        else: continue
        if abs(v) <= 6.3: continue
        pn = name_of(int(nodes[kid(decl, i)].name))
        if pn == "angle" or pn == "yaw" or pn == "pitch" or pn == "roll" or (pn == "a" and (starts_with(fnm, "rotation") or starts_with(fnm, "quat_"))):
            warn(nodes[a].pos, "{txt} radians is more than a whole turn: angles are in radians (a turn is TAU, 6.28); `{txt}deg` is {txt} degrees")

# a function's name and parameters as written: circle(center: vec2, radius: f64, c: vec4, segments: int = 0)
# f(..., e, ...) where e is a union (Walker | Flyer) and f has an overload taking each of its
# members there: `let u = e; if u is Walker: f(..., u, ...) else ...` (the type it gives back), or
# -1 when there is no such argument
union_dispatch = (n: int, name: int, decls: int[], args: int[], expected: int) -> int:
    loop i in 0.. and a0 in args:
        a = unnamed(a0)
        if nodes[a].type == 0: continue
        ut = prune(ntype(a))
        if not is_union(ut): continue
        ms = union_members(ut)
        every = true
        loop m in ms:
            found = false
            loop d in decls:
                sig = fn_sig(d)
                if i < sig.params.len() and not has_var(prune(sig.params[i])) and type_eq(sig.params[i], m): found = true
            if not found: every = false
        if not every: continue
        pos = nodes[n].pos
        un = "__ud{bc_count}"
        bc_count += 1
        # (a variable or field is tested and passed itself, narrowed: a `mut` parameter changes it)
        place = nodes[a].kind == .ident or (nodes[a].kind == .field and len(path_key(a)) > 0)
        # (from the last member, which needs no test, back to the first)
        chain = 0
        j = ms.len() - 1
        loop j >= 0:
            arm: int[]
            loop k in 0.. and x in args:
                if k == i:
                    v = 0
                    if place: v = ud_path(a)
                    else: v = bc_ident(un, pos)
                    if nodes[x].kind == .namedarg:
                        na = mk(.namedarg, nodes[x].pos)
                        nodes[na].name = nodes[x].name
                        nodes[na].a = i32(v)
                        arm.push(na)
                    else: arm.push(v)
                else: arm.push(clone(x))
            body = bc_block([bc_stmt(bc_call(name_of(name), arm, pos), pos)], pos)
            if chain == 0: chain = body
            else:
                it = mk(.istype, pos)
                if place: nodes[it].a = i32(ud_path(a))
                else: nodes[it].a = i32(bc_ident(un, pos))
                ty = mk(.tname, pos)
                nodes[ty].aux = -7
                nodes[ty].ival = ms[j]
                nodes[it].b = i32(ty)
                f = mk(.if_, pos)
                nodes[f].a = i32(it)
                nodes[f].b = i32(body)
                if nodes[chain].kind == .block: nodes[f].c = i32(chain)
                else: nodes[f].c = i32(bc_block([chain], pos))
                chain = f
            j -= 1
        blk = 0
        if place: blk = bc_block([chain], pos)
        else: blk = bc_block([bc_let(un, a, pos), chain], pos)
        nodes[n] = nodes[blk]
        return check_expr(n, expected)
    -1

# x.f where x is a union whose members are all structs with a field f of one type: n becomes
# `let u = x; if u is A: u.f else ...` (x itself when it is a variable or field); -1 if not
union_field = (n: int, ut: int, fname: int) -> int:
    ms = union_members(ut)
    ft = 0
    loop m in ms:
        pm = prune(m)
        if types[pm].kind != .struct_: return -1
        si = int(types[pm].st)
        check_struct_fields(si)
        found = 0
        loop i in [0..int(structs[si].nfields)):
            f = int(structs[si].fields) + i
            if int(fields[f].name) == fname: found = int(fields[f].type)
        if found == 0: return -1
        if ft == 0: ft = found
        else if not type_eq(ft, found): return -1
    a = int(nodes[n].a)
    pos = nodes[n].pos
    place = nodes[a].kind == .ident or (nodes[a].kind == .field and len(path_key(a)) > 0)
    un = "__uf{bc_count}"
    bc_count += 1
    chain = 0
    j = ms.len() - 1
    loop j >= 0:
        base = 0
        if place: base = ud_path(a)
        else: base = bc_ident(un, pos)
        body = bc_block([bc_stmt(bc_field(base, name_of(fname), pos), pos)], pos)
        if chain == 0: chain = body
        else:
            it = mk(.istype, pos)
            if place: nodes[it].a = i32(ud_path(a))
            else: nodes[it].a = i32(bc_ident(un, pos))
            ty = mk(.tname, pos)
            nodes[ty].aux = -7
            nodes[ty].ival = ms[j]
            nodes[it].b = i32(ty)
            f = mk(.if_, pos)
            nodes[f].a = i32(it)
            nodes[f].b = i32(body)
            if nodes[chain].kind == .block: nodes[f].c = i32(chain)
            else: nodes[f].c = i32(bc_block([chain], pos))
            chain = f
        j -= 1
    blk = 0
    if place: blk = bc_block([chain], pos)
    else: blk = bc_block([bc_let(un, a, pos), chain], pos)
    nodes[n] = nodes[blk]
    n

# an unchecked copy of a variable or field path (each arm tests and narrows it afresh)
ud_path = (a: int) -> int:
    if nodes[a].kind == .ident: return bc_ident(name_of(int(nodes[a].name)), nodes[a].pos)
    bc_field(ud_path(int(nodes[a].a)), name_of(int(nodes[a].name)), nodes[a].pos)

# (the ones a call with the wrong number of arguments could have meant: "; there are f(a: int),
# f(a: int, b: int)")
overloads_text = (decls: int[], err: str) -> str:
    if decls.len() < 2: return ""
    # (only when how many arguments was wrong: a wrong one's type is said already)
    if len(err) > 0 and not starts_with(err, "too many") and not starts_with(err, "missing"): return ""
    s = ""
    k = 0
    loop d in decls:
        if starts_with(name_of(int(nodes[d].name)), "__"): continue
        if k == 4: return s + " ..."
        if k == 0: s = "; there are "
        else: s += ", "
        s += call_text(d)
        k += 1
    s

call_text = (d: int) -> str:
    if caller_dewy(): return dewy_call_text(d)
    s = "{name_of(int(nodes[d].name))}("
    loop i in [0..nkids(d)):
        if i > 0: s += ", "
        s += ide_param_text(nodes[kid(d, i)].pos)
    s + ")"

# (a declaration as a Dewy program sees it: its Dewy name, `@` for a mutable parameter and Dewy
# types, whitespace between parameters, whichever language declares it)
dewy_call_text = (d: int) -> str:
    nm = int(nodes[d].name)
    alt = ide_dewy_alt(nm)
    sig = fn_sig(d)
    if alt == 0: alt = nm
    s = "{name_of(alt)}("
    # (a method by its type, without its hidden receiver)
    first = 0
    if dewy_is_method(d) and sig.params.len() > 0:
        s = "{dt(sig.params[0])}.{name_of(alt)}("
        first = 1
    loop i in [first..nkids(d)):
        p = kid(d, i)
        if i > first: s += " "
        if has_flag(p, NF_MUT) or int(sig.mutmask) & (1 << i) != 0: s += "@"
        pn = name_of(int(nodes[p].name))
        if starts_with(pn, "$parameter"): pn = "_"
        s += pn
        if i < sig.params.len() and sig.params[i] != 0: s += ":{dt(sig.params[i])}"
    s += ")"
    # (a generic declaration's type parameters by their names)
    i = nkids2(d) - 1
    loop i >= 0:
        s = replace(s, "${i}", name_of(int(nodes[kid2(d, i)].name)))
        i -= 1
    s

# ---------------- reading values from text (lib/std/text.jo) ----------------
# __read_fields(r, x) for a value of type t: statements that read it with r (a __TextIn)
read_code = (t: int, rn: str, xn: str, pos: int) -> int[]:
    k = types[t].kind
    st: int[]
    if k == .struct_:
        # Name(field=value, ...): by name, in any order; others skipped, missing ones left as they are
        si = int(types[t].st)
        check_struct_fields(si)
        st.push(rcall("__tx_open", rn, [], pos))
        chain = rcall("__tx_skip", rn, [], pos)
        # (a Dewy record's field without a default must be in the text: nothing is invented for it)
        dewy = files[pos_file(nodes[int(structs[si].decl)].pos)].is_dewy
        required: int[]
        i = int(structs[si].nfields) - 1
        loop i >= 0:
            f = fields[int(structs[si].fields) + i]
            fi = i
            i -= 1
            fk = tkind(int(f.type))
            if fk == .fn_ or fk == .cfn or fk == .ptr: continue        # (left as they are)
            fname = name_of(int(f.name))
            rd = rcall("__read", rn, [bc_field(bc_ident(xn, pos), fname, pos)], pos)
            # (the field's name kept while it is read: errors say where they are)
            body = [rd, rcall("__tx_at", rn, [bc_str(fname, pos)], pos)]
            if dewy and int(f.defval) == 0:
                required.insert(0, fi)
                body.push(bc_assign(bc_ident("__seen{fi}", pos), bc_bool(true, pos), pos))
            chain = bc_if(bc_call("__tx_name_is", [bc_ident(rn, pos), bc_str(fname, pos)], pos), body, [chain], pos)
        loop fi in required: st.push(bc_let("__seen{fi}", bc_bool(false, pos), pos))
        w = mk(.while_, pos)
        nodes[w].a = i32(bc_call("__tx_field", [bc_ident(rn, pos)], pos))
        nodes[w].b = i32(bc_block([chain], pos))
        st.push(w)
        loop fi in required:
            fname = name_of(int(fields[int(structs[si].fields) + fi].name))
            st.push(bc_if(bc_ident("__seen{fi}", pos), [], [rcall("__tx_missing", rn, [bc_str(fname, pos)], pos)], pos))
    else if k == .tuple:
        st.push(rcall("__tx_want", rn, [bc_int('(', pos)], pos))
        loop i in [0..int(types[t].nargs)):
            st.push(rcall("__tx_sep", rn, [bc_int(i, pos)], pos))
            el = mk(.field, pos)
            nodes[el].a = i32(bc_ident(xn, pos))
            nodes[el].aux = -2
            nodes[el].ival = i
            st.push(rcall("__read", rn, [el], pos))
        st.push(rcall("__tx_eat", rn, [bc_int(',', pos)], pos))
        st.push(rcall("__tx_want", rn, [bc_int(')', pos)], pos))
    else if k == .vec and t != T_MAT4:
        # vec2(1.5, 2.0)
        st.push(rcall("__tx_open", rn, [], pos))
        ct = T_F32
        if types[t].sign: ct = T_I32
        loop i in [0..int(types[t].bits)):
            st.push(rcall("__tx_sep", rn, [bc_int(i, pos)], pos))
            v = "__c{i}"
            st.push(bc_decl(v, ct, pos))
            st.push(rcall("__read", rn, [bc_ident(v, pos)], pos))
            st.push(bc_assign(bc_field(bc_ident(xn, pos), ["x", "y", "z", "w"][i], pos), bc_ident(v, pos), pos))
        st.push(rcall("__tx_eat", rn, [bc_int(',', pos)], pos))
        st.push(rcall("__tx_want", rn, [bc_int(')', pos)], pos))
    else if k == .fixed:
        st.push(rcall("__tx_want", rn, [bc_int('[', pos)], pos))
        el = mk(.index, pos)
        nodes[el].a = i32(bc_ident(xn, pos))
        nodes[el].b = i32(bc_ident("__i", pos))
        st.push(bc_loop("__i", bc_int(fixed_len(t), pos), [rcall("__tx_sep", rn, [bc_ident("__i", pos)], pos), rcall("__read", rn, [el], pos)], pos))
        st.push(rcall("__tx_eat", rn, [bc_int(',', pos)], pos))
        st.push(rcall("__tx_want", rn, [bc_int(']', pos)], pos))
    else if k == .enum_ and is_union(t):
        # the member's value as it is written: told apart by how it starts (a struct by its name)
        st.push(bc_let("__k", bc_call("__tx_kind", [bc_ident(rn, pos)], pos), pos))
        ms = union_members(t)
        has_int = false
        loop m in ms:
            if is_int(m): has_int = true
        chain = rcall("__tx_fail_found", rn, [bc_str("expected a {dt(t)}", pos)], pos)
        # (enums last: a bare name could be one of them, Name(...) a struct)
        loop pass_ in [0..2):
            i = ms.len() - 1
            loop i >= 0:
                m = prune(ms[i])
                i -= 1
                mk_ = types[m].kind
                if (mk_ == .enum_) != (pass_ == 0): continue
                c = 0
                if mk_ == .str_: c = kind_is(1, pos)
                else if is_int(m): c = kind_is(2, pos)
                else if is_float(m):
                    c = kind_is(3, pos)
                    if not has_int: c = bc_logic(.or_, c, kind_is(2, pos), pos)
                else if mk_ == .bool_: c = kind_is(5, pos)
                else if mk_ == .array or mk_ == .fixed: c = kind_is(8, pos)
                else if is_map_type(m): c = kind_is(9, pos)
                else if mk_ == .tuple: c = kind_is(10, pos)
                else if mk_ == .struct_ or mk_ == .vec:
                    nm = type_str(m)
                    if mk_ == .struct_: nm = structs[int(types[m].st)].name
                    c = bc_logic(.and_, kind_is(6, pos), bc_bin(.eq, bc_field(bc_ident(rn, pos), "name", pos), bc_str(nm, pos), pos), pos)
                else if mk_ == .enum_: c = bc_logic(.or_, kind_is(6, pos), kind_is(7, pos), pos)
                if c == 0: continue
                v = "__u{i + 1}"
                body = [bc_decl(v, m, pos), bc_stmt(bc_call("__default_init", [bc_ident(v, pos)], pos), pos), rcall("__read", rn, [bc_ident(v, pos)], pos), bc_assign(bc_ident(xn, pos), bc_ident(v, pos), pos)]
                chain = bc_if(c, body, [chain], pos)
        st.push(chain)
    else if k == .enum_:
        # a variant by name: hard, or rect(1.0, 2.0)
        si = int(types[t].st)
        check_struct_fields(si)
        st.push(bc_let("__wrapped", bc_call("__tx_enum_open", [bc_ident(rn, pos)], pos), pos))
        st.push(bc_let("__w", bc_call("__tx_word", [bc_ident(rn, pos), mk(.bool_lit, pos)], pos), pos))
        st.push(bc_if(bc_ident("__wrapped", pos), [rcall("__tx_want", rn, [bc_int(':', pos)], pos)], [], pos))
        vs = ""
        loop vi in [0..int(structs[si].nvariants)):
            if vi > 0: vs += ", "
            vs += name_of(int(variants[int(structs[si].variants) + vi].name))
        chain = rcall("__tx_bad", rn, [bc_str("expected a {dt(t)} ({vs})", pos)], pos)
        v = int(structs[si].nvariants) - 1
        loop v >= 0:
            vi = int(structs[si].variants) + v
            v -= 1
            vn = name_of(int(variants[vi].name))
            dn = mk(.dotname, pos)
            nodes[dn].name = variants[vi].name
            nf = int(variants[vi].nfields)
            body: int[]
            if nf == 0:
                body.push(bc_if(bc_ident("__wrapped", pos), [rcall("__tx_bad", rn, [bc_str("expected a variant name as a JSON string", pos)], pos)], [], pos))
                body.push(bc_assign(bc_ident(xn, pos), dn, pos))
            else:
                body.push(rcall("__tx_want", rn, [bc_int('(', pos)], pos))
                vargs: int[]
                loop j in [0..nf):
                    a = "__a{j}"
                    body.push(rcall("__tx_sep", rn, [bc_int(j, pos)], pos))
                    body.push(bc_decl(a, int(fields[int(variants[vi].fields) + j].type), pos))
                    body.push(bc_stmt(bc_call("__default_init", [bc_ident(a, pos)], pos), pos))
                    body.push(rcall("__read", rn, [bc_ident(a, pos)], pos))
                    vargs.push(bc_ident(a, pos))
                body.push(rcall("__tx_eat", rn, [bc_int(',', pos)], pos))
                body.push(rcall("__tx_want", rn, [bc_int(')', pos)], pos))
                c = mk(.call, pos)
                nodes[c].a = i32(dn)
                set_list(c, vargs)
                body.push(bc_assign(bc_ident(xn, pos), c, pos))
            chain = bc_if(bc_bin(.eq, bc_ident("__w", pos), bc_str(vn, pos), pos), body, [chain], pos)
        st.push(chain)
        st.push(bc_if(bc_ident("__wrapped", pos), [rcall("__tx_want", rn, [bc_int('}}', pos)], pos)], [], pos))
    else: fatal(pos, "a value of type {dt(t)} cannot be read from text")
    st

# f(r, args...) as a statement
rcall = (f: str, rn: str, args: int[], pos: int) -> int: bc_stmt(bc_call(f, [bc_ident(rn, pos)] + args, pos), pos)
bc_logic = (k: NK, a: int, b: int, pos: int) -> int:
    n = mk(k, pos)
    nodes[n].a = i32(a)
    nodes[n].b = i32(b)
    n
kind_is = (c: int, pos: int) -> int: bc_bin(.eq, bc_ident("__k", pos), bc_int(c, pos), pos)

# for an enum's missing variant: the one with the name other places use (Key.esc: escape), the
# nearest spelling, or (keys) how they are named
KEY_NAMES = ["esc", "escape", "return", "enter", "spacebar", "space", "del", "delete", "ins", "insert", "pgup", "page_up",
    "pageup", "page_up", "pgdn", "page_down", "pagedown", "page_down", "control", "ctrl", "lctrl", "ctrl", "rctrl", "ctrl",
    "left_ctrl", "ctrl", "right_ctrl", "ctrl", "lshift", "shift", "rshift", "shift", "left_shift", "shift", "right_shift", "shift",
    "lalt", "alt", "ralt", "alt", "option", "alt", "cmd", "super", "command", "super", "meta", "super", "win", "super", "windows", "super",
    "left_arrow", "left", "right_arrow", "right", "up_arrow", "up", "down_arrow", "down", "arrow_left", "left", "arrow_right", "right",
    "arrow_up", "up", "arrow_down", "down", "plus", "equals", "equal", "equals", "dash", "minus", "hyphen", "minus", "dot", "period",
    "apostrophe", "quote", "backquote", "grave", "backtick", "grave", "tilde", "grave", "open_bracket", "lbracket", "close_bracket", "rbracket",
    "zero", "n0", "one", "n1", "two", "n2", "three", "n3", "four", "n4", "five", "n5", "six", "n6", "seven", "n7", "eight", "n8", "nine", "n9",
    "numpad0", "kp0", "numpad1", "kp1", "numpad2", "kp2", "numpad3", "kp3", "numpad4", "kp4", "numpad5", "kp5", "numpad6", "kp6",
    "numpad7", "kp7", "numpad8", "kp8", "numpad9", "kp9", "keypad0", "kp0", "keypad1", "kp1", "keypad2", "kp2", "keypad3", "kp3",
    "keypad4", "kp4", "keypad5", "kp5", "keypad6", "kp6", "keypad7", "kp7", "keypad8", "kp8", "keypad9", "kp9", "kp_0", "kp0",
    "kp_1", "kp1", "kp_2", "kp2", "kp_3", "kp3", "kp_4", "kp4", "kp_5", "kp5", "kp_6", "kp6", "kp_7", "kp7", "kp_8", "kp8", "kp_9", "kp9",
    "kp_enter", "enter", "numpad_enter", "enter", "kp_add", "kp_plus", "kp_subtract", "kp_minus", "kp_multiply", "kp_star", "kp_divide", "kp_slash",
    "kp_decimal", "kp_period", "kp_dot", "kp_period"]

variant_hint_for = (t: int, name: str) -> str:
    tn = dt(prune(t))
    # (Unity's Input.GetKey and the like: functions here)
    if tn == "Input" and starts_with(name, "Get"):
        if name == "GetKey": return " (a key held is `key_down(.w)`)"
        if name == "GetKeyDown": return " (a key pressed this frame is `key_pressed(.space)`)"
        if name == "GetKeyUp": return " (a key let go this frame is `key_released(.space)`)"
        if name == "GetAxis" or name == "GetAxisRaw": return " (the arrows', WASD's and a stick's direction is `input_axis()`, a vec2)"
        if name == "GetMouseButton": return " (a mouse button held is `mouse_down(.left)`)"
        if name == "GetMouseButtonDown": return " (a mouse button pressed this frame is `mouse_pressed(.left)`)"
        return " (input is asked for with functions: `key_down(.w)`, `key_pressed(.space)`, `input_axis()`, `mouse_pos()`)"
    if tn == "Key":
        w = name
        # (num1, digit1, key_1: n1)
        loop pre in ["num", "digit", "key_", "kp"]:
            if starts_with(w, pre) and len(w) == len(pre) + 1 and is_digit(w[len(pre)]): return " (it is `.n{w[len(pre)..]}`)"
        i = 0
        loop i < KEY_NAMES.len():
            if KEY_NAMES[i] == w: return " (it is `.{KEY_NAMES[i + 1]}`)"
            i += 2
        sg = suggestion(name, variant_names(t))
        if len(sg) > 0: return sg
        return " (keys are named a to z, n0 to n9, f1 to f12, space, enter, escape, tab, backspace, left, right, up, down, shift, ctrl, alt...)"
    suggestion(name, variant_names(t))

# (`title` for `.title`: a variant of an enum, written without its dot; the program's enums first)
bare_variant_hint = (nm: int) -> str:
    found = ""
    loop m in modules:
        loop d in m.decls:
            if nodes[d].kind != .enum_: continue
            loop i in [0..nkids(d)):
                v = kid(d, i)
                if nodes[v].kind == .variant and int(nodes[v].name) == nm:
                    en = name_of(int(nodes[d].name))
                    h = " (a variant of {en}: `.{name_of(nm)}` where a {en} is expected, else `{en}.{name_of(nm)}`)"
                    if not m.is_prelude: return h
                    if len(found) == 0: found = h
    found

variant_names = (t: int) -> int[]:
    out: int[]
    si = int(types[prune(t)].st)
    check_struct_fields(si)
    loop vi in [0..int(structs[si].nvariants)): out.push(int(variants[int(structs[si].variants) + vi].name))
    out

# a == b, a < b with types that do not compare
cmp_error = (n: int, ta: int, tb: int):
    why = variant_hint(int(nodes[n].b), ta)
    a = int(nodes[n].a)
    if tkind(ta) == .bool_ and is_numeric(tb) and nodes[a].kind == .binary:
        aop = nodes[a].op as Tok
        if aop == .lt or aop == .le or aop == .gt or aop == .ge: why = if dewy_at(nodes[n].pos): " (`a <? x <? b` is written `a <? x and x <? b`, or `x in? [a..b]`)" else: " (`a < x < b` is written `a < x and x < b`, or `x in a..b`)"
    if len(why) == 0 and is_union(prune(ta)) and union_index(prune(ta), prune(tb)) >= 0:
        why = if dewy_at(nodes[n].pos): " (find out which it holds first: `x is? {dt(tb)} and x =? value`)" else: " (find out which it holds first: `x is {dt(tb)} and x == value`)"
    if len(why) == 0 and tkind(ta) == .opt and type_eq(prune(int(types[prune(ta)].elem)), prune(tb)):
        # (env("X") != "": the optional may be none)
        why = if dewy_at(nodes[n].pos): " (it may be none: `(x ?? default) =? value` compares its value, or a default when there is none; `if x isnt? none \{ }` narrows it)" else: " (it may be none: `(x ?? default) == value` compares its value, or a default when there is none; `if let v = x:` names the value)"
    if len(why) == 0 and ((type_eq(prune(ta), T_U8) and tkind(tb) == .str_) or (tkind(ta) == .str_ and type_eq(prune(tb), T_U8))):
        why = " (`s[i]` is a character's code, a number: the character as text is `s[i..i]`)"
    if len(why) == 0 and ((tkind(ta) == .str_ and is_numeric(tb)) or (is_numeric(ta) and tkind(tb) == .str_)):
        why = " (text is not a number, even with digits in it: `to_int(s) ?? 0` or `to_float(s) ?? 0.0` reads one, and `input_int(...)` asks for one)"
    # (n == 1 with n an enum: C's and JavaScript's numbered names)
    if len(why) == 0 and tkind(ta) == .enum_ and is_int(tb): why = if dewy_at(nodes[n].pos): " (`x =? .name` asks which it is)" else: " (`x == .name` asks which it is; `int(x)` is its number, counting from 0)"
    fatal(nodes[n].pos, "cannot compare {dt(ta)} with {dt(tb)}{why}")

# "space" given where a Key goes: " (write `.space`)"
variant_hint = (a: int, t0: int) -> str:
    t = prune(t0)
    if nodes[a].type != 0:
        # (a color is a vec4; light and sky colors are vec3s)
        ft = prune(int(nodes[a].type))
        c = "c"
        if nodes[a].kind == .ident: c = name_of(int(nodes[a].name))
        if type_eq(ft, T_VEC4) and type_eq(t, T_VEC3): return " (`{c}.rgb` is a color without its alpha)"
        if type_eq(t, T_VEC2) and (nodes[a].kind == .int_lit or nodes[a].kind == .float_lit): return " (a position or size is one vec2: `vec2(x, y)`)"
        # (load_texture("hero.png"): a file's bytes, not its name)
        if types[t].kind == .array and prune(int(types[t].elem)) == T_U8 and types[ft].kind == .str_:
            if nodes[a].kind == .str_lit and nodes[a].aux == 0:
                f = name_of(int(nodes[a].sval))
                return " (a file's bytes: `embed(\"{f}\")` builds the file into the program, `read_bytes(\"{f}\")!` reads it when the program runs; the `!` stops the program if the file is not there)"
            return " (`bytes(s)` is a string's bytes; `embed(\"file\")` a file's)"
        # (chime = sfx_chime, then play(chime): the function kept, not what it makes)
        if types[ft].kind == .fn_ and int(types[ft].nargs) == 0 and type_eq(prune(int(types[ft].elem)), t) and nodes[a].kind == .ident:
            vn = name_of(int(nodes[a].name))
            return " ('{vn}' holds a function that makes {a_type(t)}, not {a_type(t)}: where it is given its value, call the function, `{vn} = ...()`)"
        # (circle(p, 8, (1, 0.9, 0.5)): a tuple of numbers for a color or a position)
        if types[ft].kind == .tuple and is_vec(t):
            if type_eq(t, T_VEC4) or type_eq(t, T_VEC3): return " (a color is `rgb(1, 0.9, 0.5)`, a position `vec3(x, y, z)`)"
            return " (a position or size is `vec2(x, y)`)"
        # (circle(p, 8, "yellow"): a color is made of numbers)
        if type_eq(t, T_VEC4) and types[ft].kind == .str_:
            if nodes[a].kind == .str_lit and nodes[a].aux == 0:
                cn = upper(name_of(int(nodes[a].sval)))
                if cn == "GREY": cn = "GRAY"
                loop known in ["WHITE", "BLACK", "RED", "GREEN", "BLUE", "YELLOW", "ORANGE", "PURPLE", "CYAN", "MAGENTA", "GRAY"]:
                    if cn == known: return " (a color is made of numbers: `{cn}`, or `rgb(r, g, b)` with each from 0 to 1)"
                if len(cn) > 0 and cn[0] == '#': return " (a color is made of numbers: `hex(\"{name_of(int(nodes[a].sval))}\")`, or `rgb(r, g, b)` with each from 0 to 1)"
            return " (a color is made of numbers: `rgb(r, g, b)` with each from 0 to 1, or a named one such as `YELLOW`)"
        # (sprite(img, ...) with an Image: drawing takes it on the GPU)
        if dt(t) == "Texture" and dt(ft) == "Image": return " (a Texture is an image on the GPU: `texture(img)` makes one, once, at the top level; `load_texture(embed(\"hero.png\"))` loads one from a file)"
        if types[ft].kind == .typeval and types[t].kind == .fn_ and nodes[a].kind == .ident:
            c2 = name_of(int(nodes[a].name))
            return " (`{c2}` is a type; for a function that converts each one, write `(x): {c2}(x)`)"
        if type_eq(ft, T_VEC3) and type_eq(t, T_VEC4): return " (`vec4({c}, 1)` is a vec3 color with its alpha)"
    if types[t].kind != .enum_ or nodes[a].kind != .str_lit or nodes[a].nlist > 0: return ""
    w = name_of(int(nodes[a].sval))
    si = int(types[t].st)
    check_struct_fields(si)
    loop vi in [0..int(structs[si].nvariants)):
        vn = name_of(int(variants[int(structs[si].variants) + vi].name))
        if vn == w or vn == lower(w): return " (write `.{vn}`)"
    ""

# a call of a function that calls itself, taken to give nothing (it has no `return value`):
# what to write instead
# best > 3.0 with best: f64?: said with where best was made, where a default goes
opt_cmp_error = (n: int, a: int, b: int, ta: int, tb: int):
    x = a
    tx = ta
    if tkind(ta) != .opt:
        x = b
        tx = tb
    if tkind(tx) == .opt and nodes[x].kind == .ident:
        nm = name_of(int(nodes[x].name))
        et = prune(int(types[prune(tx)].elem))
        dv = "default"
        if tkind(et) == .str_: dv = "\"\""
        else if tkind(et) == .int_: dv = "0"
        else if tkind(et) == .float_: dv = "0.0"
        at = 0
        s = lookup(int(nodes[x].name))
        if s != 0 and syms[s].kind == .local: at = locals[int(syms[s].ref)].pos
        if s != 0 and syms[s].kind == .global: at = nodes[int(globals[int(syms[s].ref)].decl)].pos
        where = ""
        if at > 0:
            ln, c = line_col(at)
            where = " where line {ln} makes it"
        fatal(nodes[n].pos, "'{nm}' may be none (it is {a_type(tx)}), so it cannot be compared with {jd(nodes[n].pos, "<, >", "<?, >?")}: say what to use then{where} (`... ?? {dv}`), or {jd(nodes[n].pos, "`if let v = {nm}: ...`", "`if {nm} isnt? none \{ ... }`")}")
    fatal(nodes[n].pos, "optionals can only be compared with {op_text(.eq, nodes[n].pos)} and {op_text(.ne, nodes[n].pos)}")

# (play(sfx_chime), input_axis * 400: a function's name where its result was meant)
uncalled_hint = (n: int, want: int) -> str:
    if want != 0 and (tkind(want) == .fn_ or tkind(want) == .cfn): return ""
    nm = ""
    d = 0
    if nodes[n].kind == .fnref and nodes[n].sym > 0 and int(nodes[n].sym) < fns.len() and fns[int(nodes[n].sym)].decl != 0:
        d = int(fns[int(nodes[n].sym)].decl)
        nm = name_of(int(nodes[d].name))
    else if nodes[n].kind == .ident:
        s = lookup(int(nodes[n].name))
        if s != 0 and syms[s].kind == .fns:
            nm = name_of(int(nodes[n].name))
            d = int(syms[s].decl)
    if len(nm) == 0 or starts_with(nm, "__"): return ""
    # (key_down(right): the key, Key.right, written without its dot)
    if want != 0 and tkind(want) == .enum_:
        loop v in variant_names(want):
            if name_of(v) == nm: return " (a {dt(want)} is written with a dot: `.{nm}`)"
    args = ""
    if d != 0 and nkids(d) > 0: args = "..."
    " ('{nm}' is a function and is not called here: `{nm}({args})` calls it)"

void_rec_hint = (n: int) -> str:
    if nodes[n].kind != .call or nodes[n].sym <= 0: return ""
    f = int(nodes[n].sym)
    if f >= fns.len() or not fns[f].aux_void or fns[f].decl == 0: return ""
    nm = name_of(int(nodes[int(fns[f].decl)].name))
    " ('{nm}' calls itself, directly or through another function, with no branch that gives its result's type: write it, {jd(nodes[n].pos, "`{nm} = (...) -> int: ...`", "`{nm} = (...):>int64 => ...`")})"

# the functions that may be called with a dot on a value of type t (for messages)
# Whether `x.name` alone can call a function of x: an array or text builtin
# that takes nothing else, or a visible function whose other parameters all
# have defaults.
member_call_without_arguments = (t: int, name: int) -> bool:
    tk = types[t].kind
    ii = intrinsic_of(name)
    if ii >= 0 and intrinsics[ii].arr and (tk == .array or tk == .str_):
        id = intrinsics[ii].id
        return id == .len or id == .arrcap or id == .pop or id == .clear or id == .arrdata
    tables = [modules[cur_mod()].names, prelude]
    tm = module_of_type(t)
    if tm >= 0 and tm != cur_mod(): tables.push(modules[tm].names)
    loop table in tables:
        if not table.has(name): continue
        s = table[name]
        loop s != 0:
            if syms[s].kind == .fns and syms[s].decl != 0:
                d = int(syms[s].decl)
                required = 0
                loop i in [0..nkids(d)):
                    if nodes[kid(d, i)].b == 0: required += 1
                if nkids(d) >= 1 and required <= 1: return true
            s = int(syms[s].next)
    ii >= 0 and not intrinsics[ii].arr

# A short spelling of a receiver for a suggested call.
receiver_text = (n: int) -> str:
    if nodes[n].kind == .ident: return name_of(int(nodes[n].name))
    "x"

fn_names_for = (t: int) -> int[]:
    out = method_names(t)
    tk = types[t].kind
    loop it in intrinsics:
        if it.arr == (tk == .array or tk == .str_): out.push(intern(it.name))
    out

check_expr_in_module = (n: int, m: int, expected: int = 0) -> int:
    saved = cx
    ctxs.push(FnCtx(ctxs[cx].inst, i32(cx), ctxs[cx].ret, false, 0, i32(m), i32(sc_names.len())))
    cx = ctxs.len() - 1
    t = check_expr(n, expected)
    ctxs.pop()
    cx = saved
    t

id_len = 0

# A declared member wins over the synthesized value operation, including on
# an alternative of a union. Leave those unions to ordinary member forwarding.
copy_member = (t0: int, name: int) -> bool:
    t = prune(t0)
    if is_union(t):
        loop m in union_members(t):
            if copy_member(m, name): return true
    else if tkind(t) == .opt: return copy_member(telem(t), name)
    else if tkind(t) == .struct_:
        si = int(types[t].st)
        check_struct_fields(si)
        loop i in [0..int(structs[si].nfields)):
            if fields[int(structs[si].fields) + i].name == i32(name): return true
    false

synthetic_copy = (t: int, name: int, pos: int) -> bool:
    if name_of(name) != "copy" or not files[pos_file(pos)].is_dewy: return false
    k = tkind(t)
    if k == .module or k == .typeval or k == .void_ or t == T_NEVER: return false
    if copy_member(t, name): return false
    # Uniform-call methods are user declarations too.
    decls: int[]
    collect_fns(name, decls)
    m = module_of_type(t)
    if m >= 0: collect_module(m, name, decls)
    loop d in decls:
        if nkids(d) == 0: continue
        sig = fn_sig(d)
        binds = fill(0, int(sig.ntp))
        if match_type(sig.params[0], t, binds, 0) >= 0: return false
    true

check_copy = (n: int, receiver: int, t: int) -> int:
    nodes[n] = Node(kind = .conv, pos = nodes[n].pos, a = i32(receiver), aux = i32(int(CV.explicit_copy)), type = i32(t), flags = i32(NF_CHECKED))
    last_checked = n
    t

id_at = 0
# The library's names for Dewy's members: `xs.pop(i)` removes by position,
# `xs.insert(value i)` names the value first, `text.startswith(p)`. The
# library's own spellings are not Dewy's.
dewy_member_name = (callee: int, rt: int, fname: int, args: int[]) -> int:
    name = name_of(fname)
    k = types[rt].kind
    pos = nodes[callee].pos
    recv = receiver_text(int(nodes[callee].a))
    if name == "add" and is_dewy_set_type(rt): fatal(pos, "sets insert with push: replace `{recv}.add(value)` with `{recv}.push(value)`")
    if k == .array:
        if name == "pop" and args.len() == 1: return intern("remove")
        if name == "insert": return intern("__dewy_insert")
        if name == "remove": fatal(pos, "an array removes by position with pop: `{recv}.pop(i)`")
    if k == .str_:
        if name == "startswith": return intern("starts_with")
        if name == "endswith": return intern("ends_with")
        if name == "starts_with" or name == "ends_with": fatal(pos, "write `{recv}.{replace(name, "_", "")}(...)`")
    fname

# A record literal's method: a closure stored in the object, taking the object first.
# (a record literal's method is kept in the object, but it is not one of its fields:
# formatting leaves it out)
dewy_method_field = (t0: int) -> int:
    t = prune(t0)
    if tkind(t) != .polyfn: return 0
    d = poly_families[int(types[t].st)].decl
    if dewy_is_method(d): d else: 0

# The receiver route is evaluated again to pass the object: variables, fields, and
# elements at a variable or constant index.
dewy_plain_route = (n: int) -> bool:
    k = nodes[n].kind
    if k == .ident: return true
    if k == .index and nkids(n) == 1:
        let i = kid(n, 0)
        loop nodes[i].kind == .conv: i = int(nodes[i].a)
        return (nodes[i].kind == .ident or nodes[i].kind == .int_lit) and dewy_plain_route(int(nodes[n].a))
    k == .field and nodes[n].b == 0 and dewy_plain_route(int(nodes[n].a))

dewy_literal_method_name = 0
# `object.method(args)`: the method field's closure, given the object first (as a
# place when the method changes it). A temporary object is named first.
dewy_method_call = (n: int, callee: int, method: int, args: int[], expected: int) -> int:
    recv = int(nodes[callee].a)
    name = name_of(int(nodes[callee].name))
    changes = has_flag(kid(method, 0), NF_MUT)
    if not dewy_plain_route(recv):
        if changes: fatal(nodes[n].pos, "'{name}' changes its object, so it is called on a variable or a field, not on a temporary value")
        pos = nodes[n].pos
        temp = "$object{n}"
        object = bc_ident(temp, pos)
        nodes[callee].a = i32(object)
        call = mk(.call, pos)
        nodes[call].a = i32(callee)
        set_list(call, args)
        nodes[n] = nodes[bc_block([bc_let(temp, recv, pos), bc_stmt(call, pos)], pos)]
        return check_expr(n, expected)
    receiver = clone(recv)
    nodes[receiver].pos = nodes[n].pos
    if changes: add_flag(receiver, NF_MUT)
    callee_at = callee
    check_expr(callee, 0)
    saved = dewy_literal_method_name
    dewy_literal_method_name = int(nodes[callee].name)
    t = value_call(n, callee, [receiver] + args, expected)
    dewy_literal_method_name = saved
    t

# `Type.method(args)`: a static method, given a placeholder for the object it does
# not reach (its zero value, never read).
dewy_static_call = (n: int, t: int, j: int, args: int[], expected: int) -> int:
    decl = dewy_methods[j].decl
    name = int(nodes[decl].name)
    if dewy_methods[j].reads: fatal(nodes[n].pos, "'{name_of(name)}' reaches the members of a {dt(t)}, so it is called on a value of it, not on the type")
    si = int(types[t].st)
    check_struct_fields(si)
    placeholder = mk(.call, nodes[n].pos)
    nodes[placeholder].aux = 2
    nodes[placeholder].type = i32(t)
    set_list(placeholder, fill(0, int(structs[si].nfields)))
    add_flag(placeholder, NF_CHECKED)
    resolve_fn_call(n, name, [decl], [placeholder] + args, expected)

is_unchecked_at = (n: int) -> bool:
    callee = int(nodes[n].a)
    if nodes[callee].kind != .ident or nkids(n) != 2: return false
    if id_at == 0: id_at = intern("__at")
    int(nodes[callee].name) == id_at and modules[cur_mod()].is_prelude

check_call = (n: int, expected: int) -> int:
    if reflect_fields(n): fatal(nodes[n].pos, "fields(T) is a compile-time sequence; iterate over it with `loop field in fields(T)`")
    callee = int(nodes[n].a)
    if nodes[callee].kind == .field:
        if nodes[callee].b != 0: reflect_name(callee)
        if reflect_active: reflect_member(callee)
    args = kids(n)
    ck = nodes[callee].kind
    if ck == .typeapply:
        base = int(nodes[callee].a)
        name = int(nodes[base].name)
        # `rational<int64>(value)`: the explicit narrowing, with Overflow in its result
        if nodes[base].kind == .ident and name_of(name) == "rational" and lookup(name) == 0 and dewy_at(nodes[n].pos):
            if bundled_word_rational_type(resolve_type(int(nodes[callee].c))):
                pos = nodes[n].pos
                nodes[n].a = i32(bc_field(bc_ident("$dewy_rational", pos), "_word_rational", pos))
                return check_expr(n, expected)
        s = 0
        mod = -1
        if nodes[base].kind == .ident: s = lookup(name)
        else if nodes[base].kind == .field:
            mt = prune(check_expr(int(nodes[base].a), 0))
            if types[mt].kind == .module:
                mod = int(types[mt].mod)
                s = module_lookup(mod, name)
        if s != 0 and syms[s].kind == .fns:
            targs: int[]
            loop arg in kids(callee): targs.push(effect_generic_argument(arg))
            saved = call_targs
            call_targs = targs
            nodes[n].a = i32(base)
            r = call_by_name(n, name, mod, args, expected, false)
            call_targs = saved
            return r
        if (s != 0 and (syms[s].kind == .local or syms[s].kind == .global)) or (nodes[base].kind != .ident and mod < 0):
            callee_at = base
            check_expr(base, 0)
            if tkind(ntype(base)) == .polyfn:
                explicit: int[]
                loop arg in kids(callee): explicit.push(effect_generic_argument(arg))
                saved = call_targs
                call_targs = explicit
                r = value_call(n, base, args, expected)
                call_targs = saved
                return r
        t = prune(resolve_type(int(nodes[callee].c)))
        if types[t].kind != .struct_: fatal(nodes[callee].pos, "this type does not have a record constructor")
        return struct_ctor(n, t, int(structs[int(types[t].st)].decl), args, expected)
    if ck == .ident:
        if id_len == 0: id_len = intern("len")
        if args.len() == 1 and int(nodes[callee].name) == id_len:
            # len(ps) for a soa array
            at = prune(check_expr(args[0], 0))
            args[0] = last_checked
            set_kid(n, 0, args[0])
            if is_soa(at): return check_soa_method(n, args[0], int(nodes[callee].name), [], expected)
        if not pos_in_lib(nodes[n].pos): habit_call_check(n, int(nodes[callee].name), args)
        return call_by_name(n, int(nodes[callee].name), -1, args, expected, false)
    if ck == .dotname:
        if ide_sentinel != 0 and int(nodes[callee].name) == ide_sentinel: ide_complete_variants(expected)
        et = prune(expected)
        if expected != 0 and types[et].kind == .opt: et = prune(int(types[et].elem))
        if expected != 0: et = variant_enum(et, int(nodes[callee].name))
        if expected == 0 or types[et].kind != .enum_: fatal(nodes[callee].pos, "cannot infer the enum type for '.{name_of(int(nodes[callee].name))}'")
        vi = find_variant(int(types[et].st), int(nodes[callee].name))
        if vi < 0: fatal(nodes[callee].pos, "{dt(et)} has no variant '{name_of(int(nodes[callee].name))}'{variant_hint_for(et, name_of(int(nodes[callee].name)))}")
        if ide_on: ide_variant_ref(nodes[callee].pos, int(nodes[callee].name), et, vi)
        return variant_ctor(n, et, vi, args)
    if ck == .field:
        recv = int(nodes[callee].a)
        rt = prune(check_expr(recv, 0))
        recv = last_checked
        nodes[callee].a = i32(recv)
        fname = int(nodes[callee].name)
        if synthetic_copy(rt, fname, nodes[n].pos):
            nargs_check(n, args.len(), 0, 0, ".copy")
            return check_copy(n, recv, rt)
        if ide_sentinel != 0 and fname == ide_sentinel: ide_complete_members(rt)
        rk = types[rt].kind
        if rk == .module: return call_by_name(n, fname, int(types[rt].mod), args, expected, false)
        if rk == .typeval:
            tt = prune(int(types[rt].elem))
            if tt != 0 and types[tt].kind == .enum_:
                vi = find_variant(int(types[tt].st), fname)
                if vi < 0: fatal(nodes[callee].pos, "{dt(tt)} has no variant '{name_of(fname)}'{variant_hint_for(tt, name_of(fname))}")
                if ide_on: ide_variant_ref(nodes[callee].pos, fname, tt, vi)
                return variant_ctor(n, tt, vi, args)
            if tt != 0 and types[tt].kind == .struct_:
                j = dewy_type_method(int(structs[int(types[tt].st)].decl), fname)
                if j >= 0: return dewy_static_call(n, tt, j, args, expected)
            why = ""
            fd: int[]
            collect_fns(fname, fd)
            if fd.len() > 0:
                why = " (functions are not kept in types: call it as `{name_of(fname)}(x)` or `x.{name_of(fname)}()`)"
                # (Date.now(): a function of nothing is called by itself)
                loop d in fd:
                    if nkids(d) == 0: why = " (functions are not kept in types: call it by itself, `{name_of(fname)}()`)"
                if name_of(fname) == "now" and dt(tt) == "Date": why = " (`unix_time()` is the seconds since 1970, a moment to save and compare; `now()` gives today's Date; `time()` the seconds the program has run, for timing)"
            fatal(nodes[callee].pos, "type {dt(tt)} has no member '{name_of(fname)}'{why}")
        if is_soa(rt): return check_soa_method(n, recv, fname, args, expected)
        st = rt
        if rk == .ptr: st = prune(int(types[rt].elem))
        if types[st].kind == .struct_:
            si = int(types[st].st)
            check_struct_fields(si)
            loop i in [0..int(structs[si].nfields)):
                fi = int(structs[si].fields) + i
                if int(fields[fi].name) == fname and (tkind(int(fields[fi].type)) == .fn_ or tkind(int(fields[fi].type)) == .cfn or tkind(int(fields[fi].type)) == .polyfn or tkind(int(fields[fi].type)) == .callable):
                    if ide_on: ide_field_ref(nodes[callee].pos, fname, int(structs[si].decl), i, int(fields[fi].type))
                    method = dewy_method_field(int(fields[fi].type))
                    if method != 0: return dewy_method_call(n, callee, method, args, expected)
                    callee_at = callee
                    check_expr(callee, 0)
                    return value_call(n, callee, args, expected)
        if files[pos_file(nodes[n].pos)].is_dewy: fname = dewy_member_name(callee, rt, fname, args)
        # uniform call syntax
        add_flag(recv, NF_CHECKED)
        nl = [recv]
        loop a in args: nl.push(a)
        set_list(n, nl)
        return call_by_name(n, fname, -1, nl, expected, true)
    if ck == .index and nodes[int(nodes[callee].a)].kind == .ident:
        s = lookup(int(nodes[int(nodes[callee].a)].name))
        if s != 0 and syms[s].kind == .struct_:
            t = expr_as_type(callee)
            return struct_ctor(n, t, int(syms[s].ref), args, expected)
        if s != 0 and syms[s].kind == .fns:
            # f[T](args): a generic function with its type arguments given
            targs: int[]
            if nodes[callee].b != 0: targs.push(expr_as_type(int(nodes[callee].b)))
            else:
                loop i in [0..nkids(callee)): targs.push(expr_as_type(kid(callee, i)))
            saved = call_targs
            call_targs = targs
            r = call_by_name(n, int(nodes[int(nodes[callee].a)].name), -1, args, expected, false)
            call_targs = saved
            return r
    callee_at = callee
    check_expr(callee, 0)
    value_call(n, callee, args, expected)

resolve_by_types = (name: int, ts: int[], pos: int, required: bool) -> int:
    decls: int[]
    collect_fns(name, decls)
    collect_in(prelude, name, decls)
    if ts.len() > 0:
        tm = module_of_type(ts[ts.len() - 1])
        if tm >= 0: collect_module(tm, name, decls)
    resolve_from_types(name, decls, ts, pos, required)

resolve_from_types = (name: int, decls: int[], ts: int[], pos: int, required: bool) -> int:
    best = -1
    bestcost = 1 << 30
    bestb: int[]
    bestgen = false
    loop k in 0.. and d in decls:
        sig = fn_sig(d)
        if nkids(d) != ts.len(): continue
        binds = fill(0, int(sig.ntp))
        cost = 0
        ok = true
        loop i in [0..ts.len()):
            r = match_type(sig.params[i], ts[i], binds, 0)
            if r < 0 or (int(sig.mutmask) & (1 << i) != 0 and r == 1):
                ok = false
                break
            cost += r
        if not ok: continue
        # (a tie: the one without type parameters, as __fmt(m: f64[,]) over __fmt[T](m: T[,]))
        if cost < bestcost or (cost == bestcost and sig.ntp == 0 and bestgen):
            best = k
            bestcost = cost
            bestb = binds
            bestgen = sig.ntp > 0
    if best < 0:
        if not required: return 0
        last = "()"
        if ts.len() > 0: last = dt(ts[ts.len() - 1])
        fatal(pos, "no function '{name_of(name)}' accepting {last}")
    get_fn_inst(decls[best], bestb, pos)

# ---------------- intrinsics ----------------
arg_type = (args: int[], i: int, expected: int) -> int:
    a = args[i]
    if nodes[a].kind == .namedarg: fatal(nodes[a].pos, "named arguments are not supported here")
    if not has_flag(a, NF_CHECKED) or nodes[a].type == 0:
        check_expr(a, expected)
        add_flag(a, NF_CHECKED)
    if expected != 0: coerce(a, expected)
    prune(ntype(a))

nargs_check = (n: int, nargs: int, lo: int, hi: int, name: str):
    if nargs < lo or nargs > hi:
        if lo == hi: fatal(nodes[n].pos, "{name} expects {lo} argument(s), got {nargs}")
        fatal(nodes[n].pos, "{name} expects {lo} to {hi} arguments, got {nargs}")

fmt_part = (part: int, pos: int):
    t = prune(ntype(int(nodes[part].a)))
    if is_quantity(t):
        nodes[part].a = i32(quantity_number(int(nodes[part].a)))
        t = quantity_base(t)
    if types[t].kind == .fixed:
        # (shown like an array: [1, 2, 3])
        t = mk_array(int(types[t].elem))
        coerce(int(nodes[part].a), t)
    # (never: what does not come back, as panic(...), or a function skipped after its error)
    if t == T_NEVER:
        coerce(int(nodes[part].a), T_STR)
        t = T_STR
    if types[t].kind == .void_: fatal(nodes[int(nodes[part].a)].pos, "cannot format a value of type void{void_rec_hint(int(nodes[part].a))}")
    if types[t].kind == .typeval or types[t].kind == .module: fatal(nodes[int(nodes[part].a)].pos, "this is a type or module, not a value (a value of a type is made by calling it: `T()`)")
    if types[t].kind == .ptr or types[t].kind == .cfn: fatal(nodes[int(nodes[part].a)].pos, "a {dt(t)} is not printed: its address is `int(p as *u8)` (in hex, \"\{int(p as *u8):#x}\")")
    bt = mk_array(T_U8)
    if nodes[part].sval >= 0:
        # ({hits / shots:.1%} with whole numbers: the fraction is gone before it is shown)
        e = int(nodes[part].a)
        spec = name_of(int(nodes[part].sval))
        if is_int(t) and nodes[e].kind == .binary and nodes[e].op == i32(int(Tok.slash)) and len(spec) > 0 and (spec[len(spec) - 1] == '%' or spec[len(spec) - 1] == 'f' or find_byte(spec, '.') >= 0):
            warn(nodes[e].pos, "this divides whole numbers, dropping the fraction before it is formatted: `f64(a) / b` keeps it")
        nodes[part].sym = i32(resolve_by_types(intern("__fmt_spec"), [bt, t, T_STR], pos, true))
    else:
        writer = "__fmt"
        if dewy_at(pos): writer = "__dewy_fmt"
        nodes[part].sym = i32(resolve_by_types(intern(writer), [bt, t], pos, true))

is_dewy_grapheme_iter = (t: int) -> bool:
    p = prune(t)
    types[p].kind == .struct_ and structs[int(types[p].st)].name == "__DewyGraphemeIter"

is_dewy_range_type = (t: int, name: str) -> bool:
    p = prune(t)
    if types[p].kind != .struct_: return false
    st = int(types[p].st)
    if structs[st].name != name: return false
    d = int(structs[st].decl)
    d != 0 and files[pos_file(nodes[d].pos)].path == lib_dir + "/std/dewy_ranges.jo"

is_dewy_cursor_iter = (t: int) -> bool:
    is_dewy_grapheme_iter(t) or is_dewy_range_type(t, "__DewyRangeIter") or is_dewy_range_type(t, "__DewyOpenRangeIter")

is_dewy_set_type = (t: int) -> bool:
    p = prune(t)
    if types[p].kind != .struct_: return false
    st = int(types[p].st)
    if structs[st].name != "Set": return false
    d = int(structs[st].decl)
    d != 0 and files[pos_file(nodes[d].pos)].path == lib_dir + "/std/dewy_sets.jo"

is_value_collection_type = (t: int) -> bool:
    if is_dewy_set_type(t): return true
    p = prune(t)
    if types[p].kind != .struct_: return false
    st = int(types[p].st)
    if structs[st].name != "Map": return false
    d = int(structs[st].decl)
    d != 0 and files[pos_file(nodes[d].pos)].path == lib_dir + "/core/map.jo"

check_intrinsic = (n: int, id: IN, args: int[], expected: int) -> int:
    let args = args
    nodes[n].kind = .intrinsic
    nodes[n].aux = i32(int(id))
    set_list(n, args)
    nodes[n].a = 0
    nargs = args.len()
    r = T_VOID
    if id == .lend:
        nargs_check(n, nargs, 3, 3, "$lend")
        if has_flag(args[0], NF_MUT): add_flag(n, NF_MUT)
        if nodes[args[0]].kind == .addr:
            add_flag(n, NF_MUT)
            args[0] = int(nodes[args[0]].a)
            set_list(n, args)
        t = arg_type(args, 0, 0)
        if t != mk_array(T_U8): fatal(nodes[n].pos, "$lend needs a named array<uint8> owner")
        if nodes[args[0]].kind != .ident: fatal(nodes[n].pos, "$lend needs stable named storage")
        if has_flag(n, NF_MUT): check_place(args[0], false)
        arg_type(args, 1, T_INT)
        if not has_flag(n, NF_MUT) and (nodes[args[1]].kind != .int_lit or nodes[args[1]].ival != 0): fatal(nodes[n].pos, "reservation requires a writable loan")
        nodes[n].ival = locals.len()
        r = arg_type(args, 2, expected)
        loan_owners[if cx >= 0: int(ctxs[cx].inst) else: 0] = true
    else if id == .loan_address or id == .loan_load or id == .loan_store or id == .loan_length:
        nargs_check(n, nargs, (if id == .loan_store or id == .loan_length: 2 else: 1), (if id == .loan_store or id == .loan_length: 2 else: 1), "scoped byte operation")
        if id == .loan_address or id == .loan_length:
            if arg_type(args, 0, 0) != mk_array(T_U8): fatal(nodes[n].pos, "scoped byte operation needs array<uint8>")
        else: arg_type(args, 0, T_INT)
        if nargs == 2: arg_type(args, 1, T_INT)
        if id == .loan_address: r = T_INT
        if id == .loan_load: r = T_U8
        loan_owners[if cx >= 0: int(ctxs[cx].inst) else: 0] = true
    else if id == .dewy_set:
        nargs_check(n, nargs, 1, 1, "set literal")
        ex = prune(expected)
        if types[ex].kind == .opt: ex = prune(int(types[ex].elem))
        if is_union(ex):
            selected = 0
            loop member in union_members(ex):
                if is_dewy_set_type(member):
                    if selected != 0: selected = 0; break
                    selected = member
            if selected != 0: ex = selected
        if is_dewy_set_type(ex):
            check_to(args[0], mk_array(struct_targ(int(types[ex].st), 0)))
            add_flag(args[0], NF_CHECKED)
        else if nodes[args[0]].kind == .array and nkids(args[0]) == 0:
            fatal(nodes[n].pos, "cannot infer the type of an empty set; add a type annotation: `let values:set<int64>=set[]`")
        nodes[n] = nodes[bc_call("__dewy_make_set", args, nodes[n].pos)]
        return check_expr(n, expected)
    else if id == .dewy_iter:
        nargs_check(n, nargs, 1, 1, "__dewy_iter")
        t = arg_type(args, 0, 0)
        add_flag(args[0], NF_CHECKED)
        if tkind(t) == .str_:
            nodes[n] = nodes[bc_call("__dewy_grapheme_iter", args, nodes[n].pos)]
        else if is_dewy_range_type(t, "IntRange"):
            nodes[n] = nodes[bc_call("__dewy_range_iter", args, nodes[n].pos)]
        else if is_dewy_set_type(t):
            nodes[n] = nodes[bc_call("__dewy_set_values", args, nodes[n].pos)]
        else if is_map_type(t):
            # Combined loops index a retained dense entry list. Compact deleted
            # entries once, just as ordinary dictionary iteration does.
            nodes[n] = nodes[bc_call("__map_entries", args, nodes[n].pos)]
        else: nodes[n] = nodes[args[0]]
        return check_expr(n, expected)
    else if id == .dewy_iter_done or id == .dewy_iter_value or id == .dewy_iter_pair:
        nargs_check(n, nargs, 2, 2, "Dewy loop iterator")
        t = arg_type(args, 0, 0)
        add_flag(args[0], NF_CHECKED)
        pos = nodes[n].pos
        if is_dewy_cursor_iter(t):
            prefix = if is_dewy_grapheme_iter(t): "__dewy_grapheme" else if is_dewy_range_type(t, "__DewyOpenRangeIter"): "__dewy_open_range" else: "__dewy_range"
            name = prefix + "_done"
            if id != .dewy_iter_done:
                name = prefix + "_value"
                add_flag(args[0], NF_MUT)
            nodes[n] = nodes[bc_call(name, [args[0]], pos)]
        else if id == .dewy_iter_done:
            length = if tkind(t) == .struct_: bc_method(args[0], "len", [], pos) else: bc_call("len", [args[0]], pos)
            nodes[n] = nodes[bc_bin(.ge, args[1], length, pos)]
        else if (is_map_type(t) or is_map_entries_type(t)) and id == .dewy_iter_pair:
            nodes[n] = nodes[bc_call("__map_pair_at", args, pos)]
        else:
            ix = mk(.index, pos)
            nodes[ix].a = i32(if is_map_type(t) or is_map_entries_type(t): bc_field(args[0], "__keys", pos) else: args[0])
            nodes[ix].b = i32(args[1])
            nodes[n] = nodes[ix]
        return check_expr(n, expected)
    else if id == .len or id == .arrcap:
        nargs_check(n, nargs, 1, 1, "len")
        t = arg_type(args, 0, 0)
        if is_soa(t): return check_soa_method(n, args[0], intern("len"), [], expected)
        if id == .len and types[t].kind == .str_ and files[pos_file(nodes[n].pos)].is_dewy:
            add_flag(args[0], NF_CHECKED)
            nodes[n] = nodes[bc_call("__dewy_string_length", args, nodes[n].pos)]
            return check_expr(n, expected)
        if types[t].kind != .array and types[t].kind != .str_ and not (id == .len and types[t].kind == .fixed): fatal(nodes[n].pos, "len() expects an array or string, found {dt(t)}")
        r = T_INT
    else if id == .push:
        # (xs.push(1, 2, 3): JavaScript's push of several)
        if nargs > 2: fatal(nodes[n].pos, "push adds one value: for several, {jd(nodes[n].pos, "`xs.extend([1, 2, 3])`", "`xs.extend([1 2 3])`")}")
        nargs_check(n, nargs, 2, 2, "push")
        t = arg_type(args, 0, 0)
        if types[t].kind != .array: fatal(nodes[n].pos, "push() needs an array, found {dt(t)}")
        check_place(args[0], false)
        arg_type(args, 1, int(types[t].elem))
    else if id == .pop:
        nargs_check(n, nargs, 1, 1, "pop")
        t = arg_type(args, 0, 0)
        if types[t].kind != .array: fatal(nodes[n].pos, "pop() needs an array")
        check_place(args[0], false)
        r = int(types[t].elem)
    else if id == .insert:
        nargs_check(n, nargs, 3, 3, "insert")
        t = arg_type(args, 0, 0)
        if types[t].kind != .array: fatal(nodes[n].pos, "insert() needs an array")
        check_place(args[0], false)
        arg_type(args, 1, T_INT)
        arg_type(args, 2, int(types[t].elem))
    else if id == .remove:
        nargs_check(n, nargs, 2, 2, "remove")
        t = arg_type(args, 0, 0)
        if types[t].kind != .array: fatal(nodes[n].pos, "remove() needs an array")
        check_place(args[0], false)
        # (gems.remove(g): by value, as C#'s List.Remove; here by position)
        coerce_hint = if dewy_at(nodes[n].pos): " (remove takes a position. To take out things that are done: mark them in the loop (`a.gone = true`), then after it `xs.retain((a) => not a.gone)`; or `xs.retain((y) => y not=? x)` for what is equal to x)" else: " (remove takes a position. To take out things that are done, as Scratch's \"delete this clone\": mark them in the loop (`a.gone = true`), then after it `xs.retain((a): not a.gone)`; or `xs.retain((y): y != x)` for what is equal to x)"
        arg_type(args, 1, T_INT)
        coerce_hint = ""
        r = int(types[t].elem)
    else if id == .clear:
        nargs_check(n, nargs, 1, 1, "clear")
        t = arg_type(args, 0, 0)
        if types[t].kind != .array:
            if types[t].kind == .str_ or is_int(t): fatal(nodes[n].pos, "clear() of the screen takes a color: `clear(rgb(1, 0, 0))`, or from hex digits `clear(hex(\"#ff0000\"))`")
            fatal(nodes[n].pos, "clear() needs an array")
        check_place(args[0], false)
    else if id == .extend:
        nargs_check(n, nargs, 2, 2, "extend")
        t = arg_type(args, 0, 0)
        if types[t].kind != .array: fatal(nodes[n].pos, "extend() needs an array")
        check_place(args[0], false)
        source = args[1]
        if dewy_set_literal(source) and nodes[kid(source, 0)].kind == .array and nkids(kid(source, 0)) == 0:
            # Empty-set spreading contributes no elements or effects. Avoid
            # instantiating Set[T] before a later element can infer T.
            source = kid(source, 0)
        hint = t
        if dewy_set_literal(source):
            set_sym = prelude.get(intern("Set")) ?? 0
            if set_sym == 0: fatal(nodes[source].pos, "Set type is not available")
            hint = get_struct_inst(int(syms[set_sym].ref), [int(types[t].elem)])
        source_type = prune(check_expr(source, hint))
        source = last_checked
        add_flag(source, NF_CHECKED)
        if is_dewy_set_type(source_type): source = bc_call("__dewy_set_values", [source], nodes[source].pos)
        if types[source_type].kind == .fixed and has_var(int(types[t].elem)):
            unify(int(types[t].elem), int(types[source_type].elem))
        expanded = [args[0], source]
        arg_type(expanded, 1, t)
        set_list(n, expanded)
    else if id == .reserve or id == .resize or id == .truncate or id == .setlen:
        nargs_check(n, nargs, 2, 2, "reserve/resize/truncate")
        t = arg_type(args, 0, 0)
        if types[t].kind != .array: fatal(nodes[n].pos, "this operation needs an array")
        check_place(args[0], false)
        arg_type(args, 1, T_INT)
        if refine_active and (id == .resize or id == .setlen) and ref_storage_contract(int(types[t].elem)):
            fatal(nodes[n].pos, "refined elements cannot be created by unchecked zero initialization")
    else if id == .arrdata:
        nargs_check(n, nargs, 1, 1, "data")
        t = arg_type(args, 0, 0)
        if types[t].kind == .str_: r = T_RAWPTR
        else if types[t].kind == .array: r = mk_ptr(int(types[t].elem))
        else: fatal(nodes[n].pos, "data() needs an array or string")
        if refine_active and ref_storage_contract(t): fatal(nodes[n].pos, "mutable refinement access through raw data is not supported")
        note_storage_access(args[0])
    else if id == .syscall:
        if nargs < 1 or nargs > 7: fatal(nodes[n].pos, "syscall takes 1 to 7 arguments")
        loop i in [0..nargs):
            t = arg_type(args, i, 0)
            a = args[i]
            if is_lit(a): coerce(a, T_INT)
            else if types[t].kind == .ptr or types[t].kind == .null_:
                if types[t].kind == .null_: nodes[a].type = i32(T_RAWPTR)
            else if types[t].kind == .int_:
                if t != T_INT: coerce(a, T_INT)
            else if types[t].kind == .bool_: pass
            else: fatal(nodes[a].pos, "syscall arguments must be integers or pointers")
        r = T_INT
    else if id == .memcpy or id == .memset:
        nm = "mem_set"
        if id == .memcpy: nm = "mem_copy"
        nargs_check(n, nargs, 3, 3, nm)
        t0 = arg_type(args, 0, 0)
        if types[t0].kind != .ptr: fatal(nodes[args[0]].pos, "expected a pointer")
        if id == .memcpy:
            t1 = arg_type(args, 1, 0)
            if types[t1].kind != .ptr: fatal(nodes[args[1]].pos, "expected a pointer")
        else: arg_type(args, 1, T_INT)
        arg_type(args, 2, T_INT)
    else if id == .sizeof or id == .alignof:
        nargs_check(n, nargs, 1, 1, "size_of")
        t = expr_as_type(args[0])
        layout(t)
        v = tsize(t)
        if id == .alignof: v = talign(t)
        nodes[n] = Node(kind = .int_lit, pos = nodes[n].pos, ival = v, type = i32(T_INT), flags = i32(NF_LITERAL | NF_CHECKED))
        return T_INT
    else if id == .panic:
        nargs_check(n, nargs, 0, 1, "panic")
        if nargs > 0: arg_type(args, 0, T_STR)
        r = T_NEVER
    else if id == .unreachable: r = T_NEVER
    else if id == .assert or id == .runtime_assert:
        nargs_check(n, nargs, 1, 2, "assert")
        arg_type(args, 0, T_BOOL)
        if nargs == 2: arg_type(args, 1, T_STR)
        # A runtime assertion whose condition is known to fail is an error.
        if id == .runtime_assert and static_truth(args[0]) == 0: assertion_refuted(args[0], 0)
    else if id == .static_assert:
        nargs_check(n, nargs, 1, 2, "$assert")
        captures_before = if cx >= 0: fns[int(ctxs[cx].inst)].caps.len() else: 0
        arg_type(args, 0, T_BOOL)
        if nargs == 2: arg_type(args, 1, T_STR)
        # An erased read must not introduce an environment allocation. Existing
        # runtime/explicit captures are supported; proof-only captures await a
        # separate compile-time binding representation.
        if cx >= 0 and fns[int(ctxs[cx].inst)].caps.len() > captures_before and fact_open(args[0]):
            fatal(nodes[n].pos, "assertion unknown: erased operand would introduce a runtime capture; witness at {pos_str(nodes[args[0]].pos)}")
        fact_queue(n, args[0], if nargs == 2: args[1] else: 0)
    else if id == .print or id == .dewy_print:
        # (Dewy's print: no line break; its printl is the library's print)
        s = mk(.str_lit, nodes[n].pos)
        nodes[s].aux = 1
        parts: int[]
        loop i in 0.. and a in args:
            if nodes[a].kind == .namedarg: fatal(nodes[a].pos, "print() does not take named arguments (`write(s)` prints without a line break; print puts a space between its values)")
            if i > 0:
                sp = mk(.str_lit, nodes[n].pos)
                nodes[sp].sval = i32(intern(" "))
                parts.push(sp)
            part = mk(.pair, nodes[n].pos)
            nodes[part].a = i32(a)
            nodes[part].sval = -1
            parts.push(part)
        set_list(s, parts)
        if nargs == 1 and nodes[args[0]].kind == .str_lit and nodes[args[0]].aux == 0: s = args[0]
        check_expr(s, 0)
        nodes[n].kind = .call
        nodes[n].aux = 0
        set_list(n, [s])
        printer = "__print_str"
        if id == .dewy_print: printer = "write"
        nodes[n].sym = i32(runtime_fn(printer))
        nodes[n].type = i32(T_VOID)
        return T_VOID
    else if id == .embed:
        nargs_check(n, nargs, 1, 1, "embed")
        a = args[0]
        if nodes[a].kind != .str_lit or nodes[a].aux != 0: fatal(nodes[n].pos, "embed() needs a string literal path")
        rel = name_of(int(nodes[a].sval))
        path = rel
        if not is_abs_path(rel): path = "{files[pos_file(nodes[n].pos)].dir}/{rel}"
        path = ide_norm(path)
        if not embedded_files.contains(path): embedded_files.push(path)
        d = read_file(path)
        if d == none:
            # (Cat1.png for cat1.png: a file's name with its capitals another way)
            dir = path[..max(rfind(path, "/"), 0))
            base = path[max(rfind(path, "/"), -1) + 1..]
            if len(dir) > 0:
                loop f in list_dir(dir):
                    if lower(f) == lower(base) and f != base: fatal(nodes[n].pos, "embed: there is no '{base}' next to the program, but there is '{f}': file names care about capital letters")
            fatal(nodes[n].pos, "embed: cannot read '{path}'")
        nodes[n].sval = i32(intern(d!))
        r = mk_array(T_U8)
    else if id == .embed_dir:
        # embed_dir("assets"): {"a.png": embed("assets/a.png"), "sfx/hit.wav": ...}, every file under
        # it (sub-directories' with their path; hidden ones left out)
        nargs_check(n, nargs, 1, 1, "embed_dir")
        a = args[0]
        if nodes[a].kind != .str_lit or nodes[a].aux != 0: fatal(nodes[n].pos, "embed_dir() needs a string literal path")
        rel = name_of(int(nodes[a].sval))
        path = rel
        if not is_abs_path(rel): path = "{files[pos_file(nodes[n].pos)].dir}/{rel}"
        if not is_dir(path): fatal(nodes[n].pos, "embed_dir: '{path}' is not a directory")
        names: str[]
        embed_dir_walk(path, "", names)
        pos = nodes[n].pos
        pairs: int[]
        loop nm in names:
            pr = mk(.pair, pos)
            nodes[pr].a = i32(bc_str(nm, pos))
            nodes[pr].b = i32(bc_call("embed", [bc_str("{rel}/{nm}", pos)], pos))
            pairs.push(pr)
        if pairs.len() == 0: fatal(nodes[n].pos, "embed_dir: '{path}' has no files")
        m = mk(.map_lit, pos)
        set_list(m, pairs)
        nodes[n] = nodes[m]
        return check_expr(n, expected)
    else if id == .from_bytes:
        nargs_check(n, nargs, 1, 1, "str_from_bytes")
        arg_type(args, 0, mk_array(T_U8))
        nodes[n].kind = .call
        nodes[n].aux = 0
        nodes[n].sym = i32(runtime_fn("__str_from_bytes"))
        nodes[n].type = i32(T_STR)
        return T_STR
    else if id == .to_bytes:
        nargs_check(n, nargs, 1, 1, "bytes")
        arg_type(args, 0, T_STR)
        r = mk_array(T_U8)
    else if id == .argv: r = T_RAWPTR
    else if id == .sqrt:
        nargs_check(n, nargs, 1, 1, "sqrt")
        t = arg_type(args, 0, 0)
        if is_lit(args[0]) or types[t].kind == .int_ or bundled_rational_type(t):
            coerce(args[0], T_FLOAT)
            t = T_FLOAT
        if types[t].kind != .float_: fatal(nodes[n].pos, jd(nodes[n].pos, "sqrt() needs a float", "sqrt needs a float64 or float32 (found {dt(t)})"))
        r = t
    else if id == .json_fields:
        nargs_check(n, nargs, 4, 4, "__json_fields")
        # These calls are emitted by lowering, so check and finalize their
        # bodies now rather than instantiating new functions during emission.
        loop name in ["__json_key", "__json_sep", "__json_newline", "__json_write_str"]: runtime_fn(name)
        bt = mk_array(T_U8)
        arg_type(args, 0, bt)
        t = prune(arg_type(args, 1, 0))
        arg_type(args, 2, T_INT)
        arg_type(args, 3, T_INT)
        k = types[t].kind
        fts: int[]
        if k == .fixed: fts.push(int(types[t].elem))
        else if k == .struct_:
            si = int(types[t].st)
            check_struct_fields(si)
            loop i in [0..int(structs[si].nfields)): fts.push(int(fields[int(structs[si].fields) + i].type))
        else if k == .tuple:
            loop i in [0..int(types[t].nargs)): fts.push(targ(t, i))
        else if k == .enum_:
            si = int(types[t].st)
            check_struct_fields(si)
            loop v in [0..int(structs[si].nvariants)):
                vi = int(structs[si].variants) + v
                loop i in [0..int(variants[vi].nfields)): fts.push(int(fields[int(variants[vi].fields) + i].type))
        else if k == .vec:
            ct = if types[t].sign: T_I32 else: T_F32
            count = if t == T_MAT4: 16 else: int(types[t].bits)
            loop i in [0..count): fts.push(ct)
        else: fatal(nodes[n].pos, "a value of type {dt(t)} cannot be written as JSON")
        refs: int[]
        loop ft in fts:
            ref = mk(.fnref, nodes[n].pos)
            # Lowering passes the field's exact storage. Do not select an
            # array overload that expects an implicit fixed-to-dynamic copy.
            writer = if tkind(ft) == .fixed: "__json_write_fixed" else: "__json_write_value"
            nodes[ref].sym = i32(resolve_by_types(intern(writer), [bt, ft, T_INT, T_INT], nodes[n].pos, true))
            refs.push(ref)
        set_list2(n, refs)
    else if id == .fmt_struct:
        nargs_check(n, nargs, 2, 2, "__fmt_fields")
        arg_type(args, 0, 0)
        t = arg_type(args, 1, 0)
        if is_quantity(t):
            nodes[n] = nodes[bc_call("__fmt", [args[0], quantity_number(args[1])], nodes[n].pos)]
            return check_expr(n, 0)
        # (a type with the program's own `str = (b: Big) -> str`: shown as the text it gives,
        # and to_text, while it writes, as its fields: `if __text_exact: fields else: str(x)`)
        sf = 0
        if not fmt_plain.has(n) and int(nodes[n].aux2) & FMT_DEWY == 0: sf = program_str_fn(t, nodes[n].pos)
        if sf != 0:
            pos = nodes[n].pos
            plain = nodes.len()
            nodes.push(nodes[n])
            fmt_plain[plain] = true
            pt = check_intrinsic(plain, .fmt_struct, args, 0)
            if nodes[plain].type == 0: nodes[plain].type = i32(pt)
            add_flag(plain, NF_CHECKED)
            inner = mk(.call, pos)
            nodes[inner].a = i32(bc_ident("str", pos))
            set_list(inner, [args[1]])
            nodes[inner].sym = i32(sf)
            nodes[inner].type = i32(T_STR)
            add_flag(inner, NF_CHECKED)
            b0 = clone(args[0])
            clear_flag(b0, NF_CHECKED)
            shown = bc_call("__buf_append_str", [b0, inner], pos)
            iff = mk(.if_, pos)
            nodes[iff].a = i32(bc_ident("__text_exact", pos))
            nodes[iff].b = i32(bc_block([bc_stmt(plain, pos)], pos))
            nodes[iff].c = i32(bc_block([bc_stmt(shown, pos)], pos))
            nodes[n] = nodes[iff]
            return check_expr(n, 0)
        bt = mk_array(T_U8)
        fts: int[]
        k = types[t].kind
        if k == .struct_:
            si = int(types[t].st)
            check_struct_fields(si)
            loop i in fmt_field_order(si):
                ft = int(fields[int(structs[si].fields) + i].type)
                if not fmt_hidden(ft, nodes[n].aux2): fts.push(ft)
        else if k == .tuple:
            loop i in [0..int(types[t].nargs)): fts.push(targ(t, i))
        else if k == .enum_:
            si = int(types[t].st)
            check_struct_fields(si)
            loop v in [0..int(structs[si].nvariants)):
                vi = int(structs[si].variants) + v
                loop i in [0..int(variants[vi].nfields)): fts.push(int(fields[int(variants[vi].fields) + i].type))
        else if k == .fn_ or k == .vec: pass
        else: fatal(nodes[n].pos, "cannot format a value of type {dt(t)}")
        refs: int[]
        # (a union shows just its value: quoted inside a container, as a string would be)
        dewy = int(nodes[n].aux2) & FMT_DEWY != 0
        top = is_union(t) and int(nodes[n].aux2) & 1 == 0
        fname = intern("__fmt_elem")
        if top: fname = intern("__fmt")
        if dewy and top: fname = intern("__dewy_fmt")
        else if dewy: fname = intern("__dewy_fmt_elem")
        loop ft in fts:
            ref = mk(.fnref, nodes[n].pos)
            nodes[ref].sym = i32(resolve_by_types(fname, [bt, ft], nodes[n].pos, true))
            refs.push(ref)
        set_list2(n, refs)
    else if id == .hash:
        nargs_check(n, nargs, 1, 1, "__hash_value")
        note_value_helpers(arg_type(args, 0, 0), true)
        r = T_U64
    else if id == .shader:
        nargs_check(n, nargs, 2, 2, "shader")
        # (the fragment function first: a generic vertex function, as the library's effect_vs[U],
        # is made for its input and uniforms)
        loop i in [1, 0]:
            a = args[i]
            if nodes[a].kind != .ident: fatal(nodes[a].pos, "shader() takes the names of a vertex and a fragment function")
            want = 0
            if i == 0 and nodes[args[1]].kind == .fnref:
                ff = int(nodes[args[1]].sym)
                vd: int[]
                collect_fns(int(nodes[a].name), vd)
                if vd.len() == 1 and fn_sig(vd[0]).generic and nkids(vd[0]) == 2 and fns[ff].ptypes.len() == 2:
                    want = mk_fn([fn_sig(vd[0]).params[0], fns[ff].ptypes[1]], fns[ff].ptypes[0], 0)
            check_expr(a, want)
            if nodes[a].kind != .fnref: fatal(nodes[a].pos, "expected a function name")
            f = int(nodes[a].sym)
            np = fns[f].ptypes.len()
            if np != 2 and not (i == 0 and np == 3): fatal(nodes[a].pos, "shader functions take (input, uniforms); vertex functions may also take (input, instance, uniforms)")
        vsf = int(nodes[args[0]].sym)
        fsf = int(nodes[args[1]].sym)
        if not type_eq(int(fns[vsf].ret), fns[fsf].ptypes[0]): fatal(nodes[n].pos, "the fragment function's input must be the vertex function's output type")
        if not type_eq(fns[vsf].ptypes[fns[vsf].ptypes.len() - 1], fns[fsf].ptypes[1]): fatal(nodes[n].pos, "both shader functions must take the same uniforms type")
        if not type_eq(int(fns[fsf].ret), T_VEC4): fatal(nodes[n].pos, "the fragment function must return a vec4 color")
        # The shader intrinsic synthesizes this type without a source-level
        # reference, so it must demand the module just like an ordinary name.
        s = module_lookup(-1, intern("ShaderSource"))
        if s == 0: fatal(nodes[n].pos, "ShaderSource is not available")
        r = get_struct_inst(int(syms[s].ref), [])
    else if id == .setjmp:
        nargs_check(n, nargs, 1, 1, "__setjmp")
        arg_type(args, 0, T_RAWPTR)
        r = T_INT
    else if id == .longjmp:
        nargs_check(n, nargs, 2, 2, "__longjmp")
        arg_type(args, 0, T_RAWPTR)
        arg_type(args, 1, T_INT)
        r = T_NEVER
    else if id == .jump:
        nargs_check(n, nargs, 2, 2, "__jump")
        arg_type(args, 0, T_RAWPTR)
        arg_type(args, 1, T_RAWPTR)
        r = T_NEVER
    else if id == .clone_thread:
        nargs_check(n, nargs, 3, 3, "__clone_thread")
        arg_type(args, 0, T_RAWPTR)
        arg_type(args, 1, T_INT)
        arg_type(args, 2, T_RAWPTR)
        r = T_INT
    else if id == .atomic_add:
        nargs_check(n, nargs, 2, 2, "__atomic_add")
        arg_type(args, 0, mk_ptr(T_INT))
        arg_type(args, 1, T_INT)
        r = T_INT
    else if id == .atomic_cas:
        nargs_check(n, nargs, 3, 3, "__atomic_cas")
        arg_type(args, 0, mk_ptr(T_INT))
        arg_type(args, 1, T_INT)
        arg_type(args, 2, T_INT)
        r = T_INT
    else if id == .gpu_kernel:
        # __gpu_kernel(lambda, desc): the GLSL fragment program (see glsl_kernel)
        nargs_check(n, nargs, 2, 2, "__gpu_kernel")
        if nodes[args[0]].kind != .lambda or nodes[args[1]].kind != .str_lit: fatal(nodes[n].pos, "__gpu_kernel takes a function literal and a string")
        check_expr(args[0], 0)
        r = T_STR
    else if id == .compute:
        # compute(f): a GPU program run once per element, f(id: int, params: P) (lib/game/gpubuffer.jo),
        # or once per cell of a grid, f(id: ivec2 or ivec3, params: P); becomes
        # __compute(__compute_spirv(f), f) (__compute2 or __compute3 for a grid): the program for
        # Vulkan, and f itself for the CPU
        nargs_check(n, nargs, 1, 1, "compute")
        a = args[0]
        if nodes[a].kind != .ident: fatal(nodes[a].pos, "compute() takes the name of a function (id: int, params: P)")
        # (of the functions with that name, the one shaped like a compute function)
        want = 0
        decls: int[]
        collect_fns(int(nodes[a].name), decls)
        loop d in decls:
            sig = fn_sig(d)
            if not sig.generic and sig.params.len() == 2 and (prune(sig.params[0]) == T_INT or prune(sig.params[0]) == T_IVEC2 or prune(sig.params[0]) == T_IVEC3) and tkind(sig.params[1]) == .struct_ and tkind(int(sig.ret)) == .void_:
                want = mk_fn(sig.params, T_VOID, 0)
        check_expr(a, want)
        if nodes[a].kind != .fnref: fatal(nodes[a].pos, "expected a function name")
        f = int(nodes[a].sym)
        it0 = prune(fns[f].ptypes[0])
        if fns[f].ptypes.len() != 2 or (it0 != T_INT and it0 != T_IVEC2 and it0 != T_IVEC3) or tkind(fns[f].ptypes[1]) != .struct_:
            fatal(nodes[a].pos, "a compute function takes (id: int, params: P), P a struct (or id: ivec2 or ivec3, over a grid)")
        if tkind(int(fns[f].ret)) != .void_: fatal(nodes[a].pos, "a compute function returns nothing: it writes its results into GPU buffers")
        ref = mk(.fnref, nodes[a].pos)
        nodes[ref].sym = nodes[a].sym
        nodes[ref].type = nodes[a].type
        ref2 = mk(.fnref, nodes[a].pos)
        nodes[ref2].sym = nodes[a].sym
        nodes[ref2].type = nodes[a].type
        mkname = "__compute"
        if prune(fns[f].ptypes[0]) == T_IVEC2: mkname = "__compute2"
        if prune(fns[f].ptypes[0]) == T_IVEC3: mkname = "__compute3"
        call = bc_call(mkname, [bc_call("__compute_spirv", [ref], nodes[n].pos), bc_call("__compute_textures", [ref2], nodes[n].pos), a], nodes[n].pos)
        nodes[n] = nodes[call]
        return check_expr(n, expected)
    else if id == .compute_spirv or id == .compute_textures:
        nargs_check(n, nargs, 1, 1, "__compute_spirv")
        if nodes[args[0]].kind != .fnref: fatal(nodes[n].pos, "__compute_spirv takes a function")
        r = T_STR
    else if id == .default_init:
        # __default_init(x): a struct gets its fields' default values (anything else is zero already)
        nargs_check(n, nargs, 1, 1, "__default_init")
        t = prune(arg_type(args, 0, 0))
        pos = nodes[n].pos
        stmts: int[]
        if types[t].kind == .struct_ and not is_map_type(t):
            si = int(types[t].st)
            check_struct_fields(si)
            has_def = false
            loop i in [0..int(structs[si].nfields)):
                if fields[int(structs[si].fields) + i].defval != 0: has_def = true
            if has_def:
                d = mk(.call, pos)
                struct_ctor_zero(d, t, int(structs[si].decl))
                add_flag(d, NF_CHECKED)
                stmts.push(bc_assign(bc_ident(name_of(int(nodes[args[0]].name)), pos), d, pos))
        nodes[n] = nodes[bc_block(stmts, pos)]
        return check_expr(n, expected)
    else if id == .read_fields:
        # __read_fields(r, x): the code that reads a struct, tuple, enum, union, vector or fixed-size
        # array from text, field by field (lib/std/text.jo)
        nargs_check(n, nargs, 2, 2, "__read_fields")
        arg_type(args, 0, 0)
        t = prune(arg_type(args, 1, 0))
        pos = nodes[n].pos
        stmts = read_code(t, name_of(int(nodes[args[0]].name)), name_of(int(nodes[args[1]].name)), pos)
        nodes[n] = nodes[bc_block(stmts, pos)]
        return check_expr(n, expected)
    else if id == .fmt_elem:
        # __fmt_elem_value(buf, x): x inside a container (strings quoted): a union formats its
        # member that way; anything else is __fmt(buf, x)
        nargs_check(n, nargs, 2, 2, "__fmt_elem_value")
        t = arg_type(args, 1, 0)
        if is_union(t):
            nodes[n].aux = i32(int(IN.fmt_struct))
            nodes[n].aux2 = 1
            return check_intrinsic(n, .fmt_struct, args, expected)
        c = mk(.call, nodes[n].pos)
        callee = mk(.ident, nodes[n].pos)
        nodes[callee].name = i32(intern("__fmt"))
        nodes[c].a = i32(callee)
        set_list(c, args)
        nodes[n] = nodes[c]
        return check_expr(n, expected)
    else if id == .dewy_fmt or id == .dewy_fmt_elem:
        # __dewy_fmt_value(buf, x): Dewy's text for what the library's overloads leave: an
        # object through its `__as__` to string, or field by field as [x=1 name="q"]; a union
        # as its member; anything else (numbers, library types) as the library writes it
        elem = id == .dewy_fmt_elem
        nargs_check(n, nargs, 2, 2, "__dewy_fmt_value")
        arg_type(args, 0, 0)
        t = arg_type(args, 1, 0)
        pos = nodes[n].pos
        if is_quantity(t):
            nodes[n] = nodes[bc_call("__dewy_fmt", [args[0], quantity_number(args[1])], pos)]
            return check_expr(n, 0)
        bt = mk_array(T_U8)
        k = types[t].kind
        own = is_union(t) or k == .tuple
        if k == .struct_:
            conv = as_conversion(t, T_STR)
            if conv != 0:
                inner = mk(.call, pos)
                nodes[inner].a = i32(bc_ident("__as__", pos))
                set_list(inner, [args[1]])
                nodes[inner].type = i32(resolve_fn_call(inner, intern("__as__"), [conv], [args[1]], T_STR))
                add_flag(inner, NF_CHECKED)
                nodes[n] = nodes[bc_call("__buf_append_str", [args[0], inner], pos)]
                return check_expr(n, 0)
            # (a library type the library writes, as a BigInt: as it writes it)
            jo = resolve_by_types(intern("__fmt"), [bt, t], pos, false)
            own = jo == 0 or fmt_fallback(jo)
        if own:
            nodes[n].aux = i32(int(IN.fmt_struct))
            nodes[n].aux2 = i32(FMT_DEWY)
            if elem: nodes[n].aux2 = i32(FMT_DEWY | 1)
            return check_intrinsic(n, .fmt_struct, args, expected)
        # (inside a structure, a container as it is on its own: a call, which copies a
        # fixed-size array into the T[] the library's overload takes)
        writer = "__fmt"
        if elem: writer = "__dewy_fmt"
        c = bc_call(writer, args, pos)
        nodes[n] = nodes[c]
        return check_expr(n, expected)
    else if id == .fill:
        # fill(value, n): an array of n copies of value
        nargs_check(n, nargs, 2, 2, "fill")
        arr = mk(.array, nodes[n].pos)
        set_list(arr, [args[0]])
        nodes[arr].b = i32(args[1])
        nodes[n] = nodes[arr]
        return check_expr(n, expected)
    else if id == .cpu_features:
        # bit 0: AVX2 can be used (the processor has it and the system saves its registers)
        nargs_check(n, nargs, 0, 0, "__cpu_features")
        r = T_INT
    else if id == .code_sync:
        # machine code written at p (n bytes) made ready to run (arm64: through the caches)
        nargs_check(n, nargs, 2, 2, "__code_sync")
        arg_type(args, 0, T_RAWPTR)
        arg_type(args, 1, T_INT)
        r = T_INT
    else if id == .stack_ptr:
        nargs_check(n, nargs, 0, 0, "__stack_ptr")
        r = T_RAWPTR
    else if id == .callc:
        # __call_raw(f, args...): call the code at f the way Sloppy functions are called (the
        # software renderer's shader functions: the address of a function with pointer arguments)
        if nargs < 1: fatal(nodes[n].pos, "__call_raw takes a function's address and its arguments")
        loop i in [0..nargs): arg_type(args, i, T_RAWPTR)
        r = T_VOID
    else: fatal(nodes[n].pos, "unsupported intrinsic")
    nodes[n].type = i32(r)
    if refine_active: return ref_length_mutation(n, r)
    r

# ---------------- vectors ----------------
vec_n = (t: int) -> int: int(types[prune(t)].bits)
vec_comp_type = (t: int) -> int:
    if types[prune(t)].sign: return T_I32
    T_F32

check_vec_ctor = (n: int, t: int, args: int[]) -> int:
    # vecN(x, y, ...) with scalars and/or smaller vectors; vecN(s) splats; mat4(...) 16 floats or none
    total = 0
    ct = vec_comp_type(t)
    loop a in args:
        if nodes[a].kind == .namedarg: fatal(nodes[a].pos, "named arguments are not supported here")
        at = prune(check_expr(a, ct))
        add_flag(a, NF_CHECKED)
        if types[at].kind == .vec:
            total += vec_n(at)
        else:
            if is_int(ct) and is_int(at) and not is_lit(a) and not can_coerce(a, at, ct):
                # (ivec2(x, y) with ints: their i32s, as i32(x) makes them)
                c = mk(.call, nodes[a].pos)
                nodes[c].a = i32(bc_ident(type_str(ct), nodes[a].pos))
                inner = nodes.len()
                nodes.push(nodes[a])
                set_list(c, [inner])
                nodes[a] = nodes[c]
                check_expr(a, ct)
            else if is_lit(a) or is_numeric(at) or (is_float(ct) and bundled_rational_type(at)): coerce(a, ct)
            else: fatal(nodes[a].pos, "expected a number or vector, found {dt(at)}")
            total += 1
    want = vec_n(t)
    if args.len() != 0 and total != want and not (args.len() == 1 and total == 1):
        fatal(nodes[n].pos, "{dt(t)}(...) needs {want} components, got {total}")
    nodes[n].kind = .intrinsic
    nodes[n].aux = i32(int(IN.vec_ctor))
    set_list(n, args)
    nodes[n].a = 0
    nodes[n].type = i32(t)
    t

swizzle_chars = "xyzwrgbastpq"
swizzle_index = (c: u8) -> int:
    i = find_byte(swizzle_chars, c)
    if i < 0: return -1
    i % 4

# ---------------- operators ----------------
# a call with n arguments can go to declaration d (as many parameters, or fewer with defaults)
args_fit = (d: int, n: int) -> bool:
    np = nkids(d)
    if n > np: return false
    loop i in [n..np):
        if nodes[kid(d, i)].b == 0: return false
    true

# d's first parameter is an array or a string as written (or has no type: generic)
takes_seq = (d: int) -> bool:
    if nkids(d) == 0: return false
    tn = int(nodes[kid(d, 0)].a)
    if tn == 0: return true
    nodes[tn].kind == .tarray or (nodes[tn].kind == .tname and name_of(int(nodes[tn].name)) == "str")

decl_in_prelude = (d: int) -> bool: d != 0 and modules[int(nodes[d].mod)].is_prelude

# Dewy's named operator functions use the same overloads and specialization as
# implementation-language symbolic declarations. Keep their real names intact
# so explicit calls, imports and editor references remain ordinary functions.
dewy_operator_name = (op: str, unary: bool) -> str:
    if unary:
        if op == "-": return "__unary_sub__"
        if op == "~": return "__not__"
        return ""
    match op:
        "+": "__add__"
        "-": "__sub__"
        "*": "__mul__"
        "/": "__truediv__"
        "//": "__floordiv__"
        "**": "__pow__"
        "%": "__mod__"
        "==": "__eq__"
        "!=": "__ne__"
        "<": "__lt__"
        "<=": "__le__"
        ">": "__gt__"
        ">=": "__ge__"
        "<<": "__lshift__"
        ">>": "__rshift__"
        "&": "__and__"
        "|": "__or__"
        "^": "__xor__"
        _: ""

op_overload = (n: int, opname: str) -> int:
    decls: int[]
    nm = intern(opname)
    collect_fns(nm, decls)
    tm = module_of_type(ntype(int(nodes[n].a)))
    if tm >= 0: collect_module(tm, nm, decls)
    if nodes[n].b != 0:
        tm2 = module_of_type(ntype(int(nodes[n].b)))
        if tm2 >= 0: collect_module(tm2, nm, decls)
    protocol = dewy_operator_name(opname, nodes[n].b == 0)
    if protocol != "":
        pn = intern(protocol)
        collect_fns(pn, decls)
        if tm >= 0: collect_module(tm, pn, decls)
        if nodes[n].b != 0:
            pm = module_of_type(ntype(int(nodes[n].b)))
            if pm >= 0: collect_module(pm, pn, decls)
    if decls.len() == 0: return 0
    a = int(nodes[n].a)
    b = int(nodes[n].b)
    # (only overloads the operands could be given to: otherwise the operator is just undefined
    # for these types, which says more than why some unrelated overload does not fit)
    ops = [a]
    if b != 0: ops.push(b)
    fit: int[]
    loop d in decls:
        if nkids(d) != ops.len(): continue
        sig = fn_sig(d)
        binds = fill(0, int(sig.ntp))
        ok = true
        loop i in 0.. and x in ops:
            if arg_cost(x, sig.params[i], binds) < 0: ok = false
        if ok: fit.push(d)
    if fit.len() == 0: return 0
    decls = fit
    add_flag(a, NF_CHECKED)
    args = [a]
    if b != 0:
        add_flag(b, NF_CHECKED)
        args.push(b)
    nodes[n] = Node(kind = .call, pos = nodes[n].pos)
    set_list(n, args)
    result = resolve_fn_call(n, nm, decls, args, 0)
    if opname in ["==", "!=", "<", "<=", ">", ">="] and prune(result) != T_BOOL:
        fatal(nodes[n].pos, "comparison operator {opname} must return bool, found {dt(result)}")
    result

is_struct_like = (t0: int) -> bool:
    t = prune(t0)
    k = types[t].kind
    k == .struct_ or k == .tuple or (k == .enum_ and not simple_enum(t))

spread_count = 0

array_has_spread = (n: int) -> bool:
    loop i in [0..nkids(n)):
        if has_flag(kid(n, i), NF_SPREAD): return true
    false

mk_name = (name: int, pos: int) -> int:
    n = mk(.ident, pos)
    nodes[n].name = i32(name)
    n

# a type expression node for an already resolved type (for synthesized declarations)
type_node_of = (t: int, pos: int) -> int:
    n = mk(.tname, pos)
    nodes[n].aux = -7
    nodes[n].ival = t
    n

# a one-character string literal standing for its character code
# the character of the source at position p (0 past its end)
# (the value of an argument written as a whole number alone, 6 and not 6.0 or 5 + 1, even where
# it became a float; -1 for anything else: 5 + 1 says the number is meant)
written_int = (a: int) -> int:
    if a == 0 or not is_lit(a): return -1
    if nodes[a].kind != .int_lit and nodes[a].kind != .float_lit: return -1
    f = pos_file(nodes[a].pos)
    if f < 0 or f >= files.len(): return -1
    src = files[f].src
    o = pos_off(nodes[a].pos)
    if o >= len(src) or not is_digit(src[o]): return -1
    loop o < len(src) and is_digit(src[o]): o += 1
    loop o < len(src) and src[o] == ' ': o += 1
    if o >= len(src) or (src[o] != ')' and src[o] != ','): return -1
    if nodes[a].kind == .int_lit: return nodes[a].ival
    int(nodes[a].fval)

src_char = (p: int) -> u8:
    f = pos_file(p)
    if p <= 0 or f < 0 or f >= files.len(): return 0
    o = pos_off(p)
    if o >= len(files[f].src): return 0
    files[f].src[o]

charlike = (n: int) -> bool: nodes[n].kind == .str_lit and has_flag(n, NF_CHARLIKE)

charlike_to_int = (n: int):
    s = name_of(int(nodes[n].sval))
    v = int(s[0])
    if len(s) > 1:
        # UTF-8 sequence -> code point
        v = v & (0x3f >> (len(s) - 1))
        loop i in [1..len(s)): v = (v << 6) | (int(s[i]) & 0x3f)
    nodes[n].kind = .int_lit
    nodes[n].ival = v
    nodes[n].aux = 1
    add_flag(n, NF_LITERAL)
    clear_flag(n, NF_CHARLIKE)

# Collection literals take their element context from a typed operand.
# Unwrap an optional only for the literal; the normal equality path adds its tag.
binary_literal_context = (n: int, t0: int, op: Tok) -> bool:
    t = prune(t0)
    if types[t].kind == .opt: t = prune(int(types[t].elem))
    if dewy_set_literal(n): return is_dewy_set_type(t)
    if op != .eq and op != .ne: return false
    if nodes[n].kind == .record_lit: return dewy_record_target(t) != 0
    if nodes[n].kind == .map_lit: return is_map_type(t)
    if nodes[n].kind == .array:
        if nkids(n) == 0 and (is_map_type(t) or dewy_record_target(t) != 0): return true
        return types[t].kind == .array or types[t].kind == .fixed
    false

check_binary = (n: int, expected: int) -> int:
    op = nodes[n].op as Tok
    if op == .dotop: return check_dotted(n, expected)
    if op == .kw_xor:
        # logical on bools (a != b), bitwise on integers
        ta = prune(check_expr(int(nodes[n].a), 0))
        nodes[n].a = i32(last_checked)
        add_flag(int(nodes[n].a), NF_CHECKED)
        if ta == T_BOOL: nodes[n].op = i32(int(Tok.ne))
        else: nodes[n].op = i32(int(Tok.caret))
        return check_expr(n, expected)
    # 'a' == c: the literal is a character code when the other side is an integer
    if nodes[int(nodes[n].a)].kind == .str_lit and charlike(int(nodes[n].a)) and not charlike(int(nodes[n].b)) and op != .plus and op != .star:
        tb = prune(check_expr(int(nodes[n].b), 0))
        nodes[n].b = i32(last_checked)
        add_flag(int(nodes[n].b), NF_CHECKED)
        if is_int(tb): charlike_to_int(int(nodes[n].a))
    if op == .kw_in and nodes[int(nodes[n].b)].kind == .range and not has_flag(int(nodes[n].b), NF_STEP):
        return check_in_range(n, expected)
    if op == .kw_in:
        needle = int(nodes[n].a)
        container = int(nodes[n].b)
        dewy = files[pos_file(nodes[n].pos)].is_dewy
        call = mk(.call, nodes[n].pos)
        callee = mk(.field, nodes[n].pos)
        nodes[callee].a = nodes[n].b
        nodes[callee].name = i32(intern("contains"))
        nodes[call].a = i32(callee)
        set_list(call, [int(nodes[n].a)])
        nodes[n] = nodes[call]
        t = check_expr(n, 0)
        if dewy:
            # Method syntax puts the receiver first. Membership reads the
            # needle first, preserving snapshots and side effects in that order.
            if nodes[n].kind == .call and nodes[n].aux == 0:
                save_call_order(n, [needle, container], kids(n))
            else if nodes[n].kind == .block and nkids(n) >= 3 and nodes[kid(n, 0)].kind == .vardecl and nodes[kid(n, 1)].kind == .vardecl and nodes[kid(n, 0)].b == i32(container) and nodes[kid(n, 1)].b == i32(needle):
                # Dependent defaults already captured the two explicit values.
                statements = kids(n)
                first = statements[0]
                statements[0] = statements[1]
                statements[1] = first
                set_list(n, statements)
            else: fatal(nodes[n].pos, "membership needs a contains function, not a callable field")
            if t != T_BOOL: fatal(nodes[n].pos, "membership's contains function must return bool")
        return t
    is_cmp = op == .eq or op == .ne or op == .lt or op == .le or op == .gt or op == .ge
    is_shift = op == .shl or op == .shr
    hint = 0
    if not is_cmp and expected != 0 and (is_numeric(expected) or is_vec(expected)): hint = expected
    if not is_cmp and is_quantity(expected) and is_float(quantity_base(expected)): hint = quantity_base(expected)
    a = int(nodes[n].a)
    b = int(nodes[n].b)
    # ("-" * 40 is forty dashes, as in Python: a character's code multiplied means nothing)
    if op == .star:
        if charlike(a) and not charlike(b): clear_flag(a, NF_CHARLIKE)
        if charlike(b) and not charlike(a): clear_flag(b, NF_CHARLIKE)
    a_char = op == .plus and charlike(a)
    b_char = op == .plus and charlike(b)
    # ('a' + i: a character's code and a number, as i + 'a' is; the number decides)
    if a_char and not b_char and hint == 0 and has_flag(a, NF_SQUOTE):
        tb0 = prune(check_expr(b, 0))
        add_flag(b, NF_CHECKED)
        if is_int(tb0): hint = tb0
    literal_op = (op == .eq or op == .ne or op == .amp or op == .pipe or op == .caret or op == .minus) and files[pos_file(nodes[n].pos)].is_dewy
    a_literal = literal_op and (nodes[a].kind == .array or nodes[a].kind == .record_lit or nodes[a].kind == .map_lit or dewy_set_literal(a))
    b_literal = literal_op and (nodes[b].kind == .array or nodes[b].kind == .record_lit or nodes[b].kind == .map_lit or dewy_set_literal(b))
    if a_literal and not b_literal:
        # Type-checking the typed operand first supplies context without moving
        # either operand in the runtime expression or checking it twice.
        bt = prune(check_expr(b, 0))
        add_flag(b, NF_CHECKED)
        if binary_literal_context(a, bt, op): hint = if tkind(bt) == .opt: telem(bt) else: bt
    ta = prune(check_expr(a, hint))
    tb = 0
    bk = nodes[b].kind
    if bk == .none_lit or bk == .null_lit or bk == .dotname: tb = prune(check_expr(b, ta))
    else:
        h = 0
        if not is_lit(a) and not is_shift and is_numeric(ta): h = ta
        if not a_literal and b_literal and binary_literal_context(b, ta, op): h = if tkind(ta) == .opt: telem(ta) else: ta
        tb = prune(check_expr(b, h))
    pending_decimal = (nodes[a].kind == .float_lit and nodes[a].sval != 0 and is_lit(a)) or (nodes[b].kind == .float_lit and nodes[b].sval != 0 and is_lit(b))
    exact_operands = pending_decimal and (is_numeric(ta) or bundled_rational_type(ta) or bundled_bigint_type(ta)) and (is_numeric(tb) or bundled_rational_type(tb) or bundled_bigint_type(tb))
    if exact_operands and not is_float(hint) and not (is_float(ta) and not is_lit(a)) and not (is_float(tb) and not is_lit(b)):
        if nodes[a].kind == .float_lit and nodes[a].sval != 0 and is_lit(a): ta = exact_decimal(a)
        if nodes[b].kind == .float_lit and nodes[b].sval != 0 and is_lit(b): tb = exact_decimal(b)
    if types[ta].kind == .quantity or types[tb].kind == .quantity: return quantity_binary(n, a, b, expected)
    if not is_shift and ta == T_MATH_INT and (bundled_bigint_type(tb) or bundled_rational_type(tb)):
        coerce(a, tb)
        ta = tb
    else if not is_shift and tb == T_MATH_INT and (bundled_bigint_type(ta) or bundled_rational_type(ta)):
        coerce(b, ta)
        tb = ta
    if is_float(tb) and bundled_rational_type(ta):
        coerce(a, tb)
        ta = tb
    else if is_float(ta) and bundled_rational_type(tb):
        coerce(b, ta)
        tb = ta
    # (y == 650 in update, y moved by speed * dt: it steps over 650, never on it)
    if op == .eq and is_float(ta) and (nodes[a].kind == .ident or nodes[a].kind == .field) and (nodes[b].kind == .int_lit or nodes[b].kind == .float_lit) and cx >= 0 and not pos_in_lib(nodes[n].pos):
        lv = 0.0
        if nodes[b].kind == .int_lit: lv = f64(nodes[b].ival)
        else if nodes[b].kind == .float_lit: lv = nodes[b].fval
        ci = int(ctxs[cx].inst)
        if lv != 0.0 and ci > 0 and fns[ci].decl != 0 and name_of(int(nodes[int(fns[ci].decl)].name)) == "update":
            lt = "{lv}"
            if lv == floor(lv) and abs(lv) < 1e15: lt = "{i64(lv)}"
            nm = "it"
            if nodes[a].kind == .ident: nm = name_of(int(nodes[a].name))
            else if nodes[a].kind == .field: nm = "." + name_of(int(nodes[a].name))
            warn(nodes[n].pos, "a number with a fraction, moved a little each frame, steps past {lt} ({lv - 0.3}, then {lv + 0.2}) and is rarely exactly {lt}: `>=` (or `<=`) is true once {nm} gets there")
    # (s[0] + "!": a byte and a character's code added, which reads like text joined)
    if b_char and is_int(ta) and not is_lit(a) and is_int(tb) and not has_flag(b, NF_SQUOTE):
        ch = name_of(int(nodes[b].sval))
        if nodes[a].kind == .ident:
            an = name_of(int(nodes[a].name))
            warn(nodes[n].pos, "this adds the character code of {ch} to a number, not text to text: for text, write `\"\{{an}}{ch}\"` (and when {an} is a character from s[i], `chr({an}) + \"{ch}\"`)")
        else: warn(nodes[n].pos, "this adds the character code of {ch} to a number, not text to text (s[i] is a character's code): `chr(s[i]) + \"{ch}\"` joins text")
    if a_char and is_int(tb) and not is_lit(b) and is_int(ta) and not has_flag(a, NF_SQUOTE):
        warn(nodes[n].pos, "this adds a character code and a number: for text, ... + chr(x)")
    if types[ta].kind == .typeval or types[tb].kind == .typeval: fatal(nodes[n].pos, "a type name cannot be used as a value here")
    # vectors
    if is_cmp and (op == .eq or op == .ne):
        note_value_helpers(ta)
        note_value_helpers(tb)
        # (x == v with x: T? and v: T: v as a T?, so none is never equal to it)
        if tkind(ta) == .opt and tkind(tb) != .opt and tkind(tb) != .none_lit and type_eq(prune(int(types[ta].elem)), tb):
            nodes[n].b = i32(coerce(b, ta))
            b = int(nodes[n].b)
            tb = ta
        else if tkind(tb) == .opt and tkind(ta) != .opt and tkind(ta) != .none_lit and type_eq(prune(int(types[tb].elem)), ta):
            nodes[n].a = i32(coerce(a, tb))
            a = int(nodes[n].a)
            ta = tb
    # ("v is " + v: a vector joined to text)
    if op == .plus and (tkind(ta) == .str_ and is_vec(tb) or is_vec(ta) and tkind(tb) == .str_):
        vt = tb
        if is_vec(ta): vt = ta
        fatal(nodes[n].pos, "cannot add a {dt(vt)} to text: put the value inside the string (\"v is \{v}\")")
    if is_vec(ta) or is_vec(tb): return check_vec_binary(n, op, ta, tb)
    if types[ta].kind == .fixed or types[tb].kind == .fixed:
        if op != .eq and op != .ne: fatal(nodes[n].pos, "operator {op_text(op, nodes[n].pos)} is not defined for {dt(ta)} and {dt(tb)} (fixed-size arrays can be compared with {op_text(.eq, nodes[n].pos)} and {op_text(.ne, nodes[n].pos)})")
        if types[ta].kind == .fixed: coerce(b, ta)
        else: coerce(a, tb)
        nodes[n].aux = 1
        nodes[n].type = i32(T_BOOL)
        return T_BOOL
    if is_struct_like(ta) or is_struct_like(tb):
        opn = tok_text(op)
        r = op_overload(n, opn)
        if r != 0: return r
        if op == .ne:
            eqn = mk(.binary, nodes[n].pos)
            nodes[eqn].op = i32(int(Tok.eq))
            nodes[eqn].a = i32(a)
            nodes[eqn].b = i32(b)
            r2 = op_overload(eqn, "==")
            if r2 != 0:
                nodes[n] = Node(kind = .not_, pos = nodes[n].pos, a = i32(eqn), type = i32(T_BOOL))
                return T_BOOL
        if op == .gt or op == .le or op == .ge:
            # from `<` alone: a > b is b < a, a <= b is not (b < a), a >= b is not (a < b)
            ltn = mk(.binary, nodes[n].pos)
            nodes[ltn].op = i32(int(Tok.lt))
            nodes[ltn].a = i32(b)
            nodes[ltn].b = i32(a)
            if op == .ge:
                nodes[ltn].a = i32(a)
                nodes[ltn].b = i32(b)
            r2 = op_overload(ltn, "<")
            if r2 != 0:
                # Deriving > / <= reverses the parameter slots, not the
                # evaluation order of the source operands.
                save_call_order(ltn, [a, b], kids(ltn))
                if op == .gt: nodes[n] = nodes[ltn]
                else: nodes[n] = Node(kind = .not_, pos = nodes[n].pos, a = i32(ltn), type = i32(T_BOOL))
                return r2
        if op == .eq or op == .ne:
            if not type_eq(ta, tb): cmp_error(n, ta, tb)
            nodes[n].aux = 1
            nodes[n].type = i32(T_BOOL)
            return T_BOOL
        why = ""
        if is_union(ta) or is_union(tb): why = if dewy_at(nodes[n].pos): " (find out which it holds first: `if x is? int64 \{ ... }` or a `match`)" else: " (find out which it holds first: `if x is int: ...` or a `match`)"
        else if type_eq(ta, tb) and types[ta].kind == .struct_ and not is_map_type(ta):
            why = " (a struct has the operators defined for it: `({opn}) = (a: {dt(ta)}, b: {dt(ta)}) -> ...`)"
            if op == .gt or op == .le or op == .ge: why = " (define `(<) = (a: {dt(ta)}, b: {dt(ta)}) -> bool: ...` and >, <= and >= come from it)"
            if dewy_at(nodes[n].pos): why = " (a record has the operators defined for it, such as `__add__=(a:{dt(ta)} b:{dt(ta)}):>{dt(ta)}=>...` for + or `__lt__` for <?)"
        fatal(nodes[n].pos, "operator {opn} is not defined for {dt(ta)} and {dt(tb)}{why}")
    if is_shift and dewy_at(nodes[n].pos) and nodes[b].kind == .int_lit and nodes[b].ival < 0 and not has_flag(b, NF_U64):
        fatal(nodes[b].pos, "a shift count is unsigned, and {nodes[b].ival} is negative")
    if is_shift and not (is_lit(a) and is_lit(b)):
        finalize_literal(a)
        finalize_literal(b)
        ta = prune(ntype(a))
        tb = prune(ntype(b))
        if not is_int(ta) or not is_int(tb): fatal(nodes[n].pos, "shift operands must be integers")
        if ta == T_MATH_INT:
            known_b, y = integer_constant(b)
            if known_b and y < 0 and types[tb].sign: fatal(nodes[n].pos, "shift count must be nonnegative")
        nodes[n].type = i32(ta)
        return ta
    tka = types[ta].kind
    tkb = types[tb].kind
    if op == .plus and tka == .str_:
        if is_numeric(tb) or tkb == .bool_: fatal(nodes[b].pos, "cannot add this {dt(tb)} to text: put the value inside the string (\"...\{x}\") or convert it ({jd(nodes[b].pos, "str(x)", "string(x)")})")
        coerce(b, T_STR)
        nodes[n].aux = 2
        nodes[n].type = i32(T_STR)
        return T_STR
    if op == .plus and tka == .array:
        if tkb != .array and is_numeric(int(types[ta].elem)) and (is_numeric(tb) or is_lit(b)):
            fatal(nodes[n].pos, "+ joins two arrays; to add {dt(tb)} to each element, use .+ (xs .+ 1.0)")
        coerce(b, ta)
        nodes[n].aux = 3
        nodes[n].type = i32(ta)
        return ta
    if tka == .ptr and (op == .plus or op == .minus) and (is_int(tb) or is_lit(b)):
        coerce(b, T_INT)
        nodes[n].aux = 4
        nodes[n].type = i32(ta)
        return ta
    if tka == .ptr and tkb == .ptr and op == .minus:
        nodes[n].aux = 5
        nodes[n].type = i32(T_INT)
        return T_INT
    if is_cmp:
        if tka == .str_ or tkb == .str_:
            if not type_eq(ta, tb): cmp_error(n, ta, tb)
            nodes[n].aux = 2
            nodes[n].type = i32(T_BOOL)
            return T_BOOL
        if tka == .opt or tkb == .opt or tka == .none_lit or tkb == .none_lit:
            if op != .eq and op != .ne: opt_cmp_error(n, a, b, ta, tb)
            if nodes[b].kind == .none_lit or nodes[a].kind == .none_lit:
                if nodes[a].kind == .none_lit:
                    nodes[n].a = i32(b)
                    nodes[n].b = i32(a)
                if tkind(ntype(int(nodes[n].a))) != .opt: fatal(nodes[n].pos, "only optionals can be compared with none")
                nodes[n].aux = 6
                nodes[n].aux2 = i32(map_presence_fn(int(nodes[n].a)))
                nodes[n].type = i32(T_BOOL)
                return T_BOOL
            join_types(a, b, nodes[n].pos)
            nodes[n].aux = 1
            nodes[n].type = i32(T_BOOL)
            return T_BOOL
        if tka == .array or tkb == .array:
            if op != .eq and op != .ne:
                why = ""
                ot = op_text(op, nodes[n].pos)
                if (tka == .array and is_numeric(int(types[ta].elem))) or (tkb == .array and is_numeric(int(types[tb].elem))): why = " (for each element: .{ot}, as in xs .{ot} 2.0, gives {dt(mk_array(T_BOOL))})"
                fatal(nodes[n].pos, "arrays can only be compared with {op_text(.eq, nodes[n].pos)} and {op_text(.ne, nodes[n].pos)}{why}")
            if not can_coerce(b, tb, ta) and tkb != .array and tka == .array and is_numeric(int(types[ta].elem)) and (is_numeric(tb) or is_lit(b)):
                ot = op_text(op, nodes[n].pos)
                fatal(nodes[n].pos, "an array compared with {dt(tb)}: for each element use .{ot} (xs .{ot} 2.0 gives {dt(mk_array(T_BOOL))})")
            if not can_coerce(b, tb, ta): cmp_error(n, ta, tb)
            coerce(b, ta)
            nodes[n].aux = 1
            nodes[n].type = i32(T_BOOL)
            return T_BOOL
        if tka == .bool_ or tka == .enum_ or tka == .ptr or tka == .null_ or tka == .fn_ or tka == .cfn:
            if tka == .null_:
                nodes[n].a = i32(b)
                nodes[n].b = i32(a)
                a = int(nodes[n].a)
                b = int(nodes[n].b)
                x = ta
                ta = tb
                tb = x
            if not can_coerce(b, tb, ta) and not type_eq(ta, tb): cmp_error(n, ta, tb)
            if types[ta].kind == .fn_: fatal(nodes[n].pos, "functions cannot be compared")
            coerce(b, ta)
            nodes[n].type = i32(T_BOOL)
            return T_BOOL
    if op == .amp or op == .pipe or op == .caret:
        if tka == .bool_ and tkb == .bool_:
            nodes[n].type = i32(T_BOOL)
            return T_BOOL
    if not is_numeric(ta) or not is_numeric(tb):
        r = op_overload(n, tok_text(op))
        if r != 0: return r
        if tka == .opt and is_numeric(int(types[ta].elem)): fatal(nodes[n].pos, "this {dt(ta)} may be none (nothing), so {tok_text(op)} cannot use it: say what to use then (`x ?? 0`){jd(nodes[n].pos, ", or `x!` when it cannot be none", ", or check it first: `if x isnt? none \{ ... }`")}")
        why = ""
        if is_union(ta) or is_union(tb): why = if dewy_at(nodes[n].pos): " (find out which it holds first: `if x is? int64 \{ ... }` or a `match`)" else: " (find out which it holds first: `if x is int: ...` or a `match`)"
        if tka == .array and is_int(tb) and op == .star:
            why = " (fill(x, n) makes an array of n copies of x)"
            if is_numeric(int(types[ta].elem)): why = " (fill(x, n) makes an array of n copies of x; xs .* n multiplies each element)"
        else if (tka == .array and is_numeric(int(types[ta].elem))) or (tkb == .array and is_numeric(int(types[tb].elem))):
            if op == .plus or op == .minus or op == .star or op == .slash or op == .percent: why = " (for each element: .{tok_text(op)}, as in xs .{tok_text(op)} 2.0)"
        if len(why) == 0 and op == .percent and tka == .str_: why = " (a value goes into text inside braces, with its format: \"\{x:.2f}\")"
        # (age + 1 with age from read_line: text, not a number)
        if len(why) == 0:
            sa = tka == .str_ or (tka == .opt and tkind(int(types[ta].elem)) == .str_)
            sb = tkb == .str_ or (tkb == .opt and tkind(int(types[tb].elem)) == .str_)
            if (sa and is_numeric(tb)) or (sb and is_numeric(ta)): why = " (text is not a number, even when it holds digits: `to_int(s)` or `input_int(...)` makes a number, and `\"\{x}\"` puts a number in text)"
        if len(why) == 0: why = void_rec_hint(a) + void_rec_hint(b) + uncalled_hint(a, 0) + uncalled_hint(b, 0)
        # (square(4) + 1 with a square that prints: it gives nothing back)
        if len(why) == 0:
            loop x in [a, b]:
                if tkind(ntype(x)) == .void_ and nodes[x].kind == .call and nodes[x].sym > 0 and int(nodes[x].sym) < fns.len() and fns[int(nodes[x].sym)].decl != 0:
                    fnm = name_of(int(nodes[int(fns[int(nodes[x].sym)].decl)].name))
                    why = " ('{fnm}' gives nothing back (printing is not giving back): end it with the value it should give, and write {jd(nodes[n].pos, "`-> int`", "`:>int64`")} after its parameters)"
                    break
        fatal(nodes[n].pos, "operator {tok_text(op)} is not defined for {dt(ta)} and {dt(tb)}{why}")
    if op == .slash and is_int(ta) and is_int(tb) and files[pos_file(nodes[n].pos)].is_dewy:
        fatal(nodes[n].pos, "Dewy core experiment does not yet support integer /; use // or convert to float64")
    # High unsigned Dewy literals go through typed lowering. The untyped fold
    # below uses signed division/shifts and would lose their unsigned meaning.
    wide_unsigned = (has_flag(a, NF_U64) or has_flag(b, NF_U64)) and files[pos_file(nodes[n].pos)].is_dewy
    if is_lit(a) and is_lit(b) and not is_cmp and not wide_unsigned:
        # fold literal arithmetic, keeping the result an untyped literal
        if nodes[a].kind == .int_lit and nodes[b].kind == .int_lit:
            x = nodes[a].ival
            y = nodes[b].ival
            mathematical = lit_default(n) == T_MATH_INT
            operation = if op == .plus: 0 else if op == .minus: 1 else if op == .star: 2 else if op == .slash: 3 else if op == .shl: 4 else: -1
            if mathematical and operation >= 0 and math_word_overflow(operation, x, y):
                coerce(a, T_MATH_INT)
                coerce(b, T_MATH_INT)
                nodes[n].type = i32(T_MATH_INT)
                return T_MATH_INT
            if mathematical and (op == .shl or op == .shr) and y < 0: fatal(nodes[n].pos, "shift count must be nonnegative")
            v = 0
            ok = true
            if op == .plus: v = x + y
            else if op == .minus: v = x - y
            else if op == .star: v = x * y
            else if op == .slash:
                if y == 0: ok = false
                else:
                    v = x / y
                    # (3 / 4 is 0: in languages with one kind of number it is 0.75)
                    if v == 0 and x != 0: warn(nodes[n].pos, "{x} / {y} is 0: whole numbers divide to a whole number ({x}.0 / {y} is {f64(x) / f64(y)})")
            else if op == .percent:
                if y == 0: ok = false
                else: v = x % y
            else if op == .amp: v = x & y
            else if op == .pipe: v = x | y
            else if op == .caret: v = (x xor y)
            else if (op == .shl or op == .shr) and dewy_at(nodes[n].pos) and (y >= 64 or y < 0):
                # (a count past the width reaches the continuation bits)
                v = if op == .shr and x < 0: -1 else: 0
            else if op == .shl: v = x << y
            else if op == .shr: v = x >> y
            else: ok = false
            if ok:
                big = v < 0 and (has_flag(a, NF_U64) or has_flag(b, NF_U64) or (op == .shl and x >= 0))
                nodes[n] = Node(kind = .int_lit, pos = nodes[n].pos, ival = v, flags = i32(NF_LITERAL | NF_CHECKED), type = i32(T_INT))
                if big: add_flag(n, NF_U64)
                nodes[n].type = i32(lit_default(n))
                return ntype(n)
        else if (op == .plus or op == .minus or op == .star or op == .slash) and (nodes[a].kind == .int_lit or nodes[a].kind == .float_lit) and (nodes[b].kind == .int_lit or nodes[b].kind == .float_lit):
            x = nodes[a].fval
            if nodes[a].kind == .int_lit: x = f64(nodes[a].ival)
            y = nodes[b].fval
            if nodes[b].kind == .int_lit: y = f64(nodes[b].ival)
            v = 0.0
            if op == .plus: v = x + y
            else if op == .minus: v = x - y
            else if op == .star: v = x * y
            else: v = x / y
            if v != v:
                # (a NaN as the target's processor makes it, whatever the compiler runs on:
                # x86-64's has the sign bit set, arm64's and wasm's do not; negating flips it)
                neg = int(f64_bits(v)) < 0
                if neg == (target_arm64 or target_wasm): v = -v
            nodes[n] = Node(kind = .float_lit, pos = nodes[n].pos, fval = v, flags = i32(NF_LITERAL | NF_CHECKED), type = i32(T_FLOAT))
            return T_FLOAT
    j = join_types(a, b, nodes[n].pos)
    if (op == .amp or op == .pipe or op == .caret) and not is_int(j): fatal(nodes[n].pos, "bitwise operators need integers")
    # (got / total * 100 with whole numbers: 3 / 4 is 0, so the percent is 0)
    if op == .star and is_int(j) and nodes[a].kind == .binary and nodes[a].op == i32(int(Tok.slash)) and nodes[b].kind == .int_lit and nodes[b].ival == 100 and not pos_in_lib(nodes[n].pos):
        an = "a"
        if nodes[int(nodes[a].a)].kind == .ident: an = name_of(int(nodes[int(nodes[a].a)].name))
        warn(nodes[n].pos, "this divides whole numbers before multiplying, dropping the fraction (3 / 4 * 100 is 0): `{an} * 100 / ...` multiplies first, `f64({an}) / ...` keeps the fraction")
    if is_cmp: nodes[n].type = i32(T_BOOL)
    else: nodes[n].type = i32(j)
    ntype(n)

# (q1 * q2 for quaternions, which are vec4s: * multiplies their parts one by one, which is no
# rotation; values from quat_* functions, and variables made from them, are known to be ones)
quat_nodes: {int: bool} = {}
quat_locals: {int: bool} = {}
quat_globals: {int: bool} = {}
is_quat = (e: int) -> bool:
    if quat_nodes.has(e): return true
    if nodes[e].kind != .ident: return false
    if nodes[e].aux == i32(int(SK.local)): return quat_locals.has(int(nodes[e].sym))
    nodes[e].aux == i32(int(SK.global)) and quat_globals.has(int(nodes[e].sym))

check_vec_binary = (n: int, op: Tok, ta: int, tb: int) -> int:
    a = int(nodes[n].a)
    b = int(nodes[n].b)
    if op == .star and not pos_in_lib(nodes[n].pos):
        if type_eq(ta, T_VEC4) and type_eq(tb, T_VEC4) and (is_quat(a) or is_quat(b)):
            warn(nodes[n].pos, "* multiplies the parts of two vec4s one by one, which for quaternions is no rotation: quat_mul(a, b) turns by b, then by a")
        if type_eq(ta, T_VEC4) and type_eq(tb, T_VEC3): fatal(nodes[n].pos, "cannot apply * to vec4 and vec3 (a quaternion turns a vector with quat_rotate(q, v))")
        if ta == T_MAT4 and type_eq(tb, T_VEC3): fatal(nodes[n].pos, "cannot apply * to mat4 and vec3 (transform_point(m, p) moves a point, transform_dir(m, d) turns a direction; or m * vec4(p, 1))")
    if op == .eq or op == .ne:
        if not type_eq(ta, tb): cmp_error(n, ta, tb)
        nodes[n].aux = 1
        nodes[n].type = i32(T_BOOL)
        return T_BOOL
    if op != .plus and op != .minus and op != .star and op != .slash: fatal(nodes[n].pos, "operator {op_text(op, nodes[n].pos)} is not defined for vectors")
    if is_vec(ta) and is_vec(tb):
        if ta == T_MAT4 and tb == T_MAT4:
            if op != .star: fatal(nodes[n].pos, "matrices only support *")
            nodes[n].aux = 7
            nodes[n].type = i32(T_MAT4)
            return T_MAT4
        if ta == T_MAT4 and tb == T_VEC4 and op == .star:
            nodes[n].aux = 8
            nodes[n].type = i32(T_VEC4)
            return T_VEC4
        if not type_eq(ta, tb):
            # (a point on the ground, 2D, into 3D: x and z)
            g = ""
            if (ta == T_VEC3 and tb == T_VEC2) or (ta == T_VEC2 and tb == T_VEC3): g = " (a 2D vector into 3D, on the ground: `vec3(p.x, 0, p.y)`; or `vec3(p, 0)` for x and y)"
            fatal(nodes[n].pos, "cannot apply {op_text(op, nodes[n].pos)} to {dt(ta)} and {dt(tb)}{g}")
        nodes[n].aux = 9
        nodes[n].type = i32(ta)
        return ta
    # vector op scalar / scalar op vector
    if is_vec(ta):
        coerce(b, vec_comp_type(ta))
        nodes[n].aux = 10
        nodes[n].type = i32(ta)
        return ta
    if op != .star and op != .slash and op != .plus and op != .minus: fatal(nodes[n].pos, "invalid vector operation")
    coerce(a, vec_comp_type(tb))
    nodes[n].aux = 11
    nodes[n].type = i32(tb)
    tb

# ---------------- match ----------------
check_match = (m: int, expected: int) -> int:
    is_stmt = has_flag(m, NF_STMT)
    check_expr(int(nodes[m].a), 0)
    finalize_literal(int(nodes[m].a))
    st = prune(ntype(int(nodes[m].a)))
    mark = scope_mark()
    hidden = new_local(0, st, nodes[m].pos)
    locals[hidden].flags = i32(LF_ADDR)
    nodes[m].sym = i32(hidden)
    result = 0
    first_val = 0
    has_wild = false
    finite_seen = 0
    union_bool_seen = 0
    dewy = files[pos_file(nodes[m].pos)].is_dewy
    seen: bool[]
    if types[st].kind == .enum_:
        check_struct_fields(int(types[st].st))
        seen = fill(false, int(structs[int(types[st].st)].nvariants))
    sc = int(nodes[m].a)
    narrows = (is_union(st) or types[st].kind == .opt) and nodes[sc].kind == .ident and nodes[sc].aux == i32(int(SK.local))
    # (a field path or a global: narrowed like `if x.f is T`)
    pkey = ""
    if (is_union(st) or types[st].kind == .opt) and not narrows: pkey = path_key(sc)
    changed: int[]
    loop i in [0..nkids(m)):
        arm = kid(m, i)
        amark = scope_mark()
        changes = narrow_changes.len()
        arm_members: int[]
        arm_wild = false
        seen_before = seen
        finite_before = finite_seen
        loop k in [0..nkids(arm)):
            p = kid(arm, k)
            pk = nodes[p].kind
            # Dewy bindings are ordinary independent values initialized from the
            # once-evaluated scrutinee. Type patterns reuse union tag dispatch.
            binding = 0
            value = 0
            if dewy and (pk == .ptype or pk == .plit or pk == .pwild):
                binding = int(nodes[p].name)
                nodes[p].name = 0
                if binding != 0: value = mk_ident_local(hidden, nodes[p].pos)
            if pk == .ptype:
                pt = prune(resolve_type(int(nodes[p].a)))
                if type_eq(pt, st):
                    nodes[p].kind = .pwild
                else if is_union(st) and union_index(st, pt) >= 0:
                    vi = union_index(st, pt)
                    si = int(types[st].st)
                    nodes[p].kind = .pvariant
                    nodes[p].name = variants[int(structs[si].variants) + vi].name
                    if binding != 0:
                        e = mk(.narrow, nodes[p].pos)
                        nodes[e].a = i32(value)
                        nodes[e].aux = i32(vi)
                        nodes[e].type = i32(pt)
                        add_flag(e, NF_CHECKED)
                        value = e
                else if is_union(st) and is_union(pt) and union_within(pt, st):
                    nodes[p].type = i32(pt)
                    loop member in union_members(pt):
                        seen[union_index(st, member)] = true
                        arm_members.push(member)
                    if binding != 0: wrap_conv(value, .union_, pt)
                else if types[st].kind == .opt and type_eq(pt, telem(st)):
                    finite_seen |= 1
                    arm_members.push(pt)
                    if binding != 0:
                        e = mk(.unwrap, nodes[p].pos)
                        nodes[e].a = i32(value)
                        nodes[e].type = i32(pt)
                        add_flag(e, NF_CHECKED)
                        value = e
                else: fatal(nodes[p].pos, "type pattern {type_str(pt, true)} is not a member of {type_str(st, true)}")
                pk = nodes[p].kind
            if dewy and pk == .plit and is_union(st):
                e = int(nodes[p].a)
                check_expr(e, 0)
                vi = union_target(e, ntype(e), st)
                if vi < 0: fatal(nodes[p].pos, "literal pattern is not a member of {type_str(st, true)}")
                pt = union_members(st)[vi]
                if not is_int(pt) and pt != T_BOOL and tkind(pt) != .str_:
                    fatal(nodes[p].pos, "literal patterns need an integer, bool or string member")
                coerce(e, pt)
                nodes[p].aux2 = i32(vi)
                arm_members.push(pt)
                # A value pattern only covers part of a member. Both boolean
                # literals together cover bool, allowing an exhaustive match.
                if pt == T_BOOL:
                    union_bool_seen |= if nodes[e].ival != 0: 1 else: 2
                    if union_bool_seen == 3: seen[vi] = true
                if binding != 0:
                    narrowed = mk(.narrow, nodes[p].pos)
                    nodes[narrowed].a = i32(value)
                    nodes[narrowed].aux = i32(vi)
                    nodes[narrowed].type = i32(pt)
                    add_flag(narrowed, NF_CHECKED)
                    value = narrowed
            if binding != 0:
                d = mk(.vardecl, nodes[p].pos)
                nodes[d].name = i32(binding)
                nodes[d].b = i32(value)
                body = int(nodes[arm].b)
                statements = [d]
                loop statement in kids(body): statements.push(statement)
                set_list(body, statements)
            if pk == .ptype: continue
            if pk == .pwild:
                has_wild = true
                arm_wild = true
                continue
            if pk == .pvariant and types[st].kind == .enum_:
                si = int(types[st].st)
                vi = find_variant(si, int(nodes[p].name))
                if vi < 0: fatal(nodes[p].pos, "{dt(st)} has no variant '{name_of(int(nodes[p].name))}'{variant_hint_for(st, name_of(int(nodes[p].name)))}")
                nodes[p].aux2 = i32(vi)
                seen[vi] = true
                v = int(structs[si].variants) + vi
                if structs[si].union_: arm_members.push(int(fields[int(variants[v].fields)].type))
                if nkids(p) > 0:
                    if nkids(p) != int(variants[v].nfields): fatal(nodes[p].pos, "variant '{name_of(int(variants[v].name))}' has {variants[v].nfields} field(s), pattern binds {nkids(p)}")
                    if nkids(arm) > 1: fatal(nodes[p].pos, "patterns with bindings cannot be combined with other patterns")
                    loop f in [0..nkids(p)):
                        b = kid(p, f)
                        if name_of(int(nodes[b].name)) == "_": continue
                        ft = int(fields[int(variants[v].fields) + f].type)
                        l = new_local(int(nodes[b].name), ft, nodes[b].pos)
                        locals[l].flags = i32(int(locals[l].flags) | LF_ALIAS)
                        fa = mk(.field, nodes[b].pos)
                        nodes[fa].a = i32(mk_ident_local(hidden, nodes[b].pos))
                        nodes[fa].aux = -3
                        nodes[fa].aux2 = i32(vi)
                        nodes[fa].ival = f
                        nodes[fa].type = i32(ft)
                        add_flag(fa, NF_CHECKED)
                        locals[l].alias = i32(fa)
                        nodes[b].sym = i32(l)
                continue
            if pk == .pvariant:
                if nodes[p].aux != 0: fatal(nodes[p].pos, "variant patterns need an enum value")
                id = mk(.ident, nodes[p].pos)
                nodes[id].name = nodes[p].name
                nodes[p] = Node(kind = .plit, pos = nodes[p].pos, a = i32(id))
                pk = .plit
            if pk == .plit and nodes[int(nodes[p].a)].kind == .none_lit and types[st].kind == .enum_ and find_variant(int(types[st].st), intern("none")) >= 0:
                # `none:` matching an enum with a variant named none is that variant
                d = mk(.dotname, nodes[p].pos)
                nodes[d].name = i32(intern("none"))
                nodes[p].a = i32(d)
            if pk == .plit:
                e = int(nodes[p].a)
                if dewy and is_union(st): continue
                if types[st].kind == .opt and nodes[e].kind == .none_lit:
                    finite_seen |= 2
                    arm_members.push(T_NONE)
                if st == T_BOOL and nodes[e].kind == .bool_lit:
                    finite_seen |= if nodes[e].ival != 0: 1 else: 2
                check_expr(e, st)
                coerce(e, st)
                if types[st].kind == .enum_ and nodes[e].kind == .dotname: seen[int(nodes[e].aux)] = true
                continue
            if pk == .prange:
                if not is_int(st): fatal(nodes[p].pos, "range patterns need an integer value")
                check_to(int(nodes[p].a), st)
                check_to(int(nodes[p].b), st)
                continue
            fatal(nodes[p].pos, "invalid pattern")
        if narrows:
            # match x: T: ...   x is a T in the arm (T, U: ... a T | U; _: the members not matched yet)
            if arm_wild:
                arm_members.clear()
                if types[st].kind == .opt:
                    if finite_before & 2 != 0 and finite_before & 1 == 0: arm_members.push(telem(st))
                else:
                    loop vi in 0.. and um in union_members(st):
                        if not seen_before[vi]: arm_members.push(um)
            narrow_local(int(nodes[sc].sym), arm_members, nodes[arm].pos)
        else if len(pkey) > 0:
            if arm_wild:
                arm_members.clear()
                if types[st].kind == .opt:
                    if finite_before & 2 != 0 and finite_before & 1 == 0: arm_members.push(telem(st))
                else:
                    loop vi in 0.. and um in union_members(st):
                        if not seen_before[vi]: arm_members.push(um)
            path_narrows += 1
            narrow_expr(copy_path(sc), arm_members, nodes[arm].pos, intern(pkey))
        body = int(nodes[arm].b)
        body_changes = narrow_changes.len()
        jumps = narrow_jumps.len()
        if is_stmt: check_block(body, 0, false)
        else:
            exp = expected
            if result != 0: exp = result
            # (one arm prints, another gives a number: as a function's last line, the match is
            # what it gives back)
            if result != 0 and tkind(result) == .void_ and (expected == 0 or tkind(expected) == .var): coerce_hint = " (an arm above gives no value, so this match gives none: where it ends a function, its arms are what the function gives back; `-> void` after the function's parameters says it gives back nothing)"
            t = check_block(body, exp, true)
            if t != T_NEVER:
                if nodes[body].aux == 0 and tkind(t) == .void_:
                    if result != 0 and tkind(result) != .void_ and expected != 0: fatal(nodes[arm].pos, "match arm has no value")
                    result = T_VOID
                else if result == 0:
                    result = t
                    first_val = body
                else:
                    vp = block_value(body)
                    if expected != 0: coerce(vp, expected)
                    else if first_val != 0: result = join_types(block_value(first_val), vp, nodes[arm].pos)
                    else: coerce(vp, result)
            coerce_hint = ""
        if narrow_changes.len() != body_changes: narrow_returned(body_changes, jumps, body)
        scope_reset(amark)
        loop l in narrow_restore(changes): changed.push(l)
    scope_reset(mark)
    narrow_merge(changed)
    exhaustive = has_wild or finite_seen == 3
    if not exhaustive and types[st].kind == .enum_:
        exhaustive = true
        loop s in seen:
            if not s: exhaustive = false
    nodes[m].aux2 = i32(int(exhaustive))
    # (an enum's or a union's match names each of its variants, or has `_:`; a statement too, so
    # that a state added later is not left out quietly)
    if is_stmt and (exhaustive or (not dewy and types[st].kind != .enum_)):
        nodes[m].type = i32(T_VOID)
        return T_VOID
    if not exhaustive:
        if types[st].kind == .enum_:
            miss = ""
            si = int(types[st].st)
            loop vi in 0.. and s in seen:
                if s: continue
                if len(miss) > 0: miss += ", "
                miss += ".{name_of(int(variants[int(structs[si].variants) + vi].name))}"
            fatal(nodes[m].pos, "this match has no arm for {miss} (add one, or a {jd(nodes[m].pos, "`_:`", "`_ => ...`")} arm for the rest)")
        if dewy: fatal(nodes[m].pos, "match is not exhaustive (add a `_ => ...` arm or `else`)")
        fatal(nodes[m].pos, "match expression is not exhaustive (add a `_:` arm)")
    if result == 0: result = T_NEVER
    if expected != 0 and result != T_NEVER:
        loop i in [0..nkids(m)):
            b = int(nodes[kid(m, i)].b)
            if nodes[b].aux != 0: coerce(block_value(b), expected)
        result = expected
    else:
        loop i in [0..nkids(m)):
            b = int(nodes[kid(m, i)].b)
            if nodes[b].aux != 0:
                finalize_literal(block_value(b))
                coerce(block_value(b), result)
    nodes[m].type = i32(result)
    result

# ---------------- lambdas ----------------
check_lambda = (lam: int, expected: int) -> int:
    if has_flag(lam, NF_GENERIC): return check_poly_lambda(lam, expected)
    et = callable_base(expected)
    if expected != 0 and types[et].kind != .fn_: et = 0
    if expected == 0: et = 0
    np = nkids(lam)
    if et != 0 and int(types[et].nargs) != np: fatal(nodes[lam].pos, "lambda has {np} parameter(s) but {types[et].nargs} are expected")
    f = new_inst(FK_LAMBDA, cur_mod(), "lambda")
    fns[f].decl = i32(lam)
    fns[f].has_env = true
    fns[f].body = nodes[lam].b
    old_formals = refine_formals
    old_self = refine_self
    if refine_active:
        refine_formals = []
        loop p in kids(lam): refine_formals.push(int(nodes[p].name))
    mm = 0
    pts: int[]
    loop i in [0..np):
        p = kid(lam, i)
        refine_self = int(nodes[p].name)
        pt = 0
        if nodes[p].a != 0:
            pt = resolve_type(int(nodes[p].a))
            if et != 0 and not unify(pt, targ(et, i)): fatal(nodes[p].pos, "parameter type {dt(pt)} does not match expected {dt(targ(et, i))}")
        else if et != 0: pt = targ(et, i)
        else:
            pn = name_of(int(nodes[p].name))
            if i == 0 and (pn == "self" or pn == "this"):
                fatal(nodes[p].pos, "structs have no methods: write the function at the top level (not inside the struct), taking what it works on first, as {jd(nodes[p].pos, "`move = (p: mut Player, dt: f64): ...`", "`move = (@p:Player dt:float64) => ...`")}; `p.move(dt)` calls it")
            if pn == "$partial": fatal(nodes[p].pos, "partial operator needs a function type; add a function-type annotation or pass it to a typed callback parameter")
            fatal(nodes[p].pos, "cannot infer the type of parameter '{pn}'; add a type annotation")
        if has_flag(p, NF_MUT): mm |= 1 << i
        if et != 0 and int(types[et].mutmask) & (1 << i) != 0:
            mm |= 1 << i
            add_flag(p, NF_MUT)
        pts.push(pt)
    refine_formals = old_formals
    refine_self = old_self
    fns[f].ptypes = pts
    ret_hint = 0
    if et != 0: ret_hint = int(types[et].elem)
    check_lambda_body(f, lam, ret_hint)
    zp: int[]
    loop t in fns[f].ptypes: zp.push(zonk(t))
    fns[f].ptypes = zp
    fns[f].ret = i32(zonk(int(fns[f].ret)))
    zonk_tree(int(fns[f].body))
    loop l in fns[f].locals: locals[l].type = i32(zonk(int(locals[l].type)))
    nodes[lam].sym = i32(f)
    t = mk_fn(zp, int(fns[f].ret), mm, if et != 0: int(types[et].st) else: decl_fn_labels(lam))
    if nodes[lam].sval != 0:
        t = mk_callable_contract(t, effect_decl_contract(lam, zp))
    nodes[lam].type = i32(t)
    if effects_active: t = effect_infer_callable(lam, expected)
    if callable_contract(expected) != 0 and not has_var(expected) and not effect_contract_fits(t, expected): fatal(nodes[lam].pos, "cannot prove callable effect contract")
    nodes[lam].type = i32(t)
    fns[f].fntype = i32(t)
    if nodes[lam].sval != 0:
        # The expression can be wrapped/rewritten by later conversions. Keep
        # the declaration immutable so final verification cannot lose its row.
        declaration = nodes.len()
        nodes.push(nodes[lam])
        fns[f].decl = i32(declaration)
    t

fn_value = (n: int, expected: int, explicit_types: int[] = [], mod: int = -1, closure: int = 0) -> int:
    decls: int[]
    if closure != 0: decls.push(poly_families[int(types[prune(ntype(closure))].st)].decl)
    else if mod >= 0: collect_module(mod, int(nodes[n].name), decls)
    else: collect_fns(int(nodes[n].name), decls)
    if mod < 0 and closure == 0 and nodes[n].name == i32(intern("to_int")) and dewy_at(nodes[n].pos):
        own = false
        loop d in decls:
            if not decl_in_prelude(d): own = true
        if not own:
            parser = intern("__mi_parse")
            demand_prelude_name(parser)
            decls = []
            collect_fns(parser, decls)
    et = callable_base(expected)
    if expected == 0: et = 0
    # Only inferred Dewy handles prefer a concrete program declaration.
    # Keep Jo implementation-library values and contextual overload matching
    # on their existing resolution path.
    if explicit_types.len() == 0 and files[pos_file(nodes[n].pos)].is_dewy and (et == 0 or (types[et].kind != .fn_ and types[et].kind != .cfn)):
        own: int[]
        loop d in decls:
            if not decl_in_prelude(d) and not fn_sig(d).generic: own.push(d)
        if own.len() == 1: decls = own
    f = 0
    selected = 0
    selected_binds: int[]
    loop d in decls:
        sig = fn_sig(d)
        if explicit_types.len() > 0 and explicit_types.len() != int(sig.nexplicit): continue
        binds = fill(0, int(sig.ntp))
        loop i in [0..explicit_types.len()): binds[i] = explicit_types[i]
        if et != 0 and (types[et].kind == .fn_ or types[et].kind == .cfn):
            if int(types[et].nargs) != nkids(d): continue
            ok = true
            loop i in [0..int(types[et].nargs)):
                r = match_type(sig.params[i], targ(et, i), binds, 0)
                if r < 0 or r == 1:
                    ok = false
                    break
            if not ok: continue
            # (type parameters only in the result: from the expected result, zero = () -> T)
            if sig.ret != 0 and types[et].kind == .fn_ and int(types[et].elem) != 0:
                rb = binds
                if match_type(int(sig.ret), int(types[et].elem), rb, 0) >= 0: binds = rb
            loop b in binds:
                if b == 0: ok = false
            loop i in [0..explicit_types.len()):
                if not type_eq(binds[i], explicit_types[i]): ok = false
            if not ok: continue
            f = get_fn_inst(d, binds, nodes[n].pos)
            break
        else if explicit_types.len() > 0:
            complete = true
            loop b in binds:
                if b == 0: complete = false
            if not complete: continue
            if selected != 0: fatal(nodes[n].pos, "multiple versions of '{name_of(int(nodes[n].name))}' match these type arguments; give the function value a callable type")
            selected = d
            selected_binds = binds
        else if not sig.generic and decls.len() == 1: f = get_fn_inst(d, [], nodes[n].pos)
    if selected != 0: f = get_fn_inst(selected, selected_binds, nodes[n].pos)
    if f == 0:
        if explicit_types.len() > 0: fatal(nodes[n].pos, "no version of '{name_of(int(nodes[n].name))}' matches these type arguments and callable type")
        if et != 0 and types[et].kind == .fn_:
            nm = name_of(int(nodes[n].name))
            hint = ""
            if nm == "update": hint = " (the game calls update each frame with the seconds since the last one: {jd(nodes[n].pos, "`update = (dt: f64): ...`", "`update = (dt:float64) => ...`")})"
            if nm == "draw": hint = " (the game calls draw with nothing: {jd(nodes[n].pos, "`draw = (): ...`", "`draw = () => ...`")})"
            fatal(nodes[n].pos, "no version of '{nm}' matches {dt(et)}{hint}")
        fatal(nodes[n].pos, "cannot use overloaded or generic function '{name_of(int(nodes[n].name))}' as a value without a known type{bare_variant_hint(int(nodes[n].name))}")
    mm = 0
    d = int(fns[f].decl)
    if d != 0: fn_used[d] = true
    loop i in [0..fns[f].ptypes.len()):
        if has_flag(kid(d, i), NF_MUT): mm |= 1 << i
    nodes[n].kind = .fnref
    nodes[n].sym = i32(f)
    if closure != 0:
        nodes[n].a = i32(closure)
        nodes[n].aux = 2
    t = mk_fn(fns[f].ptypes, int(fns[f].ret), mm, if et != 0 and types[et].kind == .fn_: int(types[et].st) else: decl_fn_labels(d))
    if et != 0 and types[et].kind == .cfn:
        if not fns[f].cabi: fatal(nodes[n].pos, "'{name_of(int(nodes[n].name))}' must be marked @cabi to be used as a C function pointer")
        t = mk_cfn(fns[f].ptypes, int(fns[f].ret))
        nodes[n].aux = 1
    if nodes[d].sval != 0: t = mk_callable_contract(t, effect_subst(int(fn_sig(d).contract), fns[f].targs))
    nodes[n].type = i32(t)
    if effects_active: t = effect_infer_callable(n, expected)
    if callable_contract(expected) != 0 and not has_var(expected) and not effect_contract_fits(t, expected): fatal(nodes[n].pos, "cannot prove callable effect contract")
    nodes[n].type = i32(t)
    t

# Dewy function names. A bare name calls its function; `@f` is the function
# itself, and `@f(args)` partially evaluates it.

# Whether a name or member read at n is a bare Dewy function use: not `@f`,
# not a callee, not an assignment target.
dewy_bare_fn = (n: int, is_callee: bool) -> bool:
    if is_callee or has_flag(n, NF_MUT) or n == assign_root: return false
    if nodes[n].kind == .ident:
        # A synthesized parameter copy or temporary.
        if nodes[n].aux2 == 1 or starts_with(name_of(int(nodes[n].name)), "$"): return false
    if cur_assign != 0 and int(nodes[cur_assign].a) == n: return false
    files[pos_file(nodes[n].pos)].is_dewy

# Inside a generic instance a local's type may be a function for this instance
# only; its bare name stays a value there.
in_generic_instance = () -> bool:
    c = cx
    loop c >= 0:
        inst = int(ctxs[c].inst)
        if inst > 0 and fns[inst].targs.len() > 0: return true
        c = int(ctxs[c].parent)
    false

is_fn_type = (t: int) -> bool:
    k = tkind(t)
    k == .fn_ or k == .cfn or k == .polyfn or k == .callable

# How a bare use of the visible functions `name` behaves: 0 when none can be
# called with no arguments, 1 when one can, 2 when that call makes a function.
bare_fns_call = (name: int, mod: int) -> int:
    decls: int[]
    if mod >= 0: collect_module(mod, name, decls)
    else: collect_fns(name, decls)
    loop d in decls:
        required = 0
        loop i in [0..nkids(d)):
            if nodes[kid(d, i)].b == 0: required += 1
        if required == 0:
            sig = fn_sig(d)
            return if sig.ret != 0 and is_fn_type(int(sig.ret)): 2 else: 1
    0

# `f` alone: the call f(), checked in place of n.
bare_call = (n: int, expected: int) -> int:
    callee = nodes.len()
    nodes.push(nodes[n])
    clear_flag(callee, NF_CHECKED)
    nodes[callee].type = 0
    nodes[n] = Node(kind = .call, pos = nodes[n].pos, a = i32(callee))
    t = check_expr(n, expected)
    last_checked = n
    t

bare_fn_error = (n: int, text: str, needs_args: bool):
    if needs_args: fatal(nodes[n].pos, "'{text}' needs arguments: call it, `{text}(...)`, or write `@{text}` for the function itself")
    fatal(nodes[n].pos, "'{text}' is a function: write `@{text}` for the function itself")

# A bare function-valued local, global or field of type t at n: called when it
# takes no arguments, otherwise an error naming `@`.
bare_fn_value = (n: int, t: int, text: str, expected: int) -> int:
    ft = callable_base(t)
    ex = prune(expected)
    takes_none = types[ft].kind != .polyfn and int(types[ft].nargs) == 0
    if expected != 0 and is_fn_type(ex) and not (takes_none and is_fn_type(int(types[ft].elem))): bare_fn_error(n, text, false)
    if not takes_none: bare_fn_error(n, text, true)
    bare_call(n, expected)

# A default that is the same whenever it is evaluated.
constant_default = (d: int) -> bool:
    k = nodes[d].kind
    k == .int_lit or k == .float_lit or k == .bool_lit or k == .none_lit or (k == .str_lit and nodes[d].aux == 0)

# `@f(args)`: the function of f's remaining parameters that calls f with args
# and them. The arguments are evaluated now. A parameter left to a constant
# default takes it now; other defaults cannot be left out yet.
dewy_partial = (n: int, expected: int) -> int:
    pos = nodes[n].pos
    callee = int(nodes[n].a)
    args = kids(n)
    # @sum(1)(2): each argument group in the chain is a partial evaluation.
    if nodes[callee].kind == .call and not has_flag(callee, NF_CHECKED): nodes[callee].aux2 = i32(AUX2_PARTIAL)
    mod = -1
    s = 0
    receiver = false
    if nodes[callee].kind == .ident: s = lookup(int(nodes[callee].name))
    else if nodes[callee].kind == .field:
        rt = prune(check_expr(int(nodes[callee].a), 0))
        nodes[callee].a = i32(last_checked)
        add_flag(last_checked, NF_CHECKED)
        if types[rt].kind == .module:
            mod = int(types[rt].mod)
            s = module_lookup(mod, int(nodes[callee].name))
        else:
            st = if types[rt].kind == .ptr: prune(int(types[rt].elem)) else: rt
            is_field = false
            if types[st].kind == .struct_:
                si = int(types[st].st)
                check_struct_fields(si)
                loop i in [0..int(structs[si].nfields)):
                    if fields[int(structs[si].fields) + i].name == nodes[callee].name: is_field = true
            if not is_field:
                # `@text.split(" ")`: the receiver is the first argument, saved with the rest
                recv = int(nodes[callee].a)
                fname = dewy_member_name(callee, rt, int(nodes[callee].name), args)
                s = lookup(fname)
                ii = intrinsic_of(fname)
                if s == 0 or syms[s].kind != .fns or (ii >= 0 and intrinsics[ii].arr): fatal(pos, "partial evaluation of the built-in `.{name_of(int(nodes[callee].name))}` is not supported yet; use a function literal")
                f = mk(.ident, nodes[callee].pos)
                nodes[f].name = i32(fname)
                callee = f
                nodes[n].a = i32(f)
                args = [recv] + args
                receiver = true
    holes: int[]
    fitting: int[]
    if s != 0 and syms[s].kind == .fns:
        decls: int[]
        if mod >= 0: collect_module(mod, int(nodes[callee].name), decls)
        else: collect_fns(int(nodes[callee].name), decls)
        # The one ordinary function of that name these arguments fit; the
        # program's own come before the prelude's.
        d = 0
        err = ""
        pnames: int[]
        slots: int[]
        own = false
        loop c in decls:
            if not decl_in_prelude(c): own = true
        # The versions of that name these arguments fit (the program's own before the
        # prelude's); the call with holes then picks one by the arguments' types, as a call does.
        # An expected function type says how many parameters stay open.
        if decls.len() > 1: check_args_untyped(args)
        open_wanted = if expected != 0 and tkind(expected) == .fn_: int(types[prune(expected)].nargs) else: -1
        # (else the versions leaving the fewest parameters open: those an ordinary call with these
        # arguments is nearest to)
        if open_wanted < 0 and decls.len() > 1:
            loop c in decls:
                if own and decl_in_prelude(c): continue
                names: int[]
                loop i in [0..nkids(c)): names.push(int(nodes[kid(c, i)].name))
                fit: int[]
                if len(map_args(names, fill(true, names.len()), args, fit)) > 0 or not partial_args_fit(c, fit): continue
                open = 0
                loop i in [0..names.len()):
                    if fit[i] == 0 and nodes[kid(c, i)].b == 0: open += 1
                if open_wanted < 0 or open < open_wanted: open_wanted = open
        loop c in decls:
            if own and decl_in_prelude(c): continue
            names: int[]
            loop i in [0..nkids(c)): names.push(int(nodes[kid(c, i)].name))
            fit: int[]
            e = map_args(names, fill(true, names.len()), args, fit)
            if len(e) > 0:
                err = e
                continue
            if decls.len() > 1 and not partial_args_fit(c, fit): continue
            if decls.len() > 1 and open_wanted >= 0:
                open = 0
                loop i in [0..names.len()):
                    if fit[i] == 0 and nodes[kid(c, i)].b == 0: open += 1
                if open != open_wanted: continue
                if expected != 0 and tkind(expected) == .fn_ and not partial_open_fit(c, fit, prune(expected)): continue
            if d != 0 and not same_partial_shape(d, pnames, slots, c, names, fit):
                fatal(pos, "partial evaluation of '{name_of(int(nodes[callee].name))}' is ambiguous: the versions these arguments fit leave different parameters open (give the result a function type, or use a function literal)")
            if receiver and nkids(c) > 0 and has_flag(kid(c, 0), NF_MUT): fatal(pos, "partial evaluation of `.{name_of(int(nodes[callee].name))}`, which changes its receiver, is not supported; use a function literal")
            fitting.push(c)
            if d == 0:
                d = c
                pnames = names
                slots = fit
        if d == 0:
            if len(err) > 0 and not receiver: fatal(pos, err)
            which = ""
            if receiver: which = " and this receiver"
            fatal(pos, "no version of '{name_of(int(nodes[callee].name))}' takes these arguments{which}")
        named = false
        skipped = false
        loop i in [0..pnames.len()):
            if slots[i] != 0: continue
            dv = int(nodes[kid(d, i)].b)
            if dv == 0:
                if skipped: named = true
                holes.push(i)
            else if constant_default(dv): skipped = true
            else: fatal(pos, "partial evaluation that leaves '{name_of(pnames[i])}' to its default is not supported yet: pass it explicitly")
        unbound = holes
        holes = []
        loop h in unbound:
            hole = mk(.hole, pos)
            if named:
                arg = mk(.namedarg, pos)
                nodes[arg].name = i32(pnames[h])
                nodes[arg].a = i32(hole)
                hole = arg
            holes.push(hole)
    else:
        if s != 0 and syms[s].kind != .local and syms[s].kind != .global: fatal(pos, "'{name_of(int(nodes[callee].name))}' is not a function")
        callee_at = callee
        ft = prune(check_expr(callee, 0))
        callee = last_checked
        nodes[n].a = i32(callee)
        add_flag(callee, NF_CHECKED)
        if types[ft].kind != .fn_: fatal(pos, "partial evaluation needs a function, found {dt(ft)}")
        loop i in [args.len()..int(types[ft].nargs)): holes.push(mk(.hole, pos))
    set_list(n, args + holes)
    nodes[n].aux2 = i32(AUX2_PARTIAL)
    t = 0
    if s != 0 and syms[s].kind == .fns and nodes[callee].kind == .ident:
        # (among the versions that fit, as a call would choose)
        t = resolve_fn_call(n, int(nodes[callee].name), fitting, kids(n), expected)
    else: t = check_call(n, expected)
    last_checked = n
    t

# (could the arguments given in slots go to version d's parameters, by their types?)
partial_args_fit = (d: int, slots: int[]) -> bool:
    sig = fn_sig(d)
    binds = fill(0, int(sig.ntp))
    loop i in 0.. and a in slots:
        if a == 0 or i >= sig.params.len() or ctx_dependent(a) or nodes[a].type == 0: continue
        if arg_cost(a, sig.params[i], binds) < 0: return false
    true

# (do version d's open parameters take the expected function type's, in order?)
partial_open_fit = (d: int, slots: int[], ft: int) -> bool:
    sig = fn_sig(d)
    binds = fill(0, int(sig.ntp))
    j = 0
    loop i in 0.. and a in slots:
        if a != 0 or nodes[kid(d, i)].b != 0: continue
        if j >= int(types[ft].nargs) or match_type(sig.params[i], targ(ft, j), binds, 0) < 0: return false
        j += 1
    true

# (do two versions leave the same parameters open, by position and name, with the same defaults?)
same_partial_shape = (d: int, names: int[], slots: int[], c: int, cnames: int[], cslots: int[]) -> bool:
    if names.len() != cnames.len(): return false
    loop i in [0..names.len()):
        if (slots[i] == 0) != (cslots[i] == 0): return false
        if slots[i] == 0 and (names[i] != cnames[i] or (nodes[kid(d, i)].b == 0) != (nodes[kid(c, i)].b == 0)): return false
    true

mk_ident_local = (l: int, pos: int) -> int:
    n = mk(.ident, pos)
    nodes[n].name = locals[l].name
    nodes[n].sym = i32(l)
    nodes[n].type = locals[l].type
    nodes[n].aux = i32(int(SK.local))
    add_flag(n, NF_CHECKED)
    n

# ---------------- main expression checker ----------------
check_expr = (n: int, expected: int) -> int:
    last_checked = n
    if nodes[n].type != 0 and has_flag(n, NF_CHECKED): return ntype(n)
    t = 0
    ex = prune(expected)
    if refine_active: ex = representation_type(ex)
    if expected == 0: ex = 0
    exk = TK.void_
    if ex != 0: exk = types[ex].kind
    if nodes[n].kind == .array: dewy_classify_spread(n)
    k = nodes[n].kind
    if k == .call and nodes[n].aux2 == -1:
        literal_target = ex
        if exk == .opt: literal_target = prune(int(types[ex].elem))
        if literal_target == 0 or literal_target == T_MATH_INT:
            nodes[n].aux2 = 0
            check_expr(n, 0)
            coerce(n, T_MATH_INT)
            last_checked = n
            return T_MATH_INT
        if literal_target == 0 or not bundled_bigint_type(literal_target):
            if literal_target != 0 and is_int(literal_target) and literal_target != T_MATH_INT:
                fatal(nodes[n].pos, "integer literal does not fit in {dt(literal_target)}")
            fatal(nodes[n].pos, "integer literal does not fit in int's interim int64 representation; use an explicit BigInt annotation")
        nodes[n].aux2 = 0
    if k == .array and exk == .opt and (tkind(int(types[ex].elem)) == .array or tkind(int(types[ex].elem)) == .fixed):
        ex = prune(int(types[ex].elem))
        exk = types[ex].kind
    if k == .propagate: return check_propagate(n, expected)
    if k == .unit_lit:
        return quantity_constant(n, nodes[n].ival, int(nodes[n].aux), int(nodes[n].aux2), expected)
    if k == .int_lit:
        add_flag(n, NF_LITERAL)
        nodes[n].type = i32(lit_default(n))
        if ex != 0 and exk == .int_:
            coerce(n, ex)
            t = ex
        else if ex != 0 and exk == .float_:
            coerce(n, ex)
            t = ex
        else if ex != 0 and exk == .opt and is_numeric(int(types[ex].elem)):
            coerce(n, prune(int(types[ex].elem)))
            t = ntype(n)
        else:
            t = lit_default(n)
    else if k == .float_lit:
        if ex != 0 and exk == .float_:
            if nodes[n].sval != 0 and nodes[n].fval - nodes[n].fval != 0.0: fatal(nodes[n].pos, "real literal exceeds float64")
            clear_flag(n, NF_LITERAL)
            t = ex
        else if ex != 0 and exk == .opt and is_float(int(types[ex].elem)):
            clear_flag(n, NF_LITERAL)
            t = prune(int(types[ex].elem))
        else:
            add_flag(n, NF_LITERAL)
            t = T_FLOAT
    else if k == .str_lit and has_flag(n, NF_CHARLIKE) and ex != 0 and is_int(ex):
        charlike_to_int(n)
        return check_expr(n, expected)
    else if k == .str_lit:
        if nodes[n].aux != 0:
            loop i in [0..nkids(n)):
                part = kid(n, i)
                if nodes[part].kind != .pair: continue
                e = int(nodes[part].a)
                # ("[0-9]{4}" for a regular expression: {4} puts the number 4 in the text)
                if (nodes[e].kind == .int_lit or (nodes[e].kind == .tuple and nkids(e) > 0 and nodes[kid(e, 0)].kind == .int_lit)) and not pos_in_lib(nodes[e].pos) and not files[pos_file(nodes[e].pos)].is_dewy and brace_before(nodes[e].pos):
                    warn(nodes[e].pos, "`\{...}` with a number in it puts that number in the text: for the characters themselves (a regular expression's repeat), write `\{\{4}}}}`, or a raw string `r\"[0-9]\{4}\"`")
                check_expr(e, 0)
                finalize_literal(e)
                fmt_part(part, nodes[part].pos)
        t = T_STR
    else if k == .bool_lit: t = T_BOOL
    else if k == .none_lit:
        if ex != 0 and exk == .opt: t = ex
        else: t = mk_opt(mk_var())
    else if k == .null_lit:
        if ex != 0 and (exk == .ptr or exk == .cfn): t = ex
        else: t = T_NULL
    else if k == .ident:
        nm = int(nodes[n].name)
        is_callee = n == callee_at
        if ide_sentinel != 0 and nm == ide_sentinel: ide_complete_names()
        s = lookup(nm)
        if s == 0:
            if ex != 0 and exk == .enum_:
                loop v in variant_names(ex):
                    if v == nm: fatal(nodes[n].pos, "unknown name '{name_of(nm)}' (the {dt(ex)} is written `.{name_of(nm)}`)")
            # (score += 1 with Score = 0 above: its capitals)
            capsug = suggestion(name_of(nm), visible_names())
            if find(capsug, "capital letters") >= 0: fatal(nodes[n].pos, "unknown name '{name_of(nm)}'{capsug}")
            if cur_assign != 0 and nodes[cur_assign].a == i32(n) and nodes[cur_assign].op != i32(int(Tok.assign)): fatal(nodes[n].pos, "unknown name '{name_of(nm)}' (to change it, it needs a value first: `{name_of(nm)} = 0`, at the top of the file to keep it from one frame to the next)")
            # (score = score + 1: the same, written out)
            if cur_assign != 0 and nodes[int(nodes[cur_assign].a)].kind == .ident and int(nodes[int(nodes[cur_assign].a)].name) == nm: fatal(nodes[n].pos, "unknown name '{name_of(nm)}' (to change it, it needs a value first: `{name_of(nm)} = 0`, at the top of the file to keep it from one frame to the next)")
            ph = phaser_hint(name_of(nm), member_after(nodes[n].pos, len(name_of(nm))))
            if len(ph) > 0: fatal(nodes[n].pos, "unknown name '{name_of(nm)}'{ph}")
            # (load_texture(cat1.png): a file's name, without its quotes)
            fx = file_ext_after(nodes[n].pos, len(name_of(nm)))
            if len(fx) > 0: fatal(nodes[n].pos, "{name_of(nm)}{fx} looks like a file's name: put it in quotes, `\"{name_of(nm)}{fx}\"`")
            # (as the name is written: macOS and Windows find lib/physics.jo for Physics too)
            if len(lib_root) > 0 and name_of(nm) == lower(name_of(nm)) and file_exists("{lib_root}/{name_of(nm)}.jo"): fatal(nodes[n].pos, "unknown name '{name_of(nm)}' (a module of the library: `import {name_of(nm)}` at the top of the file)")
            gl = gone_local_hint(nm, nodes[n].pos)
            if len(gl) > 0: fatal(nodes[n].pos, "unknown name '{name_of(nm)}'{gl}")
            uh = unused_file_hint(nm)
            if len(uh) > 0: fatal(nodes[n].pos, "unknown name '{name_of(nm)}'{uh}")
            sug = suggestion(name_of(nm), surface_names(visible_names(), nodes[n].pos))
            # (print(hello), window(Firefly, ...): words meant as text, a whole argument)
            if in_text_call(nodes[n].pos) and is_word_arg(nodes[n].pos, name_of(nm)) and not starts_with(sug, " (use "): fatal(nodes[n].pos, "unknown name '{name_of(nm)}' (text goes in quotes: `\"{name_of(nm)}\"`){sug}")
            if len(name_of(nm)) > 1:
                vh = bare_variant_hint(nm)
                if len(vh) > 0: fatal(nodes[n].pos, "unknown name '{name_of(nm)}'{vh}")
            # ("I have {i}plans": a tag as Ren'Py's, in braces that put a value in the text)
            if braced_alone(nodes[n].pos, len(name_of(nm))): fatal(nodes[n].pos, "unknown name '{name_of(nm)}': `\{{name_of(nm)}}` in a string puts in the value of {name_of(nm)}; for the braces in the text (a tag), write `\{\{{name_of(nm)}}}}}`, or make it a raw string, r\"...\"")
            fatal(nodes[n].pos, "unknown name '{name_of(nm)}'{private_hint(nm)}{sug}")
        sk = syms[s].kind
        if ide_on and sk != .fns: ide_sym_ref(n, s)
        nodes[n].aux = i32(int(sk))
        if sk == .local:
            l0 = int(syms[s].ref)
            # (assigned another type after being narrowed: the variable itself)
            loop int(locals[l0].flags) & LF_UNNARROWED != 0: l0 = narrowed_var(l0)
            l = 0
            if int(locals[l0].owner) != int(ctxs[cx].inst) and narrowed_var(l0) != 0: l = capture_narrowed(l0, nodes[n].pos)
            else: l = capture_local(l0)
            if n != assign_root:
                locals[l].flags = locals[l].flags | i32(LF_READ)
                locals[l0].flags = locals[l0].flags | i32(LF_READ)
            nodes[n].sym = i32(l)
            t = int(locals[l].type)
        else if sk == .global:
            g = int(syms[s].ref)
            ensure_global(g, nodes[n].pos)
            if globals[g].is_const and is_quantity(int(globals[g].type)):
                q = quantity_scales[quantity_constant_scale(int(globals[g].init))]
                hint = expected
                if nodes[int(globals[g].decl)].a != 0: hint = int(globals[g].type)
                return quantity_constant(n, q.numerator, q.denominator, quantity_dimension(int(globals[g].type)), hint)
            if n != assign_root:
                loop global_read.len() <= g: global_read.push(false)
                global_read[g] = true
            # (top-level code runs in order: above the line that sets it, a global is still zero)
            if globals[g].decl != 0 and nodes[int(globals[g].decl)].pos > nodes[n].pos and ctxs[cx].parent < 0 and fns[int(ctxs[cx].inst)].kind == FK_INIT and not test_mode:
                dp = nodes[int(globals[g].decl)].pos
                if pos_file(dp) == pos_file(nodes[n].pos) and not early_set.has(g):
                    # (set above its line, as `runs = 3` in a block before `runs = 0`: read after that)
                    if cur_assign != 0 and nodes[cur_assign].a == i32(n) and nodes[cur_assign].op == i32(int(Tok.assign)): early_set[g] = true
                    else:
                        ln, c = line_col(dp)
                        fatal(nodes[n].pos, "'{name_of(nm)}' is used before line {ln} gives it its value (the program runs from the top down)")
            nodes[n].sym = i32(g)
            t = int(globals[g].type)
            if path_narrows > 0 and n != no_narrow_at:
                al = path_alias(n)
                if al >= 0:
                    nodes[n] = nodes[mk_ident_local(al, nodes[n].pos)]
                    t = int(locals[al].type)
        else if sk == .const_:
            g = int(syms[s].ref)
            if globals[g].decl != 0: ensure_global(g, nodes[n].pos)
            v = clone(int(globals[g].init))
            p = nodes[n].pos
            nodes[n] = nodes[v]
            nodes[n].pos = p
            declared = globals[g].type != 0 and globals[g].decl != 0 and nodes[int(globals[g].decl)].a != 0 and not has_var(prune(int(globals[g].type)))
            check_expr(n, if declared: int(globals[g].type) else: expected)
            if declared: coerce(n, int(globals[g].type))
            last_checked = n
            return ntype(n)
        else if sk == .fns:
            fpos = nodes[n].pos
            if dewy_bare_fn(n, is_callee):
                ex_fn = expected != 0 and is_fn_type(ex)
                calls = bare_fns_call(nm, -1)
                if ex_fn and calls != 2: bare_fn_error(n, name_of(nm), false)
                if calls == 0: bare_fn_error(n, name_of(nm), true)
                return bare_call(n, expected)
            t = fn_value(n, expected)
            if ide_on: ide_fn_ref(fpos, nm, int(nodes[n].sym))
            last_checked = n
            return t
        else if sk == .struct_ or sk == .enum_:
            d = int(syms[s].ref)
            if nkids2(d) > 0: t = mk_typeval(0)
            else: t = mk_typeval(get_struct_inst(d, []))
        else if sk == .alias_:
            d = int(syms[s].ref)
            if nkids2(d) > 0: t = mk_typeval(0)
            else: t = mk_typeval(resolve_alias(d, [], nodes[n].pos))
        else if sk == .type_: t = mk_typeval(int(syms[s].ref))
        else if sk == .module: t = mk_modval(int(syms[s].ref))
        else if sk == .builtin: fatal(nodes[n].pos, "'{name_of(nm)}' must be called")
        else if sk == .reflected: fatal(nodes[n].pos, "field descriptors cannot escape into runtime storage; use .name or .type")
        else: fatal(nodes[n].pos, "invalid use of '{name_of(nm)}'")
        if (sk == .local or sk == .global) and is_fn_type(t) and dewy_bare_fn(n, is_callee) and not (sk == .local and in_generic_instance()): return bare_fn_value(n, t, name_of(nm), expected)
        if tkind(t) == .typeval:
            tt = telem(t)
            if nominal_parent.has(tt) and tt != error_type:
                si = int(types[tt].st)
                check_struct_fields(si)
                if structs[si].nfields == 0:
                    return struct_ctor(n, tt, int(structs[si].decl), [], expected)
    else if k == .field:
        if nodes[n].b != 0: reflect_name(n)
        if reflect_active and reflect_member(n): return ntype(n)
        a0 = int(nodes[n].a)
        is_callee = n == callee_at
        # (c.__peer in a program: a library's own field, which may change or go in any version)
        if starts_with(name_of(int(nodes[n].name)), "__") and not pos_in_lib(nodes[n].pos) and not ide_on:
            lt = prune(check_expr(a0, 0))
            nodes[n].a = i32(last_checked)
            a0 = last_checked
            add_flag(a0, NF_CHECKED)
            if types[lt].kind == .struct_:
                sd = int(structs[int(types[lt].st)].decl)
                if sd != 0 and pos_in_lib(nodes[sd].pos): warn(nodes[n].pos, "{name_of(int(nodes[n].name))} is {structs[int(types[lt].st)].name}'s own, inside the library: it may change or go in any version (if something here is missing, it is worth asking for)")
        sl = soa_alias_of(a0)
        if sl != 0:
            nodes[n] = nodes[soa_alias_field(n, sl)]
            return check_expr(n, expected)
        if nodes[a0].kind == .index and nodes[a0].b != 0:
            # ps[i].x on a soa array is ps.x[i]
            abt = prune(check_expr(int(nodes[a0].a), 0))
            nodes[a0].a = i32(last_checked)
            if is_soa(abt):
                f = mk(.field, nodes[n].pos)
                nodes[f].a = nodes[a0].a
                nodes[f].name = nodes[n].name
                nodes[n] = Node(kind = .index, pos = nodes[n].pos, a = i32(f), b = nodes[a0].b)
                return check_expr(n, expected)
        bt = prune(check_expr(int(nodes[n].a), 0))
        nodes[n].a = i32(last_checked)
        fname = int(nodes[n].name)
        if name_of(fname) == "add" and is_dewy_set_type(bt) and dewy_at(nodes[n].pos): fatal(nodes[n].pos, "sets insert with push: replace `.add(value)` with `.push(value)`")
        if synthetic_copy(bt, fname, nodes[n].pos): return check_copy(n, int(nodes[n].a), bt)
        if (is_union(bt) or tkind(bt) == .opt) and files[pos_file(nodes[n].pos)].is_dewy:
            return forward_member(n, int(nodes[n].a), bt, expected)
        if ide_sentinel != 0 and fname == ide_sentinel: ide_complete_members(bt)
        bk = types[bt].kind
        if name_of(fname) == "length" and (bk == .array or bk == .fixed or bk == .str_ or is_map_type(bt) or is_dewy_set_type(bt)) and files[pos_file(nodes[n].pos)].is_dewy:
            method = mk(.field, nodes[n].pos)
            nodes[method].a = nodes[n].a
            nodes[method].name = i32(intern("len"))
            nodes[n] = Node(kind = .call, pos = nodes[n].pos, a = i32(method))
            return check_expr(n, expected)
        if bk == .module:
            m = int(types[bt].mod)
            s = module_lookup(m, fname)
            qualifier = int(nodes[n].a)
            if nodes[qualifier].kind != .ident or name_of(int(nodes[qualifier].name))[0] != '$':
                if dewy_at(nodes[n].pos): rational_one_spelling(m, fname, nodes[n].pos, "")
            if s == 0:
                if name_of(fname) == "path" and not dewy_at(nodes[n].pos): fatal(nodes[n].pos, "paths are plain functions: `join_path(a, b)`, `file_name(p)`, `dir_name(p)`, `extension(p)`, `file_exists(p)`")
                fatal(nodes[n].pos, "module '{name_of(int(modules[m].name))}' has no member '{name_of(fname)}'")
            nodes[n] = Node(kind = .ident, pos = nodes[n].pos, name = i32(fname), flags = i32(int(nodes[n].flags) & NF_MUT))
            if is_callee: callee_at = n
            t = check_expr_in_module(n, m, expected)
            last_checked = n
            return t
        if bk == .typeval:
            tt = prune(int(types[bt].elem))
            if tt == ref_addr_type and (name_of(fname) == "min" or name_of(fname) == "max"):
                nodes[n] = nodes[bc_int((if name_of(fname) == "max": ref_addr_max() else: 0), nodes[n].pos)]
                return check_expr(n, T_INT)
            if tt == T_MATH_INT and (name_of(fname) == "min" or name_of(fname) == "max"):
                fatal(nodes[n].pos, "mathematical int has no min or max; int64 describes the interim storage limits")
            if tt != 0 and is_int(tt) and (name_of(fname) == "min" or name_of(fname) == "max"):
                if ide_on: ide_ref(nodes[n].pos, fname, IK_CONST, 0, tt, 0)
                bits = int(types[tt].bits)
                value = 0
                if name_of(fname) == "min":
                    if types[tt].sign: value = 1 << (bits - 1)
                    if types[tt].sign and bits < 64: value = -value
                else:
                    if bits == 64: value = -1
                    else: value = (1 << bits) - 1
                    if types[tt].sign: value = int(u64(value) >> 1)
                lit = mk(.int_lit, nodes[n].pos)
                nodes[lit].ival = value
                # Keep the bound's type when a constant/default is cloned and checked again.
                nodes[n] = Node(kind = .conv, pos = nodes[n].pos, a = i32(lit), aux = i32(int(CV.int_)), aux2 = 1, type = i32(tt))
                if not types[tt].sign and value < 0: add_flag(lit, NF_U64)
                check_expr(lit, tt)
                t = tt
            else if tt != 0 and types[tt].kind == .struct_ and not is_callee and dewy_type_method(int(structs[int(types[tt].st)].decl), fname) >= 0:
                # `Type.method`: a static method of no arguments is called by its name
                callee = mk(.field, nodes[n].pos)
                nodes[callee].a = nodes[n].a
                nodes[callee].name = i32(fname)
                nodes[n] = Node(kind = .call, pos = nodes[n].pos, a = i32(callee))
                return check_expr(n, expected)
            else if tt != 0 and types[tt].kind == .enum_:
                vi = find_variant(int(types[tt].st), fname)
                if vi < 0: fatal(nodes[n].pos, "{dt(tt)} has no variant '{name_of(fname)}'{variant_hint_for(tt, name_of(fname))}")
                if variants[int(structs[int(types[tt].st)].variants) + vi].nfields != 0: fatal(nodes[n].pos, "variant '{name_of(fname)}' needs arguments")
                if ide_on: ide_variant_ref(nodes[n].pos, fname, tt, vi)
                nodes[n].kind = .dotname
                nodes[n].aux = i32(vi)
                nodes[n].a = 0
                t = tt
            else:
                # (vec3.up, Vector3.zero: written out here)
                if tt != 0 and is_vec(tt):
                    vn = name_of(fname)
                    dims = vec_n(tt)
                    lit = ""
                    if vn == "zero": lit = "0"
                    else if vn == "one": lit = "1"
                    else if dims == 3:
                        if vn == "up": lit = "0, 1, 0"
                        else if vn == "down": lit = "0, -1, 0"
                        else if vn == "left": lit = "-1, 0, 0"
                        else if vn == "right": lit = "1, 0, 0"
                        else if vn == "forward": lit = "0, 0, -1"
                        else if vn == "back": lit = "0, 0, 1"
                    else if dims == 2:
                        if vn == "up": lit = "0, -1"
                        else if vn == "down": lit = "0, 1"
                        else if vn == "left": lit = "-1, 0"
                        else if vn == "right": lit = "1, 0"
                    if len(lit) > 0:
                        why = ""
                        if vn == "forward": why = " (forward is -z, the way a camera looks)"
                        if dims == 2 and (vn == "up" or vn == "down"): why = " (y goes down the screen)"
                        fatal(nodes[n].pos, "write it out: `{dt(tt)}({lit})`{why}")
                fatal(nodes[n].pos, "type has no member '{name_of(fname)}'")
        else if nodes[n].aux == -2:
            if bk != .tuple: fatal(nodes[n].pos, "'.{nodes[n].ival}' needs a tuple, found {dt(bt)}")
            if nodes[n].ival < 0 or nodes[n].ival >= int(types[bt].nargs): fatal(nodes[n].pos, "tuple index out of range")
            t = targ(bt, nodes[n].ival)
        else if bk == .vec:
            t = check_swizzle(n, bt)
            if ide_on: ide_ref(nodes[n].pos, fname, IK_FIELD, 0, t, 0)
        else:
            st = bt
            if bk == .ptr: st = prune(int(types[bt].elem))
            if types[st].kind == .struct_:
                si = int(types[st].st)
                check_struct_fields(si)
                fi = -1
                loop i in [0..int(structs[si].nfields)):
                    if int(fields[int(structs[si].fields) + i].name) == fname: fi = i
                if fi >= 0:
                    nodes[n].aux = i32(fi)
                    t = int(fields[int(structs[si].fields) + fi].type)
                    if ide_on: ide_field_ref(nodes[n].pos, fname, int(structs[si].decl), fi, t)
                    method = dewy_method_field(t)
                    if method != 0 and not is_callee:
                        text = "{receiver_text(int(nodes[n].a))}.{name_of(fname)}"
                        if not dewy_bare_fn(n, is_callee): fatal(nodes[n].pos, "'{text}' is a method, which is not a value yet: call it, `{text}()`")
                        loop i in [1..nkids(method)):
                            if nodes[kid(method, i)].b == 0: bare_fn_error(n, text, true)
                        add_flag(int(nodes[n].a), NF_CHECKED)
                        return bare_call(n, expected)
                    if is_fn_type(t) and dewy_bare_fn(n, is_callee):
                        add_flag(int(nodes[n].a), NF_CHECKED)
                        return bare_fn_value(n, t, "{receiver_text(int(nodes[n].a))}.{name_of(fname)}", expected)
                    if path_narrows > 0 and n != no_narrow_at and bk == .struct_:
                        al = path_alias(n)
                        if al >= 0:
                            nodes[n] = nodes[mk_ident_local(al, nodes[n].pos)]
                            t = int(locals[al].type)
            if t == 0:
                if bk == .opt:
                    et = prune(int(types[bt].elem))
                    has = false
                    if types[et].kind == .struct_:
                        esi = int(types[et].st)
                        check_struct_fields(esi)
                        loop i in [0..int(structs[esi].nfields)):
                            if int(fields[int(structs[esi].fields) + i].name) == fname: has = true
                    if has:
                        if files[pos_file(nodes[n].pos)].is_dewy:
                            fatal(nodes[n].pos, "this {dt(bt)} may be none (nothing), which has no {name_of(fname)}: check it with `is?none` before accessing the field")
                        fatal(nodes[n].pos, "this {dt(bt)} may be none (nothing), which has no {name_of(fname)}: `x!.{name_of(fname)}` when it cannot be none, or `if let v = x: v.{name_of(fname)}`")
                # (transform.position: a function's name, with a field after it)
                if tkind(bt) == .fn_:
                    bn = int(nodes[n].a)
                    fnn = ""
                    if nodes[bn].kind == .ident: fnn = name_of(int(nodes[bn].name))
                    else if nodes[bn].kind == .fnref and nodes[bn].sym > 0 and fns[int(nodes[bn].sym)].decl != 0: fnn = name_of(int(nodes[int(fns[int(nodes[bn].sym)].decl)].name))
                    if fnn == "transform": fatal(nodes[n].pos, "there are no GameObjects or transforms: where a thing is, is a field of your struct (`pos: vec3`), drawn with `draw_mesh(mesh, translation(pos))`")
                    if len(fnn) > 0: fatal(nodes[n].pos, "'{fnn}' is a function, which has no field '{name_of(fname)}': `{fnn}(...)` gives what it makes")
                # (b.velocity, b.position on a physics Body: a handle, asked of its world)
                if types[bt].kind == .struct_ and dt(bt) == "Body" and pos_in_lib(nodes[int(structs[int(types[bt].st)].decl)].pos):
                    fatal(nodes[n].pos, "a Body is a handle into its world: ask the world, `w.pos(b)`, `w.velocity(b)`, `w.rotation(b)`, and change it there, `w.set_pos(b, p)`, `w.set_velocity(b, v)`, `w.push(b, impulse)`")
                cands = fn_names_for(bt)
                loop c in cands:
                    if c != fname: continue
                    if files[pos_file(nodes[n].pos)].is_dewy:
                        # Zero-argument calls may omit their parentheses:
                        # `xs.pop` is `xs.pop()`. A field of that name wins.
                        if member_call_without_arguments(bt, fname):
                            add_flag(int(nodes[n].a), NF_MUT)
                            method = mk(.field, nodes[n].pos)
                            nodes[method].a = nodes[n].a
                            nodes[method].name = i32(fname)
                            nodes[n] = Node(kind = .call, pos = nodes[n].pos, a = i32(method), aux2 = -9)
                            return check_expr(n, expected)
                        fatal(nodes[n].pos, "'{name_of(fname)}' needs arguments: `{receiver_text(int(nodes[n].a))}.{name_of(fname)}(...)`")
                    fatal(nodes[n].pos, "'{name_of(fname)}' is a function: call it, `x.{name_of(fname)}()`")
                if types[bt].kind == .struct_:
                    si = int(types[bt].st)
                    loop i in [0..int(structs[si].nfields)): cands.push(int(fields[int(structs[si].fields) + i].name))
                if is_union(bt):
                    # (a field every member has, of one type: read from whichever it holds)
                    if not (cur_assign != 0 and int(nodes[cur_assign].a) == n):
                        uf = union_field(n, bt, fname)
                        if uf >= 0:
                            last_checked = n
                            return check_expr(n, expected)
                    fatal(nodes[n].pos, "{dt(bt)} has no field '{name_of(fname)}' (it is one of its members: find out which first, with {jd(nodes[n].pos, "`match x:` and an arm for each, or `if x is ...:`", "`match x \{ ... }` and an arm for each, or `if x is? ... \{ }`")})")
                if is_map_type(bt): fatal(nodes[n].pos, "{dt(bt)} has no field '{name_of(fname)}' (a map's entries are `m[\"{name_of(fname)}\"]`; for fields by name, make a struct)")
                # (an element of enemies = [] read before anything checked so far pushed one)
                loop g in open_globals:
                    gt = prune(int(globals[g].type))
                    if tkind(gt) == .array and prune(int(types[gt].elem)) == bt:
                        gn = name_of(int(globals[g].name))
                        et = pushed_type(gn)
                        if len(et) == 0: et = "Thing"
                        fatal(nodes[n].pos, "the type of what '{gn}' holds is not known here (it starts empty): write it where '{gn}' is made, as {jd(nodes[n].pos, "`{gn}: {et}[] = []`", "`let {gn}:array<{et}> = []`")}")
                fatal(nodes[n].pos, "{dt(bt)} has no field '{name_of(fname)}'{suggestion(name_of(fname), surface_names(cands, nodes[n].pos))}")
    else if k == .dotname:
        if ide_sentinel != 0 and int(nodes[n].name) == ide_sentinel: ide_complete_variants(ex)
        et = ex
        if et != 0 and exk == .opt: et = prune(int(types[et].elem))
        if et != 0: et = variant_enum(et, int(nodes[n].name))
        if et == 0 or types[et].kind != .enum_:
            vh = bare_variant_hint(int(nodes[n].name))
            if len(vh) > 0:
                # (screen = .title where nothing says it is a Screen: the enum's name says it)
                en = vh[find(vh, "else `") + 6..len(vh) - 2)
                fatal(nodes[n].pos, "which enum '.{name_of(int(nodes[n].name))}' belongs to is not known here: write `{en}`")
            fatal(nodes[n].pos, "cannot infer the enum type for '.{name_of(int(nodes[n].name))}'")
        vi = find_variant(int(types[et].st), int(nodes[n].name))
        if vi < 0: fatal(nodes[n].pos, "{dt(et)} has no variant '{name_of(int(nodes[n].name))}'{variant_hint_for(et, name_of(int(nodes[n].name)))}")
        if variants[int(structs[int(types[et].st)].variants) + vi].nfields != 0: fatal(nodes[n].pos, "variant '{name_of(int(nodes[n].name))}' needs arguments")
        if ide_on: ide_variant_ref(nodes[n].pos, int(nodes[n].name), et, vi)
        nodes[n].aux = i32(vi)
        t = et
    else if k == .call:
        if has_flag(n, NF_BROADCAST): return check_dotted(n, expected)
        if is_unchecked_at(n):
            # __at(xs, i) in the core library: xs[i] where the library knows i is in bounds
            args = kids(n)
            nodes[n].kind = .index
            nodes[n].a = i32(args[0])
            nodes[n].b = i32(args[1])
            add_flag(n, NF_INBOUNDS)
            return check_expr(n, expected)
        if nodes[n].aux2 == i32(AUX2_PARTIAL): return dewy_partial(n, expected)
        t = check_call(n, expected)
    else if k == .typeapply:
        is_callee = n == callee_at
        base = int(nodes[n].a)
        name = int(nodes[base].name)
        s = 0
        mod = -1
        if nodes[base].kind == .ident: s = lookup(name)
        else if nodes[base].kind == .field:
            mt = prune(check_expr(int(nodes[base].a), 0))
            if types[mt].kind == .module:
                mod = int(types[mt].mod)
                s = module_lookup(mod, name)
        if s != 0 and syms[s].kind == .fns and dewy_bare_fn(n, is_callee):
            calls = bare_fns_call(name, mod)
            if (expected != 0 and is_fn_type(ex) and calls != 2) or calls == 0: bare_fn_error(n, "{name_of(name)}<...>", calls == 0 and not (expected != 0 and is_fn_type(ex)))
            return bare_call(n, expected)
        if s != 0 and syms[s].kind == .fns:
            targs: int[]
            loop arg in kids(n): targs.push(effect_generic_argument(arg))
            nodes[n].name = i32(name)
            t = fn_value(n, expected, targs, mod)
            if ide_on: ide_fn_ref(nodes[base].pos, name, int(nodes[n].sym))
        else if (s != 0 and (syms[s].kind == .local or syms[s].kind == .global)) or (nodes[base].kind != .ident and mod < 0):
            if s != 0 and dewy_bare_fn(n, is_callee): fatal(nodes[n].pos, "'{name_of(name)}<...>' needs arguments: call it, or write `@{name_of(name)}<...>` for the function itself")
            callee_at = base
            check_expr(base, 0)
            if tkind(ntype(base)) != .polyfn: fatal(nodes[n].pos, "type arguments require a generic callable")
            targs: int[]
            loop arg in kids(n): targs.push(effect_generic_argument(arg))
            t = fn_value(n, expected, targs, closure = base)
        else: t = mk_typeval(resolve_type(int(nodes[n].c)))
    else if k == .index:
        if nodes[n].sval != 0:
            pos = nodes[n].pos
            name = "$index_source{bc_count}"
            bc_count += 1
            source = int(nodes[n].a)
            source_type = prune(check_expr(clone(source), 0))
            source_kind = types[source_type].kind
            stable = (source_kind == .array or source_kind == .str_ or source_kind == .fixed) and pool_update_read(last_checked) and dewy_end_arithmetic(int(nodes[n].b), int(nodes[n].sval))
            stmts: int[]
            end_source = clone(source)
            if not stable:
                stmts.push(bc_let(name, source, pos))
                end_source = bc_ident(name, pos)
                nodes[n].a = i32(bc_ident(name, pos))
            loop binding in dewy_index_end_bindings(n, end_source, source_type): stmts.push(binding)
            nodes[n].sval = 0
            ix = nodes.len()
            nodes.push(nodes[n])
            stmts.push(bc_stmt(ix, pos))
            nodes[n] = nodes[bc_block(stmts, pos)]
            return check_expr(n, expected)
        bt = prune(check_expr(int(nodes[n].a), 0))
        nodes[n].a = i32(last_checked)
        dewy_index_ranges(n, bt)
        bk = types[bt].kind
        b = int(nodes[n].b)
        if b != 0 and nodes[b].kind == .range and has_flag(b, NF_STEP) and not is_nd(bt):
            if bk != .array and bk != .fixed and not is_nd(bt): fatal(nodes[n].pos, "stepped slicing requires an array")
            nodes[n].a = i32(last_checked)
            call = dewy_array_slice(n)
            nodes[n] = nodes[call]
            return check_expr(n, expected)
        if bk == .str_ and files[pos_file(nodes[n].pos)].is_dewy:
            base = last_checked
            add_flag(base, NF_CHECKED)
            pos = nodes[n].pos
            call = 0
            if b != 0 and nodes[b].kind == .range:
                lo = int(nodes[b].a)
                hi = int(nodes[b].b)
                has_stop = hi != 0
                if lo == 0: lo = mk(.int_lit, pos)
                if hi == 0: hi = mk(.int_lit, pos)
                incl = mk(.bool_lit, pos)
                nodes[incl].ival = if has_flag(b, NF_INCLUSIVE): 1 else: 0
                stop = mk(.bool_lit, pos)
                nodes[stop].ival = if has_stop: 1 else: 0
                call = bc_call("__dewy_string_slice", [base, lo, hi, incl, stop], pos)
            else:
                if b == 0: fatal(pos, "invalid string index")
                call = bc_call("__dewy_string_index", [base, b], pos)
            nodes[n] = nodes[call]
            return check_expr(n, expected)
        if bk == .typeval and files[pos_file(nodes[n].pos)].is_dewy:
            # Checking a qualified type replaces its field node with a resolved
            # identifier. Use that resolved type rather than looking up its bare
            # name again in the caller's module.
            target = prune(telem(bt))
            nodes[n].kind = .call
            nodes[n].b = 0
            if target != 0 and types[target].kind == .struct_:
                t = struct_ctor(n, target, int(structs[int(types[target].st)].decl), kids(n), expected)
                nodes[n].type = i32(t)
                add_flag(n, NF_CHECKED)
                last_checked = n
                return t
            return check_expr(n, expected)
        if bk == .tuple and files[pos_file(nodes[n].pos)].is_dewy:
            if b == 0 or nodes[b].kind != .int_lit: fatal(nodes[n].pos, "a tuple index must be an integer literal")
            nodes[n].kind = .field
            nodes[n].aux = -2
            nodes[n].ival = nodes[b].ival
            nodes[n].b = 0
            set_list(n, [])
            return check_expr(n, expected)
        if bk == .typeval: t = mk_typeval(expr_as_type(n))
        else if b != 0 and nodes[b].kind != .range and is_soa(bt): return check_soa_index(n, expected)
        else if bk == .struct_ and is_part_index(n, bt):
            # m[i, ..], m[1..2, 0..]: a part of an n-dimensional array
            call = bc_call("__nd_slice", [int(nodes[n].a), part_spec(n)], nodes[n].pos)
            add_flag(int(nodes[n].a), NF_CHECKED)
            nodes[n] = nodes[call]
            t = check_expr(n, expected)
            last_checked = n
            return t
        else if b != 0 and nodes[b].kind == .range:
            if nodes[b].a != 0:
                check_to(int(nodes[b].a), T_INT)
                neg_index_check(int(nodes[b].a))
            if nodes[b].b != 0:
                check_to(int(nodes[b].b), T_INT)
                neg_index_check(int(nodes[b].b))
            nodes[b].type = i32(T_RANGE)
            if bk != .array and bk != .fixed and bk != .str_: fatal(nodes[n].pos, "cannot slice {dt(bt)}")
            nodes[n].aux = 1
            t = bt
            if bk == .fixed: t = mk_array(int(types[bt].elem))
        else if b == 0 and nkids(n) > 0 and bk == .struct_:
            # m[i, j]: the `[]` operator with several indexes
            call = mk(.call, nodes[n].pos)
            callee = mk(.ident, nodes[n].pos)
            nodes[callee].name = i32(intern("[]"))
            nodes[call].a = i32(callee)
            add_flag(int(nodes[n].a), NF_CHECKED)
            set_list(call, [int(nodes[n].a)] + kids(n))
            if has_flag(n, NF_MUT): add_flag(call, NF_MUT)
            nodes[n] = nodes[call]
            t = check_expr(n, expected)
            last_checked = n
            return t
        else:
            if b == 0: fatal(nodes[n].pos, "invalid index")
            if (bk == .array or bk == .str_) and nodes[b].kind == .int_lit: neg_index_check(b)
            if bk == .array or bk == .fixed:
                pick = index_array_fn(b, "__pick")
                if len(pick) > 0:
                    # xs[mask], xs[idxs]: the elements picked, as an array
                    call = dewy_array_selection_call(pick, [int(nodes[n].a), b], bt, nodes[n].pos)
                    add_flag(int(nodes[n].a), NF_CHECKED)
                    nodes[n] = nodes[call]
                    t = check_expr(n, expected)
                    last_checked = n
                    return t
                check_to(b, T_INT)
                t = int(types[bt].elem)
                ib = int(nodes[n].b)
                if bk == .fixed and nodes[ib].kind == .int_lit and (nodes[ib].ival < 0 or nodes[ib].ival >= fixed_len(bt)): fatal(nodes[ib].pos, "index {nodes[ib].ival} is out of bounds for {dt(bt)}")
            else if bk == .str_:
                check_to(b, T_INT)
                t = T_U8
            else if bk == .ptr:
                check_to(b, T_INT)
                t = int(types[bt].elem)
            else if bk == .vec:
                check_to(b, T_INT)
                if bt == T_MAT4: t = T_VEC4
                else: t = vec_comp_type(bt)
            else if bk == .struct_:
                call = mk(.call, nodes[n].pos)
                callee = mk(.ident, nodes[n].pos)
                nodes[callee].name = i32(intern("[]"))
                nodes[call].a = i32(callee)
                add_flag(int(nodes[n].a), NF_CHECKED)
                set_list(call, [int(nodes[n].a), b])
                if has_flag(n, NF_MUT): add_flag(call, NF_MUT)
                nodes[n] = nodes[call]
                t = check_expr(n, expected)
                last_checked = n
                return t
            else:
                if tkind(bt) == .tuple: fatal(nodes[n].pos, "a tuple's parts are `t.0`, `t.1` (an index in brackets is for arrays)")
                fatal(nodes[n].pos, "cannot index a value of type {dt(bt)}")
    else if k == .unary:
        if has_flag(n, NF_BROADCAST): return check_dotted(n, expected)
        hint = 0
        if ex != 0 and (is_numeric(ex) or is_vec(ex) or bundled_bigint_type(ex)): hint = ex
        at = prune(check_expr(int(nodes[n].a), hint))
        if types[at].kind == .quantity: return quantity_unary(n, expected)
        if nodes[n].op == i32(int(Tok.minus)):
            if is_struct_like(at):
                r = op_overload(n, "-")
                if r != 0:
                    last_checked = n
                    return r
            if not is_numeric(at) and not is_vec(at): fatal(nodes[n].pos, "cannot negate {dt(at)}")
            a = int(nodes[n].a)
            if is_lit(a):
                # fold -literal into a literal (keeps it untyped, e.g. -PI or -1)
                if nodes[a].kind == .int_lit:
                    if lit_default(n) == T_MATH_INT and not has_flag(a, NF_U64) and nodes[a].ival == -9223372036854775807 - 1:
                        coerce(a, T_MATH_INT)
                        nodes[n].type = i32(T_MATH_INT)
                        return T_MATH_INT
                    nodes[n] = Node(kind = .int_lit, pos = nodes[n].pos, ival = -nodes[a].ival, flags = i32(NF_LITERAL | NF_CHECKED), type = nodes[a].type)
                    last_checked = n
                    return ntype(n)
                if nodes[a].kind == .float_lit:
                    nodes[n] = Node(kind = .float_lit, pos = nodes[n].pos, fval = -nodes[a].fval, flags = i32(NF_LITERAL | NF_CHECKED), type = nodes[a].type)
                    last_checked = n
                    return ntype(n)
                add_flag(n, NF_LITERAL)
        else if nodes[n].op == i32(int(Tok.tilde)):
            if not is_int(at): fatal(nodes[n].pos, "'~' needs an integer")
        else if nodes[n].op == i32(int(Tok.plus)):
            if not is_numeric(at) and not is_vec(at): fatal(nodes[n].pos, "unary '+' needs a number")
        t = at
    else if k == .binary: t = check_binary(n, expected)
    else if k == .and_ or k == .or_:
        # on integers, and/or are bitwise
        h = 0
        if ex != 0 and is_int(ex): h = ex
        ta = prune(check_expr(int(nodes[n].a), h))
        nodes[n].a = i32(last_checked)
        if is_struct_like(ta):
            check_expr(int(nodes[n].b), 0)
            nodes[n].b = i32(last_checked)
            r = op_overload(n, if k == .and_: "&" else: "|")
            if r != 0:
                last_checked = n
                return r
        if is_int(ta):
            add_flag(int(nodes[n].a), NF_CHECKED)
            nodes[n].kind = .binary
            if k == .and_: nodes[n].op = i32(int(Tok.amp))
            else: nodes[n].op = i32(int(Tok.pipe))
            return check_expr(n, expected)
        nodes[n].a = i32(coerce(int(nodes[n].a), T_BOOL))
        # x is T and f(x): x is a T on the right
        mark = scope_mark()
        narrow_by(int(nodes[n].a), k == .and_)
        check_to(int(nodes[n].b), T_BOOL)
        scope_reset(mark)
        t = T_BOOL
    else if k == .istype: t = check_istype(n)
    else if k == .not_:
        h = 0
        if ex != 0 and is_int(ex): h = ex
        ta = prune(check_expr(int(nodes[n].a), h))
        nodes[n].a = i32(last_checked)
        if is_struct_like(ta):
            r = op_overload(n, "~")
            if r != 0:
                last_checked = n
                return r
        if is_int(ta):
            add_flag(int(nodes[n].a), NF_CHECKED)
            nodes[n].kind = .unary
            nodes[n].op = i32(int(Tok.tilde))
            return check_expr(n, expected)
        # (not mask: each element's, as NumPy's ~mask)
        if (types[ta].kind == .array and prune(int(types[ta].elem)) == T_BOOL) or (is_nd(ta) and prune(nd_elem(ta)) == T_BOOL):
            add_flag(int(nodes[n].a), NF_CHECKED)
            c = bc_call("__not", [int(nodes[n].a)], nodes[n].pos)
            add_flag(c, NF_BROADCAST)
            nodes[n] = nodes[c]
            return check_expr(n, expected)
        nodes[n].a = i32(coerce(int(nodes[n].a), T_BOOL))
        t = T_BOOL
    else if k == .coalesce:
        h = 0
        if ex != 0:
            if exk == .opt: h = ex
            else: h = mk_opt(ex)
        at = prune(check_expr(int(nodes[n].a), h))
        if types[at].kind != .opt:
            nodes[n].a = i32(narrow_optional_source(int(nodes[n].a)))
            at = prune(ntype(int(nodes[n].a)))
        if types[at].kind != .opt:
            lhs = int(nodes[n].a)
            # (an index into a map has become a call by now; its position is still the '[')
            lp = int(nodes[lhs].pos)
            lf = pos_file(lp)
            if lf >= 0 and lf < files.len() and pos_off(lp) < len(files[lf].src) and files[lf].src[pos_off(lp)] == '[':
                fatal(nodes[n].pos, "'??' needs an optional on the left, found {dt(at)} (indexing gives the element itself; m.get(k) gives an optional, m.get(k, default) a value)")
            fatal(nodes[n].pos, "'??' needs an optional on the left, found {dt(at)}")
        inner = int(types[at].elem)
        h2 = inner
        if ex != 0: h2 = ex
        btt = prune(check_expr(int(nodes[n].b), h2))
        if types[btt].kind == .opt:
            coerce(int(nodes[n].b), at)
            t = at
            nodes[n].aux = 1
        else:
            coerce(int(nodes[n].b), inner)
            t = inner
    else if k == .unwrap:
        h = 0
        if ex != 0: h = mk_opt(ex)
        at = prune(check_expr(int(nodes[n].a), h))
        if types[at].kind != .opt:
            nodes[n].a = i32(narrow_optional_source(int(nodes[n].a)))
            at = prune(ntype(int(nodes[n].a)))
        if types[at].kind != .opt: fatal(nodes[n].pos, "'!' needs an optional value, found {dt(at)}")
        t = int(types[at].elem)
    else if k == .lambda: t = check_lambda(n, expected)
    else if k == .array and has_flag(n, NF_TYPE_EXPR):
        # (thorns = Rect[]: an empty array of Rects is declared with a colon)
        vn = name_before_eq(nodes[n].pos)
        if len(vn) > 0:
            tt = "Rect[]"
            if nkids(n) == 1 and nodes[kid(n, 0)].kind == .ident: tt = "{name_of(int(nodes[kid(n, 0)].name))}[]"
            fatal(nodes[n].pos, "an empty array of a type is written with a colon: {jd(nodes[n].pos, "`{vn}: {tt}`", "`let {vn}:{tt} = []`")} (`=` gives a value, `:` a type)")
        fatal(nodes[n].pos, "this is a type (an array of that); a value is needed here (an empty array: [])")
    else if k == .array and nodes[n].b == 0 and array_has_spread(n):
        # [a... b c...] builds the array: t = []; t.extend(a); t.push(b); t.extend(c); t
        spread_count += 1
        # Internal bindings must not shadow an operand's user-written name.
        acc = intern("$spread{spread_count}")
        pos = nodes[n].pos
        stmts: int[]
        d = mk(.vardecl, pos)
        nodes[d].name = i32(acc)
        nodes[d].b = i32(mk(.array, pos))
        if ex != 0 and exk == .array: nodes[d].a = i32(type_node_of(ex, pos))
        if ex != 0 and exk == .fixed: nodes[d].a = i32(type_node_of(mk_array(int(types[ex].elem)), pos))
        stmts.push(d)
        loop i in [0..nkids(n)):
            c = kid(n, i)
            callee = mk(.field, pos)
            nodes[callee].a = i32(mk_name(acc, pos))
            if has_flag(c, NF_SPREAD):
                clear_flag(c, NF_SPREAD)
                nodes[callee].name = i32(intern("extend"))
            else: nodes[callee].name = i32(intern("push"))
            call = mk(.call, pos)
            nodes[call].a = i32(callee)
            set_list(call, [c])
            st = mk(.exprstmt, pos)
            nodes[st].a = i32(call)
            stmts.push(st)
        r = mk(.exprstmt, pos)
        nodes[r].a = i32(mk_name(acc, pos))
        stmts.push(r)
        b = mk(.block, pos)
        set_list(b, stmts)
        nodes[n] = nodes[b]
        return check_expr(n, expected)
    else if k == .record_loop:
        reflect_record(n)
        return check_expr(n, expected)
    else if k == .record_lit:
        loop entry in kids(n):
            if nodes[entry].kind == .namedarg: reflect_name(entry)
        if array_has_spread(n):
            stmts: int[]
            members = dewy_record_spread_entries(n, expected, stmts, true)
            result = mk(.record_lit, nodes[n].pos)
            set_list(result, members)
            stmts.push(bc_stmt(result, nodes[n].pos))
            nodes[n] = nodes[bc_block(stmts, nodes[n].pos)]
            return check_expr(n, expected)
        target = ex
        if exk == .opt: target = prune(int(types[ex].elem))
        if target == 0 or types[target].kind == .var or types[target].kind == .param:
            target = dewy_record_type(n)
        if types[target].kind != .struct_ or is_map_type(target): fatal(nodes[n].pos, "record literal needs a record type, found {dt(target)}")
        t = struct_ctor(n, target, int(structs[int(types[target].st)].decl), kids(n), expected)
    else if k == .array and nkids(n) == 0 and nodes[n].b == 0 and dewy_record_target(ex) != 0 and files[pos_file(nodes[n].pos)].is_dewy:
        target = dewy_record_target(ex)
        t = struct_ctor(n, target, int(structs[int(types[target].st)].decl), [], expected)
    else if k == .array and nodes[n].b == 0 and dewy_positional_record(n, ex) != 0:
        # [3 4] where a Dewy object type is expected: its fields in declaration order, as the
        # constructor call Point(3 4) takes them
        target = dewy_positional_record(n, ex)
        t = struct_ctor(n, target, int(structs[int(types[target].st)].decl), kids(n), expected)
    else if k == .array and ex != 0 and exk == .fixed and fixed_literal_ok(n, ex):
        # [a, b, c] (or [] for zeros, or [v] * N) as a fixed-size array
        et = int(types[ex].elem)
        if nodes[n].b != 0:
            check_expr(kid(n, 0), et)
            check_to(int(nodes[n].b), T_INT)
        else:
            loop i in [0..nkids(n)): check_expr(kid(n, i), et)
        nodes[n].type = i32(mk_array(et))
        fixed_literal(n, ex)
        t = ex
    else if k == .array:
        if nkids(n) == 0 and ex != 0 and is_map_type(ex) and files[pos_file(nodes[n].pos)].is_dewy:
            nodes[n].kind = .map_lit
            return check_expr(n, expected)
        et = 0
        if ex != 0 and exk == .array: et = int(types[ex].elem)
        if nodes[n].b != 0:
            v = kid(n, 0)
            vt = check_expr(v, et)
            if et != 0: coerce(v, et)
            else: vt = finalize_literal(v)
            check_to(int(nodes[n].b), T_INT)
            if et != 0: t = mk_array(et)
            else: t = mk_array(vt)
            nodes[n].aux = 1
        else if nkids(n) == 0:
            if ex != 0 and exk == .array: t = ex
            else: t = mk_array(mk_var())
        else:
            # spread elements (xs...) bring their arrays' elements
            elt = et
            # (a generic parameter's T, not known yet: the elements say what it is)
            if elt != 0 and tkind(prune(elt)) == .var: elt = 0
            anyfloat = false
            decimal = 0
            anyunsigned = false
            allchar = true
            spread = false
            loop i in [0..nkids(n)):
                c = kid(n, i)
                if has_flag(c, NF_SPREAD):
                    spread = true
                    h = 0
                    if elt != 0: h = mk_array(elt)
                    st = prune(check_expr(c, h))
                    if types[st].kind != .array: fatal(nodes[c].pos, "only arrays can be spread into an array (found {dt(st)})")
                    if elt == 0: elt = int(types[st].elem)
                    allchar = false
                    continue
                it = check_expr(c, elt)
                if not charlike(c): allchar = false
                if is_lit(c):
                    if nodes[c].kind == .float_lit: anyfloat = true
                    if nodes[c].kind == .float_lit and nodes[c].sval != 0: decimal = c
                    if lit_default(c) == T_U64: anyunsigned = true
                    # ([Kind.a, .b]: the first names the enum for the rest)
                    if elt == 0 and it != 0 and tkind(it) == .enum_: elt = it
                else if elt == 0 and not charlike(c): elt = it
            if elt == 0:
                if allchar: elt = T_STR
                else if decimal != 0: elt = lit_default(decimal)
                else if anyfloat: elt = T_FLOAT
                else if anyunsigned: elt = T_U64
                else: elt = if files[pos_file(nodes[n].pos)].is_dewy: T_MATH_INT else: T_INT
            # ([1, "two", 3]: an array holds one kind of value)
            coerce_hint = jd(nodes[n].pos, " (an array holds one kind of value, here {dt(elt)}; for values of several kinds, make a struct or a union)", " (an array holds one kind of value, here {dt(elt)}; for values of several kinds, use a record type or a union such as `array<int64|string>`)")
            loop i in [0..nkids(n)):
                c = kid(n, i)
                if has_flag(c, NF_SPREAD): coerce(c, mk_array(elt))
                else: coerce(c, elt)
            coerce_hint = ""
            if spread: nodes[n].aux = 2
            if et != 0 and tkind(prune(et)) != .var: t = ex
            else: t = mk_array(elt)
    else if k == .map_lit:
        # ({x: 1, y: 2}: JavaScript's object, with names the program does not have)
        loop i in [0..nkids(n)):
            key = int(nodes[kid(n, i)].a)
            if nodes[key].kind == .ident and lookup(int(nodes[key].name)) == 0:
                kn = name_of(int(nodes[key].name))
                fatal(nodes[key].pos, "unknown name '{kn}' (a map's keys are values: `\{\"{kn}\": ...}`; for named fields, declare `struct Name:` with them and make one with `Name({kn} = ...)`)")
        ms = prelude.get(intern("Map")) ?? 0
        if ms == 0: fatal(nodes[n].pos, "Map is not available")
        md = int(syms[ms].ref)
        kt = 0
        vt = 0
        if ex != 0 and exk == .struct_ and int(structs[int(types[ex].st)].decl) == md:
            kt = struct_targ(int(types[ex].st), 0)
            vt = struct_targ(int(types[ex].st), 1)
        if kt == 0:
            if nkids(n) == 0: fatal(nodes[n].pos, "cannot infer the type of an empty map; add a type annotation: {jd(nodes[n].pos, "`m: \{K: V} = \{}`", "`let m:dict<K V> = []`")}")
            p0 = kid(n, 0)
            check_expr(int(nodes[p0].a), 0)
            kt = finalize_literal(int(nodes[p0].a))
            check_expr(int(nodes[p0].b), 0)
            vt = finalize_literal(int(nodes[p0].b))
        loop i in [0..nkids(n)):
            p = kid(n, i)
            check_to(int(nodes[p].a), kt)
            vb = int(nodes[p].b)
            # ({"name": "Drone", "cost": 10.0}: JavaScript's object, values of several types)
            if i > 0 and ex == 0:
                bt = prune(check_expr(vb, vt))
                if not type_eq(bt, prune(vt)) and not can_coerce(vb, bt, vt): fatal(nodes[vb].pos, "a map's values are all of one type, and the first is {a_type(vt)}, this {a_type(bt)}: for a record with named fields of their own types, declare {jd(nodes[vb].pos, "`struct Name:`", "`Name:type = [field:T ...]`")} with them")
                coerce(vb, vt)
            else: check_to(vb, vt)
        t = get_struct_inst(md, [kt, vt])
        if nkids(n) > 0: nodes[n].sym = i32(resolve_by_types(intern("[]="), [t, kt, vt], nodes[n].pos, true))
    else if k == .tuple:
        if nkids(n) == 0: t = T_VOID
        else:
            el: int[]
            loop i in [0..nkids(n)):
                c = kid(n, i)
                e = 0
                if ex != 0 and exk == .tuple and int(types[ex].nargs) == nkids(n): e = targ(ex, i)
                check_expr(c, e)
                if e != 0: coerce(c, e)
                else: finalize_literal(c)
                el.push(ntype(c))
            t = mk_tuple(el)
    else if k == .if_: t = check_if(n, ex)
    else if k == .iflet: t = check_iflet(n, ex)
    else if k == .match_: t = check_match(n, expected)
    else if k == .cast:
        a = int(nodes[n].a)
        tt = prune(resolve_type(int(nodes[n].b)))
        if nodes[n].aux2 == 1:
            # The written source type determines its bits. In particular the
            # destination must not coerce a literal before reinterpretation.
            check_expr(a, 0)
            a = last_checked
            nodes[n].a = i32(a)
            finalize_literal(a)
            ft = prune(ntype(a))
            if is_quantity(ft) or is_quantity(tt):
                return quantity_transmute(n, a, ft, tt)
            if ft == T_MATH_INT or tt == T_MATH_INT: fatal(nodes[n].pos, "transmute requires an explicit fixed-width type; mathematical int has no fixed bit representation")
            if not is_numeric(ft) or not is_numeric(tt) or tsize(ft) != tsize(tt):
                fatal(nodes[n].pos, "transmute needs integer or float values of equal width (found {dt(ft)} to {dt(tt)})")
            nodes[n].type = i32(tt)
            add_flag(n, NF_CHECKED)
            last_checked = n
            return tt
        if types[tt].kind == .refined:
            check_expr(a, int(types[tt].elem))
            nodes[n] = nodes[last_checked]
            refine_coerce(n, tt)
            last_checked = n
            return ntype(n)
        ak = nodes[a].kind
        if ak == .array or ak == .map_lit or ak == .tuple or ((ak == .int_lit or ak == .float_lit) and (is_numeric(tt))):
            # `[1, 2] as [u8]`, `0.5 as f32`: the target type guides the literal
            check_expr(a, tt)
            if can_coerce(a, ntype(a), tt):
                coerce(a, tt)
                nodes[n] = nodes[a]
                last_checked = n
                return tt
        check_expr(a, 0)
        finalize_literal(a)
        ft = prune(ntype(a))
        if has_var(ft) and unify(ft, tt):
            nodes[n] = nodes[a]
            last_checked = n
            return tt
        if type_eq(ft, tt):
            nodes[n] = nodes[a]
            last_checked = n
            return tt
        fk = types[ft].kind
        tk = types[tt].kind
        if fk == .quantity or tk == .quantity:
            coerce(a, tt)
            nodes[n] = nodes[a]
            last_checked = n
            return ntype(n)
        if ((fk == .array and tk == .fixed) or (fk == .fixed and tk == .array)) and can_coerce(a, ft, tt):
            coerce(a, tt)
            nodes[n] = nodes[a]
            last_checked = n
            return tt
        if files[pos_file(nodes[n].pos)].is_dewy:
            if (is_numeric(ft) and is_numeric(tt)) or (bundled_rational_type(ft) and is_float(tt)) or (ft == T_MATH_INT and bundled_bigint_type(tt)) or (bundled_bigint_type(ft) and tt == T_MATH_INT):
                add_flag(a, NF_CHECKED)
                t = conversion(n, tt, [a])
                last_checked = n
                return t
            helper = ""
            if fk == .array and telem(ft) == T_U8 and tk == .opt and telem(tt) == T_STR: helper = "__dewy_decode_utf8"
            else if fk == .str_ and tk == .array and telem(tt) == T_U8: helper = "bytes"
            if helper != "":
                add_flag(a, NF_CHECKED)
                nodes[n] = nodes[bc_call(helper, [a], nodes[n].pos)]
                return check_expr(n, expected)
            # (a record's own conversion, `__as__ = (x:T):>U => ...`: `x as U` calls it)
            if fk == .struct_:
                conv = as_conversion(ft, tt)
                if conv != 0:
                    add_flag(a, NF_CHECKED)
                    nodes[n] = Node(kind = .call, pos = nodes[n].pos, a = i32(bc_ident("__as__", nodes[n].pos)))
                    set_list(n, [a])
                    t = resolve_fn_call(n, intern("__as__"), [conv], [a], tt)
                    nodes[n].type = i32(t)
                    add_flag(n, NF_CHECKED)
                    last_checked = n
                    return t
            # (any other value converts to string as it prints: "{x}")
            if tt == T_STR and fk != .void_ and fk != .typeval and fk != .module:
                text = mk(.str_lit, nodes[n].pos)
                nodes[text].aux = 1
                part = mk(.pair, nodes[n].pos)
                nodes[part].a = i32(a)
                nodes[part].sval = -1
                set_list(text, [part])
                nodes[n] = nodes[text]
                return check_expr(n, expected)
        ok = false
        if (fk == .ptr or fk == .int_ or fk == .null_ or fk == .cfn) and (tk == .ptr or tk == .int_ or tk == .cfn): ok = true
        if (fk == .int_ or fk == .float_) and (tk == .int_ or tk == .float_):
            ok = tsize(ft) == tsize(tt) or (fk == .int_ and tk == .int_)
            # (Rust's `x as f64` converts: here it would keep the bits)
            if fk != tk and not pos_in_lib(nodes[n].pos):
                conv = "{dt(tt)}(x)"
                bits = "f64_bits(x) / f64_from_bits(b)"
                if tsize(ft) == 4 or tsize(tt) == 4: bits = "f32_bits(x) / f32_from_bits(b)"
                fatal(nodes[n].pos, "`as` between a whole number and a float keeps the bits, not the number: {conv} converts the value ({bits} for the bits themselves)")
        if fk == .enum_ and not is_union(ft) and tk == .int_: ok = true
        if fk == .int_ and tk == .enum_ and not is_union(tt): ok = true
        if fk == .bool_ and tk == .int_: ok = true
        if (fk == .str_ or fk == .array) and tk == .ptr:
            # (the runtime's: the header; a program means the bytes, which data(x) gives)
            if not pos_in_lib(nodes[n].pos): fatal(nodes[n].pos, "`x as {dt(tt)}` would be where the {dt(ft)}'s header is, not its contents: `data(x)` is a pointer to its first element (what C wants; a str's bytes end with a 0)")
            note_storage_access(a)
            ok = true
        if fk == .ptr and (tk == .str_ or tk == .array): ok = true
        if not ok:
            why = ""
            if is_union(ft) and union_index(ft, tt) >= 0: why = if dewy_at(nodes[n].pos): " (a union is not cast: inside `if x is? {dt(tt)} \{ }` (or after `x is? {dt(tt)} and`), x is one)" else: " (a union is not cast: after `if x is {dt(tt)}:` (or in `x is {dt(tt)} and ...`), x is one)"
            fatal(nodes[n].pos, "cannot cast {dt(ft)} to {dt(tt)}{why}")
        t = tt
    else if k == .range: return check_range_value(n, expected)
    else if k == .addr:
        at = check_expr(int(nodes[n].a), 0)
        if refine_active and ref_storage_contract(refine_storage(int(nodes[n].a), at)): fatal(nodes[n].pos, "mutable refinement access awaits storage invariant checking")
        ak = nodes[int(nodes[n].a)].kind
        if ak != .ident and ak != .field and ak != .index: fatal(nodes[n].pos, "can only take the address of a variable, field or element")
        if ak == .ident and nodes[int(nodes[n].a)].aux == i32(int(SK.local)):
            l = int(nodes[int(nodes[n].a)].sym)
            if int(locals[l].flags) & LF_CAPTURE != 0: fatal(nodes[n].pos, "cannot take the address of a captured variable")
            locals[l].flags = i32(int(locals[l].flags) | LF_ADDR)
        note_storage_access(int(nodes[n].a))
        t = mk_ptr(at)
    else if k == .hole: fatal(nodes[n].pos, "'_' can only be used as a function argument (partial application)")
    else if k == .namedarg: fatal(nodes[n].pos, "named arguments are only allowed in calls")
    else if k == .fnref: t = ntype(n)
    else if k == .conv:
        # (a conversion copied, as a default using an int argument given for an f64: what it
        # converts is checked again)
        ca = int(nodes[n].a)
        if ca != 0 and not has_flag(ca, NF_CHECKED):
            hint = if nodes[n].aux2 == 1: ntype(n) else: 0 # fixed-width .min/.max literal
            check_expr(ca, hint)
            nodes[n].a = i32(last_checked)
        t = ntype(n)
    else if k == .block:
        if has_flag(n, NF_COMPREHENSION) and ex != 0 and exk == .array:
            nodes[kid(n, 0)].a = i32(type_node_of(ex, nodes[n].pos))
        t = check_block(n, expected, true)
    else if k == .matrix: return check_matrix(n, expected)
    else: fatal(nodes[n].pos, "invalid expression")
    if refine_active and types[t].kind == .refined: t = int(types[t].elem)
    nodes[n].type = i32(t)
    if effects_active: t = effect_infer_callable(n, expected); nodes[n].type = i32(t)
    add_flag(n, NF_CHECKED)
    last_checked = n
    t

# The `__as__` conversion from a record type ft to tt (its declared result), or 0.
as_conversion = (ft: int, tt: int) -> int:
    name = intern("__as__")
    decls: int[]
    collect_fns(name, decls)
    tm = module_of_type(ft)
    if tm >= 0: collect_module(tm, name, decls)
    loop d in decls:
        if nkids(d) != 1: continue
        sig = fn_sig(d)
        if sig.generic or sig.ret == 0: continue
        binds: int[]
        if match_type(sig.params[0], ft, binds, 0) == 0 and type_eq(prune(int(sig.ret)), tt): return d
    0

# a swizzle whose components follow each other in memory (.x, .xy, .yzw): a place of its own
swizzle_run = (n: int) -> bool:
    s = name_of(int(nodes[n].name))
    loop i in [1..len(s)):
        if swizzle_index(s[i]) != swizzle_index(s[i - 1]) + 1: return false
    true

check_swizzle = (n: int, bt: int) -> int:
    s = name_of(int(nodes[n].name))
    nb = vec_n(bt)
    if bt == T_MAT4: fatal(nodes[n].pos, "use m[i] to access matrix columns")
    # (v.normalized, v.magnitude: Unity's properties, functions here)
    if s == "normalized": fatal(nodes[n].pos, "a vector's direction is `normalize(v)`")
    if s == "magnitude" or s == "length" or s == "Length": fatal(nodes[n].pos, "a vector's length is `length(v)`")
    if s == "sqrMagnitude" or s == "lengthSquared": fatal(nodes[n].pos, "a vector's length squared is `length_sq(v)`")
    if len(s) < 1 or len(s) > 4: fatal(nodes[n].pos, "invalid vector component '{s}' (a vector has x, y, z and w; `length(v)`, `normalize(v)`, `dot(a, b)` and the like are functions)")
    loop i in [0..len(s)):
        ci = swizzle_index(s[i])
        if ci < 0 or ci >= nb: fatal(nodes[n].pos, "{dt(bt)} has no component '{byte_str(int(s[i]))}'")
    nodes[n].aux = -4
    if len(s) == 1: return vec_comp_type(bt)
    if types[bt].sign:
        if len(s) == 2: return T_IVEC2
        if len(s) == 3: return T_IVEC3
        return T_IVEC4
    if len(s) == 2: return T_VEC2
    if len(s) == 3: return T_VEC3
    T_VEC4

check_if = (n: int, ex: int) -> int:
    is_stmt = has_flag(n, NF_STMT)
    check_to(int(nodes[n].a), T_BOOL)
    cond = int(nodes[n].a)
    b = int(nodes[n].b)
    c = int(nodes[n].c)
    if is_stmt:
        mark = scope_mark()
        before_b = locals.len()
        narrow_by(cond, true)
        after_b = locals.len()
        changes = narrow_changes.len()
        jumps = narrow_jumps.len()
        check_block(b, 0, false)
        if narrow_changes.len() != changes: narrow_returned(changes, jumps, b)
        scope_reset(mark)
        before_c = 0
        after_c = 0
        if c != 0:
            first = narrow_restore(changes)
            before_c = locals.len()
            narrow_by(cond, false)
            after_c = locals.len()
            jumps = narrow_jumps.len()
            check_block(c, 0, false)
            if narrow_changes.len() != changes: narrow_returned(changes, jumps, c)
            scope_reset(mark)
            narrow_merge(first)
        # Reuse the surviving arm's still-valid facts. Retesting the old
        # condition here would resurrect facts invalidated by that arm's writes.
        if stmt_terminates(b) and (c == 0 or not stmt_terminates(c)):
            if c == 0: narrow_by(cond, false)
            else: narrow_promote(before_c, after_c)
        else if c != 0 and stmt_terminates(c) and not stmt_terminates(b): narrow_promote(before_b, after_b)
        return T_VOID
    if c == 0: fatal(nodes[n].pos, "an if expression needs an else branch")
    mark = scope_mark()
    narrow_by(cond, true)
    changes = narrow_changes.len()
    jumps = narrow_jumps.len()
    branch_expected = ex
    if nodes[n].aux2 == -8: branch_expected = 0
    t1 = check_block(b, branch_expected, true)
    if narrow_changes.len() != changes: narrow_returned(changes, jumps, b)
    scope_reset(mark)
    first = narrow_restore(changes)
    narrow_by(cond, false)
    jumps = narrow_jumps.len()
    t2 = check_block(c, branch_expected, true)
    if narrow_changes.len() != changes: narrow_returned(changes, jumps, c)
    scope_reset(mark)
    narrow_merge(first)
    if t1 == T_NEVER and t2 == T_NEVER: return T_NEVER
    if t1 != T_NEVER and nodes[b].aux == 0 and tkind(t1) == .void_: return T_VOID
    if t2 != T_NEVER and nodes[c].aux == 0 and tkind(t2) == .void_ and ex == 0: return T_VOID
    if t1 == T_NEVER:
        v = block_value(c)
        if ex != 0: coerce(v, ex)
        else: finalize_literal(v)
        return ntype(v)
    if t2 == T_NEVER:
        v = block_value(b)
        if ex != 0: coerce(v, ex)
        else: finalize_literal(v)
        return ntype(v)
    if nodes[b].aux == 0 or nodes[c].aux == 0: fatal(nodes[n].pos, "both branches of an if expression need a value")
    va = block_value(b)
    vb = block_value(c)
    if nodes[n].aux2 == -8:
        ta = finalize_literal(va)
        tb = finalize_literal(vb)
        if nodes[va].kind == .none_lit: ta = T_NONE
        if nodes[vb].kind == .none_lit: tb = T_NONE
        result = mk_union([ta, tb])
        coerce(va, result)
        coerce(vb, result)
        return result
    if ex != 0:
        coerce(va, ex)
        coerce(vb, ex)
        return ex
    join_types(va, vb, nodes[n].pos)

# ---------------- ranges as values ----------------
# a range used as a value is the array of its numbers: [0..n) is [0, 1, ... n-1]
check_range_value = (n: int, expected: int) -> int:
    pos = nodes[n].pos
    if nodes[n].b == 0: fatal(pos, "a range with no end (a..) can only be looped over")
    inner = nodes.len()
    nodes.push(nodes[n])
    on = "__rv{bc_count}"
    iv = "__ri{bc_count}"
    bc_count += 1
    od = mk(.vardecl, pos)
    nodes[od].name = i32(intern(on))
    ty = mk(.tname, pos)
    nodes[ty].aux = -7
    nodes[ty].ival = mk_array(T_INT)
    nodes[od].a = i32(ty)
    f = mk(.for_, pos)
    set_list(f, [bc_ident(iv, pos)])
    nodes[f].a = i32(inner)
    nodes[f].b = i32(bc_block([bc_stmt(bc_method(bc_ident(on, pos), "push", [bc_ident(iv, pos)], pos), pos)], pos))
    nodes[n] = nodes[bc_block([od, f, bc_stmt(bc_ident(on, pos), pos)], pos)]
    check_expr(n, expected)

# Dewy interval membership evaluates the needle and both endpoints exactly once,
# in written order, before testing either bound. No range array is constructed.
check_dewy_in_range = (n: int) -> int:
    pos = nodes[n].pos
    r = int(nodes[n].b)
    statements: int[]
    values: int[]
    loop value in [int(nodes[n].a), int(nodes[r].a), int(nodes[r].b)]:
        if value == 0: values.push(0); continue
        check_to(value, T_INT)
        values.push(capture_value(value, T_INT, statements))
    condition = 0
    if values[1] != 0: condition = bc_bin(.ge, values[0], values[1], pos)
    if values[2] != 0:
        op = Tok.lt
        if has_flag(r, NF_INCLUSIVE): op = .le
        upper = bc_bin(op, values[0], values[2], pos)
        if condition == 0: condition = upper
        else:
            both = mk(.and_, pos)
            nodes[both].a = i32(condition)
            nodes[both].b = i32(upper)
            condition = both
    if condition == 0:
        condition = mk(.bool_lit, pos)
        nodes[condition].ival = 1
    check_to(condition, T_BOOL)
    statements.push(bc_stmt(condition, pos))
    nodes[n] = Node(kind = .block, pos = pos, type = i32(T_BOOL), aux = 1, flags = i32(NF_CHECKED))
    set_list(n, statements)
    T_BOOL

# x in a..b: a <= x and x <= b (no array)
check_in_range = (n: int, expected: int) -> int:
    if files[pos_file(nodes[n].pos)].is_dewy: return check_dewy_in_range(n)
    pos = nodes[n].pos
    r = int(nodes[n].b)
    x = int(nodes[n].a)
    stmts: int[]
    xk = nodes[x].kind
    xr = x
    if xk != .ident and xk != .int_lit:
        xn = "__rx{bc_count}"
        bc_count += 1
        stmts.push(bc_let(xn, x, pos))
        xr = bc_ident(xn, pos)
    again = (e: int) -> int:
        if e == x: return clone(x)
        bc_ident(name_of(int(nodes[e].name)), pos)
    lo = 0
    if nodes[r].a != 0: lo = bc_bin(.ge, xr, int(nodes[r].a), pos)
    hi = 0
    if nodes[r].b != 0:
        op = Tok.lt
        if has_flag(r, NF_INCLUSIVE): op = .le
        hi = bc_bin(op, again(xr), int(nodes[r].b), pos)
    c = lo
    if lo == 0: c = hi
    else if hi != 0:
        c = mk(.and_, pos)
        nodes[c].a = i32(lo)
        nodes[c].b = i32(hi)
    if c == 0: fatal(pos, "invalid range")
    stmts.push(bc_stmt(c, pos))
    nodes[n] = nodes[bc_block(stmts, pos)]
    check_expr(n, expected)

# ---------------- struct-of-arrays ----------------
# soa P[] is a struct with an array per field of P; these rewrite its array operations into
# operations on the field arrays

# a fresh copy of expression e (evaluated again where it is used)
soa_again = (e: int) -> int: clone(e)

# the struct value P(f0, f1, ...) from checked field values (in field order)
soa_struct = (st: int, vals: int[], pos: int) -> int:
    c = mk(.call, pos)
    set_list(c, vals)
    nodes[c].aux = 2
    nodes[c].type = i32(st)
    add_flag(c, NF_CHECKED)
    c

soa_field_names = (t: int) -> int[]:
    si = int(types[prune(t)].st)
    out: int[]
    loop i in [0..int(structs[si].nfields)): out.push(int(fields[int(structs[si].fields) + i].name))
    out

# ps[i]: P(ps.x[i], ps.y[i], ...)
check_soa_index = (n: int, expected: int) -> int:
    pos = nodes[n].pos
    base = int(nodes[n].a)
    st = prune(ntype(base))
    pt = soa_elem(st)
    stmts: int[]
    iname = "__si{bc_count}"
    bc_count += 1
    stmts.push(bc_let(iname, int(nodes[n].b), pos))
    vals: int[]
    loop i in 0.. and fname in soa_field_names(st):
        f = mk(.field, pos)
        nodes[f].a = i32(soa_again(base))
        nodes[f].name = i32(fname)
        ix = mk(.index, pos)
        nodes[ix].a = i32(f)
        nodes[ix].b = i32(bc_ident(iname, pos))
        vals.push(ix)
    blk = bc_block(stmts, pos)
    mark = scope_mark()
    check_stmt(stmts[0])
    add_flag(stmts[0], NF_CHECKED)
    loop i in [0..vals.len()):
        check_expr(vals[i], 0)
        vals[i] = last_checked
    scope_reset(mark)
    # (ps[mask], ps[idxs]: each field's elements picked, a soa array again)
    it = prune(ntype(int(nodes[stmts[0]].b)))
    if types[it].kind == .array: stmts.push(bc_stmt(soa_struct(st, vals, pos), pos))
    else: stmts.push(bc_stmt(soa_struct(pt, vals, pos), pos))
    set_list(blk, stmts)
    nodes[n] = nodes[blk]
    check_expr(n, expected)

# ps[i] = p: each field
soa_assign = (s: int) -> int:
    pos = nodes[s].pos
    lhs = int(nodes[s].a)
    base = int(nodes[lhs].a)
    st = prune(ntype(base))
    if nodes[s].op != i32(int(Tok.assign)): fatal(pos, "only `=` assigns a whole element of a soa array")
    tn = "__st{bc_count}"
    iname = "__si{bc_count}"
    bc_count += 1
    stmts = [bc_let(iname, int(nodes[lhs].b), pos)]
    vd = bc_let(tn, int(nodes[s].b), pos)
    ty = mk(.tname, pos)
    nodes[ty].aux = -7
    nodes[ty].ival = soa_elem(st)
    nodes[vd].a = i32(ty)
    stmts.push(vd)
    loop fname in soa_field_names(st):
        f = mk(.field, pos)
        nodes[f].a = i32(soa_again(base))
        nodes[f].name = i32(fname)
        ix = mk(.index, pos)
        nodes[ix].a = i32(f)
        nodes[ix].b = i32(bc_ident(iname, pos))
        a = mk(.assign, pos)
        nodes[a].op = i32(int(Tok.assign))
        nodes[a].a = i32(ix)
        nodes[a].b = i32(bc_field(bc_ident(tn, pos), name_of(fname), pos))
        stmts.push(a)
    es = bc_stmt(bc_block(stmts, pos), pos)
    check_stmt(es)
    es

check_soa_method = (n: int, recv: int, fname: int, args: int[], expected: int) -> int:
    pos = nodes[n].pos
    st = prune(ntype(recv))
    pt = soa_elem(st)
    fnms = soa_field_names(st)
    m = name_of(fname)
    if fnms.len() == 0: fatal(pos, "{dt(st)}: the struct has no fields")
    fld = (i: int) -> int:
        f = mk(.field, pos)
        nodes[f].a = i32(soa_again(recv))
        nodes[f].name = i32(fnms[i])
        f
    stmts: int[]
    if m == "len":
        nodes[n] = nodes[bc_call("len", [fld(0)], pos)]
        return check_expr(n, expected)
    if m == "push":
        if args.len() != 1: fatal(pos, "push takes one element")
        tn = "__st{bc_count}"
        bc_count += 1
        vd = bc_let(tn, args[0], pos)
        ty = mk(.tname, pos)
        nodes[ty].aux = -7
        nodes[ty].ival = pt
        nodes[vd].a = i32(ty)
        stmts.push(vd)
        loop i in 0.. and nm in fnms: stmts.push(bc_stmt(bc_method(fld(i), "push", [bc_field(bc_ident(tn, pos), name_of(nm), pos)], pos), pos))
    else if m == "clear" or m == "reserve" or m == "truncate":
        loop i in [0..fnms.len()):
            cl: int[]
            loop a in args: cl.push(clone(a))
            stmts.push(bc_stmt(bc_method(fld(i), m, cl, pos), pos))
    else if m == "pop" or m == "remove":
        if m == "remove" and args.len() != 1: fatal(pos, "remove takes an index")
        vals: int[]
        if m == "remove":
            iname = "__si{bc_count}"
            bc_count += 1
            stmts.push(bc_let(iname, args[0], pos))
            loop i in [0..fnms.len()): vals.push(bc_method(fld(i), "remove", [bc_ident(iname, pos)], pos))
        else:
            loop i in [0..fnms.len()): vals.push(bc_method(fld(i), "pop", [], pos))
        blk = bc_block(stmts, pos)
        mark = scope_mark()
        loop x in stmts:
            check_stmt(x)
            add_flag(x, NF_CHECKED)
        loop i in [0..vals.len()):
            check_expr(vals[i], 0)
            vals[i] = last_checked
        scope_reset(mark)
        stmts.push(bc_stmt(soa_struct(pt, vals, pos), pos))
        set_list(blk, stmts)
        nodes[n] = nodes[blk]
        return check_expr(n, expected)
    else: fatal(pos, "a soa array has len, push, pop, remove, clear, reserve and truncate (and its field arrays: xs.{name_of(fnms[0])})")
    nodes[n] = nodes[bc_block(stmts, pos)]
    check_expr(n, expected)

# P[] -> soa P[]: n becomes a loop pushing each element
soa_from_array = (n: int, to: int):
    pos = nodes[n].pos
    inner = nodes.len()
    nodes.push(nodes[n])
    cn = "__sc{bc_count}"
    on = "__so{bc_count}"
    pn = "__sp{bc_count}"
    bc_count += 1
    od = mk(.vardecl, pos)
    nodes[od].name = i32(intern(on))
    ty = mk(.tname, pos)
    nodes[ty].aux = -7
    nodes[ty].ival = to
    nodes[od].a = i32(ty)
    lp = mk(.for_, pos)
    set_list(lp, [bc_ident(pn, pos)])
    nodes[lp].a = i32(bc_ident(cn, pos))
    nodes[lp].b = i32(bc_block([bc_stmt(bc_method(bc_ident(on, pos), "push", [bc_ident(pn, pos)], pos), pos)], pos))
    stmts = [bc_let(cn, inner, pos), od, bc_stmt(bc_method(bc_ident(on, pos), "reserve", [bc_call("len", [bc_ident(cn, pos)], pos)], pos), pos), lp, bc_stmt(bc_ident(on, pos), pos)]
    nodes[n] = nodes[bc_block(stmts, pos)]
    check_expr(n, to)

# ---------------- 2-D array literals ----------------
# [1 2; 3 4] is __array2([1, 2, 3, 4], 2, 2); [a; b] with arrays a, b is __array2_rows([a, b])
check_matrix = (n: int, expected: int) -> int:
    pos = nodes[n].pos
    els = kids(n)
    ncols = int(nodes[n].ival)
    arr = mk(.array, pos)
    args: int[]
    fname = "__array2"
    if ncols == 1 and els.len() > 0:
        t0 = prune(check_expr(els[0], 0))
        els[0] = last_checked
        if types[t0].kind == .array: fname = "__array2_rows"
        else if is_nd(t0): fname = "__array_stack"
    set_list(arr, els)
    args.push(arr)
    if fname == "__array2":
        # with a known element type, literals take it (m: f32[,] = [1 2; 3 4])
        ex = prune(expected)
        if ex != 0 and is_nd(ex):
            check_expr(arr, mk_array(struct_targ(int(types[ex].st), 0)))
        rows = 0
        if ncols > 0: rows = els.len() / ncols
        args.push(bc_int(rows, pos))
        args.push(bc_int(ncols, pos))
    c = bc_call(fname, args, pos)
    nodes[n] = nodes[c]
    check_expr(n, expected)

# ---------------- elementwise operations ----------------
# A dotted expression (a .* b .+ c, f.(xs), ...) becomes one loop over the elements: its operands
# that are not themselves dotted operations are evaluated once, and the operation applies to their
# elements, broadcast like numpy (a dimension of length 1, or a missing leading one, stretches).
bc_count = 0

# Brackets also construct records and call user-defined indexing operators. Keep
# range syntax until the receiver type is known: NDArray uses axis slices, while
# other multi-argument brackets receive ordinary stored range values.
dewy_index_ranges = (n: int, receiver: int):
    if not files[pos_file(nodes[n].pos)].is_dewy or is_nd(receiver): return
    if nkids(n) < 2 and types[receiver].kind != .typeval: return
    loop i in [0..nkids(n)):
        r = kid(n, i)
        if nodes[r].kind == .range:
            value = dewy_range_value(r)
            set_kid(n, i, value)
            if nodes[n].b == r: nodes[n].b = i32(value)

dewy_range_value = (range: int) -> int:
    pos = nodes[range].pos
    if nodes[range].a == 0 or nodes[range].b == 0: fatal(pos, "a stored range needs both endpoints; open ranges can be used directly in loops or membership")
    step = has_flag(range, NF_STEP)
    second = if step: int(nodes[range].c) else: bc_int(0, pos)
    stepped = mk(.bool_lit, pos)
    nodes[stepped].ival = if step: 1 else: 0
    inclusive = mk(.bool_lit, pos)
    nodes[inclusive].ival = if has_flag(range, NF_INCLUSIVE): 1 else: 0
    result = bc_call("__dewy_range", [int(nodes[range].a), second, int(nodes[range].b), stepped, inclusive], pos)
    if has_flag(range, NF_EXCL_FIRST): result = bc_call("__dewy_range_tail", [result], pos)
    result

# A matrix part can use literal ranges or ordinary stored IntRange values.
is_part_index = (n: int, receiver: int = 0) -> bool:
    ixs = kids(n)
    if nodes[n].b != 0: ixs = [int(nodes[n].b)]
    loop x in ixs:
        if nodes[x].kind == .range: return true
    if is_nd(receiver):
        loop x in ixs:
            if is_dewy_range_type(check_expr(clone(x), 0), "IntRange"): return true
    false

# Convert each axis to a small selector. The library binds open endpoints to
# the captured shape and validates stored ranges without materializing indexes.
part_spec = (n: int) -> int:
    pos = nodes[n].pos
    ixs = kids(n)
    if nodes[n].b != 0: ixs = [int(nodes[n].b)]
    elems: int[]
    loop x in ixs:
        if nodes[x].kind != .range:
            elems.push(bc_call("__nd_axis", [x], pos))
            continue
        args = dewy_slice_args(x, pos)
        exclusive = mk(.bool_lit, pos)
        nodes[exclusive].ival = if has_flag(x, NF_EXCL_FIRST): 1 else: 0
        elems.push(bc_call("__nd_axis_slice", args + [exclusive], pos))
    arr = mk(.array, pos)
    set_list(arr, elems)
    arr

bc_ident = (name: str, pos: int) -> int:
    n = mk(.ident, pos)
    nodes[n].name = i32(intern(name))
    n

bc_bool = (v: bool, pos: int) -> int:
    n = mk(.bool_lit, pos)
    if v: nodes[n].ival = 1
    n

bc_int = (v: int, pos: int) -> int:
    n = mk(.int_lit, pos)
    nodes[n].ival = v
    add_flag(n, NF_LITERAL)
    n

bc_bin = (op: Tok, a: int, b: int, pos: int) -> int:
    n = mk(.binary, pos)
    nodes[n].op = i32(int(op))
    nodes[n].a = i32(a)
    nodes[n].b = i32(b)
    n

# the files under directory dir (paths from it, sorted), sub-directories' too; hidden ones left out
embed_dir_walk = (dir: str, prefix: str, out: mut str[]):
    entries = list_dir(dir)
    entries.sort()
    loop e in entries:
        if starts_with(e, "."): continue
        full = "{dir}/{e}"
        if is_dir(full): embed_dir_walk(full, "{prefix}{e}/", out)
        else: out.push("{prefix}{e}")

# (xs[-1], s[-3..]: counting from the end, as Python and JavaScript do)
neg_index_check = (b: int):
    if nodes[b].kind != .int_lit or nodes[b].ival >= 0: return
    k = -nodes[b].ival
    e = "end"
    if k > 1: e = "end - {k - 1}"
    fatal(nodes[b].pos, "an index counts from 0; from the end it is `{e}` (`xs[end]` is the last, `xs[end - 2..]` the last three)")

# Integer arithmetic around `end` cannot change the receiver. Other index
# expressions retain a value snapshot before invoking user code.
dewy_end_arithmetic = (n: int, name: int) -> bool:
    if n == 0: return true
    k = nodes[n].kind
    if k == .int_lit: return true
    if k == .ident:
        if nodes[n].name == i32(name): return true
        s = lookup(int(nodes[n].name))
        if s == 0 or syms[s].kind != .local: return false
        l = int(syms[s].ref)
        # An alias can stand for a getter or a deferred element read. Keep its
        # snapshot; an ordinary local (including a parameter) is just a value.
        if int(locals[l].flags) & (LF_ALIAS | LF_UNNARROWED) != 0: return false
        return is_int(int(locals[l].type))
    if k == .binary or k == .unary or k == .range:
        return dewy_end_arithmetic(int(nodes[n].a), name) and dewy_end_arithmetic(int(nodes[n].b), name) and dewy_end_arithmetic(int(nodes[n].c), name)
    false

# Bind end once per axis of an NDArray. Other receivers still compute their
# length only once, even if several custom index arguments contain end.
dewy_index_end_bindings = (index: int, source: int, source_type: int) -> int[]:
    pos = nodes[index].pos
    base = name_of(int(nodes[index].sval))
    out: int[]
    loop axis in [0..max(nkids(index), 1)):
        name = if axis == 0: base else: "{base}_{axis}"
        value = 0
        if is_nd(source_type):
            dim = mk(.index, pos)
            nodes[dim].a = i32(bc_field(clone(source), "shape", pos))
            nodes[dim].b = i32(bc_int(axis, pos))
            value = bc_bin(.minus, dim, bc_int(1, pos), pos)
        else if axis == 0: value = dewy_index_end(clone(source), pos)
        else: value = bc_ident(base, pos)
        out.push(bc_let(name, value, pos))
    out

dewy_index_end = (source: int, pos: int) -> int:
    bc_bin(.minus, bc_method(source, "len", [], pos), bc_int(1, pos), pos)

# A stepped slice computes its default endpoint from the captured receiver's
# size. Calls retain normal left-to-right operand evaluation and value snapshots.
dewy_slice_args = (r: int, pos: int) -> int[]:
    first = int(nodes[r].a)
    second = int(nodes[r].c)
    if first == 0: first = bc_int(0, pos)
    if second == 0: second = bc_int(0, pos)
    last = int(nodes[r].b)
    stepped = mk(.bool_lit, pos)
    nodes[stepped].ival = if has_flag(r, NF_STEP): 1 else: 0
    inclusive = mk(.bool_lit, pos)
    nodes[inclusive].ival = if has_flag(r, NF_INCLUSIVE): 1 else: 0
    bounded = mk(.bool_lit, pos)
    nodes[bounded].ival = if last != 0: 1 else: 0
    if last == 0: last = bc_int(0, pos)
    [first, second, last, inclusive, bounded, stepped]

dewy_array_slice = (index: int, value: int = 0) -> int:
    pos = nodes[index].pos
    base = int(nodes[index].a)
    add_flag(base, NF_CHECKED)
    if value != 0: add_flag(base, NF_MUT)
    args = [base] + dewy_slice_args(int(nodes[index].b), pos)
    if value != 0: args.push(value)
    if value != 0: return dewy_array_selection_call("__dewy_put_slice", args, prune(ntype(base)), pos)
    dewy_array_selection_call("__dewy_pick_slice", args, prune(ntype(base)), pos)

# Bind both storage and element types. The same library loops select and update
# growable and inline arrays directly, preserving element context for literals.
dewy_array_selection_call = (name: str, args: int[], storage: int, pos: int) -> int:
    callee = mk(.typeapply, pos)
    nodes[callee].a = i32(bc_ident(name, pos))
    targs = [type_node_of(storage, pos), type_node_of(int(types[storage].elem), pos)]
    # Index/mask storage can also be inline; do not materialize it just to read it.
    if ends_with(name, "_indices") or ends_with(name, "_mask"):
        targs.push(type_node_of(prune(ntype(args[1])), pos))
    set_list(callee, targs)
    call = mk(.call, pos)
    nodes[call].a = i32(callee)
    set_list(call, args)
    call

# xs[b] with b a bool[] (a mask) or int[] (indexes): the function that picks (or sets) them
index_array_fn = (b: int, base: str) -> str:
    expected = if nodes[b].kind == .array and nkids(b) == 0 and nodes[b].b == 0: mk_array(T_INT) else: T_INT
    it = prune(check_expr(b, expected))
    if is_dewy_range_type(it, "IntRange"): return base
    if types[it].kind != .array and types[it].kind != .fixed: return ""
    et = prune(int(types[it].elem))
    if types[et].kind == .bool_: return base + "_mask"
    if et == T_INT or et == T_MATH_INT: return base + "_indices"
    fatal(nodes[b].pos, jd(nodes[b].pos, "an array of indexes is int[], or a mask bool[] (found {dt(it)})", "an array of indexes is array<int64>, or a mask array<bool> (found {dt(it)})"))
    ""

bc_call = (name: str, args: int[], pos: int) -> int:
    c = mk(.call, pos)
    nodes[c].a = i32(bc_ident(name, pos))
    set_list(c, args)
    c

bc_method = (recv: int, name: str, args: int[], pos: int) -> int:
    f = mk(.field, pos)
    nodes[f].a = i32(recv)
    nodes[f].name = i32(intern(name))
    c = mk(.call, pos)
    nodes[c].a = i32(f)
    set_list(c, args)
    c

bc_field = (recv: int, name: str, pos: int) -> int:
    f = mk(.field, pos)
    nodes[f].a = i32(recv)
    nodes[f].name = i32(intern(name))
    f

bc_let = (name: str, v: int, pos: int) -> int:
    d = mk(.vardecl, pos)
    nodes[d].name = i32(intern(name))
    nodes[d].b = i32(v)
    d

bc_stmt = (e: int, pos: int) -> int:
    s = mk(.exprstmt, pos)
    nodes[s].a = i32(e)
    s

bc_block = (stmts: int[], pos: int) -> int:
    b = mk(.block, pos)
    set_list(b, stmts)
    b

bc_str = (s: str, pos: int) -> int:
    n = mk(.str_lit, pos)
    nodes[n].sval = i32(intern(s))
    n

bc_assign = (target: int, v: int, pos: int) -> int:
    a = mk(.assign, pos)
    nodes[a].op = i32(int(Tok.assign))
    nodes[a].a = i32(target)
    nodes[a].b = i32(v)
    a

bc_if = (c: int, then: int[], else_: int[], pos: int) -> int:
    n = mk(.if_, pos)
    nodes[n].a = i32(c)
    nodes[n].b = i32(bc_block(then, pos))
    if else_.len() > 0: nodes[n].c = i32(bc_block(else_, pos))
    add_flag(n, NF_STMT)
    n

# name: t (its zero value)
bc_decl = (name: str, t: int, pos: int) -> int:
    d = mk(.vardecl, pos)
    nodes[d].name = i32(intern(name))
    ty = mk(.tname, pos)
    nodes[ty].aux = -7
    nodes[ty].ival = t
    nodes[d].a = i32(ty)
    d

# loop name in [0..n): body
bc_loop = (name: str, n: int, body: int[], pos: int) -> int:
    f = mk(.for_, pos)
    set_list(f, [bc_ident(name, pos)])
    r = mk(.range, pos)
    nodes[r].a = i32(bc_int(0, pos))
    nodes[r].b = i32(n)
    nodes[f].a = i32(r)
    nodes[f].b = i32(bc_block(body, pos))
    f

# int(x != 1): the step through an operand's dimension of length x (0 when it is broadcast)
bc_step = (x: int, pos: int) -> int: bc_call("int", [bc_bin(.ne, x, bc_int(1, pos), pos)], pos)

is_dotted = (n: int) -> bool:
    k = nodes[n].kind
    (k == .binary and nodes[n].op == i32(int(Tok.dotop))) or ((k == .call or k == .unary) and has_flag(n, NF_BROADCAST))

# the operator a dotted operator applies to each element (.+ is +, .<= is <=, ...)
dot_base_op = (n: int) -> Tok:
    c = int(nodes[n].aux)
    three = nodes[n].aux2 == 1
    if c == '+': return .plus
    if c == '-': return .minus
    if c == '*': return .star
    if c == '/': return .slash
    if c == '%': return .percent
    if c == '<':
        if three: return .le
        return .lt
    if c == '>':
        if three: return .ge
        return .gt
    if c == '=': return .eq
    if c == '!': return .ne
    .caret

# the per-element expression of dotted expression n; its operands go to `leaves` (replaced by
# __b<tag>e<k>, the current element of operand k); literals stay in place (and keep adapting)
dot_template = (n: int, leaves: mut int[], tag: str) -> int:
    pos = nodes[n].pos
    k = nodes[n].kind
    if k == .unary and has_flag(n, NF_BROADCAST):
        a = dot_template(int(nodes[n].a), leaves, tag)
        result = mk(.unary, pos)
        nodes[result].op = nodes[n].op
        nodes[result].a = i32(a)
        return result
    if k == .binary and nodes[n].op == i32(int(Tok.dotop)):
        a = dot_template(int(nodes[n].a), leaves, tag)
        b = dot_template(int(nodes[n].b), leaves, tag)
        op = dot_base_op(n)
        if op == .caret: return bc_call("pow", [a, b], pos)
        result = bc_bin(op, a, b, pos)
        # Dewy's .not<? negates the comparison, including unordered floats.
        if nodes[n].ival != 0:
            negated = mk(.not_, pos)
            nodes[negated].a = i32(result)
            return negated
        return result
    if k == .call and has_flag(n, NF_BROADCAST):
        c = mk(.call, pos)
        nodes[c].a = nodes[n].a
        args: int[]
        loop x in kids(n): args.push(dot_template(x, leaves, tag))
        set_list(c, args)
        return c
    if (k == .int_lit or k == .float_lit or k == .bool_lit) and not has_flag(n, NF_CHECKED): return n
    leaves.push(n)
    bc_ident("__b{tag}e{leaves.len() - 1}", pos)

# the loops computing a dotted expression over n-dimensional arrays: kinds[k] is 1 for a 1-D
# array, 2 for an n-dimensional one, 0 for a number; arrs[k] names the array. The result's last
# dimension is the inner loop (the whole array when no operand is stretched); the outer loop
# finds where each operand's row starts.
bc_loop_nd = (tmpl: int, arrs: str[], kinds: int[], pre: str, epre: str, pos: int) -> int[]:
    stmts: int[]
    rowpre: int[]
    body: int[]
    out = "{pre}o"
    shp = (k: int) -> int:
        if kinds[k] == 2: return bc_field(bc_ident(arrs[k], pos), "shape", pos)
        a = mk(.array, pos)
        set_list(a, [bc_call("len", [bc_ident(arrs[k], pos)], pos)])
        a
    shs: int[]
    loop k in [0..kinds.len()):
        if kinds[k] > 0: shs.push(shp(k))
    sa = mk(.array, pos)
    set_list(sa, shs)
    id = (nm: str) -> int: bc_ident("{pre}{nm}", pos)
    stmts.push(bc_let("{pre}shs", sa, pos))
    stmts.push(bc_let("{pre}shp", bc_call("__bcast_shape", [id("shs")], pos), pos))
    stmts.push(bc_let("{pre}n", bc_call("__nd_size", [id("shp")], pos), pos))
    stmts.push(bc_let("{pre}in", bc_call("__bcast_inner", [id("shs"), id("shp")], pos), pos))
    # Shape counts are nonnegative integers, including in Dewy source where / is exact.
    stmts.push(bc_let("{pre}on", bc_call("__floor_div", [id("n"), bc_call("max", [id("in"), bc_int(1, pos)], pos)], pos), pos))
    loop k in [0..kinds.len()):
        if kinds[k] == 0: continue
        src = bc_ident(arrs[k], pos)
        if kinds[k] == 2: src = bc_field(bc_ident(arrs[k], pos), "data", pos)
        stmts.push(bc_let("{pre}x{k}", src, pos))
        stmts.push(bc_let("{pre}st{k}", bc_call("__bcast_strides", [shp(k), id("shp")], pos), pos))
        stmts.push(bc_let("{pre}ls{k}", bc_call("__bcast_last", [id("st{k}"), bc_call("len", [id("x{k}")], pos), id("n")], pos), pos))
        rowpre.push(bc_let("{pre}b{k}", bc_call("__bcast_offset", [id("r"), id("shp"), id("st{k}")], pos), pos))
        ix = mk(.index, pos)
        nodes[ix].a = i32(id("x{k}"))
        nodes[ix].b = i32(bc_bin(.plus, id("b{k}"), bc_bin(.star, id("j"), id("ls{k}"), pos), pos))
        body.push(bc_let("{epre}e{k}", ix, pos))
    stmts.push(bc_let(out, mk(.array, pos), pos))
    stmts.push(bc_stmt(bc_method(bc_ident(out, pos), "reserve", [id("n")], pos), pos))
    # (on * in = n elements, room reserved; the indexes keep their checks: an NDArray's data and
    # shape could disagree)
    pu = bc_method(bc_ident(out, pos), "push", [tmpl], pos)
    add_flag(pu, NF_INBOUNDS)
    body.push(bc_stmt(pu, pos))
    rowpre.push(bc_loop("{pre}j", id("in"), body, pos))
    stmts.push(bc_loop("{pre}r", id("on"), rowpre, pos))
    stmts.push(bc_stmt(bc_call("ndarray", [bc_ident(out, pos), id("shp")], pos), pos))
    stmts

# the loop computing a dotted expression over 1-D arrays: arrs[k] names operand k's array ("" for
# a number, whose element variable already exists); `pre` names the loop's variables, `epre` the
# element variables the template uses. The last statement is the result.
bc_loop1 = (tmpl: int, arrs: str[], pre: str, epre: str, pos: int) -> int[]:
    stmts: int[]
    out = "{pre}o"
    lens: int[]
    loop a in arrs:
        if len(a) > 0: lens.push(bc_call("len", [bc_ident(a, pos)], pos))
    larr = mk(.array, pos)
    set_list(larr, lens)
    stmts.push(bc_let("{pre}n", bc_call("__bcast", [larr], pos), pos))
    loop k in 0.. and a in arrs:
        if len(a) == 0: continue
        stmts.push(bc_let("{pre}s{k}", bc_step(bc_call("len", [bc_ident(a, pos)], pos), pos), pos))
    stmts.push(bc_let(out, mk(.array, pos), pos))
    stmts.push(bc_stmt(bc_method(bc_ident(out, pos), "reserve", [bc_ident("{pre}n", pos)], pos), pos))
    # (room for every element is reserved, in an array of the loop's own: it has all its
    # elements from the start, zeros until written, and element i is written in step i)
    stmts.push(bc_stmt(bc_call("__set_len", [bc_ident(out, pos), bc_ident("{pre}n", pos)], pos), pos))
    # with every operand as long as the result (the usual case) element i of each is at i: a
    # loop the compiler can run several elements at a time; else operands are stretched
    all_one = 0
    loop k in 0.. and a in arrs:
        if len(a) == 0: continue
        c = bc_bin(.eq, bc_ident("{pre}s{k}", pos), bc_int(1, pos), pos)
        if all_one == 0: all_one = c
        else:
            x = mk(.and_, pos)
            nodes[x].a = i32(all_one)
            nodes[x].b = i32(c)
            all_one = x
    fast = bc_loop("{pre}i", bc_ident("{pre}n", pos), bc_body1(clone(tmpl), arrs, pre, epre, out, false, pos), pos)
    if all_one == 0:
        stmts.push(fast)
    else:
        slow = bc_loop("{pre}i", bc_ident("{pre}n", pos), bc_body1(tmpl, arrs, pre, epre, out, true, pos), pos)
        ifn = mk(.if_, pos)
        nodes[ifn].a = i32(all_one)
        nodes[ifn].b = i32(bc_block([fast], pos))
        nodes[ifn].c = i32(bc_block([slow], pos))
        stmts.push(ifn)
    stmts.push(bc_stmt(bc_ident(out, pos), pos))
    stmts

# the body of the loop over 1-D operands: their elements (at i, or at i * step when stretched),
# then the result's element i
bc_body1 = (tmpl: int, arrs: str[], pre: str, epre: str, out: str, stretched: bool, pos: int) -> int[]:
    body: int[]
    loop k in 0.. and a in arrs:
        if len(a) == 0: continue
        ix = mk(.index, pos)
        nodes[ix].a = i32(bc_ident(a, pos))
        if stretched: nodes[ix].b = i32(bc_bin(.star, bc_ident("{pre}i", pos), bc_ident("{pre}s{k}", pos), pos))
        else: nodes[ix].b = i32(bc_ident("{pre}i", pos))
        # (i < n, and an operand's step is 1 only when its length is n: in bounds)
        add_flag(ix, NF_INBOUNDS)
        body.push(bc_let("{epre}e{k}", ix, pos))
    ixo = mk(.index, pos)
    nodes[ixo].a = i32(bc_ident(out, pos))
    nodes[ixo].b = i32(bc_ident("{pre}i", pos))
    add_flag(ixo, NF_INBOUNDS)
    asg = mk(.assign, pos)
    nodes[asg].a = i32(ixo)
    nodes[asg].b = i32(tmpl)
    nodes[asg].op = i32(int(Tok.assign))
    body.push(asg)
    body

# a GpuBuffer[T] (lib/game/gpubuffer.jo), and its element type T (that of the field `host: *T`)
is_gpu_buffer = (t0: int) -> bool:
    t = prune(t0)
    types[t].kind == .struct_ and structs[int(types[t].st)].decl != 0 and name_of(int(nodes[int(structs[int(types[t].st)].decl)].name)) == "GpuBuffer"
gpu_buffer_elem = (t0: int) -> int:
    si = int(types[prune(t0)].st)
    check_struct_fields(si)
    loop i in [0..int(structs[si].nfields)):
        f = int(structs[si].fields) + i
        if name_of(int(fields[f].name)) == "host": return int(types[prune(int(fields[f].type))].elem)
    0

is_gpu_array = (t0: int) -> bool:
    t = prune(t0)
    types[t].kind == .struct_ and structs[int(types[t].st)].decl != 0 and name_of(int(nodes[int(structs[int(types[t].st)].decl)].name)) == "GpuArray"

# the checked value of operand k of a dotted expression (the let in front of the loop)
d0_leaf = (stmts: int[], k: int) -> int: int(nodes[stmts[k]].b)

# an array literal of type T[] (also when it is empty)
typed_array = (elems: int[], t: int, pos: int) -> int:
    a = mk(.array, pos)
    set_list(a, elems)
    tn = mk(.tname, pos)
    nodes[tn].aux = -7
    nodes[tn].ival = mk_array(t)
    c = mk(.cast, pos)
    nodes[c].a = i32(a)
    nodes[c].b = i32(tn)
    c

# Renaming a callable's labels, including nested callback labels, needs no
# adapter. All value types and mutation modes must still have the same shape.
callable_shape_eq = (a0: int, b0: int) -> bool:
    if type_eq(a0, b0): return true
    a = prune(a0)
    b = prune(b0)
    if types[a].kind != .fn_ or types[b].kind != .fn_: return false
    if types[a].nargs != types[b].nargs or types[a].mutmask != types[b].mutmask: return false
    loop i in [0..int(types[a].nargs)):
        if not callable_shape_eq(targ(a, i), targ(b, i)): return false
    callable_shape_eq(int(types[a].elem), int(types[b].elem))

callable_fits = (from0: int, to0: int) -> bool:
    if not effect_contract_fits(from0, to0): return false
    from = callable_base(from0)
    to = callable_base(to0)
    if types[from].kind != .fn_ or types[to].kind != .fn_: return false
    if types[from].mutmask != types[to].mutmask or types[from].nargs != types[to].nargs: return false
    loop i in [0..int(types[from].nargs)):
        if types[from].mutmask & i32(1 << i) != 0:
            if not type_eq(targ(from, i), targ(to, i)): return false
        else if is_fn_type(targ(to, i)) and is_fn_type(targ(from, i)):
            if not callable_fits(targ(to, i), targ(from, i)): return false
        else if not refine_implies(targ(to, i), targ(from, i)): return false
    if is_fn_type(int(types[from].elem)) and is_fn_type(int(types[to].elem)): return callable_fits(int(types[from].elem), int(types[to].elem))
    prune(int(types[from].elem)) == T_NEVER or refine_implies(int(types[from].elem), int(types[to].elem))

is_nd = (t0: int) -> bool:
    t = prune(t0)
    types[t].kind == .struct_ and structs[int(types[t].st)].name == "NDArray"
nd_elem = (t: int) -> int: struct_targ(int(types[prune(t)].st), 0)

check_dotted = (n: int, expected: int) -> int:
    pos = nodes[n].pos
    bc_count += 1
    tag = "{bc_count}"
    leaves: int[]
    tmpl = dot_template(n, leaves, tag)
    pre = "__b{tag}"
    stmts: int[]
    ranks: int[]
    rank = 0
    gpu = false
    loop k in [0..leaves.len()):
        lf = leaves[k]
        check_expr(lf, 0)
        lf = last_checked
        finalize_literal(lf)
        t = prune(ntype(lf))
        if types[t].kind == .fixed:
            t = mk_array(int(types[t].elem))
            lf = coerce(lf, t)
        r = 0
        if types[t].kind == .array: r = 1
        else if is_nd(t): r = 2
        else if is_gpu_array(t):
            r = 3
            gpu = true
        ranks.push(r)
        if r > rank and r < 3: rank = r
        stmts.push(bc_let("{pre}d{k}", lf, pos))
    d = (k: int) -> int: bc_ident("{pre}d{k}", pos)
    # scalars: the same value for every element
    loop k in [0..leaves.len()):
        if ranks[k] == 0: stmts.push(bc_let("{pre}e{k}", d(k), pos))
    if rank == 0 and not gpu:
        stmts.push(bc_stmt(tmpl, pos))
        nodes[n] = nodes[bc_block(stmts, pos)]
        return check_expr(n, expected)
    result = 0
    if gpu:
        # GPU arrays: one fragment program, or the same loop on the CPU where there is no GPU
        # (each operand is an f32 or i32 in the GPU program: arrays by their element type, numbers
        # by whether they are integers)
        desc = ""
        params: int[]
        gins: int[]
        fscal: int[]
        iscal: int[]
        harrs: str[]
        hstmts: int[]
        loop k in [0..leaves.len()):
            pm = mk(.param, pos)
            nodes[pm].name = i32(intern("{pre}e{k}"))
            ty = mk(.tname, pos)
            nodes[ty].aux = -7
            et = T_F32
            harrs.push("")
            if ranks[k] == 3:
                gt = prune(ntype(d0_leaf(stmts, k)))
                if is_int(struct_targ(int(types[gt].st), 0)):
                    et = T_I32
                    desc += "i"
                else: desc += "t"
                gins.push(bc_call("__gpu_in", [d(k)], pos))
                harrs[k] = "{pre}h{k}"
                hstmts.push(bc_let(harrs[k], bc_call("cpu", [d(k)], pos), pos))
            else if ranks[k] == 0:
                lt = prune(ntype(d0_leaf(stmts, k)))
                if is_int(lt):
                    et = T_I32
                    desc += "n"
                    iscal.push(bc_call("i32", [d(k)], pos))
                else:
                    desc += "s"
                    fscal.push(bc_call("f32", [d(k)], pos))
            else: fatal(nodes[leaves[k]].pos, "this array is in CPU memory: upload it with gpu(xs) to use it with GPU arrays")
            nodes[ty].ival = et
            nodes[pm].a = i32(ty)
            params.push(pm)
        lam = mk(.lambda, pos)
        set_list(lam, params)
        nodes[lam].b = i32(bc_block([bc_stmt(clone(tmpl), pos)], pos))
        # (the expression's type decides the result's: integers stay integers)
        lt = prune(check_expr(lam, 0))
        lam = last_checked
        rt = prune(int(types[lt].elem))
        if not is_int(rt) and not is_float(rt) and types[rt].kind != .bool_:
            fatal(pos, "GPU array expressions must return a fixed-width integer, float or bool, found {dt(rt)}; use CPU arrays for exact rationals and managed values")
        runf = "__gpu_run_f"
        if is_int(rt): runf = "__gpu_run_i"
        ds = mk(.str_lit, pos)
        nodes[ds].sval = i32(intern(desc))
        ga = mk(.array, pos)
        set_list(ga, gins)
        run = bc_call(runf, [bc_call("__gpu_kernel", [lam, ds], pos), ga, typed_array(fscal, T_F32, pos), typed_array(iscal, T_I32, pos)], pos)
        hkinds: int[]
        loop k in [0..leaves.len()):
            if ranks[k] == 3: hkinds.push(2)
            else: hkinds.push(0)
        loop x in bc_loop_nd(tmpl, harrs, hkinds, "{pre}c", pre, pos): hstmts.push(x)
        hb = bc_block(hstmts, pos)
        cpu = bc_call("__gpu_from", [hb], pos)
        iff = mk(.if_, pos)
        nodes[iff].a = i32(bc_call("gpu_available", [], pos))
        nodes[iff].b = i32(bc_block([bc_stmt(run, pos)], pos))
        nodes[iff].c = i32(bc_block([bc_stmt(cpu, pos)], pos))
        result = iff
    else if rank == 1:
        arrs: str[]
        loop k in [0..leaves.len()):
            if ranks[k] == 1: arrs.push("{pre}d{k}")
            else: arrs.push("")
        ls = bc_loop1(tmpl, arrs, pre, pre, pos)
        loop i in [0..ls.len() - 1): stmts.push(ls[i])
        result = int(nodes[ls[ls.len() - 1]].a)
    else:
        # n-dimensional: shapes broadcast like numpy (a 1-D array is a row)
        arrs: str[]
        loop k in [0..leaves.len()):
            if ranks[k] == 1 or ranks[k] == 2: arrs.push("{pre}d{k}")
            else: arrs.push("")
        ls = bc_loop_nd(tmpl, arrs, ranks, pre, pre, pos)
        loop i in [0..ls.len() - 1): stmts.push(ls[i])
        result = int(nodes[ls[ls.len() - 1]].a)
    stmts.push(bc_stmt(result, pos))
    nodes[n] = nodes[bc_block(stmts, pos)]
    check_expr(n, expected)

# ---------------- unions: `is` and narrowing ----------------
# x is T: aux = the member's index for a union; -1 (is none) or -2 (has a value) for an optional
# When only Map.get's outer optional tag is observed, use its presence query.
# Keep the checked expression intact for types and conservative effect analysis;
# lowering uses the original arguments and their written evaluation order.
map_presence_fn = (call: int) -> int:
    if nodes[call].kind != .call or nodes[call].aux != 0 or nkids(call) != 2: return 0
    f = int(nodes[call].sym)
    d = int(fns[f].decl)
    if d == 0 or nodes[d].name != intern("get"): return 0
    path = lib_dir + "/core/map.jo"
    if files[pos_file(nodes[d].pos)].path != path: return 0
    decls: int[]
    collect_module(int(nodes[d].mod), intern("has"), decls)
    loop candidate in decls:
        if files[pos_file(nodes[candidate].pos)].path == path:
            return get_fn_inst(candidate, fns[f].targs, nodes[call].pos)
    0

check_istype = (n: int) -> int:
    # (a variable or field path, copied before it is checked: the rewrites below test it again)
    orig = 0
    if plain_path(int(nodes[n].a)): orig = copy_path(int(nodes[n].a))
    at = prune(check_expr(int(nodes[n].a), 0))
    nodes[n].a = i32(last_checked)
    finalize_literal(int(nodes[n].a))
    at = prune(ntype(int(nodes[n].a)))
    tt = resolve_type(int(nodes[n].b))
    pos = nodes[n].pos
    # Family annotations denote every descendant, but only alternatives of the
    # tested value participate. Include none when testing exception itself.
    if nodes[int(nodes[n].b)].aux != -7 and family_annotation(tt):
        selected: int[]
        wanted = value_members(tt)
        actual = value_members(at)
        loop member in actual:
            if wanted.contains(member): selected.push(member)
        subj = is_subject(n, orig)
        condition = 0
        if selected.len() == 0 or selected.len() == actual.len():
            condition = mk(.bool_lit, pos)
            if selected.len() > 0: nodes[condition].ival = 1
        else: condition = members_test(subj, selected, pos)
        return is_rewritten(n, orig, condition)
    # x is A, x is A | B, where x: (A | B | C)?: x != none and (x is A or x is B)
    if types[at].kind == .opt and is_union(prune(int(types[at].elem))) and types[tt].kind != .none_lit:
        u = prune(int(types[at].elem))
        ms = sub_members(u, tt)
        if ms.len() > 0:
            subj = is_subject(n, orig)
            c = bc_logic(.and_, bc_bin(.ne, copy_path(subj), mk(.none_lit, pos), pos), members_test(subj, ms, pos), pos)
            return is_rewritten(n, orig, c)
    # x is A | B, where x: A | B | C: x is A or x is B
    if is_union(at) and is_union(tt) and union_index(at, tt) < 0:
        ms = sub_members(at, tt)
        if ms.len() > 0:
            subj = is_subject(n, orig)
            return is_rewritten(n, orig, members_test(subj, ms, pos))
    if is_union(at):
        vi = union_index(at, tt)
        if vi < 0: fatal(nodes[int(nodes[n].b)].pos, "{dt(tt)} is not one of the types of {dt(at)}")
        nodes[n].aux = i32(vi)
    else if types[at].kind == .opt:
        if types[tt].kind == .none_lit: nodes[n].aux = -1
        else if type_eq(tt, int(types[at].elem)) or refine_active and refine_implies(int(types[at].elem), tt): nodes[n].aux = -2
        else: fatal(nodes[int(nodes[n].b)].pos, "a {dt(at)} is either a {dt(int(types[at].elem))} or none, never a {dt(tt)}")
        nodes[n].aux2 = i32(map_presence_fn(int(nodes[n].a)))
    else if type_eq(at, tt) or (is_union(tt) and union_index(tt, at) >= 0): nodes[n].aux = -3      # (already narrowed to it, say): always true
    else: fatal(nodes[n].pos, "{jd(nodes[n].pos, "`is`", "`is?`")} tests which type a union (A | B) or optional value holds; this is always a {dt(at)}")

    T_BOOL

# what `x is ...` tests again: x itself (a variable or field path), or else its value put in a
# variable of its own (computed once)
is_subject = (n: int, orig: int) -> int:
    if orig != 0: return orig
    add_flag(int(nodes[n].a), NF_CHECKED)
    bc_ident("__is{n}", nodes[n].pos)

# node n is now test c (after setting is_subject's variable, when there is one)
is_rewritten = (n: int, orig: int, c: int) -> int:
    pos = nodes[n].pos
    if orig != 0: nodes[n] = nodes[c]
    else:
        set_v = bc_assign(bc_ident("__is{n}", pos), int(nodes[n].a), pos)
        nodes[n] = nodes[bc_block([set_v, bc_stmt(c, pos)], pos)]
    check_expr(n, 0)

# the members of union u that t is (t one of them, or a union of some of them); none: it is not
sub_members = (u: int, t: int) -> int[]:
    out: int[]
    if union_index(u, t) >= 0:
        out.push(t)
        return out
    if not is_union(t): return out
    loop m in union_members(t):
        if union_index(u, m) >= 0: out.push(m)
    out

# subj is ms[0] or subj is ms[1] ... (subj: a variable or field path, copied for each test)
members_test = (subj: int, ms: int[], pos: int) -> int:
    c = 0
    loop m in ms:
        t = mk(.istype, pos)
        nodes[t].a = i32(copy_path(subj))
        nodes[t].b = i32(type_node_of(m, pos))
        if c == 0: c = t
        else: c = bc_logic(.or_, c, t, pos)
    c

# a variable, or fields of one (a.b.c): what `is` can narrow
plain_path = (e: int) -> bool:
    k = nodes[e].kind
    if k == .ident: return true
    k == .field and plain_path(int(nodes[e].a))

# Optional operations keep their declared optional view even when an alias is
# known to hold a value. Ordinary nonoptional operands remain type errors.
narrow_optional_source = (a: int) -> int:
    if nodes[a].kind != .ident or nodes[a].aux != i32(int(SK.local)): return a
    l = int(nodes[a].sym)
    if int(locals[l].flags) & LF_ALIAS == 0: return a
    al = int(locals[l].alias)
    if al != 0 and nodes[al].kind == .unwrap: return int(nodes[al].a)
    a

# Only condition-created aliases escape a guard, never locals declared in an arm.
narrow_promote = (first: int, limit: int):
    loop l in [first..limit):
        if int(locals[l].flags) & (LF_ALIAS | LF_UNNARROWED) != LF_ALIAS: continue
        nm = int(locals[l].name)
        if nm != 0: push_scope_sym(nm, new_sym(nm, .local, l, 0))

# where condition c is `holds` (true or false), variables it tests with `is` stand for the member
narrow_by = (c: int, holds: bool):
    k = nodes[c].kind
    if k == .istype: narrow_var(c, holds)
    else if k == .binary and (nodes[c].op == i32(int(Tok.ne)) or nodes[c].op == i32(int(Tok.eq))) and nodes[int(nodes[c].b)].kind == .none_lit:
        # x != none: as `x is T` holding (x is its value from here)
        isn = mk(.istype, nodes[c].pos)
        nodes[isn].a = nodes[c].a
        nodes[isn].aux = -2
        narrow_var(isn, holds == (nodes[c].op == i32(int(Tok.ne))))
    else if k == .not_: narrow_by(int(nodes[c].a), not holds)
    else if k == .and_ and holds:
        narrow_by(int(nodes[c].a), true)
        narrow_by(int(nodes[c].b), true)
    else if k == .or_ and not holds:
        narrow_by(int(nodes[c].a), false)
        narrow_by(int(nodes[c].b), false)
    else if k == .or_ and holds:
        # x is A or x is B: x is an A | B
        tests: int[]
        if or_tests(c, tests): narrow_some(tests)

narrow_var = (isn: int, holds: bool):
    a = int(nodes[isn].a)
    if nodes[a].kind == .field or (nodes[a].kind == .ident and nodes[a].aux == i32(int(SK.global))):
        narrow_path(a, int(nodes[isn].aux), holds)
        return
    if nodes[a].kind != .ident or nodes[a].aux != i32(int(SK.local)): return
    l = int(nodes[a].sym)
    ut = prune(int(locals[l].type))
    vi = int(nodes[isn].aux)
    pos = nodes[a].pos
    if is_union(ut):
        ms = union_members(ut)
        if holds: narrow_local(l, [ms[vi]], pos)
        else:
            # (not that member: one of the others)
            rest: int[]
            loop i in 0.. and m in ms:
                if i != vi: rest.push(m)
            narrow_local(l, rest, pos)
        return
    if types[ut].kind != .opt or (vi == -2) != holds: return
    e = mk(.unwrap, pos)
    t = int(types[ut].elem)
    nodes[e].a = i32(mk_ident_local(l, pos))
    nodes[e].type = i32(t)
    add_flag(e, NF_CHECKED)
    nl = new_local(int(locals[l].name), t, pos)
    locals[nl].flags = i32(LF_ALIAS)
    locals[nl].alias = i32(e)

# from here on, union variable l is known to hold one of members ms: its name stands for that
# member (one) or the smaller union of them (converted from the variable's value when used)
narrow_local = (l: int, ms: int[], pos: int):
    # (a variable already narrowed to some of its members: narrow the variable itself)
    root = mk_ident_local(l, pos)
    if int(locals[l].flags) & LF_ALIAS != 0:
        al = int(locals[l].alias)
        if nodes[al].kind == .conv and nodes[al].aux == i32(int(CV.union_)): root = copy_path(int(nodes[al].a))
    narrow_expr(root, ms, pos, int(locals[l].name))

# the name `name` stands for root (a variable or field path) narrowed to members ms of its union
narrow_expr = (root: int, ms: int[], pos: int, name: int):
    rt = prune(ntype(root))
    if ms.len() == 0: return
    e = 0
    t = 0
    if types[rt].kind == .opt:
        if ms.len() != 1 or not type_eq(ms[0], telem(rt)): return
        e = mk(.unwrap, pos)
        t = telem(rt)
    else if not is_union(rt): return
    else if ms.len() == 1:
        e = mk(.narrow, pos)
        nodes[e].aux = i32(union_index(rt, ms[0]))
        t = ms[0]
    else:
        t = mk_union(ms)
        if type_eq(t, rt): return
        e = mk(.conv, pos)
        nodes[e].aux = i32(int(CV.union_))
    nodes[e].a = i32(root)
    nodes[e].type = i32(t)
    add_flag(e, NF_CHECKED)
    nl = new_local(name, t, pos)
    locals[nl].flags = i32(LF_ALIAS)
    locals[nl].alias = i32(e)

# ---- narrowing field paths (x.f, x.f.g, a global g) ----
# a narrowed path is a scope entry named by its key ("#L<local>.<field>...", "#G<global>..."),
# standing for an alias local; the tag is still checked when the value is used (a call or a
# closure may have changed it)
path_narrows = 0                # (none yet: field accesses need not look)
no_narrow_at = 0                # (the target of an assignment: the field or global itself, not what it narrows to; a narrowed
                                # path it is a part of, as x in x.hp = 7, is still narrowed)

path_key = (n: int) -> str:
    k = nodes[n].kind
    if k == .ident:
        if nodes[n].aux == i32(int(SK.local)): return "#L{nodes[n].sym}"
        if nodes[n].aux == i32(int(SK.global)): return "#G{nodes[n].sym}"
        return ""
    if k == .field and nodes[n].aux >= 0 and nodes[n].a != 0:
        a = int(nodes[n].a)
        if tkind(ntype(a)) != .struct_: return ""
        b = path_key(a)
        if len(b) == 0: return ""
        return "{b}.{nodes[n].aux}"
    ""

# a checked copy of a field path
copy_path = (n: int) -> int:
    c = nodes.len()
    nodes.push(nodes[n])
    if nodes[n].kind == .field: nodes[c].a = i32(copy_path(int(nodes[n].a)))
    c

# the alias local a field path (or global) is narrowed to here, or -1
path_alias = (n: int) -> int:
    key = path_key(n)
    if len(key) == 0: return -1
    s = lookup(intern(key))
    if s == 0 or syms[s].kind != .local: return -1
    al = int(syms[s].ref)
    if int(locals[al].owner) != int(ctxs[cx].inst) or int(locals[al].flags) & LF_UNNARROWED != 0: return -1
    al

narrow_path = (a: int, vi: int, holds: bool):
    key = path_key(a)
    if len(key) == 0: return
    ut = prune(ntype(a))
    pos = nodes[a].pos
    path_narrows += 1
    if is_union(ut):
        sel: int[]
        loop i in 0.. and m in union_members(ut):
            if (i == vi) == holds: sel.push(m)
        narrow_expr(copy_path(a), sel, pos, intern(key))
    else if types[ut].kind == .opt and (vi == -2) == holds:
        e = mk(.unwrap, pos)
        nodes[e].a = i32(copy_path(a))
        nodes[e].type = types[ut].elem
        add_flag(e, NF_CHECKED)
        nl = new_local(intern(key), int(types[ut].elem), pos)
        locals[nl].flags = i32(LF_ALIAS)
        locals[nl].alias = i32(e)

# the `x is M` tests (of members) an or-chain is made of; false: it has something else too
or_tests = (c: int, out: mut int[]) -> bool:
    k = nodes[c].kind
    if k == .or_: return or_tests(int(nodes[c].a), out) and or_tests(int(nodes[c].b), out)
    if k == .istype and nodes[c].aux >= 0:
        out.push(c)
        return true
    false

# x is A or x is B ... holding: x is one of those members (when all test the same x)
narrow_some = (tests: int[]):
    a0 = int(nodes[tests[0]].a)
    ut = prune(ntype(a0))
    if not is_union(ut): return
    local = nodes[a0].kind == .ident and nodes[a0].aux == i32(int(SK.local))
    key = ""
    if not local:
        key = path_key(a0)
        if len(key) == 0: return
    ms = union_members(ut)
    sel: int[]
    loop t in tests:
        a = int(nodes[t].a)
        if local:
            if nodes[a].kind != .ident or nodes[a].sym != nodes[a0].sym: return
        else if path_key(a) != key: return
        m = ms[int(nodes[t].aux)]
        if not sel.contains(m): sel.push(m)
    if local: narrow_local(int(nodes[a0].sym), sel, nodes[a0].pos)
    else:
        path_narrows += 1
        narrow_expr(copy_path(a0), sel, nodes[a0].pos, intern(key))

# the path (and paths inside it) may hold another value from here on: forget their narrowing
path_forget = (key: str, same_type: int = 0):
    if path_narrows == 0 or len(key) == 0: return
    prefix = key + "."
    i = sc_names.len() - 1
    floor = int(ctxs[cx].floor)
    loop i >= floor:
        nm = name_of(sc_names[i])
        if nm == key or starts_with(nm, prefix):
            sy = sc_syms[i]
            if syms[sy].kind == .local:
                l = int(syms[sy].ref)
                if int(locals[l].flags) & LF_ALIAS != 0:
                    # Replacing a known member with the same member preserves
                    # its tag, but invalidates any facts about fields inside it.
                    keep = false
                    if nm == key and same_type != 0:
                        t = prune(int(locals[l].type))
                        keep = type_eq(t, same_type) or (is_union(t) and union_index(t, same_type) >= 0)
                    if not keep: narrow_invalidate(l)
                    # Nested paths can use this alias as their root after the
                    # parent was narrowed, rather than the original path text.
                    path_forget("#L{l}")
        i -= 1

check_iflet = (n: int, ex: int) -> int:
    is_stmt = has_flag(n, NF_STMT)
    ot = prune(check_expr(int(nodes[n].a), 0))
    if types[ot].kind != .opt:
        nodes[n].a = i32(narrow_optional_source(int(nodes[n].a)))
        ot = prune(ntype(int(nodes[n].a)))
    if types[ot].kind != .opt: fatal(nodes[int(nodes[n].a)].pos, "'if let x = value' needs an optional value, found {dt(ot)}")
    mark = scope_mark()
    l = new_local(int(nodes[n].name), int(types[ot].elem), nodes[n].pos)
    nodes[n].sym = i32(l)
    b = int(nodes[n].b)
    c = int(nodes[n].c)
    e1 = ex
    if is_stmt: e1 = 0
    changes = narrow_changes.len()
    jumps = narrow_jumps.len()
    t1 = check_block(b, e1, not is_stmt)
    if narrow_changes.len() != changes: narrow_returned(changes, jumps, b)
    scope_reset(mark)
    t2 = T_VOID
    if c != 0:
        first = narrow_restore(changes)
        e2 = ex
        if e2 == 0: e2 = t1
        if is_stmt: e2 = 0
        jumps = narrow_jumps.len()
        t2 = check_block(c, e2, not is_stmt)
        if narrow_changes.len() != changes: narrow_returned(changes, jumps, c)
        narrow_merge(first)
    if is_stmt: return T_VOID
    if c == 0: fatal(nodes[n].pos, "an if expression needs an else branch")
    # (branches that are statements, as at the end of a function: no value, as check_if)
    if t1 == T_NEVER and t2 == T_NEVER: return T_NEVER
    if t1 != T_NEVER and nodes[b].aux == 0 and tkind(t1) == .void_: return T_VOID
    if t2 != T_NEVER and nodes[c].aux == 0 and tkind(t2) == .void_ and ex == 0: return T_VOID
    if t1 == T_NEVER: return t2
    if t2 == T_NEVER: return t1
    if nodes[b].aux == 0 or nodes[c].aux == 0: fatal(nodes[n].pos, "both branches of an if expression need a value")
    va = block_value(b)
    vb = block_value(c)
    if ex != 0:
        coerce(va, ex)
        coerce(vb, ex)
        return ex
    join_types(va, vb, nodes[n].pos)

$runtime_checks
from p"checks_thin.dewy" import (jd)
from p"policy_value_queries.dewy" import (setting_value_needed)
from p"callable_policies.dewy" import (setting_value_named)
from p"proofs.jo" import (proof_active proof_decls)
from p"poly_closure.jo" import (poly_families)
from p"expression_types.dewy" import (ntype)
from p"call_argument_checks.dewy" import (match_type)
from p"checker_type_entries.dewy" import (get_fn_inst)
from p"check.jo" import (fns)
from p"types.jo" import (fn_type_pack has_var prune targ tkind type_eq types)
from p"checker_signature.dewy" import (fn_sig)
from p"checks_call_errors.dewy" import (fn_has_defaults game_name_hint)
from p"callable_checks.dewy" import (fn_adapts)
from p"callable_compatibility.dewy" import (fn_adapter)
from p"util.jo" import (files intern name_of pos_file)
from p"float_ops.dewy" import (ff_note_ref)
from p"diagnostic_exit.dewy" import (fatal)
from p"effects.jo" import (effects_active)
from p"effect_sources.dewy" import (effect_infer_callable)
from p"directives.jo" import (dir_floats_any dir_runtime_policies)
from p"surface_names.dewy" import (dewy_quantity_name)
from p"checker_source_positions.dewy" import (dewy_at)
from p"checker_module_lookup.dewy" import (demand_name)
from p"call_lookup_context.dewy" import (decl_in_prelude)
from p"type_ops.dewy" import (decl_fn_labels dt mk_cfn mk_fn)
from p"effect_contracts.dewy" import (callable_base callable_contract effect_contract_fits effect_subst mk_callable_contract)
from p"expr.jo" import (call_collect_fns call_collect_named fn_used quantity_call_names)
from p"coercion_queries.dewy" import (can_coerce)
from p"checker_contexts.dewy" import (bound_here)
from p"checks_compare_hints.dewy" import (bare_variant_hint)
from p"ast.jo" import (NF_MUT has_flag kid nkids nodes)

FunctionValueChecksWord:type=int64<overflow='wrap'>

fn_value=(n:int64 expected:int64 explicit_types:array<int64>=[] mod:int64=-1 closure:int64=0):>int64=>$unsafe {
    let decls:array<int64>=[]
    if closure not=? 0 {decls.push(poly_families[FunctionValueChecksWord(types.ptr[prune(ntype(closure))].st)].decl)}
    else {call_collect_named(FunctionValueChecksWord(nodes.ptr[n].name) mod @decls)}
    if mod <? 0 and closure =? 0 and nodes.ptr[n].name =? int32<overflow='wrap'>(intern("to_int")) and dewy_at(nodes.ptr[n].pos) and not bound_here(FunctionValueChecksWord(nodes.ptr[n].name)) {
        let own=false
        loop d in decls {
            if not decl_in_prelude(d) {own=true}
        }
        if not own {
            let parser=intern("__mi_parse")
            demand_name(parser)
            decls=[]
            call_collect_fns(parser @decls)
        }
    }
    if proof_active {
        loop d in decls {
            if proof_decls.has(d) {fatal(nodes.ptr[n].pos "a proof cannot be used as a value")}
        }
    }
    # (`@sin`: the trigonometry takes angles, so it is no function of a plain number)
    if mod <? 0 and closure =? 0 and dewy_quantity_name(FunctionValueChecksWord(nodes.ptr[n].name)) and nodes.ptr[n].name not=? int32<overflow='wrap'>(quantity_call_names[0]) and dewy_at(nodes.ptr[n].pos) and decls.length >? 0 and decl_in_prelude(decls[0]) and not bound_here(FunctionValueChecksWord(nodes.ptr[n].name)) {
        let fname=name_of(FunctionValueChecksWord(nodes.ptr[n].name))
        fatal(nodes.ptr[n].pos "{fname} takes an angle, so `@{fname}` is no function of a plain number: write `(x:float64) => {fname}(x * rad)` for radians (`from units import rad`)")
    }
    let et=callable_base(expected)
    if expected =? 0 {et=0}
    # Only inferred Dewy handles prefer a concrete program declaration.
    # Keep Sloppy implementation-library values and contextual overload matching
    # on their existing resolution path.
    if explicit_types.length =? 0 and files.ptr[pos_file(nodes.ptr[n].pos)].is_dewy and (et =? 0 or (types.ptr[et].kind not=? 'fn_' and types.ptr[et].kind not=? 'cfn')) {
        let own:array<int64>=[]
        loop d in decls {
            if not decl_in_prelude(d) and not fn_sig(d).generic {own.push(d)}
        }
        if own.length =? 1 {decls=own}
    }
    let f:FunctionValueChecksWord=0
    let selected:FunctionValueChecksWord=0
    let selected_binds:array<int64>=[]
    loop d in decls {
        let sig=fn_sig(d)
        if explicit_types.length >? 0 and explicit_types.length not=? FunctionValueChecksWord(sig.nexplicit) {continue}
        let binds:array<int64>=fill(0 FunctionValueChecksWord(sig.ntp))
        loop i in 0.. and t in explicit_types {binds[i] = t}
        if et not=? 0 and (types.ptr[et].kind =? 'fn_' or types.ptr[et].kind =? 'cfn') {
            if FunctionValueChecksWord(types.ptr[et].nargs) not=? nkids(d) {continue}
            let ok=true
            loop i in [0..FunctionValueChecksWord(types.ptr[et].nargs)) {
                let r=match_type(sig.params[i] targ(et i) @binds 0)
                if r <? 0 or r =? 1 {
                    ok=false
                    break
                }
            }
            if not ok {continue}
            # (type parameters only in the result: from the expected result, zero = () -> T)
            if sig.ret not=? 0 and types.ptr[et].kind =? 'fn_' and FunctionValueChecksWord(types.ptr[et].elem) not=? 0 {
                let rb=binds
                if match_type(FunctionValueChecksWord(sig.ret) FunctionValueChecksWord(types.ptr[et].elem) @rb 0) >=? 0 {binds=rb}
            }
            loop b in binds {
                if b =? 0 {ok=false}
            }
            loop i in 0.. and t in explicit_types {
                if not type_eq(binds[i] t) {ok=false}
            }
            if not ok {continue}
            f=get_fn_inst(d binds nodes.ptr[n].pos)
            break
        }
        else if explicit_types.length >? 0 {
            let complete=true
            loop b in binds {
                if b =? 0 {complete=false}
            }
            if not complete {continue}
            if selected not=? 0 {fatal(nodes.ptr[n].pos "multiple versions of '{name_of(FunctionValueChecksWord(nodes.ptr[n].name))}' match these type arguments; give the function value a callable type")}
            selected=d
            selected_binds=binds
        }
        else if not sig.generic and decls.length =? 1 {f=get_fn_inst(d [] nodes.ptr[n].pos)}
    }
    if selected not=? 0 {f=get_fn_inst(selected selected_binds nodes.ptr[n].pos)}
    # (a function whose parameters accept the expected ones and whose result
    # fits the expected result stands in through a wrapper: `@f` with
    # f:(x:int64|string):>uint64? where <(x:int64):>uint64?|E> is expected)
    if explicit_types.length =? 0 and mod <? 0 and closure =? 0 and et not=? 0 and types.ptr[et].kind =? 'fn_' and files.ptr[pos_file(nodes.ptr[n].pos)].is_dewy {
        let fits:FunctionValueChecksWord=0
        if f not=? 0 {
            let ret=FunctionValueChecksWord(fns.ptr[f].ret)
            let want=FunctionValueChecksWord(types.ptr[et].elem)
            if want not=? 0 and ret not=? 0 and tkind(want) not=? 'refined' and not type_eq(prune(ret) prune(want)) and can_coerce(0 ret want) {fits=1}
        }
        else {
            loop d in decls {
                if fn_adapts(d et) {fits += 1}
            }
        }
        if fits =? 1 {return fn_adapter(n et expected)}
    }
    if f =? 0 {
        if explicit_types.length >? 0 {fatal(nodes.ptr[n].pos "no version of '{name_of(FunctionValueChecksWord(nodes.ptr[n].name))}' matches these type arguments and callable type")}
        if et not=? 0 and types.ptr[et].kind =? 'fn_' {
            let nm=name_of(FunctionValueChecksWord(nodes.ptr[n].name))
            let hint=""
            if nm =? "update" {hint=" (the game calls update each frame with the seconds since the last one: {jd(nodes.ptr[n].pos "`update = (dt: f64): ...`" "`update = (dt:float64) => ...`")}{game_name_hint(nodes.ptr[n].pos nm)})"}
            if nm =? "draw" {hint=" (the game calls draw with nothing: {jd(nodes.ptr[n].pos "`draw = (): ...`" "`draw = () => ...`")}{game_name_hint(nodes.ptr[n].pos nm)})"}
            fatal(nodes.ptr[n].pos "no version of '{nm}' matches {dt(et)}{hint}")
        }
        fatal(nodes.ptr[n].pos "cannot use overloaded or generic function '{name_of(FunctionValueChecksWord(nodes.ptr[n].name))}' as a value without a known type{bare_variant_hint(FunctionValueChecksWord(nodes.ptr[n].name))}")
    }
    let mm:FunctionValueChecksWord=0
    let d=FunctionValueChecksWord(fns.ptr[f].decl)
    if d not=? 0 {fn_used[d] = true}
    if dir_floats_any {ff_note_ref(d)}
    loop i in [0..fns.ptr[f].ptypes.length) {
        if has_flag(kid(d i) NF_MUT) {mm |= 1 << i}
    }
    nodes[n].kind = 'fnref'
    nodes[n].sym = int32<overflow='wrap'>(f)
    if closure not=? 0 {
        nodes[n].a = int32<overflow='wrap'>(closure)
        nodes[n].aux = 2
    }
    # (with no contract to fit, the handle keeps the function's defaults:
    # `g = @f` then `g(1)` fills f's later parameters as `f(1)` would)
    let keeps:FunctionValueChecksWord=0
    if et =? 0 and closure =? 0 and fn_has_defaults(d) {keeps=f}
    let labels=if et not=? 0 and types.ptr[et].kind =? 'fn_' {FunctionValueChecksWord(types.ptr[et].st)} else {decl_fn_labels(d)}
    if et not=? 0 and types.ptr[et].kind =? 'fn_' and fn_type_pack(et) not=? (fns.ptr[f].pack not=? 0) {
        let fname=name_of(FunctionValueChecksWord(nodes.ptr[n].name))
        fatal(nodes.ptr[n].pos if fns.ptr[f].pack not=? 0 {"'{fname}' gives several values, and {dt(et)} gives one"} else {"'{fname}' gives one value, and {dt(et)} gives several"})
    }
    let t=mk_fn(fns.ptr[f].ptypes FunctionValueChecksWord(fns.ptr[f].ret) mm labels keeps fns.ptr[f].pack not=? 0)
    if et not=? 0 and types.ptr[et].kind =? 'cfn' {
        if not fns.ptr[f].cabi {fatal(nodes.ptr[n].pos "'{name_of(FunctionValueChecksWord(nodes.ptr[n].name))}' must be marked {jd(nodes.ptr[n].pos "@cabi" "`$export`")} to be used as a C function pointer")}
        t=mk_cfn(fns.ptr[f].ptypes FunctionValueChecksWord(fns.ptr[f].ret))
        nodes[n].aux = 1
    }
    if nodes.ptr[d].sval not=? 0 {t=mk_callable_contract(t effect_subst(FunctionValueChecksWord(fn_sig(d).contract) fns.ptr[f].targs))}
    nodes[n].type = int32<overflow='wrap'>(t)
    if effects_active {t=effect_infer_callable(n expected)}
    if callable_contract(expected) not=? 0 and not has_var(expected) and not effect_contract_fits(t expected) {fatal(nodes.ptr[n].pos "cannot prove callable effect contract")}
    nodes[n].type = int32<overflow='wrap'>(t)
    if dir_runtime_policies.length not=? 0 and setting_value_needed(n) {return setting_value_named(n t expected)}
    t
}

# What a constant check may evaluate (constant_checks.dewy): an argument that needs no run-time value,
# and a call that cannot fail folded to its value, so a literal such as `instant"..."` costs nothing
# when the program runs. Demand-driven: reached only from a call of a function with a constant check.
use 'checker_state.dewy'
use 'ast.jo'
use 'check.jo'
use 'comptime.jo'
use 'directives.jo'
use 'warn_if.jo'
use 'expr.jo'
use 'types.jo'
use 'units.jo'
use 'unit_ops.dewy'
use 'util.jo'
use 'errors.jo'
use 'error_ops.dewy'
use 'constant_fold_ops.dewy'


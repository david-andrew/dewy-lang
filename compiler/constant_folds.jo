# What a constant check may evaluate (constant_checks.dewy): an argument that needs no run-time value,
# and a call that cannot fail folded to its value, so a literal such as `instant"..."` costs nothing
# when the program runs. Demand-driven: reached only from a call of a function with a constant check.
use 'checker_state.dewy'
use 'ast.jo'
use 'check.jo'
use 'comptime.jo'
use 'directives.jo'
use 'warn_if.jo'
use 'expr.jo'
use 'types.jo'
use 'units.jo'
use 'util.jo'
use 'errors.jo'
use 'error_ops.dewy'

# (a record of scalars, however nested, holding nothing a run would have to allocate)
cc_plain = (t: int) -> bool:
    if tkind(t) != .struct_: return is_int(t) or tkind(t) == .bool_
    si = int(types[t].st)
    loop i in [0..int(structs[si].nfields)):
        if not cc_plain(int(fields[int(structs[si].fields) + i].type)): return false
    true

# (does this checked expression need no run-time value? a literal, a constant, a record of them,
# or an operator over them: evaluating one at compile time can have no effect)
cc_closed_expr = (x: int, depth: int) -> bool:
    if depth > 16: return false
    if is_quantity(ntype(x)) and quantity_constant_scale(x) >= 0: return true
    k = nodes[x].kind
    if k == .int_lit or k == .str_lit or k == .bool_lit or k == .none_lit or k == .float_lit or k == .dotname: return nkids(x) == 0
    if k == .conv or k == .narrow: return nodes[x].a != 0 and cc_closed_expr(int(nodes[x].a), depth + 1)
    if k == .ident:
        b = nodes[x].aux as SK
        if b != .const_ and b != .global and b != .local: return false
        initial = binding_const_init(b, int(nodes[x].sym), nodes[x].pos)
        return initial != 0 and cc_closed_expr(initial, depth + 1)
    if k == .call:
        # (a record, or a value wrapped in a union)
        if nodes[x].aux != 2 and nodes[x].aux != 3:
            if nodes[x].sym <= 0 or nodes[x].aux != 0: return false
            d = int(fns[int(nodes[x].sym)].decl)
            if d == 0: return false
            name = name_of(int(nodes[d].name))
            if name != "__mul__" and name != "__add__" and name != "__sub__" and name != "__unary_sub__": return false
        loop i in [0..nkids(x)):
            if not cc_closed_expr(kid(x, i), depth + 1): return false
        return true
    false

# A call whose success type is one plain record, every argument closed: evaluated now, and when it
# succeeds its value replaces the call, with no validator run needed. 0 when it stays a call: a
# failure then goes to the validator, for the message.
# Does this call have an argument known only when the program runs? `$time.zone = 'system'`, or
# a none its `$warn_if` warns of, as `zoned` with no zone set. Then folding could reach what a
# compile cannot read, so the validators speak first, and what they pass assumes nothing. O(kids).
cc_waits_for_validators = (n: int, decl: int) -> bool:
    loop i in [0..nkids(n)):
        x = kid(n, i)
        if nodes[x].kind == .conv and nodes[x].a != 0: x = int(nodes[x].a)
        if nodes[x].kind == .str_lit and name_of(int(nodes[x].sval)) == "system": return true
    if wi_decls.has(decl):
        loop w in wi_decls[decl]:
            if w.param < 0 or w.param >= nkids(n): continue
            x = kid(n, w.param)
            if nodes[x].kind == .conv and nodes[x].a != 0: x = int(nodes[x].a)
            if nodes[x].kind == .none_lit: return true
    false

# (every argument constant and the value a plain record: the value, nothing at run time)
cc_fold_first = (n: int, decl: int) -> int:
    # (a fold could reach zone rules that exist only when the program runs: the validators say)
    if dir_rules_from_host or cc_waits_for_validators(n, decl): return 0
    cc_fold_value(n)

# (after the validators passed a call that waited for them)
cc_fold_after = (n: int, decl: int) -> int:
    if dir_rules_from_host or not cc_waits_for_validators(n, decl): return 0
    cc_fold_value(n)

cc_fold_value = (n: int) -> int:
    rt = prune(ntype(n))
    if not is_union(rt): return 0
    kept: int[]
    loop m in union_members(rt):
        if not exception_member(m): kept.push(m)
    if kept.len() != 1 or kept.len() == union_members(rt).len(): return 0
    t = kept[0]
    if tkind(t) != .struct_ or not cc_plain(t): return 0
    loop i in [0..nkids(n)):
        if not cc_closed_expr(kid(n, i), 0): return 0
    value = ct_values[ct_run(n)]
    # (a union's value holds the member's)
    if value.items.len() < 1 or prune(ct_values[value.items[0]].type) != t: return 0
    made = ct_literal(value.items[0], nodes[n].pos)
    nodes[n] = nodes[made]
    t

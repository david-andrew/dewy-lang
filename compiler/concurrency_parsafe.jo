# Frozen demanded parallel callback contracts.
use 'check.jo'
use 'concurrency.jo'
use 'checker_state.dewy'
use 'util.jo'
use 'lower_races.dewy'
use 'ast.jo'
use 'expr.jo'
use 'types.jo'
use 'concurrency_tasks.dewy'

parsafe_key = (f: int, i: int) -> int: (f << 8) | i


# The parameter (function, index) a variable is: through captures to the enclosing function's
# own binding, which must still be the one its caller gave; (0, -1) for any other variable.
parsafe_param_local = (l0: int) -> (int, int):
    l = l0
    loop int(locals[l].flags) & LF_CAPTURE != 0 and locals[l].outer > 0: l = int(locals[l].outer)
    fl = int(locals[l].flags)
    if fl & LF_PARAM == 0 and fl & (LF_VALUEPARAM | LF_ASSIGNED) != LF_VALUEPARAM: return (0, -1)
    g = int(locals[l].owner)
    if g <= 0 or g >= fns.len(): return (0, -1)
    # (a Dewy value parameter's own binding stands for the hidden parameter of its name)
    loop i in [0..fns[g].params.len()):
        p = fns[g].params[i]
        if (p == l or fl & LF_VALUEPARAM != 0 and locals[p].name == locals[l].name) and i < 256: return (g, i)
    (0, -1)


parsafe_param = (a0: int) -> (int, int):
    a = a0
    loop nodes[a].kind == .conv: a = int(nodes[a].a)
    if nodes[a].kind != .ident or nodes[a].aux != i32(int(SK.local)): return (0, -1)
    parsafe_param_local(int(nodes[a].sym))


parsafe_require = (g: int, i: int, via: ParSafeVia):
    k = parsafe_key(g, i)
    if parsafe_req.has(k): return
    parsafe_req[k] = via
    parsafe_fns[g] = true
    parsafe_work.push(k)


# Whether a callback (an argument, or what a call calls) is a parameter that every call of its
# function checks: then it is parallel-safe wherever it runs (race_check, race_scan).
parsafe_vouched = (a: int) -> bool:
    if parsafe_fns.len() == 0: return false
    g, i = parsafe_param(a)
    g > 0 and parsafe_req.has(parsafe_key(g, i))


parsafe_vouched_local = (l: int) -> bool:
    if parsafe_fns.len() == 0: return false
    g, i = parsafe_param_local(l)
    g > 0 and parsafe_req.has(parsafe_key(g, i))


parsafe_fn_name = (f: int) -> str:
    d = int(fns[f].decl)
    if d == 0 or nodes[d].kind != .fn_: return "this function"
    name_of(int(nodes[d].name))


parsafe_param_name = (f: int, i: int) -> str: name_of(int(locals[fns[f].params[i]].name))


# How a parallel call reads in a note: `parallel` for the loop and comprehension forms.
parsafe_parallel_name = (n: int) -> str:
    nm = parsafe_fn_name(int(nodes[n].sym))
    if starts_with(nm, "__dewy_parallel"): return "`parallel`"
    nm


# The parallel calls' callback parameters: direct (`parallel_map(xs @f)`) or captured by the
# function they run (`[parallel x in xs f(x)]`).
parsafe_roots = ():
    loop n in concurrency_calls:
        if in_lib(nodes[n].pos): continue
        loop a in kids(n):
            if tkind(ntype(a)) != .fn_: continue
            g, i = parsafe_param(a)
            if g > 0:
                parsafe_require(g, i, ParSafeVia(n, 0, 0))
                continue
            c = a
            loop nodes[c].kind == .conv: c = int(nodes[c].a)
            if nodes[c].kind != .lambda or nodes[c].sym <= 0: continue
            loop cap in fns[int(nodes[c].sym)].caps:
                if tkind(int(locals[int(cap.inner)].type)) != .fn_: continue
                h, j = parsafe_param_local(int(cap.outer))
                if h <= 0: continue
                parsafe_require(h, j, ParSafeVia(n, 0, 0))


# The program's direct calls, by callee (a list threaded through call_next from call_head), and
# its function values (fnref, partial).
parsafe_index = (n: int, call_head: mut {int: int}, call_node: mut int[], call_next: mut int[], values: mut int[]):
    if n == 0: return
    k = nodes[n].kind
    if k == .lambda: return
    if k == .call and nodes[n].aux == 0 and nodes[n].sym > 0:
        g = int(nodes[n].sym)
        nx = -1
        if call_head.has(g): nx = call_head[g]
        call_head[g] = call_node.len()
        call_node.push(n)
        call_next.push(nx)
    else if (k == .fnref or k == .partial and nodes[n].aux == 0) and nodes[n].sym > 0: values.push(n)
    parsafe_index(int(nodes[n].a), call_head, call_node, call_next, values)
    parsafe_index(int(nodes[n].b), call_head, call_node, call_next, values)
    if k != .for_:
        parsafe_index(int(nodes[n].c), call_head, call_node, call_next, values)
        if k != .partial: parsafe_index(int(nodes[n].d), call_head, call_node, call_next, values)
    loop i in [0..nkids(n)): parsafe_index(kid(n, i), call_head, call_node, call_next, values)
    loop i in [0..nkids2(n)): parsafe_index(kid2(n, i), call_head, call_node, call_next, values)


# The chain from g's parameter i to the parallel use, as notes on the error it ends in.
parsafe_notes = (g0: int, i0: int):
    g = g0
    i = i0
    loop true:
        via = parsafe_req[parsafe_key(g, i)]
        if via.callee == 0:
            err_notes.push((nodes[via.site].pos, "note: {parsafe_fn_name(g)} runs '{parsafe_param_name(g, i)}' on many threads at once here, through {parsafe_parallel_name(via.site)}"))
            return
        err_notes.push((nodes[via.site].pos, "note: {parsafe_fn_name(g)} passes '{parsafe_param_name(g, i)}' on to {parsafe_fn_name(int(via.callee))}'s parameter '{parsafe_param_name(int(via.callee), int(via.param))}' here"))
        g = int(via.callee)
        i = int(via.param)


# Argument i of call c, to g: checked as the parallel call would check it, or passed up.
parsafe_arg = (c: int, g: int, i: int):
    a = kid(c, i)
    h, j = parsafe_param(a)
    if h > 0:
        parsafe_require(h, j, ParSafeVia(c, g, i))
        return
    err_notes.push((nodes[a].pos, "note: this is given to {parsafe_fn_name(g)}'s parameter '{parsafe_param_name(g, i)}', which must be parallel-safe"))
    parsafe_notes(g, i)
    who = "{parsafe_fn_name(g)} (through its parameter '{parsafe_param_name(g, i)}')"
    b = a
    loop nodes[b].kind == .conv: b = int(nodes[b].a)
    k = nodes[b].kind
    if k != .lambda and k != .fnref and k != .partial: fatal(nodes[a].pos, "{who} runs this function on many threads at once, so the compiler checks it for data races, which it can only do for a function it can see: pass a function by name or a lambda")
    concurrency_callback(a)
    race_arg(a, who)
    err_notes = []


parsafe_finalize = ():
    parsafe_roots()
    if parsafe_work.len() > 0:
        call_head: {int: int}
        call_node: int[]
        call_next: int[]
        values: int[]
        loop f in [1..fns.len()):
            if fns[f].state != 2 or fns[f].body == 0 or in_lib(nodes[int(fns[f].body)].pos): continue
            parsafe_index(int(fns[f].body), call_head, call_node, call_next, values)
        loop parsafe_work.len() > 0:
            key = parsafe_work.pop()
            g = key >> 8
            i = key & 255
            at = -1
            if call_head.has(g): at = call_head[g]
            loop at >= 0:
                c = call_node[at]
                if i < nkids(c): parsafe_arg(c, g, i)
                at = call_next[at]
        loop v in values:
            h = int(nodes[v].sym)
            if not parsafe_fns.has(h): continue
            loop j in [0..fns[h].params.len()):
                if not parsafe_req.has(parsafe_key(h, j)): continue
                parsafe_notes(h, j)
                fatal(nodes[v].pos, "{parsafe_fn_name(h)} runs its parameter '{parsafe_param_name(h, j)}' on many threads at once, so it can only be called directly (where the compiler checks the function given for '{parsafe_param_name(h, j)}'), not used as a value or partially applied")
    if parsafe_tags.len() > 0: parsafe_tags_check()


# `$parallel_safe` (parsafe_tags, by declaration): each checked instance must take a callback and
# still pass every callback parameter into parallel code, so an edit to the body cannot quietly
# drop the requirement its callers are held to. O(tagged instances x parameters).
parsafe_tags_check = ():
    loop d, pos in parsafe_tags:
        di = int(nodes[d].sym)
        if di <= 0: continue
        loop f in decl_infos[di].insts:
            if fns[f].state != 2 or fns[f].body == 0: continue
            callback = false
            loop t in fns[f].ptypes:
                if tkind(t) == .fn_: callback = true
            if not callback: fatal(pos, "`$parallel_safe` holds callers to giving a parallel-safe function for each callback parameter, but {parsafe_fn_name(f)} takes no function, so the tag would check nothing: remove it")
            loop i in [0..fns[f].ptypes.len()):
                if tkind(fns[f].ptypes[i]) != .fn_ or i >= fns[f].params.len() or parsafe_req.has(parsafe_key(f, i)): continue
                fatal(pos, "`$parallel_safe` says {parsafe_fn_name(f)} runs its callback '{parsafe_param_name(f, i)}' on many threads at once, so its callers must give a parallel-safe function, but its body no longer passes '{parsafe_param_name(f, i)}' into parallel code: pass it into parallel code again, or remove the tag (this loosens what callers are held to)")


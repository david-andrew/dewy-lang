$runtime_checks
from p"node_store.dewy" import Node
from p"checker_types.dewy" import (TypeInfo TK)
from p"source_types.dewy" import SrcFile
from p"type_inference.dewy" import tu_prune
from p"type_constructors.dewy" import (tb_mk_var tb_mk_opt)
from p"checker_exact.dewy" import exact_candidate
from p"expr.jo" import (coerce charlike_to_int finalize_literal fmt_part literal_interpolation_warning literal_float_error)
from p"effects.jo" import effect_infer_callable
from p"exact.jo" import exact_note
from p"checker_expr.dewy" import check_expr
# Literal expression checking and common type publication. Scalar paths are O(1)
# plus inference links; interpolation visits only its parts and demanded checks.
# The host retains coercion/effects, exactness and source diagnostic obligations;
# repay these services with their own semantic groups, preserving callback order.
XLWord:type=int64<overflow='wrap'>
CheckerLiteralInput:type=[
    nodes:ptr<array<Node>>
    lists:ptr<array<int32>>
    types:ptr<array<TypeInfo>>
    files:ptr<array<SrcFile>>
    refine:ptr<bool>
    effects:ptr<bool>
    exact_measure:ptr<bool>
    last:ptr<int64>
    string_type:ptr<int64>
    float_type:ptr<int64>
    bool_type:ptr<int64>
    null_type:ptr<int64>
    int_type:ptr<int64>
    math_int:ptr<int64>
]
let xl_nodes:ptr<array<Node>>=$unsafe (uint64(0) as ptr<array<Node>>)
let xl_lists:ptr<array<int32>>=$unsafe (uint64(0) as ptr<array<int32>>)
let xl_types:ptr<array<TypeInfo>>=$unsafe (uint64(0) as ptr<array<TypeInfo>>)
let xl_files:ptr<array<SrcFile>>=$unsafe (uint64(0) as ptr<array<SrcFile>>)
let xl_refine:ptr<bool>=$unsafe (uint64(0) as ptr<bool>)
let xl_effects:ptr<bool>=$unsafe (uint64(0) as ptr<bool>)
let xl_exact_measure:ptr<bool>=$unsafe (uint64(0) as ptr<bool>)
let xl_last:ptr<int64>=$unsafe (uint64(0) as ptr<int64>)
let xl_string_type:ptr<int64>=$unsafe (uint64(0) as ptr<int64>)
let xl_float_type:ptr<int64>=$unsafe (uint64(0) as ptr<int64>)
let xl_bool_type:ptr<int64>=$unsafe (uint64(0) as ptr<int64>)
let xl_null_type:ptr<int64>=$unsafe (uint64(0) as ptr<int64>)
let xl_int_type:ptr<int64>=$unsafe (uint64(0) as ptr<int64>)
let xl_math_int:ptr<int64>=$unsafe (uint64(0) as ptr<int64>)
checker_literals_bind=(input:ptr<CheckerLiteralInput>):>XLWord=>$unsafe {
    xl_nodes=input[0].nodes
    xl_lists=input[0].lists
    xl_types=input[0].types
    xl_files=input[0].files
    xl_refine=input[0].refine
    xl_effects=input[0].effects
    xl_exact_measure=input[0].exact_measure
    xl_last=input[0].last
    xl_string_type=input[0].string_type
    xl_float_type=input[0].float_type
    xl_bool_type=input[0].bool_type
    xl_null_type=input[0].null_type
    xl_int_type=input[0].int_type
    xl_math_int=input[0].math_int
    0
}
xl_representation=(t0:XLWord):>XLWord=>$unsafe {
    let t=tu_prune(t0)
    if xl_types[0].ptr[t].kind =? 'refined' {return tu_prune(XLWord(xl_types[0].ptr[t].elem))}
    t
}
xl_numeric=(t:XLWord):>bool=>$unsafe {
    let k=xl_types[0].ptr[tu_prune(t)].kind
    k =? 'int_' or k =? 'float_'
}
xl_expected=(expected:XLWord):>XLWord=>$unsafe {
    if expected =? 0 {return 0}
    let ex=tu_prune(expected)
    if xl_refine[0] {ex=xl_representation(ex)}
    ex
}
# A single mutable element borrow checks/detaches once for the final two writes.
xl_publish=(@node:Node t:XLWord):>void=>{
    node.type=int32<overflow='wrap'>(t)
    node.flags |= 128
}
xl_finish=(n:XLWord t0:XLWord expected:XLWord):>XLWord=>$unsafe {
    let t=t0
    if xl_refine[0] and xl_types[0].ptr[t].kind =? 'refined' {t=XLWord(xl_types[0].ptr[t].elem)}
    # Without an expected type the host's callable inference returns the type as published.
    if xl_effects[0] and expected not=? 0 {
        xl_nodes[0][n].type=int32<overflow='wrap'>(t)
        t=effect_infer_callable(n expected)
    }
    xl_publish(@xl_nodes[0][n] t)
    # No host call until the predicate finishes: one borrowed element view.
    let node=xl_nodes[0].ptr + n
    let k=node[0].kind
    if xl_exact_measure[0] or ((k =? 'binary' or k =? 'unary' or k =? 'intrinsic' or (k =? 'conv' and node[0].aux =? 2)) and exact_candidate(n)) {exact_note(n)}
    xl_last[0]=n
    t
}
# An integer literal's default type: the semantic integer in Dewy source.
xl_int_default=(n:XLWord):>XLWord=>$unsafe {
    if xl_files[0][xl_nodes[0].ptr[n].pos >> 40].is_dewy {return xl_math_int[0]}
    xl_int_type[0]
}
# Does fixed-width integer type t hold int literal n of a Jo file? (else the host's coerce
# decides, and reports what does not fit)
xl_word_fits=(n:XLWord t:XLWord):>bool=>$unsafe {
    if xl_nodes[0].ptr[n].kind not=? 'int_lit' {return false}
    let bits=XLWord(xl_types[0].ptr[t].bits)
    let sign=xl_types[0].ptr[t].sign
    if (XLWord(xl_nodes[0].ptr[n].flags) & 2097152) not=? 0 {return bits >=? 64}
    let v=xl_nodes[0].ptr[n].ival
    if bits >=? 64 {return sign or v >=? 0}
    if sign {return v >=? -(XLWord(1) << (bits - 1)) and v <? (XLWord(1) << (bits - 1))}
    v >=? 0 and v <? (XLWord(1) << bits)
}
xl_check_int=(n:XLWord expected:XLWord):>XLWord=>$unsafe {
    let ex=xl_expected(expected)
    let exk:TK='void_'
    if ex not=? 0 {exk=xl_types[0].ptr[ex].kind}
    let t:XLWord=0
    xl_nodes[0][n].flags=xl_nodes[0].ptr[n].flags | 256
    let initial=xl_int_default(n)
    xl_nodes[0][n].type=int32<overflow='wrap'>(initial)
    if exk =? 'int_' and initial not=? xl_math_int[0] and ex not=? xl_math_int[0] and xl_word_fits(n ex) {
        # (coerce's fixed-width literal case: retyped, no longer a literal)
        xl_nodes[0][n].type=int32<overflow='wrap'>(ex)
        xl_nodes[0][n].flags=xl_nodes[0].ptr[n].flags & ~256
        t=ex
    } else if ex not=? 0 and (exk =? 'int_' or exk =? 'float_') {
        coerce(n ex);
        t=ex
    } else if ex not=? 0 and exk =? 'opt' and xl_numeric(XLWord(xl_types[0].ptr[ex].elem)) {
        coerce(n tu_prune(XLWord(xl_types[0].ptr[ex].elem)));
        t=XLWord(xl_nodes[0].ptr[n].type)
    } else {t=initial}
    xl_finish(n t expected)
}
xl_check_str=(n:XLWord expected:XLWord):>XLWord=>$unsafe {
    let ex=xl_expected(expected)
    if (XLWord(xl_nodes[0].ptr[n].flags) & 512) not=? 0 and ex not=? 0 and xl_types[0].ptr[tu_prune(ex)].kind =? 'int_' {
        charlike_to_int(n)
        return check_expr(n expected)
    }
    if xl_nodes[0].ptr[n].aux not=? 0 {
        loop i in [0..XLWord(xl_nodes[0].ptr[n].nlist)) {
            let part=XLWord(xl_lists[0].ptr[XLWord(xl_nodes[0].ptr[n].list) + i])
            if xl_nodes[0].ptr[part].kind not=? 'pair' {continue}
            let e=XLWord(xl_nodes[0].ptr[part].a)
            literal_interpolation_warning(e)
            check_expr(e 0);
            finalize_literal(e);
            fmt_part(part xl_nodes[0].ptr[part].pos)
        }
    }
    xl_finish(n xl_string_type[0] expected)
}
# Called only for float/bool/none/null literals by the existing kind dispatcher.
xl_check_scalar=(n:XLWord expected:XLWord):>XLWord=>$unsafe {
    let ex=xl_expected(expected)
    let exk:TK='void_'
    if ex not=? 0 {exk=xl_types[0].ptr[ex].kind}
    let k=xl_nodes[0].ptr[n].kind
    let t:XLWord=0
    if k =? 'float_lit' {
        if ex not=? 0 and exk =? 'float_' {
            if xl_nodes[0].ptr[n].sval not=? 0 and xl_nodes[0].ptr[n].fval - xl_nodes[0].ptr[n].fval not=? 0.0 {literal_float_error(n)}
            xl_nodes[0][n].flags=xl_nodes[0].ptr[n].flags & ~256
            t=ex
        } else if ex not=? 0 and exk =? 'opt' and xl_types[0].ptr[tu_prune(XLWord(xl_types[0].ptr[ex].elem))].kind =? 'float_' {
            xl_nodes[0][n].flags=xl_nodes[0].ptr[n].flags & ~256
            t=tu_prune(XLWord(xl_types[0].ptr[ex].elem))
        } else {
            xl_nodes[0][n].flags=xl_nodes[0].ptr[n].flags | 256
            t=xl_float_type[0]
        }
    } else if k =? 'bool_lit' {t=xl_bool_type[0]}
    else if k =? 'none_lit' {
        if ex not=? 0 and exk =? 'opt' {t=ex} else {t=tb_mk_opt(tb_mk_var())}
    } else {
        if ex not=? 0 and (exk =? 'ptr' or exk =? 'cfn') {t=ex} else {t=xl_null_type[0]}
    }
    xl_finish(n t expected)
}

$runtime_checks
from p"checker_global_initialization.dewy" import (ensure_global)
from p"evaluator_state.dewy" import (CVal)
from p"util.jo" import (files names)
from p"host_binds.jo" import (constant_host)
from p"constant_eval.dewy" import (constant_eval)
from p"checks_thin.dewy" import (readonly_global)
from p"checker_state.dewy" import (SK)
from p"ast.jo" import (nodes)
from p"check.jo" import (LF_CAPTURE LF_CONST globals locals syms)
from p"checker_expr.dewy" import (lookup)
from p"type_value_arguments.dewy" import (integer_parameter_literal)
from p"types.jo" import (prune types)

ConstantQueryWord:type=int64<overflow='wrap'>

constant_binding=(e:int64):>int64=>{
    if nodes[e].type not=? 0 {
        if nodes[e].aux =? 1 {return binding_const_init('local' ConstantQueryWord(nodes[e].sym) nodes[e].pos)}
        if nodes[e].aux =? 2 {return binding_const_init('global' ConstantQueryWord(nodes[e].sym) nodes[e].pos)}
    }
    let s=lookup(ConstantQueryWord(nodes[e].name))
    if s =? 0 {return 0}
    if syms[s].kind =? 'type_' {return integer_parameter_literal(e)}
    binding_const_init(syms[s].kind ConstantQueryWord(syms[s].ref) nodes[e].pos)
}

sa_fits=(v:ConstantQueryWord t0:ConstantQueryWord):>bool=>{
    let t=prune(t0)
    if t =? 0 {return false}
    if types[t].kind not=? 'int_' {return types[t].kind =? 'bool_'}
    let bits=ConstantQueryWord(types[t].bits)
    if bits >=? 64 {return types[t].sign or v >=? 0}
    if types[t].sign {
        let limit=ConstantQueryWord(1) << ((bits - 1) & 63)
        return v >=? -limit and v <? limit
    }
    v >=? 0 and v <? (ConstantQueryWord(1) << (bits & 63))
}

binding_const_init=(kind:SK ref:ConstantQueryWord pos:ConstantQueryWord):>ConstantQueryWord=>$unsafe {
    if kind =? 'const_' {
        if globals.ptr[ref].init not=? 0 {return ConstantQueryWord(globals.ptr[ref].init)}
        if globals.ptr[ref].decl not=? 0 {return ConstantQueryWord(nodes.ptr[ConstantQueryWord(globals.ptr[ref].decl)].b)}
    } else if kind =? 'global' and readonly_global(ref) {
        ensure_global(ref pos)
        return ConstantQueryWord(nodes.ptr[ConstantQueryWord(globals.ptr[ref].decl)].b)
    } else if kind =? 'local' {
        let l=ref
        loop ConstantQueryWord(locals.ptr[l].flags) & LF_CAPTURE not=? 0 {l=ConstantQueryWord(locals.ptr[l].outer)}
        if ConstantQueryWord(locals.ptr[l].flags) & LF_CONST not=? 0 {return ConstantQueryWord(locals.ptr[l].const_init)}
    }
    0
}

ceval=(e:int64):>CVal=>constant_eval(@nodes @names @files @constant_host e)

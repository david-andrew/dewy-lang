use 'checker_call_values.dewy'
# Frozen call dispatch services from expr.jo.
use 'expr.jo'
use 'ast.jo'
use 'node_store.dewy'
use 'types.jo'
use 'units.jo'
use 'checker_expr.dewy'
use 'check.jo'
use 'dewy_methods.jo'
use 'effects.jo'
use 'exact.jo'
use 'util.jo'
use 'checker_signature.dewy'
use 'reflection.jo'
use 'reflect_ops.dewy'
use 'ide.jo'
use 'refine.jo'
use 'juxtapose.dewy'
use 'checker_call_resolve.dewy'
use 'string_domains.jo'
use 'string_domain_ops.dewy'
use 'effect_contracts.dewy'

call_head = (n: int, expected: int) -> int:
    if reflect_fields(n): call_dispatch_error(1, n, 0, 0, 0, 0, 0, 0, 0)
    callee = int(nodes[n].a)
    if nodes[callee].name == i32(id_members) and nodes[callee].kind == .ident and lookup(id_members) == 0:
        if string_domain_members(n): return ntype(n)
        if reflect_members(n): return members_array(n, expected)
    if id_breakpoint == 0: id_breakpoint = intern("$breakpoint")
    if nodes[callee].kind == .ident and int(nodes[callee].name) == id_breakpoint and nkids(n) == 0:
        breakpoint_call(n)
        return check_expr(n, expected)
    if nodes[callee].kind == .field:
        if nodes[callee].b != 0: reflect_name(callee)
        if reflect_active: reflect_member(callee)
    ck = nodes[callee].kind
    # Generated coordinates rely on the bundled helper's word arithmetic.
    # A user function with the same spelling must never replace that helper.
    if has_flag(n, NF_PRIVATE_COORD) and ck == .ident and name_of(int(nodes[callee].name)) == "__bcast_index":
        loop arg in kids(n): finish_arg(arg, T_INT, false)
        nodes[n].aux = 0
        nodes[n].sym = i32(runtime_fn("__bcast_index"))
        nodes[n].type = i32(T_INT)
        return T_INT
    -1

call_typeapply = (n: int, expected: int) -> int:
    callee = int(nodes[n].a)
    args = kids(n)
    base = int(nodes[callee].a)
    name = int(nodes[base].name)
    # `rational<int64>(value)`: the explicit narrowing, with Overflow in its result (the
    # builtin type's conversion, unless a type shadows its name)
    if nodes[base].kind == .ident and name_of(name) == "rational" and (lookup(name) == 0 or syms[lookup(name)].kind == .fns) and dewy_at(nodes[n].pos):
        if bundled_word_rational_type(resolve_type(int(nodes[callee].c))):
            pos = nodes[n].pos
            nodes[n].a = i32(bc_field(bc_ident("$dewy_rational", pos), "_word_rational", pos))
            return check_expr(n, expected)
    if nodes[base].kind == .field and nkids(callee) == 1 and args.len() == 1 and dewy_at(nodes[n].pos) and name == ci(42, "read"):
        r = dewy_byte_read(n, callee, base, args, expected)
        if r != 0: return r
    s = 0
    mod = -1
    if nodes[base].kind == .ident: s = lookup(name)
    else if nodes[base].kind == .field:
        mt = prune(check_expr(int(nodes[base].a), 0))
        if types[mt].kind == .module:
            mod = int(types[mt].mod)
            s = module_lookup(mod, name)
    if s != 0 and syms[s].kind == .fns:
        targs: int[]
        loop arg in kids(callee): targs.push(effect_generic_argument(arg))
        saved = call_targs
        call_targs = targs
        nodes[n].a = i32(base)
        r = call_by_name(n, name, mod, args, expected, false)
        call_targs = saved
        return r
    if (s != 0 and (syms[s].kind == .local or syms[s].kind == .global)) or (nodes[base].kind != .ident and mod < 0):
        callee_at = base
        check_expr(base, 0)
        if tkind(ntype(base)) == .polyfn:
            explicit: int[]
            loop arg in kids(callee): explicit.push(effect_generic_argument(arg))
            saved = call_targs
            call_targs = explicit
            r = value_call(n, base, args, expected)
            call_targs = saved
            return r
    t = prune(resolve_type(int(nodes[callee].c)))
    if is_int(t): return conversion(n, t, args)
    if types[t].kind != .struct_: call_dispatch_error(2, n, 0, callee, 0, 0, 0, 0, 0)
    return struct_ctor(n, t, int(structs[int(types[t].st)].decl), args, expected)

call_ident_special = (n: int, expected: int) -> int:
    callee = int(nodes[n].a)
    if has_flag(n, NF_JUXT) and juxt_head_numeric(n):
        juxt_product(n)
        return check_expr(n, expected)
    if has_flag(n, NF_JUXT) and int(nodes[callee].name) == ci(5, "__dewy_power") and nkids(n) == 2 and nodes[kid(n, 0)].kind == .call and juxt_chain_numeric(kid(n, 0)):
        juxt_power(n)
        return check_expr(n, expected)
    if id_len == 0: id_len = intern("len")
    if nkids(n) == 1 and int(nodes[callee].name) == id_len:
        # len(ps) for a soa array
        at = prune(check_expr(kid(n, 0), 0))
        a0 = last_checked
        set_kid(n, 0, a0)
        if lookup(id_len) == 0 or syms[lookup(id_len)].kind == .builtin or decl_in_prelude(int(syms[lookup(id_len)].decl)): dewy_len_check(callee, false, at, a0)
        if is_soa(at): return check_soa_method(n, a0, int(nodes[callee].name), [], expected)
    -1

call_dotname = (n: int, expected: int) -> int:
    callee = int(nodes[n].a)
    args = kids(n)
    if ide_sentinel != 0 and int(nodes[callee].name) == ide_sentinel: ide_complete_variants(expected)
    et = prune(expected)
    if expected != 0 and types[et].kind == .opt: et = prune(int(types[et].elem))
    if expected != 0: et = variant_enum(et, int(nodes[callee].name))
    if expected == 0 or types[et].kind != .enum_: call_dispatch_error(3, n, 0, callee, 0, 0, 0, 0, 0)
    vi = find_variant(int(types[et].st), int(nodes[callee].name))
    if vi < 0: call_dispatch_error(4, n, 0, callee, 0, 0, 0, et, 0)
    if ide_on: ide_variant_ref(nodes[callee].pos, int(nodes[callee].name), et, vi)
    return variant_ctor(n, et, vi, args)

call_member_prepare = (n: int, callee: int, recv: int, receiver_type: mut int, args: int[], expected: int) -> int:
    rt = receiver_type
    fname = int(nodes[callee].name)
    if refine_active and call_totaldict_member(fname) and is_total_dict(refine_storage(recv, 0)):
        call_dispatch_error(5, n, 0, 0, 0, 0, fname, 0, 0)
    if str_sets.len() > 1 and str_set_of(rt) != 0 and not program_fn_named(fname):
        # (a string set's methods are its text's)
        coerce(recv, T_STR)
        rt = T_STR
        receiver_type = rt
    if synthetic_copy(rt, fname, nodes[n].pos):
        nargs_check(n, args.len(), 0, 0, ".copy")
        return check_copy(n, recv, rt)
    if ide_sentinel != 0 and fname == ide_sentinel: ide_complete_members(rt)
    rk = types[rt].kind
    if rk == .struct_ and dewy_at(nodes[n].pos) and rt == console_type(): return dewy_console_call(n, name_of(fname), args, expected)
    -1

call_member_type = (n: int, callee: int, rt: int, fname: int, args: int[], expected: int) -> int:
    tt = prune(int(types[rt].elem))
    if tt != 0 and types[tt].kind == .enum_:
        vi = find_variant(int(types[tt].st), fname)
        if vi < 0: call_dispatch_error(6, n, 0, callee, 0, 0, fname, 0, tt)
        if ide_on: ide_variant_ref(nodes[callee].pos, fname, tt, vi)
        return variant_ctor(n, tt, vi, args)
    if tt != 0 and types[tt].kind == .struct_:
        j = dewy_type_method(int(structs[int(types[tt].st)].decl), fname)
        if j >= 0: return dewy_static_call(n, tt, j, args, expected)
    call_type_member_error(callee, tt, fname)

call_member_callable = (n: int, callee: int, recv: int, rt: int, fname: int, args: int[], expected: int) -> int:
    st = rt
    if types[rt].kind == .ptr: st = prune(int(types[rt].elem))
    if types[st].kind == .struct_:
        si = int(types[st].st)
        check_struct_fields(si)
        loop i in [0..int(structs[si].nfields)):
            fi = int(structs[si].fields) + i
            if int(fields[fi].name) == fname and (tkind(int(fields[fi].type)) == .fn_ or tkind(int(fields[fi].type)) == .cfn or tkind(int(fields[fi].type)) == .polyfn or tkind(int(fields[fi].type)) == .callable):
                if ide_on: ide_field_ref(nodes[callee].pos, fname, int(structs[si].decl), i, int(fields[fi].type))
                method = dewy_method_field(int(fields[fi].type))
                if method != 0: return dewy_method_call(n, callee, method, args, expected)
                callee_at = callee
                check_expr(callee, 0)
                return value_call(n, callee, args, expected)
    -1

call_member_tail = (n: int, callee: int, recv: int, rt: int, member_name: mut int, args: mut int[], expected: int) -> int:
    fname = member_name
    if call_numeric_member(fname) and args.len() == 1 and (is_numeric(rt) or rt == T_MATH_INT) and dewy_at(nodes[n].pos):
        call_dispatch_error(7, n, 0, 0, 0, 0, fname, 0, 0)
    if files[pos_file(nodes[n].pos)].is_dewy:
        if str_sets.len() > 1:
            keyed = method_str_set_key(n, recv, rt, fname, args, expected)
            if keyed != 0: return keyed
        member_name = dewy_member_name(callee, rt, fname, args)
    -1

call_index = (n: int, expected: int) -> int:
    callee = int(nodes[n].a)
    args = kids(n)
    if nodes[callee].kind == .index and nodes[int(nodes[callee].a)].kind == .ident:
        s = lookup(int(nodes[int(nodes[callee].a)].name))
        if s != 0 and syms[s].kind == .struct_:
            t = expr_as_type(callee)
            return struct_ctor(n, t, int(syms[s].ref), args, expected)
        if s != 0 and syms[s].kind == .fns:
            # f[T](args): a generic function with its type arguments given
            targs: int[]
            if nodes[callee].b != 0: targs.push(expr_as_type(int(nodes[callee].b)))
            else:
                loop i in [0..nkids(callee)): targs.push(expr_as_type(kid(callee, i)))
            saved = call_targs
            call_targs = targs
            r = call_by_name(n, int(nodes[int(nodes[callee].a)].name), -1, args, expected, false)
            call_targs = saved
            return r
    -1

call_value = (n: int, expected: int) -> int:
    callee = int(nodes[n].a)
    args = kids(n)
    head_kind = nodes[callee].kind
    if head_kind == .call and juxt_chain_numeric(callee):
        juxt_product(n)
        return check_expr(n, expected)
    # (spelled before checking rewrites it, for the diagnostic of a call or index result)
    head_text = if head_kind == .call or head_kind == .index: juxt_text(callee) else: ""
    callee_at = callee
    check_expr(callee, 0)
    if juxt_value_head(n, head_kind, head_text, ntype(last_checked)):
        nodes[n].a = i32(last_checked)
        juxt_product(n)
        return check_expr(n, expected)
    value_call(n, callee, args, expected)


# Whether the program declares its own function of this name taking a sequence first: then a
# call may be the program's, whose `int` parameter must see the value as it is. O(declarations
# of the name), only at a library `get` of an `int`.
call_own_sequence_fn = (name: int) -> bool:
    cm = cur_mod()
    if cm < 0 or modules[cm].is_prelude: return false
    all_d: int[]
    call_collect_module(cm, name, all_d)
    loop d in all_d:
        if not decl_in_prelude(d) and takes_seq(d): return true
    false

call_name_early = (n: int, name: int, mod_scope: int, args: int[], expected: int, ufcs: bool) -> int:
    if ide_sentinel != 0 and name == ide_sentinel:
        if ufcs and args.len() > 0:
            check_expr(args[0], 0)
            ide_complete_members(ntype(args[0]))
        ide_complete_names()
    # (`find(text part)` and `index_of(xs x)` written as calls: Dewy's searches, giving Missing)
    if not ufcs and mod_scope < 0 and args.len() >= 1 and (name == id_find or name == id_rfind or name == id_index_of or name == id_chars) and (args.len() >= 2 or name == id_chars) and files[pos_file(nodes[n].pos)].is_dewy and nodes[args[0]].kind != .namedarg:
        s = lookup(name)
        if s != 0 and syms[s].kind == .fns and decl_in_prelude(int(syms[s].decl)):
            a0 = args[0]
            if not has_flag(a0, NF_CHECKED):
                check_expr(a0, 0)
                add_flag(a0, NF_CHECKED)
            k0 = tkind(prune(ntype(a0)))
            if k0 == .str_ and name == id_chars: return call_by_name(n, ci(1, "graphemes"), mod_scope, args, expected, false)
            if k0 == .str_ and name != id_index_of and name != id_chars: return call_by_name(n, call_search_name(name), mod_scope, args, expected, false)
            if k0 == .array and name == id_index_of and args.len() == 2: return call_by_name(n, ci(2, "__dewy_index_of"), mod_scope, args, expected, false)
    # (`xs.get(i)` of an `int` index: one past the word range is past an end too, so the index
    # saturates into a word rather than narrowing with a proof, as a text repeat count does)
    if name == ci(47, "get") and mod_scope < 0 and args.len() == 2 and nodes[args[0]].kind != .namedarg and nodes[args[1]].kind != .namedarg and dewy_at(nodes[n].pos):
        a0 = args[0]
        if not has_flag(a0, NF_CHECKED):
            check_expr(a0, 0)
            add_flag(a0, NF_CHECKED)
        if tkind(prune(ntype(a0))) == .array or tkind(prune(ntype(a0))) == .str_:
            a1 = args[1]
            if not has_flag(a1, NF_CHECKED):
                check_expr(a1, 0)
                add_flag(a1, NF_CHECKED)
            if prune(ntype(a1)) == T_MATH_INT and not is_lit(a1) and not call_own_sequence_fn(name): coerce(a1, policy_int(T_INT, 2, nodes[n].pos))
    if not ufcs and mod_scope < 0 and args.len() == 2 and (name == ci(3, "__floor_div") or name == ci(4, "__floor_mod") or name == ci(5, "__dewy_power") or name == ci(6, "__dewy_divide")) and (files[pos_file(nodes[n].pos)].is_dewy or pos_in_lib(nodes[n].pos)):
        if nodes[args[0]].kind != .namedarg and nodes[args[1]].kind != .namedarg:
            return dewy_arithmetic_call(n, name, args, expected)
    if not ufcs and mod_scope < 0 and args.len() == 1 and dewy_quantity_name(name) and nodes[args[0]].kind != .namedarg and files[pos_file(nodes[n].pos)].is_dewy:
        s = lookup(name)
        if s != 0 and syms[s].kind == .fns and decl_in_prelude(int(syms[s].decl)):
            a0 = args[0]
            check_expr(a0, 0)
            add_flag(a0, NF_CHECKED)
            r = dewy_quantity_call(n, name, a0, expected)
            if r != 0: return r
    if name == ci(28, "abs") and mod_scope < 0 and args.len() == 1 and dewy_at(nodes[n].pos) and not program_fn_named(name):
        a = args[0]
        if not has_flag(a, NF_CHECKED):
            check_expr(a, 0)
            add_flag(a, NF_CHECKED)
        if int_policy(ntype(a)) != 0: return call_by_name(n, intern("__dewy_policy_abs"), -1, args, expected, false)
        if exact_type(ntype(a), nodes[n].pos):
            t = ntype(a)
            nodes[n] = Node(kind = .intrinsic, pos = nodes[n].pos, aux = i32(int(IN.fixed_abs)), type = i32(t), flags = i32(NF_CHECKED))
            set_list(n, [a])
            return exact_int_result(n)
    -1

call_name_intrinsic = (n: int, ii: int) -> int:
    if ii >= 0 and intrinsics[ii].id == .assert and dewy_at(nodes[n].pos) and nodes[n].aux2 != i32(RANGE_EXHAUSTION): return -2
    ii

call_name_array = (n: int, name: int, mod_scope: int, args: int[], expected: int, ufcs: bool, ii: int) -> int:
    if not intrinsics[ii].arr: return -1
    a0 = args[0]
    if not has_flag(a0, NF_CHECKED):
        check_expr(a0, 0)
        add_flag(a0, NF_CHECKED)
    t0 = prune(ntype(a0))
    # Raw element access cannot resize an array; retain element contracts below.
    if intrinsics[ii].id == .arrdata and tkind(representation_type(t0)) == .array: t0 = representation_type(t0)
    if types[t0].kind == .array or types[t0].kind == .str_:
        # (the program's own insert(t: mut T[], k) and the like, taking that many arguments: its)
        own: int[]
        cm = cur_mod()
        if (not ufcs or mod_scope < 0) and cm >= 0 and not modules[cm].is_prelude:
            all_d: int[]
            call_collect_module(cm, name, all_d)
            loop d in all_d:
                if not decl_in_prelude(d) and args_fit(d, args.len()) and takes_seq(d): own.push(d)
        if own.len() > 0: return resolve_fn_call(n, name, own, args, expected)
        if ide_on: ide_builtin_ref(n, name)
        return check_intrinsic(n, int(intrinsics[ii].id), args, expected)
    if types[t0].kind == .fixed:
        if intrinsics[ii].id != .len: call_fixed_array_error(n, name, t0, ii)
        # Calls and indexed receivers still evaluate, even though the
        # resulting length is statically known.
        if nodes[a0].kind != .ident: return check_intrinsic(n, int(IN.len), args, expected)
        # (the size is part of the type)
        nodes[n] = Node(kind = .int_lit, pos = nodes[n].pos, ival = fixed_len(t0), type = i32(T_INT), flags = i32(NF_CHECKED))
        return T_INT
    -1

call_name_sym = (n: int, name: int, mod_scope: int, s: int, args: int[], expected: int, hidden_assert: bool, decls: mut int[]) -> int:
    sk = syms[s].kind
    if ide_on and (sk == .struct_ or sk == .type_ or sk == .enum_) and nodes[n].a != 0: ide_sym_ref(int(nodes[n].a), s)
    if sk == .local or sk == .global:
        vt = 0
        if sk == .local: vt = int(locals[int(syms[s].ref)].type)
        else:
            ensure_global(int(syms[s].ref), nodes[n].pos)
            vt = int(globals[int(syms[s].ref)].type)
        if tkind(vt) == .fn_ or tkind(vt) == .cfn or tkind(vt) == .polyfn or tkind(vt) == .callable:
            callee = mk(.ident, nodes[n].pos)
            nodes[callee].name = i32(name)
            callee_at = callee
            if mod_scope >= 0:
                check_expr_in_module(callee, mod_scope)
            else: check_expr(callee, 0)
            return value_call(n, callee, args, expected)
    else if sk == .struct_: return struct_ctor(n, 0, int(syms[s].ref), args, expected)
    else if sk == .enum_:
        ed = int(syms[s].ref)
        if nkids2(ed) == 0 and args.len() == 1 and nodes[args[0]].kind != .namedarg:
            et = get_struct_inst(ed, [])
            if simple_enum(et): return enum_from_int(n, et, args[0])
        call_dispatch_error(8, n, name, 0, 0, 0, 0, 0, 0)
    # (Phase(2) in Sloppy, Phase a Dewy union of string literals: its member at that
    # position, as for a Sloppy enum, so Sloppy code takes a Dewy enumeration as its own)
    else if sk == .alias_ and not dewy_at(nodes[n].pos) and nkids2(int(syms[s].ref)) == 0 and args.len() == 1 and nodes[args[0]].kind != .namedarg and str_set_of(resolve_alias(int(syms[s].ref), [], nodes[n].pos)) != 0:
        return enum_from_int(n, prune(resolve_alias(int(syms[s].ref), [], nodes[n].pos)), args[0])
    else if sk == .type_:
        jo_type_spelling(name, s, nodes[n].pos)
        return conversion(n, int(syms[s].ref), args)
    else if sk == .fns and args.len() == 1 and nodes[args[0]].kind != .namedarg and universe.get(name) != none:
        # (str(5) beside the program's str = (b: Big) -> str: the type's conversion, when
        # no function of the name takes the value)
        at = prune(check_expr(args[0], 0))
        add_flag(args[0], NF_CHECKED)
        fd: int[]
        call_collect_fns(name, fd)
        takes = false
        loop d in fd:
            sig = fn_sig(d)
            if sig.params.len() >= 1 and (sig.generic or can_coerce(args[0], at, sig.params[0])): takes = true
        if not takes: return conversion(n, int(syms[universe[name]].ref), args)
    else if sk == .fns and args.len() == 2 and name == take_name and (prelude.get(name) ?? 0) == s and pos_in_lib(nodes[n].pos): return take_call(n, args)
    else if sk == .fns and args.len() == 3 and name == relocate_name and (prelude.get(name) ?? 0) == s and pos_in_lib(nodes[n].pos): return relocate_call(n, args)
    else if sk == .fns and args.len() == 2 and name == release_name and (prelude.get(name) ?? 0) == s and pos_in_lib(nodes[n].pos): return release_call(n, args, expected)
    else if sk == .const_ or sk == .module: call_dispatch_error(9, n, name, 0, 0, 0, 0, 0, 0)
    else if sk == .builtin and not hidden_assert:
        call_collect_fns(name, decls)
        if decls.len() == 0:
            if ide_on: ide_builtin_ref(n, name)
            return check_intrinsic(n, int(syms[s].ref), args, expected)
    -1

call_name_collect = (n: int, name: int, mod_scope: int, args: int[], expected: int, ufcs: bool, decls: mut int[]) -> int:
    surface_hidden.clear()
    if ufcs:
        if mod_scope >= 0: call_collect_module(mod_scope, name, decls)
        else: call_collect_fns(name, decls)
    else: call_collect_named(name, mod_scope, decls)
    if name == ci(7, "to_int") and mod_scope < 0 and files[pos_file(nodes[n].pos)].is_dewy:
        own = false
        loop d in decls:
            if not decl_in_prelude(d): own = true
        if not own:
            parser = ci(8, "__mi_parse")
            # (to_int(text max_digits=n): the limit as given; plain to_int keeps its one parameter)
            if args.len() > 1: parser = intern("__mi_parse_limited")
            # (a literal limit of at most 18 digits: the result is always a word)
            if args.len() == 2 and to_int_word_limit(args[1]): parser = intern("__mi_parse_word")
            demand_name(parser)
            decls = []
            call_collect_fns(parser, decls)
            return resolve_fn_call(n, parser, decls, args, expected)
    # Index operators belong to the receiver's module, just like methods. A
    # selected import of a container type must also make its operators usable.
    indexed = name == ci(9, "[]") or name == ci(10, "[]=")
    if (ufcs or indexed) and args.len() > 0:
        if indexed and not has_flag(args[0], NF_CHECKED):
            check_expr(args[0], 0)
            add_flag(args[0], NF_CHECKED)
        tms = method_modules(ntype(args[0]))
        loop tm in tms: call_collect_module(tm, name, decls)
        tm = if tms.len() > 0: tms[0] else: -1
        if indexed:
            protocol_text = if name == ci(11, "[]"): "__index__" else: "__setindex__"
            protocol = intern(protocol_text)
            if mod_scope >= 0: call_collect_module(mod_scope, protocol, decls)
            else: call_collect_fns(protocol, decls)
            if tm >= 0: call_collect_module(tm, protocol, decls)
    if surface_hidden.len() > 0: dewy_surface_check(n, name)
    -1

use 'check.jo'
use 'decimals.jo'
use 'expr.jo'
use 'dewy_methods.jo'
use 'effects.jo'
use 'refine.jo'
use 'x64.jo'
use 'ir.jo'
use 'parse.jo'
use 'ide.jo'
use 'lower.jo'
# Incremental compact-AST construction. A transaction retries the reference
# grammar whenever a contextual or otherwise unmigrated form is reached.
use 'util.jo'
use 'ast.jo'
use 'lex.jo'
use 'dewy_tokens.dewy'
use 'dewy_syntax.dewy'
use 'dewy_grammar.dewy'
use 'dewy_lex.dewy'
use 'literals.dewy'
use 'dewy_parse.jo'
use 'dewy_fast.jo'
use 'dewy_directives.jo'
use 'dewy_ffi.jo'
use 'proofs.jo'
use 'module_paths.dewy'
use 'place_split.jo'
use 'place_methods.jo'
use 'ownership.jo'
use 'par.jo'
use 'pcheck.jo'
use 'main.jo'
use 'lazy_bodies.jo'
use 'prelude.jo'
use 'icount.jo'
use 'directives.jo'
use 'node_store.dewy'
use 'targets.dewy'
use 'isolation.jo'
use 'concurrency.jo'
use 'arena.jo'

# DEWY_FRONTEND=old selects the reference path; compare checks every migrated
# value against a fresh legacy parse and projection before retaining its nodes;
# strict stops at any statement the reference grammar would re-read (dc_fallback).
# Unmigrated grammar remains on that reference path in the other modes.
dc_enabled = true
dc_selected = true     # (DEWY_FRONTEND, read once)
dc_mode_read = false
dc_compare = false
dc_strict = false
dc_literal_at = -1     # (the `(` of the module function declaration being read: dc_duplicate_parameter)
dc_nothing = false     # (the module statement read declares nothing: `=> $intrinsic`, dn_statement)
dc_dropped_reads = 0   # (a `$target` chain's left-out arms being read: dw_target_dropped's syntax, no fallback)

# The reference grammar is about to re-read what starts at token `at`: strict mode stops there.
dc_fallback = (at: int):
    if dc_strict and dc_dropped_reads == 0: fatal(mkpos(dn_file, dn_tokens[at].start), "the direct parser does not read this (DEWY_FRONTEND=strict)")
dc_depth = 0
dc_range_top = false       # (the first entry of an index: it may end at a slice's `..`)
dc_member_depth = -1       # (the dc_depth of a membership's right operand: it may be a range, `x in? a..b`)
dc_spread_depth = -1       # (the dc_depth of an array element: it may end with `...`)
dc_axis_depth = -1         # (the dc_depth of an index's axis: a bracketed range there may be open, `a[0 [1..]]`,
dc_open_axes = 0           # when it is the whole axis; the open ones read)
dc_literal_seen = false    # (a string type member was read: a group holding one flattens, dw_pipe_leaves)
dc_index_node = 0          # (the index whose brackets are being read: `end` is its last)
dc_pattern_binder = 0      # (the name a condition in a type refines: dw_pattern_binder)
dc_range_call = 0          # (the range value dc_atom read last, and its range: an index's axis
dc_range_node = 0          # among several is that range, a slice)
dc_fn_body = false         # (a function's body is being read directly)
# (an unbraced body: a `;` after its expression or assignment ends the enclosing statement,
# as the reference grammar's flow body is an expression; a keyword statement takes it)
dc_unbraced = false
# (what the function whose body is being read gives, as dw_fn_result: 0 outside any, 1 nothing,
# 2 a value; -1 not known, a body read when checking asks for it)
dc_fn_result = 0
dc_chains_made = 0     # (comparison chains read so far)
dc_cast_coalesce = false   # (an `as` type may end at `??`: the cast is to an optional, dc_expr)
dc_map_ok = false      # (statements of a comprehension's bodies may be `key -> value` entries)
dc_pairs_made = 0      # (entries read, and entries collected: every one read must be collected)
dc_pairs_collected = 0
dc_top_level = false   # (dc_statement is reading a module's top-level statement, not one in a body)
# (the `if` whose chain was read last, when every condition up to its compiled arm folds
# (syntax_target_live): its value is that arm's body (dc_flow), whose statements a block splices
# in its place (dw_target_splice); -1 for none)
dc_live_at = -1
# The members a method's bare names reach (dw_siblings while dw_function reads it): a name maps
# to the receiver it is read through; names bound in a scope hide members (dw_shadow).
dc_scope: {int: int} = {}
dc_transfer_bits = 0    # (the transfer tags of the record being read, dw_transfer_row's bits)
dc_transfer_at = 0      # (where its last claim is written)
# (the names that wait for inherited members, dewy_defer_name, and the callees among them, recorded
# once every method resolves)
dc_waiting: int[]
dc_waiting_names: int[]
dc_waiting_callees: int[]
dc_effects_follow = false   # (a result type may end at `&`: an effect row follows, dc_effect_row)
dc_rename_follows = false   # (a pattern name's type may end at `as`: `y:int64 as py`, dc_binding_items)
dc_dropping = 0        # (the arms being read are left out by an earlier arm's fold)
dc_splice_ok = false   # (the statement read next may be such a chain: dc_body_read splices it)
dc_kinds: int[]        # (the parameter kinds of the functions being read: 1 keyword-only, dewy_param_kinds)

# Full lexing retains source positions and names; only closed braced bodies are
# deferred. The marker lives on the block so function instances keep its identity.
const DC_LAZY_BODY = -314
dc_lazy_tokens: {int: DewyLexeme[]}
dc_lazy_on = false
# An imported library module's function bodies wait to be parsed until checking asks for them:
# only the reached ones are (dc_force_body). Nothing waits on them before checking (unlike a
# program's own deferred bodies, no replay, partition or whole-program force needs them; a
# library global that its own functions fill first forces its module: dc_force_module).
dc_lib_lazy = false

dc_lib_lazy_allowed = (file: int) -> bool:
    prelude_lazy and not dc_compare and dc_enabled and len(lib_root) > 0 and starts_with(files[file].path, lib_root)

dc_lazy_allowed = (file: int) -> bool:
    when BOOTSTRAP or TARGET != "linux" or ARCH != "x86_64":
        return false
    else:
        if dc_eager or not dc_enabled or dc_compare or emit_workers() < 2 or shown_warnings.len() > 0: return false
        if len(files[file].src) < 100000 and env("DEWY_EMIT_FORCE") == none: return false
        if (env("DEWY_PCHECK") ?? "") == "0" or (env("DEWY_FUSED") ?? "") == "0": return false
        if target_wasm or target_arm64 or target_windows or target_macos or opt_release or dbg_on or watch_build or repl_image or lower_only or host_ir or ra_stat or len(ra_dump) > 0 or not queue_emit or ide_on or errors_only or test_mode or check_all or len(stop_after) > 0: return false
        true

dc_lazy_body = () -> int:
    if dn_tokens[dn_at].kind == .lazy_body:
        t = dn_tokens[dn_at]
        b = mk(.block, mkpos(dn_file, t.start))
        nodes[b].aux2 = DC_LAZY_SPAN
        nodes[b].ival = t.start
        dc_lazy_span_end[b] = t.stop
        dn_at += 1
        return b
    if not (dc_lazy_on or dc_lib_lazy) or dn_tokens[dn_at].symbol != .lbrace: return 0
    start = dn_at
    at = start + 1
    depth = 1
    loop at < dn_tokens.len():
        t = dn_tokens[at]
        if t.symbol == .lbrace: depth += 1
        if t.symbol == .rbrace: depth -= 1
        if depth == 0:
            b = mk(.block, mkpos(dn_file, dn_tokens[start].start))
            nodes[b].aux2 = DC_LAZY_BODY
            nodes[b].ival = start
            dn_at = at + 1
            if dc_lazy_on: dc_lazy_used = true
            return b
        # These can declare names/imports or affect whole-program analysis at
        # parse time. Large/base literals may synthesize a bigint import.
        if t.kind == .metatag or t.kind == .integer or t.kind == .based_string or t.symbol == .function or t.symbol == .kw_import or t.symbol == .kw_from or t.symbol == .coalesce: return 0
        if t.kind == .source_integer and t.stop - t.start > 18: return 0
        # Interpolations can hide declarations, bigint imports or parse warnings.
        if t.kind == .quoted:
            source = files[dn_file].src
            loop i in [t.start..t.stop):
                if source[i] == '{': return 0
        at += 1
    0

# The lazy_body tokens of the declaration at dn_at, lexed (it parses another way, or its body
# does not wait): up to the first that ends a line
dn_lazy_left = false
dn_expand_lazy = ():
    if not dn_lazy_left: return
    k = dn_at
    loop k < dn_tokens.len() and dn_tokens[k].kind != .lazy_body: k += 1
    if k == dn_tokens.len():
        dn_lazy_left = false
        return
    out = dn_tokens[..k)
    saved_comments = dn_block_comments
    loop k < dn_tokens.len():
        t = dn_tokens[k]
        k += 1
        if t.kind != .lazy_body:
            out.push(t)
            continue
        inner = dn_lex(dn_file, t.start, t.stop)
        loop j in [0..inner.len() - 1):
            x = inner[j]
            if j == 0:
                x.space = t.space
                x.newline = t.newline
            out.push(x)
        if k >= dn_tokens.len() or dn_tokens[k].newline: break
    out.extend(dn_tokens[k..dn_tokens.len()))
    dn_block_comments = saved_comments
    dn_tokens = out

dc_force_body = (d: int):
    b = int(nodes[d].b)
    if b == 0 or (nodes[b].aux2 != DC_LAZY_BODY and nodes[b].aux2 != DC_LAZY_SPAN): return
    # (frontend work, whoever asks for the body first)
    icl = ic_mod(IC_LOAD, int(nodes[d].mod))
    saved_tokens = dn_tokens
    saved_at = dn_at
    saved_file = dn_file
    saved_depth = dc_depth
    saved_syntax = dewy_syntax
    saved_lib = dc_lib_lazy
    saved_left = dn_lazy_left
    saved_edits_on = dn_edits_on
    edits = dn_edit_at.len()
    dn_edits_on = true
    dc_lib_lazy = false
    dn_lazy_left = false
    dn_file = pos_file(nodes[d].pos)
    first = int(nodes[b].ival)
    if nodes[b].aux2 == DC_LAZY_SPAN:
        saved_comments = dn_block_comments
        dn_tokens = dn_lex(dn_file, first, dc_lazy_span_end[b])
        dn_block_comments = saved_comments
        dc_lazy_span_end.remove(b)
        first = 0
    else: dn_tokens = dc_lazy_tokens[dn_file]
    dn_at = first
    dc_depth = 2
    dewy_syntax = [DewySyntax(.unknown, "", 0, []), DewySyntax(.inverted_comparison, "", 0, [])]
    node_start = nodes.len()
    list_start = lists.len()
    saved_in_body = dc_fn_body
    dc_fn_body = true
    saved_result = dc_fn_result
    dc_fn_result = -1
    body = dc_body()
    dc_fn_result = saved_result
    dc_fn_body = saved_in_body
    if body == 0:
        nodes.truncate(node_start)
        lists.truncate(list_start)
        dn_edits_undo(edits)
        dn_at = first
        dc_depth = 2
        dc_fallback(first)
        body = dw_block(dn_expr(0))
    i = nodes.len() - 1
    loop i >= node_start:
        if nodes[i].kind == .loopx:
            lowered = desugar_loopx(i)
            nodes[i] = nodes[lowered]
        i -= 1
    dir_apply_rows(node_start)
    prefix = kids(b)
    loop st in kids(body): prefix.push(st)
    set_list(body, prefix)
    nodes[b] = nodes[body]
    dn_tokens = saved_tokens
    dn_at = saved_at
    dn_file = saved_file
    dc_depth = saved_depth
    dewy_syntax = saved_syntax
    dc_lib_lazy = saved_lib
    dn_lazy_left = saved_left
    dn_edits_clear(edits)
    dn_edits_on = saved_edits_on
    ic_restore(icl)

dc_binary_token = (op: DewyToken) -> Tok:
    match op:
        plus: .plus
        minus: .minus
        star, multiply_apply: .star
        eq: .eq
        contains: .kw_in
        lt: .lt
        le: .le
        gt: .gt
        ge: .ge
        shl: .shl
        shr: .shr
        kw_and, amp: .amp
        kw_or, pipe: .pipe
        kw_xor: .caret
        _: .eof

# The names the direct grammar's arithmetic and iteration call, interned on first use.
dc_builtins: int[]
dc_builtin = (k: int) -> int:
    if dc_builtins.len() == 0: dc_builtins = [0, 0, 0, 0, 0]
    if dc_builtins[k] == 0: dc_builtins[k] = intern(["__dewy_divide", "__dewy_power", "__floor_div", "__floor_mod", "__dewy_iter"][k])
    dc_builtins[k]

dc_binary = (op: DewyToken, left: int, right: int, pos: int) -> int:
    scalar = dn_token_uninvert(op)
    if scalar != op:
        inner = dc_binary(scalar, left, right, pos)
        if inner == 0: return 0
        n = mk(.not_, pos)
        nodes[n].a = i32(inner)
        return n
    if op == .slash or op == .floor or op == .percent or op == .caret:
        k = if op == .slash: 0 else if op == .caret: 1 else if op == .floor: 2 else: 3
        callee = mk(.ident, pos)
        nodes[callee].name = i32(dc_builtin(k))
        n = mk(.call, pos)
        nodes[n].a = i32(callee)
        set_list(n, [left, right])
        return n
    token = dc_binary_token(op)
    if token == .eof: return 0
    n = mk(if op == .kw_and: NK.and_ else if op == .kw_or: NK.or_ else: NK.binary, pos)
    nodes[n].op = i32(int(token))
    nodes[n].a = i32(left)
    nodes[n].b = i32(right)
    n

dc_atom = () -> int:
    token = dn_tokens[dn_at]
    op = token.symbol
    pos = mkpos(dn_file, token.start)
    dn_at += 1
    # (names first: the commonest atom)
    if token.kind == .identifier and (op == .none or op == .kw_test):
        name = int(token.name)
        if name == dn_end_id and dc_index_node != 0:
            # `xs[end]`: the index's last (dw_expr's `$index_end`), per axis
            base = "$index_end{dc_index_node}"
            nodes[dc_index_node].sval = i32(intern(base))
            axis = int(nodes[dc_index_node].aux2)
            spelled = if axis == 0: base else: "{base}_{axis}"
            return comp_ident(intern(spelled), pos)
        if name == dn_end_id or name == dn_new_id or name == dn_type_id: return 0
        if name == dn_none_id: return mk(.none_lit, pos)
        n = mk(.ident, pos)
        nodes[n].name = dw_value_name(token.name, pos)
        return n
    if op == .kw_concurrent: return dc_concurrent(token, false)
    if op == .kw_spawn: return dc_spawn(token)
    if token.kind == .source_integer:
        source = files[dn_file].src
        bytes = source.data()
        first = token.start
        if first + 1 < token.stop and bytes[first] == '0' and bytes[first + 1] == 'd': first += 2
        value: u64 = 0
        wide = false
        loop k in [first..token.stop):
            c = bytes[k]
            if c == '_': continue
            digit = u64(c - '0')
            if value > (u64(0x7FFFFFFFFFFFFFFF) - digit) / 10:
                wide = true
                break
            value = value * 10 + digit
        if wide: return dc_wide_integer(token, pos)
        n = mk(.int_lit, pos)
        nodes[n].ival = int(value)
        add_flag(n, NF_LITERAL)
        return n
    if token.kind == .integer: return dc_wide_integer(token, pos)
    # `0x"0a0b"`: the bytes a based string spells (dw_binary)
    if token.kind == .based_string:
        problem = LiteralProblem("", 0, false)
        packed = literal_packed(problem, dn_payload(token))
        if len(problem.message) > 0: return 0
        text = mk(.str_lit, pos)
        nodes[text].sval = i32(intern(str_from_bytes(packed)))
        callee = mk(.ident, pos)
        nodes[callee].name = i32(intern("bytes"))
        call = mk(.call, pos)
        nodes[call].a = i32(callee)
        set_list(call, [text])
        return call
    if token.kind == .source_real:
        fast = dc_short_real(token)
        if fast != none:
            n = mk(.float_lit, pos)
            nodes[n].fval = fast!
            nodes[n].sval = i32(intern_sub(files[dn_file].src, token.start, token.stop - token.start))
            add_flag(n, NF_LITERAL)
            return n
        number = replace(dn_payload(token), "_", "")
        value = to_float(number)
        if value == none or value! - value! != 0.0: return 0
        n = mk(.float_lit, pos)
        nodes[n].fval = value!
        nodes[n].sval = i32(intern(number))
        add_flag(n, NF_LITERAL)
        return n
    # (`x in? ..b`, `x in? ..`: an open range, dw_iterable's)
    if op == .range and dc_member_depth == dc_depth:
        dn_at -= 1
        return dc_member_range(pos)
    # `[0..n)`, `[1,4..11]`, `(a..b]`: a range value (dw_range_value); in a membership, the range
    # itself, which may be open (`x in? [..0]`, dw_membership)
    if (op == .lbrack or op == .lparen) and dn_peek() != .kw_loop and dn_peek() != .kw_parallel and dc_range_inside(dn_at - 1):
        range = dc_range_atom()
        if range >= 0: return range
    if op == .lparen:
        after = dn_peek()
        if dn_partial_operator(after) or after == .kw_not and dn_token_invert(dn_tokens[dn_at + 1].symbol) != .none: return dc_partial(token)
        return dc_group(pos)
    # `if c a else b` and `match` as values; loops and `$target` chains take the reference grammar
    if op == .kw_if or op == .kw_match:
        dn_at -= 1
        return dc_flow()
    # `$unsafe expression`: the boundary holds over the expression (dw_unsafe_scope)
    if token.kind == .metatag:
        width = token.stop - token.start
        # `$target`, `$build.mode`: the name being compiled for, the build's mode (dw_expr)
        if width == 7 and dn_payload(token) == "target": return dc_target_value(0, pos, -1)
        if width == 6 and dn_payload(token) == "build":
            dot = dn_tokens[dn_at]
            member = dn_tokens[dn_at + 1]
            if dot.symbol != .dot or dot.space or member.space or member.kind != .identifier or dn_payload(member) != "mode": return 0
            dn_at += 2
            return dc_target_value(3, pos, member.start)
        if width == 10 and dn_payload(token) == "allocator": return dc_allocator(token)
        if token.stop - token.start == 5 and dn_payload(token) == "lend": return dc_lend(token)
        if width == 14 and dn_payload(token) == "include_bytes": return dc_include_bytes(pos)
        if not dc_unsafe_at(dn_at - 1): return 0
        operand = dc_expr(0)
        if operand == 0: return 0
        dc_unsafe_scope(pos)
        return operand
    # `@x` selects a place; `@f(a)` partially evaluates f
    if op == .at:
        operand = dn_at
        e = dc_expr(160)
        if e == 0: return 0
        # (`@(m.lock())`: the operand is one group, whose call takes the place it returns)
        if nodes[e].kind == .call and dn_tokens[operand].symbol == .lparen and dc_closing(operand) == dn_at - 1: nodes[e].aux2 = i32(AUX2_PLACE)
        else if nodes[e].kind == .call: nodes[e].aux2 = i32(AUX2_PARTIAL)
        else: add_flag(e, NF_MUT | NF_AT)
        return e
    # `{ ... }`: a block whose value is its last statement's (dw_block)
    if op == .lbrace:
        dn_at -= 1
        return dc_body()
    # `[loop i in xs f(i)]`: a comprehension
    if op == .lbrack and dn_peek() == .kw_loop: return dc_comprehension()
    if op == .lbrack and dn_peek() == .kw_parallel:
        region = dc_parallel(dn_take(), true)
        if region == 0 or not dn_accept(.rbrack): return 0
        return region
    # `[a b c]`, `[x=1 y=2]`, `["a" -> 1]`, `[base... x=1]`, `[1 2 ; 3 4]`
    if op == .lbrack: return dc_array_literal(pos)
    # `.-xs`: elementwise negation (dw_expr's prefix)
    if op == .dot_minus or op == .dot_plus:
        e = dc_expr(dn_prefix_power(op, false))
        if e == 0: return 0
        n = mk(.unary, pos)
        nodes[n].op = i32(int(if op == .dot_minus: Tok.minus else: Tok.plus))
        nodes[n].a = i32(e)
        add_flag(n, NF_BROADCAST)
        return n
    # `~x`: `not x` at a tighter precedence (dw_expr's prefix)
    if op == .tilde:
        e = dc_expr(dn_prefix_power(op, false))
        if e == 0: return 0
        n = mk(.not_, pos)
        nodes[n].op = i32(int(Tok.plus))
        nodes[n].a = i32(e)
        return n
    if op == .plus or op == .minus or op == .kw_not:
        e = dc_expr(dn_prefix_power(op, false))
        if e == 0: return 0
        if op == .minus and nodes[e].kind == .int_lit and nodes[e].aux2 == 0:
            if has_flag(e, NF_U64) and nodes[e].ival != -9223372036854775807 - 1:
                magnitude = u64(nodes[e].ival)
                return dc_bigint_value([magnitude & 0xFFFFFFFF, magnitude >> 32], pos, true)
            nodes[e].ival = -nodes[e].ival
            nodes[e].pos = pos
            nodes[e].aux2 = 1
            clear_flag(e, NF_U64)
            return e
        if op == .minus and nodes[e].kind == .float_lit:
            nodes[e].fval = -nodes[e].fval
            if nodes[e].sval != 0: nodes[e].sval = i32(intern("-" + name_of(int(nodes[e].sval))))
            nodes[e].pos = pos
            return e
        n = mk(if op == .kw_not: NK.not_ else: NK.unary, pos)
        nodes[n].op = i32(int(if op == .minus: Tok.minus else: Tok.plus))
        nodes[n].a = i32(e)
        return n
    if token.kind == .quoted or token.kind == .rawquoted: return dn_string(token, true)
    if token.kind == .boolean:
        n = mk(.bool_lit, pos)
        nodes[n].ival = if int(token.name) == dn_true_id: 1 else: 0
        return n
    0

# A parenthesized group after its `(`: one value, or several (`(a b)`, dw_values), through `)`.
dc_group = (pos: int) -> int:
    # (`(a b)`: several values, dw_values; each may be spread, `(xs... 1)`)
    saved_spread = dc_spread_depth
    dc_spread_depth = dc_depth + 1
    n = dc_expr(0)
    items: int[]
    loop n != 0 and not dn_accept(.rparen):
        if items.len() == 0: items.push(n)
        if not dn_can_start(dn_tokens, dn_at) or dn_tokens[dn_at].symbol == .rparen:
            n = 0
            break
        dc_spread_depth = dc_depth + 1
        item = dc_expr(0)
        if item == 0: n = 0
        else: items.push(item)
    dc_spread_depth = saved_spread
    if n == 0: return 0
    if items.len() == 0:
        if has_flag(n, NF_SPREAD): return 0
        return n
    values = mk(.tuple, pos)
    nodes[values].aux = i32(TUPLE_VALUES)
    set_list(values, items)
    return values

# A bracketed range at dn_at (after its opener), as dc_atom reads one: its value, or in a
# membership the range itself; -1 when the brackets hold no range (nothing read).
dc_range_atom = () -> int:
    start = dn_at
    node_start = nodes.len()
    list_start = lists.len()
    edits = dn_edit_at.len()
    member = dc_member_depth == dc_depth
    axis = dc_axis_depth == dc_depth
    range = dc_range(true, true, member or axis)
    if dn_at < 0: return 0
    if range != 0:
        # (`[1..]`: a slice's or a loop's, not a value: dewy_range_value reports it; an axis among
        # several takes it as a slice, dw_iterable)
        if nodes[range].a == 0 or nodes[range].b == 0:
            if not axis and (not member or has_flag(range, NF_EXCL_FIRST)): return 0
            if axis: dc_open_axes += 1
            dc_range_call = range
            dc_range_node = range
            return range
        value = dw_range_value(range)
        dc_range_call = value
        dc_range_node = range
        return value
    dn_at = start
    nodes.truncate(node_start)
    lists.truncate(list_start)
    dn_edits_undo(edits)
    -1

# An array literal after its `[`, through `]`: elements, a record's named fields and spreads, a
# dictionary's entries, or rows; comprehensions of several kinds and collectors take the reference
# grammar.
dc_array_literal = (pos: int) -> int:
    n = mk(.array, pos)
    saved = dn_comma_stop
    dn_comma_stop = false
    items: int[]
    named = false       # (a row is a named field: the literal is a record)
    positional = false  # (an element neither spread nor named)
    breaks: int[]       # (`[1 2 ; 3 4]`: the row breaks after each element, dw_rows_literal)
    rows = false
    discards: int[]     # (`[f(); 7]`: the elements an attached `;` discards)
    starts: int[]       # (where each element is written)
    flows = false
    targets = dc_targets_made
    loop not dn_accept(.rbrack):
        if dn_tokens[dn_at].kind == .eof: return 0
        if dn_peek() == .semi:
            if breaks.len() == 0: return 0
            breaks[breaks.len() - 1] += 1
            rows = true
            dn_at += 1
            continue
        # (`[x=1 y=2]`: a named field; methods take the reference grammar)
        if dc_named_next():
            field = dn_tokens[dn_at]
            if dn_reserved(int(field.name)) or nodes[n].kind == .map_lit: return 0
            dn_at += 2
            # (`[f=() => ...]`: a method, dw_method_row, when the function reaches a row)
            method = dc_lambda_next()
            value = dc_expr(11)
            if value == 0 or method != (nodes[value].kind == .lambda): return 0
            entry = mk(.namedarg, mkpos(dn_file, field.start))
            nodes[entry].name = field.name
            nodes[entry].a = i32(value)
            items.push(entry)
            named = true
            continue
        # (`[$field("answer")=42]`: a field named by a compile-time string, dw_field_name)
        if dc_field_next():
            entry = dc_field_entry()
            if entry == 0 or nodes[n].kind == .map_lit: return 0
            items.push(entry)
            named = true
            continue
        # (a flow or block element may express several values or none: then the literal collects
        # them, dw_collector)
        first = dn_peek()
        if first == .kw_if or first == .kw_loop or first == .kw_match or first == .lbrace: flows = true
        # (`[xs... 1]`: an element spread; `["a" -> 1]`: a dictionary's entry)
        item_start = dn_tokens[dn_at].start
        item = 0
        if first == .kw_loop:
            item = dc_flow()
            if item == 0 or not dc_flow_ends(): return 0
        else:
            saved_spread = dc_spread_depth
            dc_spread_depth = dc_depth + 1
            item = dc_expr(21)
            dc_spread_depth = saved_spread
        if item == 0: return 0
        if dn_peek() == .arrow:
            if items.len() == 0: nodes[n].kind = .map_lit
            if nodes[n].kind != .map_lit or has_flag(item, NF_SPREAD): return 0
            dn_at += 1
            value = dc_expr(21)
            if value == 0: return 0
            pair = mk(.pair, mkpos(dn_file, item_start))
            nodes[pair].a = i32(item)
            nodes[pair].b = i32(value)
            item = pair
        else if nodes[n].kind == .map_lit: return 0
        if not has_flag(item, NF_SPREAD): positional = true
        # (an attached `;` discards the element: a collector, dw_collects; a pure value's the
        # reference grammar warns of)
        if dn_peek() == .semi and not dn_tokens[dn_at].space and not dn_tokens[dn_at].newline:
            if not dc_discardable(item): return 0
            dn_at += 1
            discards.push(items.len())
        items.push(item)
        starts.push(mkpos(dn_file, item_start))
        breaks.push(0)
    dn_comma_stop = saved
    collects = discards.len() > 0
    if flows:
        loop item in items:
            if not has_flag(item, NF_SPREAD) and dc_multi(item): collects = true
    if collects:
        if named or rows or nodes[n].kind == .map_lit or flows and dc_targets_made != targets: return 0
        return dc_collector(items, starts, discards, pos)
    # (a record's rows are named fields and spreads, dw_record_entry)
    if named:
        if positional or rows: return 0
        nodes[n].kind = .record_lit
        if not dc_literal_methods(items): return 0
    if rows: return dc_rows(n, items, breaks, pos)
    set_list(n, items)
    return n

# An element expressing a number of values other than one (dw_multi_element): a block of other
# than one statement, a loop, an `if` without `else`, or one holding such a body.
dc_multi = (n: int) -> bool:
    if n <= 0: return false
    k = nodes[n].kind
    if k == .exprstmt: return dc_multi(int(nodes[n].a))
    if k == .block:
        if has_flag(n, NF_COMPREHENSION) or has_flag(n, NF_DISCARD): return false
        return nkids(n) != 1 or dc_multi(kid(n, 0))
    if k == .for_ or k == .while_ or k == .loopx: return true
    if k == .if_: return dc_multi(int(nodes[n].b)) or nodes[n].c == 0 or dc_multi(int(nodes[n].c))
    if k == .match_:
        loop arm in kids(n):
            if dc_multi(int(nodes[arm].b)): return true
    false

# A value an attached `;` may discard without the reference grammar's warning (dw_pure): a call.
dc_discardable = (n: int) -> bool:
    if nodes[n].kind != .call or has_flag(n, NF_SPREAD): return false
    callee = int(nodes[n].a)
    nodes[callee].kind != .ident or (nodes[callee].name != i32(dc_builtin(0)) and nodes[callee].name != i32(dc_builtin(1)))

# `[0 {1 2} if c 3]`: a literal collecting every value its elements express, in order
# (dw_collector); starts, where each element is written; discards, those an attached `;` discards.
dc_collector = (items: int[], starts: int[], discards: int[], pos: int) -> int:
    accumulator = intern("$dewy_collection_{nodes.len()}")
    decl = mk(.vardecl, pos)
    nodes[decl].name = i32(accumulator)
    nodes[decl].b = i32(mk(.array, pos))
    statements: int[]
    loop i in 0.. and item in items:
        at = starts[i]
        if discards.contains(i):
            n = mk(.assign, at)
            nodes[n].op = i32(int(Tok.assign))
            nodes[n].a = i32(mk(.hole, at))
            nodes[n].b = i32(item)
            statements.push(n)
            continue
        if has_flag(item, NF_SPREAD):
            clear_flag(item, NF_SPREAD)
            receiver = mk(.ident, at)
            nodes[receiver].name = i32(accumulator)
            add_flag(receiver, NF_MUT)
            callee = mk(.field, at)
            nodes[callee].a = i32(receiver)
            nodes[callee].name = i32(intern("extend"))
            call = mk(.call, at)
            nodes[call].a = i32(callee)
            set_list(call, [item])
            statement = mk(.exprstmt, at)
            nodes[statement].a = i32(call)
            statements.push(statement)
            continue
        k = nodes[item].kind
        if k == .match_ or k == .parallel_region: return 0
        if k == .if_ or k == .for_ or k == .while_ or k == .loopx:
            add_flag(item, NF_STMT)
            if dc_collect(item, accumulator) == 0: return 0
            statements.push(item)
            continue
        if k == .block and not has_flag(item, NF_COMPREHENSION):
            if not dc_collect_block(item, accumulator, false): return 0
            statements.push(item)
            continue
        statement = mk(.exprstmt, at)
        nodes[statement].a = i32(item)
        statement = dc_collect(statement, accumulator)
        if statement == 0: return 0
        statements.push(statement)
    body = mk(.block, pos)
    set_list(body, statements)
    result = mk(.exprstmt, pos)
    value = mk(.ident, pos)
    nodes[value].name = i32(accumulator)
    nodes[result].a = i32(value)
    block = mk(.block, pos)
    set_list(block, [decl, body, result])
    add_flag(block, NF_COMPREHENSION)
    block

# A record literal's function rows, among its entries: each that reaches a row by name is a
# method, taking the object first (dw_literal_method); the rows registered (dw_register_literal_methods).
# False for a function the reach does not follow.
dc_literal_methods = (entries: int[]) -> bool:
    members: int[]
    any = false
    loop entry in entries:
        if nodes[entry].kind != .namedarg: continue
        if nodes[entry].name != 0: members.push(int(nodes[entry].name))
        if nodes[int(nodes[entry].a)].kind == .lambda: any = true
    if not any: return true
    loop entry in entries:
        if nodes[entry].kind != .namedarg or nodes[int(nodes[entry].a)].kind != .lambda: continue
        fn_ = int(nodes[entry].a)
        receiver = intern("$self{nodes.len()}")
        dw_receivers_used.remove(receiver)
        saved = dc_scope
        inner: {int: int} = {}
        loop name, other in saved: inner[name] = other
        loop name in members: inner[name] = receiver
        dc_scope = inner
        reached = dc_reach_fn(fn_)
        dc_scope = saved
        if not reached: return false
        if not dw_receivers_used.has(receiver): continue
        pos = nodes[fn_].pos
        object_type = mk(.ident, pos)
        nodes[object_type].name = i32(intern("$Object{receiver}"))
        if has_flag(fn_, NF_GENERIC): set_list2(fn_, [object_type] + kids2(fn_))
        else:
            captures = kids2(fn_)
            if captures.len() > 0:
                listed = mk(.block, pos)
                set_list(listed, captures)
                nodes[fn_].d = i32(listed)
            set_list2(fn_, [object_type])
            add_flag(fn_, NF_GENERIC)
        receiver_type = mk(.tname, pos)
        nodes[receiver_type].name = nodes[object_type].name
        dw_add_receiver(fn_, receiver, receiver_type)
    dn_edit_at.push(DN_EDIT_METHODS - dewy_methods.len())
    dn_edit_was.push(dn_tokens[dn_at - 1])
    dw_register_literal_methods(entries)
    true

# `(*2)`, `(=? limit)`, `(as float64)` after its `(`: a one-parameter lambda whose operand stands
# in place of the parenthesis (dn_partial).
# (a partial application opens at `at`, `(*2)`)
dc_partial_at = (at: int) -> bool:
    after = dn_tokens[at + 1].symbol
    dn_tokens[at].symbol == .lparen and (dn_partial_operator(after) or after == .kw_not and dn_token_invert(dn_tokens[at + 2].symbol) != .none)

# `(*2)` after its `(`: a lambda of `$partial`; `name_id`, the module function `name = (*2)`
# declares (dw_top_declarations reads the reference grammar's function literal).
dc_partial_name = 0
dc_partial = (opening: DewyLexeme, name_id: i32 = 0) -> int:
    pos = mkpos(dn_file, opening.start)
    if dc_partial_name == 0: dc_partial_name = intern("$partial")
    slot = dn_at - 1
    dn_tokens[slot] = DewyLexeme(.identifier, i32(dc_partial_name), opening.start, opening.stop, opening.space, opening.newline)
    dn_at = slot
    saved_angles = dn_angles
    dn_angles = 0
    value = dc_expr(0)
    dn_angles = saved_angles
    dn_tokens[slot] = opening
    if value == 0 or not dn_accept(.rparen): return 0
    n = mk(if name_id != 0: NK.fn_ else: NK.lambda, pos)
    nodes[n].name = if name_id != 0: name_id else: i32(dc_empty_name())
    p = mk(.param, pos)
    nodes[p].name = i32(dc_partial_name)
    statement = mk(.exprstmt, pos)
    nodes[statement].a = i32(value)
    body = mk(.block, pos)
    set_list(body, [statement])
    dw_finish_function(n, [p], body, if name_id != 0: name_of(int(name_id)) else: "")

# `$include_bytes(p"asset")` after its tag: the asset's bytes, `embed("asset")` (dw_include); one
# naming its type, `... as T`, and the forms dw_include reports take the reference grammar.
dc_include_bytes = (pos: int) -> int:
    opening = dn_tokens[dn_at]
    p = dn_tokens[dn_at + 1]
    path = dn_tokens[dn_at + 2]
    if opening.symbol != .lparen or opening.space or p.kind != .identifier or p.symbol != .none or dn_payload(p) != "p" or path.kind != .quoted or path.space or dn_tokens[dn_at + 3].symbol != .rparen: return 0
    dn_at += 4
    if dn_peek() == .kw_as: return 0
    text = dn_string(path, true)
    if text == 0 or nodes[text].kind != .str_lit: return 0
    callee = mk(.ident, pos)
    nodes[callee].name = i32(intern("embed"))
    call = mk(.call, pos)
    nodes[call].a = i32(callee)
    set_list(call, [text])
    call

# An integer literal the plain decimal reading does not take: based, or beyond int64 (dw_expr's
# integer: a uint64 literal, or an exact one, dw_big_integer). 0 for a mistake the reference
# grammar reports.
dc_wide_integer = (token: DewyLexeme, pos: int) -> int:
    text = dn_payload(token)
    p = LiteralProblem("", 0, false)
    if let value = literal_unsigned(p, text):
        if len(p.message) > 0: return 0
        n = mk(.int_lit, pos)
        nodes[n].ival = int(value)
        add_flag(n, NF_LITERAL)
        if nodes[n].ival < 0: add_flag(n, NF_U64)
        return n
    if len(p.message) > 0: return 0
    limbs = literal_limbs(p, text)
    if len(p.message) > 0: return 0
    dc_bigint_value(limbs, pos, false)

# dw_bigint_value, its module's bigint import asked for undoably: a retry that discards the
# literal discards the request with it (dn_edits_undo).
dc_bigint_value = (limbs: u64[], pos: int, negative: bool) -> int:
    if dw_bigint_import == 0:
        dn_edit_at.push(DN_EDIT_BIGINT)
        dn_edit_was.push(dn_tokens[dn_at - 1])
    dw_bigint_value(limbs, pos, negative)

# The brackets opening at `at` hold a range at their top: a `..` not inside other brackets.
dc_range_inside = (at: int) -> bool:
    depth = 0
    k = at
    loop k < dn_tokens.len():
        t = dn_tokens[k]
        if t.kind == .eof: return false
        symbol = t.symbol
        if symbol == .lparen or symbol == .lbrack or symbol == .lbrace: depth += 1
        else if symbol == .rparen or symbol == .rbrack or symbol == .rbrace:
            depth -= 1
            if depth == 0: return false
        else if symbol == .range and depth == 1: return true
        k += 1
    false

# `[1 2 ; 3 4]`: the elements of an array literal in rows (each element's breaks after it), a
# matrix, or for more levels the elements reshaped (dw_rows_literal). 0 for a literal it reports.
dc_rows = (n: int, elements: int[], breaks: int[], pos: int) -> int:
    loop item in elements:
        if nodes[n].kind != .array or has_flag(item, NF_SPREAD): return 0
    rank = 1
    loop b in breaks: rank = max(rank, b + 1)
    dims = fill(-1, rank)
    counts = fill(0, rank)
    loop i in 0.. and b in breaks:
        counts[0] += 1
        close = rank - 1
        if i + 1 < breaks.len(): close = b
        loop level in [1..close]:
            size = counts[level - 1]
            if dims[level - 1] < 0: dims[level - 1] = size
            else if dims[level - 1] != size: return 0
            counts[level - 1] = 0
            counts[level] += 1
    dims[rank - 1] = counts[rank - 1]
    if rank == 2:
        nodes[n].kind = .matrix
        set_list(n, elements)
        nodes[n].ival = dims[0]
        return n
    set_list(n, elements)
    shape: int[]
    k = rank - 1
    loop k >= 0:
        shape.push(bc_int(dims[k], pos))
        k -= 1
    sizes = mk(.array, pos)
    set_list(sizes, shape)
    bc_call("reshape", [n, sizes], pos)

# The index of the bracket closing the one at `at` (-1: none).
dc_closing = (at: int) -> int:
    depth = 0
    k = at
    loop k < dn_tokens.len():
        t = dn_tokens[k]
        if t.kind == .eof: return -1
        if t.symbol == .lparen or t.symbol == .lbrack or t.symbol == .lbrace: depth += 1
        if t.symbol == .rparen or t.symbol == .rbrack or t.symbol == .rbrace:
            depth -= 1
            if depth == 0: return k
        k += 1
    -1

# A plain real literal (no base prefix or separators) whose significant digits
# and exponent are exact doubles: one correctly rounded operation, as to_float's
# own fast path computes, without materializing the literal's text.
dc_short_real = (token: DewyLexeme) -> f64?:
    source = files[dn_file].src
    bytes = source.data()
    k = token.start
    stop = token.stop
    if bytes[k] == '0' and k + 1 < stop and bytes[k + 1] == 'd': return none
    mant: u64 = 0
    digits = 0
    zeros = 0
    exp = 0
    point = false
    loop k < stop:
        c = bytes[k]
        if c == '.': point = true
        else if c == 'e' or c == 'E': break
        else if c < '0' or c > '9': return none
        else if digits > 0 or c != '0':
            if digits == 19: return none
            mant = mant * 10 + u64(c - '0')
            digits += 1
            zeros = if c == '0': zeros + 1 else: 0
            if point: exp -= 1
        else if point: exp -= 1
        k += 1
    if k < stop:
        k += 1
        negative = false
        if bytes[k] == '+' or bytes[k] == '-':
            negative = bytes[k] == '-'
            k += 1
        e = 0
        loop k < stop:
            c = bytes[k]
            if c < '0' or c > '9' or e > 1000: return none
            e = e * 10 + int(c - '0')
            k += 1
        exp += if negative: -e else: e
    if digits == 0: return 0.0
    loop zeros > 0:
        mant = mant / 10
        digits -= 1
        zeros -= 1
        exp += 1
    if digits > 15 or exp < -22 or exp > 22: return none
    if exp >= 0: return f64(mant) * __pow10(exp)
    f64(mant) / __pow10(-exp)

dc_expr = (minimum: int) -> int:
    dc_depth += 1
    if dc_depth + dn_depth > 256: return 0
    opening = dn_tokens[dn_at]
    pos = mkpos(dn_file, opening.start)
    first_at = dn_at
    left = 0
    # `(params) => body`, `x => body`: a lambda, where `=>` may apply (dw_function)
    # (`x => body` is found at its `=>`, below)
    lambda = minimum <= 30 and (opening.symbol == .lparen and dc_lambda_next() or opening.symbol == .langle and dc_generic_lambda_next())
    if lambda:
        type_params: int[]
        if opening.symbol == .langle:
            # `<T>(x:T) => x`: a generic lambda
            type_params = dc_type_params()
            if type_params.len() == 0: return 0
        else: dn_at += 1
        dc_depth += 3
        left = dc_function_literal(i32(dc_empty_name()), opening, type_params, true)
    else: left = dc_atom()
    if left == 0: return 0
    # (a name, a field route or a parenthesized group: `head(...)` may be a coefficient)
    juxt_head = not lambda and (opening.symbol == .lparen or opening.kind == .identifier and nodes[left].kind == .ident)
    # (a parenthesized group, while nothing has applied to it: `(5)x`, `(x)2` multiply)
    group = if not lambda and opening.symbol == .lparen and dn_tokens[dn_at - 1].symbol == .rparen: left else: -1
    last_call = 0     # (the call this loop made last: a member or index right after it is marked)
    compared = false    # (left is a comparison this loop made)
    compared_op = DewyToken.none     # (its operator, and where its right operand starts)
    compared_at = 0
    chain = -1          # (the chain being read: its first entry in dc_chain_ops, dc_chain_build)
    loop true:
        token = dn_tokens[dn_at]
        op = token.symbol
        if chain >= 0 and not dc_chain_goes_on(token, minimum):
            left = dc_chain_build(chain, pos)
            chain = -1
            if left == 0: return 0
        if token.kind == .eof: break
        if token.newline and dn_power(op) == 0 and op != .kw_not: break
        if dn_angles > 0 and (op == .shr or op == .shr_assign or op == .angle_assign or (op == .gt and not token.space)): break
        if not token.space and (token.kind == .identifier or op == .lparen or token.kind == .source_integer or token.kind == .source_real or token.kind == .integer):
            pk = dn_tokens[dn_at - 1].kind
            if (left == group or pk == .source_integer or pk == .source_real or pk == .integer) and dn_juxtaposed(dn_tokens, dn_at, left == group):
                if minimum > 135: break
                right = dc_expr(136)
                if right == 0: return 0
                left = dc_binary(.multiply_apply, left, right, pos)
                add_flag(left, NF_JUXT)
                juxt_head = false
                continue
            if op != .lparen and dn_juxt_excluded(dn_tokens, dn_at): return 0
        if op == .dot and minimum <= 170:
            dn_at += 1
            member = dn_tokens[dn_at]
            # `f.(xs)`: the call broadcast over its arguments; `value.$field(name)`: a member named
            # by a compile-time string
            if member.symbol == .lparen and not member.space or member.kind == .metatag:
                left = dc_dot_form(left, left == last_call, pos)
                if left == 0: return 0
                if nodes[left].kind == .call: juxt_head = false
                continue
            if member.kind != .identifier: return 0
            dn_at += 1
            # `$target.arch`, `$target.os`: that part of the name (dw_target_field)
            if dc_targets_made > 0 and left == nodes.len() - 1 and dc_target_of(left) == 0:
                word = dn_payload(member)
                if word == "arch" or word == "os":
                    dc_target_note(left, if word == "arch": 1 else: 2, member.start)
                    continue
            n = mk(.field, pos)
            nodes[n].a = i32(left)
            nodes[n].name = member.name
            if left == last_call: add_flag(n, NF_JUXT)
            dewy_note_member(n)
            left = n
            continue
        if not token.space and op == .lparen and minimum <= 170:
            dn_at += 1
            n = mk(.call, pos)
            nodes[n].a = i32(left)
            if juxt_head: add_flag(n, NF_JUXT)
            if nodes[left].kind == .field: add_flag(int(nodes[left].a), NF_MUT)
            # (`members(<'a' | 1>)`: members(U) takes a type, grouped as in a type position)
            if dn_peek() == .langle and nodes[left].kind == .ident and name_of(int(nodes[left].name)) == "members":
                if not dc_members_type(n): return 0
                left = n
                last_call = n
                juxt_head = false
                continue
            if not dc_arguments(n, .rparen): return 0
            left = n
            last_call = n
            juxt_head = false
            continue
        # `xs[i]`, `Point[x y]`, `Point[x=1 y=2]`; ranges, `end`, `new` and
        # `set[...]` take the reference grammar.
        if not token.space and op == .lbrack and minimum <= 170:
            # `set[a b]`: a set of the literal's elements (dw_expr's `__dewy_set`)
            if nodes[left].kind == .ident and dc_word(int(nodes[left].name)) == DC_SET and left == nodes.len() - 1:
                elements = dc_atom()
                if elements == 0: return 0
                left = bc_call("__dewy_set", [elements], pos)
                juxt_head = false
                continue
            dn_at += 1
            n = mk(.index, pos)
            nodes[n].a = i32(left)
            if left == last_call: add_flag(n, NF_JUXT)
            # (`end` inside is this index's last: dw_index_context)
            saved_index = dc_index_node
            dc_index_node = n
            read = dc_index(n)
            dc_index_node = saved_index
            if not read: return 0
            nodes[n].aux2 = 0
            left = n
            juxt_head = false
            continue
        # `f<T>(x)`: the application as a type, and its arguments again as types
        if not token.space and op == .langle and minimum <= 160:
            # (`b.read<uint64>(2)`: a module's name, dw_type's `.`)
            name_token = dn_tokens[dn_at - 1]
            first = dn_at - 1
            if not dc_named_base(left):
                left = dc_type_applied(left, pos)
                if left == 0: return 0
                juxt_head = false
                continue
            if nodes[left].kind == .field and dn_at >= 3 and dn_tokens[dn_at - 2].symbol == .dot and dn_tokens[dn_at - 3].kind == .identifier and nodes[int(nodes[left].a)].kind == .ident and nodes[int(nodes[left].a)].pos == mkpos(dn_file, dn_tokens[dn_at - 3].start): first = dn_at - 3
            else if nodes[left].kind != .ident or name_token.kind != .identifier or nodes[left].pos != mkpos(dn_file, name_token.start): return 0
            at = dn_at
            dn_at = first
            edits = dn_edit_at.len()
            whole = dc_type_named()
            # (`small = int64<i => ...>`: a refinement names a type, dw_top_declarations)
            if whole == 0 or nodes[whole].kind == .trefined: return 0
            stop = dn_at
            n = mk(.typeapply, pos)
            nodes[n].a = i32(left)
            nodes[n].c = i32(whole)
            args: int[]
            # (`int64<overflow='wrap'>(x)`: a policy is no type argument)
            if nodes[whole].aux != -9:
                # (the arguments read again from their original tokens: a closer split again)
                dn_edits_undo(edits)
                dn_at = at + 1
                loop not dn_accept(.rangle):
                    arg = dc_annotation()
                    if arg == 0: return 0
                    args.push(arg)
                if dn_at != stop: return 0
            set_list(n, args)
            left = n
            juxt_head = false
            continue
        if op == .kw_or_throw and minimum <= 48:
            dn_at += 1
            n = mk(.propagate, pos)
            nodes[n].a = i32(left)
            left = n
            juxt_head = false
            continue
        if not token.space and (token.kind == .quoted or token.kind == .rawquoted) and minimum <= 170:
            # `b'a'`, `b"abc"`: a byte, or an array of bytes (dw_byte_literal)
            if nodes[left].kind == .ident and dc_word(int(nodes[left].name)) == DC_B:
                written = dn_tokens[dn_at - 1]
                if written.kind != .identifier or nodes[left].pos != mkpos(dn_file, written.start): return 0
                literal = dc_byte_literal(token)
                if literal == 0: return 0
                dn_at += 1
                left = literal
                last_call = literal
                juxt_head = false
                continue
            dn_at += 1
            arg = dn_string(token, true)
            if arg == 0: return 0
            n = mk(.call, pos)
            nodes[n].a = i32(left)
            if nodes[left].kind == .field: add_flag(int(nodes[left].a), NF_MUT)
            set_list(n, [arg])
            left = n
            last_call = n
            juxt_head = false
            continue
        if op == .kw_not and dn_at + 1 < dn_tokens.len():
            inverted = dn_token_invert(dn_tokens[dn_at + 1].symbol)
            if inverted != .none: op = inverted
        if op == .comma and dn_comma_stop: break
        # `x => body`: the name just read is a lambda's one parameter
        if op == .function and minimum <= 30 and left == nodes.len() - 1 and nodes[left].kind == .ident and opening.kind == .identifier and dn_tokens[dn_at - 1].start == opening.start and dc_lambda_next_at(dn_at - 1):
            nodes.truncate(left)
            dn_at -= 1
            dc_depth += 3
            left = dc_function_literal(i32(dc_empty_name()), opening, [], true, true)
            if left == 0: return 0
            juxt_head = false
            group = -1
            continue
        # (`key -> value` as a comprehension's element: dc_body_read pairs them)
        if dc_map_ok and op == .arrow: break
        power = dn_power(op)
        if power == 0 or power < minimum: break
        # (a slice's first bound ends at its `..`; elsewhere a range takes the reference grammar)
        # (`evens = 0,2..100`: a stepped range's two starts, below)
        step = 0
        if op == .comma and dc_index_node == 0 and dc_member_depth != dc_depth and minimum <= dn_power(.range):
            dn_at += 1
            step = dc_expr(power + 1)
            if step == 0 or dn_peek() != .range: return 0
            op = DewyToken.range
            power = dn_power(op)
        if op == .range:
            if dc_range_top and minimum == 0 and step == 0: break
            # (`x in? a..b`, `x in? a..`: the range itself, dw_membership; elsewhere `a..b` and
            # `a,b..c` are range values, dw_range_value)
            member = dc_member_depth == dc_depth
            if not member and (dc_index_node != 0 or dc_range_top): return 0
            dn_at += 1
            last = 0
            if dn_range_bound(dn_tokens, dn_at):
                last = dc_expr(power + 1)
                if last == 0: return 0
            n = mk(.range, pos)
            nodes[n].a = i32(left)
            nodes[n].b = i32(last)
            add_flag(n, NF_INCLUSIVE)
            if step != 0:
                if member: return 0
                nodes[n].c = i32(step)
                add_flag(n, NF_STEP)
            left = n
            if not member:
                if last == 0: return 0
                left = dw_range_value(n)
            juxt_head = false
            continue
        if (op == .plus or op == .minus) and token.space and not dn_tokens[dn_at + 1].space: break
        # `x is? T`, `x isnt? T`, `x as T`, `x transmute T`: a type on the right
        if token.symbol == op and (op == .is_type or op == .isnt_type or op == .kw_as or op == .kw_transmute):
            if compared and (op == .is_type or op == .isnt_type): return 0
            dn_at += 1
            t = dc_cast_type(op == .kw_as, power)
            if t == 0: return 0
            n = mk(if op == .kw_as or op == .kw_transmute: NK.cast else: NK.istype, pos)
            nodes[n].a = i32(left)
            nodes[n].b = i32(t)
            if op == .kw_transmute: nodes[n].aux2 = 1
            if op == .isnt_type:
                inverted = mk(.not_, pos)
                nodes[inverted].a = i32(n)
                n = inverted
            left = n
            compared = false
            juxt_head = false
            continue
        # `a ?? b`: an arithmetic fallback (`a ?? 1 + n`) has a warning of its own
        if op == .coalesce:
            # `x ??<A | B> fallback`: the fallback only for the kinds listed, one type (c)
            if dn_at + 1 < dn_tokens.len() and not dn_tokens[dn_at + 1].space and (dn_tokens[dn_at + 1].symbol == .langle or dn_tokens[dn_at + 1].symbol == .lt):
                left = dc_listed_coalesce(left, power, pos)
                if left == 0: return 0
                compared = false
                juxt_head = false
                continue
            dn_at += 1
            right = dc_expr(power)
            if right == 0 or dc_arithmetic(right): return 0
            n = mk(.coalesce, pos)
            nodes[n].a = i32(left)
            nodes[n].b = i32(right)
            left = n
            compared = false
            juxt_head = false
            continue
        # `x |> f`, `f <| x`: the value supplied to the callable (dw_expr's pipes)
        if op == .pipe_right or op == .pipe_left:
            left = dc_pipe(op, left, power, pos)
            if left == 0: return 0
            compared = false
            juxt_head = false
            continue
        # `a nand b`: `not (a and b)`, as `nor` and `xnor` are of `or` and `xor` (the `not` at the word)
        if op == .kw_nand or op == .kw_nor or op == .kw_xnor:
            left = dc_word_not(op, left, power, pos)
            if left == 0: return 0
            compared = false
            juxt_head = false
            continue
        scalar_op = dn_token_uninvert(op)
        if dc_binary_token(scalar_op) == .eof and op != .slash and op != .floor and op != .percent and op != .caret:
            # `xs .+ ys`, `a .* 2`: elementwise (dw_broadcast)
            scalar = dn_token_undot(op)
            if scalar == .none or token.symbol != op: return 0
            dn_at += 1
            right = dc_expr(if dn_right_associative(op): power else: power + 1)
            if right == 0: return 0
            left = dc_broadcast(scalar, left, right, pos)
            if left == 0: return 0
            compared = false
            juxt_head = false
            continue
        # `a <? b <=? c`: a comparison chain (dw_chain), its links read in order; one through
        # `not` the reference grammar reports
        chained = dw_chain_way(scalar_op) != 2 or scalar_op == .not_eq
        if chained and compared:
            if token.symbol != op or scalar_op != op: return 0
            if chain < 0:
                if nodes[left].kind != .binary or dn_token_uninvert(compared_op) != compared_op: return 0
                chain = dc_chain_ops.len()
                dc_chain_push(.none, int(nodes[left].a), first_at)
                dc_chain_push(compared_op, int(nodes[left].b), compared_at)
            dn_at += 1
            at = dn_at
            right = dc_expr(power + 1)
            if right == 0: return 0
            dc_chain_push(op, right, at)
            continue
        dn_at += 1
        if token.symbol == .kw_not: dn_at += 1
        membership = op == .contains or op == .not_contains
        if membership: dc_range_call = 0
        compared_op = op
        compared_at = dn_at
        saved_member = dc_member_depth
        if membership: dc_member_depth = dc_depth + 1
        right = dc_expr(if dn_right_associative(op): power else: power + 1)
        dc_member_depth = saved_member
        if right == 0: return 0
        # (`x in? [0..9]`: membership in the range itself, dw_membership)
        if membership and dc_range_call == right and not has_flag(dc_range_node, NF_STEP) and not has_flag(dc_range_node, NF_EXCL_FIRST): right = dc_range_node
        # (`f & g` of function literals: an overload group, declared at module level only)
        if op == .amp and (dc_overloads(left) or dc_overloads(right)): return 0
        # (`a(x)^2` with the call unparenthesized: the power may take the group, juxtapose.jo)
        powered_call = op == .caret and left == last_call
        left = dc_binary(op, left, right, pos)
        if powered_call: add_flag(left, NF_JUXT)
        compared = chained
        juxt_head = false
    if chain >= 0:
        left = dc_chain_build(chain, pos)
        if left == 0: return 0
    # These suffixes belong to this expression, but have not migrated yet.
    token = dn_tokens[dn_at]
    if not token.space and (token.symbol == .lbrack or token.symbol == .langle or token.kind == .quoted or token.kind == .rawquoted): return 0
    if token.symbol == .question or token.symbol == .ellipsis:
        # (`xs...` as a whole array element: dc_spread_depth; anywhere else the reference grammar)
        if token.symbol == .question or dc_depth != dc_spread_depth or minimum > 170: return 0
        after = dn_tokens[dn_at + 1]
        if not (after.space or after.newline or after.symbol == .rbrack or after.symbol == .rparen) or dn_power(after.symbol) > 0 or after.symbol == .dot or after.symbol == .question or after.symbol == .ellipsis: return 0
        dn_at += 1
        add_flag(left, NF_SPREAD)
    dc_depth -= 1
    left

# `xs[0]<int64>`, `make().f<int64>` at the `<`: no type is named, only its arguments, each a type
# (dw_expr's type application).
dc_type_applied = (left: int, pos: int) -> int:
    dn_at += 1
    args: int[]
    dc_type_args += 1
    loop not dn_accept(.rangle):
        if dn_edits_on and dn_closer_joined():
            dn_split_closer()
            break
        arg = dc_annotation()
        if arg == 0:
            dc_type_args -= 1
            return 0
        args.push(arg)
    dc_type_args -= 1
    n = mk(.typeapply, pos)
    nodes[n].a = i32(left)
    set_list(n, args)
    n

# `x |> f`, `f <| x` at the operator: the value supplied to the callable (dw_expr's pipes).
dc_pipe = (op: DewyToken, left: int, power: int, pos: int) -> int:
    dn_at += 1
    right = dc_expr(if dn_right_associative(op): power else: power + 1)
    if right == 0: return 0
    n = mk(.call, pos)
    callee = right
    supplied = left
    if op == .pipe_left:
        callee = left
        supplied = right
    nodes[n].a = i32(callee)
    set_list(n, [supplied])
    n

# `a nand b` at the operator: `not (a and b)`, as `nor` and `xnor` are of `or` and `xor`, the `not`
# at the word.
dc_word_not = (op: DewyToken, left: int, power: int, pos: int) -> int:
    word = dn_take()
    right = dc_expr(power + 1)
    if right == 0: return 0
    base = DewyToken.kw_and
    if op == .kw_nor: base = .kw_or
    if op == .kw_xnor: base = .kw_xor
    inner = dc_binary(base, left, right, pos)
    if inner == 0: return 0
    n = mk(.not_, mkpos(dn_file, word.start))
    nodes[n].op = i32(int(Tok.plus))
    nodes[n].a = i32(inner)
    n

# `x ??<A | B> fallback` at `??`: the fallback only for the kinds listed, one type (c).
dc_listed_coalesce = (left: int, power: int, pos: int) -> int:
    dn_at += 1
    dn_tokens[dn_at].symbol = .langle
    dn_at += 1
    dc_type_args += 1
    kinds = dc_annotation()
    dc_type_args -= 1
    if kinds == 0: return 0
    if not dn_accept(.rangle):
        if not (dn_edits_on and dn_closer_joined()): return 0
        dn_split_closer()
    right = dc_expr(power)
    if right == 0: return 0
    n = mk(.coalesce, pos)
    nodes[n].a = i32(left)
    nodes[n].b = i32(right)
    nodes[n].c = i32(kinds)
    n

# The type after `as`, `is?` or `transmute`; `bytes as string ?? ""` (cast): no type has a
# fallback, so this converts to an optional and falls back, as `(bytes as string | none) ?? ""`
# (the fallback is dc_expr's next operator).
dc_cast_type = (cast: bool, power: int) -> int:
    type_at = dn_at
    dc_cast_coalesce = cast
    t = dc_annotation(power)
    dc_cast_coalesce = false
    if t == 0 or not cast or dn_peek() != .coalesce: return t
    type_pos = mkpos(dn_file, dn_tokens[type_at].start)
    missing = mk(.tname, type_pos)
    nodes[missing].name = i32(dc_none_type())
    optional = mk(.tunion, type_pos)
    set_list(optional, [t, missing])
    optional

# After `.`: `f.(xs)`, the call broadcast over its arguments (dw_expr's broadcast call), or
# `value.$field(name)`, a member named by a compile-time string (dw_field_name); 0 for another form.
dc_dot_form = (left: int, after_call: bool, pos: int) -> int:
    member = dn_tokens[dn_at]
    if member.symbol == .lparen:
        dn_at += 1
        n = mk(.call, pos)
        nodes[n].a = i32(left)
        add_flag(n, NF_BROADCAST)
        if nodes[left].kind == .field: add_flag(int(nodes[left].a), NF_MUT)
        if not dc_arguments(n, .rparen): return 0
        return n
    if dn_tokens[dn_at + 1].symbol != .lparen or dn_payload(member) != "field": return 0
    dn_at += 2
    computed = dc_expr(0)
    if computed == 0 or not dn_accept(.rparen): return 0
    n = mk(.field, pos)
    nodes[n].a = i32(left)
    nodes[n].b = i32(computed)
    if after_call: add_flag(n, NF_JUXT)
    n

# `members(<'a' | 1>)` after its `(`: members(U) takes a type, grouped as in a type position, into
# the call n.
dc_members_type = (n: int) -> bool:
    t = dc_type_primary()
    if t == 0 or not dn_accept(.rparen): return false
    set_list(n, [t])
    true

# The value a type application is written on is a name, or a field route from one.
dc_named_base = (n: int) -> bool:
    base = n
    loop nodes[base].kind == .field: base = int(nodes[base].a)
    nodes[base].kind == .ident

# The open range at `..` (its first bound 0), as a membership reads it (dw_iterable's slice).
dc_member_range = (pos: int) -> int:
    dn_at += 1
    last = 0
    if dn_range_bound(dn_tokens, dn_at):
        last = dc_expr(101)
        if last == 0: return 0
    n = mk(.range, pos)
    nodes[n].b = i32(last)
    if last != 0: add_flag(n, NF_INCLUSIVE)
    n

# A comparison chain's entries, read by the dc_expr reading it: each operand, where it starts, and
# the link before it (none before the first).
dc_chain_ops: DewyToken[]
dc_chain_operands: int[]
dc_chain_starts: int[]

dc_chain_push = (op: DewyToken, operand: int, at: int):
    dc_chain_ops.push(op)
    dc_chain_operands.push(operand)
    dc_chain_starts.push(at)

# The chain goes on at token (a comparison, or one through `not` that dc_expr refuses).
dc_chain_goes_on = (token: DewyLexeme, minimum: int) -> bool:
    op = token.symbol
    if token.kind == .eof: return false
    if op == .kw_not:
        op = dn_token_invert(dn_tokens[dn_at + 1].symbol)
        if op == .none: return false
    else if dn_angles > 0 and op == .gt and not token.space: return false
    scalar = dn_token_uninvert(op)
    if dw_chain_way(scalar) == 2 and scalar != .not_eq: return false
    dn_power(op) >= minimum

# The chain from entry mark on, as dw_chain makes it: each operand evaluated once, in order (a
# temporary holds one that is not plain), later links only while it holds. 0: a chain that turns
# (the reference grammar reports it).
dc_chain_build = (mark: int, pos: int) -> int:
    way = 0
    loop k in [mark + 1..dc_chain_ops.len()):
        w = dw_chain_way(dc_chain_ops[k])
        if w == 0: continue
        if way != 0 and w != way:
            dc_chain_truncate(mark)
            return 0
        way = w
    statements: int[]
    first = dc_chain_operands[mark]
    if not dc_chain_plain(mark): first = dw_chain_temp(first, statements, pos)
    chain = dc_chain_from(mark + 1, first, pos)
    dc_chain_truncate(mark)
    dc_chains_made += 1
    if chain == 0 or statements.len() == 0: return chain
    statements.push(bc_stmt(chain, pos))
    bc_block(statements, pos)

dc_chain_truncate = (mark: int):
    dc_chain_ops.truncate(mark)
    dc_chain_operands.truncate(mark)
    dc_chain_starts.truncate(mark)

# The link at entry k, from the value left of it (dw_chain_from).
dc_chain_from = (k: int, left: int, pos: int) -> int:
    comparison = mk(.binary, pos)
    nodes[comparison].op = i32(int(dc_binary_token(dc_chain_ops[k])))
    nodes[comparison].a = i32(left)
    right = dc_chain_operands[k]
    nodes[comparison].b = i32(right)
    if k + 1 == dc_chain_ops.len(): return comparison
    statements: int[]
    next = 0
    if dc_chain_plain(k):
        # (read again: a plain operand is evaluated where each link reads it)
        saved = dn_at
        dn_at = dc_chain_starts[k]
        next = dc_expr(dn_power(dc_chain_ops[k]) + 1)
        dn_at = saved
        if next == 0: return 0
    else:
        value = dw_chain_temp(right, statements, pos)
        nodes[comparison].b = i32(value)
        next = bc_ident(name_of(int(nodes[value].name)), pos)
    both = mk(.and_, pos)
    nodes[both].a = i32(comparison)
    rest = dc_chain_from(k + 1, next, pos)
    if rest == 0: return 0
    nodes[both].b = i32(rest)
    if statements.len() == 0: return both
    statements.push(bc_stmt(both, pos))
    bc_block(statements, pos)

# The operand at entry k is read twice without changing anything (dw_chain_plain): a name, a
# literal or a member of one, unparenthesized.
dc_chain_plain = (k: int) -> bool:
    t = dn_tokens[dc_chain_starts[k]]
    if not (t.kind == .identifier or t.kind == .source_integer or t.kind == .integer or t.kind == .source_real or t.kind == .boolean): return false
    dc_plain_operand(dc_chain_operands[k])

dc_plain_operand = (n: int) -> bool:
    k = nodes[n].kind
    if k == .ident or k == .none_lit or k == .bool_lit or k == .float_lit: return true
    if k == .int_lit: return nodes[n].aux2 == 0
    # (an exact integer literal)
    if k == .call: return nodes[n].aux2 == -1
    k == .field and dc_plain_operand(int(nodes[n].a))

# An index's entries after its `[`, through its `]`: `xs[i]`, `m[i j]`, `Point[x=1 y=2]`, or one
# slice, `xs[a..b]`, `xs[a..b)`, `xs[a..]`, `xs[..b)`.
dc_index = (n: int) -> bool:
    if dn_tokens[dn_at].kind == .metatag: return dc_clamp(n)
    if dc_new_inside(): return dc_new_axes(n)
    # (`mean[loop r in rs r*2]`: one comprehension, dw_comprehension)
    if dn_peek() == .kw_loop:
        made = dc_comprehension()
        if made == 0: return false
        set_list(n, [made])
        nodes[n].b = i32(made)
        return true
    first_pos = mkpos(dn_file, dn_tokens[dn_at].start)
    first = 0
    if dn_peek() == .rbrack or dc_named_next():
        if not dc_axes(n, 0, 0): return false
        if nkids(n) == 1: nodes[n].b = i32(kid(n, 0))
        return true
    first_range = 0
    if dc_whole_axis():
        # (`m[[..] 1]`: a whole axis, among several)
        first = mk(.range, mkpos(dn_file, dn_tokens[dn_at + 1].start))
        first_range = first
        dn_at += 3
    second = 0
    if first_range == 0 and dn_peek() != .range:
        # (`xs[a,b..c]`: a stepped slice's two starts, dw_iterable's comma)
        saved_comma = dn_comma_stop
        dn_comma_stop = true
        dc_range_top = true
        dc_range_call = 0
        saved_axis = dc_axis_depth
        dc_axis_depth = dc_depth + 1
        open_before = dc_open_axes
        first = dc_expr(0)
        dc_axis_depth = saved_axis
        dc_range_top = false
        if first != 0 and dc_open_axes != open_before and dc_range_call != first: first = 0
        if first != 0 and dc_range_call == first: first_range = dc_range_node
        if first != 0 and first_range == 0 and dn_accept(.comma):
            dc_range_top = true
            second = dc_expr(0)
            dc_range_top = false
            if second == 0 or dn_peek() != .range: first = 0
        dn_comma_stop = saved_comma
        if first == 0: return false
    if dn_peek() == .range:
        dn_at += 1
        # (`xs[..]`: the whole array)
        if first == 0 and dn_peek() == .rbrack:
            range = mk(.range, mkpos(dn_file, dn_tokens[dn_at - 1].start))
            dn_at += 1
            set_list(n, [range])
            nodes[n].b = i32(range)
            return true
        if first == 0 and not dn_range_bound(dn_tokens, dn_at): return false
        last = 0
        if dn_range_bound(dn_tokens, dn_at):
            last = dc_expr(101)
            if last == 0: return false
        inclusive = dn_accept(.rbrack)
        if not inclusive and not dn_accept(.rparen): return false
        range = mk(.range, first_pos)
        nodes[range].a = i32(first)
        nodes[range].b = i32(last)
        if second != 0:
            nodes[range].c = i32(second)
            add_flag(range, NF_STEP)
        if inclusive: add_flag(range, NF_INCLUSIVE)
        set_list(n, [range])
        nodes[n].b = i32(range)
        return true
    if not dc_axes(n, first, first_range): return false
    if nkids(n) == 1: nodes[n].b = i32(kid(n, 0))
    true

# An index's entries, from dn_at through its `]`, name `new` at their top.
dc_new_inside = () -> bool:
    depth = 0
    k = dn_at
    loop k < dn_tokens.len():
        t = dn_tokens[k]
        if t.kind == .eof: return false
        symbol = t.symbol
        if symbol == .lparen or symbol == .lbrack or symbol == .lbrace: depth += 1
        else if symbol == .rparen or symbol == .rbrack or symbol == .rbrace:
            if depth == 0: return false
            depth -= 1
        else if depth == 0 and t.kind == .identifier and int(t.name) == dn_new_id: return true
        k += 1
    false

# `m[new ..]`, `m[.. new]`, `m[[..] end new]`: an index inserting axes, through its `]` (dw_expr's
# `new` entries, dw_new_range): each `new` the name `$new`, `..` beside one a whole axis; the
# other entries as dc_axes reads them. The node becomes a new_axis.
dc_new_axes = (n: int) -> bool:
    args: int[]
    mark = dc_axis_ranges.len()
    entries = 0
    loop not dn_accept(.rbrack):
        token = dn_tokens[dn_at]
        if token.kind == .eof: return dc_axes_end(mark, false)
        entries += 1
        nodes[n].aux2 = i32(args.len())
        pos = mkpos(dn_file, token.start)
        new_first = token.kind == .identifier and int(token.name) == dn_new_id
        if new_first or token.symbol == .range:
            # (`new`, `new ..`, `new .. new`, `.. new`, `..`)
            at = dn_at
            if new_first: at += 1
            if dn_tokens[at].symbol != .range:
                if not new_first: return dc_axes_end(mark, false)
                dn_at = at
                args.push(bc_ident("$new", pos))
                dc_axis_ranges.push(0)
                continue
            last = dn_tokens[at + 1]
            new_last = dn_range_bound(dn_tokens, at + 1) and last.kind == .identifier and int(last.name) == dn_new_id
            if dn_range_bound(dn_tokens, at + 1) and not (new_last and (dn_tokens[at + 2].symbol == .rbrack or dn_tokens[at + 2].space)): return dc_axes_end(mark, false)
            # (`..` alone among several entries: a whole axis, dw_iterable's slice)
            if not new_first and not new_last:
                dn_at = at + 1
                whole = mk(.range, pos)
                args.push(whole)
                dc_axis_ranges.push(whole)
                continue
            dn_at = at + 1
            if new_first: args.push(bc_ident("$new", pos))
            args.push(mk(.range, pos))
            if new_last:
                dn_at += 1
                args.push(bc_ident("$new", pos))
            loop k in [0..args.len() - dc_axis_ranges.len() + mark): dc_axis_ranges.push(0)
            continue
        if dc_named_next(): return dc_axes_end(mark, false)
        if dc_whole_axis():
            whole = mk(.range, mkpos(dn_file, dn_tokens[dn_at + 1].start))
            dn_at += 3
            args.push(whole)
            dc_axis_ranges.push(whole)
            continue
        dc_range_call = 0
        dc_range_top = true
        arg = dc_expr(0)
        dc_range_top = false
        if arg == 0: return dc_axes_end(mark, false)
        slice = 0
        if dc_range_call == arg: slice = dc_range_node
        # (`m[1..end new]`: a range written without brackets, inclusive)
        if dn_accept(.range):
            if slice != 0: return dc_axes_end(mark, false)
            first_bound = arg
            last = 0
            if dn_range_bound(dn_tokens, dn_at):
                last = dc_expr(101)
                if last == 0: return dc_axes_end(mark, false)
            arg = mk(.range, pos)
            nodes[arg].a = i32(first_bound)
            nodes[arg].b = i32(last)
            add_flag(arg, NF_INCLUSIVE)
            slice = arg
        args.push(arg)
        dc_axis_ranges.push(slice)
    # (several entries: a bracketed range among them is a slice, dw_iterable)
    if entries > 1:
        loop i in [0..args.len()):
            if dc_axis_ranges[mark + i] != 0: args[i] = dc_axis_ranges[mark + i]
    nodes[n].kind = .new_axis
    set_list(n, args)
    if args.len() == 1: nodes[n].b = i32(args[0])
    dc_axes_end(mark, true)

# `xs[$clamp a..b)` after its `[`: the slice truncated to the receiver (dw_clamp_slice), into n.
dc_clamp = (n: int) -> bool:
    tag = dn_tokens[dn_at]
    if tag.stop - tag.start != 6 or dn_payload(tag) != "clamp": return false
    dn_at += 1
    pos = mkpos(dn_file, dn_tokens[dn_at].start)
    first = 0
    if dn_peek() != .range:
        saved_comma = dn_comma_stop
        dn_comma_stop = true
        dc_range_top = true
        first = dc_expr(0)
        dc_range_top = false
        dn_comma_stop = saved_comma
        if first == 0 or dn_peek() != .range: return false
    dn_at += 1
    last = 0
    if dn_range_bound(dn_tokens, dn_at):
        last = dc_expr(101)
        if last == 0: return false
    inclusive = dn_accept(.rbrack)
    if not inclusive and not dn_accept(.rparen): return false
    r = mk(.range, pos)
    nodes[r].a = i32(first)
    nodes[r].b = i32(last)
    if inclusive: add_flag(r, NF_INCLUSIVE)
    block = dw_clamp_block(n, r)
    nodes[n] = nodes[block]
    true

# A byte literal's string, as dw_byte_literal makes it: 0 where that reports a
# mistake (the reference grammar reports it)
dc_byte_literal = (token: DewyLexeme) -> int:
    if token.kind != .quoted: return 0
    source = files[dn_file].src
    width = dn_quote_width(source, token.start, token.stop)
    stop = token.stop - width
    problem = LiteralProblem("", 0, false)
    text: u8[]
    if literal_string_text(problem, text, source, token.start + width, stop) < stop or len(problem.message) > 0: return 0
    pos = mkpos(dn_file, token.start)
    single = source[token.start] == '\''
    if single and text.len() != 1: return 0
    u8 = mk(.tname, pos)
    nodes[u8].name = i32(intern("u8"))
    n = mk(.cast, pos)
    if single:
        nodes[n].a = i32(bc_int(int(text[0]), pos))
        nodes[n].b = i32(u8)
        return n
    elements: int[]
    loop c in text: elements.push(bc_int(int(c), pos))
    values = mk(.array, pos)
    set_list(values, elements)
    t = mk(.tarray, pos)
    nodes[t].a = i32(u8)
    nodes[n].a = i32(values)
    nodes[n].b = i32(t)
    n

dc_overloads = (n: int) -> bool:
    if nodes[n].kind == .lambda: return true
    nodes[n].kind == .binary and nodes[n].op == i32(int(Tok.amp)) and (dc_overloads(int(nodes[n].a)) or dc_overloads(int(nodes[n].b)))

# An elementwise operator's node (dw_broadcast): 0 for one the reference grammar reports.
dc_broadcast = (op: DewyToken, a: int, b: int, pos: int) -> int:
    if op == .slash or op == .floor or op == .percent or op == .caret:
        k = if op == .slash: 0 else if op == .caret: 1 else if op == .floor: 2 else: 3
        callee = mk(.ident, pos)
        nodes[callee].name = i32(dc_builtin(k))
        n = mk(.call, pos)
        nodes[n].a = i32(callee)
        set_list(n, [a, b])
        add_flag(n, NF_BROADCAST)
        return n
    spelling = dn_token_uninvert(op)
    if not (spelling == .plus or spelling == .minus or spelling == .star or spelling == .eq or spelling == .lt or spelling == .le or spelling == .gt or spelling == .ge): return 0
    n = mk(.binary, pos)
    nodes[n].op = i32(int(Tok.dotop))
    nodes[n].aux = i32(dn_token_text(spelling)[0])
    nodes[n].aux2 = if spelling == .le or spelling == .ge: 1 else: 0
    nodes[n].ival = int(spelling != op)
    nodes[n].a = i32(a)
    nodes[n].b = i32(b)
    n

dc_arithmetic = (n: int) -> bool:
    k = nodes[n].kind
    if k == .binary:
        op = Tok(int(nodes[n].op))
        return op == .plus or op == .minus or op == .star
    if k == .call and nodes[int(nodes[n].a)].kind == .ident:
        name = name_of(int(nodes[int(nodes[n].a)].name))
        return name == "__dewy_divide" or name == "__floor_div" or name == "__floor_mod" or name == "__dewy_power"
    false

# `name=value` is next (a named argument or a record field).
dc_named_next = () -> bool:
    token = dn_tokens[dn_at]
    token.kind == .identifier and (token.symbol == .none or token.symbol == .kw_test) and dn_tokens[dn_at + 1].symbol == .assign

# `$field(name)=value` is next: a row named by a compile-time string.
dc_field_next = () -> bool:
    token = dn_tokens[dn_at]
    token.kind == .metatag and token.stop - token.start == 6 and dn_tokens[dn_at + 1].symbol == .lparen and not dn_tokens[dn_at + 1].space and dn_payload(token) == "field"

# `$field(name)=value` (dc_field_next): the row (dw_record_entry), its name computed; 0 for a form
# the reference grammar reads.
dc_field_entry = () -> int:
    pos = mkpos(dn_file, dn_tokens[dn_at].start)
    dn_at += 2
    computed = dc_expr(0)
    if computed == 0 or not dn_accept(.rparen) or not dn_accept(.assign) or dc_lambda_next(): return 0
    value = dc_expr(11)
    if value == 0 or nodes[value].kind == .lambda: return 0
    entry = mk(.namedarg, pos)
    nodes[entry].b = i32(computed)
    nodes[entry].a = i32(value)
    entry

# Arguments up to the closing bracket, positional or `name=value`.
dc_arguments = (n: int, close: DewyToken, first: int = 0) -> bool:
    args: int[]
    if first != 0: args.push(first)
    # (`f(xs...)`: a call's spread argument, dw_spread_item)
    saved_spread = dc_spread_depth
    loop not dn_accept(close):
        token = dn_tokens[dn_at]
        if token.kind == .eof:
            dc_spread_depth = saved_spread
            return false
        if dc_named_next():
            dn_at += 2
            dc_spread_depth = saved_spread
            value = dc_expr(11)
            if value == 0: return false
            named = mk(.namedarg, mkpos(dn_file, token.start))
            nodes[named].name = token.name
            nodes[named].a = i32(value)
            args.push(named)
            continue
        dc_spread_depth = dc_depth + 1
        arg = dc_expr(0)
        if arg == 0:
            dc_spread_depth = saved_spread
            return false
        args.push(arg)
    dc_spread_depth = saved_spread
    set_list(n, args)
    true

# An index's entries through its `]`, after `first` (a range value first_range is the range of,
# or 0): each axis names its own `end` (aux2 while it is read); bracketed ranges among several
# axes are slices.
dc_axis_ranges: int[]
dc_axes = (n: int, first: int, first_range: int) -> bool:
    args: int[]
    mark = dc_axis_ranges.len()
    if first != 0:
        args.push(first)
        dc_axis_ranges.push(first_range)
    loop not dn_accept(.rbrack):
        token = dn_tokens[dn_at]
        if token.kind == .eof: return dc_axes_end(mark, false)
        nodes[n].aux2 = i32(args.len())
        dc_range_call = 0
        if dc_named_next():
            dn_at += 2
            value = dc_expr(11)
            if value == 0: return dc_axes_end(mark, false)
            named = mk(.namedarg, mkpos(dn_file, token.start))
            nodes[named].name = token.name
            nodes[named].a = i32(value)
            args.push(named)
            dc_axis_ranges.push(0)
            continue
        if dc_whole_axis():
            whole = mk(.range, mkpos(dn_file, dn_tokens[dn_at + 1].start))
            dn_at += 3
            args.push(whole)
            dc_axis_ranges.push(whole)
            continue
        saved_axis = dc_axis_depth
        dc_axis_depth = dc_depth + 1
        open_before = dc_open_axes
        arg = dc_expr(0)
        dc_axis_depth = saved_axis
        if arg == 0 or dc_open_axes != open_before and dc_range_call != arg: return dc_axes_end(mark, false)
        args.push(arg)
        slice = 0
        if dc_range_call == arg: slice = dc_range_node
        dc_axis_ranges.push(slice)
    # (a whole axis alone, `xs[[..]]`, is an array literal the reference grammar reports)
    if args.len() == 1 and nodes[args[0]].kind == .range and dc_axis_ranges[mark] == args[0]: return dc_axes_end(mark, false)
    if args.len() > 1:
        loop i in [0..args.len()):
            if dc_axis_ranges[mark + i] != 0: args[i] = dc_axis_ranges[mark + i]
    set_list(n, args)
    dc_axes_end(mark, true)

dc_whole_axis = () -> bool: dn_peek() == .lbrack and dn_tokens[dn_at + 1].symbol == .range and dn_tokens[dn_at + 2].symbol == .rbrack

dc_axes_end = (mark: int, read: bool) -> bool:
    dc_axis_ranges.truncate(mark)
    read

# Compare semantic child links, independent of allocation order. Every scalar
# field in a compact node participates, including flags and source positions.
dc_same = (a: int, b: int) -> bool:
    if a == 0 or b == 0: return a == b
    x = nodes[a]
    y = nodes[b]
    if x.kind != y.kind or x.op != y.op or x.flags != y.flags or x.pos != y.pos or not dc_same_name(int(x.name), int(y.name)) or not (if (x.kind == .fn_ or x.kind == .lambda or x.kind == .tfn) and x.sval != y.sval: dc_same_row(int(x.sval), int(y.sval)) else: dc_same_name(int(x.sval), int(y.sval))) or x.ival != y.ival or f64_bits(x.fval) != f64_bits(y.fval) or x.type != y.type or x.sym != y.sym or x.aux != y.aux or x.aux2 != y.aux2 or x.mod != y.mod: return false
    if not dc_same(int(x.a), int(y.a)) or not dc_same(int(x.b), int(y.b)) or not dc_same(int(x.c), int(y.c)) or not dc_same(int(x.d), int(y.d)): return false
    if nkids(a) != nkids(b) or nkids2(a) != nkids2(b): return false
    loop i in [0..nkids(a)):
        if not dc_same(kid(a, i), kid(b, i)): return false
    loop i in [0..nkids2(a)):
        if not dc_same(kid2(a, i), kid2(b, i)): return false
    true

# A function's effect row, by content (each construction appends its own).
dc_same_row = (a: int, b: int) -> bool:
    if a <= 0 or b <= 0 or a >= effect_syntax.len() or b >= effect_syntax.len(): return false
    x = effect_syntax[a]
    y = effect_syntax[b]
    if x.len() != y.len(): return false
    loop i in [0..x.len()):
        if x[i].kind != y[i].kind or x[i].path != y[i].path or x[i].pos != y[i].pos or x[i].negative != y[i].negative or x[i].variable != y[i].variable: return false
    true

# Hidden names a projection numbers by node or syntax index (`$parameter12`,
# `$dewy_collection_40`) differ only in that number between the two frontends.
dc_same_name = (a: int, b: int) -> bool:
    if a == b: return true
    if a <= 0 or b <= 0: return false
    x = name_of(a)
    y = name_of(b)
    if len(x) == 0 or x[0] != '$': return false
    dc_undigited(x) == dc_undigited(y)

dc_undigited = (text: str) -> str:
    out: u8[]
    loop c in text:
        if not is_digit(c): out.push(c)
    str_from_bytes(out)

dn_value = (minimum: int) -> int:
    # (a bracketed value stays syntax here: `$test(cases=[...])` reads its rows)
    if not dc_enabled or dn_peek() == .lbrack: return dn_expr(minimum)
    start = dn_at
    node_start = nodes.len()
    list_start = lists.len()
    edits = dn_edit_at.len()
    dc_depth = 0
    # (`name = (...) => ...` may declare a module function or a method: dw_top_declarations
    # reads the reference grammar's function)
    if minimum <= 30 and dc_lambda_next(): return dn_expr(minimum)
    allocators = dw_allocators
    targets = dc_targets_made
    value = dc_expr(minimum)
    if value != 0 and nodes[value].kind == .lambda: value = 0
    # (`$target` in the reference grammar's value stays syntax: its `if` folds that, dw_flow)
    if dc_targets_made != targets: value = 0
    # (`cases=(0 1 2)`: a group of values stays syntax here too)
    if value != 0 and nodes[value].kind == .tuple and dn_tokens[start].symbol == .lparen and dc_closing(start) == dn_at - 1: value = 0
    # (`nonzero = int64 & ~0`: dw_top_declarations reads a refined type's syntax)
    if value != 0 and nodes[value].kind == .binary and nodes[value].op == i32(int(Tok.amp)) and nodes[int(nodes[value].b)].kind == .not_: value = 0
    if value == 0:
        dn_at = start
        nodes.truncate(node_start)
        lists.truncate(list_start)
        dn_edits_undo(edits)
        return dn_expr(minimum)
    if dc_compare:
        stop = dn_at
        node_stop = nodes.len()
        list_stop = lists.len()
        syntax_start = dewy_syntax.len()
        dn_at = start
        dn_edits_undo(edits, true)
        dc_enabled = false
        old = dn_expr(minimum)
        dc_enabled = true
        assert(dn_at == stop)
        # (the projection numbers its arenas as the direct grammar did)
        dw_allocators = allocators
        methods = dewy_methods.len()
        projected = dw_expr(old)
        dewy_methods.truncate(methods)
        if not dc_same(value, projected): fatal(mkpos(dn_file, dn_tokens[start].start), "direct expression AST differs")
        nodes.truncate(node_stop)
        lists.truncate(list_stop)
        dewy_syntax.truncate(syntax_start)
    id = dn_node(.compact_expr, "", dn_tokens[start].start)
    dewy_syntax[id].child_left = value
    id

# Named, generic and optional annotations have a known type context. Other
# type forms retry the reference grammar without mutating angle tokens.
dc_annotation = (boundary: int = 10) -> int:
    dc_depth += 1
    if dc_depth + dn_depth > 256: return 0
    pos = mkpos(dn_file, dn_tokens[dn_at].start)
    # `a|b|c` joins left to right; string members make one string set, the union's first
    # member (dw_literal_type).
    n = 0
    kind = dn_tokens[dn_at].kind
    literal = kind == .quoted or kind == .rawquoted or kind == .source_integer or kind == .integer or dn_tokens[dn_at].symbol == .minus and dc_int_leaf(dn_at) > 0
    if not literal:
        n = dc_type_primary()
        if n == 0: return 0
        next = dn_tokens[dn_at].symbol
        if next == .star or next == .slash or next == .caret:
            n = dc_type_term_from(n, pos)
            if n == 0: return 0
        loop dn_peek() == .pipe and dn_power(.pipe) > boundary:
            if dc_quoted_next(dn_at + 1) or dc_int_leaf(dn_at + 1) > 0:
                literal = true
                break
            dn_at += 1
            right = dc_type_term()
            if right == 0: return 0
            union = mk(.tunion, pos)
            set_list(union, [n, right])
            n = union
    if literal:
        n = dc_literal_union(n, boundary, pos)
        if n == 0: return 0
    if dn_power(dn_peek()) > boundary and not (dc_effects_follow and dn_peek() == .amp) and not (dc_rename_follows and dn_peek() == .kw_as) and not (dc_type_args > 0 and dc_closes()) and not dc_annotation_ends(): return 0
    dc_depth -= 1
    n


# What follows a type ends it though it is an operator: `7 as int8 -3`, a spaced sign before an
# unspaced operand starts the next operand; `t is? T,`, a comma ends an assertion's condition;
# `x as string ?? ""`, dc_expr's optional cast.
dc_annotation_ends = () -> bool:
    after = dn_tokens[dn_at]
    after.symbol == .comma and dn_comma_stop or (after.symbol == .minus or after.symbol == .plus) and after.space and not dn_tokens[dn_at + 1].space or after.symbol == .coalesce and dc_cast_coalesce

dc_quoted_next = (at: int) -> bool: dn_tokens[at].kind == .quoted or dn_tokens[at].kind == .rawquoted

# The tokens of an integer literal at `at`, `5` (1) or `-1` (2), as a type's singleton is written
# (dw_int_leaf); 0 for anything else.
dc_int_leaf = (at: int) -> int:
    t = dn_tokens[at]
    if t.kind == .source_integer or t.kind == .integer: return 1
    if t.symbol != .minus: return 0
    next = dn_tokens[at + 1]
    if next.kind == .source_integer or next.kind == .integer: return 2
    0

# A union with a literal member, from the members read so far (union, its leaves): the integers
# one refined int64, the strings one string set, then the other members in order (dw_literal_type,
# dw_pipe_leaves).
dc_literal_union = (union: int, boundary: int, pos: int) -> int:
    texts: str[]
    ints: int[]
    others: int[]
    if union != 0: dc_union_leaves(union, others)
    if union != 0: dn_at += 1
    loop true:
        if dc_type_member(texts, ints, others) < 0: return 0
        if not (dn_peek() == .pipe and dn_power(.pipe) > boundary): break
        dn_at += 1
    parts: int[]
    if ints.len() > 0:
        lo = ints[0]
        hi = ints[0]
        loop v in ints:
            lo = min(lo, v)
            hi = max(hi, v)
        # (too many gaps: dw_int_singleton_type reports it)
        if hi - lo - ints.len() + 1 > 24 or hi - lo < 0: return 0
        parts.push(dw_int_singleton_type(ints, pos))
    if texts.len() > 0:
        strings = mk(.tname, pos)
        nodes[strings].aux = -7
        nodes[strings].ival = str_set_type(texts)
        parts.push(strings)
    loop other in others: parts.push(other)
    n = parts[0]
    loop k in [1..parts.len()):
        joined = mk(.tunion, pos)
        set_list(joined, [n, parts[k]])
        n = joined
    dc_literal_seen = true
    n

dc_union_leaves = (n: int, out: mut int[]):
    if nodes[n].kind == .tunion:
        dc_union_leaves(kid(n, 0), out)
        dc_union_leaves(kid(n, 1), out)
    else: out.push(n)

# A union's member: a type (its node, kept in others too), a plain string literal (its text in
# texts once) or an integer (its value in ints once): 0 for a literal. -1: none of these.
dc_type_member = (texts: mut str[], ints: mut int[], others: mut int[]) -> int:
    token = dn_tokens[dn_at]
    if token.kind == .quoted or token.kind == .rawquoted:
        if token.kind == .quoted and not dc_plain_quote(token): return -1
        literal = dn_string(token, true)
        if literal == 0: return -1
        dn_at += 1
        text = name_of(int(nodes[literal].sval))
        if not texts.contains(text): texts.push(text)
        return 0
    leaf = dc_int_leaf(dn_at)
    if leaf > 0:
        before = dn_at
        value = dc_atom()
        # (beyond int64: dw_int_singletons reports it)
        if value == 0 or dn_at != before + leaf or nodes[value].kind != .int_lit or has_flag(value, NF_U64): return -1
        if not ints.contains(nodes[value].ival): ints.push(nodes[value].ival)
        return 0
    n = dc_type_term()
    if n == 0: return -1
    others.push(n)
    n


# `float64 * Length / Time`, `Length^2`: a quantity type (dw_type's `*`, `/`, `^`).
dc_type_term = () -> int:
    pos = mkpos(dn_file, dn_tokens[dn_at].start)
    n = dc_type_primary()
    next = dn_peek()
    if n == 0 or next != .star and next != .slash and next != .caret: return n
    dc_type_term_from(n, pos)

dc_type_term_from = (first: int, pos: int) -> int:
    n = dc_type_power(first, pos)
    loop n != 0 and (dn_peek() == .star or dn_peek() == .slash):
        op = if dn_take().symbol == .star: Tok.star else: Tok.slash
        right = dc_type_factor()
        if right == 0: return 0
        q = mk(.tquantity, pos)
        nodes[q].op = i32(int(op))
        nodes[q].a = i32(n)
        nodes[q].b = i32(right)
        n = q
    n

dc_type_factor = () -> int:
    pos = mkpos(dn_file, dn_tokens[dn_at].start)
    n = dc_type_primary()
    if n == 0: return 0
    dc_type_power(n, pos)

dc_type_power = (n: int, pos: int) -> int:
    if dn_peek() != .caret: return n
    dn_at += 1
    exponent = dc_expr(140)
    if exponent == 0: return 0
    q = mk(.tquantity, pos)
    nodes[q].op = i32(int(Tok.caret))
    nodes[q].a = i32(n)
    nodes[q].b = i32(exponent)
    q

# Type arguments being read (dc_type_named): a joined closer may end one, dn_closer_joined.
dc_type_args = 0

dc_closes = () -> bool: dn_peek() == .rangle or dn_edits_on and dn_closer_joined()

dc_grouped = 0     # (the type dc_type_primary read last in parentheses)

# A named type with optional type arguments, a grouped type `(A | B)`, a record type
# `[x:T y:U]` or `[T U]`, or a function type `<(x:T):>R>`; then `?` suffixes.
dc_type_primary = () -> int:
    token = dn_tokens[dn_at]
    n = 0
    if token.kind == .identifier: n = dc_type_named()
    else if token.symbol == .lparen and dc_type_args > 0 and dn_tokens[dc_closing(dn_at) + 1].symbol == .returns:
        # `array<():>int64>`: a type argument may be a function type without its own angle brackets
        n = dc_function_type(false)
    else if token.symbol == .lparen:
        # (dw_type of its one element; a joined closer cannot end a type in it)
        dn_at += 1
        saved = dc_type_args
        dc_type_args = 0
        saved_literal = dc_literal_seen
        dc_literal_seen = false
        n = dc_annotation()
        if n != 0 and not dn_accept(.rparen): n = dc_type_group(n, mkpos(dn_file, token.start))
        dc_type_args = saved
        literal = dc_literal_seen
        dc_literal_seen = saved_literal
        if n == 0 or literal: return 0
        dc_grouped = n
    else if token.symbol == .lbrack or token.symbol == .langle and dn_tokens[dn_at + 1].symbol == .lparen:
        # (inside, a joined closer ends no type argument)
        saved = dc_type_args
        dc_type_args = 0
        n = if token.symbol == .lbrack: dc_record_type() else: dc_function_type()
        dc_type_args = saved
    else if token.symbol == .langle:
        # `<int64 | string>`, `<'fast' | 1>`: a type in angle brackets is that type (dw_type's `<>`)
        dn_at += 1
        dc_type_args += 1
        n = dc_annotation()
        dc_type_args -= 1
        if n == 0: return 0
        if not dn_accept(.rangle):
            if not (dn_edits_on and dn_closer_joined()): return 0
            dn_split_closer()
    if n == 0: return 0
    loop dn_accept(.question):
        optional = mk(.topt, mkpos(dn_file, token.start))
        nodes[optional].a = i32(n)
        n = optional
    # (`x as float32 (y)`: a spaced group is the next operand's; among type arguments, a spaced
    # `<` opens the next, `dict<string <(x:int64):>int64>>`)
    next = dn_tokens[dn_at].symbol
    if next == .dot or next == .langle and (dc_type_args == 0 or not dn_tokens[dn_at].space) or (next == .lbrack or next == .lparen) and not dn_tokens[dn_at].space: return 0
    n

# `(int64 int64)` after its first type: several values' types through `)` (dw_type's group of two
# or more).
dc_type_group = (first: int, pos: int) -> int:
    members = [first]
    loop not dn_accept(.rparen):
        if dn_tokens[dn_at].kind == .eof: return 0
        member = dc_annotation()
        if member == 0: return 0
        members.push(member)
    n = mk(.ttuple, pos)
    nodes[n].aux = i32(TUPLE_VALUES)
    set_list(n, members)
    n

# `[x:T y:U]`, a record type; `[T U]`, a tuple type (dw_type's `[]:`).
dc_record_type = () -> int:
    pos = mkpos(dn_file, dn_tokens[dn_at].start)
    dn_at += 1
    named = dn_tokens[dn_at].kind == .identifier and dn_tokens[dn_at + 1].symbol == .colon or dn_peek() == .rbrack
    n = mk(if named: NK.trecord else: NK.ttuple, pos)
    items: int[]
    loop not dn_accept(.rbrack):
        if dn_tokens[dn_at].kind == .eof: return 0
        if named:
            field = dn_tokens[dn_at]
            if field.kind != .identifier or (field.symbol != .none and field.symbol != .kw_test) or dn_reserved(int(field.name)) or dn_tokens[dn_at + 1].symbol != .colon: return 0
            dn_at += 2
            f = mk(.vardecl, mkpos(dn_file, field.start))
            nodes[f].name = field.name
            outer = dc_pattern_binder
            dc_pattern_binder = int(field.name)
            t = dc_annotation()
            dc_pattern_binder = outer
            if t == 0 or dn_peek() == .assign: return 0
            nodes[f].a = i32(t)
            items.push(f)
            continue
        if dn_tokens[dn_at + 1].symbol == .colon: return 0
        t = dc_annotation()
        if t == 0: return 0
        items.push(t)
    set_list(n, items)
    n

# `<(x:T @y:U):>R>`: a function type, its parameters' labels and types (dw_type's `:>`); an effect
# row on it takes the reference grammar.
dc_function_type = (angled: bool = true) -> int:
    dn_at += if angled: 2 else: 1
    pos = mkpos(dn_file, dn_tokens[dn_at - 1].start)
    n = mk(.tfn, pos)
    types_: int[]
    labels: int[]
    loop not dn_accept(.rparen):
        first = dn_tokens[dn_at]
        place = dn_accept(.at)
        label = dn_tokens[dn_at]
        if label.kind != .identifier or (label.symbol != .none and label.symbol != .kw_test) or dn_reserved(int(label.name)) or dn_tokens[dn_at + 1].symbol != .colon: return 0
        dn_at += 2
        t = dc_annotation()
        if t == 0 or dn_peek() == .assign: return 0
        if place: add_flag(t, NF_MUT)
        if dc_word(int(label.name)) != DC_HOLE:
            loop earlier in labels:
                if nodes[earlier].name == label.name: return 0
        named = mk(.ident, mkpos(dn_file, first.start))
        nodes[named].name = label.name
        labels.push(named)
        types_.push(t)
    if not dn_accept(.returns): return 0
    if dn_tokens[dn_at].kind == .identifier and int(dn_tokens[dn_at].name) == dn_void_id and dn_tokens[dn_at + 1].symbol != .pipe: dn_at += 1
    else:
        # (its closer may be joined: `dict<string <(x:int64):>int64>>`; without angles, the
        # enclosing type argument's, `array<():>int64>`)
        saved_args = dc_type_args
        saved_follow = dc_effects_follow
        if angled: dc_type_args = 1
        dc_grouped = 0
        dc_effects_follow = true
        result = dc_annotation()
        dc_effects_follow = saved_follow
        dc_type_args = if angled: 0 else: saved_args
        if result == 0 or nodes[result].kind == .tunion and result != dc_grouped and dn_peek() == .amp: return 0
        packed = dc_pack(result)
        if packed == result and nodes[packed].kind == .tarray and nodes[packed].ival < 0 and dn_peek() == .amp: return 0
        nodes[n].a = i32(packed)
    # (`<(x:int64):>int64 & E>`: its effect row, dw_effect_suffix)
    if dn_peek() == .amp and not dc_effect_row(n): return 0
    if not angled:
        set_list(n, types_)
        set_list2(n, labels)
        return n
    if not dn_accept(.rangle):
        if not (dn_edits_on and dn_closer_joined()): return 0
        dn_split_closer()
    set_list(n, types_)
    set_list2(n, labels)
    n

# `:>(int64 int64)`: several result values, an array type marked with ival -(their number), its
# list each value's type (dw_pack_type): from the group of types dc_type_primary read last.
dc_pack = (result: int) -> int:
    if result != dc_grouped or nodes[result].kind != .ttuple or nodes[result].aux != i32(TUPLE_VALUES): return result
    members = kids(result)
    nodes[result].kind = .tarray
    nodes[result].aux = 0
    nodes[result].a = i32(members[0])
    nodes[result].ival = -members.len()
    result

# Names the direct grammar dispatches on, by ID: a type name's compact
# spelling (dw_type_name), cached per name; 0 not yet looked up, -1 a name
# with its own type grammar (effects, `type`, `uint`).
dc_type_spelling: i32[]

# Words the direct grammar dispatches on, classified by name ID on first sight
# (no new names are interned for them).
const DC_SET = 1
const DC_B = 2
const DC_MAIN = 3
const DC_HOLE = 4
const DC_ARRAY = 5
const DC_PTR = 6
const DC_DICT = 7
const DC_TOTALDICT = 8
const DC_ADDR = 9
const DC_NO_EFFECTS = 10
const DC_READS = 11
const DC_MUTATES = 12
const DC_ALLOCATES = 13
const DC_BLOCKS = 14
const DC_PANICS = 15
const DC_LENGTH = 16
const DC_OVERFLOW = 17
const DC_P = 18
dc_classes: u8[]

dc_word = (id: int) -> int:
    if id < dc_classes.len() and dc_classes[id] != 0: return int(dc_classes[id]) - 1
    if dc_classes.len() < names.len(): dc_classes.resize(names.len() + 256)
    name = name_of(id)
    words = ["set", "b", "main", "_", "array", "ptr", "dict", "totaldict", "addr", "no_effects", "reads", "mutates", "allocates", "blocks", "panics", "length", "overflow", "p"]
    c = 0
    loop k in [0..words.len()):
        if name == words[k]: c = k + 1
    if id < dc_classes.len(): dc_classes[id] = u8(c + 1)
    c

dc_type_spelled = (id: int) -> int:
    if id < dc_type_spelling.len() and dc_type_spelling[id] != 0: return int(dc_type_spelling[id])
    if dc_type_spelling.len() < names.len(): dc_type_spelling.resize(names.len() + 64)
    name = name_of(id)
    spelled = -1
    if not (name in ["type", "uint", "no_effects", "allocates", "blocks", "panics", "reads", "mutates", "no"]):
        mapped = dw_type_name(name)
        spelled = if mapped == name: id else: intern(mapped)
    if id < dc_type_spelling.len(): dc_type_spelling[id] = i32(spelled)
    spelled

dc_parameter_type = false

dc_type_named = () -> int:
    token = dn_tokens[dn_at]
    if token.kind != .identifier or (token.symbol != .none and token.symbol != .kw_test) or token.name == 0: return 0
    id = int(token.name)
    # `net.NetError`: a module's type (dw_type's `.`)
    if dn_tokens[dn_at + 1].symbol == .dot and dn_tokens[dn_at + 2].kind == .identifier and dn_tokens[dn_at + 2].symbol == .none:
        member = dn_tokens[dn_at + 2]
        dn_at += 3
        n = mk(.tname, mkpos(dn_file, token.start))
        nodes[n].sval = i32(intern(dn_payload(token)))
        nodes[n].name = i32(intern(dn_payload(member)))
        return dc_type_arguments(n, 0)
    spelled = dc_type_spelled(id)
    if spelled < 0: return 0
    word = dc_word(id)
    if word == DC_ADDR: refine_active = true
    # Parameter refinements use the existing annotation parser. Keeping the
    # declaration direct lets its body remain lazy instead of expanding it.
    # (an overflow policy alone, `uint32<overflow='wrap'>`, is no refinement)
    if dc_parameter_type and word == 0 and not dn_tokens[dn_at + 1].space and dn_tokens[dn_at + 1].symbol == .langle and not dc_policy_only():
        name = name_of(id)
        if name in ["int8", "int16", "int32", "int64", "uint8", "uint16", "uint32", "uint64"]:
            # (directly when the refinement is one the direct grammar reads)
            start = dn_at
            node_start = nodes.len()
            list_start = lists.len()
            edits = dn_edit_at.len()
            dc_parameter_type = false
            direct = dc_type_named()
            dc_parameter_type = true
            if direct != 0: return direct
            dn_at = start
            nodes.truncate(node_start)
            lists.truncate(list_start)
            dn_edits_undo(edits)
            dc_fallback(start)
            return dw_type(dn_expr(160))
    dn_at += 1
    n = mk(.tname, mkpos(dn_file, token.start))
    nodes[n].name = i32(spelled)
    if dn_tokens[dn_at].space: return n
    if dn_tokens[dn_at].symbol == .langle: return dc_type_arguments(n, word)
    if dc_double_angle(): return dc_type_arguments(n, word, true)
    n

# `array<<(x:int64):>int64>>`: an adjacent `<<` opens two angle brackets; its first `<` is split
# off in place (dn_double_angle), the other left for the type argument.
dc_double_angle = () -> bool:
    if dn_tokens[dn_at].symbol != .shl or dn_tokens[dn_at].space or not dn_double_closes(dn_tokens, dn_at): return false
    dn_token_edit(dn_at)
    dn_tokens[dn_at].start += 1
    dn_tokens[dn_at].symbol = .langle
    true

# A named type's arguments, `<...>`, if any (dw_type's type application): n holds the name.
dc_shapes: int[]

dc_type_arguments = (n0: int, word: int, opened: bool = false) -> int:
    n = n0
    pos = nodes[n].pos
    if opened or not dn_tokens[dn_at].space and dn_accept(.langle):
        args: int[]
        length = 0
        constraint = 0
        shape = dc_shapes.len()     # (its dimensions, from here on dc_shapes)
        loop true:
            # (`array<array<T>>`, `array<T>?`, `xs:array<T>=[]`: dn_bracketed_from's split)
            if dn_edits_on and dn_closer_joined():
                dn_split_closer()
                break
            if dn_accept(.rangle): break
            # `array<T length=n>`, `T<overflow='wrap'>` (dw_type's type application)
            if dc_named_next():
                setting = dc_word(int(dn_tokens[dn_at].name))
                dn_at += 2
                # `array<T length=[m n]>`: a shape (dw_shape_type)
                if setting == DC_LENGTH and word == DC_ARRAY and args.len() == 1 and length == 0 and dc_shapes.len() == shape and dn_peek() == .lbrack:
                    dn_at += 1
                    saved_comma = dn_comma_stop
                    dn_comma_stop = false
                    dn_angles += 1
                    read = true
                    loop read and not dn_accept(.rbrack):
                        dim = 0
                        if dn_peek() != .semi and dn_tokens[dn_at].kind != .eof: dim = dc_expr(0)
                        if dim == 0: read = false
                        else: dc_shapes.push(dim)
                    dn_angles -= 1
                    dn_comma_stop = saved_comma
                    if not read or dc_shapes.len() == shape or not dc_closes():
                        dc_shapes.truncate(shape)
                        return 0
                    continue
                if setting == DC_LENGTH and word == DC_ARRAY and args.len() == 1 and length == 0 and dn_peek() != .lbrack:
                    saved_comma = dn_comma_stop
                    dn_comma_stop = false
                    dn_angles += 1
                    length = dc_expr(dn_power(.assign) + 1)
                    dn_angles -= 1
                    dn_comma_stop = saved_comma
                    if length == 0 or not dc_closes(): return 0
                    continue
                if setting != DC_OVERFLOW or (word >= DC_ARRAY and word <= DC_TOTALDICT) or nodes[n].aux == -9: return 0
                policy = dc_policy(dn_tokens[dn_at])
                if policy == 0: return 0
                dn_at += 1
                if not dc_closes(): return 0
                wrapper = mk(.tname, pos)
                nodes[wrapper].aux = -9
                nodes[wrapper].a = i32(n)
                nodes[wrapper].ival = policy
                n = wrapper
                continue
            # `array<T length >? 0>`: a condition on the array (dw_type's array constraint)
            if word == DC_ARRAY and args.len() == 1 and length == 0 and dc_shapes.len() == shape:
                dn_angles += 1
                predicate = dc_expr(0)
                dn_angles -= 1
                if predicate == 0 or dc_membership(predicate) or not dc_closes(): return 0
                tested = predicate
                if nodes[tested].kind == .not_: tested = int(nodes[tested].a)
                if not (nodes[predicate].kind == .and_ or nodes[tested].kind == .binary and dc_comparison(Tok(int(nodes[tested].op)))): return 0
                constraint = predicate
                continue
            # `int64<(>? 0)>`, `addr<(<? xs.length)>`, `int64<i => 0 <=? i>`: a refinement
            if (word == 0 or word == DC_ADDR) and dc_refinement_next():
                refined = dc_refinement(n)
                if refined == 0: return 0
                n = refined
                continue
            arg_start = dn_at
            arg_nodes = nodes.len()
            arg_lists = lists.len()
            arg_edits = dn_edit_at.len()
            dc_type_args += 1
            child = dc_annotation()
            dc_type_args -= 1
            if child == 0 and (word == 0 or word == DC_ADDR) and args.len() == 0:
                # `int64<0 <=? x and x <=? 255>`: a condition on the value (its binder the field's,
                # the declaration's or the arm's, dw_pattern_binder)
                dn_at = arg_start
                nodes.truncate(arg_nodes)
                lists.truncate(arg_lists)
                dn_edits_undo(arg_edits)
                refined = dc_condition(n)
                if refined == 0: return 0
                n = refined
                continue
            if child == 0: return 0
            args.push(child)
        if dc_shapes.len() > shape:
            dims = dc_shapes[shape..dc_shapes.len())
            dc_shapes.truncate(shape)
            nodes[n].kind = .tarray
            nodes[n].name = 0
            nodes[n].a = i32(args[0])
            nodes[n].aux = i32(dims.len())
            nodes[n].ival = 1
            set_list(n, dims)
        else if length != 0:
            nodes[n].kind = .tarray
            nodes[n].name = 0
            nodes[n].a = i32(args[0])
            nodes[n].b = i32(length)
        else if word == DC_ARRAY:
            if args.len() != 1: return 0
            nodes[n].kind = .tarray
            nodes[n].name = 0
            nodes[n].a = i32(args[0])
            if constraint != 0:
                refine_active = true
                qualified = mk(.trefined, pos)
                nodes[qualified].a = i32(n)
                nodes[qualified].b = i32(dc_ref_predicate(constraint))
                return qualified
        else if word == DC_PTR:
            if args.len() != 1: return 0
            nodes[n].kind = .tptr
            nodes[n].name = 0
            nodes[n].a = i32(args[0])
        else if word == DC_DICT or word == DC_TOTALDICT:
            if args.len() != 2: return 0
            nodes[n].kind = .tmap
            nodes[n].name = 0
            nodes[n].a = i32(args[0])
            nodes[n].b = i32(args[1])
            if word == DC_TOTALDICT:
                refine_active = true
                nodes[n].aux = 1
        else if args.len() > 0:
            # (type arguments on a refinement: dw_type reports them)
            if nodes[n].kind != .tname or nkids(n) != 0: return 0
            set_list(n, args)
    n

# A refinement is next among a type's arguments: a partial comparison, `(>? 0)`, or one value's
# predicate, `i => ...`; `(in? a..b)` a contiguous range's.
dc_refinement_next = () -> bool:
    t = dn_tokens[dn_at]
    if t.kind == .identifier and t.symbol == .none: return dn_tokens[dn_at + 1].symbol == .function
    if t.symbol != .lparen: return false
    op = dn_tokens[dn_at + 1].symbol
    if op == .kw_not: op = dn_token_invert(dn_tokens[dn_at + 2].symbol)
    op == .eq or op == .not_eq or op == .lt or op == .not_lt or op == .gt or op == .not_gt or op == .le or op == .not_le or op == .ge or op == .not_ge or op == .contains or op == .not_contains

dc_partial_id = 0

# The refinement of base at dn_at (dw_type's condition: a `trefined` naming its value).
dc_refinement = (base: int) -> int:
    first = dn_tokens[dn_at]
    pos = mkpos(dn_file, first.start)
    binder = 0
    predicate = 0
    if first.symbol == .lparen:
        # (dn_partial: the group's operand is `$partial`, standing in place of its parenthesis)
        if dc_partial_id == 0: dc_partial_id = intern("$partial")
        slot = dn_at
        dn_tokens[dn_at] = DewyLexeme(.identifier, i32(dc_partial_id), first.start, first.stop, first.space, first.newline)
        saved_angles = dn_angles
        dn_angles = 0
        predicate = dc_expr(0)
        dn_angles = saved_angles
        dn_tokens[slot] = first
        if predicate == 0 or not dn_accept(.rparen): return 0
        binder = dc_partial_id
    else:
        binder = int(first.name)
        dn_at += 2
        dn_angles += 1
        predicate = dc_expr(30)
        dn_angles -= 1
        if predicate == 0: return 0
    if dc_membership(predicate): return 0
    refine_active = true
    n = mk(.trefined, pos)
    nodes[n].a = i32(base)
    nodes[n].name = i32(binder)
    nodes[n].b = i32(dc_ref_predicate(predicate))
    n

dc_condition = (base: int) -> int:
    pos = mkpos(dn_file, dn_tokens[dn_at].start)
    dn_angles += 1
    predicate = dc_expr(0)
    dn_angles -= 1
    if predicate == 0 or dc_membership(predicate): return 0
    k = nodes[predicate].kind
    tested = predicate
    if k == .not_: tested = int(nodes[predicate].a)
    if not (k == .and_ or nodes[tested].kind == .binary and dc_comparison(Tok(int(nodes[tested].op)))): return 0
    refine_active = true
    n = mk(.trefined, pos)
    nodes[n].a = i32(base)
    nodes[n].name = i32(dc_pattern_binder)
    nodes[n].b = i32(dc_ref_predicate(predicate))
    n

dc_comparison = (op: Tok) -> bool: op == .eq or op == .ne or op == .lt or op == .le or op == .gt or op == .ge

# A refinement's conjunction is a bare `and` (dw_ref_predicate).
dc_ref_predicate = (n: int) -> int:
    if nodes[n].kind != .and_: return n
    both = mk(.and_, nodes[n].pos)
    nodes[both].a = i32(dc_ref_predicate(int(nodes[n].a)))
    nodes[both].b = i32(dc_ref_predicate(int(nodes[n].b)))
    both

# `in?` in a refinement's predicate, but in a contiguous range (dw_ref_predicate reads its range
# as a slice: a stepped range, or one whose first bound is excluded, stays a range there).
dc_membership = (n: int) -> bool:
    k = nodes[n].kind
    if k == .and_: return dc_membership(int(nodes[n].a)) or dc_membership(int(nodes[n].b))
    if k == .not_: return dc_membership(int(nodes[n].a))
    if k != .binary or nodes[n].op != i32(int(Tok.kw_in)): return false
    r = int(nodes[n].b)
    not (nodes[r].kind == .range and not has_flag(r, NF_STEP) and not has_flag(r, NF_EXCL_FIRST))

# `'wrap'` 1, `'saturate'` 2, as an overflow policy is written (anything else 0: the
# reference grammar reads it, and reports it)
dc_policy = (token: DewyLexeme) -> int:
    if token.kind != .quoted: return 0
    source = files[dn_file].src
    quote = source[token.start]
    if (quote != '\'' and quote != '"') or source[token.stop - 1] != quote: return 0
    width = token.stop - token.start - 2
    if width == 4 and dn_matches(source.data(), token.start + 1, token.stop, "wrap"): return 1
    if width == 8 and dn_matches(source.data(), token.start + 1, token.stop, "saturate"): return 2
    0

# `<overflow='wrap'>` is next, after the type's name.
dc_policy_only = () -> bool:
    at = dn_at + 2
    if at + 3 >= dn_tokens.len(): return false
    setting = dn_tokens[at]
    if setting.kind != .identifier or setting.symbol != .none or dc_word(int(setting.name)) != DC_OVERFLOW: return false
    dn_tokens[at + 1].symbol == .assign and dc_policy(dn_tokens[at + 2]) != 0 and dn_tokens[at + 3].symbol == .rangle

dc_declaration = (constant: bool, bare: bool = false) -> int:
    token = dn_tokens[dn_at]
    # `let [a b] = value`, `let (a b) = values`: an unpacking declaration (dw_declare's pattern)
    if (token.symbol == .lbrack or token.symbol == .lparen) and not bare:
        dn_at += 1
        n = mk(.vardecl, mkpos(dn_file, token.start))
        seen: int[]
        close = DewyToken.rbrack
        if token.symbol == .lparen: close = .rparen
        binders = dc_binding_items(seen, close)
        if binders.len() == 0 or close == .rparen and binders.len() < 2: return 0
        set_list(n, binders)
        if dn_accept(.colon):
            annotation = dc_annotation()
            if annotation == 0: return 0
            nodes[n].a = i32(annotation)
        if not dn_accept(.assign) or dc_lambda_next(): return 0
        initial = dc_expr(11)
        if initial == 0 or nodes[initial].kind == .lambda: return 0
        nodes[n].b = i32(initial)
        if constant: add_flag(n, NF_RDONLY)
        dc_accept_semi(true)
        return n
    if token.kind != .identifier or (token.symbol != .none and token.symbol != .kw_test): return 0
    if dn_reserved(int(token.name)): return 0
    dn_at += 1
    n = mk(.vardecl, mkpos(dn_file, token.start))
    nodes[n].name = token.name
    if dn_accept(.colon):
        outer = dc_pattern_binder
        dc_pattern_binder = int(token.name)
        annotation = dc_annotation()
        dc_pattern_binder = outer
        if annotation == 0: return 0
        nodes[n].a = i32(annotation)
    if dn_accept(.assign):
        # (`name:T = value` without `let` declares at the top of a module only, dw_stmt)
        if bare and not dc_top_level or not dc_fn_body and dc_lambda_next(): return 0
        initial = dc_expr(11)
        if initial == 0 or nodes[initial].kind == .lambda and not dc_fn_body or dc_inferred_refinement(initial): return 0
        nodes[n].b = i32(initial)
    else:
        next = dn_tokens[dn_at]
        if constant or dn_power(next.symbol) > 0 or next.symbol == .dot or next.symbol == .question or next.symbol == .ellipsis: return 0
        if not next.space and (next.symbol == .lparen or next.symbol == .lbrack or next.symbol == .langle or next.kind == .quoted or next.kind == .rawquoted): return 0
    if constant:
        value = int(nodes[n].b)
        if dw_const_number(value) or nodes[value].kind == .str_lit or nodes[value].kind == .none_lit: nodes[n].kind = .const_
        else: add_flag(n, NF_RDONLY)
    decimal_let(n)
    dc_accept_semi(not (bare and dc_unbraced))
    n

# Inside a directly built module function, a braced statement the direct grammar
# does not cover takes the reference grammar alone; the rest of the function stays
# direct. Its projection waits until the whole declaration is parsed, so projection
# diagnostics follow every parse diagnostic, as on the reference path. The block
# holds a placeholder, -(k + 1) for deferred statement k, until then.
dc_defer_result = 0         # 0 outside such a function; else its dw_fn_result
dc_deferred_syntax: int[]
dc_deferred_block: int[]
dc_deferred_result: int[]

dc_defer_statement = (start: int, node_start: int, list_start: int, block: int) -> int:
    # (settings, labels and `$target` chains belong to the block's own projection)
    if dc_defer_result == 0 or dn_tokens[start].kind == .metatag: return 0
    dn_at = start
    nodes.truncate(node_start)
    lists.truncate(list_start)
    result = dc_defer_result
    dc_defer_result = 0
    saved_depth = dn_depth
    dn_depth = dc_depth
    dc_fallback(start)
    syntax = dn_stmt()
    dn_depth = saved_depth
    dc_defer_result = result
    if dn_at == start or dw_target_live(syntax) >= 0: return 0
    dc_deferred_syntax.push(syntax)
    dc_deferred_block.push(block)
    dc_deferred_result.push(result)
    0 - dc_deferred_syntax.len()

dc_project_deferred = ():
    loop k in [0..dc_deferred_syntax.len()):
        outer = dw_fn_result
        dw_fn_result = dc_deferred_result[k]
        statement = dw_stmt(dc_deferred_syntax[k])
        dw_fn_result = outer
        block = dc_deferred_block[k]
        placed = false
        if block > 0 and block < nodes.len() and nodes[block].kind == .block:
            loop i in [0..nkids(block)):
                if kid(block, i) == -(k + 1):
                    set_kid(block, i, statement)
                    placed = true
                    break
        # (a statement deferred in an attempt that was abandoned would have no block left)
        if not placed: ice("deferred statement {k} has no placeholder in block {block}")
    dc_deferred_clear()

dc_deferred_clear = (): dc_deferred_truncate(0)

dc_deferred_truncate = (count: int):
    dc_deferred_syntax.truncate(count)
    dc_deferred_block.truncate(count)
    dc_deferred_result.truncate(count)

# A flow body is a statement block even when its braces are omitted. These
# functions participate in the enclosing construction transaction: an unknown
# head, label, declaration or expression retries the reference grammar.
dc_body = () -> int:
    # (`=> $unsafe { ... }`: the boundary covers the block, which stays the body itself, dw_block)
    if dn_tokens[dn_at].kind == .metatag and dn_tokens[dn_at + 1].symbol == .lbrace and dc_unsafe_at(dn_at):
        opening = dn_tokens[dn_at]
        dn_at += 1
        n = dc_body()
        if n == 0 or not dc_flow_ends(): return 0
        dc_unsafe_scope(mkpos(dn_file, opening.start))
        return n
    saved = dc_unbraced
    dc_unbraced = dn_peek() != .lbrace
    n = dc_body_read()
    dc_unbraced = saved
    n

# A `;` ending this statement; in an unbraced body only one before `else` (`if c f(); else g()`,
# which the direct grammar has read as the body's own).
dc_accept_semi = (statement: bool) -> bool:
    if statement or dn_peek() == .semi and dn_tokens[dn_at + 1].symbol == .kw_else: return dn_accept_semi()
    false

# (dc_statement's left side when no assignment follows it, read from dc_value_start)
dc_value = 0
dc_value_start = -1

# Settings read in the blocks being read, applied as each closes (a stack: dc_body_read).
dc_settings: str[]
dc_setting_values: int[]
dc_setting_at: int[]

dc_body_read = () -> int:
    dc_top_level = false
    dc_depth += 1
    if dc_depth + dn_depth > 256: return 0
    pos = mkpos(dn_file, dn_tokens[dn_at].start)
    braced = dn_accept(.lbrace)
    n = mk(.block, pos)
    statements: int[]
    last_start = dn_at
    settings = dc_settings.len()
    loop true:
        if braced and dn_accept(.rbrace): break
        if dn_tokens[dn_at].kind == .eof: return 0
        start = dn_at
        last_start = start
        node_start = nodes.len()
        list_start = lists.len()
        depth = dc_depth
        deferred = dc_deferred_syntax.len()
        syntax_start = dewy_syntax.len()
        edits = dn_edit_at.len()
        # `$runtime_checks`, `$no_nan=false`: a setting holding throughout the block, wherever
        # written (dw_dir_block); `$outer loop ...`: a loop's label (dw_block)
        if dn_tokens[dn_at].kind == .metatag and braced and dn_directive_form(dn_payload(dn_tokens[dn_at])) == 0:
            tag = dn_tokens[dn_at]
            name = dn_payload(tag)
            if dw_dir_name(name):
                value = dc_block_setting()
                if value < 0: return 0
                dc_settings.push(name)
                dc_setting_values.push(value)
                dc_setting_at.push(mkpos(dn_file, tag.start))
                continue
            if name == "target" or name == "capture" or name == "include_bytes" or name == "shadowable" or name == "supported_targets" or dw_designed_directive(name) or dn_tokens[dn_at + 1].symbol != .kw_loop: return 0
            dn_at += 1
            statement = dc_statement()
            if statement == 0: return 0
            k = nodes[statement].kind
            if k != .loopx and k != .for_ and k != .while_: return 0
            nodes[statement].sval = i32(intern(name))
            statements.push(statement)
            continue
        # (`$field(name)=value` ending a record comprehension's body: a row, dc_record_loop)
        if dc_map_ok and dc_field_next():
            entry = dc_field_entry()
            if entry == 0: return 0
            statement = mk(.exprstmt, nodes[entry].pos)
            nodes[statement].a = i32(entry)
            statements.push(statement)
            if not braced: break
            continue
        dc_splice_ok = true
        statement = dc_statement()
        # `if $target.os =? "windows" { ... } else { ... }`: the compiled arm's statements, here
        # (dw_target_splice)
        if statement != 0 and dc_live_at == start and dn_tokens[start].symbol == .kw_if:
            loop k in [deferred..dc_deferred_syntax.len()):
                if dc_deferred_block[k] == statement: dc_deferred_block[k] = n
            loop spliced in kids(statement): statements.push(spliced)
            if not braced: break
            continue
        if statement == 0:
            value = 0
            if dc_value_start == start and dc_value != 0:
                value = dc_value
                dc_depth = depth
            else:
                dn_at = start
                nodes.truncate(node_start)
                lists.truncate(list_start)
                dn_edits_undo(edits)
                dc_deferred_truncate(deferred)
                dewy_syntax.truncate(syntax_start)
                # A failed expression may leave the recursion counter elevated.
                dc_depth = depth
                value = dc_expr(0)
                dc_depth = depth
                # (a chain whose compiled arm is spliced is no value here)
                if value != 0 and dc_live_at == start and dn_tokens[start].symbol == .kw_if: value = 0
            dc_value = 0
            dc_value_start = -1
            # (`key -> value` ending a dictionary comprehension's body: an entry, dc_collect)
            if value != 0 and dc_map_ok and dn_peek() == .arrow:
                dn_at += 1
                entry = dc_expr(21)
                if entry == 0: value = 0
                else:
                    pair = mk(.pair, mkpos(dn_file, dn_tokens[start].start))
                    nodes[pair].a = i32(value)
                    nodes[pair].b = i32(entry)
                    value = pair
                    dc_pairs_made += 1
            if value == 0:
                # (an `if` value attempt may have deferred statements of its own bodies: they
                # go with it, before the whole statement is deferred)
                dc_deferred_truncate(deferred)
                dewy_syntax.truncate(syntax_start)
                dn_edits_undo(edits)
                statement = if braced: dc_defer_statement(start, node_start, list_start, n) else: 0
                if statement == 0: return 0
                statements.push(statement)
                continue
            at = mkpos(dn_file, dn_tokens[start].start)
            if dc_accept_semi(braced):
                statement = mk(.assign, at)
                nodes[statement].op = i32(int(Tok.assign))
                nodes[statement].a = i32(mk(.hole, at))
                nodes[statement].b = i32(value)
            else:
                # (`$unsafe f()`: the statement is its operand's, dw_stmt)
                if dc_unsafe_at(start): at = mkpos(dn_file, dn_tokens[start + 1].start)
                statement = mk(.exprstmt, at)
                nodes[statement].a = i32(value)
        statements.push(statement)
        if not braced: break
    # (a block whose last statement is tagged: dc_collect leaves it to the reference grammar)
    if statements.len() > 0 and dn_tokens[last_start].kind == .metatag: dc_tagged_last[n] = true
    if dc_settings.len() > settings:
        # (through its closing brace: its last syntax node is the last position inside, dw_dir_last)
        dc_tagged_last[n] = true
        end = mkpos(dn_file, dn_tokens[dn_at - 1].start)
        loop i in [settings..dc_settings.len()):
            dc_scope_undoable()
            dw_dir_apply(dc_settings[i], dc_setting_values[i], dc_setting_at[i], pos, end, false)
        dc_settings.truncate(settings)
        dc_setting_values.truncate(settings)
        dc_setting_at.truncate(settings)
    set_list(n, statements)
    dc_depth -= 1
    n

# `$target` and its fields read directly (dw_target_field): each such string's field (0 `$target`,
# 1 `.arch`, 2 `.os`, 3 `$build.mode`) and position by node, and where its member is written
# (an arm a test leaves out uses that name, dw_target_dropped).
dc_targets_made = 0
dc_target_fields: {int: int} = {}
dc_target_pos: {int: int} = {}
dc_target_members: {int: int} = {}

dc_target_value = (field: int, pos: int, member: int) -> int:
    n = mk(.str_lit, pos)
    dc_target_note(n, field, member)
    n

dc_target_note = (n: int, field: int, member: int):
    nodes[n].sval = i32(intern(if field == 0: dw_target_name() else: dw_target_field_value(field)))
    dc_targets_made += 1
    dc_target_fields[n] = field
    dc_target_pos[n] = nodes[n].pos
    if member >= 0: dc_target_members[n] = mkpos(dn_file, member)
    else: dc_target_members.remove(n)

# The field the string n reads (dc_target_note), -1 for any other node.
dc_target_of = (n: int) -> int:
    if n <= 0 or nodes[n].kind != .str_lit: return -1
    if let field = dc_target_fields.get(n):
        if (dc_target_pos.get(n) ?? -1) == nodes[n].pos: return field
    -1

# A condition made only of `$target`, its fields or `$build.mode` compared with string literals
# (target_fold): 1 true, 0 false, -1 any other condition; -2 a name the design does not give,
# which the reference grammar reports.
dc_target_fold = (n: int) -> int:
    if dc_targets_made == 0 or n <= 0: return -1
    k = nodes[n].kind
    if k == .not_:
        fold = -1
        # (`a not =? b`: an inverted comparison; `not c`, but not `~c`)
        if nodes[n].op == 0: fold = dc_target_compare(int(nodes[n].a))
        else:
            if files[dn_file].src.data()[pos_off(nodes[n].pos)] == '~': return -1
            fold = dc_target_fold(int(nodes[n].a))
        if fold < 0: return fold
        return 1 - fold
    if k == .and_ or k == .or_:
        left = dc_target_fold(int(nodes[n].a))
        if left < 0: return left
        right = dc_target_fold(int(nodes[n].b))
        if right < 0: return right
        if k == .and_: return left & right
        return left | right
    dc_target_compare(n)

dc_target_compare = (n: int) -> int:
    if nodes[n].kind != .binary: return -1
    op = nodes[n].op
    if op == i32(int(Tok.eq)):
        left = int(nodes[n].a)
        right = int(nodes[n].b)
        if dc_target_of(right) >= 0:
            right = left
            left = int(nodes[n].b)
        field = dc_target_of(left)
        if field < 0: return -1
        name = dc_target_literal(right, field)
        if name == "": return dc_target_problem
        return if name == dw_target_field_value(field): 1 else: 0
    if op != i32(int(Tok.kw_in)): return -1
    field = dc_target_of(int(nodes[n].a))
    list = int(nodes[n].b)
    if field < 0 or nodes[list].kind != .array or has_flag(list, NF_COMPREHENSION): return -1
    found = 0
    loop entry in kids(list):
        name = dc_target_literal(entry, field)
        if name == "": return dc_target_problem
        if name == dw_target_field_value(field): found = 1
    found

# A plain string literal naming a target (field 0), processor (1), system (2) or build mode (3)
# (syntax_target_literal): "" when n is no such literal, dc_target_problem -2 when it names none.
dc_target_problem = -1
dc_target_literal = (n: int, field: int) -> str:
    dc_target_problem = -1
    if nodes[n].kind != .str_lit or nkids(n) > 0 or dc_target_of(n) >= 0 or has_flag(n, NF_SPREAD): return ""
    name = name_of(int(nodes[n].sval))
    known = false
    if field == 3: known = name == "release" or name == "debug"
    else if field == 1: known = name in target_arches()
    else if field == 2: known = name in target_oses()
    else: known = name in target_names() and (target_os_of(name) != "none" or name == "wasm32" or name == "c89")
    if known: return name
    dc_target_problem = -2
    ""


# The names an arm a fold leaves out uses (dw_target_dropped), from its nodes.
dc_target_dropped = (n: int):
    if dc_target_members.len() == 0: dw_target_dropped_node(n)
    else: dc_target_dropped_walk(n)

dc_target_dropped_walk = (n: int):
    if n <= 0 or n >= nodes.len(): return
    if nodes[n].kind == .str_lit and dc_target_of(n) > 0:
        if let at = dc_target_members.get(n): dw_target_dropped_name(intern(if dc_target_of(n) == 1: "arch" else if dc_target_of(n) == 2: "os" else: "mode"), at)
        return
    if nodes[n].kind == .ident: dw_target_dropped_name(int(nodes[n].name), nodes[n].pos)
    mask = isolation_children(nodes[n].kind)
    if nodes[n].kind == .lambda:
        mask = 1 | 2 | 4 | 16
        loop c in kids2(n): dc_target_dropped_walk(c)
    if mask < 0: mask = 1 | 2 | 4 | 16
    if mask & 1 != 0: dc_target_dropped_walk(int(nodes[n].a))
    if mask & 2 != 0: dc_target_dropped_walk(int(nodes[n].b))
    if mask & 4 != 0: dc_target_dropped_walk(int(nodes[n].c))
    if mask & 16 != 0:
        loop c in kids(n): dc_target_dropped_walk(c)

# What a loop iterates, after `in` (dw_iterable): a range, bracketed (`[a..b]`, `[a..b)`, `(a..b]`,
# `(a..b)`) or not (`a..b`, `a..`, inclusive), stepped by a second start (`[a,b..c)`), or a value
# (its iteration, `__dewy_iter`). A live place (`in @xs`) takes the reference grammar.
dc_iterable = () -> int:
    opening = dn_at
    if dn_tokens[dn_at].symbol == .at: return 0
    if dn_tokens[dn_at].symbol == .lbrack or dn_tokens[dn_at].symbol == .lparen:
        start = dn_at
        node_start = nodes.len()
        list_start = lists.len()
        edits = dn_edit_at.len()
        dn_at += 1
        range = dc_range(true)
        if range != 0 or dn_at < 0: return range
        # (not a range: the brackets hold a value, `[1 2 3]`, `(xs)`)
        dn_at = start
        nodes.truncate(node_start)
        lists.truncate(list_start)
        dn_edits_undo(edits)
    range = dc_range(false)
    if dn_at < 0: return 0
    if range != 0: return range
    dn_at = dc_range_at
    first = dc_range_first
    if dn_peek() != .lbrace and dn_power(dn_peek()) >= 96 and not dc_signed_next(): return 0
    callee = mk(.ident, mkpos(dn_file, dn_tokens[opening].start))
    nodes[callee].name = i32(dc_builtin(4))
    n = mk(.call, mkpos(dn_file, dn_tokens[opening].start))
    nodes[n].a = i32(callee)
    set_list(n, [first])
    n

# `xs -1`: a sign attached to what follows, spaced from what precedes, starts the next value
# (dc_expr ends there, as the reference grammar's expression does).
dc_signed_next = () -> bool:
    t = dn_tokens[dn_at]
    (t.symbol == .plus or t.symbol == .minus) and t.space and not dn_tokens[dn_at + 1].space

# (dc_range's first value when it reads no range, and where that value ends)
dc_range_first = 0
dc_range_at = 0

# A loop's range from its first bound; `bracketed`, after `[` or `(`, through its closer. 0 when
# what is here is no range (then dc_range_first holds the value read, ending at dc_range_at),
# or with dn_at -1 when it is a range the direct grammar does not take.
dc_range = (bracketed: bool, value: bool = false, open: bool = false) -> int:
    grouped = bracketed and dn_tokens[dn_at - 1].symbol == .lparen
    pos = mkpos(dn_file, dn_tokens[dn_at].start)
    dc_range_first = 0
    first = 0
    second = 0
    if open and dn_accept(.range):
        # (`x in? [..b]`: a membership's range may be open, dw_iterable's slice)
        first = 0
    else:
        if dn_peek() == .range: return dc_range_fail()
        # (`(+ 1)`: a partial application, dn_partial)
        if grouped and (dn_partial_operator(dn_peek()) or dn_peek() == .kw_not): return dc_range_fail()
        first = dc_expr(106)
        if first == 0: return dc_range_fail()
        if dn_accept(.comma):
            second = dc_expr(106)
            if second == 0 or dn_peek() != .range: return dc_range_fail()
        if not dn_accept(.range):
            dc_range_first = first
            dc_range_at = dn_at
            return 0
    last = 0
    if dn_range_bound(dn_tokens, dn_at):
        last = dc_expr(101)
        if last == 0: return dc_range_fail()
    inclusive = true
    if bracketed:
        if dn_accept(.rbrack): inclusive = true
        else if dn_accept(.rparen): inclusive = false
        else: return dc_range_fail()
        if value:
            n = mk(.range, pos)
            # (`[..]`: the whole range, no bound to include)
            if first == 0 and last == 0: return n
            nodes[n].a = i32(first)
            nodes[n].b = i32(last)
            if second != 0:
                nodes[n].c = i32(second)
                add_flag(n, NF_STEP)
            if inclusive: add_flag(n, NF_INCLUSIVE)
            if grouped: add_flag(n, NF_EXCL_FIRST)
            return n
        # (`[0..n).reversed()`: the brackets are a value the expression goes on with)
        after = dn_tokens[dn_at].symbol
        if after == .dot or after == .question or after == .ellipsis or not dn_tokens[dn_at].space and (after == .lparen or after == .lbrack or after == .langle or dn_tokens[dn_at].kind == .quoted or dn_tokens[dn_at].kind == .rawquoted): return dc_range_fail()
    if dn_peek() != .lbrace and dn_power(dn_peek()) >= 96 and not dc_signed_next(): return dc_range_fail()
    n = mk(.range, pos)
    nodes[n].a = i32(first)
    nodes[n].b = i32(last)
    if second != 0:
        nodes[n].c = i32(second)
        add_flag(n, NF_STEP)
    if inclusive: add_flag(n, NF_INCLUSIVE)
    if grouped:
        add_flag(n, NF_EXCL_FIRST)
        return bc_call("__dewy_iter", [dw_range_value(n)], pos)
    n

dc_range_fail = () -> int:
    dn_at = -1
    0

# A loop's header, as dw_loop_head reads it: `binder in iterable` terms and conditions, joined by
# `and` and `or` (two joined conditions are one, head_collapse).
dc_loop_head = () -> int:
    head = dc_head_term()
    if head == 0: return 0
    if dn_peek() == .lbrace: return head
    if dn_peek() == .kw_and or dn_peek() == .kw_or:
        head = dc_head_and(head)
        loop head != 0 and dn_peek() == .kw_or:
            dn_at += 1
            term = dc_head_term()
            head = dc_head_join(3, head, dc_head_and(term))
    if head == 0 or dn_power(dn_peek()) > 0 and not dc_signed_next(): return 0
    head

# An `and` chain from its first term (`and` binds more tightly than `or`).
dc_head_and = (first: int) -> int:
    left = first
    loop left != 0 and dn_peek() == .kw_and:
        dn_at += 1
        left = dc_head_join(2, left, dc_head_term())
    left

# `a and b`, `a or b`: each side a combined head (dw_loop_head's `combined`).
dc_head_join = (op: int, a: int, b: int) -> int:
    if a == 0 or b == 0 or not dc_head_combined(a) or not dc_head_combined(b): return 0
    n = mk(.lhead, nodes[a].pos)
    nodes[n].op = i32(op)
    nodes[n].a = i32(a)
    nodes[n].b = i32(b)
    head_collapse(n)

# A combined iteration binds by value, and steps a stepped range by its iterator.
dc_head_combined = (head: int) -> bool:
    if nodes[head].op != 1: return true
    if has_flag(head, NF_MUT) or dewy_live_sources.has(int(nodes[head].a)): return false
    it = int(nodes[head].a)
    if nodes[it].kind == .range and has_flag(it, NF_STEP):
        if nodes[it].b == 0: it = bc_call("__dewy_open_range_iter", [int(nodes[it].a), int(nodes[it].c)], nodes[it].pos)
        else: it = bc_call("__dewy_iter", [dw_range_value(it)], nodes[it].pos)
        nodes[head].a = i32(it)
    true

# `name in xs`, `@name in xs` (each element in place), `[a b] in xs` (unpacked), or a condition.
dc_head_term = () -> int:
    head = mk(.lhead, mkpos(dn_file, dn_tokens[dn_at].start))
    # (`loop { ... }`: a block condition, which the reference grammar warns of)
    first = dn_tokens[dn_at].symbol
    if first == .lbrace: return 0
    place = first == .at
    at = dn_at
    if place: at += 1
    named = dn_tokens[at].kind == .identifier and dn_tokens[at].symbol == .none and dn_tokens[at + 1].symbol == .kw_in and not dn_reserved(int(dn_tokens[at].name))
    if not (named or dn_tokens[at].symbol == .lbrack and not place):
        condition = dc_expr(71)
        if condition == 0: return 0
        # (`x in? xs`: a membership, a condition; `f(x) in xs` is no expression dc_expr reads)
        nodes[head].op = 4
        nodes[head].a = i32(condition)
        return head
    nodes[head].op = 1
    if place:
        add_flag(head, NF_MUT)
        dn_at += 1
    binder_pos = mkpos(dn_file, dn_tokens[dn_at].start)
    if named:
        value = mk(.ident, binder_pos)
        nodes[value].name = dw_value_name(dn_tokens[dn_at].name, binder_pos)
        dn_at += 2
        set_list(head, [value])
    else:
        dn_at += 1
        seen: int[]
        binders = dc_binding_items(seen)
        if binders.len() == 0 or not dn_accept(.kw_in): return 0
        # (one element still unpacks the iteration value)
        if binders.len() == 1:
            pattern = mk(.tuple, binder_pos)
            set_list(pattern, binders)
            binders = [pattern]
        set_list(head, binders)
    it = 0
    if place:
        # (in place: a name or a field route of one, read as it is)
        if dn_peek() == .at: return 0
        it = dc_expr(96)
        if it == 0: return 0
        root = it
        loop nodes[root].kind == .field: root = int(nodes[root].a)
        if nodes[root].kind != .ident: return 0
    else if dn_peek() == .at:
        # `loop x in @xs`: the place iterated live, one name bound (dw_live_loop)
        if not named: return 0
        dn_at += 1
        it = dc_expr(dn_prefix_power(.at, false))
        if it == 0 or dn_power(dn_peek()) >= 96: return 0
        root = it
        loop nodes[root].kind == .field: root = int(nodes[root].a)
        if nodes[root].kind != .ident: return 0
        dewy_live_sources[it] = true
        dn_edit_at.push(DN_EDIT_LIVE - it)
        dn_edit_was.push(dn_tokens[dn_at - 1])
    else: it = dc_iterable()
    if it == 0: return 0
    nodes[head].a = i32(it)
    head

# The names of an unpacking pattern after its `[`, through its `]` (dw_binding_items): names,
# `_`, nested patterns, a name's type (`x:int64`), a rest (`...rest`) or a drop (`...`); empty for
# any other item (a renaming, a default), which the reference grammar reads.
dc_binding_items = (seen: mut int[], close: DewyToken = .rbrack) -> int[]:
    out: int[]
    rests = 0
    rest = false        # (the next name collects what the others leave)
    plain = true        # (the last item takes a postfix `...`: a name or a nested pattern)
    last_pos = 0
    loop not dn_accept(close):
        t = dn_tokens[dn_at]
        pos = mkpos(dn_file, t.start)
        if t.symbol == .ellipsis:
            next = dn_tokens[dn_at + 1]
            if rest or not plain: return []
            if out.len() == 0:
                # (opening the pattern: dn_atom's `...` before a name or the closer)
                if close == .rbrack and not (next.symbol == .rbrack or next.kind == .identifier): return []
                if close == .rparen and not (next.symbol == .rparen or next.kind == .identifier and (dn_tokens[dn_at + 2].symbol == .colon or dn_tokens[dn_at + 2].kind == .identifier or dn_tokens[dn_at + 2].symbol == .rparen)): return []
            rests += 1
            if rests > 1: return []
            dn_at += 1
            if not next.space and next.kind == .identifier:
                rest = true
                continue
            if next.symbol != close and not next.space: return []
            # (a drop: at the `...` opening the pattern, else at the item it follows)
            hole = mk(.hole, if out.len() == 0: pos else: last_pos)
            add_flag(hole, NF_SPREAD)
            out.push(hole)
            plain = false
            continue
        # (`banana as [x y]`: the field banana unpacked, dw_binding_one)
        renamed = 0
        if t.kind == .identifier and t.symbol == .none and dn_tokens[dn_at + 1].symbol == .kw_as and dn_tokens[dn_at + 2].symbol == .lbrack and not dn_reserved(int(t.name)):
            if rest: return []
            renamed = int(t.name)
            dn_at += 2
            t = dn_tokens[dn_at]
            pos = mkpos(dn_file, t.start)
        if t.symbol == .lbrack:
            if rest: return []
            dn_at += 1
            pattern = mk(.tuple, pos)
            if renamed != 0: nodes[pattern].sval = i32(renamed)
            inner = dc_binding_items(seen)
            if inner.len() == 0: return []
            set_list(pattern, inner)
            out.push(pattern)
            plain = true
            last_pos = pos
            continue
        if t.kind != .identifier or t.symbol != .none: return []
        # (the mistakes dw_binding_one reports: a default, a reserved word)
        if dn_tokens[dn_at + 1].symbol == .assign and not dn_tokens[dn_at + 1].space: fatal(pos, "`=` in a pattern is reserved for defaults, which are not implemented; rename a field with `as`: `[field as name] = record`")
        if dn_reserved(int(t.name)):
            dewy_reserved_name(name_of(int(t.name)), pos)
            return []
        dn_at += 1
        annotation = 0
        if dn_peek() == .colon:
            dn_at += 1
            saved_rename = dc_rename_follows
            dc_rename_follows = true
            annotation = dc_annotation(45)
            dc_rename_follows = saved_rename
            if annotation == 0: return []
        # `apple as a`, `apple:int64 as a`: the field apple bound as a (dw_binding_one's renaming)
        source = 0
        if dn_peek() == .kw_as:
            target = dn_tokens[dn_at + 1]
            if rest or target.kind != .identifier or target.symbol != .none or dn_reserved(int(target.name)): return []
            source = int(t.name)
            t = target
            pos = mkpos(dn_file, t.start)
            dn_at += 2
        after = dn_tokens[dn_at]
        if not after.space and after.symbol != close: return []
        hole = dc_word(int(t.name)) == DC_HOLE
        if not hole:
            if seen.contains(int(t.name)):
                if source == 0: fatal(pos, "duplicate unpacking name '{name_of(int(t.name))}'")
                return []
            seen.push(int(t.name))
        n = mk(if hole: NK.hole else: NK.ident, pos)
        nodes[n].name = t.name
        nodes[n].a = i32(annotation)
        if source != 0: nodes[n].sval = i32(source)
        if rest: add_flag(n, NF_SPREAD)
        rest = false
        out.push(n)
        plain = annotation == 0 and source == 0
        last_pos = pos
    if rest or out.len() == 1 and nodes[out[0]].kind == .hole and has_flag(out[0], NF_SPREAD): return []
    out

dc_flow = () -> int:
    dc_depth += 1
    if dc_depth + dn_depth > 256: return 0
    token = dn_take()
    if token.symbol == .kw_match:
        n = dc_match(token)
        if n != 0: dc_depth -= 1
        return n
    if token.symbol != .kw_if and token.symbol != .kw_loop: return 0
    start = dn_at - 1
    pos = mkpos(dn_file, token.start)
    n = mk(.if_, pos)
    head = 0
    fold = -1
    if token.symbol == .kw_loop:
        head = dc_loop_head()
        if head == 0: return 0
    else:
        condition = dc_expr(0)
        if condition == 0: return 0
        nodes[n].a = i32(condition)
        # (`if $target.os =? "windows" a else b`: one arm is compiled, dw_flow's dw_target_condition)
        if dc_targets_made > 0:
            fold = dc_target_fold(condition)
            if fold == -2: return 0
    if not dn_can_start(dn_tokens, dn_at): return 0
    deferred = dc_deferred_syntax.len()
    if fold >= 0 and dc_unsafe_at(dn_at): return 0
    body = dc_body()
    if body == 0: return 0
    if fold == 0 and dc_deferred_syntax.len() != deferred: return 0
    nodes[n].b = i32(body)
    alternative = 0
    rest = 0
    rest_live = true
    if dn_accept(.kw_else):
        deferred = dc_deferred_syntax.len()
        if dn_peek() == .kw_if or dn_peek() == .kw_match:
            rest_at = dn_at
            saved_dropping = dc_dropping
            if fold == 1: dc_dropping += 1
            rest = dc_flow()
            dc_dropping = saved_dropping
            if rest == 0: return 0
            rest_live = dc_live_at == rest_at
            # (a folded chain's value is its compiled arm's body, a block itself: dw_flow)
            if nodes[rest].kind == .block: alternative = rest
            else:
                alternative = mk(.block, pos)
                set_list(alternative, [dc_flow_stmt(rest)])
        else:
            if fold >= 0 and dc_unsafe_at(dn_at): return 0
            alternative = dc_body()
            if alternative == 0: return 0
        if fold == 1 and dc_deferred_syntax.len() != deferred: return 0
        nodes[n].c = i32(alternative)
    if fold >= 0:
        # (the arms left out are read, never checked: the names they use are noted)
        value = 0
        # (a false test's names too: dw_target_splice notes the whole arm)
        if fold == 0 or dc_dropping > 0: dc_target_dropped(int(nodes[n].a))
        if fold == 1:
            if alternative != 0: dc_target_dropped(alternative)
            value = body
        else:
            dc_target_dropped(body)
            if rest != 0:
                if nodes[rest].kind == .match_: return 0
                value = rest
            else if alternative != 0: value = alternative
            else: value = mk(.block, pos)
        dc_live_at = if fold == 1 or rest_live: start else: -1
        dc_depth -= 1
        return value
    if dc_live_at == start: dc_live_at = -1
    if head != 0:
        if alternative != 0:
            nodes[n].kind = .loopx
            nodes[n].a = i32(head)
        else if nodes[head].op == 1:
            nodes[n].kind = .for_
            nodes[n].a = nodes[head].a
            if has_flag(head, NF_MUT): add_flag(n, NF_MUT)
            set_list(n, kids(head))
        else if nodes[head].op == 4:
            nodes[n].kind = .while_
            nodes[n].a = nodes[head].a
        else:
            nodes[n].kind = .loopx
            nodes[n].a = i32(head)
    dc_depth -= 1
    n

# `parallel x in xs body`, `parallel @x in xs body` after its keyword; `collect`, a comprehension's
# (`[parallel x in xs f(x)]`): the region dw_parallel makes. A form it reports takes the reference
# grammar.
dc_parallel = (token: DewyLexeme, collect: bool) -> int:
    pos = mkpos(dn_file, token.start)
    mutable = dn_accept(.at)
    binder = dn_tokens[dn_at]
    if binder.kind != .identifier or binder.symbol != .none or dn_reserved(int(binder.name)) or dn_tokens[dn_at + 1].symbol != .kw_in or collect and mutable: return 0
    dn_at += 2
    source = dc_expr(dn_power(.kw_in) + 1)
    if source == 0 or dn_power(dn_peek()) > 0 or dn_peek() == .kw_not or not dn_can_start(dn_tokens, dn_at): return 0
    param = mk(.param, mkpos(dn_file, binder.start))
    nodes[param].name = binder.name
    saved_defer = dc_defer_result
    saved_result = dc_fn_result
    dc_defer_result = 0
    dc_fn_result = if collect: 1 else: 0
    saved_map = dc_map_ok
    dc_map_ok = false
    body = dc_body()
    dc_map_ok = saved_map
    dc_fn_result = saved_result
    dc_defer_result = saved_defer
    if body == 0 or dn_peek() == .kw_else or not dc_parallel_exits(body, 0): return 0
    fn_ = mk(.lambda, pos)
    add_flag(fn_, NF_LANG_BODY)
    if not collect and not mutable: add_flag(fn_, NF_VOID)
    if mutable:
        ret = mk(.return_, pos)
        nodes[ret].a = i32(bc_ident(name_of(int(binder.name)), pos))
        statements = kids(body)
        statements.push(ret)
        set_list(body, statements)
        add_flag(source, NF_MUT)
        dw_finish_function(fn_, [param], body, "")
    else:
        set_list(fn_, [param])
        nodes[fn_].b = i32(body)
    call = bc_call(if mutable: "parallel_update" else if collect: "__dewy_parallel_collect" else: "__dewy_parallel_each", [source, fn_], pos)
    region = mk(.parallel_region, pos)
    nodes[region].a = i32(call)
    if collect: return region
    statement = mk(.exprstmt, pos)
    nodes[statement].a = i32(region)
    add_flag(statement, NF_STMT)
    statement

# No `return` leaves a parallel body, nor a `break` or `continue` outside a loop in it
# (dw_parallel_exits reports them).
dc_parallel_exits = (n: int, depth: int) -> bool:
    if n <= 0 or nodes[n].kind == .lambda or nodes[n].kind == .fn_: return true
    k = nodes[n].kind
    if k == .return_ or (k == .break_ or k == .continue_) and depth == 0: return false
    inner = depth
    if k == .for_ or k == .while_ or k == .loopx: inner += 1
    if not dc_parallel_exits(int(nodes[n].a), depth) or not dc_parallel_exits(int(nodes[n].b), inner) or not dc_parallel_exits(int(nodes[n].c), depth): return false
    loop child in kids(n):
        if not dc_parallel_exits(child, depth): return false
    true

# `[loop ... ]` after its `[`: the loop collects the values its bodies end with (dw_comprehension);
# `key -> value` entries make a dictionary. A parallel or record comprehension takes the reference
# grammar.

dc_comprehension = () -> int:
    pos = mkpos(dn_file, dn_tokens[dn_at].start)
    saved_map = dc_map_ok
    made = dc_pairs_made - dc_pairs_collected
    dc_map_ok = true
    flow = dc_flow()
    dc_map_ok = saved_map
    if flow == 0 or not dn_accept(.rbrack): return 0
    # (`[loop f in fields(T) $field(f.name)=x.$field(f.name)]`: a record's rows, dw_record_loop)
    if dc_record_tail(flow): return dc_record_loop(flow)
    add_flag(flow, NF_STMT)
    accumulator = intern("$dewy_collection_{nodes.len()}")
    decl = mk(.vardecl, pos)
    nodes[decl].name = i32(accumulator)
    nodes[decl].b = i32(mk(.array, pos))
    map = dc_tail_kind(flow) == 2
    if dc_collect(flow, accumulator, map) == 0 or dc_pairs_made - dc_pairs_collected != made: return 0
    result = mk(.exprstmt, pos)
    value = mk(.ident, pos)
    nodes[value].name = i32(accumulator)
    nodes[result].a = i32(value)
    block = mk(.block, pos)
    set_list(block, [decl, flow, result])
    add_flag(block, NF_COMPREHENSION)
    if not map: return block
    callee = mk(.ident, pos)
    nodes[callee].name = i32(intern("__map_of"))
    call = mk(.call, pos)
    nodes[call].a = i32(callee)
    set_list(call, [block])
    call

# A comprehension's last value is a computed row (dw_collection_kind 3).
dc_record_tail = (n: int) -> bool:
    k = nodes[n].kind
    if k == .for_ or k == .while_ or k == .loopx or k == .if_: return dc_record_tail(int(nodes[n].b))
    if k == .block: return nkids(n) > 0 and dc_record_tail(kid(n, nkids(n) - 1))
    k == .exprstmt and nodes[int(nodes[n].a)].kind == .namedarg

# A record comprehension's loops, each one binder, down to its one row (dw_record_loop); 0 for a
# shape the reference grammar reports.
dc_record_loop = (n: int) -> int:
    k = nodes[n].kind
    if k == .for_:
        if nkids(n) != 1 or nodes[kid(n, 0)].kind != .ident or nodes[n].c != 0 or has_flag(n, NF_MUT): return 0
        body = dc_record_loop(int(nodes[n].b))
        if body == 0: return 0
        loop_ = mk(.record_loop, nodes[n].pos)
        nodes[loop_].a = nodes[n].a
        nodes[loop_].name = nodes[kid(n, 0)].name
        nodes[loop_].b = i32(body)
        return loop_
    if k == .block:
        if nkids(n) != 1: return 0
        return dc_record_loop(kid(n, 0))
    if k == .exprstmt and nodes[int(nodes[n].a)].kind == .namedarg: return int(nodes[n].a)
    0

# What a comprehension's first collected value is (dw_collection_kind): 1 a value, 2 a dictionary
# entry, 0 none.
dc_tail_kind = (statement: int) -> int:
    if statement <= 0: return 0
    k = nodes[statement].kind
    if k == .if_ or k == .for_ or k == .while_ or k == .loopx:
        first = dc_block_tail_kind(int(nodes[statement].b))
        if first != 0: return first
        return dc_block_tail_kind(int(nodes[statement].c))
    if k != .exprstmt: return 0
    value = int(nodes[statement].a)
    if nodes[value].kind == .block and not has_flag(value, NF_COMPREHENSION): return dc_block_tail_kind(value)
    if nodes[value].kind == .pair: return 2
    1

dc_block_tail_kind = (block: int) -> int:
    if block <= 0 or nodes[block].kind != .block or nkids(block) == 0: return 0
    dc_tail_kind(kid(block, nkids(block) - 1))

dc_tagged_last: {int: bool} = {}

# A comprehension's statement collecting into `accumulator` (dw_collect): a value is pushed (a
# call's own values, as its sink gives them), an entry of a dictionary (`map`) as its pair, a
# flow collects in each body, a `{ ... }` value in its last statement; other statements collect
# nothing. 0: a form collected another way.
dc_collect = (statement: int, accumulator: int, map: bool = false) -> int:
    if statement <= 0: return 0
    k = nodes[statement].kind
    if k == .if_ or k == .for_ or k == .while_ or k == .loopx:
        if not dc_collect_block(int(nodes[statement].b), accumulator, map): return 0
        if nodes[statement].c != 0 and not dc_collect_block(int(nodes[statement].c), accumulator, map): return 0
        return statement
    if k != .exprstmt: return statement
    value = int(nodes[statement].a)
    # (a parallel loop collects nothing: dw_flow reports it)
    if nodes[value].kind == .match_ or nodes[value].kind == .parallel_region: return 0
    if nodes[value].kind == .block and not has_flag(value, NF_COMPREHENSION):
        if not dc_collect_block(value, accumulator, map): return 0
        return value
    pos = nodes[statement].pos
    if map != (nodes[value].kind == .pair): return 0
    if map:
        entry = mk(.tuple, pos)
        add_flag(entry, NF_MAP_PAIR)
        set_list(entry, [int(nodes[value].a), int(nodes[value].b)])
        value = entry
        dc_pairs_collected += 1
    else if nodes[value].kind == .call: return statement
    receiver = mk(.ident, pos)
    nodes[receiver].name = i32(accumulator)
    add_flag(receiver, NF_MUT)
    callee = mk(.field, pos)
    nodes[callee].a = i32(receiver)
    nodes[callee].name = i32(intern("push"))
    call = mk(.call, pos)
    nodes[call].a = i32(callee)
    set_list(call, [value])
    nodes[statement].a = i32(call)
    statement

dc_collect_block = (block: int, accumulator: int, map: bool) -> bool:
    if block <= 0 or nodes[block].kind != .block or dc_tagged_last.has(block): return false
    count = nkids(block)
    if count == 0: return true
    last = dc_collect(kid(block, count - 1), accumulator, map)
    if last == 0: return false
    set_kid(block, count - 1, last)
    true

# A lambda opens here: a name then `=>`, or a parenthesized list then `=>` or `:>`.
dc_lambda_next = () -> bool: dc_lambda_next_at(dn_at)

dc_lambda_next_at = (start: int) -> bool:
    dn_at_saved = dn_at
    dn_at = start
    yes = dc_lambda_opens()
    dn_at = dn_at_saved
    yes

dc_lambda_opens = () -> bool:
    if dn_tokens[dn_at].kind == .identifier: return (dn_tokens[dn_at].symbol == .none or dn_tokens[dn_at].symbol == .kw_test) and dn_tokens[dn_at + 1].symbol == .function
    if dn_tokens[dn_at].symbol != .lparen: return false
    next = dn_tokens[dn_at + 1].symbol
    if not (next == .rparen or next == .at or next == .lbrack or next == .lparen or next == .ellipsis or dn_tokens[dn_at + 1].kind == .metatag or dn_tokens[dn_at + 1].kind == .identifier and (dn_tokens[dn_at + 2].symbol == .colon or dn_tokens[dn_at + 2].symbol == .rparen or dn_tokens[dn_at + 2].kind == .identifier or dn_tokens[dn_at + 2].symbol == .assign)): return false
    depth = 0
    at = dn_at
    loop at < dn_tokens.len():
        symbol = dn_tokens[at].symbol
        if dn_tokens[at].kind == .eof: return false
        if symbol == .lparen: depth += 1
        if symbol == .rparen:
            depth -= 1
            if depth == 0: break
        at += 1
    after = dn_tokens[at + 1].symbol
    after == .function or after == .returns

# `<T U>(params) =>` opens here.
dc_generic_lambda_next = () -> bool: dc_generic_lambda_next_at(dn_at)

dc_generic_lambda_next_at = (start: int) -> bool:
    at = start + 1
    loop dn_tokens[at].kind == .identifier and dn_tokens[at].symbol == .none: at += 1
    at > start + 1 and dn_tokens[at].symbol == .rangle and dn_tokens[at + 1].symbol == .lparen and not dn_tokens[at + 1].space and dc_lambda_next_at(at + 1)

dc_none_id = 0
dc_none_type = () -> int:
    if dc_none_id == 0: dc_none_id = intern("none")
    dc_none_id

dc_empty_id = -1
dc_empty_name = () -> int:
    if dc_empty_id < 0: dc_empty_id = intern("")
    dc_empty_id

# A `match` in a block is a statement holding it (dw_flow_stmt).
dc_flow_stmt = (n: int) -> int:
    if nodes[n].kind != .match_: return n
    s = mk(.exprstmt, nodes[n].pos)
    nodes[s].a = i32(n)
    s

# `match value { pattern => body ... }`, or one arm without braces, then an optional
# `else`, after its keyword: as dw_match and dw_flow make it. Patterns are a name, `_`,
# `name:T` or `<literal>`; shapes, sequences, byte and refined patterns take the reference
# grammar.
dc_match = (token: DewyLexeme) -> int:
    pos = mkpos(dn_file, token.start)
    n = mk(.match_, pos)
    first = dn_at
    scrutinee = dc_expr(0)
    if scrutinee == 0 or not dn_can_start(dn_tokens, dn_at): return 0
    # (`match (x y)`: a sequence of values, each read once, dw_match)
    if nodes[scrutinee].kind == .tuple and nodes[scrutinee].aux == i32(TUPLE_VALUES) and dn_tokens[first].symbol == .lparen and dc_closing(first) == dn_at - 1:
        loop item in kids(scrutinee):
            if has_flag(item, NF_SPREAD): return 0
        nodes[scrutinee].aux = 0
    nodes[n].a = i32(scrutinee)
    arms: int[]
    if dn_accept(.lbrace):
        loop not dn_accept(.rbrace):
            if dn_tokens[dn_at].kind == .eof: return 0
            arm = dc_arm()
            if arm == 0: return 0
            arms.push(arm)
        # (`let n = match x {...}; n`: `;` ends the statement the match is the value of)
        if not dc_flow_ends() and dn_peek() != .semi: return 0
    else:
        arm = dc_arm()
        if arm == 0: return 0
        arms.push(arm)
    if dn_accept(.kw_else):
        rest = 0
        if dn_peek() == .kw_if or dn_peek() == .kw_match:
            rest = dc_flow()
            if rest == 0 or nodes[rest].kind == .block: return 0
            block = mk(.block, nodes[rest].pos)
            set_list(block, [dc_flow_stmt(rest)])
            rest = block
        else:
            rest = dc_body()
            if rest == 0: return 0
        fallback = mk(.arm, nodes[rest].pos)
        set_list(fallback, [mk(.pwild, nodes[rest].pos)])
        nodes[fallback].b = i32(rest)
        arms.push(fallback)
    set_list(n, arms)
    n

# Nothing continues the expression a braced body or an arm ends (the reference grammar
# would apply it to that body or arm).
dc_flow_ends = () -> bool:
    t = dn_tokens[dn_at]
    if t.kind == .eof: return true
    if dn_power(t.symbol) > 0 or t.symbol == .semi or t.symbol == .dot or t.symbol == .question or t.symbol == .ellipsis or t.symbol == .kw_or_throw: return false
    t.space or t.newline or t.symbol == .rbrace or t.symbol == .rparen or t.symbol == .rbrack or t.symbol == .kw_else

# `pattern => body`: an arm; an unbraced body ends where `=>`'s operand ends.
dc_arm = () -> int:
    first = dn_tokens[dn_at]
    pattern = dc_pattern()
    if pattern == 0 or not dn_accept(.function): return 0
    arm = mk(.arm, mkpos(dn_file, first.start))
    set_list(arm, [pattern])
    body = dc_operand_body()
    if body == 0 or not dc_flow_ends(): return 0
    nodes[arm].b = i32(body)
    arm

# The right operand of `=>` as a block (dw_block): braced, or one statement.
dc_operand_body = () -> int:
    first = dn_at
    opening = dn_tokens[dn_at]
    if opening.symbol == .lbrace or opening.kind == .metatag and dn_tokens[dn_at + 1].symbol == .lbrace: return dc_body()
    statement = 0
    if opening.symbol == .kw_concurrent:
        # (a statement: the group expresses nothing, dw_stmt)
        dn_at += 1
        statement = dc_concurrent(opening, true)
        if statement == 0: return 0
    else if opening.symbol == .kw_if or opening.symbol == .kw_match or opening.symbol == .kw_loop:
        statement = dc_flow()
        if statement == 0: return 0
        # (a chain folding to its compiled arm: that arm's statements, dw_block's dw_target_splice)
        if dc_live_at == first and opening.symbol == .kw_if:
            if dc_tagged_last.has(statement): return 0
            spliced = mk(.block, mkpos(dn_file, opening.start))
            set_list(spliced, kids(statement))
            return spliced
        add_flag(statement, NF_STMT)
        statement = dc_flow_stmt(statement)
    else if opening.symbol == .kw_return or opening.symbol == .kw_break or opening.symbol == .kw_continue:
        # (`=> return x`: the statement, dn_stmt within the operand)
        statement = dc_statement()
        if statement == 0: return 0
    else if opening.symbol == .lparen and dc_update_next():
        statement = dc_grouped_update()
        if statement == 0: return 0
    else:
        value = dc_expr(30)
        if value == 0: return 0
        # (`=> $unsafe f()`: the statement is its operand's, dw_stmt)
        written = opening.start
        if dc_unsafe_at(first): written = dn_tokens[first + 1].start
        statement = mk(.exprstmt, mkpos(dn_file, written))
        nodes[statement].a = i32(value)
    body = mk(.block, mkpos(dn_file, opening.start))
    set_list(body, [statement])
    body

# A name binds (`_` nothing), `name:T` tests a type, `<literal>` a value (dw_pattern).
dc_pattern = () -> int:
    token = dn_tokens[dn_at]
    pos = mkpos(dn_file, token.start)
    if token.symbol == .langle:
        dn_at += 1
        literal = dn_tokens[dn_at]
        # `<b'x'>`: a byte (dw_byte_char)
        quote = dn_tokens[dn_at + 1]
        if literal.kind == .identifier and literal.symbol == .none and dc_word(int(literal.name)) == DC_B and quote.kind == .quoted and not quote.space:
            if files[dn_file].src[quote.start] != '\'' or not dc_plain_quote(quote): return 0
            text = dn_string(quote, true)
            if text == 0 or len(name_of(int(nodes[text].sval))) != 1: return 0
            dn_at += 2
            if not dn_accept(.rangle): return 0
            p = mk(.plit, pos)
            nodes[p].a = i32(bc_int(int(name_of(int(nodes[text].sval))[0]), pos))
            return p
        # `<Busy>`, `<int64|string>`, `<'e'|'w'>`: a type (dw_pattern's `<>`)
        if literal.kind == .identifier and literal.symbol == .none and int(literal.name) != dn_none_id or literal.kind == .quoted and dn_tokens[dn_at + 1].symbol == .pipe:
            dc_type_args += 1
            t = dc_annotation()
            dc_type_args -= 1
            if t == 0: return 0
            if not dn_accept(.rangle):
                if not (dn_edits_on and dn_closer_joined()): return 0
                dn_split_closer()
            p = mk(.ptype, pos)
            nodes[p].a = i32(t)
            return p
        # `<0|1|2>`, `<-1|1>`: integer singletons, a type (dw_literal_type)
        leaf = dc_int_leaf(dn_at)
        if leaf > 0 and dn_tokens[dn_at + leaf].symbol == .pipe:
            dc_type_args += 1
            t = dc_annotation()
            dc_type_args -= 1
            if t == 0: return 0
            if not dn_accept(.rangle):
                if not (dn_edits_on and dn_closer_joined()): return 0
                dn_split_closer()
            p = mk(.ptype, pos)
            nodes[p].a = i32(t)
            return p
        negative = literal.symbol == .minus
        if negative: literal = dn_tokens[dn_at + 1]
        integer = literal.kind == .source_integer or literal.kind == .integer
        if not integer and (negative or not (literal.kind == .boolean or literal.kind == .identifier and literal.symbol == .none and int(literal.name) == dn_none_id or literal.kind == .quoted and dc_plain_quote(literal))): return 0
        before = dn_at
        dn_angles += 1
        value = dc_expr(0)
        dn_angles -= 1
        if value == 0 or dn_at != before + (if negative: 2 else: 1) or not dn_accept(.rangle): return 0
        p = mk(.plit, pos)
        nodes[p].a = i32(value)
        return p
    # `[sign:1 limbs]`: an object's shape, each part a named field; `(a b)`: a sequence of two or more
    if token.symbol == .lbrack or token.symbol == .lparen:
        shape = token.symbol == .lbrack
        close = DewyToken.rparen
        if shape: close = .rbrack
        dn_at += 1
        parts: int[]
        loop not dn_accept(close):
            if dn_tokens[dn_at].kind == .eof: return 0
            part = dc_pattern()
            if part == 0 or shape and nodes[part].name == 0: return 0
            parts.push(part)
        if not shape and parts.len() < 2: return 0
        p = mk(if shape: NK.pshape else: NK.pseq, pos)
        set_list(p, parts)
        return p
    if token.kind != .identifier or (token.symbol != .none and token.symbol != .kw_test) or dn_reserved(int(token.name)): return 0
    dn_at += 1
    named = dc_word(int(token.name)) != DC_HOLE
    if not dn_accept(.colon):
        p = mk(.pwild, pos)
        if named: nodes[p].name = token.name
        return p
    written = dn_tokens[dn_at]
    # `answer:42`, `s:"yes"`, `x:none`: one literal, a value (dw_pattern's literal); `n:1|2`,
    # `other:'e'|'w'`: literals joined, a type
    leaf = dc_int_leaf(dn_at)
    if leaf == 0 and (written.kind == .boolean or written.kind == .quoted and dc_plain_quote(written) or written.kind == .identifier and int(written.name) == dn_none_id): leaf = 1
    if leaf > 0 and dn_tokens[dn_at + leaf].symbol != .pipe:
        before = dn_at
        value = dc_atom()
        if value == 0 or dn_at != before + leaf: return 0
        p = mk(.plit, pos)
        nodes[p].a = i32(value)
        if named: nodes[p].name = token.name
        return p
    if leaf == 0 and written.symbol != .lbrack and (written.kind != .identifier or written.symbol != .none or int(written.name) == dn_none_id): return 0
    outer = dc_pattern_binder
    if named: dc_pattern_binder = int(token.name)
    t = dc_annotation(45)
    dc_pattern_binder = outer
    if t == 0: return 0
    p = mk(.ptype, pos)
    nodes[p].a = i32(t)
    if named: nodes[p].name = token.name
    p

# A quoted literal without interpolation.
dc_plain_quote = (token: DewyLexeme) -> bool:
    source = files[dn_file].src
    i = token.start
    loop i < token.stop:
        c = source[i]
        if c == '{': return false
        # (`'\{'`: an escaped brace opens nothing)
        if c == '\\': i += 1
        i += 1
    true

# Module functions with scalar signatures and migrated bodies need no syntax
# tree. A contextual signature or body retries the full declaration grammar.
dc_function = () -> int:
    token = dn_tokens[dn_at]
    # (`let name = (...) => ...` and `const name = ...` declare a module function too)
    if token.symbol == .kw_let or token.symbol == .kw_const:
        dn_at += 1
        token = dn_tokens[dn_at]
    # (`spawn = (...) => ...`: before `=`, `spawn` is a name, dn_atom)
    if token.kind != .identifier or (token.symbol != .none and token.symbol != .kw_test and token.symbol != .kw_spawn) or dn_reserved(int(token.name)): return 0
    if dn_tokens[dn_at + 1].symbol != .assign: return 0
    # `name = <T U>(params) => body`: a generic function (dw_type_params)
    if dn_tokens[dn_at + 2].symbol == .langle:
        if dc_word(int(token.name)) == DC_MAIN: return 0
        dn_at += 2
        opening = dn_tokens[dn_at]
        type_params = dc_type_params()
        if type_params.len() == 0: return 0
        dc_depth += 3
        n = dc_function_literal(token.name, opening, type_params)
        if n == 0: return 0
        dn_accept_semi()
        return n
    if dn_tokens[dn_at + 2].symbol != .lparen: return 0
    # `twice = (*2)`: a partial application, a module function of its own (dw_function)
    if dc_partial_at(dn_at + 2):
        if dc_word(int(token.name)) == DC_MAIN: return 0
        dn_at += 3
        dc_depth += 3
        n = dc_partial(dn_tokens[dn_at - 1], token.name)
        if n == 0 or dn_power(dn_peek()) > 0: return 0
        dn_accept_semi()
        return n
    dn_at += 2
    # Account for the enclosing assignment, signature and parameter grammar.
    dc_depth += 3
    # (`name = (<T>(xs:T) => ...)`: a group of one generic member, below)
    if dn_tokens[dn_at + 1].symbol != .lparen and not (dn_tokens[dn_at + 1].symbol == .langle and dc_generic_lambda_next_at(dn_at + 1)):
        dn_at += 1
        dc_literal_at = dn_at - 1
        n = dc_function_literal(token.name, dn_tokens[dn_at - 1])
        dc_literal_at = -1
        if n == 0: return 0
        dn_accept_semi()
        return n
    # `name = ((a:T):>R => ...) & ((b:U):>R => ...)`: an overload group, one
    # declaration per member
    if dc_word(int(token.name)) == DC_MAIN: return 0
    dc_made.clear()
    loop true:
        if not dn_accept(.lparen): return 0
        # (`(<T>(n:int64):>array<T> => ...)`: a generic member)
        opening = dn_tokens[dn_at]
        type_params: int[]
        if opening.symbol == .langle:
            type_params = dc_type_params()
            if type_params.len() == 0: return 0
        else if not dn_accept(.lparen): return 0
        dc_depth += if dc_made.len() == 0: 1 else: 2
        n = dc_function_literal(token.name, opening, type_params)
        if n == 0 or not dn_accept(.rparen): return 0
        dc_depth -= if dc_made.len() == 0: 1 else: 2
        dc_made.push(n)
        if dn_peek() != .amp: break
        dn_at += 1
    dn_accept_semi()
    dc_made[0]

# `<T U>(` at `<`: a function's type parameters (dw_type_params), through the `(` opening its
# parameters; empty for any other form.
dc_type_params = () -> int[]:
    if not dn_accept(.langle): return []
    type_params: int[]
    loop not dn_accept(.rangle):
        binder = dn_tokens[dn_at]
        if binder.kind != .identifier or binder.symbol != .none or dn_reserved(int(binder.name)) or dc_word(int(binder.name)) == DC_HOLE: return []
        loop seen in type_params:
            if nodes[seen].name == binder.name: return []
        dn_at += 1
        t = mk(.ident, mkpos(dn_file, binder.start))
        nodes[t].name = binder.name
        # (`<E:Effect>`: an effect row's parameter, dw_type_params)
        if dc_effect_param(): nodes[t].aux = 1
        type_params.push(t)
    if type_params.len() == 0 or dn_tokens[dn_at].space or not dn_accept(.lparen): return []
    type_params

# `:Effect` after a type parameter's name (taken): it names an effect row.
dc_effect_param = () -> bool:
    kind = dn_tokens[dn_at + 1]
    if dn_peek() != .colon or kind.kind != .identifier or dn_payload(kind) != "Effect": return false
    dn_at += 2
    true

# An overload group's declarations, or a type's and its methods', when the last direct
# declaration made several.
dc_made: int[]

dc_methods: int[]          # (each method's function, in row order)
dc_method_hooks: int[]     # (its lifecycle tag: ownership_tag's code, 0 none)

dc_method_body = false     # (a method's body is read: it does not wait, dc_lazy_body)


# `Name:type = [field:T  field:T=default  field=default]`, a record without
# methods, lifecycle tags or type parameters; `Name:type = T|U` an alias; `Name = type of Base`,
# `Name = type of [fields]` or `Name = type of Base & [fields]` (`:type` or not), a nominal type.
dc_type_declaration = () -> int:
    # `small = int64<i => 0 <=? i>`: a refinement names a type (dw_top_declarations, dw_declare)
    refined = dc_refinement_alias()
    if refined != 0: return refined
    # (`let Name:type = ...` declares it too, dw_declare)
    word = dn_tokens[dn_at].symbol
    if (word == .kw_let or word == .kw_const) and dn_tokens[dn_at + 2].symbol == .colon: dn_at += 1
    after = dn_tokens[dn_at + 1].symbol
    if after != .colon and after != .assign: return 0
    token = dn_tokens[dn_at]
    if token.kind != .identifier or (token.symbol != .none and token.symbol != .kw_test) or dn_reserved(int(token.name)): return 0
    annotated = dn_tokens[dn_at + 1].symbol == .colon and dn_tokens[dn_at + 2].kind == .identifier and dn_tokens[dn_at + 2].name == i32(dn_type_id) and dn_tokens[dn_at + 3].symbol == .assign
    minted = dn_tokens[dn_at + 1].symbol == .assign and dn_tokens[dn_at + 2].kind == .identifier and dn_tokens[dn_at + 2].name == i32(dn_type_id) and dn_tokens[dn_at + 3].symbol == .kw_of
    if not annotated and not minted: return 0
    dc_methods.clear()
    dc_method_hooks.clear()
    dn_at += if annotated: 4 else: 2
    pos = mkpos(dn_file, token.start)
    if dn_tokens[dn_at].kind == .identifier and dn_tokens[dn_at].name == i32(dn_type_id) and dn_tokens[dn_at + 1].symbol == .kw_of:
        dn_at += 2
        n = mk(.struct_, pos)
        nodes[n].name = token.name
        names: int[]
        if dn_peek() == .lbrack:
            dn_at += 1
            if not dc_record_fields(n, names): return 0
        else:
            base = dc_type_named()
            if base == 0 or nodes[base].kind != .tname or nkids(base) != 0: return 0
            nodes[n].a = i32(base)
            if dn_accept(.amp):
                if not dn_accept(.lbrack) or not dc_record_fields(n, names): return 0
            else: set_list(n, [])
        if not dc_statement_ends() or not dc_record_members(n, names): return 0
        dc_transfer_apply(n)
        return n
    if not annotated: return 0
    # `Name:type = A & B & [f:T]`: a record with the fields of each (dw_intersection)
    if dc_intersection_next(): return dc_intersection(token, pos)
    # `Name:type = <T U>[fields]`: a generic record (dw_type_params)
    type_params: int[]
    # (`<T>[...]`: type parameters, plain names then a record; `<(x:T):>R>`, `<'a' | 1>`: an alias)
    if dn_peek() == .langle and dn_tokens[dn_at + 1].kind == .identifier and dn_tokens[dn_at + 1].symbol == .none and (dn_tokens[dn_at + 2].symbol == .rangle or dn_tokens[dn_at + 2].kind == .identifier or dn_tokens[dn_at + 2].symbol == .colon and dn_payload(dn_tokens[dn_at + 3]) == "Effect"):
        dn_at += 1
        loop not dn_accept(.rangle):
            binder = dn_tokens[dn_at]
            if binder.kind != .identifier or binder.symbol != .none or dn_reserved(int(binder.name)) or dc_word(int(binder.name)) == DC_HOLE: return 0
            loop seen in type_params:
                if nodes[seen].name == binder.name: return 0
            dn_at += 1
            t = mk(.ident, mkpos(dn_file, binder.start))
            nodes[t].name = binder.name
            if dc_effect_param(): nodes[t].aux = 1
            type_params.push(t)
        if type_params.len() == 0 or dn_tokens[dn_at].space: return 0
        # `Pair:type = <T>(array<T length=2>)`: a generic alias of the one type in parentheses
        if dn_accept(.lparen):
            alias = dc_annotation()
            if alias == 0 or not dn_accept(.rparen) or dn_power(dn_peek()) > 0: return 0
            n = mk(.typealias, pos)
            nodes[n].name = token.name
            nodes[n].a = i32(alias)
            set_list2(n, type_params)
            add_flag(n, NF_GENERIC)
            dn_accept_semi()
            return n
        if dn_peek() != .lbrack: return 0
    # (`Entry:type = [int64 string]`: a type per position, an alias, dw_positional_types)
    positional = false
    if dn_peek() == .lbrack and type_params.len() == 0:
        first = dn_tokens[dn_at + 1]
        positional = first.symbol != .rbrack and first.kind != .metatag and first.symbol != .at and dn_tokens[dn_at + 2].symbol != .colon and dn_tokens[dn_at + 2].symbol != .assign
    if dn_peek() != .lbrack or positional:
        # `Apply:type = (x:int64):>int64`: a function type without its angle brackets (dw_type's `:>`)
        alias = 0
        if dn_peek() == .lparen and dn_tokens[dc_closing(dn_at) + 1].symbol == .returns: alias = dc_function_type(false)
        else: alias = dc_annotation()
        if alias == 0 or dn_power(dn_peek()) > 0: return 0
        n = mk(.typealias, pos)
        nodes[n].name = token.name
        nodes[n].a = i32(alias)
        dn_accept_semi()
        return n
    dn_at += 1
    n = mk(.struct_, pos)
    nodes[n].name = token.name
    if type_params.len() > 0:
        set_list2(n, type_params)
        add_flag(n, NF_GENERIC)
    names: int[]
    if not dc_record_fields(n, names) or dn_power(dn_peek()) > 0: return 0
    dn_accept_semi()
    if not dc_record_members(n, names): return 0
    dc_transfer_apply(n)
    n

# An `&` joins the declared type's operands at the top (not `int64 & ~0`, a refinement).
dc_intersection_next = () -> bool:
    depth = 0
    k = dn_at
    found = false
    loop k < dn_tokens.len():
        t = dn_tokens[k]
        if t.kind == .eof or k > dn_at and depth == 0 and t.newline: break
        symbol = t.symbol
        if symbol == .lparen or symbol == .lbrack or symbol == .lbrace or symbol == .langle: depth += 1
        else if symbol == .rparen or symbol == .rbrack or symbol == .rbrace or symbol == .rangle: depth -= 1
        else if depth == 0 and symbol == .amp:
            if dn_tokens[k + 1].symbol == .tilde: return false
            found = true
        k += 1
    found

# The operands of an intersection after its declaration's `=`: names, and one row list whose
# fields and methods the record adds (dw_intersection, dw_type_methods). 0 for other forms.
dc_intersection = (token: DewyLexeme, pos: int) -> int:
    n = mk(.struct_, pos)
    nodes[n].name = token.name
    set_list(n, [])
    components: int[]
    names: int[]
    rows = false
    loop true:
        if dn_peek() == .lbrack:
            if rows: return 0
            rows = true
            dn_at += 1
            if not dc_record_fields(n, names) or dc_transfer_bits != 0: return 0
            loop hook in dc_method_hooks:
                if hook != 0: return 0
        else:
            leaf = dn_tokens[dn_at]
            if leaf.kind != .identifier or leaf.symbol != .none: return 0
            t = dc_type_named()
            if t == 0: return 0
            components.push(t)
        if not dn_accept(.amp): break
    if dn_power(dn_peek()) > 0 or not dc_statement_ends() and dn_peek() != .semi: return 0
    dn_accept_semi()
    if not dc_record_members(n, names): return 0
    struct_components[n] = components
    n

# `name = T<condition>` or `name = T & ~value` at the top of a module (`let` or `const` before it,
# or neither): the alias of the refined type; 0 for anything else (dn_at stays).
dc_refinement_alias = () -> int:
    start = dn_at
    if dn_tokens[dn_at].symbol == .kw_let or dn_tokens[dn_at].symbol == .kw_const: dn_at += 1
    if dn_at + 4 >= dn_tokens.len():
        dn_at = start
        return 0
    token = dn_tokens[dn_at]
    base = dn_tokens[dn_at + 2]
    if token.kind != .identifier or token.symbol != .none or dn_reserved(int(token.name)) or dn_tokens[dn_at + 1].symbol != .assign or base.kind != .identifier or base.symbol != .none:
        dn_at = start
        return 0
    # (`nonzero = int64 & ~0`: the value excluded, dw_type's `& ~`)
    excluded = dn_tokens[dn_at + 3].symbol == .amp and dn_tokens[dn_at + 4].symbol == .tilde
    if not excluded and (dn_tokens[dn_at + 3].symbol != .langle or dn_tokens[dn_at + 3].space or not dc_refinement_arguments(dn_at + 3)):
        dn_at = start
        return 0
    dn_at += 2
    t = dc_type_named()
    if excluded:
        if t == 0 or dn_peek() != .amp: return 0
        dn_at += 2
        value = dc_expr(dn_prefix_power(.tilde, false))
        if value == 0: return 0
        t = dc_excluded(t, value, mkpos(dn_file, base.start))
    if t == 0 or nodes[t].kind != .trefined or dn_power(dn_peek()) > 0: return 0
    n = mk(.typealias, mkpos(dn_file, token.start))
    nodes[n].name = token.name
    nodes[n].a = i32(t)
    dn_accept_semi()
    n

# `T & ~value`: T refined to leave value out (dw_type's `& ~`).
dc_excluded = (base: int, value: int, pos: int) -> int:
    n = mk(.trefined, pos)
    nodes[n].a = i32(base)
    binder = intern("$refinement")
    nodes[n].name = i32(binder)
    named = mk(.ident, pos)
    nodes[named].name = i32(binder)
    predicate = mk(.binary, pos)
    nodes[predicate].op = i32(int(Tok.ne))
    nodes[predicate].a = i32(named)
    nodes[predicate].b = i32(value)
    nodes[n].b = i32(predicate)
    refine_active = true
    n

# The type arguments opening at `at` hold a condition at their top (dw_top_declarations' test): a
# `=>` or a comparison, or a group opening with one.
dc_refinement_arguments = (at: int) -> bool:
    depth = 0
    k = at
    loop k < dn_tokens.len():
        t = dn_tokens[k]
        symbol = t.symbol
        if t.kind == .eof: return false
        if symbol == .langle or symbol == .lparen or symbol == .lbrack or symbol == .lbrace:
            depth += 1
            if depth == 2 and symbol == .lparen and dc_refinement_next_at(k): return true
        else if symbol == .rangle or symbol == .rparen or symbol == .rbrack or symbol == .rbrace:
            depth -= 1
            if depth == 0: return false
        else if depth == 1:
            scalar = dn_token_uninvert(symbol)
            if symbol == .function or symbol == .kw_and or scalar == .eq or scalar == .lt or scalar == .le or scalar == .gt or scalar == .ge or scalar == .contains: return true
        k += 1
    false

dc_refinement_next_at = (at: int) -> bool:
    saved = dn_at
    dn_at = at
    yes = dc_refinement_next()
    dn_at = saved
    yes

# A record type's rows after its `[`, through its `]` (dw_param of each field): its fields, the
# rows' names in order; methods (`name = (params) => body`, a lifecycle tag before one) wait in
# dc_methods for dc_record_members. Transfer rows and other tags take the reference grammar.

dc_record_fields = (n: int, names: mut int[]) -> bool:
    fields: int[]
    dc_methods.clear()
    dc_method_hooks.clear()
    dc_transfer_bits = 0
    dc_transfer_at = 0
    hook = 0
    loop not dn_accept(.rbrack):
        first = dn_tokens[dn_at]
        # (`$send`, `$sync=false`, `$unsafe` among the rows: the type's transfer claims, dw_transfer_row)
        if first.kind == .metatag and hook == 0 and dc_transfer_row(first): continue
        if first.kind == .metatag:
            # (`$__drop__`, `$__copy__`, `$__move__` on a line before a method)
            tag = dc_lifecycle_tag(first)
            if tag == 0 or hook != 0 or not dn_tokens[dn_at + 1].newline: return false
            hook = tag
            dn_at += 1
            continue
        by_place = dn_accept(.at)
        field = dn_tokens[dn_at]
        if field.kind != .identifier or (field.symbol != .none and field.symbol != .kw_test) or dn_reserved(int(field.name)): return false
        if not by_place and dn_tokens[dn_at + 1].symbol == .assign and dn_tokens[dn_at + 2].symbol == .lparen and dc_lambda_next_at(dn_at + 2):
            if dc_word(int(field.name)) == DC_MAIN: return false
            dn_at += 3
            dc_depth += 3
            deferred = dc_deferred_syntax.len()
            saved = dc_method_body
            dc_method_body = true
            method = dc_function_literal(field.name, dn_tokens[dn_at - 1])
            dc_method_body = saved
            if method == 0 or dc_deferred_syntax.len() != deferred or dn_peek() == .semi: return false
            dc_methods.push(method)
            dc_method_hooks.push(hook)
            hook = 0
            names.push(int(field.name))
            continue
        if hook != 0: return false
        dn_at += 1
        f = mk(.vardecl, mkpos(dn_file, first.start))
        nodes[f].name = field.name
        typed = dn_accept(.colon)
        if typed:
            outer = dc_pattern_binder
            dc_pattern_binder = int(field.name)
            annotation = dc_annotation()
            dc_pattern_binder = outer
            if annotation == 0: return false
            nodes[f].a = i32(annotation)
        if dn_accept(.assign):
            initial = dc_expr(11)
            # (`speak = () => ...` reads as a method above)
            if initial == 0 or nodes[initial].kind == .lambda: return false
            nodes[f].b = i32(initial)
        else if not typed: return false
        if by_place: add_flag(f, NF_MUT)
        fields.push(f)
        names.push(int(field.name))
    if hook != 0: return false
    set_list(n, fields)
    true



dc_transfer_row = (tag: DewyLexeme) -> bool:
    name = dn_payload(tag)
    if name != "send" and name != "sync" and name != "unsafe": return false
    at = dn_at + 1
    on = true
    if dn_tokens[at].symbol == .assign:
        if name == "unsafe" or dn_tokens[at + 1].kind != .boolean: return false
        on = int(dn_tokens[at + 1].name) == dn_true_id
        at += 2
    next = dn_tokens[at]
    if not (next.symbol == .rbrack or next.kind == .metatag or next.newline): return false
    bit = 0
    if name == "unsafe":
        if next.kind != .metatag and next.symbol != .rbrack: return false
        bit = TRANSFER_UNSAFE
    else if name == "send":
        bit = if on: TRANSFER_SEND_CLAIM else: TRANSFER_SEND_OFF
    else: bit = if on: TRANSFER_SYNC_CLAIM else: TRANSFER_SYNC_OFF
    dc_transfer_bits = dc_transfer_bits | bit
    if bit == TRANSFER_SEND_CLAIM or bit == TRANSFER_SYNC_CLAIM: dc_transfer_at = mkpos(dn_file, tag.start)
    dn_at = at
    true

# The record's transfer tags, as dw_transfer_row records them, once its declaration is read.
dc_transfer_apply = (decl: int):
    if dc_transfer_bits == 0: return
    transfer_tags[decl] = (transfer_tags.get(decl) ?? 0) | dc_transfer_bits
    if dc_transfer_at != 0: transfer_claim_pos[decl] = dc_transfer_at
    dc_transfer_bits = 0
    dc_transfer_at = 0

dc_lifecycle_tag = (token: DewyLexeme) -> int:
    name = dn_payload(token)
    if name == "__drop__": return 1
    if name == "__copy__": return 2
    if name == "__move__": return 3
    0

# `import m`, `import m as n`, `import p"file.dewy"`, `from m import a, b as c` (dw_import); a
# parenthesized selection and the reversed order take the reference grammar.
dc_import = () -> int:
    keyword = dn_take()
    n = mk(.import_, mkpos(dn_file, keyword.start))
    # (`import (a b) from p"x"` is `from p"x" import (a b)`, dw_import)
    imported: int[]
    reversed = keyword.symbol == .kw_import and dn_peek() == .lparen
    if reversed:
        if not dc_import_list(imported) or not dn_accept(.kw_from): return 0
    spec = dn_tokens[dn_at]
    if not dc_import_word(spec): return 0
    dn_at += 1
    value = dn_payload(spec)
    path = dn_tokens[dn_at]
    if dc_word(int(spec.name)) == DC_P and not path.space and path.kind == .quoted:
        if not dc_plain_quote(path): return 0
        text = dn_string(path, true)
        if text == 0: return 0
        value = name_of(int(nodes[text].sval))
        nodes[n].aux2 = 1
        dn_at += 1
    alias = ""
    if dn_accept(.kw_as):
        if not dc_import_word(dn_tokens[dn_at]): return 0
        alias = dn_payload(dn_take())
    nodes[n].sval = i32(intern(value))
    nodes[n].name = i32(intern(strip_ext(file_name(value))))
    if alias != "": nodes[n].name = i32(intern(alias))
    if keyword.symbol == .kw_from or reversed:
        if not reversed and (not dn_accept(.kw_import) or not dc_import_list(imported)): return 0
        nodes[n].aux = 2
        set_list(n, imported)
    else if alias == "" and nodes[n].aux2 == 1: nodes[n].aux = 3
    next = dn_tokens[dn_at]
    if next.kind != .eof and not (next.newline and dn_power(next.symbol) == 0 and next.symbol != .kw_not) and not (next.symbol == .semi and not next.space and not next.newline): return 0
    dn_accept_semi()
    n

# The names an import selects, in order, each with an optional alias: `a, b as c` or `(a b as c)`.
dc_import_list = (imported: mut int[]) -> bool:
    grouped = dn_accept(.lparen)
    loop true:
        word = dn_tokens[dn_at]
        if not dc_import_word(word): return false
        dn_at += 1
        item = mk(.ident, mkpos(dn_file, word.start))
        nodes[item].name = dw_value_name(word.name, nodes[item].pos)
        if dn_accept(.kw_as):
            if not dc_import_word(dn_tokens[dn_at]): return false
            nodes[item].aux = i32(intern(dn_payload(dn_take())))
        imported.push(item)
        if grouped and dn_accept(.rparen): return imported.len() > 0
        if not dn_accept(.comma) and not grouped: return true
    true

# A name an import may bind (not a reserved word or one with a meaning of its own).
dc_import_word = (token: DewyLexeme) -> bool:
    if token.kind != .identifier or token.symbol != .none or dn_reserved(int(token.name)): return false
    name = int(token.name)
    name != dn_end_id and name != dn_new_id and name != dn_type_id and name != dn_none_id and dn_payload(token) != "Cancelled"

# What dw_type_methods records for a declared type: its rows' names (a parent's members are
# inherited), and the methods dc_record_fields read, each a module function taking the object
# first, its bare member names read through that receiver. False: a form left to the reference
# grammar (methods of a type whose members are known only later, a name the frontend renames).
dc_record_members = (struct_: int, names: int[]) -> bool:
    receiver = intern("$self")
    file = pos_file(nodes[struct_].pos)
    types_here = dw_type_members.get(file) ?? {}
    inherited: {int: int} = {}
    parent = int(nodes[struct_].a)
    deferred = false
    if parent != 0 and nodes[parent].kind == .tname:
        parent_name = int(nodes[parent].name)
        if let known = types_here.get(parent_name):
            inherited = known
            deferred = dewy_deferred_here(file, parent_name)
        else: deferred = name_of(parent_name) not in ["error", "exception", "any"]
    else if parent != 0: deferred = true
    methods = dc_methods
    hooks = dc_method_hooks
    dc_methods = []
    dc_method_hooks = []
    members: {int: int} = {}
    if methods.len() > 0:
        loop name, member in inherited: members[name] = receiver
        # (with members still unknown, inherited from another module or a later type, the other
        # names wait for them, dewy_defer_name)
        if deferred: members[dewy_inherited_key()] = struct_
        loop name in names:
            if name_of(name) in ["printl", "print", "int", "bigint", "__dewy_print", "__dewy_int"]: return false
            members[name] = receiver
        loop method in methods:
            loop other in kids(struct_):
                if nodes[other].name == nodes[method].name: return false
        # (every method resolves before any is finished: a retry undoes the nodes only)
        dc_waiting.clear()
        dc_waiting_names.clear()
        dc_waiting_callees.clear()
        loop method in methods:
            dc_scope = members
            reached = dc_reach_fn(method)
            dc_scope = {}
            if not reached: return false
    if deferred: dewy_defer_type(struct_, file)
    loop i in 0.. and waiting in dc_waiting: dewy_defer_name(struct_, waiting, dc_waiting_names[i])
    loop callee in dc_waiting_callees: dewy_defer_callee(callee)
    dc_waiting.clear()
    dc_waiting_names.clear()
    dc_waiting_callees.clear()
    decls: int[]
    extra_names: int[]
    extra_decls: int[]
    made = [struct_]
    k = 0
    loop name in names:
        if k < methods.len() and nodes[methods[k]].name == i32(name):
            method = methods[k]
            label = name_of(name)
            lent = place_method_split(method, receiver, label)
            dw_method_finish(method, struct_, kids2(struct_), receiver)
            if hooks[k] != 0: ownership_declare(struct_, method, hooks[k])
            made.push(method)
            decls.push(method)
            loop extra in lent:
                dw_method_finish(extra, struct_, kids2(struct_), receiver)
                made.push(extra)
                extra_names.push(int(nodes[extra].name))
                extra_decls.push(extra)
            k += 1
        else: decls.push(0)
    row_names = names
    loop i in [0..extra_names.len()):
        row_names.push(extra_names[i])
        decls.push(extra_decls[i])
    first = dewy_methods.len()
    group = dewy_method_group(row_names, decls, inherited)
    dewy_decl_members[struct_] = group
    dewy_decl_methods[struct_] = [first, dewy_methods.len()]
    types_here[int(nodes[struct_].name)] = group
    dw_type_members[file] = types_here
    if methods.len() > 0:
        dewy_type_members[struct_] = group
        dc_made = made
    true



dc_hide = (names: int[]):
    if dc_scope.len() == 0: return
    deferred = dc_scope.has(dewy_inherited_key())
    hidden = deferred
    loop name in names:
        if dc_scope.has(name): hidden = true
    if not hidden: return
    visible: {int: int} = {}
    loop name, receiver in dc_scope:
        if not names.contains(name): visible[name] = receiver
    if deferred:
        loop name in names: visible[name] = 0
    dc_scope = visible

# Resolve member names in n, as the reference projection meets them (dw_value_ident). False: a
# form this does not follow.
dc_reach = (n: int) -> bool:
    if n <= 0: return n == 0
    k = nodes[n].kind
    if k == .ident:
        if let receiver = dc_scope.get(int(nodes[n].name)):
            if receiver != 0:
                field = dw_receiver_field(receiver, nodes[n].name, nodes[n].pos)
                nodes[field].flags = nodes[n].flags
                nodes[n] = nodes[field]
        else if dc_scope.has(dewy_inherited_key()):
            dc_waiting.push(n)
            dc_waiting_names.push(int(nodes[n].name))
        return true
    if k == .int_lit or k == .float_lit or k == .bool_lit or k == .none_lit or k == .hole: return true
    if k == .str_lit:
        loop part in kids(n):
            if nodes[part].kind == .pair and not dc_reach(int(nodes[part].a)): return false
        return true
    if k == .field or k == .not_ or k == .unary or k == .propagate or k == .namedarg: return dc_reach(int(nodes[n].a))
    if k == .call:
        if not dc_reach(int(nodes[n].a)): return false
        callee = int(nodes[n].a)
        if nodes[callee].kind == .field: add_flag(int(nodes[callee].a), NF_MUT)
        if dc_waiting.len() > 0 and dc_waiting[dc_waiting.len() - 1] == callee: dc_waiting_callees.push(callee)
        return dc_reach_all(kids(n))
    if k == .index: return dc_reach(int(nodes[n].a)) and dc_reach_all(kids(n))
    if k == .binary or k == .and_ or k == .or_ or k == .pair: return dc_reach(int(nodes[n].a)) and dc_reach(int(nodes[n].b))
    if k == .coalesce: return dc_reach(int(nodes[n].a)) and dc_reach(int(nodes[n].b)) and dc_reach_type(int(nodes[n].c))
    if k == .cast or k == .istype: return dc_reach(int(nodes[n].a)) and dc_reach_type(int(nodes[n].b))
    if k == .range: return dc_reach(int(nodes[n].a)) and dc_reach(int(nodes[n].b)) and dc_reach(int(nodes[n].c))
    if k == .array or k == .map_lit or k == .record_lit: return dc_reach_all(kids(n))
    if k == .lambda: return dc_reach_fn(n)
    if k == .block:
        saved = dc_scope
        reached = dc_reach_statements(n)
        dc_scope = saved
        return reached
    if k == .if_ or k == .for_ or k == .while_ or k == .loopx: return dc_reach_flow(n)
    if k == .match_: return dc_reach_match(n)
    # (`f<T>(x)`: the callee read as a value, its types as types)
    if k == .typeapply:
        if not dc_reach(int(nodes[n].a)) or not dc_reach_type(int(nodes[n].c)): return false
        loop arg in kids(n):
            if not dc_reach_type(arg): return false
        return true
    false

dc_reach_all = (xs: int[]) -> bool:
    loop x in xs:
        if not dc_reach(x): return false
    true

dc_reach_statements = (block: int) -> bool:
    loop statement in kids(block):
        if not dc_reach_statement(statement): return false
    true

dc_reach_statement = (s: int) -> bool:
    if s <= 0: return false
    k = nodes[s].kind
    if k == .vardecl or k == .const_:
        # (a parameter's value binding, dw_finish_function: never a member)
        if nodes[s].aux2 == 1: return true
        if nkids(s) > 0:
            if not dc_reach(int(nodes[s].b)) or not dc_reach_type(int(nodes[s].a)): return false
            names: int[]
            dc_bound(kids(s), names)
            dc_hide(names)
            return true
        value = int(nodes[s].b)
        if value != 0 and nodes[value].kind == .lambda:
            dc_hide([int(nodes[s].name)])
            return dc_reach_fn(value) and dc_reach_type(int(nodes[s].a))
        if not dc_reach_type(int(nodes[s].a)) or not dc_reach(value): return false
        dc_hide([int(nodes[s].name)])
        return true
    if k == .assign: return dc_reach(int(nodes[s].a)) and dc_reach(int(nodes[s].b))
    if k == .exprstmt or k == .return_: return dc_reach(int(nodes[s].a))
    if k == .break_ or k == .continue_: return true
    if k == .if_ or k == .for_ or k == .while_ or k == .loopx: return dc_reach_flow(s)
    if k == .block: return dc_reach(s)
    false

# The names a pattern binds (dw_bound_names).
dc_bound = (bindings: int[], out: mut int[]):
    loop b in bindings:
        if nodes[b].kind == .tuple: dc_bound(kids(b), out)
        else if nodes[b].kind == .ident: out.push(int(nodes[b].name))

dc_reach_flow = (n: int) -> bool:
    saved = dc_scope
    k = nodes[n].kind
    reached = true
    if k == .for_: reached = dc_reach_in(kids(n), int(nodes[n].a))
    else if k == .loopx: reached = dc_reach_head(int(nodes[n].a))
    else: reached = dc_reach(int(nodes[n].a))
    if not reached or not dc_reach(int(nodes[n].b)): return false
    dc_scope = saved
    dc_reach(int(nodes[n].c))

# `binders in source`: the binders hide members in the body, not in the source (dw_loop_head).
dc_reach_in = (binders: int[], source: int) -> bool:
    before = dc_scope
    names: int[]
    dc_bound(binders, names)
    dc_hide(names)
    inside = dc_scope
    dc_scope = before
    if not dc_reach(source): return false
    dc_scope = inside
    true

dc_reach_head = (h: int) -> bool:
    op = nodes[h].op
    if op == 1: return dc_reach_in(kids(h), int(nodes[h].a))
    if op == 4: return dc_reach(int(nodes[h].a))
    dc_reach_head(int(nodes[h].a)) and dc_reach_head(int(nodes[h].b))

dc_reach_match = (n: int) -> bool:
    if not dc_reach(int(nodes[n].a)): return false
    loop arm in kids(n):
        pattern = kid(arm, 0)
        if nodes[pattern].kind == .pshape or nodes[pattern].kind == .pseq: return false
        if nodes[pattern].kind == .plit and not dc_reach(int(nodes[pattern].a)): return false
        saved = dc_scope
        if nodes[pattern].name != 0: dc_hide([int(nodes[pattern].name)])
        if not dc_reach(int(nodes[arm].b)): return false
        dc_scope = saved
    true

# A function: its result and parameters' types and defaults, its captures, then its body with
# its parameters and captures hiding members (dw_function).
dc_reach_fn = (n: int) -> bool:
    if not dc_reach_type(int(nodes[n].a)): return false
    bound: int[]
    loop p in kids(n):
        if not dc_reach_type(int(nodes[p].a)) or not dc_reach(int(nodes[p].b)): return false
        if nkids(p) > 0: dc_bound(kids(p), bound)
        else if dc_word(int(nodes[p].name)) != DC_HOLE: bound.push(int(nodes[p].name))
    if nodes[n].kind == .lambda:
        captured = kids2(n)
        if has_flag(n, NF_GENERIC):
            captured = []
            if nodes[n].d != 0: captured = kids(int(nodes[n].d))
        loop capture in captured:
            # (a member captured: the reference grammar reads it, dewy_member_captures)
            if let receiver = dc_scope.get(int(nodes[capture].name)):
                if receiver != 0: return false
            bound.push(int(nodes[capture].name))
    saved = dc_scope
    dc_hide(bound)
    reached = dc_reach(int(nodes[n].b))
    dc_scope = saved
    reached

dc_reach_type = (t: int) -> bool:
    if t <= 0: return t == 0
    k = nodes[t].kind
    if k == .tarray: return dc_reach_type(int(nodes[t].a)) and dc_reach(int(nodes[t].b))
    if k == .topt or k == .tptr: return dc_reach_type(int(nodes[t].a))
    if k == .tmap: return dc_reach_type(int(nodes[t].a)) and dc_reach_type(int(nodes[t].b))
    if k == .tname:
        if not dc_reach_type(int(nodes[t].a)): return false
        loop arg in kids(t):
            if not dc_reach_type(arg): return false
        return true
    if k == .tunion or k == .ttuple or k == .tfn:
        if not dc_reach_type(int(nodes[t].a)): return false
        loop arg in kids(t):
            if not dc_reach_type(arg): return false
        return true
    if k == .trecord:
        loop f in kids(t):
            if not dc_reach_type(int(nodes[f].a)): return false
        return true
    # (a refinement's predicate is a value: its binder hides nothing, dw_ref_predicate)
    if k == .trefined: return dc_reach_type(int(nodes[t].a)) and dc_reach(int(nodes[t].b))
    false

# `:>R & no allocates & no blocks`: a function's effect row, atom by atom
# (dw_effect_result and dw_effect_atom read the same atoms in this order).
dc_effect_row = (owner: int) -> bool:
    entries: EffectSyntax[]
    if not dc_effect_entries(entries, false): return false
    effects_active = true
    effect_syntax.push(entries)
    nodes[owner].sval = i32(effect_syntax.len() - 1)
    true

# An effect row's entries from dn_at, each after its `&` (`bare`: the first without one, a
# bundle's `$default_row`); false at a form the reference grammar reads.
dc_effect_entries = (entries: mut EffectSyntax[], bare: bool) -> bool:
    empty = false
    first = bare
    loop first or dn_accept(.amp):
        first = false
        token = dn_tokens[dn_at]
        negative = token.symbol == .kw_not or token.kind == .identifier and token.symbol == .none and int(token.name) == dn_no_id and dn_tokens[dn_at + 1].kind == .identifier
        if negative: dn_at += 1
        atom = dn_tokens[dn_at]
        if atom.kind != .identifier or atom.symbol != .none: return false
        dn_at += 1
        id = int(atom.name)
        word = dc_word(id)
        pos = mkpos(dn_file, atom.start)
        # `reads<x>`, `mutates<grid.cells>`: one place (dw_effect_path)
        if (word == DC_READS or word == DC_MUTATES) and dn_peek() == .langle and not dn_tokens[dn_at].space:
            if empty: return false
            dn_at += 1
            path: int[]
            loop true:
                part = dn_tokens[dn_at]
                if part.kind != .identifier or part.symbol != .none: return false
                path.push(intern(dn_payload(part)))
                dn_at += 1
                if not dn_accept(.dot): break
            if not dn_accept(.rangle):
                if not (dn_edits_on and dn_closer_joined()): return false
                dn_split_closer()
            kind = EffectKind.write
            if word == DC_READS: kind = EffectKind.read
            entries.push(EffectSyntax(kind, path, pos, negative))
            continue
        if dn_peek() == .langle or dn_peek() == .lparen or dn_peek() == .dot or dn_peek() == .lbrack: return false
        if word == DC_NO_EFFECTS:
            if negative or empty or entries.len() != 0: return false
            empty = true
            continue
        if empty: return false
        if negative and (word == DC_READS or word == DC_MUTATES): entries.push(EffectSyntax(if word == DC_READS: EffectKind.read else: EffectKind.write, [], pos, true))
        else if word == DC_ALLOCATES: entries.push(EffectSyntax(.alloc, [], pos, negative))
        else if word == DC_BLOCKS:
            if not negative: return false
            entries.push(EffectSyntax(.block, [], pos, true))
            effect_blocks_demanded = true
        else if word == DC_PANICS:
            if not negative: return false
            entries.push(EffectSyntax(.panic, [], pos, true))
            effect_panics_demanded = true
        else: entries.push(EffectSyntax(.opaque, [id], pos, negative, true))
    true


# `(params):>result => body`, after its opening parenthesis.
# A lambda (a function literal in an expression, dw_function's unnamed function) may list
# `$capture name` and `$capture @name` among its parameters; `bare`, it has one
# parameter name instead of a list (`x => x + 1`, opening that name).
dc_function_literal = (name_id: i32, opening: DewyLexeme, type_params: int[] = [], lambda: bool = false, bare: bool = false) -> int:
    name = name_of(int(name_id))
    n = mk(.fn_, mkpos(dn_file, opening.start))
    if lambda: nodes[n].kind = .lambda
    nodes[n].name = name_id
    if type_params.len() > 0:
        set_list2(n, type_params)
        add_flag(n, NF_GENERIC)
    ps: int[]
    captures: int[]
    bound: {int: bool} = {}
    # (`... by:int64`: a bare `...` ends the positional run; the parameters after it are named
    # only, dewy_param_kinds)
    keyword_only = false
    kinds_at = dc_kinds.len()
    loop true:
        if bare:
            if ps.len() > 0: break
        else if dn_accept(.rparen): break
        first = dn_tokens[dn_at]
        if first.symbol == .ellipsis and not bare and not keyword_only and dn_tokens[dn_at - 1].symbol == .lparen:
            after = dn_tokens[dn_at + 1]
            if after.kind != .identifier or after.symbol != .none or not after.space or dn_tokens[dn_at + 2].symbol != .colon: return 0
            keyword_only = true
            dn_at += 1
            continue
        if lambda and first.kind == .metatag and not bare:
            if dn_payload(first) != "capture": return 0
            dn_at += 1
            place = dn_accept(.at)
            target = dn_tokens[dn_at]
            if target.kind != .identifier or (target.symbol != .none and target.symbol != .kw_test) or dn_reserved(int(target.name)) or dc_word(int(target.name)) == DC_HOLE: return 0
            if bound.has(int(target.name)):
                # (dw_function's mistake; a method's member captures it checks apart)
                if dc_scope.len() == 0: fatal(mkpos(dn_file, target.start), "duplicate parameter binding '{dn_payload(target)}'")
                return 0
            dn_at += 1
            cap = mk(.ident, mkpos(dn_file, target.start))
            nodes[cap].name = dw_value_name(target.name, nodes[cap].pos)
            if place: add_flag(cap, NF_MUT)
            bound[int(target.name)] = true
            captures.push(cap)
            continue
        by_place = not bare and dn_accept(.at)
        parameter = dn_tokens[dn_at]
        p = mk(.param, mkpos(dn_file, first.start))
        pattern = (parameter.symbol == .lbrack or parameter.symbol == .lparen) and not bare and not by_place
        if pattern:
            # `([a b]:array<int64>) => ...`, `((a b):array<int64>) => ...`: the argument unpacked
            # (dw_param's pattern)
            dn_at += 1
            seen: int[]
            close = DewyToken.rbrack
            if parameter.symbol == .lparen: close = .rparen
            binders = dc_binding_items(seen, close)
            if binders.len() == 0 or close == .rparen and binders.len() < 2: return 0
            nodes[p].name = i32(intern("$parameter{p}"))
            set_list(p, binders)
        else:
            if parameter.kind != .identifier or (parameter.symbol != .none and parameter.symbol != .kw_test) or dn_reserved(int(parameter.name)): return 0
            dn_at += 1
            nodes[p].name = parameter.name
        if by_place: add_flag(p, NF_MUT)
        if bare:
            ps.push(p)
            break
        kind = 0
        if keyword_only: kind = 1
        dc_kinds.push(kind)
        if dn_accept(.colon):
            dc_parameter_type = true
            annotation = dc_annotation()
            dc_parameter_type = false
            if annotation == 0: return 0
            nodes[p].a = i32(annotation)
            # (`value:int64 ...`: the positional run ends after this parameter; `...rest` attached
            # is a rest parameter, which dw_function reports)
            if dn_peek() == .ellipsis and not bare:
                after = dn_tokens[dn_at + 1]
                if keyword_only or after.symbol == .assign or not after.space and after.kind == .identifier: return 0
                dn_at += 1
                keyword_only = true
        if dn_accept(.assign):
            initial = dc_expr(11)
            if initial == 0: return 0
            nodes[p].b = i32(initial)
        if pattern:
            loop leaf in binding_leaves(kids(p)):
                if not dc_bind_once(bound, int(nodes[leaf].name)): return dc_duplicate_parameter(leaf, lambda)
        else if not dc_bind_once(bound, int(parameter.name)): return dc_duplicate_parameter(p, lambda and not by_place)
        ps.push(p)
    if name == "main" and (ps.len() > 1 or (ps.len() == 1 and has_flag(ps[0], NF_MUT))): return 0
    if dc_kinds.len() > kinds_at:
        if dc_kinds[dc_kinds.len() - 1] == 1: dewy_param_kinds[n] = dc_kinds[kinds_at..dc_kinds.len())
        dc_kinds.truncate(kinds_at)
    if captures.len() > 0:
        # (a generic function's second list holds its type parameters: its captures are a block)
        if type_params.len() > 0:
            listed = mk(.block, nodes[n].pos)
            set_list(listed, captures)
            nodes[n].d = i32(listed)
        else: set_list2(n, captures)
    if not bare and dn_accept(.returns):
        # (`:> @T`: a method lending a place, its type kept apart, dw_function's place_written)
        if dn_peek() == .at:
            dn_at += 1
            written = dc_annotation(dn_prefix_power(.at, false))
            if written == 0: return 0
            # (`:> @T | Busy`: the other alternatives are written for the reader only)
            loop dn_peek() == .pipe:
                other = dn_tokens[dn_at + 1]
                if other.kind != .identifier or other.symbol != .none or dn_tokens[dn_at + 2].symbol != .pipe and dn_tokens[dn_at + 2].symbol != .function: return 0
                dn_at += 2
            if dn_peek() != .function: return 0
            place_written[n] = written
            dn_edit_at.push(DN_EDIT_BIGINT - n)
            dn_edit_was.push(dn_tokens[dn_at - 1])
        else if dn_tokens[dn_at].kind == .identifier and int(dn_tokens[dn_at].name) == dn_void_id and dn_tokens[dn_at + 1].symbol != .pipe:
            dn_at += 1
            add_flag(n, NF_VOID | NF_WRITTEN_VOID)
        else:
            dc_effects_follow = true
            dc_grouped = 0
            result = dc_annotation(30)
            dc_effects_follow = false
            # (`:>A | B & no_effects` puts the row on the last alternative: an error; `(A | B) & ...`
            # is the row of the whole result)
            if result == 0 or nodes[result].kind == .tunion and result != dc_grouped and dn_peek() == .amp: return 0
            packed = dc_pack(result)
            if packed == result and nodes[packed].kind == .tarray and nodes[packed].ival < 0 and dn_peek() == .amp: return 0
            nodes[n].a = i32(packed)
        if dn_peek() == .amp and not dc_effect_row(n): return 0
    if not dn_accept(.function): return 0
    dc_depth -= 1
    if lambda:
        # (a lambda's statements wait with the enclosing function's, when one is waiting)
        enclosing = dc_defer_result
        if enclosing != 0: dc_defer_result = if nodes[n].a != 0: 2 else: 1
        in_body = dc_fn_body
        dc_fn_body = true
        outer_result = dc_fn_result
        dc_fn_result = if nodes[n].a != 0: 2 else: 1
        saved_map = dc_map_ok
        dc_map_ok = false
        body = dc_operand_body()
        dc_map_ok = saved_map
        dc_fn_result = outer_result
        dc_fn_body = in_body
        dc_defer_result = enclosing
        if body == 0: return 0
        dc_depth -= 2
        return dw_finish_function(n, ps, body, name)
    # (`=> $extern(name='c_name')`: a C function, no body)
    if dn_tokens[dn_at].kind == .metatag and not dc_method_body and dn_payload(dn_tokens[dn_at]) == "extern": return dc_extern(n, ps)
    # (`=> $intrinsic`: the compiler provides it, the declaration binds nothing: dw_intrinsic_check)
    if dn_tokens[dn_at].kind == .metatag and not dc_method_body and type_params.len() == 0 and dc_intrinsic_next():
        next = dn_tokens[dn_at + 1]
        if name == "" or intrinsic_of(intern(name)) < 0 or next.kind != .eof and not (next.newline and dn_power(next.symbol) == 0 and next.symbol != .kw_not): return 0
        dn_at += 1
        dc_nothing = true
        return n
    concrete = type_params.len() == 0
    loop p in ps:
        if nodes[p].a == 0: concrete = false
    body = if concrete and not dc_method_body and (nodes[n].a != 0 or dn_tokens[dn_at].kind == .lazy_body and has_flag(n, NF_VOID)): dc_lazy_body() else: 0
    if body == 0 and dn_tokens[dn_at].kind == .lazy_body: dn_expand_lazy()
    if body == 0:
        dc_defer_result = if nodes[n].a != 0: 2 else: 1
        dc_fn_body = true
        outer_result = dc_fn_result
        dc_fn_result = dc_defer_result
        body = dc_body()
        dc_fn_result = outer_result
        dc_fn_body = false
        dc_defer_result = 0
    if body == 0: return 0
    dc_depth -= 2
    dw_finish_function(n, ps, body, name)

# `$extern`, `$extern(name='c_name' lib='m')` as a module function's body, at its tag (dw_ffi_body,
# dw_extern_finish). A form dw_extern_finish reports takes the reference grammar.
dc_extern = (n: int, ps: int[]) -> int:
    dn_at += 1
    pos = nodes[n].pos
    if has_flag(n, NF_GENERIC) or nodes[n].a == 0 and not has_flag(n, NF_VOID): return 0
    loop p in ps:
        if has_flag(p, NF_MUT) or nodes[p].b != 0 or nodes[p].a == 0 or nkids(p) > 0: return 0
    symbol = ""
    library = ""
    listed_lib = false
    if dn_peek() == .lparen and not dn_tokens[dn_at].space:
        dn_at += 1
        loop not dn_accept(.rparen):
            if not dc_named_next(): return 0
            key = dn_payload(dn_tokens[dn_at])
            value = dn_tokens[dn_at + 2]
            if key != "name" and key != "lib" or value.kind != .quoted or not dc_plain_quote(value): return 0
            dn_at += 3
            source = files[dn_file].src
            width = dn_quote_width(source, value.start, value.stop)
            stop = value.stop - width
            problem = LiteralProblem("", 0, false)
            bytes_: u8[]
            if literal_string_text(problem, bytes_, source, value.start + width, stop) < stop or len(problem.message) > 0 or bytes_.len() == 0: return 0
            text = str_from_bytes(bytes_)
            if key == "name":
                if symbol != "": return 0
                symbol = text
            else:
                if listed_lib: return 0
                listed_lib = true
                library = text
    next = dn_tokens[dn_at]
    if next.kind != .eof and not (next.newline and dn_power(next.symbol) == 0 and next.symbol != .kw_not): return 0
    loop p in ps: dw_ffi_c_types(int(nodes[p].a))
    dw_ffi_c_types(int(nodes[n].a))
    add_flag(n, NF_EXTERN)
    set_list(n, ps)
    attrs: int[]
    if not target_wasm or listed_lib: attrs.push(dw_ffi_attr("lib", bc_str(dw_ffi_library(library), pos), pos))
    if symbol != "": attrs.push(dw_ffi_attr("symbol", bc_str(symbol, pos), pos))
    dw_ffi_attach(n, attrs)
    n

# A parameter binding n repeats one before it: dw_function's mistake, where the parameters are
# certainly a function's (a lambda's, or a declaration's whose `)` meets `=>`, dc_literal_at).
dc_duplicate_parameter = (n: int, certain: bool) -> int:
    if certain or dc_literal_at >= 0 and dc_lambda_next_at(dc_literal_at): fatal(nodes[n].pos, "duplicate parameter binding '{name_of(int(nodes[n].name))}'")
    0

# A parameter's name bound once among the function's (`_` any number of times).
dc_bind_once = (bound: mut {int: bool}, named: int) -> bool:
    if dc_word(named) == DC_HOLE: return true
    if bound.has(named): return false
    bound[named] = true
    true

# Statement contexts are distinct from arguments, parameters and record
# elements. Keep that context at the construction boundary.
dc_statement = () -> int:
    start = dn_at
    token = dn_tokens[dn_at]
    pos = mkpos(dn_file, token.start)
    op = token.symbol
    splice = dc_splice_ok
    dc_splice_ok = false
    if op == .kw_if or op == .kw_loop:
        n = dc_flow()
        if n == 0: return 0
        # (a chain folding to its compiled arm splices that arm's statements into a block that reads
        # it, dc_body_read; elsewhere the reference grammar's block does)
        if dc_live_at == start and op == .kw_if:
            if not splice or dn_peek() == .semi or dc_tagged_last.has(n): return 0
            return n
        add_flag(n, NF_STMT)
        # (`loop c xs.pop();`: what the statement expresses is discarded)
        if dc_accept_semi(not dc_unbraced):
            discard = mk(.block, pos)
            set_list(discard, [n])
            add_flag(discard, NF_DISCARD)
            return discard
        return n
    if op == .kw_match:
        n = dc_flow()
        if n == 0 or dn_peek() == .semi: return 0
        add_flag(n, NF_STMT)
        return dc_flow_stmt(n)
    if op == .kw_parallel:
        dn_at += 1
        n = dc_parallel(token, false)
        if n == 0 or dn_peek() == .semi: return 0
        return n
    if op == .kw_concurrent:
        dn_at += 1
        n = dc_concurrent(token, true)
        if n == 0 or dn_peek() == .semi: return 0
        return n
    if op == .kw_return:
        dn_at += 1
        n = mk(.return_, pos)
        if dn_can_start(dn_tokens, dn_at) and not dn_tokens[dn_at].newline:
            value = dc_expr(0)
            if value == 0: return 0
            nodes[n].a = i32(value)
        dn_accept_semi()
        return n
    if op == .kw_break or op == .kw_continue:
        dn_at += 1
        n = mk(if op == .kw_break: NK.break_ else: NK.continue_, pos)
        if dn_tokens[dn_at].kind == .metatag and not dn_tokens[dn_at].newline:
            nodes[n].name = i32(intern(dn_payload(dn_take())))
        dn_accept_semi()
        return n
    if op == .kw_let or op == .kw_const:
        dn_at += 1
        return dc_declaration(op == .kw_const)
    if token.kind == .identifier and dn_tokens[dn_at + 1].symbol == .colon: return dc_declaration(false, true)
    if token.kind == .metatag:
        if not dc_unsafe_at(dn_at):
            width = token.stop - token.start
            if width == 7 and dn_payload(token) == "expect" or width == 5 and dn_payload(token) == "fail": return dc_expect(token, width == 5)
            if width == 11 and dn_payload(token) == "breakpoint": return dc_breakpoint(token)
            return dc_assertion(token)
        dn_at += 1
        n = dc_statement()
        if n != 0: dc_unsafe_scope(pos)
        return n
    if op == .lparen and dc_update_next():
        update = dc_grouped_update()
        if update == 0 or not dc_flow_ends(): return 0
        return update
    # `[a b] = value`, `(a b) = values`: unpacked into names (dw_stmt's pattern target)
    if (op == .lbrack or op == .lparen) and dn_tokens[dc_closing(dn_at) + 1].symbol == .assign: return dc_unpacking_assignment(op == .lparen, pos)
    # Assignment operands are values rather than binding patterns.
    if token.kind != .identifier or (op != .none and op != .kw_test): return 0
    left = dc_expr(11)
    # (`x => y = 1`: the lambda would be the target, an arm's mistake: dw_arm_fail)
    if left == 0 or nodes[left].kind == .lambda: return 0
    op = dn_peek()
    if op != .assign and not dn_token_assignment(op):
        # (no assignment follows: what was read is the statement's value, as dc_expr(0) reads it)
        dc_value = left
        dc_value_start = start
        return 0
    # (`none = 1`, `void = 1`: a reserved word cannot be bound)
    if op == .assign and (nodes[left].kind == .none_lit or nodes[left].kind == .ident and dn_reserved(int(nodes[left].name))): return 0
    dn_at += 1
    if not dc_fn_body and dc_lambda_next(): return 0
    right = dc_expr(11)
    # (outside a function body, `name = (...) => ...` may declare a module function: a `$target`
    # arm's statements are module declarations, dw_top_declarations)
    if right == 0 or nodes[right].kind == .lambda and not dc_fn_body or dc_inferred_refinement(right): return 0
    n = dc_assign_node(op, left, right, pos)
    dc_accept_semi(not dc_unbraced)
    n

# `nonzero = int64 & ~0` at the top of a module names a refined type (dw_top_declarations), which
# the reference grammar reads.
dc_inferred_refinement = (n: int) -> bool: dc_top_level and nodes[n].kind == .binary and nodes[n].op == i32(int(Tok.amp)) and nodes[int(nodes[n].b)].kind == .not_

# `[a b] = value`, `(a b) = values` (grouped) at its opener: the pattern target's assignment.
dc_unpacking_assignment = (grouped: bool, pos: int) -> int:
    dn_at += 1
    seen: int[]
    close = DewyToken.rbrack
    if grouped: close = .rparen
    binders = dc_binding_items(seen, close)
    if binders.len() == 0 or grouped and binders.len() < 2: return 0
    dn_at += 1
    if dc_lambda_next(): return 0
    right = dc_expr(11)
    if right == 0 or nodes[right].kind == .lambda: return 0
    pattern = mk(.tuple, pos)
    set_list(pattern, binders)
    n = mk(.assign, pos)
    nodes[n].op = i32(int(Tok.assign))
    nodes[n].a = i32(pattern)
    nodes[n].b = i32(right)
    dc_accept_semi(not dc_unbraced)
    n

# `target op= value` (dw_stmt's assignment).
dc_assign_node = (op0: DewyToken, left: int, right: int, pos: int) -> int:
    op = op0
    n = mk(.assign, pos)
    scalar = dn_token_undot(op)
    if scalar != .none:
        add_flag(n, NF_BROADCAST)
        op = scalar
    nodes[n].op = i32(int(dn_assign_tok(op)))
    if op == .and_assign or op == .or_assign: nodes[n].aux2 = 1
    if op == .slash_assign or op == .floor_assign or op == .percent_assign or op == .power_assign:
        nodes[n].sval = i32(intern(if op == .slash_assign: "__dewy_divide" else if op == .floor_assign: "__floor_div" else if op == .percent_assign: "__floor_mod" else: "__dewy_power"))
    nodes[n].a = i32(left)
    nodes[n].b = i32(right)
    n

# `(count += 1)` is next: parentheses holding an update at their top.
dc_update_next = () -> bool:
    close = dc_closing(dn_at)
    if close < 0 or dn_tokens[dn_at + 1].kind != .identifier: return false
    depth = 0
    loop k in [dn_at + 1..close):
        symbol = dn_tokens[k].symbol
        if symbol == .lparen or symbol == .lbrack or symbol == .lbrace: depth += 1
        else if symbol == .rparen or symbol == .rbrack or symbol == .rbrace: depth -= 1
        else if depth == 0 and dn_token_assignment(symbol): return true
    false

# A parenthesized update is the update (dw_stmt's grouped assignment): 0 for one the reference
# grammar reads.
dc_grouped_update = () -> int:
    dn_at += 1
    pos = mkpos(dn_file, dn_tokens[dn_at].start)
    left = dc_expr(11)
    if left == 0 or nodes[left].kind == .lambda: return 0
    op = dn_peek()
    if not dn_token_assignment(op): return 0
    dn_at += 1
    right = dc_expr(11)
    if right == 0 or nodes[right].kind == .lambda or not dn_accept(.rparen): return 0
    dc_assign_node(op, left, right, pos)

# `test "name" { ... }`: another language's test block, which dn_stmt reports.
dc_test_block = (at: int) -> bool:
    token = dn_tokens[at]
    if token.kind == .eof: return false
    next = dn_tokens[at + 1]
    token.symbol == .kw_test and next.space and (next.kind == .quoted or next.kind == .rawquoted) and not next.newline

# An expression as a statement (dw_stmt); with its `;`, its value discarded (at `ended`, where
# the statement starts).
dc_expression_statement = (ended: int, at: int, read: int) -> int:
    value = read
    first = dn_at
    if value == 0: value = dc_expr(0)
    if value == 0 or nodes[value].kind == .lambda or read == 0 and dc_live_at == first and dn_tokens[first].symbol == .kw_if: return 0
    if dn_accept_semi():
        n = mk(.assign, ended)
        nodes[n].op = i32(int(Tok.assign))
        nodes[n].a = i32(mk(.hole, ended))
        nodes[n].b = i32(value)
        return n
    n = mk(.exprstmt, at)
    nodes[n].a = i32(value)
    n

# What follows ends the statement, as it ends the reference grammar's expression.
dc_statement_ends = () -> bool:
    after = dn_tokens[dn_at]
    if after.kind == .eof: return true
    if dn_power(after.symbol) > 0 or after.symbol == .comma or after.symbol == .semi or after.symbol == .dot or after.symbol == .question or after.symbol == .ellipsis or after.symbol == .kw_or_throw or after.symbol == .kw_not: return false
    after.space or after.newline or after.symbol == .rbrace or after.symbol == .rparen or after.symbol == .rbrack

# `$unsafe` opens a boundary over the expression after it, on its line or the next
# (dn_directive): not `$unsafe=false`, a tag alone or one before another tag.
dc_unsafe_at = (at: int) -> bool:
    if dn_tokens[at].kind != .metatag or not dn_edits_on: return false
    token = dn_tokens[at]
    if token.stop - token.start != 7 or dn_payload(token) != "unsafe": return false
    next = dn_tokens[at + 1]
    dn_can_start(dn_tokens, at + 1) and next.symbol != .assign and next.kind != .metatag

dc_unsafe_name = 0

# The `$unsafe` boundary written at `at`, through the last token read (dw_unsafe_scope ends it at
# the operand's last syntax node: nothing lies between). A retry removes it, dn_edits_undo.
dc_unsafe_scope = (at: int):
    if dc_unsafe_name == 0: dc_unsafe_name = intern("unsafe")
    last = dn_tokens[dn_at - 1]
    dc_scope_undoable()
    dir_set(dc_unsafe_name, 1, at, mkpos(dn_file, last.stop - 1), at)

# The setting scopes pushed from here on go if this attempt is retried (dn_edits_undo).
dc_scope_undoable = ():
    dn_edit_at.push(-1 - dir_scopes.len())
    dn_edit_was.push(dn_tokens[dn_at - 1])

# `$setting` or `$setting=true|false` alone as a block's statement: 1 on, 0 off; -1 when it is not
# that (dn_at stays).
dc_block_setting = () -> int:
    at = dn_at + 1
    value = 1
    if dn_tokens[at].symbol == .assign:
        written = dn_tokens[at + 1]
        if written.kind != .boolean: return -1
        if int(written.name) != dn_true_id: value = 0
        at += 2
    next = dn_tokens[at]
    if next.kind != .eof and next.symbol != .rbrace:
        if dn_power(next.symbol) > 0 or next.symbol == .kw_not or next.symbol == .dot or next.symbol == .question or next.symbol == .ellipsis or next.symbol == .semi: return -1
        if not next.space and not next.newline and (next.symbol == .lparen or next.symbol == .lbrack or next.symbol == .langle or next.kind == .quoted or next.kind == .rawquoted): return -1
    dn_at = at
    value

# `$assert condition`, `$runtime_assert condition, message`, or either with its arguments
# listed, `$assert(condition, "message")`: the statement calling the intrinsic, as
# dw_directive makes it. Other directives, settings and labels take the reference grammar.
dc_assertion = (token: DewyLexeme) -> int:
    source = files[dn_file].src
    width = token.stop - token.start - 1
    runtime = width == 14 and dn_matches(source.data(), token.start + 1, token.stop, "runtime_assert")
    if not runtime and not (width == 6 and dn_matches(source.data(), token.start + 1, token.stop, "assert")): return 0
    pos = mkpos(dn_file, token.start)
    dn_at += 1
    next = dn_tokens[dn_at]
    if next.newline or not dn_can_start(dn_tokens, dn_at): return 0
    listed = next.symbol == .lparen and not next.space
    if listed: dn_at += 1
    first = dn_tokens[dn_at].start
    saved = dn_comma_stop
    dn_comma_stop = true
    condition = dc_expr(0)
    stop = dn_tokens[dn_at - 1].stop
    message = 0
    if condition != 0 and dn_accept(.comma):
        written = dn_at
        message = dc_expr(0)
        # (an `$assert` message is a plain string literal: the reference grammar reports others)
        if message != 0 and not runtime and (dn_at != written + 1 or nodes[message].kind != .str_lit or nodes[message].aux != 0): message = 0
        if message == 0: condition = 0
    dn_comma_stop = saved
    if condition == 0 or listed and not dn_accept(.rparen): return 0
    # (`$assert x >? 0;`: the statement ends, its value discarded, dw_stmt's statement end)
    ended = dn_peek() == .semi and dc_accept_semi(not dc_unbraced)
    if not ended and not dc_statement_ends(): return 0
    args = [condition]
    if message != 0: args.push(message)
    else if runtime:
        text = mk(.str_lit, pos)
        nodes[text].sval = i32(intern("assertion failed: " + join(words(source[first..stop)), " ")))
        args.push(text)
    callee = mk(.ident, pos)
    nodes[callee].name = i32(intern(if runtime: "$runtime_assert" else: "$assert"))
    call = mk(.call, pos)
    nodes[call].a = i32(callee)
    set_list(call, args)
    dc_directive_statement(call, pos, ended)

# A directive's call as a statement (dw_stmt): with its `;` (ended), the value discarded.
dc_directive_statement = (call: int, pos: int, ended: bool) -> int:
    if ended:
        n = mk(.assign, pos)
        nodes[n].op = i32(int(Tok.assign))
        nodes[n].a = i32(mk(.hole, pos))
        nodes[n].b = i32(call)
        return n
    n = mk(.exprstmt, pos)
    nodes[n].a = i32(call)
    n

# `$breakpoint` alone (dn_directive's form 3, dw_directive): the call showing the live bindings.
dc_breakpoint = (token: DewyLexeme) -> int:
    pos = mkpos(dn_file, token.start)
    dn_at += 1
    ended = dn_peek() == .semi and dc_accept_semi(not dc_unbraced)
    if not ended and not dc_statement_ends(): return 0
    dc_directive_statement(bc_call("$breakpoint", [], pos), pos, ended)

# `$test`, `$proof`, `$export`, `$shadowable` or `$explicit_allocation_failure` alone at the top of
# a module, marking what follows: its metatag syntax, as dn_atom reads it (dewy_fast_file,
# dw_top_declarations). 0 for any other form.
dc_marker = (token: DewyLexeme) -> int:
    name = dn_payload(token)
    if not (name == "test" or name == "proof" or name == "export" or name == "shadowable" or name == "explicit_allocation_failure"): return 0
    next = dn_tokens[dn_at + 1]
    if next.kind != .eof and not (next.newline and dn_power(next.symbol) == 0 and next.symbol != .kw_not):
        if not next.space or dn_power(next.symbol) > 0 or next.symbol == .kw_not or next.symbol == .semi or next.symbol == .dot or next.symbol == .question or next.symbol == .ellipsis: return 0
    start = dn_at
    dn_expand_lazy()
    dn_at += 1
    id = dn_node(token.kind, name, token.start, name = token.name)
    if dc_compare:
        stop = dn_at
        syntax_start = dewy_syntax.len()
        dn_at = start
        dc_enabled = false
        old = dn_stmt()
        dc_enabled = true
        assert(dn_at == stop)
        if dewy_syntax[old].kind != .metatag or dewy_syntax[old].text != name or dewy_syntax[old].pos != dewy_syntax[id].pos: fatal(mkpos(dn_file, token.start), "direct marker differs")
        dewy_syntax.truncate(syntax_start)
    id

# `$test(cases=…)`, `$export(name='…')` or `$supported_targets = [...]` on a line of its own at the
# top of a module: a compact statement holding what its consumer reads (dw_test_spec's test,
# dw_export_begin's name, dw_supported_targets' names); 0 for any other form, or one they report.
dc_directive_line = (token: DewyLexeme) -> int:
    name = dn_payload(token)
    if name != "test" and name != "export" and name != "supported_targets": return 0
    start = dn_at
    node_start = nodes.len()
    list_start = lists.len()
    pos = mkpos(dn_file, token.start)
    after = dn_tokens[dn_at + 1]
    n = 0
    if name == "supported_targets":
        if after.symbol == .assign:
            dn_at += 2
            n = dc_target_list()
    else if after.symbol == .lparen and not after.space:
        dn_at += 2
        dc_depth = 0
        n = if name == "test": dc_test_cases(pos) else: dc_export_name(pos)
    next = dn_tokens[dn_at]
    if n == 0 or next.kind != .eof and not (next.newline and dn_power(next.symbol) == 0 and next.symbol != .kw_not):
        dn_at = start
        nodes.truncate(node_start)
        lists.truncate(list_start)
        return 0
    if dc_compare:
        stop = dn_at
        syntax_start = dewy_syntax.len()
        node_stop = nodes.len()
        dn_at = start
        dc_enabled = false
        old = dn_stmt()
        dc_enabled = true
        assert(dn_at == stop)
        same = false
        if name == "test": same = dc_same(n, dw_test_spec(dw_test_tag(old)))
        else if name == "export": same = name_of(int(nodes[n].sval)) == (dw_ffi_options(old, "export", ["name"]).get("name") ?? "")
        else:
            list = dw_unwrap(dw_child(old, 2))
            same = dw_nchildren(list) == nkids(n)
            loop i in 0.. and entry in dw_children(list):
                if same and dw_target_literal(entry) != name_of(int(nodes[kid(n, i)].sval)): same = false
        if not same: fatal(pos, "direct directive differs")
        nodes.truncate(node_stop)
        dewy_syntax.truncate(syntax_start)
    id = dn_node(.compact_stmt, "$" + name, token.start)
    dewy_syntax[id].child_left = n
    id

# `$test(` then its cases, through `)` (dw_test_spec): the test, its function still to come.
dc_test_cases = (pos: int) -> int:
    key = dn_tokens[dn_at]
    if key.kind != .identifier or dn_payload(key) != "cases" or dn_tokens[dn_at + 1].symbol != .assign: return 0
    dn_at += 2
    n = mk(.test_, pos)
    nodes[n].aux = 1
    nodes[n].ival = 1
    opening = dn_tokens[dn_at]
    if (opening.symbol == .lparen or opening.symbol == .lbrack) and not dc_range_inside(dn_at):
        dn_at += 1
        close = if opening.symbol == .lparen: DewyToken.rparen else: DewyToken.rbrack
        cases: int[]
        loop not dn_accept(close):
            element = dn_tokens[dn_at]
            if element.kind == .eof or element.symbol == .comma or element.symbol == .semi: return 0
            value = dc_expr(0)
            if value == 0: return 0
            # (`[a=1 b=2]`: the case's arguments by name)
            args = [value]
            if nodes[value].kind == .record_lit and element.symbol == .lbrack:
                args = kids(value)
                loop arg in args:
                    if nodes[arg].kind != .namedarg or nodes[int(nodes[arg].a)].kind == .lambda: return 0
            case = mk(.block, mkpos(dn_file, element.start))
            set_list(case, args)
            cases.push(case)
        if cases.len() == 0: return 0
        set_list(n, cases)
    else:
        value = dc_expr(0)
        if value == 0: return 0
        nodes[n].a = i32(value)
    if not dn_accept(.rparen): return 0
    n

# `$export(` then `name='c_name'` or nothing, through `)` (dw_export_begin): the name as a string.
dc_export_name = (pos: int) -> int:
    text = ""
    loop not dn_accept(.rparen):
        value = dn_tokens[dn_at + 2]
        if not dc_named_next() or dn_payload(dn_tokens[dn_at]) != "name" or text != "" or value.kind != .quoted or not dc_plain_quote(value): return 0
        literal = dn_string(value, true)
        if literal == 0 or nodes[literal].kind != .str_lit or nkids(literal) > 0: return 0
        text = name_of(int(nodes[literal].sval))
        if text == "": return 0
        dn_at += 3
    n = mk(.str_lit, pos)
    nodes[n].sval = i32(intern(text))
    n

# `[...]` of target names after `$supported_targets =` (dw_supported_targets): each a plain string
# literal naming a target.
dc_target_list = () -> int:
    if dn_peek() != .lbrack: return 0
    list = mk(.array, mkpos(dn_file, dn_tokens[dn_at].start))
    dn_at += 1
    names: int[]
    loop not dn_accept(.rbrack):
        token = dn_tokens[dn_at]
        if token.kind != .quoted and token.kind != .rawquoted: return 0
        dn_at += 1
        literal = dn_string(token, true)
        if literal == 0 or dc_target_literal(literal, 0) == "": return 0
        names.push(literal)
    set_list(list, names)
    list

# `$setting`, `$setting=true` or `$setting=false` on a line of its own at the top of a
# module: a compact statement naming the setting (child_right 1 on, 0 off), applied where
# dw_dir_statement applies one read from syntax (dw_top_declarations). Other metatag
# lines (directives, bundle definitions, build settings, markers) take the reference grammar.
# `$name = { $setting  $setting=false  $default_row = <row> }` at a module's top: the bundle
# (dw_dir_define's), defined as it is read; 0 for a form the reference grammar reads or reports.
dc_bundle = (token: DewyLexeme) -> int:
    name = dn_payload(token)
    if dn_tokens[dn_at + 1].symbol != .assign or dn_tokens[dn_at + 2].symbol != .lbrace or dw_dir_known(name): return 0
    if dir_bundle_index(intern(name)) >= 0: return 0
    start = dn_at
    bundle = DirBundle(intern(name), [], [], 0, mkpos(dn_file, token.start), [], [])
    rows = effect_syntax.len()
    blocks = effect_blocks_demanded
    dn_at += 3
    read = true
    loop read and not dn_accept(.rbrace):
        member = dn_tokens[dn_at]
        if member.kind != .metatag: read = false
        else:
            text = dn_payload(member)
            pos = mkpos(dn_file, member.start)
            dn_at += 1
            if text == "default_row":
                if bundle.row != 0 or not dn_accept(.assign): read = false
                else:
                    entries: EffectSyntax[]
                    # (a bundle's row demands what it excludes only where it is applied: dir_apply_rows)
                    saved_demand = effect_panics_demanded
                    read = dc_effect_entries(entries, true)
                    effect_panics_demanded = saved_demand
                    if read:
                        effect_syntax.push(entries)
                        bundle.row = effect_syntax.len() - 1
            else:
                enabled = 1
                if dn_accept(.assign):
                    value = dn_tokens[dn_at]
                    if value.kind != .boolean: read = false
                    else if int(value.name) != dn_true_id: enabled = 0
                    dn_at += 1
                if text == "unsafe" or text == "audited_wait": read = false
                else if text == "explicit_allocation_failure":
                    if enabled != 1: read = false
                    bundle.allocation_failure = true
                # (any other name is a bundle it includes, defined before or after: dir_bundle_resolve)
                else if not dir_builtin(text):
                    if dw_dir_known(text) or enabled != 1: read = false
                    bundle.includes.push(intern(text))
                    bundle.include_at.push(pos)
                else:
                    bundle.settings.push(intern(text))
                    bundle.values.push(enabled)
        next = dn_tokens[dn_at]
        if read and not next.newline and next.symbol != .rbrace: read = false
    next = dn_tokens[dn_at]
    if not read or next.kind != .eof and not next.newline:
        dn_at = start
        effect_syntax.truncate(rows)
        effect_blocks_demanded = blocks
        return 0
    if dc_compare:
        stop = dn_at
        syntax_start = dewy_syntax.len()
        dn_at = start
        dc_enabled = false
        old = dn_stmt()
        dc_enabled = true
        assert(dn_at == stop)
        parts = dw_dir_parts(old)
        made = dir_bundles.len()
        dw_dir_define(name, parts.0, parts.1)
        theirs = dir_bundles[made]
        dir_bundles.truncate(made)
        same = theirs.name == bundle.name and dc_same_ints(theirs.settings, bundle.settings) and dc_same_ints(theirs.values, bundle.values) and theirs.at == bundle.at and dc_same_ints(theirs.includes, bundle.includes) and dc_same_ints(theirs.include_at, bundle.include_at) and theirs.allocation_failure == bundle.allocation_failure and (theirs.row == 0) == (bundle.row == 0)
        if same and bundle.row != 0:
            mine = effect_syntax[bundle.row]
            other = effect_syntax[theirs.row]
            same = mine.len() == other.len()
            loop i in [0..mine.len()):
                if same and (mine[i].kind != other[i].kind or not dc_same_ints(mine[i].path, other[i].path) or mine[i].pos != other[i].pos or mine[i].negative != other[i].negative or mine[i].variable != other[i].variable): same = false
        if not same: fatal(bundle.at, "direct bundle differs")
        dewy_syntax.truncate(syntax_start)
    dir_bundles.push(bundle)
    dn_node(.compact_stmt, "$nothing", token.start)

dc_same_ints = (a: int[], b: int[]) -> bool:
    if a.len() != b.len(): return false
    loop i in [0..a.len()):
        if a[i] != b[i]: return false
    true

dc_setting = (token: DewyLexeme) -> int:
    name = dn_payload(token)
    if dn_directive_form(name) != 0 or name == "realtime" or not dw_dir_name(name): return 0
    at = dn_at + 1
    enabled = 1
    if dn_tokens[at].symbol == .assign:
        value = dn_tokens[at + 1]
        if value.kind != .boolean or value.newline: return 0
        if int(value.name) != dn_true_id: enabled = 0
        at += 2
    next = dn_tokens[at]
    if next.kind != .eof and not (next.newline and dn_power(next.symbol) == 0 and next.symbol != .kw_not and next.symbol != .semi): return 0
    if dc_compare:
        syntax_start = dewy_syntax.len()
        dc_enabled = false
        old = dn_stmt()
        dc_enabled = true
        assert(dn_at == at)
        parts = dw_dir_parts(old)
        if parts.0 == 0 or dewy_syntax[parts.0].text != name or dw_dir_boolean(name, parts.1) != enabled or dewy_syntax[parts.0].pos != mkpos(dn_file, token.start): fatal(mkpos(dn_file, token.start), "direct setting differs")
        dewy_syntax.truncate(syntax_start)
    dn_at = at
    id = dn_node(.compact_stmt, name, token.start)
    dewy_syntax[id].child_right = enabled
    id

dn_statement = (top: bool = false) -> int:
    if not dc_enabled: return dn_stmt()
    if top and dn_tokens[dn_at].kind == .metatag:
        setting = dc_setting(dn_tokens[dn_at])
        if setting != 0: return setting
        marker = dc_marker(dn_tokens[dn_at])
        if marker != 0: return marker
        line = dc_directive_line(dn_tokens[dn_at])
        if line != 0: return line
        bundle = dc_bundle(dn_tokens[dn_at])
        if bundle != 0: return bundle
    # (`$unsafe` then a declaration: its boundary covers the declaration, dw_top_declarations)
    head = dn_at
    if top and dc_unsafe_at(dn_at): dn_at += 1
    start = dn_at
    node_start = nodes.len()
    list_start = lists.len()
    edits = dn_edit_at.len()
    dc_depth = 0
    value = 0
    allocators = dw_allocators
    if top:
        syntax_start = dewy_syntax.len()
        dc_made.clear()
        word = dn_tokens[dn_at].symbol
        # `if $target =? "wasm32" { ... } else { ... }`: the compiled arm's declarations
        if word == .kw_if and dn_tokens[dn_at + 1].kind == .metatag:
            chain = dc_target_chain()
            if chain > 0:
                if head != start: dc_unsafe_scope(mkpos(dn_file, dn_tokens[head].start))
                dn_edits_clear(edits)
                return chain
            dn_at = start
            dewy_syntax.truncate(syntax_start)
        value = if word == .kw_import or word == .kw_from: dc_import() else: dc_type_declaration()
        if value == 0:
            dn_at = start
            nodes.truncate(node_start)
            lists.truncate(list_start)
            dc_depth = 0
            dc_nothing = false
            value = dc_function()
            if dc_nothing:
                dc_nothing = false
                if value == 0 or head != start or dc_deferred_syntax.len() > 0: value = 0
                else: return dc_declares_nothing(head, node_start, list_start, edits)
        if value != 0: dc_project_deferred()
        else:
            dn_edits_undo(edits)
            dn_at = start
            nodes.truncate(node_start)
            lists.truncate(list_start)
            dewy_syntax.truncate(syntax_start)
            dc_deferred_clear()
            dc_made.clear()
            dc_depth = 0
    # (in a block the reference grammar reads, a statement's syntax may be read as syntax: an
    # expression statement or `$unsafe` collects, dw_collect, and ends an arena's value,
    # dw_copy_result)
    if value == 0 and (top or not dc_unsafe_at(start)):
        dc_top_level = top
        value = dc_statement()
        dc_top_level = false
    if value == 0 and top and dn_tokens[start].kind != .metatag and not dc_test_block(start):
        read = 0
        if dc_value_start == start: read = dc_value
        else:
            dn_at = start
            nodes.truncate(node_start)
            lists.truncate(list_start)
            dn_edits_undo(edits)
        dc_depth = 0
        value = dc_expression_statement(mkpos(dn_file, dn_tokens[head].start), mkpos(dn_file, dn_tokens[start].start), read)
    dc_value = 0
    dc_value_start = -1
    if value == 0:
        dn_at = head
        nodes.truncate(node_start)
        lists.truncate(list_start)
        dn_edits_undo(edits)
        dn_expand_lazy()
        dc_fallback(head)
        syntax = dn_stmt()
        if top: dn_edits_clear(edits)
        return syntax
    if head != start: dc_unsafe_scope(mkpos(dn_file, dn_tokens[head].start))
    if dc_compare:
        stop = dn_at
        node_stop = nodes.len()
        list_stop = lists.len()
        syntax_start = dewy_syntax.len()
        dn_at = head
        dn_edits_undo(edits, true)
        methods = dewy_methods.len()
        dc_enabled = false
        old = dn_stmt()
        dc_enabled = true
        assert(dn_at == stop)
        dw_allocators = allocators
        made = if dc_made.len() > 0: dc_made else: [value]
        if top:
            # (a pending `$export`, `$warn_if` or `$proof` marks the retained declaration, not this one)
            saved_export = dw_export_pos
            saved_warn = dw_warn_if_pending
            saved_proof = proof_pending
            dw_export_pos = 0
            dw_warn_if_pending = []
            proof_pending = false
            # (and the discarded projection's lifecycle hooks and member tables)
            saved_hooks = ownership_decls
            saved_roles = ownership_hooks
            saved_members = dewy_type_members
            declarations = dw_top_declarations(old)
            dw_export_pos = saved_export
            dw_warn_if_pending = saved_warn
            proof_pending = saved_proof
            ownership_decls = saved_hooks
            ownership_hooks = saved_roles
            dewy_type_members = saved_members
            if declarations.len() != made.len(): fatal(mkpos(dn_file, dn_tokens[start].start), "direct declaration count differs")
            loop i in [0..made.len()):
                if not dc_same(made[i], declarations[i]): fatal(mkpos(dn_file, dn_tokens[start].start), "direct statement AST differs")
                # (the discarded declaration's type tables)
                dewy_decl_members.remove(declarations[i])
                dewy_decl_methods.remove(declarations[i])
                struct_components.remove(declarations[i])
                transfer_tags.remove(declarations[i])
                transfer_claim_pos.remove(declarations[i])
        else if not dc_same(value, dw_stmt(old)): fatal(mkpos(dn_file, dn_tokens[start].start), "direct statement AST differs")
        dewy_methods.truncate(methods)
        nodes.truncate(node_stop)
        lists.truncate(list_stop)
        dewy_syntax.truncate(syntax_start)
    if top: dn_edits_clear(edits)
    id = dn_node(.compact_stmt, "", dn_tokens[head].start)
    dewy_syntax[id].child_left = value
    if top and dc_made.len() > 0:
        dewy_syntax[id].children = dc_made
        dc_made = []
    id

dc_intrinsic_next = () -> bool: dn_payload(dn_tokens[dn_at]) == "intrinsic"

# A module statement the direct grammar read that declares nothing (`name = (...) => $intrinsic`):
# its nodes go, as the reference grammar's projection makes none.
dc_declares_nothing = (head: int, node_start: int, list_start: int, edits: int) -> int:
    stop = dn_at
    dn_edits_undo(edits)
    nodes.truncate(node_start)
    lists.truncate(list_start)
    if dc_compare:
        syntax_start = dewy_syntax.len()
        dn_at = head
        dc_enabled = false
        old = dn_stmt()
        dc_enabled = true
        assert(dn_at == stop)
        if dw_top_declarations(old).len() != 0: fatal(mkpos(dn_file, dn_tokens[head].start), "direct statement declarations differ")
        dewy_syntax.truncate(syntax_start)
    dn_at = stop
    dn_node(.compact_stmt, "$nothing", dn_tokens[head].start)

# `concurrent { ... }`, `concurrent name { ... }` after its keyword (dw_concurrent): `transparent`, a
# statement. Its statements are read directly, none deferred (a deferred `spawn` would be projected
# outside its group).
dc_concurrent = (token: DewyLexeme, transparent: bool) -> int:
    pos = mkpos(dn_file, token.start)
    # (its hidden names' number: beyond any syntax index, which numbers the reference grammar's)
    serial = (1 << 32) + nodes.len()
    name = "$group{serial}"
    if dn_peek() != .lbrace:
        group = dn_tokens[dn_at]
        if group.kind != .identifier or group.symbol != .none: return 0
        name = dn_payload(group)
        # (the reference grammar places a named group at its name)
        pos = mkpos(dn_file, group.start)
        dn_at += 1
        if dn_peek() != .lbrace: return 0
    dw_task_groups.push(name)
    saved_defer = dc_defer_result
    dc_defer_result = 0
    body = dc_body()
    dc_defer_result = saved_defer
    dw_task_groups.pop()
    if body == 0 or not dc_flow_ends(): return 0
    dw_task_group(pos, name, serial, body, transparent)

# `spawn value`, `spawn(group) value` after its keyword (dw_spawn); `spawn(...)` as a call and
# `spawn` outside a group the direct grammar reads take the reference grammar.
dc_spawn = (token: DewyLexeme) -> int:
    pos = mkpos(dn_file, token.start)
    next = dn_peek()
    if next == .assign or next == .colon: return 0
    g = 0
    if next == .lparen and not dn_tokens[dn_at].space:
        close = dc_closing(dn_at)
        if close < 0: return 0
        after = dn_tokens[close + 1]
        # (`spawn("/bin/sh" [])`: the process API's call, unless one group is followed by a value)
        call = close == dn_at + 1 or not dn_can_start(dn_tokens, close + 1) or after.newline or dn_power(after.symbol) > 0 or after.symbol == .kw_return or after.symbol == .kw_let or after.symbol == .kw_const or after.symbol == .kw_break or after.symbol == .kw_continue
        if not call:
            group_at = dn_at
            node_start = nodes.len()
            list_start = lists.len()
            edits = dn_edit_at.len()
            dn_at += 1
            g = dc_expr(0)
            if g == 0: return 0
            if dn_at != close:
                call = true
                dn_at = group_at
                nodes.truncate(node_start)
                lists.truncate(list_start)
                dn_edits_undo(edits)
        if call:
            callee = mk(.ident, pos)
            nodes[callee].name = dw_value_name(i32(intern("spawn")), pos)
            return callee
        dn_at += 1
    else:
        if dw_task_groups.len() == 0: return 0
        g = bc_ident(dw_task_groups[dw_task_groups.len() - 1], pos)
    value = dc_expr(0)
    if value == 0: return 0
    dw_task_spawn(g, value, pos)

# `$allocator(@arena) expression` after its tag (dw_allocator); an arena not lent by its place, and
# an expression returning from inside, take the reference grammar (which reports them).
dc_allocator = (token: DewyLexeme) -> int:
    pos = mkpos(dn_file, token.start)
    if not dn_accept(.lparen) or dn_peek() != .at: return 0
    arena = dc_expr(0)
    if arena == 0 or not dn_accept(.rparen): return 0
    if not (has_flag(arena, NF_AT) or nodes[arena].kind == .call and (nodes[arena].aux2 == i32(AUX2_PARTIAL) or nodes[arena].aux2 == i32(AUX2_PLACE))): return 0
    dw_allocators += 1
    serial = dw_allocators
    first = dn_at
    body = dc_expr(0)
    if body == 0 or arena_return_at(body) != 0: return 0
    arena_enable()
    # (a braced body's value is its last statement's, dw_copy_result)
    copied = if dn_tokens[first].symbol == .lbrace and dc_closing(first) == dn_at - 1 and nodes[body].kind == .block: dc_copy_last(body) else: dc_copy_value(body)
    dw_arena_scope(serial, arena, body, copied, pos)

# `$lend(@owner reserve=n) body` after its tag (dn_directive's form 4, dw_directive): the call
# lending the owner's bytes to the body.
dc_lend = (token: DewyLexeme) -> int:
    pos = mkpos(dn_file, token.start)
    if not dn_accept(.lparen): return 0
    owner = dc_expr(0)
    if owner == 0: return 0
    reservation = 0
    if dn_tokens[dn_at].kind == .identifier and dn_payload(dn_tokens[dn_at]) == "reserve" and dn_tokens[dn_at + 1].symbol == .assign:
        dn_at += 2
        reservation = dc_expr(0)
        if reservation == 0: return 0
    if not dn_accept(.rparen): return 0
    body = dc_expr(0)
    if body == 0: return 0
    if reservation == 0: reservation = bc_int(0, pos)
    bc_call("$lend", [owner, reservation, body], pos)

# The value is written `....copy()` (dw_copy_result).
dc_copy_value = (n: int) -> bool:
    if nodes[n].kind == .block: return dc_copy_last(n)
    value = n
    if nodes[value].kind == .call: value = int(nodes[value].a)
    nodes[value].kind == .field and name_of(int(nodes[value].name)) == "copy"

dc_copy_last = (block: int) -> bool:
    count = nkids(block)
    if count == 0: return false
    last = kid(block, count - 1)
    nodes[last].kind == .exprstmt and dc_copy_value(int(nodes[last].a))


# A module-level `if` chain testing `$target` or `$build`, after which only the compiled arm's
# declarations exist (dw_target_splice): a flow holding that arm alone, its statements read as
# module statements (dn_statement); the names the other arms use are noted (dw_target_dropped).
# 0 before the compiled arm when a condition does not fold (the reference grammar reads it).
dc_target_chain = () -> int:
    start = dn_tokens[dn_at].start
    live = false
    compiled = 0
    dropped: int[]
    loop true:
        dn_at += 1
        tag = dn_tokens[dn_at]
        if not live and (tag.kind != .metatag or (dn_payload(tag) != "target" and dn_payload(tag) != "build")): return 0
        dc_depth = 0
        condition = dc_expr(0)
        if condition == 0 or not dn_can_start(dn_tokens, dn_at): return 0
        taken = false
        if not live:
            fold = dc_target_fold(condition)
            if fold < 0: return 0
            taken = fold == 1
        if taken:
            if not dc_module_block_next(): return 0
            compiled = dc_module_block()
            live = true
        else:
            dc_target_dropped(condition)
            dc_dropped_reads += 1
            dropped.push(dn_expr(0))
            dc_dropped_reads -= 1
        if not dn_accept(.kw_else): break
        if dn_peek() == .kw_if: continue
        if not live:
            if not dc_module_block_next(): return 0
            compiled = dc_module_block()
        else:
            dc_dropped_reads += 1
            dropped.push(dn_expr(0))
            dc_dropped_reads -= 1
        break
    loop arm in dropped: dw_target_dropped(arm)
    # (the compiled arm, alone: dw_top_declarations splices its declarations, dw_target_live)
    dn_node(.flow, "", start, if compiled != 0: [compiled] else: [])

# A braced arm is next that nothing after its `}` continues but `else` (as an arm's body,
# dn_expr would apply it).
dc_module_block_next = () -> bool:
    if dn_peek() != .lbrace: return false
    close = dc_closing(dn_at)
    if close < 0: return false
    after = dn_tokens[close + 1]
    after.kind == .eof or after.symbol == .kw_else or after.newline and dn_power(after.symbol) == 0 and after.symbol != .kw_not

# `{ ... }` of module statements (dn_bracketed_from's braces), bodies read eagerly.
dc_module_block = () -> int:
    opening = dn_take()
    saved_rows = dn_rows
    dn_rows = false
    saved_lazy = dc_lazy_on
    saved_lib = dc_lib_lazy
    dc_lazy_on = false
    dc_lib_lazy = false
    children: int[]
    loop not dn_accept(.rbrace):
        if dn_tokens[dn_at].kind == .eof: dn_error(opening.start, "expected '{dn_token_text(.rbrace)}' before end of file")
        before = dn_at
        children.push(dn_statement(true))
        if dn_at == before: dn_error(dn_tokens[dn_at].start, "expected a block element")
    dc_lazy_on = saved_lazy
    dc_lib_lazy = saved_lib
    dn_rows = saved_rows
    dn_node(.block, dn_token_text(.lbrace) + dn_token_text(.rbrace) + ":", opening.start, children)

# `$expect condition [, message]`, `$fail [message]` after its tag, a statement (dw_expect). A form
# dw_expect reports, and a condition holding a comparison chain, take the reference grammar.
dc_expect = (token: DewyLexeme, fail: bool) -> int:
    if dc_fn_result != 1: return 0
    pos = mkpos(dn_file, token.start)
    dn_at += 1
    next = dn_tokens[dn_at]
    present = not next.newline and dn_can_start(dn_tokens, dn_at)
    condition = 0
    message = 0
    first = 0
    stop = 0
    described = ""
    saved = dn_comma_stop
    if fail:
        if present:
            dn_comma_stop = true
            message = dc_expr(0)
            dn_comma_stop = saved
            if message == 0: return 0
    else:
        if not present: return 0
        listed = next.symbol == .lparen and not next.space
        if listed: dn_at += 1
        first = dn_at
        chains = dc_chains_made
        dn_comma_stop = true
        condition = dc_expr(0)
        stop = dn_at
        if condition != 0 and dn_accept(.comma):
            message = dc_expr(0)
            if message == 0: condition = 0
        dn_comma_stop = saved
        if condition == 0 or listed and not dn_accept(.rparen) or dc_chains_made != chains: return 0
        source = files[dn_file].src
        described = join(words(source[dn_tokens[first].start..dn_tokens[stop - 1].stop)), " ")
    if not dc_statement_ends(): return 0
    where = pos
    notes = 0
    if condition != 0:
        where = mkpos(dn_file, dn_tokens[first].start)
        notes = dc_expect_notes(condition, first, stop, described, pos)
        if notes == 0: return 0
    else: notes = dw_text("", pos)
    said = message
    if said == 0: said = dw_text("", pos)
    dw_expectation(pos, where, described, said, notes, condition)

# What a failed comparison shows of its operands (dw_expect_notes), the condition read from token
# first up to stop: each place written as a route (`xs.length`, `grid[0 1]`), each other operand
# but a literal as written, with its value read again. 0: an operand not read again.
dc_expect_notes = (condition: int, first: int, stop: int, described: str, pos: int) -> int:
    root = condition
    # (a parenthesized condition, and a `not` before it, are no comparison)
    if dn_tokens[first].symbol == .lparen and dc_closing(first) == stop - 1: return dw_text("", pos)
    if nodes[root].kind == .not_:
        if dn_tokens[first].symbol == .kw_not: return dw_text("", pos)
        root = int(nodes[root].a)
    if nodes[root].kind != .binary: return dw_text("", pos)
    t = Tok(int(nodes[root].op))
    if not (t == .eq or t == .lt or t == .le or t == .gt or t == .ge): return dw_text("", pos)
    # (the comparison's operator, the first outside brackets)
    depth = 0
    at = first
    op = DewyToken.none
    right = 0
    loop at < stop:
        symbol = dn_tokens[at].symbol
        if symbol == .lparen or symbol == .lbrack or symbol == .lbrace: depth += 1
        else if symbol == .rparen or symbol == .rbrack or symbol == .rbrace: depth -= 1
        else if depth == 0:
            if symbol == .kw_not and at + 1 < stop and dn_token_invert(dn_tokens[at + 1].symbol) != .none:
                op = dn_token_invert(dn_tokens[at + 1].symbol)
                right = at + 2
                break
            scalar = dn_token_uninvert(symbol)
            if scalar == .eq or scalar == .lt or scalar == .le or scalar == .gt or scalar == .ge:
                op = symbol
                right = at + 1
                break
        at += 1
    if right == 0 or dc_binary_token(dn_token_uninvert(op)) != t: return 0
    n = mk(.str_lit, pos)
    nodes[n].aux = 1
    pieces: int[]
    texts = dw_comparison_sides(described, dn_token_uninvert(op))
    sides = [int(nodes[root].a), int(nodes[root].b)]
    starts = [first, right]
    loop i in [0..2):
        side = sides[i]
        shown = dc_operand_text(side, starts[i])
        if shown == "" and not dc_literal_operand(side, starts[i]) and texts.len() == 2: shown = texts[i]
        if shown == "": continue
        lead = "note: "
        if pieces.len() > 0: lead = "\nnote: "
        pieces.push(dw_text("{lead}{shown} is ", pos))
        # (read again: the note evaluates its operand anew)
        saved_at = dn_at
        saved_comma = dn_comma_stop
        dn_at = starts[i]
        dn_comma_stop = true
        again = dc_expr(dn_power(op) + 1)
        dn_comma_stop = saved_comma
        dn_at = saved_at
        if again == 0: return 0
        part = mk(.pair, pos)
        nodes[part].a = i32(again)
        nodes[part].sval = -1
        pieces.push(part)
    if pieces.len() == 0: return dw_text("", pos)
    set_list(n, pieces)
    n

# A place's route as written (dw_operand_text): "" for anything else.
dc_operand_text = (n: int, start: int) -> str:
    if dn_tokens[start].kind != .identifier: return ""
    dc_route_text(n)

dc_route_text = (n: int) -> str:
    source = files[dn_file].src
    at = pos_off(nodes[n].pos)
    if source[at] == '(': return ""
    k = nodes[n].kind
    if k == .ident: return dc_word_at(at)
    if k == .field:
        base = dc_route_text(int(nodes[n].a))
        if base != "": return "{base}.{name_of(int(nodes[n].name))}"
        return ""
    if k != .index: return ""
    base = dc_route_text(int(nodes[n].a))
    indices: str[]
    loop entry in kids(n):
        written = pos_off(nodes[entry].pos)
        before = written - 1
        loop before > 0 and (source[before] == ' ' or source[before] == '\t'): before -= 1
        if source[before] == '(' or source[before] == '@': return ""
        if nodes[entry].kind == .int_lit and nodes[entry].aux2 == 0 and is_digit(source[written]): indices.push(dc_word_at(written))
        else:
            inner = dc_route_text(entry)
            if inner == "": return ""
            indices.push(inner)
    if base != "" and indices.len() > 0: return "{base}[{join(indices, " ")}]"
    ""

# The name or number written at offset at.
dc_word_at = (at: int) -> str:
    source = files[dn_file].src
    stop = at
    loop stop < len(source) and (is_alnum(source[stop]) or source[stop] == '_'): stop += 1
    source[at..stop)

# A literal operand (dw_literal_operand): its value is what is written.
dc_literal_operand = (n: int, start: int) -> bool:
    if dn_tokens[start].symbol == .lparen: return false
    dc_literal_node(n)

dc_literal_node = (n: int) -> bool:
    k = nodes[n].kind
    if k == .int_lit or k == .float_lit or k == .bool_lit or k == .none_lit: return true
    if k == .str_lit: return nodes[n].aux == 0
    if k == .call: return nodes[n].aux2 == -1
    if k != .array: return false
    loop item in kids(n):
        if has_flag(item, NF_SPREAD) or not dc_literal_node(item): return false
    true

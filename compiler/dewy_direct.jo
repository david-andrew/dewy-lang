DC_TEST_USAGE = "`$test` takes its cases as `$test(cases=(1 2 3))` or `$test(cases=[[a=1 b=2] [a=3 b=4]])`"

const DC_LAZY_BODY = -314
const DC_SET = 1
const DC_B = 2
const DC_MAIN = 3
const DC_HOLE = 4
const DC_ARRAY = 5
const DC_PTR = 6
const DC_DICT = 7
const DC_TOTALDICT = 8
const DC_ADDR = 9
const DC_NO_EFFECTS = 10
const DC_READS = 11
const DC_MUTATES = 12
const DC_ALLOCATES = 13
const DC_BLOCKS = 14
const DC_PANICS = 15
const DC_LENGTH = 16
const DC_OVERFLOW = 17
const DC_P = 18

# A mistake reported once the whole statement is read: the reading notes it (dc_report) and goes
# on; a module statement or body read through reports the first (dc_flush_report).
dc_report = (pos: int, msg: str):
    rd_dc_report(dc_parser, pos, msg)

dc_flush_report = ():
    rd_dc_flush_report(dc_parser)

# The direct parser reads no form that starts at token `at`: the mistake its readings gave up
# on (dc_hint), else the first noted, else that the form is not read.
dc_unread = (at: int):
    rd_dc_unread(dc_parser, at)

dc_lib_lazy_allowed = (file: int) -> bool:
    prelude_lazy and len(lib_root) > 0 and starts_with(files[file].path, lib_root)

dc_lazy_allowed = (file: int) -> bool:
    when BOOTSTRAP or TARGET != "linux" or ARCH != "x86_64":
        return false
    else:
        if dc_eager or emit_workers() < 2 or shown_warnings.len() > 0: return false
        if len(files[file].src) < 100000 and env("DEWY_EMIT_FORCE") == none: return false
        if (env("DEWY_PCHECK") ?? "") == "0" or (env("DEWY_FUSED") ?? "") == "0": return false
        if target_wasm or target_arm64 or target_windows or target_macos or opt_release or dbg_on or watch_build or repl_image or lower_only or host_ir or ra_stat or len(ra_dump) > 0 or not queue_emit or ide_on or errors_only or test_mode or check_all or len(stop_after) > 0: return false
        true

dn_expand_lazy = ():
    if not dc_parser.reader.dn_lazy_left: return
    k = dc_parser.at
    loop k < dc_parser.tokens.len() and dc_parser.tokens[k].kind != .lazy_body: k += 1
    if k == dc_parser.tokens.len():
        dc_parser.reader.dn_lazy_left = false
        return
    out = dc_parser.tokens[..k)
    saved_comments = dn_block_comments
    loop k < dc_parser.tokens.len():
        t = dc_parser.tokens[k]
        k += 1
        if t.kind != .lazy_body:
            out.push(t)
            continue
        inner = dn_lex(dc_parser.file, t.start, t.stop)
        loop j in [0..inner.len() - 1):
            x = inner[j]
            if j == 0:
                x.space = t.space
                x.newline = t.newline
            out.push(x)
        if k >= dc_parser.tokens.len() or dc_parser.tokens[k].newline: break
    out.extend(dc_parser.tokens[k..dc_parser.tokens.len()))
    dn_block_comments = saved_comments
    dc_parser.tokens = out

dc_force_body = (d: int):
    b = int(nodes[d].b)
    if b == 0 or (nodes[b].aux2 != DC_LAZY_BODY and nodes[b].aux2 != DC_LAZY_SPAN): return
    # (frontend work, whoever asks for the body first)
    icl = ic_mod(IC_LOAD, int(nodes[d].mod))
    saved_tokens = dc_parser.tokens
    saved_at = dc_parser.at
    saved_file = dc_parser.file
    saved_source = dc_parser.source
    saved_depth = dc_parser.depth
    saved_syntax = dc_parser.reader.dewy_syntax
    saved_lib = dc_parser.reader.dc_lib_lazy
    saved_left = dc_parser.reader.dn_lazy_left
    saved_edits_on = dc_parser.reader.dn_edits_on
    edits = dc_parser.reader.dn_edit_at.len()
    dc_parser.reader.dn_edits_on = true
    dc_parser.reader.dc_lib_lazy = false
    dc_parser.reader.dn_lazy_left = false
    dc_parser.file = pos_file(nodes[d].pos)
    dc_parser.source = files[dc_parser.file].src
    first = int(nodes[b].ival)
    if nodes[b].aux2 == DC_LAZY_SPAN:
        saved_comments = dn_block_comments
        dc_parser.tokens = dn_lex(dc_parser.file, first, dc_parser.reader.dc_lazy_span_end[b])
        dn_block_comments = saved_comments
        dc_parser.reader.dc_lazy_span_end.remove(b)
        first = 0
    else: dc_parser.tokens = dc_parser.reader.dc_lazy_tokens[dc_parser.file]
    dc_parser.at = first
    dc_parser.depth = 2
    dc_parser.reader.dewy_syntax = [DewySyntax(.unknown, "", 0, []), DewySyntax(.inverted_comparison, "", 0, [])]
    node_start = nodes.len()
    list_start = lists.len()
    saved_in_body = dc_parser.flags.fn_body
    dc_parser.flags.fn_body = true
    saved_result = dc_parser.reader.dc_fn_result
    dc_parser.reader.dc_fn_result = -1
    reports = dc_parser.status.reports
    saved_now = dc_parser.flags.report_now
    dc_parser.flags.report_now = true
    dc_parser.status.hint_pos = 0
    body = dc_body()
    if body == 0: dc_unread(first)
    dc_parser.flags.report_now = saved_now
    dc_parser.reader.dc_fn_result = saved_result
    dc_parser.flags.fn_body = saved_in_body
    if dc_parser.status.reports != reports: dc_flush_report()
    i = nodes.len() - 1
    loop i >= node_start:
        if nodes[i].kind == .loopx:
            lowered = desugar_loopx(i)
            nodes[i] = nodes[lowered]
        i -= 1
    dir_apply_rows(node_start)
    prefix = kids(b)
    loop st in kids(body): prefix.push(st)
    set_list(body, prefix)
    nodes[b] = nodes[body]
    dc_parser.tokens = saved_tokens
    dc_parser.at = saved_at
    dc_parser.file = saved_file
    dc_parser.source = saved_source
    dc_parser.depth = saved_depth
    dc_parser.reader.dewy_syntax = saved_syntax
    dc_parser.reader.dc_lib_lazy = saved_lib
    dc_parser.reader.dn_lazy_left = saved_left
    dn_edits_clear(edits)
    dc_parser.reader.dn_edits_on = saved_edits_on
    ic_restore(icl)

# A flow body is a statement block even when its braces are omitted. These
# functions participate in the enclosing construction transaction: an unknown
# head, label, declaration or expression is left unread (dc_unread).
dc_body = () -> int:
    rd_dc_body(dc_parser, nodes)

dn_statement = (top: bool = false) -> int:
    rd_dn_statement(dc_parser, nodes, top)

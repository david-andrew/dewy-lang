use 'check.jo'
use 'decimals.jo'
use 'expr.jo'
use 'dewy_methods.jo'
use 'effects.jo'
use 'refine.jo'
use 'x64.jo'
use 'ir.jo'
use 'parse.jo'
use 'ide.jo'
use 'lower.jo'
# Incremental compact-AST construction. A transaction retries the reference
# grammar whenever a contextual or otherwise unmigrated form is reached.
use 'util.jo'
use 'ast.jo'
use 'lex.jo'
use 'dewy_tokens.jo'
use 'dewy_parse.jo'
use 'dewy_fast.jo'
use 'par.jo'
use 'pcheck.jo'
use 'main.jo'
use 'lazy_bodies.jo'
use 'prelude.jo'
use 'icount.jo'
use 'directives.jo'

# DEWY_FRONTEND=old selects the reference path; compare checks every migrated
# value against a fresh legacy parse and projection before retaining its nodes.
# Unmigrated grammar remains on that reference path in all modes.
dc_enabled = true
dc_selected = true     # (DEWY_FRONTEND, read once)
dc_mode_read = false
dc_compare = false
dc_depth = 0
dc_range_top = false       # (the first entry of an index: it may end at a slice's `..`)

# Full lexing retains source positions and names; only closed braced bodies are
# deferred. The marker lives on the block so function instances keep its identity.
const DC_LAZY_BODY = -314
dc_lazy_tokens: {int: DewyLexeme[]}
dc_lazy_on = false
# An imported library module's function bodies wait to be parsed until checking asks for them:
# only the reached ones are (dc_force_body). Nothing waits on them before checking (unlike a
# program's own deferred bodies, no replay, partition or whole-program force needs them; a
# library global that its own functions fill first forces its module: dc_force_module).
dc_lib_lazy = false

dc_lib_lazy_allowed = (file: int) -> bool:
    prelude_lazy and not dc_compare and dc_enabled and len(lib_root) > 0 and starts_with(files[file].path, lib_root)

dc_lazy_allowed = (file: int) -> bool:
    when BOOTSTRAP or TARGET != "linux" or ARCH != "x86_64":
        return false
    else:
        if dc_eager or not dc_enabled or dc_compare or emit_workers() < 2 or shown_warnings.len() > 0: return false
        if len(files[file].src) < 100000 and env("SLOPPY_EMIT_FORCE") == none: return false
        if (env("DEWY_PCHECK") ?? "") == "0" or (env("DEWY_FUSED") ?? "") == "0": return false
        if target_wasm or target_arm64 or target_windows or target_macos or opt_release or dbg_on or watch_build or repl_image or lower_only or host_ir or ra_stat or len(ra_dump) > 0 or not queue_emit or ide_on or errors_only or test_mode or check_all or len(stop_after) > 0: return false
        true

dc_lazy_body = () -> int:
    if dn_tokens[dn_at].kind == .lazy_body:
        t = dn_tokens[dn_at]
        b = mk(.block, mkpos(dn_file, t.start))
        nodes[b].aux2 = DC_LAZY_SPAN
        nodes[b].ival = t.start
        dc_lazy_span_end[b] = t.stop
        dn_at += 1
        return b
    if not (dc_lazy_on or dc_lib_lazy) or dn_tokens[dn_at].symbol != .lbrace: return 0
    start = dn_at
    at = start + 1
    depth = 1
    loop at < dn_tokens.len():
        t = dn_tokens[at]
        if t.symbol == .lbrace: depth += 1
        if t.symbol == .rbrace: depth -= 1
        if depth == 0:
            b = mk(.block, mkpos(dn_file, dn_tokens[start].start))
            nodes[b].aux2 = DC_LAZY_BODY
            nodes[b].ival = start
            dn_at = at + 1
            if dc_lazy_on: dc_lazy_used = true
            return b
        # These can declare names/imports or affect whole-program analysis at
        # parse time. Large/base literals may synthesize a bigint import.
        if t.kind == .metatag or t.kind == .integer or t.kind == .based_string or t.symbol == .function or t.symbol == .kw_import or t.symbol == .kw_from or t.symbol == .coalesce: return 0
        if t.kind == .source_integer and t.stop - t.start > 18: return 0
        # Interpolations can hide declarations, bigint imports or parse warnings.
        if t.kind == .quoted:
            source = files[dn_file].src
            loop i in [t.start..t.stop):
                if source[i] == '{': return 0
        at += 1
    0

# The lazy_body tokens of the declaration at dn_at, lexed (it parses another way, or its body
# does not wait): up to the first that ends a line
dn_lazy_left = false
dn_expand_lazy = ():
    if not dn_lazy_left: return
    k = dn_at
    loop k < dn_tokens.len() and dn_tokens[k].kind != .lazy_body: k += 1
    if k == dn_tokens.len():
        dn_lazy_left = false
        return
    out: DewyLexeme[]
    loop j in [0..k): out.push(dn_tokens[j])
    saved_comments = dn_block_comments
    loop k < dn_tokens.len():
        t = dn_tokens[k]
        k += 1
        if t.kind != .lazy_body:
            out.push(t)
            continue
        inner = dn_lex(dn_file, t.start, t.stop)
        loop j in [0..inner.len() - 1):
            x = inner[j]
            if j == 0:
                x.space = t.space
                x.newline = t.newline
            out.push(x)
        if k >= dn_tokens.len() or dn_tokens[k].newline: break
    loop k < dn_tokens.len():
        out.push(dn_tokens[k])
        k += 1
    dn_block_comments = saved_comments
    dn_tokens = out

dc_force_body = (d: int):
    b = int(nodes[d].b)
    if b == 0 or (nodes[b].aux2 != DC_LAZY_BODY and nodes[b].aux2 != DC_LAZY_SPAN): return
    # (frontend work, whoever asks for the body first)
    icl = ic_mod(IC_LOAD, int(nodes[d].mod))
    saved_tokens = dn_tokens
    saved_at = dn_at
    saved_file = dn_file
    saved_depth = dc_depth
    saved_syntax = dewy_syntax
    saved_lib = dc_lib_lazy
    saved_left = dn_lazy_left
    dc_lib_lazy = false
    dn_lazy_left = false
    dn_file = pos_file(nodes[d].pos)
    first = int(nodes[b].ival)
    if nodes[b].aux2 == DC_LAZY_SPAN:
        saved_comments = dn_block_comments
        dn_tokens = dn_lex(dn_file, first, dc_lazy_span_end[b])
        dn_block_comments = saved_comments
        dc_lazy_span_end.remove(b)
        first = 0
    else: dn_tokens = dc_lazy_tokens[dn_file]
    dn_at = first
    dc_depth = 2
    dewy_syntax = [DewySyntax(), DewySyntax(.inverted_comparison)]
    node_start = nodes.len()
    list_start = lists.len()
    body = dc_body()
    if body == 0:
        nodes.truncate(node_start)
        lists.truncate(list_start)
        dn_at = first
        dc_depth = 2
        body = dw_block(dn_expr(0))
    i = nodes.len() - 1
    loop i >= node_start:
        if nodes[i].kind == .loopx:
            lowered = desugar_loopx(i)
            nodes[i] = nodes[lowered]
        i -= 1
    dir_apply_rows(node_start)
    prefix = kids(b)
    loop st in kids(body): prefix.push(st)
    set_list(body, prefix)
    nodes[b] = nodes[body]
    dn_tokens = saved_tokens
    dn_at = saved_at
    dn_file = saved_file
    dc_depth = saved_depth
    dewy_syntax = saved_syntax
    dc_lib_lazy = saved_lib
    dn_lazy_left = saved_left
    ic_restore(icl)

dc_binary_token = (op: DewyToken) -> Tok:
    match op:
        plus: .plus
        minus: .minus
        star, multiply_apply: .star
        eq: .eq
        lt: .lt
        le: .le
        gt: .gt
        ge: .ge
        shl: .shl
        shr: .shr
        kw_and: .amp
        kw_or: .pipe
        kw_xor: .caret
        _: .eof

dc_binary = (op: DewyToken, left: int, right: int, pos: int) -> int:
    scalar = dn_token_uninvert(op)
    if scalar != op:
        inner = dc_binary(scalar, left, right, pos)
        if inner == 0: return 0
        n = mk(.not_, pos)
        nodes[n].a = i32(inner)
        return n
    if op == .slash or op == .floor or op == .percent or op == .caret:
        name = if op == .slash: "__dewy_divide" else if op == .caret: "__dewy_power" else if op == .floor: "__floor_div" else: "__floor_mod"
        callee = mk(.ident, pos)
        nodes[callee].name = i32(intern(name))
        n = mk(.call, pos)
        nodes[n].a = i32(callee)
        set_list(n, [left, right])
        return n
    token = dc_binary_token(op)
    if token == .eof: return 0
    n = mk(if op == .kw_and: NK.and_ else if op == .kw_or: NK.or_ else: NK.binary, pos)
    nodes[n].op = i32(int(token))
    nodes[n].a = i32(left)
    nodes[n].b = i32(right)
    n

dc_atom = () -> int:
    token = dn_tokens[dn_at]
    op = token.symbol
    pos = mkpos(dn_file, token.start)
    dn_at += 1
    if op == .lparen:
        n = dc_expr(0)
        if n == 0 or not dn_accept(.rparen): return 0
        return n
    # `if c a else b` as a value; loops, `match` and `$target` chains take the reference grammar
    if op == .kw_if:
        dn_at -= 1
        return dc_flow()
    # `@x` selects a place; `@f(a)` partially evaluates f
    if op == .at:
        e = dc_expr(160)
        if e == 0: return 0
        if nodes[e].kind == .call: nodes[e].aux2 = i32(AUX2_PARTIAL)
        else: add_flag(e, NF_MUT | NF_AT)
        return e
    # `[a b c]`: comprehensions, records, dictionaries, spreads and rows take the reference grammar
    if op == .lbrack:
        record = dc_named_next()
        n = mk(if record: NK.record_lit else: NK.array, pos)
        saved = dn_comma_stop
        dn_comma_stop = false
        items: int[]
        loop not dn_accept(.rbrack):
            if dn_tokens[dn_at].kind == .eof: return 0
            # (`[x=1 y=2]`: every row a named field; methods take the reference grammar)
            if record:
                field = dn_tokens[dn_at]
                if not dc_named_next() or dn_reserved(int(field.name)): return 0
                dn_at += 2
                value = dc_expr(11)
                if value == 0: return 0
                entry = mk(.namedarg, mkpos(dn_file, field.start))
                nodes[entry].name = field.name
                nodes[entry].a = i32(value)
                items.push(entry)
                continue
            item = dc_expr(0)
            if item == 0: return 0
            items.push(item)
        dn_comma_stop = saved
        set_list(n, items)
        return n
    if op == .plus or op == .minus or op == .kw_not:
        e = dc_expr(if op == .kw_not: 75 else: 125)
        if e == 0: return 0
        if op == .minus and nodes[e].kind == .int_lit and nodes[e].aux2 == 0:
            if has_flag(e, NF_U64): return 0
            nodes[e].ival = -nodes[e].ival
            nodes[e].pos = pos
            nodes[e].aux2 = 1
            return e
        if op == .minus and nodes[e].kind == .float_lit:
            nodes[e].fval = -nodes[e].fval
            if nodes[e].sval != 0: nodes[e].sval = i32(intern("-" + name_of(int(nodes[e].sval))))
            nodes[e].pos = pos
            return e
        n = mk(if op == .kw_not: NK.not_ else: NK.unary, pos)
        nodes[n].op = i32(int(if op == .minus: Tok.minus else: Tok.plus))
        nodes[n].a = i32(e)
        return n
    if token.kind == .identifier and (op == .none or op == .kw_test):
        name = int(token.name)
        if name == dn_end_id or name == dn_new_id or name == dn_type_id: return 0
        if name == dn_none_id: return mk(.none_lit, pos)
        n = mk(.ident, pos)
        nodes[n].name = dw_value_name(token.name, pos)
        return n
    if token.kind == .quoted or token.kind == .rawquoted: return dn_string(token, true)
    if token.kind == .boolean:
        n = mk(.bool_lit, pos)
        nodes[n].ival = if int(token.name) == dn_true_id: 1 else: 0
        return n
    if token.kind == .source_integer:
        source = files[dn_file].src
        bytes = source.data()
        first = token.start
        if first + 1 < token.stop and bytes[first] == '0' and bytes[first + 1] == 'd': first += 2
        value: u64 = 0
        loop k in [first..token.stop):
            c = bytes[k]
            if c == '_': continue
            digit = u64(c - '0')
            if value > (u64(0x7FFFFFFFFFFFFFFF) - digit) / 10: return 0
            value = value * 10 + digit
        n = mk(.int_lit, pos)
        nodes[n].ival = int(value)
        add_flag(n, NF_LITERAL)
        return n
    if token.kind == .source_real:
        fast = dc_short_real(token)
        if fast != none:
            n = mk(.float_lit, pos)
            nodes[n].fval = fast!
            nodes[n].sval = i32(intern_sub(files[dn_file].src, token.start, token.stop - token.start))
            add_flag(n, NF_LITERAL)
            return n
        number = replace(dn_payload(token), "_", "")
        value = to_float(number)
        if value == none or value! - value! != 0.0: return 0
        n = mk(.float_lit, pos)
        nodes[n].fval = value!
        nodes[n].sval = i32(intern(number))
        add_flag(n, NF_LITERAL)
        return n
    0

# A plain real literal (no base prefix or separators) whose significant digits
# and exponent are exact doubles: one correctly rounded operation, as to_float's
# own fast path computes, without materializing the literal's text.
dc_short_real = (token: DewyLexeme) -> f64?:
    source = files[dn_file].src
    bytes = source.data()
    k = token.start
    stop = token.stop
    if bytes[k] == '0' and k + 1 < stop and bytes[k + 1] == 'd': return none
    mant: u64 = 0
    digits = 0
    zeros = 0
    exp = 0
    point = false
    loop k < stop:
        c = bytes[k]
        if c == '.': point = true
        else if c == 'e' or c == 'E': break
        else if c < '0' or c > '9': return none
        else if digits > 0 or c != '0':
            if digits == 19: return none
            mant = mant * 10 + u64(c - '0')
            digits += 1
            zeros = if c == '0': zeros + 1 else: 0
            if point: exp -= 1
        else if point: exp -= 1
        k += 1
    if k < stop:
        k += 1
        negative = false
        if bytes[k] == '+' or bytes[k] == '-':
            negative = bytes[k] == '-'
            k += 1
        e = 0
        loop k < stop:
            c = bytes[k]
            if c < '0' or c > '9' or e > 1000: return none
            e = e * 10 + int(c - '0')
            k += 1
        exp += if negative: -e else: e
    if digits == 0: return 0.0
    loop zeros > 0:
        mant = mant / 10
        digits -= 1
        zeros -= 1
        exp += 1
    if digits > 15 or exp < -22 or exp > 22: return none
    if exp >= 0: return f64(mant) * __pow10(exp)
    f64(mant) / __pow10(-exp)

dc_expr = (minimum: int) -> int:
    dc_depth += 1
    if dc_depth + dn_depth > 256: return 0
    pos = mkpos(dn_file, dn_tokens[dn_at].start)
    coefficient = dw_integer_kind(dn_tokens[dn_at].kind) or dn_tokens[dn_at].kind == .source_real
    left = dc_atom()
    if left == 0: return 0
    compared = false    # (left is a comparison this loop made)
    loop true:
        token = dn_tokens[dn_at]
        op = token.symbol
        if token.kind == .eof: break
        if token.newline and dn_power(op) == 0 and op != .kw_not: break
        if dn_angles > 0 and (op == .shr or op == .shr_assign or op == .angle_assign or (op == .gt and not token.space)): break
        if not token.space and coefficient and minimum <= 135 and (token.kind == .identifier or op == .lparen):
            right = dc_expr(136)
            if right == 0: return 0
            left = dc_binary(.multiply_apply, left, right, pos)
            coefficient = false
            continue
        if op == .dot and minimum <= 170:
            dn_at += 1
            member = dn_tokens[dn_at]
            if member.kind != .identifier: return 0
            dn_at += 1
            n = mk(.field, pos)
            nodes[n].a = i32(left)
            nodes[n].name = member.name
            dewy_note_member(n)
            left = n
            coefficient = false
            continue
        if not token.space and op == .lparen and minimum <= 170:
            dn_at += 1
            n = mk(.call, pos)
            nodes[n].a = i32(left)
            if nodes[left].kind == .field: add_flag(int(nodes[left].a), NF_MUT)
            if not dc_arguments(n, .rparen): return 0
            left = n
            coefficient = false
            continue
        # `xs[i]`, `Point[x y]`, `Point[x=1 y=2]`; ranges, `end`, `new` and
        # `set[...]` take the reference grammar.
        if not token.space and op == .lbrack and minimum <= 170:
            if nodes[left].kind == .ident and dc_word(int(nodes[left].name)) == DC_SET: return 0
            dn_at += 1
            n = mk(.index, pos)
            nodes[n].a = i32(left)
            # `xs[a..b]`, `xs[a..b)`, `xs[a..]`, `xs[..b)`: one slice
            first_pos = mkpos(dn_file, dn_tokens[dn_at].start)
            first = 0
            if dn_peek() == .rbrack or dc_named_next():
                if not dc_arguments(n, .rbrack): return 0
                if nkids(n) == 1: nodes[n].b = i32(kid(n, 0))
                left = n
                coefficient = false
                continue
            if dn_peek() != .range:
                dc_range_top = true
                first = dc_expr(0)
                dc_range_top = false
                if first == 0: return 0
            if dn_peek() == .range:
                dn_at += 1
                if first == 0 and not dn_range_bound(): return 0
                last = 0
                if dn_range_bound():
                    last = dc_expr(101)
                    if last == 0: return 0
                inclusive = dn_accept(.rbrack)
                if not inclusive and not dn_accept(.rparen): return 0
                range = mk(.range, first_pos)
                nodes[range].a = i32(first)
                nodes[range].b = i32(last)
                if inclusive: add_flag(range, NF_INCLUSIVE)
                set_list(n, [range])
                nodes[n].b = i32(range)
                left = n
                coefficient = false
                continue
            if not dc_arguments(n, .rbrack, first): return 0
            if nkids(n) == 1: nodes[n].b = i32(kid(n, 0))
            left = n
            coefficient = false
            continue
        # `f<T>(x)`: the application as a type, and its arguments again as types
        if not token.space and op == .langle and minimum <= 160:
            name_token = dn_tokens[dn_at - 1]
            if nodes[left].kind != .ident or name_token.kind != .identifier or nodes[left].pos != mkpos(dn_file, name_token.start): return 0
            at = dn_at
            dn_at -= 1
            whole = dc_type_named()
            if whole == 0: return 0
            stop = dn_at
            dn_at = at + 1
            n = mk(.typeapply, pos)
            nodes[n].a = i32(left)
            nodes[n].c = i32(whole)
            args: int[]
            loop not dn_accept(.rangle):
                arg = dc_annotation()
                if arg == 0: return 0
                args.push(arg)
            if dn_at != stop: return 0
            set_list(n, args)
            left = n
            coefficient = false
            continue
        if op == .kw_or_throw and minimum <= 48:
            dn_at += 1
            n = mk(.propagate, pos)
            nodes[n].a = i32(left)
            left = n
            coefficient = false
            continue
        if not token.space and (token.kind == .quoted or token.kind == .rawquoted) and minimum <= 170:
            # (`b'a'`, `b"abc"`: byte literals take the reference grammar)
            if nodes[left].kind == .ident and dc_word(int(nodes[left].name)) == DC_B: return 0
            dn_at += 1
            arg = dn_string(token, true)
            if arg == 0: return 0
            n = mk(.call, pos)
            nodes[n].a = i32(left)
            if nodes[left].kind == .field: add_flag(int(nodes[left].a), NF_MUT)
            set_list(n, [arg])
            left = n
            coefficient = false
            continue
        if op == .kw_not and dn_at + 1 < dn_tokens.len():
            inverted = dn_token_invert(dn_tokens[dn_at + 1].symbol)
            if inverted != .none: op = inverted
        if op == .comma and dn_comma_stop: break
        power = dn_power(op)
        if power == 0 or power < minimum: break
        # (a slice's first bound ends at its `..`; elsewhere a range takes the reference grammar)
        if op == .range:
            if dc_range_top and minimum == 0: break
            return 0
        if (op == .plus or op == .minus) and token.space and not dn_tokens[dn_at + 1].space: break
        # `x is? T`, `x isnt? T`, `x as T`, `x transmute T`: a type on the right
        if token.symbol == op and (op == .is_type or op == .isnt_type or op == .kw_as or op == .kw_transmute):
            if compared and (op == .is_type or op == .isnt_type): return 0
            dn_at += 1
            t = dc_annotation(power)
            if t == 0: return 0
            n = mk(if op == .kw_as or op == .kw_transmute: NK.cast else: NK.istype, pos)
            nodes[n].a = i32(left)
            nodes[n].b = i32(t)
            if op == .kw_transmute: nodes[n].aux2 = 1
            if op == .isnt_type:
                inverted = mk(.not_, pos)
                nodes[inverted].a = i32(n)
                n = inverted
            left = n
            compared = false
            coefficient = false
            continue
        # `a ?? b`: an arithmetic fallback (`a ?? 1 + n`) has a warning of its own
        if op == .coalesce:
            dn_at += 1
            right = dc_expr(power)
            if right == 0 or dc_arithmetic(right): return 0
            n = mk(.coalesce, pos)
            nodes[n].a = i32(left)
            nodes[n].b = i32(right)
            left = n
            compared = false
            coefficient = false
            continue
        if dc_binary_token(dn_token_uninvert(op)) == .eof and op != .slash and op != .floor and op != .percent and op != .caret: return 0
        # (comparison chains take the reference grammar)
        chained = dw_chain_way(dn_token_uninvert(op)) != 2 or dn_token_uninvert(op) == .not_eq
        if chained and compared: return 0
        dn_at += 1
        if token.symbol == .kw_not: dn_at += 1
        right = dc_expr(if op == .caret: power else: power + 1)
        if right == 0: return 0
        left = dc_binary(op, left, right, pos)
        compared = chained
        coefficient = false
    # These suffixes belong to this expression, but have not migrated yet.
    token = dn_tokens[dn_at]
    if not token.space and (token.symbol == .lbrack or token.symbol == .langle or token.kind == .quoted or token.kind == .rawquoted): return 0
    if token.symbol == .question or token.symbol == .ellipsis: return 0
    dc_depth -= 1
    left

dc_arithmetic = (n: int) -> bool:
    k = nodes[n].kind
    if k == .binary:
        op = Tok(int(nodes[n].op))
        return op == .plus or op == .minus or op == .star
    if k == .call and nodes[int(nodes[n].a)].kind == .ident:
        name = name_of(int(nodes[int(nodes[n].a)].name))
        return name == "__dewy_divide" or name == "__floor_div" or name == "__floor_mod" or name == "__dewy_power"
    false

# `name=value` is next (a named argument or a record field).
dc_named_next = () -> bool:
    token = dn_tokens[dn_at]
    token.kind == .identifier and (token.symbol == .none or token.symbol == .kw_test) and dn_tokens[dn_at + 1].symbol == .assign

# Arguments up to the closing bracket, positional or `name=value`.
dc_arguments = (n: int, close: DewyToken, first: int = 0) -> bool:
    args: int[]
    if first != 0: args.push(first)
    loop not dn_accept(close):
        token = dn_tokens[dn_at]
        if token.kind == .eof: return false
        if dc_named_next():
            dn_at += 2
            value = dc_expr(11)
            if value == 0: return false
            named = mk(.namedarg, mkpos(dn_file, token.start))
            nodes[named].name = token.name
            nodes[named].a = i32(value)
            args.push(named)
            continue
        arg = dc_expr(0)
        if arg == 0: return false
        args.push(arg)
    set_list(n, args)
    true

# Compare semantic child links, independent of allocation order. Every scalar
# field in a compact node participates, including flags and source positions.
dc_same = (a: int, b: int) -> bool:
    if a == 0 or b == 0: return a == b
    x = nodes[a]
    y = nodes[b]
    if x.kind != y.kind or x.op != y.op or x.flags != y.flags or x.pos != y.pos or not dc_same_name(int(x.name), int(y.name)) or not (if (x.kind == .fn_ or x.kind == .lambda or x.kind == .tfn) and x.sval != y.sval: dc_same_row(int(x.sval), int(y.sval)) else: dc_same_name(int(x.sval), int(y.sval))) or x.ival != y.ival or f64_bits(x.fval) != f64_bits(y.fval) or x.type != y.type or x.sym != y.sym or x.aux != y.aux or x.aux2 != y.aux2 or x.mod != y.mod: return false
    if not dc_same(int(x.a), int(y.a)) or not dc_same(int(x.b), int(y.b)) or not dc_same(int(x.c), int(y.c)) or not dc_same(int(x.d), int(y.d)): return false
    if nkids(a) != nkids(b) or nkids2(a) != nkids2(b): return false
    loop i in [0..nkids(a)):
        if not dc_same(kid(a, i), kid(b, i)): return false
    loop i in [0..nkids2(a)):
        if not dc_same(kid2(a, i), kid2(b, i)): return false
    true

# A function's effect row, by content (each construction appends its own).
dc_same_row = (a: int, b: int) -> bool:
    if a <= 0 or b <= 0 or a >= effect_syntax.len() or b >= effect_syntax.len(): return false
    x = effect_syntax[a]
    y = effect_syntax[b]
    if x.len() != y.len(): return false
    loop i in [0..x.len()):
        if x[i].kind != y[i].kind or x[i].path != y[i].path or x[i].pos != y[i].pos or x[i].negative != y[i].negative or x[i].variable != y[i].variable: return false
    true

# Hidden names a projection numbers by node or syntax index (`$parameter12`,
# `$dewy_collection_40`) differ only in that number between the two frontends.
dc_same_name = (a: int, b: int) -> bool:
    if a == b: return true
    if a <= 0 or b <= 0: return false
    x = name_of(a)
    y = name_of(b)
    if len(x) == 0 or x[0] != '$': return false
    dc_undigited(x) == dc_undigited(y)

dc_undigited = (text: str) -> str:
    out: u8[]
    loop c in text:
        if not is_digit(c): out.push(c)
    str_from_bytes(out)

dn_value = (minimum: int) -> int:
    # (a bracketed value stays syntax here: `$test(cases=[...])` reads its rows)
    if not dc_enabled or dn_peek() == .lbrack: return dn_expr(minimum)
    start = dn_at
    node_start = nodes.len()
    list_start = lists.len()
    dc_depth = 0
    value = dc_expr(minimum)
    if value == 0:
        dn_at = start
        nodes.truncate(node_start)
        lists.truncate(list_start)
        return dn_expr(minimum)
    if dc_compare:
        stop = dn_at
        node_stop = nodes.len()
        list_stop = lists.len()
        syntax_start = dewy_syntax.len()
        dn_at = start
        dc_enabled = false
        old = dn_expr(minimum)
        dc_enabled = true
        assert(dn_at == stop)
        projected = dw_expr(old)
        if not dc_same(value, projected): fatal(mkpos(dn_file, dn_tokens[start].start), "direct expression AST differs")
        nodes.truncate(node_stop)
        lists.truncate(list_stop)
        dewy_syntax.truncate(syntax_start)
    id = dn_node(.compact_expr, "", dn_tokens[start].start)
    dewy_syntax[id].child_left = value
    id

# Named, generic and optional annotations have a known type context. Other
# type forms retry the reference grammar without mutating angle tokens.
dc_annotation = (boundary: int = 10) -> int:
    dc_depth += 1
    if dc_depth + dn_depth > 256: return 0
    first = dn_tokens[dn_at]
    n = dc_type_primary()
    if n == 0: return 0
    # `a|b|c` joins left to right; a literal member makes a literal type instead.
    loop dn_peek() == .pipe and dn_power(.pipe) > boundary:
        dn_at += 1
        right = dc_type_primary()
        if right == 0: return 0
        union = mk(.tunion, mkpos(dn_file, first.start))
        set_list(union, [n, right])
        n = union
    if dn_power(dn_peek()) > boundary and not (dc_effects_follow and dn_peek() == .amp): return 0
    dc_depth -= 1
    n

# A named type with optional type arguments and `?` suffixes.
dc_type_primary = () -> int:
    token = dn_tokens[dn_at]
    n = dc_type_named()
    if n == 0: return 0
    loop dn_accept(.question):
        optional = mk(.topt, mkpos(dn_file, token.start))
        nodes[optional].a = i32(n)
        n = optional
    next = dn_tokens[dn_at]
    if next.symbol == .dot or next.symbol == .langle or next.symbol == .lbrack or next.symbol == .lparen: return 0
    n

# Names the direct grammar dispatches on, by ID: a type name's compact
# spelling (dw_type_name), cached per name; 0 not yet looked up, -1 a name
# with its own type grammar (effects, `type`, `uint`).
dc_type_spelling: i32[]

# Words the direct grammar dispatches on, classified by name ID on first sight
# (no new names are interned for them).
const DC_SET = 1
const DC_B = 2
const DC_MAIN = 3
const DC_HOLE = 4
const DC_ARRAY = 5
const DC_PTR = 6
const DC_DICT = 7
const DC_TOTALDICT = 8
const DC_ADDR = 9
const DC_NO_EFFECTS = 10
const DC_READS = 11
const DC_MUTATES = 12
const DC_ALLOCATES = 13
const DC_BLOCKS = 14
dc_classes: u8[]

dc_word = (id: int) -> int:
    if id < dc_classes.len() and dc_classes[id] != 0: return int(dc_classes[id]) - 1
    if dc_classes.len() < names.len(): dc_classes.resize(names.len() + 256)
    name = name_of(id)
    words = ["set", "b", "main", "_", "array", "ptr", "dict", "totaldict", "addr", "no_effects", "reads", "mutates", "allocates", "blocks"]
    c = 0
    loop k in [0..words.len()):
        if name == words[k]: c = k + 1
    if id < dc_classes.len(): dc_classes[id] = u8(c + 1)
    c

dc_type_spelled = (id: int) -> int:
    if id < dc_type_spelling.len() and dc_type_spelling[id] != 0: return int(dc_type_spelling[id])
    if dc_type_spelling.len() < names.len(): dc_type_spelling.resize(names.len() + 64)
    name = name_of(id)
    spelled = -1
    if not (name in ["type", "uint", "no_effects", "allocates", "blocks", "reads", "mutates", "no"]):
        mapped = dw_type_name(name)
        spelled = if mapped == name: id else: intern(mapped)
    if id < dc_type_spelling.len(): dc_type_spelling[id] = i32(spelled)
    spelled

dc_type_named = () -> int:
    token = dn_tokens[dn_at]
    if token.kind != .identifier or (token.symbol != .none and token.symbol != .kw_test) or token.name == 0: return 0
    id = int(token.name)
    spelled = dc_type_spelled(id)
    if spelled < 0: return 0
    word = dc_word(id)
    if word == DC_ADDR: refine_active = true
    dn_at += 1
    n = mk(.tname, mkpos(dn_file, token.start))
    nodes[n].name = i32(spelled)
    if not dn_tokens[dn_at].space and dn_accept(.langle):
        args: int[]
        loop not dn_accept(.rangle):
            child = dc_annotation()
            if child == 0: return 0
            args.push(child)
        if word == DC_ARRAY:
            if args.len() != 1: return 0
            nodes[n].kind = .tarray
            nodes[n].name = 0
            nodes[n].a = i32(args[0])
        else if word == DC_PTR:
            if args.len() != 1: return 0
            nodes[n].kind = .tptr
            nodes[n].name = 0
            nodes[n].a = i32(args[0])
        else if word == DC_DICT or word == DC_TOTALDICT:
            if args.len() != 2: return 0
            nodes[n].kind = .tmap
            nodes[n].name = 0
            nodes[n].a = i32(args[0])
            nodes[n].b = i32(args[1])
            if word == DC_TOTALDICT:
                refine_active = true
                nodes[n].aux = 1
        else: set_list(n, args)
    n

dc_declaration = (constant: bool, bare: bool = false) -> int:
    token = dn_tokens[dn_at]
    if token.kind != .identifier or (token.symbol != .none and token.symbol != .kw_test): return 0
    if dn_reserved(int(token.name)): return 0
    dn_at += 1
    n = mk(.vardecl, mkpos(dn_file, token.start))
    nodes[n].name = token.name
    if dn_accept(.colon):
        annotation = dc_annotation()
        if annotation == 0: return 0
        nodes[n].a = i32(annotation)
    if dn_accept(.assign):
        if bare: return 0
        initial = dc_expr(11)
        if initial == 0: return 0
        nodes[n].b = i32(initial)
    else:
        next = dn_tokens[dn_at]
        if constant or dn_power(next.symbol) > 0 or next.symbol == .dot or next.symbol == .question or next.symbol == .ellipsis: return 0
        if not next.space and (next.symbol == .lparen or next.symbol == .lbrack or next.symbol == .langle or next.kind == .quoted or next.kind == .rawquoted): return 0
    if constant:
        value = int(nodes[n].b)
        if dw_const_number(value) or nodes[value].kind == .str_lit or nodes[value].kind == .none_lit: nodes[n].kind = .const_
        else: add_flag(n, NF_RDONLY)
    decimal_let(n)
    dn_accept_semi()
    n

# Inside a directly built module function, a braced statement the direct grammar
# does not cover takes the reference grammar alone; the rest of the function stays
# direct. Its projection waits until the whole declaration is parsed, so projection
# diagnostics follow every parse diagnostic, as on the reference path. The block
# holds a placeholder, -(k + 1) for deferred statement k, until then.
dc_defer_result = 0         # 0 outside such a function; else its dw_fn_result
dc_deferred_syntax: int[]
dc_deferred_block: int[]
dc_deferred_result: int[]

dc_defer_statement = (start: int, node_start: int, list_start: int, block: int) -> int:
    # (settings, labels and `$target` chains belong to the block's own projection)
    if dc_defer_result == 0 or dn_tokens[start].kind == .metatag: return 0
    dn_at = start
    nodes.truncate(node_start)
    lists.truncate(list_start)
    result = dc_defer_result
    dc_defer_result = 0
    saved_depth = dn_depth
    dn_depth = dc_depth
    syntax = dn_stmt()
    dn_depth = saved_depth
    dc_defer_result = result
    if dn_at == start or dw_target_live(syntax) >= 0: return 0
    dc_deferred_syntax.push(syntax)
    dc_deferred_block.push(block)
    dc_deferred_result.push(result)
    0 - dc_deferred_syntax.len()

dc_project_deferred = ():
    loop k in [0..dc_deferred_syntax.len()):
        outer = dw_fn_result
        dw_fn_result = dc_deferred_result[k]
        statement = dw_stmt(dc_deferred_syntax[k])
        dw_fn_result = outer
        block = dc_deferred_block[k]
        loop i in [0..nkids(block)):
            if kid(block, i) == -(k + 1):
                set_kid(block, i, statement)
                break
    dc_deferred_clear()

dc_deferred_clear = (): dc_deferred_truncate(0)

dc_deferred_truncate = (count: int):
    dc_deferred_syntax.truncate(count)
    dc_deferred_block.truncate(count)
    dc_deferred_result.truncate(count)

# A flow body is a statement block even when its braces are omitted. These
# functions participate in the enclosing construction transaction: an unknown
# head, label, declaration or expression retries the reference grammar.
dc_body = () -> int:
    dc_depth += 1
    if dc_depth + dn_depth > 256: return 0
    pos = mkpos(dn_file, dn_tokens[dn_at].start)
    braced = dn_accept(.lbrace)
    n = mk(.block, pos)
    statements: int[]
    loop true:
        if braced and dn_accept(.rbrace): break
        if dn_tokens[dn_at].kind == .eof: return 0
        start = dn_at
        node_start = nodes.len()
        list_start = lists.len()
        depth = dc_depth
        deferred = dc_deferred_syntax.len()
        syntax_start = dewy_syntax.len()
        statement = dc_statement()
        if statement == 0:
            dn_at = start
            nodes.truncate(node_start)
            lists.truncate(list_start)
            dc_deferred_truncate(deferred)
            dewy_syntax.truncate(syntax_start)
            # A failed expression may leave the recursion counter elevated.
            dc_depth = depth
            value = dc_expr(0)
            dc_depth = depth
            if value == 0:
                statement = if braced: dc_defer_statement(start, node_start, list_start, n) else: 0
                if statement == 0: return 0
                statements.push(statement)
                continue
            at = mkpos(dn_file, dn_tokens[start].start)
            if dn_accept_semi():
                statement = mk(.assign, at)
                nodes[statement].op = i32(int(Tok.assign))
                nodes[statement].a = i32(mk(.hole, at))
                nodes[statement].b = i32(value)
            else:
                statement = mk(.exprstmt, at)
                nodes[statement].a = i32(value)
        statements.push(statement)
        if not braced: break
    set_list(n, statements)
    dc_depth -= 1
    n

dc_iterable = () -> int:
    opening = dn_tokens[dn_at]
    # (`loop x in @xs` iterates the live place)
    if opening.symbol == .at: return 0
    bracket = dn_accept(.lbrack)
    first_pos = mkpos(dn_file, dn_tokens[dn_at].start)
    first = dc_expr(if bracket: 101 else: 96)
    if first == 0 or not bracket and dn_power(dn_peek()) > 0: return 0
    if bracket:
        if not dn_accept(.range): return 0
        last = 0
        if dn_range_bound():
            last = dc_expr(101)
            if last == 0: return 0
        inclusive = dn_accept(.rbrack)
        if not inclusive and not dn_accept(.rparen): return 0
        n = mk(.range, first_pos)
        nodes[n].a = i32(first)
        nodes[n].b = i32(last)
        if inclusive: add_flag(n, NF_INCLUSIVE)
        return n
    callee = mk(.ident, mkpos(dn_file, opening.start))
    nodes[callee].name = i32(intern("__dewy_iter"))
    n = mk(.call, mkpos(dn_file, opening.start))
    nodes[n].a = i32(callee)
    set_list(n, [first])
    n

dc_flow = () -> int:
    dc_depth += 1
    if dc_depth + dn_depth > 256: return 0
    token = dn_take()
    if token.symbol != .kw_if and token.symbol != .kw_loop: return 0
    pos = mkpos(dn_file, token.start)
    n = mk(.if_, pos)
    head = 0
    if token.symbol == .kw_loop:
        binder = dn_tokens[dn_at]
        head = mk(.lhead, mkpos(dn_file, binder.start))
        if binder.kind == .identifier and binder.symbol == .none and dn_tokens[dn_at + 1].symbol == .kw_in and not dn_reserved(int(binder.name)):
            dn_at += 2
            value = mk(.ident, mkpos(dn_file, binder.start))
            nodes[value].name = dw_value_name(binder.name, nodes[value].pos)
            set_list(head, [value])
            iterable = dc_iterable()
            if iterable == 0: return 0
            nodes[head].op = 1
            nodes[head].a = i32(iterable)
        else:
            condition = dc_expr(0)
            if condition == 0 or nodes[condition].kind == .and_ or nodes[condition].kind == .or_: return 0
            nodes[head].op = 4
            nodes[head].a = i32(condition)
    else:
        condition = dc_expr(0)
        if condition == 0: return 0
        nodes[n].a = i32(condition)
    if not dn_can_start(): return 0
    body = dc_body()
    if body == 0: return 0
    nodes[n].b = i32(body)
    alternative = 0
    if dn_accept(.kw_else):
        if dn_peek() == .kw_if:
            rest = dc_flow()
            if rest == 0: return 0
            alternative = mk(.block, pos)
            set_list(alternative, [rest])
        else:
            alternative = dc_body()
            if alternative == 0: return 0
        nodes[n].c = i32(alternative)
    if head != 0:
        if alternative != 0:
            nodes[n].kind = .loopx
            nodes[n].a = i32(head)
        else if nodes[head].op == 1:
            nodes[n].kind = .for_
            nodes[n].a = nodes[head].a
            set_list(n, kids(head))
        else:
            nodes[n].kind = .while_
            nodes[n].a = nodes[head].a
    dc_depth -= 1
    n

# Module functions with scalar signatures and migrated bodies need no syntax
# tree. A contextual signature or body retries the full declaration grammar.
dc_function = () -> int:
    token = dn_tokens[dn_at]
    # (`let name = (...) => ...` and `const name = ...` declare a module function too)
    if token.symbol == .kw_let or token.symbol == .kw_const:
        dn_at += 1
        token = dn_tokens[dn_at]
    if token.kind != .identifier or (token.symbol != .none and token.symbol != .kw_test) or dn_reserved(int(token.name)): return 0
    if dn_tokens[dn_at + 1].symbol != .assign or dn_tokens[dn_at + 2].symbol != .lparen: return 0
    dn_at += 2
    # Account for the enclosing assignment, signature and parameter grammar.
    dc_depth += 3
    if dn_tokens[dn_at + 1].symbol != .lparen:
        dn_at += 1
        n = dc_function_literal(token.name, dn_tokens[dn_at - 1])
        if n == 0: return 0
        dn_accept_semi()
        return n
    # `name = ((a:T):>R => ...) & ((b:U):>R => ...)`: an overload group, one
    # declaration per member
    if dc_word(int(token.name)) == DC_MAIN: return 0
    dc_made.clear()
    loop true:
        if not dn_accept(.lparen) or dn_peek() != .lparen: return 0
        dn_at += 1
        dc_depth += if dc_made.len() == 0: 1 else: 2
        n = dc_function_literal(token.name, dn_tokens[dn_at - 1])
        if n == 0 or not dn_accept(.rparen): return 0
        dc_depth -= if dc_made.len() == 0: 1 else: 2
        dc_made.push(n)
        if dn_peek() != .amp: break
        dn_at += 1
    dn_accept_semi()
    dc_made[0]

# `Name:type = [field:T  field:T=default  field=default]`, a record without
# methods, lifecycle tags or type parameters; `Name:type = T|U` an alias.
dc_type_declaration = () -> int:
    token = dn_tokens[dn_at]
    if token.kind != .identifier or (token.symbol != .none and token.symbol != .kw_test) or dn_reserved(int(token.name)): return 0
    if dn_tokens[dn_at + 1].symbol != .colon or dn_tokens[dn_at + 2].kind != .identifier or dn_tokens[dn_at + 2].name != i32(dn_type_id) or dn_tokens[dn_at + 3].symbol != .assign: return 0
    dn_at += 4
    pos = mkpos(dn_file, token.start)
    if dn_peek() != .lbrack:
        alias = dc_annotation()
        if alias == 0 or dn_power(dn_peek()) > 0: return 0
        n = mk(.typealias, pos)
        nodes[n].name = token.name
        nodes[n].a = i32(alias)
        dn_accept_semi()
        return n
    dn_at += 1
    n = mk(.struct_, pos)
    nodes[n].name = token.name
    fields: int[]
    names: int[]
    loop not dn_accept(.rbrack):
        first = dn_tokens[dn_at]
        by_place = dn_accept(.at)
        field = dn_tokens[dn_at]
        if field.kind != .identifier or (field.symbol != .none and field.symbol != .kw_test) or dn_reserved(int(field.name)): return 0
        dn_at += 1
        f = mk(.vardecl, mkpos(dn_file, first.start))
        nodes[f].name = field.name
        typed = dn_accept(.colon)
        if typed:
            annotation = dc_annotation()
            if annotation == 0: return 0
            nodes[f].a = i32(annotation)
        if dn_accept(.assign):
            initial = dc_expr(11)
            if initial == 0: return 0
            nodes[f].b = i32(initial)
        else if not typed: return 0
        if by_place: add_flag(f, NF_MUT)
        fields.push(f)
        names.push(int(field.name))
    if dn_power(dn_peek()) > 0: return 0
    set_list(n, fields)
    dn_accept_semi()
    dc_record_members(n, names)
    n

# What dw_type_methods records for a record without methods.
dc_record_members = (struct_: int, names: int[]):
    intern("$self")
    file = pos_file(nodes[struct_].pos)
    types_here = dw_type_members.get(file) ?? {}
    decls = fill(0, names.len())
    first = dewy_methods.len()
    group = dewy_method_group(names, decls, {})
    dewy_decl_members[struct_] = group
    dewy_decl_methods[struct_] = [first, dewy_methods.len()]
    types_here[int(nodes[struct_].name)] = group
    dw_type_members[file] = types_here

# `:>R & no allocates & no blocks`: a function's effect row, atom by atom
# (dw_effect_result and dw_effect_atom read the same atoms in this order).
dc_effects_follow = false

dc_effect_row = (owner: int) -> bool:
    entries: EffectSyntax[]
    empty = false
    loop dn_accept(.amp):
        token = dn_tokens[dn_at]
        negative = token.symbol == .kw_not or token.kind == .identifier and token.symbol == .none and int(token.name) == dn_no_id and dn_tokens[dn_at + 1].kind == .identifier
        if negative: dn_at += 1
        atom = dn_tokens[dn_at]
        if atom.kind != .identifier or atom.symbol != .none: return false
        dn_at += 1
        if dn_peek() == .langle or dn_peek() == .lparen or dn_peek() == .dot or dn_peek() == .lbrack: return false
        id = int(atom.name)
        word = dc_word(id)
        pos = mkpos(dn_file, atom.start)
        if word == DC_NO_EFFECTS:
            if negative or empty or entries.len() != 0: return false
            empty = true
            continue
        if empty: return false
        if negative and (word == DC_READS or word == DC_MUTATES): entries.push(EffectSyntax(if word == DC_READS: EffectKind.read else: EffectKind.write, [], pos, true))
        else if word == DC_ALLOCATES: entries.push(EffectSyntax(.alloc, [], pos, negative))
        else if word == DC_BLOCKS:
            if not negative: return false
            entries.push(EffectSyntax(.block, [], pos, true))
            effect_blocks_demanded = true
        else: entries.push(EffectSyntax(.opaque, [id], pos, negative, true))
    effects_active = true
    effect_syntax.push(entries)
    nodes[owner].sval = i32(effect_syntax.len() - 1)
    true

# An overload group's declarations, when the last direct declaration was one.
dc_made: int[]

# `(params):>result => body`, after its opening parenthesis.
dc_function_literal = (name_id: i32, opening: DewyLexeme) -> int:
    name = name_of(int(name_id))
    n = mk(.fn_, mkpos(dn_file, opening.start))
    nodes[n].name = name_id
    ps: int[]
    bound: {int: bool} = {}
    loop not dn_accept(.rparen):
        first = dn_tokens[dn_at]
        by_place = dn_accept(.at)
        parameter = dn_tokens[dn_at]
        if parameter.kind != .identifier or (parameter.symbol != .none and parameter.symbol != .kw_test) or dn_reserved(int(parameter.name)): return 0
        dn_at += 1
        p = mk(.param, mkpos(dn_file, first.start))
        nodes[p].name = parameter.name
        if by_place: add_flag(p, NF_MUT)
        if dn_accept(.colon):
            annotation = dc_annotation()
            if annotation == 0: return 0
            nodes[p].a = i32(annotation)
        if dn_accept(.assign):
            initial = dc_expr(11)
            if initial == 0: return 0
            nodes[p].b = i32(initial)
        if dc_word(int(parameter.name)) != DC_HOLE:
            if bound.has(int(parameter.name)): return 0
            bound[int(parameter.name)] = true
        ps.push(p)
    if name == "main" and (ps.len() > 1 or (ps.len() == 1 and has_flag(ps[0], NF_MUT))): return 0
    if dn_accept(.returns):
        if dn_tokens[dn_at].kind == .identifier and int(dn_tokens[dn_at].name) == dn_void_id:
            dn_at += 1
            add_flag(n, NF_VOID)
        else:
            dc_effects_follow = true
            result = dc_annotation(30)
            dc_effects_follow = false
            # (`:>A | B & no_effects` puts the row on the last alternative: an error)
            if result == 0 or nodes[result].kind == .tunion and dn_peek() == .amp: return 0
            nodes[n].a = i32(result)
        if dn_peek() == .amp and not dc_effect_row(n): return 0
    if not dn_accept(.function): return 0
    dc_depth -= 1
    concrete = true
    loop p in ps:
        if nodes[p].a == 0: concrete = false
    body = if concrete and (nodes[n].a != 0 or dn_tokens[dn_at].kind == .lazy_body and has_flag(n, NF_VOID)): dc_lazy_body() else: 0
    if body == 0 and dn_tokens[dn_at].kind == .lazy_body: dn_expand_lazy()
    if body == 0:
        dc_defer_result = if nodes[n].a != 0: 2 else: 1
        body = dc_body()
        dc_defer_result = 0
    if body == 0: return 0
    dc_depth -= 2
    dw_finish_function(n, ps, body, name)

# Statement contexts are distinct from arguments, parameters and record
# elements. Keep that context at the construction boundary.
dc_statement = () -> int:
    token = dn_tokens[dn_at]
    pos = mkpos(dn_file, token.start)
    op = token.symbol
    if op == .kw_if or op == .kw_loop:
        n = dc_flow()
        if n == 0: return 0
        add_flag(n, NF_STMT)
        dn_accept_semi()
        return n
    if op == .kw_return:
        dn_at += 1
        n = mk(.return_, pos)
        if dn_can_start() and not dn_tokens[dn_at].newline:
            value = dc_expr(0)
            if value == 0: return 0
            nodes[n].a = i32(value)
        dn_accept_semi()
        return n
    if op == .kw_break or op == .kw_continue:
        dn_at += 1
        n = mk(if op == .kw_break: NK.break_ else: NK.continue_, pos)
        if dn_tokens[dn_at].kind == .metatag and not dn_tokens[dn_at].newline:
            nodes[n].name = i32(intern(dn_payload(dn_take())))
        dn_accept_semi()
        return n
    if op == .kw_let or op == .kw_const:
        dn_at += 1
        return dc_declaration(op == .kw_const)
    if token.kind == .identifier and dn_tokens[dn_at + 1].symbol == .colon: return dc_declaration(false, true)
    # Assignment operands are values rather than binding patterns.
    if token.kind != .identifier or (op != .none and op != .kw_test): return 0
    left = dc_expr(11)
    if left == 0: return 0
    op = dn_peek()
    if op != .assign and not dn_token_assignment(op): return 0
    # (`none = 1`, `void = 1`: a reserved word cannot be bound)
    if op == .assign and (nodes[left].kind == .none_lit or nodes[left].kind == .ident and dn_reserved(int(nodes[left].name))): return 0
    dn_at += 1
    right = dc_expr(11)
    if right == 0: return 0
    n = mk(.assign, pos)
    scalar = dn_token_undot(op)
    if scalar != .none:
        add_flag(n, NF_BROADCAST)
        op = scalar
    nodes[n].op = i32(int(dn_assign_tok(op)))
    if op == .and_assign or op == .or_assign: nodes[n].aux2 = 1
    if op == .slash_assign or op == .floor_assign or op == .percent_assign or op == .power_assign:
        nodes[n].sval = i32(intern(if op == .slash_assign: "__dewy_divide" else if op == .floor_assign: "__floor_div" else if op == .percent_assign: "__floor_mod" else: "__dewy_power"))
    nodes[n].a = i32(left)
    nodes[n].b = i32(right)
    dn_accept_semi()
    n

dn_statement = (top: bool = false) -> int:
    if not dc_enabled: return dn_stmt()
    start = dn_at
    node_start = nodes.len()
    list_start = lists.len()
    dc_depth = 0
    value = 0
    if top:
        syntax_start = dewy_syntax.len()
        dc_made.clear()
        dn_edits_on = true
        value = dc_type_declaration()
        if value == 0:
            dn_at = start
            nodes.truncate(node_start)
            lists.truncate(list_start)
            dc_depth = 0
            value = dc_function()
        dn_edits_on = false
        if value != 0:
            dc_project_deferred()
            if dc_compare: dn_edits_undo()
            dn_edits_clear()
        else:
            dn_edits_undo()
            dn_at = start
            nodes.truncate(node_start)
            lists.truncate(list_start)
            dewy_syntax.truncate(syntax_start)
            dc_deferred_clear()
            dc_made.clear()
            dc_depth = 0
    if value == 0: value = dc_statement()
    if value == 0:
        dn_at = start
        nodes.truncate(node_start)
        lists.truncate(list_start)
        dn_expand_lazy()
        return dn_stmt()
    if dc_compare:
        stop = dn_at
        node_stop = nodes.len()
        list_stop = lists.len()
        syntax_start = dewy_syntax.len()
        dn_at = start
        methods = dewy_methods.len()
        dc_enabled = false
        old = dn_stmt()
        dc_enabled = true
        assert(dn_at == stop)
        made = if dc_made.len() > 0: dc_made else: [value]
        if top:
            declarations = dw_top_declarations(old)
            if declarations.len() != made.len(): fatal(mkpos(dn_file, dn_tokens[start].start), "direct declaration count differs")
            loop i in [0..made.len()):
                if not dc_same(made[i], declarations[i]): fatal(mkpos(dn_file, dn_tokens[start].start), "direct statement AST differs")
                # (the discarded declaration's type tables)
                dewy_decl_members.remove(declarations[i])
                dewy_decl_methods.remove(declarations[i])
        else if not dc_same(value, dw_stmt(old)): fatal(mkpos(dn_file, dn_tokens[start].start), "direct statement AST differs")
        dewy_methods.truncate(methods)
        nodes.truncate(node_stop)
        lists.truncate(list_stop)
        dewy_syntax.truncate(syntax_start)
    id = dn_node(.compact_stmt, "", dn_tokens[start].start)
    dewy_syntax[id].child_left = value
    if top and dc_made.len() > 0:
        dewy_syntax[id].children = dc_made
        dc_made = []
    id

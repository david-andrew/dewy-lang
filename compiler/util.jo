use 'source_types.dewy'
use 'lazy_bodies.jo'
use 'frontend.jo'
use 'pcheck.jo'
# Shared compiler utilities: string interning, source files, diagnostics.

use 'watch.jo'
use 'ide.jo'
use 'fused.jo'
use 'line_table.dewy'
use 'intern.dewy'

files: SrcFile[]
# the interned names (intern.dewy's table, passed to it by place): each name by id, its hash by
# id, and open addressing over the ids (+1; 0 = empty)
names: str[]
name_hash: int[]
name_tab: i32[]

intern = (s: str) -> int: intern_sub(s, 0, len(s))

# intern s[start..start + n] without allocating unless the name is new (an existing name is
# found by its bytes alone, s not passed beside the table: no reference counting)
intern_sub = (s: str, start: int, n: int) -> int:
    p = data(s) + start
    h = hash_bytes(p, n)
    id = name_find(names, name_hash, name_tab, p, n, h)
    if id >= 0: return id
    intern_new(s, start, n, h)

# (a new name: cut from s unless it is all of s)
intern_new = (s: str, start: int, n: int, h: int) -> int:
    if start == 0 and n == len(s): return name_add(names, name_hash, name_tab, s, h)
    name_add(names, name_hash, name_tab, s[start..start + n), h)

name_of = (id: int) -> str: names[id]

# Whether s is an interned name already, without interning it
name_known = (s: str) -> bool: name_find(names, name_hash, name_tab, data(s), len(s), hash_bytes(data(s), len(s))) >= 0

# position encoding: file index in the high bits, byte offset in the low 40 bits
mkpos = (file: int, off: int) -> int: (file << 40) | off
pos_file = (p: int) -> int: p >> 40
pos_off = (p: int) -> int: p & 0xFFFFFFFFFF

# each file's lines (line_table.dewy)
src_lines: LineTable

line_col = (p: int) -> (int, int):
    f = pos_file(p)
    if f < 0 or f >= files.len(): return (0, 0)
    line_col_in(src_lines, f, pos_off(p), files[f].src)

pos_str = (p: int) -> str:
    f = pos_file(p)
    if f < 0 or f >= files.len(): return "<unknown>"
    l, c = line_col(p)
    "{files[f].path}:{l}:{c}"

source_line = (p: int) -> str:
    f = pos_file(p)
    if f < 0 or f >= files.len(): return ""
    src = files[f].src
    off = pos_off(p)
    a = off
    loop a > 0 and src[a - 1] != '\n': a -= 1
    b = off
    loop b < len(src) and src[b] != '\n': b += 1
    src[a..b)

# what is between the parentheses of the call at p, as written (on one line; "" otherwise):
# assert's message shows the condition that failed
call_args_text = (p: int) -> str:
    f = pos_file(p)
    if p <= 0 or f < 0 or f >= files.len(): return ""
    src = files[f].src
    i = pos_off(p)
    loop i < len(src) and src[i] != '(' and src[i] != '\n': i += 1
    if i >= len(src) or src[i] != '(': return ""
    a = i + 1
    depth = 1
    i += 1
    loop i < len(src) and depth > 0:
        c = src[i]
        if c == '\n': return ""
        if c == '"' or c == '\'':
            q = c
            i += 1
            loop i < len(src) and src[i] != q and src[i] != '\n':
                if src[i] == '\\': i += 1
                i += 1
        else if c == '(' or c == '[': depth += 1
        else if c == ')' or c == ']': depth -= 1
        i += 1
    if depth != 0: return ""
    trim(src[a..i - 1))

# the end of compiling: the process ends (in the interactive prompt, back to it: repl.jo)
stop = (code: int):
    if err_prior.len() > 0 or err_more_note: err_prior_show()
    status = code
    if status == 1: status = error_exit
    when not BOOTSTRAP:
        if status != 0: watch_save_failed_inputs()
        __repl_unwind()
    exit(status)

error_exit = 1              # (the exit status for errors: dewy-core test's is 102, a module that did not build)
quiet_errors = false        # (an error only stops: sloppy fmt in the language server)
# (sloppy build/run/check/test: after an error in a function, this program again without that
# function's body, for the next error; errors_only: such a run, which only checks)
more_errors = false
errors_only = false
err_skips: str[]
err_prior: (int, str)[]        # (the errors the runs before found, and this run's: shown at its end)
err_more_note = false          # (the last run allowed found another error)
shown_warnings: str[]          # (the warnings shown, passed on to the next run: w<place>.<length>)

# p < 0: no source position
# the calls that made the generic instances being checked (innermost last), and their names: an
# error in the library's code inside one is reported at the program's call (lib_root: the library)
err_trail: int[]
err_trail_names: str[]
err_trail_fns: int[]
lib_root = ""

# (extra notes for the next error, each a position (or -1) and its text: why a fact is unproven)
err_notes: (int, str)[]

# `build --time`'s line counts (pl_on): the source lines the compile processes, as the speed yardstick
# counts them. A line is code when it has something besides blanks and comments (`#` to the end of the
# line, `#{ ... }#` nesting): tools/compiler/speed_corpus.py's source_lines, the same count.
pl_on = false
pl_files: int[]                  # the files parsed (counted when the report is made: the instruction split stays clean)
pl_units: int[]                  # library units parsed on their own (prelude.jo): file, start, end
pl_reached: int[]                # lazy library bodies parsed on demand (ensure_body): file, start, end
pl_inst_decls: int[]             # the declaration of each generic instance made

code_lines = (src: str, a: int, b: int) -> int:
    count = 0
    depth = 0
    code = false
    i = a
    loop i < b:
        c = src[i]
        if c == '\n':
            if code: count += 1
            code = false
            i += 1
        else if c == '#' and i + 1 < b and src[i + 1] == 123:
            depth += 1
            i += 2
        else if depth > 0 and c == 125 and i + 1 < b and src[i + 1] == '#':
            depth -= 1
            i += 2
        else if depth > 0: i += 1
        else if c == '#':
            loop i < b and src[i] != '\n': i += 1
        else:
            if c != ' ' and c != '\t' and c != '\r': code = true
            i += 1
    if code: count += 1
    count

pos_in_lib = (p: int) -> bool:
    if p <= 0 or len(lib_root) == 0: return false
    f = pos_file(p)
    f < files.len() and starts_with(files[f].path, lib_root)

# (an error's place and message, moved to the program's call when it is inside the library, and
# the trail entries to note: the calls that made the generic code it is in, innermost first)
err_locate = (p0: int, msg0: str) -> (int, str, int[]):
    p = p0
    msg = msg0
    k = err_trail.len() - 1
    if k >= 0 and pos_in_lib(p):
        loop k >= 0 and (err_trail[k] <= 0 or pos_in_lib(err_trail[k])): k -= 1
        if k >= 0:
            at = pos_str(p)
            if starts_with(at, lib_root): at = "lib" + at[len(lib_root)..]
            msg = "in this call to {err_trail_names[k]}: {msg} ({at})"
            p = err_trail[k]
            k -= 1
    # (in the program's own generic code: the calls that made it, innermost first, as notes)
    notes: int[]
    loop k >= 0 and notes.len() < 4:
        # (a body checked while another is: its chain is on the trail twice)
        seen = false
        loop n in notes: seen = seen or err_trail_fns[n] == err_trail_fns[k]
        if err_trail[k] > 0 and not pos_in_lib(err_trail[k]) and not seen: notes.push(k)
        k -= 1
    (p, msg, notes)

# an error as shown: its line, the calls noted and the extra notes (p >= 0)
err_block = (p: int, msg: str, notes: int[], extra: (int, str)[]) -> str:
    out = "{pos_str(p)}: error: {msg}{line_text(p)}"
    loop n in notes: out += "\n{pos_str(err_trail[n])}: note: in {trail_sig(n)}, called here{line_text(err_trail[n])}"
    loop e in extra:
        if e.0 > 0: out += "\n{pos_str(e.0)}: {e.1}{line_text(e.0)}"
        else: out += "\n    {e.1}"
    out

# (the facts pass decides each function's obligations on its own: while err_held_on, an
# unproven one is held, not shown, and the pass shows all it held in source order at its end)
err_held_on = false
err_held: (int, str)[]

err_hold = (p0: int, msg0: str):
    dc_replay()
    p, msg, notes = err_locate(p0, msg0)
    extra = err_notes
    err_notes = []
    err_held.push((p, err_block(p, msg, notes, extra)))

# the held errors, with the runs' before, in source order, each once; then the compile stops
err_flush = ():
    err_prior = err_prior + err_held
    err_held = []
    err_held_on = false
    stop(1)

err_prior_show = ():
    held = err_prior
    err_prior = []
    loop i in [1..held.len()):
        j = i
        loop j > 0 and held[j - 1].0 > held[j].0:
            t = held[j]
            held[j] = held[j - 1]
            held[j - 1] = t
            j -= 1
    loop i in [0..held.len()):
        if i > 0 and held[i].0 == held[i - 1].0 and held[i].1 == held[i - 1].1: continue
        if i > 0: eprint("")
        eprint(held[i].1)
    if err_more_note:
        err_more_note = false
        eprint("(there may be more errors: these first)")

fatal = (p0: int, msg0: str):
    dc_replay()
    p, msg, notes = err_locate(p0, msg0)
    if quiet_errors: stop(1)
    extra = err_notes
    err_notes = []
    if ide_on:
        loop n in notes: msg += " (in {trail_sig(n)}, called at {pos_str(err_trail[n])})"
        loop e in extra: msg += "; {e.1}"
        ide_fatal(p, msg)
    if err_held_on or err_held.len() > 0:
        # (one with no place shows last)
        if p >= 0: err_held.push((p, err_block(p, msg, notes, extra)))
        else: err_held.push((1 << 62, "error: {msg}"))
        err_flush()
    if p < 0:
        err_prior.push((1 << 62, "error: {msg}"))
        stop(1)
    block = err_block(p, msg, notes, extra)
    if more_errors: next_error_run(p, block)
    err_prior.push((p, block))
    stop(1)

# the source line at p, and a caret under p's column (after a newline), or nothing
line_text = (p: int) -> str:
    line = source_line(p)
    if len(line) == 0: return ""
    l, c = line_col(p)
    caret = ""
    loop i in [0..c - 1):
        if i < len(line) and line[i] == '\t': caret += "\t"
        else: caret += " "
    "\n    {line}\n    {caret}^"

show_line = (p: int):
    t = line_text(p)
    if len(t) > 0: eprint(t[1..])

# (the same warning at the same place once: a generic function checked for each of its types;
# the editor's checks start over each time, so not there)
warned: {str: bool} = {}
warn = (p: int, msg: str):
    # (after an error is held, as the compile would have stopped at it)
    if err_held.len() > 0: return
    # A prechecked library warning belongs after the pending roots. Replay there.
    if pc_prechecking: dc_replay()
    if pc_collect:
        pc_warn_pos.push(p)
        pc_warn_text.push(msg)
        return
    if dc_lazy_used or pc_reordered:
        dc_warning_pos.push(p)
        dc_warning_text.push(msg)
        return
    if fused_on:
        fz_note_text(5, p, msg)
        return
    if ide_on:
        ide_warn(p, msg)
        return
    key = "{p} {msg}"
    if warned.has(key): return
    warned[key] = true
    wk = "w{p}.{len(msg)}"
    if errors_only and shown_warnings.contains(wk): return
    shown_warnings.push(wk)
    eprint("{pos_str(p)}: warning: {msg}")

ice = (msg: str):
    eprint("internal compiler error: {msg}")
    stop(2)

# append src to out with one copy (compiler code must stay compilable by the C bootstrap,
# which lacks the `extend` intrinsic)
append_bytes = (out: mut u8[], src: u8[]):
    n = out.len()
    if src.len() == 0: return
    out.resize(n + src.len())
    mem_copy(data(out) + n, data(src), src.len())

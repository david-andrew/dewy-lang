# Frozen coercion no-op front extracted from expr.jo's coerce.
use 'node_store.dewy'
use 'checker_types.dewy'
use 'type_inference.dewy'
cq_settled = (nodes: *(Node[]), types: *(TypeInfo[]), n: int, t: int) -> bool:
    if t == 0: return true
    if nodes[0][n].type == 0 or int(nodes[0][n].flags) & 256 != 0: return false
    k = nodes[0][n].kind
    if k == .str_lit or k == .float_lit: return false
    to = tu_prune(t)
    if tu_prune(int(nodes[0][n].type)) != to: return false
    tk = types[0][to].kind
    tk != .refined and tk != .callable
struct CheckerCoerceHost:
    rest: (int, int, int) -> bool
cq_coerce_host: *(CheckerCoerceHost)
checker_coerce_bind = (host: *CheckerCoerceHost) -> int:
    cq_coerce_host = host
    0
cq_can_coerce = (n: int, from0: int, to0: int) -> bool:
    from = tu_prune(from0)
    to = tu_prune(to0)
    if from == to: return true
    cq_coerce_host[0].rest(n, from, to)

$runtime_checks

from p"ast.jo" import (kid nkids nodes)
from p"check.jo" import (globals locals)
from p"checked_eval.dewy" import (cx_token_values)
from p"effect_types.dewy" import (PlaceIdentity)
from p"expr.jo" import (IN is_nd ntype)
from p"checks_thin_expr.dewy" import (is_map_type)
from p"facts.jo" import (FACT_CAP FACT_PROJECTION_SCAN FactDifference FactLoop FactPaths FactProjection FactState fact_add_fits fact_add_projection fact_add_value fact_bind fact_capture fact_comparison fact_difference fact_distance fact_domain fact_grown_roots fact_index_put fact_length_max FACT_PREP_CONDITION fact_loop_bound_demands fact_loop_bound_entry fact_loop_bounds fact_loop_exhausted fact_loops fact_new fact_place fact_rebind fact_returns_cache fact_scalar fact_set_bound fact_shortest fact_slice_children fact_speculating fact_summary_owner fact_terms fact_type)
from p"facts_value_queries.dewy" import (fact_binding fact_bound fact_index_get fact_slot)
from p"facts_projection_queries.dewy" import (fact_projection_after fact_projection_find fact_projection_first fact_projection_origin)
from p"facts_row_queries.dewy" import (fact_difference_head fact_difference_next fact_incident fact_row_find)
from p"facts_arith.dewy" import (fact_preread_local)
from p"facts_routes.dewy" import (fact_read)
from p"facts_changes.dewy" import (fact_changes)
from p"facts_conditions.dewy" import (fact_condition fact_loop_stable_implications)
from p"facts_joins.dewy" import (fact_field_node fact_hull fact_hull_type fact_join fact_join_grown fact_join_payload fact_known_none fact_projection_value)
from p"facts_pools.dewy" import (fact_pool_type)
from p"facts_summaries.dewy" import (fact_summary_payload)
from p"facts_text.dewy" import (fact_string_call)
from p"nd_contracts.jo" import (ND_STORAGE_VALID)
from p"nd_contract_ops.dewy" import (fact_nd_valid_held)
from p"proofs.jo" import (ResultEvidence)
from p"refine.jo" import (ref_interval refine_active representation_type)
from p"refinement_types.dewy" import (FACT_MAX FACT_MIN FactBound FactTerm)
from p"types.jo" import (T_INT tkind types)

LoopWord:type=int64<overflow='wrap'>
# a - b <= limit, from rows or from the two intervals.
fact_entails=(s:FactState a:LoopWord b:LoopWord limit:LoopWord):>bool=>{
    if fact_distance(s a b limit) {return true}
    let x=fact_bound(s a)
    let y=fact_bound(s b)
    not x.wide and not y.wide and y.lo not=? FACT_MIN and fact_add_fits(x.hi (-y.lo)) and x.hi - y.lo <=? limit
}
# A non-element projection of an immutable entry value (a snapshot's length,
# say) first read in the body names the same evaluation at entry. Copy it
# there at its domain, so backedge rows about it can be checked against entry.
fact_loop_materialize=(@entry:FactState back:FactState v:LoopWord depth:LoopWord=0):>bool=>{
    if fact_slot(entry v) >=? 0 {return true}
    if depth >? 2 or entry.ids.length >=? FACT_CAP or entry.projections.length >=? FACT_CAP {return false}
    let pi=fact_projection_origin(back v)
    if pi >=? 0 {
        let p=back.projections[pi]
        if not fact_loop_materialize(@entry back p.base depth + 1) {return false}
        let b=fact_domain(fact_terms[v].type)
        if p.selector =? -1 {b=FactBound(0 fact_length_max())}
        fact_add_value(@entry v b)
        fact_add_projection(@entry p)
        return true
    }
    false
}
# Intervals are candidates at a changing loop header, and so are backedge rows
# relating a changing scalar to an immutable evaluation (`k <? s.length` after
# a combined loop's guard). A row is kept only when entry entails it too; the
# header settles only when the same rows return, so each kept row holds on
# initiation and preservation. Guards select rows; assertions never do.
fact_loop_header=(@entry:FactState back:FactState old:FactState at:LoopWord widen:bool):>FactState=>$unsafe {
    let changing=dict<int64 bool>()
    let started=dict<int64 bool>()
    let binding_values:array<int64>=[]
    let counters:array<int64>=[]
    if back.live and entry.live {
        loop i in [0..back.bindings.length) {
            let binding=back.bindings[i]
            if fact_index_get(binding_values binding.value) <? 0 {fact_index_put(@binding_values binding.value i)}
            let original=fact_binding(entry binding.place)
            if original <? 0 or entry.bindings[original].value =? binding.value {continue}
            let t=if binding.place.root =? 'local' {LoopWord(locals.ptr[binding.place.declaration].type)} else {LoopWord(globals.ptr[binding.place.declaration].type)}
            if fact_scalar(t) {
                changing[binding.value]=true
                # (a changing place's entry value: a path back to it measures
                # the iterations so far, a row that never settles)
                started[entry.bindings[original].value]=true
            }
            let b=fact_bound(entry entry.bindings[original].value)
            # (a wide singleton is an `int` beyond int64, not a constant start)
            if fact_scalar(t) and types.ptr[fact_type(t)].kind =? 'int_' and b.lo =? b.hi and not b.wide {counters.push(i)}
        }
    }
    # Lockstep counters: two changing integers that start at constants keep
    # the difference entry gives them when the backedge entails it too (a
    # combined loop's range and hidden indices step together).
    # Each counter is linked only to the last earlier one related to it, so
    # every class of counters is a chain (paths give the other pairs) and no
    # counter's rows crowd out its own guard's within fact_difference's
    # per-term cap (four counters in all pairs would take six of its eight).
    let lockstep:array<FactDifference>=[]
    if counters.length <=? 8 {
        loop i in counters {
            let x=fact_bound(entry entry.bindings[fact_binding(entry back.bindings[i].place)].value)
            let link:array<FactDifference>=[]
            loop j in counters {
                if j =? i {break}
                let y=fact_bound(entry entry.bindings[fact_binding(entry back.bindings[j].place)].value)
                if y.lo =? FACT_MIN or not fact_add_fits(x.lo (-y.lo)) or x.lo - y.lo =? FACT_MIN {continue}
                let rows:array<FactDifference>=[]
                if fact_entails(back back.bindings[i].value back.bindings[j].value x.lo - y.lo) {rows.push(FactDifference(i j x.lo - y.lo))}
                if fact_entails(back back.bindings[j].value back.bindings[i].value y.lo - x.lo) {rows.push(FactDifference(j i y.lo - x.lo))}
                if rows.length >? 0 {link=rows}
            }
            loop row in link {lockstep.push(row)}
        }
    }
    # Two changing scalars the condition compares (`loop lo <? hi`, each
    # side moved by the body) keep that comparison's closed form `lo <= hi`
    # when entry and the backedge both entail it: an inductive row stability
    # re-validates. Fixed limit, so widening cannot chase it. O(condition).
    if changing.length >? 1 and nodes.ptr[at].kind =? 'while_' {fact_guard_pairs(LoopWord(nodes.ptr[at].a) entry back changing @lockstep 0)}
    let carried:array<FactDifference>=[]
    let offsets:array<int64>=[]
    if changing.length >? 0 and nodes.ptr[at].kind =? 'while_' {fact_offset_guarded(LoopWord(nodes.ptr[at].a) @offsets 0)}
    if changing.length >? 0 {
        loop row in back.differences {
            let upper=changing.has(row.a)
            if not upper and not changing.has(row.b) {continue}
            if fact_loop_materialize(@entry back if upper {row.b} else {row.a}) {carried.push(row)}
        }
        # A counter guarded through an offset (`loop i+2 <? n {… i+=3}`)
        # relates to the bound only along a path through the body's own
        # values: offer the tightest path to each immutable evaluation too.
        # One bounded search per changing scalar and direction (32 terms,
        # 256 rows), as fact_relational's.
        # Offset-tested counters retain their existing path candidates.
        loop binding in back.bindings {
            if not changing.has(binding.value) or binding.place.root not=? 'local' or binding.place.declaration not in? offsets {continue}
            fact_loop_paths(@entry back binding.value true changing started @carried)
        }
        if nodes.ptr[at].kind =? 'while_' {
            let direct:array<FactDifference>=[]
            fact_guarded_rows(LoopWord(nodes.ptr[at].a) back changing @direct 0)
            # Multiple advancing guard counters already use the lockstep
            # budget; do not crowd their shared endpoints with more rows.
            if direct.length =? 1 {
                let row=direct[0]
                let other=if changing.has(row.a) {row.b} else {row.a}
                # The endpoint may first be read by the condition. It still
                # denotes the same immutable entry projection as a direct row.
                if fact_loop_materialize(@entry back other) {carried.push(row)}
            }
        }
        # A counter stepped down (`high-=1`) stays at most its entry value,
        # and below what entry bounds that value by (`high=xs.length`: high
        # stays at most the length): candidates from entry, kept only when
        # the backedge entails them. A rising counter with a symbolic start
        # retains the dual lower bound; constant starts need only intervals.
        # O(changing counters x their entry rows, at most 8), one bounded
        # relaxation per candidate.
        # A counter stepped on only some paths (`if c i -= 1`) reaches the
        # backedge as a join: it may move either way, so both directions are
        # candidates, each still kept only when the backedge entails it.
        loop binding in back.bindings {
            let v=binding.value
            if not changing.has(v) {continue}
            let term=fact_terms[v]
            let joined=term.op =? 'eof' and term.a =? 0
            if not joined {
                if term.op not=? 'plus' and term.op not=? 'minus' or term.a =? 0 or term.b =? 0 {continue}
                let step=fact_bound(back term.b)
                if step.lo not=? step.hi or step.lo =? 0 or step.lo =? FACT_MIN {continue}
            }
            let falling=joined or (fact_bound(back term.b).lo <? 0) =? (term.op =? 'plus')
            let e=fact_binding(entry binding.place)
            if e <? 0 {continue}
            let start=entry.bindings[e].value
            if joined {
                if binding.place.root not=? 'local' or types.ptr[fact_type(LoopWord(locals.ptr[binding.place.declaration].type))].kind not=? 'int_' {continue}
                let initial=fact_bound(entry start)
                if not (initial.lo =? initial.hi and not initial.wide) and fact_entails(back start v 0) {carried.push(FactDifference(start v 0))}
            }
            if not falling {
                let initial=fact_bound(entry start)
                # Constant starts already have an interval lower bound.
                if initial.lo =? initial.hi and not initial.wide {continue}
                if fact_entails(back start v 0) {carried.push(FactDifference(start v 0))}
                let ri=fact_difference_head(entry start 0)
                let seen:LoopWord=0
                loop ri >=? 0 and seen <? 8 {
                    let row=entry.differences[ri]
                    ri=fact_difference_next(entry ri 0)
                    seen += 1
                    if row.b =? start and row.a not=? start and fact_entails(back row.a v row.limit) {carried.push(FactDifference(row.a v row.limit))}
                }
                continue
            }
            if fact_entails(back v start 0) {carried.push(FactDifference(v start 0))}
            let ri=fact_difference_head(entry start 1)
            let seen:LoopWord=0
            loop ri >=? 0 and seen <? 8 {
                let row=entry.differences[ri]
                ri=fact_difference_next(entry ri 1)
                seen += 1
                if row.a =? start and row.b not=? start and fact_entails(back v row.b row.limit) {carried.push(FactDifference(v row.b row.limit))}
            }
        }
    }
    # Only bindings and stable direct projections survive into a loop header.
    # Joining every temporary and difference row first builds a state we would
    # immediately throw away. Merge the demanded roots directly, O(B + P),
    # using the existing place/projection indexes.
    let source=if entry.live {entry} else {back}
    let predecessor=if entry.live {back} else {entry}
    # Entry evaluations are immutable snapshots and survive every header.
    # Keep their indexes instead of rebuilding them after every changing root.
    let s=entry
    s.live=entry.live or back.live
    s.full=false
    s.bindings=[]
    # (implications between immutable values hold on every iteration)
    let kept:array<ResultEvidence>=[]
    loop evidence in entry.conditional {
        if evidence.tag =? -2 and (not back.live or evidence in? back.conditional) {kept.push(evidence)}
    }
    s.conditional=kept
    s.index[0].roots=[]
    loop binding in source.bindings {
        let v=binding.value
        let peer=if predecessor.live {fact_binding(predecessor binding.place)} else {-1}
        if predecessor.live and peer <? 0 {continue}
        let peer_value=if peer >=? 0 {predecessor.bindings[peer].value} else {v}
        let bound=fact_bound(source v)
        if peer >=? 0 {bound=fact_hull(bound fact_bound(predecessor peer_value) at)}
        bound.reason='loop_'
        bound.witness=at
        let previous=fact_binding(old binding.place)
        let t=if binding.place.root =? 'local' {LoopWord(locals.ptr[binding.place.declaration].type)} else {LoopWord(globals.ptr[binding.place.declaration].type)}
        if widen and previous >=? 0 {
            let before=fact_bound(old old.bindings[previous].value)
            let domain=fact_domain(t 'loop_' at)
            bound.lo=if bound.lo <? before.lo {domain.lo} else {before.lo}
            # (a counter the condition tests at an offset, growing below any
            # length, stops first at the largest length, where a guard on a
            # length or a bound below one holds it (`loop i+1 <? stop`); past
            # it, at the domain)
            let limit=fact_length_max()
            let offset=offsets.length >? 0 and binding.place.root =? 'local' and binding.place.declaration in? offsets
            bound.hi=if bound.hi <=? before.hi {before.hi} else if offset and before.hi <? limit and bound.hi <=? limit and domain.hi >? limit {limit} else {domain.hi}
        }
        # Stable values keep their immutable identities and projection facts.
        let original=fact_binding(entry binding.place)
        if original >=? 0 and entry.bindings[original].value =? v and v =? peer_value {
            let slot=fact_slot(s v)
            if slot <? 0 {fact_add_value(@s v bound)}
            else if s.bounds[slot] not=? bound {s.bounds[slot]=bound}
            fact_bind(@s binding.place v)
        }
        else {
            # (only the contract's interval: its rows to fresh literals would
            # never settle the header)
            if refine_active {bound=ref_interval(t bound)}
            # (a mathematical int that entry and the backedge both hold
            # within int64 stays there, even when widened to the domain;
            # stability compares this representation too)
            # The header replaces the entry value just as a forgotten loop
            # write does. Keep that diagnostic route through fixed-point
            # iterations; representation demands must not erase its cause.
            let prior=if original >=? 0 {entry.bindings[original].value} else {v}
            fact_rebind(@s binding.place fact_new(@s bound FactTerm(type=fact_hull_type(t source v predecessor peer_value))) at prior)
        }
    }
    # A changing aggregate keeps the lengths and fields entry and backedge
    # share (an element write leaves its length); stability re-validates them.
    let shape_steps:LoopWord=FACT_CAP
    loop binding in source.bindings {
        let h=fact_binding(s binding.place)
        if h <? 0 or s.bindings[h].value =? binding.value {continue}
        let peer=if predecessor.live {fact_binding(predecessor binding.place)} else {-1}
        if predecessor.live and peer <? 0 {continue}
        let other=if peer >=? 0 {predecessor.bindings[peer].value} else {binding.value}
        fact_loop_shape(@s source predecessor binding.value other s.bindings[h].value @shape_steps 0)
        if fact_summary_payload(fact_type(fact_terms[s.bindings[h].value].type)) not=? 0 {fact_loop_payload(@s source binding.value predecessor other s.bindings[h].value old binding.place widen)}
        # (a dictionary the body grows by adding keys holds the comprehension's keys at every head)
        if fact_grown_roots.length >? 0 {fact_join_grown(@s source binding.value predecessor other s.bindings[h].value)}
    }
    loop row in carried {
        let upper=changing.has(row.a)
        let value=if upper {row.a} else {row.b}
        let other=if upper {row.b} else {row.a}
        let found=fact_index_get(binding_values value)
        if found <? 0 {continue}
        let e=fact_binding(entry back.bindings[found].place)
        let h=fact_binding(s back.bindings[found].place)
        if e <? 0 or h <? 0 or fact_slot(s other) <? 0 {continue}
        let start=entry.bindings[e].value
        let v=s.bindings[h].value
        if upper and not fact_entails(entry start other row.limit) {continue}
        if not upper and not fact_entails(entry other start row.limit) {continue}
        # (widening: a row the last header lacked or held tighter, as a
        # counter's distance from its symbolic start, is dropped)
        if widen {
            let p=fact_binding(old back.bindings[found].place)
            if p >=? 0 and old.bindings[p].value not=? start {
                let r=if upper {fact_row_find(old old.bindings[p].value other)} else {fact_row_find(old other old.bindings[p].value)}
                if r <? 0 or old.differences[r].limit <? row.limit {continue}
            }
        }
        let o=fact_bound(s other)
        let b=fact_bound(s v)
        if upper {
            fact_difference(@s v other row.limit row.at)
            if fact_add_fits(o.hi row.limit) {b.hi=min(b.hi o.hi + row.limit)}
        }
        else {
            fact_difference(@s other v row.limit row.at)
            if o.lo not=? FACT_MIN and row.limit not=? FACT_MIN and fact_add_fits(o.lo (-row.limit)) {b.lo=max(b.lo o.lo - row.limit)}
        }
        fact_set_bound(@s v b)
    }
    loop row in lockstep {
        let p=fact_binding(s back.bindings[row.a].place)
        let q=fact_binding(s back.bindings[row.b].place)
        if p <? 0 or q <? 0 {continue}
        let a=s.bindings[p].value
        let b=s.bindings[q].value
        fact_difference(@s a b row.limit at)
        let x=fact_bound(s a)
        let y=fact_bound(s b)
        if fact_add_fits(y.hi row.limit) {x.hi=min(x.hi y.hi + row.limit)}
        if x.lo not=? FACT_MIN and fact_add_fits(x.lo (-LoopWord(row.limit))) {y.lo=max(y.lo x.lo - row.limit)}
        fact_set_bound(@s a x)
        fact_set_bound(@s b y)
    }
    s
}
# Locals a loop condition compares at a constant offset (`i+2 <? n`), through
# `and`/`or`. O(condition nodes), at most 16 deep.
fact_offset_guarded=(e:LoopWord @out:array<int64> depth:LoopWord):>void=>$unsafe {
    if e =? 0 or depth >? 16 {return}
    let k=nodes.ptr[e].kind
    if k =? 'and_' or k =? 'or_' {
        fact_offset_guarded(LoopWord(nodes.ptr[e].a) @out depth + 1)
        fact_offset_guarded(LoopWord(nodes.ptr[e].b) @out depth + 1)
        return
    }
    if k not=? 'binary' or not fact_comparison(cx_token_values.ptr[LoopWord(nodes.ptr[e].op)]) {return}
    loop side in [LoopWord(nodes.ptr[e].a) LoopWord(nodes.ptr[e].b)] {
        let x=side
        loop x not=? 0 and nodes.ptr[x].kind =? 'conv' {x=LoopWord(nodes.ptr[x].a)}
        if x =? 0 or nodes.ptr[x].kind not=? 'binary' or (nodes.ptr[x].op not=? int32(58) and nodes.ptr[x].op not=? int32(59)) {continue}
        loop operand in [LoopWord(nodes.ptr[x].a) LoopWord(nodes.ptr[x].b)] {
            if nodes.ptr[operand].kind =? 'ident' and nodes.ptr[operand].aux =? int32(1) {out.push(LoopWord(nodes.ptr[operand].sym))}
        }
    }
}
# Read an already established scalar/field/array-length identity without
# evaluating syntax or replaying effects. O(route depth), at most 16.
fact_guard_value=(e:LoopWord s:FactState depth:LoopWord=0):>LoopWord=>$unsafe {
    if e =? 0 or depth >? 16 {return 0}
    let k=nodes.ptr[e].kind
    if k =? 'conv' {return fact_guard_value(LoopWord(nodes.ptr[e].a) s depth + 1)}
    if k =? 'ident' {
        let i=fact_binding(s fact_place(e))
        return if i >=? 0 {s.bindings[i].value} else {0}
    }
    let base:LoopWord=0
    let selector:LoopWord=0
    if fact_field_node(e) {
        base=fact_guard_value(LoopWord(nodes.ptr[e].a) s depth + 1)
        selector=if nodes.ptr[e].aux =? -2 {LoopWord(nodes.ptr[e].ival)} else {LoopWord(nodes.ptr[e].name)}
    }
    else if k =? 'call' and fact_string_call(e) =? 1 {
        base=fact_guard_value(kid(e 0) s depth + 1)
        selector=-1
    }
    else if k =? 'intrinsic' and nodes.ptr[e].aux =? int32(int64(IN.len)) and nkids(e) =? 1 and tkind(fact_type(ntype(kid(e 0)))) =? 'array' {
        base=fact_guard_value(kid(e 0) s depth + 1)
        selector=-1
    }
    if base =? 0 {return 0}
    let i=fact_projection_find(s base selector false)
    if i >=? 0 {return s.projections[i].value}
    0
}
# A direct scanner comparison selects only its named endpoint, not every
# reachable row (which would spend a coupled counter's incident-row budget).
# O(condition nodes), depth <= 16, one bounded indexed path query per selected
# pair. These are candidates: fact_loop_header still checks entry/preservation.
fact_guarded_rows=(e:LoopWord back:FactState changing:dict<int64 bool> @carried:array<FactDifference> depth:LoopWord):>void=>$unsafe {
    if e =? 0 or depth >? 16 {return}
    let k=nodes.ptr[e].kind
    if k =? 'and_' or k =? 'or_' {
        fact_guarded_rows(LoopWord(nodes.ptr[e].a) back changing @carried depth + 1)
        fact_guarded_rows(LoopWord(nodes.ptr[e].b) back changing @carried depth + 1)
        return
    }
    if k not=? 'binary' or nodes.ptr[e].aux not=? 0 or not fact_comparison(cx_token_values.ptr[LoopWord(nodes.ptr[e].op)]) {return}
    let sides=[LoopWord(nodes.ptr[e].a) LoopWord(nodes.ptr[e].b)]
    loop direction in [0..2) {
        let a=sides[direction]
        let b=sides[1 - direction]
        loop nodes.ptr[a].kind =? 'conv' {a=LoopWord(nodes.ptr[a].a)}
        loop nodes.ptr[b].kind =? 'conv' {b=LoopWord(nodes.ptr[b].a)}
        if nodes.ptr[a].kind not=? 'ident' {continue}
        let v=fact_guard_value(a back)
        let other=fact_guard_value(b back)
        if v =? 0 or other =? 0 {continue}
        if not changing.has(v) or changing.has(other) {continue}
        let limit=fact_shortest(back v other)
        if limit not=? FACT_MAX {carried.push(FactDifference(v other limit e))}
        # (and from below: `loop stop >? start ... stop -= 1` keeps stop at least start)
        let below=fact_shortest(back other v)
        if below not=? FACT_MAX {carried.push(FactDifference(other v below e))}
    }
}
# A comparison of two changing locals (through `and`/`or`) as a lockstep row
# over back's binding indexes: `a <? b` offers `a - b <= 0`, `a <=? b` offers
# `a - b <= 1`, kept only when entry and backedge entail it. Depth <= 16.
fact_guard_pairs=(e:LoopWord entry:FactState back:FactState changing:dict<int64 bool> @out:array<FactDifference> depth:LoopWord):>void=>$unsafe {
    if e =? 0 or depth >? 16 {return}
    let k=nodes.ptr[e].kind
    if k =? 'and_' or k =? 'or_' {
        fact_guard_pairs(LoopWord(nodes.ptr[e].a) entry back changing @out depth + 1)
        fact_guard_pairs(LoopWord(nodes.ptr[e].b) entry back changing @out depth + 1)
        return
    }
    if k not=? 'binary' or nodes.ptr[e].aux not=? 0 {return}
    let op=cx_token_values.ptr[LoopWord(nodes.ptr[e].op)]
    if op not=? 'lt' and op not=? 'le' and op not=? 'gt' and op not=? 'ge' {return}
    let a=LoopWord(nodes.ptr[e].a)
    let b=LoopWord(nodes.ptr[e].b)
    if op =? 'gt' or op =? 'ge' {
        a=LoopWord(nodes.ptr[e].b)
        b=LoopWord(nodes.ptr[e].a)
    }
    loop nodes.ptr[a].kind =? 'conv' {a=LoopWord(nodes.ptr[a].a)}
    loop nodes.ptr[b].kind =? 'conv' {b=LoopWord(nodes.ptr[b].a)}
    if nodes.ptr[a].kind not=? 'ident' or nodes.ptr[b].kind not=? 'ident' {return}
    let i=fact_binding(back fact_place(a))
    let j=fact_binding(back fact_place(b))
    let x=fact_binding(entry fact_place(a))
    let y=fact_binding(entry fact_place(b))
    if i <? 0 or j <? 0 or x <? 0 or y <? 0 or i =? j {return}
    if not changing.has(back.bindings[i].value) or not changing.has(back.bindings[j].value) {return}
    let limit=if op =? 'lt' or op =? 'gt' {0} else {1}
    if fact_entails(entry entry.bindings[x].value entry.bindings[y].value limit) and fact_entails(back back.bindings[i].value back.bindings[j].value limit) {out.push(FactDifference(i j limit e))}
}
# Common projection skeleton of changing loop aggregates. Leaves keep their
# immutable identity only when both entry and backedge have that identity.
# Recurse through changed aggregates so indexed inner lengths survive; never
# merge a changed scalar here. Indexed lookup per demanded projection, O(P)
# for a tree; shared DAG paths also share a FACT_CAP visit budget per header.
fact_loop_shape=(@s:FactState a:FactState b:FactState x:LoopWord y:LoopWord into:LoopWord @steps:LoopWord depth:LoopWord):>void=>{
    if depth >=? 32 or x =? 0 or y =? 0 or into =? 0 {return}
    let pool=fact_pool_type(fact_terms[x].type) or is_map_type(representation_type(fact_terms[x].type))
    let pi=fact_projection_first(a x)
    loop pi >=? 0 {
        if steps <=? 0 {return}
        steps -= 1
        let p=a.projections[pi]
        pi=fact_projection_after(a pi)
        if s.projections.length >=? FACT_CAP {return}
        if fact_slot(s p.value) <? 0 or p.element and fact_slot(s p.selector) <? 0 {continue}
        if p.element and pool and fact_bound(a p.value).lo <? 1 {continue}
        let qi=fact_projection_find(b y p.selector p.element)
        if qi <? 0 and p.element and b.live {qi=fact_projection_constant(a b y p.selector)}
        if b.live and qi <? 0 {continue}
        let other=if qi >=? 0 {b.projections[qi].value} else {p.value}
        let v=p.value
        if v not=? other {
            let t=fact_terms[v].type
            if p.element and pool {continue}
            if (t =? 0 or fact_scalar(t)) and (fact_terms[other].type =? 0 or fact_scalar(fact_terms[other].type)) {
                # (a changed scalar both edges hold at one constant, as a
                # shape's extent or a data length: that constant; any other
                # changed scalar is dropped, so this settles at once)
                let x0=fact_bound(a p.value)
                let y0=fact_bound(b other)
                # (or the backedge's value equals entry's immutable one, as a
                # shape binder's extent passed through: that identity)
                if b.live and fact_slot(b p.value) >=? 0 and fact_entails(b other p.value 0) and fact_entails(b p.value other 0) {v=p.value}
                else if not p.element and p.selector =? -1 and not x0.wide and not y0.wide and (x0.lo not=? x0.hi or y0.lo not=? x0.lo or y0.hi not=? x0.hi) {
                    # (a resized length keeps each entry bound the backedge
                    # respects, `xs.push` a lower and `xs.pop` an upper one, and
                    # widens the other to the length domain, so this settles in
                    # a round; stability re-validates the interval)
                    let lo=if y0.lo >=? x0.lo {x0.lo} else {0}
                    let hi=if y0.hi <=? x0.hi {x0.hi} else {fact_length_max()}
                    # (a length the backedge holds at least at entry's keeps that row, so a position below
                    # the entry length stays below: one entailment per changed length, as stability rechecks)
                    let grows=b.live and fact_incident(a p.value) >=? 0 and fact_slot(b p.value) >=? 0 and fact_entails(b p.value other 0)
                    if lo <=? 0 and hi >=? fact_length_max() and not grows {continue}
                    v=fact_new(@s FactBound(lo hi lo >? 0) FactTerm(type=t))
                    if grows {fact_difference(@s p.value v 0)}
                }
                else if x0.wide or y0.wide or x0.lo not=? x0.hi or y0.lo not=? x0.lo or y0.hi not=? x0.hi {continue}
                else {v=fact_new(@s FactBound(x0.lo x0.hi x0.nz) FactTerm(type=t))}
            }
            else {
                if t =? 0 or fact_scalar(t) or fact_terms[other].type not=? t {continue}
                v=fact_new(@s fact_domain(t) FactTerm(type=t))
                if v =? 0 {return}
                fact_loop_shape(@s a b p.value other v @steps depth + 1)
                if fact_projection_first(s v) <? 0 {continue}
            }
            if v =? 0 {return}
        }
        if s.projections.length <? FACT_CAP {fact_add_projection(@s FactProjection(into p.selector p.element v))}
    }
    # (an N-D value whose data both edges know matches its shape keeps that
    # marker on the header value itself: the pair it is keyed by is fresh)
    if is_nd(representation_type(fact_terms[into].type)) and s.projections.length <? FACT_CAP and fact_nd_valid_held(a x) and (not b.live or fact_nd_valid_held(b y)) {
        fact_add_projection(@s FactProjection(into ND_STORAGE_VALID false fact_new(@s FactBound(1 1 true) FactTerm(type=T_INT))))
    }
}
# The element projection of y in b whose selector is the same constant as
# selector in a (each edge evaluates its own `0` for an axis), or -1.
# O(projections of y), at most FACT_PROJECTION_SCAN.
fact_projection_constant=(a:FactState b:FactState y:LoopWord selector:LoopWord):>LoopWord=>{
    let k=fact_bound(a selector)
    if k.wide or k.lo not=? k.hi {return -1}
    let qi=fact_projection_first(b y)
    let scanned:LoopWord=0
    loop qi >=? 0 and scanned <? FACT_PROJECTION_SCAN {
        let q=b.projections[qi]
        if q.element {
            let c=fact_bound(b q.selector)
            if not c.wide and c.lo =? k.lo and c.hi =? k.hi {return qi}
        }
        qi=fact_projection_after(b qi)
        scanned += 1
    }
    -1
}
# Rows v - o <= d (upper) or o - v <= d from back's paths out of changing v to
# values entry holds (or materializes) that do not change, beyond direct rows.
fact_loop_paths=(@entry:FactState back:FactState v:LoopWord upper:bool changing:dict<int64 bool> started:dict<int64 bool> @carried:array<FactDifference>):>void=>{
    let terms=[v]
    let distances=[0]
    let cursor:LoopWord=0
    let visits:LoopWord=0
    loop cursor <? terms.length {
        let source=terms[cursor]
        let distance=distances[cursor]
        cursor += 1
        let previous:LoopWord=-1
        let ri=fact_difference_head(back source (if upper {1} else {0}))
        loop ri >=? 0 {
            let row=back.differences[ri]
            visits += ri - previous
            previous=ri
            ri=fact_difference_next(back ri (if upper {1} else {0}))
            if visits >? 256 {return}
            if not fact_add_fits(distance row.limit) {continue}
            let other=if upper {row.b} else {row.a}
            let value=distance + row.limit
            let seen:LoopWord=-1
            loop t in [0..terms.length) {
                if terms[t] =? other {seen=t}
            }
            if seen >=? 0 {
                if value <? distances[seen] {distances[seen]=value}
                continue
            }
            if terms.length >=? 32 {continue}
            terms.push(other)
            distances.push(value)
        }
    }
    loop t in [1..terms.length) {
        let o=terms[t]
        if changing.has(o) or started.has(o) or not fact_loop_materialize(@entry back o) {continue}
        carried.push(if upper {FactDifference(v o distances[t])} else {FactDifference(o v distances[t])})
    }
}
# Nothing is known of v beyond its interval: no projections, no rows.
fact_top=(s:FactState v:LoopWord):>bool=>{
    fact_projection_first(s v) <? 0 and fact_incident(s v) <? 0
}
# Two header aggregates whose contents changed (an element written each
# iteration) are settled when they carry the same projection skeleton:
# the same leaves under stable selectors, and rows equal after renaming.
fact_same_shape=(a:FactState b:FactState x:LoopWord y:LoopWord @steps:LoopWord @renamed:dict<int64 int64> depth:LoopWord=0):>bool=>{
    if depth >=? 32 {return false}
    let count:LoopWord=0
    let pi=fact_projection_first(a x)
    loop pi >=? 0 {
        if steps <=? 0 {return false}
        steps -= 1
        let p=a.projections[pi]
        pi=fact_projection_after(a pi)
        count += 1
        let qi=fact_projection_find(b y p.selector p.element)
        if qi <? 0 {return false}
        let other=b.projections[qi].value
        if p.value not=? other {
            let t=fact_terms[p.value].type
            if fact_terms[other].type not=? t or fact_bound(a p.value) not=? fact_bound(b other) {return false}
            if t =? 0 and fact_projection_first(a p.value) >=? 0 {return false}
            # (fresh header scalars agree when their bounds and skeletons do)
            if not fact_same_shape(a b p.value other @steps @renamed depth + 1) {return false}
        }
    }
    let qi=fact_projection_first(b y)
    loop qi >=? 0 {
        count -= 1
        qi=fact_projection_after(b qi)
    }
    if count not=? 0 {return false}
    if fact_incident(a x) <? 0 and fact_incident(b y) <? 0 {return true}
    # Fresh projected scalars (notably non-shrinking field lengths) can
    # carry the same rows in consecutive headers. Rename them bijectively;
    # fact_loop_stable checks every row after the entire shape is paired.
    # O(demanded projections + rows), within the existing shape budget.
    fact_scalar(fact_terms[x].type) and fact_shape_rename(@renamed x y)
}
fact_shape_rename=(@renamed:dict<int64 int64> x:LoopWord y:LoopWord):>bool=>{
    let old=renamed.get(x)
    let inverse=renamed.get(-y)
    if old not=? none and old not=? y or inverse not=? none and inverse not=? x {return false}
    renamed[x]=y
    renamed[-y]=x
    true
}
# A changing optional integer at a loop header: its payload's interval (the
# paths' hull, widened as a changing scalar's) and implications from its tag
# (fact_join_payload) relating it to values entry and the backedge share.
# Stability compares those implications. O(fact_join_payload).
fact_loop_payload=(@s:FactState a:FactState x:LoopWord b:FactState y:LoopWord into:LoopWord old:FactState place:PlaceIdentity widen:bool):>void=>{
    let pt=fact_summary_payload(fact_type(fact_terms[into].type))
    let bound=FactBound()
    let seen=false
    loop side in [0..2) {
        let st=if side =? 0 {a} else {b}
        let v=if side =? 0 {x} else {y}
        if not st.live or fact_known_none(st v) {continue}
        let p=fact_projection_value(st v (-4))
        if p =? 0 {return}
        bound=if seen {fact_hull(bound fact_bound(st p) 0)} else {fact_bound(st p)}
        seen=true
    }
    if not seen {return}
    let previous=fact_binding(old place)
    let before=if previous >=? 0 {fact_projection_value(old old.bindings[previous].value (-4))} else {0}
    if widen and before not=? 0 {
        let last=fact_bound(old before)
        let domain=fact_domain(pt)
        bound.lo=if bound.lo <? last.lo {domain.lo} else {last.lo}
        bound.hi=if bound.hi <=? last.hi {last.hi} else {domain.hi}
        bound.nz=bound.nz and last.nz
    }
    fact_join_payload(@s a x b y into [] [] [] bound true)
}
fact_loop_stable=(a:FactState b:FactState):>bool=>$unsafe {
    let shape_steps:LoopWord=FACT_CAP
    let renamed=dict<int64 int64>()
    loop binding in a.bindings {
        let i=fact_binding(b binding.place)
        if i <? 0 {return false}
        let x=fact_bound(a binding.value)
        let y=fact_bound(b b.bindings[i].value)
        if x.lo not=? y.lo or x.hi not=? y.hi or x.nz not=? y.nz or fact_terms[binding.value].type not=? fact_terms[b.bindings[i].value].type {return false}
        # Aggregate identity carries its projections; an equal top interval
        # alone is not evidence that a changed aggregate has stabilized. Two
        # header aggregates with no projections or rows are both top.
        let t=if binding.place.root =? 'local' {LoopWord(locals.ptr[binding.place.declaration].type)} else {LoopWord(globals.ptr[binding.place.declaration].type)}
        if not fact_scalar(t) and binding.value not=? b.bindings[i].value and not (fact_top(a binding.value) and fact_top(b b.bindings[i].value)) and not fact_same_shape(a b binding.value b.bindings[i].value @shape_steps @renamed) {return false}
    }
    # Carried rows must return unchanged, renamed into the next frame.
    if a.differences.length not=? b.differences.length {return false}
    let shaped=renamed.length >? 0
    loop binding in a.bindings {
        if not shaped and renamed.has(binding.value) {continue}
        let i=fact_binding(b binding.place)
        let other=if i >=? 0 {b.bindings[i].value} else {0}
        if shaped {
            if not fact_shape_rename(@renamed binding.value other) {return false}
        }
        else {renamed[binding.value]=other}
    }
    loop row in a.differences {
        # An unrenamed snapshot remains itself, never the target of a fresh
        # projection's renaming. This also prevents merging distinct terms.
        if shaped and (renamed.has(-row.a) and not renamed.has(row.a) or renamed.has(-row.b) and not renamed.has(row.b)) {return false}
        let x=renamed.get(row.a) ?? row.a
        let y=renamed.get(row.b) ?? row.b
        let i=fact_row_find(b x y)
        if i <? 0 or b.differences[i].limit not=? row.limit {return false}
    }
    fact_loop_stable_implications(a b)
}
# Iterator transfers publish their pre-killed exit state and optional counted
# lengths, not the body's backedge. In a return-summary run the body is only
# demanded if it can itself return from this function. Checking runs still
# visit it for every obligation. The memoized query is O(nodes + edges).
fact_may_return=(n:LoopWord):>bool=>$unsafe {
    if n =? 0 {return false}
    let known=fact_returns_cache.get(n)
    if known not=? none {return known}
    let yes=nodes.ptr[n].kind =? 'return_'
    if not yes {
        loop c in fact_slice_children(n) {
            if fact_may_return(c) {yes=true; break}
        }
    }
    fact_returns_cache[n]=yes
    yes
}
fact_loop_body=(n:LoopWord @body:FactState):>FactLoop=>$unsafe {
    if nodes.ptr[n].kind =? 'for_' and fact_summary_owner not=? 0 and not fact_may_return(LoopWord(nodes.ptr[n].b)) {return FactLoop()}
    fact_loops.push(FactLoop())
    fact_capture(LoopWord(nodes.ptr[n].b) @body);
    let edges=fact_loops.pop()
    edges.back=fact_join(edges.back body n)
    edges
}
# A scanner may first read its array parameter in the condition. Seed only
# pure local roots on comparison/field/length spines before taking entry, so
# that an unchanged root and its length retain their identity across headers.
# No assumptions or effectful reads; at most 32 condition nodes, only for a
# demanded loop. Ordinary stores and calls still replace these evaluations.
fact_loop_roots=(n:LoopWord @s:FactState @budget:LoopWord):>void=>$unsafe {
    if n <=? 0 or budget <=? 0 {return}
    budget -= 1
    let k=nodes.ptr[n].kind
    if k =? 'ident' {
        if fact_preread_local(n) {fact_read(@s n);}
    }
    else if k =? 'and_' or k =? 'or_' or k =? 'binary' and nodes.ptr[n].aux =? 0 and fact_comparison(cx_token_values.ptr[LoopWord(nodes.ptr[n].op)]) {
        fact_loop_roots(LoopWord(nodes.ptr[n].a) @s @budget)
        fact_loop_roots(LoopWord(nodes.ptr[n].b) @s @budget)
    }
    else if k =? 'conv' or fact_field_node(n) {fact_loop_roots(LoopWord(nodes.ptr[n].a) @s @budget)}
    else if k =? 'call' and fact_string_call(n) =? 1 or k =? 'intrinsic' and nodes.ptr[n].aux =? int32(int64(IN.len)) and nkids(n) =? 1 {
        fact_loop_roots(kid(n 0) @s @budget)
    }
}
fact_while=(n:LoopWord @s:FactState):>void=>$unsafe {
    let roots:LoopWord=32
    fact_loop_roots(LoopWord(nodes.ptr[n].a) @s @roots)
    let outer=fact_speculating
    let entry=s
    let header=s
    let settled=false
    fact_speculating += 1
    # Eager interval widening converges quickly; a fourth round lets
    # dependencies between changing counters settle before validation.
    let paths=FactPaths(FactState(live=false) FactState(live=false) FactBound())
    let edges=FactLoop()
    loop iteration in [0..4) {
        if fact_loop_exhausted {break}
        paths=fact_condition(LoopWord(nodes.ptr[n].a) header)
        edges=fact_loop_body(n @paths.yes)
        let next=fact_loop_header(@entry edges.back header n true)
        settled=fact_loop_stable(header next)
        header=next
        if settled {break}
    }
    if settled and not fact_loop_exhausted {
        # A settled round's header equals the one it ran with, so its
        # backedge is what a run with the settled header gives: narrow from
        # it rather than walking the body again.
        let next=fact_loop_header(@entry edges.back header n false)
        let same=fact_loop_stable(header next)
        header=next
        # (inside an enclosing loop's speculation nothing is published: a
        # header that narrowing left unchanged exits as the settled round did)
        if same and outer >? 0 {
            fact_speculating=outer
            s=fact_join(paths.no edges.exits n)
            return
        }
    }
    fact_speculating=outer
    if not settled or fact_loop_exhausted {
        # Restart at top for every syntactically changing route, then validate
        # normally. Speculative obligation answers are never published.
        header=entry
        fact_changes(n @header n 'budget')
    }
    # (positions the body keeps below a length: fact_loop_bounds)
    let demands=fact_loop_bound_entry(fact_loop_bound_demands(n) @entry)
    if demands.length >? 0 {fact_loop_bounds(n @header demands FACT_PREP_CONDITION 0 0 0 []);}
    paths=fact_condition(LoopWord(nodes.ptr[n].a) header)
    edges=fact_loop_body(n @paths.yes)
    s=fact_join(paths.no edges.exits n)
}

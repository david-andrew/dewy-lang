# A stepped range, `[a, b..c]` (a loop's, or the library's IntRange): its step
# b - a must be nonzero, so b not=? a is an obligation. n: the stepped `for_`,
# or a call of one of the library's range constructors with a literal `true`
# for `stepped` (fact_range_first).
fact_range_call = (n: int) -> bool: fact_range_first(n, true) >= 0
fact_range_first = (n: int, step: bool) -> int:
    if nodes[n].kind != .call or nodes[n].aux != 0 or nodes[n].sym <= 0: return -1
    m = nkids(n)
    if m != 2 and m != 5 and m != 7: return -1
    d = int(fns[int(nodes[n].sym)].decl)
    if d == 0: return -1
    if fact_name_range == 0:
        fact_name_range = intern("__dewy_range")
        fact_name_axis_slice = intern("__nd_axis_slice")
        fact_name_slice_range = intern("__dewy_slice_range")
        fact_name_open_range = intern("__dewy_open_range_iter")
    name = int(nodes[d].name)
    first = -1
    stepped = -1
    if m == 5 and name == fact_name_range:
        first = 0
        stepped = 3
    else if m == 7 and name == fact_name_axis_slice:
        first = 0
        stepped = 5
    else if m == 7 and name == fact_name_slice_range:
        first = 1
        stepped = 6
    else if m == 2 and name == fact_name_open_range: first = 0
    if first < 0 or not pos_in_lib(nodes[d].pos): return -1
    if stepped < 0: return if step: first else: -1
    flag = kid(n, stepped)
    if nodes[flag].kind != .bool_lit or (nodes[flag].ival != 0) != step: return -1
    first
fact_stepped_loop = (n: int) -> bool:
    it = int(nodes[n].a)
    nodes[n].kind == .for_ and nodes[n].aux == 0 and nodes[it].kind == .range and has_flag(it, NF_STEP) and nodes[it].c != 0
# Exhaustion is a separate obligation from a nonzero step. Only a 64-bit
# counter starting well inside its domain with a small fixed step may use the
# progress axiom. Narrow counters and huge steps must prove their backedge safe.
fact_open_range = (n: int) -> bool:
    if nodes[n].kind != .for_ or nodes[n].aux != 0: return false
    it = int(nodes[n].a)
    # An unbounded semantic-int range lowers with an exact, promoting cursor.
    nodes[it].kind == .range and nodes[it].b == 0 and dewy_at(nodes[n].pos) and prune(int(locals[int(nodes[n].sym)].type)) != T_MATH_INT
# The marked, small-start 64-bit range has a lexical progress axiom. It
# needs no value-flow proof; opt-out scopes and every other range retain
# their ordinary exhaustion obligation. Querying this certificate is O(1).
fact_range_assumed = (n: int) -> bool:
    nodes[n].aux2 == i32(RANGE_EXHAUSTION) and nodes[n].ival != 0 and dir_value(dir_name_assumed_bounds, nodes[n].pos) != 1
fact_range_exhaustion = (n: int, entry: FactState, first: int, second: int, edges: FactLoop):
    if not fact_open_range(n) or fact_speculating != 0 or fact_summary_owner != 0: return
    fact_validated[n] = true
    t = fact_type(int(locals[int(nodes[n].sym)].type))
    start = fact_bound(entry, first)
    delta = FactBound(1, 1)
    if second != 0:
        stop = fact_bound(entry, second)
        delta = FactBound(wide = true)
        if not start.wide and not stop.wide and start.lo != FACT_MIN and start.hi != FACT_MIN and fact_add_fits(stop.lo, -start.hi) and fact_add_fits(stop.hi, -start.lo): delta = FactBound(stop.lo - start.hi, stop.hi - start.lo)
    assumed = is_int(t) and types[t].bits == 64 and dir_value(dir_name_assumed_bounds, nodes[n].pos) != 1 and not start.wide and start.lo >= -72057594037927936 and start.hi <= 72057594037927936 and not delta.wide and delta.lo == delta.hi and delta.lo >= -65536 and delta.hi <= 65536
    proven = assumed or not edges.back.live
    if not proven:
        back = edges.back
        l = int(nodes[n].sym)
        binding = fact_binding(back, PlaceIdentity(.local, int(locals[l].owner), l))
        if binding >= 0 and stable_loop_index(l):
            current = fact_bound(back, back.bindings[binding].value)
            domain = fact_domain(t)
            if not current.wide and not delta.wide and fact_add_fits(current.lo, delta.lo) and fact_add_fits(current.hi, delta.hi):
                proven = current.lo + delta.lo >= domain.lo and current.hi + delta.hi <= domain.hi
    if fact_probe_on:
        fact_probe_record(n, proven)
        return
    if not proven:
        if dir_defer(n, "cannot prove the open range does not exhaust its integer type", true): return
        wit_fail(nodes[n].pos, "cannot prove the open range does not exhaust its integer type")
fact_step_check = (n: int, s: mut FactState, first: int, second: int, first_node: int, second_node: int):
    if fact_speculating != 0 or not (fact_policy == .RequireStatic or fact_query or fact_probe_on): return
    c = fact_compare(s, .ne, second, first)
    if fact_probe_on:
        fact_probe_record(n, c == 1)
        return
    if c == 1: return
    b = wit_side(second, second_node)
    a = wit_side(first, first_node)
    relation = wit_relation_text(.ne, b, a)
    missing = wit_relation(s, s, .ne, b, a, c == 0)
    wit_context(0)
    if c == 0:
        wit_help(relation)
        if dir_defer(n, "the range step is zero", true): return
        wit_fail(nodes[n].pos, "the range step is zero")
        return
    wit_unknown(n, fact_bound(s, second), "the range step is nonzero", 0, relation, missing)
# value (operand's) >= 0, as `what` requires: proven, an error, or a check of its scope.
fact_nonnegative = (n: int, s: mut FactState, value: int, operand: int, what: str):
    if fact_speculating != 0 or not (fact_policy == .RequireStatic or fact_query or fact_probe_on): return
    zero = fact_constant(s, 0)
    c = fact_compare(s, .ge, value, zero)
    if fact_probe_on:
        fact_probe_record(n, c == 1)
        return
    if c == 1: return
    side = wit_side(value, operand)
    nil = WitSide(zero, 0, "0", false, true)
    missing = wit_relation(s, s, .ge, side, nil, c == 0)
    wit_context(0)
    if c == 0:
        wit_help(wit_relation_text(.ge, side, nil))
        if dir_defer(n, "{what} is negative", true): return
        wit_fail(nodes[n].pos, "{what} is negative")
        return
    wit_unknown(n, fact_bound(s, value), "{what} is >= 0", 0, wit_relation_text(.ge, side, nil), missing)
fact_refinement_covers = (r: int) -> int:
    inner = int(nodes[r].a)
    if nodes[inner].kind != .conv or nodes[inner].aux != i32(int(CV.int_)) or prune(ntype(int(nodes[inner].a))) != T_MATH_INT: return 0
    known, allowed = int_intervals(zonk(int(nodes[r].aux2)))
    if not known or allowed.len() == 0 or allowed[0] == FACT_MIN or allowed[allowed.len() - 1] == FACT_MAX: return 0
    inner
# A captured fixed-width value or singleton has real host endpoints, unlike
# an unconstrained mathematical int. Conversions preserve value identity, so
# widening int64 to int and storing it back need not invent strict bounds.
# O(1), using the existing value-indexed term; wide intermediates never qualify.
fact_host_value = (s: FactState, value: int) -> bool:
    if value == 0: return false
    b = fact_bound(s, value)
    if b.wide: return false
    if b.lo == b.hi: return true
    t = fact_type(fact_terms[value].type)
    is_int(t) and t != T_MATH_INT and t != T_U64
# Endpoint sentinels become finite through a current guard too. Inspect only
# this value's indexed incident rows (at most 16), not every value in the body.
# The other endpoint must itself have a finite interval; do not recurse through
# rows, so a cycle of unconstrained values cannot manufacture a bound.
fact_host_endpoint = (s: FactState, value: int, upper: bool) -> bool:
    b = fact_bound(s, value)
    if b.wide: return false
    if (if upper: b.hi != FACT_MAX else: b.lo != FACT_MIN) or fact_host_value(s, value): return true
    ri = fact_difference_head(s, value, int(upper))
    loop ri >= 0:
        row = s.differences[ri]
        ri = fact_difference_next(s, ri, int(upper))
        other = if upper: row.b else: row.a
        q = fact_bound(s, other)
        if q.wide: continue
        if upper:
            if (q.hi != FACT_MAX or fact_host_value(s, other)) and fact_add_fits(q.hi, row.limit): return true
        else if row.limit != FACT_MIN:
            if (q.lo != FACT_MIN or fact_host_value(s, other)) and fact_add_fits(q.lo, -row.limit): return true
    false
# An `int` converted to a fixed width (`int32(x)`, `x as int32`, a store into a
# fixed-width place): x must fit, proven, an error or a check of its scope.
# An `int`'s endpoint sentinels need strict bounds unless a captured fixed
# value or current guard establishes that endpoint is finite. True when proven.
fact_narrow_check = (n: int, s: mut FactState, value: int) -> bool:
    to = representation_type(ntype(n))
    bits = int(types[to].bits)
    sign = types[to].sign
    low = if not sign: 0 else if bits >= 64: FACT_MIN else: -(1 << (bits - 1))
    high = if bits >= 64: FACT_MAX else if sign: (1 << (bits - 1)) - 1 else: (1 << bits) - 1
    lo_op = if low == FACT_MIN and not fact_host_endpoint(s, value, false): Tok.gt else: Tok.ge
    hi_op = if high == FACT_MAX and not fact_host_endpoint(s, value, true): Tok.lt else: Tok.le
    lo = fact_constant(s, low)
    hi = fact_constant(s, high)
    lc = fact_compare(s, lo_op, value, lo)
    hc = fact_compare(s, hi_op, value, hi)
    # (uint64's ceiling 2^64-1 is beyond int64: a real int64 end is below it,
    # a guard row to a larger literal caps an open one, nothing refutes it)
    unsigned = fact_type(to) == T_U64
    if unsigned and hc != 1: hc = if fact_u64_capped(s, value): 1 else: -1
    # (a binding's covering set of written values: string_domains.jo)
    proven = lc == 1 and hc == 1 or int_domain_proven.has(n) or exact_progress_math.has(n) or exact_word_reads.has(n)
    if fact_speculating != 0: return proven
    if fact_probe_on:
        fact_probe_record(n, proven)
        return proven
    if proven or n == fact_covered or not s.live or not (fact_policy == .RequireStatic or fact_query): return proven
    upper = hc != 1 and (lc != 0 or hc == 0)
    side = wit_side(value, int(nodes[n].a))
    # (an operand with no spelling of its own, as refinements show it)
    if side.text == "": side.text = "the value"
    limit = if upper: high else: low
    shown_limit = if upper and unsigned: "18446744073709551615" else: "{limit}"
    bound = WitSide((if upper: hi else: lo), 0, shown_limit, false, true)
    op = if upper: Tok.le else: Tok.ge
    refuted = (if upper: hc else: lc) == 0
    missing = wit_relation(s, s, op, side, bound, refuted)
    relation = wit_relation_text(op, side, bound)
    wit_context(0)
    if refuted:
        wit_help(relation)
        shown = side.text
        if dir_defer(n, "{shown} does not fit {dt(ntype(n))}", true): return false
        wit_fail(nodes[n].pos, "{shown} does not fit {dt(ntype(n))}")
        return false
    err_notes.push((-1, "help: widen the destination to `int`, state the domain as a refinement, or choose `overflow='wrap'|'saturate'`"))
    repair = if lc != 1 and hc != 1: "{low} <=? {side.text} and {side.text} <=? {shown_limit}" else: relation
    wit_unknown(n, fact_bound(s, value), "`{relation}` for the conversion to {dt(ntype(n))}", 0, repair, missing)
    false
# The builtin floor helper a Dewy `//` or `%` resolved to (fact_floor's kind), or 0.
fact_floor_call = (n: int) -> int:
    if nodes[n].aux != 0 or nodes[n].sym <= 0 or nkids(n) != 2: return 0
    f = int(nodes[n].sym)
    if fns[f].decl == 0 or not pos_in_lib(nodes[int(fns[f].decl)].pos): return 0
    if not fact_scalar(ntype(n)): return 0
    name = name_of(int(nodes[int(fns[f].decl)].name))
    if name == "__floor_div": return 1
    if name == "__floor_mod": return 2
    if name == "__floor_div_pow2": return 3
    if name == "__floor_mod_pow2": return 4
    0
fact_range = (n: int, s: mut FactState):
    iterator = int(nodes[n].a)
    lo = fact_capture(int(nodes[iterator].a), s)
    hi = fact_capture(int(nodes[iterator].b), s)
    pushes = fact_counted_pushes(n, s)
    growers = fact_growing_pushes(n, s, pushes)
    sums = fact_range_sums(n, s, lo, hi)
    # A local the body sets only to the loop's value (`best=i`, the argmax)
    # holds its entry value or some earlier i: at most hi-1 whenever its
    # entry value is (a sentinel -1, a first index 0).
    kept: (int, FactBound, bool, bool)[]
    # (an optional set only to it, `let best:int? = none`: a present payload is some i)
    found: int[]
    if nodes[iterator].b != 0 and not has_flag(iterator, NF_INCLUSIVE) and int(nodes[n].sym) != 0:
        loop l in fact_index_carried(int(nodes[n].b), int(nodes[n].sym)):
            i = fact_binding(s, PlaceIdentity(.local, int(locals[l].owner), l))
            if i < 0: continue
            e = s.bindings[i].value
            if fact_summary_payload(fact_type(int(locals[l].type))) != 0:
                if fact_known_none(s, e): found.push(l)
                continue
            kept.push((l, fact_bound(s, e), fact_entails(s, e, hi, -1), fact_entails(s, e, lo, 0)))
    pre = s
    hulls = fact_push_open(n, s)
    iterated = fact_iterate(n, s, true, 0, lo, hi, pushes + growers, sums)
    if not iterated:
        fact_changes(n, s, n)
        loop sum in sums:
            i = fact_binding(s, PlaceIdentity(.local, int(locals[sum.0].owner), sum.0))
            if i >= 0: fact_set_bound(s, s.bindings[i].value, sum.1)
    loop entry in kept:
        i = fact_binding(s, PlaceIdentity(.local, int(locals[entry.0].owner), entry.0))
        if i < 0: continue
        v = s.bindings[i].value
        x = fact_bound(s, lo); y = fact_bound(s, hi)
        b = fact_bound(s, v)
        b.lo = max(b.lo, min(entry.1.lo, x.lo))
        if y.hi != FACT_MIN: b.hi = min(b.hi, max(entry.1.hi, y.hi - 1))
        fact_set_bound(s, v, b)
        if entry.2: fact_difference(s, v, hi, -1, n)
    loop l in found: fact_found_payload(s, l, lo, hi)
    if s.live and int(nodes[n].sym) != 0: fact_range_invariants(n, pre, s, lo, hi)
    after = s
    body = fact_range_body(n, s, lo, hi)
    fact_growing_lengths(body, pushes)
    fact_growing_lengths(body, growers)
    # A nonempty iteration establishes lo < hi. Entry <= lo and every
    # replacement < hi therefore bound the carried value inside the body,
    # even when a zero-iteration exit cannot establish entry < hi.
    loop entry in kept:
        if not entry.3: continue
        i = fact_binding(body, PlaceIdentity(.local, int(locals[entry.0].owner), entry.0))
        if i >= 0: fact_difference(body, body.bindings[i].value, hi, -1, n)
    edges = fact_loop_body(n, body)
    fact_range_exhaustion(n, pre, lo, 0, edges)
    s = if iterated: fact_join(after, edges.exits, n) else: after
    if iterated and fact_speculating == 0 and after.live and edges.exits.live:
        loop entry in kept: fact_carried_exit(s, entry.0, after, edges.exits)
    if hulls: fact_push_close(n, s)
    fact_growing_lengths(s, growers)
    if pushes.len() > 0 and nodes[iterator].b != 0:
        # (the iteration count, hi-lo or hi-lo+1, when the range is not reversed)
        extra = if has_flag(iterator, NF_INCLUSIVE): 1 else: 0
        x = fact_bound(s, lo); y = fact_bound(s, hi)
        if fact_compare(s, .le, lo, hi) == 1 or extra == 1 and fact_compare(s, .le, lo, hi) >= 0 and x.lo == x.hi and y.lo == y.hi and y.lo + 1 >= x.lo:
            if x.lo != FACT_MIN and y.lo != FACT_MIN and fact_add_fits(y.hi, -x.lo + extra) and fact_add_fits(y.lo, -x.hi + extra):
                count = fact_new(s, FactBound(max(0, y.lo - x.hi + extra), y.hi - x.lo + extra), FactTerm(.minus, hi, lo, n, T_INT))
                if x.lo == x.hi:
                    fact_difference(s, count, hi, extra - x.lo, n)
                    fact_difference(s, hi, count, x.lo - extra, n)
                fact_counted_lengths(n, s, pushes, count)
                return
        # (`[0..n)` runs max(0, n) times, the length `fill(x n)` has)
        if extra == 0 and x.lo == 0 and x.hi == 0:
            fact_counted_lengths(n, s, pushes, fact_clamped(s, hi, n))
            return
        # (an unknown count is still never negative: the pushes only grow it)
        fact_counted_lengths(n, s, pushes, fact_new(s, FactBound(0, FACT_MAX)))

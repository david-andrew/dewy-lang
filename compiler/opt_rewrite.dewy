        # identities: result is a
        if ((((k =? 0) and ((((((((op =? 'add') or (op =? 'sub')) or (op =? 'or_')) or (op =? 'xor')) or (op =? 'shl')) or (op =? 'shrs')) or (op =? 'shru'))))) or (((k =? 1) and ((((op =? 'mul') or (op =? 'divs')) or (op =? 'divu')))))) {
            ins[0]=Ins('mov' 0 OptIndex(d) OptIndex(a) 0 0 0)
            continue
        }
        if ((op =? 'and_') and (k =? (- OptWord(int64(1))))) {
            ins[0]=Ins('mov' 0 OptIndex(d) OptIndex(a) 0 0 0)
            continue
        }
        if ((k =? 0) and (((op =? 'mul') or (op =? 'and_')))) {
            ins[0]=Ins('iconst' 0 OptIndex(d) 0 0 0 0)
            continue
        }
        if (((op =? 'add') and ow_def_is(a 4)) and o_regs[int64(o_regs[a].db)].constant) {
            ow_bin('add' d int64(o_regs[a].da) ow_kconst((OptWord(k) + OptWord(o_regs[int64(o_regs[a].db)].cval))));
            return
        }
        let sh=ow_log2_exact(k)
        if (sh >? 0) {
            if (op =? 'mul') {
                ow_bin('shl' d a ow_kconst(sh));
                return
            }
            if (op =? 'divu') {
                ow_bin('shru' d a ow_kconst(sh));
                return
            }
            if (op =? 'remu') {
                ow_bin('and_' d a ow_kconst((OptWord(k) - OptWord(int64(1)))));
                return
            }
            if ((op =? 'divs') or (op =? 'rems')) {
                # round toward zero: add (2^sh - 1) to negative dividends before shifting
                let t1=ow_bin('shrs' ow_tmp() a ow_kconst(63))
                let t2=ow_bin('shru' ow_tmp() t1 ow_kconst((OptWord(int64(64)) - OptWord(sh))))
                let t3=ow_bin('add' ow_tmp() a t2)
                if (op =? 'divs') {
                    ow_bin('shrs' d t3 ow_kconst(sh));
                }
                else {
                    let t4=ow_bin('and_' ow_tmp() t3 ow_kconst((- OptWord(k))))
                    ow_bin('sub' d a t4);
                }
                return
            }
        }
        if ((((((op =? 'divs') or (op =? 'rems'))) and (k >? 1)) and (sh <=? 0)) and opt_mulh_ok) {
            # by any other constant: a multiply by a "magic" number, its high half, a shift, and a
            # one added to negative dividends (Hacker's Delight 10-1), as C compilers do
            let [mag s]=ow_div_magic(k)
            let q=ow_bin('mulhs' ow_tmp() a ow_kconst(mag))
            if (mag <? 0) {
                q=ow_bin('add' ow_tmp() q a)
            }
            if (s >? 0) {
                q=ow_bin('shrs' ow_tmp() q ow_kconst(s))
            }
            let neg=ow_bin('shru' ow_tmp() a ow_kconst(63))
            if (op =? 'divs') {
                ow_bin('add' d q neg);
            }
            else {
                let qq=ow_bin('add' ow_tmp() q neg)
                let t=ow_bin('mul' ow_tmp() qq ow_kconst(k))
                ow_bin('sub' d a t);
            }
            return
        }
        if ((((((op =? 'divu') or (op =? 'remu'))) and (k >? 1)) and (sh <=? 0)) and opt_mulh_ok) {
            # unsigned: the high half of a multiply by a magic number, and a shift (with an add when
            # the number needs 65 bits: Hacker's Delight 10-8)
            let [mag s add]=ow_divu_magic(uint64(k))
            # (the last step writes the quotient straight into d, as the signed one does)
            let qd=d
            if (op =? 'remu') {
                qd=ow_tmp()
            }
            let t=ow_bin('mulhu' ow_tmp() a ow_kconst((mag transmute int64)))
            if add {
                let q1=ow_bin('sub' ow_tmp() a t)
                let q2=ow_bin('shru' ow_tmp() q1 ow_kconst(1))
                if (s >? 1) {
                    let q3=ow_bin('add' ow_tmp() q2 t)
                    ow_bin('shru' qd q3 ow_kconst((OptWord(s) - OptWord(int64(1)))));
                }
                else {
                    ow_bin('add' qd q2 t);
                }
            }
            else {
                ow_bin('shru' qd t ow_kconst(s));
            }
            if (op =? 'remu') {
                let q=int64(o_regs[qd].repl)
                let m=ow_bin('mul' ow_tmp() q ow_kconst(k))
                ow_bin('sub' d a m);
            }
            return
        }
        break
    }
    let op=ins[0].op
    if (((op =? 'br') or (op =? 'brif')) or (op =? 'brtable')) {
        o_nbr=(OptWord(o_nbr) + OptWord(int64(1)))
    }
    if (o_cse and (((op =? 'load') or (op =? 'store')))) {
        # fold constant offsets into the access: [x + k + imm]
        let a=int64(ins[0].a)
        loop ((ow_def_is(a 4) and o_regs[int64(o_regs[a].db)].constant) and ow_fits32((OptWord(ins[0].imm) + OptWord(o_regs[int64(o_regs[a].db)].cval)))) {
            ins[0].imm=(OptWord(ins[0].imm) + OptWord(o_regs[int64(o_regs[a].db)].cval))
            a=int64(o_regs[a].da)
        }
        # [base + index << scale + imm] (x86 addressing; wasm computes it)
        if (((((int64(ins[0].c) & 128) =? 0) and ow_def_is(a 4)) and (not o_regs[int64(o_regs[a].db)].constant)) and (not o_regs[int64(o_regs[a].da)].constant)) {
            let base=int64(o_regs[a].da)
            let idx=int64(o_regs[a].db)
            let scale:OptWord=0
            if (((ow_def_is(idx 14) and o_regs[int64(o_regs[idx].db)].constant) and (o_regs[int64(o_regs[idx].db)].cval <=? 3)) and (o_regs[int64(o_regs[idx].db)].cval >=? 0)) {
                scale=o_regs[int64(o_regs[idx].db)].cval
                idx=int64(o_regs[idx].da)
            }
            loop ((ow_def_is(base 4) and o_regs[int64(o_regs[base].db)].constant) and ow_fits32((OptWord(ins[0].imm) + OptWord(o_regs[int64(o_regs[base].db)].cval)))) {
                ins[0].imm=(OptWord(ins[0].imm) + OptWord(o_regs[int64(o_regs[base].db)].cval))
                base=int64(o_regs[base].da)
            }
            a=base
            ins[0].c=OptIndex(((int64(ins[0].c) or 128) or ((OptWord(scale) << 8))))
            if (op =? 'store') {
                ins[0].dst=OptIndex(idx)
            }
            else {
                ins[0].b=OptIndex(idx)
            }
        }
        ins[0].a=OptIndex(a)
    }
    if o_cse {
        let arity=ow_arity(oc_tag(ins) int64(ins[0].c))
        if (arity >=? 0) {
            let d=int64(ins[0].dst)
            let reg=(o_regs + d)
            let va:OptWord=0
            let vb:OptWord=0
            if (arity >? 0) {
                va=int64(o_regs[int64(ins[0].a)].ver)
            }
            if (arity >? 1) {
                vb=int64(o_regs[int64(ins[0].b)].ver)
            }
            let k1=(((oc_tag(ins) or ((OptWord(int64(ins[0].ty)) << 8))) or ((OptWord(((int64(ins[0].c) & 4095))) << 12))) or ((OptWord(int64(ins[0].a)) << 24)))
            let k2=int64(ins[0].b)
            let k3=ins[0].imm
            let gen:OptWord=(- OptWord(int64(1)))
            if (op =? 'load') {
                gen=ow_mem_gen(int64(ins[0].c))
            }
            let slot=ow_ht_slot(k1 k2 k3)
            let e=ow_ht_available(slot gen va vb)
            if ((e >=? 0) and (ow_vtype(e) =? ow_vtype(d))) {
                if reg[0].stable {
                    reg[0].repl=OptIndex(e)
                    if o_regs[e].constant {
                        reg[0].constant=true
                        reg[0].cval=o_regs[e].cval
                    }
                    return
                }
                reg[0].ver=(OptIndex(reg[0].ver) + OptIndex(OptIndex(int64(1))))
                o_regs[e].nuse=(OptIndex(o_regs[e].nuse) + OptIndex(OptIndex(int64(1))))
                ow_append_plain(Ins('mov' OptIndex(ow_vtype(d)) OptIndex(d) OptIndex(e) 0 0 0))
                return
            }
            if reg[0].stable {
                ow_ht_insert(slot k1 k2 k3 d gen va vb)
                reg[0].dop=OptIndex(oc_tag(ins))
                reg[0].da=ins[0].a
                reg[0].db=ins[0].b
                reg[0].dva=o_regs[int64(ins[0].a)].ver
                reg[0].dvb=o_regs[int64(ins[0].b)].ver
            }
            # CSE already decoded these operands. Account for the surviving
            # operation here instead of decoding it again through o_push.
            reg[0].ver=(OptIndex(reg[0].ver) + OptIndex(OptIndex(int64(1))))
            if (arity >? 0) {
                o_regs[int64(ins[0].a)].nuse=(OptIndex(o_regs[int64(ins[0].a)].nuse) + OptIndex(OptIndex(int64(1))))
            }
            if (arity >? 1) {
                o_regs[int64(ins[0].b)].nuse=(OptIndex(o_regs[int64(ins[0].b)].nuse) + OptIndex(OptIndex(int64(1))))
            }
            ow_append_plain(ins[0])
            return
        }
        else if (op =? 'store') {
            let mode=int64(ins[0].c)
            ow_kill_mem(mode)
            # store-to-load forwarding for full-width values
            let a=int64(ins[0].a)
            let v=int64(ins[0].b)
            let ix:OptWord=0
            let vix:OptWord=0
            if ((mode & 128) not=? 0) {
                ix=int64(ins[0].dst)
                vix=int64(o_regs[ix].ver)
            }
            if (((((mode & 15) =? 8) or ((mode & 32) not=? 0))) and ow_stable(v)) {
                ow_ht_put_gen(ow_load_key1(int64(ins[0].ty) mode a) ix ins[0].imm v ow_mem_gen(mode) int64(o_regs[a].ver) vix)
            }
            o_regs[a].nuse=(OptIndex(o_regs[a].nuse) + OptIndex(OptIndex(int64(1))))
            o_regs[v].nuse=(OptIndex(o_regs[v].nuse) + OptIndex(OptIndex(int64(1))))
            if ((mode & 128) not=? 0) {
                o_regs[ix].nuse=(OptIndex(o_regs[ix].nuse) + OptIndex(OptIndex(int64(1))))
            }
            ow_append_plain(ins[0])
            return
        }
        else if (op =? 'assume') {
            let a=int64(ins[0].a)
            if (ins[0].imm =? 1) {
                let k=ow_kconst(1)
                ow_ht_put_gen(ow_load_key1(0 (8 or 64) a) 0 0 k ow_mem_gen((8 or 64)) int64(o_regs[a].ver) 0)
            }
            return
        }
        else if (((opt_decode[oc_tag(ins)] & 4) not=? 0) and (not (((op =? 'call') and (ins[0].c =? 1))))) {
            ow_kill_all()
        }
    }
    # Record the boolean result without making raw-memory reads available
    # expressions: subsequent stores must still perform a new comparison.
    if ((((op =? 'memeq') or (op =? 'streq'))) and ow_stable(int64(ins[0].dst))) {
        o_regs[int64(ins[0].dst)].dop=OptIndex(oc_tag(ins))
    }
    ow_push(ins)
}
# the magic number, shift and whether an add is needed, for dividing an unsigned 64-bit integer
# by d (d >= 2) (Hacker's Delight 10-2)

ow_enter_loop=():>void=>$unsafe {
    let l=lp_next
    lp_next=(OptWord(lp_next) + OptWord(int64(1)))
    loop k in [lp_first[l]..lp_limit[l]) {
        o_regs[lp_defs[k]].ver=(OptIndex(o_regs[lp_defs[k]].ver) + OptIndex(OptIndex(int64(1))))
    }
    k=lp_kills[l]
    if (((k & 1) not=? 0) or opt_ir[0].raw_mem) {
        o_gen=(OptWord(o_gen) + OptWord(int64(1)))
    }
    if (((k & 2) not=? 0) or opt_ir[0].raw_mem) {
        o_genf=(OptWord(o_genf) + OptWord(int64(1)))
    }
    if (((k & 4) not=? 0) or opt_ir[0].raw_mem) {
        o_genh=(OptWord(o_genh) + OptWord(int64(1)))
    }
}
# Input metadata is O(N + U): each operation and operand use is visited once.

ow_input_use=(v:int64 pos:int64):>void=>$unsafe {
    if (o_regs[v].first >? pos) {
        o_regs[v].first=OptIndex(pos)
    }
    o_input_last[v]=OptIndex(pos)
}

opt_rewrite=():>void=>$unsafe {
    # The outer transfer uses slot 0. Strength reduction uses slot 1 with
    # simplification disabled, so a nested transfer never needs a third slot.
    let nv=opt_ir[0].vtypes.length
    loop p in [0..opt_ir[0].nparams) {
        o_regs[p].ndef=(OptIndex(o_regs[p].ndef) + OptIndex(OptIndex(int64(1))))
        o_regs[p].stable=true
        o_regs[p].defpos=(- OptWord(int64(1)))
    }
    # constant vregs: one canonical vreg per value
    o_kmap.clear()
    loop v in [0..opt_ir[0].kval.length) {
        if ow_is_kv(v) {
            o_regs[v].ndef=(OptIndex(o_regs[v].ndef) + OptIndex(OptIndex(int64(1))))
            o_regs[v].stable=true
            o_regs[v].constant=true
            o_regs[v].cval=opt_ir[0].kval[v]
            let c:int64?=o_kmap.get(opt_ir[0].kval[v])
            if c isnt? none {
                o_regs[v].repl=OptIndex(c)
            }
            else {
                o_kmap[opt_ir[0].kval[v]]=v
            }
        }
    }
    o_lastuse.resize(nv)
    o_input_last=o_lastuse.ptr
    loop v in [0..nv) {
        o_lastuse[v]=(- OptWord(int64(1)))
    }
    o_depth.resize(opt_ir[0].code.length)
    let depths=o_depth.ptr
    let depth:OptWord=0
    # (and what each loop defines and stores to, in the same walk)
    lp_defs.clear()
    lp_first.clear()
    lp_limit.clear()
    lp_parent.clear()
    lp_kills.clear()
    lp_open.clear()
    lp_next=0
    let active:OptWord=(- OptWord(int64(1)))
    # One dispatch supplies operand uses, structured-loop facts, definitions,
    # and memory invalidation. Do not reconstruct a general operand view and
    # redispatch the same operation separately for each consumer.
    let input=opt_ir[0].code.ptr
    opt_input=input
    let working=opt_working
    loop pos in [0..opt_ir[0].code.length) {
        let ins=(input + pos)
        let op=ins[0].op
        let a=int64(ins[0].a)
        let b=int64(ins[0].b)
        let d=int64(ins[0].dst)
        let kill:OptWord=0
        depths[pos]=OptIndex(depth)
        match op {
            <'end'> => {
                depth=(OptWord(depth) - OptWord(int64(1)))
                depths[pos]=OptIndex(depth)
                let l=lp_open.pop()
                if (l >=? 0) {
                    lp_limit[l]=lp_defs.length
                    active=lp_parent[l]
                    if (active >=? 0) {
                        lp_kills[active]=(lp_kills[active] or lp_kills[l])
                    }
                }
                d=(- OptWord(int64(1)))
            }
            <'block'|'loop'|'if_'> => {
                depth=(OptWord(depth) + OptWord(int64(1)))
                if (op =? 'loop') {
                    let l=lp_first.length
                    lp_open.push(l)
                    lp_first.push(lp_defs.length)
                    lp_limit.push((- OptWord(int64(1))))
                    lp_parent.push(active)
                    lp_kills.push(0)
                    active=l
                }
                else {
                    lp_open.push((- OptWord(int64(1))))
                }
                if (op =? 'if_') {
                    ow_input_use(a pos)
                }
                d=(- OptWord(int64(1)))
            }
            <'nop'|'else_'|'br'|'trap'|'vzu'> => {
                d=(- OptWord(int64(1)))
            }
            <'iconst'|'fconst'|'slot'|'gaddr'|'daddr'|'faddr'> => {
                {}
            }
            <'intr'|'call'|'syscall'|'calli'|'callc'> => {
                loop k in [a..(OptWord(a) + OptWord(b))) {
                    ow_input_use(int64(opt_ir[0].args[k]) pos)
                }
                if ((op =? 'calli') or (op =? 'callc')) {
                    ow_input_use(int64(ins[0].c) pos)
                }
                if ((op not=? 'call') or (ins[0].c not=? 1)) {
                    kill=7
                }
            }
            <'ret'> => {
                if (a >=? 0) {
                    ow_input_use(a pos)
                }
                d=(- OptWord(int64(1)))
            }
            <'brif'|'brtable'|'assume'> => {
                ow_input_use(a pos)
                d=(- OptWord(int64(1)))
            }
            <'zero'> => {
                ow_input_use(a pos)
                d=(- OptWord(int64(1)))
                kill=7
            }
            <'store'|'vst'> => {
                ow_input_use(a pos)
                ow_input_use(b pos)
                if ((op =? 'vst') or ((int64(ins[0].c) & 128) not=? 0)) {
                    ow_input_use(d pos)
                }
                if (op =? 'store') {
                    let m=int64(ins[0].c)
                    if opt_ir[0].raw_mem {
                        kill=7
                    }
                    else if ((m & 64) not=? 0) {
                        kill=4
                    }
                    else if ((m & 32) not=? 0) {
                        kill=2
                    }
                    else {
                        kill=1
                    }
                }
                d=(- OptWord(int64(1)))
            }
            <'copy'> => {
                ow_input_use(a pos)
                ow_input_use(b pos)
                d=(- OptWord(int64(1)))
                kill=7
            }
            <'memcpy'|'memset'|'vop'> => {
                ow_input_use(a pos)
                ow_input_use(b pos)
                ow_input_use(int64(ins[0].c) pos)
                d=(- OptWord(int64(1)))
                kill=7
            }
            <'select'|'memeq'|'findbyte'|'scanbytes'|'findb'> => {
                ow_input_use(a pos)
                ow_input_use(b pos)
                ow_input_use(int64(ins[0].c) pos)
            }
            <'load'> => {
                ow_input_use(a pos)
                if ((int64(ins[0].c) & 128) not=? 0) {
                    ow_input_use(b pos)
                }
            }
            <'mov'|'neg'|'not_'|'fneg'|'fsqrt'|'fabs'|'ffloor'|'fceil'|'ftrunc'|'sext8'|'sext16'|'sext32'|'zext8'|'zext16'|'zext32'|'i2f'|'u2f'|'f2i'|'f2f'|'bits2f'|'f2bits'|'vsplat'> => {
                ow_input_use(a pos)
            }
            <'zeroslots'> => {
                loop k in [a..(OptWord(a) + OptWord(b))) {
                    let item=int64(opt_ir[0].args[k])
                    if ((item & 1) =? 1) {
                        o_regs[(item >> 1)].ndef=(OptIndex(o_regs[(item >> 1)].ndef) + OptIndex(OptIndex(int64(2))))
                        o_regs[(item >> 1)].stable=false
                        if (active >=? 0) {
                            lp_defs.push((item >> 1))
                        }
                    }
                }
                d=(- OptWord(int64(1)))
                kill=7
            }
            _ => {
                ow_input_use(a pos)
                ow_input_use(b pos)
            }
        }
        if (d >=? 0) {
            if (opt_ir[0].slot_size.length =? 0) {
                o_regs[d].ndef=(OptIndex(o_regs[d].ndef) + OptIndex(OptIndex(int64(1))))
            }
            o_regs[d].defpos=OptIndex(pos)
            o_regs[d].stable=((o_regs[d].ndef =? 1) and (o_regs[d].first >? pos))
            if (active >=? 0) {
                lp_defs.push(d)
            }
        }
        if ((kill not=? 0) and (active >=? 0)) {
            lp_kills[active]=(lp_kills[active] or kill)
        }
    }
    # forward: fold, propagate copies, eliminate common subexpressions, drop dead branches
    o_count=0
    if (o_capacity <? opt_ir[0].code.length) {
        o_capacity=opt_ir[0].code.length
        o_out_storage.resize(o_capacity)
        o_out=o_out_storage.ptr
    }
    ow_flow_begin()
    o_cse=true
    ow_ht_setup((OptWord(opt_ir[0].code.length) + OptWord(int64(16))))
    # 0 normal, 1 if(true), 2 if(false), 3 block; keep each control's facts together.
    let ctl:array<OptControl>=[]
    o_join_regs.clear()
    o_join_next.clear()
    let skip:OptWord=0
    loop pos in [0..opt_ir[0].code.length) {
        working[0]=input[pos]
        let ins=working
        let op=ins[0].op
        if (skip >? 0) {
            if (((op =? 'block') or (op =? 'loop')) or (op =? 'if_')) {
                skip=(OptWord(skip) + OptWord(int64(1)))
            }
            if (op =? 'loop') {
                lp_next=(OptWord(lp_next) + OptWord(int64(1)))
            }
            else if (((op =? 'else_') and (skip =? 1)) and (ctl[(OptWord(ctl.length) - OptWord(int64(1)))].kind =? 2)) {
                skip=0
                ow_scope_open()
            }
            else if (op =? 'end') {
                skip=(OptWord(skip) - OptWord(int64(1)))
                if (skip =? 0) {
                    let frame=ctl.pop()
                    ow_join_kill(frame.deferred)
                    let lop=o_out[(OptWord(o_count) - OptWord(int64(1)))].op
                    if ((lop =? 'block') or (lop =? 'if_')) {
                        ow_pop()
                    }
                    else {
                        ow_append(ins[0])
                    }
                }
            }
            continue
        }
        if ((opt_decode[oc_tag(ins)] & ((OptWord(int64(1)) << 24))) =? 0) {
            ow_transfer(ins true)
            continue
        }
        if (op =? 'nop') {
            continue
        }
        if ((op =? 'block') or (op =? 'loop')) {
            if (op =? 'loop') {
                ow_enter_loop()
            }
            let kind:OptWord=0
            if (op =? 'block') {
                kind=3
            }
            ctl.push(OptControl(kind (- OptWord(int64(1))) o_nbr))
            ow_scope_open((op =? 'block'))
            ow_append(ins[0])
            continue
        }
        if (op =? 'if_') {
            let c=int64(o_regs[int64(ins[0].a)].repl)
            let known=((o_regs[c].constant or ow_fact_false(c)) or ow_fact_true(c))
            if known {
                # the if becomes a plain block so branch depths inside stay valid
                ow_append(Ins('block' 0 0 0 0 0 0))
                if (((o_regs[c].constant and (o_regs[c].cval not=? 0))) or ow_fact_true(c)) {
                    ctl.push(OptControl(1 (- OptWord(int64(1))) o_nbr))
                    ow_scope_open()
                }
                else {
                    ctl.push(OptControl(2 (- OptWord(int64(1))) o_nbr))
                    skip=1
                }
                continue
            }
            ctl.push(OptControl(0 c o_nbr))
            ow_scope_open()
            ow_add_fact_true(c)
            let ins2=ins[0]
            ins2.a=OptIndex(c)
            o_regs[c].nuse=(OptIndex(o_regs[c].nuse) + OptIndex(OptIndex(int64(1))))
            ow_append(ins2)
            continue
        }
        if (op =? 'else_') {
            let c=ctl[(OptWord(ctl.length) - OptWord(int64(1)))].condition
            ctl[(OptWord(ctl.length) - OptWord(int64(1)))].condition=(- OptWord(int64(1)))
            ow_scope_close()
            if (ctl[(OptWord(ctl.length) - OptWord(int64(1)))].kind =? 1) {
                skip=1
                continue
            }
            ow_scope_open()
            if (c >=? 0) {
                ow_add_fact_false(c)
            }
            ow_append(ins[0])
            continue
        }
        if (op =? 'end') {
            # A terminating if arm leaves its condition false. For a block with exactly
            # one conditional exit and a terminating tail, only that taken exit reaches
            # the join. Count all branches conservatively, including nested breaks.
            let frame=ctl.pop()
            let c=frame.condition
            let nbr=frame.branches
            let kind=frame.kind
            ow_join_kill(frame.deferred)
            let last=o_out[(OptWord(o_count) - OptWord(int64(1)))]
            if (((((kind =? 3) and (c >=? 0)) and ((OptWord(nbr) + OptWord(int64(2))) =? o_nbr)) and (last.op =? 'br')) and (last.imm >? 0)) {
                let target=(OptWord(ctl.length) - OptWord(int64(last.imm)))
                if (target >=? 0) {
                    let d=ow_branch_copy()
                    if (d >=? 0) {
                        o_regs[d].ver=(OptIndex(o_regs[d].ver) - OptIndex(OptIndex(int64(1))))
                        o_join_regs.push(d)
                        o_join_next.push(ctl[target].deferred)
                        ctl[target].deferred=(OptWord(o_join_regs.length) - OptWord(int64(1)))
                    }
                }
            }
            let terminates=(((last.op =? 'ret') or (last.op =? 'trap')) or (((last.op =? 'call') and (last.c =? 1))))
            let noret=((c >=? 0) and terminates)
            ow_scope_close()
            if ((last.op =? 'block') or (last.op =? 'if_')) {
                # empty construct: drop it (an if's condition is pure)
                ow_pop()
                continue
            }
            ow_append(ins[0])
            if noret {
                if ((kind =? 3) and ((OptWord(nbr) + OptWord(int64(1))) =? o_nbr)) {
                    ow_add_fact_true(c)
                }
                else if ((kind =? 0) and (nbr =? o_nbr)) {
                    ow_add_fact_false(c)
                }
            }
            continue
        }
        if (op =? 'brif') {
            # a branch on a known condition: always or never taken
            let c=int64(o_regs[int64(ins[0].a)].repl)
            if ((o_regs[c].constant or ow_fact_false(c)) or ow_fact_true(c)) {
                if (((o_regs[c].constant and (o_regs[c].cval not=? 0))) or ow_fact_true(c)) {
                    ow_emit(Ins('br' 0 0 0 0 0 ins[0].imm))
                }
                continue
            }
            # Remember an exit's condition for a possible terminating block. Multiple
            # exits (even with the same condition) fail the branch-count check at its end.
            let target=(OptWord((OptWord(ctl.length) - OptWord(int64(1)))) - OptWord(int64(ins[0].imm)))
            if ((target >=? 0) and (ctl[target].kind =? 3)) {
                ctl[target].condition=c
            }
            # (after it, in this construct, the condition is false)
            ow_transfer(ins true)
            ow_add_fact_false(c)
            continue
        }
        if (op =? 'zeroslots') {
            ow_kill_all()
            loop k in [0..int64(ins[0].b)) {
                let item=int64(opt_ir[0].args[(OptWord(int64(ins[0].a)) + OptWord(k))])
                if ((item & 1) =? 1) {
                    o_regs[(item >> 1)].ver=(OptIndex(o_regs[(item >> 1)].ver) + OptIndex(OptIndex(int64(1))))
                }
            }
            ow_append_plain(ins[0])
            continue
        }
        ow_transfer(ins true)
    }
    if o_flow_dead {
        ow_flow_end_dead()
    }
    # backward: drop pure instructions whose results are unused (o_push counted the uses)
    let i=(OptWord(o_count) - OptWord(int64(1)))
    loop (i >=? 0) {
        let ins=(o_out + i)
        if ((opt_decode[oc_tag(ins)] & 2) not=? 0) {
            let d=int64(ins[0].dst)
            if (o_regs[d].nuse =? 0) {
                ow_operands(ins);
                o_out[i].op='nop'
                loop operand_index in [0..opt_use_count) {
                    let u=ow_use(operand_index)
                    o_regs[u].nuse=(OptIndex(o_regs[u].nuse) - OptIndex(OptIndex(int64(1))))
                }
            }
        }
        i=(OptWord(i) - OptWord(int64(1)))
    }
    opt_ir[0].code=opt_cleanup(o_out o_count)
}

# Word operations preserve the frozen optimizer's overflow and truncation rules.
OptUnsigned:type=uint64<overflow='wrap'>
const OW_ONE:OptUnsigned=1
const OW_TWO:OptUnsigned=2
ow_unsigned_add_overflow=(a:uint64 b:uint64):>bool=>OptUnsigned(a) + OptUnsigned(b) <? a
ow_trunc_div=(a:int64 b:int64):>int64=>{
    let q:int64=a // b
    if (a <? 0) not=? (b <? 0) and a % b not=? 0 {q+=1}
    q
}
ow_word_overflow=(operation:int64 x:int64 y:int64):>bool=>{
    if operation =? 0 {
        let r:int64=OptWord(x) + OptWord(y)
        return ((x xor r) & (y xor r)) <? 0
    }
    if operation =? 1 {
        let r:int64=OptWord(x) - OptWord(y)
        return ((x xor y) & (x xor r)) <? 0
    }
    if operation =? 2 {
        let ax:OptUnsigned=if x <? 0 {OptUnsigned(uint64(-(x + 1))) + OW_ONE} else {OptUnsigned(x)}
        let ay:OptUnsigned=if y <? 0 {OptUnsigned(uint64(-(y + 1))) + OW_ONE} else {OptUnsigned(y)}
        let limit:uint64=if (x <? 0) not=? (y <? 0) {uint64(9223372036854775808)} else {uint64(9223372036854775807)}
        return ay not=? 0 and ax >? limit // ay
    }
    if operation =? 3 {return y =? 0 or (x =? OW_MIN_INT and y =? -1)}
    if y <? 0 {return true}
    if y >=? 64 {return x not=? 0}
    ((OptWord(x) << y) >> y) not=? x
}
ow_divu_magic=(d0:uint64):>[uint64 int64 bool]=>{
    let d:OptUnsigned=d0
    let two63:OptUnsigned=0x8000000000000000
    let max63:OptUnsigned=0x7FFFFFFFFFFFFFFF
    let zero:OptUnsigned=0
    let add=false
    let nc:OptUnsigned=(zero - OW_ONE) - (zero - d) % d
    let p:int64=63
    let q1:OptUnsigned=two63 // nc
    let r1:OptUnsigned=two63 - q1 * nc
    let q2:OptUnsigned=max63 // d
    let r2:OptUnsigned=max63 - q2 * d
    loop true {
        p+=1
        if r1 >=? nc - r1 {
            q1=q1 * OW_TWO + OW_ONE
            r1=r1 * OW_TWO - nc
        } else {
            q1=q1 * OW_TWO
            r1=r1 * OW_TWO
        }
        if r2 + OW_ONE >=? d - r2 {
            if q2 >=? max63 {add=true}
            q2=q2 * OW_TWO + OW_ONE
            r2=r2 * OW_TWO + OW_ONE - d
        } else {
            if q2 >=? two63 {add=true}
            q2=q2 * OW_TWO
            r2=r2 * OW_TWO + OW_ONE
        }
        let delta:OptUnsigned=d - OW_ONE - r2
        if not (p <? 128 and (q1 <? delta or (q1 =? delta and r1 =? 0))) {break}
    }
    [q2 + OW_ONE p - 64 add]
}
ow_div_magic=(d:int64):>[int64 int64]=>{
    let two63:OptUnsigned=0x8000000000000000
    let ad:OptUnsigned=OptUnsigned(d)
    let anc:OptUnsigned=two63 - OW_ONE - two63 % ad
    let p:int64=63
    let q1:OptUnsigned=two63 // anc
    let r1:OptUnsigned=two63 - q1 * anc
    let q2:OptUnsigned=two63 // ad
    let r2:OptUnsigned=two63 - q2 * ad
    loop true {
        p+=1
        q1=q1 * OW_TWO
        r1=r1 * OW_TWO
        if r1 >=? anc {
            q1=q1 + OW_ONE
            r1=r1 - anc
        }
        q2=q2 * OW_TWO
        r2=r2 * OW_TWO
        if r2 >=? ad {
            q2=q2 + OW_ONE
            r2=r2 - ad
        }
        let delta:OptUnsigned=ad - r2
        if not (q1 <? delta or (q1 =? delta and r1 =? 0)) {break}
    }
    [(q2 + OW_ONE) transmute int64 p - 64]
}

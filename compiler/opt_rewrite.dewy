$runtime_checks

from p"ir_types.dewy" import (Op Ins IrFn)
from p"opt_workspace.dewy" import (
    OptReg OptFlow OptScope OptControl AvailableValue FastLoad opt_args opt_checked_flags opt_vtypes opt_input_count opt_nparams opt_raw_mem opt_allow_cse opt_fast_nv opt_has_loops opt_has_big_loop_const opt_has_vec_cand opt_has_float_op fl_has_const_div opt_ir ht_entries ht_mask ht_storage lp_defs
    lp_first lp_kills lp_limit lp_next lp_open lp_parent o_capacity o_count o_cse o_dead_first
    o_dead_limit o_dead_start o_depth o_epoch o_fact_nbr o_fact_scope o_flow o_flow_at
    o_flow_at_storage o_flow_count o_flow_dead o_flow_depth o_flow_level o_flow_open
    o_flow_open_storage o_flow_storage o_flow_top o_gen o_genf o_genh o_input_last o_join_next
    o_join_regs o_kmap o_kval o_kreg o_kepoch o_kfn o_kmask o_ctl o_lastuse o_nbr o_out o_out_storage o_reg_count o_reg_storage o_regs
    o_scope_info o_scope_storage o_scopes opt_decode opt_input opt_kc_epoch opt_kc_fn
    opt_kc_reg opt_kc_val opt_mulh_ok opt_operands opt_rotate32_ok opt_sra_counted opt_use_count opt_use_span
    opt_use_span_count opt_use_values opt_working fl_cache fl_sid fl_next_sid fl_blk_start fl_blk_kind
)
from p"opt_cleanup.dewy" import (oc_defines oc_extreme_select oc_has_use oc_if_select oc_negate oc_pure oc_retargetable oc_sole_slot oc_tag oc_vtype opt_cleanup opt_cleanup_ir)

# Word arithmetic preserves Jo overflow; IR IDs and bounded cursors are fixed width.
OptWord:type=int64<overflow='wrap'>
OptIndex:type=int32<overflow='wrap'>

const OW_MIN_INT:int64=-9223372036854775807 - 1

ow_vreg=(ty:int64):>int64=>$unsafe {
    opt_ir[0].vtypes.push(int8(ty))
    opt_vtypes=opt_ir[0].vtypes.ptr
    (OptWord(opt_ir[0].vtypes.length) - OptWord(int64(1)))
}

ow_vtype=(v:int64):>int64=>$unsafe {
    let t=int64(opt_vtypes[v])
    if (t =? 3) {
        return 0
    }
    t
}

ow_is_kv=(v:int64):>bool=>$unsafe {
    (int64(opt_vtypes[v]) =? 3)
}

ow_k_vreg=(v:int64):>int64=>$unsafe {
    let slot=(((v xor ((v >> 8)))) & 255)
    if ((opt_kc_epoch[slot] =? opt_kc_fn) and (opt_kc_val[slot] =? v)) {
        return opt_kc_reg[slot]
    }
    let d=opt_ir[0].vtypes.length
    opt_ir[0].vtypes.push(int8(3))
    opt_vtypes=opt_ir[0].vtypes.ptr
    let old=opt_ir[0].kval.length
    if old <=? d {
        let need=d + 1
        let kp=opt_ir[0].kval.ptr
        if kp =? (uint64(0) as ptr<int64>) or (kp - 3)[0] not=? 1 or (kp - 3)[2] <? need {
            opt_ir[0].kval.reserve(max(need cap(opt_ir[0].kval) * 2))
            kp=opt_ir[0].kval.ptr
        }
        if d >? old {mem_set((kp + old) as ptr<uint8> 0 (d - old) * 8)}
        let kh=kp - 3
        kh[1]=need
        kp[d]=v
    } else {
        opt_ir[0].kval[d]=v
    }
    opt_kc_epoch[slot]=opt_kc_fn
    opt_kc_val[slot]=v
    opt_kc_reg[slot]=d
    d
}

# ABI ordinals: eq..geu are 19..28; load is 59. The exhaustive operand
# differential checks these queries against the independent Jo classifier.
ow_boolean_tag=(tag:int64):>bool=>$unsafe {
    ((tag >=? 19) and (tag <=? 28))
}

ow_arity=(tag:int64 mode:int64):>int64=>$unsafe {
    if ((tag =? 59) and ((mode & 128) not=? 0)) {
        return 2
    }
    (OptWord(((((opt_decode[tag] >> 4)) & 7))) - OptWord(int64(1)))
}

ow_operands=(ins:ptr<Ins>):>int64=>$unsafe {
    let mode=opt_operands[oc_tag(ins)]
    opt_use_span=(- OptWord(int64(1)))
    opt_use_values[0]=int64(ins[0].a)
    opt_use_values[1]=int64(ins[0].b)
    opt_use_values[2]=int64(ins[0].c)
    opt_use_count=(mode & 7)
    if ((mode & 16) not=? 0) {
        opt_use_span=int64(ins[0].a)
        opt_use_span_count=int64(ins[0].b)
        opt_use_count=int64(ins[0].b)
        if ((mode & 128) not=? 0) {
            opt_use_count=(OptWord(opt_use_count) + OptWord(int64(1)))
        }
    }
    else {
        if (((mode & 256) not=? 0) and (ins[0].a <? 0)) {
            opt_use_count=0
        }
        if (((mode & 32) not=? 0) and ((int64(ins[0].c) & 128) not=? 0)) {
            opt_use_count=(OptWord(opt_use_count) + OptWord(int64(1)))
        }
        if ((mode & 64) not=? 0) {
            opt_use_values[2]=int64(ins[0].dst)
            if ((mode & 32) =? 0) {
                opt_use_count=(OptWord(opt_use_count) + OptWord(int64(1)))
            }
        }
    }
    if ((mode & 8) not=? 0) {
        return int64(ins[0].dst)
    }
    (- OptWord(int64(1)))
}

ow_use=(i:int64):>int64=>$unsafe {
    if (opt_use_span >=? 0) {
        if (i <? opt_use_span_count) {
            return int64(opt_args[(OptWord(opt_use_span) + OptWord(i))])
        }
        return opt_use_values[2]
    }
    opt_use_values[i]
}

ow_rewrite=(ins:ptr<Ins>):>void=>$unsafe {
    let mask=(opt_decode[oc_tag(ins)] >> 8)
    if ((mask & 16) not=? 0) {
        loop k in [int64(ins[0].a)..(OptWord(int64(ins[0].a)) + OptWord(int64(ins[0].b)))) {
            opt_args[k]=o_regs[int64(opt_args[k])].repl
        }
    }
    else {ow_rewrite_fields(@ins[0] mask)}
    if ((mask & 4) not=? 0) {
        ins[0].c=o_regs[int64(ins[0].c)].repl
    }
}

ow_rewrite_fields=(@ins:Ins mask:int64):>void=>$unsafe {
    let regs=o_regs
    if (((mask & 1) not=? 0) or ((((mask & 32) not=? 0) and (ins.a >=? 0)))) {
        ins.a=regs[int64(ins.a)].repl
    }
    if (((mask & 2) not=? 0) or ((((mask & 64) not=? 0) and ((int64(ins.c) & 128) not=? 0)))) {
        ins.b=regs[int64(ins.b)].repl
    }
    if (((mask & 8) not=? 0) or ((((mask & 128) not=? 0) and ((int64(ins.c) & 128) not=? 0)))) {
        ins.dst=regs[int64(ins.dst)].repl
    }
}

ow_log2_exact=(x:int64):>int64=>$unsafe {
    if ((x <=? 0) or ((x & ((OptWord(x) - OptWord(int64(1))))) not=? 0)) {
        return (- OptWord(int64(1)))
    }
    let k:OptWord=0
    loop (((OptWord(int64(1)) << k)) not=? x) {
        k=(OptWord(k) + OptWord(int64(1)))
    }
    k
}

ow_shru_val=(a:int64 k:int64):>int64=>$unsafe {
    if (k =? 0) {
        return a
    }
    (((a >> k)) & ((OptWord(((OptWord(int64(1)) << ((OptWord(int64(64)) - OptWord(k)))))) - OptWord(int64(1)))))
}

ow_ult=(a:int64 b:int64):>bool=>$unsafe {
    ((((a xor OW_MIN_INT))) <? (((b xor OW_MIN_INT))))
}

ow_is_k=(v:int64):>bool=>$unsafe {
    o_regs[v].constant
}
# fold an integer operation on constants; returns (ok, value)

ow_fold=(op:Op x:int64 y:int64):>[bool int64]=>$unsafe {
    match op {
        <'overflow_add'> => {
            [true int64(ow_word_overflow(0 x y))]
        }
        <'overflow_sub'> => {
            [true int64(ow_word_overflow(1 x y))]
        }
        <'overflow_mul'> => {
            [true int64(ow_word_overflow(2 x y))]
        }
        <'add'> => {
            [true (OptWord(x) + OptWord(y))]
        }
        <'sub'> => {
            [true (OptWord(x) - OptWord(y))]
        }
        <'mul'> => {
            [true (OptWord(x) * OptWord(y))]
        }
        <'divs'> => {
            if ((y =? 0) or (((x =? OW_MIN_INT) and (y =? (- OptWord(int64(1))))))) {
                return [false 0]
            }
            [true ow_trunc_div(x y)]
        }
        <'rems'> => {
            if ((y =? 0) or (((x =? OW_MIN_INT) and (y =? (- OptWord(int64(1))))))) {
                return [false 0]
            }
            [true (OptWord(x) - OptWord((OptWord(ow_trunc_div(x y)) * OptWord(y))))]
        }
        <'and_'> => {
            [true (x & y)]
        }
        <'or_'> => {
            [true (x or y)]
        }
        <'xor'> => {
            [true ((x xor y))]
        }
        <'shl'> => {
            [true (OptWord(x) << ((y & 63)))]
        }
        <'shrs'> => {
            [true (x >> ((y & 63)))]
        }
        <'shru'> => {
            [true ow_shru_val(x (y & 63))]
        }
        <'eq'> => {
            [true int64((x =? y))]
        }
        <'ne'> => {
            [true int64((x not=? y))]
        }
        <'lts'> => {
            [true int64((x <? y))]
        }
        <'les'> => {
            [true int64((x <=? y))]
        }
        <'gts'> => {
            [true int64((x >? y))]
        }
        <'ges'> => {
            [true int64((x >=? y))]
        }
        <'ltu'> => {
            [true int64(ow_ult(x y))]
        }
        <'leu'> => {
            [true int64((not ow_ult(y x)))]
        }
        <'gtu'> => {
            [true int64(ow_ult(y x))]
        }
        <'geu'> => {
            [true int64((not ow_ult(x y)))]
        }
        _ => {
            [false 0]
        }
    }
}

ow_fold_un=(op:Op x:int64):>[bool int64]=>$unsafe {
    match op {
        <'neg'> => {
            [true (- OptWord(x))]
        }
        <'not_'> => {
            [true (not x)]
        }
        <'sext8'> => {
            [true (((OptWord(x) << 56)) >> 56)]
        }
        <'sext16'> => {
            [true (((OptWord(x) << 48)) >> 48)]
        }
        <'sext32'> => {
            [true (((OptWord(x) << 32)) >> 32)]
        }
        <'zext8'> => {
            [true (x & 255)]
        }
        <'zext16'> => {
            [true (x & 65535)]
        }
        <'zext32'> => {
            [true (x & 4294967295)]
        }
        _ => {
            [false 0]
        }
    }
}
# comparison with its operands swapped

ow_mirror=(op:Op):>Op=>$unsafe {
    match op {
        <'lts'> => {
            'gts'
        }
        <'les'> => {
            'ges'
        }
        <'gts'> => {
            'lts'
        }
        <'ges'> => {
            'les'
        }
        <'ltu'> => {
            'gtu'
        }
        <'leu'> => {
            'geu'
        }
        <'gtu'> => {
            'ltu'
        }
        <'geu'> => {
            'leu'
        }
        _ => {
            op
        }
    }
}

ow_commutes=(op:Op):>bool=>$unsafe {
    (((((((op =? 'add') or (op =? 'mul')) or (op =? 'and_')) or (op =? 'or_')) or (op =? 'xor')) or (op =? 'eq')) or (op =? 'ne'))
}
# Function-local output arena. The cleanup consumer borrows it; published IR
# owns a different array. Every append checks capacity before taking its address.

ow_flow_begin=():>void=>$unsafe {
    if (o_flow_storage.length <? opt_input_count) {
        o_flow_storage.resize(opt_input_count)
    }
    o_flow=o_flow_storage.ptr
    if (o_flow_open_storage.length <? opt_input_count) {
        o_flow_open_storage.resize(opt_input_count)
    }
    o_flow_open=o_flow_open_storage.ptr
    o_flow_level=(- OptWord(int64(1)))
    o_flow_at_storage.resize(o_capacity)
    o_flow_at=o_flow_at_storage.ptr
    o_flow_count=0
    o_flow_top=(- OptWord(int64(1)))
    o_flow_dead=false
    o_flow_depth=0
    o_dead_first.clear()
    o_dead_limit.clear()
}

ow_flow_exit=(distance:int64):>void=>$unsafe {
    let level=(OptWord(o_flow_level) - OptWord(distance))
    if (level <? 0) {
        return
    }
    let target=int64(o_flow_open[level])
    if (o_flow[target].kind not=? 'loop') {
        o_flow[target].exit=true
    }
}

ow_flow_end_dead=():>void=>$unsafe {
    if (o_dead_start <? o_count) {
        o_dead_first.push(o_dead_start)
        o_dead_limit.push(o_count)
    }
}
# Callers select control operations; data emission never enters this path.

ow_flow_emit=(ins:ptr<Ins>):>void=>$unsafe {
    if (o_count =? o_capacity) {
        ow_grow_output()
    }
    let control=(((opt_decode[oc_tag(ins)] >> 20)) & 15)
    if o_flow_dead {
        if ((control >=? 2) and (control <=? 4)) {
            o_flow_depth=(OptWord(o_flow_depth) + OptWord(int64(1)))
            return
        }
        if ((control =? 5) or (control =? 6)) {
            if (o_flow_depth >? 0) {
                if (control =? 6) {
                    o_flow_depth=(OptWord(o_flow_depth) - OptWord(int64(1)))
                }
                return
            }
            ow_flow_end_dead()
        }
        else {
            return
        }
    }
    if ((control >=? 2) and (control <=? 4)) {
        let index=o_flow_count
        o_flow_count=(OptWord(o_flow_count) + OptWord(int64(1)))
        o_flow[index]=OptFlow(ins[0].op o_flow_top o_count false false)
        o_flow_top=index
        o_flow_level=(OptWord(o_flow_level) + OptWord(int64(1)))
        o_flow_open[o_flow_level]=OptIndex(index)
        o_flow_at[o_count]=OptIndex(index)
    }
    else if (control =? 5) {
        o_flow[o_flow_top].exit=(o_flow[o_flow_top].exit or (not o_flow_dead))
        o_flow[o_flow_top].kind='else_'
        o_flow_dead=false
    }
    else if (control =? 6) {
        o_flow_dead=((o_flow_dead and (not o_flow[o_flow_top].exit)) and (o_flow[o_flow_top].kind not=? 'if_'))
        o_flow[o_flow_top].terminated=o_flow_dead
        o_flow_at[o_count]=OptIndex(o_flow_top)
        o_flow_top=o_flow[o_flow_top].parent
        o_flow_level=(OptWord(o_flow_level) - OptWord(int64(1)))
        if o_flow_dead {
            o_dead_start=(OptWord(o_count) + OptWord(int64(1)))
        }
    }
    else {
        if (((control =? 7) or (control =? 8)) or (control =? 9)) {
            ow_flow_exit(int64(ins[0].imm))
            if (control =? 9) {
                loop k in [0..int64(ins[0].b)) {
                    ow_flow_exit(int64(opt_args[(OptWord(int64(ins[0].c)) + OptWord(k))]))
                }
            }
        }
        if (((((control =? 7) or (control =? 9)) or (control =? 10)) or (control =? 11)) or (((control =? 12) and (ins[0].c =? 1)))) {
            o_flow_dead=true
            o_flow_depth=0
            o_dead_start=(OptWord(o_count) + OptWord(int64(1)))
        }
    }
}

ow_flow_pop=():>void=>$unsafe {
    # Only an empty block/if opener can be removed by the forward writer.
    if o_flow_dead {
        o_flow_depth=(OptWord(o_flow_depth) - OptWord(int64(1)))
    }
    else {
        o_flow_top=o_flow[o_flow_top].parent
        o_flow_level=(OptWord(o_flow_level) - OptWord(int64(1)))
        o_flow_count=(OptWord(o_flow_count) - OptWord(int64(1)))
    }
}

ow_grow_output=():>void=>$unsafe {
    o_capacity=max(32 (OptWord(o_capacity) * OptWord(int64(2))))
    o_out_storage.resize(o_capacity)
    o_out=o_out_storage.ptr
    o_flow_at_storage.resize(o_capacity)
    o_flow_at=o_flow_at_storage.ptr
}

ow_append_plain=(ins:Ins):>void=>$unsafe {
    if (o_count =? o_capacity) {
        ow_grow_output()
    }
    o_out[o_count]=ins
    o_count=(OptWord(o_count) + OptWord(int64(1)))
}

ow_append=(ins:Ins):>void=>$unsafe {
    if (o_count =? o_capacity) {
        ow_grow_output()
    }
    o_out[o_count]=ins
    ow_flow_emit((o_out + o_count))
    o_count=(OptWord(o_count) + OptWord(int64(1)))
}

let o_kcount:OptWord=0
ow_kmap_reset=(n:int64):>void=>$unsafe {
    let need:OptWord=64
    let target=(OptWord(n) * OptWord(int64(4)))
    loop need <? target {need=(OptWord(need) * OptWord(int64(2)))}
    if o_kepoch.length <? need {
        o_kval.resize(need)
        o_kreg.resize(need)
        o_kepoch.resize(need)
    }
    o_kmask=(OptWord(o_kepoch.length) - OptWord(int64(1)))
    o_kfn=(OptWord(o_kfn) + OptWord(int64(1)))
    o_kcount=0
}

ow_kmap_get=(v:int64):>int64=>$unsafe {
    let mask=o_kmask
    let fn_=o_kfn
    let epochs=o_kepoch.ptr
    let vals=o_kval.ptr
    let i=((((OptWord(v) * OptWord((- OptWord(int64(7046029254386353131))))) >> 29)) & mask)
    loop epochs[i] =? fn_ {
        if vals[i] =? v {return int64(o_kreg.ptr[i])}
        i=((OptWord(i) + OptWord(int64(1))) & mask)
    }
    -1
}

ow_kmap_put=(v:int64 r:int64):>void=>$unsafe {
    if (OptWord(o_kcount) + OptWord(1)) * OptWord(2) >=? o_kepoch.length {
        let old_len=o_kepoch.length
        let new_len=(OptWord(old_len) * OptWord(int64(2)))
        let old_vals=o_kval
        let old_regs=o_kreg
        let old_ep=o_kepoch
        let old_fn=o_kfn
        o_kval=fill(int64(0) new_len)
        o_kreg=fill(int32(0) new_len)
        o_kepoch=fill(int64(0) new_len)
        o_kmask=(OptWord(new_len) - OptWord(int64(1)))
        o_kfn=(OptWord(old_fn) + OptWord(int64(1)))
        o_kcount=0
        loop j in [0..old_len) {
            if old_ep.ptr[j] =? old_fn {ow_kmap_put(old_vals.ptr[j] int64(old_regs.ptr[j]))}
        }
    }
    let mask=o_kmask
    let fn_=o_kfn
    let epochs=o_kepoch.ptr
    let vals=o_kval.ptr
    let i=((((OptWord(v) * OptWord((- OptWord(int64(7046029254386353131))))) >> 29)) & mask)
    loop epochs[i] =? fn_ {
        if vals[i] =? v {return}
        i=((OptWord(i) + OptWord(int64(1))) & mask)
    }
    epochs[i]=fn_
    vals[i]=v
    o_kreg.ptr[i]=OptIndex(r)
    o_kcount=(OptWord(o_kcount) + OptWord(1))
}

ow_kconst=(v:int64):>int64=>$unsafe {
    if ow_fits32(v) {
        let c=ow_kmap_get(v)
        if c >=? 0 {
            return c
        }
        let k=ow_k_vreg(v)
        ow_resize_one(k)
        o_regs[k].ndef=1
        o_regs[k].stable=true
        o_regs[k].constant=true
        o_regs[k].cval=v
        ow_kmap_put(v k)
        return k
    }
    let d=ow_vreg(0)
    ow_resize_one(d)
    o_regs[d].ndef=1
    o_regs[d].stable=true
    o_regs[d].constant=true
    o_regs[d].cval=v
    ow_emit(Ins('iconst' 0 OptIndex(d) 0 0 0 v))
    int64(o_regs[d].repl)
}

ow_resize_one=(d:int64):>void=>$unsafe {
    if (o_reg_count <=? d) {
        o_reg_storage.resize((OptWord(d) + OptWord(int64(1))))
        o_regs=o_reg_storage.ptr
        o_reg_count=(OptWord(d) + OptWord(int64(1)))
        o_fact_scope.resize((OptWord(((OptWord(d) + OptWord(int64(1))))) * OptWord(int64(2))))
        o_fact_nbr.resize((OptWord(((OptWord(d) + OptWord(int64(1))))) * OptWord(int64(2))))
    }
    let reg=(o_regs + d)
    reg[0].ndef=0
    reg[0].stable=false
    reg[0].defpos=(- OptWord(int64(1)))
    reg[0].first=2147483647
    reg[0].nuse=0
    reg[0].constant=false
    reg[0].repl=OptIndex(d)
    reg[0].ver=0
    reg[0].dop=(- OptWord(int64(1)))
}
# (results may be replaced by an existing equal value)

ow_bin=(op:Op d:int64 a:int64 b:int64):>int64=>$unsafe {
    ow_emit(Ins(op 0 OptIndex(d) OptIndex(a) OptIndex(b) 0 0))
    int64(o_regs[d].repl)
}

ow_tmp=():>int64=>$unsafe {
    let d=ow_vreg(0)
    ow_resize_one(d)
    o_regs[d].ndef=1
    o_regs[d].stable=true
    d
}
# can uses of d be replaced by s? both must be single-definition values defined before use

ow_can_alias=(d:int64 s:int64):>bool=>$unsafe {
    if (o_regs[d].ndef not=? 1) {
        return false
    }
    if (o_regs[d].first <? o_regs[d].defpos) {
        return false
    }
    if (o_regs[s].ndef not=? 1) {
        return ((ow_vtype(d) =? ow_vtype(s)) and ow_holds(d s))
    }
    if ((s >=? opt_nparams) and (o_regs[s].first <? o_regs[s].defpos)) {
        return false
    }
    (ow_vtype(d) =? ow_vtype(s))
}
# d = s (s defined more than once, like a loop counter): may d's uses read s instead? Yes if s
# is not redefined from there to d's last use, and the copy dominates the uses (the construct
# open at the copy stays open: no path reaches a use around it, as through a loop's back edge).
# A use in a loop entered after the copy sees s again on the next iteration: s must not change
# anywhere in that loop either.

let o_holds_open:array<Op>=[]
ow_holds=(d:int64 s:int64):>bool=>$unsafe {
    let q=int64(o_regs[d].defpos)
    let e=int64(o_lastuse[d])
    if ((q <? 0) or (e <? q)) {
        return false
    }
    let dq=o_depth[q]
    # (constructs opened after the copy, and how deep the outermost loop among them is)
    o_holds_open.clear()
    let open=o_holds_open
    o_holds_open=[]
    let loop_at:OptWord=(- OptWord(int64(1)))
    let p=(OptWord(q) + OptWord(int64(1)))
    let ok=true
    loop ((p <=? e) or (((loop_at >=? 0) and (open.length >? loop_at)))) {
        if ((p >=? opt_input_count) or ((OptWord(p) - OptWord(q)) >? 4000)) {
            ok=false; break
        }
        let ins=(opt_input + p)
        let op=ins[0].op
        if (o_depth[p] <? dq) {
            ok=false; break
        }
        if ((op =? 'else_') and (o_depth[p] =? dq)) {
            ok=false; break
        }
        if (((opt_decode[oc_tag(ins)] & 1) not=? 0) and (int64(ins[0].dst) =? s)) {
            ok=false; break
        }
        if (op =? 'zeroslots') {
            let hit=false
            loop k in [0..int64(ins[0].b)) {
                let item=int64(opt_args[(OptWord(int64(ins[0].a)) + OptWord(k))])
                if (((item & 1) =? 1) and ((item >> 1) =? s)) {
                    hit=true; break
                }
            }
            if hit {ok=false; break}
        }
        if (((op =? 'block') or (op =? 'if_')) or (op =? 'loop')) {
            open.push(op)
        }
        else if ((op =? 'end') and (open.length >? 0)) {
            open.pop();
        }
        if (p =? e) {
            loop j in [0..open.length) {
                if (open[j] =? 'loop') {
                    loop_at=j
                    break
                }
            }
        }
        p=(OptWord(p) + OptWord(int64(1)))
    }
    o_holds_open=open
    ok
}
# ---------------- common subexpressions ----------------
# A hash table of available values keyed by (op, type, operands, immediate). Entries belong to
# their control construct. An unconditional block can export its prefix before
# the first branch; conditional arms and loops never export. Loads also die when
# memory may have changed (any store or call bumps the memory generation).
# Keep one probed entry together instead of visiting ten separate arrays.
# The key and validity metadata occupy 64 bytes; their meaning is unchanged.

let o_loop_depth:OptWord=0
ow_ht_setup=(n:int64):>void=>$unsafe {
    let size:OptWord=64
    loop (size <? (OptWord(n) * OptWord(int64(4)))) {
        size=(OptWord(size) * OptWord(int64(2)))
    }
    if (ht_storage.length <? size) {
        ht_storage.resize(size)
    }
    ht_entries=ht_storage.ptr
    ht_mask=(OptWord(size) - OptWord(int64(1)))
    o_epoch=(OptWord(o_epoch) + OptWord(int64(1)))
    o_gen=0
    o_genf=(OptWord(int64(1)) << 40)
    o_genh=(OptWord(int64(2)) << 40)
    o_scope_storage.clear()
    o_scopes.clear()
    ow_scope_open()
}

ow_scope_open=(export_prefix:bool=false):>void=>$unsafe {
    if not o_cse {return}
    let parent:OptWord=(- OptWord(int64(1)))
    if (o_scopes.length >? 0) {
        parent=o_scopes[(OptWord(o_scopes.length) - OptWord(int64(1)))]
    }
    o_scope_storage.push(OptScope(o_nbr OptIndex(parent) true export_prefix))
    o_scope_info=o_scope_storage.ptr
    o_scopes.push((OptWord(o_scope_storage.length) - OptWord(int64(1))))
}

ow_scope_close=():>void=>$unsafe {
    if not o_cse {return}
    o_scope_info[o_scopes.pop()].open=false
}

ow_ht_slot=(k1:int64 k2:int64 k3:int64):>int64=>$unsafe {
    let h=((((OptWord(k1) * OptWord((- OptWord(int64(7046029254386353131)))))) xor ((OptWord(k2) * OptWord((- OptWord(int64(4417276706812531889))))))) xor ((OptWord(k3) * OptWord(int64(1609587929392839161)))))
    let i=(((h >> 29)) & ht_mask)
    loop (ht_entries[i].epoch =? o_epoch) {
        if (((ht_entries[i].key1 =? k1) and (ht_entries[i].key2 =? k2)) and (ht_entries[i].key3 =? k3)) {
            return i
        }
        i=(((OptWord(i) + OptWord(int64(1)))) & ht_mask)
    }
    i
}

ow_ht_available=(i:int64 gen:int64 va:int64 vb:int64):>int64=>$unsafe {
    let entry=(ht_entries + i)
    if (entry[0].epoch not=? o_epoch) {
        return (- OptWord(int64(1)))
    }
    let scope=int64(entry[0].scope)
    loop (not o_scope_info[scope].open) {
        # Every exit from this block passes its straight-line prefix. After
        # any earlier branch the value might have been skipped, so discard it.
        if ((not o_scope_info[scope].export_prefix) or (entry[0].branches not=? o_scope_info[scope].branches)) {
            return (- OptWord(int64(1)))
        }
        scope=int64(o_scope_info[scope].parent)
        if (scope <? 0) {
            return (- OptWord(int64(1)))
        }
    }
    if ((gen >=? 0) and (entry[0].generation not=? gen)) {
        return (- OptWord(int64(1)))
    }
    if ((int64(entry[0].version_a) not=? va) or (int64(entry[0].version_b) not=? vb)) {
        return (- OptWord(int64(1)))
    }
    int64(entry[0].value)
}

ow_mem_gen=(mode:int64):>int64=>$unsafe {
    if opt_raw_mem {
        return o_gen
    }
    if ((mode & 64) not=? 0) {
        return o_genh
    }
    if ((mode & 32) not=? 0) {
        return o_genf
    }
    o_gen
}

ow_kill_mem=(mode:int64):>void=>$unsafe {
    if opt_raw_mem {
        ow_kill_all()
    }
    else if ((mode & 64) not=? 0) {
        o_genh=(OptWord(o_genh) + OptWord(int64(1)))
    }
    else if ((mode & 32) not=? 0) {
        o_genf=(OptWord(o_genf) + OptWord(int64(1)))
    }
    else {
        o_gen=(OptWord(o_gen) + OptWord(int64(1)))
    }
}

ow_kill_all=():>void=>$unsafe {
    o_gen=(OptWord(o_gen) + OptWord(int64(1)))
    o_genf=(OptWord(o_genf) + OptWord(int64(1)))
    o_genh=(OptWord(o_genh) + OptWord(int64(1)))
}

ow_ht_put_gen=(k1:int64 k2:int64 k3:int64 v:int64 gen:int64 va:int64 vb:int64):>void=>$unsafe {
    ow_ht_insert(ow_ht_slot(k1 k2 k3) k1 k2 k3 v gen va vb)
}

ow_load_key1=(ty:int64 mode:int64 addr:int64):>int64=>$unsafe {
    (((59 or ((OptWord(ty) << 8))) or ((OptWord(((mode & 4095))) << 12))) or ((OptWord(addr) << 24)))
}

ow_ht_insert=(i:int64 k1:int64 k2:int64 k3:int64 v:int64 gen:int64 va:int64 vb:int64):>void=>$unsafe {
    # The probe returns an index masked to the current table capacity.
    let scope=OptIndex(o_scopes[(OptWord(o_scopes.length) - OptWord(int64(1)))])
    ht_entries[i]=AvailableValue(k1 k2 k3 OptIndex(v) scope o_nbr gen o_epoch OptIndex(va) OptIndex(vb))
}
# a value that is defined once and never read before its definition

ow_stable=(v:int64):>bool=>$unsafe {
    o_regs[v].stable
}
# Available expressions have at most two register operands, always a then b.
# Read their versions directly instead of filling the general operand buffer
# for every expression. -1 means the instruction is not an available value.

ow_push=(ins:ptr<Ins>):>void=>$unsafe {
    let dw=opt_decode[oc_tag(ins)]
    let regs=o_regs
    if (dw & 1) not=? 0 {
        let d=int64(ins[0].dst)
        if d >=? 0 {regs[d].ver=(OptIndex(regs[d].ver) + OptIndex(1))}
    }
    let mask=(dw >> 8) & 255
    if mask =? 1 {regs[int64(ins[0].a)].nuse=(OptIndex(regs[int64(ins[0].a)].nuse) + OptIndex(1))}
    else if mask =? 3 {
        regs[int64(ins[0].a)].nuse=(OptIndex(regs[int64(ins[0].a)].nuse) + OptIndex(1))
        regs[int64(ins[0].b)].nuse=(OptIndex(regs[int64(ins[0].b)].nuse) + OptIndex(1))
    }
    else if mask =? 16 or mask =? 20 {
        let a0=int64(ins[0].a)
        let args=opt_args
        loop k in [a0..(OptWord(a0) + OptWord(int64(ins[0].b)))) {
            regs[int64(args[k])].nuse=(OptIndex(regs[int64(args[k])].nuse) + OptIndex(1))
        }
        if mask =? 20 {regs[int64(ins[0].c)].nuse=(OptIndex(regs[int64(ins[0].c)].nuse) + OptIndex(1))}
    }
    else if mask =? 65 {
        regs[int64(ins[0].a)].nuse=(OptIndex(regs[int64(ins[0].a)].nuse) + OptIndex(1))
        if (int64(ins[0].c) & 128) not=? 0 {regs[int64(ins[0].b)].nuse=(OptIndex(regs[int64(ins[0].b)].nuse) + OptIndex(1))}
    }
    else if mask =? 131 {
        regs[int64(ins[0].a)].nuse=(OptIndex(regs[int64(ins[0].a)].nuse) + OptIndex(1))
        regs[int64(ins[0].b)].nuse=(OptIndex(regs[int64(ins[0].b)].nuse) + OptIndex(1))
        if (int64(ins[0].c) & 128) not=? 0 {regs[int64(ins[0].dst)].nuse=(OptIndex(regs[int64(ins[0].dst)].nuse) + OptIndex(1))}
    }
    else if mask =? 32 {
        if ins[0].a >=? 0 {regs[int64(ins[0].a)].nuse=(OptIndex(regs[int64(ins[0].a)].nuse) + OptIndex(1))}
    }
    else if mask =? 7 {
        regs[int64(ins[0].a)].nuse=(OptIndex(regs[int64(ins[0].a)].nuse) + OptIndex(1))
        regs[int64(ins[0].b)].nuse=(OptIndex(regs[int64(ins[0].b)].nuse) + OptIndex(1))
        regs[int64(ins[0].c)].nuse=(OptIndex(regs[int64(ins[0].c)].nuse) + OptIndex(1))
    }
    else if mask =? 11 {
        regs[int64(ins[0].a)].nuse=(OptIndex(regs[int64(ins[0].a)].nuse) + OptIndex(1))
        regs[int64(ins[0].b)].nuse=(OptIndex(regs[int64(ins[0].b)].nuse) + OptIndex(1))
        regs[int64(ins[0].dst)].nuse=(OptIndex(regs[int64(ins[0].dst)].nuse) + OptIndex(1))
    }
    let control=((dw >> 20) & 15)
    if (((control >=? 2) and (control <=? 11)) or (((control =? 12) and (ins[0].c =? 1)))) {
        ow_flow_emit(ins)
    }
    if (o_count =? o_capacity) {
        ow_grow_output()
    }
    o_out[o_count]=ins[0]
    o_count=(OptWord(o_count) + OptWord(1))
}
# drop the last output instruction (an empty construct's opening)

ow_pop=():>void=>$unsafe {
    ow_flow_pop()
    o_count=(OptWord(o_count) - OptWord(int64(1)))
    let ins=o_out[o_count]
    if (ins.op =? 'if_') {
        o_regs[int64(ins.a)].nuse=(OptIndex(o_regs[int64(ins.a)].nuse) - OptIndex(OptIndex(int64(1))))
    }
}

ow_join_kill=(head0:int64):>void=>$unsafe {
    let head=head0
    loop (head >=? 0) {
        o_regs[o_join_regs[head]].ver=(OptIndex(o_regs[o_join_regs[head]].ver) + OptIndex(OptIndex(int64(1))))
        head=o_join_next[head]
    }
}

ow_branch_copy=():>int64=>$unsafe {
    let n=o_count
    if ((n <? 3) or (o_out[(OptWord(n) - OptWord(int64(2)))].op not=? 'mov')) {
        return (- OptWord(int64(1)))
    }
    let d=int64(o_out[(OptWord(n) - OptWord(int64(2)))].dst)
    if (((d <? 0) or (o_regs[d].ndef <=? 1)) or (o_regs[d].repl not=? OptIndex(d))) {
        return (- OptWord(int64(1)))
    }
    let i=(OptWord(n) - OptWord(int64(3)))
    let floor=max(0 (OptWord(n) - OptWord(int64(19))))
    loop (i >=? floor) {
        let ins=(o_out + i)
        let op=ins[0].op
        if (op =? 'brif') {
            if (ins[0].imm =? 0) {
                return d
            }
            return (- OptWord(int64(1)))
        }
        if ((((((((((op =? 'block') or (op =? 'loop')) or (op =? 'if_')) or (op =? 'else_')) or (op =? 'end')) or (op =? 'br')) or (op =? 'brtable')) or (op =? 'ret')) or (op =? 'trap')) or (op =? 'zeroslots')) {
            return (- OptWord(int64(1)))
        }
        if (((opt_decode[oc_tag(ins)] & 1) not=? 0) and (ins[0].dst =? OptIndex(d))) {
            return (- OptWord(int64(1)))
        }
        i=(OptWord(i) - OptWord(int64(1)))
    }
    (- OptWord(int64(1)))
}
# v was computed by `op` from operands that still hold the same values here

ow_def_is=(v:int64 op:int64):>bool=>$unsafe {
    let reg=(o_regs + v)
    if ((not reg[0].stable) or (reg[0].dop not=? OptIndex(op))) {
        return false
    }
    ((o_regs[int64(reg[0].da)].ver =? reg[0].dva) and (o_regs[int64(reg[0].db)].ver =? reg[0].dvb))
}
# Bounded expression queries use CSE's operand-version checks, so a changed
# loop variable cannot lend an old range or rotate identity to its new value.

ow_dop_width_mask=(dop:int64 mode:int64 has_k:bool k:int64):>int64=>$unsafe {
    if dop =? 50 {return 62}
    if dop =? 51 {return 52}
    if dop =? 52 {return 32}
    if dop =? 47 {return 7}
    if dop =? 48 {return 6}
    if dop =? 49 {return 4}
    if dop =? 59 {
        let sz=mode & 15
        let sg=(mode & 16) not=? 0
        if sz =? 1 {return if sg {7} else {62}}
        if sz =? 2 {return if sg {6} else {52}}
        if sz =? 4 {return if sg {4} else {32}}
        return 0
    }
    if not has_k {return 0}
    if dop =? 11 {
        if k >=? 0 {
            if k <=? 127 {return 63}
            if k <=? 255 {return 62}
            if k <=? 32767 {return 54}
            if k <=? 65535 {return 52}
            if k <=? 2147483647 {return 36}
            if k <=? 4294967295 {return 32}
        }
        return 0
    }
    if dop =? 16 {
        if k >=? 32 and k <? 64 {
            if k >=? 57 {return 63}
            if k >=? 56 {return 62}
            if k >=? 49 {return 54}
            if k >=? 48 {return 52}
            if k >=? 33 {return 36}
            return 32
        }
        return 0
    }
    if dop =? 15 {
        if k >=? 32 and k <? 64 {
            if k >=? 56 {return 7}
            if k >=? 48 {return 6}
            return 4
        }
        return 0
    }
    0
}

ow_width_mask=(v:int64):>int64=>$unsafe {
    if not ow_stable(v) {return 0}
    let dop=int64(o_regs[v].dop)
    if (dop =? 95) or (dop =? 103) or ow_boolean_tag(dop) {return 63}
    if dop =? 102 {return 32}
    let mode:int64=0
    if dop =? 59 {
        let dp=int64(o_regs[v].defpos)
        if dp >=? 0 and dp <? opt_input_count and opt_input[dp].op =? 'load' and int64(opt_input[dp].dst) =? v {mode=int64(opt_input[dp].c)}
    }
    let has_k=(dop =? 11 or dop =? 15 or dop =? 16) and ow_def_is(v dop) and ow_is_k(int64(o_regs[v].db))
    let k:int64=if has_k {o_regs[int64(o_regs[v].db)].cval} else {0}
    ow_dop_width_mask(dop mode has_k k)
}

ow_ext_bit=(op:Op):>int64=>$unsafe {
    match op {
        <'sext8'> => {1}
        <'sext16'> => {2}
        <'sext32'> => {4}
        <'zext8'> => {8}
        <'zext16'> => {16}
        <'zext32'> => {32}
        _ => {0}
    }
}

ow_unsigned32=(v:int64 depth:int64=0):>bool=>$unsafe {
    if ow_is_k(v) {
        return ((o_regs[v].cval >=? 0) and (o_regs[v].cval <=? 4294967295))
    }
    if (((ow_def_is(v 52) or ow_def_is(v 51)) or ow_def_is(v 50)) or ow_def_is(v 102)) {
        return true
    }
    if (ow_width_mask(v) & 32) not=? 0 {
        return true
    }
    if (depth >=? 4) {
        return false
    }
    if ow_def_is(v 11) {
        return (ow_unsigned32(int64(o_regs[v].da) (OptWord(depth) + OptWord(int64(1)))) or ow_unsigned32(int64(o_regs[v].db) (OptWord(depth) + OptWord(int64(1)))))
    }
    if (ow_def_is(v 12) or ow_def_is(v 13)) {
        return (ow_unsigned32(int64(o_regs[v].da) (OptWord(depth) + OptWord(int64(1)))) and ow_unsigned32(int64(o_regs[v].db) (OptWord(depth) + OptWord(int64(1)))))
    }
    if ow_def_is(v 16) {
        return ow_unsigned32(int64(o_regs[v].da) (OptWord(depth) + OptWord(int64(1))))
    }
    false
}

ow_unwrap32=(v:int64):>int64=>$unsafe {
    (if ow_def_is(v 52) {int64(o_regs[v].da)} else {v})
}
# A four-edge query only at shift/count consumers. CSE versions invalidate
# stale operands; no function scan or new analysis state is needed.

ow_small_count=(v:int64 depth:int64=0):>int64=>$unsafe {
    if ow_is_k(v) {
        return (if ((o_regs[v].cval >=? 0) and (o_regs[v].cval <=? 64)) {o_regs[v].cval} else {(- OptWord(int64(1)))})
    }
    if (depth >=? 4) {
        return (- OptWord(int64(1)))
    }
    if ow_def_is(v 11) {
        let a=ow_small_count(int64(o_regs[v].da) (OptWord(depth) + OptWord(int64(1))))
        let b=ow_small_count(int64(o_regs[v].db) (OptWord(depth) + OptWord(int64(1))))
        if ((a >=? 0) and (b >=? 0)) {
            return min(a b)
        }
        return max(a b)
    }
    if (ow_def_is(v 5) and ow_is_k(int64(o_regs[v].da))) {
        let a=o_regs[int64(o_regs[v].da)].cval
        let b=ow_small_count(int64(o_regs[v].db) (OptWord(depth) + OptWord(int64(1))))
        if ((((a >=? 0) and (a <=? 64)) and (b >=? 0)) and (b <=? a)) {
            return a
        }
    }
    (- OptWord(int64(1)))
}

ow_rotate32=(ins:ptr<Ins>):>bool=>$unsafe {
    if (not opt_rotate32_ok) {
        return false
    }
    let value=int64(ins[0].a)
    if (((ins[0].op =? 'zext32') and ow_def_is(value 12)) or (((ins[0].op =? 'or_') and ow_unsigned32(int64(ins[0].a))) and ow_unsigned32(int64(ins[0].b)))) {
        let left=ow_unwrap32((if (ins[0].op =? 'or_') {int64(ins[0].a)} else {int64(o_regs[value].da)}))
        let right=ow_unwrap32((if (ins[0].op =? 'or_') {int64(ins[0].b)} else {int64(o_regs[value].db)}))
        if ow_def_is(left 16) {
            let saved=left
            left=right
            right=saved
        }
        if (ow_def_is(left 14) and ow_def_is(right 16)) {
            let lc=int64(o_regs[left].db)
            let rc=int64(o_regs[right].db)
            let x=int64(o_regs[right].da)
            let complementary=((((ow_is_k(lc) and ow_is_k(rc)) and (o_regs[lc].cval >=? 0)) and (o_regs[lc].cval <=? 32)) and ((OptWord(o_regs[lc].cval) + OptWord(o_regs[rc].cval)) =? 32))
            if (((ow_def_is(rc 5) and ow_is_k(int64(o_regs[rc].da))) and (o_regs[int64(o_regs[rc].da)].cval =? 32)) and (o_regs[rc].db =? OptIndex(lc))) {
                let limit=ow_small_count(lc)
                complementary=((limit >=? 0) and (limit <=? 32))
            }
            if (((ow_def_is(lc 5) and ow_is_k(int64(o_regs[lc].da))) and (o_regs[int64(o_regs[lc].da)].cval =? 32)) and (o_regs[lc].db =? OptIndex(rc))) {
                let limit=ow_small_count(rc)
                complementary=((limit >=? 0) and (limit <=? 32))
            }
            if ((complementary and (ow_unwrap32(int64(o_regs[left].da)) =? ow_unwrap32(x))) and ow_unsigned32(x)) {
                ins[0]=Ins('rot32' 0 ins[0].dst OptIndex(ow_unwrap32(x)) OptIndex(lc) 0 0)

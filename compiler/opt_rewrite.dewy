$runtime_checks
from p"ir_types.dewy" import (Op Ins IrFn)
from p"opt_workspace.dewy" import (
    OptFlow OptScope OptControl AvailableValue opt_ir ht_entries ht_mask ht_storage lp_defs
    lp_first lp_kills lp_limit lp_next lp_open lp_parent o_capacity o_count o_cse o_dead_first
    o_dead_limit o_dead_start o_depth o_epoch o_fact_nbr o_fact_scope o_flow o_flow_at
    o_flow_at_storage o_flow_count o_flow_dead o_flow_depth o_flow_level o_flow_open
    o_flow_open_storage o_flow_storage o_flow_top o_gen o_genf o_genh o_input_last o_join_next
    o_join_regs o_kmap o_lastuse o_nbr o_out o_out_storage o_reg_count o_reg_storage o_regs
    o_scope_info o_scope_storage o_scopes opt_decode opt_input opt_kc_epoch opt_kc_fn
    opt_kc_reg opt_kc_val opt_mulh_ok opt_operands opt_rotate32_ok opt_use_count opt_use_span
    opt_use_span_count opt_use_values opt_working
)
from p"opt_cleanup.dewy" import (oc_tag opt_cleanup)

# Word arithmetic preserves Jo overflow; IR IDs and bounded cursors are fixed width.
OptWord:type=int64<overflow='wrap'>
OptIndex:type=int32<overflow='wrap'>

const OW_MIN_INT:int64=-9223372036854775807 - 1

ow_vreg=(ty:int64):>int64=>$unsafe {
    opt_ir[0].vtypes.push(int8(ty))
    (OptWord(opt_ir[0].vtypes.length) - OptWord(int64(1)))
}

ow_vtype=(v:int64):>int64=>$unsafe {
    let t=int64(opt_ir[0].vtypes[v])
    if (t =? 3) {
        return 0
    }
    t
}

ow_is_kv=(v:int64):>bool=>$unsafe {
    (int64(opt_ir[0].vtypes[v]) =? 3)
}

ow_k_vreg=(v:int64):>int64=>$unsafe {
    let slot=(((v xor ((v >> 8)))) & 255)
    if ((opt_kc_epoch[slot] =? opt_kc_fn) and (opt_kc_val[slot] =? v)) {
        return opt_kc_reg[slot]
    }
    let d=opt_ir[0].vtypes.length
    opt_ir[0].vtypes.push(int8(3))
    loop (opt_ir[0].kval.length <? d) {
        opt_ir[0].kval.push(0)
    }
    opt_ir[0].kval.push(v)
    opt_kc_epoch[slot]=opt_kc_fn
    opt_kc_val[slot]=v
    opt_kc_reg[slot]=d
    d
}

# ABI ordinals: eq..geu are 19..28; load is 59. The exhaustive operand
# differential checks these queries against the independent Jo classifier.
ow_boolean_tag=(tag:int64):>bool=>$unsafe {
    ((tag >=? 19) and (tag <=? 28))
}

ow_arity=(tag:int64 mode:int64):>int64=>$unsafe {
    if ((tag =? 59) and ((mode & 128) not=? 0)) {
        return 2
    }
    (OptWord(((((opt_decode[tag] >> 4)) & 7))) - OptWord(int64(1)))
}

ow_operands=(ins:ptr<Ins>):>int64=>$unsafe {
    let mode=opt_operands[oc_tag(ins)]
    opt_use_span=(- OptWord(int64(1)))
    opt_use_values[0]=int64(ins[0].a)
    opt_use_values[1]=int64(ins[0].b)
    opt_use_values[2]=int64(ins[0].c)
    opt_use_count=(mode & 7)
    if ((mode & 16) not=? 0) {
        opt_use_span=int64(ins[0].a)
        opt_use_span_count=int64(ins[0].b)
        opt_use_count=int64(ins[0].b)
        if ((mode & 128) not=? 0) {
            opt_use_count=(OptWord(opt_use_count) + OptWord(int64(1)))
        }
    }
    else {
        if (((mode & 256) not=? 0) and (ins[0].a <? 0)) {
            opt_use_count=0
        }
        if (((mode & 32) not=? 0) and ((int64(ins[0].c) & 128) not=? 0)) {
            opt_use_count=(OptWord(opt_use_count) + OptWord(int64(1)))
        }
        if ((mode & 64) not=? 0) {
            opt_use_values[2]=int64(ins[0].dst)
            if ((mode & 32) =? 0) {
                opt_use_count=(OptWord(opt_use_count) + OptWord(int64(1)))
            }
        }
    }
    if ((mode & 8) not=? 0) {
        return int64(ins[0].dst)
    }
    (- OptWord(int64(1)))
}

ow_use=(i:int64):>int64=>$unsafe {
    if (opt_use_span >=? 0) {
        if (i <? opt_use_span_count) {
            return int64(opt_ir[0].args[(OptWord(opt_use_span) + OptWord(i))])
        }
        return opt_use_values[2]
    }
    opt_use_values[i]
}

ow_rewrite=(ins:ptr<Ins>):>void=>$unsafe {
    let mask=(opt_decode[oc_tag(ins)] >> 8)
    if ((mask & 16) not=? 0) {
        loop k in [int64(ins[0].a)..(OptWord(int64(ins[0].a)) + OptWord(int64(ins[0].b)))) {
            opt_ir[0].args[k]=o_regs[int64(opt_ir[0].args[k])].repl
        }
    }
    else {
        if (((mask & 1) not=? 0) or ((((mask & 32) not=? 0) and (ins[0].a >=? 0)))) {
            ins[0].a=o_regs[int64(ins[0].a)].repl
        }
        if (((mask & 2) not=? 0) or ((((mask & 64) not=? 0) and ((int64(ins[0].c) & 128) not=? 0)))) {
            ins[0].b=o_regs[int64(ins[0].b)].repl
        }
        if (((mask & 8) not=? 0) or ((((mask & 128) not=? 0) and ((int64(ins[0].c) & 128) not=? 0)))) {
            ins[0].dst=o_regs[int64(ins[0].dst)].repl
        }
    }
    if ((mask & 4) not=? 0) {
        ins[0].c=o_regs[int64(ins[0].c)].repl
    }
}

ow_log2_exact=(x:int64):>int64=>$unsafe {
    if ((x <=? 0) or ((x & ((OptWord(x) - OptWord(int64(1))))) not=? 0)) {
        return (- OptWord(int64(1)))
    }
    let k:OptWord=0
    loop (((OptWord(int64(1)) << k)) not=? x) {
        k=(OptWord(k) + OptWord(int64(1)))
    }
    k
}

ow_shru_val=(a:int64 k:int64):>int64=>$unsafe {
    if (k =? 0) {
        return a
    }
    (((a >> k)) & ((OptWord(((OptWord(int64(1)) << ((OptWord(int64(64)) - OptWord(k)))))) - OptWord(int64(1)))))
}

ow_ult=(a:int64 b:int64):>bool=>$unsafe {
    ((((a xor OW_MIN_INT))) <? (((b xor OW_MIN_INT))))
}

ow_is_k=(v:int64):>bool=>$unsafe {
    o_regs[v].constant
}
# fold an integer operation on constants; returns (ok, value)

ow_fold=(op:Op x:int64 y:int64):>[bool int64]=>$unsafe {
    match op {
        <'overflow_add'> => {
            [true int64(ow_word_overflow(0 x y))]
        }
        <'overflow_sub'> => {
            [true int64(ow_word_overflow(1 x y))]
        }
        <'overflow_mul'> => {
            [true int64(ow_word_overflow(2 x y))]
        }
        <'add'> => {
            [true (OptWord(x) + OptWord(y))]
        }
        <'sub'> => {
            [true (OptWord(x) - OptWord(y))]
        }
        <'mul'> => {
            [true (OptWord(x) * OptWord(y))]
        }
        <'divs'> => {
            if ((y =? 0) or (((x =? OW_MIN_INT) and (y =? (- OptWord(int64(1))))))) {
                return [false 0]
            }
            [true ow_trunc_div(x y)]
        }
        <'rems'> => {
            if ((y =? 0) or (((x =? OW_MIN_INT) and (y =? (- OptWord(int64(1))))))) {
                return [false 0]
            }
            [true (OptWord(x) - OptWord((OptWord(ow_trunc_div(x y)) * OptWord(y))))]
        }
        <'and_'> => {
            [true (x & y)]
        }
        <'or_'> => {
            [true (x or y)]
        }
        <'xor'> => {
            [true ((x xor y))]
        }
        <'shl'> => {
            [true (OptWord(x) << ((y & 63)))]
        }
        <'shrs'> => {
            [true (x >> ((y & 63)))]
        }
        <'shru'> => {
            [true ow_shru_val(x (y & 63))]
        }
        <'eq'> => {
            [true int64((x =? y))]
        }
        <'ne'> => {
            [true int64((x not=? y))]
        }
        <'lts'> => {
            [true int64((x <? y))]
        }
        <'les'> => {
            [true int64((x <=? y))]
        }
        <'gts'> => {
            [true int64((x >? y))]
        }
        <'ges'> => {
            [true int64((x >=? y))]
        }
        <'ltu'> => {
            [true int64(ow_ult(x y))]
        }
        <'leu'> => {
            [true int64((not ow_ult(y x)))]
        }
        <'gtu'> => {
            [true int64(ow_ult(y x))]
        }
        <'geu'> => {
            [true int64((not ow_ult(x y)))]
        }
        _ => {
            [false 0]
        }
    }
}

ow_fold_un=(op:Op x:int64):>[bool int64]=>$unsafe {
    match op {
        <'neg'> => {
            [true (- OptWord(x))]
        }
        <'not_'> => {
            [true (not x)]
        }
        <'sext8'> => {
            [true (((OptWord(x) << 56)) >> 56)]
        }
        <'sext16'> => {
            [true (((OptWord(x) << 48)) >> 48)]
        }
        <'sext32'> => {
            [true (((OptWord(x) << 32)) >> 32)]
        }
        <'zext8'> => {
            [true (x & 255)]
        }
        <'zext16'> => {
            [true (x & 65535)]
        }
        <'zext32'> => {
            [true (x & 4294967295)]
        }
        _ => {
            [false 0]
        }
    }
}
# comparison with its operands swapped

ow_mirror=(op:Op):>Op=>$unsafe {
    match op {
        <'lts'> => {
            'gts'
        }
        <'les'> => {
            'ges'
        }
        <'gts'> => {
            'lts'
        }
        <'ges'> => {
            'les'
        }
        <'ltu'> => {
            'gtu'
        }
        <'leu'> => {
            'geu'
        }
        <'gtu'> => {
            'ltu'
        }
        <'geu'> => {
            'leu'
        }
        _ => {
            op
        }
    }
}

ow_commutes=(op:Op):>bool=>$unsafe {
    (((((((op =? 'add') or (op =? 'mul')) or (op =? 'and_')) or (op =? 'or_')) or (op =? 'xor')) or (op =? 'eq')) or (op =? 'ne'))
}
# Function-local output arena. The cleanup consumer borrows it; published IR
# owns a different array. Every append checks capacity before taking its address.

ow_flow_begin=():>void=>$unsafe {
    if (o_flow_storage.length <? opt_ir[0].code.length) {
        o_flow_storage.resize(opt_ir[0].code.length)
    }
    o_flow=o_flow_storage.ptr
    if (o_flow_open_storage.length <? opt_ir[0].code.length) {
        o_flow_open_storage.resize(opt_ir[0].code.length)
    }
    o_flow_open=o_flow_open_storage.ptr
    o_flow_level=(- OptWord(int64(1)))
    o_flow_at_storage.resize(o_capacity)
    o_flow_at=o_flow_at_storage.ptr
    o_flow_count=0
    o_flow_top=(- OptWord(int64(1)))
    o_flow_dead=false
    o_flow_depth=0
    o_dead_first.clear()
    o_dead_limit.clear()
}

ow_flow_exit=(distance:int64):>void=>$unsafe {
    let level=(OptWord(o_flow_level) - OptWord(distance))
    if (level <? 0) {
        return
    }
    let target=int64(o_flow_open[level])
    if (o_flow[target].kind not=? 'loop') {
        o_flow[target].exit=true
    }
}

ow_flow_end_dead=():>void=>$unsafe {
    if (o_dead_start <? o_count) {
        o_dead_first.push(o_dead_start)
        o_dead_limit.push(o_count)
    }
}
# Callers select control operations; data emission never enters this path.

ow_flow_emit=(ins:ptr<Ins>):>void=>$unsafe {
    if (o_count =? o_capacity) {
        ow_grow_output()
    }
    let control=(((opt_decode[oc_tag(ins)] >> 20)) & 15)
    if o_flow_dead {
        if ((control >=? 2) and (control <=? 4)) {
            o_flow_depth=(OptWord(o_flow_depth) + OptWord(int64(1)))
            return
        }
        if ((control =? 5) or (control =? 6)) {
            if (o_flow_depth >? 0) {
                if (control =? 6) {
                    o_flow_depth=(OptWord(o_flow_depth) - OptWord(int64(1)))
                }
                return
            }
            ow_flow_end_dead()
        }
        else {
            return
        }
    }
    if ((control >=? 2) and (control <=? 4)) {
        let index=o_flow_count
        o_flow_count=(OptWord(o_flow_count) + OptWord(int64(1)))
        o_flow[index]=OptFlow(ins[0].op o_flow_top o_count false false)
        o_flow_top=index
        o_flow_level=(OptWord(o_flow_level) + OptWord(int64(1)))
        o_flow_open[o_flow_level]=OptIndex(index)
        o_flow_at[o_count]=OptIndex(index)
    }
    else if (control =? 5) {
        o_flow[o_flow_top].exit=(o_flow[o_flow_top].exit or (not o_flow_dead))
        o_flow[o_flow_top].kind='else_'
        o_flow_dead=false
    }
    else if (control =? 6) {
        o_flow_dead=((o_flow_dead and (not o_flow[o_flow_top].exit)) and (o_flow[o_flow_top].kind not=? 'if_'))
        o_flow[o_flow_top].terminated=o_flow_dead
        o_flow_at[o_count]=OptIndex(o_flow_top)
        o_flow_top=o_flow[o_flow_top].parent
        o_flow_level=(OptWord(o_flow_level) - OptWord(int64(1)))
        if o_flow_dead {
            o_dead_start=(OptWord(o_count) + OptWord(int64(1)))
        }
    }
    else {
        if (((control =? 7) or (control =? 8)) or (control =? 9)) {
            ow_flow_exit(int64(ins[0].imm))
            if (control =? 9) {
                loop k in [0..int64(ins[0].b)) {
                    ow_flow_exit(int64(opt_ir[0].args[(OptWord(int64(ins[0].c)) + OptWord(k))]))
                }
            }
        }
        if (((((control =? 7) or (control =? 9)) or (control =? 10)) or (control =? 11)) or (((control =? 12) and (ins[0].c =? 1)))) {
            o_flow_dead=true
            o_flow_depth=0
            o_dead_start=(OptWord(o_count) + OptWord(int64(1)))
        }
    }
}

ow_flow_pop=():>void=>$unsafe {
    # Only an empty block/if opener can be removed by the forward writer.
    if o_flow_dead {
        o_flow_depth=(OptWord(o_flow_depth) - OptWord(int64(1)))
    }
    else {
        o_flow_top=o_flow[o_flow_top].parent
        o_flow_level=(OptWord(o_flow_level) - OptWord(int64(1)))
        o_flow_count=(OptWord(o_flow_count) - OptWord(int64(1)))
    }
}

ow_grow_output=():>void=>$unsafe {
    o_capacity=max(32 (OptWord(o_capacity) * OptWord(int64(2))))
    o_out_storage.resize(o_capacity)
    o_out=o_out_storage.ptr
    o_flow_at_storage.resize(o_capacity)
    o_flow_at=o_flow_at_storage.ptr
}

ow_append_plain=(ins:Ins):>void=>$unsafe {
    if (o_count =? o_capacity) {
        ow_grow_output()
    }
    o_out[o_count]=ins
    o_count=(OptWord(o_count) + OptWord(int64(1)))
}

ow_append=(ins:Ins):>void=>$unsafe {
    if (o_count =? o_capacity) {
        ow_grow_output()
    }
    o_out[o_count]=ins
    ow_flow_emit((o_out + o_count))
    o_count=(OptWord(o_count) + OptWord(int64(1)))
}

ow_kconst=(v:int64):>int64=>$unsafe {
    if ow_fits32(v) {
        let c:int64?=o_kmap.get(v)
        if c isnt? none {
            return c
        }
        let k=ow_k_vreg(v)
        ow_resize_one(k)
        o_regs[k].ndef=1
        o_regs[k].stable=true
        o_regs[k].constant=true
        o_regs[k].cval=v
        o_kmap[v]=k
        return k
    }
    let d=ow_vreg(0)
    ow_resize_one(d)
    o_regs[d].ndef=1
    o_regs[d].stable=true
    o_regs[d].constant=true
    o_regs[d].cval=v
    ow_emit(Ins('iconst' 0 OptIndex(d) 0 0 0 v))
    int64(o_regs[d].repl)
}

ow_resize_one=(d:int64):>void=>$unsafe {
    if (o_reg_count <=? d) {
        o_reg_storage.resize((OptWord(d) + OptWord(int64(1))))
        o_regs=o_reg_storage.ptr
        o_reg_count=(OptWord(d) + OptWord(int64(1)))
        o_fact_scope.resize((OptWord(((OptWord(d) + OptWord(int64(1))))) * OptWord(int64(2))))
        o_fact_nbr.resize((OptWord(((OptWord(d) + OptWord(int64(1))))) * OptWord(int64(2))))
    }
    let reg=(o_regs + d)
    reg[0].ndef=0
    reg[0].stable=false
    reg[0].defpos=(- OptWord(int64(1)))
    reg[0].first=2147483647
    reg[0].nuse=0
    reg[0].constant=false
    reg[0].repl=OptIndex(d)
    reg[0].ver=0
    reg[0].dop=(- OptWord(int64(1)))
}
# (results may be replaced by an existing equal value)

ow_bin=(op:Op d:int64 a:int64 b:int64):>int64=>$unsafe {
    ow_emit(Ins(op 0 OptIndex(d) OptIndex(a) OptIndex(b) 0 0))
    int64(o_regs[d].repl)
}

ow_tmp=():>int64=>$unsafe {
    let d=ow_vreg(0)
    ow_resize_one(d)
    o_regs[d].ndef=1
    o_regs[d].stable=true
    d
}
# can uses of d be replaced by s? both must be single-definition values defined before use

ow_can_alias=(d:int64 s:int64):>bool=>$unsafe {
    if (o_regs[d].ndef not=? 1) {
        return false
    }
    if (o_regs[d].first <? o_regs[d].defpos) {
        return false
    }
    if (o_regs[s].ndef not=? 1) {
        return ((ow_vtype(d) =? ow_vtype(s)) and ow_holds(d s))
    }
    if ((s >=? opt_ir[0].nparams) and (o_regs[s].first <? o_regs[s].defpos)) {
        return false
    }
    (ow_vtype(d) =? ow_vtype(s))
}
# d = s (s defined more than once, like a loop counter): may d's uses read s instead? Yes if s
# is not redefined from there to d's last use, and the copy dominates the uses (the construct
# open at the copy stays open: no path reaches a use around it, as through a loop's back edge).
# A use in a loop entered after the copy sees s again on the next iteration: s must not change
# anywhere in that loop either.

ow_holds=(d:int64 s:int64):>bool=>$unsafe {
    let q=int64(o_regs[d].defpos)
    let e=int64(o_lastuse[d])
    if ((q <? 0) or (e <? q)) {
        return false
    }
    let dq=o_depth[q]
    # (constructs opened after the copy, and how deep the outermost loop among them is)
    let open:array<Op>=[]
    let loop_at:OptWord=(- OptWord(int64(1)))
    let p=(OptWord(q) + OptWord(int64(1)))
    loop ((p <=? e) or (((loop_at >=? 0) and (open.length >? loop_at)))) {
        if ((p >=? opt_ir[0].code.length) or ((OptWord(p) - OptWord(q)) >? 4000)) {
            return false
        }
        let ins=(opt_input + p)
        let op=ins[0].op
        if (o_depth[p] <? dq) {
            return false
        }
        if ((op =? 'else_') and (o_depth[p] =? dq)) {
            return false
        }
        if (((opt_decode[oc_tag(ins)] & 1) not=? 0) and (int64(ins[0].dst) =? s)) {
            return false
        }
        if (op =? 'zeroslots') {
            loop k in [0..int64(ins[0].b)) {
                let item=int64(opt_ir[0].args[(OptWord(int64(ins[0].a)) + OptWord(k))])
                if (((item & 1) =? 1) and ((item >> 1) =? s)) {
                    return false
                }
            }
        }
        if (((op =? 'block') or (op =? 'if_')) or (op =? 'loop')) {
            open.push(op)
        }
        else if ((op =? 'end') and (open.length >? 0)) {
            open.pop();
        }
        if (p =? e) {
            loop j in [0..open.length) {
                if (open[j] =? 'loop') {
                    loop_at=j
                    break
                }
            }
        }
        p=(OptWord(p) + OptWord(int64(1)))
    }
    true
}
# ---------------- common subexpressions ----------------
# A hash table of available values keyed by (op, type, operands, immediate). Entries belong to
# their control construct. An unconditional block can export its prefix before
# the first branch; conditional arms and loops never export. Loads also die when
# memory may have changed (any store or call bumps the memory generation).
# Keep one probed entry together instead of visiting ten separate arrays.
# The key and validity metadata occupy 64 bytes; their meaning is unchanged.

ow_ht_setup=(n:int64):>void=>$unsafe {
    let size:OptWord=64
    loop (size <? (OptWord(n) * OptWord(int64(4)))) {
        size=(OptWord(size) * OptWord(int64(2)))
    }
    if (ht_storage.length <? size) {
        ht_storage.resize(size)
    }
    ht_entries=ht_storage.ptr
    ht_mask=(OptWord(size) - OptWord(int64(1)))
    o_epoch=(OptWord(o_epoch) + OptWord(int64(1)))
    o_gen=0
    o_genf=(OptWord(int64(1)) << 40)
    o_genh=(OptWord(int64(2)) << 40)
    o_scope_storage.clear()
    o_scopes.clear()
    ow_scope_open()
}

ow_scope_open=(export_prefix:bool=false):>void=>$unsafe {
    let parent:OptWord=(- OptWord(int64(1)))
    if (o_scopes.length >? 0) {
        parent=o_scopes[(OptWord(o_scopes.length) - OptWord(int64(1)))]
    }
    o_scope_storage.push(OptScope(o_nbr OptIndex(parent) true export_prefix))
    o_scope_info=o_scope_storage.ptr
    o_scopes.push((OptWord(o_scope_storage.length) - OptWord(int64(1))))
}

ow_scope_close=():>void=>$unsafe {
    o_scope_info[o_scopes.pop()].open=false
}

ow_ht_slot=(k1:int64 k2:int64 k3:int64):>int64=>$unsafe {
    let h=((((OptWord(k1) * OptWord((- OptWord(int64(7046029254386353131)))))) xor ((OptWord(k2) * OptWord((- OptWord(int64(4417276706812531889))))))) xor ((OptWord(k3) * OptWord(int64(1609587929392839161)))))
    let i=(((h >> 29)) & ht_mask)
    loop (ht_entries[i].epoch =? o_epoch) {

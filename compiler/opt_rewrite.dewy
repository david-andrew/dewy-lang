    }
    let [ok1 val]=ow_fold(raw av0 bv0)
    if (mode & 32) not=? 0 {
        overflow=overflow or (if (mode & 1) not=? 0 {val <? 0 or val >? 4294967295} else {val <? -2147483648 or val >? 2147483647})
    }
    if overflow {return [false 0]}
    [true val]
}


fl_checked_const=(op:Op mode:int64 av0:int64 bv0:int64):>[bool int64]=>{
    let raw=(if op =? 'checked_add' {Op.add} else if op =? 'checked_sub' {Op.sub} else {Op.mul})
    let operation:int64=(if op =? 'checked_add' {0} else if op =? 'checked_sub' {1} else {2})
    let overflow=false
    if (mode & 1) not=? 0 {
        let av=uint64<overflow='wrap'>(av0)
        let bv=uint64<overflow='wrap'>(bv0)
        overflow=(if operation =? 0 {ow_unsigned_add_overflow(av bv)} else if operation =? 1 {av <? bv} else {bv not=? 0 and av >? (uint64(18446744073709551615) // bv)})
    } else {

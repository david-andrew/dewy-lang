            }
        }
    }
    if (ins[0].op not=? 'zext32') {
        return false
    }
    # Duplication into both halves followed by a shift is the same rotation.
    if (ow_def_is(value 16) and ow_is_k(int64(o_regs[value].db))) {
        let count=o_regs[int64(o_regs[value].db)].cval
        let dup=int64(o_regs[value].da)
        if (((count <=? 0) or (count >=? 32)) or (not ow_def_is(dup 12))) {
            return false
        }
        let x=int64(o_regs[dup].da)
        let shifted=int64(o_regs[dup].db)
        if ow_def_is(x 14) {
            let saved=x
            x=shifted
            shifted=saved
        }
        if ((((ow_def_is(shifted 14) and (ow_unwrap32(int64(o_regs[shifted].da)) =? ow_unwrap32(x))) and ow_is_k(int64(o_regs[shifted].db))) and (o_regs[int64(o_regs[shifted].db)].cval =? 32)) and ow_unsigned32(x)) {
            let rotation=ow_kconst((OptWord(int64(32)) - OptWord(count)))
            ins[0]=Ins('rot32' 0 ins[0].dst OptIndex(ow_unwrap32(x)) OptIndex(rotation) 0 0)
            return true
        }
    }
    false
}

ow_fits32=(v:int64):>bool=>$unsafe {
    ((v >=? (- OptWord(int64(2147483648)))) and (v <=? 2147483647))
}

ow_emit=(ins0:Ins):>void=>$unsafe {
    opt_working[1]=ins0
    ow_transfer((opt_working + 1) false)
}
# Only single-definition values have facts. Direct indexing avoids hashing the
# same condition at every branch; both truth values keep their own scope, just
# as separate available-expression keys did.

ow_fact_known=(c:int64 truth:int64):>bool=>$unsafe {
    if (((not o_cse) or (not ow_stable(c))) or (o_regs[c].fact_epoch not=? o_epoch)) {
        return false
    }
    let index=(OptWord((OptWord(c) * OptWord(int64(2)))) + OptWord(truth))
    let scope=int64(o_fact_scope[index])
    if (scope <? 0) {
        return false
    }
    loop (not o_scope_info[scope].open) {
        if ((not o_scope_info[scope].export_prefix) or (o_fact_nbr[index] not=? o_scope_info[scope].branches)) {
            return false
        }
        scope=int64(o_scope_info[scope].parent)
        if (scope <? 0) {
            return false
        }
    }
    true
}

ow_add_fact=(c:int64 truth:int64):>void=>$unsafe {
    if ((not o_cse) or (not ow_stable(c))) {

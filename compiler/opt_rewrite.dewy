            }
            ow_append_plain(ins[0])
            return
        }
        else if (op =? 'store') {
            let mode=int64(ins[0].c)
            ow_kill_mem(mode)
            # store-to-load forwarding for full-width values
            let a=int64(ins[0].a)
            let v=int64(ins[0].b)
            let ix:OptWord=0
            let vix:OptWord=0
            if ((mode & 128) not=? 0) {
                ix=int64(ins[0].dst)
                vix=int64(o_regs[ix].ver)
            }
            if (opt_allow_cse or o_loop_depth >? 0) and ((((mode & 15) =? 8) or ((mode & 32) not=? 0))) and ow_stable(v) {
                ow_ht_put_gen(ow_load_key1(int64(ins[0].ty) mode a) ix ins[0].imm v ow_mem_gen(mode) int64(o_regs[a].ver) vix)
            }
            o_regs[a].nuse=(OptIndex(o_regs[a].nuse) + OptIndex(OptIndex(int64(1))))
            o_regs[v].nuse=(OptIndex(o_regs[v].nuse) + OptIndex(OptIndex(int64(1))))
            if ((mode & 128) not=? 0) {
                o_regs[ix].nuse=(OptIndex(o_regs[ix].nuse) + OptIndex(OptIndex(int64(1))))
            }
            ow_append_plain(ins[0])
            return
        }
        else if (op =? 'assume') {
            let a=int64(ins[0].a)
            if (ins[0].imm =? 1) {
                let k=ow_kconst(1)
                ow_ht_put_gen(ow_load_key1(0 (8 or 64) a) 0 0 k ow_mem_gen((8 or 64)) int64(o_regs[a].ver) 0)
            }
            return
        }
        else if (((opt_decode[oc_tag(ins)] & 4) not=? 0) and (not (((op =? 'call') and (ins[0].c =? 1))))) {
            ow_kill_all()
        }
    }
    else {
        let arity=ow_arity(oc_tag(ins) int64(ins[0].c))
        if (arity >=? 0) {
            let d=int64(ins[0].dst)
            let reg=(o_regs + d)
            if reg[0].stable {
                reg[0].dop=OptIndex(oc_tag(ins))
                reg[0].da=ins[0].a
                reg[0].db=ins[0].b
                reg[0].dva=o_regs[int64(ins[0].a)].ver
                reg[0].dvb=o_regs[int64(ins[0].b)].ver
            }
            reg[0].ver=(OptIndex(reg[0].ver) + OptIndex(OptIndex(int64(1))))
            if (arity >? 0) {
                o_regs[int64(ins[0].a)].nuse=(OptIndex(o_regs[int64(ins[0].a)].nuse) + OptIndex(OptIndex(int64(1))))
            }
            if (arity >? 1) {
                o_regs[int64(ins[0].b)].nuse=(OptIndex(o_regs[int64(ins[0].b)].nuse) + OptIndex(OptIndex(int64(1))))
            }
            ow_append_plain(ins[0])
            return
        }
        else if (op =? 'store') {
            let mode=int64(ins[0].c)
            o_regs[int64(ins[0].a)].nuse=(OptIndex(o_regs[int64(ins[0].a)].nuse) + OptIndex(OptIndex(int64(1))))
            o_regs[int64(ins[0].b)].nuse=(OptIndex(o_regs[int64(ins[0].b)].nuse) + OptIndex(OptIndex(int64(1))))
            if ((mode & 128) not=? 0) {
                o_regs[int64(ins[0].dst)].nuse=(OptIndex(o_regs[int64(ins[0].dst)].nuse) + OptIndex(OptIndex(int64(1))))
            }
            ow_append_plain(ins[0])
            return
        }
        else if (op =? 'assume') {
            return
        }
    }
    # Record the boolean result without making raw-memory reads available
    # expressions: subsequent stores must still perform a new comparison.
    if ((((op =? 'memeq') or (op =? 'streq'))) and ow_stable(int64(ins[0].dst))) {
        o_regs[int64(ins[0].dst)].dop=OptIndex(oc_tag(ins))
    }
    ow_push(ins)
}
# the magic number, shift and whether an add is needed, for dividing an unsigned 64-bit integer
# by d (d >= 2) (Hacker's Delight 10-2)

ow_enter_loop=():>void=>$unsafe {
    let l=lp_next
    lp_next=(OptWord(lp_next) + OptWord(int64(1)))
    loop k in [lp_first[l]..lp_limit[l]) {
        o_regs[lp_defs[k]].ver=(OptIndex(o_regs[lp_defs[k]].ver) + OptIndex(OptIndex(int64(1))))
    }
    k=lp_kills[l]
    if (((k & 1) not=? 0) or opt_raw_mem) {
        o_gen=(OptWord(o_gen) + OptWord(int64(1)))
    }
    if (((k & 2) not=? 0) or opt_raw_mem) {
        o_genf=(OptWord(o_genf) + OptWord(int64(1)))
    }
    if (((k & 4) not=? 0) or opt_raw_mem) {
        o_genh=(OptWord(o_genh) + OptWord(int64(1)))
    }
}
fl_branch_copy=(out:ptr<Ins> n:int64):>int64=>$unsafe {
    if n <? 3 or out[n - 2].op not=? 'mov' {return -1}
    let d=int64(out[n - 2].dst)
    if d <? 0 or o_regs[d].ndef <=? 1 or o_regs[d].repl not=? OptIndex(d) {return -1}
    let i:OptWord=n - 3
    let floor:OptWord=if n >? 19 {n - 19} else {0}
    loop i >=? floor {
        let ins=out + i
        let op=ins[0].op
        if op =? 'brif' {return if ins[0].imm =? 0 {d} else {-1}}
        if op =? 'block' or op =? 'loop' or op =? 'if_' or op =? 'else_' or op =? 'end' or op =? 'br' or op =? 'brtable' or op =? 'ret' or op =? 'trap' or op =? 'zeroslots' {return -1}
        if (opt_decode[oc_tag(ins)] & 1) not=? 0 and ins[0].dst =? OptIndex(d) {return -1}
        i-=1
    }
    -1
}

fl_slot=(key:int64 a:int64 b:int64 imm:int64):>int64=>{
    let h:OptWord=(OptWord(a) * OptWord(2654435761)) xor (OptWord(b) * OptWord(2246822519)) xor (OptWord(imm) * OptWord(3266489917)) xor (OptWord(key) * OptWord(668265263))
    int64((h xor (h >> 16)) & 254)
}

fl_cache_put=(cache:ptr<FastLoad> sids:ptr<int64> ed:int64 gen:int64 imm:int64 key:int64 a:int64 b:int64 dst:OptIndex va:OptIndex vb:OptIndex dver:OptIndex):>void=>$unsafe {
    if ed >=? 128 {return}
    let s=fl_slot(key a b imm)
    let c0=cache + s
    if c0[0].depth <=? ed and c0[0].sid =? sids[int64(c0[0].depth)] {
        if not (c0[0].gen =? gen and c0[0].imm =? imm and c0[0].key =? key and int64(c0[0].a) =? a and int64(c0[0].b) =? b) {
            cache[s + 1]=c0[0]
        }
    }
    c0[0]=FastLoad(sids[ed] gen imm key OptIndex(a) OptIndex(b) dst OptIndex(ed) va vb dver)
}

fl_kconst=(v:int64):>int64=>$unsafe {
    let d=ow_k_vreg(v)
    if o_reg_count <=? d {ow_resize_one(d)}
    let reg=o_regs + d
    reg[0].ndef=1
    reg[0].stable=true
    reg[0].constant=true
    reg[0].cval=v
    reg[0].repl=OptIndex(d)
    reg[0].dop=0
    d
}

fl_def_is=(v:int64 op:int64):>bool=>$unsafe {
    let r=o_regs + v
    r[0].stable and int64(r[0].dop) =? op and o_regs[int64(r[0].da)].ver =? r[0].dva and o_regs[int64(r[0].db)].ver =? r[0].dvb
}
fl_repl=(regs:ptr<OptReg> sids:ptr<int64> depth:int64 v:int64):>int64=>$unsafe {
    let r=int64(regs[v].repl)
    let rr=regs + r
    if rr[0].dop =? 3 {
        let db=int64(rr[0].db)
        if db <=? depth and sids[db] =? int64(rr[0].dvb) {
            let a=int64(rr[0].da)
            if regs[a].ver =? rr[0].dva {return a}
        }
    }
    r
}


fl_fact=(c:int64 depth:int64 sids:ptr<int64>):>int64=>$unsafe {
    let fe=o_regs[c].fact_epoch
    if fe not=? 0 {
        let fd=(fe >> 1) & 127
        if fd <=? depth and (fe >> 8) =? sids[fd] {return fe & 1}
    }
    -1
}

fl_set_fact=(c:int64 depth:int64 sids:ptr<int64> truth:int64):>void=>$unsafe {
    if depth <? 128 and o_regs[c].stable {
        o_regs[c].fact_epoch=(OptWord(sids[depth]) << 8) | (OptWord(depth) << 1) | OptWord(truth)
    }
}

fl_width_mask=(v:int64):>int64=>$unsafe {
    let r=o_regs + v
    if r[0].constant {
        let k=r[0].cval
        let m:OptWord=0
        if k >=? -128 and k <=? 127 {m|=1}
        if k >=? -32768 and k <=? 32767 {m|=2}
        if k >=? -2147483648 and k <=? 2147483647 {m|=4}
        if k >=? 0 and k <=? 255 {m|=8}
        if k >=? 0 and k <=? 65535 {m|=16}
        if k >=? 0 and k <=? 4294967295 {m|=32}
        return m
    }
    if not r[0].stable {return 0}
    let dop=int64(r[0].dop)
    if ow_boolean_tag(dop) or dop =? 95 or dop =? 103 {return 63}
    let has_k=(dop =? 11 or dop =? 15 or dop =? 16) and o_regs[int64(r[0].db)].constant
    let k:int64=if has_k {if dop =? 11 {o_regs[int64(r[0].db)].cval} else {o_regs[int64(r[0].db)].cval & 63}} else {0}
    ow_dop_width_mask(dop int64(r[0].da) has_k k)
}

fl_straight_bin_cold=(p_ins:ptr<Ins> w_ins:ptr<Ins> regs:ptr<OptReg> a:int64 b:int64):>bool=>$unsafe {
    let op=p_ins[0].op
    let ra=regs + a
    let rb=regs + b
    let d=int64(p_ins[0].dst)
    if ra[0].constant and rb[0].constant {
        let folded=ow_fold(op ra[0].cval rb[0].cval)
        if folded[0] {
            let rd=regs + d
            if rd[0].ndef =? 1 {rd[0].constant=true; rd[0].cval=folded[1]}
            w_ins[0].op='iconst'; w_ins[0].ty=0; w_ins[0].dst=p_ins[0].dst; w_ins[0].a=0; w_ins[0].b=0; w_ins[0].c=0; w_ins[0].imm=folded[1]; w_ins[0].pos=0
            return true
        }
    }
    if a =? b {
        let known:OptWord=if op =? 'eq' or op =? 'les' or op =? 'ges' or op =? 'leu' or op =? 'geu' {1} else if op =? 'ne' or op =? 'lts' or op =? 'gts' or op =? 'ltu' or op =? 'gtu' {0} else {-1}
        if known >=? 0 {
            let rd=regs + d
            if rd[0].ndef =? 1 {rd[0].constant=true; rd[0].cval=known}
            w_ins[0].op='iconst'; w_ins[0].ty=0; w_ins[0].dst=p_ins[0].dst; w_ins[0].a=0; w_ins[0].b=0; w_ins[0].c=0; w_ins[0].imm=known; w_ins[0].pos=0
            return true
        }
    }
    if rb[0].constant {
        let k=rb[0].cval
        let known:OptWord=if (op =? 'lts' and k =? OW_MIN_INT) or (op =? 'gts' and k =? 9223372036854775807) or (op =? 'ltu' and k =? 0) {0} else if (op =? 'ges' and k =? OW_MIN_INT) or (op =? 'les' and k =? 9223372036854775807) or (op =? 'geu' and k =? 0) {1} else {-1}
        if known >=? 0 {
            let rd=regs + d
            if rd[0].ndef =? 1 {rd[0].constant=true; rd[0].cval=known}
            w_ins[0].op='iconst'; w_ins[0].ty=0; w_ins[0].dst=p_ins[0].dst; w_ins[0].a=0; w_ins[0].b=0; w_ins[0].c=0; w_ins[0].imm=known; w_ins[0].pos=0
            return true
        }
    }
    false
}

let opt_no_fast_straight=false
# Fast in-place default-mode optimizer for straight-line functions (no loops).
opt_fast_straight=():>void=>$unsafe {
    opt_args=opt_ir[0].args.ptr
    opt_vtypes=opt_ir[0].vtypes.ptr
    opt_fast_nv=opt_ir[0].vtypes.length
    opt_input_count=opt_ir[0].code.length
    opt_nparams=opt_ir[0].nparams
    opt_raw_mem=opt_ir[0].raw_mem
    opt_has_big_loop_const=false
    let ncode=opt_input_count
    let input=opt_ir[0].code.ptr
    opt_input=input
    let dec=opt_decode
    let regs=o_regs
    let args=opt_args
    let vt=opt_vtypes
    let r_p=regs
    let r_end=regs + opt_fast_nv
    let vi:OptIndex=0
    loop r_p <? r_end {
        r_p[0].ndef=0
        r_p[0].nuse=0
        r_p[0].repl=vi
        r_p[0].constant=false
        r_p+=1
        vi=(OptIndex(vi) + OptIndex(1))
    }
    loop p in [0..opt_nparams) {
        regs[p].ndef=1
    }
    let constants=opt_ir[0].kval.ptr
    loop v in [0..opt_ir[0].kval.length) {
        if int64(vt[v]) =? 3 {
            regs[v].ndef=1
            regs[v].constant=true
            regs[v].cval=constants[v]
        }
    }
    let p_ins=input
    let end_ins=input + ncode
    let rot_mask:OptWord=0
    loop p_ins <? end_ins {
        let tag=int64((p_ins as ptr<uint32>)[0])
        if (dec[tag] & 1) not=? 0 {
            let d=int64(p_ins[0].dst)
            if d >=? 0 {regs[d].ndef=(OptIndex(regs[d].ndef) + OptIndex(1))}
            if tag >=? 12 and tag <=? 16 {rot_mask |= (OptWord(1) << (OptWord(tag) - OptWord(12)))}
        } else if p_ins[0].op =? 'zeroslots' {
            let a0=int64(p_ins[0].a)
            loop k in [a0..(OptWord(a0) + OptWord(int64(p_ins[0].b)))) {
                let item=int64(args[k])
                if (item & 1) =? 1 {regs[item >> 1].ndef=(OptIndex(regs[item >> 1].ndef) + OptIndex(2))}
            }
        }
        p_ins+=1
    }
    if opt_rotate32_ok and (rot_mask & 21) =? 21 {
        if opt_fast_nv >? 0 {
            mem_set(regs as ptr<uint8> 0 opt_fast_nv * size_of<OptReg>)
            loop v in [0..opt_fast_nv) {
                regs[v].repl=OptIndex(v)
                regs[v].defpos=-1
                regs[v].first=2147483647
                regs[v].dop=-1
            }
        }
        opt_no_fast_straight=true
        opt_rewrite()
        opt_no_fast_straight=false
        return
    }
    if fl_sid.length <? 256 {fl_ensure_sid()}
    if fl_blk_start.length <? 256 {fl_ensure_blk()}
    let ckind=fl_sid_p
    let bstart=fl_blk_start_p
    let cdepth:OptWord=0
    let w_ins=input
    let skip:OptWord=0
    let dead:OptWord=0
    let any_mov=false
    let last_mask_reg:OptWord=-1
    let last_mask_val:OptWord=-1
    let rf_op:Op='nop'
    let rf_a:OptWord=-1
    let rf_b:OptWord=-1
    let rf_val:OptWord=0
    let if_op:Op='nop'
    let if_a:OptWord=-1
    let if_b:OptWord=-1
    let if_had_else=false
    let blk_br_count:OptWord=0
    let blk_br_op:Op='nop'
    let blk_br_a:OptWord=-1
    let blk_br_b:OptWord=-1
    p_ins=input
    loop p_ins <? end_ins {
        let op=p_ins[0].op
        let ended_dead=false
        if (skip | dead) not=? 0 {
            if skip >? 0 {
                if op =? 'block' or op =? 'if_' {skip+=1}
                else if op =? 'else_' and skip =? 1 and ckind[cdepth - 1] =? 2 {skip=0}
                else if op =? 'end' {
                    skip-=1
                    if skip =? 0 {
                        cdepth-=1
                        if w_ins >? input and ((w_ins - 1)[0].op =? 'block' or (w_ins - 1)[0].op =? 'if_') {
                            if (w_ins - 1)[0].op =? 'if_' {regs[int64((w_ins - 1)[0].a)].nuse=(OptIndex(regs[int64((w_ins - 1)[0].a)].nuse) - OptIndex(1))}
                            w_ins-=1
                        } else {
                            if w_ins not=? p_ins {w_ins[0]=p_ins[0]}
                            w_ins+=1
                        }
                    }
                }
                p_ins+=1
                continue
            }
            if op =? 'block' or op =? 'if_' {dead+=1; p_ins+=1; continue}
            if op =? 'else_' and dead =? 1 {if cdepth =? 1 {if_had_else=true}; dead=0}
            else if op =? 'end' {
                dead-=1
                if dead >? 0 {p_ins+=1; continue}
                ended_dead=true
            } else {p_ins+=1; continue}
        }
        match op {
            <'nop'|'assume'> => {}
            <'fconst'|'slot'|'gaddr'|'daddr'|'faddr'|'vzu'|'zeroslots'> => {
                if w_ins not=? p_ins {w_ins[0]=p_ins[0]}
                w_ins+=1
            }
            <'iconst'> => {
                let d=int64(p_ins[0].dst)
                if regs[d].ndef =? 1 {
                    regs[d].constant=true
                    regs[d].cval=p_ins[0].imm
                }
                if w_ins not=? p_ins {w_ins[0]=p_ins[0]}
                w_ins+=1
            }
            <'mov'> => {
                let a=int64(regs[int64(p_ins[0].a)].repl)
                let d=int64(p_ins[0].dst)
                if a not=? d {
                    let vtd=int64(vt[d]); let vta=int64(vt[a])
                    if regs[d].ndef =? 1 and regs[a].ndef =? 1 and (if vtd =? 3 {0} else {vtd}) =? (if vta =? 3 {0} else {vta}) {
                        regs[d].repl=OptIndex(a)
                        if regs[a].constant {regs[d].constant=true; regs[d].cval=regs[a].cval}
                    } else {
                        any_mov=true
                        if w_ins not=? p_ins {w_ins[0]=p_ins[0]}
                        w_ins[0].a=OptIndex(a)
                        regs[a].nuse=(OptIndex(regs[a].nuse) + OptIndex(1))
                        w_ins+=1
                    }
                }
            }
            <'add'|'sub'|'mul'|'divs'|'divu'|'rems'|'remu'|'and_'|'or_'|'xor'|'shl'|'shrs'|'shru'|'rot32'|'eq'|'ne'|'lts'|'les'|'gts'|'ges'|'ltu'|'leu'|'gtu'|'geu'|'overflow_add'|'overflow_sub'|'overflow_mul'> => {
                let a=int64(regs[int64(p_ins[0].a)].repl)
                let b=int64(regs[int64(p_ins[0].b)].repl)
                let ra=regs + a
                let rb=regs + b
                let handled=false
                if (rf_a & last_mask_reg) >=? 0 and p_ins[0].ty =? 0 {
                    if rf_a >=? 0 and a =? rf_a and b =? rf_b and op =? rf_op {
                        let rd=regs + int64(p_ins[0].dst)
                        if rd[0].ndef =? 1 {rd[0].constant=true; rd[0].cval=rf_val}
                        w_ins[0].op='iconst'; w_ins[0].ty=0; w_ins[0].dst=p_ins[0].dst; w_ins[0].a=0; w_ins[0].b=0; w_ins[0].c=0; w_ins[0].imm=rf_val; w_ins[0].pos=0
                        w_ins+=1
                        handled=true
                    } else if last_mask_reg >=? 0 and a =? last_mask_reg and rb[0].constant {
                        let ptag=int64((p_ins as ptr<uint32>)[0])
                        if ptag >=? 21 and ptag <=? 28 and ow_fold(op 0 rb[0].cval)[1] =? ow_fold(op last_mask_val rb[0].cval)[1] {
                            let kv=ow_fold(op 0 rb[0].cval)[1]
                            let rd=regs + int64(p_ins[0].dst)
                            if rd[0].ndef =? 1 {rd[0].constant=true; rd[0].cval=kv}
                            w_ins[0].op='iconst'; w_ins[0].ty=0; w_ins[0].dst=p_ins[0].dst; w_ins[0].a=0; w_ins[0].b=0; w_ins[0].c=0; w_ins[0].imm=kv; w_ins[0].pos=0
                            w_ins+=1
                            handled=true
                        }
                    }
                }
                if not handled {
                    if p_ins[0].ty =? 0 and ((rb[0].constant and (ra[0].constant or (int64((p_ins as ptr<uint32>)[0]) >=? 21 and int64((p_ins as ptr<uint32>)[0]) <=? 28))) or a =? b) and fl_straight_bin_cold(p_ins w_ins regs a b) {
                        w_ins+=1
                    } else {
                        if op =? 'and_' and p_ins[0].ty =? 0 and regs[int64(p_ins[0].dst)].ndef =? 1 {
                            if rb[0].constant and rb[0].cval >=? 0 {last_mask_reg=int64(p_ins[0].dst); last_mask_val=rb[0].cval}
                            else if ra[0].constant and ra[0].cval >=? 0 {last_mask_reg=int64(p_ins[0].dst); last_mask_val=ra[0].cval}
                        }
                        if w_ins not=? p_ins {w_ins[0]=p_ins[0]}
                        w_ins[0].a=OptIndex(a)
                        w_ins[0].b=OptIndex(b)
                        ra[0].nuse=(OptIndex(ra[0].nuse) + OptIndex(1))
                        rb[0].nuse=(OptIndex(rb[0].nuse) + OptIndex(1))
                        w_ins+=1
                    }
                }
            }
            <'load'> => {
                let a=int64(regs[int64(p_ins[0].a)].repl)
                let mode=int64(p_ins[0].c)
                if w_ins not=? p_ins {w_ins[0]=p_ins[0]}
                w_ins[0].a=OptIndex(a)
                regs[a].nuse=(OptIndex(regs[a].nuse) + OptIndex(1))
                if (mode & 128) not=? 0 {
                    let b=int64(regs[int64(w_ins[0].b)].repl)
                    w_ins[0].b=OptIndex(b)
                    regs[b].nuse=(OptIndex(regs[b].nuse) + OptIndex(1))
                }
                w_ins+=1
            }
            <'store'> => {
                let a=int64(regs[int64(p_ins[0].a)].repl)
                let b=int64(regs[int64(p_ins[0].b)].repl)
                let mode=int64(p_ins[0].c)
                if w_ins not=? p_ins {w_ins[0]=p_ins[0]}
                w_ins[0].a=OptIndex(a)
                w_ins[0].b=OptIndex(b)
                regs[a].nuse=(OptIndex(regs[a].nuse) + OptIndex(1))
                regs[b].nuse=(OptIndex(regs[b].nuse) + OptIndex(1))
                if (mode & 128) not=? 0 {
                    let ud=int64(regs[int64(w_ins[0].dst)].repl)
                    w_ins[0].dst=OptIndex(ud)
                    regs[ud].nuse=(OptIndex(regs[ud].nuse) + OptIndex(1))
                }
                w_ins+=1
            }
            <'zero'|'neg'|'not_'|'fneg'|'fsqrt'|'fabs'|'ffloor'|'fceil'|'ftrunc'|'sext8'|'sext16'|'sext32'|'zext8'|'zext16'|'zext32'|'i2f'|'u2f'|'f2i'|'f2f'|'bits2f'|'f2bits'|'vsplat'> => {
                let a=int64(regs[int64(p_ins[0].a)].repl)
                if w_ins not=? p_ins {w_ins[0]=p_ins[0]}
                w_ins[0].a=OptIndex(a)
                regs[a].nuse=(OptIndex(regs[a].nuse) + OptIndex(1))
                w_ins+=1
            }
            <'call'|'intr'|'syscall'> => {
                let a0=int64(p_ins[0].a)
                loop k in [a0..(OptWord(a0) + OptWord(int64(p_ins[0].b)))) {
                    let u=int64(regs[int64(args[k])].repl)
                    args[k]=OptIndex(u)
                    regs[u].nuse=(OptIndex(regs[u].nuse) + OptIndex(1))
                }
                let nr=(op =? 'call' and p_ins[0].c =? 1)
                if w_ins not=? p_ins {w_ins[0]=p_ins[0]}
                w_ins+=1
                if nr {dead=1}
            }
            <'calli'|'callc'> => {
                let a0=int64(p_ins[0].a)
                loop k in [a0..(OptWord(a0) + OptWord(int64(p_ins[0].b)))) {
                    let u=int64(regs[int64(args[k])].repl)
                    args[k]=OptIndex(u)
                    regs[u].nuse=(OptIndex(regs[u].nuse) + OptIndex(1))
                }
                let c=int64(regs[int64(p_ins[0].c)].repl)
                if w_ins not=? p_ins {w_ins[0]=p_ins[0]}
                w_ins[0].c=OptIndex(c)
                regs[c].nuse=(OptIndex(regs[c].nuse) + OptIndex(1))
                w_ins+=1
            }
            <'ret'> => {
                if w_ins not=? p_ins {w_ins[0]=p_ins[0]}
                if w_ins[0].a >=? 0 {
                    let a=int64(regs[int64(w_ins[0].a)].repl)
                    w_ins[0].a=OptIndex(a)
                    regs[a].nuse=(OptIndex(regs[a].nuse) + OptIndex(1))
                }
                w_ins+=1
                dead=1
            }
            <'memcpy'|'memset'|'select'|'vop'|'memeq'|'findbyte'|'scanbytes'|'findb'> => {
                let a=int64(regs[int64(p_ins[0].a)].repl)
                let b=int64(regs[int64(p_ins[0].b)].repl)
                let c=int64(regs[int64(p_ins[0].c)].repl)
                if w_ins not=? p_ins {w_ins[0]=p_ins[0]}
                w_ins[0].a=OptIndex(a); w_ins[0].b=OptIndex(b); w_ins[0].c=OptIndex(c)
                regs[a].nuse=(OptIndex(regs[a].nuse) + OptIndex(1))
                regs[b].nuse=(OptIndex(regs[b].nuse) + OptIndex(1))
                regs[c].nuse=(OptIndex(regs[c].nuse) + OptIndex(1))
                w_ins+=1
            }
            <'vst'> => {
                let a=int64(regs[int64(p_ins[0].a)].repl)
                let b=int64(regs[int64(p_ins[0].b)].repl)
                let ud=int64(regs[int64(p_ins[0].dst)].repl)
                if w_ins not=? p_ins {w_ins[0]=p_ins[0]}
                w_ins[0].a=OptIndex(a); w_ins[0].b=OptIndex(b); w_ins[0].dst=OptIndex(ud)
                regs[a].nuse=(OptIndex(regs[a].nuse) + OptIndex(1))
                regs[b].nuse=(OptIndex(regs[b].nuse) + OptIndex(1))
                regs[ud].nuse=(OptIndex(regs[ud].nuse) + OptIndex(1))
                w_ins+=1
            }
            <'br'|'trap'> => {
                if op =? 'br' and cdepth - 1 - p_ins[0].imm =? 0 {blk_br_count+=1}
                if w_ins not=? p_ins {w_ins[0]=p_ins[0]}
                w_ins+=1
                dead=1
            }
            <'brtable'> => {
                blk_br_count+=2
                let a=int64(regs[int64(p_ins[0].a)].repl)
                if w_ins not=? p_ins {w_ins[0]=p_ins[0]}
                w_ins[0].a=OptIndex(a)
                regs[a].nuse=(OptIndex(regs[a].nuse) + OptIndex(1))
                w_ins+=1
                dead=1
            }
            <'block'> => {
                if cdepth =? 0 {blk_br_count=0; blk_br_a=-1}
                if cdepth <? 256 {
                    ckind[cdepth]=3
                    bstart[cdepth]=(OptWord(w_ins as int64) - OptWord(input as int64)) // size_of<Ins>
                }
                cdepth+=1
                if w_ins not=? p_ins {w_ins[0]=p_ins[0]}
                w_ins+=1
            }
            <'if_'> => {
                let c=int64(regs[int64(p_ins[0].a)].repl)
                if regs[c].constant {
                    w_ins[0].op='block'; w_ins[0].ty=0; w_ins[0].dst=0; w_ins[0].a=0; w_ins[0].b=0; w_ins[0].c=0; w_ins[0].imm=0; w_ins[0].pos=0
                    w_ins+=1
                    if regs[c].cval not=? 0 {if cdepth <? 256 {ckind[cdepth]=1}}
                    else {if cdepth <? 256 {ckind[cdepth]=2}; skip=1}
                    cdepth+=1
                } else {
                    if cdepth =? 0 {
                        if_a=-1; if_had_else=false
                        if w_ins >? input {
                            let prev=w_ins - 1
                            let ptag0=int64((prev as ptr<uint32>)[0])
                            if ptag0 >=? 19 and ptag0 <=? 28 and prev[0].ty =? 0 and int64(prev[0].dst) =? c and regs[int64(prev[0].a)].ndef =? 1 and regs[int64(prev[0].b)].ndef =? 1 {
                                if_op=prev[0].op; if_a=int64(prev[0].a); if_b=int64(prev[0].b)
                            }
                        }
                    }
                    if cdepth <? 256 {
                        ckind[cdepth]=0
                        bstart[cdepth]=(OptWord(w_ins as int64) - OptWord(input as int64)) // size_of<Ins>
                    }
                    cdepth+=1
                    if w_ins not=? p_ins {w_ins[0]=p_ins[0]}
                    w_ins[0].a=OptIndex(c)
                    regs[c].nuse=(OptIndex(regs[c].nuse) + OptIndex(1))
                    w_ins+=1
                }
            }
            <'else_'> => {
                if cdepth =? 1 {if_had_else=true}
                if ckind[cdepth - 1] =? 1 {skip=1}
                else {
                    if w_ins not=? p_ins {w_ins[0]=p_ins[0]}
                    w_ins+=1
                }
            }
            <'end'> => {
                cdepth-=1
                if cdepth =? 0 and ended_dead {
                    if ckind[0] =? 0 and not if_had_else and if_a >=? 0 {
                        rf_op=if_op; rf_a=if_a; rf_b=if_b; rf_val=0
                    } else if ckind[0] =? 3 and blk_br_count =? 1 and blk_br_a >=? 0 {
                        rf_op=blk_br_op; rf_a=blk_br_a; rf_b=blk_br_b; rf_val=1
                    }
                }
                let dropped=false
                if w_ins >? input and (w_ins - 1)[0].op =? 'br' and (w_ins - 1)[0].imm =? 0 {w_ins-=1}
                if w_ins >? input {
                    let lop=(w_ins - 1)[0].op
                    if lop =? 'block' {w_ins-=1; dropped=true}
                    else if lop =? 'if_' {
                        regs[int64((w_ins - 1)[0].a)].nuse=(OptIndex(regs[int64((w_ins - 1)[0].a)].nuse) - OptIndex(1))
                        w_ins-=1; dropped=true
                    }
                }
                if not dropped and cdepth <? 256 and ckind[cdepth] =? 3 {
                    let st=bstart[cdepth]
                    let cur_w=(OptWord(w_ins as int64) - OptWord(input as int64)) // size_of<Ins>
                    if cur_w - st >=? 6 and cur_w - st <=? 32 and input[st + 1].op =? 'block' {
                        let selected=oc_if_select(input st cur_w)
                        if selected >=? 0 {
                            regs=o_regs
                            vt=opt_vtypes
                            let sel=input + (selected - 1)
                            regs[int64(sel[0].a)].nuse=(OptIndex(regs[int64(sel[0].a)].nuse) + OptIndex(1))
                            regs[int64(sel[0].b)].nuse=(OptIndex(regs[int64(sel[0].b)].nuse) + OptIndex(1))
                            regs[int64(sel[0].c)].nuse=(OptIndex(regs[int64(sel[0].c)].nuse) + OptIndex(1))
                            w_ins=input + selected
                            dropped=true
                        }
                    }
                }
                if not dropped {
                    if w_ins not=? p_ins {w_ins[0]=p_ins[0]}
                    w_ins+=1
                }
            }
            <'brif'> => {
                let c=int64(regs[int64(p_ins[0].a)].repl)
                if regs[c].constant {
                    if regs[c].cval not=? 0 {
                        if cdepth - 1 - p_ins[0].imm =? 0 {blk_br_count+=1}
                        w_ins[0].op='br'; w_ins[0].ty=0; w_ins[0].dst=0; w_ins[0].a=0; w_ins[0].b=0; w_ins[0].c=0; w_ins[0].imm=p_ins[0].imm; w_ins[0].pos=0
                        w_ins+=1
                        dead=1
                    }
                } else {
                    if cdepth - 1 - p_ins[0].imm =? 0 {
                        blk_br_count+=1
                        if blk_br_count =? 1 and cdepth =? 1 and w_ins >? input {
                            let prev=w_ins - 1
                            let ptag0=int64((prev as ptr<uint32>)[0])
                            if ptag0 >=? 19 and ptag0 <=? 28 and prev[0].ty =? 0 and int64(prev[0].dst) =? c and regs[int64(prev[0].a)].ndef =? 1 and regs[int64(prev[0].b)].ndef =? 1 {
                                blk_br_op=prev[0].op; blk_br_a=int64(prev[0].a); blk_br_b=int64(prev[0].b)
                            }
                        } else {blk_br_a=-1}
                    }
                    if w_ins not=? p_ins {w_ins[0]=p_ins[0]}
                    w_ins[0].a=OptIndex(c)
                    regs[c].nuse=(OptIndex(regs[c].nuse) + OptIndex(1))
                    w_ins+=1
                }
            }
            _ => {
                let a=int64(regs[int64(p_ins[0].a)].repl)
                let b=int64(regs[int64(p_ins[0].b)].repl)
                if w_ins not=? p_ins {w_ins[0]=p_ins[0]}
                w_ins[0].a=OptIndex(a)
                w_ins[0].b=OptIndex(b)
                regs[a].nuse=(OptIndex(regs[a].nuse) + OptIndex(1))
                regs[b].nuse=(OptIndex(regs[b].nuse) + OptIndex(1))
                w_ins+=1
            }
        }
        p_ins+=1
    }
    # Pass 3: in-place backward DCE.
    let any_nop=false
    let b_ins=w_ins - 1
    loop b_ins >=? input {
        let dw=dec[int64((b_ins as ptr<uint32>)[0])]
        if (dw & 2) not=? 0 and regs[int64(b_ins[0].dst)].nuse =? 0 and not (b_ins[0].op =? 'load' and (int64(b_ins[0].c) & 65536) not=? 0) {
            let mask=(dw >> 8) & 255
            if mask =? 1 {regs[int64(b_ins[0].a)].nuse=(OptIndex(regs[int64(b_ins[0].a)].nuse) - OptIndex(1))}
            else if mask =? 3 {
                regs[int64(b_ins[0].a)].nuse=(OptIndex(regs[int64(b_ins[0].a)].nuse) - OptIndex(1))
                regs[int64(b_ins[0].b)].nuse=(OptIndex(regs[int64(b_ins[0].b)].nuse) - OptIndex(1))
            }
            else if mask =? 65 {
                regs[int64(b_ins[0].a)].nuse=(OptIndex(regs[int64(b_ins[0].a)].nuse) - OptIndex(1))
                if (int64(b_ins[0].c) & 128) not=? 0 {regs[int64(b_ins[0].b)].nuse=(OptIndex(regs[int64(b_ins[0].b)].nuse) - OptIndex(1))}
            }
            else if mask =? 7 {
                regs[int64(b_ins[0].a)].nuse=(OptIndex(regs[int64(b_ins[0].a)].nuse) - OptIndex(1))
                regs[int64(b_ins[0].b)].nuse=(OptIndex(regs[int64(b_ins[0].b)].nuse) - OptIndex(1))
                regs[int64(b_ins[0].c)].nuse=(OptIndex(regs[int64(b_ins[0].c)].nuse) - OptIndex(1))
            }
            b_ins[0].op='nop'
            any_nop=true
        }
        b_ins-=1
    }
    # Pass 4: compaction + mov retargeting (skipped if nothing to compact or retarget).
    if not any_nop and not any_mov {
        if w_ins >? input {__set_len(opt_ir[0].code (OptWord(w_ins as int64) - OptWord(input as int64)) // size_of<Ins>)} else {opt_ir[0].code.clear()}
        return
    }
    if w_ins >? input {
        let wp=input
        let jp=input
        let jend=w_ins
        loop jp <? jend {
            let op=jp[0].op
            if op =? 'nop' {jp+=1; continue}
            if op =? 'mov' and wp >? input {
                let t=int64(jp[0].a)
                let d=int64(jp[0].dst)
                let prev_w=wp - 1
                if t not=? d and regs[t].nuse =? 1 and int64(prev_w[0].dst) =? t {
                    let vtt=int64(vt[t]); let vtd=int64(vt[d])
                    if (if vtt =? 3 {0} else {vtt}) =? (if vtd =? 3 {0} else {vtd}) {
                        let pop=prev_w[0].op
                        let rt=if pop =? 'checked_add' or pop =? 'checked_sub' or pop =? 'checked_mul' {opt_checked_flags} else if pop =? 'call' or pop =? 'calli' or (pop =? 'callc' and prev_w[0].imm >=? 0) or pop =? 'syscall' or pop =? 'intr' {true} else {(dec[int64((prev_w as ptr<uint32>)[0])] & 8) not=? 0}
                        if rt {
                            prev_w[0].dst=OptIndex(d)
                            jp+=1; continue
                        }
                    }
                }
            }
            if wp not=? jp {wp[0]=jp[0]}
            wp+=1; jp+=1
        }
        __set_len(opt_ir[0].code (OptWord(wp as int64) - OptWord(input as int64)) // size_of<Ins>)
    } else {opt_ir[0].code.clear()}
}

let fl_cache_p:ptr<FastLoad>=$unsafe (uint64(0) as ptr<FastLoad>)
let fl_sid_p:ptr<int64>=$unsafe (uint64(0) as ptr<int64>)
let o_ctl_p:ptr<OptControl>=$unsafe (uint64(0) as ptr<OptControl>)
let fl_blk_start_p:ptr<int64>=$unsafe (uint64(0) as ptr<int64>)
let fl_blk_kind_p:ptr<Op>=$unsafe (uint64(0) as ptr<Op>)
let lp_open_p:ptr<int64>=$unsafe (uint64(0) as ptr<int64>)
let lp_open_cap:int64=0
let fl_ctl_cap_g:int64=0
let fl_blk_cap_g:int64=0

fl_ensure_sid=():>void=>$unsafe {
    if fl_sid.length <? 256 {fl_sid.resize(256)}
    fl_sid_p=fl_sid.ptr
}
fl_ensure_pass1=():>void=>$unsafe {
    if lp_open.length <? 256 {lp_open.resize(256)}
    lp_open_p=lp_open.ptr
    lp_open_cap=lp_open.length
}
fl_grow_open=():>void=>$unsafe {
    let nc=OptWord(lp_open_cap) * 2
    lp_open.resize(nc)
    lp_open_p=lp_open.ptr
    lp_open_cap=nc
}
fl_ensure_pass2=():>void=>$unsafe {
    if fl_cache.length <? 256 {fl_cache.resize(256)}
    fl_cache_p=fl_cache.ptr
    if fl_sid.length <? 256 {fl_sid.resize(256)}
    fl_sid_p=fl_sid.ptr
    if o_ctl.length <? 256 {o_ctl.resize(256)}
    if fl_blk_start.length <? o_ctl.length {fl_blk_start.resize(o_ctl.length)}
    o_ctl_p=o_ctl.ptr
    fl_blk_start_p=fl_blk_start.ptr
    fl_ctl_cap_g=o_ctl.length
}
fl_grow_ctl=():>void=>$unsafe {
    let nc=OptWord(fl_ctl_cap_g) * 2
    o_ctl.resize(nc); fl_blk_start.resize(nc)
    o_ctl_p=o_ctl.ptr; fl_blk_start_p=fl_blk_start.ptr
    fl_ctl_cap_g=nc
}
fl_ensure_blk=():>void=>$unsafe {
    if fl_blk_start.length <? 256 {fl_blk_start.resize(256)}
    if fl_blk_kind.length <? fl_blk_start.length {fl_blk_kind.resize(fl_blk_start.length)}
    fl_blk_start_p=fl_blk_start.ptr
    fl_blk_kind_p=fl_blk_kind.ptr
    fl_blk_cap_g=fl_blk_start.length
}
fl_grow_blk=():>void=>$unsafe {
    let nc=OptWord(fl_blk_cap_g) * 2
    fl_blk_start.resize(nc); fl_blk_kind.resize(nc)
    fl_blk_start_p=fl_blk_start.ptr
    fl_blk_kind_p=fl_blk_kind.ptr
    fl_blk_cap_g=nc
}

# Fast in-place default-mode optimizer for loop functions; split into compact
# single-responsibility passes so each hot loop stays register-resident.
fl_pass1=():>void=>$unsafe {
    opt_args=opt_ir[0].args.ptr
    opt_vtypes=opt_ir[0].vtypes.ptr
    opt_fast_nv=opt_ir[0].vtypes.length
    opt_input_count=opt_ir[0].code.length
    opt_nparams=opt_ir[0].nparams
    opt_raw_mem=opt_ir[0].raw_mem
    opt_has_big_loop_const=false
    opt_has_vec_cand=false
    opt_has_float_op=false
    fl_has_const_div=false
    let ncode=opt_input_count
    let input=opt_ir[0].code.ptr
    opt_input=input
    let dec=opt_decode
    let regs=o_regs
    let args=opt_args
    let vt=opt_vtypes
    loop p in [0..opt_nparams) {
        let nd=OptIndex(regs[p].ndef) + OptIndex(1)
        regs[p].ndef=nd
        regs[p].stable=(nd =? 1)
    }
    let constants=opt_ir[0].kval.ptr
    loop v in [0..opt_ir[0].kval.length) {
        if int64(vt[v]) =? 3 {
            regs[v].ndef=(OptIndex(regs[v].ndef) + OptIndex(1))
            regs[v].stable=true
            regs[v].constant=true
            regs[v].cval=constants[v]
        }
    }
    if lp_defs.length >? 0 {__set_len(lp_defs 0)}
    if lp_first.length >? 0 {__set_len(lp_first 0)}
    if lp_limit.length >? 0 {__set_len(lp_limit 0)}
    if lp_parent.length >? 0 {__set_len(lp_parent 0)}
    if lp_kills.length >? 0 {__set_len(lp_kills 0)}
    lp_next=0
    if lp_open.length <? 256 or lp_open_cap <? 256 {fl_ensure_pass1()}
    let open_p=lp_open_p
    let open_cap=lp_open_cap
    let open_n:OptWord=0
    if cap(lp_defs) <? 256 {lp_defs.reserve(256)}
    let defs_p=lp_defs.ptr
    let defs_cap=cap(lp_defs)
    let defs_n:OptWord=0
    let count_defs=not opt_sra_counted
    let active:OptWord=-1
    let p_ins=input
    let end_ins=input + ncode
    loop p_ins <? end_ins {
        let dw=dec[int64((p_ins as ptr<uint32>)[0])]
        if (dw & 1) not=? 0 {
            let d=int64(p_ins[0].dst)
            if d >=? 0 {
                let rd=regs + d
                if count_defs {rd[0].ndef=(OptIndex(rd[0].ndef) + OptIndex(1))}
                rd[0].stable=(rd[0].ndef =? 1)
                if active >=? 0 {
                    if defs_n >=? defs_cap {
                        __set_len(lp_defs defs_n)
                        lp_defs.push(d)
                        defs_p=lp_defs.ptr; defs_cap=cap(lp_defs); defs_n+=1
                    } else {defs_p[defs_n]=d; defs_n+=1}
                }
            }
            if (dw & 4) not=? 0 and active >=? 0 {
                if p_ins[0].op not=? 'call' or p_ins[0].c not=? 1 {
                    lp_kills.ptr[active]=(lp_kills.ptr[active] or 7)
                }
            }
            p_ins+=1
            continue
        }
        let ck=(dw >> 20) & 15
        if ck =? 6 {
            open_n-=1
            let l=open_p[open_n]
            if l >=? 0 {
                lp_limit.ptr[l]=defs_n
                active=lp_parent.ptr[l]
                if active >=? 0 {lp_kills.ptr[active]=(lp_kills.ptr[active] or lp_kills.ptr[l])}
            }
        } else if ck >=? 2 and ck <=? 4 {
            if open_n >=? open_cap {
                fl_grow_open()
                open_p=lp_open_p
                open_cap=lp_open_cap
            }
            if ck =? 3 {
                let l=lp_first.length
                open_p[open_n]=l; open_n+=1
                lp_first.push(defs_n)
                lp_limit.push(-1)
                lp_parent.push(active)
                lp_kills.push(0)
                active=l
            } else {open_p[open_n]=-1; open_n+=1}
        } else if ck =? 15 {
            let a=int64(p_ins[0].a)
            let b=int64(p_ins[0].b)
            loop k in [a..(OptWord(a) + OptWord(b))) {
                let item=int64(args[k])
                if (item & 1) =? 1 {
                    let r0=item >> 1
                    regs[r0].ndef=(OptIndex(regs[r0].ndef) + OptIndex(2))
                    regs[r0].stable=false
                    if active >=? 0 {
                        if defs_n >=? defs_cap {
                            __set_len(lp_defs defs_n)
                            lp_defs.push(r0)
                            defs_p=lp_defs.ptr; defs_cap=cap(lp_defs); defs_n+=1
                        } else {defs_p[defs_n]=r0; defs_n+=1}
                    }
                }
            }
            if active >=? 0 {lp_kills.ptr[active]=(lp_kills.ptr[active] or 7)}
        } else if active >=? 0 and (dw & 4) not=? 0 {
            if p_ins[0].op =? 'store' {
                let m=int64(p_ins[0].c)
                let kill:OptWord=if opt_raw_mem {7} else if (m & 64) not=? 0 {4} else if (m & 32) not=? 0 {2} else {1}
                lp_kills.ptr[active]=(lp_kills.ptr[active] or kill)
            } else {
                lp_kills.ptr[active]=(lp_kills.ptr[active] or 7)
            }
        }
        p_ins+=1
    }
    if defs_n >? 0 {__set_len(lp_defs defs_n)}
}

fl_fold_addr=(@a:int64 @imm:int64 @mode:int64 @idx:int64):>void=>$unsafe {
    let regs=o_regs
    loop fl_def_is(a 4) and regs[int64(regs[a].db)].constant and ow_fits32(OptWord(imm) + OptWord(regs[int64(regs[a].db)].cval)) {
        imm=int64(OptWord(imm) + OptWord(regs[int64(regs[a].db)].cval))
        a=int64(regs[a].da)
    }
    if (mode & 128) =? 0 and fl_def_is(a 4) and not regs[int64(regs[a].db)].constant and not regs[int64(regs[a].da)].constant {
        let base=int64(regs[a].da)
        let ix=int64(regs[a].db)
        let scale:OptWord=0

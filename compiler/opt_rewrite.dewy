    }
    if a =? b {
        let known:OptWord=if op =? 'eq' or op =? 'les' or op =? 'ges' or op =? 'leu' or op =? 'geu' {1} else if op =? 'ne' or op =? 'lts' or op =? 'gts' or op =? 'ltu' or op =? 'gtu' {0} else {-1}
        if known >=? 0 {
            if rd[0].stable {rd[0].constant=true; rd[0].cval=known}
            else {rd[0].ver=(OptIndex(rd[0].ver) + OptIndex(1))}
            w_ins[0].op='iconst'; w_ins[0].ty=0; w_ins[0].dst=cur_p[0].dst; w_ins[0].a=0; w_ins[0].b=0; w_ins[0].c=0; w_ins[0].imm=known; w_ins[0].pos=0
            return 1
        }
    }
    if rb[0].constant {
        let k=rb[0].cval
        let known:int64=-1
        if k =? 0 and (op =? 'mul' or op =? 'and_') {known=0}
        else {
            let tag=int64((cur_p as ptr<uint32>)[0])
            if (tag >=? 21 and tag <=? 28) or tag =? 9 or tag =? 10 {known=fl_bin_const_b(op a k)}
        }
        if known >=? 0 {
            if rd[0].stable {rd[0].constant=true; rd[0].cval=known}
            else {rd[0].ver=(OptIndex(rd[0].ver) + OptIndex(1))}
            w_ins[0].op='iconst'; w_ins[0].ty=0; w_ins[0].dst=cur_p[0].dst; w_ins[0].a=0; w_ins[0].b=0; w_ins[0].c=0; w_ins[0].imm=known; w_ins[0].pos=0
            return 1
        }
        if (k =? 0 and (op =? 'add' or op =? 'sub' or op =? 'or_' or op =? 'xor' or op =? 'shl' or op =? 'shrs' or op =? 'shru')) or (k =? 1 and (op =? 'mul' or op =? 'divs' or op =? 'divu')) or (op =? 'and_' and k =? -1) {
            let vtd=int64(vt[d]); let vta=int64(vt[a])
            if rd[0].stable and (if vtd =? 3 {0} else {vtd}) =? (if vta =? 3 {0} else {vta}) {
                if ra[0].stable {
                    rd[0].repl=OptIndex(a)
                    if ra[0].constant {rd[0].constant=true; rd[0].cval=ra[0].cval}
                    return 0
                }
                if depth <? 128 {rd[0].dop=3; rd[0].da=OptIndex(a); rd[0].db=OptIndex(depth); rd[0].dva=ra[0].ver; rd[0].dvb=OptIndex(sids[depth])}
            }
            if not rd[0].stable {rd[0].ver=(OptIndex(rd[0].ver) + OptIndex(1))}
            ra[0].nuse=(OptIndex(ra[0].nuse) + OptIndex(1))
            w_ins[0].op='mov'; w_ins[0].ty=0; w_ins[0].dst=cur_p[0].dst; w_ins[0].a=OptIndex(a); w_ins[0].b=0; w_ins[0].c=0; w_ins[0].imm=0; w_ins[0].pos=0
            return 1
        }
        if op =? 'add' and fl_def_is(a 4) and regs[int64(ra[0].db)].constant {
            let k2=OptWord(k) + OptWord(regs[int64(ra[0].db)].cval)
            let base0=int64(ra[0].da)
            b=fl_kconst(k2)
            regs=o_regs; vt=opt_vtypes
            a=base0; ra=regs + a; rb=regs + b; rd=regs + d
        }
        else if op =? 'mul' {
            let sh=ow_log2_exact(k)
            if sh >? 0 {
                op='shl'
                b=fl_kconst(sh)
                regs=o_regs; vt=opt_vtypes
                ra=regs + a; rb=regs + b; rd=regs + d
            }
        }
        else if op =? 'divu' or op =? 'remu' {
            if k >? 1 {
                let sh=ow_log2_exact(k)
                if sh >? 0 {
                    if op =? 'divu' {
                        op='shru'
                        b=fl_kconst(sh)
                        regs=o_regs; vt=opt_vtypes
                        ra=regs + a; rb=regs + b; rd=regs + d
                    } else if ow_fits32(OptWord(k) - OptWord(1)) {
                        op='and_'
                        b=fl_kconst(OptWord(k) - OptWord(1))
                        regs=o_regs; vt=opt_vtypes
                        ra=regs + a; rb=regs + b; rd=regs + d
                    } else {fl_has_const_div=true}
                } else if opt_mulh_ok {fl_has_const_div=true}
            }
        }
        else if op =? 'divs' or op =? 'rems' {
            if k >? 1 {
                let sh=ow_log2_exact(k)
                if sh >? 0 or opt_mulh_ok {fl_has_const_div=true}
            }
        }
    }
    if loop_depth >? 0 and depth <? 128 and (op =? 'add' or op =? 'mul' or op =? 'shl' or op =? 'eq' or op =? 'ne' or op =? 'geu') {
        if op =? 'eq' or op =? 'ne' {
            let opp=if op =? 'eq' {Op.ne} else {Op.eq}
            let fv=fl_bin_lookup_fact(fl_cache_p sids depth opp a b)
            if fv >=? 0 {
                let kv:OptWord=OptWord(1) - OptWord(fv)
                if rd[0].stable {rd[0].constant=true; rd[0].cval=kv}
                else {rd[0].ver=(OptIndex(rd[0].ver) + OptIndex(1))}
                w_ins[0].op='iconst'; w_ins[0].ty=0; w_ins[0].dst=cur_p[0].dst; w_ins[0].a=0; w_ins[0].b=0; w_ins[0].c=0; w_ins[0].imm=kv; w_ins[0].pos=0
                return 1
            }
        }
        let ctl_p=o_ctl_p
        let ctl_n=fl_p2_ctl_n
        let ed:OptWord=if ctl_n >? 0 and ctl_p[ctl_n - 1].kind =? 3 and ctl_p[ctl_n - 1].branches =? fl_p2_nbr {fl_blk_start_p[ctl_n - 1]} else {depth}
        let e=fl_bin_cse(fl_cache_p sids depth ed op a b d)
        if e >=? 0 {
            if rd[0].stable {
                rd[0].repl=OptIndex(e)
                if regs[e].constant {rd[0].constant=true; rd[0].cval=regs[e].cval}
                return 0
            }
            rd[0].ver=(OptIndex(rd[0].ver) + OptIndex(1))
            regs[e].nuse=(OptIndex(regs[e].nuse) + OptIndex(1))
            let vtd=int64(vt[d])
            w_ins[0].op='mov'; w_ins[0].ty=OptIndex(if vtd =? 3 {0} else {vtd}); w_ins[0].dst=cur_p[0].dst; w_ins[0].a=OptIndex(e); w_ins[0].b=0; w_ins[0].c=0; w_ins[0].imm=0; w_ins[0].pos=0
            return 1
        }
    }
    if w_ins not=? cur_p {w_ins[0]=cur_p[0]}
    w_ins[0].op=op
    w_ins[0].a=OptIndex(a)
    w_ins[0].b=OptIndex(b)
    ra[0].nuse=(OptIndex(ra[0].nuse) + OptIndex(1))
    rb[0].nuse=(OptIndex(rb[0].nuse) + OptIndex(1))
    if d >=? 0 {
        if rd[0].stable {
            rd[0].dop=OptIndex(int64((w_ins as ptr<uint32>)[0]))
            rd[0].da=OptIndex(a); rd[0].db=OptIndex(b)
            rd[0].dva=ra[0].ver; rd[0].dvb=rb[0].ver
        } else {rd[0].ver=(OptIndex(rd[0].ver) + OptIndex(1))}
    }
    1
}

fl_pass2=():>int64=>$unsafe {
    let ncode=opt_input_count
    let input=opt_input
    let dec=opt_decode
    let regs=o_regs
    let args=opt_args
    let vt=opt_vtypes
    if fl_ctl_cap_g <? 256 or o_ctl.length <? 256 or fl_cache.length <? 256 or fl_sid.length <? 256 or fl_blk_start.length <? o_ctl.length {fl_ensure_pass2()}
    let cache=fl_cache_p
    let sids=fl_sid_p
    let ctl_p=o_ctl_p
    let ed_p=fl_blk_start_p
    let ctl_cap=fl_ctl_cap_g
    let ctl_n:OptWord=0
    let nsid:OptWord=OptWord(fl_next_sid) + OptWord(1)
    sids[0]=nsid
    o_gen=0
    o_genf=0
    o_genh=0
    if o_join_regs.length >? 0 {__set_len(o_join_regs 0)}
    if o_join_next.length >? 0 {__set_len(o_join_next 0)}
    let skip:OptWord=0
    let dead:OptWord=0
    let depth:OptWord=0
    let loop_depth:OptWord=0
    let fl_saw_loop=false
    let nbr:OptWord=0
    let p_ins=input
    let end_ins=input + ncode
    let w_ins=input
    loop p_ins <? end_ins {
        let cur_p=p_ins
        p_ins+=1
        let op=cur_p[0].op
        if (skip | dead) not=? 0 {
            if skip >? 0 {
                if op =? 'block' or op =? 'loop' or op =? 'if_' {skip+=1}
                if op =? 'loop' {lp_next=(OptWord(lp_next) + OptWord(1))}
                else if op =? 'else_' and skip =? 1 and ctl_p[ctl_n - 1].kind =? 2 {
                    skip=0
                    if depth <? 128 {nsid+=1; sids[depth]=nsid}
                }
                else if op =? 'end' {
                    skip-=1
                    if skip =? 0 {
                        ctl_n-=1
                        if ctl_p[ctl_n].deferred >=? 0 {ow_join_kill(ctl_p[ctl_n].deferred)}
                        depth-=1
                        if w_ins >? input and ((w_ins - 1)[0].op =? 'block' or (w_ins - 1)[0].op =? 'if_') {
                            if (w_ins - 1)[0].op =? 'if_' {regs[int64((w_ins - 1)[0].a)].nuse=(OptIndex(regs[int64((w_ins - 1)[0].a)].nuse) - OptIndex(1))}
                            w_ins-=1
                        } else {
                            if w_ins not=? cur_p {w_ins[0]=cur_p[0]}
                            w_ins+=1
                        }
                    }
                }
                continue
            }
            if op =? 'block' or op =? 'loop' or op =? 'if_' {
                dead+=1
                if op =? 'loop' {lp_next=(OptWord(lp_next) + OptWord(1))}
                continue
            }
            if op =? 'else_' and dead =? 1 {dead=0}
            else if op =? 'end' {
                dead-=1
                if dead >? 0 {continue}
            }
            else {continue}
        }
        match op {
            <'nop'> => {}
            <'fconst'|'gaddr'|'daddr'|'vzu'> => {
                if (dec[int64((cur_p as ptr<uint32>)[0])] & 1) not=? 0 and cur_p[0].dst >=? 0 and not regs[int64(cur_p[0].dst)].stable {
                    regs[int64(cur_p[0].dst)].ver=(OptIndex(regs[int64(cur_p[0].dst)].ver) + OptIndex(1))
                }
                if w_ins not=? cur_p {w_ins[0]=cur_p[0]}
                w_ins+=1
            }
            <'slot'> => {
                let d=int64(cur_p[0].dst)
                if loop_depth >? 0 and depth <? 128 {
                    let ed:OptWord=if ctl_n >? 0 and ctl_p[ctl_n - 1].kind =? 3 and ctl_p[ctl_n - 1].branches =? nbr {ed_p[ctl_n - 1]} else {depth}
                    let e=fl_slot_cse(cache sids depth ed int64(cur_p[0].a) d)
                    if e >=? 0 {
                        if regs[d].stable {regs[d].repl=OptIndex(e); continue}
                        regs[d].ver=(OptIndex(regs[d].ver) + OptIndex(1))
                        regs[e].nuse=(OptIndex(regs[e].nuse) + OptIndex(1))
                        w_ins[0].op='mov'; w_ins[0].ty=0; w_ins[0].dst=cur_p[0].dst; w_ins[0].a=OptIndex(e); w_ins[0].b=0; w_ins[0].c=0; w_ins[0].imm=0; w_ins[0].pos=0
                        w_ins+=1
                        continue
                    }
                }
                if not regs[d].stable {regs[d].ver=(OptIndex(regs[d].ver) + OptIndex(1))}
                if w_ins not=? cur_p {w_ins[0]=cur_p[0]}
                w_ins+=1
            }
            <'faddr'> => {
                let d=int64(cur_p[0].dst)
                if regs[d].stable {regs[d].dop=65; regs[d].cval=cur_p[0].imm}
                else {regs[d].ver=(OptIndex(regs[d].ver) + OptIndex(1))}
                if w_ins not=? cur_p {w_ins[0]=cur_p[0]}
                w_ins+=1
            }
            <'iconst'> => {
                let d=int64(cur_p[0].dst)
                if regs[d].stable {
                    regs[d].constant=true
                    regs[d].cval=cur_p[0].imm
                } else {
                    regs[d].ver=(OptIndex(regs[d].ver) + OptIndex(1))
                }
                if loop_depth >? 0 and (cur_p[0].imm <? -2147483648 or cur_p[0].imm >? 2147483647) {opt_has_big_loop_const=true}
                if w_ins not=? cur_p {w_ins[0]=cur_p[0]}
                w_ins+=1
            }
            <'mov'> => {
                let a=fl_repl(regs sids depth int64(cur_p[0].a))
                let d=int64(cur_p[0].dst)
                if a =? d {continue}
                if regs[d].stable {
                    let vtd=int64(vt[d]); let td=if vtd =? 3 {0} else {vtd}
                    let vta=int64(vt[a]); let ta=if vta =? 3 {0} else {vta}
                    if td =? ta {
                        if regs[a].stable {
                            regs[d].repl=OptIndex(a)
                            if regs[a].constant {
                                regs[d].constant=true
                                regs[d].cval=regs[a].cval
                            }
                            continue
                        }
                        if depth <? 128 {
                            regs[d].dop=3; regs[d].da=OptIndex(a); regs[d].db=OptIndex(depth)
                            regs[d].dva=regs[a].ver; regs[d].dvb=OptIndex(sids[depth])
                        }
                    }
                    if regs[a].constant and td =? 0 {
                        let kv=regs[a].cval
                        if loop_depth >? 0 and (kv <? -2147483648 or kv >? 2147483647) {opt_has_big_loop_const=true}
                        w_ins[0].op='iconst'; w_ins[0].ty=0; w_ins[0].dst=cur_p[0].dst; w_ins[0].a=0; w_ins[0].b=0; w_ins[0].c=0; w_ins[0].imm=kv; w_ins[0].pos=0
                        w_ins+=1
                        continue
                    }
                } else {
                    regs[d].ver=(OptIndex(regs[d].ver) + OptIndex(1))
                    if regs[a].constant {
                        let vtd=int64(vt[d])
                        if vtd =? 0 or vtd =? 3 {
                            let kv=regs[a].cval
                            if loop_depth >? 0 and (kv <? -2147483648 or kv >? 2147483647) {opt_has_big_loop_const=true}
                            w_ins[0].op='iconst'; w_ins[0].ty=0; w_ins[0].dst=cur_p[0].dst; w_ins[0].a=0; w_ins[0].b=0; w_ins[0].c=0; w_ins[0].imm=kv; w_ins[0].pos=0
                            w_ins+=1
                            continue
                        }
                    }
                }
                if w_ins not=? cur_p {w_ins[0]=cur_p[0]}
                w_ins[0].a=OptIndex(a)
                regs[a].nuse=(OptIndex(regs[a].nuse) + OptIndex(1))
                w_ins+=1
            }
            <'add'|'sub'|'mul'|'divs'|'divu'|'rems'|'remu'|'and_'|'or_'|'xor'|'shl'|'shrs'|'shru'|'rot32'|'eq'|'ne'|'lts'|'les'|'gts'|'ges'|'ltu'|'leu'|'gtu'|'geu'|'overflow_add'|'overflow_sub'|'overflow_mul'> => {
                let a=fl_repl(regs sids depth int64(cur_p[0].a))
                let b=fl_repl(regs sids depth int64(cur_p[0].b))
                let d=int64(cur_p[0].dst)
                let ra=regs + a
                let rb=regs + b
                let rd=regs + d
                if cur_p[0].ty =? 0 and (ra[0].constant or rb[0].constant or a =? b or (loop_depth >? 0 and ((0x10184050 >> (int64((cur_p as ptr<uint32>)[0]) & 63)) & 1) not=? 0)) {
                    if loop_depth >? 0 {fl_p2_ctl_n=ctl_n; fl_p2_nbr=nbr}
                    let kept=fl_p2_bin_cold(cur_p w_ins a b depth loop_depth)
                    regs=o_regs; vt=opt_vtypes
                    if kept not=? 0 {w_ins+=1}
                    continue
                }
                if w_ins not=? cur_p {w_ins[0]=cur_p[0]}
                w_ins[0].a=OptIndex(a)
                w_ins[0].b=OptIndex(b)
                ra[0].nuse=(OptIndex(ra[0].nuse) + OptIndex(1))
                rb[0].nuse=(OptIndex(rb[0].nuse) + OptIndex(1))
                if d >=? 0 {
                    if rd[0].stable {
                        rd[0].dop=OptIndex(int64((w_ins as ptr<uint32>)[0]))
                        rd[0].da=OptIndex(a); rd[0].db=OptIndex(b)
                        rd[0].dva=ra[0].ver; rd[0].dvb=rb[0].ver
                    } else {rd[0].ver=(OptIndex(rd[0].ver) + OptIndex(1))}
                }
                w_ins+=1
            }
            <'checked_add'|'checked_sub'|'checked_mul'> => {
                if fl_p2_checked(cur_p w_ins regs vt sids depth loop_depth) not=? 0 {w_ins+=1}
            }
            <'load'> => {
                let a=fl_repl(regs sids depth int64(cur_p[0].a))
                let mode=int64(cur_p[0].c)
                let imm=cur_p[0].imm
                let idx_r:int64=if (mode & 128) not=? 0 {fl_repl(regs sids depth int64(cur_p[0].b))} else {0}
                if regs[a].stable and int64(regs[a].dop) =? 4 {
                    fl_fold_addr(@a @imm @mode @idx_r)
                }
                let d=int64(cur_p[0].dst)
                if depth <? 128 and loop_depth >? 0 {
                    let ed:OptWord=if ctl_n >? 0 and ctl_p[ctl_n - 1].kind =? 3 and ctl_p[ctl_n - 1].branches =? nbr {ed_p[ctl_n - 1]} else {depth}
                    let e=fl_load_cse(cache sids depth ed a idx_r imm mode int64(cur_p[0].ty) d)
                    if e >=? 0 {
                        if regs[d].stable {
                            regs[d].repl=OptIndex(e)
                            if regs[e].constant {regs[d].constant=true; regs[d].cval=regs[e].cval}
                            continue
                        }
                        regs[d].ver=(OptIndex(regs[d].ver) + OptIndex(1))
                        regs[e].nuse=(OptIndex(regs[e].nuse) + OptIndex(1))
                        let vtd=int64(vt[d])
                        w_ins[0].op='mov'; w_ins[0].ty=OptIndex(if vtd =? 3 {0} else {vtd}); w_ins[0].dst=cur_p[0].dst; w_ins[0].a=OptIndex(e); w_ins[0].b=0; w_ins[0].c=0; w_ins[0].imm=0; w_ins[0].pos=0
                        w_ins+=1
                        continue
                    }
                }
                if regs[d].stable {regs[d].dop=59; regs[d].da=OptIndex(mode)}
                else {regs[d].ver=(OptIndex(regs[d].ver) + OptIndex(1))}
                regs[a].nuse=(OptIndex(regs[a].nuse) + OptIndex(1))
                if (mode & 128) not=? 0 {
                    opt_has_vec_cand=true
                    regs[idx_r].nuse=(OptIndex(regs[idx_r].nuse) + OptIndex(1))
                }
                if w_ins not=? cur_p {w_ins[0]=cur_p[0]}
                w_ins[0].a=OptIndex(a)
                if (mode & 128) not=? 0 {w_ins[0].b=OptIndex(idx_r)}
                w_ins[0].c=OptIndex(mode)
                w_ins[0].imm=imm
                w_ins+=1
            }
            <'store'> => {
                let a=fl_repl(regs sids depth int64(cur_p[0].a))
                let b=fl_repl(regs sids depth int64(cur_p[0].b))
                let mode=int64(cur_p[0].c)
                let imm=cur_p[0].imm
                let ty=int64(cur_p[0].ty)
                let idx_r:int64=if (mode & 128) not=? 0 {fl_repl(regs sids depth int64(cur_p[0].dst))} else {0}
                if regs[a].stable and int64(regs[a].dop) =? 4 {
                    fl_fold_addr(@a @imm @mode @idx_r)
                }
                if opt_raw_mem {o_gen+=1; o_genf+=1; o_genh+=1}
                else if (mode & 64) not=? 0 {o_genh+=1}
                else if (mode & 32) not=? 0 {o_genf+=1}
                else {o_gen+=1}
                if depth <? 128 and loop_depth >? 0 and ((mode & 15) =? 8 or (mode & 32) not=? 0) and regs[b].stable {
                    let key:OptWord=(OptWord(59) << 24) | (OptWord(ty) << 16) | OptWord(mode & 4095)
                    let gen:OptWord=if opt_raw_mem {o_gen} else if (mode & 64) not=? 0 {o_genh} else if (mode & 32) not=? 0 {o_genf} else {o_gen}
                    let va=regs[a].ver
                    let vb:OptIndex=if (mode & 128) not=? 0 {regs[idx_r].ver} else {0}
                    let ed:OptWord=if ctl_n >? 0 and ctl_p[ctl_n - 1].kind =? 3 and ctl_p[ctl_n - 1].branches =? nbr {ed_p[ctl_n - 1]} else {depth}
                    fl_cache_put(cache sids ed gen imm key a idx_r OptIndex(b) va vb regs[b].ver)
                }
                regs[a].nuse=(OptIndex(regs[a].nuse) + OptIndex(1))
                regs[b].nuse=(OptIndex(regs[b].nuse) + OptIndex(1))
                if (mode & 128) not=? 0 {regs[idx_r].nuse=(OptIndex(regs[idx_r].nuse) + OptIndex(1))}
                if w_ins not=? cur_p {w_ins[0]=cur_p[0]}
                w_ins[0].a=OptIndex(a)
                w_ins[0].b=OptIndex(b)
                w_ins[0].c=OptIndex(mode)
                w_ins[0].imm=imm
                if (mode & 128) not=? 0 {w_ins[0].dst=OptIndex(idx_r)}
                w_ins+=1
            }
            <'zero'|'neg'|'not_'|'fneg'|'fsqrt'|'fabs'|'ffloor'|'fceil'|'ftrunc'|'sext8'|'sext16'|'sext32'|'zext8'|'zext16'|'zext32'|'i2f'|'u2f'|'f2i'|'f2f'|'bits2f'|'f2bits'|'vsplat'> => {
                if fl_p2_unary(cur_p w_ins regs vt dec sids depth loop_depth) not=? 0 {w_ins+=1}
            }
            <'call'|'intr'|'syscall'> => {
                let a0=int64(cur_p[0].a)
                loop k in [a0..(OptWord(a0) + OptWord(int64(cur_p[0].b)))) {
                    let u=fl_repl(regs sids depth int64(args[k]))
                    args[k]=OptIndex(u)
                    regs[u].nuse=(OptIndex(regs[u].nuse) + OptIndex(1))
                }
                let nr=(op =? 'call' and cur_p[0].c =? 1)
                if cur_p[0].dst >=? 0 and not regs[int64(cur_p[0].dst)].stable {
                    regs[int64(cur_p[0].dst)].ver=(OptIndex(regs[int64(cur_p[0].dst)].ver) + OptIndex(1))
                }
                if not nr {o_gen+=1; o_genf+=1; o_genh+=1}
                if w_ins not=? cur_p {w_ins[0]=cur_p[0]}
                w_ins+=1
                if nr {dead=1}
            }
            <'calli'|'callc'> => {
                fl_p2_calli(cur_p w_ins regs args sids depth)
                w_ins+=1
            }
            <'ret'> => {
                if w_ins not=? cur_p {w_ins[0]=cur_p[0]}
                if w_ins[0].a >=? 0 {
                    let a=fl_repl(regs sids depth int64(w_ins[0].a))
                    w_ins[0].a=OptIndex(a)
                    regs[a].nuse=(OptIndex(regs[a].nuse) + OptIndex(1))
                }
                w_ins+=1
                dead=1
            }
            <'memcpy'|'memset'|'select'|'vop'|'memeq'|'findbyte'|'scanbytes'|'findb'> => {
                if fl_p2_tri(cur_p w_ins regs vt dec sids depth loop_depth) not=? 0 {w_ins+=1}
            }
            <'vst'> => {
                let a=fl_repl(regs sids depth int64(cur_p[0].a))
                let b=fl_repl(regs sids depth int64(cur_p[0].b))
                let ud=fl_repl(regs sids depth int64(cur_p[0].dst))
                if w_ins not=? cur_p {w_ins[0]=cur_p[0]}
                w_ins[0].a=OptIndex(a); w_ins[0].b=OptIndex(b); w_ins[0].dst=OptIndex(ud)
                regs[a].nuse=(OptIndex(regs[a].nuse) + OptIndex(1))
                regs[b].nuse=(OptIndex(regs[b].nuse) + OptIndex(1))
                regs[ud].nuse=(OptIndex(regs[ud].nuse) + OptIndex(1))
                w_ins+=1
            }
            <'br'|'trap'> => {
                if op =? 'br' {nbr+=1}
                if w_ins not=? cur_p {w_ins[0]=cur_p[0]}
                w_ins+=1
                dead=1
            }
            <'brtable'> => {
                let a=fl_repl(regs sids depth int64(cur_p[0].a))
                if w_ins not=? cur_p {w_ins[0]=cur_p[0]}
                w_ins[0].a=OptIndex(a)
                regs[a].nuse=(OptIndex(regs[a].nuse) + OptIndex(1))
                nbr+=1
                w_ins+=1
                dead=1
            }
            <'assume'> => {
                if depth <? 128 and loop_depth >? 0 and cur_p[0].imm =? 1 {
                    fl_p2_assume(cur_p cache sids ctl_p ed_p ctl_n depth nbr)
                    regs=o_regs; vt=opt_vtypes
                }
            }
            <'block'> => {
                let ed:OptWord=if ctl_n >? 0 and ctl_p[ctl_n - 1].kind =? 3 and ctl_p[ctl_n - 1].branches =? nbr {ed_p[ctl_n - 1]} else {depth}
                if ctl_n >=? ctl_cap {
                    fl_grow_ctl()
                    ctl_p=o_ctl_p; ed_p=fl_blk_start_p; ctl_cap=fl_ctl_cap_g
                }
                let cp=ctl_p + ctl_n
                cp[0].kind=3; cp[0].condition=-1; cp[0].branches=nbr; cp[0].deferred=-1
                ed_p[ctl_n]=ed
                ctl_n+=1
                depth+=1
                if depth <? 128 {nsid+=1; sids[depth]=nsid}
                if w_ins not=? cur_p {w_ins[0]=cur_p[0]}
                w_ins+=1
            }
            <'loop'> => {
                ow_enter_loop()
                if ctl_n >=? ctl_cap {
                    fl_grow_ctl()
                    ctl_p=o_ctl_p; ed_p=fl_blk_start_p; ctl_cap=fl_ctl_cap_g
                }
                let cp=ctl_p + ctl_n
                cp[0].kind=4; cp[0].condition=-1; cp[0].branches=nbr; cp[0].deferred=-1
                ed_p[ctl_n]=depth
                ctl_n+=1
                loop_depth+=1
                fl_saw_loop=true
                depth+=1
                if depth <? 128 {nsid+=1; sids[depth]=nsid}
                if w_ins not=? cur_p {w_ins[0]=cur_p[0]}
                w_ins+=1
            }
            <'if_'> => {
                let c=fl_repl(regs sids depth int64(cur_p[0].a))
                let fv:int64=if loop_depth >? 0 {fl_fact(c depth sids)} else {-1}
                if ctl_n >=? ctl_cap {
                    fl_grow_ctl()
                    ctl_p=o_ctl_p; ed_p=fl_blk_start_p; ctl_cap=fl_ctl_cap_g
                }
                let cp=ctl_p + ctl_n
                if regs[c].constant or fv >=? 0 {
                    w_ins[0].op='block'; w_ins[0].ty=0; w_ins[0].dst=0; w_ins[0].a=0; w_ins[0].b=0; w_ins[0].c=0; w_ins[0].imm=0; w_ins[0].pos=0
                    w_ins+=1
                    depth+=1
                    if depth <? 128 {nsid+=1; sids[depth]=nsid}
                    cp[0].condition=-1; cp[0].branches=nbr; cp[0].deferred=-1
                    if (regs[c].constant and regs[c].cval not=? 0) or fv =? 1 {cp[0].kind=1}
                    else {cp[0].kind=2; skip=1}
                    ed_p[ctl_n]=depth
                    ctl_n+=1
                } else {
                    cp[0].kind=0; cp[0].condition=c; cp[0].branches=nbr; cp[0].deferred=-1
                    ed_p[ctl_n]=depth
                    ctl_n+=1
                    depth+=1
                    if depth <? 128 {nsid+=1; sids[depth]=nsid}
                    if loop_depth >? 0 {fl_set_fact(c depth sids 1)}
                    if w_ins not=? cur_p {w_ins[0]=cur_p[0]}
                    w_ins[0].a=OptIndex(c)
                    regs[c].nuse=(OptIndex(regs[c].nuse) + OptIndex(1))
                    w_ins+=1
                }
            }
            <'else_'> => {
                let top=ctl_n - 1
                let c=ctl_p[top].condition
                ctl_p[top].condition=-1
                if ctl_p[top].kind =? 1 {skip=1}
                else {
                    if depth <? 128 {nsid+=1; sids[depth]=nsid}
                    if loop_depth >? 0 and c >=? 0 {fl_set_fact(c depth sids 0)}
                    if w_ins not=? cur_p {w_ins[0]=cur_p[0]}
                    w_ins+=1
                }
            }
            <'end'> => {
                ctl_n-=1
                let fp=ctl_p + ctl_n
                let fr_kind=fp[0].kind
                let fr_cond=fp[0].condition
                let fr_br=fp[0].branches
                if fr_kind =? 4 {loop_depth-=1}
                if fp[0].deferred >=? 0 {ow_join_kill(fp[0].deferred)}
                if loop_depth >? 0 and w_ins >? input and fr_kind =? 3 and fr_cond >=? 0 and fr_br + 2 =? nbr and (w_ins - 1)[0].op =? 'br' and (w_ins - 1)[0].imm >? 0 {
                    let target=ctl_n - OptWord((w_ins - 1)[0].imm)
                    if target >=? 0 {
                        let bd=fl_branch_copy(input (OptWord(w_ins as int64) - OptWord(input as int64)) // size_of<Ins>)
                        if bd >=? 0 {
                            regs[bd].ver=(OptIndex(regs[bd].ver) - OptIndex(1))
                            o_join_regs.push(bd)
                            o_join_next.push(ctl_p[target].deferred)
                            ctl_p[target].deferred=o_join_regs.length - 1
                        }
                    }
                }
                depth-=1
                let terminates=false
                if w_ins >? input {
                    let lop=(w_ins - 1)[0].op
                    if lop =? 'block' {w_ins-=1; continue}
                    if lop =? 'if_' {
                        regs[int64((w_ins - 1)[0].a)].nuse=(OptIndex(regs[int64((w_ins - 1)[0].a)].nuse) - OptIndex(1))
                        w_ins-=1
                        continue
                    }
                    terminates=(lop =? 'ret' or lop =? 'trap' or (lop =? 'br' and (w_ins - 1)[0].imm >? 0) or (lop =? 'call' and (w_ins - 1)[0].c =? 1))
                }
                if w_ins not=? cur_p {w_ins[0]=cur_p[0]}
                w_ins+=1
                if loop_depth >? 0 and terminates and fr_cond >=? 0 {
                    let ed:OptWord=if ctl_n >? 0 and ctl_p[ctl_n - 1].kind =? 3 and ctl_p[ctl_n - 1].branches =? nbr {ed_p[ctl_n - 1]} else {depth}
                    if fr_kind =? 3 and (fr_br + 1 =? nbr or ((w_ins - 2)[0].op =? 'br' and fr_br + 2 =? nbr)) {fl_set_fact(fr_cond ed sids 1)}
                    else if fr_kind =? 0 and (fr_br =? nbr or ((w_ins - 2)[0].op =? 'br' and fr_br + 1 =? nbr)) {fl_set_fact(fr_cond ed sids 0)}
                }
            }
            <'brif'> => {
                let c=fl_repl(regs sids depth int64(cur_p[0].a))
                let fv:int64=if loop_depth >? 0 {fl_fact(c depth sids)} else {-1}
                if regs[c].constant or fv >=? 0 {
                    if (regs[c].constant and regs[c].cval not=? 0) or fv =? 1 {
                        nbr+=1
                        w_ins[0].op='br'; w_ins[0].ty=0; w_ins[0].dst=0; w_ins[0].a=0; w_ins[0].b=0; w_ins[0].c=0; w_ins[0].imm=cur_p[0].imm; w_ins[0].pos=0
                        w_ins+=1
                        dead=1
                    }
                } else {
                    nbr+=1
                    if loop_depth >? 0 {
                        let target=OptWord(ctl_n - 1) - OptWord(cur_p[0].imm)
                        if target >=? 0 and ctl_p[target].kind =? 3 {ctl_p[target].condition=c}
                        fl_set_fact(c depth sids 0)
                    }
                    if w_ins not=? cur_p {w_ins[0]=cur_p[0]}
                    w_ins[0].a=OptIndex(c)
                    regs[c].nuse=(OptIndex(regs[c].nuse) + OptIndex(1))
                    w_ins+=1
                }
            }
            <'zeroslots'> => {
                o_gen+=1; o_genf+=1; o_genh+=1
                let a0=int64(cur_p[0].a)
                loop k in [a0..(OptWord(a0) + OptWord(int64(cur_p[0].b)))) {
                    let item=int64(args[k])
                    if (item & 1) =? 1 {regs[item >> 1].ver=(OptIndex(regs[item >> 1].ver) + OptIndex(1))}
                }
                if w_ins not=? cur_p {w_ins[0]=cur_p[0]}
                w_ins+=1
            }
            _ => {
                if op =? 'fadd' or op =? 'fsub' or op =? 'fmul' or op =? 'fdiv' {opt_has_vec_cand=true; opt_has_float_op=true}
                let tag=int64((cur_p as ptr<uint32>)[0])
                let dw=dec[tag]
                let a=fl_repl(regs sids depth int64(cur_p[0].a))
                let b=fl_repl(regs sids depth int64(cur_p[0].b))
                let d=int64(cur_p[0].dst)
                if w_ins not=? cur_p {w_ins[0]=cur_p[0]}
                w_ins[0].a=OptIndex(a)
                w_ins[0].b=OptIndex(b)
                regs[a].nuse=(OptIndex(regs[a].nuse) + OptIndex(1))
                regs[b].nuse=(OptIndex(regs[b].nuse) + OptIndex(1))
                if d >=? 0 and (dw & 1) not=? 0 {
                    if regs[d].stable {
                        regs[d].dop=OptIndex(tag)
                        regs[d].da=OptIndex(a); regs[d].db=OptIndex(b)
                        regs[d].dva=regs[a].ver; regs[d].dvb=regs[b].ver
                    } else {regs[d].ver=(OptIndex(regs[d].ver) + OptIndex(1))}
                } else if (dw & 4) not=? 0 {o_gen+=1; o_genf+=1; o_genh+=1}
                w_ins+=1
            }
        }
    }
    fl_next_sid=nsid
    opt_has_loops=fl_saw_loop
    (OptWord(w_ins as int64) - OptWord(input as int64)) // size_of<Ins>
}

fl_pass3_dce=(used:int64):>void=>$unsafe {
    if used <=? 0 {return}
    let input=opt_input
    let dec=opt_decode
    let regs=o_regs
    let b_ins=input + (used - 1)
    loop b_ins >=? input {
        let dw=dec[int64((b_ins as ptr<uint32>)[0])]
        if (dw & 2) not=? 0 and regs[int64(b_ins[0].dst)].nuse =? 0 and not (b_ins[0].op =? 'load' and (int64(b_ins[0].c) & 65536) not=? 0) {
            let mask=(dw >> 8) & 255
            if mask =? 1 {regs[int64(b_ins[0].a)].nuse=(OptIndex(regs[int64(b_ins[0].a)].nuse) - OptIndex(1))}
            else if mask =? 3 {
                regs[int64(b_ins[0].a)].nuse=(OptIndex(regs[int64(b_ins[0].a)].nuse) - OptIndex(1))
                regs[int64(b_ins[0].b)].nuse=(OptIndex(regs[int64(b_ins[0].b)].nuse) - OptIndex(1))
            }
            else if mask =? 65 {
                regs[int64(b_ins[0].a)].nuse=(OptIndex(regs[int64(b_ins[0].a)].nuse) - OptIndex(1))
                if (int64(b_ins[0].c) & 128) not=? 0 {regs[int64(b_ins[0].b)].nuse=(OptIndex(regs[int64(b_ins[0].b)].nuse) - OptIndex(1))}
            }
            else if mask =? 7 {
                regs[int64(b_ins[0].a)].nuse=(OptIndex(regs[int64(b_ins[0].a)].nuse) - OptIndex(1))
                regs[int64(b_ins[0].b)].nuse=(OptIndex(regs[int64(b_ins[0].b)].nuse) - OptIndex(1))
                regs[int64(b_ins[0].c)].nuse=(OptIndex(regs[int64(b_ins[0].c)].nuse) - OptIndex(1))
            }
            b_ins[0].op='nop'
        }
        b_ins-=1
    }
}

fl_compact_end=(input:ptr<Ins> st:OptWord bk:Op w0:OptWord):>OptWord=>$unsafe {
    let w:OptWord=w0
    let wp=input + w
    let dec=opt_decode
    let regs=o_regs
    if bk =? 'block' and w - st >=? 6 and w - st <=? 32 and input[st + 1].op =? 'block' {
        let selected=oc_if_select(input st w)
        if selected >=? 0 {return selected}
    }
    if (wp - 1)[0].op =? 'mov' {
        let copied=oc_extreme_select(input st w)
        if copied >=? 0 {
            w=copied; wp=input + w
            if w =? st + 1 {return w}
        }
    }
    let last=wp - 1
    if last[0].op =? 'br' and last[0].imm =? 0 {w-=1; wp-=1}
    if w =? st + 1 {return w - 1}
    if bk =? 'block' {
        if w =? st + 2 and (dec[int64(((wp - 1) as ptr<uint32>)[0])] & 2) not=? 0 {
            w-=1; wp-=1
            let dst_p=wp - 1
            dst_p[0]=wp[0]
            return w
        }
        if w >=? 2 {
            let l2=wp - 1
            if l2[0].op =? 'br' and l2[0].imm >=? 1 {
                let prev=wp - 2
                if prev[0].op =? 'brif' and prev[0].imm =? 0 {
                    let c=int64(prev[0].a)
                    if c >=? 0 and c <? o_reg_count and regs[c].nuse =? 1 {
                        let cd:OptWord=-1
                        let plain=true
                        let k:OptWord=st + 1
                        let kend:OptWord=w - 2
                        loop k <? kend {
                            let ek=input + k
                            let eo=ek[0].op
                            if eo =? 'br' or eo =? 'brif' or eo =? 'brtable' or eo =? 'block' or eo =? 'loop' or eo =? 'if_' or eo =? 'end' or eo =? 'else_' {plain=false}
                            if int64(ek[0].dst) =? c and (dec[int64((ek as ptr<uint32>)[0])] & 1) not=? 0 {cd=k}
                            k+=1
                        }
                        if plain and cd >=? 0 and oc_negate(input[cd].op) not=? 'nop' {
                            input[cd].op=oc_negate(input[cd].op)
                            let d2=OptWord(l2[0].imm) - OptWord(1)
                            w-=2
                            let sk:OptWord=st
                            let send:OptWord=w - 1
                            loop sk <? send {input[sk]=input[sk + 1]; sk+=1}
                            w-=1
                            wp=input + w
                            wp[0]=Ins('brif' 0 0 OptIndex(c) 0 0 d2)
                            return w + 1
                        }
                    }
                }
            }
        }
    } else if w >=? 2 and (wp - 1)[0].op =? 'br' and (wp - 1)[0].imm >=? 1 and (wp - 2)[0].op =? 'if_' {
        let limm=(wp - 1)[0].imm
        let pa=(wp - 2)[0].a
        w-=2; wp-=2
        wp[0]=Ins('brif' 0 0 pa 0 0 (OptWord(limm) - OptWord(1)))
        return w + 1
    }
    -1 - w
}

fl_compact_mov=(input:ptr<Ins> wp:ptr<Ins> w:OptWord cur_p:ptr<Ins>):>bool=>$unsafe {
    let t=int64(cur_p[0].a)
    let d=int64(cur_p[0].dst)
    if t =? d or t <? 0 or t >=? o_reg_count or o_regs[t].nuse not=? 1 {return false}
    let vt=opt_vtypes
    let vtt=int64(vt[t]); let vtd=int64(vt[d])
    if (if vtt =? 3 {0} else {vtt}) not=? (if vtd =? 3 {0} else {vtd}) {return false}
    let dec=opt_decode
    let ep=wp - 1
    let etag0=int64((ep as ptr<uint32>)[0])
    if int64(ep[0].dst) =? t and (dec[etag0] & 1) not=? 0 {
        let eo0=ep[0].op
        let rt0=if eo0 =? 'checked_add' or eo0 =? 'checked_sub' or eo0 =? 'checked_mul' {opt_checked_flags} else if eo0 =? 'call' or eo0 =? 'calli' or (eo0 =? 'callc' and ep[0].imm >=? 0) or eo0 =? 'syscall' or eo0 =? 'intr' {true} else {(dec[etag0] & 8) not=? 0}
        if rt0 {ep[0].dst=OptIndex(d); return true}
        return false
    }
    let elim=if w >? 8 {wp - 8} else {input}
    loop ep >=? elim {
        let eo=ep[0].op
        let etag=int64((ep as ptr<uint32>)[0])
        let edef=(dec[etag] & 1) not=? 0
        if int64(ep[0].dst) =? t and edef {
            let rt=if eo =? 'checked_add' or eo =? 'checked_sub' or eo =? 'checked_mul' {opt_checked_flags} else {(dec[etag] & 8) not=? 0}
            if rt {ep[0].dst=OptIndex(d); return true}
            return false
        }
        if eo =? 'block' or eo =? 'loop' or eo =? 'if_' or eo =? 'else_' or eo =? 'end' or eo =? 'br' or eo =? 'brif' or eo =? 'brtable' or eo =? 'zeroslots' {return false}
        let ed:OptWord=if edef {int64(ep[0].dst)} else {-1}
        if ed =? d or oc_has_use(ep d) or ed =? t {return false}
        ep-=1
    }
    false
}

fl_pass4_compact=(used:int64):>void=>$unsafe {
    if used <=? 0 {opt_ir[0].code.clear(); return}
    let input=opt_input
    let dec=opt_decode
    if fl_blk_cap_g <? 256 or fl_blk_kind.length <? fl_blk_start.length {fl_ensure_blk()}
    let bs_p=fl_blk_start_p
    let bk_p=fl_blk_kind_p
    let bcap=fl_blk_cap_g
    let bn:OptWord=0
    let w:OptWord=0
    let wp=input
    let jp=input
    let jend=input + used
    loop jp <? jend {
        let cur_p=jp
        jp+=1
        let ck=(dec[int64((cur_p as ptr<uint32>)[0])] >> 20) & 15
        if ck =? 0 {
            if wp not=? cur_p {wp[0]=cur_p[0]}
            wp+=1; w+=1
            continue
        }
        if ck =? 1 {continue}
        if ck >=? 2 and ck <=? 4 {
            if bn >=? bcap {
                fl_grow_blk()
                bs_p=fl_blk_start_p; bk_p=fl_blk_kind_p; bcap=fl_blk_cap_g
            }
            bs_p[bn]=w; bk_p[bn]=cur_p[0].op; bn+=1
            if wp not=? cur_p {wp[0]=cur_p[0]}
            wp+=1; w+=1
            continue
        }
        if ck =? 6 {
            if w >? 0 {
                bn-=1
                let bk=bk_p[bn]
                if bk not=? 'loop' {
                    let r=fl_compact_end(input bs_p[bn] bk w)
                    if r >=? 0 {w=r; wp=input + w; continue}
                    w=-1 - r; wp=input + w
                }
            }
        } else if ck =? 13 {
            if w >? 0 and fl_compact_mov(input wp w cur_p) {continue}
        } else if ck =? 14 {
            if w >? 0 {
                let last=wp - 1
                let t=int64(cur_p[0].b)
                if last[0].op =? 'vop' and int64(last[0].a) =? t and o_regs[t].nuse =? 2 and int64(cur_p[0].imm) =? (OptWord((int64(last[0].imm) >> 4) & 7) * OptWord(4)) and oc_sole_slot(input used t) {
                    last[0].a=cur_p[0].a
                    continue
                }
            }
        }
        if wp not=? cur_p {wp[0]=cur_p[0]}
        wp+=1; w+=1
    }
    __set_len(opt_ir[0].code w)
}

fl_div_kconst=(@out:array<Ins> v:int64 loop_depth:OptWord):>int64=>$unsafe {
    if ow_fits32(v) {return ow_k_vreg(v)}
    let d=ow_vreg(0)
    if loop_depth >? 0 {opt_has_big_loop_const=true}
    out.push(Ins('iconst' 0 OptIndex(d) 0 0 0 v))
    d
}

fl_div_bin=(@out:array<Ins> op:Op d:int64 a:int64 b:int64):>int64=>{
    out.push(Ins(op 0 OptIndex(d) OptIndex(a) OptIndex(b) 0 0))
    d
}

fl_div_nonneg=(out:array<Ins> v0:int64):>bool=>$unsafe {ow_nonnegative_in(out.ptr out.length v0)}

fl_expand_const_divs=():>void=>$unsafe {
    let code=opt_ir[0].code
    let n=code.length
    let out:array<Ins>=[]
    out.reserve(n + 32)
    let regs=o_regs
    let loop_depth:OptWord=0
    let nonneg_rem:int64=-1
    let kinds:array<Op>=[]
    let cp=code.ptr
    let endp=cp + n
    loop cp <? endp {
        let ins=cp[0]
        cp+=1
        let op=ins.op
        if op =? 'block' or op =? 'loop' or op =? 'if_' {
            if op =? 'if_' and int64(ins.a) >=? 0 and int64(ins.a) <? o_reg_count and regs[int64(ins.a)].constant and regs[int64(ins.a)].cval =? 0 {
                let scan=cp
                let nest:OptWord=1
                let has_else=false
                loop scan <? endp and nest >? 0 {
                    let sop=scan[0].op
                    if sop =? 'block' or sop =? 'loop' or sop =? 'if_' {nest+=1}
                    else if sop =? 'else_' and nest =? 1 {has_else=true; break}
                    else if sop =? 'end' {nest-=1}
                    scan+=1
                }
                if not has_else and nest =? 0 {cp=scan; continue}
            }
            kinds.push(op)
            if op =? 'loop' {loop_depth+=1}
            out.push(ins)
            continue
        }
        if op =? 'end' {
            if kinds.length >? 0 and kinds.pop() =? 'loop' {loop_depth-=1}
            out.push(ins)
            continue
        }
        if op =? 'lts' and ins.ty =? 0 and nonneg_rem >=? 0 and int64(ins.a) =? nonneg_rem {
            let b0=int64(ins.b)
            if b0 >=? 0 and b0 <? o_reg_count and regs[b0].constant and regs[b0].cval =? 0 {
                let ld=int64(ins.dst)
                if ld >=? 0 and ld <? o_reg_count and (ld >=? opt_fast_nv or regs[ld].stable) {
                    regs[ld].constant=true; regs[ld].cval=0
                }
                out.push(Ins('iconst' 0 ins.dst 0 0 0 0))
                continue
            }
        }
        if op =? 'select' and int64(ins.a) >=? 0 and int64(ins.a) <? o_reg_count and regs[int64(ins.a)].constant {
            let picked=if regs[int64(ins.a)].cval not=? 0 {ins.b} else {ins.c}
            out.push(Ins('mov' ins.ty ins.dst picked 0 0 0))
            continue
        }
        if (op =? 'divs' or op =? 'rems' or op =? 'divu' or op =? 'remu') and ins.ty =? 0 {
            let b=int64(ins.b)
            if b >=? 0 and b <? o_reg_count and regs[b].constant {
                let k=regs[b].cval
                if k >? 1 {
                    let a=int64(ins.a)
                    let d=int64(ins.dst)
                    let sh=ow_log2_exact(k)
                    if sh >? 0 {
                        if op =? 'divu' {
                            fl_div_bin(@out 'shru' d a fl_div_kconst(@out sh loop_depth));
                            continue
                        }
                        if op =? 'remu' {
                            fl_div_bin(@out 'and_' d a fl_div_kconst(@out OptWord(k) - OptWord(1) loop_depth));
                            continue
                        }
                        if fl_div_nonneg(out a) {
                            if op =? 'divs' {fl_div_bin(@out 'shrs' d a fl_div_kconst(@out sh loop_depth));}
                            else {
                                fl_div_bin(@out 'and_' d a fl_div_kconst(@out OptWord(k) - OptWord(1) loop_depth));
                                regs=o_regs
                                if d >=? 0 and (d >=? opt_fast_nv or (d <? o_reg_count and regs[d].stable)) {nonneg_rem=d}
                            }
                            regs=o_regs
                            continue
                        }
                        let t1=fl_div_bin(@out 'shrs' ow_vreg(0) a fl_div_kconst(@out 63 loop_depth))
                        let t2=fl_div_bin(@out 'shru' ow_vreg(0) t1 fl_div_kconst(@out OptWord(64) - OptWord(sh) loop_depth))
                        let t3=fl_div_bin(@out 'add' ow_vreg(0) a t2)
                        if op =? 'divs' {fl_div_bin(@out 'shrs' d t3 fl_div_kconst(@out sh loop_depth));}
                        else {
                            let t4=fl_div_bin(@out 'and_' ow_vreg(0) t3 fl_div_kconst(@out -OptWord(k) loop_depth))
                            fl_div_bin(@out 'sub' d a t4);
                        }
                        continue
                    }
                    if opt_mulh_ok {
                        if op =? 'divs' or op =? 'rems' {
                            let [mag s]=ow_div_magic(k)
                            let plain=fl_div_nonneg(out a)
                            let q=fl_div_bin(@out 'mulhs' ow_vreg(0) a fl_div_kconst(@out mag loop_depth))
                            if mag <? 0 {q=fl_div_bin(@out 'add' ow_vreg(0) q a)}
                            if s >? 0 {q=fl_div_bin(@out 'shrs' ow_vreg(0) q fl_div_kconst(@out s loop_depth))}
                            let qq=q
                            if not plain {
                                let neg=fl_div_bin(@out 'shru' ow_vreg(0) a fl_div_kconst(@out 63 loop_depth))
                                qq=fl_div_bin(@out 'add' (if op =? 'divs' {d} else {ow_vreg(0)}) q neg)
                            } else if op =? 'divs' {
                                fl_div_bin(@out 'mov' d q 0);
                            }
                            if op =? 'rems' {
                                let t=fl_div_bin(@out 'mul' ow_vreg(0) qq fl_div_kconst(@out k loop_depth))
                                fl_div_bin(@out 'sub' d a t);
                                regs=o_regs
                                if plain and d >=? 0 and (d >=? opt_fast_nv or (d <? o_reg_count and regs[d].stable)) {nonneg_rem=d}
                            }
                            regs=o_regs
                            continue
                        }
                        let [mag s add]=ow_divu_magic(uint64(k))
                        let qd=if op =? 'remu' {ow_vreg(0)} else {d}
                        let t=fl_div_bin(@out 'mulhu' ow_vreg(0) a fl_div_kconst(@out (mag transmute int64) loop_depth))
                        if add {
                            let q1=fl_div_bin(@out 'sub' ow_vreg(0) a t)
                            let q2=fl_div_bin(@out 'shru' ow_vreg(0) q1 fl_div_kconst(@out 1 loop_depth))
                            if s >? 1 {
                                let q3=fl_div_bin(@out 'add' ow_vreg(0) q2 t)
                                fl_div_bin(@out 'shru' qd q3 fl_div_kconst(@out OptWord(s) - OptWord(1) loop_depth));
                            } else {
                                fl_div_bin(@out 'add' qd q2 t);
                            }
                        } else {
                            fl_div_bin(@out 'shru' qd t fl_div_kconst(@out s loop_depth));
                        }
                        if op =? 'remu' {
                            let m=fl_div_bin(@out 'mul' ow_vreg(0) qd fl_div_kconst(@out k loop_depth))
                            fl_div_bin(@out 'sub' d a m);
                        }
                        continue
                    }
                }
            }
        }
        out.push(ins)
    }
    opt_ir[0].code=out
    opt_vtypes=opt_ir[0].vtypes.ptr
}

# Fast in-place default-mode optimizer for loop functions; multi-instruction
# constant divisions expand in one compact post-pass only when present.
opt_fast_loop=():>void=>$unsafe {
    fl_pass1()
    let used=fl_pass2()
    fl_pass3_dce(used)
    fl_pass4_compact(used)
    if fl_has_const_div {fl_expand_const_divs()}
}

opt_rewrite=():>void=>$unsafe {
    o_nonnegative_remainder=-1
    opt_args=opt_ir[0].args.ptr
    opt_vtypes=opt_ir[0].vtypes.ptr
    opt_fast_nv=opt_ir[0].vtypes.length
    opt_input_count=opt_ir[0].code.length
    opt_nparams=opt_ir[0].nparams
    opt_raw_mem=opt_ir[0].raw_mem
    if not opt_allow_cse and not opt_no_fast_straight {
        let input0=opt_ir[0].code.ptr
        let has_loop=false
        loop pos in [0..opt_input_count) {
            if input0[pos].op =? 'loop' {has_loop=true; break}
        }
        if not has_loop {
            opt_has_loops=false
            opt_fast_straight()
            return
        }
    }
    # The outer transfer uses slot 0. Strength reduction uses slot 1 with
    # simplification disabled, so a nested transfer never needs a third slot.
    let nv=opt_ir[0].vtypes.length
    if o_fact_scope.length <? nv * 2 {
        let nf=nv * 2
        if cap(o_fact_scope) <? nf {o_fact_scope.reserve(nf)}
        __set_len(o_fact_scope nf)
        if cap(o_fact_nbr) <? nf {o_fact_nbr.reserve(nf)}
        __set_len(o_fact_nbr nf)
    }
    let regs0=o_regs
    loop p in [0..opt_nparams) {
        regs0[p].ndef=(OptIndex(regs0[p].ndef) + OptIndex(1))
        regs0[p].stable=true
        regs0[p].defpos=-1
    }
    # constant vregs: one canonical vreg per value
    ow_kmap_reset(64)
    let constants=opt_ir[0].kval.ptr
    loop v in [0..opt_ir[0].kval.length) {
        if ow_is_kv(v) {
            regs0[v].ndef=(OptIndex(regs0[v].ndef) + OptIndex(1))
            regs0[v].stable=true
            regs0[v].constant=true
            regs0[v].cval=constants[v]
            let c=ow_kmap_get(constants[v])
            if c >=? 0 {
                regs0[v].repl=OptIndex(c)
            }
            else {
                ow_kmap_put(constants[v] v)
            }
        }
    }
    if o_lastuse.length <? nv {
        if cap(o_lastuse) <? nv {o_lastuse.reserve(nv)}
        __set_len(o_lastuse nv)
    }
    o_input_last=o_lastuse.ptr
    if nv >? 0 {mem_set(o_input_last as ptr<uint8> 255 nv * 4)}
    if o_depth.length <? opt_input_count {
        if cap(o_depth) <? opt_input_count {o_depth.reserve(opt_input_count)}
        __set_len(o_depth opt_input_count)
    }
    let depths=o_depth.ptr
    let depth:OptWord=0
    # (and what each loop defines and stores to, in the same walk)
    lp_defs.clear()
    lp_first.clear()
    lp_limit.clear()
    lp_parent.clear()
    lp_kills.clear()
    lp_open.clear()
    lp_next=0
    let active:OptWord=(- OptWord(int64(1)))
    let lp_insns:OptWord=0
    # One dispatch supplies operand uses, structured-loop facts, definitions,
    # and memory invalidation. Do not reconstruct a general operand view and
    # redispatch the same operation separately for each consumer.
    let input=opt_ir[0].code.ptr
    opt_input=input
    let working=opt_working
    let regs=o_regs
    let ilast=o_input_last
    let args=opt_args
    loop pos in [0..opt_input_count) {
        let ins=(input + pos)
        let op=ins[0].op
        let a=int64(ins[0].a)
        let b=int64(ins[0].b)
        let d=int64(ins[0].dst)
        let kill:OptWord=0
        let pos32=OptIndex(pos)
        depths[pos]=OptIndex(depth)
        match op {
            <'end'> => {
                depth=(OptWord(depth) - OptWord(int64(1)))
                depths[pos]=OptIndex(depth)
                let l=lp_open.pop()
                if (l >=? 0) {
                    lp_limit[l]=lp_defs.length
                    active=lp_parent[l]
                    if (active >=? 0) {
                        lp_kills[active]=(lp_kills[active] or lp_kills[l])
                    }
                }
                d=(- OptWord(int64(1)))
            }
            <'block'|'loop'|'if_'> => {
                depth=(OptWord(depth) + OptWord(int64(1)))
                if (op =? 'loop') {
                    let l=lp_first.length
                    lp_open.push(l)
                    lp_first.push(lp_defs.length)
                    lp_limit.push((- OptWord(int64(1))))
                    lp_parent.push(active)
                    lp_kills.push(0)
                    active=l
                }
                else {
                    lp_open.push((- OptWord(int64(1))))
                }
                if (op =? 'if_') {
                    if (regs[a].first >? pos) {regs[a].first=pos32}
                    ilast[a]=pos32
                }
                d=(- OptWord(int64(1)))
            }
            <'nop'|'else_'|'br'|'trap'|'vzu'> => {
                d=(- OptWord(int64(1)))
            }
            <'iconst'|'fconst'|'slot'|'gaddr'|'daddr'|'faddr'> => {
                {}
            }
            <'intr'|'call'|'syscall'|'calli'|'callc'> => {
                loop k in [a..(OptWord(a) + OptWord(b))) {
                    let u=int64(args[k])
                    if (regs[u].first >? pos) {regs[u].first=pos32}
                    ilast[u]=pos32
                }
                if ((op =? 'calli') or (op =? 'callc')) {
                    let u=int64(ins[0].c)
                    if (regs[u].first >? pos) {regs[u].first=pos32}
                    ilast[u]=pos32
                }
                if ((op not=? 'call') or (ins[0].c not=? 1)) {
                    kill=7
                }
            }
            <'ret'> => {
                if (a >=? 0) {
                    if (regs[a].first >? pos) {regs[a].first=pos32}
                    ilast[a]=pos32
                }
                d=(- OptWord(int64(1)))
            }
            <'brif'|'brtable'|'assume'> => {
                if (regs[a].first >? pos) {regs[a].first=pos32}
                ilast[a]=pos32
                d=(- OptWord(int64(1)))
            }
            <'zero'> => {
                if (regs[a].first >? pos) {regs[a].first=pos32}
                ilast[a]=pos32
                d=(- OptWord(int64(1)))
                kill=7
            }
            <'store'|'vst'> => {
                if (regs[a].first >? pos) {regs[a].first=pos32}
                ilast[a]=pos32
                if (regs[b].first >? pos) {regs[b].first=pos32}
                ilast[b]=pos32
                if ((op =? 'vst') or ((int64(ins[0].c) & 128) not=? 0)) {
                    if (regs[d].first >? pos) {regs[d].first=pos32}
                    ilast[d]=pos32
                }
                if (op =? 'store') {
                    let m=int64(ins[0].c)
                    if opt_raw_mem {
                        kill=7
                    }
                    else if ((m & 64) not=? 0) {
                        kill=4
                    }
                    else if ((m & 32) not=? 0) {
                        kill=2
                    }
                    else {
                        kill=1
                    }
                }
                d=(- OptWord(int64(1)))
            }
            <'copy'> => {
                if (regs[a].first >? pos) {regs[a].first=pos32}
                ilast[a]=pos32
                if (regs[b].first >? pos) {regs[b].first=pos32}
                ilast[b]=pos32
                d=(- OptWord(int64(1)))
                kill=7
            }
            <'memcpy'|'memset'|'vop'> => {
                if (regs[a].first >? pos) {regs[a].first=pos32}
                ilast[a]=pos32
                if (regs[b].first >? pos) {regs[b].first=pos32}
                ilast[b]=pos32
                let uc=int64(ins[0].c)
                if (regs[uc].first >? pos) {regs[uc].first=pos32}
                ilast[uc]=pos32
                d=(- OptWord(int64(1)))
                kill=7
            }
            <'select'|'memeq'|'findbyte'|'scanbytes'|'findb'> => {
                if (regs[a].first >? pos) {regs[a].first=pos32}
                ilast[a]=pos32
                if (regs[b].first >? pos) {regs[b].first=pos32}
                ilast[b]=pos32
                let uc=int64(ins[0].c)
                if (regs[uc].first >? pos) {regs[uc].first=pos32}
                ilast[uc]=pos32
            }
            <'load'> => {
                if (regs[a].first >? pos) {regs[a].first=pos32}
                ilast[a]=pos32
                if ((int64(ins[0].c) & 128) not=? 0) {
                    if (regs[b].first >? pos) {regs[b].first=pos32}
                    ilast[b]=pos32
                }
            }
            <'mov'|'neg'|'not_'|'fneg'|'fsqrt'|'fabs'|'ffloor'|'fceil'|'ftrunc'|'sext8'|'sext16'|'sext32'|'zext8'|'zext16'|'zext32'|'i2f'|'u2f'|'f2i'|'f2f'|'bits2f'|'f2bits'|'vsplat'> => {
                if (regs[a].first >? pos) {regs[a].first=pos32}
                ilast[a]=pos32
            }
            <'zeroslots'> => {
                loop k in [a..(OptWord(a) + OptWord(b))) {
                    let item=int64(args[k])
                    if ((item & 1) =? 1) {
                        regs[(item >> 1)].ndef=(OptIndex(regs[(item >> 1)].ndef) + OptIndex(OptIndex(int64(2))))
                        regs[(item >> 1)].stable=false
                        if (active >=? 0) {
                            lp_defs.push((item >> 1))
                        }
                    }
                }
                d=(- OptWord(int64(1)))
                kill=7
            }
            _ => {
                if (regs[a].first >? pos) {regs[a].first=pos32}
                ilast[a]=pos32
                if (regs[b].first >? pos) {regs[b].first=pos32}
                ilast[b]=pos32
            }
        }
        if (d >=? 0) {
            let rd=regs + d
            if (not opt_sra_counted) {
                rd[0].ndef=(OptIndex(rd[0].ndef) + OptIndex(OptIndex(int64(1))))
            }
            rd[0].defpos=pos32
            rd[0].stable=((rd[0].ndef =? 1) and (rd[0].first >? pos))
            if (active >=? 0) {
                lp_defs.push(d)
            }
        }
        if (active >=? 0) {
            lp_insns=(OptWord(lp_insns) + OptWord(1))
            if (kill not=? 0) {
                lp_kills[active]=(lp_kills[active] or kill)
            }
        }
    }
    # forward: fold, propagate copies, eliminate common subexpressions, drop dead branches
    o_count=0
    if (o_capacity <? opt_input_count) {
        o_capacity=opt_input_count
        if cap(o_out_storage) <? o_capacity {o_out_storage.reserve(o_capacity)}
        __set_len(o_out_storage o_capacity)
        o_out=o_out_storage.ptr
    }
    ow_flow_begin()
    opt_has_loops=lp_first.length >? 0
    o_cse=opt_allow_cse or opt_has_loops
    if o_cse {ow_ht_setup((OptWord(if opt_allow_cse {opt_input_count} else {lp_insns}) + OptWord(int64(16))))}
    # 0 normal, 1 if(true), 2 if(false), 3 block; keep each control's facts together.
    o_ctl.clear()
    let ctl=o_ctl
    o_ctl=[]
    o_join_regs.clear()
    o_join_next.clear()
    o_loop_depth=0
    let skip:OptWord=0
    let dec=opt_decode
    loop pos in [0..opt_input_count) {
        let ins=(input + pos)
        let op=ins[0].op
        if (skip >? 0) {
            if (((op =? 'block') or (op =? 'loop')) or (op =? 'if_')) {
                skip=(OptWord(skip) + OptWord(int64(1)))
            }
            if (op =? 'loop') {
                lp_next=(OptWord(lp_next) + OptWord(int64(1)))
            }
            else if (((op =? 'else_') and (skip =? 1)) and (ctl[(OptWord(ctl.length) - OptWord(int64(1)))].kind =? 2)) {
                skip=0
                ow_scope_open()
            }
            else if (op =? 'end') {
                skip=(OptWord(skip) - OptWord(int64(1)))
                if (skip =? 0) {
                    let frame=ctl.pop()
                    ow_join_kill(frame.deferred)
                    let lop=o_out[(OptWord(o_count) - OptWord(int64(1)))].op
                    if ((lop =? 'block') or (lop =? 'if_')) {
                        ow_pop()
                    }
                    else {
                        ow_append(ins[0])
                    }
                }
            }
            continue
        }
        if ((dec[oc_tag(ins)] & ((OptWord(int64(1)) << 24))) =? 0) {
            working[0]=ins[0]
            ow_transfer(working true)
            continue
        }
        if (op =? 'nop') {
            continue
        }
        if ((op =? 'block') or (op =? 'loop')) {
            let kind:OptWord=4
            if (op =? 'loop') {
                ow_enter_loop()
                o_loop_depth=(OptWord(o_loop_depth) + OptWord(1))
            }
            else {
                kind=3
            }
            ctl.push(OptControl(kind (- OptWord(int64(1))) o_nbr))
            ow_scope_open((op =? 'block'))
            ow_append(ins[0])
            continue
        }
        if (op =? 'if_') {
            let c=int64(o_regs[int64(ins[0].a)].repl)
            let known=((o_regs[c].constant or ow_fact_false(c)) or ow_fact_true(c))
            if known {
                # the if becomes a plain block so branch depths inside stay valid
                ow_append(Ins('block' 0 0 0 0 0 0))
                if (((o_regs[c].constant and (o_regs[c].cval not=? 0))) or ow_fact_true(c)) {
                    ctl.push(OptControl(1 (- OptWord(int64(1))) o_nbr))
                    ow_scope_open()
                }
                else {
                    ctl.push(OptControl(2 (- OptWord(int64(1))) o_nbr))
                    skip=1
                }
                continue
            }
            ctl.push(OptControl(0 c o_nbr))
            ow_scope_open()
            ow_add_fact_true(c)
            let ins2=ins[0]
            ins2.a=OptIndex(c)
            o_regs[c].nuse=(OptIndex(o_regs[c].nuse) + OptIndex(OptIndex(int64(1))))
            ow_append(ins2)
            continue
        }
        if (op =? 'else_') {
            let c=ctl[(OptWord(ctl.length) - OptWord(int64(1)))].condition
            ctl[(OptWord(ctl.length) - OptWord(int64(1)))].condition=(- OptWord(int64(1)))
            ow_scope_close()
            if (ctl[(OptWord(ctl.length) - OptWord(int64(1)))].kind =? 1) {
                skip=1
                continue
            }
            ow_scope_open()
            if (c >=? 0) {
                ow_add_fact_false(c)
            }
            ow_append(ins[0])
            continue
        }
        if (op =? 'end') {
            # A terminating if arm leaves its condition false. For a block with exactly
            # one conditional exit and a terminating tail, only that taken exit reaches
            # the join. Count all branches conservatively, including nested breaks.
            let frame=ctl.pop()
            let c=frame.condition
            let nbr=frame.branches
            let kind=frame.kind
            if kind =? 4 {o_loop_depth=(OptWord(o_loop_depth) - OptWord(1))}
            ow_join_kill(frame.deferred)
            let last=o_out[(OptWord(o_count) - OptWord(int64(1)))]
            if (((((kind =? 3) and (c >=? 0)) and ((OptWord(nbr) + OptWord(int64(2))) =? o_nbr)) and (last.op =? 'br')) and (last.imm >? 0)) {
                let target=(OptWord(ctl.length) - OptWord(int64(last.imm)))
                if (target >=? 0) {
                    let d=ow_branch_copy()
                    if (d >=? 0) {
                        o_regs[d].ver=(OptIndex(o_regs[d].ver) - OptIndex(OptIndex(int64(1))))
                        o_join_regs.push(d)
                        o_join_next.push(ctl[target].deferred)
                        ctl[target].deferred=(OptWord(o_join_regs.length) - OptWord(int64(1)))
                    }
                }
            }
            let terminates=(((last.op =? 'ret') or (last.op =? 'trap')) or (((last.op =? 'call') and (last.c =? 1))))
            let noret=((c >=? 0) and terminates)
            ow_scope_close()
            if ((last.op =? 'block') or (last.op =? 'if_')) {
                # empty construct: drop it (an if's condition is pure)
                ow_pop()
                continue
            }
            ow_append(ins[0])
            if noret {
                if ((kind =? 3) and ((OptWord(nbr) + OptWord(int64(1))) =? o_nbr)) {
                    ow_add_fact_true(c)
                }
                else if ((kind =? 0) and (nbr =? o_nbr)) {
                    ow_add_fact_false(c)
                }
            }
            continue
        }
        if (op =? 'brif') {
            # a branch on a known condition: always or never taken
            let c=int64(o_regs[int64(ins[0].a)].repl)
            if ((o_regs[c].constant or ow_fact_false(c)) or ow_fact_true(c)) {
                if (((o_regs[c].constant and (o_regs[c].cval not=? 0))) or ow_fact_true(c)) {
                    ow_emit(Ins('br' 0 0 0 0 0 ins[0].imm))
                }
                continue
            }
            # Remember an exit's condition for a possible terminating block. Multiple
            # exits (even with the same condition) fail the branch-count check at its end.
            let target=(OptWord((OptWord(ctl.length) - OptWord(int64(1)))) - OptWord(int64(ins[0].imm)))
            if ((target >=? 0) and (ctl[target].kind =? 3)) {
                ctl[target].condition=c
            }
            # (after it, in this construct, the condition is false)
            working[0]=ins[0]
            ow_transfer(working true)
            ow_add_fact_false(c)
            continue
        }
        if (op =? 'zeroslots') {
            ow_kill_all()
            loop k in [0..int64(ins[0].b)) {
                let item=int64(opt_args[(OptWord(int64(ins[0].a)) + OptWord(k))])
                if ((item & 1) =? 1) {
                    o_regs[(item >> 1)].ver=(OptIndex(o_regs[(item >> 1)].ver) + OptIndex(OptIndex(int64(1))))
                }
            }
            ow_append_plain(ins[0])
            continue
        }
        working[0]=ins[0]
        ow_transfer(working true)
    }
    if o_flow_dead {
        ow_flow_end_dead()
    }
    # backward: drop pure instructions whose results are unused (o_push counted the uses)
    let bregs=o_regs
    let bout=o_out
    let i=(OptWord(o_count) - OptWord(int64(1)))
    loop (i >=? 0) {
        let ins=(bout + i)
        let dw=dec[oc_tag(ins)]
        # (a length load that is a null test stays: M_NULLF)
        if ((dw & 2) not=? 0) and not (ins[0].op =? 'load' and int64(ins[0].c) & 65536 not=? 0) {
            let d=int64(ins[0].dst)
            if (bregs[d].nuse =? 0) {
                let mask=(dw >> 8) & 255
                if mask =? 1 {bregs[int64(ins[0].a)].nuse=(OptIndex(bregs[int64(ins[0].a)].nuse) - OptIndex(1))}
                else if mask =? 3 {
                    bregs[int64(ins[0].a)].nuse=(OptIndex(bregs[int64(ins[0].a)].nuse) - OptIndex(1))
                    bregs[int64(ins[0].b)].nuse=(OptIndex(bregs[int64(ins[0].b)].nuse) - OptIndex(1))
                }
                else if mask =? 65 {
                    bregs[int64(ins[0].a)].nuse=(OptIndex(bregs[int64(ins[0].a)].nuse) - OptIndex(1))
                    if (int64(ins[0].c) & 128) not=? 0 {bregs[int64(ins[0].b)].nuse=(OptIndex(bregs[int64(ins[0].b)].nuse) - OptIndex(1))}
                }
                else if mask =? 7 {
                    bregs[int64(ins[0].a)].nuse=(OptIndex(bregs[int64(ins[0].a)].nuse) - OptIndex(1))
                    bregs[int64(ins[0].b)].nuse=(OptIndex(bregs[int64(ins[0].b)].nuse) - OptIndex(1))
                    bregs[int64(ins[0].c)].nuse=(OptIndex(bregs[int64(ins[0].c)].nuse) - OptIndex(1))
                }
                bout[i].op='nop'
            }
        }
        i=(OptWord(i) - OptWord(int64(1)))
    }
    o_ctl=ctl
    opt_cleanup_ir(o_out o_count)
}

# Word operations preserve the frozen optimizer's overflow and truncation rules.
OptUnsigned:type=uint64<overflow='wrap'>
const OW_ONE:OptUnsigned=1
const OW_TWO:OptUnsigned=2
ow_unsigned_add_overflow=(a:uint64 b:uint64):>bool=>OptUnsigned(a) + OptUnsigned(b) <? a
ow_trunc_div=(a:int64 b:int64):>int64=>{
    let q:int64=a // b
    if (a <? 0) not=? (b <? 0) and a % b not=? 0 {q+=1}
    q
}
ow_word_overflow=(operation:int64 x:int64 y:int64):>bool=>{
    if operation =? 0 {
        let r:int64=OptWord(x) + OptWord(y)
        return ((x xor r) & (y xor r)) <? 0
    }
    if operation =? 1 {
        let r:int64=OptWord(x) - OptWord(y)
        return ((x xor y) & (x xor r)) <? 0
    }
    if operation =? 2 {
        let ax:OptUnsigned=if x <? 0 {OptUnsigned(uint64(-(x + 1))) + OW_ONE} else {OptUnsigned(x)}
        let ay:OptUnsigned=if y <? 0 {OptUnsigned(uint64(-(y + 1))) + OW_ONE} else {OptUnsigned(y)}
        let limit:uint64=if (x <? 0) not=? (y <? 0) {uint64(9223372036854775808)} else {uint64(9223372036854775807)}
        return ay not=? 0 and ax >? limit // ay
    }
    if operation =? 3 {return y =? 0 or (x =? OW_MIN_INT and y =? -1)}
    if y <? 0 {return true}
    if y >=? 64 {return x not=? 0}
    ((OptWord(x) << y) >> y) not=? x
}
ow_divu_magic=(d0:uint64):>[uint64 int64 bool]=>{
    let d:OptUnsigned=d0
    let two63:OptUnsigned=0x8000000000000000
    let max63:OptUnsigned=0x7FFFFFFFFFFFFFFF
    let zero:OptUnsigned=0
    let add=false
    let nc:OptUnsigned=(zero - OW_ONE) - (zero - d) % d
    let p:int64=63
    let q1:OptUnsigned=two63 // nc
    let r1:OptUnsigned=two63 - q1 * nc
    let q2:OptUnsigned=max63 // d
    let r2:OptUnsigned=max63 - q2 * d
    loop true {
        p+=1
        if r1 >=? nc - r1 {
            q1=q1 * OW_TWO + OW_ONE
            r1=r1 * OW_TWO - nc
        } else {
            q1=q1 * OW_TWO
            r1=r1 * OW_TWO
        }
        if r2 + OW_ONE >=? d - r2 {
            if q2 >=? max63 {add=true}
            q2=q2 * OW_TWO + OW_ONE
            r2=r2 * OW_TWO + OW_ONE - d
        } else {
            if q2 >=? two63 {add=true}
            q2=q2 * OW_TWO
            r2=r2 * OW_TWO + OW_ONE
        }
        let delta:OptUnsigned=d - OW_ONE - r2
        if not (p <? 128 and (q1 <? delta or (q1 =? delta and r1 =? 0))) {break}
    }
    [q2 + OW_ONE p - 64 add]
}
ow_div_magic=(d:int64):>[int64 int64]=>{
    let two63:OptUnsigned=0x8000000000000000
    let ad:OptUnsigned=OptUnsigned(d)
    let anc:OptUnsigned=two63 - OW_ONE - two63 % ad
    let p:int64=63
    let q1:OptUnsigned=two63 // anc
    let r1:OptUnsigned=two63 - q1 * anc
    let q2:OptUnsigned=two63 // ad
    let r2:OptUnsigned=two63 - q2 * ad
    loop true {
        p+=1
        q1=q1 * OW_TWO
        r1=r1 * OW_TWO
        if r1 >=? anc {
            q1=q1 + OW_ONE
            r1=r1 - anc
        }
        q2=q2 * OW_TWO
        r2=r2 * OW_TWO
        if r2 >=? ad {
            q2=q2 + OW_ONE
            r2=r2 - ad
        }
        let delta:OptUnsigned=ad - r2
        if not (q1 <? delta or (q1 =? delta and r1 =? 0)) {break}
    }
    [(q2 + OW_ONE) transmute int64 p - 64]
}

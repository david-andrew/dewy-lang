# The default progress axiom covers additive updates of 64-bit storage by a
# stored machine-word amount. It is not a proof of a multiply, an unbounded
# exact intermediate, or a narrower counter. The scoped opt-out requires the
# ordinary range proof instead. Candidate recognition runs only at exact stores;
# its increment walk is O(increment nodes × place depth), with no body-wide analysis.
fact_progress_strip = (n0: int) -> int:
    n = n0
    loop nodes[n].kind == .conv and (nodes[n].aux == i32(int(CV.none_)) or nodes[n].aux == i32(int(CV.int_))): n = int(nodes[n].a)
    n
fact_progress_same = (a0: int, b0: int, depth: int = 0) -> bool:
    if depth > 32: return false
    a = fact_progress_strip(a0); b = fact_progress_strip(b0)
    k = nodes[a].kind
    if k != nodes[b].kind: return false
    if k == .ident: return nodes[a].aux == nodes[b].aux and nodes[a].sym == nodes[b].sym and (nodes[a].aux == i32(int(SK.local)) or nodes[a].aux == i32(int(SK.global)))
    if k == .int_lit: return nodes[a].ival == nodes[b].ival
    if k == .field:
        return nodes[a].aux == nodes[b].aux and nodes[a].name == nodes[b].name and nodes[a].ival == nodes[b].ival and fact_progress_same(int(nodes[a].a), int(nodes[b].a), depth + 1)
    if k == .index and nodes[a].aux == 0 and nodes[b].aux == 0 and nodes[a].b != 0 and nodes[b].b != 0:
        return fact_progress_same(int(nodes[a].a), int(nodes[b].a), depth + 1) and fact_progress_same(int(nodes[a].b), int(nodes[b].b), depth + 1)
    false
# A recurrence such as x += x is geometric growth, not bounded progress.
# Inspect only the candidate increment, never an unrelated function body.
# Preparation already records writes. A query follows their indexed heads,
# including assignments later in the body, with a 64-node budget. Epoch marks
# break independent recurrence cycles without hiding a path to the counter.
# O(N+E) collection, O(64*C*P) queries for C candidates and place depth P,
# O(L+W) indexed storage; ordinary scalar counters have P=1.
fact_progress_root = (n0: int) -> int:
    n = n0
    loop depth in [0..32):
        n = fact_progress_strip(n)
        if nodes[n].kind == .field or nodes[n].kind == .index or nodes[n].kind == .unwrap or nodes[n].kind == .narrow:
            n = int(nodes[n].a)
        else if nodes[n].kind == .ident and nodes[n].aux == i32(int(SK.local)) and int(locals[int(nodes[n].sym)].flags) & LF_ALIAS != 0 and locals[int(nodes[n].sym)].alias != 0:
            n = int(locals[int(nodes[n].sym)].alias)
        else: return n
    0
# Distinct dynamic indices may designate the same element. Only different
# literal indices and different field routes prove these stores disjoint.
fact_progress_may_alias = (a0: int, b0: int, depth: int = 0) -> bool:
    if depth >= 32: return true
    a = fact_progress_strip(a0); b = fact_progress_strip(b0)
    if nodes[a].kind == .ident or nodes[b].kind == .ident: return fact_progress_same(fact_progress_root(a), fact_progress_root(b))
    if nodes[a].kind != nodes[b].kind: return false
    if nodes[a].kind == .field:
        return nodes[a].name == nodes[b].name and nodes[a].ival == nodes[b].ival and fact_progress_may_alias(int(nodes[a].a), int(nodes[b].a), depth + 1)
    if nodes[a].kind == .index:
        ai = int(nodes[a].b); bi = int(nodes[b].b)
        if ai == 0 or bi == 0: return true
        if nodes[ai].kind == .int_lit and nodes[bi].kind == .int_lit and nodes[ai].ival != nodes[bi].ival: return false
        return fact_progress_may_alias(int(nodes[a].a), int(nodes[b].a), depth + 1)
    true
# A bounded increment cannot secretly count iterations controlled by the
# accumulator. Control links share the same 64-edge dependency budget.
fact_progress_control_depends = (head0: int, target: int) -> bool:
    head = head0
    loop head > 0:
        exact_dependency_budget -= 1
        if exact_dependency_budget < 0 or fact_progress_depends(exact_control_values[head - 1], target): return true
        head = exact_control_parents[head - 1]
    false
fact_progress_place_depends = (n: int, target: int) -> bool:
    root = fact_progress_root(n)
    if nodes[root].kind == .array or nodes[root].kind == .tuple: return fact_progress_depends(root, target)
    if nodes[root].kind == .ident and nodes[root].aux == i32(int(SK.global)):
        g = int(nodes[root].sym)
        counter = fact_progress_root(target)
        # An immutable module value predates a private local accumulator.
        # It cannot contain that local's later progress, including in scripts.
        if nodes[counter].kind == .ident and nodes[counter].aux == i32(int(SK.local)) and not globals[g].fn_written and not globals[g].init_written and not globals[g].exposed: return false
        return true
    if nodes[root].kind != .ident or nodes[root].aux != i32(int(SK.local)): return true
    l = int(nodes[root].sym)
    if int(locals[l].flags) & (LF_ALIAS | LF_CAPTURE | LF_SHARED | LF_EXPOSED | LF_ELEMALIAS | LF_SOAELEM) != 0: return true
    if l < exact_progress_opaque.len() and exact_progress_opaque[l]: return true
    if l < exact_initializers.len() and exact_initializers[l] > 0:
        if fact_progress_depends(exact_initializers[l], target): return true
    edge = if l < exact_write_heads.len(): exact_write_heads[l] else: 0
    loop edge > 0:
        exact_dependency_budget -= 1
        if exact_dependency_budget < 0: return true
        at = edge - 1
        written = exact_write_targets[at]
        if exact_write_seen[at] != exact_dependency_epoch and fact_progress_may_alias(written, n):
            exact_write_seen[at] = exact_dependency_epoch
            if fact_progress_depends(exact_write_values[at], target) or fact_progress_control_depends(exact_write_controls[at], target): return true
        edge = exact_write_next[at]
    false
fact_progress_local_depends = (l: int, target: int) -> bool:
    exact_dependency_budget -= 1
    if exact_dependency_budget < 0: return true
    root = fact_progress_strip(target)
    if nodes[root].kind == .ident and nodes[root].aux == i32(int(SK.local)) and nodes[root].sym == i32(l): return true
    if l <= 0 or l >= locals.len(): return true
    t = exact_representation(int(locals[l].type))
    # Aggregate actuals can carry the counter into a called helper too.
    # Follow their indexed definitions/writes under the same query budget.
    if l < exact_progress_opaque.len() and exact_progress_opaque[l]: return true
    flags = int(locals[l].flags)
    if is_fn_type(t) and flags & LF_RESIZED != 0: return true
    if flags & LF_ALIAS != 0 and locals[l].alias != 0: return fact_progress_depends(int(locals[l].alias), target)
    # Read-only iteration aliases draw from the indexed source snapshot.
    if l < exact_iteration_sources.len() and exact_iteration_sources[l] != 0:
        source = exact_iteration_sources[l]
        if nodes[source].kind == .range: return fact_progress_depends(source, target)
        return fact_progress_place_depends(source, target)
    # An array parameter predates a private scalar accumulator. Its entry
    # contents cannot depend on that local; indexed writes still can. Unknown
    # mutation and insertion were rejected above, while pop only removes data.
    root = fact_progress_strip(target)
    if types[t].kind == .array and flags & LF_PARAM != 0 and nodes[root].kind == .ident and nodes[root].aux == i32(int(SK.local)):
        counter = int(nodes[root].sym)
        if int(locals[counter].flags) & (LF_MUTPARAM | LF_ALIAS | LF_BYREF | LF_ADDR | LF_CAPTURE | LF_SHARED | LF_EXPOSED) == 0:
            flags &= ~(LF_MUTPARAM | LF_BYREF | LF_ADDR)
    # Writes through aliases/captures are outside this local assignment index.
    if flags & (LF_MUTPARAM | LF_ALIAS | LF_BYREF | LF_ADDR | LF_SHARED | LF_EXPOSED) != 0: return true
    if l >= exact_dependency_seen.len(): exact_dependency_seen.resize(locals.len())
    if exact_dependency_seen[l] == exact_dependency_epoch: return false
    exact_dependency_seen[l] = exact_dependency_epoch
    if flags & LF_CAPTURE != 0:
        if fact_progress_local_depends(int(locals[l].outer), target): return true
    if l < exact_initializers.len() and exact_initializers[l] > 0:
        if fact_progress_depends(exact_initializers[l], target): return true
    edge = if l < exact_write_heads.len(): exact_write_heads[l] else: 0
    loop edge > 0:
        if fact_progress_depends(exact_write_values[edge - 1], target) or fact_progress_control_depends(exact_write_controls[edge - 1], target): return true
        edge = exact_write_next[edge - 1]
    false
fact_progress_depends = (n: int, target: int) -> bool:
    if n <= 0: return false
    exact_dependency_budget -= 1
    if exact_dependency_budget < 0: return true
    if fact_progress_same(n, target): return true
    # The enabled array bound already limits every length independently of
    # element contents. Field writes cannot make a loop's length unbounded.
    if nodes[n].kind == .intrinsic and nodes[n].aux == i32(int(IN.len)) and positive_bound(n, false) >= 0: return false
    if nodes[n].kind == .ident:
        if nodes[n].aux == i32(int(SK.local)): return fact_progress_local_depends(int(nodes[n].sym), target)
        if nodes[n].aux == i32(int(SK.global)): return true
    if nodes[n].kind == .field or nodes[n].kind == .index:
        if fact_progress_place_depends(n, target): return true
        # The route query already follows only writes that can reach this
        # field/element; inspecting its whole aggregate would lose that fact.
        if nodes[n].kind == .index: return fact_progress_depends(int(nodes[n].b), target)
        return false
    if nodes[n].kind == .lambda or nodes[n].kind == .call:
        root = fact_progress_root(target)
        # A call can read global storage without an explicit actual argument.
        if nodes[root].kind == .ident and nodes[root].aux == i32(int(SK.global)): return true
        f = int(nodes[n].sym)
        if nodes[n].kind == .lambda and has_flag(n, NF_GENERIC): return true
        if f > 0 and f < fns.len():
            loop capture in fns[f].caps:
                if nodes[root].kind == .ident and nodes[root].aux == i32(int(SK.local)) and nodes[root].sym == capture.outer: return true
                if fact_progress_local_depends(int(capture.outer), target): return true
    mask = isolation_children(nodes[n].kind)
    if mask <= 0: return false
    if mask & 1 != 0 and fact_progress_depends(int(nodes[n].a), target): return true
    if mask & 2 != 0 and fact_progress_depends(int(nodes[n].b), target): return true
    if mask & 4 != 0 and fact_progress_depends(int(nodes[n].c), target): return true
    if mask & 16 != 0:
        loop i in [0..nkids(n)):
            child = kid(n, i)
            if fact_progress_depends(child, target): return true
    false
# Across a temporary, a changed index must not turn a copy between elements
# into progress of one counter. Field/array routes must remain stable.
fact_progress_stable = (n0: int) -> bool:
    n = fact_progress_strip(n0)
    k = nodes[n].kind
    if k == .ident:
        return nodes[n].aux == i32(int(SK.local)) and int(locals[int(nodes[n].sym)].flags) & (LF_RESIZED | LF_ALIAS | LF_CAPTURE | LF_CAPTURED | LF_SHARED) == 0
    if k == .int_lit: return true
    if k == .field: return fact_progress_stable(int(nodes[n].a))
    if k == .index and nodes[n].aux == 0:
        index = fact_progress_strip(int(nodes[n].b))
        stable = nodes[index].kind == .int_lit or nodes[index].kind == .ident and nodes[index].aux == i32(int(SK.local)) and stable_loop_index(int(nodes[index].sym))
        return stable and fact_progress_stable(int(nodes[n].a))
    false
fact_progress_note = (assignment: int):
    target = int(nodes[assignment].a)
    store = int(nodes[assignment].b)
    if nodes[store].kind == .ident and nodes[store].aux == i32(int(SK.local)) and fact_progress_stable(target):
        l = int(nodes[store].sym)
        if l > 0 and l < exact_initializers.len() and int(locals[l].flags) & (LF_PARAM | LF_CAPTURE | LF_CAPTURED | LF_ALIAS | LF_BYREF | LF_ADDR | LF_SHARED | LF_EXPOSED) == 0:
            candidate = exact_initializers[l]
            if candidate > 0 and exact_has_store(candidate): store = candidate
    mathematical = nodes[store].kind == .conv and nodes[store].aux == i32(int(CV.int_)) and exact_representation(ntype(int(nodes[store].a))) == T_MATH_INT
    if not exact_has_store(store) and not mathematical: return
    t = exact_representation(ntype(target))
    if not is_int(t) or t == T_MATH_INT or types[t].bits != 64 or int_policy(t) != 0: return
    if dir_scopes.len() > 0 and dir_value(dir_name_assumed_bounds, nodes[store].pos) == 1: return
    source = int(nodes[store].a)
    operation = fact_progress_strip(source)
    # An inferred exact temporary is not a storage boundary. Recognize the
    # same immutable update source at its eventual fixed-width assignment.
    if mathematical and nodes[operation].kind == .ident and nodes[operation].aux == i32(int(SK.local)) and fact_progress_stable(target):
        l = int(nodes[operation].sym)
        if l > 0 and l < exact_initializers.len() and int(locals[l].flags) & (LF_ASSIGNED | LF_PARAM | LF_CAPTURE | LF_CAPTURED | LF_ALIAS | LF_BYREF | LF_ADDR | LF_SHARED | LF_EXPOSED) == 0:
            initial = exact_initializers[l]
            if initial > 0: operation = fact_progress_strip(initial)
    if nodes[operation].kind != .binary or nodes[operation].aux != 0: return
    op = nodes[operation].op as Tok
    if op != .plus and op != .minus: return
    increment = int(nodes[operation].b)
    if not fact_progress_same(target, int(nodes[operation].a)):
        if op != .plus or not fact_progress_same(target, increment): return
        increment = int(nodes[operation].a)
    exact_dependency_epoch += 1
    exact_dependency_budget = 64
    # A syntactically bounded increment stays bounded even if it refers to
    # the accumulator (for example count & 255). Reuse that existing proof.
    if fact_progress_depends(increment, target) and positive_bound(increment, false) < 0: return
    it = exact_representation(ntype(increment))
    if mathematical:
        # A masked or otherwise bounded mathematical increment need not box
        # the fixed accumulator merely to add it. The axiom supplies the fit.
        stored_word = not exact_has_node(increment) and is_int(it) and it != T_MATH_INT and types[it].bits <= 64
        if not types[t].sign or not stored_word and positive_bound(increment, false) < 0: return
        exact_progress_math[store] = true
        exact_reserve(store)
        exact_marks[store] |= 64
        return
    if exact_has_node(increment) or not is_int(it) or it == T_MATH_INT or types[it].bits > 64: return
    exact_decide(store, true)
    exact_marks[store] |= 32
    # The assumed boundary makes this cloned root a machine-word operation.
    # Its operands are stored values; no wider intermediate is discarded.
    if source == operation:
        exact_unmark(source)
        # The emitter may use a word, but facts still evaluate its exact
        # interval before intersecting the axiom's storage boundary.
        exact_marks[source] |= 32
    if exact_measure_on:
        site = exact_measure_sites[store]
        site.category = "progress-axiom"
        exact_measure_sites[store] = site

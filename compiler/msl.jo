use 'checker_state.dewy'
use 'checker_tokens.dewy'
# Shader translation: Sloppy functions -> Metal Shading Language (macOS: lib/game/metal.jo). The
# same functions become GLSL (glsl.jo, which checks them first: what it accepts, this accepts) and
# SPIR-V (spirv.jo); this follows the SPIR-V translation's data model, so the runtime is Vulkan's
# in Metal's words:
#   buffer(0)  SlPC: the parameters, vertices and instances as device addresses, the vertex and
#              instance strides, flip (0, or the height of the window when drawing to it), depth
#   buffer(1)  the textures: an array of (texture, sampler) entries; a Texture is its index
# There is no vertex descriptor: the vertex function's input is read from the vertex buffer at
# vertex_id (and the instance's at instance_id). The uniforms are read in place from the bytes of
# the CPU's struct, so a value of the uniforms' type is an address, not a copy. A GpuBuffer is
# its address and length; its elements are laid out as the CPU lays them out, read and written a
# word at a time.
#
# Clip space is OpenGL's (z from -1 to 1, made 0 to 1 here). Images keep OpenGL's row order (row 0
# is what y = -1 lands on): Metal puts y = 1 in row 0, so y is turned over when drawing to a
# texture, and not when drawing to the window, whose row 0 is its top; there the fragment's y is
# counted from the bottom, as OpenGL counts it.

use 'util.jo'
use 'lex.jo'
use 'ast.jo'
use 'types.jo'
use 'type_ops.dewy'
use 'check.jo'
use 'checks_assign_hooks.dewy'
use 'expr.jo'
use 'checks_thin_expr.dewy'
use 'glsl.jo'
use 'glsl_stmts.dewy'
use 'glsl_emit.dewy'
use 'glsl_ops.dewy'
use 'msl_ops.dewy'
use 'msl_emit.dewy'
use 'msl_stmts.dewy'

ml_out: str[]
ml_decls: str[]              # struct and function definitions, in dependency order
ml_done: {str: bool} = {}    # declarations already made (by name)
ml_done_fns: {int: bool} = {}
ml_pending: int[]
ml_stage = ""                # 
ml_utype = 0                 # the uniforms' type: its values are addresses
ml_lref: {int: str} = {}     # locals holding the uniforms (or a part): their address
ml_temps = 0

ml_float = (x: f64) -> str:
    if x != x: return "NAN"
    if x == __INF: return "INFINITY"
    if x == -__INF: return "(-INFINITY)"
    s = "{f32(x)}"
    if find(s, ".") < 0 and find(s, "e") < 0: s += ".0"
    s + "f"

# ---------------- memory (uniforms, vertices, GPU buffers) ----------------
# where a value is: the address of a buffer of words, plus a byte offset (c a constant, d an
# expression added to it, or 
struct MlRef:
    base: str
    c: int
    d: str
    t: int

ml_protos: str[]
ml_bodies: str[]

# the prelude's math functions, as Metal names them
ml_math_names: {str: str} = {
    "sin": "sin", "cos": "cos", "tan": "tan", "asin": "asin", "acos": "acos", "atan": "atan", "atan2": "atan2",
    "exp": "exp", "log": "log", "pow": "pow", "sqrt": "sqrt", "abs": "abs", "floor": "floor", "ceil": "ceil",
    "fract": "fract", "min": "min", "max": "max", "clamp": "clamp", "mix": "mix", "lerp": "mix",
    "step": "step", "smoothstep": "smoothstep", "norm": "length", "distance": "distance", "dot": "dot",
    "cross": "cross", "normalize": "normalize", "reflect": "reflect", "transpose": "transpose", "inverse": "sl_inverse",
    "sign": "sign", "sinf": "sin", "cosf": "cos", "exp2": "exp2", "log2": "log2", "fwidth": "fwidth", "mod": "sl_mod", "hypot": "sl_hypot",
}

ml_dumped = 0


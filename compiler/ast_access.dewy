$runtime_checks

from p"ast.jo" import (dewy_len_members dewy_param_kinds id_dewy_len lists nodes)
from p"node_store.dewy" import (NK Node node_clone node_d node_kids node_kids2 node_list2 node_mk node_mk_slow node_nlist2 node_set_list node_set_list2)

AstWord:type=int64<overflow='wrap'>

let ast_nodes_p:ptr<array<Node>>=$unsafe (uint64(0) as ptr<array<Node>>)
ast_access_bind=(ns:ptr<array<Node>>):>int64=>$unsafe {
    ast_nodes_p=ns
    0
}

ast_mk=(kind:NK pos:int64):>int64=>$unsafe {
    let np=ast_nodes_p
    if np not=? (uint64(0) as ptr<array<Node>>) {
        let sh=(np as ptr<ptr<int64>>)[0]
        if sh not=? (uint64(0) as ptr<int64>) {
            let idx=AstWord(sh[1])
            if sh[0] =? 1 and idx <? AstWord(sh[2]) {
                sh[1]=int64(idx + 1)
                let dst=((sh + 3) as ptr<Node>) + idx
                mem_set(dst as ptr<uint8> 0 size_of<Node>)
                dst[0].kind=kind
                dst[0].pos=pos
                return int64(idx)
            }
        }
    }
    node_mk_slow(@nodes kind pos)
}
ast_set_list=(n:int64 xs:array<int64>):>void=>node_set_list(@nodes @lists n xs)
ast_set_list2=(n:int64 xs:array<int64>):>void=>node_set_list2(@nodes @lists n xs)

ast_kid=(n:AstWord i:AstWord):>int64=>$unsafe lists.ptr[AstWord(nodes.ptr[n].list) + i]
ast_kid2=(n:AstWord i:AstWord):>int64=>$unsafe lists.ptr[AstWord(node_list2(nodes.ptr[n].op_ext)) + i]
ast_nkids=(n:AstWord):>int64=>$unsafe nodes.ptr[n].nlist
ast_nkids2=(n:AstWord):>int64=>$unsafe node_nlist2(nodes.ptr[n].op_ext)
ast_set_kid=(n:AstWord i:AstWord v:int64):>void=>$unsafe {
    lists[AstWord(nodes.ptr[n].list) + i]=int32<overflow='wrap'>(v)
}

# Checked loop nodes store local IDs in c and d. Partial nodes store a function ID in d.
ast_kid_c=(n:AstWord):>int64=>$unsafe {
    if nodes.ptr[n].kind =? 'for_' {0} else {int64(nodes.ptr[n].c)}
}
ast_kid_d=(n:AstWord):>int64=>$unsafe {
    let k=nodes.ptr[n].kind
    if k =? 'for_' or k =? 'partial' {0} else {int64(node_d(nodes.ptr[n].op_ext))}
}
ast_kids=(n:int64):>array<int64>=>node_kids(@nodes @lists n)
ast_kids2=(n:int64):>array<int64>=>node_kids2(@nodes @lists n)

ast_has_flag=(n:AstWord f:AstWord):>bool=>$unsafe (AstWord(nodes.ptr[n].flags) & f) not=? 0
ast_add_flag=(n:AstWord f:AstWord):>void=>$unsafe {
    nodes[n].flags=int32<overflow='wrap'>(AstWord(nodes.ptr[n].flags) | f)
}
ast_clear_flag=(n:AstWord f:AstWord):>void=>$unsafe {
    nodes[n].flags=int32<overflow='wrap'>(AstWord(nodes.ptr[n].flags) & ~f)
}
ast_clone=(n:int64):>int64=>node_clone(@nodes @lists n)

ast_note_member=(n:AstWord):>void=>$unsafe {
    if AstWord(nodes.ptr[n].name) =? id_dewy_len {dewy_len_members[n]=nodes.ptr[n].pos}
}

ast_decl_has_rest=(d:int64):>bool=>(dewy_param_kinds.get(d) ?? []).contains(3)

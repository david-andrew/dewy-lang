use 'ast.jo'
use 'check.jo'
use 'checks_thin_expr.dewy'
use 'expr.jo'
use 'refine_metadata.dewy'
use 'types.jo'
use 'util.jo'

bare_generic_set = (on: bool) -> bool:
    was = bare_generic_ok
    bare_generic_ok = on
    was

is_dewy_set_type = (t: int) -> bool:
    p = prune(t)
    if types[p].kind != .struct_: return false
    st = int(types[p].st)
    if structs[st].name != "Set": return false
    d = int(structs[st].decl)
    d != 0 and files[pos_file(nodes[d].pos)].path == lib_dir + "/std/dewy_sets.jo"

# the string-literal union a container's members or keys are (0 if not one)
membership_str_set_of = (t0: int) -> int:
    t = prune(t0)
    k = types[t].kind
    if k == .array or k == .fixed: return if str_set_of(int(types[t].elem)) != 0: prune(int(types[t].elem)) else: 0
    if is_map_type(t) or is_dewy_set_type(t):
        key = struct_targ(int(types[t].st), 0)
        return if str_set_of(key) != 0: prune(key) else: 0
    0

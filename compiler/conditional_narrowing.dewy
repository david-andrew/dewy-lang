$runtime_checks
from p"checker_block_entries.dewy" import (check_block)
from p"check.jo" import (narrow_jumps)
from p"expr.jo" import (narrow_by)

# `if` and `if let` run in checker_conditionals.dewy; these are its services.
cond_block=(b:int64 expected:int64 value:bool @jumps:int64):>int64=>{
    jumps=narrow_jumps.length
    check_block(b expected value)
}

cond_narrow=(cond:int64 holds:bool):>void=>{narrow_by(cond holds)}

$runtime_checks

from p"expr.jo" import (IN ntype)
from p"check.jo" import (FK_NORMAL LF_CAPTURE fns lib_dir locals)
from p"ast.jo" import (NF_MUT has_flag kid kid2 kids nkids nkids2 nodes)
from p"lower_analysis.dewy" import (checked_call_mutmask place_var)
from p"util.jo" import (files name_of pos_file)
from p"diagnostic_exit.dewy" import (fatal)
from p"lower.jo" import (race_done)
from p"types.jo" import (tkind)
from p"lower_helpers.dewy" import (value_helper_calls)
from p"concurrency_parsafe.dewy" import (parsafe_demand_task parsafe_is_param parsafe_vouched)
# Direct recursive lowering; shared state has one owner in lower.jo.
LRWord:type=int64<overflow='wrap'>
race_check=(callee:LRWord args:array<int64> pos:LRWord):>void=>$unsafe {
    # (the library's own calls take care of threads themselves)
    if in_lib(pos) {return}
    let who=name_of(LRWord(nodes.ptr[LRWord(fns.ptr[callee].decl)].name))
    if who.startswith("__dewy_parallel") {who="`parallel`"}
    loop a in args {
        if tkind(ntype(a)) =? 'fn_' and not parsafe_vouched(a) {race_arg(a who);}
    }
}
race_arg=(a:LRWord who:string):>void=>$unsafe {
    let k=nodes.ptr[a].kind
    if k =? 'conv' {race_arg(LRWord(nodes.ptr[a].a) who);}
    else if k =? 'lambda' {race_scan(LRWord(fns.ptr[LRWord(nodes.ptr[a].sym)].body) LRWord(nodes.ptr[a].sym) who true);}
    else if k =? 'fnref' {
        let f:LRWord=LRWord(nodes.ptr[a].sym)
        race_root_callbacks(f who nodes.ptr[a].pos);
        if nodes.ptr[a].aux =? 2 {race_scan(LRWord(fns.ptr[f].body) f who true);}
        else {race_named(f who);}
    }
    else if k =? 'partial' {
        if nodes.ptr[a].aux =? 1 {race_arg(LRWord(nodes.ptr[a].a) who);}
        else {
            race_root_callbacks(LRWord(nodes.ptr[a].sym) who nodes.ptr[a].pos);
            race_named(LRWord(nodes.ptr[a].sym) who);
            # (a function bound here is what the callee's parameter calls)
            loop bound in kids(a) {
                if nodes.ptr[bound].kind not=? 'hole' and tkind(ntype(bound)) =? 'fn_' {race_arg(bound who);}
            }
        }
    }
    else {fatal(nodes.ptr[a].pos "{who} runs this function on many threads at once, so the compiler checks it for data races, which it can only do for a function it can see: pass a function by name or a lambda");}
}
# A function a parallel call runs gets its arguments from the array: a function among them is
# one no call shows. (A task's demand reaches each caller instead: parsafe_demand_task.)
race_root_callbacks=(f:LRWord who:string pos:LRWord):>void=>$unsafe {
    if who.startswith("spawn") {return}
    loop t in fns.ptr[f].ptypes {
        if tkind(t) =? 'fn_' {fatal(pos "{who} runs this function on many threads at once, so the compiler checks it for data races, which it can only do for a function it can see: pass a function by name or a lambda");}
    }
}
# A function value a call in checked code gives: visible where it is written, or a parameter of
# the checked function, whose own callers were checked the same way. O(conversions).
race_given=(a0:LRWord who:string):>void=>$unsafe {
    let a=a0
    loop nodes.ptr[a].kind =? 'conv' {a=LRWord(nodes.ptr[a].a)}
    let k=nodes.ptr[a].kind
    if k =? 'lambda' or k =? 'fnref' or k =? 'partial' or k =? 'hole' or race_direct_param(a) or parsafe_vouched(a) or who.startswith("spawn") and parsafe_demand_task(a a) {return}
    fatal(nodes.ptr[a].pos "{who} runs this code on many threads at once, so the compiler checks it for data races, which it can only do for a function it can see: pass a function by name or a lambda");
}
# A parameter of the named function being checked, itself: reached only through a call whose
# argument race_given checked (race_root_callbacks turns away the other way in).
race_direct_param=(a0:LRWord):>bool=>$unsafe {
    let a=a0
    loop nodes.ptr[a].kind =? 'conv' {a=LRWord(nodes.ptr[a].a)}
    if nodes.ptr[a].kind not=? 'ident' or nodes.ptr[a].aux not=? int32<overflow='wrap'>(1) {return false}
    let l:LRWord=LRWord(nodes.ptr[a].sym)
    if LRWord(locals.ptr[l].flags) & LF_CAPTURE not=? 0 {return false}
    return parsafe_is_param(a) and fns.ptr[LRWord(locals.ptr[l].owner)].kind =? FK_NORMAL
}
parallel_direct=(f:LRWord pos:LRWord):>void=>$unsafe {
    if f >? 0 and fns.ptr[f].parallel_api and not in_lib(pos) {
        fatal(pos "'{name_of(LRWord(nodes.ptr[LRWord(fns.ptr[f].decl)].name))}' runs the function it is given on many threads at once, so it can only be called directly (where the compiler checks that function), not used as a value or partially applied");
    }
}
type_as_value=(e:LRWord):>void=>$unsafe {
    let what="a type"
    if tkind(ntype(e)) =? 'module' {what="a module"}
    fatal(nodes.ptr[e].pos "this is {what}, not a value (a value of a type is made by calling it: `T()`)");
}
in_lib=(pos:LRWord):>bool=>$unsafe {
    let fi=pos_file(pos)
    return fi >=? 0 and fi <? files.length and starts_with(files.ptr[fi].path "{lib_dir}/")
}
race_named=(f:LRWord who:string):>void=>$unsafe {
    if race_done.has(f) or fns.ptr[f].body =? 0 {return}
    race_done[f] = true;
    # (the core and standard libraries take care of threads themselves)
    if fns.ptr[f].decl not=? 0 {
        let fi=pos_file(LRWord(nodes.ptr[LRWord(fns.ptr[f].decl)].pos))
        if fi >=? 0 and fi <? files.length and starts_with(files.ptr[fi].path "{lib_dir}/") and ((find(files.ptr[fi].path "/core/") ?? -1) >=? 0 or (find(files.ptr[fi].path "/std/") ?? -1) >=? 0) {return}
    }
    race_scan(LRWord(fns.ptr[f].body) f who false);
}
race_target=(t:LRWord f:LRWord who:string captures:bool pos:LRWord):>void=>$unsafe {
    # (writing through a pointer changes memory the program manages itself, not the variable)
    let n=place_var(t)
    if n =? 0 {return}
    let nm=name_of(LRWord(nodes.ptr[n].name))
    if nodes.ptr[n].aux =? int32<overflow='wrap'>(2) {
        fatal(pos "{who} runs this function on many threads at once, so it must not change the global '{nm}' (a data race): return values instead");
    }
    if captures and nodes.ptr[n].aux =? int32<overflow='wrap'>(1) {
        let l:LRWord=LRWord(nodes.ptr[n].sym)
        if LRWord(locals.ptr[l].owner) not=? f or LRWord(locals.ptr[l].flags) & LF_CAPTURE not=? 0 {
            fatal(pos "{who} runs this function on many threads at once, so it must not change '{nm}', a variable it captured (a data race): return values instead");
        }
    }
}
race_scan=(n:LRWord f:LRWord who:string captures:bool):>void=>$unsafe {
    if n =? 0 {return}
    loop called in value_helper_calls(n) {race_named(called who);}
    let k=nodes.ptr[n].kind
    # (a closure or function value made here may run here, through a library's callback call,
    # which the scan does not follow; its own captures are checked where the task takes them)
    if k =? 'lambda' {
        let inner:LRWord=LRWord(nodes.ptr[n].sym)
        if inner >? 0 {race_scan(LRWord(fns.ptr[inner].body) inner who false);}
        return
    }
    if (k =? 'fnref' or k =? 'partial' and nodes.ptr[n].aux not=? 1) and nodes.ptr[n].sym >? 0 {race_named(LRWord(nodes.ptr[n].sym) who);}
    if k =? 'assign' {race_target(LRWord(nodes.ptr[n].a) f who captures nodes.ptr[n].pos);}
    else if k =? 'intrinsic' and nkids(n) >? 0 {
        let id:LRWord=LRWord(nodes.ptr[n].aux)
        if id =? int64(IN.push) or id =? int64(IN.pop) or id =? int64(IN.insert) or id =? int64(IN.remove) or id =? int64(IN.clear) or id =? int64(IN.reserve) or id =? int64(IN.resize) or id =? int64(IN.truncate) or id =? int64(IN.extend) {
            race_target(kid(n 0) f who captures nodes.ptr[n].pos);
        }
    }
    else if k =? 'call' {
        let mm=checked_call_mutmask(n)
        loop i in [0..nkids(n)) {
            if mm & (1 << i) not=? 0 {race_target(kid(n i) f who captures nodes.ptr[kid(n i)].pos);}
        }
        let aux:LRWord=LRWord(nodes.ptr[n].aux)
        if aux =? 0 and nodes.ptr[n].sym >? 0 {
            race_named(LRWord(nodes.ptr[n].sym) who);
            if not in_lib(nodes.ptr[n].pos) {
                loop a in kids(n) {
                    if tkind(ntype(a)) =? 'fn_' {race_given(a who);}
                }
            }
        }
        # (calling a function value: which one, the compiler cannot tell; the library's are its own,
        # and a callback parameter's are its function's callers' to check, which a task's call demands)
        else if aux =? 1 and not in_lib(nodes.ptr[n].pos) and not parsafe_vouched(LRWord(nodes.ptr[n].a)) and not race_direct_param(LRWord(nodes.ptr[n].a)) and not (who.startswith("spawn") and parsafe_demand_task(LRWord(nodes.ptr[n].a) n)) {
            fatal(nodes.ptr[n].pos "{who} runs this code on many threads at once, so the compiler checks it for data races, which it cannot do through a call of a function value it cannot trace to its caller: call a function by name, or take the function as a parameter, so each call's argument is checked");
        }
    }
    else if k =? 'for_' and has_flag(n NF_MUT) {race_target(LRWord(nodes.ptr[n].a) f who captures nodes.ptr[n].pos);}
    # (a part of "...{x}...": formatted by a __fmt function, which may be the program's)
    else if k =? 'pair' and nodes.ptr[n].sym >? 0 {race_named(LRWord(nodes.ptr[n].sym) who);}
    race_scan(LRWord(nodes.ptr[n].a) f who captures);
    race_scan(LRWord(nodes.ptr[n].b) f who captures);
    if k not=? 'for_' {
        race_scan(LRWord(nodes.ptr[n].c) f who captures);
        if k not=? 'partial' {race_scan(LRWord(nodes.ptr[n].d) f who captures);}
    }
    loop i in [0..nkids(n)) {race_scan(kid(n i) f who captures);}
    loop i in [0..nkids2(n)) {race_scan(kid2(n i) f who captures);}
}

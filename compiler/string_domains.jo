use 'checker_state.dewy'
use 'checker_expr.dewy'
use 'checker_tokens.dewy'
use 'refinement_types.dewy'
# Inferred strings keep string storage. Only finite-domain consumers ask for
# the joined literal writes; annotations never enter this table. Empty means
# open, and stays open. Interned text ids avoid singleton type interning.
use 'check.jo'
use 'ast.jo'
use 'lex.jo'
use 'util.jo'
use 'types.jo'
use 'refine.jo'
use 'expr.jo'
use 'facts.jo'
use 'node_store.dewy'
use 'literal_domains.dewy'
use 'text_domains.dewy'
use 'int_domains.dewy'
use 'intervals.dewy'

string_domains: {int: int[]} = {}
string_domain_matches: (int, int)[]
string_domain_sequences: (int, int)[]
string_domain_sequence_fns: int[]
string_domain_conversions: (int, int, int)[]
# (a conversion's failing arm, its panic call: a settled domain inside the set never reaches it)
string_domain_conversion_stops: {int: int} = {}
string_domain_captures: {int: int} = {}













# Unannotated integer bindings: the covering set of every written value, as
# literal points plus the deltas of compound writes that run at most once per
# binding lifetime (same function, no loop between declaration and write).
# Checking appends O(1) records to a flat log; only consumers (exhaustive
# matches, refinement conversions) settle it, in one O(log) pass, with each
# demanded set capped at INT_DOMAIN_CAP values (O(points * 2^deltas) bounded).
int_log: int[]

int_domain_matches: (int, int, int[])[]
int_domain_conversions: (int, int, int)[]
int_domain_proven: {int: bool} = {}





# The complete log solver lives in Dewy; syntax/type consumers stay here.
int_domain_states: {int: IntDomain} = {}

# (facts.jo reads a binding's initializer through this)
domain_leaf = (n0: int) -> int: ld_leaf(nodes, lists, n0)
domain_literals = (n0: int, text: bool, out: mut int[], depth: int = 0) -> bool:
    ld_literals(nodes, lists, n0, text, i32(int(Tok.minus)), out, depth)

TextWord:type=int64<overflow='wrap'>
# The bundled delimiter split always appends its final part when the
# separator is nonempty. Empty separators and whitespace splitting differ.
# Binding identity is checked, never an arbitrary user function's spelling.
fact_split_call=(n:TextWord):>bool=>$unsafe {
    if (nkids(n) not=? 2 and nkids(n) not=? 3) or not fact_library_call(n "split") {return false}
    let d=TextWord(fns.ptr[TextWord(nodes.ptr[n].sym)].decl)
    files[pos_file(nodes.ptr[d].pos)].path =? "{lib_dir}/core/str.jo" and fact_type(ntype(kid(n 1))) =? T_STR
}
# Whitespace splitting emits only nonempty strings; delimiter splitting can
# emit empty fields. This belongs to the bundled implementation, not its name.
fact_words_call=(n:TextWord):>bool=>$unsafe {
    if nkids(n) not=? 1 or not (fact_library_call(n "split") or fact_library_call(n "words")) {return false}
    let d=TextWord(fns.ptr[TextWord(nodes.ptr[n].sym)].decl)
    files[pos_file(nodes.ptr[d].pos)].path =? "{lib_dir}/core/str.jo"
}
# core/str.jo lines drops only its last empty part: nonempty input always
# leaves at least one line (including a lone newline). Empty input leaves none.
fact_lines_call=(n:TextWord):>bool=>$unsafe {
    if nkids(n) not=? 1 or not fact_library_call(n "lines") {return false}
    let d=TextWord(fns.ptr[TextWord(nodes.ptr[n].sym)].decl)
    files[pos_file(nodes.ptr[d].pos)].path =? "{lib_dir}/core/str.jo"
}
fact_search_call=(n:TextWord):>bool=>{
    fact_array_search_call(n) or fact_text_search_call(n)
}
fact_array_search_call=(n:TextWord):>bool=>$unsafe {
    if nkids(n) not=? 2 or not fact_library_call(n "__dewy_index_of") {return false}
    let d=TextWord(fns.ptr[TextWord(nodes.ptr[n].sym)].decl)
    files[pos_file(nodes.ptr[d].pos)].path =? "{lib_dir}/std/dewy.jo"
}
# The bundled array search reads its arguments and writes nothing when its
# elements compare by the builtin equality or the library's own (a program's
# `__eq__` may do anything), and copy without lifecycle hooks. O(1).
fact_search_reads_only=(n:TextWord):>bool=>$unsafe {
    if not fact_array_search_call(n) {return false}
    let t=representation_type(telem(fact_type(ntype(kid(n 0)))))
    if effect_scalar(t) or effect_float(t) or t =? T_STR {return true}
    if tkind(t) not=? 'struct_' or TextWord(types.ptr[t].flags) & TF_MANAGED not=? 0 {return false}
    let d=TextWord(structs.ptr[TextWord(types.ptr[t].st)].decl)
    d not=? 0 and pos_in_lib(nodes.ptr[d].pos)
}
fact_text_search_call=(n:TextWord):>bool=>$unsafe {
    if nkids(n) not=? 2 and nkids(n) not=? 3 or nodes.ptr[n].kind not=? 'call' or nodes.ptr[n].aux not=? 0 or nodes.ptr[n].sym <=? 0 {return false}
    let d=TextWord(fns.ptr[TextWord(nodes.ptr[n].sym)].decl)
    if d =? 0 {return false}
    if fact_name_find =? 0 {
        fact_name_find=intern("__dewy_find")
        fact_name_rfind=intern("__dewy_rfind")
    }
    let name=TextWord(nodes.ptr[d].name)
    (name =? fact_name_find or name =? fact_name_rfind) and files[pos_file(nodes.ptr[d].pos)].path =? "{lib_dir}/std/graphemes.jo" and fact_type(ntype(kid(n 0))) =? T_STR and fact_type(ntype(kid(n 1))) =? T_STR
}
fact_search_result=(n:TextWord result:TextWord values:array<int64> @s:FactState):>void=>$unsafe {
    if s.conditional.length >=? 32 {return}
    if fact_search_predicate =? 0 {
        fact_search_predicate=ref_intern([RefAtom('ge' RefTerm() RefTerm(1 0)) RefAtom('lt' RefTerm() RefTerm(2 0 path=[-1]))])
        fact_text_search_predicate=ref_intern([RefAtom('ge' RefTerm() RefTerm(1 0)) RefAtom('le' RefTerm() RefTerm(2 0 path=[-1]))])
        # (`text.find(sub start)` counts from its start: start + a count)
        fact_text_from_predicate=ref_intern([RefAtom('ge' RefTerm() RefTerm(2 2)) RefAtom('le' RefTerm() RefTerm(2 0 path=[-1]))])
    }
    # A length exists on both success and fallback paths. Materialize this
    # demanded entry projection before the tag split, so joins can check the
    # fallback against it too (e.g. -1 is below every array length). O(1).
    fact_project(@s values[0] (-1) false T_INT);
    let f=TextWord(nodes.ptr[n].sym)
    let tag=union_index(prune(TextWord(fns.ptr[f].ret)) T_INT)
    if tag <? 0 {return}
    let selector=result_selector(f result @s)
    let payload=fact_project(@s result (-4) false T_INT)
    let predicate=if not fact_text_search_call(n) {fact_search_predicate} else if nkids(n) =? 3 and TextWord(nodes.ptr[TextWord(fns.ptr[f].decl)].name) =? fact_name_find {fact_text_from_predicate} else {fact_text_search_predicate}
    s.conditional.push(ResultEvidence(selector tag predicate values fns.ptr[f].ptypes payload T_INT))
}
fact_regex_call=(n:TextWord):>bool=>$unsafe {
    if nkids(n) not=? 1 and nkids(n) not=? 3 or nodes.ptr[n].kind not=? 'call' or nodes.ptr[n].aux not=? 0 or nodes.ptr[n].sym <=? 0 {return false}
    let d=TextWord(fns.ptr[TextWord(nodes.ptr[n].sym)].decl)
    if d =? 0 {return false}
    if fact_name_regex =? 0 {
        fact_name_regex=intern("regex")
        fact_name_regex_find=intern("__dewy_find")
    }
    let name=TextWord(nodes.ptr[d].name)
    (name =? fact_name_regex and nkids(n) =? 1 or name =? fact_name_regex_find and nkids(n) =? 3) and files[pos_file(nodes.ptr[d].pos)].path =? "{lib_dir}/std/regex.jo"
}
fact_regex_search_result=(n:TextWord result:TextWord values:array<int64> @s:FactState):>void=>$unsafe {
    if not fact_regex_call(n) {return}
    if ownership_decls.length not=? 0 {
        # Union containers do not themselves report member lifecycle hooks.
        loop t in union_members(fact_type(ntype(n))) {
            if ownership_fact_type(t) {return}
        }
        if nkids(n) =? 3 and ownership_fact_type(ntype(kid(n 1))) {return}
    }
    let named=name_of(TextWord(nodes.ptr[TextWord(fns.ptr[TextWord(nodes.ptr[n].sym)].decl)].name))
    if named =? "regex" and nkids(n) =? 1 {
        let text=cc_constant(kid(n 0))
        if text <? 0 {return}
        let count=fact_regex_counts.get(text) ?? -1
        if count <? 0 {
            # Interpret the library implementation, never a second regex parser.
            # Only a checked constant string enters the evaluator.
            let arg=mk('str_lit' nodes.ptr[n].pos)
            nodes.ptr[arg].sval=int32(text)
            nodes.ptr[arg].type=int32(T_STR)
            add_flag(arg NF_CHECKED)
            let d=TextWord(fns.ptr[TextWord(nodes.ptr[n].sym)].decl)
            let helper=module_lookup(TextWord(nodes.ptr[d].mod) intern("__re_parse"))
            if helper =? 0 or syms.ptr[helper].kind not=? 'fns' {return}
            let f=get_fn_inst(TextWord(syms.ptr[helper].decl) [] nodes.ptr[n].pos)
            let run=mk('call' nodes.ptr[n].pos)
            nodes.ptr[run].sym=int32(f)
            nodes.ptr[run].type=fns.ptr[f].ret
            add_flag(run NF_CHECKED)
            set_list(run [arg])
            let value=ct_values[ct_run(run)]
            if value.items.length not=? 2 {return}
            let payload=ct_values[value.items[0]]
            if tkind(payload.type) not=? 'struct_' {return}
            let si=TextWord(types.ptr[payload.type].st)
            loop i in [0..TextWord(structs.ptr[si].nfields)) {
                if name_of(TextWord(fields.ptr[TextWord(structs.ptr[si].fields) + i].name)) =? "groups" {count=ct_values[payload.items[i]].i}
            }
            if count <? 0 {return}
            fact_regex_counts[text]=count
        }
        loop t in union_members(fact_type(ntype(n))) {
            if fact_call_field_type(t intern("groups")) not=? T_INT {continue}
            let payload=fact_project(@s result (-4) false t)
            if s.projections.length <? FACT_CAP {fact_add_projection(@s FactProjection(payload intern("groups") false fact_constant(@s count)))}
        }
        return
    }
    if nkids(n) not=? 3 or named not=? "__dewy_find" {return}
    let name=intern("groups")
    loop t in union_members(fact_type(ntype(n))) {
        let gt=fact_call_field_type(t name)
        if tkind(gt) not=? 'array' or telem(gt) not=? T_STR {continue}
        let count=fact_project(@s values[1] name false T_INT)
        let length=fact_clamped(@s count n)
        let payload=fact_project(@s result (-4) false t)
        let groups=fact_project(@s payload name false gt)
        if s.projections.length <? FACT_CAP {fact_add_projection(@s FactProjection(groups (-1) false length))}
        return
    }
}
fact_affix_call=(n:TextWord):>bool=>$unsafe {
    if nodes.ptr[n].kind not=? 'call' or nodes.ptr[n].aux not=? 0 or nodes.ptr[n].sym <=? 0 or nkids(n) not=? 2 {return false}
    let d=TextWord(fns.ptr[TextWord(nodes.ptr[n].sym)].decl)
    if d =? 0 {return false}
    if fact_name_starts_with =? 0 {
        fact_name_starts_with=intern("starts_with")
        fact_name_ends_with=intern("ends_with")
    }
    let name=TextWord(nodes.ptr[d].name)
    if name not=? fact_name_starts_with and name not=? fact_name_ends_with {return false}
    pos_in_lib(nodes.ptr[d].pos) and fact_type(ntype(kid(n 0))) =? T_STR and fact_type(ntype(kid(n 1))) =? T_STR
}
# Graphemes a text matching a nonempty affix pattern has at least. An ASCII
# literal without CR breaks between every pair of its bytes whatever surrounds
# it, so each of its bytes starts a grapheme of the text; any other pattern
# guarantees one.
fact_affix_floor=(p:TextWord):>TextWord=>$unsafe {
    if p <=? 0 or nodes.ptr[p].kind not=? 'str_lit' or nodes.ptr[p].aux not=? 0 or nkids(p) not=? 0 or nodes.ptr[p].sval <? 0 {return 1}
    let text=name_of(TextWord(nodes.ptr[p].sval))
    let bytes=text as array<uint8>
    if bytes.length =? 0 {return 1}
    loop c in bytes {
        if c >=? 128 or c =? 13 {return 1}
    }
    bytes.length
}
fact_string_call=(n:TextWord):>TextWord=>$unsafe {
    if nodes.ptr[n].kind not=? 'call' or nodes.ptr[n].aux not=? 0 or nodes.ptr[n].sym <=? 0 {return 0}
    let d=TextWord(fns.ptr[TextWord(nodes.ptr[n].sym)].decl)
    if d =? 0 {return 0}
    if fact_name_string_length =? 0 {
        fact_name_string_length=intern("__dewy_string_length")
        fact_name_string_index=intern("__dewy_string_index")
        fact_name_string_slice=intern("__dewy_string_slice")
        fact_name_byte_slice=intern("__dewy_byte_slice")
    }
    let name=TextWord(nodes.ptr[d].name)
    let k=if name =? fact_name_string_length and nkids(n) =? 1 {1} else if name =? fact_name_string_index and nkids(n) =? 2 {2} else if name =? fact_name_string_slice and nkids(n) =? 5 {3} else if name =? fact_name_byte_slice and nkids(n) =? 3 {4} else {0}
    # (`text.find(part start)`: 5, its start an obligation as a slice's is)
    if k =? 0 and nkids(n) =? 3 and fact_text_search_call(n) and name =? fact_name_find {return 5}
    if k =? 0 or not pos_in_lib(nodes.ptr[d].pos) {return 0}
    k
}
# `text.find(part start)` searches from grapheme `start`: 0 <=? start <=?
# text.length, as a slice `text[start..]` needs (the library's start check). O(1).
fact_find_start=(n:TextWord @s:FactState start:TextWord length:TextWord):>void=>$unsafe {
    if fact_speculating not=? 0 or not (fact_policy =? 'RequireStatic' or fact_query) {return}
    let zero=fact_constant(@s 0)
    let lo=fact_compare(s 'le' zero start)
    let hi=fact_compare(s 'le' start length)
    if fact_probe_on {
        fact_probe_record(n lo =? 1 and hi =? 1)
        return
    }
    if lo =? 1 and hi =? 1 {return}
    let i=wit_text(kid(n 2))
    let text=wit_text(kid(n 0))
    let upper=if text not=? "" {"{i} <=? {text}.length"} else {""}
    let relation=if lo =? 1 {upper} else if hi =? 1 {"{i} >=? 0"} else if upper not=? "" {"0 <=? {upper}"} else {""}
    if lo =? 0 or hi =? 0 {
        wit_help(relation)
        if dir_defer(n "find's start is outside the text" true) {return}
        wit_fail(nodes.ptr[n].pos "find's start is outside the text")
        return
    }
    let missing=if lo =? 1 {"upper bound"} else if hi =? 1 {"lower bound"} else {"lower and upper bounds"}
    wit_unknown(n fact_bound(s start) "find's start `{i}` is within the text" 0 relation missing)
}
fact_byte_view=(@s:FactState text:TextWord):>TextWord=>$unsafe {
    let view=fact_project(@s text FACT_BYTE_VIEW false mk_array(T_U8))
    # A decoded literal has an exact byte count even when it is not ASCII
    # (or contains CR). Materialize only on byte-view demand: O(1) indexed
    # lookup and interned-string length, with no Unicode/grapheme scan.
    let n=fact_terms[text].origin
    if view not=? 0 and n >? 0 and nodes.ptr[n].kind =? 'str_lit' and nodes.ptr[n].aux =? 0 and nkids(n) =? 0 and nodes.ptr[n].sval >=? 0 and s.projections.length <? FACT_CAP {
        let known=fact_projection_find(s view (-1) false)
        if known <? 0 {fact_add_projection(@s FactProjection(view (-1) false fact_constant(@s (name_of(TextWord(nodes.ptr[n].sval)) as array<uint8>).length)))}
    }
    view
}
# `text.byte_slice(a b)`: 0 <=? a <=? b <=? the text's byte length, and each end a char
# boundary: 0, the byte length, or an index whose byte the facts hold below 0x80 or at
# least 0xC0 (a guard `bytes[a] <? 0x80` on the text's byte view). The result's byte
# length is b - a. O(1) queries.
fact_byte_slice=(n:TextWord @s:FactState values:array<int64>):>TextWord=>{
    let view=fact_byte_view(@s values[0])
    let length=fact_project(@s view (-1) false T_INT)
    let lo=values[1]
    let hi=values[2]
    if fact_speculating =? 0 and (fact_policy =? 'RequireStatic' or fact_query) {
        let zero=fact_constant(@s 0)
        let checks=[fact_compare(s 'le' zero lo) fact_compare(s 'le' lo hi) fact_compare(s 'le' hi length)]
        let bounded=checks[0] =? 1 and checks[1] =? 1 and checks[2] =? 1
        let starts=fact_char_boundary(@s view length lo) and fact_char_boundary(@s view length hi)
        if fact_probe_on {fact_probe_record(n bounded and starts)}
        else if not bounded {wit_slice_at(n @s lo hi length checks kid(n 0) kid(n 1) kid(n 2) false)}
        else if not starts {
            let first=fact_char_boundary(@s view length lo)
            let which=if first {kid(n 2)} else {kid(n 1)}
            let byte=fact_project(@s view (if first {hi} else {lo}) true T_U8)
            let end_=if first {"stop"} else {"start"}
            wit_unknown(n fact_bound(s byte) "byte_slice's {end_} `{wit_text(which)}` is a char boundary" 0 "({wit_text(kid(n 0))} as array<uint8>)[{wit_text(which)}] <? 0x80")
        }
    }
    let value=fact_new(@s FactBound() FactTerm(type=ntype(n)))
    let size=fact_arithmetic(@s kid(n 2) 'minus' hi lo)
    if s.projections.length + 1 <? FACT_CAP {
        let bytes=fact_byte_view(@s value)
        fact_add_projection(@s FactProjection(bytes (-1) false size))
    }
    value
}
fact_char_boundary=(@s:FactState view:TextWord length:TextWord at:TextWord):>bool=>{
    # (within the bounds, which are proven first: at most 0 is 0, at least the length is it)
    # (the constant first: the state is taken before later arguments run)
    let zero=fact_constant(@s 0)
    if fact_compare(s 'le' at zero) =? 1 or fact_compare(s 'ge' at length) =? 1 {return true}
    # ASCII belongs to the immutable string, never a mutable byte array.
    let pi=fact_projection_origin(s view)
    if pi >=? 0 {
        let p=s.projections[pi]
        if p.selector =? FACT_BYTE_VIEW and fact_projection_find(s p.base FACT_ASCII_TEXT false) >=? 0 {return true}
    }
    let byte=fact_project(@s view at true T_U8)
    let b=fact_bound(s byte)
    if b.hi <? 0x80 or b.lo >=? 0xc0 {return true}
    false
}
# `xs.pop()` needs an element (`xs.length >? 0`); `xs.pop(i)` an index in
# bounds, as `xs[i]` does. Both are checked at run time where deferred.
fact_removal=(n:TextWord @s:FactState index:TextWord length:TextWord):>void=>$unsafe {
    let zero=fact_constant(@s 0)
    if nodes.ptr[n].aux =? int32(int64(IN.pop)) {
        let c=fact_compare(s 'gt' length zero)
        if c not=? 1 {wit_operation(n @s 'gt' WitSide(length kid(n 0) (if wit_text(kid(n 0)) not=? "" {"{wit_text(kid(n 0))}.length"} else {""}) true) WitSide(zero 0 "0" false true) c "pop() of an empty array" "pop() has an element to remove")}
        return
    }
    let lo=fact_compare(s 'le' zero index)
    let hi=fact_compare(s 'lt' index length)
    if lo not=? 1 or hi not=? 1 {wit_index(n @s index length lo hi kid(n 0) kid(n 1))}
}
fact_string_index=(n:TextWord @s:FactState index:TextWord length:TextWord):>void=>{
    if fact_speculating not=? 0 or not (fact_policy =? 'RequireStatic' or fact_query) {return}
    let zero=fact_constant(@s 0)
    let lo=fact_compare(s 'le' zero index)
    let hi=fact_compare(s 'lt' index length)
    if fact_probe_on {fact_probe_record(n lo =? 1 and hi =? 1)}
    else if lo not=? 1 or hi not=? 1 {wit_index(n @s index length lo hi kid(n 0) kid(n 1))}
}
# `text[a..b)`: 0 <=? a <=? b <=? text.length (an inclusive end counts one
# more, an open end is the length); the slice's length is their difference.
fact_string_slice=(n:TextWord @s:FactState values:array<int64> length:TextWord):>TextWord=>$unsafe {
    let inclusive=nodes.ptr[kid(n 3)].kind =? 'bool_lit' and nodes.ptr[kid(n 3)].ival not=? 0
    let stop=nodes.ptr[kid(n 4)].kind not=? 'bool_lit' or nodes.ptr[kid(n 4)].ival not=? 0
    let lo=values[1]
    let hi=length
    if stop {
        hi=values[2]
        if inclusive {hi=fact_arithmetic(@s kid(n 2) 'plus' hi fact_constant(@s 1))}
    }
    if fact_speculating =? 0 and (fact_policy =? 'RequireStatic' or fact_query) {
        let zero=fact_constant(@s 0)
        let checks=[fact_compare(s 'le' zero lo) fact_compare(s 'le' lo hi) fact_compare(s 'le' hi length)]
        if fact_probe_on {fact_probe_record(n checks[0] =? 1 and checks[1] =? 1 and checks[2] =? 1)}
        else if checks[0] not=? 1 or checks[1] not=? 1 or checks[2] not=? 1 {
            wit_slice_at(n @s lo hi length checks kid(n 0) kid(n 1) (if stop {kid(n 2)} else {0}) inclusive true)
        }
    }
    let value=fact_new(@s FactBound() FactTerm(type=ntype(n)))
    let size=fact_arithmetic(@s kid(n if stop {2} else {1}) 'minus' hi lo)
    if s.projections.length <? FACT_CAP {fact_add_projection(@s FactProjection(value (-1) false size))}
    value
}

# Summarize only a demanded array field or integer tuple slot, over every
# return. Expected O(1) lookup; at most 32 syntax nodes per callee, 128 transfer visits per field query.
fact_constructor_field = (s: mut FactState, base: int, selector: int, v: int):
    call = fact_terms[base].origin
    tuple = tkind(fact_type(fact_terms[base].type)) == .tuple
    summary = fact_summary(int(nodes[call].sym), false, if tuple: selector + 1 else: selector)
    if tuple and fact_scalar(fact_terms[v].type) and is_int(fact_terms[v].type):
        if summary.seen and not summary.value.wide:
            old = fact_bound(s, v)
            if summary.host and v != 0: fact_terms[v].type = T_INT
            fact_set_bound(s, v, FactBound(max(old.lo, summary.value.lo), min(old.hi, summary.value.hi), old.nz or summary.value.nz))
        return
    if summary.seen:
        length = fact_project(s, v, -1, false, T_INT)
        old = fact_bound(s, length)
        fact_set_bound(s, length, FactBound(max(old.lo, summary.length.lo), min(old.hi, summary.length.hi)))
        actuals = fact_constructor_actuals[base]
        if summary.same >= 0 and summary.same < actuals.len():
            arg = actuals[summary.same]
            pt = fact_type(ntype(kid(call, summary.same)))
            other = if tkind(pt) == .array: fact_project(s, arg, -1, false, T_INT) else: fact_clamped(s, arg, call)
            fact_difference(s, length, other, summary.delta, call)
            fact_difference(s, other, length, -summary.delta, call)
            b = fact_bound(s, length); o = fact_bound(s, other)
            lo = if o.lo >= 0 and fact_add_fits(o.lo, summary.delta): max(b.lo, o.lo + summary.delta) else: b.lo
            hi = if o.hi <= fact_length_max() and fact_add_fits(o.hi, summary.delta): min(b.hi, o.hi + summary.delta) else: b.hi
            fact_set_bound(s, length, FactBound(lo, hi))
# The parameter whose entry length the result length equals plus a constant in
# [-2, 2]: at most a few distance queries per array parameter and return.
fact_summary_relation = (s: FactState, length: int) -> (int, int):
    loop i in [0..fact_summary_entry.len()):
        l = fact_summary_entry[i]
        if l == 0: continue
        loop c in [-2..3):
            if fact_distance(s, length, l, c) and fact_distance(s, l, length, -c): return (i, c)
    (-1, 0)
fact_summary_record = (s: mut FactState, r0: int):
    t = fact_type(int(fns[fact_summary_owner].ret))
    r = r0
    payload = fact_summary_payload(t)
    if payload != 0 and fact_summary_field == 0:
        # (a present return's payload; a known `none` adds nothing)
        if r != 0:
            tag = fact_bound(s, fact_project(s, r, -3, false, T_INT))
            if tag.lo == 0 and tag.hi == 0 and not tag.wide: return
            # (this describes a present payload: what holds where the tag is 1,
            # its implications too; the state ends with this return)
            if s.conditional.len() > 0 and not (tag.lo == 1 and tag.hi == 1):
                fact_tag(s, r, 1, true)
                if not s.live: return
            r = fact_project(s, r, -4, false, payload)
        t = payload
    if fact_summary_field != 0:
        selector = if tkind(t) == .tuple: fact_summary_field - 1 else: fact_summary_field
        t = fact_summary_field_type(t, fact_summary_field)
        if r != 0: r = fact_project(s, r, selector, false, t)
    length = FactBound()
    value = FactBound()
    same = -1
    delta = 0
    if r != 0 and tkind(t) == .array:
        lv = fact_project(s, r, -1, false, T_INT)
        length = fact_bound(s, lv)
        if fact_summary_entry.len() > 0:
            same, delta = fact_summary_relation(s, lv)
    else if r != 0: value = fact_bound(s, r)
    # (a mathematical int result of fixed-width or singleton returns is a
    # finite int64 value; O(incident rows) per return)
    host = r != 0 and fact_type(t) == T_MATH_INT and (not fact_summary_acc.seen or fact_summary_acc.host) and fact_host_finite(s, r)
    upper = -1
    upper_delta = 0
    upper_field = 0
    post_field = 0
    if r != 0 and fact_scalar(t) and is_int(t) and t != T_U64:
        # One source-selected array endpoint per result; at most two bounded
        # queries per array parameter/return, no pair enumeration. Once a
        # result arm loses the relation, later arms cannot restore it.
        loop i in [0..fact_summary_entry.len()):
            length_value = fact_summary_entry[i]
            if length_value == 0: continue
            if fact_summary_acc.seen and fact_summary_acc.upper != i: continue
            limit = if not fact_summary_acc.seen or fact_summary_acc.upper_delta == -1: -1 else: 0
            holds = fact_entails(s, r, length_value, limit)
            if not holds and limit != 0:
                limit = 0
                holds = fact_entails(s, r, length_value, limit)
            if holds:
                upper = i; upper_delta = limit
                break
        # (or a record parameter's array field, when no array parameter holds it)
        if upper < 0:
            loop entry in fact_summary_fields:
                if fact_summary_acc.seen and (fact_summary_acc.upper != entry.0 or fact_summary_acc.upper_field != entry.1): continue
                limit = if not fact_summary_acc.seen or fact_summary_acc.upper_delta == -1: -1 else: 0
                holds = fact_entails(s, r, entry.2, limit)
                if not holds and limit != 0:
                    limit = 0
                    holds = fact_entails(s, r, entry.2, limit)
                if holds:
                    upper = entry.0; upper_field = entry.1; upper_delta = limit
                    break
    post = -1
    # Place results refer to the final observable array, not its entry value.
    # Pending return cleanup has not run: publish no place relation then.
    # One bounded query per mutable array parameter on demanded scalar
    # summaries only; existing body/state budgets apply. Every return agrees.
    if r != 0 and fact_scalar(t) and is_int(t) and t != T_U64 and fact_pending_defers == 0 and not ownership_fact_cleanup:
        loop i in [0..fact_summary_entry.len()):
            l = fns[fact_summary_owner].params[i]
            if fact_summary_entry[i] == 0 or int(locals[l].flags) & LF_MUTPARAM == 0: continue
            if fact_summary_acc.seen and fact_summary_acc.post != i: continue
            b = fact_binding(s, PlaceIdentity(.local, int(locals[l].owner), l))
            if b < 0: continue
            length_value = fact_project(s, s.bindings[b].value, -1, false, T_INT)
            if not fact_entails(s, r, length_value, -1): continue
            post = i
            break
        # (a mutable record parameter's array field at exit, `intern(@g name)`)
        if post < 0:
            loop entry in fact_summary_fields:
                l = fns[fact_summary_owner].params[entry.0]
                if int(locals[l].flags) & LF_MUTPARAM == 0: continue
                if fact_summary_acc.seen and (fact_summary_acc.post != entry.0 or fact_summary_acc.post_field != entry.1): continue
                b = fact_binding(s, PlaceIdentity(.local, int(locals[l].owner), l))
                if b < 0: continue
                pt = fact_type(int(locals[l].type))
                field = fact_project(s, s.bindings[b].value, entry.1, false, fact_call_field_type(pt, entry.1))
                if field == 0 or not fact_entails(s, r, fact_project(s, field, -1, false, T_INT), -1): continue
                post = entry.0; post_field = entry.1
                break
    # Reuse globals already demanded by this scalar summary, never scan
    # module declarations or a second body. At most eight bounded queries
    # on its first return; later returns check the same indexed binding.
    # Cleanup may still replace/shrink a global after evaluating the result.
    global_post = 0
    if r != 0 and payload == 0 and fact_summary_field == 0 and fact_scalar(t) and is_int(t) and t != T_U64 and upper < 0 and post < 0 and fact_pending_defers == 0 and not ownership_fact_cleanup:
        if fact_summary_acc.seen:
            g = fact_summary_acc.global_post
            if g > 0:
                b = fact_binding(s, PlaceIdentity(.global, 0, g))
                if b >= 0 and fact_entails(s, r, fact_project(s, s.bindings[b].value, -1, false, T_INT), -1): global_post = g
        else:
            tried = 0
            bindings = s.bindings
            loop binding in bindings:
                g = binding.place.declaration
                if binding.place.root != .global or g <= 0 or tkind(fact_type(int(globals[g].type))) != .array: continue
                if tried >= 8: break
                tried += 1
                if fact_entails(s, r, fact_project(s, binding.value, -1, false, T_INT), -1):
                    global_post = g
                    break
    if fact_summary_acc.seen:
        length = fact_hull(fact_summary_acc.length, length, 0)
        value = fact_hull(fact_summary_acc.value, value, 0)
        if fact_summary_acc.same != same or fact_summary_acc.delta != delta: same = -1
    lengths: int[]
    useful = false
    loop i in [0..fact_summary_entry.len()):
        mode = 0
        l = fns[fact_summary_owner].params[i]
        prior = if not fact_summary_acc.seen: 1 else if i < fact_summary_acc.lengths.len(): fact_summary_acc.lengths[i] else: 0
        if prior != 0 and fact_summary_entry[i] != 0 and int(locals[l].flags) & LF_MUTPARAM != 0 and fact_pending_defers == 0 and not ownership_fact_cleanup:
            b = fact_binding(s, PlaceIdentity(.local, int(locals[l].owner), l))
            if b >= 0:
                current = fact_project(s, s.bindings[b].value, -1, false, T_INT)
                if fact_entails(s, fact_summary_entry[i], current, 0):
                    mode = if prior == 1 and fact_entails(s, current, fact_summary_entry[i], 0): 1 else: 2
        lengths.push(mode)
        useful = useful or mode != 0
    if not useful: lengths = []
    if fact_summary_shapes.len() > 0: fact_summary_record_shapes(s)
    fact_summary_acc = FactSummary(length, value, true, same, delta, upper, upper_delta, host, post, lengths, upper_field, post_field, global_post)
    # A hull only widens. Once it says nothing the result's own domain does
    # not, and no argument-length relation survives (once lost, it stays
    # lost), the rest of the run cannot bound anything a caller asks: stop it
    # (an unbounded summary counts the same as none).
    if same < 0 and upper < 0 and post < 0 and global_post == 0 and fact_summary_shape_mask == 0 and fact_summary_vacuous(fact_summary_acc, t):
        fact_loop_steps = FACT_STEPS + 1
        fact_loop_exhausted = true
# O(demanded N-D parameters) per return, under the ordinary summary budget.
fact_summary_record_shapes = (s: mut FactState):
    shapes = 0
    loop entry in fact_summary_shapes:
        i = entry.0
        keeps = false
        if entry.1 != 0 and (not fact_summary_acc.seen or fact_summary_shape_mask & (1 << i) != 0) and fact_pending_defers == 0 and not ownership_fact_cleanup:
            l = fns[fact_summary_owner].params[i]
            b = fact_binding(s, PlaceIdentity(.local, int(locals[l].owner), l))
            if b >= 0:
                current = s.bindings[b].value
                keeps = fact_nd_shape(s, current) == entry.1 and fact_nd_data_length(s, current) == entry.2
        if keeps: shapes |= 1 << i
    fact_summary_shape_mask = shapes
# An optional integer result (`:>int?`, a position or none): its summary
# describes the payload of the present returns. O(1).
fact_summary_payload = (t: int) -> int:
    if tkind(t) != .opt: return 0
    e = fact_type(int(types[t].elem))
    if fact_scalar(e) and is_int(e) and e != T_U64: e else: 0
fact_summary_vacuous = (acc: FactSummary, t: int) -> bool:
    if acc.lengths.len() > 0: return false
    if tkind(t) == .array: return acc.length.lo <= 0 and acc.length.hi >= fact_length_max()
    d = fact_domain(t)
    acc.value.lo <= d.lo and acc.value.hi >= d.hi and not acc.value.nz and not acc.host
# Ordinary array record fields and flat tuple slots. Shaped tensors have
# their own contracts; nested records, variants and hooks stay outside this
# summary. Type-indexed, O(fields), at most 32 tuple slots per demanded type.
fact_constructor_type = (t: int) -> bool:
    if tkind(t) != .struct_ and tkind(t) != .tuple: return false
    if let known = fact_constructor_types.get(t): return known
    if tkind(t) == .tuple:
        found = false
        if types[t].nargs > 32: fact_constructor_types[t] = false; return false
        loop i in [0..int(types[t].nargs)):
            part = fact_type(type_args[int(types[t].args) + i])
            if tkind(part) == .array or fact_scalar(part) and is_int(part) and part != T_U64: found = true
        if found and ownership_decls.len() != 0 and ownership_fact_type(t): found = false
        fact_constructor_types[t] = found
        return found
    si = int(types[t].st)
    eligible = not is_nd(t) and structs[si].nvariants == 0 and not structs[si].union_ and not structs[si].soa_
    found = false
    if eligible:
        loop i in [0..int(structs[si].nfields)):
            if tkind(fact_type(int(fields[int(structs[si].fields) + i].type))) == .array: found = true
    if found and ownership_decls.len() != 0 and ownership_fact_type(t): found = false
    fact_constructor_types[t] = found
    found
# Bound slice construction too, before it allocates indexes for a large
# algorithm merely because its return type happens to contain an array.
fact_constructor_body = (f: int) -> bool:
    if let known = fact_constructor_bodies.get(f): return known
    work = [int(fns[f].body)]
    cursor = 0
    loop cursor < work.len() and work.len() <= 32:
        n = work[cursor]
        cursor += 1
        if n != 0 and nodes[n].kind != .lambda:
            if nkids(n) > 32:
                fact_constructor_bodies[f] = false
                return false
            fact_slice_push_children(work, n)
    small = work.len() <= 32
    fact_constructor_bodies[f] = small
    small
# A demanded constructor field survives a conditional value just as
# separate return statements do. No other fields need to be visited.
fact_constructor_join = (n: int, paths0: FactPaths, y: int, z: int, result: FactBound, hull: int, s: mut FactState) -> int:
    paths = paths0
    field = fact_summary_field
    ft = fact_summary_field_type(fact_type(ntype(n)), field)
    if tkind(fact_type(ntype(n))) == .tuple: field -= 1
    if fact_scalar(ft) and is_int(ft):
        a = fact_project(paths.yes, y, field, false, ft)
        b = fact_project(paths.no, z, field, false, ft)
        bound = if not paths.yes.live: fact_bound(paths.no, b) else if not paths.no.live: fact_bound(paths.yes, a) else: fact_hull(fact_bound(paths.yes, a), fact_bound(paths.no, b), n)
        part_type = if not paths.yes.live: fact_terms[b].type else if not paths.no.live: fact_terms[a].type else: fact_hull_type(ft, paths.yes, a, paths.no, b)
        s = fact_join(paths.yes, paths.no, n)
        value = fact_new(s, result, FactTerm(type = hull))
        part = fact_new(s, bound, FactTerm(type = part_type))
        if s.projections.len() < FACT_CAP: fact_add_projection(s, FactProjection(value, field, false, part))
        return value
    a = fact_project(paths.yes, fact_project(paths.yes, y, field, false, ft), -1, false, T_INT)
    b = fact_project(paths.no, fact_project(paths.no, z, field, false, ft), -1, false, T_INT)
    length = if not paths.yes.live: fact_bound(paths.no, b) else if not paths.no.live: fact_bound(paths.yes, a) else: fact_hull(fact_bound(paths.yes, a), fact_bound(paths.no, b), n)
    left = fact_summary_relation(paths.yes, a)
    right = fact_summary_relation(paths.no, b)
    relation = if not paths.yes.live: right else if not paths.no.live or left == right: left else: (-1, 0)
    s = fact_join(paths.yes, paths.no, n)
    value = fact_new(s, result, FactTerm(type = hull))
    part = fact_project(s, value, field, false, ft)
    count = fact_project(s, part, -1, false, T_INT)
    fact_set_bound(s, count, length)
    if relation.0 >= 0:
        other = fact_summary_entry[relation.0]
        fact_difference(s, count, other, relation.1, n)
        fact_difference(s, other, count, -relation.1, n)
    value
# Tuple summary keys use slot+1 because zero denotes the whole result.
# Function identity keeps those keys disjoint from named record fields.
fact_summary_field_type = (t: int, field: int) -> int:
    if tkind(t) == .tuple:
        if field <= 0 or field > int(types[t].nargs): return T_VOID
        return fact_type(type_args[int(types[t].args) + field - 1])
    fact_type(shape_field_type(t, field))
fact_summary = (f: int, places: bool = false, field: int = 0) -> FactSummary:
    key = if field == 0: f else: fact_pair_key(f, field)
    if let known = fact_summaries.get(key): return known
    unknown = FactSummary(FactBound(), FactBound())
    d = int(fns[f].decl)
    t = fact_type(int(fns[f].ret))
    if fns[f].state != 2 or fns[f].body == 0 or fns[f].kind == FK_INIT or fns[f].caps.len() != 0 or d != 0 and has_flag(d, NF_EXTERN) or effect_unavailable.has(f): return unknown
    if field != 0: t = fact_summary_field_type(t, field)
    else if fact_summary_payload(t) != 0: t = fact_summary_payload(t)
    if tkind(t) != .array and not (fact_scalar(t) and is_int(t)) and not places: return unknown
    if (field != 0 or fact_constructor_budget >= 0) and not fact_constructor_body(f):
        if field != 0: fact_summaries[key] = unknown
        return unknown
    fact_summaries[key] = unknown
    constructor_root = field != 0 and fact_constructor_budget < 0
    if constructor_root: fact_constructor_budget = 128
    saved_field = fact_summary_field
    saved_limit = fact_step_limit
    fact_step_limit = if field != 0: 128 else: FACT_STEPS
    fact_summary_field = field
    saved = (fact_owner, fact_summary_owner, fact_speculating, fact_loop_steps, fact_loop_exhausted, proof_active, result_active, fact_pending_defers, fact_probe_on, fact_query)
    saved_entry = refine_entry
    saved_loops = fact_loops
    saved_pushes = fact_push_frames
    saved_hulls = fact_hull_owner
    fact_push_frames = []
    saved_acc = fact_summary_acc
    saved_slice = fact_slice
    saved_lengths = fact_summary_entry
    saved_fields = fact_summary_fields
    saved_shapes = fact_summary_shapes
    saved_shape_mask = fact_summary_shape_mask
    fact_summary_shapes = []
    fact_summary_shape_mask = 0
    saved_assumed = fact_summary_assumed
    saved_used = fact_summary_used
    fact_summary_assumed = []
    fact_summary_used = false
    fact_owner = f
    fact_summary_owner = f
    fact_speculating += 1
    fact_loop_steps = 0
    fact_loop_exhausted = false
    proof_active = false
    result_active = false
    fact_pending_defers = 0
    fact_probe_on = false
    fact_query = false
    fact_loops = []
    fact_summary_acc = FactSummary()
    state = FactState()
    # Width conversions request refinements without enabling declared contracts.
    # A summary/deferred walk still needs its own entry, never its caller's slots.
    refine_entry = []
    if refine_active or refine_owners.has(f): refine_fact_entry(f, state)
    fact_summary_entry = []
    if places or tkind(t) == .array or fact_scalar(t) and is_int(t) and t != T_U64:
        loop l in fns[f].params:
            pt = fact_type(int(locals[l].type))
            v = 0
            if tkind(pt) == .array:
                place = PlaceIdentity(.local, int(locals[l].owner), l)
                i = fact_binding(state, place)
                if i >= 0: v = state.bindings[i].value
                else:
                    v = fact_new(state, FactBound(), FactTerm(type = pt))
                    fact_bind(state, place, v)
                v = fact_project(state, v, -1, false, T_INT)
            # (a count parameter: the result may be max(0, n) long, `fill(x n)`)
            else if tkind(t) == .array and fact_scalar(pt) and is_int(pt) and pt != T_U64:
                v = fact_clamped(state, fact_read(state, mk_ident_local(l, locals[l].pos)))
            fact_summary_entry.push(v)
            if places and int(locals[l].flags) & LF_MUTPARAM != 0 and fact_summary_entry.len() <= 62 and tkind(pt) == .struct_ and is_nd(pt):
                value = fact_read(state, mk_ident_local(l, locals[l].pos))
                fact_summary_shapes.push((fact_summary_entry.len() - 1, fact_nd_shape(state, value), fact_nd_data_length(state, value)))
    fact_summary_fields = []
    if fact_scalar(t) and is_int(t) and t != T_U64 and field == 0:
        loop i in [0..fns[f].params.len()):
            l = fns[f].params[i]
            pt = fact_type(int(locals[l].type))
            if not fact_record_arrays(pt): continue
            si = int(types[pt].st)
            value = 0
            loop k in [0..int(structs[si].nfields)):
                if fact_summary_fields.len() >= 8: break
                name = int(fields[int(structs[si].fields) + k].name)
                ft = fact_call_field_type(pt, name)
                if ft == 0 or tkind(fact_type(ft)) != .array: continue
                if value == 0:
                    place = PlaceIdentity(.local, int(locals[l].owner), l)
                    b = fact_binding(state, place)
                    if b >= 0: value = state.bindings[b].value
                    else:
                        value = fact_new(state, FactBound(), FactTerm(type = pt))
                        fact_bind(state, place, value)
                length = fact_project(state, fact_project(state, value, name, false, ft), -1, false, T_INT)
                if length != 0: fact_summary_fields.push((i, name, length))
    fact_slice_prepare(f, true)
    if places:
        loop i in [0..fact_summary_entry.len()):
            l = fns[f].params[i]
            fact_summary_assumed.push(if fact_summary_entry[i] != 0 and tkind(fact_type(int(locals[l].type))) == .array and int(locals[l].flags) & LF_MUTPARAM != 0: 1 else: 0)
    entry = state
    r = fact_capture(int(fns[f].body), state)
    if state.live: fact_summary_record(state, r)
    verified = true
    if fact_summary_used:
        loop i in [0..fact_summary_assumed.len()):
            if fact_summary_assumed[i] != 0 and (i >= fact_summary_acc.lengths.len() or fact_summary_acc.lengths[i] != 1): verified = false
    # A failed candidate establishes nothing, even about other parameters or
    # the result. Retry without it, spending the SAME speculation budget.
    # At most two body walks, demanded only by a tracked mutable length.
    if not verified and not fact_loop_exhausted:
        fact_summary_assumed = []
        fact_summary_used = false
        fact_summary_acc = FactSummary()
        fact_summary_shape_mask = 0
        state = entry
        r = fact_capture(int(fns[f].body), state)
        if state.live: fact_summary_record(state, r)
    result = if fact_loop_exhausted or fact_constructor_budget == 0 or not fact_summary_acc.seen: unknown else: fact_summary_acc
    if fact_summary_shapes.len() > 0 and fact_constructor_budget < 0 and field == 0:
        fact_shape_summaries[f] = if result.seen: fact_summary_shape_mask else: 0
    fact_owner = saved.0
    fact_summary_owner = saved.1
    fact_speculating = saved.2
    fact_loop_steps = saved.3
    fact_loop_exhausted = saved.4
    proof_active = saved.5
    result_active = saved.6
    fact_pending_defers = saved.7
    fact_probe_on = saved.8
    fact_query = saved.9
    refine_entry = saved_entry
    fact_loops = saved_loops
    fact_push_frames = saved_pushes
    fact_hull_owner = saved_hulls
    fact_summary_acc = saved_acc
    fact_slice = saved_slice
    fact_summary_entry = saved_lengths
    fact_summary_fields = saved_fields
    fact_summary_shapes = saved_shapes
    fact_summary_shape_mask = saved_shape_mask
    fact_summary_assumed = saved_assumed
    fact_summary_used = saved_used
    fact_summary_field = saved_field
    fact_step_limit = saved_limit
    # A constructor's tighter budget must not poison an ordinary summary
    # requested independently later. Keep its recursion sentinel only while running.
    if fact_constructor_budget >= 0 and field == 0: fact_summaries.remove(key)
    else: fact_summaries[key] = result
    if constructor_root: fact_constructor_budget = -1
    result
# A present payload of an optional integer result lies in its summary's
# interval and below the related argument's entry length: conditional
# evidence that a test establishing the present arm activates, as a refined
# arm's (ref_arm_publish). O(1) per demanded call.
fact_summary_payload_publish = (f: int, result: int, entry: int[], payload: int, summary: FactSummary, s: mut FactState):
    if result == 0 or s.conditional.len() >= 32: return
    atoms: RefAtom[]
    if summary.value.lo != FACT_MIN and not summary.value.wide: atoms.push(RefAtom(.ge, RefTerm(), RefTerm(1, summary.value.lo)))
    if summary.value.hi != FACT_MAX and not summary.value.wide: atoms.push(RefAtom(.le, RefTerm(), RefTerm(1, summary.value.hi)))
    values = entry
    if summary.upper >= 0 and summary.upper < entry.len():
        # (materialized now, so the argument's length stays related after the call)
        length = fact_summary_length(s, entry[summary.upper], summary.upper_field, f, summary.upper)
        if summary.upper_field == 0: atoms.push(RefAtom(.le, RefTerm(), RefTerm(2, summary.upper, path = [-1], offset = summary.upper_delta)))
        else if length != 0:
            # (a record field's length: named as one more value, not a path)
            values = entry + [length]
            atoms.push(RefAtom(.le, RefTerm(), RefTerm(2, entry.len(), offset = summary.upper_delta)))
    if atoms.len() == 0: return
    selector = fact_project(s, result, -3, false, T_INT)
    b = fact_bound(s, selector)
    fact_set_bound(s, selector, FactBound(max(0, b.lo), min(1, b.hi)))
    value = fact_project(s, result, -4, false, payload)
    s.conditional.push(ResultEvidence(selector, 1, ref_intern(atoms), values, fns[f].ptypes, value, payload))
fact_record_arrays = (t: int) -> bool:
    if tkind(t) != .struct_ or is_nd(t) or is_map_type(t) or fact_pool_type(t): return false
    if let known = fact_record_array_types.get(t): return known
    si = int(types[t].st)
    found = false
    loop k in [0..int(structs[si].nfields)):
        ft = fact_call_field_type(t, int(fields[int(structs[si].fields) + k].name))
        if ft != 0 and tkind(fact_type(ft)) == .array: found = true; break
    fact_record_array_types[t] = found
    found
# The length a summary relates its result to: argument value's own, or its
# record field's (field != 0, parameter i of f). O(1).
fact_summary_length = (s: mut FactState, value: int, field: int, f: int, i: int) -> int:
    if value == 0: return 0
    if field == 0: return fact_project(s, value, -1, false, T_INT)
    pt = fact_type(int(locals[fns[f].params[i]].type))
    inner = fact_project(s, value, field, false, fact_call_field_type(pt, field))
    if inner == 0: 0 else: fact_project(s, inner, -1, false, T_INT)
# A postcondition's current mutable actual. Place routes contain only named
# fields; a missing/unsupported route supplies no evidence. O(route depth).
fact_summary_actual = (n: int, i: int, s: mut FactState, known: bool = false) -> int:
    if i < 0 or i >= nkids(n): return 0
    e = kid(n, i)
    loop nodes[e].kind == .addr or nodes[e].kind == .conv: e = int(nodes[e].a)
    if place_route(e).declaration == 0: return 0
    if known:
        route = fact_route(e, s)
        b = fact_binding(s, fact_place(route.root))
        if b < 0: return 0
        v = s.bindings[b].value
        loop j in [0..route.selectors.len()):
            p = fact_projection_find(s, v, route.selectors[j], false)
            if p < 0: return 0
            v = s.projections[p].value
        return v
    values = fact_route_values(s, fact_route(e, s))
    if values.len() == 0: 0 else: values[values.len() - 1]

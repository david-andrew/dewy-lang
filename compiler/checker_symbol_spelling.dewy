$runtime_checks
from p"@lib/core/rt.jo" import (__str_from_bytes)
from p"@lib/core/str.jo" import (is_alnum)
from p"check.jo" import (OP_NAMES)

SymbolSpellingWord:type=int64<overflow='wrap'>

operator_symbol=(s:string):>string=>{
    let i:SymbolSpellingWord=0
    loop i <? OP_NAMES.length {
        if OP_NAMES[i] =? s {return "op_{OP_NAMES[i + 1]}"}
        i += 2
    }
    "op"
}

escaped_symbol=(s:string):>string=>{
    let result:array<uint8>=[]
    loop c in (s as array<uint8>) {
        if is_alnum(c) {result.push(c)} else {result.push(b'X')}
        if result.length =? 41 {break}
    }
    __str_from_bytes(result)
}

sanitize=(s:string):>string=>{
    let size=(s as array<uint8>).length
    if size >? 0 {
        let first=(s as array<uint8>)[0]
        if first not=? b'_' and not is_alnum(first) {return operator_symbol(s)}
    }
    if size >? 41 {return escaped_symbol(s)}
    loop c in (s as array<uint8>) {
        if not is_alnum(c) {return escaped_symbol(s)}
    }
    s
}

$runtime_checks
from p"checker_state.dewy" import SK
from p"checker_tokens.dewy" import Tok
from p"checker_expr.dewy" import check_expr
from p"node_store.dewy" import Node
from p"ast.jo" import (nodes NF_CHECKED)
from p"types.jo" import (types prune tkind T_BOOL T_NEVER type_eq has_var is_union)
from p"type_ops.dewy" import (mk_secret unify dt)
from p"expr.jo" import (CV ntype wrap_conv last_checked coerce can_coerce)
from p"util.jo" import (name_of fatal)
from p"secrets.jo" import (secret_reveal_name secret_checks secret_compares)
from p"check.jo" import (runtime_fn)
# Secret checking owns the demanded operations; state stays in secrets.jo.
SecretWord:type=int64<overflow='wrap'>
secret_type_sym=(k:SK):>bool=>k =? 'struct_' or k =? 'enum_' or k =? 'alias_' or k =? 'type_'
secret_hide_checks=(n:SecretWord):>void=>$unsafe {
    loop nodes.ptr[n].kind =? 'conv' {
        if nodes.ptr[n].aux =? int32(int64(CV.refinement)) {secret_checks[n]=true;}
        n=SecretWord(nodes.ptr[n].a)
    }
}
secret_reveal=(s:SecretWord):>void=>$unsafe {
    let t=prune(ntype(s))
    if types.ptr[t].kind not=? 'secret' {return}
    wrap_conv(s CV.none_ prune(SecretWord(types.ptr[t].elem)));
}
secret_wrap=(n:SecretWord t:SecretWord):>int64=>{
    let st=mk_secret(t)
    wrap_conv(n CV.none_ st);
    st
}
secret_member=(n:SecretWord bt:SecretWord):>int64=>$unsafe {
    let a=SecretWord(nodes.ptr[n].a)
    let fname=name_of(SecretWord(nodes.ptr[n].name))
    if SecretWord(nodes.ptr[n].name) not=? secret_reveal_name {
        let what="x"
        if nodes.ptr[a].kind =? 'ident' {what=name_of(SecretWord(nodes.ptr[a].name))}
        fatal(nodes.ptr[n].pos "a {dt(bt)} has no member '{fname}': its value is hidden (`{what}.reveal.{fname}` uses its value, where using it is intended)")
    }
    let et=prune(SecretWord(types.ptr[bt].elem))
    nodes[n]=Node(kind='conv' pos=nodes.ptr[n].pos a=int32(a) aux=int32(int64(CV.none_)) type=int32(et) flags=int32(NF_CHECKED))
    last_checked=n
    et
}
secret_binary=(n:SecretWord op:Tok a:SecretWord b:SecretWord):>int64=>{
    secret_reveal(a)
    secret_reveal(b)
    let t=check_expr(n 0)
    if op =? 'eq' or op =? 'ne' {
        # (constant-time: lower_group.dewy's gen_binary; __ct_str_eq brings __ct_mem_eq)
        let k=tkind(prune(ntype(a)))
        if k =? 'str_' or k =? 'array' {
            secret_compares[n]=true
            runtime_fn("__ct_str_eq");
        }
        return t
    }
    if op =? 'lt' or op =? 'le' or op =? 'gt' or op =? 'ge' {
        let st=secret_wrap(n t)
        last_checked=n
        return st
    }
    secret_result(n t)
}
# Keep the callback's plain integer ABI.
secret_unary=(n:int64):>int64=>$unsafe {
    secret_reveal(SecretWord(nodes.ptr[n].a))
    secret_result(n check_expr(n 0))
}
secret_result=(n:SecretWord t:SecretWord):>int64=>{
    if t =? T_BOOL or tkind(t) =? 'void_' or t =? T_NEVER {return t}
    let st=secret_wrap(n t)
    last_checked=n
    st
}
secret_coerce=(n:SecretWord from_:SecretWord to:SecretWord):>int64=>$unsafe {
    let fk=types.ptr[from_].kind
    let tk=types.ptr[to].kind
    if tk =? 'secret' {
        let te=prune(SecretWord(types.ptr[to].elem))
        if fk =? 'var' {
            unify(from_ to);
            return n
        }
        if fk =? 'secret' {
            if type_eq(SecretWord(types.ptr[from_].elem) te) {
                nodes[n].type=int32(to)
                return n
            }
            if has_var(from_) and unify(from_ to) {return n}
            secret_reveal(n)
        }
        coerce(n te);
        let k=nodes.ptr[n].kind
        if k =? 'int_lit' or k =? 'float_lit' or k =? 'bool_lit' or k =? 'str_lit' {
            nodes[n].type=int32(to)
            return n
        }
        wrap_conv(n CV.none_ to);
        secret_hide_checks(SecretWord(nodes.ptr[n].a))
        return n
    }
    if tk =? 'opt' or tk =? 'var' or tk =? 'param' or is_union(to) or has_var(to) {return -1}
    if type_eq(SecretWord(types.ptr[from_].elem) to) or can_coerce(0 SecretWord(types.ptr[from_].elem) to) {
        fatal(nodes.ptr[n].pos "a {dt(from_)} cannot be used as {dt(to)}: its value is hidden{secret_hint(n)}")
    }
    fatal(nodes.ptr[n].pos "type mismatch: expected {dt(to)}, found {dt(from_)}{secret_hint(n)}")
    n
}
secret_hint=(n:SecretWord):>string=>$unsafe {
    let what="x"
    if nodes.ptr[n].kind =? 'ident' {what=name_of(SecretWord(nodes.ptr[n].name))}
    " (`{what}.reveal` gives its value, where using it is intended)"
}
secret_cast=(n:SecretWord a:SecretWord tt:SecretWord):>int64=>$unsafe {
    check_expr(a SecretWord(types.ptr[tt].elem));
    let v=last_checked
    coerce(v tt);
    nodes[n]=nodes.ptr[v]
    last_checked=n
    tt
}
secret_can_coerce=(n:SecretWord from_:SecretWord to:SecretWord):>int64=>$unsafe {
    let fk=types.ptr[from_].kind
    let tk=types.ptr[to].kind
    if fk =? 'var' or tk =? 'var' {return 1}
    if tk =? 'secret' {
        let fe=from_
        let fnode=n
        if fk =? 'secret' {
            fe=SecretWord(types.ptr[from_].elem)
            fnode=0
        }
        if can_coerce(fnode fe SecretWord(types.ptr[to].elem)) {return 1}
        return 0
    }
    if tk =? 'opt' or is_union(to) {return -1}
    0
}

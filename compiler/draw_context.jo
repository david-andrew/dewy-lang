# The bundled draw precondition is a caller obligation, like an index bound.
# No syntax or inferred public effect is added. Demand comes from a checked
# instance of draw2d's existing __outside_draw guard. Other programs allocate
# no graph and visit no bodies here.
use 'checker_state.dewy'
use 'check.jo'
use 'facts.jo'
use 'effects.jo'
use 'directives.jo'
use 'isolation.jo'
use 'ast.jo'
use 'util.jo'
use 'lex.jo'
use 'expr.jo'
use 'ownership.jo'
use 'witness.jo'
use 'prelude.jo'
use 'draw_ops.dewy'

struct DrawEdge:
    caller: int
    callee: int
    node: int
    value: bool
    next_in: int
    next_out: int

draw_context_guard = 0
draw_edges: DrawEdge[]
draw_in: int[]
draw_out: int[]
draw_required: bool[]
draw_library: bool[]
draw_root: int[]                 # 1 outside, 2 function value, 3 user-called draw
draw_index: int[]
draw_low: int[]
draw_answer: int[]               # 0 open, 1 draw-only, 2 unproven
draw_stack: int[]
draw_serial = 0
draw_built = false
draw_seen: int[]
draw_path: int[]                 # predecessor edge for an outside-draw witness
draw_origin: int[]

# Inventory user runtime children once. Hidden value helpers are unknown
# roots below; asking for their layouts here would instantiate unused bodies.
# The synthesized __game_run argument is the sole trusted draw entry: a user
# call of __game_run or a user-written @draw does not get that certificate.
# Tarjan on incoming calls in the demanded user slice. A component is proved
# only if it has a draw entry and every incoming component is proved. A cycle
# without an entry, an unknown caller, or a path through update stays unproven.
# Inventory O(user body nodes + edges), plus the shared call-site index when
# it has not already been demanded; each reverse SCC query is
# O(V + E), with indexed O(V + E) storage. V and E for the proof include only
# functions reaching a requested draw precondition. The library precondition
# travels with the existing panic SCC walk; no second library walk is made.
# Built only when a caller asks for the precondition, after checking is final.
# Reuse the panic graph's completed SCC, including its independent failures.
# Required callers are recorded even when another panic would mask the guard.

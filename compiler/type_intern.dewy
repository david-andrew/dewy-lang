$runtime_checks
from p"checker_types.dewy" import (TK TypeInfo)

# Complete type interning over the existing stable arena headers. No callback
# enters checking; arena element views end before append or table replacement.
# Expected O(arguments + probes), with amortized table growth and linear rehash.
IWord:type=int64<overflow='wrap'>
let ti_types:ptr<array<TypeInfo>>=$unsafe (uint64(0) as ptr<array<TypeInfo>>)
let ti_args:ptr<array<int32>>=$unsafe (uint64(0) as ptr<array<int32>>)
let ti_table:ptr<array<int32>>=$unsafe (uint64(0) as ptr<array<int32>>)
# Canonical scalar constructors reuse two private request records. Interning is
# synchronous, does not call the checker, and never retains either pointer.
# The owner array and its cached element pointer are never replaced or exposed.
let ti_requests:array<TypeInfo>=[TypeInfo[] TypeInfo[kind='param']]
let ti_request:ptr<TypeInfo>=$unsafe ti_requests.ptr
type_intern_bind=(types:ptr<array<TypeInfo>> args:ptr<array<int32>> table:ptr<array<int32>>):>IWord=>{
    ti_types=types; ti_args=args; ti_table=table; 0
}
const TI_HAS_VAR:int32=1

ti_hash_seed=(input:ptr<TypeInfo>):>IWord=>$unsafe {
    # The frozen ABI stores both literal-union discriminants as 32-bit ordinals.
    # Borrow their fields directly; hashing their text would change table order.
    let words=input as ptr<int32>
    let kind=words[0]
    let rep=words[14]
    let h=IWord(kind) * 31 + IWord(input[0].elem) * 7 + IWord(input[0].st) * 13 + IWord(input[0].bits) + IWord(input[0].mutmask) * 17 + IWord(rep) * 10007
    if input[0].sign {h += 1000003}
    h
}
ti_hash_end=(h:IWord):>uint64=>$unsafe {
    let bits=h transmute uint64
    bits xor (bits >> 29)
}
type_intern_hash=(input:ptr<TypeInfo> args:array<int64>):>uint64=>$unsafe {
    let h=ti_hash_seed(input)
    let p=args.ptr
    let n=IWord(args.length)
    loop i in [IWord(0)..n) {h=h * 131 + p[i]}
    ti_hash_end(h)
}
type_intern_same=(id:IWord input:ptr<TypeInfo> args:array<int64>):>bool=>$unsafe {
    let x=ti_types[0].ptr + id
    let n=IWord(args.length)
    if x[0].rep not=? input[0].rep or x[0].kind not=? input[0].kind or x[0].elem not=? input[0].elem or x[0].st not=? input[0].st or IWord(x[0].nargs) not=? n or x[0].bits not=? input[0].bits or x[0].mutmask not=? input[0].mutmask or x[0].sign not=? input[0].sign {return false}
    let stored=ti_args[0].ptr
    let values=args.ptr
    let first=IWord(x[0].args)
    loop i in [IWord(0)..n) {if IWord(stored[first + i]) not=? values[i] {return false}}
    true
}
type_intern_rehash=():>void=>$unsafe {
    let n=IWord(ti_table[0].length) * 2
    if n <? 4096 {n=4096}
    let count=IWord(ti_types[0].length)
    loop n <? count * 2 {n *= 2}
    ti_table[0]=fill(int32(0) n)
    let table=ti_table[0].ptr
    let types=ti_types[0].ptr
    let args=ti_args[0].ptr
    loop id in [IWord(1)..count) {
        let t=types + id
        if (t[0].flags & TI_HAS_VAR) not=? 0 {continue}
        if t[0].kind =? 'var' or t[0].kind =? 'param' {continue}
        let h=ti_hash_seed(types + id)
        let first=IWord(t[0].args)
        let last=first + IWord(t[0].nargs)
        loop i in [first..last) {h=h * 131 + IWord(args[i])}
        h=(ti_hash_end(h) transmute int64) & (n - 1)
        loop table[h] not=? 0 {h=(h + 1) & (n - 1)}
        table[h]=int32(id)
    }
}
# Canonical hits inspect the input without copying its 60-byte record. Only a
# new arena entry needs a value snapshot; append retains ordinary arena COW.
ti_append=(input:ptr<TypeInfo> args:array<int64> hv:bool):>IWord=>$unsafe {
    let t=input[0]
    if hv {t.flags=t.flags | TI_HAS_VAR}
    let count=IWord(args.length)
    let values=args.ptr
    t.args=int32(ti_args[0].length)
    t.nargs=int32(count)
    loop i in [IWord(0)..count) {ti_args[0].push(int32(values[i]))}
    ti_types[0].push(t)
    IWord(ti_types[0].length) - 1
}
type_intern=(input:ptr<TypeInfo> args:array<int64>):>IWord=>$unsafe {
    let types=ti_types[0].ptr
    let values=args.ptr
    let count=IWord(args.length)
    let hv=false
    if input[0].elem not=? 0 and (types[IWord(input[0].elem)].flags & TI_HAS_VAR) not=? 0 {hv=true}
    loop i in [IWord(0)..count) {if (types[values[i]].flags & TI_HAS_VAR) not=? 0 {hv=true}}
    if input[0].kind =? 'var' or input[0].kind =? 'param' {hv=true}
    if not hv or input[0].kind =? 'param' {
        if ti_table[0].length =? 0 or IWord(ti_types[0].length) * 2 >=? IWord(ti_table[0].length) {type_intern_rehash()}
        let mask=IWord(ti_table[0].length) - 1
        let table=ti_table[0].ptr
        # Reuse this call's argument view instead of opening another hash frame.
        let hash=ti_hash_seed(input)
        loop i in [IWord(0)..count) {hash=hash * 131 + values[i]}
        let h=(ti_hash_end(hash) transmute int64) & mask
        loop table[h] not=? 0 {
            let id=IWord(table[h])
            if type_intern_same(id input args) {return id}
            h=(h + 1) & mask
        }
        let id=ti_append(input args hv)
        ti_table[0][h]=int32(id)
        return id
    }
    ti_append(input args hv)
}

ti_has_var=(t:IWord):>bool=>$unsafe {(ti_types[0].ptr[t].flags & TI_HAS_VAR) not=? 0}
ti_targ=(t:IWord i:IWord):>IWord=>$unsafe {IWord(ti_args[0].ptr[IWord(ti_types[0].ptr[t].args) + i])}

# Inference variables are always fresh and have no type arguments or hash entry.
# This is the interner's existing fresh-entry case, without a host record copy.
type_intern_var=(id:IWord):>IWord=>$unsafe {
    ti_types[0].push(TypeInfo[kind='var' id=int32<overflow='wrap'>(id) flags=TI_HAS_VAR args=int32<overflow='wrap'>(ti_args[0].length)])
    IWord(ti_types[0].length) - 1
}

type_intern_element=(kind:TK elem:IWord):>IWord=>$unsafe {
    ti_request[0].kind=kind
    ti_request[0].elem=int32<overflow='wrap'>(elem)
    type_intern(ti_request [])
}
type_intern_param=(idx:IWord):>IWord=>$unsafe {
    ti_request[1].id=int32<overflow='wrap'>(idx)
    ti_request[1].bits=int32<overflow='wrap'>(idx)
    type_intern(ti_request + 1 [])
}

$runtime_checks
from p"checker_types.dewy" import (Field StructInfo TK TypeInfo Variant)
from p"checker_state.dewy" import (Global Local)
from p"source_types.dewy" import (SrcFile)
from p"elf_format.dewy" import (elf_append_bytes elf_syms put16 put32 put64)
from p"leb128.dewy" import (sleb uleb)
from p"module_paths.dewy" import (is_abs_path)

# Complete DWARF construction. Checker/source arena headers are borrowed;
# layout and storage services may grow them, so no element view crosses a call.
# Output follows existing demanded type/line walks, with indexed memo state.
DWord:type=int64<overflow='wrap'>
DwarfHost:type=[
    type_str:<(t:int64 dewy:bool):>string>
    layout:<(t:int64):>void>
    store_type:<(l:int64):>int64>
    field_store_type:<(f:int64):>int64>
    ir_line:<(id:int64):>int64>
    user_module:<(m:int64):>bool>
]
DwarfInput:type=[
    types:ptr<array<TypeInfo>>
    type_args:ptr<array<int32>>
    structs:ptr<array<StructInfo>>
    fields:ptr<array<Field>>
    variants:ptr<array<Variant>>
    locals:ptr<array<Local>>
    globals:ptr<array<Global>>
    names:ptr<array<string>>
    files:ptr<array<SrcFile>>
    global_ids:ptr<array<int64>>
    ir_positions:ptr<array<int64>>
    dbg_raw:ptr<array<int64>>
    dbg_cfi:ptr<array<int64>>
    line_rows:ptr<array<int64>>
    T_VOID:ptr<int64>
    T_BOOL:ptr<int64>
    T_INT:ptr<int64>
    T_MATH_INT:ptr<int64>
    T_U8:ptr<int64>
    T_F32:ptr<int64>
    T_I32:ptr<int64>
    global_off:ptr<dict<int64 int64>>
    arm:ptr<bool>
    host:ptr<DwarfHost>
]
let dw_inputs:ptr<DwarfInput>=$unsafe (uint64(0) as ptr<DwarfInput>)
dwarf_bind=(input:ptr<DwarfInput>):>DWord=>{dw_inputs=input; 0}
const LF_PARAM=1
const LF_MUTPARAM=2
const LF_ASSIGNED=16
const LF_VALUEPARAM=524288
const DL_NONE=0
const DL_REG=1
const DL_MEM=2
const DL_MEMAT=3
const DL_CONST=4
const DL_FCONST=5
const DL_ADDR=6

# DIEs of types go in dw_tb (the unit's first children), of functions in dw_sb; a reference to a
# type is patched in at the end (dw_fix: (0 dw_tb or 1 dw_sb, position, type)), so types can
# refer to each other in any order (a struct with an array of itself)
let dw_off:array<int64>=[] # real types: their DIE's offset (-1: none yet)
let dw_tb:array<uint8>=[]
let dw_sb:array<uint8>=[]
let dw_fix:array<[int64 int64 int64]>=[]
let dw_memo:dict<int64 int64>=[] # type -> its DIE's offset in the unit
let dw_todo:array<int64>=[]
let dw_base:DWord=0 # where dw_tb starts in the unit

# made-up types (not in types[]): keys below 0
const DW_LONG=-1
const DW_BYTE=-2
const DW_VOIDP=-3
const DW_STRHDR=-4
const DW_STRPTR=-5
const DW_BOX=-10 # - (DW_BOX + e): the box a boxed field keeps a value of type e in
const DW_BOXP=-500000 # a pointer to that box
const DW_HDR=-1000000 # - (DW_HDR + e)... the header of an array of e
const DW_FLEX=-2000000 # an array of e of unknown length
const DW_PTR=-3000000 # a pointer to the header of an array of e
const DW_TAGS=-4000000 # the tags of enum t
const DW_VARIANT=-5000000 # - (DW_VARIANT + 256 t + v): the fields of variant v of enum t
cstr=(@out:array<uint8> s:string):>void=>{
    out.extend(s as array<uint8>)
    out.push(0)
}
let dw_data_addr:DWord=0 # where the globals' data starts (set before dwarf_sections)

# A Dewy program's types carry their Dewy spellings (`int` is the tagged
# integer, `int64` the word): lib/debug's printers read them.
let dw_dewy=false
dw_name=(t:DWord):>string=>$unsafe {
    dw_inputs[0].host[0].type_str(t  dw_dewy)
}
dwarf_image=(text_addr:DWord text_len:DWord main_path:string version:string dir:string):>array<[string array<uint8>]>=>$unsafe {
    let rows_count=DWord(dw_inputs[0].line_rows[0].length)
    let rows=dw_inputs[0].line_rows[0].ptr
    let positions=dw_inputs[0].ir_positions[0].ptr
    let sources_count=DWord(dw_inputs[0].files[0].length)
    let sources=dw_inputs[0].files[0].ptr
    if rows_count =? 0 {return []}
    dw_dewy=main_path.endswith(".dewy")
    let abs=(p:string):>string=>{
        if is_abs_path(p) {return p}
        "{dir}/{p}"
    }
    # Files are numbered from one, preserving their first-use order.
    let fidx=fill(0  sources_count)
    let fnames:array<string>=[]
    let k:DWord=0
    loop k <? rows_count {
        if rows[k + 1] =? 0 {
            k += 2
            continue
        }
        let f=dw_pos_file(positions[rows[k + 1]])
        if f >=? 0 and f <? sources_count and fidx[f] =? 0 {
            fnames.push(abs(sources[f].path))
            fidx[f] = DWord(fnames.length)
        }
        k += 2
    }
    # .debug_line: header, then the program (one sequence over all of .text)
    let hdr:array<uint8>=[]
    hdr.push(1) # minimum_instruction_length
    hdr.push(1) # maximum_operations_per_instruction
    hdr.push(1) # default_is_stmt
    hdr.push(uint8((-5 & 255) & 0xff)) # line_base
    hdr.push(14) # line_range
    hdr.push(13) # opcode_base
    loop x in [0  1  1  1  1  0  0  0  1  0  0  1] {hdr.push(uint8((x) & 0xff))}
    hdr.push(0) # no include directories
    loop nm in fnames {
        cstr(@hdr  nm)
        hdr.push(0) # directory, mtime, length
        hdr.push(0)
        hdr.push(0)
    }
    hdr.push(0)
    let prog:array<uint8>=[]
    prog.reserve(rows_count * 3 + 64)
    prog.push(0) # DW_LNE_set_address
    uleb(@prog  9)
    prog.push(2)
    put64(@prog  text_addr)
    let addr:DWord=0
    let line:DWord=1
    let file:DWord=1
    k=0
    loop k <? rows_count {
        let p=positions[rows[k + 1]]
        let f=file
        let l:DWord=0 # (0: code with no source line)
        if rows[k + 1] not=? 0 {
            let pf=dw_pos_file(p)
            f=0
            if pf >=? 0 and pf <? sources_count {f=fidx[pf]}
            if f =? 0 {
                k += 2
                continue
            }
            l=dw_inputs[0].host[0].ir_line(rows[k + 1])
        }
        if f =? file and l =? line and rows[k + 1] not=? 0 and k >? 0 {
            k += 2
            continue
        }
        if f not=? file {
            prog.push(4) # DW_LNS_set_file
            uleb(@prog  f)
            file=f
        }
        if l not=? line {
            prog.push(3) # DW_LNS_advance_line
            sleb(@prog  l - line)
            line=l
        }
        if rows[k] not=? addr {
            prog.push(2) # DW_LNS_advance_pc
            uleb(@prog  rows[k] - addr)
            addr=rows[k]
        }
        prog.push(1) # DW_LNS_copy
        k += 2
    }
    if text_len >? addr {
        prog.push(2)
        uleb(@prog  text_len - addr)
    }
    prog.push(0) # DW_LNE_end_sequence
    uleb(@prog  1)
    prog.push(1)
    let line_sec:array<uint8>=[]
    put32(@line_sec  2 + 4 + DWord(hdr.length) + DWord(prog.length))
    put16(@line_sec  4)
    put32(@line_sec  DWord(hdr.length))
    elf_append_bytes(@line_sec  hdr)
    elf_append_bytes(@line_sec  prog)
    let ab=dw_abbrevs()
    # .debug_info: the unit, its types, its functions with their variables; .debug_loc: where
    # each variable is while its code runs
    let cu:array<uint8>=[]
    uleb(@cu  1)
    cstr(@cu  "dewy-core {version}") # DW_AT_producer
    put16(@cu  0x0002) # DW_AT_language: DW_LANG_C (the closest a debugger knows)
    cstr(@cu  abs(main_path)) # DW_AT_name
    cstr(@cu  dir) # DW_AT_comp_dir
    put64(@cu  text_addr) # DW_AT_low_pc
    put64(@cu  text_len) # DW_AT_high_pc (a length)
    put32(@cu  0) # DW_AT_stmt_list
    dw_tb=[]
    dw_sb=[]
    dw_fix=[]
    dw_memo=[]
    dw_todo=[]
    dw_off=fill(-1  DWord(dw_inputs[0].types[0].length))
    dw_base=11 + DWord(cu.length)
    # the variables' types first (and the types they are made of), then the functions
    k=0
    loop k <? DWord(dw_inputs[0].dbg_raw[0].length) {
        let nv=dw_inputs[0].dbg_raw[0].ptr[k + 4]
        k += 5
        loop _ in [0..nv) {
            dw_type_die(dw_inputs[0].host[0].store_type(dw_inputs[0].dbg_raw[0].ptr[k]))
            k += 6
        }
    }
    # (the program's own globals, top-level variables included: their types too)
    let gl:array<int64>=[]
    loop g in dw_inputs[0].global_ids[0] {
        if dw_inputs[0].global_off[0].get(g) is? none or dw_inputs[0].globals[0].ptr[g].is_const {continue}
        let m=DWord(dw_inputs[0].globals[0].ptr[g].mod)
        if not dw_inputs[0].host[0].user_module(m) {continue}
        gl.push(g)
        dw_type_die(dw_prune(DWord(dw_inputs[0].globals[0].ptr[g].type)))
    }
    loop DWord(dw_todo.length) >? 0 {dw_type_die(dw_todo.pop())}
    loop fx in dw_fix {dw_put32_at(@dw_tb  fx[1]  dw_offset(fx[2]))}
    let loc:array<uint8>=[]
    k=0
    loop k <? DWord(dw_inputs[0].dbg_raw[0].length) {
        dw_sb.push(12)
        cstr(@dw_sb  elf_syms[dw_inputs[0].dbg_raw[0].ptr[k]][0])
        dw_w64(@dw_sb  text_addr + dw_inputs[0].dbg_raw[0].ptr[k + 1])
        dw_w64(@dw_sb  dw_inputs[0].dbg_raw[0].ptr[k + 2])
        dw_sb.push(1) # DW_AT_frame_base: exprloc of one byte
        dw_sb.push(uint8((0x50 + dw_inputs[0].dbg_raw[0].ptr[k + 3]) & 0xff)) # DW_OP_reg
        let k0=k
        k += 5 + 6 * dw_inputs[0].dbg_raw[0].ptr[k + 4]
        loop v in dbg_vars(k0) {
            let e=v[0]
            let l=dw_inputs[0].dbg_raw[0].ptr[e]
            let lo=dw_inputs[0].dbg_raw[0].ptr[e + 4]
            let hi=dw_inputs[0].dbg_raw[0].ptr[e + 5]
            let c:DWord=16
            if v[1] {c=15}
            if lo <? hi {c -= 2}
            dw_sb.push(uint8((c) & 0xff))
            cstr(@dw_sb  dw_inputs[0].names[0].ptr[DWord(dw_inputs[0].locals[0].ptr[l].name)])
            dw_w32(@dw_sb  dw_off[dw_inputs[0].host[0].store_type(l)])
            if lo <? hi {
                dw_w32(@dw_sb  DWord(loc.length))
                dw_w64(@loc  lo)
                dw_w64(@loc  hi)
                let at=DWord(loc.length)
                put16(@loc  0)
                dw_loc_expr(@loc  dw_inputs[0].dbg_raw[0].ptr[e + 1]  dw_inputs[0].dbg_raw[0].ptr[e + 2]  dw_inputs[0].dbg_raw[0].ptr[e + 3])
                let n=DWord(loc.length) - at - 2
                loc[at] = uint8((n & 255) & 0xff)
                loc[at + 1] = uint8((n >> 8) & 0xff)
                dw_w64(@loc  0)
                dw_w64(@loc  0)
            }
        }
        dw_sb.push(0)
    }
    loop g in gl {
        dw_sb.push(19)
        cstr(@dw_sb  dw_inputs[0].names[0].ptr[DWord(dw_inputs[0].globals[0].ptr[g].name)])
        dw_w32(@dw_sb  dw_off[dw_prune(DWord(dw_inputs[0].globals[0].ptr[g].type))])
        dw_sb.push(9) # exprloc: DW_OP_addr and the address
        dw_sb.push(0x03)
        dw_w64(@dw_sb  dw_data_addr + (dw_inputs[0].global_off[0].get(g) ?? 0))
    }
    let info:array<uint8>=[]
    put32(@info  2 + 4 + 1 + DWord(cu.length) + DWord(dw_tb.length) + DWord(dw_sb.length) + 1)
    put16(@info  4)
    put32(@info  0) # abbreviations at 0
    info.push(8) # address size
    elf_append_bytes(@info  cu)
    elf_append_bytes(@info  dw_tb)
    elf_append_bytes(@info  dw_sb)
    info.push(0) # (the unit's children end)
    let out:array<[string array<uint8>]>=[[".debug_abbrev"  ab]  [".debug_info"  info]  [".debug_line"  line_sec]]
    if DWord(loc.length) >? 0 {out.push([".debug_loc"  loc])}
    if DWord(dw_inputs[0].dbg_cfi[0].length) >? 0 {out.push([".debug_frame"  dw_frames(text_addr)])}
    out
}

# .debug_frame: one CIE, then an FDE for each function. x86-64: at its start the CFA (the stack
# pointer before the call) is rsp + 8 with the return address below it; after push rbp, rsp + 16
# with rbp below the return address; after mov rbp, rsp, rbp + 16 until the epilogue pops rbp
# (then rsp + 8 again, for the ret). arm64: the CFA is sp at the start; after stp x29, x30,
# [sp, -16]! it is sp + 16 with x29 and x30 below it; after mov x29, sp, x29 + 16 until the
# epilogue's ldp (then sp, for the ret). The callee-saved registers are at fixed offsets from it.
dw_frames=(text_addr:DWord):>array<uint8>=>$unsafe {
    let cfi_count=DWord(dw_inputs[0].dbg_cfi[0].length)
    let cfi=dw_inputs[0].dbg_cfi[0].ptr
    let arm=dw_inputs[0].arm[0]
    let f:array<uint8>=[]
    let cie:array<uint8>=[]
    put32(@cie  -1) # CIE id
    cie.push(4) # version
    cie.push(0) # augmentation ""
    cie.push(8) # address size
    cie.push(0) # segment selector size
    if arm {
        uleb(@cie  4) # code alignment (instructions)
        sleb(@cie  -8)
        uleb(@cie  30) # the return address: x30
        cie.push(0x0c) # DW_CFA_def_cfa sp, 0
        uleb(@cie  31)
        uleb(@cie  0)
    }
    else {
        uleb(@cie  1) # code alignment
        sleb(@cie  -8) # data alignment
        uleb(@cie  16) # the return address: "register" 16
        cie.push(0x0c) # DW_CFA_def_cfa rsp, 8
        uleb(@cie  7)
        uleb(@cie  8)
        cie.push(0x80 | 16) # DW_CFA_offset: the return address at CFA - 8
        uleb(@cie  1)
    }
    loop(DWord(cie.length) + 4) % 8 not=? 0 {cie.push(0)}
    put32(@f  DWord(cie.length))
    elf_append_bytes(@f  cie)
    let unit:DWord=1 # (bytes per advance)
    if arm {unit=4}
    let k:DWord=0
    loop k <? cfi_count {
        let start=cfi[k]
        let len_=cfi[k + 1]
        let body=cfi[k + 2]
        let ns=cfi[k + 3]
        k += 4
        let x:array<uint8>=[]
        put32(@x  0) # the CIE, at 0
        put64(@x  text_addr + start)
        put64(@x  len_)
        let at:DWord=0
        if arm {
            x.push(0x40 | 1) # after stp x29, x30, [sp, -16]!
            x.push(0x0e) # DW_CFA_def_cfa_offset 16
            uleb(@x  16)
            x.push(0x80 | 29) # x29 at CFA - 16, x30 at CFA - 8
            uleb(@x  2)
            x.push(0x80 | 30)
            uleb(@x  1)
            x.push(0x40 | 1) # after mov x29, sp
            x.push(0x0d) # DW_CFA_def_cfa_register x29
            uleb(@x  29)
            at=8
        }
        else {
            x.push(0x40 | 1) # after push rbp
            x.push(0x0e) # DW_CFA_def_cfa_offset 16
            uleb(@x  16)
            x.push(0x80 | 6) # rbp at CFA - 16
            uleb(@x  2)
            x.push(0x40 | 3) # after mov rbp, rsp
            x.push(0x0d) # DW_CFA_def_cfa_register rbp
            uleb(@x  6)
            at=4
        }
        dw_advance(@x  (body - at) // unit)
        at=body
        loop _ in [0..ns) {
            let r=cfi[k]
            let o=-cfi[k + 1] // 8
            if r <? 64 {
                x.push(uint8((0x80 | r) & 0xff))
                uleb(@x  o)
            }
            else {
                x.push(0x05) # DW_CFA_offset_extended
                uleb(@x  r)
                uleb(@x  o)
            }
            k += 2
        }
        let ne=cfi[k]
        k += 1
        loop _ in [0..ne) {
            let e=cfi[k]
            k += 1
            dw_advance(@x  (e - at) // unit)
            x.push(0x0a) # DW_CFA_remember_state
            x.push(0x0c) # DW_CFA_def_cfa: the stack pointer, where it was at the start
            if arm {
                uleb(@x  31)
                uleb(@x  0)
                x.push(0x08) # DW_CFA_same_value x29
                uleb(@x  29)
            }
            else {
                uleb(@x  7)
                uleb(@x  8)
                x.push(0x08) # DW_CFA_same_value rbp
                uleb(@x  6)
            }
            x.push(0x40 | 1) # after the ret
            x.push(0x0b) # DW_CFA_restore_state
            at=e + unit
        }
        loop(DWord(x.length) + 4) % 8 not=? 0 {x.push(0)}
        put32(@f  DWord(x.length))
        elf_append_bytes(@f  x)
    }
    f
}
dw_advance=(@x:array<uint8> d:DWord):>void=>$unsafe {
    if d <=? 0 {return}
    if d <? 64 {x.push(uint8((0x40 | d) & 0xff))}
    else if d <? 256 {
        x.push(0x02)
        x.push(uint8((d) & 0xff))
    }
    else if d <? 65536 {
        x.push(0x03)
        put16(@x  d)
    }
    else {
        x.push(0x04)
        put32(@x  d)
    }
}

# ---------------- the abbreviations: (code, tag, children, [(attribute, form)]) ----------------
let dw_ab:array<uint8>=[]
dw_abbrev=(code:DWord tag:DWord kids:bool attrs:array<[int64 int64]>):>void=>$unsafe {
    uleb(@dw_ab  code)
    uleb(@dw_ab  tag)
    if kids {dw_ab.push(1)}
    else {dw_ab.push(0)}
    loop a in attrs {
        uleb(@dw_ab  a[0])
        uleb(@dw_ab  a[1])
    }
    dw_ab.push(0)
    dw_ab.push(0)
}
dw_abbrevs=():>array<uint8>=>$unsafe {
    dw_ab=[]
    let STR:DWord=0x08
    let D1:DWord=0x0b
    let D4:DWord=0x06
    let REF:DWord=0x13
    dw_abbrev(1  0x11  true  [[0x25  STR]  [0x13  0x05]  [0x03  STR]  [0x1b  STR]  [0x11  0x01]  [0x12  0x07]  [0x10  0x17]])
    dw_abbrev(2  0x24  false  [[0x03  STR]  [0x3e  D1]  [0x0b  D1]]) # base type
    dw_abbrev(3  0x0f  false  [[0x0b  D1]  [0x49  REF]]) # pointer
    dw_abbrev(4  0x16  false  [[0x03  STR]  [0x49  REF]]) # typedef
    dw_abbrev(5  0x13  true  [[0x03  STR]  [0x0b  D4]]) # struct
    dw_abbrev(6  0x0d  false  [[0x03  STR]  [0x49  REF]  [0x38  D4]]) # member
    dw_abbrev(7  0x01  true  [[0x49  REF]]) # array
    dw_abbrev(8  0x21  false  []) # its bounds: unknown
    dw_abbrev(9  0x21  false  [[0x37  D4]]) # its bounds: a count
    dw_abbrev(10  0x04  true  [[0x03  STR]  [0x0b  D1]]) # enumeration
    dw_abbrev(11  0x28  false  [[0x03  STR]  [0x1c  0x0d]]) # enumerator
    dw_abbrev(12  0x2e  true  [[0x03  STR]  [0x11  0x01]  [0x12  0x07]  [0x40  0x18]]) # function
    dw_abbrev(13  0x05  false  [[0x03  STR]  [0x49  REF]  [0x02  0x17]]) # parameter
    dw_abbrev(14  0x34  false  [[0x03  STR]  [0x49  REF]  [0x02  0x17]]) # variable
    dw_abbrev(15  0x05  false  [[0x03  STR]  [0x49  REF]]) # (nowhere)
    dw_abbrev(16  0x34  false  [[0x03  STR]  [0x49  REF]])
    dw_abbrev(17  0x13  false  [[0x03  STR]  [0x0b  D4]]) # struct, no fields
    dw_abbrev(18  0x0f  false  [[0x0b  D1]]) # pointer to nothing
    dw_abbrev(19  0x34  false  [[0x03  STR]  [0x49  REF]  [0x02  0x18]]) # a global: at an address
    dw_ab.push(0)
    dw_ab
}

# ---------------- types ----------------
dw_put32_at=(@b:array<uint8> at:DWord v:DWord):>void=>$unsafe {
    loop i in [0..4) {b[at + i] = uint8(((v >> (8 * i)) & 255) & 0xff)}
}

# where type t's DIE is (made-up types: in dw_memo)
dw_offset=(t:DWord):>DWord=>$unsafe {
    if t >=? 0 {return dw_off[t]}
    dw_memo[t]
}

# a reference to type t in a type's DIE (patched when every type is written)
dw_ref=(which:DWord t:DWord):>void=>$unsafe {
    dw_fix.push([0  DWord(dw_tb.length)  t])
    put32(@dw_tb  0)
    if t >=? 0 {
        if(t >=? DWord(dw_off.length) or dw_off[t] <? 0) and not (t in? dw_todo) {dw_todo.push(t)}
    }
    else if dw_memo.get(t) is? none and not (t in? dw_todo) {dw_todo.push(t)}
}

# 8 and 4 bytes at the end of b
dw_w64=(@b:array<uint8> v:DWord):>void=>$unsafe {
    let n=DWord(b.length)
    b.resize(n + 8)
    let p=(b.ptr + n) as ptr<DWord>
    p[0]=v
}
dw_w32=(@b:array<uint8> v:DWord):>void=>$unsafe {
    let n=DWord(b.length)
    b.resize(n + 4)
    let p=(b.ptr + n) as ptr<uint32>
    p[0]=uint32(v & 0xffffffff)
}
dw_base_type=(name:string enc:DWord size:DWord):>void=>$unsafe {
    dw_tb.push(2)
    cstr(@dw_tb  name)
    dw_tb.push(uint8((enc) & 0xff))
    dw_tb.push(uint8((size) & 0xff))
}
dw_member=(name:string t:DWord off:DWord):>void=>$unsafe {
    dw_tb.push(6)
    cstr(@dw_tb  name)
    dw_ref(0  t)
    put32(@dw_tb  off)
}

# the header every array and string points to: [rc][len][cap][data...]
dw_header=(name:string data:DWord):>void=>$unsafe {
    dw_tb.push(5)
    cstr(@dw_tb  name)
    put32(@dw_tb  24)
    dw_member("rc"  DW_LONG  0)
    dw_member("len"  DW_LONG  8)
    dw_member("cap"  DW_LONG  16)
    dw_member("data"  data  24)
    dw_tb.push(0)
}
dw_type_die=(t0:DWord):>void=>$unsafe {
    if t0 >=? 0 {
        loop DWord(dw_off.length) <=? t0 {dw_off.push(-1)}
        if dw_off[t0] >=? 0 {return}
        dw_off[t0] = dw_base + DWord(dw_tb.length)
    }
    else {
        if dw_memo.get(t0) isnt? none {return}
        dw_memo[t0] = dw_base + DWord(dw_tb.length)
    }
    if t0 <? 0 {
        if t0 <=? DW_VARIANT {
            let t=(DW_VARIANT - t0) >> 8
            let si=DWord(dw_inputs[0].types[0].ptr[t].st)
            let vi=DWord(dw_inputs[0].structs[0].ptr[si].variants) + ((DW_VARIANT - t0) & 255)
            let poff=DWord(dw_inputs[0].structs[0].ptr[si].payload_off)
            dw_tb.push(5)
            cstr(@dw_tb  "{dw_name(t)}.{dw_inputs[0].names[0].ptr[DWord(dw_inputs[0].variants[0].ptr[vi].name)]}")
            put32(@dw_tb  dw_tsize(t) - poff)
            loop i in [0..DWord(dw_inputs[0].variants[0].ptr[vi].nfields)) {
                let fi=DWord(dw_inputs[0].variants[0].ptr[vi].fields) + i
                dw_member(dw_inputs[0].names[0].ptr[DWord(dw_inputs[0].fields[0].ptr[fi].name)]  dw_inputs[0].host[0].field_store_type(fi)  DWord(dw_inputs[0].fields[0].ptr[fi].offset) - poff)
            }
            dw_tb.push(0)
            return
        }
        if t0 =? DW_LONG {dw_base_type("long"  0x05  8)}
        else if t0 =? DW_BYTE {dw_base_type("u8"  0x08  1)}
        else if t0 =? DW_VOIDP {
            dw_tb.push(18)
            dw_tb.push(8)
        }
        else if t0 =? DW_STRHDR {dw_header("str header"  DW_FLEX - dw_inputs[0].T_U8[0])}
        else if t0 =? DW_STRPTR {
            dw_tb.push(3)
            dw_tb.push(8)
            dw_ref(0  DW_STRHDR)
        }
        else if t0 <=? DW_TAGS {
            let t=DW_TAGS - t0
            let si=DWord(dw_inputs[0].types[0].ptr[t].st)
            dw_tb.push(10)
            cstr(@dw_tb  "{dw_inputs[0].structs[0].ptr[si].name} tag")
            dw_tb.push(4)
            loop v in [0..DWord(dw_inputs[0].structs[0].ptr[si].nvariants)) {
                let vi=DWord(dw_inputs[0].structs[0].ptr[si].variants) + v
                dw_tb.push(11)
                cstr(@dw_tb  dw_inputs[0].names[0].ptr[DWord(dw_inputs[0].variants[0].ptr[vi].name)])
                if dw_inputs[0].structs[0].ptr[si].simple_enum {sleb(@dw_tb  dw_inputs[0].variants[0].ptr[vi].value)}
                else {sleb(@dw_tb  DWord(dw_inputs[0].variants[0].ptr[vi].tag))}
            }
            dw_tb.push(0)
        }
        else if t0 <=? DW_PTR {
            dw_tb.push(3)
            dw_tb.push(8)
            dw_ref(0  DW_HDR - (DW_PTR - t0))
        }
        else if t0 <=? DW_FLEX {
            dw_tb.push(7)
            let e=DW_FLEX - t0
            if e =? dw_inputs[0].T_U8[0] {dw_ref(0  DW_BYTE)}
            else {dw_ref(0  e)}
            dw_tb.push(8)
            dw_tb.push(0)
        }
        else if t0 <=? DW_HDR {dw_header("{dw_name(DW_HDR - t0)}[] header"  DW_FLEX - (DW_HDR - t0))}
        else if t0 <=? DW_BOXP {
            dw_tb.push(3)
            dw_tb.push(8)
            dw_ref(0  DW_BOX - (DW_BOXP - t0))
        }
        else if t0 <=? DW_BOX {
            # [rc][value] (lib/debug's printers show the value, or the default for none)
            let e=DW_BOX - t0
            dw_tb.push(5)
            cstr(@dw_tb  "{dw_name(e)} box")
            put32(@dw_tb  8 + dw_tsize(e))
            dw_member("rc"  DW_LONG  0)
            dw_member("value"  e  8)
            dw_tb.push(0)
        }
        return
    }
    let t=dw_prune(t0)
    let k=dw_inputs[0].types[0].ptr[t].kind
    let size=dw_tsize(t)
    if k =? 'int_' and dw_dewy and t =? dw_inputs[0].T_MATH_INT[0] {
        # (the tagged `int`: a name over its word, which debuggers keep)
        dw_tb.push(4)
        cstr(@dw_tb  "int")
        dw_ref(0  dw_inputs[0].T_INT[0])
    }
    else if k =? 'int_' {
        let enc:DWord=0x07
        if dw_inputs[0].types[0].ptr[t].sign {enc=0x05}
        dw_base_type(dw_name(t)  enc  size)
    }
    else if k =? 'bool_' {dw_base_type("bool"  0x02  1)}
    else if k =? 'float_' {dw_base_type(dw_name(t)  0x04  size)}
    else if k =? 'str_' {
        dw_tb.push(4)
        cstr(@dw_tb  if dw_dewy {"string"} else {"str"})
        dw_ref(0  DW_STRPTR)
    }
    else if k =? 'array' {
        dw_tb.push(4)
        cstr(@dw_tb  dw_name(t))
        dw_ref(0  DW_PTR - DWord(dw_inputs[0].types[0].ptr[t].elem))
    }
    else if k =? 'box' {
        # (a boxed field: named as its type is, a pointer to the box)
        dw_tb.push(4)
        cstr(@dw_tb  dw_name(t))
        dw_ref(0  DW_BOXP - DWord(dw_inputs[0].types[0].ptr[t].elem))
    }
    else if k =? 'ptr' {
        let e=DWord(dw_inputs[0].types[0].ptr[t].elem)
        if e =? dw_inputs[0].T_VOID[0] or dw_tkind(e) =? 'void_' {
            dw_tb.push(18)
            dw_tb.push(8)
        }
        else {
            dw_tb.push(3)
            dw_tb.push(8)
            dw_ref(0  e)
        }
    }
    else if k =? 'cfn' or k =? 'null_' {
        dw_tb.push(18)
        dw_tb.push(8)
    }
    else if k =? 'struct_' {
        let si=DWord(dw_inputs[0].types[0].ptr[t].st)
        dw_tb.push(5)
        cstr(@dw_tb  dw_name(t))
        put32(@dw_tb  size)
        loop i in [0..DWord(dw_inputs[0].structs[0].ptr[si].nfields)) {
            let fi=DWord(dw_inputs[0].structs[0].ptr[si].fields) + i
            dw_member(dw_inputs[0].names[0].ptr[DWord(dw_inputs[0].fields[0].ptr[fi].name)]  dw_inputs[0].host[0].field_store_type(fi)  DWord(dw_inputs[0].fields[0].ptr[fi].offset))
        }
        dw_tb.push(0)
    }
    else if k =? 'enum_' {
        let si=DWord(dw_inputs[0].types[0].ptr[t].st)
        if dw_inputs[0].structs[0].ptr[si].simple_enum {
            dw_tb.push(10)
            cstr(@dw_tb  dw_name(t))
            dw_tb.push(uint8((size) & 0xff))
            loop v in [0..DWord(dw_inputs[0].structs[0].ptr[si].nvariants)) {
                let vi=DWord(dw_inputs[0].structs[0].ptr[si].variants) + v
                dw_tb.push(11)
                cstr(@dw_tb  dw_inputs[0].names[0].ptr[DWord(dw_inputs[0].variants[0].ptr[vi].name)])
                sleb(@dw_tb  dw_inputs[0].variants[0].ptr[vi].value)
            }
            dw_tb.push(0)
        }
        else {
            dw_tb.push(5)
            cstr(@dw_tb  dw_name(t))
            put32(@dw_tb  size)
            dw_member("tag"  DW_TAGS - t  0)
            # (each variant's fields, where they are: lib/debug's printers show the tag's)
            loop v in [0..min(DWord(dw_inputs[0].structs[0].ptr[si].nvariants)  256)) {
                let vi=DWord(dw_inputs[0].structs[0].ptr[si].variants) + v
                if DWord(dw_inputs[0].variants[0].ptr[vi].nfields) >? 0 {dw_member(dw_inputs[0].names[0].ptr[DWord(dw_inputs[0].variants[0].ptr[vi].name)]  DW_VARIANT - (256 * t + v)  DWord(dw_inputs[0].structs[0].ptr[si].payload_off))}
            }
            dw_tb.push(0)
        }
    }
    else if k =? 'tuple' {
        dw_tb.push(5)
        cstr(@dw_tb  dw_name(t))
        put32(@dw_tb  size)
        let off:DWord=0
        loop i in [0..DWord(dw_inputs[0].types[0].ptr[t].nargs)) {
            let e=dw_targ(t  i)
            off=dw_align_up(off  dw_talign(e))
            dw_member("{i}"  e  off)
            off += dw_tsize(e)
        }
        dw_tb.push(0)
    }
    else if k =? 'vec' {
        let n=DWord(dw_inputs[0].types[0].ptr[t].bits)
        let e=dw_inputs[0].T_F32[0]
        if dw_inputs[0].types[0].ptr[t].sign {e=dw_inputs[0].T_I32[0]}
        dw_tb.push(5)
        cstr(@dw_tb  dw_name(t))
        put32(@dw_tb  size)
        if n <=? 4 {
            loop i in [0..n) {dw_member(["x"  "y"  "z"  "w"][i]  e  4 * i)}
        }
        else {
            loop i in [0..n) {dw_member("m{i}"  e  4 * i)}
        }
        dw_tb.push(0)
    }
    else if k =? 'opt' {
        let e=DWord(dw_inputs[0].types[0].ptr[t].elem)
        dw_tb.push(5)
        cstr(@dw_tb  dw_name(t))
        put32(@dw_tb  size)
        dw_member("value"  e  0)
        dw_member("has"  dw_inputs[0].T_BOOL[0]  dw_tsize(e))
        dw_tb.push(0)
    }
    else if k =? 'fn_' {
        dw_tb.push(5)
        cstr(@dw_tb  dw_name(t))
        put32(@dw_tb  16)
        dw_member("code"  DW_VOIDP  0)
        dw_member("env"  DW_VOIDP  8)
        dw_tb.push(0)
    }
    else if k =? 'secret' {
        # (a secret: its bytes are not described, so a debugger shows none of them; lib/debug's
        # printers show `<redacted>`)
        dw_tb.push(17)
        cstr(@dw_tb  dw_name(t))
        put32(@dw_tb  size)
    }
    else if k =? 'fixed' {
        dw_tb.push(7)
        dw_ref(0  DWord(dw_inputs[0].types[0].ptr[t].elem))
        dw_tb.push(9)
        put32(@dw_tb  DWord(dw_inputs[0].types[0].ptr[t].bits))
        dw_tb.push(0)
    }
    else {
        # (what a debugger cannot show: its bytes, as a struct without fields)
        dw_tb.push(17)
        cstr(@dw_tb  dw_name(t))
        put32(@dw_tb  size)
    }
}
dw_breg=(@e:array<uint8> r:DWord off:DWord):>void=>$unsafe {
    if r <? 32 {e.push(uint8((0x70 + r) & 0xff))}
    else {
        e.push(0x92)
        uleb(@e  r)
    }
    sleb(@e  off)
}

# the variables of the function whose dbg_raw entry starts at k0, as a debugger shows them: each
# one's entry and whether it is a formal parameter. A Dewy value parameter's own binding
# (LF_VALUEPARAM) is the parameter in the source: it takes its hidden parameter's place, which
# stays only for an unchanged binding that has no location.
dbg_vars=(k0:DWord):>array<[int64 bool]>=>$unsafe {
    let raw=dw_inputs[0].dbg_raw[0].ptr
    let bindings=dw_inputs[0].locals[0].ptr
    let nv=raw[k0 + 4]
    let own:dict<int64 int64>=[] # name -> entry of the value parameter's own binding
    loop i in [0..nv) {
        let e=k0 + 5 + 6 * i
        if DWord(bindings[raw[e]].flags) & LF_VALUEPARAM not=? 0 {own[DWord(bindings[raw[e]].name)] = e}
    }
    let paired:dict<int64 bool>=[] # own bindings whose hidden parameter is listed
    loop i in [0..nv) {
        let e=k0 + 5 + 6 * i
        let fl=DWord(bindings[raw[e]].flags)
        if fl & (LF_PARAM | LF_MUTPARAM) =? LF_PARAM {
            let c=own.get(DWord(bindings[raw[e]].name))
            if c isnt? none {paired[c] = true}
        }
    }
    let out:array<[int64 bool]>=[]
    loop i in [0..nv) {
        let e=k0 + 5 + 6 * i
        let l=raw[e]
        let fl=DWord(bindings[l].flags)
        if fl & LF_VALUEPARAM not=? 0 {
            if not e in? paired {out.push([e  true])}
            continue
        }
        if fl & LF_PARAM =? 0 {
            out.push([e  false])
            continue
        }
        let c=e
        if fl & LF_MUTPARAM =? 0 {c=own.get(DWord(bindings[l].name)) ?? e}
        # (its own binding, unless that is unchanged and has no location)
        if c not=? e and(DWord(bindings[raw[c]].flags) & LF_ASSIGNED not=? 0 or raw[c + 4] <? raw[c + 5]) {e=c}
        out.push([e  true])
    }
    out
}

# a variable's place (x64.jo's dbg_function: kind, r, off) as a DWARF expression, at the end of e
dw_loc_expr=(@e:array<uint8> kind:DWord r:DWord off:DWord):>void=>$unsafe {
    if kind =? DL_REG {
        if r <? 32 {e.push(uint8((0x50 + r) & 0xff))}
        else {
            e.push(0x90)
            uleb(@e  r)
        }
    }
    else if kind =? DL_MEM {dw_breg(@e  r  off)}
    else if kind =? DL_MEMAT {
        dw_breg(@e  r  off)
        e.push(0x06) # DW_OP_deref
    }
    else if kind =? DL_ADDR {
        dw_breg(@e  r  off)
        e.push(0x9f) # DW_OP_stack_value
    }
    else if kind =? DL_CONST {
        e.push(0x11) # DW_OP_consts
        sleb(@e  off)
        e.push(0x9f)
    }
    else if kind =? DL_FCONST {
        e.push(0x9e) # DW_OP_implicit_value
        uleb(@e  r)
        loop i in [0..r) {e.push(uint8(((off >> ((8 * i) & 63)) & 255) & 0xff))}
    }
}
dw_prune=(t0:DWord):>DWord=>$unsafe {
    let info=dw_inputs[0].types[0].ptr
    let t=t0
    loop t not=? 0 and info[t].kind =? 'var' and info[t].ref not=? 0 {t=DWord(info[t].ref)}
    t
}
dw_tkind=(t:DWord):>TK=>$unsafe {
    dw_inputs[0].types[0].ptr[dw_prune(t)].kind
}
dw_targ=(t:DWord i:DWord):>DWord=>$unsafe {
    DWord(dw_inputs[0].type_args[0].ptr[DWord(dw_inputs[0].types[0].ptr[t].args) + i])
}
dw_tsize=(t:DWord):>DWord=>$unsafe {
    dw_inputs[0].host[0].layout(t)
    DWord(dw_inputs[0].types[0].ptr[dw_prune(t)].size)
}
dw_talign=(t:DWord):>DWord=>$unsafe {
    dw_inputs[0].host[0].layout(t)
    let a=DWord(dw_inputs[0].types[0].ptr[dw_prune(t)].align)
    if a =? 0 {return 1}
    a
}
dw_align_up=(x:DWord a:DWord):>DWord=>$unsafe {
    (x + a - 1) & ((a - 1) xor -1)
}
dw_pos_file=(p:DWord):>DWord=>$unsafe {
    p >> 40
}

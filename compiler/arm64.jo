use 'native_debug.dewy'
use 'elf_format.dewy'
use 'x64_module.dewy'
use 'x64_emit.dewy'
use 'x64_allocate.dewy'
use 'x64_encode.dewy'
use 'arm64_module.dewy'
use 'arm64_encode.dewy'
use 'arm64_emit.dewy'
use 'arm64_allocate.dewy'
use 'backend_analysis.dewy'
use 'ir_types.dewy'
# arm64 (AArch64) code generator: Linux on 64-bit ARM (`--target aarch64-linux`).
#
# The same IR as x64.jo and the same analysis (backend_analyze: lifetimes, loops, calls); registers are
# given by linear scan (a_allocate), a value without one lives in the frame and is loaded into a
# scratch register where used. Calls follow AAPCS64 (x0-x7 and v0-v7, the rest on the stack), for
# Sloppy functions and C functions alike.
#
# The frame, addressed from sp (which does not move inside a function):
#   [sp, sp + out)        arguments of calls that do not fit in registers
#   [sp + out, + 16)      scratch (ppoll's timespec)
#   then spilled values (8 bytes each), the slots, and the callee-saved registers this function
#   uses; x29/x30 are saved above, x29 points at them.
# Scratch registers: x9-x12 and x16/x17 (addresses, large offsets, indirect calls), d16-d18.
# Float constants are read from after the function's code (ldr literal), or are fmov immediates.

use 'util.jo'
use 'diagnostic_exit.dewy'
use 'ir.jo'
use 'lower.jo'
use 'types.jo'
use 'check.jo'
use 'ast.jo'
use 'x64.jo'
use 'x64_ops.dewy'
use 'fused.jo'
use 'arm64_ops.dewy'

# Bind the shared code-array variable once, including Mach-O/REPL users.
a_encoder_binding = arm64_encoder_bind(&code)
a_function_binding = arm64_function_bind(&ir)

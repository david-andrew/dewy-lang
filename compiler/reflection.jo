# Type-derived sequences specialize ordinary checked code; no source generation.
use 'check.jo'
use 'member_replay.jo'
use 'string_domains.jo'
use 'expr.jo'
use 'comptime.jo'
use 'ast.jo'
use 'types.jo'
use 'util.jo'
use 'lex.jo'
use 'refine.jo'
use 'node_store.dewy'

reflect_active = false

reflect_source = (e: int) -> int:
    if nodes[e].kind == .call and nkids(e) == 1:
        callee = int(nodes[e].a)
        if nodes[callee].kind == .ident and name_of(int(nodes[callee].name)) == "__dewy_iter": return kid(e, 0)
    e

id_fields = 0
id_members = 0
reflect_fields = (e: int) -> bool:
    if nodes[e].kind != .call: return false
    callee = int(nodes[e].a)
    if id_fields == 0:
        id_fields = intern("fields")
        id_members = intern("members")
    nodes[callee].kind == .ident and int(nodes[callee].name) == id_fields and dewy_at(nodes[e].pos) and lookup(id_fields) == 0

reflect_members = (e: int) -> bool:
    if nodes[e].kind != .call: return false
    callee = int(nodes[e].a)
    if id_members == 0: id_members = intern("members")
    nodes[callee].kind == .ident and int(nodes[callee].name) == id_members and dewy_at(nodes[e].pos) and lookup(id_members) == 0

# the literal members of a type (its string sets and integer singletons), each
# a checked literal whose type is its own singleton
literal_members = (t0: int, pos: int, out: mut int[], singletons: mut int[]):
    t = prune(t0)
    if is_union(t):
        # (a canonical order, as a union is a set: the integers rising, then the text in order)
        loop m in union_members(t):
            if str_set_of(m) == 0: literal_members(m, pos, out, singletons)
        loop m in union_members(t):
            if str_set_of(m) != 0: literal_members(m, pos, out, singletons)
        return
    set = str_set_of(t)
    if set != 0:
        loop value in str_sets[set].sorted():
            n = bc_str(value, pos)
            nodes[n].type = i32(T_STR)
            add_flag(n, NF_CHECKED)
            singletons.push(str_set_type([value]))
            out.push(n)
        return
    known, values = int_intervals(t)
    if not known or types[t].kind != .refined or values.len() > 64: fatal(pos, "members(U) needs a union of literals, found {dt(t)}")
    loop k in [0..values.len() / 2):
        if not small_span(values[2 * k], values[2 * k + 1], 64): fatal(pos, "members(U) needs a union of literals, found {dt(t)}")
        loop v in [values[2 * k]..values[2 * k + 1]]:
            n = bc_int(v, pos)
            nodes[n].type = i32(T_INT)
            add_flag(n, NF_CHECKED)
            singletons.push(mk_refined(T_INT, ref_intern([RefAtom(.le, RefTerm(1, v), RefTerm()), RefAtom(.le, RefTerm(), RefTerm(1, v))])))
            out.push(n)

# The leaves of `|` written as an expression: the text of string literals, the
# values of integer literals, and the types of the other members.
members_leaves = (e: int, texts: mut str[], ints: mut int[], others: mut int[]):
    k = nodes[e].kind
    if k == .binary and nodes[e].op == i32(int(Tok.pipe)):
        members_leaves(int(nodes[e].a), texts, ints, others)
        members_leaves(int(nodes[e].b), texts, ints, others)
    else if k == .str_lit and nodes[e].aux != 1:
        if not texts.contains(name_of(int(nodes[e].sval))): texts.push(name_of(int(nodes[e].sval)))
    else if k == .int_lit and not has_flag(e, NF_U64):
        if not ints.contains(nodes[e].ival): ints.push(nodes[e].ival)
    else if k == .unary and nodes[e].op == i32(int(Tok.minus)) and nodes[int(nodes[e].a)].kind == .int_lit and not has_flag(int(nodes[e].a), NF_U64):
        if not ints.contains(-nodes[int(nodes[e].a)].ival): ints.push(-nodes[int(nodes[e].a)].ival)
    else: others.push(members_type(e))

# integer singletons as one refined int, as in a type position: lo <= v <= hi, v != each gap
members_int_type = (values: int[], pos: int) -> int:
    lo = values[0]
    hi = values[0]
    loop v in values:
        lo = min(lo, v)
        hi = max(hi, v)
    if hi - lo < 0 or hi - lo - values.len() + 1 > 24: fatal(pos, "an integer singleton union with more than 24 missing values between its least and greatest members")
    atoms = [RefAtom(.le, RefTerm(1, lo), RefTerm()), RefAtom(.le, RefTerm(), RefTerm(1, hi))]
    loop g in [lo..hi]:
        if not values.contains(g): atoms.push(RefAtom(.ne, RefTerm(), RefTerm(1, g)))
    mk_refined(T_INT, ref_intern(atoms))

# members(U)'s type: a name, type syntax (`members(<'a' | 1>)`), or an inline
# union of literals parsed as an expression (`members('a' | 'b')`), which means
# what it means in a type position
members_type = (e: int) -> int:
    k = nodes[e].kind
    if k == .tname or k == .tunion or k == .trefined: return resolve_type(e)
    if k != .binary and k != .str_lit and k != .int_lit and k != .unary: return expr_as_type(e)
    texts: str[]
    ints: int[]
    others: int[]
    members_leaves(e, texts, ints, others)
    parts: int[]
    if ints.len() > 0: parts.push(members_int_type(ints, nodes[e].pos))
    if texts.len() > 0: parts.push(str_set_type(texts))
    parts += others
    if parts.len() == 1: return parts[0]
    mk_union(parts)

# members(U) used as a value is the array literal of U's members in the
# loop's order: an array<U>, unless its context gives the array a type.
members_literal = (n: int) -> int:
    pos = nodes[n].pos
    if nkids(n) != 1: fatal(pos, "members(U) needs one type")
    u = members_type(kid(n, 0))
    values: int[]
    singletons: int[]
    literal_members(u, pos, values, singletons)
    items: int[]
    loop value in values:
        if nodes[value].kind == .str_lit: items.push(bc_str(name_of(int(nodes[value].sval)), pos))
        else: items.push(bc_int(nodes[value].ival, pos))
    nodes[n] = Node(kind = .array, pos = pos)
    set_list(n, items)
    u

# (a call's callee may be `members`: a cheap test before reflect_members)
members_named = (a: int) -> bool: id_members == 0 or nodes[int(nodes[a].a)].name == i32(id_members)

# (an argument: the array literal, for the selected call's parameter to type)
members_argument = (a: int):
    if reflect_members(a) and not string_domain_members(a): members_literal(a)

members_array = (n: int, expected: int) -> int:
    u = members_literal(n)
    if expected != 0 and (tkind(expected) == .array or tkind(expected) == .fixed): return check_expr(n, expected)
    check_expr(n, mk_array(u))

# Scope nodes carry either a field-table index or a checked constant value.
reflect_sequence = (e: int, binder: int) -> int[]:
    let e = reflect_source(e)
    out: int[]
    if reflect_members(e):
        if nkids(e) != 1: fatal(nodes[e].pos, "members(U) needs one type")
        values: int[]
        singletons: int[]
        literal_members(members_type(kid(e, 0)), nodes[e].pos, values, singletons)
        loop i in 0.. and value in values:
            scope = mk(.reflect_scope, nodes[e].pos)
            nodes[scope].name = i32(binder)
            nodes[scope].a = i32(value)
            nodes[scope].aux2 = i32(singletons[i])
            out.push(scope)
    else if reflect_fields(e):
        if nkids(e) != 1: fatal(nodes[e].pos, "fields(T) needs one record type")
        t = prune(expr_as_type(kid(e, 0)))
        if tkind(t) != .struct_ or is_map_type(t): fatal(nodes[e].pos, "fields(T) needs a record type, found {dt(t)}")
        si = int(types[t].st)
        check_struct_fields(si)
        loop i in [0..int(structs[si].nfields)):
            scope = mk(.reflect_scope, nodes[e].pos)
            nodes[scope].name = i32(binder)
            nodes[scope].ival = int(structs[si].fields) + i
            nodes[scope].aux = 1
            out.push(scope)
    else:
        t = prune(check_expr(e, 0))
        checked = last_checked
        if tkind(t) != .array and tkind(t) != .fixed: fatal(nodes[e].pos, "a record loop needs fields(T) or a compile-time array")
        v = ct_values[ct_run(checked)]
        loop item in v.items:
            scope = mk(.reflect_scope, nodes[e].pos)
            nodes[scope].name = i32(binder)
            nodes[scope].a = i32(ct_literal(item, nodes[e].pos))
            out.push(scope)
    out

reflect_bind = (s: int):
    name = int(nodes[s].name)
    if nodes[s].aux == 1:
        push_scope_sym(name, new_sym(name, .reflected, nodes[s].ival, 0))
    else:
        initial = int(nodes[s].a)
        g = globals.len()
        # (a literal member is its own singleton: `return m` fits the union)
        t = if nodes[s].aux2 != 0: int(nodes[s].aux2) else: ntype(initial)
        globals.push(Global(name = i32(name), type = i32(t), init = i32(initial), mod = i32(cur_mod()), is_const = true, state = 2))
        push_scope_sym(name, new_sym(name, .const_, g, 0))

reflect_name = (n: int):
    e = int(nodes[n].b)
    if e == 0: return
    check_expr(e, T_STR)
    e = coerce(last_checked, T_STR)
    value = ct_values[ct_run(e)]
    if tkind(value.type) != .str_: fatal(nodes[n].pos, "an object's fields are fixed at compile time; `$field` needs a compile-time string (use a dictionary for runtime names)")
    nodes[n].name = i32(intern(value.s))
    nodes[n].b = 0

reflect_member = (n: int) -> bool:
    receiver = int(nodes[n].a)
    if nodes[receiver].kind != .ident: return false
    s = lookup(int(nodes[receiver].name))
    if s == 0 or syms[s].kind != .reflected: return false
    f = fields[int(syms[s].ref)]
    member = name_of(int(nodes[n].name))
    pos = nodes[n].pos
    if member == "name": nodes[n] = Node(kind = .str_lit, pos = pos, sval = f.name, type = i32(T_STR), flags = i32(NF_CHECKED))
    else if member == "type":
        name = intern("$field_type{int(f.type)}")
        push_scope_sym(name, new_sym(name, .type_, int(f.type), 0))
        nodes[n] = Node(kind = .ident, name = i32(name), pos = pos, type = i32(mk_typeval(int(f.type))))
        add_flag(n, NF_CHECKED)
    else: fatal(pos, "a field descriptor has .name and .type, not .{member}")
    last_checked = n
    true

reflect_jumps = (n: int) -> bool:
    if n == 0: return false
    k = nodes[n].kind
    if k == .break_ or k == .continue_: return true
    if k == .lambda: return false
    if reflect_jumps(int(nodes[n].a)) or reflect_jumps(int(nodes[n].b)) or reflect_jumps(kid_c(n)) or reflect_jumps(kid_d(n)): return true
    loop child in kids(n):
        if reflect_jumps(child): return true
    false

reflect_loop = (s: int) -> bool:
    it = reflect_source(int(nodes[s].a))
    if not reflect_fields(it) and not reflect_members(it): return false
    if nkids(s) != 1 or has_flag(s, NF_MUT): fatal(nodes[s].pos, "fields(T) and members(U) yield one immutable value per iteration")
    if reflect_members(it) and string_domain_members(it): return false
    binder = int(nodes[kid(s, 0)].name)
    scopes = reflect_sequence(it, binder)
    pos = nodes[s].pos
    index = "$field_iteration{s}"
    bodies: int[]
    jumping = reflect_jumps(int(nodes[s].b))
    if not jumping: member_prepare(scopes, int(nodes[s].b))
    loop i in [0..scopes.len()):
        scope = scopes[i]
        nodes[scope].b = i32(if i > 0 and member_scopes.has(scope): int(nodes[s].b) else: clone(int(nodes[s].b)))
        if jumping: bodies.push(bc_if(bc_bin(.eq, bc_ident(index, pos), bc_int(i, pos), pos), [scope], [], pos))
        else: bodies.push(scope)
    if not jumping:
        nodes[s] = nodes[bc_block(bodies, pos)]
        check_block(s, 0, false)
        return true
    # A counted dispatch retains ordinary break/continue (including labels),
    # while every iteration's code and member types are checked independently.
    range = mk(.range, pos)
    nodes[range].a = i32(bc_int(0, pos))
    nodes[range].b = i32(bc_int(scopes.len(), pos))
    nodes[s].a = i32(range)
    nodes[s].b = i32(bc_block(bodies, pos))
    set_list(s, [bc_ident(index, pos)])
    false

reflect_entries = (n: int, entries: mut int[]):
    if nodes[n].kind == .record_loop:
        scopes = reflect_sequence(int(nodes[n].a), int(nodes[n].name))
        loop scope in scopes:
            mark = scope_mark()
            reflect_bind(scope)
            active = reflect_active
            reflect_active = true
            reflect_entries(clone(int(nodes[n].b)), entries)
            reflect_active = active
            scope_reset(mark)
        return
    reflect_name(n)
    value = int(nodes[n].a)
    check_expr(value, 0)
    value = last_checked
    finalize_literal(value)
    add_flag(value, NF_CHECKED)
    nodes[n].a = i32(value)
    entries.push(n)

reflect_record = (n: int):
    entries: int[]
    reflect_entries(n, entries)
    nodes[n] = Node(kind = .record_lit, pos = nodes[n].pos)
    set_list(n, entries)

use 'checker_tokens.dewy'
# Contained paths, scoped by construction (docs/design/contained_paths.md).
#
# Two facts about the program's values, both found after checking, on the checked tree of the
# program's own functions (the library's are read only through their signatures):
#
# - SafePath, a brand on a Path: it does not escape its base. A SafePath is a Path (the library's
#   `type SafePath = Path`); the brand is this file's fact. A path is one when it is hardcoded,
#   built by interpolation from SafePaths, hardcoded text and proven-safe components (one
#   component: no `/`, not `.` or `..`, not empty, as an integer's digits), made by a validator
#   (a function whose result is written SafePath: `root.confine(p)`), or tested by the guard
#   (the path library's `contains`: `if root.contains(p) {...}`, or `if not root.contains(p)
#   return`). Passing anything else where a SafePath is declared (a parameter, a `let`, a result)
#   is a compile error with the fixes.
# - Traversal, a fact on a path or its text: it joins unproven text to a base (`p"{root}/{name}"`,
#   `"{dir}/{name}"`, `base + "/" + name`), so the text can climb out of the base. It is set where
#   such a value is built and follows what is computed from it: a record or collection holding
#   it, a field or element of one, a function's result, a parameter given it. A path taken whole
#   (`p(args()[1])`) has no base and never carries it. A function whose own parameter is the
#   unproven text (`path_for = (name:string) => p"{base}/{name}"`) builds a traversal only where a
#   call gives it unproven text. A fact is an origin and a mask of the function's parameters: bit
#   i (i < 31) holds what parameter i holds, bit 31 + i is set when parameter i's text is joined
#   to a base. A function's result is such a pair (its summary); a parameter keeps what callers
#   give it separately (a traversal, or unproven text).
#
# A call from the program's own code of a function with the soft precondition `$warn_if p isnt?
# SafePath "..."` (compiler/warn_if.jo: the file-system operations) warns when the path is not a
# SafePath and carries a traversal; under `$confine_external_paths`, when it is not a SafePath.
#
# Demand-driven: nothing runs unless the program names SafePath in its own code, or calls such a
# function. Cost: one walk of each of the program's own function bodies, plus one more walk of a
# body each time a fact it reads grows. Each fact (a local, a field, a global, a function's
# result, a parameter's incoming facts) only grows: its origin is set once and its mask gains at
# most a bit per parameter, so the walks are bounded by the bodies' size times (1 + the facts
# that reach them); in practice each body is walked once or twice. Indexed state throughout:
# facts and readers are maps keyed by local, field, global and function instance.
use 'check.jo'
use 'ast.jo'
use 'util.jo'
use 'types.jo'
use 'lex.jo'
use 'ide.jo'
use 'units.jo'
use 'expr.jo'
use 'refine.jo'
use 'directives.jo'
use 'warn_if.jo'

ut_safe_used = false        # the program's own code names SafePath (resolve_type)
ut_paths_used = false       # a call from the program's own code has a SafePath soft precondition
ut_safe_name = intern("SafePath")
ut_path_name = intern("Path")
ut_p_name = intern("p")
ut_contains_name = intern("contains")

const UT_HARD = 1           # text the program wrote (or computed from such text alone)
const UT_COMP = 2           # one proven-safe path component

const UT_GUARD = 4          # the path library's `contains`: true means its second argument is a
                            # SafePath
const UT_MINTS = 8          # its result is written SafePath: a validator (or a function whose
                            # returns are held to the brand)

const UT_PARAMS = 31        # parameters a mask follows
const UT_PASS = 2147483647  # bits 0..30: holds what parameter i holds
const UT_JOIN = 31          # bits 31..61: parameter i's text is joined to a base

ut_decl_kinds: {int: int} = {}
ut_param_safe: {int: int} = {}  # decl -> bit i: parameter i is written SafePath (computed once)

# facts: (origin position + 1), 0 when trusted; by local, sized at ut_run
ut_lo: int[]                        # local -> origin
ut_lm: int[]                        # local -> mask
ut_li: int[]                        # parameter local -> a traversal callers give it
ut_lu: int[]                        # parameter local -> unproven text callers give it
ut_lp: int[]                        # parameter local -> its index + 1
ut_lr: int[]                        # local -> the walk that last read it
ut_lf: int[]                        # local -> 1 when it has facts by field
ut_serial = 0                       # the current walk
ut_fu: int[]                        # function instance -> 1: the program's own, 2: not, 0: not known
ut_fk: int[]                        # function instance -> ut_decl_kind + 1, 0: not known
ut_global: {int: int} = {}
ut_ret: {int: int} = {}
ut_fields: {(int, int): int} = {}   # (local, field name) -> origin
ut_fmask: {(int, int): int} = {}
ut_rmask: {int: int} = {}
ut_field_names: {int: int[]} = {}   # local -> its fields in ut_fields
# who reads each fact (key id * 4 + kind; kind 0 local, 1 global, 2 result, 3 a parameter's
# incoming origin): lists threaded through ut_rfn/ut_rnext from ut_rhead[key]
ut_rhead: {int: int} = {}
ut_rfn: int[]
ut_rnext: int[]
ut_pairs: {int: bool} = {}          # key * 2^22 + function instance: listed
# a caller's parameter passed on as a callee's: incoming origins follow these after the walks
ut_ehead: int[]                     # parameter local -> its first edge, -1
ut_eto: int[]
ut_enext: int[]
ut_epairs: {int: bool} = {}
# a caller's parameter whose text a callee's parameter is given: unproven text follows these
ut_uhead: int[]                     # parameter local -> its first edge, -1
ut_uto: int[]
ut_unext: int[]
ut_upairs: {int: bool} = {}
ut_types: {int: int} = {}           # pruned type -> UT_T_* bits (types made during the run)
ut_tb: int[]                        # ... (types there when it started)
ut_queue: int[]
ut_queued: int[]                    # function instance -> 1 while queued
ut_walked: int[]                    # function instance -> 1 once walked
ut_rr: int[]                        # function instance -> the walk that last registered reading its result
ut_cur = 0                  # the function instance being walked
ut_first = false            # its first walk: obligations and sinks are looked at then
ut_origin_what: {int: str} = {}  # origin -> how it was built, for the warning

# SafePath facts of the program's own locals and globals (single assignment), and text classes
ut_ls: int[]                        # local -> UT_L_* bits
ut_safe_globals: {int: bool} = {}
ut_text_globals: {int: int} = {}
const UT_L_SAFE = 1                 # holds a SafePath
const UT_L_DECLARED = 2             # written `:SafePath`
const UT_L_HARD = 4                 # its text: UT_HARD << 2
const UT_L_COMP = 8                 # ... UT_COMP << 2
ut_narrowed: int[]          # locals a guard around the code being walked proved SafePath

ut_sink_calls: (int, int, int)[]  # (path argument, function instance it is in, the message's
                                  # declaration), first walks
ut_linit: int[]                     # single-assignment local -> its initializer (for the fixes' text)

ut_reset = ():
    ut_safe_used = false
    ut_paths_used = false
    ut_decl_kinds = {}
    ut_param_safe = {}
    ut_lo = []
    ut_lm = []
    ut_li = []
    ut_lu = []
    ut_lp = []
    ut_lr = []
    ut_lf = []
    ut_serial = 0
    ut_fu = []
    ut_fk = []
    ut_tb = []
    ut_types = {}
    ut_global = {}
    ut_ret = {}
    ut_fields = {}
    ut_fmask = {}
    ut_rmask = {}
    ut_field_names = {}
    ut_rhead = {}
    ut_rfn = []
    ut_rnext = []
    ut_pairs = {}
    ut_ehead = []
    ut_eto = []
    ut_enext = []
    ut_epairs = {}
    ut_uhead = []
    ut_uto = []
    ut_unext = []
    ut_upairs = {}
    ut_queue = []
    ut_queued = []
    ut_walked = []
    ut_rr = []
    ut_origin_what = {}
    ut_ls = []
    ut_safe_globals = {}
    ut_text_globals = {}
    ut_narrowed = []
    ut_sink_calls = []
    ut_linit = []

# resolve_type: a type name the program's own code writes
ut_note_type_name = (nm: int, pos: int):
    if nm == ut_safe_name and not ut_safe_used and not pos_in_lib(pos) and dewy_at(pos): ut_safe_used = true

ut_names_safe = (tn: int) -> bool:
    if tn == 0: return false
    k = nodes[tn].kind
    if k == .tname: return int(nodes[tn].name) == ut_safe_name and nkids(tn) == 0
    if k == .tunion or k == .topt:
        if ut_names_safe(int(nodes[tn].a)) or ut_names_safe(int(nodes[tn].b)): return true
        loop x in kids(tn):
            if ut_names_safe(x): return true
    false

ut_decl_kind = (d: int) -> int:
    if d == 0: return 0
    if let k = ut_decl_kinds.get(d): return k
    k = 0
    if nodes[d].kind == .fn_:
        if int(nodes[d].name) == ut_contains_name and nkids(d) == 2 and pos_in_lib(nodes[d].pos) and ut_names_path(int(nodes[kid(d, 0)].a)) and ut_names_path(int(nodes[kid(d, 1)].a)): k |= UT_GUARD
        if ut_names_safe(int(nodes[d].a)): k |= UT_MINTS
        mask = 0
        loop i in [0..min(nkids(d), 62)):
            if ut_names_safe(int(nodes[kid(d, i)].a)): mask |= 1 << i
        ut_param_safe[d] = mask
    ut_decl_kinds[d] = k
    k

ut_names_path = (tn: int) -> bool: tn != 0 and nodes[tn].kind == .tname and int(nodes[tn].name) == ut_path_name and nkids(tn) == 0

# what the function a call calls is, by instance (cached)
ut_callee_kind = (n: int) -> int:
    f = int(nodes[n].sym)
    if f <= 0 or f >= fns.len(): return 0
    if f < ut_fk.len() and ut_fk[f] != 0: return ut_fk[f] - 1
    k = ut_decl_kind(int(fns[f].decl))
    if f < ut_fk.len(): ut_fk[f] = k + 1
    k

ut_callee_decl = (n: int) -> int:
    f = int(nodes[n].sym)
    if f <= 0 or f >= fns.len(): return 0
    int(fns[f].decl)

ut_user_fn = (f: int) -> bool:
    if f <= 0 or f >= fns.len() or fns[f].state != 2 or fns[f].body == 0: return false
    if f < ut_fu.len() and ut_fu[f] != 0: return ut_fu[f] == 1
    b = int(fns[f].body)
    d = int(fns[f].decl)
    p = if d != 0: nodes[d].pos else: nodes[b].pos
    yes = p > 0 and dewy_at(p) and not pos_in_lib(p)
    if f < ut_fu.len(): ut_fu[f] = if yes: 1 else: 2
    yes

# ---------------- types ----------------

const UT_T_TEXT = 1         # a value of the type can hold text (only those can be joined to a base)
const UT_T_PATH = 2         # Path
const UT_T_COMP = 4         # its text is one safe component whatever the value: integers, floats,
                            # booleans, plain enums
const UT_T_KNOWN = 8

ut_type_bits = (t0: int) -> int:
    t = prune(t0)
    if t < ut_tb.len() and ut_tb[t] != 0: return ut_tb[t]
    if let b = ut_types.get(t): return b
    k = types[t].kind
    b = UT_T_KNOWN
    if k == .bool_ or k == .int_ or k == .float_: b |= UT_T_COMP
    else if k == .void_ or k == .quantity or k == .fn_ or k == .cfn or k == .range: b |= 0
    else if k == .enum_ and structs[int(types[t].st)].simple_enum:
        if str_set_of(t) == 0: b |= UT_T_COMP
    else if bundled_bigint_type(t): b |= UT_T_COMP
    else if not bundled_rational_type(t):
        b |= UT_T_TEXT
        if k == .struct_:
            d = int(structs[int(types[t].st)].decl)
            if d != 0 and int(nodes[d].name) == ut_path_name and pos_in_lib(nodes[d].pos): b |= UT_T_PATH
    if t < ut_tb.len(): ut_tb[t] = b
    else: ut_types[t] = b
    b

ut_is_path = (t0: int) -> bool: t0 != 0 and ut_type_bits(t0) & UT_T_PATH != 0
ut_text_type = (t0: int) -> bool: t0 == 0 or ut_type_bits(t0) & UT_T_TEXT != 0
ut_comp_type = (t0: int) -> bool: t0 != 0 and ut_type_bits(t0) & UT_T_COMP != 0

# a string-set (`'png' | 'jpg'`): text the program wrote (UT_HARD), each member one component
# (UT_COMP) or not; 0 for other types
ut_set_class = (t0: int) -> int:
    if t0 == 0: return 0
    id = str_set_of(t0)
    if id == 0: return 0
    loop m in str_sets[id]:
        if not ut_comp_text(m): return UT_HARD
    UT_HARD | UT_COMP

ut_comp_text = (s: str) -> bool:
    if len(s) == 0 or s == "." or s == "..": return false
    loop i in [0..len(s)):
        if s[i] == '/' or s[i] == '\\' or s[i] == 0: return false
    true

# ---------------- locals ----------------

# the variable a name stands for: through captures and narrowings
ut_root = (l0: int) -> int:
    l = l0
    loop n in [0..64):
        fl = int(locals[l].flags)
        if fl & LF_CAPTURE != 0 and locals[l].outer != 0: l = int(locals[l].outer)
        else if narrowed_var(l) != 0: l = narrowed_var(l)
        else: break
    l

ut_single = (l: int) -> bool: int(locals[l].flags) & LF_ASSIGNED == 0

ut_global_single = (g: int) -> bool: not globals[g].fn_written and not globals[g].init_written

# (a local's own function is its reader without an entry: the walk stamps what it read)
ut_read = (kind: int, id: int):
    if ut_cur == 0: return
    if kind == 0:
        ut_lr[id] = ut_serial
        if ut_owner(id) == ut_cur: return
    if kind == 2:
        if ut_rr[id] == ut_serial: return
        ut_rr[id] = ut_serial
    key = id * 4 + kind
    pair = key * 4194304 + ut_cur
    if ut_pairs.has(pair): return
    ut_pairs[pair] = true
    ut_rfn.push(ut_cur)
    ut_rnext.push(ut_rhead.get(key) ?? -1)
    ut_rhead[key] = ut_rfn.len() - 1

ut_wake = (kind: int, id: int):
    if kind == 0:
        # (the walk under way sees a local's later facts without starting over, unless it
        # already read the local: a loop carrying it)
        o = ut_owner(id)
        if o > 0 and (o != ut_cur or ut_lr[id] == ut_serial): ut_enqueue(o)
    i = ut_rhead.get(id * 4 + kind) ?? -1
    loop i >= 0:
        ut_enqueue(ut_rfn[i])
        i = ut_rnext[i]

ut_enqueue = (f: int):
    if ut_queued[f] != 0: return
    ut_queued[f] = 1
    ut_queue.push(f)

# Each fact is an origin (where a traversal was built, + 1, or 0) and a mask over the parameters
# of the function the local belongs to: bit i, it holds what parameter i holds; bit 31 + i,
# parameter i's text is joined to a base in it. A function's result is the same pair, so a
# call's result holds the arguments its mask names, and is a traversal where a joined argument
# is unproven: a helper given hardcoded text at one call and unproven text at another warns only
# at the second (a summary per function). What callers pass a parameter is its incoming facts,
# which a file-system call or a store into a global reads through the mask.

ut_owner = (l: int) -> int: int(locals[l].owner)

# the incoming origin of the first parameter of f that mask m names, or 0: a traversal it is
# given (bits 0..30), or unproven text given one joined to a base (bits 31..61)
ut_concrete = (f: int, m: int) -> int:
    if m == 0 or f <= 0 or f >= fns.len(): return 0
    loop i in 0.. and pl in fns[f].params:
        if i >= UT_PARAMS: break
        if m & (1 << i) != 0:
            ut_read(3, pl)
            if ut_li[pl] != 0: return ut_li[pl]
        if m & (1 << (UT_JOIN + i)) != 0:
            ut_read(3, pl)
            if ut_lu[pl] != 0: return ut_lu[pl]
    0

ut_mark_local = (l0: int, origin: int, mask: int):
    if l0 <= 0 or (origin == 0 and mask == 0): return
    l = ut_root(l0)
    o = origin
    m = mask
    if ut_owner(l) != ut_cur:
        # (a variable of the function around this one: what this one's parameters bring it
        # arrives along edges)
        if m & UT_PASS != 0: ut_edges(m & UT_PASS, l * 4)
        if o == 0: o = ut_concrete(ut_cur, m & ~UT_PASS)
        m = 0
    changed = false
    if o != 0 and ut_lo[l] == 0:
        ut_lo[l] = o
        changed = true
    old = ut_lm[l]
    if m & ~old != 0:
        ut_lm[l] = old | m
        changed = true
    if not changed: return
    ut_wake(0, l)

# a field of a local record: x.f holds it (and x as a whole need not)
ut_mark_field = (l0: int, field: int, origin: int, mask: int):
    if l0 <= 0 or (origin == 0 and mask == 0): return
    l = ut_root(l0)
    o = origin
    m = mask
    if ut_owner(l) != ut_cur:
        if o == 0: o = ut_concrete(ut_cur, m)
        m = 0
    key = (l, field)
    changed = false
    if not ut_fields.has(key) and not ut_fmask.has(key):
        ut_lf[l] = 1
        if let fs = ut_field_names.get(l):
            fs.push(field)
            ut_field_names[l] = fs
        else: ut_field_names[l] = [field]
    if o != 0 and (ut_fields.get(key) ?? 0) == 0:
        ut_fields[key] = o
        changed = true
    old = ut_fmask.get(key) ?? 0
    if m & ~old != 0:
        ut_fmask[key] = old | m
        changed = true
    if changed: ut_wake(0, l)

# a parameter given a traversal by a caller
ut_mark_in = (pl: int, origin: int):
    if origin == 0 or ut_li[pl] != 0: return
    ut_li[pl] = origin
    ut_wake(3, pl)

# a parameter given unproven text by a caller
ut_mark_unproven = (pl: int, origin: int):
    if origin == 0 or ut_lu[pl] != 0: return
    ut_lu[pl] = origin
    ut_wake(3, pl)

# what value v holds reaches local l: a record built in place, or another local, field by field
ut_flow = (l: int, v: int):
    x = ut_strip(v)
    if x != 0 and nodes[x].kind == .call and nodes[x].sym == 0 and nodes[x].aux == 2 and nodes[x].a == 0:
        t = prune(int(nodes[x].type))
        if types[t].kind == .struct_:
            st = int(types[t].st)
            if int(structs[st].nfields) == nkids(x):
                loop i in 0.. and part in kids(x):
                    o = ut_val(part)
                    ut_mark_field(l, int(fields[int(structs[st].fields) + i].name), o, ut_m)
                return
    if x != 0 and nodes[x].kind == .ident and nodes[x].aux == i32(int(SK.local)) and nodes[x].sym > 0:
        src = ut_root(int(nodes[x].sym))
        if ut_owner(src) == ut_cur and ut_lp[src] == 0 and ut_lo[src] == 0 and ut_lm[src] == 0:
            ut_read(0, src)
            if ut_lf[src] == 0: return
            if let fs = ut_field_names.get(src):
                loop f in fs: ut_mark_field(l, f, ut_fields.get((src, f)) ?? 0, ut_fmask.get((src, f)) ?? 0)
            return
    o = ut_val(v)
    ut_mark_local(l, o, ut_m)

ut_mark_global = (g: int, origin: int, mask: int):
    o = origin
    if mask & UT_PASS != 0 and ut_cur > 0: ut_edges(mask & UT_PASS, g * 4 + 1)
    if o == 0 and ut_cur > 0: o = ut_concrete(ut_cur, mask & ~UT_PASS)
    if o == 0 or ut_global.has(g): return
    ut_global[g] = o
    ut_wake(1, g)

ut_mark_ret = (f: int, origin: int, mask: int):
    changed = false
    if origin != 0 and not ut_ret.has(f):
        ut_ret[f] = origin
        changed = true
    old = ut_rmask.get(f) ?? 0
    if mask & ~old != 0:
        ut_rmask[f] = old | mask
        changed = true
    if changed: ut_wake(2, f)

# ---------------- traversal: a base joined to unproven text ----------------

ut_o = 0    # the value being read: its origin ...
ut_m = 0    # ... and the current function's parameters it holds

# n's value: its origin (also in ut_o), and the parameters it holds in ut_m
# the current function's parameters in mask m reach cell `to` (id * 4 + kind: 3 another
# function's parameter, 0 a local of an enclosing function, 1 a global)
ut_edges = (m: int, to: int):
    loop i in 0.. and src in fns[ut_cur].params:
        if i >= UT_PARAMS: break
        if m & (1 << i) != 0:
            pair = src * 4294967296 + to
            if ut_epairs.has(pair): continue
            ut_epairs[pair] = true
            ut_eto.push(to)
            ut_enext.push(ut_ehead[src])
            ut_ehead[src] = ut_eto.len() - 1

# incoming origins along the edges: true when one was added
ut_follow_edges = () -> bool:
    added = false
    uwork: int[]
    loop src in [0..ut_uhead.len()):
        if ut_uhead[src] >= 0 and ut_lu[src] != 0: uwork.push(src)
    loop uwork.len() > 0:
        src = uwork.pop()
        e = ut_uhead[src]
        loop e >= 0:
            to = ut_uto[e]
            if ut_lu[to] == 0:
                ut_mark_unproven(to, ut_lu[src])
                added = true
                uwork.push(to)
            e = ut_unext[e]
    work: int[]
    loop src in [0..ut_ehead.len()):
        if ut_ehead[src] >= 0 and ut_li[src] != 0: work.push(src)
    loop work.len() > 0:
        src = work.pop()
        e = ut_ehead[src]
        o = ut_li[src]
        loop e >= 0:
            to = ut_eto[e]
            id = to >> 2
            kind = to & 3
            if kind == 3 and ut_li[id] == 0:
                ut_mark_in(id, o)
                added = true
                work.push(id)
            else if kind == 0 and ut_lo[id] == 0:
                ut_lo[id] = o
                ut_wake(0, id)
                added = true
            else if kind == 1 and not ut_global.has(id):
                ut_global[id] = o
                ut_wake(1, id)
                added = true
            e = ut_enext[e]
    added

ut_val = (n: int) -> int:
    ut_o = 0
    ut_m = 0
    ut_acc(n)
    ut_o

# n's origin, or the incoming origin of a parameter it holds: is it a traversal at all
ut_traversal = (n: int) -> int:
    o = ut_val(n)
    if o != 0: return o
    ut_concrete(ut_cur, ut_m)

ut_add = (o: int, m: int):
    if ut_o == 0: ut_o = o
    ut_m |= m

# a local's fact, as the current function sees it
ut_add_local = (l: int, whole: bool, field: int):
    ut_read(0, l)
    m = 0
    o = ut_lo[l]
    if ut_owner(l) == ut_cur and ut_lp[l] != 0: m = 1 << (ut_lp[l] - 1)
    m |= ut_lm[l]
    if whole and ut_lf[l] != 0:
        if let fs = ut_field_names.get(l):
            loop f in fs:
                if o == 0: o = ut_fields.get((l, f)) ?? 0
                m |= ut_fmask.get((l, f)) ?? 0
    else if field != 0 and ut_lf[l] != 0:
        if o == 0: o = ut_fields.get((l, field)) ?? 0
        m |= ut_fmask.get((l, field)) ?? 0
    if ut_owner(l) != ut_cur:
        if o == 0: o = ut_concrete(ut_owner(l), m)
        m = 0
    ut_add(o, m)

# the origin (position + 1) of a traversal n's value may hold, and the parameters it holds or
# joins, added to ut_o and ut_m
ut_acc = (n: int):
    if n == 0: return
    t = int(nodes[n].type)
    if t != 0 and not ut_text_type(t): return
    k = nodes[n].kind
    if k == .str_lit:
        if nodes[n].aux == 0: return
        loop i in [0..nkids(n)): ut_acc(kid(n, i))
        ut_joined(kids(n), n)
        return
    if k == .binary and nodes[n].aux == 0 and nodes[n].op == i32(int(Tok.plus)) and prune(t) == T_STR:
        # (`base + "/" + name`: the pieces, as an interpolation's)
        pieces: int[]
        ut_pieces(n, pieces)
        loop x in pieces: ut_acc(x)
        ut_joined(pieces, n)
        return
    if k == .pair:
        ut_acc(int(nodes[n].a))
        return
    if k == .int_lit or k == .float_lit or k == .bool_lit or k == .none_lit or k == .null_lit or k == .lambda or k == .fnref or k == .unit_lit: return
    if k == .ident:
        if nodes[n].aux == i32(int(SK.local)) and nodes[n].sym > 0: ut_add_local(ut_root(int(nodes[n].sym)), true, 0)
        else if nodes[n].aux == i32(int(SK.global)):
            g = int(nodes[n].sym)
            ut_read(1, g)
            ut_add(ut_global.get(g) ?? 0, 0)
        return
    if k == .field:
        b = int(nodes[n].a)
        if b != 0 and nodes[b].kind == .ident and nodes[b].aux == i32(int(SK.local)) and nodes[b].sym > 0:
            ut_add_local(ut_root(int(nodes[b].sym)), false, int(nodes[n].name))
            return
        ut_acc(b)
        return
    if k == .call:
        d = ut_callee_decl(n)
        if d != 0:
            kind = ut_callee_kind(n)
            if kind & UT_MINTS != 0: return
            f = int(nodes[n].sym)
            if ut_user_fn(f):
                # (its result's own origin, the arguments its result holds, and the ones it joins
                # to a base: a traversal where the argument is unproven)
                ut_read(2, f)
                ut_add(ut_ret.get(f) ?? 0, 0)
                rm = ut_rmask.get(f) ?? 0
                if rm != 0:
                    loop i in [0..min(nkids(n), UT_PARAMS)):
                        if rm & (1 << (UT_JOIN + i)) != 0:
                            x = kid(n, i)
                            bits = ut_arg_bits(x)
                            if bits < 0: ut_add(ut_origin(n, "built by `{name_of(int(nodes[d].name))}`"), 0)
                            else: ut_add(0, bits)
                        if rm & (1 << i) != 0: ut_acc(kid(n, i))
                return
        # (a library function, a constructor, a conversion, a call of a function value: what its
        # arguments hold, and what the functions it is given return)
        ut_acc(int(nodes[n].a))
        loop i in [0..nkids(n)):
            x = kid(n, i)
            if nodes[x].kind == .lambda and nodes[x].sym > 0 and int(nodes[x].sym) < fns.len():
                lf = int(nodes[x].sym)
                ut_read(2, lf)
                ut_add(ut_ret.get(lf) ?? 0, 0)
            else: ut_acc(x)
        return
    if k == .if_:
        ut_acc(int(nodes[n].b))
        ut_acc(int(nodes[n].c))
        return
    if k == .block:
        ut_acc_block(n)
        return
    if k == .vardecl or k == .assign or k == .return_ or k == .break_ or k == .continue_ or k == .while_ or k == .for_: return
    # (anything else: what its parts hold)
    ut_acc(int(nodes[n].a))
    ut_acc(int(nodes[n].b))
    ut_acc(int(nodes[n].c))
    loop i in [0..nkids(n)): ut_acc(kid(n, i))

# a block's value: its last expression
ut_acc_block = (b: int):
    m = nkids(b)
    if m == 0: return
    last = kid(b, m - 1)
    if nodes[last].kind == .exprstmt: ut_acc(int(nodes[last].a))
    else if nodes[last].kind == .if_ or nodes[last].kind == .block or nodes[last].kind == .match_: ut_acc(last)

# (the pieces of a string sum, left to right)
ut_pieces = (n: int, out: mut int[]):
    if nodes[n].kind == .binary and nodes[n].aux == 0 and nodes[n].op == i32(int(Tok.plus)) and prune(int(nodes[n].type)) == T_STR:
        ut_pieces(int(nodes[n].a), out)
        ut_pieces(int(nodes[n].b), out)
        return
    if nodes[n].kind == .str_lit and nodes[n].aux != 0:
        loop x in kids(n): out.push(x)
        return
    out.push(n)

ut_origin = (n: int, what: str) -> int:
    o = nodes[n].pos + 1
    if not ut_origin_what.has(o): ut_origin_what[o] = what
    o

# how origin o was built, seen from a warning at p: "built from unproven text on line 8"
ut_origin_text = (o: int, p: int) -> str:
    l, c = line_col(o - 1)
    at = "line {l}"
    if pos_file(o - 1) != pos_file(p):
        path = files[pos_file(o - 1)].path
        k = rfind(path, "/")
        at = "{at} of {path[k + 1..]}"
    "{ut_origin_what.get(o) ?? "built from unproven text"} on {at}"

# The pieces of a path's text, as written (n: the interpolation or sum): a piece of unproven
# text after a base (a separator after something, or a path) makes a traversal. Text the
# program wrote, a proven-safe component and a SafePath are proven; a piece that is this
# function's own parameter (or a field of one) is decided at each call instead.
ut_joined = (pieces: int[], n: int):
    based = false
    seen = false
    loop part in pieces:
        if nodes[part].kind == .str_lit and nodes[part].aux == 0:
            if based: continue
            s = name_of(int(nodes[part].sval))
            if len(s) == 0: continue
            at = find_byte(s, '/')
            back = find_byte(s, '\\')
            if at < 0 or back >= 0 and back < at: at = back
            if at < 0:
                seen = true
                continue
            # (a separator after something: a base; one leading the text starts it only when
            # more follows it, then a separator)
            if seen or at > 0:
                based = true
                continue
            loop i in [0..len(s)):
                if s[i] == '/' or s[i] == '\\':
                    if seen: based = true
                else: seen = true
            continue
        v = part
        if nodes[v].kind == .pair: v = int(nodes[v].a)
        vt = int(nodes[v].type)
        if based:
            proven = true
            if ut_is_path(vt): proven = ut_safe(v)
            else if not ut_comp_type(vt):
                c = ut_set_class(vt)
                if c == 0: c = ut_text_class(v)
                proven = c != 0
            if not proven:
                q = ut_param_of(v)
                if q > 0: ut_add(0, 1 << (UT_JOIN + q - 1))
                else: ut_add(ut_origin(n, "built from unproven text"), 0)
        if ut_is_path(vt): based = true
        seen = true

# the parameter (index + 1) of the function being walked that x is, or a field of: 0 for none
# (and for a lambda's, whose calls are not seen)
ut_param_of = (x0: int) -> int:
    x = ut_strip(x0)
    loop x != 0 and nodes[x].kind == .field: x = ut_strip(int(nodes[x].a))
    if x == 0 or nodes[x].kind != .ident or nodes[x].aux != i32(int(SK.local)) or nodes[x].sym <= 0: return 0
    l = ut_root(int(nodes[x].sym))
    # (a binding the body starts with for a parameter: `name = name`)
    loop k in [0..4):
        if ut_lp[l] != 0 or not ut_single(l) or ut_linit[l] == 0: break
        y = ut_strip(ut_linit[l])
        if y == 0 or nodes[y].kind != .ident or nodes[y].aux != i32(int(SK.local)) or nodes[y].sym <= 0: break
        l = ut_root(int(nodes[y].sym))
    if ut_owner(l) != ut_cur or ut_lp[l] == 0 or ut_lp[l] > UT_PARAMS or fns[ut_cur].kind == i32(FK_LAMBDA): return 0
    ut_lp[l]

# An argument's text: -1 when it is not proven, else the bits (31 + i) of this function's
# parameters whose text is in it unproven (0: proven). `"{name}.tmp"`, name a parameter, is
# unproven only where name is.
ut_arg_bits = (x0: int) -> int:
    x = ut_strip(x0)
    if not ut_unproven_arg(x0): return 0
    q = ut_param_of(x0)
    if q > 0: return 1 << (UT_JOIN + q - 1)
    if x == 0 or nodes[x].kind != .str_lit or nodes[x].aux == 0: return -1
    bits = 0
    loop part in kids(x):
        if nodes[part].kind == .str_lit and nodes[part].aux == 0: continue
        v = part
        if nodes[v].kind == .pair: v = int(nodes[v].a)
        b = ut_arg_bits(v)
        if b < 0: return -1
        bits |= b
    bits

# an argument whose text is not proven: not hardcoded, not one safe component, not a SafePath
ut_unproven_arg = (x: int) -> bool:
    t = int(nodes[x].type)
    if ut_is_path(t): return not ut_safe(x)
    if ut_comp_type(t): return false
    c = ut_set_class(t)
    if c == 0: c = ut_text_class(x)
    c == 0

# ---------------- SafePath: proven not to escape its base ----------------

# (through the conversions the checker wraps a value in)
ut_strip = (n0: int) -> int:
    n = n0
    loop i in [0..32):
        if n == 0: return 0
        k = nodes[n].kind
        if k == .conv or k == .narrow or k == .unwrap or k == .cast: n = int(nodes[n].a)
        else if k == .call and nodes[n].sym == 0 and nodes[n].aux == 3 and nkids(n) == 1: n = kid(n, 0)
        else if k == .block and nodes[n].aux != 0 and nkids(n) > 0 and nodes[kid(n, nkids(n) - 1)].kind == .exprstmt: n = int(nodes[kid(n, nkids(n) - 1)].a)
        else: return n
    n

ut_safe = (n0: int) -> bool:
    n = ut_strip(n0)
    if n == 0: return false
    k = nodes[n].kind
    if k == .call:
        d = ut_callee_decl(n)
        if d == 0: return false
        if ut_decl_kind(d) & UT_MINTS != 0: return true
        if int(nodes[d].name) == ut_p_name and pos_in_lib(nodes[d].pos) and nkids(n) == 1: return ut_safe_text(kid(n, 0))
        return false
    if k == .ident:
        if nodes[n].aux == i32(int(SK.local)) and nodes[n].sym > 0:
            l = int(nodes[n].sym)
            r = ut_root(l)
            if (ut_ls[l] | ut_ls[r]) & UT_L_SAFE != 0 or ut_narrowed.contains(r): return true
            return false
        if nodes[n].aux == i32(int(SK.global)): return ut_safe_globals.has(int(nodes[n].sym))
        return false
    if k == .if_: return nodes[n].c != 0 and ut_safe(int(nodes[n].b)) and ut_safe(int(nodes[n].c))
    false

# the text p(...) is given makes a SafePath: hardcoded, or an interpolation whose components
# are each hardcoded, SafePaths with hardcoded text, or proven-safe components with hardcoded
# text (a component never joins a dynamic part to a path's last part: `{root}{name}` would leave
# root through a sibling)
ut_safe_text = (n0: int) -> bool:
    n = ut_strip(n0)
    if n == 0: return false
    if nodes[n].kind != .str_lit or nodes[n].aux == 0: return ut_text_class(n) & UT_HARD != 0
    has_path = false
    has_dyn = false
    loop part in kids(n):
        if nodes[part].kind == .str_lit and nodes[part].aux == 0:
            s = name_of(int(nodes[part].sval))
            if find_byte(s, '/') >= 0 or find_byte(s, '\\') >= 0:
                # (a separator ends the component: what follows it starts the next)
                if has_path and has_dyn: return false
                has_path = false
                has_dyn = false
            continue
        v = part
        if nodes[v].kind == .pair: v = int(nodes[v].a)
        vt = int(nodes[v].type)
        if ut_is_path(vt):
            if not ut_safe(v): return false
            has_path = true
        else if ut_comp_type(vt): has_dyn = true
        else:
            # (text the program wrote is trusted as a literal piece is)
            c = ut_set_class(vt)
            if c == 0: c = ut_text_class(v)
            if c & UT_HARD != 0: continue
            if c & UT_COMP != 0: has_dyn = true
            else: return false
    not (has_path and has_dyn)

# what is known of a string's text: UT_HARD, UT_COMP, both, or neither
ut_text_class = (n0: int) -> int:
    n = ut_strip(n0)
    if n == 0: return 0
    k = nodes[n].kind
    if k == .str_lit:
        if nodes[n].aux == 0:
            s = name_of(int(nodes[n].sval))
            return UT_HARD | (if ut_comp_text(s): UT_COMP else: 0)
        hard = true
        comp = true
        dyn = false
        text = ""
        loop part in kids(n):
            if nodes[part].kind == .str_lit and nodes[part].aux == 0:
                s = name_of(int(nodes[part].sval))
                text += s
                if find_byte(s, '/') >= 0 or find_byte(s, '\\') >= 0 or find_byte(s, 0) >= 0: comp = false
                continue
            v = part
            if nodes[v].kind == .pair: v = int(nodes[v].a)
            vt = int(nodes[v].type)
            c = 0
            if ut_comp_type(vt): c = UT_COMP
            else:
                c = ut_set_class(vt)
                if c == 0: c = ut_text_class(v)
            if c & UT_HARD == 0: hard = false
            if c & UT_COMP == 0: comp = false
            else: dyn = true
        # (literal pieces alone must be a component themselves; a dynamic component in it is
        # never `.` and keeps the whole from being `.`, `..` or empty)
        if comp and not dyn and not ut_comp_text(text): comp = false
        return (if hard: UT_HARD else: 0) | (if comp: UT_COMP else: 0)
    if k == .ident:
        if nodes[n].aux == i32(int(SK.local)) and nodes[n].sym > 0:
            l = int(nodes[n].sym)
            return ((ut_ls[l] | ut_ls[ut_root(l)]) >> 2) & 3
        if nodes[n].aux == i32(int(SK.global)): return ut_text_globals.get(int(nodes[n].sym)) ?? 0
        return 0
    if k == .if_ and nodes[n].c != 0: return ut_text_class(int(nodes[n].b)) & ut_text_class(int(nodes[n].c))
    0

# ---------------- guards ----------------

# the locals condition c proves SafePath when it is true
ut_guarded = (c: int, out: mut int[]):
    if c == 0: return
    k = nodes[c].kind
    if k == .and_:
        ut_guarded(int(nodes[c].a), out)
        ut_guarded(int(nodes[c].b), out)
        return
    if k == .call and nkids(c) == 2:
        d = ut_callee_decl(c)
        if d == 0 or ut_decl_kind(d) & UT_GUARD == 0: return
        a = ut_strip(kid(c, 1))
        if nodes[a].kind == .ident and nodes[a].aux == i32(int(SK.local)) and nodes[a].sym > 0:
            l = ut_root(int(nodes[a].sym))
            if ut_single(l): out.push(l)

# `if not root.contains(p) return ...` (no else): the locals proven for the rest of the block
ut_guard_exit = (s: int, out: mut int[]):
    if nodes[s].kind != .if_ or nodes[s].c != 0: return
    c = int(nodes[s].a)
    if nodes[c].kind != .not_: return
    if not ut_exits(int(nodes[s].b)): return
    ut_guarded(int(nodes[c].a), out)

ut_exits = (b: int) -> bool:
    if b == 0: return false
    k = nodes[b].kind
    if k == .return_ or k == .break_ or k == .continue_: return true
    if k == .block:
        m = nkids(b)
        return m > 0 and ut_exits(kid(b, m - 1))
    if k == .exprstmt: return ut_exits(int(nodes[b].a))
    if k == .call and nodes[b].type != 0 and prune(int(nodes[b].type)) == T_NEVER: return true
    false

# ---------------- the walk ----------------

ut_walk_fn = (f: int):
    ut_cur = f
    ut_serial += 1
    ut_first = ut_walked[f] == 0
    ut_walked[f] = 1
    ut_narrowed = []
    if ut_first:
        loop i in 0.. and pl in fns[f].params:
            if i < UT_PARAMS: ut_lp[pl] = i + 1
    d = int(fns[f].decl)
    if ut_first and d != 0 and nodes[d].kind == .fn_:
        ut_decl_kind(d)
        mask = ut_param_safe.get(d) ?? 0
        loop i in 0.. and l in fns[f].params:
            if i < 62 and mask & (1 << i) != 0:
                ut_ls[l] |= UT_L_SAFE | UT_L_DECLARED
    b = int(fns[f].body)
    if nodes[b].kind == .block:
        ut_visit(b)
        # (a value block: its last expression is the result)
        m = nkids(b)
        if nodes[b].aux != 0 and m > 0 and nodes[kid(b, m - 1)].kind == .exprstmt: ut_returned(int(nodes[kid(b, m - 1)].a))
    else:
        ut_visit(b)
        ut_returned(b)
    ut_cur = 0

# a value f returns
ut_returned = (v: int):
    o = ut_val(v)
    ut_mark_ret(ut_cur, o, ut_m)
    if not ut_first or not ut_safe_used: return
    d = int(fns[ut_cur].decl)
    if d == 0 or nodes[d].kind != .fn_ or ut_decl_kind(d) & UT_MINTS == 0: return
    inner = ut_strip(v)
    if inner == 0 or not ut_is_path(int(nodes[inner].type)) or ut_safe(inner): return
    ut_unproven(v, "{name_of(int(nodes[d].name))} returns a SafePath")

ut_visit_list = (b: int):
    mark = ut_narrowed.len()
    loop i in [0..nkids(b)):
        x = kid(b, i)
        ut_visit(x)
        if nodes[x].kind == .if_: ut_guard_exit(x, ut_narrowed)
    ut_narrowed.truncate(mark)

ut_visit = (n: int):
    if n == 0: return
    k = nodes[n].kind
    if k == .lambda or k == .fn_ or k == .struct_ or k == .enum_ or k == .typealias or k == .tname or k == .fnref: return
    if k == .block:
        ut_visit_list(n)
        return
    if k == .vardecl:
        v = int(nodes[n].b)
        ut_visit(v)
        id = int(nodes[n].sym)
        if v == 0 or id <= 0: return
        global = ut_global_decl(n, id)
        o = ut_val(v)
        m = ut_m
        if global:
            ut_mark_global(id, o, m)
            if ut_first and ut_global_single(id):
                if ut_is_path(int(globals[id].type)) and ut_safe(v): ut_safe_globals[id] = true
                else if prune(int(globals[id].type)) == T_STR:
                    c = ut_text_class(v)
                    if c != 0: ut_text_globals[id] = c
            return
        if o != 0 or m != 0: ut_flow(id, v)
        if not ut_first: return
        if ut_names_safe(int(nodes[n].a)) and nodes[n].aux2 != 1:
            ut_ls[id] |= UT_L_DECLARED
            if not ut_safe(v): ut_unproven(v, "`{name_of(int(nodes[n].name))}` is declared a SafePath")
        if ut_single(id):
            ut_linit[id] = v
            if ut_safe(v): ut_ls[id] |= UT_L_SAFE
            lt = int(locals[id].type)
            if prune(lt) == T_STR:
                c = ut_text_class(v)
                ut_ls[id] |= c << 2
        return
    if k == .assign:
        ut_visit(int(nodes[n].a))
        ut_visit(int(nodes[n].b))
        target = int(nodes[n].a)
        field = 0
        loop target != 0 and (nodes[target].kind == .field or nodes[target].kind == .index):
            field = if nodes[target].kind == .field: int(nodes[target].name) else: 0
            target = int(nodes[target].a)
        if target == 0 or nodes[target].kind != .ident: return
        o = ut_val(int(nodes[n].b))
        m = ut_m
        if nodes[target].aux == i32(int(SK.local)) and nodes[target].sym > 0:
            l = int(nodes[target].sym)
            if o != 0 or m != 0:
                # (`x.f = v`: that field; `x = v`: all of it; an element: all of it)
                if field != 0: ut_mark_field(l, field, o, m)
                else if target == int(nodes[n].a): ut_flow(l, int(nodes[n].b))
                else: ut_mark_local(l, o, m)
            if ut_first and target == int(nodes[n].a) and (ut_ls[l] | ut_ls[ut_root(l)]) & UT_L_DECLARED != 0 and not ut_safe(int(nodes[n].b)):
                ut_unproven(int(nodes[n].b), "`{name_of(int(nodes[target].name))}` is declared a SafePath")
        else if nodes[target].aux == i32(int(SK.global)):
            ut_mark_global(int(nodes[target].sym), o, m)
        return
    if k == .return_:
        ut_visit(int(nodes[n].a))
        if nodes[n].a != 0: ut_returned(int(nodes[n].a))
        return
    if k == .if_:
        ut_visit(int(nodes[n].a))
        mark = ut_narrowed.len()
        ut_guarded(int(nodes[n].a), ut_narrowed)
        ut_visit(int(nodes[n].b))
        ut_narrowed.truncate(mark)
        ut_visit(int(nodes[n].c))
        return
    if k == .call:
        ut_visit(int(nodes[n].a))
        loop i in [0..nkids(n)): ut_visit(kid(n, i))
        ut_call(n)
        return
    if (k == .for_ or k == .match_) and nodes[n].sym > 0:
        # (the loop's variable holds the elements; the arms' bindings hold what is matched)
        o = ut_val(int(nodes[n].a))
        ut_mark_local(int(nodes[n].sym), o, ut_m)
    ut_visit(int(nodes[n].a))
    ut_visit(int(nodes[n].b))
    # (a checked loop's c and d are locals, a partial's d a function instance: not nodes)
    if k != .for_:
        ut_visit(int(nodes[n].c))
        if k != .partial: ut_visit(int(nodes[n].d))
    loop i in [0..nkids(n)): ut_visit(kid(n, i))
    if k != .match_ and k != .fn_:
        loop i in [0..nkids2(n)): ut_visit(kid2(n, i))

# (a vardecl among a module's top-level statements declares a global)
ut_global_decl = (s: int, id: int) -> bool:
    fns[ut_cur].kind == i32(FK_INIT) and id < globals.len() and int(globals[id].decl) == s

ut_call = (n: int):
    f = int(nodes[n].sym)
    d = ut_callee_decl(n)
    if d == 0: return
    ut_callee_kind(n)
    na = nkids(n)
    if ut_user_fn(f):
        # (what each argument holds reaches the parameter, and whether its text is proven)
        loop i in [0..min(na, fns[f].params.len(), UT_PARAMS)):
            pl = int(fns[f].params[i])
            if not ut_text_type(int(locals[pl].type)): continue
            x = kid(n, i)
            o = ut_val(x)
            m = ut_m
            if o != 0: ut_mark_in(pl, o)
            if m & UT_PASS != 0: ut_edges(m & UT_PASS, pl * 4 + 3)
            if m & ~UT_PASS != 0: ut_mark_in(pl, ut_concrete(ut_cur, m & ~UT_PASS))
            # (what is proven of the argument's text is known on the first walk)
            if not ut_first: continue
            bits = ut_arg_bits(x)
            if bits < 0: ut_mark_unproven(pl, ut_origin(x, "unproven text given to `{name_of(int(nodes[d].name))}`"))
            else if bits != 0:
                # (this function's own parameters: what their callers give them follows, along edges)
                loop j in 0.. and src in fns[ut_cur].params:
                    if j >= UT_PARAMS: break
                    if bits & (1 << (UT_JOIN + j)) == 0: continue
                    pair = src * 4294967296 + pl
                    if ut_upairs.has(pair): continue
                    ut_upairs[pair] = true
                    ut_uto.push(pl)
                    ut_unext.push(ut_uhead[src])
                    ut_uhead[src] = ut_uto.len() - 1
                    if ut_lu[src] != 0: ut_mark_unproven(pl, ut_lu[src])
    if not ut_first: return
    if ut_safe_used:
        mask = ut_param_safe.get(d) ?? 0
        if mask != 0 and not pos_in_lib(nodes[n].pos):
            loop i in [0..min(na, 62)):
                x = kid(n, i)
                if mask & (1 << i) != 0 and not ut_safe(x):
                    pn = name_of(int(nodes[kid(d, i)].name))
                    ut_unproven(x, "{name_of(int(nodes[d].name))}'s `{pn}` is a SafePath")
    # (a soft precondition `x isnt? SafePath`: decided once the facts settle, unless proven here)
    if ut_paths_used and wi_decls.has(d):
        loop w in wi_decls[d]:
            if w.kind != WI_PATH or w.param >= na: continue
            x = kid(n, w.param)
            safe = if w.wrapped: ut_safe_text(x) else: ut_safe(x)
            if not safe: ut_sink_calls.push((x, ut_cur, d))

# ---------------- diagnostics ----------------

# the source text of a simple argument (a name, or a field of one), or ""
ut_arg_text = (x0: int) -> str:
    x = ut_strip(x0)
    if x == 0: return ""
    if nodes[x].kind == .ident:
        nm = name_of(int(nodes[x].name))
        if len(nm) > 0 and nm[0] != '$': return nm
        return ""
    if nodes[x].kind == .field:
        b = ut_arg_text(int(nodes[x].a))
        if len(b) > 0: return "{b}.{name_of(int(nodes[x].name))}"
    ""

# the base a path argument was built on (`{root}/...`: root), for the fix; "root" when unknown
ut_base_text = (x0: int) -> str:
    x = ut_strip(x0)
    if x != 0 and nodes[x].kind == .ident and nodes[x].aux == i32(int(SK.local)) and nodes[x].sym > 0:
        # (a local made by p"{root}/...": its initializer)
        l = ut_root(int(nodes[x].sym))
        if ut_linit[l] != 0: x = ut_strip(ut_linit[l])
    if x != 0 and nodes[x].kind == .call and nkids(x) == 1:
        s = ut_strip(kid(x, 0))
        if nodes[s].kind == .str_lit and nodes[s].aux != 0 and nkids(s) > 0:
            first = kid(s, 0)
            if nodes[first].kind == .pair:
                v = ut_strip(int(nodes[first].a))
                if ut_is_path(int(nodes[v].type)):
                    t = ut_arg_text(v)
                    if len(t) > 0: return t
    "root"


# (the fixes, as the editor offers them: lsp.jo reads the first)
ut_fixes = (x: int) -> str:
    arg = ut_arg_text(x)
    base = ut_base_text(x)
    fix = if len(arg) > 0: arg else: "..."
    "validate it, `{base}.confine({fix}) or_throw`, or test it first, `if {base}.contains({fix}) \{...}`"

ut_shown = (x: int) -> str:
    arg = ut_arg_text(x)
    if len(arg) > 0: "`{arg}`" else: "this path"

ut_unproven = (x: int, what: str):
    fatal(nodes[x].pos, "{ut_shown(x)} is not proven to stay inside its base, but {what}: {ut_fixes(x)}")

ut_warn_sinks = ():
    seen: {int: bool} = {}
    loop item in ut_sink_calls:
        x = item.0
        if seen.has(x): continue
        seen[x] = true
        ut_cur = item.1
        o = ut_traversal(x)
        ut_cur = 0
        message = ""
        loop w in wi_decls[item.2]:
            if w.kind == WI_PATH: message = w.message
        if o != 0:
            warn(nodes[x].pos, "{ut_shown(x)} {message} ({ut_origin_text(o, nodes[x].pos)}): {ut_fixes(x)}")
        else if dir_confine_paths(nodes[x].pos):
            warn(nodes[x].pos, "{ut_shown(x)} is not proven to stay inside a base, which `$confine_external_paths` asks of every path a file-system operation gets: {ut_fixes(x)}, or opt this scope out with `$confine_external_paths=false`")

# check_program, once every function is checked
ut_run = ():
    taint = ut_paths_used
    if not ut_safe_used and not taint: return
    n = locals.len() + 1
    ut_lo = fill(0, n)
    ut_lm = fill(0, n)
    ut_li = fill(0, n)
    ut_lu = fill(0, n)
    ut_lp = fill(0, n)
    ut_lr = fill(0, n)
    ut_lf = fill(0, n)
    ut_ls = fill(0, n)
    ut_linit = fill(0, n)
    ut_queued = fill(0, fns.len() + 1)
    ut_walked = fill(0, fns.len() + 1)
    ut_rr = fill(0, fns.len() + 1)
    ut_ehead = fill(-1, n)
    ut_uhead = fill(-1, n)
    ut_fu = fill(0, fns.len() + 1)
    ut_fk = fill(0, fns.len() + 1)
    ut_tb = fill(0, types.len() + 1)
    # (module initializers first: globals are declared there)
    order: int[]
    loop mi in [0..modules.len()):
        if modules[mi].is_prelude: continue
        f = int(modules[mi].init_fn)
        if f > 0 and f < fns.len() and fns[f].body != 0 and dewy_at(nodes[int(fns[f].body)].pos) and not pos_in_lib(nodes[int(fns[f].body)].pos): order.push(f)
    # (callees are mostly instantiated after their callers: the latest first, so results are
    # known before their calls are walked)
    f = fns.len() - 1
    loop f >= 1:
        if fns[f].kind != i32(FK_INIT) and ut_user_fn(f): order.push(f)
        f -= 1
    loop f0 in order: ut_enqueue(f0)
    i = 0
    loop true:
        loop i < ut_queue.len():
            f = ut_queue[i]
            i += 1
            ut_queued[f] = 0
            ut_walk_fn(f)
            if not taint and i >= order.len(): break
        if not taint or not ut_follow_edges(): break
    if taint: ut_warn_sinks()
    ut_sink_calls = []

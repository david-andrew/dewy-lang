$runtime_checks
from p"node_store.dewy" import Node
from p"checker_types.dewy" import TypeInfo
from p"checker_state.dewy" import CheckerScope
from p"type_inference.dewy" import tu_prune
from p"checker_coerce.dewy" import cq_settled
from p"checker_expr.dewy" import check_expr
from p"expr.jo" import (coerce op_overload narrow_by logic_mask logic_broadcast)
from p"types.jo" import simple_enum
from p"check.jo" import scope_reset
# Logical expressions own operand order, integer rewrites and narrowing lifetime.
# Work follows only demanded operands and existing scope rollback; arena elements
# are reacquired after each reentrant semantic service.
XGWord:type=int64<overflow='wrap'>
CheckerLogicInput:type=[
    nodes:ptr<array<Node>>
    types:ptr<array<TypeInfo>>
    scopes:ptr<CheckerScope>
    last:ptr<int64>
    bool_type:ptr<int64>
]
let xg_input:ptr<CheckerLogicInput>=$unsafe (uint64(0) as ptr<CheckerLogicInput>)
checker_logic_bind=(input:ptr<CheckerLogicInput>):>XGWord=>{xg_input=input;0}
CheckerLogicResult:type=[type:int64 bypass:bool]
xg_check=(n:XGWord expected:XGWord ex:XGWord):>CheckerLogicResult=>$unsafe {
    let k=xg_input[0].nodes[0].ptr[n].kind
    let h:XGWord=0
    if ex not=? 0 and xg_input[0].types[0].ptr[tu_prune(ex)].kind =? 'int_' {h=ex}
    let ta=tu_prune(check_expr(XGWord(xg_input[0].nodes[0].ptr[n].a) h))
    xg_input[0].nodes[0][n].a=int32<overflow='wrap'>(xg_input[0].last[0])
    let tk=xg_input[0].types[0].ptr[tu_prune(ta)].kind
    if tk =? 'struct_' or tk =? 'tuple' or (tk =? 'enum_' and not simple_enum(ta)) {
        let op="~"
        if k not=? 'not_' {
            check_expr(XGWord(xg_input[0].nodes[0].ptr[n].b) 0);
            xg_input[0].nodes[0][n].b=int32<overflow='wrap'>(xg_input[0].last[0])
            op=if k =? 'and_' {"&"} else {"|"}
        }
        let r=op_overload(n op)
        if r not=? 0 {
            xg_input[0].last[0]=n
            return [type=r bypass=true]
        }
    }
    if xg_input[0].types[0].ptr[tu_prune(ta)].kind =? 'int_' {
        let a=XGWord(xg_input[0].nodes[0].ptr[n].a)
        xg_input[0].nodes[0][a].flags=xg_input[0].nodes[0].ptr[a].flags | 128
        if k =? 'not_' {
            xg_input[0].nodes[0][n].kind='unary'
            # Frozen Tok ordinals; the differential checks against checker_tokens.
            xg_input[0].nodes[0][n].op=66
        } else {
            xg_input[0].nodes[0][n].kind='binary'
            xg_input[0].nodes[0][n].op=if k =? 'and_' {63} else {64}
        }
        return [type=check_expr(n expected) bypass=true]
    }
    if k =? 'not_' and logic_mask(ta) {
        let a=XGWord(xg_input[0].nodes[0].ptr[n].a)
        xg_input[0].nodes[0][a].flags=xg_input[0].nodes[0].ptr[a].flags | 128
        logic_broadcast(n)
        return [type=check_expr(n expected) bypass=true]
    }
    let a=XGWord(xg_input[0].nodes[0].ptr[n].a)
    if not cq_settled(xg_input[0].nodes xg_input[0].types a xg_input[0].bool_type[0]) {a=coerce(a xg_input[0].bool_type[0])}
    xg_input[0].nodes[0][n].a=int32<overflow='wrap'>(a)
    if k not=? 'not_' {
        let mark=xg_input[0].scopes[0].names.length
        narrow_by(XGWord(xg_input[0].nodes[0].ptr[n].a) k =? 'and_')
        let b=XGWord(xg_input[0].nodes[0].ptr[n].b)
        check_expr(b xg_input[0].bool_type[0]);
        if not cq_settled(xg_input[0].nodes xg_input[0].types b xg_input[0].bool_type[0]) {coerce(b xg_input[0].bool_type[0]);}
        scope_reset(mark)
    }
    [type=xg_input[0].bool_type[0] bypass=false]
}

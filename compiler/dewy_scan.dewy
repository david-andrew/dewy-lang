$runtime_checks
# Bounded token scans shared by the direct parser. dewy_scan.jo is the frozen
# bootstrap twin; callers supply a nonnegative index and an EOF sentinel for arms.
from p"dewy_tokens.dewy" import DewyToken, DewyKind, DewyLexeme
from p"dewy_grammar.dewy" import dn_power

# Index of the bracket closing the opener at at, or -1.
dc_scan_closing=(@tokens:array<DewyLexeme> at:int64):>int64=>{
    let depth:int64=0
    let k=at
    loop k <? tokens.length {
        let t=tokens[k]
        if t.kind =? 'eof' {return -1}
        if t.symbol =? 'lparen' or t.symbol =? 'lbrack' or t.symbol =? 'lbrace' {depth+=1}
        if t.symbol =? 'rparen' or t.symbol =? 'rbrack' or t.symbol =? 'rbrace' {
            depth-=1
            if depth =? 0 {return k}
        }
        k+=1
    }
    -1
}

# End of an unbraced, left-out target arm.
dc_scan_arm_end=(@tokens:array<DewyLexeme> at:int64):>int64=>{
    let depth:int64=0
    let flows:int64=0
    let k=at
    loop true {
        let t=tokens[k]
        if t.kind =? 'eof' {return k}
        let symbol=t.symbol
        if depth =? 0 and k >? at {
            if symbol =? 'kw_else' {
                if flows =? 0 {return k}
                flows-=1
            } else if t.newline and dn_power(symbol) =? 0 and symbol not=? 'kw_not' and symbol not=? 'dot' {return k}
        }
        if symbol =? 'lparen' or symbol =? 'lbrack' or symbol =? 'lbrace' {depth+=1}
        else if symbol =? 'rparen' or symbol =? 'rbrack' or symbol =? 'rbrace' {
            if depth =? 0 {return k}
            depth-=1
        } else if depth =? 0 and (symbol =? 'kw_if' or symbol =? 'kw_match') {flows+=1}
        k+=1
    }
    k
}

$runtime_checks
from p"@lib/core/str.jo" import (starts_with)
from p"ast.jo" import (NF_ALIASDECL NF_CHECKED NF_COMPREHENSION NF_DISCARD NF_GLOBAL NF_LITERAL NF_LOOP_SETUP NF_MUT NF_SOA NF_SPREAD NF_SQUOTE NF_STMT NF_UNSCOPED TUPLE_VALUES add_flag clear_flag has_flag kid kid2 kids mk nkids nkids2 nodes set_kid set_list)
from p"check.jo" import (FK_GENERATOR FK_NORMAL LF_ADDR LF_ALIAS LF_ASSIGNED LF_BYREF LF_CAPTURE LF_CAPTURED LF_DECL LF_MUTPARAM LF_PARAM LF_QUIET LF_SHARED LF_VALUECAP SINK_GENERATOR check_scopes ctxs cx fns globals locals loop_serial_next loop_serials sink_body_mode sink_fn sinks throwing_iters)
from p"checker_block_entries.dewy" import (check_block)
from p"checker_contexts.dewy" import (cur_mod)
from p"checker_expr.dewy" import (check_expr)
from p"checker_loops.dewy" import (xb_enter xb_leave)
from p"checker_resolve.dewy" import (ct_resolve_family)
from p"checker_scope_symbols.dewy" import (new_local scope_mark scope_reset)
from p"checker_state.dewy" import (FnCtx live_body_global_mod live_body_indexes live_body_user_globals)
from p"checker_tree_queries.dewy" import (place_root)
from p"checker_values.dewy" import (values_parts)
from p"checked_expression_nodes.dewy" import (capture_value mk_ident_local type_node_of)
from p"checks_builders.dewy" import (bc_block bc_call bc_field bc_ident bc_int bc_let bc_stmt)
from p"checks_thin.dewy" import (check_stmt new_inst zonk_tree)
from p"checks_thin_expr.dewy" import (ce_expected ce_finish)
from p"coerce_expression.dewy" import (coerce)
from p"coercion_queries.dewy" import (can_coerce)
from p"diagnostic_exit.dewy" import (fatal)
from p"error_ops.dewy" import (exception_join exception_member value_members)
from p"expr.jo" import (IN bc_count last_checked)
from p"expression_types.dewy" import (ntype)
from p"literal_context.dewy" import (is_lit lit_default)
from p"ownership.jo" import (ownership_fact_cleanup)
from p"ownership_types.dewy" import (ownership_type)
from p"sibling_types.jo" import (sibling_block sibling_index)
from p"types.jo" import (T_BOOL T_INT T_NEVER T_NONE T_VOID fields has_var is_union prune structs targ telem tkind type_eq types union_members variants)
from p"type_ops.dewy" import (dt is_managed is_values mk_generator mk_union mk_var unify zonk)
from p"util.jo" import (intern name_of)
from p"node_store.dewy" import (node_aux2 node_d node_sval node_with_aux2 node_with_sval)

GenWord:type=int64<overflow='wrap'>
GenI32:type=int32<overflow='wrap'>

GenFrame:type=[
    inst:int64=0
    body:int64=0
    expected_elem:int64=0
    want_values:bool=false
    label:int64=0
    has_loop_label:bool=false
    start_loops:int64=0
    yields:array<int64>=[]
    yield_stmts:array<int64>=[]
    yield_types:array<int64>=[]
    yield_kinds:array<int64>=[]
    straight:bool=true
    exact_count:int64=0
]

let gen_frames:array<GenFrame>=[]
let gen_spread_stmts:dict<int64 bool>=dict<int64 bool>()
let gen_local_fresh:dict<int64 array<int64>>=dict<int64 array<int64>>()
let gen_iter_throwing:dict<int64 int64>=dict<int64 int64>()
let gen_iter_aliases:dict<int64 array<int64>>=dict<int64 array<int64>>()
let gen_type_has_cache:array<uint8>=[]
let gen_last_nodes_len:int64=0
let gen_last_types_len:int64=0
let gen_fuse_plan_nodes_len:int64=0
let gen_fuse_plan_fns_len:int64=0

gen_maybe_reset=():>void=>{
    if nodes.length <? gen_last_nodes_len {
        gen_frames=[]
        gen_spread_stmts.clear()
        gen_local_fresh.clear()
        gen_iter_throwing.clear()
        gen_iter_aliases.clear()
        gen_fuse_plan_cache.clear()
        gen_fuse_plan_nodes_len=0
        gen_fuse_plan_fns_len=0
    }
    if types.length <? gen_last_types_len {
        gen_type_has_cache.clear()
    }
    gen_last_nodes_len=nodes.length
    gen_last_types_len=types.length
}

gen_in_lazy=():>bool=>{
    gen_frames.length >? 0 and cx >=? 0 and fns[GenWord(ctxs[cx].inst)].kind =? FK_GENERATOR
}

# Whether type t is or contains TK.generator (cached per type ID, O(1) amortized).
gen_type_contains=(t0:GenWord):>bool=>$unsafe {
    if types.length <? gen_last_types_len {gen_type_has_cache.clear()}
    gen_last_types_len=types.length
    let t=prune(t0)
    if t <=? 0 or t >=? types.length {return false}
    if t <? gen_type_has_cache.length {
        let c=gen_type_has_cache.ptr[t]
        if c not=? uint8(0) {return c =? uint8(3)}
    } else {
        gen_type_has_cache.resize(max(t + 1 types.length) + 64)
    }
    # Mark in-progress (1) to break recursive struct/enum cycles safely.
    gen_type_has_cache.ptr[t]=uint8(1)
    let k=types.ptr[t].kind
    let has=k =? 'generator'
    if not has {
        if k =? 'array' or k =? 'fixed' or k =? 'opt' or k =? 'box' or k =? 'secret' or k =? 'refined' or k =? 'quantity' {
            has=gen_type_contains(GenWord(types.ptr[t].elem))
        } else if k =? 'tuple' {
            loop i in [0..GenWord(types.ptr[t].nargs)) {
                if gen_type_contains(targ(t i)) {has=true; break}
            }
        } else if k =? 'struct_' {
            let si=GenWord(types.ptr[t].st)
            loop i in [0..GenWord(structs.ptr[si].nfields)) {
                let ft=GenWord(fields.ptr[GenWord(structs.ptr[si].fields) + i].type)
                if gen_type_contains(ft) {has=true; break}
            }
        } else if k =? 'enum_' {
            let si=GenWord(types.ptr[t].st)
            loop v in [0..GenWord(structs.ptr[si].nvariants)) {
                let vi=GenWord(structs.ptr[si].variants) + v
                loop i in [0..GenWord(variants.ptr[vi].nfields)) {
                    let ft=GenWord(fields.ptr[GenWord(variants.ptr[vi].fields) + i].type)
                    if gen_type_contains(ft) {has=true; break}
                }
                if has {break}
            }
        }
    }
    if t >=? gen_type_has_cache.length {gen_type_has_cache.resize(max(t + 1 types.length) + 64)}
    gen_type_has_cache.ptr[t]=if has {uint8(3)} else {uint8(2)}
    has
}

# Scan a defer body inside a lazy generator to reject fallible/escaping constructs.
gen_scan_defer=(n:GenWord loop_depth:GenWord):>void=>$unsafe {
    if n =? 0 {return}
    let k=nodes.ptr[n].kind
    if k =? 'lambda' or k =? 'lazy_' {return}
    if k =? 'return_' {fatal(nodes.ptr[n].pos "'return' is not allowed inside 'defer' in a lazy generator")}
    if k =? 'propagate' {fatal(nodes.ptr[n].pos "cleanup inside 'defer' in a lazy generator cannot fail (fallible generator cleanup is not decided yet)")}
    if (k =? 'break_' or k =? 'continue_') and loop_depth =? 0 {
        fatal(nodes.ptr[n].pos "cannot jump out of 'defer' inside a lazy generator")
    }
    let next_depth=if k =? 'while_' or k =? 'for_' {loop_depth + 1} else {loop_depth}
    if nodes.ptr[n].a not=? 0 {gen_scan_defer(GenWord(nodes.ptr[n].a) next_depth)}
    if nodes.ptr[n].b not=? 0 {gen_scan_defer(GenWord(nodes.ptr[n].b) next_depth)}
    if nodes.ptr[n].c not=? 0 {gen_scan_defer(GenWord(nodes.ptr[n].c) next_depth)}
    loop i in [0..nkids(n)) {gen_scan_defer(kid(n i) next_depth)}
}

# After checking a lazy body, verify that no defer body leaves an unhandled failure type
# (fallible cleanup inside generators is undecided, D40 Q1).
gen_check_defers_after=(n:GenWord in_defer:bool):>void=>$unsafe {
    if n =? 0 {return}
    let k=nodes.ptr[n].kind
    if k =? 'lambda' or k =? 'lazy_' {return}
    if k =? 'defer_' {
        gen_check_defers_after(GenWord(nodes.ptr[n].a) true)
        return
    }
    if in_defer and k =? 'exprstmt' {
        let e=GenWord(nodes.ptr[n].a)
        if e not=? 0 and nodes.ptr[e].type not=? 0 {
            let t=prune(ntype(e))
            if is_union(t) {
                loop m in union_members(t) {
                    if m not=? T_NONE and exception_member(m) {
                        fatal(nodes.ptr[e].pos "cleanup inside 'defer' in a lazy generator cannot fail (found {dt(t)}; fallible generator cleanup is not decided yet)")
                    }
                }
            }
        }
    }
    if nodes.ptr[n].a not=? 0 {gen_check_defers_after(GenWord(nodes.ptr[n].a) in_defer)}
    if nodes.ptr[n].b not=? 0 {gen_check_defers_after(GenWord(nodes.ptr[n].b) in_defer)}
    if nodes.ptr[n].c not=? 0 {gen_check_defers_after(GenWord(nodes.ptr[n].c) in_defer)}
    loop i in [0..nkids(n)) {gen_check_defers_after(kid(n i) in_defer)}
}

gen_tuple_has_nested_or_spread=(n:GenWord):>bool=>$unsafe {
    loop i in [0..nkids(n)) {
        let c=kid(n i)
        if has_flag(c NF_SPREAD) {return true}
        if nodes.ptr[c].kind =? 'tuple' and nodes.ptr[c].aux =? int32(TUPLE_VALUES) {return true}
    }
    false
}

gen_flatten_tuple_expr=(n:GenWord want_values:bool @out:array<int64>):>void=>$unsafe {
    if nodes.ptr[n].kind =? 'tuple' and nodes.ptr[n].aux =? int32(TUPLE_VALUES) {
        if want_values and not gen_tuple_has_nested_or_spread(n) {
            out.push(n)
            return
        }
        loop i in [0..nkids(n)) {
            gen_flatten_tuple_expr(kid(n i) want_values @out)
        }
        return
    }
    out.push(n)
}

# Pre-process statements in a lazy generator body before type-checking:
# - flatten nested/non-tuple multivalue groups into individual exprstmts
# - record spread exprstmts (`child()...`, `xs...`) and clear NF_SPREAD
# - reject yielding places (`@x`) and `return`
# - rewrite `break $label` (for non-loop `$label lazy`) to checked `yield_(aux=3)`
# - wrap `defer` bodies with NF_DISCARD so expressions inside defer never yield
gen_prep_block=(b:GenWord label:GenWord has_loop_label:bool want_values:bool shadowed:bool):>void=>$unsafe {
    if b =? 0 or nodes.ptr[b].kind not=? 'block' {return}
    if has_flag(b NF_DISCARD) or has_flag(b NF_COMPREHENSION) {return}
    let orig=kids(b)
    let out:array<int64>=[]
    let changed=false
    loop s in orig {
        let k=nodes.ptr[s].kind
        if k =? 'return_' {
            fatal(nodes.ptr[s].pos "'return' is not allowed inside a lazy generator; use a labeled break (e.g. `$done lazy \{ ... break $done }`) to stop early")
        }
        if k =? 'break_' and not has_loop_label and not shadowed and label not=? 0 and GenWord(nodes.ptr[s].name) =? label {
            let yn=mk('yield_' nodes.ptr[s].pos)
            nodes.ptr[yn].aux=3
            nodes.ptr[yn].type=GenI32(T_NEVER)
            add_flag(yn NF_CHECKED)
            nodes.ptr[s].kind='exprstmt'
            nodes.ptr[s].a=GenI32(yn)
            nodes.ptr[s].name=0
            add_flag(s NF_CHECKED)
            out.push(s)
            continue
        }
        if k =? 'continue_' and not has_loop_label and not shadowed and label not=? 0 and GenWord(nodes.ptr[s].name) =? label {
            fatal(nodes.ptr[s].pos "cannot 'continue' label '${name_of(label)}' on a non-loop lazy generator; use `break $${name_of(label)}` to end the generator, or label a loop directly")
        }
        if k =? 'defer_' {
            let d=GenWord(nodes.ptr[s].a)
            gen_scan_defer(d 0)
            if nodes.ptr[d].kind not=? 'block' {
                d=bc_block([d] nodes.ptr[d].pos)
                nodes.ptr[s].a=GenI32(d)
            }
            add_flag(d NF_DISCARD)
            out.push(s)
            continue
        }
        if k =? 'exprstmt' {
            let e=GenWord(nodes.ptr[s].a)
            if e not=? 0 {
                let ek=nodes.ptr[e].kind
                if has_flag(e NF_MUT) and (ek =? 'ident' or ek =? 'field' or ek =? 'index') {
                    fatal(nodes.ptr[e].pos "yielding places from a generator is not decided yet")
                }
                if ek =? 'tuple' and nodes.ptr[e].aux =? int32(TUPLE_VALUES) and (not want_values or gen_tuple_has_nested_or_spread(e)) {
                    let parts:array<int64>=[]
                    gen_flatten_tuple_expr(e want_values @parts)
                    loop p in parts {
                        let ps=mk('exprstmt' nodes.ptr[p].pos)
                        if has_flag(p NF_MUT) and (nodes.ptr[p].kind =? 'ident' or nodes.ptr[p].kind =? 'field' or nodes.ptr[p].kind =? 'index') {
                            fatal(nodes.ptr[p].pos "yielding places from a generator is not decided yet")
                        }
                        if has_flag(p NF_SPREAD) {
                            clear_flag(p NF_SPREAD)
                            gen_spread_stmts[ps]=true
                        }
                        nodes.ptr[ps].a=GenI32(p)
                        out.push(ps)
                    }
                    changed=true
                    continue
                }
                if has_flag(e NF_SPREAD) {
                    clear_flag(e NF_SPREAD)
                    gen_spread_stmts[s]=true
                } else if ek =? 'match_' {
                    loop i in [0..nkids(e)) {
                        let arm=kid(e i)
                        gen_prep_block(GenWord(nodes.ptr[arm].b) label has_loop_label want_values shadowed)
                    }
                }
            }
            out.push(s)
            continue
        }
        if k =? 'if_' or k =? 'iflet' {
            gen_prep_block(GenWord(nodes.ptr[s].b) label has_loop_label want_values shadowed)
            if nodes.ptr[s].c not=? 0 {gen_prep_block(GenWord(nodes.ptr[s].c) label has_loop_label want_values shadowed)}
            out.push(s)
            continue
        }
        if k =? 'while_' or k =? 'for_' {
            let sh=shadowed or (label not=? 0 and GenWord(node_sval(nodes.ptr[s].op_ext)) =? label)
            gen_prep_block(GenWord(nodes.ptr[s].b) label has_loop_label want_values sh)
            out.push(s)
            continue
        }
        if k =? 'block' {
            gen_prep_block(s label has_loop_label want_values shadowed)
            out.push(s)
            continue
        }
        out.push(s)
    }
    if changed {set_list(b out)}
}

gen_all_exceptions=(t:GenWord):>bool=>{
    let ms=value_members(t)
    if ms.length =? 0 {return false}
    loop m in ms {
        if not exception_member(m) {return false}
    }
    true
}

gen_join_elem=(a0:GenWord b0:GenWord pos:GenWord):>GenWord=>{
    let a=prune(a0)
    let b=prune(b0)
    if a =? T_NEVER {return b}
    if b =? T_NEVER {return a}
    if type_eq(a b) {return a}
    if can_coerce(0 b a) {return a}
    if can_coerce(0 a b) {return b}
    let ej=exception_join(a b)
    if ej not=? 0 {return ej}
    if gen_all_exceptions(a) or gen_all_exceptions(b) {
        return mk_union([value_members(a)... value_members(b)...])
    }
    fatal(pos "generator yields incompatible types {dt(a)} and {dt(b)}")
    a
}

gen_expected_generator=(expected:GenWord):>GenWord=>$unsafe {
    let ex=ce_expected(expected)
    if ex =? 0 {return 0}
    if types.ptr[ex].kind =? 'generator' {return ex}
    if types.ptr[ex].kind =? 'opt' {
        let inner=prune(GenWord(types.ptr[ex].elem))
        if types.ptr[inner].kind =? 'generator' {return inner}
    }
    if is_union(ex) {
        let found:GenWord=0
        loop m in union_members(ex) {
            if types.ptr[prune(m)].kind =? 'generator' {
                if found not=? 0 {return 0}
                found=prune(m)
            }
        }
        return found
    }
    0
}

check_lazy=(n:GenWord expected:GenWord):>GenWord=>$unsafe {
    gen_maybe_reset()
    ownership_fact_cleanup=true
    let ex_gen=gen_expected_generator(expected)
    let expected_elem:GenWord=if ex_gen not=? 0 {prune(telem(ex_gen))} else {0}
    let want_values=expected_elem not=? 0 and is_values(expected_elem)

    let f=new_inst(FK_GENERATOR cur_mod() "lazy")
    fns[f].decl=GenI32(n)
    let body=GenWord(nodes.ptr[n].a)
    fns[f].body=GenI32(body)
    nodes[n].sym=GenI32(f)
    fns[f].state=1

    # Handle `$label lazy ...`:
    # If the lazy body is a single top-level loop with no label of its own,
    # attach the label to that loop so both `continue $label` and `break $label` work.
    let label=GenWord(node_sval(nodes.ptr[n].op_ext))
    let has_loop_label=false
    if label not=? 0 and nkids(body) =? 1 {
        let k0=kid(body 0)
        let k0k=nodes.ptr[k0].kind
        if (k0k =? 'for_' or k0k =? 'while_') and node_sval(nodes.ptr[k0].op_ext) =? 0 {
            nodes[k0].op_ext=node_with_sval(nodes[k0].op_ext (GenI32(label)))
            has_loop_label=true
        } else if k0k =? 'block' and has_flag(k0 NF_LOOP_SETUP) and nkids(k0) >? 0 {
            let wl=kid(k0 nkids(k0) - 1)
            if (nodes.ptr[wl].kind =? 'for_' or nodes.ptr[wl].kind =? 'while_') and node_sval(nodes.ptr[wl].op_ext) =? 0 {
                nodes[wl].op_ext=node_with_sval(nodes[wl].op_ext (GenI32(label)))
                has_loop_label=true
            }
        }
    }

    gen_prep_block(body label has_loop_label want_values false)

    # Check if the body is straight-line (only top-level exprstmts, no loops/branches/defers).
    let initial_straight=true
    loop s in kids(body) {
        let sk=nodes.ptr[s].kind
        if sk not=? 'exprstmt' {initial_straight=false; break}
        let e=GenWord(nodes.ptr[s].a)
        if e =? 0 or nodes.ptr[e].kind =? 'match_' or nodes.ptr[e].kind =? 'yield_' or gen_spread_stmts.has(s) {
            initial_straight=false
            break
        }
    }

    let zi_slot=@live_body_indexes
    let zg_slot=@live_body_user_globals
    let zm_slot=@live_body_global_mod
    let saved_zi=zi_slot
    let saved_zg=zg_slot
    let saved_zm=zm_slot
    zi_slot=0
    zg_slot=0
    zm_slot=-1

    let context=@cx
    let parent=context
    let elem_var=if expected_elem not=? 0 and not has_var(expected_elem) {expected_elem} else {mk_var()}
    ctxs.push(FnCtx(GenI32(f) GenI32(parent) GenI32(elem_var) (expected_elem =? 0) 0 ctxs[parent].mod ctxs[parent].floor))
    context=GenWord(ctxs.length) - 1
    let mark=scope_mark()

    gen_frames.push(GenFrame[
        inst=f
        body=body
        expected_elem=expected_elem
        want_values=want_values
        label=label
        has_loop_label=has_loop_label
        start_loops=loop_serials.length
        straight=initial_straight
    ])

    let saved_sink=sink_fn
    let saved_mode=sink_body_mode
    sink_body_mode=SINK_GENERATOR
    sink_fn=sinks.length
    check_block(body 0 false);
    sink_fn=saved_sink
    sink_body_mode=saved_mode

    let frame=gen_frames.pop()
    gen_check_defers_after(body false)

    # Settle the generator's element type.
    let elem_t:GenWord=T_NEVER
    if frame.yields.length =? 0 {
        if expected_elem not=? 0 and not has_var(expected_elem) {elem_t=expected_elem}
        else {elem_t=T_NEVER}
    } else if expected_elem not=? 0 and not has_var(expected_elem) {
        elem_t=expected_elem
    } else {
        # Infer element type across all yields; resolve integer/float literals
        # against concrete yields when present, else default literals.
        let non_lit:GenWord=0
        let first_lit:GenWord=0
        loop i in [0..frame.yields.length) {
            let yn=frame.yields[i]
            let yt=prune(frame.yield_types[i])
            let yk=frame.yield_kinds[i]
            if yk =? 0 and is_lit(GenWord(nodes.ptr[yn].a)) {
                if first_lit =? 0 {first_lit=GenWord(nodes.ptr[yn].a)}
                continue
            }
            if non_lit =? 0 {non_lit=yt}
            else {non_lit=gen_join_elem(non_lit yt nodes.ptr[yn].pos)}
        }
        if non_lit not=? 0 {
            elem_t=non_lit
            # If any literal cannot coerce to non_lit (e.g. only exception yields plus a literal),
            # join the literal's default type with non_lit!
            loop i in [0..frame.yields.length) {
                let yn=frame.yields[i]
                if frame.yield_kinds[i] =? 0 and is_lit(GenWord(nodes.ptr[yn].a)) {
                    let lt=lit_default(GenWord(nodes.ptr[yn].a))
                    if not can_coerce(GenWord(nodes.ptr[yn].a) lt elem_t) {
                        elem_t=gen_join_elem(lt elem_t nodes.ptr[yn].pos)
                    }
                }
            }
        } else if first_lit not=? 0 {
            elem_t=lit_default(first_lit)
        } else {
            elem_t=T_NEVER
        }
    }

    if expected_elem not=? 0 and has_var(expected_elem) and elem_t not=? T_NEVER {
        unify(expected_elem elem_t);
        elem_t=prune(expected_elem)
    }

    # Coerce every yield to elem_t (and check delegation/failure yields).
    loop i in [0..frame.yields.length) {
        let yn=frame.yields[i]
        let yk=frame.yield_kinds[i]
        let val=GenWord(nodes.ptr[yn].a)
        if yk =? 0 {
            nodes[yn].a=GenI32(coerce(val elem_t))
        } else if yk =? 1 {
            let child_t=prune(ntype(val))
            let child_el=prune(telem(child_t))
            if child_el not=? T_NEVER and not type_eq(child_el elem_t) {
                if not can_coerce(0 child_el elem_t) {
                    fatal(nodes.ptr[yn].pos "cannot delegate generator<{dt(child_el)}> into generator<{dt(elem_t)}>")
                }
                # Widening delegation: rewrite `child...` into `loop $gwdelN in child { yield(coerce($gwdelN, elem_t)) }`
                # so every Dewy coercion (unions, optionals, integer widening, etc.) runs through standard lowering.
                let ys=frame.yield_stmts[i]
                let pos=nodes.ptr[yn].pos
                let serial=@bc_count
                let wname="$gwdel{serial}"
                serial=GenWord(serial) + 1
                add_flag(val NF_CHECKED)
                let lp=mk('for_' pos)
                nodes[lp].a=GenI32(val)
                set_list(lp [bc_ident(wname pos)])
                nodes[lp].b=GenI32(bc_block([bc_stmt(bc_ident(wname pos) pos)] pos))
                nodes[ys]=nodes.ptr[lp]
                gen_frames.push(GenFrame[inst=f body=body expected_elem=elem_t want_values=is_values(elem_t) straight=false])
                let ss=sink_fn
                let sm=sink_body_mode
                sink_body_mode=SINK_GENERATOR
                sink_fn=sinks.length
                check_stmt(ys)
                sink_fn=ss
                sink_body_mode=sm
                let wframe=gen_frames.pop()
                loop wy in wframe.yields {
                    nodes[wy].a=GenI32(coerce(GenWord(nodes.ptr[wy].a) elem_t))
                }
            }
        } else if yk =? 2 {
            let ft=prune(ntype(val))
            if not can_coerce(0 ft elem_t) {
                fatal(nodes.ptr[yn].pos "or_throw inside generator cannot yield {dt(ft)}: generator element type is {dt(elem_t)}")
            }
            nodes[yn].a=GenI32(coerce(val elem_t))
        }
    }

    fns[f].ret=GenI32(elem_t)
    fns[f].state=2
    zonk_tree(body)
    loop l in fns[f].locals {
        let lt=GenWord(locals.ptr[l].type)
        if lt not=? 0 {
            let z=zonk(lt)
            locals[l].type=GenI32(z)
        }
    }
    scope_reset(mark)
    ctxs.pop();
    context=parent
    zi_slot=saved_zi
    zg_slot=saved_zg
    zm_slot=saved_zm

    if frame.straight {
        nodes[n].aux=1
        nodes[n].op_ext=node_with_aux2(nodes[n].op_ext (GenI32(frame.exact_count)))
    } else {
        nodes[n].aux=0
        nodes[n].op_ext=node_with_aux2(nodes[n].op_ext 0)
    }
    let gen_t=mk_generator(elem_t)
    nodes[n].type=GenI32(gen_t)
    add_flag(n NF_CHECKED)
    ce_finish(n gen_t expected)
}

# Called from sink_express when SINK_GENERATOR is active.
gen_express=(s:GenWord t0:GenWord pack:bool):>void=>$unsafe {
    let fi=gen_frames.length - 1
    let v=GenWord(nodes.ptr[s].a)
    let pos=nodes.ptr[v].pos
    let t=prune(t0)

    if gen_spread_stmts.has(s) {
        gen_spread_stmts.remove(s);
        gen_frames[fi].straight=false
        let tk=types.ptr[t].kind
        if tk =? 'generator' {
            let yn=mk('yield_' pos)
            nodes[yn].a=GenI32(v)
            nodes[yn].aux=1
            nodes[yn].type=GenI32(T_VOID)
            add_flag(yn NF_CHECKED)
            nodes[s].a=GenI32(yn)
            add_flag(s NF_CHECKED)
            gen_frames[fi].yields.push(yn)
            gen_frames[fi].yield_stmts.push(s)
            gen_frames[fi].yield_types.push(prune(telem(t)))
            gen_frames[fi].yield_kinds.push(1)
            return
        }
        if tk =? 'array' or tk =? 'fixed' or tk =? 'str_' {
            let serial=@bc_count
            let nm="$gspread{serial}"
            serial=GenWord(serial) + 1
            add_flag(v NF_CHECKED)
            let lp=mk('for_' pos)
            nodes[lp].a=GenI32(v)
            set_list(lp [bc_ident(nm pos)])
            nodes[lp].b=GenI32(bc_block([bc_stmt(bc_ident(nm pos) pos)] pos))
            nodes[s]=nodes.ptr[lp]
            check_stmt(s)
            return
        }
        if is_values(t) {
            let pre:array<int64>=[]
            let parts=values_parts(v @pre)
            let out:array<int64>=[]
            loop d in pre {out.push(d)}
            loop part in parts {
                let yn=mk('yield_' pos)
                nodes[yn].a=GenI32(part)
                nodes[yn].aux=0
                nodes[yn].type=GenI32(T_VOID)
                add_flag(yn NF_CHECKED)
                let st=mk('exprstmt' pos)
                nodes[st].a=GenI32(yn)
                add_flag(st NF_CHECKED)
                gen_frames[fi].yields.push(yn)
                gen_frames[fi].yield_stmts.push(st)
                gen_frames[fi].yield_types.push(prune(ntype(part)))
                gen_frames[fi].yield_kinds.push(0)
                out.push(st)
            }
            let blk=bc_block(out pos)
            add_flag(blk NF_UNSCOPED)
            add_flag(blk NF_CHECKED)
            nodes[blk].type=GenI32(T_VOID)
            nodes[s]=nodes.ptr[blk]
            return
        }
        fatal(pos "cannot spread {dt(t)} inside a lazy generator; expected a generator or sequence")
    }

    # Multivalue expression in a lazy body:
    # - if the generator explicitly wants a multivalue (e.g. generator<(int int)>), yield it as one step
    # - otherwise unpack eager multivalues / pack arrays into individual yields.
    if (pack or is_values(t)) and not (gen_frames[fi].want_values and is_values(t)) {
        gen_frames[fi].straight=false
        if is_values(t) {
            let pre:array<int64>=[]
            let parts=values_parts(v @pre)
            let out:array<int64>=[]
            loop d in pre {out.push(d)}
            loop part in parts {
                let yn=mk('yield_' pos)
                nodes[yn].a=GenI32(part)
                nodes[yn].aux=0
                nodes[yn].type=GenI32(T_VOID)
                add_flag(yn NF_CHECKED)
                let st=mk('exprstmt' pos)
                nodes[st].a=GenI32(yn)
                add_flag(st NF_CHECKED)
                gen_frames[fi].yields.push(yn)
                gen_frames[fi].yield_stmts.push(st)
                gen_frames[fi].yield_types.push(prune(ntype(part)))
                gen_frames[fi].yield_kinds.push(0)
                out.push(st)
            }
            let blk=bc_block(out pos)
            add_flag(blk NF_UNSCOPED)
            add_flag(blk NF_CHECKED)
            nodes[blk].type=GenI32(T_VOID)
            nodes[s]=nodes.ptr[blk]
            return
        }
        if pack and types.ptr[t].kind =? 'array' {
            let serial=@bc_count
            let nm="$gpack{serial}"
            serial=GenWord(serial) + 1
            add_flag(v NF_CHECKED)
            let lp=mk('for_' pos)
            nodes[lp].a=GenI32(v)
            set_list(lp [bc_ident(nm pos)])
            nodes[lp].b=GenI32(bc_block([bc_stmt(bc_ident(nm pos) pos)] pos))
            nodes[s]=nodes.ptr[lp]
            check_stmt(s)
            return
        }
    }

    # Ordinary single-value yield.
    let yn=mk('yield_' pos)
    nodes[yn].a=GenI32(v)
    nodes[yn].aux=0
    nodes[yn].type=GenI32(T_VOID)
    add_flag(yn NF_CHECKED)
    nodes[s].a=GenI32(yn)
    add_flag(s NF_CHECKED)
    gen_frames[fi].yields.push(yn)
    gen_frames[fi].yield_stmts.push(s)
    gen_frames[fi].yield_types.push(t)
    gen_frames[fi].yield_kinds.push(0)
    if gen_frames[fi].straight {
        if loop_serials.length =? gen_frames[fi].start_loops {
            gen_frames[fi].exact_count += 1
        } else {
            gen_frames[fi].straight=false
        }
    }
}

# `value or_throw` / `value or_throw<E>` inside a lazy generator:
# yields any matched failure as the generator's last value and ends the generator.
gen_propagate=(n:GenWord expected:GenWord):>GenWord=>$unsafe {
    let pos=nodes.ptr[n].pos
    let fi=gen_frames.length - 1
    gen_frames[fi].straight=false
    let at=prune(check_expr(GenWord(nodes.ptr[n].a) 0))
    let a=last_checked
    add_flag(a NF_CHECKED)
    let members=value_members(at)
    let exceptions:array<int64>=[]
    if nodes.ptr[n].b not=? 0 {
        let selected=prune(ct_resolve_family(GenWord(nodes.ptr[n].b)))
        let wanted=value_members(selected)
        loop t in wanted {
            if not exception_member(t) {fatal(pos "`or_throw<...>` names the failures to forward: {dt(t)} is not an exception or none")}
        }
        loop t in members {
            if not exception_member(t) {continue}
            let matched=false
            loop e in wanted {
                if t =? e or (t not=? T_NONE and e not=? T_NONE and can_coerce(0 t e)) {matched=true}
            }
            if matched {exceptions.push(t)}
        }
    } else {
        loop t in members {
            if exception_member(t) {exceptions.push(t)}
        }
    }
    if exceptions.length =? 0 {
        nodes[n]=nodes.ptr[a]
        return check_expr(n expected)
    }
    let name="$gprop{n}"
    let stmts:array<int64>=[bc_let(name a pos)]
    loop t in exceptions {
        let fval=if t =? T_NONE {mk('none_lit' pos)} else {bc_ident(name pos)}
        let yn=mk('yield_' pos)
        nodes[yn].a=GenI32(fval)
        nodes[yn].aux=2
        nodes[yn].type=GenI32(T_NEVER)
        let yst=mk('exprstmt' pos)
        nodes[yst].a=GenI32(yn)
        # We check the failure yield expression after narrowing in the `if` branch,
        # using a tiny marker node checked below!
        if exceptions.length =? members.length and t =? exceptions[exceptions.length - 1] {
            stmts.push(yst)
            break
        }
        let cond=mk('istype' pos)
        nodes[cond].a=GenI32(bc_ident(name pos))
        nodes[cond].b=GenI32(type_node_of(t pos))
        let br=mk('if_' pos)
        nodes[br].a=GenI32(cond)
        nodes[br].b=GenI32(bc_block([yst] pos))
        add_flag(br NF_STMT)
        stmts.push(br)
    }
    if exceptions.length not=? members.length {
        stmts.push(bc_stmt(bc_ident(name pos) pos))
    }
    let lowered=bc_block(stmts pos)
    nodes[n]=nodes.ptr[lowered]
    # Check each branch normally; our `yield_(aux=2)` inside `yst` needs its inner expr checked!
    # We intercept `yield_(aux=2)` right here before calling check_expr? Better:
    # `check_expr(n expected)` will run `es_statement` on `yst`, which sees `e.kind =? 'yield_'`!
    # So we handle `k =? 'yield_'` in `checks_value_hooks.dewy` `expr_other`!
    check_expr(n expected)
}

# Check a synthetic `yield_(aux=2)` node produced by `gen_propagate` inside `expr_other`.
gen_check_fail_yield=(n:GenWord):>GenWord=>$unsafe {
    let fi=gen_frames.length - 1
    let t=prune(check_expr(GenWord(nodes.ptr[n].a) 0))
    nodes[n].a=GenI32(last_checked)
    nodes[n].type=GenI32(T_NEVER)
    add_flag(n NF_CHECKED)
    gen_frames[fi].yields.push(n)
    gen_frames[fi].yield_stmts.push(0)
    gen_frames[fi].yield_types.push(t)
    gen_frames[fi].yield_kinds.push(2)
    last_checked=n
    T_NEVER
}

# Walk checked AST subtree to detect any read/capture of local `target_l` (for re-entry / fresh-spread checks).
gen_subtree_uses_local=(n:GenWord target_l:GenWord):>GenWord=>$unsafe {
    if n =? 0 {return 0}
    let k=nodes.ptr[n].kind
    if k =? 'ident' and nodes.ptr[n].aux =? int32(1) and GenWord(nodes.ptr[n].sym) =? target_l {
        return nodes.ptr[n].pos
    }
    if k =? 'lambda' or k =? 'lazy_' {
        let f=GenWord(nodes.ptr[n].sym)
        if f >? 0 and f <? fns.length {
            loop cap in fns.ptr[f].caps {
                if GenWord(cap.outer) =? target_l {return nodes.ptr[n].pos}
            }
        }
        return 0
    }
    let p:GenWord=0
    if nodes.ptr[n].a not=? 0 {
        p=gen_subtree_uses_local(GenWord(nodes.ptr[n].a) target_l)
        if p not=? 0 {return p}
    }
    if nodes.ptr[n].b not=? 0 {
        p=gen_subtree_uses_local(GenWord(nodes.ptr[n].b) target_l)
        if p not=? 0 {return p}
    }
    if nodes.ptr[n].c not=? 0 and k not=? 'for_' {
        p=gen_subtree_uses_local(GenWord(nodes.ptr[n].c) target_l)
        if p not=? 0 {return p}
    }
    loop i in [0..nkids(n)) {
        p=gen_subtree_uses_local(kid(n i) target_l)
        if p not=? 0 {return p}
    }
    0
}

gen_subtree_uses_global=(n:GenWord target_g:GenWord):>GenWord=>$unsafe {
    if n =? 0 {return 0}
    let k=nodes.ptr[n].kind
    if k =? 'ident' and nodes.ptr[n].aux =? int32(2) and GenWord(nodes.ptr[n].sym) =? target_g {
        return nodes.ptr[n].pos
    }
    if k =? 'lambda' or k =? 'lazy_' {return 0}
    let p:GenWord=0
    if nodes.ptr[n].a not=? 0 {
        p=gen_subtree_uses_global(GenWord(nodes.ptr[n].a) target_g)
        if p not=? 0 {return p}
    }
    if nodes.ptr[n].b not=? 0 {
        p=gen_subtree_uses_global(GenWord(nodes.ptr[n].b) target_g)
        if p not=? 0 {return p}
    }
    if nodes.ptr[n].c not=? 0 and k not=? 'for_' {
        p=gen_subtree_uses_global(GenWord(nodes.ptr[n].c) target_g)
        if p not=? 0 {return p}
    }
    loop i in [0..nkids(n)) {
        p=gen_subtree_uses_global(kid(n i) target_g)
        if p not=? 0 {return p}
    }
    0
}

gen_named_local=(e:GenWord):>GenWord=>$unsafe {
    let r=place_root(e)
    if r not=? 0 and nodes.ptr[r].kind =? 'ident' and nodes.ptr[r].aux =? int32(1) {
        return GenWord(nodes.ptr[r].sym)
    }
    0
}

# Positive for local (`aux == 1`), negative for global (`aux == 2`), 0 otherwise.
gen_named_root=(e:GenWord):>GenWord=>$unsafe {
    let r=place_root(e)
    if r not=? 0 and nodes.ptr[r].kind =? 'ident' {
        if nodes.ptr[r].aux =? int32(1) {return GenWord(nodes.ptr[r].sym)}
        if nodes.ptr[r].aux =? int32(2) {return -GenWord(nodes.ptr[r].sym)}
    }
    0
}

# Check `loop x in g`, `loop i in 0.. and x in g`, `loop x in g or_throw`, and temporary `loop x in make_gen()`.
gen_for_check=(s:GenWord):>bool=>$unsafe {
    let it=GenWord(nodes.ptr[s].a)
    if it =? 0 or nodes.ptr[it].kind =? 'range' {return false}
    let t:GenWord=0
    if nodes.ptr[it].type not=? 0 {t=prune(ntype(it))}
    else {
        t=prune(check_expr(it 0))
        it=last_checked
        nodes[s].a=GenI32(it)
    }
    if types.ptr[t].kind not=? 'generator' {return false}
    let pos=nodes.ptr[s].pos
    let throwing=throwing_iters.has(it)
    let throw_filter:GenWord=if throwing {throwing_iters[it]} else {0}

    # Temporary generator expression: bind to a local in a wrapper block so break/return/exit drops it immediately.
    let ik=nodes.ptr[it].kind
    let is_named=(ik =? 'ident' and (nodes.ptr[it].aux =? int32(1) or nodes.ptr[it].aux =? int32(2))) or (ik =? 'field' and gen_named_root(it) not=? 0)
    if not is_named {
        let serial=@bc_count
        let tmp_name="$gen_tmp{serial}"
        serial=GenWord(serial) + 1
        add_flag(it NF_CHECKED)
        let decl=bc_let(tmp_name it pos)
        let inner=nodes.length
        nodes.push(nodes.ptr[s])
        let ref_it=bc_ident(tmp_name pos)
        nodes[inner].a=GenI32(ref_it)
        if throwing {
            throwing_iters.remove(it);
            throwing_iters[ref_it]=throw_filter
        }
        let blk=bc_block([decl inner] pos)
        nodes[s]=nodes.ptr[blk]
        check_stmt(s)
        return true
    }

    # If `loop x in g or_throw`, rewrite binder to unwrap each pulled item with `or_throw`.
    if throwing {
        throwing_iters.remove(it);
        let serial=@bc_count
        let raw_name="$gen_raw{serial}"
        serial=GenWord(serial) + 1
        let nv=GenWord(nkids(s))
        let bi=nv - 1
        let binder=kid(s bi)
        let prop=mk('propagate' nodes.ptr[binder].pos)
        nodes[prop].a=GenI32(bc_ident(raw_name nodes.ptr[binder].pos))
        nodes[prop].b=GenI32(throw_filter)
        let decl=mk('vardecl' nodes.ptr[binder].pos)
        if nodes.ptr[binder].kind =? 'tuple' {set_list(decl kids(binder))}
        else {
            nodes[decl].name=nodes.ptr[binder].name
            nodes[decl].a=nodes.ptr[binder].a
        }
        nodes[decl].b=GenI32(prop)
        let body=GenWord(nodes.ptr[s].b)
        let stmts:array<int64>=[decl]
        loop x in kids(body) {stmts.push(x)}
        set_list(body stmts)
        set_kid(s bi bc_ident(raw_name nodes.ptr[binder].pos))
    }

    let mark=scope_mark()
    loop_serial_next += 1
    loop_serials.push(loop_serial_next)
    let nv=GenWord(nkids(s))
    let et=prune(telem(t))
    if nv =? 2 and nodes.ptr[s].ival =? 1 {
        let idx_l=new_local(GenWord(nodes.ptr[kid(s 0)].name) T_INT pos)
        locals[idx_l].flags=GenI32(GenWord(locals.ptr[idx_l].flags) | LF_DECL)
        nodes[s].c=GenI32(idx_l)
        let el_l=new_local(GenWord(nodes.ptr[kid(s 1)].name) et pos)
        locals[el_l].flags=GenI32(GenWord(locals.ptr[el_l].flags) | LF_DECL)
        nodes[s].sym=GenI32(el_l)
    } else if nv =? 1 {
        nodes[s].c=0
        let el_l=new_local(GenWord(nodes.ptr[kid(s 0)].name) et pos)
        locals[el_l].flags=GenI32(GenWord(locals.ptr[el_l].flags) | LF_DECL)
        nodes[s].sym=GenI32(el_l)
    } else {
        fatal(pos "a generator loop binds one value (or `(a b)` for multivalue generators)")
    }
    nodes[s].aux=5
    xb_enter(s)
    check_block(GenWord(nodes.ptr[s].b) 0 false);
    xb_leave(s)
    loop_serials.pop();
    if scope_mark() not=? mark {scope_reset(mark)}

    # Reject re-entry / use of a named generator while iterating over it.
    let borrow_root=gen_named_root(it)
    if borrow_root >? 0 {
        let nm=name_of(GenWord(locals.ptr[borrow_root].name))
        if not starts_with(nm "$gen_tmp") {
            let bad=gen_subtree_uses_local(GenWord(nodes.ptr[s].b) borrow_root)
            if bad not=? 0 {
                fatal(bad "cannot use generator '{nm}' while iterating over it")
            }
        }
    } else if borrow_root <? 0 {
        let g_id=-borrow_root
        let nm=name_of(GenWord(globals.ptr[g_id].name))
        let bad=gen_subtree_uses_global(GenWord(nodes.ptr[s].b) g_id)
        if bad not=? 0 {
            fatal(bad "cannot use generator '{nm}' while iterating over it")
        }
    }
    true
}

# Rewrite `[g...]` / `xs.extend(g)` into `loop $gext in g { xs.push($gext) }`.
gen_extend_rewrite=(n:GenWord dst:GenWord src:GenWord arr_t:GenWord src_t:GenWord):>GenWord=>$unsafe {
    let pos=nodes.ptr[n].pos
    let gel=prune(telem(src_t))
    if gel not=? T_NEVER and has_var(GenWord(types.ptr[arr_t].elem)) {
        unify(GenWord(types.ptr[arr_t].elem) gel);
    }
    let serial=@bc_count
    let el_name="$gext{serial}"
    serial=GenWord(serial) + 1
    add_flag(src NF_CHECKED)
    add_flag(dst NF_CHECKED)
    let callee=bc_field(dst "push" pos)
    let call=mk('call' pos)
    nodes[call].a=GenI32(callee)
    set_list(call [bc_ident(el_name pos)])
    let lp=mk('for_' pos)
    nodes[lp].a=GenI32(src)
    set_list(lp [bc_ident(el_name pos)])
    nodes[lp].b=GenI32(bc_block([bc_stmt(call pos)] pos))
    let blk=bc_block([lp] pos)
    nodes[n]=nodes.ptr[blk]
    check_stmt(lp)
    nodes[n].type=GenI32(T_VOID)
    add_flag(n NF_CHECKED)
    last_checked=n
    T_VOID
}

# Called from checker_hooks.dewy `decl_after(..., 13)` whenever a local has type `TK.generator`.
gen_after_decl=(s:GenWord l:GenWord t:GenWord):>void=>$unsafe {
    gen_maybe_reset()
    let b=GenWord(nodes.ptr[s].b)
    let nm=name_of(GenWord(locals.ptr[l].name))
    # Combined loop synthetic binding `let __sN = __dewy_iter(g)`:
    # borrow named `g` via LF_ALIAS instead of moving it!
    if starts_with(nm "__s") and b not=? 0 {
        let bk=nodes.ptr[b].kind
        let is_named=(bk =? 'ident' and (nodes.ptr[b].aux =? int32(1) or nodes.ptr[b].aux =? int32(2))) or (bk =? 'field' and gen_named_root(b) not=? 0)
        if throwing_iters.has(b) {
            gen_iter_throwing[l]=throwing_iters[b]
            throwing_iters.remove(b);
        }
        if is_named {
            # Detect `loop a in g and b in g` (same named generator twice in one combined loop).
            let root=gen_named_root(b)
            if root not=? 0 and sibling_block >? 0 {
                let prev=gen_iter_aliases.get(sibling_block) ?? []
                if prev.contains(root) {
                    let rname=if root >? 0 {name_of(GenWord(locals.ptr[root].name))} else {name_of(GenWord(globals.ptr[-root].name))}
                    fatal(nodes.ptr[b].pos "cannot iterate over generator '{rname}' twice in the same loop")
                }
                prev.push(root)
                gen_iter_aliases[sibling_block]=prev
            }
            locals[l].flags=GenI32(LF_ALIAS | LF_QUIET)
            locals[l].alias=GenI32(b)
            nodes[s].kind='block'
            nodes[s].nlist=0
            return
        }
    }
    # Track visibly fresh straight-line local `let g = lazy (20 22)` for same-block sole-use spread.
    if b not=? 0 and nodes.ptr[b].kind =? 'lazy_' and nodes.ptr[b].aux =? 1 and cx >=? 0 {
        gen_local_fresh[l]=[b sibling_block GenWord(ctxs[cx].inst) s]
    }
}

# Handle `IN.dewy_iter_value` / `IN.dewy_iter_pair` on a generator in combined loops.
gen_iter_value_wrap=(n:GenWord args:array<int64> t:GenWord):>GenWord=>$unsafe {
    let et=prune(telem(t))
    let src=args[0]
    let throwing=false
    let filter:GenWord=0
    if nodes.ptr[src].kind =? 'ident' and nodes.ptr[src].aux =? int32(1) {
        let sl=GenWord(nodes.ptr[src].sym)
        if gen_iter_throwing.has(sl) {
            throwing=true
            filter=gen_iter_throwing[sl]
        }
    }
    nodes[n].type=GenI32(et)
    add_flag(n NF_CHECKED)
    if throwing {
        let inner=nodes.length
        nodes.push(nodes.ptr[n])
        let prop=mk('propagate' nodes.ptr[n].pos)
        nodes[prop].a=GenI32(inner)
        nodes[prop].b=GenI32(filter)
        nodes[n]=nodes.ptr[prop]
        return check_expr(n 0)
    }
    et
}

# Spread of a generator into fixed parameters (`add(lazy (20 22)...)` or sole-use same-block local).
gen_spread_fresh=(c:GenWord call:GenWord):>GenWord=>$unsafe {
    let pos=nodes.ptr[c].pos
    let k=nodes.ptr[c].kind
    if k =? 'lazy_' {
        if nodes.ptr[c].aux =? 1 {return GenWord(node_aux2(nodes.ptr[c].op_ext))}
        fatal(pos "cannot spread this generator into fixed parameters because its item count is not statically fixed; use a multivalue `(a b)` or collect it with `[g...]`")
    }
    if k =? 'ident' and nodes.ptr[c].aux =? int32(1) {
        let l=GenWord(nodes.ptr[c].sym)
        if gen_local_fresh.has(l) and cx >=? 0 {
            let info=gen_local_fresh[l]
            let lz=info[0]
            let decl_blk=info[1]
            let decl_inst=info[2]
            let decl_stmt=info[3]
            if decl_inst =? GenWord(ctxs[cx].inst) and decl_blk =? sibling_block and decl_blk >? 0 and (GenWord(locals.ptr[l].flags) & (LF_ASSIGNED | LF_CAPTURED | LF_ADDR)) =? 0 {
                # Ensure `l` was not used in any statement between its declaration and this statement.
                let used=false
                let past_decl=false
                loop i in [0..sibling_index) {
                    let st=kid(decl_blk i)
                    if st =? decl_stmt {past_decl=true; continue}
                    if past_decl and gen_subtree_uses_local(st l) not=? 0 {used=true; break}
                }
                if not used {
                    gen_local_fresh.remove(l);
                    return GenWord(node_aux2(nodes.ptr[lz].op_ext))
                }
            }
        }
    }
    fatal(pos "cannot spread a generator into fixed parameters unless it is visibly fresh with a known count (as in `f(lazy (a b)...)` or a sole-use local in the same block); use a multivalue `(a b)` instead")
    0
}

# Expand a fresh generator spread of exact count `count` into `@pre` pulls and `@out` argument idents.
gen_spread_parts=(c:GenWord count:GenWord @pre:array<int64> @out:array<int64>):>void=>$unsafe {
    let pos=nodes.ptr[c].pos
    let t=prune(ntype(c))
    let et=prune(telem(t))
    # Always capture (moving any sole-use local so any later read is caught by move-only!).
    let held=capture_value(c t @pre)
    let src=GenWord(nodes.ptr[held].sym)
    let serial=@bc_count
    serial=GenWord(serial) + 1
    let k_decl=bc_let("$gspk{serial}" bc_int(0 pos) pos)
    check_stmt(k_decl)
    pre.push(k_decl)
    let kl=GenWord(nodes.ptr[k_decl].sym)
    loop i in [0..count) {
        let done_call=mk('intrinsic' pos)
        nodes[done_call].aux=GenI32(int64(IN.dewy_iter_done))
        set_list(done_call [mk_ident_local(src pos) mk_ident_local(kl pos)])
        nodes[done_call].type=GenI32(T_BOOL)
        add_flag(done_call NF_CHECKED)
        let ds=mk('exprstmt' pos)
        nodes[ds].a=GenI32(done_call)
        add_flag(ds NF_CHECKED)
        pre.push(ds)

        let val_call=mk('intrinsic' pos)
        nodes[val_call].aux=GenI32(int64(IN.dewy_iter_value))
        set_list(val_call [mk_ident_local(src pos) mk_ident_local(kl pos)])
        nodes[val_call].type=GenI32(et)
        add_flag(val_call NF_CHECKED)
        let item_held=capture_value(val_call et @pre)
        out.push(item_held)
    }
    # Pull once more so the generator reaches its natural end and runs any defers.
    let end_call=mk('intrinsic' pos)
    nodes[end_call].aux=GenI32(int64(IN.dewy_iter_done))
    set_list(end_call [mk_ident_local(src pos) mk_ident_local(kl pos)])
    nodes[end_call].type=GenI32(T_BOOL)
    add_flag(end_call NF_CHECKED)
    let es=mk('exprstmt' pos)
    nodes[es].a=GenI32(end_call)
    add_flag(es NF_CHECKED)
    pre.push(es)
}

# ---------------- Shared AST Fusion Planner (Effect Scan + Lowering) ----------------
# Pure AST analysis of non-escaping local generator pipelines (`lazy ...`, single-use
# local chains, and direct single-`lazy` factory calls) consumed by a single `for_ (aux = 5)`
# or combined-header `while_` loop. Cached per `(f, nodes.length, fns.length)` so both
# `effect_scan` and `lower_generators` make the exact same fusion decisions.
GenFuseSource:type=[
    kind:int64=0        # 0 = direct lazy_, 1 = direct single-lazy factory call
    node:int64=0        # lazy_ node or call node
    lazy_node:int64=0   # underlying lazy_ AST node
    fn_inst:int64=0     # FK_GENERATOR instance
    factory_fn:int64=0  # FK_NORMAL factory instance (if kind == 1)
    cap_fused:array<int64>=[]
    cap_exprs:array<int64>=[]
]

GenFuseWhileInfo:type=[
    while_node:int64=0
    gen_l:int64=0
    k_l:int64=0
    el_l:int64=0
    gi:int64=0
    before_stmts:array<int64>=[]
    after_stmts:array<int64>=[]
    before_managed_locals:array<int64>=[]
]

GenFusePlan:type=[
    active:bool=false
    pool:array<GenFuseSource>=[]
    locals_map:dict<int64 int64>=dict<int64 int64>()
    decls_map:dict<int64 int64>=dict<int64 int64>()
    skip_k_decls:dict<int64 bool>=dict<int64 bool>()
    for_sources:dict<int64 int64>=dict<int64 int64>()
    while_infos:dict<int64 GenFuseWhileInfo>=dict<int64 GenFuseWhileInfo>()
    while_sources:dict<int64 int64>=dict<int64 int64>()
    fused_only_captured:array<int64>=[]
]

GenFuseScan:type=[
    cand_decl:dict<int64 int64>=dict<int64 int64>()
    cand_rhs:dict<int64 int64>=dict<int64 int64>()
    cand_depth:dict<int64 int64>=dict<int64 int64>()
    cand_block:dict<int64 int64>=dict<int64 int64>()
    cand_idx:dict<int64 int64>=dict<int64 int64>()
    use_count:dict<int64 int64>=dict<int64 int64>()
    use_kind:dict<int64 int64>=dict<int64 int64>()
    use_parent:dict<int64 int64>=dict<int64 int64>()
    use_block:dict<int64 int64>=dict<int64 int64>()
    use_idx:dict<int64 int64>=dict<int64 int64>()
    disqualified:dict<int64 bool>=dict<int64 bool>()
    rhs_owner:dict<int64 int64>=dict<int64 int64>()
    while_infos:dict<int64 GenFuseWhileInfo>=dict<int64 GenFuseWhileInfo>()
    all_clos:array<int64>=[]
    cands:array<int64>=[]
]

let gen_fuse_plan_cache:dict<int64 GenFusePlan>=dict<int64 GenFusePlan>()

gen_local_is_shared=(l:GenWord):>bool=>$unsafe {
    let fl=GenWord(locals.ptr[l].flags)
    if fl & LF_CAPTURE =? 0 or fl & LF_VALUECAP not=? 0 {return fl & LF_SHARED not=? 0}
    let r=l
    loop GenWord(locals.ptr[r].flags) & LF_CAPTURE not=? 0 and GenWord(locals.ptr[r].flags) & LF_VALUECAP =? 0 and locals.ptr[r].outer >? 0 {
        r=GenWord(locals.ptr[r].outer)
    }
    GenWord(locals.ptr[r].flags) & LF_SHARED not=? 0
}

# Map a factory parameter's view local (if Dewy inserted a synthetic param-view vardecl `aux2 == 1`)
# back to its parameter index in `fns.ptr[cf].params`, or -1 if not a direct parameter.
gen_fuse_factory_param_idx=(cf:GenWord outer_l:GenWord):>int64=>$unsafe {
    let target=outer_l
    let body=GenWord(fns.ptr[cf].body)
    loop i in [0..nkids(body)) {
        let s=kid(body i)
        if nodes.ptr[s].kind not=? 'vardecl' or node_aux2(nodes.ptr[s].op_ext) not=? 1 {break}
        if GenWord(nodes.ptr[s].sym) =? target {
            let rhs=GenWord(nodes.ptr[s].b)
            if rhs >? 0 and nodes.ptr[rhs].kind =? 'ident' and nodes.ptr[rhs].aux =? int32(1) {
                target=GenWord(nodes.ptr[rhs].sym)
            }
            break
        }
    }
    loop j in [0..fns.ptr[cf].params.length) {
        if GenWord(fns.ptr[cf].params.ptr[j]) =? target {return j}
    }
    -1
}

# Check if direct call `c` invokes a single-lazy factory function; return its `lazy_` node or 0.
gen_fuse_factory_lazy=(c:GenWord):>int64=>$unsafe {
    if c <=? 0 or nodes.ptr[c].kind not=? 'call' or nodes.ptr[c].aux not=? 0 {return 0}
    let cf=GenWord(nodes.ptr[c].sym)
    if cf <=? 0 or cf >=? fns.length {return 0}
    if fns.ptr[cf].kind not=? FK_NORMAL or fns.ptr[cf].state not=? 2 {return 0}
    if fns.ptr[cf].cabi or fns.ptr[cf].has_env {return 0}
    let body=GenWord(fns.ptr[cf].body)
    if body <=? 0 or nodes.ptr[body].kind not=? 'block' {return 0}
    if nkids(c) not=? fns.ptr[cf].params.length {return 0}
    let si:int64=0
    loop si <? nkids(body) {
        let st=kid(body si)
        if nodes.ptr[st].kind =? 'vardecl' and node_aux2(nodes.ptr[st].op_ext) =? 1 {si += 1}
        else {break}
    }
    if si not=? nkids(body) - 1 {return 0}
    let s0=kid(body si)
    let s0k=nodes.ptr[s0].kind
    if s0k not=? 'exprstmt' and s0k not=? 'return_' {return 0}
    let lz=GenWord(nodes.ptr[s0].a)
    if lz <=? 0 or nodes.ptr[lz].kind not=? 'lazy_' {return 0}
    let fp=GenWord(nodes.ptr[lz].sym)
    if fp <=? 0 or fp >=? fns.length {return 0}
    # Every parameter must be a plain value parameter (no @mut, byref, addr, shared, or $__drop__ owner).
    loop p in fns.ptr[cf].params {
        let fl=GenWord(locals.ptr[p].flags)
        if fl & (LF_MUTPARAM | LF_BYREF | LF_ADDR) not=? 0 or gen_local_is_shared(p) {return 0}
        let pt=prune(GenWord(locals.ptr[p].type))
        if ownership_type(pt) {return 0}
    }
    # Every capture of `lz` must be a direct parameter (or its synthetic view) of `cf`,
    # and every parameter of `cf` must be captured so no argument side-effect is dropped.
    if fns.ptr[fp].caps.length not=? fns.ptr[cf].params.length {return 0}
    loop cap in fns.ptr[fp].caps {
        if gen_fuse_factory_param_idx(cf GenWord(cap.outer)) <? 0 {return 0}
    }
    lz
}

# Check whether generator function `fp` is eligible for local loop fusion (bounded size & yields).
gen_fuse_walk_eligible=(n:GenWord @ncount:int64 @ycount:int64):>bool=>$unsafe {
    if n =? 0 {return true}
    ncount += 1
    if ncount >? 160 {return false}
    let k=nodes.ptr[n].kind
    if k =? 'lambda' or k =? 'lazy_' {
        # Reject inner closures/generators capturing locals of `fp` (would need frame env).
        let inf=GenWord(nodes.ptr[n].sym)
        if inf >? 0 and inf <? fns.length and fns.ptr[inf].caps.length >? 0 {return false}
        return true
    }
    if k =? 'yield_' {
        let aux=GenWord(nodes.ptr[n].aux)
        # Dynamic delegation (`child()...`, aux=1) stays on the heap state machine.
        if aux =? 1 {return false}
        if aux =? 0 or aux =? 2 {
            ycount += 1
            if ycount >? 4 {return false}
        }
        return gen_fuse_walk_eligible(GenWord(nodes.ptr[n].a) @ncount @ycount)
    }
    if nodes.ptr[n].a not=? 0 and not gen_fuse_walk_eligible(GenWord(nodes.ptr[n].a) @ncount @ycount) {return false}
    if nodes.ptr[n].b not=? 0 and not gen_fuse_walk_eligible(GenWord(nodes.ptr[n].b) @ncount @ycount) {return false}
    if k not=? 'for_' {
        if nodes.ptr[n].c not=? 0 and not gen_fuse_walk_eligible(GenWord(nodes.ptr[n].c) @ncount @ycount) {return false}
        if k not=? 'partial' and node_d(nodes.ptr[n].op_ext) not=? 0 and not gen_fuse_walk_eligible(GenWord(node_d(nodes.ptr[n].op_ext)) @ncount @ycount) {return false}
    }
    loop i in [0..nkids(n)) {
        if not gen_fuse_walk_eligible(kid(n i) @ncount @ycount) {return false}
    }
    loop i in [0..nkids2(n)) {
        if not gen_fuse_walk_eligible(kid2(n i) @ncount @ycount) {return false}
    }
    true
}

gen_fuse_eligible=(fp:GenWord depth:int64):>bool=>$unsafe {
    if depth >? 6 or fp <=? 0 or fp >=? fns.length {return false}
    let cap_set=dict<int64 bool>()
    loop cap in fns.ptr[fp].caps {cap_set[GenWord(cap.inner)]=true}
    loop l in fns.ptr[fp].locals {
        if gen_local_is_shared(l) {return false}
        let lt=prune(GenWord(locals.ptr[l].type))
        if ownership_type(lt) {return false}
        # Only allow generator-typed locals that are direct captures (upstream pipeline inputs).
        if not cap_set.has(l) and gen_type_contains(lt) {return false}
    }
    let ncount:int64=0
    let ycount:int64=0
    gen_fuse_walk_eligible(GenWord(fns.ptr[fp].body) @ncount @ycount)
}

# Validate `before_stmts` of a combined-header `while_` loop and collect managed prefix locals.
gen_fuse_before_ok=(n:GenWord loop_depth:int64 top_level:bool @before_managed:array<int64>):>bool=>$unsafe {
    if n =? 0 {return true}
    let k=nodes.ptr[n].kind
    if k =? 'defer_' or k =? 'yield_' or k =? 'lambda' or k =? 'lazy_' {return false}
    if k =? 'continue_' {
        return GenWord(nodes.ptr[n].ival) <? loop_depth
    }
    if k =? 'break_' {
        if loop_depth =? 0 {return GenWord(nodes.ptr[n].ival) =? 0}
        return GenWord(nodes.ptr[n].ival) <=? loop_depth
    }
    if k =? 'vardecl' {
        if has_flag(n NF_GLOBAL | NF_ALIASDECL) {return false}
        if top_level {
            if nkids(n) =? 0 {
                let bl=GenWord(nodes.ptr[n].sym)
                if bl <=? 0 {return false}
                let fl=GenWord(locals.ptr[bl].flags)
                if fl & (LF_ALIAS | LF_CAPTURED | LF_ADDR) not=? 0 or gen_local_is_shared(bl) {return false}
                let bt=prune(GenWord(locals.ptr[bl].type))
                if ownership_type(bt) {return false}
                if is_managed(bt) {before_managed.push(bl)}
            } else {
                loop j in [0..nkids(n)) {
                    let c=kid(n j)
                    if nodes.ptr[c].kind =? 'hole' {continue}
                    if has_flag(c NF_GLOBAL) or nodes.ptr[c].sym <=? 0 {return false}
                    let bl=GenWord(nodes.ptr[c].sym)
                    let fl=GenWord(locals.ptr[bl].flags)
                    if fl & (LF_ALIAS | LF_CAPTURED | LF_ADDR) not=? 0 or gen_local_is_shared(bl) {return false}
                    let bt=prune(GenWord(locals.ptr[bl].type))
                    if ownership_type(bt) {return false}
                    if is_managed(bt) {before_managed.push(bl)}
                }
            }
        }
        return gen_fuse_before_ok(GenWord(nodes.ptr[n].b) loop_depth false @before_managed)
    }
    let next_ld=if k =? 'for_' or k =? 'while_' {loop_depth + 1} else {loop_depth}
    if nodes.ptr[n].a not=? 0 and not gen_fuse_before_ok(GenWord(nodes.ptr[n].a) next_ld false @before_managed) {return false}
    if nodes.ptr[n].b not=? 0 and not gen_fuse_before_ok(GenWord(nodes.ptr[n].b) next_ld false @before_managed) {return false}
    if nodes.ptr[n].c not=? 0 and k not=? 'for_' and not gen_fuse_before_ok(GenWord(nodes.ptr[n].c) next_ld false @before_managed) {return false}
    loop i in [0..nkids(n)) {
        if not gen_fuse_before_ok(kid(n i) next_ld false @before_managed) {return false}
    }
    true
}

# Match a combined-header `while true { <before>; k += 1; if __dewy_iter_done(g, k) { break }; let v = __dewy_iter_value(g, k); <after> }`.
gen_fuse_while_match=(wl:GenWord):>GenFuseWhileInfo=>$unsafe {
    let empty=GenFuseWhileInfo[]
    if wl <=? 0 or nodes.ptr[wl].kind not=? 'while_' or nodes.ptr[wl].aux not=? 0 {return empty}
    let cond=GenWord(nodes.ptr[wl].a)
    if cond <=? 0 or nodes.ptr[cond].kind not=? 'bool_lit' or nodes.ptr[cond].ival not=? 1 {return empty}
    let wb=GenWord(nodes.ptr[wl].b)
    if wb <=? 0 or nodes.ptr[wb].kind not=? 'block' {return empty}
    let nb=nkids(wb)
    if nb <? 3 {return empty}

    let found_gi:int64=-1
    let gen_l:int64=0
    let k_l:int64=0
    let el_l:int64=0
    loop gi in [0..nb - 2) {
        let st0=kid(wb gi)
        if nodes.ptr[st0].kind not=? 'assign' {continue}
        let ka=GenWord(nodes.ptr[st0].a)
        if ka <=? 0 or nodes.ptr[ka].kind not=? 'ident' or nodes.ptr[ka].aux not=? int32(1) {continue}
        let kl=GenWord(nodes.ptr[ka].sym)

        let st1=kid(wb gi + 1)
        if nodes.ptr[st1].kind not=? 'if_' or nodes.ptr[st1].c not=? 0 {continue}
        let ic=GenWord(nodes.ptr[st1].a)
        if ic <=? 0 or nodes.ptr[ic].kind not=? 'intrinsic' or nodes.ptr[ic].aux not=? GenI32(int64(IN.dewy_iter_done)) or nkids(ic) not=? 2 {continue}
        let a0=kid(ic 0)
        let a1=kid(ic 1)
        if nodes.ptr[a0].kind not=? 'ident' or nodes.ptr[a0].aux not=? int32(1) {continue}
        if nodes.ptr[a1].kind not=? 'ident' or nodes.ptr[a1].aux not=? int32(1) or GenWord(nodes.ptr[a1].sym) not=? kl {continue}
        let gl=GenWord(nodes.ptr[a0].sym)
        if tkind(prune(GenWord(locals.ptr[gl].type))) not=? 'generator' {continue}
        let th=GenWord(nodes.ptr[st1].b)
        let is_brk=false
        if th >? 0 and nodes.ptr[th].kind =? 'break_' and nodes.ptr[th].ival =? 0 {is_brk=true}
        else if th >? 0 and nodes.ptr[th].kind =? 'block' and nkids(th) =? 1 {
            let b0=kid(th 0)
            if nodes.ptr[b0].kind =? 'break_' and nodes.ptr[b0].ival =? 0 {is_brk=true}
        }
        if not is_brk {continue}

        let st2=kid(wb gi + 2)
        if nodes.ptr[st2].kind not=? 'vardecl' or nkids(st2) not=? 0 or has_flag(st2 NF_GLOBAL | NF_ALIASDECL) or nodes.ptr[st2].sym <=? 0 {continue}
        let vl=GenWord(nodes.ptr[st2].sym)
        if (GenWord(locals.ptr[vl].flags) & LF_ALIAS) not=? 0 or gen_local_is_shared(vl) {continue}
        let vr=GenWord(nodes.ptr[st2].b)
        if vr <=? 0 or nodes.ptr[vr].kind not=? 'intrinsic' or nodes.ptr[vr].aux not=? GenI32(int64(IN.dewy_iter_value)) or nkids(vr) not=? 2 {continue}
        let v0=kid(vr 0)
        let v1=kid(vr 1)
        if nodes.ptr[v0].kind not=? 'ident' or nodes.ptr[v0].aux not=? int32(1) or GenWord(nodes.ptr[v0].sym) not=? gl {continue}
        if nodes.ptr[v1].kind not=? 'ident' or nodes.ptr[v1].aux not=? int32(1) or GenWord(nodes.ptr[v1].sym) not=? kl {continue}

        found_gi=gi
        gen_l=gl
        k_l=kl
        el_l=vl
        break
    }
    if found_gi <? 0 {return empty}

    # Ensure `gen_l` and `k_l` are not referenced anywhere else in the loop body.
    loop j in [0..nb) {
        if j >=? found_gi and j <=? found_gi + 2 {continue}
        let sj=kid(wb j)
        if gen_subtree_uses_local(sj gen_l) not=? 0 or gen_subtree_uses_local(sj k_l) not=? 0 {
            return empty
        }
    }

    let before_stmts:array<int64>=[]
    let before_managed:array<int64>=[]
    loop j in [0..found_gi) {
        let bs=kid(wb j)
        if not gen_fuse_before_ok(bs 0 true @before_managed) {return empty}
        before_stmts.push(bs)
    }
    let after_stmts:array<int64>=[]
    loop j in [found_gi + 3..nb) {
        after_stmts.push(kid(wb j))
    }

    GenFuseWhileInfo[
        while_node=wl
        gen_l=gen_l
        k_l=k_l
        el_l=el_l
        gi=found_gi
        before_stmts=before_stmts
        after_stmts=after_stmts
        before_managed_locals=before_managed
    ]
}

gen_fuse_note_use=(@sc:GenFuseScan l:GenWord ukind:int64 parent:GenWord depth:int64 blk_n:int64 st_idx:int64 in_lam:bool):>void=>{
    if not sc.cand_decl.has(l) {return}
    let prev=sc.use_count.get(l) ?? 0
    sc.use_count[l]=prev + 1
    if prev >? 0 or in_lam or ukind =? 99 or depth not=? sc.cand_depth[l] {
        sc.disqualified[l]=true
        return
    }
    sc.use_kind[l]=ukind
    sc.use_parent[l]=parent
    sc.use_block[l]=blk_n
    sc.use_idx[l]=st_idx
}

gen_fuse_scan_node=(n:GenWord @sc:GenFuseScan depth:int64 blk_n:int64 st_idx:int64 in_lam:bool):>void=>$unsafe {
    if n =? 0 {return}
    let k=nodes.ptr[n].kind
    if k =? 'block' {
        loop i in [0..nkids(n)) {
            gen_fuse_scan_node(kid(n i) @sc depth n i in_lam)
        }
        return
    }
    if k =? 'vardecl' {
        let rhs=GenWord(nodes.ptr[n].b)
        if not has_flag(n NF_GLOBAL) and nkids(n) =? 0 and nodes.ptr[n].sym >? 0 and rhs not=? 0 and not in_lam {
            let l=GenWord(nodes.ptr[n].sym)
            let fl=GenWord(locals.ptr[l].flags)
            let lt=prune(GenWord(locals.ptr[l].type))
            if types.ptr[lt].kind =? 'generator' and (fl & (LF_PARAM | LF_MUTPARAM | LF_ALIAS | LF_BYREF | LF_ADDR | LF_ASSIGNED)) =? 0 and not gen_local_is_shared(l) {
                sc.cand_decl[l]=n
                sc.cand_rhs[l]=rhs
                sc.cand_depth[l]=depth
                sc.cand_block[l]=blk_n
                sc.cand_idx[l]=st_idx
                sc.rhs_owner[rhs]=l
                sc.cands.push(l)
            }
        }
        if rhs not=? 0 {gen_fuse_scan_node(rhs @sc depth blk_n st_idx in_lam)}
        return
    }
    if k =? 'for_' {
        let it=GenWord(nodes.ptr[n].a)
        if nodes.ptr[n].aux =? 5 and it not=? 0 and nodes.ptr[it].kind =? 'ident' and nodes.ptr[it].aux =? int32(1) {
            gen_fuse_note_use(@sc GenWord(nodes.ptr[it].sym) 1 n depth blk_n st_idx in_lam)
        } else if it not=? 0 {
            gen_fuse_scan_node(it @sc depth blk_n st_idx in_lam)
        }
        gen_fuse_scan_node(GenWord(nodes.ptr[n].b) @sc depth + 1 blk_n st_idx in_lam)
        return
    }
    if k =? 'while_' {
        let wi=gen_fuse_while_match(n)
        if wi.while_node =? n {
            sc.while_infos[n]=wi
            gen_fuse_note_use(@sc wi.gen_l 4 n depth blk_n st_idx in_lam)
            loop bs in wi.before_stmts {gen_fuse_scan_node(bs @sc depth + 1 blk_n st_idx in_lam)}
            loop as_ in wi.after_stmts {gen_fuse_scan_node(as_ @sc depth + 1 blk_n st_idx in_lam)}
            return
        }
        gen_fuse_scan_node(GenWord(nodes.ptr[n].a) @sc depth blk_n st_idx in_lam)
        gen_fuse_scan_node(GenWord(nodes.ptr[n].b) @sc depth + 1 blk_n st_idx in_lam)
        return
    }
    if k =? 'lazy_' {
        sc.all_clos.push(n)
        let fp=GenWord(nodes.ptr[n].sym)
        if fp >? 0 and fp <? fns.length {
            loop cap in fns.ptr[fp].caps {
                gen_fuse_note_use(@sc GenWord(cap.outer) 2 n depth blk_n st_idx in_lam)
            }
        }
        return
    }
    if k =? 'lambda' {
        sc.all_clos.push(n)
        let lf=GenWord(nodes.ptr[n].sym)
        if lf >? 0 and lf <? fns.length {
            loop cap in fns.ptr[lf].caps {
                gen_fuse_note_use(@sc GenWord(cap.outer) 99 n depth blk_n st_idx true)
            }
        }
        return
    }
    if k =? 'call' {
        let flz=gen_fuse_factory_lazy(n)
        if flz not=? 0 {
            loop i in [0..nkids(n)) {
                let arg=kid(n i)
                if nodes.ptr[arg].kind =? 'ident' and nodes.ptr[arg].aux =? int32(1) {
                    gen_fuse_note_use(@sc GenWord(nodes.ptr[arg].sym) 3 n depth blk_n st_idx in_lam)
                } else {
                    if sc.rhs_owner.has(n) {sc.rhs_owner[arg]=sc.rhs_owner[n]}
                    gen_fuse_scan_node(arg @sc depth blk_n st_idx in_lam)
                }
            }
            return
        }
    }
    if k =? 'ident' and nodes.ptr[n].aux =? int32(1) {
        gen_fuse_note_use(@sc GenWord(nodes.ptr[n].sym) 99 n depth blk_n st_idx in_lam)
        return
    }
    if nodes.ptr[n].a not=? 0 {gen_fuse_scan_node(GenWord(nodes.ptr[n].a) @sc depth blk_n st_idx in_lam)}
    if nodes.ptr[n].b not=? 0 {gen_fuse_scan_node(GenWord(nodes.ptr[n].b) @sc depth blk_n st_idx in_lam)}
    if nodes.ptr[n].c not=? 0 {gen_fuse_scan_node(GenWord(nodes.ptr[n].c) @sc depth blk_n st_idx in_lam)}
    loop i in [0..nkids(n)) {
        gen_fuse_scan_node(kid(n i) @sc depth blk_n st_idx in_lam)
    }
}

gen_fuse_build_source=(@plan:GenFusePlan e:GenWord active_fns:array<int64> depth:int64):>int64=>$unsafe {
    if e <=? 0 or depth >? 6 {return -1}
    let k=nodes.ptr[e].kind
    if k =? 'lazy_' {
        let fp=GenWord(nodes.ptr[e].sym)
        if active_fns.contains(fp) or not gen_fuse_eligible(fp depth) {return -1}
        let idx=plan.pool.length
        plan.pool.push(GenFuseSource[kind=0 node=e lazy_node=e fn_inst=fp])
        return idx
    }
    if k =? 'call' {
        let lz=gen_fuse_factory_lazy(e)
        if lz =? 0 {return -1}
        let cf=GenWord(nodes.ptr[e].sym)
        let fp=GenWord(nodes.ptr[lz].sym)
        if active_fns.contains(fp) or active_fns.contains(cf) or not gen_fuse_eligible(fp depth) {return -1}
        let idx=plan.pool.length
        plan.pool.push(GenFuseSource[kind=1 node=e lazy_node=lz fn_inst=fp factory_fn=cf])
        return idx
    }
    -1
}

gen_fuse_has_managed_cap=(plan:GenFusePlan src_idx:int64):>bool=>$unsafe {
    let fp=plan.pool[src_idx].fn_inst
    loop cap in fns.ptr[fp].caps {
        let t=prune(GenWord(locals.ptr[GenWord(cap.inner)].type))
        if types.ptr[t].kind not=? 'generator' and is_managed(t) {return true}
    }
    false
}

gen_fuse_node_has_defer=(n:GenWord):>bool=>$unsafe {
    if n =? 0 {return false}
    let k=nodes.ptr[n].kind
    if k =? 'lambda' or k =? 'lazy_' {return false}
    if k =? 'defer_' {return true}
    if nodes.ptr[n].a not=? 0 and gen_fuse_node_has_defer(GenWord(nodes.ptr[n].a)) {return true}
    if nodes.ptr[n].b not=? 0 and gen_fuse_node_has_defer(GenWord(nodes.ptr[n].b)) {return true}
    if nodes.ptr[n].c not=? 0 and k not=? 'for_' and gen_fuse_node_has_defer(GenWord(nodes.ptr[n].c)) {return true}
    loop i in [0..nkids(n)) {
        if gen_fuse_node_has_defer(kid(n i)) {return true}
    }
    false
}

gen_fuse_straight_between=(blk_n:GenWord i0:int64 i1:int64):>bool=>$unsafe {
    if blk_n <=? 0 or nodes.ptr[blk_n].kind not=? 'block' {return false}
    loop i in [i0 + 1..i1) {
        let sk=nodes.ptr[kid(blk_n i)].kind
        if sk not=? 'vardecl' and sk not=? 'assign' {return false}
    }
    true
}

gen_fuse_resolve_source=(@plan:GenFusePlan ok_src:dict<int64 int64> @resolved:dict<int64 bool> sidx:int64 active_fns:array<int64> depth:int64):>void=>$unsafe {
    if resolved.has(sidx) {return}
    resolved[sidx]=true
    let src=plan.pool[sidx]
    let fp=src.fn_inst
    let ncaps=fns.ptr[fp].caps.length
    let fused:array<int64>=[]
    let exprs:array<int64>=[]
    let next_active=[active_fns... fp]
    if src.factory_fn >? 0 {next_active.push(src.factory_fn)}

    loop ci in [0..ncaps) {
        let cap=fns.ptr[fp].caps.ptr[ci]
        let inn_l=GenWord(cap.inner)
        let t=prune(GenWord(locals.ptr[inn_l].type))
        let arg_e:GenWord=0
        let child_idx:int64=-1
        if src.kind =? 0 {
            let out_l=GenWord(cap.outer)
            if types.ptr[t].kind =? 'generator' and ok_src.has(out_l) {
                child_idx=ok_src[out_l]
                gen_fuse_resolve_source(@plan ok_src @resolved child_idx next_active depth + 1)
            }
        } else {
            let pi=gen_fuse_factory_param_idx(src.factory_fn GenWord(cap.outer))
            arg_e=kid(src.node pi)
            if types.ptr[t].kind =? 'generator' {
                if nodes.ptr[arg_e].kind =? 'ident' and nodes.ptr[arg_e].aux =? int32(1) {
                    let al=GenWord(nodes.ptr[arg_e].sym)
                    if ok_src.has(al) {
                        child_idx=ok_src[al]
                        gen_fuse_resolve_source(@plan ok_src @resolved child_idx next_active depth + 1)
                    }
                } else {
                    let inline_idx=gen_fuse_build_source(@plan arg_e next_active depth + 1)
                    if inline_idx >=? 0 {
                        gen_fuse_resolve_source(@plan ok_src @resolved inline_idx next_active depth + 1)
                        child_idx=inline_idx
                    }
                }
            }
        }
        fused.push(child_idx)
        exprs.push(arg_e)
    }
    plan.pool[sidx].cap_fused=fused
    plan.pool[sidx].cap_exprs=exprs
}

gen_fuse_plan=(f:GenWord):>GenFusePlan=>$unsafe {
    if nodes.length not=? gen_fuse_plan_nodes_len or fns.length not=? gen_fuse_plan_fns_len {
        if gen_fuse_plan_cache.length >? 0 {gen_fuse_plan_cache.clear()}
        gen_fuse_plan_nodes_len=nodes.length
        gen_fuse_plan_fns_len=fns.length
    }
    if gen_fuse_plan_cache.has(f) {return gen_fuse_plan_cache[f]}
    let plan=GenFusePlan[]
    if f <=? 0 or f >=? fns.length {return plan}
    let body=GenWord(fns.ptr[f].body)
    if body <=? 0 {
        gen_fuse_plan_cache[f]=plan
        return plan
    }
    let sc=GenFuseScan[]
    gen_fuse_scan_node(body @sc 0 body 0 false)
    if sc.cands.length =? 0 {
        gen_fuse_plan_cache[f]=plan
        return plan
    }

    let ok_src=dict<int64 int64>()
    # Pass 1: direct `for_ (aux = 5)` and combined-header `while_` consumers.
    loop l in sc.cands {
        if sc.disqualified.has(l) or (sc.use_count.get(l) ?? 0) not=? 1 {continue}
        let uk=sc.use_kind.get(l) ?? 0
        if uk not=? 1 and uk not=? 4 {continue}
        let sidx=gen_fuse_build_source(@plan sc.cand_rhs[l] [f] 0)
        if sidx <? 0 {continue}
        if gen_fuse_has_managed_cap(plan sidx) {
            if sc.cand_block[l] not=? sc.use_block[l] or not gen_fuse_straight_between(sc.cand_block[l] sc.cand_idx[l] sc.use_idx[l]) {
                continue
            }
        }
        if gen_fuse_node_has_defer(GenWord(fns.ptr[plan.pool[sidx].fn_inst].body)) {
            if sc.cand_block[l] not=? sc.use_block[l] or sc.use_idx[l] not=? nkids(sc.cand_block[l]) - 1 {
                continue
            }
        }
        ok_src[l]=sidx
    }
    # Pass 2: propagate upstream through local generator pipelines (up to 6 hops).
    loop hop in [0..6) {
        let added=false
        loop l in sc.cands {
            if ok_src.has(l) or sc.disqualified.has(l) or (sc.use_count.get(l) ?? 0) not=? 1 {continue}
            let uk=sc.use_kind.get(l) ?? 0
            if uk not=? 2 and uk not=? 3 {continue}
            let par=sc.use_parent[l]
            if not sc.rhs_owner.has(par) {continue}
            let owner_l=sc.rhs_owner[par]
            if not ok_src.has(owner_l) {continue}
            let sidx=gen_fuse_build_source(@plan sc.cand_rhs[l] [f plan.pool[ok_src[owner_l]].fn_inst] hop + 1)
            if sidx <? 0 {continue}
            if gen_fuse_has_managed_cap(plan sidx) {
                if sc.cand_block[l] not=? sc.use_block[l] or not gen_fuse_straight_between(sc.cand_block[l] sc.cand_idx[l] sc.use_idx[l]) {
                    continue
                }
            }
            if gen_fuse_node_has_defer(GenWord(fns.ptr[plan.pool[sidx].fn_inst].body)) {
                if sc.cand_block[l] not=? sc.use_block[l] or sc.use_idx[l] not=? nkids(sc.cand_block[l]) - 1 {
                    continue
                }
            }
            ok_src[l]=sidx
            added=true
        }
        if not added {break}
    }

    if ok_src.length >? 0 {
        let resolved=dict<int64 bool>()
        loop [l sidx] in ok_src {
            gen_fuse_resolve_source(@plan ok_src @resolved sidx [f] 0)
            plan.locals_map[l]=sidx
            plan.decls_map[sc.cand_decl[l]]=l
            let uk=sc.use_kind.get(l) ?? 0
            let par=sc.use_parent[l]
            if uk =? 1 {
                plan.for_sources[par]=sidx
            } else if uk =? 4 and sc.while_infos.has(par) {
                let wi=sc.while_infos[par]
                plan.while_sources[par]=sidx
                plan.while_infos[par]=wi
                # Mark dead synthetic `let __kN = -1` decl for skipping when `k_l` is unused elsewhere in its block.
                let blk_n=sc.cand_block[l]
                let ci=sc.cand_idx[l]
                if blk_n >? 0 and ci + 1 <? nkids(blk_n) {
                    let kd=kid(blk_n ci + 1)
                    if nodes.ptr[kd].kind =? 'vardecl' and nkids(kd) =? 0 and GenWord(nodes.ptr[kd].sym) =? wi.k_l and (GenWord(locals.ptr[wi.k_l].flags) & (LF_CAPTURED | LF_ADDR)) =? 0 {
                        let k_other=false
                        loop si in [0..nkids(blk_n)) {
                            let st=kid(blk_n si)
                            if st =? kd or st =? par {continue}
                            if gen_subtree_uses_local(st wi.k_l) not=? 0 {k_other=true; break}
                        }
                        if not k_other {plan.skip_k_decls[kd]=true}
                    }
                }
            }
        }
        # Identify locals of `f` captured ONLY by fused `lazy_` sources (so effect_scan treats them as non-escaping).
        let fused_lazys=dict<int64 bool>()
        loop src in plan.pool {
            if src.kind =? 0 {fused_lazys[src.lazy_node]=true}
        }
        let non_fused_caps=dict<int64 bool>()
        loop cn in sc.all_clos {
            if fused_lazys.has(cn) {continue}
            let cf=GenWord(nodes.ptr[cn].sym)
            if cf >? 0 and cf <? fns.length {
                loop cap in fns.ptr[cf].caps {non_fused_caps[GenWord(cap.outer)]=true}
            }
        }
        let seen_fc=dict<int64 bool>()
        loop src in plan.pool {
            if src.kind not=? 0 {continue}
            let fp=src.fn_inst
            loop cap in fns.ptr[fp].caps {
                let ol=GenWord(cap.outer)
                if not non_fused_caps.has(ol) and not seen_fc.has(ol) {
                    seen_fc[ol]=true
                    plan.fused_only_captured.push(ol)
                }
            }
        }
        plan.active=true
    }
    gen_fuse_plan_cache[f]=plan
    plan
}

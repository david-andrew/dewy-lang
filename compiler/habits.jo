        "millis", "`elapsed()` (in seconds)",
        "constrain", "`clamp(x, lo, hi)`",
        "beginShape", "a list of points, `pts.push(vec2(x, y))`, then `polygon(pts, color)` or `polyline(pts, width, color)`",
        "vertex", "`pts.push(vec2(x, y))`, then `polygon(pts, color)` or `polyline(pts, width, color)`",
        "endShape", "`polygon(pts, color)` or `polyline(pts, width, color, closed = true)`",
        "noLoop", "a flag that stops changing things in update (draw runs every frame), or `quit()`",
        "frameRate", "`fps()` (frames a second, measured)",
        "saveCanvas", "`save_png(screenshot(), \"art.png\")`",
        "loadImage", "`load_texture(embed(\"cat.png\"))`",
        "textSize", "text's size argument: `text(s, pos, 32)`",
        "textAlign", "`text_centered(s, center, size)`",
        "colorMode", "`hsv(h, s, v)`, each from 0 to 1 (a hue of 200 degrees is `200.0 / 360.0`)",
        "lerpColor", "`lerp(a, b, t)` (colors are vec4s)",
        "randomGaussian", "`random_normal(mean, sd)`",
        "randomSeed", "`seed_random(n)`",
        "LEFT", "`.left` (keys and mouse buttons are written with a dot)",
        "RIGHT", "`.right` (keys and mouse buttons are written with a dot)",
        "iTime", "a field of the uniforms struct, given at each draw (`u.time`, with `elapsed()` passed in)",
        "iResolution", "a field of the uniforms struct (`u.resolution`, with `pixel_size()` passed in)",
        "iMouse", "a field of the uniforms struct (`u.mouse`, with `mouse_pos()` passed in)",
        "gl_FragColor", "what the fragment function gives back (its last line, a vec4)",
        "gl_FragCoord", "a position the vertex function passes on (`i.uv * u.resolution`)",
        "fragColor", "what the fragment function gives back (its last line, a vec4)",
        "JSON", "`to_json(x)`, `parse_json(s)`, and `from_json[T](s)` into a struct",
        "localStorage", "`save_value(name, x)` and `load_value(name, default)`",
        "btoa", "`base64_encode(bytes(s))`",
        "atob", "`base64_decode(s)` (bytes; an optional: none when it is not base64)",
        "isFinite", "`is_finite(x)`",
        "isNaN", "`is_nan(x)`",
        "Number", "`to_float(s)` (an optional: none when it is not a number) or `f64(x)`",
        "toExponential", "\"\{x:.2e}\"",
        "toLocaleString", "\"\{x:,}\" (thousands with commas)",
        "Phaser", "the plain functions: `random_int(lo, hi)` (hi left out), `tween(from, to, seconds)`, `clamp`, `distance`",
        "Promise", "`Actions` (`steps.then(0.3, (): drop())`), or a state changed a little in update each frame",
        "scene", "an enum of screens (`screen = Screen.play`), with a `match screen:` in update and in draw",
        "Array", "`fill(0, 8)` (eight zeros), `fill(fill(0, 8), 8)` (eight rows of them), or `[a, b, c]`",
        "Object", "a map's `m.keys()` and `m.values()`, or a struct for named fields",
        "setInterval", "`every(1, 30.0)` in update: true once each 30 seconds (the 1 tells timers apart)",
        "setTimeout", "`Actions`: `later.then(2.0, (): ...)`, and `later.update(dt)` in update"]
    i = 0
    loop i + 1 < table.len():
        if table[i] == name: return table[i + 1]
        i += 2
    ""

dewy_map_habit = (name: str) -> str:
    table = ["size", "`m.length`",
        "length", "`m.length`",
        "has_key", "`m.has(k)` or `k in? m`",
        "containsKey", "`m.has(k)` or `k in? m`",
        "items", "`loop [key value] in m \{ ... }`",
        "forEach", "`loop [key value] in m \{ ... }`"]
    i = 0
    loop i + 1 < table.len():
        if table[i] == name: return table[i + 1]
        i += 2
    ""

sloppy_map_habit = (name: str) -> str:
    table = ["set", "`m[k] = v`",
        "size", "`m.len()`",
        "length", "`m.len()`",
        "delete", "`m.remove(k)`",
        "has_key", "`m.has(k)` or `k in m`",
        "containsKey", "`m.has(k)` or `k in m`",
        "put", "`m[k] = v`",
        "items", "`loop k, v in m:`",
        "forEach", "`loop k, v in m:`"]
    i = 0
    loop i + 1 < table.len():
        if table[i] == name: return table[i + 1]
        i += 2
    ""

        "circle_lines", "`ring(center, radius, thickness, color)`",
        "rect_lines", "`rect_outline(x, y, w, h, thickness, color)`",
        "draw_rect_lines", "`rect_outline(x, y, w, h, thickness, color)`",
        "copy", "nothing: `ys = xs` copies (arrays and structs are values)",
        "clone", "nothing: `ys = xs` copies (arrays and structs are values)",
        "raw_input", "`input(prompt)`",
        "readline", "`read_line()`",
        "choice", "`random_item(xs)`",
        "sample", "`random_item(xs)` or `shuffle(xs)`",
        "randint", "`random_int(lo, hi)` (hi is left out)",

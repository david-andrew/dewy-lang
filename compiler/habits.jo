        "toLowerCase", "`lower`",
        "to_upper", "`upper`",
        "to_lower", "`lower`",
        "includes", "`contains` or `x in xs`",
        "isEmpty", "`is_empty`",
        "toString", "`str(x)`",
        "to_string", "`str(x)`",
        "substring", "a slice: `s[a..b)`",
        "substr", "a slice: `s[a..b)`",
        "parseInt", "`to_int` (it gives an `int?`: none when the text is not a number)",
        "parse_int", "`to_int` (it gives an `int?`: none when the text is not a number)",
        "atoi", "`to_int`",
        "parseFloat", "`to_float`",
        "forEach", "`each` or `loop x in xs:`",
        "items", "`loop k, v in m:`",
        "entries", "`loop k, v in m:`",
        "range", "a range: `[0..n)` counts from 0 to n - 1",

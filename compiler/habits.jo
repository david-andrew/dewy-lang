# The frozen implementation-language twin of habits.dewy, for the compilers without the
# Dewy frontend (tools/compiler/build.py). Change both, or neither.

struct Habit:
    dewy: str
    sloppy: str
    dewy_map: str
    sloppy_map: str

habit = (name: str) -> Habit: Habit(dewy_habit(name), sloppy_habit(name), dewy_map_habit(name), sloppy_map_habit(name))

sloppy_shaped = (hint: str, surface: str[]) -> bool:
    if find(hint, ", ") >= 0 or find(hint, "[]") >= 0 or find(hint, "): ") >= 0 or find(hint, "->") >= 0 or find(hint, "if let") >= 0: return true
    words = ["str", "f64", "f32", "i64", "i32", "i16", "i8", "u64", "u32", "u16", "u8", "mut", "struct", "enum", "elif", "len"]
    loop w in surface: words.push(w)
    i = 0
    loop i < len(hint):
        if not habit_word_start(hint[i]):
            i += 1
            continue
        j = i + 1
        loop j < len(hint) and habit_word_part(hint[j]): j += 1
        if hint[i..j) in words: return true
        i = j
    false

habit_word_start = (c: u8) -> bool: (c >= 'a' and c <= 'z') or (c >= 'A' and c <= 'Z') or c == '_'
habit_word_part = (c: u8) -> bool: habit_word_start(c) or (c >= '0' and c <= '9')

dewy_habit = (name: str) -> str:
    table = ["float", "`float64` (and `to_float(s)` for text)",
        "double", "`float64`",
        "number", "`float64`",
        "f64", "`float64`",
        "f32", "`float32`",
        "int", "`int64`",
        "Int", "`int64`",
        "integer", "`int64`",
        "long", "`int64`",
        "i64", "`int64`",
        "i32", "`int32`",
        "u8", "`uint8`",
        "u64", "`uint64`",
        "str", "`string`",
        "String", "`string`",
        "char", "`string` (a character is a one-character string)",
        "list", "`array<T>` (as `array<int64>`)",
        "List", "`array<T>` (as `array<int64>`)",
        "vector", "`array<T>` (as `array<int64>`)",
        "Vec", "`array<T>` (as `array<int64>`)",
        "dict", "`dict<K V>` (as `dict<string int64>`)",
        "Dict", "`dict<K V>` (as `dict<string int64>`)",
        "HashMap", "`dict<K V>` (as `dict<string int64>`)",
        "map", "`dict<K V>` (as `dict<string int64>`)",
        "length", "`.length`",
        "size", "`.length`",
        "len", "`.length`",
        "toString", "`string(x)`",
        "to_string", "`string(x)`",
        "forEach", "`loop x in xs \{ ... }`",
        "items", "`loop [key value] in m \{ ... }`",
        "entries", "`loop [key value] in m \{ ... }`",
        "self", "a parameter: functions take what they work on first (`move = (@p:Player dt:float64) => ...`, called as `p.move(dt)`)",
        "this", "a parameter: functions take what they work on first (`move = (@p:Player dt:float64) => ...`, called as `p.move(dt)`)",
        "includes", "`contains` or `x in? xs`",
        "delta_time", "`dt`, what update is given: `update = (dt:float64) => ...`",
        "deltaTime", "`dt`, what update is given: `update = (dt:float64) => ...`",
        "open", "`read_text(path)` (or `p\"file\".read_text`) gives the text or a file error; `write_text(path text)` and `append_file(path text)` write",
        "os", "the plain functions: `read_text`, `list_directory`, `run`, `env`, and paths, `p\"dir/file\"`",
        "isinstance", "`x is? T` (which member of a union x holds)",
        "Number", "`to_float(s)` (none when it is not a number) or `float64(x)`",
        "list_files", "`list_directory(path)`",
        "list_dir", "`list_directory(path)`",
        "copy", "nothing: `ys = xs` copies (arrays and records are values)",
        "clone", "nothing: `ys = xs` copies (arrays and records are values)",
        "deep_copy", "nothing: `ys = xs` copies (arrays and records are values)",
        "ljust", "`format(s \"<10\")`",
        "rjust", "`format(s \">10\")`",
        "center", "`format(s \"^10\")`",
        "zfill", "`format(n \"05\")`",
        "removeprefix", "`s.remove_prefix(p)`",
        "removesuffix", "`s.remove_suffix(p)`",
        "isEmpty", "`.is_empty`",
        "isdigit", "a regular expression, `s.matches(regex(r\"\\d+\"))`, or `to_int(s) is? int`",
        "isalpha", "a regular expression: `s.matches(regex(r\"[a-zA-Z]+\"))`",
        "isspace", "`s.trim() =? \"\"`",
        "ord", "`bytes(c)[0]` (the first UTF-8 byte; `chr(n)` goes back)",
        "setdefault", "`if k not in? m \{m[k] = v}`",
        "str", "`string(x)`",
        "float", "`float64(x)`, or `to_float(s)` for text",
        "items", "`loop [key value] in m \{ ... }`",
        "null", "`none`",
        "nil", "`none`",
        "None", "`none`",
        "undefined", "`none`",
        "True", "`true`",
        "False", "`false`",
        "is", "`=?` to compare values; `x is? T` tests a type",
        "isupper", "`s =? upper(s)`",
        "islower", "`s =? lower(s)`",
        "try", "nothing: errors are values, handled with `match result \{ ... }`, `if result is? error`, or passed on with `result or_throw`",
        "except", "`match result \{ ... }` or `if result is? error`: errors are values",
        "catch", "`match result \{ ... }` or `if result is? error`: errors are values",
        "raise", "`return MyError[...]`: an error is a value the function returns, named in its result type as `:>int64|MyError`",
        "throw", "`return MyError[...]`: an error is a value the function returns, named in its result type as `:>int64|MyError`",
        "while", "`loop condition \{ ... }`, which repeats while the condition holds",
        "elif", "`else if`",
        "append", "`push`"]
    i = 0
    loop i + 1 < table.len():
        if table[i] == name: return table[i + 1]
        i += 2
    ""

sloppy_habit = (name: str) -> str:
    table = ["index", "`find(s, x)` for text (-1 when it is not there), `index_of(xs, x)` for an array",
        "path_exists", "`file_exists(path)`",
        "exists", "`file_exists(path)`",
        "stat", "`file_size(path)`, `file_time(path)`, `is_dir(path)`",
        "sys_exit", "`exit(code)`",
        "stderr", "`eprint(...)`",
        "realpath", "`abs_path(path)`",
        "abspath", "`abs_path(path)`",
        "getenv", "`env(name)` (none when it is not set)",
        "sprintf", "a string with `\{x}` in it (`\"\{n:5.2}\"` formats)",
        "remove_file", "`delete_file(path)`",
        "split_whitespace", "`words(s)`",
        "strptime", "`parse_date(\"2026-10-14 08:15\")` (ISO dates and times)",
        "fromisoformat", "`parse_date(text)`",
        "parse_datetime", "`parse_date(text)`",
        "hexdigest", "`sha256(bytes or text)` (64 hex digits)",
        "errno", "`file_error()` (why the last file operation failed)",
        "strerror", "`file_error()` (why the last file operation failed)",
        "last_error", "`file_error()` (why the last file operation failed)",
        "mkdir_all", "`make_dirs(path)`",
        "makedirs", "`make_dirs(path)`",
        "read_lines", "`lines(read_file(path) ?? \"\")` (or `read_line()` for standard input, a line at a time)",
        "has_point", "`contains(r, p)`",
        "rect_contains", "`contains(r, p)`",
        "point_in_rect", "`contains(r, p)`",
        "mouse_scroll", "`mouse_wheel()`",
        "text_size", "`text_width(s, size)`",
        "measure_text", "`text_width(s, size)`",
        "get_ticks", "`time()` (or `elapsed()`, the game's clock)",
        "str_to_int", "`to_int(s)`",
        "parse_int", "`to_int(s)`",
        "list_files", "`list_dir(path)`",
        "erase", "`remove(i)`",
        "input_text", "`hud_text_field(r, value)` (or `ui_text_field` in a menu)",
        "ui_input_text", "`hud_text_field(r, value)` (or `ui_text_field` in a menu)",
        "deep_copy", "nothing: `ys = xs` copies (arrays and structs are values)",
        "mouse_button_pressed", "`mouse_pressed(.left)`",
        "mouse_button_down", "`mouse_down(.left)`",
        "get_mouse_position", "`mouse_pos()`",
        "mouse_position", "`mouse_pos()`",
        "is_key_down", "`key_down(.space)`",
        "is_key_pressed", "`key_pressed(.space)`",
        "IsKeyDown", "`key_down(.space)`",
        "delta_time", "`dt`, what update is given: `update = (dt: f64):`",
        "deltaTime", "`dt`, what update is given: `update = (dt: f64):`",
        "get_frame_time", "`dt`, what update is given: `update = (dt: f64):`",
        "mtof", "`midi_freq(n)`",
        "midi_to_freq", "`midi_freq(n)`",
        "midiToFreq", "`midi_freq(n)`",
        "load_sound", "`load_wav(embed(\"x.wav\"))` (or `load_ogg`)",
        "play_sound", "`play(s)`",
        "loadSound", "`load_wav(embed(\"x.wav\"))`",
        "save", "`save_data(key, text)`: kept between runs (`save_value` keeps a struct)",
        "load", "`load_data(key)`: what save_data kept (`load_texture`, `load_sound` read files)",
        "window_visible", "`window_focused()`",
        "is_focused", "`window_focused()`",
        "has_focus", "`window_focused()`",
        "touch_pos", "`touches()` (each finger's place)",
        "get_touches", "`touches()`",
        "touch_count", "`touches().len()`",
        "is_touch", "`touch_input()`",
        "is_mobile", "`touch_input()` (the last input was a finger)",
        "True", "`true`",
        "False", "`false`",
        "None", "`none`",
        "nil", "`none`",
        "undefined", "`none`",
        "self", "a parameter: functions take what they work on first (`move = (p: mut Player, dt: f64): ...`, called as `p.move(dt)`)",
        "this", "a parameter: functions take what they work on first (`move = (p: mut Player, dt: f64): ...`, called as `p.move(dt)`)",
        "float", "`f64` (and `to_float(s)` for text)",
        "double", "`f64`",
        "float64", "`f64`",
        "float32", "`f32`",
        "number", "`f64`",
        "string", "`str`",
        "String", "`str`",
        "boolean", "`bool`",
        "Boolean", "`bool`",
        "char", "`u8` (a character is its code: 'a' == 97)",
        "Int", "`int`",
        "integer", "`int`",
        "long", "`int`",
        "int64", "`int`",
        "int32", "`i32`",
        "list", "`T[]` (an array: `int[]`)",
        "List", "`T[]` (an array: `int[]`)",
        "vector", "`T[]` (an array: `int[]`)",
        "Vec", "`T[]` (an array: `int[]`)",
        "dict", "`\{K: V}` (a map: `\{str: int}`)",
        "Dict", "`\{K: V}` (a map: `\{str: int}`)",
        "HashMap", "`\{K: V}` (a map: `\{str: int}`)",
        "append", "`push`",
        "push_back", "`push`",
        "add", "`push`",
        "delete", "`remove(i)`",
        "remove_at", "`remove(i)`",
        "length", "`len`",

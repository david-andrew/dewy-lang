        "draw_cube", "`draw_mesh(cube_mesh(), transform(pos))` (a mesh made once, drawn each frame)",
        "draw_sphere", "`draw_mesh(sphere_mesh(), transform(pos))` (a mesh made once, drawn each frame)",
        "light", "`sun(direction)` or `point_light(pos, color)`",
        "directional_light", "`sun(direction)`",
        "console", "`print(x)`, and `eprint(x)` for errors",
        "Math", "the plain functions: `random()`, `sqrt(x)`, `floor(x)`, `max(a, b)`",
        "ljust", "`pad_end(s, n)` or \"\{s:<10}\"",
        "rjust", "`pad_start(s, n)` or \"\{s:>10}\"",
        "padStart", "`pad_start(s, n)`",
        "padEnd", "`pad_end(s, n)`",
        "zfill", "`pad_start(s, n, \"0\")` or \"\{x:05}\"",
        "center", "\"\{s:^10}\"",
        "title", "`capitalize` (the first letter)",
        "basename", "`file_name(path)`",
        "dirname", "`dir_name(path)`",
        "splitext", "`extension(path)` and `without_extension(path)`",
        "datetime", "`now()` (a Date: year, month, day, hour...) or `unix_time()`",
        "strftime", "`date_text(d)` or a string with d's fields",
        "randf", "`random()` (0 to 1)",
        "randi", "`random_int(lo, hi)`",
        "randi_range", "`random_int(lo, hi + 1)` (hi is left out)",
        "randf_range", "`random(lo, hi)`",
        "Color", "`rgb(r, g, b)` or `rgba(r, g, b, a)` (0 to 1)",
        "Vector2", "`vec2`",
        "Vector3", "`vec3`",
        "Vector2i", "`ivec2`",
        "Vector3i", "`ivec3`",
        "Vector4", "`vec4`",
        "deg2rad", "`radians(x)` or `90deg`",

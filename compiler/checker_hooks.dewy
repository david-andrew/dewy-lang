$runtime_checks
from p"check.jo" import (FK_INIT FK_NORMAL check_fn_body check_scopes check_stmt const_view_declare copy_write_warnings ctxs cx enter_module_context fns leave_module_context locals module_ctx prepare_value_helpers scope_mark scope_reset zonk_tree)
from p"icount.jo" import (IC_CHECK)
from p"icount_ops.dewy" import (ic_mod ic_restore)
from p"types.jo" import (T_VOID zonk)
from p"expr.jo" import (coerce lit_default)
from p"definite_walk.dewy" import (da_record)
from p"decimal_ops.dewy" import (decimal_assign_begin decimal_binding_type decimal_check_body decimal_local decimal_quantity_start decimal_wants)
from p"growth_ops.dewy" import (growth_assign growth_decl_after growth_decl_before)
from p"ide.jo" import (ide_hint_local)
from p"string_domain_ops.dewy" import (int_domain_declare string_domain_declare)
from p"ast.jo" import (kid nkids nodes)
from p"pcheck.jo" import (pc_try)
from p"sibling_ops.dewy" import (sibling_annotated sibling_binding sibling_establish sibling_flow_end sibling_flow_loops sibling_flow_start sibling_scalar sibling_statement sibling_syntax_type)
# Demand-driven checker hooks and pending body execution.
HKWord:type=int64<overflow='wrap'>
block_sibling=(n:int64 m:int64 code:int64):>void=>$unsafe {
    if code =? 1 {sibling_flow_loops(n)}
    else if code =? 2 {sibling_statement(n m)}
    else if code =? 3 {sibling_flow_start(n m)}
    else {sibling_flow_end(n)}
}
assign_begin=(s:int64 code:int64):>int64=>$unsafe {
    if code =? 1 {
        growth_assign(s)
        return 0
    }
    if code =? 2 {return decimal_assign_begin(s)}
    sibling_syntax_type(HKWord(nodes.ptr[s].b))
}
decl_annotated=(s:int64 t:int64 member:int64):>void=>$unsafe {
    sibling_annotated(s t member);
    return
}
decl_sibling=(s:int64 t:int64 code:int64):>int64=>$unsafe {
    if code =? 1 {sibling_binding(s t)} else {sibling_scalar(s t)}
}
decl_literal=(s:int64):>int64=>$unsafe {
    let t=decimal_binding_type(nodes.ptr[s].pos lit_default(HKWord(nodes.ptr[s].b)))
    let value=coerce(HKWord(nodes.ptr[s].b) t)
    nodes.ptr[s].b = int32(value)
    t
}
# (an unannotated binding of a constant decimal with a unit: its type on this check; 0 for any other)
decl_quantity_literal=(s:int64 t:int64):>int64=>$unsafe {
    let wanted=decimal_quantity_start(nodes.ptr[s].pos HKWord(nodes.ptr[s].b) t)
    if wanted not=? t {nodes.ptr[s].b=int32(coerce(HKWord(nodes.ptr[s].b) wanted))}
    wanted
}
decl_after=(s:int64 l:int64 t:int64 code:int64):>void=>$unsafe {
    if code =? 1 {growth_decl_before(s)}
    else if code =? 3 {sibling_establish(l)}
    else if code =? 4 {decimal_local(l nodes.ptr[s].pos t)}
    else if code =? 5 {growth_decl_after(s l t)}
    else if code =? 6 {string_domain_declare(l HKWord(nodes.ptr[s].b))}
    else if code =? 7 {int_domain_declare(l HKWord(nodes.ptr[s].b))}
    else if code =? 8 {const_view_declare(l HKWord(nodes.ptr[s].b))}
    else if code =? 9 {da_record(s)}
    else if code =? 10 {ide_hint_local(s l)}
}
run_pending_functions=(start:int64):>int64=>$unsafe {
    let k:HKWord=start
    loop k <? fns.length or prepare_value_helpers() {
        pc_try(k)
        if fns.ptr[k].state =? 0 and (fns.ptr[k].kind =? FK_NORMAL or fns.ptr[k].kind =? FK_INIT) and k not=? 0 {
            if fns.ptr[k].kind =? FK_INIT {
                let icb=ic_mod(IC_CHECK HKWord(fns.ptr[k].mod))
                if decimal_wants(k) {decimal_check_body(k)}
                else {check_init_now(k)}
                ic_restore(icb)
            }
            else {check_fn_body(k)}
        }
        k += 1
    }
    k
}
check_init_now=(k:int64):>void=>$unsafe {
    let m:HKWord=HKWord(fns.ptr[k].mod)
    let saved=cx
    let entered=enter_module_context(m)
    cx=module_ctx.ptr[m]
    let saved_floor=ctxs.ptr[cx].floor
    fns.ptr[k].state = 1
    let mark=scope_mark()
    ctxs.ptr[cx].floor = int32(check_scopes.names.length)
    let body:HKWord=HKWord(fns.ptr[k].body)
    loop j in [0..nkids(body)) {check_stmt(kid(body j))}
    scope_reset(mark)
    zonk_tree(body)
    loop l in fns.ptr[k].locals {
        let t=zonk(HKWord(locals.ptr[l].type))
        locals.ptr[l].type = int32(t)
    }
    copy_write_warnings(k)
    fns.ptr[k].ret = int32(T_VOID)
    fns.ptr[k].state = 2
    ctxs.ptr[cx].floor = saved_floor
    leave_module_context(m entered)
    cx=saved
}

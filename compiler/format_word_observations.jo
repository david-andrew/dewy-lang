use 'coerce_expression.dewy'
use 'overload_type_lookup.dewy'
use 'checker_tokens.dewy'
use 'checker_state.dewy'
use 'source_warnings.dewy'
use 'checks_compare_hints.dewy'
use 'checker_runtime_functions.dewy'
use 'unit_ops.dewy'
use 'error_ops.dewy'
use 'expression_types.dewy'
use 'units.jo'
use 'checker_type_entries.dewy'
use 'checker_signature.dewy'
use 'util.jo'
use 'diagnostic_exit.dewy'
use 'checker_exact.dewy'
use 'exact_check_hooks.dewy'
use 'type_ops.dewy'
use 'checker_source_positions.dewy'
use 'checker_expr.dewy'
use 'checks_assign_hooks.dewy'
use 'checks_builders.dewy'
use 'types.jo'
use 'ast.jo'
use 'check.jo'
use 'expr.jo'

const FORMAT_WORD_UNSTABLE = LF_ASSIGNED | LF_CAPTURE | LF_CAPTURED | LF_SHARED | LF_ADDR | LF_EXPOSED | LF_ALIAS | LF_BYREF

format_word_reset = ():
    format_word_defs.clear()
    format_word_heads.clear()
    format_word_requests = []
    format_word_inst = 0

# Only checked, initialized lexical declarations enter the index. Their
# binding IDs are in scope only after the initializer has been checked.
format_word_define = (s: int, l: int):
    k = nodes[int(nodes[s].b)].kind
    if k == .match_ or k == .if_ or k == .iflet: format_word_defs[l] = s

# Inspect the value-producing arms only. A terminating arm yields no value.
# Result blocks may have effects, which still run at the original definition.
format_word_range = (n: int) -> bool:
    if n == 0: return false
    t = prune(ntype(n))
    if t == T_NEVER: return true
    k = nodes[n].kind
    if k == .block and nodes[n].aux != 0: return format_word_range(block_value(n))
    if k == .match_:
        loop i in [0..nkids(n)):
            if not format_word_range(int(nodes[kid(n, i)].b)): return false
        return true
    if k == .if_ or k == .iflet:
        return format_word_range(int(nodes[n].b)) and format_word_range(int(nodes[n].c))
    if k == .conv and t == T_MATH_INT:
        a = int(nodes[n].a)
        if nodes[n].aux == i32(int(CV.none_)):
            at = prune(ntype(a))
            if at == T_NEVER or at == T_MATH_INT: return format_word_range(a)
        if exact_format_remainder(n): return true
        if nodes[n].aux == i32(int(CV.int_)) and nodes[a].kind == .int_lit: return format_word_range(a)
    k == .int_lit and is_int(t) and (nodes[n].ival >= 0 or types[t].sign and not has_flag(n, NF_U64))

format_word_select = (part: int):
    if format_word_inst == 0: format_word_inst = runtime_fn("__fmt_word")
    nodes[part].sym = i32(format_word_inst)

# Resolve the normal overload at the observation. Delay its instantiation
# until all writes, captures and address-taking in this body are known.
format_word_try = (part: int, writer: str, buffer: int, pos: int) -> bool:
    value = int(nodes[part].a)
    remainder = exact_format_remainder(value)
    l = 0
    owner = 0
    if not remainder:
        if nodes[value].kind != .ident or nodes[value].aux != i32(int(SK.local)) or cx < 0: return false
        l = int(nodes[value].sym)
        if not format_word_defs.has(l) or int(locals[l].flags) & FORMAT_WORD_UNSTABLE != 0: return false
        owner = int(ctxs[cx].inst)
        if owner == 0 or int(locals[l].owner) != owner or fns[owner].kind != FK_NORMAL: return false
    decl = resolve_by_types(intern(writer), [buffer, T_MATH_INT], pos, true, true)
    binds = by_types_binds
    inner = decl
    if writer == "__dewy_fmt":
        if files[pos_file(nodes[decl].pos)].path == lib_dir + "/core/fmt.jo" and fn_sig(decl).generic:
            inner = resolve_by_types(intern("__fmt"), [buffer, T_MATH_INT], pos, true, true)
        else: inner = 0
    if inner == 0 or files[pos_file(nodes[inner].pos)].path != lib_dir + "/math_int.jo":
        nodes[part].sym = i32(get_fn_inst(decl, binds, pos))
    else if remainder: format_word_select(part)
    else:
        next = format_word_heads.get(owner) ?? 0
        format_word_requests.push(WordFormatRequest(part, l, decl, binds, next))
        format_word_heads[owner] = format_word_requests.len()
    true

# No body walk: settle only requested observations, with one range query per
# defining write. A later write can precede a read on a loop back edge or in
# deferred code, so reject any write other than the initializer.
format_word_finish = (owner: int):
    if format_word_heads.len() == 0: return
    head = format_word_heads.get(owner) ?? 0
    if head == 0: return
    format_word_heads.remove(owner)
    bounds: {int: bool} = {}
    loop head != 0:
        r = format_word_requests[head - 1]
        head = r.next
        s = format_word_defs[r.binding]
        if int(locals[r.binding].flags) & FORMAT_WORD_UNSTABLE == 0 and nodes[s].kind == .vardecl and int(nodes[s].sym) == r.binding:
            if not bounds.has(s): bounds[s] = format_word_range(int(nodes[s].b))
            if bounds[s]:
                format_word_select(r.part)
                continue
        nodes[r.part].sym = i32(get_fn_inst(r.decl, r.binds, nodes[r.part].pos))

fmt_part = (part: int, pos: int):
    # Formatting observes the exact result; it is not a fixed-width store.
    # Reveal a fixed-width arithmetic node to mathematical int before overload selection.
    observed = int(nodes[part].a)
    if dewy_at(pos) and exact_type(ntype(observed), pos) and exact_potential(observed): exact_int_result(observed, true)
    t = prune(ntype(int(nodes[part].a)))
    oom_unhandled(t, pos, "showing it")
    shown = if is_quantity(t) and nodes[part].sval < 0 and dewy_at(pos): quantity_display(int(nodes[part].a)) else: 0
    if shown != 0:
        nodes[part].a = i32(shown)
        t = T_STR
    else if is_quantity(t):
        reading = if dewy_at(pos): quantity_shown_number(int(nodes[part].a)) else: 0
        if reading != 0:
            nodes[part].a = i32(reading)
            t = prune(ntype(reading))
        else:
            nodes[part].a = i32(quantity_number(int(nodes[part].a)))
            t = quantity_base(t)
    if types[t].kind == .fixed:
        # (shown like an array: [1, 2, 3])
        t = mk_array(int(types[t].elem))
        coerce(int(nodes[part].a), t)
    # (never: what does not come back, as panic(...), or a function skipped after its error)
    if t == T_NEVER:
        coerce(int(nodes[part].a), T_STR)
        t = T_STR
    if types[t].kind == .void_:
        why = void_rec_hint(int(nodes[part].a))
        # (print(xs.reverse()): Python's in-place methods give None)
        if why == "" and dewy_at(nodes[part].pos) and nodes[int(nodes[part].a)].kind != .ident: why = " (this gives nothing: a method that changes its object, as `xs.sort()` or `xs.reverse()`, gives no value; show the object afterwards, or make a new one with `xs.sorted()` or `xs.reversed()`)"
        fatal(nodes[int(nodes[part].a)].pos, "cannot format a value of type void{why}")
    # (a type shown is its spelling: `"{int64}"`, `printl(Point)`)
    if types[t].kind == .typeval and dewy_at(nodes[part].pos):
        e = int(nodes[part].a)
        nodes[e] = nodes[bc_str(type_str(int(types[t].elem), true), nodes[e].pos)]
        check_expr(e, T_STR)
        t = T_STR
    if types[t].kind == .typeval or types[t].kind == .module: fatal(nodes[int(nodes[part].a)].pos, "this is a type or module, not a value (a value of a type is made by calling it: `T()`)")
    if types[t].kind == .ptr or types[t].kind == .cfn: fatal(nodes[int(nodes[part].a)].pos, "a {dt(t)} is not printed: its address is `int(p as *u8)` (in hex, \"\{int(p as *u8):#x}\")")
    bt = mk_array(T_U8)
    if nodes[part].sval >= 0:
        # ({hits / shots:.1%} with whole numbers: the fraction is gone before it is shown)
        e = int(nodes[part].a)
        spec = name_of(int(nodes[part].sval))
        if is_int(t) and nodes[e].kind == .binary and nodes[e].op == i32(int(Tok.slash)) and len(spec) > 0 and (spec[len(spec) - 1] == '%' or spec[len(spec) - 1] == 'f' or find_byte(spec, '.') >= 0):
            warn(nodes[e].pos, "this divides whole numbers, dropping the fraction before it is formatted: `f64(a) / b` keeps it")
        nodes[part].sym = i32(resolve_by_types(intern("__fmt_spec"), [bt, t, T_STR], pos, true))
    else:
        writer = "__fmt"
        if dewy_at(pos): writer = "__dewy_fmt"
        # Select the representation before instantiating the generic formatter.
        # The semantic overload is still chosen first; only the bundled default
        # may use a proved word, with no new fixed-width storage obligation.
        if t == T_MATH_INT and format_word_try(part, writer, bt, pos): return
        nodes[part].sym = i32(resolve_by_types(intern(writer), [bt, t], pos, true))

$runtime_checks

from p"checks_text.dewy" import (sym_kind_of)
from p"expr.jo" import (CV)
from p"checked_eval.dewy" import (cx_token_values)
from p"@lib/core/str.jo" import (starts_with)
from p"ast.jo" import (NF_BROADCAST NF_CHECKED NF_U64 add_flag has_flag kid mk nkids nodes set_list)
from p"check.jo" import (syms binding_const_init ceval dewy_at ensure_bundled_import lib_dir runtime_fn target_wasm universe)
from p"check_metadata.dewy" import (no_web_check op_text)
from p"checks_thin.dewy" import (resolve_type)
from p"checker_expr.dewy" import (check_expr lookup)
from p"checker_state.dewy" import (SK)
from p"checker_tokens.dewy" import (Tok)
from p"checker_types.dewy" import (TypeInfo)
from p"checks_builders.dewy" import (bc_bool bc_call bc_field bc_ident bc_int bc_str)
from p"expr.jo" import (CV bc_bin bundled_bigint_type coerce finalize_literal int_fits last_checked move_divisor ntype rational_constant rational_constant_parts rational_constants rational_shown wrap_conv)
from p"node_store.dewy" import (Node)
from p"quantity_algebra.dewy" import (QuantityLadder QuantityScale qa_base_dimension qa_combine_dimensions qa_dimension_str qa_intern_quantity_tag qa_intern_quantity_unit qa_power_dimension qa_quantity_gcd qa_quantity_ladder qa_quantity_scale)
from p"types.jo" import (T_BOOL T_F32 T_FLOAT T_INT T_MATH_INT T_STR T_VOID is_float is_int is_numeric mk_type prune structs tkind type_eq types)
from p"type_ops.dewy" import (dt mk_array mk_union)
from p"units.jo" import (bundled_rational_type is_quantity quantity_base quantity_internal quantity_left_literal quantity_right_literal quantity_scales quantity_tags quantity_unary_literal quantity_units)
from p"util.jo" import (files intern name_of pos_file)
from p"diagnostic_exit.dewy" import (fatal)
from p"x64_emit.dewy" import (st)

UnitWord:type=int64<overflow='wrap'>
quantity_dimension=(t0:UnitWord):>int64=>$unsafe {
    let t=prune(t0)
    if types.ptr[t].kind =? 'quantity' or types.ptr[t].kind =? 'dimension' {return UnitWord(types.ptr[t].st)}
    0
}
combine_dimensions=(a:UnitWord b:UnitWord sign:UnitWord pos:UnitWord):>int64=>{
    qa_combine_dimensions(a b sign pos)
}
# (dim raised to num/den; a root finer than the stored denominator is an error)
power_dimension=(dim:UnitWord num:UnitWord pos:UnitWord den:UnitWord=1):>int64=>{
    qa_power_dimension(dim num pos den)
}
quantity_numeric=(t0:UnitWord):>bool=>$unsafe {
    let t=prune(t0)
    let k=types.ptr[t].kind
    if k =? 'param' or k =? 'var' or is_numeric(t) {return true}
    if bundled_bigint_type(t) {return true}
    if k not=? 'struct_' {return false}
    let si=UnitWord(types.ptr[t].st)
    let d=UnitWord(structs.ptr[si].decl)
    d not=? 0 and structs.ptr[si].name =? "Rational" and files[pos_file(nodes.ptr[d].pos)].path =? "{lib_dir}/rational.dewy"
}
# (tag: how the quantity shows and where an offset scale's zero is; see quantity_tags)
mk_quantity=(base:int64 dim:int64 pos:int64=0 tag:int64=0):>int64=>{
    if dim =? 0 {return base}
    if not quantity_numeric(base) {fatal(pos "physical quantities need a numeric representation, found {dt(base)}")}
    mk_type(TypeInfo(kind='quantity' elem=int32(base) st=int32(dim) bits=int32(tag)) [])
}
mk_dimension=(dim:UnitWord):>int64=>{
    mk_type(TypeInfo(kind='dimension' st=int32(dim)) [])
}
dimension_str=(dim:int64):>string=>{
    qa_dimension_str(dim)
}
quantity_mismatch=(pos:UnitWord a:UnitWord b:UnitWord):>void=>{
    fatal(pos "dimension mismatch: {dimension_str(quantity_dimension(a))} and {dimension_str(quantity_dimension(b))} ({dt(a)} and {dt(b)})")
}
resolve_quantity_type=(n:UnitWord):>int64=>$unsafe {
    let a=resolve_type(UnitWord(nodes.ptr[n].a))
    let ad=quantity_dimension(a)
    let op=cx_token_values.ptr[UnitWord(nodes.ptr[n].op)]
    if op =? 'caret' {
        if types.ptr[a].kind not=? 'dimension' {fatal(nodes.ptr[n].pos "raise the dimension factor to a power, not its numeric representation")}
        let e=UnitWord(nodes.ptr[n].b)
        if nodes.ptr[e].kind =? 'binary' and nodes.ptr[e].op =? int32(61) {
            return mk_dimension(power_dimension(ad ceval(UnitWord(nodes.ptr[e].a)).i nodes.ptr[n].pos ceval(UnitWord(nodes.ptr[e].b)).i))
        }
        if nodes.ptr[e].kind =? 'call' and nodes.ptr[UnitWord(nodes.ptr[e].a)].kind =? 'ident' and nodes.ptr[UnitWord(nodes.ptr[e].a)].name =? int32(intern("__dewy_divide")) and nkids(e) =? 2 {
            return mk_dimension(power_dimension(ad ceval(kid(e 0)).i nodes.ptr[n].pos ceval(kid(e 1)).i))
        }
        let power=ceval(e).i
        return mk_dimension(power_dimension(ad power nodes.ptr[n].pos))
    }
    let b=resolve_type(UnitWord(nodes.ptr[n].b))
    let bd=quantity_dimension(b)
    let sign=if op =? 'slash' {-1} else {1}
    let dim=combine_dimensions(ad bd sign nodes.ptr[n].pos)
    let ak=types.ptr[a].kind
    let bk=types.ptr[b].kind
    if ak =? 'dimension' and bk =? 'dimension' {return mk_dimension(dim)}
    if bk =? 'dimension' {return mk_quantity(quantity_base(a) dim nodes.ptr[n].pos)}
    if ak =? 'dimension' and op =? 'star' {return mk_quantity(quantity_base(b) dim nodes.ptr[n].pos)}
    fatal(nodes.ptr[n].pos "a quantity type combines one numeric representation with physical dimensions")
    0
}
quantity_gcd=(a0:UnitWord b0:UnitWord):>int64=>{
    qa_quantity_gcd(a0 b0)
}
quantity_scale=(num0:UnitWord den0:UnitWord shown:UnitWord=0):>int64=>{
    qa_quantity_scale(num0 den0 shown)
}
# A marked, representation-preserving conversion retains exact constant data
# through ordinary AST cloning. Its child is the same numeric value as a plain
# program would use; there is no runtime unit descriptor.
quantity_constant=(n:UnitWord num:UnitWord den:UnitWord dim:UnitWord expected:UnitWord shown:UnitWord=0):>int64=>$unsafe {
    if den =? 0 {fatal(nodes.ptr[n].pos "division by zero in a physical quantity constant")}
    let scale=quantity_scale(num den shown)
    let value=quantity_scales[scale]
    let pos=nodes.ptr[n].pos
    let hint=if dim not=? 0 and not is_quantity(expected) {0} else {quantity_base(expected)}
    let a:UnitWord=0
    if is_float(hint) {
        a=mk('float_lit' pos)
        nodes.ptr[a].fval=float64(value.numerator) / float64(value.denominator)
        check_expr(a hint);
    }
    # (a written decimal holds fractions, `let t = 0.0m`, as a plain 0.0 does)
    else if value.denominator =? 1 and not bundled_rational_type(hint) and (value.shown =? 0 or is_int(hint)) {
        a=bc_int(value.numerator pos)
        check_expr(a (if is_int(hint) {hint} else {0}));
    }
    else {
        # (already in lowest terms: no gcd at run time. Written decimals keep printing as
        # decimals through units: 2.5kg*9.81N/kg/N is 24.525)
        a=rational_constant(value.numerator value.denominator pos false value.shown)
        check_expr(a 0);
        rational_constants[a]=rational_constant_parts(value.numerator value.denominator)
    }
    let tag=if dim not=? 0 and is_quantity(expected) and quantity_dimension(expected) =? dim {quantity_tag(expected)} else {0}
    let t=mk_quantity(ntype(a) dim 0 tag)
    nodes.ptr[n]=Node(kind='conv' pos=pos a=int32(a) aux=int32(int64(CV.quantity_const)) aux2=int32(scale) type=int32(t) flags=int32(NF_CHECKED))
    last_checked=n
    t
}
quantity_constant_scale=(n:UnitWord):>int64=>$unsafe {
    if nodes.ptr[n].kind =? 'conv' and nodes.ptr[n].aux =? int32(int64(CV.quantity_const)) {
        if is_float(quantity_base(ntype(n))) {return -1}
        return UnitWord(nodes.ptr[n].aux2)
    }
    if nodes.ptr[n].kind =? 'ident' and nodes.ptr[n].type not=? 0 {
        let source=binding_const_init(sym_kind_of(UnitWord(nodes.ptr[n].aux)) UnitWord(nodes.ptr[n].sym) nodes.ptr[n].pos)
        if source not=? 0 {return quantity_constant_scale(source)}
    }
    if nodes.ptr[n].kind =? 'int_lit' and not has_flag(n NF_U64) and nodes.ptr[n].ival not=? (-9223372036854775807 - 1) {return quantity_scale(nodes.ptr[n].ival 1)}
    # (an exact decimal literal, 0.001 in 0.001s)
    let parts=rational_constants.get(n)
    if parts not=? none {return quantity_scale(parts[0] parts[1] rational_shown.get(n) ?? 0)}
    -1
}
quantity_number=(n:UnitWord):>int64=>$unsafe {
    if not is_quantity(ntype(n)) {return n}
    if nodes.ptr[n].kind =? 'conv' and (nodes.ptr[n].aux =? int32(int64(CV.none_)) or nodes.ptr[n].aux =? int32(int64(CV.quantity_const))) {
        let inner=UnitWord(nodes.ptr[n].a)
        if is_quantity(ntype(inner)) {return quantity_number(inner)}
        return inner
    }
    let a=mk('conv' nodes.ptr[n].pos)
    nodes.ptr[a].a=int32(n)
    nodes.ptr[a].aux=int32(int64(CV.none_))
    nodes.ptr[a].type=int32(quantity_base(ntype(n)))
    add_flag(a NF_CHECKED)
    a
}
quantity_result=(n:UnitWord dim:UnitWord):>int64=>{
    finalize_literal(n);
    let t=mk_quantity(ntype(n) dim)
    if dim not=? 0 {wrap_conv(n CV.none_ t)}
    add_flag(n NF_CHECKED)
    last_checked=n
    t
}
quantity_constant_fits=(n:UnitWord target:UnitWord):>bool=>{
    if n =? 0 or not is_quantity(ntype(n)) or not is_quantity(target) {return false}
    if quantity_dimension(ntype(n)) not=? quantity_dimension(target) {return false}
    let scale=quantity_constant_scale(n)
    if scale <? 0 {return false}
    let base=quantity_base(target)
    let q=quantity_scales[scale]
    if is_float(base) or bundled_rational_type(base) {return true}
    is_int(base) and q.denominator =? 1 and int_fits(q.numerator base)
}
# An int quantity promotes to the exact rational quantity of its dimension and
# temperature kind, as an int promotes to a rational.
quantity_int_promotes=(from_:UnitWord to:UnitWord):>bool=>{
    if not is_quantity(from_) or not is_quantity(to) or quantity_dimension(from_) not=? quantity_dimension(to) {return false}
    if quantity_point(from_) not=? quantity_point(to) or quantity_is_delta(from_) not=? quantity_is_delta(to) {return false}
    is_int(quantity_base(from_)) and bundled_rational_type(quantity_base(to))
}
quantity_coerce=(n:UnitWord target:UnitWord):>int64=>$unsafe {
    let source=ntype(n)
    if quantity_dimension(source) not=? quantity_dimension(target) {quantity_mismatch(nodes.ptr[n].pos source target)}
    if type_eq(source target) {return n}
    # (a temperature point and a difference are different values: neither holds the other)
    if quantity_internal =? 0 and ((quantity_point(target) and quantity_is_delta(source)) or (quantity_is_delta(target) and quantity_point(source))) {
        let point=if quantity_point(target) {target} else {source}
        let unit=quantity_point_unit(point)
        if quantity_point(target) {fatal(nodes.ptr[n].pos "a temperature difference cannot stand for a point: add it to one (`ref + d`), or keep it as a difference")}
        fatal(nodes.ptr[n].pos "a temperature point cannot stand for a difference: subtract two points (`let rise = 25{unit} - 5{unit}`), or use kelvin (`5K`)")
    }
    let constant=quantity_constant_scale(n)
    if constant >=? 0 and (is_numeric(quantity_base(target)) or bundled_rational_type(quantity_base(target))) {
        let scale=quantity_scales[constant]
        if scale.denominator not=? 1 and is_int(quantity_base(target)) {fatal(nodes.ptr[n].pos "fractional quantity cannot convert to {dt(target)}")}
        quantity_constant(n scale.numerator scale.denominator quantity_dimension(target) target scale.shown);
        return n
    }
    # Save the source before introducing an erasing conversion: that conversion
    # must not point back to n after n is replaced by the converted result.
    let source_copy=nodes.length
    nodes.push(nodes.ptr[n])
    let a=quantity_number(source_copy)
    # Do not mutate a source node that may be shared with a place or another use.
    let copy=nodes.length
    nodes.push(nodes.ptr[a])
    coerce(copy quantity_base(target));
    nodes.ptr[n]=nodes.ptr[copy]
    wrap_conv(n CV.none_ target)
    add_flag(n NF_CHECKED)
    n
}
quantity_transmute=(n:UnitWord a:UnitWord from_:UnitWord to:UnitWord):>int64=>$unsafe {
    let fb=quantity_base(from_)
    let tb=quantity_base(to)
    if not type_eq(fb tb) {fatal(nodes.ptr[n].pos "quantity transmute must preserve its numeric representation ({dt(fb)} to {dt(tb)})")}
    let scale=quantity_constant_scale(a)
    if scale >=? 0 {
        let q=quantity_scales[scale]
        return quantity_constant(n q.numerator q.denominator quantity_dimension(to) to q.shown)
    }
    nodes.ptr[n]=nodes.ptr[a]
    wrap_conv(n CV.none_ to)
    add_flag(n NF_CHECKED)
    last_checked=n
    to
}
quantity_product_fits=(a:UnitWord b:UnitWord):>bool=>{
    # The minimum signed value is excluded from the small constant evaluator.
    if a =? (-9223372036854775807 - 1) or b =? (-9223372036854775807 - 1) {return false}
    b =? 0 or abs(a) <=? 9223372036854775807 // abs(b)
}
quantity_fold=(n:UnitWord a:UnitWord b:UnitWord dim:UnitWord op:Tok expected:UnitWord):>bool=>$unsafe {
    # Explicit machine widths use their ordinary wrapping arithmetic.
    if is_quantity(ntype(a)) and is_int(quantity_base(ntype(a))) and quantity_base(ntype(a)) not=? T_INT and quantity_base(ntype(a)) not=? T_MATH_INT {return false}
    if is_quantity(ntype(b)) and is_int(quantity_base(ntype(b))) and quantity_base(ntype(b)) not=? T_INT and quantity_base(ntype(b)) not=? T_MATH_INT {return false}
    let ai=quantity_constant_scale(a)
    let bi=quantity_constant_scale(b)
    if ai <? 0 or bi <? 0 {return false}
    let av=quantity_scales[ai]
    let bv=quantity_scales[bi]
    let shown=av.shown | bv.shown
    let an=av.numerator
    let ad=av.denominator
    let bn=bv.numerator
    let bd=bv.denominator
    if op =? 'slash' {
        if bn =? 0 {fatal(nodes.ptr[n].pos "division by zero in a physical quantity constant")}
        let swap=bn
        bn=bd
        bd=swap
    }
    if op =? 'star' or op =? 'slash' {
        let g=quantity_gcd(an bd)
        an=an // g
        bd=bd // g
        g=quantity_gcd(bn ad)
        bn=bn // g
        ad=ad // g
        if not quantity_product_fits(an bn) or not quantity_product_fits(ad bd) {return false}
        quantity_constant(n an * bn ad * bd dim expected shown);
        return true
    }
    if op =? 'plus' or op =? 'minus' {
        let g=quantity_gcd(ad bd)
        if not quantity_product_fits(an bd // g) or not quantity_product_fits(bn ad // g) or not quantity_product_fits(ad bd // g) {return false}
        let left=an * (bd // g)
        let right=bn * (ad // g)
        if op =? 'minus' {right=-right}
        if right >? 0 and left >? 9223372036854775807 - right {return false}
        if right <? 0 and left <? -9223372036854775807 - right {return false}
        quantity_constant(n left + right ad * (bd // g) dim expected shown);
        return true
    }
    false
}
quantity_operands=(a:UnitWord b:UnitWord):>array<int64>=>$unsafe {
    let aa=quantity_number(a)
    let bb=quantity_number(b)
    # Exact scales are rounded only where a floating representation requests it.
    let ai=quantity_constant_scale(a)
    let bi=quantity_constant_scale(b)
    if is_float(ntype(bb)) and ai >=? 0 {
        let q=quantity_scales[ai]
        aa=mk('unit_lit' nodes.ptr[a].pos)
        quantity_constant(aa q.numerator q.denominator 0 ntype(bb));
    }
    if is_float(ntype(aa)) and bi >=? 0 {
        let q=quantity_scales[bi]
        bb=mk('unit_lit' nodes.ptr[b].pos)
        quantity_constant(bb q.numerator q.denominator 0 ntype(aa));
    }
    add_flag(aa NF_CHECKED)
    add_flag(bb NF_CHECKED)
    [aa bb]
}
quantity_binary_plain=(n:UnitWord a:UnitWord b:UnitWord expected:UnitWord):>int64=>$unsafe {
    let op=cx_token_values.ptr[UnitWord(nodes.ptr[n].op)]
    let ad=quantity_dimension(ntype(a))
    let bd=quantity_dimension(ntype(b))
    let dim=ad
    let cmp=op =? 'eq' or op =? 'ne' or op =? 'lt' or op =? 'le' or op =? 'gt' or op =? 'ge'
    if op =? 'star' {dim=combine_dimensions(ad bd 1 nodes.ptr[n].pos)} else if op =? 'slash' {dim=combine_dimensions(ad bd (-1) nodes.ptr[n].pos)}
    else if op =? 'plus' or op =? 'minus' or cmp {
        if ad not=? bd {quantity_mismatch(nodes.ptr[n].pos ntype(a) ntype(b))}
    }
    else {fatal(nodes.ptr[n].pos "operator {op_text(op nodes.ptr[n].pos)} is not defined for physical quantities")}
    if quantity_fold(n a b dim op expected) {return ntype(n)}
    # Attaching/removing a canonical unit does not perform arithmetic at all.
    # In particular float * 1 must not survive as an otherwise unoptimized fmul.
    let unit=if op =? 'star' and is_quantity(ntype(a)) and quantity_constant_scale(a) >=? 0 {a} else {b}
    let value=if unit =? a {b} else {a}
    let scale=quantity_constant_scale(unit)
    if scale >=? 0 and is_quantity(ntype(unit)) and (op =? 'star' or (op =? 'slash' and is_float(quantity_base(ntype(value))))) {
        let q=quantity_scales[scale]
        if q.numerator =? 1 and q.denominator =? 1 {
            let built=quantity_number(value)
            nodes.ptr[n]=nodes.ptr[built]
            return quantity_result(n dim)
        }
    }
    let operands=quantity_operands(a b)
    nodes.ptr[n].a=int32(operands[0])
    nodes.ptr[n].b=int32(operands[1])
    check_expr(n quantity_base(expected));
    if cmp {return T_BOOL}
    quantity_result(n dim)
}
quantity_arithmetic_plain=(n:UnitWord name:UnitWord a:UnitWord b:UnitWord expected:UnitWord):>int64=>$unsafe {
    let dim=quantity_dimension(ntype(a))
    let bd=quantity_dimension(ntype(b))
    let power=name =? intern("__dewy_power")
    let divide=name =? intern("__dewy_divide")
    if power {
        if bd not=? 0 {fatal(nodes.ptr[b].pos "a physical quantity exponent must be a dimensionless constant integer")}
        let bi=quantity_constant_scale(b)
        if bi <? 0 or quantity_scales[bi].denominator not=? 1 {fatal(nodes.ptr[b].pos "a physical quantity exponent must be a constant integer")}
        let exponent=quantity_scales[bi].numerator
        dim=power_dimension(dim exponent nodes.ptr[n].pos)
        let ai=quantity_constant_scale(a)
        if ai >=? 0 and exponent >=? -64 and exponent <=? 64 {
            let q=quantity_scales[ai]
            if exponent <? 0 {
                if q.numerator =? 0 {fatal(nodes.ptr[n].pos "division by zero in a physical quantity constant")}
                q=QuantityScale(q.denominator q.numerator q.shown)
            }
            let num:UnitWord=1
            let den:UnitWord=1
            let fits=true
            loop i in [0..abs(exponent)) {
                if not quantity_product_fits(num q.numerator) or not quantity_product_fits(den q.denominator) {
                    fits=false
                    break
                }
                num *= q.numerator
                den *= q.denominator
            }
            if fits {return quantity_constant(n num den dim expected q.shown)}
        }
    }
    else if divide {
        dim=combine_dimensions(dim bd (-1) nodes.ptr[n].pos)
        if quantity_fold(n a b dim 'slash' expected) {return ntype(n)}
        let scale=quantity_constant_scale(b)
        if scale >=? 0 and is_quantity(ntype(b)) and is_float(quantity_base(ntype(a))) {
            let q=quantity_scales[scale]
            if q.numerator =? 1 and q.denominator =? 1 {
                let built=quantity_number(a)
                nodes.ptr[n]=nodes.ptr[built]
                return quantity_result(n dim)
            }
        }
    }
    else {fatal(nodes.ptr[n].pos "floor division and remainder are not defined for physical quantities: divide by a unit first to count in it, as `(t/s) // 60` or `(t/minute) % 1`")}
    let operands=quantity_operands(a b)
    if power and quantity_scales[quantity_constant_scale(b)].numerator <? 0 and is_int(ntype(operands[0])) {
        let pos=nodes.ptr[n].pos
        ensure_bundled_import("rational.dewy" "$dewy_rational" pos)
        let value=mk('call' pos)
        nodes.ptr[value].a=int32(bc_field(bc_ident("$dewy_rational" pos) "rational" pos))
        set_list(value [operands[0]])
        check_expr(value 0);
        add_flag(value NF_CHECKED)
        operands[0]=value
    }
    set_list(n operands)
    check_expr(n quantity_base(expected));
    quantity_result(n dim)
}
quantity_unary_plain=(n:UnitWord expected:UnitWord):>int64=>$unsafe {
    let a=UnitWord(nodes.ptr[n].a)
    let dim=quantity_dimension(ntype(a))
    let op=cx_token_values.ptr[UnitWord(nodes.ptr[n].op)]
    if op not=? 'minus' and op not=? 'plus' {fatal(nodes.ptr[n].pos "operator {op_text(op nodes.ptr[n].pos)} is not defined for physical quantities")}
    let scale=quantity_constant_scale(a)
    if scale >=? 0 {
        let q=quantity_scales[scale]
        let numerator=if op =? 'minus' {-q.numerator} else {q.numerator}
        return quantity_constant(n numerator q.denominator dim expected q.shown)
    }
    nodes.ptr[n].a=int32(quantity_number(a))
    check_expr(n quantity_base(expected));
    quantity_result(n dim)
}
# Preserve the scalar compound-update path after checking the qualifier. The
# indexed/field path still captures and reacquires places in the usual checker.
quantity_compound=(s:UnitWord target:UnitWord):>bool=>$unsafe {
    if quantity_base(target) =? T_MATH_INT {return false}
    if not is_numeric(quantity_base(target)) or nodes.ptr[s].sval not=? 0 or has_flag(s NF_BROADCAST) {return false}
    if nodes.ptr[UnitWord(nodes.ptr[s].a)].kind not=? 'ident' {return false}
    if nodes.ptr[s].op not=? int32(48) and nodes.ptr[s].op not=? int32(49) {return false}
    let right=UnitWord(nodes.ptr[s].b)
    let literal=quantity_literal_syntax(right)
    check_expr(right target);
    right=last_checked
    # (t += 5°C: what is added to or taken from a temperature point is a difference)
    quantity_update_check(nodes.ptr[s].pos nodes.ptr[s].op =? int32(49) UnitWord(nodes.ptr[s].a) right target literal)
    if quantity_offset_tagged(target) or quantity_offset_tagged(ntype(right)) {right=quantity_delta_reading(right)}
    nodes.ptr[s].b=int32(quantity_number(coerce(right target)))
    true
}
# (e = 0.0J then e += x*J with x a float: an exact quantity variable cannot take a float one.
# The whole types, dimensions included, and the annotation that makes it a float quantity.)
quantity_float_update=(s:UnitWord target:UnitWord tr:UnitWord):>void=>$unsafe {
    if not is_quantity(target) or not dewy_at(nodes.ptr[s].pos) {return}
    let exact=bundled_rational_type(quantity_base(target)) or quantity_base(target) =? T_MATH_INT
    if not exact or not is_float(quantity_base(tr)) or quantity_dimension(tr) not=? quantity_dimension(target) {return}
    let place=UnitWord(nodes.ptr[s].a)
    if nodes.ptr[place].kind not=? 'ident' {return}
    let nm=name_of(UnitWord(nodes.ptr[place].name))
    let wanted=dt(mk_quantity(quantity_base(tr) quantity_dimension(target)))
    fatal(nodes.ptr[s].pos "'{nm}' holds an exact {dt(target)}, and this is a {dt(tr)}: a decimal literal with a unit, such as `0.0s`, is exact; write the floating type where it is made, as `let {nm}:{wanted} = ...`")
}
# t += x and t -= x on a temperature: a point moves by a difference (a literal is read as
# one); a difference moves by a difference.
quantity_update_check=(pos:UnitWord minus:bool place:UnitWord right:UnitWord target:UnitWord literal:bool):>void=>{
    let tr=ntype(right)
    if quantity_dimension(target) not=? base_dimension(4) or quantity_dimension(tr) not=? base_dimension(4) {return}
    let what=if minus {"take a point from a difference"} else {"add a point to a difference"}
    if quantity_is_delta(target) and quantity_point(tr) {quantity_difference_point(pos right tr what)}
    if not quantity_point(target) or not quantity_point(tr) or literal {return}
    if not minus {quantity_points_added(pos place right target)}
    let p=quantity_operand_text(place "t")
    let r=quantity_operand_text(right "ref")
    fatal(pos "`{p} - {r}` is a difference, not a temperature point, so `{p}` cannot hold it: write `let rise = {p} - {r}`, or subtract a difference (`5K`)")
}
base_dimension=(i:UnitWord):>int64=>{
    qa_base_dimension(i)
}
# (n calls the runtime function fname with the checked arguments args)
runtime_call=(n:UnitWord fname:string args:array<int64> result:UnitWord):>int64=>$unsafe {
    nodes.ptr[n].kind='call'
    nodes.ptr[n].aux=0
    set_list(n args)
    nodes.ptr[n].sym=int32(runtime_fn(fname))
    nodes.ptr[n].type=int32(result)
    add_flag(n NF_CHECKED)
    last_checked=n
    result
}
# (the bundled rational module's helper fname applied to the checked value a, at n)
rational_helper_call=(n:UnitWord fname:string a:UnitWord expected:UnitWord):>int64=>$unsafe {
    let pos=nodes.ptr[n].pos
    ensure_bundled_import("rational.dewy" "$dewy_rational" pos)
    let c=mk('call' pos)
    nodes.ptr[c].a=int32(bc_field(bc_ident("$dewy_rational" pos) fname pos))
    set_list(c [a])
    let t=check_expr(c expected)
    nodes.ptr[n]=nodes.ptr[last_checked]
    last_checked=n
    t
}
# A wait given a time library value: a `Duration` as its whole nanoseconds (a checked word), and a
# calendar period refused with the form to write. 0 for anything else.
time_record_duration=(t:UnitWord a:UnitWord what:string fix:string pos:UnitWord):>int64=>$unsafe {
    if tkind(t) not=? 'struct_' {return 0}
    let d=UnitWord(structs.ptr[UnitWord(types.ptr[t].st)].decl)
    if d =? 0 or files[pos_file(nodes.ptr[d].pos)].path not=? "{lib_dir}/time/core.dewy" {return 0}
    let shown=dt(t)
    if shown =? "Days" {fatal(nodes.ptr[a].pos "{what} takes a length of time, and a day or week is a calendar period, whose length depends on the date: write `{fix}`")}
    if shown =? "Months" {fatal(nodes.ptr[a].pos "{what} takes a length of time, and a month or year is a calendar period, whose length depends on the date: write the time it means, such as `{fix}`")}
    if shown not=? "Duration" {return 0}
    ensure_bundled_import("time/core.dewy" "$dewy_time" pos)
    let c=mk('call' pos)
    nodes.ptr[c].a=int32(bc_field(bc_ident("$dewy_time" pos) "wait_ns" pos))
    set_list(c [a])
    check_expr(c T_INT);
    last_checked
}
# (the checked number a as a float64)
quantity_float=(a:UnitWord):>int64=>$unsafe {
    let t=prune(ntype(a))
    if type_eq(t T_FLOAT) {return a}
    if not is_float(t) and not is_int(t) {return 0}
    let c=mk('conv' nodes.ptr[a].pos)
    nodes.ptr[c].a=int32(a)
    nodes.ptr[c].aux=int32(int64(CV.int2float))
    if is_float(t) {nodes.ptr[c].aux=int32(int64(CV.float_))}
    nodes.ptr[c].type=int32(T_FLOAT)
    add_flag(c NF_CHECKED)
    c
}
# Dewy's sleep and its trigonometry take quantities (physical-quantities.md): sleep a time,
# converted to whole nanoseconds; sin, cos and tan an angle, which counts whole turns, reduced
# exactly before evaluation; a plain number is an error (radians are `x*rad`). a is the
# checked argument.
dewy_quantity_call=(n:UnitWord name:UnitWord a:UnitWord expected:UnitWord):>int64=>$unsafe {
    let fname=name_of(name)
    let t=prune(ntype(a))
    let base=quantity_base(t)
    let number=quantity_number(a)
    add_flag(number NF_CHECKED)
    if fname =? "sleep" {
        if not is_quantity(t) {
            let d=time_record_duration(t a "sleep" "sleep(24hour)" nodes.ptr[n].pos)
            if d not=? 0 {
                if target_wasm {no_web_check(UnitWord(syms.ptr[lookup(name)].decl) nodes.ptr[n].pos)}
                return runtime_call(n "__task_sleep_ns" [coerce(d T_INT)] task_sleep_type())
            }
        }
        if not is_quantity(t) or quantity_dimension(t) not=? base_dimension(0) {
            fatal(nodes.ptr[a].pos "sleep takes a time, such as `sleep(300ms)` or `sleep(2s)` (found {dt(t)})")
        }
        if target_wasm {no_web_check(UnitWord(syms.ptr[lookup(name)].decl) nodes.ptr[n].pos)}
        if bundled_rational_type(base) {
            let ns=mk('call' nodes.ptr[n].pos)
            rational_helper_call(ns "_whole_nanoseconds" number T_INT);
            return runtime_call(n "__task_sleep_ns" [coerce(ns T_INT)] task_sleep_type())
        }
        if is_int(base) {
            let whole=mk('conv' nodes.ptr[a].pos)
            nodes.ptr[whole].a=int32(number)
            nodes.ptr[whole].aux=int32(int64(CV.int_))
            nodes.ptr[whole].type=int32(T_INT)
            add_flag(whole NF_CHECKED)
            let ns=bc_bin('star' whole bc_int(1000000000 nodes.ptr[a].pos) nodes.ptr[a].pos)
            check_expr(ns T_INT);
            return runtime_call(n "__task_sleep_ns" [last_checked] task_sleep_type())
        }
        if is_float(base) {return runtime_call(n "__task_sleep_seconds" [quantity_float(number)] task_sleep_type())}
        fatal(nodes.ptr[a].pos "sleep takes a time counted in an integer, rational or float (found {dt(t)})")
    }
    if not is_quantity(t) {fatal(nodes.ptr[a].pos "{fname} takes an angle, not a plain number: `{fname}(x*rad)` for radians, or `{fname}(45°)`, `{fname}(t*turn)` (`from units import rad`; found {dt(t)})")}
    if quantity_dimension(t) not=? base_dimension(7) {fatal(nodes.ptr[a].pos "{fname} takes an angle, such as `{fname}(45°)` (found {dt(t)})")}
    if bundled_rational_type(base) {return rational_helper_call(n "_{fname}_turns" number expected)}
    let turns=quantity_float(number)
    if turns =? 0 {fatal(nodes.ptr[a].pos "{fname} takes an angle counted in an integer, rational or float (found {dt(t)})")}
    runtime_call(n "__{fname}_turns" [turns] T_FLOAT)
}
intern_quantity_unit=(sym:string num:UnitWord den:UnitWord onum:UnitWord oden:UnitWord):>int64=>{
    qa_intern_quantity_unit(sym num den onum oden)
}
intern_quantity_tag=(display:UnitWord origin:UnitWord delta:bool):>int64=>{
    qa_intern_quantity_tag(display origin delta)
}
quantity_tag=(t0:UnitWord):>int64=>$unsafe {
    let t=prune(t0)
    if types.ptr[t].kind =? 'quantity' {return UnitWord(types.ptr[t].bits)}
    0
}
# (a temperature written in an offset unit, or a difference of temperatures)
quantity_offset_tagged=(t:UnitWord):>bool=>{
    let q=quantity_tags[quantity_tag(t)]
    q.origin not=? 0 or q.delta
}
quantity_is_delta=(t:UnitWord):>bool=>{
    quantity_tags[quantity_tag(t)].delta
}
# (the checked quantity n given tag; its number is unchanged)
quantity_retag=(n:UnitWord tag:UnitWord):>int64=>$unsafe {
    let t=ntype(n)
    if not is_quantity(t) or quantity_tag(t) =? tag {return t}
    let to=mk_quantity(quantity_base(t) quantity_dimension(t) nodes.ptr[n].pos tag)
    if nodes.ptr[n].kind =? 'conv' and (nodes.ptr[n].aux =? int32(int64(CV.none_)) or nodes.ptr[n].aux =? int32(int64(CV.quantity_const))) {nodes.ptr[n].type=int32(to)} else {wrap_conv(n CV.none_ to)}
    add_flag(n NF_CHECKED)
    last_checked=n
    to
}
# (the checked constant num/den canonical units of dim, in the number type of like)
quantity_offset_constant=(num:UnitWord den:UnitWord dim:UnitWord like:UnitWord pos:UnitWord):>int64=>{
    let c=mk('unit_lit' pos)
    quantity_constant(c num den dim mk_quantity(quantity_base(like) dim));
    c
}
# (n read as a difference: a temperature written in °C counts from 0 °C, so 20°C is 20 K)
quantity_delta_reading=(n:UnitWord):>int64=>$unsafe {
    let t=ntype(n)
    if not is_quantity(t) {return n}
    let q=quantity_tags[quantity_tag(t)]
    quantity_retag(n 0);
    if q.delta or q.origin =? 0 or quantity_units[q.origin].onum =? 0 {return n}
    let u=quantity_units[q.origin]
    let pos=nodes.ptr[n].pos
    let e=bc_bin('minus' n quantity_offset_constant(u.onum u.oden quantity_dimension(t) t pos) pos)
    quantity_internal_check(e)
}
# (n read as a point: its canonical number)
quantity_point_reading=(n:UnitWord):>int64=>{
    quantity_retag(n 0);
    n
}
# (x scaled in its own unit: (x - zero) op k + zero, so 20°C * 2 is 40°C)
quantity_scaled=(x:UnitWord k:UnitWord op:Tok x_first:bool pos:UnitWord):>int64=>{
    let t=ntype(x)
    let q=quantity_tags[quantity_tag(t)]
    let reading=quantity_delta_reading(x)
    let left=if x_first {reading} else {k}
    let right=if x_first {k} else {reading}
    let e=quantity_operation(op left right pos)
    if q.delta or q.origin =? 0 {return e}
    let u=quantity_units[q.origin]
    let sum=bc_bin('plus' e quantity_offset_constant(u.onum u.oden quantity_dimension(t) t pos) pos)
    quantity_internal_check(sum)
}
# (a op b checked; Dewy division is exact)
quantity_operation=(op:Tok a:UnitWord b:UnitWord pos:UnitWord):>int64=>{
    let e:UnitWord=0
    if op =? 'slash' and dewy_at(pos) {e=bc_call("__dewy_divide" [a b] pos)} else {e=bc_bin(op a b pos)}
    quantity_internal_check(e)
}
# (n becomes the checked e, tagged)
quantity_become=(n:UnitWord e:UnitWord tag:UnitWord):>int64=>$unsafe {
    nodes.ptr[n]=nodes.ptr[e]
    # (an exact division's divisor obligation moves with its call)
    move_divisor(e n)
    last_checked=n
    if is_quantity(ntype(n)) {return quantity_retag(n tag)}
    ntype(n)
}
# Literal-looking operands (`20°C`, `-5°F`), before they are checked. A converted one,
# `(20°C as °F)`, is a value of its own: a point.
quantity_literal_syntax=(e:UnitWord):>bool=>$unsafe {
    if e =? 0 or has_flag(e NF_CHECKED) {return false}
    let k=nodes.ptr[e].kind
    if k =? 'unary' {return quantity_literal_syntax(UnitWord(nodes.ptr[e].a))}
    if k =? 'binary' and nodes.ptr[e].op =? int32(60) {
        let x=nodes.ptr[UnitWord(nodes.ptr[e].a)].kind
        return (x =? 'int_lit' or x =? 'float_lit') and nodes.ptr[UnitWord(nodes.ptr[e].b)].kind =? 'ident'
    }
    false
}
# A unit written by name (`°C`, `units.°C`), before it is checked: `c*°C` makes a point
# from a number, where scaling a point is an error.
quantity_name_syntax=(e:UnitWord):>bool=>$unsafe {
    if e =? 0 or has_flag(e NF_CHECKED) {return false}
    let k=nodes.ptr[e].kind
    k =? 'ident' or (k =? 'field' and nodes.ptr[UnitWord(nodes.ptr[e].a)].kind =? 'ident')
}
# (the checked value of e, built here from checked operands without tags)
quantity_internal_check=(e:UnitWord):>int64=>{
    quantity_internal += 1
    check_expr(e 0);
    quantity_internal -= 1
    last_checked
}
quantity_binary=(n:UnitWord a:UnitWord b:UnitWord expected:UnitWord):>int64=>$unsafe {
    let a_lit=quantity_left_literal
    let b_lit=quantity_right_literal
    quantity_left_literal=false
    quantity_right_literal=false
    if quantity_internal >? 0 {return quantity_binary_plain(n a b expected)}
    let ta=ntype(a)
    let tb=ntype(b)
    let op=cx_token_values.ptr[UnitWord(nodes.ptr[n].op)]
    # (a temperature minus a temperature is a difference unless a literal is taken away)
    let temperatures=op =? 'minus' and quantity_dimension(ta) =? base_dimension(4) and quantity_dimension(tb) =? base_dimension(4)
    if quantity_tag(ta) =? 0 and quantity_tag(tb) =? 0 and not temperatures {return quantity_binary_plain(n a b expected)}
    let pos=nodes.ptr[n].pos
    let aq=is_quantity(ta)
    let bq=is_quantity(tb)
    let cmp=op =? 'eq' or op =? 'ne' or op =? 'lt' or op =? 'le' or op =? 'gt' or op =? 'ge'
    if not quantity_offset_tagged(ta) and not quantity_offset_tagged(tb) and not temperatures {
        # Display units only: a sum keeps its first operand's, scaling keeps the quantity's.
        let keep:UnitWord=0
        if op =? 'plus' or op =? 'minus' {keep=if quantity_tag(ta) not=? 0 {quantity_tag(ta)} else {quantity_tag(tb)}} else if (op =? 'star' or op =? 'slash') and not bq {keep=quantity_tag(ta)}
        else if op =? 'star' and not aq {keep=quantity_tag(tb)}
        quantity_retag(a 0);
        quantity_retag(b 0);
        let t=quantity_binary_plain(n a b expected)
        if cmp or not is_quantity(t) {return t}
        return quantity_retag(n keep)
    }
    if op =? 'plus' or op =? 'minus' or cmp {
        if not aq or not bq or quantity_dimension(ta) not=? quantity_dimension(tb) {quantity_mismatch(pos ta tb)}
    }
    let da=quantity_is_delta(ta)
    let db=quantity_is_delta(tb)
    let pa=quantity_point(ta)
    let pb=quantity_point(tb)
    if op =? 'plus' {
        # A point and a difference; a temperature written as an operand next to a point is
        # one (start + 20°C). Two points do not add.
        if da and db {return quantity_become(n quantity_operation('plus' quantity_point_reading(a) quantity_point_reading(b) pos) quantity_tag(ta))}
        if pa and pb and not a_lit and not b_lit {quantity_points_added(pos a b ta)}
        let a_point=not da and (db or not a_lit or b_lit)
        if a_point {return quantity_become(n quantity_operation('plus' quantity_point_reading(a) quantity_delta_reading(b) pos) quantity_tag(ta))}
        return quantity_become(n quantity_operation('plus' quantity_delta_reading(a) quantity_point_reading(b) pos) quantity_tag(tb))
    }
    if op =? 'minus' {
        if da and pb {quantity_difference_point(pos b tb "take a point from a difference")}
        if db or da {return quantity_become(n quantity_operation('minus' quantity_point_reading(a) quantity_delta_reading(b) pos) quantity_tag(ta))}
        if b_lit and not a_lit {return quantity_become(n quantity_operation('minus' quantity_point_reading(a) quantity_delta_reading(b) pos) quantity_tag(ta))}
        # point - point = difference, shown in the first point's unit
        let q=quantity_tags[quantity_tag(ta)]
        let unit=if q.display not=? 0 {q.display} else {q.origin}
        return quantity_become(n quantity_operation('minus' quantity_point_reading(a) quantity_point_reading(b) pos) intern_quantity_tag(unit 0 true))
    }
    if cmp {
        if pa and db {quantity_difference_point(pos a ta "compare a point with a difference")}
        if da and pb {quantity_difference_point(pos b tb "compare a point with a difference")}
        if da =? db {return quantity_become(n quantity_operation(op quantity_point_reading(a) quantity_point_reading(b) pos) 0)}
        return quantity_become(n quantity_operation(op quantity_delta_reading(a) quantity_delta_reading(b) pos) 0)
    }
    if op =? 'star' or op =? 'slash' {return quantity_offset_product(n a b op expected a_lit b_lit)}
    quantity_retag(a 0);
    quantity_retag(b 0);
    quantity_binary_plain(n a b expected)
}
# (a temperature point: written in an offset unit, or shown in one, and not a difference)
quantity_point=(t:UnitWord):>bool=>{
    if not is_quantity(t) {return false}
    let q=quantity_tags[quantity_tag(t)]
    not q.delta and (q.origin not=? 0 or quantity_units[q.display].onum not=? 0)
}
# (the checked x is the offset unit itself, as its name was written: °C in c*°C)
quantity_is_unit=(x:UnitWord named:bool):>bool=>{
    if not named {return false}
    let t=ntype(x)
    let q=quantity_tags[quantity_tag(t)]
    if q.delta or q.origin =? 0 or q.display not=? q.origin {return false}
    let scale=quantity_constant_scale(x)
    if scale <? 0 {return false}
    let u=quantity_units[q.origin]
    let v=quantity_scales[scale]
    # (one degree: its zero plus its size)
    v.numerator * u.den * u.oden =? (u.onum * u.den + u.num * u.oden) * v.denominator
}
# (the text of the checked operand x for a diagnostic, or alt)
quantity_operand_text=(x:UnitWord alt:string):>string=>$unsafe {
    if nodes.ptr[x].kind =? 'ident' {
        let nm=name_of(UnitWord(nodes.ptr[x].name))
        if (nm as array<uint8>).length >? 0 and (nm as array<uint8>)[0] not=? b'_' and (nm as array<uint8>)[0] not=? b'$' {return nm}
    }
    alt
}
# (the unit a point of type t was written or shown in, for a fix-it: °C)
quantity_point_unit=(t:UnitWord):>string=>{
    let q=quantity_tags[quantity_tag(t)]
    let u=if q.origin not=? 0 {q.origin} else {q.display}
    if u =? 0 {return "K"}
    quantity_units[u].sym
}
quantity_points_added=(pos:UnitWord a:UnitWord b:UnitWord t:UnitWord):>void=>{
    let x=quantity_operand_text(a "t1")
    let y=quantity_operand_text(b "t2")
    let unit=quantity_point_unit(t)
    fatal(pos "cannot add two temperatures: both are points on the {unit} scale, and their sum depends on where its zero sits (20{unit} + 20{unit} is not 40{unit}). For an average write `mean[{x} {y}]`; to add a difference, subtract two points (`{x} + ({y} - ref)`) or use kelvin (`5K`)")
}
quantity_difference_point=(pos:UnitWord point:UnitWord t:UnitWord what:string):>void=>{
    let unit=quantity_point_unit(t)
    fatal(pos "cannot {what}: one side is a temperature point (a reading on the {unit} scale) and the other a difference between two. Write the difference as a subtraction of two points (`let rise = 25{unit} - 5{unit}`) or in kelvin (`5K`); a literal added to or taken from a point is read as a difference (`t + 5{unit}`)")
}
quantity_point_scaled=(pos:UnitWord point:UnitWord t:UnitWord):>void=>{
    let p=quantity_operand_text(point "t")
    let unit=quantity_point_unit(t)
    fatal(pos "cannot scale a temperature point: `{p}` is a reading on the {unit} scale, and scaling one depends on where the scale's zero sits (2 × 20°C is 40°C, but 2 × 68°F, the same temperature, is 136°F). Scale a difference instead (`({p} - ref)*2`); for an average write `mean[t1 t2]`; `{p}/K` is its reading in kelvins")
}
# (a point times or over another quantity: A*t/R, where only a difference has a meaning)
quantity_point_in_compound=(pos:UnitWord point:UnitWord t:UnitWord):>void=>{
    let p=quantity_operand_text(point "")
    let what=if p =? "" {"this temperature"} else {"`{p}`"}
    let unit=quantity_point_unit(t)
    fatal(pos "a temperature point cannot be a factor of a compound quantity: {what} is a reading on the {unit} scale, and the result would depend on where the scale's zero sits. Use a difference: subtract two points (`(70{unit} - 30{unit})`) or use kelvin (`5K`); for one degree in a compound unit, write the unit alone (`J/(g*{unit})`)")
}
# Products and quotients with an offset temperature: a plain number scales a difference;
# another quantity combines with a difference's or a unit's own size (J/°C); a temperature
# over a temperature unit counts in that unit (t/°C is t's reading in Celsius). A point
# itself is not scaled: only a unit written by name makes one from a number (c*°C).
quantity_offset_product=(n:UnitWord a:UnitWord b:UnitWord op:Tok expected:UnitWord a_name:bool=false b_name:bool=false):>int64=>$unsafe {
    let pos=nodes.ptr[n].pos
    let ta=ntype(a)
    let tb=ntype(b)
    let aq=is_quantity(ta)
    let bq=is_quantity(tb)
    if op =? 'slash' and aq and bq and quantity_dimension(ta) =? quantity_dimension(tb) and not quantity_is_delta(tb) and (not quantity_point(tb) or quantity_is_unit(b b_name)) {
        let u=quantity_units[quantity_tags[quantity_tag(tb)].origin]
        let top=a
        if not quantity_is_delta(ta) and u.onum =? 0 {quantity_retag(a 0);} else if not quantity_is_delta(ta) {
            quantity_retag(a 0);
            top=bc_bin('minus' a quantity_offset_constant(u.onum u.oden quantity_dimension(ta) ta pos) pos)
            top=quantity_internal_check(top)
        }
        else {quantity_retag(a 0);}
        return quantity_become(n quantity_operation('slash' top quantity_delta_reading(b) pos) 0)
    }
    if quantity_point(ta) and not quantity_is_unit(a a_name) {
        if bq {quantity_point_in_compound(pos a ta)}
        quantity_point_scaled(pos a ta)
    }
    if quantity_point(tb) and not quantity_is_unit(b b_name) {
        if aq {quantity_point_in_compound(pos b tb)}
        quantity_point_scaled(pos b tb)
    }
    if aq and not bq {return quantity_become(n quantity_scaled(a b op true pos) quantity_tag(ta))}
    if bq and not aq and op =? 'star' {return quantity_become(n quantity_scaled(b a op false pos) quantity_tag(tb))}
    return quantity_become(n quantity_operation(op quantity_delta_reading(a) quantity_delta_reading(b) pos) 0)
}
quantity_arithmetic=(n:UnitWord name:UnitWord a:UnitWord b:UnitWord expected:UnitWord):>int64=>$unsafe {
    let a_name=quantity_left_literal
    let b_name=quantity_right_literal
    quantity_left_literal=false
    quantity_right_literal=false
    let ta=ntype(a)
    let tb=ntype(b)
    if quantity_tag(ta) =? 0 and quantity_tag(tb) =? 0 {return quantity_arithmetic_plain(n name a b expected)}
    if name =? intern("__dewy_divide") {
        if quantity_offset_tagged(ta) or quantity_offset_tagged(tb) {return quantity_offset_product(n a b 'slash' expected a_name b_name)}
        let keep=if not is_quantity(tb) {quantity_tag(ta)} else {0}
        quantity_retag(a 0);
        quantity_retag(b 0);
        let t=quantity_arithmetic_plain(n name a b expected)
        if not is_quantity(t) {return t}
        return quantity_retag(n keep)
    }
    if quantity_point(ta) and not quantity_is_unit(a a_name) {quantity_point_scaled(nodes.ptr[n].pos a ta)}
    let reading=quantity_delta_reading(a)
    quantity_retag(b 0);
    quantity_arithmetic_plain(n name reading b expected)
}
quantity_unary=(n:UnitWord expected:UnitWord):>int64=>$unsafe {
    let literal=quantity_unary_literal
    quantity_unary_literal=false
    let a=UnitWord(nodes.ptr[n].a)
    let t=ntype(a)
    let tag=quantity_tag(t)
    if tag =? 0 {return quantity_unary_plain(n expected)}
    let q=quantity_tags[tag]
    let op=cx_token_values.ptr[UnitWord(nodes.ptr[n].op)]
    if op =? 'minus' and not q.delta and q.origin not=? 0 {
        # (negating a reading: -(20°C) is -20°C; a point's value is not negated)
        if not literal and quantity_point(t) {quantity_point_scaled(nodes.ptr[n].pos a t)}
        let u=quantity_units[q.origin]
        let pos=nodes.ptr[n].pos
        quantity_retag(a 0);
        let twice=quantity_offset_constant(2 * u.onum u.oden quantity_dimension(t) t pos)
        return quantity_become(n quantity_operation('minus' twice a pos) tag)
    }
    quantity_retag(a 0);
    quantity_unary_plain(n expected);
    quantity_retag(n tag)
}
# `const °C = __offset_unit("°C" K 5463K/20)`: a unit of the given size whose zero sits at
# origin; its value, one degree, is origin + size.
quantity_offset_unit=(n:UnitWord sym:string size:UnitWord origin:UnitWord):>int64=>$unsafe {
    let pos=nodes.ptr[n].pos
    let ss=quantity_constant_scale(size)
    let os=quantity_constant_scale(origin)
    if ss <? 0 or os <? 0 {fatal(pos "an offset unit needs an exact constant size and origin")}
    let dim=quantity_dimension(ntype(size))
    if dim =? 0 or quantity_dimension(ntype(origin)) not=? dim {quantity_mismatch(pos ntype(size) ntype(origin))}
    let s=quantity_scales[ss]
    let o=quantity_scales[os]
    let u=intern_quantity_unit(sym s.numerator s.denominator o.numerator o.denominator)
    let g=quantity_gcd(s.denominator o.denominator)
    let den=s.denominator // g * o.denominator
    let num=s.numerator * (den // s.denominator) + o.numerator * (den // o.denominator)
    quantity_constant(n num den dim 0);
    quantity_retag(n intern_quantity_tag(u u false))
}
# ---------------- x as unit ----------------
# (the written unit of `x as km/h`: names of constants joined by * / ^)
quantity_unit_text=(e:UnitWord):>string=>$unsafe {
    let k=nodes.ptr[e].kind
    if k =? 'tname' or k =? 'ident' {return name_of(UnitWord(nodes.ptr[e].name))}
    if k =? 'tquantity' {
        let op=cx_token_values.ptr[UnitWord(nodes.ptr[e].op)]
        if op =? 'caret' {
            let p=UnitWord(nodes.ptr[e].b)
            if nodes.ptr[p].kind =? 'int_lit' {return "{quantity_unit_text(UnitWord(nodes.ptr[e].a))}^{nodes.ptr[p].ival}"}
            return ""
        }
        let left=quantity_unit_text(UnitWord(nodes.ptr[e].a))
        let right=quantity_unit_text(UnitWord(nodes.ptr[e].b))
        if left =? "" or right =? "" {return ""}
        if op =? 'slash' {
            # (W/(m^2*K): what the slash divides by stays one group)
            let r=UnitWord(nodes.ptr[e].b)
            let group=nodes.ptr[r].kind =? 'tquantity' and nodes.ptr[r].op not=? int32(65)
            if group {return "{left}/({right})"}
            return "{left}/{right}"
        }
        return "{left}*{right}"
    }
    ""
}
# (does the type syntax e name unit values, as in `x as km` or `x as (km/hour)`?)
quantity_unit_syntax=(e:UnitWord):>bool=>$unsafe {
    let k=nodes.ptr[e].kind
    if k =? 'tname' {
        let s=lookup(UnitWord(nodes.ptr[e].name))
        if s <? 0 {return false}
        let sk=syms.ptr[s].kind
        return sk =? 'global' or sk =? 'const_' or sk =? 'local'
    }
    if k =? 'tquantity' {
        if nodes.ptr[e].op =? int32(65) {return quantity_unit_syntax(UnitWord(nodes.ptr[e].a))}
        return quantity_unit_syntax(UnitWord(nodes.ptr[e].a)) and quantity_unit_syntax(UnitWord(nodes.ptr[e].b))
    }
    false
}
# (the unit syntax e as an expression)
quantity_unit_expr=(e:UnitWord):>int64=>$unsafe {
    let pos=nodes.ptr[e].pos
    if nodes.ptr[e].kind =? 'tname' {
        let x=mk('ident' pos)
        nodes.ptr[x].name=nodes.ptr[e].name
        return x
    }
    let op=cx_token_values.ptr[UnitWord(nodes.ptr[e].op)]
    if op =? 'caret' {return bc_call("__dewy_power" [quantity_unit_expr(UnitWord(nodes.ptr[e].a)) UnitWord(nodes.ptr[e].b)] pos)}
    if op =? 'slash' and dewy_at(pos) {return bc_call("__dewy_divide" [quantity_unit_expr(UnitWord(nodes.ptr[e].a)) quantity_unit_expr(UnitWord(nodes.ptr[e].b))] pos)}
    bc_bin(op quantity_unit_expr(UnitWord(nodes.ptr[e].a)) quantity_unit_expr(UnitWord(nodes.ptr[e].b)) pos)
}
# `x as unit`: the same quantity, shown in unit. A temperature keeps the scale it was
# written in, so (20°C as °F) shows 68°F and still reads as a 20 K difference.
quantity_as_unit=(n:UnitWord):>int64=>$unsafe {
    let pos=nodes.ptr[n].pos
    let text=quantity_unit_text(UnitWord(nodes.ptr[n].b))
    let unit=quantity_unit_expr(UnitWord(nodes.ptr[n].b))
    check_expr(unit 0);
    unit=last_checked
    let ut=ntype(unit)
    if not is_quantity(ut) {fatal(nodes.ptr[unit].pos "`as` converts to a unit of measure here, but {text} is a {dt(ut)}")}
    let scale=quantity_constant_scale(unit)
    if scale <? 0 {fatal(nodes.ptr[unit].pos "`as` converts to a constant unit, such as `km` or `km/hour`")}
    check_expr(UnitWord(nodes.ptr[n].a) 0);
    let x=last_checked
    let xt=ntype(x)
    if not is_quantity(xt) {fatal(pos "{dt(xt)} has no unit to convert; multiply by a unit to give it one, as in `3*{text}`")}
    if quantity_dimension(xt) not=? quantity_dimension(ut) {fatal(pos "cannot convert a {dimension_str(quantity_dimension(xt))} to {text}, a unit of {dimension_str(quantity_dimension(ut))}")}
    let uq=quantity_tags[quantity_tag(ut)]
    let shown:UnitWord=0
    if uq.origin not=? 0 and uq.display =? uq.origin {shown=uq.origin} else {
        let q=quantity_scales[scale]
        if q.numerator =? 0 {fatal(nodes.ptr[unit].pos "a unit cannot be zero")}
        shown=intern_quantity_unit(text q.numerator q.denominator 0 1)
    }
    let xq=quantity_tags[quantity_tag(xt)]
    let tag=if xq.delta {intern_quantity_tag(shown 0 true)} else {intern_quantity_tag(shown xq.origin false)}
    nodes.ptr[n]=nodes.ptr[x]
    last_checked=n
    quantity_retag(n tag)
}
quantity_ladder=(dim:UnitWord):>QuantityLadder=>{
    qa_quantity_ladder(dim)
}
# The text of the checked quantity x, as a checked string expression; 0 for a number
# Dewy cannot divide exactly or in floating point (it then prints as a plain number).
quantity_display=(x:UnitWord):>int64=>$unsafe {
    let t=prune(ntype(x))
    let base=prune(quantity_base(t))
    let exact=is_int(base) or base =? T_MATH_INT or bundled_rational_type(base) or bundled_bigint_type(base)
    if not exact and not is_float(base) {return 0}
    let pos=nodes.ptr[x].pos
    let q=quantity_tags[quantity_tag(t)]
    let ladder=QuantityLadder([] 0)
    let shown=if q.display not=? 0 {q.display} else {q.origin}
    if shown not=? 0 {ladder=QuantityLadder([shown] 0)} else {ladder=quantity_ladder(quantity_dimension(t))}
    let onum:UnitWord=0
    let oden:UnitWord=1
    if shown not=? 0 and not q.delta {
        onum=quantity_units[shown].onum
        oden=quantity_units[shown].oden
    }
    ensure_bundled_import("rational.dewy" "$dewy_rational" pos)
    let unit_syms:array<int64>=[]
    let nums:array<int64>=[]
    let dens:array<int64>=[]
    loop u in ladder.units {
        # (the symbol attaches to the number: 1500m, 20°C; a unit 1/s^2 drops its 1, so the
        # number is its numerator: 1/s^2, not 11/s^2)
        let sym=quantity_units[u].sym
        if starts_with(sym "1/") {sym=sym[1..(sym as array<uint8>).length)}
        unit_syms.push(bc_str(sym pos))
        nums.push(bc_int(quantity_units[u].num pos))
        dens.push(bc_int(quantity_units[u].den pos))
    }
    let number=quantity_number(x)
    add_flag(number NF_CHECKED)
    let fname="_quantity_exact"
    let offset:UnitWord=0
    if exact {
        if not bundled_rational_type(base) {
            let r=mk('call' pos)
            nodes.ptr[r].a=int32(bc_field(bc_ident("$dewy_rational" pos) "rational" pos))
            set_list(r [number])
            number=r
        }
        offset=mk('call' pos)
        nodes.ptr[offset].a=int32(bc_field(bc_ident("$dewy_rational" pos) "rational" pos))
        set_list(offset [bc_int(onum pos) bc_int(oden pos)])
    }
    else {
        if base =? T_F32 {fname="_quantity_float32"} else {
            fname="_quantity_float"
            number=quantity_float(number)
        }
        offset=mk('float_lit' pos)
        let scaled=quantity_scale(onum * quantity_units[ladder.units[0]].den oden)
        nodes.ptr[offset].fval=float64(quantity_scales[scaled].numerator) / float64(quantity_scales[scaled].denominator)
    }
    let c=mk('call' pos)
    nodes.ptr[c].a=int32(bc_field(bc_ident("$dewy_rational" pos) fname pos))
    let args=[number quantity_array(unit_syms T_STR pos) quantity_array(nums T_INT pos) quantity_array(dens T_INT pos) bc_int(ladder.base pos) offset]
    if exact {args.push(bc_bool(quantity_dimension(t) =? base_dimension(7) pos))}
    set_list(c args)
    check_expr(c T_STR);
    last_checked
}
# What a format spec shows of the checked x (`{wall as R:.1f}`, `{t:.1f}`): its number in the
# unit it prints in, without the unit. 0 for a quantity showing no such unit, whose number
# is the canonical one.
quantity_shown_number=(x:UnitWord):>int64=>$unsafe {
    let t=prune(ntype(x))
    let q=quantity_tags[quantity_tag(t)]
    let shown=if q.display not=? 0 {q.display} else {q.origin}
    if shown =? 0 {return 0}
    let base=prune(quantity_base(t))
    let exact=is_int(base) or base =? T_MATH_INT or bundled_rational_type(base) or bundled_bigint_type(base)
    if not exact and not is_float(base) {return 0}
    let u=quantity_units[shown]
    let onum=if q.delta {0} else {u.onum}
    let oden=if q.delta {1} else {u.oden}
    if u.num =? u.den and onum =? 0 {return 0}
    let pos=nodes.ptr[x].pos
    ensure_bundled_import("rational.dewy" "$dewy_rational" pos)
    let number=quantity_number(x)
    add_flag(number NF_CHECKED)
    let offset:UnitWord=0
    if exact {
        if not bundled_rational_type(base) {
            let r=mk('call' pos)
            nodes.ptr[r].a=int32(bc_field(bc_ident("$dewy_rational" pos) "rational" pos))
            set_list(r [number])
            number=r
        }
        offset=mk('call' pos)
        nodes.ptr[offset].a=int32(bc_field(bc_ident("$dewy_rational" pos) "rational" pos))
        set_list(offset [bc_int(onum pos) bc_int(oden pos)])
    }
    else {
        number=quantity_float(number)
        offset=mk('float_lit' pos)
        let scaled=quantity_scale(onum * u.den oden)
        nodes.ptr[offset].fval=float64(quantity_scales[scaled].numerator) / float64(quantity_scales[scaled].denominator)
    }
    let c=mk('call' pos)
    let fname=if exact {"_quantity_exact_number"} else {"_quantity_float_number"}
    nodes.ptr[c].a=int32(bc_field(bc_ident("$dewy_rational" pos) fname pos))
    set_list(c [number bc_int(u.num pos) bc_int(u.den pos) offset])
    check_expr(c 0);
    last_checked
}
quantity_array=(items:array<int64> elem:UnitWord pos:UnitWord):>int64=>{
    let a=mk('array' pos)
    set_list(a items)
    check_expr(a mk_array(elem));
    last_checked
}
task_sleep_type=():>int64=>$unsafe {
    mk_union([T_VOID UnitWord(syms.ptr[universe[intern("Canceled")]].ref)])
}
task_duration_value=(n:UnitWord a0:UnitWord):>int64=>$unsafe {
    let t=check_expr(a0 0)
    let a=last_checked
    add_flag(a NF_CHECKED)
    if not is_quantity(t) {
        let d=time_record_duration(t a "a deadline" "within(24hour @get(url))" nodes.ptr[n].pos)
        if d not=? 0 {
            nodes.ptr[n]=nodes.ptr[d]
            return T_INT
        }
    }
    if not is_quantity(t) or quantity_dimension(t) not=? base_dimension(0) {fatal(nodes.ptr[a].pos "a deadline takes a time, such as within(2s @get(url))")}
    let number=quantity_number(a)
    add_flag(number NF_CHECKED)
    let base=quantity_base(t)
    let ns:UnitWord=0
    if bundled_rational_type(base) {
        ns=mk('call' nodes.ptr[n].pos)
        rational_helper_call(ns "_whole_nanoseconds" number T_INT);
    }
    else if is_int(base) {
        let whole=mk('conv' nodes.ptr[a].pos)
        nodes.ptr[whole].a=int32(number)
        nodes.ptr[whole].aux=int32(int64(CV.int_))
        nodes.ptr[whole].type=int32(T_INT)
        add_flag(whole NF_CHECKED)
        ns=bc_bin('star' whole bc_int(1000000000 nodes.ptr[a].pos) nodes.ptr[a].pos)
    }
    else if is_float(base) {ns=bc_call("__task_seconds" [quantity_float(number)] nodes.ptr[n].pos)} else {fatal(nodes.ptr[a].pos "unsupported time representation for a deadline")}
    nodes.ptr[n]=nodes.ptr[ns]
    check_expr(n T_INT)
}

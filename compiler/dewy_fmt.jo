# Dewy layout uses its own lexer. Preserve meaningful adjacency and physical
# line breaks; normalize indentation, declarations and whitespace around them.
use 'dewy_fast.jo'
use 'dewy_parse.jo'
use 'dewy_tokens.dewy'

df_lexemes: DewyLexeme[]
df_blocks: int[]            # block comments of the lexed text: [start, end) pairs
df_file = () -> int: dn_file
df_file = (file: int): dn_file = file

df_assignment = (s: DewyToken) -> bool:
    s == .assign or s == .function or s == .returns or dn_token_assignment(s)

# Only these boundaries are independent of adjacency in the Dewy grammar.
# In particular, preserve calls/indexing, coefficients, generic applications,
# optional suffixes and the distinction between a-b and [a -b].
df_free_gap = (left: DewyToken, right: DewyToken) -> bool:
    df_assignment(left) or df_assignment(right) or left == .colon or left == .comma or left == .semi or left == .lbrace or right == .colon or right == .comma or right == .rbrace

# Whether the `=` at tokens[at] is followed by a function literal: `x =>`, `(...) =>`,
# `(...):>T =>` or `<T>(...) =>`.
df_function_value = (tokens: DewyLexeme[], at: int) -> bool:
    i = at + 1
    n = tokens.len()
    if i < n and tokens[i].symbol == .langle:
        depth = 0
        loop i < n:
            if tokens[i].symbol == .langle: depth += 1
            else if tokens[i].symbol == .rangle: depth -= 1
            i += 1
            if depth == 0: break
    if i >= n: return false
    if tokens[i].kind == .identifier: return i + 1 < n and tokens[i + 1].symbol == .function
    if tokens[i].symbol != .lparen: return false
    depth = 0
    loop i < n:
        if tokens[i].symbol == .lparen: depth += 1
        else if tokens[i].symbol == .rparen: depth -= 1
        i += 1
        if depth == 0: break
    i < n and (tokens[i].symbol == .function or tokens[i].symbol == .returns)

# The layout: `name = (x:int64):>int64 => body`. `=>`, `+=` and the like always have a space on
# each side; `=` has one when it binds a name (a statement), but not where it names an argument,
# a default or a field inside parentheses or brackets (`f(scale=3)`, `[x=1]`), which stays as
# written, unless it defines a function member of an object (`width = () => stop-start`).
# `:` and `:>` have none. `inside`: the innermost open delimiter is a ( or a [. `function`: the `=`
# defines a function member.
df_gap = (left: DewyLexeme, right: DewyLexeme, inside: bool, function: bool) -> str:
    if right.symbol == .colon or right.symbol == .comma: return ""
    if left.symbol == .colon or left.symbol == .returns or right.symbol == .returns: return ""
    if left.symbol == .lbrace and right.symbol == .rbrace: return ""
    # (`a:array<array<int64>>=[]`: the `>>=` or `>=` closes the angle brackets)
    if df_angles > 0 and (right.symbol == .shr_assign or right.symbol == .angle_assign): return ""
    if left.symbol == .shr_assign or left.symbol == .angle_assign: return " "
    if left.symbol == .function or right.symbol == .function or dn_token_assignment(left.symbol) or dn_token_assignment(right.symbol): return " "
    if left.symbol == .assign or right.symbol == .assign:
        if not inside or function or right.space: return " "
        return ""
    if df_free_gap(left.symbol, right.symbol): return " "
    if right.space: " " else: ""

df_tokens = (file: int, src: str) -> str[]:
    saved = dn_file
    dn_file = file
    df_lexemes = dn_lex(file, 0, len(src), false)
    df_blocks = dn_block_comments
    dn_file = saved
    out: str[]
    loop i in 0.. and t in df_lexemes:
        if t.kind == .eof: break
        sig = "{dw_kind_name(t.kind)}:{src[t.start..t.stop)}"
        if i > 0:
            sig += " n{t.newline}"
            if not df_free_gap(df_lexemes[i - 1].symbol, t.symbol): sig += " s{t.space}"
        out.push(sig)
    out

df_stack: DewyToken[]       # the delimiters open before df_tracked
df_levels: int[]            # the indentation level of the line each of them was opened on
df_tracked = 0
df_angles = 0

# Count the delimiters of the tokens up to `stop`; false when they do not match.
df_track = (tokens: DewyLexeme[], stop: int, level: int) -> bool:
    loop df_tracked < stop:
        t = tokens[df_tracked]
        df_tracked += 1
        if t.kind != .op: continue
        if t.symbol == .langle: df_angles += 1
        else if df_angles > 0 and (t.symbol == .rangle or t.symbol == .gt and not t.space): df_angles -= 1
        else if df_angles > 1 and t.symbol == .shr: df_angles -= 2
        if t.symbol == .lparen or t.symbol == .lbrack or t.symbol == .lbrace:
            df_stack.push(t.symbol)
            df_levels.push(level)
            if df_stack.len() > 256: return false
        else if t.symbol == .rparen or t.symbol == .rbrack or t.symbol == .rbrace:
            if df_stack.len() == 0: return false
            opening = df_stack.pop()
            df_levels.pop()
            if (opening == .lbrace) != (t.symbol == .rbrace): return false
            # [a..b) and (a..b] are valid Dewy range delimiters.
    true

# A line continues the statement before it, one level deeper, when that statement ended in an
# operator, a comma or an `=`/`=>`, or the line starts with `&`, `|`, `and`, `or` or `xor`.
df_continues = (prev: DewyToken, first: DewyToken) -> bool:
    df_assignment(prev) or prev == .comma or prev == .amp or prev == .pipe or prev == .kw_and or prev == .kw_or or prev == .kw_xor or first == .amp or first == .pipe or first == .kw_and or first == .kw_or or first == .kw_xor

# Whether the innermost open delimiter is a ( or a [ (or an angle bracket).
df_inside = () -> bool:
    df_angles > 0 or df_stack.len() > 0 and df_stack[df_stack.len() - 1] != .lbrace

# Whether the gap before tokens[i] touches an `=` that defines a member of an object: directly
# inside [ ] with a function literal as its value (as opposed to `sort(key=x => x.size)`).
df_assign_function = (tokens: DewyLexeme[], i: int) -> bool:
    if df_angles > 0 or df_stack.len() == 0 or df_stack[df_stack.len() - 1] != .lbrack: return false
    if tokens[i].symbol == .assign: return df_function_value(tokens, i)
    tokens[i - 1].symbol == .assign and df_function_value(tokens, i - 1)

df_text = (src: str) -> str?:
    tokens = df_lexemes
    blocks = df_blocks
    df_stack = []
    df_levels = []
    df_tracked = 0
    df_angles = 0
    bi = 0
    lines: str[]
    at = 0
    start = 0
    opaque_end = 0
    final_newline = if find(src, "\r\n") >= 0: "\r\n" else: "\n"
    loop start < len(src):
        end = find_byte(src, '\n', start)
        if end < 0: end = len(src)
        content_end = end
        if content_end > start and src[content_end - 1] == '\r': content_end -= 1
        newline = if content_end < end: "\r\n" else: "\n"
        if end == len(src): newline = final_newline
        protected = start < opaque_end
        stop = at
        loop stop < tokens.len() and tokens[stop].kind != .eof and tokens[stop].start < content_end:
            if tokens[stop].stop > content_end: opaque_end = tokens[stop].stop
            stop += 1
        # (a block comment over several lines is kept as written, like a string)
        loop bi + 1 < blocks.len() and blocks[bi] < content_end:
            if blocks[bi + 1] > content_end: opaque_end = max(opaque_end, blocks[bi + 1])
            bi += 2
        lead = 0
        loop at + lead < stop and tokens[at + lead].kind == .op and (tokens[at + lead].symbol == .rparen or tokens[at + lead].symbol == .rbrack or tokens[at + lead].symbol == .rbrace): lead += 1
        # (a line is indented one level past the line that opened the bracket it is in, so two
        # brackets opened on one line add one level, and a line starting with a closer sits level
        # with the line that opened it)
        depth = 0
        if lead > 0 and df_stack.len() > 0: depth = df_levels[df_stack.len() - 1]
        else if df_stack.len() > 0: depth = df_levels[df_stack.len() - 1] + 1
        if lead == 0 and at > 0 and at < stop and not protected and df_continues(tokens[at - 1].symbol, tokens[at].symbol): depth += 1
        first = start
        loop first < content_end and (src[first] == ' ' or src[first] == '\t'): first += 1
        last = content_end
        if not protected and opaque_end <= content_end:
            loop last > first and (src[last - 1] == ' ' or src[last - 1] == '\t'): last -= 1
        if protected:
            lines.push(src[start..content_end))
        else if first == content_end:
            lines.push("")
        else:
            parts = [repeat(" ", depth * 4)]
            if at == stop:
                # A comment-only line has no lexer tokens.
                parts.push(src[first..last))
            else:
                # (a block comment before the line's code, or between its tokens, stays)
                if tokens[at].start > first: parts.push(src[first..tokens[at].start))
                loop i in [at..stop):
                    if i > at:
                        if not df_track(tokens, i, depth): return none
                        between = src[tokens[i - 1].stop..tokens[i].start)
                        if find_byte(between, '#') >= 0: parts.push(between)
                        else: parts.push(df_gap(tokens[i - 1], tokens[i], df_inside(), df_assign_function(tokens, i)))
                    t = tokens[i]
                    parts.push(src[t.start..min(t.stop, content_end)))
                cursor = min(tokens[stop - 1].stop, content_end)
                if cursor < last: parts.push(src[cursor..last))
            lines.push(join(parts, ""))
        # Strings can span physical lines, including closing quotes followed by
        # code. Their contents stay untouched, but following delimiters count.
        if not df_track(tokens, stop, depth): return none
        df_angles = 0       # (a type's angle brackets end on their line, even when a `>?` or `>>` closes them)
        lines.push(newline)
        at = stop
        start = end + 1
    if df_stack.len() != 0: return none
    join(lines, "")

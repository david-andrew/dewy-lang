# `dewy-core fmt` for Dewy text: the lexer's lexemes of it, as fmt.jo compares them before and
# after, and its layout (dewy_layout.dewy) from them.
use 'dewy_fast.jo'
use 'dewy_nodes.jo'
use 'dewy_tokens.dewy'
use 'dewy_syntax.dewy'
use 'dewy_layout.dewy'

df_lexemes: DewyLexeme[]
df_blocks: int[]            # block comments of the lexed text: [start, end) pairs
df_file = () -> int: dn_file
df_file = (file: int): dn_file = file

df_tokens = (file: int, src: str) -> str[]:
    saved = dn_file
    dn_file = file
    df_lexemes = dn_lex(file, 0, len(src), false)
    df_blocks = dn_block_comments
    dn_file = saved
    out: str[]
    loop i in 0.. and t in df_lexemes:
        if t.kind == .eof: break
        sig = "{dw_kind_name(t.kind)}:{src[t.start..t.stop)}"
        if i > 0:
            sig += " n{t.newline}"
            if not dl_free_gap(df_lexemes[i - 1].symbol, t.symbol): sig += " s{t.space}"
        out.push(sig)
    out

# the lexed text laid out (dewy_layout.dewy), or none when its delimiters do not match
df_text = (src: str) -> str?:
    if let laid = dewy_layout(src, df_lexemes, df_blocks): return str_from_bytes(laid)
    none

# Explanations of unproven obligations. Nothing here runs until a diagnostic
# is about to be reported: dormant compilation builds no witness data. Notes
# report retained evidence only (bounds, one tombstone per replaced route,
# guard origins); a counterexample is always labeled a POSSIBLE witness.
use 'ast.jo'
use 'lex.jo'
use 'types.jo'
use 'util.jo'
use 'expr.jo'
use 'check.jo'
use 'facts.jo'
use 'refine.jo'
use 'proofs.jo'
use 'directives.jo'

struct WitSide:
    value: int = 0
    node: int = 0           # an ident place, for its tombstone
    text: str = ""
    length: bool = false    # the length of the array named by node
    literal: bool = false

# Harness-only (--internal-fact-policy=require-static-all): report each
# failed obligation and continue, so a measurement sees all of them.
wit_collect = false
wit_measure = false
wit_collected = 0
# A partitioned check's process decides its obligations with the other
# processes' bodies opaque: a failure there is tentative, and the whole
# program is decided again serially (pcheck.jo pc_after_facts).
wit_tentative = false
wit_tentative_failed = false
wit_fail = (p: int, msg: str):
    if wit_tentative:
        wit_tentative_failed = true
        return
    if not wit_collect: fatal(p, msg)
    err_notes = []
    eprint("{pos_str(p)}: error: {msg}")
    wit_collected += 1

# One note per span: a cause already shown at an event is not repeated.
wit_note = (at: int, text: str):
    if at > 0:
        loop e in err_notes:
            if e.0 == at: return
    err_notes.push((at, "note: {text}"))

# Repairs are current evidence or an explicit runtime check, never `$assert`.
# Inside an erased proof, evidence comes only from its preconditions, guards
# and other proofs.
wit_help = (relation: str, runtime: bool = true):
    want = if relation != "": "`{relation}`" else: "it"
    if proof_active and fact_owner > 0 and fact_owner < fns.len() and proof_decls.has(int(fns[fact_owner].decl)):
        err_notes.push((-1, "help: establish {want} with a stronger proof precondition, a call to another proof or a current guard; erased proofs cannot check at run time"))
    else if runtime: err_notes.push((-1, "help: establish {want} with a current guard or a stronger checked contract, or check it at run time with `$runtime_assert`"))
    else: err_notes.push((-1, "help: establish {want} with a current guard or a stronger checked contract; erased proofs have no runtime fallback"))

wit_op = (op: Tok) -> str:
    if op == .lt: return "<?"
    if op == .le: return "<=?"
    if op == .gt: return ">?"
    if op == .ge: return ">=?"
    if op == .eq: return "=?"
    "not=?"

# A name the loop lowering made up (its snapshot, position, flags and range
# counters): never shown to the user.
wit_hidden_name = (name: str) -> bool:
    if starts_with(name, "$"): return true
    loop prefix in ["__s", "__k", "__ix", "__each", "__has"]:
        if starts_with(name, prefix) and name.len() > prefix.len():
            c = name[prefix.len()]
            if c >= '0' and c <= '9': return true
    false

# A read the loop lowering made: an index whose base or position is hidden.
wit_hidden_read = (n: int) -> bool:
    loop side in [int(nodes[n].a), int(nodes[n].b)]:
        e = side
        loop e > 0 and (nodes[e].kind == .narrow or nodes[e].kind == .conv): e = int(nodes[e].a)
        if e > 0 and nodes[e].kind == .ident and nodes[e].name != 0 and wit_hidden_name(name_of(int(nodes[e].name))): return true
    false

# The spelling of a simple place or literal; "" for anything else.
wit_text = (e0: int, depth: int = 0) -> str:
    e = e0
    if e <= 0 or depth > 8: return ""
    loop nodes[e].kind == .narrow or nodes[e].kind == .conv and (nodes[e].aux == i32(int(CV.int_)) or nodes[e].aux == i32(int(CV.none_)) or nodes[e].aux == i32(int(CV.refinement))):
        e = int(nodes[e].a)
    k = nodes[e].kind
    if k == .ident and nodes[e].name != 0:
        name = name_of(int(nodes[e].name))
        return if wit_hidden_name(name): "" else: name
    if k == .int_lit and not has_flag(e, NF_U64): return "{nodes[e].ival}"
    if k == .field and nodes[e].aux >= 0:
        base = wit_text(int(nodes[e].a), depth + 1)
        if base != "": return "{base}.{name_of(int(nodes[e].name))}"
    if k == .intrinsic and nodes[e].aux == i32(int(IN.len)) and nkids(e) > 0:
        base = wit_text(kid(e, 0), depth + 1)
        if base != "": return "{base}.length"
    if k == .index and nodes[e].b != 0:
        base = wit_text(int(nodes[e].a), depth + 1)
        index = wit_text(int(nodes[e].b), depth + 1)
        if base != "" and index != "": return "{base}[{index}]"
    ""

# What happened at an invalidating event, as a noun.
wit_event = (at: int) -> str:
    if at <= 0: return "operation"
    if nodes[at].kind == .exprstmt and nodes[at].a != 0: return wit_event(int(nodes[at].a))
    k = nodes[at].kind
    if k == .intrinsic:
        loop i in intrinsics:
            if i.id == (nodes[at].aux as IN) and i.arr: return i.name
        return "operation"
    if k == .call:
        f = int(nodes[at].sym)
        if nodes[at].aux == 0 and f > 0 and fns[f].decl != 0: return "call to {name_of(int(nodes[int(fns[f].decl)].name))}"
        return "call"
    if k == .assign: return "assignment"
    if k == .while_ or k == .for_: return "loop"
    if k == .if_ or k == .and_ or k == .or_: return "branch"
    if k == .block: return "block's cleanup"
    "statement"

wit_reason = (b: FactBound) -> str:
    if b.reason == .write: return "value changed by assignment"
    if b.reason == .call: return "call invalidated a mutable or exposed root"
    if b.reason == .callee: return "the callee's effects are not settled"
    if b.reason == .join: return "a predecessor lacks the required evidence"
    if b.reason == .loop_: return "loop may change the tested value"
    if b.reason == .unsupported: return "unsupported symbolic operation"
    if b.reason == .budget: return "fact budget exhausted"
    "missing scalar bound"

# The retained event behind an unknown bound, at its own span.
wit_cause = (b: FactBound, n: int):
    w = b.witness
    if w <= 0 or w == n or b.reason == .missing: return
    what = wit_event(w)
    if b.reason == .write: wit_note(nodes[w].pos, "the value was replaced by this {what}")
    else if b.reason == .call: wit_note(nodes[w].pos, "this {what} may write a mutable or exposed root")
    else if b.reason == .callee: wit_note(nodes[w].pos, "this {what} has no settled effect summary")
    else if b.reason == .join: wit_note(nodes[w].pos, "a path into this {what} lacks the evidence")
    else if b.reason == .loop_: wit_note(nodes[w].pos, "this loop may change the value")
    else if b.reason == .unsupported: wit_note(nodes[w].pos, "this operation is outside the fact language")
    else if b.reason == .budget and (nodes[w].kind == .while_ or nodes[w].kind == .for_): wit_note(nodes[w].pos, "the loop analysis budget ran out at this loop; what it changes is unknown")
    else if b.reason == .budget: wit_note(nodes[w].pos, "the fact budget ran out here")

# Function-level context: the generic instance being analyzed.
wit_context = (contract: int):
    if contract > 0: wit_note(contract, "the contract is declared here")
    f = fact_owner
    if f > 0 and f < fns.len() and fns[f].targs.len() > 0 and fns[f].use_pos > 0 and fns[f].decl != 0:
        args = ""
        loop i in 0.. and t in fns[f].targs:
            if i > 0: args += " "
            args += type_str(zonk(t), true)
        wit_note(fns[f].use_pos, "in {name_of(int(nodes[int(fns[f].decl)].name))} with <{args}>, instantiated here")

wit_projection = (s: FactState, base: int, selector: int) -> int:
    if base == 0: return 0
    loop p in s.projections:
        if p.base == base and not p.element and p.selector == selector: return p.value
    0

# The tombstone of a side's place when it describes the side's CURRENT value:
# (event, replaced value). The replaced value of a length is the old length.
wit_tomb = (s: FactState, side: WitSide) -> (int, int):
    e = side.node
    if e <= 0 or nodes[e].kind != .ident: return (0, 0)
    i = fact_binding(s, fact_place(e))
    if i < 0 or s.bindings[i].event == 0: return (0, 0)
    binding = s.bindings[i]
    if not side.length:
        if binding.value != side.value: return (0, 0)
        return (binding.event, binding.prior)
    if wit_projection(s, binding.value, -1) != side.value: return (0, 0)
    (binding.event, wit_projection(s, binding.prior, -1))

wit_value = (s: FactState, v: int, x: int) -> str:
    t = if v > 0 and v < fact_terms.len(): representation_type(fact_terms[v].type) else: 0
    # uint64 facts order (bits xor MIN); show the value itself.
    if t == T_U64: return "{u64(x xor FACT_MIN)}"
    if t == T_BOOL: return if x != 0: "true" else: "false"
    "{x}"

# Representation limits are not interesting evidence; only report real bounds.
wit_known = (b: FactBound, unsigned: bool = false) -> str:
    if unsigned:
        lo = u64(b.lo xor FACT_MIN); hi = u64(b.hi xor FACT_MIN)
        if b.lo == b.hi: return "is {lo}"
        if b.lo > FACT_MIN and b.hi < FACT_MAX: return "is between {lo} and {hi}"
        if b.lo > FACT_MIN: return "is at least {lo}"
        if b.hi < FACT_MAX: return "is at most {hi}"
        return ""
    if b.lo == b.hi: return "is {b.lo}"
    lo = b.lo > -(1 << 62)
    hi = b.hi < (1 << 62)
    if lo and hi: return "is between {b.lo} and {b.hi}"
    if lo: return "is at least {b.lo}"
    if hi: return "is at most {b.hi}"
    ""

wit_holds = (op: Tok, x: int, y: int) -> bool:
    if op == .lt: return x < y
    if op == .le: return x <= y
    if op == .gt: return x > y
    if op == .ge: return x >= y
    if op == .eq: return x == y
    x != y

wit_candidates = (b: FactBound) -> int[]:
    out: int[]
    loop x in [0, 1, -1, b.lo, b.hi, b.lo + 1, b.hi - 1]:
        if x < b.lo or x > b.hi or b.nz and x == 0 or out.contains(x): continue
        out.push(x)
    out

# A valuation of the two sides that violates `a op b` and satisfies their
# intervals and every direct difference row between them. Other constraints
# are not solved, so this is only ever reported as a possible witness.
wit_counterexample = (s: FactState, op: Tok, a: int, b: int) -> (bool, int, int):
    if a == 0 or b == 0 or a == b: return (false, 0, 0)
    loop x in wit_candidates(fact_bound(s, a)):
        loop y in wit_candidates(fact_bound(s, b)):
            if wit_holds(op, x, y): continue
            ok = true
            loop row in s.differences:
                if row.a == a and row.b == b and (not fact_add_fits(x, -y) or x - y > row.limit): ok = false
                if row.a == b and row.b == a and (not fact_add_fits(y, -x) or y - x > row.limit): ok = false
            if ok: return (true, x, y)
    (false, 0, 0)

# The same evaluation, or two constants with one value (each literal capture
# is its own term).
wit_same = (s: FactState, u: int, v: int) -> bool:
    if u == v: return true
    x = fact_bound(s, u); y = fact_bound(s, v)
    u != 0 and v != 0 and x.lo == x.hi and y.lo == y.hi and x.lo == y.lo

# A guard that established `a op b` directly, or 0.
wit_guard = (s: FactState, op: Tok, a: int, b: int) -> int:
    loop row in s.differences:
        if row.at <= 0: continue
        if (op == .lt or op == .le) and wit_same(s, row.a, a) and wit_same(s, row.b, b) and row.limit <= (if op == .lt: -1 else: 0): return row.at
        if (op == .gt or op == .ge) and wit_same(s, row.a, b) and wit_same(s, row.b, a) and row.limit <= (if op == .gt: -1 else: 0): return row.at
    0

# Stored atoms read `a < b`; show a constrained value before a literal bound.
wit_orient = (op: Tok, a: WitSide, b: WitSide) -> (Tok, WitSide, WitSide):
    if a.literal and not b.literal and (op == .lt or op == .le): return ((if op == .lt: Tok.gt else: Tok.ge), b, a)
    (op, a, b)

wit_relation_text = (op: Tok, a: WitSide, b: WitSide) -> str:
    if a.text == "" or b.text == "": return ""
    "{a.text} {wit_op(op)} {b.text}"

wit_constant = (s: FactState, v: int) -> bool:
    b = fact_bound(s, v)
    v != 0 and b.lo == b.hi

# Notes for one comparison obligation `a op b`: current values, a replaced
# route and the stale fact it carried, the missing bound, a possible witness.
# `s` holds the evidence; `cex` the state in which a possible witness is sought.
wit_relation = (s: FactState, cex: FactState, op: Tok, a: WitSide, b: WitSide, refuted: bool, missing: str = "") -> str:
    relation = wit_relation_text(op, a, b)
    stale = false
    loop side in [a, b]:
        if side.text == "" or side.literal: continue
        bound = fact_bound(s, side.value)
        tomb = wit_tomb(s, side)
        shown = if bound.lo == bound.hi: wit_value(s, side.value, bound.lo) else: ""
        unsigned = side.value > 0 and side.value < fact_terms.len() and representation_type(fact_terms[side.value].type) == T_U64
        known = if shown != "": "is {shown}" else if bound.lo == bound.hi: "" else: wit_known(bound, unsigned)
        if tomb.0 != 0:
            what = wit_event(tomb.0)
            if shown != "": wit_note(nodes[tomb.0].pos, "{side.text} {known} after this {what}")
            else: wit_note(nodes[tomb.0].pos, "{side.text} may have changed at this {what}")
            if tomb.1 != 0 and not stale:
                x = if side.value == a.value: tomb.1 else: a.value
                y = if side.value == b.value: tomb.1 else: b.value
                if fact_compare(s, op, x, y) == 1:
                    stale = true
                    fact = if relation != "": "`{relation}` fact" else: "fact"
                    guard = wit_guard(s, op, x, y)
                    wit_note((if guard > 0: nodes[guard].pos else: -1), "the earlier {fact} described the value before the {what}")
        else if known != "": wit_note(-1, "{side.text} {known}")
    if refuted or relation == "": return ""
    which = missing
    if which == "":
        # `a < b` bounds a from above, unless a is the constant end.
        upper = (op == .lt or op == .le) != wit_constant(s, a.value)
        which = if op == .eq or op == .ne: "bound" else if upper: "upper bound" else: "lower bound"
    wit_note(-1, "missing {which}: nothing establishes `{relation}` here")
    found = wit_counterexample(cex, op, a.value, b.value)
    if found.0:
        shown = ""
        if not a.literal: shown = "{a.text} = {wit_value(s, a.value, found.1)}"
        if not b.literal:
            if shown != "": shown += ", "
            shown += "{b.text} = {wit_value(s, b.value, found.2)}"
        if shown != "": wit_note(-1, "possible witness (consistent with the known bounds, not an observed execution): {shown}")
    which

# Unknown obligations: a reason, the retained cause, context and a repair.
wit_unknown = (n: int, b: FactBound, what: str, contract: int = 0, relation: str = "", missing: str = "", runtime: bool = true):
    wit_cause(b, n)
    wit_context(contract)
    wit_help(relation, runtime)
    why = if b.reason == .missing and missing != "": "missing {missing}" else: wit_reason(b)
    if dir_defer(n, "cannot prove {what}: {why}", runtime and what != "assertion"): return
    wit_fail(nodes[n].pos, "cannot prove {what}: {why}")

wit_side = (value: int, node0: int) -> WitSide:
    node = node0
    loop node > 0 and (nodes[node].kind == .narrow or nodes[node].kind == .conv and (nodes[node].aux == i32(int(CV.int_)) or nodes[node].aux == i32(int(CV.none_)))): node = int(nodes[node].a)
    side = WitSide(value, node, wit_text(node))
    if node > 0 and nodes[node].kind == .int_lit: side.literal = true
    if node > 0 and nodes[node].kind == .intrinsic and nodes[node].aux == i32(int(IN.len)) and nkids(node) > 0:
        side.node = kid(node, 0)
        side.length = true
    side

# The comparison a leaf condition tests: its relation and missing bound, after
# notes on its operands. `paths.no` is the violating state.
wit_comparison = (c: int, paths: FactPaths, refuted: bool) -> (str, str):
    relation = ""
    missing = ""
    s = paths.no
    reason = paths.reason
    if paths.value > 0 and nodes[c].kind == .binary and fact_comparison(nodes[c].op as Tok):
        term = fact_terms[paths.value]
        if term.op == (nodes[c].op as Tok) and term.origin == c:
            a = wit_side(term.a, int(nodes[c].a))
            b = wit_side(term.b, int(nodes[c].b))
            relation = wit_relation_text(term.op, a, b)
            if refuted or reason.reason != .unsupported and reason.reason != .budget: missing = wit_relation((if paths.entry.live: paths.entry else: s), s, term.op, a, b, refuted)
    (relation, missing)

struct WitLeaf:
    relation: str = ""
    missing: str = ""
    reason: FactBound = FactBound()
    count: int = 0          # operands explained
    unknown: bool = false   # the one described is unknown, not refuted

# 1 when the wanted edge is the only live one, 0 when it is dead, -1 otherwise.
wit_status = (p: FactPaths, want: bool) -> int:
    wanted = if want: p.yes else: p.no
    other = if want: p.no else: p.yes
    if not wanted.live: return 0
    if other.live: return -1
    1

# Name the operands of an `and`/`or` condition that fail it: when every
# operand must hold, the first refuted one (else the first unknown); when one
# suffices, each of them. Each is re-evaluated in the state its evaluation
# sees, exactly as the obligation was.
wit_connective = (n: int, entry: FactState, want: bool, refuted: bool, role: str) -> WitLeaf:
    k = nodes[n].kind
    if k == .not_: return wit_connective(int(nodes[n].a), entry, not want, refuted, role)
    if k == .and_ or k == .or_:
        operand = if k == .and_: "conjunct" else: "alternative"
        a = fact_condition(int(nodes[n].a), entry)
        rest = if k == .and_: a.yes else: a.no
        if (k == .and_) == want:
            first = wit_status(a, want)
            if first == 0 or first == -1 and not refuted or not rest.live: return wit_connective(int(nodes[n].a), entry, want, refuted, operand)
            return wit_connective(int(nodes[n].b), rest, want, refuted, operand)
        left = wit_connective(int(nodes[n].a), entry, want, refuted, operand)
        if not rest.live: return left
        right = wit_connective(int(nodes[n].b), rest, want, refuted, operand)
        # Establishing any one unknown alternative would suffice.
        count = left.count + right.count
        if left.count == 0 or right.unknown and not left.unknown: left = right
        left.count = count
        return left
    p = fact_condition(n, entry)
    status = wit_status(p, want)
    leaf = WitLeaf(reason = p.reason)
    if status == 1 or not entry.live: return leaf
    leaf.count = 1
    leaf.unknown = (status == -1)
    truth = if want: "false" else: "true"
    if status == 0: wit_note(nodes[n].pos, "this {role} is always {truth}")
    else if want: wit_note(nodes[n].pos, "this {role} is not proven")
    else: wit_note(nodes[n].pos, "this {role} is not proven false")
    if want:
        found = wit_comparison(n, p, status == 0)
        leaf.relation = found.0
        leaf.missing = found.1
    leaf

# `$assert` and the condition it tests, evaluated from `entry`.
wit_obligation = 0   # (the `$assert`-like obligation an unpacking or spread made: deferrable)
wit_assertion = (cond: int, message: int, paths: FactPaths, entry: FactState):
    refuted = not paths.yes.live
    relation = ""
    missing = ""
    reason = paths.reason
    k = nodes[cond].kind
    if (k == .and_ or k == .or_ or k == .not_) and entry.live:
        fact_query = true
        leaf = wit_connective(cond, entry, true, refuted, "condition")
        fact_query = false
        if leaf.count == 1 or not refuted and leaf.unknown:
            relation = leaf.relation
            missing = leaf.missing
            reason = leaf.reason
    else:
        found = wit_comparison(cond, paths, refuted)
        relation = found.0
        missing = found.1
    if refuted:
        if wit_obligation != 0 and message != 0:
            err_notes = []
            fatal(nodes[cond].pos, "{name_of(int(nodes[message].sval))}, and the length here is known to differ")
        wit_context(0)
        wit_help(relation)
        assertion_refuted(cond, message)
    # (an unpacking's or a spread's length: an obligation, which a scope with runtime
    # checks keeps as one)
    if wit_obligation != 0 and message != 0:
        wit_unknown(cond, reason, "the length ({name_of(int(nodes[message].sval))})", 0, relation, missing)
        return
    wit_unknown(cond, reason, "assertion", 0, relation, missing)

# A builtin index: refuted (some bound is false) or unknown (some is missing).
wit_index = (n: int, s: mut FactState, index: int, length: int, lo: int, hi: int, base_node: int = -1, index_node: int = -1):
    a = if base_node >= 0: base_node else: int(nodes[n].a)
    base = wit_text(a)
    # A loop's own element read is described as such, never by its lowering.
    read = "index"
    # (`pair[i]` of a `[int64 string]` reads a fixed array of its positions)
    positions = nodes[a].kind == .ident and starts_with(name_of(int(nodes[a].name)), "$position_values")
    if wit_hidden_read(n) and not positions: read = if base != "": "the loop's read of `{base}`" else: "the loop's element read"
    i = wit_side(index, if index_node >= 0: index_node else: int(nodes[n].b))
    zero = WitSide(fact_constant(s, 0), 0, "0", false, true)
    size = WitSide(length, a, (if base != "": "{base}.length" else: ""), true)
    relation = wit_relation_text(.lt, i, size)
    if lo == 0 or hi == 0:
        if lo == 0: wit_relation(s, s, .ge, i, zero, true)
        else: wit_relation(s, s, .lt, i, size, true)
        wit_context(0)
        wit_help(relation)
        if dir_defer(n, "{read} is not in bounds", true): return
        wit_fail(nodes[n].pos, "{read} is not in bounds")
        return
    b = fact_bound(s, index)
    if b.reason == .unsupported or b.reason == .budget or b.reason == .callee:
        wit_unknown(n, b, "{read} is in bounds", 0, relation)
        return
    if lo != 1: wit_relation(s, s, .ge, i, zero, false, "lower bound")
    if hi != 1:
        wit_relation(s, s, .lt, i, size, false, "upper bound")

        wit_cause(fact_bound(s, length), n)
    wit_context(0)
    wit_help(relation)
    which = if lo != 1 and hi != 1: "lower and upper bounds" else if lo != 1: "lower bound" else: "upper bound"
    if dir_defer(n, "cannot prove {read} is in bounds: missing {which}", true): return
    wit_fail(nodes[n].pos, "cannot prove {read} is in bounds: missing {which}")

# `d[k]`, `d[k] += 1` or `d.pop(k)` where k may be missing (facts.jo fact_map_check).
wit_key = (n: int):
    base = wit_text(kid(n, 0))
    e = kid(n, 1)
    key = if nodes[e].kind == .str_lit and nkids(e) == 0 and nodes[e].sval >= 0: "\"{name_of(int(nodes[e].sval))}\"" else: wit_text(e)
    relation = if base != "" and key != "": "{key} in? {base}" else: ""
    wit_context(0)
    wit_help(relation)
    if is_dewy_set_type(representation_type(ntype(kid(n, 0)))):
        if base != "" and key != "": err_notes.push((-1, "help: or take a missing member as a value: `{base}.pop({key} default=none)` gives none for it"))
        if dir_defer(n, "cannot prove the value is in the set", true): return
        wit_fail(nodes[n].pos, "cannot prove the value is in the set")
        return
    if base != "" and key != "": err_notes.push((-1, "help: or take the missing key as a value: `{base}.get({key})` gives none for it"))
    if dir_defer(n, "cannot prove the key is in the dictionary", true): return
    wit_fail(nodes[n].pos, "cannot prove the key is in the dictionary")

# A builtin operation's precondition `a op b` (`xs.length >? 0` for pop, a
# truncate count `>=? 0`), refuted (c = 0) or unknown: one lower bound.
wit_operation = (n: int, s: mut FactState, op: Tok, a: WitSide, b: WitSide, c: int, refuted: str, what: str):
    relation = wit_relation_text(op, a, b)
    if c == 0:
        wit_relation(s, s, op, a, b, true)
        wit_context(0)
        wit_help(relation)
        if dir_defer(n, refuted, true): return
        wit_fail(nodes[n].pos, refuted)
        return
    bound = fact_bound(s, a.value)
    if bound.reason == .unsupported or bound.reason == .budget or bound.reason == .callee:
        wit_unknown(n, bound, what, 0, relation)
        return
    wit_relation(s, s, op, a, b, false, "lower bound")
    wit_context(0)
    wit_help(relation)
    if dir_defer(n, "cannot prove {what}: missing lower bound", true): return
    wit_fail(nodes[n].pos, "cannot prove {what}: missing lower bound")

# A builtin slice `xs[lo..hi)`: 0 <=? lo <=? hi <=? xs.length, where an
# omitted bound is 0 or the length and an inclusive end counts one more.
wit_slice = (n: int, s: mut FactState, lo: int, hi: int, length: int, checks: int[]):
    r = int(nodes[n].b)
    wit_slice_at(n, s, lo, hi, length, checks, int(nodes[n].a), int(nodes[r].a), int(nodes[r].b), has_flag(r, NF_INCLUSIVE))

# (the slice's receiver and bound expressions, 0 for an omitted bound)
wit_slice_at = (n: int, s: mut FactState, lo: int, hi: int, length: int, checks: int[], receiver: int, lo_node: int, hi_node: int, inclusive: bool):
    base = wit_text(receiver)
    start = if lo_node != 0: wit_side(lo, lo_node) else: WitSide(lo, 0, "0", false, true)
    stop = if hi_node != 0: wit_side(hi, hi_node) else: WitSide(hi, 0, (if base != "": "{base}.length" else: ""), true)
    if hi_node != 0 and inclusive and stop.text != "": stop.text = "{stop.text}+1"
    zero = WitSide(fact_constant(s, 0), 0, "0", false, true)
    size = WitSide(length, receiver, (if base != "": "{base}.length" else: ""), true)
    pairs = [(zero, start), (start, stop), (stop, size)]
    labels = ["lower bound", "ordered bounds", "upper bound"]
    refuted = checks.contains(0)
    relation = ""
    missing: str[]
    loop i in [0..3):
        if checks[i] == 1 or refuted and checks[i] != 0: continue
        relation = wit_relation_text(.le, pairs[i].0, pairs[i].1)
        wit_relation(s, s, .le, pairs[i].0, pairs[i].1, refuted, labels[i])
        missing.push(labels[i])
    wit_context(0)
    wit_help(relation)
    if refuted:
        if dir_defer(n, "slice is not in bounds", true): return
        wit_fail(nodes[n].pos, "slice is not in bounds")
        return
    if dir_defer(n, "cannot prove slice is in bounds: missing {join(missing, " and ")}", true): return
    wit_fail(nodes[n].pos, "cannot prove slice is in bounds: missing {join(missing, " and ")}")

wit_divisor = (n: int, s: FactState, divisor: int, zero: int, operand: int, refuted: bool):
    side = wit_side(divisor, operand)
    nil = WitSide(zero, 0, "0", false, true)
    missing = wit_relation(s, s, .ne, side, nil, refuted)
    wit_context(0)
    if refuted:
        wit_help(wit_relation_text(.ne, side, nil))
        if dir_defer(n, "divisor refuted: zero", true): return
        wit_fail(nodes[n].pos, "divisor refuted: zero")
        return
    wit_unknown(n, fact_bound(s, divisor), "divisor is nonzero", 0, wit_relation_text(.ne, side, nil), missing)

wit_ref_text = (term: RefTerm, self: str) -> str:
    text = ""
    if term.kind == 0: text = self
    else if term.kind == 1: return if term.unsigned: "" else: "{term.value}"
    else if term.kind == 3: text = name_of(int(locals[term.value].name))
    if text == "": return ""
    loop selector in term.path: text += if selector == -1: ".length" else: ".{name_of(selector)}"
    text + wit_offset_text(term.offset)

wit_offset_text = (c: int) -> str: if c > 0: " + {c}" else if c < 0: " - {-c}" else: ""

wit_ref_side = (term: RefTerm, value: int, n: int, self: str) -> WitSide:
    if term.kind == 0 and term.path.len() == 0:
        side = wit_side(value, int(nodes[n].a))
        if side.text == "": side.text = self
        return side
    WitSide(value, 0, wit_ref_text(term, self), false, term.kind == 1)

# A refinement obligation at its use, with the contract's declaration span.
wit_refinement = (n: int, t: int, atom: RefAtom, self: int, a: int, b: int, s: FactState, refuted: bool):
    shown = wit_text(int(nodes[n].a))
    if shown == "": shown = "the value"
    x = wit_ref_side(atom.a, a, n, shown)
    y = wit_ref_side(atom.b, b, n, shown)
    op = atom.op
    # Contracts are stored as `a < b`; show the constrained value first.
    if atom.b.kind == 0 and atom.a.kind != 0 and (op == .lt or op == .le):
        swap = x; x = y; y = swap
        op = if op == .lt: Tok.gt else: Tok.ge
    relation = wit_relation_text(op, x, y)
    if refuted and ref_narrowing.has(n):
        wit_help(relation)
        wit_fail(nodes[n].pos, "{shown} does not fit {dt(ref_narrowing[n])}")
        return
    missing = wit_relation(s, s, op, x, y, refuted)
    contract = ref_spans.get(int(types[t].st)) ?? 0
    if refuted:
        wit_context(contract)
        wit_help(relation)
        wit_fail(nodes[n].pos, "refinement refuted: {shown} violates the declared contract")
        return
    what = if relation != "": "refinement `{relation}`" else: "refinement"
    wit_unknown(n, fact_bound(s, self), what, contract, relation, missing)

wit_formal_text = (term: RefTerm, f: int, self: int) -> str:
    index = if term.kind == 0: self else if term.kind == 2 or term.kind == 5: term.value else: -1
    if term.kind == 1 or term.kind == 3: return wit_ref_text(term, "")
    if f <= 0 or index < 0 or index >= fns[f].params.len(): return ""
    text = name_of(int(locals[fns[f].params[index]].name))
    loop selector in term.path: text += if selector == -1: ".length" else: ".{name_of(selector)}"
    text + wit_offset_text(term.offset)

# A `$proof` precondition or exit proposition, named by the proof's formals.
wit_proof = (n: int, s: FactState, atom: RefAtom, a: int, b: int, f: int, self: int, refuted: bool, what: str):
    o = wit_orient(atom.op, WitSide(a, 0, wit_formal_text(atom.a, f, self), false, atom.a.kind == 1), WitSide(b, 0, wit_formal_text(atom.b, f, self), false, atom.b.kind == 1))
    relation = wit_relation_text(o.0, o.1, o.2)
    missing = wit_relation(s, s, o.0, o.1, o.2, refuted)
    contract = if f > 0 and fns[f].decl != 0: nodes[int(fns[f].decl)].pos else: 0
    if refuted:
        wit_context(contract)
        wit_help(relation, false)
        wit_fail(nodes[n].pos, "{what} refuted")
        return
    wit_unknown(n, fact_bound(s, if wit_constant(s, a): b else: a), what, contract, relation, missing, false)

use 'lower_analysis.dewy'
use 'checker_state.dewy'
use 'checker_expr.dewy'
use 'witness_text.dewy'
use 'checker_tokens.dewy'
use 'refinement_types.dewy'
# Explanations of unproven obligations. Nothing here runs until a diagnostic
# is about to be reported: dormant compilation builds no witness data. Notes
# report retained evidence only (bounds, one tombstone per replaced route,
# guard origins); a counterexample is always labeled a POSSIBLE witness.
use 'ast.jo'
use 'lex.jo'
use 'types.jo'
use 'util.jo'
use 'expr.jo'
use 'check.jo'
use 'checks_stmt_hooks.dewy'
use 'checks_static.dewy'
use 'facts.jo'
use 'facts_ranges.dewy'
use 'facts_conditions.dewy'
use 'facts_text.dewy'
use 'facts_maps.dewy'
use 'facts_pools.dewy'
use 'lower.jo'
use 'refine.jo'
use 'nd_contracts.jo'
use 'proofs.jo'
use 'directives.jo'
use 'directive_rules.dewy'
use 'ide.jo'
use 'isolation.jo'
use 'isolation_ops.dewy'
use 'witness_ops.dewy'

struct WitSide:
    value: int = 0
    node: int = 0           # an ident place, for its tombstone
    text: str = ""
    length: bool = false    # the length of the array named by node
    literal: bool = false

# Harness-only (--internal-fact-policy=require-static-all): report each
# failed obligation and continue, so a measurement sees all of them.
wit_collect = false
wit_measure = false
wit_collected = 0
# A partitioned check's process decides its obligations with the other
# processes' bodies opaque: a failure there is tentative, and the whole
# program is decided again serially (pcheck.jo pc_after_facts).
wit_tentative = false
wit_tentative_failed = false
wit_failed_owners: {int: bool} = {}

# (a run after checker errors, whose bodies are left out, before ownership and facts are
# decided: the functions that use one, directly or through others, or that a closure shares
# facts with. Their facts may be missing only because of the earlier error, so their
# unproven obligations are not shown. One walk over the checked bodies, O(their nodes),
# then O(edges) to close the set.)
wit_skip_users: {int: bool} = {}
wit_skipped: {int: bool} = {}       # (the functions whose bodies are left out)

# (the call that last replaced the shown relation's operand, and that relation:
# its repair is evidence after the call. Set by wit_relation, taken by wit_help)
wit_after = 0
wit_after_relation = ""
wit_after_note = 0      # (the span of its note: a later diagnostic's notes start over)

# The spelling of a simple place or literal; "" for anything else.
wit_text = (e0: int, depth: int = 0) -> str:
    e = e0
    if e <= 0 or depth > 8: return ""
    # (a literal union shown as its text keeps its spelling: `p.severity`)
    loop nodes[e].kind == .narrow or nodes[e].kind == .conv and (wit_same_value(e) or nodes[e].aux == i32(int(CV.refinement)) or nodes[e].aux == i32(int(CV.set_text))):
        e = int(nodes[e].a)
    k = nodes[e].kind
    if k == .block:
        if let source = union_field_sources.get(e):
            base = wit_text(source.0, depth + 1)
            if base != "": return "{base}.{name_of(source.1)}"
    # (a value an update captured, `d[name].value = v`: shown as written)
    if k == .ident and nodes[e].name == 0 and nodes[e].aux == i32(int(SK.local)) and nodes[e].sym > 0:
        if let source = capture_sources.get(int(nodes[e].sym)):
            # (a lowering's own temporary, `__lt0`, stays unshown)
            shown = wit_text(source, depth + 1)
            return if starts_with(shown, "__") or starts_with(shown, "#"): "" else: shown
    if k == .ident and nodes[e].name != 0:
        name = name_of(int(nodes[e].name))
        # (`d[v * n // 256] += 1` holds its index in a temporary: it is shown as written)
        if let source = index_update_sources.get(int(nodes[e].name)): return wit_text(source, depth + 1)
        # Narrowed globals and fields use generated path names internally.
        # Follow their checked alias back to the user's place, bounded by the
        # ordinary spelling depth. User-written aliases keep their own names.
        if nodes[e].aux == i32(int(SK.local)) and (starts_with(name, "#L") or starts_with(name, "#G")):
            l = int(nodes[e].sym)
            if int(locals[l].flags) & LF_ALIAS != 0 and locals[l].alias != 0:
                source = int(locals[l].alias)
                if nodes[source].kind == .unwrap: source = int(nodes[source].a)
                return wit_text(source, depth + 1)
        return if wit_hidden_name(name): "" else: name
    if k == .int_lit and not has_flag(e, NF_U64): return "{nodes[e].ival}"
    if k == .str_lit: return wit_quoted(e)
    if k == .field and nodes[e].aux >= 0:
        # (inside a method a member is written bare: `accounts`, not its object's field)
        a = int(nodes[e].a)
        loop nodes[a].kind == .addr or nodes[a].kind == .conv: a = int(nodes[a].a)
        if nodes[a].kind == .ident and nodes[a].name != 0 and starts_with(name_of(int(nodes[a].name)), "$self"): return name_of(int(nodes[e].name))
        base = wit_text(int(nodes[e].a), depth + 1)
        if base != "": return "{base}.{name_of(int(nodes[e].name))}"
    if k == .intrinsic and nodes[e].aux == i32(int(IN.len)) and nkids(e) > 0:
        base = wit_text(kid(e, 0), depth + 1)
        if base != "": return "{base}.length"
    if k == .index and nodes[e].b != 0:
        # (a dictionary entry as a place, `d[k]`, indexes its values at the entry's position)
        at = int(nodes[e].b)
        if nodes[at].kind == .call and (fact_map_call(at) == 3 or fact_map_call(at) == 5) and nkids(at) >= 2:
            base = wit_text(kid(at, 0), depth + 1)
            index = wit_text(kid(at, 1), depth + 1)
            return if base != "" and index != "": "{base}[{index}]" else: ""
        base = wit_text(int(nodes[e].a), depth + 1)
        index = wit_text(int(nodes[e].b), depth + 1)
        if base != "" and index != "": return "{base}[{index}]"
    # (`i // 2` and `v % base` on fixed-width integers: a checked floor operation)
    if k == .binary and (nodes[e].op == i32(int(Tok.percent)) or nodes[e].op == i32(int(Tok.slash)) and is_int(prune(ntype(e)))):
        left = wit_operand(int(nodes[e].a), depth + 1)
        right = wit_operand(int(nodes[e].b), depth + 1)
        if left == "" or right == "": return ""
        operator = if nodes[e].op == i32(int(Tok.percent)): "%" else: "//"
        return "{left} {operator} {right}"
    # (`i + 1`, `n - 1`, `2*i`: the arithmetic of a simple place and literals)
    if k == .binary and (nodes[e].op == i32(int(Tok.plus)) or nodes[e].op == i32(int(Tok.minus)) or nodes[e].op == i32(int(Tok.star))):
        star = nodes[e].op == i32(int(Tok.star))
        left = if star: wit_operand(int(nodes[e].a), depth + 1) else: wit_text(int(nodes[e].a), depth + 1)
        right = if nodes[e].op == i32(int(Tok.plus)): wit_text(int(nodes[e].b), depth + 1) else: wit_operand(int(nodes[e].b), depth + 1)
        if left == "" or right == "": return ""
        if star: return "{left}*{right}"
        sign = if nodes[e].op == i32(int(Tok.plus)): "+" else: "-"
        return "{left} {sign} {right}"
    # (an array literal with a spread, `[ys... 0]`, built in a `$spread` block: expr.jo
    # check_expr; its items as written)
    if k == .block and nkids(e) >= 3 and nkids(e) <= 10 and nodes[kid(e, 0)].kind == .vardecl and starts_with(name_of(int(nodes[kid(e, 0)].name)), "$spread"):
        parts: str[]
        loop i in [1..nkids(e) - 1):
            call = kid(e, i)
            if nodes[call].kind == .exprstmt: call = int(nodes[call].a)
            if nodes[call].kind != .intrinsic or nkids(call) != 2 or nodes[call].aux != i32(int(IN.push)) and nodes[call].aux != i32(int(IN.extend)): return ""
            text = wit_text(kid(call, 1), depth + 1)
            if text == "": return ""
            parts.push(if nodes[call].aux == i32(int(IN.extend)): "{text}..." else: text)
        return "[{join(parts, " ")}]"
    if k == .call:
        # (what the user wrote for a library operation: `text.length`, `v % base`,
        # `i // 2`, a dictionary's or a pool's `d[k]`)
        if fact_string_call(e) == 1:
            base = wit_text(kid(e, 0), depth + 1)
            if base != "": return "{base}.length"
        floor = fact_floor_call(e)
        if floor != 0:
            left = wit_operand(kid(e, 0), depth + 1)
            # (a power of two's helper holds the shift or the mask, not the divisor)
            divisor = kid(e, 1)
            right = if floor == 1 or floor == 2: wit_operand(divisor, depth + 1) else if nodes[divisor].kind != .int_lit: "" else if floor == 3: "{1 << nodes[divisor].ival}" else: "{nodes[divisor].ival + 1}"
            if left == "" or right == "": return ""
            operator = if floor == 1 or floor == 3: "//" else: "%"
            return "{left} {operator} {right}"
        m = fact_map_call(e)
        if m == 2 or m == 5 or fact_pool_call(e) == 2:
            base = wit_text(kid(e, 0), depth + 1)
            index = wit_text(kid(e, 1), depth + 1)
            if base != "" and index != "": return "{base}[{index}]"
            return ""
        return wit_call_text(e, depth)
    ""

# The analyzed function's direct calls with an `@` argument and a shown name,
# collected once per function when a projection's explanation first needs
# them, with each node's parent for wit_reaches. O(function size) once, then
# O(calls) per explanation.
wit_calls_owner = 0
wit_calls: int[]
wit_parents: {int: int} = {}

struct WitLeaf:
    relation: str = ""
    missing: str = ""
    reason: FactBound = FactBound()
    count: int = 0          # operands explained
    unknown: bool = false   # the one described is unknown, not refuted

# `$assert` and the condition it tests, evaluated from `entry`.
wit_obligation = 0   # (the `$assert`-like obligation an unpacking or spread made: deferrable)

# (the slice's receiver and bound expressions, 0 for an omitted bound; a read
# may also be truncated to its receiver: `clamp` offers `xs[$clamp a..b)`)
wit_slice_at = (n: int, s: mut FactState, lo: int, hi: int, length: int, checks: int[], receiver: int, lo_node: int, hi_node: int, inclusive: bool, clamp: bool = false):
    base = wit_text(receiver)
    start = if lo_node != 0: wit_side(lo, lo_node) else: WitSide(lo, 0, "0", false, true)
    stop = if hi_node != 0: wit_side(hi, hi_node) else: WitSide(hi, 0, (if base != "": "{base}.length" else: ""), true)
    if hi_node != 0 and inclusive and stop.text != "": stop.text = "{stop.text} + 1"
    zero = WitSide(fact_constant(s, 0), 0, "0", false, true)
    size = WitSide(length, receiver, (if base != "": "{base}.length" else: ""), true)
    pairs = [(zero, start), (start, stop), (stop, size)]
    labels = ["lower bound", "ordered bounds", "upper bound"]
    refuted = checks.contains(0)
    relations: str[]
    missing: str[]
    loop i in [0..3):
        if checks[i] == 1 or refuted and checks[i] != 0: continue
        shown = wit_relation_text(.le, pairs[i].0, pairs[i].1)
        # (`xs[a..b]` ends inside the receiver: `b <? xs.length` reads better than `b+1 <=? xs.length`)
        if i == 2 and inclusive and hi_node != 0:
            plain = wit_side(hi, hi_node)
            shown = wit_relation_text(.lt, plain, pairs[i].1)
        if shown != "" and not relations.contains(shown): relations.push(shown)
        wit_relation(s, s, .le, pairs[i].0, pairs[i].1, refuted, labels[i])
        missing.push(labels[i])
    wit_context(0)
    relation = join(relations, "` and `")
    wit_help(relation)
    if clamp and (not inclusive or hi_node == 0): wit_clamp_help(base, lo_node, hi_node)
    # (`xs[..3]` read as Python's `xs[:3]`: the closed end includes 3, and Python's stops
    # before it and truncates)
    else if clamp and base != "":
        first = if lo_node != 0: wit_text(lo_node) else: ""
        last = wit_text(hi_node)
        if last != "" and (lo_node == 0 or first != ""):
            err_notes.push((-1, "help: `{base}[{first}..{last}]` includes position {last}; Python's `{base}[{first}:{last}]` stops before it and truncates to `{base}`: `{base}[$clamp {first}..{last})`"))
    if refuted:
        if dir_defer(n, "slice is not in bounds", true): return
        wit_fail(nodes[n].pos, "slice is not in bounds")
        return
    if dir_defer(n, "cannot prove slice is in bounds: missing {join(missing, " and ")}", true): return
    wit_fail(nodes[n].pos, "cannot prove slice is in bounds: missing {join(missing, " and ")}")

# (the array a store's element goes into: refine.jo sets it for the check at hand)
wit_holder_text = ""

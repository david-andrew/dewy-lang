    if ap not=? (uint64(0) as ptr<int32>) {
        let ah=(ap as ptr<int64>) - 3
        if ah[0] =? 1 and ah[1] <? ah[2] {
            start=ah[1]; ah[1]=start + 1; ap[start]=int32<overflow='wrap'>(a0)
            return e_call_span(f start 1 rtype)
        }
    }
    start=ir.args.length
    ir.args.push(int32<overflow='wrap'>(a0))
    return e_call_span(f start 1 rtype)
}
e_call2=(f:IRWord a0:IRWord a1:IRWord rtype:IRWord):>int64=>$unsafe {
    let ap=ir.args.ptr
    let start:IRWord=0
    if ap not=? (uint64(0) as ptr<int32>) {
        let ah=(ap as ptr<int64>) - 3
        if ah[0] =? 1 and ah[1] + 2 <=? ah[2] {
            start=ah[1]; ah[1]=start + 2; ap[start]=int32<overflow='wrap'>(a0); ap[start + 1]=int32<overflow='wrap'>(a1)

    if cp not=? (uint64(0) as ptr<Ins>) {
        let ch=(cp as ptr<int64>) - 3
        if ch[0] =? 1 and ch[1] <? ch[2] {
            let idx=ch[1]; ch[1]=idx + 1
            let q=cp + idx
            q[0].op='block'; q[0].ty=0; q[0].dst=0; q[0].a=0; q[0].b=0; q[0].c=0; q[0].imm=0; q[0].pos=int32<overflow='wrap'>(ir_pos)

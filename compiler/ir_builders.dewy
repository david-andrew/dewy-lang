e_call_span=(f:IRWord start:IRWord n:IRWord rtype:IRWord):>int64=>$unsafe {
    let d:IRWord=-1
    if rtype >=? 0 {d=vreg(rtype)}
    let c:IRWord=if ir_cold {2} else {0}
    let cp=ir.code.ptr
    if cp not=? (uint64(0) as ptr<Ins>) {
        let ch=(cp as ptr<int64>) - 3
        if ch[0] =? 1 and ch[1] <? ch[2] {
            let idx=ch[1]; ch[1]=idx + 1
            let q=cp + idx
            q[0].op='call'; q[0].ty=int32<overflow='wrap'>(rtype); q[0].dst=int32<overflow='wrap'>(d); q[0].a=int32<overflow='wrap'>(start); q[0].b=int32<overflow='wrap'>(n); q[0].c=int32<overflow='wrap'>(c); q[0].imm=f; q[0].pos=int32<overflow='wrap'>(ir_pos)

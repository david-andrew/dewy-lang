}
e_mov=(dst:IRWord src:IRWord):>int64=>$unsafe {
    let t:IRWord=IRWord(ir.vtypes.ptr[dst])
    if t =? VK {ice("assignment to a constant vreg");}
    let cp=ir.code.ptr
    if cp not=? (uint64(0) as ptr<Ins>) {
        let ch=(cp as ptr<int64>) - 3
        if ch[0] =? 1 and ch[1] <? ch[2] {
            let idx=ch[1]; ch[1]=idx + 1
            let q=cp + idx
            q[0].op='mov'; q[0].ty=int32<overflow='wrap'>(t); q[0].dst=int32<overflow='wrap'>(dst); q[0].a=int32<overflow='wrap'>(src); q[0].b=0; q[0].c=0; q[0].imm=0; q[0].pos=int32<overflow='wrap'>(ir_pos)
            return idx
        }
    }
    ir_code_slow('mov' t dst src 0 0 0)
}
e_addi=(a:IRWord k:IRWord):>int64=>$unsafe {
    if k =? 0 {return a}
    let kv=e_iconst(k)
    let vp=ir.vtypes.ptr
    let d:IRWord=0
    if vp not=? (uint64(0) as ptr<int8>) {

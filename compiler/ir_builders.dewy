            d=vh[1]; vh[1]=d + 1; vp[d]=0
        } else {d=ir_vreg_slow(VI)}
    } else {d=ir_vreg_slow(VI)}
    let cp=ir.code.ptr
    if cp not=? (uint64(0) as ptr<Ins>) {
        let ch=(cp as ptr<int64>) - 3
        if ch[0] =? 1 and ch[1] <? ch[2] {
            let idx=ch[1]; ch[1]=idx + 1
            let q=cp + idx
            q[0].op='add'; q[0].ty=0; q[0].dst=int32<overflow='wrap'>(d); q[0].a=int32<overflow='wrap'>(a); q[0].b=int32<overflow='wrap'>(kv); q[0].c=0; q[0].imm=0; q[0].pos=int32<overflow='wrap'>(ir_pos)
            return d
        }
    }

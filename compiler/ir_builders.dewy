e_call=(f:IRWord args:array<int64> rt:IRWord):>int64=>$unsafe {
    let n=args.length
    let start=ir.args.length
    if n >? 0 {
        let ap=ir.args.ptr
        if ap not=? (uint64(0) as ptr<int32>) {
            let ah=(ap as ptr<int64>) - 3
            if ah[0] =? 1 and start + n <=? ah[2] {
                ah[1]=start + n
                let sp=args.ptr
                loop i in [0..n) {ap[start + i]=int32<overflow='wrap'>(sp[i])}
            } else {
                loop a in args {ir.args.push(int32<overflow='wrap'>(a));}
            }
        } else {
            loop a in args {ir.args.push(int32<overflow='wrap'>(a));}
        }
    }
    e_call_span(f start n rt)
}
e_calli=(fp:IRWord args:array<int64> rt:IRWord cabi:bool):>int64=>$unsafe {
    let start=ir.args.length
    loop a in args {ir.args.push(int32<overflow='wrap'>(a));}

use 'ir_types.dewy'
use 'ir.jo'
use 'ir_builders.dewy'
use 'opt.jo'

# ---------------- loop-invariant code motion ----------------
# Arithmetic in a loop whose operands the loop does not change is moved in front of it (of the
# outermost such loop), after the loop's entry test: it runs once instead of every iteration.
# Only pure instructions that cannot trap move (float division gives inf or NaN, never traps); a value defined once is required, and every
# definition dominates its uses, so the new place still precedes every use. (Release builds, on
# the final code of each function.)
# (only what costs more than the register it then holds through the loop: one-cycle integer
# operations, which also fold into addresses, are left in place)
licm_op = (op: Op) -> bool:
    match op:
        mul, i2f, u2f, f2f: true
        fadd, fsub, fmul, fdiv, fmin, fmax: true
        _: false

o_licm = (code: Ins[]) -> Ins[]:
    n = code.len()
    nv = ir.vtypes.len()
    # is there anything to move at all
    kinds: Op[]
    depth = 0
    cands = 0
    loop ins in code:
        op = ins.op
        if op == .block or op == .if_ or op == .loop:
            kinds.push(op)
            if op == .loop: depth += 1
        else if op == .end:
            if kinds.pop() == .loop: depth -= 1
        else if depth > 0 and licm_op(op): cands += 1
    if cands == 0: return code
    # where each loop ends
    lp_end = fill(-1, n)
    open: int[]
    loop i in 0.. and ins in code:
        op = ins.op
        if op == .block or op == .if_ or op == .loop: open.push(i)
        else if op == .end:
            st = open.pop()
            if code[st].op == .loop: lp_end[st] = i
    # definition positions of each vreg, ascending (doubled: an instruction moved in front of
    # position p is at 2p - 1)
    first = fill(0, nv + 1)
    loop ins in code:
        d = int(ins.dst)
        if d >= 0 and o_defines(ins.op): first[d + 1] += 1
        if ins.op == .zeroslots:
            loop k in [0..int(ins.b)):
                item = int(ir.args[int(ins.a) + k])
                if item & 1 == 1: first[(item >> 1) + 1] += 1
    loop v in [0..nv): first[v + 1] += first[v]
    dpos = fill(0, first[nv])
    at = first
    loop i in 0.. and ins in code:
        d = int(ins.dst)
        if d >= 0 and o_defines(ins.op):
            dpos[at[d]] = 2 * i
            at[d] += 1
        if ins.op == .zeroslots:
            loop k in [0..int(ins.b)):
                item = int(ir.args[int(ins.a) + k])
                if item & 1 == 1:
                    v = item >> 1
                    dpos[at[v]] = 2 * i
                    at[v] += 1
    first = fill(0, nv + 1)
    loop v in [0..nv): first[v + 1] = at[v]
    # choose what moves where: (loop start, instruction) pairs, in instruction order
    moved = fill(false, n)
    moves: (int, int)[]
    loops_open: int[]
    loop i in 0.. and ins in code:
        op = ins.op
        if op == .loop: loops_open.push(i)
        else if op == .end and loops_open.len() > 0 and lp_end[loops_open[loops_open.len() - 1]] == i: loops_open.pop()
        if loops_open.len() == 0 or not licm_op(op): continue
        d = int(ins.dst)
        if d < 0 or first[d + 1] - first[d] != 1: continue
        ir_operands(ins)
        # the outermost enclosing loop that defines none of the operands
        target = -1
        loop L in loops_open:
            ok = true
            loop operand_index in [0..ir_use_count):
                let u = ir_use(operand_index)
                if o_def_within(dpos, first[u], first[u + 1], 2 * L, 2 * lp_end[L]):
                    ok = false
                    break
            if ok:
                target = L
                break
        if target < 0: continue
        moved[i] = true
        moves.push((target, i))
        dpos[first[d]] = 2 * target - 1
    if moves.len() == 0: return code
    moves.sort_by((m: (int, int)): m.0 * n + m.1)
    out: Ins[]
    out.reserve(n)
    k = 0
    loop i in 0.. and ins in code:
        if moved[i]: continue
        loop k < moves.len() and moves[k].0 == i:
            out.push(code[moves[k].1])
            k += 1
        out.push(ins)
    out

# is any of dpos[lo..hi) (ascending, but for single entries) within [s, e]
o_def_within = (dpos: int[], lo: int, hi: int, s: int, e: int) -> bool:
    if hi - lo == 1: return dpos[lo] >= s and dpos[lo] <= e
    a = lo
    b = hi
    loop a < b:
        m = (a + b) / 2
        if dpos[m] < s: a = m + 1
        else: b = m
    a < hi and dpos[a] <= e


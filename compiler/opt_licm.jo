use 'ir_types.dewy'
use 'ir.jo'
use 'ir_builders.dewy'
use 'opt.jo'
use 'opt_workspace.dewy'

# ---------------- loop-invariant code motion ----------------
# Arithmetic in a loop whose operands the loop does not change is moved in front of it (of the
# outermost such loop), after the loop's entry test: it runs once instead of every iteration.
# Only pure instructions that cannot trap move (float division gives inf or NaN, never traps); a value defined once is required, and every
# definition dominates its uses, so the new place still precedes every use. (Release builds, on
# the final code of each function.)
# (only what costs more than the register it then holds through the loop: one-cycle integer
# operations, which also fold into addresses, are left in place)

licm_dst: int[]
licm_src: int[]
licm_mark: u8[]
licm_drop: int[]
licm_rfrom: int[]
licm_rto: int[]

o_licm_rewrite = (code: mut Ins[], rfrom: int[], rto: int[]):
    nr = rfrom.len()
    if nr == 0: return
    nv = ir.vtypes.len()
    rmap = fill(i32(-1), nv)
    mp = data(rmap)
    fp = data(rfrom)
    tp = data(rto)
    loop i in [0..nr): mp[fp[i]] = i32(tp[i])
    dec = opt_decode
    args = data(ir.args)
    base = data(code)
    nc = code.len()
    loop i in [0..nc):
        cp = base + i
        mask = dec[int((cp as *u32)[0])] >> 8
        if (mask & 16) != 0:
            a0 = int(cp.a)
            b0 = int(cp.b)
            loop k in [a0..a0 + b0):
                u = int(args[k])
                if u >= 0 and u < nv:
                    r = mp[u]
                    if r >= 0: args[k] = r
        else:
            if (mask & 1) != 0 or ((mask & 32) != 0 and cp.a >= 0):
                u = int(cp.a)
                if u >= 0 and u < nv:
                    r = mp[u]
                    if r >= 0: cp.a = r
            if (mask & 2) != 0 or ((mask & 64) != 0 and (int(cp.c) & M_INDEX) != 0):
                u = int(cp.b)
                if u >= 0 and u < nv:
                    r = mp[u]
                    if r >= 0: cp.b = r
            if (mask & 8) != 0 or ((mask & 128) != 0 and (int(cp.c) & M_INDEX) != 0):
                u = int(cp.dst)
                if u >= 0 and u < nv:
                    r = mp[u]
                    if r >= 0: cp.dst = r
        if (mask & 4) != 0:
            u = int(cp.c)
            if u >= 0 and u < nv:
                r = mp[u]
                if r >= 0: cp.c = r

licm_op = (op: Op) -> bool:
    match op:
        mul, i2f, u2f, f2f: true
        fadd, fsub, fmul, fdiv, fmin, fmax: true
        _: false

licm_cand = (ins: Ins) -> bool:
    licm_op(ins.op) or (ins.op == .iconst and (ins.imm < -2147483648 or ins.imm > 2147483647))

o_licm_apply = (code: Ins[], n: int, nm: int, drop: int[], rfrom: int[], rto: int[]) -> Ins[]:
    if licm_mark.len() < n: licm_mark.resize(n)
    cp = data(code)
    mp = data(licm_mark)
    sp = data(licm_src)
    dp = data(licm_dst)
    drp = data(drop)
    nd = drop.len()
    loop j in [0..nm): mp[sp[j]] = u8(1)
    loop j in [0..nd): mp[drp[j]] = u8(1)
    out: Ins[]
    out.reserve(n)
    __set_len(out, n)
    op_out = data(out)
    w = 0
    k = 0
    loop i in [0..n):
        if mp[i] != 0: mp[i] = u8(0); continue
        loop k < nm and dp[k] == i:
            op_out[w] = cp[sp[k]]
            w += 1
            k += 1
        op_out[w] = cp[i]
        w += 1
    __set_len(out, w)
    if rfrom.len() > 0: o_licm_rewrite(out, rfrom, rto)
    out

o_licm_release = (code: Ins[]) -> Ins[]:
    n = code.len()
    nv = ir.vtypes.len()
    # is there anything to move at all
    kinds: Op[]
    depth = 0
    cands = 0
    loop ins in code:
        op = ins.op
        if op == .block or op == .if_ or op == .loop:
            kinds.push(op)
            if op == .loop: depth += 1
        else if op == .end:
            if kinds.pop() == .loop: depth -= 1
        else if depth > 0 and licm_cand(ins): cands += 1
    if cands == 0: return code
    # where each loop ends
    lp_end = fill(-1, n)
    open: int[]
    loop i in 0.. and ins in code:
        op = ins.op
        if op == .block or op == .if_ or op == .loop: open.push(i)
        else if op == .end:
            st = open.pop()
            if code[st].op == .loop: lp_end[st] = i
    # definition positions of each vreg, ascending (doubled: an instruction moved in front of
    # position p is at 2p - 1)
    first = fill(0, nv + 1)
    loop ins in code:
        d = int(ins.dst)
        if d >= 0 and o_defines(ins.op): first[d + 1] += 1
        if ins.op == .zeroslots:
            loop k in [0..int(ins.b)):
                item = int(ir.args[int(ins.a) + k])
                if item & 1 == 1: first[(item >> 1) + 1] += 1
    loop v in [0..nv): first[v + 1] += first[v]
    dpos = fill(0, first[nv])
    at = first
    loop i in 0.. and ins in code:
        d = int(ins.dst)
        if d >= 0 and o_defines(ins.op):
            dpos[at[d]] = 2 * i
            at[d] += 1
        if ins.op == .zeroslots:
            loop k in [0..int(ins.b)):
                item = int(ir.args[int(ins.a) + k])
                if item & 1 == 1:
                    v = item >> 1
                    dpos[at[v]] = 2 * i
                    at[v] += 1
    first = fill(0, nv + 1)
    loop v in [0..nv): first[v + 1] = at[v]
    # choose what moves where: (loop start, instruction) pairs, in instruction order
    moved = fill(false, n)
    moves: (int, int)[]
    hl: int[]
    hi: int[]
    hr: int[]
    rfrom: int[]
    rto: int[]
    loops_open: int[]
    loop i in 0.. and ins in code:
        op = ins.op
        if op == .loop: loops_open.push(i)
        else if op == .end and loops_open.len() > 0 and lp_end[loops_open[loops_open.len() - 1]] == i: loops_open.pop()
        if loops_open.len() == 0 or not licm_cand(ins): continue
        d = int(ins.dst)
        if d < 0 or first[d + 1] - first[d] != 1: continue
        ir_operands(ins)
        # the outermost enclosing loop that defines none of the operands
        target = -1
        loop L in loops_open:
            ok = true
            loop operand_index in [0..ir_use_count):
                u = ir_use(operand_index)
                if o_def_within(dpos, first[u], first[u + 1], 2 * L, 2 * lp_end[L]):
                    ok = false
                    break
            if ok:
                target = L
                break
        if target < 0: continue
        if op == .iconst and ins.ty == 0:
            dup = -1
            nh = hl.len()
            hlp = data(hl)
            hip = data(hi)
            hrp = data(hr)
            loop j in [0..nh):
                if hlp[j] == target and hip[j] == ins.imm: dup = hrp[j]; break
            if dup >= 0:
                moved[i] = true
                rfrom.push(d)
                rto.push(dup)
                dpos[first[d]] = 2 * target - 1
                continue
            hl.push(target)
            hi.push(ins.imm)
            hr.push(d)
        moved[i] = true
        moves.push((target, i))
        dpos[first[d]] = 2 * target - 1
    if moves.len() == 0: return code
    moves.sort_by((m: (int, int)): m.0 * n + m.1)
    out: Ins[]
    out.reserve(n)
    k = 0
    loop i in 0.. and ins in code:
        if moved[i]: continue
        loop k < moves.len() and moves[k].0 == i:
            out.push(code[moves[k].1])
            k += 1
        out.push(ins)
    if rfrom.len() > 0: o_licm_rewrite(out, rfrom, rto)
    out

o_licm = (code: Ins[]) -> Ins[]:
    n = code.len()
    if n == 0: return code
    if opt_allow_cse: return o_licm_release(code)
    cp = data(code)
    depth = 0
    loop_mask: u64 = 0
    outer_loop = -1
    nm = 0
    regs = o_regs
    fnv = opt_fast_nv
    if licm_dst.len() > 0: __set_len(licm_dst, 0)
    if licm_src.len() > 0: __set_len(licm_src, 0)
    if licm_drop.len() > 0: __set_len(licm_drop, 0)
    if licm_rfrom.len() > 0: __set_len(licm_rfrom, 0)
    if licm_rto.len() > 0: __set_len(licm_rto, 0)
    loop i in [0..n):
        ins = cp + i
        op = ins.op
        if op == .block or op == .if_ or op == .loop:
            if depth >= 64: return o_licm_release(code)
            if op == .loop:
                if loop_mask == 0: outer_loop = i
                loop_mask |= u64(1) << u64(depth)
            depth += 1
        else if op == .end:
            depth -= 1
            loop_mask &= (u64(1) << u64(depth)) xor u64(0xFFFFFFFFFFFFFFFF)
            if loop_mask == 0: outer_loop = -1
        else if outer_loop >= 0 and op == .iconst and (ins.imm < -2147483648 or ins.imm > 2147483647):
            d = int(ins.dst)
            if d >= 0 and (d >= fnv or regs[d].stable):
                dup = -1
                if nm > 0 and ins.ty == 0:
                    dp = data(licm_dst)
                    sp = data(licm_src)
                    kv = ins.imm
                    loop j in [0..nm):
                        if dp[j] == outer_loop:
                            prev = cp + sp[j]
                            if prev.ty == 0 and prev.imm == kv: dup = int(prev.dst); break
                if dup >= 0:
                    licm_drop.push(i)
                    licm_rfrom.push(d)
                    licm_rto.push(dup)
                else:
                    licm_dst.push(outer_loop)
                    licm_src.push(i)
                    nm += 1
    if nm == 0: return code
    o_licm_apply(code, n, nm, licm_drop, licm_rfrom, licm_rto)

# is any of dpos[lo..hi) (ascending, but for single entries) within [s, e]
o_def_within = (dpos: int[], lo: int, hi: int, s: int, e: int) -> bool:
    if hi - lo == 1: return dpos[lo] >= s and dpos[lo] <= e
    a = lo
    b = hi
    loop a < b:
        m = (a + b) / 2
        if dpos[m] < s: a = m + 1
        else: b = m
    a < hi and dpos[a] <= e

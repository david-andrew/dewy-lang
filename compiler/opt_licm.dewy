$runtime_checks

from p"ir_types.dewy" import (Ins Op)
from p"ir.jo" import (ir ir_use_count)
from p"ir_builders.dewy" import (ir_operands ir_use)
from p"opt.jo" import (o_defines)

LicmWord:type=int64<overflow='wrap'>

licm_op=(op:Op):>bool=>match op {
    <'mul'|'i2f'|'u2f'|'f2f'> => true
    <'fadd'|'fsub'|'fmul'|'fdiv'|'fmin'|'fmax'> => true
    _ => false
}

o_licm=(code:array<Ins>):>array<Ins>=>$unsafe {
    let n=code.length
    let nv=ir.vtypes.length
    let kinds:array<Op>=[]
    let depth:LicmWord=0
    let cands:LicmWord=0
    loop ins in code {
        let op=ins.op
        if op =? 'block' or op =? 'if_' or op =? 'loop' {
            kinds.push(op)
            if op =? 'loop' {depth+=1}
        } else if op =? 'end' {
            if kinds.pop() =? 'loop' {depth-=1}
        } else if depth >? 0 and licm_op(op) {cands+=1}
    }
    if cands =? 0 {return code}
    let lp_end:array<LicmWord>=fill(LicmWord(-1) n)
    let open_blocks:array<LicmWord>=[]
    loop i in [0..n) {
        let op=code[i].op
        if op =? 'block' or op =? 'if_' or op =? 'loop' {open_blocks.push(i)}
        else if op =? 'end' {
            let st=open_blocks.pop()
            if code[st].op =? 'loop' {lp_end[st]=i}
        }
    }
    let first:array<LicmWord>=fill(LicmWord(0) (nv + 1))
    loop ins in code {
        let d=int64(ins.dst)
        if d >=? 0 and o_defines(ins.op) {first[d+1]+=1}
        if ins.op =? 'zeroslots' {
            loop k in [0..int64(ins.b)) {
                let item=int64(ir.args[int64(ins.a)+k])
                if item & 1 =? 1 {first[(item >> 1)+1]+=1}
            }
        }
    }
    loop v in [0..nv) {first[v+1]+=first[v]}
    let dpos:array<LicmWord>=fill(LicmWord(0) first[nv])
    let at=first
    loop i in [0..n) {
        let ins=code[i]
        let d=int64(ins.dst)
        if d >=? 0 and o_defines(ins.op) {
            dpos[at[d]]=2*i
            at[d]+=1
        }
        if ins.op =? 'zeroslots' {
            loop k in [0..int64(ins.b)) {
                let item=int64(ir.args[int64(ins.a)+k])
                if item & 1 =? 1 {
                    let v=item >> 1
                    dpos[at[v]]=2*i
                    at[v]+=1
                }
            }
        }
    }
    first=fill(LicmWord(0) (nv+1))
    loop v in [0..nv) {first[v+1]=at[v]}
    let moved:array<bool>=fill(false n)
    let moves:array<[int64 int64]>=[]
    let loops_open:array<LicmWord>=[]
    loop i in [0..n) {
        let ins=code[i]
        let op=ins.op
        if op =? 'loop' {loops_open.push(i)}
        else if op =? 'end' and loops_open.length >? 0 and lp_end[loops_open[loops_open.length-1]] =? i {loops_open.pop();}
        if loops_open.length =? 0 or not licm_op(op) {continue}
        let d=int64(ins.dst)
        if d <? 0 or first[d+1]-first[d] not=? 1 {continue}
        ir_operands(ins);
        let target:LicmWord=-1
        loop L in loops_open {
            let ok=true
            loop operand_index in [0..ir_use_count) {
                let u=int64(ir_use(operand_index))
                if o_def_within(dpos first[u] first[u+1] 2*L 2*lp_end[L]) {
                    ok=false
                    break
                }
            }
            if ok {target=L break}
        }
        if target <? 0 {continue}
        moved[i]=true
        moves.push([target i])
        dpos[first[d]]=2*target-1
    }
    if moves.length =? 0 {return code}
    moves.sort()
    let out:array<Ins>=[]
    out.reserve(n)
    let k:LicmWord=0
    loop i in [0..n) {
        if moved[i] {continue}
        loop k <? moves.length and moves[k][0] =? i {
            out.push(code[moves[k][1]])
            k+=1
        }
        out.push(code[i])
    }
    out
}

o_def_within=(dpos:array<LicmWord> lo:int64 hi:int64 s:int64 e:int64):>bool=>$unsafe {
    if hi-lo =? 1 {return dpos[lo] >=? s and dpos[lo] <=? e}
    let a=lo
    let b=hi
    loop a <? b {
        let m=(a+b)//2
        if dpos[m] <? s {a=m+1} else {b=m}
    }
    a <? hi and dpos[a] <=? e
}

let capture_either_wanted:ptr<int64>=$unsafe (uint64(0) as ptr<int64>)
let capture_equal_arrays:ptr<dict<int64 [int64 int64 int64]>>=$unsafe (uint64(0) as ptr<dict<int64 [int64 int64 int64]>>)
let capture_loans:ptr<array<FactLoan>>=$unsafe (uint64(0) as ptr<array<FactLoan>>)
let capture_loop_exhausted:ptr<bool>=$unsafe (uint64(0) as ptr<bool>)
let capture_loop_steps:ptr<int64>=$unsafe (uint64(0) as ptr<int64>)
let capture_loops:ptr<array<FactLoop>>=$unsafe (uint64(0) as ptr<array<FactLoop>>)
let capture_name_vals:ptr<int64>=$unsafe (uint64(0) as ptr<int64>)

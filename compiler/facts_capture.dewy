# Bind Jo-owned write places once. Recursive calls never copy this shared state.
let capture_comprehension_sources:ptr<dict<int64 int64>>=$unsafe (uint64(0) as ptr<dict<int64 int64>>)
let capture_comprehensions:ptr<dict<int64 int64>>=$unsafe (uint64(0) as ptr<dict<int64 int64>>)
let capture_constructor_actuals:ptr<dict<int64 array<int64>>>=$unsafe (uint64(0) as ptr<dict<int64 array<int64>>>)

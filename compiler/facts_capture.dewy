let capture_pending_defers:ptr<int64>=$unsafe (uint64(0) as ptr<int64>)
let capture_query:ptr<bool>=$unsafe (uint64(0) as ptr<bool>)
let capture_route_call:ptr<int64>=$unsafe (uint64(0) as ptr<int64>)
let capture_route_reuse:ptr<int64>=$unsafe (uint64(0) as ptr<int64>)
let capture_route_selectors:ptr<dict<int64 [int64 int64]>>=$unsafe (uint64(0) as ptr<dict<int64 [int64 int64]>>)
let capture_saving:ptr<bool>=$unsafe (uint64(0) as ptr<bool>)
let capture_selector_sources:ptr<dict<int64 int64>>=$unsafe (uint64(0) as ptr<dict<int64 int64>>)
let capture_shared_literals:ptr<array<[int64 int64]>>=$unsafe (uint64(0) as ptr<array<[int64 int64]>>)
let capture_sum_operand:ptr<int64>=$unsafe (uint64(0) as ptr<int64>)
let capture_terms:ptr<array<FactTerm>>=$unsafe (uint64(0) as ptr<array<FactTerm>>)

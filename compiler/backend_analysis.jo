# Frozen shared backend analysis; preserves the pre-cutover walks.
use 'ir_types.dewy'
use 'ir_operands.dewy'

const LOC_SPILL = -1
const LOC_CONST = -2
const LOC_SLOT = -3
const LOC_NONE = -4
const LOC_GLOBAL = -5
const LOC_FCONST = -6        # a float constant: read from read-only data where used (vcval: its bits)
vgkind_storage: int[]
vgkind: *int
vgoff_storage: int[]
vgoff: *int
vloc_storage: int[]
vloc: *int
vcval_storage: int[]
vcval: *int
vslot_storage: int[]
vslot: *int
vsoff_storage: int[]
vsoff: *int
vsave_storage: bool[]
vsave: *bool              # in a caller-saved register, saved/restored around calls
backend_debug_vregs: int[]
dbg_keep: bool[]           # (sloppy build -g) a variable's: not in a register a call changes
v_live_storage: IrUsePlan[]
v_live: *IrUsePlan
v_start_storage: int[]
v_start: *int             # final instruction position -> first allocation candidate
call_pos: int[]
call_w: int[]              # per call: its weight by loop depth
loop_s: int[]
loop_e: int[]
ra_loop_visits = 0
const INLINE_COPY = 256
x_has_foreign_call = false
x_has_narrow32 = false
x_has_overflow_pair = false

backend_call_like = (ins: *Ins, dbg_on: bool, target_wasm: bool) -> bool:
    op = ins.op
    if op == .intr and ins.imm >= 2: return true
    if op == .call and ins.c == 1 and not dbg_on: return false      # never returns (a panic: with -g, where its caller's variables must be readable)
    if op == .call and ins.c >= 3 and ins.c <= 5 and not target_wasm: return false     # (through a stub keeping every register)
    if op == .call or op == .calli or op == .callc or op == .syscall or op == .memcpy or op == .memset or op == .findb or op == .scanbytes: return true
    if op == .copy or op == .zero: return ins.imm > INLINE_COPY
    false

# A returned scalar consumed only by the following nonreturning call needs no
# earlier registers preserved. Linear live intervals otherwise extend values
# from the successful path across this terminal failure path.
backend_call_ends_here = (ir: mut IrFn, pos: int, ins: *Ins, dbg_on: bool) -> bool:
    if dbg_on or ins.dst < 0 or pos + 1 >= ir.code.len(): return false
    if ins.op != .call and ins.op != .calli and ins.op != .callc: return false
    next = ir.code[pos + 1]
    if next.op != .call or next.c != 1: return false
    loop k in [0..int(next.b)):
        v = int(ir.args[int(next.a) + k])
        if v != int(ins.dst) and int(ir.vtypes[v]) != 3: return false
    true

backend_analyze = (ir: mut IrFn, ir_operand_layout: mut int[], dbg_on: bool, target_wasm: bool, ra_stat: bool, plan_starts: bool = false):
    x_has_foreign_call = false
    x_has_narrow32 = false
    x_has_overflow_pair = false
    nv = ir.vtypes.len()
    # Private backend scratch, borrowed until the next analyze. Grow only at a
    # new high-water mark; no pointer escapes into an IR or output fragment.
    # O(vregs) initialization, with address/constant payloads written on demand.
    if v_live_storage.len() < nv: v_live_storage.resize(nv)
    if vloc_storage.len() < nv: vloc_storage.resize(nv)
    if vcval_storage.len() < nv: vcval_storage.resize(nv)
    if vslot_storage.len() < nv: vslot_storage.resize(nv)
    if vsoff_storage.len() < nv: vsoff_storage.resize(nv)
    if vgkind_storage.len() < nv: vgkind_storage.resize(nv)
    if vgoff_storage.len() < nv: vgoff_storage.resize(nv)
    if vsave_storage.len() < nv: vsave_storage.resize(nv)
    v_live = data(v_live_storage)
    vloc = data(vloc_storage)
    vcval = data(vcval_storage)
    vslot = data(vslot_storage)
    vsoff = data(vsoff_storage)
    vgkind = data(vgkind_storage)
    vgoff = data(vgoff_storage)
    vsave = data(vsave_storage)
    loop v in [0..nv):
        v_live[v] = IrUsePlan()
        vloc[v] = LOC_SPILL
        vsave[v] = false
    call_pos.clear()
    call_w.clear()
    loop_s.clear()
    loop_e.clear()
    kinds: int[]
    starts: int[]
    loop p in [0..ir.nparams):
        v_live[p].first = 0
        v_live[p].last = 0
        v_live[p].ndef = 1
    loop v in [0..ir.kval.len()):
        if int(ir.vtypes[v]) == 3:
            v_live[v].ndef = 1
            vloc[v] = LOC_CONST
            vcval[v] = ir.kval[v]
    depth = 0
    cold_depth = 0
    w = 1
    instructions = data(ir.code)
    arguments = data(ir.args)
    layouts = data(ir_operand_layout)
    features = 0
    # One indexed scan of the final instructions and their argument spans:
    # O(instructions + operands). No shared decoder state or per-op arrays.
    loop pos in [0..ir.code.len()):
        ins = &instructions[pos]
        if ins.op == .callc: x_has_foreign_call = true
        mode = layouts[int(ins.op)]
        features |= mode
        uses = &ins.a
        nuses = mode & 3
        extra = -1
        if mode & IR_ARGS != 0:
            uses = arguments + int(ins.a)
            nuses = int(ins.b)
            if mode & IR_INDIRECT != 0: extra = int(ins.c)
        else if mode & IR_STORE != 0:
            if mode & IR_INDEX == 0 or int(ins.c) & 128 != 0: extra = int(ins.dst)
        else if mode & IR_INDEX != 0:
            if int(ins.c) & 128 != 0: nuses = 2
        else if mode & IR_RETURN != 0 and ins.a < 0: nuses = 0
        loop operand_index in [0..nuses):
            live = &v_live[int(uses[operand_index])]
            if pos < live.first: live.first = pos
            live.last = pos
            live.nuse += 1
            live.weight += w
        if extra >= 0:
            live = &v_live[extra]
            if pos < live.first: live.first = pos
            live.last = pos
            live.nuse += 1
            live.weight += w
        d = -1
        if mode & IR_DEF != 0: d = int(ins.dst)
        if d >= 0:
            live = &v_live[d]
            if pos < live.first: live.first = pos
            live.last = pos
            live.ndef += 1
            live.weight += w
            if live.ndef == 1:
                op = ins.op
                if op == .iconst and (ins.imm >= -2147483648 and ins.imm <= 2147483647):
                    vloc[d] = LOC_CONST
                    vcval[d] = ins.imm
                else if op == .fconst:
                    vloc[d] = LOC_FCONST
                    vcval[d] = ins.imm
                else if op == .slot:
                    vloc[d] = LOC_SLOT
                    vslot[d] = int(ins.a)
                    vsoff[d] = 0
                else if op == .gaddr or op == .daddr:
                    vloc[d] = LOC_GLOBAL
                    vgoff[d] = int(ins.imm)
                    vgkind[d] = if op == .gaddr: 1 else: 0
                else if op == .add and vloc[int(ins.a)] == LOC_SLOT and vloc[int(ins.b)] == LOC_CONST and v_live[int(ins.a)].ndef == 1 and v_live[int(ins.b)].ndef == 1:
                    vloc[d] = LOC_SLOT
                    vslot[d] = vslot[int(ins.a)]
                    vsoff[d] = vsoff[int(ins.a)] + vcval[int(ins.b)]
        if ins.op == .zeroslots:
            loop k in [0..int(ins.b)):
                item = int(ir.args[int(ins.a) + k])
                if item & 1 == 1:
                    v = item >> 1
                    live = &v_live[v]
                    if pos < live.first: live.first = pos
                    live.last = pos
                    live.ndef += 2
        if mode & IR_CALL != 0 and backend_call_like(ins, dbg_on, target_wasm) and not backend_call_ends_here(ir, pos, ins, dbg_on):
            call_pos.push(pos)
            # (a call on a rarely taken path counts as if outside any loop)
            if ins.op == .call and ins.c == 2: call_w.push(1)
            else: call_w.push(w)
        if ins.op == .block or ins.op == .loop or ins.op == .if_:
            kinds.push(int(ins.op))
            if ins.op == .loop:
                starts.push(loop_s.len())
                loop_s.push(pos)
                loop_e.push(0)
                depth += 1
                if ins.imm != 0: cold_depth += 1
                w = if cold_depth > 0: 1 else: 1 << (3 * min(depth, 6))
            else: starts.push(-1)
        else if ins.op == .end:
            k = kinds.pop()
            s = starts.pop()
            if k == int(Op.loop):
                depth -= 1
                if instructions[loop_s[s]].imm != 0: cold_depth -= 1
                w = if cold_depth > 0: 1 else: 1 << (3 * min(depth, 6))
                loop_e[s] = pos
    x_has_narrow32 = features & IR_NARROW32 != 0
    x_has_overflow_pair = features & IR_OVERFLOW != 0
    # (sloppy build -g: each variable lives on to the end of the function, where debuggers can
    # read it, and not in a register a call changes: dbg_keep)
    if dbg_on:
        dbg_keep = fill(false, nv)
        loop v in backend_debug_vregs:
            if v < 0 or v >= nv or v_live[v].last < 0: continue
            dbg_keep[v] = true
            v_live[v].last = ir.code.len()
            v_live[v].nuse += 1
    # Publish the demanded allocation index while finalizing use summaries,
    # preserving the old vreg order. ARM64/no-allocation callers need no index.
    if plan_starts:
        n = ir.code.len() + 1
        if v_start_storage.len() < n: v_start_storage.resize(n)
        v_start = data(v_start_storage)
        loop pos in [0..n): v_start[pos] = -1
    # Loop summaries are already in start order. Complexity is
    # O(vregs * log(loops) + visited loop summaries); count actual revisits.
    nl = loop_s.len()
    loop v in [0..nv):
        live = &v_live[v]
        loc = vloc[v]
        # A vreg defined more than once cannot stay a constant/address.
        if live.ndef != 1:
            loc = LOC_SPILL
            vloc[v] = loc
        if plan_starts and loc == LOC_SPILL:
            if live.last < 0 or (live.nuse == 0 and v >= ir.nparams): vloc[v] = LOC_NONE
            else:
                live.next_start = v_start[live.first]
                v_start[live.first] = v
    if nl == 0: return
    loop v in [0..nv):
        if v_live[v].last < 0: continue
        f = if v < ir.nparams: -1 else: v_live[v].first
        # first loop starting after f
        lo = 0
        hi = nl
        loop lo < hi:
            mid = (lo + hi) / 2
            if loop_s[mid] <= f: lo = mid + 1
            else: hi = mid
        i = lo
        loop i < nl and loop_s[i] <= v_live[v].last:
            if ra_stat: ra_loop_visits += 1
            if loop_e[i] > v_live[v].last: v_live[v].last = loop_e[i]
            i += 1


# Frozen block and statement checker extracted from check.jo.
use 'node_store.dewy'
use 'source_types.dewy'
use 'checker_state.dewy'
use 'checker_types.dewy'
use 'type_inference.dewy'
use 'checker_vardecls.dewy'
use 'checker_assigns.dewy'
use 'checker_statements.dewy'
use 'checker_exprstmts.dewy'
use 'checker_loops.dewy'
use 'checker_for_loops.dewy'
use 'checker_returns.dewy'
use 'checker_conditionals.dewy'
use 'checker_literals.dewy'
use 'checker_expr.dewy'
struct CheckerBlockHost:
    open: (int, int) -> int
    expand: (int) -> void
    direct: (int) -> void
    final: (int, int, int, int) -> int
    sibling: (int, int, int) -> void
    close: (int, int) -> int
    reset: (int) -> void
    special: (int, int) -> void
    assign: (int) -> bool
    error: (int, int) -> void
    terminates: (int) -> bool
struct CheckerBlockInput:
    nodes: *(Node[])
    lists: *(i32[])
    files: *(SrcFile[])
    types: *(TypeInfo[])
    last: *int
    scopes: *CheckerScope
    context: *int
    watch: *StatementWatch
    sibling_block: *int
    sibling_index: *int
    flow_local: *int
    body_mode: *int
    arm_next: *int
    bind_next: *int
    discarding: *bool
    exact: *bool
    void_type: *int
    never_type: *int
    host: *CheckerBlockHost
bk_nodes: *(Node[])
bk_lists: *(i32[])
bk_files: *(SrcFile[])
bk_types: *(TypeInfo[])
bk_last: *int
bk_scopes: *CheckerScope
bk_context: *int
bk_watch: *StatementWatch
bk_sibling_block: *int
bk_sibling_index: *int
bk_flow_local: *int
bk_body_mode: *int
bk_arm_next: *int
bk_bind_next: *int
bk_discarding: *bool
bk_exact: *bool
bk_void_type: *int
bk_never_type: *int
bk_host: *CheckerBlockHost
checker_blocks_bind = (input: *CheckerBlockInput) -> int:
    bk_nodes = input[0].nodes
    bk_lists = input[0].lists
    bk_files = input[0].files
    bk_types = input[0].types
    bk_last = input[0].last
    bk_scopes = input[0].scopes
    bk_context = input[0].context
    bk_watch = input[0].watch
    bk_sibling_block = input[0].sibling_block
    bk_sibling_index = input[0].sibling_index
    bk_flow_local = input[0].flow_local
    bk_body_mode = input[0].body_mode
    bk_arm_next = input[0].arm_next
    bk_bind_next = input[0].bind_next
    bk_discarding = input[0].discarding
    bk_exact = input[0].exact
    bk_void_type = input[0].void_type
    bk_never_type = input[0].never_type
    bk_host = input[0].host
    0
bk_flag = (n: int, f: int) -> bool: int(bk_nodes[0][n].flags) & f != 0
bk_assign = (s: int):
    lhs = int(bk_nodes[0][s].a)
    op = bk_nodes[0][s].op
    lk = bk_nodes[0][lhs].kind
    if lk == .hole and op == 47:
        st_drop(s)
        return
    if op == 47 and (lk == .ident or lk == .tuple):
        if bk_host[0].assign(s):
            vd_decl(s)
            return
    else:
        b = int(bk_nodes[0][s].b)
        if bk_nodes[0][b].kind == .call and bk_nodes[0][b].aux2 == 17: bk_host[0].error(s, 3)
    r = va_assign(s)
    if r != s: bk_nodes[0][s] = bk_nodes[0][r]
bk_stmt = (s: int):
    k = bk_nodes[0][s].kind
    if bk_exact[0] and k == .assign and bk_nodes[0][s].op != 47 and bk_context[0] >= 0: bk_host[0].special(s, 1)
    if k == .vardecl and bk_nodes[0][s].aux2 == 1789:
        bk_host[0].special(s, 2)
        k = bk_nodes[0][s].kind
    if k == .reflect_scope:
        bk_host[0].special(s, 3)
        return
    if (k == .vardecl or k == .const_) and bk_flag(s, 128): return
    if k == .vardecl: vd_decl(s)
    else if k == .const_: st_const(s)
    else if k == .assign: bk_assign(s)
    else if k == .exprstmt: es_statement(s)
    else if k == .if_: bk_if(s)
    else if k == .iflet: bk_host[0].special(s, 4)
    else if k == .while_: xb_while(s)
    else if k == .for_: fl_for(s)
    else if k == .return_: xt_return(s)
    else if k == .break_ or k == .continue_: xb_jump(s)
    else if k == .defer_: st_defer(s)
    else if k == .when_: st_when(s)
    else if k == .block: bk_block(s, 0, false)
    else if k == .fn_ or k == .struct_ or k == .enum_ or k == .import_: bk_host[0].error(s, 1)
    else if k != .test_ and k != .build_: bk_host[0].error(s, 2)
bk_if = (s: int):
    f = int(bk_nodes[0][s].flags)
    if f & 128 != 0 and bk_nodes[0][s].type != 0:
        bk_host[0].special(s, 4)
        return
    bk_nodes[0][s].flags = i32(f | 16)
    xl_finish(s, xf_if(s, 0), 0)
    if bk_watch[0].expectations > 0: bk_host[0].special(s, 5)
bk_open = (b: int, want_value: bool) -> int:
    mode = -1
    if bk_body_mode[0] >= 0:
        mode = bk_body_mode[0]
        bk_body_mode[0] = -1
    else if bk_flag(b, 8): return bk_host[0].open(b, if want_value: -2 else: -1)
    else if want_value and bk_files[0][bk_nodes[0][b].pos >> 40].is_dewy:
        if bk_flag(b, 67108864): mode = 4
        else if bk_arm_next[0] == b: mode = 3
        else if bk_bind_next[0] == b: mode = 6
        else: mode = 1
    bk_arm_next[0] = 0
    bk_bind_next[0] = 0
    if mode >= 0:
        bk_host[0].open(b, mode)
        bk_discarding[0] = false
    mode
bk_final = (b: int, i: int, expected: int, mode: int) -> int:
    s = int(bk_lists[0][int(bk_nodes[0][b].list) + i])
    k = bk_nodes[0][s].kind
    if k == .if_ or k == .iflet: return bk_host[0].final(b, i, expected, mode)
    if k != .exprstmt: return -1
    e = int(bk_nodes[0][s].a)
    if bk_nodes[0][e].kind == .call and bk_nodes[0][e].aux2 == 17: return -1
    if mode == 2 or mode == 3 or mode == 6: return bk_host[0].final(b, i, expected, mode)
    if bk_nodes[0][e].kind == .match_: bk_nodes[0][e].flags = i32(int(bk_nodes[0][e].flags) & -17)
    result = check_expr(e, expected)
    bk_nodes[0][s].a = i32(bk_last[0])
    if bk_types[0][tu_prune(result)].kind != .void_: bk_nodes[0][b].aux = 1
    if result == bk_never_type[0]: bk_nodes[0][b].aux = 0
    bk_nodes[0][s].flags = i32(int(bk_nodes[0][s].flags) | 128)
    result
bk_finish = (b: int, result0: int, mode: int, n: int, want_value: bool) -> int:
    result = result0
    if want_value:
        if bk_nodes[0][b].aux == 0 and n > 0 and bk_host[0].terminates(int(bk_lists[0][int(bk_nodes[0][b].list) + n - 1])): result = bk_never_type[0]
        if bk_flag(b, 1073741824): result = bk_never_type[0]
        if result != 0 and int(bk_types[0][result].flags) & 1 != 0: result = tu_zonk(result)
    if mode >= 0: result = bk_host[0].close(b, result)
    result
bk_block = (b: int, expected: int, want_value: bool) -> int:
    pos = bk_nodes[0][b].pos
    if want_value and bk_flag(b, 131072) and bk_files[0][pos >> 40].is_dewy:
        bk_block(b, 0, false)
        result = if bk_flag(b, 1073741824): bk_never_type[0] else: bk_void_type[0]
        bk_nodes[0][b].type = i32(result)
        return result
    mode = -1
    was_discarding = bk_discarding[0]
    if want_value or bk_body_mode[0] >= 0 or bk_flag(b, 8): mode = bk_open(b, want_value)
    else:
        bk_arm_next[0] = 0
        bk_bind_next[0] = 0
    counted = mode == 2 or mode == 6
    transparent = bk_nodes[0][b].aux == 5 and not want_value
    n0 = int(bk_nodes[0][b].nlist)
    i = 0
    loop i < n0:
        if bk_nodes[0][int(bk_lists[0][int(bk_nodes[0][b].list) + i])].kind == .when_:
            bk_host[0].expand(b)
            break
        i = i + 1
    mark = bk_scopes[0].names.len()
    result = bk_void_type[0]
    bk_nodes[0][b].aux = 0
    n = int(bk_nodes[0][b].nlist)
    saved_block = bk_sibling_block[0]
    saved_index = bk_sibling_index[0]
    bk_sibling_block[0] = b
    i = 0
    loop i < n:
        s = int(bk_lists[0][int(bk_nodes[0][b].list) + i])
        bk_sibling_index[0] = i
        if counted: bk_host[0].direct(s)
        value = -1
        if i == n - 1 and want_value: value = bk_final(b, i, expected, mode)
        if value >= 0: result = value
        else:
            if bk_watch[0].sibling_flow > 0: bk_host[0].sibling(s, 0, 1)
            if bk_watch[0].sibling_known > 0: bk_host[0].sibling(s, b, 2)
            else: bk_stmt(s)
            l = bk_flow_local[0]
            if l != 0:
                bk_host[0].sibling(l, bk_nodes[0][s].pos, 3)
                bk_flow_local[0] = 0
        i = i + 1
    if bk_watch[0].sibling_flow > 0: bk_host[0].sibling(b, 0, 4)
    bk_sibling_block[0] = saved_block
    bk_sibling_index[0] = saved_index
    if want_value or mode >= 0: result = bk_finish(b, result, mode, n, want_value)
    if mode >= 0: bk_discarding[0] = was_discarding
    bk_nodes[0][b].type = i32(result)
    if transparent: bk_nodes[0][b].aux = 5
    else if bk_scopes[0].names.len() != mark: bk_host[0].reset(mark)
    result

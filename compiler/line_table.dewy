$runtime_checks

# Source positions to lines and columns: each file's line starts, made the first time
# one of its positions is asked about, and the line found last (positions often come
# one after another on a line).
#
# A module of the compiler written in Dewy. line_table.jo is its frozen twin for the
# compilers without the Dewy frontend (tools/compiler/build.py); the two keep the same
# interface and give the same answers (tests/test_selfhost_line_table.py). The table is
# the caller's (util.jo keeps one for the compiler's files) and comes in by place.

# (no defaults: all zero is the empty table, so a global of it needs no initializer
# running in module order, after another module's initializer may have used it)
LineTable:type=[
    starts:array<array<int64>>   # by file: the offset of each line's first byte
    file:int64                   # the line found last: its file, its first offset,
    start:int64                  # the offset past it (0 before any) and its number
    stop:int64
    line:int64
]

# Offsets, counts and line numbers are words (they cannot overflow).
LineWord:type=int64<overflow='wrap'>
LineU64:type=uint64<overflow='wrap'>

# where each line of src starts: 0, then the offset after each newline. Scans 8 bytes per
# step with SWAR word arithmetic, checking exact newline bytes only on hit words; O(bytes).
line_starts=(src:string):>array<int64>=>$unsafe {
    let n=LineWord((src as array<uint8>).length)
    let ls:array<int64>=[]
    let lcap=LineWord((n >> 5) + 16)
    ls.reserve(int64(lcap))
    __set_len(ls int64(lcap))
    let lp=ls.ptr
    lp[0]=0
    let lcnt:LineWord=1
    # (the pointer of a view, not of a variable: a variable's would be its own copy)
    let sp=(src as array<uint8>).ptr
    let i:LineWord=0
    let nl_rep=LineU64(0x0A0A0A0A0A0A0A0A)
    let lo_bits=LineU64(0x0101010101010101)
    let hi_bits=LineU64(0x8080808080808080)
    let all_ones=LineU64(0xFFFFFFFFFFFFFFFF)
    let n8=n - 8
    loop i <=? n8 {
        let w=((sp + i) as ptr<LineU64>)[0]
        let x=w xor nl_rep
        let m=(x - lo_bits) & (x xor all_ones) & hi_bits
        if m not=? LineU64(0) {
            if lcnt + 8 >? lcap {
                lcap=lcap * 2
                ls.reserve(int64(lcap))
                __set_len(ls int64(lcap))
                lp=ls.ptr
            }
            let b=i
            let ww=w
            if (m & LineU64(0xFFFFFFFF)) =? LineU64(0) {
                m >>= LineU64(32)
                ww >>= LineU64(32)
                b += 4
            }
            loop m not=? LineU64(0) {
                if (ww & LineU64(0xFF)) =? LineU64(10) {
                    lp[lcnt]=int64(b + 1)
                    lcnt += 1
                }
                m >>= LineU64(8)
                ww >>= LineU64(8)
                b += 1
            }
        }
        i += 8
    }
    if i <? n {
        if lcnt + 8 >? lcap {
            lcap=lcap * 2
            ls.reserve(int64(lcap))
            __set_len(ls int64(lcap))
            lp=ls.ptr
        }
        loop i <? n {
            if sp[i] =? uint8(10) {
                lp[lcnt]=int64(i + 1)
                lcnt += 1
            }
            i += 1
        }
    }
    __set_len(ls int64(lcnt))
    ls
}

# the line and column (from 1) of byte off of file f, whose text is src
line_col_in=(@t:LineTable f:int64 off:int64 src:string):>[int64 int64]=>{
    if f =? t.file and off >=? t.start and off <? t.stop {return [t.line int64(LineWord(off) - LineWord(t.start) + 1)]}
    $runtime_assert f >=? 0
    let known:array<int64>=if f <? t.starts.length t.starts[f] else []
    let ls=if known.length >? 0 known else line_starts(src)
    loop t.starts.length <=? f {t.starts.push([])}
    t.starts[f]=ls
    # (line_starts begins every table with 0)
    $runtime_assert ls.length >? 0
    let lo:LineWord=0
    let hi=LineWord(ls.length) - 1
    loop lo <? hi {
        let mid=(lo + hi + 1) // 2
        $runtime_assert lo <? mid and mid <=? hi
        if ls[mid] <=? off {lo=mid} else {hi=mid - 1}
    }
    $runtime_assert 0 <=? lo and lo <? ls.length
    t.file=f
    t.start=ls[lo]
    t.stop=if lo + 1 <? LineWord(ls.length) ls[lo + 1] else 1 << 62
    t.line=int64(lo + 1)
    [int64(lo + 1) int64(LineWord(off) - LineWord(ls[lo]) + 1)]
}

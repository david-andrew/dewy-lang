$runtime_checks

# Source positions to lines and columns: each file's line starts, made the first time
# one of its positions is asked about, and the line found last (positions often come
# one after another on a line).
#
# A module of the compiler written in Dewy. line_table.jo is its frozen twin for the
# compilers without the Dewy frontend (tools/compiler/build.py); the two keep the same
# interface and give the same answers (tests/test_selfhost_line_table.py). The table is
# the caller's (util.jo keeps one for the compiler's files) and comes in by place.

# (no defaults: all zero is the empty table, so a global of it needs no initializer
# running in module order, after another module's initializer may have used it)
LineTable:type=[
    starts:array<array<int64>>   # by file: the offset of each line's first byte
    file:int64                   # the line found last: its file, its first offset,
    start:int64                  # the offset past it (0 before any) and its number
    stop:int64
    line:int64
]

# Offsets, counts and line numbers are words (they cannot overflow).
LineWord:type=int64<overflow='wrap'>
LineU64:type=uint64<overflow='wrap'>

line_starts_grow_impl=(@ls:array<int64> lcap:LineWord):>LineWord=>$unsafe {
    let nc=lcap * 2
    ls.reserve(int64(nc))
    __set_len(ls int64(nc))
    nc
}
let line_starts_grow_hook:<(@ls:array<int64> lcap:LineWord):>LineWord>=@line_starts_grow_impl
line_starts_grow=(@ls:array<int64> lcap:LineWord):>LineWord=>$unsafe {
    let nc=lcap * 2
    ls.reserve(int64(nc))
    __set_len(ls int64(nc))
    if lcap <? 0 {return line_starts_grow_hook(@ls lcap)}
    nc
}

# where each line of src starts: 0, then the offset after each newline. Scans with
# hardware-accelerated __find_newline (AVX2 on x86-64); O(bytes).
line_starts=(src:string):>array<int64>=>$unsafe {
    let n=LineWord((src as array<uint8>).length)
    let ls:array<int64>=[]
    let lcap=LineWord((n >> 4) + 32)
    ls.reserve(int64(lcap))
    __set_len(ls int64(lcap))
    let lp=ls.ptr
    lp[0]=0
    let lcnt:LineWord=1
    # (the pointer of a view, not of a variable: a variable's would be its own copy)
    let sp=(src as array<uint8>).ptr
    let i:LineWord=0
    loop i <? n {
        let j=LineWord(__find_newline(sp int64(i) int64(n)))
        if j >=? n {break}
        if lcnt >=? lcap {
            lcap=line_starts_grow(@ls lcap)
            lp=ls.ptr
        }
        lp[lcnt]=int64(j + 1)
        lcnt += 1
        i=j + 1
    }
    __set_len(ls int64(lcnt))
    ls
}

# the line and column (from 1) of byte off of file f, whose text is src
line_col_in=(@t:LineTable f:int64 off:int64 src:string):>[int64 int64]=>$unsafe {
    if f =? t.file and off >=? t.start and off <? t.stop {return [t.line int64(LineWord(off) - LineWord(t.start) + 1)]}
    $runtime_assert f >=? 0
    if f >=? t.starts.length {
        loop t.starts.length <=? f {t.starts.push([])}
    }
    if t.starts.ptr[f].length =? 0 {
        t.starts[f]=line_starts(src)
    }
    let ls_len=LineWord(t.starts.ptr[f].length)
    let lp=t.starts.ptr[f].ptr
    # (line_starts begins every table with 0)
    $runtime_assert ls_len >? 0
    let lo:LineWord=0
    if f =? t.file and off >=? t.stop and t.line >? 0 and LineWord(t.line) <? ls_len {
        let next_idx=LineWord(t.line)
        let next_stop:LineWord=if next_idx + 1 <? ls_len {LineWord(lp[next_idx + 1])} else {1 << 62}
        if off <? next_stop {
            lo=next_idx
            t.start=lp[lo]
            t.stop=int64(next_stop)
            t.line=int64(lo + 1)
            return [t.line int64(LineWord(off) - LineWord(t.start) + 1)]
        }
    }
    let hi=ls_len - 1
    loop lo <? hi {
        let mid=(lo + hi + 1) >> 1
        if lp[mid] <=? off {lo=mid} else {hi=mid - 1}
    }
    t.file=f
    t.start=lp[lo]
    t.stop=if lo + 1 <? ls_len {lp[lo + 1]} else {1 << 62}
    t.line=int64(lo + 1)
    [int64(lo + 1) int64(LineWord(off) - LineWord(lp[lo]) + 1)]
}

use 'util.jo'
use 'source_types.dewy'
use 'dewy_fmt.jo'
use 'fmt.jo'

fmt_lexes = (path: str, src: str) -> str[]?:
    saved = df_file()
    files.push(SrcFile(path, ".", src, ends_with(path, ".dewy")))
    tokens = fmt_try_tokens(files.len() - 1, src)
    if tokens == none: df_file(saved)
    files.pop()
    tokens

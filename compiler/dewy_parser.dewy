$runtime_checks
from p"dewy_reader_host.dewy" import ParserReaderStores
from p"dewy_reader_state.dewy" import ParserReaderState
from p"dewy_tokens.dewy" import DewyLexeme

# State owned by the Dewy reader, lent by its Jo driver. Fields have no initializers:
# the driver's zero-initialized global has no module-order dependency. The reader
# owns token edits, lazy-body tables and grammar state through this context.
# report_now: mistakes may be flushed immediately; unread_here: a function body
# owns unread forms; fn_body: parsing a function body; comma_stop: an assertion's
# condition stops at the top-level comma before its message.
ParserFlags:type=[report_now:bool unread_here:bool fn_body:bool comma_stop:bool]
# A failed reading restores report_pos and reports only: report_text stays valid
# because the first report alone writes it. Hints reset at statement entry.
ParserStatus:type=[report_pos:int64 report_text:string reports:int64 hint_pos:int64 hint_text:string]
# Collection bookkeeping survives speculative reader rollback exactly as before.
ParserCollection:type=[mixed:bool mixed_pos:int64 pairs_collected:int64 tagged_last:dict<int64 bool>]
# Member resolution snapshots scope per block/function and retains deferred names.
# inherited caches the first interned $inherited id; clear it if the name store resets.
ParserReach:type=[
    scope:dict<int64 int64>
    waiting:array<int64> waiting_names:array<int64> waiting_callees:array<int64>
    used:dict<int64 bool> captures:dict<int64 array<int64>> inherited:int64
]
ParserContext:type=[tokens:array<DewyLexeme> at:int64 file:int64 depth:int64 flags:ParserFlags status:ParserStatus classes:array<uint8> collection:ParserCollection reach:ParserReach reader:ParserReaderState source:string stores:ParserReaderStores]

# O(1) on a cached name, O(18) on a miss; cache growth is amortized O(names).
dc_parser_word=(@p:ParserContext @texts:array<string> id:int64):>int64=>{
    if id <? p.classes.length and p.classes[id] not=? 0 {return int64(p.classes[id]) - 1}
    if p.classes.length <? texts.length {p.classes.extend(fill(uint8(0) texts.length + 256 - p.classes.length))}
    let name=texts[id]
    let words:array<string>=["set" "b" "main" "_" "array" "ptr" "dict" "totaldict" "addr" "no_effects" "reads" "mutates" "allocates" "blocks" "panics" "length" "overflow" "p"]
    let c:int64=0
    loop k in [0..words.length) {if name =? words[k] {c=k + 1}}
    if id <? p.classes.length {p.classes[id]=uint8(c + 1)}
    c
}

# O(1), with no allocation on paths that retain an earlier diagnostic.
dc_parser_report=(@status:ParserStatus pos:int64 message:string)=>{
    status.reports+=1
    if status.report_pos =? 0 {
        status.report_pos=pos
        status.report_text=message
    }
}

dc_parser_hint=(@status:ParserStatus pos:int64 message:string):>int64=>{
    if status.hint_pos =? 0 {
        status.hint_pos=pos
        status.hint_text=message
    }
    0
}

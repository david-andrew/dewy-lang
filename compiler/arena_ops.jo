use 'checker_state.dewy'
# Frozen recursive lowering from arena.jo.
use 'arena.jo'
use 'lower.jo'
use 'effect_types.dewy'
use 'effects.jo'
use 'expr.jo'
use 'check.jo'
use 'ast.jo'
use 'node_store.dewy'
use 'lower_storage.dewy'
use 'ir.jo'
use 'directives.jo'
use 'ir_builders.dewy'
use 'util.jo'
use 'lower_helpers.dewy'
use 'types.jo'
use 'lower_group.dewy'
use 'isolation.jo'
use 'lower_primitives.dewy'
use 'math_lower.jo'
use 'ownership.jo'
use 'ownership_types.dewy'
use 'places.jo'
use 'units.jo'
use 'math_ops.dewy'
use 'effect_control.dewy'

runtime_switch_on = (name: str):
    if not runtime_switches.contains(name): runtime_switches.push(name)


runtime_switch = ():
    loop name in runtime_switches:
        id = intern(name)
        demand_name(id)
        s = prelude.get(id) ?? 0
        if s == 0 or syms[s].kind != .const_: ice("missing runtime constant {name}")
        value = int(nodes[int(syms[s].decl)].b)
        if nodes[value].kind != .bool_lit: ice("runtime constant {name} is not a literal")
        nodes[value].ival = 1


arena_enable = ():
    runtime_switch_on("__ARENAS")
    if not release_build: runtime_switch_on("__ARENA_POISON")


arena_reset = ():
    arena_fns = {}
    arena_runtime_ready = false
    runtime_switches = []
    arena_proofs_done = false
    arena_proven = {}
    arena_proven_machinery = {}
    arena_unproven = {}
    arena_lambda_depth = 0


arena_unpromotable = (t0: int, depth: int = 0) -> str:
    t = quantity_base(t0)
    if depth > 32 or not is_managed(t) and tkind(t) != .ptr: return ""
    if ownership_type(t): return "a resource owner ({type_str(t)})"
    k = types[t].kind
    if k == .fn_ or k == .polyfn or k == .callable: return "a function value ({type_str(t)})"
    if k == .ptr: return "a raw pointer ({type_str(t)})"
    if k == .array or k == .box or k == .opt or k == .fixed: return arena_unpromotable(int(types[t].elem), depth + 1)
    if k == .struct_ or k == .tuple:
        loop field in field_list(t):
            why = arena_unpromotable(field.0, depth + 1)
            if why != "": return why
    if k == .enum_:
        layout(t)
        si = int(types[t].st)
        loop v in [0..int(structs[si].nvariants)):
            vi = int(structs[si].variants) + v
            loop i in [0..int(variants[vi].nfields)):
                why = arena_unpromotable(field_store_type(int(variants[vi].fields) + i), depth + 1)
                if why != "": return why
    ""


arena_no_return = (n: int):
    at = arena_return_at(n)
    if at != 0: fatal(nodes[at].pos, "`return` inside an `$allocator` expression would leave it before its value is copied out of the arena: make the value the expression's result, and return after it")


arena_return_at = (n: int) -> int:
    if n == 0: return 0
    k = nodes[n].kind
    if k == .lambda or k == .fn_: return 0
    if k == .return_: return n
    mask = isolation_children(k)
    if mask < 0: return 0
    if mask & 1 != 0:
        at = arena_return_at(int(nodes[n].a))
        if at != 0: return at
    if mask & 2 != 0:
        at = arena_return_at(int(nodes[n].b))
        if at != 0: return at
    if mask & 4 != 0:
        at = arena_return_at(int(nodes[n].c))
        if at != 0: return at
    if mask & 16 != 0:
        loop child in kids(n):
            at = arena_return_at(child)
            if at != 0: return at
    0


arena_check_result = (n: int, value: int, t: int, asked: bool) -> int:
    why = arena_unpromotable(t)
    if why != "": fatal(nodes[n].pos, "the value of an `$allocator` expression is copied out of its arena, and {why} cannot be copied yet: give plain data (records, arrays, strings, numbers) as its value, and make the closure or owner after the expression")
    if not asked and is_managed(t) and dir_explicit_copies(nodes[n].pos):
        fatal(nodes[n].pos, "under `$explicit_copies`, the value of an `$allocator` expression is copied out of its arena: end the expression with `.copy()` to ask for the copy")
    if not arena_runtime_ready:
        arena_runtime_ready = true
        loop name in ["__arena_promote_arr", "__arena_promote_str", "__box_new"]:
            runtime_fn(name)
    arena_fns[if cx >= 0: int(ctxs[cx].inst) else: 0] = true
    nodes[n] = Node(kind = .conv, pos = nodes[n].pos, a = i32(value), aux = i32(int(CV.promote)), type = i32(t), flags = i32(NF_CHECKED))
    last_checked = n
    t


arena_gen_promote = (e: int) -> Val:
    a = int(nodes[e].a)
    t = prune(ntype(e))
    value = gen_expr(a)
    if not is_managed(t): return value
    slot = new_temp(t)
    addr = e_slot(slot)
    if vc(t) == VC_AGG: e_copy(addr, value.v, tsize(t))
    else: store_val(t, addr, 0, value.v)
    e_call1(lf_helper(.promote, t, 0), addr, -1)
    borrow(value, t)
    if vc(t) == VC_AGG: return Val(addr, true, slot)
    V(load_val(t, addr, 0), true)


arena_promote_at = (addr: int, t0: int):
    t = quantity_base(t0)
    if is_managed(t): e_call1(lf_helper(.promote, t, 0), addr, -1)


arena_promote_buffer = (a: int, t: int):
    k = types[t].kind
    p = e_load(VI, a, 0, ptr_size)
    if k == .str_:
        e_store(a, 0, e_call1(rt("__arena_promote_str"), p, VI), ptr_size)
        return
    et = int(types[t].elem)
    stride = owner_stride(et)
    q = e_call2(rt("__arena_promote_arr"), p, e_iconst(stride), VI)
    e_store(a, 0, q, ptr_size)
    if not is_managed(et): return
    # (static data, not copied, holds static data only: its elements stay too)
    iff(e_bin(.ne, VI, q, p))
    n = hdr_load(q, 8)
    i = vreg(VI)
    e_mov(i, e_iconst(0))
    blk()
    lop()
    brif_to(e_bin(.ges, VI, i, n), ctl - 1)
    arena_promote_at(e_bin(.add, VI, e_addi(q, 24), e_bin(.mul, VI, i, e_iconst(stride))), et)
    e_mov(i, e_addi(i, 1))
    br_to(ctl)
    endc()
    endc()
    endc()


helper_promote = (t: int):
    ps = helper_params(1)
    a = ps[0]
    k = types[t].kind
    if types[t].rep == .tagged_int or math_optional(t):
        # (an arbitrary-precision integer: a word, or a tagged pointer to its digits)
        v = e_load(VI, a, 0, 8)
        if math_optional(t): v = e_bin(.xor, VI, v, e_iconst(1))
        iff(e_bin(.and_, VI, math_tag(v), e_bin(.ne, VI, v, e_iconst(1))))
        digits = e_slot(new_temp(math_payload_type()))
        e_store(digits, 0, e_addi(v, -1), 8)
        arena_promote_buffer(digits, math_payload_type())
        w = e_addi(e_load(VI, digits, 0, 8), 1)
        if math_optional(t): w = e_bin(.xor, VI, w, e_iconst(1))
        e_store(a, 0, w, 8)
        endc()
    else if k == .str_ or k == .array:
        arena_promote_buffer(a, t)
    else if k == .box:
        et = int(types[t].elem)
        p = e_load(VI, a, 0, ptr_size)
        iff(e_bin(.ne, VI, p, e_iconst(0)))
        q = e_call1(rt("__box_new"), e_iconst(tsize(et)), VI)
        e_copy(e_addi(q, BOX_HDR), e_addi(p, BOX_HDR), tsize(et))
        arena_promote_at(e_addi(q, BOX_HDR), et)
        e_store(a, 0, q, ptr_size)
        endc()
    else if k == .opt:
        inner = int(types[t].elem)
        iff(e_bin(.ne, VI, opt_has(a, inner), e_iconst(0)))
        arena_promote_at(a, inner)
        endc()
    else if k == .enum_:
        si = int(types[t].st)
        layout(t)
        tag = e_load(VI, a, 0, 4)
        loop v in [0..int(structs[si].nvariants)):
            vi = int(structs[si].variants) + v
            any = false
            loop i in [0..int(variants[vi].nfields)):
                if is_managed(field_store_type(int(variants[vi].fields) + i)): any = true
            if not any: continue
            iff(e_bin(.eq, VI, tag, e_iconst(v)))
            loop i in [0..int(variants[vi].nfields)):
                f = int(variants[vi].fields) + i
                arena_promote_at(e_addi(a, int(fields[f].offset)), field_store_type(f))
            endc()
    else if k == .fixed:
        et = int(types[t].elem)
        if is_managed(et):
            i = fixed_loop_begin(t)
            arena_promote_at(fixed_elem_addr(a, i, et), et)
            fixed_loop_end(i)
    else if k == .struct_ or k == .tuple:
        loop field in field_list(t): arena_promote_at(e_addi(a, field.1), field.0)
    else: ice("promotion of {type_str(t)} out of an allocator scope")
    e_ret(-1)


arena_error = (n: int, reason: str):
    fatal(nodes[n].pos, "`$allocator`: {reason}")


arena_scope_start = (b: int) -> int:
    if nkids(b) != 4: return 0
    d = kid(b, 0)
    if nodes[d].kind != .vardecl: return 0
    c = int(nodes[d].b)
    if c == 0 or nodes[c].kind != .call or nodes[c].aux != 0 or nodes[c].sym <= 0: return 0
    if int(fns[int(nodes[c].sym)].decl) != arena_enter_decl: return 0
    d


arena_root = (e0: int) -> ArenaRoot:
    e = e0
    buffer = false
    loop depth in [0..64):
        k = nodes[e].kind
        if k == .addr or k == .unwrap or k == .narrow or k == .field:
            e = int(nodes[e].a)
            continue
        if k == .index:
            buffer = true
            e = int(nodes[e].a)
            continue
        if k == .ident:
            p = place_scalar_root(e)
            if p.root == .local and p.declaration > 0:
                l = p.declaration
                inside = arena_stack.len() > 0 and l > arena_stack[arena_stack.len() - 1].context
                # (a loop's `mut` element stands for an element of another place)
                if int(locals[l].flags) & (LF_ELEMALIAS | LF_SOAELEM | LF_BYREF | LF_CAPTURE | LF_PARAM) != 0:
                    inside = false
                    buffer = true
                return ArenaRoot(l, not inside, buffer, name_of(int(locals[l].name)))
            if p.root == .global and p.declaration > 0: return ArenaRoot(0, true, buffer, name_of(int(globals[p.declaration].name)))
        break
    ArenaRoot(0, true, true)


arena_handle = (t0: int) -> bool:
    t = prune(t0)
    if tkind(t) != .struct_: return false
    si = int(types[t].st)
    d = int(structs[si].decl)
    structs[si].name == "Arena" and d != 0 and files[pos_file(nodes[d].pos)].path == lib_dir + "/std/arena.jo"


arena_store = (n: int, e: int, t: int):
    r = arena_root(e)
    if not r.outside: return
    loop scope in arena_stack:
        if r.local != 0 and scope.arena == r.local: arena_lent(n, r.local)
    if not r.buffer and (not is_managed(t) or arena_handle(t)): return
    what = if r.name != "": "`{r.name}`" else: "a place"
    arena_error(n, "this changes {what}, declared outside the expression, and could leave storage of the arena in it, which its reset would invalidate: make the change after the expression, from its value")


arena_lent = (n: int, l: int):
    arena_error(n, "`{name_of(int(locals[l].name))}` is lent to the expression: it cannot be used, reset or lent again inside it")


arena_mention = (n: int):
    if nodes[n].aux != i32(int(SK.local)): return
    l = int(nodes[n].sym)
    loop scope in arena_stack:
        if scope.arena == l: arena_lent(n, l)


arena_mutators = (id: IN) -> bool:
    id == .push or id == .pop or id == .insert or id == .remove or id == .clear or id == .reserve or id == .resize or id == .truncate or id == .extend or id == .setlen or id == .fill or id == .lend


arena_trusted = (n: int) -> bool: pos_in_lib(nodes[n].pos)


arena_keep_scan = (f: int, n: int, callees: mut int[]) -> int:
    if n == 0: return 0
    k = nodes[n].kind
    if k == .lambda: return 0
    bad = 0
    if k == .assign: bad = arena_keep_store(f, int(nodes[n].a), n)
    else if k == .intrinsic:
        id = nodes[n].aux as IN
        if arena_mutators(id) and nkids(n) > 0: bad = arena_keep_store(f, kid(n, 0), n)
        # (work started elsewhere could still hold the expression's storage after it ends)
        else if id == .clone_thread or id == .task_report or id == .task_data: bad = n
        else if (id == .setjmp or id == .longjmp or id == .jump or id == .callc or id == .wasm_call or id == .compute or id == .compute_spirv or id == .compute_textures or id == .gpu_kernel or id == .memcpy or id == .memset or id == .syscall) and not arena_trusted(n): bad = n
    else if k == .call:
        aux = int(nodes[n].aux)
        if aux == 0 and nodes[n].sym > 0:
            g = int(nodes[n].sym)
            d = int(fns[g].decl)
            if d == 0 or has_flag(d, NF_EXTERN) or fns[g].cabi:
                if not arena_trusted(n): bad = n
            else: callees.push(g)
        else if aux == 1:
            callee = int(nodes[n].a)
            formal = false
            if nodes[callee].kind == .ident and nodes[callee].aux == i32(int(SK.local)):
                # (a Dewy parameter's own binding is the parameter until something writes it)
                fl = int(locals[int(nodes[callee].sym)].flags)
                formal = fl & LF_PARAM != 0 or fl & (LF_VALUEPARAM | LF_ASSIGNED) == LF_VALUEPARAM
            if not formal: bad = n
    else if (k == .index or k == .field) and tkind(ntype(int(nodes[n].a))) == .ptr and not arena_trusted(n): bad = n
    if bad != 0: return bad
    mask = isolation_children(k)
    if mask < 0: return if arena_trusted(n): 0 else: n
    if mask & 1 != 0: bad = arena_keep_scan(f, int(nodes[n].a), callees)
    if bad == 0 and mask & 2 != 0: bad = arena_keep_scan(f, int(nodes[n].b), callees)
    if bad == 0 and mask & 4 != 0: bad = arena_keep_scan(f, int(nodes[n].c), callees)
    if bad == 0 and mask & 16 != 0:
        loop child in kids(n):
            bad = arena_keep_scan(f, child, callees)
            if bad != 0: break
    bad


arena_keep_store = (f: int, e0: int, n: int) -> int:
    e = e0
    buffer = false
    loop depth in [0..64):
        k = nodes[e].kind
        if k == .addr or k == .unwrap or k == .narrow or k == .field:
            if k == .field and tkind(ntype(int(nodes[e].a))) == .ptr: return if arena_trusted(n): 0 else: n
            e = int(nodes[e].a)
            continue
        if k == .index:
            if tkind(ntype(int(nodes[e].a))) == .ptr: return if arena_trusted(n): 0 else: n
            buffer = true
            e = int(nodes[e].a)
            continue
        break
    if nodes[e].kind != .ident: return n
    if nodes[e].aux == i32(int(SK.global)):
        g = int(nodes[e].sym)
        if buffer or is_managed(int(globals[g].type)): return n
        return 0
    if nodes[e].aux != i32(int(SK.local)): return n
    l = int(nodes[e].sym)
    flags = int(locals[l].flags)
    if flags & LF_CAPTURE != 0 and flags & LF_VALUECAP == 0: return n
    if flags & (LF_ELEMALIAS | LF_SOAELEM | LF_BYREF | LF_ALIAS) != 0:
        a = int(locals[l].alias)
        if a == 0: return n
        return arena_keep_store(f, a, n)
    0


arena_keeps = (f: int, depth: int = 0) -> int:
    state = arena_keep_state.get(f) ?? 0
    if state == 2: return 0
    if state == 3: return arena_keep_witness[f]
    if let at = arena_keep_depth.get(f):
        arena_keep_low = min(arena_keep_low, at)
        return 0
    if fns[f].body == 0 or fns[f].state != 2:
        arena_keep_state[f] = 3
        arena_keep_witness[f] = int(fns[f].decl)
        return int(fns[f].decl)
    arena_keep_depth[f] = depth
    saved_low = arena_keep_low
    arena_keep_low = depth
    callees: int[]
    bad = arena_keep_scan(f, int(fns[f].body), callees)
    loop g in callees:
        if bad != 0: break
        if arena_keeps(g, depth + 1) != 0: bad = arena_keep_call_site(f, g)
    arena_keep_depth.remove(f)
    if bad != 0:
        arena_keep_state[f] = 3
        arena_keep_witness[f] = bad
    else if arena_keep_low >= depth: arena_keep_state[f] = 2
    arena_keep_low = min(saved_low, arena_keep_low)
    bad


arena_keep_call_site = (f: int, g: int) -> int:
    w = arena_keep_witness.get(g) ?? int(fns[g].decl)
    if w == 0: w = int(fns[f].decl)
    w


arena_summary = (n: int, f: int):
    w = arena_keeps(f)
    if w == 0: return
    where = if w > 0 and w < nodes.len(): " (at {pos_str(nodes[w].pos)})" else: ""
    arena_error(n, "`{effect_name(f)}` may keep storage of the arena where the expression's reset cannot see it{where}")


arena_call = (n: int):
    aux = int(nodes[n].aux)
    if aux == 2 or aux == 3: return
    if aux == 1:
        # (a function value held by a local of the expression was made in it, its body
        # checked with it: function values from outside it are rejected where they are read)
        callee = int(nodes[n].a)
        if nodes[callee].kind == .ident and not arena_root(callee).outside: return
    if aux != 0 or nodes[n].sym <= 0: arena_error(n, "a call through a function value made outside the expression has no checked summary of what it keeps")
    f = int(nodes[n].sym)
    # (an `@place` argument: the callee may write it, as the expression would)
    loop i in [0..nkids(n)):
        arg = kid(n, i)
        if i < fns[f].params.len() and int(locals[fns[f].params[i]].flags) & LF_MUTPARAM != 0: arena_store(arg, arg, ntype(arg))
    if type_has_fn(ntype(n)): arena_error(n, "a function value made by `{effect_name(f)}` has no checked summary of what it keeps")
    arena_summary(n, f)


arena_function_value = (n: int):
    k = nodes[n].kind
    if k == .lambda:
        f = int(nodes[n].sym)
        if has_flag(n, NF_GENERIC) or f <= 0: arena_error(n, "a generic function value is not checked inside an allocator expression yet")
        loop cap in fns[f].caps:
            if int(locals[int(cap.inner)].flags) & LF_VALUECAP == 0: arena_error(n, "a closure that changes `{name_of(int(locals[int(cap.inner)].name))}` could leave storage of the arena in it: change it after the expression")
        arena_lambda_depth += 1
        arena_visit(int(fns[f].body))
        arena_lambda_depth -= 1
        return
    if k == .fnref and nodes[n].aux == 0 and nodes[n].sym > 0:
        arena_summary(n, int(nodes[n].sym))
        return
    arena_error(n, "a function value made outside the expression has no checked summary of what it keeps")


arena_visit = (n: int):
    if n == 0: return
    k = nodes[n].kind
    active = arena_stack.len() > 0
    if k == .lambda:
        if active: arena_function_value(n)
        return
    if k == .block:
        d = arena_scope_start(n)
        if d != 0:
            arena_scope(n, d)
            return
    if active:
        if k == .ident:
            arena_mention(n)
            if type_has_fn(ntype(n)) and arena_root(n).outside: arena_error(n, "a function value made outside the expression has no checked summary of what it keeps")
        else if k == .fnref or k == .partial: arena_function_value(n)
        else if arena_lambda_depth > 0 and (k == .return_ or k == .break_ or k == .continue_): pass
        else if k == .return_: arena_error(n, "`return` would leave the expression before its value is copied out: give the value as the expression's result")
        else if k == .break_ or k == .continue_:
            if int(nodes[n].ival) >= arena_stack[arena_stack.len() - 1].loops: arena_error(n, "this leaves the expression before its value is copied out: end the loop outside it")
        else if k == .assign: arena_store(n, int(nodes[n].a), ntype(int(nodes[n].a)))
        else if k == .intrinsic:
            id = nodes[n].aux as IN
            if arena_mutators(id) and nkids(n) > 0: arena_store(n, kid(n, 0), ntype(kid(n, 0)))
            if id == .setjmp or id == .longjmp or id == .jump or id == .clone_thread or id == .task_report or id == .task_data:
                arena_error(n, "this intrinsic leaves the expression's control or thread")
        else if k == .call: arena_call(n)
    looping = k == .while_ or k == .for_
    if active and looping: arena_stack[arena_stack.len() - 1].loops += 1
    mask = isolation_children(k)
    if mask < 0:
        if active: arena_error(n, "this construct is not checked inside an allocator expression yet")
        return
    if mask & 1 != 0: arena_visit(int(nodes[n].a))
    if mask & 2 != 0: arena_visit(int(nodes[n].b))
    if mask & 4 != 0: arena_visit(int(nodes[n].c))
    if mask & 16 != 0:
        loop child in kids(n): arena_visit(child)
    if active and looping: arena_stack[arena_stack.len() - 1].loops -= 1


arena_scope = (b: int, d: int):
    enter = int(nodes[d].b)
    place = kid(enter, 0)
    arena_visit(place)
    lent = arena_root(place)
    loop scope in arena_stack:
        if lent.local != 0 and scope.arena == lent.local: arena_error(place, "this arena is already lent to an enclosing `$allocator` expression")
    arena_stack.push(ArenaScope(int(nodes[d].sym), lent.local, 0))
    arena_visit(kid(b, 1))
    arena_stack.pop()
    arena_visit(kid(b, 2))
    arena_visit(kid(b, 3))


arena_finalize = ():
    if arena_fns.len() == 0: return
    arena_enter_decl = int(fns[runtime_fn("__arena_enter")].decl)
    arena_keep_state = {}
    arena_keep_witness = {}
    arena_keep_depth = {}
    loop f, _ in arena_fns:
        arena_stack = []
        arena_visit(int(fns[f].body))


arena_capacity_exempt = (event: EffectEvent) -> bool:
    if not arena_proofs_done:
        arena_proofs_done = true
        arena_prove_all()
    # (`arena(bytes)` acquires capacity explicitly: its refusal is its result, OutOfMemory)
    if event.via != 0:
        if event.via_fn > 0 and arena_acquisition(event.via_fn): return true
        return arena_proven.has(event.via)
    if event.atom.kind == .alloc: return arena_proven.has(event.witness)
    (event.atom.kind == .opaque or event.atom.kind == .remainder) and arena_proven_machinery.has(event.witness)


arena_acquisition = (g: int) -> bool:
    d = int(fns[g].decl)
    d != 0 and name_of(int(nodes[d].name)) == "arena" and files[pos_file(nodes[d].pos)].path == lib_dir + "/std/arena.jo"


arena_prove_all = ():
    arena_enter_decl = int(fns[runtime_fn("__arena_enter")].decl)
    loop f, _ in arena_fns:
        if f > 0 and f < fns.len() and fns[f].state == 2: arena_prove_in(f, int(fns[f].body), int(fns[f].body))


arena_prove_in = (f: int, body: int, n: int):
    if n == 0: return
    k = nodes[n].kind
    if k == .lambda: return
    if k == .block and arena_scope_start(n) != 0:
        arena_prove_scope(body, n)
    mask = isolation_children(k)
    if mask < 0: return
    if mask & 1 != 0: arena_prove_in(f, body, int(nodes[n].a))
    if mask & 2 != 0: arena_prove_in(f, body, int(nodes[n].b))
    if mask & 4 != 0: arena_prove_in(f, body, int(nodes[n].c))
    if mask & 16 != 0:
        loop child in kids(n): arena_prove_in(f, body, child)


arena_fixed_capacity = (body: int, l: int) -> int:
    d = arena_find_decl(body, l)
    if d == 0: return -1
    e = int(nodes[d].b)
    loop depth in [0..16):
        if e == 0: return -1
        k = nodes[e].kind
        if k == .conv or k == .unwrap or k == .narrow or k == .exprstmt: e = int(nodes[e].a)
        else if k == .block and nkids(e) > 1 and nodes[kid(e, 0)].kind == .vardecl:
            # (`arena(n) or_throw`, errors.jo: `{ let v=arena(n)  if v is? OutOfMemory return v  v }`)
            last = kid(e, nkids(e) - 1)
            if nodes[last].kind == .exprstmt: last = int(nodes[last].a)
            if nodes[last].kind != .ident or nodes[last].name != nodes[kid(e, 0)].name: return -1
            e = int(nodes[kid(e, 0)].b)
        else if k == .call and nodes[e].aux == 0 and nodes[e].sym > 0:
            g = int(fns[int(nodes[e].sym)].decl)
            if g == 0 or name_of(int(nodes[g].name)) != "arena" or not pos_in_lib(nodes[g].pos) or nkids(e) != 1: return -1
            size = kid(e, 0)
            if nodes[size].kind == .conv: size = int(nodes[size].a)
            if nodes[size].kind != .int_lit: return -1
            return int(nodes[size].ival)
        else: return -1
    -1


arena_find_decl = (n: int, l: int) -> int:
    if n == 0: return 0
    k = nodes[n].kind
    if k == .vardecl and nodes[n].sym == i32(l): return n
    if k == .lambda: return 0
    mask = isolation_children(k)
    if mask < 0: return 0
    found = 0
    if mask & 1 != 0: found = arena_find_decl(int(nodes[n].a), l)
    if found == 0 and mask & 2 != 0: found = arena_find_decl(int(nodes[n].b), l)
    if found == 0 and mask & 4 != 0: found = arena_find_decl(int(nodes[n].c), l)
    if found == 0 and mask & 16 != 0:
        loop child in kids(n):
            found = arena_find_decl(child, l)
            if found != 0: break
    found


arena_prove_scope = (body: int, b: int):
    d = arena_scope_start(b)
    place = kid(int(nodes[d].b), 0)
    lent = arena_root(place)
    value = int(nodes[kid(b, 1)].b)
    capacity = if lent.local == 0: -1 else: arena_fixed_capacity(body, lent.local)
    if capacity < 0:
        arena_unprove(value, "its arena's capacity is not known here: lend a local made by `arena(bytes)` with a constant size")
        return
    arena_proof_sites = []
    arena_proof_nodes = []
    need = arena_bound(value, 1)
    if need < 0:
        arena_unprove(value, "its allocation is not bounded (only array literals of known length count, in loops over constant ranges)")
        return
    if need > capacity:
        arena_unprove(value, "it may take {need} bytes of its arena's {capacity}")
        return
    loop site in arena_proof_sites: arena_proven[site] = true
    # (inside, the expression's other costs are its own storage's: counts and bounds; its
    # allocation is the proof's. The acquisition `arena(n) or_throw` forwards its failure.)
    loop node in arena_proof_nodes: arena_proven_machinery[node] = true
    acquisition = arena_find_decl(body, lent.local)
    arena_mark_subtree(acquisition)
    # (the expression's own entry and exit: a fixed arena's enter only empties it)
    arena_proven[int(nodes[d].b)] = true
    leave = kid(b, 2)
    if nodes[leave].kind == .exprstmt: leave = int(nodes[leave].a)
    arena_proven[leave] = true
    result = kid(b, 3)
    if nodes[result].kind == .exprstmt: result = int(nodes[result].a)
    if not is_managed(ntype(result)): arena_mark_subtree(result)


arena_unprove = (n: int, why: str):
    arena_proof_nodes = []
    arena_collect(n)
    loop node in arena_proof_nodes: arena_unproven[node] = why


arena_capacity_hint = (witness: int) -> str:
    if arena_unproven.len() == 0: return ""
    if let why = arena_unproven.get(witness): return "; it is inside an `$allocator` expression not proven to fit its arena: {why}"
    ""


arena_collect = (n: int):
    if n == 0 or nodes[n].kind == .lambda: return
    arena_proof_nodes.push(n)
    mask = isolation_children(nodes[n].kind)
    if mask < 0: return
    if mask & 1 != 0: arena_collect(int(nodes[n].a))
    if mask & 2 != 0: arena_collect(int(nodes[n].b))
    if mask & 4 != 0: arena_collect(int(nodes[n].c))
    if mask & 16 != 0:
        loop child in kids(n): arena_collect(child)


arena_mark_subtree = (n: int):
    if n == 0 or nodes[n].kind == .lambda: return
    arena_proven_machinery[n] = true
    mask = isolation_children(nodes[n].kind)
    if mask < 0: return
    if mask & 1 != 0: arena_mark_subtree(int(nodes[n].a))
    if mask & 2 != 0: arena_mark_subtree(int(nodes[n].b))
    if mask & 4 != 0: arena_mark_subtree(int(nodes[n].c))
    if mask & 16 != 0:
        loop child in kids(n): arena_mark_subtree(child)


arena_bound = (n: int, times: int) -> int:
    if n == 0: return 0
    k = nodes[n].kind
    if k == .lambda or k == .map_lit or k == .matrix: return -1
    arena_proof_nodes.push(n)
    # (operations that may allocate past what the proof counts: growth, detaching a shared
    # buffer on a write, joined text, boxes)
    if k == .intrinsic:
        id = nodes[n].aux as IN
        if arena_mutators(id) or id == .slice or id == .dewy_set or id == .dewy_fmt or id == .fmt_struct: return -1
    if k == .assign and nodes[int(nodes[n].a)].kind == .index: return -1
    if k == .str_lit and nodes[n].aux == 1: return -1
    if k == .call and (nodes[n].aux == 2 or nodes[n].aux == 3) and is_managed(ntype(n)): return -1
    total = 0
    if k == .array:
        t = prune(ntype(n))
        if tkind(t) != .array: return -1
        loop c in kids(n):
            if has_flag(c, NF_SPREAD): return -1
        count = nkids(n)
        if count > 0:
            total = times * ((24 + count * owner_stride(telem(t)) + 31) & ~15)
            arena_proof_sites.push(n)
    if k == .block and arena_scope_start(n) != 0:
        # (a nested expression's value is copied into this arena)
        if is_managed(ntype(kid(n, 3))): return -1
        return 0
    if k == .while_: return if arena_bound(int(nodes[n].b), 1) == 0 and arena_bound(int(nodes[n].a), 1) == 0: 0 else: -1
    if k == .for_:
        sites = arena_proof_sites.len()
        inner = arena_bound(int(nodes[n].b), 1)
        if inner < 0: return -1
        if inner == 0: return arena_bound(int(nodes[n].a), times)
        trips = arena_trips(int(nodes[n].a))
        if trips < 0: return -1
        arena_proof_sites.truncate(sites)
        inner = arena_bound(int(nodes[n].b), times * trips)
        if inner < 0: return -1
        return inner + max(0, arena_bound(int(nodes[n].a), times))
    mask = isolation_children(k)
    if mask < 0: return -1
    parts: int[]
    if mask & 1 != 0: parts.push(int(nodes[n].a))
    if mask & 2 != 0: parts.push(int(nodes[n].b))
    if mask & 4 != 0: parts.push(int(nodes[n].c))
    if mask & 16 != 0:
        loop child in kids(n): parts.push(child)
    loop p in parts:
        b = arena_bound(p, times)
        if b < 0: return -1
        total += b
    total


arena_trips = (range: int) -> int:
    if nodes[range].kind != .range: return -1
    a = int(nodes[range].a)
    b = int(nodes[range].b)
    if a == 0 or b == 0 or nodes[a].kind != .int_lit or nodes[b].kind != .int_lit: return -1
    if nodes[range].c != 0: return -1
    max(0, int(nodes[b].ival) - int(nodes[a].ival) + 1)

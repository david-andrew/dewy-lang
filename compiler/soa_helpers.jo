# the struct value P(f0, f1, ...) from checked field values (in field order)
soa_struct = (st: int, vals: int[], pos: int) -> int:
    c = mk(.call, pos)
    set_list(c, vals)
    nodes[c].aux = 2
    nodes[c].type = i32(st)
    add_flag(c, NF_CHECKED)
    c
soa_field_names = (t: int) -> int[]:
    si = int(types[prune(t)].st)
    out: int[]
    loop i in [0..int(structs[si].nfields)): out.push(int(fields[int(structs[si].fields) + i].name))
    out
# ps[i]: P(ps.x[i], ps.y[i], ...)
check_soa_index = (n: int, expected: int) -> int:
    pos = nodes[n].pos
    base = int(nodes[n].a)
    st = prune(ntype(base))
    pt = soa_elem(st)
    stmts: int[]
    iname = "__si{bc_count}"
    bc_count += 1
    stmts.push(bc_let(iname, int(nodes[n].b), pos))
    vals: int[]
    loop i in 0.. and fname in soa_field_names(st):
        f = mk(.field, pos)
        nodes[f].a = i32(soa_again(base))
        nodes[f].name = i32(fname)
        ix = mk(.index, pos)
        nodes[ix].a = i32(f)
        nodes[ix].b = i32(bc_ident(iname, pos))
        vals.push(ix)
    blk = bc_block(stmts, pos)
    mark = scope_mark()
    check_stmt(stmts[0])
    add_flag(stmts[0], NF_CHECKED)
    loop i in [0..vals.len()):
        check_expr(vals[i], 0)
        vals[i] = last_checked
    scope_reset(mark)
    # (ps[mask], ps[idxs]: each field's elements picked, a soa array again)
    it = prune(ntype(int(nodes[stmts[0]].b)))
    if types[it].kind == .array: stmts.push(bc_stmt(soa_struct(st, vals, pos), pos))
    else: stmts.push(bc_stmt(soa_struct(pt, vals, pos), pos))
    set_list(blk, stmts)
    nodes[n] = nodes[blk]
    check_expr(n, expected)
# ps[i] = p: each field
soa_assign = (s: int) -> int:
    pos = nodes[s].pos
    lhs = int(nodes[s].a)
    base = int(nodes[lhs].a)
    st = prune(ntype(base))
    if nodes[s].op != i32(int(Tok.assign)): fatal(pos, "only `=` assigns a whole element of a soa array")
    tn = "__st{bc_count}"
    iname = "__si{bc_count}"
    bc_count += 1
    stmts = [bc_let(iname, int(nodes[lhs].b), pos)]
    vd = bc_let(tn, int(nodes[s].b), pos)
    ty = mk(.tname, pos)
    nodes[ty].aux = -7
    nodes[ty].ival = soa_elem(st)
    nodes[vd].a = i32(ty)
    stmts.push(vd)
    loop fname in soa_field_names(st):
        f = mk(.field, pos)
        nodes[f].a = i32(soa_again(base))
        nodes[f].name = i32(fname)
        ix = mk(.index, pos)
        nodes[ix].a = i32(f)
        nodes[ix].b = i32(bc_ident(iname, pos))
        a = mk(.assign, pos)
        nodes[a].op = i32(int(Tok.assign))
        nodes[a].a = i32(ix)
        nodes[a].b = i32(bc_field(bc_ident(tn, pos), name_of(fname), pos))
        stmts.push(a)
    es = bc_stmt(bc_block(stmts, pos), pos)
    check_stmt(es)
    es
check_soa_method = (n: int, recv: int, fname: int, args: int[], expected: int) -> int:
    pos = nodes[n].pos
    st = prune(ntype(recv))
    pt = soa_elem(st)
    fnms = soa_field_names(st)
    m = name_of(fname)
    if fnms.len() == 0: fatal(pos, "{dt(st)}: the struct has no fields")
    fld = (i: int) -> int:
        f = mk(.field, pos)
        nodes[f].a = i32(soa_again(recv))
        nodes[f].name = i32(fnms[i])
        f
    stmts: int[]
    if m == "len":
        nodes[n] = nodes[bc_call("len", [fld(0)], pos)]
        return check_expr(n, expected)
    if m == "push":
        if args.len() != 1: fatal(pos, "push takes one element")
        tn = "__st{bc_count}"
        bc_count += 1
        vd = bc_let(tn, args[0], pos)
        ty = mk(.tname, pos)
        nodes[ty].aux = -7
        nodes[ty].ival = pt
        nodes[vd].a = i32(ty)
        stmts.push(vd)
        loop i in 0.. and nm in fnms: stmts.push(bc_stmt(bc_method(fld(i), "push", [bc_field(bc_ident(tn, pos), name_of(nm), pos)], pos), pos))
    else if m == "clear" or m == "reserve" or m == "truncate":
        loop i in [0..fnms.len()):
            cl: int[]
            loop a in args: cl.push(clone(a))
            stmts.push(bc_stmt(bc_method(fld(i), m, cl, pos), pos))
    else if m == "pop" or m == "remove":
        if m == "remove" and args.len() != 1: fatal(pos, "remove takes an index")
        vals: int[]
        if m == "remove":
            iname = "__si{bc_count}"
            bc_count += 1
            stmts.push(bc_let(iname, args[0], pos))
            loop i in [0..fnms.len()): vals.push(bc_method(fld(i), "remove", [bc_ident(iname, pos)], pos))
        else:
            loop i in [0..fnms.len()): vals.push(bc_method(fld(i), "pop", [], pos))
        blk = bc_block(stmts, pos)
        mark = scope_mark()
        loop x in stmts:
            check_stmt(x)
            add_flag(x, NF_CHECKED)
        loop i in [0..vals.len()):
            check_expr(vals[i], 0)
            vals[i] = last_checked
        scope_reset(mark)
        stmts.push(bc_stmt(soa_struct(pt, vals, pos), pos))
        set_list(blk, stmts)
        nodes[n] = nodes[blk]
        return check_expr(n, expected)
    else: fatal(pos, "a soa array has len, push, pop, remove, clear, reserve and truncate (and its field arrays: xs.{name_of(fnms[0])})")
    nodes[n] = nodes[bc_block(stmts, pos)]
    check_expr(n, expected)
# P[] -> soa P[]: n becomes a loop pushing each element
soa_from_array = (n: int, to: int):
    pos = nodes[n].pos
    inner = nodes.len()
    nodes.push(nodes[n])
    cn = "__sc{bc_count}"
    on = "__so{bc_count}"
    pn = "__sp{bc_count}"
    bc_count += 1
    od = mk(.vardecl, pos)
    nodes[od].name = i32(intern(on))
    ty = mk(.tname, pos)
    nodes[ty].aux = -7
    nodes[ty].ival = to
    nodes[od].a = i32(ty)
    lp = mk(.for_, pos)
    set_list(lp, [bc_ident(pn, pos)])
    nodes[lp].a = i32(bc_ident(cn, pos))
    nodes[lp].b = i32(bc_block([bc_stmt(bc_method(bc_ident(on, pos), "push", [bc_ident(pn, pos)], pos), pos)], pos))
    stmts = [bc_let(cn, inner, pos), od, bc_stmt(bc_method(bc_ident(on, pos), "reserve", [bc_call("len", [bc_ident(cn, pos)], pos)], pos), pos), lp, bc_stmt(bc_ident(on, pos), pos)]
    nodes[n] = nodes[bc_block(stmts, pos)]
    check_expr(n, to)

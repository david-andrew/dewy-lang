$runtime_checks

from p"ast.jo" import (NF_STMT NF_TERMINATED add_flag clone has_flag mk nkids nodes set_list)
from p"checker_tokens.dewy" import (Tok)
from p"diagnostic_exit.dewy" import (fatal)
from p"parse.jo" import (comp_count comp_ident expect expect_ident expect_name habit is_keyword_tok p_header p_matrix p_no_tuple p_ntoks p_src p_toks struct_body ti)
from p"parser_text.dewy" import (tok_src word_in)
from p"parser_loops.dewy" import (desugar_loopx loop_unpack_many parse_loop_head)
from p"parser_cursor.dewy" import (accept advance cur_pos is_assign_op is_soft_kw partner pk pkn space_before)
from p"parser_decls.dewy" import (parse_type parse_when)
from p"parser_errors.dewy" import (keyword_name_error parse_empty_block)
from p"parser_expr.dewy" import (parse_binary parse_expr)
from p"util.jo" import (intern)

StmtWord:type=int64<overflow='wrap'>

# Blocks and statements read the Jo parser's EOF-terminated token stream and
# node arena directly. Reacquire node slots after builders or recursive calls,
# which may grow the arena. Numeric operators are frozen Jo Tok ordinals.
parse_block=():>int64=>{
    let b=mk('block' cur_pos())
    let stmts:array<int64>=[]
    if pk() =? 'newline' {
        advance();
        return parse_indented_block(b)
    }
    # (`loop x in xs: if x > 0: n += 1`: an if after the colon is the statement, which needs no else)
    if pk() =? 'kw_if' {
        stmts.push(parse_if())
        set_list(b stmts)
        return b
    }
    stmts.push(parse_simple_stmt())
    loop pk() =? 'semi' and pkn(1) not=? 'newline' {
        advance();
        stmts.push(parse_simple_stmt())
    }
    set_list(b stmts)
    b
}

# The statements of an indented block, from its indent token on, into block b.
parse_indented_block=(b:StmtWord):>int64=>{
    if pk() not=? 'indent' {parse_empty_block()}
    advance();
    let stmts:array<int64>=[]
    loop pk() not=? 'dedent' and pk() not=? 'eof' {
        let s=parse_stmt()
        if s not=? 0 {stmts.push(s)}
    }
    expect('dedent' "end of block");
    add_flag(b NF_TERMINATED)
    set_list(b stmts)
    b
}

# [loop x in xs: if cond: loop y in ys: value] becomes a block expression:
#     acc = []; loop x in xs: if cond: loop y in ys: acc.push(value); acc
# ({loop ...: key: value} is __map_of([loop ...: (key, value)]))
parse_comprehension=(pos:StmtWord map:bool=false):>int64=>$unsafe {
    let clauses:array<[int64 int64]>=[]          # (1, loop node), (2, condition) or (3, if let)
    let saved_m=p_matrix
    p_matrix=0
    let elem:int64=0
    loop true {
        if pk() =? 'kw_loop' {
            let lp=parse_loop_head()
            clauses.push([1 lp])
            let cpos=cur_pos()
            accept('colon');
            if pk() =? 'newline' or pk() =? 'indent' {fatal(cpos "a [loop ...] gives one expression for each element, on the same line as its colon: `[loop i in [0..n): i * 2]`; for steps on lines of their own, start with `xs: int[]` and `xs.push(...)` in a loop")}
        }
        else if pk() =? 'kw_if' {
            advance();
            let il:int64=0
            if accept('kw_let') {
                # (if let n = to_float(s): the elements that have one, n in them)
                il=mk('iflet' cur_pos())
                nodes.ptr[il].name=int32<overflow='wrap'>(expect_ident("variable name"))
                expect('assign' "'='");
            }
            let saved_h=p_header
            p_header=true
            let c=parse_expr()
            p_header=saved_h
            if il not=? 0 {
                nodes.ptr[il].a=int32<overflow='wrap'>(c)
                clauses.push([3 il])
            }
            else {clauses.push([2 c])}
            accept('colon');
        }
        else {
            elem=parse_expr()
            if map {
                expect('colon' "':' between a key and its value");
                let v=parse_expr()
                let pair=mk('tuple' nodes.ptr[elem].pos)
                set_list(pair [elem v])
                elem=pair
            }
            break
        }
    }
    p_matrix=saved_m
    if pk() =? 'kw_else' {fatal(cur_pos() "an `if` right after the loop's colon picks which elements there are; a choice between two values goes in parentheses: `[loop x in xs: (if c: a else: b)]`")}
    if map {expect('rbrace' "");}
    else {expect('rbrack' "");}
    comp_count += 1
    let acc=intern("__comp{comp_count}")
    # innermost: acc.push(elem)
    let callee=mk('field' pos)
    nodes.ptr[callee].a=int32<overflow='wrap'>(comp_ident(acc pos))
    nodes.ptr[callee].name=int32<overflow='wrap'>(intern("push"))
    let call=mk('call' pos)
    nodes.ptr[call].a=int32<overflow='wrap'>(callee)
    set_list(call [elem])
    let stmt=mk('exprstmt' pos)
    nodes.ptr[stmt].a=int32<overflow='wrap'>(call)
    let i:StmtWord=StmtWord(clauses.length) - 1
    loop i >=? 0 {
        let body=mk('block' pos)
        set_list(body [stmt])
        let [ck cn]=clauses[i]
        if ck =? 1 {
            nodes.ptr[cn].b=int32<overflow='wrap'>(body)
            loop_unpack_many(cn)
            stmt=cn
            if nodes.ptr[stmt].kind =? 'loopx' {stmt=desugar_loopx(stmt)}
        }
        else if ck =? 3 {
            nodes.ptr[cn].b=int32<overflow='wrap'>(body)
            add_flag(cn NF_STMT)
            stmt=cn
        }
        else {
            let iff=mk('if_' nodes.ptr[cn].pos)
            nodes.ptr[iff].a=int32<overflow='wrap'>(cn)
            nodes.ptr[iff].b=int32<overflow='wrap'>(body)
            add_flag(iff NF_STMT)
            stmt=iff
        }
        i -= 1
    }
    let decl=mk('vardecl' pos)
    nodes.ptr[decl].name=int32<overflow='wrap'>(acc)
    nodes.ptr[decl].b=int32<overflow='wrap'>(mk('array' pos))
    let result=mk('exprstmt' pos)
    nodes.ptr[result].a=int32<overflow='wrap'>(comp_ident(acc pos))
    let blk=mk('block' pos)
    set_list(blk [decl stmt result])
    if not map {return blk}
    let mc=mk('call' pos)
    nodes.ptr[mc].a=int32<overflow='wrap'>(comp_ident(intern("__map_of") pos))
    set_list(mc [blk])
    mc
}

parse_if=():>int64=>$unsafe {
    let pos=cur_pos()
    expect('kw_if' "");
    let n=mk('if_' pos)
    if accept('kw_let') {
        nodes.ptr[n].kind='iflet'
        nodes.ptr[n].name=int32<overflow='wrap'>(expect_ident("variable name"))
        expect('assign' "'='");
    }
    let saved_h=p_header
    p_header=true
    nodes.ptr[n].a=int32<overflow='wrap'>(parse_expr())
    p_header=saved_h
    # (if let t = e and t != "": e is what is bound, the rest a condition on it)
    let let_cond:StmtWord=0
    if nodes.ptr[n].kind =? 'iflet' and nodes.ptr[StmtWord(nodes.ptr[n].a)].kind =? 'and_' {
        let top=StmtWord(nodes.ptr[n].a)
        let p=top
        let parent:StmtWord=0
        loop nodes.ptr[StmtWord(nodes.ptr[p].a)].kind =? 'and_' {
            parent=p
            p=StmtWord(nodes.ptr[p].a)
        }
        nodes.ptr[n].a=nodes.ptr[p].a
        if parent =? 0 {let_cond=StmtWord(nodes.ptr[p].b)}
        else {
            nodes.ptr[parent].a=nodes.ptr[p].b
            let_cond=top
        }
    }
    expect('colon' "");
    # (an indented branch is statements again, where commas make tuples)
    let saved_nt=p_no_tuple
    if pk() =? 'newline' {p_no_tuple=false}
    nodes.ptr[n].b=int32<overflow='wrap'>(parse_block())
    p_no_tuple=saved_nt
    let save=ti
    if pk() =? 'newline' and pkn(1) =? 'kw_else' and not has_flag(StmtWord(nodes.ptr[n].b) NF_TERMINATED) {advance();}
    if pk() =? 'kw_else' {
        advance();
        if pk() =? 'kw_if' {
            let b=mk('block' cur_pos())
            let inner=parse_if()
            set_list(b [inner])
            if has_flag(inner NF_TERMINATED) {add_flag(b NF_TERMINATED)}
            nodes.ptr[n].c=int32<overflow='wrap'>(b)
        }
        else {
            expect('colon' "");
            let saved_else=p_no_tuple
            if pk() =? 'newline' {p_no_tuple=false}
            nodes.ptr[n].c=int32<overflow='wrap'>(parse_block())
            p_no_tuple=saved_else
        }
        if has_flag(StmtWord(nodes.ptr[n].c) NF_TERMINATED) {add_flag(n NF_TERMINATED)}
    }
    else {
        ti=save
        if has_flag(StmtWord(nodes.ptr[n].b) NF_TERMINATED) {add_flag(n NF_TERMINATED)}
    }
    if let_cond not=? 0 {
        # if let t = e: (if cond: body else: the else) else: the else
        let inner=mk('if_' nodes.ptr[let_cond].pos)
        nodes.ptr[inner].a=int32<overflow='wrap'>(let_cond)
        nodes.ptr[inner].b=nodes.ptr[n].b
        if nodes.ptr[n].c not=? 0 {nodes.ptr[inner].c=int32<overflow='wrap'>(clone(StmtWord(nodes.ptr[n].c)))}
        if has_flag(n NF_STMT) {add_flag(inner NF_STMT)}
        if has_flag(StmtWord(nodes.ptr[inner].b) NF_TERMINATED) and nodes.ptr[inner].c not=? 0 and has_flag(StmtWord(nodes.ptr[inner].c) NF_TERMINATED) {add_flag(inner NF_TERMINATED)}
        let b=mk('block' nodes.ptr[let_cond].pos)
        set_list(b [inner])
        if has_flag(inner NF_TERMINATED) {add_flag(b NF_TERMINATED)}
        nodes.ptr[n].b=int32<overflow='wrap'>(b)
    }
    n
}

parse_pattern=():>int64=>$unsafe {
    let pos=cur_pos()
    if pk() =? 'ident' and p_toks[ti].len =? 1 and (p_src as array<uint8>)[p_toks[ti].start] =? 95 {
        advance();
        return mk('pwild' pos)
    }
    if pk() =? 'dot' or ((pk() =? 'ident' or is_soft_kw(pk())) and (pkn(1) =? 'lparen' or pkn(1) =? 'colon' or pkn(1) =? 'comma')) {
        if pk() =? 'dot' {advance();}
        let v=mk('pvariant' pos)
        nodes.ptr[v].name=int32<overflow='wrap'>(expect_name("variant name"))
        if accept('lparen') {
            let binds:array<int64>=[]
            loop pk() not=? 'rparen' {
                let b=mk('ident' cur_pos())
                nodes.ptr[b].name=int32<overflow='wrap'>(expect_ident("binding name"))
                binds.push(b)
                if not accept('comma') {break}
            }
            expect('rparen' "");
            set_list(v binds)
            nodes.ptr[v].aux=1
        }
        return v
    }
    let e=parse_binary(3)
    if nodes.ptr[e].kind =? 'range' {
        nodes.ptr[e].kind='prange'
        return e
    }
    let l=mk('plit' pos)
    nodes.ptr[l].a=int32<overflow='wrap'>(e)
    l
}

parse_match=():>int64=>$unsafe {
    let pos=cur_pos()
    expect('kw_match' "");
    let m=mk('match_' pos)
    let saved_h=p_header
    p_header=true
    nodes.ptr[m].a=int32<overflow='wrap'>(parse_expr())
    p_header=saved_h
    expect('colon' "");
    expect('newline' "");
    expect('indent' "indented match arms");
    let arms:array<int64>=[]
    loop pk() not=? 'dedent' and pk() not=? 'eof' {
        let arm=mk('arm' cur_pos())
        let pats:array<int64>=[]
        if pk() =? 'kw_else' {
            advance();
            pats.push(mk('pwild' nodes.ptr[arm].pos))
        }
        else {
            loop true {
                pats.push(parse_pattern())
                if not accept('comma') {break}
            }
        }
        set_list(arm pats)
        expect('colon' "");
        nodes.ptr[arm].b=int32<overflow='wrap'>(parse_block())
        if not has_flag(StmtWord(nodes.ptr[arm].b) NF_TERMINATED) {
            if pk() not=? 'dedent' {expect('newline' "");}
        }
        arms.push(arm)
    }
    expect('dedent' "");
    set_list(m arms)
    add_flag(m NF_TERMINATED)
    m
}

tuple_from=(first:StmtWord):>int64=>$unsafe {
    let t=mk('tuple' nodes.ptr[first].pos)
    let elems:array<int64>=[first]
    loop accept('comma') {elems.push(parse_expr())}
    set_list(t elems)
    t
}

parse_simple_stmt=():>int64=>$unsafe {
    let pos=cur_pos()
    let k=pk()
    # (a struct's field named by a keyword: `build: Rect`, `when: f64`)
    if struct_body not=? "" and is_keyword_tok(k) and k not=? 'kw_pass' and (pkn(1) =? 'colon' or pkn(1) =? 'assign') {keyword_name_error(ti)}
    if k =? 'kw_return' {
        advance();
        let r=mk('return_' pos)
        let nk=pk()
        if nk not=? 'newline' and nk not=? 'semi' and nk not=? 'dedent' and nk not=? 'eof' and nk not=? 'kw_else' and nk not=? 'rparen' and nk not=? 'comma' {
            let e=parse_expr()
            if pk() =? 'comma' and not p_no_tuple {e=tuple_from(e)}
            nodes.ptr[r].a=int32<overflow='wrap'>(e)
        }
        return r
    }
    if k =? 'kw_break' {
        advance();
        if pk() =? 'ident' {fatal(cur_pos() "loops have no labels: `break` leaves the innermost loop; to leave two at once, put them in a function and `return` from it, or set a flag the outer loop checks")}
        return mk('break_' pos)
    }
    if k =? 'kw_continue' {advance(); return mk('continue_' pos)}
    if k =? 'kw_pass' {advance(); return mk('block' pos)}
    if k =? 'kw_defer' {
        advance();
        let d=mk('defer_' pos)
        if pk() =? 'colon' {
            advance();
            nodes.ptr[d].a=int32<overflow='wrap'>(parse_block())
        }
        else {nodes.ptr[d].a=int32<overflow='wrap'>(parse_simple_stmt())}
        return d
    }
    if k =? 'kw_let' {
        # always a new variable (shadows one of the same name)
        advance();
        let d=mk('vardecl' pos)
        if pk() =? 'ident' and pkn(1) =? 'comma' {
            let names:array<int64>=[]
            loop true {
                let v=mk('ident' cur_pos())
                if pk() =? 'ident' and p_toks[ti].len =? 1 and (p_src as array<uint8>)[p_toks[ti].start] =? 95 {
                    advance();
                    nodes.ptr[v].kind='hole'
                }
                else {nodes.ptr[v].name=int32<overflow='wrap'>(expect_ident("variable name"))}
                names.push(v)
                if not accept('comma') {break}
            }
            set_list(d names)
        }
        else {
            nodes.ptr[d].name=int32<overflow='wrap'>(expect_ident("variable name"))
            if accept('colon') {nodes.ptr[d].a=int32<overflow='wrap'>(parse_type())}
        }
        if accept('assign') {
            let v=parse_expr()
            if pk() =? 'comma' {v=tuple_from(v)}
            nodes.ptr[d].b=int32<overflow='wrap'>(v)
        }
        return d
    }
    # typed declaration: name: Type [= expr]
    if k =? 'ident' and pkn(1) =? 'colon' {
        let w=tok_src(ti)
        if pkn(2) =? 'newline' and word_in(w ["try" "except" "catch" "finally"]) {
            fatal(pos "there are no exceptions: errors are values (a function gives `T | Error`, and `match` or `is` sees which came back; `panic` stops the program)")
        }
        let d=mk('vardecl' pos)
        nodes.ptr[d].name=int32<overflow='wrap'>(expect_ident(""))
        advance();
        nodes.ptr[d].a=int32<overflow='wrap'>(parse_type())
        if accept('assign') {nodes.ptr[d].b=int32<overflow='wrap'>(parse_expr())}
        return d
    }
    let e=parse_expr()
    # (in a one-line lambda body a ',' ends the statement)
    if p_no_tuple and not is_assign_op(pk()) {
        let s=mk('exprstmt' pos)
        nodes.ptr[s].a=int32<overflow='wrap'>(e)
        return s
    }
    if pk() =? 'comma' and not p_no_tuple {e=tuple_from(e)}
    if pk() =? 'dotop' and pkn(1) =? 'assign' and not space_before(StmtWord(ti) + 1) {
        # xs .+= ys: xs = xs .+ ys
        let a=mk('assign' cur_pos())
        nodes.ptr[a].op=47 # Frozen Tok.assign ordinal.
        nodes.ptr[a].a=int32<overflow='wrap'>(e)
        let b=mk('binary' cur_pos())
        let op=advance()
        advance();
        nodes.ptr[b].op=85 # Frozen Tok.dotop ordinal.
        nodes.ptr[b].aux=int32<overflow='wrap'>(p_toks[op].ival)
        nodes.ptr[b].a=int32<overflow='wrap'>(clone(e))
        nodes.ptr[b].b=int32<overflow='wrap'>(parse_expr())
        nodes.ptr[a].b=int32<overflow='wrap'>(b)
        return a
    }
    if is_assign_op(pk()) {
        let a=mk('assign' cur_pos())
        let at=advance()
        let opk=p_toks[at].kind
        if opk =? 'careteq' {
            # x ^= y: x = x ^ y (power)
            nodes.ptr[a].op=47 # Frozen Tok.assign ordinal.
            nodes.ptr[a].a=int32<overflow='wrap'>(e)
            let pw=mk('call' nodes.ptr[a].pos)
            let callee=mk('ident' nodes.ptr[a].pos)
            nodes.ptr[callee].name=int32<overflow='wrap'>(intern("pow"))
            nodes.ptr[pw].a=int32<overflow='wrap'>(callee)
            set_list(pw [clone(e) parse_expr()])
            nodes.ptr[a].b=int32<overflow='wrap'>(pw)
            return a
        }
        # Tok is the first 32-bit field of the bounded token slot: its frozen Jo ordinal.
        let op:int32=((p_toks + at) as ptr<int32>)[0]
        if opk =? 'kw_and' or opk =? 'kw_or' or opk =? 'kw_xor' {
            # and= or= xor= (bitwise on integers, logical on bools)
            advance();
            if opk =? 'kw_and' {op=53} # Frozen Tok.ampeq ordinal.
            else if opk =? 'kw_or' {op=54} # Frozen Tok.pipeeq ordinal.
            else {op=55} # Frozen Tok.careteq ordinal.
        }
        nodes.ptr[a].op=op
        nodes.ptr[a].a=int32<overflow='wrap'>(e)
        let v=parse_expr()
        if pk() =? 'comma' and not p_no_tuple {v=tuple_from(v)}
        nodes.ptr[a].b=int32<overflow='wrap'>(v)
        return a
    }
    if nodes.ptr[e].kind =? 'tuple' and nkids(e) >? 1 and pk() not=? 'newline' {fatal(nodes.ptr[e].pos "unexpected ','")}
    let s=mk('exprstmt' pos)
    nodes.ptr[s].a=int32<overflow='wrap'>(e)
    if has_flag(e NF_TERMINATED) {add_flag(s NF_TERMINATED)}
    s
}

end_stmt=(s:StmtWord):>void=>$unsafe {
    # (foreach (x in xs):, switch (a):, while (x < 3) { ...: other languages' statements, which
    # parse as a call up to there)
    if pk() =? 'colon' or pk() =? 'lbrace' {
        let j:StmtWord=ti
        loop j >? 0 and p_toks[j - 1].kind not=? 'newline' and p_toks[j - 1].kind not=? 'indent' and p_toks[j - 1].kind not=? 'dedent' {j -= 1}
        if p_toks[j].kind =? 'ident' and j + 1 <? p_ntoks {habit(j + 1 'newline')}
    }
    if s not=? 0 and has_flag(s NF_TERMINATED) {
        accept('newline');
        return
    }
    if pk() =? 'semi' {
        advance();
        accept('newline');
        return
    }
    if pk() =? 'dedent' or pk() =? 'eof' {return}
    if ti >? 0 and p_toks[StmtWord(ti) - 1].kind =? 'dedent' {return}
    expect('newline' "end of statement");
}

parse_stmt=():>int64=>$unsafe {
    let pos=cur_pos()
    let k=pk()
    let s:int64=0
    if k =? 'newline' {
        advance();
        return 0
    }
    # ([a, b] = xs, {x, y} = p: destructuring from JavaScript)
    if (k =? 'lbrack' or k =? 'lbrace') and partner(ti) >? ti and partner(ti) + 1 <? p_ntoks and p_toks[StmtWord(partner(ti)) + 1].kind =? 'assign' {
        if k =? 'lbrack' {fatal(pos "an array is unpacked without brackets: `a, b = xs` (it must have exactly that many elements)")}
        fatal(pos "a struct's fields are read one by one: `x, y = p.x, p.y`")
    }
    # (a keyword declared as a variable, function or field: build = ..., when: str)
    if is_keyword_tok(k) and k not=? 'kw_else' and k not=? 'kw_loop' and k not=? 'kw_not' and k not=? 'kw_true' and k not=? 'kw_false' and k not=? 'kw_none' and k not=? 'kw_null' {
        if pkn(1) =? 'assign' or (pkn(1) =? 'colon' and pkn(2) not=? 'newline' and pkn(2) not=? 'indent' and k not=? 'kw_build') {keyword_name_error(ti)}
    }
    if k =? 'kw_if' {
        s=parse_if()
        add_flag(s NF_STMT)
    }
    else if k =? 'kw_when' {s=parse_when()}
    else if k =? 'kw_loop' {
        s=parse_loop_head()
        expect('colon' "");
        nodes.ptr[s].b=int32<overflow='wrap'>(parse_block())
        if has_flag(StmtWord(nodes.ptr[s].b) NF_TERMINATED) {add_flag(s NF_TERMINATED)}
        loop_unpack_many(s)
        if nodes.ptr[s].kind =? 'loopx' {
            let term=has_flag(s NF_TERMINATED)
            s=desugar_loopx(s)
            if term {add_flag(s NF_TERMINATED)}
        }
    }
    else if k =? 'kw_match' {
        s=mk('exprstmt' pos)
        let m=parse_match()
        add_flag(m NF_STMT)
        nodes.ptr[s].a=int32<overflow='wrap'>(m)
        add_flag(s NF_TERMINATED)
    }
    else if k =? 'kw_const' {
        advance();
        s=mk('const_' pos)
        nodes.ptr[s].name=int32<overflow='wrap'>(expect_ident("constant name"))
        if accept('colon') {nodes.ptr[s].a=int32<overflow='wrap'>(parse_type())}
        expect('assign' "");
        nodes.ptr[s].b=int32<overflow='wrap'>(parse_expr())
    }
    else {
        s=parse_simple_stmt()
        let sk=nodes.ptr[s].kind
        if (sk =? 'vardecl' or sk =? 'assign') and nodes.ptr[s].b not=? 0 and has_flag(StmtWord(nodes.ptr[s].b) NF_TERMINATED) {add_flag(s NF_TERMINATED)}
        if sk =? 'return_' and nodes.ptr[s].a not=? 0 and has_flag(StmtWord(nodes.ptr[s].a) NF_TERMINATED) {add_flag(s NF_TERMINATED)}
    }
    end_stmt(s)
    s
}

ct_math_runtime = (name: str, args: int[], e: int) -> int: cx_math_runtime(name, args, e)
ct_math_rep = (value: int) -> int: cx_math_rep(value)
ct_math_unpack = (value: int) -> int: cx_math_unpack(value)
ct_math_binary = (e: int, op: Tok, a: int, b: int) -> int: cx_math_binary(e, op, a, b)
ct_math_for = (s: int): cx_math_for(s)

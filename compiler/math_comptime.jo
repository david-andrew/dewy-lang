use 'evaluator_state.dewy'
use 'checker_tokens.dewy'
# Reuse the bundled arithmetic inside the evaluator. CT mathematical integers
# have a word or one immutable BigInt value, independent of the tagged runtime boundary.
use 'comptime.jo'
use 'check.jo'
use 'types.jo'
use 'ast.jo'
use 'lex.jo'
use 'expr.jo'
use 'util.jo'

ct_math_runtime = (name: str, args: int[], e: int) -> int:
    f = runtime_fn("__mc_" + name[5..])
    call = mk(.call, nodes[e].pos)
    nodes[call].sym = i32(f)
    nodes[call].type = fns[f].ret
    actual: int[]
    loop value in args: actual.push(ct_literal(value, nodes[e].pos))
    set_list(call, actual)
    ct_fixed_internal += 1
    result = ct_call(call)
    ct_fixed_internal -= 1
    result

ct_math_rep = (value: int) -> int:
    x = ct_values[value]
    f = runtime_fn("__mc_compare")
    rep = prune(fns[f].ptypes[0])
    layout(rep)
    handle = int(fields[int(structs[int(types[rep].st)].fields) + 1].type)
    word = ct_int(T_INT, x.i)
    big = ct_add(CTValue(type = handle, items = x.items))
    ct_add(CTValue(type = rep, items = [word, big]))

ct_math_unpack = (value: int) -> int:
    x = ct_values[value]
    ct_add(CTValue(type = T_MATH_INT, i = ct_values[x.items[0]].i, items = ct_values[x.items[1]].items))

ct_math_binary = (e: int, op: Tok, a: int, b: int) -> int:
    if op == .starstar:
        exponent = ct_values[b].i
        if exponent < 0 or ct_values[b].items.len() > 0: ct_fail(e, "power exponent must be a nonnegative bounded integer")
        result = ct_int(T_MATH_INT, 1)
        base = a
        loop exponent > 0:
            if exponent & 1 != 0: result = ct_math_binary(e, .star, result, base)
            exponent = exponent >> 1
            if exponent > 0: base = ct_math_binary(e, .star, base, base)
        return result
    x = ct_math_rep(a)
    if op == .shl or op == .shr:
        count = ct_values[b].i
        if ct_values[b].items.len() > 0:
            count = ct_values[ct_math_runtime("__mi_count", [ct_math_rep(b)], e)].i
        if count < 0: ct_fail(e, "shift count must be nonnegative")
        value = ct_math_runtime("__mi_shift", [x, ct_int(T_INT, count), ct_int(T_BOOL, int(op == .shr))], e)
        return ct_math_unpack(value)
    y = ct_math_rep(b)
    if op == .eq or op == .ne or op == .lt or op == .le or op == .gt or op == .ge:
        result = ct_math_runtime("__mi_compare", [x, y], e)
        return ct_binary(e, op, result, ct_int(T_INT, 0), T_BOOL)
    operation = if op == .plus: 0 else if op == .minus: 1 else if op == .star: 2 else if op == .slash: 3 else if op == .percent: 4 else if op == .amp: 5 else if op == .pipe: 6 else: 7
    if nodes[e].kind == .binary and nodes[e].aux2 == -1 and (op == .slash or op == .percent): operation += 5
    ct_math_unpack(ct_math_runtime("__mi_slow", [x, y, ct_int(T_INT, operation)], e))

ct_math_for = (s: int):
    it = int(nodes[s].a)
    counter = ct_expr(int(nodes[it].a))
    open_end = nodes[it].b == 0
    bound = if open_end: ct_int(T_MATH_INT, 0) else: ct_expr(int(nodes[it].b))
    step = ct_int(T_MATH_INT, 1)
    if has_flag(it, NF_STEP): step = ct_binary(s, .minus, ct_expr(int(nodes[it].c)), counter, T_MATH_INT)
    if ct_frames[ct_frame].signal != 0: return
    zero = ct_int(T_MATH_INT, 0)
    if ct_values[ct_binary(s, .eq, step, zero, T_BOOL)].i != 0: ct_fail(s, "zero range step")
    up = ct_values[ct_binary(s, .gt, step, zero, T_BOOL)].i != 0
    inclusive = has_flag(it, NF_INCLUSIVE)
    op = if up: (if inclusive: Tok.le else: Tok.lt) else: (if inclusive: Tok.ge else: Tok.gt)
    loop true:
        if not open_end and ct_values[ct_binary(s, op, counter, bound, T_BOOL)].i == 0: break
        ct_frames[ct_frame].values[int(nodes[s].sym)] = counter
        ct_block(int(nodes[s].b))
        if ct_loop_exit(): break
        counter = ct_binary(s, .plus, counter, step, T_MATH_INT)

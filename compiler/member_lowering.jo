use 'lower_scalars.dewy'
use 'lower_group.dewy'
use 'ir_operands.dewy'
# Share only fully lowered members bodies: checking/facts still see each literal.
# Admission comes from member_replay; IR, checks, cleanup, positions and external
# storage must then agree modulo private registers/slots and recorded literals.
# Demand-driven O(I + V + S + M*C + text bytes) time/storage for admitted loops:
# I emitted instructions/arguments, V registers, S slots, M members, C literal
# occurrences. Relocation is indexed, never a search through earlier members.
use 'member_replay.jo'
use 'lower.jo'
use 'ir.jo'
use 'ast.jo'
use 'types.jo'
use 'check.jo'
use 'util.jo'
use 'lex.jo'
use 'main.jo'
use 'fused.jo'
use 'lower_primitives.dewy'
use 'ir_builders.dewy'
use 'member_ops.dewy'

struct MemberLiteral:
    reg: int
    pos: int
    kind: int                 # 0: a literal word, 1: immortal string address
    value: int

struct MemberLowered:
    start: int
    end: int
    regs: int
    reg_end: int
    slots: int
    slot_end: int
    zeros: int
    zero_end: int
    scope: int
    literals: MemberLiteral[]

member_lower_active = -1
member_lower_literals: MemberLiteral[]

struct MemberMatch:
    first: MemberLowered
    next: MemberLowered
    regs: int[]
    reverse: int[]
    slots: int[]
    slot_reverse: int[]
    literal: int[]
    next_literal: int[]

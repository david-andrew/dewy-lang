from p"@lib/core/rt.jo" import (__str_from_bytes)
$runtime_checks

from p"@lib/core/rt.jo" import (__olen __write_fd __out_flush)
from p"@lib/core/os.jo" import (__zstr env eprint exit time)
from p"ast.jo" import (NF_EXTERN has_flag kids nkids nodes)
from p"check.jo" import (FK_LAMBDA FK_PARTIAL fns globals modules prelude syms target_arm64 target_macos target_wasm target_windows watch_build)
from p"driver_pipeline.dewy" import (emit_now emit_queue emit_queue_rel queue_emit)
from p"elf_format.dewy" import (elf_syms)
from p"fused.jo" import (FzRec fz_trace_fd fused_on fz_by_helper fz_by_inst fz_d0 fz_j fz_kdt fz_kro fz_layout fz_lf0 fz_mdt fz_mlf fz_mrc fz_mro fz_pinit fz_qrec fz_r0 fz_raws fz_rd fz_ready fz_recs fz_ro fz_texts fzw_f0 fzw_g0 fzw_have fzw_recs fzw_t0)
from p"fused_ir.dewy" import (fz_pack_ir)
from p"fused_ops.dewy" import (fz_cand fz_canon fz_hkey fz_map_in fz_map_lf fz_parse fz_pos fz_put_str fz_small fz_validate fz_weight fzw_lower)
from p"inline_ops.dewy" import (fast_inline_prepare)
from p"ir.jo" import (dbg_on ir ir_positions)
from p"ir_types.dewy" import (IrFn)
from p"lower.jo" import (HK LK_HELPER LK_INST data_size lfuncs mt_active_off opt_release ro_starts rodata)
from p"lower_closures.dewy" import (env_layout partial_layout)

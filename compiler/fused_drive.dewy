FusedWord:type=int64<overflow='wrap'>
fused_start=(pinit_lf:FusedWord):>bool=>$unsafe {
    fz_ready=false
    fz_layout=false
    if $target.os not=? 'linux' or $target.arch not=? 'x86_64' {
        return false
    } else {
        if target_wasm or target_arm64 or target_windows or target_macos or opt_release or dbg_on or watch_build or repl_image or lower_only or host_ir or ra_stat or (ra_dump as array<uint8>).length >? 0 or not queue_emit {return false}
        fz_pinit=lfuncs.ptr[pinit_lf].inst
        let cands:array<int64>=[]
        let ws:array<int64>=[]
        let total:FusedWord=0
        loop f in [1..fns.length) {
            if not fz_cand(f fz_pinit) {continue}
            cands.push(f)
            let w=fz_weight(f)
            ws.push(w)
            total += w
        }
        let root:FusedWord=0
        loop k in 0.. and f in cands {
            if not modules[FusedWord(fns.ptr[f].mod)].is_prelude {root += ws[k]}
        }
        if env("DEWY_PAR_TIME") not=? none {eprint("fused: weight {total}, root {root}")}
        let forced=env("DEWY_EMIT_FORCE") not=? none
        # (library-heavy programs, games among them, have many small functions that workers
        # would each lower to inline: there the code is made as before, emission alone in parallel)
        fz_layout=forced or root // 20000 >=? 2
        if not fz_layout or (env("DEWY_FUSED") ?? "") =? "0" {return false}
        let n=emit_workers()
        if pc_active {n=pc_workers}
        else if not forced {n=min(n root // 20000)}
        if n <? 2 or cands.length <? n {return false}
        # (closure layouts are settled by whichever function needs one first: settle them here)
        loop f in [1..fns.length) {
            if fns.ptr[f].kind =? FK_LAMBDA {env_layout(f)}
            else if fns.ptr[f].kind =? FK_PARTIAL {
                let offsets=partial_layout(FusedWord(fns.ptr[f].partial))
                fns.ptr[f].env_size=int32(offsets[offsets.length - 1])
            }
        }
        let cuts=[0]
        let acc:FusedWord=0
        loop k in [0..cands.length) {
            acc += ws[k]
            if acc * n >=? total * cuts.length and cuts.length <? n and k + 1 <? cands.length {cuts.push(k + 1)}
        }
        cuts.push(cands.length)
        let tm=env("DEWY_PAR_TIME") not=? none
        fz_lf0=lfuncs.length
        fz_r0=rodata.length
        fz_d0=data_size
        let ta=time()
        let pids:array<int64>=[]
        let fds:array<int64>=[]
        if pc_active {
            if pc_child >=? 0 {
                let mine:array<int64>=[]
                let next:FusedWord=0
                loop f in cands {
                    let owner=pc_owner.get(f) ?? -1
                    if owner <? 0 {
                        owner=next % pc_workers
                        next += 1
                    }
                    if owner =? pc_child {mine.push(f)}
                }
                if (env("DEWY_FUSED_FAIL_WORKER") ?? "") =? "{pc_child}" {exit(1)}
                fz_worker(mine 0 mine.length pc_emit)
            }
            pids=pc_pids
            fds=pc_fds
        }
        let nfork=if pc_active {0} else {cuts.length - 1}
        loop w in [0..nfork) {
            let pfd=ps_pipe(true)
            if pfd[0] <? 0 {
                pids.push(-1)
                fds.push(-1)
                continue
            }
            let rfd=pfd[0]
            let wfd=pfd[1]
            let pid=ps_fork()
            if pid =? 0 {
                ps_close(rfd)
                # (what a worker would say is said here, in order, when its functions are lowered here)
                # Speculative output is replayed by the parent; trace reports use the payload.
                let nullfd=syscall(2 data(__zstr("/dev/null")) 1 0)
                if env("DEWY_FUSED_TRACE") not=? none {
                    fz_trace_fd=syscall(319 data(__zstr("dewy-trace")) 0)
                    if fz_trace_fd >=? 0 {ps_close(nullfd) nullfd=fz_trace_fd}
                }
                if nullfd >=? 0 {
                    ps_dup2(nullfd 1)
                    ps_dup2(nullfd 2)
                    if nullfd not=? fz_trace_fd {ps_close(nullfd)}
                }
                __olen=0
                if (env("DEWY_FUSED_FAIL_WORKER") ?? "") =? "{w}" {exit(1)}
                fz_worker(cands cuts[w] cuts[w + 1] wfd)
            }
            ps_close(wfd)
            if pid <? 0 {
                ps_close(rfd)
                pids.push(-1)
                fds.push(-1)
            }
            else {
                pids.push(pid)
                fds.push(rfd)
            }
        }
        let tb=time()
        let got=fz_read_all(fds)
        let tc=time()
        fz_recs=[]
        fz_rd=[]
        fz_mlf=[]
        fz_mro=[]
        fz_mdt=[]
        fz_mrc=[]
        fz_kro=[]
        fz_kdt=[]
        fz_by_inst=[]
        fz_by_helper=[]
        fz_qrec=[]
        let lost=false
        loop w in [0..fds.length) {
            fz_rd.push(ParIn([]))
            fz_mlf.push([])
            fz_mro.push([])
            fz_mdt.push([])
            fz_mrc.push([])
            fz_kro.push([])
            fz_kdt.push([])
            if fds[w] <? 0 {
                lost=true
                continue
            }
            ps_close(fds[w])
            let st:array<int64>=[0]
            if pc_active {
                pc_fds[w]=-1
                st[0]=pc_reap(w)
            }
            else {
                let r:FusedWord=-4
                loop r =? -4 {r=ps_wait_into(pids[w] @st)}
                if r not=? pids[w] {st[0]=-1}
            }
            if st[0] & 0xFFFF not=? 0 or got[w].length <? 16 {
                lost=true
                continue
            }
            let trailer=ParIn(got[w] got[w].length - 8)
            if pr(@trailer) not=? 0x46555345 {
                lost=true
                continue
            }
            if env("DEWY_FUSED_TRACE") not=? none {
                let report_end=got[w].length - 16
                let report_reader=ParIn(got[w] report_end)
                let report_len=pr(@report_reader)
                eprint(__str_from_bytes(got[w][report_end - report_len..report_end)))
            }
            fz_parse(w got[w])
        }
        # (a partitioned check's worker that did not finish decided none of
        # its obligations: the parent decides them, with every body checked)
        if lost and pc_active and pc_static() {pc_facts_serial()}
        fz_validate()
        fz_ready=true
        if env("DEWY_FUSED_WHY") not=? none {
            let nt:FusedWord=0
            let nn:FusedWord=0
            let nc:FusedWord=0
            let na:FusedWord=0
            loop x in fz_recs {
                if not x.owned {nn += 1}
                else if x.taint {nt += 1}
                else if x.chunk <? 0 {nc += 1}
                else if not x.valid {na += 1}
            }
            eprint("fused: records {fz_recs.length}: not owned {nn}, tainted {nt}, no code {nc}, invalid {na}")
            loop x in fz_recs {
                if x.owned and x.lkind =? LK_INST and x.kind not=? 0 and not fz_small(x.ka) {eprint("  leaf not small: {fns.ptr[x.ka].sym} kind {x.kind} kids {nkids(FusedWord(fns.ptr[x.ka].body))} locals {fns.ptr[x.ka].locals.length} body {nodes.ptr[FusedWord(fns.ptr[x.ka].body)].kind}")}
            }
            loop x in fz_recs {
                if x.owned and x.taint and x.lkind =? LK_INST {eprint("  tainted {fns.ptr[x.ka].sym}")}
                if x.owned and not x.taint and x.chunk >=? 0 and not x.valid {
                    let bad:array<int64>=[]
                    loop f in x.assumed {
                        let o=fz_by_inst.get(f) ?? -1
                        if o <? 0 or fz_recs[o].kind not=? 0 {bad.push(f)}
                    }
                    let why=""
                    loop f in bad {
                        let o=fz_by_inst.get(f) ?? -1
                        let d=FusedWord(fns.ptr[f].decl)
                        let ext=d not=? 0 and has_flag(d NF_EXTERN)
                        let kind:FusedWord=-1
                        if o >=? 0 {kind=fz_recs[o].kind}
                        why="{why} {fns.ptr[f].sym}(owner {o} kind {kind} ext {ext} cand {fz_cand(f fz_pinit)})"
                    }
                    eprint("  invalid w{x.w} lf{x.lf} k{x.lkind}:{x.ka}: assumed {x.assumed.length} uses {x.uses.length} bad:{why}")
                }
            }
        }
        if tm {
            let valid:FusedWord=0
            loop r in fz_recs {
                if r.valid {valid += 1}
            }
            eprint("fused: {pids.length} workers, {cands.length} functions, fork {(tb - ta) * 1000.0} ms, waiting and reading {(tc - tb) * 1000.0} ms, parsing {(time() - tc) * 1000.0} ms, {fz_recs.length} records, {valid} valid")
        }
        true
    }
}
# everything the pipes give until each is closed, read as it comes
fz_read_all=(fds:array<int64>):>array<array<uint8>>=>$unsafe {
    let outs:array<array<uint8>>=[]
    if $target.os =? 'windows' {
        loop _ in fds {outs.push([])}
        return outs
    } else {
        let open:array<bool>=[]
        let left:FusedWord=0
        loop fd in fds {
            outs.push([])
            open.push(fd >=? 0)
            if fd >=? 0 {
                left += 1
                let fl=syscall(72 fd 3 0)
                syscall(72 fd 4 fl | 0x800);
            }
        }
        let pfds:array<int64>=fill(0 fds.length)
        loop left >? 0 {
            let idx:array<int64>=[]
            loop w in [0..fds.length) {
                if open[w] {
                    # struct pollfd: fd, events POLLIN (1), revents
                    pfds[idx.length]=(fds[w] & 0xFFFFFFFF) | (1 << 32)
                    idx.push(w)
                }
            }
            let r=ps_poll(@pfds idx.length (-1))
            if r <? 0 {continue}
            loop k in [0..idx.length) {
                if (pfds[k] >> 48) & 0xFFFF =? 0 {continue}
                let w=idx[k]
                loop true {
                    let n=outs[w].length
                    outs[w].resize(n + 262144)
                    let got=ps_read(fds[w] @outs[w] n 262144)
                    if got >? 0 {
                        outs[w].resize(n + got)
                        continue
                    }
                    outs[w].resize(n)
                    if got =? 0 or got not=? -11 {
                        open[w]=false
                        left -= 1
                    }
                    break
                }
            }
        }
        outs
    }
}
# ---- a worker ----
fz_worker=(cands:array<int64> a:FusedWord b:FusedWord fd:FusedWord):>void=>$unsafe {
    if env("DEWY_FUSED_FAIL") not=? none {exit(1)}
    let tw0=time()
    fz_lf0=lfuncs.length
    fz_r0=rodata.length
    fz_d0=data_size
    let f0=fns.length
    fzw_f0=fns.length
    fzw_t0=types.length
    fzw_g0=globals.length
    f0=fzw_f0
    let mine:array<int64>=[]
    loop k in [a..b) {mine.push(lf_of_inst(cands[k]))}
    fused_on=true
    loop lf in mine {fzw_lower(lf true)}
    # helpers they need: made here too (another worker may make the same one)
    let i=fz_lf0
    loop i <? lfuncs.length {
        if lfuncs.ptr[i].kind =? LK_HELPER and fzw_have.get(i) =? none {fzw_lower(i true)}
        i += 1
    }
    let recs=fzw_recs
    let have=fzw_have
    let tw1=time()
    # small functions they call that others make: lowered here only to be inlined
    let nown=recs.length
    let k:FusedWord=0
    loop k <? recs.length {
        let r=recs[k]
        if k >=? nown and r.kind not=? 2 {
            k += 1
            continue
        }
        loop ins in r.ir.code {
            if ins.op not=? 'call' or ins.c not=? 0 {continue}
            let g=int64(ins.imm)
            if have.get(g) not=? none or lfuncs.ptr[g].kind not=? LK_INST or not fz_canon(g) {continue}
            let fi=lfuncs.ptr[g].inst
            if fz_cand(fi fz_pinit) and fz_small(fi) {
                fzw_lower(g false)
                recs=fzw_recs
                have=fzw_have
            }
        }
        k += 1
    }
    let sent_taint=fill(false recs.length)
    let tw2=time()
    let out:array<uint8>=[]
    pw(@out recs.length)
    loop r in recs {
        let f=lfuncs.ptr[r.lf]
        pw(@out r.lf)
        pw(@out f.kind)
        if f.kind =? LK_INST {
            pw(@out f.inst)
            pw(@out 0)
            pw(@out 0)
        }
        else {
            pw(@out int64(f.hkind))
            pw(@out f.htype)
            pw(@out f.inst)
        }
        pw(@out if r.owned {1} else {0})
        # (a function that inlines one this worker could not map, or that might inline one
        # this worker does not have: its own record says which)
        let taint=r.taint
        let assumed:array<int64>=[]
        let uses:array<int64>=[]
        loop ins in r.ir.code {
            if ins.op not=? 'call' or ins.c not=? 0 {continue}
            let g=int64(ins.imm)
            let h=have.get(g)
            if h not=? none {
                if recs[h].taint {taint=true}
                uses.push(g)
                if recs[h].kind =? 2 {
                    loop ins2 in recs[h].ir.code {
                        if ins2.op not=? 'call' or ins2.c not=? 0 {continue}
                        let g2=int64(ins2.imm)
                        let h2=have.get(g2)
                        if h2 not=? none {
                            if recs[h2].taint {taint=true}
                            uses.push(g2)
                        }
                        else if lfuncs.ptr[g2].kind =? LK_INST and lfuncs.ptr[g2].inst <? f0 and fz_canon(g2) {assumed.push(lfuncs.ptr[g2].inst)}
                        else {taint=true}
                    }
                }
            }
            else if lfuncs.ptr[g].kind =? LK_INST and lfuncs.ptr[g].inst <? f0 and fz_canon(g) {assumed.push(lfuncs.ptr[g].inst)}
            else {taint=true}
        }
        pw(@out if taint {1} else {0})
        pw(@out r.kind)
        pw(@out r.j1 - r.j0)
        let k2=r.j0
        loop k2 <? r.j1 {
            let kind=fz_j[k2]
            loop d in [0..5) {pw(@out fz_j[k2 + d])}
            if kind =? 2 {fz_put_str(@out fz_texts[fz_j[k2 + 2]])}
            else if kind =? 5 {fz_put_str(@out fz_texts[fz_j[k2 + 3]])}
            else if kind =? 6 {
                let start=fz_j[k2 + 4]
                pw(@out fz_j[k2 + 3])
                loop q in [start..start + fz_j[k2 + 3]) {out.push(fz_raws[q])}
            }
            k2 += 5
        }
        pw_ints(@out assumed)
        pw_ints(@out uses)
        if r.owned and r.kind not=? 0 and not taint {
            pw(@out 1)
            fz_pack_ir(@out r.ir)
        }
        else {pw(@out 0)}
        sent_taint[have[r.lf]]=taint
    }
    # machine code: the owned functions
    let tw3=time()
    let q:array<IrFn>=[]
    loop r in recs {q.push(r.ir)}
    fast_inline_prepare(q)
    loop k3 in 0.. and r in recs {
        if not r.owned or sent_taint[k3] {
            pw(@out 0)
            continue
        }
        ir=q[k3]
        let c0=call_fix.length
        let d0=data_fix.length
        let s0=stub_fix.length
        let l0=line_rows.length
        let cs0=call_sites.length
        let e0=elf_syms.length
        let ro0=fz_ro.length
        let u0=rsp_rows.length
        emit_now(false)
        let start=fn_addr[r.lf]
        pw(@out 1)
        pw(@out code.length - start)
        out.extend(code[start..code.length))
        pw(@out call_fix.length - c0)
        loop x in call_fix[c0..call_fix.length) {
            pw(@out x[0] - start)
            pw(@out x[1])
        }
        pw(@out data_fix.length - d0)
        loop x in data_fix[d0..data_fix.length) {
            pw(@out x[0] - start)
            pw(@out x[1])
            pw(@out x[2])
        }
        pw(@out stub_fix.length - s0)
        loop x in stub_fix[s0..stub_fix.length) {
            pw(@out x[0] - start)
            pw(@out x[1])
        }
        pw(@out (line_rows.length - l0) // 2)
        let k4=l0
        loop k4 <? line_rows.length {
            pw(@out line_rows[k4] - start)
            pw(@out ir_positions[line_rows[k4 + 1]])
            k4 += 2
        }
        pw(@out (call_sites.length - cs0) // 2)
        k4=cs0
        loop k4 <? call_sites.length {
            pw(@out call_sites[k4] - start)
            pw(@out ir_positions[call_sites[k4 + 1]])
            k4 += 2
        }
        pw(@out (fz_ro.length - ro0) // 2)
        loop x in fz_ro[ro0..fz_ro.length) {pw(@out x)}
        pw(@out (rsp_rows.length - u0) // 2)
        k4=u0
        loop k4 <? rsp_rows.length {
            pw(@out rsp_rows[k4] - start)
            pw(@out rsp_rows[k4 + 1])
            k4 += 2
        }
        if elf_syms.length =? e0 {pw(@out 0)}
        else {pw(@out 1)}
    }
    if env("DEWY_FUSED_TRACE") not=? none {
        __out_flush()
        let trace=""
        if fz_trace_fd >=? 0 {
            syscall(8 fz_trace_fd 0 0);
            trace=__str_from_bytes(par_read(fz_trace_fd))
        }
        let report="{trace}  fused worker {a}..{b}: lower {(tw1 - tw0) * 1000.0} ms, others {(tw2 - tw1) * 1000.0} ms ({recs.length - nown}), pack {(tw3 - tw2) * 1000.0} ms, emit {(time() - tw3) * 1000.0} ms, {out.length} bytes"
        let raw=report as array<uint8>
        out.extend(raw)
        pw(@out raw.length)
    }
    pw(@out 0x46555345)
    __olen=0
    __write_fd(fd data(out) out.length)
    exit(0)
}
# in the lowering loop: lf made by a worker (journal replayed, code to join later)
fz_replay=(lf:FusedWord):>bool=>$unsafe {
    let f=lfuncs.ptr[lf]
    let k:FusedWord=-1
    if not fz_canon(lf) {return false}
    if f.kind =? LK_INST {k=fz_by_inst.get(f.inst) ?? -1}
    else {k=fz_by_helper.get(fz_hkey(int64(f.hkind) f.htype f.inst)) ?? -1}
    if k <? 0 or not fz_recs[k].valid {return false}
    let x=fz_recs[k]
    let t:FusedWord=0
    let rw:FusedWord=0
    let raw_par:array<int64>=[]
    let e:FusedWord=0
    loop e <? x.ents.length {
        let kind=x.ents[e]
        let local=x.ents[e + 1]
        let a=x.ents[e + 2]
        let b=x.ents[e + 3]
        let c=x.ents[e + 4]
        if kind =? 0 {
            let got=lf_of_inst(a)
            fz_mlf[x.w][local]=got
        }
        else if kind =? 1 {
            let got=lf_helper(a as HK b c)
            fz_mlf[x.w][local]=got
        }
        else if kind =? 2 {
            let got=str_data(x.texts[t])
            fz_mro[x.w][local]=got
            t += 1
        }
        else if kind =? 3 {
            let got=global_addr_off(a)
            fz_mdt[x.w][local]=got
            if mt_active_off <? 0 {
                let s=prelude.get(intern("__mt_active")) ?? 0
                if s not=? 0 and syms.ptr[s].kind =? 'global' and FusedWord(syms.ptr[s].ref) =? a {mt_active_off=fz_mdt[x.w][local]}
            }
        }
        else if kind =? 4 {
            let got=box_dflt_off(a)
            fz_mro[x.w][local]=got
        }
        else if kind =? 5 {
            warn(a x.texts[t])
            t += 1
        }
        else if kind =? 7 {
            det_check(FusedWord(nodes.ptr[a].sym) kids(a) nodes.ptr[a].pos)
        }
        else if kind =? 6 {
            loop rodata.length % a not=? 0 {rodata.push(0)}
            let o=rodata.length
            ro_starts.push(o)
            loop v in x.raws[rw] {rodata.push(v)}
            rw += 1
            fz_mro[x.w][local]=o
            raw_par.push(o)
        }
        e += 5
    }
    fz_recs[k].raw_par=raw_par
    ir=IrFn(name=f.name fn_index=lf)
    emit_queue.push(ir)
    emit_queue_rel.push(false)
    fz_qrec[lf]=k
    true
}
fz_place=(x:FzRec lf:FusedWord):>void=>$unsafe {
    let w=x.w
    fz_rd[w].i=x.chunk
    loop code.length % 64 not=? 0 {code.push(0xCC)}
    let base=code.length
    loop fn_addr.length <=? lf {fn_addr.push(-1)}
    loop fn_len.length <=? lf {fn_len.push(0)}
    let nc=pr(@fz_rd[w])
    fn_addr[lf]=base
    fn_len[lf]=nc
    let at=fz_rd[w].i
    code.extend(fz_rd[w].b[at..at + nc))
    fz_rd[w].i += nc
    let calls:array<[int64 int64]>=[]
    loop _ in [0..pr(@fz_rd[w])) {
        let p=pr(@fz_rd[w])
        calls.push([base + p pr(@fz_rd[w])])
    }
    let datas:array<[int64 int64 int64]>=[]
    loop _ in [0..pr(@fz_rd[w])) {
        let p=pr(@fz_rd[w])
        let kind=pr(@fz_rd[w])
        datas.push([base + p kind pr(@fz_rd[w])])
    }
    loop _ in [0..pr(@fz_rd[w])) {
        let p=pr(@fz_rd[w])
        stub_fix.push([base + p pr(@fz_rd[w])])
    }
    loop _ in [0..pr(@fz_rd[w])) {
        let p=pr(@fz_rd[w])
        line_rows.push(base + p)
        line_rows.push(fz_pos(pr(@fz_rd[w])))
    }
    loop _ in [0..pr(@fz_rd[w])) {
        let p=pr(@fz_rd[w])
        call_sites.push(base + p)
        call_sites.push(fz_pos(pr(@fz_rd[w])))
    }
    loop _ in [0..pr(@fz_rd[w])) {
        let bits=pr(@fz_rd[w])
        let off=pr(@fz_rd[w])
        let got=ro_const(bits)
        fz_mrc[x.w][off]=got
    }
    loop _ in [0..pr(@fz_rd[w])) {
        let p=pr(@fz_rd[w])
        rsp_rows.push(base + p)
        rsp_rows.push(pr(@fz_rd[w]))
    }
    if pr(@fz_rd[w]) not=? 0 {elf_syms.push([sym_name(lfuncs.ptr[lf].name) base nc])}
    loop c in calls {call_fix.push([c[0] fz_map_lf(x.w c[1])])}
    loop d in datas {
        let off=d[2]
        if d[1] =? 0 {
            let v=fz_mrc[x.w].get(off)
            if v not=? none {off=v}
            else {off=fz_map_in(x.w 0 off fz_r0)}
        }
        else if d[1] =? 1 {off=fz_map_in(x.w 1 off fz_d0)}
        data_fix.push([d[0] d[1] off])
    }
}

use 'checker_state.dewy'
use 'expr.jo'
use 'lex.jo'
use 'util.jo'
use 'checker_tokens.dewy'
use 'refinement_types.dewy'
use 'ast.jo'
use 'check.jo'
use 'types.jo'
use 'facts.jo'
use 'ownership.jo'
use 'refine.jo'
# Demand-only summaries for small, closed Boolean expressions. The accepted
# grammar has no calls, writes, narrowing or cleanup. Scalar array reads keep
# their captured array/index identities; they do not assert an index is valid.
# Each cached tree has at most 32 nodes; construction and instantiation are
# O(32 + params), plus the existing bounded projection lookup per element.
# Leaves are parameter ordinals, never callee storage or caller syntax.
struct FactPredicate:
    op: Tok = .eof
    parameter: int = -1
    literal: int = 0
    a: int = 0
    b: int = 0
    length: bool = false
    element: int = 0

fact_predicate_nodes = [FactPredicate()]
fact_predicates: {int: int} = {}

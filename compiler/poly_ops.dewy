$runtime_checks
from p"ast.jo" import (NF_CHECKED NF_MUT add_flag clone has_flag kid mk nkids nodes set_list)
from p"check.jo" import (FK_LAMBDA LF_PARAM LF_UNNARROWED check_lambda_body check_scopes copy_write_warnings ctxs cur_mod cx decl_info decl_infos fn_instances fns locals loop_serials narrowed_var new_inst new_local new_sym push_scope_sym push_type_params scope_mark scope_reset subst syms syntactic_void zonk_tree)
from p"checker_expr.dewy" import (check_expr)
from p"checker_signature.dewy" import (fn_sig)
from p"checker_state.dewy" import (FnCtx FnInstanceKey)
from p"checker_types.dewy" import (TypeInfo)
from p"dewy_methods.jo" import (dewy_is_method)
from p"effect_contracts.dewy" import (mk_callable_contract)
from p"expr.jo" import (dewy_literal_method_name finalize_literal fn_value match_type mk_ident_local opt_rest_rebase)
from p"lower_storage.dewy" import (check_cell_type is_shared store_type)
from p"poly_closure.jo" import (PolyActivation PolyDefaultKey PolyFamily PolyScope poly_defaults poly_families poly_pending_warnings)
from p"types.jo" import (T_VOID align_up decl_fn_labels has_var mk_fn mk_type talign targ tkind tsize types zonk)
from p"util.jo" import (fatal intern name_of pl_inst_decls pl_on)

PolyWord:type=int64<overflow='wrap'>
poly_scope=():>PolyScope=>$unsafe {
    let scope=PolyScope(loops=loop_serials)
    let chain:array<int64>=[]
    let c=cx
    loop c >=? 0 {
        chain.push(c)
        c=PolyWord(ctxs[c].parent)
    }
    loop i in [0..chain.length) {scope.frames.push(ctxs[chain[chain.length - 1 - i]])}
    let frozen=dict<int64 int64>()
    loop i in [PolyWord(ctxs[cx].floor)..check_scopes.names.length) {
        let name=check_scopes.names[i]
        if check_scopes.top[name] not=? i {continue}
        let symbol=check_scopes.syms[i]
        if syms.ptr[symbol].kind =? 'local' and narrowed_var(PolyWord(syms.ptr[symbol].ref)) not=? 0 {
            let local=poly_freeze_narrowing(PolyWord(syms.ptr[symbol].ref) @frozen)
            symbol=new_sym(name 'local' local PolyWord(syms.ptr[symbol].decl))
        }
        scope.names.push(name)
        scope.symbols.push(symbol)
    }
    scope
}
# Append an isolated lexical frame to the caller's ordinary scope stack. Saving
# the dense name lookup table would trigger whole-table COW on every family.
# These bindings instead pop normally; callers' names below the floor are hidden.
poly_enter=(family:PolyWord):>PolyActivation=>{
    let saved=PolyActivation(cx ctxs.length scope_mark() loop_serials)
    let scope=poly_families[family].scope
    let parent:PolyWord=-1
    loop original in scope.frames {
        let frame=original
        frame.parent=int32(parent)
        frame.floor=int32(saved.mark)
        ctxs.push(frame)
        parent=ctxs.length - 1
    }
    cx=parent
    loop i in [0..scope.names.length) {push_scope_sym(scope.names[i] scope.symbols[i])}
    loop_serials=scope.loops
    saved
}
poly_leave=(saved:PolyActivation):>void=>{
    scope_reset(saved.mark)
    ctxs.truncate(saved.frames)
    cx=saved.current
    loop_serials=saved.loops
}
check_poly_lambda=(lam:int64 expected:int64):>int64=>$unsafe {
    # Keep the declaration separate from the expression, which contextual
    # selection may rewrite to a concrete function value.
    # Syntax children stay immutable here; concrete instances clone the body.
    # Copying that whole tree once more at family creation adds no isolation.
    let d=nodes.length
    nodes.push(nodes.ptr[lam])
    nodes.ptr[d].sym=0
    nodes.ptr[d].mod=int32(cur_mod())
    nodes.ptr[d].name=int32(intern("lambda"))
    let family=poly_families.length
    let env=new_inst(FK_LAMBDA cur_mod() "generic_environment")
    fns.ptr[env].decl=int32(d)
    fns.ptr[env].target=int32(family)
    fns.ptr[env].state=2
    fns.ptr[env].ret=int32(T_VOID)
    poly_families.push(PolyFamily(d env poly_scope()))
    nodes.ptr[d].aux=int32(family)
    let frame=cx
    loop frame >=? 0 {
        poly_pending_warnings[PolyWord(ctxs[frame].inst)]=true
        frame=PolyWord(ctxs[frame].parent)
    }
    fn_sig(d);
    nodes.ptr[lam].aux=int32(family)
    let t=mk_type(TypeInfo(kind='polyfn' st=int32(family)) [])
    nodes.ptr[lam].type=int32(t)
    if expected not=? 0 and tkind(expected) =? 'fn_' {
        let source=nodes.length
        nodes.push(nodes.ptr[lam])
        return fn_value(lam expected closure=source)
    }
    t
}
poly_inst=(decl:PolyWord targs:array<int64> use_pos:PolyWord):>PolyWord=>$unsafe {
    let zs:array<int64>=[]
    loop t in targs {
        let z=zonk(t)
        if has_var(z) {fatal(use_pos "cannot infer a generic closure's type argument; give its argument or result a type")}
        zs.push(z)
    }
    let key=FnInstanceKey(decl zs)
    let found=fn_instances.get(key)
    if found not=? none {
        let f:PolyWord=found
        if fns.ptr[f].ret =? 0 {
            # (called again while its body is checked: one returning no value is void,
            # as a recursive function is)
            if fns.ptr[f].state =? 1 and syntactic_void(PolyWord(nodes.ptr[decl].b)) {
                fns.ptr[f].ret=int32(T_VOID)
                fns.ptr[f].aux_void=true
                fns.ptr[f].fntype=int32(mk_fn(fns.ptr[f].ptypes T_VOID PolyWord(fn_sig(decl).mutmask) decl_fn_labels(decl)))
                return f
            }
            if dewy_is_method(decl) and dewy_literal_method_name not=? 0 {fatal(use_pos "recursive method '{name_of(dewy_literal_method_name)}' needs an explicit return type (add `:>Type`)")}
            fatal(use_pos "a recursive generic closure needs an explicit return type")
        }
        return f
    }
    let family=PolyWord(nodes.ptr[decl].aux)
    let f=new_inst(FK_LAMBDA PolyWord(nodes.ptr[decl].mod) "generic_lambda")
    fns.ptr[f].decl=int32(decl)
    fns.ptr[f].target=int32(family)
    fns.ptr[f].has_env=true
    fns.ptr[f].targs=zs
    fns.ptr[f].use_pos=use_pos
    if cx >=? 0 {
        let caller=PolyWord(ctxs[cx].inst)
        fns.ptr[f].made_in=int32(caller)
        if caller >? 0 and fns.ptr[caller].targs.length >? 0 {
            fns.ptr[f].gdepth=fns.ptr[caller].gdepth + 1
            if fns.ptr[f].gdepth >? 500 {fatal(use_pos "generic closures expand without end (more than 500 specializations deep)")}
        }
    }
    let sig=fn_sig(decl)
    loop pt in sig.params {fns.ptr[f].ptypes.push(subst(pt zs))}
    if sig.ret not=? 0 {
        fns.ptr[f].ret=int32(subst(int64(sig.ret) zs))
        # A recursive call (through the object of a record literal's method, or
        # a parameter) selects this instance before its body is checked.
        fns.ptr[f].fntype=int32(mk_fn(fns.ptr[f].ptypes PolyWord(fns.ptr[f].ret) int64(sig.mutmask) decl_fn_labels(decl)))
    }
    if pl_on {pl_inst_decls.push(decl)}
    fns.ptr[f].body=int32(clone(PolyWord(nodes.ptr[decl].b)))
    fn_instances[key]=f
    decl_infos[decl_info(poly_families[family].decl)].insts.push(f)
    let saved=poly_enter(family)
    check_lambda_body(f decl PolyWord(fns.ptr[f].ret))
    let zp:array<int64>=[]
    loop pt in fns.ptr[f].ptypes {zp.push(zonk(pt))}
    fns.ptr[f].ptypes=zp
    fns.ptr[f].ret=int32(zonk(PolyWord(fns.ptr[f].ret)))
    if fns.ptr[f].aux_void and tkind(PolyWord(fns.ptr[f].ret)) not=? 'void_' {
        if dewy_is_method(decl) and dewy_literal_method_name not=? 0 {fatal(nodes.ptr[decl].pos "recursive method '{name_of(dewy_literal_method_name)}' returns a value; add an explicit return type (`:>Type`)")}
        fatal(nodes.ptr[decl].pos "a recursive generic closure that returns a value needs an explicit return type")
    }
    zonk_tree(PolyWord(fns.ptr[f].body))
    loop l in fns.ptr[f].locals {locals.ptr[l].type=int32(zonk(PolyWord(locals.ptr[l].type)))}
    fns.ptr[f].fntype=int32(mk_fn(zp PolyWord(fns.ptr[f].ret) int64(sig.mutmask) decl_fn_labels(decl)))
    if sig.contract not=? 0 {fns.ptr[f].fntype=int32(mk_callable_contract(PolyWord(fns.ptr[f].fntype) int64(sig.contract)))}
    poly_leave(saved)
    f
}
poly_fnref=(source:PolyWord f:PolyWord):>PolyWord=>$unsafe {
    let n=mk('fnref' nodes.ptr[source].pos)
    nodes.ptr[n].a=int32(source)
    nodes.ptr[n].sym=int32(f)
    nodes.ptr[n].aux=2
    nodes.ptr[n].type=fns.ptr[f].fntype
    add_flag(n NF_CHECKED)
    n
}
poly_matches=(from_:PolyWord to:PolyWord):>bool=>$unsafe {
    let family=PolyWord(types.ptr[from_].st)
    let sig=fn_sig(poly_families[family].decl)
    if sig.params.length not=? PolyWord(types.ptr[to].nargs) or sig.mutmask not=? types.ptr[to].mutmask {return false}
    let binds:array<int64>=fill(0 int64(sig.ntp))
    loop i in [0..sig.params.length) {
        let r=match_type(sig.params[i] targ(to i) @binds 0)
        if r <? 0 or r =? 1 {return false}
    }
    if sig.ret not=? 0 {
        if match_type(int64(sig.ret) PolyWord(types.ptr[to].elem) @binds 0) <? 0 {return false}
    }
    loop b in binds {
        if b =? 0 {return false}
    }
    true
}
# All source specializations have been checked before lowering. Union captures
# by lexical binding, including effects discovered by later specializations.
# Each concrete body retains its own local IDs but uses the same field offsets.
poly_env_layout=(family:PolyWord):>void=>$unsafe {
    let env=poly_families[family].envfn
    if fns.ptr[env].env_size not=? 0 {return}
    let instances=decl_infos[decl_info(poly_families[family].decl)].insts
    let canonical=dict<int64 int64>()
    loop f in instances {
        loop cap in fns.ptr[f].caps {
            let outer=int64(cap.outer)
            let inner=int64(cap.inner)
            let first=canonical.get(outer)
            if first not=? none {
                locals.ptr[first].flags |= locals.ptr[inner].flags
            }
            else {
                canonical[outer]=inner
                fns.ptr[env].caps.push(cap)
            }
        }
    }
    let off:PolyWord=24
    loop cap in fns.ptr[env].caps {
        let inn=int64(cap.inner)
        if is_shared(inn) {check_cell_type(inn)}
        let t=store_type(inn)
        off=align_up(off max(8 talign(t)))
        locals.ptr[inn].env_off=int32(off)
        off += tsize(t)
    }
    fns.ptr[env].env_size=int32(align_up(off 8))
    loop f in instances {
        fns.ptr[f].env_size=fns.ptr[env].env_size
        loop cap in fns.ptr[f].caps {
            let first=canonical[int64(cap.outer)]
            let inner=int64(cap.inner)
            locals.ptr[inner].flags |= locals.ptr[first].flags
            locals.ptr[inner].env_off=locals.ptr[first].env_off
        }
    }
}
poly_finish_warnings=():>void=>{
    let pending:array<int64>=[]
    loop [f active] in poly_pending_warnings {
        if active {pending.push(f)}
    }
    loop f in pending {
        poly_pending_warnings[f]=false
        copy_write_warnings(f)
    }
}
# Defaults execute in the selected closure, after explicit arguments, so their
# lexical names refer to this environment and earlier value parameters. A
# cached declaration variant omits the supplied-at-runtime parameters' defaults
# and initializes missing parameters in the ordinary body binding prefix.
poly_default_variant=(decl:PolyWord args:array<int64>):>PolyWord=>$unsafe {
    let omitted:array<int64>=[]
    loop i in [0..args.length) {
        if args[i] =? 0 {omitted.push(i)}
    }
    if omitted.length =? 0 {return decl}
    let key=PolyDefaultKey(decl omitted)
    let cached=poly_defaults.get(key)
    if cached not=? none {return cached}
    let variant=clone(decl)
    nodes.ptr[variant].mod=nodes.ptr[decl].mod
    let sig=fn_sig(decl)
    sig.params=[]
    sig.mutmask=0
    let params:array<int64>=[]
    let body=PolyWord(nodes.ptr[variant].b)
    let prefix:array<int64>=[]
    # The projection's synthetic bindings are a contiguous prefix, one per
    # ordinary named value parameter. Retain their order and replace only a
    # missing parameter's binding with its actual default expression.
    let at:PolyWord=0
    loop i in [0..nkids(decl)) {
        let p=kid(variant i)
        let supplied=args[i] not=? 0
        if supplied {
            if has_flag(p NF_MUT) {sig.mutmask |= int32(1 << params.length)}
            params.push(p)
            sig.params.push(fn_sig(decl).params[i])
        }
        let binding:PolyWord=0
        if not has_flag(p NF_MUT) and name_of(PolyWord(nodes.ptr[p].name)) not=? "_" {
            binding=kid(body at)
            at += 1
        }
        if not supplied {
            if binding =? 0 {
                binding=mk('vardecl' nodes.ptr[p].pos)
                nodes.ptr[binding].name=nodes.ptr[p].name
            }
            let default_value=clone(PolyWord(nodes.ptr[p].b))
            nodes.ptr[binding].b=int32(default_value)
            nodes.ptr[binding].a=nodes.ptr[p].a
            nodes.ptr[binding].aux2=0
        }
        if binding not=? 0 {prefix.push(binding)}
    }
    loop i in [at..nkids(body)) {prefix.push(kid(body i))}
    set_list(body prefix)
    set_list(variant params)
    decl_infos[decl_info(variant)].sig=sig
    poly_defaults[key]=variant
    variant
}
# Only used to infer the type of an omitted unannotated parameter. Runtime
# evaluation belongs to poly_default_variant, never the caller's lexical scope.
poly_default_type=(decl:PolyWord i:PolyWord targs:array<int64>):>PolyWord=>$unsafe {
    let saved=poly_enter(PolyWord(nodes.ptr[decl].aux))
    let mark=scope_mark()
    # A nonliteral default can refer to earlier parameters (y=x+1). Give
    # inference its own temporary owner, never locals in the enclosing function.
    let owner=new_inst(FK_LAMBDA PolyWord(nodes.ptr[decl].mod) "default_type")
    fns.ptr[owner].state=2
    fns.ptr[owner].ret=int32(T_VOID)
    fns.ptr[owner].targs=targs
    if saved.current >=? 0 {
        let caller=PolyWord(ctxs[saved.current].inst)
        if caller >? 0 {
            fns.ptr[owner].gdepth=fns.ptr[caller].gdepth
            fns.ptr[owner].made_in=int32(caller)
        }
    }
    let parent=cx
    ctxs.push(FnCtx(int32(owner) int32(parent) int32(T_VOID) false 0 nodes.ptr[decl].mod ctxs[parent].floor))
    cx=ctxs.length - 1
    push_type_params(decl targs)
    let sig=fn_sig(decl)
    loop j in [0..i) {
        let p=kid(decl j)
        let l=new_local(PolyWord(nodes.ptr[p].name) subst(sig.params[j] targs) nodes.ptr[p].pos)
        locals.ptr[l].flags=int32(LF_PARAM)
    }
    let d=clone(PolyWord(nodes.ptr[kid(decl i)].b))
    check_expr(d 0);
    finalize_literal(d);
    scope_reset(mark)
    poly_leave(saved)
    d
}
# Narrowed aliases are flow facts, not mutable captured state. Freeze just this
# alias chain; the underlying binding stays canonical so capture effects merge.
poly_freeze_narrowing=(l:PolyWord @frozen:dict<int64 int64>):>PolyWord=>$unsafe {
    let known=frozen.get(l)
    if known not=? none {return known}
    let outer=narrowed_var(l)
    if outer =? 0 {return l}
    let base=poly_freeze_narrowing(outer @frozen)
    if PolyWord(locals.ptr[l].flags) & LF_UNNARROWED not=? 0 {return base}
    let alias:PolyWord=0
    if nodes.ptr[PolyWord(locals.ptr[l].alias)].kind =? 'if_' {alias=opt_rest_rebase(PolyWord(locals.ptr[l].alias) base PolyWord(locals.ptr[l].pos))}
    else {
        alias=nodes.length
        nodes.push(nodes.ptr[PolyWord(locals.ptr[l].alias)])
        let base_ident=mk_ident_local(base locals.ptr[l].pos)
        nodes.ptr[alias].a=int32(base_ident)
    }
    let copy=locals.ptr[l]
    copy.alias=int32(alias)
    locals.push(copy)
    let result=locals.length - 1
    frozen[l]=result
    result
}

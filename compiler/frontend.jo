use 'dewy_direct.jo'
# Source-language dispatch. The C bootstrap substitutes bootstrap/frontend.jo.
use 'util.jo'
use 'ast.jo'
use 'parse.jo'
use 'dewy_parse.jo'
use 'dewy_fast.jo'
use 'directives.jo'
use 'dewy_directives.jo'

source_declarations = (file: int) -> int[]:
    if files[file].is_dewy:
        dw_index_context = []
        first = nodes.len()
        decls = dewy_fast_file(file)
        i = nodes.len() - 1
        loop i >= first:
            if nodes[i].kind == .loopx:
                lowered = desugar_loopx(i)
                nodes[i] = nodes[lowered]
            i -= 1
        dir_apply_rows(first)
        return decls
    parse_file(file)

# The prompt uses the same quote scanner, accepting an unfinished input.
source_quote_end = (text: str, start: int, raw: bool) -> int:
    dn_quote_end(text, start, len(text), 0, raw, true)

source_force_body = (decl: int): dc_force_body(decl)

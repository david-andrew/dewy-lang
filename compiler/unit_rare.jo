# A conservative denominator multiple, demanded only by a time grid check.
time_grid_denominator = (n: int, depth: int = 0) -> int:
    if n == 0 or depth > 16 or is_float(quantity_base(ntype(n))): return 0
    if is_int(quantity_base(ntype(n))): return 1
    constant = quantity_constant_scale(n)
    if constant >= 0:
        den = quantity_scales[constant].denominator
        return if 1000000000%den == 0: den else: 0
    if nodes[n].kind == .conv and (nodes[n].aux == i32(int(CV.none_)) or nodes[n].aux == i32(int(CV.quantity_const))): return time_grid_denominator(int(nodes[n].a), depth+1)
    if nodes[n].kind != .call or nodes[n].sym <= 0: return 0
    d = int(fns[int(nodes[n].sym)].decl)
    if d == 0 or files[pos_file(nodes[d].pos)].path != "{lib_dir}/rational.dewy": return 0
    name = name_of(int(nodes[d].name))
    if name == "rational" and nkids(n) == 2:
        known, den = integer_constant(kid(n, 1))
        if known and den > 0 and den <= 1000000000 and 1000000000%den == 0: return den
        return 0
    if name == "__unary_sub__" and nkids(n) == 1: return time_grid_denominator(kid(n, 0), depth+1)
    if nkids(n) != 2 or not (name in ["__mul__", "__add__", "__sub__"]): return 0
    a = time_grid_denominator(kid(n, 0), depth+1)
    b = time_grid_denominator(kid(n, 1), depth+1)
    if a == 0 or b == 0: return 0
    if a > 1000000000/b: return 0
    den = a*b
    if 1000000000%den == 0: den else: 0
time_grid_proven = (validator: int, n: int) -> bool:
    name_of(int(nodes[validator].name)) in ["_grid_error", "_grid_only"] and files[pos_file(nodes[validator].pos)].path == "{lib_dir}/time/core.dewy" and quantity_dimension(ntype(n)) == base_dimension(0) and time_grid_denominator(n) > 0

# The time library's own type by name, as a program sees it (0 when t is another type).
time_core_type = (t0: int, name: str) -> bool:
    t = prune(t0)
    if types[t].kind != .struct_: return false
    d = int(structs[int(types[t].st)].decl)
    d != 0 and structs[int(types[t].st)].name == name and files[pos_file(nodes[d].pos)].path == lib_dir + "/time/core.dewy"
# A constant time meets a `Duration` directly (time.md: "they mix"), so it is one where a `Duration` is
# wanted: `let total:Duration = 0s`. A time known only at run time goes through `convert<Duration>`.
time_constant_duration = (n: int, from: int, to: int) -> bool:
    n != 0 and types[prune(from)].kind == .quantity and quantity_dimension(prune(from)) == base_dimension(0) and time_core_type(to, "Duration") and not is_float(quantity_base(prune(from))) and quantity_constant_scale(n) >= 0
# (`d*1day` next to a quantity: what a calendar period is, for an operator's error)
calendar_period_why = (a: int, b: int) -> str:
    if time_core_type(ntype(a), "Days") or time_core_type(ntype(b), "Days"): return " (`1day` and `1week` are calendar periods, whose length depends on the date, so they add to dates and zoned times: for a length of time write `24hour`, or `7*24hour`)"
    if time_core_type(ntype(a), "Months") or time_core_type(ntype(b), "Months"): return " (`1month` and `1year` are calendar periods, whose length depends on the date, so they add to dates and zoned times: for a length of time write the hours it means, such as `30*24hour`)"
    ""
# (`0s` with a local `s`: what a unit written against a number means here, for an operator's error)
shadowed_unit_in = (x: int) -> int:
    k = nodes[x].kind
    if k == .binary:
        if has_flag(x, NF_JUXT) and (nodes[int(nodes[x].a)].kind == .int_lit or nodes[int(nodes[x].a)].kind == .float_lit):
            v = int(nodes[x].b)
            if nodes[v].kind == .ident and nodes[v].aux == i32(int(SK.local)) and universe.has(int(nodes[v].name)): return v
            return 0
        left = shadowed_unit_in(int(nodes[x].a))
        if left != 0: return left
        return shadowed_unit_in(int(nodes[x].b))
    0
hidden_unit_why = (n: int, a: int, b: int) -> str:
    found = shadowed_unit_in(a)
    if found == 0: found = shadowed_unit_in(b)
    if found != 0:
        ln, c = line_col(locals[int(nodes[found].sym)].pos)
        nm = name_of(int(nodes[found].name))
        return " (`{nm}` in a product with a number is your variable from line {ln} (type {dt(ntype(found))}), which hides the unit `{nm}`: rename the variable to use the unit)"
    if not has_flag(n, NF_JUXT) or nodes[a].kind != .int_lit and nodes[a].kind != .float_lit or nodes[b].kind != .ident or nodes[b].aux != i32(int(SK.local)) or is_numeric(ntype(b)): return ""
    made = locals[int(nodes[b].sym)].pos
    ln, c = line_col(made)
    nm = name_of(int(nodes[b].name))
    " (`{nm}` here is the local variable made on line {ln}, a {dt(ntype(b))}, which hides any unit named `{nm}`: rename the variable to use the unit)"

register_quantity_names = ():
    loop i in [0..8):
        dim = base_dimension(i)
        nm = intern(quantity_dimension_names[i])
        universe[nm] = new_sym(nm, .type_, mk_dimension(dim), 0)
    # Time is prelude surface. Other unit values live in units.dewy.
    loop item in [("s", 1, 1), ("second", 1, 1), ("seconds", 1, 1),
        ("ms", 1, 1000), ("millisecond", 1, 1000), ("milliseconds", 1, 1000),
        ("us", 1, 1000000), ("microsecond", 1, 1000000), ("microseconds", 1, 1000000),
        ("ns", 1, 1000000000), ("nanosecond", 1, 1000000000), ("nanoseconds", 1, 1000000000),
        ("minute", 60, 1), ("hour", 3600, 1)]:
        nm = intern(item.0)
        n = mk(.unit_lit, 0)
        nodes[n].ival = item.1
        nodes[n].aux = i32(item.2)
        nodes[n].aux2 = 1
        globals.push(Global(name = i32(nm), is_const = true, init = i32(n), state = 2))
        universe[nm] = new_sym(nm, .const_, globals.len() - 1, 0)

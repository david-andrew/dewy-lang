use 'checker_state.dewy'
use 'checker_expr.dewy'
use 'checker_tokens.dewy'
use 'ast.jo'
use 'types.jo'
use 'type_ops.dewy'
use 'check.jo'
use 'expr.jo'
use 'lex.jo'
use 'util.jo'
use 'diagnostic_exit.dewy'
use 'node_store.dewy'
use 'secrets.jo'

secret_type_sym = (k: SK) -> bool: k == .struct_ or k == .enum_ or k == .alias_ or k == .type_

secret_hide_checks = (n: int):
    let n = n
    loop nodes[n].kind == .conv:
        if nodes[n].aux == i32(int(CV.refinement)): secret_checks[n] = true
        n = int(nodes[n].a)

secret_reveal = (s: int):
    t = prune(ntype(s))
    if types[t].kind != .secret: return
    wrap_conv(s, CV.none_, prune(int(types[t].elem)))

secret_wrap = (n: int, t: int) -> int:
    st = mk_secret(t)
    wrap_conv(n, CV.none_, st)
    st

secret_member = (n: int, bt: int) -> int:
    a = int(nodes[n].a)
    fname = name_of(int(nodes[n].name))
    if int(nodes[n].name) != secret_reveal_name:
        what = "x"
        if nodes[a].kind == .ident: what = name_of(int(nodes[a].name))
        fatal(nodes[n].pos, "a {dt(bt)} has no member '{fname}': its value is hidden (`{what}.reveal.{fname}` uses its value, where using it is intended)")
    et = prune(int(types[bt].elem))
    nodes[n] = Node(kind = .conv, pos = nodes[n].pos, a = i32(a), aux = i32(int(CV.none_)), type = i32(et), flags = i32(NF_CHECKED))
    last_checked = n
    et

secret_binary = (n: int, op: Tok, a: int, b: int) -> int:
    secret_reveal(a)
    secret_reveal(b)
    t = check_expr(n, 0)
    if op == .eq or op == .ne:
        at = prune(ntype(a))
        k = tkind(at)
        if k == .str_ or k == .array or k == .fixed or k == .struct_ or k == .tuple:
            secret_compares[n] = true
            runtime_fn("__ct_str_eq")
        if at == T_MATH_INT:
            secret_compares[n] = true
            runtime_fn("__mi_ct_compare")
        return t
    if op == .lt or op == .le or op == .gt or op == .ge:
        if tkind(prune(ntype(a))) == .str_:
            secret_compares[n] = true
            runtime_fn("__ct_str_cmp")
        if prune(ntype(a)) == T_MATH_INT:
            secret_compares[n] = true
            runtime_fn("__mi_ct_compare")
        st = secret_wrap(n, t)
        if secret_compares.get(n) != none: secret_compares[int(nodes[n].a)] = true
        last_checked = n
        return st
    secret_result(n, t)

secret_unary = (n: int) -> int:
    secret_reveal(int(nodes[n].a))
    secret_result(n, check_expr(n, 0))

secret_result = (n: int, t: int) -> int:
    if t == T_BOOL or tkind(t) == .void_ or t == T_NEVER: return t
    st = secret_wrap(n, t)
    last_checked = n
    st

secret_coerce = (n: int, from: int, to: int) -> int:
    fk = types[from].kind
    tk = types[to].kind
    if tk == .secret:
        te = prune(int(types[to].elem))
        if fk == .var:
            unify(from, to)
            return n
        if fk == .secret:
            if type_eq(int(types[from].elem), te):
                nodes[n].type = i32(to)
                return n
            if has_var(from) and unify(from, to): return n
            secret_reveal(n)
        coerce(n, te)
        # (a literal is the secret itself, as it is its T: a constant array of them stays one)
        k = nodes[n].kind
        if k == .int_lit or k == .float_lit or k == .bool_lit or k == .str_lit:
            nodes[n].type = i32(to)
            return n
        wrap_conv(n, CV.none_, to)
        secret_hide_checks(int(nodes[n].a))
        return n
    if tk == .opt or tk == .var or tk == .param or is_union(to) or has_var(to): return -1
    if type_eq(int(types[from].elem), to) or can_coerce(0, int(types[from].elem), to):
        fatal(nodes[n].pos, "a {dt(from)} cannot be used as {dt(to)}: its value is hidden{secret_hint(n)}")
    fatal(nodes[n].pos, "type mismatch: expected {dt(to)}, found {dt(from)}{secret_hint(n)}")
    n

secret_hint = (n: int) -> str:
    what = "x"
    if nodes[n].kind == .ident: what = name_of(int(nodes[n].name))
    " (`{what}.reveal` gives its value, where using it is intended)"

secret_cast = (n: int, a: int, tt: int) -> int:
    check_expr(a, int(types[tt].elem))
    v = last_checked
    coerce(v, tt)
    nodes[n] = nodes[v]
    last_checked = n
    tt

secret_can_coerce = (n: int, from: int, to: int) -> int:
    fk = types[from].kind
    tk = types[to].kind
    if fk == .var or tk == .var: return 1
    if tk == .secret:
        fe = from
        fnode = n
        if fk == .secret:
            fe = int(types[from].elem)
            fnode = 0
        if can_coerce(fnode, fe, int(types[to].elem)): return 1
        return 0
    if tk == .opt or is_union(to): return -1
    0

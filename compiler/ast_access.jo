use 'ast.jo'
use 'node_store.dewy'

# Frozen bootstrap twin of ast_access.dewy.
ast_mk = (kind: NK, pos: int) -> int: node_mk(nodes, kind, pos)
ast_set_list = (n: int, xs: int[]): node_set_list(nodes, lists, n, xs)
ast_set_list2 = (n: int, xs: int[]): node_set_list2(nodes, lists, n, xs)
ast_kid = (n: int, i: int) -> int: int(lists[int(nodes[n].list) + i])
ast_kid2 = (n: int, i: int) -> int: int(lists[int(nodes[n].list2) + i])
ast_nkids = (n: int) -> int: int(nodes[n].nlist)
ast_nkids2 = (n: int) -> int: int(nodes[n].nlist2)
ast_set_kid = (n: int, i: int, v: int): lists[int(nodes[n].list) + i] = i32(v)
# n's c and d where they hold child nodes, for walks over every field of any node. A checked
# for keeps locals in c and d (its index and the iterable's snapshot), a partial a function
# instance in d (check.jo, expr.jo's finish_partial); in large builds those numbers reach
# node numbers, and a raw walk recurses into unrelated nodes or its own loop.
ast_kid_c = (n: int) -> int: if nodes[n].kind == .for_: 0 else: int(nodes[n].c)
ast_kid_d = (n: int) -> int:
    k = nodes[n].kind
    if k == .for_ or k == .partial: 0 else: int(nodes[n].d)
ast_kids = (n: int) -> int[]: node_kids(nodes, lists, n)
ast_kids2 = (n: int) -> int[]: node_kids2(nodes, lists, n)
ast_has_flag = (n: int, f: int) -> bool: int(nodes[n].flags) & f != 0
ast_add_flag = (n: int, f: int): nodes[n].flags = i32(int(nodes[n].flags) | f)
ast_clear_flag = (n: int, f: int): nodes[n].flags = i32(int(nodes[n].flags) & ~f)
# (a deep copy of a subtree: generic functions are instantiated so)
ast_clone = (n: int) -> int: node_clone(nodes, lists, n)

ast_note_member = (n: int):
    if int(nodes[n].name) == id_dewy_len: dewy_len_members[n] = nodes[n].pos

ast_decl_has_rest = (d: int) -> bool: (dewy_param_kinds.get(d) ?? []).contains(3)

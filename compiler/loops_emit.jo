use 'ir_types.dewy'
use 'loops.jo'
use 'ir.jo'
use 'ir_builders.dewy'
use 'opt.jo'

# Materialize a loop invariant before its fast copy.
lx_mat = (code: Ins[], L: CLoop, v: int, out: mut Ins[]) -> int:
    if is_kv(v) or not lx_defined_in(code, v, L.pl + 1, L.pe): return v
    xi = code[lx_def_at(code, v, L.pl + 1, L.inc)]
    if xi.op == .mov: return lx_mat(code, L, int(xi.a), out)
    a = lx_mat(code, L, int(xi.a), out)
    b = lx_mat(code, L, int(xi.b), out)
    lx_bin(out, xi.op, a, b)

# the terms plus k, in front of the loop
lx_sum = (code: Ins[], L: CLoop, terms: int[], k: int, out: mut Ins[]) -> int:
    acc = k_vreg(k)
    loop t in terms:
        if t > 0: acc = lx_bin(out, .add, acc, lx_mat(code, L, t - 1, out))
        else: acc = lx_bin(out, .sub, acc, lx_mat(code, L, -t - 1, out))
    acc

# Exact endpoint guards use a low word and a signed high word.
lx_endpoint_add = (out: mut Ins[], lo: int, hi: int, value: int, signed: bool, subtract: bool) -> (int, int):
    upper = if signed: lx_bin(out, .shrs, value, k_vreg(63)) else: k_vreg(0)
    result = lx_bin(out, (if subtract: Op.sub else: Op.add), lo, value)
    carry = lx_bin(out, .ltu, (if subtract: lo else: result), (if subtract: value else: lo))
    high = lx_bin(out, (if subtract: Op.sub else: Op.add), hi, upper)
    high = lx_bin(out, (if subtract: Op.sub else: Op.add), high, carry)
    (result, high)

lx_endpoint = (code: Ins[], L: CLoop, value: int, terms: int[], k: int, out: mut Ins[]) -> (int, int):
    lo = value
    hi = if L.signed: lx_bin(out, .shrs, value, k_vreg(63)) else: k_vreg(0)
    if k != 0: (lo, hi) = lx_endpoint_add(out, lo, hi, k_vreg(k), true, false)
    loop t in terms:
        v = lx_mat(code, L, abs(t) - 1, out)
        (lo, hi) = lx_endpoint_add(out, lo, hi, v, true, t < 0)
    (lo, hi)

# the instructions of loop [s, e] with branches leaving it pointing one construct further out
# (`wrap` more: it is about to be wrapped in constructs); the checks are left out, `ren` renames vregs
lx_copy = (code: Ins[], s: int, e: int, checks: LCheck[], ren: int[], out: mut Ins[], wrap: int):
    depth = -1
    p = s
    loop p <= e:
        skipped = false
        loop ch in checks:
            if p == ch.pi and ch.kind != 5:
                p = ch.pend + 1
                skipped = true
                break
        if skipped: continue
        p += 1
        ins = code[p - 1]
        loop ch in checks:
            if ch.kind == 5 and ch.pi == p - 1:
                ins.op = if ins.op == .checked_add: Op.add else: Op.sub
                ins.imm = 0
        op = ins.op
        if ren.len() > 0:
            # (o_regs.repl holds the renaming of uses; definitions are renamed here; argument lists
            # are copied first, the original loop keeps its own)
            if op == .call or op == .calli or op == .callc or op == .syscall or op == .intr or op == .zeroslots:
                st = ir.args.len()
                loop k in [0..int(ins.b)):
                    item = ir.args[int(ins.a) + k]
                    if op == .zeroslots and int(item) & 1 == 1 and ren[int(item) >> 1] >= 0: item = i32((ren[int(item) >> 1] << 1) | 1)
                    ir.args.push(item)
                ins.a = i32(st)
            o_rewrite(ins)
            if o_defines(op) and int(ins.dst) >= 0 and int(ins.dst) < ren.len() and ren[int(ins.dst)] >= 0: ins.dst = i32(ren[int(ins.dst)])
        if op == .br or op == .brif:
            if ins.imm > depth: ins.imm += wrap
        if op == .brtable:
            st = ir.args.len()
            loop k in [0..int(ins.b)):
                t = int(ir.args[int(ins.c) + k])
                if t > depth: t += wrap
                ir.args.push(i32(t))
            ins.c = i32(st)
            if ins.imm > depth: ins.imm += wrap
        out.push(ins)
        if op == .block or op == .loop or op == .if_: depth += 1
        else if op == .end: depth -= 1

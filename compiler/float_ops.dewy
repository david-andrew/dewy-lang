from p"panic_inventory.dewy" import (effect_panic_note)
from p"refine.jo" import (ref_interval refine_storage)
from p"refinement_types.dewy" import (FACT_MAX FACT_MIN)
from p"types.jo" import (T_MATH_INT T_NEVER T_U64 dt fields is_float is_int prune struct_targ structs targ tkind tsize types)
from p"units.jo" import (quantity_base)
from p"util.jo" import (err_notes fatal name_of pos_file pos_in_lib)

FloatWord:type=int64<overflow='wrap'>
# Checks that float v (of IR type ft) truncates to a value of integer type
# `to`: NaN and values outside the range fail at run time. Always handles the
# conversion (true); the caller then truncates, knowing the value fits.
float_int_guard=(e:FloatWord v:FloatWord ft:FloatWord to:FloatWord):>bool=>$unsafe {
    if ff_int_proven.has(e) {return true}
    let bits:FloatWord=64
    let sg=true
    if types.ptr[to].kind =? 'int_' {
        bits=FloatWord(types.ptr[to].bits)
        sg=types.ptr[to].sign
    }
    let w=if ft =? VS {e_un('f2f' VF v)} else {v}
    # (trunc keeps x when lo < x < hi; NaN fails both comparisons)
    let low:FloatWord=0
    if sg and bits =? 64 {low=e_bin('fge' VF w e_fconst((-9223372036854775808.0) VF))}
    else if sg {low=e_bin('fgt' VF w e_fconst((-float64(FloatWord(1) << (bits - 1)) - 1.0) VF))}
    else {low=e_bin('fgt' VF w e_fconst((-1.0) VF))}
    let top=if bits =? 64 and not sg {18446744073709551616.0} else if bits =? 64 {9223372036854775808.0} else if sg {float64(FloatWord(1) << (bits - 1))} else {float64(FloatWord(1) << bits)}
    let high=e_bin('flt' VF w e_fconst(top VF))
    iff(e_bin('eq' VI e_bin('and_' VI low high) e_iconst(0)));
    e_call_nr(rt("__float_int_fail") [w e_daddr(str_data(dt(to))) e_daddr(loc_data(nodes.ptr[e].pos))] (-1));
    endc();
    true
}
# A float known to be in [0, 2^64) truncated to uint64: values from 2^63 have no
# int64, so v - 2^63 is converted and the top bit set.
float_to_u64=(v:FloatWord ft:FloatWord):>FloatWord=>{
    let d=vreg(VI)
    let two63=e_fconst(9223372036854775808.0 ft)
    iff(e_bin('fge' ft v two63));
    let t=vreg(VI)
    emit('f2i' ft t e_bin('fsub' ft v two63) 0 0 0);
    e_mov(d e_bin('xor' VI t e_iconst(-9223372036854775807 - 1)));
    els();
    emit('f2i' ft d v 0 0 0);
    endc();
    d
}
float_keys_reset=():>void=>{
    float_keys=dict<int64 int64>()
    float_keys_any=false
    key_float_types=dict<int64 bool>()
}
# Could a key of type t be or hold a NaN: a float, or a plain record or tuple with one in a
# field (nested ones too), whose equality is the fields' own?
key_holds_float=(t0:FloatWord depth:FloatWord=0):>bool=>$unsafe {
    let t=quantity_base(t0)
    if is_float(t) {return true}
    let k=types.ptr[t].kind
    if depth >? 8 or (k not=? 'tuple' and k not=? 'struct_') {return false}
    let known=key_float_types.get(t)
    if known not=? none {return known}
    key_float_types[t]=false
    let holds=false
    if k =? 'tuple' {
        loop i in [0..FloatWord(types.ptr[t].nargs)) {
            if key_holds_float(targ(t i) depth + 1) {holds=true}
        }
    }
    else {
        let si=FloatWord(types.ptr[t].st)
        let plain=structs.ptr[si].nvariants =? 0 and not structs.ptr[si].union_ and not structs.ptr[si].soa_ and structs.ptr[si].lit_set =? 0 and structs.ptr[si].decl not=? 0 and not pos_in_lib(nodes.ptr[FloatWord(structs.ptr[si].decl)].pos)
        if plain and record_value_member(t false) =? 0 {
            loop i in [0..FloatWord(structs.ptr[si].nfields)) {
                if key_holds_float(FloatWord(fields.ptr[FloatWord(structs.ptr[si].fields) + i].type) depth + 1) {holds=true}
            }
        }
    }
    key_float_types[t]=holds
    holds
}
# checker_call_queries.dewy's map_float_key leaves the host the library set and map calls
# whose names could owe a key proof.
float_key_rest=(n:int64):>void=>$unsafe {
    let d=FloatWord(fns.ptr[FloatWord(nodes.ptr[n].sym)].decl)
    if d =? 0 or not pos_in_lib(nodes.ptr[d].pos) or nkids(d) <? 1 {return}
    let mt=prune(ntype(kid(n 0)))
    if types.ptr[mt].kind =? 'ptr' {mt=prune(FloatWord(types.ptr[mt].elem))}
    let name=name_of(FloatWord(nodes.ptr[d].name))
    if nkids(n) =? 1 and (name =? "__dewy_make_set" or name =? "set") and tkind(mt) =? 'array' {
        if not key_holds_float(FloatWord(types.ptr[mt].elem)) {return}
        let values=kid(n 0)
        if nodes.ptr[values].kind =? 'array' and nodes.ptr[values].b =? 0 and not array_has_spread(values) {
            loop x in kids(values) {float_key_obligation(x FK_ELEMENT)}
        }
        else {float_key_obligation(values FK_ELEMENT | FK_EACH)}
        return
    }
    if nkids(d) <? 2 or nkids(n) <? 2 {return}
    let param=name_of(FloatWord(nodes.ptr[kid(d 1)].name))
    let what:FloatWord=0
    if is_map_type(mt) and param =? "k" {what=FK_KEY}
    else if is_dewy_set_type(mt) and param =? "value" {what=FK_ELEMENT}
    if what =? 0 or not key_holds_float(struct_targ(FloatWord(types.ptr[mt].st) 0)) {return}
    float_key_obligation(kid(n 1) what)
}
float_key_obligation=(key:FloatWord what:FloatWord=FK_KEY):>void=>$unsafe {
    if what & FK_EACH =? 0 and key_not_nan(key) {return}
    if ff_mode_at(nodes.ptr[key].pos) & FF_NAN not=? 0 {
        # (under `$no_nan`: a float computed there is proven, one entering it is decided by the
        # walk; a record built in place there holds what was computed there)
        if what & FK_EACH =? 0 and is_float(quantity_base(ntype(key))) {
            ff_keys[key]=what
            return
        }
        let k=nodes.ptr[key].kind
        if what & FK_EACH =? 0 and (k =? 'tuple' or k =? 'call' and nodes.ptr[key].aux =? 2) {return}
    }
    float_key_unproven(key what)
}
# A key or element not proven free of NaN: checked where the policy defers it, else an error.
float_key_unproven=(key:FloatWord what:FloatWord):>void=>$unsafe {
    let whole=what & FK_EACH =? 0 and is_float(quantity_base(ntype(key)))
    let noun=if what & FK_KEY not=? 0 {"dictionary key"} else if what & FK_EACH not=? 0 {"set's elements"} else {"set element"}
    let claim=if what & FK_EACH not=? 0 {"hold no NaN"} else if whole {"is not NaN"} else {"holds no NaN"}
    let message="cannot prove the {noun} {claim}"
    if dir_defer(key message true) {
        float_keys[key]=what
        float_keys_any=true
        return
    }
    let lost=if what & FK_KEY not=? 0 {"its entry could never be found again"} else {"it could never be found in the set again"}
    err_notes.push([(-1) "help: NaN equals nothing, so {lost}: compute it under `$no_nan`, or check it at run time under `$runtime_checks`"])
    fatal(nodes.ptr[key].pos message);
}
# A key that is never NaN and holds none, by its form alone: a float, or a record or tuple
# built in place from such.
key_not_nan=(n:FloatWord):>bool=>$unsafe {
    if is_float(quantity_base(ntype(n))) {return float_not_nan(n)}
    let k=nodes.ptr[n].kind
    if k =? 'tuple' or k =? 'call' and nodes.ptr[n].aux =? 2 {
        loop x in kids(n) {
            if key_holds_float(ntype(x)) and not key_not_nan(x) {return false}
        }
        return true
    }
    false
}
# A float expression that is never NaN, by its form alone.
float_not_nan=(n:FloatWord):>bool=>$unsafe {
    let k=nodes.ptr[n].kind
    if k =? 'float_lit' {return nodes.ptr[n].fval =? nodes.ptr[n].fval}
    if k =? 'int_lit' {return true}
    if k =? 'conv' {return is_int(prune(ntype(FloatWord(nodes.ptr[n].a)))) or float_not_nan(FloatWord(nodes.ptr[n].a))}
    if k =? 'unary' and nodes.ptr[n].op =? int32(59) {return float_not_nan(FloatWord(nodes.ptr[n].a))}
    false
}
# Lowering: the runtime check of a key or element (or each element of an array), on its value v.
float_key_check=(e:FloatWord v:FloatWord t:FloatWord):>void=>$unsafe {
    let what=float_keys.get(e) ?? 0
    if what =? 0 {return}
    let noun=if what & FK_KEY not=? 0 {"dictionary key"} else {"set element"}
    let lost=if what & FK_KEY not=? 0 {"its entry could never be found"} else {"it could never be found in the set"}
    if what & FK_EACH =? 0 {
        let claim=if is_float(quantity_base(t)) {"is NaN"} else {"holds a NaN"}
        nan_value_check(v t "{noun} {claim}, which equals nothing: {lost}" e);
        return
    }
    let et=FloatWord(types.ptr[prune(t)].elem)
    let claim=if is_float(quantity_base(et)) {"is NaN"} else {"holds a NaN"}
    let message="{noun} {claim}, which equals nothing: {lost}"
    let n=arr_len(v)
    let i=vreg(VI)
    e_mov(i e_iconst(0));
    blk();
    lop();
    brif_to(e_bin('ges' VI i n) ctl - 1);
    let ea=e_bin('add' VI e_addi(v 24) e_bin('mul' VI i e_iconst(tsize(et))))
    nan_value_check(load_val(et ea 0) et message e);
    e_mov(i e_addi(i 1));
    br_to(ctl);
    endc();
    endc();
}
nan_value_check=(v:FloatWord t0:FloatWord message:string e:FloatWord):>void=>$unsafe {
    let t=quantity_base(t0)
    if is_float(t) {
        let ty=vt_of(t)
        iff(e_bin('fne' ty v v));
        e_call_nr(rt("__assert_fail") [e_daddr(str_data(message)) e_daddr(loc_data(nodes.ptr[e].pos))] (-1));
        endc();
        return
    }
    if vc(t) not=? VC_AGG or not key_holds_float(t) {return}
    loop fo in field_list(t) {
        if key_holds_float(fo[0]) {nan_value_check(load_val(fo[0] v fo[1]) fo[0] message e)}
    }
}
floats_reset=():>void=>{
    ff_checks=dict<int64 int64>()
    ff_checks_any=false
    ff_int_proven=dict<int64 bool>()
}
# (check_program starts over: what checking noted for the walks)
floats_notes_reset=():>void=>{
    ff_integer_bounds=dict<int64 FR>()
    ff_callers=dict<int64 bool>()
    ff_direct=dict<int64 int64>()
    ff_indirect=dict<int64 bool>()
    ff_keys=dict<int64 int64>()
    ff_conversions=dict<int64 bool>()
    ff_operands=dict<int64 FR>()
    ff_ranged=dict<int64 bool>()
}
# expr.jo: a float converted to an integer in the function being checked
ff_note_conversion=():>void=>{
    if cx >=? 0 {ff_conversions[FloatWord(ctxs[cx].inst)]=true}
}
# expr.jo, a direct call of f from the function being checked: its caller is walked when f's body
# has a float policy and takes a float
ff_note_call=(f:FloatWord decl:FloatWord):>void=>$unsafe {
    if ff_scope_decl(decl) =? 0 or cx <? 0 {return}
    let has_float=false
    loop t in fns.ptr[f].ptypes {
        if is_float(quantity_base(prune(t))) {has_float=true}
    }
    if has_float {ff_callers[FloatWord(ctxs[cx].inst)]=true}
}
# expr.jo: a function used as a value
ff_note_ref=(decl:FloatWord):>void=>{
    if decl not=? 0 {ff_indirect[decl]=true}
}
# The declaration's body's float policy (0 if neither setting holds).
ff_scope_decl=(decl:FloatWord):>FloatWord=>$unsafe {
    if decl =? 0 or nodes.ptr[decl].kind not=? 'fn_' or nodes.ptr[decl].b =? 0 {return 0}
    let k=ff_direct.get(decl)
    if k not=? none {return k - 1}
    let mode=ff_mode_at(nodes.ptr[FloatWord(nodes.ptr[decl].b)].pos)
    ff_direct[decl]=mode + 1
    mode
}
ff_mode_at=(p:FloatWord):>FloatWord=>{
    let m:FloatWord=0
    if dir_value(dir_name_no_nan p) =? 1 {m=m | FF_NAN}
    if dir_value(dir_name_no_inf p) =? 1 {m=m | FF_INF}
    m
}
# (`float64.nan` is the one literal with no number to bound)
ff_literal=(x:float64):>FR=>{
    if x =? x {FR(x x)} else {FR((-__INF) __INF true)}
}
ff_top=():>FR=>{
    # (finite under `$no_inf`, and a NaN unless `$no_nan` holds too: a caller outside the scope
    # proves nothing it cannot follow)
    if ff_assume & FF_INF not=? 0 {return FR((-FF_MAX) FF_MAX ff_assume & FF_NAN =? 0)}
    FR((-__INF) __INF ff_assume & FF_NAN =? 0)
}
# a value entering the scope: it may be NaN
ff_enter=():>FR=>{
    FR((-__INF) __INF true)
}
ff_hull=(a:FR b:FR):>FR=>{
    FR(min(a.lo b.lo) max(a.hi b.hi) a.nan or b.nan)
}
ff_has=(a:FR x:float64):>bool=>{
    a.lo <=? x and x <=? a.hi
}
ff_may_inf=(a:FR):>bool=>{
    a.lo =? -__INF or a.hi =? __INF
}
ff_may_zero=(a:FR):>bool=>{
    ff_has(a 0.0)
}
# (the finite values of a: the ends an infinity can be approached from)
ff_finite=(a:FR):>FR=>{
    FR(max(a.lo (-FF_MAX)) min(a.hi FF_MAX))
}
# (an end computed from infinite ends can be NaN: it then bounds nothing)
ff_end=(x:float64 fallback:float64):>float64=>{
    if x not=? x {fallback} else {x}
}
# A local whose value the walk can follow: not captured, aliased or written
# through a reference.
ff_tracked=(l:FloatWord):>bool=>$unsafe {
    l >? 0 and FloatWord(locals.ptr[l].flags) & (LF_CAPTURED | LF_ADDR | LF_BYREF | LF_ALIAS | LF_ELEMALIAS | LF_SOAELEM | LF_CAPTURE) =? 0
}
ff_local=(n:FloatWord):>FloatWord=>$unsafe {
    if n <=? 0 or nodes.ptr[n].kind not=? 'ident' or nodes.ptr[n].aux not=? int32(1) {return 0}
    let l=FloatWord(nodes.ptr[n].sym)
    if not ff_tracked(l) {return 0}
    l
}
# A float field of a tracked local, `mouse.x`, keeps the bounds its guards gave it: its key holds
# the local in the low 32 bits and the field's name above. Writing the field or the local forgets
# them. Field keys exist only where a guard made one, so the walk of ff_env that forgets them
# is O(guarded fields). No key is made for a local whose address is taken: ff_tracked.
ff_field_key=(n:FloatWord):>FloatWord=>$unsafe {
    if n <=? 0 or nodes.ptr[n].kind not=? 'field' {return 0}
    let l=ff_local(FloatWord(nodes.ptr[n].a))
    if l =? 0 or not ff_float(n) {return 0}
    l + ((FloatWord(nodes.ptr[n].name) + 1) << 32)
}
ff_forget_fields=(l:FloatWord):>void=>{
    if ff_env.length =? 0 {return}
    let keys:array<int64>=[]
    loop [k _] in ff_env {
        if k >=? (FloatWord(1) << 32) and k & 4294967295 =? l {keys.push(k)}
    }
    loop k in keys {ff_env.remove(k);}
}
ff_get=(n:FloatWord):>FR=>$unsafe {
    let l=ff_local(n)
    if l >? 0 {
        let r=ff_env.get(l)
        if r not=? none {return r}
        return ff_top()
    }
    # (a global, a variable of the function around this one, a loop's element, a variable
    # written through a reference or by a closure: what it holds may come from outside)
    if n >? 0 and nodes.ptr[n].kind =? 'ident' and ff_float(n) and (nodes.ptr[n].aux =? int32(2) or nodes.ptr[n].aux =? int32(1)) {return ff_enter()}
    ff_top()
}
# (a float, or an optional one: its value, once present, is followed the same way)
ff_float_or_opt=(t0:FloatWord):>bool=>$unsafe {
    if t0 <=? 0 {return false}
    let t=prune(t0)
    if is_float(t) {return true}
    types.ptr[t].kind =? 'opt' and FloatWord(types.ptr[t].elem) >? 0 and is_float(prune(FloatWord(types.ptr[t].elem)))
}
ff_float=(n:FloatWord):>bool=>{
    let t=ntype(n)
    t >? 0 and is_float(t)
}
# n's value r is used under a float policy: prove or check each property it may violate.
ff_use=(n:FloatWord r:FR):>FR=>$unsafe {
    if n <=? 0 {return r}
    let mode=ff_mode_at(nodes.ptr[n].pos)
    if r.nan and mode & FF_NAN not=? 0 {ff_obligation(n FF_ENTER "{ff_shown(n)} is not NaN")}
    if ff_may_inf(r) and mode & FF_INF not=? 0 {ff_obligation(n FF_ENTER_INF "{ff_shown(n)} is finite")}
    if (not r.nan or mode & FF_NAN =? 0) and (not ff_may_inf(r) or mode & FF_INF =? 0) {return r}
    let l=ff_local(n)
    if l >? 0 and ff_env.has(l) {
        let k=ff_env[l]
        if mode & FF_NAN not=? 0 {k.nan=false}
        if mode & FF_INF not=? 0 {
            k.lo=max(k.lo (-FF_MAX))
            k.hi=min(k.hi FF_MAX)
        }
        ff_env[l]=k
    }
    let lo=if mode & FF_INF not=? 0 {max(r.lo (-FF_MAX))} else {r.lo}
    let hi=if mode & FF_INF not=? 0 {min(r.hi FF_MAX)} else {r.hi}
    FR(lo hi r.nan and mode & FF_NAN =? 0)
}
ff_shown=(n0:FloatWord):>string=>$unsafe {
    let n=n0
    loop n >? 0 and nodes.ptr[n].kind =? 'conv' {n=FloatWord(nodes.ptr[n].a)}
    if n >? 0 and nodes.ptr[n].kind =? 'ident' {
        let nm=name_of(FloatWord(nodes.ptr[n].name))
        if (nm as array<uint8>).length >? 0 and (nm as array<uint8>)[0] not=? b'$' and (nm as array<uint8>)[0] not=? b'_' {return "`{nm}`"}
    }
    if n >? 0 and nodes.ptr[n].kind =? 'field' {return "`.{name_of(FloatWord(nodes.ptr[n].name))}`"}
    "the value"
}
# An obligation at n: `what` could produce NaN or infinity (the `kind`).
ff_obligation=(n:FloatWord kind:FloatWord what:string by:string=""):>void=>$unsafe {
    if ff_probing {return}
    let p=nodes.ptr[n].pos
    let tag=if kind =? FF_INF or kind =? FF_ENTER_INF {"no_inf"} else {"no_nan"}
    let claim=if (by as array<uint8>).length >? 0 {"cannot prove {what}: {by}"} else {"cannot prove {what} under `${tag}`"}
    if dir_defer(n claim true) {
        ff_checks[n]=(ff_checks.get(n) ?? 0) | kind
        ff_checks_any=true
        return
    }
    if kind =? FF_ENTER {err_notes.push([(-1) "help: a value entering `$no_nan` (a parameter of a function used as a value, a field, an element, a call's result) may be NaN: test it first (`if x =? x`, `if 0.0 <=? x`), or check it at run time with `$runtime_checks`"])}
    else if kind =? FF_ENTER_INF {err_notes.push([(-1) "help: a value entering `$no_inf` may be infinite: bound it with a guard, or check it at run time with `$runtime_checks`"])}
    else {err_notes.push([(-1) "help: bound the operands with a guard (`if b not=? 0.0`, `if float64.min <=? x <=? float64.max` for a finite x, narrower where a result must stay finite too), or opt this scope out with `${tag}=false`"])}
    fatal(p claim);
}
# Bounds of a op b, with the obligations of the settings in force at n.
ff_arith=(n:FloatWord op:Tok a:FR b:FR):>FR=>$unsafe {
    let m=ff_mode_at(nodes.ptr[n].pos)
    let sym=if op =? 'plus' {"+"} else if op =? 'minus' {"-"} else if op =? 'star' {"*"} else {"/"}
    if op =? 'minus' {return ff_arith_signed(n m sym a FR((-b.hi) (-b.lo)) 'plus')}
    ff_arith_signed(n m sym a b op)
}
ff_arith_signed=(n:FloatWord m:FloatWord sym:string a:FR b:FR op:Tok):>FR=>{
    let nan=false
    let inf=false
    let r=FR((-__INF) __INF)
    if op =? 'plus' {
        nan=a.hi =? __INF and b.lo =? -__INF or a.lo =? -__INF and b.hi =? __INF
        let fa=ff_finite(a)
        let fb=ff_finite(b)
        let lo=fa.lo + fb.lo
        let hi=fa.hi + fb.hi
        inf=lo =? -__INF or hi =? __INF
        r=FR(ff_end(a.lo + b.lo (-__INF)) ff_end(a.hi + b.hi __INF))
    }
    else if op =? 'star' {
        nan=ff_may_zero(a) and ff_may_inf(b) or ff_may_inf(a) and ff_may_zero(b)
        let fa=ff_finite(a)
        let fb=ff_finite(b)
        let p1=fa.lo * fb.lo
        let p2=fa.lo * fb.hi
        let p3=fa.hi * fb.lo
        let p4=fa.hi * fb.hi
        inf=max(max(p1 p2) max(p3 p4)) =? __INF or min(min(p1 p2) min(p3 p4)) =? -__INF
        let q1=ff_end(a.lo * b.lo __INF)
        let q2=ff_end(a.lo * b.hi __INF)
        let q3=ff_end(a.hi * b.lo __INF)
        let q4=ff_end(a.hi * b.hi __INF)
        r=FR(min(min(ff_end(a.lo * b.lo (-__INF)) ff_end(a.lo * b.hi (-__INF))) min(ff_end(a.hi * b.lo (-__INF)) ff_end(a.hi * b.hi (-__INF)))) max(max(q1 q2) max(q3 q4)))
    }
    else {
        nan=ff_may_zero(a) and ff_may_zero(b) or ff_may_inf(a) and ff_may_inf(b)
        if ff_may_zero(b) {
            inf=true
        }
        else {
            let fa=ff_finite(a)
            let fb=ff_finite(b)
            # (b keeps one sign: the quotient's extremes are at the ends)
            let p1=fa.lo / fb.lo
            let p2=fa.lo / fb.hi
            let p3=fa.hi / fb.lo
            let p4=fa.hi / fb.hi
            inf=max(max(p1 p2) max(p3 p4)) =? __INF or min(min(p1 p2) min(p3 p4)) =? -__INF
            let q1=a.lo / b.lo
            let q2=a.lo / b.hi
            let q3=a.hi / b.lo
            let q4=a.hi / b.hi
            r=FR(min(min(ff_end(q1 (-__INF)) ff_end(q2 (-__INF))) min(ff_end(q3 (-__INF)) ff_end(q4 (-__INF)))) max(max(ff_end(q1 __INF) ff_end(q2 __INF)) max(ff_end(q3 __INF) ff_end(q4 __INF))))
        }
    }
    if nan and m & FF_NAN not=? 0 {ff_obligation(n FF_NAN "`{sym}` produces no NaN")}
    if inf and m & FF_INF not=? 0 {
        let what=if sym =? "/" and ff_may_zero(b) {"the divisor is nonzero"} else {"`{sym}` does not overflow"}
        ff_obligation(n FF_INF what)
    }
    # (a checked or proven result obeys the settings)
    if m & FF_INF not=? 0 {r=ff_finite(r)}
    r.nan=m & FF_NAN =? 0 and (nan or a.nan or b.nan)
    r
}
# A call of a bundled math function: its obligations and bounds.
ff_math=(n:FloatWord name:string args:array<FR>):>FR=>$unsafe {
    let m=ff_mode_at(nodes.ptr[n].pos)
    let x=if args.length >? 0 {args[0]} else {ff_top()}
    let nan=false
    let inf=false
    let r=ff_top()
    if name =? "log" or name =? "log2" or name =? "log10" {
        nan=x.lo <? 0.0
        inf=ff_may_zero(x)
    }
    else if name =? "exp" {
        inf=x.hi >? 709.0
        r=FR(0.0 (if inf {__INF} else {1.0e308}))
    }
    else if name =? "sin" or name =? "cos" {
        nan=ff_may_inf(x)
        r=FR((-1.0) 1.0)
    }
    else if name =? "tan" {
        nan=ff_may_inf(x)
    }
    else if name =? "asin" or name =? "acos" {
        nan=x.lo <? -1.0 or x.hi >? 1.0
        r=FR((-4.0) 4.0)
    }
    else if name =? "pow" {
        nan=true
        inf=true
    }
    else if name =? "tanh" {
        r=FR((-1.0) 1.0)
    }
    else {
        # (another library function: NaN in, NaN out, and those that make one from numbers; one
        # given no float, as a parser, gives a value entering the scope)
        r=ff_top()
        let floats=false
        loop a in args {
            if a.nan {r.nan=true}
        }
        loop c in kids(n) {
            if ff_float(c) {floats=true}
        }
        if not floats or name in? ["fmod" "remainder" "log1p" "acosh" "atanh" "to_float" "float"] {r.nan=true}
        return r
    }
    if nan and m & FF_NAN not=? 0 {ff_obligation(n FF_NAN "`{name}` produces no NaN")}
    if inf and m & FF_INF not=? 0 {ff_obligation(n FF_INF "`{name}` produces no infinity")}
    if m & FF_INF not=? 0 {r=ff_finite(r)}
    r.nan=m & FF_NAN =? 0 and nan
    loop a in args {
        if a.nan and m & FF_NAN =? 0 {r.nan=true}
    }
    r
}
# The bounds of n's value (when it is a float), visiting everything it evaluates.
ff_eval=(n:FloatWord):>FR=>{
    let r=ff_eval_node(n)
    if r.nan and ff_keys.length >? 0 and ff_keys.has(n) and not ff_probing {
        # (a dictionary key or set element under `$no_nan` that may be NaN)
        float_key_unproven(n ff_keys[n])
        r=ff_use_done(n r)
    }
    r
}
# (n's value r was checked or proven not NaN: so is its local from here)
ff_use_done=(n:FloatWord r:FR):>FR=>{
    let l=ff_local(n)
    if l >? 0 and ff_env.has(l) {
        let k=ff_env[l]
        k.nan=false
        ff_env[l]=k
    }
    FR(r.lo r.hi false)
}
ff_eval_node=(n:FloatWord):>FR=>$unsafe {
    if n <=? 0 {return ff_top()}
    let k=nodes.ptr[n].kind
    let t=ntype(n)
    if k =? 'float_lit' {return ff_literal(nodes.ptr[n].fval)}
    if k =? 'int_lit' {
        if t >? 0 and is_float(t) {return FR(float64(nodes.ptr[n].ival) float64(nodes.ptr[n].ival))}
        return ff_top()
    }
    if k =? 'ident' {return ff_get(n)}
    if k =? 'unary' {
        let a=ff_eval(FloatWord(nodes.ptr[n].a))
        if nodes.ptr[n].op =? int32(59) and t >? 0 and is_float(t) {return FR((-a.hi) (-a.lo) a.nan)}
        return ff_top()
    }
    if k =? 'binary' {
        let op=cx_token_values.ptr[FloatWord(nodes.ptr[n].op)]
        let a=ff_eval(FloatWord(nodes.ptr[n].a))
        let b=ff_eval(FloatWord(nodes.ptr[n].b))
        let arith=nodes.ptr[n].aux =? 0 and t >? 0 and is_float(t)
        if arith and (op =? 'plus' or op =? 'minus' or op =? 'star' or op =? 'slash' or op =? 'caret') {
            a=ff_use(FloatWord(nodes.ptr[n].a) a)
            b=ff_use(FloatWord(nodes.ptr[n].b) b)
        }
        if arith and (op =? 'plus' or op =? 'minus' or op =? 'star' or op =? 'slash') {return ff_arith(n op a b)}
        if arith and op =? 'caret' {return ff_math(n "pow" [a b])}
        return ff_top()
    }
    if k =? 'conv' {return ff_conv(n)}
    if k =? 'intrinsic' and nkids(n) >? 0 and (nodes.ptr[n].aux =? int32(int64(IN.sqrt)) or nodes.ptr[n].aux =? int32(int64(IN.fabs))) {
        let a=ff_eval(kid(n 0))
        if nodes.ptr[n].aux =? int32(int64(IN.fabs)) {
            if a.lo >=? 0.0 {return a}
            return FR(0.0 max((-a.lo) a.hi) a.nan)
        }
        a=ff_use(kid(n 0) a)
        let m=ff_mode_at(nodes.ptr[n].pos)
        if a.lo <? 0.0 and m & FF_NAN not=? 0 {ff_obligation(n FF_NAN "the square root's operand is not negative")}
        return FR(0.0 ff_end(sqrt(max(a.hi 0.0)) __INF) m & FF_NAN =? 0 and (a.nan or a.lo <? 0.0))
    }
    if k =? 'call' and nodes.ptr[n].sym >? 0 {
        let args:array<FR>=[]
        loop c in kids(n) {args.push(ff_eval(c))}
        ff_eval(FloatWord(nodes.ptr[n].a));
        let f=FloatWord(nodes.ptr[n].sym)
        let decl=FloatWord(fns.ptr[f].decl)
        # A direct call proves the properties its callee's float policy requires.
        let scope=ff_scope_decl(decl)
        if decl >? 0 and fns.ptr[f].kind not=? int32(FK_LAMBDA) and scope not=? 0 {
            loop i in 0.. and c in kids(n) {
                if ff_float(c) {
                    if args[i].nan and scope & FF_NAN not=? 0 {
                        ff_obligation(c FF_ENTER "{ff_shown(c)} is not NaN" "`{name_of(FloatWord(nodes.ptr[decl].name))}` takes it under `$no_nan`")
                    }
                    if ff_may_inf(args[i]) and scope & FF_INF not=? 0 {
                        ff_obligation(c FF_ENTER_INF "{ff_shown(c)} is finite" "`{name_of(FloatWord(nodes.ptr[decl].name))}` takes it under `$no_inf`")
                    }
                    let lo=if scope & FF_INF not=? 0 {max(args[i].lo (-FF_MAX))} else {args[i].lo}
                    let hi=if scope & FF_INF not=? 0 {min(args[i].hi FF_MAX)} else {args[i].hi}
                    args[i]=FR(lo hi args[i].nan and scope & FF_NAN =? 0)
                }
            }
        }
        if not ff_float_or_opt(t) {return ff_top()}
        if decl >? 0 and pos_in_lib(nodes.ptr[decl].pos) {
            let name=name_of(FloatWord(nodes.ptr[decl].name))
            if name in? ["log" "log2" "log10" "exp" "sin" "cos" "tan" "asin" "acos" "pow" "tanh"] {
                loop i in 0.. and c in kids(n) {args[i]=ff_use(c args[i])}
            }
            return ff_math(n name args)
        }
        if decl >? 0 and scope not=? 0 {
            let hi=if scope & FF_INF not=? 0 {FF_MAX} else {__INF}
            return FR((-hi) hi scope & FF_NAN =? 0)
        }
        return ff_enter()
    }
    if k =? 'call' and ff_float_or_opt(t) {
        # (a function value, a closure: its result enters)
        ff_children(n)
        return ff_enter()
    }
    if (k =? 'field' or k =? 'index') and t >? 0 and is_float(t) {
        ff_children(n)
        let key=ff_field_key(n)
        if key not=? 0 {
            let known=ff_env.get(key)
            if known not=? none {return known}
        }
        return ff_enter()
    }
    if k =? 'vardecl' {
        let r=ff_eval(FloatWord(nodes.ptr[n].b))
        let l=FloatWord(nodes.ptr[n].sym)
        if nkids(n) =? 0 and not has_flag(n NF_GLOBAL) and ff_tracked(l) and t >=? 0 {
            let lt=FloatWord(locals.ptr[l].type)
            if lt >? 0 and is_float(lt) {ff_env[l]=r}
        }
        return r
    }
    if k =? 'assign' {return ff_assign(n)}
    if k =? 'if_' {
        let cond=FloatWord(nodes.ptr[n].a)
        ff_eval(cond);
        let before=ff_env
        ff_refine(cond true)
        let y=ff_eval(FloatWord(nodes.ptr[n].b))
        let after_yes=ff_env
        ff_env=before
        ff_refine(cond false)
        let z=ff_eval(FloatWord(nodes.ptr[n].c))
        # (a branch that leaves, as a guard's `return`, joins nothing)
        if ff_diverges(FloatWord(nodes.ptr[n].b)) {return z}
        if ff_diverges(FloatWord(nodes.ptr[n].c)) {
            ff_env=after_yes
            return y
        }
        ff_join(after_yes)
        return ff_hull(y z)
    }
    if k =? 'while_' or k =? 'for_' {
        # (the loop runs any number of times: what it assigns is unknown in it and after it)
        ff_forget_assigned(n)
        # (a loop's variable holds elements: they enter)
        let lv=if k =? 'for_' {FloatWord(nodes.ptr[n].sym)} else {0}
        if lv >? 0 and lv <? locals.length and ff_tracked(lv) and FloatWord(locals.ptr[lv].type) >? 0 and is_float(FloatWord(locals.ptr[lv].type)) {ff_env[lv]=ff_enter()}
        ff_children(n)
        ff_forget_assigned(n)
        return ff_top()
    }
    if k =? 'block' {
        let r=ff_top()
        loop c in kids(n) {r=ff_eval(c)}
        return r
    }
    if k =? 'exprstmt' {return ff_eval(FloatWord(nodes.ptr[n].a))}
    if k =? 'return_' {
        let r=ff_eval(FloatWord(nodes.ptr[n].a))
        if nodes.ptr[n].a not=? 0 and ff_float(FloatWord(nodes.ptr[n].a)) {r=ff_use(FloatWord(nodes.ptr[n].a) r)}
        return r
    }
    if k =? 'addr' {
        # (a place lent out, `@x`: what it holds afterwards is unknown)
        let l=ff_local(FloatWord(nodes.ptr[n].a))
        if l >? 0 {
            ff_env.remove(l);
            ff_forget_fields(l)
        }
        let key=ff_field_key(FloatWord(nodes.ptr[n].a))
        if key not=? 0 {ff_env.remove(key);}
    }
    let mask=isolation_children(k)
    if mask <? 0 or k =? 'lambda' {
        ff_env=dict<int64 FR>()
        return ff_top()
    }
    if k =? 'coalesce' and ff_float_or_opt(t) {
        # (`x ?? y`: either one, as a parsed `to_float(s) ?? 0.0` may be NaN)
        ff_forget_assigned(n)
        let a=ff_eval(FloatWord(nodes.ptr[n].a))
        let b=ff_eval(FloatWord(nodes.ptr[n].b))
        ff_forget_assigned(n)
        return ff_hull(a b)
    }
    if k =? 'and_' or k =? 'or_' or k =? 'coalesce' or k =? 'match_' or k =? 'iflet' or k =? 'arm' {
        # (evaluated on some paths only: what they assign is unknown after them)
        ff_forget_assigned(n)
        ff_children(n)
        ff_forget_assigned(n)
        return ff_top()
    }
    ff_children(n)
    ff_top()
}
ff_diverges=(n:FloatWord):>bool=>$unsafe {
    if n <=? 0 {return false}
    let k=nodes.ptr[n].kind
    if k =? 'return_' or k =? 'break_' or k =? 'continue_' {return true}
    if k =? 'block' {return nkids(n) >? 0 and ff_diverges(kid(n nkids(n) - 1))}
    if k =? 'exprstmt' {return ff_diverges(FloatWord(nodes.ptr[n].a))}
    k =? 'call' and ntype(n) =? T_NEVER
}
ff_children=(n:FloatWord):>void=>$unsafe {
    let mask=isolation_children(nodes.ptr[n].kind)
    if mask <=? 0 {return}
    if mask & 1 not=? 0 {ff_eval(FloatWord(nodes.ptr[n].a));}
    if mask & 2 not=? 0 {ff_eval(FloatWord(nodes.ptr[n].b));}
    if mask & 4 not=? 0 {ff_eval(FloatWord(nodes.ptr[n].c));}
    if mask & 16 not=? 0 {
        loop c in kids(n) {ff_eval(c);}
    }
}
ff_assign=(n:FloatWord):>FR=>$unsafe {
    let target=FloatWord(nodes.ptr[n].a)
    let op=cx_token_values.ptr[FloatWord(nodes.ptr[n].op)]
    let t=ntype(target)
    let float=t >? 0 and is_float(t)
    let r=ff_top()
    if op =? 'assign' {
        if ff_local(target) =? 0 {ff_eval(target);}
        r=ff_eval(FloatWord(nodes.ptr[n].b))
        if float and ff_local(target) >? 0 {r=ff_use(FloatWord(nodes.ptr[n].b) r)}
    }
    else {
        let old=ff_eval(target)
        let b=ff_eval(FloatWord(nodes.ptr[n].b))
        if float and nodes.ptr[n].aux =? 0 {
            old=ff_use(target old)
            b=ff_use(FloatWord(nodes.ptr[n].b) b)
        }
        if float and nodes.ptr[n].aux =? 0 {
            let arith=if op =? 'pluseq' {Tok.plus} else if op =? 'minuseq' {Tok.minus} else if op =? 'stareq' {Tok.star} else if op =? 'slasheq' {Tok.slash} else {Tok.eof}
            if arith not=? 'eof' {r=ff_arith(n arith old b)}
        }
    }
    let l=ff_local(target)
    if l >? 0 {
        if float {ff_env[l]=r}
        else {ff_env.remove(l);}
        ff_forget_fields(l)
    }
    let key=ff_field_key(target)
    if key not=? 0 {ff_env.remove(key);}
    r
}
# Every tracked local assigned inside n forgets its bounds.
ff_forget_assigned=(n:FloatWord):>void=>$unsafe {
    if n <=? 0 or ff_env.length =? 0 {return}
    let k=nodes.ptr[n].kind
    if k =? 'assign' {
        let l=ff_local(FloatWord(nodes.ptr[n].a))
        if l >? 0 {
            # (one that may hold an entering NaN still may)
            let nan=ff_env.has(l) and ff_env[l].nan
            ff_env.remove(l);
            if nan {ff_env[l]=ff_enter()}
            ff_forget_fields(l)
        }
        let key=ff_field_key(FloatWord(nodes.ptr[n].a))
        if key not=? 0 {ff_env.remove(key);}
    }
    let mask=isolation_children(k)
    if mask <=? 0 {return}
    if mask & 1 not=? 0 {ff_forget_assigned(FloatWord(nodes.ptr[n].a))}
    if mask & 2 not=? 0 {ff_forget_assigned(FloatWord(nodes.ptr[n].b))}
    if mask & 4 not=? 0 {ff_forget_assigned(FloatWord(nodes.ptr[n].c))}
    if mask & 16 not=? 0 {
        loop c in kids(n) {ff_forget_assigned(c)}
    }
}
# After an if: each local keeps the hull of its bounds on both paths.
ff_join=(other:dict<int64 FR>):>void=>{
    let joined=dict<int64 FR>()
    loop [l r] in ff_env {
        let o=other.get(l)
        if o not=? none {joined[l]=ff_hull(r o)}
    }
    ff_env=joined
}
# The bounds a condition gives its locals where it is `holds` (a comparison
# with a constant, `and` of such; a false comparison may also mean NaN, which
# the bounds of a NaN-free scope need not cover).
ff_refine=(c:FloatWord holds:bool):>void=>$unsafe {
    if c <=? 0 {return}
    let k=nodes.ptr[c].kind
    if k =? 'and_' and holds {
        ff_refine(FloatWord(nodes.ptr[c].a) true)
        ff_refine(FloatWord(nodes.ptr[c].b) true)
        return
    }
    if k =? 'or_' and not holds {
        ff_refine(FloatWord(nodes.ptr[c].a) false)
        ff_refine(FloatWord(nodes.ptr[c].b) false)
        return
    }
    if k =? 'not_' {
        ff_refine(FloatWord(nodes.ptr[c].a) not holds)
        return
    }
    if k =? 'call' and nkids(c) =? 1 {
        ff_refine_test(c holds)
        return
    }
    if k not=? 'binary' {return}
    let op=cx_token_values.ptr[FloatWord(nodes.ptr[c].op)]
    if not holds {
        # (not (x < c) is x >= c, or NaN: the bounds hold for the numbers)
        op=if op =? 'lt' {Tok.ge} else if op =? 'le' {Tok.gt} else if op =? 'gt' {Tok.le} else if op =? 'ge' {Tok.lt} else if op =? 'eq' {Tok.ne} else if op =? 'ne' {Tok.eq} else {Tok.eof}
    }
    let a=FloatWord(nodes.ptr[c].a)
    let b=FloatWord(nodes.ptr[c].b)
    # (a comparison that holds, other than not=?, means neither side is NaN)
    let ordered=holds and (op =? 'lt' or op =? 'le' or op =? 'gt' or op =? 'ge' or op =? 'eq')
    ff_bound(a op ff_eval_pure(b) ordered)
    let flipped=if op =? 'lt' {Tok.gt} else if op =? 'le' {Tok.ge} else if op =? 'gt' {Tok.lt} else if op =? 'ge' {Tok.le} else {op}
    ff_bound(b flipped ff_eval_pure(a) ordered)
}
# The library's float tests as guards: `is_finite(x)` holding is a finite x, `is_nan(x)` failing
# a number, `is_inf(x)` failing a finite x or NaN.
ff_refine_test=(c:FloatWord holds:bool):>void=>$unsafe {
    if nodes.ptr[c].aux not=? 0 or nodes.ptr[c].sym <=? 0 {return}
    let d=FloatWord(fns.ptr[FloatWord(nodes.ptr[c].sym)].decl)
    if d =? 0 or not pos_in_lib(nodes.ptr[d].pos) {return}
    let name=name_of(FloatWord(nodes.ptr[d].name))
    let x=kid(c 0)
    let limit=FR(FF_MAX FF_MAX)
    let below=FR((-FF_MAX) (-FF_MAX))
    if name =? "is_finite" and holds {
        ff_bound(x 'le' limit true)
        ff_bound(x 'ge' below true)
    }
    else if name =? "is_nan" and not holds {ff_bound(x 'eq' FR((-__INF) __INF) true)}
    else if name =? "is_inf" and not holds {
        ff_bound(x 'le' limit false)
        ff_bound(x 'ge' below false)
    }
}
# (bounds of an operand already evaluated: constants and tracked locals only)
ff_eval_pure=(n:FloatWord):>FR=>$unsafe {
    let k=nodes.ptr[n].kind
    if k =? 'float_lit' {return ff_literal(nodes.ptr[n].fval)}
    if k =? 'int_lit' {return FR(float64(nodes.ptr[n].ival) float64(nodes.ptr[n].ival))}
    if k =? 'unary' and nodes.ptr[n].op =? int32(59) {
        let a=ff_eval_pure(FloatWord(nodes.ptr[n].a))
        return FR((-a.hi) (-a.lo))
    }
    if k =? 'conv' {return ff_eval_pure(FloatWord(nodes.ptr[n].a))}
    let l=ff_local(n)
    if l >? 0 {
        let r=ff_env.get(l)
        if r not=? none {return r}
    }
    let key=ff_field_key(n)
    if key not=? 0 {
        let r=ff_env.get(key)
        if r not=? none {return r}
    }
    FR((-__INF) __INF)
}
# x op other: x's new bounds, when x is a tracked float local.
ff_bound=(x0:FloatWord op:Tok other:FR ordered:bool):>void=>$unsafe {
    let x=x0
    loop x >? 0 and nodes.ptr[x].kind =? 'conv' and nodes.ptr[x].aux =? int32(int64(CV.float_)) {x=FloatWord(nodes.ptr[x].a)}
    let l=ff_local(x)
    if l =? 0 {
        l=ff_field_key(x)
        if l =? 0 {return}
        # (not (x >? c) may also be NaN, and a field read enters as one)
        if not ff_env.has(l) {ff_env[l]=ff_enter()}
    }
    else {
        let lt=FloatWord(locals.ptr[l].type)
        if lt <=? 0 or not is_float(lt) {return}
    }
    let r=ff_env.get(l) ?? ff_top()
    if ordered and r.nan {
        r.nan=false
        ff_env[l]=r
    }
    # (`not (x >? c)` holds for NaN as well: its bounds describe the numbers)
    if not ordered and op not=? 'eq' and op not=? 'ne' and ff_assume & FF_NAN =? 0 {r.nan=true}
    # (strictly below c: at most the float below it, so `x <? 256.0` truncates to a uint8)
    if op =? 'lt' {r.hi=min(r.hi ff_below(other.hi))}
    else if op =? 'le' {r.hi=min(r.hi other.hi)}
    else if op =? 'gt' {r.lo=max(r.lo (-ff_below(-other.lo)))}
    else if op =? 'ge' {r.lo=max(r.lo other.lo)}
    else if op =? 'eq' {
        r.lo=max(r.lo other.lo)
        r.hi=min(r.hi other.hi)
    }
    else if op =? 'ne' and other.lo =? 0.0 and other.hi =? 0.0 {
        # (x not=? 0.0: the nearest numbers to zero are the smallest subnormals)
        if r.lo =? 0.0 {r.lo=5e-324}
        else if r.hi =? 0.0 {r.hi=-5e-324}
        else {return}
    }
    else {return}
    if r.lo >? r.hi {return}
    ff_env[l]=r
}
# The largest float below finite x (x itself otherwise).
ff_below=(x:float64):>float64=>{
    if x not=? x or x =? __INF or x =? -__INF {return x}
    if x =? 0.0 {return -5e-324}
    let bits=FloatWord(f64_bits(x))
    f64_from_bits(uint64<overflow='wrap'>(if x >? 0.0 {bits - 1} else {bits + 1}))
}
# Only scopes needing float facts demand integer operands from the existing
# facts traversal. The bridge is node-indexed, O(1) per conversion (plus the
# bounded endpoint query), and joins repeated observations conservatively.
ff_integer_demand=(n:FloatWord):>bool=>$unsafe {
    n >? 0 and nodes.ptr[n].kind =? 'conv' and nodes.ptr[n].aux =? int32(int64(CV.int2float)) and (dir_floats_any or ff_conversions.has(fact_owner))
}
ff_integer_record=(n:FloatWord value:FloatWord s:FactState):>void=>$unsafe {
    if fact_speculating not=? 0 or not s.live {return}
    let b=fact_bound(s value)
    let r=FR((-__INF) __INF)
    if not b.wide and fact_type(ntype(FloatWord(nodes.ptr[n].a))) not=? T_U64 {
        if b.lo not=? FACT_MIN or not fact_open_endpoint(s value false) {r.lo=float64(b.lo)}
        if b.hi not=? FACT_MAX or not fact_open_endpoint(s value true) {r.hi=float64(b.hi)}
        # Integer-to-float rounding is monotone. A float32 conversion rounds
        # the endpoints to its own precision before float64 analysis uses them.
        if FloatWord(types.ptr[prune(ntype(n))].bits) =? 32 {
            r.lo=float64(float32(r.lo))
            r.hi=float64(float32(r.hi))
        }
    }
    let prior=ff_integer_bounds.get(n)
    if prior not=? none {r=ff_hull(prior r)}
    ff_integer_bounds[n]=r
}
# A conversion: float widths, integers to floats, floats to integers.
ff_conv=(n:FloatWord):>FR=>$unsafe {
    let a=FloatWord(nodes.ptr[n].a)
    let x=ff_eval(a)
    let cv=nodes.ptr[n].aux
    let to=ntype(n)
    if cv =? int32(int64(CV.float_)) {
        if to >? 0 and types.ptr[prune(to)].kind =? 'float_' and FloatWord(types.ptr[prune(to)].bits) =? 32 {
            let m=ff_mode_at(nodes.ptr[n].pos)
            # (from 2^128 - 2^103 on, a float64 rounds to a float32 infinity)
            let limit=3.4028235677973366e38
            if (x.lo <? -limit or x.hi >? limit) and m & FF_INF not=? 0 {ff_obligation(n FF_INF "the value fits float32")}
        }
        return x
    }
    if cv =? int32(int64(CV.int2float)) {
        let known=ff_integer_bounds.get(n)
        if known not=? none {
            if not ff_may_inf(known) {return known}
        }
        if ntype(a) =? T_MATH_INT {
            let m=ff_mode_at(nodes.ptr[n].pos)
            if m & FF_INF not=? 0 {ff_obligation(n FF_INF "the `int` fits a float")}
            return FR((-__INF) __INF)
        }
        # (a narrow or refined integer converts within its bounds: a
        # `count:int64<(>? 0)>` divides without making a NaN)
        let st=refine_storage(a ntype(a))
        let b=ref_interval(st fact_domain(st))
        let lo=if b.lo =? FACT_MIN {-18446744073709551616.0} else {float64(b.lo)}
        let hi=if b.hi =? FACT_MAX {18446744073709551616.0} else {float64(b.hi)}
        return FR(lo hi)
    }
    if cv =? int32(int64(CV.float2int)) {
        if ff_ranging {
        let merged=x
        if ff_operands.has(n) {merged=ff_hull(ff_operands[n] x)}
        ff_operands[n]=merged
    }
        # (a proven range drops the conversion's runtime check)
        let proven=not x.nan and ff_int_fits(x prune(to))
        if proven and to not=? T_MATH_INT {ff_int_proven[n]=true}
        if ff_probing {ff_probe[n]=(ff_probe.get(n) ?? true) and proven}
        else if not proven and ff_conversions.has(ff_fn) and dewy_at(nodes.ptr[n].pos) and dir_panics_demanded() {ff_int_obligation(n prune(to))}
        return ff_top()
    }
    ff_top()
}
# The range a float must lie in to convert to integer type `to` (an `int`: finite).
ff_int_range=(to:FloatWord):>FR=>$unsafe {
    if to =? T_MATH_INT {return FR((-FF_MAX) FF_MAX)}
    let bits:FloatWord=64
    let sg=true
    if types.ptr[to].kind =? 'int_' {
        bits=FloatWord(types.ptr[to].bits)
        sg=types.ptr[to].sign
    }
    # (2^(bits - 1) as a float: 1 << 63 is no int64)
    let half=float64(FloatWord(1) << (min(bits 63) - 1))
    if bits =? 64 {half=9223372036854775808.0}
    FR((if sg {-half} else {0.0}) (if sg {half} else {half * 2.0}))
}
ff_int_fits=(x:FR to:FloatWord):>bool=>{
    let r=ff_int_range(to)
    if to =? T_MATH_INT {return x.lo >=? r.lo and x.hi <=? r.hi}
    x.lo >=? r.lo and x.hi <? r.hi
}
# An unproven float-to-integer conversion (docs/design/no_traps.md): NaN, an
# infinity or a value outside the target fails, so a range guard proves it.
ff_int_obligation=(n:FloatWord to:FloatWord):>void=>$unsafe {
    let shown=ff_shown(FloatWord(nodes.ptr[n].a))
    let what=if to =? T_MATH_INT {"{shown} is finite"} else {"{shown} is a number within the {dt(to)} range"}
    let claim="cannot prove {what} for the conversion to {dt(to)}"
    if dir_defer(n claim true) {
        effect_panic_note(ff_fn n claim);
        return
    }
    let name=if (shown as array<uint8>)[0] =? b'`' and (shown as array<uint8>)[1] not=? b'.' {shown.byte_slice(1 (shown as array<uint8>).length - 1)} else {"x"}
    let r=ff_int_range(to)
    let low=if FloatWord(types.ptr[to].bits) =? 64 and types.ptr[to].sign {"float64(int64.min)"} else {"{int64(r.lo)}.0"}
    let high=if FloatWord(types.ptr[to].bits) =? 64 and types.ptr[to].sign {"float64(int64.max)"} else if FloatWord(types.ptr[to].bits) =? 64 {"1.8e19"} else {"{int64(r.hi)}.0"}
    let guard=if to =? T_MATH_INT {"is_finite({name})"} else {"{low} <=? {name} and {name} <? {high}"}
    err_notes.push([(-1) "help: NaN, an infinity or a value out of range fails the conversion: guard it (`if {guard}`, a comparison that holds only for numbers), or check it at run time with `$runtime_checks`"])
    fatal(nodes.ptr[n].pos claim);
}
# After checking: walk the functions in `$no_nan`/`$no_inf` scopes, and those
# converting a float to an integer where obligations are demanded.
floats_after_facts=():>void=>$unsafe {
    floats_reset()
    let conversions=ff_conversions.length >? 0 and dir_panics_demanded()
    if not dir_floats_any and not conversions {return}
    ff_files=dict<int64 bool>()
    ff_owners=dict<int64 bool>()
    loop s in dir_scopes {
        if (s.setting =? dir_name_no_nan or s.setting =? dir_name_no_inf) and s.value =? 1 {
            ff_files[pos_file(s.start)]=true
            # (a block setting: the function it is written in)
            ff_owners[ff_owner_at(s.start)]=true
        }
    }
    loop f in [1..fns.length) {
        let body=FloatWord(fns.ptr[f].body)
        if body =? 0 or fns.ptr[f].state not=? 2 {continue}
        let p=nodes.ptr[body].pos
        if pos_in_lib(p) {continue}
        ff_assume=ff_mode_at(p)
        if not ff_callers.has(f) and not (conversions and ff_conversions.has(f)) {
            if not ff_files.has(pos_file(p)) {continue}
            if ff_assume =? 0 and not ff_owners.has(f) {continue}
        }
        ff_walk(f)
    }
    ff_env=dict<int64 FR>()
    ff_fn=0
}
# effects.jo: the float-to-integer conversions f's body proves, reporting nothing.
ff_probe_function=(f:FloatWord):>dict<int64 bool>=>$unsafe {
    ff_probe=dict<int64 bool>()
    let body=FloatWord(fns.ptr[f].body)
    if body =? 0 or fns.ptr[f].state not=? 2 or ff_probing {return ff_probe}
    ff_probing=true
    let saved_env=ff_env
    let saved_assume=ff_assume
    let saved_fn=ff_fn
    ff_assume=ff_mode_at(nodes.ptr[body].pos)
    ff_walk(f)
    ff_env=saved_env
    ff_assume=saved_assume
    ff_fn=saved_fn
    ff_probing=false
    ff_probe
}
# facts.jo: the range of a float-to-integer conversion's operand in f, from
# the guards before it, as checking would find it; a conversion the walk does
# not reach (a lambda's) has none. One silent walk of f's body per function
# with a demanded conversion, memoized: O(body).
ff_conversion_operand=(f:FloatWord n:FloatWord):>FR | none=>$unsafe {
    if not ff_ranged.has(f) {
        if ff_probing or ff_ranging or not ff_conversions.has(f) {return none}
        ff_ranged[f]=true
        let body=FloatWord(fns.ptr[f].body)
        if body =? 0 or fns.ptr[f].state not=? 2 {return none}
        let saved_env=ff_env
        let saved_assume=ff_assume
        let saved_fn=ff_fn
        let saved_probe=ff_probe
        ff_probing=true
        ff_ranging=true
        ff_probe=dict<int64 bool>()
        ff_assume=ff_mode_at(nodes.ptr[body].pos)
        ff_walk(f)
        ff_env=saved_env
        ff_assume=saved_assume
        ff_fn=saved_fn
        ff_probe=saved_probe
        ff_probing=false
        ff_ranging=false
    }
    ff_operands.get(n)
}
ff_walk=(f:FloatWord):>void=>$unsafe {
    let body=FloatWord(fns.ptr[f].body)
    ff_fn=f
    ff_env=dict<int64 FR>()
    # (direct callers prove the properties demanded by the body's scope; a lambda or function
    # used as a value still receives unchecked parameters)
    let decl=FloatWord(fns.ptr[f].decl)
    let entering=fns.ptr[f].kind =? int32(FK_LAMBDA) or ff_scope_decl(decl) =? 0 or ff_indirect.has(decl)
    loop l in fns.ptr[f].params {
        if ff_tracked(l) and FloatWord(locals.ptr[l].type) >? 0 and is_float(FloatWord(locals.ptr[l].type)) {ff_env[l]=if entering {ff_enter()} else {ff_top()}}
    }
    let r=ff_eval(body)
    # (the value an expression body gives: returned)
    let tail=body
    if nodes.ptr[body].kind =? 'block' {
        tail=0
        let m=nkids(body)
        if nodes.ptr[body].aux not=? 0 and m >? 0 and nodes.ptr[kid(body m - 1)].kind =? 'exprstmt' {tail=FloatWord(nodes.ptr[kid(body m - 1)].a)}
    }
    if tail not=? 0 and ff_float(tail) and FloatWord(fns.ptr[f].ret) >? 0 and is_float(prune(FloatWord(fns.ptr[f].ret))) {ff_use(tail r);}
}
# The innermost function whose body starts at or before p, in p's file.
ff_owner_at=(p:FloatWord):>FloatWord=>$unsafe {
    let best:FloatWord=0
    let at:FloatWord=-1
    loop f in [1..fns.length) {
        let body=FloatWord(fns.ptr[f].body)
        if body =? 0 {continue}
        let q=nodes.ptr[body].pos
        if pos_file(q) =? pos_file(p) and q <=? p and q >? at {
            best=f
            at=q
        }
    }
    best
}
# Lowering: the runtime check of a deferred obligation, on the result v.
float_check=(e:FloatWord v:FloatWord t:FloatWord):>void=>$unsafe {
    let kinds=ff_checks.get(e) ?? 0
    if kinds =? 0 {return}
    let ty=vt_of(t)
    if ty not=? VF and ty not=? VS {return}
    if kinds & FF_NAN not=? 0 {
        iff(e_bin('fne' ty v v));
        e_call_nr(rt("__assert_fail") [e_daddr(str_data("produced NaN under `$no_nan`")) e_daddr(loc_data(nodes.ptr[e].pos))] (-1));
        endc();
    }
    else if kinds & FF_ENTER not=? 0 {
        iff(e_bin('fne' ty v v));
        e_call_nr(rt("__assert_fail") [e_daddr(str_data("a NaN entered `$no_nan`")) e_daddr(loc_data(nodes.ptr[e].pos))] (-1));
        endc();
    }
    if kinds & (FF_INF | FF_ENTER_INF) not=? 0 {
        # (v - v is NaN for an infinity, and for NaN)
        let d=e_bin('fsub' ty v v)
        iff(e_bin('and_' VI e_bin('feq' ty v v) e_bin('fne' ty d d)));
        let message=if kinds & FF_ENTER_INF not=? 0 {"an infinity entered `$no_inf`"} else {"produced an infinity under `$no_inf`"}
        e_call_nr(rt("__assert_fail") [e_daddr(str_data(message)) e_daddr(loc_data(nodes.ptr[e].pos))] (-1));
        endc();
    }
}

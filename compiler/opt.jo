# IR cleanup run on every function after lowering, for both targets: constant folding,
# strength reduction, copy propagation and dead code removal. It is a couple of linear
# passes over the code, so it pays for itself in faster register allocation and emission.

use 'ir.jo'
use 'types.jo'
use 'util.jo'

const MIN_INT = -9223372036854775807 - 1

struct OptReg:
    ndef: i32                   # static definitions (params count as one)
    stable: bool                # single definition preceding every use
    defpos: i32 = -1             # last definition position
    first: i32 = 2147483647      # first use position
    nuse: i32
    constant: bool              # single-def integer constant
    cval: int
    repl: i32                   # copy propagation's replacement vreg
    ver: i32                    # definitions emitted (CSE validity)
    dop: i32 = -1               # defining op of a stable value
    da: i32
    db: i32
    dva: i32                    # operand versions at that definition
    dvb: i32

# The optimizer exclusively owns this workspace. Raw views avoid repeating
# bounds/ownership checks for every metadata field; growth refreshes the view.
# Vreg indices come from the IR; grow before publishing a newly created vreg.
# Never retain a pointer to an entry across o_tmp/o_kconst, which can grow it.
o_reg_storage: OptReg[]
o_regs: *OptReg
o_reg_count = 0
o_fact_scope: i32[]      # two entries per vreg: known false, known true
o_fact_nbr: int[]        # branch count when each fact was established

# rewrite the used vregs of ins through their replacement entries
o_rewrite = (ins: mut Ins):
    a = int(ins.a)
    bb = int(ins.b)
    match ins.op:
        nop, block, loop, end, else_, br, trap, zeroslots, iconst, fconst, slot, gaddr, daddr, faddr: pass
        intr, call, syscall:
            loop k in [0..bb): ir.args[a + k] = o_regs[int(ir.args[a + k])].repl
        calli, callc:
            loop k in [0..bb): ir.args[a + k] = o_regs[int(ir.args[a + k])].repl
            ins.c = o_regs[int(ins.c)].repl
        if_, brif, zero, brtable, assume:
            ins.a = o_regs[a].repl
        ret:
            if a >= 0: ins.a = o_regs[a].repl
        memcpy, memset, select, vop, memeq, findb:
            ins.a = o_regs[a].repl
            ins.b = o_regs[bb].repl
            ins.c = o_regs[int(ins.c)].repl
        load:
            ins.a = o_regs[a].repl
            if int(ins.c) & M_INDEX != 0: ins.b = o_regs[bb].repl
        store:
            ins.a = o_regs[a].repl
            ins.b = o_regs[bb].repl
            if int(ins.c) & M_INDEX != 0: ins.dst = o_regs[int(ins.dst)].repl
        vst:
            ins.a = o_regs[a].repl
            ins.b = o_regs[bb].repl
            ins.dst = o_regs[int(ins.dst)].repl
        vsplat: ins.a = o_regs[a].repl
        vzu: pass
        mov, neg, not_, fneg, fsqrt, fabs, ffloor, fceil, ftrunc, sext8, sext16, sext32, zext8, zext16, zext32, i2f, u2f, f2i, f2f, bits2f, f2bits:
            ins.a = o_regs[a].repl
        _:
            ins.a = o_regs[a].repl
            ins.b = o_regs[bb].repl

o_pure = (op: Op) -> bool:
    match op:
        select: true
        iconst, fconst, mov, slot, gaddr, daddr, faddr, load: true
        add, sub, mul, divs, divu, rems, remu, and_, or_, xor, shl, shrs, shru, neg, not_, mulhs, mulhu, overflow_add, overflow_sub, overflow_mul: true
        eq, ne, lts, les, gts, ges, ltu, leu, gtu, geu: true
        fadd, fsub, fmul, fdiv, fneg, fsqrt, fmin, fmax, ffloor, fceil, fabs, ftrunc: true
        feq, fne, flt, fle, fgt, fge: true
        sext8, sext16, sext32, zext8, zext16, zext32, i2f, u2f, f2i, f2f, bits2f, f2bits: true
        vld, vbin, vsplat, memeq, streq: true
        _: false

o_resize = (n: int):
    if o_reg_count < n:
        o_reg_storage.resize(n)
        o_regs = data(o_reg_storage)
        o_reg_count = n
        o_fact_scope.resize(n * 2)
        o_fact_nbr.resize(n * 2)
    loop v in [0..n):
        o_regs[v] = OptReg(repl = i32(v))
        o_fact_scope[v * 2] = -1
        o_fact_scope[v * 2 + 1] = -1

log2_exact = (x: int) -> int:
    if x <= 0 or x & (x - 1) != 0: return -1
    k = 0
    loop (1 << k) != x: k += 1
    k

shru_val = (a: int, k: int) -> int:
    if k == 0: return a
    (a >> k) & ((1 << (64 - k)) - 1)

ult = (a: int, b: int) -> bool: ((a xor MIN_INT)) < ((b xor MIN_INT))

is_k = (v: int) -> bool: o_regs[v].constant

# fold an integer operation on constants; returns (ok, value)
fold = (op: Op, x: int, y: int) -> (bool, int):
    match op:
        overflow_add: (true, int(math_word_overflow(0, x, y)))
        overflow_sub: (true, int(math_word_overflow(1, x, y)))
        overflow_mul: (true, int(math_word_overflow(2, x, y)))
        add: (true, x + y)
        sub: (true, x - y)
        mul: (true, x * y)
        divs:
            if y == 0 or (x == MIN_INT and y == -1): return (false, 0)
            (true, x / y)
        rems:
            if y == 0 or (x == MIN_INT and y == -1): return (false, 0)
            (true, x % y)
        and_: (true, x & y)
        or_: (true, x | y)
        xor: (true, (x xor y))
        shl: (true, x << (y & 63))
        shrs: (true, x >> (y & 63))
        shru: (true, shru_val(x, y & 63))
        eq: (true, int(x == y))
        ne: (true, int(x != y))
        lts: (true, int(x < y))
        les: (true, int(x <= y))
        gts: (true, int(x > y))
        ges: (true, int(x >= y))
        ltu: (true, int(ult(x, y)))
        leu: (true, int(not ult(y, x)))
        gtu: (true, int(ult(y, x)))
        geu: (true, int(not ult(x, y)))
        _: (false, 0)

fold_un = (op: Op, x: int) -> (bool, int):
    match op:
        neg: (true, -x)
        not_: (true, ~x)
        sext8: (true, (x << 56) >> 56)
        sext16: (true, (x << 48) >> 48)
        sext32: (true, (x << 32) >> 32)
        zext8: (true, x & 255)
        zext16: (true, x & 65535)
        zext32: (true, x & 4294967295)
        _: (false, 0)

# comparison with its operands swapped
mirror = (op: Op) -> Op:
    match op:
        lts: .gts
        les: .ges
        gts: .lts
        ges: .les
        ltu: .gtu
        leu: .geu
        gtu: .ltu
        geu: .leu
        _: op

commutes = (op: Op) -> bool:
    op == .add or op == .mul or op == .and_ or op == .or_ or op == .xor or op == .eq or op == .ne

o_out: Ins[]
o_kmap: {int: int} = {}     # constant value -> canonical constant vreg

o_kconst = (v: int) -> int:
    if ir_fits32(v):
        if let c = o_kmap.get(v): return c
        k = k_vreg(v)
        o_resize_one(k)
        o_regs[k].ndef = 1
        o_regs[k].stable = true
        o_regs[k].constant = true
        o_regs[k].cval = v
        o_kmap[v] = k
        return k
    d = vreg(VI)
    o_resize_one(d)
    o_regs[d].ndef = 1
    o_regs[d].stable = true
    o_regs[d].constant = true
    o_regs[d].cval = v
    o_emit(Ins(.iconst, VI, i32(d), 0, 0, 0, v))
    int(o_regs[d].repl)

o_resize_one = (d: int):
    if o_reg_count <= d:
        o_reg_storage.resize(d + 1)
        o_regs = data(o_reg_storage)
        o_reg_count = d + 1
        o_fact_scope.resize((d + 1) * 2)
        o_fact_nbr.resize((d + 1) * 2)
    o_regs[d] = OptReg(repl = i32(d))
    o_fact_scope[d * 2] = -1
    o_fact_scope[d * 2 + 1] = -1

# (results may be replaced by an existing equal value)
o_bin = (op: Op, d: int, a: int, b: int) -> int:
    o_emit(Ins(op, VI, i32(d), i32(a), i32(b), 0, 0))
    int(o_regs[d].repl)

o_tmp = () -> int:
    d = vreg(VI)
    o_resize_one(d)
    o_regs[d].ndef = 1
    o_regs[d].stable = true
    d

# can uses of d be replaced by s? both must be single-definition values defined before use
o_can_alias = (d: int, s: int) -> bool:
    if o_regs[d].ndef != 1: return false
    if o_regs[d].first < o_regs[d].defpos: return false
    if o_regs[s].ndef != 1: return vtype(d) == vtype(s) and o_holds(d, s)
    if s >= ir.nparams and o_regs[s].first < o_regs[s].defpos: return false
    vtype(d) == vtype(s)

# d = s (s defined more than once, like a loop counter): may d's uses read s instead? Yes if s
# is not redefined from there to d's last use, and the copy dominates the uses (the construct
# open at the copy stays open: no path reaches a use around it, as through a loop's back edge).
# A use in a loop entered after the copy sees s again on the next iteration: s must not change
# anywhere in that loop either.
o_lastuse: i32[]
o_depth: i32[]          # open constructs at each position (an else counts as inside its if)
o_holds = (d: int, s: int) -> bool:
    q = int(o_regs[d].defpos)
    e = int(o_lastuse[d])
    if q < 0 or e < q: return false
    dq = o_depth[q]
    # (constructs opened after the copy, and how deep the outermost loop among them is)
    open: Op[]
    loop_at = -1        # open.len() when the outermost such loop that is open at the last use opened
    p = q + 1
    loop p <= e or (loop_at >= 0 and open.len() > loop_at):
        if p >= ir.code.len() or p - q > 4000: return false
        ins = ir.code[p]
        op = ins.op
        if o_depth[p] < dq: return false
        if op == .else_ and o_depth[p] == dq: return false
        if o_defines(op) and int(ins.dst) == s: return false
        if op == .zeroslots:
            loop k in [0..int(ins.b)):
                item = int(ir.args[int(ins.a) + k])
                if item & 1 == 1 and item >> 1 == s: return false
        if op == .block or op == .if_ or op == .loop: open.push(op)
        else if op == .end and open.len() > 0: open.pop()
        if p == e:
            loop j in [0..open.len()):
                if open[j] == .loop:
                    loop_at = j
                    break
        p += 1
    true

# ---------------- common subexpressions ----------------
# A hash table of available values keyed by (op, type, operands, immediate). Entries belong to
# their control construct. An unconditional block can export its prefix before
# the first branch; conditional arms and loops never export. Loads also die when
# memory may have changed (any store or call bumps the memory generation).
# Keep one probed entry together instead of visiting ten separate arrays.
# The key and validity metadata occupy 64 bytes; their meaning is unchanged.
struct AvailableValue:
    key1: int
    key2: int
    key3: int
    value: i32
    scope: i32
    branches: int
    generation: int
    epoch: int
    version_a: i32
    version_b: i32

ht_storage: AvailableValue[]
ht_entries: *AvailableValue
ht_mask = 0
o_epoch = 0
o_gen = 0              # memory generation for integer data
o_genf = 0             # memory generation for float data (distinct unless raw pointers are used)
o_genh = 0             # memory generation for object headers (refcounts, lengths)
struct OptScope:
    branches: int
    parent: i32
    open: bool
    export_prefix: bool

o_scope_storage: OptScope[] # by scope serial
o_scope_info: *OptScope
o_scopes: int[]         # open scopes, innermost last

ht_setup = (n: int):
    size = 64
    loop size < n * 4: size *= 2
    if ht_storage.len() < size: ht_storage.resize(size)
    ht_entries = data(ht_storage)
    ht_mask = size - 1
    o_epoch += 1
    o_gen = 0
    o_genf = 1 << 40
    o_genh = 2 << 40
    o_scope_storage.clear()
    o_scopes.clear()
    o_scope_open()

o_scope_open = (export_prefix: bool = false):
    parent = -1
    if o_scopes.len() > 0: parent = o_scopes[o_scopes.len() - 1]
    o_scope_storage.push(OptScope(o_nbr, i32(parent), true, export_prefix))
    o_scope_info = data(o_scope_storage)
    o_scopes.push(o_scope_storage.len() - 1)

o_scope_close = ():
    o_scope_info[o_scopes.pop()].open = false

ht_slot = (k1: int, k2: int, k3: int) -> int:
    h = (k1 * -7046029254386353131) xor (k2 * -4417276706812531889) xor (k3 * 1609587929392839161)
    i = (h >> 29) & ht_mask
    loop ht_entries[i].epoch == o_epoch:
        if ht_entries[i].key1 == k1 and ht_entries[i].key2 == k2 and ht_entries[i].key3 == k3: return i
        i = (i + 1) & ht_mask
    i

ht_available = (i: int, gen: int, va: int, vb: int) -> int:
    if ht_entries[i].epoch != o_epoch: return -1
    scope = int(ht_entries[i].scope)
    loop not o_scope_info[scope].open:
        # Every exit from this block passes its straight-line prefix. After
        # any earlier branch the value might have been skipped, so discard it.
        if not o_scope_info[scope].export_prefix or ht_entries[i].branches != o_scope_info[scope].branches: return -1
        scope = int(o_scope_info[scope].parent)
        if scope < 0: return -1
    if gen >= 0 and ht_entries[i].generation != gen: return -1
    if int(ht_entries[i].version_a) != va or int(ht_entries[i].version_b) != vb: return -1
    int(ht_entries[i].value)

mem_gen = (mode: int) -> int:
    if ir.raw_mem: return o_gen
    if mode & M_HDR != 0: return o_genh
    if mode & M_FLOAT != 0: return o_genf
    o_gen

kill_mem = (mode: int):
    if ir.raw_mem: kill_all()
    else if mode & M_HDR != 0: o_genh += 1
    else if mode & M_FLOAT != 0: o_genf += 1
    else: o_gen += 1

kill_all = ():
    o_gen += 1
    o_genf += 1
    o_genh += 1

ht_put_gen = (k1: int, k2: int, k3: int, v: int, gen: int, va: int, vb: int):
    ht_insert(ht_slot(k1, k2, k3), k1, k2, k3, v, gen, va, vb)

load_key1 = (ty: int, mode: int, addr: int) -> int: int(Op.load) | (ty << 8) | ((mode & 4095) << 12) | (addr << 24)

ht_insert = (i: int, k1: int, k2: int, k3: int, v: int, gen: int, va: int, vb: int):
    # The probe returns an index masked to the current table capacity.
    scope = i32(o_scopes[o_scopes.len() - 1])
    ht_entries[i] = AvailableValue(k1, k2, k3, i32(v), scope, o_nbr, gen, o_epoch, i32(va), i32(vb))


# a value that is defined once and never read before its definition
stable = (v: int) -> bool: o_regs[v].stable

# Available expressions have at most two register operands, always a then b.
# Read their versions directly instead of filling the general operand buffer
# for every expression. -1 means the instruction is not an available value.
cse_arity = (op: Op, mode: int) -> int:
    match op:
        iconst, fconst, slot, gaddr, daddr, faddr: 0
        load: if mode & M_INDEX != 0: 2 else: 1
        neg, not_, fneg, fsqrt, ffloor, fceil, fabs, ftrunc: 1
        sext8, sext16, sext32, zext8, zext16, zext32, i2f, u2f, f2i, f2f, bits2f, f2bits: 1
        add, sub, mul, divs, divu, rems, remu, and_, or_, xor, shl, shrs, shru, mulhs, mulhu, overflow_add, overflow_sub, overflow_mul: 2
        eq, ne, lts, les, gts, ges, ltu, leu, gtu, geu: 2
        fadd, fsub, fmul, fdiv, fmin, fmax, feq, fne, flt, fle, fgt, fge: 2
        _: -1

o_defines = (op: Op) -> bool:
    match op:
        nop, block, loop, end, else_, br, brif, brtable, if_, ret, trap, store, copy, zero, memcpy, memset, zeroslots, assume, vop, vst, vzu: false
        _: true

# append to the output, noting the new definition (invalidates entries that used the old value)
# and counting the uses (what the output reads, for dead code removal and cleanup)
o_push = (ins: Ins):
    d = ir_operands(ins)
    if d >= 0: o_regs[d].ver += 1
    loop k in [0..ir_use_count): o_regs[ir_use(k)].nuse += 1
    o_out.push(ins)

# drop the last output instruction (an empty construct's opening)
o_pop = ():
    ins = o_out.pop()
    if ins.op == .if_: o_regs[int(ins.a)].nuse -= 1

kills_memory = (op: Op) -> bool:
    match op:
        store, copy, zero, memcpy, memset, zeroslots, call, calli, callc, syscall, intr, vop: true
        _: false

o_cse = false
o_nbr = 0              # branches emitted so far

# A final register copy before leaving one arm does not execute on its sibling
# path. Restore that register's version there, then invalidate it at the real
# join. The bounded recognizer handles the common cursor/counter update without
# snapshotting optimizer state or adding a control-flow pass.
struct OptControl:
    kind: int
    condition: int
    branches: int
    deferred: int = -1

o_join_regs: int[]
o_join_next: int[]

o_join_kill = (head: int):
    let head = head
    loop head >= 0:
        o_regs[o_join_regs[head]].ver += 1
        head = o_join_next[head]

o_branch_copy = () -> int:
    n = o_out.len()
    if n < 3 or o_out[n - 2].op != .mov: return -1
    d = int(o_out[n - 2].dst)
    if d < 0 or o_regs[d].ndef <= 1 or o_regs[d].repl != i32(d): return -1
    i = n - 3
    floor = max(0, n - 19)
    loop i >= floor:
        ins = o_out[i]
        op = ins.op
        if op == .brif:
            if ins.imm == 0: return d
            return -1
        if op == .block or op == .loop or op == .if_ or op == .else_ or op == .end or op == .br or op == .brtable or op == .ret or op == .trap or op == .zeroslots: return -1
        if o_defines(op) and ins.dst == i32(d): return -1
        i -= 1
    -1

# v was computed by `op` from operands that still hold the same values here
def_is = (v: int, op: Op) -> bool:
    if not stable(v) or o_regs[v].dop != i32(int(op)): return false
    o_regs[int(o_regs[v].da)].ver == o_regs[v].dva and o_regs[int(o_regs[v].db)].ver == o_regs[v].dvb

o_fits32 = (v: int) -> bool: v >= -2147483648 and v <= 2147483647

o_emit = (ins: Ins): o_transfer(ins, false)

# Only single-definition values have facts. Direct indexing avoids hashing the
# same condition at every branch; both truth values keep their own scope, just
# as separate available-expression keys did.
fact_known = (c: int, truth: int) -> bool:
    if not o_cse or not stable(c): return false
    index = c * 2 + truth
    scope = int(o_fact_scope[index])
    if scope < 0: return false
    loop not o_scope_info[scope].open:
        if not o_scope_info[scope].export_prefix or o_fact_nbr[index] != o_scope_info[scope].branches: return false
        scope = int(o_scope_info[scope].parent)
        if scope < 0: return false
    true

add_fact = (c: int, truth: int):
    if not o_cse or not stable(c): return
    index = c * 2 + truth
    o_fact_scope[index] = i32(o_scopes[o_scopes.len() - 1])
    o_fact_nbr[index] = o_nbr

fact_false = (c: int) -> bool: fact_known(c, 0)
add_fact_false = (c: int): add_fact(c, 0)
fact_true = (c: int) -> bool: fact_known(c, 1)
add_fact_true = (c: int): add_fact(c, 1)

# simplify one instruction, appending the result to o_out
# One opcode-directed forward transfer. Only scalar arithmetic enters folding;
# memory/call/vector/control operations go directly from rewriting to CSE/emission.
# Replacement operations are revisited locally, never by a whole-function sweep.
# The walk is O(input operations + emitted strength-reduction operations), apart
# from the separately bounded copy-lifetime queries and CSE hash probes.
o_transfer = (ins0: Ins, simplify: bool):
    ins = ins0
    loop simplify:
        op = ins.op
        match op:
            iconst: pass
            mov, neg, not_, sext8, sext16, sext32, zext8, zext16, zext32:
                ins.a = o_regs[int(ins.a)].repl
            checked_add, checked_sub, checked_mul, overflow_add, overflow_sub, overflow_mul, add, sub, mul, divs, divu, rems, remu, and_, or_, xor, shl, shrs, shru, eq, ne, lts, les, gts, ges, ltu, leu, gtu, geu:
                ins.a = o_regs[int(ins.a)].repl
                ins.b = o_regs[int(ins.b)].repl
            select:
                ins.a = o_regs[int(ins.a)].repl
                ins.b = o_regs[int(ins.b)].repl
                ins.c = o_regs[int(ins.c)].repl
            calli: o_rewrite(ins)
            _:
                o_rewrite(ins)
                break
        # Inlining and store forwarding can expose the address behind a closure
        # invocation. A stable function address uses the ordinary direct-call ABI.
        if op == .calli:
            fp = int(ins.c)
            at = int(o_regs[fp].defpos)
            if stable(fp) and at >= 0 and ir.code[at].op == .faddr:
                ins.op = .call
                ins.imm = ir.code[at].imm
                ins.c = 0
                op = .call
            break
        d = int(ins.dst)
        a = int(ins.a)
        bb = int(ins.b)
        if op == .checked_add or op == .checked_sub or op == .checked_mul:
            raw = if op == .checked_add: Op.add else if op == .checked_sub: Op.sub else: Op.mul
            if is_k(a) and is_k(bb):
                operation = if op == .checked_add: 0 else if op == .checked_sub: 1 else: 2
                if math_word_overflow(operation, o_regs[a].cval, o_regs[bb].cval):
                    fatal(ir_positions[int(ins.pos)], "integer overflow in constant expression (int64 representation of mathematical int)")
                ok, value = fold(raw, o_regs[a].cval, o_regs[bb].cval)
                ins = Ins(.iconst, VI, i32(d), 0, 0, 0, value)
                continue
            if is_k(bb) and ((raw != .mul and o_regs[bb].cval == 0) or (raw == .mul and (o_regs[bb].cval == 0 or o_regs[bb].cval == 1))):
                ins.op = raw
                continue
            break
        if op == .iconst:
            if stable(d):
                o_regs[d].constant = true
                o_regs[d].cval = ins.imm
            break
        if op == .mov:
            if o_can_alias(d, a):
                o_regs[d].repl = i32(a)
                if o_regs[a].constant:
                    o_regs[d].constant = true
                    o_regs[d].cval = o_regs[a].cval
                return
            if is_k(a) and vtype(d) == VI:
                ins = Ins(.iconst, VI, i32(d), 0, 0, 0, o_regs[a].cval)
                break
            break
        if int(ins.ty) != VI or d < 0:
            break
        # Inlining can make a previously dynamic scalar choice constant. Its
        # inputs were already evaluated, so replacing the selection by a move
        # preserves their effects; ordinary dead-code removal handles pure inputs.
        if op == .select:
            if bb == int(ins.c) or is_k(a) or fact_true(a) or fact_false(a):
                yes = bb == int(ins.c) or (is_k(a) and o_regs[a].cval != 0) or fact_true(a)
                value = if yes: bb else: int(ins.c)
                ins = Ins(.mov, VI, i32(d), i32(value), 0, 0, 0)
                continue
            break
        # The bounded memory comparison already produces a canonical boolean.
        # Inlined bool returns otherwise carry an unnecessary ABI byte extension.
        if op == .zext8 and stable(a) and (o_regs[a].dop == i32(int(Op.memeq)) or o_regs[a].dop == i32(int(Op.streq))):
            ins = Ins(.mov, VI, i32(d), i32(a), 0, 0, 0)
            continue
        # unary integer ops
        if op == .neg or op == .not_ or op == .sext8 or op == .sext16 or op == .sext32 or op == .zext8 or op == .zext16 or op == .zext32:
            if is_k(a):
                ok, v = fold_un(op, o_regs[a].cval)
                if ok:
                    ins = Ins(.iconst, VI, i32(d), 0, 0, 0, v)
                    continue
            break
        # binary integer ops
        if is_k(a) and is_k(bb):
            ok, v = fold(op, o_regs[a].cval, o_regs[bb].cval)
            if ok:
                ins = Ins(.iconst, VI, i32(d), 0, 0, 0, v)
                continue
        if is_k(a) and not is_k(bb):
            if commutes(op):
                ins.a = i32(bb)
                ins.b = i32(a)
            else if mirror(op) != op:
                ins.op = mirror(op)
                ins.a = i32(bb)
                ins.b = i32(a)
            op = ins.op
            a = int(ins.a)
            bb = int(ins.b)
        if not is_k(bb):
            break
        k = o_regs[bb].cval
        # A nonnegative constant mask bounds its result in [0, mask]. Relational
        # comparisons are monotone on that interval, in both signed and unsigned
        # order. Equal endpoints prove the whole comparison; equality is excluded.
        if op == .lts or op == .les or op == .gts or op == .ges or op == .ltu or op == .leu or op == .gtu or op == .geu:
            if def_is(a, .and_) and is_k(int(o_regs[a].db)):
                limit = o_regs[int(o_regs[a].db)].cval
                if limit >= 0:
                    lo = fold(op, 0, k)
                    hi = fold(op, limit, k)
                    if lo.1 == hi.1:
                        ins = Ins(.iconst, VI, i32(d), 0, 0, 0, lo.1)
                        continue
        # identities: result is a
        if (k == 0 and (op == .add or op == .sub or op == .or_ or op == .xor or op == .shl or op == .shrs or op == .shru)) or (k == 1 and (op == .mul or op == .divs or op == .divu)):
            ins = Ins(.mov, VI, i32(d), i32(a), 0, 0, 0)
            continue
        if k == 0 and (op == .mul or op == .and_):
            ins = Ins(.iconst, VI, i32(d), 0, 0, 0, 0)
            continue
        if op == .add and def_is(a, .add) and o_regs[int(o_regs[a].db)].constant:
            o_bin(.add, d, int(o_regs[a].da), o_kconst(k + o_regs[int(o_regs[a].db)].cval))
            return
        sh = log2_exact(k)
        if sh > 0:
            if op == .mul:
                o_bin(.shl, d, a, o_kconst(sh))
                return
            if op == .divu:
                o_bin(.shru, d, a, o_kconst(sh))
                return
            if op == .remu:
                o_bin(.and_, d, a, o_kconst(k - 1))
                return
            if op == .divs or op == .rems:
                # round toward zero: add (2^sh - 1) to negative dividends before shifting
                t1 = o_bin(.shrs, o_tmp(), a, o_kconst(63))
                t2 = o_bin(.shru, o_tmp(), t1, o_kconst(64 - sh))
                t3 = o_bin(.add, o_tmp(), a, t2)
                if op == .divs:
                    o_bin(.shrs, d, t3, o_kconst(sh))
                else:
                    t4 = o_bin(.and_, o_tmp(), t3, o_kconst(-k))
                    o_bin(.sub, d, a, t4)
                return
        if (op == .divs or op == .rems) and k > 1 and sh <= 0 and mulh_ok:
            # by any other constant: a multiply by a "magic" number, its high half, a shift, and a
            # one added to negative dividends (Hacker's Delight 10-1), as C compilers do
            mag, s = div_magic(k)
            q = o_bin(.mulhs, o_tmp(), a, o_kconst(mag))
            if mag < 0: q = o_bin(.add, o_tmp(), q, a)
            if s > 0: q = o_bin(.shrs, o_tmp(), q, o_kconst(s))
            neg = o_bin(.shru, o_tmp(), a, o_kconst(63))
            if op == .divs:
                o_bin(.add, d, q, neg)
            else:
                qq = o_bin(.add, o_tmp(), q, neg)
                t = o_bin(.mul, o_tmp(), qq, o_kconst(k))
                o_bin(.sub, d, a, t)
            return
        if (op == .divu or op == .remu) and k > 1 and sh <= 0 and mulh_ok:
            # unsigned: the high half of a multiply by a magic number, and a shift (with an add when
            # the number needs 65 bits: Hacker's Delight 10-8)
            mag, s, add = divu_magic(u64(k))
            # (the last step writes the quotient straight into d, as the signed one does)
            qd = d
            if op == .remu: qd = o_tmp()
            t = o_bin(.mulhu, o_tmp(), a, o_kconst(int(mag)))
            if add:
                q1 = o_bin(.sub, o_tmp(), a, t)
                q2 = o_bin(.shru, o_tmp(), q1, o_kconst(1))
                if s > 1:
                    q3 = o_bin(.add, o_tmp(), q2, t)
                    o_bin(.shru, qd, q3, o_kconst(s - 1))
                else: o_bin(.add, qd, q2, t)
            else:
                o_bin(.shru, qd, t, o_kconst(s))
            if op == .remu:
                q = int(o_regs[qd].repl)
                m = o_bin(.mul, o_tmp(), q, o_kconst(k))
                o_bin(.sub, d, a, m)
            return
        break
    op = ins.op
    if op == .br or op == .brif or op == .brtable: o_nbr += 1
    if o_cse and (op == .load or op == .store):
        # fold constant offsets into the access: [x + k + imm]
        a = int(ins.a)
        loop def_is(a, .add) and o_regs[int(o_regs[a].db)].constant and o_fits32(ins.imm + o_regs[int(o_regs[a].db)].cval):
            ins.imm += o_regs[int(o_regs[a].db)].cval
            a = int(o_regs[a].da)
        # [base + index << scale + imm] (x86 addressing; wasm computes it)
        if int(ins.c) & M_INDEX == 0 and def_is(a, .add) and not o_regs[int(o_regs[a].db)].constant and not o_regs[int(o_regs[a].da)].constant:
            base = int(o_regs[a].da)
            idx = int(o_regs[a].db)
            scale = 0
            if def_is(idx, .shl) and o_regs[int(o_regs[idx].db)].constant and o_regs[int(o_regs[idx].db)].cval <= 3 and o_regs[int(o_regs[idx].db)].cval >= 0:
                scale = o_regs[int(o_regs[idx].db)].cval
                idx = int(o_regs[idx].da)
            loop def_is(base, .add) and o_regs[int(o_regs[base].db)].constant and o_fits32(ins.imm + o_regs[int(o_regs[base].db)].cval):
                ins.imm += o_regs[int(o_regs[base].db)].cval
                base = int(o_regs[base].da)
            a = base
            ins.c = i32(int(ins.c) | M_INDEX | (scale << 8))
            if op == .store: ins.dst = i32(idx)
            else: ins.b = i32(idx)
        ins.a = i32(a)
    if o_cse:
        arity = cse_arity(op, int(ins.c))
        if arity >= 0:
            d = int(ins.dst)
            va = 0
            vb = 0
            if arity > 0: va = int(o_regs[int(ins.a)].ver)
            if arity > 1: vb = int(o_regs[int(ins.b)].ver)
            k1 = int(op) | (int(ins.ty) << 8) | ((int(ins.c) & 4095) << 12) | (int(ins.a) << 24)
            k2 = int(ins.b)
            k3 = ins.imm
            gen = -1
            if op == .load: gen = mem_gen(int(ins.c))
            slot = ht_slot(k1, k2, k3)
            e = ht_available(slot, gen, va, vb)
            if e >= 0 and vtype(e) == vtype(d):
                if stable(d):
                    o_regs[d].repl = i32(e)
                    if o_regs[e].constant:
                        o_regs[d].constant = true
                        o_regs[d].cval = o_regs[e].cval
                    return
                o_regs[d].ver += 1
                o_regs[e].nuse += 1
                o_out.push(Ins(.mov, i32(vtype(d)), i32(d), i32(e), 0, 0, 0))
                return
            if stable(d):
                ht_insert(slot, k1, k2, k3, d, gen, va, vb)
                o_regs[d].dop = i32(int(op))
                o_regs[d].da = ins.a
                o_regs[d].db = ins.b
                o_regs[d].dva = o_regs[int(ins.a)].ver
                o_regs[d].dvb = o_regs[int(ins.b)].ver
            # CSE already decoded these operands. Account for the surviving
            # operation here instead of decoding it again through o_push.
            o_regs[d].ver += 1
            if arity > 0: o_regs[int(ins.a)].nuse += 1
            if arity > 1: o_regs[int(ins.b)].nuse += 1
            o_out.push(ins)
            return
        else if op == .store:
            mode = int(ins.c)
            kill_mem(mode)
            # store-to-load forwarding for full-width values
            a = int(ins.a)
            v = int(ins.b)
            ix = 0
            vix = 0
            if mode & M_INDEX != 0:
                ix = int(ins.dst)
                vix = int(o_regs[ix].ver)
            if (mode & 15 == 8 or mode & M_FLOAT != 0) and stable(v):
                ht_put_gen(load_key1(int(ins.ty), mode, a), ix, ins.imm, v, mem_gen(mode), int(o_regs[a].ver), vix)
            o_regs[a].nuse += 1
            o_regs[v].nuse += 1
            if mode & M_INDEX != 0: o_regs[ix].nuse += 1
            o_out.push(ins)
            return
        else if op == .assume:
            a = int(ins.a)
            if ins.imm == A_RC1:
                k = o_kconst(1)
                ht_put_gen(load_key1(VI, 8 | M_HDR, a), 0, 0, k, mem_gen(8 | M_HDR), int(o_regs[a].ver), 0)
            return
        else if kills_memory(op) and not (op == .call and ins.c == 1): kill_all()
    # Record the boolean result without making raw-memory reads available
    # expressions: subsequent stores must still perform a new comparison.
    if (op == .memeq or op == .streq) and stable(int(ins.dst)): o_regs[int(ins.dst)].dop = i32(int(op))
    o_push(ins)

# the magic number, shift and whether an add is needed, for dividing an unsigned 64-bit integer
# by d (d >= 2) (Hacker's Delight 10-2)
divu_magic = (d: u64) -> (u64, int, bool):
    two63: u64 = 0x8000000000000000
    max63: u64 = 0x7FFFFFFFFFFFFFFF
    add = false
    nc = (u64(0) - 1) - (u64(0) - d) % d
    p = 63
    q1 = two63 / nc
    r1 = two63 - q1 * nc
    q2 = max63 / d
    r2 = max63 - q2 * d
    loop true:
        p += 1
        if r1 >= nc - r1:
            q1 = q1 * 2 + 1
            r1 = r1 * 2 - nc
        else:
            q1 = q1 * 2
            r1 = r1 * 2
        if r2 + 1 >= d - r2:
            if q2 >= max63: add = true
            q2 = q2 * 2 + 1
            r2 = r2 * 2 + 1 - d
        else:
            if q2 >= two63: add = true
            q2 = q2 * 2
            r2 = r2 * 2 + 1
        delta = d - 1 - r2
        if not (p < 128 and (q1 < delta or (q1 == delta and r1 == 0))): break
    (q2 + 1, p - 64, add)

# the magic number and shift for dividing a signed 64-bit integer by d (d >= 2): q = mulhs(n, m)
# (+ n when m < 0) >> s, plus 1 when n < 0
div_magic = (d: int) -> (int, int):
    two63: u64 = 0x8000000000000000
    ad = u64(d)
    t = two63
    anc = t - 1 - t % ad
    p = 63
    q1 = two63 / anc
    r1 = two63 - q1 * anc
    q2 = two63 / ad
    r2 = two63 - q2 * ad
    loop true:
        p += 1
        q1 = q1 * 2
        r1 = r1 * 2
        if r1 >= anc:
            q1 += 1
            r1 -= anc
        q2 = q2 * 2
        r2 = r2 * 2
        if r2 >= ad:
            q2 += 1
            r2 -= ad
        delta = ad - r2
        if not (q1 < delta or (q1 == delta and r1 == 0)): break
    (int(q2 + 1), p - 64)

# Forward whole-slot copies through dead intermediates after inlining. A
# temporary must have one address definition and exactly two uses: the incoming
# and outgoing copies. No derived address, call, or later observer can exist.
# Both endpoints are distinct stack slots and no write/control boundary may
# intervene, so the source still contains the snapshot the second copy needs.
# Larger records benefit without adding scalar lanes or register pressure.
o_copy_forward = ():
    if ir.raw_mem or ir.slot_size.len() == 0: return
    code = ir.code
    previous = -1
    found = false
    loop i in [0..code.len()):
        ins = code[i]
        if ins.op == .copy:
            if previous >= 0 and ins.b == code[previous].a and ins.imm == code[previous].imm:
                found = true
                break
            previous = i
        else if not o_defines(ins.op) or kills_memory(ins.op): previous = -1
    if not found: return
    nv = ir.vtypes.len()
    ns = ir.slot_size.len()
    ndef = fill(0, nv)
    nuse = fill(0, nv)
    slot = fill(-1, nv)
    addresses = fill(0, ns)
    loop ins in code:
        d = ir_operands(ins)
        if d >= 0: ndef[d] += 1
        loop k in [0..ir_use_count): nuse[ir_use(k)] += 1
        if ins.op == .slot:
            slot[int(ins.dst)] = int(ins.a)
            addresses[int(ins.a)] += 1
        else if ins.op == .zeroslots:
            loop k in [0..int(ins.b)):
                item = int(ir.args[int(ins.a) + k])
                if item & 1 == 1: ndef[item >> 1] += 1
    previous = -1
    loop i in [0..code.len()):
        ins = code[i]
        if ins.op != .copy:
            if not o_defines(ins.op) or kills_memory(ins.op): previous = -1
            continue
        first_pos = previous
        previous = i
        if first_pos < 0: continue
        first = code[first_pos]
        tmp = int(ins.b)
        src = int(first.b)
        dst = int(ins.a)
        if tmp != int(first.a) or ins.imm != first.imm or tmp < 0 or src < 0 or dst < 0: continue
        t = slot[tmp]
        s = slot[src]
        d = slot[dst]
        if t < 0 or s < 0 or d < 0 or t == s or t == d or s == d: continue
        if ndef[tmp] != 1 or ndef[src] != 1 or ndef[dst] != 1 or nuse[tmp] != 2 or addresses[t] != 1: continue
        if ins.imm != int(ir.slot_size[t]) or ins.imm != int(ir.slot_size[s]) or ins.imm != int(ir.slot_size[d]): continue
        code[first_pos].op = .nop
        code[i].b = first.b
    ir.code = code

# ---------------- small slots to registers ----------------
# Non-escaping slots of at most four lanes (32 bytes) become registers. Standalone byte and
# two-byte slots use one integer lane. Four-byte lanes cover
# vec2..vec4 and small i32/f32 records; eight-byte lanes cover i64/f64 records.
# Mixed-width accesses, incompatible lane kinds, and escaping addresses retain
# memory storage. Address discovery also selects lane widths, without another
# full optimization pass. Larger records stay in memory to bound register pressure.
# One function-local indexed workspace, shared by discovery, escape validation
# and rewriting. Its storage is reused, but no pointer escapes an optimization.
struct SraValue:
    defpos: int = -1
    ndef: int
    slot: int = -1
    offset: int
    constant: bool
    kval: int

struct SraSlot:
    width: int = 8
    ok: bool

struct SraLane:
    kind: int              # 0 untyped bits, 1 float, 2 integer
    reg: int = -1

sra_value_storage: SraValue[]
sra_slot_storage: SraSlot[]
sra_lane_storage: SraLane[]
sra_values: *SraValue
sra_slots: *SraSlot
sra_lanes: *SraLane
sra_nv = 0

sra_workspace = (nv: int, ns: int):
    if sra_value_storage.len() < nv: sra_value_storage.resize(nv)
    if sra_slot_storage.len() < ns: sra_slot_storage.resize(ns)
    if sra_lane_storage.len() < ns * 4: sra_lane_storage.resize(ns * 4)
    sra_values = data(sra_value_storage)
    sra_slots = data(sra_slot_storage)
    sra_lanes = data(sra_lane_storage)
    loop v in [0..nv): sra_values[v] = SraValue()
    loop slot in [0..ns):
        size = int(ir.slot_size[slot])
        width = 8
        if size == 1 or size == 2: width = size
        else if size % 8 != 0: width = 4
        sra_slots[slot] = SraSlot(width, false)

sra_shift = (width: int) -> int: if width == 8: 3 else: width >> 1

# May this byte range be used as lanes of kind k (0: just bits, copied)?
sra_lane_use = (s: int, off: int, bytes: int, k: int) -> bool:
    width = sra_slots[s].width
    if int(ir.slot_size[s]) >> sra_shift(width) > 4: return false
    if k == 1 and width < 4: return false
    if off < 0 or off & (width - 1) != 0 or bytes & (width - 1) != 0 or off + bytes > int(ir.slot_size[s]): return false
    loop i in [0..(bytes >> sra_shift(width))):
        j = s * 4 + (off >> sra_shift(width)) + i
        if k != 0:
            if sra_lanes[j].kind != 0 and sra_lanes[j].kind != k: return false
            sra_lanes[j].kind = k
    true

sra_is_p = (v: int) -> bool: v >= 0 and v < sra_nv and sra_values[v].slot >= 0 and sra_slots[sra_values[v].slot].ok
sra_lane_of = (v: int, i: int) -> int: sra_lanes[sra_values[v].slot * 4 + (sra_values[v].offset >> sra_shift(sra_slots[sra_values[v].slot].width)) + i].reg

# A lane as vreg type ty, preserving bits between equal-width float/integer lanes.
sra_as_ty = (out: mut Ins[], x: int, ty: int) -> int:
    if vtype(x) == ty: return x
    t = vreg(ty)
    if ty != VI: out.push(Ins(.bits2f, i32(ty), i32(t), i32(x), 0, 0, 0))
    else: out.push(Ins(.f2bits, i32(vtype(x)), i32(t), i32(x), 0, 0, 0))
    t

# Resolve only address definitions that have a use. The chain follows strictly
# earlier definitions, so it is acyclic; each candidate is memoized once. The
# explicit stack avoids compiler-stack growth for long address chains.
sra_chain: int[]
sra_resolve_address = (value: int) -> int:
    sra_chain.clear()
    v = value
    loop sra_values[v].slot == -2:
        pos = sra_values[v].defpos
        if sra_values[v].ndef != 1:
            sra_values[v].slot = -1
            break
        ins = ir.code[pos]
        a = int(ins.a)
        if sra_values[a].defpos >= pos:
            sra_values[v].slot = -1
            break
        if ins.op == .add:
            b = int(ins.b)
            if not is_kv(b) and not (sra_values[b].constant and sra_values[b].ndef == 1 and sra_values[b].defpos < pos):
                sra_values[v].slot = -1
                break
        sra_chain.push(v)
        v = a
    loop sra_chain.len() > 0:
        d = sra_chain.pop()
        ins = ir.code[sra_values[d].defpos]
        a = int(ins.a)
        sra_values[d].slot = sra_values[a].slot
        if sra_values[a].slot >= 0:
            offset = sra_values[a].offset
            if ins.op == .add:
                b = int(ins.b)
                offset += if is_kv(b): kv_of(b) else: sra_values[b].kval
            sra_values[d].offset = offset
    sra_values[value].slot

# Keep the overwhelmingly common cached query separate from chain resolution.
sra_address = (value: int) -> int:
    slot = sra_values[value].slot
    if slot == -2: return sra_resolve_address(value)
    slot

# O(N + U + A + M + output): one definition index, one use walk, and a
# worklist containing only M slot-memory operations. Address resolution visits
# each of A demanded definitions once. The final rewrite runs only on success.
o_sra = ():
    ns = ir.slot_size.len()
    if ns == 0: return
    code = ir.code
    nv = ir.vtypes.len()
    sra_nv = nv
    sra_workspace(nv, ns)
    roots: int[]
    loop pos in 0.. and ins in code:
        d = int(ins.dst)
        op = ins.op
        if d < 0 or not o_defines(op): continue
        sra_values[d].ndef += 1
        sra_values[d].defpos = pos
        if op == .slot: roots.push(pos)
        else if op == .mov or op == .add: sra_values[d].slot = -2
        if op == .iconst:
            sra_values[d].constant = true
            sra_values[d].kval = ins.imm
    any = false
    loop pos in roots:
        ins = code[pos]
        d = int(ins.dst)
        slot = int(ins.a)
        if sra_values[d].ndef == 1 and int(ir.slot_size[slot]) <= 32:
            sra_values[d].slot = slot
            sra_slots[slot].ok = true
            any = true
        else: sra_values[d].slot = -1
    if not any: return
    pending: int[]
    loop pos in 0.. and ins in code:
        op = ins.op
        a = int(ins.a)
        b = int(ins.b)
        c = int(ins.c)
        match op:
            slot, zeroslots: continue
            mov, add:
                if sra_address(int(ins.dst)) >= 0: continue
            load:
                sa = sra_address(a)
                if sa >= 0:
                    if sra_values[a].defpos < pos and sra_slots[sa].width == 8 and c & 15 != 8: sra_slots[sa].width = 4
                    if c & M_INDEX == 0:
                        pending.push(pos)
                        continue
            store:
                sa = sra_address(a)
                sb = sra_address(b)
                if sb >= 0: sra_slots[sb].ok = false
                if c & M_INDEX != 0:
                    sd = sra_address(int(ins.dst))
                    if sd >= 0: sra_slots[sd].ok = false
                if sa >= 0:
                    if sra_values[a].defpos < pos and sra_slots[sa].width == 8 and c & 15 != 8: sra_slots[sa].width = 4
                    pending.push(pos)
                continue
            vop:
                sa = sra_address(a)
                sb = sra_address(b)
                sc = sra_address(c)
                if sa >= 0 and sra_values[a].defpos < pos: sra_slots[sa].width = 4
                if sb >= 0 and sra_values[b].defpos < pos: sra_slots[sb].width = 4
                if sc >= 0 and sra_values[c].defpos < pos: sra_slots[sc].width = 4
                if sa >= 0 or sb >= 0 or sc >= 0: pending.push(pos)
                continue
            copy, zero:
                sa = sra_address(a)
                sb = if op == .copy: sra_address(b) else: -1
                if sa >= 0 and sra_values[a].defpos < pos and sra_slots[sa].width == 8 and (sra_values[a].offset % 8 != 0 or ins.imm % 8 != 0): sra_slots[sa].width = 4
                if sb >= 0 and sra_values[b].defpos < pos and sra_slots[sb].width == 8 and (sra_values[b].offset % 8 != 0 or ins.imm % 8 != 0): sra_slots[sb].width = 4
                if sa >= 0 or sb >= 0: pending.push(pos)
                continue
            _: pass
        ir_operands(ins)
        loop k in [0..ir_use_count):
            slot = sra_address(ir_use(k))
            if slot >= 0: sra_slots[slot].ok = false
    # Lanes keep their observed numeric kind; copy-only lanes contain integer bits.
    any = false
    loop s in [0..ns):
        if int(ir.slot_size[s]) & (sra_slots[s].width - 1) != 0 or int(ir.slot_size[s]) >> sra_shift(sra_slots[s].width) > 4: sra_slots[s].ok = false
        if sra_slots[s].ok: any = true
    if not any: return
    loop lane in [0..ns * 4): sra_lanes[lane] = SraLane()
    loop pos in pending:
        ins = code[pos]
        op = ins.op
        a = int(ins.a)
        b = int(ins.b)
        c = int(ins.c)
        # every use of a slot address must be one of these
        if op == .load and a >= 0 and sra_values[a].slot >= 0 and c & M_INDEX == 0:
            if c & 15 != sra_slots[sra_values[a].slot].width or not sra_lane_use(sra_values[a].slot, sra_values[a].offset + ins.imm, c & 15, if c & M_FLOAT != 0: 1 else: 2): sra_slots[sra_values[a].slot].ok = false
            continue
        if op == .store:
            if b >= 0 and sra_values[b].slot >= 0: sra_slots[sra_values[b].slot].ok = false
            if c & M_INDEX != 0 and int(ins.dst) >= 0 and sra_values[int(ins.dst)].slot >= 0: sra_slots[sra_values[int(ins.dst)].slot].ok = false
            if a >= 0 and sra_values[a].slot >= 0:
                if c & M_INDEX != 0 or c & 15 != sra_slots[sra_values[a].slot].width or not sra_lane_use(sra_values[a].slot, sra_values[a].offset + ins.imm, c & 15, if c & M_FLOAT != 0: 1 else: 2): sra_slots[sra_values[a].slot].ok = false
            continue
        if op == .vop:
            n = (ins.imm >> 4) & 7
            if a >= 0 and sra_values[a].slot >= 0 and not sra_lane_use(sra_values[a].slot, sra_values[a].offset, 4 * n, 1): sra_slots[sra_values[a].slot].ok = false
            if ins.imm & VOP_SPLAT_B != 0:
                if b >= 0 and sra_values[b].slot >= 0: sra_slots[sra_values[b].slot].ok = false
            else if b >= 0 and sra_values[b].slot >= 0 and not sra_lane_use(sra_values[b].slot, sra_values[b].offset, 4 * n, 1): sra_slots[sra_values[b].slot].ok = false
            if ins.imm & VOP_SPLAT_C != 0:
                if c >= 0 and sra_values[c].slot >= 0: sra_slots[sra_values[c].slot].ok = false
            else if c >= 0 and sra_values[c].slot >= 0 and not sra_lane_use(sra_values[c].slot, sra_values[c].offset, 4 * n, 1): sra_slots[sra_values[c].slot].ok = false
            continue
        if op == .copy:
            # Keep one side in memory when copy endpoints use different lane widths.
            if a >= 0 and b >= 0 and sra_values[a].slot >= 0 and sra_values[b].slot >= 0 and sra_slots[sra_values[a].slot].width != sra_slots[sra_values[b].slot].width:
                if sra_slots[sra_values[a].slot].width > sra_slots[sra_values[b].slot].width: sra_slots[sra_values[a].slot].ok = false
                else: sra_slots[sra_values[b].slot].ok = false
            if a >= 0 and sra_values[a].slot >= 0 and not sra_lane_use(sra_values[a].slot, sra_values[a].offset, int(ins.imm), 0): sra_slots[sra_values[a].slot].ok = false
            if b >= 0 and sra_values[b].slot >= 0 and not sra_lane_use(sra_values[b].slot, sra_values[b].offset, int(ins.imm), 0): sra_slots[sra_values[b].slot].ok = false
            continue
        if op == .zero:
            if a >= 0 and sra_values[a].slot >= 0 and not sra_lane_use(sra_values[a].slot, sra_values[a].offset, int(ins.imm), 0): sra_slots[sra_values[a].slot].ok = false
            continue
        if (op == .add or op == .mov) and int(ins.dst) >= 0 and sra_values[int(ins.dst)].slot >= 0: continue
        if op == .slot: continue
        if op == .zeroslots: continue
        ir_operands(ins)
        loop operand_index in [0..ir_use_count):
            let u = ir_use(operand_index)
            if sra_values[u].slot >= 0: sra_slots[sra_values[u].slot].ok = false
    # a register per lane
    any = false
    loop s in [0..ns):
        if not sra_slots[s].ok: continue
        loop i in [0..(int(ir.slot_size[s]) >> sra_shift(sra_slots[s].width))):
            ty = if sra_lanes[s * 4 + i].kind == 1: (if sra_slots[s].width == 8: VF else: VS) else: VI
            sra_lanes[s * 4 + i].reg = vreg(ty)
            any = true
    if not any: return
    # rewrite
    out: Ins[]
    out.reserve(code.len() + code.len() / 4)
    loop ins in code:
        op = ins.op
        a = int(ins.a)
        b = int(ins.b)
        c = int(ins.c)
        d = int(ins.dst)
        if (op == .slot or op == .add or op == .mov) and sra_is_p(d): continue
        if op == .load and sra_is_p(a):
            width = sra_slots[sra_values[a].slot].width
            ty = if width == 8: VF else: VS
            x = sra_lane_of(a, int((ins.imm >> sra_shift(width))))
            if c & M_FLOAT != 0: out.push(Ins(.mov, i32(ty), i32(d), i32(sra_as_ty(out, x, ty)), 0, 0, 0))
            else if width == 8: out.push(Ins(.mov, VI, i32(d), i32(sra_as_ty(out, x, VI)), 0, 0, 0))
            else:
                conv = if width == 1: Op.zext8 else if width == 2: Op.zext16 else: Op.zext32
                if c & M_SIGNED != 0: conv = if width == 1: Op.sext8 else if width == 2: Op.sext16 else: Op.sext32
                out.push(Ins(conv, VI, i32(d), i32(sra_as_ty(out, x, VI)), 0, 0, 0))
            continue
        if op == .store and sra_is_p(a):
            x = sra_lane_of(a, int((ins.imm >> sra_shift(sra_slots[sra_values[a].slot].width))))
            out.push(Ins(.mov, i32(vtype(x)), i32(x), i32(sra_as_ty(out, b, vtype(x))), 0, 0, 0))
            continue
        if op == .vop and (sra_is_p(a) or (ins.imm & VOP_SPLAT_B == 0 and sra_is_p(b)) or (ins.imm & VOP_SPLAT_C == 0 and sra_is_p(c))):
            n = (ins.imm >> 4) & 7
            fop = [Op.fadd, Op.fsub, Op.fmul, Op.fdiv][ins.imm & 3]
            loop i in [0..n):
                x = b
                if ins.imm & VOP_SPLAT_B == 0:
                    if sra_is_p(b): x = sra_as_ty(out, sra_lane_of(b, i), VS)
                    else:
                        x = vreg(VS)
                        out.push(Ins(.load, VS, i32(x), i32(b), 0, i32(4 | M_FLOAT), 4 * i))
                y = c
                if ins.imm & VOP_SPLAT_C == 0:
                    if sra_is_p(c): y = sra_as_ty(out, sra_lane_of(c, i), VS)
                    else:
                        y = vreg(VS)
                        out.push(Ins(.load, VS, i32(y), i32(c), 0, i32(4 | M_FLOAT), 4 * i))
                r = vreg(VS)
                out.push(Ins(fop, VS, i32(r), i32(x), i32(y), 0, 0))
                # (lane i of the result needs only lane i of the operands: written at once, so
                # it is computed right into its lane, even when the destination is a source)
                if sra_is_p(a):
                    t = sra_lane_of(a, i)
                    out.push(Ins(.mov, i32(vtype(t)), i32(t), i32(sra_as_ty(out, r, vtype(t))), 0, 0, 0))
                else: out.push(Ins(.store, VS, 0, i32(a), i32(r), i32(4 | M_FLOAT), 4 * i))
            continue
        if op == .copy and (sra_is_p(a) or sra_is_p(b)):
            width = sra_slots[sra_values[if sra_is_p(a): a else: b].slot].width
            n = int((ins.imm >> sra_shift(width)))
            xs: int[]
            loop i in [0..n):
                if sra_is_p(b): xs.push(sra_lane_of(b, i))
                else:
                    ty = if sra_is_p(a): vtype(sra_lane_of(a, i)) else: VI
                    x = vreg(ty)
                    m = width
                    if ty != VI: m = width | M_FLOAT
                    out.push(Ins(.load, i32(ty), i32(x), i32(b), 0, i32(m), width * i))
                    xs.push(x)
            loop i in [0..n):
                if sra_is_p(a):
                    t = sra_lane_of(a, i)
                    out.push(Ins(.mov, i32(vtype(t)), i32(t), i32(sra_as_ty(out, xs[i], vtype(t))), 0, 0, 0))
                else:
                    m = width
                    if vtype(xs[i]) != VI: m = width | M_FLOAT
                    out.push(Ins(.store, i32(vtype(xs[i])), 0, i32(a), i32(xs[i]), i32(m), width * i))
            continue
        if op == .zero and sra_is_p(a):
            loop i in [0..int((ins.imm >> sra_shift(sra_slots[sra_values[a].slot].width)))):
                t = sra_lane_of(a, i)
                if vtype(t) != VI:
                    out.push(Ins(.fconst, i32(vtype(t)), i32(t), 0, 0, 0, 0))
                else: out.push(Ins(.mov, VI, i32(t), i32(k_vreg(0)), 0, 0, 0))
            continue
        out.push(ins)
        if op == .zeroslots:
            # (lanes of slots cleared here start at zero)
            loop k in [0..b):
                item = int(ir.args[a + k])
                if item & 1 == 0 and sra_slots[item >> 1].ok:
                    s = item >> 1
                    loop i in [0..(int(ir.slot_size[s]) >> sra_shift(sra_slots[s].width))):
                        t = sra_lanes[s * 4 + i].reg
                        if vtype(t) != VI: out.push(Ins(.fconst, i32(vtype(t)), i32(t), 0, 0, 0, 0))
                        else: out.push(Ins(.mov, VI, i32(t), i32(k_vreg(0)), 0, 0, 0))
    ir.code = out

# ---------------- loops ----------------
# What each loop (in order of appearance) defines and stores to. Entering a loop must forget
# values computed from vregs it redefines (they change on the next iteration even if the
# redefinition comes later in the body) and memory it may write.
lp_defs: int[]          # one flat definition stream; nested loops share ranges
lp_first: int[]
lp_limit: int[]
lp_parent: int[]
lp_kills: int[]         # bit 0: int data, 1: float data, 2: headers (all bits: anything)
lp_next = 0
lp_open: int[]          # (while gathering them: open loop ordinals; -1 for other constructs)

enter_loop = ():
    l = lp_next
    lp_next += 1
    loop k in [lp_first[l]..lp_limit[l]): o_regs[lp_defs[k]].ver += 1
    k = lp_kills[l]
    if k & 1 != 0 or ir.raw_mem: o_gen += 1
    if k & 2 != 0 or ir.raw_mem: o_genf += 1
    if k & 4 != 0 or ir.raw_mem: o_genh += 1

optimize = ():
    o_sra()
    nv = ir.vtypes.len()
    o_resize(nv)
    loop p in [0..ir.nparams):
        o_regs[p].ndef = 1
        o_regs[p].stable = true
        o_regs[p].defpos = -1
    # constant vregs: one canonical vreg per value
    o_kmap.clear()
    loop v in [0..ir.kval.len()):
        if is_kv(v):
            o_regs[v].ndef = 1
            o_regs[v].stable = true
            o_regs[v].constant = true
            o_regs[v].cval = ir.kval[v]
            if let c = o_kmap.get(ir.kval[v]): o_regs[v].repl = i32(c)
            else: o_kmap[ir.kval[v]] = v
    o_lastuse.resize(nv)
    loop v in [0..nv): o_lastuse[v] = -1
    o_depth.resize(ir.code.len())
    depth = 0
    # (and what each loop defines and stores to, in the same walk)
    lp_defs.clear()
    lp_first.clear()
    lp_limit.clear()
    lp_parent.clear()
    lp_kills.clear()
    lp_open.clear()
    lp_next = 0
    active = -1
    loop pos in 0.. and ins in ir.code:
        op = ins.op
        if op == .end:
            depth -= 1
            l = lp_open.pop()
            if l >= 0:
                lp_limit[l] = lp_defs.len()
                active = lp_parent[l]
                if active >= 0: lp_kills[active] = lp_kills[active] | lp_kills[l]
        o_depth[pos] = i32(depth)
        if op == .block or op == .loop or op == .if_:
            depth += 1
            if op == .loop:
                l = lp_first.len()
                lp_open.push(l)
                lp_first.push(lp_defs.len())
                lp_limit.push(-1)
                lp_parent.push(active)
                lp_kills.push(0)
                active = l
            else: lp_open.push(-1)
        d = ir_operands(ins)
        loop operand_index in [0..ir_use_count):
            let u = ir_use(operand_index)
            if o_regs[u].first > pos: o_regs[u].first = i32(pos)
            o_lastuse[u] = i32(pos)
        if d >= 0:
            o_regs[d].ndef += 1
            o_regs[d].defpos = i32(pos)
            # Uses are visited in order, before the definition at this position.
            # Later uses cannot change whether the first one preceded this definition.
            o_regs[d].stable = o_regs[d].ndef == 1 and o_regs[d].first > pos
            # (each definition once: an outer loop's range includes its nested loops)
            if active >= 0: lp_defs.push(d)
        if op == .zeroslots:
            loop k in [0..int(ins.b)):
                item = int(ir.args[int(ins.a) + k])
                if item & 1 == 1:
                    o_regs[item >> 1].ndef += 2
                    o_regs[item >> 1].stable = false
                    if active >= 0: lp_defs.push(item >> 1)
        if active >= 0:
            kill = 0
            if op == .store:
                m = int(ins.c)
                if ir.raw_mem: kill = 7
                else if m & M_HDR != 0: kill = 4
                else if m & M_FLOAT != 0: kill = 2
                else: kill = 1
            else if kills_memory(op) and not (op == .call and ins.c == 1): kill = 7
            lp_kills[active] = lp_kills[active] | kill
    # forward: fold, propagate copies, eliminate common subexpressions, drop dead branches
    o_out = []
    o_out.reserve(ir.code.len())
    o_cse = true
    ht_setup(ir.code.len() + 16)
    # 0 normal, 1 if(true), 2 if(false), 3 block; keep each control's facts together.
    ctl: OptControl[]
    o_join_regs.clear()
    o_join_next.clear()
    skip = 0           # nesting depth inside a dead branch
    loop pos in 0.. and ins in ir.code:
        op = ins.op
        if skip > 0:
            if op == .block or op == .loop or op == .if_: skip += 1
            if op == .loop: lp_next += 1
            else if op == .else_ and skip == 1 and ctl[ctl.len() - 1].kind == 2:
                skip = 0
                o_scope_open()
            else if op == .end:
                skip -= 1
                if skip == 0:
                    frame = ctl.pop()
                    o_join_kill(frame.deferred)
                    lop = o_out[o_out.len() - 1].op
                    if lop == .block or lop == .if_: o_pop()
                    else: o_out.push(ins)
            continue
        if op == .nop: continue
        if op == .block or op == .loop:
            if op == .loop: enter_loop()
            kind = 0
            if op == .block: kind = 3
            ctl.push(OptControl(kind, -1, o_nbr))
            o_scope_open(op == .block)
            o_out.push(ins)
            continue
        if op == .if_:
            c = int(o_regs[int(ins.a)].repl)
            known = o_regs[c].constant or fact_false(c) or fact_true(c)
            if known:
                # the if becomes a plain block so branch depths inside stay valid
                o_out.push(Ins(.block, 0, 0, 0, 0, 0, 0))
                if (o_regs[c].constant and o_regs[c].cval != 0) or fact_true(c):
                    ctl.push(OptControl(1, -1, o_nbr))
                    o_scope_open()
                else:
                    ctl.push(OptControl(2, -1, o_nbr))
                    skip = 1
                continue
            ctl.push(OptControl(0, c, o_nbr))
            o_scope_open()
            add_fact_true(c)
            ins2 = ins
            ins2.a = i32(c)
            o_regs[c].nuse += 1
            o_out.push(ins2)
            continue
        if op == .else_:
            c = ctl[ctl.len() - 1].condition
            ctl[ctl.len() - 1].condition = -1
            o_scope_close()
            if ctl[ctl.len() - 1].kind == 1:
                skip = 1
                continue
            o_scope_open()
            if c >= 0: add_fact_false(c)
            o_out.push(ins)
            continue
        if op == .end:
            # A terminating if arm leaves its condition false. For a block with exactly
            # one conditional exit and a terminating tail, only that taken exit reaches
            # the join. Count all branches conservatively, including nested breaks.
            frame = ctl.pop()
            c = frame.condition
            nbr = frame.branches
            kind = frame.kind
            o_join_kill(frame.deferred)
            last = o_out[o_out.len() - 1]
            if kind == 3 and c >= 0 and nbr + 2 == o_nbr and last.op == .br and last.imm > 0:
                target = ctl.len() - int(last.imm)
                if target >= 0:
                    d = o_branch_copy()
                    if d >= 0:
                        o_regs[d].ver -= 1
                        o_join_regs.push(d)
                        o_join_next.push(ctl[target].deferred)
                        ctl[target].deferred = o_join_regs.len() - 1
            terminates = last.op == .ret or last.op == .trap or (last.op == .call and last.c == 1)
            noret = c >= 0 and terminates
            o_scope_close()
            if last.op == .block or last.op == .if_:
                # empty construct: drop it (an if's condition is pure)
                o_pop()
                continue
            o_out.push(ins)
            if noret:
                if kind == 3 and nbr + 1 == o_nbr: add_fact_true(c)
                else if kind == 0 and nbr == o_nbr: add_fact_false(c)
            continue
        if op == .brif:
            # a branch on a known condition: always or never taken
            c = int(o_regs[int(ins.a)].repl)
            if o_regs[c].constant or fact_false(c) or fact_true(c):
                if (o_regs[c].constant and o_regs[c].cval != 0) or fact_true(c): o_emit(Ins(.br, 0, 0, 0, 0, 0, ins.imm))
                continue
            # Remember an exit's condition for a possible terminating block. Multiple
            # exits (even with the same condition) fail the branch-count check at its end.
            target = ctl.len() - 1 - int(ins.imm)
            if target >= 0 and ctl[target].kind == 3: ctl[target].condition = c
            # (after it, in this construct, the condition is false)
            o_transfer(ins, true)
            add_fact_false(c)
            continue
        if op == .zeroslots:
            kill_all()
            loop k in [0..int(ins.b)):
                item = int(ir.args[int(ins.a) + k])
                if item & 1 == 1: o_regs[item >> 1].ver += 1
            o_out.push(ins)
            continue
        o_transfer(ins, true)
    # backward: drop pure instructions whose results are unused (o_push counted the uses)
    i = o_out.len() - 1
    loop i >= 0:
        ins = o_out[i]
        if o_pure(ins.op):
            d = int(ins.dst)
            if o_regs[d].nuse == 0:
                o_out[i].op = .nop
                ir_operands(ins)
                loop operand_index in [0..ir_use_count):
                    let u = ir_use(operand_index)
                    o_regs[u].nuse -= 1
        i -= 1
    ir.code = o_cleanup(o_out)

# ---------------- returns ----------------
# A branch to where the function returns (past ends only) returns there: `v = x; br out` then
# `end ... ret v` becomes `ret x`. The value of an if in return position (fib's) then lives
# only in its own branch, not across the other's calls. (Release builds.)
o_ret_sink = (code0: Ins[]) -> Ins[]:
    code = code0
    n = code.len()
    # (only in recursive functions, where a value kept across the calls costs at every call,
    # and where some ret comes right after an end)
    any = false
    calls = false
    loop i in [1..n):
        op = code[i].op
        if op == .ret and code[i - 1].op == .end: any = true
        else if op == .call and code[i].imm == ir.fn_index: calls = true
    if not any or not calls: return code
    # where each construct starts: the end of the construct a br leaves (-1 for a loop: it goes back)
    ends = fill(-1, n)
    open: int[]
    loop i in 0.. and ins in code:
        op = ins.op
        if op == .block or op == .loop or op == .if_: open.push(i)
        else if op == .end: ends[open.pop()] = i
    stack: int[]
    loop i in [0..n):
        op = code[i].op
        if op == .block or op == .loop or op == .if_: stack.push(i)
        else if op == .end and stack.len() > 0: stack.pop()
        if op != .br: continue
        ins = code[i]
        if int(ins.imm) < stack.len():
            st = stack[stack.len() - 1 - int(ins.imm)]
            if code[st].op != .loop:
                q = ends[st] + 1
                loop q < n and code[q].op == .end: q += 1
                if q < n and code[q].op == .ret:
                    # (only for `v = x` just before: ret x; a return of nothing gains nothing
                    # but one more copy of what returning takes)
                    r = code[q]
                    if i > 0 and int(r.a) >= 0:
                        lst = code[i - 1]
                        ta = 0
                        if lst.op == .mov: ta = vtype(int(lst.a))
                        if ta == VK: ta = VI
                        if lst.op == .mov and int(lst.dst) == int(r.a) and int(lst.ty) == ta and int(lst.a) != int(r.a):
                            code[i - 1] = Ins(.nop, 0, 0, 0, 0, 0, 0)
                            r.a = lst.a
                            r.pos = ins.pos
                            code[i] = r
    code

# ---------------- loop-invariant code motion ----------------
# Arithmetic in a loop whose operands the loop does not change is moved in front of it (of the
# outermost such loop), after the loop's entry test: it runs once instead of every iteration.
# Only pure instructions that cannot trap move (float division gives inf or NaN, never traps); a value defined once is required, and every
# definition dominates its uses, so the new place still precedes every use. (Release builds, on
# the final code of each function.)
# (only what costs more than the register it then holds through the loop: one-cycle integer
# operations, which also fold into addresses, are left in place)
licm_op = (op: Op) -> bool:
    match op:
        mul, i2f, u2f, f2f: true
        fadd, fsub, fmul, fdiv, fmin, fmax: true
        _: false

o_licm = (code: Ins[]) -> Ins[]:
    n = code.len()
    nv = ir.vtypes.len()
    # is there anything to move at all
    kinds: Op[]
    depth = 0
    cands = 0
    loop ins in code:
        op = ins.op
        if op == .block or op == .if_ or op == .loop:
            kinds.push(op)
            if op == .loop: depth += 1
        else if op == .end:
            if kinds.pop() == .loop: depth -= 1
        else if depth > 0 and licm_op(op): cands += 1
    if cands == 0: return code
    # where each loop ends
    lp_end = fill(-1, n)
    open: int[]
    loop i in 0.. and ins in code:
        op = ins.op
        if op == .block or op == .if_ or op == .loop: open.push(i)
        else if op == .end:
            st = open.pop()
            if code[st].op == .loop: lp_end[st] = i
    # definition positions of each vreg, ascending (doubled: an instruction moved in front of
    # position p is at 2p - 1)
    first = fill(0, nv + 1)
    loop ins in code:
        d = int(ins.dst)
        if d >= 0 and o_defines(ins.op): first[d + 1] += 1
        if ins.op == .zeroslots:
            loop k in [0..int(ins.b)):
                item = int(ir.args[int(ins.a) + k])
                if item & 1 == 1: first[(item >> 1) + 1] += 1
    loop v in [0..nv): first[v + 1] += first[v]
    dpos = fill(0, first[nv])
    at = first
    loop i in 0.. and ins in code:
        d = int(ins.dst)
        if d >= 0 and o_defines(ins.op):
            dpos[at[d]] = 2 * i
            at[d] += 1
        if ins.op == .zeroslots:
            loop k in [0..int(ins.b)):
                item = int(ir.args[int(ins.a) + k])
                if item & 1 == 1:
                    v = item >> 1
                    dpos[at[v]] = 2 * i
                    at[v] += 1
    first = fill(0, nv + 1)
    loop v in [0..nv): first[v + 1] = at[v]
    # choose what moves where: (loop start, instruction) pairs, in instruction order
    moved = fill(false, n)
    moves: (int, int)[]
    loops_open: int[]
    loop i in 0.. and ins in code:
        op = ins.op
        if op == .loop: loops_open.push(i)
        else if op == .end and loops_open.len() > 0 and lp_end[loops_open[loops_open.len() - 1]] == i: loops_open.pop()
        if loops_open.len() == 0 or not licm_op(op): continue
        d = int(ins.dst)
        if d < 0 or first[d + 1] - first[d] != 1: continue
        ir_operands(ins)
        # the outermost enclosing loop that defines none of the operands
        target = -1
        loop L in loops_open:
            ok = true
            loop operand_index in [0..ir_use_count):
                let u = ir_use(operand_index)
                if o_def_within(dpos, first[u], first[u + 1], 2 * L, 2 * lp_end[L]):
                    ok = false
                    break
            if ok:
                target = L
                break
        if target < 0: continue
        moved[i] = true
        moves.push((target, i))
        dpos[first[d]] = 2 * target - 1
    if moves.len() == 0: return code
    moves.sort_by((m: (int, int)): m.0 * n + m.1)
    out: Ins[]
    out.reserve(n)
    k = 0
    loop i in 0.. and ins in code:
        if moved[i]: continue
        loop k < moves.len() and moves[k].0 == i:
            out.push(code[moves[k].1])
            k += 1
        out.push(ins)
    out

# is any of dpos[lo..hi) (ascending, but for single entries) within [s, e]
o_def_within = (dpos: int[], lo: int, hi: int, s: int, e: int) -> bool:
    if hi - lo == 1: return dpos[lo] >= s and dpos[lo] <= e
    a = lo
    b = hi
    loop a < b:
        m = (a + b) / 2
        if dpos[m] < s: a = m + 1
        else: b = m
    a < hi and dpos[a] <= e

# Final tidying: drop unreachable code after unconditional jumps, branches to the very next
# instruction, and copies of a value that was computed just for the copy (t = a + 1; x = t).
# Only cheap integer operations may run on the unselected path. In particular,
# no loads, calls, division, managed values, or observable writes are speculated.
o_select_op = (ins: Ins) -> bool:
    if ins.ty != VI: return false
    match ins.op:
        iconst, mov, add, sub, mul, and_, or_, xor, shl, shrs, shru, neg, not_: true
        eq, ne, lts, les, gts, ges, ltu, leu, gtu, geu: true
        sext8, sext16, sext32, zext8, zext16, zext32: true
        _: false

# Lowered value-if: block { block { condition; brif else; yes; br end }; no }.
# Recognize a small diamond after inlining, so tiny arithmetic helpers count too.
o_if_select = (out: mut Ins[], start: int) -> bool:
    n = out.len()
    if n - start < 6 or n - start > 32 or out[start + 1].op != .block: return false
    depth = 0
    branch = -1
    jump = -1
    split = -1
    yes = -1
    no = -1
    cost = 0
    loop j in [start + 2..n):
        ins = out[j]
        op = ins.op
        if op == .block:
            depth += 1
            continue
        if op == .end:
            if depth > 0: depth -= 1
            else:
                if jump != j - 1 or split >= 0: return false
                split = j
            continue
        if op == .brif and branch < 0 and depth == 0 and ins.imm == 0:
            branch = j
            continue
        if op == .br and branch >= 0 and jump < 0 and depth == 0 and ins.imm == 1:
            jump = j
            continue
        if op == .br or op == .brif or op == .brtable or op == .loop or op == .if_ or op == .else_ or op == .ret or op == .trap: return false
        if branch < 0: continue
        if not o_select_op(ins): return false
        cost += 1
        if cost > 8: return false
        if split < 0:
            if jump >= 0: return false
            yes = j
        else: no = j
    if depth != 0 or yes < 0 or no < 0 or split < 0: return false
    dst = int(out[yes].dst)
    cond = int(out[branch].a)
    if dst < 0 or out[no].dst != dst or vtype(dst) != VI: return false
    loop j in [branch + 1..n):
        ins = out[j]
        if not o_select_op(ins): continue
        d = int(ins.dst)
        # Only the two result writes may redefine a register. Everything else
        # must be a temporary, and neither arm may read the result being joined.
        if d == cond: return false
        if j != yes and j != no:
            if d == dst or d < 0 or o_regs[d].ndef != 1: return false
        ir_operands(ins)
        if ir_has_use(dst): return false
    # A result copy already names the selected value. Keep that operand
    # directly rather than introducing two moves before the select; besides
    # saving vregs this leaves adjacent comparisons available to the emitter.
    y = if out[yes].op == .mov: int(out[yes].a) else: o_tmp()
    z = if out[no].op == .mov: int(out[no].a) else: o_tmp()
    replacement: Ins[]
    loop j in [start + 2..n):
        ins = out[j]
        if ins.op == .block or ins.op == .end or j == branch or j == jump: continue
        if (j == yes or j == no) and ins.op == .mov: continue
        if j == yes: ins.dst = i32(y)
        if j == no: ins.dst = i32(z)
        replacement.push(ins)
    selected = Ins(.select, VI, i32(dst), i32(cond), i32(z), i32(y), 0)
    selected.pos = out[branch].pos
    replacement.push(selected)
    out.resize(start)
    loop ins in replacement: out.push(ins)
    true

# A branch to a block's end can make that end reachable even when its body
# cannot fall through. Branches to loop headers do not reach the loop's end.
o_live_exit = (distance: int, kinds: Op[], exits: mut bool[]):
    target = kinds.len() - 1 - distance
    if target >= 0 and kinds[target] != .loop: exits[target] = true

o_cleanup = (code: Ins[]) -> Ins[]:
    out: Ins[]
    out.reserve(code.len())
    kinds: Op[]          # open constructs
    starts: int[]        # ... and where in out they start
    exits: bool[]        # reachable branches/then arms arriving at each end
    dead = false
    depth = 0
    loop ins in code:
        op = ins.op
        if op == .nop: continue
        if dead:
            if op == .block or op == .loop or op == .if_:
                depth += 1
                continue
            if op == .end or op == .else_:
                if depth > 0:
                    if op == .end: depth -= 1
                    continue
            else: continue
        if op == .else_:
            top = kinds.len() - 1
            exits[top] = exits[top] or not dead
            kinds[top] = .else_
            dead = false
        else if op == .end:
            top = kinds.len() - 1
            # An if without else also reaches its end through its false arm.
            dead = dead and not exits[top] and kinds[top] != .if_
        else if op == .br or op == .brif:
            o_live_exit(int(ins.imm), kinds, exits)
        else if op == .brtable:
            o_live_exit(int(ins.imm), kinds, exits)
            loop i in [0..int(ins.b)):
                o_live_exit(int(ir.args[int(ins.c) + i]), kinds, exits)
        if op == .end and out.len() > 0:
            if kinds[kinds.len() - 1] == .block and o_if_select(out, starts[starts.len() - 1]):
                kinds.pop()
                starts.pop()
                exits.pop()
                continue
            last = out[out.len() - 1]
            if last.op == .br and last.imm == 0 and kinds[kinds.len() - 1] != .loop: out.pop()
            # Inlining a leaf can leave `block; value; end` after its final
            # branch is removed. A single pure instruction cannot target this
            # block; removing the wrapper exposes adjacent compare/branch pairs.
            if kinds[kinds.len() - 1] == .block and out.len() == starts[starts.len() - 1] + 2 and o_pure(out[out.len() - 1].op):
                value = out.pop()
                out[out.len() - 1] = value
                kinds.pop()
                starts.pop()
                exits.pop()
                continue
            # `if c { br d }` is `brif c, d - 1` (one branch instead of two)
            if out.len() >= 2 and kinds[kinds.len() - 1] == .if_:
                last = out[out.len() - 1]
                prev = out[out.len() - 2]
                if last.op == .br and last.imm >= 1 and prev.op == .if_:
                    out.pop()
                    out.pop()
                    kinds.pop()
                    starts.pop()
                    exits.pop()
                    out.push(Ins(.brif, 0, 0, prev.a, 0, 0, last.imm - 1))
                    continue
            # `block { ...; brif c, 0; br d }` (c a comparison used only there) is
            # `...; brif !c, d - 1`
            if out.len() >= 2 and kinds[kinds.len() - 1] == .block:
                last = out[out.len() - 1]
                prev = out[out.len() - 2]
                st = starts[starts.len() - 1]
                c = int(prev.a)
                if last.op == .br and last.imm >= 1 and prev.op == .brif and prev.imm == 0 and c >= 0 and c < o_reg_count and o_regs[c].nuse == 1:
                    # the comparison, inside the block, with no other branch there
                    cd = -1
                    plain = true
                    loop j in [st + 1..out.len() - 2):
                        eo = out[j].op
                        if eo == .br or eo == .brif or eo == .brtable or eo == .block or eo == .loop or eo == .if_ or eo == .end or eo == .else_: plain = false
                        if int(out[j].dst) == c and o_defines(eo): cd = j
                    if plain and cd >= 0 and o_negate(out[cd].op) != .nop:
                        e = out[cd]
                        e.op = o_negate(e.op)
                        out[cd] = e
                        d = last.imm - 1
                        out.pop()
                        out.pop()
                        out.remove(st)
                        kinds.pop()
                        starts.pop()
                        exits.pop()
                        out.push(Ins(.brif, 0, 0, i32(c), 0, 0, d))
                        continue
        if op == .mov and out.len() > 0:
            t = int(ins.a)
            d = int(ins.dst)
            if t != d and t >= 0 and t < o_reg_count and o_regs[t].nuse == 1 and vtype(t) == vtype(d):
                # (also a few instructions back, in straight-line code that leaves d alone:
                # vector lanes computed one after the other, then copied)
                j = out.len() - 1
                done = false
                loop j >= 0 and j >= out.len() - 8:
                    e = out[j]
                    eo = e.op
                    if int(e.dst) == t and o_defines(eo):
                        if o_retargetable(eo):
                            e.dst = i32(d)
                            out[j] = e
                            done = true
                        break
                    if eo == .block or eo == .loop or eo == .if_ or eo == .else_ or eo == .end or eo == .br or eo == .brif or eo == .brtable or eo == .zeroslots: break
                    ed = ir_operands(e)
                    if ed == d or ir_has_use(d) or ed == t: break
                    j -= 1
                if done: continue
        if op == .copy and out.len() > 0:
            # vector arithmetic into a temporary that is then copied: compute into the copy's target
            last = out[out.len() - 1]
            t = int(ins.b)
            if last.op == .vop and int(last.a) == t and o_regs[t].nuse == 2 and int(ins.imm) == ((int(last.imm) >> 4) & 7) * 4 and o_sole_slot(code, t):
                last.a = ins.a
                out[out.len() - 1] = last
                continue
        out.push(ins)
        if op == .block or op == .loop or op == .if_:
            kinds.push(op)
            starts.push(out.len() - 1)
            exits.push(false)
        else if op == .end:
            kinds.pop()
            starts.pop()
            exits.pop()
            # Structured validators do not infer that every incoming path
            # terminates. Keep that fact explicit after closing the construct.
            if dead: out.push(Ins(.trap, 0, 0, 0, 0, 0, 0))
        else if op == .br or op == .brtable or op == .ret or op == .trap or (op == .call and ins.c == 1):
            dead = true
            depth = 0
    out

# Is t the address of a frame slot no other instruction takes the address of? (Asked rarely:
# a vector operation into a temporary that is then copied.)
o_sole_slot = (code: Ins[], t: int) -> bool:
    s = -1
    loop ins in code:
        if ins.op == .slot and int(ins.dst) == t: s = int(ins.a)
    if s < 0: return false
    refs = 0
    loop ins in code:
        if ins.op == .slot and int(ins.a) == s: refs += 1
    refs == 1

# the comparison that is true exactly when op is false (integers only: floats have NaN)
o_negate = (op: Op) -> Op:
    match op:
        eq: .ne
        ne: .eq
        lts: .ges
        ges: .lts
        les: .gts
        gts: .les
        ltu: .geu
        geu: .ltu
        leu: .gtu
        gtu: .leu
        _: .nop

# instructions whose result register may be renamed
o_retargetable = (op: Op) -> bool:
    match op:
        # Native flags consume the operands before assigning the result. Wasm
        # checks the saved operands afterwards, so it must retain a fresh local.
        checked_add, checked_sub, checked_mul: checked_flags
        add, sub, mul, divs, divu, rems, remu, and_, or_, xor, shl, shrs, shru, neg, not_, load, mov, mulhs, mulhu, memeq, streq, overflow_add, overflow_sub, overflow_mul: true
        eq, ne, lts, les, gts, ges, ltu, leu, gtu, geu: true
        fadd, fsub, fmul, fdiv, fneg, fsqrt, fmin, fmax, ffloor, fceil, fabs, ftrunc: true
        sext8, sext16, sext32, zext8, zext16, zext32, i2f, u2f, f2i, f2f, bits2f, f2bits, fconst, iconst: true
        _: false

$runtime_checks

from p"string_domains.jo" import (string_set_owners string_set_tests)
from p"ast.jo" import (NF_GLOBAL has_flag kid lists nkids nodes)
from p"check.jo" import (LF_ADDR LF_ALIAS LF_BYREF LF_CAPTURE LF_CAPTURED LF_EXPOSED LF_MUTPARAM LF_SHARED locals)
from p"checker_tokens.dewy" import (Tok)
from p"effects.jo" import (effect_summaries)
from p"expr.jo" import (CV)
from p"facts.jo" import (FACT_CAP FactImplication FactPaths FactState fact_either_wanted fact_implications fact_owner fact_query fact_speculating fact_terms)
from p"facts_slice_builder.dewy" import (fact_comparison fact_comparison_raw)
from p"facts_capture.dewy" import (fact_capture)
from p"facts_values.dewy" import (fact_domain fact_place fact_string_set fact_type fact_project)
from p"facts_compare.dewy" import (fact_assume fact_compare fact_inverse)
from p"facts_index_writes.dewy" import (fact_constant fact_new)
from p"facts_value_queries.dewy" import (fact_binding fact_bound fact_slot fact_truth)
from p"facts_projection_queries.dewy" import (fact_projection_find fact_projection_origin)
from p"facts_row_queries.dewy" import (fact_incident)
from p"facts_lifecycle.dewy" import (fact_scope_exit)
from p"facts_forgets.dewy" import (fact_drop_forget fact_drop_statement)
from p"ownership.jo" import (ownership_fact_cleanup)
from p"facts_joins.dewy" import (fact_join fact_join_into fact_projection_value)
from p"facts_summaries.dewy" import (fact_summary_payload)
from p"proofs.jo" import (ResultEvidence)
from p"proof_ops.dewy" import (result_activate)
from p"refine.jo" import (refine_owners)
from p"refinement_types.dewy" import (FactBound FactTerm)
from p"types.jo" import (T_BOOL T_INT T_U64 is_union types)
from p"node_store.dewy" import (node_aux2 node_op)

ConditionWord:type=int64<overflow='wrap'>
FactCondMeta:type=[reason:FactBound value:int64=0]
let fco_or_failed:bool=false

# Extract a private non-aliased local (and optional field selector) if n is a
# pure single-variable predicate whose current value has no incident difference
# rows in state. Returns [0 0] otherwise.
fact_cond_single_var=(n0:ConditionWord s:FactState membership_owner:bool):>[int64 int64]=>$unsafe {
    let n=n0
    loop nodes.ptr[n].kind =? 'not_' {
        if membership_owner and string_set_tests.has(n) {return [0 0]}
        n=ConditionWord(nodes.ptr[n].a)
    }
    if membership_owner and string_set_tests.has(n) {return [0 0]}
    let k=nodes.ptr[n].kind
    let target:ConditionWord=0
    if k =? 'ident' or k =? 'field' or k =? 'istype' {
        target=if k =? 'istype' {ConditionWord(nodes.ptr[n].a)} else {n}
    } else if k =? 'binary' and nodes.ptr[n].aux =? 0 and fact_comparison_raw(node_op(nodes.ptr[n].op_ext)) {
        let a=ConditionWord(nodes.ptr[n].a)
        let b=ConditionWord(nodes.ptr[n].b)
        loop nodes.ptr[a].kind =? 'conv' and nodes.ptr[a].aux not=? int32(int64(CV.refinement)) {a=ConditionWord(nodes.ptr[a].a)}
        loop nodes.ptr[b].kind =? 'conv' and nodes.ptr[b].aux not=? int32(int64(CV.refinement)) {b=ConditionWord(nodes.ptr[b].a)}
        let ak=nodes.ptr[a].kind
        let bk=nodes.ptr[b].kind
        let a_const=ak =? 'int_lit' or ak =? 'bool_lit' or ak =? 'dotname' or ak =? 'none_lit' or (ak =? 'call' and nodes.ptr[a].aux =? 3 and nkids(a) =? 0)
        let b_const=bk =? 'int_lit' or bk =? 'bool_lit' or bk =? 'dotname' or bk =? 'none_lit' or (bk =? 'call' and nodes.ptr[b].aux =? 3 and nkids(b) =? 0)
        if b_const and (ak =? 'ident' or ak =? 'field') {target=a}
        else if a_const and (bk =? 'ident' or bk =? 'field') {target=b}
        else {return [0 0]}
    } else {return [0 0]}
    loop nodes.ptr[target].kind =? 'conv' and nodes.ptr[target].aux not=? int32(int64(CV.refinement)) {target=ConditionWord(nodes.ptr[target].a)}
    let fld:ConditionWord=0
    if nodes.ptr[target].kind =? 'field' {
        if nodes.ptr[target].aux <? 0 {return [0 0]}
        fld=ConditionWord(nodes.ptr[target].name)
        if fld <=? 0 {return [0 0]}
        target=ConditionWord(nodes.ptr[target].a)
    }
    if nodes.ptr[target].kind not=? 'ident' or nodes.ptr[target].aux not=? int32(1) {return [0 0]}
    let l=ConditionWord(nodes.ptr[target].sym)
    if l <=? 0 {return [0 0]}
    let fl=ConditionWord(locals.ptr[l].flags)
    if fl & (LF_ALIAS | LF_MUTPARAM | LF_SHARED | LF_CAPTURE | LF_CAPTURED | LF_ADDR | LF_BYREF | LF_EXPOSED) not=? 0 {return [0 0]}
    let bi=fact_binding(s fact_place(target))
    if bi >=? 0 {
        let bv=s.bindings.ptr[bi].value
        if fld =? 0 {
            if fact_incident(s bv) >=? 0 {return [0 0]}
        } else {
            let pi=fact_projection_find(s bv fld false)
            if pi >=? 0 and fact_incident(s s.projections.ptr[pi].value) >=? 0 {return [0 0]}
        }
    }
    [l fld]
}

fact_cond_pure_no_var=(n:ConditionWord sym0:ConditionWord fld0:ConditionWord membership_owner:bool @budget:ConditionWord):>bool=>$unsafe {
    if n <=? 0 {return true}
    if budget <=? 0 {return false}
    budget -= 1
    if membership_owner and string_set_tests.has(n) {return false}
    let nd=nodes.ptr + n
    let k=nd[0].kind
    match k {
        <'int_lit'|'float_lit'|'bool_lit'|'none_lit'|'null_lit'|'dotname'> => {return true}
        <'str_lit'> => {return nd[0].aux =? 0 and nd[0].nlist =? 0}
        <'ident'> => {
            if nd[0].aux =? int32(2) {return true}
            if nd[0].aux not=? int32(1) {return false}
            let l=ConditionWord(nd[0].sym)
            if l =? sym0 {return false}
            ConditionWord(locals.ptr[l].flags) & LF_ALIAS =? 0
        }
        <'field'> => {
            let a=ConditionWord(nd[0].a)
            if fld0 >? 0 and nd[0].aux >=? 0 and ConditionWord(nd[0].name) not=? fld0 and a >? 0 and nodes.ptr[a].kind =? 'ident' and nodes.ptr[a].aux =? int32(1) and ConditionWord(nodes.ptr[a].sym) =? sym0 {
                return true
            }
            return fact_cond_pure_no_var(a sym0 fld0 membership_owner @budget)
        }
        <'not_'|'unary'|'istype'|'narrow'> => {return fact_cond_pure_no_var(ConditionWord(nd[0].a) sym0 fld0 membership_owner @budget)}
        <'conv'> => {
            if nd[0].aux =? int32(int64(CV.refinement)) or nd[0].aux =? int32(int64(CV.arr2fixed)) {return false}
            return fact_cond_pure_no_var(ConditionWord(nd[0].a) sym0 fld0 membership_owner @budget)
        }
        <'binary'|'and_'|'or_'> => {
            if k =? 'binary' and nd[0].aux not=? 0 {return false}
            return fact_cond_pure_no_var(ConditionWord(nd[0].a) sym0 fld0 membership_owner @budget) and fact_cond_pure_no_var(ConditionWord(nd[0].b) sym0 fld0 membership_owner @budget)
        }
        <'index'> => {
            if nd[0].b =? 0 or nd[0].nlist >? 1 {return false}
            return fact_cond_pure_no_var(ConditionWord(nd[0].a) sym0 fld0 membership_owner @budget) and fact_cond_pure_no_var(ConditionWord(nd[0].b) sym0 fld0 membership_owner @budget)
        }
        <'call'> => {
            if nd[0].aux =? 3 and nd[0].nlist =? 0 {return true}
            if nd[0].aux not=? 0 {return false}
            let callee=ConditionWord(nd[0].sym)
            if callee <=? 0 or callee >=? effect_summaries.length or not effect_summaries.ptr[callee].done {return false}
            let es=effect_summaries.ptr + callee
            if es[0].cut or es[0].callbacks not=? 0 or es[0].opaque_other {return false}
            loop event in es[0].events {
                let ek=event.atom.kind
                if ek not=? 'read' and ek not=? 'panic' {return false}
            }
            let l0=ConditionWord(nd[0].list)
            let nk=ConditionWord(nd[0].nlist)
            loop i in [ConditionWord(0)..nk) {
                if not fact_cond_pure_no_var(ConditionWord(lists.ptr[l0 + i]) sym0 fld0 membership_owner @budget) {return false}
            }
            return true
        }
        _ => {return false}
    }
}

fact_cond_flatten=(n:ConditionWord op_is_and:bool membership_owner:bool @out:array<int64>):>bool=>$unsafe {
    if membership_owner and string_set_tests.has(n) {
        if out.length >=? 16 {return false}
        out.push(n)
        return true
    }
    let k=nodes.ptr[n].kind
    if (op_is_and and k =? 'and_') or (not op_is_and and k =? 'or_') {
        return fact_cond_flatten(ConditionWord(nodes.ptr[n].a) op_is_and membership_owner @out) and fact_cond_flatten(ConditionWord(nodes.ptr[n].b) op_is_and membership_owner @out)
    }
    if out.length >=? 16 {return false}
    out.push(n)
    true
}

# In-place condition evaluation: @state holds the entry state and receives the
# `sense` branch; @other receives the `not sense` branch when `need_other`.
# Avoids FactPaths triple-FactState copies and drops on the hot non-query path.
fact_cond_out=(n:ConditionWord @state:FactState @other:FactState need_state:bool need_other:bool sense:bool):>FactCondMeta=>$unsafe {
    let k=nodes.ptr[n].kind
    let membership_owner=string_set_owners.length >? 0 and string_set_owners.has(fact_owner)
    let membership=membership_owner and string_set_tests.has(n)
    if not membership and k =? 'not_' {
        return fact_cond_out(ConditionWord(nodes.ptr[n].a) @state @other need_state need_other (not sense))
    }
    if not membership and (k =? 'and_' or k =? 'or_') {
        let same_side=(k =? 'and_') =? sense
        if same_side {
            let want_bit:ConditionWord=if sense {2} else {1}
            if need_other and not ownership_fact_cleanup and state.conditional.length =? 0 {
                let leaves:array<int64>=[]
                if fact_cond_flatten(n (k =? 'and_') membership_owner @leaves) and leaves.length >=? 2 and (fact_speculating >? 0 or (fact_either_wanted & want_bit) =? 0 or leaves.length >=? 3) {
                    let sv=fact_cond_single_var(leaves.ptr[0] state membership_owner)
                    if sv[0] >? 0 {
                        let cb:ConditionWord=96
                        let ok=true
                        loop li in [ConditionWord(1)..leaves.length) {
                            if not fact_cond_pure_no_var(leaves.ptr[li] sv[0] sv[1] membership_owner @cb) {ok=false; break}
                        }
                        if ok {
                            let cn0=leaves.ptr[0]
                            let s0=sense
                            loop nodes.ptr[cn0].kind =? 'not_' {cn0=ConditionWord(nodes.ptr[cn0].a); s0=not s0}
                            let v0=fact_capture(cn0 @state)
                            let r0=fact_bound(state v0)
                            if not state.live {
                                other=FactState(live=false)
                                return FactCondMeta(r0 0)
                            }
                            let tr0=fact_truth(state v0)
                            if (tr0 =? 0 and s0) or (tr0 =? 1 and not s0) {
                                other=state
                                state=FactState(live=false)
                                return FactCondMeta(r0 0)
                            }
                            if tr0 <? 0 {
                                let entry=state
                                fact_assume(@state v0 s0)
                                let can_fail=false
                                let dummy=FactState(live=false)
                                loop li in [ConditionWord(1)..leaves.length) {
                                    if not state.live {can_fail=true; break}
                                    let lf=leaves.ptr[li]
                                    let lfk=nodes.ptr[lf].kind
                                    if lfk not=? 'and_' and lfk not=? 'or_' and not fact_condition_block(lf) {
                                        let cni=lf
                                        let si=sense
                                        loop nodes.ptr[cni].kind =? 'not_' {cni=ConditionWord(nodes.ptr[cni].a); si=not si}
                                        let vi=fact_capture(cni @state)
                                        if not state.live {can_fail=true; break}
                                        let tri=fact_truth(state vi)
                                        if not ((tri =? 1 and si) or (tri =? 0 and not si)) {can_fail=true}
                                        if not need_state and fact_speculating >? 0 and can_fail {break}
                                        fact_assume(@state vi si)
                                    } else {
                                        can_fail=true
                                        fact_cond_out(lf @state @dummy true false sense);
                                        if not need_state and fact_speculating >? 0 {break}
                                    }
                                }
                                if not need_state {state=FactState(live=false)}
                                other=entry
                                if not can_fail and state.live {fact_assume(@other v0 (not s0))}
                                return FactCondMeta(r0 0)
                            }
                        }
                    }
                }
            }
            let ma=fact_cond_out(ConditionWord(nodes.ptr[n].a) @state @other true need_other sense)
            let a_cont_live=state.live
            let a_sc_live=if need_other {other.live} else {false}
            if not a_cont_live and refine_owners.length =? 0 {
                return FactCondMeta(ma.reason 0)
            }
            if not need_other {
                let mb=fact_cond_out(ConditionWord(nodes.ptr[n].b) @state @other need_state false sense)
                return FactCondMeta(mb.reason 0)
            }
            let other_b=FactState(live=false)
            let mb=fact_cond_out(ConditionWord(nodes.ptr[n].b) @state @other_b need_state true sense)
            let reason=if a_cont_live and a_sc_live {ma.reason} else {mb.reason}
            if fact_speculating =? 0 and fact_either_wanted & want_bit not=? 0 and a_sc_live and other_b.live and ma.value not=? 0 and mb.value not=? 0 {
                let joined=fact_join(other other_b n)
                fact_either(@joined ma.value @other (not sense) mb.value @other_b (not sense))
                other=joined
            } else {
                fact_join_into(@other @other_b n)
            }
            return FactCondMeta(reason 0)
        }
        let want_bit:ConditionWord=if sense {1} else {2}
        if need_state and not ownership_fact_cleanup and state.conditional.length =? 0 {
            let leaves:array<int64>=[]
            if fact_cond_flatten(n (k =? 'and_') membership_owner @leaves) and leaves.length >=? 2 and (fact_speculating >? 0 or (fact_either_wanted & want_bit) =? 0 or leaves.length >=? 3) {
                let sv=fact_cond_single_var(leaves.ptr[0] state membership_owner)
                if sv[0] >? 0 {
                    let cb:ConditionWord=96
                    let ok=true
                    loop li in [ConditionWord(1)..leaves.length) {
                        if not fact_cond_pure_no_var(leaves.ptr[li] sv[0] sv[1] membership_owner @cb) {ok=false; break}
                    }
                    if ok {
                        let cn0=leaves.ptr[0]
                        let s0=sense
                        loop nodes.ptr[cn0].kind =? 'not_' {cn0=ConditionWord(nodes.ptr[cn0].a); s0=not s0}
                        let v0=fact_capture(cn0 @state)
                        let r0=fact_bound(state v0)
                        if not state.live {
                            if need_other {other=FactState(live=false)}
                            return FactCondMeta(r0 0)
                        }
                        let tr0=fact_truth(state v0)
                        if (tr0 =? 1 and s0) or (tr0 =? 0 and not s0) {
                            if need_other {other=FactState(live=false)}
                            return FactCondMeta(r0 0)
                        }
                        if tr0 <? 0 {
                            let entry=state
                            let cont=state
                            fact_assume(@cont v0 (not s0))
                            let can_sc=false
                            let dummy=FactState(live=false)
                            loop li in [ConditionWord(1)..leaves.length) {
                                if not cont.live {can_sc=true; break}
                                let lf=leaves.ptr[li]
                                let lfk=nodes.ptr[lf].kind
                                if lfk not=? 'and_' and lfk not=? 'or_' and not fact_condition_block(lf) {
                                    let cni=lf
                                    let si=sense
                                    loop nodes.ptr[cni].kind =? 'not_' {cni=ConditionWord(nodes.ptr[cni].a); si=not si}
                                    let vi=fact_capture(cni @cont)
                                    if not cont.live {can_sc=true; break}
                                    let tri=fact_truth(cont vi)
                                    if not ((tri =? 0 and si) or (tri =? 1 and not si)) {can_sc=true}
                                    if not need_other and fact_speculating >? 0 and can_sc {break}
                                    fact_assume(@cont vi (not si))
                                } else {
                                    can_sc=true
                                    fact_cond_out(lf @cont @dummy true false (not sense));
                                    if not need_other and fact_speculating >? 0 {break}
                                }
                            }
                            if need_other {other=cont}
                            state=entry
                            if not can_sc and cont.live {fact_assume(@state v0 s0)}
                            return FactCondMeta(r0 0)
                        }
                    }
                }
            }
        }
        let sc_a=FactState(live=false)
        let ma=fact_cond_out(ConditionWord(nodes.ptr[n].a) @state @sc_a true need_state (not sense))
        let a_cont_live=state.live
        let a_sc_live=if need_state {sc_a.live} else {false}
        if not a_cont_live and refine_owners.length =? 0 {
            if need_other {other=FactState(live=false)}
            if need_state {state=sc_a}
            return FactCondMeta(ma.reason 0)
        }
        if not need_state {
            let mb=fact_cond_out(ConditionWord(nodes.ptr[n].b) @state @sc_a need_other false (not sense))
            if need_other {other=state; state=FactState(live=false)}
            return FactCondMeta(mb.reason 0)
        }
        let sc_b=FactState(live=false)
        let mb=fact_cond_out(ConditionWord(nodes.ptr[n].b) @state @sc_b need_other true (not sense))
        let reason=if a_sc_live and a_cont_live {ma.reason} else {mb.reason}
        if need_other {other=state}
        if fact_speculating =? 0 and fact_either_wanted & want_bit not=? 0 and a_sc_live and sc_b.live and ma.value not=? 0 and mb.value not=? 0 {
            let joined=fact_join(sc_a sc_b n)
            fact_either(@joined ma.value @sc_a sense mb.value @sc_b sense)
            state=joined
        } else {
            fact_join_into(@sc_a @sc_b n)
            state=sc_a
        }
        return FactCondMeta(reason 0)
    }
    if fact_condition_block(n) {
        let first=state.bindings.length
        loop i in [0..nkids(n) - 1) {fact_capture(kid(n i) @state);}
        let last=kid(n nkids(n) - 1)
        let m=fact_cond_out((if nodes.ptr[last].kind =? 'exprstmt' {ConditionWord(nodes.ptr[last].a)} else {last}) @state @other need_state need_other sense)
        if need_state and state.live and state.bindings.length >? first {fact_scope_exit(@state n first)}
        if need_other and other.live and other.bindings.length >? first {fact_scope_exit(@other n first)}
        return m
    }
    let v=if membership {fact_string_set(n @state)} else {fact_capture(n @state)}
    let reason=fact_bound(state v)
    if not state.live {
        if need_other {other=FactState(live=false)}
        return FactCondMeta(reason v)
    }
    if not need_other {
        fact_assume(@state v sense)
        if ownership_fact_cleanup {
            let drops=fact_drop_statement(n)
            fact_drop_forget(@state n drops)
        }
        if state.conditional.length >? 0 {result_activate(@state v)}
        return FactCondMeta(reason v)
    }
    if not need_state {
        let tr=fact_truth(state v)
        if not ((tr =? 1 and not sense) or (tr =? 0 and sense)) {fco_or_failed=true}
        fact_assume(@state v (not sense))
        if ownership_fact_cleanup {
            let drops=fact_drop_statement(n)
            fact_drop_forget(@state n drops)
        }
        if state.conditional.length >? 0 {result_activate(@state v)}
        other=state
        state=FactState(live=false)
        return FactCondMeta(reason v)
    }
    let tr=fact_truth(state v)
    if (tr =? 1 and sense) or (tr =? 0 and not sense) {
        fact_assume(@state v sense)
        if ownership_fact_cleanup {
            let drops=fact_drop_statement(n)
            fact_drop_forget(@state n drops)
        }
        if state.conditional.length >? 0 {result_activate(@state v)}
        other=FactState(live=false)
        return FactCondMeta(reason v)
    }
    if (tr =? 0 and sense) or (tr =? 1 and not sense) {
        fact_assume(@state v (not sense))
        if ownership_fact_cleanup {
            let drops=fact_drop_statement(n)
            fact_drop_forget(@state n drops)
        }
        if state.conditional.length >? 0 {result_activate(@state v)}
        other=state
        state=FactState(live=false)
        return FactCondMeta(reason v)
    }
    other=state
    fact_assume(@state v sense)
    fact_assume(@other v (not sense))
    if ownership_fact_cleanup {
        let drops=fact_drop_statement(n)
        fact_drop_forget(@state n drops)
        fact_drop_forget(@other n drops)
    }
    if state.conditional.length >? 0 {
        result_activate(@state v)
        result_activate(@other v)
    }
    FactCondMeta(reason v)
}
# Split during evaluation: RHS effects see the appropriate LHS edge, and
# success can only narrow the old captured value, not its replacement.
fact_condition=(n:ConditionWord entry:FactState need_yes:bool=true need_no:bool=true):>FactPaths=>$unsafe {
    let base=entry
    fact_condition_in(n @base need_yes need_no)
}
fact_condition_in=(n:ConditionWord @base:FactState need_yes:bool=true need_no:bool=true):>FactPaths=>$unsafe {
    let k=nodes.ptr[n].kind
    let membership=string_set_owners.length >? 0 and string_set_owners.has(fact_owner) and string_set_tests.has(n)
    if not membership and k =? 'not_' {
        let p=fact_condition_in(ConditionWord(nodes.ptr[n].a) @base need_no need_yes)
        return FactPaths(p.no p.yes p.reason)
    }
    if not membership and (k =? 'and_' or k =? 'or_') {
        if k =? 'and_' {
            let a=fact_condition_in(ConditionWord(nodes.ptr[n].a) @base true need_no)
            let a_yes_live=a.yes.live
            let ay=a.yes
            a.yes=FactState(live=false)
            let b=fact_condition_in(ConditionWord(nodes.ptr[n].b) @ay need_yes need_no)
            let reason=if a_yes_live and a.no.live {a.reason} else {b.reason}
            if not need_no {return FactPaths(b.yes FactState(live=false) reason)}
            let no=fact_join(a.no b.no n)
            # (`not (a and b)`: each side's refutation implies the other's)
            if fact_either_wanted & 2 not=? 0 and a.no.live and b.no.live and a.value not=? 0 and b.value not=? 0 {fact_either(@no a.value @a.no false b.value @b.no false)}
            return FactPaths(b.yes no reason)
        }
        let a=fact_condition_in(ConditionWord(nodes.ptr[n].a) @base need_yes true)
        let a_no_live=a.no.live
        let an=a.no
        a.no=FactState(live=false)
        let b=fact_condition_in(ConditionWord(nodes.ptr[n].b) @an need_yes need_no)
        let reason=if a.yes.live and a_no_live {a.reason} else {b.reason}
        if not need_yes {return FactPaths(FactState(live=false) b.no reason)}
        let yes=fact_join(a.yes b.yes n)
        if fact_either_wanted & 1 not=? 0 and a.yes.live and b.yes.live and a.value not=? 0 and b.value not=? 0 {fact_either(@yes a.value @a.yes true b.value @b.yes true)}
        return FactPaths(yes b.no reason)
    }
    # (a comparison chain holding an operand in a temporary, `-1 <=? i <? n`:
    # `{let $chain1 = -1; $chain1 <=? i and i <? n}` declares, then tests as
    # its last expression does; the temporaries leave scope on both paths.
    # O(block statements))
    if fact_condition_block(n) {
        let first=base.bindings.length
        loop i in [0..nkids(n) - 1) {fact_capture(kid(n i) @base);}
        let last=kid(n nkids(n) - 1)
        let p=fact_condition_in((if nodes.ptr[last].kind =? 'exprstmt' {ConditionWord(nodes.ptr[last].a)} else {last}) @base need_yes need_no)
        if need_yes and p.yes.live and p.yes.bindings.length >? first {fact_scope_exit(@p.yes n first)}
        if need_no and p.no.live and p.no.bindings.length >? first {fact_scope_exit(@p.no n first)}
        return p
    }
    let v=if membership {fact_string_set(n @base)} else {fact_capture(n @base)}
    let reason=fact_bound(base v)
    let entry_state=if fact_query {base} else {FactState(live=false)}
    if not need_no {
        fact_assume(@base v true)
        if ownership_fact_cleanup {
            let drops=fact_drop_statement(n)
            fact_drop_forget(@base n drops)
        }
        if base.conditional.length >? 0 {result_activate(@base v)}
        return FactPaths(base FactState(live=false) reason v entry_state)
    }
    if not need_yes {
        fact_assume(@base v false)
        if ownership_fact_cleanup {
            let drops=fact_drop_statement(n)
            fact_drop_forget(@base n drops)
        }
        if base.conditional.length >? 0 {result_activate(@base v)}
        return FactPaths(FactState(live=false) base reason v entry_state)
    }
    let no=base
    fact_assume(@base v true)
    fact_assume(@no v false)
    # (a leaf is its own statement: its temporaries drop before branching)
    if ownership_fact_cleanup {
        let drops=fact_drop_statement(n)
        fact_drop_forget(@base n drops)
        fact_drop_forget(@no n drops)
    }
    if base.conditional.length >? 0 {
        result_activate(@base v)
        result_activate(@no v)
    }
    FactPaths(base no reason v entry_state)
}
# A block of local declarations ending in its value: a condition's temporaries.
fact_condition_block=(n:ConditionWord):>bool=>$unsafe {
    if nodes.ptr[n].kind not=? 'block' or nkids(n) <? 2 or nkids(n) >? 8 {return false}
    loop i in [0..nkids(n) - 1) {
        let c=kid(n i)
        if nodes.ptr[c].kind not=? 'vardecl' or has_flag(c NF_GLOBAL) or nkids(c) not=? 0 {return false}
    }
    true
}
# After a join of two leaf conditions' paths, `x is x_truth or y is
# y_truth` holds (`if a and b return` leaves `not a or not b`; y's operands
# may be read under x's outcome, as y was evaluated there). Each side's
# refutation implying the other is conditional evidence (tag -2) that
# result_activate applies once the state entails its antecedent: a later
# guard, or a case split (fact_split_entails). At most two records per join,
# only for leaf comparisons of integer values present after the join or
# constants. O(1) each.
fact_either=(@s:FactState x:ConditionWord @xs:FactState x_truth:bool y:ConditionWord @ys:FactState y_truth:bool):>void=>{
    # (a loop's speculative rounds go without: its header keeps those of entry)
    if not s.live or fact_speculating not=? 0 or s.conditional.length + 2 >? 32 {return}
    let held:ConditionWord=0
    loop evidence in s.conditional {
            if evidence.tag =? -2 {held += 1}
        }
    if held + 2 >? 8 {return}
    let p=fact_leaf_literal(@s x @xs x_truth)
    if p[0] =? 'eof' {return}
    let q=fact_leaf_literal(@s y @ys y_truth)
    if q[0] =? 'eof' {return}
    # (not p implies q, not q implies p)
    fact_implication(@s [fact_inverse(p[0]) p[1] p[2] p[3] p[4]] q)
    fact_implication(@s [fact_inverse(q[0]) q[1] q[2] q[3] q[4]] p)
}
# Leaf v (captured in state vs) at truth as (op, left kind, left, right
# kind, right): kind 0 a value present in s, kind 1 a constant; op eof when
# it has no such form.
fact_leaf_literal=(@s:FactState v:ConditionWord @vs:FactState truth:bool):>[Tok int64 int64 int64 int64]=>{
    let blank:[Tok int64 int64 int64 int64]=[Tok.eof 0 0 0 0]
    let t=fact_terms[v]
    let op=Tok.eq
    let a=v
    let b:ConditionWord=if truth {1} else {0}
    let kb:ConditionWord=1
    if fact_comparison(t.op) and t.a not=? 0 and t.b not=? 0 {
        op=if truth {t.op} else {fact_inverse(t.op)}
        a=t.a
        b=t.b
        kb=0
    }
    else if t.op not=? 'eof' or t.type not=? 0 and fact_type(t.type) not=? T_BOOL {return blank}
    let ka:ConditionWord=0
    if fact_type(fact_terms[a].type) =? T_U64 or kb =? 0 and fact_type(fact_terms[b].type) =? T_U64 {return blank}
    a=fact_leaf_operand(@s a vs)
    if kb =? 0 {b=fact_leaf_operand(@s b vs)}
    if fact_slot(s a) <? 0 {
        let x=fact_bound(vs a)
        if x.wide or x.lo not=? x.hi {return blank}
        ka=1
        a=x.lo
    }
    if kb =? 0 and fact_slot(s b) <? 0 {
        let y=fact_bound(vs b)
        if y.wide or y.lo not=? y.hi {return blank}
        kb=1
        b=y.lo
    }
    # (two constants: decided where it was evaluated, so it says nothing more)
    if ka =? 1 and kb =? 1 {return blank}
    [op ka a kb b]
}
# An operand evaluated on one path that names a field of a value present
# after the join (`q =? 0` tests q's numerator) names that field there too.
# O(1) indexed lookups.
fact_leaf_operand=(@s:FactState x:ConditionWord vs:FactState):>ConditionWord=>{
    if fact_slot(s x) >=? 0 {return x}
    let pi=fact_projection_origin(vs x)
    if pi <? 0 {return x}
    let p=vs.projections[pi]
    if p.element or fact_slot(s p.base) <? 0 or s.projections.length >=? FACT_CAP {return x}
    fact_project(@s p.base p.selector false fact_terms[x].type)
}
fact_implication=(@s:FactState ante:[Tok int64 int64 int64 int64] then:[Tok int64 int64 int64 int64]):>void=>{
    fact_implications.push(FactImplication(ante[0] ante[2] ante[4] then[0] then[2] then[4] ante[1] | (ante[3] << 1) | (then[1] << 2) | (then[3] << 3)))
    # (result names a value it reads, which compaction then keeps)
    s.conditional.push(ResultEvidence((if ante[1] =? 0 {ante[2]} else {ante[4]}) (-2) 0 [] [] 0 fact_implications.length))
}
# Whether implication e's antecedent (part 0) or consequent (part 1) holds
# in s, allocating nothing: intervals against a constant, else fact_compare.
# O(1) or one bounded relation query.
fact_implied=(s:FactState e:ResultEvidence part:ConditionWord):>bool=>{
    let r=fact_implications[e.base - 1]
    let op=if part =? 0 {r.op0} else {r.op1}
    let x=if part =? 0 {r.a0} else {r.a1}
    let y=if part =? 0 {r.b0} else {r.b1}
    let kx=(r.k >> (part * 2)) & 1
    let ky=(r.k >> (part * 2 + 1)) & 1
    if kx =? 0 and ky =? 0 {return fact_compare(s op x y) =? 1}
    let v=x
    let c=y
    if kx =? 1 {
        v=y
        c=x
        op=if op =? 'lt' {Tok.gt} else if op =? 'le' {Tok.ge} else if op =? 'gt' {Tok.lt} else if op =? 'ge' {Tok.le} else {op}
    }
    let b=fact_bound(s v)
    if b.wide {return false}
    if op =? 'lt' {return b.hi <? c}
    if op =? 'le' {return b.hi <=? c}
    if op =? 'gt' {return b.lo >? c}
    if op =? 'ge' {return b.lo >=? c}
    if op =? 'eq' {return b.lo =? c and b.hi =? c}
    if op =? 'ne' {return b.hi <? c or b.lo >? c or c =? 0 and b.nz}
    false
}
# Whether leaf condition v tests a value implication e's antecedent reads.
fact_implication_reads=(e:ResultEvidence v:ConditionWord):>bool=>$unsafe {
    let r=fact_implications.ptr[e.base - 1]
    let t=fact_terms.ptr[v]
    let k0=r.k & 1 =? 0
    let k1=r.k & 2 =? 0
    if v not=? 0 and ((k0 and r.a0 =? v) or (k1 and r.b0 =? v)) {return true}
    if t.a not=? 0 and ((k0 and r.a0 =? t.a) or (k1 and r.b0 =? t.a)) {return true}
    t.b not=? 0 and ((k0 and r.a0 =? t.b) or (k1 and r.b0 =? t.b))
}
# Assume implication e's consequent in s.
fact_imply=(@s:FactState e:ResultEvidence):>void=>{
    let r=fact_implications[e.base - 1]
    let a=if r.k & 4 =? 0 {r.a1} else {fact_constant(@s r.a1)}
    let b=if r.k & 8 =? 0 {r.b1} else {fact_constant(@s r.b1)}
    fact_assume(@s fact_new(@s fact_domain(T_BOOL) FactTerm(r.op1 a b)) true)
}
# Assume an optional's or union's tag is (or is not) wanted.
fact_tag=(@s:FactState value:ConditionWord wanted:ConditionWord truth:bool):>void=>{
    if value =? 0 or not s.live {return}
    let tag=fact_project(@s value (-3) false T_INT)
    fact_assume(@s fact_new(@s fact_domain(T_BOOL) FactTerm('eq' tag fact_constant(@s wanted))) truth)
    if truth and s.conditional.length >? 0 {result_activate(@s)}
}
# The tag one pattern establishes, or -1.
fact_pattern_tag=(p:ConditionWord st:ConditionWord):>ConditionWord=>$unsafe {
    let k=nodes.ptr[p].kind
    if is_union(st) and k =? 'pvariant' {return ConditionWord(node_aux2(nodes.ptr[p].op_ext))}
    if is_union(st) and k =? 'plit' {return ConditionWord(node_aux2(nodes.ptr[p].op_ext))}
    if types.ptr[st].kind =? 'opt' {
        if k =? 'ptype' and node_aux2(nodes.ptr[p].op_ext) not=? 1 {return 1}
        if k =? 'plit' and nodes.ptr[ConditionWord(nodes.ptr[p].a)].kind =? 'none_lit' {return 0}
    }
    -1
}
# Implication operand slot (kind bit set: a constant) renamed by map.
fact_stable_operand=(v:ConditionWord constant:ConditionWord map:dict<int64 int64>):>ConditionWord=>{
    if constant not=? 0 {v} else {map.get(v) ?? v}
}
# Implications only one header holds (a changing optional's, fact_loop_payload)
# match the other's through the renamed tags and payloads. O(B + I^2), I <= 12.
fact_loop_stable_implications=(a:FactState b:FactState):>bool=>{
    if a.conditional =? b.conditional {return true}
    let mine:array<ResultEvidence>=[]
    let theirs:array<ResultEvidence>=[]
    loop evidence in a.conditional {
        if evidence.tag =? -2 and not (evidence in? b.conditional) {mine.push(evidence)}
    }
    loop evidence in b.conditional {
        if evidence.tag =? -2 and not (evidence in? a.conditional) {theirs.push(evidence)}
    }
    if mine.length not=? theirs.length {return false}
    if mine.length =? 0 {return true}
    let map=dict<int64 int64>()
    loop binding in a.bindings {
        let i=fact_binding(b binding.place)
        if i <? 0 or fact_summary_payload(fact_type(fact_terms[binding.value].type)) =? 0 {continue}
        loop selector in [(-3) (-4)] {
            let x=fact_projection_value(a binding.value selector)
            let y=fact_projection_value(b b.bindings[i].value selector)
            if x not=? 0 and y not=? 0 {map[x]=y}
        }
    }
    loop evidence in mine {
        let r=fact_implications[evidence.base - 1]
        let found=false
        loop other in theirs {
            let q=fact_implications[other.base - 1]
            if q.k not=? r.k or q.op0 not=? r.op0 or q.op1 not=? r.op1 {continue}
            if q.a0 =? fact_stable_operand(r.a0 r.k & 1 map) and q.b0 =? fact_stable_operand(r.b0 r.k & 2 map) and q.a1 =? fact_stable_operand(r.a1 r.k & 4 map) and q.b1 =? fact_stable_operand(r.b1 r.k & 8 map) {found=true; break}
        }
        if not found {return false}
    }
    true
}

use 'type_intern.dewy'
use 'concurrency.jo'
# Type representation: all types live in `types` and are referred to by index.
# Concrete types are interned (equal types have equal ids); types containing
# inference variables are not, and are compared structurally.

use 'util.jo'
use 'ast.jo'
use 'check.jo'
use 'expr.jo'
use 'units.jo'
use 'errors.jo'
use 'refine.jo'
use 'effects.jo'
use 'node_store.dewy'

# (fixed: T[N], N elements stored in place; elem is T, bits is N. box: what a field holding its
# own struct or enum keeps, a pointer to its value (elem) on the heap; only the lowering sees it)
const TF_HAS_VAR = 1

const TF_LAID_OUT = 2

const TF_MANAGED = 4

const TF_NEVER = 8

const TF_BOXED = 16    # inline storage contains recursive managed boxes

types: TypeInfo[] = [TypeInfo()]
type_args: i32[]
type_ht: i32[]
type_intern_binding = type_intern_bind(&types, &type_args, &type_ht)
structs: StructInfo[]
fields: Field[]
variants: Variant[]
ptr_size = 8     # 4 for wasm32
layout_host = TypeLayoutHost(check_struct_fields, mk_box, quantity_base, math_optional, layout_endless_error, layout_cycle_error, layout_cache_padded)
layout_input = TypeLayoutInput(&types, &structs, &type_args, &fields, &variants, &ptr_size, &layout_host)
layout_binding = type_layout_bind(&layout_input)

# built-in types (indices fixed at startup)
T_VOID = 0
T_BOOL = 0
T_INT = 0
T_MATH_INT = 0    # semantic integer, independent of its selected storage representation
property_host = TypePropertyHost(is_lib_texture, check_struct_fields)
property_input = TypePropertyInput(&types, &structs, &type_args, &fields, &variants, &refine_active, &T_MATH_INT, &property_host)
property_binding = type_property_bind(&property_input)
T_I8 = 0
T_I16 = 0
T_I32 = 0
T_U8 = 0
T_U16 = 0
T_U32 = 0
T_U64 = 0
T_FLOAT = 0
T_F32 = 0
T_STR = 0
T_NULL = 0
T_RANGE = 0
T_NONE = 0
T_NEVER = 0
union_type_name = (t: int) -> str: type_str(t)
union_postfix_name = (t: int) -> str: type_str_postfix(t)
union_host = TypeUnionHost(mk_opt, str_set_of, str_set_type, union_postfix_name, union_type_name, intern)
union_input = TypeUnionInput(&types, &structs, &type_args, &fields, &variants, &str_sets, &T_NEVER, &T_NONE, &union_host)
union_binding = type_union_bind(&union_input)
T_RAWPTR = 0
T_VEC2 = 0
T_VEC3 = 0
T_VEC4 = 0
T_MAT4 = 0
T_IVEC2 = 0
T_IVEC3 = 0
T_IVEC4 = 0

# Word overflow predicate shared by semantic folding and IR folding. Operands
# are bit patterns in the implementation language, whose int remains wrapping.
math_word_overflow = (operation: int, x: int, y: int) -> bool:
    if operation == 0:
        r = x + y
        return ((x xor r) & (y xor r)) < 0
    if operation == 1:
        r = x - y
        return ((x xor y) & (x xor r)) < 0
    if operation == 2:
        ax = if x < 0: u64(-(x + 1)) + 1 else: u64(x)
        ay = if y < 0: u64(-(y + 1)) + 1 else: u64(y)
        limit = if (x < 0) != (y < 0): u64(9223372036854775807) + 1 else: u64(9223372036854775807)
        return ay != 0 and ax > limit / ay
    if operation == 3: return y == 0 or (x == -9223372036854775807 - 1 and y == -1)
    if y < 0: return true
    if y >= 64: return x != 0
    ((x << y) >> y) != x

targ = (t: int, i: int) -> int: int(type_args[int(types[t].args) + i])
tkind = (t: int) -> TK: types[prune(t)].kind
telem = (t: int) -> int: int(types[prune(t)].elem)
has_var = (t: int) -> bool: int(types[t].flags) & TF_HAS_VAR != 0

# Complete interning runs in Dewy over these shared arena headers.
__type_hash = (t: TypeInfo, args: int[]) -> u64: type_intern_hash(&t, args)
__type_same = (id: int, t: TypeInfo, args: int[]) -> bool: type_intern_same(id, &t, args)
__type_rehash = (): type_intern_rehash()
mk_type = (t: TypeInfo, args: int[]) -> int: type_intern(&t, args)

basic = (kind: TK, bits: int, sign: bool, size: int) -> int: tb_basic(kind, bits, sign, size)

mk_array = (e: int) -> int: tb_mk_array(e)

mk_fixed = (e: int, n: int) -> int: tb_mk_fixed(e, n)

fixed_len = (t: int) -> int: int(types[prune(t)].bits)
mk_ptr = (e: int) -> int: tb_mk_ptr(e)

mk_box = (e: int) -> int: tb_mk_box(e)

mk_opt = (e: int) -> int: tb_mk_opt(e)

# secret<T> (docs/design/decisions.md): T's value under a compile-time wrapper. Its
# representation is T's (layout, lowering: quantity_base strips it); only the checker tells them
# apart, so the value reaches no output except as `<redacted>` and leaves only through `.reveal`.
secrets_seen = false     # (a secret type was made: until then secret_repr has nothing to do)
mk_secret = (e: int) -> int: tb_mk_secret(e)

is_secret = (t: int) -> bool: types[prune(t)].kind == .secret
# t's representation: t with its secrets, and those of what it is made of, replaced by their values
secret_repr = (t0: int) -> int: tb_secret_repr(t0)

# Callable labels are compile-time metadata, interned as a newline-separated
# name tuple in st (unused by fn_ layout). Positional implementation-language
# callables retain zero, without any label allocation or ABI change.
fn_label_key = (names: int[]) -> int:
    key = ""
    named = false
    loop i in 0.. and name in names:
        if i > 0: key += "\n"
        value = name_of(name)
        if value == "_" or (len(value) > 0 and value[0] == '$'): value = ""
        if value != "": named = true
        key += value
    if named: intern(key) else: 0

fn_label_names = (key: int, count: int) -> int[]:
    if key == 0: return fill(0, count)
    out: int[]
    loop name in split(name_of(key), "\n"): out.push(if name == "": 0 else: intern(name))
    out

decl_fn_labels = (decl: int) -> int:
    if decl == 0 or not files[pos_file(nodes[decl].pos)].is_dewy: return 0
    names: int[]
    loop p in kids(decl): names.push(int(nodes[p].name))
    fn_label_key(names)

# defaults: the function instance whose parameter defaults a call through the
# value fills in (`g = @f` keeps f's defaults); 0 when none travel with it.
# Kept in bits: part of the type's identity, ignored by the calling convention.
# (`pack`: the function gives several values: ret is `(int64 int64)` when their number is
# fixed, returned in place, or the array of them when it varies)
mk_fn = (params: int[], ret: int, mutmask: int, labels: int = 0, defaults: int = 0, pack: bool = false) -> int: tb_mk_fn(params, ret, mutmask, labels, defaults, pack)

fn_type_pack = (t: int) -> bool: types[t].kind == .fn_ and types[t].sign
mk_cfn = (params: int[], ret: int) -> int: tb_mk_cfn(params, ret)

# (`values`: several values, `(int64 int64)` in Dewy: what `pair = (1 2)` holds, not a
# container; laid out as a tuple. docs/design/multi_expressions.md)
mk_tuple = (elems: int[], values: bool = false) -> int: tb_mk_tuple(elems, values)

values_any = false   # (some value of several values was made: their checks run only then)
mk_values = (elems: int[]) -> int: tb_mk_values(elems)

is_values = (t0: int) -> bool:
    if t0 == 0: return false
    t = prune(t0)
    types[t].kind == .tuple and types[t].sign
var_counter = 0
constructor_host = TypeConstructorHost(mk_type)
constructor_input = TypeConstructorInput(&types, &ptr_size, &var_counter, &secrets_seen, &values_any, &T_VOID, &T_BOOL, &T_INT, &T_MATH_INT, &T_I8, &T_I16, &T_I32, &T_U8, &T_U16, &T_U32, &T_U64, &T_FLOAT, &T_F32, &T_STR, &T_NULL, &T_RANGE, &T_NONE, &T_NEVER, &T_RAWPTR, &T_VEC2, &T_VEC3, &T_VEC4, &T_MAT4, &T_IVEC2, &T_IVEC3, &T_IVEC4, &constructor_host)
constructor_binding = type_constructor_bind(&constructor_input)
# (each binding of a type variable: a body checked with neither a new variable nor a binding
# has no type a zonk would change)
type_binds = 0
inference_host = TypeInferenceHost(mk_callable_contract, effect_subst, effect_type, mk_refined, ref_subst, mk_quantity, get_struct_inst, mk_type, mk_union)
inference_input = TypeInferenceInput(&types, &structs, &type_args, &type_binds, &inference_host)
inference_binding = type_inference_bind(&inference_input)
mk_var = () -> int: tb_mk_var()

mk_param = (idx: int) -> int: tb_mk_param(idx)

mk_typeval = (t: int) -> int: tb_mk_typeval(t)

mk_modval = (m: int) -> int: tb_mk_modval(m)

init_types = (): tb_init_types()

prune = (t0: int) -> int:
    t = t0
    loop t != 0 and types[t].kind == .var and types[t].ref != 0: t = int(types[t].ref)
    t

# Integer overflow policy is interned in st (0 exact, 1 wrap, 2 saturate).
# It changes value semantics, not the ABI or storage layout.
int_policy = (t: int) -> int:
    let t = prune(t)
    if types[t].kind != .int_ or t == T_MATH_INT: return 0
    int(types[t].st)

policy_int = (base: int, policy: int, pos: int) -> int:
    t = prune(base)
    if not is_int(t) or t == T_MATH_INT: fatal(pos, "overflow= requires a fixed-width integer type")
    ti = types[t]
    ti.st = i32(policy)
    mk_type(ti, [])

is_int = (t: int) -> bool: types[prune(t)].kind == .int_
is_float = (t: int) -> bool: types[prune(t)].kind == .float_
is_numeric = (t: int) -> bool:
    k = types[prune(t)].kind
    k == .int_ or k == .float_
is_vec = (t: int) -> bool: types[prune(t)].kind == .vec

occurs = (v: int, t0: int) -> bool:
    t = prune(t0)
    if t == v: return true
    if not has_var(t): return false
    type_query_occurs_children(types, structs, type_args, v, t)

zonk = (t: int) -> int: tu_zonk(t)

struct_targ = (si: int, i: int) -> int: int(type_args[int(structs[si].targs) + i])

type_eq = (a0: int, b0: int) -> bool:
    a = prune(a0)
    b = prune(b0)
    if a == b: return true
    if a == 0 or b == 0: return false
    if not has_var(a) and not has_var(b): return false
    type_query_equal_shape(types, structs, type_args, a, b)

unify = (a: int, b: int) -> bool: tu_unify(a, b)
unify_unions = (a: int, b: int) -> bool: tu_unify_unions(a, b)

simple_enum = (t: int) -> bool: tp_simple_enum(t)
is_managed = (t: int) -> bool: tp_is_managed(t)
plain_problem = (t: int) -> str: tp_plain_problem(t)

is_lib_texture = (si: int) -> bool:
    if structs[si].name != "Texture" or structs[si].decl == 0: return false
    fi = pos_file(nodes[int(structs[si].decl)].pos)
    fi >= 0 and fi < files.len() and files[fi].path == lib_dir + "/game/draw2d.jo"

# can a value of this type hold a function value (a closure)? (through arrays, optionals, tuples,
# struct and enum fields, and union members)
type_has_fn = (t: int) -> bool: tp_type_has_fn(t)
math_optional = (t: int) -> bool: tp_math_optional(t)
is_aggregate = (t: int) -> bool: tp_is_aggregate(t)

align_up = (x: int, a: int) -> int: (x + a - 1) & ~(a - 1)
tsize = (t: int) -> int:
    layout(t)
    int(types[prune(t)].size)
talign = (t: int) -> int:
    layout(t)
    a = int(types[prune(t)].align)
    if a == 0: return 1
    a

# Complete recursive boxing, finite defaults and layout execute in Dewy.
type_holds = (t: int, target: int) -> bool: tl_type_holds(t, target)
holds_in = (t: int, target: int, gen: int) -> bool: tl_holds_in(t, target, gen)
decide_boxes = (si: int): tl_decide_boxes(si)
box_default = (t: int) -> int: tl_box_default(t)
zero_ends = (t: int) -> bool: tl_zero_ends(t)
variant_ends = (si: int, v: int) -> bool: tl_variant_ends(si, v)
fields_end = (f: int, n: int) -> bool: tl_fields_end(f, n)
endless_check = (si: int): tl_endless_check(si)
endless_field = (si: int, f: int, vi: int): tl_endless_field(si, f, vi)
layout = (t: int): tl_layout(t)

layout_endless_error = (si: int, f: int, vi: int):
    ft = int(fields[f].type)
    nm = structs[si].name
    fname = name_of(int(fields[f].name))
    dewy = files[pos_file(nodes[int(structs[si].decl)].pos)].is_dewy
    fix = "`{fname}: {type_str_postfix(ft, dewy)}?`"
    if vi >= 0: fix = "`{name_of(int(variants[vi].name))}({fname}: {type_str_postfix(ft, dewy)}?)`"
    fatal(nodes[int(structs[si].decl)].pos, "recursive type '{nm}' has no finite value: field '{fname}' keeps containing {type_str(ft, dewy)}; make it optional ({fix}) or an array")
layout_cycle_error = (si: int): ice("{structs[si].name} laid out inside itself")
layout_cache_padded = (t: int) -> bool:
    si = int(types[t].st)
    structs[si].decl != 0 and nodes[int(structs[si].decl)].name == i32(intern("CachePadded")) and concurrency_builtin_type(t, "CachePadded")

# a type followed by [] or ? or |: function types and unions need parentheses there
type_str_postfix = (t: int, dewy: bool = false) -> str: tf_postfix(t, dewy)

# (a type's text is cut short past 150 of its parts: types built from aliases of aliases,
# (F, F) -> int with F = (G, G) -> int..., would spell out exponentially)

# Diagnostics name types the way the program being compiled spells them:
# int64, float64, string and array<T> for Dewy; int, f64, str and T[] for Sloppy.
ts_dewy = false
# (text in the spelling of the program being compiled: Sloppy's, else Dewy's)
tsd = (jo: str, dewy: str) -> str: if ts_dewy: dewy else: jo
dt = (t: int) -> str: type_str(t, ts_dewy)
# (a type mismatch's side: a Dewy union by the alias the program names it with)
dt_named = (t: int) -> str:
    alias = if ts_dewy: union_alias_names.get(prune(t)) ?? 0 else: 0
    if alias != 0: return name_of(alias)
    dt(t)
# (the names of the type parameters of the declaration whose types are being shown: a
# parameter that has none shows as T, U, ... by its place)
ts_params: int[]
format_host = TypeFormatHost(int_intervals, small_span, dimension_str, name_of, str_set_text, check_struct_fields, bundled_rational_type, bundled_word_rational_type, is_dewy_set_type)
format_input = TypeFormatInput(&types, &structs, &type_args, &fields, &ts_params, &nominal_parent, &T_MATH_INT, &T_INT, &T_MAT4, &format_host)
format_binding = type_format_bind(&format_input)

type_str = (t: int, dewy: bool = false) -> str: tf_string(t, dewy)
type_str_in = (t: int, dewy: bool) -> str: tf_string_in(t, dewy)

# ---------- unions ----------
# A | B | C is a tagged value laid out like an enum: variant i holds member i. Members are flat,
# distinct and sorted by type id, so A | B is B | A; T | none is T?, and a single member is itself.
is_union = (t0: int) -> bool:
    t = prune(t0)
    types[t].kind == .enum_ and structs[int(types[t].st)].union_

union_members = (t0: int) -> int[]:
    si = int(types[prune(t0)].st)
    out: int[]
    loop i in [0..int(structs[si].ntargs)): out.push(struct_targ(si, i))
    out

# the index of member m in union u (-1 if it is not one)
union_index = (u: int, m: int) -> int:
    si = int(types[prune(u)].st)
    loop i in [0..int(structs[si].ntargs)):
        if type_eq(struct_targ(si, i), m): return i
    -1

# the member of union u that holds union member m: m itself, or else u's string set when
# m is one too (a union has at most one), holding all of m's members when `whole`
# (`'b'|'c'` in `'a'|'b'|'c' | int64`); -1 if none
union_holder = (u: int, m: int, whole: bool) -> int:
    i = union_index(u, m)
    ms = str_set_of(m)
    if i >= 0 or ms == 0: return i
    loop j in 0.. and x in union_members(u):
        xs = str_set_of(x)
        if xs != 0:
            if whole:
                loop value in str_sets[ms]:
                    if not str_sets[xs].contains(value): return -1
            return j
    -1

mk_union = (ms: int[]) -> int: uu_mk_union(ms)

# mk_union supplies flat, sorted member IDs. Concrete unions are canonical;
# unresolved members still need structural matching until inference finishes.
# (a Dewy union the program names with one non-generic alias, `Value:type=int64|string`:
# diagnostics show the alias; 0 when two aliases name it)
union_alias_names: {int: int} = {}

union_alias_note = (t0: int, name: int):
    t = prune(t0)
    if tkind(t) != .struct_ and tkind(t) != .enum_ or not structs[int(types[t].st)].union_: return
    if let seen = union_alias_names.get(t):
        if seen != name: union_alias_names[t] = 0
        return
    union_alias_names[t] = name

union_inst = (ms: int[]) -> int: uu_union_inst(ms)

# ---------- struct-of-arrays ----------
# soa T[] behaves like T[] but keeps each field of T in an array of its own (see check_soa_*)
soa_decl = 0       # the declaration node standing for all soa types
factory_declaration = (decl: int) -> TypeDeclInfo:
    TypeDeclInfo(name_of(int(nodes[decl].name)), has_flag(decl, NF_RECORD), nodes[decl].kind == .enum_)
factory_nesting_error = (decl: int):
    fatal(nodes[decl].pos, "the generic type '{name_of(int(nodes[decl].name))}' expands without end: its type arguments nest more than {MAX_TYPE_NESTING} deep (does a field use it with a bigger type argument than its own?)")
factory_host = TypeFactoryHost(check_struct_fields, mk_array, factory_declaration, factory_nesting_error)
factory_input = TypeFactoryInput(&types, &structs, &type_args, &fields, &soa_decl, &factory_host)
factory_binding = type_factory_bind(&factory_input)

is_soa = (t0: int) -> bool:
    t = prune(t0)
    types[t].kind == .struct_ and structs[int(types[t].st)].soa_

soa_elem = (t: int) -> int: struct_targ(int(types[prune(t)].st), 0)

soa_inst = (p: int) -> int: tc_soa_inst(p)

# how deeply a type nests (counted up to lim; remembered per type once known exactly, so a type
# sharing parts, (F, F) -> int, is not walked once per path)
type_nesting = (t: int, lim: int) -> int: tc_nesting(t, lim)

const MAX_TYPE_NESTING = 48

# ---------- struct instances ----------
# Concrete argument lists have canonical instances. Inference-bearing requests
# still match structurally; zonking them must produce a concrete instance rather
# than returning an earlier record whose TF_HAS_VAR flag can never clear.
get_struct_inst = (decl: int, args: int[]) -> int: tc_struct_inst(decl, args)

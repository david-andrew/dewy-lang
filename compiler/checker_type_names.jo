rational_name = 0

resolve_type_name = (tn: int) -> CheckerTypeName:
    if nodes[tn].aux == -8: fatal(nodes[tn].pos, "Effect row is not a value type")
    nm = int(nodes[tn].name)
    s = 0
    if nodes[tn].sval != 0:
        # (`(@w).Closed`: a type a named wait gives, decisions.md batch 7)
        wait_member = named_wait_type(tn)
        if wait_member != 0: return CheckerTypeName(0, wait_member)
        ms = lookup(int(nodes[tn].sval))
        if ms != 0 and syms[ms].kind == .reflected and name_of(nm) == "type": return CheckerTypeName(0, int(fields[int(syms[ms].ref)].type))
        # (`heart.<Tick>`: the type itself, selected on a wait, decisions.md batch 7)
        if ms != 0 and (syms[ms].kind == .local or syms[ms].kind == .global) and name_of(nm) == "<>":
            if nkids(tn) != 1: fatal(nodes[tn].pos, "`{name_of(int(nodes[tn].sval))}.<T>` selects one type")
            return CheckerTypeName(0, resolve_type(kid(tn, 0)))
        # (`r.Png`, `heart.Tick`: a value's type member, decisions.md batch 7)
        if ms != 0 and syms[ms].kind != .module:
            member = value_type_member(ms, nm, nodes[tn].pos)
            if member != 0: return CheckerTypeName(0, member)
            if syms[ms].kind == .local or syms[ms].kind == .global:
                q = name_of(int(nodes[tn].sval))
                vt = if syms[ms].kind == .local: int(locals[int(syms[ms].ref)].type) else: int(globals[int(syms[ms].ref)].type)
                why = handle_member_error(q, vt, nm)
                if len(why) > 0: fatal(nodes[tn].pos, why)
                fatal(nodes[tn].pos, "'{q}' has no member '{name_of(nm)}' that is a type")
        if ms == 0 or syms[ms].kind != .module: fatal(nodes[tn].pos, "unknown module '{name_of(int(nodes[tn].sval))}'")
        s = module_lookup(int(syms[ms].ref), nm)
        if name_of(int(nodes[tn].sval))[0] != '$' and files[pos_file(nodes[tn].pos)].is_dewy: rational_one_spelling(int(syms[ms].ref), nm, nodes[tn].pos, "")
    else:
        if ide_sentinel != 0 and nm == ide_sentinel: ide_complete_types()
        s = lookup(nm)
        jo_type_spelling(nm, s, nodes[tn].pos)
        if nm == ut_safe_name: ut_note_type_name(nm, nodes[tn].pos)
        # `rational`: the builtin exact type (the bundled library's), unless a type shadows it.
        if rational_name == 0: rational_name = intern("rational")
        if nm == rational_name and (s == 0 or syms[s].kind == .fns) and files[pos_file(nodes[tn].pos)].is_dewy:
            return CheckerTypeName(5, 0)
    # `secret<T>`: the builtin wrapper (types.jo's mk_secret), unless a type shadows it
    if nm == secret_name and nodes[tn].sval == 0 and (s == 0 or not secret_type_sym(syms[s].kind)):
        if nkids(tn) != 1: fatal(nodes[tn].pos, jd(nodes[tn].pos, "`secret` takes one type argument: `secret[str]`", "`secret` takes one type argument: `secret<string>`"))
        return CheckerTypeName(4, 0)
    if s == 0:
        if name_of(nm) == "none": return CheckerTypeName(0, T_NONE)
        # (push = (h: mut Heap[T], x: T): a generic function names its type parameters)
        tn_s = name_of(nm)
        if len(tn_s) <= 2 and tn_s[0] >= 'A' and tn_s[0] <= 'Z' and cx >= 0 and fns.len() > int(ctxs[cx].inst):
            fatal(nodes[tn].pos, jd(nodes[tn].pos, "unknown type '{tn_s}' (a generic function names its type parameters after its name: `f[{tn_s}] = (x: {tn_s}) -> {tn_s}: ...`; a generic struct, `struct Heap[{tn_s}]:`)", "unknown type '{tn_s}' (a generic function declares its type parameters first: `f = <{tn_s}>(x:{tn_s}):>{tn_s} => ...`; a generic record, `Heap:type = <{tn_s}>[items:array<{tn_s}>]`)"))
        if name_of(nm) == "Cancelled": fatal(nodes[tn].pos, "unknown type `Cancelled`; use `Canceled` (US spelling)")
        fatal(nodes[tn].pos, "unknown type '{name_of(nm)}'{suggestion(name_of(nm), type_names())}")
    sk = syms[s].kind
    # (str = (b: Big) -> str: a function of the program's named as a type, its `str` there
    # still the type)
    if sk == .fns:
        if let u = universe.get(nm):
            s = u
            sk = syms[s].kind
    # (`let u8 = ...` beside `x:uint8`: a value never names a builtin integer type,
    # whose internal name a local may share)
    if (sk == .local or sk == .global) and nodes[tn].sval == 0:
        if let u = universe.get(nm):
            if syms[u].kind == .type_ and is_int(int(syms[u].ref)):
                s = u
                sk = .type_
    if ide_on: ide_sym_ref(tn, s)
    if sk == .alias_: return CheckerTypeName(1, int(syms[s].ref))
    if sk == .type_:
        t = int(syms[s].ref)
        if nodes[tn].nlist == 0:
            if tkind(t) == .effect: fatal(nodes[tn].pos, "Effect row is not a value type")
            return CheckerTypeName(0, nominal_family(t))
        return CheckerTypeName(3, t)
    if sk == .struct_ or sk == .enum_:
        d = int(syms[s].ref)
        if nkids2(d) == 0 and nkids(tn) == 0: return CheckerTypeName(0, nominal_family(get_struct_inst(d, [])))
        # (`<Closed>`, `is? Closed`: every instance, while a test's type is resolved)
        if bare_generic_ok and nkids(tn) == 0 and nkids2(d) > 0 and nodes[kid2(d, 0)].b == 0:
            family = generic_family_type(d)
            if family != 0: return CheckerTypeName(0, family)
        return CheckerTypeName(2, d)
    if dewy_at(nodes[tn].pos):
        integer = named_integer_type(tn, s)
        if integer != 0: return CheckerTypeName(0, integer)
    h = habit_name(name_of(nm))
    if len(h) > 0: fatal(nodes[tn].pos, "'{name_of(nm)}' is not a type (use {h})")
    fatal(nodes[tn].pos, "'{name_of(nm)}' is not a type")
    CheckerTypeName()

jo_type_spelling = (nm: int, s: int, pos: int):
    if jo_type_names.len() == 0:
        loop w in ["str", "byte", "f32", "f64", "i8", "i16", "i32", "i64", "u8", "u16", "u32", "u64"]:
            id = intern(w)
            if jo_type_names.len() <= id: jo_type_names.resize(id + 1)
            jo_type_names[id] = true
    if nm >= jo_type_names.len() or not jo_type_names[nm] or s == 0 or not dewy_at(pos) or (universe.get(nm) ?? 0) != s: return
    w = name_of(nm)
    src = files[pos_file(pos)].src
    off = pos_off(pos)
    stop = off + len(w)
    if stop > len(src) or (stop < len(src) and is_ident_char(src[stop])): return
    loop i in [0..len(w)):
        if src[off + i] != w[i]: return
    dewy = dewy_type_word(w)
    fatal(pos, "`{w}` is not a Dewy type name: write `{dewy}`")

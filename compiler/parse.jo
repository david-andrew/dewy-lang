use 'checker_tokens.dewy'
# Parser: tokens -> AST (nodes in ast.jo).

use 'util.jo'
use 'diagnostic_exit.dewy'
use 'module_paths.dewy'
use 'lex.jo'
use 'lexer_units.dewy'
use 'lexer_errors.dewy'
use 'ast.jo'
use 'literals.dewy'
use 'node_store.dewy'
use 'parser_units.dewy'
use 'parser_errors.dewy'
use 'parser_flow_nodes.dewy'
use 'parser_positions.dewy'
use 'parser_cursor.dewy'
use 'parser_expr.dewy'
use 'parser_forms.dewy'
use 'parser_decls.dewy'
use 'parser_stmts.dewy'
use 'parser_loops.dewy'

toks: Token[]
# A parse unit owns its EOF-terminated stream. Borrow once on entry; recursive
# interpolation and demanded-unit parsing restore the borrow with the owning array.
# Look-ahead past the eof (`p_toks[j + 4]`) reads the zeroed spare slots lex leaves
# after it (LX_SPARE of them), which are eofs too.
p_toks: *Token = null
p_ntoks = 0
ti = 0
p_file = 0
p_src = ""
p_no_tuple = false
p_when_top = false
p_base = 0               # where p_src starts in the file (an interpolation's source is part of it)
# A library file's top-level functions keep their bodies as text until a program uses them
# (ensure_body): the lexer gives each one as a .lazy token. Most of the library is never called,
# and lexing and parsing all of it was a quarter of building a small game.
p_lazy = false           # (parsing a library file, outside the editor)
p_top_decl = false       # (the function being parsed is a top-level one)

tok_src = (i: int) -> str:
    s = int(p_toks[i].start)
    p_src[s..s + int(p_toks[i].len))

word_in = (w: str, words: str[]) -> bool:
    loop x in words:
        if x == w: return true
    false

# a mistake carried over from another language where parsing stopped at token i (wanting
# `want`, or .eof for an expression): says what Sloppy writes instead, and stops
habit = (i: int, want: Tok):
    k = p_toks[i].kind
    p = Tok.eof
    pw = ""
    if i > 0:
        p = p_toks[i - 1].kind
        if p == .ident: pw = tok_src(i - 1)
    glued = i > 0 and not space_before(i)
    at = cur_pos()
    if i > 0: at = p_toks[i - 1].pos
    if word_in(pw, ["def", "fn", "func", "function", "fun"]):
        name = "add"
        if k == .ident: name = tok_src(i)
        if len(struct_body) > 0: fatal(at, "structs have no methods (and there is no `{pw}`): write the function at the top level, not inside the struct, taking what it works on first, as `{name} = (p: mut {struct_body}): p.x += 1`; `p.{name}()` calls it")
        fatal(at, "a function is written `{name} = (a: int, b: int) -> int: ...` (there is no `{pw}`)")
    if pw == "local": fatal(at, "there is no `local`: `x = 5` in a function is the function's own (`let x = 5` always makes a new one)")
    if k == .tilde and nk_is(i, .assign): fatal(p_toks[i].pos, "use `!=`")
    if pw == "extends": fatal(at, "there is no inheritance: a struct can hold another as a field (`body: Body`), and functions take what they work on first (`e.hurt(5)` calls `hurt(e, 5)`)")
    if pw == "signal": fatal(at, "there are no signals: call a function when it happens, or keep the functions to call in an array (`on_died: (() -> void)[]`) and call each")
    if word_in(pw, ["class", "interface", "trait", "impl"]):
        fatal(at, "a type with fields is `struct Name:` and its fields below it; functions are written apart and called with a dot (`p.move(dt)` calls `move(p, dt)`)")
    if pw == "for" or pw == "foreach": fatal(at, "loops are `loop x in xs:` (and `loop i in [0..10):` counts from 0 to 9)")
    if pw == "new" and k == .ident:
        tn = tok_src(i)
        if word_in(tn, ["List", "ArrayList", "Array"]): fatal(at, "there is no `new`: an array is `xs: Enemy[]` (empty), or `[a, b]`")
        if word_in(tn, ["Dictionary", "HashMap", "Map"]): fatal(at, "there is no `new`: a map is `m: \{str: int}` (empty), or `\{\"a\": 1}`")
        if tn == "Color": fatal(at, "there is no `new`: a color is `rgb(1, 0, 0)` (each part from 0 to 1)")
        if word_in(tn, ["Vector2", "Vector3", "Vector4"]): fatal(at, "there is no `new`: `vec{tn[6..]}(...)`")
        if tn == "Promise": fatal(at, "there are no promises: something that takes time is a state changed a little in update each frame, or steps in `Actions` (`steps.then(0.3, (): drop())`)")
        fatal(at, "a value is made by calling its type: `{tn}(...)` (there is no `new`)")
    if pw == "switch": fatal(at, "use `match` (`match x:` and an arm for each case below it)")
    if pw == "yield" or pw == "await" or pw == "async": fatal(at, "there are no coroutines: keep a timer in a field and count it down each frame (`e.wait -= dt`, then act when it is below 0)")
    if pw == "while": fatal(at, "`loop condition:` repeats while the condition holds")
    if word_in(pw, ["elif", "elsif", "elseif"]): fatal(at, "use `else if`")
    if pw == "var" or pw == "val": fatal(at, "`x = 5` declares x (`let x = 5` always makes a new variable)")
    if pw == "lambda": fatal(at, "a function value is written `(x): x * 2`")
    if pw == "print" and (k == .str_lit or k == .ident or k == .int_lit): fatal(at, "print is a function: `print(...)`")
    if (pw == "f" or pw == "F") and k == .str_lit and glued: fatal(at, "strings put values in by themselves: \"n is {{n}}\" (no f before the quote)")
    if k == .kw_mut and p == .kw_let: fatal(p_toks[i].pos, "a `let` variable can change already: `let x = 5`")
    if k == .assign and p == .colon and glued: fatal(p_toks[i - 1].pos, "`x = 5` declares x (there is no `:=`)")
    if k == .assign and (p == .eq or p == .ne) and glued: fatal(p_toks[i - 1].pos, "use `{tok_src(i - 1)}` (there is no `{tok_src(i - 1)}=`: values of different types are never equal)")
    if k == .assign and i >= 2 and p_toks[i - 2].kind == .kw_loop: fatal(p_toks[i - 2].pos, "loops are `loop i in [0..n):` (i from 0 to n - 1), or `loop condition:` (while it holds)")
    if k == .assign and want == .colon and i >= 2 and p_toks[i - 2].kind == .kw_enum: fatal(p_toks[i].pos, "an enum is written with a colon: `enum {tok_src(i - 1)}: title, play, won`")
    if k == .assign and want == .colon: fatal(p_toks[i].pos, "compare with `==` (`=` assigns)")
    # (repeat 5:, Scratch's)
    if pw == "repeat" and (k == .int_lit or k == .ident): fatal(at, "to do something {tok_src(i)} times: `loop i in [1..{tok_src(i)}]:` and the lines below it")
    if k == .lbrace and want != .eof: fatal(p_toks[i].pos, "blocks are a `:` and the indented lines after it, not braces")
    if k == .ident and want != .eof and (tok_src(i) == "then" or tok_src(i) == "do"): fatal(p_toks[i].pos, "use `:` (as in `if x > 0: ...`)")
    if k == .question and nk_is(i, .dot): fatal(p_toks[i].pos, "there is no `?.`: `if let v = x: v.f` uses the value when there is one, `(x ?? default).f` a default otherwise")
    if k == .question and want != .eof: fatal(p_toks[i].pos, "a choice between two values is `if c: a else: b`")
    if k == .kw_if and (want == .newline or want == .rparen or want == .comma or want == .rbrack): fatal(p_toks[i].pos, "a choice between two values is `if c: a else: b` (the condition first)")
    if k == .colon and (p == .lbrack or want == .rbrack): fatal(p_toks[i].pos, "a slice is `xs[a..b)`, from a up to b (b left out): `xs[..2)` is the first two (`first(xs, 2)` when there may be fewer), `xs[1..]` all from 1 on")
    nk = Tok.eof
    if i + 1 < p_ntoks: nk = p_toks[i + 1].kind
    if k == .slash and p == .slash and glued and i > 1 and space_before(i - 1) and (p_toks[i - 2].kind == .ident or p_toks[i - 2].kind == .int_lit or p_toks[i - 2].kind == .rparen or p_toks[i - 2].kind == .rbrack):
        fatal(p_toks[i - 1].pos, "`/` on whole numbers already drops the fraction (7 / 2 is 3; `floor(x / y)` for floats); comments start with `#`")
    if k == .slash and (p == .slash and glued or nk == .slash or nk == .star): fatal(p_toks[i].pos, "comments start with `#`")
    if k == .bang: fatal(p_toks[i].pos, "use `not` (as in `if not done:`)")
    if k == .pipe and p == .pipe and glued: fatal(p_toks[i - 1].pos, "use `or`")
    if k == .amp and p == .amp and glued: fatal(p_toks[i - 1].pos, "use `and`")
    if (k == .plus and p == .plus or k == .minus and p == .minus) and glued:
        v = "x"
        if i > 1 and p_toks[i - 2].kind == .ident: v = tok_src(i - 2)
        fatal(p_toks[i - 1].pos, "use `{v} {tok_src(i)}= 1`")
    if k == .gt and p == .assign and glued: fatal(p_toks[i - 1].pos, "a function value is written `(x): x * 2`")
    if k == .starstar: fatal(p_toks[i].pos, "`x ^ y` is x to the power y")
    if k == .arrow and p == .ident and nk_is(i, .ident) and glued: fatal(p_toks[i].pos, "a field through a pointer is `q.x` (or `q[0].x`): there is no `->`")
    if k == .semi:
        # (for (i = 0; i < n; i++): C's loop)
        j = i - 1
        loop j > 0 and not nl_before(j): j -= 1
        if j >= 0 and p_toks[j].kind == .ident and (tok_src(j) == "for" or tok_src(j) == "while"): fatal(p_toks[j].pos, "loops are `loop i in [0..n):` (i from 0 to n - 1), or `loop condition:` (while it holds)")
    if k == .ellipsis and want == .eof: fatal(p_toks[i].pos, "an array is spread with `...` after it: `[xs... 4 5]`, `f(args...)`")
    if pw == "throw" or pw == "raise": fatal(at, "there are no exceptions: a function gives back what went wrong as a value (`-> Level | LoadError`), or `panic(\"...\")` stops the program")
    if word_in(pw, ["public", "private", "protected", "static", "override", "virtual"]): fatal(at, "there is no `{pw}`: every name can be used from other files (one starting with `_` stays in its own), and a variable or field is written `speed: f64 = 5.0`")
    if word_in(pw, ["export", "pub"]): fatal(at, "every top-level name can be imported already (`from 'file.jo' import name`); a name starting with `_` stays private to its file")
    # (C#'s and Java's `void Start()`, `float speed = 5`: the type before the name)
    if word_in(pw, ["void", "float", "double", "string", "int", "long", "char"]) and k == .ident:
        nm = tok_src(i)
        if nk_is(i, .lparen): fatal(at, "a function is written `{nm} = (): ...`, its type after it (`(x: f64) -> f64: ...`); the game calls `update` and `draw` by itself")
        st = "f64"
        if pw == "string": st = "str"
        else if pw == "int" or pw == "long": st = "int"
        else if pw == "char": st = "u8"
        if pw != "void": fatal(at, "a variable is written `{nm} = ...`, or with its type after the name: `{nm}: {st} = ...`")
    if pw == "delete" or pw == "del": fatal(at, "`xs.remove(i)` takes an element out of an array, `m.remove(k)` a key out of a map")
    if pw == "typeof" or (k == .ident and tok_src(i) == "instanceof"): fatal(at, "`x is T` asks which member of a union x holds (the other types are known when compiling)")
    value_start = k == .ident or k == .int_lit or k == .float_lit or k == .str_lit
    # (Python's statements that are functions or nothing here)
    if pw == "with" and value_start: fatal(at, "there is no `with`: `text = read_file(path)` (a `str?`: none when it cannot be read), `write_file(path, s)`, `append_file(path, s)`")
    if (pw == "global" or pw == "nonlocal") and k == .ident: fatal(at, "no `{pw}` is needed: a function that gives a top-level variable a value changes it (`let x = ...` makes one of its own)")
    if pw == "assert" and value_start: fatal(at, "assert is a function: `assert(x == 2, \"why\")`")
    if pw == "print" and value_start: fatal(at, "print is a function: `print(x)`")
    # (Scratch's blocks: set score to 0, change score by 1)
    if (pw == "set" or pw == "change") and k == .ident and i + 1 < p_ntoks and p_toks[i + 1].kind == .ident:
        nm = tok_src(i)
        fatal(at, "a variable gets a value with `=`: `{nm} = 0`; to change it by 1: `{nm} += 1`")
    if pw == "until" and i >= 2 and p_toks[i - 2].kind == .kw_loop: fatal(at, "there is no `until`: a loop repeats while something holds: `loop x <= 10:` (or `loop not (x > 10):`)")
    if want == .newline and p == .ident and value_start and not glued: fatal(at, "to call '{pw}', write `{pw}({tok_src(i)})`")
    # ("she said "hi"": the second " ended the text)
    if p == .str_lit and k == .ident and glued and i + 1 < p_ntoks and p_toks[i + 1].kind == .str_lit and not space_before(i + 1):
        fatal(p_toks[i].pos, "the `\"` before this ends the text: to put a `\"` inside text, write `\\\"`")
    if want == .rparen and k == .ident and tok_src(i) == "for": fatal(p_toks[i].pos, "an array made by a loop is `[loop x in xs: x * x]` (and `sum([loop x in xs: x * x])`; there are no generators)")
    if want == .rparen and k == .ident and p == .ident and not glued: fatal(p_toks[i].pos, "two names in a row: text goes in quotes (`\"{tok_src(i - 1)} {tok_src(i)}\"`), and values are separated with `,`")
    if want == .rparen and value_start and (p == .ident or p == .int_lit or p == .float_lit or p == .str_lit or p == .rparen or p == .rbrack):
        fatal(p_toks[i].pos, "a ',' is missing before this")

expect = (k: Tok, what: str) -> int:
    if p_toks[ti].kind != k:
        habit(ti, k)
        w = what
        if len(w) == 0: w = tok_name(k)
        tk = p_toks[ti].kind
        if tk == .newline or tk == .indent or tk == .dedent or tk == .eof: fatal(prev_end(), "expected {w} at the end of this line")
        if tk == .ident or tk == .int_lit: fatal(cur_pos(), "expected {w}, found '{tok_src(ti)}'")
        fatal(cur_pos(), "expected {w}, found {tok_name(tk)}")
    advance()
# identifier tokens carry their interned name in ival
expect_ident = (what: str) -> int:
    if p_toks[ti].kind != .ident and is_keyword_tok(p_toks[ti].kind) and p_toks[ti].kind != .kw_mut: keyword_name_error(ti)
    # (let [a, b] = pair, const {kind, x} = g: JavaScript's destructuring)
    if p_toks[ti].kind == .lbrack and (what == "variable name" or what == "constant name"): fatal(p_toks[ti].pos, "an array is unpacked without brackets: `a, b = xs` (it must have exactly that many elements); a tuple the same way")
    if p_toks[ti].kind == .lbrace and (what == "variable name" or what == "constant name"): fatal(p_toks[ti].pos, "a struct's fields are read one by one: `kind, x = g.kind, g.x`, or used as they are, `g.kind`")
    int(p_toks[expect(.ident, what)].ival)

is_keyword_tok = (k: Tok) -> bool: int(k) < kw_kinds.len() and kw_kinds[int(k)]

# (also `none`, after a dot or as an enum variant: E.none, .none)
expect_name = (what: str) -> int:
    if is_soft_kw(pk()) or pk() == .kw_none: return intern(tok_src(advance()))
    expect_ident(what)

# ---------------- strings ----------------
decode_str = (s: str, pos: int, raw: bool) -> str:
    if raw: return s
    if find_byte(s, '\\') < 0 and find(s, "\{\{") < 0 and find(s, "}}") < 0: return s
    buf: u8[]
    n = len(s)
    i = 0
    loop i < n:
        c = s[i]
        if c == '\\':
            i += 1
            e = s[i]
            if e == 'n': buf.push(10)
            else if e == 't': buf.push(9)
            else if e == 'r': buf.push(13)
            else if e == '0': buf.push(0)
            else if e == '\\': buf.push('\\')
            else if e == '"': buf.push('"')
            else if e == '\'': buf.push('\'')
            else if e == '{{': buf.push('{{')
            else if e == '}}': buf.push('}}')
            else if e == 'e': buf.push(27)
            else if e == 'x':
                if i + 2 >= n: fatal(pos, "bad \\x escape")
                h = hexval(s[i + 1])
                l = hexval(s[i + 2])
                if h < 0 or l < 0: fatal(pos, "bad \\x escape")
                buf.push(u8(h * 16 + l))
                i += 2
            else if e == '\n':
                loop i + 1 < n and (s[i + 1] == ' ' or s[i + 1] == '\t'): i += 1
            else:
                why = ""
                if e == 'd' or e == 'w' or e == 's' or e == 'b' or e == 'D' or e == 'W' or e == 'S' or e == '.': why = " (for a regular expression, a raw string keeps the backslash: r\"\\d+\")"
                fatal(pos, "unknown escape \\{byte_str(int(e))}{why}")
        else if (c == '{{' or c == '}}') and i + 1 < n and s[i + 1] == c:
            buf.push(c)
            i += 1
        else: buf.push(c)
        i += 1
    str_from_bytes(buf)

dedent_triple = (s0: str) -> str:
    s = s0
    if len(s) > 0 and s[0] == '\n': s = s[1..]
    else if len(s) > 1 and s[0] == '\r' and s[1] == '\n': s = s[2..]
    e = len(s)
    loop e > 0 and (s[e - 1] == ' ' or s[e - 1] == '\t'): e -= 1
    if e > 0 and s[e - 1] == '\n': s = s[..e - 1)
    common = -1
    loop line in split(s, "\n"):
        ind = 0
        loop ind < len(line) and (line[ind] == ' ' or line[ind] == '\t'): ind += 1
        if ind < len(line):
            if common < 0 or ind < common: common = ind
    if common <= 0: return s
    out: str[]
    loop line in split(s, "\n"):
        k = 0
        loop k < common and k < len(line) and (line[k] == ' ' or line[k] == '\t'): k += 1
        out.push(line[k..])
    join(out, "\n")

# (a name: letters, digits and _, not starting with a digit)
is_ident_plain = (s: str) -> bool:
    if len(s) == 0 or (s[0] >= '0' and s[0] <= '9'): return false
    loop c in s:
        if not (is_alnum(c) or c == '_'): return false
    true

# one character (one UTF-8 sequence): such a literal can stand for its character code
__utf8_len1 = (t: str) -> bool:
    n = len(t)
    if n == 1: return true
    if n == 0: return false
    b = int(t[0])
    (b >= 0xc0 and b < 0xe0 and n == 2) or (b >= 0xe0 and b < 0xf0 and n == 3) or (b >= 0xf0 and n == 4)

parse_string_token = (t: int) -> int:
    pos = p_toks[t].pos
    s = tok_src(t)
    flags = int(p_toks[t].flags)
    raw = flags & STRF_RAW != 0
    if flags & STRF_TRIPLE != 0: s = dedent_triple(s)
    n = mk(.str_lit, pos)
    n_len = len(s)
    i = 0
    lit_start = 0
    has_interp = false
    parts: int[]
    loop i < n_len and not raw:
        c = s[i]
        if c == '\\':
            i += 2
            continue
        if c == '{{' and i + 1 < n_len and s[i + 1] == '{{':
            i += 2
            continue
        if c == '}}' and i + 1 < n_len and s[i + 1] == '}}':
            i += 2
            continue
        if c == '{{' and n_len == 1 and flags & STRF_TRIPLE == 0: break       # ('{': a brace alone)
        if c == '{{':
            has_interp = true
            if i > lit_start:
                lit = mk(.str_lit, pos)
                nodes[lit].sval = i32(intern(decode_str(s[lit_start..i), pos, raw)))
                parts.push(lit)
            depth = 1
            parens = 0             # ( and [ nesting: a ':' inside them is not a format spec
            j = i + 1
            colon = -1
            loop j < n_len and depth > 0:
                cj = s[j]
                if cj == '{{': depth += 1
                else if cj == '}}':
                    depth -= 1
                    if depth == 0: break
                else if cj == '(' or cj == '[': parens += 1
                else if cj == ')' or cj == ']': parens -= 1
                else if cj == '"':
                    j += 1
                    loop j < n_len and s[j] != '"':
                        if s[j] == '\\': j += 1
                        j += 1
                else if cj == ':' and depth == 1 and parens == 0 and colon < 0 and not (j + 1 < n_len and s[j + 1] == '=') and not starts_with(trim_start(s[i + 1..j)), "if "): colon = j
                j += 1
            eend = j
            if colon >= 0: eend = colon
            expr_src = s[i + 1..eend)
            # (C, GLSL or CSS in a string, "void main() { x = 1; }": braces of the text)
            if find(s[i + 1..j), ";") >= 0 and find(s[i + 1..j), "\"") < 0: fatal(pos, "`{{` in a string puts in a value, and this text is not one: for braces in the text, write {{{{ and }}}}, or make it a raw string, r\"...\" (a shader's or a page's code)")
            # ({n == 1 ? "" : "s"}: C's choice, as outside a string)
            if find(expr_src, " ? ") > 0: fatal(pos, "a choice between two values is `if c: a else: b`, as \"{{if n == 1: \"\" else: \"s\"}}\"")
            # ({x=}: the text "x=" and then x's value, as Python's f-strings)
            shown = ""
            te = trim_end(expr_src)
            if len(te) >= 2 and te[len(te) - 1] == '=' and not __has_byte("=!<>", te[len(te) - 2]):
                shown = expr_src
                expr_src = te[..len(te) - 1)
            if len(trim(expr_src)) == 0:
                if colon >= 0: fatal(pos, "the value goes inside the braces, with its format after a colon: \"{{x:.2f}}\" (there is no .format)")
                fatal(pos, "'{{' in a string starts an interpolation like \"{{x}}\"; write {{{{ and }}}} for literal braces")
            # lex and parse the embedded expression; its tokens keep their places in the file
            saved_toks = toks
            saved_p_toks = p_toks
            saved_p_ntoks = p_ntoks
            saved_ti = ti
            saved_src = p_src
            saved_file = p_file
            saved_base = p_base
            # ({/i}, {color=#ff0}: tags as Ren'Py's, not values; the text needs its braces doubled)
            es = trim(expr_src)
            eq = find(es, "=")
            if len(es) > 0 and (es[0] == '/' or (eq > 0 and eq + 1 < len(es) and es[eq + 1] != '=' and es[eq - 1] != '!' and es[eq - 1] != '<' and es[eq - 1] != '>' and es[eq - 1] != '=' and is_ident_plain(es[..eq)))):
                fatal(pos, "`{{{es}}}` in a string puts in the value of what is inside the braces, and this is not one; for the braces in the text (a tag, as Ren'Py's), write `{{{{{es}}}}}`, or make it a raw string, r\"...\"")
            # (a string inside an interpolation: its tokens' starts are within that one's source;
            # spaces before the value are not an indented line)
            ws = len(expr_src) - len(trim_start(expr_src))
            expr_src = expr_src[ws..]
            p_base = p_base + int(p_toks[t].start) + i + 1 + ws
            lx_base = p_base
            toks = lex(p_file, expr_src)
            p_toks = data(toks)
            p_ntoks = toks.len()
            lx_base = 0
            ti = 0
            p_src = expr_src
            e = parse_expr()
            skip_newlines()
            if pk() != .eof:
                if find(expr_src, "!r") > 0 or find(expr_src, "!s") > 0: fatal(pos, "there are no conversions: \"{{x}}\" shows x, and \"{{x=}}\" its name too")
                if find(expr_src, " if ") > 0 and find(expr_src, " else ") > 0: fatal(pos, "a choice is written `if c: a else: b`, as \"{{if done: \"yes\" else: \"no\"}}\"")
                fatal(pos, "invalid expression in string interpolation (a `{{` in a string starts one; for a brace in the text, write {{{{ or }}}})")
            if nodes[e].kind == .str_lit and nodes[e].nlist == 0 and colon >= 0 and colon + 1 < j and s[colon + 1] == ' ' and not (colon + 2 < j and (s[colon + 2] == '<' or s[colon + 2] == '>' or s[colon + 2] == '^')):
                # ('{"a": 1}' is the text "a", formatted " 1")
                fatal(pos, "`{{{trim(s[i + 1..j))}}}` in a string puts in the value of what is inside the braces; for braces in the text, write {{{{ and }}}}, or make it a raw string, r'...' (JSON: r'{{\"a\": 1}}', or to_json(value))")
            toks = saved_toks
            p_toks = saved_p_toks
            p_ntoks = saved_p_ntoks
            ti = saved_ti
            p_src = saved_src
            p_file = saved_file
            p_base = saved_base
            if len(shown) > 0:
                lit = mk(.str_lit, pos)
                nodes[lit].sval = i32(intern(shown))
                parts.push(lit)
            part = mk(.pair, pos)
            nodes[part].a = i32(e)
            if colon >= 0:
                bad = literal_spec_problem(s[colon + 1..j))
                if len(bad) > 0: fatal(pos, "`{{{trim(s[i + 1..j))}}}`: {bad} (a format is [[fill]align][+][#][0][width][,][.precision][type], as {{x:>8.2f}}; types f e E g G % (numbers), d x X b o (whole numbers), s (text))")
                nodes[part].sval = i32(intern(s[colon + 1..j)))
            else: nodes[part].sval = -1
            parts.push(part)
            i = j + 1
            lit_start = i
            continue
        i += 1
    if not has_interp:
        txt = decode_str(s, pos, raw)
        nodes[n].sval = i32(intern(txt))
        if __utf8_len1(txt):
            add_flag(n, NF_CHARLIKE)
            if flags & STRF_SINGLE != 0: add_flag(n, NF_SQUOTE)
        return n
    if lit_start < n_len:
        lit = mk(.str_lit, pos)
        nodes[lit].sval = i32(intern(decode_str(s[lit_start..], pos, raw)))
        parts.push(lit)
    nodes[n].aux = 1
    set_list(n, parts)
    n

# ---------------- expressions ----------------
p_header = false      # parsing an if/loop/match header: `(x): ...` is not a function there
# (inside a call's parentheses `(x): ...` is a function again, in an if or loop header too:
# `if xs.any((x): x > 2): ...`)
# names the parser recognizes (interned once)
id_void = 0
id_cfn = 0
id_end = 0
id_type = 0
id_soa = 0
id_from = 0

# parser modes
p_matrix = 0          # > 0 inside array brackets: a space separates elements
p_index: int[]         # the arrays being indexed (for `end`)

p_id_async = 0
p_id_await = 0


binprec_value = (k: Tok) -> int:
    match k:
        star, slash, percent: 10
        plus, minus: 9
        shl, shr: 8
        amp: 7
        pipe: 5
        dotdot: 4
        qq: 3
        eq, ne, lt, le, gt, ge, kw_in, kw_is: 2
        _: -1

# Operator precedence is immutable and indexed by the token enum. Build only
# when expression parsing first needs it, instead of dispatching a match per term.
p_binprec: *i8 = null
binprec = (k: Tok) -> int:
    if p_binprec == null:
        p_binprec = __alloc(int(Tok.lazy) + 1) as *i8
        loop i in [0..int(Tok.lazy) + 1): p_binprec[i] = i8(binprec_value(i as Tok))
    int(p_binprec[int(k)])

# (the comprehensions parsed so far: each names its accumulator __comp<n>)
comp_count = 0

comp_ident = (name: int, pos: int) -> int:
    n = mk(.ident, pos)
    nodes[n].name = i32(name)
    n

# ---- loops with combined iterators, rewritten into plain loops ----
# (called once the body is parsed)
lx_count = 0

lx_ident = (name: str, pos: int) -> int:
    n = mk(.ident, pos)
    nodes[n].name = i32(intern(name))
    n

lx_int = (v: int, pos: int) -> int:
    n = mk(.int_lit, pos)
    nodes[n].ival = v
    add_flag(n, NF_LITERAL)
    n

lx_bool = (value: bool, pos: int) -> int:
    n = mk(.bool_lit, pos)
    nodes[n].ival = if value: 1 else: 0
    n

lx_bin = (op: Tok, a: int, b: int, pos: int) -> int:
    n = mk(.binary, pos)
    nodes[n].op = i32(int(op))
    nodes[n].a = i32(a)
    nodes[n].b = i32(b)
    n

lx_let = (name: int, v: int, pos: int) -> int:
    d = mk(.vardecl, pos)
    nodes[d].name = i32(name)
    nodes[d].b = i32(v)
    add_flag(d, NF_LOOPCOUNT)
    d

lx_assign = (target: int, op: Tok, v: int, pos: int) -> int:
    a = mk(.assign, pos)
    nodes[a].op = i32(int(op))
    nodes[a].a = i32(target)
    nodes[a].b = i32(v)
    a

lx_block = (stmts: int[], pos: int) -> int:
    b = mk(.block, pos)
    set_list(b, stmts)
    b

lx_if = (c: int, then: int, pos: int) -> int:
    n = mk(.if_, pos)
    nodes[n].a = i32(c)
    nodes[n].b = i32(lx_block([then], pos))
    add_flag(n, NF_STMT)
    n

lx_not = (c: int, pos: int) -> int:
    n = mk(.not_, pos)
    nodes[n].a = i32(c)
    n

lx_call = (name: str, args: int[], pos: int) -> int:
    c = mk(.call, pos)
    nodes[c].a = i32(lx_ident(name, pos))
    set_list(c, args)
    c

lx_len = (seq: int, pos: int) -> int:
    lx_call("len", [seq], pos)

lx_index = (seq: int, k: int, pos: int) -> int:
    ix = mk(.index, pos)
    nodes[ix].a = i32(seq)
    nodes[ix].b = i32(k)
    ix

lx_bcount = 0

lx_expr_stmt = (e: int, pos: int) -> int:
    s = mk(.exprstmt, pos)
    nodes[s].a = i32(e)
    s

head_node = (op: int, pos: int) -> int:
    n = mk(.lhead, pos)
    nodes[n].op = i32(op)
    n

# two plain conditions joined by and/or are one condition
head_collapse = (n: int) -> int:
    a = int(nodes[n].a)
    b = int(nodes[n].b)
    if nodes[a].op != 4 or nodes[b].op != 4: return n
    k = NK.and_
    if nodes[n].op == 3: k = .or_
    e = mk(k, nodes[n].pos)
    nodes[e].a = nodes[a].a
    nodes[e].b = nodes[b].a
    c = head_node(4, nodes[n].pos)
    nodes[c].a = i32(e)
    c

struct_body = ""                # (the struct whose fields are being parsed)
# profiling aid: DEWY_STOP=lex or DEWY_STOP=parse makes `dewy check` stop after that phase
stop_after = ""

parse_file = (file: int) -> int[]:
    if id_void == 0:
        id_void = intern("void")
        id_cfn = intern("cfn")
        id_end = intern("end")
        id_type = intern("type")
        id_soa = intern("soa")
        id_from = intern("from")
    lx_lazy = p_lazy
    toks = lex(file, files[file].src)
    p_toks = data(toks)
    p_ntoks = toks.len()
    lx_lazy = false
    if stop_after == "lex":
        toks = []
        p_toks = data(toks)
        p_ntoks = toks.len()
        return []
    ti = 0
    p_file = file
    p_src = files[file].src
    decls: int[]
    skip_newlines()
    loop pk() != .eof:
        d = parse_toplevel()
        if d != 0: decls.push(d)
        skip_newlines()
    toks = []
    p_toks = data(toks)
    p_ntoks = toks.len()
    decls

# The top-level declarations in src[start..end) of file (a unit of compiler/scan.jo's index: it
# starts a line that is not indented), function bodies left for later as in a library file
parse_span = (file: int, start: int, end: int) -> int[]:
    if id_void == 0:
        id_void = intern("void")
        id_cfn = intern("cfn")
        id_end = intern("end")
        id_type = intern("type")
        id_soa = intern("soa")
        id_from = intern("from")
    saved_toks = toks
    saved_p_toks = p_toks
    saved_p_ntoks = p_ntoks
    saved_ti = ti
    saved_file = p_file
    saved_src = p_src
    saved_base = p_base
    saved_nt = p_no_tuple
    saved_m = p_matrix
    saved_h = p_header
    saved_lazy = p_lazy
    saved_top = p_top_decl
    p_file = file
    p_src = files[file].src
    lx_lazy = true
    toks = lex(file, p_src, start, end)
    p_toks = data(toks)
    p_ntoks = toks.len()
    lx_lazy = false
    ti = 0
    p_base = 0
    p_no_tuple = false
    p_matrix = 0
    p_header = false
    p_lazy = true
    p_top_decl = false
    decls: int[]
    skip_newlines()
    loop pk() != .eof:
        d = parse_toplevel()
        if d != 0: decls.push(d)
        skip_newlines()
    toks = saved_toks
    p_toks = saved_p_toks
    p_ntoks = saved_p_ntoks
    ti = saved_ti
    p_file = saved_file
    p_src = saved_src
    p_base = saved_base
    p_no_tuple = saved_nt
    p_matrix = saved_m
    p_header = saved_h
    p_lazy = saved_lazy
    p_top_decl = saved_top
    decls

# the body of function declaration d, parsed now if it was left for later
ensure_body = (d: int):
    b = int(nodes[d].b)
    if b == 0 or not has_flag(b, NF_LAZY): return
    saved_toks = toks
    saved_p_toks = p_toks
    saved_p_ntoks = p_ntoks
    saved_ti = ti
    saved_file = p_file
    saved_src = p_src
    saved_base = p_base
    saved_nt = p_no_tuple
    saved_m = p_matrix
    saved_h = p_header
    saved_lazy = p_lazy
    saved_top = p_top_decl
    # (the body's lines alone, lexed where they are in the file: the indented block)
    p_file = pos_file(nodes[d].pos)
    start = int(nodes[b].ival)
    p_src = files[p_file].src
    if pl_on:
        pl_reached.push(p_file)
        pl_reached.push(start)
        pl_reached.push(start + int(nodes[b].aux))
    toks = lex(p_file, p_src, start, start + int(nodes[b].aux))
    p_toks = data(toks)
    p_ntoks = toks.len()
    ti = 0
    p_base = 0
    p_no_tuple = false
    p_matrix = 0
    p_header = false
    p_lazy = false
    p_top_decl = false
    body = parse_indented_block(mk(.block, cur_pos()))
    nodes[d].b = i32(body)
    toks = saved_toks
    p_toks = saved_p_toks
    p_ntoks = saved_p_ntoks
    ti = saved_ti
    p_file = saved_file
    p_src = saved_src
    p_base = saved_base
    p_no_tuple = saved_nt
    p_matrix = saved_m
    p_header = saved_h
    p_lazy = saved_lazy
    p_top_decl = saved_top

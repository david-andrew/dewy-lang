$runtime_checks

# Direct reader entry points and lazy token expansion.
from p"@lib/core/str.jo" import (starts_with)
from p"ast.jo" import (kids lists nodes set_list)
from p"check.jo" import (check_all target_arm64 target_macos target_wasm target_windows test_mode watch_build)
from p"dewy_context.jo" import (dc_parser)
from p"dewy_direct.jo" import (DC_LAZY_BODY)
from p"dewy_fast.jo" import (DN_EOF_SPARE dn_block_comments)
from p"dewy_frontend.dewy" import (dn_lex)
from p"dewy_fast_file.dewy" import (dn_edits_clear)
from p"dewy_reader.dewy" import (rd_dc_body rd_dc_flush_report rd_dc_report rd_dc_unread)
from p"directive_rules.dewy" import (dir_apply_rows)
from p"driver_pipeline.dewy" import (queue_emit)
from p"icount.jo" import (IC_LOAD)
from p"icount_ops.dewy" import (ic_mod ic_restore)
from p"ide.jo" import (ide_on)
from p"ir.jo" import (dbg_on)
from p"lazy_bodies.jo" import (DC_LAZY_SPAN dc_eager)
from p"lower.jo" import (opt_release)
from p"main.jo" import (host_ir lower_only repl_image)
from p"worker_entries.dewy" import (emit_workers)
from p"parser_loops.dewy" import (desugar_loopx)
from p"parse.jo" import (stop_after)
from p"prelude.jo" import (prelude_lazy)
from p"util.jo" import (errors_only files lib_root pos_file shown_warnings)
from p"x64_allocate.dewy" import (ra_dump)
from p"x64_emit.dewy" import (ra_stat)

DirectWord:type=int64<overflow='wrap'>

dc_report=(pos:int64 msg:string):>void=>{
    rd_dc_report(@dc_parser pos msg)
}

dc_flush_report=():>void=>{
    rd_dc_flush_report(@dc_parser)
}

dc_unread=(at:int64):>void=>{
    rd_dc_unread(@dc_parser at)
}

dc_lib_lazy_allowed=(file:int64):>bool=>$unsafe {
    prelude_lazy and (lib_root as array<uint8>).length >? 0 and starts_with(files.ptr[file].path lib_root)
}

dc_lazy_allowed=(file:int64):>bool=>$unsafe {
    if $target.os not=? 'linux' or $target.arch not=? 'x86_64' {
        return false
    } else {
        if dc_eager or emit_workers() <? 2 or shown_warnings.length >? 0 {return false}
        if (files.ptr[file].src as array<uint8>).length <? 100000 and env("DEWY_EMIT_FORCE") =? none {return false}
        if (env("DEWY_PCHECK") ?? "") =? "0" or (env("DEWY_FUSED") ?? "") =? "0" {return false}
        if target_wasm or target_arm64 or target_windows or target_macos or opt_release or dbg_on or watch_build or repl_image or lower_only or host_ir or ra_stat or (ra_dump as array<uint8>).length >? 0 or not queue_emit or ide_on or errors_only or test_mode or check_all or (stop_after as array<uint8>).length >? 0 {return false}
        true
    }
}

dn_expand_lazy=():>void=>$unsafe {
    if not dc_parser.reader.dn_lazy_left {return}
    let k:int64=dc_parser.at
    loop k <? dc_parser.tokens.length and dc_parser.tokens.ptr[k].kind not=? 'lazy_body' {k+=1}
    if k =? dc_parser.tokens.length {
        dc_parser.reader.dn_lazy_left=false
        return
    }
    let out=dc_parser.tokens[..k)
    let saved_comments=dn_block_comments
    loop k <? dc_parser.tokens.length {
        let t=dc_parser.tokens.ptr[k]
        k+=1
        if t.kind not=? 'lazy_body' {
            out.push(t)
            continue
        }
        let inner=dn_lex(dc_parser.file t.start t.stop true)
        loop j in [0..inner.length - 1 - DN_EOF_SPARE) {
            let x=inner.ptr[j]
            if j =? 0 {
                x.space=t.space
                x.newline=t.newline
            }
            out.push(x)
        }
        if k >=? dc_parser.tokens.length or dc_parser.tokens.ptr[k].newline {break}
    }
    out.extend(dc_parser.tokens[k..dc_parser.tokens.length))
    dn_block_comments=saved_comments
    dc_parser.tokens=out
}

dc_force_body=(d:int64):>void=>$unsafe {
    let b=int64(nodes.ptr[d].b)
    if b =? 0 or (nodes.ptr[b].aux2 not=? DC_LAZY_BODY and nodes.ptr[b].aux2 not=? DC_LAZY_SPAN) {return}
    let icl=ic_mod(IC_LOAD int64(nodes.ptr[d].mod))
    let saved_tokens=dc_parser.tokens
    let saved_at=dc_parser.at
    let saved_file=dc_parser.file
    let saved_source=dc_parser.source
    let saved_depth=dc_parser.depth
    let saved_lib=dc_parser.reader.dc_lib_lazy
    let saved_left=dc_parser.reader.dn_lazy_left
    let saved_edits_on=dc_parser.reader.dn_edits_on
    let edits=dc_parser.reader.dn_edit_at.length
    dc_parser.reader.dn_edits_on=true
    dc_parser.reader.dc_lib_lazy=false
    dc_parser.reader.dn_lazy_left=false
    dc_parser.file=pos_file(nodes.ptr[d].pos)
    dc_parser.source=files.ptr[dc_parser.file].src
    let first=int64(nodes.ptr[b].ival)
    if nodes.ptr[b].aux2 =? DC_LAZY_SPAN {
        let saved_comments=dn_block_comments
        dc_parser.tokens=dn_lex(dc_parser.file first dc_parser.reader.dc_lazy_span_end[b] true)
        dn_block_comments=saved_comments
        first=0
    } else {
        dc_parser.tokens=dc_parser.reader.dc_lazy_tokens[dc_parser.file]
    }
    dc_parser.at=first
    dc_parser.depth=2
    let node_start:DirectWord=nodes.length
    let list_start=lists.length
    let saved_in_body=dc_parser.flags.fn_body
    dc_parser.flags.fn_body=true
    let saved_result=dc_parser.reader.dc_fn_result
    dc_parser.reader.dc_fn_result=-1
    let reports=dc_parser.status.reports
    let saved_now=dc_parser.flags.report_now
    dc_parser.flags.report_now=true
    dc_parser.status.hint_pos=0
    let body=dc_body()
    if body =? 0 {dc_unread(first)}
    dc_parser.flags.report_now=saved_now
    dc_parser.reader.dc_fn_result=saved_result
    dc_parser.flags.fn_body=saved_in_body
    if dc_parser.status.reports not=? reports {dc_flush_report()}
    let i:DirectWord=nodes.length - 1
    loop i >=? node_start {
        if nodes.ptr[i].kind =? 'loopx' {
            let lowered=desugar_loopx(i)
            nodes[i]=nodes.ptr[lowered]
        }
        i-=1
    }
    dir_apply_rows(node_start)
    let prefix=kids(b)
    loop st in kids(body) {prefix.push(st)}
    set_list(body prefix)
    nodes[b]=nodes.ptr[body]
    dc_parser.tokens=saved_tokens
    dc_parser.at=saved_at
    dc_parser.file=saved_file
    dc_parser.source=saved_source
    dc_parser.depth=saved_depth
    dc_parser.reader.dc_lib_lazy=saved_lib
    dc_parser.reader.dn_lazy_left=saved_left
    dn_edits_clear(edits)
    dc_parser.reader.dn_edits_on=saved_edits_on
    ic_restore(icl)
}

dc_body=():>int64=>rd_dc_body(@dc_parser @nodes)

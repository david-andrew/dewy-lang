# Packages: other people's Sloppy code, by git URL (or a directory), named in the build block:
#
#   build:
#       physics = package("https://github.com/ann/dewy-physics")
#       tween = package("https://github.com/bob/tween", "v1.2")      # a tag, a branch or a commit
#       shared = package("../shared")                                # a directory
#
# `import physics` loads the package's main file (the file at its root with the package's name,
# or its only file there), `import 'physics/world.jo'` any other. A git package is pinned to a
# commit in dewy.lock beside the program (the first build writes it: commit it with the
# program, and every build after uses the same code) and fetched once, with git, into a cache
# (pkg_cache). The packages a package names in its own build block come along.

use 'util.jo'
use 'module_paths.dewy'
use 'lex.jo'
use 'manifest.dewy'

pkg_specs: PkgSpec[]
pkg_dirs: {str: str} = {}       # package name -> its directory
pkg_errs: {str: str} = {}       # package name -> why it has no directory
pkg_fetch = false               # (dewy build, run, test, watch: fetch what is missing; the language server does not)







# the commit ref names at url (ref "": the default branch), or "" (with the reason in pkg_why)
pkg_why = ""

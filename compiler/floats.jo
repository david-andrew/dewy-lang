use 'lower_storage.dewy'
use 'lower_helpers.dewy'
use 'checker_program.dewy'
use 'checker_state.dewy'
use 'checker_tokens.dewy'
use 'refinement_types.dewy'
# IEEE 754 float policy (docs/design/decisions.md, 
#
# Strict IEEE is the default and costs nothing here: NaN, infinities, signed
# zero and subnormals are values, and nothing reassociates or contracts float
# arithmetic. What this file adds:
# - float-to-integer conversions keep the value: NaN and out-of-range values
#   fail (a Dewy conversion never saturates), an obligation (no traps): proven
#   by the interval analysis below, else a compile error or a check of the
#   scope's policy, one that makes its function panic;
# - `$no_nan` and `$no_inf` (and the `$finite_floats` bundle): inside their
#   scope, an operation that could create a NaN (IEEE 
#   infinity (IEEE 
#   neither is an obligation, proven by a small interval analysis or deferred
#   to a runtime check by the scope's policy (`dir_defer`).
# The analysis runs only over the functions whose bodies lie in such a scope:
# a program that writes neither setting never reaches it.
use 'util.jo'
use 'lex.jo'
use 'ast.jo'
use 'types.jo'
use 'expr.jo'
use 'check.jo'
use 'ir.jo'
use 'lower.jo'
use 'directives.jo'
use 'isolation.jo'
use 'units.jo'
use 'facts.jo'
use 'refine.jo'
use 'effects.jo'
use 'lower_primitives.dewy'
use 'ir_builders.dewy'
use 'panic_inventory.dewy'
use 'isolation_ops.dewy'

# ---------------- float-to-integer conversions ----------------



# ---------------- float dictionary keys and set elements ----------------
#
# A dictionary key or set element is never NaN, nor a record or tuple holding
# one in a field: NaN equals nothing, so its entry could never be found again.
# Each key or element a Dewy call hands a dictionary or set is an obligation
# (set(values) and set literals: each element), proven for a non-NaN literal,
# a converted integer, a record or tuple built from such, and anything under
# `$no_nan`; otherwise the scope's policy (`dir_defer`) checks it at run time
# or rejects it. A record with its own `__eq__` decides its own equality.
# Cost: O(1) per dictionary or set call while checking (O(fields) for a record
# type, once per type).

const FK_KEY = 1      # a dictionary key
const FK_ELEMENT = 2  # a set element
const FK_EACH = 4     # each element of an array (set(values))

float_keys: {int: int} = {}  # key node -> what lowering checks holds no NaN (FK_*)
float_keys_any = false
key_float_types: {int: bool} = {}










# ---------------- `$no_nan` and `$no_inf` ----------------
#
# Inside the scope, floats are free of NaN (`$no_nan`) or infinities
# (`$no_inf`). Each operation in it that could produce one from operands that
# are neither is an obligation:
#   NaN (IEEE invalid): inf - inf, 0 * inf, 0/0, inf/inf, sqrt or log of a
#     negative number, sin/cos/tan of an infinity, asin/acos beyond [-1, 1], pow;
#   infinity (IEEE overflow, division by zero): a sum, difference, product or
#     quotient beyond the largest float, x/0, log(0), exp, pow, a float64
#     narrowed to float32 or a large `int` converted.
# Values entering either scope are not assumed to obey it:
#   - a parameter of a function whose body is in the scope is proven by each
#     direct caller, an obligation at the argument under the caller's policy
#     (the callers are walked too, outside the scope, only for that); a
#     lambda's, or a function's used as a value, enters like the rest;
#   - a field, element, global, captured variable, loop variable, or the result
#     of a call outside the scope may be NaN: where such a value is used (an
#     operand of arithmetic or a math function, a returned value, a reassigned
#     local, a dictionary key or set element, an argument for the scope's
#     function) it is an obligation, proven by a guard on a local (`if x =? x`,
#     `if 0.0 <=? x`: any comparison that holds) or checked where the policy
#     defers it. A `let` may hold one until it is used.
# The proof is a forward interval analysis over the function body, one pass:
# exact float bounds (rounding is monotone, so an operation on interval ends
# bounds its rounded results), guards on unaliased locals refine them in their
# branch, and a loop forgets the locals it assigns. An unproven obligation goes
# to `dir_defer` like every other: a runtime check of the result where the
# scope's policy defers it, else a compile error. Cost: O(nodes) of the
# functions in these scopes, plus O(scopes) per operation for the policy
# lookup; nothing at all without the settings (`dir_floats_any`).

const FF_NAN = 1
const FF_INF = 2
const FF_ENTER = 4  # (a check that a value entering `$no_nan` is not NaN)
const FF_ENTER_INF = 8 # (a check that a value entering `$no_inf` is finite)
const FF_MAX = 1.7976931348623157e308

struct FR:
    lo: f64
    hi: f64
    nan: bool = false   # may be NaN: a value entering `$no_nan` not proven yet

ff_checks: {int: int} = {}      # node -> the result checks lowering adds (FF_NAN | FF_INF)
ff_checks_any = false
ff_int_proven: {int: bool} = {} # float-to-integer conversion node -> its value is proven in range
ff_integer_bounds: {int: FR} = {} # integer-conversion node -> range captured by facts
ff_env: {int: FR} = {}          # tracked local -> its bounds here
ff_files: {int: bool} = {}      # files holding a float scope
ff_owners: {int: bool} = {}     # functions a float scope is written in
ff_assume = 0                   # the settings at the function body: what entering values obey
ff_callers: {int: bool} = {}    # functions calling a function whose body has a float policy
ff_direct: {int: int} = {}      # declaration -> its body's float policy plus one
ff_indirect: {int: bool} = {}   # declarations used as values: their parameters enter
ff_keys: {int: int} = {}        # dictionary key or set element under `$no_nan` -> what (FK_*)
ff_conversions: {int: bool} = {} # functions converting a float to an integer (expr.jo)
ff_fn = 0                       # the function being walked
ff_probing = false              # effects ask which conversions a body proves: nothing is reported
ff_probe: {int: bool} = {}      # (while probing) conversion node -> proven
ff_ranging = false              # facts ask what a float-to-integer conversion's operand holds
ff_operands: {int: FR} = {}     # float-to-integer conversion node -> its operand's range (hulled)
ff_ranged: {int: bool} = {}     # functions walked for ff_operands


















































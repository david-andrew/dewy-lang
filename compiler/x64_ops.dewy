$runtime_checks
from p"backend_analysis.dewy" import (backend_debug_vregs)
from p"check.jo" import (fns locals watch_build)
from p"elf_format.dewy" import (elf_syms)
from p"ir.jo" import (ir main_code)
from p"lower.jo" import (LK_INST lfuncs)
from p"native_debug.dewy" import (LF_ALIAS LF_CAPTURE)
from p"pe_format.dewy" import (UW_ENTRY pe_iat_off unwind_fns)
from p"util.jo" import (fatal ice)
from p"x64.jo" import (WATCH_CODE_AT WATCH_CODE_SIZE code entry_end_lf fn_addr row_line)
from p"x64_allocate.dewy" import (VI)
from p"x64_module.dewy" import (x64_emit_adapter x64_emit_entry x64_emit_entry_win x64_emit_stubs x64_patch_module)

X64OpsWord:type=int64<overflow='wrap'>
backend_debug_bindings=():>void=>$unsafe {
    backend_debug_vregs.clear()
    loop l in ir.dbg_locals {
        if locals.ptr[l].offset >=? 0 or X64OpsWord(locals.ptr[l].flags) & (LF_CAPTURE | LF_ALIAS) not=? 0 {continue}
        backend_debug_vregs.push(X64OpsWord(locals.ptr[l].vreg))
    }
}
# the entry point of a Windows program: called with the stack 8 bytes off 16-byte alignment;
# the initializers and main, then ExitProcess(0) from the import table
# VirtualAlloc(at, size, kind, read/write/run) through the import table: its result in rax
x64_entry_win=(inits:array<int64> main_lf:X64OpsWord):>int64=>{
    let start=x64_emit_entry_win(inits main_lf main_code entry_end_lf watch_build WATCH_CODE_AT WATCH_CODE_SIZE pe_iat_off(0))
    elf_syms.push(["_start" start code.length - start])
    unwind_fns.push([start code.length UW_ENTRY 8])
    start
}
x64_cabi_adapter=(lf:X64OpsWord ptypes:array<int64>):>int64=>$unsafe {
    let nin:X64OpsWord=0
    loop t in ptypes {
        if t =? VI {nin += 1}
    }
    if nin >? 6 or ptypes.length - nin >? 8 {fatal(0 "a @cabi function called from C on Windows takes at most 6 integer and 8 float parameters ({lfuncs.ptr[lf].name} takes {ptypes.length})")}
    x64_emit_adapter(lf ptypes)
}
x64_entry=(inits:array<int64> main_lf:X64OpsWord):>int64=>{
    row_line=0
    let start=x64_emit_entry(inits main_lf main_code entry_end_lf watch_build WATCH_CODE_AT WATCH_CODE_SIZE)
    elf_syms.push(["_start" start code.length - start])
    start
}
# (a row where the position changes; dwarf.jo leaves out those on the same line)
x64_stubs=():>void=>{
    row_line=0
    x64_emit_stubs()
}
lf_is_cabi=(lf:X64OpsWord):>bool=>$unsafe {
    lfuncs.ptr[lf].kind =? LK_INST and fns.ptr[lfuncs.ptr[lf].inst].cabi
}
x64_resolve=(text_addr:X64OpsWord ro_addr:X64OpsWord data_addr:X64OpsWord):>void=>$unsafe {
    let [error lf]=x64_patch_module(text_addr ro_addr data_addr @fn_addr)
    if error =? 1 {ice("stubs not emitted")}
    if error =? 2 {ice("no adapter for {lfuncs.ptr[lf].name}")}
    if error =? 3 {ice("unresolved function {lfuncs.ptr[lf].name}")}
}

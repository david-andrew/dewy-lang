$runtime_checks

from p"ir_types.dewy" import (IrFn)
from p"@lib/core/os.jo" import (eprint)
from p"backend_analysis.dewy" import (LOC_SPILL backend_analyze backend_debug_vregs loop_s ra_loop_visits v_live vloc x_has_foreign_call)
from p"check.jo" import (fns locals target_wasm target_windows watch_build)
from p"fused.jo" import (fz_layout)
from p"ir_builders.dewy" import (vtype)
from p"lower_storage.dewy" import (vc)
from p"main.jo" import (repl_image)
from p"x64_emit.dewy" import (dbg_epis dbg_pos pad_moves ra_save_cost ra_save_x ra_stat rsp_row uw_at uw_fo x64_emit x_int_fail x_loop_line xe_emit_error)
from p"x64_encode.dewy" import (XMM b frame_size rsp_frame x_padding_cmov x_padding_floor)
from p"native_debug.dewy" import (dbg_cfi native_debug_function sym_name)
from p"elf_format.dewy" import (elf_syms)
from p"ir.jo" import (dbg_on ir ir_operand_layout main_code)
from p"lower.jo" import (LK_INST VC_AGG lfuncs mt_active_off opt_release)
from p"native_debug.dewy" import (LF_ALIAS LF_CAPTURE)
from p"pe_format.dewy" import (UW_ADAPTER UW_ENTRY UW_FRAME UW_SAVES pe_iat_off unwind_fns)
from p"diagnostic_exit.dewy" import (fatal ice)
from p"x64.jo" import (WATCH_CODE_AT WATCH_CODE_SIZE code entry_end_lf fn_addr fn_len ra_fn_base ra_spill_cost ra_total ra_verbose row_line)
from p"x64_allocate.dewy" import (VI callee_off ra_expire_visits ra_on ra_only ra_peak_gpr ra_peak_xmm ra_prio ra_spill_visits x64_allocate)
from p"x64_module.dewy" import (x64_emit_adapter x64_emit_entry x64_emit_entry_win x64_emit_stubs x64_patch_module)

X64OpsWord:type=int64<overflow='wrap'>
backend_debug_bindings=():>void=>$unsafe {
    backend_debug_vregs.clear()
    loop l in ir.dbg_locals {
        if locals.ptr[l].offset >=? 0 or X64OpsWord(locals.ptr[l].flags) & (LF_CAPTURE | LF_ALIAS) not=? 0 {continue}
        backend_debug_vregs.push(X64OpsWord(locals.ptr[l].vreg))
    }
}
# the entry point of a Windows program: called with the stack 8 bytes off 16-byte alignment;
# the initializers and main, then ExitProcess(0) from the import table
# VirtualAlloc(at, size, kind, read/write/run) through the import table: its result in rax
x64_entry_win=(inits:array<int64> main_lf:X64OpsWord):>int64=>{
    let start=x64_emit_entry_win(inits main_lf main_code entry_end_lf watch_build WATCH_CODE_AT WATCH_CODE_SIZE pe_iat_off(0))
    elf_syms.push(["_start" start code.length - start])
    unwind_fns.push([start code.length UW_ENTRY 8])
    start
}
x64_cabi_adapter=(lf:X64OpsWord ptypes:array<int64>):>int64=>$unsafe {
    let nin:X64OpsWord=0
    loop t in ptypes {
        if t =? VI {nin += 1}
    }
    if nin >? 6 or ptypes.length - nin >? 8 {fatal(0 "a @cabi function called from C on Windows takes at most 6 integer and 8 float parameters ({lfuncs.ptr[lf].name} takes {ptypes.length})")}
    x64_emit_adapter(lf ptypes)
}
x64_entry=(inits:array<int64> main_lf:X64OpsWord):>int64=>{
    row_line=0
    let start=x64_emit_entry(inits main_lf main_code entry_end_lf watch_build WATCH_CODE_AT WATCH_CODE_SIZE)
    elf_syms.push(["_start" start code.length - start])
    start
}
# (a row where the position changes; dwarf.jo leaves out those on the same line)
x64_stubs=():>void=>{
    row_line=0
    x64_emit_stubs()
}
lf_is_cabi=(lf:X64OpsWord):>bool=>$unsafe {
    lfuncs.ptr[lf].kind =? LK_INST and fns.ptr[lfuncs.ptr[lf].inst].cabi
}
x64_resolve=(text_addr:X64OpsWord ro_addr:X64OpsWord data_addr:X64OpsWord):>void=>$unsafe {
    let [error lf]=x64_patch_module(text_addr ro_addr data_addr @fn_addr)
    if error =? 1 {ice("stubs not emitted")}
    if error =? 2 {ice("no adapter for {lfuncs.ptr[lf].name}")}
    if error =? 3 {ice("unresolved function {lfuncs.ptr[lf].name}")}
}
# x64.jo's function, C ABI flags and positions, bound once: the emitters take their addresses
let xf_ir:ptr<IrFn>=$unsafe (uint64(0) as ptr<IrFn>)
let xf_cabi:ptr<array<bool>>=$unsafe (uint64(0) as ptr<array<bool>>)
let xf_positions:ptr<array<int64>>=$unsafe (uint64(0) as ptr<array<int64>>)
x64_function_bind=(input:ptr<IrFn> cabi:ptr<array<bool>> positions:ptr<array<int64>>):>X64OpsWord=>$unsafe {
    xf_ir=input
    xf_cabi=cabi
    xf_positions=positions
    0
}
# Where a function starts. On a default build a loop head takes a whole cache line, with its
# function: arena's time moved 617-728 ms with where its function fell, 618-625 with this (redfox).
# Code moved by whole multiples of this is the same bytes wherever it is made.
x64_code_align=():>int64=>{
    if not opt_release and not dbg_on and not watch_build and not repl_image {return 64}
    16
}
x64_function=():>void=>$unsafe {
    x_int_fail.clear()
    pad_moves=false
    loop fn_addr.length <=? ir.fn_index {fn_addr.push(-1)}
    loop fn_len.length <=? ir.fn_index {fn_len.push(0)}
    let align=X64OpsWord(x64_code_align())
    x_loop_line=if align =? 64 64 else 32
    # (align is 16 or 64 and the length is not negative: the remainder is a mask)
    loop X64OpsWord(code.length) & (align - 1) not=? 0 {b(0xCC)}
    fn_addr[ir.fn_index]=code.length
    let fn_start=X64OpsWord(code.length)
    x_padding_floor=fn_start
    x_padding_cmov=-1
    if ra_stat {
        ra_loop_visits=0
        ra_expire_visits=0
        ra_spill_visits=0
        ra_peak_gpr=0
        ra_peak_xmm=0
    }
    let priority=opt_release and ra_prio and not dbg_on and ((ra_only as array<uint8>).length =? 0 or ir.name =? ra_only)
    if dbg_on {backend_debug_bindings()}
    backend_analyze(@ir @ir_operand_layout dbg_on target_wasm ra_stat ra_on or priority)
    x64_allocate(xf_ir priority dbg_on ra_stat)
    # Large loop frames keep compact negative displacements and their established
    # branch layout. RSP's SIB/disp32 expansion otherwise adds hot-loop padding.
    # Relocatable watch/repl images and foreign C boundaries retain their chain.
    rsp_frame=not dbg_on and not target_windows and not watch_build and not repl_image and not ir.cabi and not x_has_foreign_call and not (frame_size >=? 64 and loop_s.length >? 0)
    # Function IDs and C ABI declarations are monotonic during a compilation;
    # extend the indexed policy only for Windows and only for new functions.
    if target_windows {
        loop xf_cabi[0].length <? lfuncs.length {xf_cabi[0].push(lf_is_cabi(xf_cabi[0].length))}
    }
    row_line=-1
    let body_start=X64OpsWord(x64_emit(xf_ir fn_start dbg_on target_windows fz_layout mt_active_off pe_iat_off(0) xf_cabi xf_positions))
    if xe_emit_error not=? "" {ice(xe_emit_error)}
    if dbg_on {
        dbg_pos[ir.code.length]=code.length
        dbg_function(fn_start body_start X64_DWREG XMM 17 6)
        dbg_cfi.push(fn_start)
        dbg_cfi.push(X64OpsWord(code.length) - fn_start)
        dbg_cfi.push(body_start - fn_start)
        let n:X64OpsWord=0
        loop r in [X64OpsWord(0)..16) {
            if callee_off[r] not=? 0 {n += 1}
        }
        dbg_cfi.push(n)
        loop r in [X64OpsWord(0)..16) {
            if callee_off[r] not=? 0 {
                dbg_cfi.push(X64_DWREG[r])
                dbg_cfi.push(X64OpsWord(callee_off[r]) - 16)
            }
        }
        dbg_cfi.push(dbg_epis.length)
        loop e in dbg_epis {dbg_cfi.push(X64OpsWord(e) - fn_start)}
    }
    if rsp_frame {rsp_row(-1)}
    rsp_frame=false
    elf_syms.push([sym_name(ir.name) fn_start X64OpsWord(code.length) - fn_start])
    fn_len[ir.fn_index]=X64OpsWord(code.length) - fn_start
    if target_windows {
        if uw_fo >? 0 {unwind_fns.push([fn_start code.length UW_SAVES uw_at])} else {unwind_fns.push([fn_start code.length UW_FRAME frame_size])}
        if ir.cabi {
            let pts:array<int64>=[]
            loop p in [X64OpsWord(0)..X64OpsWord(ir.nparams)) {pts.push(vtype(p))}
            let a=x64_cabi_adapter(ir.fn_index pts)
            unwind_fns.push([a code.length UW_ADAPTER 160])
        }
    }
    if ra_stat {
        if ra_verbose {
            let sp:X64OpsWord=0
            loop v in [X64OpsWord(0)..X64OpsWord(ir.vtypes.length)) {
                if vloc[v] =? LOC_SPILL {sp += v_live[v].weight}
            }
            eprint("  {ir.name}: spill {sp}, save {ra_save_cost + ra_save_x - ra_fn_base}; pressure {ra_peak_gpr} gpr {ra_peak_xmm} xmm, loop visits {ra_loop_visits}, expire visits {ra_expire_visits}, spill visits {ra_spill_visits}\n")
            ra_fn_base=ra_save_cost + ra_save_x
        }
        loop v in [X64OpsWord(0)..X64OpsWord(ir.vtypes.length)) {
            if vloc[v] =? LOC_SPILL {ra_spill_cost += v_live[v].weight}
            if vloc[v] =? LOC_SPILL or vloc[v] >=? 0 {ra_total += v_live[v].weight}
        }
    }
}
# x86-64 registers by encoding, as DWARF numbers them
X64_DWREG:array<int64>=[0 2 1 3 7 6 4 5 8 9 10 11 12 13 14 15]
# the variables of the function just emitted (from start; its body from body): where each is,
# from the registers the allocator gave and the frame (dwreg: DWARF numbers of the general
# registers; vector registers from fp_base on are DWARF's fp_dw on; frame: the frame register)
dbg_aggregate=(t:int64):>bool=>vc(t) =? VC_AGG
dbg_function=(start:X64OpsWord body:X64OpsWord dwreg:array<int64> fp_base:X64OpsWord fp_dw:X64OpsWord frame:X64OpsWord):>void=>$unsafe {
    native_debug_function(xf_ir code.length start body dwreg fp_base fp_dw frame @dbg_aggregate)
}


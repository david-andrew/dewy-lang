SlicePrepWord:type=int64<overflow='wrap'>

# Preserve the syntax mask's child order. Arena IDs are checked syntax IDs;
# each raw read is reacquired and no arena view survives an append or call.
fact_slice_children=(n:SlicePrepWord):>array<int64>=>$unsafe {
    let out:array<int64>=[]
    let mask:SlicePrepWord=int64(iso_child_p[int64(((nodes.ptr + n) as ptr<uint32>)[0])])
    if mask <? 0 {return out}
    if mask & 1 not=? 0 {out.push(int64(nodes[n].a))}
    if mask & 2 not=? 0 {out.push(int64(nodes[n].b))}
    if mask & 4 not=? 0 {out.push(int64(nodes[n].c))}
    if mask & 16 not=? 0 {
        loop i in [0..nkids(n)) {out.push(kid(n i))}
    }
    out
}
fact_slice_push_children=(@out:array<int64> n:SlicePrepWord):>void=>$unsafe {
    let np=nodes.ptr
    let nd=np + n
    let mask:SlicePrepWord=int64(iso_child_p[int64((nd as ptr<uint32>)[0])])
    if mask <? 0 {return}
    if mask & 1 not=? 0 {out.push(int64(nd[0].a))}
    if mask & 2 not=? 0 {out.push(int64(nd[0].b))}
    if mask & 4 not=? 0 {out.push(int64(nd[0].c))}
    if mask & 16 not=? 0 {
        let lp=lists.ptr
        let l0:SlicePrepWord=SlicePrepWord(nd[0].list)
        let nk:SlicePrepWord=SlicePrepWord(nd[0].nlist)
        loop i in [SlicePrepWord(0)..nk) {out.push(SlicePrepWord(lp[l0 + i]))}
    }
}

fact_slice_flags=(n:SlicePrepWord):>int64=>$unsafe {
    let base:SlicePrepWord=fact_slice.base
    if base =? -2 {
        let plan:SlicePrepWord=fact_slice.plan
        if plan =? 0 {return 0}
        if fsp_cur_plan not=? plan {fsp_sync_active()}
        if n >=? 0 and n <? fsp_mark_stamp.length and mark_stamp_p[n] =? mark_gen {return SlicePrepWord(mark_flags_p[n])}
        return 0
    }
    if base <? 0 {return max(0 fact_index_get_raw(fact_slice.flags.ptr fact_slice.flags.length n))}
    let i:SlicePrepWord=n - base
    if i <? 0 or i >=? fact_slice.flags.length {return 0}
    fact_slice.flags.ptr[i]
}
let fsp_wr_gen:array<int32>=[]
let fsp_wr_head:array<int32>=[]
let fsp_rt_gen:array<int32>=[]
let fsp_acc_gen:array<int32>=[]
let fsp_dep_gen:array<int32>=[]
let fsp_pw_gen:array<int32>=[]
let fsp_sw_gen:array<int32>=[]
let fsp_wr_g:int32=0
let fsp_in_prepare:bool=false

fsp_zero_i32=(@a:array<int32>):>void=>$unsafe {
    if a.length >? 0 {mem_set(a.ptr as ptr<uint8> 0 a.length * 4)}
}
fsp_wr_reset=():>void=>$unsafe {
    fsp_wr_g=int32<overflow='wrap'>(int64(fsp_wr_g) + 1)
    if fsp_wr_g =? 0 {
        fsp_zero_i32(@fsp_wr_gen); fsp_zero_i32(@fsp_rt_gen); fsp_zero_i32(@fsp_acc_gen)
        fsp_zero_i32(@fsp_dep_gen); fsp_zero_i32(@fsp_pw_gen); fsp_zero_i32(@fsp_sw_gen)
        fsp_wr_g=1
    }
}
fsp_set_mark=(@arr:array<int32> idx:SlicePrepWord):>void=>$unsafe {
    if idx <? 0 {return}
    if idx >=? arr.length {arr.resize(max(idx + 64 arr.length * 2 + 256))}
    arr.ptr[idx]=fsp_wr_g
}
fsp_has_mark=(@arr:array<int32> idx:SlicePrepWord):>bool=>$unsafe {
    idx >=? 0 and idx <? arr.length and arr.ptr[idx] =? fsp_wr_g
}
fsp_wr_get=(key:SlicePrepWord):>int64=>$unsafe {
    if key >=? 0 and key <? fsp_wr_gen.length and fsp_wr_gen.ptr[key] =? fsp_wr_g {return SlicePrepWord(fsp_wr_head.ptr[key])}
    -1
}
fact_slice_edge=(@edges:FactSliceEdges key:SlicePrepWord node:SlicePrepWord):>void=>$unsafe {
    edges.next.push(fact_index_get(edges.heads key))
    fact_index_put(@edges.heads key edges.nodes.length)
    edges.nodes.push(node)
}
fact_slice_writer=(@writers:FactSliceEdges p:PlaceIdentity n:SlicePrepWord):>void=>$unsafe {
    if p.declaration =? 0 {return}
    let key=fact_root_key(p)
    if fsp_in_prepare and key >=? 0 and key <? 262144 {
        if key >=? fsp_wr_gen.length {
            let need=max(key + 64 fsp_wr_gen.length * 2 + 256)
            fsp_wr_gen.resize(need)
            fsp_wr_head.resize(need)
        }
        let prev:SlicePrepWord=if fsp_wr_gen.ptr[key] =? fsp_wr_g {SlicePrepWord(fsp_wr_head.ptr[key])} else {-1}
        writers.next.push(prev)
        fsp_wr_gen.ptr[key]=fsp_wr_g
        fsp_wr_head.ptr[key]=int32<overflow='wrap'>(writers.nodes.length)
        writers.nodes.push(n)
        return
    }
    fact_slice_edge(@writers key n)
}
fact_slice_target=(@writers:FactSliceEdges n:SlicePrepWord at:SlicePrepWord):>void=>$unsafe {
    if nodes.ptr[n].kind =? 'tuple' {
        loop i in [0..nkids(n)) {fact_slice_target(@writers kid(n i) at)}
        return
    }
    fact_slice_writer(@writers fact_slice_root(n) at)
}
# A call's mutable (`@`) arguments, each written by it.
fact_slice_place_arguments=(@writers:FactSliceEdges n:SlicePrepWord):>void=>{
    let mask:SlicePrepWord=checked_call_mutmask(n)
    loop i in [0..nkids(n)) {
        if mask & (SlicePrepWord(1) << SlicePrepWord(i)) not=? 0 {fact_slice_target(@writers kid(n i) n)}
    }
}
# The variable a write target changes: through fields, elements, local
# places (`let q = @r.xs`, `loop @x in xs`) and narrowed names (`if r is? T`),
# which write the variable they name, or none. O(route depth).
fact_slice_root=(n:SlicePrepWord):>PlaceIdentity=>$unsafe {
    let root:SlicePrepWord=n
    let depth:SlicePrepWord=0
    loop root not=? 0 and depth <? 64 {
        depth+=1
        let k=nodes.ptr[root].kind
        if k =? 'field' or k =? 'index' or k =? 'addr' or fact_payload_node(root) {root=SlicePrepWord(nodes.ptr[root].a)}
        # SK.local has the frozen node-ABI ordinal 1.
        else if k =? 'ident' and nodes.ptr[root].aux =? int32(1) and SlicePrepWord(locals.ptr[SlicePrepWord(nodes.ptr[root].sym)].flags) & LF_ALIAS not=? 0 and locals.ptr[SlicePrepWord(nodes.ptr[root].sym)].alias not=? 0 and not place_locked.has(SlicePrepWord(nodes.ptr[root].sym)) {root=SlicePrepWord(locals.ptr[SlicePrepWord(nodes.ptr[root].sym)].alias)}
        else {break}
    }
    fact_place(root)
}
# A contract reads its value and referenced actuals; proving it does not
# demand the callee's return summary. Called only for written argument
# contracts, O(predicate atoms), with node-indexed slice deduplication.
fact_slice_contract_actuals=(call:SlicePrepWord arg:SlicePrepWord):>void=>$unsafe {
    fsp_push_val(arg)
    let rt=prune(SlicePrepWord(nodes.ptr[arg].aux2))
    if types.ptr[rt].kind not=? 'refined' {
        fsp_push_val(call)
        return
    }
    loop atom in ref_predicates[SlicePrepWord(types.ptr[rt].st)] {
        if (atom.a.kind =? 2 or atom.a.kind =? 5) and atom.a.value >=? 0 and atom.a.value <? nkids(call) {fsp_push_val(kid(call atom.a.value))}
        if (atom.b.kind =? 2 or atom.b.kind =? 5) and atom.b.value >=? 0 and atom.b.value <? nkids(call) {fsp_push_val(kid(call atom.b.value))}
    }
}

# A contract bounded by a stable local (`addr<(<? n)>` after `const n = g.names.length`)
# reads that local where it is checked or assumed: a conversion to it, a read of a
# place holding it in an element or dictionary value. Its definitions join the slice.
# Only while refinements exist; O(atoms) over the type's few nested levels.
fact_slice_term_locals=(t0:SlicePrepWord @out:array<int64> depth:SlicePrepWord):>void=>$unsafe {
    if t0 <=? 0 or depth >? 4 {return}
    let t=prune(t0)
    let k=types.ptr[t].kind
    if k =? 'refined' {
        loop atom in ref_predicates[SlicePrepWord(types.ptr[t].st)] {
            if atom.a.kind =? 3 {out.push(atom.a.value)}
            if atom.b.kind =? 3 {out.push(atom.b.value)}
        }
        fact_slice_term_locals(SlicePrepWord(types.ptr[t].elem) @out depth + 1)
    }
    else if k =? 'array' or k =? 'fixed' or k =? 'generator' or k =? 'opt' {fact_slice_term_locals(SlicePrepWord(types.ptr[t].elem) @out depth + 1)}
    else if k =? 'struct_' {
        let si=SlicePrepWord(types.ptr[t].st)
        loop i in [SlicePrepWord(0)..min(SlicePrepWord(structs.ptr[si].ntargs) 2)) {fact_slice_term_locals(struct_targ(si i) @out depth + 1)}
    }
}
# Whether a generator type's element contract names its function's parameters. O(atoms).
fact_type_names_formals=(g0:SlicePrepWord):>bool=>$unsafe {
    let e=prune(SlicePrepWord(types.ptr[prune(g0)].elem))
    if types.ptr[e].kind not=? 'refined' {return false}
    loop atom in ref_predicates[SlicePrepWord(types.ptr[e].st)] {
        if atom.a.kind =? 2 or atom.b.kind =? 2 {return true}
    }
    false
}
# Whether type t names such a local, memoized by interned type: O(1) after its first query.
let fsp_type_locals:array<int8>=[]
fact_type_names_locals=(t0:SlicePrepWord):>bool=>$unsafe {
    if t0 <=? 0 {return false}
    let t=prune(t0)
    let k=types.ptr[t].kind
    if k =? 'int_' or k =? 'str_' or k =? 'bool_' or k =? 'float_' or k =? 'var' {return false}
    if t <? fsp_type_locals.length and fsp_type_locals.ptr[t] not=? int8(0) {return fsp_type_locals.ptr[t] =? int8(2)}
    let deps:array<int64>=[]
    fact_slice_term_locals(t @deps 0)
    if t >=? fsp_type_locals.length {fsp_type_locals.resize(max(t + 64 SlicePrepWord(fsp_type_locals.length) * 2))}
    fsp_type_locals.ptr[t]=if deps.length >? 0 {int8(2)} else {int8(1)}
    deps.length >? 0
}
fact_slice_local_writers=(t:SlicePrepWord writers:FactSliceEdges):>void=>$unsafe {
    if ref_named_locals.length =? 0 or not fact_type_names_locals(t) {return}
    let deps:array<int64>=[]
    fact_slice_term_locals(t @deps 0)
    loop o in deps {
        let rkey=fact_root_key(PlaceIdentity('local' SlicePrepWord(locals.ptr[o].owner) o))
        let edge=if rkey >=? 0 and rkey <? 262144 {fsp_wr_get(rkey)} else {fact_index_get_raw(writers.heads.ptr writers.heads.length rkey)}
        loop edge >=? 0 {
            let definition=writers.nodes.ptr[edge]
            edge=writers.next.ptr[edge]
            if nodes.ptr[definition].kind =? 'call' {fsp_push_act(definition)}
            else {fsp_push_val(definition)}
        }
    }
}
# Pure-Dewy compact node-indexed mark arrays: int32 stamp, uint8 flags, int32 head.
# Always uniquely owned here, so direct pointer writes need no COW/bounds checks.
let fsp_mark_stamp:array<int32>=[]
let fsp_mark_flags:array<uint8>=[]
let fsp_mark_head:array<int32>=[]
let fsp_mark_touched:array<int32>=[]
let mark_stamp_p:ptr<int32>=$unsafe (uint64(0) as ptr<int32>)
let mark_flags_p:ptr<uint8>=$unsafe (uint64(0) as ptr<uint8>)
let mark_head_p:ptr<int32>=$unsafe (uint64(0) as ptr<int32>)
let mark_gen:int32=0
let fsp_cur_plan:SlicePrepWord=-1
facts_slice_marks_bind=(_stamp:ptr<array<int64>> _flags:ptr<array<int64>> _head:ptr<array<int64>> _touched:ptr<array<int64>>):>int64=>0
facts_slice_marks_begin=():>void=>$unsafe {
    fsp_cur_plan=-1
    let nn:SlicePrepWord=nodes.length
    if fsp_mark_stamp.length <? nn {
        let need=max(nn + 1024 SlicePrepWord(fsp_mark_stamp.length) * 2)
        fsp_mark_stamp.resize(need)
        fsp_mark_flags.resize(need)
        fsp_mark_head.resize(need)
    }
    mark_gen=int32<overflow='wrap'>(int64(mark_gen) + 1)
    if mark_gen =? int32(0) {
        mem_set(fsp_mark_stamp.ptr as ptr<uint8> 0 fsp_mark_stamp.length * 4)
        mark_gen=int32(1)
    }
    fsp_mark_touched.clear()
    mark_stamp_p=fsp_mark_stamp.ptr
    mark_flags_p=fsp_mark_flags.ptr
    mark_head_p=fsp_mark_head.ptr
}
fsp_sync_active=():>void=>$unsafe {
    if fact_slice.plan =? 0 or fact_slice.base not=? -2 {return}
    facts_slice_marks_begin()
    let fp=fact_slice.flags.ptr
    let fn_=fact_slice.flags.length
    let mstamp=mark_stamp_p
    let mflags=mark_flags_p
    let mgen=mark_gen
    loop i in [SlicePrepWord(0)..fn_) {
        let entry:SlicePrepWord=fp[i]
        let tn:SlicePrepWord=entry >> 8
        mstamp[tn]=mgen
        mflags[tn]=uint8<overflow='wrap'>(entry & 255)
    }
    fsp_cur_plan=fact_slice.plan
}

# Queries/touches are O(1); growth is O(nodes), parent appends amortized O(1).
fact_mark_of=(n:SlicePrepWord):>int64=>$unsafe {
    if mark_stamp_p[n] not=? mark_gen {return 0}
    SlicePrepWord(mark_flags_p[n])
}
fact_mark_touch=(n:SlicePrepWord):>void=>$unsafe {
    if mark_stamp_p[n] =? mark_gen {return}
    mark_stamp_p[n]=mark_gen
    mark_flags_p[n]=uint8(0)
    mark_head_p[n]=int32(-1)
    fsp_mark_touched.push(int32<overflow='wrap'>(n))
}
fact_mark_set=(n:SlicePrepWord flags:SlicePrepWord):>void=>$unsafe {
    if mark_stamp_p[n] not=? mark_gen {
        mark_stamp_p[n]=mark_gen
        mark_head_p[n]=int32(-1)
        fsp_mark_touched.push(int32<overflow='wrap'>(n))
    }
    mark_flags_p[n]=uint8<overflow='wrap'>(flags)
}
fact_mark_parent=(n:SlicePrepWord):>int64=>$unsafe {
    if mark_stamp_p[n] not=? mark_gen {return -1}
    SlicePrepWord(mark_head_p[n])
}
fact_slice_member=(@parents:FactSliceEdges @work:array<int64> c:SlicePrepWord n:SlicePrepWord):>void=>$unsafe {
    if c =? 0 {return}
    let prev:SlicePrepWord=-1
    if mark_stamp_p[c] not=? mark_gen {
        mark_stamp_p[c]=mark_gen
        mark_flags_p[c]=uint8(0)
        fsp_mark_touched.push(int32<overflow='wrap'>(c))
    } else {
        prev=SlicePrepWord(mark_head_p[c])
    }
    parents.next.push(prev)
    mark_head_p[c]=int32<overflow='wrap'>(parents.nodes.length)
    parents.nodes.push(n)
    work.push(c)
}
fact_slice_parent=(@parents:FactSliceEdges child:SlicePrepWord node:SlicePrepWord):>void=>$unsafe {
    let prev:SlicePrepWord=-1
    if mark_stamp_p[child] not=? mark_gen {
        mark_stamp_p[child]=mark_gen
        mark_flags_p[child]=uint8(0)
        fsp_mark_touched.push(int32<overflow='wrap'>(child))
    } else {
        prev=SlicePrepWord(mark_head_p[child])
    }
    parents.next.push(prev)
    mark_head_p[child]=int32<overflow='wrap'>(parents.nodes.length)
    parents.nodes.push(node)
}

let fsp_work:array<int64>=[]
let fsp_values:array<int64>=[]
let fsp_active:array<int64>=[]
let fsp_exposed:array<int64>=[]
let fsp_opaque:array<int64>=[]
let fsp_forks:array<int64>=[]
let fsp_pnodes:array<int64>=[]
let fsp_pnext:array<int64>=[]
let fsp_wnodes:array<int64>=[]
let fsp_wnext:array<int64>=[]
let fsp_lib_kind:array<int8>=[]
let fsp_special_names:dict<int64 bool>=dict<int64 bool>()
let fsp_mt_h:ptr<SlicePrepWord>=$unsafe (uint64(0) as ptr<SlicePrepWord>)
let fsp_wk_h:ptr<SlicePrepWord>=$unsafe (uint64(0) as ptr<SlicePrepWord>)
let fsp_pn_h:ptr<SlicePrepWord>=$unsafe (uint64(0) as ptr<SlicePrepWord>)
let fsp_px_h:ptr<SlicePrepWord>=$unsafe (uint64(0) as ptr<SlicePrepWord>)
let fsp_val_h:ptr<SlicePrepWord>=$unsafe (uint64(0) as ptr<SlicePrepWord>)
let fsp_act_h:ptr<SlicePrepWord>=$unsafe (uint64(0) as ptr<SlicePrepWord>)

fsp_init_i64=(@a:array<int64> min_cap:SlicePrepWord):>ptr<SlicePrepWord>=>$unsafe {
    a.clear()
    a.reserve(min_cap)
    (a.ptr as ptr<SlicePrepWord>) - 3
}
fsp_init_i32=(@a:array<int32> min_cap:SlicePrepWord):>ptr<SlicePrepWord>=>$unsafe {
    a.clear()
    a.reserve(min_cap)
    (a.ptr as ptr<SlicePrepWord>) - 3
}
fsp_grow_buf=(which:SlicePrepWord v:SlicePrepWord v2:SlicePrepWord):>void=>$unsafe {
    if which =? 0 {
        fsp_mark_touched.push(int32<overflow='wrap'>(v))
        fsp_mt_h=(fsp_mark_touched.ptr as ptr<SlicePrepWord>) - 3
        return
    }
    if which =? 1 {
        fsp_work.push(v)
        fsp_wk_h=(fsp_work.ptr as ptr<SlicePrepWord>) - 3
        return
    }
    if which =? 2 {
        fsp_pnodes.push(v)
        fsp_pnext.push(v2)
        fsp_pn_h=(fsp_pnodes.ptr as ptr<SlicePrepWord>) - 3
        fsp_px_h=(fsp_pnext.ptr as ptr<SlicePrepWord>) - 3
        return
    }
    if which =? 3 {
        fsp_values.push(v)
        fsp_val_h=(fsp_values.ptr as ptr<SlicePrepWord>) - 3
        return
    }
    fsp_active.push(v)
    fsp_act_h=(fsp_active.ptr as ptr<SlicePrepWord>) - 3
}
fsp_push_mt=(v:SlicePrepWord):>void=>$unsafe {
    let h=fsp_mt_h
    let n=h[1]
    if n <? h[2] {
        h[1]=n + 1
        let d=(h + 3) as ptr<int32>
        d[n]=int32<overflow='wrap'>(v)
        return
    }
    fsp_grow_buf(0 v 0)
}
fsp_push_val=(v:SlicePrepWord):>void=>$unsafe {
    let h=fsp_val_h
    let n=h[1]
    if n <? h[2] {
        h[1]=n + 1
        let d=(h + 3) as ptr<int64>
        d[n]=v
        return
    }
    fsp_grow_buf(3 v 0)
}
fsp_push_act=(v:SlicePrepWord):>void=>$unsafe {
    let h=fsp_act_h
    let n=h[1]
    if n <? h[2] {
        h[1]=n + 1
        let d=(h + 3) as ptr<int64>
        d[n]=v
        return
    }
    fsp_grow_buf(4 v 0)
}
fsp_visit_child=(c:SlicePrepWord n:SlicePrepWord):>void=>$unsafe {
    let prev:SlicePrepWord=-1
    let mstamp=mark_stamp_p
    let mgen=mark_gen
    if mstamp[c] not=? mgen {
        mstamp[c]=mgen
        mark_flags_p[c]=uint8(0)
        let mh=fsp_mt_h
        let mn=mh[1]
        if mn <? mh[2] {
            mh[1]=mn + 1
            let md=(mh + 3) as ptr<int32>
            md[mn]=int32<overflow='wrap'>(c)
        } else {
            fsp_grow_buf(0 c 0)
        }
    } else {
        prev=SlicePrepWord(mark_head_p[c])
    }
    let pnh=fsp_pn_h
    let pxh=fsp_px_h
    let plen=pnh[1]
    mark_head_p[c]=int32<overflow='wrap'>(plen)
    if plen <? pnh[2] and plen <? pxh[2] {
        pnh[1]=plen + 1
        pxh[1]=plen + 1
        let pnd=(pnh + 3) as ptr<int64>
        let pxd=(pxh + 3) as ptr<int64>
        pnd[plen]=n
        pxd[plen]=prev
    } else {
        fsp_grow_buf(2 n prev)
    }
    let wh=fsp_wk_h
    let wn=wh[1]
    if wn <? wh[2] {
        wh[1]=wn + 1
        let wd=(wh + 3) as ptr<int64>
        wd[wn]=c
    } else {
        fsp_grow_buf(1 c 0)
    }
}
fsp_push_children_val=(n:SlicePrepWord):>void=>$unsafe {
    let nd=nodes.ptr + n
    let mask:SlicePrepWord=int64(iso_child_p[int64((nd as ptr<uint32>)[0])])
    if mask <=? 0 {return}
    if mask & 1 not=? 0 {fsp_push_val(SlicePrepWord(nd[0].a))}
    if mask & 2 not=? 0 {fsp_push_val(SlicePrepWord(nd[0].b))}
    if mask & 4 not=? 0 {fsp_push_val(SlicePrepWord(nd[0].c))}
    if mask & 16 not=? 0 {
        let lp=lists.ptr
        let l0:SlicePrepWord=SlicePrepWord(nd[0].list)
        let nk:SlicePrepWord=SlicePrepWord(nd[0].nlist)
        loop i in [SlicePrepWord(0)..nk) {fsp_push_val(SlicePrepWord(lp[l0 + i]))}
    }
}

fsp_reset=():>void=>{
    fsp_lib_kind.clear()
    fsp_type_locals.clear()
    fsp_cur_plan=-1
}

fsp_lib_classify=(n:SlicePrepWord callee:SlicePrepWord):>bool=>$unsafe {
    if fsp_special_names.length =? 0 {
        let names=["exit" "parallel_range" "parallel_map" "__dewy_parallel_collect" "__dewy_parallel_each" "sorted" "sorted_by" "sort" "sort_by" "sort_with" "min_by" "max_by" "group_by" "map" "filter" "sorted_with" "graphemes" "rational" "divmod" "__eq__" "__lt__" "__dewy_power" "pow" "__pow__" "__dewy_range" "__nd_axis_slice" "__dewy_slice_range" "__dewy_open_range_iter" "__floor_div" "__floor_mod" "__floor_div_pow2" "__floor_mod_pow2" "mod" "min" "max" "gcd" "sum" "swap" "__dewy_insert" "reshape" "__dewy_put_slice" "__bcast" "__dewy_read_u64" "__dewy_read_u32" "__dewy_read_u16" "reverse" "contains" "has" "[]" "__map_entry_present" "pop" "__map_entry" "[]=" "get" "insert_if_absent" "clear" "peek" "peek_priority" "push" "__pool_index" "add" "remove" "atomic_add" "atomic_sub" "atomic_and" "atomic_or" "atomic_xor" "atomic_exchange" "atomic_min" "atomic_max" "atomic_compare_exchange" "__map_entries" "__map_of" "first" "last" "keys" "values" "__dewy_keys" "__dewy_set_values" "is_empty" "len" "count" "__dewy_string_length" "__dewy_string_index" "__dewy_string_slice" "__dewy_byte_slice" "regex" "__dewy_find" "__dewy_rfind" "__dewy_index_of" "split" "words" "lines" "starts_with" "ends_with"]
        loop nm in names {fsp_special_names[intern(nm)]=true}
    }
    if callee >=? fsp_lib_kind.length {fsp_lib_kind.resize(max(callee + 64 fns.length + 64))}
    let d=SlicePrepWord(fns.ptr[callee].decl)
    if d =? 0 {
        fsp_lib_kind.ptr[callee]=int8(1)
        return false
    }
    if fsp_special_names.has(SlicePrepWord(nodes.ptr[d].name)) or fact_nd_call(n) not=? 0 {
        fsp_lib_kind.ptr[callee]=int8(2)
        return true
    }
    fsp_lib_kind.ptr[callee]=int8(1)
    false
}
fsp_is_lib_sp=(n:SlicePrepWord callee:SlicePrepWord):>bool=>$unsafe {
    if callee <? fsp_lib_kind.length {
        let tag=fsp_lib_kind.ptr[callee]
        if tag not=? int8(0) {return tag =? int8(2)}
    }
    fsp_lib_classify(n callee)
}
fsp_lib_loop1=(n:SlicePrepWord nk:SlicePrepWord l0:SlicePrepWord flags:SlicePrepWord @forks:array<int64>):>bool=>$unsafe {
    let demand_static=(flags & 1) not=? 0
    let summary=(flags & 2) not=? 0
    let share=(flags & 4) not=? 0
    let has_nd_mut=(flags & 8) not=? 0
    let probe_only=false
    if library_exit_call(n) {fsp_push_act(n)}
    if demand_static and (fact_library_call(n "parallel_range") or fact_library_call(n "parallel_map") or fact_parallel_array(n)) {
        loop j in [SlicePrepWord(0)..nk) {
            let arg=SlicePrepWord(lists.ptr[l0 + j])
            if nodes.ptr[arg].kind =? 'lambda' and nodes.ptr[arg].sym >? 0 {
                fact_fork_nodes[arg]=true
                fact_inline_forks[arg]=true
                forks.push(arg)
            }
        }
        if fact_parallel_array(n) {
            fsp_push_val(n)
            let source=SlicePrepWord(lists.ptr[l0])
            fsp_push_val(source)
            # (a range's endpoints, read again for its positions: fact_parallel_range_bound)
            if fact_parallel_range_source(source) {
                loop e in [kid(source 0) kid(source 2)] {
                    let named=fact_parallel_endpoint(e)
                    if named not=? 0 and nodes.ptr[named].kind =? 'ident' {fsp_push_val(named)}
                }
            }
        }
    }
    if not summary and dir_assumed_bounds_any and fact_parallel_range_call(n) {
        fsp_push_act(n)
        fsp_push_val(n)
        let a0=SlicePrepWord(lists.ptr[l0])
        if fact_library_call(a0 "__dewy_range") {
            let al0=SlicePrepWord(nodes.ptr[a0].list)
            fsp_push_val(SlicePrepWord(lists.ptr[al0]))
            fsp_push_val(SlicePrepWord(lists.ptr[al0 + 2]))
        }
    }
    if demand_static {
        let kcb=fact_key_callback(n)
        if kcb >? 0 {
            fact_fork_nodes[kcb]=true
            fact_inline_forks[kcb]=true
            forks.push(kcb)
            fsp_push_val(n)
            fsp_push_val(SlicePrepWord(lists.ptr[l0]))
        }
    }
    if result_active or proof_active or fact_divisors.length >? 0 and fact_divisors.has(n) or fact_rational_constructor(n) or fact_rational_promotion(n) or fact_rational_divmod(n) {fsp_push_val(n)}
    else if demand_static and fact_string_call(n) >=? 2 {fsp_push_val(n)}
    else if demand_static and fact_rational_zero_test(n) >=? 0 {
        fsp_push_val(n)
        fsp_push_val(SlicePrepWord(lists.ptr[l0 + fact_rational_zero_test(n)]))
    }
    else if demand_static and fact_power_call(n) {
        fsp_push_val(n)
        fsp_push_val(SlicePrepWord(lists.ptr[l0 + 1]))
        fsp_push_val(SlicePrepWord(lists.ptr[l0]))
    }
    else if demand_static and fact_range_call(n) {
        let first=fact_range_first(n true)
        fsp_push_val(n)
        fsp_push_val(SlicePrepWord(lists.ptr[l0 + first]))
        fsp_push_val(SlicePrepWord(lists.ptr[l0 + first + 1]))
    }
    else if demand_static and (has_nd_mut and nd_mutable_call(n) or fact_array_call(n) not=? 0 or fact_map_call(n) not=? 0 or fact_map_insert_call(n) or ref_self_active and (fact_map_clear_call(n) or fact_map_bounded_call(n) not=? 0) or fact_nonempty_call(n) or fact_heap_call(n) not=? 0 or fact_exact_sum_call(n) or fact_pool_call(n) not=? 0 or fact_gpu_index_call(n)) {
        fsp_push_act(n)
        fsp_push_val(n)
        loop j in [SlicePrepWord(0)..nk) {fsp_push_val(SlicePrepWord(lists.ptr[l0 + j]))}
    }
    else if (fact_probe_on or share) and fact_floor_call(n) not=? 0 {
        if fact_probe_on {fsp_push_val(n)}
        probe_only=true
    }
    probe_only
}

fsp_l1_vardecl=(n:SlicePrepWord @writers:FactSliceEdges has_own:bool):>void=>$unsafe {
    let locals_p=locals.ptr
    if has_own and nodes.ptr[n].b not=? 0 and ownership_fact_type(ntype(SlicePrepWord(nodes.ptr[n].b))) {fsp_push_act(n)}
    let l=SlicePrepWord(nodes.ptr[n].sym)
    if l not=? 0 {
        let p=if has_flag(n NF_GLOBAL) {PlaceIdentity('global' 0 l)} else {PlaceIdentity('local' SlicePrepWord(locals_p[l].owner) l)}
        fact_slice_writer(@writers p n)
    }
    let nk=SlicePrepWord(nodes.ptr[n].nlist)
    let l0=SlicePrepWord(nodes.ptr[n].list)
    loop j in [SlicePrepWord(0)..nk) {
        let c=SlicePrepWord(lists.ptr[l0 + j])
        let cl=SlicePrepWord(nodes.ptr[c].sym)
        if cl >? 0 and not has_flag(c NF_GLOBAL) {fact_slice_writer(@writers PlaceIdentity('local' SlicePrepWord(locals_p[cl].owner) cl) n)}
    }
}

fsp_l1_assign=(n:SlicePrepWord f:SlicePrepWord @writers:FactSliceEdges @exposed_writes:array<int64> @opaque_writes:array<int64> demand_static:bool):>bool=>$unsafe {
    let carried=false
    let target=SlicePrepWord(nodes.ptr[n].a)
    if nodes.ptr[target].kind =? 'ident' and nodes.ptr[target].aux =? int32(1) {
        let tl=SlicePrepWord(nodes.ptr[target].sym)
        if fact_carried_type(SlicePrepWord(locals.ptr[tl].type) f) {carried=true}
        if fact_loop_step(SlicePrepWord(nodes.ptr[n].b) tl) or fact_loop_unbounded_field(SlicePrepWord(nodes.ptr[n].b)) {fsp_set_mark(@fsp_sw_gen tl)}
        else {fsp_set_mark(@fsp_pw_gen tl)}
    }
    fact_slice_target(@writers target n)
    if demand_static and fact_shift_obliged(n) {fsp_push_val(n)}
    let root=target
    let raw=false
    loop nodes.ptr[root].kind =? 'field' or nodes.ptr[root].kind =? 'index' {
        if nodes.ptr[root].kind =? 'index' and tkind(fact_type(ntype(SlicePrepWord(nodes.ptr[root].a)))) =? 'ptr' {raw=true}
        root=SlicePrepWord(nodes.ptr[root].a)
    }
    let p=fact_place(root)
    if raw or p.declaration not=? 0 and fact_exposed(p) and not fact_own_local(p) {exposed_writes.push(n)}
    else if p.declaration =? 0 {opaque_writes.push(n)}
    carried
}

fsp_l1_call=(n:SlicePrepWord f:SlicePrepWord flags:SlicePrepWord @writers:FactSliceEdges @exposed_writes:array<int64> @forks:array<int64> @callees:array<int64> @versions:array<int64> @psites:array<int64>):>bool=>$unsafe {
    let demand_static=(flags & 1) not=? 0
    let share=(flags & 4) not=? 0
    let has_nd_mut=(flags & 8) not=? 0
    let has_own=(flags & 16) not=? 0
    let collect_panic=(flags & 32) not=? 0
    let probe_only=false
    if collect_panic {psites.push(n)}
    let callee=SlicePrepWord(nodes.ptr[n].sym)
    let direct=nodes.ptr[n].aux =? 0 and callee >? 0
    let in_lib=direct and fact_fn_in_lib(callee)
    let nk=SlicePrepWord(nodes.ptr[n].nlist)
    let l0=SlicePrepWord(nodes.ptr[n].list)
    if ntype(n) =? T_NEVER {fsp_push_act(n)}
    let lib_sp=in_lib and fsp_is_lib_sp(n callee)
    if lib_sp {
        if fsp_lib_loop1(n nk l0 (flags & 15) @forks) {probe_only=true}
    } else if result_active or proof_active or fact_divisors.length >? 0 and fact_divisors.has(n) {fsp_push_val(n)}
    else if demand_static and has_nd_mut and nd_mutable_call(n) {
        fsp_push_act(n)
        fsp_push_val(n)
        loop j in [SlicePrepWord(0)..nk) {fsp_push_val(SlicePrepWord(lists.ptr[l0 + j]))}
    }
    loop j in [SlicePrepWord(0)..nk) {
        let arg=SlicePrepWord(lists.ptr[l0 + j])
        if has_own and ownership_fact_type(ntype(arg)) {fsp_push_act(n)}
        if nodes.ptr[arg].kind =? 'conv' and nodes.ptr[arg].aux =? int32(int64(CV.refinement)) {
            if direct {
                mark_flags_p[n]=uint8<overflow='wrap'>(SlicePrepWord(mark_flags_p[n]) | FACT_CONTRACT)
                fact_slice_contract_actuals(n arg)
            } else {fsp_push_val(n)}
        }
    }
    if wi_fact_calls.length >? 0 and wi_fact_calls.has(n) {
        fsp_push_val(n)
        loop j in [SlicePrepWord(0)..nk) {fsp_push_val(SlicePrepWord(lists.ptr[l0 + j]))}
    }
    if share and direct and not fsp_has_mark(@fsp_dep_gen callee) {
        fsp_set_mark(@fsp_dep_gen callee)
        callees.push(callee)
        versions.push(fact_plan_version(callee))
    }
    if direct and ref_refined_result(SlicePrepWord(fns.ptr[callee].ret)) {fsp_push_val(n)}
    if direct and callee <? effect_summaries.length and effect_summaries.ptr[callee].done {
        let opaque=false
        loop event in effect_summaries.ptr[callee].events {
            let ak=event.atom.kind
            if ak =? 'opaque' or ak =? 'escape' or ak =? 'io' and fact_fn_in_lib(f) {
                exposed_writes.push(n)
                opaque=true
            }
            if ak not=? 'write' {continue}
            let p=place_base(event.atom.place)
            if p.root =? 'formal' {
                let fi=SlicePrepWord(p.declaration) - 1
                p=if fi >=? 0 and fi <? nk {fact_written_root(SlicePrepWord(lists.ptr[l0 + fi]))} else {PlaceIdentity('local' 0 0)}
            }
            if p.declaration =? 0 {exposed_writes.push(n)}
            else {
                fact_slice_writer(@writers p n)
                if fact_exposed(p) and not fact_own_local(p) {exposed_writes.push(n)}
            }
        }
        if opaque {fact_slice_place_arguments(@writers n)}
    } else if nodes.ptr[n].aux not=? int32(2) and nodes.ptr[n].aux not=? int32(3) {
        exposed_writes.push(n)
        fact_slice_place_arguments(@writers n)
    }
    probe_only
}

fsp_l1_intrinsic=(n:SlicePrepWord flags:SlicePrepWord @writers:FactSliceEdges @exposed_writes:array<int64> @opaque_writes:array<int64> @psites:array<int64>):>bool=>$unsafe {
    let collect_panic=(flags & 1) not=? 0
    let summary=(flags & 2) not=? 0
    let rows=(flags & 4) not=? 0
    if collect_panic {psites.push(n)}
    let id=nodes.ptr[n].aux as IN
    if not rows and id =? IN.push and nodes.ptr[n].nlist =? int32(2) {
        let a0=SlicePrepWord(lists.ptr[SlicePrepWord(nodes.ptr[n].list)])
        if fact_push_receiver(a0) >? 0 and fact_row_array(ntype(a0)) {rows=true}
    }
    if id =? IN.push or id =? IN.pop or id =? IN.clear or id =? IN.reserve or id =? IN.insert or id =? IN.remove or id =? IN.extend or id =? IN.truncate or id =? IN.resize {
        let a0=SlicePrepWord(lists.ptr[SlicePrepWord(nodes.ptr[n].list)])
        fact_slice_target(@writers a0 n)
        let p=fact_slice_root(a0)
        if p.declaration =? 0 {opaque_writes.push(n)}
        else if fact_exposed(p) and not fact_own_local(p) {exposed_writes.push(n)}
        if not summary and fact_policy =? 'RequireStatic' and (id =? IN.pop or id =? IN.remove or id =? IN.truncate) {
            fsp_push_act(n)
            fsp_push_val(n)
        }
    } else if id =? IN.static_assert or id =? IN.runtime_assert or id =? IN.assert or id =? IN.panic or id =? IN.unreachable or id =? IN.lend or id =? IN.loan_length or id =? IN.loan_store {fsp_push_val(n)}
    else if id not=? IN.len and not fact_pure_intrinsic(id) {opaque_writes.push(n)}
    rows
}

fsp_l2_ident=(n:SlicePrepWord flags:SlicePrepWord @writers:FactSliceEdges @roots:array<int64> @exposed_writes:array<int64> @opaque_writes:array<int64> wnodes_p:ptr<int64> wnext_p:ptr<int64>):>SlicePrepWord=>$unsafe {
    let any_root=(flags & 1) not=? 0
    let any_exposed=(flags & 2) not=? 0
    let p=fact_place(n)
    let root=fact_root_key(p)
    let seen_root=false
    if root >=? 0 and root <? 262144 {
        if root >=? fsp_rt_gen.length {fsp_rt_gen.resize(max(root + 64 fsp_rt_gen.length * 2 + 256))}
        if fsp_rt_gen.ptr[root] =? fsp_wr_g {seen_root=true}
        else {fsp_rt_gen.ptr[root]=fsp_wr_g}
    } else {
        if fact_index_get_raw(roots.ptr roots.length root) >=? 0 {seen_root=true}
        else {fact_index_put(@roots root 0)}
    }
    if not seen_root {
        let edge=if root >=? 0 and root <? 262144 {fsp_wr_get(root)} else {fact_index_get_raw(writers.heads.ptr writers.heads.length root)}
        loop edge >=? 0 {
            let definition=wnodes_p[edge]
            edge=wnext_p[edge]
            if nodes.ptr[definition].kind =? 'call' {fsp_push_act(definition)}
            else {fsp_push_val(definition)}
        }
    }
    if not any_root {
        any_root=true
        let op=opaque_writes.ptr
        let on=opaque_writes.length
        loop wi in [SlicePrepWord(0)..on) {fsp_push_val(op[wi])}
    }
    if not any_exposed and p.declaration not=? 0 and fact_exposed(p) {
        any_exposed=true
        let ep=exposed_writes.ptr
        let en=exposed_writes.length
        loop wi in [SlicePrepWord(0)..en) {
            let write=ep[wi]
            if nodes.ptr[write].kind =? 'call' {fsp_push_act(write)}
            else {fsp_push_val(write)}
        }
    }
    if nodes.ptr[n].aux =? int32(1) {
        let l=SlicePrepWord(nodes.ptr[n].sym)
        if SlicePrepWord(locals.ptr[l].flags) & LF_ALIAS not=? 0 and locals.ptr[l].alias not=? 0 {fsp_push_val(SlicePrepWord(locals.ptr[l].alias))}
    }
    if refine_active and not seen_root {
        fact_slice_local_writers(ntype(n) writers)
        # (a local's declared type, as a generator loop's element's, may carry one too)
        if nodes.ptr[n].aux =? int32(1) {fact_slice_local_writers(SlicePrepWord(locals.ptr[SlicePrepWord(nodes.ptr[n].sym)].type) writers)}
    }
    int64(any_root) | (int64(any_exposed) << 1)
}

fsp_l2_call=(n:SlicePrepWord):>void=>$unsafe {
    let nk=SlicePrepWord(nodes.ptr[n].nlist)
    let l0=SlicePrepWord(nodes.ptr[n].list)
    let callee=SlicePrepWord(nodes.ptr[n].sym)
    let direct=nodes.ptr[n].aux =? 0 and callee >? 0
    let lib_sp=direct and fact_fn_in_lib(callee) and fsp_is_lib_sp(n callee)
    let push_summary_args=false
    # (a generator whose element contract names the callee's parameters: the loop
    # over it relates each element to the arguments, fact_generator_call)
    if direct and refine_active and tkind(prune(SlicePrepWord(fns.ptr[callee].ret))) =? 'generator' and fact_type_names_formals(SlicePrepWord(fns.ptr[callee].ret)) {fsp_push_children_val(n)}
    if direct and not lib_sp {
        if nk =? 1 and fact_nd_call(n) not=? 0 or ntype(n) =? T_BOOL and fact_predicate_summary(callee) not=? 0 {
            loop j in [SlicePrepWord(0)..nk) {fsp_push_val(SlicePrepWord(lists.ptr[l0 + j]))}
        } else if not result_active and not proof_active and (fact_divisors.length =? 0 or not fact_divisors.has(n)) and not ref_refined_result(SlicePrepWord(fns.ptr[callee].ret)) {
            push_summary_args=true
        } else {fsp_push_children_val(n)}
    } else if fact_nd_call(n) not=? 0 or ntype(n) =? T_BOOL and direct and fact_predicate_summary(callee) not=? 0 or fact_regex_call(n) or fact_integer_gcd_call(n) {
        loop j in [SlicePrepWord(0)..nk) {fsp_push_val(SlicePrepWord(lists.ptr[l0 + j]))}
    } else if fact_map_snapshot_call(n) or fact_copy_length_call(n) or fact_endpoint_call(n) not=? 0 or fact_same_length_call(n) or fact_chosen_call(n) {
        fsp_push_val(SlicePrepWord(lists.ptr[l0]))
    } else if direct and not result_active and not proof_active and (fact_divisors.length =? 0 or not fact_divisors.has(n)) and (not fact_fn_in_lib(callee) or (not fact_rational_constructor(n) and not fact_rational_promotion(n) and not fact_rational_divmod(n) and fact_floor_call(n) =? 0 and fact_string_call(n) =? 0 and not fact_extremum_call(n) and not fact_mod_call(n) and not fact_empty_array_call(n) and not fact_entry_count_call(n) and not fact_split_call(n) and not fact_words_call(n) and not fact_lines_call(n) and not fact_search_call(n) and not fact_affix_call(n) and not fact_parallel_array(n))) and not ref_refined_result(SlicePrepWord(fns.ptr[callee].ret)) {
        push_summary_args=true
    } else {fsp_push_children_val(n)}
    if push_summary_args {
        let ret=fact_type(SlicePrepWord(fns.ptr[callee].ret))
        let constructor=(types.ptr[ret].kind =? 'struct_' or types.ptr[ret].kind =? 'tuple') and fact_constructor_type(ret) and fact_constructor_body(callee)
        if constructor {fact_constructor_calls[n]=true}
        let array_result=tkind(ret) =? 'array' or constructor
        if array_result or fact_scalar(ret) and is_int(ret) and ret not=? T_U64 or fact_summary_payload(ret) not=? 0 {
            loop j in [SlicePrepWord(0)..nk) {
                let arg=SlicePrepWord(lists.ptr[l0 + j])
                let at=fact_type(ntype(arg))
                let atk=tkind(at)
                if atk =? 'array' or atk =? 'fixed' or array_result and fact_scalar(at) and is_int(at) and at not=? T_U64 {fsp_push_val(arg)}
                else if not array_result and fact_record_arrays(at) {fsp_push_val(arg)}
            }
        }
    }
}

fsp_l2_intrinsic=(n:SlicePrepWord):>void=>$unsafe {
    let aux=nodes.ptr[n].aux
    let l0=SlicePrepWord(nodes.ptr[n].list)
    if aux =? int32(int64(IN.remove)) or aux =? int32(int64(IN.extend)) or aux =? int32(int64(IN.truncate)) or aux =? int32(int64(IN.resize)) or aux =? int32(int64(IN.setlen)) {
        fsp_push_val(SlicePrepWord(lists.ptr[l0]))
        fsp_push_val(SlicePrepWord(lists.ptr[l0 + 1]))
    } else if aux =? int32(int64(IN.push)) or aux =? int32(int64(IN.pop)) or aux =? int32(int64(IN.clear)) or aux =? int32(int64(IN.reserve)) or aux =? int32(int64(IN.insert)) {
        let a0=SlicePrepWord(lists.ptr[l0])
        fsp_push_val(a0)
        if aux =? int32(int64(IN.push)) and nodes.ptr[n].nlist =? int32(2) {
            let a1=SlicePrepWord(lists.ptr[l0 + 1])
            let t1=ntype(a1)
            if tkind(fact_type(t1)) =? 'array' {fsp_push_val(a1)}
            if fsp_has_mark(@fsp_acc_gen fact_push_receiver(a0)) and (fact_scalar(t1) and is_int(t1) or fact_int_components(fact_type(t1)) >? 0) {fsp_push_val(a1)}
        }
    } else {fsp_push_children_val(n)}
}

fact_slice_prepare_fast=(f:SlicePrepWord summary:bool=false):>void=>$unsafe {
    if member_compact_owners.length not=? 0 and (not fact_member_shared or summary or fact_probe_on or fact_query or f not=? fact_member_owner) {
        member_expand_owner(f)
    }
    let key:SlicePrepWord=(f << 4) | int64(summary) | (int64(fact_probe_on) << 1) | (int64(fact_policy =? 'RequireStatic') << 2) | (int64(result_active or proof_active) << 3)
    let cached0=fact_slice_cache.get(key)
    if cached0 not=? none {fact_slice=cached0; return}
    let share=not summary and fact_policy =? 'RequireStatic'
    let peer:SlicePrepWord=key xor 2
    if share {
        let cached1=fact_slice_cache.get(peer)
        if cached1 not=? none {
            if not cached1.probe_only and fact_plan_current(cached1) {
                fact_slice=cached1
                fact_slice_cache[key]=cached1
                return
            }
        }
    }
    fact_mark_begin()
    fsp_wr_reset()
    fsp_in_prepare=true
    fsp_mt_h=fsp_init_i32(@fsp_mark_touched 256)
    fsp_wk_h=fsp_init_i64(@fsp_work 256)
    fsp_pn_h=fsp_init_i64(@fsp_pnodes 256)
    fsp_px_h=fsp_init_i64(@fsp_pnext 256)
    fsp_val_h=fsp_init_i64(@fsp_values 256)
    fsp_act_h=fsp_init_i64(@fsp_active 256)
    let wnodes=fsp_wnodes; fsp_wnodes=[]; wnodes.clear()
    let wnext=fsp_wnext; fsp_wnext=[]; wnext.clear()
    let writers=FactSliceEdges([] wnodes wnext)
    let roots:array<int64>=[]
    let exposed_writes=fsp_exposed; fsp_exposed=[]; exposed_writes.clear()
    let opaque_writes=fsp_opaque; fsp_opaque=[]; opaque_writes.clear()
    let body=SlicePrepWord(fns.ptr[f].body)
    fsp_wk_h[1]=1
    let wkd0=(fsp_wk_h + 3) as ptr<int64>
    wkd0[0]=body
    let forks=fsp_forks; fsp_forks=[]; forks.clear()
    # (closures whose bodies its facts seed: fact_seed_lambdas)
    let seeded=fact_seed_lambdas.get(f)
    if seeded not=? none {
        loop lam in seeded {
            fact_fork_nodes[lam]=true
            forks.push(lam)
        }
    }
    let callees:array<int64>=[]
    let versions:array<int64>=[]
    let exact_demands:array<int64>=[]
    let index_demands:array<int64>=[]
    let loop_indexes:array<int64>=[]
    let carried=false
    let rows=false
    let probe_only=false
    let members=fact_member_shared and f =? fact_member_owner and not summary
    let exact=not summary and exact_marks.length >? 0 and exact_owners.has(f)
    let representation=exact and f <? exact_rep_owners.length and exact_rep_owners.ptr[f]
    let demand_static=not summary and (fact_probe_on or fact_policy =? 'RequireStatic')
    let has_own=ownership_decls.length not=? 0 or ownership_fact_cleanup
    let has_nd_mut=nd_mutable_signatures.length not=? 0
    if summary or result_active {fsp_push_val(body)}
    if summary {
        loop l in fns.ptr[f].params {
            let lt=SlicePrepWord(locals.ptr[l].type)
            if SlicePrepWord(locals.ptr[l].flags) & LF_MUTPARAM not=? 0 and (tkind(fact_type(lt)) =? 'array' or is_nd(fact_type(lt)) or fact_record_arrays(fact_type(lt))) {
                fsp_push_val(mk_ident_local(l locals.ptr[l].pos))
            }
        }
    }
    let collect_panic=not summary and not members and not fact_panic_sites.has(f)
    let psites:array<int64>=[]
    let mstamp=mark_stamp_p
    let mflags=mark_flags_p
    let mhead=mark_head_p
    let mgen=mark_gen
    let cursor:SlicePrepWord=0
    loop cursor <? fsp_wk_h[1] {
        let n:SlicePrepWord=((fsp_wk_h + 3) as ptr<int64>)[cursor]; cursor += 1
        if n =? 0 {continue}
        if mstamp[n] =? mgen {
            if SlicePrepWord(mflags[n]) & FACT_MEMBER not=? 0 {continue}
            mflags[n]=uint8(FACT_MEMBER)
        } else {
            mstamp[n]=mgen
            mhead[n]=int32(-1)
            fsp_push_mt(n)
            mflags[n]=uint8(FACT_MEMBER)
        }
        let k=nodes.ptr[n].kind
        if exact {
            if fact_exact_demand(n) {
                fsp_push_val(n)
                if share {exact_demands.push(n)}
            } else if representation and n <? exact_rep_demands.length and exact_rep_demands.ptr[n] {fsp_push_val(n)}
        }
        let mask:SlicePrepWord=int64(iso_child_p[int64(((nodes.ptr + n) as ptr<uint32>)[0])])
        if k =? 'parallel_region' {
            collect_panic=false
            if dir_assumed_bounds_any {
                let ca=SlicePrepWord(nodes.ptr[n].a)
                if ca not=? 0 {fsp_visit_child(ca n)}
            }
        }
        if mask >? 0 {
            if mask & 1 not=? 0 {
                let ca=SlicePrepWord(nodes.ptr[n].a)
                if ca not=? 0 {fsp_visit_child(ca n)}
            }
            if mask & 2 not=? 0 {
                let cb=SlicePrepWord(nodes.ptr[n].b)
                if cb not=? 0 {fsp_visit_child(cb n)}
            }
            if mask & 4 not=? 0 {
                let cc=SlicePrepWord(nodes.ptr[n].c)
                if cc not=? 0 {fsp_visit_child(cc n)}
            }
            if mask & 16 not=? 0 {
                let walk:SlicePrepWord=SlicePrepWord(nodes.ptr[n].nlist)
                if members and k =? 'block' and walk >? 1 and fact_member_admit(n) {walk=1}
                let l0:SlicePrepWord=SlicePrepWord(nodes.ptr[n].list)
                loop i in [SlicePrepWord(0)..walk) {
                    let ci=SlicePrepWord(lists.ptr[l0 + i])
                    if ci not=? 0 {fsp_visit_child(ci n)}
                }
            }
        }
        match k {
            <'block'> => {
                if has_flag(n NF_COMPREHENSION) and nodes.ptr[n].nlist >? 0 {
                    let c0=SlicePrepWord(lists.ptr[SlicePrepWord(nodes.ptr[n].list)])
                    if nodes.ptr[c0].kind =? 'vardecl' {fsp_set_mark(@fsp_acc_gen SlicePrepWord(nodes.ptr[c0].sym))}
                }
            }
            <'vardecl'> => {fsp_l1_vardecl(n @writers has_own)}
            <'assign'> => {
                if fsp_l1_assign(n f @writers @exposed_writes @opaque_writes demand_static) {carried=true}
            }
            <'for_'> => {
                if nodes.ptr[n].aux =? int32(5) {opaque_writes.push(n)}
                let l=SlicePrepWord(nodes.ptr[n].sym)
                if l >? 0 {fact_slice_writer(@writers PlaceIdentity('local' SlicePrepWord(locals.ptr[l].owner) l) n)}
                if nodes.ptr[n].aux =? int32(3) and nodes.ptr[n].aux2 >? 0 {
                    let vl=SlicePrepWord(nodes.ptr[n].aux2)
                    fact_slice_writer(@writers PlaceIdentity('local' SlicePrepWord(locals.ptr[vl].owner) vl) n)
                }
                if demand_static and (fact_stepped_loop(n) or fact_open_range(n)) {fsp_push_val(n)}
            }
            <'iflet'|'match_'> => {
                let l=SlicePrepWord(nodes.ptr[n].sym)
                if l >? 0 {fact_slice_writer(@writers PlaceIdentity('local' SlicePrepWord(locals.ptr[l].owner) l) n)}
            }
            <'while_'> => {fsp_push_act(n)}
            <'if_'|'and_'|'or_'|'coalesce'> => {}
            <'return_'> => {
                fsp_push_act(n)
                if summary or result_active {fsp_push_val(SlicePrepWord(nodes.ptr[n].a))}
            }
            <'break_'|'continue_'|'defer_'> => {fsp_push_act(n)}
            <'call'> => {
                let cflags:SlicePrepWord=int64(demand_static) | (int64(summary) << 1) | (int64(share) << 2) | (int64(has_nd_mut) << 3) | (int64(has_own) << 4) | (int64(collect_panic) << 5)
                if fsp_l1_call(n f cflags @writers @exposed_writes @forks @callees @versions @psites) {probe_only=true}
            }
            <'intrinsic'> => {
                let iflags:SlicePrepWord=int64(collect_panic) | (int64(summary) << 1) | (int64(rows) << 2)
                if fsp_l1_intrinsic(n iflags @writers @exposed_writes @opaque_writes @psites) {rows=true}
            }
            <'index'> => {
                if demand_static and not has_flag(n NF_INBOUNDS) and fact_bounded_index(n) {
                    if share {index_demands.push(n)}
                    if fact_loop_index_local(n) >? 0 {loop_indexes.push(n)}
                    fsp_push_act(n)
                    fsp_push_val(SlicePrepWord(nodes.ptr[n].b))
                    let a=SlicePrepWord(nodes.ptr[n].a)
                    if types.ptr[fact_type(ntype(a))].kind not=? 'fixed' {fsp_push_val(a)}
                }
            }
            <'conv'> => {
                if ff_integer_demand(n) {fsp_push_val(n)}
                let aux=nodes.ptr[n].aux
                if aux =? int32(int64(CV.refinement)) or aux =? int32(int64(CV.arr2fixed)) {fsp_push_val(n)}
                else if demand_static and aux =? int32(int64(CV.int_)) and prune(ntype(SlicePrepWord(nodes.ptr[n].a))) =? T_MATH_INT and prune(ntype(n)) not=? T_MATH_INT {fsp_push_val(n)}
                else if has_own and aux =? int32(int64(CV.explicit_copy)) and ownership_fact_type(ntype(n)) {opaque_writes.push(n)}
                else if aux not=? int32(int64(CV.int_)) and aux not=? int32(int64(CV.none_)) and aux not=? int32(int64(CV.fixed2arr)) and not fact_pure_conversion(n) {exposed_writes.push(n)}
            }
            <'binary'> => {
                if nodes.ptr[n].aux not=? 0 {
                    if collect_panic and nodes.ptr[n].aux =? 1 {psites.push(n)}
                    if not fact_pure_binary(n) {exposed_writes.push(n)}
                }
                else if demand_static {
                    let tok=cx_token_values.ptr[SlicePrepWord(nodes.ptr[n].op)]
                    if tok =? 'slash' or tok =? 'percent' or fact_shift_obliged(n) {fsp_push_val(n)}
                }
            }
            <'lambda'> => {
                if collect_panic {psites.push(n)}
                if has_own {opaque_writes.push(n)}
            }
            <'partial'> => {
                if collect_panic {psites.push(n)}
                if fact_partial_opaque(n) {opaque_writes.push(n)}
            }
            <'fnref'> => {
                if collect_panic {psites.push(n)}
                if fact_handle_opaque(n) {opaque_writes.push(n)}
            }
            <'pair'> => {
                if collect_panic {psites.push(n)}
            }
            <'map_lit'> => {opaque_writes.push(n)}
            <'cast'> => {
                if not fact_enum_cast(n) and not fact_pointer_cast(n) {opaque_writes.push(n)}
            }
            <'str_lit'> => {
                if nodes.ptr[n].aux not=? 0 {exposed_writes.push(n)}
            }
            _ => {
                if mask <? 0 {opaque_writes.push(n)}
            }
        }
        if not summary and has_nd_mut and nd_mutable_handle(n) {fsp_push_val(n)}
    }
    if collect_panic {fact_panic_sites[f]=psites}
    loop lam in forks {
        fsp_push_val(lam)
        loop cap_ in fns.ptr[SlicePrepWord(nodes.ptr[lam].sym)].caps {
            let o=SlicePrepWord(cap_.outer)
            if o <=? 0 {continue}
            let rkey=fact_root_key(PlaceIdentity('local' SlicePrepWord(locals.ptr[o].owner) o))
            let edge=if rkey >=? 0 and rkey <? 262144 {fsp_wr_get(rkey)} else {fact_index_get_raw(writers.heads.ptr writers.heads.length rkey)}
            loop edge >=? 0 {
                let definition=writers.nodes.ptr[edge]
                edge=writers.next.ptr[edge]
                if nodes.ptr[definition].kind =? 'call' {fsp_push_act(definition)}
                else {fsp_push_val(definition)}
            }
        }
    }
    cursor=0
    let acursor:SlicePrepWord=0
    let id_flags:SlicePrepWord=0
    let pnodes_p=(fsp_pn_h + 3) as ptr<int64>
    let pnext_p=(fsp_px_h + 3) as ptr<int64>
    let wnodes_p=writers.nodes.ptr
    let wnext_p=writers.next.ptr
    loop cursor <? fsp_val_h[1] or acursor <? fsp_act_h[1] {
        if acursor <? fsp_act_h[1] {
            let n:SlicePrepWord=((fsp_act_h + 3) as ptr<int64>)[acursor]; acursor += 1
            if n =? 0 {continue}
            let mark:SlicePrepWord=if mstamp[n] =? mgen {SlicePrepWord(mflags[n])} else {0}
            if mark & FACT_ACTIVE not=? 0 {continue}
            if mstamp[n] not=? mgen {
                mstamp[n]=mgen
                mhead[n]=int32(-1)
                fsp_push_mt(n)
            }
            mflags[n]=uint8<overflow='wrap'>(mark | FACT_ACTIVE)
            let edge:SlicePrepWord=SlicePrepWord(mhead[n])
            loop edge >=? 0 {
                fsp_push_act(pnodes_p[edge])
                edge=pnext_p[edge]
            }
            let k=nodes.ptr[n].kind
            if k =? 'assign' {
                let target=SlicePrepWord(nodes.ptr[n].a)
                if nodes.ptr[target].kind =? 'ident' and nodes.ptr[target].aux =? int32(1) {
                    let l=SlicePrepWord(nodes.ptr[target].sym)
                    if SlicePrepWord(locals.ptr[l].flags) & LF_ALIAS not=? 0 {fsp_push_val(target)}
                }
            }
            if k =? 'if_' or k =? 'while_' or k =? 'for_' or k =? 'iflet' or k =? 'match_' or k =? 'and_' or k =? 'or_' or k =? 'coalesce' {
                fsp_push_val(SlicePrepWord(nodes.ptr[n].a))
                if k =? 'match_' {
                    let nk=SlicePrepWord(nodes.ptr[n].nlist)
                    let l0=SlicePrepWord(nodes.ptr[n].list)
                    loop j in [SlicePrepWord(0)..nk) {
                        let arm=SlicePrepWord(lists.ptr[l0 + j])
                        let ank=SlicePrepWord(nodes.ptr[arm].nlist)
                        let al0=SlicePrepWord(nodes.ptr[arm].list)
                        loop ki in [SlicePrepWord(0)..ank) {fsp_push_val(SlicePrepWord(lists.ptr[al0 + ki]))}
                    }
                }
            }
            continue
        }
        let n:SlicePrepWord=((fsp_val_h + 3) as ptr<int64>)[cursor]; cursor += 1
        if n =? 0 {continue}
        let mark:SlicePrepWord=if mstamp[n] =? mgen {SlicePrepWord(mflags[n])} else {0}
        if mark & FACT_VALUE not=? 0 {continue}
        if mstamp[n] not=? mgen {
            mstamp[n]=mgen
            mhead[n]=int32(-1)
            fsp_push_mt(n)
        }
        mflags[n]=uint8<overflow='wrap'>(mark | FACT_VALUE)
        fsp_push_act(n)
        let k=nodes.ptr[n].kind
        match k {
            <'ident'> => {id_flags=fsp_l2_ident(n id_flags @writers @roots @exposed_writes @opaque_writes wnodes_p wnext_p)}
            <'block'> => {
                let nk=SlicePrepWord(nodes.ptr[n].nlist)
                if nk >? 0 {fsp_push_val(SlicePrepWord(lists.ptr[SlicePrepWord(nodes.ptr[n].list) + nk - 1]))}
            }
            <'for_'|'while_'> => {fsp_push_val(SlicePrepWord(nodes.ptr[n].a))}
            <'conv'> => {
                if nodes.ptr[n].b not=? 0 and nodes.ptr[n].aux =? int32(int64(CV.refinement)) {
                    fsp_push_val(SlicePrepWord(nodes.ptr[n].a))
                    fsp_push_val(SlicePrepWord(nodes.ptr[n].b))
                } else {fsp_push_children_val(n)}
                if refine_active and nodes.ptr[n].aux =? int32(int64(CV.refinement)) {fact_slice_local_writers(SlicePrepWord(nodes.ptr[n].aux2) writers)}
            }
            <'lambda'|'lazy_'> => {}
            <'call'> => {fsp_l2_call(n)}
            <'intrinsic'> => {fsp_l2_intrinsic(n)}
            _ => {fsp_push_children_val(n)}
        }
    }
    let lo:SlicePrepWord=nodes.length
    let hi:SlicePrepWord=-1
    let count:SlicePrepWord=0
    let touched_p=(fsp_mt_h + 3) as ptr<int32>
    let touched_n=fsp_mt_h[1]
    loop ti in [SlicePrepWord(0)..touched_n) {
        let tn=SlicePrepWord(touched_p[ti])
        if mflags[tn] not=? uint8(0) {
            if tn <? lo {lo=tn}
            if tn >? hi {hi=tn}
            count += 1
        }
    }
    if hi >=? lo and hi - lo <? 4 * count + 64 {
        let flags=fill(int64(0) hi - lo + 1)
        let fp=flags.ptr
        loop ti in [SlicePrepWord(0)..touched_n) {
            let tn=SlicePrepWord(touched_p[ti])
            let fv=SlicePrepWord(mflags[tn])
            if fv not=? 0 {fp[tn - lo]=fv}
        }
        fact_slice=FactSlice(flags probe_only lo carried rows)
        fact_plan_serial += 1
        fact_slice.plan=fact_plan_serial
    } else {
        let flags=fill(int64(0) count)
        let fp=flags.ptr
        let fi:SlicePrepWord=0
        loop ti in [SlicePrepWord(0)..touched_n) {
            let tn=SlicePrepWord(touched_p[ti])
            let fv=SlicePrepWord(mflags[tn])
            if fv not=? 0 {
                fp[fi]=(tn << 8) | fv
                fi += 1
            }
        }
        fact_slice=FactSlice(flags probe_only (-2) carried rows)
        fact_plan_serial += 1
        fact_slice.plan=fact_plan_serial
        fsp_cur_plan=fact_plan_serial
    }
    fact_slice.callees=callees
    fact_slice.versions=versions
    fact_slice.exact_demands=exact_demands
    fact_slice.index_demands=index_demands
    loop m in loop_indexes {
        let x=fact_loop_index_local(m)
        if fsp_has_mark(@fsp_pw_gen x) and not fsp_has_mark(@fsp_sw_gen x) {fact_slice.loop_indexes.push(m)}
    }
    if share {fact_slice.float_context=dir_floats_any or ff_conversions.has(fact_owner)}
    if not members or fact_member_admitted.length =? 0 {fact_slice_cache[key]=fact_slice}
    fsp_exposed=exposed_writes
    fsp_opaque=opaque_writes
    fsp_forks=forks
    fsp_wnodes=writers.nodes
    fsp_wnext=writers.next
    fsp_in_prepare=false
}

from p"facts_values.dewy" import (fact_place fact_scalar fact_type)

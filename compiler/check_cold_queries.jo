# the context of function inst anywhere on the stack of bodies being checked, or -1
ctx_in_progress = (inst: int) -> int:
    c = ctxs.len() - 1
    loop c >= 0:
        if int(ctxs[c].inst) == inst: return c
        c -= 1
    -1
# how many times w appears in src as a whole word
word_count = (src: str, w: str) -> int:
    n = 0
    i = find(src, w)
    loop i >= 0:
        before = i == 0 or not (is_alnum(src[i - 1]) or src[i - 1] == '_')
        e = i + len(w)
        after = e >= len(src) or not (is_alnum(src[e]) or src[e] == '_')
        if before and after and not in_comment(src, i): n += 1
        i = find(src, w, i + 1)
    n
# (a `#` before i on its line, outside quotes)
in_comment = (src: str, i: int) -> bool:
    s = i
    loop s > 0 and src[s - 1] != '\n': s -= 1
    quoted = false
    loop k in [s..i):
        if src[k] == '"': quoted = not quoted
        else if src[k] == '#' and not quoted: return true
    false
# ---------------- compile-time evaluation ----------------
# Coarse evaluator services: checking may re-enter ceval and grow shared arenas.
constant_checked = (e: int) -> CVal:
    checked = e
    if nodes[e].type == 0:
        check_expr(e, 0)
        checked = last_checked
        finalize_literal(checked)
    value = ct_values[ct_run(checked)]
    CVal(tkind(value.type) == .str_, value.i, value.s)

use 'ast.jo'
use 'check.jo'
use 'checker_state.dewy'
use 'checker_tokens.dewy'
use 'node_store.dewy'
use 'expr.jo'
use 'types.jo'
use 'directive_queries.dewy'
use 'directives.jo'
use 'member_replay.jo'

# Preorder finalization sees every occurrence of a checked expression. Only
# a static scalar subscript requests work, keyed by its owning local.
struct FixedIndexRange:
    nonnegative: bool
    limit: int     # exclusive positive upper bound, or zero for unknown
struct FixedIndexUndo:
    local: int
    previous: FixedIndexRange

fi_owners: {int: bool}
fi_requested: {int: bool}
fi_bounds: {int: FixedIndexRange}
fi_undo: FixedIndexUndo[]
fi_marks: int[]
fi_answers: {int: bool}
fi_owner = 0
fi_publish = false

fi_reset = ():
    fi_owners.clear()
    fi_requested.clear()
    fi_answers.clear()
    fi_bounds.clear()
    fi_undo = []
    fi_marks = []
    fi_owner = 0

fi_word = (n: int) -> int:
    if nodes[n].type == i32(T_INT) and nodes[n].kind == .conv and nodes[n].aux == i32(int(CV.int_)):
        a = int(nodes[n].a)
        if nodes[a].type == i32(T_MATH_INT): return a
    n

fi_local = (n: int) -> int:
    if nodes[n].kind != .ident or nodes[n].aux != i32(int(SK.local)): return 0
    if nodes[n].type != i32(T_INT) and nodes[n].type != i32(T_MATH_INT): return 0
    int(nodes[n].sym)

fi_request = (n: int):
    l = fi_local(fi_word(int(nodes[n].b)))
    if l == 0 or cx < 0 or has_flag(n, NF_INBOUNDS): return
    owner = int(ctxs[cx].inst)
    if owner == 0 or fns[owner].kind != i32(FK_NORMAL) or locals[l].owner != i32(owner) or dir_policy(nodes[n].pos) != DIR_STATIC: return
    fi_owners[owner] = true
    fi_requested[l] = true

fi_begin = (owner: int) -> bool:
    if fi_owners.len() == 0 or not fi_owners.has(owner): return false
    fi_owners.remove(owner)
    # Compact reflected bodies can be replayed with different literal columns.
    # Their shared decisions belong to the member-aware facts path.
    if member_compact_owners.has(owner):
        loop l in fns[owner].locals: fi_requested.remove(l)
        return false
    fi_owner = owner
    fi_publish = true
    true

fi_constant = (node: int) -> int:
    n = node
    # Only small nonnegative word constants can delimit the fixed extents.
    if nodes[n].kind == .conv and nodes[n].aux == i32(int(CV.int_)) and nodes[n].type == i32(T_MATH_INT): n = int(nodes[n].a)
    if nodes[n].kind != .int_lit or (nodes[n].type != i32(T_INT) and nodes[n].type != i32(T_MATH_INT)) or has_flag(n, NF_U64): return -1
    v = nodes[n].ival
    if v < 0 or v > 2147483647: return -1
    v

fi_refine = (l: int, lower: bool, limit: int):
    old = fi_bounds.get(l) ?? FixedIndexRange()
    upper = old.limit
    if limit > 0 and (upper == 0 or limit < upper): upper = limit
    if upper == old.limit and (not lower or old.nonnegative): return
    fi_undo.push(FixedIndexUndo(l, old))
    fi_bounds[l] = FixedIndexRange(lower or old.nonnegative, upper)

# A fixed depth cap bounds work per edge even in a long short-circuit chain.
# O(finalizer visits + scoped guard events + index uses) for a demanded body.
fi_guard = (n: int, holds: bool, depth: int):
    if depth == 5: return
    k = nodes[n].kind
    if k == .and_ and holds or k == .or_ and not holds:
        fi_guard(int(nodes[n].a), holds, depth + 1)
        fi_guard(int(nodes[n].b), holds, depth + 1)
        return
    if k != .binary or nodes[n].aux != 0 or nodes[n].type != i32(T_BOOL): return
    if nodes[int(nodes[n].a)].type != nodes[int(nodes[n].b)].type: return
    l = fi_local(int(nodes[n].a))
    if l == 0 or not fi_requested.has(l): return
    v = fi_constant(int(nodes[n].b))
    if v < 0: return
    op = nodes[n].op as Tok
    if op == .lt or op == .ge:
        if holds == (op == .ge): fi_refine(l, true, 0)
        else: fi_refine(l, false, v)
    if op == .le or op == .gt:
        if holds == (op == .gt): fi_refine(l, true, 0)
        else: fi_refine(l, false, v + 1)

fi_exit = (n: int) -> bool:
    b = n
    if nodes[b].kind == .block:
        if nkids(b) == 0: return false
        b = kid(b, nkids(b) - 1)
    k = nodes[b].kind
    k == .return_ or k == .break_ or k == .continue_

fi_scope_end = ():
    mark = fi_marks.pop()
    loop fi_undo.len() > mark:
        u = fi_undo.pop()
        fi_bounds[u.local] = u.previous

# Stack events use the high word. Real nodes are positive signed 32-bit IDs,
# and negative IDs remain the finalizer's existing end-of-loop markers.
const FI_OPEN = 1 << 32
const FI_CLOSE = 2 << 32
const FI_TRUE = 3 << 32
const FI_FALSE = 4 << 32
const FI_RANGE = 5 << 32
fi_event = (event: int):
    tag = event & ~4294967295
    if tag == FI_OPEN: fi_marks.push(fi_undo.len())
    else if tag == FI_CLOSE: fi_scope_end()
    else if tag == FI_RANGE: fi_loop(event & 4294967295)
    else: fi_guard(event & 4294967295, tag == FI_TRUE, 0)

# Checked function templates and closures never contribute guards. Binding
# IDs are unique; an assignment anywhere in the body (including a back edge),
# capture, indirect parameter or exposed address invalidates all its uses.
fi_stable = (l: int) -> bool:
    if l <= 0 or l >= locals.len() or locals[l].owner != i32(fi_owner): return false
    fl = int(locals[l].flags)
    fl & (LF_ASSIGNED | LF_RESIZED | LF_ADDR | LF_MUTPARAM | LF_SHARED | LF_CAPTURE | LF_CAPTURED | LF_BYREF | LF_EXPOSED | LF_ALIAS | LF_ELEMALIAS | LF_SOAELEM | LF_PARTBORROW | LF_OWNERBORROW) == 0

# Compound stores can bind an index once for both the read and the write.
# A scalar snapshot has the source range at entry to this declaration.
fi_declaration = (s: int):
    l = int(nodes[s].sym)
    if has_flag(s, NF_GLOBAL | NF_ALIASDECL) or not fi_stable(l): return
    t = int(locals[l].type)
    if t != T_INT and t != T_MATH_INT: return
    b = int(nodes[s].b)
    if nodes[b].type != i32(t): return
    if nodes[b].kind == .conv and nodes[b].aux == i32(int(CV.int_)) and t == T_MATH_INT and nodes[int(nodes[b].a)].type == i32(T_INT): b = int(nodes[b].a)
    source = fi_local(b)
    if source != 0 and fi_stable(source):
        r = fi_bounds.get(source) ?? FixedIndexRange()
        fi_refine(l, r.nonnegative, r.limit)
    else if fi_requested.has(l) and nodes[b].kind == .binary and nodes[b].op == i32(int(Tok.percent)) and nodes[b].aux == 0 and nodes[b].aux2 == -1:
        divisor = fi_constant(int(nodes[b].b))
        if divisor > 0: fi_refine(l, true, divisor)

fi_index = (n: int):
    if nodes[n].aux != 0 or has_flag(n, NF_INBOUNDS): return
    l = fi_local(fi_word(int(nodes[n].b)))
    proven = false
    if fi_stable(l):
        bt = prune(ntype(int(nodes[n].a)))
        if types[bt].kind == .fixed:
            bound = fi_bounds.get(l) ?? FixedIndexRange()
            proven = bound.nonnegative and bound.limit > 0 and bound.limit <= int(types[bt].bits)
    # A shared child can still have an unsettled type on its first visit.
    # Any unknown incoming visit vetoes publication, even if a later one proves.
    if not proven or not fi_answers.has(n): fi_answers[n] = proven

fi_loop = (s: int):
    it = int(nodes[s].a)
    if nodes[s].aux != 0 or nodes[it].kind != .range or has_flag(it, NF_STEP | NF_INCLUSIVE | NF_EXCL_FIRST): return
    l = int(nodes[s].sym)
    if not fi_requested.has(l) or not fi_stable(l): return
    if locals[l].type != nodes[int(nodes[it].a)].type or locals[l].type != nodes[int(nodes[it].b)].type: return
    if fi_constant(int(nodes[it].a)) < 0: return
    end = fi_constant(int(nodes[it].b))
    if end > 0: fi_refine(l, true, end)

# An embedded function template is finalized in its own instance.
fi_template = (): fi_publish = false

fi_finish = ():
    if fi_publish:
        loop n, proven in fi_answers:
            if proven: add_flag(n, NF_INBOUNDS)
    fi_answers.clear()
    loop l in fns[fi_owner].locals: fi_requested.remove(l)
    fi_scope_end()
    fi_bounds.clear()
    fi_owner = 0

# Replace only ordinary child schedules for which the control edge is known.
# Pushing in reverse keeps zonking and write events in their original order.
fi_children = (n: int, stack: mut int[], start: int) -> int:
    k = nodes[n].kind
    if nodes[n].d != 0 or nodes[n].nlist2 != 0: return -1
    sp = start
    if k == .block:
        if nodes[n].a != 0 or nodes[n].b != 0 or nodes[n].c != 0: return -1
        count = nkids(n)
        if sp + count * 2 + 2 > stack.len(): stack.resize((sp + count * 2 + 2) * 2)
        stack[sp] = FI_CLOSE
        sp += 1
        i = count - 1
        loop i >= 0:
            s = kid(n, i)
            if nodes[s].kind == .if_ and nodes[s].c == 0 and fi_exit(int(nodes[s].b)):
                stack[sp] = FI_FALSE + int(nodes[s].a)
                sp += 1
            if s != 0:
                stack[sp] = s
                sp += 1
            i -= 1
        stack[sp] = FI_OPEN
        return sp + 1
    if nkids(n) != 0: return -1
    a = int(nodes[n].a)
    b = int(nodes[n].b)
    c = int(nodes[n].c)
    if a == 0 or b == 0 or (k != .if_ and c != 0): return -1
    if sp + 9 > stack.len(): stack.resize((sp + 9) * 2)
    if c != 0:
        stack[sp] = FI_CLOSE
        stack[sp + 1] = c
        stack[sp + 2] = FI_FALSE + a
        stack[sp + 3] = FI_OPEN
        sp += 4
    stack[sp] = FI_CLOSE
    stack[sp + 1] = b
    stack[sp + 2] = (if k == .or_: FI_FALSE else: FI_TRUE) + a
    stack[sp + 3] = FI_OPEN
    stack[sp + 4] = a
    sp + 5

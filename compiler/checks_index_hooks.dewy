$runtime_checks
from p"ast.jo" import (NF_CHECKED NF_INCLUSIVE NF_MUT add_flag clone has_flag kids mk nkids nodes set_list)
from p"check.jo" import (dewy_at jd pool_update_read)
from p"checker_expr.dewy" import (check_expr)
from p"errors.jo" import (exception_member)
from p"expr.jo" import (bc_count concat_piece dewy_array_selection_call dewy_array_slice dewy_end_arithmetic dewy_end_substitute dewy_index_end_bindings dewy_index_ranges expr_as_type is_dewy_range_type is_nd is_part_index last_checked neg_index_check part_spec struct_ctor)
from p"checks_builders.dewy" import (bc_block bc_call bc_ident bc_let bc_stmt)
from p"ide.jo" import (ide_on never_cascade)
from p"types.jo" import (T_NONE dt is_union mk_typeval prune structs telem tkind types union_members)
from p"util.jo" import (fatal intern name_of)

IndexHookWord:type=int64<overflow='wrap'>
# The receiver prelude of `x[i]` runs in checker_receivers.dewy; these are its services.
# (`end` in the brackets: the receiver's length, read where it is written or bound once)
index_end=(n:int64 expected:int64):>int64=>$unsafe {
    let pos=nodes.ptr[n].pos
    let name="$index_source{bc_count}"
    bc_count += 1
    let source=IndexHookWord(nodes.ptr[n].a)
    let source_type=prune(check_expr(clone(source) 0))
    let source_kind=types.ptr[source_type].kind
    let stable=(source_kind =? 'array' or source_kind =? 'str_' or source_kind =? 'fixed') and pool_update_read(last_checked) and dewy_end_arithmetic(IndexHookWord(nodes.ptr[n].b) IndexHookWord(nodes.ptr[n].sval))
    if stable and not ide_on {
        # A stable receiver's length can be read where `end` is written:
        # `xs[end]` is then exactly `xs[xs.length - 1]`, with no binding.
        # (The editor keeps the binding so that `end` hovers as a name.)
        let end_names:array<int64>=[int64(nodes.ptr[n].sval)]
        let end_base=name_of(IndexHookWord(nodes.ptr[n].sval))
        loop axis in [1..max(nkids(n) 1)) {end_names.push(intern("{end_base}_{axis}"))}
        nodes.ptr[n].sval=0
        dewy_end_substitute(IndexHookWord(nodes.ptr[n].b) end_names source pos)
        loop x in kids(n) {
            if x not=? IndexHookWord(nodes.ptr[n].b) {dewy_end_substitute(x end_names source pos)}
        }
        return check_expr(n expected)
    }
    let stmts:array<int64>=[]
    let end_source=clone(source)
    if not stable {
        stmts.push(bc_let(name source pos))
        end_source=bc_ident(name pos)
        nodes.ptr[n].a=int32(bc_ident(name pos))
    }
    loop binding in dewy_index_end_bindings(n end_source source_type) {stmts.push(binding)}
    nodes.ptr[n].sval=0
    let ix=nodes.length
    nodes.push(nodes.ptr[n])
    stmts.push(bc_stmt(ix pos))
    nodes.ptr[n]=nodes.ptr[bc_block(stmts pos)]
    check_expr(n expected)
}
index_ranges=(n:int64 bt:int64):>void=>{
    dewy_index_ranges(n bt)
    return
}
index_stepped=(n:int64 bt:int64 expected:int64):>int64=>$unsafe {
    let bk=types.ptr[bt].kind
    if bk not=? 'array' and bk not=? 'fixed' and not is_nd(bt) {fatal(nodes.ptr[n].pos "stepped slicing requires an array")}
    nodes.ptr[n].a=int32(last_checked)
    let call=dewy_array_slice(n)
    nodes.ptr[n]=nodes.ptr[call]
    check_expr(n expected)
}
index_text=(n:int64 expected:int64):>int64=>$unsafe {
    let b=IndexHookWord(nodes.ptr[n].b)
    let base=last_checked
    add_flag(base NF_CHECKED)
    let pos=nodes.ptr[n].pos
    let call:IndexHookWord=0
    if b not=? 0 and nodes.ptr[b].kind =? 'range' {
        let lo=IndexHookWord(nodes.ptr[b].a)
        let hi=IndexHookWord(nodes.ptr[b].b)
        let has_stop=hi not=? 0
        if lo =? 0 {lo=mk('int_lit' pos)}
        if hi =? 0 {hi=mk('int_lit' pos)}
        let incl=mk('bool_lit' pos)
        nodes.ptr[incl].ival=if has_flag(b NF_INCLUSIVE) {1} else {0}
        let stop=mk('bool_lit' pos)
        nodes.ptr[stop].ival=if has_stop {1} else {0}
        call=bc_call("__dewy_string_slice" [base lo hi incl stop] pos)
    }
    else {
        if b =? 0 {fatal(pos "invalid string index")}
        call=bc_call("__dewy_string_index" [base b] pos)
    }
    nodes.ptr[n]=nodes.ptr[call]
    check_expr(n expected)
}
receiver_error=(n:int64 bt:int64 code:int64):>void=>$unsafe {
    fatal(nodes.ptr[n].pos "a set has no positions to index (`d.keys` is a set): `[{concat_piece(last_checked false)}...]` collects its members into an array, and `in?` tests membership")
}
# Indexing runs in checker_indexes.dewy; these are its services.
# (`Point[3 4]` in Dewy: checking a qualified type replaces its field node with a
# resolved identifier; use that resolved type rather than looking up its bare name
# again in the caller's module)
index_construct=(n:int64 bt:int64 expected:int64):>int64=>$unsafe {
    let target=prune(telem(bt))
    nodes.ptr[n].kind='call'
    nodes.ptr[n].b=0
    if target not=? 0 and types.ptr[target].kind =? 'struct_' {
        let t=struct_ctor(n target IndexHookWord(structs.ptr[IndexHookWord(types.ptr[target].st)].decl) kids(n) expected)
        nodes.ptr[n].type=int32(t)
        add_flag(n NF_CHECKED)
        last_checked=n
        return t
    }
    check_expr(n expected)
}
index_type_value=(n:int64):>int64=>{
    mk_typeval(expr_as_type(n))
}
# m[i, ..], m[1..2, 0..]: a part of an n-dimensional array
index_part=(n:int64 bt:int64 expected:int64):>int64=>$unsafe {
    if not is_part_index(n bt) {return -1}
    let call=bc_call("__nd_slice" [IndexHookWord(nodes.ptr[n].a) part_spec(n)] nodes.ptr[n].pos)
    add_flag(IndexHookWord(nodes.ptr[n].a) NF_CHECKED)
    nodes.ptr[n]=nodes.ptr[call]
    let t=check_expr(n expected)
    last_checked=n
    t
}
index_negative=(b:int64):>void=>{
    neg_index_check(b)
    return
}
# m[i] and m[i, j] of a record: its `[]` operator
index_operator=(n:int64 b:int64 expected:int64):>int64=>$unsafe {
    let call=mk('call' nodes.ptr[n].pos)
    let callee=mk('ident' nodes.ptr[n].pos)
    nodes.ptr[callee].name=int32(intern("[]"))
    nodes.ptr[call].a=int32(callee)
    add_flag(IndexHookWord(nodes.ptr[n].a) NF_CHECKED)
    if b =? 0 {set_list(call [IndexHookWord(nodes.ptr[n].a) kids(n)...])} else {set_list(call [IndexHookWord(nodes.ptr[n].a) b])}
    if has_flag(n NF_MUT) {add_flag(call NF_MUT)}
    nodes.ptr[n]=nodes.ptr[call]
    let t=check_expr(n expected)
    last_checked=n
    t
}
index_int_range=(t:int64):>bool=>{
    is_dewy_range_type(t "IntRange")
}
# xs[mask], xs[idxs]: the elements picked, as an array
index_select=(n:int64 b:int64 bt:int64 kind:int64 expected:int64):>int64=>$unsafe {
    let pick="__pick"
    if kind =? 2 {pick="__pick_mask"}
    if kind =? 3 {pick="__pick_indices"}
    let call=dewy_array_selection_call(pick [IndexHookWord(nodes.ptr[n].a) b] bt nodes.ptr[n].pos)
    add_flag(IndexHookWord(nodes.ptr[n].a) NF_CHECKED)
    nodes.ptr[n]=nodes.ptr[call]
    let t=check_expr(n expected)
    last_checked=n
    t
}
index_error=(n:int64 code:int64 bt:int64):>void=>$unsafe {
    if code =? 1 {fatal(nodes.ptr[n].pos jd(nodes.ptr[n].pos "an array of indexes is int[], or a mask bool[] (found {dt(bt)})" "an array of indexes is array<int64>, or a mask array<bool> (found {dt(bt)})"))}
    if code =? 2 {fatal(nodes.ptr[n].pos "cannot slice {dt(bt)}")}
    if code =? 3 {fatal(nodes.ptr[n].pos "invalid index")}
    if code =? 4 {fatal(nodes.ptr[n].pos "index {nodes.ptr[n].ival} is out of bounds for {dt(bt)}")}
    if tkind(bt) =? 'tuple' {fatal(nodes.ptr[n].pos "a tuple's parts are `t.0`, `t.1` (an index in brackets is for arrays)")}
    if tkind(bt) =? 'opt' and dewy_at(nodes.ptr[n].pos) {
        fatal(nodes.ptr[n].pos "cannot index a value of type {dt(bt)}: it may be none (a member read through an optional is optional too). Check the value first, `if x isnt? none \{ ... }`, which narrows x inside, or give a fallback, `(x ?? default)[i]`")
    }
    if is_union(bt) and dewy_at(nodes.ptr[n].pos) {
        loop m in union_members(bt) {
            if m not=? T_NONE and exception_member(m) {fatal(nodes.ptr[n].pos "cannot index a value of type {dt(bt)}: it may be {dt(m)} (a member read through it forwards {dt(m)} too). Check the value first, `if x isnt? {dt(m)} \{ ... }`, which narrows x inside")}
        }
    }
    never_cascade(nodes.ptr[n].pos bt)
    fatal(nodes.ptr[n].pos "cannot index a value of type {dt(bt)}")
}

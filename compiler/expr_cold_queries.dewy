$runtime_checks
from p"@lib/core/str.jo" import (is_alpha is_digit)
from p"ast.jo" import (NF_LANG_BODY NF_LOOPCOUNT has_flag lambda_captures nodes)
from p"check.jo" import (check_struct_fields fns intersection_parts locals)
from p"refine.jo" import (str_set_of str_sets)
from p"type_ops.dewy" import (dt)
from p"types.jo" import (is_union prune structs tkind types)
from p"util.jo" import (files name_of pos_file pos_off)

ExprQueryWord:type=int64<overflow='wrap'>
# is record `to` an operand of intersection `from` (or of one of its operands)?
intersection_within=(from_:ExprQueryWord to:ExprQueryWord):>bool=>$unsafe {
    if not structs.ptr[ExprQueryWord(types.ptr[from_].st)].resolved {check_struct_fields(ExprQueryWord(types.ptr[from_].st))}
    loop part in (intersection_parts.get(from_) ?? []) {
        if part =? to or intersection_within(part to) {return true}
    }
    false
}
# A Dewy closure's capture of a name its `$capture` list does not mention.
implicit_capture=(l:ExprQueryWord):>bool=>$unsafe {
    let d=ExprQueryWord(fns.ptr[ExprQueryWord(locals.ptr[l].owner)].decl)
    if d =? 0 or not files[pos_file(nodes.ptr[d].pos)].is_dewy or has_flag(d NF_LANG_BODY) {return false}
    loop cap in lambda_captures(d) {
        if nodes.ptr[cap].name =? locals.ptr[l].name {return false}
    }
    true
}
src_char=(p:ExprQueryWord):>uint8=>{
    let f=pos_file(p)
    if p <=? 0 or f <? 0 or f >=? files.length {return 0}
    let o=pos_off(p)
    if o >=? (files[f].src as array<uint8>).length {return 0}
    (files[f].src as array<uint8>)[o]
}
# `T.name` (decisions.md, batch 7): a type's canonical short name, "" when it has none. A
# declared record or a generic one's instance is its declaration's name (`Closed<Job>` is
# `Closed`; the module is not part of it); an alias of a named type is that type's; a builtin is
# its spelling; a text literal is its text when that is a name. Anonymous records and unions
# have none.
type_short_name=(t0:ExprQueryWord):>string=>$unsafe {
    let t=prune(t0)
    if is_union(t) {return ""}
    let text=""
    if tkind(t) =? 'struct_' or tkind(t) =? 'enum_' {
        let d=ExprQueryWord(structs.ptr[ExprQueryWord(types.ptr[t].st)].decl)
        if d not=? 0 and nodes.ptr[d].name not=? 0 {text=name_of(ExprQueryWord(nodes.ptr[d].name))}
    }
    else {
        let set=str_set_of(t)
        if set not=? 0 {
            if str_sets[set].length =? 1 {text=str_sets[set].sorted()[0]}
        }
        else {text=dt(t)}
    }
    if (text as array<uint8>).length =? 0 or not is_alpha((text as array<uint8>)[0]) {return ""}
    loop i in [0..(text as array<uint8>).length) {
        if not is_alpha((text as array<uint8>)[i]) and not is_digit((text as array<uint8>)[i]) {return ""}
    }
    text
}

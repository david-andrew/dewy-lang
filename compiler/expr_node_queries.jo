grouped_place_call = (n: int) -> bool: place_grouped_call(n)
# (does a function of this name take a t first: `.length` of a type that has no len has none;
# fn_names_for's names are any that might)
receiver_fits = (name: str, t0: int) -> bool:
    t = prune(t0)
    if has_var(t): return true
    k = tkind(t)
    loop it in intrinsics:
        if it.name == name and (not it.arr or k == .array or k == .fixed or k == .str_): return true
    nm = intern(name)
    demand_name(nm)
    tables = [modules[cur_mod()].names, prelude]
    loop tm in method_modules(t):
        if tm != cur_mod(): tables.push(modules[tm].names)
    loop tbl in tables:
        s = tbl.get(nm) ?? 0
        loop s != 0:
            if syms[s].kind == .fns and syms[s].decl != 0 and nkids(int(syms[s].decl)) > 0:
                sig = fn_sig(int(syms[s].decl))
                if sig.params.len() > 0:
                    rb = fill(0, int(sig.ntp))
                    if match_type(sig.params[0], t, rb, 0) >= 0: return true
            s = int(syms[s].next)
    false
fn_names_for = (t: int) -> int[]:
    out = method_names(t)
    tk = types[t].kind
    loop it in intrinsics:
        if it.arr == (tk == .array or tk == .str_): out.push(intern(it.name))
    out
is_quat = (e: int) -> bool:
    if quat_nodes.has(e): return true
    if nodes[e].kind != .ident: return false
    if nodes[e].aux == i32(int(SK.local)): return quat_locals.has(int(nodes[e].sym))
    nodes[e].aux == i32(int(SK.global)) and quat_globals.has(int(nodes[e].sym))

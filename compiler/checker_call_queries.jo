# Frozen call-checker queries extracted from expr.jo's intrinsic_of and ctx_dependent.
use 'node_store.dewy'
use 'source_types.dewy'
use 'checker_state.dewy'
struct CheckerCallQueryHost:
    order: (int, int[], int[]) -> void
    overlap: (int[], int, int) -> void
    float_key: (int) -> void
    habit: (int, int, int[]) -> void
struct CheckerCallQueryInput:
    nodes: *(Node[])
    lists: *(i32[])
    files: *(SrcFile[])
    intrinsic_names: *(int[])
    set_name: *(int)
    fns: *(FnInst[])
    float_key_names: *(int[])
    host: *(CheckerCallQueryHost)
    syms: *(Sym[])
    names: *(str[])
    prelude_syms: *(int[])
    name_first: *(int[])
    name_mod: *(int[])
    name_sym: *(int[])
    name_next: *(int[])
    habit_names: *(int[])
cg_nodes: *(Node[])
cg_lists: *(i32[])
cg_files: *(SrcFile[])
cg_intrinsic_names: *(int[])
cg_set_name: *(int)
cg_fns: *(FnInst[])
cg_float_key_names: *(int[])
cg_host: *(CheckerCallQueryHost)
cg_syms: *(Sym[])
cg_names: *(str[])
cg_prelude_syms: *(int[])
cg_name_first: *(int[])
cg_name_mod: *(int[])
cg_name_sym: *(int[])
cg_name_next: *(int[])
cg_habit_names: *(int[])
checker_call_queries_bind = (input: *CheckerCallQueryInput) -> int:
    cg_nodes = input[0].nodes
    cg_lists = input[0].lists
    cg_files = input[0].files
    cg_intrinsic_names = input[0].intrinsic_names
    cg_set_name = input[0].set_name
    cg_fns = input[0].fns
    cg_float_key_names = input[0].float_key_names
    cg_host = input[0].host
    cg_syms = input[0].syms
    cg_names = input[0].names
    cg_prelude_syms = input[0].prelude_syms
    cg_name_first = input[0].name_first
    cg_name_mod = input[0].name_mod
    cg_name_sym = input[0].name_sym
    cg_name_next = input[0].name_next
    cg_habit_names = input[0].habit_names
    0
intrinsic_of = (name: int) -> int:
    if name >= 0 and name < cg_intrinsic_names[0].len(): return cg_intrinsic_names[0][name] - 1
    -1
cg_oversized = (a: int) -> bool:
    if cg_nodes[0][a].kind == .unary and cg_nodes[0][a].op == 59: return cg_oversized(int(cg_nodes[0][a].a))
    cg_nodes[0][a].kind == .call and cg_nodes[0][a].aux2 == -1
cg_dewy = (pos: int) -> bool: cg_files[0][pos >> 40].is_dewy
ctx_dependent = (a: int) -> bool:
    k = cg_nodes[0][a].kind
    flags = int(cg_nodes[0][a].flags)
    if k == .unary: return cg_nodes[0][a].op == 59 and cg_oversized(int(cg_nodes[0][a].a))
    if k == .call:
        if cg_nodes[0][a].aux2 == -1: return true
        if cg_nodes[0][a].type == 0:
            callee = int(cg_nodes[0][a].a)
            ck = cg_nodes[0][callee].kind
            if cg_nodes[0][a].nlist == 1 and ck == .ident and int(cg_nodes[0][callee].name) == cg_set_name[0]: return true
            if ck == .dotname: return true
        return false
    if k == .ident or k == .field or k == .typeapply: return flags & 4096 != 0
    if k == .dotname: return cg_nodes[0][a].type == 0
    if k == .lambda or k == .none_lit or k == .hole or k == .record_lit: return true
    if k == .if_ or k == .match_: return flags & 128 == 0 and cg_dewy(cg_nodes[0][a].pos)
    if k == .block: return flags & 67108864 != 0 and flags & 128 == 0
    if k == .array:
        count = int(cg_nodes[0][a].nlist)
        if count == 0: return cg_nodes[0][a].b == 0
        if cg_nodes[0][a].type == 0 and flags & 128 == 0 and cg_dewy(cg_nodes[0][a].pos): return true
        base = int(cg_nodes[0][a].list)
        loop i in [0..count):
            if ctx_dependent(int(cg_lists[0][base + i])): return true
        return false
    if k == .map_lit: return cg_nodes[0][a].nlist == 0 or (cg_nodes[0][a].type == 0 and flags & 128 == 0 and cg_dewy(cg_nodes[0][a].pos))
    false
cg_unnamed = (a: int) -> int:
    if cg_nodes[0][a].kind == .namedarg: return int(cg_nodes[0][a].a)
    a
cg_order = (n: int, given: int[], final: int[]): cg_host[0].order(n, given, final)
save_call_order = (n: int, given: int[], final: int[]):
    if not cg_dewy(cg_nodes[0][n].pos): return
    count = given.len()
    if count > final.len():
        cg_order(n, given, final)
        return
    loop i in [0..count):
        if cg_unnamed(given[i]) != final[i]:
            cg_order(n, given, final)
            return
check_mutable_arguments = (args: int[], mask: int, pos: int):
    if mask == 0 or mask & (mask - 1) == 0: return
    cg_host[0].overlap(args, mask, pos)
map_float_key = (n: int):
    d = int(cg_fns[0][int(cg_nodes[0][n].sym)].decl)
    if d == 0: return
    nd = int(cg_nodes[0][d].nlist)
    if nd < 1: return
    nn = int(cg_nodes[0][n].nlist)
    if nn == 1:
        nm = int(cg_nodes[0][d].name)
        if nm != cg_float_key_names[0][0] and nm != cg_float_key_names[0][1]: return
    else:
        if nd < 2 or nn < 2: return
        p = int(cg_nodes[0][int(cg_lists[0][int(cg_nodes[0][d].list) + 1])].name)
        if p != cg_float_key_names[0][2] and p != cg_float_key_names[0][3]: return
    cg_host[0].float_key(n)
name_family = (m: int, name: int, hide: int) -> int:
    s = 0
    if m < 0:
        if name < cg_prelude_syms[0].len(): s = cg_prelude_syms[0][name]
    else:
        if name < cg_name_first[0].len():
            e = cg_name_first[0][name]
            loop e != 0:
                if cg_name_mod[0][e - 1] == m:
                    s = cg_name_sym[0][e - 1]
                    e = 0
                else: e = cg_name_next[0][e - 1]
    if s == 0: return 0
    if hide != 0:
        text = cg_names[0][name]
        if starts_with(text, "_") and not (hide == 2 and starts_with(text, "__")): return 0
    if cg_syms[0][s].kind != .fns: return 0
    s
habit_call_check = (n: int, name: int, args: int[]):
    h = cg_habit_names[0]
    na = args.len()
    maybe = false
    if name == h[0]: maybe = na >= 4
    if name == h[1] or name == h[3]: maybe = na >= 3
    if name == h[2] or name == h[8]: maybe = na == 1
    if name == h[4] or name == h[5]: maybe = na == 0
    if name == h[6]: maybe = na == 5
    if name == h[7]: maybe = na == 2
    if maybe: cg_host[0].habit(n, name, args)
struct CheckerCollectHost:
    demand: (int) -> void
    use_home: (int, int) -> int
    prelude_module: (int) -> int
    prelude_reach: (int, int) -> void
    rational: (int, int, *(int[])) -> void
    cin_grow: (int) -> void
    named_grow: (int) -> void
struct NamedFamily:
    next: int
    mod: int
    cur: int
    gen: int
    decls: int
    ndecls: int
    hidden: int
    nhidden: int
struct CheckerCollectInput:
    contexts: *(FnCtx[])
    context: *(int)
    mod_bits: *(int[])
    mod_uses: *(int[][])
    homes_built: *(bool)
    prelude_used: *(bool[])
    home_first: *(int[])
    home_mod: *(int[])
    home_next: *(int[])
    demanded: *(bool[])
    dp_scanned: *(bool)
    dp_by_name: *(int[])
    dp_mods: *(int[])
    rational_found: *(int)
    rational_probed: *(int)
    rational_reach: *(int[])
    exact_named: *(bool[])
    cin_mark: *(i32[])
    surface_hidden: *(int[])
    host: *(CheckerCollectHost)
    ide: *(bool)
    ml_name_tick: *(int[])
    ml_struct: *(int)
    named_first: *(int[])
    named: *(NamedFamily[])
    named_decls: *(int[])
    named_hidden: *(int[])
cl_in: *(CheckerCollectInput)
cl_pass = 0
checker_collect_bind = (input: *CheckerCollectInput) -> int:
    cl_in = input
    0
cl_cur_mod = () -> int:
    c = cl_in[0].context[0]
    if c >= 0: return int(cl_in[0].contexts[0][c].mod)
    0
cl_demand = (name: int):
    if name < cl_in[0].demanded[0].len() and cl_in[0].demanded[0][name]: return
    cl_in[0].host[0].demand(name)
cl_marked = (d: int) -> bool: d < cl_in[0].cin_mark[0].len() and int(cl_in[0].cin_mark[0][d]) == cl_pass
cl_mark = (d: int):
    if d >= cl_in[0].cin_mark[0].len(): cl_in[0].host[0].cin_grow(d)
    cl_in[0].cin_mark[0][d] = i32(cl_pass)
collect_in = (m: int, name: int, hide: int, out: *(int[])):
    s = name_family(m, name, hide)
    if s == 0: return
    cm = cl_cur_mod()
    dewy = cm >= 0 and cl_in[0].mod_bits[0][cm] & 2 != 0
    cl_pass += 1
    count = out[0].len()
    loop i in [0..count): cl_mark(out[0][i])
    o = s
    loop o != 0:
        d = int(cg_syms[0][o].decl)
        surface = int(cg_syms[0][o].surface)
        hidden = false
        if surface == 1: hidden = not dewy
        if surface != 0 and surface != 1: hidden = dewy
        if hidden: cl_in[0].surface_hidden[0].push(d)
        else if not cl_marked(d):
            out[0].push(d)
            cl_mark(d)
        o = int(cg_syms[0][o].next)
cl_use_home = (m: int, name: int) -> int:
    if not cl_in[0].homes_built[0]: return cl_in[0].host[0].use_home(m, name)
    if m < cl_in[0].prelude_used[0].len() and cl_in[0].prelude_used[0][m]: return -2
    if name >= cl_in[0].home_first[0].len(): return -1
    h = cl_in[0].home_first[0][name]
    if h == 0: return -1
    h = h - 1
    if cl_in[0].home_next[0][h] != 0: return -2
    hm = cl_in[0].home_mod[0][h]
    loop i in [0..cl_in[0].mod_uses[0][m].len()):
        if cl_in[0].mod_uses[0][m][i] == hm: return hm
    -1
cl_bound_in = (m: int, name: int) -> bool:
    if name >= cl_in[0].home_first[0].len(): return false
    h = cl_in[0].home_first[0][name]
    loop h != 0:
        if cl_in[0].home_mod[0][h - 1] == m: return true
        h = cl_in[0].home_next[0][h - 1]
    false
collect_module = (m: int, name: int, out: *(int[])):
    if m < 0: return
    cl_demand(name)
    if cl_in[0].mod_bits[0][m] & 1 != 0:
        collect_in(-1, name, 0, out)
        return
    collect_in(m, name, 0, out)
    nu = cl_in[0].mod_uses[0][m].len()
    if nu == 0: return
    h = cl_use_home(m, name)
    if h >= 0:
        collect_in(h, name, 1, out)
        return
    if h != -2: return
    loop i in [0..nu):
        u = cl_in[0].mod_uses[0][m][i]
        if cl_in[0].mod_bits[0][u] & 1 != 0: collect_in(-1, name, 2, out)
        else if cl_bound_in(u, name): collect_in(u, name, 1, out)
cl_prelude_module = (name: int) -> int:
    if cl_in[0].dp_scanned[0] and name < cl_in[0].dp_by_name[0].len():
        f = cl_in[0].dp_by_name[0][name]
        if f == 1: return -1
        if f >= 2:
            dm = cl_in[0].dp_mods[0][f - 2]
            if dm >= 0: return dm
    cl_in[0].host[0].prelude_module(name)
cl_prelude_reach = (m: int, dm: int):
    if cl_in[0].rational_found[0] < 0 and cl_in[0].mod_bits[0].len() == cl_in[0].rational_probed[0]: return
    if m < cl_in[0].rational_reach[0].len() and cl_in[0].rational_reach[0][m] == 1: return
    cl_in[0].host[0].prelude_reach(m, dm)
collect_fns = (name: int, out: *(int[])):
    cl_demand(name)
    m = cl_cur_mod()
    collect_module(m, name, out)
    user = false
    dewy = false
    if m >= 0:
        bits = cl_in[0].mod_bits[0][m]
        user = bits & 1 == 0
        dewy = user and bits & 2 != 0
    if dewy and not starts_with(cg_names[0][name], "_"):
        dm = cl_prelude_module(name)
        if dm >= 0 and name_family(dm, name, 0) != 0:
            if dm != m:
                collect_in(dm, name, 0, out)
                cl_prelude_reach(m, dm)
            return
    hide = 0
    if user: hide = 2
    collect_in(-1, name, hide, out)
    if dewy:
        if cl_in[0].exact_named[0].len() == 0 or (name < cl_in[0].exact_named[0].len() and cl_in[0].exact_named[0][name]): cl_in[0].host[0].rational(m, name, out)
cl_stamp = (name: int) -> int:
    base = cl_in[0].ml_struct[0]
    if name < cl_in[0].ml_name_tick[0].len() and cl_in[0].ml_name_tick[0][name] > base: return cl_in[0].ml_name_tick[0][name]
    base
cl_method = (d: int) -> bool:
    if cg_nodes[0][d].nlist < 1: return false
    p = int(cg_lists[0][int(cg_nodes[0][d].list)])
    starts_with(cg_names[0][int(cg_nodes[0][p].name)], "$self")
cl_named_now = (name: int, mod: int, out: *(int[])):
    if mod >= 0: collect_module(mod, name, out)
    else: collect_fns(name, out)
    m = mod
    if mod < 0: m = cl_cur_mod()
    if m < 0: return
    bits = cl_in[0].mod_bits[0][m]
    if bits & 1 != 0 or bits & 2 == 0: return
    s = name_family(m, name, 0)
    if s == 0: return
    owned = false
    o = s
    loop o != 0:
        d = int(cg_syms[0][o].decl)
        if d != 0 and not cl_method(d): owned = true
        o = int(cg_syms[0][o].next)
    if not owned: return
    kept = 0
    count = out[0].len()
    loop i in [0..count):
        d = out[0][i]
        keep = cl_method(d)
        e = s
        loop not keep and e != 0:
            ed = int(cg_syms[0][e].decl)
            if ed == d and ed != 0 and not cl_method(ed): keep = true
            e = int(cg_syms[0][e].next)
        if keep:
            out[0][kept] = d
            kept += 1
    loop out[0].len() > kept: out[0].pop()
collect_named = (name: int, mod: int, out: *(int[])):
    if out[0].len() > 0 or cl_in[0].ide[0]:
        cl_named_now(name, mod, out)
        return
    cur = cl_cur_mod()
    gen = cl_stamp(name)
    found = -1
    if name < cl_in[0].named_first[0].len():
        e = cl_in[0].named_first[0][name]
        loop e != 0:
            f = cl_in[0].named[0][e - 1]
            if f.mod == mod and f.cur == cur:
                if f.gen == gen:
                    loop i in [f.decls..f.decls + f.ndecls): out[0].push(cl_in[0].named_decls[0][i])
                    loop i in [f.hidden..f.hidden + f.nhidden): cl_in[0].surface_hidden[0].push(cl_in[0].named_hidden[0][i])
                    return
                found = e - 1
                e = 0
            else: e = f.next
    mark = cl_in[0].surface_hidden[0].len()
    cl_named_now(name, mod, out)
    if cl_stamp(name) != gen: return
    start = cl_in[0].named_decls[0].len()
    loop i in [0..out[0].len()): cl_in[0].named_decls[0].push(out[0][i])
    hstart = cl_in[0].named_hidden[0].len()
    loop i in [mark..cl_in[0].surface_hidden[0].len()): cl_in[0].named_hidden[0].push(cl_in[0].surface_hidden[0][i])
    nd = out[0].len()
    nh = cl_in[0].named_hidden[0].len() - hstart
    if found >= 0:
        cl_in[0].named[0][found].gen = gen
        cl_in[0].named[0][found].decls = start
        cl_in[0].named[0][found].ndecls = nd
        cl_in[0].named[0][found].hidden = hstart
        cl_in[0].named[0][found].nhidden = nh
        return
    if name >= cl_in[0].named_first[0].len(): cl_in[0].host[0].named_grow(name)
    cl_in[0].named[0].push(NamedFamily(cl_in[0].named_first[0][name], mod, cur, gen, start, nd, hstart, nh))
    cl_in[0].named_first[0][name] = cl_in[0].named[0].len()

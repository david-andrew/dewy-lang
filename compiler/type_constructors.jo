use 'checker_types.dewy'
use 'type_inference.dewy'
use 'type_intern.dewy'
const TF_HAS_VAR = 1
const TF_LAID_OUT = 2
const TF_MANAGED = 4
const TF_NEVER = 8
struct TypeConstructorHost:
    mk_type: (TypeInfo, int[]) -> int
struct TypeConstructorInput:
    types: *(TypeInfo[])
    ptr_size: *(int)
    var_counter: *(int)
    secrets_seen: *(bool)
    values_any: *(bool)
    T_VOID: *(int)
    T_BOOL: *(int)
    T_INT: *(int)
    T_MATH_INT: *(int)
    T_I8: *(int)
    T_I16: *(int)
    T_I32: *(int)
    T_U8: *(int)
    T_U16: *(int)
    T_U32: *(int)
    T_U64: *(int)
    T_FLOAT: *(int)
    T_F32: *(int)
    T_STR: *(int)
    T_NULL: *(int)
    T_RANGE: *(int)
    T_NONE: *(int)
    T_NEVER: *(int)
    T_RAWPTR: *(int)
    T_VEC2: *(int)
    T_VEC3: *(int)
    T_VEC4: *(int)
    T_MAT4: *(int)
    T_IVEC2: *(int)
    T_IVEC3: *(int)
    T_IVEC4: *(int)
    host: *TypeConstructorHost
tb_inputs: *TypeConstructorInput
type_constructor_bind = (input: *TypeConstructorInput) -> int:
    tb_inputs = input
    0
tb_basic = (kind: TK, bits: int, sign: bool, size: int) -> int:
    t = TypeInfo(kind = kind, bits = i32(bits), sign = sign, size = i32(size), align = i32(size))
    if size == 0: t.align = 1
    t.flags = i32(TF_LAID_OUT)
    tb_inputs[0].host[0].mk_type(t, [])


tb_mk_array = (e: int) -> int:
    type_intern_element(.array, e)

tb_mk_fixed = (e: int, n: int) -> int:
    tb_inputs[0].host[0].mk_type(TypeInfo(kind = .fixed, elem = i32(e), bits = i32(n)), [])

tb_mk_ptr = (e: int) -> int: type_intern_element(.ptr, e)

tb_mk_box = (e: int) -> int: type_intern_element(.box, e)

tb_mk_opt = (e: int) -> int: type_intern_element(.opt, e)

tb_mk_secret = (e: int) -> int:
    if tb_inputs[0].types[0][tu_prune(e)].kind == .secret: return tu_prune(e)
    tb_inputs[0].secrets_seen[0] = true
    tb_inputs[0].host[0].mk_type(TypeInfo(kind = .secret, elem = i32(e)), [])

tb_secret_repr = (t0: int) -> int:
    t = tu_prune(t0)
    k = tb_inputs[0].types[0][t].kind
    if k == .secret: return tb_secret_repr(int(tb_inputs[0].types[0][t].elem))
    if k == .array: return tb_mk_array(tb_secret_repr(int(tb_inputs[0].types[0][t].elem)))
    if k == .opt: return tb_mk_opt(tb_secret_repr(int(tb_inputs[0].types[0][t].elem)))
    if k == .fixed: return tb_mk_fixed(tb_secret_repr(int(tb_inputs[0].types[0][t].elem)), int(tb_inputs[0].types[0][t].bits))
    if k == .box: return tb_mk_box(tb_secret_repr(int(tb_inputs[0].types[0][t].elem)))
    if k == .ptr: return tb_mk_ptr(tb_secret_repr(int(tb_inputs[0].types[0][t].elem)))
    t

tb_mk_fn = (params: int[], ret: int, mutmask: int, labels: int = 0, defaults: int = 0, pack: bool = false) -> int: tb_inputs[0].host[0].mk_type(TypeInfo(kind = .fn_, elem = i32(ret), mutmask = i32(mutmask), st = i32(labels), bits = i32(defaults), sign = pack), params)

tb_mk_cfn = (params: int[], ret: int) -> int: tb_inputs[0].host[0].mk_type(TypeInfo(kind = .cfn, elem = i32(ret)), params)

tb_mk_tuple = (elems: int[], values: bool = false) -> int: tb_inputs[0].host[0].mk_type(TypeInfo(kind = .tuple, sign = values), elems)

tb_mk_values = (elems: int[]) -> int:
    tb_inputs[0].values_any[0] = true
    tb_mk_tuple(elems, true)

tb_mk_var = () -> int:
    tb_inputs[0].var_counter[0] += 1
    type_intern_var(tb_inputs[0].var_counter[0])

tb_mk_param = (idx: int) -> int: type_intern_param(idx)

tb_mk_typeval = (t: int) -> int:
    tb_inputs[0].types[0].push(TypeInfo(kind = .typeval, elem = i32(t), flags = i32(TF_LAID_OUT)))
    tb_inputs[0].types[0].len() - 1

tb_mk_modval = (m: int) -> int:
    tb_inputs[0].types[0].push(TypeInfo(kind = .module, mod = i32(m), flags = i32(TF_LAID_OUT)))
    tb_inputs[0].types[0].len() - 1


tb_init_types = ():
    tb_inputs[0].T_VOID[0] = tb_basic(.void_, 0, false, 0)
    tb_inputs[0].T_BOOL[0] = tb_basic(.bool_, 8, false, 1)
    tb_inputs[0].T_INT[0] = tb_basic(.int_, 64, true, 8)
    tb_inputs[0].T_MATH_INT[0] = tb_inputs[0].host[0].mk_type(TypeInfo(kind = .int_, bits = 64, sign = true, st = -1, size = 8, align = 8, flags = i32(TF_LAID_OUT | TF_MANAGED), rep = .tagged_int), [])
    tb_inputs[0].T_I8[0] = tb_basic(.int_, 8, true, 1)
    tb_inputs[0].T_I16[0] = tb_basic(.int_, 16, true, 2)
    tb_inputs[0].T_I32[0] = tb_basic(.int_, 32, true, 4)
    tb_inputs[0].T_U8[0] = tb_basic(.int_, 8, false, 1)
    tb_inputs[0].T_U16[0] = tb_basic(.int_, 16, false, 2)
    tb_inputs[0].T_U32[0] = tb_basic(.int_, 32, false, 4)
    tb_inputs[0].T_U64[0] = tb_basic(.int_, 64, false, 8)
    tb_inputs[0].T_FLOAT[0] = tb_basic(.float_, 64, true, 8)
    tb_inputs[0].T_F32[0] = tb_basic(.float_, 32, true, 4)
    tb_inputs[0].T_STR[0] = tb_basic(.str_, 0, false, tb_inputs[0].ptr_size[0])
    tb_inputs[0].types[0][tb_inputs[0].T_STR[0]].flags = i32(TF_LAID_OUT | TF_MANAGED)
    tb_inputs[0].T_NULL[0] = tb_basic(.null_, 0, false, tb_inputs[0].ptr_size[0])
    tb_inputs[0].T_RANGE[0] = tb_basic(.range, 0, false, 16)
    tb_inputs[0].types[0][tb_inputs[0].T_RANGE[0]].align = 8
    tb_inputs[0].T_NONE[0] = tb_basic(.none_lit, 0, false, 0)
    tb_inputs[0].T_NEVER[0] = tb_basic(.void_, 1, false, 0)
    tb_inputs[0].types[0][tb_inputs[0].T_NEVER[0]].flags = i32(TF_LAID_OUT | TF_NEVER)
    tb_inputs[0].T_RAWPTR[0] = tb_mk_ptr(tb_inputs[0].T_U8[0])
    tb_inputs[0].T_VEC2[0] = tb_basic(.vec, 2, false, 8)
    tb_inputs[0].types[0][tb_inputs[0].T_VEC2[0]].align = 4
    tb_inputs[0].T_VEC3[0] = tb_basic(.vec, 3, false, 12)
    tb_inputs[0].types[0][tb_inputs[0].T_VEC3[0]].align = 4
    tb_inputs[0].T_VEC4[0] = tb_basic(.vec, 4, false, 16)
    tb_inputs[0].types[0][tb_inputs[0].T_VEC4[0]].align = 4
    tb_inputs[0].T_MAT4[0] = tb_basic(.vec, 16, false, 64)
    tb_inputs[0].types[0][tb_inputs[0].T_MAT4[0]].align = 4
    tb_inputs[0].T_IVEC2[0] = tb_basic(.vec, 2, true, 8)
    tb_inputs[0].types[0][tb_inputs[0].T_IVEC2[0]].align = 4
    tb_inputs[0].T_IVEC3[0] = tb_basic(.vec, 3, true, 12)
    tb_inputs[0].types[0][tb_inputs[0].T_IVEC3[0]].align = 4
    tb_inputs[0].T_IVEC4[0] = tb_basic(.vec, 4, true, 16)
    tb_inputs[0].types[0][tb_inputs[0].T_IVEC4[0]].align = 4


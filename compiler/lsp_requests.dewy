$runtime_checks

from p"@lib/core/os.jo" import (is_dir list_dir read_file time)
from p"@lib/core/str.jo" import (ends_with is_digit starts_with trim)
from p"@lib/core/rt.jo" import (__str_slice)
from p"checks_text.dewy" import (byte_find byte_rfind)
from p"ide.jo" import (IK_BUILTIN IK_CONST IK_FIELD IK_FN IK_LOCAL IK_PARAM IK_TYPE IK_VARIANT ide_texts)
from p"ide_decls.dewy" import (ide_str_end)
from p"ide_text.dewy" import (ide_comment_end ide_str_start)
from p"json_doc.dewy" import (json_quote)
from p"lex.jo" import (is_ident_char keywords)
from p"lsp.jo" import (Decl Diag Hit Item Result SemTok Use docs empty_main lsp_stop no_items root_lib sy_container sy_dewy sy_ok ws_files)

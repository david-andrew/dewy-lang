# Frozen checker hooks and pending-body execution from check.jo.
use 'check.jo'
use 'icount.jo'
use 'icount_ops.dewy'
use 'types.jo'
use 'expr.jo'
use 'definite.jo'
use 'definite_walk.dewy'
use 'decimals.jo'
use 'growth.jo'
use 'growth_ops.dewy'
use 'ide.jo'
use 'string_domains.jo'
use 'ast.jo'
use 'pcheck.jo'
use 'sibling_types.jo'

block_sibling = (n: int, m: int, code: int):
    if code == 1: sibling_flow_loops(n)
    else if code == 2: sibling_statement(n, m)
    else if code == 3: sibling_flow_start(n, m)
    else: sibling_flow_end(n)

assign_begin = (s: int, code: int) -> int:
    if code == 1:
        growth_assign(s)
        return 0
    if code == 2: return decimal_assign_begin(s)
    sibling_syntax_type(int(nodes[s].b))

decl_annotated = (s: int, t: int, member: int):
    sibling_annotated(s, t, member)
    return

decl_sibling = (s: int, t: int, code: int) -> int:
    if code == 1: sibling_binding(s, t) else: sibling_scalar(s, t)

decl_literal = (s: int) -> int:
    t = decimal_binding_type(nodes[s].pos, lit_default(int(nodes[s].b)))
    value = coerce(int(nodes[s].b), t)
    nodes[s].b = i32(value)
    t

decl_after = (s: int, l: int, t: int, code: int):
    if code == 1: growth_decl_before(s)
    else if code == 3: sibling_establish(l)
    else if code == 4: decimal_local(l, nodes[s].pos, t)
    else if code == 5: growth_decl_after(s, l, t)
    else if code == 6: string_domain_declare(l, int(nodes[s].b))
    else if code == 7: int_domain_declare(l, int(nodes[s].b))
    else if code == 8: const_view_declare(l, int(nodes[s].b))
    else if code == 9: da_record(s)
    else if code == 10: ide_hint_local(s, l)

run_pending_functions = (start: int) -> int:
    k = start
    loop k < fns.len() or prepare_value_helpers():
        pc_try(k)
        if fns[k].state == 0 and (fns[k].kind == FK_NORMAL or fns[k].kind == FK_INIT) and k != 0:
            if fns[k].kind == FK_INIT:
                icb = ic_mod(IC_CHECK, int(fns[k].mod))
                if decimal_wants(k): decimal_check_body(k)
                else: check_init_now(k)
                ic_restore(icb)
            else: check_fn_body(k)
        k += 1
    k

check_init_now = (k: int):
    m = int(fns[k].mod)
    saved = cx
    entered = enter_module_context(m)
    cx = module_ctx[m]
    saved_floor = ctxs[cx].floor
    fns[k].state = 1
    mark = scope_mark()
    ctxs[cx].floor = i32(check_scopes.names.len())
    body = int(fns[k].body)
    loop j in [0..nkids(body)): check_stmt(kid(body, j))
    scope_reset(mark)
    zonk_tree(body)
    loop l in fns[k].locals:
        t = zonk(int(locals[l].type))
        locals[l].type = i32(t)
    copy_write_warnings(k)
    fns[k].ret = i32(T_VOID)
    fns[k].state = 2
    ctxs[cx].floor = saved_floor
    leave_module_context(m, entered)
    cx = saved

$runtime_checks
from p"fused_ir.dewy" import (fz_unpack_ir)
from p"@lib/core/rt.jo" import (__str_from_bytes)
from p"@lib/core/os.jo" import (env eprint exit time)

from p"ast.jo" import (NF_EXTERN has_flag nkids)
from p"check.jo" import (FK_INIT FK_LAMBDA FK_NORMAL fns globals)
from p"driver_pipeline.dewy" import (emit_now)
from p"fused.jo" import (FzLocal FzRec fz_by_helper fz_by_inst fz_d0 fz_j fz_kdt fz_kro fz_lf0 fz_mdt fz_mlf fz_mro fz_qrec fz_r0 fz_raws fz_rd fz_recs fz_ro fz_texts fzw_f0 fzw_g0 fzw_grown fzw_have fzw_recs fzw_t0)
from p"fused_drive.dewy" import (fused_start fz_place)
from p"inline_ops.dewy" import (fast_inline_kind fast_inline_prepare)
from p"ir.jo" import (ir ir_positions)
from p"ir_types.dewy" import (Ins IrFn Op)
from p"lower.jo" import (LK_INST box_dflt_data global_off helper_lf inst_lf lfuncs rodata str_off)
from p"lower_functions.dewy" import (lower_function)
from p"par.jo" import (ParIn pr)
from p"par_ops.dewy" import (pr_ints pw pw_ints)
from p"pcheck.jo" import (pc_active pc_child pc_smalls pc_weights)
from p"pcheck_drive.dewy" import (pc_cancel pc_facts_serial)
from p"types.jo" import (prune types)
from p"diagnostic_exit.dewy" import (ice)

FusedWord:type=int64<overflow='wrap'>
# 0 function (local lf, inst); 1 helper (local lf, kind, type, p); 2 string (local offset,
# text); 3 global (local offset, global); 4 empty box (local offset, type); 5 warning (pos, text);
# 6 raw constant (local offset, alignment, length, bytes); 7 deterministic call (node)
fz_note=(kind:FusedWord local:FusedWord a:FusedWord b:FusedWord c:FusedWord):>void=>{
    fz_j.push(kind)
    fz_j.push(local)
    fz_j.push(a)
    fz_j.push(b)
    fz_j.push(c)
}
fz_note_text=(kind:FusedWord local:FusedWord s:string):>void=>{
    fz_texts.push(s)
    if kind =? 2 {fz_note(2 local fz_texts.length - 1 0 0)} else {fz_note(5 0 local fz_texts.length - 1 0)}
}
fz_note_raw=(o:FusedWord align:FusedWord):>void=>{
    fz_note(6 o align rodata.length - o fz_raws.length)
    loop k in [o..rodata.length) {fz_raws.push(rodata[k])}
}
fz_note_ro=(bits:int64 o:int64):>void=>{
    fz_ro.push(bits)
    fz_ro.push(o)
}
# the functions workers lower: checked bodies (top-level code included), not the prelude's init
fz_cand=(f:FusedWord pinit:FusedWord):>bool=>$unsafe {
    if f <=? 0 or f =? pinit or f >=? fns.length {return false}
    if fns.ptr[f].state not=? 2 or fns.ptr[f].body =? 0 {return false}
    let k=fns.ptr[f].kind
    if k not=? FK_NORMAL and k not=? FK_LAMBDA and k not=? FK_INIT {return false}
    let d=FusedWord(fns.ptr[f].decl)
    if d not=? 0 and has_flag(d NF_EXTERN) {return false}
    true
}
# (a lowered function that is its instance's own, not a version made for known callbacks:
# callback_specialize.jo; versions are lowered and emitted here, and what calls one too)
fz_canon=(lf:FusedWord):>bool=>$unsafe {
    lfuncs.ptr[lf].kind not=? LK_INST or (inst_lf.get(lfuncs.ptr[lf].inst) ?? -1) =? lf
}
fz_extern=(f:FusedWord):>bool=>$unsafe {
    let d=FusedWord(fns.ptr[f].decl)
    d not=? 0 and has_flag(d NF_EXTERN)
}
fz_weight=(f:FusedWord):>int64=>$unsafe {
    pc_weights.get(f) ?? (8 + fns.ptr[f].locals.length * 4 + nkids(FusedWord(fns.ptr[f].body)) * 8)
}
# (a function small enough that it may be a leaf fast_inline_into expands: lowered by every
# worker whose functions call it)
fz_small=(f:FusedWord):>bool=>$unsafe {
    pc_smalls.get(f) ?? (nkids(FusedWord(fns.ptr[f].body)) <=? 8 and fns.ptr[f].locals.length <=? 12)
}
fused_fork=(pinit_lf:FusedWord):>bool=>{
    let ready=fused_start(pinit_lf)
    # A checking child must never proceed to the parent's executable writer.
    if pc_child >=? 0 {exit(1)}
    if pc_active and not ready {
        pc_cancel()
        # (the workers' obligations, decided there, are decided here again)
        pc_facts_serial()
    }
    ready
}
# lower one function here, noting what it refers to (tainted: what it refers to may differ from
# what lowering it in the compiler would find, so it is lowered there instead)
fzw_lower=(lf:FusedWord owned:bool):>void=>$unsafe {
    let j0=fz_j.length
    let n0=fns.length
    let ty0=types.length
    let gl0=globals.length
    lower_function(lf)
    let changed=fns.length not=? n0 or types.length not=? ty0 or globals.length not=? gl0
    let taint=changed
    if changed {fzw_grown=true}
    if changed and env("DEWY_FUSED_TRACE") not=? none {eprint("fused worker: {lfuncs.ptr[lf].name} grew fns {n0}->{fns.length} types {ty0}->{types.length} globals {gl0}->{globals.length}")}
    let k=j0
    loop k <? fz_j.length {
        let kind=fz_j[k]
        if kind =? 0 and fz_j[k + 2] >=? fzw_f0 {taint=true}
        if kind =? 1 and (fz_j[k + 3] >=? fzw_t0 or fz_j[k + 4] >=? fzw_f0) {taint=true}
        if kind =? 3 and fz_j[k + 2] >=? fzw_g0 {taint=true}
        if kind =? 4 and fz_j[k + 2] >=? fzw_t0 {taint=true}
        k += 5
    }
    fzw_have[lf]=fzw_recs.length
    fzw_recs.push(FzLocal(lf owned taint fast_inline_kind(ir) j0 fz_j.length ir))
}
fz_put_str=(@out:array<uint8> s:string):>void=>{
    pw(@out (s as array<uint8>).length)
    loop c in bytes(s) {out.push(c)}
}
fz_get_str=(@r:ParIn):>string=>{
    let n=pr(@r)
    let s=__str_from_bytes(r.b[r.i..r.i + n))
    r.i += n
    s
}
# ---- here: the workers' results ----
fz_hkey=(hk:FusedWord t:FusedWord p:FusedWord):>string=>{
    "{hk}:{t}:{p}"
}
fz_parse=(w:FusedWord b:array<uint8>):>void=>{
    fz_rd[w]=ParIn(b)
    let r=ParIn(b)
    let n=pr(@r)
    let first=fz_recs.length
    loop _ in [0..n) {
        let x=FzRec(w=w)
        x.lf=pr(@r)
        x.lkind=pr(@r)
        x.ka=pr(@r)
        x.kb=pr(@r)
        x.kc=pr(@r)
        x.owned=pr(@r) not=? 0
        x.taint=pr(@r) not=? 0
        x.kind=pr(@r)
        let nj=pr(@r)
        loop _ in [0..nj // 5) {
            let kind=pr(@r)
            x.ents.push(kind)
            loop _ in [0..4) {x.ents.push(pr(@r))}
            if kind =? 2 or kind =? 5 {x.texts.push(fz_get_str(@r))} else if kind =? 6 {
                let m=pr(@r)
                x.raws.push(r.b[r.i..r.i + m))
                r.i += m
            }
        }
        x.assumed=pr_ints(@r)
        x.uses=pr_ints(@r)
        x.irp=-1
        x.chunk=-1
        if pr(@r) not=? 0 {
            x.irp=r.i
            fz_skip_ir(@r)
        }
        fz_recs.push(x)
    }
    loop k in [first..fz_recs.length) {
        if pr(@r) =? 0 {continue}
        fz_recs[k].chunk=r.i
        let nc=pr(@r)
        r.i += nc
        let skip=16 * pr(@r)
        r.i += skip
        skip=24 * pr(@r)
        r.i += skip
        skip=16 * pr(@r)
        r.i += skip
        skip=16 * pr(@r)
        r.i += skip
        skip=16 * pr(@r)
        r.i += skip
        skip=16 * pr(@r)
        r.i += skip
        skip=16 * pr(@r)
        r.i += skip
        pr(@r);
    }
    loop k in [first..fz_recs.length) {
        let x=fz_recs[k]
        if not x.owned or x.taint {continue}
        if x.lkind =? LK_INST {
            if fz_by_inst.get(x.ka) =? none {fz_by_inst[x.ka]=k}
        }
        else {
            let key=fz_hkey(x.ka x.kb x.kc)
            if fz_by_helper.get(key) =? none {fz_by_helper[key]=k}
        }
    }
}
fz_skip_ir=(@r:ParIn):>void=>{
    r.i += 48
    let skip=pr(@r)
    r.i += skip
    skip=8 * pr(@r)
    r.i += skip
    skip=8 * pr(@r)
    r.i += skip
    skip=8 * pr(@r)
    r.i += skip
    skip=8 * pr(@r)
    r.i += skip
    skip=8 * pr(@r)
    r.i += skip
    skip=64 * pr(@r)
    r.i += skip
}
# the record that stands for local function lf of worker w (-1: none)
fz_owner_of=(x:FzRec):>int64=>{
    if x.lkind =? LK_INST {return fz_by_inst.get(x.ka) ?? -1}
    fz_by_helper.get(fz_hkey(x.ka x.kb x.kc)) ?? -1
}
fz_validate=():>void=>{
    # (by worker: local function -> its record)
    let local:array<dict<int64 int64>>=[]
    loop _ in fz_rd {
        let empty:dict<int64 int64>=[]
        local.push(empty)
    }
    loop k in 0.. and x in fz_recs {local[x.w][x.lf]=k}
    loop k in 0.. and x in fz_recs {
        let ok=x.owned and not x.taint and x.chunk >=? 0 and fz_owner_of(x) =? k
        if ok {
            loop f in x.assumed {
                let o=fz_by_inst.get(f) ?? -1
                # (a foreign function's thunk calls through a pointer: never expanded)
                if o <? 0 and fz_extern(f) {continue}
                if o <? 0 or fz_recs[o].kind not=? 0 {ok=false}
            }
        }
        fz_recs[k].valid=ok
    }
    # (one it may inline: its raw constants are found by those of the one replayed)
    let changed=true
    loop changed {
        changed=false
        loop k in 0.. and x in fz_recs {
            if not x.valid {continue}
            loop g in x.uses {
                let h=local[x.w].get(g) ?? -1
                let ok=h >=? 0
                if ok and fz_recs[h].raws.length >? 0 {
                    let o=fz_owner_of(fz_recs[h])
                    ok=o >=? 0 and fz_recs[o].valid
                }
                if not ok {
                    fz_recs[k].valid=false
                    changed=true
                    break
                }
            }
        }
    }
}
# what the records not replayed refer to (made by another worker, or an inlined copy): found
# by what they are
fz_map_rest=():>void=>{
    loop k in 0.. and x in fz_recs {
        if x.taint {continue}
        let o=fz_owner_of(x)
        let t:FusedWord=0
        let rw:FusedWord=0
        let e:FusedWord=0
        loop e <? x.ents.length {
            let kind=x.ents[e]
            let local=x.ents[e + 1]
            let a=x.ents[e + 2]
            if kind =? 0 {
                if fz_mlf[x.w].get(local) =? none {
                    let v=inst_lf.get(a)
                    if v not=? none {fz_mlf[x.w][local]=v}
                }
            }
            else if kind =? 1 {
                if fz_mlf[x.w].get(local) =? none {
                    let v=helper_lf.get("{a}:{x.ents[e + 3]}:{x.ents[e + 4]}")
                    if v not=? none {fz_mlf[x.w][local]=v}
                }
            }
            else if kind =? 2 {
                if fz_mro[x.w].get(local) =? none {
                    let v=str_off.get(x.texts[t])
                    if v not=? none {fz_mro[x.w][local]=v}
                }
                t += 1
            }
            else if kind =? 3 {
                if fz_mdt[x.w].get(local) =? none {
                    let v=global_off.get(a)
                    if v not=? none {fz_mdt[x.w][local]=v}
                }
            }
            else if kind =? 4 {
                if fz_mro[x.w].get(local) =? none {
                    let v=box_dflt_data.get(prune(a))
                    if v not=? none {fz_mro[x.w][local]=v}
                }
            }
            else if kind =? 5 {t += 1} else if kind =? 6 {
                if fz_mro[x.w].get(local) =? none and o >=? 0 and rw <? fz_recs[o].raw_par.length {fz_mro[x.w][local]=fz_recs[o].raw_par[rw]}
                rw += 1
            }
            e += 5
        }
    }
}
fz_map_lf=(w:FusedWord lf:FusedWord):>int64=>{
    if lf <? fz_lf0 {return lf}
    let v=fz_mlf[w].get(lf)
    if v not=? none {return v}
    ice("fused: no function here for worker function {lf}")
    0
}
fz_map_in=(w:FusedWord space:FusedWord off:FusedWord low:FusedWord):>int64=>{
    if off <? low {return off}
    if space =? 0 {
        let v=fz_mro[w].get(off)
        if v not=? none {return v}
        if fz_kro[w].length =? 0 {
            loop [k2 _] in fz_mro[w] {fz_kro[w].push(k2)}
            fz_kro[w].sort()
        }
        return fz_interior(fz_mro[w] fz_kro[w] off)
    }
    let v=fz_mdt[w].get(off)
    if v not=? none {return v}
    if fz_kdt[w].length =? 0 {
        loop [k2 _] in fz_mdt[w] {fz_kdt[w].push(k2)}
        fz_kdt[w].sort()
    }
    fz_interior(fz_mdt[w] fz_kdt[w] off)
}
fz_interior=(mp:dict<int64 int64> keys:array<int64> off:FusedWord):>int64=>{
    let lo:FusedWord=0
    let hi=keys.length
    loop lo + 1 <? hi {
        let mid=(lo + hi) // 2
        if keys[mid] <=? off {lo=mid} else {hi=mid}
    }
    if keys.length =? 0 or keys[lo] >? off {
        ice("fused: no place here for worker offset {off}")
        return off
    }
    mp[keys[lo]] + off - keys[lo]
}
# a source position's id here
fz_pos=(p:FusedWord):>int64=>{
    if p =? 0 {return 0}
    if ir_positions[ir_positions.length - 1] not=? p {ir_positions.push(p)}
    ir_positions.length - 1
}
# the machine code of the queued functions, in order: workers' joined, the rest made here
fz_emit=(q:array<IrFn>):>void=>{
    let t0=time()
    fz_map_rest()
    let t1=time()
    let fs:array<IrFn>=[]
    let native=fill(false q.length)
    loop k in 0.. and f in q {
        let rk=fz_qrec.get(f.fn_index)
        if rk not=? none {
            let x=fz_recs[rk]
            if x.irp >=? 0 {fs.push(fz_unpack_ir(x f.fn_index))}
        }
        else {
            native[k]=true
            fs.push(f)
        }
    }
    let t2=time()
    fast_inline_prepare(fs)
    let t3=time()
    let tn=0.0
    loop k in 0.. and f in q {
        if native[k] {
            let t4=time()
            ir=f
            emit_now(false)
            tn += time() - t4
            continue
        }
        fz_place(fz_recs[fz_qrec[f.fn_index]] f.fn_index)
    }
    if env("DEWY_PAR_TIME") not=? none {eprint("fused: joined in {(time() - t0) * 1000.0} ms (mapping {(t1 - t0) * 1000.0}, leaves {(t2 - t1) * 1000.0}, prepare {(t3 - t2) * 1000.0}, made here {tn * 1000.0})")}
}

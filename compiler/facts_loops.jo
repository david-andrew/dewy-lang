# a - b <= limit, from rows or from the two intervals.
fact_entails = (s: FactState, a: int, b: int, limit: int) -> bool:
    if fact_distance(s, a, b, limit): return true
    x = fact_bound(s, a); y = fact_bound(s, b)
    not x.wide and not y.wide and y.lo != FACT_MIN and fact_add_fits(x.hi, -y.lo) and x.hi - y.lo <= limit
# A non-element projection of an immutable entry value (a snapshot's length,
# say) first read in the body names the same evaluation at entry. Copy it
# there at its domain, so backedge rows about it can be checked against entry.
fact_loop_materialize = (entry: mut FactState, back: FactState, v: int, depth: int = 0) -> bool:
    if fact_slot(entry, v) >= 0: return true
    if depth > 2 or entry.ids.len() >= FACT_CAP or entry.projections.len() >= FACT_CAP: return false
    pi = fact_projection_origin(back, v)
    if pi >= 0:
        p = back.projections[pi]
        if not fact_loop_materialize(entry, back, p.base, depth + 1): return false
        b = fact_domain(fact_terms[v].type)
        if p.selector == -1: b = FactBound(0, fact_length_max())
        fact_add_value(entry, v, b)
        fact_add_projection(entry, p)
        return true
    false
# Intervals are candidates at a changing loop header, and so are backedge rows
# relating a changing scalar to an immutable evaluation (`k <? s.length` after
# a combined loop's guard). A row is kept only when entry entails it too; the
# header settles only when the same rows return, so each kept row holds on
# initiation and preservation. Guards select rows; assertions never do.
loop_ch_mark: i32[]
loop_st_mark: i32[]
loop_mark_gen: i32 = 0
loop_header_widened = false

fact_loop_is_ch = (v: int) -> bool:
    v >= 0 and v < loop_ch_mark.len() and data(loop_ch_mark)[v] == loop_mark_gen
fact_loop_is_st = (v: int) -> bool:
    v >= 0 and v < loop_st_mark.len() and data(loop_st_mark)[v] == loop_mark_gen

fact_loop_header = (entry: mut FactState, back: FactState, old: FactState, at: int, widen: bool) -> FactState:
    loop_header_widened = false
    loop_mark_gen = i32(int(loop_mark_gen) + 1)
    if loop_mark_gen == 0:
        loop_mark_gen = 1
        if loop_ch_mark.len() > 0: mem_set(data(loop_ch_mark) as *u8, 0, loop_ch_mark.len() * 4)
        if loop_st_mark.len() > 0: mem_set(data(loop_st_mark) as *u8, 0, loop_st_mark.len() * 4)
    need_mark = fact_terms.len() + 1
    if loop_ch_mark.len() < need_mark:
        loop_ch_mark.resize(need_mark + 256)
        loop_st_mark.resize(need_mark + 256)
    ch_mark = data(loop_ch_mark)
    st_mark = data(loop_st_mark)
    gen = loop_mark_gen
    changing_count = 0
    counters: int[]
    if back.live and entry.live:
        back_b = data(back.bindings)
        entry_b = data(entry.bindings)
        loop i in [0..back.bindings.len()):
            binding = back_b[i]
            original = fact_binding(entry, binding.place)
            if original < 0 or entry_b[original].value == binding.value: continue
            t = if binding.place.root == .local: int(locals[binding.place.declaration].type) else: int(globals[binding.place.declaration].type)
            if fact_scalar(t):
                if ch_mark[binding.value] != gen:
                    ch_mark[binding.value] = gen
                    changing_count += 1
                st_mark[entry_b[original].value] = gen
                b = fact_bound(entry, entry_b[original].value)
                if types[fact_type(t)].kind == .int_ and b.lo == b.hi and not b.wide: counters.push(i)
    lockstep: FactDifference[]
    if counters.len() <= 8 and counters.len() > 1:
        back_b = data(back.bindings)
        entry_b = data(entry.bindings)
        loop i in counters:
            x = fact_bound(entry, entry_b[fact_binding(entry, back_b[i].place)].value)
            link_n = 0
            link0 = FactDifference()
            link1 = FactDifference()
            loop j in counters:
                if j == i: break
                y = fact_bound(entry, entry_b[fact_binding(entry, back_b[j].place)].value)
                if y.lo == FACT_MIN or not fact_add_fits(x.lo, -y.lo) or x.lo - y.lo == FACT_MIN: continue
                rn = 0
                r0 = FactDifference()
                r1 = FactDifference()
                if fact_entails(back, back_b[i].value, back_b[j].value, x.lo - y.lo): r0 = FactDifference(i, j, x.lo - y.lo); rn = 1
                if fact_entails(back, back_b[j].value, back_b[i].value, y.lo - x.lo):
                    if rn == 0: r0 = FactDifference(j, i, y.lo - x.lo)
                    else: r1 = FactDifference(j, i, y.lo - x.lo)
                    rn += 1
                if rn > 0: link_n = rn; link0 = r0; link1 = r1
            if link_n >= 1: lockstep.push(link0)
            if link_n >= 2: lockstep.push(link1)
    if changing_count > 1 and nodes[at].kind == .while_: fact_guard_pairs(int(nodes[at].a), entry, back, lockstep, 0)
    carried: FactDifference[]
    offsets: int[]
    if changing_count > 0 and nodes[at].kind == .while_: fact_offset_guarded(int(nodes[at].a), offsets, 0)
    if changing_count > 0:
        loop row in back.differences:
            upper = fact_loop_is_ch(row.a)
            if not upper and not fact_loop_is_ch(row.b): continue
            if fact_loop_materialize(entry, back, if upper: row.b else: row.a): carried.push(row)
        if offsets.len() > 0:
            loop binding in back.bindings:
                if not fact_loop_is_ch(binding.value) or binding.place.root != .local or binding.place.declaration not in offsets: continue
                fact_loop_paths(entry, back, binding.value, true, carried)
        if nodes[at].kind == .while_:
            direct: FactDifference[]
            fact_guarded_rows(int(nodes[at].a), back, direct, 0)
            if direct.len() == 1:
                row = direct[0]
                other = if fact_loop_is_ch(row.a): row.b else: row.a
                if fact_loop_materialize(entry, back, other): carried.push(row)
        loop binding in back.bindings:
            v = binding.value
            if not fact_loop_is_ch(v): continue
            term = fact_terms[v]
            joined = term.op == .eof and term.a == 0
            if not joined:
                if term.op != .plus and term.op != .minus or term.a == 0 or term.b == 0: continue
                step = fact_bound(back, term.b)
                if step.lo != step.hi or step.lo == 0 or step.lo == FACT_MIN: continue
            falling = joined or (fact_bound(back, term.b).lo < 0) == (term.op == .plus)
            e = fact_binding(entry, binding.place)
            if e < 0: continue
            start = entry.bindings[e].value
            if joined:
                if binding.place.root != .local or types[fact_type(int(locals[binding.place.declaration].type))].kind != .int_: continue
                initial = fact_bound(entry, start)
                if not (initial.lo == initial.hi and not initial.wide) and fact_entails(back, start, v, 0): carried.push(FactDifference(start, v, 0))
            if not falling:
                initial = fact_bound(entry, start)
                if initial.lo == initial.hi and not initial.wide: continue
                if fact_entails(back, start, v, 0): carried.push(FactDifference(start, v, 0))
                ri = fact_difference_head(entry, start, 0)
                seen = 0
                loop ri >= 0 and seen < 8:
                    row = entry.differences[ri]
                    ri = fact_difference_next(entry, ri, 0)
                    seen += 1
                    if row.b == start and row.a != start and fact_entails(back, row.a, v, row.limit): carried.push(FactDifference(row.a, v, row.limit))
                continue
            if fact_entails(back, v, start, 0): carried.push(FactDifference(v, start, 0))
            ri = fact_difference_head(entry, start, 1)
            seen = 0
            loop ri >= 0 and seen < 8:
                row = entry.differences[ri]
                ri = fact_difference_next(entry, ri, 1)
                seen += 1
                if row.a == start and row.b != start and fact_entails(back, v, row.b, row.limit): carried.push(FactDifference(v, row.b, row.limit))
    source = if entry.live: entry else: back
    predecessor = if entry.live: back else: entry
    s = entry
    s.cmp_mask = entry.cmp_mask | back.cmp_mask
    s.live = entry.live or back.live
    s.full = false
    kept: ResultEvidence[]
    loop evidence in entry.conditional:
        if evidence.tag == -2 and (not back.live or evidence in back.conditional): kept.push(evidence)
    s.conditional = kept
    in_place = entry.live
    if not in_place:
        s.bindings = []
        s.index[0].roots = []
    changed_h: int[]
    changed_v: int[]
    changed_o: int[]
    changed_bi: int[]
    src_len = source.bindings.len()
    src_b = data(source.bindings)
    pred_len = predecessor.bindings.len()
    pred_b = data(predecessor.bindings)
    old_len = old.bindings.len()
    old_b = data(old.bindings)
    entry_b = data(entry.bindings)
    loop bi in [0..src_len):
        bp = src_b + bi
        v = bp.value
        peer = -1
        if predecessor.live:
            if bi < pred_len:
                pp = pred_b + bi
                if pp.place.declaration == bp.place.declaration and pp.place.root == bp.place.root and pp.place.owner == bp.place.owner and pp.place.parent == bp.place.parent and pp.place.projection == bp.place.projection and pp.place.selector == bp.place.selector: peer = bi
                else: peer = fact_binding(predecessor, bp.place)
            else: peer = fact_binding(predecessor, bp.place)
        if predecessor.live and peer < 0:
            if in_place:
                prefix = s.bindings[0..bi)
                s.bindings = prefix
                ridx = fact_index_sized(src_len)
                pp = data(prefix)
                loop k in [0..bi): fact_index_put(ridx, fact_root_key(pp[k].place), k)
                s.index[0].roots = ridx
                in_place = false
            continue
        peer_value = if peer >= 0: pred_b[peer].value else: v
        bound = fact_bound(source, v)
        if peer >= 0: bound = fact_hull(bound, fact_bound(predecessor, peer_value), at)
        bound.reason = .loop_; bound.witness = at
        previous = -1
        if bi < old_len:
            op = old_b + bi
            if op.place.declaration == bp.place.declaration and op.place.root == bp.place.root and op.place.owner == bp.place.owner and op.place.parent == bp.place.parent and op.place.projection == bp.place.projection and op.place.selector == bp.place.selector: previous = bi
            else: previous = fact_binding(old, bp.place)
        else: previous = fact_binding(old, bp.place)
        t = if bp.place.root == .local: int(locals[bp.place.declaration].type) else: int(globals[bp.place.declaration].type)
        if widen and previous >= 0:
            orig_lo = bound.lo
            orig_hi = bound.hi
            before = fact_bound(old, old_b[previous].value)
            domain = fact_domain(t, .loop_, at)
            # (a narrow local the body compares with constants stops first at the nearest one,
            # fact_loop_threshold: a 64-bit counter has the counter-progress axiom instead)
            local = if bp.place.root == .local and types[fact_type(t)].kind == .int_ and types[fact_type(t)].bits < 64: bp.place.declaration else: 0
            bound.lo = if bound.lo >= before.lo: before.lo else if local > 0: max(domain.lo, fact_loop_threshold(at, local, bound.lo, false)) else: domain.lo
            # (a counter the condition tests at an offset, growing below any
            # length, stops first at the largest length, where a guard on a
            # length or a bound below one holds it (`loop i+1 <? stop`); past
            # it, at the domain)
            limit = fact_length_max()
            offset = offsets.len() > 0 and bp.place.root == .local and bp.place.declaration in offsets
            stop = if local > 0 and bound.hi > before.hi: min(domain.hi, fact_loop_threshold(at, local, bound.hi, true)) else: domain.hi
            bound.hi = if bound.hi <= before.hi: before.hi else if offset and before.hi < limit and bound.hi <= limit and domain.hi > limit: limit else: stop
            if bound.lo != orig_lo or bound.hi != orig_hi: loop_header_widened = true
        original = if entry.live: bi else: fact_binding(entry, bp.place)
        if original >= 0 and entry_b[original].value == v and v == peer_value:
            slot = fact_slot(s, v)
            if slot < 0: fact_add_value(s, v, bound)
            else if data(s.bounds)[slot] != bound: s.bounds[slot] = bound
            if not in_place: fact_bind(s, bp.place, v)
            else if data(s.bindings)[bi].event != 0 or data(s.bindings)[bi].prior != 0:
                s.bindings[bi] = FactBinding(bp.place, v)
        else:
            if refine_active: bound = ref_interval(t, bound)
            prior = if original >= 0: entry_b[original].value else: v
            nv = fact_new(s, bound, FactTerm(type = fact_hull_type(t, source, v, predecessor, peer_value)))
            h = if in_place: bi else: s.bindings.len()
            if in_place:
                if at != 0: s.bindings[bi] = FactBinding(bp.place, nv, at, prior)
                else: s.bindings[bi] = FactBinding(bp.place, nv)
            else:
                fact_rebind(s, bp.place, nv, at, prior)
            if nv != v:
                changed_h.push(h)
                changed_v.push(v)
                changed_o.push(peer_value)
                changed_bi.push(bi)
    shape_steps = FACT_CAP
    loop ci in [0..changed_h.len()):
        hv = s.bindings[changed_h[ci]].value
        bv = changed_v[ci]
        other = changed_o[ci]
        fact_loop_shape(s, source, predecessor, bv, other, hv, shape_steps, 0)
        if fact_summary_payload(fact_type(fact_terms[hv].type)) != 0:
            if widen: loop_header_widened = true
            fact_loop_payload(s, source, bv, predecessor, other, hv, old, source.bindings[changed_bi[ci]].place, widen)
        if fact_grown_roots.len() > 0: fact_join_grown(s, source, bv, predecessor, other, hv)
    if carried.len() > 0:
        binding_values: int[]
        if back.live and entry.live:
            back_b = data(back.bindings)
            loop i in [0..back.bindings.len()):
                bv = back_b[i].value
                if fact_index_get(binding_values, bv) < 0: fact_index_put(binding_values, bv, i)
        loop row in carried:
            upper = fact_loop_is_ch(row.a)
            value = if upper: row.a else: row.b
            other = if upper: row.b else: row.a
            found = fact_index_get(binding_values, value)
            if found < 0: continue
            e = fact_binding(entry, back.bindings[found].place)
            h = fact_binding(s, back.bindings[found].place)
            if e < 0 or h < 0 or fact_slot(s, other) < 0: continue
            start = entry.bindings[e].value
            v = s.bindings[h].value
            if upper and not fact_entails(entry, start, other, row.limit): continue
            if not upper and not fact_entails(entry, other, start, row.limit): continue
            if widen:
                p = fact_binding(old, back.bindings[found].place)
                if p >= 0 and old.bindings[p].value != start:
                    r = if upper: fact_row_find(old, old.bindings[p].value, other) else: fact_row_find(old, other, old.bindings[p].value)
                    if r < 0 or old.differences[r].limit < row.limit:
                        loop_header_widened = true
                        continue
            o = fact_bound(s, other)
            b = fact_bound(s, v)
            if upper:
                fact_difference(s, v, other, row.limit, row.at)
                if fact_add_fits(o.hi, row.limit): b.hi = min(b.hi, o.hi + row.limit)
            else:
                fact_difference(s, other, v, row.limit, row.at)
                if o.lo != FACT_MIN and row.limit != FACT_MIN and fact_add_fits(o.lo, -row.limit): b.lo = max(b.lo, o.lo - row.limit)
            fact_set_bound(s, v, b)
    loop row in lockstep:
        p = fact_binding(s, back.bindings[row.a].place)
        q = fact_binding(s, back.bindings[row.b].place)
        if p < 0 or q < 0: continue
        a = s.bindings[p].value; b = s.bindings[q].value
        fact_difference(s, a, b, row.limit, at)
        x = fact_bound(s, a); y = fact_bound(s, b)
        if fact_add_fits(y.hi, row.limit): x.hi = min(x.hi, y.hi + row.limit)
        if x.lo != FACT_MIN and fact_add_fits(x.lo, -row.limit): y.lo = max(y.lo, x.lo - row.limit)
        fact_set_bound(s, a, x)
        fact_set_bound(s, b, y)
    s
# Widening's threshold for integer local l of loop at: the nearest constant c (or c+1 above,
# c-1 below) at least `past` (up) or at most it (down) that the loop compares l with directly
# (`if near <? 10 { near += 1 }` stops at 10), else the domain's end. The next header keeps it
# only when the body holds l there; each widening moves past it, so a loop settles after at
# most one stop per constant. O(loop nodes) per widened local.
fact_loop_threshold = (at: int, l: int, past: int, up: bool) -> int:
    best = if up: FACT_MAX else: FACT_MIN
    work: int[] = [at]
    seen = 0
    loop work.len() > 0 and seen < 4096:
        n = work.pop()
        seen += 1
        if n <= 0: continue
        k = nodes[n].kind
        if k == .binary:
            op = nodes[n].op as Tok
            if op == .lt or op == .le or op == .gt or op == .ge or op == .eq or op == .ne:
                a = int(nodes[n].a)
                b = int(nodes[n].b)
                loop nodes[a].kind == .conv: a = int(nodes[a].a)
                loop nodes[b].kind == .conv: b = int(nodes[b].a)
                c = if nodes[b].kind == .int_lit and nodes[a].kind == .ident and int(nodes[a].sym) == l: b else if nodes[a].kind == .int_lit and nodes[b].kind == .ident and int(nodes[b].sym) == l: a else: 0
                if c > 0:
                    v = int(nodes[c].ival)
                    if v > -(1 << 62) and v < (1 << 62):
                        loop candidate in [v, if up: v + 1 else: v - 1]:
                            if up and candidate >= past and candidate < best: best = candidate
                            if not up and candidate <= past and candidate > best: best = candidate
        mask = isolation_children(k)
        if mask <= 0: continue
        if mask & 1 != 0: work.push(int(nodes[n].a))
        if mask & 2 != 0: work.push(int(nodes[n].b))
        if mask & 4 != 0: work.push(int(nodes[n].c))
        if mask & 16 != 0:
            loop i in [0..nkids(n)): work.push(kid(n, i))
    best
# Locals a loop condition compares at a constant offset (`i+2 <? n`), through
# `and`/`or`. O(condition nodes), at most 16 deep.
fact_offset_guarded = (e: int, out: mut int[], depth: int):
    if e == 0 or depth > 16: return
    k = nodes[e].kind
    if k == .and_ or k == .or_:
        fact_offset_guarded(int(nodes[e].a), out, depth + 1)
        fact_offset_guarded(int(nodes[e].b), out, depth + 1)
        return
    if k != .binary or not fact_comparison_raw(nodes[e].op): return
    loop side in [int(nodes[e].a), int(nodes[e].b)]:
        x = side
        loop x != 0 and nodes[x].kind == .conv: x = int(nodes[x].a)
        if x == 0 or nodes[x].kind != .binary or (nodes[x].op != i32(int(Tok.plus)) and nodes[x].op != i32(int(Tok.minus))): continue
        loop operand in [int(nodes[x].a), int(nodes[x].b)]:
            if nodes[operand].kind == .ident and nodes[operand].aux == i32(int(SK.local)): out.push(int(nodes[operand].sym))
# Read an already established scalar/field/array-length identity without
# evaluating syntax or replaying effects. O(route depth), at most 16.
fact_guard_value = (e: int, s: FactState, depth: int = 0) -> int:
    if e == 0 or depth > 16: return 0
    k = nodes[e].kind
    if k == .conv: return fact_guard_value(int(nodes[e].a), s, depth + 1)
    if k == .ident:
        i = fact_binding(s, fact_place(e))
        return if i >= 0: s.bindings[i].value else: 0
    base = 0; selector = 0
    if fact_field_node(e):
        base = fact_guard_value(int(nodes[e].a), s, depth + 1)
        selector = if nodes[e].aux == -2: int(nodes[e].ival) else: int(nodes[e].name)
    else if k == .call and fact_string_call(e) == 1:
        base = fact_guard_value(kid(e, 0), s, depth + 1)
        selector = -1
    else if k == .intrinsic and nodes[e].aux == i32(int(IN.len)) and nkids(e) == 1 and tkind(fact_type(ntype(kid(e, 0)))) == .array:
        base = fact_guard_value(kid(e, 0), s, depth + 1)
        selector = -1
    if base == 0: return 0
    i = fact_projection_find(s, base, selector, false)
    if i >= 0: return s.projections[i].value
    0
# A direct scanner comparison selects only its named endpoint, not every
# reachable row (which would spend a coupled counter's incident-row budget).
# O(condition nodes), depth <= 16, one bounded indexed path query per selected
# pair. These are candidates: fact_loop_header still checks entry/preservation.
fact_guarded_rows = (e: int, back: FactState, carried: mut FactDifference[], depth: int):
    if e == 0 or depth > 16: return
    k = nodes[e].kind
    if k == .and_ or k == .or_:
        fact_guarded_rows(int(nodes[e].a), back, carried, depth + 1)
        fact_guarded_rows(int(nodes[e].b), back, carried, depth + 1)
        return
    if k != .binary or nodes[e].aux != 0 or not fact_comparison_raw(nodes[e].op): return
    sides = [int(nodes[e].a), int(nodes[e].b)]
    loop direction in [0..2):
        a = sides[direction]; b = sides[1 - direction]
        loop nodes[a].kind == .conv: a = int(nodes[a].a)
        loop nodes[b].kind == .conv: b = int(nodes[b].a)
        if nodes[a].kind != .ident: continue
        v = fact_guard_value(a, back); other = fact_guard_value(b, back)
        if v == 0 or other == 0: continue
        if not fact_loop_is_ch(v) or fact_loop_is_ch(other): continue
        limit = fact_shortest(back, v, other)
        if limit != FACT_MAX: carried.push(FactDifference(v, other, limit, e))
        # (and from below: `loop stop >? start ... stop -= 1` keeps stop at least start)
        below = fact_shortest(back, other, v)
        if below != FACT_MAX: carried.push(FactDifference(other, v, below, e))
# A comparison of two changing locals (through `and`/`or`) as a lockstep row
# over back's binding indexes: `a <? b` offers `a - b <= 0`, `a <=? b` offers
# `a - b <= 1`, kept only when entry and backedge entail it. Depth <= 16.
fact_guard_pairs = (e: int, entry: FactState, back: FactState, out: mut FactDifference[], depth: int):
    if e == 0 or depth > 16: return
    k = nodes[e].kind
    if k == .and_ or k == .or_:
        fact_guard_pairs(int(nodes[e].a), entry, back, out, depth + 1)
        fact_guard_pairs(int(nodes[e].b), entry, back, out, depth + 1)
        return
    if k != .binary or nodes[e].aux != 0: return
    op = nodes[e].op as Tok
    if op != .lt and op != .le and op != .gt and op != .ge: return
    a = int(nodes[e].a); b = int(nodes[e].b)
    if op == .gt or op == .ge:
        a = int(nodes[e].b); b = int(nodes[e].a)
    loop nodes[a].kind == .conv: a = int(nodes[a].a)
    loop nodes[b].kind == .conv: b = int(nodes[b].a)
    if nodes[a].kind != .ident or nodes[b].kind != .ident: return
    i = fact_binding(back, fact_place(a)); j = fact_binding(back, fact_place(b))
    x = fact_binding(entry, fact_place(a)); y = fact_binding(entry, fact_place(b))
    if i < 0 or j < 0 or x < 0 or y < 0 or i == j: return
    if not fact_loop_is_ch(back.bindings[i].value) or not fact_loop_is_ch(back.bindings[j].value): return
    limit = if op == .lt or op == .gt: 0 else: 1
    if fact_entails(entry, entry.bindings[x].value, entry.bindings[y].value, limit) and fact_entails(back, back.bindings[i].value, back.bindings[j].value, limit): out.push(FactDifference(i, j, limit, e))
# Common projection skeleton of changing loop aggregates. Leaves keep their
# immutable identity only when both entry and backedge have that identity.
# Recurse through changed aggregates so indexed inner lengths survive; never
# merge a changed scalar here. Indexed lookup per demanded projection, O(P)
# for a tree; shared DAG paths also share a FACT_CAP visit budget per header.
fact_loop_shape = (s: mut FactState, a: FactState, b: FactState, x: int, y: int, into: int, steps: mut int, depth: int):
    if depth >= 32 or x == 0 or y == 0 or into == 0: return
    pool = fact_pool_type(fact_terms[x].type) or is_map_type(representation_type(fact_terms[x].type))
    pi = fact_projection_first(a, x)
    loop pi >= 0:
        if steps <= 0: return
        steps -= 1
        p = a.projections[pi]
        pi = fact_projection_after(a, pi)
        if s.projections.len() >= FACT_CAP: return
        if fact_slot(s, p.value) < 0 or p.element and fact_slot(s, p.selector) < 0: continue
        if p.element and pool and fact_bound(a, p.value).lo < 1: continue
        qi = fact_projection_find(b, y, p.selector, p.element)
        if qi < 0 and p.element and b.live: qi = fact_projection_constant(a, b, y, p.selector)
        if b.live and qi < 0: continue
        other = if qi >= 0: b.projections[qi].value else: p.value
        v = p.value
        if v != other:
            t = fact_terms[v].type
            if p.element and pool: continue
            if (t == 0 or fact_scalar(t)) and (fact_terms[other].type == 0 or fact_scalar(fact_terms[other].type)):
                # (a changed scalar both edges hold at one constant, as a
                # shape's extent or a data length: that constant; any other
                # changed scalar is dropped, so this settles at once)
                x0 = fact_bound(a, p.value); y0 = fact_bound(b, other)
                # (or the backedge's value equals entry's immutable one, as a
                # shape binder's extent passed through: that identity)
                if b.live and fact_slot(b, p.value) >= 0 and fact_entails(b, other, p.value, 0) and fact_entails(b, p.value, other, 0): v = p.value
                else if not p.element and p.selector == -1 and not x0.wide and not y0.wide and (x0.lo != x0.hi or y0.lo != x0.lo or y0.hi != x0.hi):
                    # (a resized length keeps each entry bound the backedge
                    # respects, `xs.push` a lower and `xs.pop` an upper one, and
                    # widens the other to the length domain, so this settles in
                    # a round; stability re-validates the interval)
                    lo = if y0.lo >= x0.lo: x0.lo else: 0
                    hi = if y0.hi <= x0.hi: x0.hi else: fact_length_max()
                    # (a length the backedge holds at least at entry's keeps that row, so a position below
                    # the entry length stays below: one entailment per changed length, as stability rechecks)
                    grows = b.live and fact_incident(a, p.value) >= 0 and fact_slot(b, p.value) >= 0 and fact_entails(b, p.value, other, 0)
                    if lo <= 0 and hi >= fact_length_max() and not grows: continue
                    v = fact_new(s, FactBound(lo, hi, lo > 0), FactTerm(type = t))
                    if grows: fact_difference(s, p.value, v, 0)
                else if x0.wide or y0.wide or x0.lo != x0.hi or y0.lo != x0.lo or y0.hi != x0.hi: continue
                else: v = fact_new(s, FactBound(x0.lo, x0.hi, x0.nz), FactTerm(type = t))
            else:
                if t == 0 or fact_scalar(t) or fact_terms[other].type != t: continue
                v = fact_new(s, fact_domain(t), FactTerm(type = t))
                if v == 0: return
                fact_loop_shape(s, a, b, p.value, other, v, steps, depth + 1)
                if fact_projection_first(s, v) < 0: continue
            if v == 0: return
        if s.projections.len() < FACT_CAP: fact_add_projection(s, FactProjection(into, p.selector, p.element, v))
    # (an N-D value whose data both edges know matches its shape keeps that
    # marker on the header value itself: the pair it is keyed by is fresh)
    if is_nd(representation_type(fact_terms[into].type)) and s.projections.len() < FACT_CAP and fact_nd_valid_held(a, x) and (not b.live or fact_nd_valid_held(b, y)):
        fact_add_projection(s, FactProjection(into, ND_STORAGE_VALID, false, fact_new(s, FactBound(1, 1, true), FactTerm(type = T_INT))))
# The element projection of y in b whose selector is the same constant as
# selector in a (each edge evaluates its own `0` for an axis), or -1.
# O(projections of y), at most FACT_PROJECTION_SCAN.
fact_projection_constant = (a: FactState, b: FactState, y: int, selector: int) -> int:
    k = fact_bound(a, selector)
    if k.wide or k.lo != k.hi: return -1
    qi = fact_projection_first(b, y)
    scanned = 0
    loop qi >= 0 and scanned < FACT_PROJECTION_SCAN:
        q = b.projections[qi]
        if q.element:
            c = fact_bound(b, q.selector)
            if not c.wide and c.lo == k.lo and c.hi == k.hi: return qi
        qi = fact_projection_after(b, qi)
        scanned += 1
    -1
# Rows v - o <= d (upper) or o - v <= d from back's paths out of changing v to
# values entry holds (or materializes) that do not change, beyond direct rows.
fact_loop_paths = (entry: mut FactState, back: FactState, v: int, upper: bool, carried: mut FactDifference[]):
    terms = [v]
    distances = [0]
    cursor = 0
    visits = 0
    loop cursor < terms.len():
        source = terms[cursor]
        distance = distances[cursor]
        cursor += 1
        previous = -1
        ri = fact_difference_head(back, source, int(upper))
        loop ri >= 0:
            row = back.differences[ri]
            visits += ri - previous
            previous = ri
            ri = fact_difference_next(back, ri, int(upper))
            if visits > 256: return
            if not fact_add_fits(distance, row.limit): continue
            other = if upper: row.b else: row.a
            value = distance + row.limit
            seen = -1
            loop t in [0..terms.len()):
                if terms[t] == other: seen = t
            if seen >= 0:
                if value < distances[seen]: distances[seen] = value
                continue
            if terms.len() >= 32: continue
            terms.push(other)
            distances.push(value)
    loop t in [1..terms.len()):
        o = terms[t]
        if fact_loop_is_ch(o) or fact_loop_is_st(o) or not fact_loop_materialize(entry, back, o): continue
        carried.push(if upper: FactDifference(v, o, distances[t]) else: FactDifference(o, v, distances[t]))
# Nothing is known of v beyond its interval: no projections, no rows.
fact_top = (s: FactState, v: int) -> bool:
    fact_projection_first(s, v) < 0 and fact_incident(s, v) < 0
# Two header aggregates whose contents changed (an element written each
# iteration) are settled when they carry the same projection skeleton:
# the same leaves under stable selectors, and rows equal after renaming.
fact_same_shape = (a: FactState, b: FactState, x: int, y: int, steps: mut int, renamed: mut {int: int}, depth: int = 0) -> bool:
    if depth >= 32: return false
    count = 0
    pi = fact_projection_first(a, x)
    loop pi >= 0:
        if steps <= 0: return false
        steps -= 1
        p = a.projections[pi]
        pi = fact_projection_after(a, pi)
        count += 1
        qi = fact_projection_find(b, y, p.selector, p.element)
        if qi < 0: return false
        other = b.projections[qi].value
        if p.value != other:
            t = fact_terms[p.value].type
            if fact_terms[other].type != t or fact_bound(a, p.value) != fact_bound(b, other): return false
            if t == 0 and fact_projection_first(a, p.value) >= 0: return false
            # (fresh header scalars agree when their bounds and skeletons do)
            if not fact_same_shape(a, b, p.value, other, steps, renamed, depth + 1): return false
    qi = fact_projection_first(b, y)
    loop qi >= 0:
        count -= 1
        qi = fact_projection_after(b, qi)
    if count != 0: return false
    if fact_incident(a, x) < 0 and fact_incident(b, y) < 0: return true
    # Fresh projected scalars can carry identical rows in consecutive headers.
    # O(demanded projections + rows), within the existing shape budget.
    fact_scalar(fact_terms[x].type) and fact_shape_rename(renamed, x, y)
fact_shape_rename = (renamed: mut {int: int}, x: int, y: int) -> bool:
    old = renamed.get(x)
    inverse = renamed.get(-y)
    if old != none and old != y or inverse != none and inverse != x: return false
    renamed[x] = y
    renamed[-y] = x
    true
# A changing optional integer at a loop header: its payload's interval (the
# paths' hull, widened as a changing scalar's) and implications from its tag
# (fact_join_payload) relating it to values entry and the backedge share.
# Stability compares those implications. O(fact_join_payload).
fact_loop_payload = (s: mut FactState, a: FactState, x: int, b: FactState, y: int, into: int, old: FactState, place: PlaceIdentity, widen: bool):
    pt = fact_summary_payload(fact_type(fact_terms[into].type))
    bound = FactBound()
    seen = false
    loop side in [0..2):
        st = if side == 0: a else: b
        v = if side == 0: x else: y
        if not st.live or fact_known_none(st, v): continue
        p = fact_projection_value(st, v, -4)
        if p == 0: return
        bound = if seen: fact_hull(bound, fact_bound(st, p), 0) else: fact_bound(st, p)
        seen = true
    if not seen: return
    previous = fact_binding(old, place)
    before = if previous >= 0: fact_projection_value(old, old.bindings[previous].value, -4) else: 0
    if widen and before != 0:
        last = fact_bound(old, before)
        domain = fact_domain(pt)
        bound.lo = if bound.lo < last.lo: domain.lo else: last.lo
        bound.hi = if bound.hi <= last.hi: last.hi else: domain.hi
        bound.nz = bound.nz and last.nz
    fact_join_payload(s, a, x, b, y, into, [], [], [], bound, true)
fact_loop_stable = (a: FactState, b: FactState) -> bool:
    shape_steps = FACT_CAP
    renamed: {int: int} = {}
    ab = data(a.bindings)
    bb = data(b.bindings)
    an = a.bindings.len()
    bn = b.bindings.len()
    same_bounds = data(a.bounds) == data(b.bounds) and data(a.ids) == data(b.ids)
    loop bi in [0..an):
        ap = ab + bi
        i = -1
        if bi < bn:
            bp = bb + bi
            if bp.place.declaration == ap.place.declaration and bp.place.root == ap.place.root and bp.place.owner == ap.place.owner and bp.place.parent == ap.place.parent and bp.place.projection == ap.place.projection and bp.place.selector == ap.place.selector: i = bi
            else: i = fact_binding(b, ap.place)
        else: i = fact_binding(b, ap.place)
        if i < 0: return false
        av = ap.value
        bv = bb[i].value
        if av == bv and same_bounds: continue
        x = fact_bound(a, av)
        y = fact_bound(b, bv)
        if x.lo != y.lo or x.hi != y.hi or x.nz != y.nz or (av != bv and data(fact_terms)[av].type != data(fact_terms)[bv].type): return false
        # Aggregate identity carries its projections; an equal top interval
        # alone is not evidence that a changed aggregate has stabilized. Two
        # header aggregates with no projections or rows are both top.
        if av != bv:
            t = if ap.place.root == .local: int(locals[ap.place.declaration].type) else: int(globals[ap.place.declaration].type)
            if not fact_scalar(t) and not (fact_top(a, av) and fact_top(b, bv)) and not fact_same_shape(a, b, av, bv, shape_steps, renamed): return false
    # Carried rows must return unchanged, renamed into the next frame.
    if a.differences.len() != b.differences.len(): return false
    if a.differences.len() == 0: return fact_loop_stable_implications(a, b)
    shaped = renamed.len() > 0
    any_ren = shaped
    loop bi in [0..an):
        ap = ab + bi
        av = ap.value
        if not shaped and renamed.len() > 0 and renamed.has(av): continue
        i = -1
        if bi < bn:
            bp = bb + bi
            if bp.place.declaration == ap.place.declaration and bp.place.root == ap.place.root and bp.place.owner == ap.place.owner and bp.place.parent == ap.place.parent and bp.place.projection == ap.place.projection and bp.place.selector == ap.place.selector: i = bi
            else: i = fact_binding(b, ap.place)
        else: i = fact_binding(b, ap.place)
        other = if i >= 0: bb[i].value else: 0
        if shaped:
            if not fact_shape_rename(renamed, av, other): return false
        else if av != other:
            renamed[av] = other
            any_ren = true
    adiffs = data(a.differences)
    bdiffs = data(b.differences)
    ndiffs = a.differences.len()
    loop di in [0..ndiffs):
        row = adiffs + di
        # Unrenamed snapshots remain themselves; distinct terms cannot merge.
        if shaped and (renamed.has(-row.a) and not renamed.has(row.a) or renamed.has(-row.b) and not renamed.has(row.b)): return false
        x = if any_ren: renamed.get(row.a) ?? row.a else: row.a
        y = if any_ren: renamed.get(row.b) ?? row.b else: row.b
        i = fact_row_find(b, x, y)
        if i < 0 or bdiffs[i].limit != row.limit: return false
    fact_loop_stable_implications(a, b)
# Iterator transfers publish their pre-killed exit state and optional counted
# lengths, not the body's backedge. In a return-summary run the body is only
# demanded if it can itself return from this function. Checking runs still
# visit it for every obligation. The memoized query is O(nodes + edges).
fact_may_return = (n: int) -> bool:
    if n == 0: return false
    if let known = fact_returns_cache.get(n): return known
    yes = nodes[n].kind == .return_
    if not yes:
        loop c in fact_slice_children(n):
            if fact_may_return(c): yes = true; break
    fact_returns_cache[n] = yes
    yes
fact_loop_body = (n: int, body: mut FactState) -> FactLoop:
    if nodes[n].kind == .for_ and fact_summary_owner != 0 and not fact_may_return(int(nodes[n].b)): return FactLoop()
    fact_loops.push(FactLoop())
    fact_capture(int(nodes[n].b), body)
    edges = fact_loops.pop()
    edges.back = fact_join(edges.back, body, n)
    edges
# A scanner may first read its array parameter in the condition. Seed only
# pure local roots on comparison/field/length spines before taking entry, so
# that an unchanged root and its length retain their identity across headers.
# No assumptions or effectful reads; at most 32 condition nodes, only for a
# demanded loop. Ordinary stores and calls still replace these evaluations.
fact_loop_roots = (n: int, s: mut FactState, budget: mut int):
    if n <= 0 or budget <= 0: return
    budget -= 1
    k = nodes[n].kind
    if k == .ident:
        if fact_preread_local(n): fact_read(s, n)
    else if k == .and_ or k == .or_ or k == .binary and nodes[n].aux == 0 and fact_comparison_raw(nodes[n].op):
        fact_loop_roots(int(nodes[n].a), s, budget)
        fact_loop_roots(int(nodes[n].b), s, budget)
    else if k == .conv or fact_field_node(n): fact_loop_roots(int(nodes[n].a), s, budget)
    else if k == .call and fact_string_call(n) == 1 or k == .intrinsic and nodes[n].aux == i32(int(IN.len)) and nkids(n) == 1:
        fact_loop_roots(kid(n, 0), s, budget)
# A private local whose declaration is the actual storage the ident reads.
fact_cursor_local = (n: int) -> bool:
    if not fact_preread_local(n): return false
    flags = int(locals[int(nodes[n].sym)].flags)
    flags & (LF_MUTPARAM | LF_CAPTURE | LF_CAPTURED | LF_SHARED | LF_ADDR | LF_BYREF | LF_EXPOSED | LF_ELEMALIAS | LF_SOAELEM) == 0
# Only boolean combinations of scalar reads, byte indexing and direct,
# checked byte predicates whose complete write footprint is empty.
fact_cursor_predicate = (n: int, cursor: int, budget: mut int) -> bool:
    if n == 0 or budget <= 0: return false
    budget -= 1
    k = nodes[n].kind
    a = int(nodes[n].a)
    b = int(nodes[n].b)
    if k == .and_ or k == .or_ or k == .binary and nodes[n].aux == 0 and fact_comparison_raw(nodes[n].op):
        return fact_cursor_predicate(a, cursor, budget) and fact_cursor_predicate(b, cursor, budget)
    if k == .not_: return fact_cursor_predicate(a, cursor, budget)
    if k == .int_lit or k == .bool_lit: return true
    if k == .ident: return fact_cursor_local(n) and (ntype(n) == T_BOOL or ntype(n) == T_U8)
    if k == .index:
        return fact_cursor_local(a) and tkind(ntype(a)) == .array and telem(ntype(a)) == T_U8 and nkids(n) == 1 and kid(n, 0) == b and fact_preread_local(b) and int(nodes[b].sym) == cursor
    if k != .call or a != 0 or nodes[n].aux != 0 or nkids(n) != 1 or ntype(n) != T_BOOL: return false
    f = int(nodes[n].sym)
    if f <= 0 or f >= fns.len() or fns[f].state != 2 or fns[f].body == 0 or fns[f].has_env or fns[f].params.len() != 1: return false
    arg = kid(n, 0)
    param = fns[f].params[0]
    if locals[param].type != T_U8 or int(locals[param].flags) & LF_MUTPARAM != 0 or ntype(arg) != T_U8 or not fact_cursor_predicate(arg, cursor, budget): return false
    if fact_summary_owner != 0 and (f >= effect_summaries.len() or not effect_summaries[f].done): return false
    if not effects_demand(f, true) or effect_summaries[f].cut or effect_summaries[f].callbacks != 0 or effect_summaries[f].opaque_other: return false
    loop event in effect_summaries[f].events:
        if event.atom.kind != .read and event.atom.kind != .panic: return false
    true
# On the demanded while transfer only. The conjunction's first operand must
# guard the very local that advances once on the sole continuing edge.
fact_cursor_shape = (n: int) -> bool:
    condition = int(nodes[n].a)
    guard = int(nodes[condition].a)
    body = int(nodes[n].b)
    if nodes[guard].kind != .binary or nodes[guard].aux != 0 or (nodes[guard].op as Tok) != .lt or nodes[body].kind != .block or nkids(body) != 1: return false
    cursor = int(nodes[guard].a)
    limit = int(nodes[guard].b)
    if not fact_cursor_local(cursor) or not fact_cursor_local(limit) or ntype(cursor) != T_INT or ntype(limit) != T_INT or nodes[cursor].sym == nodes[limit].sym: return false
    store = kid(body, 0)
    target = int(nodes[store].a)
    if nodes[store].kind != .assign or nodes[store].aux != 0 or not fact_preread_local(target) or nodes[target].sym != nodes[cursor].sym or ntype(target) != T_INT: return false
    rhs = int(nodes[store].b)
    op = nodes[store].op as Tok
    if op == .assign:
        # A checked int64 compound update is lowered to a fixed store of i+1.
        if nodes[rhs].kind == .conv and nodes[rhs].aux == i32(int(CV.fixed_store)) and ntype(rhs) == T_INT: rhs = int(nodes[rhs].a)
        if nodes[rhs].kind != .binary or nodes[rhs].aux != 0 or (nodes[rhs].op as Tok) != .plus or ntype(rhs) != T_INT: return false
        read = int(nodes[rhs].a)
        if not fact_preread_local(read) or nodes[read].sym != nodes[cursor].sym: return false
        rhs = int(nodes[rhs].b)
    else if op != .pluseq: return false
    if nodes[rhs].kind != .int_lit or nodes[rhs].ival != 1 or ntype(rhs) != T_INT: return false
    budget = 64
    fact_cursor_predicate(int(nodes[condition].b), int(nodes[cursor].sym), budget)
# O(predicate size + demanded effect rows) once per candidate. Bounds and
# relations depend on this entry, so recompute them even on a shape cache hit.
fact_cursor_header = (n: int, entry: FactState, header: mut FactState) -> bool:
    if ownership_fact_cleanup or fact_loop_exhausted: return false
    yes = false
    if let known = fact_cursor_shapes.get(n): yes = known
    else:
        yes = fact_cursor_shape(n)
        fact_cursor_shapes[n] = yes
    if not yes: return false
    guard = int(nodes[int(nodes[n].a)].a)
    place = fact_place(int(nodes[guard].a))
    start = fact_guard_value(int(nodes[guard].a), entry)
    stop = fact_guard_value(int(nodes[guard].b), entry)
    if start == 0 or stop == 0 or entry.ids.len() >= FACT_CAP: return false
    x = fact_bound(entry, start)
    y = fact_bound(entry, stop)
    if x.wide or y.wide: return false
    # Preserve the exact entry if the old transfer can refute the first
    # trip (including a byte or flag known false only at the entry cursor).
    outer = fact_speculating
    fact_speculating += 1
    first = fact_condition(int(nodes[n].a), entry)
    fact_speculating = outer
    if fact_loop_exhausted: return false
    if not first.yes.live: return true
    # Every header is either entry or the result of adding one below stop.
    # Strict comparison makes this representable even when stop is INT64_MAX.
    # The only write replaces this private scalar. All other bindings survive.
    value = fact_new(header, FactBound(x.lo, max(x.hi, y.hi), reason = .loop_, witness = n), FactTerm(type = T_INT))
    if value == 0: return false
    fact_rebind(header, place, value, n, start)
    fact_difference(header, start, value, 0, n)
    if fact_entails(entry, start, stop, 0): fact_difference(header, value, stop, 0, n)
    true
fact_while = (n: int, s: mut FactState):
    roots = 32
    fact_loop_roots(int(nodes[n].a), s, roots)
    outer = fact_speculating
    entry = s
    header = s
    if nodes[int(nodes[n].a)].kind == .and_ and fact_cursor_header(n, entry, header):
        s = fact_while_exit(n, entry, header)
        return
    s = FactState(live = false)
    settled = false
    fact_speculating += 1
    # Eager interval widening converges quickly; a fourth round lets
    # dependencies between changing counters settle before validation.
    dummy_s = FactState(live = false)
    edges = FactLoop()
    loop iteration in [0..4):
        if fact_loop_exhausted: break
        body_s = header
        fact_cond_out(int(nodes[n].a), body_s, dummy_s, true, false, true)
        edges = fact_loop_body(n, body_s)
        next = fact_loop_header(entry, edges.back, header, n, true)
        settled = fact_loop_stable(header, next)
        if settled: break
        header = next
    if settled and not fact_loop_exhausted:
        # A settled round's header equals the one it ran with, so its
        # backedge is what a run with the settled header gives: narrow from
        # it rather than walking the body again. When widening changed nothing,
        # narrowing is identical to the settled header.
        same = true
        if loop_header_widened:
            next = fact_loop_header(entry, edges.back, header, n, false)
            same = fact_loop_stable(header, next)
            if not same: header = next
        # (inside an enclosing loop's speculation nothing is published: a
        # header that narrowing left unchanged exits as the settled round did)
        if same and outer > 0:
            fact_cond_out(int(nodes[n].a), header, dummy_s, true, false, false)
            fact_speculating = outer
            s = fact_join(header, edges.exits, n)
            return
    fact_speculating = outer
    if not settled or fact_loop_exhausted:
        # Restart at top for every syntactically changing route, then validate
        # normally. Speculative obligation answers are never published.
        header = entry
        fact_changes(n, header, n, .budget)
    s = fact_while_exit(n, entry, header)
fact_while_exit = (n: int, entry: mut FactState, header: mut FactState) -> FactState:
    # (positions the body keeps below a length: fact_loop_bounds)
    demands = fact_loop_bound_entry(fact_loop_bound_demands(n), entry)
    if demands.len() > 0: fact_loop_bounds(n, header, demands, FACT_PREP_CONDITION, 0, 0, 0, [])
    exit_no = FactState(live = false)
    fact_cond_out(int(nodes[n].a), header, exit_no, true, true, true)
    edges = fact_loop_body(n, header)
    fact_join(exit_no, edges.exits, n)

use 'facts_elements.dewy'
use 'refine_siblings.dewy'
loop_bound_speculation: *(int)
loop_bound_steps: *(int)
loop_bound_exhausted: *(bool)
facts_loop_bounds_bind = (speculation: *(int), steps: *(int), exhausted: *(bool)) -> int:
    loop_bound_speculation = speculation
    loop_bound_steps = steps
    loop_bound_exhausted = exhausted
    0

fact_loop_prepare = (n: int, body: mut FactState, prep: int, base: int, pushes: (int, int)[]):
    fact_growing_lengths(body, pushes)
    if prep == FACT_PREP_INDEXED:
        fact_loop_index(n, base, body)
        ref_sib_loop_elements(n, base, body)
    else if prep == FACT_PREP_MAPPED: fact_map_loop(n, base, body)
    else: fact_capture(int(nodes[n].a), body)

fact_loop_index_local = (m: int) -> int:
    if tkind(fact_type(ntype(int(nodes[m].a)))) != .array: return 0
    a = int(nodes[m].a)
    loop fact_field_node(a): a = int(nodes[a].a)
    if nodes[a].kind != .ident or nodes[a].aux != i32(int(SK.local)): return 0
    x = int(nodes[m].b)
    loop nodes[x].kind == .conv: x = int(nodes[x].a)
    if nodes[x].kind != .ident or nodes[x].aux != i32(int(SK.local)): return 0
    int(nodes[x].sym)

fact_loop_bound_demands = (n: int) -> int[]:
    out: int[]
    if fact_slice.loop_indexes.len() == 0: return out
    carried: int[]
    walked = false
    loop m in fact_slice.loop_indexes:
        if nodes[m].pos < nodes[n].pos: continue
        x = fact_loop_index_local(m)
        if locals[x].pos >= nodes[n].pos: continue
        if not walked:
            carried = fact_carried_assigns(n)
            walked = true
        loop e in carried:
            if int(nodes[int(nodes[e].a)].sym) == x and fact_slice_flags(e) & (FACT_MEMBER | FACT_ACTIVE) != FACT_MEMBER:
                out.push(m)
                break
        if out.len() >= 4: break
    out

fact_loop_unbounded_field = (e0: int) -> bool:
    e = e0
    loop e != 0 and nodes[e].kind == .conv: e = int(nodes[e].a)
    e != 0 and fact_field_node(e) and is_int(ntype(e)) and refine_storage(e, ntype(e)) == ntype(e)

fact_loop_step = (e0: int, x: int) -> bool:
    e = e0
    loop e != 0 and nodes[e].kind == .conv: e = int(nodes[e].a)
    if e == 0 or nodes[e].kind != .binary or nodes[e].op != i32(int(Tok.plus)) and nodes[e].op != i32(int(Tok.minus)): return false
    loop side in [int(nodes[e].a), int(nodes[e].b)]:
        v = side
        loop v != 0 and nodes[v].kind == .conv: v = int(nodes[v].a)
        if v != 0 and nodes[v].kind == .ident and nodes[v].aux == i32(int(SK.local)) and int(nodes[v].sym) == x: return true
    false

fact_loop_bound_terms = (s: mut FactState, m: int) -> (int, int):
    l = fact_loop_index_local(m)
    i = fact_binding(s, PlaceIdentity(.local, int(locals[l].owner), l))
    if i < 0: return (0, 0)
    held = fact_route_values(s, fact_route(int(nodes[m].a), s))
    if held.len() == 0: return (0, 0)
    (s.bindings[i].value, fact_project(s, held[held.len() - 1], -1, false, T_INT))

fact_loop_bound_entry = (demands: int[], s: mut FactState) -> int[]:
    kept: int[]
    if demands.len() == 0 or not s.live: return kept
    loop m in demands:
        if fact_loop_bound_holds(s, m): kept.push(m)
    kept

fact_loop_bound_holds = (s: mut FactState, m: int) -> bool:
    if not s.live: return true
    terms = fact_loop_bound_terms(s, m)
    if terms.0 == 0: return false
    zero = fact_constant(s, 0)
    fact_compare(s, .le, zero, terms.0) == 1 and fact_compare(s, .lt, terms.0, terms.1) == 1

fact_loop_bound_assume = (s: mut FactState, m: int, at: int):
    terms = fact_loop_bound_terms(s, m)
    if terms.0 == 0: return
    fact_difference(s, terms.0, terms.1, -1, at)
    b = fact_bound(s, terms.0)
    h = fact_bound(s, terms.1).hi
    b.lo = max(b.lo, 0)
    if h > 0 and h != FACT_MAX: b.hi = min(b.hi, h - 1)
    fact_set_bound(s, terms.0, b)

fact_loop_bounds = (n: int, s: mut FactState, held_at_entry: int[], prep: int, base: int, lo: int, hi: int, pushes: (int, int)[]) -> bool:
    if fact_loop_exhausted or not s.live: return false
    if fact_summary_owner != 0 and not fact_may_return(int(nodes[n].b)): return false
    kept = held_at_entry
    outer = fact_speculating
    steps = fact_loop_steps
    verified = false
    loop attempt in [0..5):
        if kept.len() == 0 or fact_loop_exhausted: break
        head = s
        loop m in kept: fact_loop_bound_assume(head, m, n)
        fact_speculating += 1
        body = head
        if prep == FACT_PREP_CONDITION:
            body = head
            dummy_s = FactState(live = false)
            fact_cond_out(int(nodes[n].a), body, dummy_s, true, false, true)
        else if prep == FACT_PREP_RANGE: body = fact_iteration_body(n, head, true, 0, lo, hi, pushes)
        else: fact_loop_prepare(n, body, prep, base, pushes)
        edges = fact_loop_body(n, body)
        fact_speculating = outer
        if fact_loop_exhausted: break
        held: int[]
        loop m in kept:
            if fact_loop_bound_holds(edges.back, m): held.push(m)
        if held.len() == kept.len():
            verified = true
            break
        kept = held
    # (outside any speculation these walks are this rule's own: the real
    # walk and its inner loops keep the budget they had)
    if outer == 0:
        fact_loop_steps = steps
        fact_loop_exhausted = false
    if not verified: return false
    loop m in kept: fact_loop_bound_assume(s, m, n)
    true

# Comparison/condition services now share the existing facts_compare import.

# Projection identity/construction services share the existing facts_values import.

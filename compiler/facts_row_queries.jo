fact_rows_indexed = (s: FactState) -> bool: data(s.index)[0].difference_next.len() != 0
# The row a - b <= limit's position, or -1.
fact_row_find = (s: FactState, a: int, b: int) -> int:
    if (s.diff_a_mask & (1 << (a & 63))) == 0 or (s.diff_b_mask & (1 << (b & 63))) == 0: return -1
    idx = data(s.index)
    if idx[0].difference_next.len() != 0: return fact_index_get_raw(data(idx[0].difference_index), idx[0].difference_index.len(), fact_pair_key(a, b))
    diffs = data(s.differences)
    i = s.differences.len() - 1
    loop i >= 0:
        if diffs[i].a == a and diffs[i].b == b: return i
        i -= 1
    -1
# Rows touching v, or -1 when none does.
fact_incident_indexed = (idx: *FactIndexes, v: int) -> int:
    r = fact_index_get_raw(data(idx[0].difference_value), idx[0].difference_value.len(), v)
    if r < 0: return -1
    data(idx[0].difference_record)[r * FACT_RECORD]
fact_incident_scan = (s: FactState, v: int) -> int:
    count = 0
    diffs = data(s.differences)
    n = s.differences.len()
    loop i in [0..n):
        if diffs[i].a == v: count += 1
        if diffs[i].b == v: count += 1
    if count == 0: -1 else: count
fact_incident = (s: FactState, v: int) -> int:
    if ((s.diff_a_mask | s.diff_b_mask) & (1 << (v & 63))) == 0: return -1
    idx = data(s.index)
    if idx[0].difference_next.len() == 0: return fact_incident_scan(s, v)
    fact_incident_indexed(idx, v)
# The first row from v (direction 0: rows by b; 1: rows by a), or -1.
fact_difference_head = (s: FactState, v: int, direction: int) -> int:
    m = if direction == 0: s.diff_b_mask else: s.diff_a_mask
    if (m & (1 << (v & 63))) == 0: return -1
    idx = data(s.index)
    if idx[0].difference_next.len() == 0:
        diffs = data(s.differences)
        n = s.differences.len()
        if direction == 0:
            loop i in [0..n):
                if diffs[i].b == v: return i
        else:
            loop i in [0..n):
                if diffs[i].a == v: return i
        return -1
    r = fact_index_get_raw(data(idx[0].difference_value), idx[0].difference_value.len(), v)
    if r < 0: return -1
    data(idx[0].difference_record)[r * FACT_RECORD + 1 + direction * 2]
# The row after ri from the same value in the same direction, or -1.
fact_difference_next = (s: FactState, ri: int, direction: int) -> int:
    idx = data(s.index)
    if idx[0].difference_next.len() != 0: return data(idx[0].difference_next)[ri * 2 + direction]
    diffs = data(s.differences)
    n = s.differences.len()
    if direction == 0:
        v = diffs[ri].b
        loop i in [ri + 1..n):
            if diffs[i].b == v: return i
    else:
        v = diffs[ri].a
        loop i in [ri + 1..n):
            if diffs[i].a == v: return i
    -1
fact_row_scan = (s: FactState, v: int, direction: int, from: int) -> int:
    n = s.differences.len()
    if direction == 0:
        loop i in [from..n):
            if s.differences[i].b == v: return i
    else:
        loop i in [from..n):
            if s.differences[i].a == v: return i
    -1

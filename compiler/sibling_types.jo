use 'checker_tokens.dewy'
# Literals of sibling record types (one minted family) keep their positions:
# `[Circle[...] Square[...]]` is the positional `[Circle Square]`, usable where
# `array<Shape>` is expected. A binding the rest of its block writes covers its
# elements instead (`array<Circle|Square>`), and straight-line knowledge of its
# contents narrows constant-index reads (`shapes[2]` after a known push).
# Demand: only heterogeneous sibling literals start any of this; the write scan
# is O(rest of the block) once per such binding, and each later statement and
# write costs O(1) map work while some binding is known.
use 'util.jo'
use 'ast.jo'
use 'types.jo'
use 'check.jo'
use 'expr.jo'
use 'errors.jo'
use 'lex.jo'
use 'node_store.dewy'

SIBLING_CAP = 8

struct SiblingKnown:
    types: int[]
    owner: int = 0
    depth: int = 0
    block: int = 0

sibling_literals: {int: bool} = {}
sibling_known: {int: SiblingKnown} = {}
sibling_block = 0
sibling_index = 0
sibling_extending = 0
sibling_pending: int[]

sibling_descends = (t0: int, p: int) -> bool:
    t = prune(t0)
    loop t != 0:
        if type_eq(t, p): return true
        t = nominal_parent.get(t, 0)
    false

# The family two or more distinct record types among a literal's elements share, or 0.
sibling_parent = (n: int) -> int:
    if nkids(n) < 2: return 0
    first = prune(ntype(kid(n, 0)))
    distinct = false
    loop c in kids(n):
        t = prune(ntype(c))
        if tkind(t) != .struct_ or is_lit(c): return 0
        if not type_eq(t, first): distinct = true
    if not distinct: return 0
    p = first
    loop p != 0:
        all = true
        loop c in kids(n):
            if all and not sibling_descends(ntype(c), p): all = false
        if all: return p
        p = nominal_parent.get(p, 0)
    0

sibling_literal = (n: int) -> int:
    el: int[]
    loop c in kids(n): el.push(prune(ntype(c)))
    nodes[n].kind = .tuple
    sibling_literals[n] = true
    mk_tuple(el)

# A positional value whose every position fits `elem` becomes an array: a
# literal in place, a local by reading each position.
sibling_array_source = (n: int, from: int, elem0: int) -> bool:
    elem = prune(elem0)
    if not sibling_literals.has(n) and not (nodes[n].kind == .ident and nodes[n].aux == i32(int(SK.local))): return false
    if not dewy_at(nodes[n].pos): return false
    loop i in [0..int(types[from].nargs)):
        ti = prune(targ(from, i))
        if not (type_eq(ti, elem) or sibling_descends(ti, elem) or (is_union(elem) and union_index(elem, ti) >= 0)): return false
    true

sibling_to_array = (n: int, from: int, to: int) -> int:
    elem = int(types[prune(to)].elem)
    pos = nodes[n].pos
    if sibling_literals.has(n) and nodes[n].kind == .tuple:
        nodes[n].kind = .array
        loop i in [0..nkids(n)): set_kid(n, i, coerce(kid(n, i), elem))
        nodes[n].type = i32(to)
        return n
    l = int(nodes[n].sym)
    items: int[]
    loop i in [0..int(types[from].nargs)):
        ix = mk(.index, pos)
        nodes[ix].a = i32(mk_ident_local(l, pos))
        at = bc_int(i, pos)
        nodes[ix].b = i32(at)
        set_list(ix, [at])
        items.push(ix)
    arr = mk(.array, pos)
    set_list(arr, items)
    nodes[n] = nodes[arr]
    check_expr(n, to)
    n

# `let shapes=[Circle[...] Square[...]]`: positional unless the rest of its block
# writes it; then its elements' union, with its contents known from here.
sibling_binding = (s: int, t: int) -> int:
    name = int(nodes[s].name)
    written = true
    if sibling_block != 0 and sibling_index < nkids(sibling_block) and kid(sibling_block, sibling_index) == s:
        written = false
        loop i in [sibling_index + 1..nkids(sibling_block)):
            if not written and sibling_writes(kid(sibling_block, i), name): written = true
    if not written: return t
    members: int[]
    loop i in [0..int(types[t].nargs)):
        m = prune(targ(t, i))
        if not members.contains(m): members.push(m)
    to = mk_array(mk_union(members))
    nodes[s].b = i32(sibling_to_array(int(nodes[s].b), t, to))
    sibling_pending = []
    loop i in [0..int(types[t].nargs)): sibling_pending.push(prune(targ(t, i)))
    to

# Whether unchecked syntax may write the binding `name`: an assignment into it,
# an `@` of it, a method call on it, a mutable loop over it (conservative).
sibling_writes = (n: int, name: int) -> bool:
    if n == 0: return false
    k = nodes[n].kind
    if k == .ident: return int(nodes[n].name) == name and has_flag(n, NF_MUT)
    if k == .assign and sibling_route_name(int(nodes[n].a)) == name: return true
    if k == .call and nodes[int(nodes[n].a)].kind == .field and sibling_route_name(int(nodes[int(nodes[n].a)].a)) == name: return true
    if (k == .for_ or k == .lhead) and has_flag(n, NF_MUT) and sibling_route_name(int(nodes[n].a)) == name: return true
    if sibling_writes(int(nodes[n].a), name) or sibling_writes(int(nodes[n].b), name): return true
    if sibling_writes(kid_c(n), name) or sibling_writes(kid_d(n), name): return true
    loop c in kids(n):
        if sibling_writes(c, name): return true
    if k != .lambda and k != .fn_:
        loop c in kids2(n):
            if sibling_writes(c, name): return true
    false

sibling_route_name = (n0: int) -> int:
    n = n0
    loop n != 0 and (nodes[n].kind == .field or nodes[n].kind == .index): n = int(nodes[n].a)
    if n != 0 and nodes[n].kind == .ident: return int(nodes[n].name)
    0

sibling_establish = (l: int):
    if sibling_pending.len() == 0: return
    sibling_known[l] = SiblingKnown(types = sibling_pending, owner = int(ctxs[cx].inst), depth = int(ctxs[cx].loop_depth), block = sibling_block)
    sibling_pending = []

# A write the knowledge cannot follow ends it.
sibling_forget = (l: int):
    if l != sibling_extending and sibling_known.has(l): sibling_known.remove(l)

# A statement of block b while some binding's contents are known: `xs.push(v)`
# as a statement of the declaring block appends v's record type.
sibling_statement = (s: int, b: int):
    l = 0
    arg = 0
    if nodes[s].kind == .exprstmt and not has_flag(s, NF_CHECKED):
        call = int(nodes[s].a)
        if nodes[call].kind == .call and nkids(call) == 1 and nodes[int(nodes[call].a)].kind == .field and name_of(int(nodes[int(nodes[call].a)].name)) == "push":
            base = int(nodes[int(nodes[call].a)].a)
            if nodes[base].kind == .ident:
                sy = lookup(int(nodes[base].name))
                if sy != 0 and syms[sy].kind == .local and sibling_known.has(int(syms[sy].ref)):
                    l = int(syms[sy].ref)
                    arg = kid(call, 0)
    if l == 0:
        check_stmt(s)
        return
    # (the pushed value's own type, before the push converts it to the union)
    t = 0
    if not ctx_dependent(arg) and not is_lit(arg):
        t = prune(check_expr(arg, 0))
        add_flag(arg, NF_CHECKED)
    sibling_extending = l
    check_stmt(s)
    sibling_extending = 0
    if not sibling_known.has(l): return
    known = sibling_known[l]
    if known.block != b or known.owner != int(ctxs[cx].inst) or known.depth != int(ctxs[cx].loop_depth) or known.types.len() >= SIBLING_CAP or t == 0 or tkind(t) != .struct_:
        sibling_known.remove(l)
        return
    known.types.push(t)
    sibling_known[l] = known

# `xs[k]` with a constant k whose record type is known here: that member.
sibling_index_narrow = (n: int, t: int) -> int:
    if nodes[n].kind != .index or cur_assign != 0 or has_flag(n, NF_MUT) or not is_union(prune(t)): return t
    base = int(nodes[n].a)
    if nodes[base].kind != .ident or nodes[base].aux != i32(int(SK.local)): return t
    l = int(nodes[base].sym)
    if not sibling_known.has(l): return t
    if int(locals[l].flags) & (LF_SHARED | LF_ADDR | LF_CAPTURE) != 0: return t
    e = int(nodes[n].b)
    loop e != 0 and nodes[e].kind == .conv: e = int(nodes[e].a)
    if e == 0 or nodes[e].kind != .int_lit: return t
    k = nodes[e].ival
    known = sibling_known[l]
    if k < 0 or k >= known.types.len() or known.owner != int(ctxs[cx].inst) or known.depth != int(ctxs[cx].loop_depth): return t
    member = known.types[k]
    vi = union_index(prune(t), member)
    if vi < 0: return t
    inner = nodes.len()
    nodes.push(nodes[n])
    nodes[n] = Node(kind = .narrow, pos = nodes[inner].pos, a = i32(inner), aux = i32(vi), type = i32(member), flags = i32(NF_CHECKED))
    member

# ---- a binding written with sibling literals (`let s = Circle[...]`, later `s = Square[...]`) ----
# Its covering type is the union of the literals' types, with a warning suggesting an
# annotation, and which member it holds is followed through the flow: a Circle until the
# write, a Square after it (a narrowing alias of the variable, as `is?` makes). A write the
# flow cannot follow (in a loop, before it is checked) makes it the union from there. An
# annotated union of sibling records is followed the same way, without the warning.
# Demand: only a record-typed `let` in a block with later statements scans them, O(rest of
# the block) once; each later statement costs a map check while a binding is followed.

sibling_flow: {int: int} = {}   # variable followed -> the block it was declared in
sibling_flow_next = 0           # (the vardecl being checked makes a variable to follow ...)
sibling_flow_member = 0         # (... starting as this member ...)
sibling_flow_l = 0              # (... this one, narrowed once its statement is checked)

# The record type a literal written to a binding makes, from its syntax (`Square[s=2]`), or 0.
sibling_syntax_type = (v: int) -> int:
    if v == 0: return 0
    k = nodes[v].kind
    callee = 0
    if k == .call or k == .index: callee = int(nodes[v].a)
    if callee == 0 or nodes[callee].kind != .ident or nodes[callee].sval != 0: return 0
    s = lookup(int(nodes[callee].name))
    if s == 0: return 0
    sk = syms[s].kind
    d = int(syms[s].ref)
    if sk == .alias_ or sk == .struct_:
        if nkids2(d) != 0: return 0
    else if sk != .type_: return 0
    tn = mk(.tname, nodes[callee].pos)
    nodes[tn].name = nodes[callee].name
    t = prune(resolve_type(tn))
    if tkind(t) != .struct_: return 0
    t

# The literals unchecked syntax n writes to `name` (`name = Square[...]`) into out; `escapes`
# when it may be written where the flow cannot follow (through `@name`, inside a function).
sibling_scalar_scan = (n: int, name: int, in_fn: bool, out: mut int[], escapes: mut bool):
    if n == 0: return
    k = nodes[n].kind
    if k == .ident and int(nodes[n].name) == name and has_flag(n, NF_MUT): escapes = true
    if k == .assign and nodes[int(nodes[n].a)].kind == .ident and int(nodes[int(nodes[n].a)].name) == name:
        if in_fn: escapes = true
        if nodes[n].op == i32(int(Tok.assign)):
            t = sibling_syntax_type(int(nodes[n].b))
            if t != 0: out.push(t)
    inner = in_fn or k == .lambda or k == .fn_
    sibling_scalar_scan(int(nodes[n].a), name, inner, out, escapes)
    sibling_scalar_scan(int(nodes[n].b), name, inner, out, escapes)
    sibling_scalar_scan(kid_c(n), name, inner, out, escapes)
    sibling_scalar_scan(kid_d(n), name, inner, out, escapes)
    loop c in kids(n): sibling_scalar_scan(c, name, inner, out, escapes)
    if k != .lambda and k != .fn_:
        loop c in kids2(n): sibling_scalar_scan(c, name, inner, out, escapes)

# Whether t0 and t1 are records of one minted family.
sibling_family = (t0: int, t1: int) -> bool:
    p = nominal_parent.get(prune(t0), 0)
    loop p != 0:
        if sibling_descends(t1, p): return true
        p = nominal_parent.get(p, 0)
    false

# `let s = Circle[...]` (vardecl d, value of record type t): the union of t and the sibling
# literals the rest of its block writes to it, or t.
sibling_scalar = (d: int, t: int) -> int:
    if sibling_block == 0 or sibling_index >= nkids(sibling_block) or kid(sibling_block, sibling_index) != d: return t
    if nominal_parent.get(prune(t), 0) == 0 or sibling_index + 1 >= nkids(sibling_block): return t
    name = int(nodes[d].name)
    written: int[]
    escapes = false
    loop i in [sibling_index + 1..nkids(sibling_block)): sibling_scalar_scan(kid(sibling_block, i), name, false, written, escapes)
    members = [prune(t)]
    loop w in written:
        if members.contains(w) or not sibling_family(t, w): continue
        members.push(w)
    if members.len() < 2: return t
    u = mk_union(members)
    shown: str[]
    loop m in members: shown.push(dt(m))
    nm = name_of(name)
    later = shown[1..]
    warn(nodes[d].pos, "'{nm}' is given a {shown[0]} here and later a {join(later, " or a ")}, so it holds {join(shown, " | ")}, and which one is followed from each write: annotate it to say which was meant, `let {nm}:{join(shown, "|")} = ...`, or `let {nm}:{shown[0]} = ...` or `let {nm}:{shown[1]} = ...` for one of them")
    nodes[d].b = i32(coerce(int(nodes[d].b), u))
    if not escapes:
        sibling_flow_next = 1
        sibling_flow_member = prune(t)
    u

# `let s:Circle|Square = Circle[...]` (a union of sibling records, value of member type vt):
# followed from its value's type.
sibling_annotated = (d: int, t: int, vt: int) -> bool:
    u = prune(t)
    if not is_union(u) or union_index(u, prune(vt)) < 0: return false
    ms = union_members(u)
    if ms.len() < 2: return false
    loop m in ms:
        if tkind(m) != .struct_ or not sibling_family(ms[0], m): return false
    if sibling_block == 0 or sibling_index >= nkids(sibling_block) or kid(sibling_block, sibling_index) != d: return false
    written: int[]
    escapes = false
    loop i in [sibling_index + 1..nkids(sibling_block)): sibling_scalar_scan(kid(sibling_block, i), int(nodes[d].name), false, written, escapes)
    if escapes: return false
    sibling_flow_next = 1
    sibling_flow_member = prune(vt)
    true

# Variable l was just declared to be followed: it holds the member it starts as.
sibling_flow_start = (l: int, pos: int):
    sibling_flow_next = 0
    sibling_flow[l] = sibling_block
    narrow_local(l, [sibling_flow_member], pos)

# The variable a local name stands for (through its narrowing aliases).
sibling_root = (l0: int) -> int:
    l = l0
    loop narrowed_var(l) != 0: l = narrowed_var(l)
    l

# `s = v` checked, s followed: from here it holds v's member (`literal`: the record type its
# syntax names, `Square[...]`, taken before the check gave the literal the union's type).
sibling_flow_assign = (s: int, literal: int):
    if nodes[s].op != i32(int(Tok.assign)): return
    lhs = int(nodes[s].a)
    if nodes[lhs].kind != .ident or nodes[lhs].aux != i32(int(SK.local)): return
    l = int(nodes[lhs].sym)

    root = sibling_root(l)
    if not sibling_flow.has(root): return
    v = int(nodes[s].b)
    loop nodes[v].kind == .conv: v = int(nodes[v].a)
    rt = prune(ntype(v))
    if is_union(rt) and literal != 0: rt = literal
    if l != root and type_eq(prune(int(locals[l].type)), rt): return
    if union_index(prune(int(locals[root].type)), rt) < 0: return
    narrow_local(root, [rt], nodes[s].pos)

# Statement s (of block b) about to be checked: a followed variable it writes inside a loop
# is the union from here, since the loop's next turn sees what the last one wrote.
sibling_flow_loops = (s: int):
    loop l, _ in sibling_flow:
        name = int(locals[l].name)
        if not sibling_loop_writes(s, name, false): continue
        sy = lookup(name)
        if sy == 0 or syms[sy].kind != .local: continue
        al = int(syms[sy].ref)
        if al == l or sibling_root(al) != l: continue
        narrow_invalidate(al)
        push_scope_sym(name, new_sym(name, .local, l, 0))

sibling_loop_writes = (n: int, name: int, in_loop: bool) -> bool:
    if n == 0: return false
    k = nodes[n].kind
    if in_loop and k == .assign and sibling_route_name(int(nodes[n].a)) == name: return true
    inner = in_loop or k == .while_ or k == .for_ or k == .loopx or k == .lhead
    if sibling_loop_writes(int(nodes[n].a), name, inner) or sibling_loop_writes(int(nodes[n].b), name, inner): return true
    if sibling_loop_writes(kid_c(n), name, inner) or sibling_loop_writes(kid_d(n), name, inner): return true
    loop c in kids(n):
        if sibling_loop_writes(c, name, inner): return true
    if k != .lambda and k != .fn_:
        loop c in kids2(n):
            if sibling_loop_writes(c, name, inner): return true
    false

# Block b ends: the variables declared in it are no longer followed.
sibling_flow_end = (b: int):
    done: int[]
    loop l, block in sibling_flow:
        if block == b: done.push(l)
    loop l in done: sibling_flow.remove(l)

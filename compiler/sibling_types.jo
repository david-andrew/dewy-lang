use 'checker_call_queries.dewy'
use 'checker_expr.dewy'
use 'checker_tokens.dewy'
# Literals of sibling record types (one minted family) keep their positions:
# `[Circle[...] Square[...]]` is the positional `[Circle Square]`, usable where
# `array<Shape>` is expected. A binding the rest of its block writes covers its
# elements instead (`array<Circle|Square>`), and straight-line knowledge of its
# contents narrows constant-index reads (`shapes[2]` after a known push).
# Demand: only heterogeneous sibling literals start any of this; the write scan
# is O(rest of the block) once per such binding, and each later statement and
# write costs O(1) map work while some binding is known.
use 'util.jo'
use 'ast.jo'
use 'types.jo'
use 'check.jo'
use 'expr.jo'
use 'errors.jo'
use 'lex.jo'
use 'node_store.dewy'
use 'checker_state.dewy'

SIBLING_CAP = 8

# (SiblingKnown: checker_state.dewy)
sibling_literals: {int: bool} = {}
sibling_known: {int: SiblingKnown} = {}
sibling_block = 0
sibling_index = 0
sibling_extending = 0
sibling_pending: int[]













# ---- a binding written with sibling literals (`let s = Circle[...]`, later `s = Square[...]`) ----
# Its covering type is the union of the literals' types, with a warning suggesting an
# annotation, and which member it holds is followed through the flow: a Circle until the
# write, a Square after it (a narrowing alias of the variable, as `is?` makes). A write the
# flow cannot follow (in a loop, before it is checked) makes it the union from there. An
# annotated union of sibling records is followed the same way, without the warning.
# Demand: only a record-typed `let` in a block with later statements scans them, O(rest of
# the block) once; each later statement costs a map check while a binding is followed.

sibling_flow: {int: int} = {}   # variable followed -> the block it was declared in
sibling_flow_next = 0           # (the vardecl being checked makes a variable to follow ...)
sibling_flow_member = 0         # (... starting as this member ...)
sibling_flow_l = 0              # (... this one, narrowed once its statement is checked)












$runtime_checks

# The compiler's node store: every syntax tree node, from either frontend and the checker,
# is a Node in one array, and nodes refer to each other by index; node 0 is the "no node"
# sentinel. A node's lists of children are runs of a second array of indices.
#
# A module of the compiler written in Dewy. node_store.jo is its frozen twin for the
# compilers without the Dewy frontend (tools/compiler/build.py); the two keep the same
# interface and give the same answers (tests/test_selfhost_node_store.py). The arrays are
# Sloppy's globals (ast.jo `nodes` and `lists`), passed by place. Sloppy code takes NK as
# its enum, its members numbered as written here.

# A node's kind. In order: nil; expressions; those the checker makes (conv, fnref, partial,
# intrinsic); statements (vardecl ... arm); declarations (fn_ ... build_); type expressions
# (tname ... tfn); patterns (pwild ... pvariant); then those added with syntax revision 2:
#   narrow: a: a union (or optional) value known to hold member aux (type is the member's)
#   typealias: type Name[T] = a
#   ptype: Dewy type pattern: a is the type, name is an optional value binding
#   record_lit: Dewy [field=value ...], contextual or inferred structural record
#   matrix: [1 2 ; 3 4]: the elements row by row; ival = elements per row
#   trecord: Dewy inline structural type [field: Type ...]
#   propagate: postfix or_throw; checker expands to a checked return
#   unit_lit: exact built-in unit: ival numerator, aux denominator, aux2 dimension
#   tquantity: type product/division/power: a and b type syntax (power b is expression)
#   reflect_scope: internal: a specialized iteration's binding and body
#   record_loop: literal fields expanded in a compile-time iteration scope
#   trefined: a: base type, b: pure predicate, name: optional self binder
#   typeapply: Dewy f<T> / Type<T>: a is the base, c the type syntax, kids the type arguments
#   pshape: Dewy object pattern [f g:T h:1]: kids are field patterns named by their fields
#   pseq: Dewy sequence pattern (p q r): kids are the element patterns
#   parallel_region: a: checked library call; retains the scoped fork/join boundary
#   new_axis: Dewy xs[new ..]: a is the receiver, kids the entries (`new` is the ident $new)
#   lazy_: Dewy lazy expr: a is body block, sval optional label, sym FnInst, aux flags, aux2 exact count
#   yield_: checked generator step inside lazy_: a is expr, aux 0 value, 1 delegate, 2 or_throw failure
NK:type='nil' |
    'int_lit' | 'float_lit' | 'str_lit' | 'bool_lit' | 'none_lit' | 'null_lit' | 'ident' | 'field' |
    'dotname' | 'call' | 'index' | 'unary' | 'binary' | 'and_' | 'or_' | 'not_' |
    'coalesce' | 'unwrap' | 'lambda' | 'array' | 'map_lit' | 'tuple' | 'if_' | 'match_' |
    'cast' | 'range' | 'addr' | 'hole' | 'namedarg' | 'pair' | 'block' | 'iflet' |
    'conv' | 'fnref' | 'partial' | 'intrinsic' |
    'vardecl' | 'assign' | 'exprstmt' | 'while_' | 'for_' | 'return_' | 'break_' | 'continue_' |
    'defer_' | 'when_' | 'arm' |
    'fn_' | 'param' | 'struct_' | 'enum_' | 'variant' | 'const_' | 'import_' | 'test_' |
    'build_' |
    'tname' | 'tarray' | 'tmap' | 'ttuple' | 'topt' | 'tptr' | 'tfn' |
    'pwild' | 'plit' | 'prange' | 'pvariant' |
    'tunion' | 'istype' | 'loopx' | 'lhead' | 'narrow' | 'typealias' | 'ptype' | 'record_lit' |
    'matrix' | 'trecord' | 'propagate' | 'unit_lit' | 'tquantity' | 'reflect_scope' | 'record_loop' | 'trefined' |
    'typeapply' | 'pshape' | 'pseq' | 'parallel_region' | 'new_axis' | 'lazy_' | 'yield_'

NodeExt:type=[
    d:int32=0
    list2:int32=0
    nlist2:int32=0
    sval:int32=0
    aux2:int32=0
    mod:int32=0
    fval:float64=0.0
]

Node:type=[
    kind:NK='nil'
    flags:int32=0
    pos:int64=0
    ival:int64=0
    a:int32=0
    b:int32=0
    c:int32=0
    list:int32=0
    nlist:int32=0
    name:int32=0
    type:int32=0
    sym:int32=0
    aux:int32=0
    op_ext:uint32=0
]

NodeWord:type=int64<overflow='wrap'>
# (the flag clone clears: ast.jo's NF_CHECKED)
const NODE_CHECKED:int64=128

# Immutable cold-field pool; slot 0 is the all-zero sentinel so reads are branchless.
let node_exts:array<NodeExt>=[NodeExt()]
let node_exts_p:ptr<NodeExt>=$unsafe node_exts.ptr
node_ext_reset=():>void=>$unsafe {
    let ep=node_exts.ptr
    let eh=(ep as ptr<int64>) - 3
    if eh[0] =? 1 {
        eh[1]=1
        node_exts_p=ep
    } else {
        node_exts=[NodeExt()]
        node_exts_p=node_exts.ptr
    }
}
node_ext_grow_impl=(cur:NodeWord):>void=>$unsafe {
    let nc:NodeWord=if cur <? 256 {256} else {cur * 2}
    node_exts.reserve(int64(nc))
    node_exts_p=node_exts.ptr
}
let node_ext_grow_hook:<(cur:NodeWord):>void>=@node_ext_grow_impl
node_ext_alloc=(src:NodeWord):>NodeWord=>$unsafe {
    let ep=node_exts_p
    let eh=(ep as ptr<int64>) - 3
    let idx=NodeWord(eh[1])
    if eh[0] not=? 1 or idx >=? NodeWord(eh[2]) {
        node_ext_grow_hook(idx)
        ep=node_exts_p
        eh=(ep as ptr<int64>) - 3
        idx=NodeWord(eh[1])
    }
    eh[1]=int64(idx + 1)
    mem_copy(ep + idx ep + src size_of<NodeExt>)
    idx
}

node_op=(oe:uint32):>int32=>int32<overflow='wrap'>(oe & uint32(255))
node_d=(oe:uint32):>int32=>$unsafe node_exts_p[NodeWord(oe >> uint32(8))].d
node_list2=(oe:uint32):>int32=>$unsafe node_exts_p[NodeWord(oe >> uint32(8))].list2
node_nlist2=(oe:uint32):>int32=>$unsafe node_exts_p[NodeWord(oe >> uint32(8))].nlist2
node_sval=(oe:uint32):>int32=>$unsafe node_exts_p[NodeWord(oe >> uint32(8))].sval
node_aux2=(oe:uint32):>int32=>$unsafe node_exts_p[NodeWord(oe >> uint32(8))].aux2
node_mod=(oe:uint32):>int32=>$unsafe node_exts_p[NodeWord(oe >> uint32(8))].mod
node_fval=(oe:uint32):>float64=>$unsafe node_exts_p[NodeWord(oe >> uint32(8))].fval

node_with_op=(oe:uint32 v:int32):>uint32=>(oe & uint32<overflow='wrap'>(0xFFFFFF00)) | (uint32<overflow='wrap'>(v) & uint32(255))
node_with_d=(oe:uint32 v:int32):>uint32=>$unsafe {
    let e=NodeWord(oe >> uint32(8))
    if node_exts_p[e].d =? v {return oe}
    let ne=node_ext_alloc(e)
    node_exts_p[ne].d=v
    (oe & uint32(255)) | (uint32<overflow='wrap'>(ne) << uint32(8))
}
node_with_list2=(oe:uint32 v:int32):>uint32=>$unsafe {
    let e=NodeWord(oe >> uint32(8))
    if node_exts_p[e].list2 =? v {return oe}
    let ne=node_ext_alloc(e)
    node_exts_p[ne].list2=v
    (oe & uint32(255)) | (uint32<overflow='wrap'>(ne) << uint32(8))
}
node_with_nlist2=(oe:uint32 v:int32):>uint32=>$unsafe {
    let e=NodeWord(oe >> uint32(8))
    if node_exts_p[e].nlist2 =? v {return oe}
    let ne=node_ext_alloc(e)
    node_exts_p[ne].nlist2=v
    (oe & uint32(255)) | (uint32<overflow='wrap'>(ne) << uint32(8))
}
node_with_list2_pair=(oe:uint32 start:int32 count:int32):>uint32=>$unsafe {
    let e=NodeWord(oe >> uint32(8))
    let cur=node_exts_p + e
    if cur[0].list2 =? start and cur[0].nlist2 =? count {return oe}
    let ne=node_ext_alloc(e)
    let dst=node_exts_p + ne
    dst[0].list2=start
    dst[0].nlist2=count
    (oe & uint32(255)) | (uint32<overflow='wrap'>(ne) << uint32(8))
}
node_with_sval=(oe:uint32 v:int32):>uint32=>$unsafe {
    let e=NodeWord(oe >> uint32(8))
    if node_exts_p[e].sval =? v {return oe}
    let ne=node_ext_alloc(e)
    node_exts_p[ne].sval=v
    (oe & uint32(255)) | (uint32<overflow='wrap'>(ne) << uint32(8))
}
node_with_aux2=(oe:uint32 v:int32):>uint32=>$unsafe {
    let e=NodeWord(oe >> uint32(8))
    if node_exts_p[e].aux2 =? v {return oe}
    let ne=node_ext_alloc(e)
    node_exts_p[ne].aux2=v
    (oe & uint32(255)) | (uint32<overflow='wrap'>(ne) << uint32(8))
}
node_with_mod=(oe:uint32 v:int32):>uint32=>$unsafe {
    let e=NodeWord(oe >> uint32(8))
    if node_exts_p[e].mod =? v {return oe}
    let ne=node_ext_alloc(e)
    node_exts_p[ne].mod=v
    (oe & uint32(255)) | (uint32<overflow='wrap'>(ne) << uint32(8))
}
node_with_fval=(oe:uint32 v:float64):>uint32=>$unsafe {
    let e=NodeWord(oe >> uint32(8))
    let ne=node_ext_alloc(e)
    node_exts_p[ne].fval=v
    (oe & uint32(255)) | (uint32<overflow='wrap'>(ne) << uint32(8))
}

# A new node of kind at pos, every other field zero
# Does an unchecked call's type wait for the parameter it meets (0 no, 1 only its result gives a
# type parameter, 2 only bare literals do), asked of the checker's host; an array literal argument
# is asked first, for its elements. Nothing here until the host binds it.
# (by name, a callee that never waits: such calls skip the question)
let call_waits_never:array<bool>=[]
call_waits_none=(node:int64):>int64=>0
let call_waits_hook:<(node:int64):>int64>=@call_waits_none
call_waits_bind=(f:<(node:int64):>int64>):>int64=>{
    call_waits_hook=@f
    0
}
node_mk_grow_impl=(@store:array<Node> kind:NK pos:int64):>int64=>$unsafe {
    let oc=NodeWord(store.length)
    let nc:NodeWord=if oc <? 128 {128} else {oc * 2}
    store.reserve(int64(nc))
    __set_len(store int64(oc + 1))
    let dst=store.ptr + oc
    mem_set(dst as ptr<uint8> 0 size_of<Node>)
    dst[0].kind=kind
    dst[0].pos=pos
    int64(oc)
}
let node_mk_grow_hook:<(@store:array<Node> kind:NK pos:int64):>int64>=@node_mk_grow_impl
node_mk_slow=(@store:array<Node> kind:NK pos:int64):>int64=>$unsafe {
    # Indirect dispatch keeps this cold growth path out-of-line so node_mk/mk stay tiny.
    let oc=NodeWord(store.length)
    let nc:NodeWord=if oc <? 128 {128} else {oc * 2}
    store.reserve(int64(nc))
    __set_len(store int64(oc + 1))
    let dst=store.ptr + oc
    mem_set(dst as ptr<uint8> 0 size_of<Node>)
    dst[0].kind=kind
    dst[0].pos=pos
    if oc <? 0 {return node_mk_grow_hook(@store kind pos)}
    int64(oc)
}
node_mk=(@store:array<Node> kind:NK pos:int64):>int64=>$unsafe {
    let sp=store.ptr
    let sh=(sp as ptr<int64>) - 3
    let idx=NodeWord(sh[1])
    if sh[0] =? 1 and idx <? NodeWord(sh[2]) {
        sh[1]=int64(idx + 1)
        let dst=sp + idx
        mem_set(dst as ptr<uint8> 0 size_of<Node>)
        dst[0].kind=kind
        dst[0].pos=pos
        return int64(idx)
    }
    node_mk_slow(@store kind pos)
}

node_lists_grow_impl=(@lists:array<int32> need:NodeWord):>void=>$unsafe {
    let cur=NodeWord(cap(lists))
    let nc:NodeWord=if cur <? 256 {256} else {cur * 2}
    if nc <? need {nc=need}
    lists.reserve(int64(nc))
}
let node_lists_grow_hook:<(@lists:array<int32> need:NodeWord):>void>=@node_lists_grow_impl
node_lists_grow=(@lists:array<int32> need:NodeWord):>void=>$unsafe {
    let cur=NodeWord(cap(lists))
    let nc:NodeWord=if cur <? 256 {256} else {cur * 2}
    if nc <? need {nc=need}
    lists.reserve(int64(nc))
    if need <? 0 {node_lists_grow_hook(@lists need)}
}

# xs as a new run of lists; its start
node_run=(@lists:array<int32> xs:array<int64>):>int64=>$unsafe {
    let lp=lists.ptr
    let lh=(lp as ptr<int64>) - 3
    let start=NodeWord(lh[1])
    let count=NodeWord(xs.length)
    if count >? 0 {
        let need=start + count
        if lh[0] =? 1 and need <=? NodeWord(lh[2]) {
            lh[1]=int64(need)
        } else {
            node_lists_grow(@lists need)
            __set_len(lists int64(need))
            lp=lists.ptr
        }
        let src=xs.ptr
        let dst=lp + start
        let i:NodeWord=0
        loop i <? count {dst[i]=int32<overflow='wrap'>(src[i]); i+=1}
    }
    int64(start)
}

# n's children (list) and its second list (list2) are xs, as a new run of lists
node_set_list=(@store:array<Node> @lists:array<int32> n:int64 xs:array<int64>)=>$unsafe {
    let lp=lists.ptr
    let lh=(lp as ptr<int64>) - 3
    let start=NodeWord(lh[1])
    let count=NodeWord(xs.length)
    if count >? 0 {
        let need=start + count
        if lh[0] =? 1 and need <=? NodeWord(lh[2]) {
            lh[1]=int64(need)
        } else {
            node_lists_grow(@lists need)
            __set_len(lists int64(need))
            lp=lists.ptr
        }
        let src=xs.ptr
        let dst=lp + start
        if count =? 1 {
            dst[0]=int32<overflow='wrap'>(src[0])
        } else if count =? 2 {
            dst[0]=int32<overflow='wrap'>(src[0])
            dst[1]=int32<overflow='wrap'>(src[1])
        } else {
            let i:NodeWord=0
            loop i <? count {dst[i]=int32<overflow='wrap'>(src[i]); i+=1}
        }
    }
    let nd=store.ptr + NodeWord(n)
    nd[0].list=int32<overflow='wrap'>(start)
    nd[0].nlist=int32<overflow='wrap'>(count)
}

node_set_list2=(@store:array<Node> @lists:array<int32> n:int64 xs:array<int64>)=>$unsafe {
    let lp=lists.ptr
    let lh=(lp as ptr<int64>) - 3
    let start=NodeWord(lh[1])
    let count=NodeWord(xs.length)
    if count >? 0 {
        let need=start + count
        if lh[0] =? 1 and need <=? NodeWord(lh[2]) {
            lh[1]=int64(need)
        } else {
            node_lists_grow(@lists need)
            __set_len(lists int64(need))
            lp=lists.ptr
        }
        let src=xs.ptr
        let dst=lp + start
        let i:NodeWord=0
        loop i <? count {dst[i]=int32<overflow='wrap'>(src[i]); i+=1}
    }
    let oe=node_with_list2_pair(store.ptr[NodeWord(n)].op_ext int32<overflow='wrap'>(start) int32<overflow='wrap'>(count))
    store.ptr[NodeWord(n)].op_ext=oe
}

node_append_raw=(@lists:array<int32> src:ptr<int64> count0:int64):>int64=>$unsafe {
    let lp=lists.ptr
    let lh=(lp as ptr<int64>) - 3
    let start=NodeWord(lh[1])
    let count=NodeWord(count0)
    if count >? 0 {
        let need=start + count
        if lh[0] =? 1 and need <=? NodeWord(lh[2]) {
            lh[1]=int64(need)
        } else {
            node_lists_grow(@lists need)
            __set_len(lists int64(need))
            lp=lists.ptr
        }
        let dst=lp + start
        let i:NodeWord=0
        loop i <? count {dst[i]=int32<overflow='wrap'>(src[i]); i+=1}
    }
    int64(start)
}

node_set_list_span=(@store:array<Node> @lists:array<int32> n:int64 @buf:array<int64> base0:int64)=>$unsafe {
    let base=NodeWord(base0)
    let bp=buf.ptr
    let bh=(bp as ptr<int64>) - 3
    let blen=NodeWord(bh[1])
    let count=blen - base
    let lp=lists.ptr
    let lh=(lp as ptr<int64>) - 3
    let start=NodeWord(lh[1])
    if count >? 0 {
        let need=start + count
        if lh[0] =? 1 and need <=? NodeWord(lh[2]) {
            lh[1]=int64(need)
        } else {
            node_lists_grow(@lists need)
            __set_len(lists int64(need))
            lp=lists.ptr
        }
        let src=bp + base
        let dst=lp + start
        if count =? 1 {
            dst[0]=int32<overflow='wrap'>(src[0])
        } else if count =? 2 {
            dst[0]=int32<overflow='wrap'>(src[0])
            dst[1]=int32<overflow='wrap'>(src[1])
        } else {
            let i:NodeWord=0
            loop i <? count {dst[i]=int32<overflow='wrap'>(src[i]); i+=1}
        }
        if bh[0] =? 1 {bh[1]=int64(base)} else {__set_len(buf int64(base))}
    }
    let nd=store.ptr + NodeWord(n)
    nd[0].list=int32<overflow='wrap'>(start)
    nd[0].nlist=int32<overflow='wrap'>(count)
}

# a run of lists as an array
node_run_of=(@lists:array<int32> start0:int64 count0:int64):>array<int64>=>$unsafe {
    let start=NodeWord(start0)
    let count=NodeWord(count0)
    let out:array<int64>=[]
    if count >? 0 {
        out.reserve(int64(count))
        __set_len(out int64(count))
        let dst=out.ptr
        let src=lists.ptr + start
        let i:NodeWord=0
        loop i <? count {dst[i]=int64(src[i]); i+=1}
    }
    out
}

node_kids=(@store:array<Node> @lists:array<int32> n:int64):>array<int64>=>$unsafe {node_run_of(@lists int64(store.ptr[NodeWord(n)].list) int64(store.ptr[NodeWord(n)].nlist))}
node_kids2=(@store:array<Node> @lists:array<int32> n:int64):>array<int64>=>$unsafe {
    let e=NodeWord(store.ptr[NodeWord(n)].op_ext >> uint32(8))
    node_run_of(@lists int64(node_exts_p[e].list2) int64(node_exts_p[e].nlist2))
}

# A deep copy of a subtree (generic functions are instantiated so): the copy's own fields
# first, unchecked, then its children's copies, in order
let node_clone_buf:array<int64>=[]
node_clone=(@store:array<Node> @lists:array<int32> n0:int64):>int64=>$unsafe {
    let n=NodeWord(n0)
    if n =? 0 {return 0}
    let sp=store.ptr
    let sh=(sp as ptr<int64>) - 3
    if sh[0] not=? 1 or NodeWord(sh[1]) >=? NodeWord(sh[2]) {
        let oc=NodeWord(store.length)
        let nc:NodeWord=if oc <? 128 {128} else {oc * 2}
        store.reserve(int64(nc))
        sp=store.ptr
        sh=(sp as ptr<int64>) - 3
    }
    let c=NodeWord(sh[1])
    sh[1]=int64(c + 1)
    let dst=sp + c
    mem_copy(dst sp + n size_of<Node>)
    let k=dst[0].kind
    if k not=? 'fn_' and k not=? 'struct_' and k not=? 'enum_' {dst[0].sym=0}
    if k not=? 'conv' {dst[0].type=0}
    dst[0].flags=int32<overflow='wrap'>(dst[0].flags and not NODE_CHECKED)
    let na=NodeWord(dst[0].a)
    let nb=NodeWord(dst[0].b)
    let nc=NodeWord(dst[0].c)
    let ext=NodeWord(dst[0].op_ext >> uint32(8))
    let nd_:NodeWord=if ext =? 0 {0} else {NodeWord(node_exts_p[ext].d)}
    let nl1=NodeWord(dst[0].nlist)
    let nl2:NodeWord=if ext =? 0 {0} else {NodeWord(node_exts_p[ext].nlist2)}
    if (na | nb | nc | nd_ | nl1 | nl2) =? 0 {return int64(c)}
    let l1=NodeWord(dst[0].list)
    let l2:NodeWord=if nl2 =? 0 {0} else {NodeWord(node_exts_p[ext].list2)}
    if na not=? 0 {let ra=int32<overflow='wrap'>(node_clone(@store @lists int64(na))); store.ptr[c].a=ra}
    if nb not=? 0 {let rb=int32<overflow='wrap'>(node_clone(@store @lists int64(nb))); store.ptr[c].b=rb}
    if nc not=? 0 {let rc=int32<overflow='wrap'>(node_clone(@store @lists int64(nc))); store.ptr[c].c=rc}
    if nd_ not=? 0 {
        let rd=int32<overflow='wrap'>(node_clone(@store @lists int64(nd_)))
        let oe2=node_with_d(store.ptr[c].op_ext rd)
        store.ptr[c].op_ext=oe2
    }
    if nl1 >? 0 {
        if nl1 =? 1 {
            let c0=int32<overflow='wrap'>(node_clone(@store @lists int64(lists.ptr[l1])))
            let lp=lists.ptr
            let lh=(lp as ptr<int64>) - 3
            let start=NodeWord(lh[1])
            if lh[0] =? 1 and start <? NodeWord(lh[2]) {
                lh[1]=int64(start + 1)
                lp[start]=c0
            } else {lists.push(c0)}
            let dstc=store.ptr + c
            dstc[0].list=int32<overflow='wrap'>(start)
            dstc[0].nlist=int32(1)
        } else if nl1 =? 2 {
            let k0=int64(lists.ptr[l1])
            let k1=int64(lists.ptr[l1 + 1])
            let c0=int32<overflow='wrap'>(node_clone(@store @lists k0))
            let c1=int32<overflow='wrap'>(node_clone(@store @lists k1))
            let lp=lists.ptr
            let lh=(lp as ptr<int64>) - 3
            let start=NodeWord(lh[1])
            if lh[0] =? 1 and start + 2 <=? NodeWord(lh[2]) {
                lh[1]=int64(start + 2)
                lp[start]=c0
                lp[start + 1]=c1
            } else {lists.push(c0); lists.push(c1)}
            let dstc=store.ptr + c
            dstc[0].list=int32<overflow='wrap'>(start)
            dstc[0].nlist=int32(2)
        } else {
            let base=NodeWord(node_clone_buf.length)
            let i:NodeWord=0
            loop i <? nl1 {
                let child=node_clone(@store @lists int64(lists.ptr[l1 + i]))
                node_clone_buf.push(child)
                i+=1
            }
            let count=NodeWord(node_clone_buf.length) - base
            let start=node_append_raw(@lists node_clone_buf.ptr + base int64(count))
            __set_len(node_clone_buf int64(base))
            let dstc=store.ptr + c
            dstc[0].list=int32<overflow='wrap'>(start)
            dstc[0].nlist=int32<overflow='wrap'>(count)
        }
    }
    if nl2 >? 0 {
        let base=NodeWord(node_clone_buf.length)
        let i:NodeWord=0
        loop i <? nl2 {
            let child=node_clone(@store @lists int64(lists.ptr[l2 + i]))
            node_clone_buf.push(child)
            i+=1
        }
        let count=NodeWord(node_clone_buf.length) - base
        let start=node_append_raw(@lists node_clone_buf.ptr + base int64(count))
        __set_len(node_clone_buf int64(base))
        let oe3=node_with_list2_pair(store.ptr[c].op_ext int32<overflow='wrap'>(start) int32<overflow='wrap'>(count))
        store.ptr[c].op_ext=oe3
    }
    int64(c)
}

$runtime_checks

# The compiler's node store: every syntax tree node, from either frontend and the checker,
# is a Node in one array, and nodes refer to each other by index; node 0 is the "no node"
# sentinel. A node's lists of children are runs of a second array of indices.
#
# A module of the compiler written in Dewy. node_store.jo is its frozen twin for the
# compilers without the Dewy frontend (tools/compiler/build.py); the two keep the same
# interface and give the same answers (tests/test_selfhost_node_store.py). The arrays are
# Sloppy's globals (ast.jo `nodes` and `lists`), passed by place. Sloppy code takes NK as
# its enum, its members numbered as written here.

# A node's kind. In order: nil; expressions; those the checker makes (conv, fnref, partial,
# intrinsic); statements (vardecl ... arm); declarations (fn_ ... build_); type expressions
# (tname ... tfn); patterns (pwild ... pvariant); then those added with syntax revision 2:
#   narrow: a: a union (or optional) value known to hold member aux (type is the member's)
#   typealias: type Name[T] = a
#   ptype: Dewy type pattern: a is the type, name is an optional value binding
#   record_lit: Dewy [field=value ...], contextual or inferred structural record
#   matrix: [1 2 ; 3 4]: the elements row by row; ival = elements per row
#   trecord: Dewy inline structural type [field: Type ...]
#   propagate: postfix or_throw; checker expands to a checked return
#   unit_lit: exact built-in unit: ival numerator, aux denominator, aux2 dimension
#   tquantity: type product/division/power: a and b type syntax (power b is expression)
#   reflect_scope: internal: a specialized iteration's binding and body
#   record_loop: literal fields expanded in a compile-time iteration scope
#   trefined: a: base type, b: pure predicate, name: optional self binder
#   typeapply: Dewy f<T> / Type<T>: a is the base, c the type syntax, kids the type arguments
#   pshape: Dewy object pattern [f g:T h:1]: kids are field patterns named by their fields
#   pseq: Dewy sequence pattern (p q r): kids are the element patterns
#   parallel_region: a: checked library call; retains the scoped fork/join boundary
#   new_axis: Dewy xs[new ..]: a is the receiver, kids the entries (`new` is the ident $new)
NK:type='nil' |
    'int_lit' | 'float_lit' | 'str_lit' | 'bool_lit' | 'none_lit' | 'null_lit' | 'ident' | 'field' |
    'dotname' | 'call' | 'index' | 'unary' | 'binary' | 'and_' | 'or_' | 'not_' |
    'coalesce' | 'unwrap' | 'lambda' | 'array' | 'map_lit' | 'tuple' | 'if_' | 'match_' |
    'cast' | 'range' | 'addr' | 'hole' | 'namedarg' | 'pair' | 'block' | 'iflet' |
    'conv' | 'fnref' | 'partial' | 'intrinsic' |
    'vardecl' | 'assign' | 'exprstmt' | 'while_' | 'for_' | 'return_' | 'break_' | 'continue_' |
    'defer_' | 'when_' | 'arm' |
    'fn_' | 'param' | 'struct_' | 'enum_' | 'variant' | 'const_' | 'import_' | 'test_' |
    'build_' |
    'tname' | 'tarray' | 'tmap' | 'ttuple' | 'topt' | 'tptr' | 'tfn' |
    'pwild' | 'plit' | 'prange' | 'pvariant' |
    'tunion' | 'istype' | 'loopx' | 'lhead' | 'narrow' | 'typealias' | 'ptype' | 'record_lit' |
    'matrix' | 'trecord' | 'propagate' | 'unit_lit' | 'tquantity' | 'reflect_scope' | 'record_loop' | 'trefined' |
    'typeapply' | 'pshape' | 'pseq' | 'parallel_region' | 'new_axis'

Node:type=[
    kind:NK='nil'
    op:int32=0
    flags:int32=0
    pos:int64=0
    a:int32=0
    b:int32=0
    c:int32=0
    d:int32=0
    list:int32=0
    nlist:int32=0
    list2:int32=0
    nlist2:int32=0
    name:int32=0
    sval:int32=0
    ival:int64=0
    fval:float64=0.0
    type:int32=0
    sym:int32=0
    aux:int32=0
    aux2:int32=0      # vardecl: 1 for a synthesized Dewy value-parameter binding
    mod:int32=0
]

# (the flag clone clears: ast.jo's NF_CHECKED)
const NODE_CHECKED:int64=128

# A new node of kind at pos, every other field zero
# Does an unchecked call's type wait for the parameter it meets (0 no, 1 only its result gives a
# type parameter, 2 only bare literals do), asked of the checker's host; an array literal argument
# is asked first, for its elements. Nothing here until the host binds it.
# (by name, a callee that never waits: such calls skip the question)
let call_waits_never:array<bool>=[]
call_waits_none=(node:int64):>int64=>0
let call_waits_hook:<(node:int64):>int64>=@call_waits_none
call_waits_bind=(f:<(node:int64):>int64>):>int64=>{
    call_waits_hook=@f
    0
}
node_mk=(@store:array<Node> kind:NK pos:int64):>int64=>{
    let idx=store.length
    store.push(Node[kind=kind pos=pos])
    idx
}

# xs as a new run of lists; its start
node_run=(@lists:array<int32> xs:array<int64>):>int64=>$unsafe {
    let start=lists.length
    let count=xs.length
    if count >? 0 {
        let need=start + count
        if cap(lists) <? need {lists.reserve(need)}
        __set_len(lists need)
        let src=xs.ptr
        loop i in [0..count) {lists[start + i]=int32<overflow='wrap'>(src[i])}
    }
    start
}

# n's children (list) and its second list (list2) are xs, as a new run of lists
node_set_list=(@store:array<Node> @lists:array<int32> n:int64 xs:array<int64>)=>$unsafe {
    let start=lists.length
    let count=xs.length
    if count >? 0 {
        let need=start + count
        if cap(lists) <? need {lists.reserve(need)}
        __set_len(lists need)
        let src=xs.ptr
        loop i in [0..count) {lists.ptr[start + i]=int32<overflow='wrap'>(src[i])}
    }
    store.ptr[n].list=int32<overflow='wrap'>(start)
    store.ptr[n].nlist=int32<overflow='wrap'>(count)
}

node_set_list2=(@store:array<Node> @lists:array<int32> n:int64 xs:array<int64>)=>$unsafe {
    let start=lists.length
    let count=xs.length
    if count >? 0 {
        let need=start + count
        if cap(lists) <? need {lists.reserve(need)}
        __set_len(lists need)
        let src=xs.ptr
        loop i in [0..count) {lists[start + i]=int32<overflow='wrap'>(src[i])}
    }
    store[n].list2=int32<overflow='wrap'>(start)
    store[n].nlist2=int32<overflow='wrap'>(count)
}

node_append_raw=(@lists:array<int32> src:ptr<int64> count:int64):>int64=>$unsafe {
    let start=lists.length
    if count >? 0 {
        let need=start + count
        if cap(lists) <? need {lists.reserve(need)}
        __set_len(lists need)
        loop i in [0..count) {lists.ptr[start + i]=int32<overflow='wrap'>(src[i])}
    }
    start
}

node_set_list_span=(@store:array<Node> @lists:array<int32> n:int64 @buf:array<int64> base:int64)=>$unsafe {
    let count=buf.length - base
    let start=node_append_raw(@lists buf.ptr + base count)
    if count >? 0 {__set_len(buf base)}
    store.ptr[n].list=int32<overflow='wrap'>(start)
    store.ptr[n].nlist=int32<overflow='wrap'>(count)
}

# a run of lists as an array
node_run_of=(@lists:array<int32> start:int64 count:int64):>array<int64>=>$unsafe {
    let out:array<int64>=[]
    if count >? 0 {
        out.reserve(count)
        __set_len(out count)
        let dst=out.ptr
        loop i in [0..count) {dst[i]=int64(lists[start + i])}
    }
    out
}

node_kids=(@store:array<Node> @lists:array<int32> n:int64):>array<int64>=>$unsafe {node_run_of(@lists int64(store.ptr[n].list) int64(store.ptr[n].nlist))}
node_kids2=(@store:array<Node> @lists:array<int32> n:int64):>array<int64>=>$unsafe {node_run_of(@lists int64(store.ptr[n].list2) int64(store.ptr[n].nlist2))}

# A deep copy of a subtree (generic functions are instantiated so): the copy's own fields
# first, unchecked, then its children's copies, in order
let node_clone_buf:array<int64>=[]
node_clone=(@store:array<Node> @lists:array<int32> n:int64):>int64=>$unsafe {
    if n =? 0 {return 0}
    let sh=(store.ptr as ptr<int64>) - 3
    if store.ptr =? (uint64(0) as ptr<Node>) or sh[0] not=? 1 or sh[1] >=? sh[2] {
        let oc=store.length
        store.reserve(max(oc + 1 oc * 2))
        sh=(store.ptr as ptr<int64>) - 3
    }
    let c=sh[1]
    sh[1]=c + 1
    let dst=store.ptr + c
    mem_copy(dst store.ptr + n size_of<Node>)
    let k=dst[0].kind
    if k not=? 'fn_' and k not=? 'struct_' and k not=? 'enum_' {dst[0].sym=0}
    if k not=? 'conv' {dst[0].type=0}
    dst[0].flags=int32<overflow='wrap'>(dst[0].flags and not NODE_CHECKED)
    let na=int64(dst[0].a)
    let nb=int64(dst[0].b)
    let nc=int64(dst[0].c)
    let nd_=int64(dst[0].d)
    let nl1=int64(dst[0].nlist)
    let nl2=int64(dst[0].nlist2)
    if (na | nb | nc | nd_ | nl1 | nl2) =? 0 {return c}
    let l1=int64(dst[0].list)
    let l2=int64(dst[0].list2)
    if na not=? 0 {let ra=int32<overflow='wrap'>(node_clone(@store @lists na)); store.ptr[c].a=ra}
    if nb not=? 0 {let rb=int32<overflow='wrap'>(node_clone(@store @lists nb)); store.ptr[c].b=rb}
    if nc not=? 0 {let rc=int32<overflow='wrap'>(node_clone(@store @lists nc)); store.ptr[c].c=rc}
    if nd_ not=? 0 {let rd=int32<overflow='wrap'>(node_clone(@store @lists nd_)); store.ptr[c].d=rd}
    if nl1 >? 0 {
        if nl1 =? 1 {
            let c0=int32<overflow='wrap'>(node_clone(@store @lists int64(lists.ptr[l1])))
            let start=lists.length
            lists.push(c0)
            store.ptr[c].list=int32<overflow='wrap'>(start)
            store.ptr[c].nlist=int32(1)
        } else if nl1 =? 2 {
            let k0=int64(lists.ptr[l1])
            let k1=int64(lists.ptr[l1 + 1])
            let c0=int32<overflow='wrap'>(node_clone(@store @lists k0))
            let c1=int32<overflow='wrap'>(node_clone(@store @lists k1))
            let start=lists.length
            lists.push(c0)
            lists.push(c1)
            store.ptr[c].list=int32<overflow='wrap'>(start)
            store.ptr[c].nlist=int32(2)
        } else {
            let base=node_clone_buf.length
            loop i in [0..nl1) {
                let child=node_clone(@store @lists int64(lists.ptr[l1 + i]))
                node_clone_buf.push(child)
            }
            let count=node_clone_buf.length - base
            let start=node_append_raw(@lists node_clone_buf.ptr + base count)
            __set_len(node_clone_buf base)
            store.ptr[c].list=int32<overflow='wrap'>(start)
            store.ptr[c].nlist=int32<overflow='wrap'>(count)
        }
    }
    if nl2 >? 0 {
        let base=node_clone_buf.length
        loop i in [0..nl2) {
            let child=node_clone(@store @lists int64(lists.ptr[l2 + i]))
            node_clone_buf.push(child)
        }
        let count=node_clone_buf.length - base
        let start=node_append_raw(@lists node_clone_buf.ptr + base count)
        __set_len(node_clone_buf base)
        store.ptr[c].list2=int32<overflow='wrap'>(start)
        store.ptr[c].nlist2=int32<overflow='wrap'>(count)
    }
    c
}

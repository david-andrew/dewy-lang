# (`m[0 [..]] =? [1 2]`: a 1-D selection against a literal of its elements; `m * [1.0 0.0]`:
# a matrix times a column vector written out, in the matrix's elements)
binary_nd_hint = (n: int, ta: int, h: int) -> int:
    op = nodes[n].op as Tok
    bk = nodes[int(nodes[n].b)].kind
    if (op == .eq or op == .ne) and is_nd(ta) and bk == .array: return mk_array(nd_elem(ta))
    if op == .star and is_nd(ta) and bk == .array and dewy_at(nodes[n].pos) and is_numeric(nd_elem(ta)): return mk_array(nd_elem(ta))
    h
# `xs[new ..]`, `xs[.. new]`: NumPy's newaxis on nested arrays. Each `new`
# wraps the selection so far in a one-element array; `..` maps over an axis,
# an index selects into it and a range slices it, all from the outside in.
# Axes after the last entry are untouched. `end` is the last index of the
# array at its own depth. Entries are evaluated once, in order, unless they
# are plain arithmetic, which may repeat for every element.
dewy_new_axis = (n: int, expected: int) -> int:
    pos = nodes[n].pos
    entries = kids(n)
    base = if nodes[n].sval != 0: name_of(int(nodes[n].sval)) else: ""
    receiver = int(nodes[n].a)
    t = prune(check_expr(clone(receiver), 0))
    if is_nd(t):
        # (an n-dimensional array: a singleton axis at each `new`, `..` keeping an axis)
        at: int[]
        axis = 0
        loop e in entries:
            if dewy_axis_new(e): at.push(bc_int(axis, pos))
            else if not dewy_axis_full(e): fatal(nodes[e].pos, "next to `new`, an n-dimensional array takes `..` for each axis it keeps; select first, then add the axis")
            axis += 1
        positions = mk(.array, pos)
        set_list(positions, at)
        nodes[n] = nodes[bc_call("__nd_new_axes", [receiver, positions], pos)]
        return check_expr(n, expected)
    depth = dewy_axis_depth(t)
    if depth == 0: fatal(pos, "`new` inserts an axis into an array or a string, not {dt(t)}")
    axes = 0
    loop e in entries:
        if not dewy_axis_new(e): axes += 1
    if axes > depth: fatal(pos, "{axes} axes selected next to `new`, but {dt(t)} has {depth}")
    source = "$new_source{bc_count}"
    bc_count += 1
    stmts = [bc_let(source, receiver, pos)]
    pinned: int[]
    loop i in 0.. and e in entries:
        if dewy_axis_new(e) or dewy_axis_full(e): pinned.push(e)
        else: pinned.push(dewy_axis_pin(e, dewy_axis_end_name(base, i), stmts, pos))
    stmts.push(bc_stmt(dewy_axis_build(pinned, 0, source, base, pos), pos))
    nodes[n] = nodes[bc_block(stmts, pos)]
    check_expr(n, expected)
# axes reachable by indexing: a string's graphemes are strings again
dewy_axis_depth = (t0: int) -> int:
    t = prune(t0)
    k = types[t].kind
    if k == .str_: return 1000000
    if k == .array or k == .fixed: return 1 + dewy_axis_depth(int(types[t].elem))
    0
dewy_axis_mentions = (e: int, name: int) -> bool:
    if e == 0 or name == 0: return false
    if nodes[e].kind == .ident and nodes[e].name == i32(name): return true
    loop c in [int(nodes[e].a), int(nodes[e].b), kid_c(e), kid_d(e)]:
        if dewy_axis_mentions(c, name): return true
    loop c in kids(e):
        if dewy_axis_mentions(c, name): return true
    false
dewy_axis_pin = (e: int, end_name: str, stmts: mut int[], pos: int) -> int:
    if e == 0: return 0
    name = if end_name == "": 0 else: intern(end_name)
    if dewy_end_arithmetic(e, name): return e
    if nodes[e].kind == .range:
        nodes[e].a = i32(dewy_axis_pin(int(nodes[e].a), end_name, stmts, pos))
        nodes[e].b = i32(dewy_axis_pin(int(nodes[e].b), end_name, stmts, pos))
        nodes[e].c = i32(dewy_axis_pin(int(nodes[e].c), end_name, stmts, pos))
        return e
    if dewy_axis_mentions(e, name): fatal(nodes[e].pos, "next to `new`, an index using `end` may only combine it with literals and local values")
    value = "$new_index{bc_count}"
    bc_count += 1
    stmts.push(bc_let(value, e, pos))
    bc_ident(value, pos)
dewy_axis_build = (entries: int[], i: int, source: str, base: str, pos: int) -> int:
    if i == entries.len(): return bc_ident(source, pos)
    e = entries[i]
    if dewy_axis_new(e):
        wrap = mk(.array, pos)
        set_list(wrap, [dewy_axis_build(entries, i + 1, source, base, pos)])
        return wrap
    if dewy_axis_full(e): return dewy_axis_collect(entries, i + 1, source, base, pos)
    stmts: int[]
    end_name = dewy_axis_end_name(base, i)
    if end_name != "" and dewy_axis_mentions(e, intern(end_name)):
        stmts.push(bc_let(end_name, dewy_index_end(bc_ident(source, pos), pos), pos))
    selected = mk(.index, pos)
    nodes[selected].a = i32(bc_ident(source, pos))
    nodes[selected].b = i32(e)
    set_list(selected, [e])
    result = selected
    if nodes[e].kind == .range or i + 1 < entries.len():
        part = "$new_part{bc_count}"
        bc_count += 1
        stmts.push(bc_let(part, selected, pos))
        result = if nodes[e].kind == .range: dewy_axis_collect(entries, i + 1, part, base, pos) else: dewy_axis_build(entries, i + 1, part, base, pos)
    if stmts.len() == 0: return result
    stmts.push(bc_stmt(result, pos))
    bc_block(stmts, pos)
# [loop item in source <the rest of the entries applied to item>]
dewy_axis_collect = (entries: int[], i: int, source: str, base: str, pos: int) -> int:
    collection = "$dewy_collection_{nodes.len()}"
    item = "$new_item{bc_count}"
    bc_count += 1
    each = mk(.for_, pos)
    set_list(each, [bc_ident(item, pos)])
    nodes[each].a = i32(bc_call("__dewy_iter", [bc_ident(source, pos)], pos))
    receiver = bc_ident(collection, pos)
    add_flag(receiver, NF_MUT)
    push = bc_method(receiver, "push", [dewy_axis_build(entries, i, item, base, pos)], pos)
    nodes[each].b = i32(bc_block([bc_stmt(push, pos)], pos))
    block = bc_block([bc_let(collection, mk(.array, pos), pos), each, bc_stmt(bc_ident(collection, pos), pos)], pos)
    add_flag(block, NF_COMPREHENSION)
    block
# name: t (its zero value)
bc_decl = (name: str, t: int, pos: int) -> int:
    d = mk(.vardecl, pos)
    nodes[d].name = i32(intern(name))
    ty = mk(.tname, pos)
    nodes[ty].aux = -7
    nodes[ty].ival = t
    nodes[d].a = i32(ty)
    d
# loop name in [0..n): body
bc_loop = (name: str, n: int, body: int[], pos: int) -> int:
    f = mk(.for_, pos)
    set_list(f, [bc_ident(name, pos)])
    r = mk(.range, pos)
    nodes[r].a = i32(bc_int(0, pos))
    nodes[r].b = i32(n)
    nodes[f].a = i32(r)
    nodes[f].b = i32(bc_block(body, pos))
    f
# the operator a dotted operator applies to each element (.+ is +, .<= is <=, ...)
dot_base_op = (n: int) -> Tok:
    c = int(nodes[n].aux)
    three = nodes[n].aux2 == 1
    if c == '+': return .plus
    if c == '-': return .minus
    if c == '*': return .star
    if c == '/': return .slash
    if c == '%': return .percent
    if c == '<':
        if three: return .le
        return .lt
    if c == '>':
        if three: return .ge
        return .gt
    if c == '=': return .eq
    if c == '!': return .ne
    .caret
# the per-element expression of dotted expression n; its operands go to `leaves` (replaced by
# __b<tag>e<k>, the current element of operand k); literals stay in place (and keep adapting)
dot_template = (n: int, leaves: mut int[], tag: str) -> int:
    pos = nodes[n].pos
    k = nodes[n].kind
    if k == .unary and has_flag(n, NF_BROADCAST):
        a = dot_template(int(nodes[n].a), leaves, tag)
        result = mk(.unary, pos)
        nodes[result].op = nodes[n].op
        nodes[result].a = i32(a)
        return result
    if k == .binary and nodes[n].op == i32(int(Tok.dotop)):
        a = dot_template(int(nodes[n].a), leaves, tag)
        b = dot_template(int(nodes[n].b), leaves, tag)
        op = dot_base_op(n)
        if op == .caret: return bc_call("pow", [a, b], pos)
        result = bc_bin(op, a, b, pos)
        add_flag(result, NF_BROADCAST)
        # Dewy's .not<? negates the comparison, including unordered floats.
        if nodes[n].ival != 0:
            negated = mk(.not_, pos)
            nodes[negated].a = i32(result)
            return negated
        return result
    if k == .call and has_flag(n, NF_BROADCAST):
        c = mk(.call, pos)
        nodes[c].a = nodes[n].a
        # (`@load.(sources)`: each element a partial, `@load(source)`, an argument group of an
        # ungrouped `@` chain; nothing is called. decisions.md batch 7, select-v6.md)
        if nodes[n].aux2 == i32(AUX2_PARTIAL): nodes[c].aux2 = nodes[n].aux2
        args: int[]
        loop x in kids(n): args.push(dot_template(x, leaves, tag))
        set_list(c, args)
        return c
    if (k == .int_lit or k == .float_lit or k == .bool_lit) and not has_flag(n, NF_CHECKED): return n
    # (and a temperature literal: next to a point it is a difference, ts .+ 5°C)
    if k == .binary and quantity_literal_syntax(n): return n
    leaves.push(n)
    bc_ident("__b{tag}e{leaves.len() - 1}", pos)
# the loops computing a dotted expression over n-dimensional arrays: kinds[k] is 1 for a 1-D
# array, 2 for an n-dimensional one, 0 for a number; arrs[k] names the array. When no operand is
# stretched (the usual case) one flat loop runs over every element, as for 1-D arrays; otherwise
# the result's last dimension is the inner loop and the outer loop finds where each operand's row
# starts. The library checks each operand's data against its shape once, so the element reads
# need no checks of their own.
bc_loop_nd = (tmpl: int, arrs: str[], kinds: int[], pre: str, epre: str, pos: int, storage: int = 0) -> int[]:
    stmts: int[]
    rowpre: int[]
    body: int[]
    out = "{pre}o"
    shp = (k: int) -> int:
        if kinds[k] == 2: return bc_field(bc_ident(arrs[k], pos), "shape", pos)
        a = mk(.array, pos)
        set_list(a, [bc_call("len", [bc_ident(arrs[k], pos)], pos)])
        a
    shs: int[]
    loop k in [0..kinds.len()):
        if kinds[k] > 0: shs.push(shp(k))
    sa = mk(.array, pos)
    set_list(sa, shs)
    id = (nm: str) -> int: bc_ident("{pre}{nm}", pos)
    stmts.push(bc_let("{pre}shs", sa, pos))
    stmts.push(bc_let("{pre}shp", bc_call("__bcast_shape", [id("shs")], pos), pos))
    # (the operands' dimensions are nonnegative, and so is each of the result's)
    stmts.push(bc_let("{pre}n", bc_call("__nd_count", [id("shp")], pos), pos))
    # (each operand's own element count: nothing here writes the caller's places)
    counts: int[]
    loop k in [0..kinds.len()):
        if kinds[k] > 0: counts.push(bc_call("__nd_count", [shp(k)], pos))
    ca = mk(.array, pos)
    set_list(ca, counts)
    stmts.push(bc_let("{pre}cs", ca, pos))
    stmts.push(bc_let("{pre}in", bc_call("__bcast_inner", [id("cs"), id("n"), id("shp")], pos), pos))
    stmts.push(bc_let("{pre}on", bc_call("__bcast_rows", [id("n"), id("in")], pos), pos))
    flat: str[]
    advance: int[]
    loop k in [0..kinds.len()):
        if kinds[k] == 0:
            flat.push("")
            continue
        src = bc_ident(arrs[k], pos)
        if kinds[k] == 2: src = bc_call("__bcast_data", [bc_ident(arrs[k], pos)], pos)
        stmts.push(bc_let("{pre}x{k}", src, pos))
        flat.push("{pre}x{k}")
        stmts.push(bc_let("{pre}st{k}", bc_call("__bcast_strides", [shp(k), id("shp")], pos), pos))
        stmts.push(bc_let("{pre}ls{k}", bc_call("__bcast_last", [id("st{k}"), bc_call("len", [id("x{k}")], pos), id("n")], pos), pos))
        # (q{k} walks operand k's row: by its last stride, 0 where it stretches)
        rowpre.push(bc_let("{pre}q{k}", bc_call("__bcast_offset", [id("r"), id("shp"), id("st{k}")], pos), pos))
        ix = mk(.index, pos)
        nodes[ix].a = i32(id("x{k}"))
        nodes[ix].b = i32(id("q{k}"))
        # (the shapes broadcast and each operand's data matches its shape: in bounds)
        add_flag(ix, NF_INBOUNDS)
        body.push(bc_let("{epre}e{k}", ix, pos))
        step = mk(.assign, pos)
        nodes[step].a = i32(id("q{k}"))
        nodes[step].b = i32(bc_bcast_index([bc_int(1, pos), id("q{k}"), id("ls{k}")], pos))
        nodes[step].op = i32(int(Tok.assign))
        advance.push(step)
    # (room for every element, written in place: element i in step i)
    output = bc_let(out, mk(.array, pos), pos)
    # Private zeroed output, filled exactly once by these generated loops.
    add_flag(int(nodes[output].b), NF_BROADCAST)
    if storage != 0: nodes[output].a = i32(type_node_of(storage, pos))
    stmts.push(output)
    stmts.push(bc_stmt(bc_method(bc_ident(out, pos), "reserve", [id("n")], pos), pos))
    setlen = bc_call("__set_len", [bc_ident(out, pos), id("n")], pos)
    add_flag(setlen, NF_PRIVATE_SETLEN)
    stmts.push(bc_stmt(setlen, pos))
    # (every operand has the result's size: element i of each is at i, one flat loop)
    fast = [bc_loop("{pre}i", id("n"), bc_body1(clone(tmpl), flat, pre, epre, out, false, pos), pos)]
    # These are private coordinates of the checked broadcast, as the
    # NF_INBOUNDS reads above are. Keep their arithmetic in the library's
    # word domain; the user's element expression still has exact arithmetic.
    rowpre.push(bc_let("{pre}ob", bc_bcast_index([id("r"), id("in"), bc_int(0, pos)], pos), pos))
    ixo = mk(.index, pos)
    nodes[ixo].a = i32(bc_ident(out, pos))
    nodes[ixo].b = i32(bc_bcast_index([bc_int(1, pos), id("ob"), id("j")], pos))
    add_flag(ixo, NF_INBOUNDS)
    store = mk(.assign, pos)
    nodes[store].a = i32(ixo)
    nodes[store].b = i32(tmpl)
    nodes[store].op = i32(int(Tok.assign))
    body.push(store)
    loop step in advance: body.push(step)
    rowpre.push(bc_loop("{pre}j", id("in"), body, pos))
    slow = [bc_loop("{pre}r", id("on"), rowpre, pos)]
    stmts.push(bc_if(bc_bin(.eq, id("in"), id("n"), pos), fast, slow, pos))
    stmts.push(bc_stmt(bc_call("NDArray", [bc_ident(out, pos), id("shp")], pos), pos))
    stmts
# the loop computing a dotted expression over 1-D arrays: arrs[k] names operand k's array ("" for
# a number, whose element variable already exists); `pre` names the loop's variables, `epre` the
# element variables the template uses. The last statement is the result.
bc_loop1 = (tmpl: int, arrs: str[], pre: str, epre: str, pos: int, storage: int = 0) -> int[]:
    stmts: int[]
    out = "{pre}o"
    lens: int[]
    loop a in arrs:
        if len(a) > 0: lens.push(bc_call("len", [bc_ident(a, pos)], pos))
    larr = mk(.array, pos)
    set_list(larr, lens)
    stmts.push(bc_let("{pre}n", bc_call("__bcast", [larr], pos), pos))
    loop k in 0.. and a in arrs:
        if len(a) == 0: continue
        stmts.push(bc_let("{pre}s{k}", bc_step(bc_call("len", [bc_ident(a, pos)], pos), pos), pos))
    output = bc_let(out, mk(.array, pos), pos)
    # Private zeroed output, filled exactly once by these generated loops.
    add_flag(int(nodes[output].b), NF_BROADCAST)
    if storage != 0: nodes[output].a = i32(type_node_of(storage, pos))
    stmts.push(output)
    stmts.push(bc_stmt(bc_method(bc_ident(out, pos), "reserve", [bc_ident("{pre}n", pos)], pos), pos))
    # (room for every element is reserved, in an array of the loop's own: it has all its
    # elements from the start, zeros until written, and element i is written in step i)
    setlen = bc_call("__set_len", [bc_ident(out, pos), bc_ident("{pre}n", pos)], pos)
    add_flag(setlen, NF_PRIVATE_SETLEN)
    stmts.push(bc_stmt(setlen, pos))
    # with every operand as long as the result (the usual case) element i of each is at i: a
    # loop the compiler can run several elements at a time; else operands are stretched
    all_one = 0
    loop k in 0.. and a in arrs:
        if len(a) == 0: continue
        c = bc_bin(.eq, bc_ident("{pre}s{k}", pos), bc_int(1, pos), pos)
        if all_one == 0: all_one = c
        else:
            x = mk(.and_, pos)
            nodes[x].a = i32(all_one)
            nodes[x].b = i32(c)
            all_one = x
    fast = bc_loop("{pre}i", bc_ident("{pre}n", pos), bc_body1(clone(tmpl), arrs, pre, epre, out, false, pos), pos)
    if all_one == 0:
        stmts.push(fast)
    else:
        slow = bc_loop("{pre}i", bc_ident("{pre}n", pos), bc_body1(tmpl, arrs, pre, epre, out, true, pos), pos)
        ifn = mk(.if_, pos)
        nodes[ifn].a = i32(all_one)
        nodes[ifn].b = i32(bc_block([fast], pos))
        nodes[ifn].c = i32(bc_block([slow], pos))
        stmts.push(ifn)
    stmts.push(bc_stmt(bc_ident(out, pos), pos))
    stmts
# the body of the loop over 1-D operands: their elements (at i, or at i * step when stretched),
# then the result's element i
bc_body1 = (tmpl: int, arrs: str[], pre: str, epre: str, out: str, stretched: bool, pos: int) -> int[]:
    body: int[]
    loop k in 0.. and a in arrs:
        if len(a) == 0: continue
        ix = mk(.index, pos)
        nodes[ix].a = i32(bc_ident(a, pos))
        if stretched:
            # Step is exactly zero or one by construction. Selecting the
            # index states that proof directly, without an overflow obligation
            # on an otherwise unbounded generated signed multiplication.
            choice = mk(.if_, pos)
            nodes[choice].a = i32(bc_bin(.eq, bc_ident("{pre}s{k}", pos), bc_int(1, pos), pos))
            nodes[choice].b = i32(bc_block([bc_stmt(bc_ident("{pre}i", pos), pos)], pos))
            nodes[choice].c = i32(bc_block([bc_stmt(bc_int(0, pos), pos)], pos))
            nodes[ix].b = i32(choice)
        else: nodes[ix].b = i32(bc_ident("{pre}i", pos))
        # (i < n, and an operand's step is 1 only when its length is n: in bounds)
        add_flag(ix, NF_INBOUNDS)
        body.push(bc_let("{epre}e{k}", ix, pos))
    ixo = mk(.index, pos)
    nodes[ixo].a = i32(bc_ident(out, pos))
    nodes[ixo].b = i32(bc_ident("{pre}i", pos))
    add_flag(ixo, NF_INBOUNDS)
    asg = mk(.assign, pos)
    nodes[asg].a = i32(ixo)
    nodes[asg].b = i32(tmpl)
    nodes[asg].op = i32(int(Tok.assign))
    body.push(asg)
    body
# Broadcasting immediately flattens numeric rows. A singleton new axis can
# use the original flat value with a shape, avoiding nested row construction
# and flattening. The ordinary value copy preserves snapshot semantics.
bc_flat_new_axis = (n: int) -> int:
    if nodes[n].kind != .new_axis or nkids(n) != 2: return n
    first = kid(n, 0); second = kid(n, 1)
    row = dewy_axis_new(first) and dewy_axis_full(second)
    column = dewy_axis_full(first) and dewy_axis_new(second)
    if not row and not column: return n
    receiver = int(nodes[n].a)
    t = prune(check_expr(clone(receiver), 0))
    if types[t].kind != .array or not is_numeric(int(types[t].elem)): return n
    pos = nodes[n].pos
    name = "$flat_axis{bc_count}"
    bc_count += 1
    length = bc_field(bc_ident(name, pos), "length", pos)
    # (`new` inserts an extent-1 axis: an empty column is [0 1], as documented)
    rows = if row: bc_int(1, pos) else: length
    cols = if row: length else: bc_int(1, pos)
    bc_block([bc_let(name, receiver, pos), bc_stmt(bc_call("__array2", [bc_ident(name, pos), rows, cols], pos), pos)], pos)
check_dotted = (n: int, expected: int) -> int:
    pos = nodes[n].pos
    bc_count += 1
    tag = "{bc_count}"
    leaves: int[]
    tmpl = dot_template(n, leaves, tag)
    pre = "__b{tag}"
    stmts: int[]
    ranks: int[]
    rank = 0
    gpu = false
    loop k in [0..leaves.len()):
        lf = bc_flat_new_axis(leaves[k])
        check_expr(lf, 0)
        lf = last_checked
        finalize_literal(lf)
        t = prune(ntype(lf))
        if types[t].kind == .fixed:
            t = mk_array(int(types[t].elem))
            lf = coerce(lf, t)
        # (nested rows of numbers, `xs[new ..]` or `[[1 2] [3 4]]`, are a 2-D operand)
        if types[t].kind == .array and tkind(int(types[t].elem)) == .array and (is_numeric(int(types[prune(int(types[t].elem))].elem)) or tkind(int(types[prune(int(types[t].elem))].elem)) == .bool_):
            lf = bc_call("__array2_rows", [lf], pos)
            t = prune(check_expr(lf, 0))
            lf = last_checked
        r = 0
        if types[t].kind == .array: r = 1
        else if is_nd(t): r = 2
        else if is_gpu_array(t):
            r = 3
            gpu = true
        ranks.push(r)
        if r > rank and r < 3: rank = r
        # Contract diagnostics refer to the captured source, not __b temporaries.
        index_update_sources[intern("{pre}d{k}")] = lf
        stmts.push(bc_let("{pre}d{k}", lf, pos))
    d = (k: int) -> int: bc_ident("{pre}d{k}", pos)
    # scalars: the same value for every element
    loop k in [0..leaves.len()):
        if ranks[k] == 0: stmts.push(bc_let("{pre}e{k}", d(k), pos))
    if rank == 0 and not gpu:
        stmts.push(bc_stmt(tmpl, pos))
        nodes[n] = nodes[bc_block(stmts, pos)]
        return check_expr(n, expected)
    # The destination supplies the output element storage, just as for an
    # array comprehension. Arithmetic stays exact until each element write.
    storage = 0
    if expected != 0:
        target = representation_type(prune(expected))
        if tkind(target) == .array: storage = target
        else if is_nd(target): storage = mk_array(nd_elem(target))
        if storage != 0 and not is_int(exact_representation(telem(storage))): storage = 0
    result = 0
    if gpu:
        # GPU arrays: one fragment program, or the same loop on the CPU where there is no GPU
        # (each operand is an f32 or i32 in the GPU program: arrays by their element type, numbers
        # by whether they are integers)
        desc = ""
        params: int[]
        gins: int[]
        fscal: int[]
        iscal: int[]
        harrs: str[]
        hstmts: int[]
        loop k in [0..leaves.len()):
            pm = mk(.param, pos)
            nodes[pm].name = i32(intern("{pre}e{k}"))
            ty = mk(.tname, pos)
            nodes[ty].aux = -7
            et = T_F32
            harrs.push("")
            if ranks[k] == 3:
                gt = prune(ntype(d0_leaf(stmts, k)))
                if is_int(struct_targ(int(types[gt].st), 0)):
                    et = policy_int(T_I32, 1, pos)
                    desc += "i"
                else: desc += "t"
                gins.push(bc_call("__gpu_in", [d(k)], pos))
                harrs[k] = "{pre}h{k}"
                hstmts.push(bc_let(harrs[k], bc_call("cpu", [d(k)], pos), pos))
            else if ranks[k] == 0:
                lt = prune(ntype(d0_leaf(stmts, k)))
                if is_int(lt):
                    et = policy_int(T_I32, 1, pos)
                    desc += "n"
                    iscal.push(bc_call("i32", [d(k)], pos))
                else:
                    desc += "s"
                    fscal.push(bc_call("f32", [d(k)], pos))
            else: fatal(nodes[leaves[k]].pos, "this array is in CPU memory: upload it with gpu(xs) to use it with GPU arrays")
            nodes[ty].ival = et
            nodes[pm].a = i32(ty)
            params.push(pm)
        lam = mk(.lambda, pos)
        set_list(lam, params)
        nodes[lam].b = i32(bc_block([bc_stmt(clone(tmpl), pos)], pos))
        # (the expression's type decides the result's: integers stay integers)
        lt = prune(check_expr(lam, 0))
        lam = last_checked
        rt = prune(int(types[lt].elem))
        if not is_int(rt) and not is_float(rt) and types[rt].kind != .bool_:
            fatal(pos, "GPU array expressions must return a fixed-width integer, float or bool, found {dt(rt)}; use CPU arrays for exact rationals and managed values")
        runf = "__gpu_run_f"
        if is_int(rt): runf = "__gpu_run_i"
        ds = mk(.str_lit, pos)
        nodes[ds].sval = i32(intern(desc))
        ga = mk(.array, pos)
        set_list(ga, gins)
        # (the operands' broadcast, an obligation as a CPU array's is)
        gs = mk(.array, pos)
        gshapes: int[]
        loop k in [0..leaves.len()):
            if ranks[k] == 3: gshapes.push(bc_field(d(k), "shape", pos))
        set_list(gs, gshapes)
        stmts.push(bc_let("{pre}gsh", bc_call("__bcast_shape", [gs], pos), pos))
        run = bc_call(runf, [bc_call("__gpu_kernel", [lam, ds], pos), ga, typed_array(fscal, T_F32, pos), typed_array(iscal, T_I32, pos), bc_ident("{pre}gsh", pos)], pos)
        hkinds: int[]
        loop k in [0..leaves.len()):
            if ranks[k] == 3: hkinds.push(2)
            else: hkinds.push(0)
        loop x in bc_loop_nd(tmpl, harrs, hkinds, "{pre}c", pre, pos): hstmts.push(x)
        hb = bc_block(hstmts, pos)
        cpu = bc_call("__gpu_from", [hb], pos)
        iff = mk(.if_, pos)
        nodes[iff].a = i32(bc_call("gpu_available", [], pos))
        nodes[iff].b = i32(bc_block([bc_stmt(run, pos)], pos))
        nodes[iff].c = i32(bc_block([bc_stmt(cpu, pos)], pos))
        result = iff
    else if rank == 1:
        arrs: str[]
        loop k in [0..leaves.len()):
            if ranks[k] == 1: arrs.push("{pre}d{k}")
            else: arrs.push("")
        ls = bc_loop1(tmpl, arrs, pre, pre, pos, storage)
        loop i in [0..ls.len() - 1): stmts.push(ls[i])
        result = int(nodes[ls[ls.len() - 1]].a)
    else:
        # n-dimensional: shapes broadcast like numpy (a 1-D array is a row)
        arrs: str[]
        loop k in [0..leaves.len()):
            if ranks[k] == 1 or ranks[k] == 2: arrs.push("{pre}d{k}")
            else: arrs.push("")
        ls = bc_loop_nd(tmpl, arrs, ranks, pre, pre, pos, storage)
        loop i in [0..ls.len() - 1): stmts.push(ls[i])
        result = int(nodes[ls[ls.len() - 1]].a)
    stmts.push(bc_stmt(result, pos))
    nodes[n] = nodes[bc_block(stmts, pos)]
    result_type = check_expr(n, expected)
    if cx >= 0 and not gpu:
        t = prune(result_type)
        elem = if tkind(t) == .array: telem(t) else if is_nd(t): nd_elem(t) else: 0
        if elem == T_MATH_INT:
            owner = int(ctxs[cx].inst)
            if owner > 0:
                exact_owners[owner] = true
                exact_full_owners[owner] = true
    result_type

$runtime_checks
from p"checker_call_queries.dewy" import (collect_module)
from p"refine_metadata.dewy" import (representation_type)
from p"checker_type_entries.dewy" import (get_fn_inst)
from p"check.jo" import (fns lib_dir syms)
from p"collection_checks.dewy" import (dewy_whole_collection)
from p"checker_source_positions.dewy" import (dewy_at)
from p"call_shape_queries.dewy" import (bare_fns_call)
from p"numeric_library_types.dewy" import (is_nd)
from p"member_receivers.dewy" import (is_dewy_range_type)
from p"ast.jo" import (clone kid kids mk nkids nodes set_kid set_list)
from p"checker_expr.dewy" import (check_expr lookup)
from p"checks_thin.dewy" import (jd)
from p"diagnostic_exit.dewy" import (fatal)
from p"range_checks.dewy" import (dewy_range_value)
from p"type_ops.dewy" import (dt mk_array)
from p"types.jo" import (T_INT T_MATH_INT is_int prune telem tkind types)
from p"util.jo" import (files intern name_of pos_file)

IndexOperandWord:type=int64<overflow='wrap'>

# Brackets also construct records and call user-defined indexing operators. Keep
# range syntax until the receiver type is known: NDArray uses axis slices, while
# other multi-argument brackets receive ordinary stored range values.
dewy_index_ranges=(n:IndexOperandWord receiver:IndexOperandWord):>void=>$unsafe {
    if not files[pos_file(nodes.ptr[n].pos)].is_dewy or is_nd(receiver) {return}
    if nkids(n) <? 2 and types.ptr[receiver].kind not=? 'typeval' {return}
    loop i in [0..nkids(n)) {
        let r=kid(n i)
        if nodes.ptr[r].kind =? 'range' {
            let value=dewy_range_value(r)
            set_kid(n i value)
            if int64(nodes.ptr[n].b) =? r {nodes.ptr[n].b=int32(value)}
        }
    }
}

# xs[b] with b a bool[] (a mask) or int[] (indexes): the function that picks (or sets) them
index_array_fn=(b:IndexOperandWord base:string):>string=>$unsafe {
    let expected=if nodes.ptr[b].kind =? 'array' and nkids(b) =? 0 and nodes.ptr[b].b =? 0 {mk_array(T_INT)} else {T_INT}
    let it=prune(check_expr(b expected))
    if is_dewy_range_type(it "IntRange") {return base}
    if types.ptr[it].kind not=? 'array' and types.ptr[it].kind not=? 'fixed' {return ""}
    let et=prune(IndexOperandWord(types.ptr[it].elem))
    if types.ptr[et].kind =? 'bool_' {return "{base}_mask"}
    if et =? T_INT or et =? T_MATH_INT {return "{base}_indices"}
    fatal(nodes.ptr[b].pos jd(nodes.ptr[b].pos "an array of indexes is int[], or a mask bool[] (found {dt(it)})" "an array of indexes is array<int64>, or a mask array<bool> (found {dt(it)})"))
    ""
}

# (xs[-1], s[-3..]: counting from the end, as Python and JavaScript do)
neg_index_check=(b:IndexOperandWord):>void=>$unsafe {
    if nodes.ptr[b].kind not=? 'int_lit' or nodes.ptr[b].ival >=? 0 {return}
    let k= -IndexOperandWord(nodes.ptr[b].ival)
    let e=if k >? 1 {"end - {k - 1}"} else {"end"}
    fatal(nodes.ptr[b].pos "an index counts from 0; from the end it is `{e}` (`xs[end]` is the last, `xs[end - 2..]` the last three)")
}

# `mean[t1 t2]`: a function named before an array literal is called with it, as with a
# string literal (`printl"hi"`). A function that takes nothing is called first instead
# (f[0] indexes f()).
dewy_bracket_call=(n:int64):>bool=>$unsafe {
    let base=IndexOperandWord(nodes.ptr[n].a)
    if nodes.ptr[base].kind not=? 'ident' or nodes.ptr[n].sval not=? 0 or nkids(n) =? 0 or not dewy_at(nodes.ptr[n].pos) {return false}
    let nm=IndexOperandWord(nodes.ptr[base].name)
    let s=lookup(nm)
    if s =? 0 or syms.ptr[s].kind not=? 'fns' or bare_fns_call(nm (-1)) not=? 0 {return false}
    loop x in kids(n) {
        let k=nodes.ptr[x].kind
        if k =? 'range' or k =? 'namedarg' or (k =? 'ident' and name_of(IndexOperandWord(nodes.ptr[x].name)) =? "$new") {return false}
    }
    let items=if nkids(n) =? 1 and dewy_whole_collection(kid(n 0)) {kid(n 0)} else {mk('array' nodes.ptr[n].pos)}
    if items not=? kid(n 0) {set_list(items kids(n))}
    nodes[n].kind = 'call'
    nodes[n].b = 0
    set_list(n [items])
    true
}

# A matrix part can use literal ranges, stored IntRange values or index arrays.
is_part_index=(n:int64 receiver:int64=0):>bool=>$unsafe {
    let ixs=kids(n)
    if nodes.ptr[n].b not=? 0 {ixs=[IndexOperandWord(nodes.ptr[n].b)]}
    loop x in ixs {
        if nodes.ptr[x].kind =? 'range' {return true}
    }
    if is_nd(receiver) {
        loop x in ixs {
            let t=representation_type(check_expr(clone(x) 0))
            if is_dewy_range_type(t "IntRange") {return true}
            if (tkind(t) =? 'array' or tkind(t) =? 'fixed') and is_int(telem(t)) {return true}
        }
    }
    false
}

# ---------------- unions: `is` and narrowing ----------------
# x is T: aux = the member's index for a union; -1 (is none) or -2 (has a value) for an optional
# When only Map.get's outer optional tag is observed, use its presence query.
# Keep the checked expression intact for types and conservative effect analysis;
# lowering uses the original arguments and their written evaluation order.
map_presence_fn=(call:int64):>int64=>$unsafe {
    if nodes.ptr[call].kind not=? 'call' or nodes.ptr[call].aux not=? 0 or nkids(call) not=? 2 {return 0}
    let f=IndexOperandWord(nodes.ptr[call].sym)
    let d=IndexOperandWord(fns.ptr[f].decl)
    if d =? 0 or nodes.ptr[d].name not=? intern("get") {return 0}
    let path="{lib_dir}/core/map.jo"
    if files.ptr[pos_file(nodes.ptr[d].pos)].path not=? path {return 0}
    let decls:array<int64>=[]
    collect_module(IndexOperandWord(nodes.ptr[d].mod) intern("has") @decls)
    loop candidate in decls {
        if files.ptr[pos_file(nodes.ptr[candidate].pos)].path =? path {
            return get_fn_inst(candidate fns.ptr[f].targs nodes.ptr[call].pos)
        }
    }
    0
}

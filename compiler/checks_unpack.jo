# statement calling a prelude function with the given argument nodes
# a, b = xs with an array: its elements, as a tuple (__unpack2(xs): the length checked)
unpack_binding = (e: int, t: int, bindings: int[], pos: int) -> (int, int[]):
    if not files[pos_file(pos)].is_dewy: return (unpack_array(e, t, bindings.len(), pos), bindings)
    leaves: int[]
    # (a bare `...` drops values: it binds nothing)
    loop leaf in binding_leaves(bindings):
        if not (nodes[leaf].kind == .hole and has_flag(leaf, NF_SPREAD)): leaves.push(leaf)
    nested = false
    annotated = false
    special = false
    loop b in bindings:
        if nodes[b].kind == .tuple: nested = true
        if nodes[b].a != 0: annotated = true
        if has_flag(b, NF_SPREAD) or nodes[b].sval != 0: special = true
    if not nested and not annotated and not special and types[t].kind != .array and types[t].kind != .fixed and types[t].kind != .struct_:
        if types[t].kind == .tuple and int(types[t].nargs) != bindings.len(): unpack_count_error(e, t, bindings.len(), false, pos)
        return (t, bindings)
    statements: int[]
    values: int[]
    unpack_values(e, t, bindings, pos, statements, values)
    tuple = mk(.tuple, pos)
    set_list(tuple, values)
    result_type = check_expr(tuple, 0)
    # Reads erase refinements, but each written pattern annotation governs
    # the new storage. Preserve the already checked leaf contracts in the
    # unpacked tuple descriptor (locals and globals share this boundary).
    # O(leaves), on the existing unpacking path only.
    storage: int[]
    loop i in [0..leaves.len()):
        leaf = leaves[i]
        storage.push(if nodes[leaf].a != 0: int(nodes[leaf].type) else: targ(result_type, i))
    result_type = mk_tuple(storage)
    nodes[tuple].type = i32(result_type)
    result = mk(.exprstmt, pos)
    nodes[result].a = i32(last_checked)
    statements.push(result)
    block = mk(.block, pos)
    nodes[block].type = i32(result_type)
    nodes[block].aux = 1
    set_list(block, statements)
    add_flag(block, NF_CHECKED)
    last_checked = block
    (result_type, leaves)
# Several values or a `[T U]` of t's count, unpacked into a pattern taking `count` (at least
# that many with a rest): a compile-time error naming both.
unpack_count_error = (e: int, t: int, count: int, rest: bool, pos: int):
    n = int(types[prune(t)].nargs)
    takes = if rest: "at least {count}" else: "{count}"
    if is_values(t):
        what = if nodes[e].kind == .ident and nodes[e].name > 0: "'{name_of(int(nodes[e].name))}' holds" else: "this gives"
        fatal(pos, "{what} {n} values, and the pattern takes {takes}")
    fatal(pos, "{dt(t)} has {n} positions, and the pattern takes {takes}")
# (the length of captured array src, a fresh read)
unpack_length = (src: int, pos: int) -> int:
    length = mk(.call, pos)
    check_intrinsic(length, int(IN.len), [mk_ident_local(int(nodes[src].sym), pos)], 0)
    add_flag(length, NF_CHECKED)
    length
# Read every leaf before any destination is written. Capturing each container
# once preserves value snapshots and lets nested length checks precede writes.
# A rest (`...rest`) takes what the other names leave, from anywhere in the pattern;
# a bare `...` drops it. Positions after it count from the end.
unpack_values = (e: int, t: int, bindings: int[], pos: int, statements: mut int[], values: mut int[]):
    if is_dewy_set_type(t):
        add_flag(e, NF_CHECKED)
        at = prune(check_expr(bc_call("__dewy_set_values", [e], pos), 0))
        unpack_values(last_checked, at, bindings, pos, statements, values)
        return
    is_fixed = types[t].kind == .fixed
    is_array = types[t].kind == .array or is_fixed
    is_tuple = types[t].kind == .tuple
    is_map = is_map_type(t)
    is_record = not is_array and not is_tuple and not is_map
    if not is_array and not is_tuple and types[t].kind != .struct_:
        fatal(pos, "unpacking needs an array, tuple, dictionary or record, found {dt(t)}")
    r = -1
    drop = false
    loop i in 0.. and b in bindings:
        if has_flag(b, NF_SPREAD):
            r = i
            drop = nodes[b].kind == .hole
        if nodes[b].sval != 0 and not is_record: fatal(nodes[b].pos, "`as` renames a record's field; at a position, any name takes the value: `[a b] = values`")
    count = bindings.len() - (if r >= 0: 1 else: 0)
    after = if r >= 0: bindings.len() - 1 - r else: 0
    if is_record and r >= 0: fatal(nodes[bindings[r]].pos, "a record's rest is not decided yet: name the fields to take and leave the others out")
    if is_map and r >= 0 and not drop: fatal(nodes[bindings[r]].pos, "a dictionary's rest is not implemented yet: `...` alone drops the remaining entries")
    if is_tuple:
        n = int(types[t].nargs)
        if r < 0 and n != count or r >= 0 and n < count: unpack_count_error(e, t, count, r >= 0, pos)
    exactly = if r >= 0: "at least" else: "exactly"
    elements = if count == 1: "element" else: "elements"
    if is_fixed and (r < 0 and fixed_len(t) != count or r >= 0 and fixed_len(t) < count):
        fatal(pos, "unpacking requires {exactly} {count} {elements}, found {dt(t)}")
    total = if is_tuple: int(types[t].nargs) else if is_fixed: fixed_len(t) else: -1
    input = e
    input_type = t
    if is_map:
        add_flag(input, NF_CHECKED)
        input_type = prune(check_expr(bc_call("__map_entries", [input], pos), 0))
        input = last_checked
    source = capture_value(input, input_type, statements)
    if is_array and not is_fixed:
        # (an obligation: proven from what is known of the array, or checked where allowed)
        statements.push(unpack_length_check(mk_ident_local(int(nodes[source].sym), pos), count, r < 0, pos, "unpacking requires {exactly} {count} {elements}"))
    if is_map:
        length = mk(.call, pos)
        check_intrinsic(length, int(IN.len), [bc_map_keys(source, pos)], 0)
        add_flag(length, NF_CHECKED)
        wanted = mk(.int_lit, pos)
        nodes[wanted].ival = count
        equal = mk(.binary, pos)
        nodes[equal].op = i32(int(if r >= 0: Tok.ge else: Tok.eq))
        nodes[equal].a = i32(length)
        nodes[equal].b = i32(wanted)
        message = synth_str("unpacking requires {exactly} {count} {elements}", pos)
        guard = mk(.call, pos)
        check_intrinsic(guard, int(IN.assert), [equal, message], 0)
        statement = mk(.exprstmt, pos)
        nodes[statement].a = i32(guard)
        statements.push(statement)
    loop i in 0.. and binding in bindings:
        if i == r:
            if drop: continue
            value = unpack_rest(source, t, r, after, total, nodes[binding].pos)
            if nodes[binding].a != 0:
                target = decl_binding_type(binding)
                nodes[binding].type = i32(target)
                value = coerce(value, target)
                add_flag(value, NF_CHECKED)
            values.push(value)
            continue
        value = mk(.field, nodes[binding].pos)
        if is_array: nodes[value].kind = .index
        nodes[value].a = i32(source)
        # (after the rest: counted from the end)
        back = if r >= 0 and i > r: bindings.len() - i else: 0
        if is_map:
            index = 0
            if back > 0:
                keys = mk(.call, pos)
                check_intrinsic(keys, int(IN.len), [bc_map_keys(source, pos)], 0)
                add_flag(keys, NF_CHECKED)
                index = unpack_minus(keys, back, nodes[binding].pos)
            else:
                index = mk(.int_lit, nodes[binding].pos)
                nodes[index].ival = i
            value = bc_call("__map_pair_at", [source, index], nodes[binding].pos)
        else if is_array:
            index = 0
            if back > 0 and total < 0: index = unpack_minus(unpack_length(source, pos), back, nodes[binding].pos)
            else:
                index = mk(.int_lit, nodes[binding].pos)
                nodes[index].ival = if back > 0: total - back else: i
            nodes[value].b = i32(index)
            # The length guard above dominates every element read.
            add_flag(value, NF_INBOUNDS)
        else if is_tuple:
            nodes[value].aux = -2
            nodes[value].ival = if back > 0: total - back else: i
        else:
            if nodes[binding].kind == .hole: fatal(nodes[binding].pos, "record unpacking names fields; leave unwanted fields out instead of using _")
            if nodes[binding].kind == .tuple and nodes[binding].sval == 0: fatal(nodes[binding].pos, "record unpacking needs field names at this level: unpack a field with `as`, `[field as [a b]] = record`")
            nodes[value].name = if nodes[binding].sval != 0: nodes[binding].sval else: nodes[binding].name
            unpack_field_hint(t, int(nodes[value].name), nodes[binding].pos)
        if nodes[binding].kind == .tuple:
            inner = prune(check_expr(value, 0))
            unpack_values(last_checked, inner, kids(binding), nodes[binding].pos, statements, values)
        else:
            if nodes[binding].a != 0:
                target = decl_binding_type(binding)
                nodes[binding].type = i32(target)
                check_expr(value, target)
                value = coerce(last_checked, target)
                add_flag(value, NF_CHECKED)
            values.push(value)
# `let (q r) = a.divmod(b)`: a record unpacks by field name, so a name it lacks is an error
# naming its fields and the `as` rename (Python unpacks a pair by position). O(fields).
unpack_field_hint = (t: int, name: int, pos: int):
    if types[t].kind != .struct_ or fn_name_for(t, name): return
    si = int(types[t].st)
    names: str[]
    loop i in [0..int(structs[si].nfields)):
        f = int(fields[int(structs[si].fields) + i].name)
        if f == name: return
        names.push(name_of(f))
    if names.len() == 0: return
    fatal(pos, "{dt(t)} has no field '{name_of(name)}': a record unpacks by field name, not by position, as in `[{join(names, " ")}] = ...`; `as` gives a field another name, `[{names[0]} as {name_of(name)}]`")
# `length - k`, checked: an index counted from the end.
unpack_minus = (length: int, k: int, pos: int) -> int:
    amount = mk(.int_lit, pos)
    nodes[amount].ival = k
    d = mk(.binary, pos)
    nodes[d].op = i32(int(Tok.minus))
    nodes[d].a = i32(length)
    nodes[d].b = i32(amount)
    check_expr(d, T_INT)
    last_checked
# What a rest takes, from position r with `after` names after it (total: a static count, or -1):
# an array's slice, a fixed array's elements, or the remaining values or positions of a tuple
# (several values stay several values).
unpack_rest = (source: int, t: int, r: int, after: int, total: int, pos: int) -> int:
    if types[t].kind == .array:
        first = mk(.int_lit, pos)
        nodes[first].ival = r
        last = if after > 0: unpack_minus(unpack_length(source, pos), after, pos) else: unpack_length(source, pos)
        # (a slice as written, `xs[r..xs.length-after)`: in bounds by the length obligation)
        range = mk(.range, pos)
        nodes[range].a = i32(first)
        nodes[range].b = i32(last)
        slice = mk(.index, pos)
        nodes[slice].a = i32(mk_ident_local(int(nodes[source].sym), pos))
        nodes[slice].b = i32(range)
        check_expr(slice, 0)
        return last_checked
    parts: int[]
    ts: int[]
    loop i in [r..total - after):
        v = mk(.field, pos)
        nodes[v].a = i32(mk_ident_local(int(nodes[source].sym), pos))
        if types[t].kind == .fixed:
            nodes[v].kind = .index
            index = mk(.int_lit, pos)
            nodes[index].ival = i
            nodes[v].b = i32(index)
            add_flag(v, NF_INBOUNDS)
        else:
            nodes[v].aux = -2
            nodes[v].ival = i
        check_expr(v, 0)
        parts.push(last_checked)
        ts.push(ntype(last_checked))
    n = mk(.tuple, pos)
    set_list(n, parts)
    if types[t].kind == .fixed:
        nodes[n].kind = .array
        check_expr(n, mk_array(int(types[t].elem)))
        return last_checked
    nodes[n].type = i32(mk_tuple(ts, types[t].sign))
    add_flag(n, NF_CHECKED)
    n
unpack_array = (e: int, t: int, n: int, pos: int) -> int:
    if types[t].kind != .array or n < 2 or n > 4: return t
    add_flag(e, NF_CHECKED)
    c = int(nodes[synth_call("__unpack{n}", [e], pos)].a)
    r = prune(check_expr(c, 0))
    last_checked = c
    r
# The elements of container c (k of them), spread: a fixed array or a `[T U]` read at each
# position; an array of unknown length is first proven (or checked) to have exactly k.
# The written type of parameter i that every function in decls taking nargs positional
# arguments has (none of them generic there, mutable or keyword-only), or 0
# Context for call arguments after mapping names/defaults. Only the receiver and
# explicit type arguments bind generics here; other arguments still select overloads.
# Demand-driven by an unchecked call argument. Positional mapping is O(C * P);
# named mapping uses map_args (O(C * A * P)), with indexed argument-to-slot lookup.
# Discover the same method/module family that check_call will use, only when an
# argument call needs context before the multi-value check. No argument is tried
# against a speculative overload.
# A Dewy call some of whose arguments give several values (or spread a container): checked
# with its arguments expanded, as `{ held...; f(values...) }`. -1: nothing to expand.
# `(a b)`: several values, of type `(T U)`, its items expanded as call arguments are.
# A length obligation on array src: exactly k elements (or at least k). Proven from facts, it
# costs nothing; unproven, it is a compile error, or a runtime check where the scope allows
# one, as any obligation (no_traps.md).
unpack_length_check = (src: int, k: int, exact: bool, pos: int, message: str) -> int:
    length = mk(.call, pos)
    check_intrinsic(length, int(IN.len), [src], 0)
    add_flag(length, NF_CHECKED)
    count = mk(.int_lit, pos)
    nodes[count].ival = k
    cmp = mk(.binary, pos)
    nodes[cmp].op = i32(int(if exact: Tok.eq else: Tok.ge))
    nodes[cmp].a = i32(length)
    nodes[cmp].b = i32(count)
    guard = mk(.call, pos)
    nodes[guard].aux2 = i32(UNPACK_OBLIGATION)
    check_intrinsic(guard, int(IN.assert), [cmp, synth_str(message, pos)], 0)
    # (a runtime check until the facts prove it, as an index's: a body decided in another
    # process keeps it)
    fact_requests.push(FactRequest(guard, if cx >= 0: int(ctxs[cx].inst) else: 0))
    statement = mk(.exprstmt, pos)
    nodes[statement].a = i32(guard)
    add_flag(statement, NF_CHECKED)
    statement

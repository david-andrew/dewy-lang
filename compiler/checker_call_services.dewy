                check_expr_in_module(callee mod_scope);
            }
            else {check_expr(callee 0);}
            return value_call(n callee args expected)
        }
    }
    else if sk =? 'struct_' {return struct_ctor(n 0 CDWord(syms.ptr[s].ref) args expected)}
    else if sk =? 'enum_' {
        let ed:CDWord=CDWord(syms.ptr[s].ref)
        if nkids2(ed) =? 0 and args.length =? 1 and nodes.ptr[args.ptr[0]].kind not=? 'namedarg' {
            let et=get_struct_inst(ed [])
            if simple_enum(et) {return enum_from_int(n et args.ptr[0])}
        }
        call_dispatch_error(8 n name 0 0 0 0 0 0)
    }
    else if sk =? 'alias_' and not dewy_at(nodes.ptr[n].pos) and nkids2(CDWord(syms.ptr[s].ref)) =? 0 and args.length =? 1 and nodes.ptr[args.ptr[0]].kind not=? 'namedarg' and str_set_of(resolve_alias(CDWord(syms.ptr[s].ref) [] nodes.ptr[n].pos)) not=? 0 {
        return enum_from_int(n prune(resolve_alias(CDWord(syms.ptr[s].ref) [] nodes.ptr[n].pos)) args.ptr[0])
    }
    else if sk =? 'type_' {
        jo_type_spelling(name s nodes.ptr[n].pos)
        return conversion(n CDWord(syms.ptr[s].ref) args)
    }
    else if sk =? 'fns' and args.length =? 1 and nodes.ptr[args.ptr[0]].kind not=? 'namedarg' and universe.get(name) not=? none {
        let at:CDWord=prune(check_expr(args.ptr[0] 0))
        add_flag(args.ptr[0] NF_CHECKED)
        let fd:array<int64>=[]
        call_collect_fns(name @fd)
        let takes=false
        loop d in fd {
            let sig=fn_sig(d)
            if sig.params.length >=? 1 and (sig.generic or can_coerce(args.ptr[0] at sig.params.ptr[0])) {takes=true}
        }
        if not takes {return conversion(n CDWord(syms.ptr[universe[name]].ref) args)}
    }
    else if sk =? 'fns' and args.length =? 2 and name =? take_name and (prelude.get(name) ?? 0) =? s and pos_in_lib(nodes.ptr[n].pos) {return take_call(n args)}
    else if sk =? 'fns' and args.length =? 3 and name =? relocate_name and (prelude.get(name) ?? 0) =? s and pos_in_lib(nodes.ptr[n].pos) {return relocate_call(n args)}
    else if sk =? 'fns' and args.length =? 2 and name =? release_name and (prelude.get(name) ?? 0) =? s and pos_in_lib(nodes.ptr[n].pos) {return release_call(n args expected)}
    else if sk =? 'const_' or sk =? 'module' {call_dispatch_error(9 n name 0 0 0 0 0 0)}
    else if sk =? 'builtin' and not hidden_assert {
        call_collect_fns(name @decls)
        if decls.length =? 0 {
            if ide_on {ide_builtin_ref(n name)}
            return check_intrinsic(n CDWord(syms.ptr[s].ref) args expected)
        }
    }
    -1
}
call_name_collect=(n:CDWord name:CDWord mod_scope:CDWord args:array<int64> expected:CDWord ufcs:bool @decls:array<int64>):>CDWord=>$unsafe {
    surface_hidden.clear()
    if ufcs {
        if mod_scope >=? 0 {call_collect_module(mod_scope name @decls)}
        else {call_collect_fns(name @decls)}
    }
    else {call_collect_named(name mod_scope @decls)}
    if name =? ci(7 "to_int") and mod_scope <? 0 and files.ptr[pos_file(nodes.ptr[n].pos)].is_dewy {
        let own=false
        loop d in decls {
            if not decl_in_prelude(d) {own=true}
        }
        if not own {
            let parser=ci(8 "__mi_parse")
            if args.length >? 1 {parser=intern("__mi_parse_limited")}
            if args.length =? 2 and to_int_word_limit(args.ptr[1]) {parser=intern("__mi_parse_word")}
            demand_name(parser)
            decls=[]
            call_collect_fns(parser @decls)
            return resolve_fn_call(n parser decls args expected)
        }
    }
    let indexed=name =? ci(9 "[]") or name =? ci(10 "[]=")
    if (ufcs or indexed) and args.length >? 0 {
        if indexed and not has_flag(args.ptr[0] NF_CHECKED) {
            check_expr(args.ptr[0] 0);
            add_flag(args.ptr[0] NF_CHECKED)
        }
        let tms=method_modules(ntype(args.ptr[0]))
        loop tm in tms {call_collect_module(tm name @decls)}
        let tm=if tms.length >? 0 {tms[0]} else {-1}
        if indexed {
            let protocol_text=if name =? ci(11 "[]") {"__index__"} else {"__setindex__"}
            let protocol=intern(protocol_text)
            if mod_scope >=? 0 {call_collect_module(mod_scope protocol @decls)}
            else {call_collect_fns(protocol @decls)}
            if tm >=? 0 {call_collect_module(tm protocol @decls)}
        }
    }
    if surface_hidden.length >? 0 {dewy_surface_check(n name)}
    -1
}

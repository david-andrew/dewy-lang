$runtime_checks

from p"@lib/core/rt.jo" import (__str_slice __str_from_bytes)
from p"dewy_context.jo" import dc_parser
from p"dewy_fmt.jo" import (df_lexemes df_blocks)
from p"dewy_frontend.dewy" import dn_lex
from p"dewy_fast.jo" import (dn_block_comments)
from p"dewy_tokens.dewy" import DewyLexeme
from p"dewy_syntax.dewy" import dw_kind_name
from p"dewy_layout.dewy" import (dewy_layout dl_free_gap)
from p"util.jo" import (files)

FormatterFrontendWord:type=int64<overflow='wrap'>
# The formatter keeps token/comment snapshots after restoring the parser's
# current file. Source cuts are byte spans and preserve arbitrary bytes.
df_tokens=(file:int64 src:string):>array<string>=>{
    let saved=dc_parser.file
    dc_parser.file=file
    dc_parser.source=files[dc_parser.file].src
    df_lexemes=dn_lex(file 0 (src as array<uint8>).length false)
    df_blocks=dn_block_comments
    dc_parser.file=saved
    dc_parser.source=files[dc_parser.file].src
    let out:array<string>=[]
    loop i in 0.. and t in df_lexemes {
        if t.kind =? 'eof' {break}
        let sig="{dw_kind_name(t.kind)}:{__str_slice(src t.start t.stop)}"
        if i >? 0 {
            sig="{sig} n{t.newline}"
            if not dl_free_gap(df_lexemes[FormatterFrontendWord(i) - 1].symbol t.symbol) {sig="{sig} s{t.space}"}
        }
        out.push(sig)
    }
    out
}
df_text=(src:string):>string | none=>{
    let laid=dewy_layout(src df_lexemes df_blocks)
    if laid isnt? none {return __str_from_bytes(laid)}
    none
}

$runtime_checks

from p"ir_types.dewy" import (Ins IrFn IrUsePlan)
from p"ir_operands.dewy" import (IR_DEF IR_ARGS IR_INDEX IR_STORE IR_INDIRECT IR_RETURN IR_CALL IR_NARROW32 IR_OVERFLOW IR_LOC_DEF IR_BA_CTRL IR_CHECKED)

# Shared native analysis workspace. One sequential function at a time, as before.
# Consumers borrow these views until the next analysis; no IR stores a view.
# Locations: >=0 is an allocated register; negative values classify payloads.
const LOC_SPILL = -1
const LOC_CONST = -2
const LOC_SLOT = -3
const LOC_NONE = -4
const LOC_GLOBAL = -5
const LOC_FCONST = -6
let vgkind_storage:array<int64>=[]
let vgkind:ptr<int64>=$unsafe (uint64(0) as ptr<int64>)
let vgoff_storage:array<int64>=[]
let vgoff:ptr<int64>=$unsafe (uint64(0) as ptr<int64>)
let vloc_storage:array<int64>=[]
let vloc:ptr<int64>=$unsafe (uint64(0) as ptr<int64>)
let vcval_storage:array<int64>=[]
let vcval:ptr<int64>=$unsafe (uint64(0) as ptr<int64>)
let vslot_storage:array<int64>=[]
let vslot:ptr<int64>=$unsafe (uint64(0) as ptr<int64>)
let vsoff_storage:array<int64>=[]
let vsoff:ptr<int64>=$unsafe (uint64(0) as ptr<int64>)
let vsave_storage:array<bool>=[]
let vsave:ptr<bool>=$unsafe (uint64(0) as ptr<bool>)
let dbg_keep:array<bool>=[]
# Jo selects checker bindings only in debug mode, without sharing its arena.
let backend_debug_vregs:array<int64>=[]
let v_live_storage:array<IrUsePlan>=[]
let v_live:ptr<IrUsePlan>=$unsafe (uint64(0) as ptr<IrUsePlan>)
let v_start_storage:array<int64>=[]
let v_start:ptr<int64>=$unsafe (uint64(0) as ptr<int64>)
let call_pos:array<int64>=[]
let call_w:array<int64>=[]
let loop_s:array<int64>=[]
let loop_e:array<int64>=[]
let ba_kinds:array<bool>=[]
let ba_starts:array<int64>=[]
let ba_bk_p:ptr<bool>=$unsafe (uint64(0) as ptr<bool>)
let ba_bs_p:ptr<int64>=$unsafe (uint64(0) as ptr<int64>)
let ba_bcap:int64=0
let ra_loop_visits:int64=0
# Native copies/clears at or below this size are emitted inline.
const INLINE_COPY = 256
let x_has_foreign_call:bool=false
let x_has_narrow32:bool=false
let x_has_overflow_pair:bool=false
let x_has_slot:bool=false
let x_has_any_call:bool=false
let ba_tail_dsts:array<int64>=[]

BackendWord:type=int64<overflow='wrap'>
BackendI32:type=int32<overflow='wrap'>

backend_call_like=(ins:ptr<Ins> dbg_on:bool target_wasm:bool):>bool=>$unsafe {
    let op=ins[0].op
    if op =? 'intr' and ins[0].imm >=? 2 {return true}
    if op =? 'call' and ins[0].c =? 1 and not dbg_on {return false}
    # IR call-stub ABI: CALL_IF_SHARED..CALL_RC_DEC = 3..5.
    if op =? 'call' and ins[0].c >=? 3 and ins[0].c <=? 5 and not target_wasm {return false}
    if op =? 'call' or op =? 'calli' or op =? 'callc' or op =? 'syscall' or op =? 'memcpy' or op =? 'memset' or op =? 'findb' or op =? 'scanbytes' {return true}
    if op =? 'copy' or op =? 'zero' {return ins[0].imm >? INLINE_COPY}
    false
}

backend_call_ends_here_views=(instructions:ptr<Ins> arguments:ptr<int32> types:ptr<int8> nc:int64 pos:int64 ins:ptr<Ins> dbg_on:bool):>bool=>$unsafe {
    if dbg_on or ins[0].dst <? 0 or BackendWord(pos) + 1 >=? nc {return false}
    if ins[0].op not=? 'call' and ins[0].op not=? 'calli' and ins[0].op not=? 'callc' {return false}
    let next=ins + 1
    if next[0].op not=? 'call' or next[0].c not=? 1 {return false}
    let a=BackendWord(int64(next[0].a))
    let nb=int64(next[0].b)
    let dst=int64(ins[0].dst)
    loop k in [0..nb) {
        let v=int64(arguments[a + BackendWord(k)])
        if v not=? dst and int64(types[v]) not=? 3 {return false}
    }
    true
}

backend_call_ends_here=(@ir:IrFn pos:int64 ins:ptr<Ins> dbg_on:bool):>bool=>$unsafe {
    backend_call_ends_here_views(ir.code.ptr ir.args.ptr ir.vtypes.ptr ir.code.length pos ins dbg_on)
}

ba_grow_i64=(@a:array<int64> nv:int64):>ptr<int64>=>$unsafe {
    if a.length <? nv {
        if cap(a) <? nv {a.reserve(nv)}
        __set_len(a nv)
    }
    a.ptr
}
ba_grow=(nv:int64):>void=>$unsafe {
    if v_live_storage.length <? nv {
        if cap(v_live_storage) <? nv {v_live_storage.reserve(nv)}
        __set_len(v_live_storage nv)
    }
    if vsave_storage.length <? nv {
        if cap(vsave_storage) <? nv {vsave_storage.reserve(nv)}
        __set_len(vsave_storage nv)
    }
    v_live=v_live_storage.ptr
    vloc=ba_grow_i64(@vloc_storage nv)
    vcval=ba_grow_i64(@vcval_storage nv)
    vslot=ba_grow_i64(@vslot_storage nv)
    vsoff=ba_grow_i64(@vsoff_storage nv)
    vgkind=ba_grow_i64(@vgkind_storage nv)
    vgoff=ba_grow_i64(@vgoff_storage nv)
    vsave=vsave_storage.ptr
}

# Complete final-IR analysis. The input arenas do not grow during this call.
# O(N + U + V log L + visited loop summaries), retaining the existing loop
# interval extension. Allocation-start indexing is built only on request.
backend_analyze=(@ir:IrFn @ir_operand_layout:array<int64> dbg_on:bool target_wasm:bool ra_stat:bool plan_starts:bool=false):>void=>$unsafe {
    x_has_foreign_call=false
    x_has_narrow32=false
    x_has_overflow_pair=false
    x_has_slot=false
    x_has_any_call=false
    if ba_tail_dsts.length >? 0 {ba_tail_dsts.clear()}
    let nv=ir.vtypes.length
    let nc=ir.code.length
    let np=ir.nparams
    let nk=ir.kval.length
    let types=ir.vtypes.ptr
    let constants=ir.kval.ptr
    if v_live_storage.length <? nv {ba_grow(nv)}
    let vl=v_live
    let loc_arr=vloc
    let cval_arr=vcval
    let slot_arr=vslot
    let soff_arr=vsoff
    let gkind_arr=vgkind
    let goff_arr=vgoff
    let save_arr=vsave
    if nv >? 0 {
        mem_set(vl as ptr<uint8> 0 nv * size_of<IrUsePlan>)
        mem_set(loc_arr as ptr<uint8> 255 nv * 8)
        mem_set(save_arr as ptr<uint8> 0 nv)
    }
    if call_pos.length >? 0 {call_pos.clear()}
    if call_w.length >? 0 {call_w.clear()}
    if loop_s.length >? 0 {loop_s.clear()}
    if loop_e.length >? 0 {loop_e.clear()}
    if ba_bcap <? 64 {
        ba_kinds.resize(64)
        ba_starts.resize(64)
        ba_bk_p=ba_kinds.ptr
        ba_bs_p=ba_starts.ptr
        ba_bcap=ba_kinds.length
    }
    let bk=ba_bk_p
    let bs=ba_bs_p
    let bcap:BackendWord=ba_bcap
    let bsp:BackendWord=0
    loop p in [0..np) {
        vl[p].first=0
        vl[p].last=0
        vl[p].ndef=1
    }
    loop v in [0..nk) {
        if int64(types[v]) =? 3 {
            vl[v].ndef=1
            vl[v].last=-1
            loc_arr[v]=LOC_CONST
            cval_arr[v]=constants[v]
        }
    }
    let depth:BackendWord=0
    let cold_depth:BackendWord=0
    let cond_depth:BackendWord=0
    let w:BackendWord=1
    let instructions=ir.code.ptr
    let arguments=ir.args.ptr
    let layouts=ir_operand_layout.ptr
    let features:int64=0
    let has_slots=ir.slot_size.length >? 0
    let ins=instructions
    loop pos in [0..nc) {
        let pos32=BackendI32(pos)
        # Op's ABI tag is its first uint32, in ir_types declaration order.
        let mode=layouts[int64((ins as ptr<uint32>)[0])]
        features=features or mode
        # Ins.a/b/c are contiguous int32 fields after op/ty/dst.
        let uses=(ins as ptr<int32>) + 3
        let nuses=mode & 3
        if mode & (IR_ARGS | IR_STORE | IR_INDEX | IR_RETURN) not=? 0 {
            let extra:int64=-1
            if mode & IR_ARGS not=? 0 {
                uses=arguments + int64(ins[0].a)
                nuses=int64(ins[0].b)
                if mode & IR_INDIRECT not=? 0 {extra=int64(ins[0].c)}
            } else if mode & IR_STORE not=? 0 {
                if mode & IR_INDEX =? 0 or int64(ins[0].c) & 128 not=? 0 {extra=int64(ins[0].dst)}
            } else if mode & IR_INDEX not=? 0 {
                if int64(ins[0].c) & 128 not=? 0 {nuses=2}
            } else if ins[0].a <? 0 {nuses=0}
            if extra >=? 0 {
                let live=vl + extra
                if (live as ptr<int64>)[1] =? 0 {live[0].first=pos32}
                live[0].last=pos32
                live[0].nuse=BackendI32(live[0].nuse) + BackendI32(1)
                live[0].weight=BackendWord(live[0].weight) + w
            }
        }
        if nuses =? 1 {
            let live=vl + int64(uses[0])
            if (live as ptr<int64>)[1] =? 0 {live[0].first=pos32}
            live[0].last=pos32
            live[0].nuse=BackendI32(live[0].nuse) + BackendI32(1)
            live[0].weight=BackendWord(live[0].weight) + w
        } else if nuses =? 2 {
            let l0=vl + int64(uses[0])
            if (l0 as ptr<int64>)[1] =? 0 {l0[0].first=pos32}
            l0[0].last=pos32
            l0[0].nuse=BackendI32(l0[0].nuse) + BackendI32(1)
            l0[0].weight=BackendWord(l0[0].weight) + w
            let l1=vl + int64(uses[1])
            if (l1 as ptr<int64>)[1] =? 0 {l1[0].first=pos32}
            l1[0].last=pos32
            l1[0].nuse=BackendI32(l1[0].nuse) + BackendI32(1)
            l1[0].weight=BackendWord(l1[0].weight) + w
        } else if nuses >? 2 {
            loop operand_index in [0..nuses) {
                let live=vl + int64(uses[operand_index])
                if (live as ptr<int64>)[1] =? 0 {live[0].first=pos32}
                live[0].last=pos32
                live[0].nuse=BackendI32(live[0].nuse) + BackendI32(1)
                live[0].weight=BackendWord(live[0].weight) + w
            }
        }
        if mode & IR_DEF not=? 0 {
            let d=int64(ins[0].dst)
            if d >=? 0 {
                let live=vl + d
                if (live as ptr<int64>)[1] =? 0 {live[0].first=pos32}
                live[0].last=pos32
                let nd=BackendI32(live[0].ndef) + BackendI32(1)
                live[0].ndef=nd
                live[0].weight=BackendWord(live[0].weight) + w
                if nd =? 1 and mode & IR_LOC_DEF not=? 0 {
                    let op=ins[0].op
                    if op =? 'add' {
                        if x_has_slot {
                            let a=int64(ins[0].a)
                            if loc_arr[a] =? LOC_SLOT {
                                let b=int64(ins[0].b)
                                if loc_arr[b] =? LOC_CONST and vl[a].ndef =? 1 and vl[b].ndef =? 1 {
                                    loc_arr[d]=LOC_SLOT
                                    slot_arr[d]=slot_arr[a]
                                    soff_arr[d]=BackendWord(soff_arr[a]) + BackendWord(cval_arr[b])
                                }
                            }
                        }
                    } else if op =? 'slot' {
                        x_has_slot=true
                        loc_arr[d]=LOC_SLOT
                        slot_arr[d]=int64(ins[0].a)
                        soff_arr[d]=0
                    } else if op =? 'gaddr' or op =? 'daddr' {
                        loc_arr[d]=LOC_GLOBAL
                        goff_arr[d]=ins[0].imm
                        gkind_arr[d]=if op =? 'gaddr' {1} else {0}
                    } else if op =? 'iconst' {
                        if ins[0].imm >=? -2147483648 and ins[0].imm <=? 2147483647 {
                            loc_arr[d]=LOC_CONST
                            cval_arr[d]=ins[0].imm
                        }
                    } else if op =? 'fconst' {
                        loc_arr[d]=LOC_FCONST
                        cval_arr[d]=ins[0].imm
                    }
                }
            }
        }
        if mode & (IR_CALL | IR_BA_CTRL) not=? 0 {
            if mode & IR_CALL not=? 0 {
                let op=ins[0].op
                let is_call=false
                let real_call=false
                if op =? 'call' {
                    let cc=ins[0].c
                    is_call=not (cc =? 1 and not dbg_on) and not (cc >=? 3 and cc <=? 5 and not target_wasm)
                    real_call=true
                    if not is_call {x_has_any_call=true}
                } else if op =? 'copy' or op =? 'zero' {
                    is_call=ins[0].imm >? INLINE_COPY
                } else if op =? 'intr' {
                    is_call=ins[0].imm >=? 2
                    real_call=is_call
                } else {
                    is_call=true
                    real_call=(op =? 'calli' or op =? 'callc' or op =? 'syscall')
                    if op =? 'callc' {x_has_foreign_call=true}
                }
                if is_call {
                    let ends=false
                    if not dbg_on and BackendWord(pos) + 1 <? nc and (op =? 'call' or op =? 'calli' or (op =? 'callc' and ins[0].imm >=? 0)) {
                        let nxt=ins + 1
                        let ep=BackendWord(pos) + 1
                        loop ep <? nc and (instructions[ep].op =? 'end' or instructions[ep].op =? 'nop') {ep+=1}
                        if plan_starts and ep <? nc and instructions[ep].op =? 'ret' {
                            let ra=int64(instructions[ep].a)
                            if ra <? 0 or (ins[0].dst >=? 0 and ra =? int64(ins[0].dst)) or int64(types[ra]) =? 3 {
                                ends=true
                            }
                        } else if plan_starts and ep <? nc and instructions[ep].op =? 'trap' {
                            ends=true
                        } else if ins[0].dst >=? 0 and nxt[0].op =? 'call' and nxt[0].c =? 1 {
                            ends=true
                            let na=BackendWord(int64(nxt[0].a))
                            let nb=int64(nxt[0].b)
                            let dst0=int64(ins[0].dst)
                            loop k in [0..nb) {
                                let v=int64(arguments[na + BackendWord(k)])
                                if v not=? dst0 and int64(types[v]) not=? 3 {ends=false; break}
                            }
                        }
                    }
                    if real_call {x_has_any_call=true}
                    if not ends {
                        call_pos.push(pos)
                        if op =? 'call' and ins[0].c =? 2 {call_w.push(1)}
                        else {call_w.push(w)}
                    }
                }
            }
            if mode & IR_BA_CTRL not=? 0 {
                let op=ins[0].op
                if op =? 'block' or op =? 'loop' or op =? 'if_' {
                    if bsp >=? bcap {
                        bcap=bcap * 2
                        ba_kinds.resize(bcap)
                        ba_starts.resize(bcap)
                        ba_bk_p=ba_kinds.ptr
                        ba_bs_p=ba_starts.ptr
                        ba_bcap=bcap
                        bk=ba_bk_p
                        bs=ba_bs_p
                    }
                    let is_lp=op =? 'loop'
                    bk[bsp]=is_lp
                    if is_lp {
                        bs[bsp]=loop_s.length
                        loop_s.push(pos)
                        loop_e.push(0)
                        depth+=1
                        if ins[0].imm not=? 0 {cold_depth+=1}
                        let base_w=if cold_depth >? 0 {1} else {BackendWord(1) << (BackendWord(3) * min(depth BackendWord(6)))}
                        let sh=min(cond_depth BackendWord(2))
                        w=if base_w >> sh >? 1 {base_w >> sh} else {1}
                    } else if op =? 'if_' and depth >? 0 {
                        bs[bsp]=-2
                        cond_depth+=1
                        let base_w=if cold_depth >? 0 {1} else {BackendWord(1) << (BackendWord(3) * min(depth BackendWord(6)))}
                        let sh=min(cond_depth BackendWord(2))
                        w=if base_w >> sh >? 1 {base_w >> sh} else {1}
                    } else {bs[bsp]=-1}
                    bsp+=1
                } else if op =? 'end' {
                    bsp-=1
                    if bk[bsp] {
                        let s=bs[bsp]
                        depth-=1
                        if instructions[loop_s.ptr[s]].imm not=? 0 {cold_depth-=1}
                        let base_w=if cold_depth >? 0 {1} else {BackendWord(1) << (BackendWord(3) * min(depth BackendWord(6)))}
                        let sh=min(cond_depth BackendWord(2))
                        w=if base_w >> sh >? 1 {base_w >> sh} else {1}
                        loop_e.ptr[s]=pos
                    } else if bs[bsp] =? -2 {
                        cond_depth-=1
                        let base_w=if cold_depth >? 0 {1} else {BackendWord(1) << (BackendWord(3) * min(depth BackendWord(6)))}
                        let sh=min(cond_depth BackendWord(2))
                        w=if base_w >> sh >? 1 {base_w >> sh} else {1}
                    }
                } else if (op =? 'brif' and ins[0].imm =? 0) or op =? 'brtable' {
                    if depth >? 0 and bsp >? 0 and bs[bsp - 1] =? -1 {
                        bs[bsp - 1]=-2
                        cond_depth+=1
                        let base_w=if cold_depth >? 0 {1} else {BackendWord(1) << (BackendWord(3) * min(depth BackendWord(6)))}
                        let sh=min(cond_depth BackendWord(2))
                        w=if base_w >> sh >? 1 {base_w >> sh} else {1}
                    }
                } else if op =? 'callc' {
                    x_has_foreign_call=true
                } else if op =? 'zeroslots' {
                    x_has_slot=true
                    loop k in [0..int64(ins[0].b)) {
                        let item=int64(arguments[BackendWord(int64(ins[0].a)) + BackendWord(k)])
                        if item & 1 =? 1 {
                            let v=item >> 1
                            let live=vl + v
                            if (live as ptr<int64>)[1] =? 0 {live[0].first=pos32}
                            live[0].last=pos32
                            live[0].ndef=BackendI32(live[0].ndef) + BackendI32(2)
                        }
                    }
                }
            }
        }
        ins=ins + 1
    }
    x_has_narrow32=features & IR_NARROW32 not=? 0
    x_has_overflow_pair=features & IR_OVERFLOW not=? 0
    if features & IR_CHECKED not=? 0 {x_has_any_call=true}
    else if not x_has_any_call and ba_tail_dsts.length >? 0 {
        loop di in [0..ba_tail_dsts.length) {
            if vl[ba_tail_dsts.ptr[di]].nuse not=? 1 {x_has_any_call=true; break}
        }
    }
    if dbg_on {
        dbg_keep=[]
        dbg_keep.resize(nv)
        loop v in backend_debug_vregs {
            if v <? 0 or v >=? nv or (int64(vl[v].nuse) | int64(vl[v].ndef)) =? 0 or vl[v].last <? 0 {continue}
            dbg_keep[v]=true
            vl[v].last=BackendI32(nc)
            vl[v].nuse=BackendI32(vl[v].nuse) + BackendI32(1)
        }
    }
    let starts=v_start
    if plan_starts {
        let n=BackendWord(nc) + 1
        if v_start_storage.length <? n {
            if cap(v_start_storage) <? n {v_start_storage.reserve(n)}
            __set_len(v_start_storage n)
        }
        starts=v_start_storage.ptr
        v_start=starts
        mem_set(starts as ptr<uint8> 255 n * 8)
    }
    let nl=loop_s.length
    if nl =? 0 {
        if plan_starts {
            loop v in [np..nv) {
                let live=vl + v
                if (live as ptr<int64>)[1] =? 0 {
                    live[0].last=-1
                    loc_arr[v]=LOC_NONE
                    continue
                }
                let loc=loc_arr[v]
                if live[0].ndef not=? 1 {
                    loc=LOC_SPILL
                    loc_arr[v]=loc
                }
                if loc =? LOC_SPILL {
                    if live[0].last <? 0 or live[0].nuse =? 0 {loc_arr[v]=LOC_NONE}
                    else {
                        let f=int64(live[0].first)
                        live[0].next_start=BackendI32(starts[f])
                        starts[f]=v
                    }
                }
            }
            let pk=np - 1
            loop pk >=? 0 {
                let live=vl + pk
                if (live as ptr<int64>)[1] =? 0 {
                    live[0].last=-1
                    loc_arr[pk]=LOC_NONE
                } else {
                    let loc=loc_arr[pk]
                    if live[0].ndef not=? 1 {
                        loc=LOC_SPILL
                        loc_arr[pk]=loc
                    }
                    if loc =? LOC_SPILL {
                        if live[0].last <? 0 {loc_arr[pk]=LOC_NONE}
                        else {
                            live[0].next_start=BackendI32(starts[0])
                            starts[0]=pk
                        }
                    }
                }
                pk-=1
            }
        } else {
            loop v in [0..nv) {
                if ((vl + v) as ptr<int64>)[1] =? 0 {vl[v].last=-1}
                if vl[v].ndef not=? 1 {loc_arr[v]=LOC_SPILL}
            }
        }
        return
    }
    let loop_starts=loop_s.ptr
    let loop_ends=loop_e.ptr
    let lfirst=loop_starts[0]
    let llast=loop_starts[nl - 1]
    if plan_starts {
        loop v in [np..nv) {
            let live=vl + v
            if (live as ptr<int64>)[1] =? 0 {
                live[0].last=-1
                loc_arr[v]=LOC_NONE
                continue
            }
            let loc=loc_arr[v]
            if live[0].ndef not=? 1 {
                loc=LOC_SPILL
                loc_arr[v]=loc
            }
            if loc not=? LOC_SPILL {continue}
            let vlast=int64(live[0].last)
            if vlast <? 0 or live[0].nuse =? 0 {
                loc_arr[v]=LOC_NONE
                continue
            }
            let vf=int64(live[0].first)
            live[0].next_start=BackendI32(starts[vf])
            starts[vf]=v
            if vlast >=? lfirst {
                if vf <? llast {
                    let lo:BackendWord=0
                    if nl >? 1 {
                        let hi:BackendWord=BackendWord(nl)
                        loop lo <? hi {
                            let mid=(lo + hi) >> 1
                            if loop_starts[mid] <=? vf {lo=mid + 1} else {hi=mid}
                        }
                    }
                    let i=lo
                    loop i <? nl and loop_starts[i] <=? vlast {
                        if ra_stat {ra_loop_visits=BackendWord(ra_loop_visits) + 1}
                        if loop_ends[i] >? vlast {vlast=loop_ends[i]}
                        i+=1
                    }
                    live[0].last=BackendI32(vlast)
                }
            }
        }
        let pk=np - 1
        loop pk >=? 0 {
            let live=vl + pk
            if (live as ptr<int64>)[1] =? 0 {
                live[0].last=-1
                loc_arr[pk]=LOC_NONE
            } else {
                let loc=loc_arr[pk]
                if live[0].ndef not=? 1 {
                    loc=LOC_SPILL
                    loc_arr[pk]=loc
                }
                if loc =? LOC_SPILL {
                    let vlast=int64(live[0].last)
                    if vlast <? 0 {
                        loc_arr[pk]=LOC_NONE
                    } else {
                        live[0].next_start=BackendI32(starts[0])
                        starts[0]=pk
                        if vlast >=? lfirst {
                            let i:BackendWord=0
                            loop i <? nl and loop_starts[i] <=? vlast {
                                if ra_stat {ra_loop_visits=BackendWord(ra_loop_visits) + 1}
                                if loop_ends[i] >? vlast {vlast=loop_ends[i]}
                                i+=1
                            }
                            live[0].last=BackendI32(vlast)
                        }
                    }
                }
            }
            pk-=1
        }
        return
    }
    loop v in [0..nv) {
        let live=vl + v
        if (live as ptr<int64>)[1] =? 0 {
            live[0].last=-1
            loc_arr[v]=LOC_SPILL
            continue
        }
        if live[0].ndef not=? 1 {loc_arr[v]=LOC_SPILL}
        let vlast=int64(live[0].last)
        if vlast >=? lfirst {
            let f=if v <? np {-1} else {int64(live[0].first)}
            if f <? llast {
                let lo:BackendWord=0
                if nl >? 1 {
                    let hi:BackendWord=BackendWord(nl)
                    loop lo <? hi {
                        let mid=(lo + hi) >> 1
                        if loop_starts[mid] <=? f {lo=mid + 1} else {hi=mid}
                    }
                }
                let i=lo
                loop i <? nl and loop_starts[i] <=? vlast {
                    if ra_stat {ra_loop_visits=BackendWord(ra_loop_visits) + 1}
                    if loop_ends[i] >? vlast {vlast=loop_ends[i]}
                    i+=1
                }
                live[0].last=BackendI32(vlast)
            }
        }
    }
}

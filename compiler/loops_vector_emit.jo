use 'ir_types.dewy'
use 'ir.jo'
use 'ir_builders.dewy'
use 'loops.jo'
use 'loop_ordered.dewy'
use 'opt.jo'
use 'loops_emit.dewy'
use 'check.jo'
use 'util.jo'
use 'lower_primitives.dewy'
use 'diagnostic_exit.dewy'

lx_splat = (pre: mut Ins[], vmap: mut {int: int}, u: int, k: int, ty: int) -> int:
    if let v = vmap.get(u): return v
    src = u
    if is_kv(u):
        src = vreg(VI)
        pre.push(Ins(.iconst, VI, i32(src), 0, 0, 0, kv_of(u)))
    v = vreg(ty)
    pre.push(Ins(.vsplat, i32(ty), i32(v), i32(src), 0, 0, k))
    vmap[u] = v
    v

# the vector loop of width ty (VY or VX) over the body of L; in a block that it leaves when
# fewer than a vector's worth of elements remain
lx_vec_emit = (code: Ins[], L: CLoop, checks: LCheck[], plan: VPlan, out: mut Ins[]):
    out.push(Ins(.block, 0, 0, 0, 0, 0, 0))
    # arrays at different bases that are written: the ranges the loop touches must not overlap
    es = k_vreg(plan.es)
    bases = plan.bases
    loop i in [0..bases.len()):
        ix = plan.indexes[i]
        if ix == L.ctr: continue
        reused = false
        loop j in [0..i):
            if plan.bases[i] == plan.bases[j] and ix == plan.indexes[j]:
                bases[i] = bases[j]
                reused = true
                break
        if reused: continue
        loop ch in checks:
            if (ch.kind == 3 or ch.kind == 6) and ch.x == ix:
                offset = lx_sum(code, L, ch.terms, ch.k, out)
                bases[i] = lx_bin(out, .add, plan.bases[i], lx_bin(out, .mul, offset, es))
                break
    loop i in 0.. and bi in bases:
        loop j in 0.. and bj in bases:
            if j <= i or bi == bj or not (plan.stores[i] or plan.stores[j]): continue
            ai = lx_bin(out, .add, bi, k_vreg(plan.offs[i]))
            aj = lx_bin(out, .add, bj, k_vreg(plan.offs[j]))
            lo = lx_bin(out, .mul, L.ctr, es)
            hi = lx_bin(out, .mul, L.endv, es)
            lo_i = lx_bin(out, .add, ai, lo)
            hi_i = lx_bin(out, .add, ai, hi)
            lo_j = lx_bin(out, .add, aj, lo)
            hi_j = lx_bin(out, .add, aj, hi)
            lx_fail(out, lx_bin(out, .and_, lx_bin(out, .ltu, lo_i, hi_j), lx_bin(out, .ltu, lo_j, hi_i)))
    s = prelude.get(intern("__cpu_avx2")) ?? 0
    if s == 0 or syms[s].kind != .global: ice("missing runtime global __cpu_avx2")
    ga = vreg(VI)
    out.push(Ins(.gaddr, VI, i32(ga), 0, 0, 0, global_addr_off(int(syms[s].ref))))
    avx = vreg(VI)
    out.push(Ins(.load, VI, i32(avx), i32(ga), 0, 1, 0))
    out.push(Ins(.block, 0, 0, 0, 0, 0, 0))
    lx_fail(out, lx_bin(out, .eq, avx, k_vreg(0)))
    lx_vloop(code, L, checks, plan, bases, VY, out)
    out.push(Ins(.vzu, 0, 0, 0, 0, 0, 0))
    out.push(Ins(.br, 0, 0, 0, 0, 0, 1))
    out.push(Ins(.end, 0, 0, 0, 0, 0, 0))
    if not plan.avx_only: lx_vloop(code, L, checks, plan, bases, VX, out)
    out.push(Ins(.end, 0, 0, 0, 0, 0, 0))

# Default builds consider short array/float loops with a vector plan. A large
# function may wrap a small floating-point kernel in shape and exact-index
# guards: cap the loop body, not its enclosing function. Keep the large integer
# path demand-driven through exact maps. Bounds and overlap guards retain the
# scalar path when a whole loop is not safe.

lx_vec_plan = (code: Ins[], L: CLoop, checks: LCheck[]) -> VPlan:
    no = VPlan(false, 0, false, [], [], [], [], [])
    plan = VPlan(true, 0, false, [], [], [], [], [])
    lx_reds.clear()
    lx_red_ops.clear()
    # (an instruction kind the plan never takes rules it out before anything is worked out)
    loop p in [L.pl + 1..L.inc):
        if not lx_vec_op(code[p].op) and not lx_in_check(p, checks): return no
    affine = false
    loop ch in checks:
        if ch.kind == 3 or ch.kind == 6: affine = true
    indexes: int[]
    kinds: {int: int}           # vreg made in the body -> element kind of its lanes
    loop p in [L.pl + 1..L.inc):
        if lx_in_check(p, checks): continue
        ins = code[p]
        op = ins.op
        d = int(ins.dst)
        if op == .block or op == .end or op == .nop: continue
        if (op == .gts or op == .lts or op == .ges or op == .les) and p + 1 < L.inc and lx_minmax(code, L, p + 1) != 0: continue
        minmax = lx_minmax(code, L, p)
        if minmax != 0:
            ins.a = ins.b
            ins.b = ins.c
        if op == .shl and lx_record_index(code, L, p):
            indexes.push(d)
            continue
        if affine and (op == .add or op == .sub) and lx_vec_index(code, L, checks, p):
            indexes.push(d)
            continue
        if op == .fconst or op == .iconst:
            # (a constant: in every lane)
            if lx_after(code, d, L): return no
            kinds[d] = -1
            continue
        if op == .load or op == .store:
            c = int(ins.c)
            if c & M_INDEX == 0 or c & M_HDR != 0: return no
            size = c & 15
            if size != 4 and size != 8: return no
            ix = mem_index(ins)
            sc = 3
            if size == 4: sc = 2
            stride = lx_record_stride(code, L, ins)
            if stride == 0 and ((ix != L.ctr and not indexes.contains(ix)) or mem_scale(ins) != sc): return no
            if stride != 0 and (op != .load or c & M_FLOAT == 0 or size != 8): return no
            base = int(ins.a)
            if lx_defined_in(code, base, L.pl + 1, L.pe): return no
            if plan.es == 0: plan.es = size
            if plan.es != size: return no
            k = lx_kind_of_mode(c)
            plan.bases.push(base)
            plan.offs.push(ins.imm)
            plan.stores.push(op == .store)
            plan.indexes.push(if stride != 0: L.ctr else: ix)
            plan.strides.push(stride)
            if op == .load:
                if not lx_within(code, d, L): return no
                kinds[d] = k
            else:
                v = int(ins.b)
                if let vk = kinds.get(v):
                    if vk != k and vk >= 0: return no
                else if lx_defined_in(code, v, L.pl + 1, L.pe) or is_kv(v): return no
            continue
        if op == .shl or op == .shrs or op == .shru:
            # Fixed qword shifts preserve the scalar bit semantics in each
            # lane. Dynamic and out-of-word counts remain scalar.
            count = int(ins.b)
            if not is_kv(count) or kv_of(count) < 0 or kv_of(count) >= 64: return no
            if (kinds.get(int(ins.a)) ?? -1) != 3 or not lx_within(code, d, L): return no
            kinds[d] = 3
            continue
        if op == .sext32 or op == .zext32:
            # (keeps the low 32 bits: nothing to do in 32-bit lanes)
            if let uk = kinds.get(int(ins.a)):
                if uk == 2 and lx_within(code, d, L):
                    kinds[d] = 2
                    continue
            return no
        if op == .fneg or op == .fsqrt:
            if not lx_within(code, d, L): return no
            fk = if int(ins.ty) == VS: 0 else: 1
            if let uk = kinds.get(int(ins.a)):
                if uk == fk or uk == -1:
                    kinds[d] = fk
                    continue
            return no
        # Float folds consume vector lanes in the original iteration order.
        # The accumulator must have no other use/definition in the loop.
        if op == .fadd and ins.ty == VF and (ins.a == ins.dst or ins.b == ins.dst) and ins.a != ins.b:
            x = if ins.a == ins.dst: int(ins.b) else: int(ins.a)
            if (kinds.get(x) ?? -1) != 1 or lx_appears(code, d, L.pl, L.pe) != 1: return no
            lx_reds.push(d)
            lx_red_ops.push(op)
            continue
        # (s = s + x: an integer sum over the loop, s used nowhere else in it)
        if (op == .add or op == .xor or op == .or_ or op == .and_) and int(ins.ty) == VI and (int(ins.a) == d or int(ins.b) == d) and int(ins.a) != int(ins.b):
            x = int(ins.b)
            if int(ins.a) != d: x = int(ins.a)
            if let xk = kinds.get(x):
                if xk == 3 and lx_appears(code, d, L.pl, L.pe) == 1:
                    lx_reds.push(d)
                    lx_red_ops.push(op)
                    continue
            return no
        fl = op == .fadd or op == .fsub or op == .fmul or op == .fdiv or op == .fmin or op == .fmax
        il = op == .add or op == .sub or op == .mul or op == .and_ or op == .or_ or op == .xor or minmax != 0
        if not fl and not il: return no
        if not lx_within(code, d, L): return no
        k = -1
        lanes = 0
        loop u in [int(ins.a), int(ins.b)]:
            if u == L.ctr: return no
            if let uk = kinds.get(u):
                if uk >= 0:
                    if k >= 0 and k != uk: return no
                    k = uk
                lanes += 1
            else if lx_defined_in(code, u, L.pl + 1, L.pe): return no   # (from the last iteration)
        fk = 1
        if int(ins.ty) == VS: fk = 0
        if lanes == 0: return no                  # (both operands the same in every iteration)
        if k < 0:
            k = 3
            if fl: k = fk
        if fl and k != fk: return no
        if fl and k >= 2: return no
        if il and k < 2: return no
        if minmax != 0 and k != 3: return no
        if op == .mul:
            if k != 2 and k != 3: return no
            plan.avx_only = true
        kinds[d] = k
    if plan.es == 0: return no
    # Strided reads cannot overlap an earlier vector lane's write. Keep all
    # write loops on the existing contiguous/overlap-guarded path.
    loop stride in plan.strides:
        if stride != 0 and plan.stores.contains(true): return no
    # stores and the accesses at the same base: the same element (an update in place), or none
    loop i in 0.. and bi in plan.bases:
        loop j in 0.. and bj in plan.bases:
            if i < j and bi == bj and (plan.stores[i] or plan.stores[j]) and (plan.offs[i] != plan.offs[j] or plan.indexes[i] != plan.indexes[j]): return no
    plan.index_defs = indexes
    plan

lx_vloop = (code: Ins[], L: CLoop, checks: LCheck[], plan: VPlan, bases: int[], ty: int, out: mut Ins[]):
    lanes = 16 / plan.es
    if ty == VY: lanes = 32 / plan.es
    out.push(Ins(.block, 0, 0, 0, 0, 0, 0))
    # Remaining distance works even when a shifted array index uses a counter
    # near the integer limit; counter + lanes - 1 could overflow there.
    t = lx_bin(out, .sub, L.endv, L.ctr)
    out.push(Ins(.brif, 0, 0, i32(lx_bin(out, .ltu, t, k_vreg(lanes))), 0, 0, 0))
    # A full first vector establishes end >= start + lanes. Thus end-lanes
    # is representable in the counter's domain, including negative signed
    # counters. Hoist this endpoint instead of subtracting on every backedge.
    last = if is_kv(L.endv): k_vreg(kv_of(L.endv) - lanes) else: lx_bin(out, .sub, L.endv, k_vreg(lanes))
    vmap: {int: int}            # scalar vreg -> its vector
    kind: {int: int}
    pre: Ins[]
    body: Ins[]
    memory_index = 0
    racc = fill(-1, lx_reds.len())
    loop p in [L.pl + 1..L.inc):
        if lx_in_check(p, checks): continue
        ins = code[p]
        op = ins.op
        d = int(ins.dst)
        if op == .block or op == .end or op == .nop: continue
        if (op == .gts or op == .lts or op == .ges or op == .les) and p + 1 < L.inc and lx_minmax(code, L, p + 1) != 0: continue
        minmax = lx_minmax(code, L, p)
        if minmax != 0:
            ins.a = ins.b
            ins.b = ins.c
        if o_defines(op) and d != L.ctr and plan.index_defs.contains(d): continue
        if op == .fconst or op == .iconst:
            # Constants are loop invariant; materialize once, then splat.
            c = vreg(int(ins.ty))
            pre.push(Ins(op, ins.ty, i32(c), 0, 0, 0, ins.imm))
            k = if op == .iconst: (if plan.es == 4: 2 else: 3) else if int(ins.ty) == VS: 0 else: 1
            v = vreg(ty)
            pre.push(Ins(.vsplat, i32(ty), i32(v), i32(c), 0, 0, k))
            vmap[d] = v
            kind[d] = k
            continue
        if op == .load:
            k = lx_kind_of_mode(int(ins.c))
            v = vreg(ty)
            stride = plan.strides[memory_index]
            index = if stride == 0: L.ctr else: lx_bin(body, .mul, L.ctr, k_vreg(stride))
            body.push(Ins(.vld, i32(ty), i32(v), i32(bases[memory_index]), i32(index), i32(k | (stride << 8)), ins.imm))
            memory_index += 1
            vmap[d] = v
            kind[d] = k
            continue
        if op == .store:
            k = lx_kind_of_mode(int(ins.c))
            val = int(ins.b)
            vv = lx_splat(pre, vmap, val, k, ty)
            body.push(Ins(.vst, i32(ty), i32(L.ctr), i32(bases[memory_index]), i32(vv), i32(k), ins.imm))
            memory_index += 1
            continue
        if op == .sext32 or op == .zext32:
            vmap[d] = vmap[int(ins.a)]
            kind[d] = 2
            continue
        if op == .shl or op == .shrs or op == .shru:
            xa = lx_splat(pre, vmap, int(ins.a), 3, ty)
            v = vreg(ty)
            body.push(Ins(.vbin, i32(ty), i32(v), i32(xa), ins.b, i32(if op == .shl: 12 else if op == .shru: 13 else: 14), 3))
            vmap[d] = v
            kind[d] = 3
            continue
        if op == .fsqrt:
            k = if int(ins.ty) == VS: 0 else: 1
            xa = lx_splat(pre, vmap, int(ins.a), k, ty)
            v = vreg(ty)
            body.push(Ins(.vbin, i32(ty), i32(v), i32(xa), i32(xa), 9, k))
            vmap[d] = v
            kind[d] = k
            continue
        if op == .fneg:
            k = if int(ins.ty) == VS: 0 else: 1
            xa = lx_splat(pre, vmap, int(ins.a), k, ty)
            # Flip only the sign bit, preserving signed zero and NaN payloads.
            # Broadcast the mask as integer bits, not a numeric conversion.
            signbit = -9223372036854775807 - 1
            if k == 0: signbit = 2147483648
            mask = lx_splat(pre, vmap, k_vreg(signbit), k + 2, ty)
            v = vreg(ty)
            body.push(Ins(.vbin, i32(ty), i32(v), i32(xa), i32(mask), 8, k))
            vmap[d] = v
            kind[d] = k
            continue
        ri = lx_reds.index_of(d)
        if ri >= 0 and int(ins.ty) == VF:
            x = if ins.a == ins.dst: int(ins.b) else: int(ins.a)
            body.push(Ins(.vbin, VF, i32(d), i32(d), i32(vmap[x]), i32(if ins.a == ins.dst: 10 else: 11), 1))
            continue
        if ri >= 0 and int(ins.ty) == VI:
            # (an integer sum: partial sums in a vector, which starts at the identity)
            if racc[ri] < 0:
                z = vreg(VI)
                iden = 0
                if lx_red_ops[ri] == .and_: iden = -1
                pre.push(Ins(.iconst, VI, i32(z), 0, 0, 0, iden))
                racc[ri] = vreg(ty)
                pre.push(Ins(.vsplat, i32(ty), i32(racc[ri]), i32(z), 0, 0, 3))
            x = int(ins.b)
            if int(ins.a) != d: x = int(ins.a)
            ro = 0
            if lx_red_ops[ri] == .and_: ro = 6
            else if lx_red_ops[ri] == .or_: ro = 7
            else if lx_red_ops[ri] == .xor: ro = 8
            body.push(Ins(.vbin, i32(ty), i32(racc[ri]), i32(racc[ri]), i32(vmap[x]), i32(ro), 3))
            continue
        # arithmetic: the element kind from an operand with lanes
        k = -1
        loop u in [int(ins.a), int(ins.b)]:
            if let uk = kind.get(u):
                k = uk
                break
        vo = 0
        match op:
            fadd, add: vo = 0
            fsub, sub: vo = 1
            fmul, mul: vo = 2
            fdiv: vo = 3
            fmin: vo = 4
            fmax: vo = 5
            and_: vo = 6
            or_: vo = 7
            _: vo = 8
        if minmax != 0: vo = minmax
        xa = lx_splat(pre, vmap, int(ins.a), k, ty)
        xb = lx_splat(pre, vmap, int(ins.b), k, ty)
        v = vreg(ty)
        body.push(Ins(.vbin, i32(ty), i32(v), i32(xa), i32(xb), i32(vo), k))
        vmap[d] = v
        kind[d] = k
    loop x in pre: out.push(x)
    out.push(Ins(.loop, 0, 0, 0, 0, 0, 0))
    loop x in body: out.push(x)
    out.push(Ins(.add, VI, i32(L.ctr), i32(L.ctr), i32(k_vreg(lanes)), 0, 0))
    out.push(Ins(.brif, 0, 0, i32(lx_bin(out, (if L.signed: Op.les else: Op.leu), L.ctr, last)), 0, 0, 0))
    out.push(Ins(.end, 0, 0, 0, 0, 0, 0))
    # (the partial sums added into the sum, through memory: the rest of the loop goes on from there)
    loop ri in 0.. and acc in lx_reds:
        if racc[ri] < 0: continue
        sl = new_slot(32, 32)
        sa = vreg(VI)
        out.push(Ins(.slot, VI, i32(sa), i32(sl), 0, 0, 0))
        z = vreg(VI)
        out.push(Ins(.iconst, VI, i32(z), 0, 0, 0, 0))
        out.push(Ins(.vst, i32(ty), i32(z), i32(sa), i32(racc[ri]), 3, 0))
        loop j in [0..lanes):
            t = vreg(VI)
            out.push(Ins(.load, VI, i32(t), i32(sa), 0, 8, j * 8))
            out.push(Ins(lx_red_ops[ri], VI, i32(acc), i32(acc), i32(t), 0, 0))
    out.push(Ins(.end, 0, 0, 0, 0, 0, 0))

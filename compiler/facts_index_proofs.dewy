    }
    if k =? 'assign' {
        let lhs=IndexWord(nodes.ptr[n].a)
        let lk=nodes.ptr[lhs].kind
        if lk =? 'tuple' {
            positive_target_write(lhs (-1))
            return
        }
        if lk not=? 'ident' or nodes.ptr[lhs].aux not=? int32(1) {return}
        let l0=IndexWord(nodes.ptr[lhs].sym)
        let ok=positive_local_ok(l0)
        if ok =? 0 {return}
        let old=positive_bounds.get(l0)
        if old not=? none and old <? 0 {return}
        let bound:IndexWord=-1
        if node_op(nodes.ptr[n].op_ext) =? int32(47) and nodes.ptr[n].aux =? 0 {
            let rhs=IndexWord(nodes.ptr[n].b)
            bound=positive_bound(rhs false)
            if bound <? 0 and positive_is_dewy and ok =? 1 {
                let rb=rhs
                if rb >? 0 and nodes.ptr[rb].kind =? 'conv' and nodes.ptr[rb].aux =? int32(int64(CV.fixed_store)) {rb=IndexWord(nodes.ptr[rb].a)}
                rb=word_integer_value(rb)
                if rb >? 0 and nodes.ptr[rb].kind =? 'binary' and nodes.ptr[rb].aux =? 0 and node_op(nodes.ptr[rb].op_ext) =? int32(58) {
                    let ra=word_integer_value(IndexWord(nodes.ptr[rb].a))
                    let rc=word_integer_value(IndexWord(nodes.ptr[rb].b))
                    if ra >? 0 and nodes.ptr[ra].kind =? 'ident' and nodes.ptr[ra].aux =? int32(1) and IndexWord(nodes.ptr[ra].sym) =? l0 {
                        if positive_bound(rc false) >=? 0 {bound=9223372036854775807}
                        else {
                            let [sl _]=positive_local_rhs(rc)
                            if sl >? 0 {
                                positive_deps.push([l0 sl true])
                                positive_local_write_ok(l0 0)
                                return
                            }
                        }
                    } else if rc >? 0 and nodes.ptr[rc].kind =? 'ident' and nodes.ptr[rc].aux =? int32(1) and IndexWord(nodes.ptr[rc].sym) =? l0 {
                        if positive_bound(ra false) >=? 0 {bound=9223372036854775807}
                        else {
                            let [sl _]=positive_local_rhs(ra)
                            if sl >? 0 {
                                positive_deps.push([l0 sl true])
                                positive_local_write_ok(l0 0)
                                return
                            }
                        }
                    }
                }
                if bound <? 0 {
                    let [sl is_add]=positive_local_rhs(rhs)
                    if sl >? 0 {
                        positive_deps.push([l0 sl is_add])
                        positive_local_write_ok(l0 0)
                        return
                    }
                }
            }
        }
        else if node_op(nodes.ptr[n].op_ext) =? int32(48) and nodes.ptr[n].aux =? 0 {
            if positive_is_dewy and ok =? 1 {
                if positive_bound(IndexWord(nodes.ptr[n].b) false) >=? 0 {

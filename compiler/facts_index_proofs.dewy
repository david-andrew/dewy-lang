    positive_deps.clear()
}
positive_local_rhs=(rhs0:IndexWord):>[int64 bool]=>$unsafe {
    let r=rhs0
    if r >? 0 and nodes.ptr[r].kind =? 'conv' and nodes.ptr[r].aux =? int32(int64(CV.fixed_store)) {r=IndexWord(nodes.ptr[r].a)}
    r=word_integer_value(r)
    if r <=? 0 {return [0 false]}
    let rk=nodes.ptr[r].kind
    if rk =? 'ident' and nodes.ptr[r].aux =? int32(1) {
        let sl=IndexWord(nodes.ptr[r].sym)
        if sl >? 0 {
            let sfl=IndexWord(locals.ptr[sl].flags)
            let skip=LF_PARAM | LF_MUTPARAM | LF_CAPTURE | LF_CAPTURED | LF_ALIAS | LF_BYREF | LF_ADDR | LF_SHARED | LF_SOAELEM | LF_ELEMALIAS | LF_QUIET
            if sfl & LF_DECL not=? 0 and sfl & skip =? 0 and prune(IndexWord(locals.ptr[sl].type)) =? T_INT {return [sl false]}
        }
        return [0 false]
    }
    if rk =? 'binary' and nodes.ptr[r].aux =? 0 {
        let op=node_op(nodes.ptr[r].op_ext)
        if op =? int32(58) or op =? int32(60) {
            let a=IndexWord(nodes.ptr[r].a)
            let b=IndexWord(nodes.ptr[r].b)
            if nodes.ptr[b].kind =? 'int_lit' and not has_flag(b NF_U64) and nodes.ptr[b].ival >=? 0 {
                let [sl _]=positive_local_rhs(a)
                if sl >? 0 {return [sl true]}
            }
            if nodes.ptr[a].kind =? 'int_lit' and not has_flag(a NF_U64) and nodes.ptr[a].ival >=? 0 {
                let [sl _]=positive_local_rhs(b)
                if sl >? 0 {return [sl true]}
            }
        }
    }
    [0 false]
}
positive_local_ok=(l:IndexWord):>IndexWord=>$unsafe {
    if l <=? 0 or IndexWord(locals.ptr[l].owner) not=? cur_fn {return 0}
    let fl=IndexWord(locals.ptr[l].flags)
    let skip=LF_PARAM | LF_MUTPARAM | LF_CAPTURE | LF_CAPTURED | LF_ALIAS | LF_BYREF | LF_ADDR | LF_SHARED | LF_SOAELEM | LF_ELEMALIAS | LF_QUIET
    if fl & LF_DECL =? 0 or fl & skip not=? 0 {return 0}
    let lt=prune(IndexWord(locals.ptr[l].type))
    if lt =? T_INT {return 1}
    if lt =? T_MATH_INT {return 2}
    0
}
positive_local_write_ok=(l:IndexWord bound:IndexWord):>void=>$unsafe {
    let old=positive_bounds.get(l) ?? bound
    if old <? 0 or bound <? 0 {positive_place_bounds[0][l]=-1}
    else {positive_place_bounds[0][l]=max(old bound)}
}
positive_write=(n:IndexWord):>void=>$unsafe {
    let k=nodes.ptr[n].kind
    if k =? 'vardecl' and not has_flag(n NF_GLOBAL) {
        if nkids(n) =? 0 {
            let l=IndexWord(nodes.ptr[n].sym)
            let ok=positive_local_ok(l)
            if ok =? 0 {return}
            let b=IndexWord(nodes.ptr[n].b)
            if b =? 0 {
                positive_local_write_ok(l 0)
                return
            }
            let bound=positive_bound(b false)
            if bound <? 0 and positive_is_dewy and ok =? 1 {
                let bk=nodes.ptr[b].kind
                if bk =? 'ident' or bk =? 'binary' or bk =? 'conv' {
                    let [sl is_add]=positive_local_rhs(b)
                    if sl >? 0 {
                        positive_deps.push([l sl is_add])
                        positive_local_write_ok(l 0)
                        return
                    }
                }
            }
            positive_local_write_ok(l bound)

}
positive_local_write=(l:IndexWord bound:IndexWord):>void=>$unsafe {
    if l <=? 0 or IndexWord(locals.ptr[l].owner) not=? cur_fn {return}
    let fl=IndexWord(locals.ptr[l].flags)
    let skip=LF_PARAM | LF_MUTPARAM | LF_CAPTURE | LF_CAPTURED | LF_ALIAS | LF_BYREF | LF_ADDR | LF_SHARED | LF_SOAELEM | LF_ELEMALIAS | LF_QUIET
    if fl & LF_DECL =? 0 or fl & skip not=? 0 or (prune(IndexWord(locals.ptr[l].type)) not=? T_INT and prune(IndexWord(locals.ptr[l].type)) not=? T_MATH_INT) {return}

    let op=cx_token(IndexWord(node_op(nodes.ptr[n].op_ext)))
    if op =? 'amp' {
        let a=positive_bound(IndexWord(nodes.ptr[n].a) use_locals)
        let b=positive_bound(IndexWord(nodes.ptr[n].b) use_locals)

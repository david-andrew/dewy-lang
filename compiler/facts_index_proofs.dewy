}
let positive_deps:array<[int64 int64 bool]>=[]
let positive_is_dewy:bool=false
positive_deps_clear=(is_dewy:bool):>void=>{
    positive_is_dewy=is_dewy
    if positive_deps.length >? 0 {positive_deps.clear()}
}
positive_deps_finish=():>void=>$unsafe {
    let nd=positive_deps.length
    if nd =? 0 {return}
    let iter:IndexWord=0
    loop iter <=? nd {
        let changed=false
        loop dep in positive_deps {
            let dst=dep[0]
            let src=dep[1]
            let is_add=dep[2]
            let db=positive_bounds.get(dst) ?? (-1)
            if db <? 0 {continue}
            let sb=positive_bounds.get(src) ?? (-1)
            if sb <? 0 {
                positive_place_bounds[0][dst]=-1
                changed=true
            }
            else if is_add {
                if db <? 9223372036854775807 {
                    positive_place_bounds[0][dst]=9223372036854775807
                    changed=true
                }
            }
            else if sb >? db {
                positive_place_bounds[0][dst]=sb
                changed=true

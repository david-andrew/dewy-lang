        <'block'|'str_lit'|'tuple'|'matrix'|'pvariant'> => {
            let nk=StorageWord(nodes.ptr[n].nlist)
            let l0=StorageWord(nodes.ptr[n].list)
            loop i in [0..nk) {fact_storage_scan(StorageWord(lists.ptr[l0 + i]) 0)}
            return
        }
        <'if_'|'iflet'|'range'> => {
            let ca=StorageWord(nodes.ptr[n].a)
            let cb=StorageWord(nodes.ptr[n].b)
            let cc=StorageWord(nodes.ptr[n].c)
            if ca not=? 0 {fact_storage_scan(ca 0)}
            if cb not=? 0 {fact_storage_scan(cb 0)}
            if cc not=? 0 {fact_storage_scan(cc 0)}
            return
        }
        <'unary'|'not_'|'unwrap'|'narrow'|'exprstmt'|'return_'|'defer_'|'plit'> => {
            let ca=StorageWord(nodes.ptr[n].a)
            if ca not=? 0 {fact_storage_scan(ca 0)}
            return
        }
        _ => {
            let mask:StorageWord=isolation_node_children(n)
            if mask <? 0 {
                storage_opaque[0]=true
                return
            }
            if not storage_calls[0] and (k =? 'partial' or k =? 'fnref' or k =? 'pair' or k =? 'map_lit' or k =? 'istype') and not ambient_storage_stable(n) {storage_calls[0]=true}
            if mask & 1 not=? 0 {
                let a:StorageWord=StorageWord(nodes.ptr[n].a)
                if a not=? 0 {fact_storage_scan(a 0)}
            }
            if mask & 2 not=? 0 {
                let b:StorageWord=StorageWord(nodes.ptr[n].b)
                if b not=? 0 {fact_storage_scan(b 0)}
            }
            if mask & 4 not=? 0 {
                let c:StorageWord=StorageWord(nodes.ptr[n].c)
                if c not=? 0 {fact_storage_scan(c 0)}
            }
            if mask & 16 not=? 0 {
                let nk=StorageWord(nodes.ptr[n].nlist)
                let l0=StorageWord(nodes.ptr[n].list)
                loop i in [0..nk) {fact_storage_scan(StorageWord(lists.ptr[l0 + i]) 0)}
            }
            if mask & 32 not=? 0 {
                let nk2=StorageWord(node_nlist2(nodes.ptr[n].op_ext))
                let l2=StorageWord(node_list2(nodes.ptr[n].op_ext))
                loop i in [0..nk2) {fact_storage_scan(StorageWord(lists.ptr[l2 + i]) 0)}
            }
        }
    }
}

# Target arrays have elements written; replacing a path kills that whole path.
fact_storage_target=(t:StorageWord):>void=>$unsafe {
    if not ambient_storage_stable(t) {storage_calls[0]=true}
    let k=nodes.ptr[t].kind
    let r:StorageWord=t
    loop nodes.ptr[r].kind =? 'field' {r=StorageWord(nodes.ptr[r].a)}
    if nodes.ptr[r].kind =? 'ident' and nodes.ptr[r].aux =? int32(1) and StorageWord(locals.ptr[StorageWord(nodes.ptr[r].sym)].flags) & LF_ELEMALIAS not=? 0 {
        fact_storage_scan(r 0)
        return
    }
    if k =? 'index' {
        let base:StorageWord=StorageWord(nodes.ptr[t].a)
        let key=lpath_key(base)
        if key not=? 0 {
            storage_written[0].push(key)
            if tkind(ntype(base)) =? 'array' {storage_bases[0].push(base)}
            fact_storage_scan(base 1)
        }
        else {fact_storage_target(base)}
        fact_storage_scan(StorageWord(nodes.ptr[t].b) 0)
        loop i in [0..nkids(t)) {fact_storage_scan(kid(t i) 0)}
        return
    }
    let key=lpath_key(t)
    if key not=? 0 {
        storage_kill[0].push(key)
        if k =? 'field' {fact_storage_scan(StorageWord(nodes.ptr[t].a) 1)}
        return
    }
    if k =? 'field' {
        fact_storage_target(StorageWord(nodes.ptr[t].a))
        return
    }
    fact_storage_scan(t 0)
}

StorageWord:type=int64<overflow='wrap'>

# Jo owns the per-function cache and lowering scratch headers. Bind their
# places once; recursive loops save only these six fields, retaining snapshots.
let storage_cache:ptr<dict<int64 FactStorage>>=$unsafe (uint64(0) as ptr<dict<int64 FactStorage>>)
let storage_bases:ptr<array<int64>>=$unsafe (uint64(0) as ptr<array<int64>>)
let storage_kill:ptr<array<int64>>=$unsafe (uint64(0) as ptr<array<int64>>)
let storage_escape:ptr<array<int64>>=$unsafe (uint64(0) as ptr<array<int64>>)
let storage_written:ptr<array<int64>>=$unsafe (uint64(0) as ptr<array<int64>>)
let storage_calls:ptr<bool>=$unsafe (uint64(0) as ptr<bool>)
let storage_opaque:ptr<bool>=$unsafe (uint64(0) as ptr<bool>)
facts_storage_bind=(cache:ptr<dict<int64 FactStorage>> bases:ptr<array<int64>> kill:ptr<array<int64>> escape:ptr<array<int64>> written:ptr<array<int64>> calls:ptr<bool> opaque:ptr<bool>):>int64=>{
    storage_cache=cache
    storage_bases=bases
    storage_kill=kill
    storage_escape=escape
    storage_written=written
    storage_calls=calls
    storage_opaque=opaque
    0
}

# Checked node/local IDs; raw arena reads are reacquired after every call.
# Cache hits are O(1); misses visit the loop's syntax and append nested summaries
# in their original order. No arena view survives a call or scratch growth.
fact_storage_loop=(n:StorageWord):>FactStorage=>$unsafe {
    let cached=fact_storage_cache.get(n)
    if cached not=? none {return cached}
    let saved=FactStorage(fp_bases fp_kill fp_escape fp_written fp_calls fp_lambda)
    storage_bases[0]=[]; storage_kill[0]=[]; storage_escape[0]=[]; storage_written[0]=[]
    storage_calls[0]=false; storage_opaque[0]=false
    fact_storage_scan(StorageWord(nodes.ptr[n].b) 0)
    if nodes.ptr[n].kind =? 'while_' {fact_storage_scan(StorageWord(nodes.ptr[n].a) 0)}
    let result=FactStorage(fp_bases fp_kill fp_escape fp_written fp_calls fp_lambda)
    storage_cache[0][n]=result
    storage_bases[0]=saved.bases; storage_kill[0]=saved.kill
    storage_escape[0]=saved.escape; storage_written[0]=saved.written
    storage_calls[0]=saved.calls; storage_opaque[0]=saved.opaque
    result
}

let fact_swap_array_path:string=""
let fact_swap_lib_dir:string=""
fact_is_array_swap=(n:StorageWord):>bool=>$unsafe {
    if nodes.ptr[n].kind not=? 'call' or nodes.ptr[n].aux not=? 0 or nkids(n) not=? 3 {return false}
    let f:StorageWord=StorageWord(nodes.ptr[n].sym)
    if f <=? 0 {return false}
    let d:StorageWord=StorageWord(fns.ptr[f].decl)
    if d =? 0 {return false}
    if fact_swap_lib_dir not=? lib_dir {
        fact_swap_lib_dir=lib_dir
        fact_swap_array_path="{lib_dir}/core/array.jo"
    }
    name_of(StorageWord(nodes.ptr[d].name)) =? "swap" and files.ptr[pos_file(nodes.ptr[d].pos)].path =? fact_swap_array_path
}

# ctx: 0 the value is used (copied, passed), 1 it is only indexed or measured.
fact_storage_scan=(n:StorageWord ctx:StorageWord):>void=>$unsafe {
    if n =? 0 {return}
    let k=nodes.ptr[n].kind
    match k {
        <'int_lit'|'float_lit'|'bool_lit'|'none_lit'|'null_lit'|'dotname'|'hole'|'break_'|'continue_'|'pwild'> => {return}
        <'ident'> => {
            if nodes.ptr[n].aux =? int32(1) and StorageWord(locals.ptr[StorageWord(nodes.ptr[n].sym)].flags) & LF_ELEMALIAS not=? 0 {
                let key=lpath_key(StorageWord(nodes.ptr[StorageWord(locals.ptr[StorageWord(nodes.ptr[n].sym)].alias)].a))
                if key not=? 0 {storage_kill[0].push(key)}
                return
            }
            let key=lpath_key(n)
            if key not=? 0 and ctx =? 0 {storage_escape[0].push(key)}
            return
        }
        <'field'> => {
            if not storage_calls[0] and not ambient_storage_stable(n) {storage_calls[0]=true}
            let key=lpath_key(n)
            let ca=StorageWord(nodes.ptr[n].a)
            if key not=? 0 {
                if ctx =? 0 {storage_escape[0].push(key)}
                fact_storage_scan(ca 1)
                return
            }
            fact_storage_scan(ca 0)
            return
        }
        <'index'> => {
            if not storage_calls[0] and not ambient_storage_stable(n) {storage_calls[0]=true}
            let base:StorageWord=StorageWord(nodes.ptr[n].a)
            if lpath_key(base) not=? 0 and tkind(ntype(base)) =? 'array' {storage_bases[0].push(base)}
            fact_storage_scan(base if nodes.ptr[n].aux =? 1 {0} else {1})
            fact_storage_scan(StorageWord(nodes.ptr[n].b) 0)
            let nk=StorageWord(nodes.ptr[n].nlist)
            if nk >? 0 {
                let l0=StorageWord(nodes.ptr[n].list)
                loop i in [0..nk) {fact_storage_scan(StorageWord(lists.ptr[l0 + i]) 0)}
            }
            return
        }
        <'assign'> => {
            fact_storage_target(StorageWord(nodes.ptr[n].a))
            fact_storage_scan(StorageWord(nodes.ptr[n].b) 0)
            return
        }
        <'for_'|'while_'> => {
            let summary=fact_storage_loop(n)
            loop v in summary.bases {storage_bases[0].push(v)}
            loop v in summary.kill {storage_kill[0].push(v)}
            loop v in summary.escape {storage_escape[0].push(v)}
            loop v in summary.written {storage_written[0].push(v)}
            storage_calls[0]=fp_calls or summary.calls or not ambient_storage_stable(n)
            storage_opaque[0]=fp_lambda or summary.opaque
            if k =? 'for_' {
                let ca=StorageWord(nodes.ptr[n].a)
                if has_flag(n NF_MUT) {
                    let key=lpath_key(ca)
                    if key not=? 0 {storage_kill[0].push(key)}
                }
                fact_storage_scan(ca 0)
            }
            return
        }
        <'lambda'> => {
            if not storage_calls[0] and not ambient_storage_stable(n) {storage_calls[0]=true}
            storage_opaque[0]=true
            return
        }
        <'addr'> => {
            if not storage_calls[0] and not ambient_storage_stable(n) {storage_calls[0]=true}
            let ca=StorageWord(nodes.ptr[n].a)
            let key=lpath_key(ca)
            if key not=? 0 {storage_kill[0].push(key)}
            fact_storage_scan(ca 1)
            return
        }
        <'cast'|'conv'> => {
            if not storage_calls[0] and not ambient_storage_stable(n) {storage_calls[0]=true}
            let ca=StorageWord(nodes.ptr[n].a)
            if raw_view(n) {
                let key=lpath_key(ca)
                if key not=? 0 {storage_kill[0].push(key)}
                fact_storage_scan(ca 1)
                return
            }
            if ca not=? 0 {fact_storage_scan(ca 0)}
            return
        }
        <'intrinsic'> => {
            let id=nodes.ptr[n].aux as IN
            if not isolation_intrinsic(id) {
                storage_opaque[0]=true
                return
            }
            if not storage_calls[0] and not ambient_storage_stable(n) {storage_calls[0]=true}
            let nk=StorageWord(nodes.ptr[n].nlist)
            if nk >? 0 {
                let l0=StorageWord(nodes.ptr[n].list)
                if id =? IN.push or id =? IN.pop or id =? IN.insert or id =? IN.remove or id =? IN.clear or id =? IN.reserve or id =? IN.resize or id =? IN.truncate or id =? IN.extend or id =? IN.arrdata {
                    let a0=StorageWord(lists.ptr[l0])
                    let key=lpath_key(a0)
                    if key not=? 0 {storage_kill[0].push(key)}
                    fact_storage_scan(a0 1)
                    loop i in [1..nk) {fact_storage_scan(StorageWord(lists.ptr[l0 + i]) 0)}
                    return
                }
                if id =? IN.len or id =? IN.arrcap {
                    fact_storage_scan(StorageWord(lists.ptr[l0]) 1)
                    return
                }
                let ca=StorageWord(nodes.ptr[n].a)
                if ca not=? 0 {fact_storage_scan(ca 0)}
                loop i in [0..nk) {fact_storage_scan(StorageWord(lists.ptr[l0 + i]) 0)}
                return
            }
            let ca=StorageWord(nodes.ptr[n].a)
            if ca not=? 0 {fact_storage_scan(ca 0)}
            return
        }
        <'call'> => {
            let l0=StorageWord(nodes.ptr[n].list)
            if fact_is_array_swap(n) {
                let base=StorageWord(lists.ptr[l0])
                let key=lpath_key(base)
                if key not=? 0 and tkind(ntype(base)) =? 'array' {
                    storage_bases[0].push(base)
                    storage_written[0].push(key)
                    fact_storage_scan(base 1)
                    fact_storage_scan(StorageWord(lists.ptr[l0 + 1]) 0)
                    fact_storage_scan(StorageWord(lists.ptr[l0 + 2]) 0)
                    return
                }
            }
            if not storage_calls[0] and not ambient_storage_stable(n) {storage_calls[0]=true}
            let mm:StorageWord=checked_call_mutmask(n)
            let nk=StorageWord(nodes.ptr[n].nlist)
            if mm not=? 0 {
                loop i in [0..nk) {
                    if mm & (StorageWord(1) << StorageWord(i)) not=? 0 {
                        let ai=StorageWord(lists.ptr[l0 + i])
                        let key=lpath_key(ai)
                        if key not=? 0 {storage_kill[0].push(key)}
                        else {fact_storage_target(ai)}
                    }
                }
            }
            let ca=StorageWord(nodes.ptr[n].a)
            if ca not=? 0 {fact_storage_scan(ca 0)}

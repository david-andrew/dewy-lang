    if old <? 0 or bound <? 0 {positive_place_bounds[0][l]=-1}
    else {positive_place_bounds[0][l]=max(old bound)}
}
positive_target_write=(n:IndexWord bound:IndexWord):>void=>$unsafe {
    if nodes.ptr[n].kind =? 'ident' and nodes.ptr[n].aux =? int32(1) {

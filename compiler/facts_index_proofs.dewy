            math_prepare_writes()
        }
        return positive_bounds.get(l) ?? -1
    }
    if k =? 'conv' and (nodes.ptr[n].aux =? int32(int64(CV.int_)) or nodes.ptr[n].aux =? int32(int64(CV.fixed_store))) {
        return positive_bound(IndexWord(nodes.ptr[n].a) use_locals)

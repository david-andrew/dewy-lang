use 'diagnostic_exit.dewy'
use 'ast.jo'
use 'check.jo'
use 'directives.jo'
use 'settings.jo'
use 'util.jo'

dir_program_setting = (name: str) -> bool:
    name == "time.zone" or name == "time.rules" or name == "time.zone_source" or name == "time.gap" or name == "time.fold" or name == "program.max_cores"

dir_program_prepare = ():
    if not dir_program_any: return
    dir_program_values = {}
    dir_rules_from_host = false
    entry_main = 0
    main_name = intern("main")
    loop m in modules:
        if files[int(m.file)].path != settings_path: continue
        loop d in m.decls:
            if nodes[d].kind == .fn_ and nodes[d].name == i32(main_name) and nodes[d].b != 0 and files[pos_file(nodes[d].pos)].path == settings_path:
                entry_main = nodes[int(nodes[d].b)].pos
    loop i in [0..dir_scopes.len()):
        s = dir_scopes[i]
        name = name_of(s.setting)
        if not dir_program_setting(name): continue
        header = s.start == dir_module_start(pos_file(s.start))
        legacy = s.start == entry_main and s.value >= 2
        if files[pos_file(s.start)].path != settings_path: continue
        if not header: continue
        dir_program_values[s.setting] = i
        if name == "program.max_cores":
            dir_header_cores = true
            dir_runtime_caps = true
            dir_runtime_settings = true
        if name == "time.zone_source": dir_rules_from_host = true

dir_program_finalize = (): dir_program_prepare()

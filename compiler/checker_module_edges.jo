use 'ast.jo'
use 'checker_state.dewy'
use 'prelude.jo'
use 'check.jo'
use 'util.jo'

module_added = (m: int):
    bits = 0
    if modules[m].is_prelude: bits = 1
    if files[int(modules[m].file)].is_dewy: bits |= 2
    mod_bits.push(bits)
    none_yet: int[]
    mod_uses.push(none_yet)

use_added = (m: int, u: int):
    modules[m].uses.push(u)
    mod_uses[m].push(u)
    if modules[u].is_prelude:
        if prelude_used.len() <= m: prelude_used.resize(m * 2 + 16)
        prelude_used[m] = true

order_modules = (m: int, out: mut int[]):
    if dfs_state[m]: return
    dfs_state[m] = true
    loop d in modules[m].decls:
        if nodes[d].kind == .import_:
            if nodes[d].aux == 2 or nodes[d].aux == 3: order_modules(int(nodes[d].sym), out)
            else if nodes[d].aux == 1:
                loop u in modules[m].uses: order_modules(u, out)
            else if let s = modules[m].names.get(int(nodes[d].name)):
                if syms[s].kind == .module: order_modules(int(syms[s].ref), out)
    if dp_loaded.len() > 0 and files[int(modules[m].file)].is_dewy:
        loop dm in dp_loaded: order_modules(dm, out)
    out.push(m)

# The root a mutable argument writes: its place's, through elements as well as
# fields (`f(@xs[i])`, and `d[k].clear()` on `d.vals[__map_entry_present(d k)]`),
# or none. O(route depth).
fact_written_root = (e0: int) -> PlaceIdentity:
    p = place_base(place_route(e0))
    if p.declaration != 0: return p
    e = e0
    indexed = false
    depth = 0
    loop e != 0 and depth < 32:
        depth += 1
        k = nodes[e].kind
        if k == .index and nodes[e].b != 0 or fact_payload_node(e): indexed = true
        # (a local place, `let q = @xs[i]` or `loop @x in xs`, and a narrowed
        # name write the place they name)
        else if k == .ident and nodes[e].aux == i32(int(SK.local)) and int(locals[int(nodes[e].sym)].flags) & LF_ALIAS != 0 and locals[int(nodes[e].sym)].alias != 0 and not place_locked.has(int(nodes[e].sym)):
            e = int(locals[int(nodes[e].sym)].alias)
            indexed = true
            continue
        else if k != .addr and k != .conv and not fact_field_node(e): break
        e = int(nodes[e].a)
    if not indexed or e == 0: return p
    place_base(place_route(e))
# A call's write through an element place, `f(@xs[i])` or `f(@d[k])` (on
# `d.vals[...]`), changes that route alone: its root gets a new value keeping
# what the route cannot change (fact_change_route: an array's length, a
# dictionary's keys and positions). False when the place is not one, for the
# caller's own rule. O(route depth + the root's projections).
fact_routed_write = (s: mut FactState, e0: int, at: int, reason: FactReason, paths: int[][] = []) -> bool:
    e = fact_routed_place(e0)
    if e == 0: return false
    fact_change_route(s, e, false, at, reason, paths)
    true
# The element place a mutable argument names (`@xs[i]`, `@d[k]`), or 0.
fact_routed_place = (e0: int) -> int:
    e = e0
    loop nodes[e].kind == .addr or nodes[e].kind == .conv: e = int(nodes[e].a)
    if place_base(place_route(e)).declaration != 0 or fact_written_root(e).declaration == 0: return 0
    e
# An opaque call's effects: every exposed root, and each local lent to it.
fact_forget_call = (s: mut FactState, n: int, reason: FactReason, at: int = 0):
    fact_forget(s, (if at == 0: n else: at), reason)
    fact_forget_mutable_maps(n, s, true, at, reason)
fact_dewy_local = (l: int) -> bool:
    f = int(locals[l].owner)
    if f <= 0 or f >= fns.len(): return false
    # (a Dewy module's top level is its initializer's body)
    if fns[f].decl == 0: return fns[f].kind == FK_INIT and files[int(modules[int(fns[f].mod)].file)].is_dewy
    files[pos_file(nodes[int(fns[f].decl)].pos)].is_dewy
# Distinct `@` parameters of one Dewy function are disjoint storage: each call
# passes them places the mutable-argument check proves apart (provisional).
fact_disjoint = (p: PlaceIdentity, q: PlaceIdentity) -> bool:
    # (a written local only lent to calls is its own storage: fact_own_local)
    if fact_own_local(p) and not (q.root == p.root and q.declaration == p.declaration): return true
    # (two globals are two storages: neither is ever a place of the other)
    if p.root == .global and q.root == .global: return p.declaration != q.declaration and p.declaration > 0 and q.declaration > 0
    if p.root != .local or q.root != .local or p.declaration == q.declaration or p.declaration == 0 or q.declaration == 0: return false
    a = p.declaration; b = q.declaration
    if locals[a].owner != locals[b].owner or int(locals[a].flags) & LF_MUTPARAM == 0 or int(locals[b].flags) & LF_MUTPARAM == 0: return false
    f = int(locals[a].owner)
    f > 0 and f < fns.len() and fns[f].decl != 0 and files[pos_file(nodes[int(fns[f].decl)].pos)].is_dewy
# Whether two places' types keep their storage apart: no write to one changes
# the other. Storage overlaps only when one lies inside the other, and a
# global lies inside nothing but itself, so a written global threatens a
# place whose type it can contain (an `@` parameter bound to it or a part of
# it), and a written local one whose type contains it or lies in it. Raw
# addresses (a place reached by `ptr`, `data`) can be viewed as any type, and
# pointers, callables and unresolved generics reach anything: all stay
# conservative. O(1) cached; once per type pair O(component types).
fact_type_disjoint = (w: PlaceIdentity, q: PlaceIdentity) -> bool:
    if w.declaration <= 0 or q.declaration <= 0 or w.root == q.root and w.declaration == q.declaration: return false
    if fact_place_raw(w) or fact_place_raw(q): return false
    wt = if w.root == .local: int(locals[w.declaration].type) else: int(globals[w.declaration].type)
    qt = if q.root == .local: int(locals[q.declaration].type) else: int(globals[q.declaration].type)
    if w.root == .global: return not fact_type_reaches(wt, qt)
    if q.root == .global: return not fact_type_reaches(qt, wt)
    not fact_type_reaches(wt, qt) and not fact_type_reaches(qt, wt)
# A place whose address was taken as a raw pointer (a global's escape, a
# local's `.ptr`): a view of it may have any type.
fact_place_raw = (p: PlaceIdentity) -> bool:
    if p.root == .global: return globals[p.declaration].exposed
    p.root != .local or int(locals[p.declaration].flags) & LF_EXPOSED != 0
fact_exposed_bound = (s: FactState) -> bool:
    loop binding in s.bindings:
        if fact_exposed(binding.place): return true
    false
# A write through an exposed place p forgets every exposed root but those
# disjoint from p.
fact_forget = (s: mut FactState, at: int, reason: FactReason, all: bool = false, written: PlaceIdentity = PlaceIdentity(.local, 0, 0), keep_written: bool = false, text_sink: bool = false):
    loop i in [0..s.bindings.len()):
        p = s.bindings[i].place
        if not all and not fact_exposed(p): continue
        # Output's internal buffers remain mutable. Preserve only checked
        # program globals that cannot alias those buffers through an escape.
        if text_sink and p.root == .global and not globals[p.declaration].exposed:
            d = int(globals[p.declaration].decl)
            if d != 0 and dewy_at(nodes[d].pos) and not pos_in_lib(nodes[d].pos): continue
        if text_sink and p.root == .local and fact_sink_disjoint_param(p.declaration): continue
        if not all and (fact_disjoint(written, p) or keep_written and p == written or fact_type_disjoint(written, p)): continue
        t = if p.root == .local: int(locals[p.declaration].type) else: int(globals[p.declaration].type)
        v = fact_new(s, fact_domain(t, reason, at), FactTerm(type = t))
        fact_holds_contract(s, t, v)
        old = s.bindings[i].value
        if not all and fact_raw_exposed_array(p) and old != 0 and v != 0:
            length = fact_project(s, old, -1, false, T_INT)
            if length != 0 and s.projections.len() < FACT_CAP: fact_add_projection(s, FactProjection(v, -1, false, length))
        s.bindings[i] = FactBinding(p, v, at, old)
# An array local exposed only as raw storage (`xs.ptr`, `data(xs)`): the
# pointer reaches its elements, never its descriptor, so a call may change
# its elements but not its length. O(1).
fact_raw_exposed_array = (p: PlaceIdentity) -> bool:
    if p.root != .local or p.declaration <= 0: return false
    l = p.declaration
    int(locals[l].flags) & FACT_LENT == LF_EXPOSED and tkind(fact_type(int(locals[l].type))) == .array and fact_dewy_local(l)
# A program function's `@` parameter: a text sink writes only the library's
# own output state, whose globals only the runtime names, so `printl` keeps the
# facts of `@pos` and `@inv`. O(1).
fact_sink_disjoint_param = (l: int) -> bool:
    if int(locals[l].flags) & LF_MUTPARAM == 0 or not fact_dewy_local(l): return false
    d = int(fns[int(locals[l].owner)].decl)
    d != 0 and not pos_in_lib(nodes[d].pos)
# Whether this analysis is of a library function. O(1).
fact_owner_in_lib = () -> bool: fact_fn_in_lib(fact_owner)
fact_fn_in_lib = (f: int) -> bool:
    if f <= 0 or f >= fns.len(): return true
    d = int(fns[f].decl)
    d == 0 or pos_in_lib(nodes[d].pos)
# A place declared with a refined type holds its contract whatever changed it:
# every write to it was checked against that type. (A dependency names only
# stable bindings: ref_term.)
fact_holds_contract = (s: mut FactState, t: int, v: int):
    if refine_active and v != 0: ref_assume(t, v, [], s)
# A call that never returns ends its path: what it writes is never read, so
# its callee tree is not summarized for it.
fact_ends_path = (n: int) -> bool: ntype(n) == T_NEVER or nodes[n].aux == 0 and library_exit_call(n)
# A call needs length transfer only when its caller already tracks a mutable
# array's length. Reuse the bounded return summary, cached per function; no
# analysis for untouched/undemanded arrays. O(actual route depths + affected
# lengths), plus the existing once-per-callee, budgeted summary traversal.
fact_path_call_effects = (n: int, s: mut FactState):
    if fact_ends_path(n): effects_demand(0, true); return
    lengths: (int, int)[]
    shapes: (int, int, int)[]
    record_lengths: (int, int, int)[]
    if nodes[n].aux == 0 and nodes[n].sym > 0 and checked_call_mutmask(n) != 0:
        f = int(nodes[n].sym)
        loop i in [0..min(nkids(n), fns[f].params.len())):
            l = fns[f].params[i]
            if int(locals[l].flags) & LF_MUTPARAM == 0: continue
            pt = fact_type(int(locals[l].type))
            if fact_record_arrays(pt):
                fact_tracked_record_lengths(n, i, pt, s, record_lengths)
                continue
            if tkind(pt) != .array and (tkind(pt) != .struct_ or not is_nd(pt)): continue
            v = fact_summary_actual(n, i, s, true)
            if v == 0: continue
            if tkind(pt) != .array:
                p = fact_projection_find(s, v, intern("shape"), false)
                if p >= 0: shapes.push((i, s.projections[p].value, fact_nd_data_length(s, v)))
            else:
                p = fact_projection_find(s, v, -1, false)
                if p >= 0: lengths.push((i, s.projections[p].value))
    summary = FactSummary()
    shape_mask = 0
    if shapes.len() > 0: effects_demand(int(nodes[n].sym), true)
    if lengths.len() > 0 or shapes.len() > 0 or record_lengths.len() > 0:
        if int(nodes[n].sym) == fact_summary_owner and fact_summary_assumed.len() > 0:
            fact_summary_used = true
            summary.lengths = fact_summary_assumed
        else:
            summary = fact_summary(int(nodes[n].sym), true)
            if shapes.len() > 0: shape_mask = fact_shape_summaries.get(int(nodes[n].sym)) ?? 0
    fact_call_effects(n, s)
    # Only an already demanded shape requests the bounded body summary. On
    # every returning path it must preserve both immutable identities; an
    # unknown write, replacement, callback or pending cleanup refuses reuse.
    # O(actual routes + tracked shapes), within the existing summary budget.
    loop entry in shapes:
        i = entry.0
        if i >= 62 or shape_mask & (1 << i) == 0: continue
        v = fact_summary_actual(n, i, s)
        if v == 0 or s.projections.len() + 3 >= FACT_CAP: continue
        fact_add_projection(s, FactProjection(v, intern("shape"), false, entry.1))
        data = fact_project(s, v, intern("data"), false, mk_array(nd_elem(representation_type(fact_terms[v].type))))
        fact_add_projection(s, FactProjection(data, -1, false, entry.2))
    loop pair in lengths:
        i = pair.0
        if i >= summary.lengths.len() or summary.lengths[i] == 0: continue
        v = fact_summary_actual(n, i, s)
        if v == 0: continue
        # An unchanged length is the SAME immutable evaluation. Reusing it
        # avoids chains of equalities through recursive calls and joins.
        if summary.lengths[i] == 1 and s.projections.len() < FACT_CAP:
            fact_add_projection(s, FactProjection(v, -1, false, pair.1))
            continue
        after = fact_project(s, v, -1, false, T_INT)
        fact_difference(s, pair.1, after, 0, n)
        if summary.lengths[i] == 1: fact_difference(s, after, pair.1, 0, n)
        b = fact_bound(s, after); old = fact_bound(s, pair.1)
        fact_set_bound(s, after, FactBound(max(b.lo, old.lo), (if summary.lengths[i] == 1: min(b.hi, old.hi) else: b.hi)))

    # Record fields reuse exact lengths or carry the old length as a lower bound.
    loop entry in record_lengths:
        mode = fact_field_mode(summary.kept_fields, entry.0, entry.1)
        if mode == 0 or s.projections.len() >= FACT_CAP: continue
        v = fact_summary_actual(n, entry.0, s)
        if v == 0: continue
        pt = fact_type(int(locals[fns[int(nodes[n].sym)].params[entry.0]].type))
        field = fact_project(s, v, entry.1, false, fact_call_field_type(pt, entry.1))
        if field == 0: continue
        if mode == 1: fact_add_projection(s, FactProjection(field, -1, false, entry.2))
        else:
            after = fact_project(s, field, -1, false, T_INT)
            fact_difference(s, entry.2, after, 0, n)
            b = fact_bound(s, after)
            fact_set_bound(s, after, FactBound(max(b.lo, fact_bound(s, entry.2).lo), b.hi))
# A settled summary can preserve exposed roots across read-only calls.
# Opaque/callback/hidden-helper effects still invalidate every exposed root.
fact_call_effects = (n: int, s: mut FactState):
    f = int(nodes[n].sym)
    fact_forget_mutable_maps(n, s)
    # Formatting operands have already run. These bundled text sinks touch
    # runtime output buffers only, never a program's global or lent places.
    # Keep their full I/O/cost effects; this is solely a write-footprint rule.
    if nodes[n].aux == 0 and fact_text_sink(f): fact_forget(s, n, .call, text_sink = true); return
    # (a callee opaque by its signature forgets the same exposed roots its
    # summary would: its call tree is not visited for it)
    if nodes[n].aux == 0 and f > 0 and f < fns.len() and not (fns[f].body != 0 and fns[f].state != 2) and effect_signature_opaque(f):
        # A reviewed library class writes only its mutable actuals. With
        # none, allocator/bookkeeping opacity cannot change caller places.
        # Reuse the cached contract, O(1); do not walk a runtime call tree.
        if checked_call_mutmask(n) == 0 and effect_library_class(f) != .unclassified: return
        effects_demand(0, true)
        fact_forget_call(s, n, .call)
        return
    # (a return summary's run does not settle callee effect rows for itself:
    # a callee not yet settled forgets every exposed root, as an opaque call)
    if fact_summary_owner != 0 and nodes[n].aux == 0 and f > 0 and f < effect_summaries.len() and not effect_summaries[f].done:
        fact_forget_call(s, n, .call)
        return
    # (a call can change only exposed roots and its place arguments: with
    # neither bound here, its effect row has nothing to tell this state)
    if nodes[n].aux == 0 and checked_call_mutmask(n) == 0 and not fact_exposed_bound(s): return
    if fact_probe_on and nodes[n].aux == 0: fact_probe_note(f)
    if nodes[n].aux != 0 or not effects_demand(f, true):
        fact_forget_call(s, n, .call)
        return
    if fns[f].body != 0 and fns[f].state != 2:
        fact_forget_call(s, n, .callee)
        return
    events = effect_summaries[f].events
    loop event in events:
        if event.atom.kind != .opaque: continue
        # (opaque only for calls of its own callbacks, known here: their rows
        # instead, fact_callback_events)
        # (with no exposed fact at stake the opaque call forgets nothing more)
        known: EffectEvent[]
        if not fact_exposed_bound(s) or not fact_callback_ready(f) or not fact_callback_events(n, f, known):
            fact_forget_call(s, n, .call)
            return
        loop other in effect_summaries[f].events:
            if other.atom.kind != .opaque: known.push(other)
        events = known
        break
    loop event in events:
        # (a library caller's own facts may describe the output state a helper's text sink writes)
        if event.atom.kind == .opaque or event.atom.kind == .escape or event.atom.kind == .io and fact_owner_in_lib():
            fact_forget_call(s, n, .call)
            return
    # (an element place argument, `hurt(@fs[i])`, changes only what the
    # callee writes in it: its written paths, on every tracked element)
    routed: {int: int[][]} = {}
    loop event in events:
        if event.atom.kind != .write: continue
        p = place_base(event.atom.place)
        i = p.declaration - 1
        if p.root != .formal or i < 0 or i >= nkids(n) or fact_routed_place(kid(n, i)) == 0: continue
        paths = routed.get(i) ?? []
        paths.push(place_path(event.atom.place))
        routed[i] = paths
    loop i in [0..nkids(n)):
        if let paths = routed.get(i): fact_routed_write(s, kid(n, i), n, .call, paths)
    groups: FactCallWrites[]
    by_root: int[]
    loop event in events:
        if event.atom.kind != .write: continue
        route = event.atom.place
        p = place_base(route)
        path = place_path(route)
        if p.root == .formal:
            i = p.declaration - 1
            if i < 0 or i >= nkids(n): fact_forget_call(s, n, .call); return
            if routed.has(i): continue
            actual = place_route(kid(n, i))
            p = place_base(actual)
            if actual.parent != 0: path = place_path(actual) + path
        if p.declaration == 0: fact_forget_call(s, n, .call); return
        i = fact_binding(s, p)
        if i < 0:
            if fact_exposed(p): fact_forget(s, n, .call, false, p)
            continue
        old = s.bindings[i].value
        if path.len() == 0 or fact_projection_first(s, old) < 0:
            if fact_exposed(p): fact_forget(s, n, .call, false, p, true)
            t = if p.root == .local: int(locals[p.declaration].type) else: int(globals[p.declaration].type)
            value = fact_new(s, fact_domain(t, .call, n), FactTerm(type = t))
            fact_holds_contract(s, t, value)
            fact_rebind(s, p, value, n, old)
            continue
        g = fact_index_get(by_root, i)
        if g < 0:
            g = groups.len()
            fact_index_put(by_root, i, g)
            groups.push(FactCallWrites(p, i))
        groups[g].paths.push(path)
    loop group in groups:
        p = group.place
        old = s.bindings[group.binding].value
        # Other exposed roots may alias this one. Read the old value only
        # after earlier groups have invalidated any such alias.
        if fact_exposed(p): fact_forget(s, n, .call, false, p, true)
        t = if p.root == .local: int(locals[p.declaration].type) else: int(globals[p.declaration].type)
        value = fact_call_write(s, old, t, group.paths, 0, n)
        fact_rebind(s, p, value, n, old)
# The function a callback argument runs: a literal lambda or a named
# function with no environment, whose effect row is settled (a summary run
# uses only rows already settled; otherwise demanded here). 0 when unknown.
fact_callback_fn = (e0: int) -> int:
    e = e0
    loop nodes[e].kind == .conv: e = int(nodes[e].a)
    f = 0
    if nodes[e].kind == .lambda and not has_flag(e, NF_GENERIC): f = int(nodes[e].sym)
    else if nodes[e].kind == .fnref and nodes[e].aux != 1 and nodes[e].aux != 2 and nodes[e].sym > 0 and not fns[int(nodes[e].sym)].has_env: f = int(nodes[e].sym)
    if f <= 0 or f >= fns.len(): return 0
    if fact_summary_owner != 0 and (f >= effect_summaries.len() or not effect_summaries[f].done): return 0
    if not effects_demand(f, true): return 0
    f
# Callee f's row is complete and opaque only for its own callbacks. A
# footprint scan stops at a callback call (EffectSummary.cut) until a call
# needs those rows: the first, outside summary runs and effect traversals,
# rebuilds the footprint graph to scan past them for the rest of the compile
# (once per compile; programs that never need it pay nothing).
fact_callback_ready = (f: int) -> bool:
    if effect_summaries[f].opaque_other or effect_summaries[f].callbacks == 0: return false
    if not effect_summaries[f].cut: return true
    if effect_callbacks_full or fact_summary_owner != 0 or not effect_footprints_only or effect_stack.len() > 0 or effect_solving or effect_inference_busy: return false
    effect_callbacks_full = true
    effect_graph_reset()
    effect_footprints_only = true
    if not effects_demand(f, true): return false
    not effect_summaries[f].opaque_other and effect_summaries[f].callbacks != 0 and not effect_summaries[f].cut
# Call n's callee f is opaque only for calls of its own callbacks
# (EffectSummary.callbacks). With each one's argument known here, those calls
# do what the argument's settled row says: its events go to out, unless one
# is opaque, escapes, or writes a place other than a global (a write to its
# own formal reaches a place f chose). O(callbacks + their rows).
fact_callback_events = (n: int, f: int, out: mut EffectEvent[]) -> bool:
    mask = effect_summaries[f].callbacks
    if effect_summaries[f].opaque_other or effect_summaries[f].cut or mask == 0: return false
    loop i in [0..min(nkids(n), 62)):
        if mask & (1 << i) == 0: continue
        mask = mask & ~(1 << i)
        g = fact_callback_fn(kid(n, i))
        if g == 0: return false
        loop event in effect_summaries[g].events:
            kind = event.atom.kind
            if kind == .opaque or kind == .escape or kind == .remainder: return false
            if kind == .write and event.atom.place.root != .global: return false
            out.push(event)
    mask == 0
# A callback argument that writes no place outside its own locals: a literal
# lambda or a named function whose settled effect row holds no write, escape
# or opaque event. Calling it changes no caller place through any alias.
# O(row) once the callee's row is settled, on demand.
fact_callback_writes_nothing = (e0: int) -> bool:
    f = fact_callback_fn(e0)
    if f == 0: return false
    loop event in effect_summaries[f].events:
        kind = event.atom.kind
        if kind == .write or kind == .escape or kind == .opaque or kind == .remainder: return false
    true
# Scalars can select a program formatter. Only the resolved builtin word
# leaf or reviewed library formatter has no external writes.
fact_builtin_formatter = (part: int) -> bool:
    f = int(nodes[part].sym)
    if f <= 0: return false
    if f == (runtime_insts.get("__fmt_word") ?? 0): return true
    effect_library_class(f) != .unclassified
fact_text_sink = (f: int) -> bool:
    if f <= 0 or f >= fns.len(): return false
    if let known = fact_text_sinks.get(f): return known
    d = int(fns[f].decl)
    known = false
    if d != 0 and nodes[d].kind == .fn_ and fns[f].params.len() == 1:
        name = name_of(int(nodes[d].name))
        path = files[pos_file(nodes[d].pos)].path
        known = (name == "__print_str" and path == lib_dir + "/core/rt.jo" or name == "write" and path == lib_dir + "/core/os.jo") and int(locals[fns[f].params[0]].type) == T_STR
    fact_text_sinks[f] = known
    known
fact_call_field_type = (t: int, selector: int) -> int:
    if let known = fact_call_field_types.get((t, selector)): return known
    ft = shape_field_type(t, selector)
    fact_call_field_types[(t, selector)] = ft
    ft
fact_call_write = (s: mut FactState, old: int, t: int, paths: int[][], depth: int, at: int) -> int:
    whole = false
    loop path in paths:
        if depth >= path.len(): whole = true
    fresh = fact_new(s, fact_domain(t, .call, at), FactTerm(type = t))
    pi = fact_projection_first(s, old)
    if whole or pi < 0 or tkind(fact_type(t)) != .struct_ or is_map_type(fact_type(t)) or fact_pool_type(t):
        fact_holds_contract(s, t, fresh)
        return fresh
    # Index the written children, then visit each demanded projection once.
    # No projection is created for an unread or wholly overwritten field.
    replaced: int[]
    by_field: {int: int[][]} = {}
    loop path in paths:
        selector = path[depth]
        if depth + 1 == path.len(): fact_index_put(replaced, selector, 1); continue
        routes = by_field.get(selector) ?? []
        routes.push(path)
        by_field[selector] = routes
    prior = s.projections
    links = s.index[0].projection_next
    loop pi >= 0:
        p = prior[pi]
        pi = fact_projection_next_in(prior, links, pi)
        if p.element or p.selector < 0 or fact_index_get(replaced, p.selector) >= 0: continue
        routes = by_field.get(p.selector) ?? []
        value = p.value
        if routes.len() > 0:
            ft = fact_call_field_type(fact_type(t), p.selector)
            if ft == 0: continue
            value = fact_call_write(s, value, ft, routes, depth + 1, at)
        if s.projections.len() < FACT_CAP: fact_add_projection(s, FactProjection(fresh, p.selector, false, value))
    fresh


# Names are positive interned IDs; a negative field records growth only.
# At most eight demanded fields per summary, no scan of unrelated state.
fact_field_mode = (kept: int[], parameter: int, field: int) -> int:
    i = 0
    loop i + 1 < kept.len():
        if kept[i] == parameter:
            if kept[i + 1] == field: return 1
            if kept[i + 1] == -field: return 2
        i += 2
    0
fact_kept_field = (kept: int[], parameter: int, field: int) -> bool:
    i = 0
    loop i + 1 < kept.len():
        if kept[i] == parameter and kept[i + 1] == field: return true
        i += 2
    false

# (the array fields of a mutable record actual whose length this state tracks: the demand for
# their summary. O(fields), at most eight, as the summary's own list)
fact_tracked_record_lengths = (n: int, i: int, pt: int, s: mut FactState, out: mut (int, int, int)[]):
    v = fact_summary_actual(n, i, s, true)
    if v == 0: return
    si = int(types[pt].st)
    loop k in [0..min(int(structs[si].nfields), 8)):
        name = int(fields[int(structs[si].fields) + k].name)
        p = fact_projection_find(s, v, name, false)
        if p < 0: continue
        q = fact_projection_find(s, s.projections[p].value, -1, false)
        if q >= 0: out.push((i, name, s.projections[q].value))
# Lifecycle footprints: the twin of facts_forgets.dewy's (see there).
fact_drop_footprint = (t0: int) -> int[]:
    t = ow_representation(t0)
    if let known = fact_drop_types.get(t): return known
    out = [0]
    seen: int[]
    if fact_drop_type(t, out, seen, 0): fact_drop_types[t] = out
    out
fact_drop_type = (t: int, out: mut int[], seen: mut int[], depth: int) -> bool:
    if out[0] & 1 != 0 or seen.contains(t): return true
    if depth > 32 or ownership_callable_cap(t) != 0:
        out[0] = out[0] | 1
        return true
    seen.push(t)
    k = tkind(t)
    if k == .fixed or k == .array or k == .opt or k == .box: return fact_drop_type(ow_representation(telem(t)), out, seen, depth + 1)
    if k != .tuple and k != .enum_ and k != .struct_: return true
    settled = true
    if k == .struct_:
        si = int(types[t].st)
        settled = fact_drop_hook(int(structs[si].drop_fn), true, out)
        settled = fact_drop_hook(ownership_copies.get(t) ?? 0, false, out) and settled
        settled = fact_drop_hook(ownership_moves.get(t) ?? 0, true, out) and settled
        settled = fact_drop_hook(owner_map_copies.get(t) ?? 0, false, out) and settled
        parent = ow_parents[0].get(t) ?? 0
        if parent != 0: settled = fact_drop_type(ow_representation(parent), out, seen, depth + 1) and settled
    if k == .enum_:
        loop ft in ow_variant_types(t):
            if ownership_fact_type(ft): settled = fact_drop_type(ow_representation(ft), out, seen, depth + 1) and settled
    else:
        loop ft in ow_field_types(t):
            if ownership_fact_type(ft): settled = fact_drop_type(ow_representation(ft), out, seen, depth + 1) and settled
    settled
fact_drop_hook = (g: int, receiver: bool, out: mut int[]) -> bool:
    if g <= 0 or out[0] & 1 != 0: return true
    if g >= fns.len() or fns[g].body == 0 or fns[g].state != 2:
        out[0] = out[0] | 1
        return true
    if fact_summary_owner != 0 and (g >= effect_summaries.len() or not effect_summaries[g].done):
        out[0] = out[0] | 1
        return false
    if not effects_demand(g, true):
        out[0] = out[0] | 1
        return true
    loop event in effect_summaries[g].events:
        kind = event.atom.kind
        if kind == .opaque or kind == .escape:
            out[0] = out[0] | 1
            return true
        if kind == .io: out[0] = out[0] | 2
        if kind != .write: continue
        p = place_base(event.atom.place)
        if p.root == .global and p.declaration > 0: fact_drop_global(out, p.declaration)
        else if not (receiver and p.root == .formal and p.declaration == 1):
            out[0] = out[0] | 1
            return true
    true
fact_drop_global = (out: mut int[], g: int):
    loop i in [1..out.len()):
        if out[i] == g: return
    out.push(g)
fact_drop_union = (out: mut int[], fp: int[]):
    out[0] = out[0] | fp[0]
    loop i in [1..fp.len()): fact_drop_global(out, fp[i])
fact_drop_add = (out: mut int[], t: int) -> bool:
    fact_drop_union(out, fact_drop_footprint(t))
    fact_drop_types.has(ow_representation(t))
fact_drop_any = (fp: int[]) -> bool: fp.len() > 1 or fp[0] & 1 != 0 or fp[0] & 2 != 0 and fact_owner_in_lib()
fact_drop_statement = (c: int) -> int[]:
    key = c * 4
    if let known = fact_drop_sites.get(key): return known
    out = [0]
    if fact_drop_scan(c, 0, out, false): fact_drop_sites[key] = out
    out
fact_drop_block = (n: int) -> int[]:
    key = n * 4 + 1
    if let known = fact_drop_sites.get(key): return known
    out = [0]
    if fact_drop_block_into(n, out): fact_drop_sites[key] = out
    out
# (an unscoped `( ... )` block's declarations are its enclosing block's, NF_UNSCOPED 4)
fact_drop_block_into = (n: int, out: mut int[]) -> bool:
    settled = true
    loop j in [0..nkids(n)):
        c = kid(n, j)
        k = nodes[c].kind
        if k == .vardecl and nodes[c].sym > 0 and not has_flag(c, NF_GLOBAL) and not has_flag(c, NF_ALIASDECL):
            t = int(locals[int(nodes[c].sym)].type)
            if ownership_fact_type(t): settled = fact_drop_add(out, t) and settled
        else if k == .defer_: settled = fact_drop_scan(int(nodes[c].a), 0, out, false) and settled
        else if k == .block and has_flag(c, 4): settled = fact_drop_block_into(c, out) and settled
    settled
fact_drop_exit = (f: int) -> int[]:
    body = int(fns[f].body)
    key = body * 4 + 3
    if let known = fact_drop_sites.get(key): return known
    out = [0]
    settled = fact_drop_scan(body, 0, out, true)
    loop i in [0..fns[f].params.len()):
        l = fns[f].params[i]
        t = int(locals[l].type)
        # A borrowed method receiver has no cleanup at this function's exit.
        if i == 0 and effect_method_borrows(f): continue
        if int(locals[l].flags) & LF_MUTPARAM == 0 and ownership_fact_type(t): settled = fact_drop_add(out, t) and settled
    if settled: fact_drop_sites[key] = out
    out
fact_drop_region = (n: int) -> int[]:
    key = n * 4 + 2
    if let known = fact_drop_sites.get(key): return known
    out = [0]
    if fact_drop_scan(n, 0, out, true): fact_drop_sites[key] = out
    out
fact_drop_pending = (f: int) -> bool:
    if not ownership_fact_cleanup or f <= 0 or f >= fns.len() or fns[f].body == 0: return ownership_fact_cleanup
    fact_drop_any(fact_drop_exit(f))
fact_drop_scan = (n: int, parent: int, out: mut int[], deep: bool) -> bool:
    if n <= 0 or out[0] & 1 != 0: return true
    k = nodes[n].kind
    if k == .lambda or k == .ptype or k == .pshape or k == .pseq or k == .block and not deep and parent != 0: return true
    settled = true
    if fact_drop_counted(n, parent): settled = fact_drop_add(out, ntype(n))
    if k == .assign and ownership_fact_type(ntype(int(nodes[n].a))): settled = fact_drop_add(out, ntype(int(nodes[n].a))) and settled
    if deep and k == .vardecl and nodes[n].sym > 0 and not has_flag(n, NF_GLOBAL) and not has_flag(n, NF_ALIASDECL):
        t = int(locals[int(nodes[n].sym)].type)
        if ownership_fact_type(t): settled = fact_drop_add(out, t) and settled
    if deep and (k == .match_ or k == .iflet) and ownership_fact_type(ntype(int(nodes[n].a))): settled = fact_drop_add(out, ntype(int(nodes[n].a))) and settled
    mask = isolation_children(k)
    if mask < 0:
        out[0] = out[0] | 1
        return true
    if mask & 1 != 0: settled = fact_drop_scan(int(nodes[n].a), n, out, deep) and settled
    if mask & 2 != 0: settled = fact_drop_scan(int(nodes[n].b), n, out, deep) and settled
    if mask & 4 != 0: settled = fact_drop_scan(int(nodes[n].c), n, out, deep) and settled
    if mask & 16 != 0:
        loop i in [0..nkids(n)): settled = fact_drop_scan(kid(n, i), n, out, deep) and settled
    settled
# A method call's receiver (its first argument) is borrowed, not moved: its
# owner drops it later, so passing it runs no hook. O(1).
fact_borrowed_receiver = (call: int) -> bool: nodes[call].aux == 0 and nodes[call].sym > 0 and effect_method_borrows(int(nodes[call].sym))
fact_drop_counted = (n: int, parent: int) -> bool:
    k = nodes[n].kind
    if k == .vardecl or k == .assign or k == .addr or not ownership_fact_type(ntype(n)): return false
    if parent == 0: return true
    pk = nodes[parent].kind
    if k == .ident or k == .field or k == .index or k == .narrow:
        if pk == .call and nkids(parent) > 0 and kid(parent, 0) == n and fact_borrowed_receiver(parent): return false
        if pk == .call or pk == .partial or pk == .intrinsic or pk == .array or pk == .tuple or pk == .map_lit or pk == .pair: return true
        return k == .index and (pk == .vardecl or pk == .assign or pk == .return_)
    if k == .call and (pk == .vardecl or pk == .assign or pk == .return_ or pk == .call and nodes[parent].aux == 2): return false
    true
fact_drop_forget = (s: mut FactState, at: int, fp: int[]):
    if not fact_drop_any(fp): return
    if fp[0] & 1 != 0 or fp[0] & 2 != 0 and fact_owner_in_lib():
        fact_forget(s, at, .call)
        return
    loop i in [0..s.bindings.len()):
        p = s.bindings[i].place
        if not fact_exposed(p): continue
        t = if p.root == .local: int(locals[p.declaration].type) else: int(globals[p.declaration].type)
        hit = false
        loop j in [1..fp.len()):
            if p.root == .global: hit = hit or p.declaration == fp[j]
            else: hit = hit or fact_type_reaches(int(globals[fp[j]].type), t)
        if not hit: continue
        v = fact_new(s, fact_domain(t, .call, at), FactTerm(type = t))
        fact_holds_contract(s, t, v)
        s.bindings[i] = FactBinding(p, v, at, s.bindings[i].value)
# Whether storage of type lt can lie inside storage of type gt (or be it).
# Cached per pair; O(gt's component types) once, depth 8.
fact_type_reaches = (gt: int, lt: int) -> bool:
    key = gt * 4294967296 + lt
    if let known = fact_reach_cache.get(key): return known
    reaches = fact_type_opaque(ow_representation(lt)) or fact_drop_reaches(gt, ow_representation(lt), 0)
    fact_reach_cache[key] = reaches
    reaches
fact_type_opaque = (t: int) -> bool:
    k = tkind(t)
    k == .ptr or k == .var or k == .param or k == .callable or k == .fn_ or k == .cfn
# Whether two types may name the same storage: one type, or one kind of
# scalar (`int32` and `int64<overflow='wrap'>` are not told apart) or of
# container over such storage. O(nesting).
fact_type_same = (a: int, b: int) -> bool:
    if a == b: return true
    k = tkind(a)
    if k != tkind(b): return false
    if fact_type_leaf(a): return true
    if k == .array or k == .fixed or k == .opt or k == .box: return fact_type_same(ow_representation(telem(a)), ow_representation(telem(b)))
    false
# A type without component storage or addresses.
fact_type_leaf = (t: int) -> bool:
    k = tkind(t)
    k == .int_ or k == .float_ or k == .bool_ or k == .str_ or k == .void_ or k == .null_ or k == .none_lit or k == .range or k == .vec or k == .quantity or k == .dimension
fact_drop_reaches = (gt0: int, lt: int, depth: int) -> bool:
    gt = ow_representation(gt0)
    if depth > 8 or fact_type_same(gt, lt): return true
    k = tkind(gt)
    if k == .array or k == .fixed or k == .opt or k == .box: return fact_drop_reaches(telem(gt), lt, depth + 1)
    if k == .tuple or k == .struct_ or k == .enum_:
        if k == .enum_:
            loop ft in ow_variant_types(gt):
                if fact_drop_reaches(ft, lt, depth + 1): return true
        else:
            loop ft in ow_field_types(gt):
                if fact_drop_reaches(ft, lt, depth + 1): return true
        return false
    not fact_type_leaf(gt)

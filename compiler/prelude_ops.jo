# A canonical Jo entry in the Dewy prelude always uses the shared namespace.
prelude_jo_module = (key: str) -> bool:
    if not ends_with(key, ".jo"): return false
    directory = path_dir(key)
    if not ends_with(directory, "/prelude"): return false
    directory == module_key("{lib_dir}/prelude", cwd())

# Whether the prelude is indexed: interactive sessions need future names and complete completion
# lists, and so parse it all
prelude_lazy_setup = ():
    prelude_lazy = not (ide_on or repl_image or watch_build)
# The units declaring name, parsed and registered (with their modules' other declarations, in
# file order)
prelude_demand_units = (name: int):
    e = pn_find(name)
    if e >= 0: prelude_demand_entry(e)
# Every unit still unparsed (a diagnostic listing every name, an explicit import of a whole module)
prelude_demand_all = ():
    loop e in [0..pn_entries.len()): prelude_demand_entry(e)
prelude_known_names = ():
    loop nm in prelude_known: demand_prelude_name(intern(nm))
# Deferred declarations retain the eager prelude's module/within-file order.
prelude_decl_before = (a: int, b: int) -> bool:
    if nodes[a].mod != nodes[b].mod: return nodes[a].mod < nodes[b].mod
    nodes[a].pos < nodes[b].pos
order_prelude_globals = (decls: mut int[]):
    loop i in [1..decls.len()):
        d = decls[i]
        j = i
        loop j > 0 and prelude_decl_before(d, decls[j - 1]):
            decls[j] = decls[j - 1]
            j -= 1
        decls[j] = d
dewy_prelude_module = (name: int) -> int:
    if not dp_scanned: dp_scan()
    if dp_by_name.len() <= name: dp_by_name.resize(name * 2 + 64)
    if dp_by_name[name] == 0: dp_by_name[name] = (dp_names.get(name_of(name)) ?? -1) + 2
    f = dp_by_name[name] - 2
    if f < 0: return -1
    dp_load(f)
# The Dewy prelude module of the file named file (lib/prelude/mpmc.jo), loaded now, or -1
dewy_prelude_file = (file: str) -> int:
    if not dp_scanned: dp_scan()
    loop f in [0..dp_paths.len()):
        if ends_with(dp_paths[f], "/" + file): return dp_load(f)
    -1
prelude_shown_path = (path: str) -> str:
    if starts_with(path, lib_dir + "/"): return "lib/" + path[len(lib_dir) + 1..]
    path
# The Dewy prelude's binding of name, or 0
dewy_prelude_lookup = (name: int) -> int:
    if name_of(name) == "within" or name_of(name) == "select": ensure_bundled_import("time/provider_mono.dewy", "$dewy_mono_provider", 0)
    m = dewy_prelude_module(name)
    if m < 0: return 0
    modules[m].names.get(name) ?? 0
# Index the prelude file at path as a module of its own; false: load it whole (load_module)
defer_prelude = (path: str, sub: str) -> bool:
    if not prelude_lazy or (sub == "game" and prelude_game_hint): return false
    src = read_source(path)
    if src == none: return false
    slash = rfind(path, "/")
    d = path[..slash)
    fi = files.len()
    files.push(SrcFile(path, d, src!))
    mi = modules.len()
    modules.push(Module(name = i32(intern(path_stem(path))), file = i32(fi), dir = d, is_prelude = true))
    module_added(mi)
    module_by_path[module_path_key(path)] = mi
    icb = ic_switch(IC_LOAD, IC_LIB)
    sc_target = target_const()
    r = scan_source(src!)
    sc_target = ""
    eager: int[]
    # (a unit's module and parsed mark; then its names posted to the index)
    first = pu_mod.len()
    pu_mod.resize(first + r.1 - r.0)
    pu_done.resize(first + r.1 - r.0)
    mods = data(pu_mod)
    loop k in [first..pu_mod.len()): mods[k] = mi
    p = data(src!)
    flags = data(su_flags)
    name0 = data(su_name0)
    name_at = data(su_name_at)
    name_len = data(su_name_len)
    loop u in [r.0..r.1):
        if flags[u] & (SU_EAGER | SU_NOMINAL) != 0: eager.push(u)
        else:
            # (exports join once their module is in use: with its first unit asked for)
            if flags[u] & SU_EXPORT != 0:
                xs = pm_exports.get(mi) ?? []
                xs.push(u)
                pm_exports[mi] = xs
            loop x in [name0[u]..name0[u + 1]): pn_post(pn_entry(p + name_at[x], name_len[x]), u)
    modules[mi].decls = prelude_parse_units(eager)
    ic_restore(icb)
    true
# The index entry of the name at p[0..n), made if it is new
pn_entry = (p: *u8, n: int) -> int:
    # (room for the library's names without growing)
    if pn_slots.len() == 0: pn_slots = fill(i32(0), 1 << 14)
    h = hash_bytes(p, n)
    mask = pn_slots.len() - 1
    i = h & mask
    slots = data(pn_slots)
    entries = data(pn_entries)
    loop true:
        e = int(slots[i])
        if e == 0: break
        e -= 1
        if entries[e].hash == h and entries[e].len == n and __mem_eq(entries[e].at, p, n): return e
        i = (i + 1) & mask
    e = pn_entries.len()
    pn_entries.push(PnEntry(h, p, n, -1, -1, false))
    pn_pending += 1
    slots[i] = i32(e + 1)
    if pn_entries.len() * 2 > pn_slots.len():
        # (grown: every entry placed again)
        pn_slots = fill(i32(0), pn_slots.len() * 2)
        mask = pn_slots.len() - 1
        slots = data(pn_slots)
        entries = data(pn_entries)
        loop k in [0..pn_entries.len()):
            j = entries[k].hash & mask
            loop slots[j] != 0: j = (j + 1) & mask
            slots[j] = i32(k + 1)
    e
# Unit u among the units declaring entry e (once, however many of its names it is)
pn_post = (e: int, u: int):
    entries = data(pn_entries)
    last = int(entries[e].last)
    if last >= 0 and int(pn_posts[last].unit) == u: return
    k = pn_posts.len()
    pn_posts.push(PnPost(i32(u), -1))
    if last < 0: entries[e].post = i32(k)
    else: pn_posts[last].next = i32(k)
    entries[e].last = i32(k)
# The entry of an interned name, or -1 (looked for once per name)
pn_find = (name: int) -> int:
    if pn_pending == 0: return -1
    if name < pn_seen.len() and pn_seen[name]: return -1
    loop pn_seen.len() <= name: pn_seen.push(false)
    pn_seen[name] = true
    if pn_slots.len() == 0: return -1
    s = names[name]
    n = len(s)
    h = hash_bytes(data(s), n)
    mask = pn_slots.len() - 1
    i = h & mask
    loop true:
        e = int(pn_slots[i])
        if e == 0: return -1
        e -= 1
        if pn_entries[e].hash == h and pn_entries[e].len == n and __mem_eq(pn_entries[e].at, data(s), n): return e
        i = (i + 1) & mask
    -1
# Parse units (of one module, in file order); their declarations
prelude_parse_units = (us: int[]) -> int[]:
    out: int[]
    loop u in us:
        if pu_done[u]: continue
        pu_done[u] = true
        m = pu_mod[u]
        f = int(modules[m].file)
        if pl_on:
            pl_units.push(f)
            pl_units.push(su_start[u])
            pl_units.push(su_end[u])
        loop d in parse_span(f, su_start[u], su_end[u]): out.push(d)
    out
prelude_demand_entry = (e: int):
    if pn_entries[e].done: return
    pn_entries[e].done = true
    pn_pending -= 1
    us: int[]
    k0 = int(pn_entries[e].post)
    loop k0 >= 0:
        us.push(int(pn_posts[k0].unit))
        k0 = int(pn_posts[k0].next)
    icb = ic_switch(IC_LOAD, IC_LIB)
    k = 0
    loop k < us.len():
        m = pu_mod[us[k]]
        group: int[]
        loop k < us.len() and pu_mod[us[k]] == m:
            group.push(us[k])
            k += 1
        if let xs = pm_exports.get(m):
            pm_exports.remove(m)
            loop x in xs:
                if not pu_done[x] and not group.contains(x): group.push(x)
            # (in file order)
            loop a in [1..group.len()):
                v = group[a]
                b = a
                loop b > 0 and group[b - 1] > v:
                    group[b] = group[b - 1]
                    b -= 1
                group[b] = v
        decls = prelude_parse_units(group)
        if decls.len() == 0: continue
        loop d in decls: prelude_new_decls.push(d)
        # (the module's declarations stay in file order)
        loop d in decls:
            i = modules[m].decls.len()
            modules[m].decls.push(d)
            loop i > 0 and nodes[modules[m].decls[i - 1]].pos > nodes[d].pos:
                modules[m].decls[i] = modules[m].decls[i - 1]
                i -= 1
            modules[m].decls[i] = d
        ic_restore(icb)
        if m < registered.len() and registered[m]: register_decls(m, decls)
        icb = ic_switch(IC_LOAD, IC_LIB)
    ic_restore(icb)
demand_prelude_name = (name: int):
    if dir_runtime_settings and not settings_frames_loaded and (name_of(name) == "__SettingsFrame" or starts_with(name_of(name), "__settings_")):
        settings_frames_loaded = true
        first_module = modules.len()
        register_module(load_module(lib_dir + "/runtime/settings_frames.jo", true, -1))
        mi = first_module
        loop mi < modules.len():
            register_module(mi)
            mi += 1
        if module_ctx.len() > 0: setup_module_contexts(init_fns[0])
        late_module_imports = true
    if dir_runtime_settings and not settings_values_loaded and name_of(name) in ["__settings_policy_capture", "__settings_policy_enter", "__settings_policy_leave"]:
        settings_values_loaded = true
        first_module = modules.len()
        register_module(load_module(lib_dir + "/runtime/settings_values.jo", true, -1))
        mi = first_module
        loop mi < modules.len():
            register_module(mi)
            mi += 1
        if module_ctx.len() > 0: setup_module_contexts(init_fns[0])
        late_module_imports = true
    if dir_runtime_caps and not settings_permits_loaded and starts_with(name_of(name), "__settings_core_"):
        settings_permits_loaded = true
        first_module = modules.len()
        register_module(load_module(lib_dir + "/runtime/settings_permits.jo", true, -1))
        mi = first_module
        loop mi < modules.len():
            register_module(mi)
            mi += 1
        if module_ctx.len() > 0: setup_module_contexts(init_fns[0])
        late_module_imports = true
    if dir_runtime_settings and not settings_rule_data_loaded and name_of(name) in ["__settings_rule_data_in_pack", "__settings_rule_frame", "__settings_rule_error"]:
        settings_rule_data_loaded = true
        first_module = modules.len()
        first_import = from_imports.len()
        register_module(load_module(lib_dir + "/time/rule_registry.jo", true, -1))
        mi = first_module
        loop mi < modules.len():
            register_module(mi)
            mi += 1
        bind_from_imports(first_import)
        if module_ctx.len() > 0: setup_module_contexts(init_fns[0])
        late_module_imports = true
    if dir_runtime_settings and name_of(name) in ["__settings_enter_rules_bytes", "__settings_enter_cores", "__settings_enter_gap", "__settings_enter_fold", "__settings_enter_source", "__settings_enter_zone", "__settings_enter_zone_value", "__settings_gap_read", "__settings_gap_one_read", "__settings_fold_read"]:
        zone = name_of(name) == "__settings_enter_zone" or name_of(name) == "__settings_enter_zone_value"
        rules = name_of(name) == "__settings_enter_rules_bytes"
        loaded = settings_runtime_loaded
        if zone: loaded = settings_zone_loaded
        if rules: loaded = settings_rules_loaded
        if not loaded:
            file = "settings.dewy"
            if zone:
                settings_zone_loaded = true
                file = "setting_zone.dewy"
            else if rules:
                settings_rules_loaded = true
                file = "setting_rules.dewy"
            else: settings_runtime_loaded = true
            first_module = modules.len()
            first_import = from_imports.len()
            register_module(load_module(lib_dir + "/prelude/" + file, true, -1))
            mi = first_module
            loop mi < modules.len():
                register_module(mi)
                mi += 1
            bind_from_imports(first_import)
            if module_ctx.len() > 0: setup_module_contexts(init_fns[0])
            late_module_imports = true
    if not math_runtime_loaded and starts_with(name_of(name), "__mi_"):
        math_runtime_loaded = true
        first_module = modules.len()
        first_import = from_imports.len()
        register_module(load_module(lib_dir + "/math_runtime.jo", true, -1))
        mi = first_module
        loop mi < modules.len():
            register_module(mi)
            mi += 1
        bind_from_imports(first_import)
        if module_ctx.len() > 0: setup_module_contexts(init_fns[0])
        late_module_imports = true
    if not math_eval_loaded and starts_with(name_of(name), "__mc_"):
        math_eval_loaded = true
        first_module = modules.len()
        first_import = from_imports.len()
        register_module(load_module(lib_dir + "/math_eval.jo", true, -1))
        mi = first_module
        loop mi < modules.len():
            register_module(mi)
            mi += 1
        bind_from_imports(first_import)
        if module_ctx.len() > 0: setup_module_contexts(init_fns[0])
        late_module_imports = true
    # (all overload owners before one is selected; registration and later lazy body checks can
    # demand further names, reaching a fixed point)
    if pn_pending > 0: prelude_demand_units(name)
dp_scan = ():
    dp_scanned = true
    dir = lib_dir + "/prelude"
    names_ = list_dir(dir)
    names_.sort()
    icb = ic_switch(IC_LOAD, IC_LIB)
    loop n in names_:
        if not ends_with(n, ".dewy") and not ends_with(n, ".jo"): continue
        path = "{dir}/{n}"
        src = read_source(path)
        if src == none: continue
        f = dp_paths.len()
        dp_paths.push(path)
        dp_mods.push(-1)
        r = scan_source(src!)
        loop x in [su_name0[r.0]..su_name0[r.1]):
            at = su_name_at[x]
            if su_name_len[x] == 0 or src![at] == '_': continue
            name = src![at..at + su_name_len[x])
            if dp_names.get(name) == none: dp_names[name] = f
    ic_restore(icb)
# The module of the prelude's file f, loaded on first use
dp_load = (f: int) -> int:
    m = dp_mods[f]
    if m < 0:
        # (`Reserved<T>`, a queue's permit, holds each kind's handle: the queue runtimes first,
        # when a program first reaches it)
        if ends_with(dp_paths[f], "/prelude/reserved.dewy"):
            loop g in [0..dp_paths.len()):
                if ends_with(dp_paths[g], "/prelude/mpmc.jo") or ends_with(dp_paths[g], "/prelude/spsc.jo"): dp_load(g)
        first_module = modules.len()
        first_import = from_imports.len()
        active = refine_active
        m = load_module(dp_paths[f], false, 0)
        # load_module classifies Jo entries before registration, including explicit imports.
        dp_mods[f] = m
        dp_loaded.push(m)
        mi = first_module
        loop mi < modules.len():
            register_module(mi)
            mi += 1
        bind_from_imports(first_import)
        if module_ctx.len() > 0: setup_module_contexts(init_fns[0])
        late_module_imports = true
        # (a refinement written in its declarations turns the program-wide machinery on once
        # one of them is resolved: refine_resume)
        if refine_active and not active:
            refine_active = false
            loop mi in [first_module..modules.len()): refine_deferred[mi] = true
    m
# The file (under lib/) declaring the prelude's name, "" when the prelude has none: its
# indexes only, so nothing is loaded or parsed (a splat import's shadowing warning)
prelude_source = (name: int) -> str:
    if not dp_scanned: dp_scan()
    if let f = dp_names.get(name_of(name)): return prelude_shown_path(dp_paths[f])
    if let s = prelude.get(name):
        if syms[s].decl != 0: return prelude_shown_path(files[pos_file(nodes[int(syms[s].decl)].pos)].path)
    if pn_slots.len() != 0:
        nm = names[name]
        n = len(nm)
        h = hash_bytes(data(nm), n)
        mask = pn_slots.len() - 1
        i = h & mask
        loop true:
            e = int(pn_slots[i])
            if e == 0: break
            e -= 1
            if pn_entries[e].hash == h and pn_entries[e].len == n and __mem_eq(pn_entries[e].at, data(nm), n):
                post = int(pn_entries[e].post)
                if post < 0: break
                mi = pu_mod[int(pn_posts[post].unit)]
                return prelude_shown_path(files[int(modules[mi].file)].path)
            i = (i + 1) & mask
    ""

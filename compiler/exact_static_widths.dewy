$runtime_checks

from p"ast.jo" import (NF_U64 has_flag nodes)
from p"check.jo" import (LF_ADDR LF_ALIAS LF_BYREF LF_CAPTURE LF_CONST LF_EXPOSED LF_MUTPARAM LF_SHARED dewy_at globals locals)
from p"checked_eval.dewy" import (cx_token_values)
from p"checker_tokens.dewy" import (Tok)
from p"checks_thin.dewy" import (readonly_global)
from p"exact.jo" import (exact_has_node exact_type_values exact_type_widths exact_word_reads)
from p"exact_check_hooks.dewy" import (exact_representation)
from p"exact_count_bounds.dewy" import (exact_count_bound)
from p"expr.jo" import (CV integer_constant ntype)
from p"type_ops.dewy" import (int_policy)
from p"types.jo" import (T_INT T_MATH_INT is_int types)

# Context-free width facts are demanded only by a storage boundary. Cache one
# signed width and a nonnegative bit per expression; 0 means not computed and
# -1 means unknown. Other negative entries are negated constant widths, with
# their magnitudes in the parallel node index (exact.jo owns both indexes).
# Each demanded edge is visited once: O(N+E) time/O(N) space, no separate walk.
# Constants use a signed magnitude with one unsigned word. Overflow of that
# bounded representation falls back to width bounds, never host-word wrapping.
WidthWord:type=int64<overflow='wrap'>
WidthU64:type=uint64<overflow='wrap'>

# Symbol-kind ordinals (checker_state.dewy SK, in declaration order).
const WIDTH_SK_LOCAL:int32=1
const WIDTH_SK_GLOBAL:int32=2

exact_width_op=(n:WidthWord):>Tok=>$unsafe {cx_token_values.ptr[WidthWord(nodes.ptr[n].op)]}

# The significant bits of a magnitude, with at most six tests.
exact_width_bits=(value0:WidthU64):>WidthWord=>{
    let value=value0
    let bits:WidthWord=1
    let shift:WidthU64=32
    loop shift >? 0 {
        if value >> (shift & 63) not=? 0 {
            value=value >> (shift & 63)
            bits+=WidthWord(int64(shift))
        }
        shift=shift >> 1
    }
    if value not=? 0 {bits+=1}
    bits
}

exact_constant_width=(n:WidthWord magnitude:WidthU64 negative0:bool):>int64=>$unsafe {
    let negative=negative0 and magnitude not=? 0
    let value=magnitude - WidthU64(int64(negative))
    let width=exact_width_bits(value) * 2 + WidthWord(int64(not negative))
    exact_type_values[n]=uint64(magnitude)
    exact_type_widths[n]=int64(-width)
    width
}

# Both child widths have already been demanded. Constant folding therefore
# does O(1) work at this node; no recursive evaluator or fact state is needed.
exact_fold_binary=(n:WidthWord ai:WidthWord bi:WidthWord):>int64=>$unsafe {
    let x=WidthU64(exact_type_values[WidthWord(nodes.ptr[n].a)])
    let y=WidthU64(exact_type_values[WidthWord(nodes.ptr[n].b)])
    let an=ai & 1 =? 0
    let bn=bi & 1 =? 0
    let op=exact_width_op(n)
    let value:WidthU64=0
    let negative=false
    let limit=WidthU64(0) - 1
    if op =? 'plus' or op =? 'minus' {
        if op =? 'minus' {bn=not bn}
        if an =? bn {
            if x >? limit - y {return 0}
            value=x + y
            negative=an
        } else if x >=? y {
            value=x - y
            negative=an
        } else {
            value=y - x
            negative=bn
        }
    } else if op =? 'star' {
        if y not=? 0 and x >? limit // y {return 0}
        value=x * y
        negative=an not=? bn
    } else if op =? 'slash' or op =? 'percent' {
        if y =? 0 {return 0}
        let quotient=x // y
        let remainder=x % y
        let floor=nodes.ptr[n].aux2 =? -1
        if op =? 'slash' {
            value=quotient
            negative=an not=? bn
            if floor and negative and remainder not=? 0 {value+=1}
        } else {
            value=remainder
            negative=an
            if floor and an not=? bn and remainder not=? 0 {
                value=y - remainder
                negative=bn
            }
        }
    } else if op =? 'amp' or op =? 'pipe' or op =? 'caret' {
        if an {x=0 - x}
        if bn {y=0 - y}
        if op =? 'amp' {
            value=x & y
            negative=an and bn
        } else if op =? 'pipe' {
            value=x | y
            negative=an or bn
        } else {
            value=x xor y
            negative=an not=? bn
        }
        if negative {
            value=0 - value
            if value =? 0 {return 0} # -2**64 exceeds the magnitude word
        }
    } else if op =? 'shl' or op =? 'shr' {
        if bn {return 0}
        negative=an
        if op =? 'shl' {
            if x =? 0 {value=0}
            else {
                if y >=? 64 or x >? limit >> (y & 63) {return 0}
                value=x << (y & 63)
            }
        } else if y >=? 64 {value=WidthU64(int64(an))}
        else {
            value=x >> (y & 63)
            if an and x & ((WidthU64(1) << (y & 63)) - 1) not=? 0 {value+=1}
        }
    } else if op =? 'starstar' {
        if bn {return 0}
        negative=an and y & 1 not=? 0
        value=1
        loop y not=? 0 {
            if y & 1 not=? 0 {
                if x not=? 0 and value >? limit // x {return 0}
                value=value * x
            }
            y=y >> 1
            if y not=? 0 {
                if x not=? 0 and x >? limit // x {return 0}
                x=x * x
            }
        }
    } else {return 0}
    exact_constant_width(n value negative)
}

exact_constant_fits=(width:WidthWord t:WidthWord):>bool=>$unsafe {
    if t =? T_MATH_INT {return true}
    let bits=WidthWord(types.ptr[t].bits)
    if types.ptr[t].sign {width >> 1 <=? bits} else {width & 1 not=? 0 and width >> 1 <=? bits + 1}
}

# The storage width of a plain fixed-width integer type: magnitude bits, plus
# the sign bit, plus a nonnegative bit.
exact_storage_width=(t:WidthWord):>WidthWord=>$unsafe {
    let unsigned=WidthWord(int64(not types.ptr[t].sign))
    (WidthWord(types.ptr[t].bits) + unsigned) * 2 + unsigned
}

exact_cached_index=(n:WidthWord):>WidthWord=>$unsafe {WidthWord(exact_type_widths[n])}

exact_type_width=(n:WidthWord constant_only:bool=false):>int64=>$unsafe {
    if n <? exact_type_widths.length and exact_type_widths[n] not=? 0 {
        let cached=exact_type_widths[n]
        if cached <? -1 {return -cached}
        return if constant_only {-1} else {cached}
    }
    if n >=? exact_type_widths.length {
        exact_type_widths.resize(max(int64(n + 1) nodes.length))
        exact_type_values.resize(exact_type_widths.length)
    }
    let k=nodes.ptr[n].kind
    if k =? 'int_lit' {
        let value=nodes.ptr[n].ival
        let magnitude=WidthU64(value)
        let result:WidthWord=131
        if value >=? 0 or not has_flag(n NF_U64) {
            if value <? 0 {magnitude=0 - magnitude}
            let high=if value <? 0 {-(WidthWord(value) + 1)} else {WidthWord(value)}
            result=exact_width_bits(WidthU64(high)) * 2 + WidthWord(int64(value >=? 0))
        }
        exact_type_values[n]=uint64(magnitude)
        exact_type_widths[n]=int64(-result)
        return result
    }
    # A constant binding may refer back to a node already being queried.
    exact_type_widths[n]=-1
    let t=exact_representation(ntype(n))
    let result:WidthWord=-1
    if k =? 'ident' {
        let global=nodes.ptr[n].aux =? WIDTH_SK_GLOBAL
        if constant_only and global {return -1}
        let initial:WidthWord=0
        if is_int(t) and int_policy(t) =? 0 {
            let ref=WidthWord(nodes.ptr[n].sym)
            if global {
                if readonly_global(ref) and not globals.ptr[ref].exposed {initial=WidthWord(nodes.ptr[WidthWord(globals.ptr[ref].decl)].b)}
            } else if nodes.ptr[n].aux =? WIDTH_SK_LOCAL and WidthWord(locals.ptr[ref].flags) & (LF_CONST | LF_CAPTURE) =? LF_CONST {
                initial=WidthWord(locals.ptr[ref].const_init)
            }
        }
        if initial not=? 0 {
            let width=exact_type_width(initial true)
            let index=exact_cached_index(initial)
            if index <? -1 and exact_constant_fits(width t) {
                # A stored global is zero until its initializer runs. Its
                # width includes zero, but it is not a singleton constant.
                exact_type_widths[n]=if global {width} else {int64(index)}
                if not global {exact_type_values[n]=exact_type_values[initial]}
                return width
            }
        }
        if not constant_only and is_int(t) and t not=? T_MATH_INT {result=exact_storage_width(t)}
        exact_type_widths[n]=int64(result)
        return result
    }
    if k =? 'conv' and is_int(t) and int_policy(t) =? 0 and (nodes.ptr[n].aux =? int32(int64(CV.int_)) or nodes.ptr[n].aux =? int32(int64(CV.none_))) {
        let a=WidthWord(nodes.ptr[n].a)
        let width=exact_type_width(a constant_only)
        let index=exact_cached_index(a)
        if width >? 0 and exact_constant_fits(width t) {
            exact_type_widths[n]=int64(index)
            if index <? -1 {exact_type_values[n]=exact_type_values[a]}
            return width
        }
    }
    # Unexpanded mathematical constants and stored bitwise operations also
    # have exact arithmetic semantics. Jo/policy words keep their own rules.
    if (k =? 'binary' or k =? 'unary') and (constant_only or not exact_has_node(n)) and is_int(t) and int_policy(t) =? 0 and dewy_at(nodes.ptr[n].pos) {
        if k =? 'binary' and nodes.ptr[n].aux =? 0 {
            let a=WidthWord(nodes.ptr[n].a)
            let b=WidthWord(nodes.ptr[n].b)
            exact_type_width(a constant_only);
            exact_type_width(b constant_only);
            let ai=exact_cached_index(a)
            let bi=exact_cached_index(b)
            if ai <? -1 and bi <? -1 {
                let folded=exact_fold_binary(n ai bi)
                if folded >? 0 {return folded}
            }
        } else if k =? 'unary' and exact_width_op(n) =? 'minus' {
            let a=WidthWord(nodes.ptr[n].a)
            exact_type_width(a constant_only);
            let index=exact_cached_index(a)
            if index <? -1 {return exact_constant_width(n WidthU64(exact_type_values[a]) index & 1 not=? 0)}
        }
    }
    # Initializers can belong to an owner not prepared yet. Only an actual
    # constant is usable there; a source storage type is not an exact bound.
    if constant_only {return -1}
    if exact_word_reads.has(n) {
        let bound=exact_count_bound(WidthWord(nodes.ptr[n].a))
        let lo=WidthWord(bound.lo)
        let hi=WidthWord(bound.hi)
        let magnitude=max(if lo <? 0 {-(lo + 1)} else {lo} if hi <? 0 {-(hi + 1)} else {hi})
        result=exact_width_bits(WidthU64(magnitude)) * 2 + WidthWord(int64(lo >=? 0))
    } else if not exact_has_node(n) {
        if is_int(t) and t not=? T_MATH_INT {result=exact_storage_width(t)}
    } else if k =? 'unary' {
        let a0=WidthWord(nodes.ptr[n].a)
        let a=WidthWord(exact_type_width(a0))
        let index=exact_cached_index(a0)
        if index <? -1 and exact_width_op(n) =? 'minus' {return exact_constant_width(n WidthU64(exact_type_values[a0]) index & 1 not=? 0)}
        if a >? 0 {result=((a >> 1) + 1) * 2}
    } else if k =? 'binary' {
        let a0=WidthWord(nodes.ptr[n].a)
        let b0=WidthWord(nodes.ptr[n].b)
        let a=WidthWord(exact_type_width(a0))
        let b=WidthWord(exact_type_width(b0))
        let ai=exact_cached_index(a0)
        let bi=exact_cached_index(b0)
        if ai <? -1 and bi <? -1 {
            let folded=exact_fold_binary(n ai bi)
            if folded >? 0 {return folded}
        }
        let op=exact_width_op(n)
        if op =? 'amp' {
            if a >? 0 and a & 1 not=? 0 {result=a}
            if b >? 0 and b & 1 not=? 0 {result=if result <? 0 {b} else {min(result b)}}
        } else if a >? 0 and b >? 0 {
            if op =? 'plus' or op =? 'minus' {result=(max(a >> 1 b >> 1) + 1) * 2 + WidthWord(int64(op =? 'plus' and a & b & 1 not=? 0))}
            else if op =? 'star' {result=((a >> 1) + (b >> 1)) * 2 + (a & b & 1)}
            else if op =? 'pipe' or op =? 'caret' {result=max(a >> 1 b >> 1) * 2 + (a & b & 1)}
        }
        if op =? 'slash' and a >? 0 {
            let [known divisor0]=integer_constant(b0)
            let divisor=WidthWord(divisor0)
            if known and divisor not=? 0 and divisor not=? -1 {
                let bits=a >> 1
                # A positive divisor removes floor(log2(divisor)) magnitude
                # bits, including the asymmetric negative signed endpoint.
                loop divisor >? 1 {
                    bits-=1
                    divisor=divisor >> 1
                }
                result=max(1 bits) * 2 + WidthWord(int64(divisor >? 0 and a & 1 not=? 0))
            }
        }
        if op =? 'percent' and dewy_at(nodes.ptr[n].pos) {
            let [known divisor]=integer_constant(b0)
            if known and divisor >? 0 and b >? 0 {result=b}
        }
    }
    # Stored remainders and masks still carry a small range into a wider
    # surrounding expression, even when the operation itself needed no widening.
    if k =? 'binary' and nodes.ptr[n].aux =? 0 and not exact_has_node(n) and dewy_at(nodes.ptr[n].pos) and is_int(t) and t not=? T_MATH_INT {
        let op=exact_width_op(n)
        if op =? 'percent' or op =? 'amp' {
            let b0=WidthWord(nodes.ptr[n].b)
            let [known limit]=integer_constant(b0)
            if known and limit >? 0 {
                let width=WidthWord(exact_type_width(b0))
                if width >? 0 {result=width}
            }
        }
    }
    # A literal right shift consumes high signed bits even when its source
    # is an ordinary stored word. Keep this fact at the demanded consumer.
    if k =? 'binary' and exact_width_op(n) =? 'shr' and nodes.ptr[n].aux =? 0 and dewy_at(nodes.ptr[n].pos) and is_int(t) and t not=? T_MATH_INT and int_policy(t) =? 0 {
        let [known count]=integer_constant(WidthWord(nodes.ptr[n].b))
        if known and count >=? 0 and count <? 64 {
            let a=WidthWord(exact_type_width(WidthWord(nodes.ptr[n].a)))
            if a >? 0 {result=max(1 (a >> 1) - count) * 2 + (a & 1)}
        }
    }
    let [mid_lo mid_hi]=exact_midpoint(n)
    if mid_lo not=? 0 {result=128}
    exact_type_widths[n]=int64(result)
    result
}

# The exact midpoint lo + floor((hi-lo)/2) is floor((lo+hi)/2),
# hence remains a signed word even when the difference needs 65 bits.
# Match only repeated plain local reads: no calls, aliases, or reordered effects.
exact_midpoint=(n:WidthWord):>[int64 int64]=>$unsafe {
    let empty:[int64 int64]=[0 0]
    if nodes.ptr[n].kind not=? 'binary' or nodes.ptr[n].aux not=? 0 or exact_width_op(n) not=? 'plus' or not dewy_at(nodes.ptr[n].pos) {return empty}
    let lo=WidthWord(nodes.ptr[n].a)
    let quotient=WidthWord(nodes.ptr[n].b)
    if nodes.ptr[quotient].kind not=? 'binary' or nodes.ptr[quotient].aux not=? 0 or nodes.ptr[quotient].aux2 not=? -1 or exact_width_op(quotient) not=? 'slash' {return empty}
    let divisor=WidthWord(nodes.ptr[quotient].b)
    if nodes.ptr[divisor].kind not=? 'int_lit' or nodes.ptr[divisor].ival not=? 2 {return empty}
    let difference=WidthWord(nodes.ptr[quotient].a)
    if nodes.ptr[difference].kind not=? 'binary' or nodes.ptr[difference].aux not=? 0 or exact_width_op(difference) not=? 'minus' {return empty}
    let hi=WidthWord(nodes.ptr[difference].a)
    let repeated=WidthWord(nodes.ptr[difference].b)
    loop value in [lo hi repeated] {
        if nodes.ptr[value].kind not=? 'ident' or nodes.ptr[value].aux not=? WIDTH_SK_LOCAL or ntype(value) not=? T_INT {return empty}
        let fl=WidthWord(locals.ptr[WidthWord(nodes.ptr[value].sym)].flags)
        if fl & (LF_MUTPARAM | LF_CAPTURE | LF_ALIAS | LF_BYREF | LF_ADDR | LF_SHARED | LF_EXPOSED) not=? 0 {return empty}
    }
    if nodes.ptr[lo].sym not=? nodes.ptr[repeated].sym {return empty}
    [int64(lo) int64(hi)]
}

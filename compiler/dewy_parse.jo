# Dewy's syntax tree projected into the compact AST.
# This is an explicitly limited source-level experiment, not Sloppy syntax
# accepted under a different extension. Unknown Dewy forms fail at their source.
use 'util.jo'
use 'ast.jo'
use 'lex.jo'
use 'parse.jo'
use 'expr.jo'
use 'check.jo'
use 'dewy_tokens.jo'
use 'refine.jo'
use 'dewy_methods.jo'
use 'effects.jo'

# Compact tags shared by lexical tokens and syntax nodes. Names are needed
# only for formatter/diagnostic text.
enum DewyKind:
    unknown, op, identifier, boolean, metatag, based_string, integer, real,
    quoted, rawquoted, eof, atom, ambiguous, binary, block, combined_assignment,
    flat, flow, interpolated_string, inverted_comparison, keyword, keyword_expr,
    operator, postfix, prefix, string, string_chunk, source_integer, source_real,
    directive, compact_expr, compact_stmt

dw_kind_name = (kind: DewyKind) -> str:
    match kind:
        unknown: "Unknown"
        op: "op"
        identifier: "Identifier"
        boolean: "Bool"
        metatag: "Metatag"
        based_string: "BasedString"
        integer: "Integer"
        source_integer: "Integer"
        real: "Real"
        source_real: "Real"
        quoted: "quoted"
        rawquoted: "rawquoted"
        eof: "eof"
        atom: "Atom"
        ambiguous: "Ambiguous"
        binary: "BinOp"
        block: "Block"
        combined_assignment: "CombinedAssignmentOp"
        flat: "Flat"
        flow: "Flow"
        interpolated_string: "IString"
        inverted_comparison: "InvertedComparisonOp"
        keyword: "Keyword"
        keyword_expr: "KeywordExpr"
        operator: "Operator"
        postfix: "Postfix"
        prefix: "Prefix"
        string: "String"
        string_chunk: "StringChunk"
        directive: "Directive"
        compact_expr: "CompactExpression"
        compact_stmt: "CompactStatement"

struct DewySyntax:
    kind: DewyKind
    text: str
    pos: int
    children: int[]
    symbol: DewyToken = .none
    name: i32 = 0
    # Binary nodes keep their sentinel and operands inline; other nodes use children.
    child_mode: int = 0
    child_left: int = 0
    child_right: int = 0

dewy_syntax: DewySyntax[]
dw_index_context: int[]  # enclosing index nodes, for contextual `end`

dw_child = (id: int, at: int) -> int:
    mode = dewy_syntax[id].child_mode
    if mode == 0: return dewy_syntax[id].children[at]
    if at == 0: return mode - 1
    if at == 1: return dewy_syntax[id].child_left
    dewy_syntax[id].child_right

dw_children = (id: int) -> int[]:
    if dewy_syntax[id].child_mode == 0: return dewy_syntax[id].children
    [dewy_syntax[id].child_mode - 1, dewy_syntax[id].child_left, dewy_syntax[id].child_right]

dw_nchildren = (id: int) -> int:
    if dewy_syntax[id].child_mode != 0: return 3
    dewy_syntax[id].children.len()

dw_multiplications = (id: int) -> int:
    score = if dewy_syntax[id].text == "MultiplyJuxtapose": 1 else: 0
    loop child in dw_children(id): score += dw_multiplications(child)
    score

dw_unwrap = (id: int) -> int:
    let id = id
    loop true:
        if dewy_syntax[id].kind == .atom: id = dw_child(id, 0)
        else if dewy_syntax[id].kind == .ambiguous:
            best = -1
            score = 1000000000
            tied = false
            loop child in dw_children(id):
                next = dw_multiplications(child)
                if next < score:
                    best = child
                    score = next
                    tied = false
                else if next == score: tied = true
            if best < 0 or tied: return dw_fail(id, "an ambiguous expression; use explicit multiplication or parentheses")
            id = best
        else: return id
    id
dw_name = (id: int) -> str:
    let id = dw_unwrap(id)
    if dewy_syntax[id].kind == .identifier: return dewy_syntax[id].text
    ""
# Lexer-interned names pass straight into the compact AST. Legacy and synthetic
# identifier nodes fill this cache on their first use.
dw_name_id = (id: int) -> i32:
    let id = dw_unwrap(id)
    if dewy_syntax[id].kind != .identifier: return 0
    if dewy_syntax[id].name == 0: dewy_syntax[id].name = i32(intern(dewy_syntax[id].text))
    dewy_syntax[id].name

# The compact name of a Dewy identifier used as a value (printl is the library's print).
dw_renamed: int[]               # printl, print, int and the compact names they become
dw_value_name = (name: i32, pos: int) -> i32:
    if dw_renamed.len() == 0: dw_renamed = [intern("printl"), intern("print"), intern("print"), intern("__dewy_print"), intern("int"), intern("__dewy_int")]
    if int(name) == dw_renamed[0]: return i32(dw_renamed[1])
    if int(name) == dw_renamed[2]: return i32(dw_renamed[3])
    if int(name) == dw_renamed[4]: return i32(dw_renamed[5])
    name

# Inside a method, a bare name of one of the object's fields or methods is that member
# of the instance (there is no `self`): it reads through the method's hidden receiver
# parameter. Maps a member name to that receiver's name; locals and parameters shadow it.
dw_siblings: {int: int} = {}
dw_receivers_used: {int: bool} = {}   # receivers a method body reached
dw_pending_decls: int[]               # methods of the type just declared, as module functions

dw_receiver_field = (receiver: int, name: i32, pos: int) -> int:
    dw_receivers_used[receiver] = true
    base = mk(.ident, pos)
    nodes[base].name = i32(receiver)
    n = mk(.field, pos)
    nodes[n].a = i32(base)
    nodes[n].name = name
    n

dw_value_ident = (name: i32, pos: int) -> int:
    if dw_siblings.len() > 0:
        if let receiver = dw_siblings.get(int(name)): return dw_receiver_field(receiver, name, pos)
    n = mk(.ident, pos)
    nodes[n].name = dw_value_name(name, pos)
    n

# Names bound from here on hide the members of the same name.
dw_shadow = (names: int[]):
    if dw_siblings.len() == 0: return
    hidden = false
    loop name in names:
        if dw_siblings.has(name): hidden = true
    if not hidden: return
    visible: {int: int} = {}
    loop name, receiver in dw_siblings:
        if not names.contains(name): visible[name] = receiver
    dw_siblings = visible

# The direct expression frontend builds compact nodes before any method is known:
# rewrite its member names in place.
dw_rewrite_members = (n: int):
    if n == 0: return
    k = nodes[n].kind
    if k == .ident:
        if let receiver = dw_siblings.get(int(nodes[n].name)):
            field = dw_receiver_field(receiver, nodes[n].name, nodes[n].pos)
            nodes[field].flags = nodes[n].flags
            nodes[n] = nodes[field]
        return
    dw_rewrite_members(int(nodes[n].a))
    if k == .field: return
    # A member call's receiver may be a place, as the direct frontend marks it.
    if k == .call and nodes[int(nodes[n].a)].kind == .field: add_flag(int(nodes[int(nodes[n].a)].a), NF_MUT)
    dw_rewrite_members(int(nodes[n].b))
    loop child in kids(n): dw_rewrite_members(child)

# `name = (params) => body` among an object's rows: a method.
dw_method_row = (id: int) -> bool:
    let id = dw_unwrap(id)
    if dw_op(id) != .assign: return false
    if dewy_syntax[dw_unwrap(dw_child(id, 1))].kind != .identifier: return false
    dw_op(dw_grouped(dw_child(id, 2))) == .function

# The names of an object's rows, in order.
dw_row_names = (rows: int[]) -> int[]:
    out: int[]
    loop row in rows:
        item = dw_unwrap(row)
        lhs = item
        if dw_op(item) == .assign: lhs = dw_child(item, 1)
        if dw_op(lhs) == .colon: lhs = dw_child(lhs, 1)
        if dw_op(lhs) == .at: lhs = dw_child(lhs, 1)
        name = dw_name_id(lhs)
        if name != 0: out.push(int(name))
    out

# A method's receiver comes first. Its type is the object's (the type parameter
# `object_type` for a record literal's method); whether it is a place is inferred
# from the body before checking (dewy_methods.jo).
dw_add_receiver = (fn_: int, receiver: int, receiver_type: int):
    param = mk(.param, nodes[fn_].pos)
    nodes[param].name = i32(receiver)
    nodes[param].a = i32(receiver_type)
    set_list(fn_, [param] + kids(fn_))

dw_op = (id: int) -> DewyToken:
    let id = dw_unwrap(id)
    kind = dewy_syntax[id].kind
    if kind != .binary and kind != .prefix and kind != .postfix and kind != .flat: return .none
    symbol = dewy_syntax[id].symbol
    if symbol != .none: return symbol
    # Otherwise the operator is represented as a child node.
    if kind == .binary and dewy_syntax[dw_child(id, 0)].kind == .combined_assignment:
        return dn_token_kind(dewy_syntax[dw_child(dw_child(id, 0), 0)].text + "=")
    dewy_syntax[dw_child(id, 0)].symbol

dw_fail = (id: int, what: str) -> int:
    fatal(dewy_syntax[id].pos, "Dewy core experiment does not yet support {what}")
    0

# Metatags the design defines that this compiler does not implement yet. Each
# is reported where it is written rather than as a generic syntax error.
dw_designed_directive = (name: str) -> bool:
    name in ["abstract", "allocator", "breakpoint", "expect", "fail", "field", "lend", "no_prelude", "proof", "prototype", "prototype_warnings", "supported_targets", "target", "test", "unsafe_assume", "__copy__", "__drop__", "__move__"]

dw_unimplemented = (id: int, name: str) -> int:
    fatal(dewy_syntax[id].pos, "`${name}` is part of the design but not implemented yet")
    0

# A metatag where no metatag form fits: name the directive precisely.
dw_metatag_fail = (id: int) -> int:
    name = dewy_syntax[id].text
    pos = dewy_syntax[id].pos
    if name == "explicit_copies": fatal(pos, "`$explicit_copies` is a module directive; put it at file scope")
    if dw_designed_directive(name): return dw_unimplemented(id, name)
    if name == "capture": fatal(pos, "`$capture` belongs in a parameter list before a name: `($capture @count) => ...`")
    if name == "include_bytes": fatal(pos, "`$include_bytes` takes one path literal: `$include_bytes(p\"asset.png\") as image`")
    fatal(pos, "unknown directive `${name}` (a loop label goes on its own line just before its loop)")
    0

# `$assert`/`$runtime_assert` become calls of internal intrinsics whose names
# no program can shadow; unimplemented directive forms are reported here.
dw_directive = (id: int) -> int:
    name = dewy_syntax[id].text
    pos = dewy_syntax[id].pos
    if name != "assert" and name != "runtime_assert": return dw_unimplemented(id, name)
    condition = dw_child(id, 0)
    message = dw_child(id, 1)
    args = [dw_expr(condition)]
    if message != 0:
        if name == "assert" and dewy_syntax[dw_unwrap(message)].kind != .string: fatal(dewy_syntax[message].pos, "a `$assert` message is a string literal: the compiler reports it")
        args.push(dw_expr(message))
    else if name == "runtime_assert":
        text = mk(.str_lit, pos)
        nodes[text].sval = i32(intern("assertion failed: " + join(words(dewy_syntax[dw_child(id, 2)].text), " ")))
        args.push(text)
    callee = mk(.ident, pos)
    nodes[callee].name = i32(intern("$" + name))
    call = mk(.call, pos)
    nodes[call].a = i32(callee)
    set_list(call, args)
    call

# The syntax parser has already recognized the digits and base. Accumulate with
# an explicit limit so neither overflow nor a high unsigned bit changes a value.
dw_digits = (text: str) -> str:
    digits = text[3..]
    if starts_with(lower(digits), text[..2)): digits = digits[2..]
    digits

dw_alphabet = (text: str, id: int) -> str:
    alphabet = ""
    match text[..3):
        "0b:": alphabet = "01"
        "0t:": alphabet = "012"
        "0q:": alphabet = "0123"
        "0s:": alphabet = "012345"
        "0o:": alphabet = "01234567"
        "0d:": alphabet = "0123456789"
        "0z:": alphabet = "0123456789xe"
        "0x:": alphabet = "0123456789abcdef"
        _: dw_fail(id, "this numeric base")
    alphabet

dw_integer_kind = (kind: DewyKind) -> bool:
    kind == .integer or kind == .source_integer

dw_unsigned = (text: str, id: int) -> u64?:
    if dewy_syntax[id].kind == .source_integer:
        value: u64 = 0
        loop c in text:
            if c == '_': continue
            digit = u64(c - '0')
            if value > 1844674407370955161 or (value == 1844674407370955161 and digit > 5): return none
            value = value * 10 + digit
        return value
    alphabet = dw_alphabet(text, id)
    base = u64(len(alphabet))
    value: u64 = 0
    loop c in lower(dw_digits(text)):
        if c == '_': continue
        digit = find_byte(alphabet, c)
        if digit < 0: fatal(dewy_syntax[id].pos, "invalid numeric digit")
        if value > (0xFFFFFFFFFFFFFFFF - u64(digit)) / base:
            return none
        value = value * base + u64(digit)
    value

# Only modules that use a large literal import the exact-integer library. The
# alias contains a character that cannot occur in a user identifier.
dw_bigint_import = 0
const DW_BIGINT_ALIAS = "$dewy_bigint"

dw_finish_declarations = (declarations: int[]) -> int[]:
    if dw_bigint_import == 0: return declarations
    [dw_bigint_import] + declarations

dw_bigint_value = (limbs: u64[], pos: int, negative: bool = false) -> int:
    if dw_bigint_import == 0:
        dw_bigint_import = mk(.import_, pos)
        nodes[dw_bigint_import].aux2 = 1
        nodes[dw_bigint_import].sval = i32(intern("@lib/bigint.dewy"))
        nodes[dw_bigint_import].name = i32(intern(DW_BIGINT_ALIAS))
    owner = mk(.ident, pos)
    nodes[owner].name = i32(intern(DW_BIGINT_ALIAS))
    callee = mk(.field, pos)
    nodes[callee].a = i32(owner)
    nodes[callee].name = i32(intern("BigInt"))
    sign = mk(.int_lit, pos)
    nodes[sign].ival = if negative: -1 else: 1
    add_flag(sign, NF_LITERAL)
    sign_arg = mk(.namedarg, pos)
    nodes[sign_arg].name = i32(intern("_sign"))
    nodes[sign_arg].a = i32(sign)
    items: int[]
    loop limb in limbs:
        item = mk(.int_lit, pos)
        nodes[item].ival = int(limb)
        add_flag(item, NF_LITERAL)
        items.push(item)
    magnitude = mk(.array, pos)
    set_list(magnitude, items)
    magnitude_arg = mk(.namedarg, pos)
    nodes[magnitude_arg].name = i32(intern("_limbs"))
    nodes[magnitude_arg].a = i32(magnitude)
    result = mk(.call, pos)
    nodes[result].a = i32(callee)
    set_list(result, [sign_arg, magnitude_arg])
    nodes[result].aux2 = -1       # oversized literal; the checker requires an explicit BigInt context
    result

dw_big_integer = (text: str, id: int) -> int:
    decimal = dewy_syntax[id].kind == .source_integer
    alphabet = if decimal: "0123456789" else: dw_alphabet(text, id)
    digits = if decimal: text else: lower(dw_digits(text))
    base = u64(len(alphabet))
    limbs: u64[]
    loop c in digits:
        if c == '_': continue
        digit = find_byte(alphabet, c)
        if digit < 0: fatal(dewy_syntax[id].pos, "invalid numeric digit")
        carry = u64(digit)
        loop i in [0..limbs.len()):
            word = limbs[i] * base + carry
            limbs[i] = word & 0xFFFFFFFF
            carry = word >> 32
        if carry != 0: limbs.push(carry)
    dw_bigint_value(limbs, dewy_syntax[id].pos)

# Power-of-two based strings pack digits most-significant-bit first. The final
# partial byte is zero padded, as in the existing Dewy literal design.
dw_binary = (id: int) -> int:
    text = dewy_syntax[id].text
    prefix = text[..3)
    alphabet = ""
    width = 0
    match prefix:
        "0b:": alphabet = "01"; width = 1
        "0q:": alphabet = "0123"; width = 2
        "0o:": alphabet = "01234567"; width = 3
        "0x:": alphabet = "0123456789abcdef"; width = 4
        "0u:": alphabet = "0123456789abcdefghijklmnopqrstuv"; width = 5
        "0g:": alphabet = "0123456789abcdefghijklmnopqrstuvwxyzABCDEFGHIJKLMNOPQRSTUVWXYZ+/"; width = 6
        _: return dw_fail(id, "this based-string packing")
    digits = text[3..]
    if width != 6: digits = lower(digits)
    pending = 0
    bits = 0
    padded = false
    packed: u8[]
    loop c in digits:
        if c == '_' and width != 6: continue
        if c == '=' and width == 6: padded = true; continue
        if padded: fatal(dewy_syntax[id].pos, "based-string padding must be at the end")
        digit = find_byte(alphabet, c)
        if width == 6 and c == '-': digit = 62
        if width == 6 and c == '_': digit = 63
        if digit < 0: fatal(dewy_syntax[id].pos, "invalid based-string digit")
        pending = (pending << width) | digit
        bits += width
        if bits >= 8:
            bits -= 8
            packed.push(u8(pending >> bits))
            pending &= (1 << bits) - 1
    if bits > 0: packed.push(u8(pending << (8 - bits)))
    pos = dewy_syntax[id].pos
    value = mk(.str_lit, pos)
    nodes[value].sval = i32(intern(str_from_bytes(packed)))
    callee = mk(.ident, pos)
    nodes[callee].name = i32(intern("bytes"))
    call = mk(.call, pos)
    nodes[call].a = i32(callee)
    set_list(call, [value])
    call

dw_is_include = (id: int) -> bool:
    if not dn_token_call(dw_op(id)): return false
    tag = dw_unwrap(dw_child(id, 1))
    dewy_syntax[tag].kind == .metatag and dewy_syntax[tag].text == "include_bytes"

dw_include = (id: int) -> int:
    arg = dw_unwrap(dw_child(id, 2))
    if dewy_syntax[arg].kind != .block or dw_nchildren(arg) != 1:
        return dw_fail(id, "$include_bytes without one literal path")
    path = dw_unwrap(dw_child(arg, 0))
    if dw_op(path) != .call or dw_name(dw_child(path, 1)) != "p":
        return dw_fail(path, "$include_bytes without a p\"path\" literal")
    path = dw_unwrap(dw_child(path, 2))
    if dewy_syntax[path].kind != .string: return dw_fail(path, "a nonliteral asset path")
    callee = mk(.ident, dewy_syntax[id].pos)
    nodes[callee].name = i32(intern("embed"))
    call = mk(.call, dewy_syntax[id].pos)
    nodes[call].a = i32(callee)
    set_list(call, [dw_expr(path)])
    call

# Annotation membership retains its exact endpoint flags; ordinary membership
# may lower an exclusive-start range to a runtime range object.
dw_ref_predicate = (id: int) -> int:
    entry = dw_grouped(id)
    op = dw_op(entry)
    if op == .kw_and:
        n = mk(.and_, dewy_syntax[entry].pos)
        nodes[n].a = i32(dw_ref_predicate(dw_child(entry, 1)))
        nodes[n].b = i32(dw_ref_predicate(dw_child(entry, 2)))
        return n
    if op == .contains:
        n = mk(.binary, dewy_syntax[entry].pos)
        nodes[n].op = i32(int(Tok.kw_in))
        nodes[n].a = i32(dw_expr(dw_child(entry, 1)))
        nodes[n].b = i32(dw_iterable(dw_child(entry, 2), true, true))
        return n
    dw_expr(entry)

# Effect suffixes belong to the callable, never to the returned value type.
# sval on fn_/lambda/tfn is an immutable syntax-row ID; clone preserves it.
dw_effect_path = (id0: int) -> int[]:
    id = dw_unwrap(id0)
    if dw_op(id) == .dot:
        out = dw_effect_path(dw_child(id, 1))
        name = dw_name(dw_child(id, 2))
        if name == "": fatal(dewy_syntax[id].pos, "effect projection needs a field name")
        out.push(intern(name))
        return out
    name = dw_name(id)
    if name == "": fatal(dewy_syntax[id].pos, "effect row needs a place name")
    [intern(name)]

dw_effect_atom = (id0: int, entries: mut EffectSyntax[], empty: mut bool):
    id = dw_unwrap(id0)
    if dw_name(id) == "no_effects":
        if empty or entries.len() != 0: fatal(dewy_syntax[id].pos, "no_effects cannot be combined with another effect permission")
        empty = true
        return
    if empty: fatal(dewy_syntax[id].pos, "no_effects cannot be combined with another effect permission")
    if dw_op(id) != .type_apply: fatal(dewy_syntax[id].pos, "effect pilot requires reads<place>, mutates<place>, or no_effects")
    name = dw_name(dw_child(id, 1))
    if name != "reads" and name != "mutates": fatal(dewy_syntax[id].pos, "effect pilot requires reads<place>, mutates<place>, or no_effects")
    args = dw_child(id, 2)
    if dw_nchildren(args) != 1: fatal(dewy_syntax[id].pos, "effect permission needs exactly one place")
    kind = if name == "reads": EffectKind.read else: EffectKind.write
    entries.push(EffectSyntax(kind, dw_effect_path(dw_child(args, 0)), dewy_syntax[id].pos))

dw_effect_result = (id: int, entries: mut EffectSyntax[], empty: mut bool) -> int:
    if dw_op(id) != .amp: return id
    # Scalar refinement intersection is still part of the return type.
    if dw_op(dw_grouped(dw_child(id, 2))) == .tilde: return id
    base = dw_effect_result(dw_child(id, 1), entries, empty)
    dw_effect_atom(dw_child(id, 2), entries, empty)
    base

dw_effect_suffix = (owner: int, result: int) -> int:
    entries: EffectSyntax[]
    empty = false
    base = dw_effect_result(result, entries, empty)
    if base != result:
        effects_active = true
        effect_syntax.push(entries)
        nodes[owner].sval = i32(effect_syntax.len() - 1)
    base

# Surface type spellings share one translation in both construction paths.
dw_type_name = (name: str) -> str:
    if name == "int64": return "i64"
    else if name == "uint64": return "u64"
    else if name == "int32": return "i32"
    else if name == "uint32": return "u32"
    else if name == "int16": return "i16"
    else if name == "uint16": return "u16"
    else if name == "int8": return "i8"
    else if name == "uint8": return "u8"
    else if name == "float64": return "f64"
    else if name == "float32": return "f32"
    else if name == "string": return "str"
    else if name == "set": return "Set"
    else if name == "int": return "__dewy_int"
    name

dw_type = (id: int) -> int:
    let id = dw_unwrap(id)
    pos = dewy_syntax[id].pos
    if dewy_syntax[id].kind == .metatag: return dw_metatag_fail(id)
    name = dw_name(id)
    if name != "":
        if name == "uint": return dw_fail(id, "unbounded uint is not yet supported; use an explicit fixed width")
        name = dw_type_name(name)
        n = mk(.tname, pos)
        nodes[n].name = if name == dewy_syntax[id].text: dw_name_id(id) else: i32(intern(name))
        return n
    if dewy_syntax[id].kind == .block and dewy_syntax[id].text == "[]:":
        n = mk(.trecord, pos)
        fields: int[]
        loop child in dw_children(id):
            if dw_op(child) != .colon: return dw_fail(child, "an inline record field without a type; use a named record for defaults")
            field = dw_param(child, .vardecl)
            if has_flag(field, NF_MUT): return dw_fail(child, "a mutable inline record field; mutability belongs on the parameter")
            fields.push(field)
        set_list(n, fields)
        return n
    if dw_op(id) == .amp and dw_op(dw_grouped(dw_child(id, 2))) == .tilde:
        right = dw_grouped(dw_child(id, 2))
        n = mk(.trefined, pos)
        nodes[n].a = i32(dw_type(dw_child(id, 1)))
        binder = intern("$refinement")
        nodes[n].name = i32(binder)
        value = mk(.ident, pos)
        nodes[value].name = i32(binder)
        predicate = mk(.binary, pos)
        nodes[predicate].op = i32(int(Tok.ne))
        nodes[predicate].a = i32(value)
        nodes[predicate].b = i32(dw_expr(dw_child(right, 1)))
        nodes[n].b = i32(predicate)
        refine_active = true
        return n
    if dw_op(id) == .star or dw_op(id) == .slash or dw_op(id) == .caret:
        n = mk(.tquantity, pos)
        nodes[n].op = i32(int(if dw_op(id) == .star: Tok.star else if dw_op(id) == .slash: Tok.slash else: Tok.caret))
        nodes[n].a = i32(dw_type(dw_child(id, 1)))
        nodes[n].b = i32(if dw_op(id) == .caret: dw_expr(dw_child(id, 2)) else: dw_type(dw_child(id, 2)))
        return n
    if dw_op(id) == .pipe:
        n = mk(.tunion, pos)
        set_list(n, [dw_type(dw_child(id, 1)), dw_type(dw_child(id, 2))])
        return n
    if dewy_syntax[id].kind == .postfix and dw_op(id) == .question:
        n = mk(.topt, pos)
        nodes[n].a = i32(dw_type(dw_child(id, 1)))
        return n
    if dw_op(id) == .returns:
        params = dw_child(id, 1)
        if dewy_syntax[params].kind != .block or dewy_syntax[params].text != "():": return dw_fail(params, "this function type")
        n = mk(.tfn, pos)
        types_: int[]
        labels: int[]
        loop param in dw_children(params):
            p = dw_param(param, .param)
            if nodes[p].a == 0: return dw_fail(param, "an untyped parameter in a function type")
            if nodes[p].b != 0: return dw_fail(param, "defaults in a function type; declare defaults on a directly called function")
            t = int(nodes[p].a)
            if has_flag(p, NF_MUT): add_flag(t, NF_MUT)
            loop earlier in labels:
                if nodes[earlier].name == nodes[p].name and name_of(int(nodes[p].name)) != "_": fatal(nodes[p].pos, "duplicate callable parameter name '{name_of(int(nodes[p].name))}'")
            # Only the label belongs here; retaining its parameter subtree
            # would duplicate type/pattern cloning in generic callable types.
            nodes[p] = Node(kind = .ident, pos = nodes[p].pos, name = nodes[p].name)
            labels.push(p)
            types_.push(t)
        set_list(n, types_)
        set_list2(n, labels)
        result = dw_effect_suffix(n, dw_child(id, 2))
        if dw_name(result) != "void": nodes[n].a = i32(dw_type(result))
        return n
    if dw_op(id) == .dot:
        owner = dw_name(dw_child(id, 1))
        member = dw_name(dw_child(id, 2))
        if owner == "" or member == "": return dw_fail(id, "this qualified type")
        n = mk(.tname, pos)
        nodes[n].sval = i32(intern(owner))
        nodes[n].name = i32(intern(member))
        return n
    # Function types have one grouping spelling: `<(value:int64):>int64>`.
    if dewy_syntax[id].kind == .block and (dewy_syntax[id].text == "():" or dewy_syntax[id].text == "<>:") and dw_nchildren(id) == 1:
        inner = dw_child(id, 0)
        if dewy_syntax[id].text == "():" and dw_op(inner) == .returns:
            fatal(pos, "function types use angle brackets: replace the outer (...) with <...>, as in `<(x:int64):>int64>`")
        return dw_type(inner)
    if dw_op(id) == .type_apply and dw_name(dw_child(id, 1)) == "array":
        args = dw_child(id, 2)
        count = dw_nchildren(args)
        if count < 1 or count > 2: return dw_fail(id, "array type constraints; use array<T> or array<T length=N>")
        n = mk(.tarray, pos)
        nodes[n].a = i32(dw_type(dw_child(args, 0)))
        if count == 2:
            constraint = dw_child(args, 1)
            if dw_op(constraint) != .assign or dw_name(dw_child(constraint, 1)) != "length":
                return dw_fail(constraint, "array type constraints; the supported constraint is length=N")
            nodes[n].b = i32(dw_expr(dw_child(constraint, 2)))
        return n
    if dw_op(id) == .type_apply and dw_name(dw_child(id, 1)) == "dict":
        args = dw_child(id, 2)
        if dw_nchildren(args) != 2: return dw_fail(id, "dictionary type constraints")
        n = mk(.tmap, pos)
        nodes[n].a = i32(dw_type(dw_child(args, 0)))
        nodes[n].b = i32(dw_type(dw_child(args, 1)))
        return n
    if dw_op(id) == .type_apply:
        entries = dw_children(dw_child(id, 2))
        base = dw_type(dw_child(id, 1))
        args: int[]
        loop child in entries:
            entry = dw_grouped(child)
            op = dw_op(entry)
            condition = op == .function or op == .kw_and or op == .eq or op == .not_eq or op == .lt or op == .le or op == .gt or op == .ge or op == .contains
            if condition:
                refine_active = true
                n = mk(.trefined, dewy_syntax[entry].pos)
                nodes[n].a = i32(base)
                if op == .function:
                    parameter = dw_grouped(dw_child(entry, 1))
                    if dw_name(parameter) == "": return dw_fail(parameter, "refinement lambda needs one value binder")
                    nodes[n].name = dw_name_id(parameter)
                    entry = dw_child(entry, 2)
                nodes[n].b = i32(dw_ref_predicate(entry))
                base = n
            else: args.push(dw_type(child))
        if args.len() > 0:
            if nodes[base].kind != .tname or nkids(base) != 0: return dw_fail(id, "type arguments on this type expression")
            set_list(base, args)
        return base
    return dw_fail(id, "this type expression")

# Type parameters use the existing compact specialization machinery. Constraints
# are not silently ignored: this slice accepts only distinct parameter names.
dw_type_params = (id: int) -> int[]:
    out: int[]
    seen: str[]
    loop child in dw_children(id):
        name = dw_name(child)
        if name == "" or name == "of": return [dw_fail(child, "constrained type parameters; use plain type parameter names")]
        if seen.contains(name): fatal(dewy_syntax[child].pos, "duplicate type parameter '{name}'")
        seen.push(name)
        n = mk(.ident, dewy_syntax[child].pos)
        nodes[n].name = dw_name_id(child)
        out.push(n)
    if out.len() == 0: return [dw_fail(id, "an empty type parameter declaration")]
    out

dw_param = (id: int, kind: NK) -> int:
    let id = id
    pos = dewy_syntax[id].pos
    initial = 0
    if dw_op(id) == .assign:
        initial = dw_child(id, 2)
        id = dw_child(id, 1)
    lhs = id
    annotation = 0
    if dw_op(id) == .colon:
        lhs = dw_child(id, 1)
        annotation = dw_child(id, 2)
    else if kind == .vardecl and initial == 0: return dw_fail(id, "a field without a type or default")
    by_place = dw_op(lhs) == .at
    if by_place: lhs = dw_child(lhs, 1)
    if dewy_syntax[dw_unwrap(lhs)].kind == .metatag: return dw_metatag_fail(dw_unwrap(lhs))
    name = dw_name(lhs)
    pattern = kind == .param and dewy_syntax[lhs].kind == .block and dewy_syntax[lhs].text == "[]:"
    if name == "" and not pattern: return dw_fail(lhs, "this parameter or field")
    if pattern and by_place: return dw_fail(lhs, "unpacking a mutable parameter; use a named @ parameter")
    n = mk(kind, pos)
    if pattern:
        name = "$parameter{n}"
        set_list(n, dw_bindings(lhs))
    nodes[n].name = if pattern: i32(intern(name)) else: dw_name_id(lhs)
    if annotation != 0: nodes[n].a = i32(dw_type(annotation))
    if initial != 0: nodes[n].b = i32(dw_expr(initial))
    if by_place: add_flag(n, NF_MUT)
    return n

dw_function = (id: int, name: str) -> int:
    signature = dw_child(id, 1)
    params = signature
    result = 0
    if dw_op(signature) == .returns:
        params = dw_child(signature, 1)
        result = dw_child(signature, 2)
    if dw_op(params) == .call and dewy_syntax[dw_child(params, 1)].text == "[]:":
        return dw_fail(params, "a separate capture list; use ($capture @name) in the parameter list")
    type_params: int[]
    if dw_op(params) == .call and dewy_syntax[dw_child(params, 1)].text == "<>:":
        type_params = dw_type_params(dw_child(params, 1))
        params = dw_child(params, 2)
    if dewy_syntax[params].kind != .block or dewy_syntax[params].text != "():": return dw_fail(params, "this parameter list")
    n = mk(if name == "": NK.lambda else: NK.fn_, dewy_syntax[id].pos)
    nodes[n].name = i32(intern(name))
    if type_params.len() > 0:
        if name == "main": return dw_fail(id, "a generic entry point")
        set_list2(n, type_params)
        add_flag(n, NF_GENERIC)
    if result != 0:
        result = dw_effect_suffix(n, result)
        if dw_name(result) == "void": add_flag(n, NF_VOID)
        else: nodes[n].a = i32(dw_type(result))
    ps: int[]
    captures: int[]
    capture = false
    bound: {int: bool} = {}
    loop p in dw_children(params):
        if dewy_syntax[p].kind == .metatag:
            if dewy_syntax[p].text != "capture":
                if dw_designed_directive(dewy_syntax[p].text): return dw_metatag_fail(p)
                fatal(dewy_syntax[p].pos, "unknown parameter modifier `${dewy_syntax[p].text}` (the one modifier is `$capture`)")
            if capture: return dw_fail(p, "$capture without a local name")
            if name != "": return dw_fail(p, "$capture on a module function")
            capture = true
            continue
        if capture:
            target = if dw_op(p) == .at: dw_child(p, 1) else: p
            nm = dw_name(target)
            if nm == "" or nm == "_": return dw_fail(p, "a capture other than an enclosing local name")
            cap = dw_expr(target)
            if nodes[cap].kind != .ident: fatal(dewy_syntax[target].pos, "'{nm}' is a member of this object, which the method already reaches by name; `$capture` takes an enclosing local")
            if dw_op(p) == .at: add_flag(cap, NF_MUT)
            if bound.has(int(nodes[cap].name)): fatal(nodes[cap].pos, "duplicate parameter binding '{nm}'")
            bound[int(nodes[cap].name)] = true
            captures.push(cap)
            capture = false
            continue
        param = dw_param(p, .param)
        let bound_nodes = if nkids(param) > 0: binding_leaves(kids(param)) else: [param]
        loop binding in bound_nodes:
            nm = int(nodes[binding].name)
            if name_of(nm) == "_": continue
            if bound.has(nm): fatal(nodes[binding].pos, "duplicate parameter binding '{name_of(nm)}'")
            bound[nm] = true
        ps.push(param)
    if capture: return dw_fail(params, "$capture without a local name")
    outer_siblings = dw_siblings
    if dw_siblings.len() > 0 and bound.len() > 0:
        hidden: int[]
        loop nm, seen in bound: hidden.push(nm)
        dw_shadow(hidden)
    if captures.len() > 0:
        if type_params.len() > 0:
            caplist = mk(.block, nodes[n].pos)
            set_list(caplist, captures)
            nodes[n].d = i32(caplist)
        else: set_list2(n, captures)
    body = dw_block(dw_child(id, 2))
    dw_siblings = outer_siblings
    prefix: int[]
    loop param in ps:
        if has_flag(param, NF_MUT) or name_of(int(nodes[param].name)) == "_": continue
        local = mk(.vardecl, nodes[param].pos)
        nodes[local].aux2 = 1   # synthesized value-parameter binding
        nodes[local].name = nodes[param].name
        if nkids(param) > 0: set_list(local, kids(param))
        value = mk(.ident, nodes[param].pos)
        nodes[value].name = nodes[param].name
        nodes[value].aux2 = 1   # the parameter's value itself, even a function
        if name == "main":
            if ps.len() != 1: return dw_fail(id, "multiple entry-point parameters")
            nodes[value].name = i32(intern("args"))
            call = mk(.call, nodes[param].pos)
            nodes[call].a = i32(value)
            value = call
            nodes[local].a = nodes[param].a
        nodes[local].b = i32(value)
        prefix.push(local)
    if name == "main":
        loop param in ps:
            if has_flag(param, NF_MUT): return dw_fail(id, "a mutable entry-point parameter")
        ps = []
    set_list(n, ps)
    loop statement in kids(body): prefix.push(statement)
    set_list(body, prefix)
    nodes[n].b = i32(body)
    return n

dw_binary_token = (op: DewyToken, id: int) -> Tok:
    match op:
        plus: .plus
        minus: .minus
        star, multiply_apply: .star
        slash: .slash
        percent: .percent
        eq: .eq
        not_eq: .ne
        contains: .kw_in
        lt: .lt
        le: .le
        gt: .gt
        ge: .ge
        shl: .shl
        shr: .shr
        kw_and, amp: .amp
        kw_or, pipe: .pipe
        kw_xor: .caret
        _:
            dw_fail(id, "operator '{dn_token_text(op)}'")
            .eof

# Reuse the fused array lowering, with Dewy's scalar arithmetic inside it.
# In particular, integer ./ stays exact division and .// rounds downward.
dw_broadcast = (op: DewyToken, a: int, b: int, id: int) -> int:
    pos = dewy_syntax[id].pos
    if (op == .slash or op == .floor or op == .percent or op == .caret):
        name = if op == .slash: "__dewy_divide" else if op == .floor: "__floor_div" else if op == .percent: "__floor_mod" else: "__dewy_power"
        n = bc_call(name, [a, b], pos)
        add_flag(n, NF_BROADCAST)
        return n
    spelling = dn_token_uninvert(op)
    inverted = spelling != op
    if not (spelling == .plus or spelling == .minus or spelling == .star or spelling == .eq or spelling == .lt or spelling == .le or spelling == .gt or spelling == .ge): return dw_fail(id, "broadcast operator '.{dn_token_text(op)}'")
    n = mk(.binary, pos)
    nodes[n].op = i32(int(Tok.dotop))
    nodes[n].aux = i32(dn_token_text(spelling)[0])
    nodes[n].aux2 = if spelling == .le or spelling == .ge: 1 else: 0
    nodes[n].ival = int(inverted)
    nodes[n].a = i32(a)
    nodes[n].b = i32(b)
    return n

# Computed names are expressions, resolved by the checker in an instantiated scope.
dw_field_name = (id: int) -> int:
    let id = dw_unwrap(id)
    if not dn_token_call(dw_op(id)): return 0
    callee = dw_child(id, 1)
    if dewy_syntax[callee].kind != .metatag or dewy_syntax[callee].text != "field": return 0
    args = dewy_syntax[dw_child(id, 2)].children
    if args.len() != 1: fatal(dewy_syntax[id].pos, "`$field` needs one compile-time string")
    dw_expr(args[0])

dw_record_entry = (id: int) -> int:
    if dw_op(id) != .assign: return dw_fail(id, "a record item without a field name and =")
    lhs = dw_child(id, 1)
    field = mk(.namedarg, dewy_syntax[id].pos)
    nodes[field].b = i32(dw_field_name(lhs))
    if nodes[field].b == 0:
        name = dw_name(lhs)
        if name == "": return dw_fail(lhs, "a record field without a name")
        nodes[field].name = i32(intern(name))
    nodes[field].a = i32(dw_expr(dw_child(id, 2)))
    field

# A function row of a record literal. One that reaches a member of the object becomes a
# method: a closure stored in the object (keeping what it captures), taking the object
# itself first. The object's type is a type parameter, so the record's type does not
# contain itself; each call supplies it.
dw_literal_method = (row: int, members: int[]) -> int:
    receiver = intern("$self{nodes.len()}")
    outer = dw_siblings
    inner: {int: int} = {}
    loop name, other in outer: inner[name] = other
    loop name in members: inner[name] = receiver
    dw_siblings = inner
    entry = dw_record_entry(row)
    dw_siblings = outer
    if not dw_receivers_used.has(receiver): return entry
    lambda = int(nodes[entry].a)
    if nodes[lambda].kind != .lambda: return dw_fail(row, "this method")
    object_type = mk(.ident, nodes[lambda].pos)
    nodes[object_type].name = i32(intern("$Object{receiver}"))
    if has_flag(lambda, NF_GENERIC): set_list2(lambda, [object_type] + kids2(lambda))
    else:
        captures = kids2(lambda)
        if captures.len() > 0:
            caplist = mk(.block, nodes[lambda].pos)
            set_list(caplist, captures)
            nodes[lambda].d = i32(caplist)
        set_list2(lambda, [object_type])
        add_flag(lambda, NF_GENERIC)
    receiver_type = mk(.tname, nodes[lambda].pos)
    nodes[receiver_type].name = nodes[object_type].name
    dw_add_receiver(lambda, receiver, receiver_type)
    entry

dw_register_literal_methods = (entries: int[]):
    row_names: int[]
    decls: int[]
    loop entry in entries:
        if nodes[entry].kind != .namedarg or nodes[entry].name == 0: continue
        value = int(nodes[entry].a)
        row_names.push(int(nodes[entry].name))
        decls.push(if nodes[value].kind == .lambda and dewy_is_method(value): value else: 0)
    dewy_method_group(row_names, decls)

dw_expr = (id: int) -> int:
    let id = dw_unwrap(id)
    k = dewy_syntax[id].kind
    text = dewy_syntax[id].text
    pos = dewy_syntax[id].pos
    if k == .compact_expr:
        if dw_siblings.len() > 0: dw_rewrite_members(dewy_syntax[id].child_left)
        return dewy_syntax[id].child_left
    if k == .based_string: return dw_binary(id)
    if k == .directive: return dw_directive(id)
    if k == .metatag: return dw_metatag_fail(id)
    if k == .identifier:
        if text == "none": return mk(.none_lit, pos)
        if text == "end" and dw_index_context.len() > 0:
            ix = dw_index_context[dw_index_context.len() - 1]
            base = "$index_end{ix}"
            nodes[ix].sval = i32(intern(base))
            axis = int(nodes[ix].aux2)
            name = if axis == 0: base else: "{base}_{axis}"
            return comp_ident(intern(name), pos)
        return dw_value_ident(dw_name_id(id), pos)
    if dw_integer_kind(k):
        if let value = dw_unsigned(text, id):
            n = mk(.int_lit, pos)
            nodes[n].ival = int(value)
            add_flag(n, NF_LITERAL)
            if nodes[n].ival < 0: add_flag(n, NF_U64)
            return n
        return dw_big_integer(text, id)
    if k == .real or k == .source_real:
        number = text
        if k == .real:
            parts = split(text, "|")
            if parts.len() != 3 or not starts_with(parts[0], "0d:"): return dw_fail(id, "this real literal")
            number = dw_digits(parts[0])
            if parts[1] != "":
                if not starts_with(parts[1], "0d:"): return dw_fail(id, "nondecimal real fractions")
                number = number + "." + dw_digits(parts[1])
            if parts[2] != "":
                exponent = parts[2]
                if exponent[1] != 'e' or not starts_with(exponent[2..], "0d:"):
                    return dw_fail(id, "nondecimal real exponents")
                number += "e" + exponent[..1) + dw_digits(exponent[2..])
        value = to_float(replace(number, "_", ""))
        if value == none: return dw_fail(id, "this real literal")
        n = mk(.float_lit, pos)
        nodes[n].fval = value!
        nodes[n].sval = i32(intern(replace(number, "_", "")))
        add_flag(n, NF_LITERAL)
        return n
    if k == .interpolated_string:
        n = mk(.str_lit, pos)
        nodes[n].aux = 1
        pieces: int[]
        loop child in dw_children(id):
            if dewy_syntax[child].kind == .string_chunk:
                part = mk(.str_lit, dewy_syntax[child].pos)
                nodes[part].sval = i32(intern(dewy_syntax[child].text))
                pieces.push(part)
            else:
                if dewy_syntax[child].kind != .block or dw_nchildren(child) != 1: return dw_fail(child, "this string interpolation")
                part = mk(.pair, dewy_syntax[child].pos)
                nodes[part].a = i32(dw_expr(dw_child(child, 0)))
                nodes[part].sval = -1
                pieces.push(part)
        set_list(n, pieces)
        return n
    if k == .boolean:
        n = mk(.bool_lit, pos)
        nodes[n].ival = if text == "true": 1 else: 0
        return n
    if k == .string:
        n = mk(.str_lit, pos)
        nodes[n].sval = i32(intern(text))
        return n
    # Leaves cannot be operators or include calls. Handle them before asking
    # compound-expression helpers to unwrap and classify the same node again.
    op = dw_op(id)
    if op == .kw_or_throw:
        n = mk(.propagate, pos)
        nodes[n].a = i32(dw_expr(dw_child(id, 1)))
        return n
    if op == .range_apply: return dw_range_value(dw_iterable(id, true, true))
    if dn_token_call(op) and dw_is_include(id): return dw_include(id)
    if k == .block:
        children = dw_children(id)
        if children.len() == 1 and dw_op(children[0]) == .range_apply: return dw_range_value(dw_iterable(id, true, true))
        if text == "():" and children.len() == 1: return dw_expr(children[0])
        if text == "[]:":
            if children.len() == 1 and dewy_syntax[children[0]].kind == .flow:
                first = dw_child(children[0], 0)
                if dewy_syntax[first].kind == .keyword_expr and dewy_syntax[dw_child(first, 0)].text == "loop": return dw_comprehension(children[0])
            is_map = children.len() > 0 and dw_op(children[0]) == .arrow
            is_record = children.len() > 0 and dw_op(children[0]) == .assign
            loop child in children:
                if dw_op(child) == .assign: is_record = true
            n = mk(if is_map: NK.map_lit else if is_record: NK.record_lit else: NK.array, pos)
            xs: int[]
            members: int[]
            methods: int[]
            if is_record:
                members = dw_row_names(children)
                loop child in children:
                    if dw_method_row(child): methods.push(child)
            loop child in children:
                item = dw_unwrap(child)
                if not is_map and dewy_syntax[item].kind == .postfix and dw_op(item) == .ellipsis:
                    value = dw_expr(dw_child(item, 1))
                    add_flag(value, NF_SPREAD)
                    xs.push(value)
                else if is_map:
                    if dw_op(child) != .arrow: return dw_fail(child, "a dictionary item without ->")
                    pair = mk(.pair, dewy_syntax[child].pos)
                    nodes[pair].a = i32(dw_expr(dw_child(child, 1)))
                    nodes[pair].b = i32(dw_expr(dw_child(child, 2)))
                    xs.push(pair)
                else if is_record and methods.contains(child):
                    xs.push(dw_literal_method(child, members))
                else if is_record:
                    xs.push(dw_record_entry(child))
                else: xs.push(dw_expr(child))
            if methods.len() > 0: dw_register_literal_methods(xs)
            set_list(n, xs)
            return n
        if text == "{{}}:": return dw_block(id)
        return dw_fail(id, "this expression block")
    if k == .postfix and op == .ellipsis:
        fatal(pos, "spread is supported inside array or record literals: `[values... item]` or `[base... field=value]`")
    if k == .prefix:
        e = dw_expr(dw_child(id, 1))
        if op == .at:
            # `@f(args)` partially evaluates f; `@x` selects a place or a function.
            if nodes[e].kind == .call: nodes[e].aux2 = i32(AUX2_PARTIAL)
            else: add_flag(e, NF_MUT)
            return e
        if op == .dot_minus or op == .dot_plus:
            n = mk(.unary, pos)
            nodes[n].op = i32(int(if op == .dot_minus: Tok.minus else: Tok.plus))
            nodes[n].a = i32(e)
            add_flag(n, NF_BROADCAST)
            return n
        if op == .minus and nodes[e].kind == .int_lit and nodes[e].aux2 == 0:
            if has_flag(e, NF_U64) and nodes[e].ival != -9223372036854775807 - 1:
                value = u64(nodes[e].ival)
                return dw_bigint_value([value & 0xFFFFFFFF, value >> 32], pos, true)
            nodes[e].ival = -nodes[e].ival
            nodes[e].pos = pos
            nodes[e].aux2 = 1
            clear_flag(e, NF_U64)
            return e
        if op == .minus and nodes[e].kind == .float_lit:
            nodes[e].fval = -nodes[e].fval
            if nodes[e].sval != 0: nodes[e].sval = i32(intern("-" + name_of(int(nodes[e].sval))))
            nodes[e].pos = pos
            return e
        n = mk(if op == .kw_not: NK.not_ else: NK.unary, pos)
        if op != .minus and op != .kw_not and op != .plus: return dw_fail(id, "prefix '{op}'")
        nodes[n].op = i32(int(if op == .minus: Tok.minus else: Tok.plus))
        nodes[n].a = i32(e)
        return n
    if k == .flow:
        loop arm in dw_children(id):
            if dewy_syntax[arm].kind == .keyword_expr and dewy_syntax[dw_child(arm, 0)].text == "loop":
                return dw_fail(arm, "a loop used as a value; use return or a comprehension")
        return dw_flow(id, 0)
    if k == .binary:
        left = dw_child(id, 1)
        right = dw_child(id, 2)
        scalar_op = dn_token_undot(op)
        if scalar_op != .none:
            return dw_broadcast(scalar_op, dw_expr(left), dw_expr(right), id)
        if op == .is_type or op == .isnt_type:
            n = mk(.istype, pos)
            nodes[n].a = i32(dw_expr(left))
            nodes[n].b = i32(dw_type(right))
            if op == .isnt_type or dewy_syntax[dw_child(id, 0)].kind == .inverted_comparison:
                inverted = mk(.not_, pos)
                nodes[inverted].a = i32(n)
                return inverted
            return n
        if dewy_syntax[dw_child(id, 0)].kind == .inverted_comparison:
            comparison = mk(.binary, pos)
            nodes[comparison].op = i32(int(dw_binary_token(op, id)))
            nodes[comparison].a = i32(dw_expr(left))
            nodes[comparison].b = i32(if op == .contains: dw_membership(right) else: dw_expr(right))
            n = mk(.not_, pos)
            nodes[n].a = i32(comparison)
            return n
        if op == .function: return dw_function(id, "")
        if op == .type_apply:
            n = mk(.typeapply, pos)
            nodes[n].a = i32(dw_expr(left))
            type_base = int(nodes[n].a)
            loop nodes[type_base].kind == .field: type_base = int(nodes[type_base].a)
            if nodes[type_base].kind == .ident: nodes[n].c = i32(dw_type(id))
            args: int[]
            if nodes[int(nodes[n].c)].kind != .trefined:
                loop child in dw_children(right): args.push(dw_type(child))
            set_list(n, args)
            return n
        if op == .floor or op == .percent or op == .caret or op == .slash:
            a = dw_expr(left)
            b = dw_expr(right)
            name = if op == .slash: "__dewy_divide" else if op == .caret: "__dewy_power" else if op == .floor: "__floor_div" else: "__floor_mod"
            callee = mk(.ident, pos)
            nodes[callee].name = i32(intern(name))
            n = mk(.call, pos)
            nodes[n].a = i32(callee)
            set_list(n, [a, b])
            return n
        if op == .dot:
            name = dw_name(right)
            computed = dw_field_name(right)
            if name == "" and computed == 0: return dw_fail(id, "computed member names")
            n = mk(.field, pos)
            nodes[n].a = i32(dw_expr(left))
            nodes[n].b = i32(computed)
            if computed == 0: nodes[n].name = dw_name_id(right)
            return n
        if op == .kw_as or op == .kw_transmute:
            n = mk(.cast, pos)
            nodes[n].a = i32(dw_expr(left))
            nodes[n].b = i32(dw_type(right))
            if op == .kw_transmute: nodes[n].aux2 = 1
            return n
        if dn_token_call(op) or op == .index:
            xs = dw_children(right)
            bracket = dewy_syntax[right].kind == .block and dewy_syntax[right].text in ["[]:", "[):"]
            if bracket and dw_name(left) == "set":
                return bc_call("__dewy_set", [dw_expr(right)], pos)
            n = mk(if bracket: NK.index else: NK.call, pos)
            if op == .broadcast_call: add_flag(n, NF_BROADCAST)
            nodes[n].a = i32(dw_expr(left))
            callee = int(nodes[n].a)
            if not bracket and nodes[callee].kind == .field: add_flag(int(nodes[callee].a), NF_MUT)
            args: int[]
            if bracket: dw_index_context.push(n)
            if dewy_syntax[right].kind != .block: args.push(dw_expr(right))
            else if bracket and xs.len() == 1 and (dw_op(xs[0]) == .range_apply or dw_name(xs[0]) == ".."):
                args.push(dw_iterable(right, true))
            else:
                if dewy_syntax[right].text == "[):": return dw_fail(right, "an exclusive index without a range")
                loop child in xs:
                    # Temporary parse cursor: each axis gives contextual end its own name.
                    if bracket: nodes[n].aux2 = i32(args.len())
                    if dw_op(child) == .assign:
                        a = mk(.namedarg, dewy_syntax[child].pos)
                        nodes[a].name = dw_name_id(dw_child(child, 1))
                        nodes[a].a = i32(dw_expr(dw_child(child, 2)))
                        args.push(a)
                    else if bracket and xs.len() > 1: args.push(dw_iterable(child, true, true))
                    else: args.push(dw_expr(child))
            if bracket:
                dw_index_context.pop()
                nodes[n].aux2 = 0
            set_list(n, args)
            if bracket and args.len() == 1: nodes[n].b = i32(args[0])
            return n
        if op == .coalesce:
            n = mk(.coalesce, pos)
            nodes[n].a = i32(dw_expr(left))
            nodes[n].b = i32(dw_expr(right))
            return n
        n = mk(if op == .kw_and: NK.and_ else if op == .kw_or: NK.or_ else: NK.binary, pos)
        nodes[n].op = i32(int(dw_binary_token(op, id)))
        nodes[n].a = i32(dw_expr(left))
        nodes[n].b = i32(if op == .contains: dw_membership(right) else: dw_expr(right))
        return n
    return dw_fail(id, "syntax '{dw_kind_name(k)}'")

dw_stmt = (id: int, top: bool = false) -> int:
    let id = dw_unwrap(id)
    # `(count += 1)`: a parenthesized update is the update (a function body may be one).
    grouped = dw_grouped(id)
    if grouped != id and (dn_token_assignment(dw_op(grouped)) or dw_op(grouped) == .assign): id = grouped
    pos = dewy_syntax[id].pos
    k = dewy_syntax[id].kind
    if k == .compact_stmt: return dewy_syntax[id].child_left
    if dw_op(id) == .kw_as and dw_is_include(dw_child(id, 1)):
        name = dw_name(dw_child(id, 2))
        if name == "": return dw_fail(id, "this asset binding")
        n = mk(.vardecl, pos)
        nodes[n].name = i32(intern(name))
        nodes[n].b = i32(dw_include(dw_child(id, 1)))
        return n
    if dw_op(id) == .statement_end:
        s = dw_stmt(dw_child(id, 1), top)
        if nodes[s].kind == .exprstmt:
            n = mk(.assign, pos)
            nodes[n].op = i32(int(Tok.assign))
            nodes[n].a = i32(mk(.hole, pos))
            nodes[n].b = nodes[s].a
            return n
        return s
    if k == .keyword_expr:
        word = dewy_syntax[dw_child(id, 0)].text
        if word == "test":
            if not top: return dw_fail(id, "a test block inside another block; declare tests at the top level")
            n = mk(.test_, pos)
            nodes[n].sval = i32(intern(dewy_syntax[dw_child(id, 1)].text))
            nodes[n].b = i32(dw_block(dw_child(id, 2)))
            add_flag(n, NF_TERMINATED)
            return n
        if word == "from" or word == "import":
            if not top: return dw_fail(id, "local imports")
            return dw_import(id)
        if word == "return":
            n = mk(.return_, pos)
            if dw_nchildren(id) > 1: nodes[n].a = i32(dw_expr(dw_child(id, 1)))
            return n
        if word == "let" or word == "const": return dw_declare(dw_child(id, 1), word == "const", top)
        if word == "break" or word == "continue":
            n = mk(if word == "break": NK.break_ else: NK.continue_, pos)
            if dw_nchildren(id) > 1:
                label = dw_child(id, 1)
                if dewy_syntax[label].kind != .metatag: return dw_fail(label, "a loop exit without a $label")
                nodes[n].name = i32(intern(dewy_syntax[label].text))
            return n
        return dw_fail(id, "statement '{word}'")
    if k == .flow:
        n = dw_flow(id, 0)
        add_flag(n, NF_STMT)
        return dw_flow_stmt(n)
    if dn_token_assignment(dw_op(id)):
        n = mk(.assign, pos)
        op = dw_op(id)
        scalar_op = dn_token_undot(op)
        if scalar_op != .none:
            add_flag(n, NF_BROADCAST)
            op = scalar_op
        nodes[n].op = i32(int(if op == .plus_assign: Tok.pluseq else if op == .minus_assign: Tok.minuseq else if op == .slash_assign or op == .floor_assign: Tok.slasheq else if op == .percent_assign: Tok.percenteq else if op == .power_assign: Tok.careteq else if op == .shl_assign: Tok.shleq else if op == .shr_assign: Tok.shreq else: Tok.stareq))
        if (op == .slash_assign or op == .floor_assign or op == .percent_assign or op == .power_assign):
            nodes[n].sval = i32(intern(if op == .slash_assign: "__dewy_divide" else if op == .floor_assign: "__floor_div" else if op == .percent_assign: "__floor_mod" else: "__dewy_power"))
        nodes[n].a = i32(dw_expr(dw_child(id, 1)))
        nodes[n].b = i32(dw_expr(dw_child(id, 2)))
        return n
    if dw_op(id) == .assign or dw_op(id) == .colon:
        lhs = dw_unwrap(dw_child(id, 1))
        if dw_op(id) == .colon or top and dw_op(lhs) == .colon: return dw_declare(id, false, top)
        n = mk(.assign, pos)
        nodes[n].op = i32(int(Tok.assign))
        if dewy_syntax[lhs].kind == .block and dewy_syntax[lhs].text == "[]:":
            pattern = mk(.tuple, dewy_syntax[lhs].pos)
            set_list(pattern, dw_bindings(lhs))
            nodes[n].a = i32(pattern)
        else: nodes[n].a = i32(dw_expr(lhs))
        nodes[n].b = i32(dw_expr(dw_child(id, 2)))
        return n
    n = mk(.exprstmt, pos)
    nodes[n].a = i32(dw_expr(id))
    return n

dw_bindings = (id: int) -> int[]:
    seen: {str: bool} = {}
    dw_binding_items(id, seen)

dw_binding_items = (id: int, seen: mut {str: bool}) -> int[]:
    bindings: int[]
    loop child in dw_children(id):
        let child = dw_unwrap(child)
        annotation = 0
        if dw_op(child) == .colon:
            annotation = dw_child(child, 2)
            child = dw_unwrap(dw_child(child, 1))
        if dewy_syntax[child].kind == .block and dewy_syntax[child].text == "[]:":
            if annotation != 0: return [dw_fail(child, "an annotated nested pattern; annotate its names or the whole declaration")]
            n = mk(.tuple, dewy_syntax[child].pos)
            set_list(n, dw_binding_items(child, seen))
            bindings.push(n)
            continue
        name = dw_name(child)
        if name == "": return [dw_fail(child, "this unpacking target; use names or nested brackets")]
        if name != "_" and seen.has(name): fatal(dewy_syntax[child].pos, "duplicate unpacking name '{name}'")
        seen[name] = true
        n = mk(if name == "_": NK.hole else: NK.ident, dewy_syntax[child].pos)
        nodes[n].name = dw_name_id(child)
        if annotation != 0: nodes[n].a = i32(dw_type(annotation))
        bindings.push(n)
    if bindings.len() == 0: return [dw_fail(id, "an empty unpacking target")]
    bindings

# Pure scalar syntax can stay a compile-time expression. Anything that reads a
# name, calls code or constructs a collection must retain one initialized value.
dw_const_number = (n: int) -> bool:
    k = nodes[n].kind
    if k == .int_lit or k == .float_lit or k == .bool_lit: return true
    if k == .unary or k == .not_: return dw_const_number(int(nodes[n].a))
    if k == .binary or k == .and_ or k == .or_:
        return dw_const_number(int(nodes[n].a)) and dw_const_number(int(nodes[n].b))
    false

dw_declare = (id: int, constant: bool, top: bool) -> int:
    let id = dw_unwrap(id)
    initial = 0
    lhs = id
    if dw_op(id) == .assign:
        lhs = dw_child(id, 1)
        initial = dw_child(id, 2)
    if constant and initial == 0: return dw_fail(lhs, "a const declaration without an initializer")
    annotation = 0
    if dw_op(lhs) == .colon:
        annotation = dw_child(lhs, 2)
        lhs = dw_child(lhs, 1)
    if dewy_syntax[lhs].kind == .block and dewy_syntax[lhs].text == "[]:":
        if initial == 0: return dw_fail(lhs, "unpacking without a value")
        n = mk(.vardecl, dewy_syntax[id].pos)
        set_list(n, dw_bindings(lhs))
        nodes[n].b = i32(dw_expr(initial))
        if annotation != 0: nodes[n].a = i32(dw_type(annotation))
        if constant: add_flag(n, NF_RDONLY)
        if not top: dw_shadow(dw_bound_names(kids(n)))
        return n
    name = dw_name(lhs)
    if name == "": return dw_fail(lhs, "this declaration")
    if not top and initial != 0 and dw_overload_group(initial):
        return dw_fail(initial, "a local overload group; declare it at module level")
    if initial != 0 and dw_op(initial) == .function:
        if top: return dw_function(initial, name)
        dw_shadow([int(dw_name_id(lhs))])
        n = mk(.vardecl, dewy_syntax[id].pos)
        nodes[n].name = i32(intern(name))
        nodes[n].b = i32(dw_function(initial, ""))
        if annotation != 0: nodes[n].a = i32(dw_type(annotation))
        if constant: add_flag(n, NF_RDONLY)
        return n
    mint = dw_grouped(initial)
    structure = 0
    if dw_op(mint) == .amp:
        structure = dw_unwrap(dw_child(mint, 2))
        mint = dw_grouped(dw_child(mint, 1))
    if dw_op(mint) == .kw_of:
        if not top: return dw_fail(id, "local nominal type declarations")
        if annotation != 0 and dw_name(annotation) != "type": return dw_fail(id, "a nominal declaration with a non-type annotation")
        n = mk(.struct_, dewy_syntax[id].pos)
        nodes[n].name = i32(intern(name))
        nodes[n].a = i32(dw_type(dw_child(mint, 1)))
        fields: int[]
        methods: int[]
        rows: int[]
        if structure != 0:
            if dewy_syntax[structure].text != "[]:": return dw_fail(structure, "this nominal intersection; expected record fields")
            rows = dw_children(structure)
            outer_siblings = dw_siblings
            dw_siblings = {}
            loop field in rows:
                if dw_method_row(field): methods.push(field)
                else: fields.push(dw_param(field, .vardecl))
            dw_siblings = outer_siblings
        set_list(n, fields)
        dw_type_methods(n, rows, methods)
        return n
    inferred_refinement = initial != 0 and dw_op(initial) == .amp and dw_op(dw_grouped(dw_child(initial, 2))) == .tilde
    if annotation == 0 and initial != 0 and dw_op(initial) == .type_apply:
        loop entry in dw_children(dw_child(initial, 2)):
            op = dw_op(dw_grouped(entry))
            if op == .function or op == .kw_and or op == .eq or op == .not_eq or op == .lt or op == .le or op == .gt or op == .ge or op == .contains: inferred_refinement = true
    if inferred_refinement or annotation != 0 and dw_name(annotation) == "type":
        if initial == 0: return dw_fail(id, "a type declaration without a definition")
        type_params: int[]
        if (dw_op(initial) == .index or dw_op(initial) == .call) and dewy_syntax[dw_child(initial, 1)].text == "<>:":
            type_params = dw_type_params(dw_child(initial, 1))
            initial = dw_child(initial, 2)
        if dewy_syntax[initial].text != "[]:":
            n = mk(.typealias, dewy_syntax[id].pos)
            nodes[n].name = i32(intern(name))
            nodes[n].a = i32(dw_type(initial))
            if type_params.len() > 0:
                set_list2(n, type_params)
                add_flag(n, NF_GENERIC)
            return n
        n = mk(.struct_, dewy_syntax[id].pos)
        nodes[n].name = i32(intern(name))
        if type_params.len() > 0:
            set_list2(n, type_params)
            add_flag(n, NF_GENERIC)
        fields: int[]
        methods: int[]
        outer_siblings = dw_siblings
        dw_siblings = {}
        loop field in dw_children(initial):
            if dw_method_row(field): methods.push(field)
            else: fields.push(dw_param(field, .vardecl))
        dw_siblings = outer_siblings
        set_list(n, fields)
        if methods.len() > 0 and not top: return dw_fail(methods[0], "methods on a local type; declare the type at module level")
        if top: dw_type_methods(n, dw_children(initial), methods)
        return n
    n = mk(.vardecl, dewy_syntax[id].pos)
    nodes[n].name = i32(intern(name))
    if annotation != 0: nodes[n].a = i32(dw_type(annotation))
    if initial != 0: nodes[n].b = i32(dw_expr(initial))
    if not top: dw_shadow([int(nodes[n].name)])
    if constant:
        value = int(nodes[n].b)
        if dw_const_number(value) or nodes[value].kind == .str_lit or nodes[value].kind == .none_lit: nodes[n].kind = .const_
        else: add_flag(n, NF_RDONLY)
    return n

# The names a declaration's unpacking pattern binds.
dw_bound_names = (bindings: int[]) -> int[]:
    out: int[]
    loop binding in binding_leaves(bindings):
        if nodes[binding].kind == .ident: out.push(int(nodes[binding].name))
    out

# A type's methods become module functions of the same name taking the instance first
# (`s.width` is `width(s)` by the uniform call syntax); no function is stored in the
# object. A generic type's methods take its type parameters first.
# A minted type's methods also reach the members it inherits from a parent declared
# earlier in this module.
dw_type_members: {int: {int: {int: int}}} = {}   # file -> type name -> its members (dewy_method_group)

dw_type_methods = (struct_: int, rows: int[], methods: int[]):
    receiver = intern("$self")
    row_names = dw_row_names(rows)
    inherited: {int: int} = {}
    parent = int(nodes[struct_].a)
    file = pos_file(nodes[struct_].pos)
    types_here = dw_type_members.get(file) ?? {}
    if parent != 0 and nodes[parent].kind == .tname: inherited = types_here.get(int(nodes[parent].name)) ?? {}
    members: {int: int} = {}
    loop name, member in inherited: members[name] = receiver
    loop name in row_names: members[name] = receiver
    type_params = kids2(struct_)
    decls: int[]
    loop row in rows:
        if not methods.contains(row):
            decls.push(0)
            continue
        item = dw_unwrap(row)
        name = dw_name(dw_child(item, 1))
        if name == "main": fatal(dewy_syntax[item].pos, "a method cannot be named main")
        loop other in kids(struct_):
            if name_of(int(nodes[other].name)) == name: fatal(dewy_syntax[item].pos, "'{name}' is both a field and a method of {name_of(int(nodes[struct_].name))}")
        outer = dw_siblings
        dw_siblings = members
        fn_ = dw_function(dw_grouped(dw_child(item, 2)), name)
        dw_siblings = outer
        pos = nodes[fn_].pos
        object_type = mk(.tname, pos)
        nodes[object_type].name = nodes[struct_].name
        if type_params.len() > 0:
            own = kids2(fn_)
            params: int[]
            arguments: int[]
            loop tp in type_params:
                loop mine in own:
                    if nodes[mine].name == nodes[tp].name: fatal(nodes[mine].pos, "type parameter '{name_of(int(nodes[tp].name))}' is already {name_of(int(nodes[struct_].name))}'s")
                param = mk(.ident, pos)
                nodes[param].name = nodes[tp].name
                params.push(param)
                argument = mk(.tname, pos)
                nodes[argument].name = nodes[tp].name
                arguments.push(argument)
            set_list(object_type, arguments)
            set_list2(fn_, params + own)
            add_flag(fn_, NF_GENERIC)
        dw_add_receiver(fn_, receiver, object_type)
        dw_pending_decls.push(fn_)
        decls.push(fn_)
    group = dewy_method_group(row_names, decls, inherited)
    types_here[int(nodes[struct_].name)] = group
    dw_type_members[file] = types_here
    if methods.len() > 0: dewy_type_members[struct_] = group

dw_import = (id: int) -> int:
    pos = dewy_syntax[id].pos
    n = mk(.import_, pos)
    spec = dw_unwrap(dw_child(id, 1))
    alias = ""
    if dw_op(spec) == .kw_as:
        alias = dw_name(dw_child(spec, 2))
        if alias == "": return dw_fail(spec, "this module alias")
        spec = dw_unwrap(dw_child(spec, 1))
    value = dw_name(spec)
    if value == "":
        if dw_op(spec) != .call or dw_name(dw_child(spec, 1)) != "p": return dw_fail(spec, "this module path; use a library name or p\"file.dewy\"")
        path = dw_unwrap(dw_child(spec, 2))
        if dewy_syntax[path].kind != .string: return dw_fail(path, "a nonliteral module path")
        value = dewy_syntax[path].text
        nodes[n].aux2 = 1
    nodes[n].sval = i32(intern(value))
    nodes[n].name = i32(intern(strip_ext(file_name(value))))
    if alias != "": nodes[n].name = i32(intern(alias))
    if dewy_syntax[dw_child(id, 0)].text == "from":
        if dw_nchildren(id) != 4: return dw_fail(id, "this import")
        nodes[n].aux = 2
        selected = dw_unwrap(dw_child(id, 3))
        imported: int[]
        if dw_op(selected) == .comma:
            loop i in [1..dw_nchildren(selected)): imported.push(dw_import_name(dw_child(selected, i)))
        else: imported.push(dw_import_name(selected))
        loop item in imported:
            if nodes[item].kind != .ident: return dw_fail(selected, "this imported name")
        set_list(n, imported)
    else if dw_nchildren(id) != 2: return dw_fail(id, "this import alias")
    return n

dw_import_name = (id: int) -> int:
    let id = dw_unwrap(id)
    loop dewy_syntax[id].kind == .block and dewy_syntax[id].text == "():" and dw_nchildren(id) == 1:
        id = dw_unwrap(dw_child(id, 0))
    alias = ""
    if dw_op(id) == .kw_as:
        alias = dw_name(dw_child(id, 2))
        if alias == "": return dw_fail(id, "this imported alias; group each aliased name")
        id = dw_child(id, 1)
    if dw_name(id) == "": return dw_fail(id, "this imported name")
    n = dw_expr(id)
    if alias != "": nodes[n].aux = i32(intern(alias))
    return n

dw_range_value = (range: int) -> int: dewy_range_value(range)

dw_membership = (id: int) -> int:
    r = dw_iterable(id, true, true)
    if nodes[r].kind == .range and (has_flag(r, NF_STEP) or has_flag(r, NF_EXCL_FIRST)): return dw_range_value(r)
    r

dw_iterable = (id: int, slice: bool = false, membership: bool = false) -> int:
    let id = dw_unwrap(id)
    inclusive = true
    exclude_first = false
    if dewy_syntax[id].kind == .block and dw_nchildren(id) == 1 and (dw_op(dw_child(id, 0)) == .range_apply or dw_name(dw_child(id, 0)) == ".."):
        wrapper = dewy_syntax[id].text
        if wrapper not in ["[]:", "[):", "():", "(]:"]: return dw_fail(id, "this range boundary")
        inclusive = wrapper == "[]:" or wrapper == "(]:"
        exclude_first = wrapper == "():" or wrapper == "(]:"
        if exclude_first and slice and not membership: return dw_fail(id, "a slice with an exclusive first bound")
        id = dw_unwrap(dw_child(id, 0))
    if slice and dw_name(id) == "..": return mk(.range, dewy_syntax[id].pos)
    if dw_op(id) != .range_apply:
        value = dw_expr(id)
        if slice: return value
        # Resolve streaming text/ranges and dense dictionary snapshots once,
        # before combined-loop desugaring.
        call = mk(.call, dewy_syntax[id].pos)
        callee = mk(.ident, dewy_syntax[id].pos)
        nodes[callee].name = i32(intern("__dewy_iter"))
        nodes[call].a = i32(callee)
        set_list(call, [value])
        return call
    size = dw_nchildren(id)
    n = mk(.range, dewy_syntax[id].pos)
    at = 1
    if dw_name(dw_child(id, at)) != "..":
        first = dw_unwrap(dw_child(id, at))
        if dw_op(first) == .comma:
            if dw_nchildren(first) != 3: return dw_fail(first, "a stepped range without exactly two starting values")
            nodes[n].a = i32(dw_expr(dw_child(first, 1)))
            nodes[n].c = i32(dw_expr(dw_child(first, 2)))
            add_flag(n, NF_STEP)
        else: nodes[n].a = i32(dw_expr(first))
        at += 1
    else if not slice: return dw_fail(id, "a loop range without a start")
    if at >= size or dw_name(dw_child(id, at)) != ".." or size > at + 2: return dw_fail(id, "this range")
    if size == at + 2: nodes[n].b = i32(dw_expr(dw_child(id, at + 1)))
    if inclusive: add_flag(n, NF_INCLUSIVE)
    if exclude_first:
        add_flag(n, NF_EXCL_FIRST)
        if not slice: return bc_call("__dewy_iter", [dw_range_value(n)], dewy_syntax[id].pos)
    return n

dw_loop_head = (id: int, combined: bool = false) -> int:
    let id = dw_unwrap(id)
    op = dw_op(id)
    n = mk(.lhead, dewy_syntax[id].pos)
    if op == .kw_in:
        nodes[n].op = 1
        binder = dw_unwrap(dw_child(id, 1))
        if dw_op(binder) == .at:
            if combined: return dw_fail(binder, "a mutable binding in a combined loop; use a separate loop @item in items")
            add_flag(n, NF_MUT)
            binder = dw_unwrap(dw_child(binder, 1))
        binders: int[]
        # The binders hide members of their names in the body, not in the iterable.
        before = dw_siblings
        if dewy_syntax[binder].kind == .block and dewy_syntax[binder].text == "[]:":
            if has_flag(n, NF_MUT): return dw_fail(binder, "unpacking a mutable loop binding; use a named @item and its fields")
            binders = dw_bindings(binder)
            # A one-element pattern still unpacks the iteration value. Keep
            # its brackets instead of collapsing it to an ordinary name.
            if binders.len() == 1:
                pattern = mk(.tuple, dewy_syntax[binder].pos)
                set_list(pattern, binders)
                binders = [pattern]
        else:
            if dw_name(binder) == "": return dw_fail(binder, "this loop binding")
            dw_shadow([int(dw_name_id(binder))])
            binders.push(dw_expr(binder))
        set_list(n, binders)
        dw_shadow(dw_bound_names(binders))
        inside = dw_siblings
        dw_siblings = before
        it = if has_flag(n, NF_MUT): dw_expr(dw_child(id, 2)) else: dw_iterable(dw_child(id, 2))
        dw_siblings = inside
        if has_flag(n, NF_MUT):
            # Element aliases reuse this route. Indexed/call routes need a captured
            # selector rather than reevaluating effects at each access.
            root = it
            loop nodes[root].kind == .field: root = int(nodes[root].a)
            if nodes[root].kind != .ident:
                return dw_fail(id, "mutable iteration over this expression; use an array binding or a field of one")
        if combined and nodes[it].kind == .range and has_flag(it, NF_STEP):
            if nodes[it].b == 0:
                it = bc_call("__dewy_open_range_iter", [int(nodes[it].a), int(nodes[it].c)], nodes[it].pos)
            else: it = bc_call("__dewy_iter", [dw_range_value(it)], nodes[it].pos)
        nodes[n].a = i32(it)
    else if op == .kw_and or op == .kw_or:
        nodes[n].op = if op == .kw_and: 2 else: 3
        nodes[n].a = i32(dw_loop_head(dw_child(id, 1), true))
        nodes[n].b = i32(dw_loop_head(dw_child(id, 2), true))
        return head_collapse(n)
    else:
        nodes[n].op = 4
        nodes[n].a = i32(dw_expr(id))
    return n

# Match bodies use the same statement/value blocks as functions and conditionals.
dw_flow_stmt = (n: int) -> int:
    if nodes[n].kind != .match_: return n
    s = mk(.exprstmt, nodes[n].pos)
    nodes[s].a = i32(n)
    s

dw_pattern = (id: int) -> int:
    let id = dw_unwrap(id)
    pos = dewy_syntax[id].pos
    name = dw_name(id)
    if name != "":
        p = mk(.pwild, pos)
        if name != "_": nodes[p].name = i32(intern(name))
        return p
    binding = ""
    if dw_op(id) == .colon:
        binding = dw_name(dw_child(id, 1))
        if binding == "": return dw_fail(id, "this match binding")
        id = dw_unwrap(dw_child(id, 2))
    else if dewy_syntax[id].kind == .block and dewy_syntax[id].text == "<>:" and dw_nchildren(id) == 1:
        id = dw_unwrap(dw_child(id, 0))
    else: return dw_fail(id, "this match pattern")
    k = dewy_syntax[id].kind
    literal = dw_integer_kind(k) or k == .string or k == .boolean or dw_name(id) == "none"
    if dw_op(id) == .minus: literal = dw_integer_kind(dewy_syntax[dw_unwrap(dw_child(id, 1))].kind)
    p = mk(if literal: NK.plit else: NK.ptype, pos)
    nodes[p].a = i32(if literal: dw_expr(id) else: dw_type(id))
    if binding != "" and binding != "_": nodes[p].name = i32(intern(binding))
    p

dw_match = (id: int, accumulator: int = 0, map: bool = false) -> int:
    n = mk(.match_, dewy_syntax[id].pos)
    nodes[n].a = i32(dw_expr(dw_child(id, 1)))
    body = dw_child(id, 2)
    arms = [body]
    if dewy_syntax[body].kind == .block and dewy_syntax[body].text == "{{}}:": arms = dw_children(body)
    xs: int[]
    loop source in arms:
        if dw_op(source) != .function: return dw_fail(source, "a match arm without =>")
        arm = mk(.arm, dewy_syntax[source].pos)
        pattern = dw_pattern(dw_child(source, 1))
        set_list(arm, [pattern])
        outer_siblings = dw_siblings
        if nodes[pattern].name != 0: dw_shadow([int(nodes[pattern].name)])
        nodes[arm].b = i32(dw_block(dw_child(source, 2), accumulator, map))
        dw_siblings = outer_siblings
        xs.push(arm)
    set_list(n, xs)
    n

dw_flow = (id: int, at: int, accumulator: int = 0, map: bool = false) -> int:
    items = dw_children(id)
    if at >= items.len(): return 0
    arm = items[at]
    if dewy_syntax[arm].kind != .keyword_expr: return dw_block(arm, accumulator, map)
    word = dewy_syntax[dw_child(arm, 0)].text
    if word == "match":
        n = dw_match(arm, accumulator, map)
        if at + 1 < items.len():
            rest = dw_flow(id, at + 1, accumulator, map)
            if nodes[rest].kind != .block:
                block = mk(.block, nodes[rest].pos)
                set_list(block, [dw_flow_stmt(rest)])
                rest = block
            fallback = mk(.arm, nodes[rest].pos)
            set_list(fallback, [mk(.pwild, nodes[rest].pos)])
            nodes[fallback].b = i32(rest)
            xs = kids(n)
            xs.push(fallback)
            set_list(n, xs)
        return n
    if word != "if" and word != "loop": return dw_block(arm, accumulator, map)
    if dw_nchildren(arm) != 3: return dw_fail(arm, "this flow arm")
    n = mk(if word == "if": NK.if_ else: NK.while_, dewy_syntax[arm].pos)
    outer_siblings = dw_siblings
    if word == "loop":
        head = dw_loop_head(dw_child(arm, 1))
        if at + 1 < items.len():
            nodes[n].kind = .loopx
            nodes[n].a = i32(head)
        else if nodes[head].op == 1:
            nodes[n].kind = .for_
            nodes[n].a = nodes[head].a
            if has_flag(head, NF_MUT): add_flag(n, NF_MUT)
            set_list(n, kids(head))
        else if nodes[head].op == 4: nodes[n].a = nodes[head].a
        else:
            nodes[n].kind = .loopx
            nodes[n].a = i32(head)
    else: nodes[n].a = i32(dw_expr(dw_child(arm, 1)))
    nodes[n].b = i32(dw_block(dw_child(arm, 2), accumulator, map))
    dw_siblings = outer_siblings
    if at + 1 < items.len():
        rest = dw_flow(id, at + 1, accumulator, map)
        if nodes[rest].kind != .block:
            block = mk(.block, dewy_syntax[arm].pos)
            set_list(block, [dw_flow_stmt(rest)])
            rest = block
        nodes[n].c = i32(rest)
    return n

dw_label_fail = (pos: int, label: int):
    fatal(pos, "a loop label must be followed by a loop (`${name_of(label)}` is not a directive)")

dw_block = (id: int, accumulator: int = 0, map: bool = false) -> int:
    n = mk(.block, dewy_syntax[id].pos)
    scoped = dw_siblings.len() > 0
    outer_siblings: {int: int} = {}
    if scoped: outer_siblings = dw_siblings
    statements: int[]
    if dewy_syntax[id].kind == .block and dewy_syntax[id].text == "{{}}:":
        children = dw_children(id)
        label = 0
        label_pos = 0
        loop i in 0.. and child in children:
            if dewy_syntax[child].kind == .metatag:
                if dw_designed_directive(dewy_syntax[child].text) or dewy_syntax[child].text == "capture" or dewy_syntax[child].text == "include_bytes" or dewy_syntax[child].text == "explicit_copies": dw_metatag_fail(child)
                if label != 0: dw_label_fail(label_pos, label)
                label = intern(dewy_syntax[child].text)
                label_pos = dewy_syntax[child].pos
                continue
            statement = if accumulator != 0 and i + 1 == children.len(): dw_collect(child, accumulator, map) else: dw_stmt(child)
            if label != 0:
                if nodes[statement].kind != .loopx and nodes[statement].kind != .for_ and nodes[statement].kind != .while_: dw_label_fail(label_pos, label)
                nodes[statement].sval = i32(label)
                label = 0
            statements.push(statement)
        if label != 0: dw_label_fail(label_pos, label)
    else if accumulator != 0: statements.push(dw_collect(id, accumulator, map))
    else: statements.push(dw_stmt(id))
    if scoped: dw_siblings = outer_siblings
    set_list(n, statements)
    return n

# Comprehensions use ordinary loops, conditionals and push calls, following the
# implementation-language frontend. No lazy runtime or separate ownership path.
dw_collection_kind = (id: int) -> int:
    let id = dw_unwrap(id)
    kind = dewy_syntax[id].kind
    children = dw_children(id)
    candidates: int[]
    if kind == .flow:
        loop arm in children:
            if dewy_syntax[arm].kind == .keyword_expr:
                word = dewy_syntax[dw_child(arm, 0)].text
                if word == "match":
                    body = dw_child(arm, 2)
                    arms = [body]
                    if dewy_syntax[body].kind == .block: arms = dw_children(body)
                    loop branch in arms:
                        if dw_op(branch) != .function: return dw_fail(branch, "a match arm without =>")
                        candidates.push(dw_child(branch, 2))
                else: candidates.push(dw_child(arm, 2))
            else: candidates.push(arm)
    else if kind == .block and dewy_syntax[id].text == "{{}}:":
        if children.len() == 0: return 0
        candidates.push(children[children.len() - 1])
    else:
        if dw_op(id) == .assign and dw_field_name(dw_child(id, 1)) != 0: return 3
        if kind == .keyword_expr or kind == .compact_stmt or dn_token_statement(dw_op(id)): return 0
        return if dw_op(id) == .arrow: 2 else: 1
    result = 0
    loop candidate in candidates:
        next = dw_collection_kind(candidate)
        if next == 0: continue
        if result != 0 and result != next: fatal(dewy_syntax[candidate].pos, "a comprehension cannot mix array elements and dictionary entries")
        result = next
    result

dw_collect = (id: int, accumulator: int, map: bool) -> int:
    let id = dw_unwrap(id)
    kind = dewy_syntax[id].kind
    if kind == .flow:
        n = dw_flow(id, 0, accumulator, map)
        add_flag(n, NF_STMT)
        return dw_flow_stmt(n)
    if kind == .block and dewy_syntax[id].text == "{{}}:": return dw_block(id, accumulator, map)
    if kind == .keyword_expr or kind == .compact_stmt or dn_token_statement(dw_op(id)): return dw_stmt(id)
    pos = dewy_syntax[id].pos
    value = 0
    if map:
        if dw_op(id) != .arrow: return dw_fail(id, "a dictionary comprehension element without ->")
        value = mk(.tuple, pos)
        set_list(value, [dw_expr(dw_child(id, 1)), dw_expr(dw_child(id, 2))])
    else: value = dw_expr(id)
    receiver = mk(.ident, pos)
    nodes[receiver].name = i32(accumulator)
    add_flag(receiver, NF_MUT)
    callee = mk(.field, pos)
    nodes[callee].a = i32(receiver)
    nodes[callee].name = i32(intern("push"))
    call = mk(.call, pos)
    nodes[call].a = i32(callee)
    set_list(call, [value])
    statement = mk(.exprstmt, pos)
    nodes[statement].a = i32(call)
    statement

dw_record_loop = (id: int) -> int:
    let id = dw_unwrap(id)
    if dewy_syntax[id].kind == .flow:
        items = dewy_syntax[id].children
        if items.len() != 1: return dw_fail(id, "a conditional record shape")
        arm = items[0]
        if dewy_syntax[dw_child(arm, 0)].text != "loop": return dw_fail(arm, "a record shape without a compile-time loop")
        head = dw_loop_head(dw_child(arm, 1))
        if nodes[head].op != 1 or nkids(head) != 1: return dw_fail(arm, "a combined record loop")
        n = mk(.record_loop, dewy_syntax[id].pos)
        nodes[n].a = nodes[head].a
        nodes[n].name = nodes[kid(head, 0)].name
        nodes[n].b = i32(dw_record_loop(dw_child(arm, 2)))
        return n
    if dewy_syntax[id].kind == .block and dewy_syntax[id].text == "{{}}:":
        if dewy_syntax[id].children.len() != 1: return dw_fail(id, "a record loop body with multiple entries")
        return dw_record_loop(dw_child(id, 0))
    dw_record_entry(id)

dw_comprehension = (id: int) -> int:
    pos = dewy_syntax[id].pos
    if dw_collection_kind(id) == 3: return dw_record_loop(id)
    map = dw_collection_kind(id) == 2
    # `$` cannot begin an ordinary identifier, so this binding cannot capture a
    # user-written name, including one inside a nested comprehension.
    accumulator = intern("$dewy_collection_{nodes.len()}")
    decl = mk(.vardecl, pos)
    nodes[decl].name = i32(accumulator)
    nodes[decl].b = i32(mk(.array, pos))
    body = dw_collect(id, accumulator, map)
    result = mk(.exprstmt, pos)
    value = mk(.ident, pos)
    nodes[value].name = i32(accumulator)
    nodes[result].a = i32(value)
    block = mk(.block, pos)
    set_list(block, [decl, body, result])
    add_flag(block, NF_COMPREHENSION)
    if not map: return block
    callee = mk(.ident, pos)
    nodes[callee].name = i32(intern("__map_of"))
    call = mk(.call, pos)
    nodes[call].a = i32(callee)
    set_list(call, [block])
    call

# Strip grouping parentheses when recognizing a function declaration or group.
dw_grouped = (id: int) -> int:
    let id = dw_unwrap(id)
    loop dewy_syntax[id].kind == .block and dewy_syntax[id].text == "():" and dw_nchildren(id) == 1:
        id = dw_unwrap(dw_child(id, 0))
    id

# An `&` chain joining a function literal is an overload group; otherwise `&` is
# an ordinary operator (set intersection, bitwise and).
dw_overload_group = (id: int) -> bool:
    let id = dw_grouped(id)
    if dw_op(id) != .amp: return false
    loop i in [1..dw_nchildren(id)):
        member = dw_grouped(dw_child(id, i))
        if dw_op(member) == .function or dw_overload_group(member): return true
    false

dw_overload_members = (id: int, name: str, declarations: mut int[]):
    let id = dw_grouped(id)
    if dw_op(id) == .amp:
        loop i in [1..dw_nchildren(id)):
            dw_overload_members(dw_child(id, i), name, declarations)
    else if dw_op(id) == .function: declarations.push(dw_function(id, name))
    else: dw_fail(id, "an overload group member other than a function literal")

# Expand a static overload group directly into ordinary declarations. This keeps
# overload selection, generic specialization and callable context in one checker.
dw_top_declarations = (id: int) -> int[]:
    declaration = dw_unwrap(id)
    if dw_op(declaration) == .statement_end: declaration = dw_unwrap(dw_child(declaration, 1))
    tag = declaration
    enabled = 1
    if dw_op(declaration) == .assign: tag = dw_unwrap(dw_child(declaration, 1))
    if dewy_syntax[tag].kind == .metatag and dewy_syntax[tag].text == "explicit_copies":
        if tag != declaration:
            value = dw_unwrap(dw_child(declaration, 2))
            if dewy_syntax[value].kind != .boolean: fatal(dewy_syntax[value].pos, "`$explicit_copies` takes a literal true or false")
            if dewy_syntax[value].text == "false": enabled = -1
        file = pos_file(dewy_syntax[tag].pos)
        if files[file].explicit_copies != 0: fatal(dewy_syntax[tag].pos, "`$explicit_copies` may be set only once per module")
        files[file].explicit_copies = enabled
        return []
    if dewy_syntax[declaration].kind == .keyword_expr:
        word = dewy_syntax[dw_child(declaration, 0)].text
        if word == "let" or word == "const": declaration = dw_unwrap(dw_child(declaration, 1))
    if dw_op(declaration) == .assign:
        name = dw_name(dw_child(declaration, 1))
        initial = dw_grouped(dw_child(declaration, 2))
        if name != "" and dw_op(initial) == .type_apply:
            loop entry in dw_children(dw_child(initial, 2)):
                op = dw_op(dw_grouped(entry))
                if op == .function or op == .kw_and or op == .eq or op == .not_eq or op == .lt or op == .le or op == .gt or op == .ge or op == .contains: return [dw_declare(declaration, false, true)]
        mint = initial
        if dw_op(mint) == .amp: mint = dw_grouped(dw_child(mint, 1))
        if name != "" and dw_op(mint) == .kw_of: return dw_with_methods(dw_declare(declaration, false, true))
        if name != "" and dw_op(initial) == .amp:
            if dw_op(dw_grouped(dw_child(initial, 2))) == .tilde: return [dw_declare(declaration, false, true)]
            if name == "main": return [dw_fail(id, "an overloaded entry point")]
            declarations: int[]
            dw_overload_members(initial, name, declarations)
            return declarations
        if name != "" and dw_op(initial) == .function: return [dw_function(initial, name)]
    dw_with_methods(dw_stmt(id, true))

# A declaration followed by the module functions its type's methods became.
dw_with_methods = (declaration: int) -> int[]:
    declarations = [declaration]
    loop method in dw_pending_decls: declarations.push(method)
    dw_pending_decls = []
    declarations

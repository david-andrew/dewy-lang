# Dewy's syntax tree projected into the compact AST.
# This is an explicitly limited source-level experiment, not Sloppy syntax
# accepted under a different extension. Unknown Dewy forms fail at their source.
use 'util.jo'
use 'ast.jo'
use 'lex.jo'
use 'parse.jo'
use 'expr.jo'
use 'arena.jo'
use 'oom.jo'
use 'check.jo'
use 'decimals.jo'
use 'dewy_tokens.jo'
use 'refine.jo'
use 'proofs.jo'
use 'dewy_methods.jo'
use 'effects.jo'
use 'ownership.jo'
use 'dewy_directives.jo'
use 'dewy_ffi.jo'
use 'directives.jo'
use 'targets.jo'
use 'concurrency.jo'

# Compact tags shared by lexical tokens and syntax nodes. Names are needed
# only for formatter/diagnostic text.
enum DewyKind:
    unknown, op, identifier, boolean, metatag, based_string, integer, real,
    quoted, rawquoted, eof, atom, ambiguous, binary, block, combined_assignment,
    flat, flow, interpolated_string, inverted_comparison, keyword, keyword_expr,
    operator, postfix, prefix, string, string_chunk, source_integer, source_real,
    directive, compact_expr, compact_stmt, lazy_body

dw_kind_name = (kind: DewyKind) -> str:
    match kind:
        unknown: "Unknown"
        op: "op"
        identifier: "Identifier"
        boolean: "Bool"
        metatag: "Metatag"
        based_string: "BasedString"
        integer: "Integer"
        source_integer: "Integer"
        real: "Real"
        source_real: "Real"
        quoted: "quoted"
        rawquoted: "rawquoted"
        eof: "eof"
        atom: "Atom"
        ambiguous: "Ambiguous"
        binary: "BinOp"
        block: "Block"
        combined_assignment: "CombinedAssignmentOp"
        flat: "Flat"
        flow: "Flow"
        interpolated_string: "IString"
        inverted_comparison: "InvertedComparisonOp"
        keyword: "Keyword"
        keyword_expr: "KeywordExpr"
        operator: "Operator"
        postfix: "Postfix"
        prefix: "Prefix"
        string: "String"
        string_chunk: "StringChunk"
        directive: "Directive"
        compact_expr: "CompactExpression"
        compact_stmt: "CompactStatement"
        lazy_body: "LazyBody"

struct DewySyntax:
    kind: DewyKind
    text: str
    pos: int
    children: int[]
    symbol: DewyToken = .none
    name: i32 = 0
    # Binary nodes keep their sentinel and operands inline; other nodes use children.
    child_mode: int = 0
    child_left: int = 0
    child_right: int = 0

dewy_syntax: DewySyntax[]
dw_index_context: int[]  # enclosing index nodes, for contextual `end`

dw_child = (id: int, at: int) -> int:
    mode = dewy_syntax[id].child_mode
    if mode == 0: return dewy_syntax[id].children[at]
    if at == 0: return mode - 1
    if at == 1: return dewy_syntax[id].child_left
    dewy_syntax[id].child_right

dw_children = (id: int) -> int[]:
    if dewy_syntax[id].child_mode == 0: return dewy_syntax[id].children
    [dewy_syntax[id].child_mode - 1, dewy_syntax[id].child_left, dewy_syntax[id].child_right]

dw_nchildren = (id: int) -> int:
    if dewy_syntax[id].child_mode != 0: return 3
    dewy_syntax[id].children.len()

dw_multiplications = (id: int) -> int:
    score = if dewy_syntax[id].text == "MultiplyJuxtapose": 1 else: 0
    loop child in dw_children(id): score += dw_multiplications(child)
    score

dw_unwrap = (id: int) -> int:
    let id = id
    loop true:
        if dewy_syntax[id].kind == .atom: id = dw_child(id, 0)
        else if dewy_syntax[id].kind == .ambiguous:
            best = -1
            score = 1000000000
            tied = false
            loop child in dw_children(id):
                next = dw_multiplications(child)
                if next < score:
                    best = child
                    score = next
                    tied = false
                else if next == score: tied = true
            if best < 0 or tied: return dw_fail(id, "an ambiguous expression; use explicit multiplication or parentheses")
            id = best
        else: return id
    id
dw_name = (id: int) -> str:
    let id = dw_unwrap(id)
    if dewy_syntax[id].kind == .identifier: return dewy_syntax[id].text
    ""
# Lexer-interned names pass straight into the compact AST. Legacy and synthetic
# identifier nodes fill this cache on their first use.
dw_name_id = (id: int) -> i32:
    let id = dw_unwrap(id)
    if dewy_syntax[id].kind != .identifier: return 0
    if dewy_syntax[id].name == 0: dewy_syntax[id].name = i32(intern(dewy_syntax[id].text))
    dewy_syntax[id].name

# The compact name of a Dewy identifier used as a value (printl is the library's print).
dw_renamed: int[]               # printl, print, int and the compact names they become
dw_value_name = (name: i32, pos: int) -> i32:
    if dw_renamed.len() == 0: dw_renamed = [intern("printl"), intern("print"), intern("print"), intern("__dewy_print"), intern("int"), intern("__dewy_int")]
    if int(name) == dw_renamed[0]: return i32(dw_renamed[1])
    if int(name) == dw_renamed[2]: return i32(dw_renamed[3])
    if int(name) == dw_renamed[4]: return i32(dw_renamed[5])
    name

# Inside a method, a bare name of one of the object's fields or methods is that member
# of the instance (there is no `self`): it reads through the method's hidden receiver
# parameter. Maps a member name to that receiver's name; locals and parameters shadow it.
dw_siblings: {int: int} = {}
dw_receivers_used: {int: bool} = {}   # receivers a method body reached
dw_pending_decls: int[]               # methods of the type just declared, as module functions

dw_receiver_field = (receiver: int, name: i32, pos: int) -> int:
    dw_receivers_used[receiver] = true
    base = mk(.ident, pos)
    nodes[base].name = i32(receiver)
    n = mk(.field, pos)
    nodes[n].a = i32(base)
    nodes[n].name = name
    n

dw_value_ident = (name: i32, pos: int) -> int:
    deferred = 0
    if dw_siblings.len() > 0:
        if let receiver = dw_siblings.get(int(name)):
            if receiver != 0: return dw_receiver_field(receiver, name, pos)
        else: deferred = dw_siblings.get(dewy_inherited_key()) ?? 0
    n = mk(.ident, pos)
    nodes[n].name = dw_value_name(name, pos)
    if deferred != 0: dewy_defer_name(deferred, n, int(name))
    n

# Names bound from here on hide the members of the same name.
# (with members still unknown, inherited from another module, they are hidden as 0)
dw_shadow = (names: int[]):
    if dw_siblings.len() == 0: return
    deferred = dw_siblings.has(dewy_inherited_key())
    hidden = deferred
    loop name in names:
        if dw_siblings.has(name): hidden = true
    if not hidden: return
    visible: {int: int} = {}
    loop name, receiver in dw_siblings:
        if not names.contains(name): visible[name] = receiver
    if deferred:
        loop name in names: visible[name] = 0
    dw_siblings = visible

# The direct expression frontend builds compact nodes before any method is known:
# rewrite its member names in place.
dw_rewrite_members = (n: int):
    if n == 0: return
    k = nodes[n].kind
    if k == .ident:
        if let receiver = dw_siblings.get(int(nodes[n].name)):
            if receiver == 0: return
            field = dw_receiver_field(receiver, nodes[n].name, nodes[n].pos)
            nodes[field].flags = nodes[n].flags
            nodes[n] = nodes[field]
        else if let type_decl = dw_siblings.get(dewy_inherited_key()): dewy_defer_name(type_decl, n, int(nodes[n].name))
        return
    dw_rewrite_members(int(nodes[n].a))
    if k == .field: return
    # A member call's receiver may be a place, as the direct frontend marks it.
    if k == .call and nodes[int(nodes[n].a)].kind == .field: add_flag(int(nodes[int(nodes[n].a)].a), NF_MUT)
    if k == .call: dewy_defer_callee(int(nodes[n].a))
    dw_rewrite_members(int(nodes[n].b))
    loop child in kids(n): dw_rewrite_members(child)

# `name = (params) => body` among an object's rows: a method.
dw_method_row = (id: int) -> bool:
    let id = dw_unwrap(id)
    if dw_op(id) != .assign: return false
    if dewy_syntax[dw_unwrap(dw_child(id, 1))].kind != .identifier: return false
    dw_op(dw_grouped(dw_child(id, 2))) == .function

# The names of an object's rows, in order.
dw_row_names = (rows: int[]) -> int[]:
    out: int[]
    loop row in rows:
        item = dw_unwrap(row)
        lhs = item
        if dw_op(item) == .assign: lhs = dw_child(item, 1)
        if dw_op(lhs) == .colon: lhs = dw_child(lhs, 1)
        if dw_op(lhs) == .at: lhs = dw_child(lhs, 1)
        name = dw_name_id(lhs)
        dw_reserved_name(dw_name(lhs), lhs)
        if name != 0: out.push(int(name))
    out

# A method's receiver comes first. Its type is the object's (the type parameter
# `object_type` for a record literal's method); whether it is a place is inferred
# from the body before checking (dewy_methods.jo).
dw_add_receiver = (fn_: int, receiver: int, receiver_type: int):
    param = mk(.param, nodes[fn_].pos)
    nodes[param].name = i32(receiver)
    nodes[param].a = i32(receiver_type)
    set_list(fn_, [param] + kids(fn_))

dw_op = (id: int) -> DewyToken:
    let id = dw_unwrap(id)
    kind = dewy_syntax[id].kind
    if kind != .binary and kind != .prefix and kind != .postfix and kind != .flat: return .none
    symbol = dewy_syntax[id].symbol
    if symbol != .none: return symbol
    # Otherwise the operator is represented as a child node.
    if kind == .binary and dewy_syntax[dw_child(id, 0)].kind == .combined_assignment:
        return dn_token_kind(dewy_syntax[dw_child(dw_child(id, 0), 0)].text + "=")
    dewy_syntax[dw_child(id, 0)].symbol

dw_fail = (id: int, what: str) -> int:
    dw_fail_pos(dewy_syntax[id].pos, what)

# (above 0: converting the expression of a string interpolation, `{...}` in a string)
dw_in_interpolation = 0

dw_fail_pos = (pos: int, what: str) -> int:
    if dw_in_interpolation > 0:
        fatal(pos, "Dewy does not yet support {what}, here inside a string interpolation: `\{...}` in a string holds an expression (write `\\\{` and `\\\}` for literal braces, or use a raw string `r\"...\"`; `format(value \".2f\")` formats a number)")
    fatal(pos, "Dewy does not yet support {what}")
    0

# Metatags the design defines that this compiler does not implement yet. Each
# is reported where it is written rather than as a generic syntax error.
dw_designed_directive = (name: str) -> bool:
    name in ["abstract", "field", "lend", "no_prelude", "proof", "unsafe_assume", "__copy__", "__drop__", "__move__"]

# `$target`: the full name of the target being compiled for (docs/LANGUAGE.md,
# "Targets"). A name has only the fields it needs: the processor (or `c`, `wasm32`),
# then the system. A processor alone asks for the current machine, so `$target` is
# never one; `$target.arch` and `$target.os` are its fields.
dw_target_name = () -> str:
    if target_wasm: return "wasm32"
    if target_macos: return "aarch64-mac"
    if target_arm64: return "aarch64-linux"
    if target_windows: return "x86_64-windows"
    "x86_64-linux"

dw_is_target = (id: int) -> bool:
    let id = dw_unwrap(id)
    dewy_syntax[id].kind == .metatag and dewy_syntax[id].text == "target"

dw_is_build = (id: int) -> bool:
    let id = dw_unwrap(id)
    dewy_syntax[id].kind == .metatag and dewy_syntax[id].text == "build"

# `$target` (0), `$target.arch` (1), `$target.os` (2), `$build.mode` (3) or
# `$build.debug` (4, a bool); -1 for anything else. `$build` is the compile-time
# record of how the program is built: its mode, 'release' or 'debug'.
dw_target_field = (id: int) -> int:
    let id = dw_unwrap(id)
    if dw_is_target(id): return 0
    if dw_op(id) != .dot or dw_nchildren(id) != 3: return -1
    member = dw_name(dw_child(id, 2))
    if dw_is_build(dw_child(id, 1)):
        if member == "mode": return 3
        if member == "debug": return 4
        fatal(dewy_syntax[id].pos, "`$build` has `mode` ('release' or 'debug') and `debug` (true in a debug build), not `{member}`")
    if not dw_is_target(dw_child(id, 1)): return -1
    if member == "arch": return 1
    if member == "os": return 2
    -1

# The value of a `$target` or `$build` field.
dw_target_field_value = (field: int) -> str:
    if field == 1: return target_arch_of(dw_target_name())
    if field == 2: return target_os_of(dw_target_name())
    if field == 3: return if release_build: "release" else: "debug"
    if field == 4: return if release_build: "false" else: "true"
    dw_target_name()

# A target name (field 0), processor (1) or system (2) written as a string literal,
# checked against the names the design gives.
dw_target_literal = (id: int, field: int = 0) -> str?:
    let id = dw_unwrap(id)
    if dewy_syntax[id].kind != .string: return none
    name = dewy_syntax[id].text
    pos = dewy_syntax[id].pos
    if field == 3:
        if name != "release" and name != "debug": fatal(pos, "unknown build mode \"{name}\": `$build.mode` is \"release\" or \"debug\"")
        return name
    if field == 1:
        if not (name in target_arches()): fatal(pos, "unknown processor \"{name}\": `$target.arch` is one of {join(target_arches(), ", ")}")
        return name
    if field == 2:
        if not (name in target_oses()): fatal(pos, "unknown system \"{name}\": `$target.os` is one of {join(target_oses(), ", ")}")
        return name
    if not (name in target_names()): fatal(pos, "unknown target \"{name}\": `$target` is one of {join(target_names(), ", ")}")
    if target_os_of(name) == "none" and name != "wasm32" and name != "c89": fatal(pos, "`$target` is a full target name, never \"{name}\" alone (which asks for the current machine): test the processor with `$target.arch =? \"{name}\"`, or name the system too, as \"{name}-linux\"")
    name

# A condition made only of `$target`, `$target.arch` or `$target.os` compared with
# string literals (`=?`, `not =?`, and `in?`/`not in?` a literal list), joined by
# `not`, `and` and `or`, folds here: 1 true, 0 false, -1 any other condition (an
# ordinary runtime test).
dw_target_condition = (id0: int) -> int:
    id = dw_unwrap(id0)
    kind = dewy_syntax[id].kind
    if kind == .block and dewy_syntax[id].text == "():" and dw_nchildren(id) == 1: return dw_target_condition(dw_child(id, 0))
    op = dw_op(id)
    if kind == .prefix and op == .kw_not:
        inner = dw_target_condition(dw_child(id, 1))
        return if inner < 0: -1 else: 1 - inner
    if dw_target_field(id) == 4: return if release_build: 0 else: 1
    if kind != .binary: return -1
    if op == .kw_and or op == .kw_or:
        left = dw_target_condition(dw_child(id, 1))
        if left < 0: return -1
        right = dw_target_condition(dw_child(id, 2))
        if right < 0: return -1
        return if op == .kw_and: left & right else: left | right
    inverted = dewy_syntax[dw_child(id, 0)].kind == .inverted_comparison or op == .not_eq or op == .not_contains
    left = dw_child(id, 1)
    right = dw_child(id, 2)
    found = false
    if op == .eq or op == .not_eq:
        if dw_target_field(right) >= 0:
            right = left
            left = dw_child(id, 2)
        field = dw_target_field(left)
        if field < 0 or field == 4: return -1
        name = dw_target_literal(right, field) ?? ""
        if len(name) == 0: return -1
        found = name == dw_target_field_value(field)
    else if op == .contains or op == .not_contains:
        field = dw_target_field(left)
        if field < 0: return -1
        list = dw_unwrap(right)
        if dewy_syntax[list].kind != .block or dewy_syntax[list].text != "[]:": return -1
        loop entry in dw_children(list):
            name = dw_target_literal(entry, field) ?? ""
            if len(name) == 0: return -1
            if name == dw_target_field_value(field): found = true
    else: return -1
    if inverted: found = not found
    if found: 1 else: 0

# An `if` chain whose every condition is a folded `$target` test: the syntax of the
# compiled arm's body (0 when no arm is compiled), or -1. The other arms are never
# lowered or checked, so they may name declarations and imports of other targets.
dw_target_live = (id0: int) -> int:
    id = dw_unwrap(id0)
    if dewy_syntax[id].kind != .flow: return -1
    items = dw_children(id)
    loop arm in items:
        if dewy_syntax[arm].kind != .keyword_expr: return arm
        if dewy_syntax[dw_child(arm, 0)].text != "if" or dw_nchildren(arm) != 3: return -1
        fold = dw_target_condition(dw_child(arm, 1))
        if fold < 0: return -1
        if fold == 1: return dw_child(arm, 2)
    0

# Statements with each `$target` chain replaced by its compiled arm's statements,
# which bind in the enclosing scope.
dw_target_splice = (items: int[]) -> int[]:
    out: int[]
    loop item in items:
        live = dw_target_live(item)
        if live < 0:
            out.push(item)
            continue
        if live == 0: continue
        body = dw_unwrap(live)
        inner = [live]
        if dewy_syntax[body].kind == .block and dewy_syntax[body].text == "{{}}:": inner = dw_children(body)
        loop statement in dw_target_splice(inner): out.push(statement)
    out

# `$supported_targets = ["x86_64-linux" ...]`: the targets a module accepts, by full name.
dw_targets_listed: {int: bool} = {}   # files that set it
dw_supported_targets = (tag: int, declaration: int):
    pos = dewy_syntax[tag].pos
    if tag == declaration: fatal(pos, "`$supported_targets` lists the module's targets: `$supported_targets = [\"x86_64-linux\" \"wasm32\"]`")
    list = dw_unwrap(dw_child(declaration, 2))
    if dewy_syntax[list].kind != .block or dewy_syntax[list].text != "[]:": fatal(dewy_syntax[list].pos, "`$supported_targets` takes a literal list of target names: `[\"x86_64-linux\" \"wasm32\"]`")
    names: str[]
    loop entry in dw_children(list):
        name = dw_target_literal(entry) ?? ""
        if len(name) == 0: fatal(dewy_syntax[entry].pos, "`$supported_targets` lists target names as string literals")
        names.push(name)
    file = pos_file(pos)
    if dw_targets_listed.has(file): fatal(pos, "`$supported_targets` may be set only once per module")
    dw_targets_listed[file] = true
    if not (dw_target_name() in names):
        listed = if names.len() == 0: "no target" else: join(names, ", ")
        fatal(pos, "this module supports {listed}, not {dw_target_name()}, the target being compiled for")

dw_unimplemented = (id: int, name: str) -> int:
    fatal(dewy_syntax[id].pos, "`${name}` is part of the design but not implemented yet")
    0

# A metatag where no metatag form fits: name the directive precisely.
dw_metatag_fail = (id: int) -> int:
    name = dewy_syntax[id].text
    pos = dewy_syntax[id].pos
    if name == "supported_targets" or name == "explicit_allocation_failure": fatal(pos, "`${name}` is a module directive; put it at file scope")
    if dir_builtin(name): fatal(pos, "`${name}` is a setting: write it on a line of its own in a module, function body or block")
    if name == "test": fatal(pos, "`$test` goes alone on the line just before a module-level function declaration")
    if name == "shadowable": fatal(pos, "`$shadowable` marks a module-level const: `$shadowable const name = ...` at the top of the file")
    if name == "expect" or name == "fail": fatal(pos, "`${name}` is a statement in a function: a test, or a helper a test calls")
    if dw_designed_directive(name): return dw_unimplemented(id, name)
    if name == "capture": fatal(pos, "`$capture` belongs in a parameter list before a name: `($capture @count) => ...`")
    if name == "include_bytes": fatal(pos, "`$include_bytes` takes one path literal: `$include_bytes(p\"asset.png\") as image`")
    fatal(pos, "unknown directive `${name}` (a loop label goes on its own line just before its loop)")
    0

# `$allocator(@arena) expression` (docs/LANGUAGE.md, "Scoped allocators"): the
# expression allocates from the arena, the context allocator until it ends, and its
# value leaves with storage of the enclosing allocator's:
#     { let c=__arena_enter(@arena)  let v=expression  __arena_leave(c)  $allocator_result(v) }
# compiler/arena.jo checks that nothing else the expression makes outlives it.
dw_allocators = 0
dw_allocator = (id: int) -> int:
    pos = dewy_syntax[id].pos
    arena = dw_unwrap(dw_child(id, 0))
    if dw_op(arena) != .at: fatal(dewy_syntax[arena].pos, "`$allocator` lends an arena by its place: `$allocator(@scratch) expression`")
    arena_enable()
    dw_allocators += 1
    context = "__arena_context{dw_allocators}"
    value = "__arena_value{dw_allocators}"
    body = dw_expr(dw_child(id, 2))
    arena_no_return(body)
    # (the value itself, even a function: a closure is reported as what cannot leave)
    result = bc_ident(value, pos)
    nodes[result].aux2 = 1
    bc_block([bc_let(context, bc_call("__arena_enter", [dw_expr(arena)], pos), pos), bc_let(value, body, pos),
        bc_stmt(bc_call("__arena_leave", [bc_ident(context, pos)], pos), pos), bc_stmt(bc_call("$allocator_result", [result, bc_bool(dw_copy_result(dw_child(id, 2)), pos)], pos), pos)], pos)

# (an expression whose value is written `....copy()`: the copy out of the arena is asked for,
# as `$explicit_copies` wants)
dw_copy_result = (id0: int) -> bool:
    id = dw_unwrap(id0)
    if dewy_syntax[id].kind == .block and dewy_syntax[id].text == "{{}}:":
        items = dw_children(id)
        if items.len() == 0: return false
        return dw_copy_result(items[items.len() - 1])
    if dw_op(id) == .call: id = dw_unwrap(dw_child(id, 1))
    dw_op(id) == .dot and dw_name(dw_child(id, 2)) == "copy"

# `$assert`/`$runtime_assert` become calls of internal intrinsics whose names
# no program can shadow; unimplemented directive forms are reported here.
dw_directive = (id: int) -> int:
    name = dewy_syntax[id].text
    pos = dewy_syntax[id].pos
    if name == "expect" or name == "fail": fatal(pos, "`${name}` is a statement: it returns from its function when it fails, so it cannot give a value")
    if name == "lend":
        owner = dw_expr(dw_child(id, 0))
        reservation = if dw_child(id, 1) != 0: dw_expr(dw_child(id, 1)) else: bc_int(0, pos)
        return bc_call("$lend", [owner, reservation, dw_expr(dw_child(id, 2))], pos)
    if name == "allocator": return dw_allocator(id)
    if name == "breakpoint": return bc_call("$breakpoint", [], pos)
    if name != "assert" and name != "runtime_assert": return dw_unimplemented(id, name)
    condition = dw_child(id, 0)
    message = dw_child(id, 1)
    args = [dw_expr(condition)]
    if message != 0:
        if name == "assert" and dewy_syntax[dw_unwrap(message)].kind != .string: fatal(dewy_syntax[message].pos, "a `$assert` message is a string literal: the compiler reports it")
        args.push(dw_expr(message))
    else if name == "runtime_assert":
        text = mk(.str_lit, pos)
        nodes[text].sval = i32(intern("assertion failed: " + join(words(dewy_syntax[dw_child(id, 2)].text), " ")))
        args.push(text)
    callee = mk(.ident, pos)
    nodes[callee].name = i32(intern("$" + name))
    call = mk(.call, pos)
    nodes[call].a = i32(callee)
    set_list(call, args)
    call

# ---- tests: `$test`, `$expect`, `$fail` ----

# What the function being parsed gives: 0 outside any function, 1 nothing (or not
# said), 2 a value. Expectations return from their function when they fail.
dw_fn_result = 0

# `$expect condition [, message]` and `$fail [message]`: when the condition is
# false (always, for `$fail`), report it, count it and return from the function:
# `if not condition { __expect_fail(…) return }`. The code after an expectation
# may assume it, as after any guard that returns.
dw_expect = (id: int) -> int:
    name = dewy_syntax[id].text
    pos = dewy_syntax[id].pos
    if dw_fn_result == 0: fatal(pos, "`${name}` belongs in a function: a test, or a helper a test calls")
    if dw_fn_result == 2: fatal(pos, "`${name}` returns from its function when it fails, and this function gives a value: expectations live in `void` functions (a test, or a helper it calls); return the value to the test that checks it")
    condition = dw_child(id, 0)
    message = dw_child(id, 1)
    text = dw_child(id, 2)
    described = ""
    if text != 0: described = join(words(dewy_syntax[text].text), " ")
    where = pos
    shown = ""
    if condition != 0:
        where = dewy_syntax[dw_unwrap(condition)].pos
        line = source_line(where)
        l, c = line_col(where)
        if len(line) > 0:
            caret = ""
            loop i in [0..c - 1):
                if i < len(line) and line[i] == '\t': caret += "\t"
                else: caret += " "
            width = max(1, min(len(described), len(line) - (c - 1)))
            caret += "^"
            loop i in [1..width): caret += "~"
            shown = "    {line}\n    {caret}"
    report = mk(.call, pos)
    callee = mk(.ident, pos)
    nodes[callee].name = i32(intern("__expect_fail"))
    nodes[report].a = i32(callee)
    said = dw_text("", pos)
    if message != 0: said = dw_expr(message)
    set_list(report, [dw_text(pos_str(pos), pos), dw_text(described, pos), dw_text(shown, pos), said, dw_expect_notes(condition, pos, described)])
    statement = mk(.exprstmt, pos)
    nodes[statement].a = i32(report)
    failed = mk(.block, pos)
    set_list(failed, [statement, mk(.return_, pos)])
    if condition == 0: return failed
    n = mk(.if_, pos)
    negated = mk(.not_, pos)
    nodes[negated].a = i32(dw_expr(condition))
    nodes[n].a = i32(negated)
    nodes[n].b = i32(failed)
    add_flag(n, NF_STMT)
    expectation_ifs[n] = true
    n

dw_text = (text: str, pos: int) -> int:
    n = mk(.str_lit, pos)
    nodes[n].sval = i32(intern(text))
    n

# A comparison's operands that are places (names, members, constant indices) are
# shown with their values when it fails: `note: xs.length is 0`. Other operands
# (calls) are not evaluated again.
dw_expect_notes = (condition: int, pos: int, described: str = "") -> int:
    if condition == 0: return dw_text("", pos)
    let id = dw_unwrap(condition)
    op = dw_op(id)
    if not (op == .eq or op == .not_eq or op == .lt or op == .le or op == .gt or op == .ge) or dw_nchildren(id) != 3: return dw_text("", pos)
    n = mk(.str_lit, pos)
    nodes[n].aux = 1
    pieces: int[]
    # (other operands than names and members, as written: `to_roman(40)`, `x+1`)
    texts = dw_comparison_sides(described, op)
    loop i in 0.. and side in [dw_child(id, 1), dw_child(id, 2)]:
        shown = dw_operand_text(side)
        if shown == "" and not dw_literal_operand(side) and texts.len() == 2: shown = texts[i]
        if shown == "": continue
        lead = "note: "
        if pieces.len() > 0: lead = "\nnote: "
        pieces.push(dw_text("{lead}{shown} is ", pos))
        part = mk(.pair, pos)
        nodes[part].a = i32(dw_expr(side))
        nodes[part].sval = -1
        pieces.push(part)
    if pieces.len() == 0: return dw_text("", pos)
    set_list(n, pieces)
    n

# a literal operand needs no note: its value is what is written
dw_literal_operand = (id: int) -> bool:
    let id = dw_unwrap(id)
    k = dewy_syntax[id].kind
    if dw_integer_kind(k) or k == .real or k == .source_real or k == .boolean or k == .string or k == .quoted or k == .rawquoted or k == .based_string: return true
    if k == .identifier and dewy_syntax[id].text in ["none", "true", "false"]: return true
    if dewy_syntax[id].kind == .prefix and dw_op(id) == .minus: return dw_literal_operand(dw_child(id, 1))
    # ([2 5]: a literal array of literals)
    if k == .block and dewy_syntax[id].text == "[]:":
        loop child in dw_children(id):
            if not dw_literal_operand(child): return false
        return true
    false

# The two operands of a comparison as written, split at its operator outside
# brackets and quotes ([] when the operator is not found once).
dw_comparison_sides = (text: str, op: DewyToken) -> str[]:
    spelled = dn_token_text(op)
    depth = 0
    quote: u8 = 0
    at = -1
    i = 0
    loop i < len(text):
        c = text[i]
        if quote != 0:
            if c == '\\': i += 1
            else if c == quote: quote = 0
        else if c == '"' or c == '\'': quote = c
        else if c == '(' or c == '[' or c == '{': depth += 1
        else if c == ')' or c == ']' or c == '}': depth -= 1
        else if depth == 0 and i + len(spelled) <= len(text) and text[i..i + len(spelled)) == spelled:
            # (`<?` inside `<=?`, `=?` inside `not=?`: the whole operator only)
            before = if i > 0: text[i - 1] else: u8(' ')
            negated = i >= 3 and text[i - 3..i) == "not"
            if before != '<' and before != '>' and before != '=' and before != '.' and not negated:
                if at >= 0: return []
                at = i
                i += len(spelled)
                continue
        i += 1
    if at < 0: return []
    [trim(text[0..at)), trim(text[at + len(spelled)..len(text)))]

dw_operand_text = (id: int) -> str:
    let id = dw_unwrap(id)
    if dewy_syntax[id].kind == .identifier:
        text = dewy_syntax[id].text
        if text == "none": return ""
        return text
    op = dw_op(id)
    if op == .dot and dw_nchildren(id) == 3 and dewy_syntax[dw_child(id, 2)].kind == .identifier:
        base = dw_operand_text(dw_child(id, 1))
        if base != "": return "{base}.{dewy_syntax[dw_child(id, 2)].text}"
    if op == .index and dw_nchildren(id) == 3:
        base = dw_operand_text(dw_child(id, 1))
        indices: str[]
        loop index in dw_children(dw_child(id, 2)):
            let index = dw_unwrap(index)
            if dw_integer_kind(dewy_syntax[index].kind): indices.push(dewy_syntax[index].text)
            else:
                inner = dw_operand_text(index)
                if inner == "": return ""
                indices.push(inner)
        if base != "" and indices.len() > 0: return "{base}[{join(indices, " ")}]"
    ""

# `$shadowable` before a module-level `const`
dw_shadowable_tag = (id: int) -> int:
    if id <= 0 or dewy_syntax[id].kind == .compact_stmt: return 0
    let id = dw_unwrap(id)
    if dewy_syntax[id].kind == .metatag and dewy_syntax[id].text == "shadowable": return id
    0

# `$test` or `$test(cases=…)`: a line of its own before a module function
dw_test_tag = (id: int) -> int:
    if id <= 0 or dewy_syntax[id].kind == .compact_stmt: return 0
    let id = dw_unwrap(id)
    if dewy_syntax[id].kind == .metatag and dewy_syntax[id].text == "test": return id
    if dn_token_call(dw_op(id)) and dw_nchildren(id) == 3:
        callee = dw_unwrap(dw_child(id, 1))
        if dewy_syntax[callee].kind == .metatag and dewy_syntax[callee].text == "test": return id
    0

# The test a `$test` line declares, its function still to come: one block of
# arguments per case (positional values, or an object's fields by name), or for a
# computed array, the array (`a`); `ival` 1 when cases are given.
dw_test_spec = (id: int) -> int:
    pos = dewy_syntax[id].pos
    n = mk(.test_, pos)
    nodes[n].aux = 1
    if dewy_syntax[id].kind == .metatag: return n
    usage = "`$test` takes its cases as `$test(cases=(1 2 3))` or `$test(cases=[[a=1 b=2] [a=3 b=4]])`"
    items = dw_children(dw_child(id, 2))
    if items.len() != 1: fatal(pos, usage)
    item = dw_unwrap(items[0])
    if dw_op(item) != .assign or dw_name(dw_child(item, 1)) != "cases": fatal(dewy_syntax[item].pos, usage)
    nodes[n].ival = 1
    value = dw_unwrap(dw_child(item, 2))
    if dewy_syntax[value].kind != .block or (dewy_syntax[value].text != "():" and dewy_syntax[value].text != "[]:"):
        nodes[n].a = i32(dw_expr(value))
        return n
    cases: int[]
    loop element in dw_children(value):
        let element = dw_unwrap(element)
        args: int[]
        fields = dw_children(element)
        named = dewy_syntax[element].kind == .block and dewy_syntax[element].text == "[]:" and fields.len() > 0
        loop field in fields:
            if dw_op(dw_unwrap(field)) != .assign: named = false
        if named:
            loop field in fields: args.push(dw_record_entry(dw_unwrap(field)))
        else: args.push(dw_expr(element))
        case = mk(.block, dewy_syntax[element].pos)
        set_list(case, args)
        cases.push(case)
    if cases.len() == 0: fatal(dewy_syntax[value].pos, "`$test(cases=…)` needs at least one case")
    set_list(n, cases)
    n

# The function a `$test` line marks: it names the test, and its parameters must
# take the cases (or there are none, and no cases).
dw_test_attach = (marked: int, declarations: int[]):
    pos = nodes[marked].pos
    if declarations.len() == 0 or nodes[declarations[0]].kind != .fn_: fatal(pos, "`$test` marks a module-level function: put it on the line just before one (`$test` then `let adds = () => $expect add(1 2) =? 3`)")
    f = declarations[0]
    nodes[marked].name = nodes[f].name
    nodes[marked].sval = nodes[f].name
    cased = nodes[marked].ival == 1
    if nkids(f) > 0 and not cased: fatal(pos, "the test '{name_of(int(nodes[f].name))}' takes parameters: give it cases, `$test(cases=…)`")
    if nkids(f) == 0 and cased: fatal(pos, "the test '{name_of(int(nodes[f].name))}' takes no parameters, so it cannot be given cases")

# The syntax parser has already recognized the digits and base. Accumulate with
# an explicit limit so neither overflow nor a high unsigned bit changes a value.
dw_digits = (text: str) -> str:
    digits = text[3..]
    if starts_with(lower(digits), text[..2)): digits = digits[2..]
    digits

dw_alphabet = (text: str, id: int) -> str:
    alphabet = ""
    match text[..3):
        "0b:": alphabet = "01"
        "0t:": alphabet = "012"
        "0q:": alphabet = "0123"
        "0s:": alphabet = "012345"
        "0o:": alphabet = "01234567"
        "0d:": alphabet = "0123456789"
        "0z:": alphabet = "0123456789xe"
        "0x:": alphabet = "0123456789abcdef"
        _: dw_fail(id, "this numeric base")
    alphabet

# `count ?? 0 + 1` is `count ?? (0 + 1)`: arithmetic binds more tightly than
# `??`. A literal fallback followed by arithmetic usually meant the other tree.
dw_coalesce_arithmetic = (left: int, right: int):
    first = dw_unwrap(right)
    op = DewyToken.none
    rest = 0
    loop dewy_syntax[first].kind == .binary:
        o = dw_op(first)
        if o != .plus and o != .minus and o != .star and o != .slash and o != .floor and o != .percent: break
        op = o
        rest = dw_child(first, 2)
        first = dw_unwrap(dw_child(first, 1))
    if op == .none: return
    k = dewy_syntax[first].kind
    if not dw_integer_kind(k) and k != .real and k != .source_real: return
    name = dw_operand_text(left)
    if name == "": name = "value"
    lit = dewy_syntax[first].text
    r = dw_unwrap(rest)
    rk = dewy_syntax[r].kind
    tail = if rk == .identifier or dw_integer_kind(rk) or rk == .real or rk == .source_real: dewy_syntax[r].text else: "..."
    sym = dn_token_text(op)
    warn(dewy_syntax[right].pos, "arithmetic binds more tightly than `??`, so this fallback includes `{lit} {sym} {tail}`, not just `{lit}`: write `({name} ?? {lit}) {sym} {tail}` to use the chosen value, or `{name} ?? ({lit} {sym} {tail})` to keep this meaning")

dw_integer_kind = (kind: DewyKind) -> bool:
    kind == .integer or kind == .source_integer

dw_unsigned = (text: str, id: int) -> u64?:
    if dewy_syntax[id].kind == .source_integer:
        value: u64 = 0
        loop c in text:
            if c == '_': continue
            digit = u64(c - '0')
            if value > 1844674407370955161 or (value == 1844674407370955161 and digit > 5): return none
            value = value * 10 + digit
        return value
    alphabet = dw_alphabet(text, id)
    base = u64(len(alphabet))
    value: u64 = 0
    loop c in lower(dw_digits(text)):
        if c == '_': continue
        digit = find_byte(alphabet, c)
        if digit < 0: fatal(dewy_syntax[id].pos, "invalid numeric digit")
        if value > (0xFFFFFFFFFFFFFFFF - u64(digit)) / base:
            return none
        value = value * base + u64(digit)
    value

# Only modules that use a large literal import the exact-integer library. The
# alias contains a character that cannot occur in a user identifier.
dw_bigint_import = 0
const DW_BIGINT_ALIAS = "$dewy_bigint"

dw_finish_declarations = (declarations: int[]) -> int[]:
    if dw_bigint_import == 0: return declarations
    [dw_bigint_import] + declarations

dw_bigint_value = (limbs: u64[], pos: int, negative: bool = false) -> int:
    if dw_bigint_import == 0:
        dw_bigint_import = mk(.import_, pos)
        nodes[dw_bigint_import].aux2 = 1
        nodes[dw_bigint_import].sval = i32(intern("@lib/bigint.dewy"))
        nodes[dw_bigint_import].name = i32(intern(DW_BIGINT_ALIAS))
    owner = mk(.ident, pos)
    nodes[owner].name = i32(intern(DW_BIGINT_ALIAS))
    callee = mk(.field, pos)
    nodes[callee].a = i32(owner)
    nodes[callee].name = i32(intern("BigInt"))
    sign = mk(.int_lit, pos)
    nodes[sign].ival = if negative: -1 else: 1
    add_flag(sign, NF_LITERAL)
    sign_arg = mk(.namedarg, pos)
    nodes[sign_arg].name = i32(intern("_sign"))
    nodes[sign_arg].a = i32(sign)
    items: int[]
    loop limb in limbs:
        item = mk(.int_lit, pos)
        nodes[item].ival = int(limb)
        add_flag(item, NF_LITERAL)
        items.push(item)
    magnitude = mk(.array, pos)
    set_list(magnitude, items)
    magnitude_arg = mk(.namedarg, pos)
    nodes[magnitude_arg].name = i32(intern("_limbs"))
    nodes[magnitude_arg].a = i32(magnitude)
    result = mk(.call, pos)
    nodes[result].a = i32(callee)
    set_list(result, [sign_arg, magnitude_arg])
    nodes[result].aux2 = -1       # oversized literal; the checker requires an explicit BigInt context
    result

dw_big_integer = (text: str, id: int) -> int:
    decimal = dewy_syntax[id].kind == .source_integer
    alphabet = if decimal: "0123456789" else: dw_alphabet(text, id)
    digits = if decimal: text else: lower(dw_digits(text))
    base = u64(len(alphabet))
    limbs: u64[]
    loop c in digits:
        if c == '_': continue
        digit = find_byte(alphabet, c)
        if digit < 0: fatal(dewy_syntax[id].pos, "invalid numeric digit")
        carry = u64(digit)
        loop i in [0..limbs.len()):
            word = limbs[i] * base + carry
            limbs[i] = word & 0xFFFFFFFF
            carry = word >> 32
        if carry != 0: limbs.push(carry)
    dw_bigint_value(limbs, dewy_syntax[id].pos)

# Power-of-two based strings pack digits most-significant-bit first. The final
# partial byte is zero padded, as in the existing Dewy literal design.
dw_binary = (id: int) -> int:
    text = dewy_syntax[id].text
    prefix = text[..3)
    alphabet = ""
    width = 0
    match prefix:
        "0b:": alphabet = "01"; width = 1
        "0q:": alphabet = "0123"; width = 2
        "0o:": alphabet = "01234567"; width = 3
        "0x:": alphabet = "0123456789abcdef"; width = 4
        "0u:": alphabet = "0123456789abcdefghijklmnopqrstuv"; width = 5
        "0g:": alphabet = "0123456789abcdefghijklmnopqrstuvwxyzABCDEFGHIJKLMNOPQRSTUVWXYZ+/"; width = 6
        _: return dw_fail(id, "this based-string packing")
    digits = text[3..]
    if width != 6: digits = lower(digits)
    pending = 0
    bits = 0
    padded = false
    packed: u8[]
    loop c in digits:
        if c == '_' and width != 6: continue
        if c == '=' and width == 6: padded = true; continue
        if padded: fatal(dewy_syntax[id].pos, "based-string padding must be at the end")
        digit = find_byte(alphabet, c)
        if width == 6 and c == '-': digit = 62
        if width == 6 and c == '_': digit = 63
        if digit < 0: fatal(dewy_syntax[id].pos, "invalid based-string digit")
        pending = (pending << width) | digit
        bits += width
        if bits >= 8:
            bits -= 8
            packed.push(u8(pending >> bits))
            pending &= (1 << bits) - 1
    if bits > 0: packed.push(u8(pending << (8 - bits)))
    pos = dewy_syntax[id].pos
    value = mk(.str_lit, pos)
    nodes[value].sval = i32(intern(str_from_bytes(packed)))
    callee = mk(.ident, pos)
    nodes[callee].name = i32(intern("bytes"))
    call = mk(.call, pos)
    nodes[call].a = i32(callee)
    set_list(call, [value])
    call

dw_is_include = (id: int) -> bool:
    if not dn_token_call(dw_op(id)): return false
    tag = dw_unwrap(dw_child(id, 1))
    dewy_syntax[tag].kind == .metatag and dewy_syntax[tag].text == "include_bytes"

dw_include = (id: int) -> int:
    arg = dw_unwrap(dw_child(id, 2))
    if dewy_syntax[arg].kind != .block or dw_nchildren(arg) != 1:
        return dw_fail(id, "$include_bytes without one literal path")
    path = dw_unwrap(dw_child(arg, 0))
    if dw_op(path) != .call or dw_name(dw_child(path, 1)) != "p":
        return dw_fail(path, "$include_bytes without a p\"path\" literal")
    path = dw_unwrap(dw_child(path, 2))
    if dewy_syntax[path].kind != .string: return dw_fail(path, "a nonliteral asset path")
    callee = mk(.ident, dewy_syntax[id].pos)
    nodes[callee].name = i32(intern("embed"))
    call = mk(.call, dewy_syntax[id].pos)
    nodes[call].a = i32(callee)
    set_list(call, [dw_expr(path)])
    call

# Annotation membership retains its exact endpoint flags; ordinary membership
# may lower an exclusive-start range to a runtime range object.
dw_ref_predicate = (id: int) -> int:
    entry = dw_grouped(id)
    op = dw_op(entry)
    if op == .kw_and:
        n = mk(.and_, dewy_syntax[entry].pos)
        nodes[n].a = i32(dw_ref_predicate(dw_child(entry, 1)))
        nodes[n].b = i32(dw_ref_predicate(dw_child(entry, 2)))
        return n
    if op == .contains:
        n = mk(.binary, dewy_syntax[entry].pos)
        nodes[n].op = i32(int(Tok.kw_in))
        nodes[n].a = i32(dw_expr(dw_child(entry, 1)))
        nodes[n].b = i32(dw_iterable(dw_child(entry, 2), true, true))
        return n
    dw_expr(entry)

# Effect suffixes belong to the callable, never to the returned value type.
# sval on fn_/lambda/tfn is an immutable syntax-row ID; clone preserves it.
dw_effect_path = (id0: int) -> int[]:
    id = dw_unwrap(id0)
    if dw_op(id) == .dot:
        out = dw_effect_path(dw_child(id, 1))
        name = dw_name(dw_child(id, 2))
        if name == "": fatal(dewy_syntax[id].pos, "effect projection needs a field name")
        out.push(intern(name))
        return out
    name = dw_name(id)
    if name == "": fatal(dewy_syntax[id].pos, "effect row needs a place name")
    [intern(name)]

dw_effect_atom = (id0: int, entries: mut EffectSyntax[], empty: mut bool, negated: bool = false):
    id = dw_unwrap(id0)
    # (`no allocates & no blocks`: in a row, `no` reaches only to the next `&`)
    if dw_op(id) == .kw_not and not negated and dw_op(dw_unwrap(dw_child(id, 1))) == .amp:
        chain = dw_unwrap(dw_child(id, 1))
        dw_effect_atom(dw_child(chain, 1), entries, empty, true)
        dw_effect_atom(dw_child(chain, 2), entries, empty)
        return
    if negated and dw_op(id) == .amp:
        dw_effect_atom(dw_child(id, 1), entries, empty, true)
        dw_effect_atom(dw_child(id, 2), entries, empty)
        return
    if dw_name(id) == "no_effects":
        if empty or entries.len() != 0: fatal(dewy_syntax[id].pos, "no_effects cannot be combined with another effect permission")
        empty = true
        return
    if empty: fatal(dewy_syntax[id].pos, "no_effects cannot be combined with another effect permission")
    negative = negated or dw_op(id) == .kw_not
    if negative and not negated: id = dw_unwrap(dw_child(id, 1))
    if negative and (dw_name(id) == "reads" or dw_name(id) == "mutates"):
        entries.push(EffectSyntax(if dw_name(id) == "reads": EffectKind.read else: EffectKind.write, [], dewy_syntax[id].pos, true))
        return
    if dw_name(id) == "allocates":
        entries.push(EffectSyntax(.alloc, [], dewy_syntax[id].pos, negative))
        return
    # (`blocks` is inferred: a row only excludes it)
    if dw_name(id) == "blocks":
        if not negative: fatal(dewy_syntax[id].pos, "`blocks` is inferred, never granted: a row can only exclude it, `& no blocks`")
        entries.push(EffectSyntax(.block, [], dewy_syntax[id].pos, true))
        effect_blocks_demanded = true
        return
    if dw_name(id) != "":
        entries.push(EffectSyntax(.opaque, [intern(dw_name(id))], dewy_syntax[id].pos, negative, true))
        return
    if dw_op(id) != .type_apply: fatal(dewy_syntax[id].pos, "effect pilot requires reads<place>, mutates<place>, or no_effects")
    name = dw_name(dw_child(id, 1))
    if name != "reads" and name != "mutates": fatal(dewy_syntax[id].pos, "effect pilot requires reads<place>, mutates<place>, or no_effects")
    args = dw_child(id, 2)
    if dw_nchildren(args) != 1: fatal(dewy_syntax[id].pos, "effect permission needs exactly one place")
    kind = if name == "reads": EffectKind.read else: EffectKind.write
    entries.push(EffectSyntax(kind, dw_effect_path(dw_child(args, 0)), dewy_syntax[id].pos, negative))

# (an effect row's syntax: no_effects, allocates, no ..., reads<...>, mutates<...>)
dw_effect_syntax = (id0: int) -> bool:
    id = dw_unwrap(id0)
    name = dw_name(id)
    name == "no_effects" or name == "allocates" or name == "blocks" or dw_op(id) == .kw_not or dw_op(id) == .type_apply and (dw_name(dw_child(id, 1)) == "reads" or dw_name(dw_child(id, 1)) == "mutates")

dw_effect_result = (id: int, entries: mut EffectSyntax[], empty: mut bool) -> int:
    # (`:>int64|Oops & no_effects`: `&` binds the row to the last alternative only)
    if dw_op(id) == .pipe:
        last = dw_unwrap(dw_child(id, 2))
        if dw_op(last) == .amp and dw_effect_syntax(dw_child(last, 2)): fatal(dewy_syntax[last].pos, "effects describe the whole result: parenthesize the alternatives before them, `:>(A | B) & no_effects`")
    if dw_op(id) != .amp: return id
    # Scalar refinement intersection is still part of the return type.
    if dw_op(dw_grouped(dw_child(id, 2))) == .tilde: return id
    right = dw_unwrap(dw_child(id, 2))
    if dewy_syntax[right].kind == .block and dewy_syntax[right].text == "<>:": return id
    base = dw_effect_result(dw_child(id, 1), entries, empty)
    dw_effect_atom(dw_child(id, 2), entries, empty)
    base

dw_effect_suffix = (owner: int, result: int) -> int:
    entries: EffectSyntax[]
    empty = false
    base = dw_effect_result(result, entries, empty)
    if base != result:
        effects_active = true
        effect_syntax.push(entries)
        nodes[owner].sval = i32(effect_syntax.len() - 1)
    base

# Surface type spellings share one translation in both construction paths.
dw_type_name = (name: str) -> str:
    if name == "addr": refine_active = true
    if name == "int64": return "i64"
    else if name == "uint64": return "u64"
    else if name == "int32": return "i32"
    else if name == "uint32": return "u32"
    else if name == "int16": return "i16"
    else if name == "uint16": return "u16"
    else if name == "int8": return "i8"
    else if name == "uint8": return "u8"
    else if name == "float64": return "f64"
    else if name == "float32": return "f32"
    else if name == "string": return "str"
    else if name == "set": return "Set"
    else if name == "int": return "__dewy_int"
    name

# `-1|0|1`, `x:5`: integer singletons in a type position
dw_int_singletons = (id0: int, out: mut int[]) -> bool:
    id = dw_grouped(dw_unwrap(id0))
    k = dewy_syntax[id].kind
    if dw_op(id) == .pipe: return dw_int_singletons(dw_child(id, 1), out) and dw_int_singletons(dw_child(id, 2), out)
    byte = dw_byte_char(id)
    if byte >= 0:
        if not out.contains(byte): out.push(byte)
        return true
    literal = dw_integer_kind(k) or k == .prefix and dw_op(id) == .minus and dw_integer_kind(dewy_syntax[dw_unwrap(dw_child(id, 1))].kind)
    if not literal: return false
    e = dw_expr(id)
    if nodes[e].kind != .int_lit or has_flag(e, NF_U64): return dw_fail(id, "an integer singleton outside int64") != 0
    if not out.contains(nodes[e].ival): out.push(nodes[e].ival)
    true

# The leaves of a `|` chain of types (through grouping)
dw_pipe_leaves = (id0: int, out: mut int[]):
    id = dw_grouped(dw_unwrap(id0))
    if dw_op(id) == .pipe:
        dw_pipe_leaves(dw_child(id, 1), out)
        dw_pipe_leaves(dw_child(id, 2), out)
    else: out.push(id)

dw_int_leaf = (id: int) -> bool:
    k = dewy_syntax[id].kind
    dw_byte_char(id) >= 0 or dw_integer_kind(k) or k == .prefix and dw_op(id) == .minus and dw_integer_kind(dewy_syntax[dw_unwrap(dw_child(id, 1))].kind)

# A type made of literals, alone or mixed with other types (`'a'|'b'`,
# `<1 | 2 | "fast">`, `'auto' | int64`): the integer singletons become one
# refined int64, the strings one string set, joined with the other members in a
# union. 0 when the type names no literal.
dw_literal_type = (id: int) -> int:
    single = dw_grouped(dw_unwrap(id))
    if dw_op(single) != .pipe and not dw_int_leaf(single) and dewy_syntax[single].kind != .string: return 0
    leaves: int[]
    dw_pipe_leaves(id, leaves)
    any = false
    loop leaf in leaves:
        if dw_int_leaf(leaf) or dewy_syntax[leaf].kind == .string: any = true
    if not any: return 0
    pos = dewy_syntax[id].pos
    ints: int[]
    texts: str[]
    others: int[]
    written: str[]
    loop leaf in leaves:
        if dw_int_leaf(leaf):
            before = ints.len()
            dw_int_singletons(leaf, ints)
            if ints.len() > before: written.push("#{ints[before]}")
        else if dewy_syntax[leaf].kind == .string:
            if not texts.contains(dewy_syntax[leaf].text):
                texts.push(dewy_syntax[leaf].text)
                written.push("'{dewy_syntax[leaf].text}")
        else: others.push(dw_type(leaf))
    literal_order_note(written)
    parts: int[]
    if ints.len() > 0: parts.push(dw_int_singleton_type(ints, pos))
    if texts.len() > 0:
        n = mk(.tname, pos)
        nodes[n].aux = -7
        nodes[n].ival = str_set_type(texts)
        parts.push(n)
    parts += others
    out = parts[0]
    loop part in parts[1..]:
        u = mk(.tunion, pos)
        set_list(u, [out, part])
        out = u
    out

dw_singleton_bound = (op: Tok, a: int, b: int, pos: int) -> int:
    e = mk(.binary, pos)
    nodes[e].op = i32(int(op))
    nodes[e].a = i32(a)
    nodes[e].b = i32(b)
    e

dw_singleton_and = (a: int, b: int, pos: int) -> int:
    e = mk(.and_, pos)
    nodes[e].a = i32(a)
    nodes[e].b = i32(b)
    e

dw_singleton_value = (binder: int, pos: int) -> int:
    e = mk(.ident, pos)
    nodes[e].name = i32(binder)
    e

dw_singleton_int = (v: int, pos: int) -> int:
    e = mk(.int_lit, pos)
    nodes[e].ival = v
    add_flag(e, NF_LITERAL)
    e

# A union of integer singletons is an int64 whose value set is its invariant:
# `lo <= v <= hi` and `v != g` for each gap g.
dw_int_singleton_type = (values: int[], pos: int) -> int:
    lo = values[0]
    hi = values[0]
    loop v in values:
        lo = min(lo, v)
        hi = max(hi, v)
    if hi - lo - values.len() + 1 > 24 or hi - lo < 0: fatal(pos, "an integer singleton union with more than 24 missing values between its least and greatest members")
    binder = intern("$singleton")
    predicate = dw_singleton_bound(.le, dw_singleton_int(lo, pos), dw_singleton_value(binder, pos), pos)
    predicate = dw_singleton_and(predicate, dw_singleton_bound(.le, dw_singleton_value(binder, pos), dw_singleton_int(hi, pos), pos), pos)
    loop g in [lo..hi]:
        if not values.contains(g): predicate = dw_singleton_and(predicate, dw_singleton_bound(.ne, dw_singleton_value(binder, pos), dw_singleton_int(g, pos), pos), pos)
    base = mk(.tname, pos)
    nodes[base].name = i32(intern("i64"))
    n = mk(.trefined, pos)
    nodes[n].a = i32(base)
    nodes[n].name = i32(binder)
    nodes[n].b = i32(predicate)
    refine_active = true
    n

dw_type = (id: int) -> int:
    let id = dw_unwrap(id)
    pos = dewy_syntax[id].pos
    if dewy_syntax[id].kind == .metatag: return dw_metatag_fail(id)
    name = dw_name(id)
    if name == "no_effects" or name == "allocates" or name == "blocks" or dw_op(id) == .kw_not or dw_op(id) == .type_apply and (dw_name(dw_child(id, 1)) == "reads" or dw_name(dw_child(id, 1)) == "mutates"):
        entries: EffectSyntax[]
        empty = false
        dw_effect_atom(id, entries, empty)
        effect_syntax.push(entries)
        n = mk(.tname, pos)
        nodes[n].aux = -8
        nodes[n].sval = i32(effect_syntax.len() - 1)
        effects_active = true
        return n
    if name != "":
        if name == "uint": return dw_fail(id, "unbounded uint is not yet supported; use an explicit fixed width")
        name = dw_type_name(name)
        n = mk(.tname, pos)
        nodes[n].name = if name == dewy_syntax[id].text: dw_name_id(id) else: i32(intern(name))
        return n
    if dewy_syntax[id].kind == .block and dewy_syntax[id].text == "[]:":
        if dw_positional_types(id):
            n = mk(.ttuple, pos)
            elements: int[]
            loop child in dw_children(id): elements.push(dw_type(child))
            set_list(n, elements)
            return n
        n = mk(.trecord, pos)
        fields: int[]
        loop child in dw_children(id):
            if dw_op(child) != .colon: return dw_fail(child, "an inline record field without a type; use a named record for defaults")
            field = dw_param(child, .vardecl)
            if has_flag(field, NF_MUT): return dw_fail(child, "a mutable inline record field; mutability belongs on the parameter")
            fields.push(field)
        set_list(n, fields)
        return n
    if dw_op(id) == .amp and dw_op(dw_grouped(dw_child(id, 2))) == .tilde:
        right = dw_grouped(dw_child(id, 2))
        n = mk(.trefined, pos)
        nodes[n].a = i32(dw_type(dw_child(id, 1)))
        binder = intern("$refinement")
        nodes[n].name = i32(binder)
        value = mk(.ident, pos)
        nodes[value].name = i32(binder)
        predicate = mk(.binary, pos)
        nodes[predicate].op = i32(int(Tok.ne))
        nodes[predicate].a = i32(value)
        nodes[predicate].b = i32(dw_expr(dw_child(right, 1)))
        nodes[n].b = i32(predicate)
        refine_active = true
        return n
    if dw_op(id) == .star or dw_op(id) == .slash or dw_op(id) == .caret:
        n = mk(.tquantity, pos)
        nodes[n].op = i32(int(if dw_op(id) == .star: Tok.star else if dw_op(id) == .slash: Tok.slash else: Tok.caret))
        nodes[n].a = i32(dw_type(dw_child(id, 1)))
        nodes[n].b = i32(if dw_op(id) == .caret: dw_expr(dw_child(id, 2)) else: dw_type(dw_child(id, 2)))
        return n
    literal = dw_literal_type(id)
    if literal != 0: return literal
    if dw_op(id) == .pipe:
        n = mk(.tunion, pos)
        set_list(n, [dw_type(dw_child(id, 1)), dw_type(dw_child(id, 2))])
        return n
    if dewy_syntax[id].kind == .postfix and dw_op(id) == .question:
        n = mk(.topt, pos)
        nodes[n].a = i32(dw_type(dw_child(id, 1)))
        return n
    if dw_op(id) == .returns:
        params = dw_child(id, 1)
        if dewy_syntax[params].kind != .block or dewy_syntax[params].text != "():": return dw_fail(params, "this function type")
        n = mk(.tfn, pos)
        types_: int[]
        labels: int[]
        loop param in dw_children(params):
            p = dw_param(param, .param)
            if nodes[p].a == 0: return dw_fail(param, "an untyped parameter in a function type")
            if nodes[p].b != 0: return dw_fail(param, "defaults in a function type; declare defaults on a directly called function")
            t = int(nodes[p].a)
            if has_flag(p, NF_MUT): add_flag(t, NF_MUT)
            loop earlier in labels:
                if nodes[earlier].name == nodes[p].name and name_of(int(nodes[p].name)) != "_": fatal(nodes[p].pos, "duplicate callable parameter name '{name_of(int(nodes[p].name))}'")
            # Only the label belongs here; retaining its parameter subtree
            # would duplicate type/pattern cloning in generic callable types.
            nodes[p] = Node(kind = .ident, pos = nodes[p].pos, name = nodes[p].name)
            labels.push(p)
            types_.push(t)
        set_list(n, types_)
        set_list2(n, labels)
        result = dw_effect_suffix(n, dw_child(id, 2))
        if dw_name(result) != "void": nodes[n].a = i32(dw_type(result))
        return n
    if dw_op(id) == .dot:
        owner = dw_name(dw_child(id, 1))
        member = dw_name(dw_child(id, 2))
        if owner == "" or member == "": return dw_fail(id, "this qualified type")
        n = mk(.tname, pos)
        nodes[n].sval = i32(intern(owner))
        nodes[n].name = i32(intern(member))
        return n
    # Function types have one grouping spelling: `<(value:int64):>int64>`.
    if dewy_syntax[id].kind == .block and (dewy_syntax[id].text == "():" or dewy_syntax[id].text == "<>:") and dw_nchildren(id) == 1:
        inner = dw_child(id, 0)
        if dewy_syntax[id].text == "():" and dw_op(inner) == .returns:
            fatal(pos, "function types use angle brackets: replace the outer (...) with <...>, as in `<(x:int64):>int64>`")
        return dw_type(inner)
    if dw_op(id) == .type_apply and dw_name(dw_child(id, 1)) == "array":
        args = dw_child(id, 2)
        count = dw_nchildren(args)
        if count < 1 or count > 2: return dw_fail(id, "array type constraints; use array<T> or array<T length=N>")
        n = mk(.tarray, pos)
        nodes[n].a = i32(dw_type(dw_child(args, 0)))
        if count == 2:
            constraint = dw_child(args, 1)
            if dw_op(constraint) == .assign and dw_name(dw_child(constraint, 1)) == "length":
                size = dw_unwrap(dw_child(constraint, 2))
                if dewy_syntax[size].kind == .block and dewy_syntax[size].text == "[]:":
                    return dw_shape_type(n, size)
                nodes[n].b = i32(dw_expr(dw_child(constraint, 2)))
            else:
                if dw_op(constraint) == .assign: return dw_fail(constraint, "array type constraints; use length=N or a length comparison")
                refine_active = true
                qualified = mk(.trefined, pos)
                nodes[qualified].a = i32(n)
                nodes[qualified].b = i32(dw_ref_predicate(constraint))
                return qualified
        return n
    # `ptr<T>`: a raw pointer for the C boundary (compiler/ffi.jo); `ptr<T>?` may be null
    if dw_op(id) == .type_apply and dw_name(dw_child(id, 1)) == "ptr":
        args = dw_child(id, 2)
        if dw_nchildren(args) != 1: return dw_fail(id, "a pointer type other than ptr<T>")
        n = mk(.tptr, pos)
        nodes[n].a = i32(dw_type(dw_child(args, 0)))
        return n
    if dw_op(id) == .type_apply and (dw_name(dw_child(id, 1)) == "dict" or dw_name(dw_child(id, 1)) == "totaldict"):
        args = dw_child(id, 2)
        if dw_nchildren(args) != 2: return dw_fail(id, "dictionary type constraints")
        n = mk(.tmap, pos)
        if dw_name(dw_child(id, 1)) == "totaldict":
            refine_active = true
            nodes[n].aux = 1
        nodes[n].a = i32(dw_type(dw_child(args, 0)))
        nodes[n].b = i32(dw_type(dw_child(args, 1)))
        return n
    if dw_op(id) == .type_apply:
        entries = dw_children(dw_child(id, 2))
        base = dw_type(dw_child(id, 1))
        args: int[]
        loop child in entries:
            entry = dw_grouped(child)
            op = dw_op(entry)
            condition = op == .function or op == .kw_and or op == .eq or op == .not_eq or op == .lt or op == .le or op == .gt or op == .ge or op == .contains
            if condition:
                refine_active = true
                n = mk(.trefined, dewy_syntax[entry].pos)
                nodes[n].a = i32(base)
                if op == .function:
                    parameter = dw_grouped(dw_child(entry, 1))
                    if dw_name(parameter) == "": return dw_fail(parameter, "refinement lambda needs one value binder")
                    nodes[n].name = dw_name_id(parameter)
                    entry = dw_child(entry, 2)
                else if dw_pattern_binder != 0: nodes[n].name = dw_pattern_binder
                nodes[n].b = i32(dw_ref_predicate(entry))
                base = n
            else:
                args.push(dw_type(child))
        if args.len() > 0:
            if nodes[base].kind != .tname or nkids(base) != 0: return dw_fail(id, "type arguments on this type expression")
            set_list(base, args)
        return base
    return dw_fail(id, "this type expression")

# `array<T length=[m n]>`: the shape in the type (tensors.md). Two or more
# dimensions make an n-dimensional array; one is a 1-D array. The dimensions
# (ival 1 marks them, in kids) are checked where values enter: parameters bind
# a name not yet known (`m`) and check the rest.
dw_shape_type = (n: int, size: int) -> int:
    dims: int[]
    loop entry in dw_children(size):
        if dw_row_break(entry) or dw_op(entry) == .statement_end: return dw_fail(entry, "`;` in a shape; list the dimensions, `length=[m n]`")
        dims.push(dw_expr(entry))
    if dims.len() == 0: return dw_fail(size, "an empty shape; give each dimension, `length=[m n]`")
    nodes[n].aux = i32(max(dims.len(), 1))
    nodes[n].ival = 1
    set_list(n, dims)
    n

dw_has_shape = (t: int) -> bool: t != 0 and nodes[t].kind == .tarray and nodes[t].ival == 1

# The checks of a shaped parameter at entry: its rank, then each dimension.
# A dimension named by a word not yet bound binds it (SHAPE_DIM marks the
# declaration for the checker); any other dimension is compared.
dw_shape_prologue = (param: int, out: mut int[]):
    t = int(nodes[param].a)
    pos = nodes[param].pos
    value = (p: int) -> int:
        v = mk(.ident, nodes[p].pos)
        nodes[v].name = nodes[p].name
        nodes[v].aux2 = 1
        v
    out.push(bc_stmt(bc_call("__shape_rank", [value(param), bc_int(nkids(t), pos)], pos), pos))
    loop i in 0.. and dim in kids(t):
        if nodes[dim].kind == .ident:
            local = mk(.vardecl, nodes[dim].pos)
            nodes[local].name = nodes[dim].name
            nodes[local].aux2 = SHAPE_DIM
            add_flag(local, NF_LOOPCOUNT)
            nodes[local].b = i32(bc_call("__shape_dim", [value(param), bc_int(i, pos)], pos))
            out.push(local)
        else: out.push(bc_stmt(bc_call("__shape_check", [value(param), bc_int(i, pos), clone(dim)], pos), pos))

# `[int64 string]`: an array of fixed length with a type per position (no
# entry names a field)
dw_positional_types = (id: int) -> bool:
    if dw_nchildren(id) == 0: return false
    loop child in dw_children(id):
        op = dw_op(child)
        if op == .colon or op == .assign or op == .arrow or ownership_tag(child) != 0 or dewy_syntax[dw_unwrap(child)].kind == .metatag: return false
    true

# Type parameters use the existing compact specialization machinery. Constraints
# are not silently ignored: this slice accepts only distinct parameter names.
dw_type_params = (id: int) -> int[]:
    out: int[]
    seen: str[]
    loop child in dw_children(id):
        binder = child
        row = dw_op(child) == .colon and dw_name(dw_child(child, 2)) == "Effect"
        if row: binder = dw_child(child, 1)
        name = dw_name(binder)
        if name == "" or name == "of": return [dw_fail(child, "constrained type parameters; use plain type parameter names")]
        dw_word_operator_name(name, binder)
        if seen.contains(name): fatal(dewy_syntax[child].pos, "duplicate type parameter '{name}'")
        seen.push(name)
        n = mk(.ident, dewy_syntax[child].pos)
        nodes[n].name = dw_name_id(binder)
        if row: nodes[n].aux = 1
        out.push(n)
    if out.len() == 0: return [dw_fail(id, "an empty type parameter declaration")]
    out

# (the name a refinement in a type names the refined value by: a match arm's or a field's)
dw_pattern_binder: i32 = 0

dw_param = (id: int, kind: NK) -> int:
    let id = id
    pos = dewy_syntax[id].pos
    initial = 0
    if dw_op(id) == .assign:
        initial = dw_child(id, 2)
        id = dw_child(id, 1)
    lhs = id
    annotation = 0
    if dw_op(id) == .colon:
        lhs = dw_child(id, 1)
        annotation = dw_child(id, 2)
    else if kind == .vardecl and initial == 0: return dw_fail(id, "a field without a type or default")
    dw_word_operator_name(dw_name(lhs), lhs)
    by_place = dw_op(lhs) == .at
    if by_place: lhs = dw_child(lhs, 1)
    if dewy_syntax[dw_unwrap(lhs)].kind == .metatag: return dw_metatag_fail(dw_unwrap(lhs))
    name = dw_name(lhs)
    pattern = kind == .param and dewy_syntax[lhs].kind == .block and dewy_syntax[lhs].text == "[]:"
    if name == "" and not pattern:
        if dw_has_comma(id): return dw_comma_fail(lhs)
        return dw_fail(lhs, "this parameter or field")
    if pattern and by_place: return dw_fail(lhs, "unpacking a mutable parameter; use a named @ parameter")
    n = mk(kind, pos)
    if pattern:
        name = "$parameter{n}"
        set_list(n, dw_bindings(lhs))
    nodes[n].name = if pattern: i32(intern(name)) else: dw_name_id(lhs)
    if annotation != 0:
        # (`bottom:int64<bottom >? 0>`: a field's refinement names the field's own value)
        outer = dw_pattern_binder
        if kind == .vardecl: dw_pattern_binder = nodes[n].name
        nodes[n].a = i32(dw_type(annotation))
        dw_pattern_binder = outer
    if initial != 0: nodes[n].b = i32(dw_expr(initial))
    if by_place: add_flag(n, NF_MUT)
    return n

dw_function = (id: int, name: str) -> int:
    signature = dw_child(id, 1)
    params = signature
    result = 0
    if dw_op(signature) == .returns:
        params = dw_child(signature, 1)
        result = dw_child(signature, 2)
    if dw_op(params) == .call and dewy_syntax[dw_child(params, 1)].text == "[]:":
        return dw_fail(params, "a separate capture list; use ($capture @name) in the parameter list")
    type_params: int[]
    if dw_op(params) == .call and dewy_syntax[dw_child(params, 1)].text == "<>:":
        type_params = dw_type_params(dw_child(params, 1))
        params = dw_child(params, 2)
    # One bare parameter name may omit the parentheses: `x => x + 1`.
    bare = dewy_syntax[params].kind == .identifier and result == 0 and type_params.len() == 0
    if dw_op(params) == .colon or (dewy_syntax[params].kind == .identifier and not bare):
        fatal(dewy_syntax[params].pos, "only one bare parameter name may omit the parentheses; write an annotated or typed signature as `(x:int64) => ...`")
    if not bare and (dewy_syntax[params].kind != .block or dewy_syntax[params].text != "():"): return dw_fail(params, "this parameter list")
    n = mk(if name == "": NK.lambda else: NK.fn_, dewy_syntax[id].pos)
    nodes[n].name = i32(intern(name))
    if type_params.len() > 0:
        if name == "main": return dw_fail(id, "a generic entry point")
        set_list2(n, type_params)
        add_flag(n, NF_GENERIC)
    if proof_pending and result != 0 and dewy_syntax[dw_unwrap(result)].kind == .block and dewy_syntax[dw_unwrap(result)].text == "<>:":
        predicate = 0
        loop entry in dw_children(dw_unwrap(result)):
            term = dw_ref_predicate(entry)
            if predicate == 0: predicate = term
            else:
                both = mk(.and_, nodes[term].pos)
                nodes[both].a = i32(predicate); nodes[both].b = i32(term)
                predicate = both
        if predicate == 0: fatal(nodes[n].pos, "proof result requires a proposition")
        proof_decls[n] = predicate
        add_flag(n, NF_VOID)
        result = 0
    if result != 0:
        result = dw_effect_suffix(n, result)
        if dw_name(result) == "void": add_flag(n, NF_VOID)
        else: nodes[n].a = i32(dw_result_type(n, result))
    ps: int[]
    captures: int[]
    capture = false
    bound: {int: bool} = {}
    rows = [params]
    if not bare: rows = dw_children(params)
    keyword_only = false
    any_kind = false
    kinds: int[]
    loop p in rows:
        if dewy_syntax[p].kind == .metatag:
            if dewy_syntax[p].text != "capture":
                if dw_designed_directive(dewy_syntax[p].text): return dw_metatag_fail(p)
                fatal(dewy_syntax[p].pos, "unknown parameter modifier `${dewy_syntax[p].text}` (the one modifier is `$capture`)")
            if capture: return dw_fail(p, "$capture without a local name")
            if name != "": return dw_fail(p, "$capture on a module function")
            capture = true
            continue
        if capture:
            target = if dw_op(p) == .at: dw_child(p, 1) else: p
            nm = dw_name(target)
            if nm == "" or nm == "_": return dw_fail(p, "a capture other than an enclosing local name")
            cap = dw_expr(target)
            # (`$capture @count` in a method: the closure writes the object's member
            # through the receiver's place; dewy_methods.jo admits writes to it only)
            if nodes[cap].kind == .field and dw_op(p) == .at and nodes[int(nodes[cap].a)].kind == .ident and starts_with(name_of(int(nodes[int(nodes[cap].a)].name)), "$self"):
                receiver = int(nodes[cap].a)
                members = dewy_member_captures.get(n) ?? []
                if members.contains(int(nodes[cap].name)): fatal(nodes[cap].pos, "duplicate parameter binding '{nm}'")
                members.push(int(nodes[cap].name))
                dewy_member_captures[n] = members
                if not bound.has(int(nodes[receiver].name)):
                    add_flag(receiver, NF_MUT)
                    bound[int(nodes[receiver].name)] = true
                    captures.push(receiver)
                capture = false
                continue
            if nodes[cap].kind != .ident: fatal(dewy_syntax[target].pos, "'{nm}' is a member of this object, which the method already reaches by name; `$capture` takes an enclosing local (`$capture @{nm}` lets a closure change it)")
            if dw_op(p) == .at: add_flag(cap, NF_MUT)
            if bound.has(int(nodes[cap].name)): fatal(nodes[cap].pos, "duplicate parameter binding '{nm}'")
            bound[int(nodes[cap].name)] = true
            captures.push(cap)
            capture = false
            continue
        # (`(... amount:int64)`: a leading bare `...` makes every parameter keyword-only)
        if dewy_syntax[p].kind == .identifier and dewy_syntax[p].text == "...":
            keyword_only = true
            continue
        kind = if keyword_only: 1 else: 0
        let p = p
        # (`value:int64 ...`: the positional run ends after this parameter)
        if dw_op(p) == .colon and dewy_syntax[dw_unwrap(dw_child(p, 2))].kind == .postfix and dw_op(dw_unwrap(dw_child(p, 2))) == .ellipsis:
            typed = dw_child(dw_unwrap(dw_child(p, 2)), 1)
            if dewy_syntax[p].child_mode != 0: dewy_syntax[p].child_right = typed
            else: dewy_syntax[p].children[2] = typed
            keyword_only = true
        else if dewy_syntax[p].kind == .postfix and dw_op(p) == .ellipsis and dw_op(dw_child(p, 1)) == .colon:
            p = dw_child(p, 1)
            keyword_only = true
        else if dewy_syntax[p].kind == .block and dewy_syntax[p].text == "<>:" and dw_nchildren(p) == 1 and dw_op(dw_child(p, 0)) == .colon:
            p = dw_child(p, 0)
            kind = 2
        if kind != 0: any_kind = true
        kinds.push(kind)
        param = dw_param(p, .param)
        let bound_nodes = if nkids(param) > 0: binding_leaves(kids(param)) else: [param]
        loop binding in bound_nodes:
            nm = int(nodes[binding].name)
            if name_of(nm) == "_": continue
            if bound.has(nm): fatal(nodes[binding].pos, "duplicate parameter binding '{name_of(nm)}'")
            bound[nm] = true
        ps.push(param)
    if capture: return dw_fail(params, "$capture without a local name")
    if any_kind: dewy_param_kinds[n] = kinds
    outer_siblings = dw_siblings
    if dw_siblings.len() > 0 and bound.len() > 0:
        hidden: int[]
        loop nm, seen in bound: hidden.push(nm)
        dw_shadow(hidden)
    if captures.len() > 0:
        if type_params.len() > 0:
            caplist = mk(.block, nodes[n].pos)
            set_list(caplist, captures)
            nodes[n].d = i32(caplist)
        else: set_list2(n, captures)
    ffi = dw_ffi_body(dw_child(id, 2))
    if ffi != "":
        dw_siblings = outer_siblings
        if ffi == "extern" and captures.len() == 0: return dw_extern_finish(n, ps, dw_child(id, 2), name)
        if ffi == "export": fatal(nodes[n].pos, "`$export` goes on the line just before the function it marks")
        if ffi == "intrinsic": dw_intrinsic_check(dw_child(id, 2), name, nodes[n].pos)
        fatal(nodes[n].pos, "`${ffi}` declares a module-level function")
    outer_result = dw_fn_result
    dw_fn_result = 1
    if result != 0 and dw_name(result) != "void": dw_fn_result = 2
    body = dw_block(dw_child(id, 2))
    dw_fn_result = outer_result
    dw_siblings = outer_siblings
    dw_finish_function(n, ps, body, name)

# Both constructors synthesize the same local bindings for value parameters.
dw_finish_function = (n: int, parameters: int[], body: int, name: str) -> int:
    let ps = parameters
    prefix: int[]
    loop param in ps:
        if has_flag(param, NF_MUT) or name_of(int(nodes[param].name)) == "_": continue
        local = mk(.vardecl, nodes[param].pos)
        nodes[local].aux2 = 1   # synthesized value-parameter binding
        nodes[local].name = nodes[param].name
        if nkids(param) > 0: set_list(local, kids(param))
        value = mk(.ident, nodes[param].pos)
        nodes[value].name = nodes[param].name
        nodes[value].aux2 = 1   # the parameter's value itself, even a function
        if name == "main":
            if ps.len() != 1: return dw_fail_pos(nodes[n].pos, "multiple entry-point parameters")
            nodes[value].name = i32(intern("args"))
            call = mk(.call, nodes[param].pos)
            nodes[call].a = i32(value)
            value = call
            nodes[local].a = nodes[param].a
        nodes[local].b = i32(value)
        prefix.push(local)
    loop param in ps:
        if dw_has_shape(int(nodes[param].a)): dw_shape_prologue(param, prefix)
    if name == "main":
        loop param in ps:
            if has_flag(param, NF_MUT): return dw_fail_pos(nodes[n].pos, "a mutable entry-point parameter")
        ps = []
    set_list(n, ps)
    loop statement in kids(body): prefix.push(statement)
    # (a shaped result, `:>array<T length=[m p]>`: the final value is checked as it leaves;
    # a `return` is checked where it is)
    if dw_has_shape(int(nodes[n].a)) and prefix.len() > 0 and nodes[prefix[prefix.len() - 1]].kind == .exprstmt:
        last = prefix[prefix.len() - 1]
        pos = nodes[last].pos
        dims: int[]
        loop dim in kids(int(nodes[n].a)): dims.push(clone(dim))
        sizes = mk(.array, pos)
        set_list(sizes, dims)
        nodes[last].a = i32(bc_call("__shape_value", [int(nodes[last].a), sizes], pos))
    set_list(body, prefix)
    nodes[n].b = i32(body)
    return n

# The compact operator of a combined assignment token.
dn_assign_tok = (op: DewyToken) -> Tok:
    match op:
        assign: .assign
        plus_assign: .pluseq
        minus_assign: .minuseq
        slash_assign, floor_assign: .slasheq
        percent_assign: .percenteq
        power_assign, xor_assign: .careteq
        shl_assign: .shleq
        shr_assign: .shreq
        amp_assign, and_assign: .ampeq
        pipe_assign, or_assign: .pipeeq
        _: .stareq

dw_binary_token = (op: DewyToken, id: int) -> Tok:
    match op:
        plus: .plus
        minus: .minus
        star, multiply_apply: .star
        slash: .slash
        percent: .percent
        eq: .eq
        not_eq: .ne
        contains: .kw_in
        lt: .lt
        le: .le
        gt: .gt
        ge: .ge
        shl: .shl
        shr: .shr
        kw_and, amp: .amp
        kw_or, pipe: .pipe
        kw_xor: .caret
        _:
            if op == .colon and dw_in_interpolation == 0: fatal(dewy_syntax[id].pos, "`:` gives a type here (`x:int64`), not a value: a slice is a range in the brackets, `xs[1..3)`, and a dictionary entry is `key -> value`")
            # (Python's `for x in xs` and `if x in xs`)
            if op == .kw_in and dw_in_interpolation == 0: fatal(dewy_syntax[id].pos, "`in` names a loop's values, as in `loop item in items \{ ... }`; membership is `in?`, as in `if x in? xs \{ ... }`")
            dw_fail(id, "operator '{dn_token_text(op)}'")
            .eof

# Reuse the fused array lowering, with Dewy's scalar arithmetic inside it.
# In particular, integer ./ stays exact division and .// rounds downward.
dw_broadcast = (op: DewyToken, a: int, b: int, id: int) -> int:
    pos = dewy_syntax[id].pos
    if (op == .slash or op == .floor or op == .percent or op == .caret):
        name = if op == .slash: "__dewy_divide" else if op == .floor: "__floor_div" else if op == .percent: "__floor_mod" else: "__dewy_power"
        n = bc_call(name, [a, b], pos)
        add_flag(n, NF_BROADCAST)
        return n
    spelling = dn_token_uninvert(op)
    inverted = spelling != op
    if not (spelling == .plus or spelling == .minus or spelling == .star or spelling == .eq or spelling == .lt or spelling == .le or spelling == .gt or spelling == .ge): return dw_fail(id, "broadcast operator '.{dn_token_text(op)}'")
    n = mk(.binary, pos)
    nodes[n].op = i32(int(Tok.dotop))
    nodes[n].aux = i32(dn_token_text(spelling)[0])
    nodes[n].aux2 = if spelling == .le or spelling == .ge: 1 else: 0
    nodes[n].ival = int(inverted)
    nodes[n].a = i32(a)
    nodes[n].b = i32(b)
    return n

# Computed names are expressions, resolved by the checker in an instantiated scope.
dw_field_name = (id: int) -> int:
    let id = dw_unwrap(id)
    if not dn_token_call(dw_op(id)): return 0
    callee = dw_child(id, 1)
    if dewy_syntax[callee].kind != .metatag or dewy_syntax[callee].text != "field": return 0
    args = dewy_syntax[dw_child(id, 2)].children
    if args.len() != 1: fatal(dewy_syntax[id].pos, "`$field` needs one compile-time string")
    dw_expr(args[0])

dw_record_entry = (id: int) -> int:
    if dw_op(id) != .assign: return dw_fail(id, "a record item without a field name and =")
    lhs = dw_child(id, 1)
    field = mk(.namedarg, dewy_syntax[id].pos)
    nodes[field].b = i32(dw_field_name(lhs))
    if nodes[field].b == 0:
        name = dw_name(lhs)
        if name == "": return dw_fail(lhs, "a record field without a name")
        nodes[field].name = i32(intern(name))
    nodes[field].a = i32(dw_expr(dw_child(id, 2)))
    field

# A function row of a record literal. One that reaches a member of the object becomes a
# method: a closure stored in the object (keeping what it captures), taking the object
# itself first. The object's type is a type parameter, so the record's type does not
# contain itself; each call supplies it.
dw_literal_method = (row: int, members: int[]) -> int:
    receiver = intern("$self{nodes.len()}")
    outer = dw_siblings
    inner: {int: int} = {}
    loop name, other in outer: inner[name] = other
    loop name in members: inner[name] = receiver
    dw_siblings = inner
    entry = dw_record_entry(row)
    dw_siblings = outer
    if not dw_receivers_used.has(receiver): return entry
    lambda = int(nodes[entry].a)
    if nodes[lambda].kind != .lambda: return dw_fail(row, "this method")
    object_type = mk(.ident, nodes[lambda].pos)
    nodes[object_type].name = i32(intern("$Object{receiver}"))
    if has_flag(lambda, NF_GENERIC): set_list2(lambda, [object_type] + kids2(lambda))
    else:
        captures = kids2(lambda)
        if captures.len() > 0:
            caplist = mk(.block, nodes[lambda].pos)
            set_list(caplist, captures)
            nodes[lambda].d = i32(caplist)
        set_list2(lambda, [object_type])
        add_flag(lambda, NF_GENERIC)
    receiver_type = mk(.tname, nodes[lambda].pos)
    nodes[receiver_type].name = nodes[object_type].name
    dw_add_receiver(lambda, receiver, receiver_type)
    entry

dw_register_literal_methods = (entries: int[]):
    row_names: int[]
    decls: int[]
    loop entry in entries:
        if nodes[entry].kind != .namedarg or nodes[entry].name == 0: continue
        value = int(nodes[entry].a)
        row_names.push(int(nodes[entry].name))
        decls.push(if nodes[value].kind == .lambda and dewy_is_method(value): value else: 0)
    dewy_method_group(row_names, decls)

dw_expr = (id: int) -> int:
    let id = dw_unwrap(id)
    k = dewy_syntax[id].kind
    text = dewy_syntax[id].text
    pos = dewy_syntax[id].pos
    if k == .compact_expr:
        if dw_siblings.len() > 0: dw_rewrite_members(dewy_syntax[id].child_left)
        return dewy_syntax[id].child_left
    if k == .based_string: return dw_binary(id)
    if k == .directive and text == "spawn": return dw_spawn(id)
    if k == .directive and text == "concurrent": return dw_concurrent(id, false)
    if k == .directive: return dw_directive(id)
    if k == .metatag:
        if text == "build": fatal(pos, "`$build` is the compile-time record of how the program is built: `$build.mode` ('release' or 'debug') or `$build.debug`")
        if text != "target": return dw_metatag_fail(id)
        n = mk(.str_lit, pos)
        nodes[n].sval = i32(intern(dw_target_name()))
        return n
    if k == .identifier:
        if text == "Cancelled": fatal(pos, "unknown name `Cancelled`; use `Canceled` (US spelling)")
        if text == "none": return mk(.none_lit, pos)
        if text == "end":
            if dw_index_context.len() == 0: fatal(pos, "`end` is the last index inside brackets, as in `xs[end]` or `xs[1..end]`; outside them, use `xs.length - 1`")
            ix = dw_index_context[dw_index_context.len() - 1]
            base = "$index_end{ix}"
            nodes[ix].sval = i32(intern(base))
            axis = int(nodes[ix].aux2)
            name = if axis == 0: base else: "{base}_{axis}"
            return comp_ident(intern(name), pos)
        if text == "new": fatal(pos, "`new` inserts an axis as an entry inside brackets, as in `xs[new]` or `xs[.. new]`")
        return dw_value_ident(dw_name_id(id), pos)
    if dw_integer_kind(k):
        if let value = dw_unsigned(text, id):
            n = mk(.int_lit, pos)
            nodes[n].ival = int(value)
            add_flag(n, NF_LITERAL)
            if nodes[n].ival < 0: add_flag(n, NF_U64)
            return n
        return dw_big_integer(text, id)
    if k == .real or k == .source_real:
        number = text
        if k == .real:
            parts = split(text, "|")
            if parts.len() != 3 or not starts_with(parts[0], "0d:"): return dw_fail(id, "this real literal")
            number = dw_digits(parts[0])
            if parts[1] != "":
                if not starts_with(parts[1], "0d:"): return dw_fail(id, "nondecimal real fractions")
                number = number + "." + dw_digits(parts[1])
            if parts[2] != "":
                exponent = parts[2]
                if exponent[1] != 'e' or not starts_with(exponent[2..], "0d:"):
                    return dw_fail(id, "nondecimal real exponents")
                number += "e" + exponent[..1) + dw_digits(exponent[2..])
        value = to_float(replace(number, "_", ""))
        if value == none: return dw_fail(id, "this real literal")
        n = mk(.float_lit, pos)
        nodes[n].fval = value!
        nodes[n].sval = i32(intern(replace(number, "_", "")))
        add_flag(n, NF_LITERAL)
        return n
    if k == .interpolated_string:
        n = mk(.str_lit, pos)
        nodes[n].aux = 1
        pieces: int[]
        loop child in dw_children(id):
            if dewy_syntax[child].kind == .string_chunk:
                part = mk(.str_lit, dewy_syntax[child].pos)
                nodes[part].sval = i32(intern(dewy_syntax[child].text))
                pieces.push(part)
            else:
                if dewy_syntax[child].kind != .block or dw_nchildren(child) != 1: return dw_fail(child, "this string interpolation")
                part = mk(.pair, dewy_syntax[child].pos)
                dw_in_interpolation += 1
                nodes[part].a = i32(dw_expr(dw_child(child, 0)))
                dw_in_interpolation -= 1
                nodes[part].sval = -1
                pieces.push(part)
        set_list(n, pieces)
        return n
    if k == .boolean:
        n = mk(.bool_lit, pos)
        nodes[n].ival = if text == "true": 1 else: 0
        return n
    if k == .string:
        n = mk(.str_lit, pos)
        nodes[n].sval = i32(intern(text))
        return n
    # Leaves cannot be operators or include calls. Handle them before asking
    # compound-expression helpers to unwrap and classify the same node again.
    op = dw_op(id)
    if op == .kw_or_throw:
        n = mk(.propagate, pos)
        nodes[n].a = i32(dw_expr(dw_child(id, 1)))
        return n
    if op == .range_apply: return dw_range_value(dw_iterable(id, true, true))
    if dn_token_call(op) and dw_is_include(id): return dw_include(id)
    if k == .block:
        children = dw_children(id)
        if children.len() == 1 and dw_op(children[0]) == .range_apply: return dw_range_value(dw_iterable(id, true, true))
        if text == "():" and children.len() == 1: return dw_expr(children[0])
        if text == "[]:":
            if children.len() == 1 and dewy_syntax[children[0]].kind == .flow:
                first = dw_child(children[0], 0)
                if dewy_syntax[first].kind == .keyword_expr and (dewy_syntax[dw_child(first, 0)].text == "loop" or dewy_syntax[dw_child(first, 0)].text == "parallel"): return dw_comprehension(children[0])
            if dw_has_rows(children): return dw_rows_literal(id, children)
            is_map = children.len() > 0 and dw_op(children[0]) == .arrow
            is_record = children.len() > 0 and dw_op(children[0]) == .assign
            loop child in children:
                if dw_op(child) == .assign: is_record = true
            n = mk(if is_map: NK.map_lit else if is_record: NK.record_lit else: NK.array, pos)
            xs: int[]
            members: int[]
            methods: int[]
            if is_record:
                members = dw_row_names(children)
                loop child in children:
                    if dw_method_row(child): methods.push(child)
            loop child in children:
                item = dw_unwrap(child)
                if not is_map and dewy_syntax[item].kind == .postfix and dw_op(item) == .ellipsis:
                    value = dw_expr(dw_child(item, 1))
                    add_flag(value, NF_SPREAD)
                    xs.push(value)
                else if is_map:
                    if dw_op(child) != .arrow: return dw_fail(child, "a dictionary item without ->")
                    pair = mk(.pair, dewy_syntax[child].pos)
                    nodes[pair].a = i32(dw_expr(dw_child(child, 1)))
                    nodes[pair].b = i32(dw_expr(dw_child(child, 2)))
                    xs.push(pair)
                else if is_record and methods.contains(child):
                    xs.push(dw_literal_method(child, members))
                else if is_record:
                    xs.push(dw_record_entry(child))
                else: xs.push(dw_expr(child))
            if methods.len() > 0: dw_register_literal_methods(xs)
            set_list(n, xs)
            return n
        if text == "{{}}:": return dw_block(id)
        return dw_fail(id, "this expression block")
    if k == .postfix and op == .ellipsis:
        fatal(pos, "spread is supported inside array or record literals: `[values... item]` or `[base... field=value]`")
    if k == .prefix:
        e = dw_expr(dw_child(id, 1))
        if op == .at:
            # `@f(args)` partially evaluates f; `@x` selects a place or a function.
            if nodes[e].kind == .call: nodes[e].aux2 = i32(AUX2_PARTIAL)
            else: add_flag(e, NF_MUT | NF_AT)
            return e
        if op == .dot_minus or op == .dot_plus:
            n = mk(.unary, pos)
            nodes[n].op = i32(int(if op == .dot_minus: Tok.minus else: Tok.plus))
            nodes[n].a = i32(e)
            add_flag(n, NF_BROADCAST)
            return n
        if op == .minus and nodes[e].kind == .int_lit and nodes[e].aux2 == 0:
            if has_flag(e, NF_U64) and nodes[e].ival != -9223372036854775807 - 1:
                value = u64(nodes[e].ival)
                return dw_bigint_value([value & 0xFFFFFFFF, value >> 32], pos, true)
            nodes[e].ival = -nodes[e].ival
            nodes[e].pos = pos
            nodes[e].aux2 = 1
            clear_flag(e, NF_U64)
            return e
        if op == .minus and nodes[e].kind == .float_lit:
            nodes[e].fval = -nodes[e].fval
            if nodes[e].sval != 0: nodes[e].sval = i32(intern("-" + name_of(int(nodes[e].sval))))
            nodes[e].pos = pos
            return e
        # (`~x` is `not x` at a tighter precedence: bitwise on integers, logical on booleans)
        n = mk(if op == .kw_not or op == .tilde: NK.not_ else: NK.unary, pos)
        if op != .minus and op != .kw_not and op != .plus and op != .tilde: return dw_fail(id, "prefix '{op}'")
        nodes[n].op = i32(int(if op == .minus: Tok.minus else: Tok.plus))
        nodes[n].a = i32(e)
        return n
    if k == .flow:
        loop arm in dw_children(id):
            if dewy_syntax[arm].kind == .keyword_expr and (dewy_syntax[dw_child(arm, 0)].text == "loop" or dewy_syntax[dw_child(arm, 0)].text == "parallel"):
                return dw_fail(arm, "a loop used as a value; use return or a comprehension")
        return dw_flow(id, 0)
    if k == .binary:
        left = dw_child(id, 1)
        right = dw_child(id, 2)
        scalar_op = dn_token_undot(op)
        if scalar_op != .none:
            return dw_broadcast(scalar_op, dw_expr(left), dw_expr(right), id)
        if op == .is_type or op == .isnt_type:
            n = mk(.istype, pos)
            nodes[n].a = i32(dw_expr(left))
            nodes[n].b = i32(dw_type(right))
            if op == .isnt_type or dewy_syntax[dw_child(id, 0)].kind == .inverted_comparison:
                inverted = mk(.not_, pos)
                nodes[inverted].a = i32(n)
                return inverted
            return n
        if (op == .not_eq or dewy_syntax[dw_child(id, 0)].kind == .inverted_comparison) and dw_chain_link(dw_unwrap(left)):
            fatal(pos, "`not` comparisons do not chain; join the comparisons with `and`")
        if dewy_syntax[dw_child(id, 0)].kind == .inverted_comparison:
            comparison = mk(.binary, pos)
            nodes[comparison].op = i32(int(dw_binary_token(op, id)))
            nodes[comparison].a = i32(dw_expr(left))
            nodes[comparison].b = i32(if op == .contains: dw_membership(right) else: dw_expr(right))
            n = mk(.not_, pos)
            nodes[n].a = i32(comparison)
            return n
        if op == .function: return dw_function(id, "")
        if op == .type_apply:
            n = mk(.typeapply, pos)
            nodes[n].a = i32(dw_expr(left))
            type_base = int(nodes[n].a)
            loop nodes[type_base].kind == .field: type_base = int(nodes[type_base].a)
            if nodes[type_base].kind == .ident: nodes[n].c = i32(dw_type(id))
            args: int[]
            if nodes[int(nodes[n].c)].kind != .trefined:
                loop child in dw_children(right): args.push(dw_type(child))
            set_list(n, args)
            return n
        if op == .floor or op == .percent or op == .caret or op == .slash:
            a = dw_expr(left)
            b = dw_expr(right)
            name = if op == .slash: "__dewy_divide" else if op == .caret: "__dewy_power" else if op == .floor: "__floor_div" else: "__floor_mod"
            callee = mk(.ident, pos)
            nodes[callee].name = i32(intern(name))
            n = mk(.call, pos)
            nodes[n].a = i32(callee)
            set_list(n, [a, b])
            return n
        if op == .dot:
            field = dw_target_field(id)
            if field == 4:
                n = mk(.bool_lit, pos)
                nodes[n].ival = if release_build: 0 else: 1
                return n
            if field > 0:
                n = mk(.str_lit, pos)
                nodes[n].sval = i32(intern(dw_target_field_value(field)))
                return n
            name = dw_name(right)
            computed = dw_field_name(right)
            if name == "" and computed == 0: return dw_fail(id, "computed member names")
            n = mk(.field, pos)
            nodes[n].a = i32(dw_expr(left))
            nodes[n].b = i32(computed)
            if computed == 0:
                nodes[n].name = dw_name_id(right)
                dewy_note_member(n)
            return n
        if op == .kw_as or op == .kw_transmute:
            n = mk(.cast, pos)
            nodes[n].a = i32(dw_expr(left))
            nodes[n].b = i32(dw_type(right))
            if op == .kw_transmute: nodes[n].aux2 = 1
            return n
        if op == .call and dewy_syntax[left].kind == .identifier and dewy_syntax[left].text == "b" and (dewy_syntax[right].kind == .string or dewy_syntax[right].kind == .interpolated_string):
            return dw_byte_literal(right)
        if dn_token_call(op) or op == .index:
            xs = dw_children(right)
            bracket = dewy_syntax[right].kind == .block and dewy_syntax[right].text in ["[]:", "[):"]
            if bracket and dw_name(left) == "set":
                return bc_call("__dewy_set", [dw_expr(right)], pos)
            n = mk(if bracket: NK.index else: NK.call, pos)
            if op == .broadcast_call: add_flag(n, NF_BROADCAST)
            nodes[n].a = i32(dw_expr(left))
            callee = int(nodes[n].a)
            if not bracket and nodes[callee].kind == .field: add_flag(int(nodes[callee].a), NF_MUT)
            if not bracket: dewy_defer_callee(callee)
            args: int[]
            new_axis = false
            if bracket: dw_index_context.push(n)
            if bracket and xs.len() == 1 and dw_op(xs[0]) == .range_apply and dw_nchildren(dw_unwrap(xs[0])) >= 3 and dewy_syntax[dw_child(dw_unwrap(xs[0]), 1)].kind == .metatag:
                # (`xs[$clamp ..b)`: the metatag took the place of the start)
                whole = dw_unwrap(xs[0])
                parts = dw_children(whole)
                tag = parts[1]
                parts.remove(1)
                bare = dewy_syntax.len()
                dewy_syntax.push(DewySyntax(kind = dewy_syntax[whole].kind, text = dewy_syntax[whole].text, pos = dewy_syntax[whole].pos, children = parts, symbol = dewy_syntax[whole].symbol))
                xs = [tag, bare]
            if bracket and xs.len() > 0 and dewy_syntax[xs[0]].kind == .metatag:
                block = dw_clamp_slice(n, right, xs)
                dw_index_context.pop()
                nodes[n] = nodes[block]
                return n
            if dewy_syntax[right].kind != .block: args.push(dw_expr(right))
            else if bracket and xs.len() == 1 and (dw_op(xs[0]) == .range_apply or dw_name(xs[0]) == ".."):
                if dw_new_range_at(xs[0]):
                    if dewy_syntax[right].text != "[]:": return dw_fail(right, "`new` with an exclusive bracket")
                    args = dw_new_range(xs[0])
                    new_axis = true
                else: args.push(dw_iterable(right, true))
            else:
                if dewy_syntax[right].text == "[):": return dw_fail(right, "an exclusive index without a range")
                loop child in xs:
                    # Temporary parse cursor: each axis gives contextual end its own name.
                    if bracket: nodes[n].aux2 = i32(args.len())
                    if bracket and dw_name(child) == "new":
                        args.push(bc_ident("$new", dewy_syntax[child].pos))
                        new_axis = true
                    else if bracket and dw_new_range_at(child):
                        loop entry in dw_new_range(child): args.push(entry)
                        new_axis = true
                    else if dw_op(child) == .assign:
                        a = mk(.namedarg, dewy_syntax[child].pos)
                        nodes[a].name = dw_name_id(dw_child(child, 1))
                        nodes[a].a = i32(dw_expr(dw_child(child, 2)))
                        args.push(a)
                    else if bracket and xs.len() > 1: args.push(dw_iterable(child, true, true))
                    else: args.push(dw_expr(child))
            if bracket:
                dw_index_context.pop()
                nodes[n].aux2 = 0
            if new_axis: nodes[n].kind = .new_axis
            set_list(n, args)
            if bracket and args.len() == 1: nodes[n].b = i32(args[0])
            return n
        # `x |> @f` and `@f <| x`: the value supplied to the callable expression
        if op == .pipe_right or op == .pipe_left:
            n = mk(.call, pos)
            nodes[n].a = i32(dw_expr(if op == .pipe_right: right else: left))
            set_list(n, [dw_expr(if op == .pipe_right: left else: right)])
            return n
        if op == .coalesce:
            dw_coalesce_arithmetic(left, right)
            n = mk(.coalesce, pos)
            nodes[n].a = i32(dw_expr(left))
            nodes[n].b = i32(dw_expr(right))
            return n
        if dw_chain_way(op) != 2 and dw_chain_link(dw_unwrap(left)): return dw_chain(id)
        n = mk(if op == .kw_and: NK.and_ else if op == .kw_or: NK.or_ else: NK.binary, pos)
        nodes[n].op = i32(int(dw_binary_token(op, id)))
        nodes[n].a = i32(dw_expr(left))
        nodes[n].b = i32(if op == .contains: dw_membership(right) else: dw_expr(right))
        return n
    if k == .flat and dw_op(id) == .comma: return dw_comma_fail(id)
    return dw_fail(id, "syntax '{dw_kind_name(k)}'")

# The byte of a `b'a'` literal, or -1 when id is no such literal.
dw_byte_char = (id: int) -> int:
    if dw_op(id) != .call or dewy_syntax[id].kind != .binary: return -1
    left = dw_child(id, 1)
    right = dw_child(id, 2)
    if dewy_syntax[left].kind != .identifier or dewy_syntax[left].text != "b" or dewy_syntax[right].kind != .string: return -1
    pos = dewy_syntax[right].pos
    if files[pos_file(pos)].src[pos_off(pos)] != '\'' or len(dewy_syntax[right].text) != 1: return -1
    int(dewy_syntax[right].text[0])

# `[1 2; 3 4]`: in an array literal a `;` (standalone, or attached to the element
# before it) ends a row, and `;;` ends a 2-D block (tensors.md). The literal is
# contiguous: every row has the same length and every block the same rows.
dw_row_break = (id: int) -> bool: dewy_syntax[id].kind == .keyword and dewy_syntax[id].text == ";"

dw_has_rows = (children: int[]) -> bool:
    loop child in children:
        if dw_row_break(child) or dw_op(child) == .statement_end: return true
    false

dw_rows_literal = (id: int, children: int[]) -> int:
    pos = dewy_syntax[id].pos
    elements: int[]
    breaks: int[]
    loop child in children:
        if dw_row_break(child):
            if breaks.len() == 0: fatal(dewy_syntax[child].pos, "an array literal cannot start with `;`: a `;` ends a row, as in `[1 2; 3 4]`")
            breaks[breaks.len() - 1] += 1
            continue
        item = dw_unwrap(child)
        after = 0
        if dw_op(item) == .statement_end:
            item = dw_unwrap(dw_child(item, 1))
            after = 1
        op = dw_op(item)
        if op == .assign or op == .arrow or (dewy_syntax[item].kind == .postfix and op == .ellipsis):
            fatal(dewy_syntax[item].pos, "rows separated by `;` hold plain values; records, dictionaries and spreads don't split into rows")
        elements.push(dw_expr(item))
        breaks.push(after)
    rank = 1
    loop b in breaks: rank = max(rank, b + 1)
    # (dims[0] is the row length; dims[k] counts the level-k units in each level-(k+1) group)
    dims = fill(-1, rank)
    counts = fill(0, rank)
    loop i in 0.. and b in breaks:
        counts[0] += 1
        close = if i + 1 == breaks.len(): rank - 1 else: b
        loop level in [1..close]:
            size = counts[level - 1]
            if dims[level - 1] < 0: dims[level - 1] = size
            else if dims[level - 1] != size:
                what = if level == 1: "rows" else if level == 2: "blocks" else: "parts"
                unit = if level == 1: "elements" else if level == 2: "rows" else: "parts"
                fatal(nodes[elements[i]].pos, "the {what} of an array literal must have the same size: this one has {size} {unit}, the first has {dims[level - 1]}")
            counts[level - 1] = 0
            counts[level] += 1
    dims[rank - 1] = counts[rank - 1]
    if rank == 2:
        n = mk(.matrix, pos)
        set_list(n, elements)
        nodes[n].ival = dims[0]
        return n
    values = mk(.array, pos)
    set_list(values, elements)
    shape: int[]
    k = rank - 1
    loop k >= 0:
        shape.push(bc_int(dims[k], pos))
        k -= 1
    sizes = mk(.array, pos)
    set_list(sizes, shape)
    bc_call("reshape", [values, sizes], pos)

# `b'a'` is a `uint8`, `b"abc"` an `array<uint8>` of the text's UTF-8 bytes.
dw_byte_literal = (id: int) -> int:
    pos = dewy_syntax[id].pos
    if dewy_syntax[id].kind != .string: fatal(pos, "a byte literal is not interpolated: write `\\\{` for a brace, or convert text, as in `bytes(\"...\")`")
    text = dewy_syntax[id].text
    single = files[pos_file(pos)].src[pos_off(pos)] == '\''
    u8 = mk(.tname, pos)
    nodes[u8].name = i32(intern("u8"))
    if single:
        if len(text) != 1: fatal(pos, "`b'...'` is one byte, and this holds {len(text)} (`b\"...\"` is an array of bytes)")
        n = mk(.cast, pos)
        nodes[n].a = i32(bc_int(int(text[0]), pos))
        nodes[n].b = i32(u8)
        return n
    elements: int[]
    loop c in text: elements.push(bc_int(int(c), pos))
    values = mk(.array, pos)
    set_list(values, elements)
    t = mk(.tarray, pos)
    nodes[t].a = i32(u8)
    n = mk(.cast, pos)
    nodes[n].a = i32(values)
    nodes[n].b = i32(t)
    n

# Comparison chains (`0 <? x <? 10`): consecutive comparisons joined by `and`,
# each operand evaluated once and in order, later ones only while the chain
# holds. A chain rises (`<?` `<=?`) or falls (`>?` `>=?`); `=?` fits either.
# 1 rising, -1 falling, 0 either, 2 not a chain link.
dw_chain_way = (op: DewyToken) -> int:
    if op == .lt or op == .le: return 1
    if op == .gt or op == .ge: return -1
    if op == .eq: return 0
    2

# An unparenthesized comparison: the left side of a longer chain.
dw_chain_link = (id: int) -> bool:
    dewy_syntax[id].kind == .binary and dw_chain_way(dw_op(id)) != 2

# Read twice without changing anything: a name, a literal or a member of one.
dw_chain_plain = (id0: int) -> bool:
    id = dw_unwrap(id0)
    k = dewy_syntax[id].kind
    if k == .identifier or k == .integer or k == .source_integer or k == .real or k == .source_real or k == .boolean: return true
    k == .binary and dw_op(id) == .dot and dw_chain_plain(dw_child(id, 1))

dw_chain_count = 0

dw_chain = (id: int) -> int:
    pos = dewy_syntax[id].pos
    operands: int[]
    links: int[]
    at = id
    loop true:
        if dewy_syntax[dw_child(at, 0)].kind == .inverted_comparison: fatal(dewy_syntax[at].pos, "`not` comparisons do not chain; join the comparisons with `and`")
        links.insert(0, at)
        operands.insert(0, dw_child(at, 2))
        left = dw_unwrap(dw_child(at, 1))
        if not dw_chain_link(left):
            operands.insert(0, dw_child(at, 1))
            break
        at = left
    way = 0
    loop link in links:
        w = dw_chain_way(dw_op(link))
        if w == 0: continue
        if way != 0 and w != way: fatal(dewy_syntax[link].pos, "a comparison chain goes one way: rising (`a <? b <=? c`) or falling (`a >? b >=? c`), with `=?` in either; join other comparisons with `and`")
        way = w
    statements: int[]
    first = 0
    if dw_chain_plain(operands[0]): first = dw_expr(operands[0])
    else: first = dw_chain_temp(dw_expr(operands[0]), statements, pos)
    chain = dw_chain_from(links, operands, 0, first)
    if statements.len() == 0: return chain
    statements.push(bc_stmt(chain, pos))
    bc_block(statements, pos)

# A temporary holding value, declared in statements; its name as a value.
dw_chain_temp = (value: int, statements: mut int[], pos: int) -> int:
    dw_chain_count += 1
    name = "$chain{dw_chain_count}"
    statements.push(bc_let(name, value, pos))
    bc_ident(name, pos)

dw_chain_from = (links: int[], operands: int[], i: int, left: int) -> int:
    link = links[i]
    pos = dewy_syntax[link].pos
    comparison = mk(.binary, pos)
    nodes[comparison].op = i32(int(dw_binary_token(dw_op(link), link)))
    nodes[comparison].a = i32(left)
    right = operands[i + 1]
    if i + 1 == links.len():
        nodes[comparison].b = i32(dw_expr(right))
        return comparison
    statements: int[]
    next = 0
    if dw_chain_plain(right):
        nodes[comparison].b = i32(dw_expr(right))
        next = dw_expr(right)
    else:
        value = dw_chain_temp(dw_expr(right), statements, pos)
        nodes[comparison].b = i32(value)
        next = bc_ident(name_of(int(nodes[value].name)), pos)
    both = mk(.and_, pos)
    nodes[both].a = i32(comparison)
    nodes[both].b = i32(dw_chain_from(links, operands, i + 1, next))
    if statements.len() == 0: return both
    statements.push(bc_stmt(both, pos))
    bc_block(statements, pos)

dw_stmt = (id: int, top: bool = false) -> int:
    let id = dw_unwrap(id)
    # `(count += 1)`: a parenthesized update is the update (a function body may be one).
    grouped = dw_grouped(id)
    if grouped != id and (dn_token_assignment(dw_op(grouped)) or dw_op(grouped) == .assign): id = grouped
    pos = dewy_syntax[id].pos
    k = dewy_syntax[id].kind
    if k == .compact_stmt: return dewy_syntax[id].child_left
    if dw_op(id) == .kw_as and dw_is_include(dw_child(id, 1)):
        name = dw_name(dw_child(id, 2))
        if name == "": return dw_fail(id, "this asset binding")
        n = mk(.vardecl, pos)
        nodes[n].name = i32(intern(name))
        nodes[n].b = i32(dw_include(dw_child(id, 1)))
        return n
    if dw_op(id) == .statement_end:
        s = dw_stmt(dw_child(id, 1), top)
        if nodes[s].kind == .exprstmt:
            n = mk(.assign, pos)
            nodes[n].op = i32(int(Tok.assign))
            nodes[n].a = i32(mk(.hole, pos))
            nodes[n].b = nodes[s].a
            return n
        return s
    if k == .directive and dewy_syntax[id].text == "concurrent": return dw_concurrent(id, true)
    if k == .directive and (dewy_syntax[id].text == "expect" or dewy_syntax[id].text == "fail"): return dw_expect(id)
    if k == .keyword_expr:
        word = dewy_syntax[dw_child(id, 0)].text
        if word == "from" or word == "import":
            if not top: return dw_fail(id, "local imports")
            return dw_import(id)
        if word == "return":
            n = mk(.return_, pos)
            if dw_nchildren(id) > 1: nodes[n].a = i32(dw_expr(dw_child(id, 1)))
            return n
        if word == "let" or word == "const": return dw_declare(dw_child(id, 1), word == "const", top)
        if word == "break" or word == "continue":
            n = mk(if word == "break": NK.break_ else: NK.continue_, pos)
            if dw_nchildren(id) > 1:
                label = dw_child(id, 1)
                if dewy_syntax[label].kind != .metatag: return dw_fail(label, "a loop exit without a $label")
                nodes[n].name = i32(intern(dewy_syntax[label].text))
            return n
        return dw_fail(id, "statement '{word}'")
    if k == .flow:
        n = dw_flow(id, 0)
        add_flag(n, NF_STMT)
        return dw_flow_stmt(n)
    if dn_token_assignment(dw_op(id)):
        n = mk(.assign, pos)
        op = dw_op(id)
        scalar_op = dn_token_undot(op)
        if scalar_op != .none:
            add_flag(n, NF_BROADCAST)
            op = scalar_op
        nodes[n].op = i32(int(dn_assign_tok(op)))
        # (`a and= f()` is `a = a and f()`: on booleans f runs only when it can change a)
        if op == .and_assign or op == .or_assign: nodes[n].aux2 = 1
        if (op == .slash_assign or op == .floor_assign or op == .percent_assign or op == .power_assign):
            nodes[n].sval = i32(intern(if op == .slash_assign: "__dewy_divide" else if op == .floor_assign: "__floor_div" else if op == .percent_assign: "__floor_mod" else: "__dewy_power"))
        nodes[n].a = i32(dw_expr(dw_child(id, 1)))
        nodes[n].b = i32(dw_expr(dw_child(id, 2)))
        return n
    if dw_op(id) == .assign or dw_op(id) == .colon:
        lhs = dw_unwrap(dw_child(id, 1))
        if dw_op(id) == .colon or top and dw_op(lhs) == .colon: return dw_declare(id, false, top)
        dw_word_operator_name(dw_name(lhs), lhs)
        n = mk(.assign, pos)
        nodes[n].op = i32(int(Tok.assign))
        if dewy_syntax[lhs].kind == .block and dewy_syntax[lhs].text == "[]:":
            pattern = mk(.tuple, dewy_syntax[lhs].pos)
            set_list(pattern, dw_bindings(lhs))
            nodes[n].a = i32(pattern)
        else: nodes[n].a = i32(dw_expr(lhs))
        nodes[n].b = i32(dw_expr(dw_child(id, 2)))
        return n
    n = mk(.exprstmt, pos)
    nodes[n].a = i32(dw_expr(id))
    return n

dw_bindings = (id: int) -> int[]:
    seen: {str: bool} = {}
    dw_binding_items(id, seen)

dw_binding_items = (id: int, seen: mut {str: bool}) -> int[]:
    bindings: int[]
    loop child in dw_children(id):
        let child = dw_unwrap(child)
        annotation = 0
        if dw_op(child) == .colon:
            annotation = dw_child(child, 2)
            child = dw_unwrap(dw_child(child, 1))
        if dewy_syntax[child].kind == .block and dewy_syntax[child].text == "[]:":
            if annotation != 0: return [dw_fail(child, "an annotated nested pattern; annotate its names or the whole declaration")]
            n = mk(.tuple, dewy_syntax[child].pos)
            set_list(n, dw_binding_items(child, seen))
            bindings.push(n)
            continue
        name = dw_name(child)
        if name == "": return [dw_fail(child, "this unpacking target; use names or nested brackets")]
        dw_reserved_name(name, child)
        if name != "_" and seen.has(name): fatal(dewy_syntax[child].pos, "duplicate unpacking name '{name}'")
        seen[name] = true
        n = mk(if name == "_": NK.hole else: NK.ident, dewy_syntax[child].pos)
        nodes[n].name = dw_name_id(child)
        if annotation != 0: nodes[n].a = i32(dw_type(annotation))
        bindings.push(n)
    if bindings.len() == 0: return [dw_fail(id, "an empty unpacking target")]
    bindings

# Pure scalar syntax can stay a compile-time expression. Anything that reads a
# name, calls code or constructs a collection must retain one initialized value.
dw_const_number = (n: int) -> bool:
    k = nodes[n].kind
    if k == .int_lit or k == .float_lit or k == .bool_lit: return true
    if k == .unary or k == .not_: return dw_const_number(int(nodes[n].a))
    if k == .binary or k == .and_ or k == .or_:
        return dw_const_number(int(nodes[n].a)) and dw_const_number(int(nodes[n].b))
    false

# a word operator (`and`, `in`, `as`) is never a name
dw_word_operator_name = (name: str, at: int):
    if name == "and" or name == "or" or name == "not" or name == "xor" or name == "nand" or name == "nor" or name == "xnor" or name == "in" or name == "as" or name == "transmute":
        fatal(dewy_syntax[at].pos, "`{name}` is a word operator, not a name: choose another name")
    dw_reserved_name(name, at)

dw_reserved_name = (name: str, at: int):
    if at > 0: dewy_reserved_name(name, dewy_syntax[at].pos)

# Words with a fixed meaning cannot be bound: variables, constants, functions,
# parameters, fields, methods, loop and pattern names, and import aliases.
dewy_reserved_name = (name: str, pos: int):
    if len(name) < 3: return
    c = name[0]
    if c != 'e' and c != 'n' and c != 'v': return
    role = ""
    if name == "end": role = "inside brackets it is the last index, as in `xs[end]`"
    else if name == "new": role = "inside brackets it inserts an axis, as in `xs[new]`"
    else if name == "none": role = "it is the empty value"
    else if name == "void": role = "it is the type of no value"
    if role == "": return
    fatal(pos, "'{name}' is reserved, not a name: {role} (use `{name}_`)")

dw_declare = (id: int, constant: bool, top: bool) -> int:
    let id = dw_unwrap(id)
    initial = 0
    lhs = id
    if dw_op(id) == .assign:
        lhs = dw_child(id, 1)
        initial = dw_child(id, 2)
    if constant and initial == 0: return dw_fail(lhs, "a const declaration without an initializer")
    annotation = 0
    if dw_op(lhs) == .colon:
        annotation = dw_child(lhs, 2)
        lhs = dw_child(lhs, 1)
    if dewy_syntax[lhs].kind == .block and dewy_syntax[lhs].text == "[]:":
        if initial == 0: return dw_fail(lhs, "unpacking without a value")
        n = mk(.vardecl, dewy_syntax[id].pos)
        set_list(n, dw_bindings(lhs))
        nodes[n].b = i32(dw_expr(initial))
        if annotation != 0: nodes[n].a = i32(dw_type(annotation))
        if constant: add_flag(n, NF_RDONLY)
        if not top: dw_shadow(dw_bound_names(kids(n)))
        return n
    name = dw_name(lhs)
    dw_word_operator_name(name, lhs)
    if name == "":
        word = dw_leftmost_name(lhs)
        # (or the word just before: `def main():` is `def` then `main(): ...`)
        at = pos_off(dewy_syntax[lhs].pos)
        src = files[pos_file(dewy_syntax[lhs].pos)].src
        loop w in ["def ", "function ", "fn ", "func "]:
            if at >= len(w) and src[at - len(w)..at) == w: word = trim(w)
        if word == "def" or word == "function" or word == "fn" or word == "func": fatal(dewy_syntax[lhs].pos, "a function is a value bound to its name: `main = () => \{ ... }`, `add = (a:int64 b:int64) => a + b`")
        return dw_fail(lhs, "this declaration")
    if not top and initial != 0 and dw_overload_group(initial):
        return dw_fail(initial, "a local overload group; declare it at module level")
    if initial != 0 and dw_op(initial) == .function:
        if top: return dw_function(initial, name)
        dw_shadow([int(dw_name_id(lhs))])
        n = mk(.vardecl, dewy_syntax[id].pos)
        nodes[n].name = i32(intern(name))
        nodes[n].b = i32(dw_function(initial, ""))
        if annotation != 0: nodes[n].a = i32(dw_type(annotation))
        if constant: add_flag(n, NF_RDONLY)
        return n
    mint = dw_grouped(initial)
    structure = 0
    if dw_op(mint) == .amp:
        structure = dw_unwrap(dw_child(mint, 2))
        mint = dw_grouped(dw_child(mint, 1))
    if dw_op(mint) == .kw_of:
        if not top: return dw_fail(id, "local nominal type declarations")
        if annotation != 0 and dw_name(annotation) != "type": return dw_fail(id, "a nominal declaration with a non-type annotation")
        n = mk(.struct_, dewy_syntax[id].pos)
        nodes[n].name = i32(intern(name))
        base = dw_grouped(dw_child(mint, 1))
        if dewy_syntax[base].text == "[]:":
            if structure != 0: return dw_fail(base, "an inline nominal base with added fields")
            structure = base
        else: nodes[n].a = i32(dw_type(base))
        fields: int[]
        methods: int[]
        rows: int[]
        if structure != 0:
            if dewy_syntax[structure].text != "[]:": return dw_fail(structure, "this nominal intersection; expected record fields")
            rows = dw_children(structure)
            outer_siblings = dw_siblings
            dw_siblings = {}
            loop field in rows:
                if ownership_tag(field) != 0 or dw_transfer_row(n, field): continue
                if dw_method_row(field): methods.push(field)
                else: fields.push(dw_param(field, .vardecl))
            dw_siblings = outer_siblings
        set_list(n, fields)
        dw_type_methods(n, rows, methods)
        return n
    inferred_refinement = initial != 0 and dw_op(initial) == .amp and dw_op(dw_grouped(dw_child(initial, 2))) == .tilde
    if not inferred_refinement and annotation != 0 and dw_name(annotation) == "type" and initial != 0 and dw_op(dw_grouped(initial)) == .amp:
        return dw_intersection(id, name, initial, top)
    if annotation == 0 and initial != 0 and dw_op(initial) == .type_apply:
        loop entry in dw_children(dw_child(initial, 2)):
            op = dw_op(dw_grouped(entry))
            if op == .function or op == .kw_and or op == .eq or op == .not_eq or op == .lt or op == .le or op == .gt or op == .ge or op == .contains: inferred_refinement = true
    if inferred_refinement or annotation != 0 and dw_name(annotation) == "type":
        if initial == 0: return dw_fail(id, "a type declaration without a definition")
        type_params: int[]
        if (dw_op(initial) == .index or dw_op(initial) == .call) and dewy_syntax[dw_child(initial, 1)].text == "<>:":
            type_params = dw_type_params(dw_child(initial, 1))
            initial = dw_child(initial, 2)
        if type_params.len() > 0 and dewy_syntax[initial].text == "():" and dw_nchildren(initial) == 1: initial = dw_child(initial, 0)
        if dewy_syntax[initial].text != "[]:" or dw_positional_types(initial):
            n = mk(.typealias, dewy_syntax[id].pos)
            nodes[n].name = i32(intern(name))
            nodes[n].a = i32(dw_type(initial))
            if type_params.len() > 0:
                set_list2(n, type_params)
                add_flag(n, NF_GENERIC)
            return n
        n = mk(.struct_, dewy_syntax[id].pos)
        nodes[n].name = i32(intern(name))
        if type_params.len() > 0:
            set_list2(n, type_params)
            add_flag(n, NF_GENERIC)
        fields: int[]
        methods: int[]
        outer_siblings = dw_siblings
        dw_siblings = {}
        loop field in dw_children(initial):
            if ownership_tag(field) != 0 or dw_transfer_row(n, field): continue
            if dw_method_row(field): methods.push(field)
            else: fields.push(dw_param(field, .vardecl))
        dw_siblings = outer_siblings
        set_list(n, fields)
        if methods.len() > 0 and not top: return dw_fail(methods[0], "methods on a local type; declare the type at module level")
        if top: dw_type_methods(n, dw_children(initial), methods)
        return n
    n = mk(.vardecl, dewy_syntax[id].pos)
    nodes[n].name = i32(intern(name))
    if annotation != 0:
        outer = dw_pattern_binder
        dw_pattern_binder = nodes[n].name
        nodes[n].a = i32(dw_type(annotation))
        dw_pattern_binder = outer
    if initial != 0: nodes[n].b = i32(dw_expr(initial))
    if not top: dw_shadow([int(nodes[n].name)])
    if constant:
        value = int(nodes[n].b)
        if dw_const_number(value) or nodes[value].kind == .str_lit or nodes[value].kind == .none_lit: nodes[n].kind = .const_
        else: add_flag(n, NF_RDONLY)
    decimal_let(n)
    return n

# `Name:type = A & B & [f:T]`: a record with the fields of each operand, merged
# by name when the record is resolved (check_struct_fields); no nominal identity
dw_intersection = (id: int, name: str, initial: int, top: bool) -> int:
    if not top: return dw_fail(id, "a local intersection type; declare it at module level")
    leaves: int[]
    dw_amp_leaves(initial, leaves)
    n = mk(.struct_, dewy_syntax[id].pos)
    nodes[n].name = i32(intern(name))
    components: int[]
    fields: int[]
    methods: int[]
    rows: int[]
    loop leaf in leaves:
        if dewy_syntax[leaf].text == "[]:":
            outer_siblings = dw_siblings
            dw_siblings = {}
            loop field in dw_children(leaf):
                if ownership_tag(field) != 0: continue
                rows.push(field)
                if dw_method_row(field): methods.push(field)
                else: fields.push(dw_param(field, .vardecl))
            dw_siblings = outer_siblings
        else: components.push(dw_type(leaf))
    set_list(n, fields)
    dw_type_methods(n, rows, methods)
    struct_components[n] = components
    n

dw_amp_leaves = (id0: int, out: mut int[]):
    id = dw_grouped(dw_unwrap(id0))
    if dw_op(id) == .amp:
        dw_amp_leaves(dw_child(id, 1), out)
        dw_amp_leaves(dw_child(id, 2), out)
    else: out.push(id)

# The names a declaration's unpacking pattern binds.
dw_bound_names = (bindings: int[]) -> int[]:
    out: int[]
    loop binding in binding_leaves(bindings):
        if nodes[binding].kind == .ident: out.push(int(nodes[binding].name))
    out

# A type's methods become module functions of the same name taking the instance first
# (`s.width` is `width(s)` by the uniform call syntax); no function is stored in the
# object. A generic type's methods take its type parameters first.
# A minted type's methods also reach the members it inherits: from a parent declared
# earlier in this module as they are read, from any other once every module is
# (dewy_resolve_inherited).
dw_type_members: {int: {int: {int: int}}} = {}   # file -> type name -> its members (dewy_method_group)

dw_type_methods = (struct_: int, rows: int[], methods: int[]):
    receiver = intern("$self")
    row_names = dw_row_names(rows)
    inherited: {int: int} = {}
    parent = int(nodes[struct_].a)
    file = pos_file(nodes[struct_].pos)
    types_here = dw_type_members.get(file) ?? {}
    deferred = false
    if parent != 0 and nodes[parent].kind == .tname:
        parent_name = int(nodes[parent].name)
        if let known = types_here.get(parent_name):
            inherited = known
            deferred = dewy_deferred_here(file, parent_name)
        else: deferred = name_of(parent_name) not in ["error", "exception", "any"]
    else if parent != 0: deferred = true
    members: {int: int} = {}
    loop name, member in inherited: members[name] = receiver
    if deferred:
        members[dewy_inherited_key()] = struct_
        dewy_defer_type(struct_, file)
    loop name in row_names: members[name] = receiver
    type_params = kids2(struct_)
    decls: int[]
    hook = 0
    loop row in rows:
        tag = ownership_tag(row)
        if tag != 0:
            if hook != 0: fatal(dewy_syntax[row].pos, "a lifecycle tag must precede one method")
            hook = tag
            continue
        if hook != 0 and not methods.contains(row): fatal(dewy_syntax[row].pos, "a lifecycle tag requires a method")
        if not methods.contains(row):
            decls.push(0)
            continue
        item = dw_unwrap(row)
        name = dw_name(dw_child(item, 1))
        if name == "main": fatal(dewy_syntax[item].pos, "a method cannot be named main")
        loop other in kids(struct_):
            if name_of(int(nodes[other].name)) == name: fatal(dewy_syntax[item].pos, "'{name}' is both a field and a method of {name_of(int(nodes[struct_].name))}")
        outer = dw_siblings
        dw_siblings = members
        fn_ = dw_function(dw_grouped(dw_child(item, 2)), name)
        dw_siblings = outer
        pos = nodes[fn_].pos
        object_type = mk(.tname, pos)
        nodes[object_type].name = nodes[struct_].name
        if type_params.len() > 0:
            own = kids2(fn_)
            params: int[]
            arguments: int[]
            loop tp in type_params:
                loop mine in own:
                    if nodes[mine].name == nodes[tp].name: fatal(nodes[mine].pos, "type parameter '{name_of(int(nodes[tp].name))}' is already {name_of(int(nodes[struct_].name))}'s")
                param = mk(.ident, pos)
                nodes[param].name = nodes[tp].name
                params.push(param)
                argument = mk(.tname, pos)
                nodes[argument].name = nodes[tp].name
                arguments.push(argument)
            set_list(object_type, arguments)
            set_list2(fn_, params + own)
            add_flag(fn_, NF_GENERIC)
        dw_add_receiver(fn_, receiver, object_type)
        if hook != 0:
            ownership_declare(struct_, fn_, hook)
            hook = 0
        dw_pending_decls.push(fn_)
        decls.push(fn_)
    if hook != 0: fatal(nodes[struct_].pos, "a lifecycle tag requires a method")
    first = dewy_methods.len()
    group = dewy_method_group(row_names, decls, inherited)
    dewy_decl_members[struct_] = group
    dewy_decl_methods[struct_] = [first, dewy_methods.len()]
    types_here[int(nodes[struct_].name)] = group
    dw_type_members[file] = types_here
    if methods.len() > 0: dewy_type_members[struct_] = group

dw_import = (id: int) -> int:
    pos = dewy_syntax[id].pos
    n = mk(.import_, pos)
    spec = dw_unwrap(dw_child(id, 1))
    # (`import (a b) from p"x"` is `from p"x" import (a b)`)
    reversed = dewy_syntax[dw_child(id, 0)].text == "import" and dw_nchildren(id) == 4 and dewy_syntax[dw_child(id, 2)].text == "from"
    if reversed: spec = dw_unwrap(dw_child(id, 3))
    alias = ""
    if dw_op(spec) == .kw_as:
        alias = dw_name(dw_child(spec, 2))
        if alias == "": return dw_fail(spec, "this module alias")
        dw_reserved_name(alias, dw_child(spec, 2))
        spec = dw_unwrap(dw_child(spec, 1))
    value = dw_name(spec)
    if value == "":
        if dw_op(spec) != .call or dw_name(dw_child(spec, 1)) != "p": return dw_fail(spec, "this module path; use a library name or p\"file.dewy\"")
        path = dw_unwrap(dw_child(spec, 2))
        if dewy_syntax[path].kind != .string: return dw_fail(path, "a nonliteral module path")
        value = dewy_syntax[path].text
        nodes[n].aux2 = 1
    nodes[n].sval = i32(intern(value))
    nodes[n].name = i32(intern(strip_ext(file_name(value))))
    if alias != "": nodes[n].name = i32(intern(alias))
    if dewy_syntax[dw_child(id, 0)].text == "from" or reversed:
        if dw_nchildren(id) != 4: return dw_fail(id, "this import")
        nodes[n].aux = 2
        selected = dw_unwrap(dw_child(id, if reversed: 1 else: 3))
        imported: int[]
        # `a, b as c` and `(a b as c)`: names in order, each with an optional alias
        words: int[]
        dw_import_words(selected, words)
        i = 0
        loop i < words.len():
            if words[i] < 0 or dw_name(words[i]) == "": return dw_fail(selected, "this imported name")
            item = dw_expr(words[i])
            if i + 1 < words.len() and words[i + 1] == -1:
                if i + 2 >= words.len() or words[i + 2] < 0 or dw_name(words[i + 2]) == "": return dw_fail(selected, "this imported alias")
                dw_reserved_name(dw_name(words[i + 2]), words[i + 2])
                nodes[item].aux = i32(intern(dw_name(words[i + 2])))
                i += 2
            imported.push(item)
            i += 1
            if i < words.len():
                if words[i] != -2: return dw_fail(selected, "this imported name")
                i += 1
        loop item in imported:
            if nodes[item].kind != .ident: return dw_fail(selected, "this imported name")
        set_list(n, imported)
    else if dw_nchildren(id) != 2: return dw_fail(id, "this import alias")
    # (`import p"x.dewy"`: no selection and no name, its top-level bindings splat here)
    else if alias == "" and nodes[n].aux2 == 1: nodes[n].aux = 3
    return n

# The imported names of a selection in written order: names, -1 for `as`,
# -2 between names (a comma, or the next element of a parenthesized list).
dw_import_words = (id0: int, out: mut int[]):
    id = dw_unwrap(id0)
    if dewy_syntax[id].kind == .block and dewy_syntax[id].text == "():":
        loop i in 0.. and child in dw_children(id):
            if i > 0: out.push(-2)
            dw_import_words(child, out)
        return
    op = dw_op(id)
    if op == .kw_as or op == .comma:
        loop i in [1..dw_nchildren(id)):
            if i > 1: out.push(if op == .kw_as: -1 else: -2)
            dw_import_words(dw_child(id, i), out)
        return
    out.push(id)

dw_import_name = (id: int) -> int:
    let id = dw_unwrap(id)
    loop dewy_syntax[id].kind == .block and dewy_syntax[id].text == "():" and dw_nchildren(id) == 1:
        id = dw_unwrap(dw_child(id, 0))
    alias = ""
    if dw_op(id) == .kw_as:
        alias = dw_name(dw_child(id, 2))
        if alias == "": return dw_fail(id, "this imported alias; group each aliased name")
        dw_reserved_name(alias, dw_child(id, 2))
        id = dw_child(id, 1)
    if dw_name(id) == "": return dw_fail(id, "this imported name")
    n = dw_expr(id)
    if alias != "": nodes[n].aux = i32(intern(alias))
    return n

dw_range_value = (range: int) -> int: dewy_range_value(range)

dw_membership = (id: int) -> int:
    r = dw_iterable(id, true, true)
    if nodes[r].kind == .range and (has_flag(r, NF_STEP) or has_flag(r, NF_EXCL_FIRST)): return dw_range_value(r)
    r

# `xs[$clamp a..b)`: the slice truncated to the receiver, as Python's is. The
# bounds are clamped to [0, length] and the end to at least the start, so it
# is always in bounds; the receiver and the bounds are evaluated once, in order.
dw_clamp_slice = (n: int, right: int, xs: int[]) -> int:
    pos = nodes[n].pos
    tag = dewy_syntax[xs[0]].text
    if tag != "clamp": fatal(dewy_syntax[xs[0]].pos, "`${tag}` is not an index setting: `$clamp` truncates a slice to the receiver, as in `xs[$clamp a..b)`")
    if xs.len() != 2 or dw_op(xs[1]) != .range_apply: fatal(dewy_syntax[xs[0]].pos, "`$clamp` truncates one range: `xs[$clamp a..b)`")
    wrapper = dewy_syntax.len()
    dewy_syntax.push(DewySyntax(kind = .block, text = dewy_syntax[right].text, pos = dewy_syntax[right].pos, children = [xs[1]]))
    r = dw_iterable(wrapper, true)
    if nodes[r].kind != .range or has_flag(r, NF_STEP): fatal(dewy_syntax[xs[1]].pos, "`$clamp` truncates a contiguous slice: `xs[$clamp a..b)`")
    source = "$clamp_source{n}"
    length = "$clamp_length{n}"
    lo = "$clamp_start{n}"
    hi = "$clamp_stop{n}"
    count = mk(.field, pos)
    nodes[count].a = i32(bc_ident(source, pos))
    nodes[count].name = i32(intern("length"))
    stmts = [bc_let(source, int(nodes[n].a), pos), bc_let(length, count, pos)]
    if nodes[n].sval != 0: stmts.push(bc_let(name_of(int(nodes[n].sval)), bc_bin(.minus, bc_ident(length, pos), bc_int(1, pos), pos), pos))
    stmts.push(bc_let(lo, (if nodes[r].a != 0: int(nodes[r].a) else: bc_int(0, pos)), pos))
    stmts.push(bc_if(bc_bin(.lt, bc_ident(lo, pos), bc_int(0, pos), pos), [bc_assign(bc_ident(lo, pos), bc_int(0, pos), pos)], [], pos))
    stmts.push(bc_if(bc_bin(.gt, bc_ident(lo, pos), bc_ident(length, pos), pos), [bc_assign(bc_ident(lo, pos), bc_ident(length, pos), pos)], [], pos))
    stop = bc_ident(length, pos)
    if nodes[r].b != 0:
        stop = int(nodes[r].b)
        if has_flag(r, NF_INCLUSIVE): stop = bc_bin(.plus, stop, bc_int(1, pos), pos)
    stmts.push(bc_let(hi, stop, pos))
    stmts.push(bc_if(bc_bin(.gt, bc_ident(hi, pos), bc_ident(length, pos), pos), [bc_assign(bc_ident(hi, pos), bc_ident(length, pos), pos)], [], pos))
    stmts.push(bc_if(bc_bin(.lt, bc_ident(hi, pos), bc_ident(lo, pos), pos), [bc_assign(bc_ident(hi, pos), bc_ident(lo, pos), pos)], [], pos))
    bounds = mk(.range, pos)
    nodes[bounds].a = i32(bc_ident(lo, pos))
    nodes[bounds].b = i32(bc_ident(hi, pos))
    slice = mk(.index, pos)
    nodes[slice].a = i32(bc_ident(source, pos))
    set_list(slice, [bounds])
    nodes[slice].b = i32(bounds)
    stmts.push(bc_stmt(slice, pos))
    bc_block(stmts, pos)

# `new ..`, `.. new` and `new .. new` read as ranges; inside brackets they are
# the entries `new`, a whole axis, and `new`. Empty when id is no such range.
dw_new_range_at = (id0: int) -> bool:
    id = dw_unwrap(id0)
    if dw_op(id) != .range_apply: return false
    size = dw_nchildren(id)
    size >= 3 and (dw_name(dw_child(id, 1)) == "new" or dw_name(dw_child(id, size - 1)) == "new")

dw_new_range = (id0: int) -> int[]:
    out: int[]
    id = dw_unwrap(id0)
    size = dw_nchildren(id)
    first = dw_name(dw_child(id, 1))
    last = dw_name(dw_child(id, size - 1))
    if (first != "new" and first != "..") or (last != "new" and last != "..") or size > 4:
        fatal(dewy_syntax[id].pos, "`new` is an index entry, not a range endpoint: write `xs[new ..]` or `xs[.. new]`, and bracket a range next to it, as in `xs[new [1..end]]`")
    pos = dewy_syntax[id].pos
    if first == "new": out.push(bc_ident("$new", pos))
    out.push(mk(.range, pos))
    if last == "new": out.push(bc_ident("$new", pos))
    out

dw_iterable = (id: int, slice: bool = false, membership: bool = false) -> int:
    let id = dw_unwrap(id)
    inclusive = true
    exclude_first = false
    if dewy_syntax[id].kind == .block and dw_nchildren(id) == 1 and (dw_op(dw_child(id, 0)) == .range_apply or dw_name(dw_child(id, 0)) == ".."):
        wrapper = dewy_syntax[id].text
        if wrapper not in ["[]:", "[):", "():", "(]:"]: return dw_fail(id, "this range boundary")
        inclusive = wrapper == "[]:" or wrapper == "(]:"
        exclude_first = wrapper == "():" or wrapper == "(]:"
        if exclude_first and slice and not membership: return dw_fail(id, "a slice with an exclusive first bound")
        id = dw_unwrap(dw_child(id, 0))
    if slice and dw_name(id) == "..": return mk(.range, dewy_syntax[id].pos)
    if dw_op(id) != .range_apply:
        value = dw_expr(id)
        if slice: return value
        # Resolve streaming text/ranges and dense dictionary snapshots once,
        # before combined-loop desugaring.
        call = mk(.call, dewy_syntax[id].pos)
        callee = mk(.ident, dewy_syntax[id].pos)
        nodes[callee].name = i32(intern("__dewy_iter"))
        nodes[call].a = i32(callee)
        set_list(call, [value])
        return call
    size = dw_nchildren(id)
    n = mk(.range, dewy_syntax[id].pos)
    at = 1
    if dw_name(dw_child(id, at)) != "..":
        first = dw_unwrap(dw_child(id, at))
        if dw_op(first) == .comma:
            if dw_nchildren(first) != 3: return dw_fail(first, "a stepped range without exactly two starting values")
            nodes[n].a = i32(dw_expr(dw_child(first, 1)))
            nodes[n].c = i32(dw_expr(dw_child(first, 2)))
            add_flag(n, NF_STEP)
        else: nodes[n].a = i32(dw_expr(first))
        at += 1
    else if not slice: return dw_fail(id, "a loop range without a start")
    if at >= size or dw_name(dw_child(id, at)) != ".." or size > at + 2: return dw_fail(id, "this range")
    if size == at + 2: nodes[n].b = i32(dw_expr(dw_child(id, at + 1)))
    if inclusive: add_flag(n, NF_INCLUSIVE)
    if exclude_first:
        add_flag(n, NF_EXCL_FIRST)
        if not slice: return bc_call("__dewy_iter", [dw_range_value(n)], dewy_syntax[id].pos)
    return n

# `loop item in @items` iterates the place live: an array's current length and
# element at each step (worklists), or an iterator bound by name, stepped in
# place so the body can steer it (`let w=tree.walk` then `loop node in @w`).
# Which one the place's type decides (check_live_loop).
dw_live_loop = (n: int, binder: int, place: int) -> int:
    source = dw_expr(place)
    root = source
    loop nodes[root].kind == .field: root = int(nodes[root].a)
    if nodes[root].kind != .ident: return dw_fail(place, "live iteration over this expression; use an array or iterator binding or a field of one, `loop item in @items`")
    set_list(n, [binder])
    nodes[n].a = i32(source)
    dewy_live_sources[source] = true
    n

dw_loop_head = (id: int, combined: bool = false) -> int:
    let id = dw_unwrap(id)
    op = dw_op(id)
    n = mk(.lhead, dewy_syntax[id].pos)
    header = id
    # (`loop node in w=tree.walk()`: the iterator is bound first, then its place iterated)
    if op == .assign and dw_op(dw_child(id, 1)) == .kw_in:
        named = dw_unwrap(dw_child(dw_unwrap(dw_child(id, 1)), 2))
        it_name = dw_name(named)
        if it_name == "": it_name = "it"
        fatal(dewy_syntax[id].pos, "bind the iterator first, then loop over its place so the body can steer it: `let {it_name}=source` then `loop item in @{it_name} \{ ... }`")
    if op == .kw_in:
        source_id = dw_child(header, 2)
        nodes[n].op = 1
        binder = dw_unwrap(dw_child(header, 1))
        if dw_op(binder) == .at:
            if combined: return dw_fail(binder, "a mutable binding in a combined loop; use a separate loop @item in items")
            add_flag(n, NF_MUT)
            binder = dw_unwrap(dw_child(binder, 1))
        binders: int[]
        # The binders hide members of their names in the body, not in the iterable.
        before = dw_siblings
        if dewy_syntax[binder].kind == .block and dewy_syntax[binder].text == "[]:":
            if has_flag(n, NF_MUT): return dw_fail(binder, "unpacking a mutable loop binding; use a named @item and its fields")
            binders = dw_bindings(binder)
            # A one-element pattern still unpacks the iteration value. Keep
            # its brackets instead of collapsing it to an ordinary name.
            if binders.len() == 1:
                pattern = mk(.tuple, dewy_syntax[binder].pos)
                set_list(pattern, binders)
                binders = [pattern]
        else:
            if dw_name(binder) == "":
                if dw_op(binder) == .comma: fatal(dewy_syntax[binder].pos, "several loop names go in brackets: `loop [key value] in pairs \{ ... }`")
                return dw_fail(binder, "this loop binding")
            dw_reserved_name(dw_name(binder), binder)
            dw_shadow([int(dw_name_id(binder))])
            binders.push(dw_expr(binder))
        set_list(n, binders)
        dw_shadow(dw_bound_names(binders))
        inside = dw_siblings
        dw_siblings = before
        source = dw_unwrap(source_id)
        if dw_op(source) == .at:
            if combined: return dw_fail(source, "live iteration (`in @items`) in a combined loop; use `loop item in @items` alone")
            if has_flag(n, NF_MUT): fatal(dewy_syntax[id].pos, "`loop @item in @items` combines two places: iterate the live array by value (`loop item in @items`) or edit its elements in place (`loop @item in items`)")
            if binders.len() != 1 or nodes[binders[0]].kind != .ident: fatal(dewy_syntax[binder].pos, "a live loop (`in @items`) binds one name: bind the element, then unpack it in the body")
            live = dw_live_loop(n, binders[0], dw_child(source, 1))
            dw_siblings = inside
            return live
        it = if has_flag(n, NF_MUT): dw_expr(source_id) else: dw_iterable(source_id)
        dw_siblings = inside
        if has_flag(n, NF_MUT):
            # Element aliases reuse this route. Indexed/call routes need a captured
            # selector rather than reevaluating effects at each access.
            root = it
            loop nodes[root].kind == .field: root = int(nodes[root].a)
            if nodes[root].kind != .ident:
                return dw_fail(id, "mutable iteration over this expression; use an array binding or a field of one")
        if combined and nodes[it].kind == .range and has_flag(it, NF_STEP):
            if nodes[it].b == 0:
                it = bc_call("__dewy_open_range_iter", [int(nodes[it].a), int(nodes[it].c)], nodes[it].pos)
            else: it = bc_call("__dewy_iter", [dw_range_value(it)], nodes[it].pos)
        nodes[n].a = i32(it)
    else if op == .kw_and or op == .kw_or:
        nodes[n].op = if op == .kw_and: 2 else: 3
        nodes[n].a = i32(dw_loop_head(dw_child(id, 1), true))
        nodes[n].b = i32(dw_loop_head(dw_child(id, 2), true))
        return head_collapse(n)
    else:
        nodes[n].op = 4
        nodes[n].a = i32(dw_expr(id))
    return n

# Match bodies use the same statement/value blocks as functions and conditionals.
dw_flow_stmt = (n: int) -> int:
    if nodes[n].kind != .match_: return n
    s = mk(.exprstmt, nodes[n].pos)
    nodes[s].a = i32(n)
    s

dw_pattern = (id: int) -> int:
    let id = dw_unwrap(id)
    pos = dewy_syntax[id].pos
    name = dw_name(id)
    # (`else` is a keyword of the flow chain, not a name to bind)
    if name == "else": fatal(pos, "`else` follows the arms, outside the braces: `match v \{...} else ...`; as an arm, `_ => ...` matches everything left")
    if name != "":
        p = mk(.pwild, pos)
        if name != "_": nodes[p].name = i32(intern(name))
        return p
    # (`[sign:1 limbs]`: an object shape; `(a:int64 <string>)`: a sequence)
    shape = dewy_syntax[id].kind == .block and dewy_syntax[id].text == "[]:"
    if shape or dewy_syntax[id].kind == .block and dewy_syntax[id].text == "():" and dw_nchildren(id) >= 2:
        p = mk(if shape: NK.pshape else: NK.pseq, pos)
        parts: int[]
        loop child in dw_children(id):
            part = dw_pattern(child)
            if shape and nodes[part].name == 0: return dw_fail(child, "an object pattern field without a name")
            parts.push(part)
        set_list(p, parts)
        return p
    binding = ""
    if dw_op(id) == .colon:
        binding = dw_name(dw_child(id, 1))
        if binding == "": return dw_fail(id, "this match binding")
        id = dw_unwrap(dw_child(id, 2))
    else if dewy_syntax[id].kind == .block and dewy_syntax[id].text == "<>:" and dw_nchildren(id) == 1:
        id = dw_unwrap(dw_child(id, 0))
    else: return dw_fail(id, "this match pattern")
    k = dewy_syntax[id].kind
    literal = dw_integer_kind(k) or k == .string or k == .boolean or dw_name(id) == "none"
    if dw_op(id) == .minus: literal = dw_integer_kind(dewy_syntax[dw_unwrap(dw_child(id, 1))].kind)
    byte = dw_byte_char(id)
    if byte >= 0:
        p = mk(.plit, pos)
        nodes[p].a = i32(bc_int(byte, pos))
        if binding != "" and binding != "_": nodes[p].name = i32(intern(binding))
        return p
    p = mk(if literal: NK.plit else: NK.ptype, pos)
    # (`small:int64<small <? 100>`: the arm's binding names the refined value)
    if binding != "" and binding != "_": dw_pattern_binder = i32(intern(binding))
    nodes[p].a = i32(if literal: dw_expr(id) else: dw_type(id))
    dw_pattern_binder = 0
    if binding != "" and binding != "_": nodes[p].name = i32(intern(binding))
    p

# (`o:Opened => total = 0`: `=` binds more loosely than `=>`, so the arm is the
# assignment's target)
dw_arm_fail = (source: int) -> int:
    op = dw_op(source)
    if (op == .assign or dn_token_assignment(op)) and dw_op(dw_child(source, 1)) == .function:
        fatal(dewy_syntax[source].pos, "an arm whose body assigns needs braces, `pattern => \{target = value}`: `=` binds more loosely than `=>`, so without them the whole arm is the assignment's target")
    dw_fail(source, "a match arm without =>")

# (a comma outside brackets anywhere in this tree)
dw_has_comma = (id: int) -> bool:
    let id = dw_unwrap(id)
    if dw_op(id) == .comma: return true
    k = dewy_syntax[id].kind
    if k != .binary and k != .prefix and k != .postfix and k != .flat: return false
    loop i in [1..dw_nchildren(id)):
        c = dw_child(id, i)
        if c != 0 and dw_has_comma(c): return true
    false

# (`def main():`: the first word of a juxtaposition or call)
dw_leftmost_name = (id: int) -> str:
    let id = dw_unwrap(id)
    loop dewy_syntax[id].kind == .binary or dewy_syntax[id].kind == .postfix:
        id = dw_unwrap(dw_child(id, 1))
    dw_name(id)

# (Python's and C's `f(1, 2)`, `[1, 2]` and `(a, b)`)
dw_comma_fail = (id: int) -> int:
    fatal(dewy_syntax[id].pos, "Dewy separates arguments, parameters and elements with spaces, not commas: `add(1 2)`, `(a:int64 b:int64) => ...`, `[1 2 3]` (a comma steps a range, as in `[0,2..10]`)")
    0

# the names a pattern binds
dw_pattern_names = (p: int, out: mut int[]):
    if nodes[p].kind == .pshape or nodes[p].kind == .pseq:
        loop part in kids(p): dw_pattern_names(part, out)
    else if nodes[p].name != 0:
        dewy_reserved_name(name_of(int(nodes[p].name)), nodes[p].pos)
        out.push(int(nodes[p].name))

dw_match = (id: int, accumulator: int = 0, map: bool = false) -> int:
    n = mk(.match_, dewy_syntax[id].pos)
    scrutinee = dw_unwrap(dw_child(id, 1))
    # (`match (x y) (a:int64 b:int64) => a + b`: a sequence of values, each read once)
    if dewy_syntax[scrutinee].kind == .block and dewy_syntax[scrutinee].text == "():" and dw_nchildren(scrutinee) >= 2:
        values = mk(.tuple, dewy_syntax[scrutinee].pos)
        items: int[]
        loop child in dw_children(scrutinee): items.push(dw_expr(child))
        set_list(values, items)
        nodes[n].a = i32(values)
    else: nodes[n].a = i32(dw_expr(dw_child(id, 1)))
    body = dw_child(id, 2)
    arms = [body]
    if dewy_syntax[body].kind == .block and dewy_syntax[body].text == "{{}}:": arms = dw_children(body)
    xs: int[]
    loop source in arms:
        if dw_op(source) != .function: return dw_arm_fail(source)
        arm = mk(.arm, dewy_syntax[source].pos)
        pattern = dw_pattern(dw_child(source, 1))
        set_list(arm, [pattern])
        outer_siblings = dw_siblings
        bound: int[]
        dw_pattern_names(pattern, bound)
        if bound.len() > 0: dw_shadow(bound)
        nodes[arm].b = i32(dw_block(dw_child(source, 2), accumulator, map))
        dw_siblings = outer_siblings
        xs.push(arm)
    set_list(n, xs)
    n

# Parallel bodies become visible callbacks, so the existing race checker
# checks captured/global writes transitively. Mutable element bindings use the
# library's unique-array partition path; each callback owns one value.
dw_parallel_exits = (n: int, depth: int = 0):
    if n == 0 or nodes[n].kind == .lambda or nodes[n].kind == .fn_: return
    k = nodes[n].kind
    if k == .return_: fatal(nodes[n].pos, "return cannot leave a parallel body; return a comprehension value instead")
    if (k == .break_ or k == .continue_) and depth == 0:
        fatal(nodes[n].pos, "break and continue cannot leave a parallel body")
    inner = depth
    if k == .for_ or k == .while_ or k == .loopx: inner += 1
    dw_parallel_exits(int(nodes[n].a), depth)
    dw_parallel_exits(int(nodes[n].b), inner)
    dw_parallel_exits(int(nodes[n].c), depth)
    loop child in kids(n): dw_parallel_exits(child, depth)

dw_parallel = (arm: int, collect: bool) -> int:
    pos = dewy_syntax[arm].pos
    head = dw_unwrap(dw_child(arm, 1))
    if dw_op(head) != .kw_in: return dw_fail(head, "a parallel loop without one bounded iterable")
    binder = dw_unwrap(dw_child(head, 1))
    mutable = dw_op(binder) == .at
    if mutable: binder = dw_unwrap(dw_child(binder, 1))
    name = dw_name(binder)
    if name == "": return dw_fail(binder, "a parallel binding without a single name")
    dw_reserved_name(name, binder)
    if collect and mutable: return dw_fail(binder, "a mutable parallel comprehension binding")
    source = dw_expr(dw_child(head, 2))
    param = mk(.param, dewy_syntax[binder].pos)
    nodes[param].name = i32(intern(name))
    outer_siblings = dw_siblings
    dw_shadow([int(nodes[param].name)])
    outer_result = dw_fn_result
    dw_fn_result = if collect: 1 else: 0
    body = dw_block(dw_child(arm, 2))
    dw_fn_result = outer_result
    dw_siblings = outer_siblings
    dw_parallel_exits(body)
    fn_ = mk(.lambda, pos)
    add_flag(fn_, NF_LANG_BODY)
    if not collect and not mutable: add_flag(fn_, NF_VOID)
    if mutable:
        ret = mk(.return_, pos)
        nodes[ret].a = i32(bc_ident(name, pos))
        statements = kids(body)
        statements.push(ret)
        set_list(body, statements)
        add_flag(source, NF_MUT)
    if mutable: dw_finish_function(fn_, [param], body, "")
    else:
        # Like `loop x`, a value binding is read-only. Only `@x` makes
        # the local value that will be written back to its partition.
        set_list(fn_, [param])
        nodes[fn_].b = i32(body)
    call = bc_call(if mutable: "parallel_update" else if collect: "__dewy_parallel_collect" else: "__dewy_parallel_each", [source, fn_], pos)
    region = mk(.parallel_region, pos)
    nodes[region].a = i32(call)
    if collect: return region
    statement = mk(.exprstmt, pos)
    nodes[statement].a = i32(region)
    statement

dw_flow = (id: int, at: int, accumulator: int = 0, map: bool = false) -> int:
    items = dw_children(id)
    if at >= items.len(): return 0
    arm = items[at]
    if dewy_syntax[arm].kind != .keyword_expr: return dw_block(arm, accumulator, map)
    word = dewy_syntax[dw_child(arm, 0)].text
    if word == "match":
        n = dw_match(arm, accumulator, map)
        if at + 1 < items.len():
            rest = dw_flow(id, at + 1, accumulator, map)
            if nodes[rest].kind != .block:
                block = mk(.block, nodes[rest].pos)
                set_list(block, [dw_flow_stmt(rest)])
                rest = block
            fallback = mk(.arm, nodes[rest].pos)
            set_list(fallback, [mk(.pwild, nodes[rest].pos)])
            nodes[fallback].b = i32(rest)
            xs = kids(n)
            xs.push(fallback)
            set_list(n, xs)
        return n
    if word == "parallel":
        if at + 1 < items.len(): return dw_fail(arm, "an else arm on a parallel loop")
        if accumulator != 0: return dw_fail(arm, "a nested parallel collector; collect it as a separate array value")
        return dw_parallel(arm, false)
    if word != "if" and word != "loop": return dw_block(arm, accumulator, map)
    if dw_nchildren(arm) != 3: return dw_fail(arm, "this flow arm")
    if word == "if":
        fold = dw_target_condition(dw_child(arm, 1))
        if fold == 1: return dw_block(dw_child(arm, 2), accumulator, map)
        if fold == 0:
            if at + 1 < items.len(): return dw_flow(id, at + 1, accumulator, map)
            return mk(.block, dewy_syntax[arm].pos)
    n = mk(if word == "if": NK.if_ else: NK.while_, dewy_syntax[arm].pos)
    outer_siblings = dw_siblings
    if word == "loop":
        head = dw_loop_head(dw_child(arm, 1))
        if at + 1 < items.len():
            nodes[n].kind = .loopx
            nodes[n].a = i32(head)
        else if nodes[head].op == 1:
            nodes[n].kind = .for_
            nodes[n].a = nodes[head].a
            if has_flag(head, NF_MUT): add_flag(n, NF_MUT)
            set_list(n, kids(head))
        else if nodes[head].op == 4: nodes[n].a = nodes[head].a
        else:
            nodes[n].kind = .loopx
            nodes[n].a = i32(head)
    else: nodes[n].a = i32(dw_expr(dw_child(arm, 1)))
    nodes[n].b = i32(dw_block(dw_child(arm, 2), accumulator, map))
    dw_siblings = outer_siblings
    if at + 1 < items.len():
        rest = dw_flow(id, at + 1, accumulator, map)
        if nodes[rest].kind != .block:
            block = mk(.block, dewy_syntax[arm].pos)
            set_list(block, [dw_flow_stmt(rest)])
            rest = block
        nodes[n].c = i32(rest)
    return n

dw_label_fail = (pos: int, label: int):
    if name_of(label) == "explicit_allocation_failure": fatal(pos, "`$explicit_allocation_failure` is a module directive; put it at file scope, at the top")
    fatal(pos, "a loop label must be followed by a loop (`${name_of(label)}` is not a directive)")

dw_block = (id: int, accumulator: int = 0, map: bool = false) -> int:
    n = mk(.block, dewy_syntax[id].pos)
    scoped = dw_siblings.len() > 0
    outer_siblings: {int: int} = {}
    if scoped: outer_siblings = dw_siblings
    statements: int[]
    if dewy_syntax[id].kind == .block and dewy_syntax[id].text == "{{}}:":
        children = dw_dir_block(id, dw_target_splice(dw_children(id)))
        label = 0
        label_pos = 0
        loop i in 0.. and child in children:
            if dewy_syntax[child].kind == .metatag and dewy_syntax[child].text != "target":
                if dewy_syntax[child].text == "supported_targets": dw_metatag_fail(child)
                if dw_designed_directive(dewy_syntax[child].text) or dewy_syntax[child].text == "capture" or dewy_syntax[child].text == "include_bytes" or dewy_syntax[child].text == "shadowable": dw_metatag_fail(child)
                if label != 0: dw_label_fail(label_pos, label)
                label = intern(dewy_syntax[child].text)
                label_pos = dewy_syntax[child].pos
                continue
            statement = if accumulator != 0 and i + 1 == children.len(): dw_collect(child, accumulator, map) else: dw_stmt(child)
            if label != 0:
                if nodes[statement].kind != .loopx and nodes[statement].kind != .for_ and nodes[statement].kind != .while_: dw_label_fail(label_pos, label)
                nodes[statement].sval = i32(label)
                label = 0
            statements.push(statement)
        if label != 0: dw_label_fail(label_pos, label)
    else if accumulator != 0: statements.push(dw_collect(id, accumulator, map))
    else: statements.push(dw_stmt(id))
    if scoped: dw_siblings = outer_siblings
    set_list(n, statements)
    return n

# Comprehensions use ordinary loops, conditionals and push calls, following the
# implementation-language frontend. No lazy runtime or separate ownership path.
dw_collection_kind = (id: int) -> int:
    let id = dw_unwrap(id)
    kind = dewy_syntax[id].kind
    children = dw_children(id)
    candidates: int[]
    if kind == .flow:
        loop arm in children:
            if dewy_syntax[arm].kind == .keyword_expr:
                word = dewy_syntax[dw_child(arm, 0)].text
                if word == "match":
                    body = dw_child(arm, 2)
                    arms = [body]
                    if dewy_syntax[body].kind == .block: arms = dw_children(body)
                    loop branch in arms:
                        if dw_op(branch) != .function: return dw_arm_fail(branch)
                        candidates.push(dw_child(branch, 2))
                else: candidates.push(dw_child(arm, 2))
            else: candidates.push(arm)
    else if kind == .block and dewy_syntax[id].text == "{{}}:":
        if children.len() == 0: return 0
        candidates.push(children[children.len() - 1])
    else:
        if dw_op(id) == .assign and dw_field_name(dw_child(id, 1)) != 0: return 3
        if kind == .keyword_expr or kind == .compact_stmt or dn_token_statement(dw_op(id)): return 0
        return if dw_op(id) == .arrow: 2 else: 1
    result = 0
    loop candidate in candidates:
        next = dw_collection_kind(candidate)
        if next == 0: continue
        if result != 0 and result != next: fatal(dewy_syntax[candidate].pos, "a comprehension cannot mix array elements and dictionary entries")
        result = next
    result

dw_collect = (id: int, accumulator: int, map: bool) -> int:
    let id = dw_unwrap(id)
    kind = dewy_syntax[id].kind
    if kind == .flow:
        n = dw_flow(id, 0, accumulator, map)
        add_flag(n, NF_STMT)
        return dw_flow_stmt(n)
    if kind == .block and dewy_syntax[id].text == "{{}}:": return dw_block(id, accumulator, map)
    if kind == .keyword_expr or kind == .compact_stmt or dn_token_statement(dw_op(id)): return dw_stmt(id)
    pos = dewy_syntax[id].pos
    value = 0
    if map:
        if dw_op(id) != .arrow: return dw_fail(id, "a dictionary comprehension element without ->")
        value = mk(.tuple, pos)
        add_flag(value, NF_MAP_PAIR)
        set_list(value, [dw_expr(dw_child(id, 1)), dw_expr(dw_child(id, 2))])
    else: value = dw_expr(id)
    receiver = mk(.ident, pos)
    nodes[receiver].name = i32(accumulator)
    add_flag(receiver, NF_MUT)
    callee = mk(.field, pos)
    nodes[callee].a = i32(receiver)
    nodes[callee].name = i32(intern("push"))
    call = mk(.call, pos)
    nodes[call].a = i32(callee)
    set_list(call, [value])
    statement = mk(.exprstmt, pos)
    nodes[statement].a = i32(call)
    statement

dw_record_loop = (id: int) -> int:
    let id = dw_unwrap(id)
    if dewy_syntax[id].kind == .flow:
        items = dewy_syntax[id].children
        if items.len() != 1: return dw_fail(id, "a conditional record shape")
        arm = items[0]
        if dewy_syntax[dw_child(arm, 0)].text != "loop": return dw_fail(arm, "a record shape without a compile-time loop")
        head = dw_loop_head(dw_child(arm, 1))
        if nodes[head].op != 1 or nkids(head) != 1: return dw_fail(arm, "a combined record loop")
        n = mk(.record_loop, dewy_syntax[id].pos)
        nodes[n].a = nodes[head].a
        nodes[n].name = nodes[kid(head, 0)].name
        nodes[n].b = i32(dw_record_loop(dw_child(arm, 2)))
        return n
    if dewy_syntax[id].kind == .block and dewy_syntax[id].text == "{{}}:":
        if dewy_syntax[id].children.len() != 1: return dw_fail(id, "a record loop body with multiple entries")
        return dw_record_loop(dw_child(id, 0))
    dw_record_entry(id)

dw_comprehension = (id: int) -> int:
    first = dw_child(id, 0)
    if dewy_syntax[first].kind == .keyword_expr and dewy_syntax[dw_child(first, 0)].text == "parallel":
        if dw_nchildren(id) != 1: return dw_fail(id, "an else arm on a parallel comprehension")
        return dw_parallel(first, true)
    pos = dewy_syntax[id].pos
    if dw_collection_kind(id) == 3: return dw_record_loop(id)
    map = dw_collection_kind(id) == 2
    # `$` cannot begin an ordinary identifier, so this binding cannot capture a
    # user-written name, including one inside a nested comprehension.
    accumulator = intern("$dewy_collection_{nodes.len()}")
    decl = mk(.vardecl, pos)
    nodes[decl].name = i32(accumulator)
    nodes[decl].b = i32(mk(.array, pos))
    body = dw_collect(id, accumulator, map)
    result = mk(.exprstmt, pos)
    value = mk(.ident, pos)
    nodes[value].name = i32(accumulator)
    nodes[result].a = i32(value)
    block = mk(.block, pos)
    set_list(block, [decl, body, result])
    add_flag(block, NF_COMPREHENSION)
    if not map: return block
    callee = mk(.ident, pos)
    nodes[callee].name = i32(intern("__map_of"))
    call = mk(.call, pos)
    nodes[call].a = i32(callee)
    set_list(call, [block])
    call

# Strip grouping parentheses when recognizing a function declaration or group.
dw_grouped = (id: int) -> int:
    let id = dw_unwrap(id)
    loop dewy_syntax[id].kind == .block and dewy_syntax[id].text == "():" and dw_nchildren(id) == 1:
        id = dw_unwrap(dw_child(id, 0))
    id

# An `&` chain joining a function literal is an overload group; otherwise `&` is
# an ordinary operator (set intersection, bitwise and).
dw_overload_group = (id: int) -> bool:
    let id = dw_grouped(id)
    if dw_op(id) != .amp: return false
    loop i in [1..dw_nchildren(id)):
        member = dw_grouped(dw_child(id, i))
        if dw_op(member) == .function or dw_overload_group(member): return true
    false

dw_overload_members = (id: int, name: str, declarations: mut int[]):
    let id = dw_grouped(id)
    if dw_op(id) == .amp:
        loop i in [1..dw_nchildren(id)):
            dw_overload_members(dw_child(id, i), name, declarations)
    else if dw_op(id) == .function: declarations.push(dw_function(id, name))
    else: dw_fail(id, "an overload group member other than a function literal")

# Expand a static overload group directly into ordinary declarations. This keeps
# overload selection, generic specialization and callable context in one checker.
dw_top_declarations = (id: int) -> int[]:
    tag = dw_unwrap(id)
    if dewy_syntax[tag].kind == .metatag and dewy_syntax[tag].text == "proof":
        if proof_pending: fatal(dewy_syntax[tag].pos, "duplicate $proof")
        proof_pending = true
        proof_active = true
        refine_active = true
        return []
    if dw_export_tag(tag):
        dw_export_begin(tag)
        return []
    exported = dw_export_pos != 0
    pending = proof_pending
    made = dw_top_declarations_inner(id)
    if exported: dw_export_attach(made)
    if pending:
        if made.len() != 1 or nodes[made[0]].kind != .fn_: fatal(dewy_syntax[id].pos, "$proof requires a function declaration")
        if not proof_decls.has(made[0]): proof_decls[made[0]] = 0
        proof_pending = false
    made

dw_top_declarations_inner = (id: int) -> int[]:
    declaration = dw_unwrap(id)
    # (a directly built overload group: its member declarations)
    if dewy_syntax[declaration].kind == .compact_stmt and dewy_syntax[declaration].children.len() > 0: return dewy_syntax[declaration].children
    if dw_op(declaration) == .statement_end: declaration = dw_unwrap(dw_child(declaration, 1))
    if dw_target_live(declaration) >= 0:
        spliced: int[]
        loop item in dw_target_splice([declaration]):
            loop made in dw_top_declarations(item): spliced.push(made)
        return spliced
    tag = declaration
    if dw_op(declaration) == .assign: tag = dw_unwrap(dw_child(declaration, 1))
    if dewy_syntax[tag].kind == .metatag and dewy_syntax[tag].text == "explicit_allocation_failure":
        if tag != declaration: fatal(dewy_syntax[tag].pos, "`$explicit_allocation_failure` stands alone at the top of a module")
        oom_module(pos_file(dewy_syntax[tag].pos), dewy_syntax[tag].pos)
        return []
    if dewy_syntax[tag].kind == .metatag:
        file = pos_file(dewy_syntax[tag].pos)
        if dw_dir_statement(declaration, dir_module_start(file), dir_module_end(file), true): return []
    if dewy_syntax[tag].kind == .metatag and dewy_syntax[tag].text == "supported_targets":
        dw_supported_targets(tag, declaration)
        return []
    if dewy_syntax[declaration].kind == .keyword_expr:
        word = dewy_syntax[dw_child(declaration, 0)].text
        if word == "let" or word == "const": declaration = dw_unwrap(dw_child(declaration, 1))
    if dw_op(declaration) == .assign:
        name = dw_name(dw_child(declaration, 1))
        dw_reserved_name(name, dw_child(declaration, 1))
        initial = dw_grouped(dw_child(declaration, 2))
        if name != "" and dw_op(initial) == .type_apply:
            loop entry in dw_children(dw_child(initial, 2)):
                op = dw_op(dw_grouped(entry))
                if op == .function or op == .kw_and or op == .eq or op == .not_eq or op == .lt or op == .le or op == .gt or op == .ge or op == .contains: return [dw_declare(declaration, false, true)]
        mint = initial
        if dw_op(mint) == .amp: mint = dw_grouped(dw_child(mint, 1))
        if name != "" and dw_op(mint) == .kw_of: return dw_with_methods(dw_declare(declaration, false, true))
        if name != "" and dw_op(initial) == .amp:
            if dw_op(dw_grouped(dw_child(initial, 2))) == .tilde: return [dw_declare(declaration, false, true)]
            if name == "main": return [dw_fail(id, "an overloaded entry point")]
            declarations: int[]
            dw_overload_members(initial, name, declarations)
            return declarations
        if name != "" and dw_op(initial) == .function:
            if dw_ffi_body(dw_child(initial, 2)) == "intrinsic":
                dw_intrinsic_check(dw_child(initial, 2), name, dewy_syntax[initial].pos)
                return []
            return [dw_function(initial, name)]
    dw_with_methods(dw_stmt(id, true))

# A declaration followed by the module functions its type's methods became.
dw_with_methods = (declaration: int) -> int[]:
    declarations = [declaration]
    loop method in dw_pending_decls: declarations.push(method)
    dw_pending_decls = []
    declarations

# `$send=false` / `$sync=false` opt a type out of Send / Sync; `$send` and
# `$sync` claim them, and `$unsafe` among the rows is the claim's boundary
# (compiler/concurrency.jo).
dw_transfer_row = (decl: int, row: int) -> bool:
    parts = dw_dir_parts(row)
    tag = parts.0
    if tag == 0: return false
    name = dewy_syntax[tag].text
    if name != "send" and name != "sync" and name != "unsafe": return false
    on = dw_dir_boolean(name, parts.1) == 1
    bit = 0
    if name == "unsafe":
        if on: bit = TRANSFER_UNSAFE
    else if name == "send":
        bit = TRANSFER_SEND_OFF
        if on: bit = TRANSFER_SEND_CLAIM
    else:
        bit = TRANSFER_SYNC_OFF
        if on: bit = TRANSFER_SYNC_CLAIM
    transfer_tags[decl] = (transfer_tags.get(decl) ?? 0) | bit
    if bit == TRANSFER_SEND_CLAIM or bit == TRANSFER_SYNC_CLAIM: transfer_claim_pos[decl] = dewy_syntax[tag].pos
    true

ownership_tag = (row: int) -> int:
    n = dw_unwrap(row)
    if dewy_syntax[n].kind != .metatag: return 0
    name = dewy_syntax[n].text
    if name == "__drop__": return 1
    if name == "__copy__": return 2
    if name == "__move__": return 3
    0

# Facts qualify a result arm; they do not change its runtime representation.
dw_result_type = (owner: int, id0: int) -> int:
    id = dw_unwrap(id0)
    literal = dw_literal_type(id)
    if literal != 0: return literal
    if dw_op(id) == .pipe:
        n = mk(.tunion, dewy_syntax[id].pos)
        set_list(n, [dw_result_type(owner, dw_child(id, 1)), dw_result_type(owner, dw_child(id, 2))])
        return n
    if dw_op(id) == .amp:
        facts = dw_unwrap(dw_child(id, 2))
        if dewy_syntax[facts].kind == .block and dewy_syntax[facts].text == "<>:":
            base = dw_unwrap(dw_child(id, 1))
            member = dw_result_type(owner, base)
            predicate = 0
            loop entry in dw_children(facts):
                term = dw_ref_predicate(entry)
                if predicate == 0: predicate = term
                else:
                    both = mk(.and_, nodes[term].pos)
                    nodes[both].a = i32(predicate); nodes[both].b = i32(term)
                    predicate = both
            if predicate == 0: fatal(dewy_syntax[facts].pos, "result facts require a proposition")
            tag = 0
            if dewy_syntax[base].kind == .boolean: tag = if dewy_syntax[base].text == "true": 2 else: 1
            clauses = result_syntax.get(owner) ?? []
            clauses.push(ResultClause(member, predicate, tag))
            result_syntax[owner] = clauses
            result_active = true
            refine_active = true
            return member
    if dewy_syntax[id].kind == .boolean:
        result_boolean_masks[owner] = (result_boolean_masks.get(owner) ?? 0) | (if dewy_syntax[id].text == "true": 2 else: 1)
        result_active = true
        refine_active = true
        n = mk(.tname, dewy_syntax[id].pos)
        nodes[n].name = i32(intern("bool"))
        return n
    dw_type(id)

# Spawned bindings are resolved at the joining brace. Their task storage stays
# hidden, and ordinary bindings become visible in the enclosing statement scope.
dw_task_groups: str[]
dw_spawn = (id: int) -> int:
    pos = dewy_syntax[id].pos
    group = dw_child(id, 0)
    g = 0
    if group != 0: g = dw_expr(group)
    else:
        if dw_task_groups.len() == 0: fatal(pos, "spawn needs an enclosing concurrent group, or an explicit spawn(group)")
        g = bc_ident(dw_task_groups[dw_task_groups.len() - 1], pos)
    value = dw_expr(dw_child(id, 1))
    body = bc_block([bc_stmt(value, pos)], pos)
    fn_ = mk(.lambda, pos)
    add_flag(fn_, NF_LANG_BODY)
    nodes[fn_].b = i32(body)
    call = bc_call("__task_spawn", [g, fn_], pos)
    nodes[call].aux2 = 17
    call

dw_concurrent = (id: int, transparent: bool) -> int:
    pos = dewy_syntax[id].pos
    group = dw_child(id, 0)
    name = if group == 0: "$group{id}" else: dw_name(group)
    previous = "$context{id}"
    outcome = "$joined{id}"
    dw_task_groups.push(name)
    body = dw_block(dw_child(id, 1))
    dw_task_groups.pop()
    statements = [bc_let(name, bc_call("__task_new_group", [], pos), pos), bc_let(previous, bc_call("__task_enter", [bc_ident(name, pos)], pos), pos)]
    cleanup = mk(.defer_, pos)
    nodes[cleanup].a = i32(bc_stmt(bc_call("__task_cleanup", [bc_ident(name, pos), bc_ident(previous, pos)], pos), pos))
    statements.push(cleanup)
    results: int[]
    loop statement in kids(body):
        if nodes[statement].kind == .vardecl and nodes[int(nodes[statement].b)].kind == .call and nodes[int(nodes[statement].b)].aux2 == 17:
            original = name_of(int(nodes[statement].name))
            token = "$task{statement}"
            nodes[statement].name = i32(intern(token))
            results.push(bc_let(original, bc_call("__task_result", [bc_ident(token, nodes[statement].pos)], nodes[statement].pos), nodes[statement].pos))
        statements.push(statement)
    statements.push(bc_let(outcome, bc_call("__task_join", [bc_ident(name, pos)], pos), pos))
    statements.push(bc_stmt(bc_call("__task_restore", [bc_ident(previous, pos)], pos), pos))
    loop result in results: statements.push(result)
    if not transparent: statements.push(bc_stmt(bc_ident(outcome, pos), pos))
    block = bc_block(statements, pos)
    if transparent: nodes[block].aux = 5
    block

# the element alias of a loop over a soa array (see soa_loop)
soa_alias = (s: int):
    tmpl = clone(int(nodes[s].b))
    check_expr(int(nodes[s].b), 0)
    v = last_checked
    l = new_local(int(nodes[s].name), ntype(v), nodes[s].pos)
    soa_aliases += 1
    f = LF_ALIAS | LF_SOAELEM
    if has_flag(s, NF_MUT): f |= LF_SOAMUT
    locals[l].flags = i32(f)
    locals[l].alias = i32(v)
    locals[l].soa = i32(tmpl)
    nodes[s].kind = .block
    nodes[s].nlist = 0
# p.x for a soa element alias p: ps.x[i]
soa_alias_field = (n: int, l: int) -> int:
    t = int(locals[l].soa)
    f = mk(.field, nodes[n].pos)
    nodes[f].a = i32(clone(int(nodes[t].a)))
    nodes[f].name = nodes[n].name
    ix = mk(.index, nodes[n].pos)
    nodes[ix].a = i32(f)
    nodes[ix].b = i32(clone(int(nodes[t].b)))
    if int(locals[l].flags) & LF_SOAMUT == 0:
        add_flag(ix, NF_RDONLY)
        nodes[ix].name = locals[l].name
    ix
loop_copy_write = (l: int, pos: int, kept: bool, by_place: bool):
    fl = int(locals[l].flags)
    keep = kept
    place = by_place
    if loop_copy_writes.has(l):
        keep = keep or loop_copy_writes[l].kept
        place = place or loop_copy_writes[l].by_place
    if fl & LF_READ != 0 and loop_serials.len() > int(locals[l].dloops): keep = true
    loop_copy_writes[l] = LoopCopyWrite(pos, keep, place)
    locals[l].flags = i32((fl | LF_DECL | LF_ASSIGNED) & ~(LF_BYREF | LF_VALUEITER | LF_READ))
    # (the copy holds what `let y = x` would: an element's refinement does not bind it)
    if tkind(int(locals[l].type)) == .refined and not loop_copy_refined.has(l):
        loop_copy_refined[l] = int(locals[l].type)
        locals[l].type = i32(representation_type(int(locals[l].type)))
# What a dead write's warning says to do instead.
loop_copy_hint = (l: int, s: int) -> str:
    nm = name_of(int(locals[l].name))
    if map_loop_values.has(l): return "change the entry through its key, as `loop key in m.keys() \{ m[key]... }`"
    src = route_text(int(nodes[s].a))
    if len(src) == 0: src = "items"
    "write `loop @{nm} in {src}` to change the element itself"
# (a use of l in n other than as the object of a statement's call with no result, as
# `xs.push(1)`, whose change to the copy nothing can see; O(n), for binders written by place)
loop_copy_use = (n: int, l: int) -> bool:
    if n == 0: return false
    k = nodes[n].kind
    if k == .ident: return nodes[n].aux == i32(int(SK.local)) and int(nodes[n].sym) == l
    if k == .lambda: return true
    if k == .exprstmt:
        c = int(nodes[n].a)
        if (nodes[c].kind == .call or nodes[c].kind == .intrinsic) and nkids(c) > 0 and tkind(ntype(c)) == .void_:
            first = kid(c, 0)
            # (by place: an `@` parameter's argument, or a built-in array method's object)
            place = nodes[first].kind == .addr
            if nodes[c].kind == .intrinsic:
                loop it in intrinsics:
                    if int(it.id) == int(nodes[c].aux) and it.arr: place = true
            else if nodes[c].aux == 0 and nodes[c].sym > 0:
                called = int(fns[int(nodes[c].sym)].decl)
                if called != 0 and nkids(called) > 0 and has_flag(kid(called, 0), NF_MUT): place = true
            loop nodes[first].kind == .addr: first = int(nodes[first].a)
            if place and nodes[first].kind == .ident and int(nodes[first].sym) == l:
                loop i in [1..nkids(c)):
                    if loop_copy_use(kid(c, i), l): return true
                return false
    mask = isolation_children(k)
    if mask < 0: return true
    if mask & 1 != 0 and loop_copy_use(int(nodes[n].a), l): return true
    if mask & 2 != 0 and loop_copy_use(int(nodes[n].b), l): return true
    if mask & 4 != 0 and loop_copy_use(int(nodes[n].c), l): return true
    if mask & 16 != 0:
        loop c2 in kids(n):
            if loop_copy_use(c2, l): return true
    false
for_copied_binder = (s: int, l0: int) -> int:
    if l0 <= 0: return l0
    if not loop_copy_writes.has(l0): return l0
    write = loop_copy_writes[l0]
    fl = int(locals[l0].flags)
    pos = locals[l0].pos
    dead = if write.by_place: fl & (LF_CAPTURED | LF_SHARED) == 0 and not loop_copy_use(int(nodes[s].b), l0) else: fl & (LF_READ | LF_CAPTURED | LF_ADDR | LF_SHARED) == 0
    if not write.kept and dead and not pos_in_lib(pos) and not starts_with(name_of(int(locals[l0].name)), "_"):
        warn(write.pos, "'{name_of(int(locals[l0].name))}' is changed here but never read afterwards: it holds a copy of the element, so what it was copied from stays as it was; {loop_copy_hint(l0, s)}")
    locals[l0].flags = i32(fl | LF_READ)
    element = new_local(0, loop_copy_refined.get(l0) ?? int(locals[l0].type), pos)
    locals[element].flags = i32(LF_BYREF | LF_READ | (if map_loop_values.has(l0): 0 else: LF_VALUEITER))
    if map_loop_values.has(l0): map_loop_values[element] = true
    d = mk(.vardecl, pos)
    nodes[d].name = locals[l0].name
    nodes[d].b = i32(mk_ident_local(element, pos))
    nodes[d].sym = i32(l0)
    add_flag(d, NF_CHECKED)
    body = int(nodes[s].b)
    set_list(body, [d] + kids(body))
    element
# `loop item in @place` (dw_live_loop): an iterator steps in place
# (dewy_iterator_loop); an array is iterated live, a position counter checked
# against its current length each time and the element read at the body's start,
# so pushes and edits made by the body are seen (worklists).
check_live_loop = (s: int):
    it = int(nodes[s].a)
    pos = nodes[s].pos
    # (unchecked copies of the place, for the loop's own reads)
    length_place = clone(it)
    element_place = clone(it)
    t = prune(check_expr(it, 0))
    if dewy_iterator_type(t):
        dewy_iterator_loop(s, length_place)
        return
    if types[t].kind != .array: fatal(nodes[it].pos, "`loop item in @items` iterates a growable array or a bound iterator live, not {dt(t)}; iterate its value with `loop item in items`")
    binder = kid(s, 0)
    counter = "$dewy_live_{nodes.len()}"
    range = mk(.range, pos)
    nodes[range].a = i32(bc_int(0, pos))
    add_flag(range, NF_INCLUSIVE)
    first = mk(.lhead, pos)
    nodes[first].op = 1
    set_list(first, [bc_ident(counter, pos)])
    nodes[first].a = i32(range)
    second = mk(.lhead, pos)
    nodes[second].op = 4
    nodes[second].a = i32(bc_bin(.lt, bc_ident(counter, pos), bc_call("__dewy_live_length", [length_place], pos), pos))
    both = mk(.lhead, pos)
    nodes[both].op = 2
    nodes[both].a = i32(first)
    nodes[both].b = i32(second)
    element = mk(.index, pos)
    nodes[element].a = i32(element_place)
    nodes[element].b = i32(bc_ident(counter, pos))
    decl = mk(.vardecl, nodes[binder].pos)
    nodes[decl].name = nodes[binder].name
    nodes[decl].b = i32(element)
    lx = mk(.loopx, pos)
    nodes[lx].sval = nodes[s].sval
    nodes[lx].a = i32(both)
    nodes[lx].b = i32(lx_block([decl] + kids(int(nodes[s].b)), pos))
    nodes[s] = nodes[desugar_loopx(lx)]
    check_stmt(s)

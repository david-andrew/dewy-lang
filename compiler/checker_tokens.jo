# Frozen shared layouts; keep field order, defaults and enum ordinals.
enum Tok:
    eof, newline, indent, dedent, ident, int_lit, float_lit, str_lit,
    kw_struct, kw_enum, kw_if, kw_else, kw_in, kw_break, kw_continue,
    kw_return, kw_match, kw_import, kw_as, kw_const, kw_true, kw_false, kw_none, kw_null,
    kw_and, kw_or, kw_not, kw_mut, kw_when, kw_defer, kw_extern, kw_test, kw_build, kw_use, kw_pass,
    lparen, rparen, lbrack, rbrack, lbrace, rbrace,
    comma, colon, semi, dot, dotdot, arrow,
    assign, pluseq, minuseq, stareq, slasheq, percenteq, ampeq, pipeeq, careteq, shleq, shreq,
    plus, minus, star, slash, percent, amp, pipe, caret, tilde, shl, shr,
    eq, ne, lt, le, gt, ge, question, qq, bang, at, starstar,
    kw_loop, kw_let, kw_xor, kw_is, ellipsis, dotop,
    lazy            # a library function's body, not lexed yet: its text from start, len long (parse.jo)

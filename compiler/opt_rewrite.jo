use 'ir_types.dewy'
use 'opt_workspace.dewy'
use 'opt_cleanup.dewy'

const OW_MIN_INT = -9223372036854775807 - 1

ow_vreg = (ty: int) -> int:
    opt_ir.vtypes.push(i8(ty))
    opt_vtypes = data(opt_ir.vtypes)
    opt_ir.vtypes.len() - 1
ow_vtype = (v: int) -> int:
    t = int(opt_vtypes[v])
    if t == 3: return 0
    t
ow_is_kv = (v: int) -> bool: int(opt_vtypes[v]) == 3
ow_k_vreg = (v: int) -> int:
    slot = (v xor (v >> 8)) & 255
    if opt_kc_epoch[slot] == opt_kc_fn and opt_kc_val[slot] == v: return opt_kc_reg[slot]
    d = opt_ir.vtypes.len()
    opt_ir.vtypes.push(i8(3))
    opt_vtypes = data(opt_ir.vtypes)
    old = opt_ir.kval.len()
    if old <= d:
        need = d + 1
        kp = data(opt_ir.kval)
        if kp == null or (kp - 3)[0] != 1 or (kp - 3)[2] < need:
            opt_ir.kval.reserve(max(need, opt_ir.kval.cap() * 2))
            kp = data(opt_ir.kval)
        if d > old: mem_set((kp + old) as *u8, 0, (d - old) * 8)
        (kp - 3)[1] = need
        kp[d] = v
    else:
        opt_ir.kval[d] = v
    opt_kc_epoch[slot] = opt_kc_fn
    opt_kc_val[slot] = v
    opt_kc_reg[slot] = d
    d
# ABI ordinals: eq..geu are 19..28; load is 59. The exhaustive operand
# differential checks these queries against the independent Jo classifier.
ow_boolean_tag = (tag: int) -> bool: tag >= 19 and tag <= 28
ow_arity = (tag: int, mode: int) -> int:
    if tag == 59 and mode & 128 != 0: return 2
    ((opt_decode[tag] >> 4) & 7) - 1
ow_operands = (ins: *Ins) -> int:
    mode = opt_operands[oc_tag(ins)]
    opt_use_span = -1
    opt_use_values[0] = int(ins.a)
    opt_use_values[1] = int(ins.b)
    opt_use_values[2] = int(ins.c)
    opt_use_count = mode & 7
    if mode & 16 != 0:
        opt_use_span = int(ins.a)
        opt_use_span_count = int(ins.b)
        opt_use_count = int(ins.b)
        if mode & 128 != 0: opt_use_count += 1
    else:
        if mode & 256 != 0 and ins.a < 0: opt_use_count = 0
        if mode & 32 != 0 and int(ins.c) & 128 != 0: opt_use_count += 1
        if mode & 64 != 0:
            opt_use_values[2] = int(ins.dst)
            if mode & 32 == 0: opt_use_count += 1
    if mode & 8 != 0: return int(ins.dst)
    -1
ow_use = (i: int) -> int:
    if opt_use_span >= 0:
        if i < opt_use_span_count: return int(opt_args[opt_use_span + i])
        return opt_use_values[2]
    opt_use_values[i]
ow_word_overflow = (operation: int, x: int, y: int) -> bool:
    if operation == 0:
        r = x + y
        return ((x xor r) & (y xor r)) < 0
    if operation == 1:
        r = x - y
        return ((x xor y) & (x xor r)) < 0
    if operation == 2:
        ax = if x < 0: u64(-(x + 1)) + 1 else: u64(x)
        ay = if y < 0: u64(-(y + 1)) + 1 else: u64(y)
        limit = if (x < 0) != (y < 0): u64(9223372036854775807) + 1 else: u64(9223372036854775807)
        return ay != 0 and ax > limit / ay
    if operation == 3: return y == 0 or (x == -9223372036854775807 - 1 and y == -1)
    if y < 0: return true
    if y >= 64: return x != 0
    ((x << y) >> y) != x


ow_rewrite = (ins: *Ins):
    mask = opt_decode[oc_tag(ins)] >> 8
    if mask & 16 != 0:
        loop k in [int(ins.a)..int(ins.a) + int(ins.b)):
            opt_args[k] = o_regs[int(opt_args[k])].repl
    else: ow_rewrite_fields(ins[0], mask)
    if mask & 4 != 0: ins.c = o_regs[int(ins.c)].repl

ow_rewrite_fields = (ins: mut Ins, mask: int):
    if mask & 1 != 0 or (mask & 32 != 0 and ins.a >= 0): ins.a = o_regs[int(ins.a)].repl
    if mask & 2 != 0 or (mask & 64 != 0 and int(ins.c) & 128 != 0): ins.b = o_regs[int(ins.b)].repl
    if mask & 8 != 0 or (mask & 128 != 0 and int(ins.c) & 128 != 0): ins.dst = o_regs[int(ins.dst)].repl

ow_log2_exact = (x: int) -> int:
    if x <= 0 or x & (x - 1) != 0: return -1
    k = 0
    loop (1 << k) != x: k += 1
    k

ow_shru_val = (a: int, k: int) -> int:
    if k == 0: return a
    (a >> k) & ((1 << (64 - k)) - 1)

ow_ult = (a: int, b: int) -> bool: ((a xor OW_MIN_INT)) < ((b xor OW_MIN_INT))

ow_is_k = (v: int) -> bool: o_regs[v].constant

# fold an integer operation on constants; returns (ok, value)

ow_fold = (op: Op, x: int, y: int) -> (bool, int):
    match op:
        overflow_add: (true, int(ow_word_overflow(0, x, y)))
        overflow_sub: (true, int(ow_word_overflow(1, x, y)))
        overflow_mul: (true, int(ow_word_overflow(2, x, y)))
        add: (true, x + y)
        sub: (true, x - y)
        mul: (true, x * y)
        divs:
            if y == 0 or (x == OW_MIN_INT and y == -1): return (false, 0)
            (true, x / y)
        rems:
            if y == 0 or (x == OW_MIN_INT and y == -1): return (false, 0)
            (true, x % y)
        and_: (true, x & y)
        or_: (true, x | y)
        xor: (true, (x xor y))
        shl: (true, x << (y & 63))
        shrs: (true, x >> (y & 63))
        shru: (true, ow_shru_val(x, y & 63))
        eq: (true, int(x == y))
        ne: (true, int(x != y))
        lts: (true, int(x < y))
        les: (true, int(x <= y))
        gts: (true, int(x > y))
        ges: (true, int(x >= y))
        ltu: (true, int(ow_ult(x, y)))
        leu: (true, int(not ow_ult(y, x)))
        gtu: (true, int(ow_ult(y, x)))
        geu: (true, int(not ow_ult(x, y)))
        _: (false, 0)

ow_fold_un = (op: Op, x: int) -> (bool, int):
    match op:
        neg: (true, -x)
        not_: (true, ~x)
        sext8: (true, (x << 56) >> 56)
        sext16: (true, (x << 48) >> 48)
        sext32: (true, (x << 32) >> 32)
        zext8: (true, x & 255)
        zext16: (true, x & 65535)
        zext32: (true, x & 4294967295)
        _: (false, 0)

# comparison with its operands swapped

ow_mirror = (op: Op) -> Op:
    match op:
        lts: .gts
        les: .ges
        gts: .lts
        ges: .les
        ltu: .gtu
        leu: .geu
        gtu: .ltu
        geu: .leu
        _: op

ow_commutes = (op: Op) -> bool:
    op == .add or op == .mul or op == .and_ or op == .or_ or op == .xor or op == .eq or op == .ne

# Function-local output arena. The cleanup consumer borrows it; published IR
# owns a different array. Every append checks capacity before taking its address.

ow_flow_begin = ():
    if o_flow_storage.len() < opt_ir.code.len(): o_flow_storage.resize(opt_ir.code.len())
    o_flow = data(o_flow_storage)
    if o_flow_open_storage.len() < opt_ir.code.len(): o_flow_open_storage.resize(opt_ir.code.len())
    o_flow_open = data(o_flow_open_storage)
    o_flow_level = -1
    o_flow_at_storage.resize(o_capacity)
    o_flow_at = data(o_flow_at_storage)
    o_flow_count = 0
    o_flow_top = -1
    o_flow_dead = false
    o_flow_depth = 0
    o_dead_first.clear()
    o_dead_limit.clear()

ow_flow_exit = (distance: int):
    level = o_flow_level - distance
    if level < 0: return
    target = int(o_flow_open[level])
    if o_flow[target].kind != .loop: o_flow[target].exit = true

ow_flow_end_dead = ():
    if o_dead_start < o_count:
        o_dead_first.push(o_dead_start)
        o_dead_limit.push(o_count)

# Callers select control operations; data emission never enters this path.

ow_flow_emit = (ins: *Ins):
    if o_count == o_capacity: ow_grow_output()
    control = (opt_decode[oc_tag(ins)] >> 20) & 15
    if o_flow_dead:
        if control >= 2 and control <= 4:
            o_flow_depth += 1
            return
        if control == 5 or control == 6:
            if o_flow_depth > 0:
                if control == 6: o_flow_depth -= 1
                return
            ow_flow_end_dead()
        else: return
    if control >= 2 and control <= 4:
        index = o_flow_count
        o_flow_count += 1
        o_flow[index] = OptFlow(ins.op, o_flow_top, o_count, false, false)
        o_flow_top = index
        o_flow_level += 1
        o_flow_open[o_flow_level] = i32(index)
        o_flow_at[o_count] = i32(index)
    else if control == 5:
        o_flow[o_flow_top].exit = o_flow[o_flow_top].exit or not o_flow_dead
        o_flow[o_flow_top].kind = .else_
        o_flow_dead = false
    else if control == 6:
        o_flow_dead = o_flow_dead and not o_flow[o_flow_top].exit and o_flow[o_flow_top].kind != .if_
        o_flow[o_flow_top].terminated = o_flow_dead
        o_flow_at[o_count] = i32(o_flow_top)
        o_flow_top = o_flow[o_flow_top].parent
        o_flow_level -= 1
        if o_flow_dead: o_dead_start = o_count + 1
    else:
        if control == 7 or control == 8 or control == 9:
            ow_flow_exit(int(ins.imm))
            if control == 9:
                loop k in [0..int(ins.b)):
                    ow_flow_exit(int(opt_args[int(ins.c) + k]))
        if control == 7 or control == 9 or control == 10 or control == 11 or (control == 12 and ins.c == 1):
            o_flow_dead = true
            o_flow_depth = 0
            o_dead_start = o_count + 1

ow_flow_pop = ():
    # Only an empty block/if opener can be removed by the forward writer.
    if o_flow_dead: o_flow_depth -= 1
    else:
        o_flow_top = o_flow[o_flow_top].parent
        o_flow_level -= 1
        o_flow_count -= 1

ow_grow_output = ():
    o_capacity = max(32, o_capacity * 2)
    o_out_storage.resize(o_capacity)
    o_out = data(o_out_storage)
    o_flow_at_storage.resize(o_capacity)
    o_flow_at = data(o_flow_at_storage)

ow_append_plain = (ins: Ins):
    if o_count == o_capacity: ow_grow_output()
    o_out[o_count] = ins
    o_count += 1

ow_append = (ins: Ins):
    if o_count == o_capacity: ow_grow_output()
    o_out[o_count] = ins
    ow_flow_emit(o_out + o_count)
    o_count += 1

o_kcount = 0
ow_kmap_reset = (n: int):
    need = 64
    target = n * 4
    loop need < target: need *= 2
    if o_kepoch.len() < need:
        o_kval.resize(need)
        o_kreg.resize(need)
        o_kepoch.resize(need)
    o_kmask = o_kepoch.len() - 1
    o_kfn += 1
    o_kcount = 0

ow_kmap_get = (v: int) -> int:
    mask = o_kmask
    fn_ = o_kfn
    epochs = data(o_kepoch)
    vals = data(o_kval)
    regs = data(o_kreg)
    i = ((v * (-7046029254386353131)) >> 29) & mask
    loop epochs[i] == fn_:
        if vals[i] == v: return int(regs[i])
        i = (i + 1) & mask
    -1

ow_kmap_put = (v: int, r: int):
    if (o_kcount + 1) * 2 >= o_kepoch.len():
        old_len = o_kepoch.len()
        new_len = old_len * 2
        old_vals = o_kval
        old_regs = o_kreg
        old_ep = o_kepoch
        old_fn = o_kfn
        o_kval = fill(0, new_len)
        o_kreg = fill(i32(0), new_len)
        o_kepoch = fill(0, new_len)
        o_kmask = new_len - 1
        o_kfn = old_fn + 1
        o_kcount = 0
        loop j in [0..old_len):
            if old_ep[j] == old_fn: ow_kmap_put(old_vals[j], int(old_regs[j]))
    mask = o_kmask
    fn_ = o_kfn
    epochs = data(o_kepoch)
    vals = data(o_kval)
    regs = data(o_kreg)
    i = ((v * (-7046029254386353131)) >> 29) & mask
    loop epochs[i] == fn_:
        if vals[i] == v: return
        i = (i + 1) & mask
    epochs[i] = fn_
    vals[i] = v
    regs[i] = i32(r)
    o_kcount += 1

ow_kconst = (v: int) -> int:
    if ow_fits32(v):
        c = ow_kmap_get(v)
        if c >= 0: return c
        k = ow_k_vreg(v)
        ow_resize_one(k)
        o_regs[k].ndef = 1
        o_regs[k].stable = true
        o_regs[k].constant = true
        o_regs[k].cval = v
        ow_kmap_put(v, k)
        return k
    d = ow_vreg(0)
    ow_resize_one(d)
    o_regs[d].ndef = 1
    o_regs[d].stable = true
    o_regs[d].constant = true
    o_regs[d].cval = v
    ow_emit(Ins(.iconst, 0, i32(d), 0, 0, 0, v))
    int(o_regs[d].repl)

ow_resize_one = (d: int):
    if o_reg_count <= d:
        o_reg_storage.resize(d + 1)
        o_regs = data(o_reg_storage)
        o_reg_count = d + 1
        o_fact_scope.resize((d + 1) * 2)
        o_fact_nbr.resize((d + 1) * 2)
    reg = &o_regs[d]
    reg.ndef = 0
    reg.stable = false
    reg.defpos = -1
    reg.first = 2147483647
    reg.nuse = 0
    reg.constant = false
    reg.repl = i32(d)
    reg.ver = 0
    reg.dop = -1

# (results may be replaced by an existing equal value)

ow_bin = (op: Op, d: int, a: int, b: int) -> int:
    ow_emit(Ins(op, 0, i32(d), i32(a), i32(b), 0, 0))
    int(o_regs[d].repl)

ow_tmp = () -> int:
    d = ow_vreg(0)
    ow_resize_one(d)
    o_regs[d].ndef = 1
    o_regs[d].stable = true
    d

# can uses of d be replaced by s? both must be single-definition values defined before use

ow_can_alias = (d: int, s: int) -> bool:
    if o_regs[d].ndef != 1: return false
    if o_regs[d].first < o_regs[d].defpos: return false
    if o_regs[s].ndef != 1: return ow_vtype(d) == ow_vtype(s) and ow_holds(d, s)
    if s >= opt_ir.nparams and o_regs[s].first < o_regs[s].defpos: return false
    ow_vtype(d) == ow_vtype(s)

# d = s (s defined more than once, like a loop counter): may d's uses read s instead? Yes if s
# is not redefined from there to d's last use, and the copy dominates the uses (the construct
# open at the copy stays open: no path reaches a use around it, as through a loop's back edge).
# A use in a loop entered after the copy sees s again on the next iteration: s must not change
# anywhere in that loop either.

ow_holds = (d: int, s: int) -> bool:
    q = int(o_regs[d].defpos)
    e = int(o_lastuse[d])
    if q < 0 or e < q: return false
    dq = o_depth[q]
    # (constructs opened after the copy, and how deep the outermost loop among them is)
    open: Op[]
    loop_at = -1        # open.len() when the outermost such loop that is open at the last use opened
    p = q + 1
    loop p <= e or (loop_at >= 0 and open.len() > loop_at):
        if p >= opt_ir.code.len() or p - q > 4000: return false
        ins = opt_input + p
        op = ins.op
        if o_depth[p] < dq: return false
        if op == .else_ and o_depth[p] == dq: return false
        if opt_decode[oc_tag(ins)] & 1 != 0 and int(ins.dst) == s: return false
        if op == .zeroslots:
            loop k in [0..int(ins.b)):
                item = int(opt_args[int(ins.a) + k])
                if item & 1 == 1 and item >> 1 == s: return false
        if op == .block or op == .if_ or op == .loop: open.push(op)
        else if op == .end and open.len() > 0: open.pop()
        if p == e:
            loop j in [0..open.len()):
                if open[j] == .loop:
                    loop_at = j
                    break
        p += 1
    true

# ---------------- common subexpressions ----------------
# A hash table of available values keyed by (op, type, operands, immediate). Entries belong to
# their control construct. An unconditional block can export its prefix before
# the first branch; conditional arms and loops never export. Loads also die when
# memory may have changed (any store or call bumps the memory generation).
# Keep one probed entry together instead of visiting ten separate arrays.
# The key and validity metadata occupy 64 bytes; their meaning is unchanged.

o_loop_depth = 0
ow_ht_setup = (n: int):
    size = 64
    loop size < n * 4: size *= 2
    if ht_storage.len() < size: ht_storage.resize(size)
    ht_entries = data(ht_storage)
    ht_mask = size - 1
    o_epoch += 1
    o_gen = 0
    o_genf = 1 << 40
    o_genh = 2 << 40
    o_scope_storage.clear()
    o_scopes.clear()
    ow_scope_open()

ow_scope_open = (export_prefix: bool = false):
    if not o_cse: return
    parent = -1
    if o_scopes.len() > 0: parent = o_scopes[o_scopes.len() - 1]
    o_scope_storage.push(OptScope(o_nbr, i32(parent), true, export_prefix))
    o_scope_info = data(o_scope_storage)
    o_scopes.push(o_scope_storage.len() - 1)

ow_scope_close = ():
    if not o_cse: return
    o_scope_info[o_scopes.pop()].open = false

ow_ht_slot = (k1: int, k2: int, k3: int) -> int:
    h = (k1 * -7046029254386353131) xor (k2 * -4417276706812531889) xor (k3 * 1609587929392839161)
    i = (h >> 29) & ht_mask
    loop ht_entries[i].epoch == o_epoch:
        if ht_entries[i].key1 == k1 and ht_entries[i].key2 == k2 and ht_entries[i].key3 == k3: return i
        i = (i + 1) & ht_mask
    i

ow_ht_available = (i: int, gen: int, va: int, vb: int) -> int:
    entry = &ht_entries[i]
    if entry.epoch != o_epoch: return -1
    scope = int(entry.scope)
    loop not o_scope_info[scope].open:
        # Every exit from this block passes its straight-line prefix. After
        # any earlier branch the value might have been skipped, so discard it.
        if not o_scope_info[scope].export_prefix or entry.branches != o_scope_info[scope].branches: return -1
        scope = int(o_scope_info[scope].parent)
        if scope < 0: return -1
    if gen >= 0 and entry.generation != gen: return -1
    if int(entry.version_a) != va or int(entry.version_b) != vb: return -1
    int(entry.value)

ow_mem_gen = (mode: int) -> int:
    if opt_ir.raw_mem: return o_gen
    if mode & 64 != 0: return o_genh
    if mode & 32 != 0: return o_genf
    o_gen

ow_kill_mem = (mode: int):
    if opt_ir.raw_mem: ow_kill_all()
    else if mode & 64 != 0: o_genh += 1
    else if mode & 32 != 0: o_genf += 1
    else: o_gen += 1

ow_kill_all = ():
    o_gen += 1
    o_genf += 1
    o_genh += 1

ow_ht_put_gen = (k1: int, k2: int, k3: int, v: int, gen: int, va: int, vb: int):
    ow_ht_insert(ow_ht_slot(k1, k2, k3), k1, k2, k3, v, gen, va, vb)

ow_load_key1 = (ty: int, mode: int, addr: int) -> int: 59 | (ty << 8) | ((mode & 4095) << 12) | (addr << 24)

ow_ht_insert = (i: int, k1: int, k2: int, k3: int, v: int, gen: int, va: int, vb: int):
    # The probe returns an index masked to the current table capacity.
    scope = i32(o_scopes[o_scopes.len() - 1])
    ht_entries[i] = AvailableValue(k1, k2, k3, i32(v), scope, o_nbr, gen, o_epoch, i32(va), i32(vb))


# a value that is defined once and never read before its definition

ow_stable = (v: int) -> bool: o_regs[v].stable

# Available expressions have at most two register operands, always a then b.
# Read their versions directly instead of filling the general operand buffer
# for every expression. -1 means the instruction is not an available value.

ow_push = (ins: *Ins):
    d = ow_operands(ins)
    if d >= 0: o_regs[d].ver += 1
    loop k in [0..opt_use_count): o_regs[ow_use(k)].nuse += 1
    control = (opt_decode[oc_tag(ins)] >> 20) & 15
    if control >= 2 and control <= 11 or (control == 12 and ins.c == 1): ow_flow_emit(ins)
    ow_append_plain(ins[0])

# drop the last output instruction (an empty construct's opening)

ow_pop = ():
    ow_flow_pop()
    o_count -= 1
    ins = o_out[o_count]
    if ins.op == .if_: o_regs[int(ins.a)].nuse -= 1

ow_join_kill = (head0: int):
    head = head0
    loop head >= 0:
        o_regs[o_join_regs[head]].ver += 1
        head = o_join_next[head]

ow_branch_copy = () -> int:
    n = o_count
    if n < 3 or o_out[n - 2].op != .mov: return -1
    d = int(o_out[n - 2].dst)
    if d < 0 or o_regs[d].ndef <= 1 or o_regs[d].repl != i32(d): return -1
    i = n - 3
    floor = max(0, n - 19)
    loop i >= floor:
        ins = o_out + i
        op = ins.op
        if op == .brif:
            if ins.imm == 0: return d
            return -1
        if op == .block or op == .loop or op == .if_ or op == .else_ or op == .end or op == .br or op == .brtable or op == .ret or op == .trap or op == .zeroslots: return -1
        if opt_decode[oc_tag(ins)] & 1 != 0 and ins.dst == i32(d): return -1
        i -= 1
    -1

# v was computed by `op` from operands that still hold the same values here

ow_def_is = (v: int, op: int) -> bool:
    reg = &o_regs[v]
    if not reg.stable or reg.dop != i32(op): return false
    o_regs[int(reg.da)].ver == reg.dva and o_regs[int(reg.db)].ver == reg.dvb

# Bounded expression queries use CSE's operand-version checks, so a changed
# loop variable cannot lend an old range or rotate identity to its new value.

ow_dop_width_mask = (dop: int, mode: int, has_k: bool, k: int) -> int:
    if dop == 50: return 62
    if dop == 51: return 52
    if dop == 52: return 32
    if dop == 47: return 7
    if dop == 48: return 6
    if dop == 49: return 4
    if dop == 59:
        sz = mode & 15
        sg = (mode & 16) != 0
        if sz == 1: return if sg: 7 else: 62
        if sz == 2: return if sg: 6 else: 52
        if sz == 4: return if sg: 4 else: 32
        return 0
    if not has_k: return 0
    if dop == 11:
        if k >= 0:
            if k <= 127: return 63
            if k <= 255: return 62
            if k <= 32767: return 54
            if k <= 65535: return 52
            if k <= 2147483647: return 36
            if k <= 4294967295: return 32
        return 0
    if dop == 16:
        if k >= 32 and k < 64:
            if k >= 57: return 63
            if k >= 56: return 62
            if k >= 49: return 54
            if k >= 48: return 52
            if k >= 33: return 36
            return 32
        return 0
    if dop == 15:
        if k >= 32 and k < 64:
            if k >= 56: return 7
            if k >= 48: return 6
            return 4
        return 0
    0

ow_width_mask = (v: int) -> int:
    if not ow_stable(v): return 0
    dop = int(o_regs[v].dop)
    if dop == 95 or dop == 103 or ow_boolean_tag(dop): return 63
    if dop == 102: return 32
    mode = 0
    if dop == 59:
        dp = int(o_regs[v].defpos)
        if dp >= 0 and dp < opt_input_count and opt_input[dp].op == .load and int(opt_input[dp].dst) == v:
            mode = int(opt_input[dp].c)
    has_k = (dop == 11 or dop == 15 or dop == 16) and ow_def_is(v, dop) and ow_is_k(int(o_regs[v].db))
    k = if has_k: o_regs[int(o_regs[v].db)].cval else: 0
    ow_dop_width_mask(dop, mode, has_k, k)

ow_ext_bit = (op: Op) -> int:
    match op:
        sext8: 1
        sext16: 2
        sext32: 4
        zext8: 8
        zext16: 16
        zext32: 32
        _: 0

ow_unsigned32 = (v: int, depth: int = 0) -> bool:
    if ow_is_k(v): return o_regs[v].cval >= 0 and o_regs[v].cval <= 4294967295
    if ow_def_is(v, 52) or ow_def_is(v, 51) or ow_def_is(v, 50) or ow_def_is(v, 102): return true
    if (ow_width_mask(v) & 32) != 0: return true
    if depth >= 4: return false
    if ow_def_is(v, 11): return ow_unsigned32(int(o_regs[v].da), depth + 1) or ow_unsigned32(int(o_regs[v].db), depth + 1)
    if ow_def_is(v, 12) or ow_def_is(v, 13): return ow_unsigned32(int(o_regs[v].da), depth + 1) and ow_unsigned32(int(o_regs[v].db), depth + 1)
    if ow_def_is(v, 16): return ow_unsigned32(int(o_regs[v].da), depth + 1)
    false

ow_unwrap32 = (v: int) -> int: if ow_def_is(v, 52): int(o_regs[v].da) else: v

# A four-edge query only at shift/count consumers. CSE versions invalidate
# stale operands; no function scan or new analysis state is needed.

ow_small_count = (v: int, depth: int = 0) -> int:
    if ow_is_k(v): return if o_regs[v].cval >= 0 and o_regs[v].cval <= 64: o_regs[v].cval else: -1
    if depth >= 4: return -1
    if ow_def_is(v, 11):
        a = ow_small_count(int(o_regs[v].da), depth + 1)
        b = ow_small_count(int(o_regs[v].db), depth + 1)
        if a >= 0 and b >= 0: return min(a, b)
        return max(a, b)
    if ow_def_is(v, 5) and ow_is_k(int(o_regs[v].da)):
        a = o_regs[int(o_regs[v].da)].cval
        b = ow_small_count(int(o_regs[v].db), depth + 1)
        if a >= 0 and a <= 64 and b >= 0 and b <= a: return a
    -1

ow_rotate32 = (ins: *Ins) -> bool:
    if not opt_rotate32_ok: return false
    value = int(ins.a)
    if ins.op == .zext32 and ow_def_is(value, 12) or ins.op == .or_ and ow_unsigned32(int(ins.a)) and ow_unsigned32(int(ins.b)):
        left = ow_unwrap32(if ins.op == .or_: int(ins.a) else: int(o_regs[value].da))
        right = ow_unwrap32(if ins.op == .or_: int(ins.b) else: int(o_regs[value].db))
        if ow_def_is(left, 16):
            saved = left; left = right; right = saved
        if ow_def_is(left, 14) and ow_def_is(right, 16):
            lc = int(o_regs[left].db); rc = int(o_regs[right].db)
            x = int(o_regs[right].da)
            complementary = ow_is_k(lc) and ow_is_k(rc) and o_regs[lc].cval >= 0 and o_regs[lc].cval <= 32 and o_regs[lc].cval + o_regs[rc].cval == 32
            if ow_def_is(rc, 5) and ow_is_k(int(o_regs[rc].da)) and o_regs[int(o_regs[rc].da)].cval == 32 and o_regs[rc].db == i32(lc):
                limit = ow_small_count(lc)
                complementary = limit >= 0 and limit <= 32
            if ow_def_is(lc, 5) and ow_is_k(int(o_regs[lc].da)) and o_regs[int(o_regs[lc].da)].cval == 32 and o_regs[lc].db == i32(rc):
                limit = ow_small_count(rc)
                complementary = limit >= 0 and limit <= 32
            if complementary and ow_unwrap32(int(o_regs[left].da)) == ow_unwrap32(x) and ow_unsigned32(x):
                ins[0] = Ins(.rot32, 0, ins.dst, i32(ow_unwrap32(x)), i32(lc), 0, 0)
                return true
    if ins.op != .zext32: return false
    # Duplication into both halves followed by a shift is the same rotation.
    if ow_def_is(value, 16) and ow_is_k(int(o_regs[value].db)):
        count = o_regs[int(o_regs[value].db)].cval
        dup = int(o_regs[value].da)
        if count <= 0 or count >= 32 or not ow_def_is(dup, 12): return false
        x = int(o_regs[dup].da); shifted = int(o_regs[dup].db)
        if ow_def_is(x, 14):
            saved = x; x = shifted; shifted = saved
        if ow_def_is(shifted, 14) and ow_unwrap32(int(o_regs[shifted].da)) == ow_unwrap32(x) and ow_is_k(int(o_regs[shifted].db)) and o_regs[int(o_regs[shifted].db)].cval == 32 and ow_unsigned32(x):
            rotation = ow_kconst(32 - count)
            ins[0] = Ins(.rot32, 0, ins.dst, i32(ow_unwrap32(x)), i32(rotation), 0, 0)
            return true
    false

ow_fits32 = (v: int) -> bool: v >= -2147483648 and v <= 2147483647

ow_emit = (ins0: Ins):
    opt_working[1] = ins0
    ow_transfer(opt_working + 1, false)

# Only single-definition values have facts. Direct indexing avoids hashing the
# same condition at every branch; both truth values keep their own scope, just
# as separate available-expression keys did.

ow_fact_known = (c: int, truth: int) -> bool:
    if not o_cse or not ow_stable(c) or o_regs[c].fact_epoch != o_epoch: return false
    index = c * 2 + truth
    scope = int(o_fact_scope[index])
    if scope < 0: return false
    loop not o_scope_info[scope].open:
        if not o_scope_info[scope].export_prefix or o_fact_nbr[index] != o_scope_info[scope].branches: return false
        scope = int(o_scope_info[scope].parent)
        if scope < 0: return false
    true

ow_add_fact = (c: int, truth: int):
    if not o_cse or not ow_stable(c): return
    if o_regs[c].fact_epoch != o_epoch:
        o_fact_scope[c * 2] = -1
        o_fact_scope[c * 2 + 1] = -1
        o_regs[c].fact_epoch = o_epoch
    index = c * 2 + truth
    o_fact_scope[index] = i32(o_scopes[o_scopes.len() - 1])
    o_fact_nbr[index] = o_nbr

ow_fact_false = (c: int) -> bool: ow_fact_known(c, 0)

ow_add_fact_false = (c: int): ow_add_fact(c, 0)

ow_fact_true = (c: int) -> bool: ow_fact_known(c, 1)

ow_add_fact_true = (c: int): ow_add_fact(c, 1)

# (opt_rewrite.dewy explains these two)
o_nonnegative_remainder = -1
ow_nonnegative_in = (base: *Ins, n: int, v0: int) -> bool:
    if ow_is_k(v0): return o_regs[v0].cval >= 0
    v = v0
    j = n - 1
    limit = if n > 64: n - 64 else: 0
    depth = 0
    loop j >= limit:
        ins = base + j
        op = ins.op
        if op == .loop or op == .zeroslots: return false
        if op == .end: depth += 1
        else if op == .block or op == .if_:
            if depth > 0: depth -= 1
        else if op == .else_:
            if depth == 0: return false
        else if opt_decode[oc_tag(ins)] & 1 != 0 and int(ins.dst) == v:
            if depth > 0: return false
            if op == .mov:
                v = int(ins.a)
                if ow_is_k(v): return o_regs[v].cval >= 0
            else if op == .iconst: return ins.imm >= 0
            else if op == .zext8 or op == .zext16 or op == .zext32: return true
            else if op == .and_:
                return (ow_is_k(int(ins.b)) and o_regs[int(ins.b)].cval >= 0) or (ow_is_k(int(ins.a)) and o_regs[int(ins.a)].cval >= 0)
            else if op == .shrs:
                v = int(ins.a)
                if ow_is_k(v): return o_regs[v].cval >= 0
            else if op == .shru:
                if ow_is_k(int(ins.b)) and (o_regs[int(ins.b)].cval & 63) > 0: return true
                v = int(ins.a)
                if ow_is_k(v): return o_regs[v].cval >= 0
            else if op == .remu: return ow_is_k(int(ins.b)) and o_regs[int(ins.b)].cval > 0
            else: return false
        j -= 1
    false
ow_nonnegative = (v0: int) -> bool: ow_nonnegative_in(o_out, o_count, v0)

# simplify one instruction, appending the result to o_out
# One opcode-directed forward transfer. Only scalar arithmetic enters folding;
# memory/call/vector/control operations go directly from rewriting to CSE/emission.
# Replacement operations are revisited locally, never by a whole-function sweep.
# The walk is O(input operations + emitted strength-reduction operations), apart
# from the separately bounded copy-lifetime queries and CSE hash probes.

ow_transfer = (ins: *Ins, simplify: bool):
    loop simplify:
        op = ins.op
        kind = (opt_decode[oc_tag(ins)] >> 16) & 15
        if kind == 0 or kind == 7:
            ow_rewrite(ins)
            if kind == 0: break
        else if kind != 1:
            ins.a = o_regs[int(ins.a)].repl
            if kind >= 4: ins.b = o_regs[int(ins.b)].repl
            if kind == 6: ins.c = o_regs[int(ins.c)].repl
        # Inlining and store forwarding can expose the address behind a closure
        # invocation. A stable function address uses the ordinary direct-call ABI.
        if kind == 7:
            fp = int(ins.c)
            at = int(o_regs[fp].defpos)
            if ow_stable(fp) and at >= 0 and opt_input[at].op == .faddr:
                ins.op = .call
                ins.imm = opt_input[at].imm
                ins.c = 0
                op = .call
            break
        d = int(ins.dst)
        a = int(ins.a)
        bb = int(ins.b)
        if kind == 5:
            if op == .checked_sub and ow_is_k(a) and o_regs[a].cval >= 0 and o_regs[a].cval <= 64:
                limit = ow_small_count(bb)
                if limit >= 0 and limit <= o_regs[a].cval:
                    ins[0] = Ins(.sub, 0, i32(d), i32(a), i32(bb), 0, 0)
                    continue
            raw = if op == .checked_add: Op.add else if op == .checked_sub: Op.sub else: Op.mul
            if ow_is_k(a) and ow_is_k(bb):
                operation = if op == .checked_add: 0 else if op == .checked_sub: 1 else: 2
                overflow = false
                if int(ins.c) & 1 != 0:
                    av = u64(o_regs[a].cval); bv = u64(o_regs[bb].cval)
                    overflow = if operation == 0: av + bv < av else if operation == 1: av < bv else: bv != 0 and av > u64(18446744073709551615) / bv
                else: overflow = ow_word_overflow(operation, o_regs[a].cval, o_regs[bb].cval)
                if int(ins.c) & 32 != 0:
                    folded, value = ow_fold(raw, o_regs[a].cval, o_regs[bb].cval)
                    overflow = overflow or (if int(ins.c) & 1 != 0: value < 0 or value > 4294967295 else: value < -2147483648 or value > 2147483647)
                if overflow:
                    # A reachable store still fails at runtime under the default
                    # policy, even when inlining exposes constant operands.
                    break
                ok, value = ow_fold(raw, o_regs[a].cval, o_regs[bb].cval)
                ins[0] = Ins(.iconst, 0, i32(d), 0, 0, 0, value)
                continue
            if ow_is_k(bb) and ((raw != .mul and o_regs[bb].cval == 0) or (raw == .mul and (o_regs[bb].cval == 0 or o_regs[bb].cval == 1))):
                ins.op = raw
                continue
            break
        if kind == 1:
            if ow_stable(d):
                o_regs[d].constant = true
                o_regs[d].cval = ins.imm
            break
        if kind == 2:
            if ow_can_alias(d, a):
                o_regs[d].repl = i32(a)
                if o_regs[a].constant:
                    o_regs[d].constant = true
                    o_regs[d].cval = o_regs[a].cval
                return
            if ow_is_k(a) and ow_vtype(d) == 0:
                ins[0] = Ins(.iconst, 0, i32(d), 0, 0, 0, o_regs[a].cval)
                break
            break
        if int(ins.ty) != 0 or d < 0:
            break
        # Inlining can make a previously dynamic scalar choice constant. Its
        # inputs were already evaluated, so replacing the selection by a move
        # preserves their effects; ordinary dead-code removal handles pure inputs.
        if kind == 6:
            if bb == int(ins.c) or ow_is_k(a) or ow_fact_true(a) or ow_fact_false(a):
                yes = bb == int(ins.c) or (ow_is_k(a) and o_regs[a].cval != 0) or ow_fact_true(a)
                value = if yes: bb else: int(ins.c)
                ins[0] = Ins(.mov, 0, i32(d), i32(value), 0, 0, 0)
                continue
            break
        if op == .zext32:
            if ow_rotate32(ins): continue
            if ow_unsigned32(a):
                ins[0] = Ins(.mov, 0, i32(d), i32(a), 0, 0, 0)
                continue
        # unary integer ops
        if kind == 3:
            ebit = ow_ext_bit(op)
            if ebit != 0 and (ow_width_mask(a) & ebit) != 0:
                ins[0] = Ins(.mov, 0, i32(d), i32(a), 0, 0, 0)
                continue
            if ow_is_k(a):
                ok, v = ow_fold_un(op, o_regs[a].cval)
                if ok:
                    ins[0] = Ins(.iconst, 0, i32(d), 0, 0, 0, v)
                    continue
            break
        # binary integer ops
        if op == .or_ and ow_rotate32(ins): continue
        if op == .shru and ow_is_k(bb) and o_regs[bb].cval == 6:
            limit = ow_small_count(a)
            if limit >= 0 and limit < 64:
                ins[0] = Ins(.iconst, 0, i32(d), 0, 0, 0, 0)
                continue
        if ow_is_k(a) and ow_is_k(bb):
            ok, v = ow_fold(op, o_regs[a].cval, o_regs[bb].cval)
            if ok:
                ins[0] = Ins(.iconst, 0, i32(d), 0, 0, 0, v)
                continue
        if ow_is_k(a) and not ow_is_k(bb):
            if ow_commutes(op):
                ins.a = i32(bb)
                ins.b = i32(a)
            else if ow_mirror(op) != op:
                ins.op = ow_mirror(op)
                ins.a = i32(bb)
                ins.b = i32(a)
            op = ins.op
            a = int(ins.a)
            bb = int(ins.b)
        if a == bb:
            if op == .eq or op == .les or op == .ges or op == .leu or op == .geu:
                ins[0] = Ins(.iconst, 0, i32(d), 0, 0, 0, 1)
                continue
            if op == .ne or op == .lts or op == .gts or op == .ltu or op == .gtu:
                ins[0] = Ins(.iconst, 0, i32(d), 0, 0, 0, 0)
                continue
        if not ow_is_k(bb):
            break
        k = o_regs[bb].cval
        if op == .lts and k == 0 and a == o_nonnegative_remainder:
            ins[0] = Ins(.iconst, 0, i32(d), 0, 0, 0, 0)
            continue
        if (op == .lts and k == OW_MIN_INT) or (op == .gts and k == 9223372036854775807) or (op == .ltu and k == 0):
            ins[0] = Ins(.iconst, 0, i32(d), 0, 0, 0, 0)
            continue
        if (op == .ges and k == OW_MIN_INT) or (op == .les and k == 9223372036854775807) or (op == .geu and k == 0):
            ins[0] = Ins(.iconst, 0, i32(d), 0, 0, 0, 1)
            continue
        # A nonnegative constant mask bounds its result in [0, mask]. Relational
        # comparisons are monotone on that interval, in both signed and unsigned
        # order. Equal endpoints prove the whole comparison; equality is excluded.
        if op == .lts or op == .les or op == .gts or op == .ges or op == .ltu or op == .leu or op == .gtu or op == .geu:
            if ow_def_is(a, 11) and ow_is_k(int(o_regs[a].db)):
                limit = o_regs[int(o_regs[a].db)].cval
                if limit >= 0:
                    lo = ow_fold(op, 0, k)
                    hi = ow_fold(op, limit, k)
                    if lo.1 == hi.1:
                        ins[0] = Ins(.iconst, 0, i32(d), 0, 0, 0, lo.1)
                        continue
        # identities: result is a
        if (k == 0 and (op == .add or op == .sub or op == .or_ or op == .xor or op == .shl or op == .shrs or op == .shru)) or (k == 1 and (op == .mul or op == .divs or op == .divu)):
            ins[0] = Ins(.mov, 0, i32(d), i32(a), 0, 0, 0)
            continue
        if op == .and_ and k == -1:
            ins[0] = Ins(.mov, 0, i32(d), i32(a), 0, 0, 0)
            continue
        if k == 0 and (op == .mul or op == .and_):
            ins[0] = Ins(.iconst, 0, i32(d), 0, 0, 0, 0)
            continue
        if op == .add and ow_def_is(a, 4) and o_regs[int(o_regs[a].db)].constant:
            ow_bin(.add, d, int(o_regs[a].da), ow_kconst(k + o_regs[int(o_regs[a].db)].cval))
            return
        sh = ow_log2_exact(k)
        if sh > 0:
            if op == .mul:
                ow_bin(.shl, d, a, ow_kconst(sh))
                return
            if op == .divu:
                ow_bin(.shru, d, a, ow_kconst(sh))
                return
            if op == .remu:
                ow_bin(.and_, d, a, ow_kconst(k - 1))
                return
            if op == .divs or op == .rems:
                if ow_nonnegative(a):
                    if op == .divs: ow_bin(.shrs, d, a, ow_kconst(sh))
                    else:
                        ow_bin(.and_, d, a, ow_kconst(k - 1))
                        if ow_stable(d): o_nonnegative_remainder = d
                    return
                # round toward zero: add (2^sh - 1) to negative dividends before shifting
                t1 = ow_bin(.shrs, ow_tmp(), a, ow_kconst(63))
                t2 = ow_bin(.shru, ow_tmp(), t1, ow_kconst(64 - sh))
                t3 = ow_bin(.add, ow_tmp(), a, t2)
                if op == .divs:
                    ow_bin(.shrs, d, t3, ow_kconst(sh))
                else:
                    t4 = ow_bin(.and_, ow_tmp(), t3, ow_kconst(-k))
                    ow_bin(.sub, d, a, t4)
                return
        if (op == .divs or op == .rems) and k > 1 and sh <= 0 and opt_mulh_ok:
            # by any other constant: a multiply by a "magic" number, its high half, a shift, and a
            # one added to negative dividends (Hacker's Delight 10-1), as C compilers do
            mag, s = ow_div_magic(k)
            plain = ow_nonnegative(a)
            q = ow_bin(.mulhs, ow_tmp(), a, ow_kconst(mag))
            if mag < 0: q = ow_bin(.add, ow_tmp(), q, a)
            if s > 0: q = ow_bin(.shrs, ow_tmp(), q, ow_kconst(s))
            qq = q
            if not plain:
                neg = ow_bin(.shru, ow_tmp(), a, ow_kconst(63))
                target = if op == .divs: d else: ow_tmp()
                qq = ow_bin(.add, target, q, neg)
            else if op == .divs: ow_bin(.mov, d, q, 0)
            if op == .rems:
                t = ow_bin(.mul, ow_tmp(), qq, ow_kconst(k))
                ow_bin(.sub, d, a, t)
                if plain and ow_stable(d): o_nonnegative_remainder = d
            return
        if (op == .divu or op == .remu) and k > 1 and sh <= 0 and opt_mulh_ok:
            # unsigned: the high half of a multiply by a magic number, and a shift (with an add when
            # the number needs 65 bits: Hacker's Delight 10-8)
            mag, s, add = ow_divu_magic(u64(k))
            # (the last step writes the quotient straight into d, as the signed one does)
            qd = d
            if op == .remu: qd = ow_tmp()
            t = ow_bin(.mulhu, ow_tmp(), a, ow_kconst(int(mag)))
            if add:
                q1 = ow_bin(.sub, ow_tmp(), a, t)
                q2 = ow_bin(.shru, ow_tmp(), q1, ow_kconst(1))
                if s > 1:
                    q3 = ow_bin(.add, ow_tmp(), q2, t)
                    ow_bin(.shru, qd, q3, ow_kconst(s - 1))
                else: ow_bin(.add, qd, q2, t)
            else:
                ow_bin(.shru, qd, t, ow_kconst(s))
            if op == .remu:
                q = int(o_regs[qd].repl)
                m = ow_bin(.mul, ow_tmp(), q, ow_kconst(k))
                ow_bin(.sub, d, a, m)
            return
        break
    op = ins.op
    if op == .br or op == .brif or op == .brtable: o_nbr += 1
    if o_cse and (op == .load or op == .store):
        # fold constant offsets into the access: [x + k + imm]
        a = int(ins.a)
        loop ow_def_is(a, 4) and o_regs[int(o_regs[a].db)].constant and ow_fits32(ins.imm + o_regs[int(o_regs[a].db)].cval):
            ins.imm += o_regs[int(o_regs[a].db)].cval
            a = int(o_regs[a].da)
        # [base + index << scale + imm] (x86 addressing; wasm computes it)
        if int(ins.c) & 128 == 0 and ow_def_is(a, 4) and not o_regs[int(o_regs[a].db)].constant and not o_regs[int(o_regs[a].da)].constant:
            base = int(o_regs[a].da)
            idx = int(o_regs[a].db)
            scale = 0
            if ow_def_is(idx, 14) and o_regs[int(o_regs[idx].db)].constant and o_regs[int(o_regs[idx].db)].cval <= 3 and o_regs[int(o_regs[idx].db)].cval >= 0:
                scale = o_regs[int(o_regs[idx].db)].cval
                idx = int(o_regs[idx].da)
            loop ow_def_is(base, 4) and o_regs[int(o_regs[base].db)].constant and ow_fits32(ins.imm + o_regs[int(o_regs[base].db)].cval):
                ins.imm += o_regs[int(o_regs[base].db)].cval
                base = int(o_regs[base].da)
            a = base
            ins.c = i32(int(ins.c) | 128 | (scale << 8))
            if op == .store: ins.dst = i32(idx)
            else: ins.b = i32(idx)
        ins.a = i32(a)
    if o_cse:
        arity = ow_arity(oc_tag(ins), int(ins.c))
        if arity >= 0:
            d = int(ins.dst)
            reg = &o_regs[d]
            do_ht = opt_allow_cse or (o_loop_depth > 0 and (op == .load or op == .slot or op == .add or op == .sub or op == .mul or op == .and_ or op == .shl or op == .eq or op == .ne))
            if do_ht:
                va = 0
                vb = 0
                if arity > 0: va = int(o_regs[int(ins.a)].ver)
                if arity > 1: vb = int(o_regs[int(ins.b)].ver)
                k1 = oc_tag(ins) | (int(ins.ty) << 8) | ((int(ins.c) & 4095) << 12) | (int(ins.a) << 24)
                k2 = int(ins.b)
                k3 = ins.imm
                gen = -1
                if op == .load: gen = ow_mem_gen(int(ins.c))
                slot = ow_ht_slot(k1, k2, k3)
                e = ow_ht_available(slot, gen, va, vb)
                cheap_cmp = ow_boolean_tag(oc_tag(ins))
                if e >= 0 and ow_vtype(e) == ow_vtype(d) and (not cheap_cmp or ow_fact_true(e) or ow_fact_false(e)):
                    if reg.stable:
                        reg.repl = i32(e)
                        if o_regs[e].constant:
                            reg.constant = true
                            reg.cval = o_regs[e].cval
                        return
                    reg.ver += 1
                    o_regs[e].nuse += 1
                    ow_append_plain(Ins(.mov, i32(ow_vtype(d)), i32(d), i32(e), 0, 0, 0))
                    return
                if reg.stable:
                    ow_ht_insert(slot, k1, k2, k3, d, gen, va, vb)
                    reg.dop = i32(oc_tag(ins))
                    reg.da = ins.a
                    reg.db = ins.b
                    reg.dva = o_regs[int(ins.a)].ver
                    reg.dvb = o_regs[int(ins.b)].ver
            else if reg.stable:
                reg.dop = i32(oc_tag(ins))
                reg.da = ins.a
                reg.db = ins.b
                reg.dva = o_regs[int(ins.a)].ver
                reg.dvb = o_regs[int(ins.b)].ver
            # CSE already decoded these operands. Account for the surviving
            # operation here instead of decoding it again through o_push.
            reg.ver += 1
            if arity > 0: o_regs[int(ins.a)].nuse += 1
            if arity > 1: o_regs[int(ins.b)].nuse += 1
            ow_append_plain(ins[0])
            return
        else if op == .store:
            mode = int(ins.c)
            ow_kill_mem(mode)
            # store-to-load forwarding for full-width values
            a = int(ins.a)
            v = int(ins.b)
            ix = 0
            vix = 0
            if mode & 128 != 0:
                ix = int(ins.dst)
                vix = int(o_regs[ix].ver)
            if (opt_allow_cse or o_loop_depth > 0) and (mode & 15 == 8 or mode & 32 != 0) and ow_stable(v):
                ow_ht_put_gen(ow_load_key1(int(ins.ty), mode, a), ix, ins.imm, v, ow_mem_gen(mode), int(o_regs[a].ver), vix)
            o_regs[a].nuse += 1
            o_regs[v].nuse += 1
            if mode & 128 != 0: o_regs[ix].nuse += 1
            ow_append_plain(ins[0])
            return
        else if op == .assume:
            a = int(ins.a)
            if ins.imm == 1:
                k = ow_kconst(1)
                ow_ht_put_gen(ow_load_key1(0, 8 | 64, a), 0, 0, k, ow_mem_gen(8 | 64), int(o_regs[a].ver), 0)
            return
        else if opt_decode[oc_tag(ins)] & 4 != 0 and not (op == .call and ins.c == 1): ow_kill_all()
    else:
        arity = ow_arity(oc_tag(ins), int(ins.c))
        if arity >= 0:
            d = int(ins.dst)
            reg = &o_regs[d]
            if reg.stable:
                reg.dop = i32(oc_tag(ins))
                reg.da = ins.a
                reg.db = ins.b
                reg.dva = o_regs[int(ins.a)].ver
                reg.dvb = o_regs[int(ins.b)].ver
            reg.ver += 1
            if arity > 0: o_regs[int(ins.a)].nuse += 1
            if arity > 1: o_regs[int(ins.b)].nuse += 1
            ow_append_plain(ins[0])
            return
        else if op == .store:
            mode = int(ins.c)
            o_regs[int(ins.a)].nuse += 1
            o_regs[int(ins.b)].nuse += 1
            if mode & 128 != 0: o_regs[int(ins.dst)].nuse += 1
            ow_append_plain(ins[0])
            return
        else if op == .assume: return
    # Record the boolean result without making raw-memory reads available
    # expressions: subsequent stores must still perform a new comparison.
    if (op == .memeq or op == .streq) and ow_stable(int(ins.dst)): o_regs[int(ins.dst)].dop = i32(oc_tag(ins))
    ow_push(ins)

# the magic number, shift and whether an add is needed, for dividing an unsigned 64-bit integer
# by d (d >= 2) (Hacker's Delight 10-2)

ow_divu_magic = (d: u64) -> (u64, int, bool):
    two63: u64 = 0x8000000000000000
    max63: u64 = 0x7FFFFFFFFFFFFFFF
    add = false
    nc = (u64(0) - 1) - (u64(0) - d) % d
    p = 63
    q1 = two63 / nc
    r1 = two63 - q1 * nc
    q2 = max63 / d
    r2 = max63 - q2 * d
    loop true:
        p += 1
        if r1 >= nc - r1:
            q1 = q1 * 2 + 1
            r1 = r1 * 2 - nc
        else:
            q1 = q1 * 2
            r1 = r1 * 2
        if r2 + 1 >= d - r2:
            if q2 >= max63: add = true
            q2 = q2 * 2 + 1
            r2 = r2 * 2 + 1 - d
        else:
            if q2 >= two63: add = true
            q2 = q2 * 2
            r2 = r2 * 2 + 1
        delta = d - 1 - r2
        if not (p < 128 and (q1 < delta or (q1 == delta and r1 == 0))): break
    (q2 + 1, p - 64, add)

# the magic number and shift for dividing a signed 64-bit integer by d (d >= 2): q = mulhs(n, m)
# (+ n when m < 0) >> s, plus 1 when n < 0

ow_div_magic = (d: int) -> (int, int):
    two63: u64 = 0x8000000000000000
    ad = u64(d)
    t = two63
    anc = t - 1 - t % ad
    p = 63
    q1 = two63 / anc
    r1 = two63 - q1 * anc
    q2 = two63 / ad
    r2 = two63 - q2 * ad
    loop true:
        p += 1
        q1 = q1 * 2
        r1 = r1 * 2
        if r1 >= anc:
            q1 += 1
            r1 -= anc
        q2 = q2 * 2
        r2 = r2 * 2
        if r2 >= ad:
            q2 += 1
            r2 -= ad
        delta = ad - r2
        if not (q1 < delta or (q1 == delta and r1 == 0)): break
    (int(q2 + 1), p - 64)

# Forward whole-slot copies through dead intermediates after inlining. A
# temporary must have one address definition and exactly two uses: the incoming
# and outgoing copies. No derived address, call, or later observer can exist.
# Both endpoints are distinct stack slots and no write/control boundary may
# intervene, so the source still contains the snapshot the second copy needs.
# Larger records benefit without adding scalar lanes or register pressure.

ow_enter_loop = ():
    l = lp_next
    lp_next += 1
    loop k in [lp_first[l]..lp_limit[l]): o_regs[lp_defs[k]].ver += 1
    k = lp_kills[l]
    if k & 1 != 0 or opt_ir.raw_mem: o_gen += 1
    if k & 2 != 0 or opt_ir.raw_mem: o_genf += 1
    if k & 4 != 0 or opt_ir.raw_mem: o_genh += 1

# Input metadata is O(N + U): each operation and operand use is visited once.

fl_branch_copy = (out: *Ins, n: int) -> int:
    if n < 3 or out[n - 2].op != .mov: return -1
    d = int(out[n - 2].dst)
    if d < 0 or o_regs[d].ndef <= 1 or o_regs[d].repl != i32(d): return -1
    i = n - 3
    floor = if n > 19: n - 19 else: 0
    loop i >= floor:
        ins = out + i
        op = ins.op
        if op == .brif: return if ins.imm == 0: d else: -1
        if op == .block or op == .loop or op == .if_ or op == .else_ or op == .end or op == .br or op == .brtable or op == .ret or op == .trap or op == .zeroslots: return -1
        if opt_decode[oc_tag(ins)] & 1 != 0 and ins.dst == i32(d): return -1
        i -= 1
    -1

fl_slot = (key: int, a: int, b: int, imm: int) -> int:
    h = (a * 2654435761) xor (b * 2246822519) xor (imm * 3266489917) xor (key * 668265263)
    (h xor (h >> 16)) & 254

fl_cache_put = (cache: *FastLoad, sids: *int, ed: int, gen: int, imm: int, key: int, a: int, b: int, dst: i32, va: i32, vb: i32, dver: i32):
    if ed >= 128: return
    s = fl_slot(key, a, b, imm)
    c0 = cache + s
    if c0.depth <= ed and c0.sid == sids[int(c0.depth)]:
        if not (c0.gen == gen and c0.imm == imm and c0.key == key and int(c0.a) == a and int(c0.b) == b):
            cache[s + 1] = c0[0]
    c0[0] = FastLoad(sids[ed], gen, imm, key, i32(a), i32(b), dst, i32(ed), va, vb, dver)

fl_kconst = (v: int) -> int:
    d = ow_k_vreg(v)
    if o_reg_count <= d: ow_resize_one(d)
    reg = &o_regs[d]
    reg.ndef = 1
    reg.stable = true
    reg.constant = true
    reg.cval = v
    reg.repl = i32(d)
    reg.dop = 0
    d

fl_def_is = (v: int, op: int) -> bool:
    r = &o_regs[v]
    r.stable and int(r.dop) == op and o_regs[int(r.da)].ver == r.dva and o_regs[int(r.db)].ver == r.dvb

fl_repl = (regs: *OptReg, sids: *int, depth: int, v: int) -> int:
    r = int(regs[v].repl)
    rr = regs + r
    if rr.dop == 3:
        db = int(rr.db)
        if db <= depth and sids[db] == int(rr.dvb):
            a = int(rr.da)
            if regs[a].ver == rr.dva: return a
    r

fl_fact = (c: int, depth: int, sids: *int) -> int:
    fe = o_regs[c].fact_epoch
    if fe != 0:
        fd = (fe >> 1) & 127
        if fd <= depth and (fe >> 8) == sids[fd]: return fe & 1
    -1

fl_set_fact = (c: int, depth: int, sids: *int, truth: int):
    if depth < 128 and o_regs[c].stable:
        o_regs[c].fact_epoch = (sids[depth] << 8) | (depth << 1) | truth

fl_width_mask = (v: int) -> int:
    r = &o_regs[v]
    if r.constant:
        k = r.cval
        m = 0
        if k >= -128 and k <= 127: m |= 1
        if k >= -32768 and k <= 32767: m |= 2
        if k >= -2147483648 and k <= 2147483647: m |= 4
        if k >= 0 and k <= 255: m |= 8
        if k >= 0 and k <= 65535: m |= 16
        if k >= 0 and k <= 4294967295: m |= 32
        return m
    if not r.stable: return 0
    dop = int(r.dop)
    if ow_boolean_tag(dop) or dop == 96 or dop == 103: return 63
    has_k = (dop == 11 or dop == 15 or dop == 16) and o_regs[int(r.db)].constant
    k = if has_k: (if dop == 11: o_regs[int(r.db)].cval else: o_regs[int(r.db)].cval & 63) else: 0
    ow_dop_width_mask(dop, int(r.da), has_k, k)

fl_straight_bin_cold = (p_ins: *Ins, w_ins: *Ins, regs: *OptReg, a: int, b: int) -> bool:
    op = p_ins.op
    ra = regs + a
    rb = regs + b
    d = int(p_ins.dst)
    if ra.constant and rb.constant:
        ok, fval = ow_fold(op, ra.cval, rb.cval)
        if ok:
            rd = regs + d
            if rd.ndef == 1: rd.constant = true; rd.cval = fval
            w_ins[0] = Ins(.iconst, 0, p_ins.dst, 0, 0, 0, fval)
            return true
    if a == b:
        known = if op == .eq or op == .les or op == .ges or op == .leu or op == .geu: 1 else if op == .ne or op == .lts or op == .gts or op == .ltu or op == .gtu: 0 else: -1
        if known >= 0:
            rd = regs + d
            if rd.ndef == 1: rd.constant = true; rd.cval = known
            w_ins[0] = Ins(.iconst, 0, p_ins.dst, 0, 0, 0, known)
            return true
    if rb.constant:
        k = rb.cval
        known = if (op == .lts and k == OW_MIN_INT) or (op == .gts and k == 9223372036854775807) or (op == .ltu and k == 0): 0 else if (op == .ges and k == OW_MIN_INT) or (op == .les and k == 9223372036854775807) or (op == .geu and k == 0): 1 else: -1
        if known >= 0:
            rd = regs + d
            if rd.ndef == 1: rd.constant = true; rd.cval = known
            w_ins[0] = Ins(.iconst, 0, p_ins.dst, 0, 0, 0, known)
            return true
    false

# Fast in-place default-mode optimizer for straight-line functions (no loops).
opt_no_fast_straight = false
opt_fast_straight = ():
    opt_args = data(opt_ir.args)
    opt_vtypes = data(opt_ir.vtypes)
    opt_fast_nv = opt_ir.vtypes.len()
    opt_input_count = opt_ir.code.len()
    opt_nparams = opt_ir.nparams
    opt_raw_mem = opt_ir.raw_mem
    opt_has_big_loop_const = false
    ncode = opt_input_count
    input = data(opt_ir.code)
    opt_input = input
    dec = opt_decode
    regs = o_regs
    args = opt_args
    vt = opt_vtypes
    loop v in [0..opt_fast_nv):
        regs[v].ndef = 0
        regs[v].nuse = 0
        regs[v].repl = i32(v)
        regs[v].constant = false
    loop p in [0..opt_nparams):
        regs[p].ndef = 1
    constants = data(opt_ir.kval)
    loop v in [0..opt_ir.kval.len()):
        if int(vt[v]) == 3:
            regs[v].ndef = 1
            regs[v].constant = true
            regs[v].cval = constants[v]
    rot_mask = 0
    loop pos in [0..ncode):
        p_ins = input + pos
        tag = oc_tag(p_ins)
        if (dec[tag] & 1) != 0:
            d = int(p_ins.dst)
            if d >= 0: regs[d].ndef += 1
            if tag >= 12 and tag <= 16: rot_mask |= 1 << (tag - 12)
        else if p_ins.op == .zeroslots:
            a0 = int(p_ins.a)
            loop k in [a0..a0 + int(p_ins.b)):
                item = int(args[k])
                if (item & 1) == 1: regs[item >> 1].ndef += 2
    if opt_rotate32_ok and (rot_mask & 21) == 21:
        if opt_fast_nv > 0:
            mem_set(regs as *u8, 0, opt_fast_nv * size_of(OptReg))
            loop v in [0..opt_fast_nv):
                regs[v].repl = i32(v)
                regs[v].defpos = -1
                regs[v].first = 2147483647
                regs[v].dop = -1
        opt_no_fast_straight = true
        opt_rewrite()
        opt_no_fast_straight = false
        return
    if fl_sid.len() < 256: fl_ensure_sid()
    if fl_blk_start.len() < 256: fl_ensure_blk()
    ckind = fl_sid_p
    bstart = fl_blk_start_p
    cdepth = 0
    w = 0
    skip = 0
    dead = 0
    any_mov = false
    last_mask_reg = -1
    last_mask_val = -1
    rf_op = Op.nop
    rf_a = -1
    rf_b = -1
    rf_val = 0
    if_op = Op.nop
    if_a = -1
    if_b = -1
    if_had_else = false
    blk_br_count = 0
    blk_br_op = Op.nop
    blk_br_a = -1
    blk_br_b = -1
    loop pos in [0..ncode):
        p_ins = input + pos
        w_ins = input + w
        op = p_ins.op
        ended_dead = false
        if (skip | dead) != 0:
            if skip > 0:
                if op == .block or op == .if_: skip += 1
                else if op == .else_ and skip == 1 and ckind[cdepth - 1] == 2: skip = 0
                else if op == .end:
                    skip -= 1
                    if skip == 0:
                        cdepth -= 1
                        if w > 0 and (input[w - 1].op == .block or input[w - 1].op == .if_):
                            if input[w - 1].op == .if_: regs[int(input[w - 1].a)].nuse -= 1
                            w -= 1
                        else:
                            if w != pos: input[w] = p_ins[0]
                            w += 1
                continue
            if op == .block or op == .if_: dead += 1; continue
            if op == .else_ and dead == 1:
                if cdepth == 1: if_had_else = true
                dead = 0
            else if op == .end:
                dead -= 1
                if dead > 0: continue
                ended_dead = true
            else: continue
        match op:
            nop, assume: pass
            fconst, slot, gaddr, daddr, faddr, vzu, zeroslots:
                if w != pos: w_ins[0] = p_ins[0]
                w += 1
            iconst:
                d = int(p_ins.dst)
                if regs[d].ndef == 1:
                    regs[d].constant = true
                    regs[d].cval = p_ins.imm
                if w != pos: w_ins[0] = p_ins[0]
                w += 1
            mov:
                a = int(regs[int(p_ins.a)].repl)
                d = int(p_ins.dst)
                if a != d:
                    vtd = int(vt[d]); vta = int(vt[a])
                    if regs[d].ndef == 1 and regs[a].ndef == 1 and (if vtd == 3: 0 else: vtd) == (if vta == 3: 0 else: vta):
                        regs[d].repl = i32(a)
                        if regs[a].constant: regs[d].constant = true; regs[d].cval = regs[a].cval
                    else:
                        any_mov = true
                        if w != pos: w_ins[0] = p_ins[0]
                        w_ins.a = i32(a)
                        regs[a].nuse += 1
                        w += 1
            add, sub, mul, divs, divu, rems, remu, and_, or_, xor, shl, shrs, shru, rot32, eq, ne, lts, les, gts, ges, ltu, leu, gtu, geu, overflow_add, overflow_sub, overflow_mul:
                a = int(regs[int(p_ins.a)].repl)
                b = int(regs[int(p_ins.b)].repl)
                ra = regs + a
                rb = regs + b
                handled = false
                if (rf_a & last_mask_reg) >= 0 and p_ins.ty == 0:
                    if rf_a >= 0 and a == rf_a and b == rf_b and op == rf_op:
                        rd = regs + int(p_ins.dst)
                        if rd.ndef == 1: rd.constant = true; rd.cval = rf_val
                        w_ins[0] = Ins(.iconst, 0, p_ins.dst, 0, 0, 0, rf_val)
                        w += 1
                        handled = true
                    else if last_mask_reg >= 0 and a == last_mask_reg and rb.constant:
                        ptag = oc_tag(p_ins)
                        if ptag >= 21 and ptag <= 28 and ow_fold(op, 0, rb.cval).1 == ow_fold(op, last_mask_val, rb.cval).1:
                            kv = ow_fold(op, 0, rb.cval).1
                            rd = regs + int(p_ins.dst)
                            if rd.ndef == 1: rd.constant = true; rd.cval = kv
                            w_ins[0] = Ins(.iconst, 0, p_ins.dst, 0, 0, 0, kv)
                            w += 1
                            handled = true
                if not handled:
                    if p_ins.ty == 0 and ((rb.constant and (ra.constant or (oc_tag(p_ins) >= 21 and oc_tag(p_ins) <= 28))) or a == b) and fl_straight_bin_cold(p_ins, w_ins, regs, a, b):
                        w += 1
                    else:
                        if op == .and_ and p_ins.ty == 0 and regs[int(p_ins.dst)].ndef == 1:
                            if rb.constant and rb.cval >= 0: last_mask_reg = int(p_ins.dst); last_mask_val = rb.cval
                            else if ra.constant and ra.cval >= 0: last_mask_reg = int(p_ins.dst); last_mask_val = ra.cval
                        if w != pos: w_ins[0] = p_ins[0]
                        w_ins.a = i32(a)
                        w_ins.b = i32(b)
                        ra.nuse += 1
                        rb.nuse += 1
                        w += 1
            load:
                a = int(regs[int(p_ins.a)].repl)
                mode = int(p_ins.c)
                if w != pos: w_ins[0] = p_ins[0]
                w_ins.a = i32(a)
                regs[a].nuse += 1
                if (mode & 128) != 0:
                    b = int(regs[int(w_ins.b)].repl)
                    w_ins.b = i32(b)
                    regs[b].nuse += 1
                w += 1
            store:
                a = int(regs[int(p_ins.a)].repl)
                b = int(regs[int(p_ins.b)].repl)
                mode = int(p_ins.c)
                if w != pos: w_ins[0] = p_ins[0]
                w_ins.a = i32(a)
                w_ins.b = i32(b)
                regs[a].nuse += 1
                regs[b].nuse += 1
                if (mode & 128) != 0:
                    ud = int(regs[int(w_ins.dst)].repl)
                    w_ins.dst = i32(ud)
                    regs[ud].nuse += 1
                w += 1
            zero, neg, not_, fneg, fsqrt, fabs, ffloor, fceil, ftrunc, sext8, sext16, sext32, zext8, zext16, zext32, i2f, u2f, f2i, f2f, bits2f, f2bits, vsplat:
                a = int(regs[int(p_ins.a)].repl)
                if w != pos: w_ins[0] = p_ins[0]
                w_ins.a = i32(a)
                regs[a].nuse += 1
                w += 1
            call, intr, syscall:
                a0 = int(p_ins.a)
                loop k in [a0..a0 + int(p_ins.b)):
                    u = int(regs[int(args[k])].repl)
                    args[k] = i32(u)
                    regs[u].nuse += 1
                nr = op == .call and p_ins.c == 1
                if w != pos: w_ins[0] = p_ins[0]
                w += 1
                if nr: dead = 1
            calli, callc:
                a0 = int(p_ins.a)
                loop k in [a0..a0 + int(p_ins.b)):
                    u = int(regs[int(args[k])].repl)
                    args[k] = i32(u)
                    regs[u].nuse += 1
                c = int(regs[int(p_ins.c)].repl)
                if w != pos: w_ins[0] = p_ins[0]
                w_ins.c = i32(c)
                regs[c].nuse += 1
                w += 1
            ret:
                if w != pos: w_ins[0] = p_ins[0]
                if w_ins.a >= 0:
                    a = int(regs[int(w_ins.a)].repl)
                    w_ins.a = i32(a)
                    regs[a].nuse += 1
                w += 1
                dead = 1
            memcpy, memset, select, vop, memeq, findbyte, scanbytes, findb:
                a = int(regs[int(p_ins.a)].repl)
                b = int(regs[int(p_ins.b)].repl)
                c = int(regs[int(p_ins.c)].repl)
                if w != pos: w_ins[0] = p_ins[0]
                w_ins.a = i32(a); w_ins.b = i32(b); w_ins.c = i32(c)
                regs[a].nuse += 1
                regs[b].nuse += 1
                regs[c].nuse += 1
                w += 1
            vst:
                a = int(regs[int(p_ins.a)].repl)
                b = int(regs[int(p_ins.b)].repl)
                ud = int(regs[int(p_ins.dst)].repl)
                if w != pos: w_ins[0] = p_ins[0]
                w_ins.a = i32(a); w_ins.b = i32(b); w_ins.dst = i32(ud)
                regs[a].nuse += 1
                regs[b].nuse += 1
                regs[ud].nuse += 1
                w += 1
            br, trap:
                if op == .br and cdepth - 1 - p_ins.imm == 0: blk_br_count += 1
                if w != pos: w_ins[0] = p_ins[0]
                w += 1
                dead = 1
            brtable:
                blk_br_count += 2
                a = int(regs[int(p_ins.a)].repl)
                if w != pos: w_ins[0] = p_ins[0]
                w_ins.a = i32(a)
                regs[a].nuse += 1
                w += 1
                dead = 1
            block:
                if cdepth == 0: blk_br_count = 0; blk_br_a = -1
                if cdepth < 256:
                    ckind[cdepth] = 3
                    bstart[cdepth] = w
                cdepth += 1
                if w != pos: w_ins[0] = p_ins[0]
                w += 1
            if_:
                c = int(regs[int(p_ins.a)].repl)
                if regs[c].constant:
                    w_ins[0] = Ins(.block, 0, 0, 0, 0, 0, 0)
                    w += 1
                    if regs[c].cval != 0:
                        if cdepth < 256: ckind[cdepth] = 1
                    else:
                        if cdepth < 256: ckind[cdepth] = 2
                        skip = 1
                    cdepth += 1
                else:
                    if cdepth == 0:
                        if_a = -1; if_had_else = false
                        if w > 0:
                            prev = input + (w - 1)
                            ptag0 = oc_tag(prev)
                            if ptag0 >= 19 and ptag0 <= 28 and prev.ty == 0 and int(prev.dst) == c and regs[int(prev.a)].ndef == 1 and regs[int(prev.b)].ndef == 1:
                                if_op = prev.op; if_a = int(prev.a); if_b = int(prev.b)
                    if cdepth < 256:
                        ckind[cdepth] = 0
                        bstart[cdepth] = w
                    cdepth += 1
                    if w != pos: w_ins[0] = p_ins[0]
                    w_ins.a = i32(c)
                    regs[c].nuse += 1
                    w += 1
            else_:
                if cdepth == 1: if_had_else = true
                if ckind[cdepth - 1] == 1: skip = 1
                else:
                    if w != pos: w_ins[0] = p_ins[0]
                    w += 1
            end:
                cdepth -= 1
                if cdepth == 0 and ended_dead:
                    if ckind[0] == 0 and not if_had_else and if_a >= 0:
                        rf_op = if_op; rf_a = if_a; rf_b = if_b; rf_val = 0
                    else if ckind[0] == 3 and blk_br_count == 1 and blk_br_a >= 0:
                        rf_op = blk_br_op; rf_a = blk_br_a; rf_b = blk_br_b; rf_val = 1
                dropped = false
                if w > 0 and input[w - 1].op == .br and input[w - 1].imm == 0: w -= 1
                if w > 0:
                    lop = input[w - 1].op
                    if lop == .block: w -= 1; dropped = true
                    else if lop == .if_:
                        regs[int(input[w - 1].a)].nuse -= 1
                        w -= 1; dropped = true
                if not dropped and cdepth < 256 and ckind[cdepth] == 3:
                    st = bstart[cdepth]
                    if w - st >= 6 and w - st <= 32 and input[st + 1].op == .block:
                        selected = oc_if_select(input, st, w)
                        if selected >= 0:
                            regs = o_regs
                            vt = opt_vtypes
                            sel = input + (selected - 1)
                            regs[int(sel.a)].nuse += 1
                            regs[int(sel.b)].nuse += 1
                            regs[int(sel.c)].nuse += 1
                            w = selected
                            dropped = true
                if not dropped:
                    if w != pos: input[w] = p_ins[0]
                    w += 1
            brif:
                c = int(regs[int(p_ins.a)].repl)
                if regs[c].constant:
                    if regs[c].cval != 0:
                        if cdepth - 1 - p_ins.imm == 0: blk_br_count += 1
                        w_ins[0] = Ins(.br, 0, 0, 0, 0, 0, p_ins.imm)
                        w += 1
                        dead = 1
                else:
                    if cdepth - 1 - p_ins.imm == 0:
                        blk_br_count += 1
                        if blk_br_count == 1 and cdepth == 1 and w > 0:
                            prev = input + (w - 1)
                            ptag0 = oc_tag(prev)
                            if ptag0 >= 19 and ptag0 <= 28 and prev.ty == 0 and int(prev.dst) == c and regs[int(prev.a)].ndef == 1 and regs[int(prev.b)].ndef == 1:
                                blk_br_op = prev.op; blk_br_a = int(prev.a); blk_br_b = int(prev.b)
                        else: blk_br_a = -1
                    if w != pos: w_ins[0] = p_ins[0]
                    w_ins.a = i32(c)
                    regs[c].nuse += 1
                    w += 1
            _:
                a = int(regs[int(p_ins.a)].repl)
                b = int(regs[int(p_ins.b)].repl)
                if w != pos: w_ins[0] = p_ins[0]
                w_ins.a = i32(a)
                w_ins.b = i32(b)
                regs[a].nuse += 1
                regs[b].nuse += 1
                w += 1
    # Pass 3: in-place backward DCE.
    any_nop = false
    bi = w - 1
    loop bi >= 0:
        b_ins = input + bi
        dw = dec[oc_tag(b_ins)]
        if (dw & 2) != 0 and regs[int(b_ins.dst)].nuse == 0 and not (b_ins.op == .load and (int(b_ins.c) & 65536) != 0):
            mask = (dw >> 8) & 255
            if mask == 1: regs[int(b_ins.a)].nuse -= 1
            else if mask == 3:
                regs[int(b_ins.a)].nuse -= 1
                regs[int(b_ins.b)].nuse -= 1
            else if mask == 65:
                regs[int(b_ins.a)].nuse -= 1
                if (int(b_ins.c) & 128) != 0: regs[int(b_ins.b)].nuse -= 1
            else if mask == 7:
                regs[int(b_ins.a)].nuse -= 1
                regs[int(b_ins.b)].nuse -= 1
                regs[int(b_ins.c)].nuse -= 1
            b_ins.op = .nop
            any_nop = true
        bi -= 1
    # Pass 4: compaction + mov retargeting (skipped if nothing to compact or retarget).
    if not any_nop and not any_mov:
        if w > 0: __set_len(opt_ir.code, w)
        else: opt_ir.code.clear()
        return
    if w > 0:
        nw = 0
        loop j in [0..w):
            jp = input + j
            op = jp.op
            if op == .nop: continue
            if op == .mov and nw > 0:
                t = int(jp.a)
                d = int(jp.dst)
                prev_w = input + (nw - 1)
                if t != d and regs[t].nuse == 1 and int(prev_w.dst) == t:
                    vtt = int(vt[t]); vtd = int(vt[d])
                    if (if vtt == 3: 0 else: vtt) == (if vtd == 3: 0 else: vtd):
                        pop = prev_w.op
                        rt = if pop == .checked_add or pop == .checked_sub or pop == .checked_mul: opt_checked_flags else if pop == .call or pop == .calli or (pop == .callc and prev_w.imm >= 0) or pop == .syscall or pop == .intr: true else: (dec[oc_tag(prev_w)] & 8) != 0
                        if rt:
                            prev_w.dst = i32(d)
                            continue
            if nw != j: input[nw] = jp[0]
            nw += 1
        __set_len(opt_ir.code, nw)
    else: opt_ir.code.clear()

fl_cache_p: *FastLoad
fl_sid_p: *int
o_ctl_p: *OptControl
fl_blk_start_p: *int
fl_blk_kind_p: *Op
lp_open_p: *int
lp_open_cap = 0
fl_ctl_cap_g = 0
fl_blk_cap_g = 0

fl_ensure_sid = ():
    if fl_sid.len() < 256: fl_sid.resize(256)
    fl_sid_p = data(fl_sid)
fl_ensure_pass1 = ():
    if lp_open.len() < 256: lp_open.resize(256)
    lp_open_p = data(lp_open)
    lp_open_cap = lp_open.len()
fl_grow_open = ():
    nc = lp_open_cap * 2
    lp_open.resize(nc)
    lp_open_p = data(lp_open)
    lp_open_cap = nc
fl_ensure_pass2 = ():
    if fl_cache.len() < 256: fl_cache.resize(256)
    fl_cache_p = data(fl_cache)
    if fl_sid.len() < 256: fl_sid.resize(256)
    fl_sid_p = data(fl_sid)
    if o_ctl.len() < 256: o_ctl.resize(256)
    if fl_blk_start.len() < o_ctl.len(): fl_blk_start.resize(o_ctl.len())
    o_ctl_p = data(o_ctl)
    fl_blk_start_p = data(fl_blk_start)
    fl_ctl_cap_g = o_ctl.len()
fl_grow_ctl = ():
    nc = fl_ctl_cap_g * 2
    o_ctl.resize(nc); fl_blk_start.resize(nc)
    o_ctl_p = data(o_ctl); fl_blk_start_p = data(fl_blk_start)
    fl_ctl_cap_g = nc
fl_ensure_blk = ():
    if fl_blk_start.len() < 256: fl_blk_start.resize(256)
    if fl_blk_kind.len() < fl_blk_start.len(): fl_blk_kind.resize(fl_blk_start.len())
    fl_blk_start_p = data(fl_blk_start)
    fl_blk_kind_p = data(fl_blk_kind)
    fl_blk_cap_g = fl_blk_start.len()
fl_grow_blk = ():
    nc = fl_blk_cap_g * 2
    fl_blk_start.resize(nc); fl_blk_kind.resize(nc)
    fl_blk_start_p = data(fl_blk_start)
    fl_blk_kind_p = data(fl_blk_kind)
    fl_blk_cap_g = nc

# Fast in-place default-mode optimizer for loop functions; split into compact
# single-responsibility passes so each hot loop stays register-resident.
fl_pass1 = ():
    opt_args = data(opt_ir.args)
    opt_vtypes = data(opt_ir.vtypes)
    opt_fast_nv = opt_ir.vtypes.len()
    opt_input_count = opt_ir.code.len()
    opt_nparams = opt_ir.nparams
    opt_raw_mem = opt_ir.raw_mem
    opt_has_big_loop_const = false
    opt_has_vec_cand = false
    opt_has_float_op = false
    fl_has_const_div = false
    ncode = opt_input_count
    input = data(opt_ir.code)
    opt_input = input
    dec = opt_decode
    regs = o_regs
    args = opt_args
    vt = opt_vtypes
    loop p in [0..opt_nparams):
        nd = regs[p].ndef + 1
        regs[p].ndef = nd
        regs[p].stable = nd == 1
    constants = data(opt_ir.kval)
    loop v in [0..opt_ir.kval.len()):
        if int(vt[v]) == 3:
            regs[v].ndef += 1
            regs[v].stable = true
            regs[v].constant = true
            regs[v].cval = constants[v]
    if lp_defs.len() > 0: __set_len(lp_defs, 0)
    if lp_first.len() > 0: __set_len(lp_first, 0)
    if lp_limit.len() > 0: __set_len(lp_limit, 0)
    if lp_parent.len() > 0: __set_len(lp_parent, 0)
    if lp_kills.len() > 0: __set_len(lp_kills, 0)
    lp_next = 0
    if lp_open.len() < 256 or lp_open_cap < 256: fl_ensure_pass1()
    open_p = lp_open_p
    open_cap = lp_open_cap
    open_n = 0
    if lp_defs.cap() < 256: lp_defs.reserve(256)
    defs_p = data(lp_defs)
    defs_cap = lp_defs.cap()
    defs_n = 0
    count_defs = not opt_sra_counted
    active = -1
    loop pos in [0..ncode):
        p_ins = input + pos
        dw = dec[oc_tag(p_ins)]
        if (dw & 1) != 0:
            d = int(p_ins.dst)
            if d >= 0:
                rd = regs + d
                if count_defs: rd.ndef += 1
                rd.stable = rd.ndef == 1
                if active >= 0:
                    if defs_n >= defs_cap:
                        __set_len(lp_defs, defs_n)
                        lp_defs.push(d)
                        defs_p = data(lp_defs); defs_cap = lp_defs.cap(); defs_n += 1
                    else: defs_p[defs_n] = d; defs_n += 1
            if (dw & 4) != 0 and active >= 0:
                if p_ins.op != .call or p_ins.c != 1:
                    lp_kills[active] |= 7
            continue
        ck = (dw >> 20) & 15
        if ck == 6:
            open_n -= 1
            l = open_p[open_n]
            if l >= 0:
                lp_limit[l] = defs_n
                active = lp_parent[l]
                if active >= 0: lp_kills[active] |= lp_kills[l]
        else if ck >= 2 and ck <= 4:
            if open_n >= open_cap:
                fl_grow_open()
                open_p = lp_open_p
                open_cap = lp_open_cap
            if ck == 3:
                l = lp_first.len()
                open_p[open_n] = l; open_n += 1
                lp_first.push(defs_n)
                lp_limit.push(-1)
                lp_parent.push(active)
                lp_kills.push(0)
                active = l
            else: open_p[open_n] = -1; open_n += 1
        else if ck == 15:
            a = int(p_ins.a)
            b = int(p_ins.b)
            loop k in [a..a + b):
                item = int(args[k])
                if (item & 1) == 1:
                    r0 = item >> 1
                    regs[r0].ndef += 2
                    regs[r0].stable = false
                    if active >= 0:
                        if defs_n >= defs_cap:
                            __set_len(lp_defs, defs_n)
                            lp_defs.push(r0)
                            defs_p = data(lp_defs); defs_cap = lp_defs.cap(); defs_n += 1
                        else: defs_p[defs_n] = r0; defs_n += 1
            if active >= 0: lp_kills[active] |= 7
        else if active >= 0 and (dw & 4) != 0:
            if p_ins.op == .store:
                m = int(p_ins.c)
                kill = if opt_raw_mem: 7 else if (m & 64) != 0: 4 else if (m & 32) != 0: 2 else: 1
                lp_kills[active] |= kill
            else: lp_kills[active] |= 7
    if defs_n > 0: __set_len(lp_defs, defs_n)

fl_fold_addr = (a: mut int, imm: mut int, mode: mut int, idx: mut int):
    regs = o_regs
    loop fl_def_is(a, 4) and regs[int(regs[a].db)].constant and ow_fits32(imm + regs[int(regs[a].db)].cval):
        imm = imm + regs[int(regs[a].db)].cval
        a = int(regs[a].da)
    if (mode & 128) == 0 and fl_def_is(a, 4) and not regs[int(regs[a].db)].constant and not regs[int(regs[a].da)].constant:
        base = int(regs[a].da)
        ix = int(regs[a].db)
        scale = 0
        if fl_def_is(ix, 14) and regs[int(regs[ix].db)].constant and regs[int(regs[ix].db)].cval <= 3 and regs[int(regs[ix].db)].cval >= 0:
            scale = regs[int(regs[ix].db)].cval
            ix = int(regs[ix].da)
        loop fl_def_is(base, 4) and regs[int(regs[base].db)].constant and ow_fits32(imm + regs[int(regs[base].db)].cval):
            imm = imm + regs[int(regs[base].db)].cval
            base = int(regs[base].da)
        a = base
        mode = (mode | 128) | (scale << 8)
        idx = ix

fl_slot_cse = (cache: *FastLoad, sids: *int, depth: int, ed: int, sa: int, d: int) -> int:
    regs = o_regs
    key = 62 << 24
    h0 = (sa * 2654435761) xor (key * 668265263)
    s0 = (h0 xor (h0 >> 16)) & 254
    c0 = cache + s0
    if int(c0.depth) <= depth and c0.sid == sids[int(c0.depth)] and c0.gen == -1 and c0.imm == 0 and c0.key == key and int(c0.a) == sa and int(c0.b) == 0 and regs[int(c0.dst)].ver == c0.dver: return int(c0.dst)
    c1 = c0 + 1
    if int(c1.depth) <= depth and c1.sid == sids[int(c1.depth)] and c1.gen == -1 and c1.imm == 0 and c1.key == key and int(c1.a) == sa and int(c1.b) == 0 and regs[int(c1.dst)].ver == c1.dver: return int(c1.dst)
    if regs[d].stable:
        if int(c0.depth) <= ed and c0.sid == sids[int(c0.depth)]: cache[s0 + 1] = c0[0]
        c0[0] = FastLoad(sids[ed], -1, 0, key, i32(sa), 0, i32(d), i32(ed), 0, 0, regs[d].ver)
    -1

fl_bin_lookup_fact = (cache: *FastLoad, sids: *int, depth: int, op: Op, a: int, b: int) -> int:
    regs = o_regs
    key = (if op == .eq: 19 else: 20) << 24
    va = regs[a].ver
    vb = regs[b].ver
    h0 = (a * 2654435761) xor (b * 2246822519) xor (key * 668265263)
    s0 = (h0 xor (h0 >> 16)) & 254
    c0 = cache + s0
    if int(c0.depth) <= depth and c0.sid == sids[int(c0.depth)] and c0.gen == -1 and c0.imm == 0 and c0.key == key and int(c0.a) == a and int(c0.b) == b and c0.va == va and c0.vb == vb and regs[int(c0.dst)].ver == c0.dver:
        return fl_fact(int(c0.dst), depth, sids)
    c1 = c0 + 1
    if int(c1.depth) <= depth and c1.sid == sids[int(c1.depth)] and c1.gen == -1 and c1.imm == 0 and c1.key == key and int(c1.a) == a and int(c1.b) == b and c1.va == va and c1.vb == vb and regs[int(c1.dst)].ver == c1.dver:
        return fl_fact(int(c1.dst), depth, sids)
    -1

fl_bin_cse = (cache: *FastLoad, sids: *int, depth: int, ed: int, op: Op, a: int, b: int, d: int) -> int:
    regs = o_regs
    is_cmp = op == .eq or op == .ne or op == .geu
    key = (if op == .add: 4 else if op == .mul: 6 else if op == .shl: 14 else if op == .eq: 19 else if op == .ne: 20 else: 28) << 24
    va = regs[a].ver
    vb = regs[b].ver
    h0 = (a * 2654435761) xor (b * 2246822519) xor (key * 668265263)
    s0 = (h0 xor (h0 >> 16)) & 254
    e = -1
    c0 = cache + s0
    if int(c0.depth) <= depth and c0.sid == sids[int(c0.depth)] and c0.gen == -1 and c0.imm == 0 and c0.key == key and int(c0.a) == a and int(c0.b) == b and c0.va == va and c0.vb == vb and regs[int(c0.dst)].ver == c0.dver: e = int(c0.dst)
    else:
        c1 = c0 + 1
        if int(c1.depth) <= depth and c1.sid == sids[int(c1.depth)] and c1.gen == -1 and c1.imm == 0 and c1.key == key and int(c1.a) == a and int(c1.b) == b and c1.va == va and c1.vb == vb and regs[int(c1.dst)].ver == c1.dver: e = int(c1.dst)
    if e >= 0 and ow_vtype(e) == ow_vtype(d) and (not is_cmp or fl_fact(e, depth, sids) >= 0): return e
    if regs[d].stable:
        if int(c0.depth) <= ed and c0.sid == sids[int(c0.depth)]: cache[s0 + 1] = c0[0]
        c0[0] = FastLoad(sids[ed], -1, 0, key, i32(a), i32(b), i32(d), i32(ed), va, vb, regs[d].ver)
    -1

fl_load_cse = (cache: *FastLoad, sids: *int, depth: int, ed: int, a: int, idx: int, imm: int, mode: int, ty: int, d: int) -> int:
    regs = o_regs
    key = (59 << 24) | (ty << 16) | (mode & 4095)
    gen = if opt_raw_mem: o_gen else if (mode & 64) != 0: o_genh else if (mode & 32) != 0: o_genf else: o_gen
    va = regs[a].ver
    vb = if (mode & 128) != 0: regs[idx].ver else: i32(0)
    h0 = (a * 2654435761) xor (idx * 2246822519) xor (imm * 3266489917) xor (key * 668265263)
    s0 = (h0 xor (h0 >> 16)) & 254
    e = -1
    c0 = cache + s0
    if int(c0.depth) <= depth and c0.sid == sids[int(c0.depth)] and c0.gen == gen and c0.imm == imm and c0.key == key and int(c0.a) == a and int(c0.b) == idx and c0.va == va and c0.vb == vb and regs[int(c0.dst)].ver == c0.dver:
        e = int(c0.dst)
    else:
        c1 = c0 + 1
        if int(c1.depth) <= depth and c1.sid == sids[int(c1.depth)] and c1.gen == gen and c1.imm == imm and c1.key == key and int(c1.a) == a and int(c1.b) == idx and c1.va == va and c1.vb == vb and regs[int(c1.dst)].ver == c1.dver:
            e = int(c1.dst)
    if e >= 0 and ow_vtype(e) == ow_vtype(d): return e
    if regs[d].stable:
        if int(c0.depth) <= ed and c0.sid == sids[int(c0.depth)]: cache[s0 + 1] = c0[0]
        c0[0] = FastLoad(sids[ed], gen, imm, key, i32(a), i32(idx), i32(d), i32(ed), va, vb, regs[d].ver)
    -1

fl_checked_const = (op: Op, mode: int, av0: int, bv0: int) -> (bool, int):
    raw = if op == .checked_add: Op.add else if op == .checked_sub: Op.sub else: Op.mul
    operation = if op == .checked_add: 0 else if op == .checked_sub: 1 else: 2
    overflow = false
    if (mode & 1) != 0:
        av = av0 as u64
        bv = bv0 as u64
        overflow = if operation == 0: av + bv < av else if operation == 1: av < bv else: bv != 0 and av > (u64(18446744073709551615) / bv)
    else:
        overflow = ow_word_overflow(operation, av0, bv0)
    _, val = ow_fold(raw, av0, bv0)
    if (mode & 32) != 0:
        overflow = overflow or (if (mode & 1) != 0: val < 0 or val > 4294967295 else: val < -2147483648 or val > 2147483647)
    if overflow: return (false, 0)
    (true, val)

fl_bin_const_b = (op: Op, a: int, k: int) -> int:
    if (op == .lts and k == OW_MIN_INT) or (op == .gts and k == 9223372036854775807) or (op == .ltu and k == 0): return 0
    if (op == .ges and k == OW_MIN_INT) or (op == .les and k == 9223372036854775807) or (op == .geu and k == 0): return 1
    if (k == 0 and (op == .mul or op == .and_)) or (k == 1 and (op == .rems or op == .remu)): return 0
    if op == .lts or op == .les or op == .gts or op == .ges or op == .ltu or op == .leu or op == .gtu or op == .geu:
        regs = o_regs
        if fl_def_is(a, 11) and regs[int(regs[a].db)].constant:
            limit = regs[int(regs[a].db)].cval
            if limit >= 0:
                _, lov = ow_fold(op, 0, k)
                _, hiv = ow_fold(op, limit, k)
                if lov == hiv: return lov
    -1

fl_p2_checked = (cur_p: *Ins, w_ins: *Ins, regs: *OptReg, vt: *i8, sids: *int, depth: int, loop_depth: int) -> int:
    op = cur_p.op
    a = fl_repl(regs, sids, depth, int(cur_p.a))
    b = fl_repl(regs, sids, depth, int(cur_p.b))
    d = int(cur_p.dst)
    if regs[a].constant and regs[b].constant:
        ok, val = fl_checked_const(op, int(cur_p.c), regs[a].cval, regs[b].cval)
        if ok:
            if regs[d].stable: regs[d].constant = true; regs[d].cval = val
            else: regs[d].ver += 1
            if loop_depth > 0 and (val < -2147483648 or val > 2147483647): opt_has_big_loop_const = true
            w_ins[0] = Ins(.iconst, 0, cur_p.dst, 0, 0, 0, val)
            return 1
    if regs[b].constant and ((op != .checked_mul and regs[b].cval == 0) or (op == .checked_mul and (regs[b].cval == 0 or regs[b].cval == 1))):
        if op == .checked_mul and regs[b].cval == 0:
            if regs[d].stable: regs[d].constant = true; regs[d].cval = 0
            else: regs[d].ver += 1
            w_ins[0] = Ins(.iconst, 0, cur_p.dst, 0, 0, 0, 0)
            return 1
        vtd = int(vt[d]); vta = int(vt[a])
        if regs[d].stable and (if vtd == 3: 0 else: vtd) == (if vta == 3: 0 else: vta):
            if regs[a].stable:
                regs[d].repl = i32(a)
                if regs[a].constant: regs[d].constant = true; regs[d].cval = regs[a].cval
                return 0
            if depth < 128: regs[d].dop = 3; regs[d].da = i32(a); regs[d].db = i32(depth); regs[d].dva = regs[a].ver; regs[d].dvb = i32(sids[depth])
        if not regs[d].stable: regs[d].ver += 1
        regs[a].nuse += 1
        w_ins[0] = Ins(.mov, 0, cur_p.dst, i32(a), 0, 0, 0)
        return 1
    if w_ins != cur_p: w_ins[0] = cur_p[0]
    w_ins.a = i32(a)
    w_ins.b = i32(b)
    regs[a].nuse += 1
    regs[b].nuse += 1
    if d >= 0:
        if regs[d].stable:
            regs[d].dop = i32(oc_tag(cur_p))
            regs[d].da = i32(a); regs[d].db = i32(b)
            regs[d].dva = regs[a].ver; regs[d].dvb = regs[b].ver
        else: regs[d].ver += 1
    1

fl_p2_unary = (cur_p: *Ins, w_ins: *Ins, regs: *OptReg, vt: *i8, dec: *int, sids: *int, depth: int, loop_depth: int) -> int:
    op = cur_p.op
    if op == .fneg: opt_has_vec_cand = true; opt_has_float_op = true
    tag = oc_tag(cur_p)
    dw = dec[tag]
    a = fl_repl(regs, sids, depth, int(cur_p.a))
    kind = (dw >> 16) & 15
    if kind == 3 and cur_p.ty == 0:
        d = int(cur_p.dst)
        ebit = ow_ext_bit(op)
        if ebit != 0 and (fl_width_mask(a) & ebit) != 0:
            vtd = int(vt[d]); vta = int(vt[a])
            if regs[d].stable and (if vtd == 3: 0 else: vtd) == (if vta == 3: 0 else: vta):
                if regs[a].stable:
                    regs[d].repl = i32(a)
                    if regs[a].constant: regs[d].constant = true; regs[d].cval = regs[a].cval
                    return 0
                if depth < 128: regs[d].dop = 3; regs[d].da = i32(a); regs[d].db = i32(depth); regs[d].dva = regs[a].ver; regs[d].dvb = i32(sids[depth])
            if not regs[d].stable: regs[d].ver += 1
            regs[a].nuse += 1
            w_ins[0] = Ins(.mov, 0, cur_p.dst, i32(a), 0, 0, 0)
            return 1
        if regs[a].constant:
            ok, v = ow_fold_un(op, regs[a].cval)
            if ok:
                if regs[d].stable: regs[d].constant = true; regs[d].cval = v
                else: regs[d].ver += 1
                if loop_depth > 0 and (v < -2147483648 or v > 2147483647): opt_has_big_loop_const = true
                w_ins[0] = Ins(.iconst, 0, cur_p.dst, 0, 0, 0, v)
                return 1
    if w_ins != cur_p: w_ins[0] = cur_p[0]
    w_ins.a = i32(a)
    regs[a].nuse += 1
    if (dw & 1) != 0 and w_ins.dst >= 0:
        d = int(w_ins.dst)
        if regs[d].stable:
            regs[d].dop = i32(tag)
            regs[d].da = i32(a)
            regs[d].dva = regs[a].ver
        else: regs[d].ver += 1
    else if (dw & 4) != 0: o_gen += 1; o_genf += 1; o_genh += 1
    1

fl_p2_calli = (cur_p: *Ins, w_ins: *Ins, regs: *OptReg, args: *i32, sids: *int, depth: int):
    op = cur_p.op
    a0 = int(cur_p.a)
    loop k in [a0..a0 + int(cur_p.b)):
        u = fl_repl(regs, sids, depth, int(args[k]))
        args[k] = i32(u)
        regs[u].nuse += 1
    c = fl_repl(regs, sids, depth, int(cur_p.c))
    if w_ins != cur_p: w_ins[0] = cur_p[0]
    if op == .calli and regs[c].stable and regs[c].dop == 65:
        w_ins.op = .call
        w_ins.imm = regs[c].cval
        w_ins.c = 0
    else:
        w_ins.c = i32(c)
        regs[c].nuse += 1
    if w_ins.dst >= 0 and not regs[int(w_ins.dst)].stable:
        regs[int(w_ins.dst)].ver += 1
    o_gen += 1; o_genf += 1; o_genh += 1

fl_p2_tri = (cur_p: *Ins, w_ins: *Ins, regs: *OptReg, vt: *i8, dec: *int, sids: *int, depth: int, loop_depth: int) -> int:
    op = cur_p.op
    tag = oc_tag(cur_p)
    dw = dec[tag]
    a = fl_repl(regs, sids, depth, int(cur_p.a))
    b = fl_repl(regs, sids, depth, int(cur_p.b))
    c = fl_repl(regs, sids, depth, int(cur_p.c))
    if op == .select:
        fv = if loop_depth > 0: fl_fact(a, depth, sids) else: -1
        if b == c or regs[a].constant or fv >= 0:
            val = if b == c or (regs[a].constant and regs[a].cval != 0) or fv == 1: b else: c
            d = int(cur_p.dst)
            vtd = int(vt[d]); vtv = int(vt[val])
            if regs[d].stable and (if vtd == 3: 0 else: vtd) == (if vtv == 3: 0 else: vtv):
                if regs[val].stable:
                    regs[d].repl = i32(val)
                    if regs[val].constant: regs[d].constant = true; regs[d].cval = regs[val].cval
                    return 0
                if depth < 128: regs[d].dop = 3; regs[d].da = i32(val); regs[d].db = i32(depth); regs[d].dva = regs[val].ver; regs[d].dvb = i32(sids[depth])
            if not regs[d].stable: regs[d].ver += 1
            regs[val].nuse += 1
            w_ins[0] = Ins(.mov, cur_p.ty, cur_p.dst, i32(val), 0, 0, 0)
            return 1
    if w_ins != cur_p: w_ins[0] = cur_p[0]
    w_ins.a = i32(a); w_ins.b = i32(b); w_ins.c = i32(c)
    regs[a].nuse += 1
    regs[b].nuse += 1
    regs[c].nuse += 1
    if (op == .memeq or op == .streq) and regs[int(w_ins.dst)].stable:
        regs[int(w_ins.dst)].dop = i32(tag)
    if (dw & 1) != 0 and w_ins.dst >= 0 and not regs[int(w_ins.dst)].stable:
        regs[int(w_ins.dst)].ver += 1
    if (dw & 4) != 0: o_gen += 1; o_genf += 1; o_genh += 1
    1

fl_p2_assume = (cur_p: *Ins, cache: *FastLoad, sids: *int, ctl_p: *OptControl, ed_p: *int, ctl_n: int, depth: int, nbr: int):
    regs = o_regs
    a = fl_repl(regs, sids, depth, int(cur_p.a))
    kv = fl_kconst(1)
    regs = o_regs
    key = (59 << 24) | (8 | 64)
    gen = if opt_raw_mem: o_gen else: o_genh
    ed = if ctl_n > 0 and ctl_p[ctl_n - 1].kind == 3 and ctl_p[ctl_n - 1].branches == nbr: ed_p[ctl_n - 1] else: depth
    fl_cache_put(cache, sids, ed, gen, 0, key, a, 0, i32(kv), regs[a].ver, 0, regs[kv].ver)

fl_p2_ctl_n = 0
fl_p2_nbr = 0

fl_p2_bin_cold = (cur_p: *Ins, w_ins: *Ins, a0: int, b0: int, depth: int, loop_depth: int) -> int:
    op = cur_p.op
    a = a0
    b = b0
    d = int(cur_p.dst)
    regs = o_regs
    vt = opt_vtypes
    sids = fl_sid_p
    ra = regs + a
    rb = regs + b
    rd = regs + d
    if ra.constant and rb.constant:
        ok, fval = ow_fold(op, ra.cval, rb.cval)
        if ok:
            if rd.stable: rd.constant = true; rd.cval = fval
            else: rd.ver += 1
            if loop_depth > 0 and (fval < -2147483648 or fval > 2147483647): opt_has_big_loop_const = true
            w_ins[0] = Ins(.iconst, 0, cur_p.dst, 0, 0, 0, fval)
            return 1
    if ra.constant and not rb.constant:
        if ow_commutes(op): t = a; a = b; b = t; rt = ra; ra = rb; rb = rt
        else:
            m = ow_mirror(op)
            if m != op: op = m; t = a; a = b; b = t; rt = ra; ra = rb; rb = rt
    if a == b:
        known = if op == .eq or op == .les or op == .ges or op == .leu or op == .geu: 1 else if op == .ne or op == .lts or op == .gts or op == .ltu or op == .gtu: 0 else: -1
        if known >= 0:
            if rd.stable: rd.constant = true; rd.cval = known
            else: rd.ver += 1
            w_ins[0] = Ins(.iconst, 0, cur_p.dst, 0, 0, 0, known)
            return 1
    if rb.constant:
        k = rb.cval
        known = -1
        if k == 0 and (op == .mul or op == .and_): known = 0
        else:
            tag = oc_tag(cur_p)
            if (tag >= 21 and tag <= 28) or tag == 9 or tag == 10: known = fl_bin_const_b(op, a, k)
        if known >= 0:
            if rd.stable: rd.constant = true; rd.cval = known
            else: rd.ver += 1
            w_ins[0] = Ins(.iconst, 0, cur_p.dst, 0, 0, 0, known)
            return 1
        if (k == 0 and (op == .add or op == .sub or op == .or_ or op == .xor or op == .shl or op == .shrs or op == .shru)) or (k == 1 and (op == .mul or op == .divs or op == .divu)) or (op == .and_ and k == -1):
            vtd = int(vt[d]); vta = int(vt[a])
            if rd.stable and (if vtd == 3: 0 else: vtd) == (if vta == 3: 0 else: vta):
                if ra.stable:
                    rd.repl = i32(a)
                    if ra.constant: rd.constant = true; rd.cval = ra.cval
                    return 0
                if depth < 128: rd.dop = 3; rd.da = i32(a); rd.db = i32(depth); rd.dva = ra.ver; rd.dvb = i32(sids[depth])
            if not rd.stable: rd.ver += 1
            ra.nuse += 1
            w_ins[0] = Ins(.mov, 0, cur_p.dst, i32(a), 0, 0, 0)
            return 1
        if op == .add and fl_def_is(a, 4) and regs[int(ra.db)].constant:
            k2 = k + regs[int(ra.db)].cval
            base0 = int(ra.da)
            b = fl_kconst(k2)
            regs = o_regs; vt = opt_vtypes
            a = base0; ra = regs + a; rb = regs + b; rd = regs + d
        else if op == .mul:
            sh = ow_log2_exact(k)
            if sh > 0:
                op = .shl
                b = fl_kconst(sh)
                regs = o_regs; vt = opt_vtypes
                ra = regs + a; rb = regs + b; rd = regs + d
        else if op == .divu or op == .remu:
            if k > 1:
                sh = ow_log2_exact(k)
                if sh > 0:
                    if op == .divu:
                        op = .shru
                        b = fl_kconst(sh)
                        regs = o_regs; vt = opt_vtypes
                        ra = regs + a; rb = regs + b; rd = regs + d
                    else if ow_fits32(k - 1):
                        op = .and_
                        b = fl_kconst(k - 1)
                        regs = o_regs; vt = opt_vtypes
                        ra = regs + a; rb = regs + b; rd = regs + d
                    else: fl_has_const_div = true
                else if opt_mulh_ok: fl_has_const_div = true
        else if op == .divs or op == .rems:
            if k > 1:
                sh = ow_log2_exact(k)
                if sh > 0 or opt_mulh_ok: fl_has_const_div = true
    if loop_depth > 0 and depth < 128 and (op == .add or op == .mul or op == .shl or op == .eq or op == .ne or op == .geu):
        if op == .eq or op == .ne:
            opp = if op == .eq: Op.ne else: Op.eq
            fv = fl_bin_lookup_fact(fl_cache_p, sids, depth, opp, a, b)
            if fv >= 0:
                kv = 1 - fv
                if rd.stable: rd.constant = true; rd.cval = kv
                else: rd.ver += 1
                w_ins[0] = Ins(.iconst, 0, cur_p.dst, 0, 0, 0, kv)
                return 1
        ctl_p = o_ctl_p
        ctl_n = fl_p2_ctl_n
        ed = if ctl_n > 0 and ctl_p[ctl_n - 1].kind == 3 and ctl_p[ctl_n - 1].branches == fl_p2_nbr: fl_blk_start_p[ctl_n - 1] else: depth
        e = fl_bin_cse(fl_cache_p, sids, depth, ed, op, a, b, d)
        if e >= 0:
            if rd.stable:
                rd.repl = i32(e)
                if regs[e].constant: rd.constant = true; rd.cval = regs[e].cval
                return 0
            rd.ver += 1
            regs[e].nuse += 1
            vtd = int(vt[d])
            w_ins[0] = Ins(.mov, i32(if vtd == 3: 0 else: vtd), cur_p.dst, i32(e), 0, 0, 0)
            return 1
    if w_ins != cur_p: w_ins[0] = cur_p[0]
    w_ins.op = op
    w_ins.a = i32(a)
    w_ins.b = i32(b)
    ra.nuse += 1
    rb.nuse += 1
    if d >= 0:
        if rd.stable:
            rd.dop = i32(oc_tag(w_ins))
            rd.da = i32(a); rd.db = i32(b)
            rd.dva = ra.ver; rd.dvb = rb.ver
        else: rd.ver += 1
    1

fl_pass2 = () -> int:
    ncode = opt_input_count
    input = opt_input
    dec = opt_decode
    regs = o_regs
    args = opt_args
    vt = opt_vtypes
    if fl_ctl_cap_g < 256 or o_ctl.len() < 256 or fl_cache.len() < 256 or fl_sid.len() < 256 or fl_blk_start.len() < o_ctl.len(): fl_ensure_pass2()
    cache = fl_cache_p
    sids = fl_sid_p
    ctl_p = o_ctl_p
    ed_p = fl_blk_start_p
    ctl_cap = fl_ctl_cap_g
    ctl_n = 0
    nsid = fl_next_sid + 1
    sids[0] = nsid
    o_gen = 0
    o_genf = 0
    o_genh = 0
    if o_join_regs.len() > 0: __set_len(o_join_regs, 0)
    if o_join_next.len() > 0: __set_len(o_join_next, 0)
    skip = 0
    dead = 0
    depth = 0
    loop_depth = 0
    fl_saw_loop = false
    nbr = 0
    w = 0
    loop pos in [0..ncode):
        cur_p = input + pos
        w_ins = input + w
        op = cur_p.op
        if (skip | dead) != 0:
            if skip > 0:
                if op == .block or op == .loop or op == .if_: skip += 1
                if op == .loop: lp_next += 1
                else if op == .else_ and skip == 1 and ctl_p[ctl_n - 1].kind == 2:
                    skip = 0
                    if depth < 128: nsid += 1; sids[depth] = nsid
                else if op == .end:
                    skip -= 1
                    if skip == 0:
                        ctl_n -= 1
                        if ctl_p[ctl_n].deferred >= 0: ow_join_kill(ctl_p[ctl_n].deferred)
                        depth -= 1
                        if w > 0 and (input[w - 1].op == .block or input[w - 1].op == .if_):
                            if input[w - 1].op == .if_: regs[int(input[w - 1].a)].nuse -= 1
                            w -= 1
                        else:
                            if w != pos: w_ins[0] = cur_p[0]
                            w += 1
                continue
            if op == .block or op == .loop or op == .if_:
                dead += 1
                if op == .loop: lp_next += 1
                continue
            if op == .else_ and dead == 1: dead = 0
            else if op == .end:
                dead -= 1
                if dead > 0: continue
            else: continue
        match op:
            nop: pass
            fconst, gaddr, daddr, vzu:
                if (dec[oc_tag(cur_p)] & 1) != 0 and cur_p.dst >= 0 and not regs[int(cur_p.dst)].stable:
                    regs[int(cur_p.dst)].ver += 1
                if w != pos: w_ins[0] = cur_p[0]
                w += 1
            slot:
                d = int(cur_p.dst)
                if loop_depth > 0 and depth < 128:
                    ed = if ctl_n > 0 and ctl_p[ctl_n - 1].kind == 3 and ctl_p[ctl_n - 1].branches == nbr: ed_p[ctl_n - 1] else: depth
                    e = fl_slot_cse(cache, sids, depth, ed, int(cur_p.a), d)
                    if e >= 0:
                        if regs[d].stable: regs[d].repl = i32(e); continue
                        regs[d].ver += 1
                        regs[e].nuse += 1
                        w_ins[0] = Ins(.mov, 0, cur_p.dst, i32(e), 0, 0, 0)
                        w += 1
                        continue
                if not regs[d].stable: regs[d].ver += 1
                if w != pos: w_ins[0] = cur_p[0]
                w += 1
            faddr:
                d = int(cur_p.dst)
                if regs[d].stable: regs[d].dop = 65; regs[d].cval = cur_p.imm
                else: regs[d].ver += 1
                if w != pos: w_ins[0] = cur_p[0]
                w += 1
            iconst:
                d = int(cur_p.dst)
                if regs[d].stable:
                    regs[d].constant = true
                    regs[d].cval = cur_p.imm
                else: regs[d].ver += 1
                if loop_depth > 0 and (cur_p.imm < -2147483648 or cur_p.imm > 2147483647): opt_has_big_loop_const = true
                if w != pos: w_ins[0] = cur_p[0]
                w += 1
            mov:
                a = fl_repl(regs, sids, depth, int(cur_p.a))
                d = int(cur_p.dst)
                if a == d: continue
                if regs[d].stable:
                    vtd = int(vt[d]); td = if vtd == 3: 0 else: vtd
                    vta = int(vt[a]); ta = if vta == 3: 0 else: vta
                    if td == ta:
                        if regs[a].stable:
                            regs[d].repl = i32(a)
                            if regs[a].constant:
                                regs[d].constant = true
                                regs[d].cval = regs[a].cval
                            continue
                        if depth < 128:
                            regs[d].dop = 3; regs[d].da = i32(a); regs[d].db = i32(depth)
                            regs[d].dva = regs[a].ver; regs[d].dvb = i32(sids[depth])
                    if regs[a].constant and td == 0:
                        kv = regs[a].cval
                        if loop_depth > 0 and (kv < -2147483648 or kv > 2147483647): opt_has_big_loop_const = true
                        w_ins[0] = Ins(.iconst, 0, cur_p.dst, 0, 0, 0, kv)
                        w += 1
                        continue
                else:
                    regs[d].ver += 1
                    if regs[a].constant:
                        vtd = int(vt[d])
                        if vtd == 0 or vtd == 3:
                            kv = regs[a].cval
                            if loop_depth > 0 and (kv < -2147483648 or kv > 2147483647): opt_has_big_loop_const = true
                            w_ins[0] = Ins(.iconst, 0, cur_p.dst, 0, 0, 0, kv)
                            w += 1
                            continue
                if w != pos: w_ins[0] = cur_p[0]
                w_ins.a = i32(a)
                regs[a].nuse += 1
                w += 1
            add, sub, mul, divs, divu, rems, remu, and_, or_, xor, shl, shrs, shru, rot32, eq, ne, lts, les, gts, ges, ltu, leu, gtu, geu, overflow_add, overflow_sub, overflow_mul:
                a = fl_repl(regs, sids, depth, int(cur_p.a))
                b = fl_repl(regs, sids, depth, int(cur_p.b))
                d = int(cur_p.dst)
                ra = regs + a
                rb = regs + b
                rd = regs + d
                if cur_p.ty == 0 and (ra.constant or rb.constant or a == b or (loop_depth > 0 and ((0x10184050 >> (int((cur_p as *u32)[0]) & 63)) & 1) != 0)):
                    if loop_depth > 0: fl_p2_ctl_n = ctl_n; fl_p2_nbr = nbr
                    kept = fl_p2_bin_cold(cur_p, w_ins, a, b, depth, loop_depth)
                    regs = o_regs; vt = opt_vtypes
                    if kept != 0: w += 1
                    continue
                if w != pos: w_ins[0] = cur_p[0]
                w_ins.a = i32(a)
                w_ins.b = i32(b)
                ra.nuse += 1
                rb.nuse += 1
                if d >= 0:
                    if rd.stable:
                        rd.dop = i32(oc_tag(w_ins))
                        rd.da = i32(a); rd.db = i32(b)
                        rd.dva = ra.ver; rd.dvb = rb.ver
                    else: rd.ver += 1
                w += 1
            checked_add, checked_sub, checked_mul:
                if fl_p2_checked(cur_p, w_ins, regs, vt, sids, depth, loop_depth) != 0: w += 1
            load:
                a = fl_repl(regs, sids, depth, int(cur_p.a))
                mode = int(cur_p.c)
                imm = cur_p.imm
                idx_r = if (mode & 128) != 0: fl_repl(regs, sids, depth, int(cur_p.b)) else: 0
                if regs[a].stable and int(regs[a].dop) == 4:
                    fl_fold_addr(a, imm, mode, idx_r)
                d = int(cur_p.dst)
                if depth < 128 and loop_depth > 0:
                    ed = if ctl_n > 0 and ctl_p[ctl_n - 1].kind == 3 and ctl_p[ctl_n - 1].branches == nbr: ed_p[ctl_n - 1] else: depth
                    e = fl_load_cse(cache, sids, depth, ed, a, idx_r, imm, mode, int(cur_p.ty), d)
                    if e >= 0:
                        if regs[d].stable:
                            regs[d].repl = i32(e)
                            if regs[e].constant: regs[d].constant = true; regs[d].cval = regs[e].cval
                            continue
                        regs[d].ver += 1
                        regs[e].nuse += 1
                        vtd = int(vt[d])
                        w_ins[0] = Ins(.mov, i32(if vtd == 3: 0 else: vtd), cur_p.dst, i32(e), 0, 0, 0)
                        w += 1
                        continue
                if regs[d].stable: regs[d].dop = 59; regs[d].da = i32(mode)
                else: regs[d].ver += 1
                regs[a].nuse += 1
                if (mode & 128) != 0:
                    opt_has_vec_cand = true
                    regs[idx_r].nuse += 1
                if w != pos: w_ins[0] = cur_p[0]
                w_ins.a = i32(a)
                if (mode & 128) != 0: w_ins.b = i32(idx_r)
                w_ins.c = i32(mode)
                w_ins.imm = imm
                w += 1
            store:
                a = fl_repl(regs, sids, depth, int(cur_p.a))
                b = fl_repl(regs, sids, depth, int(cur_p.b))
                mode = int(cur_p.c)
                imm = cur_p.imm
                ty = int(cur_p.ty)
                idx_r = if (mode & 128) != 0: fl_repl(regs, sids, depth, int(cur_p.dst)) else: 0
                if regs[a].stable and int(regs[a].dop) == 4:
                    fl_fold_addr(a, imm, mode, idx_r)
                if opt_raw_mem: o_gen += 1; o_genf += 1; o_genh += 1
                else if (mode & 64) != 0: o_genh += 1
                else if (mode & 32) != 0: o_genf += 1
                else: o_gen += 1
                if depth < 128 and loop_depth > 0 and ((mode & 15) == 8 or (mode & 32) != 0) and regs[b].stable:
                    key = (59 << 24) | (ty << 16) | (mode & 4095)
                    gen = if opt_raw_mem: o_gen else if (mode & 64) != 0: o_genh else if (mode & 32) != 0: o_genf else: o_gen
                    va = regs[a].ver
                    vb = if (mode & 128) != 0: regs[idx_r].ver else: i32(0)
                    ed = if ctl_n > 0 and ctl_p[ctl_n - 1].kind == 3 and ctl_p[ctl_n - 1].branches == nbr: ed_p[ctl_n - 1] else: depth
                    fl_cache_put(cache, sids, ed, gen, imm, key, a, idx_r, i32(b), va, vb, regs[b].ver)
                regs[a].nuse += 1
                regs[b].nuse += 1
                if (mode & 128) != 0: regs[idx_r].nuse += 1
                if w != pos: w_ins[0] = cur_p[0]
                w_ins.a = i32(a)
                w_ins.b = i32(b)
                w_ins.c = i32(mode)
                w_ins.imm = imm
                if (mode & 128) != 0: w_ins.dst = i32(idx_r)
                w += 1
            zero, neg, not_, fneg, fsqrt, fabs, ffloor, fceil, ftrunc, sext8, sext16, sext32, zext8, zext16, zext32, i2f, u2f, f2i, f2f, bits2f, f2bits, vsplat:
                if fl_p2_unary(cur_p, w_ins, regs, vt, dec, sids, depth, loop_depth) != 0: w += 1
            call, intr, syscall:
                a0 = int(cur_p.a)
                loop k in [a0..a0 + int(cur_p.b)):
                    u = fl_repl(regs, sids, depth, int(args[k]))
                    args[k] = i32(u)
                    regs[u].nuse += 1
                nr = op == .call and cur_p.c == 1
                if cur_p.dst >= 0 and not regs[int(cur_p.dst)].stable:
                    regs[int(cur_p.dst)].ver += 1
                if not nr: o_gen += 1; o_genf += 1; o_genh += 1
                if w != pos: w_ins[0] = cur_p[0]
                w += 1
                if nr: dead = 1
            calli, callc:
                fl_p2_calli(cur_p, w_ins, regs, args, sids, depth)
                w += 1
            ret:
                if w != pos: w_ins[0] = cur_p[0]
                if w_ins.a >= 0:
                    a = fl_repl(regs, sids, depth, int(w_ins.a))
                    w_ins.a = i32(a)
                    regs[a].nuse += 1
                w += 1
                dead = 1
            memcpy, memset, select, vop, memeq, findbyte, scanbytes, findb:
                if fl_p2_tri(cur_p, w_ins, regs, vt, dec, sids, depth, loop_depth) != 0: w += 1
            vst:
                a = fl_repl(regs, sids, depth, int(cur_p.a))
                b = fl_repl(regs, sids, depth, int(cur_p.b))
                ud = fl_repl(regs, sids, depth, int(cur_p.dst))
                if w != pos: w_ins[0] = cur_p[0]
                w_ins.a = i32(a); w_ins.b = i32(b); w_ins.dst = i32(ud)
                regs[a].nuse += 1
                regs[b].nuse += 1
                regs[ud].nuse += 1
                w += 1
            br, trap:
                if op == .br: nbr += 1
                if w != pos: w_ins[0] = cur_p[0]
                w += 1
                dead = 1
            brtable:
                a = fl_repl(regs, sids, depth, int(cur_p.a))
                if w != pos: w_ins[0] = cur_p[0]
                w_ins.a = i32(a)
                regs[a].nuse += 1
                nbr += 1
                w += 1
                dead = 1
            assume:
                if depth < 128 and loop_depth > 0 and cur_p.imm == 1:
                    fl_p2_assume(cur_p, cache, sids, ctl_p, ed_p, ctl_n, depth, nbr)
                    regs = o_regs; vt = opt_vtypes
            block:
                ed = if ctl_n > 0 and ctl_p[ctl_n - 1].kind == 3 and ctl_p[ctl_n - 1].branches == nbr: ed_p[ctl_n - 1] else: depth
                if ctl_n >= ctl_cap:
                    fl_grow_ctl()
                    ctl_p = o_ctl_p; ed_p = fl_blk_start_p; ctl_cap = fl_ctl_cap_g
                cp = ctl_p + ctl_n
                cp.kind = 3; cp.condition = -1; cp.branches = nbr; cp.deferred = -1
                ed_p[ctl_n] = ed
                ctl_n += 1
                depth += 1
                if depth < 128: nsid += 1; sids[depth] = nsid
                if w != pos: w_ins[0] = cur_p[0]
                w += 1
            loop:
                ow_enter_loop()
                if ctl_n >= ctl_cap:
                    fl_grow_ctl()
                    ctl_p = o_ctl_p; ed_p = fl_blk_start_p; ctl_cap = fl_ctl_cap_g
                cp = ctl_p + ctl_n
                cp.kind = 4; cp.condition = -1; cp.branches = nbr; cp.deferred = -1
                ed_p[ctl_n] = depth
                ctl_n += 1
                loop_depth += 1
                fl_saw_loop = true
                depth += 1
                if depth < 128: nsid += 1; sids[depth] = nsid
                if w != pos: w_ins[0] = cur_p[0]
                w += 1
            if_:
                c = fl_repl(regs, sids, depth, int(cur_p.a))
                fv = if loop_depth > 0: fl_fact(c, depth, sids) else: -1
                if ctl_n >= ctl_cap:
                    fl_grow_ctl()
                    ctl_p = o_ctl_p; ed_p = fl_blk_start_p; ctl_cap = fl_ctl_cap_g
                cp = ctl_p + ctl_n
                if regs[c].constant or fv >= 0:
                    w_ins[0] = Ins(.block, 0, 0, 0, 0, 0, 0)
                    w += 1
                    depth += 1
                    if depth < 128: nsid += 1; sids[depth] = nsid
                    cp.condition = -1; cp.branches = nbr; cp.deferred = -1
                    if (regs[c].constant and regs[c].cval != 0) or fv == 1: cp.kind = 1
                    else: cp.kind = 2; skip = 1
                    ed_p[ctl_n] = depth
                    ctl_n += 1
                else:
                    cp.kind = 0; cp.condition = c; cp.branches = nbr; cp.deferred = -1
                    ed_p[ctl_n] = depth
                    ctl_n += 1
                    depth += 1
                    if depth < 128: nsid += 1; sids[depth] = nsid
                    if loop_depth > 0: fl_set_fact(c, depth, sids, 1)
                    if w != pos: w_ins[0] = cur_p[0]
                    w_ins.a = i32(c)
                    regs[c].nuse += 1
                    w += 1
            else_:
                top = ctl_n - 1
                c = ctl_p[top].condition
                ctl_p[top].condition = -1
                if ctl_p[top].kind == 1: skip = 1
                else:
                    if depth < 128: nsid += 1; sids[depth] = nsid
                    if loop_depth > 0 and c >= 0: fl_set_fact(c, depth, sids, 0)
                    if w != pos: w_ins[0] = cur_p[0]
                    w += 1
            end:
                ctl_n -= 1
                fp = ctl_p + ctl_n
                fr_kind = fp.kind
                fr_cond = fp.condition
                fr_br = fp.branches
                if fr_kind == 4: loop_depth -= 1
                if fp.deferred >= 0: ow_join_kill(fp.deferred)
                if loop_depth > 0 and w > 0 and fr_kind == 3 and fr_cond >= 0 and fr_br + 2 == nbr and input[w - 1].op == .br and input[w - 1].imm > 0:
                    target = ctl_n - int(input[w - 1].imm)
                    if target >= 0:
                        bd = fl_branch_copy(input, w)
                        if bd >= 0:
                            regs[bd].ver -= 1
                            o_join_regs.push(bd)
                            o_join_next.push(ctl_p[target].deferred)
                            ctl_p[target].deferred = o_join_regs.len() - 1
                depth -= 1
                terminates = false
                if w > 0:
                    lop = input[w - 1].op
                    if lop == .block: w -= 1; continue
                    if lop == .if_:
                        regs[int(input[w - 1].a)].nuse -= 1
                        w -= 1
                        continue
                    terminates = lop == .ret or lop == .trap or (lop == .br and input[w - 1].imm > 0) or (lop == .call and input[w - 1].c == 1)
                if w != pos: w_ins[0] = cur_p[0]
                w += 1
                if loop_depth > 0 and terminates and fr_cond >= 0:
                    ed = if ctl_n > 0 and ctl_p[ctl_n - 1].kind == 3 and ctl_p[ctl_n - 1].branches == nbr: ed_p[ctl_n - 1] else: depth
                    if fr_kind == 3 and (fr_br + 1 == nbr or (input[w - 2].op == .br and fr_br + 2 == nbr)): fl_set_fact(fr_cond, ed, sids, 1)
                    else if fr_kind == 0 and (fr_br == nbr or (input[w - 2].op == .br and fr_br + 1 == nbr)): fl_set_fact(fr_cond, ed, sids, 0)
            brif:
                c = fl_repl(regs, sids, depth, int(cur_p.a))
                fv = if loop_depth > 0: fl_fact(c, depth, sids) else: -1
                if regs[c].constant or fv >= 0:
                    if (regs[c].constant and regs[c].cval != 0) or fv == 1:
                        nbr += 1
                        w_ins[0] = Ins(.br, 0, 0, 0, 0, 0, cur_p.imm)
                        w += 1
                        dead = 1
                else:
                    nbr += 1
                    if loop_depth > 0:
                        target = ctl_n - 1 - int(cur_p.imm)
                        if target >= 0 and ctl_p[target].kind == 3: ctl_p[target].condition = c
                        fl_set_fact(c, depth, sids, 0)
                    if w != pos: w_ins[0] = cur_p[0]
                    w_ins.a = i32(c)
                    regs[c].nuse += 1
                    w += 1
            zeroslots:
                o_gen += 1; o_genf += 1; o_genh += 1
                a0 = int(cur_p.a)
                loop k in [a0..a0 + int(cur_p.b)):
                    item = int(args[k])
                    if (item & 1) == 1: regs[item >> 1].ver += 1
                if w != pos: w_ins[0] = cur_p[0]
                w += 1
            _:
                if op == .fadd or op == .fsub or op == .fmul or op == .fdiv: opt_has_vec_cand = true; opt_has_float_op = true
                tag = oc_tag(cur_p)
                dw = dec[tag]
                a = fl_repl(regs, sids, depth, int(cur_p.a))
                b = fl_repl(regs, sids, depth, int(cur_p.b))
                d = int(cur_p.dst)
                if w != pos: w_ins[0] = cur_p[0]
                w_ins.a = i32(a)
                w_ins.b = i32(b)
                regs[a].nuse += 1
                regs[b].nuse += 1
                if d >= 0 and (dw & 1) != 0:
                    if regs[d].stable:
                        regs[d].dop = i32(tag)
                        regs[d].da = i32(a); regs[d].db = i32(b)
                        regs[d].dva = regs[a].ver; regs[d].dvb = regs[b].ver
                    else: regs[d].ver += 1
                else if (dw & 4) != 0: o_gen += 1; o_genf += 1; o_genh += 1
                w += 1
    fl_next_sid = nsid
    opt_has_loops = fl_saw_loop
    w

fl_pass3_dce = (used: int):
    if used <= 0: return
    input = opt_input
    dec = opt_decode
    regs = o_regs
    bi = used - 1
    loop bi >= 0:
        b_ins = input + bi
        dw = dec[oc_tag(b_ins)]
        if (dw & 2) != 0 and regs[int(b_ins.dst)].nuse == 0 and not (b_ins.op == .load and (int(b_ins.c) & 65536) != 0):
            mask = (dw >> 8) & 255
            if mask == 1: regs[int(b_ins.a)].nuse -= 1
            else if mask == 3:
                regs[int(b_ins.a)].nuse -= 1
                regs[int(b_ins.b)].nuse -= 1
            else if mask == 65:
                regs[int(b_ins.a)].nuse -= 1
                if (int(b_ins.c) & 128) != 0: regs[int(b_ins.b)].nuse -= 1
            else if mask == 7:
                regs[int(b_ins.a)].nuse -= 1
                regs[int(b_ins.b)].nuse -= 1
                regs[int(b_ins.c)].nuse -= 1
            b_ins.op = .nop
        bi -= 1

fl_compact_end = (input: *Ins, st: int, bk: Op, w0: int) -> int:
    w = w0
    dec = opt_decode
    regs = o_regs
    if bk == .block and w - st >= 6 and w - st <= 32 and input[st + 1].op == .block:
        selected = oc_if_select(input, st, w)
        if selected >= 0: return selected
    if input[w - 1].op == .mov:
        copied = oc_extreme_select(input, st, w)
        if copied >= 0:
            w = copied
            if w == st + 1: return w
    if input[w - 1].op == .br and input[w - 1].imm == 0: w -= 1
    if w == st + 1: return w - 1
    if bk == .block:
        if w == st + 2 and (dec[oc_tag(input + (w - 1))] & 2) != 0:
            w -= 1
            input[w - 1] = input[w]
            return w
        if w >= 2:
            l2 = input + (w - 1)
            if l2.op == .br and l2.imm >= 1:
                prev = input + (w - 2)
                if prev.op == .brif and prev.imm == 0:
                    c = int(prev.a)
                    if c >= 0 and c < o_reg_count and regs[c].nuse == 1:
                        cd = -1
                        plain = true
                        loop k in [st + 1..w - 2):
                            ek = input + k
                            eo = ek.op
                            if eo == .br or eo == .brif or eo == .brtable or eo == .block or eo == .loop or eo == .if_ or eo == .end or eo == .else_: plain = false
                            if int(ek.dst) == c and (dec[oc_tag(ek)] & 1) != 0: cd = k
                        if plain and cd >= 0 and oc_negate(input[cd].op) != .nop:
                            input[cd].op = oc_negate(input[cd].op)
                            d2 = l2.imm - 1
                            w -= 2
                            loop sk in [st..w - 1): input[sk] = input[sk + 1]
                            w -= 1
                            input[w] = Ins(.brif, 0, 0, i32(c), 0, 0, d2)
                            return w + 1
    else if w >= 2 and input[w - 1].op == .br and input[w - 1].imm >= 1 and input[w - 2].op == .if_:
        limm = input[w - 1].imm
        pa = input[w - 2].a
        w -= 2
        input[w] = Ins(.brif, 0, 0, pa, 0, 0, limm - 1)
        return w + 1
    -1 - w

fl_compact_mov = (input: *Ins, w: int, cur_p: *Ins) -> bool:
    t = int(cur_p.a)
    d = int(cur_p.dst)
    if t == d or t < 0 or t >= o_reg_count or o_regs[t].nuse != 1: return false
    vt = opt_vtypes
    vtt = int(vt[t]); vtd = int(vt[d])
    if (if vtt == 3: 0 else: vtt) != (if vtd == 3: 0 else: vtd): return false
    dec = opt_decode
    ep0 = input + (w - 1)
    etag0 = oc_tag(ep0)
    if int(ep0.dst) == t and (dec[etag0] & 1) != 0:
        eo0 = ep0.op
        rt0 = if eo0 == .checked_add or eo0 == .checked_sub or eo0 == .checked_mul: opt_checked_flags else if eo0 == .call or eo0 == .calli or (eo0 == .callc and ep0.imm >= 0) or eo0 == .syscall or eo0 == .intr: true else: (dec[etag0] & 8) != 0
        if rt0: ep0.dst = i32(d); return true
        return false
    k = w - 1
    elim = if w > 8: w - 8 else: 0
    loop k >= elim:
        ep = input + k
        eo = ep.op
        etag = oc_tag(ep)
        edef = (dec[etag] & 1) != 0
        if int(ep.dst) == t and edef:
            rt = if eo == .checked_add or eo == .checked_sub or eo == .checked_mul: opt_checked_flags else: (dec[etag] & 8) != 0
            if rt: ep.dst = i32(d); return true
            return false
        if eo == .block or eo == .loop or eo == .if_ or eo == .else_ or eo == .end or eo == .br or eo == .brif or eo == .brtable or eo == .zeroslots: return false
        ed = if edef: int(ep.dst) else: -1
        if ed == d or oc_has_use(ep, d) or ed == t: return false
        k -= 1
    false

fl_pass4_compact = (used: int):
    if used <= 0: opt_ir.code.clear(); return
    input = opt_input
    dec = opt_decode
    if fl_blk_cap_g < 256 or fl_blk_kind.len() < fl_blk_start.len(): fl_ensure_blk()
    bs_p = fl_blk_start_p
    bk_p = fl_blk_kind_p
    bcap = fl_blk_cap_g
    bn = 0
    w = 0
    loop j in [0..used):
        cur_p = input + j
        ck = (dec[oc_tag(cur_p)] >> 20) & 15
        if ck == 0:
            if w != j: input[w] = cur_p[0]
            w += 1
            continue
        if ck == 1: continue
        if ck >= 2 and ck <= 4:
            if bn >= bcap:
                fl_grow_blk()
                bs_p = fl_blk_start_p; bk_p = fl_blk_kind_p; bcap = fl_blk_cap_g
            bs_p[bn] = w; bk_p[bn] = cur_p.op; bn += 1
            if w != j: input[w] = cur_p[0]
            w += 1
            continue
        if ck == 6:
            if w > 0:
                bn -= 1
                bk = bk_p[bn]
                if bk != .loop:
                    r = fl_compact_end(input, bs_p[bn], bk, w)
                    if r >= 0: w = r; continue
                    w = -1 - r
        else if ck == 13:
            if w > 0 and fl_compact_mov(input, w, cur_p): continue
        else if ck == 14:
            if w > 0:
                last = input + (w - 1)
                t = int(cur_p.b)
                if last.op == .vop and int(last.a) == t and o_regs[t].nuse == 2 and int(cur_p.imm) == ((int(last.imm) >> 4) & 7) * 4 and oc_sole_slot(input, used, t):
                    last.a = cur_p.a
                    continue
        if w != j: input[w] = cur_p[0]
        w += 1
    __set_len(opt_ir.code, w)

fl_div_kconst = (out: mut Ins[], v: int, loop_depth: int) -> int:
    if ow_fits32(v): return ow_k_vreg(v)
    d = ow_vreg(0)
    if loop_depth > 0: opt_has_big_loop_const = true
    out.push(Ins(.iconst, 0, i32(d), 0, 0, 0, v))
    d

fl_div_bin = (out: mut Ins[], op: Op, d: int, a: int, b: int) -> int:
    out.push(Ins(op, 0, i32(d), i32(a), i32(b), 0, 0))
    d

fl_div_nonneg = (out: Ins[], v0: int) -> bool: ow_nonnegative_in(data(out), out.len(), v0)

fl_expand_const_divs = ():
    code = opt_ir.code
    n = code.len()
    out: Ins[]
    out.reserve(n + 32)
    regs = o_regs
    loop_depth = 0
    nonneg_rem = -1
    kinds: Op[]
    cp = data(code)
    ci = 0
    loop ci < n:
        ins = cp[ci]
        ci += 1
        op = ins.op
        if op == .block or op == .loop or op == .if_:
            if op == .if_ and int(ins.a) >= 0 and int(ins.a) < o_reg_count and regs[int(ins.a)].constant and regs[int(ins.a)].cval == 0:
                scan = ci
                nest = 1
                has_else = false
                loop scan < n and nest > 0:
                    sop = cp[scan].op
                    if sop == .block or sop == .loop or sop == .if_: nest += 1
                    else if sop == .else_ and nest == 1: has_else = true; break
                    else if sop == .end: nest -= 1
                    scan += 1
                if not has_else and nest == 0: ci = scan; continue
            kinds.push(op)
            if op == .loop: loop_depth += 1
            out.push(ins)
            continue
        if op == .end:
            if kinds.len() > 0 and kinds.pop() == .loop: loop_depth -= 1
            out.push(ins)
            continue
        if op == .lts and ins.ty == 0 and nonneg_rem >= 0 and int(ins.a) == nonneg_rem:
            b0 = int(ins.b)
            if b0 >= 0 and b0 < o_reg_count and regs[b0].constant and regs[b0].cval == 0:
                ld = int(ins.dst)
                if ld >= 0 and ld < o_reg_count and (ld >= opt_fast_nv or regs[ld].stable):
                    regs[ld].constant = true; regs[ld].cval = 0
                out.push(Ins(.iconst, 0, ins.dst, 0, 0, 0, 0))
                continue
        if op == .select and int(ins.a) >= 0 and int(ins.a) < o_reg_count and regs[int(ins.a)].constant:
            picked = if regs[int(ins.a)].cval != 0: ins.b else: ins.c
            out.push(Ins(.mov, ins.ty, ins.dst, picked, 0, 0, 0))
            continue
        if (op == .divs or op == .rems or op == .divu or op == .remu) and ins.ty == 0:
            b = int(ins.b)
            if b >= 0 and b < o_reg_count and regs[b].constant:
                k = regs[b].cval
                if k > 1:
                    a = int(ins.a)
                    d = int(ins.dst)
                    sh = ow_log2_exact(k)
                    if sh > 0:
                        if op == .divu:
                            fl_div_bin(out, .shru, d, a, fl_div_kconst(out, sh, loop_depth))
                            continue
                        if op == .remu:
                            fl_div_bin(out, .and_, d, a, fl_div_kconst(out, k - 1, loop_depth))
                            continue
                        if fl_div_nonneg(out, a):
                            if op == .divs: fl_div_bin(out, .shrs, d, a, fl_div_kconst(out, sh, loop_depth))
                            else:
                                fl_div_bin(out, .and_, d, a, fl_div_kconst(out, k - 1, loop_depth))
                                regs = o_regs
                                if d >= 0 and (d >= opt_fast_nv or (d < o_reg_count and regs[d].stable)): nonneg_rem = d
                            regs = o_regs
                            continue
                        t1 = fl_div_bin(out, .shrs, ow_vreg(0), a, fl_div_kconst(out, 63, loop_depth))
                        t2 = fl_div_bin(out, .shru, ow_vreg(0), t1, fl_div_kconst(out, 64 - sh, loop_depth))
                        t3 = fl_div_bin(out, .add, ow_vreg(0), a, t2)
                        if op == .divs: fl_div_bin(out, .shrs, d, t3, fl_div_kconst(out, sh, loop_depth))
                        else:
                            t4 = fl_div_bin(out, .and_, ow_vreg(0), t3, fl_div_kconst(out, -k, loop_depth))
                            fl_div_bin(out, .sub, d, a, t4)
                        continue
                    if opt_mulh_ok:
                        if op == .divs or op == .rems:
                            mag, s = ow_div_magic(k)
                            plain = fl_div_nonneg(out, a)
                            q = fl_div_bin(out, .mulhs, ow_vreg(0), a, fl_div_kconst(out, mag, loop_depth))
                            if mag < 0: q = fl_div_bin(out, .add, ow_vreg(0), q, a)
                            if s > 0: q = fl_div_bin(out, .shrs, ow_vreg(0), q, fl_div_kconst(out, s, loop_depth))
                            qq = q
                            if not plain:
                                neg = fl_div_bin(out, .shru, ow_vreg(0), a, fl_div_kconst(out, 63, loop_depth))
                                qq = fl_div_bin(out, .add, (if op == .divs: d else: ow_vreg(0)), q, neg)
                            else if op == .divs:
                                fl_div_bin(out, .mov, d, q, 0)
                            if op == .rems:
                                t = fl_div_bin(out, .mul, ow_vreg(0), qq, fl_div_kconst(out, k, loop_depth))
                                fl_div_bin(out, .sub, d, a, t)
                                regs = o_regs
                                if plain and d >= 0 and (d >= opt_fast_nv or (d < o_reg_count and regs[d].stable)): nonneg_rem = d
                            regs = o_regs
                            continue
                        mag, s, add = ow_divu_magic(u64(k))
                        qd = if op == .remu: ow_vreg(0) else: d
                        t = fl_div_bin(out, .mulhu, ow_vreg(0), a, fl_div_kconst(out, int(mag), loop_depth))
                        if add:
                            q1 = fl_div_bin(out, .sub, ow_vreg(0), a, t)
                            q2 = fl_div_bin(out, .shru, ow_vreg(0), q1, fl_div_kconst(out, 1, loop_depth))
                            if s > 1:
                                q3 = fl_div_bin(out, .add, ow_vreg(0), q2, t)
                                fl_div_bin(out, .shru, qd, q3, fl_div_kconst(out, s - 1, loop_depth))
                            else:
                                fl_div_bin(out, .add, qd, q2, t)
                        else:
                            fl_div_bin(out, .shru, qd, t, fl_div_kconst(out, s, loop_depth))
                        if op == .remu:
                            m = fl_div_bin(out, .mul, ow_vreg(0), qd, fl_div_kconst(out, k, loop_depth))
                            fl_div_bin(out, .sub, d, a, m)
                        continue
        out.push(ins)
    opt_ir.code = out
    opt_vtypes = data(opt_ir.vtypes)

# Fast in-place default-mode optimizer for loop functions; multi-instruction
# constant divisions expand in one compact post-pass only when present.
opt_fast_loop = ():
    fl_pass1()
    used = fl_pass2()
    fl_pass3_dce(used)
    fl_pass4_compact(used)
    if fl_has_const_div: fl_expand_const_divs()

opt_rewrite = ():
    o_nonnegative_remainder = -1
    opt_args = data(opt_ir.args)
    opt_vtypes = data(opt_ir.vtypes)
    opt_fast_nv = opt_ir.vtypes.len()
    opt_input_count = opt_ir.code.len()
    opt_nparams = opt_ir.nparams
    opt_raw_mem = opt_ir.raw_mem
    if not opt_allow_cse and not opt_no_fast_straight:
        input0 = data(opt_ir.code)
        has_loop = false
        loop pos in [0..opt_input_count):
            if input0[pos].op == .loop: has_loop = true; break
        if not has_loop:
            opt_has_loops = false
            opt_fast_straight()
            return
    # The outer transfer uses slot 0. Strength reduction uses slot 1 with
    # simplification disabled, so a nested transfer never needs a third slot.
    nv = opt_ir.vtypes.len()
    if o_fact_scope.len() < nv * 2:
        nf = nv * 2
        if o_fact_scope.cap() < nf: o_fact_scope.reserve(nf)
        __set_len(o_fact_scope, nf)
        if o_fact_nbr.cap() < nf: o_fact_nbr.reserve(nf)
        __set_len(o_fact_nbr, nf)
    regs0 = o_regs
    loop p in [0..opt_nparams):
        regs0[p].ndef += 1
        regs0[p].stable = true
        regs0[p].defpos = -1
    # constant vregs: one canonical vreg per value
    ow_kmap_reset(64)
    loop v in [0..opt_ir.kval.len()):
        if ow_is_kv(v):
            regs0[v].ndef += 1
            regs0[v].stable = true
            regs0[v].constant = true
            regs0[v].cval = opt_ir.kval[v]
            c = ow_kmap_get(opt_ir.kval[v])
            if c >= 0: regs0[v].repl = i32(c)
            else: ow_kmap_put(opt_ir.kval[v], v)
    if o_lastuse.len() < nv:
        if o_lastuse.cap() < nv: o_lastuse.reserve(nv)
        __set_len(o_lastuse, nv)
    o_input_last = data(o_lastuse)
    if nv > 0: mem_set(o_input_last as *u8, 255, nv * 4)
    if o_depth.len() < opt_input_count:
        if o_depth.cap() < opt_input_count: o_depth.reserve(opt_input_count)
        __set_len(o_depth, opt_input_count)
    depths = data(o_depth)
    depth = 0
    # (and what each loop defines and stores to, in the same walk)
    lp_defs.clear()
    lp_first.clear()
    lp_limit.clear()
    lp_parent.clear()
    lp_kills.clear()
    lp_open.clear()
    lp_next = 0
    active = -1
    lp_insns = 0
    # One dispatch supplies operand uses, structured-loop facts, definitions,
    # and memory invalidation. Do not reconstruct a general operand view and
    # redispatch the same operation separately for each consumer.
    input = data(opt_ir.code)
    opt_input = input
    working = opt_working
    loop pos in [0..opt_input_count):
        ins = input + pos
        op = ins.op
        a = int(ins.a)
        b = int(ins.b)
        d = int(ins.dst)
        kill = 0
        depths[pos] = i32(depth)
        match op:
            end:
                depth -= 1
                depths[pos] = i32(depth)
                l = lp_open.pop()
                if l >= 0:
                    lp_limit[l] = lp_defs.len()
                    active = lp_parent[l]
                    if active >= 0: lp_kills[active] = lp_kills[active] | lp_kills[l]
                d = -1
            block, loop, if_:
                depth += 1
                if op == .loop:
                    l = lp_first.len()
                    lp_open.push(l)
                    lp_first.push(lp_defs.len())
                    lp_limit.push(-1)
                    lp_parent.push(active)
                    lp_kills.push(0)
                    active = l
                else: lp_open.push(-1)
                if op == .if_:
                    if o_regs[a].first > pos: o_regs[a].first = i32(pos)
                    o_input_last[a] = i32(pos)
                d = -1
            nop, else_, br, trap, vzu: d = -1
            iconst, fconst, slot, gaddr, daddr, faddr: pass
            intr, call, syscall, calli, callc:
                loop k in [a..a + b):
                    u = int(opt_args[k])
                    if o_regs[u].first > pos: o_regs[u].first = i32(pos)
                    o_input_last[u] = i32(pos)
                if op == .calli or op == .callc:
                    u = int(ins.c)
                    if o_regs[u].first > pos: o_regs[u].first = i32(pos)
                    o_input_last[u] = i32(pos)
                if op != .call or ins.c != 1: kill = 7
            ret:
                if a >= 0:
                    if o_regs[a].first > pos: o_regs[a].first = i32(pos)
                    o_input_last[a] = i32(pos)
                d = -1
            brif, brtable, assume:
                if o_regs[a].first > pos: o_regs[a].first = i32(pos)
                o_input_last[a] = i32(pos)
                d = -1
            zero:
                if o_regs[a].first > pos: o_regs[a].first = i32(pos)
                o_input_last[a] = i32(pos)
                d = -1
                kill = 7
            store, vst:
                if o_regs[a].first > pos: o_regs[a].first = i32(pos)
                o_input_last[a] = i32(pos)
                if o_regs[b].first > pos: o_regs[b].first = i32(pos)
                o_input_last[b] = i32(pos)
                if op == .vst or int(ins.c) & 128 != 0:
                    if o_regs[d].first > pos: o_regs[d].first = i32(pos)
                    o_input_last[d] = i32(pos)
                if op == .store:
                    m = int(ins.c)
                    if opt_raw_mem: kill = 7
                    else if m & 64 != 0: kill = 4
                    else if m & 32 != 0: kill = 2
                    else: kill = 1
                d = -1
            copy:
                if o_regs[a].first > pos: o_regs[a].first = i32(pos)
                o_input_last[a] = i32(pos)
                if o_regs[b].first > pos: o_regs[b].first = i32(pos)
                o_input_last[b] = i32(pos)
                d = -1
                kill = 7
            memcpy, memset, vop:
                if o_regs[a].first > pos: o_regs[a].first = i32(pos)
                o_input_last[a] = i32(pos)
                if o_regs[b].first > pos: o_regs[b].first = i32(pos)
                o_input_last[b] = i32(pos)
                uc = int(ins.c)
                if o_regs[uc].first > pos: o_regs[uc].first = i32(pos)
                o_input_last[uc] = i32(pos)
                d = -1
                kill = 7
            select, memeq, findbyte, scanbytes, findb:
                if o_regs[a].first > pos: o_regs[a].first = i32(pos)
                o_input_last[a] = i32(pos)
                if o_regs[b].first > pos: o_regs[b].first = i32(pos)
                o_input_last[b] = i32(pos)
                uc = int(ins.c)
                if o_regs[uc].first > pos: o_regs[uc].first = i32(pos)
                o_input_last[uc] = i32(pos)
            load:
                if o_regs[a].first > pos: o_regs[a].first = i32(pos)
                o_input_last[a] = i32(pos)
                if int(ins.c) & 128 != 0:
                    if o_regs[b].first > pos: o_regs[b].first = i32(pos)
                    o_input_last[b] = i32(pos)
            mov, neg, not_, fneg, fsqrt, fabs, ffloor, fceil, ftrunc, sext8, sext16, sext32, zext8, zext16, zext32, i2f, u2f, f2i, f2f, bits2f, f2bits, vsplat:
                if o_regs[a].first > pos: o_regs[a].first = i32(pos)
                o_input_last[a] = i32(pos)
            zeroslots:
                loop k in [a..a + b):
                    item = int(opt_args[k])
                    if item & 1 == 1:
                        o_regs[item >> 1].ndef += 2
                        o_regs[item >> 1].stable = false
                        if active >= 0: lp_defs.push(item >> 1)
                d = -1
                kill = 7
            _:
                if o_regs[a].first > pos: o_regs[a].first = i32(pos)
                o_input_last[a] = i32(pos)
                if o_regs[b].first > pos: o_regs[b].first = i32(pos)
                o_input_last[b] = i32(pos)
        if d >= 0:
            if not opt_sra_counted:
                o_regs[d].ndef += 1
            o_regs[d].defpos = i32(pos)
            o_regs[d].stable = o_regs[d].ndef == 1 and o_regs[d].first > pos
            if active >= 0: lp_defs.push(d)
        if active >= 0:
            lp_insns += 1
            if kill != 0: lp_kills[active] = lp_kills[active] | kill
    # forward: fold, propagate copies, eliminate common subexpressions, drop dead branches
    o_count = 0
    if o_capacity < opt_input_count:
        o_capacity = opt_input_count
        if o_out_storage.cap() < o_capacity: o_out_storage.reserve(o_capacity)
        __set_len(o_out_storage, o_capacity)
        o_out = data(o_out_storage)
    ow_flow_begin()
    opt_has_loops = lp_first.len() > 0
    o_cse = opt_allow_cse or opt_has_loops
    if o_cse: ow_ht_setup((if opt_allow_cse: opt_input_count else: lp_insns) + 16)
    # 0 normal, 1 if(true), 2 if(false), 3 block; keep each control's facts together.
    o_ctl.clear()
    ctl = o_ctl
    o_ctl = []
    o_join_regs.clear()
    o_join_next.clear()
    o_loop_depth = 0
    skip = 0           # nesting depth inside a dead branch
    dec = opt_decode
    loop pos in [0..opt_input_count):
        ins = input + pos
        op = ins.op
        if skip > 0:
            if op == .block or op == .loop or op == .if_: skip += 1
            if op == .loop: lp_next += 1
            else if op == .else_ and skip == 1 and ctl[ctl.len() - 1].kind == 2:
                skip = 0
                ow_scope_open()
            else if op == .end:
                skip -= 1
                if skip == 0:
                    frame = ctl.pop()
                    ow_join_kill(frame.deferred)
                    lop = o_out[o_count - 1].op
                    if lop == .block or lop == .if_: ow_pop()
                    else: ow_append(ins[0])
            continue
        if dec[oc_tag(ins)] & (1 << 24) == 0:
            working[0] = ins[0]
            ow_transfer(working, true)
            continue
        if op == .nop: continue
        if op == .block or op == .loop:
            kind = 4
            if op == .loop:
                ow_enter_loop()
                o_loop_depth += 1
            else: kind = 3
            ctl.push(OptControl(kind, -1, o_nbr))
            ow_scope_open(op == .block)
            ow_append(ins[0])
            continue
        if op == .if_:
            c = int(o_regs[int(ins.a)].repl)
            known = o_regs[c].constant or ow_fact_false(c) or ow_fact_true(c)
            if known:
                # the if becomes a plain block so branch depths inside stay valid
                ow_append(Ins(.block, 0, 0, 0, 0, 0, 0))
                if (o_regs[c].constant and o_regs[c].cval != 0) or ow_fact_true(c):
                    ctl.push(OptControl(1, -1, o_nbr))
                    ow_scope_open()
                else:
                    ctl.push(OptControl(2, -1, o_nbr))
                    skip = 1
                continue
            ctl.push(OptControl(0, c, o_nbr))
            ow_scope_open()
            ow_add_fact_true(c)
            ins2 = ins[0]
            ins2.a = i32(c)
            o_regs[c].nuse += 1
            ow_append(ins2)
            continue
        if op == .else_:
            c = ctl[ctl.len() - 1].condition
            ctl[ctl.len() - 1].condition = -1
            ow_scope_close()
            if ctl[ctl.len() - 1].kind == 1:
                skip = 1
                continue
            ow_scope_open()
            if c >= 0: ow_add_fact_false(c)
            ow_append(ins[0])
            continue
        if op == .end:
            # A terminating if arm leaves its condition false. For a block with exactly
            # one conditional exit and a terminating tail, only that taken exit reaches
            # the join. Count all branches conservatively, including nested breaks.
            frame = ctl.pop()
            c = frame.condition
            nbr = frame.branches
            kind = frame.kind
            if kind == 4: o_loop_depth -= 1
            ow_join_kill(frame.deferred)
            last = o_out[o_count - 1]
            if kind == 3 and c >= 0 and nbr + 2 == o_nbr and last.op == .br and last.imm > 0:
                target = ctl.len() - int(last.imm)
                if target >= 0:
                    d = ow_branch_copy()
                    if d >= 0:
                        o_regs[d].ver -= 1
                        o_join_regs.push(d)
                        o_join_next.push(ctl[target].deferred)
                        ctl[target].deferred = o_join_regs.len() - 1
            terminates = last.op == .ret or last.op == .trap or (last.op == .call and last.c == 1)
            noret = c >= 0 and terminates
            ow_scope_close()
            if last.op == .block or last.op == .if_:
                # empty construct: drop it (an if's condition is pure)
                ow_pop()
                continue
            ow_append(ins[0])
            if noret:
                if kind == 3 and nbr + 1 == o_nbr: ow_add_fact_true(c)
                else if kind == 0 and nbr == o_nbr: ow_add_fact_false(c)
            continue
        if op == .brif:
            # a branch on a known condition: always or never taken
            c = int(o_regs[int(ins.a)].repl)
            if o_regs[c].constant or ow_fact_false(c) or ow_fact_true(c):
                if (o_regs[c].constant and o_regs[c].cval != 0) or ow_fact_true(c): ow_emit(Ins(.br, 0, 0, 0, 0, 0, ins.imm))
                continue
            # Remember an exit's condition for a possible terminating block. Multiple
            # exits (even with the same condition) fail the branch-count check at its end.
            target = ctl.len() - 1 - int(ins.imm)
            if target >= 0 and ctl[target].kind == 3: ctl[target].condition = c
            # (after it, in this construct, the condition is false)
            working[0] = ins[0]
            ow_transfer(working, true)
            ow_add_fact_false(c)
            continue
        if op == .zeroslots:
            ow_kill_all()
            loop k in [0..int(ins.b)):
                item = int(opt_args[int(ins.a) + k])
                if item & 1 == 1: o_regs[item >> 1].ver += 1
            ow_append_plain(ins[0])
            continue
        working[0] = ins[0]
        ow_transfer(working, true)
    if o_flow_dead: ow_flow_end_dead()
    # backward: drop pure instructions whose results are unused (o_push counted the uses)
    i = o_count - 1
    loop i >= 0:
        ins = o_out + i
        # (a length load that is a null test stays: M_NULLF)
        if opt_decode[oc_tag(ins)] & 2 != 0 and not (ins.op == .load and int(ins.c) & 65536 != 0):
            d = int(ins.dst)
            if o_regs[d].nuse == 0:
                ow_operands(ins)
                o_out[i].op = .nop
                loop operand_index in [0..opt_use_count):
                    let u = ow_use(operand_index)
                    o_regs[u].nuse -= 1
        i -= 1
    o_ctl = ctl
    opt_cleanup_ir(o_out, o_count)

# Demand proofs of the exact stores in GPU programs' functions and the program's functions they
# call (exact_shader_roots), before the facts pass chooses its bodies: those it must visit.
# O(their nodes), once.
exact_shader_demand = () -> int[]:
    seen: {int: bool} = {}
    out: int[]
    work = exact_shader_roots
    exact_shader_roots = []
    loop work.len() > 0:
        f = work.pop()
        if f <= 0 or f >= fns.len() or seen.has(f) or fns[f].body == 0 or fn_in_lib(f): continue
        seen[f] = true
        exact_shader_owners[f] = true
        # (the facts' ranges of its exact values: what a shader's 32-bit words hold, sl_exact_range)
        if f >= exact_rep_owners.len(): exact_rep_owners.resize(max(f + 1, fns.len()))
        exact_rep_owners[f] = true
        out.push(f)
        exact_shader_calls(int(fns[f].body), work)
    out

# A boundary wrapper has the same ABI and type as the value it stores.
exact_store = (n: int, owner: int):
    if not exact_has_node(n) or exact_has_store(n): return
    t = ntype(n)
    if not exact_type(t, nodes[n].pos): return
    k = nodes[n].kind
    if k == .block and nodes[n].aux != 0:
        exact_store(block_value(n), owner)
        exact_unmark(n)
        return
    if k == .if_ or k == .iflet or k == .match_:
        if k == .match_:
            loop arm in kids(n): exact_store(int(nodes[arm].b), owner)
        else:
            exact_store(int(nodes[n].b), owner)
            exact_store(int(nodes[n].c), owner)
        exact_unmark(n)
        return
    width = exact_type_width(n)
    fits = width > 0 and (if types[exact_representation(t)].sign: width / 2 <= types[exact_representation(t)].bits else: width & 1 != 0 and width / 2 <= types[exact_representation(t)].bits + 1)
    if fits:
        if exact_measure_on: exact_measure_sites[n] = ExactMeasure(owner, t, "proven")
        return
    inner = nodes.len()
    nodes.push(nodes[n])
    if let shift = exact_shifts.get(n): exact_shifts[inner] = shift
    exact_mark(inner)
    nodes[n] = Node(kind = .conv, pos = nodes[inner].pos, a = i32(inner), aux = i32(int(CV.fixed_store)), type = i32(t), flags = i32(NF_CHECKED))
    exact_unmark(n)
    exact_stores[n] = owner
    exact_marks[n] |= 2
    if n < exact_type_widths.len(): exact_type_widths[n] = 0
    if exact_measure_on: exact_measure_sites[n] = ExactMeasure(owner, t, "runtime-check")

# Only immutable names can supply a context-free initializer. Stored globals
# remain loads, and their word bound includes the value before initialization.
exact_named_constant = (n: int) -> bool:
    if nodes[n].kind != .ident: return false
    if nodes[n].aux == i32(int(SK.global)):
        g = int(nodes[n].sym)
        return readonly_global(g) and not globals[g].exposed
    nodes[n].aux == i32(int(SK.local)) and int(locals[int(nodes[n].sym)].flags) & LF_CONST != 0

exact_constant_use = (n: int) -> bool:
    if exact_named_constant(n): return true
    if nodes[n].kind == .binary and nodes[n].aux == 0:
        return exact_named_constant(int(nodes[n].a)) or exact_named_constant(int(nodes[n].b))
    false

# After checking has seen every write, an immutable mathematical local with a
# word-sized initializer can feed static exact arithmetic without a tagged
# temporary. The conversion is a representation proof, not a fit obligation.
exact_prepare_operand = (n: int) -> int:
    word = exact_math_operand(n)
    if word != n or prune(ntype(n)) != T_MATH_INT: return word
    if nodes[n].kind == .conv and nodes[n].aux == i32(int(CV.int_)):
        source = int(nodes[n].a)
        t = exact_representation(ntype(source))
        # A stored signed policy word has the same value when lifted to int.
        # Keep its policy operation intact beneath an identity conversion.
        if is_int(t) and types[t].sign and types[t].bits == 64:
            word = mk(.conv, nodes[n].pos)
            nodes[word] = Node(kind = .conv, pos = nodes[n].pos, a = i32(source), aux = i32(int(CV.none_)), type = i32(T_INT), flags = i32(NF_CHECKED))
            return word
    if nodes[n].kind != .ident: return n
    # A local constant may be an inferred `int`. Stored globals retain their
    # read and include their initial zero in exact_count_bound below.
    local = nodes[n].aux == i32(int(SK.local))
    if local and int(locals[int(nodes[n].sym)].flags) & LF_CONST != 0:
        width = exact_type_width(n)
        index = exact_type_widths[n]
        if index < -1 and width / 2 <= 64:
            value = int(exact_type_values[n])
            if index & 1 == 0: value = -value
            word = mk(.int_lit, nodes[n].pos)
            nodes[word].type = i32(T_INT)
            nodes[word].ival = value
            add_flag(word, NF_CHECKED)
            return word
    if not local and nodes[n].aux != i32(int(SK.global)): return n
    bound = exact_count_bound(n)
    if bound.wide: return n
    word = mk(.conv, nodes[n].pos)
    nodes[word].a = i32(n)
    nodes[word].aux = i32(int(CV.int_))
    nodes[word].type = i32(T_INT)
    exact_word_reads[word] = true
    word

exact_prepare_math = (n: int) -> bool:
    if nodes[n].kind != .call and nodes[n].kind != .binary and nodes[n].kind != .unary: return false
    if nodes[n].aux != 0 or prune(ntype(n)) != T_MATH_INT or not dewy_at(nodes[n].pos): return false
    if nodes[n].kind == .unary:
        if nodes[n].op != i32(int(Tok.minus)): return false
        a = exact_prepare_operand(int(nodes[n].a))
        if exact_representation(ntype(a)) != T_INT: return false
        nodes[n].a = i32(a)
        nodes[n].type = i32(T_INT)
        wrap_conv(n, .int_, T_MATH_INT)
        return true
    if nodes[n].kind == .call:
        floor = fact_floor_call(n)
        if floor < 1 or floor > 4: return false
        a = exact_prepare_operand(kid(n, 0)); b = exact_prepare_operand(kid(n, 1))
        if exact_representation(ntype(a)) != T_INT or exact_representation(ntype(b)) != T_INT: return false
        nodes[n] = Node(kind = .binary, pos = nodes[n].pos, a = i32(a), b = i32(b), type = i32(T_INT), op = i32(int((if floor == 1: Tok.slash else if floor == 2: Tok.percent else if floor == 3: Tok.shr else: Tok.amp))), aux2 = -1, flags = i32(NF_CHECKED))
        wrap_conv(n, .int_, T_MATH_INT)
        return true
    if nodes[n].kind != .binary: return false
    op = nodes[n].op as Tok
    right = int(nodes[n].b)
    if op == .shl or op == .shr:
        # Dynamic int64 shifts preserve unsigned count interpretation in a
        # wrapper. A final nonnegative bound proves that wrapper is an identity.
        count_type = exact_representation(ntype(right))
        if nodes[right].kind == .conv and nodes[right].aux == i32(int(CV.wrap_int)) and is_int(count_type) and not types[count_type].sign and types[count_type].bits == 64:
            source = int(nodes[right].a)
            if exact_bounded_count(source): right = source
        known, count = integer_constant(right)
        if not known or count < 0 or count >= 1048576:
            if not exact_bounded_count(right): return false
    else if op != .plus and op != .minus and op != .star and op != .amp and op != .pipe and op != .caret: return false
    a = exact_prepare_operand(int(nodes[n].a)); b = exact_prepare_operand(right)
    if exact_representation(ntype(a)) != T_INT: return false
    if exact_representation(ntype(b)) != T_INT:
        # A bounded shift count keeps its original fixed storage width.
        if op != .shl and op != .shr or not is_int(ntype(b)) or prune(ntype(b)) == T_MATH_INT: return false
    nodes[n].a = i32(a); nodes[n].b = i32(b)
    nodes[n].type = i32(T_INT)
    wrap_conv(n, .int_, T_MATH_INT)
    true

exact_build_kflags = () -> u8[]:
    tab = fill(u8(0), 128)
    # bit 1: write_site; bit 2: pre_special; bit 4: post_special; bit 8: control; bit 16: pure scalar leaf
    tab[int(NK.int_lit)] = u8(16)
    tab[int(NK.float_lit)] = u8(16)
    tab[int(NK.bool_lit)] = u8(16)
    tab[int(NK.none_lit)] = u8(16)
    tab[int(NK.null_lit)] = u8(16)
    tab[int(NK.ident)] = u8(16)
    tab[int(NK.vardecl)] = u8(1 | 4)
    tab[int(NK.assign)] = u8(1 | 2 | 4)
    tab[int(NK.for_)] = u8(1 | 2 | 4)
    tab[int(NK.while_)] = u8(1 | 2)
    tab[int(NK.lambda)] = u8(1 | 2)
    tab[int(NK.fn_)] = u8(1 | 2)
    tab[int(NK.return_)] = u8(1)
    tab[int(NK.break_)] = u8(1)
    tab[int(NK.continue_)] = u8(1)
    tab[int(NK.conv)] = u8(2 | 4)
    tab[int(NK.array)] = u8(2)
    tab[int(NK.binary)] = u8(2 | 4)
    tab[int(NK.unary)] = u8(2 | 4)
    tab[int(NK.intrinsic)] = u8(2 | 4)
    tab[int(NK.if_)] = u8(2 | 4 | 8)
    tab[int(NK.iflet)] = u8(2 | 4 | 8)
    tab[int(NK.block)] = u8(2 | 4 | 8)
    tab[int(NK.exprstmt)] = u8(2 | 4 | 8)
    tab[int(NK.match_)] = u8(2 | 4 | 8)
    tab[int(NK.arm)] = u8(2 | 8)
    tab[int(NK.coalesce)] = u8(2 | 4 | 8)
    tab[int(NK.call)] = u8(4)
    tab

exact_kflags_tab = exact_build_kflags()
exact_kflags_p = data(exact_kflags_tab)

@noinline
exact_prep_pre_conv = (n: int):
    nd = data(nodes) + n
    loop nd[0].kind == .conv and nd[0].aux == i32(int(CV.none_)):
        child = int(nd[0].a)
        t = ntype(n); ct = ntype(child)
        if not is_int(exact_representation(t)) or exact_representation(t) != exact_representation(ct): break
        kind = data(nodes)[child].kind
        if kind != .binary and kind != .unary and kind != .ident and kind != .int_lit and not (kind == .conv and data(nodes)[child].aux == i32(int(CV.none_))): break
        nd[0] = data(nodes)[child]
        nd[0].type = i32(t)

@noinline
exact_prep_pre_assign = (n: int):
    nd = data(nodes) + n
    target = int(nd[0].a)
    if data(nodes)[target].kind == .ident and data(nodes)[target].aux == i32(int(SK.local)) and prune(ntype(target)) == T_MATH_INT:
        op = compound_op(int(nd[0].op)) as Tok
        if op == .plus or op == .minus or op == .star or op == .amp or op == .pipe or op == .caret:
            left = nodes.len(); nodes.push(data(nodes)[target])
            value = mk(.binary, data(nodes)[n].pos)
            data(nodes)[value] = Node(kind = .binary, pos = data(nodes)[n].pos, a = i32(left), b = data(nodes)[n].b, op = i32(int(op)), type = i32(T_MATH_INT), flags = i32(NF_CHECKED))
            data(nodes)[n].b = i32(value)
            data(nodes)[n].op = i32(int(Tok.assign))

@noinline
exact_prep_shift = (n: int, owner: int):
    nd = data(nodes) + n
    (known, count) = integer_constant(int(nd[0].b))
    if count < 0 and not data(types)[exact_representation(ntype(int(nd[0].b)))].sign: known = false
    if known and count < 1048576: exact_shifts[n] = max(0, count)
    else:
        exact_demands[owner] = true
        exact_count_nodes.push((n, owner))
        data(exact_marks)[n] |= 128

@noinline
exact_prep_post_conv = (n: int, owner: int):
    nd = data(nodes) + n
    source = int(nd[0].a)
    has_wr = exact_word_reads.len() > 0 and exact_word_reads.has(n)
    if exact_named_constant(source) and not has_wr:
        word = exact_prepare_operand(source)
        if word != source:
            data(nodes)[n].a = i32(word)
            exact_mark(n) # narrower destinations still need their own fit proof
    nd = data(nodes) + n
    if nd[0].a == i32(source):
        if data(nodes)[source].kind == .conv and data(nodes)[source].aux == i32(int(CV.int_)) and exact_type(ntype(int(data(nodes)[source].a)), nd[0].pos): nd[0].a = data(nodes)[source].a
        else if not has_wr: exact_demands[owner] = true

@noinline
exact_prep_post_shl_rep = (n: int, owner: int):
    if owner >= exact_rep_owners.len(): exact_rep_owners.resize(max(owner + 1, fns.len()))
    data(exact_rep_owners)[owner] = true
    if n >= exact_rep_demands.len(): exact_rep_demands.resize(nodes.len())
    data(exact_rep_demands)[n] = true
    exact_proof_demands[owner] = true

@noinline
exact_prep_post_for = (n: int, owner: int):
    nd = data(nodes) + n
    if nd[0].aux == 0:
        it = int(nd[0].a)
        ep0 = int(data(nodes)[it].a); ep1 = int(data(nodes)[it].b); ep2 = int(data(nodes)[it].c)
        if ep0 != 0 and prune(ntype(ep0)) == T_MATH_INT and exact_count_bound(ep0).wide: exact_prep_post_shl_rep(ep0, owner)
        if ep1 != 0 and prune(ntype(ep1)) == T_MATH_INT and exact_count_bound(ep1).wide: exact_prep_post_shl_rep(ep1, owner)
        if ep2 != 0 and prune(ntype(ep2)) == T_MATH_INT and exact_count_bound(ep2).wide: exact_prep_post_shl_rep(ep2, owner)
    nd = data(nodes) + n
    if (nd[0].aux == 0 or nd[0].aux == 1) and nd[0].sym > 0 and not has_flag(n, NF_MUT):
        l = int(nd[0].sym)
        if l >= exact_iteration_sources.len(): exact_iteration_sources.resize(locals.len())
        data(exact_iteration_sources)[l] = int(nd[0].a)

@noinline
exact_prep_post_vardecl = (n: int):
    nd = data(nodes) + n
    if nd[0].sym > 0 and not has_flag(n, NF_GLOBAL):
        l = int(nd[0].sym)
        if l >= exact_initializers.len(): exact_initializers.resize(max(l + 1, locals.len()))
        data(exact_initializers)[l] = int(nd[0].b)

@noinline
exact_prep_post_call = (n: int):
    nd = data(nodes) + n
    if nd[0].aux == 0 and nd[0].sym > 0:
        called = int(nd[0].sym)
        # (`m[k] = (m.get(k) ?? 0) + 1`: a counter stored through the entry setter)
        if nd[0].nlist == 3: exact_progress_assignments.push(n)
        np = min(int(nd[0].nlist), data(fns)[called].params.len())
        if np > 0:
            lbase = int(nd[0].list)
            pp = data(data(fns)[called].params)
            lp = data(lists)
            np0 = data(nodes)
            locp = data(locals)
            loop i in [0..np):
                if int(locp[pp[i]].flags) & LF_MUTPARAM == 0: continue
                root = fact_progress_root(int(lp[lbase + i]))
                if np0[root].kind == .ident and np0[root].aux == i32(int(SK.local)):
                    l = int(np0[root].sym)
                    if l >= exact_progress_opaque.len(): exact_progress_opaque.resize(locals.len())
                    data(exact_progress_opaque)[l] = true

@noinline
exact_prep_post_intrinsic = (n: int):
    nd = data(nodes) + n
    if nd[0].nlist > 0:
        id = nd[0].aux as IN
        if id == .push or id == .insert or id == .extend or id == .fill or id == .resize or id == .truncate or id == .reserve:
            root = fact_progress_root(kid(n, 0))
            if data(nodes)[root].kind == .ident and data(nodes)[root].aux == i32(int(SK.local)):
                l = int(data(nodes)[root].sym)
                if l >= exact_progress_opaque.len(): exact_progress_opaque.resize(locals.len())
                data(exact_progress_opaque)[l] = true

@noinline
exact_prep_post_assign = (n: int):
    exact_progress_assignments.push(n)
    nd = data(nodes) + n
    target = int(nd[0].a)
    root = fact_progress_root(target)
    if data(nodes)[root].kind == .ident and data(nodes)[root].aux == i32(int(SK.local)):
        l = int(data(nodes)[root].sym)
        if l >= exact_write_heads.len(): exact_write_heads.resize(max(l + 1, locals.len()))
        exact_write_values.push(int(nd[0].b))
        exact_write_plain.push(nd[0].op == i32(int(Tok.assign)) and nd[0].aux == 0)
        exact_write_targets.push(target)
        exact_write_seen.push(0)
        exact_write_controls.push(exact_control_head)
        exact_write_next.push(data(exact_write_heads)[l])
        data(exact_write_heads)[l] = exact_write_values.len()

# Children of arithmetic and value controls remain intermediates. Other
# consumers take stored values (including call actuals and aggregate fields).
exact_prepare_node = (n: int, owner: int, store: bool):
    if n <= 0: return
    # Scalar leaves carry no arithmetic or writes. Strings may contain
    # interpolation expressions, so retain their ordinary child traversal.
    np = data(nodes)
    nd = np + n
    k0 = nd[0].kind
    kfp = exact_kflags_p
    kf = int(kfp[int(k0)])
    if (kf & 16) != 0 or (k0 == .str_lit and nd[0].nlist == 0): return
    if n >= exact_marks.len(): exact_reserve(n)
    em = data(exact_marks)
    if em[n] & 4 != 0:
        if store and em[n] & 3 == 1: exact_store(n, owner)
        return
    em[n] |= 4
    if k0 == .conv and nd[0].aux == i32(int(CV.none_)):
        exact_prep_pre_conv(n)
        np = data(nodes)
        nd = np + n
        k0 = nd[0].kind
        kf = int(kfp[int(k0)])
    else if k0 == .assign and nd[0].aux == 0 and nd[0].op != i32(int(Tok.assign)):
        exact_prep_pre_assign(n)
        np = data(nodes)
        nd = np + n
    k = k0
    if exact_collect_writes and (kf & 1) != 0: exact_lower_sites.push(n)
    if k == .lambda or k == .fn_: return
    if exact_measure_on:
        if store: exact_measure_boundary(n, owner)
        else: exact_measure_visit(n, owner, false)
    # eflags: 1=math, 2=operator, 4=cmp, 8=conversion, 16=policy, 32=control
    eflags = if (kf & 8) != 0: 32 else: 0
    previous_control = -1
    if (kf & 2) != 0:
        if k == .binary:
            if exact_operation(n):
                eflags |= 1
                if nd[0].op == i32(int(Tok.shl)) or nd[0].op == i32(int(Tok.starstar)): exact_prep_shift(n, owner)
            if nd[0].aux == 0:
                if exact_type(ntype(n), nd[0].pos): eflags |= 2
                if ntype(n) == T_BOOL: eflags |= 4
        else if k == .unary or k == .intrinsic:
            if exact_operation(n): eflags |= 1
        else if k == .conv:
            aux = nd[0].aux
            if (aux == i32(int(CV.int_)) or aux == i32(int(CV.none_))) and exact_type(ntype(n), nd[0].pos): eflags |= 8
            if aux == i32(int(CV.wrap_int)) or aux == i32(int(CV.saturate_int)):
                eflags |= 16
                if exact_named_constant(int(nd[0].a)):
                    data(nodes)[n].a = i32(exact_prepare_operand(int(nd[0].a)))
                    np = data(nodes)
                    nd = np + n
            else if aux == i32(int(CV.int2float)) or ntype(n) == T_MATH_INT: eflags |= 16
        else if k == .array:
            if has_flag(n, NF_BROADCAST) and tkind(ntype(n)) == .array and exact_representation(telem(ntype(n))) == T_MATH_INT: exact_demands[owner] = true
        else if k == .while_ or k == .for_:
            previous_control = exact_control_head
            exact_control_values.push(int(nd[0].a))
            exact_control_parents.push(previous_control)
            exact_control_head = exact_control_values.len()
    mask = int(iso_child_p[int(k)])
    if mask > 0:
        ca = int(nd[0].a); cb = int(nd[0].b); cc = int(nd[0].c)
        nk = int(nd[0].nlist); lbase = int(nd[0].list)
        nn = nodes.len()
        if mask & 1 != 0 and ca > 0:
            cnd = np + ca
            cka = cnd[0].kind
            if (int(kfp[int(cka)]) & 16) == 0 and (cka != .str_lit or cnd[0].nlist != 0):
                exact_prepare_node(ca, owner, not ((eflags & 31) != 0 or k == .exprstmt or (k == .match_ and exact_match_literals(n))))
                if nodes.len() != nn: np = data(nodes); nn = nodes.len()
        if mask & 2 != 0 and cb > 0:
            cnd = np + cb
            ckb = cnd[0].kind
            if (int(kfp[int(ckb)]) & 16) == 0 and (ckb != .str_lit or cnd[0].nlist != 0):
                exact_prepare_node(cb, owner, (eflags & 39) == 0)
                if nodes.len() != nn: np = data(nodes); nn = nodes.len()
        if mask & 4 != 0 and cc > 0:
            cnd = np + cc
            ckc = cnd[0].kind
            if (int(kfp[int(ckc)]) & 16) == 0 and (ckc != .str_lit or cnd[0].nlist != 0):
                exact_prepare_node(cc, owner, (eflags & 32) == 0)
                if nodes.len() != nn: np = data(nodes); nn = nodes.len()
        if mask & 16 != 0 and nk > 0:
            child_store = (eflags & 1) == 0 and k != .block and k != .match_
            lp = data(lists)
            nl = lists.len()
            loop i in [0..nk):
                ci = int(lp[lbase + i])
                if ci > 0:
                    cnd = np + ci
                    cki = cnd[0].kind
                    if (int(kfp[int(cki)]) & 16) == 0 and (cki != .str_lit or cnd[0].nlist != 0):
                        exact_prepare_node(ci, owner, child_store)
                        if nodes.len() != nn: np = data(nodes); nn = nodes.len()
                        if lists.len() != nl: lp = data(lists); nl = lists.len()
    if (kf & 4) != 0:
        nd = data(nodes) + n
        if (k == .call or k == .binary or k == .unary) and nd[0].aux == 0:
            nt = int(nd[0].type)
            if nt == T_MATH_INT or (nt != 0 and data(types)[nt].kind == .var and prune(nt) == T_MATH_INT):
                rewrote = exact_prepare_math(n)
                nd = data(nodes) + n
                if rewrote:
                    data(exact_marks)[n] &= 251
                    exact_prepare_node(n, owner, store)
                    return
        if (eflags & 8) != 0 and prune(ntype(int(nd[0].a))) == T_MATH_INT:
            exact_prep_post_conv(n, owner)
            nd = data(nodes) + n
        expanded = (eflags & 1) != 0 or ((eflags & 2) != 0 and (exact_has_node(int(nd[0].a)) or exact_has_node(int(nd[0].b))))
        if (eflags & 8) != 0: expanded = exact_has_node(int(nd[0].a))
        if (eflags & 32) != 0:
            match k:
                block:
                    if nd[0].aux != 0:
                        tail = block_value(n)
                        if prune(ntype(n)) == T_MATH_INT or prune(ntype(tail)) == T_MATH_INT: nd[0].type = data(nodes)[tail].type
                        expanded = exact_has_node(tail)
                exprstmt: expanded = exact_has_node(int(nd[0].a))
                if_, iflet: expanded = exact_has_node(int(nd[0].b)) or exact_has_node(int(nd[0].c))
                match_:
                    lbase = int(nd[0].list)
                    loop i in [0..int(nd[0].nlist)):
                        arm = int(data(lists)[lbase + i])
                        if exact_has_node(int(data(nodes)[arm].b)): expanded = true
                coalesce:
                    if exact_has_node(int(nd[0].b)) and exact_type(ntype(n), nd[0].pos): exact_mark(n)
                else: pass
        if expanded and nd[0].type != 0 and exact_type(ntype(n), nd[0].pos): exact_mark(n)
        if (eflags & 4) != 0 and (exact_has_node(int(nd[0].a)) or exact_has_node(int(nd[0].b))): exact_mark(n)
        if k == .binary:
            if nd[0].aux == 0 and nd[0].op == i32(int(Tok.shl)) and prune(ntype(n)) == T_MATH_INT: exact_prep_post_shl_rep(n, owner)
        else if k == .for_: exact_prep_post_for(n, owner)
        else if k == .vardecl: exact_prep_post_vardecl(n)
        else if k == .call: exact_prep_post_call(n)
        else if k == .intrinsic: exact_prep_post_intrinsic(n)
        else if k == .assign: exact_prep_post_assign(n)
    if (store or (k == .conv and has_flag(n, NF_EXPLICIT_INTEGER))) and n < exact_marks.len() and data(exact_marks)[n] & 3 == 1: exact_store(n, owner)
    if previous_control >= 0:
        if exact_collect_writes: exact_lower_sites.push(-1)
        exact_control_head = previous_control

exact_pure_float_tree = (n: int) -> bool:
    if n < exact_float_purity.len() and exact_float_purity[n] != 0: return exact_float_purity[n] == 2
    k = nodes[n].kind
    pure = k == .ident or k == .int_lit or k == .bool_lit
    if k == .unary or k == .conv: pure = exact_pure_float_tree(int(nodes[n].a))
    else if k == .binary and nodes[n].aux == 0: pure = exact_pure_float_tree(int(nodes[n].a)) and exact_pure_float_tree(int(nodes[n].b))
    if n >= exact_float_purity.len(): exact_float_purity.resize(max(n + 1, nodes.len()))
    exact_float_purity[n] = if pure: 2 else: 1
    pure

exact_prepare_floats = (f: int) -> bool:
    if exact_measure_on or exact_full_owners.has(f) or f >= exact_candidate_heads.len() or exact_candidate_heads[f] == 0: return false
    at = exact_candidate_heads[f]
    loop at > 0:
        n = exact_candidate_nodes[at - 1]
        if nodes[n].kind == .conv and nodes[n].aux == i32(int(CV.int2float)) and exact_pure_float_tree(n): exact_prepare_node(n, f, false)
        at = exact_candidate_next[at - 1]
    at = exact_candidate_heads[f]
    loop at > 0:
        n = exact_candidate_nodes[at - 1]
        if n >= exact_marks.len() or exact_marks[n] & 4 == 0: return false
        at = exact_candidate_next[at - 1]
    true

exact_prepare = ():
    if exact_owners.len() > 0: exact_marks = fill(u8(0), nodes.len() * 2 + 64)
    owners: int[]
    loop f, _ in exact_owners: owners.push(f)
    owners.sort()
    loop f in owners:
        # A checking worker reports this demand alongside its closed-state
        # summary. Restore only demanded bodies before obligations are decided.
        pc_restore(f)
        if f <= 0 or f >= fns.len() or fns[f].state != 2 or effect_unavailable.has(f): continue
        if f >= exact_effect_owners.len(): exact_effect_owners.resize(fns.len())
        exact_effect_owners[f] = true
        body = int(fns[f].body)
        if exact_prepare_floats(f): continue
        fact_plan_forget(f)
        # Reuse this demanded traversal for lowering's write inventory.
        # Each write/control boundary is recorded once, O(N+E); lowering
        # replays O(writes + controls) instead of walking the body again.
        exact_collect_writes = not fns[f].writes_ready
        exact_lower_sites = []
        exact_prepare_node(body, f, false)
        if exact_collect_writes:
            fns[f].write_sites = exact_lower_sites
            fns[f].writes_ready = true
        exact_collect_writes = false
        exact_lower_sites = []
        if nodes[body].kind == .block and nodes[body].aux != 0:
            if exact_measure_on: exact_measure_boundary(block_value(body), f)
            exact_store(block_value(body), f)
    loop candidate in exact_count_nodes:
        original = candidate.0
        n = if exact_has_store(original): int(nodes[original].a) else: original
        bound = exact_count_bound(int(nodes[n].b))
        if not bound.wide and bound.hi < 1048576:
            exact_shifts[n] = max(0, bound.hi)
            exact_marks[original] &= 127
        else: exact_proof_demands[candidate.1] = true
    loop assignment in exact_progress_assignments: fact_progress_note(assignment)
    loop n, owner in exact_stores:
        if not exact_decided(n):
            exact_demands[owner] = true
            if dir_policy(nodes[n].pos) == DIR_STATIC: exact_proof_demands[owner] = true
    # Exact stores rewrite existing checked nodes as well as appending them.
    effect_ix_nodes = 0
    effect_ix_locals = 0
    if effect_seen.len() > 0: effect_seen.resize(nodes.len())
    exact_local_widths = []
    exact_raw_values = []

exact_preparation_bind = (exact_control_head: *(int), exact_collect_writes: *(bool), effect_ix_nodes: *(int), effect_ix_locals: *(int), exact_marks: *(u8[])) -> int: 0

bind_from_imports = (start: int = 0):
    loop di in [start..from_imports.len()):
        d = from_imports[di]
        m = int(nodes[d].mod)
        im = int(nodes[d].sym)
        if nodes[d].aux == 3:
            bind_splat(d, m, im)
            continue
        loop i in [0..nkids(d)):
            id = kid(d, i)
            nm = int(nodes[id].name)
            if ide_sentinel != 0 and nm == ide_sentinel: ide_complete_module(im)
            alias = nm
            if nodes[id].aux != 0:
                alias = int(nodes[id].aux)
                if ide_on: ide_alias_of[alias] = nm
            s = 0
            if modules[im].is_prelude:
                demand_name(nm)
                s = prelude.get(nm) ?? 0
            else: s = modules[im].names.get(nm) ?? 0
            if s == 0 or syms[s].kind == .module:
                cands: int[]
                if not modules[im].is_prelude:
                    loop k, v in modules[im].names: cands.push(k)
                fatal(nodes[id].pos, "'{name_of(int(nodes[d].sval))}' has no '{name_of(nm)}'{suggestion(name_of(nm), cands)}")
            if files[int(modules[m].file)].is_dewy: rational_one_spelling(im, nm, nodes[id].pos, "drop `{name_of(nm)}` from the import and ")
            if ide_on:
                if syms[s].kind == .fns and syms[s].decl != 0: ide_ref(nodes[id].pos, nm, IK_FN, nodes[int(syms[s].decl)].pos, 0, -int(syms[s].decl))
                else: ide_sym_ref(id, s)
            # (in Dewy a module's own declaration shadows a `$shadowable` import as a whole;
            # other imported consts cannot be shadowed)
            dewy_own = 0
            if files[int(modules[m].file)].is_dewy:
                if let ex = modules[m].names.get(alias):
                    if syms[ex].decl != 0 and int(nodes[int(syms[ex].decl)].mod) == m: dewy_own = ex
            if dewy_own != 0:
                if decl_shadowable(int(syms[s].decl)): continue
                fatal(nodes[id].pos, "cannot import '{name_of(alias)}': this module declares its own '{name_of(alias)}' (at {pos_str(nodes[int(syms[dewy_own].decl)].pos)}), and the imported one is not `$shadowable`; import it with another name: {name_of(nm)} as ...")
            if files[int(modules[m].file)].is_dewy and modules[m].names.get(alias) != none:
                owned = family_decls(s)
                if dewy_import_clash(m, alias, s, owned, d, nodes[id].pos) == 1: continue
                bind_imported(m, alias, syms[s].kind, owned)
                continue
            if syms[s].kind == .fns:
                if let ex = modules[m].names.get(alias):
                    if syms[ex].kind != .fns: fatal(nodes[id].pos, "cannot import '{name_of(alias)}': this module has a '{name_of(alias)}' (at {pos_str(nodes[int(syms[ex].decl)].pos)}); import it with another name: {name_of(nm)} as ...")
                o = s
                loop o != 0:
                    scope_add_module(m, alias, .fns, int(syms[o].ref), int(syms[o].decl))
                    o = int(syms[o].next)
            else:
                if let ex = modules[m].names.get(alias):
                    where = "at {pos_str(nodes[d].pos)}"
                    if syms[ex].decl != 0: where = "at {pos_str(nodes[int(syms[ex].decl)].pos)}"
                    fatal(nodes[id].pos, "cannot import '{name_of(alias)}': this module has a '{name_of(alias)}' ({where}); import it with another name: {name_of(nm)} as ...")
                ml_bump_name(alias)
                bind_module_name(m, alias, new_sym(alias, syms[s].kind, int(syms[s].ref), int(syms[s].decl)))
# The module a binding belongs to: where its declaration is (an imported binding
# keeps its declaration, so it names the module it came from).
sym_home = (s: int) -> int:
    k = syms[s].kind
    if k == .global or k == .const_: return int(globals[int(syms[s].ref)].mod)
    if k == .module or syms[s].decl == 0: return -1
    int(nodes[int(syms[s].decl)].mod)
sym_file_name = (s: int) -> str:
    h = sym_home(s)
    if h < 0: return "an import"
    path = files[int(modules[h].file)].path
    path[rfind(path, "/") + 1..]
# The overloads of a function family (the declarations of one binding otherwise)
# that module im declares itself, as (ref, decl).
import_owned = (s: int, im: int) -> (int, int)[]:
    out: (int, int)[]
    if syms[s].kind == .fns:
        o = s
        loop o != 0:
            d = int(syms[o].decl)
            if d != 0 and int(nodes[d].mod) == im: out.push((int(syms[o].ref), d))
            o = int(syms[o].next)
    else if syms[s].kind != .module and sym_home(s) == im: out.push((int(syms[s].ref), int(syms[s].decl)))
    out
# Every declaration of a binding, as (ref, decl).
family_decls = (s: int) -> (int, int)[]:
    out: (int, int)[]
    o = s
    loop o != 0:
        out.push((int(syms[o].ref), int(syms[o].decl)))
        o = if syms[o].kind == .fns: int(syms[o].next) else: 0
    out
# Does binding `name` hold every one of these declarations already?
binds_all = (ex: int, owned: (int, int)[]) -> bool:
    loop p in owned:
        found = false
        o = ex
        loop o != 0 and not found:
            if int(syms[o].decl) == p.1 and int(syms[o].ref) == p.0: found = true
            o = if syms[o].kind == .fns: int(syms[o].next) else: 0
        if not found: return false
    true
# A Dewy module already has `name` and an import brings another binding of it (s, its
# declarations `owned`): 1 keeps the module's (the import adds nothing, or the module's
# own declaration shadows a `$shadowable` one), 0 binds the import in its place (it
# outranks a `$shadowable` import). Otherwise the two collide: an error naming both.
dewy_import_clash = (m: int, name: int, s: int, owned: (int, int)[], d: int, pos: int) -> int:
    ex = modules[m].names[name]
    if binds_all(ex, owned): return 1
    rel = name_of(int(nodes[d].sval))
    spell = if nodes[d].aux2 == 1: "p\"{rel}\"" else: rel
    fix = "import the module under a name (`import {spell} as name`) or select the names you need (`from {spell} import (...)`)"
    if nodes[d].aux == 2: fix = "import it with another name: {name_of(name)} as ..."
    mine = shadowable_decls.has(int(syms[s].decl))
    if sym_home(ex) == m:
        if mine: return 1
        fatal(pos, "cannot import '{name_of(name)}' from {sym_file_name(s)}: this module declares its own '{name_of(name)}' (at {pos_str(nodes[int(syms[ex].decl)].pos)}), and the imported one is not `$shadowable`; {fix}")
    theirs = syms[ex].decl != 0 and shadowable_decls.has(int(syms[ex].decl))
    if theirs and not mine: return 0
    if mine and not theirs: return 1
    fatal(pos, "'{name_of(name)}' is imported from both {sym_file_name(ex)} and {sym_file_name(s)}; {fix}")
    1
# Bind an import's declarations of `name` (owned, as (ref, decl)) in module m,
# replacing any binding there.
bind_imported = (m: int, name: int, kind: SK, owned: (int, int)[]):
    ml_bump_name(name)
    loop i in [0..owned.len()):
        o = owned[i]
        if i == 0: bind_module_name(m, name, new_sym(name, kind, o.0, o.1))
        else: scope_add_module(m, name, kind, o.0, o.1)
# import p"x.dewy": each top-level binding x declares, bound here as if selected
# (names starting with _ stay in x, and x's own imports are not passed on).
bind_splat = (d: int, m: int, im: int):
    if modules[im].is_prelude: return
    pairs: (int, int)[]
    loop k, v in modules[im].names: pairs.push((k, v))
    loop p in pairs:
        name = p.0
        s = p.1
        if is_private(name): continue
        owned = import_owned(s, im)
        if owned.len() == 0: continue
        if files[int(modules[im].file)].path == lib_dir + "/rational.dewy" and (name_of(name) == "Rational" or name_of(name) == "RationalWord"): continue
        if modules[m].names.get(name) != none:
            if dewy_import_clash(m, name, s, owned, d, nodes[d].pos) == 1: continue
        else if files[int(modules[m].file)].is_dewy and not modules[m].is_prelude and not pos_in_lib(nodes[d].pos): splat_shadow_warning(d, m, im, name)
        bind_imported(m, name, syms[s].kind, owned)
# A splat import that shadows a prelude name warns, naming both: selecting the name, or
# importing the module `as` a name, says which is meant. Only the splat's names are probed
# (the prelude's index, nothing parsed).
splat_shadow_warning = (d: int, m: int, im: int, name: int):
    if lib_private(name): return
    from = prelude_source(name)
    if from == "" and (universe.get(name) != none or intrinsic_of(name) >= 0): from = "built in"
    if from == "": return
    loop d2 in from_imports:
        if d2 == d or int(nodes[d2].mod) != m or int(nodes[d2].sym) != im or nodes[d2].aux == 3: continue
        loop i in [0..nkids(d2)):
            if int(nodes[kid(d2, i)].name) == name: return
    shown = name_of(int(nodes[d].sval))
    stem = name_of(int(nodes[d].name))
    nm = name_of(name)
    warn(nodes[d].pos, "`{nm}` from the splat import of {shown} shadows the prelude's `{nm}` ({from}): select it, `from p\"{shown}\" import {nm}`, or import the module under a name, `import p\"{shown}\" as {stem}`")

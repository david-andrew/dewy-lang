$runtime_checks

from p"ast.jo" import NF_EXCL_FIRST
from p"ast.jo" import (NF_JUXT has_flag kid mk nkids nodes)
from p"check.jo" import (fns globals lib_dir locals new_sym universe)
from p"checker_state.dewy" import (Global)
from p"expr.jo" import (CV integer_constant ntype)
from p"type_ops.dewy" import (dt)
from p"types.jo" import (is_float is_int is_numeric prune structs types)
from p"unit_ops.dewy" import (base_dimension mk_dimension quantity_constant_scale quantity_dimension)
from p"units.jo" import (quantity_base quantity_dimension_names quantity_scales)
from p"util.jo" import (files intern line_col name_of pos_file)

UnitRareWord:type=int64<overflow='wrap'>
# A conservative denominator multiple, demanded only by a grid check. The
# bounded expression walk is O(nodes visited), with at most 16 levels. A
# zero result means unknown; every nonzero result divides a billion.
time_grid_denominator=(n:UnitRareWord depth:UnitRareWord=0):>UnitRareWord=>$unsafe {
    if n =? 0 or depth >? 16 or is_float(quantity_base(ntype(n))) {return 0}
    if is_int(quantity_base(ntype(n))) {return 1}
    let constant=quantity_constant_scale(n)
    if constant >=? 0 {
        let den=quantity_scales[constant].denominator
        return if 1000000000%den =? 0 {den} else {0}
    }
    if nodes.ptr[n].kind =? 'conv' and (nodes.ptr[n].aux =? int32(int64(CV.none_)) or nodes.ptr[n].aux =? int32(int64(CV.quantity_const))) {return time_grid_denominator(UnitRareWord(nodes.ptr[n].a) depth+1)}
    if nodes.ptr[n].kind not=? 'call' or nodes.ptr[n].sym <=? 0 {return 0}
    let d=UnitRareWord(fns.ptr[UnitRareWord(nodes.ptr[n].sym)].decl)
    if d =? 0 or files[pos_file(nodes.ptr[d].pos)].path not=? "{lib_dir}/rational.dewy" {return 0}
    let name=name_of(UnitRareWord(nodes.ptr[d].name))
    if name =? "rational" and nkids(n) =? 2 {
        let [known den]=integer_constant(kid(n 1))
        if known and den >? 0 and den <=? 1000000000 and 1000000000%den =? 0 {return den}
        return 0
    }
    if name =? "__unary_sub__" and nkids(n) =? 1 {return time_grid_denominator(kid(n 0) depth+1)}
    if nkids(n) not=? 2 or not (name in? ["__mul__" "__add__" "__sub__"]) {return 0}
    let a=time_grid_denominator(kid(n 0) depth+1)
    let b=time_grid_denominator(kid(n 1) depth+1)
    if a =? 0 or b =? 0 {return 0}
    # For sums, a*b is a conservative common denominator too. Rejecting a
    # product beyond the grid loses a proof, never admits an off-grid value.
    if a >? 1000000000//b {return 0}
    let den=a*b
    if 1000000000%den =? 0 {den} else {0}
}
time_grid_proven=(validator:UnitRareWord n:UnitRareWord):>bool=>$unsafe {
    name_of(UnitRareWord(nodes.ptr[validator].name)) in? ["_grid_error" "_grid_only"] and files[pos_file(nodes.ptr[validator].pos)].path =? "{lib_dir}/time/core.dewy" and quantity_dimension(ntype(n)) =? base_dimension(0) and time_grid_denominator(n) >? 0
}
# The time library's own type by name, as a program sees it (0 when t is another type).
time_core_type=(t0:UnitRareWord name:string):>bool=>$unsafe {
    let t=prune(t0)
    if types.ptr[t].kind not=? 'struct_' {return false}
    let d=UnitRareWord(structs.ptr[UnitRareWord(types.ptr[t].st)].decl)
    d not=? 0 and structs.ptr[UnitRareWord(types.ptr[t].st)].name =? name and files[pos_file(nodes.ptr[d].pos)].path =? "{lib_dir}/time/core.dewy"
}
# A constant time meets a `Duration` directly (time.md: "they mix"), so it is one where a `Duration` is
# wanted: `let total:Duration = 0s`. A time known only at run time goes through `convert<Duration>`.
time_constant_duration=(n:UnitRareWord from_:UnitRareWord to:UnitRareWord):>bool=>$unsafe {
    n not=? 0 and types.ptr[prune(from_)].kind =? 'quantity' and quantity_dimension(prune(from_)) =? base_dimension(0) and time_core_type(to "Duration") and not is_float(quantity_base(prune(from_))) and quantity_constant_scale(n) >=? 0
}
# (`d*1day` next to a quantity: what a calendar period is, for an operator's error)
calendar_period_why=(a:UnitRareWord b:UnitRareWord):>string=>{
    if time_core_type(ntype(a) "Days") or time_core_type(ntype(b) "Days") {return " (`1day` and `1week` are calendar periods, whose length depends on the date, so they add to dates and zoned times: for a length of time write `24hour`, or `7*24hour`)"}
    if time_core_type(ntype(a) "Months") or time_core_type(ntype(b) "Months") {return " (`1month` and `1year` are calendar periods, whose length depends on the date, so they add to dates and zoned times: for a length of time write the hours it means, such as `30*24hour`)"}
    ""
}
# (`ms*1ms` with a local `ms` number: the juxtaposed `1ms` below x that is a product with a variable, not a unit;
# 0 when there is none)
shadowed_unit_in=(x:UnitRareWord):>int64=>$unsafe {
    let k=nodes.ptr[x].kind
    if k =? 'binary' {
        if has_flag(x NF_JUXT) and (nodes.ptr[UnitRareWord(nodes.ptr[x].a)].kind =? 'int_lit' or nodes.ptr[UnitRareWord(nodes.ptr[x].a)].kind =? 'float_lit') {
            let v=UnitRareWord(nodes.ptr[x].b)
            if nodes.ptr[v].kind =? 'ident' and nodes.ptr[v].aux =? int32(1) and universe.get(UnitRareWord(nodes.ptr[v].name)) not=? none {return v}
            return 0
        }
        let left=shadowed_unit_in(UnitRareWord(nodes.ptr[x].a))
        if left not=? 0 {return left}
        return shadowed_unit_in(UnitRareWord(nodes.ptr[x].b))
    }
    0
}
# (`0s` with a local `s`: what a unit written against a number means here, for an operator's error)
hidden_unit_why=(n:UnitRareWord a:UnitRareWord b:UnitRareWord):>string=>$unsafe {
    let found=shadowed_unit_in(a)
    if found =? 0 {found=shadowed_unit_in(b)}
    if found not=? 0 {
        let [ln c]=line_col(locals.ptr[UnitRareWord(nodes.ptr[found].sym)].pos)
        let nm=name_of(UnitRareWord(nodes.ptr[found].name))
        return " (`{nm}` in a product with a number is your variable from line {ln} (type {dt(ntype(found))}), which hides the unit `{nm}`: rename the variable to use the unit)"
    }
    if not has_flag(n NF_JUXT) or nodes.ptr[a].kind not=? 'int_lit' and nodes.ptr[a].kind not=? 'float_lit' or nodes.ptr[b].kind not=? 'ident' or nodes.ptr[b].aux not=? int32(1) or is_numeric(ntype(b)) {return ""}
    let made=locals.ptr[UnitRareWord(nodes.ptr[b].sym)].pos
    let [ln c]=line_col(made)
    let nm=name_of(UnitRareWord(nodes.ptr[b].name))
    " (`{nm}` here is the local variable made on line {ln}, a {dt(ntype(b))}, which hides any unit named `{nm}`: rename the variable to use the unit)"
}
# The dimension type names and the prelude's time units, once at the start of checking.
register_quantity_names=():>void=>$unsafe {
    loop i in [0..8) {
        let dim=base_dimension(i)
        let nm=intern(quantity_dimension_names[i])
        universe[nm]=new_sym(nm 'type_' mk_dimension(dim) 0)
    }
    # Time is prelude surface. Other unit values live in units.dewy.
    let items:array<[string int64 int64]>=[["s" 1 1] ["second" 1 1] ["seconds" 1 1]
        ["ms" 1 1000] ["millisecond" 1 1000] ["milliseconds" 1 1000]
        ["us" 1 1000000] ["microsecond" 1 1000000] ["microseconds" 1 1000000]
        ["ns" 1 1000000000] ["nanosecond" 1 1000000000] ["nanoseconds" 1 1000000000]
        ["minute" 60 1] ["hour" 3600 1]]
    loop item in items {
        let nm=intern(item[0])
        let n=mk('unit_lit' 0)
        nodes.ptr[n].ival=item[1]
        nodes.ptr[n].aux=int32(item[2])
        nodes.ptr[n].aux2=1
        globals.push(Global(name=int32(nm) is_const=true init=int32(n) state=2))
        universe[nm]=new_sym(nm 'const_' globals.length - 1 0)
    }
}

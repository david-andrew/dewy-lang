# A full state drops the values nothing current reaches: bindings and their
# tombstones, result evidence, entry snapshots, loans and the newest values,
# and what their projections and terms reach. A dropped value is unknown from
# then on: it loses its facts, never gains one.
fact_compact = (s: mut FactState):
    keep: {int: bool} = {}
    work: int[]
    loop b in s.bindings:
        work.push(b.value)
        work.push(b.prior)
    loop c in s.conditional:
        work.push(c.result)
        if c.payload != 0: work.push(c.payload)
        work += c.values
    work += refine_entry
    loop loan in fact_loans: work.push(loan.capacity)
    work += fact_pending
    # (the newest values: operands of the expression being evaluated)
    loop j in [max(0, s.ids.len() - 32)..s.ids.len()): work.push(s.ids[j])
    # (terms are followed two levels: an accumulator's chain of sums is not
    # kept whole)
    depth = fill(0, work.len())
    i = 0
    loop i < work.len():
        v = work[i]
        d = depth[i]
        i += 1
        if v <= 0 or v >= fact_terms.len() or keep.has(v): continue
        keep[v] = true
        if d < 2:
            work.push(fact_terms[v].a)
            work.push(fact_terms[v].b)
            depth.push(d + 1)
            depth.push(d + 1)
        pi = fact_projection_first(s, v)
        loop pi >= 0:
            p = s.projections[pi]
            pi = fact_projection_after(s, pi)
            work.push(p.value)
            depth.push(d)
            if p.element:
                work.push(p.selector)
                depth.push(d)
    ids: int[]
    bounds: FactBound[]
    loop j in [0..s.ids.len()):
        if keep.has(s.ids[j]):
            ids.push(s.ids[j])
            bounds.push(s.bounds[j])
    projections: FactProjection[]
    loop p in s.projections:
        if keep.has(p.base) and keep.has(p.value): projections.push(p)
    differences: FactDifference[]
    loop row in s.differences:
        if keep.has(row.a) and keep.has(row.b): differences.push(row)
    s.ids = ids
    s.bounds = bounds
    s.projections = projections
    s.differences = differences
    fact_reindex(s)
    # (too little freed: stop compacting this state rather than thrash)
    s.full = ids.len() > FACT_CAP - FACT_CAP / 8
fact_collect = (s: mut FactState, boundary: int, result: int):
    fresh = 0
    loop v in s.ids:
        if v >= boundary: fresh += 1
    if fresh < 16: return
    if fact_stamp.len() < fact_terms.len(): fact_stamp += fill(0, fact_terms.len() - fact_stamp.len() + 1024)
    fact_stamp_gen += 1
    gen = fact_stamp_gen
    work: int[]
    depth: int[]
    work.push(result)
    loop b in s.bindings:
        work.push(b.value)
        work.push(b.prior)
    loop c in s.conditional:
        work.push(c.result)
        if c.payload != 0: work.push(c.payload)
        work += c.values
    work += refine_entry
    loop loan in fact_loans: work.push(loan.capacity)
    work += fact_pending
    work += fact_summary_entry
    loop entry in fact_summary_fields: work.push(entry.2)
    depth = fill(0, work.len())
    kept = 0
    i = 0
    loop i < work.len():
        v = work[i]
        d = depth[i]
        i += 1
        if v <= 0 or v >= fact_terms.len() or fact_stamp[v] == gen: continue
        fact_stamp[v] = gen
        if v >= boundary: kept += 1
        if d < 2:
            work.push(fact_terms[v].a)
            work.push(fact_terms[v].b)
            depth.push(d + 1)
            depth.push(d + 1)
        pi = fact_projection_first(s, v)
        loop pi >= 0:
            p = s.projections[pi]
            pi = fact_projection_after(s, pi)
            work.push(p.value)
            depth.push(d)
            if p.element:
                work.push(p.selector)
                depth.push(d)
        # (a row relates its endpoints: a temporary between two live values,
        # `i+1 <? n`, still says something about them)
        loop direction in [0..2):
            ri = fact_difference_head(s, v, direction)
            loop ri >= 0:
                row = s.differences[ri]
                ri = fact_difference_next(s, ri, direction)
                work.push(if direction == 0: row.a else: row.b)
                depth.push(0)
    total = 0
    loop v in s.ids:
        if fact_stamp[v] == gen: total += 1
    if (s.ids.len() - total) * 4 < s.ids.len(): return
    ids: int[]
    bounds: FactBound[]
    loop j in [0..s.ids.len()):
        if fact_stamp[s.ids[j]] == gen:
            ids.push(s.ids[j])
            bounds.push(s.bounds[j])
    projections: FactProjection[]
    loop p in s.projections:
        if p.base > 0 and p.base < fact_terms.len() and fact_stamp[p.base] == gen and p.value > 0 and p.value < fact_terms.len() and fact_stamp[p.value] == gen: projections.push(p)
    differences: FactDifference[]
    loop row in s.differences:
        if fact_stamp[row.a] == gen and fact_stamp[row.b] == gen: differences.push(row)
    s.ids = ids
    s.bounds = bounds
    s.projections = projections
    s.differences = differences
    fact_reindex(s)
# A guard decided `d % c` (c a literal above 1, `n % 2 =? 1` false): d is that remainder plus a
# multiple of c, so its ends move in to the nearest such values (n >=? 1 becomes n >=? 2), and a
# quotient of d already held here follows (`mid = n // 2` is then at least 1). O(1), plus the
# values held here only when the dividend's bounds moved: guards that decide a remainder are rare.
fact_remainder_decided = (s: mut FactState, r: int):
    if r <= 0 or r >= fact_terms.len(): return
    t = fact_terms[r]
    if t.op != .eof or t.a == 0 or t.b == 0 or t.origin <= 0 or t.origin >= nodes.len(): return
    o = t.origin
    if not (nodes[o].kind == .binary and nodes[o].op == i32(int(Tok.percent)) or nodes[o].kind == .call and fact_floor_call(o) == 2): return
    left = fact_bound(s, r); c = fact_bound(s, t.b); d = fact_bound(s, t.a)
    if left.wide or left.lo != left.hi or c.wide or c.lo != c.hi or c.lo < 2 or left.lo < 0 or left.lo >= c.lo or d.wide or fact_slot(s, t.a) < 0: return
    lo = d.lo
    hi = d.hi
    if lo > FACT_MIN + c.lo: lo += fact_floor_mod(left.lo - lo, c.lo)
    if hi < FACT_MAX - c.lo: hi -= fact_floor_mod(hi - left.lo, c.lo)
    if lo == d.lo and hi == d.hi: return
    fact_set_bound(s, t.a, FactBound(lo, hi, d.nz or lo > 0 or hi < 0))
    if not s.live: return
    loop i in [0..s.ids.len()):
        q = s.ids[i]
        if fact_terms[q].a != t.a: continue
        k = fact_quotient_divisor(s, q)
        if k <= 0: continue
        b = fact_bound(s, q)
        if b.wide: continue
        fact_set_bound(s, q, FactBound(max(b.lo, fact_floor_div(lo, k)), min(b.hi, fact_floor_div(hi, k))))
fact_floor_mod = (a: int, c: int) -> int:
    m = a % c
    if m < 0: m + c else: m
fact_floor_div = (a: int, c: int) -> int:
    q = a / c
    if a % c < 0: q - 1 else: q
# Two current bounds can bring a wide intermediate back into the host domain.
# Each endpoint needs a finite captured neighbor, never a cycle of wide terms.
# Demand-only O(incident rows), already capped at 16 per value by fact_difference.
fact_guarded_word = (s: mut FactState, value: int):
    bound = fact_bound(s, value)
    lower = bound.lo > FACT_MIN
    upper = bound.hi < FACT_MAX
    loop side in [0..2):
        ri = fact_difference_head(s, value, side)
        loop ri >= 0:
            row = s.differences[ri]
            ri = fact_difference_next(s, ri, side)
            other = if side == 1: row.b else: row.a
            q = fact_bound(s, other)
            if q.wide: continue
            if side == 1:
                if (q.hi != FACT_MAX or fact_host_value(s, other)) and fact_add_fits(q.hi, row.limit):
                    bound.hi = min(bound.hi, q.hi + row.limit)
                    upper = true
            else if row.limit != FACT_MIN:
                if (q.lo != FACT_MIN or fact_host_value(s, other)) and fact_add_fits(q.lo, -row.limit):
                    bound.lo = max(bound.lo, q.lo - row.limit)
                    lower = true
    if lower and upper:
        bound.wide = false
        bound.reason = .missing
        bound.witness = 0
        fact_set_bound(s, value, bound, true)

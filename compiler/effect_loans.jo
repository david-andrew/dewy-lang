# Frozen scoped-loan pass extracted from effects.jo.
use 'node_store.dewy'
use 'checker_state.dewy'
use 'effect_types.dewy'
use 'effect_lattice.dewy'
use 'ownership_checks.dewy'
const NF_MUT = 1
const NF_GLOBAL = 2048
const LF_MUTPARAM = 2
const LF_CAPTURE = 4
const LF_ALIAS = 8
const LF_SHARED = 1024
const LF_EXPOSED = 1048576
struct ByteLoan:
    node: int = 0
    place: PlaceIdentity = PlaceIdentity()
    writable: bool = false
    first_local: int = 0
    origin: int = 0
struct EffectLoanHost:
    error: (int, str) -> void
    route: (int) -> PlaceIdentity
    append: (int, PlaceIdentity) -> PlaceIdentity
    demand: (int) -> bool
    events: (int) -> EffectEvent[]
struct EffectLoanInput:
    nodes: *(Node[])
    lists: *(i32[])
    locals: *(Local[])
    fns: *(FnInst[])
    owners: *({int: bool})
    in_lend: int
    in_address: int
    in_length: int
    in_load: int
    in_store: int
    in_len: int
    in_runtime_assert: int
    in_static_assert: int
    in_assert: int
    host: *EffectLoanHost
el: *EffectLoanInput
el_nodes: *(Node[])
el_lists: *(i32[])
loan_stack: ByteLoan[]
loan_origins: {int: int} = {}
loan_ids: int[]
loan_generation = 0
loan_steps = 0
effect_loans_bind = (input: *EffectLoanInput) -> int:
    el = input
    el_nodes = input[0].nodes
    el_lists = input[0].lists
    0
loan_kid = (n: int, i: int) -> int: int(el_lists[0][int(el_nodes[0][n].list) + i])
loan_fail = (n: int, reason: str): el[0].host[0].error(n, "scoped loan: {reason}")
loan_owner = (n: int) -> int:
    p = el[0].host[0].route(n)
    loop i in [0..loan_stack.len()):
        if place_covers(loan_stack[i].place, p) or place_covers(p, loan_stack[i].place): return i
    -1
loan_mark = (local: int, origins: int):
    old = loan_origins.get(local) ?? 0
    if old | origins != old:
        loan_origins[local] = old | origins
        loan_generation += 1
loan_publish = (n: int, p: PlaceIdentity, origins: int):
    loop loan in loan_stack:
        if origins & loan.origin == 0: continue
        if p.root != .local or p.parent != 0 or p.declaration < loan.first_local:
            loan_fail(n, "address cannot escape the scoped expression through a store")
loan_call = (n: int):
    node = el_nodes[0][n]
    if node.aux == 2: return
    if node.aux != 0 or not el[0].host[0].demand(int(node.sym)):
        loan_fail(n, "call has no checked nonescaping storage contract")
    loop event in el[0].host[0].events(int(node.sym)):
        a = event.atom
        if a.kind == .opaque or a.kind == .escape or a.kind == .remainder:
            loan_fail(n, "call may escape or invalidate loan storage")
        p = a.place
        base = place_base(p)
        if base.root == .capture or base.root == .global: loan_fail(n, "call may access nonlocal loan storage")
        if base.root == .formal:
            i = base.declaration - 1
            if i >= 0 and i < int(node.nlist): p = el[0].host[0].append(loan_kid(n, i), p)
        loop loan in loan_stack:
            if p.declaration != 0 and (place_covers(p, loan.place) or place_covers(loan.place, p)):
                loan_fail(n, "call may access the active loan owner")
loan_visit = (n: int) -> int:
    if n == 0: return 0
    loan_steps += 1
    if loan_steps > 65536: loan_fail(n, "address analysis budget exhausted")
    node = el_nodes[0][n]
    k = node.kind
    active = loan_stack.len() != 0
    if k == .intrinsic:
        id = int(node.aux)
        if id == el[0].in_lend:
            owner = loan_kid(n, 0)
            if loan_owner(owner) >= 0: loan_fail(n, "nested conflicting loan")
            if loan_visit(loan_kid(n, 1)) != 0: loan_fail(n, "address-derived reservation")
            p = el[0].host[0].route(owner)
            if p.declaration == 0 or p.parent != 0: loan_fail(n, "owner must have stable named storage")
            if p.root == .local and int(el[0].locals[0][p.declaration].flags) & (LF_ALIAS | LF_EXPOSED | LF_SHARED | LF_CAPTURE | LF_MUTPARAM) != 0:
                loan_fail(n, "owner has a conflicting alias or exposed storage view")
            if not loan_ids.contains(n): loan_ids.push(n)
            origin = -1
            count = loan_ids.len()
            if count > 8: count = 8
            loop i in [0..count):
                if loan_ids[i] == n: origin = 1 << i
            loan_stack.push(ByteLoan(n, p, int(node.flags) & NF_MUT != 0, node.ival, origin))
            tainted = loan_visit(loan_kid(n, 2))
            loan_stack.pop()
            if tainted & origin != 0: loan_fail(n, "address cannot escape the scoped expression as its result")
            return tainted
        if id == el[0].in_address or id == el[0].in_length:
            i = loan_owner(loan_kid(n, 0))
            if i < 0: loan_fail(n, "byte operation requires an active owner loan")
            if id == el[0].in_address: return loan_stack[i].origin
            if not loan_stack[i].writable: loan_fail(n, "set_length requires a writable loan")
            if loan_visit(loan_kid(n, 1)) != 0: loan_fail(n, "address-derived length cannot be published")
            return 0
        if id == el[0].in_load or id == el[0].in_store:
            if not active: loan_fail(n, "raw byte operation requires a scoped loan")
            if id == el[0].in_load:
                if loan_visit(loan_kid(n, 0)) == 0: loan_fail(n, "raw load requires a loan-derived address")
            else:
                if loan_visit(loan_kid(n, 0)) != 0: loan_fail(n, "address cannot escape through a raw store")
                origins = loan_visit(loan_kid(n, 1))
                if origins == 0: loan_fail(n, "raw store requires a loan-derived address")
                loop loan in loan_stack:
                    if origins & loan.origin != 0 and not loan.writable: loan_fail(n, "raw write through a readonly loan")
            return 0
        if active and id == el[0].in_len and loan_owner(loan_kid(n, 0)) >= 0: return 0
    if k == .ident:
        if active and loan_owner(n) >= 0: loan_fail(n, "owner cannot be copied, resized, replaced or aliased during a loan")
        p = el[0].host[0].route(n)
        return if p.root == .local: loan_origins.get(p.declaration) ?? 0 else: 0
    if active and (k == .lambda or k == .fnref or k == .partial): loan_fail(n, "closure capture during a loan is not supported")
    if k == .block:
        result = 0
        loop j in [0..int(node.nlist)): result = loan_visit(loan_kid(n, j))
        return result
    if k == .vardecl:
        tainted = loan_visit(int(node.b))
        if tainted != 0:
            p = PlaceIdentity((if int(node.flags) & NF_GLOBAL != 0: PlaceRoot.global else: PlaceRoot.local), 0, int(node.sym))
            loan_publish(n, p, tainted)
            loan_mark(p.declaration, tainted)
        return 0
    if k == .assign:
        if active and place_base(el[0].host[0].route(int(node.a))).root != .local:
            loan_fail(n, "nonlocal replacement may invalidate loan storage")
        tainted = loan_visit(int(node.b))
        old = loan_visit(int(node.a))
        if tainted | old != 0:
            p = el[0].host[0].route(int(node.a))
            loan_publish(n, p, tainted | old)
            loan_mark(p.declaration, tainted | old)
        return 0
    if k == .return_:
        if loan_visit(int(node.a)) != 0: loan_fail(n, "address cannot escape through return")
        return 0
    if active and (k == .if_ or k == .while_ or k == .for_ or k == .match_ or k == .iflet or k == .and_ or k == .or_ or k == .coalesce):
        if loan_visit(int(node.a)) != 0: loan_fail(n, "address-derived control flow cannot publish loan bits")
    mask = oc_children(k)
    tainted = 0
    if mask >= 0:
        if mask & 1 != 0: tainted = loan_visit(int(node.a)) | tainted
        if mask & 2 != 0: tainted = loan_visit(int(node.b)) | tainted
        if mask & 4 != 0: tainted = loan_visit(int(node.c)) | tainted
        if mask & 16 != 0:
            loop j in [0..int(node.nlist)): tainted = loan_visit(loan_kid(n, j)) | tainted
    else if active: loan_fail(n, "unsupported address transform")
    if active and k == .call:
        if tainted != 0: loan_fail(n, "address cannot escape through a call or record field")
        loan_call(n)
    if active and k == .intrinsic:
        if tainted != 0: loan_fail(n, "intrinsic has no reviewed address-retention contract")
        id = int(node.aux)
        if id != el[0].in_len and id != el[0].in_runtime_assert and id != el[0].in_static_assert and id != el[0].in_assert:
            loan_fail(n, "intrinsic may invalidate loan storage")
    if tainted != 0 and (k == .tuple or k == .array): loan_fail(n, "address cannot escape through aggregate storage")
    tainted
loans_finalize = ():
    loop f, _ in el[0].owners[0]:
        loan_origins = {}
        loan_ids = []
        loan_generation = 0
        loan_stack = []
        loan_steps = 0
        loop true:
            before = loan_generation
            loan_visit(int(el[0].fns[0][f].body))
            if loan_generation == before: break
    loan_origins = {}

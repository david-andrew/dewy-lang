$runtime_checks
from p"node_store.dewy" import Node
from p"checker_types.dewy" import (TypeInfo StructInfo TK)
from p"type_inference.dewy" import (tu_prune tu_equal)
from p"type_unions.dewy" import uu_index
from p"checker_resolve.dewy" import ct_resolve_type
# `x is? T` owns its test selection: family, optional-union, union-subset, string-set,
# member-value and refinement rewrites (built by the host), then the direct tests.
# Work is O(inference links + union members) plus the demanded rewrite and check.
# Rewrite requests answer -1 when they do not apply; host calls may grow arenas.
XIWord:type=int64<overflow='wrap'>
CheckerTypeTestHost:type=[
    check:<(node:int64 expected:int64):>int64>
    finalize:<(node:int64):>int64>
    original:<(node:int64):>int64>
    family:<(type_id:int64):>bool>
    family_test:<(node:int64 original:int64 value:int64 tested:int64):>int64>
    members_test:<(node:int64 original:int64 union:int64 tested:int64 optional:bool):>int64>
    set_test:<(node:int64 original:int64 value:int64 set:int64):>int64>
    member_value:<(node:int64 original:int64 value:int64 tested:int64 set:int64):>int64>
    refined_test:<(node:int64 original:int64 tested:int64):>int64>
    implies:<(source:int64 target:int64):>bool>
    presence:<(node:int64):>int64>
    error:<(node:int64 value:int64 tested:int64 code:int64):>void>
]
CheckerTypeTestInput:type=[
    nodes:ptr<array<Node>>
    types:ptr<array<TypeInfo>>
    structs:ptr<array<StructInfo>>
    refine:ptr<bool>
    last:ptr<int64>
    string_type:ptr<int64>
    bool_type:ptr<int64>
    host:ptr<CheckerTypeTestHost>
]
let xi_nodes:ptr<array<Node>>=$unsafe (uint64(0) as ptr<array<Node>>)
let xi_types:ptr<array<TypeInfo>>=$unsafe (uint64(0) as ptr<array<TypeInfo>>)
let xi_structs:ptr<array<StructInfo>>=$unsafe (uint64(0) as ptr<array<StructInfo>>)
let xi_refine:ptr<bool>=$unsafe (uint64(0) as ptr<bool>)
let xi_last:ptr<int64>=$unsafe (uint64(0) as ptr<int64>)
let xi_string_type:ptr<int64>=$unsafe (uint64(0) as ptr<int64>)
let xi_bool_type:ptr<int64>=$unsafe (uint64(0) as ptr<int64>)
let xi_host:ptr<CheckerTypeTestHost>=$unsafe (uint64(0) as ptr<CheckerTypeTestHost>)
checker_type_tests_bind=(input:ptr<CheckerTypeTestInput>):>XIWord=>$unsafe {
    xi_nodes=input[0].nodes
    xi_types=input[0].types
    xi_structs=input[0].structs
    xi_refine=input[0].refine
    xi_last=input[0].last
    xi_string_type=input[0].string_type
    xi_bool_type=input[0].bool_type
    xi_host=input[0].host
    0
}
xi_kind=(t:XIWord):>TK=>$unsafe {xi_types[0].ptr[tu_prune(t)].kind}
xi_union=(t0:XIWord):>bool=>$unsafe {
    let t=tu_prune(t0)
    xi_types[0].ptr[t].kind =? 'enum_' and xi_structs[0].ptr[XIWord(xi_types[0].ptr[t].st)].union_
}
xi_set=(t0:XIWord):>XIWord=>$unsafe {
    let t=tu_prune(t0)
    if xi_types[0].ptr[t].kind not=? 'enum_' {return 0}
    XIWord(xi_structs[0].ptr[XIWord(xi_types[0].ptr[t].st)].lit_set)
}
# A refinement's representation: its base type.
xi_representation=(t0:XIWord):>XIWord=>$unsafe {
    let t=tu_prune(t0)
    if xi_types[0].ptr[t].kind =? 'refined' {return tu_prune(XIWord(xi_types[0].ptr[t].elem))}
    t
}
# The test's type: bool, or a rewrite's checked type. Errors (codes 1-3) never return.
xi_check=(n:XIWord):>XIWord=>$unsafe {
    # A variable or field path, copied before checking: rewrites test it again.
    let orig=xi_host[0].original(XIWord(xi_nodes[0].ptr[n].a))
    xi_host[0].check(XIWord(xi_nodes[0].ptr[n].a) 0);
    xi_nodes[0][n].a=int32<overflow='wrap'>(xi_last[0])
    xi_host[0].finalize(XIWord(xi_nodes[0].ptr[n].a));
    let at=tu_prune(XIWord(xi_nodes[0].ptr[XIWord(xi_nodes[0].ptr[n].a)].type))
    let tt=ct_resolve_type(XIWord(xi_nodes[0].ptr[n].b))
    # Family annotations (unions or optionals only) select the tested value's members.
    let tk=xi_kind(tt)
    if xi_nodes[0].ptr[XIWord(xi_nodes[0].ptr[n].b)].aux not=? -7 and (xi_union(tt) or tk =? 'opt') and xi_host[0].family(tt) {
        return xi_host[0].family_test(n orig at tt)
    }
    # x is A | B, where x: (A | B | C)?: x is not none and is one of them.
    if xi_types[0].ptr[at].kind =? 'opt' and xi_union(XIWord(xi_types[0].ptr[at].elem)) and xi_types[0].ptr[tt].kind not=? 'none_lit' {
        let r=xi_host[0].members_test(n orig tu_prune(XIWord(xi_types[0].ptr[at].elem)) tt true)
        if r >=? 0 {return r}
    }
    # x is A | B, where x: A | B | C: x is A or x is B.
    if xi_union(at) and xi_union(tt) and uu_index(at tt) <? 0 {
        let r=xi_host[0].members_test(n orig at tt false)
        if r >=? 0 {return r}
    }
    # x is? 'a' on a string (or another set's word): compared with each member.
    let set=xi_set(tt)
    if set not=? 0 and not xi_union(at) and (at =? xi_string_type[0] or xi_set(at) not=? 0) {
        return xi_host[0].set_test(n orig at set)
    }
    # x is? 1 or x is? 'fast' on a union with such a member: that member, then its value.
    if xi_union(at) and (xi_types[0].ptr[tt].kind =? 'refined' or set not=? 0) and uu_index(at tt) <? 0 {
        let r=xi_host[0].member_value(n orig at tt set)
        if r >=? 0 {return r}
    }
    # x is? 1, x is? -1|1, x is? int64<(<? 100)>: the refinement's comparisons.
    if xi_types[0].ptr[tt].kind =? 'refined' and xi_kind(xi_representation(tt)) =? 'int_' and xi_kind(xi_representation(at)) =? 'int_' and not xi_union(at) {
        return xi_host[0].refined_test(n orig tt)
    }
    if xi_union(at) {
        let vi=uu_index(at tt)
        if vi <? 0 {xi_host[0].error(n at tt 1)}
        xi_nodes[0][n].aux=int32<overflow='wrap'>(vi)
    } else if xi_types[0].ptr[at].kind =? 'opt' {
        let elem=XIWord(xi_types[0].ptr[at].elem)
        if xi_types[0].ptr[tt].kind =? 'none_lit' {xi_nodes[0][n].aux=-1}
        else if tu_equal(tt elem) or (xi_refine[0] and xi_host[0].implies(elem tt)) {xi_nodes[0][n].aux=-2}
        else {xi_host[0].error(n at tt 2)}
        xi_nodes[0][n].aux2=int32<overflow='wrap'>(xi_host[0].presence(XIWord(xi_nodes[0].ptr[n].a)))
    } else if tu_equal(at tt) or (xi_union(tt) and uu_index(tt at) >=? 0) {
        # Already narrowed to it: always true.
        xi_nodes[0][n].aux=-3
    } else {xi_host[0].error(n at tt 3)}
    xi_bool_type[0]
}

$runtime_checks
from p"checker_source_positions.dewy" import (dewy_at)
from p"ast.jo" import (kid nkids nodes)
from p"directives.jo" import (dir_runtime_policies)
from p"expr.jo" import (setting_value_targets setting_value_wrapped)
from p"util.jo" import (pos_in_lib)

PolicyQueryWord:type=int64<overflow='wrap'>

setting_value_target=(n:PolicyQueryWord):>PolicyQueryWord=>{
    if nodes[n].kind not=? 'block' or nkids(n) =? 0 {return n}
    let target=setting_value_targets.get(n) ?? 0
    if target =? 0 {return n}
    let tail=kid(n PolicyQueryWord(nkids(n)) - 1)
    if nodes[tail].kind =? 'exprstmt' {tail=PolicyQueryWord(nodes[tail].a)}
    if tail =? target {return target}
    if tail not=? n and setting_value_target(tail) =? target {return target}
    n
}

setting_value_needed=(n:PolicyQueryWord):>bool=>{
    dir_runtime_policies.length not=? 0 and not setting_value_wrapped.has(n) and dewy_at(nodes[n].pos) and not pos_in_lib(nodes[n].pos)
}

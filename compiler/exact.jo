# Exact fixed-width values keep their source storage type in the checked tree.
# Only a storage boundary narrows. Owner and node indexes make preparation
# O(F log F + N + E) for F demanded owners and their N nodes/E edges.
# Fact transfer uses the existing indexed, bounded-budget engine. Unrelated
# bodies need no new walk. Multiword division states its separate width cost below.
use 'facts.jo'
use 'facts_arith.dewy'
use 'facts_ranges.dewy'
use 'facts_joins.dewy'
use 'facts_progress.dewy'
use 'lower.jo'
use 'node_store.dewy'
use 'lower_primitives.dewy'
use 'ir_builders.dewy'
use 'math_ops.dewy'
use 'isolation_ops.dewy'
use 'exact_measure.dewy'
use 'exact_cold_walk.dewy'
use 'facts_value_queries.dewy'
use 'facts_index_writes.dewy'
use 'facts_lengths.dewy'

# exact_potential and exact_math_operand run in checker_exact.dewy.
exact_query_input = CheckerExactInput(&nodes, &lists, &types, &files, &T_INT, &T_U64, &T_MATH_INT)
exact_query_binding = checker_exact_bind(&exact_query_input)

# Secret wrapping changes visibility, never an integer's arithmetic domain.
exact_representation = (t0: int) -> int:
    t = representation_type(t0)
    loop types[t].kind == .secret: t = representation_type(int(types[t].elem))
    t

struct ExactMeasure:
    owner: int
    type: int
    category: str
    lo: int = 0
    hi: int = 0

exact_measure_on = false
exact_measure_sites: {int: ExactMeasure} = {}

exact_lower_active = false
exact_owners: {int: bool} = {}
exact_full_owners: {int: bool} = {}
exact_candidate_heads: int[]
exact_candidate_nodes: int[]
exact_candidate_next: int[]
exact_demands: {int: bool} = {}
exact_proof_demands: {int: bool} = {}
# The functions GPU programs run, as the checker meets them: compute(f) and a fused GPU array
# expression's function literal. A shader cannot check a fixed-width store, so their stores
# and their callees' are proved even where runtime checks are on (exact_shader_demand).
exact_shader_roots: int[]
exact_shader_owners: {int: bool} = {}
exact_rep_demands: bool[]
exact_rep_owners: bool[]
exact_effect_owners: bool[]
exact_local_widths: int[]
exact_raw_values: u8[]
exact_progress_math: {int: bool} = {}
exact_word_reads: {int: bool} = {}
exact_initializers: int[]
exact_iteration_sources: int[]
exact_progress_assignments: int[]
exact_write_heads: int[]
exact_write_values: int[]
exact_write_plain: bool[]
exact_write_targets: int[]
exact_write_seen: int[]
exact_write_controls: int[]
exact_control_values: int[]
exact_control_parents: int[]
exact_control_head = 0
exact_lower_sites: int[]
exact_collect_writes = false
exact_progress_opaque: bool[]
exact_write_next: int[]
exact_dependency_seen: int[]
exact_dependency_epoch = 0
exact_dependency_budget = 0
exact_nodes: int[]
exact_stores: {int: int} = {}
exact_widths: int[]
exact_shifts: {int: int} = {}
# Dense membership for the fact-transfer hot path; maps retain sparse iteration.
# Preparation allocates O(N) bits once and writes each demanded node once.
exact_marks: u8[]
exact_has_node = (n: int) -> bool: not exact_loop_fast and n >= 0 and n < exact_marks.len() and exact_marks[n] & 1 != 0
exact_has_store = (n: int) -> bool: n >= 0 and n < exact_marks.len() and exact_marks[n] & 2 != 0
exact_decided = (n: int) -> bool: exact_marks[n] & 8 != 0
exact_proved = (n: int) -> bool: exact_marks[n] & 16 != 0
exact_decide = (n: int, proven: bool):
    exact_marks[n] = (exact_marks[n] & 239) | 8 | (if proven: 16 else: 0)
exact_mark = (n: int):
    if n >= exact_marks.len(): exact_reserve(n)
    if exact_marks[n] & 1 == 0: exact_nodes.push(n)
    exact_marks[n] |= 1
exact_unmark = (n: int):
    exact_marks[n] &= 254

exact_type = (t0: int, pos: int) -> bool:
    # The common implementation words have no wrappers or overflow policy.
    if t0 == T_INT or t0 == T_U64: return dewy_at(pos)
    if t0 == T_MATH_INT: return false
    t = exact_representation(t0)
    if not is_int(t) or t == T_MATH_INT or int_policy(t) != 0: return false
    # Jo's implementation word remains a machine word. Narrow Jo integers
    # and every Dewy fixed-width integer have storage-only widths.
    dewy_at(pos) or types[t].bits < 64

# Distribute a demanded scalar conversion into selected value arms. This
# preserves evaluation order and puts the fit check on the executed arm only.
exact_narrow_control = (n: int, to: int) -> bool:
    k = nodes[n].kind
    if k == .block and nodes[n].aux != 0:
        coerce(block_value(n), to)
    else if k == .if_ or k == .iflet:
        loop arm in [int(nodes[n].b), int(nodes[n].c)]:
            if ntype(arm) != T_NEVER and not exact_narrow_control(arm, to): coerce(arm, to)
    else if k == .match_:
        loop arm in kids(n):
            body = int(nodes[arm].b)
            if ntype(body) != T_NEVER and not exact_narrow_control(body, to): coerce(body, to)
    else: return false
    nodes[n].type = i32(to)
    true

exact_word_formats: {int: bool} = {}

exact_format_word = (n: int, writer: str, buffer: int, pos: int) -> bool:
    if nodes[n].kind != .conv: return false
    source = exact_math_operand(n)
    if source == n: return false
    # This runs before exact preparation. Source storage types are not yet
    # arithmetic width facts; a positive remainder alone supplies its own bound.
    if positive_modulus(source) <= 0: return false
    decl = resolve_by_types(intern(writer), [buffer, T_MATH_INT], pos, true, true)
    if writer == "__dewy_fmt":
        if files[pos_file(nodes[decl].pos)].path != lib_dir + "/core/fmt.jo" or not fn_sig(decl).generic: return false
        decl = resolve_by_types(intern("__fmt"), [buffer, T_MATH_INT], pos, true, true)
    files[pos_file(nodes[decl].pos)].path == lib_dir + "/math_int.jo"

exact_int_result = (n: int, observe_unsigned: bool = false) -> int:
    if not dewy_at(nodes[n].pos): return ntype(n)
    if ntype(n) != T_INT and not (observe_unsigned and exact_type(ntype(n), nodes[n].pos) and exact_potential(n)): return ntype(n)
    wrap_conv(n, .int_, T_MATH_INT)
    exact_note(int(nodes[n].a))
    T_MATH_INT

exact_operation = (n: int) -> bool:
    k = nodes[n].kind
    if k == .intrinsic: return nodes[n].aux == i32(int(IN.fixed_abs))
    if k == .unary:
        if nodes[n].op != i32(int(Tok.minus)): return false
    else if k == .binary and nodes[n].aux == 0:
        op = nodes[n].op as Tok
        if op != .plus and op != .minus and op != .star and op != .starstar and op != .slash and op != .shl: return false
    else: return false
    if nodes[n].type == 0 or not exact_type(ntype(n), nodes[n].pos): return false
    k != .binary or nodes[n].op != i32(int(Tok.slash)) or types[exact_representation(ntype(n))].sign

exact_note = (n: int):
    if cx < 0: return
    control = nodes[n].kind == .if_ or nodes[n].kind == .iflet or nodes[n].kind == .coalesce or nodes[n].kind == .match_
    bitwise = nodes[n].kind == .binary and (nodes[n].op == i32(int(Tok.amp)) or nodes[n].op == i32(int(Tok.pipe)) or nodes[n].op == i32(int(Tok.caret)))
    if not exact_operation(n) and not ((control or bitwise) and exact_potential(n)) and not (nodes[n].kind == .conv and nodes[n].aux == i32(int(CV.int2float)) and exact_potential(int(nodes[n].a))) and not (exact_measure_on and exact_measure_candidate(n)): return
    f = int(ctxs[cx].inst)
    if f > 0:
        exact_owners[f] = true
        if f >= exact_candidate_heads.len(): exact_candidate_heads.resize(max(f + 1, fns.len()))
        exact_candidate_nodes.push(n)
        exact_candidate_next.push(exact_candidate_heads[f])
        exact_candidate_heads[f] = exact_candidate_nodes.len()

# The exact midpoint lo + floor((hi-lo)/2) is floor((lo+hi)/2),
# hence remains a signed word even when the difference needs 65 bits.
# Match only repeated plain local reads: no calls, aliases, or reordered effects.
exact_midpoint = (n: int) -> (int, int):
    empty = (0, 0)
    if nodes[n].kind != .binary or nodes[n].aux != 0 or nodes[n].op != i32(int(Tok.plus)) or not dewy_at(nodes[n].pos): return empty
    lo = int(nodes[n].a)
    quotient = int(nodes[n].b)
    if nodes[quotient].kind != .binary or nodes[quotient].aux != 0 or nodes[quotient].aux2 != -1 or nodes[quotient].op != i32(int(Tok.slash)): return empty
    divisor = int(nodes[quotient].b)
    if nodes[divisor].kind != .int_lit or nodes[divisor].ival != 2: return empty
    difference = int(nodes[quotient].a)
    if nodes[difference].kind != .binary or nodes[difference].aux != 0 or nodes[difference].op != i32(int(Tok.minus)): return empty
    hi = int(nodes[difference].a)
    repeated = int(nodes[difference].b)
    loop value in [lo, hi, repeated]:
        if nodes[value].kind != .ident or nodes[value].aux != i32(int(SK.local)) or ntype(value) != T_INT: return empty
        fl = int(locals[int(nodes[value].sym)].flags)
        if fl & (LF_MUTPARAM | LF_CAPTURE | LF_ALIAS | LF_BYREF | LF_ADDR | LF_SHARED | LF_EXPOSED) != 0: return empty
    if nodes[lo].sym != nodes[repeated].sym: return empty
    (lo, hi)

# Context-free width facts are demanded only by a storage boundary. Cache one
# signed width and a nonnegative bit per expression; 0 means not computed and
# -1 means unknown. Other negative entries are negated constant widths, with
# their magnitudes in the parallel node index.
# Each demanded edge is visited once: O(N+E) time/O(N) space, no separate walk.
# Constants use a signed magnitude with one unsigned word. Overflow of that
# bounded representation falls back to width bounds, never host-word wrapping.
exact_type_widths: int[]
exact_type_values: u64[]

exact_constant_width = (n: int, magnitude: u64, negative0: bool) -> int:
    negative = negative0 and magnitude != 0
    value = magnitude - u64(negative)
    bits = 1
    loop shift in [32, 16, 8, 4, 2, 1]:
        if value >> shift != 0:
            value = value >> shift
            bits += shift
    if value != 0: bits += 1
    width = bits * 2 + int(not negative)
    exact_type_values[n] = magnitude
    exact_type_widths[n] = -width
    width

# Both child widths have already been demanded. Constant folding therefore
# does O(1) work at this node; no recursive evaluator or fact state is needed.
exact_fold_binary = (n: int, ai: int, bi: int) -> int:
    x = exact_type_values[int(nodes[n].a)]; y = exact_type_values[int(nodes[n].b)]
    an = ai & 1 == 0; bn = bi & 1 == 0
    op = nodes[n].op as Tok
    value = u64(0)
    negative = false
    limit = u64(0xFFFFFFFFFFFFFFFF)
    if op == .plus or op == .minus:
        if op == .minus: bn = not bn
        if an == bn:
            if x > limit - y: return 0
            value = x + y
            negative = an
        else if x >= y:
            value = x - y
            negative = an
        else:
            value = y - x
            negative = bn
    else if op == .star:
        if y != 0 and x > limit / y: return 0
        value = x * y
        negative = an != bn
    else if op == .slash or op == .percent:
        if y == 0: return 0
        quotient = x / y
        remainder = x % y
        floor = nodes[n].aux2 == -1
        if op == .slash:
            value = quotient
            negative = an != bn
            if floor and negative and remainder != 0: value += 1
        else:
            value = remainder
            negative = an
            if floor and an != bn and remainder != 0:
                value = y - remainder
                negative = bn
    else if op == .amp or op == .pipe or op == .caret:
        if an: x = 0 - x
        if bn: y = 0 - y
        if op == .amp:
            value = x & y
            negative = an and bn
        else if op == .pipe:
            value = x | y
            negative = an or bn
        else:
            value = x xor y
            negative = an != bn
        if negative:
            value = 0 - value
            if value == 0: return 0 # -2**64 exceeds the magnitude word
    else if op == .shl or op == .shr:
        if bn: return 0
        negative = an
        if op == .shl:
            if x == 0: value = 0
            else:
                if y >= 64 or x > limit >> int(y): return 0
                value = x << int(y)
        else if y >= 64: value = u64(an)
        else:
            value = x >> int(y)
            if an and x & ((u64(1) << int(y)) - 1) != 0: value += 1
    else if op == .starstar:
        if bn: return 0
        negative = an and y & 1 != 0
        value = 1
        loop y != 0:
            if y & 1 != 0:
                if x != 0 and value > limit / x: return 0
                value *= x
            y = y >> 1
            if y != 0:
                if x != 0 and x > limit / x: return 0
                x *= x
    else: return 0
    exact_constant_width(n, value, negative)

exact_constant_fits = (width: int, t: int) -> bool:
    t == T_MATH_INT or (if types[t].sign: width / 2 <= types[t].bits else: width & 1 != 0 and width / 2 <= types[t].bits + 1)

exact_type_width = (n: int, constant_only: bool = false) -> int:
    if n < exact_type_widths.len() and exact_type_widths[n] != 0:
        cached = exact_type_widths[n]
        if cached < -1: return -cached
        return if constant_only: -1 else: cached
    if n >= exact_type_widths.len():
        exact_type_widths.resize(max(n + 1, nodes.len()))
        exact_type_values.resize(exact_type_widths.len())
    k = nodes[n].kind
    if k == .int_lit:
        value = nodes[n].ival
        magnitude = u64(value)
        result = 131
        if value >= 0 or not has_flag(n, NF_U64):
            if value < 0: magnitude = 0 - magnitude
            high = if value < 0: -(value + 1) else: value
            bits = 1
            loop shift in [32, 16, 8, 4, 2, 1]:
                if high >> shift != 0:
                    high = high >> shift
                    bits += shift
            if high != 0: bits += 1
            result = bits * 2 + int(value >= 0)
        exact_type_values[n] = magnitude
        exact_type_widths[n] = -result
        return result
    # A constant binding may refer back to a node already being queried.
    exact_type_widths[n] = -1
    t = exact_representation(ntype(n))
    result = -1
    if k == .ident:
        global = nodes[n].aux == i32(int(SK.global))
        if constant_only and global: return -1
        initial = 0
        if is_int(t) and int_policy(t) == 0:
            ref = int(nodes[n].sym)
            if global:
                if readonly_global(ref) and not globals[ref].exposed: initial = int(nodes[int(globals[ref].decl)].b)
            else if nodes[n].aux == i32(int(SK.local)) and int(locals[ref].flags) & (LF_CONST | LF_CAPTURE) == LF_CONST:
                initial = int(locals[ref].const_init)
        if initial != 0:
            width = exact_type_width(initial, true)
            index = exact_type_widths[initial]
            if index < -1 and exact_constant_fits(width, t):
                # A stored global is zero until its initializer runs. Its
                # width includes zero, but it is not a singleton constant.
                exact_type_widths[n] = if global: width else: index
                if not global: exact_type_values[n] = exact_type_values[initial]
                return width
        if not constant_only and is_int(t) and t != T_MATH_INT: result = (int(types[t].bits) + int(not types[t].sign)) * 2 + int(not types[t].sign)
        exact_type_widths[n] = result
        return result
    if k == .conv and is_int(t) and int_policy(t) == 0 and (nodes[n].aux == i32(int(CV.int_)) or nodes[n].aux == i32(int(CV.none_))):
        width = exact_type_width(int(nodes[n].a), constant_only)
        index = exact_type_widths[int(nodes[n].a)]
        if width > 0 and exact_constant_fits(width, t):
            exact_type_widths[n] = index
            if index < -1: exact_type_values[n] = exact_type_values[int(nodes[n].a)]
            return width
    # Unexpanded mathematical constants and stored bitwise operations also
    # have exact arithmetic semantics. Jo/policy words keep their own rules.
    if (k == .binary or k == .unary) and (constant_only or not exact_has_node(n)) and is_int(t) and int_policy(t) == 0 and dewy_at(nodes[n].pos):
        if k == .binary and nodes[n].aux == 0:
            exact_type_width(int(nodes[n].a), constant_only); exact_type_width(int(nodes[n].b), constant_only)
            ai = exact_type_widths[int(nodes[n].a)]; bi = exact_type_widths[int(nodes[n].b)]
            if ai < -1 and bi < -1:
                folded = exact_fold_binary(n, ai, bi)
                if folded > 0: return folded
        else if k == .unary and nodes[n].op == i32(int(Tok.minus)):
            exact_type_width(int(nodes[n].a), constant_only)
            index = exact_type_widths[int(nodes[n].a)]
            if index < -1:
                return exact_constant_width(n, exact_type_values[int(nodes[n].a)], index & 1 != 0)
    # Initializers can belong to an owner not prepared yet. Only an actual
    # constant is usable there; a source storage type is not an exact bound.
    if constant_only: return -1
    if exact_word_reads.has(n):
        bound = exact_count_bound(int(nodes[n].a))
        magnitude = max((if bound.lo < 0: -(bound.lo + 1) else: bound.lo), (if bound.hi < 0: -(bound.hi + 1) else: bound.hi))
        bits = 1
        loop shift in [32, 16, 8, 4, 2, 1]:
            if magnitude >> shift != 0:
                magnitude = magnitude >> shift
                bits += shift
        if magnitude != 0: bits += 1
        result = bits * 2 + int(bound.lo >= 0)
    else if not exact_has_node(n):
        if is_int(t) and t != T_MATH_INT: result = (int(types[t].bits) + int(not types[t].sign)) * 2 + int(not types[t].sign)
    else if k == .unary:
        a = exact_type_width(int(nodes[n].a))
        index = exact_type_widths[int(nodes[n].a)]
        if index < -1 and nodes[n].op == i32(int(Tok.minus)):
            return exact_constant_width(n, exact_type_values[int(nodes[n].a)], index & 1 != 0)
        if a > 0: result = (a / 2 + 1) * 2
    else if k == .binary:
        a = exact_type_width(int(nodes[n].a)); b = exact_type_width(int(nodes[n].b))
        ai = exact_type_widths[int(nodes[n].a)]; bi = exact_type_widths[int(nodes[n].b)]
        if ai < -1 and bi < -1:
            folded = exact_fold_binary(n, ai, bi)
            if folded > 0: return folded
        op = nodes[n].op as Tok
        if op == .amp:
            if a > 0 and a & 1 != 0: result = a
            if b > 0 and b & 1 != 0: result = if result < 0: b else: min(result, b)
        else if a > 0 and b > 0:
            if op == .plus or op == .minus: result = (max(a / 2, b / 2) + 1) * 2 + int(op == .plus and a & b & 1 != 0)
            else if op == .star: result = (a / 2 + b / 2) * 2 + (a & b & 1)
            else if op == .pipe or op == .caret: result = max(a / 2, b / 2) * 2 + (a & b & 1)
        if op == .slash and a > 0:
            known, divisor = integer_constant(int(nodes[n].b))
            if known and divisor != 0 and divisor != -1:
                bits = a / 2
                # A positive divisor removes floor(log2(divisor)) magnitude
                # bits, including the asymmetric negative signed endpoint.
                if divisor > 1:
                    loop divisor > 1:
                        bits -= 1
                        divisor = divisor >> 1
                result = max(1, bits) * 2 + int(divisor > 0 and a & 1 != 0)
        if op == .percent and dewy_at(nodes[n].pos):
            known, divisor = integer_constant(int(nodes[n].b))
            if known and divisor > 0 and b > 0: result = b
    # Stored remainders and masks still carry a small range into a wider
    # surrounding expression, even when the operation itself needed no widening.
    if k == .binary and nodes[n].aux == 0 and not exact_has_node(n) and dewy_at(nodes[n].pos) and is_int(t) and t != T_MATH_INT:
        op = nodes[n].op as Tok
        if op == .percent or op == .amp:
            known, limit = integer_constant(int(nodes[n].b))
            if known and limit > 0:
                width = exact_type_width(int(nodes[n].b))
                if width > 0: result = width
    # A literal right shift consumes high signed bits even when its source
    # is an ordinary stored word. Keep this fact at the demanded consumer.
    if k == .binary and nodes[n].op == i32(int(Tok.shr)) and nodes[n].aux == 0 and dewy_at(nodes[n].pos) and is_int(t) and t != T_MATH_INT and int_policy(t) == 0:
        known, count = integer_constant(int(nodes[n].b))
        if known and count >= 0 and count < 64:
            a = exact_type_width(int(nodes[n].a))
            if a > 0: result = max(1, a / 2 - count) * 2 + (a & 1)
    midpoint = exact_midpoint(n)
    if midpoint.0 != 0: result = 128
    exact_type_widths[n] = result
    result

# Demand proofs of the exact stores in GPU programs' functions and the program's functions they
# call (exact_shader_roots), before the facts pass chooses its bodies: those it must visit.
# O(their nodes), once.
exact_shader_demand = () -> int[]:
    seen: {int: bool} = {}
    out: int[]
    work = exact_shader_roots
    exact_shader_roots = []
    loop work.len() > 0:
        f = work.pop()
        if f <= 0 or f >= fns.len() or seen.has(f) or fns[f].body == 0 or fn_in_lib(f): continue
        seen[f] = true
        exact_shader_owners[f] = true
        out.push(f)
        exact_shader_calls(int(fns[f].body), work)
    out

# A boundary wrapper has the same ABI and type as the value it stores.
exact_store = (n: int, owner: int):
    if not exact_has_node(n) or exact_has_store(n): return
    t = ntype(n)
    if not exact_type(t, nodes[n].pos): return
    k = nodes[n].kind
    if k == .block and nodes[n].aux != 0:
        exact_store(block_value(n), owner)
        exact_unmark(n)
        return
    if k == .if_ or k == .iflet or k == .match_:
        if k == .match_:
            loop arm in kids(n): exact_store(int(nodes[arm].b), owner)
        else:
            exact_store(int(nodes[n].b), owner)
            exact_store(int(nodes[n].c), owner)
        exact_unmark(n)
        return
    width = exact_type_width(n)
    fits = width > 0 and (if types[exact_representation(t)].sign: width / 2 <= types[exact_representation(t)].bits else: width & 1 != 0 and width / 2 <= types[exact_representation(t)].bits + 1)
    if fits:
        if exact_measure_on: exact_measure_sites[n] = ExactMeasure(owner, t, "proven")
        return
    inner = nodes.len()
    nodes.push(nodes[n])
    if let shift = exact_shifts.get(n): exact_shifts[inner] = shift
    exact_mark(inner)
    nodes[n] = Node(kind = .conv, pos = nodes[inner].pos, a = i32(inner), aux = i32(int(CV.fixed_store)), type = i32(t), flags = i32(NF_CHECKED))
    exact_unmark(n)
    exact_stores[n] = owner
    exact_marks[n] |= 2
    if n < exact_type_widths.len(): exact_type_widths[n] = 0
    if exact_measure_on: exact_measure_sites[n] = ExactMeasure(owner, t, "runtime-check")

# Only immutable names can supply a context-free initializer. Stored globals
# remain loads, and their word bound includes the value before initialization.
exact_named_constant = (n: int) -> bool:
    if nodes[n].kind != .ident: return false
    if nodes[n].aux == i32(int(SK.global)):
        g = int(nodes[n].sym)
        return readonly_global(g) and not globals[g].exposed
    nodes[n].aux == i32(int(SK.local)) and int(locals[int(nodes[n].sym)].flags) & LF_CONST != 0

exact_constant_use = (n: int) -> bool:
    if exact_named_constant(n): return true
    if nodes[n].kind == .binary and nodes[n].aux == 0:
        return exact_named_constant(int(nodes[n].a)) or exact_named_constant(int(nodes[n].b))
    false

# After checking has seen every write, an immutable mathematical local with a
# word-sized initializer can feed static exact arithmetic without a tagged
# temporary. The conversion is a representation proof, not a fit obligation.
exact_prepare_operand = (n: int) -> int:
    word = exact_math_operand(n)
    if word != n or prune(ntype(n)) != T_MATH_INT: return word
    if nodes[n].kind == .conv and nodes[n].aux == i32(int(CV.int_)):
        source = int(nodes[n].a)
        t = exact_representation(ntype(source))
        # A stored signed policy word has the same value when lifted to int.
        # Keep its policy operation intact beneath an identity conversion.
        if is_int(t) and types[t].sign and types[t].bits == 64:
            word = mk(.conv, nodes[n].pos)
            nodes[word] = Node(kind = .conv, pos = nodes[n].pos, a = i32(source), aux = i32(int(CV.none_)), type = i32(T_INT), flags = i32(NF_CHECKED))
            return word
    if nodes[n].kind != .ident: return n
    # A local constant may be an inferred `int`. Stored globals retain their
    # read and include their initial zero in exact_count_bound below.
    local = nodes[n].aux == i32(int(SK.local))
    if local and int(locals[int(nodes[n].sym)].flags) & LF_CONST != 0:
        width = exact_type_width(n)
        index = exact_type_widths[n]
        if index < -1 and width / 2 <= 64:
            value = int(exact_type_values[n])
            if index & 1 == 0: value = -value
            word = mk(.int_lit, nodes[n].pos)
            nodes[word].type = i32(T_INT)
            nodes[word].ival = value
            add_flag(word, NF_CHECKED)
            return word
    if not local and nodes[n].aux != i32(int(SK.global)): return n
    bound = exact_count_bound(n)
    if bound.wide: return n
    word = mk(.conv, nodes[n].pos)
    nodes[word].a = i32(n)
    nodes[word].aux = i32(int(CV.int_))
    nodes[word].type = i32(T_INT)
    exact_word_reads[word] = true
    word

exact_prepare_math = (n: int) -> bool:
    if nodes[n].kind != .call and nodes[n].kind != .binary and nodes[n].kind != .unary: return false
    if nodes[n].aux != 0 or prune(ntype(n)) != T_MATH_INT or not dewy_at(nodes[n].pos): return false
    if nodes[n].kind == .unary:
        if nodes[n].op != i32(int(Tok.minus)): return false
        a = exact_prepare_operand(int(nodes[n].a))
        if exact_representation(ntype(a)) != T_INT: return false
        nodes[n].a = i32(a)
        nodes[n].type = i32(T_INT)
        wrap_conv(n, .int_, T_MATH_INT)
        return true
    if nodes[n].kind == .call:
        floor = fact_floor_call(n)
        if floor < 1 or floor > 4: return false
        a = exact_prepare_operand(kid(n, 0)); b = exact_prepare_operand(kid(n, 1))
        if exact_representation(ntype(a)) != T_INT or exact_representation(ntype(b)) != T_INT: return false
        nodes[n] = Node(kind = .binary, pos = nodes[n].pos, a = i32(a), b = i32(b), type = i32(T_INT), op = i32(int((if floor == 1: Tok.slash else if floor == 2: Tok.percent else if floor == 3: Tok.shr else: Tok.amp))), aux2 = -1, flags = i32(NF_CHECKED))
        wrap_conv(n, .int_, T_MATH_INT)
        return true
    if nodes[n].kind != .binary: return false
    op = nodes[n].op as Tok
    right = int(nodes[n].b)
    if op == .shl or op == .shr:
        # Dynamic int64 shifts preserve unsigned count interpretation in a
        # wrapper. A final nonnegative bound proves that wrapper is an identity.
        count_type = exact_representation(ntype(right))
        if nodes[right].kind == .conv and nodes[right].aux == i32(int(CV.wrap_int)) and is_int(count_type) and not types[count_type].sign and types[count_type].bits == 64:
            source = int(nodes[right].a)
            if exact_bounded_count(source): right = source
        known, count = integer_constant(right)
        if not known or count < 0 or count >= 1048576:
            if not exact_bounded_count(right): return false
    else if op != .plus and op != .minus and op != .star and op != .amp and op != .pipe and op != .caret: return false
    a = exact_prepare_operand(int(nodes[n].a)); b = exact_prepare_operand(right)
    if exact_representation(ntype(a)) != T_INT: return false
    if exact_representation(ntype(b)) != T_INT:
        # A bounded shift count keeps its original fixed storage width.
        if op != .shl and op != .shr or not is_int(ntype(b)) or prune(ntype(b)) == T_MATH_INT: return false
    nodes[n].a = i32(a); nodes[n].b = i32(b)
    nodes[n].type = i32(T_INT)
    wrap_conv(n, .int_, T_MATH_INT)
    true

# Children of arithmetic and value controls remain intermediates. Other
# consumers take stored values (including call actuals and aggregate fields).
exact_prepare_node = (n: int, owner: int, store: bool):
    if n <= 0: return
    # Scalar leaves carry no arithmetic or writes. Strings may contain
    # interpolation expressions, so retain their ordinary child traversal.
    if (nodes[n].kind >= .int_lit and nodes[n].kind <= .ident) and nodes[n].kind != .str_lit: return
    if n >= exact_marks.len(): exact_reserve(n)
    if exact_marks[n] & 4 != 0:
        if store: exact_store(n, owner)
        return
    exact_marks[n] |= 4
    # Reveal/wrap nodes around scalar arithmetic are representation identities.
    # Keep the checked visibility type, but do not make them storage boundaries.
    # Refinement conversions retain their own nodes and redacted diagnostics.
    loop nodes[n].kind == .conv and nodes[n].aux == i32(int(CV.none_)):
        child = int(nodes[n].a)
        t = ntype(n); ct = ntype(child)
        if not is_int(exact_representation(t)) or exact_representation(t) != exact_representation(ct): break
        kind = nodes[child].kind
        if kind != .binary and kind != .unary and kind != .ident and kind != .int_lit and not (kind == .conv and nodes[child].aux == i32(int(CV.none_))): break
        nodes[n] = nodes[child]
        nodes[n].type = i32(t)
    # Local compound arithmetic has the same left-before-right evaluation as
    # a simple binary assignment. Expose it before write/representation proofs.
    if nodes[n].kind == .assign and nodes[n].aux == 0 and nodes[n].op != i32(int(Tok.assign)):
        target = int(nodes[n].a)
        if nodes[target].kind == .ident and nodes[target].aux == i32(int(SK.local)) and prune(ntype(target)) == T_MATH_INT:
            op = compound_op(int(nodes[n].op)) as Tok
            if op == .plus or op == .minus or op == .star or op == .amp or op == .pipe or op == .caret:
                left = nodes.len(); nodes.push(nodes[target])
                value = mk(.binary, nodes[n].pos)
                nodes[value] = Node(kind = .binary, pos = nodes[n].pos, a = i32(left), b = nodes[n].b, op = i32(int(op)), type = i32(T_MATH_INT), flags = i32(NF_CHECKED))
                nodes[n].b = i32(value)
                nodes[n].op = i32(int(Tok.assign))
    k = nodes[n].kind
    if k == .array and has_flag(n, NF_BROADCAST) and tkind(ntype(n)) == .array and exact_representation(telem(ntype(n))) == T_MATH_INT: exact_demands[owner] = true
    if exact_collect_writes and (k == .vardecl or k == .assign or k == .for_ or k == .while_ or k == .lambda or k == .fn_ or k == .return_ or k == .break_ or k == .continue_): exact_lower_sites.push(n)
    if k == .lambda or k == .fn_: return
    if exact_measure_on:
        if store: exact_measure_boundary(n, owner)
        else: exact_measure_visit(n, owner, false)
    # Classify only the relevant kind. This demanded walk already has k;
    # unrelated nodes need neither arithmetic/type queries nor policy tests.
    math = false
    operator = false
    cmp = false
    conversion = false
    policy = false
    control = false
    match k:
        binary:
            math = exact_operation(n)
            operator = nodes[n].aux == 0 and exact_type(ntype(n), nodes[n].pos)
            cmp = nodes[n].aux == 0 and ntype(n) == T_BOOL
        unary, intrinsic: math = exact_operation(n)
        conv:
            conversion = (nodes[n].aux == i32(int(CV.int_)) or nodes[n].aux == i32(int(CV.none_))) and exact_type(ntype(n), nodes[n].pos)
            policy = nodes[n].aux == i32(int(CV.wrap_int)) or nodes[n].aux == i32(int(CV.saturate_int)) or nodes[n].aux == i32(int(CV.int2float)) or ntype(n) == T_MATH_INT
        if_, iflet, block, exprstmt, match_, arm, coalesce: control = true
        else: pass
    if math and nodes[n].kind == .binary and (nodes[n].op == i32(int(Tok.shl)) or nodes[n].op == i32(int(Tok.starstar))):
        (known, count) = integer_constant(int(nodes[n].b))
        if count < 0 and not types[exact_representation(ntype(int(nodes[n].b)))].sign: known = false
        if known and count < 1048576: exact_shifts[n] = max(0, count)
        else:
            exact_demands[owner] = true
            exact_count_nodes.push((n, owner))
            exact_marks[n] |= 128
    previous_control = exact_control_head
    if k == .while_ or k == .for_:
        exact_control_values.push(int(nodes[n].a))
        exact_control_parents.push(previous_control)
        exact_control_head = exact_control_values.len()
    if policy and k == .conv and (nodes[n].aux == i32(int(CV.wrap_int)) or nodes[n].aux == i32(int(CV.saturate_int))) and exact_named_constant(int(nodes[n].a)):
        nodes[n].a = i32(exact_prepare_operand(int(nodes[n].a)))
    mask = isolation_children(k)
    if mask > 0:
        if mask & 1 != 0: exact_prepare_node(int(nodes[n].a), owner, not (math or operator or cmp or conversion or policy or k == .exprstmt or k == .match_ and exact_match_literals(n)))
        if mask & 2 != 0: exact_prepare_node(int(nodes[n].b), owner, not (math or operator or cmp or control))
        if mask & 4 != 0: exact_prepare_node(int(nodes[n].c), owner, not control)
        if mask & 16 != 0:
            loop i in [0..nkids(n)): exact_prepare_node(kid(n, i), owner, not math and k != .block and k != .match_)
    if (k == .call or k == .binary or k == .unary) and prune(ntype(n)) == T_MATH_INT and exact_prepare_math(n):
        exact_marks[n] &= 251
        exact_prepare_node(n, owner, store)
        return
    if conversion and prune(ntype(int(nodes[n].a))) == T_MATH_INT:
        source = int(nodes[n].a)
        if exact_named_constant(source) and not exact_word_reads.has(n):
            word = exact_prepare_operand(source)
            if word != source:
                nodes[n].a = i32(word)
                exact_mark(n) # narrower destinations still need their own fit proof
        if nodes[n].a == i32(source):
            if nodes[source].kind == .conv and nodes[source].aux == i32(int(CV.int_)) and exact_type(ntype(int(nodes[source].a)), nodes[n].pos): nodes[n].a = nodes[source].a
            else if not exact_word_reads.has(n): exact_demands[owner] = true
    # Arm coercion rewrites the tail after check_block cached its type.
    # Keep both directions synchronized: a word arm widened to int must not
    # be read as an untagged word, and a narrowed arm must expose its fit check.
    if k == .block and nodes[n].aux != 0:
        tail = block_value(n)
        if prune(ntype(n)) == T_MATH_INT or prune(ntype(tail)) == T_MATH_INT: nodes[n].type = nodes[tail].type
    expanded = math or operator and (exact_has_node(int(nodes[n].a)) or exact_has_node(int(nodes[n].b)))
    if conversion or k == .exprstmt: expanded = exact_has_node(int(nodes[n].a))
    if k == .if_ or k == .iflet: expanded = exact_has_node(int(nodes[n].b)) or exact_has_node(int(nodes[n].c))
    if k == .block and nodes[n].aux != 0: expanded = exact_has_node(block_value(n))
    if k == .match_:
        loop arm in kids(n):
            if exact_has_node(int(nodes[arm].b)): expanded = true
    if expanded and nodes[n].type != 0 and exact_type(ntype(n), nodes[n].pos): exact_mark(n)
    if cmp and (exact_has_node(int(nodes[n].a)) or exact_has_node(int(nodes[n].b))): exact_mark(n)
    if k == .coalesce and exact_has_node(int(nodes[n].b)) and exact_type(ntype(n), nodes[n].pos): exact_mark(n)
    if store or k == .conv and has_flag(n, NF_EXPLICIT_INTEGER): exact_store(n, owner)
    # A dynamic mathematical shift may still have a word-sized value at this
    # use. Ask the existing flow proof before choosing the tagged shift helper.
    # This is representation demand, never an added source fit obligation.
    if k == .binary and nodes[n].aux == 0 and nodes[n].op == i32(int(Tok.shl)) and prune(ntype(n)) == T_MATH_INT:
        if owner >= exact_rep_owners.len(): exact_rep_owners.resize(max(owner + 1, fns.len()))
        exact_rep_owners[owner] = true
        if n >= exact_rep_demands.len(): exact_rep_demands.resize(nodes.len())
        exact_rep_demands[n] = true
        exact_proof_demands[owner] = true
    if k == .for_ and nodes[n].aux == 0:
        it = int(nodes[n].a)
        loop endpoint in [int(nodes[it].a), int(nodes[it].b), int(nodes[it].c)]:
            if endpoint != 0 and prune(ntype(endpoint)) == T_MATH_INT and exact_count_bound(endpoint).wide:
                if owner >= exact_rep_owners.len(): exact_rep_owners.resize(max(owner + 1, fns.len()))
                exact_rep_owners[owner] = true
                if endpoint >= exact_rep_demands.len(): exact_rep_demands.resize(nodes.len())
                exact_rep_demands[endpoint] = true
                exact_proof_demands[owner] = true
    if k == .for_ and (nodes[n].aux == 0 or nodes[n].aux == 1) and nodes[n].sym > 0 and not has_flag(n, NF_MUT):
        l = int(nodes[n].sym)
        if l >= exact_iteration_sources.len(): exact_iteration_sources.resize(locals.len())
        exact_iteration_sources[l] = int(nodes[n].a)
    if k == .vardecl and nodes[n].sym > 0 and not has_flag(n, NF_GLOBAL):
        l = int(nodes[n].sym)
        if l >= exact_initializers.len(): exact_initializers.resize(max(l + 1, locals.len()))
        exact_initializers[l] = int(nodes[n].b)
    if k == .call and nodes[n].aux == 0 and nodes[n].sym > 0:
        called = int(nodes[n].sym)
        loop i in [0..min(nkids(n), fns[called].params.len())):
            if int(locals[fns[called].params[i]].flags) & LF_MUTPARAM == 0: continue
            root = fact_progress_root(kid(n, i))
            if nodes[root].kind == .ident and nodes[root].aux == i32(int(SK.local)):
                l = int(nodes[root].sym)
                if l >= exact_progress_opaque.len(): exact_progress_opaque.resize(locals.len())
                exact_progress_opaque[l] = true
    if k == .intrinsic and nkids(n) > 0:
        id = nodes[n].aux as IN
        if id == .push or id == .insert or id == .extend or id == .fill or id == .resize or id == .truncate or id == .reserve:
            root = fact_progress_root(kid(n, 0))
            if nodes[root].kind == .ident and nodes[root].aux == i32(int(SK.local)):
                l = int(nodes[root].sym)
                if l >= exact_progress_opaque.len(): exact_progress_opaque.resize(locals.len())
                exact_progress_opaque[l] = true
    if k == .assign:
        exact_progress_assignments.push(n)
        target = int(nodes[n].a)
        root = fact_progress_root(target)
        if nodes[root].kind == .ident and nodes[root].aux == i32(int(SK.local)):
            l = int(nodes[root].sym)
            if l >= exact_write_heads.len(): exact_write_heads.resize(max(l + 1, locals.len()))
            exact_write_values.push(int(nodes[n].b))
            exact_write_plain.push(nodes[n].op == i32(int(Tok.assign)) and nodes[n].aux == 0)
            exact_write_targets.push(target)
            exact_write_seen.push(0)
            exact_write_controls.push(exact_control_head)
            exact_write_next.push(exact_write_heads[l])
            exact_write_heads[l] = exact_write_values.len()
    if exact_collect_writes and (k == .while_ or k == .for_): exact_lower_sites.push(-1)
    exact_control_head = previous_control

# Pure conversions have no stores, control dependencies or write inventory.
# The checker records each exact operation once per visit in an owner-indexed
# chain. Prepare conversion roots, then require every recorded operation to be
# covered; any other use falls back to the ordinary body walk. O(candidates +
# demanded expression nodes/edges), with no new walk of unrelated statements.
# Overlapping conversion roots share this node index. Preparation only
# wraps/removes representation conversions, preserving this purity property.
# The lazy node index uses O(all checked nodes) zeroed bytes.
exact_float_purity: u8[]
exact_pure_float_tree = (n: int) -> bool:
    if n < exact_float_purity.len() and exact_float_purity[n] != 0: return exact_float_purity[n] == 2
    k = nodes[n].kind
    pure = k == .ident or k == .int_lit or k == .bool_lit
    if k == .unary or k == .conv: pure = exact_pure_float_tree(int(nodes[n].a))
    else if k == .binary and nodes[n].aux == 0: pure = exact_pure_float_tree(int(nodes[n].a)) and exact_pure_float_tree(int(nodes[n].b))
    if n >= exact_float_purity.len(): exact_float_purity.resize(max(n + 1, nodes.len()))
    exact_float_purity[n] = if pure: 2 else: 1
    pure

exact_prepare_floats = (f: int) -> bool:
    if exact_measure_on or exact_full_owners.has(f) or f >= exact_candidate_heads.len() or exact_candidate_heads[f] == 0: return false
    at = exact_candidate_heads[f]
    loop at > 0:
        n = exact_candidate_nodes[at - 1]
        if nodes[n].kind == .conv and nodes[n].aux == i32(int(CV.int2float)) and exact_pure_float_tree(n): exact_prepare_node(n, f, false)
        at = exact_candidate_next[at - 1]
    at = exact_candidate_heads[f]
    loop at > 0:
        n = exact_candidate_nodes[at - 1]
        if n >= exact_marks.len() or exact_marks[n] & 4 == 0: return false
        at = exact_candidate_next[at - 1]
    true

exact_prepare = ():
    if exact_owners.len() > 0: exact_marks = fill(u8(0), nodes.len() * 2 + 64)
    owners: int[]
    loop f, _ in exact_owners: owners.push(f)
    owners.sort()
    loop f in owners:
        # A checking worker reports this demand alongside its closed-state
        # summary. Restore only demanded bodies before obligations are decided.
        pc_restore(f)
        if f <= 0 or f >= fns.len() or fns[f].state != 2 or effect_unavailable.has(f): continue
        if f >= exact_effect_owners.len(): exact_effect_owners.resize(fns.len())
        exact_effect_owners[f] = true
        body = int(fns[f].body)
        if exact_prepare_floats(f): continue
        fact_plan_forget(f)
        # Reuse this demanded traversal for lowering's write inventory.
        # Each write/control boundary is recorded once, O(N+E); lowering
        # replays O(writes + controls) instead of walking the body again.
        exact_collect_writes = not fns[f].writes_ready
        exact_lower_sites = []
        exact_prepare_node(body, f, false)
        if exact_collect_writes:
            fns[f].write_sites = exact_lower_sites
            fns[f].writes_ready = true
        exact_collect_writes = false
        exact_lower_sites = []
        if nodes[body].kind == .block and nodes[body].aux != 0:
            if exact_measure_on: exact_measure_boundary(block_value(body), f)
            exact_store(block_value(body), f)
    loop candidate in exact_count_nodes:
        original = candidate.0
        n = if exact_has_store(original): int(nodes[original].a) else: original
        bound = exact_count_bound(int(nodes[n].b))
        if not bound.wide and bound.hi < 1048576:
            exact_shifts[n] = max(0, bound.hi)
            exact_marks[original] &= 127
        else: exact_proof_demands[candidate.1] = true
    loop assignment in exact_progress_assignments: fact_progress_note(assignment)
    loop n, owner in exact_stores:
        if not exact_decided(n):
            exact_demands[owner] = true
            if dir_policy(nodes[n].pos) == DIR_STATIC: exact_proof_demands[owner] = true
    # Exact stores rewrite existing checked nodes as well as appending them.
    effect_ix_nodes = 0
    effect_ix_locals = 0
    if effect_seen.len() > 0: effect_seen.resize(nodes.len())
    exact_local_widths = []
    exact_raw_values = []

# Shift extents first ask immutable definitions and declared scalar contracts.
# This sparse, demand-only interval cache visits each expression/dependency
# once. Cycles and unsafe aliases stay unknown and request the ordinary facts
# pass. No function body is walked just to bound a masked shift count.
exact_count_nodes: (int, int)[]
exact_count_index: int[]
exact_count_bounds: FactBound[]

exact_shift_fact = (n: int, value: int, s: FactState):
    if fact_speculating > 0 or not exact_has_node(n) or (nodes[n].op != i32(int(Tok.shl)) and nodes[n].op != i32(int(Tok.starstar))): return
    b = fact_bound(s, value)
    hi = fact_relational(s, value, true)
    bounded = not b.wide
    if value != 0 and fact_type(fact_terms[value].type) == T_U64:
        if b.lo < 0 and hi < 0:
            b.lo = b.lo xor FACT_MIN
            hi = hi xor FACT_MIN
        else: bounded = false
    limit = if bounded and hi < 1048576: max(0, hi) else: -1
    # A slice may omit a count unrelated to its obligation. Preserve the
    # independent immutable bound, including the extent used by power lowering.
    if limit < 0:
        bound = exact_count_bound(int(nodes[n].b))
        if not bound.wide and bound.hi < 1048576:
            exact_shifts[n] = max(0, bound.hi)
            return
    if let previous = exact_shifts.get(n):
        if previous < 0 or limit < 0: limit = -1
        else: limit = max(previous, limit)
    exact_shifts[n] = limit

# value within t's range through fact_compare's relations. An interval end
# that is real and fits needs no compare; a 64-bit word's MIN/MAX (sentinel
# constants) is approached as > MIN, < MAX. Two compares: O(fact_compare).
exact_fits_relation = (s: mut FactState, value: int, t: int) -> bool:
    bits = int(types[t].bits)
    sign = types[t].sign
    if bits <= 0 or bits > 64: return false
    low = if not sign: 0 else if bits >= 64: FACT_MIN + 1 else: -(1 << (bits - 1))
    high = if bits >= 64: FACT_MAX - 1 else if sign: (1 << (bits - 1)) - 1 else: (1 << bits) - 1
    b = fact_bound(s, value)
    lo_real = b.lo != FACT_MIN and b.lo >= low or b.lo == FACT_MIN and sign and bits >= 64 and not fact_open_endpoint(s, value, false)
    hi_real = b.hi != FACT_MAX and b.hi <= high or b.hi == FACT_MAX and bits >= 64 and not fact_open_endpoint(s, value, true)
    # (each constant first: an argument copies the state before it is added)
    if not lo_real:
        floor = fact_constant(s, low)
        if fact_compare(s, .ge, value, floor) != 1: return false
    if hi_real: return true
    ceiling = fact_constant(s, high)
    fact_compare(s, .le, value, ceiling) == 1

exact_fact_store = (n: int, value: int, s: mut FactState) -> int:
    if not s.live:
        if not exact_decided(n): exact_decide(n, true)
        return value
    t = exact_representation(ntype(n))
    b = fact_bound(s, value)
    # Values outside the interval engine's signed word range remain unknown.
    ok = not b.wide and b.reason != .unsupported and sa_fits(b.lo, t) and sa_fits(b.hi, t)
    # (an open `int` end is infinite, not the word's MIN/MAX)
    if ok and value != 0 and (b.hi == FACT_MAX and fact_open_endpoint(s, value, true) or b.lo == FACT_MIN and fact_open_endpoint(s, value, false)): ok = false
    # (an open end may still sit inside the word through a relation:
    # `r*cols` below `rows*cols =? cells.length`. Only an unproven store asks)
    if not ok and value != 0 and t != T_U64 and not b.wide and b.reason != .unsupported: ok = exact_fits_relation(s, value, t)
    if t == T_U64: ok = not b.wide and value != 0 and fact_terms[value].type == T_U64 and b.reason != .unsupported
    assumed = exact_marks[n] & 32 != 0
    if assumed:
        if ok: return value
        # An assumed narrowing still supplies its storage domain downstream;
        # it cannot leak an unknown wide intermediate into later proofs.
        bounded = fact_domain(t)
        if types[t].sign:
            bounded.lo = max(bounded.lo, b.lo)
            bounded.hi = min(bounded.hi, b.hi)
        if value != 0:
            fact_set_bound(s, value, bounded)
            return value
        return fact_new(s, bounded, FactTerm(type = t))
    if not ok:
        independent = exact_count_bound(int(nodes[n].a))
        if not independent.wide and sa_fits(independent.lo, t) and sa_fits(independent.hi, t): ok = true
    if not ok:
        syntax_bound = positive_bound(int(nodes[n].a), false)
        if syntax_bound >= 0 and sa_fits(syntax_bound, t): ok = true
    if fact_speculating == 0:
        if exact_decided(n): ok = ok and exact_proved(n)
        exact_decide(n, ok)
        if exact_measure_on:
            site = exact_measure_sites[n]
            site.category = if ok: "proven" else: "runtime-check"
            site.lo = b.lo; site.hi = b.hi
            exact_measure_sites[n] = site
    if not ok and fact_speculating == 0:
        what = "cannot prove exact integer result fits {dt(t)}"
        if not dir_defer(n, what, true):
            # (what overflows, as written, and the `int` route: Dewy's integer
            # arithmetic is exact, so the wider result fits an `int`)
            shown = wit_text(n)
            if shown != "":
                err_notes.push((-1, "note: nothing bounds `{shown}` within {dt(t)} here"))
                inner = n
                loop inner != 0 and nodes[inner].kind == .conv: inner = int(nodes[inner].a)
                operand = wit_unsupported(inner)
                if dewy_at(nodes[n].pos) and operand != "this operation is outside the fact language": err_notes.push((-1, "note: {operand}"))
                wit_operand_changed(int(nodes[n].a), s)
                wit_help("{dt(t)}.min <=? ({shown}) and ({shown}) <=? {dt(t)}.max")
            err_notes.push((-1, "help: widen the destination to `int`, state the domain as a refinement (or prove it with a guard), or choose `overflow='wrap'|'saturate'`; " + dir_panic_fix(nodes[n].pos, true)))
            fatal(nodes[n].pos, what)
    # The continuation is dominated by either a proof or its runtime check.
    if ok: return value
    bounded = fact_domain(t)
    if value != 0 and fact_type(fact_terms[value].type) == fact_type(t):
        bounded.lo = max(bounded.lo, b.lo)
        bounded.hi = min(bounded.hi, b.hi)
    fact_new(s, bounded, FactTerm(type = t))

exact_bits = (n: int) -> int:
    if n < exact_widths.len() and exact_widths[n] > 0: return exact_widths[n]
    t = exact_representation(ntype(n))
    width = if is_int(t): int(types[t].bits) + int(not types[t].sign) else: 1
    if nodes[n].kind == .int_lit and has_flag(n, NF_U64) and nodes[n].ival < 0: width = 65
    if exact_has_node(n):
        k = nodes[n].kind
        if k == .binary:
            a = exact_bits(int(nodes[n].a)); b = exact_bits(int(nodes[n].b))
            op = nodes[n].op as Tok
            width = max(a, b)
            if op == .plus or op == .minus: width += 1
            else if op == .star: width = a + b
            else if op == .slash: width = a + int(not (exact_range_flags(int(nodes[n].a)) & 2 != 0))
            else if op == .percent: width = if dewy_at(nodes[n].pos): b else: min(a, b)
            else if op == .shr: width = a
            else if op == .shl or op == .starstar:
                limit = exact_shifts.get(n) ?? -1
                if not exact_shifts.has(n):
                    (known, literal) = integer_constant(int(nodes[n].b))
                    if literal < 0 and not types[exact_representation(ntype(int(nodes[n].b)))].sign: known = false
                    if known and literal < 1048576: limit = max(0, literal)
                (fixed_base, base) = integer_constant(int(nodes[n].a))
                independent = fixed_base and (op == .shl and base == 0 or op == .starstar and base >= -1 and base <= 1 and (base >= 0 or types[exact_representation(ntype(int(nodes[n].a)))].sign))
                if limit < 0 and independent: limit = 0
                if limit < 0:
                    err_notes.push((-1, "help: bound the shift count or exponent with a guard, compute in explicit int, or choose an overflow policy type"))
                    fatal(nodes[n].pos, "cannot prove a finite machine width for exact shift or power")
                width = if op == .starstar: max(2, a * limit + 1) else: a + limit
        else if k == .unary: width = exact_bits(int(nodes[n].a)) + 1
        else if k == .intrinsic: width = exact_bits(kid(n, 0)) + 1
        else if k == .conv or k == .exprstmt: width = exact_bits(int(nodes[n].a))
        else if k == .if_ or k == .iflet: width = max(exact_bits(int(nodes[n].b)), exact_bits(int(nodes[n].c)))
        else if k == .block: width = exact_bits(block_value(n))
        else if k == .coalesce: width = max(width, exact_bits(int(nodes[n].b)))
        else if k == .match_:
            loop arm in kids(n): width = max(width, exact_bits(int(nodes[arm].b)))
    syntax = exact_type_width(n)
    if syntax > 0: width = min(width, syntax / 2)
    if n < exact_ranges.len() and exact_ranges[n] > 0: width = min(width, exact_ranges[n])
    if n >= exact_widths.len(): exact_widths.resize(max(n + 1, nodes.len()))
    exact_widths[n] = width
    width

exact_finish = ():
    loop n, owner in exact_stores:
        if not exact_decided(n):
            fact_retry_owner = owner
            fact_terms = [FactTerm()]
            s = FactState()
            exact_fact_store(n, 0, s)
        exact_bits(int(nodes[n].a))
        if not exact_proved(n) and exact_representation(ntype(n)) == T_INT:
            if owner >= eg_demanded.len(): eg_demanded.resize(fns.len())
            eg_demanded[owner] = true
    loop n in exact_nodes:
        if exact_has_node(n): exact_bits(n)
    fact_retry_owner = 0
    if exact_measure_on: exact_measure_report()

exact_join_blocks: {int: int[]} = {}

# Lowering already knows bounded induction variables and the range shared by
# every write to a local. Reuse those facts rather than demand relational states
# merely to choose the number of machine words in an exact expression.
exact_lower_bits = (n: int) -> int:
    width = exact_bits(n)
    # Consumers select whole machine words. Once one word suffices, no
    # induction/range query can change their representation.
    if width <= 64: return width
    bound = positive_bound(n, true)
    if bound < 0: return width
    bits = 1
    loop shift in [32, 16, 8, 4, 2, 1]:
        if bound >> shift != 0:
            bound = bound >> shift
            bits += shift
    if bound != 0: bits += 1
    min(width, bits)

# A positive remainder of one potentially overflowing word operation has a
# native fast path. Evaluate operands once; OF selects a shared exact fallback.
exact_word_remainder = (n: int) -> int[]:
    empty: int[]
    if not checked_flags or not dewy_at(nodes[n].pos): return empty
    known, divisor = integer_constant(int(nodes[n].b))
    if not known or divisor <= 0 or divisor & (divisor - 1) == 0: return empty
    source = int(nodes[n].a)
    if nodes[source].kind != .binary or nodes[source].aux != 0 or not exact_has_node(source) or exact_lower_bits(source) <= 64: return empty
    op = nodes[source].op as Tok
    if op != .plus and op != .minus and op != .star: return empty
    a = int(nodes[source].a); b = int(nodes[source].b)
    if exact_lower_bits(a) > 64 or exact_lower_bits(b) > 64: return empty
    av = exact_value(a); bv = exact_value(b)
    if av.len() != 1 or bv.len() != 1: ice("word remainder width mismatch")
    modulus = e_iconst(divisor)
    result = vreg(VI)
    value = e_bin((if op == .plus: Op.add else if op == .minus: Op.sub else: Op.mul), VI, av[0], bv[0])
    overflow = e_bin((if op == .plus: Op.overflow_add else if op == .minus: Op.overflow_sub else: Op.overflow_mul), VI, av[0], bv[0])
    iff(overflow)
    cold = ir_cold
    ir_cold = true
    words = if op == .star: exact_mul(av, bv, 2) else: exact_add(av, bv, 2, op == .minus)
    e_mov(result, e_call(rt("__exact_i128_mod_pos"), [words[0], words[1], modulus], VI))
    ir_cold = cold
    els()
    e_mov(result, exact_div(n, [value], [modulus], 1, true)[0])
    endc()
    [result]

# A consumer of only the low machine word needs no carries or high products.
# Ring operations commute with reduction modulo 2^64. Other operations keep
# their full exact operands, including division, comparisons and right shifts.
exact_low_word = (n: int) -> int:
    if exact_chain_active:
        if let saved = exact_chain_saved.get(n): return saved
    if nodes[n].kind != .block and not exact_has_node(n):
        return freeze_scalar(gen_expr(n).v, exact_representation(ntype(n)))
    if exact_has_node(n):
        k = nodes[n].kind
        if k == .binary:
            op = nodes[n].op as Tok
            if op == .plus or op == .minus or op == .star or op == .amp or op == .pipe or op == .caret:
                a = exact_low_word(int(nodes[n].a))
                b = exact_low_word(int(nodes[n].b))
                return e_bin(int_op(op, true), VI, a, b)
        if k == .unary and nodes[n].op == i32(int(Tok.minus)): return e_un(.neg, VI, exact_low_word(int(nodes[n].a)))
        if k == .exprstmt or k == .conv and (nodes[n].aux == i32(int(CV.int_)) or nodes[n].aux == i32(int(CV.none_))): return exact_low_word(int(nodes[n].a))
    exact_value(n)[0]

exact_value = (n: int) -> int[]:
    if exact_chain_active:
        if let saved = exact_chain_saved.get(n): return [saved]
    midpoint = exact_midpoint(n)
    if midpoint.0 != 0:
        lo = gen_expr(midpoint.0).v
        hi = gen_expr(midpoint.1).v
        half = e_bin(.shrs, VI, e_bin(.xor, VI, lo, hi), e_iconst(1))
        return [e_bin(.add, VI, e_bin(.and_, VI, lo, hi), half)]
    if nodes[n].kind == .block:
        scope_push()
        out: int[]
        loop i in [0..nkids(n)):
            statement = kid(n, i)
            if i == nkids(n) - 1 and nodes[n].aux != 0:
                stmt_begin()
                words = exact_value(int(nodes[statement].a))
                loop word in words:
                    saved = vreg(VI)
                    e_mov(saved, word)
                    out.push(saved)
                stmt_end()
            else: gen_stmt(statement)
        scope_pop()
        return out
    if not exact_has_node(n):
        t = exact_representation(ntype(n))
        word = freeze_scalar(gen_expr(n).v, t)
        if is_int(t) and not types[t].sign and types[t].bits == 64 or nodes[n].kind == .int_lit and has_flag(n, NF_U64) and nodes[n].ival < 0: return [word, e_iconst(0)]
        return [word]
    count = (exact_lower_bits(n) + 63) / 64
    k = nodes[n].kind
    if k == .binary:
        op = nodes[n].op as Tok
        if count == 1 and (op == .plus or op == .minus or op == .star or op == .amp or op == .pipe or op == .caret): return [exact_low_word(n)]
        if op == .percent:
            known, divisor = integer_constant(int(nodes[n].b))
            if dewy_at(nodes[n].pos) and known and divisor > 0 and divisor & (divisor - 1) == 0:
                return [e_bin(.and_, VI, exact_low_word(int(nodes[n].a)), e_iconst(divisor - 1))]
            word = exact_word_remainder(n)
            if word.len() > 0: return word
        a = exact_value(int(nodes[n].a))
        if op == .shl or op == .shr:
            count_node = int(nodes[n].b)
            known_count, literal_count = integer_constant(count_node)
            if known_count: return exact_shift_literal(a, literal_count, count, op == .shr)
            by = 0
            if exact_representation(ntype(count_node)) == T_MATH_INT: by = math_shift_count(count_node)
            else:
                words = exact_value(count_node)
                by = words[0]
                high = e_iconst(0)
                loop i in [1..words.len()): high = e_bin(.or_, VI, high, words[i])
                by = exact_select(e_bin(.ne, VI, high, e_iconst(0)), [e_iconst(-1)], [by], 1)[0]
            return exact_shift(a, by, count, op == .shr)
        if op == .starstar:
            exponent_node = int(nodes[n].b)
            exponent_type = exact_representation(ntype(exponent_node))
            (fixed_base, constant) = integer_constant(int(nodes[n].a))
            exponent = 0
            parity = 0
            negative = e_iconst(0)
            zero = e_iconst(0)
            if exponent_type == T_MATH_INT:
                value = gen_borrowed(exponent_node).v
                negative = e_bin(.lts, VI, e_call(rt("__mi_compare"), [value, e_iconst(0)], VI), e_iconst(0))
                iff(negative)
                e_call_nr1(rt("__negative_integer_power"), e_daddr(loc_data(nodes[n].pos)), -1)
                endc()
                exponent = e_call1(rt("__mi_count"), value, VI)
                zero = e_bin(.eq, VI, exponent, e_iconst(0))
                # Saturating a huge count preserves zero/nonzero, but not parity.
                parity = if fixed_base and constant == -1: e_call1(rt("__mi_low_word"), value, VI) else: exponent
            else:
                words = exact_value(exponent_node)
                exponent = words[0]
                parity = exponent
                zero = exact_compare(.eq, words, [e_iconst(0)])
                negative = e_bin(.lts, VI, words[words.len() - 1], e_iconst(0))
            if exponent_type != T_MATH_INT:
                iff(negative)
                e_call_nr1(rt("__negative_integer_power"), e_daddr(loc_data(nodes[n].pos)), -1)
                endc()
            if fixed_base and constant >= -1 and constant <= 1 and (constant >= 0 or types[exact_representation(ntype(int(nodes[n].a)))].sign):
                if constant == 1: return [e_iconst(1)]
                if constant == 0: return [zero]
                return [e_bin(.sub, VI, e_iconst(1), e_bin(.shl, VI, e_bin(.and_, VI, parity, e_iconst(1)), e_iconst(1)))]
            result = exact_extend([e_iconst(1)], count)
            base = exact_extend(a, count)
            maximum = exact_shifts.get(n) ?? 0
            bit = 1
            loop bit <= maximum:
                result = exact_select(e_bin(.and_, VI, exponent, e_iconst(bit)), exact_mul(result, base, count), result, count)
                bit *= 2
                if bit <= maximum: base = exact_mul(base, base, count)
            return result
        b = exact_value(int(nodes[n].b))
        if op == .plus or op == .minus: return exact_add(a, b, count, op == .minus)
        if op == .star: return exact_mul(a, b, count)
        if op == .slash or op == .percent:
            (known, divisor) = integer_constant(int(nodes[n].b))
            if dewy_at(nodes[n].pos) and known and divisor > 0 and divisor & (divisor - 1) == 0:
                if op == .percent: return [e_bin(.and_, VI, a[0], e_iconst(divisor - 1))]
                shift = 0
                loop divisor > 1: divisor /= 2; shift += 1
                return exact_extend(exact_shift_literal(a, shift, max(count, a.len()), true), count)
            if known and divisor > 0 and (positive_bound(int(nodes[n].a), true) >= 0 or a.len() == 1 and (exact_range_flags(int(nodes[n].a)) & 1 != 0)):
                return [e_bin((if op == .percent: Op.remu else: Op.divu), VI, a[0], b[0])]
            work = max(count, max(a.len(), b.len()))
            return exact_extend(exact_div(n, a, b, work, op == .percent), count)
        if op == .amp or op == .pipe or op == .caret:
            a = exact_extend(a, count); b = exact_extend(b, count)
            out: int[]
            loop i in [0..count): out.push(e_bin(int_op(op, true), VI, a[i], b[i]))
            return out
        return [exact_compare(op, a, b)]
    if k == .coalesce:
        a = int(nodes[n].a)
        ot = prune(ntype(a))
        inner = int(types[ot].elem)
        pa = place_addr(gen_place(a, false), ot)
        out: int[]
        loop i in [0..count): out.push(vreg(VI))
        iff(opt_has(pa, inner))
        word = opt_value(pa, inner)
        words = [word]
        t = exact_representation(inner)
        if not types[t].sign and types[t].bits == 64: words.push(e_iconst(0))
        words = exact_extend(words, count)
        loop i in [0..count): e_mov(out[i], words[i])
        els()
        enter_cond()
        words = exact_extend(exact_value(int(nodes[n].b)), count)
        loop i in [0..count): e_mov(out[i], words[i])
        leave_cond()
        endc()
        return out
    if k == .intrinsic and nodes[n].aux == i32(int(IN.fixed_abs)):
        a = exact_value(kid(n, 0))
        return exact_select(e_bin(.lts, VI, a[a.len() - 1], e_iconst(0)), exact_neg(a, count), a, count)
    if k == .unary: return exact_neg(exact_value(int(nodes[n].a)), count)
    if k == .conv or k == .exprstmt: return exact_value(int(nodes[n].a))
    if k == .iflet or k == .match_:
        out: int[]
        loop i in [0..count): out.push(vreg(VI))
        bodies: int[]
        if k == .iflet: bodies = [int(nodes[n].b), int(nodes[n].c)]
        else:
            loop arm in kids(n): bodies.push(int(nodes[arm].b))
        loop body in bodies: exact_join_blocks[body] = out
        if k == .iflet: gen_iflet(n, ntype(n))
        else: gen_match(n, true)
        loop body in bodies: exact_join_blocks.remove(body)
        return out
    if k == .if_:
        condition = gen_expr(int(nodes[n].a)).v
        out: int[]
        loop i in [0..count): out.push(vreg(VI))
        iff(condition)
        enter_cond()
        yes = exact_extend(exact_value(int(nodes[n].b)), count)
        loop i in [0..count): e_mov(out[i], yes[i])
        leave_cond()
        els()
        enter_cond()
        no = exact_extend(exact_value(int(nodes[n].c)), count)
        loop i in [0..count): e_mov(out[i], no[i])
        leave_cond()
        endc()
        return out
    fatal(nodes[n].pos, "exact fixed-width value is not implemented for this control")
    [e_iconst(0)]

# Small pure arithmetic trees use native flags and share one cold exact path.
# Leaves are evaluated once before either path. The bounded plan visits at most
# 16 nodes; the saved leaf index exists only while emitting its exact fallback.
exact_chain_active = false
exact_chain_saved: {int: int} = {}

exact_gen_store = (n: int) -> Val:
    if exact_loop_fast: return gen_expr(int(nodes[n].a))
    if exact_map_active and exact_map_stores.has(n):
        exact_loop_fast = true
        value = gen_expr(int(nodes[n].a))
        exact_loop_fast = false
        return value
    t = exact_representation(ntype(n))
    source = int(nodes[n].a)
    proven = exact_proved(n)
    if not proven:
        bound = positive_bound(source, true)
        proven = bound >= 0 and sa_fits(bound, t)
    if not proven and t == T_INT and eg_fits(source): proven = true
    if proven and types[t].bits <= 64: return V(exact_low_word(source), false)
    if not proven and not target_wasm and not target_arm64 and types[t].bits == 32 and nodes[source].kind == .binary:
        op = nodes[source].op as Tok
        a = int(nodes[source].a); b = int(nodes[source].b)
        aw = exact_type_width(a); bw = exact_type_width(b)
        signed = types[t].sign
        fits = aw > 0 and bw > 0 and (if signed: aw / 2 <= 32 and bw / 2 <= 32 else: aw & bw & 1 != 0 and aw / 2 <= 33 and bw / 2 <= 33)
        if fits and (op == .plus or op == .minus or op == .star):
            av = exact_low_word(a); bv = exact_low_word(b)
            result = vreg(VI)
            checked = if op == .plus: Op.checked_add else if op == .minus: Op.checked_sub else: Op.checked_mul
            emit(checked, VI, result, av, bv, 32 | int(not signed), rt("__int_overflow"))
            return V(result, false)
    # Negation has the same single-word overflow obligation as 0 - operand.
    # Keep a wide intermediate when the operand itself can exceed one word.
    if types[t].bits == 64 and types[t].sign and nodes[source].kind == .unary and nodes[source].op == i32(int(Tok.minus)):
        operand = int(nodes[source].a)
        if exact_bits(operand) <= 64:
            value = exact_low_word(operand)
            if proven: return V(e_un(.neg, VI, value), false)
            result = vreg(VI)
            emit(.checked_sub, VI, result, e_iconst(0), value, 0, rt("__int_overflow"))
            return V(result, false)
    # At an immediate signed-word store, native overflow flags implement the
    # narrowing directly. Intermediates that escape this store still widen.
    if types[t].bits == 64 and types[t].sign and nodes[source].kind == .binary:
        op = nodes[source].op as Tok
        a = int(nodes[source].a); b = int(nodes[source].b)
        if (op == .plus or op == .minus or op == .star) and exact_bits(a) <= 64 and exact_bits(b) <= 64:
            av = exact_low_word(a); bv = exact_low_word(b)
            if proven:
                return V(e_bin((if op == .plus: Op.add else if op == .minus: Op.sub else: Op.mul), VI, av, bv), false)
            result = vreg(VI)
            checked = if op == .plus: Op.checked_add else if op == .minus: Op.checked_sub else: Op.checked_mul
            emit(checked, VI, result, av, bv, 0, rt("__int_overflow"))
            return V(result, false)
    if types[t].bits == 64 and not types[t].sign and nodes[source].kind == .binary:
        op = nodes[source].op as Tok
        a = int(nodes[source].a); b = int(nodes[source].b)
        aw = exact_type_width(a); bw = exact_type_width(b)
        if (op == .plus or op == .minus or op == .star) and aw > 0 and bw > 0 and aw & bw & 1 != 0 and aw / 2 <= 65 and bw / 2 <= 65:
            av = exact_low_word(a); bv = exact_low_word(b)
            if proven: return V(e_bin((if op == .plus: Op.add else if op == .minus: Op.sub else: Op.mul), VI, av, bv), false)
            result = vreg(VI)
            checked = if op == .plus: Op.checked_add else if op == .minus: Op.checked_sub else: Op.checked_mul
            emit(checked, VI, result, av, bv, 1, rt("__int_overflow"))
            return V(result, false)
    if not proven and not target_wasm and not target_arm64 and types[t].bits == 64 and types[t].sign:
        offset = exact_offset_store(n)
        if offset >= 0: return V(offset, false)
    if not proven and types[t].bits == 64 and types[t].sign:
        affine = exact_affine_store(n)
        if affine >= 0: return V(affine, false)
        fast = exact_chain_store(n)
        if fast >= 0: return V(fast, false)
    words = exact_value(source)
    if not (proven):
        normalized = norm(words[0], t)
        bad = e_bin(.ne, VI, normalized, words[0])
        sign = if types[t].sign: e_bin(.shrs, VI, normalized, e_iconst(63)) else: e_iconst(0)
        loop i in [1..words.len()): bad = e_bin(.or_, VI, bad, e_bin(.ne, VI, words[i], sign))
        # A signed single-word result stored unsigned must be nonnegative.
        if not types[t].sign and words.len() == 1: bad = e_bin(.or_, VI, bad, e_bin(.lts, VI, words[0], e_iconst(0)))
        math_int_guard(bad)
    V(words[0], false)

# Indexed facts: width, plus nonnegative/no-MIN/seen bits. One allocation per
# demanded graph and O(1) joins/lookups; no hash work per expression visit.
exact_ranges: int[]
exact_range_meta: u8[]
exact_range_flags = (n: int) -> int:
    if n < 0 or n >= exact_range_meta.len(): return 0
    int(exact_range_meta[n])
exact_value_fact = (n: int, value: int, s: FactState):
    if not s.live: return
    if n >= exact_ranges.len():
        exact_ranges.resize(max(n + 1, nodes.len()))
        exact_range_meta.resize(exact_ranges.len())
    if value == 0 or exact_representation(ntype(n)) == T_U64:
        exact_ranges[n] = -1
        exact_range_meta[n] = 4
        return
    b = fact_bound(s, value)
    flags = (if not b.wide and b.lo >= 0: 1 else: 0) | (if not b.wide and b.lo > FACT_MIN: 2 else: 0)
    old = int(exact_range_meta[n])
    if old & 4 != 0: flags &= old
    exact_range_meta[n] = u8(flags | 4)
    # (an exact word's value may itself be an open `int`, `r*cols` of two
    # unbounded int64s: its MIN/MAX ends are infinite, never 64 bits)
    if b.wide or b.reason == .unsupported or (exact_representation(ntype(n)) == T_MATH_INT or fact_type(fact_terms[value].type) == T_MATH_INT) and not fact_host_finite(s, value):
        exact_ranges[n] = -1
        return
    if exact_ranges[n] < 0: return
    # Count the non-sign bits, with at most six tests per endpoint.
    magnitude = max((if b.lo < 0: -(b.lo + 1) else: b.lo), (if b.hi < 0: -(b.hi + 1) else: b.hi))
    width = 1
    loop shift in [32, 16, 8, 4, 2, 1]:
        if magnitude >> shift != 0:
            magnitude = magnitude >> shift
            width += shift
    if magnitude != 0: width += 1
    exact_ranges[n] = max(exact_ranges[n], width)

exact_gen_policy = (n: int) -> Val:
    a = exact_value(int(nodes[n].a))
    t = exact_representation(ntype(n))
    if nodes[n].aux == i32(int(CV.wrap_int)): return V(norm(a[0], t), false)
    bits = int(types[t].bits)
    hi = if bits == 64: -1 else: (1 << bits) - 1
    lo = 0
    if types[t].sign:
        hi = int(u64(hi) >> 1)
        lo = -hi - 1
    high = if not types[t].sign and bits == 64: [e_iconst(hi), e_iconst(0)] else: [e_iconst(hi)]
    out = exact_select(exact_compare(.lt, a, [e_iconst(lo)]), [e_iconst(lo)], a, max(a.len(), high.len()))
    out = exact_select(exact_compare(.gt, a, high), high, out, out.len())
    V(out[0], false)

exact_unsigned_fact = (s: mut FactState, n: int, op: Tok, a: int, b: int) -> int:
    x = fact_bound(s, a); y = fact_bound(s, b)
    if x.wide or y.wide: return fact_unmodeled(s, n, .unsupported)
    m = u64(18446744073709551615)
    xl = u64(x.lo xor FACT_MIN); xh = u64(x.hi xor FACT_MIN)
    yl = u64(y.lo xor FACT_MIN); yh = u64(y.hi xor FACT_MIN)
    lo = u64(0); hi = u64(0)
    if op == .plus:
        if xh > m - yh:
            xh = u64(fact_relational(s, a, true) xor FACT_MIN)
        if xh > m - yh:
            yh = u64(fact_relational(s, b, true) xor FACT_MIN)
        if xh > m - yh:
            return fact_unmodeled(s, n, .unsupported)
        lo = xl + yl; hi = xh + yh
    else if op == .minus:
        if not (xl >= yh or fact_compare(s, .ge, a, b) == 1):
            return fact_unmodeled(s, n, .unsupported)
        lo = if xl >= yh: xl - yh else: u64(0)
        hi = if xh >= yl: xh - yl else: u64(0)
    else if op == .star:
        if xh != 0 and yh > m / xh:
            return fact_unmodeled(s, n, .unsupported)
        lo = xl * yl; hi = xh * yh
    else:
        return fact_unmodeled(s, n, .unsupported)
    v = fact_new(s, FactBound(int(lo) xor FACT_MIN, int(hi) xor FACT_MIN), FactTerm(type = T_U64))
    small = u64(1) << u64(62)
    if (op == .plus or op == .minus) and yl == yh and yl < small:
        d = if op == .plus: int(yl) else: -int(yl)
        fact_difference(s, v, a, d)
        fact_difference(s, a, v, -d)
    if op == .plus and xl == xh and xl < small:
        fact_difference(s, v, b, int(xl))
        fact_difference(s, b, v, -int(xl))
    v

# A deliberate conversion to mathematical int is an allocation boundary;
# evaluating the fixed-width source above it never allocated a bigint.
exact_gen_math = (n: int) -> Val:
    if math_proven_word(n): return math_pack_word(n, exact_low_word(n))
    exact_pack_words(n, exact_value(n))

exact_pack_words = (n: int, words: int[]) -> Val:
    if words.len() == 1: return math_pack_word(n, words[0])
    # Most statically wide expressions still produce an immediate at runtime.
    # Test its signed payload and extension words before constructing a bigint.
    tagged = e_bin(.shl, VI, words[0], e_iconst(1))
    small = e_bin(.eq, VI, e_bin(.shrs, VI, tagged, e_iconst(1)), words[0])
    sign = e_bin(.shrs, VI, words[0], e_iconst(63))
    loop i in [1..words.len()): small = e_bin(.and_, VI, small, e_bin(.eq, VI, words[i], sign))
    result = vreg(VI)
    iff(small)
    e_mov(result, tagged)
    els()
    old = ir_cold
    ir_cold = true
    # This is a representation boundary, not a chain of bigint arithmetic.
    # Copy the finite two's-complement words once; the runtime forms limbs in
    # O(words) without pulling in shifts and every generic arithmetic helper.
    buffer = e_slot(new_slot(words.len() * 8, 8))
    loop i in [0..words.len()): e_store(buffer, i * 8, words[i], 8)
    e_mov(result, e_call(rt("__mi_words"), [buffer, e_iconst(words.len())], VI))
    ir_cold = old
    endc()
    V(result, true)

# Round a static multiword integer directly to the destination float precision.
# Reduction retains 63 bits plus a sticky bit (round-to-odd), so the hardware
# conversion performs the only rounding. No mathematical-int allocation.
exact_gen_float = (n: int, to: int) -> Val:
    # Rounding a signed word commutes with positive power-of-two scaling.
    # Scale is finite in either format; zero retains its positive sign. This
    # avoids materializing a double word and calling its rounding helper.
    if nodes[n].kind == .binary and nodes[n].op == i32(int(Tok.star)):
        a = int(nodes[n].a); b = int(nodes[n].b)
        known, scale = integer_constant(b)
        if known and scale > 0 and scale & (scale - 1) == 0 and exact_lower_bits(a) <= 64:
            ft = vt_of(to)
            return V(e_bin(.fmul, ft, e_un(.i2f, ft, exact_low_word(a)), e_fconst(f64(scale), ft)), false)
    source = exact_value(n)
    if source.len() == 1: return V(e_un(.i2f, vt_of(to), source[0]), false)
    if source.len() == 2:
        helper = if to == T_F32: "__exact_i128_f32" else: "__exact_i128_f64"
        return V(e_call(rt(helper), source, vt_of(to)), false)
    size = source.len()
    negative = e_bin(.lts, VI, source[size - 1], e_iconst(0))
    magnitude = exact_select(negative, exact_neg(source, size), source, size)
    words: int[]
    loop word in magnitude:
        saved = vreg(VI); e_mov(saved, word); words.push(saved)
    shift = vreg(VI); e_mov(shift, e_iconst(0))
    sticky = vreg(VI); e_mov(sticky, e_iconst(0))
    step = 1
    loop step < size * 64: step *= 2
    loop step > 0:
        cut = 62 + step
        if cut < size * 64:
            high = e_bin(.shru, VI, words[cut / 64], e_iconst(cut % 64))
            loop i in [cut / 64 + 1..size): high = e_bin(.or_, VI, high, words[i])
            iff(e_bin(.ne, VI, high, e_iconst(0)))
            lost = e_iconst(0)
            loop i in [0..step / 64): lost = e_bin(.or_, VI, lost, words[i])
            if step % 64 != 0: lost = e_bin(.or_, VI, lost, e_bin(.and_, VI, words[step / 64], e_iconst((1 << (step % 64)) - 1)))
            e_mov(sticky, e_bin(.or_, VI, sticky, lost))
            next: int[]
            loop i in [0..size):
                at = i + step / 64
                word = if at < size: words[at] else: e_iconst(0)
                if step % 64 != 0:
                    word = e_bin(.shru, VI, word, e_iconst(step % 64))
                    if at + 1 < size: word = e_bin(.or_, VI, word, e_bin(.shl, VI, words[at + 1], e_iconst(64 - step % 64)))
                saved = vreg(VI); e_mov(saved, word); next.push(saved)
            loop i in [0..size): e_mov(words[i], next[i])
            e_mov(shift, e_addi(shift, step))
            endc()
        step /= 2
    significand = e_bin(.or_, VI, words[0], e_bin(.ne, VI, sticky, e_iconst(0)))
    precision = vt_of(to)
    bias = if to == T_F32: 127 else: 1023
    fraction = if to == T_F32: 23 else: 52
    exponent = vreg(VI); e_mov(exponent, e_addi(shift, bias))
    iff(e_bin(.gts, VI, exponent, e_iconst(2 * bias + 1)))
    e_mov(exponent, e_iconst(2 * bias + 1))
    endc()
    scale = e_un(.bits2f, precision, e_bin(.shl, VI, exponent, e_iconst(fraction)))
    result = vreg(precision)
    e_mov(result, e_bin(.fmul, precision, e_un(.u2f, precision, significand), scale))
    iff(negative)
    e_mov(result, e_un(.fneg, precision, result))
    endc()
    V(result, false)

exact_reset = ():
    exr_plans.clear()
    exr_call_target = 0
    exr_fast = false
    exr_locals = []
    exact_word_formats.clear()
    exact_rep_demands = []
    exact_rep_owners = []
    exact_effect_owners = []
    exact_local_widths = []
    exact_raw_values = []
    math_word_captures = {}
    eg_lo = []; eg_hi = []; eg_owner = []; eg_version = []; eg_stack = []; eg_demanded = []
    exact_map_functions = []
    exact_progress_assignments = []; exact_write_heads = []; exact_write_values = []; exact_write_next = []; exact_write_targets = []; exact_write_seen = []; exact_progress_opaque = []
    exact_dependency_seen = []; exact_dependency_epoch = 0
    positive_collecting_writes = false
    positive_cache = []; positive_stamp = []; positive_epoch += 1
    exact_measure_on = env("DEWY_NOWRAP_MEASURE") != none
    exact_measure_sites = {}
    exact_owners = {}
    exact_full_owners = {}
    exact_candidate_heads = []; exact_candidate_nodes = []; exact_candidate_next = []
    exact_float_purity = []
    exact_lower_sites = []; exact_collect_writes = false
    exact_demands = {}
    exact_proof_demands = {}
    exact_shader_roots = []
    exact_shader_owners = {}
    exact_progress_math = {}
    exact_word_reads = {}
    exact_initializers = []
    exact_iteration_sources = []
    exact_nodes = []
    exact_stores = {}
    exact_widths = []
    exact_type_widths = []
    exact_type_values = []
    exact_shifts = {}
    exact_count_nodes = []
    exact_count_index = []
    exact_count_bounds = []
    exact_marks = []
    exact_ranges = []
    exact_range_meta = []
    exact_join_blocks = {}

# Mixed signed/unsigned comparisons must not compare biased and plain bounds.
# Rebase small unsigned intervals; larger ones exceed this interval engine.
exact_fact_signed = (s: mut FactState, value: int) -> int:
    b = fact_bound(s, value)
    if b.wide or b.hi >= 0: return fact_new(s, FactBound(wide = true), FactTerm(type = T_INT))
    b.lo = b.lo xor FACT_MIN
    b.hi = b.hi xor FACT_MIN
    fact_new(s, b, FactTerm(type = T_INT))

exact_match_literals = (n: int) -> bool:
    loop arm in kids(n):
        loop pattern in kids(arm):
            if nodes[pattern].kind != .plit and nodes[pattern].kind != .pwild: return false
    true

# Reuse the existing write-index induction proof for fixed counters as well as
# mathematical ones. Only a demanded exact function's assigned scalar with a
# nonnegative constant initializer requests it; all writes must fit the proof.
exact_counter_bound = (s: int):
    l = int(nodes[s].sym)
    if l <= 0 or prune(int(locals[l].type)) != T_INT or not exact_owners.has(cur_fn): return
    flags = int(locals[l].flags)
    if flags & LF_ASSIGNED == 0 or flags & (LF_PARAM | LF_MUTPARAM | LF_CAPTURE | LF_CAPTURED | LF_ALIAS | LF_BYREF | LF_ADDR | LF_SHARED | LF_QUIET | LF_EXPOSED | LF_SOAELEM | LF_ELEMALIAS) != 0: return
    init = int(nodes[s].b)
    if init <= 0 or nodes[init].kind != .int_lit or has_flag(init, NF_U64) or nodes[init].ival < 0: return
    math_prepare_writes()
    writes = math_writes.get(l) ?? []
    if writes.len() == 0: return
    limit = math_length_counter_limit(s, writes)
    if limit >= 0: math_word_limits[l] = limit

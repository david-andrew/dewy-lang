$runtime_checks

from p"fixed_index.dewy" import (fi_begin fi_event fi_template fi_children fi_declaration fi_index fi_finish FI_OPEN FI_CLOSE FI_RANGE)
from p"node_store.dewy" import (NK Node)
from p"checker_types.dewy" import TypeInfo
from p"checker_state.dewy" import (FnInst Local Global live_body_indexes live_body_user_globals live_body_global_mod)
from p"type_inference.dewy" import (tu_prune tu_zonk)
from p"checks_stmt_hooks.dewy" import (zonk_prelude zonk_local_error zonk_copy_warnings zonk_definite)
# Body finalization owns zonking: every node's type with an inference variable is
# replaced by what it resolved to, index and user-global summaries are counted, and
# write sites are collected for integer write proofs; a body that made no variable
# is only summarized. Work is O(nodes of the body), with private stacks; only a
# global's module (prelude or not) and diagnostics are host requests.
XZWord:type=int64<overflow='wrap'>
CheckerZonkInput:type=[
    nodes:ptr<array<Node>>
    lists:ptr<array<int32>>
    types:ptr<array<TypeInfo>>
    locals:ptr<array<Local>>
    globals:ptr<array<Global>>
    fns:ptr<array<FnInst>>
    write_sites:ptr<array<int64>>
    collect:ptr<bool>
    indexes:ptr<int64>
    user_globals:ptr<int64>
    var_counter:ptr<int64>
    type_binds:ptr<int64>
    type_exposures:ptr<int64>
    da_decls:ptr<array<int64>>
    math_int:ptr<int64>
]
let xz_nodes:ptr<array<Node>>=$unsafe (uint64(0) as ptr<array<Node>>)
let xz_lists:ptr<array<int32>>=$unsafe (uint64(0) as ptr<array<int32>>)
let xz_types:ptr<array<TypeInfo>>=$unsafe (uint64(0) as ptr<array<TypeInfo>>)
let xz_locals:ptr<array<Local>>=$unsafe (uint64(0) as ptr<array<Local>>)
let xz_globals:ptr<array<Global>>=$unsafe (uint64(0) as ptr<array<Global>>)
let xz_fns:ptr<array<FnInst>>=$unsafe (uint64(0) as ptr<array<FnInst>>)
let xz_sites:ptr<array<int64>>=$unsafe (uint64(0) as ptr<array<int64>>)
let xz_collect:ptr<bool>=$unsafe (uint64(0) as ptr<bool>)
let xz_indexes:ptr<int64>=$unsafe (uint64(0) as ptr<int64>)
let xz_user_globals:ptr<int64>=$unsafe (uint64(0) as ptr<int64>)
let xz_var_counter:ptr<int64>=$unsafe (uint64(0) as ptr<int64>)
let xz_type_binds:ptr<int64>=$unsafe (uint64(0) as ptr<int64>)
let xz_type_exposures:ptr<int64>=$unsafe (uint64(0) as ptr<int64>)
let xz_da_decls:ptr<array<int64>>=$unsafe (uint64(0) as ptr<array<int64>>)
let xz_math_int:ptr<int64>=$unsafe (uint64(0) as ptr<int64>)
# Private walk stacks; their storage is reused between bodies.
let xz_stack:array<int64>=[]
let xz_summary_stack:array<int64>=[]
checker_zonk_bind=(input:ptr<CheckerZonkInput>):>XZWord=>$unsafe {
    xz_nodes=input[0].nodes
    xz_lists=input[0].lists
    xz_types=input[0].types
    xz_locals=input[0].locals
    xz_globals=input[0].globals
    xz_fns=input[0].fns
    xz_sites=input[0].write_sites
    xz_collect=input[0].collect
    xz_indexes=input[0].indexes
    xz_user_globals=input[0].user_globals
    xz_var_counter=input[0].var_counter
    xz_type_binds=input[0].type_binds
    xz_type_exposures=input[0].type_exposures
    xz_da_decls=input[0].da_decls
    xz_math_int=input[0].math_int
    0
}
# A name that may reach user storage: a non-prelude global, or a narrowed alias
# (which may hide a reference to global storage). Frozen SK ordinals: local 1, global 2.
xz_user_global=(aux:int32 sym:int32):>bool=>$unsafe {
    if aux =? 2 {return not zonk_prelude(XZWord(xz_globals[0].ptr[XZWord(sym)].mod))}
    aux =? 1 and XZWord(xz_locals[0].ptr[XZWord(sym)].flags) & 8 not=? 0
}
# The counts zonking would make, for a body whose types it would leave as they are:
# the walk stops once it has found an index and a user global, which settle both
# (the counts do not depend on the order the nodes are visited in). The stack is a
# private buffer read through its pointer; zonking never grows the node arena.
xz_swap_call=(aux:int32 nlist:int32 sym:int32):>bool=>$unsafe {
    if aux not=? 0 or nlist not=? 3 or sym <=? 0 or XZWord(sym) >=? xz_fns[0].length {return false}
    let nm=xz_fns[0].ptr[XZWord(sym)].sym as array<uint8>
    nm.length >=? 7 and nm.ptr[0] =? 102 and nm.ptr[1] =? 95 and nm.ptr[2] =? 115 and nm.ptr[3] =? 119 and nm.ptr[4] =? 97 and nm.ptr[5] =? 112 and nm.ptr[6] =? 95
}
xz_is_leaf=(k:NK):>bool=>match k {
    <'int_lit'|'bool_lit'|'float_lit'|'none_lit'|'null_lit'|'dotname'|'lambda'> => true
    _ => false
}
xz_summary=(root:XZWord):>void=>$unsafe {
    if root =? 0 {return}
    if xz_summary_stack.length <? 256 {xz_summary_stack.resize(256)}
    let st=xz_summary_stack.ptr
    let cap=xz_summary_stack.length
    st[0]=int64(root)
    let sp:XZWord=1
    let index=false
    let global=false
    loop sp >? 0 {
        sp=sp - 1
        let n=XZWord(st[sp])
        let k=xz_nodes[0][n].kind
        if k =? 'ident' {
            if not global and xz_user_global(xz_nodes[0][n].aux xz_nodes[0][n].sym) {
                global=true
                xz_user_globals[0]=xz_user_globals[0] + 1
                if index {break}
            }
            continue
        }
        if xz_is_leaf(k) {continue}
        if not index and (k =? 'index' or (k =? 'call' and xz_nodes[0][n].aux =? 0 and xz_nodes[0][n].nlist =? 3 and xz_swap_call(xz_nodes[0][n].aux xz_nodes[0][n].nlist xz_nodes[0][n].sym))) {
            xz_indexes[0]=xz_indexes[0] + 1
            index=true
            if global {break}
        }
        # Every child, so the first pops first: the lists (second, then first), then d,
        # c, b and a, as a recursive walk visits them.
        let n1=XZWord(xz_nodes[0][n].nlist)
        let n2=XZWord(xz_nodes[0][n].nlist2)
        if sp + n1 + n2 + 4 >? cap {
            cap=(sp + n1 + n2 + 4) * 2
            xz_summary_stack.resize(cap)
            st=xz_summary_stack.ptr
        }
        if n2 >? 0 {
            let l2=XZWord(xz_nodes[0][n].list2)
            let i=n2 - 1
            loop i >=? 0 {
                let x=xz_lists[0][l2 + i]
                if x not=? 0 {
                    st[sp]=int64(x)
                    sp=sp + 1
                }
                i=i - 1
            }
        }
        if n1 >? 0 {
            let l1=XZWord(xz_nodes[0][n].list)
            let i=n1 - 1
            loop i >=? 0 {
                let x=xz_lists[0][l1 + i]
                if x not=? 0 {
                    st[sp]=int64(x)
                    sp=sp + 1
                }
                i=i - 1
            }
        }
        if k not=? 'for_' {
            if k not=? 'partial' and xz_nodes[0][n].d not=? 0 {
                st[sp]=int64(xz_nodes[0][n].d)
                sp=sp + 1
            }
            if xz_nodes[0][n].c not=? 0 {
                st[sp]=int64(xz_nodes[0][n].c)
                sp=sp + 1
            }
        }
        if xz_nodes[0][n].b not=? 0 {
            st[sp]=int64(xz_nodes[0][n].b)
            sp=sp + 1
        }
        if xz_nodes[0][n].a not=? 0 {
            st[sp]=int64(xz_nodes[0][n].a)
            sp=sp + 1
        }
    }
}
# Pre-order, as a recursive walk would go; a for or while loop's -n marks the end of
# its children. Only a type with variables in it can change, and only those are zonked.
# Reentrant through nothing: zonking only reads and makes types.
let xz_kflags_arr:array<uint8>=[]
let xz_kflags_p:ptr<uint8>=$unsafe (uint64(0) as ptr<uint8>)

xz_set_kf=(p:ptr<uint8> @tmp:array<Node> ks:array<NK> v:uint8):>void=>$unsafe {
    let tagp=tmp.ptr as ptr<uint32>
    loop k in ks {
        tmp.ptr[0].kind=k
        p[int64(tagp[0])]=v
    }
}
xz_init_kflags=():>void=>$unsafe {
    xz_kflags_arr=fill(uint8(0) 128)
    let p=xz_kflags_arr.ptr
    let tmp=[Node()]
    # bit 1 = pure leaf (no children, no special action)
    xz_set_kf(p @tmp ['int_lit' 'bool_lit' 'float_lit' 'none_lit' 'null_lit' 'dotname'] uint8(1))
    # bit 2 = collect site
    xz_set_kf(p @tmp ['vardecl' 'assign' 'return_' 'break_' 'continue_'] uint8(2))
    # bit 4 = special handling; combined with bit 2 where applicable
    xz_set_kf(p @tmp ['ident' 'index' 'call' 'fn_'] uint8(4))
    xz_set_kf(p @tmp ['lambda' 'for_' 'while_'] uint8(2 | 4))
    xz_kflags_p=p
}

xz_walk=<Proofs>(root:XZWord):>void=>$unsafe {
    if root =? 0 {return}
    if xz_kflags_arr.length =? 0 {xz_init_kflags()}
    if xz_stack.length <? 256 {xz_stack.resize(256)}
    let kf_p=xz_kflags_p
    let st=xz_stack.ptr
    let cap=xz_stack.length
    let collect=xz_collect[0]
    st[0]=int64(root)
    let sp:XZWord=1
    loop sp >? 0 {
        sp=sp - 1
        let n=XZWord(st[sp])
        if Proofs =? 1 and n >=? FI_OPEN {fi_event(n); continue}
        if n <? 0 {
            if collect {xz_sites[0].push(int64(n))}
            continue
        }
        let node=xz_nodes[0].ptr + n
        let t=XZWord(node[0].type)
        if t not=? 0 and XZWord(xz_types[0][t].flags) & 1 not=? 0 {
            let zonked=tu_zonk(t)
            node=xz_nodes[0].ptr + n
            node[0].type=int32<overflow='wrap'>(zonked)
        }
        let kf=kf_p[int64((node as ptr<uint32>)[0])]
        if kf =? uint8(1) {continue}
        let k=node[0].kind
        if kf not=? uint8(0) {
            if kf & uint8(4) not=? uint8(0) {
                if k =? 'ident' {
                    if xz_user_global(node[0].aux node[0].sym) {xz_user_globals[0]=xz_user_globals[0] + 1}
                    continue
                }
                if k =? 'index' or (k =? 'call' and node[0].aux =? 0 and node[0].nlist =? 3 and xz_swap_call(node[0].aux node[0].nlist node[0].sym)) {xz_indexes[0]=xz_indexes[0] + 1}
                if k =? 'fn_' {
                    collect=false
                    xz_collect[0]=false
                }
            }
            if collect and (kf & uint8(2) not=? uint8(0)) {xz_sites[0].push(int64(n))}
        }
        if Proofs =? 1 {
            if k =? 'fn_' {fi_template()}
            if k =? 'index' {fi_index(n)}
            if k =? 'vardecl' {fi_declaration(n)}
            if k =? 'if_' or k =? 'and_' or k =? 'or_' or k =? 'block' {
                let next=fi_children(n @xz_stack sp)
                if next >=? 0 {
                    sp=next
                    st=xz_stack.ptr
                    cap=xz_stack.length
                    continue
                }
            }
        }
        if kf & uint8(4) not=? uint8(0) {
            if k =? 'lambda' {continue}
            if k =? 'for_' or k =? 'while_' {
                if sp + 1 >? cap {
                    cap=(sp + 1) * 2
                    xz_stack.resize(cap)
                    st=xz_stack.ptr
                }
                st[sp]=int64(0 - n)
                sp=sp + 1
            }
        }
        # Every child, so the first pops first: the lists (second, then first), then d,
        # c, b and a, as a recursive walk visits them.
        let n1=XZWord(node[0].nlist)
        let n2=XZWord(node[0].nlist2)
        let slots:XZWord=if Proofs =? 1 {7} else {4}
        if sp + n1 + n2 + slots >? cap {
            cap=(sp + n1 + n2 + slots) * 2
            xz_stack.resize(cap)
            st=xz_stack.ptr
        }
        if n2 >? 0 {
            let l2=XZWord(node[0].list2)
            let i=n2 - 1
            loop i >=? 0 {
                let x=xz_lists[0][l2 + i]
                if x not=? 0 {
                    st[sp]=int64(x)
                    sp=sp + 1
                }
                i=i - 1
            }
        }
        if n1 >? 0 {
            let l1=XZWord(node[0].list)
            let i=n1 - 1
            loop i >=? 0 {
                let x=xz_lists[0][l1 + i]
                if x not=? 0 {
                    st[sp]=int64(x)
                    sp=sp + 1
                }
                i=i - 1
            }
        }
        if k not=? 'for_' {
            if k not=? 'partial' and node[0].d not=? 0 {
                st[sp]=int64(node[0].d)
                sp=sp + 1
            }
            if node[0].c not=? 0 {
                st[sp]=int64(node[0].c)
                sp=sp + 1
            }
        }
        if Proofs =? 1 and k =? 'for_' and node[0].b not=? 0 {
            st[sp]=FI_CLOSE
            st[sp+1]=int64(node[0].b)
            st[sp+2]=int64(FI_RANGE + n)
            st[sp+3]=FI_OPEN
            sp=sp+4
        } else if node[0].b not=? 0 {
            st[sp]=int64(node[0].b)
            sp=sp + 1
        }
        if node[0].a not=? 0 {
            st[sp]=int64(node[0].a)
            sp=sp + 1
        }
    }
}
xz_tree=(root:XZWord):>void=>{xz_walk<0>(root)}
# Frozen FK_NORMAL ordinal 0 and LF_ASSIGNED 16.
xz_finalize=(f:XZWord vars0:XZWord binds0:XZWord exposed0:XZWord da_mark:XZWord):>void=>$unsafe {
    let body=XZWord(xz_fns[0].ptr[f].body)
    let index_mark=xz_indexes[0]
    let global_mark=xz_user_globals[0]
    let saved_sites=xz_sites[0]
    let saved_collect=xz_collect[0]
    xz_sites[0]=[]
    xz_collect[0]=false
    let normal=xz_fns[0].ptr[f].kind =? 0
    # Other functions retain the demanded lowering walk. No proof is needed merely
    # because a body contains arithmetic or a read-only integer.
    if normal {
        let count0=xz_fns[0].ptr[f].locals.length
        let lp=xz_fns[0].ptr[f].locals.ptr
        let locs=xz_locals[0].ptr
        let mi=xz_math_int[0]
        loop i in [0..count0) {
            let l=lp[i]
            if XZWord(locs[l].flags) & 16 not=? 0 and tu_prune(XZWord(locs[l].type)) =? mi {
                xz_collect[0]=true
                break
            }
        }
    }
    # A normal body checked without making or binding a type variable, nor taking a
    # result still being worked out, has no type a zonk would change.
    let quiet=normal and not xz_collect[0] and xz_var_counter[0] =? vars0 and xz_type_binds[0] =? binds0 and xz_type_exposures[0] =? exposed0
    let no_idx=false
    let no_ug=false
    if normal and fi_begin(f) {
        fi_event(FI_OPEN)
        xz_walk<1>(body)
        fi_finish()
        no_idx=xz_indexes[0] =? index_mark
        no_ug=xz_user_globals[0] =? global_mark
    } else if quiet {
        no_idx=live_body_indexes =? 0
        no_ug=live_body_user_globals =? 0 and (live_body_global_mod <? 0 or zonk_prelude(live_body_global_mod))
    } else {
        xz_tree(body)
        no_idx=normal and xz_indexes[0] =? index_mark
        no_ug=normal and xz_user_globals[0] =? global_mark
    }
    xz_fns[0][f].write_sites=xz_sites[0]
    xz_fns[0].ptr[f].writes_ready=xz_collect[0]
    xz_sites[0]=saved_sites
    xz_collect[0]=saved_collect
    xz_fns[0].ptr[f].no_indexes=no_idx
    xz_fns[0].ptr[f].no_user_globals=no_ug
    let count=xz_fns[0].ptr[f].locals.length
    loop i in [0..count) {
        let l=xz_fns[0].ptr[f].locals.ptr[i]
        let lt=XZWord(xz_locals[0].ptr[l].type)
        if lt not=? 0 and XZWord(xz_types[0].ptr[lt].flags) & 1 not=? 0 {
            let zonked=tu_zonk(lt)
            xz_locals[0].ptr[l].type=int32<overflow='wrap'>(zonked)
            if XZWord(xz_types[0].ptr[tu_prune(zonked)].flags) & 1 not=? 0 {zonk_local_error(l)}
        }
    }
    zonk_copy_warnings(f)
    if xz_da_decls[0].length >? da_mark {zonk_definite(body da_mark)}
}

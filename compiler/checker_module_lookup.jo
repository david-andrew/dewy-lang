use 'checker_call_queries.dewy'
use 'checker_home_index.dewy'
use 'prelude_ops.dewy'
use 'ide.jo'
use 'check.jo'
use 'prelude.jo'
use 'secrets.jo'
use 'util.jo'

game_lookup_skip = (name: int) -> bool:
    if intrinsic_of(name) >= 0 or name == secret_name: return true
    w = name_of(name)
    w == "none" or w == "rational" or w == "members" or w == "__dewy_divide" or w == "__dewy_power" or w == "__floor_div" or w == "__floor_mod" or (len(w) > 0 and w[0] == '$')

ml_bump_name = (name: int):
    ml_tick += 1
    if ml_name_tick.len() <= name: ml_name_tick.resize(name * 2 + 64)
    ml_name_tick[name] = ml_tick

ml_stamp = (name: int) -> int:
    if name < ml_name_tick.len() and ml_name_tick[name] > ml_struct: return ml_name_tick[name]
    ml_struct

demand_name = (name: int):
    if name < demanded.len() and demanded[name]: return
    if demanded.len() <= name: demanded.resize(name * 2 + 64)
    demanded[name] = true
    demand_prelude_name(name)

module_lookup = (m: int, name: int) -> int:
    if name < ml_at.len() and ml_at[name] == ml_stamp(name) and ml_mod[name] == m: return ml_sym[name]
    s = module_lookup_now(m, name)
    if not ide_on and (s != 0 or (not prelude_std_pending and not prelude_game_pending) or (game_lookup_ok and (m < 0 or not modules[m].is_prelude) and not game_lookup_skip(name))):
        if ml_at.len() <= name:
            grown = name * 2 + 64
            ml_at.resize(grown)
            ml_mod.resize(grown)
            ml_sym.resize(grown)
        ml_at[name] = ml_stamp(name)
        ml_mod[name] = m
        ml_sym[name] = s
    s

CopyWord:type=int64<overflow='wrap'>
CopyU64:type=uint64<overflow='wrap'>
let copy_cost_arr:array<uint8>=[]
let copy_track_gen:array<int32>=[]
let copy_track_cur:int32=0
let copy_track_on:bool=false
let copy_has_owners:bool=false
let copy_esc_gen:array<int32>=[]
let copy_esc_bit:array<int32>=[]
let copy_esc_cur:int32=0
let copy_esc_hit:CopyU64=0
let copy_esc_target:CopyU64=0
copies_reset=():>void=>$unsafe {
    copies_on=false
    copy_track_on=false
    copy_has_owners=false
    if dir_copies_any {copies_on=true}
    copy_costs=dict<int64 int64>()
    copy_cost_arr.clear()
    copy_moves=dict<int64 bool>()
    copy_blocked=dict<int64 bool>()
    copy_explicit=dict<int64 bool>()
    copy_inputs=dict<int64 bool>()
    copy_bindings=dict<int64 bool>()
    copy_noenv=dict<int64 bool>()
    copy_borrowed=dict<int64 bool>()
    if copies_on {copies_parameters()}
    ownership_parameters()
    # (a `$__consume__` method's receiver: an owning parameter, as Dewy's own are)
    if ownership_consumers.length not=? 0 {
        loop f in [1..fns.length) {
            if fns.ptr[f].params.length >? 0 and ownership_consumers.has(CopyWord(fns.ptr[f].decl)) and ownership_type(CopyWord(fns.ptr[f].ptypes[0])) {copy_inputs[fns.ptr[f].params[0]]=true}
        }
    }
    ownership_validate()
    if ownership_decls.length not=? 0 {copies_on=true}
    if tb_generators_seen {
        copies_on=true
        loop f in [1..fns.length) {
            let fk=fns.ptr[f].kind
            if fk not=? FK_NORMAL and fk not=? FK_LAMBDA {continue}
            let body=CopyWord(fns.ptr[f].body)
            if body not=? 0 {
                loop i in [0..nkids(body)) {
                    let s=kid(body i)
                    if nodes.ptr[s].kind not=? 'vardecl' or node_aux2(nodes.ptr[s].op_ext) not=? 1 {break}
                    if nkids(s) >? 0 {continue}
                    let l=CopyWord(nodes.ptr[s].sym)
                    let source=CopyWord(nodes.ptr[s].b)
                    if nodes.ptr[source].kind not=? 'ident' or nodes.ptr[source].aux not=? int32(1) {continue}
                    let p=CopyWord(nodes.ptr[source].sym)
                    if gen_type_contains(CopyWord(locals.ptr[l].type)) {
                        copy_inputs[p]=true
                        copy_bindings[l]=true
                    }
                }
            }
            loop p in fns.ptr[f].params {
                if CopyWord(locals.ptr[p].flags) & LF_MUTPARAM =? 0 and gen_type_contains(CopyWord(locals.ptr[p].type)) {
                    copy_inputs[p]=true
                }
            }
        }
    }
}
copy_consumes=(f:CopyWord i:CopyWord):>bool=>$unsafe {
    f >? 0 and i <? fns.ptr[f].params.length and copy_inputs.has(fns.ptr[f].params[i])
}
# Does this local cross an owning boundary? Scalar projections and read-only
# direct calls do not. Unknown calls and escaping aggregate results fail closed.
# This is also the escape check for sharing a read-only local snapshot.
copy_escapes=(n:CopyWord l:CopyWord owning:bool=false):>bool=>$unsafe {
    if n =? 0 {return false}
    copy_escapes_walk(n l ownership_type(CopyWord(locals.ptr[l].type)) owning)
}
copy_escapes_walk=(n:CopyWord l:CopyWord l_owned:bool owning0:bool=false):>bool=>$unsafe {
    if n =? 0 {return false}
    let owning=owning0 and (not l_owned or ownership_type(ntype(n)))
    let k=nodes.ptr[n].kind
    if k =? 'ident' {
        return owning and nodes.ptr[n].aux =? int32(1) and nodes.ptr[n].sym =? int32(l)
    }
    if k =? 'conv' and nodes.ptr[n].aux =? int32(int64(CV.explicit_copy)) {return false}
    if k =? 'field' or k =? 'index' or k =? 'narrow' or k =? 'unwrap' {
        if copy_escapes_walk(CopyWord(nodes.ptr[n].a) l l_owned owning and costly_copy(ntype(n))) {return true}
        if k =? 'index' {return copy_escapes_walk(CopyWord(nodes.ptr[n].b) l l_owned)}
        return false
    }
    if k =? 'return_' {return copy_escapes_walk(CopyWord(nodes.ptr[n].a) l l_owned true)}
    if k =? 'vardecl' {
        if node_aux2(nodes.ptr[n].op_ext) =? 1 {return false}
        return copy_escapes_walk(CopyWord(nodes.ptr[n].b) l l_owned true)
    }
    if k =? 'assign' {
        return copy_escapes_walk(CopyWord(nodes.ptr[n].a) l l_owned) or copy_escapes_walk(CopyWord(nodes.ptr[n].b) l l_owned true)
    }
    if k =? 'call' {
        let aux=CopyWord(nodes.ptr[n].aux)
        let f=if aux =? 0 {CopyWord(nodes.ptr[n].sym)} else {0}
        if copy_escapes_walk(CopyWord(nodes.ptr[n].a) l l_owned) {return true}
        loop i in [0..nkids(n)) {
            let take=aux not=? 0 or copy_consumes(f i) or costly_copy(ntype(n))
            if f >? 0 and i <? fns.ptr[f].params.length and CopyWord(locals.ptr[fns.ptr[f].params[i]].flags) & LF_MUTPARAM not=? 0 {take=false}
            # (a checked callee that keeps this parameter borrowed cannot return
            # its storage without a copy of its own: `sha256(key)`)
            if aux =? 0 and f >? 0 and i <? fns.ptr[f].params.length and copy_borrowed.has(fns.ptr[f].params[i]) and not copy_consumes(f i) {take=false}
            if copy_escapes_walk(kid(n i) l l_owned take) {return true}
        }
        return false
    }
    if k =? 'intrinsic' {
        let id=nodes.ptr[n].aux as IN
        loop i in [0..nkids(n)) {
            let take=i >? 0 and (id =? IN.push or id =? IN.insert)
            # (extend copies the source's elements, never adopts its storage)
            if id =? IN.extend and i =? 1 {take=costly_copy(telem(ntype(kid(n 0))))}
            if id =? IN.fill and i =? 0 {take=true}
            if copy_escapes_walk(kid(n i) l l_owned take) {return true}
        }
        return false
    }
    if k =? 'block' {
        loop i in [0..nkids(n)) {
            if copy_escapes_walk(kid(n i) l l_owned nodes.ptr[n].aux not=? 0 and i =? nkids(n) - 1) {return true}
        }
        return false
    }
    if k =? 'if_' {
        return copy_escapes_walk(CopyWord(nodes.ptr[n].a) l l_owned) or copy_escapes_walk(CopyWord(nodes.ptr[n].b) l l_owned owning) or copy_escapes_walk(CopyWord(nodes.ptr[n].c) l l_owned owning)
    }
    let take=owning or k =? 'array' or k =? 'tuple' or k =? 'map_lit'
    let mask=CopyWord(iso_child_p[int64(((nodes.ptr + n) as ptr<uint32>)[0])])
    if mask <=? 0 {return false}
    if mask & 1 not=? 0 and nodes.ptr[n].a not=? 0 and copy_escapes_walk(CopyWord(nodes.ptr[n].a) l l_owned take) {return true}
    if mask & 2 not=? 0 and nodes.ptr[n].b not=? 0 and copy_escapes_walk(CopyWord(nodes.ptr[n].b) l l_owned take) {return true}
    if mask & 4 not=? 0 and nodes.ptr[n].c not=? 0 and copy_escapes_walk(CopyWord(nodes.ptr[n].c) l l_owned take) {return true}
    if mask & 16 not=? 0 {
        let list_start=CopyWord(nodes.ptr[n].list)
        let nk=CopyWord(nodes.ptr[n].nlist)
        loop i in [CopyWord(0)..nk) {
            if copy_escapes_walk(CopyWord(lists.ptr[list_start + i]) l l_owned take) {return true}
        }
    }
    false
}
copy_escapes_batch=(n:CopyWord owning:bool):>void=>$unsafe {
    if n =? 0 or copy_esc_hit =? copy_esc_target {return}
    let k=nodes.ptr[n].kind
    if k =? 'ident' {
        if owning and nodes.ptr[n].aux =? int32(1) {
            let l=CopyWord(nodes.ptr[n].sym)
            if l >=? 0 and l <? copy_esc_gen.length and copy_esc_gen.ptr[l] =? copy_esc_cur {
                copy_esc_hit |= CopyU64(1) << CopyU64(copy_esc_bit.ptr[l])
            }
        }
        return
    }
    if k =? 'conv' and nodes.ptr[n].aux =? int32(int64(CV.explicit_copy)) {return}
    if k =? 'field' or k =? 'index' or k =? 'narrow' or k =? 'unwrap' {
        let a=CopyWord(nodes.ptr[n].a)
        let b=CopyWord(nodes.ptr[n].b)
        copy_escapes_batch(a owning and costly_copy(ntype(n)))
        if k =? 'index' {copy_escapes_batch(b false)}
        return
    }
    if k =? 'return_' {copy_escapes_batch(CopyWord(nodes.ptr[n].a) true); return}
    if k =? 'vardecl' {
        if node_aux2(nodes.ptr[n].op_ext) =? 1 {return}
        copy_escapes_batch(CopyWord(nodes.ptr[n].b) true)
        return
    }
    if k =? 'assign' {
        let a=CopyWord(nodes.ptr[n].a)
        let b=CopyWord(nodes.ptr[n].b)
        copy_escapes_batch(a false)
        copy_escapes_batch(b true)
        return
    }
    if k =? 'call' {
        let aux=CopyWord(nodes.ptr[n].aux)
        let f=if aux =? 0 {CopyWord(nodes.ptr[n].sym)} else {0}
        let a=CopyWord(nodes.ptr[n].a)
        let nk=CopyWord(nodes.ptr[n].nlist)
        let lbase=CopyWord(nodes.ptr[n].list)
        copy_escapes_batch(a false)
        let nt_costly=if aux =? 0 {costly_copy(ntype(n))} else {true}
        loop i in [CopyWord(0)..nk) {
            let take=aux not=? 0 or copy_consumes(f i) or nt_costly
            if f >? 0 and i <? fns.ptr[f].params.length {
                let fp=fns.ptr[f].params.ptr[i]
                if CopyWord(locals.ptr[fp].flags) & LF_MUTPARAM not=? 0 {take=false}
                if aux =? 0 and copy_borrowed.has(fp) and not copy_consumes(f i) {take=false}
            }
            copy_escapes_batch(CopyWord(lists.ptr[lbase + i]) take)
            if copy_esc_hit =? copy_esc_target {return}
        }
        return
    }
    if k =? 'intrinsic' {
        let id=nodes.ptr[n].aux as IN
        let nk=CopyWord(nodes.ptr[n].nlist)
        let lbase=CopyWord(nodes.ptr[n].list)
        loop i in [CopyWord(0)..nk) {
            let take=i >? 0 and (id =? IN.push or id =? IN.insert)
            if id =? IN.extend and i =? 1 {take=costly_copy(telem(ntype(CopyWord(lists.ptr[lbase]))))}
            if id =? IN.fill and i =? 0 {take=true}
            copy_escapes_batch(CopyWord(lists.ptr[lbase + i]) take)
            if copy_esc_hit =? copy_esc_target {return}
        }
        return
    }
    if k =? 'block' {
        let nk=CopyWord(nodes.ptr[n].nlist)
        let lbase=CopyWord(nodes.ptr[n].list)
        let has_val=nodes.ptr[n].aux not=? 0
        loop i in [CopyWord(0)..nk) {
            copy_escapes_batch(CopyWord(lists.ptr[lbase + i]) has_val and i =? nk - 1)
            if copy_esc_hit =? copy_esc_target {return}
        }
        return
    }
    if k =? 'if_' {
        let a=CopyWord(nodes.ptr[n].a)
        let b=CopyWord(nodes.ptr[n].b)
        let c=CopyWord(nodes.ptr[n].c)
        copy_escapes_batch(a false)
        copy_escapes_batch(b owning)
        copy_escapes_batch(c owning)
        return
    }
    let take=owning or k =? 'array' or k =? 'tuple' or k =? 'map_lit'
    let mask=CopyWord(iso_child_p[int64(((nodes.ptr + n) as ptr<uint32>)[0])])
    if mask <=? 0 {return}
    if mask & 1 not=? 0 and nodes.ptr[n].a not=? 0 {copy_escapes_batch(CopyWord(nodes.ptr[n].a) take)}
    if mask & 2 not=? 0 and nodes.ptr[n].b not=? 0 {copy_escapes_batch(CopyWord(nodes.ptr[n].b) take)}
    if mask & 4 not=? 0 and nodes.ptr[n].c not=? 0 {copy_escapes_batch(CopyWord(nodes.ptr[n].c) take)}
    if mask & 16 not=? 0 {
        let list_start=CopyWord(nodes.ptr[n].list)
        let nk=CopyWord(nodes.ptr[n].nlist)
        loop i in [CopyWord(0)..nk) {
            copy_escapes_batch(CopyWord(lists.ptr[list_start + i]) take)
            if copy_esc_hit =? copy_esc_target {return}
        }
    }
}
# A closed direct callee can receive ownership instead of taking an entry
# snapshot. Handles, callbacks, exports and C entry points keep the borrowed
# ABI; their unsupported ownership proofs retain a diagnostic.
copies_parameters=():>void=>$unsafe {
    if not dir_copies_any {return}
    let cand_fns:array<int64>=[]
    loop f in [1..fns.length) {
        dir_code_owner=f
        let body=CopyWord(fns.ptr[f].body)
        if body =? 0 or not copy_strict(body) or fns.ptr[f].kind not=? FK_NORMAL or fns.ptr[f].cabi or (fns.ptr[f].export_name as array<uint8>).length >? 0 {continue}
        let has_cand=false
        let lbase=CopyWord(nodes.ptr[body].list)
        let nk=CopyWord(nodes.ptr[body].nlist)
        loop i in [CopyWord(0)..nk) {
            let s=CopyWord(lists.ptr[lbase + i])
            if nodes.ptr[s].kind not=? 'vardecl' or node_aux2(nodes.ptr[s].op_ext) not=? 1 {break}
            if nkids(s) >? 0 {continue}
            let l=CopyWord(nodes.ptr[s].sym)
            let source=CopyWord(nodes.ptr[s].b)
            if nodes.ptr[source].kind not=? 'ident' or nodes.ptr[source].aux not=? int32(1) {continue}
            let p=CopyWord(nodes.ptr[source].sym)
            if copy_inputs.has(p) or not costly_copy(CopyWord(locals.ptr[l].type)) {continue}
            has_cand=true
            break
        }
        if has_cand {cand_fns.push(f)}
    }
    if cand_fns.length =? 0 {
        dir_code_owner=0
        return
    }
    let indirect=dict<int64 bool>()
    let np=nodes.ptr
    let nn:CopyWord=nodes.length
    loop ni in [CopyWord(0)..nn) {
        let kp=(np + ni) as ptr<uint32>
        let kv=kp[0]
        if kv =? uint32(34) or kv =? uint32(35) {
            let sym=CopyWord(np[ni].sym)
            if sym >? 0 {indirect[sym]=true}
        }
    }
    let kept:array<int64>=[]
    loop ci in [0..cand_fns.length) {
        let f=cand_fns.ptr[ci]
        if indirect.has(f) {continue}
        let body=CopyWord(fns.ptr[f].body)
        let lbase=CopyWord(nodes.ptr[body].list)
        let nk=CopyWord(nodes.ptr[body].nlist)
        loop i in [CopyWord(0)..nk) {
            let s=CopyWord(lists.ptr[lbase + i])
            if nodes.ptr[s].kind not=? 'vardecl' or node_aux2(nodes.ptr[s].op_ext) not=? 1 {break}
            if nkids(s) >? 0 {continue}
            let l=CopyWord(nodes.ptr[s].sym)
            let source=CopyWord(nodes.ptr[s].b)
            if nodes.ptr[source].kind not=? 'ident' or nodes.ptr[source].aux not=? int32(1) {continue}
            let p=CopyWord(nodes.ptr[source].sym)
            if copy_inputs.has(p) or not costly_copy(CopyWord(locals.ptr[l].type)) {continue}
            copy_borrowed[p]=true
        }
        kept.push(f)
    }
    cand_fns=kept
    if cand_fns.length =? 0 {
        dir_code_owner=0
        return
    }
    let batch_l:array<int64>=[]
    let batch_p:array<int64>=[]
    let changed=true
    loop changed {
        changed=false
        loop ci in [0..cand_fns.length) {
            let f=cand_fns.ptr[ci]
            dir_code_owner=f
            let body=CopyWord(fns.ptr[f].body)
            let lbase=CopyWord(nodes.ptr[body].list)
            let nk=CopyWord(nodes.ptr[body].nlist)
            batch_l.clear()
            batch_p.clear()
            loop i in [CopyWord(0)..nk) {
                let s=CopyWord(lists.ptr[lbase + i])
                if nodes.ptr[s].kind not=? 'vardecl' or node_aux2(nodes.ptr[s].op_ext) not=? 1 {break}
                if nkids(s) >? 0 {continue}
                let l=CopyWord(nodes.ptr[s].sym)
                let source=CopyWord(nodes.ptr[s].b)
                if nodes.ptr[source].kind not=? 'ident' or nodes.ptr[source].aux not=? int32(1) {continue}
                let p=CopyWord(nodes.ptr[source].sym)
                if copy_inputs.has(p) or not costly_copy(CopyWord(locals.ptr[l].type)) {continue}
                if CopyWord(locals.ptr[l].flags) & (LF_ASSIGNED | LF_CAPTURED | LF_EXPOSED) not=? 0 {
                    copy_inputs[p]=true
                    copy_bindings[l]=true
                    changed=true
                } else if ownership_type(CopyWord(locals.ptr[l].type)) or batch_l.length >=? 64 {
                    if copy_escapes(body l) {
                        copy_inputs[p]=true
                        copy_bindings[l]=true
                        changed=true
                    }
                } else {
                    batch_l.push(l)
                    batch_p.push(p)
                }
            }
            let bn=batch_l.length
            if bn =? 1 {
                if copy_escapes(body batch_l.ptr[0]) {
                    copy_inputs[batch_p.ptr[0]]=true
                    copy_bindings[batch_l.ptr[0]]=true
                    changed=true
                }
            } else if bn >? 1 {
                if copy_esc_gen.length <? locals.length {
                    let sz=locals.length + 64
                    copy_esc_gen.resize(sz)
                    copy_esc_bit.resize(sz)
                }
                if copy_esc_cur >=? int32(2147483640) or copy_esc_cur <? int32(0) {
                    mem_set(copy_esc_gen.ptr as ptr<uint8> 0 copy_esc_gen.length * 4)
                    copy_esc_cur=int32(0)
                }
                copy_esc_cur=int32<overflow='wrap'>(int64(copy_esc_cur) + 1)
                let g=copy_esc_cur
                let egp=copy_esc_gen.ptr
                let ebp=copy_esc_bit.ptr
                let blp=batch_l.ptr
                loop bi in [0..bn) {
                    let bl=blp[bi]
                    egp[bl]=g
                    ebp[bl]=int32(bi)
                }
                copy_esc_hit=CopyU64(0)
                copy_esc_target=if bn =? 64 {~CopyU64(0)} else {(CopyU64(1) << CopyU64(bn)) - CopyU64(1)}
                copy_escapes_batch(body false)
                if copy_esc_hit not=? CopyU64(0) {
                    let bpp=batch_p.ptr
                    loop bi in [0..bn) {
                        if (copy_esc_hit & (CopyU64(1) << CopyU64(bi))) not=? CopyU64(0) {
                            copy_inputs[bpp[bi]]=true
                            copy_bindings[blp[bi]]=true
                            changed=true
                        }
                    }
                }
            }
        }
    }
    dir_code_owner=0
}
copy_strict=(e:CopyWord):>bool=>$unsafe {
    e >? 0 and dir_copies_any and dir_explicit_copies(nodes.ptr[e].pos)
}
costly_copy=(t0:CopyWord):>bool=>$unsafe {
    let t=prune(t0)
    if t <? copy_cost_arr.length {
        let cv=copy_cost_arr.ptr[t]
        if cv not=? 0 {return cv not=? 2}
    } else {
        copy_cost_arr.resize(max(t + 1 types.length) + 64)
    }
    # (an Arena's copy is another arena, sharing nothing it will use: lib/std/arena.jo)
    if arena_handle(t) {
        copy_cost_arr.ptr[t]=2
        return false
    }
    copy_cost_arr.ptr[t]=1
    let k=tkind(t)
    let costly=k =? 'array' or k =? 'fn_' or k =? 'polyfn' or k =? 'box'
    if k =? 'fixed' or k =? 'opt' {costly=costly_copy(telem(t))}
    else if k =? 'tuple' {
        loop i in [0..CopyWord(types.ptr[t].nargs)) {
            if costly_copy(targ(t i)) {costly=true}
        }
    }
    else if k =? 'enum_' {
        let si=CopyWord(types.ptr[t].st)
        layout(t)
        loop i in [0..CopyWord(structs.ptr[si].nvariants)) {
            let v=CopyWord(structs.ptr[si].variants) + i
            loop j in [0..CopyWord(variants.ptr[v].nfields)) {
                if costly_copy(CopyWord(fields.ptr[CopyWord(variants.ptr[v].fields) + j].type)) {costly=true}
            }
        }
    }
    else if k =? 'struct_' {
        layout(t)
        loop field in field_list(t) {
            if costly_copy(field[0]) {costly=true}
        }
    }
    if t >=? copy_cost_arr.length {copy_cost_arr.resize(max(t + 1 types.length) + 64)}
    copy_cost_arr.ptr[t]=if costly {3} else {2}
    costly
}
copy_error=(e:CopyWord why:string):>void=>$unsafe {
    fatal(nodes.ptr[e].pos "implicit costly copy of {dt(ntype(e))}: {why}; use `.copy`, a view (`const view = @source`), or restructure to transfer the value at its last use")
}
copy_reason=(t:CopyWord):>string=>{
    let k=tkind(t)
    if k =? 'fn_' or k =? 'polyfn' {return "duplicating a closure environment is not proven unnecessary"}
    if k =? 'array' {return "runtime-sized mutable array storage may need duplication or detachment"}
    "the value contains heap payloads that may need duplication or detachment"
}
# Use runtime children, never local IDs or type syntax. The liveness proof is
# deliberately conservative across loops, defers and captured/exposed places.
copy_children=(n:CopyWord):>array<int64>=>$unsafe {
    let out:array<int64>=[]
    let mask=isolation_children(nodes.ptr[n].kind)
    if mask <? 0 {return out}
    if mask & 1 not=? 0 and nodes.ptr[n].a not=? 0 {out.push(CopyWord(nodes.ptr[n].a))}
    if mask & 2 not=? 0 and nodes.ptr[n].b not=? 0 {out.push(CopyWord(nodes.ptr[n].b))}
    if mask & 4 not=? 0 and nodes.ptr[n].c not=? 0 {out.push(CopyWord(nodes.ptr[n].c))}
    if mask & 16 not=? 0 {
        loop i in [0..nkids(n)) {out.push(kid(n i))}
    }
    out
}
let copy_call_seen_gen:array<int32>=[]
let copy_call_here_gen:array<int32>=[]
let copy_call_gen:int32=0

copy_local_tracked=(l:CopyWord):>bool=>$unsafe {
    not copy_track_on or (l >=? 0 and l <? copy_track_gen.length and copy_track_gen.ptr[l] =? copy_track_cur)
}
copy_mentions_call=(n:CopyWord g_seen:int32 g_here:int32 seen_p:ptr<int32> here_p:ptr<int32> @live:dict<int64 bool>):>void=>$unsafe {
    if n =? 0 {return}
    let k=nodes.ptr[n].kind
    if k =? 'lambda' or k =? 'lazy_' {
        let f=CopyWord(nodes.ptr[n].sym)
        if k =? 'lambda' and has_flag(n NF_GENERIC) {f=poly_families[CopyWord(nodes.ptr[n].aux)].envfn}
        loop cap in fns.ptr[f].caps {
            let l=int64(cap.outer)
            if not copy_local_tracked(l) {continue}
            if here_p[l] not=? g_here {
                here_p[l]=g_here
                if seen_p[l] =? g_seen {live[l]=true} else {seen_p[l]=g_seen}
            }
        }
        return
    }
    if k =? 'ident' and nodes.ptr[n].aux =? int32(1) {
        let l=CopyWord(nodes.ptr[n].sym)
        if copy_local_tracked(l) and here_p[l] not=? g_here {
            here_p[l]=g_here
            if seen_p[l] =? g_seen {live[l]=true} else {seen_p[l]=g_seen}
        }
        return
    }
    let mask=CopyWord(iso_child_p[int64(((nodes.ptr + n) as ptr<uint32>)[0])])
    if mask <=? 0 {return}
    if mask & 1 not=? 0 and nodes.ptr[n].a not=? 0 {copy_mentions_call(CopyWord(nodes.ptr[n].a) g_seen g_here seen_p here_p @live)}
    if mask & 2 not=? 0 and nodes.ptr[n].b not=? 0 {copy_mentions_call(CopyWord(nodes.ptr[n].b) g_seen g_here seen_p here_p @live)}
    if mask & 4 not=? 0 and nodes.ptr[n].c not=? 0 {copy_mentions_call(CopyWord(nodes.ptr[n].c) g_seen g_here seen_p here_p @live)}
    if mask & 16 not=? 0 {
        let list_start=CopyWord(nodes.ptr[n].list)
        let nk=CopyWord(nodes.ptr[n].nlist)
        loop i in [CopyWord(0)..nk) {copy_mentions_call(CopyWord(lists.ptr[list_start + i]) g_seen g_here seen_p here_p @live)}
    }
}

copy_mentions=(n:CopyWord @live:dict<int64 bool>):>void=>$unsafe {
    if n =? 0 {return}
    let k=nodes.ptr[n].kind
    if k =? 'lambda' or k =? 'lazy_' {
        let f=CopyWord(nodes.ptr[n].sym)
        if k =? 'lambda' and has_flag(n NF_GENERIC) {f=poly_families[CopyWord(nodes.ptr[n].aux)].envfn}
        loop cap in fns.ptr[f].caps {
            let l=int64(cap.outer)
            if copy_local_tracked(l) {live[l]=true}
        }
        return
    }
    if k =? 'ident' and nodes.ptr[n].aux =? int32(1) {
        let l=CopyWord(nodes.ptr[n].sym)
        if copy_local_tracked(l) {live[l]=true}
        return
    }
    let mask=CopyWord(iso_child_p[int64(((nodes.ptr + n) as ptr<uint32>)[0])])
    if mask <=? 0 {return}
    if mask & 1 not=? 0 and nodes.ptr[n].a not=? 0 {copy_mentions(CopyWord(nodes.ptr[n].a) @live)}
    if mask & 2 not=? 0 and nodes.ptr[n].b not=? 0 {copy_mentions(CopyWord(nodes.ptr[n].b) @live)}
    if mask & 4 not=? 0 and nodes.ptr[n].c not=? 0 {copy_mentions(CopyWord(nodes.ptr[n].c) @live)}
    if mask & 16 not=? 0 {
        let list_start=CopyWord(nodes.ptr[n].list)
        let nk=CopyWord(nodes.ptr[n].nlist)
        loop i in [CopyWord(0)..nk) {copy_mentions(CopyWord(lists.ptr[list_start + i]) @live)}
    }
}
# Field paths are per-function and only demanded for resource records.
copy_field=(n0:CopyWord):>CopyWord=>$unsafe {
    let n=n0
    let path=""
    loop nodes.ptr[n].kind =? 'field' {
        let a=CopyWord(nodes.ptr[n].a)
        let t=ntype(a)
        if nodes.ptr[n].aux <? 0 or tkind(t) not=? 'struct_' or ownership_nominal(t) or is_map_type(t) {return 0}
        if n not=? n0 and boxed_field_of(n) >=? 0 {return 0}
        path="{CopyWord(nodes.ptr[n].aux)}/{path}"
        n=a
    }
    if n =? n0 or nodes.ptr[n].kind not=? 'ident' or nodes.ptr[n].aux not=? int32(1) or not ownership_type(ntype(n)) {return 0}
    let l=CopyWord(nodes.ptr[n].sym)
    loop i in [0..copy_fields.length) {
        let p=copy_fields[i]
        if p[0] =? l and p[1] =? path {return -1 - i}
    }
    copy_fields.push([l path])
    -copy_fields.length
}
copy_field_live=(key:CopyWord live:dict<int64 bool>):>bool=>{
    let p=copy_fields[-1 - key]
    if live.has(p[0]) {return true}
    loop [k used] in live {
        if k >=? 0 {continue}
        let q=copy_fields[-1 - k]
        if p[0] =? q[0] and (starts_with(p[1] q[1]) or starts_with(q[1] p[1])) {return true}
    }
    false
}
copy_local_live=(l:CopyWord live:dict<int64 bool>):>bool=>{
    if live.has(l) {return true}
    if copy_fields.length =? 0 {return false}
    loop [k used] in live {
        if k <? 0 and copy_fields[-1 - k][0] =? l {return true}
    }
    false
}
copy_kill_local=(l:CopyWord @live:dict<int64 bool>):>void=>$unsafe {
    if not copy_local_tracked(l) {return}
    if live.length >? 0 {live.remove(l);}
    if copy_fields.length =? 0 {return}
    loop i in [0..copy_fields.length) {
        if copy_fields[i][0] =? l {live.remove(-1 - i);}
    }
}
copy_live=(n:CopyWord @live:dict<int64 bool>):>void=>$unsafe {
    if n =? 0 {return}
    if copy_proof_budget =? 0 {return}
    if copy_proof_budget >? 0 {copy_proof_budget -= 1}
    let k=nodes.ptr[n].kind
    if (k =? 'break_' or k =? 'continue_') and copy_loop_after.length >? 0 {
        let depth=copy_loop_after.length - 1 - CopyWord(nodes.ptr[n].ival)
        let edge=if k =? 'break_' {copy_loop_after[depth]} else {copy_loop_back[depth]}
        live.clear()
        loop [l used] in edge {live[l]=used}
        return
    }
    if k =? 'lambda' or k =? 'lazy_' {
        let ids=copy_capture_ids(n)
        let i=ids.length - 1
        loop i >=? 0 {
            copy_live(ids.ptr[i] @live)
            i -= 1
        }
        return
    }
    if k =? 'return_' or (k =? 'yield_' and (nodes.ptr[n].aux =? 2 or nodes.ptr[n].aux =? 3)) {live.clear()}
    if copy_has_owners and k =? 'field' {
        let key=copy_field(n)
        if key <? 0 {
            let l=copy_fields[-1 - key][0]
            let skip=LF_PARAM | LF_MUTPARAM | LF_ALIAS | LF_BYREF | LF_CAPTURE | LF_CAPTURED | LF_EXPOSED
            if copy_inputs.length >? 0 and copy_inputs.has(l) {skip &= ~LF_PARAM}
            if boxed_field_of(n) <? 0 and not copy_field_live(key live) and (copy_blocked.length =? 0 or not copy_blocked.has(l)) and CopyWord(locals.ptr[l].flags) & skip =? 0 {copy_moves[n]=true}
            live[key]=true
            return
        }
    }
    if k =? 'ident' and nodes.ptr[n].aux =? int32(1) {
        let l=CopyWord(nodes.ptr[n].sym)
        if not copy_local_tracked(l) {return}
        # (a narrowed name reads the local it narrows: its last use may move that part out)
        if copy_parts and copy_part_roots.has(l) {
            let r=copy_part_roots.get(l) ?? 0
            let skip=LF_PARAM | LF_MUTPARAM | LF_ALIAS | LF_BYREF | LF_CAPTURE | LF_CAPTURED | LF_EXPOSED
            if not copy_local_live(r live) and (copy_blocked.length =? 0 or not copy_blocked.has(r)) and CopyWord(locals.ptr[r].flags) & skip =? 0 {copy_moves[n]=true}
            live[r]=true
            return
        }
        if not copy_local_live(l live) and (copy_blocked.length =? 0 or not copy_blocked.has(l)) {
            let skip=LF_PARAM | LF_MUTPARAM | LF_ALIAS | LF_BYREF | LF_CAPTURE | LF_CAPTURED | LF_EXPOSED
            if copy_inputs.length >? 0 and copy_inputs.has(l) {skip &= ~LF_PARAM}
            if spawn_owned_capture(CopyWord(locals.ptr[l].owner) l) {skip &= ~LF_CAPTURE}
            if tb_generators_seen and fns.ptr[CopyWord(locals.ptr[l].owner)].kind =? FK_GENERATOR and not is_shared(l) {skip &= ~LF_CAPTURE}
            if (ownership_type(CopyWord(locals.ptr[l].type)) or (tb_generators_seen and gen_type_contains(CopyWord(locals.ptr[l].type)))) and not is_shared(l) and CopyWord(locals.ptr[l].flags) & LF_ADDR =? 0 {skip &= ~LF_CAPTURED}
            if CopyWord(locals.ptr[l].flags) & skip =? 0 {
                copy_moves[n]=true
            }
        }
        live[l]=true
        return
    }
    if k =? 'assign' and node_op(nodes.ptr[n].op_ext) =? int32(47) and nodes.ptr[n].aux =? 0 {
        let target=CopyWord(nodes.ptr[n].a)
        if nodes.ptr[target].kind =? 'ident' and nodes.ptr[target].aux =? int32(1) {
            # Replacement kills the old value; evaluate its RHS against the
            # incoming state so self-assignment still captures before dropping.
            copy_kill_local(CopyWord(nodes.ptr[target].sym) @live)
            copy_live(CopyWord(nodes.ptr[n].b) @live)
            return
        }
    }
    if k =? 'vardecl' {
        copy_kill_local(CopyWord(nodes.ptr[n].sym) @live)
        copy_live(CopyWord(nodes.ptr[n].b) @live)
        return
    }
    # Every local a loop mentions is live at its backedge; one declared in it
    # starts fresh each iteration, so its last use can still transfer it.
    if k =? 'while_' or k =? 'for_' {
        copy_loop_after.push(live)
        copy_mentions(n @live)
        let inner=live
        copy_loop_locals(n @inner)
        if copy_hidden {loop h in copy_owner_hidden {copy_kill_local(h @inner)}}
        copy_loop_back.push(inner)
        let mask0=CopyWord(iso_child_p[int64(((nodes.ptr + n) as ptr<uint32>)[0])])
        if mask0 >? 0 {
            if mask0 & 16 not=? 0 {
                let lbase=CopyWord(nodes.ptr[n].list)
                let i=CopyWord(nodes.ptr[n].nlist) - 1
                loop i >=? 0 {
                    copy_live(CopyWord(lists.ptr[lbase + i]) @inner)
                    i -= 1
                }
            }
            if mask0 & 4 not=? 0 and nodes.ptr[n].c not=? 0 {copy_live(CopyWord(nodes.ptr[n].c) @inner)}
            if mask0 & 2 not=? 0 and nodes.ptr[n].b not=? 0 {copy_live(CopyWord(nodes.ptr[n].b) @inner)}
            if mask0 & 1 not=? 0 and nodes.ptr[n].a not=? 0 {copy_live(CopyWord(nodes.ptr[n].a) @inner)}
        }
        copy_loop_after.pop();
        copy_loop_back.pop();
        return
    }
    if k =? 'defer_' {
        copy_mentions(n @live)
        return
    }
    if k =? 'if_' {
        let left=live
        copy_live(CopyWord(nodes.ptr[n].b) @left)
        if nodes.ptr[n].c not=? 0 {
            let right=live
            copy_live(CopyWord(nodes.ptr[n].c) @right)
            loop [l unused] in right {live[l]=true}
        }
        loop [l unused] in left {live[l]=true}
        copy_live(CopyWord(nodes.ptr[n].a) @live)
        return
    }
    if k =? 'call' {
        # Earlier arguments can borrow a root through the whole call, even
        # though their evaluation precedes its lexical last read. Transferring
        # that root to a consuming parameter would invalidate those borrows.
        let nk=CopyWord(nodes.ptr[n].nlist)
        if nk >? 1 {
            let need=locals.length
            if copy_call_seen_gen.length <? need {
                let sz=need + 64
                copy_call_seen_gen.resize(sz)
                copy_call_here_gen.resize(sz)
            }
            if int64(copy_call_gen) + nk + 2 >=? 2147483647 or copy_call_gen <? int32(0) {
                mem_set(copy_call_seen_gen.ptr as ptr<uint8> 0 copy_call_seen_gen.length * 4)
                mem_set(copy_call_here_gen.ptr as ptr<uint8> 0 copy_call_here_gen.length * 4)
                copy_call_gen=int32(0)
            }
            copy_call_gen=int32<overflow='wrap'>(int64(copy_call_gen) + 1)
            let g_seen=copy_call_gen
            let seen_p=copy_call_seen_gen.ptr
            let here_p=copy_call_here_gen.ptr
            let lbase=CopyWord(nodes.ptr[n].list)
            loop i in [CopyWord(0)..nk) {
                let arg=CopyWord(lists.ptr[lbase + i])
                if nodes.ptr[arg].kind =? 'conv' and nodes.ptr[arg].aux =? int32(int64(CV.explicit_copy)) {continue}
                copy_call_gen=int32<overflow='wrap'>(int64(copy_call_gen) + 1)
                copy_mentions_call(arg g_seen copy_call_gen seen_p here_p @live)
            }
        }
        # (named arguments and a record's fields, evaluated in written order, not their
        # slots': `[w=w held=held]` makes held's field first; backward in that order)
        if nodes.ptr[n].c not=? 0 {
            let order=call_eval_order(n)
            let i=order.length - 1
            loop i >=? 0 {
                copy_live(kid(n order.ptr[i]) @live)
                i -= 1
            }
            copy_live(CopyWord(nodes.ptr[n].a) @live)
            return
        }
    }
    let mask1=CopyWord(iso_child_p[int64(((nodes.ptr + n) as ptr<uint32>)[0])])
    if mask1 <=? 0 {return}
    if mask1 & 16 not=? 0 {
        let lbase=CopyWord(nodes.ptr[n].list)
        let i=CopyWord(nodes.ptr[n].nlist) - 1
        loop i >=? 0 {
            copy_live(CopyWord(lists.ptr[lbase + i]) @live)
            i -= 1
        }
    }
    if mask1 & 4 not=? 0 and nodes.ptr[n].c not=? 0 {copy_live(CopyWord(nodes.ptr[n].c) @live)}
    if mask1 & 2 not=? 0 and nodes.ptr[n].b not=? 0 {copy_live(CopyWord(nodes.ptr[n].b) @live)}
    if mask1 & 1 not=? 0 and nodes.ptr[n].a not=? 0 {copy_live(CopyWord(nodes.ptr[n].a) @live)}
}
copies_prepare=(f:CopyWord):>void=>$unsafe {
    copy_track_on=false
    copy_has_owners=false
    copy_moves.clear()
    copy_capture_nodes.clear()
    copy_fields=[]
    copy_blocked.clear()
    copy_noenv.clear()
    copy_loop_after=[]
    copy_loop_back=[]
    if copy_parts {copy_part_roots.clear()}
    copy_parts=false
    if copy_hidden {copy_owner_hidden=[]}
    copy_hidden=false
    let has_gens=false
    if tb_generators_seen {
        let larr=fns.ptr[f].locals
        let lp=larr.ptr
        loop i in [0..larr.length) {
            if gen_type_contains(CopyWord(locals.ptr[lp[i]].type)) {has_gens=true; break}
        }
    }
    let owners=ownership_decls.length not=? 0 and ownership_functions.has(f)
    copy_proof_budget=if owners {4096} else {-1}
    if not copies_on {return}
    let body=CopyWord(fns.ptr[f].body)
    if body =? 0 or (not copy_strict(body) and not owners and not has_gens) {return}
    if copy_track_gen.length <? locals.length {copy_track_gen.resize(locals.length + 64)}
    if copy_track_cur >=? int32(2147483640) or copy_track_cur <? int32(0) {
        mem_set(copy_track_gen.ptr as ptr<uint8> 0 copy_track_gen.length * 4)
        copy_track_cur=int32(0)
    }
    copy_track_cur=int32<overflow='wrap'>(int64(copy_track_cur) + 1)
    let g=copy_track_cur
    let tgp=copy_track_gen.ptr
    let tracked:CopyWord=0
    let check_owners=ownership_decls.length not=? 0
    let flocs=fns.ptr[f].locals
    let floc_p=flocs.ptr
    loop i in [0..flocs.length) {
        let l=floc_p[i]
        let lt=CopyWord(locals.ptr[l].type)
        let is_own=check_owners and ownership_type(lt)
        if is_own {copy_has_owners=true}
        if is_own or costly_copy(lt) or (has_gens and gen_type_contains(lt)) {
            tgp[l]=g
            tracked += 1
        }
    }
    let fpars=fns.ptr[f].params
    let fpar_p=fpars.ptr
    loop i in [0..fpars.length) {
        let l=fpar_p[i]
        if tgp[l] =? g {continue}
        let lt=CopyWord(locals.ptr[l].type)
        let is_own=check_owners and ownership_type(lt)
        if is_own {copy_has_owners=true}
        if is_own or costly_copy(lt) or (has_gens and gen_type_contains(lt)) {
            tgp[l]=g
            tracked += 1
        }
    }
    let fcaps=fns.ptr[f].caps
    loop i in [0..fcaps.length) {
        let l=int64(fcaps.ptr[i].outer)
        if l >=? 0 and l <? copy_track_gen.length and tgp[l] not=? g {
            let lt=CopyWord(locals.ptr[l].type)
            let is_own=check_owners and ownership_type(lt)
            if is_own {copy_has_owners=true}
            if is_own or costly_copy(lt) or (has_gens and gen_type_contains(lt)) {
                tgp[l]=g
                tracked += 1
            }
        }
    }
    copy_track_on=true
    loop i in [0..flocs.length) {
        let l=floc_p[i]
        # (a match's own variable is declared by the match, fresh each iteration too)
        if owners and locals.ptr[l].name =? 0 and CopyWord(locals.ptr[l].flags) & LF_ADDR not=? 0 and ownership_type(CopyWord(locals.ptr[l].type)) {
            copy_owner_hidden.push(l)
            copy_hidden=true
        }
        if CopyWord(locals.ptr[l].flags) & LF_ALIAS not=? 0 and locals.ptr[l].alias not=? 0 {
            let al=CopyWord(locals.ptr[l].alias)
            let root:CopyWord=0
            # (narrowed to one alternative, or to several, as a catch-all's name)
            if owners {root=copy_part_root(al)}
            if root >? 0 {
                copy_part_roots[l]=root
                copy_parts=true
                tgp[l]=g
                tgp[root]=g
                tracked += 1
            }
            else if tracked >? 0 {copy_mentions(CopyWord(locals.ptr[l].alias) @copy_blocked)}
        }
    }
    if tracked =? 0 {
        copy_track_on=false
        return
    }
    copy_deferred(body)
    let live=dict<int64 bool>()
    copy_live(body @live)
    copy_track_on=false
    if copy_proof_budget =? 0 {copy_moves.clear()}
}
copy_deferred=(n:CopyWord):>void=>$unsafe {
    if n =? 0 {return}
    if nodes.ptr[n].kind =? 'defer_' or nodes.ptr[n].kind =? 'addr' {
        copy_mentions(n @copy_blocked)
        return
    }
    if nodes.ptr[n].kind =? 'vardecl' and not has_flag(n NF_GLOBAL) {
        let l=CopyWord(nodes.ptr[n].sym)
        let e=CopyWord(nodes.ptr[n].b)
        if nkids(n) =? 0 and e not=? 0 and CopyWord(locals.ptr[l].flags) & LF_ASSIGNED =? 0 {
            if nodes.ptr[e].kind =? 'fnref' and nodes.ptr[e].aux =? 0 {copy_noenv[l]=true}
            if nodes.ptr[e].kind =? 'lambda' and not has_flag(e NF_GENERIC) and fns.ptr[CopyWord(nodes.ptr[e].sym)].caps.length =? 0 {copy_noenv[l]=true}
            if nodes.ptr[e].kind =? 'ident' and nodes.ptr[e].aux =? int32(1) and copy_noenv.has(CopyWord(nodes.ptr[e].sym)) {copy_noenv[l]=true}
        }
    }
    let mask=CopyWord(iso_child_p[int64(((nodes.ptr + n) as ptr<uint32>)[0])])
    if mask <=? 0 {return}
    if mask & 1 not=? 0 {copy_deferred(CopyWord(nodes.ptr[n].a))}
    if mask & 2 not=? 0 {copy_deferred(CopyWord(nodes.ptr[n].b))}
    if mask & 4 not=? 0 {copy_deferred(CopyWord(nodes.ptr[n].c))}
    if mask & 16 not=? 0 {
        let list_start=CopyWord(nodes.ptr[n].list)
        let nk=CopyWord(nodes.ptr[n].nlist)
        loop i in [CopyWord(0)..nk) {copy_deferred(CopyWord(lists.ptr[list_start + i]))}
    }
}
# Transfer a dead local's ownership, clearing its old slot so ordinary cleanup
# remains correct on every exit. Other references created by an explicit copy
# retain their COW ownership and permission to detach.
copy_take=(e:CopyWord value:Val t:CopyWord):>Val=>$unsafe {
    let p=gen_place(e false)
    if vc(t) =? VC_AGG {
        if ownership_type(t) or (tb_generators_seen and fns.ptr[cur_fn].kind =? FK_GENERATOR and is_managed(t)) {copy_forget(e t)}
        let s=new_temp(t)
        let a=e_slot(s)
        # Implementation-library forwarding adopts an already initialized API
        # value. Re-running a semantic move here could change a dictionary key
        # after its hash was computed, or change the value returned by pop.
        if ownership_type(t) and not owner_adoptions.has(e) and not in_lib(nodes.ptr[e].pos) {
            e_call(lf_helper(HK.move t 0) [a value.v] (-1));
        }
        else {e_copy(a value.v tsize(t));}
        e_zero(place_addr(p t) tsize(t));
        if ownership_type(t) {owner_register(s t)}
        return Val(a true s)
    }
    let v=vreg(vt_of(t))
    e_mov(v value.v);
    write_place(p t zero_val(t))
    if ownership_type(t) {
        copy_forget(e t)
        return owner_value(V(v true) t)
    }
    if tb_generators_seen and fns.ptr[cur_fn].kind =? FK_GENERATOR and is_managed(t) {
        copy_forget(e t)
    }
    Val(v true (-1))
}
copy_forget=(e:CopyWord t:CopyWord):>void=>$unsafe {
    if nodes.ptr[e].kind =? 'ident' {
        let l=CopyWord(nodes.ptr[e].sym)
        if spawn_owned_capture(cur_fn l) {
            e_store(env_v CopyWord(locals.ptr[l].env_off) - 8 e_iconst(0) 8);
        }
        else if fns.ptr[cur_fn].kind =? FK_GENERATOR {
            let lt=store_type(l)
            let loff=CopyWord(locals.ptr[l].env_off) + (if is_shared(l) {ptr_size} else {max(tsize(lt) 1)})
            e_store(env_v loff e_iconst(0) 1);
        }
        else {owner_forget_slot(CopyWord(locals.ptr[l].offset))}
    }
    else {
        let key=copy_field(e)
        if key >=? 0 {ice("missing owner field path")}
        let p=copy_fields[-1 - key]
        owner_forget_field(CopyWord(locals.ptr[p[0]].offset) p[1])
    }
}
# The owning local whose active alternative this narrowing reads (`narrow` of a union,
# `unwrap` of an optional, written on the local itself), or 0.
copy_part_root=(e:CopyWord):>CopyWord=>$unsafe {
    let k=nodes.ptr[e].kind
    if k not=? 'narrow' and k not=? 'unwrap' and (k not=? 'conv' or nodes.ptr[e].aux not=? int32(int64(CV.union_))) {return 0}
    let a=CopyWord(nodes.ptr[e].a)
    if nodes.ptr[a].kind not=? 'ident' or nodes.ptr[a].aux not=? int32(1) or not ownership_type(ntype(a)) {return 0}
    # (a name narrowed from a narrowed name: the local underneath both)
    let r=copy_part_roots.get(CopyWord(nodes.ptr[a].sym)) ?? CopyWord(nodes.ptr[a].sym)
    if CopyWord(locals.ptr[r].flags) & LF_ALIAS not=? 0 {return 0}
    r
}
# Move a union's or optional's owning alternative out of its dead local: the local's
# cleanup record is unlinked on this path, so it no longer drops that alternative.
copy_take_part=(value:Val t:CopyWord root:CopyWord):>Val=>$unsafe {
    if spawn_owned_capture(cur_fn root) {e_store(env_v CopyWord(locals.ptr[root].env_off) - 8 e_iconst(0) 8);}
    else {owner_forget_slot(CopyWord(locals.ptr[root].offset))}
    if vc(t) =? VC_AGG {
        let s=new_temp(t)
        let a=e_slot(s)
        e_call(lf_helper(HK.move t 0) [a value.v] (-1));
        owner_register(s t)
        return Val(a true s)
    }
    let v=vreg(vt_of(t))
    e_mov(v value.v);
    owner_value(V(v true) t)
}
copy_movable=(e:CopyWord):>bool=>$unsafe {
    if nodes.ptr[e].kind =? 'field' and copy_moves.has(e) {return true}
    let n=e
    loop nodes.ptr[n].kind =? 'field' {
        if boxed_field_of(n) >=? 0 {return false}
        n=CopyWord(nodes.ptr[n].a)
    }
    if nodes.ptr[n].kind not=? 'ident' or not copy_moves.has(n) or copy_blocked.has(CopyWord(nodes.ptr[n].sym)) {return false}
    n =? e or vc(ntype(n)) =? VC_AGG
}
# Diagnostic-only walk after a failed transfer, O(nodes in the current body).
# It neither changes liveness nor claims that an unreachable use is executed.
copy_later_use=(n:CopyWord l:CopyWord after:CopyWord):>CopyWord=>$unsafe {
    if n =? 0 {return 0}
    if nodes.ptr[n].kind =? 'ident' and nodes.ptr[n].aux =? int32(1) and nodes.ptr[n].sym =? int32(l) and nodes.ptr[n].pos >? after {return nodes.ptr[n].pos}
    if nodes.ptr[n].kind =? 'lambda' or nodes.ptr[n].kind =? 'lazy_' {
        let f=CopyWord(nodes.ptr[n].sym)
        if nodes.ptr[n].kind =? 'lambda' and has_flag(n NF_GENERIC) {f=poly_families[CopyWord(nodes.ptr[n].aux)].envfn}
        loop cap in fns.ptr[f].caps {
            if int64(cap.outer) =? l and nodes.ptr[n].pos >? after {return nodes.ptr[n].pos}
        }
        return 0
    }
    let found:CopyWord=0
    let mask=CopyWord(iso_child_p[int64(((nodes.ptr + n) as ptr<uint32>)[0])])
    if mask <=? 0 {return 0}
    if mask & 1 not=? 0 and nodes[n].a not=? 0 {
        let at=copy_later_use(CopyWord(nodes[n].a) l after)
        if at >? 0 and (found =? 0 or at <? found) {found=at}
    }
    if mask & 2 not=? 0 and nodes[n].b not=? 0 {
        let at=copy_later_use(CopyWord(nodes[n].b) l after)
        if at >? 0 and (found =? 0 or at <? found) {found=at}
    }
    if mask & 4 not=? 0 and nodes[n].c not=? 0 {
        let at=copy_later_use(CopyWord(nodes[n].c) l after)
        if at >? 0 and (found =? 0 or at <? found) {found=at}
    }
    if mask & 16 not=? 0 {
        let list_start=CopyWord(nodes[n].list)
        let nk=CopyWord(nodes[n].nlist)
        loop i in [CopyWord(0)..nk) {
            let at=copy_later_use(CopyWord(lists[list_start + i]) l after)
            if at >? 0 and (found =? 0 or at <? found) {found=at}
        }
    }
    found
}
copy_own=(e:CopyWord value:Val t:CopyWord):>Val=>$unsafe {
    if tb_generators_seen and gen_type_contains(t) {
        if value.owned {return value}
        if (nodes.ptr[e].kind =? 'ident' or (nodes.ptr[e].kind =? 'field' and copy_moves.has(e))) and copy_movable(e) {return copy_take(e value t)}
        if nodes.ptr[e].kind =? 'ident' and nodes.ptr[e].aux =? int32(1) {
            let at=copy_later_use(CopyWord(fns.ptr[cur_fn].body) CopyWord(nodes.ptr[e].sym) nodes.ptr[e].pos)
            if at >? 0 {err_notes.push([at "note: later use of '{name_of(CopyWord(nodes.ptr[e].name))}' prevents this transfer"])}
        }
        fatal(nodes.ptr[e].pos "cannot copy a generator ({dt(t)}); generators are move-only and can only be moved at their last use")
    }
    if ownership_type(t) {
        if value.owned {return value}
        if copy_parts and nodes.ptr[e].kind =? 'ident' and nodes.ptr[e].aux =? int32(1) and copy_part_roots.has(CopyWord(nodes.ptr[e].sym)) {
            let root=copy_part_roots.get(CopyWord(nodes.ptr[e].sym)) ?? 0
            if copy_moves.has(e) {return copy_take_part(value t root)}
        }
        else if (nodes.ptr[e].kind =? 'ident' or (nodes.ptr[e].kind =? 'field' and copy_moves.has(e))) and copy_movable(e) {return copy_take(e value t)}
        let ek=nodes.ptr[e].kind
        if ek =? 'narrow' or ek =? 'unwrap' or ek =? 'conv' {
            let part=copy_part_root(e)
            if part >? 0 and copy_moves.has(CopyWord(nodes.ptr[e].a)) and not copy_blocked.has(part) {return copy_take_part(value t part)}
        }
        if owner_adoptions.has(e) {fatal(nodes.ptr[e].pos "a hook result requires fresh construction or a proven last-use local")}
        if ownership_copyable(t) {return own(value t)}
        if copy_proof_budget =? 0 {fatal(nodes.ptr[e].pos "move proof budget exhausted; cannot copy a move-only owner")}
        if nodes.ptr[e].kind =? 'ident' and nodes.ptr[e].aux =? int32(1) {
            let at=copy_later_use(CopyWord(fns.ptr[cur_fn].body) CopyWord(nodes.ptr[e].sym) nodes.ptr[e].pos)
            if at >? 0 {err_notes.push([at "note: later use of '{name_of(CopyWord(nodes.ptr[e].name))}' prevents this transfer"])}
        }
        fatal(nodes.ptr[e].pos "cannot copy a move-only owner: transfer requires a proven last use (later read, loop, alias or defer keeps it live)")
    }
    if value.owned or not copy_strict(e) or not costly_copy(t) {return own(value t)}
    # A literal may be placed in read-only data, then promoted on its first
    # write. That implementation choice is not a source-level duplication.
    if nodes.ptr[e].kind =? 'array' {return own(value t)}
    if nodes.ptr[e].kind =? 'ident' and nodes.ptr[e].aux =? int32(1) and copy_noenv.has(CopyWord(nodes.ptr[e].sym)) {return own(value t)}
    if copy_explicit.has(e) {return own(value t)}
    if type_eq(ntype(e) t) and copy_movable(e) {return copy_take(e value t)}
    copy_error(e copy_reason(t))
    value
}
copy_components=(e:CopyWord t:CopyWord why:string):>void=>{
    if copies_on and copy_strict(e) and costly_copy(t) and not copy_explicit.has(e) {
        copy_error(e why)
    }
}
# Additional duplications whose source has already been evaluated: argument
# snapshots, captures, optional payloads and operands kept across effects.
own_at=(e:CopyWord value:Val t:CopyWord):>Val=>{
    if copies_on {return copy_own(e value t)}
    own(value t)
}
# Keeping two read-only values shares immutable storage. This does not grant
# permission to mutate a live snapshot later. Address exposure and captures
# prevent the proof; a parameter may be borrowed only for this call's lifetime.
copy_readonly=(l:CopyWord):>bool=>$unsafe {
    CopyWord(locals.ptr[l].flags) & (LF_ASSIGNED | LF_CAPTURE | LF_CAPTURED | LF_EXPOSED | LF_ALIAS | LF_BYREF | LF_MUTPARAM | LF_ADDR) =? 0
}
copy_shared_decl=(s:CopyWord l:CopyWord):>bool=>$unsafe {
    if not copy_strict(s) or not copy_readonly(l) {return false}
    let e=CopyWord(nodes.ptr[s].b)
    if e =? 0 or not costly_copy(ntype(e)) or type_has_fn(ntype(e)) {return false}
    let root=place_root(e)
    if root =? 0 or nodes.ptr[root].kind not=? 'ident' {return false}
    if nodes.ptr[root].aux =? int32(1) {
        if not copy_readonly(CopyWord(nodes.ptr[root].sym)) {return false}
    }
    else if nodes.ptr[root].aux =? int32(2) {
        if not readonly_global(CopyWord(nodes.ptr[root].sym)) {return false}
    }
    else {return false}
    if copy_movable(e) {return false}
    if copy_escapes(CopyWord(fns.ptr[cur_fn].body) l) {return false}
    let value=own(gen_expr(e) ntype(e))
    # This immutable reader keeps the source live. A subsequent transfer into
    # a mutable owner cannot use the source's lexical last read as uniqueness.
    if nodes.ptr[root].aux =? int32(1) and CopyWord(locals.ptr[l].flags) & LF_READ not=? 0 {
        copy_blocked[CopyWord(nodes.ptr[root].sym)]=true
    }
    write_place(local_place(l true) CopyWord(locals.ptr[l].type) value.v)
    scope_add_local(l)
    true
}
copy_shared_global=(s:CopyWord g:CopyWord):>bool=>$unsafe {
    if not copy_strict(s) or not readonly_global(g) {return false}
    let e=CopyWord(nodes.ptr[s].b)
    if e =? 0 or type_has_fn(ntype(e)) {return false}
    let root=place_root(e)
    if root =? 0 or nodes.ptr[root].aux not=? int32(2) or not readonly_global(CopyWord(nodes.ptr[root].sym)) {return false}
    let value=own(gen_expr(e) ntype(e))
    store_val(CopyWord(globals.ptr[g].type) e_gaddr(global_addr_off(g)) 0 value.v)
    true
}
# Locals freshly constructed within a loop do not cross its backedge.
copy_loop_locals=(n:CopyWord @live:dict<int64 bool>):>void=>$unsafe {
    if n =? 0 {return}
    # (a match's own variable is declared by the match, fresh each iteration too)
    if nodes.ptr[n].kind =? 'vardecl' {copy_kill_local(CopyWord(nodes.ptr[n].sym) @live)}
    let mask=CopyWord(iso_child_p[int64(((nodes.ptr + n) as ptr<uint32>)[0])])
    if mask <=? 0 {return}
    if mask & 1 not=? 0 and nodes.ptr[n].a not=? 0 {copy_loop_locals(CopyWord(nodes.ptr[n].a) @live)}
    if mask & 2 not=? 0 and nodes.ptr[n].b not=? 0 {copy_loop_locals(CopyWord(nodes.ptr[n].b) @live)}
    if mask & 4 not=? 0 and nodes.ptr[n].c not=? 0 {copy_loop_locals(CopyWord(nodes.ptr[n].c) @live)}
    if mask & 16 not=? 0 {
        let list_start=CopyWord(nodes.ptr[n].list)
        let nk=CopyWord(nodes.ptr[n].nlist)
        loop i in [CopyWord(0)..nk) {copy_loop_locals(CopyWord(lists.ptr[list_start + i]) @live)}
    }
}
copy_capture_ids=(n:CopyWord):>array<int64>=>$unsafe {
    let ids=copy_capture_nodes.get(n)
    if ids not=? none {return ids}
    let f=CopyWord(nodes.ptr[n].sym)
    if nodes.ptr[n].kind =? 'lambda' and has_flag(n NF_GENERIC) {f=poly_families[CopyWord(nodes.ptr[n].aux)].envfn}
    let ids:array<int64>=[]
    loop cap in fns.ptr[f].caps {ids.push(mk_ident_local(int64(cap.outer) nodes.ptr[n].pos))}
    copy_capture_nodes[n]=ids
    ids
}

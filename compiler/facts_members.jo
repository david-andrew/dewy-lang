fact_member_literal = (n: int) -> bool: fact_member_template >= 0 and member_templates[fact_member_template].positions.has(nodes[n].pos)
fact_member_candidate = (f: int) -> bool:
    if member_templates.len() == 0 or fact_policy != .RequireStatic or fact_probe_on or fact_query or wit_tentative or proof_active or result_active or ide_on: return false
    if ownership_decls.len() != 0 or exact_owners.has(f) or fact_summary_owner != 0: return false
    loop i in [0..member_templates.len()):
        if member_templates[i].owner == f and member_templates[i].okay: return true
    false
# x and y are the same checked syntax but for member literals and local
# copies. Pairs of the nodes a decision can mark (dir_index, fact_validated)
# go onto pairs. O(nodes), field reads only.
fms_index = 0
fms_pairs: int[]
fms_has_exact = false
fms_has_rat = false
fms_has_pos = false
fms_nodes: *Node = null
fms_lists: *i32 = null
fms_locals: *Local = null
fms_exact: *u8 = null
fms_nexact = 0

fact_member_same = (x: int, y: int, index: int, pairs: mut int[]) -> bool:
    fms_index = index
    fms_pairs = pairs
    pairs = []
    fms_has_exact = exact_marks.len() > 0
    fms_has_rat = rational_constants.len() != 0
    fms_has_pos = member_templates[index].positions.len() > 0
    fms_nodes = data(nodes)
    fms_lists = data(lists)
    fms_locals = data(locals)
    fms_nexact = exact_marks.len()
    if fms_has_exact: fms_exact = data(exact_marks)
    ok = fact_member_same_fast(x, y)
    pairs = fms_pairs
    fms_pairs = []
    ok

fms_sx: int[]
fms_sy: int[]

fact_member_same_fast = (x0: int, y0: int) -> bool:
    if fms_sx.len() < 256:
        fms_sx.resize(256)
        fms_sy.resize(256)
    sx = data(fms_sx)
    sy = data(fms_sy)
    scap = fms_sx.len()
    sp = 1
    sx[0] = x0
    sy[0] = y0
    np = fms_nodes
    lp = fms_lists
    lp0 = fms_locals
    has_exact = fms_has_exact
    nexact = fms_nexact
    exactp = fms_exact
    has_rat = fms_has_rat
    has_pos = fms_has_pos
    loop sp > 0:
        sp -= 1
        x = sx[sp]
        y = sy[sp]
        if x == 0 or y == 0:
            if x != y: return false
            continue
        nx = np + x
        ny = np + y
        k = nx.kind
        if k != ny.kind or nx.pos != ny.pos or nx.type != ny.type or nx.flags != ny.flags: return false
        if has_exact and ((x < nexact and exactp[x] != 0) or (y < nexact and exactp[y] != 0)): return false
        if has_rat and (rational_constants.has(x) or rational_constants.has(y)): return false
        if k == .ident:
            if nx.name != ny.name or nx.aux != ny.aux or nx.aux2 != ny.aux2 or nx.op != ny.op or nx.ival != ny.ival or nx.sval != ny.sval or nx.d != ny.d or nx.nlist != ny.nlist or nx.nlist2 != 0 or ny.nlist2 != 0: return false
            if nx.sym != ny.sym:
                if nx.aux != i32(int(SK.local)) or nx.sym <= 0 or ny.sym <= 0: return false
                lx = int(nx.sym)
                ly = int(ny.sym)
                if lp0[lx].type != lp0[ly].type or lp0[lx].flags != lp0[ly].flags: return false
            continue
        if k == .int_lit:
            if nx.ival != ny.ival or nx.aux != ny.aux or nx.aux2 != ny.aux2 or nx.sym != ny.sym or nx.op != ny.op or nx.name != ny.name or nx.sval != ny.sval or nx.d != ny.d or nx.nlist != ny.nlist or nx.nlist2 != 0 or ny.nlist2 != 0: return false
            continue
        if nx.op != ny.op or nx.ival != ny.ival or nx.name != ny.name or nx.aux2 != ny.aux2 or nx.d != ny.d or nx.nlist != ny.nlist or nx.nlist2 != 0 or ny.nlist2 != 0: return false
        if has_pos and (k == .str_lit or k == .dotname) and member_templates[fms_index].positions.has(nx.pos):
            if k == .dotname and tkind(ntype(x)) == .enum_ or k == .str_lit and (nx.aux != 0 or nx.nlist != 0): return false
        else if nx.sval != ny.sval or nx.aux != ny.aux: return false
        if nx.sym != ny.sym:
            if k != .vardecl or nx.sym <= 0 or ny.sym <= 0: return false
            lx = int(nx.sym)
            ly = int(ny.sym)
            if lp0[lx].type != lp0[ly].type or lp0[lx].flags != lp0[ly].flags: return false
        match k:
            float_lit, bool_lit, none_lit, null_lit, dotname, hole, break_, continue_, pwild, lambda: continue
            else: pass
        if k == .index or k == .intrinsic or k == .conv:
            if k == .conv and ff_integer_demand(x): return false
            fms_pairs.push(x)
            fms_pairs.push(y)
        mask = int(iso_child_p[int(k)])
        if mask < 0: return false
        nlist = if mask & 16 != 0: int(nx.nlist) else: 0
        if sp + nlist + 3 > scap:
            scap = (sp + nlist + 3) * 2
            fms_sx.resize(scap)
            fms_sy.resize(scap)
            sx = data(fms_sx)
            sy = data(fms_sy)
        if nlist > 0:
            lx = int(nx.list)
            ly = int(ny.list)
            i = nlist - 1
            loop i >= 0:
                chx = int(lp[lx + i])
                chy = int(lp[ly + i])
                if (chx | chy) != 0:
                    sx[sp] = chx; sy[sp] = chy; sp += 1
                i -= 1
        if mask & 4 != 0:
            chx = int(nx.c); chy = int(ny.c)
            if (chx | chy) != 0: sx[sp] = chx; sy[sp] = chy; sp += 1
        if mask & 2 != 0:
            bx = int(nx.b); by = int(ny.b)
            if (bx | by) != 0: sx[sp] = bx; sy[sp] = by; sp += 1
        if mask & 1 != 0:
            ax = int(nx.a); ay = int(ny.a)
            if (ax | ay) != 0: sx[sp] = ax; sy[sp] = ay; sp += 1
    true
# (the plan's admission of block b: member_lower_block's, every copy the same)
fact_member_admit = (b: int) -> bool:
    index = member_scopes.get(kid(b, 0)) ?? -1
    if index < 0 or not member_templates[index].okay or nkids(b) != member_templates[index].texts.len(): return false
    if member_templates[index].requests.len() != 0 or member_templates[index].refinements.len() != 0: return false
    template = kid(b, 0)
    pairs: int[]
    if member_templates[index].compact and member_templates[index].block == b:
        fact_member_admitted[b] = member_templates[index].view_proofs
        return true
    loop i in [0..nkids(b)):
        scope = kid(b, i)
        if (member_scopes.get(scope) ?? -1) != index or not member_scope_locals.has(scope): return false
        if i > 0 and not fact_member_same(template, scope, index, pairs): return false
    fact_member_admitted[b] = pairs
    true
fact_member_block = (b: int, s: mut FactState) -> bool:
    if not fact_member_admitted.has(b) or fact_owner != fact_member_owner or fact_summary_owner != 0 or fact_probe_on or fact_member_template >= 0: return false
    template = kid(b, 0)
    fact_changes(template, s, b)
    fact_member_template = member_scopes[template]
    fact_capture(template, s)
    fact_member_template = -1
    # (the template's decisions, at the same nodes of every other copy)
    if fact_speculating == 0:
        pairs = fact_member_admitted[b]
        loop i in [0..pairs.len() / 2):
            x = pairs[2 * i]
            y = pairs[2 * i + 1]
            if let proven = dir_proven.get(x): dir_index(y, proven)
            if fact_validated.has(x): fact_validated[y] = true
    true
# f decided with shared member blocks; false: no decision kept, decide it again.
fact_member_decide = (f: int) -> bool:
    proven = dir_proven
    validated = fact_validated
    notes = err_notes
    member_fact_view(f, true)
    fact_member_shared = true
    fact_member_owner = f
    fact_member_failed = false
    fact_member_admitted = {}
    wit_tentative = true
    wit_tentative_failed = false
    state = FactState()
    if refine_active or refine_requests.len() > 0: refine_fact_entry(f, state)
    if fact_fork_entries.len() > 0 or fact_parallel_bounds.len() > 0: fact_fork_seed(f, state)
    fact_slice_prepare(f)
    if member_fact_ready(f): fact_capture(int(fns[f].body), state)
    else: fact_member_failed = true
    failed = fact_member_failed or wit_tentative_failed
    if member_trace and fact_member_admitted.len() != 0:
        verdict = "shared"
        if failed: verdict = "decided again"
        eprint("member facts {pos_str(nodes[int(fns[f].body)].pos)}: {fact_member_admitted.len()} blocks, {verdict}")
    wit_tentative = false
    wit_tentative_failed = false
    fact_member_shared = false
    fact_member_owner = 0
    member_fact_view(f, false, not failed)
    if not failed:
        loop b, _ in fact_member_admitted: member_uniform_blocks[b] = true
        fact_member_admitted = {}
        return true
    fact_member_admitted = {}
    dir_proven = proven
    fact_validated = validated
    err_notes = notes
    fact_terms = [FactTerm()]
    fact_constructor_actuals = {}
    false

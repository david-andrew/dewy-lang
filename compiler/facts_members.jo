fact_member_literal = (n: int) -> bool: fact_member_template >= 0 and member_templates[fact_member_template].positions.has(nodes[n].pos)
fact_member_candidate = (f: int) -> bool:
    if member_templates.len() == 0 or fact_policy != .RequireStatic or fact_probe_on or fact_query or wit_tentative or proof_active or result_active or ide_on: return false
    if ownership_decls.len() != 0 or exact_owners.has(f) or fact_summary_owner != 0: return false
    loop i in [0..member_templates.len()):
        if member_templates[i].owner == f and member_templates[i].okay: return true
    false
# x and y are the same checked syntax but for member literals and local
# copies. Pairs of the nodes a decision can mark (dir_index, fact_validated)
# go onto pairs. O(nodes), field reads only.
fact_member_same = (x: int, y: int, index: int, pairs: mut int[]) -> bool:
    if x == 0 or y == 0: return x == y
    k = nodes[x].kind
    if k != nodes[y].kind or nodes[x].pos != nodes[y].pos or nodes[x].type != nodes[y].type or nodes[x].flags != nodes[y].flags or nodes[x].op != nodes[y].op: return false
    if nodes[x].ival != nodes[y].ival or nodes[x].name != nodes[y].name or nodes[x].aux2 != nodes[y].aux2 or nodes[x].d != nodes[y].d or nodes[x].nlist != nodes[y].nlist or nodes[x].nlist2 != 0 or nodes[y].nlist2 != 0: return false
    if x < exact_marks.len() and exact_marks[x] != 0 or y < exact_marks.len() and exact_marks[y] != 0: return false
    if rational_constants.len() != 0 and (rational_constants.has(x) or rational_constants.has(y)): return false
    if (k == .str_lit or k == .dotname) and member_templates[index].positions.has(nodes[x].pos):
        if k == .dotname and tkind(ntype(x)) == .enum_ or k == .str_lit and (nodes[x].aux != 0 or nodes[x].nlist != 0): return false
    else if nodes[x].sval != nodes[y].sval or nodes[x].aux != nodes[y].aux: return false
    if nodes[x].sym != nodes[y].sym:
        if not (k == .vardecl or k == .ident and nodes[x].aux == i32(int(SK.local))) or nodes[x].sym <= 0 or nodes[y].sym <= 0: return false
        lx = int(nodes[x].sym)
        ly = int(nodes[y].sym)
        if locals[lx].type != locals[ly].type or locals[lx].flags != locals[ly].flags: return false
    if k == .index or k == .intrinsic or k == .conv:
        if k == .conv and ff_integer_demand(x): return false
        pairs.push(x)
        pairs.push(y)
    mask = isolation_children(k)
    if mask < 0: return false
    if mask & 1 != 0 and not fact_member_same(int(nodes[x].a), int(nodes[y].a), index, pairs): return false
    if mask & 2 != 0 and not fact_member_same(int(nodes[x].b), int(nodes[y].b), index, pairs): return false
    if mask & 4 != 0 and not fact_member_same(int(nodes[x].c), int(nodes[y].c), index, pairs): return false
    if mask & 16 != 0:
        loop i in [0..nkids(x)):
            if not fact_member_same(kid(x, i), kid(y, i), index, pairs): return false
    true
# (the plan's admission of block b: member_lower_block's, every copy the same)
fact_member_admit = (b: int) -> bool:
    index = member_scopes.get(kid(b, 0)) ?? -1
    if index < 0 or not member_templates[index].okay or nkids(b) != member_templates[index].texts.len(): return false
    if member_templates[index].requests.len() != 0 or member_templates[index].refinements.len() != 0: return false
    template = kid(b, 0)
    pairs: int[]
    loop i in [0..nkids(b)):
        scope = kid(b, i)
        if (member_scopes.get(scope) ?? -1) != index or not member_scope_locals.has(scope): return false
        if i > 0 and not fact_member_same(template, scope, index, pairs): return false
    fact_member_admitted[b] = pairs
    true
fact_member_block = (b: int, s: mut FactState) -> bool:
    if not fact_member_admitted.has(b) or fact_owner != fact_member_owner or fact_summary_owner != 0 or fact_probe_on or fact_member_template >= 0: return false
    template = kid(b, 0)
    fact_changes(template, s, b)
    fact_member_template = member_scopes[template]
    fact_capture(template, s)
    fact_member_template = -1
    # (the template's decisions, at the same nodes of every other copy)
    if fact_speculating == 0:
        pairs = fact_member_admitted[b]
        loop i in [0..pairs.len() / 2):
            x = pairs[2 * i]
            y = pairs[2 * i + 1]
            if let proven = dir_proven.get(x): dir_index(y, proven)
            if fact_validated.has(x): fact_validated[y] = true
    true
# f decided with shared member blocks; false: no decision kept, decide it again.
fact_member_decide = (f: int) -> bool:
    proven = dir_proven
    validated = fact_validated
    notes = err_notes
    fact_member_shared = true
    fact_member_owner = f
    fact_member_failed = false
    fact_member_admitted = {}
    wit_tentative = true
    wit_tentative_failed = false
    state = FactState()
    if refine_active or refine_requests.len() > 0: refine_fact_entry(f, state)
    if fact_fork_entries.len() > 0 or fact_parallel_bounds.len() > 0: fact_fork_seed(f, state)
    fact_slice_prepare(f)
    fact_capture(int(fns[f].body), state)
    failed = fact_member_failed or wit_tentative_failed
    if member_trace and fact_member_admitted.len() != 0:
        verdict = "shared"
        if failed: verdict = "decided again"
        eprint("member facts {pos_str(nodes[int(fns[f].body)].pos)}: {fact_member_admitted.len()} blocks, {verdict}")
    wit_tentative = false
    wit_tentative_failed = false
    fact_member_shared = false
    fact_member_owner = 0
    fact_member_admitted = {}
    if not failed: return true
    dir_proven = proven
    fact_validated = validated
    err_notes = notes
    fact_terms = [FactTerm()]
    fact_constructor_actuals = {}
    false

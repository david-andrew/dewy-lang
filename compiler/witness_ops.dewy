WitWord:type=int64<overflow='wrap'>
# (each use as an edge: used, then its user)
wit_skip_uses=(n:WitWord f:WitWord @edges:array<int64>):>void=>$unsafe {
    if n =? 0 {return}
    let k=nodes.ptr[n].kind
    let g:WitWord=0
    if k =? 'call' and nodes.ptr[n].aux =? 0 or k =? 'fnref' and nodes.ptr[n].aux =? 0 {g=WitWord(nodes.ptr[n].sym)}
    else if k =? 'partial' {g=WitWord(nodes.ptr[n].d)}
    else if k =? 'lambda' {
        g=WitWord(nodes.ptr[n].sym)
        # (the closure starts from its creator's facts)
        if g >? 0 and g <? fns.length {
            edges.push(f)
            edges.push(g)
        }
    }
    if g >? 0 and g <? fns.length {
        edges.push(g)
        edges.push(f)
    }
    let mask=isolation_children(k)
    if mask <=? 0 {return}
    if mask & 1 not=? 0 {wit_skip_uses(WitWord(nodes.ptr[n].a) f @edges)}
    if mask & 2 not=? 0 {wit_skip_uses(WitWord(nodes.ptr[n].b) f @edges)}
    if mask & 4 not=? 0 {wit_skip_uses(WitWord(nodes.ptr[n].c) f @edges)}
    if mask & 16 not=? 0 {
        loop child in kids(n) {wit_skip_uses(child f @edges)}
    }
}
wit_skip_close=():>void=>$unsafe {
    wit_skip_users=dict<int64 bool>()
    wit_skipped=dict<int64 bool>()
    if not errors_only or ide_skip.length =? 0 {return}
    let edges:array<int64>=[]
    let work:array<int64>=[]
    loop f in [1..fns.length) {
        let d=WitWord(fns.ptr[f].decl)
        if d not=? 0 and ide_skip.has(nodes.ptr[d].pos) {
            wit_skipped[f]=true
            work.push(f)
        }
        else if fns.ptr[f].body not=? 0 and fns.ptr[f].state =? 2 {wit_skip_uses(WitWord(fns.ptr[f].body) f @edges)}
    }
    # (an unchecked body is opaque to the passes after checking, as a foreign function's)
    loop [f _] in wit_skipped {fns.ptr[f].body=0}
    # (each function's users, contiguous: start[g] up to start[g + 1])
    let start=fill(0 fns.length + 1)
    let i:WitWord=0
    loop i <? edges.length {
        start[edges[i] + 1] += 1
        i += 2
    }
    loop g in [1..fns.length + 1) {start[g] += start[g - 1]}
    let at=start
    let users=fill(0 edges.length // 2)
    i=0
    loop i <? edges.length {
        users[at[edges[i]]]=edges[i + 1]
        at[edges[i]] += 1
        i += 2
    }
    loop work.length >? 0 {
        let g=work.pop()
        loop j in [start[g]..start[g + 1]) {
            let f=users[j]
            if wit_skip_users.has(f) {continue}
            wit_skip_users[f]=true
            work.push(f)
        }
    }
}
wit_fail=(p:WitWord msg:string):>void=>{
    if wit_tentative {
        wit_tentative_failed=true
        return
    }
    if err_held_on and not wit_collect {
        # (a function's first unproven obligation only: later ones may follow from it)
        let owner=if fact_owner >? 0 {fact_owner} else {fact_retry_owner}
        if owner >? 0 and (wit_failed_owners.has(owner) or wit_skip_users.has(owner)) {
            err_notes=[]
            return
        }
        if owner >? 0 {wit_failed_owners[owner]=true}
        err_hold(p msg)
        return
    }
    if not wit_collect {fatal(p msg)}
    err_notes=[]
    eprint("{pos_str(p)}: error: {msg}")
    wit_collected += 1
}
# One note per span: a cause already shown at an event is not repeated.
wit_note=(at:WitWord text:string):>void=>{
    let line="note: {text}"
    loop e in err_notes {
        if at >? 0 and e[0] =? at or e[1] =? line {return}
    }
    err_notes.push([at line])
}
# Repairs are current evidence or an explicit runtime check, never `$assert`.
# Inside an erased proof, evidence comes only from its preconditions, guards
# and other proofs.
wit_help=(relation:string runtime:bool=true contract:WitWord=0 before:string=""):>void=>$unsafe {
    let after=wit_after
    wit_after=0
    let want=if relation not=? "" {"`{relation}`"} else if contract >? 0 {"the declared contract"} else {"what the operation needs"}
    if before not=? "" and relation not=? "" {want="{want} before `{before}`"}
    let noted=false
    if after >? 0 and relation not=? "" and relation =? wit_after_relation {
        loop e in err_notes {
            if e[0] =? wit_after_note {noted=true}
        }
    }
    let call=if noted {wit_call_text(after 0)} else {""}
    if proof_active and fact_owner >? 0 and fact_owner <? fns.length and proof_decls.has(WitWord(fns.ptr[fact_owner].decl)) {
        err_notes.push([(-1) "help: establish {want} with a stronger proof precondition, a call to another proof or a current guard; erased proofs cannot check at run time"])
    }
    else if runtime and call not=? "" {err_notes.push([(-1) "help: establish {want} after `{call}` with a current guard, or check it at run time with `$runtime_assert`"])}
    else if runtime {err_notes.push([(-1) "help: establish {want} with a current guard or a stronger checked contract, or check it at run time with `$runtime_assert`"])}
    else {err_notes.push([(-1) "help: establish {want} with a current guard or a stronger checked contract; erased proofs have no runtime fallback"])}
}
wit_op=(op:Tok):>string=>{
    if op =? 'lt' {return "<?"}
    if op =? 'le' {return "<=?"}
    if op =? 'gt' {return ">?"}
    if op =? 'ge' {return ">=?"}
    if op =? 'eq' {return "=?"}
    "not=?"
}
# A read the loop lowering made: an index whose base or position is hidden.
wit_hidden_read=(n:WitWord):>bool=>$unsafe {
    loop side in [WitWord(nodes.ptr[n].a) WitWord(nodes.ptr[n].b)] {
        let e=side
        loop e >? 0 and (nodes.ptr[e].kind =? 'narrow' or nodes.ptr[e].kind =? 'conv') {e=WitWord(nodes.ptr[e].a)}
        if e >? 0 and nodes.ptr[e].kind =? 'ident' and nodes.ptr[e].name not=? 0 and wit_hidden_name(name_of(WitWord(nodes.ptr[e].name))) {return true}
    }
    false
}
# A conversion that keeps the value, spelled as its operand.
wit_same_value=(n:WitWord):>bool=>$unsafe {
    let cv=nodes.ptr[n].aux
    cv =? int32(int64(CV.int_)) or cv =? int32(int64(CV.none_)) or cv =? int32(int64(CV.fixed_store)) or cv =? int32(int64(CV.promote)) or cv =? int32(int64(CV.big2math)) or cv =? int32(int64(CV.math2big))
}
# An operand's spelling inside a tighter operator: a sum or a difference in
# parentheses, as `(lo + hi) // 2` and `a - (b - c)` need.
wit_operand=(e0:WitWord depth:WitWord):>string=>$unsafe {
    let text=wit_text(e0 depth)
    let e=e0
    loop e >? 0 and (nodes.ptr[e].kind =? 'narrow' or nodes.ptr[e].kind =? 'conv') {e=WitWord(nodes.ptr[e].a)}
    if text not=? "" and e >? 0 and nodes.ptr[e].kind =? 'binary' and (nodes.ptr[e].op =? int32(58) or nodes.ptr[e].op =? int32(59)) {return "({text})"}
    text
}
# Call c's argument i, the place itself for a mutable one (`@x`).
wit_lent=(c:WitWord i:WitWord):>WitWord=>$unsafe {
    let e=kid(c i)
    loop e >? 0 and nodes.ptr[e].kind =? 'addr' {e=WitWord(nodes.ptr[e].a)}
    e
}
# A plain string literal as written, `"x"`; "" for one with escapes or interpolation.
wit_quoted=(e:WitWord):>string=>$unsafe {
    if nkids(e) not=? 0 or nodes.ptr[e].aux not=? 0 or nodes.ptr[e].sval <? 0 {return ""}
    wit_quote_text(name_of(WitWord(nodes.ptr[e].sval)))
}
# A direct call, `f(x 1)` (a method call's receiver is its first argument):
# the callee's shown name and each argument's spelling, `...` for one that has
# none. An operator's or a library helper's internal name (`[]`, `_truncate`)
# is not what the user wrote: "" for it.
wit_call_text=(e:WitWord depth:WitWord):>string=>$unsafe {
    let f=WitWord(nodes.ptr[e].sym)
    if nodes.ptr[e].aux not=? 0 or f <=? 0 or fns.ptr[f].decl =? 0 {return ""}
    let d=WitWord(fns.ptr[f].decl)
    let name=shown_fn_name(name_of(WitWord(nodes.ptr[d].name)))
    if name =? "" or starts_with(name "__") or starts_with(name "_") and pos_in_lib(nodes.ptr[d].pos) {return ""}
    let c=(name as array<uint8>)[0]
    if not (c >=? b'a' and c <=? b'z' or c >=? b'A' and c <=? b'Z' or c =? b'_') {return ""}
    let args=""
    let mask=checked_call_mutmask(e)
    loop i in [0..nkids(e)) {
        let text=wit_text(wit_lent(e i) depth + 1)
        # (a mutable argument, `f(@x)`)
        if text not=? "" and i <? 62 and mask & (WitWord(1) << WitWord(i)) not=? 0 {text="@{text}"}
        if i >? 0 {args="{args} "}
        if text =? "" {args="{args}..."} else {args="{args}{text}"}
    }
    "{name}({args})"
}
# What happened at an invalidating event, as a noun.
wit_event=(at:WitWord):>string=>$unsafe {
    if at <=? 0 {return "operation"}
    if nodes.ptr[at].kind =? 'exprstmt' and nodes.ptr[at].a not=? 0 {return wit_event(WitWord(nodes.ptr[at].a))}
    let k=nodes.ptr[at].kind
    if k =? 'intrinsic' {
        loop i in intrinsics {
            if i.id =? (nodes.ptr[at].aux as IN) and i.arr {return i.name}
        }
        return "operation"
    }
    if k =? 'call' {
        let f=WitWord(nodes.ptr[at].sym)
        # (a library helper's internal name is not the user's: `__print_str` is printl's)
        if nodes.ptr[at].aux =? 0 and f >? 0 and fns.ptr[f].decl not=? 0 and not starts_with(name_of(WitWord(nodes.ptr[WitWord(fns.ptr[f].decl)].name)) "__") {return "call to {name_of(WitWord(nodes.ptr[WitWord(fns.ptr[f].decl)].name))}"}
        return "call"
    }
    if k =? 'assign' {return "assignment"}
    if k =? 'while_' or k =? 'for_' {return "loop"}
    if k =? 'if_' or k =? 'and_' or k =? 'or_' {return "branch"}
    if k =? 'block' {return "block's cleanup"}
    "statement"
}
wit_reason=(b:FactBound):>string=>{
    if b.reason =? 'write' {return "value changed by assignment"}
    if b.reason =? 'call' {return "call invalidated a mutable or exposed root"}
    if b.reason =? 'callee' {return "the callee's effects are not settled"}
    if b.reason =? 'join' {return "a predecessor lacks the required evidence"}
    if b.reason =? 'loop_' {return "loop may change the tested value"}
    if b.reason =? 'unsupported' {return "unsupported symbolic operation"}
    if b.reason =? 'budget' {return "fact budget exhausted"}
    "missing scalar bound"
}
# The retained event behind an unknown bound, at its own span.
wit_cause=(b:FactBound n:WitWord):>void=>$unsafe {
    let w=b.witness
    if w <=? 0 or w =? n or b.reason =? 'missing' {return}
    let what=wit_event(w)
    if b.reason =? 'write' {wit_note(nodes.ptr[w].pos "the value was replaced by this {what}")}
    else if b.reason =? 'call' {wit_note(nodes.ptr[w].pos "this {what} may write a mutable or exposed root")}
    else if b.reason =? 'callee' {wit_note(nodes.ptr[w].pos "this {what} has no settled effect summary")}
    else if b.reason =? 'join' {wit_note(nodes.ptr[w].pos "a path into this {what} lacks the evidence")}
    else if b.reason =? 'loop_' {wit_note(nodes.ptr[w].pos "this loop may change the value")}
    else if b.reason =? 'unsupported' {wit_note(nodes.ptr[w].pos wit_unsupported(w))}
    else if b.reason =? 'budget' and (nodes.ptr[w].kind =? 'while_' or nodes.ptr[w].kind =? 'for_') {wit_note(nodes.ptr[w].pos "the loop analysis budget ran out at this loop; what it changes is unknown")}
    else if b.reason =? 'budget' {wit_note(nodes.ptr[w].pos "the fact budget ran out here")}
}
# Why arithmetic has no known range: a plain parameter (or else local) among its operands has no bound
# here, which the program can state. O(1).
wit_unsupported=(w:WitWord):>string=>$unsafe {
    if nodes.ptr[w].kind =? 'binary' and (nodes.ptr[w].op =? int32(58) or nodes.ptr[w].op =? int32(59) or nodes.ptr[w].op =? int32(60)) {
        let plain:WitWord=0
        loop operand in [WitWord(nodes.ptr[w].a) WitWord(nodes.ptr[w].b)] {
            let e=operand
            loop e not=? 0 and nodes.ptr[e].kind =? 'conv' {e=WitWord(nodes.ptr[e].a)}
            if e =? 0 or nodes.ptr[e].kind not=? 'ident' or nodes.ptr[e].aux not=? int32(1) {continue}
            let l=WitWord(nodes.ptr[e].sym)
            if tkind(WitWord(locals.ptr[l].type)) =? 'refined' {continue}
            let name=name_of(WitWord(nodes.ptr[e].name))
            if WitWord(locals.ptr[l].flags) & (LF_PARAM | LF_MUTPARAM | LF_VALUEPARAM) not=? 0 {
                return "nothing bounds `{name}` here, so this has no known range: guard it first, or state it where the parameter is declared, `{name}:{dt(prune(WitWord(locals.ptr[l].type)))}<(>=? 0)>`"
            }
            if plain =? 0 {plain=e}
        }
        if plain not=? 0 {return "nothing bounds `{name_of(WitWord(nodes.ptr[plain].name))}` here, so this has no known range: guard it first"}
    }
    "this operation is outside the fact language"
}
# Function-level context: the generic instance being analyzed.
wit_context=(contract:WitWord):>void=>$unsafe {
    if contract >? 0 {wit_note(contract "the contract is declared here")}
    let f=fact_owner
    if f >? 0 and f <? fns.length and fns.ptr[f].targs.length >? 0 and fns.ptr[f].use_pos >? 0 and fns.ptr[f].decl not=? 0 {
        let args=""
        loop i in 0.. and t in fns.ptr[f].targs {
            if i >? 0 {args="{args} "}
            args="{args}{type_str(zonk(t) true)}"
        }
        wit_note(fns.ptr[f].use_pos "in {name_of(WitWord(nodes.ptr[WitWord(fns.ptr[f].decl)].name))} with <{args}>, instantiated here")
    }
}
wit_projection=(s:FactState base:WitWord selector:WitWord):>WitWord=>{
    if base =? 0 {return 0}
    loop p in s.projections {
        if p.base =? base and not p.element and p.selector =? selector {return p.value}
    }
    0
}
# The tombstone of a side's place when it describes the side's CURRENT value:
# (event, replaced value). The replaced value of a length is the old length.
wit_tomb=(s:FactState side:WitSide):>[int64 int64]=>$unsafe {
    let e=side.node
    if e <=? 0 or nodes.ptr[e].kind not=? 'ident' {return [0 0]}
    let i=fact_binding(s fact_place(e))
    if i <? 0 or s.bindings[i].event =? 0 {return [0 0]}
    let binding=s.bindings[i]
    if not side.length {
        if binding.value not=? side.value {return [0 0]}
        return [binding.event binding.prior]
    }
    if wit_projection(s binding.value (-1)) not=? side.value {return [0 0]}
    [binding.event wit_projection(s binding.prior (-1))]
}
# Where an operand named in a failed bound last lost its value: the call or loop a guard before
# it no longer reaches past. O(bindings).
wit_operand_changed=(e0:WitWord s:FactState):>void=>$unsafe {
    let e=e0
    loop e >? 0 and (nodes.ptr[e].kind =? 'narrow' or nodes.ptr[e].kind =? 'conv') {e=WitWord(nodes.ptr[e].a)}
    if e >? 0 and nodes.ptr[e].kind =? 'binary' {
        wit_operand_changed(WitWord(nodes.ptr[e].a) s)
        wit_operand_changed(WitWord(nodes.ptr[e].b) s)
        return
    }
    if e <=? 0 or nodes.ptr[e].kind not=? 'ident' {return}
    let i=fact_binding(s fact_place(e))
    if i <? 0 or s.bindings[i].event <=? 0 or nodes.ptr[s.bindings[i].event].kind =? 'vardecl' {return}
    wit_note(nodes.ptr[s.bindings[i].event].pos "{wit_text(e)} may have changed at this {wit_event(s.bindings[i].event)}")
}
# The call an event is, through its statement; 0 for another event.
wit_call_node=(at:WitWord):>WitWord=>$unsafe {
    let e=at
    loop e >? 0 and nodes.ptr[e].kind =? 'exprstmt' {e=WitWord(nodes.ptr[e].a)}
    if e >? 0 and nodes.ptr[e].kind =? 'call' {return e}
    0
}
# Whether call c passes `@` the place spelled `text` or one containing it
# (`zero(@d["x"].count)`, `grow(@xs)` for `xs.length`). O(arguments)
wit_call_writes=(c:WitWord text:string):>bool=>{
    let mask=checked_call_mutmask(c)
    loop i in [0..min(nkids(c) 62)) {
        if mask & (WitWord(1) << WitWord(i)) =? 0 {continue}
        let place=wit_text(wit_lent(c i))
        if place not=? "" and (place =? text or starts_with(text "{place}.") or starts_with(text "{place}[")) {return true}
    }
    false
}
wit_owner_calls=():>array<int64>=>$unsafe {
    if wit_calls_owner =? fact_owner {return wit_calls}
    wit_calls_owner=fact_owner
    wit_calls=[]
    wit_parents=dict<int64 int64>()
    if fact_owner <=? 0 or fact_owner >=? fns.length or fns.ptr[fact_owner].body =? 0 {return wit_calls}
    let stack=[WitWord(fns.ptr[fact_owner].body)]
    let visits:WitWord=0
    loop stack.length >? 0 and visits <? 200000 {
        let e=stack.pop()
        visits += 1
        if e <=? 0 or e >=? nodes.length or nodes.ptr[e].kind =? 'lambda' {continue}
        if nodes.ptr[e].kind =? 'call' and nodes.ptr[e].aux =? 0 and checked_call_mutmask(e) not=? 0 and wit_call_text(e 0) not=? "" {wit_calls.push(e)}
        loop slot in [0..4 + nkids(e)) {
            let child=if slot =? 0 {WitWord(nodes.ptr[e].a)} else if slot =? 1 {WitWord(nodes.ptr[e].b)} else if slot =? 2 {kid_c(e)} else if slot =? 3 {kid_d(e)} else {kid(e slot - 4)}
            if child <=? 0 or child >=? nodes.length or wit_parents.has(child) {continue}
            wit_parents[child]=e
            stack.push(child)
        }
    }
    wit_calls
}
# Whether statement s, after a call, leaves for good: a `return`, a program
# exit, or (unless `inner`: a loop between it and the site takes it) a
# `break` or `continue` out of the loop holding both.
wit_leaves=(s:WitWord inner:bool):>bool=>$unsafe {
    if not inner {return stmt_terminates(s)}
    let k=nodes.ptr[s].kind
    if k =? 'return_' {return true}
    if k =? 'block' and has_flag(s NF_FLOW_RETURNS) {return true}
    if k =? 'exprstmt' {
        let e=WitWord(nodes.ptr[s].a)
        return WitWord(nodes.ptr[e].type) =? T_NEVER or library_exit_call(e)
    }
    false
}
# Whether call c (earlier in the analyzed function) can reach node `site`:
# not from another branch of a conditional or arm of a match holding both,
# nor past a statement after c that leaves first (wit_leaves). Back edges are
# not followed. O(depth * block length)
wit_reaches=(c:WitWord site:WitWord):>bool=>$unsafe {
    if not wit_parents.has(site) or not wit_parents.has(c) {return true}
    let above:array<int64>=[]
    let n=site
    loop n >? 0 and above.length <? 10000 {
        above.push(n)
        n=wit_parents.get(n) ?? 0
    }
    # (c's ancestors below the common one, innermost first)
    let chain:array<int64>=[]
    n=c
    loop n >? 0 and not above.contains(n) and chain.length <? 10000 {
        chain.push(n)
        n=wit_parents.get(n) ?? 0
    }
    if n <=? 0 or chain.length =? 0 {return true}
    let top=n
    let from_=chain[chain.length - 1]
    let to:WitWord=0
    loop i in [0..above.length) {
        if above[i] =? top and i >? 0 {to=above[i - 1]}
    }
    let k=nodes.ptr[top].kind
    if to not=? 0 and to not=? from_ and from_ not=? WitWord(nodes.ptr[top].a) and to not=? WitWord(nodes.ptr[top].a) and (k =? 'if_' or k =? 'iflet' or k =? 'match_') {return false}
    # (outermost first: a loop below the common ancestor takes the breaks under it)
    let inner=false
    let i=chain.length - 1
    loop i >? 0 {
        let b=chain[i]
        if nodes.ptr[b].kind =? 'while_' or nodes.ptr[b].kind =? 'for_' {inner=true}
        if nodes.ptr[b].kind =? 'block' {
            let after=false
            loop j in [0..nkids(b)) {
                let s=kid(b j)
                if after and wit_leaves(s inner) {return false}
                if s =? chain[i - 1] {after=true}
            }
        }
        i -= 1
    }
    true
}
# The latest call before a projection side's use that passes `@` its place
# (`d["x"].count` after `zero(@d["x"].count)`) and can reach it: an event a
# projection keeps no tombstone for. 0 for a variable (its tombstone tells) or
# none.
wit_projection_call=(side:WitSide):>WitWord=>$unsafe {
    if side.text =? "" or side.node <=? 0 or nodes.ptr[side.node].kind =? 'ident' {return 0}
    let site=nodes.ptr[side.node].pos
    let best:WitWord=0
    loop c in wit_owner_calls() {
        let p=nodes.ptr[c].pos
        if pos_file(p) not=? pos_file(site) or p >=? site or best not=? 0 and p <=? nodes.ptr[best].pos {continue}
        if wit_call_writes(c side.text) and wit_reaches(c side.node) {best=c}
    }
    best
}
wit_value=(s:FactState v:WitWord x:WitWord):>string=>{
    let t=if v >? 0 and v <? fact_terms.length {representation_type(fact_terms[v].type)} else {0}
    # uint64 facts order (bits xor MIN); show the value itself.
    if t =? T_U64 {return "{uint64<overflow='wrap'>(x xor FACT_MIN)}"}
    if t =? T_BOOL {return if x not=? 0 {"true"} else {"false"}}
    "{x}"
}
# Representation limits are not interesting evidence; only report real bounds.
wit_known=(b:FactBound unsigned:bool=false):>string=>{
    wit_bound_text(b.lo b.hi b.wide unsigned)
}
wit_holds=(op:Tok x:WitWord y:WitWord):>bool=>{
    if op =? 'lt' {return x <? y}
    if op =? 'le' {return x <=? y}
    if op =? 'gt' {return x >? y}
    if op =? 'ge' {return x >=? y}
    if op =? 'eq' {return x =? y}
    x not=? y
}
wit_candidates=(b:FactBound):>array<int64>=>{
    wit_bound_candidates(b.lo b.hi b.nz b.wide)
}
# A valuation of the two sides that violates `a op b` and satisfies their
# intervals and every direct difference row between them. Other constraints
# are not solved, so this is only ever reported as a possible witness.
wit_counterexample=(s:FactState op:Tok a:WitWord b:WitWord):>[bool int64 int64]=>{
    if a =? 0 or b =? 0 or a =? b {return [false 0 0]}
    loop x in wit_candidates(fact_bound(s a)) {
        loop y in wit_candidates(fact_bound(s b)) {
            if wit_holds(op x y) {continue}
            let ok=true
            loop row in s.differences {
                if row.a =? a and row.b =? b and (not fact_add_fits(x (-y)) or x - y >? row.limit) {ok=false}
                if row.a =? b and row.b =? a and (not fact_add_fits(y (-x)) or y - x >? row.limit) {ok=false}
            }
            if ok {return [true x y]}
        }
    }
    [false 0 0]
}
# The same evaluation, or two constants with one value (each literal capture
# is its own term).
wit_same=(s:FactState u:WitWord v:WitWord):>bool=>{
    if u =? v {return true}
    let x=fact_bound(s u)
    let y=fact_bound(s v)
    u not=? 0 and v not=? 0 and x.lo =? x.hi and y.lo =? y.hi and x.lo =? y.lo
}
# A guard that established `a op b` directly, or 0.
wit_guard=(s:FactState op:Tok a:WitWord b:WitWord):>WitWord=>{
    let lt_limit:WitWord=if op =? 'lt' {-1} else {0}
    let gt_limit:WitWord=if op =? 'gt' {-1} else {0}
    loop row in s.differences {
        if row.at <=? 0 {continue}
        if (op =? 'lt' or op =? 'le') and wit_same(s row.a a) and wit_same(s row.b b) and row.limit <=? lt_limit {return row.at}
        if (op =? 'gt' or op =? 'ge') and wit_same(s row.a b) and wit_same(s row.b a) and row.limit <=? gt_limit {return row.at}
    }
    0
}
# Stored atoms read `a < b`; show a constrained value before a literal bound.
wit_orient=(op:Tok a:WitSide b:WitSide):>[Tok WitSide WitSide]=>{
    if a.literal and not b.literal and (op =? 'lt' or op =? 'le') {
        let flipped=if op =? 'lt' {Tok.gt} else {Tok.ge}
        return [flipped b a]
    }
    [op a b]
}
wit_relation_text=(op:Tok a:WitSide b:WitSide):>string=>{
    if a.text =? "" or b.text =? "" {return ""}
    "{a.text} {wit_op(op)} {b.text}"
}
wit_constant=(s:FactState v:WitWord):>bool=>{
    let b=fact_bound(s v)
    v not=? 0 and b.lo =? b.hi
}
# Notes for one comparison obligation `a op b`: current values, a replaced
# route and the stale fact it carried, the missing bound, a possible witness.
# `s` holds the evidence; `cex` the state in which a possible witness is sought.
wit_relation=(s:FactState cex:FactState op:Tok a:WitSide b:WitSide refuted:bool missing:string=""):>string=>$unsafe {
    let relation=wit_relation_text(op a b)
    let stale=false
    loop side in [a b] {
        if side.text =? "" or side.literal {continue}
        let bound=fact_bound(s side.value)
        let tomb=wit_tomb(s side)
        let shown=if bound.lo =? bound.hi and not bound.wide {wit_value(s side.value bound.lo)} else {""}
        let unsigned=side.value >? 0 and side.value <? fact_terms.length and representation_type(fact_terms[side.value].type) =? T_U64
        let known=if shown not=? "" {"is {shown}"} else if bound.lo =? bound.hi and not bound.wide {""} else {wit_known(bound unsigned)}
        # (a declaration makes the binding; it does not change an earlier value)
        if tomb[0] not=? 0 and nodes.ptr[tomb[0]].kind =? 'vardecl' and tomb[1] =? 0 {tomb=[0 0]}
        # (the call that replaced the value: the repair checks after it)
        let changed=if tomb[0] =? 0 and not refuted {wit_projection_call(side)} else {wit_call_node(tomb[0])}
        if tomb[0] =? 0 and changed not=? 0 {wit_note(nodes.ptr[changed].pos "{side.text} may have changed at this {wit_event(changed)}")}
        if changed not=? 0 and relation not=? "" {
            wit_after=changed
            wit_after_relation=relation
            wit_after_note=if tomb[0] not=? 0 {nodes.ptr[tomb[0]].pos} else {nodes.ptr[changed].pos}
        }
        if tomb[0] not=? 0 {
            let what=wit_event(tomb[0])
            if shown not=? "" {wit_note(nodes.ptr[tomb[0]].pos "{side.text} {known} after this {what}")}
            else {wit_note(nodes.ptr[tomb[0]].pos "{side.text} may have changed at this {what}")}
            if tomb[1] not=? 0 and not stale {
                let x=if side.value =? a.value {tomb[1]} else {a.value}
                let y=if side.value =? b.value {tomb[1]} else {b.value}
                if fact_compare(s op x y) =? 1 {
                    stale=true
                    let fact=if relation not=? "" {"`{relation}` fact"} else {"fact"}
                    let guard=wit_guard(s op x y)
                    let guard_at=if guard >? 0 {nodes.ptr[guard].pos} else {-1}
    wit_note(guard_at "the earlier {fact} described the value before the {what}")
                }
            }
        }
        else if known not=? "" {wit_note((-1) "{side.text} {known}")}
    }
    if refuted or relation =? "" {return ""}
    let which=missing
    if which =? "" {
        # `a < b` bounds a from above, unless a is the constant end.
        let upper=(op =? 'lt' or op =? 'le') not=? wit_constant(s a.value)
        which=if op =? 'eq' or op =? 'ne' {"bound"} else if upper {"upper bound"} else {"lower bound"}
    }
    wit_note((-1) "missing {which}: nothing establishes `{relation}` here")
    let found=wit_counterexample(cex op a.value b.value)
    if found[0] {
        let shown=""
        if not a.literal {shown="{a.text} = {wit_value(s a.value found[1])}"}
        if not b.literal {
            if shown not=? "" {shown="{shown}, "}
            shown="{shown}{b.text} = {wit_value(s b.value found[2])}"
        }
        if shown not=? "" {wit_note((-1) "possible witness (consistent with the known bounds, not an observed execution): {shown}")}
    }
    which
}
# Unknown obligations: a reason, the retained cause, context and a repair.
wit_unknown=(n:WitWord b:FactBound what:string contract:WitWord=0 relation:string="" missing:string="" runtime:bool=true divisor:WitWord=0):>void=>$unsafe {
    wit_cause(b n)
    wit_context(contract)
    wit_help(relation runtime contract)
    wit_counter_help(n b)
    wit_int_parameter_help(n)
    wit_int_global_help(n)
    wit_field_divisor_help(divisor)
    # (a loop's or an unsupported operation's part is a note at its span: the
    # headline names the bound the relation lacks)
    let why=if missing not=? "" and (b.reason =? 'missing' or b.reason =? 'loop_' or b.reason =? 'unsupported') {"missing {missing}"} else {wit_reason(b)}
    # (`q` is nonempty: the relation it lacks, not the analysis's word for it)
    if missing =? "" and b.reason =? 'missing' and relation not=? "" {why="nothing establishes `{relation}` here"}
    if dir_defer(n "cannot prove {what}: {why}" runtime and what not=? "assertion") {return}
    wit_fail(nodes.ptr[n].pos "cannot prove {what}: {why}")
}
# (`i // g.columns` with `columns:int`: a refined field holds its contract at
# every read, the "stronger checked contract" spelled out. O(1))
wit_field_divisor_help=(operand:WitWord):>void=>$unsafe {
    let e=operand
    loop e >? 0 and (nodes.ptr[e].kind =? 'narrow' or nodes.ptr[e].kind =? 'conv') {e=WitWord(nodes.ptr[e].a)}
    if e <=? 0 or nodes.ptr[e].kind not=? 'field' or nodes.ptr[e].aux <? 0 or not dewy_at(nodes.ptr[e].pos) {return}
    let record=representation_type(ntype(WitWord(nodes.ptr[e].a)))
    if tkind(record) not=? 'struct_' or not is_int(prune(ntype(e))) and prune(ntype(e)) not=? T_MATH_INT {return}
    let d=WitWord(structs.ptr[WitWord(types.ptr[record].st)].decl)
    if d =? 0 or pos_in_lib(nodes.ptr[d].pos) {return}
    err_notes.push([(-1) "help: or give the field a contract where `{dt(record)}` declares it, `{name_of(WitWord(nodes.ptr[e].name))}:{dt(prune(ntype(e)))}<(>? 0)>`: every write to it is checked, so each read is a nonzero divisor"])
}
# (`let n = 0`, `n += 1` in a loop, then `n` given as an int64: the counter-progress
# assumption covers 64-bit counters, not an `int` converted afterwards. O(1))
wit_counter_help=(n:WitWord b:FactBound):>void=>$unsafe {
    if b.reason not=? 'loop_' or n <=? 0 or nodes.ptr[n].a =? 0 or not is_int(ntype(n)) or types.ptr[prune(ntype(n))].bits not=? 64 {return}
    let v=WitWord(nodes.ptr[n].a)
    loop nodes.ptr[v].kind =? 'narrow' {v=WitWord(nodes.ptr[v].a)}
    if nodes.ptr[v].kind not=? 'ident' or nodes.ptr[v].aux not=? int32(1) or prune(ntype(v)) not=? T_MATH_INT or not dewy_at(nodes.ptr[n].pos) {return}
    let name=name_of(WitWord(nodes.ptr[v].name))
    err_notes.push([(-1) "help: or declare `{name}` a 64-bit counter where it is made (`let {name}:{dt(ntype(n))} = 0`): the counter-progress assumption covers 64-bit counters, not an `int` converted afterwards"])
}
# (`let other = -1`, a script's `int` given where an int64 is wanted: one declared with the width
# holds only what fits, and each write is proven. O(1))
wit_int_global_help=(n:WitWord):>void=>$unsafe {
    if n <=? 0 or nodes.ptr[n].a =? 0 or not is_int(ntype(n)) or prune(ntype(n)) =? T_MATH_INT or not dewy_at(nodes.ptr[n].pos) {return}
    let v=WitWord(nodes.ptr[n].a)
    loop nodes.ptr[v].kind =? 'narrow' {v=WitWord(nodes.ptr[v].a)}
    # (a symbol kind's ordinal: global 2)
    if nodes.ptr[v].kind not=? 'ident' or nodes.ptr[v].aux not=? int32(2) or prune(ntype(v)) not=? T_MATH_INT {return}
    let name=name_of(WitWord(nodes.ptr[v].name))
    err_notes.push([(-1) "help: or declare `{name}` with its width where it is made (`let {name}:{dt(ntype(n))} = ...`): an `int` holds any integer, and one with a width proves each write instead"])
}
# (`bins:int` given where an int64 is wanted, `fill(0 bins)`: an `int` parameter holds any
# integer, while one declared with the width moves the proof to each caller. O(1))
wit_int_parameter_help=(n:WitWord):>void=>$unsafe {
    if n <=? 0 or nodes.ptr[n].a =? 0 or not is_int(ntype(n)) or prune(ntype(n)) =? T_MATH_INT or not dewy_at(nodes.ptr[n].pos) {return}
    let v=WitWord(nodes.ptr[n].a)
    loop nodes.ptr[v].kind =? 'narrow' {v=WitWord(nodes.ptr[v].a)}
    if nodes.ptr[v].kind not=? 'ident' or nodes.ptr[v].aux not=? int32(1) or prune(ntype(v)) not=? T_MATH_INT {return}
    if WitWord(locals.ptr[WitWord(nodes.ptr[v].sym)].flags) & LF_VALUEPARAM =? 0 {return}
    let name=name_of(WitWord(nodes.ptr[v].name))
    err_notes.push([(-1) "help: or declare the parameter `{name}:{dt(ntype(n))}`: an `int` parameter holds any integer, and one with a width moves the proof to each caller"])
}
wit_side=(value:WitWord node0:WitWord):>WitSide=>$unsafe {
    let node=node0
    loop node >? 0 and (nodes.ptr[node].kind =? 'narrow' or nodes.ptr[node].kind =? 'conv' and wit_same_value(node)) {node=WitWord(nodes.ptr[node].a)}
    let side=WitSide(value node wit_text(node))
    if node >? 0 and nodes.ptr[node].kind =? 'int_lit' {side.literal=true}
    if node >? 0 and nodes.ptr[node].kind =? 'intrinsic' and nodes.ptr[node].aux =? int32(int64(IN.len)) and nkids(node) >? 0 {
        side.node=kid(node 0)
        side.length=true
    }
    side
}
# The comparison a leaf condition tests: its relation and missing bound, after
# notes on its operands. `paths.no` is the violating state.
wit_comparison=(c:WitWord paths:FactPaths refuted:bool):>[string string]=>$unsafe {
    let relation=""
    let missing=""
    let s=paths.no
    let reason=paths.reason
    if paths.value >? 0 and nodes.ptr[c].kind =? 'binary' and fact_comparison(cx_token_values.ptr[WitWord(nodes.ptr[c].op)]) {
        let term=fact_terms[paths.value]
        if term.op =? (cx_token_values.ptr[WitWord(nodes.ptr[c].op)]) and term.origin =? c {
            let a=wit_side(term.a WitWord(nodes.ptr[c].a))
            let b=wit_side(term.b WitWord(nodes.ptr[c].b))
            relation=wit_relation_text(term.op a b)
            if refuted or reason.reason not=? 'unsupported' and reason.reason not=? 'budget' {
                let entry=if paths.entry.live {paths.entry} else {s}
                missing=wit_relation(entry s term.op a b refuted)
            }
        }
    }
    [relation missing]
}
# 1 when the wanted edge is the only live one, 0 when it is dead, -1 otherwise.
wit_status=(p:FactPaths want:bool):>WitWord=>{
    let wanted=if want {p.yes} else {p.no}
    let other=if want {p.no} else {p.yes}
    if not wanted.live {return 0}
    if other.live {return -1}
    1
}
# Name the operands of an `and`/`or` condition that fail it: when every
# operand must hold, the first refuted one (else the first unknown); when one
# suffices, each of them. Each is re-evaluated in the state its evaluation
# sees, exactly as the obligation was.
wit_connective=(n:WitWord entry:FactState want:bool refuted:bool role:string):>WitLeaf=>$unsafe {
    let k=nodes.ptr[n].kind
    if k =? 'not_' {return wit_connective(WitWord(nodes.ptr[n].a) entry not want refuted role)}
    if k =? 'and_' or k =? 'or_' {
        let operand=if k =? 'and_' {"conjunct"} else {"alternative"}
        let a=fact_condition(WitWord(nodes.ptr[n].a) entry)
        let rest=if k =? 'and_' {a.yes} else {a.no}
        if (k =? 'and_') =? want {
            let first=wit_status(a want)
            if first =? 0 or first =? -1 and not refuted or not rest.live {return wit_connective(WitWord(nodes.ptr[n].a) entry want refuted operand)}
            return wit_connective(WitWord(nodes.ptr[n].b) rest want refuted operand)
        }
        let left=wit_connective(WitWord(nodes.ptr[n].a) entry want refuted operand)
        if not rest.live {return left}
        let right=wit_connective(WitWord(nodes.ptr[n].b) rest want refuted operand)
        # Establishing any one unknown alternative would suffice.
        let count=left.count + right.count
        if left.count =? 0 or right.unknown and not left.unknown {left=right}
        left.count=count
        return left
    }
    let p=fact_condition(n entry)
    let status=wit_status(p want)
    let leaf=WitLeaf(reason=p.reason)
    if status =? 1 or not entry.live {return leaf}
    leaf.count=1
    leaf.unknown=(status =? -1)
    let truth=if want {"false"} else {"true"}
    if status =? 0 {wit_note(nodes.ptr[n].pos "this {role} is always {truth}")}
    else if want {wit_note(nodes.ptr[n].pos "this {role} is not proven")}
    else {wit_note(nodes.ptr[n].pos "this {role} is not proven false")}
    if want {
        let found=wit_comparison(n p status =? 0)
        leaf.relation=found[0]
        leaf.missing=found[1]
    }
    leaf
}
wit_assertion=(cond:WitWord message:WitWord paths:FactPaths entry:FactState):>void=>$unsafe {
    let refuted=not paths.yes.live
    let relation=""
    let missing=""
    let reason=paths.reason
    let k=nodes.ptr[cond].kind
    if (k =? 'and_' or k =? 'or_' or k =? 'not_') and entry.live {
        fact_query=true
        let leaf=wit_connective(cond entry true refuted "condition")
        fact_query=false
        if leaf.count =? 1 or not refuted and leaf.unknown {
            relation=leaf.relation
            missing=leaf.missing
            reason=leaf.reason
        }
    }
    else {
        let found=wit_comparison(cond paths refuted)
        relation=found[0]
        missing=found[1]
    }
    if refuted {
        if wit_obligation not=? 0 and message not=? 0 {
            err_notes=[]
            fatal(nodes.ptr[cond].pos "{name_of(WitWord(nodes.ptr[message].sval))}, and the length here is known to differ")
        }
        wit_context(0)
        wit_help(relation)
        assertion_refuted(cond message)
    }
    # (an unpacking's or a spread's length: an obligation, which a scope with runtime
    # checks keeps as one)
    if wit_obligation not=? 0 and message not=? 0 {
        let what="the length ({name_of(WitWord(nodes.ptr[message].sval))})"
        # (the length of an element or a temporary has no spelling: say how a
        # fixed shape states it, as a tuple type does)
        if relation =? "" and starts_with(name_of(WitWord(nodes.ptr[message].sval)) "unpacking") {
            wit_cause(reason cond)
            wit_context(0)
            let words=split(name_of(WitWord(nodes.ptr[message].sval)) " ")
            let first=if words.length >=? 5 and words[2] =? "at" {"if xs.length >=? {words[4]}"} else if words.length >=? 4 {"if xs.length =? {words[3]}"} else {"if xs.length =? 2"}
            err_notes.push([(-1) "help: give the values a fixed shape, such as a tuple type (`array<[int64 int64]>` for pairs) or a record, or test the length first (`{first}`)"])
            let why=if reason.reason =? 'missing' {"nothing establishes the length here"} else {wit_reason(reason)}
            if dir_defer(cond "cannot prove {what}: {why}" true) {return}
            wit_fail(nodes.ptr[cond].pos "cannot prove {what}: {why}")
            return
        }
        wit_unknown(cond reason what 0 relation missing)
        return
    }
    wit_unknown(cond reason "assertion" 0 relation missing)
}
# A builtin index: refuted (some bound is false) or unknown (some is missing).
wit_index=(n:WitWord @s:FactState index:WitWord length:WitWord lo:WitWord hi:WitWord base_node:WitWord=-1 index_node:WitWord=-1 inclusive:bool=false):>void=>$unsafe {
    # (`pool[h].hp -= 1` indexes the pool's storage `items` at `__pool_index`'s
    # answer: what it needs is the handle's membership, said as the user wrote it)
    if has_flag(n NF_LIB_INDEX) {
        let storage=WitWord(nodes.ptr[n].a)
        loop storage >? 0 and (nodes.ptr[storage].kind =? 'addr' or nodes.ptr[storage].kind =? 'narrow') {storage=WitWord(nodes.ptr[storage].a)}
        let pool=if nodes.ptr[storage].kind =? 'field' {wit_text(WitWord(nodes.ptr[storage].a))} else {""}
        let what=if pool not=? "" {"the handle is in the pool `{pool}` for this update of its entry"} else {"the handle is in the pool for this update of its entry"}
        wit_context(0)
        let shown_pool=if pool not=? "" {pool} else {"pool"}
        err_notes.push([(-1) "help: establish `{shown_pool}.has(handle)` with a current guard, or copy the entry out, change it and store it back (`let e = pool[h]` ... `pool[h] = e`)"])
        if dir_defer(n "cannot prove {what}" true) {return}
        wit_fail(nodes.ptr[n].pos "cannot prove {what}")
        return
    }
    let a=if base_node >=? 0 {base_node} else {WitWord(nodes.ptr[n].a)}
    let base=wit_text(a)
    # A loop's own element read is described as such, never by its lowering.
    let read="index"
    # (`pair[i]` of a `[int64 string]` reads a fixed array of its positions)
    let positions=nodes.ptr[a].kind =? 'ident' and starts_with(name_of(WitWord(nodes.ptr[a].name)) "$position_values")
    # (an update's captured selector, `xs[u] += 1`, is the source's own index)
    let update=index_update_sources.length >? 0 and nodes.ptr[WitWord(nodes.ptr[n].b)].kind =? 'ident' and index_update_sources.has(WitWord(nodes.ptr[WitWord(nodes.ptr[n].b)].name))
    if wit_hidden_read(n) and not positions and not update {read=if base not=? "" {"the loop's read of `{base}`"} else {"the loop's element read"}}
    let shown_index=if index_node >=? 0 {index_node} else {WitWord(nodes.ptr[n].b)}
    let i=wit_side(index shown_index)
    let zero=WitSide(fact_constant(@s 0) 0 "0" false true)
    let size_text=if base not=? "" {"{base}.length"} else {""}
    let size=WitSide(length a size_text true)
    let upper_op=if inclusive {Tok.le} else {Tok.lt}
    let relation=wit_relation_text(upper_op i size)
    if lo =? 0 or hi =? 0 {
        if lo =? 0 {
            wit_relation(s s 'ge' i zero true);
            relation=wit_relation_text('ge' i zero)
        }
        else {wit_relation(s s upper_op i size true);}
        wit_context(0)
        wit_help(relation)
        if dir_defer(n "{read} is not in bounds" true) {return}
        wit_fail(nodes.ptr[n].pos "{read} is not in bounds")
        return
    }
    # An opaque or budget-limited index still owes both bounds. Name the
    # same contract as an ordinary missing bound, not just its upper half.
    if lo not=? 1 and hi not=? 1 {relation=if relation not=? "" {"0 <=? {relation}"} else {""}}
    else if lo not=? 1 {relation=wit_relation_text('ge' i zero)}
    let b=fact_bound(s index)
    if b.reason =? 'unsupported' or b.reason =? 'budget' or b.reason =? 'callee' {
        wit_unknown(n b "{read} is in bounds" 0 relation)
        return
    }
    if lo not=? 1 {wit_relation(s s 'ge' i zero false "lower bound");}
    if hi not=? 1 {
        wit_relation(s s upper_op i size false "upper bound");
        wit_cause(fact_bound(s length) n)
    }
    wit_context(0)
    wit_help(relation)
    if hi not=? 1 {wit_position_help(n shown_index a)}
    if lo not=? 1 {wit_parameter_lower_help(shown_index)}
    let which=if lo not=? 1 and hi not=? 1 {"lower and upper bounds"} else if lo not=? 1 {"lower bound"} else {"upper bound"}
    if dir_defer(n "cannot prove {read} is in bounds: missing {which}" true) {return}
    wit_fail(nodes.ptr[n].pos "cannot prove {read} is in bounds: missing {which}")
}
# (`tokens[pos]` with `pos` a parameter: a position that cannot be negative says so where it is
# declared, and each caller proves it. O(1))
wit_parameter_lower_help=(index0:WitWord):>void=>$unsafe {
    let e=index0
    loop e >? 0 and (nodes.ptr[e].kind =? 'narrow' or nodes.ptr[e].kind =? 'conv') {e=WitWord(nodes.ptr[e].a)}
    if e <=? 0 or nodes.ptr[e].kind not=? 'ident' or nodes.ptr[e].aux not=? int32(1) or not dewy_at(nodes.ptr[e].pos) {return}
    let flags=WitWord(locals.ptr[WitWord(nodes.ptr[e].sym)].flags)
    if flags & (LF_PARAM | LF_MUTPARAM | LF_VALUEPARAM) =? 0 {return}
    let mark=if flags & LF_MUTPARAM not=? 0 {"@"} else {""}
    err_notes.push([(-1) "help: or state it where the parameter is declared, `{mark}{name_of(WitWord(nodes.ptr[e].name))}:{dt(prune(ntype(e)))}<(>=? 0)>`: each caller then proves it"])
}
# (`xs[argmax(xs)]`, argmax returning a plain `int`: what its body proves
# holds for every input, an empty xs among them, where no index is below the
# length. The documented repair returns an optional position. O(arguments))
wit_position_help=(n:WitWord index0:WitWord base0:WitWord):>void=>$unsafe {
    let e=index0
    loop e >? 0 and (nodes.ptr[e].kind =? 'narrow' or nodes.ptr[e].kind =? 'conv') {e=WitWord(nodes.ptr[e].a)}
    if e <=? 0 or nodes.ptr[e].kind not=? 'call' or nodes.ptr[e].aux not=? 0 or nodes.ptr[e].sym <=? 0 or not dewy_at(nodes.ptr[n].pos) {return}
    let f=WitWord(nodes.ptr[e].sym)
    let d=WitWord(fns.ptr[f].decl)
    let ret=prune(WitWord(fns.ptr[f].ret))
    if d =? 0 or pos_in_lib(nodes.ptr[d].pos) or not is_int(ret) or tkind(ret) =? 'opt' {return}
    let base=base0
    loop base >? 0 and (nodes.ptr[base].kind =? 'addr' or nodes.ptr[base].kind =? 'narrow' or nodes.ptr[base].kind =? 'conv') {base=WitWord(nodes.ptr[base].a)}
    if base <=? 0 or nodes.ptr[base].kind not=? 'ident' or nodes.ptr[base].aux not=? int32(1) {return}
    let param=""
    loop i in [0..nkids(e)) {
        let c=kid(e i)
        loop nodes.ptr[c].kind =? 'addr' or nodes.ptr[c].kind =? 'narrow' or nodes.ptr[c].kind =? 'conv' {c=WitWord(nodes.ptr[c].a)}
        if nodes.ptr[c].kind =? 'ident' and nodes.ptr[c].aux =? int32(1) and nodes.ptr[c].sym =? nodes.ptr[base].sym and i <? fns.ptr[f].params.length {param=name_of(WitWord(locals.ptr[fns.ptr[f].params[i]].name))}
    }
    if param =? "" {return}
    let name=name_of(WitWord(nodes.ptr[d].name))
    let array=wit_text(base)
    err_notes.push([(-1) "help: or have `{name}` return an optional position, `:>int?` with `if {param}.is_empty return none` first: a plain `int` result is not tied to `{array}.length` (an empty `{array}` has no index), while after `if p isnt? none` an optional one indexes `{array}` without a guard"])
}
# `d[k]`, `d[k] += 1` or `d.pop(k)` where k may be missing (facts.jo fact_map_check).
wit_key=(n:WitWord):>void=>$unsafe {
    # (an update's receiver is its place: `d[k][j] += 1` reads `d[k]` at `@`)
    let receiver=kid(n 0)
    loop receiver >? 0 and nodes.ptr[receiver].kind =? 'addr' {receiver=WitWord(nodes.ptr[receiver].a)}
    let base=wit_text(receiver)
    let e=kid(n 1)
    let key=if nodes.ptr[e].kind =? 'str_lit' and nkids(e) =? 0 and nodes.ptr[e].sval >=? 0 {"\"{name_of(WitWord(nodes.ptr[e].sval))}\""} else {wit_text(e)}
    let relation=if base not=? "" and key not=? "" {"{key} in? {base}"} else {""}
    wit_context(0)
    wit_help(relation)
    if is_dewy_set_type(representation_type(ntype(kid(n 0)))) {
        if base not=? "" and key not=? "" {err_notes.push([(-1) "help: or take a missing member as a value: `{base}.pop({key} default=none)` gives none for it"])}
        if dir_defer(n "cannot prove the value is in the set" true) {return}
        wit_fail(nodes.ptr[n].pos "cannot prove the value is in the set")
        return
    }
    if base not=? "" and key not=? "" {err_notes.push([(-1) "help: or take the missing key as a value: `{base}.get({key})` gives none for it"])}
    # (a key of a finite literal type, `p.severity` of `'a' | 'b'`, in a plain dict:
    # a totaldict has every key, so its reads need no guard)
    let dict=representation_type(ntype(kid(n 0)))
    if base not=? "" and nodes.ptr[e].kind =? 'conv' and nodes.ptr[e].aux =? int32(int64(CV.set_text)) and is_map_type(dict) and total_dict_keys(ntype(WitWord(nodes.ptr[e].a)))[0] {
        err_notes.push([(-1) "help: or declare `{base}` a `totaldict<{dt_named(ntype(WitWord(nodes.ptr[e].a)))} {dt(struct_targ(WitWord(types.ptr[prune(dict)].st) 1))}>`, made from a literal with every key: its reads need no guard"])
    }
    else if base not=? "" and is_map_type(dict) and dewy_at(nodes.ptr[n].pos) {
        # (a constant dictionary written out with text keys: those keys as a literal union)
        let keys=wit_constant_keys(receiver)
        if keys not=? "" {err_notes.push([(-1) "help: or key the constant by its keys, `const {base}:totaldict<{keys} {dt(struct_targ(WitWord(types.ptr[prune(dict)].st) 1))}> = [...]`: a totaldict has every key, so its reads need no guard"])}
    }
    if dir_defer(n "cannot prove the key is in the dictionary" true) {return}
    wit_fail(nodes.ptr[n].pos "cannot prove the key is in the dictionary")
}
# The keys of a module constant made from a dictionary literal with plain text keys,
# as a literal union (`'tsp' | 'cup'`); "" for anything else. O(keys)
wit_constant_keys=(r0:WitWord):>string=>$unsafe {
    let r=r0
    loop r >? 0 and (nodes.ptr[r].kind =? 'conv' or nodes.ptr[r].kind =? 'narrow') {r=WitWord(nodes.ptr[r].a)}
    if r <=? 0 or nodes.ptr[r].kind not=? 'ident' or nodes.ptr[r].aux not=? int32(2) {return ""}
    let d=WitWord(globals.ptr[WitWord(nodes.ptr[r].sym)].decl)
    if d <=? 0 or not has_flag(d NF_RDONLY) or nodes.ptr[d].kind not=? 'vardecl' {return ""}
    let init=WitWord(nodes.ptr[d].b)
    loop init >? 0 and nodes.ptr[init].kind =? 'conv' {init=WitWord(nodes.ptr[init].a)}
    if init <=? 0 or nodes.ptr[init].kind not=? 'map_lit' or nkids(init) =? 0 or nkids(init) >? 8 {return ""}
    let parts:array<string>=[]
    loop i in [0..nkids(init)) {
        let pair=kid(init i)
        let k=WitWord(nodes.ptr[pair].a)
        loop k >? 0 and nodes.ptr[k].kind =? 'conv' {k=WitWord(nodes.ptr[k].a)}
        if k <=? 0 or nodes.ptr[k].kind not=? 'str_lit' or nkids(k) not=? 0 or nodes.ptr[k].sval <? 0 {return ""}
        let text=name_of(WitWord(nodes.ptr[k].sval))
        # (text a quoted literal type could not spell as it is)
        loop bad in ["'" "\\" "\n" "\{" "}"] {
            if contains(text bad) {return ""}
        }
        parts.push("'{text}'")
    }
    " | ".join(parts)
}
# A builtin operation's precondition `a op b` (`xs.length >? 0` for pop, a
# truncate count `>=? 0`), refuted (c = 0) or unknown: one lower bound.
wit_operation=(n:WitWord @s:FactState op:Tok a0:WitSide b:WitSide c:WitWord refuted:string what:string):>void=>$unsafe {
    let a=a0
    if a.text =? "" {a.text=wit_held_name(s a.value)}
    let relation=wit_relation_text(op a b)
    # (`xs.truncate(n)`: the guard belongs before the call)
    let before=""
    if nodes.ptr[n].kind =? 'intrinsic' and nodes.ptr[n].aux =? int32(int64(IN.truncate)) and a.text not=? "" {
        let receiver=kid(n 0)
        loop receiver >? 0 and nodes.ptr[receiver].kind =? 'addr' {receiver=WitWord(nodes.ptr[receiver].a)}
        let shown=wit_text(receiver)
        if shown =? "" and nodes.ptr[receiver].kind =? 'ident' {
            let i=fact_binding(s fact_place(receiver))
            if i >=? 0 {shown=wit_held_name(s s.bindings[i].value)}
        }
        if shown not=? "" {before="{shown}.truncate({a.text})"}
    }
    if c =? 0 {
        wit_relation(s s op a b true);
        wit_context(0)
        wit_help(relation)
        if dir_defer(n refuted true) {return}
        wit_fail(nodes.ptr[n].pos refuted)
        return
    }
    let bound=fact_bound(s a.value)
    if bound.reason =? 'unsupported' or bound.reason =? 'budget' or bound.reason =? 'callee' {
        wit_unknown(n bound what 0 relation)
        return
    }
    wit_relation(s s op a b false "lower bound");
    wit_context(0)
    wit_help(relation true 0 before)
    if dir_defer(n "cannot prove {what}: missing lower bound" true) {return}
    wit_fail(nodes.ptr[n].pos "cannot prove {what}: missing lower bound")
}
# The variable holding value v, for an operand a call captured into a hidden
# local (`xs.truncate(n)` on a refined array); "" for none. O(bindings)
wit_held_name=(s:FactState v:WitWord):>string=>$unsafe {
    if v <=? 0 {return ""}
    loop binding in s.bindings {
        let l=binding.place.declaration
        if binding.value not=? v or binding.place.root not=? 'local' or l <=? 0 or locals.ptr[l].name =? 0 {continue}
        if not wit_hidden_name(name_of(WitWord(locals.ptr[l].name))) {return name_of(WitWord(locals.ptr[l].name))}
    }
    ""
}
# A builtin slice `xs[lo..hi)`: 0 <=? lo <=? hi <=? xs.length, where an
# omitted bound is 0 or the length and an inclusive end counts one more.
wit_slice=(n:WitWord @s:FactState lo:WitWord hi:WitWord length:WitWord checks:array<int64>):>void=>$unsafe {
    let r=WitWord(nodes.ptr[n].b)
    wit_slice_at(n @s lo hi length checks WitWord(nodes.ptr[n].a) WitWord(nodes.ptr[r].a) WitWord(nodes.ptr[r].b) has_flag(r NF_INCLUSIVE) true)
}
# A Python programmer's slice clamps to the receiver; Dewy spells that
# `xs[$clamp a..b)`. Offered only when every written part prints. O(1).
wit_clamp_help=(base:string lo_node:WitWord hi_node:WitWord):>void=>{
    let start=if lo_node not=? 0 {wit_text(lo_node)} else {""}
    let stop=if hi_node not=? 0 {wit_text(hi_node)} else {""}
    if base =? "" or lo_node not=? 0 and start =? "" or hi_node not=? 0 and stop =? "" {return}
    let range=if hi_node not=? 0 {"{start}..{stop})"} else {"{start}..]"}
    err_notes.push([(-1) "help: or truncate it to `{base}` as Python's slices do: `{base}[$clamp {range}`"])
}
wit_divisor=(n:WitWord s:FactState divisor:WitWord zero:WitWord operand:WitWord refuted:bool):>void=>$unsafe {
    let side=wit_side(divisor operand)
    let nil=WitSide(zero 0 "0" false true)
    let missing=wit_relation(s s 'ne' side nil refuted)
    wit_context(0)
    if refuted {
        wit_help(wit_relation_text('ne' side nil))
        if dir_defer(n "divisor refuted: zero" true) {return}
        wit_fail(nodes.ptr[n].pos "divisor refuted: zero")
        return
    }
    wit_unknown(n fact_bound(s divisor) "divisor is nonzero" 0 wit_relation_text('ne' side nil) missing divisor=operand)
}
wit_ref_text=(term:RefTerm self:string):>string=>$unsafe {
    let text=""
    if term.kind =? 0 {text=self}
    else if term.kind =? 6 {text=wit_holder_text}
    else if term.kind =? 1 {return if term.unsigned {""} else {"{term.value}"}}
    else if term.kind =? 3 {text=name_of(WitWord(locals.ptr[term.value].name))}
    if text =? "" {return ""}
    loop selector in term.path {
        if selector =? ND_STORAGE_VALID {text="{text} (data matches shape)"}
        else if selector =? -1 {text="{text}.length"}
        else if selector =? -2 {text="{text}.length.length"}
        else if selector <=? -3 {text="{text}.length[{-3 - selector}]"}
        else {text="{text}.{name_of(selector)}"}
    }
    "{text}{wit_offset_text(term.offset)}"
}
wit_ref_side=(term:RefTerm value:WitWord n:WitWord self:string):>WitSide=>$unsafe {
    if term.kind =? 0 and term.path.length =? 0 {
        let side=wit_side(value WitWord(nodes.ptr[n].a))
        if side.text =? "" {side.text=self}
        return side
    }
    let text=wit_ref_text(term self)
    # (another argument of the call, `lo` in `hi:int<(>=? lo)>`: as the caller wrote it)
    if text =? "" and (term.kind =? 2 or term.kind =? 5) and term.path.length =? 0 and term.offset =? 0 and value >? 0 and value <? fact_terms.length {
        let origin=fact_terms[value].origin
        if origin <=? 0 or wit_text(origin) =? "" {
            # (a name's value has no origin there: the call's own argument)
            let call=wit_call_holding(n)
            if call >? 0 and term.value <? nkids(call) {origin=kid(call term.value)}
        }
        if origin >? 0 {
            let side=wit_side(value origin)
            if side.text not=? "" {return side}
        }
    }
    WitSide(value 0 text false term.kind =? 1)
}
# The call one of whose arguments is n, in the analyzed function; 0 for none.
# O(function size), on the error path only.
wit_call_holding=(n:WitWord):>WitWord=>$unsafe {
    if fact_owner <=? 0 or fact_owner >=? fns.length or fns.ptr[fact_owner].body =? 0 {return 0}
    let stack=[WitWord(fns.ptr[fact_owner].body)]
    let visits:WitWord=0
    loop stack.length >? 0 and visits <? 200000 {
        let e=stack.pop()
        visits += 1
        if e <=? 0 or e >=? nodes.length or nodes.ptr[e].kind =? 'lambda' {continue}
        if nodes.ptr[e].kind =? 'call' {
            loop i in [0..nkids(e)) {
                let child=kid(e i)
                if child =? n {return e}
            }
        }
        stack.push(WitWord(nodes.ptr[e].a))
        stack.push(WitWord(nodes.ptr[e].b))
        stack.push(kid_c(e))
        stack.push(kid_d(e))
        loop i in [0..nkids(e)) {stack.push(kid(e i))}
    }
    0
}
# A refinement obligation at its use, with the contract's declaration span.
wit_refinement=(n:WitWord t:WitWord atom:RefAtom self:WitWord a:WitWord b:WitWord s:FactState refuted:bool):>void=>$unsafe {
    let shown=wit_text(WitWord(nodes.ptr[n].a))
    if shown =? "" {shown="the value"}
    let x=wit_ref_side(atom.a a n shown)
    let y=wit_ref_side(atom.b b n shown)
    let op=atom.op
    # Contracts are stored as `a < b`; show the constrained value first.
    if atom.b.kind =? 0 and atom.a.kind not=? 0 and (op =? 'lt' or op =? 'le') {
        let swap=x
        x=y
        y=swap
        op=if op =? 'lt' {Tok.gt} else {Tok.ge}
    }
    let relation=wit_relation_text(op x y)
    if refuted and ref_narrowing.has(n) {
        wit_help(relation)
        wit_fail(nodes.ptr[n].pos "{shown} does not fit {dt(ref_narrowing[n])}")
        return
    }
    let contract=ref_spans.get(WitWord(types.ptr[t].st)) ?? 0
    # (a shape contract: the parameter of the call this argument is for, and
    # its storage relation said as one, with no internal marker's bounds)
    let storage=false
    if nd_shape_predicates.has(WitWord(types.ptr[t].st)) {
        let call=wit_call_holding(n)
        let d=if call >? 0 and nodes.ptr[call].aux =? 0 and nodes.ptr[call].sym >? 0 {WitWord(fns.ptr[WitWord(nodes.ptr[call].sym)].decl)} else {0}
        if d not=? 0 and nodes.ptr[d].kind =? 'fn_' {
            loop i in [0..min(nkids(call) nkids(d))) {
                if kid(call i) =? n {contract=nodes.ptr[kid(d i)].pos}
            }
        }
        loop term in [atom.a atom.b] {
            if term.path.length =? 1 and term.path[0] =? ND_STORAGE_VALID {storage=true}
        }
    }
    if storage {relation="{shown}.data.length matches its shape"}
    # (a bound another parameter projects, `i:int64<(<? ring.values.length)>`: named by the callee)
    if relation =? "" {
        let call=wit_call_holding(n)
        if call >? 0 and nodes.ptr[call].aux =? 0 and nodes.ptr[call].sym >? 0 {
            let f=WitWord(nodes.ptr[call].sym)
            let at:WitWord=-1
            loop i in [0..nkids(call)) {
                if kid(call i) =? n {at=i}
            }
            let left=wit_formal_text(atom.a f at)
            let right=wit_formal_text(atom.b f at)
            if left not=? "" and right not=? "" {relation="{left} {wit_op(atom.op)} {right}"}
        }
    }
    let missing=if storage {""} else {wit_relation(s s op x y refuted)}
    if refuted {
        wit_context(contract)
        wit_help(relation)
        wit_fail(nodes.ptr[n].pos "refinement refuted: {shown} violates the declared contract")
        return
    }
    let what=if relation not=? "" {"refinement `{relation}`"} else {"refinement"}
    wit_unknown(n fact_bound(s self) what contract relation missing)
}
wit_formal_text=(term:RefTerm f:WitWord self:WitWord):>string=>$unsafe {
    let index=if term.kind =? 0 {self} else if term.kind =? 2 or term.kind =? 5 {term.value} else {-1}
    if term.kind =? 1 or term.kind =? 3 {return wit_ref_text(term "")}
    if f <=? 0 or index <? 0 or index >=? fns.ptr[f].params.length {return ""}
    let text=name_of(WitWord(locals.ptr[fns.ptr[f].params[index]].name))
    loop selector in term.path {
        if selector =? ND_STORAGE_VALID {text="{text} (data matches shape)"}
        else if selector =? -1 {text="{text}.length"}
        else if selector =? -2 {text="{text}.length.length"}
        else if selector <=? -3 {text="{text}.length[{-3 - selector}]"}
        else {text="{text}.{name_of(selector)}"}
    }
    "{text}{wit_offset_text(term.offset)}"
}
# A `$proof` precondition or exit proposition, named by the proof's formals.
wit_proof=(n:WitWord s:FactState atom:RefAtom a:WitWord b:WitWord f:WitWord self:WitWord refuted:bool what:string):>void=>$unsafe {
    let o=wit_orient(atom.op WitSide(a 0 wit_formal_text(atom.a f self) false atom.a.kind =? 1) WitSide(b 0 wit_formal_text(atom.b f self) false atom.b.kind =? 1))
    let relation=wit_relation_text(o[0] o[1] o[2])
    let missing=wit_relation(s s o[0] o[1] o[2] refuted)
    let contract=if f >? 0 and fns.ptr[f].decl not=? 0 {nodes.ptr[WitWord(fns.ptr[f].decl)].pos} else {0}
    if refuted {
        wit_context(contract)
        wit_help(relation false)
        wit_fail(nodes.ptr[n].pos "{what} refuted")
        return
    }
    let bounded=if wit_constant(s a) {b} else {a}
    wit_unknown(n fact_bound(s bounded) what contract relation missing false)
}

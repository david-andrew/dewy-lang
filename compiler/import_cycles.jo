use 'lower_helpers.dewy'
# Import cycles (docs/design/modules.md): a program runs as if its modules were
# one file. Modules outside a cycle initialize in import order (order_modules);
# a cycle containing a Dewy module merges its members' top-level statements into
# one init function, each statement after the other members' values it reads or writes.
# The same access summaries check single files, without moving their statements.
use 'checker_state.dewy'
use 'checker_tokens.dewy'
use 'check.jo'
use 'prelude.jo'
use 'ast.jo'
use 'util.jo'
use 'isolation.jo'
use 'lower.jo'
use 'isolation_ops.dewy'

cycle_groups: int[][]      # cyclic Dewy components, members in import order
cycle_merged: {int: int} = {}   # a member's former init function -> the merged one
ensuring_globals: int[]    # the globals whose first values are being checked, outermost first

# ---------------- components ----------------
tj_index: int[]
tj_low: int[]
tj_on: bool[]
tj_stack: int[]
tj_next = 0
tj_comps: int[][]




# ---------------- merging a cycle's top-level code ----------------
# What a statement accesses: (global, first use, called function) triples, directly
# or through known calls. Making a function value does not call it. Branches
# count even if not taken. Each function's transitive accesses are found once per
# program, on demand from initialization, and shared
# by its call graph component (Tarjan, as for modules), so the cost is one walk
# of the reachable code plus a union per call, not a walk per statement. An access
# through a call is placed at the statement's call, so the sets need no positions.
cr_member: bool[]    # per module: user initialization to check
cr_index: int[]      # per function: its visit number, -1 when not yet visited
cr_low: int[]
cr_on: bool[]
cr_stack: int[]
cr_next = 0
cr_comp: int[]       # per function: its component, an index into cr_sets
cr_events: int[][]   # per visit, retained for error-only witness search: the body's accesses (g) and calls (-f), in order
cr_sets: int[][]     # per component: the members' globals its functions access, transitively, first use first
cr_mark: int[]       # per global: the last cr_stamp that added it to a set
cr_stamp = 0
cr_taken: int[]      # per global: the last statement (cr_stmt) that took it
cr_stmt = 0
cr_decls: {int: bool}   # runtime global declarations
cr_targets: int[]      # global callable targets: -1 unknown, 0 opaque
cr_helpers = false    # user equality/hash calls exist
cr_owner = 0          # function being scanned, or 0 for a statement
cr_ev: int[]           # its events; nested visits save/restore this context
















# ---------------- values that need each other's first values ----------------


# The complete recursive Dewy reader. Jo enters only for a statement or a body.
# Context owns grammar state; typed services below do not re-enter the reader.
# rd_ distinguishes this implementation from the frozen seed group (rt_).
$runtime_checks
from p"dewy_builders.dewy" import ParserBuilderHost, db_type_name, db_value_name
from p"dewy_grammar.dewy" import dn_can_start, dn_directive_form, dn_double_closes, dn_juxt_excluded, dn_juxt_excluded_message, dn_juxtaposed, dn_operator_habit, dn_partial_operator, dn_power, dn_prefix_power, dn_range_bound, dn_right_associative, dw_chain_way, dw_designed_directive
from p"dewy_lex.dewy" import dn_quote_width
from p"dewy_parser.dewy" import ParserContext, dc_parser_hint, dc_parser_report, dc_parser_word
from p"dewy_reach.dewy" import dm_bound, dm_hide, dm_reach, dm_reach_all, dm_reach_flow, dm_reach_fn, dm_reach_head, dm_reach_in, dm_reach_match, dm_reach_statement, dm_reach_statements, dm_reach_type
from p"dewy_reader_host.dewy" import ParserReaderHost
from p"dewy_reader_types.dewy" import DirBundle, EffectKind, EffectSyntax, ResultClause
from p"dewy_scan.dewy" import dc_scan_arm_end, dc_scan_closing, dc_scan_cut
from p"dewy_syntax.dewy" import syntax_node
from p"dewy_tokens.dewy" import DewyKind, DewyLexeme, DewyToken, dn_token_assignment, dn_token_invert, dn_token_kind, dn_token_text, dn_token_undot, dn_token_uninvert
from p"dewy_walk.dewy" import dr_arms_kind, dr_block_tail_kind, dr_collect, dr_collect_block, dr_copy_last, dr_copy_value, dr_flow_arms, dr_kind_of, dr_last_kind, dr_push, dr_tail_kind
from p"literals.dewy" import LiteralProblem, literal_limbs, literal_packed, literal_string_text, literal_unsigned
from p"module_paths.dewy" import strip_ext
from p"node_store.dewy" import NK, Node, node_kids, node_kids2, node_mk, node_set_list, node_set_list2
from p"targets.dewy" import target_arches, target_names, target_os_of, target_oses
const AUX2_PARTIAL:int64=(-10)
const AUX2_PLACE:int64=(-11)
const DC_ADDR:int64=9
const DC_ALLOCATES:int64=13
const DC_ARRAY:int64=5
const DC_B:int64=2
const DC_BLOCKS:int64=14
const DC_DICT:int64=7
const DC_HOLE:int64=4
const DC_LAZY_BODY:int64=(-314)
const DC_LAZY_SPAN:int64=(-315)
const DC_LENGTH:int64=16
const DC_MAIN:int64=3
const DC_MUTATES:int64=12
const DC_NO_EFFECTS:int64=10
const DC_OVERFLOW:int64=17
const DC_P:int64=18
const DC_PANICS:int64=15
const DC_PTR:int64=6
const DC_READS:int64=11
const DC_SET:int64=1
const DC_TOTALDICT:int64=8
const DN_EDIT_BIGINT:int64=(-1099511627776)
const DN_EDIT_LIVE:int64=(-1125899906842624)
const DN_EDIT_METHODS:int64=(-36028797018963968)
const NF_AT:int64=2147483648
const NF_BROADCAST:int64=16384
const NF_COMPREHENSION:int64=67108864
const NF_DISCARD:int64=NF_SQUOTE
const NF_EXCL_FIRST:int64=536870912
const NF_EXTERN:int64=4
const NF_GENERIC:int64=64
const NF_INCLUSIVE:int64=2
const NF_INDEX_CAPTURED:int64=268435456
const NF_JUXT:int64=NF_EXCL_FIRST
const NF_LANG_BODY:int64=NF_LOOPCOUNT
const NF_LITERAL:int64=256
const NF_LOOPCOUNT:int64=33554432
const NF_MUT:int64=1
const NF_RDONLY:int64=262144
const NF_SPREAD:int64=1024
const NF_SQUOTE:int64=8
const NF_STEP:int64=32768
const NF_STMT:int64=16
const NF_U64:int64=2097152
const NF_VOID:int64=4194304
const NF_WRITTEN_VOID:int64=NF_INDEX_CAPTURED
const TUPLE_VALUES:int64=7

rd_add_flag=(@reader_nodes:array<Node> n:int64 f:int64):>void=>$unsafe {
    reader_nodes[n].flags = int32<overflow='wrap'>((int64<overflow='wrap'>(reader_nodes[n].flags) or f))
}

rd_bc_block=(@reader_ctx:ParserContext @reader_nodes:array<Node> stmts:array<int64> pos:int64):>int64=>$unsafe {
    let b:int64=node_mk(@reader_nodes 'block' pos)
    node_set_list(@reader_nodes @reader_ctx.stores.lists[0] b stmts);
    b
}

rd_bc_call=(@reader_ctx:ParserContext @reader_nodes:array<Node> name:string args:array<int64> pos:int64):>int64=>$unsafe {
    let c:int64=node_mk(@reader_nodes 'call' pos)
    reader_nodes[c].a = int32<overflow='wrap'>(rd_bc_ident(@reader_ctx @reader_nodes name pos))
    node_set_list(@reader_nodes @reader_ctx.stores.lists[0] c args);
    c
}

rd_bc_ident=(@reader_ctx:ParserContext @reader_nodes:array<Node> name:string pos:int64):>int64=>$unsafe {
    let n:int64=node_mk(@reader_nodes 'ident' pos)
    reader_nodes[n].name = int32<overflow='wrap'>(reader_ctx.stores.host[0].intern(name))
    n
}

rd_bc_int=(@reader_nodes:array<Node> v:int64 pos:int64):>int64=>$unsafe {
    let n:int64=node_mk(@reader_nodes 'int_lit' pos)
    reader_nodes[n].ival = v
    rd_add_flag(@reader_nodes n NF_LITERAL);
    n
}

rd_bc_stmt=(@reader_nodes:array<Node> e:int64 pos:int64):>int64=>$unsafe {
    let s:int64=node_mk(@reader_nodes 'exprstmt' pos)
    reader_nodes[s].a = int32<overflow='wrap'>(e)
    s
}

rd_bc_str=(@reader_ctx:ParserContext @reader_nodes:array<Node> s:string pos:int64):>int64=>$unsafe {
    let n:int64=node_mk(@reader_nodes 'str_lit' pos)
    reader_nodes[n].sval = int32<overflow='wrap'>(reader_ctx.stores.host[0].intern(s))
    n
}

rd_clear_flag=(@reader_nodes:array<Node> n:int64 f:int64):>void=>$unsafe {
    reader_nodes[n].flags = int32<overflow='wrap'>((int64<overflow='wrap'>(reader_nodes[n].flags) and (not f)))
}

rd_comp_ident=(@reader_nodes:array<Node> name:int64 pos:int64):>int64=>$unsafe {
    let n:int64=node_mk(@reader_nodes 'ident' pos)
    reader_nodes[n].name = int32<overflow='wrap'>(name)
    n
}

# A `;` ending this statement; in an unbraced body only one before `else` (`if c f(); else g()`,
# which the direct grammar has read as the body's own).
rd_dc_accept_semi=(@reader_ctx:ParserContext statement:bool):>bool=>$unsafe {
    if (statement or ((rd_dn_peek(@reader_ctx) =? 'semi') and (reader_ctx.tokens[(int64<overflow='wrap'>(reader_ctx.at) + 1)].symbol =? 'kw_else'))) {
        return rd_dn_accept_semi(@reader_ctx)
    }
    false
}

# `$allocator(@arena) expression` after its tag (dw_allocator); an arena not lent by its place is left
# unread (dc_unread).
rd_dc_allocator=(@reader_ctx:ParserContext @reader_nodes:array<Node> token:DewyLexeme):>int64=>$unsafe {
    let pos:int64=rd_mkpos(reader_ctx.file token.start)
    if (not rd_dn_accept(@reader_ctx 'lparen')) {
        return 0
    }
    # (`$allocator(scratch)`: dw_allocator's mistake)
    if (rd_dn_peek(@reader_ctx) not=? 'at') {
        if reader_ctx.flags.report_now {
            return rd_dc_fail_now(@reader_ctx rd_mkpos(reader_ctx.file reader_ctx.tokens[reader_ctx.at].start) "`$allocator` lends an arena by its place: `$allocator(@scratch) expression`")
        }
        return 0
    }
    let arena:int64=rd_dc_expr(@reader_ctx @reader_nodes 0)
    if ((arena =? 0) or (not rd_dn_accept(@reader_ctx 'rparen'))) {
        return 0
    }
    if (not (rd_has_flag(@reader_nodes arena NF_AT) or ((reader_nodes[arena].kind =? 'call') and ((reader_nodes[arena].aux2 =? int32<overflow='wrap'>(AUX2_PARTIAL)) or (reader_nodes[arena].aux2 =? int32<overflow='wrap'>(AUX2_PLACE)))))) {
        return 0
    }
    reader_ctx.stores.host[0].g_dw_allocators_set((int64<overflow='wrap'>(reader_ctx.stores.host[0].g_dw_allocators()) + 1))
    let serial:int64=reader_ctx.stores.host[0].g_dw_allocators()
    let first:int64=reader_ctx.at
    let body:int64=rd_dc_expr(@reader_ctx @reader_nodes 0)
    if (body =? 0) {
        return 0
    }
    # (arena_no_return's mistake, noted)
    let returned:int64=reader_ctx.stores.host[0].arena_return_at(body)
    if (returned not=? 0) {
        if (not reader_ctx.flags.report_now) {
            return 0
        }
        rd_dc_report(@reader_ctx reader_nodes[returned].pos "`return` inside an `$allocator` expression would leave it before its value is copied out of the arena: make the value the expression's result, and return after it");
    }
    reader_ctx.stores.host[0].arena_enable();
    # (a braced body's value is its last statement's, dw_copy_result)
    let copied:bool=(if (((reader_ctx.tokens[first].symbol =? 'lbrace') and (rd_dc_closing(@reader_ctx first) =? (int64<overflow='wrap'>(reader_ctx.at) - 1))) and (reader_nodes[body].kind =? 'block')) rd_dc_copy_last(@reader_ctx @reader_nodes body) else rd_dc_copy_value(@reader_ctx @reader_nodes body))
    reader_ctx.stores.host[0].dw_arena_scope(serial arena body copied pos)
}

# `[[x]:T]` at the `:`: noted, its type read; 0 when that type is left unread (dc_unread).
rd_dc_annotated_pattern=(@reader_ctx:ParserContext @reader_nodes:array<Node> pos:int64):>int64=>$unsafe {
    rd_dc_unsupported(@reader_ctx pos "an annotated nested pattern; annotate its names or the whole declaration");
    reader_ctx.at = (int64<overflow='wrap'>(reader_ctx.at) + 1)
    rd_dc_annotation(@reader_ctx @reader_nodes 45)
}

# Named, generic and optional annotations have a known type context. Other
# type forms are left unread (dc_unread) without mutating angle tokens.
rd_dc_annotation=(@reader_ctx:ParserContext @reader_nodes:array<Node> boundary:int64=10):>int64=>$unsafe {
    reader_ctx.depth = (int64<overflow='wrap'>(reader_ctx.depth) + 1)
    if ((int64<overflow='wrap'>(reader_ctx.depth) + int64<overflow='wrap'>(reader_ctx.reader.dn_depth)) >? 256) {
        return 0
    }
    let pos:int64=rd_mkpos(reader_ctx.file reader_ctx.tokens[reader_ctx.at].start)
    # `a|b|c` joins left to right; string members make one string set, the union's first
    # member (dw_literal_type).
    let n:int64=0
    let kind:DewyKind=reader_ctx.tokens[reader_ctx.at].kind
    let literal:bool=(((((kind =? 'quoted') or (kind =? 'rawquoted')) or (kind =? 'source_integer')) or (kind =? 'integer')) or ((reader_ctx.tokens[reader_ctx.at].symbol =? 'minus') and (rd_dc_int_leaf(@reader_ctx reader_ctx.at) >? 0)))
    if (not literal) {
        let start:int64=reader_ctx.at
        n = rd_dc_type_primary(@reader_ctx @reader_nodes)
        if (n =? 0) {
            # (`('b' | 'a') | none`: the members of every group, one union, dw_literal_type)
            if (not reader_ctx.reader.dc_grouped_literal) {
                return 0
            }
            reader_ctx.reader.dc_grouped_literal = false
            reader_ctx.at = start
            literal = true
        }
    }
    if (not literal) {
        let next:DewyToken=reader_ctx.tokens[reader_ctx.at].symbol
        if (((next =? 'star') or (next =? 'slash')) or (next =? 'caret')) {
            n = rd_dc_type_term_from(@reader_ctx @reader_nodes n pos)
            if (n =? 0) {
                return 0
            }
        }
        loop (rd_dn_peek(@reader_ctx) =? 'pipe') and (dn_power('pipe') >? boundary) {
            if (rd_dc_quoted_next(@reader_ctx (int64<overflow='wrap'>(reader_ctx.at) + 1)) or (rd_dc_int_leaf(@reader_ctx (int64<overflow='wrap'>(reader_ctx.at) + 1)) >? 0)) {
                literal = true
                break
            }
            reader_ctx.at = (int64<overflow='wrap'>(reader_ctx.at) + 1)
            let union_at:int64=reader_ctx.at
            let right:int64=rd_dc_type_term(@reader_ctx @reader_nodes)
            if (right =? 0) {
                if (not reader_ctx.reader.dc_grouped_literal) {
                    return 0
                }
                reader_ctx.reader.dc_grouped_literal = false
                reader_ctx.at = (int64<overflow='wrap'>(union_at) - 1)
                literal = true
                break
            }
            let union:int64=node_mk(@reader_nodes 'tunion' pos)
            node_set_list(@reader_nodes @reader_ctx.stores.lists[0] union [n right]);
            n = union
        }
        # (`int64 & ~0`: the type refined to leave the value out, dw_type's `& ~`)
        if (((((reader_ctx.tokens[reader_ctx.at].symbol =? 'amp') and (reader_ctx.tokens[(int64<overflow='wrap'>(reader_ctx.at) + 1)].symbol =? 'tilde')) and (not literal)) and (dn_power('amp') >? boundary)) and (reader_nodes[n].kind not=? 'tunion')) {
            reader_ctx.at = (int64<overflow='wrap'>(reader_ctx.at) + 2)
            let value:int64=rd_dc_expr(@reader_ctx @reader_nodes dn_prefix_power('tilde' false))
            if (value =? 0) {
                return 0
            }
            n = rd_dc_excluded(@reader_ctx @reader_nodes n value pos)
        }
    }
    if literal {
        n = rd_dc_literal_union(@reader_ctx @reader_nodes n boundary pos)
        if (n =? 0) {
            return 0
        }
    }
    if (((((dn_power(rd_dn_peek(@reader_ctx)) >? boundary) and (not (reader_ctx.reader.dc_effects_follow and (rd_dn_peek(@reader_ctx) =? 'amp')))) and (not (reader_ctx.reader.dc_rename_follows and (rd_dn_peek(@reader_ctx) =? 'kw_as')))) and (not ((reader_ctx.reader.dc_type_args >? 0) and rd_dc_closes(@reader_ctx)))) and (not rd_dc_annotation_ends(@reader_ctx))) {
        return 0
    }
    reader_ctx.depth = (int64<overflow='wrap'>(reader_ctx.depth) - 1)
    n
}

# What follows a type ends it though it is an operator: `7 as int8 -3`, a spaced sign before an
# unspaced operand starts the next operand; `t is? T,`, a comma ends an assertion's condition;
# `x as string ?? ""`, dc_expr's optional cast.
rd_dc_annotation_ends=(@reader_ctx:ParserContext):>bool=>$unsafe {
    let after:DewyLexeme=reader_ctx.tokens[reader_ctx.at]
    ((((after.symbol =? 'comma') and reader_ctx.flags.comma_stop) or ((((after.symbol =? 'minus') or (after.symbol =? 'plus')) and after.space) and (not reader_ctx.tokens[(int64<overflow='wrap'>(reader_ctx.at) + 1)].space))) or ((after.symbol =? 'coalesce') and reader_ctx.reader.dc_cast_coalesce))
}

# Arguments up to the closing bracket, positional or `name=value`.
rd_dc_arguments=(@reader_ctx:ParserContext @reader_nodes:array<Node> n:int64 close:DewyToken first:int64=0):>bool=>$unsafe {
    let args:array<int64>=[]
    if (first not=? 0) {
        args.push(first);
    }
    # (`f(xs...)`: a call's spread argument, dw_spread_item)
    let saved_spread:int64=reader_ctx.reader.dc_spread_depth
    let opener:int64=(int64<overflow='wrap'>(reader_ctx.at) - 1)
    loop (not rd_dn_accept(@reader_ctx close)) {
        let token:DewyLexeme=reader_ctx.tokens[reader_ctx.at]
        if (token.kind =? 'eof') {
            reader_ctx.reader.dc_spread_depth = saved_spread
            # (`f(1` and nothing after: dn_bracketed_from's mistake, should nothing else read it)
            rd_dc_hint(@reader_ctx rd_mkpos(reader_ctx.file reader_ctx.tokens[opener].start) "expected '{dn_token_text(close)}' before end of file");
            return false
        }
        if rd_dc_named_next(@reader_ctx) {
            reader_ctx.at = (int64<overflow='wrap'>(reader_ctx.at) + 2)
            reader_ctx.reader.dc_spread_depth = saved_spread
            let value:int64=rd_dc_expr(@reader_ctx @reader_nodes 11)
            if (value =? 0) {
                return false
            }
            let named:int64=node_mk(@reader_nodes 'namedarg' rd_mkpos(reader_ctx.file token.start))
            reader_nodes[named].name = token.name
            reader_nodes[named].a = int32<overflow='wrap'>(value)
            args.push(named);
            continue
        }
        reader_ctx.reader.dc_spread_depth = (int64<overflow='wrap'>(reader_ctx.depth) + 1)
        let start:int64=reader_ctx.at
        let arg:int64=rd_dc_expr(@reader_ctx @reader_nodes 0)
        if (arg =? 0) {
            reader_ctx.reader.dc_spread_depth = saved_spread
            if ((not reader_ctx.flags.report_now) or (not rd_dc_comma_arguments(@reader_ctx @reader_nodes start close @args))) {
                return false
            }
            node_set_list(@reader_nodes @reader_ctx.stores.lists[0] n args);
            return true
        }
        args.push(arg);
    }
    reader_ctx.reader.dc_spread_depth = saved_spread
    node_set_list(@reader_nodes @reader_ctx.stores.lists[0] n args);
    true
}

# `pattern => body`: an arm; an unbraced body ends where `=>`'s operand ends.
rd_dc_arm=(@reader_ctx:ParserContext @reader_nodes:array<Node>):>int64=>$unsafe {
    let first:DewyLexeme=reader_ctx.tokens[reader_ctx.at]
    let pattern:int64=rd_dc_pattern(@reader_ctx @reader_nodes)
    if (pattern =? 0) {
        return 0
    }
    if (not rd_dn_accept(@reader_ctx 'function')) {
        return rd_dc_arm_arrow(@reader_ctx first)
    }
    let arm:int64=node_mk(@reader_nodes 'arm' rd_mkpos(reader_ctx.file first.start))
    node_set_list(@reader_nodes @reader_ctx.stores.lists[0] arm [pattern]);
    let body:int64=rd_dc_operand_body(@reader_ctx @reader_nodes)
    if (body =? 0) {
        return 0
    }
    # (`n:int64 => total = n`: dw_arm_fail's mistake, noted; the value read on)
    if (((rd_dn_peek(@reader_ctx) =? 'assign') or dn_token_assignment(rd_dn_peek(@reader_ctx))) and reader_ctx.flags.report_now) {
        rd_dc_report(@reader_ctx reader_nodes[arm].pos "an arm whose body assigns needs braces, `pattern => \{target = value}`: `=` binds more loosely than `=>`, so without them the whole arm is the assignment's target");
        reader_ctx.at = (int64<overflow='wrap'>(reader_ctx.at) + 1)
        if (rd_dc_expr(@reader_ctx @reader_nodes 11) =? 0) {
            return 0
        }
    }
    if (not rd_dc_flow_ends(@reader_ctx)) {
        return 0
    }
    reader_nodes[arm].b = int32<overflow='wrap'>(body)
    arm
}

# `<1> -> 2`, `<1> 2`: a pattern without its `=>` (dw_arm_fail's mistake, should nothing else read
# it), the arm as written again when its body is one token.
rd_dc_arm_arrow=(@reader_ctx:ParserContext first:DewyLexeme):>int64=>$unsafe {
    let pos:int64=rd_mkpos(reader_ctx.file first.start)
    if (rd_dn_peek(@reader_ctx) =? 'arrow') {
        return rd_dc_hint(@reader_ctx pos "a match arm uses `=>`: replace `->` with `=>`")
    }
    if (not dn_can_start(@reader_ctx.tokens reader_ctx.at)) {
        return 0
    }
    let src:string=reader_ctx.source
    let body:DewyLexeme=reader_ctx.tokens[reader_ctx.at]
    let after:DewyLexeme=reader_ctx.tokens[(int64<overflow='wrap'>(reader_ctx.at) + 1)]
    if (body.newline or (not (((after.symbol =? 'rbrace') or after.newline) or (after.kind =? 'eof')))) {
        return rd_dc_hint(@reader_ctx pos "a match arm needs `=>` after its pattern")
    }
    let pattern:string=reader_ctx.stores.host[0].bytes_slice(src first.start reader_ctx.tokens[(int64<overflow='wrap'>(reader_ctx.at) - 1)].stop)
    let value:string=reader_ctx.stores.host[0].bytes_slice(src body.start body.stop)
    rd_dc_hint(@reader_ctx pos "a match arm needs `=>`: write `{pattern} => {value}`")
}

# Where an unbraced arm from token `at` ends, at bracket depth 0: before an `else` no `if` or
# `match` in it takes, a line that does not continue it, a closer, or the end.
rd_dc_arm_end=(@reader_ctx:ParserContext at:int64):>int64=>$unsafe {
    dc_scan_arm_end(@reader_ctx.tokens at)
}

rd_dc_arms_kind=(@reader_ctx:ParserContext @reader_nodes:array<Node> arms:array<int64>):>int64=>$unsafe {
    dr_arms_kind(@reader_ctx.collection @reader_nodes @reader_ctx.stores.lists[0] arms)
}

rd_dc_array_constraint=(@reader_ctx:ParserContext @reader_nodes:array<Node>):>int64=>$unsafe {
    rd_dc_unsupported(@reader_ctx rd_mkpos(reader_ctx.file reader_ctx.tokens[(int64<overflow='wrap'>(reader_ctx.at) - 2)].start) "array type constraints; use length=N or a length comparison");
    reader_ctx.reader.dn_angles = (int64<overflow='wrap'>(reader_ctx.reader.dn_angles) + 1)
    let value:int64=rd_dc_expr(@reader_ctx @reader_nodes (int64<overflow='wrap'>(dn_power('assign')) + 1))
    reader_ctx.reader.dn_angles = (int64<overflow='wrap'>(reader_ctx.reader.dn_angles) - 1)
    value
}

# An array literal after its `[`, through `]`: elements, a record's named fields and spreads, a
# dictionary's entries, or rows; other comprehensions and collectors are read
# elsewhere.
rd_dc_array_literal=(@reader_ctx:ParserContext @reader_nodes:array<Node> pos:int64):>int64=>$unsafe {
    let n:int64=node_mk(@reader_nodes 'array' pos)
    let saved:bool=reader_ctx.flags.comma_stop
    reader_ctx.flags.comma_stop = false
    let items:array<int64>=[]
    # (a row is a named field: the literal is a record)
    let named:bool=false
    # (an element neither spread nor named)
    let positional:bool=false
    # (`[1 2 ; 3 4]`: the row breaks after each element, dw_rows_literal)
    let breaks:array<int64>=[]
    let rows:bool=false
    # (`[f(); 7]`: the elements an attached `;` discards)
    let discards:array<int64>=[]
    # (where those of them whose discarding does nothing are written, dw_pure)
    let pure_at:array<int64>=[]
    # (where each element is written)
    let starts:array<int64>=[]
    # (the elements written as one parenthesized group: each one value, dw_collect)
    let grouped:array<int64>=[]
    let flows:bool=false
    let targets:int64=reader_ctx.reader.dc_targets_made
    loop (not rd_dn_accept(@reader_ctx 'rbrack')) {
        if (reader_ctx.tokens[reader_ctx.at].kind =? 'eof') {
            if reader_ctx.flags.report_now {
                rd_dc_unclosed(@reader_ctx pos "]");
            }
            return 0
        }
        if (rd_dn_peek(@reader_ctx) =? 'semi') {
            if (breaks.length =? 0) {
                # (`[; 1 2]`: dw_rows_literal's mistake, noted)
                if (not reader_ctx.flags.report_now) {
                    return 0
                }
                rd_dc_report(@reader_ctx rd_mkpos(reader_ctx.file reader_ctx.tokens[reader_ctx.at].start) "an array literal cannot start with `;`: a `;` ends a row, as in `[1 2 ; 3 4]`");
                reader_ctx.at = (int64<overflow='wrap'>(reader_ctx.at) + 1)
                continue
            }
            breaks[(int64<overflow='wrap'>(breaks.length) - 1)] = (int64<overflow='wrap'>(breaks[(int64<overflow='wrap'>(breaks.length) - 1)]) + 1)
            rows = true
            reader_ctx.at = (int64<overflow='wrap'>(reader_ctx.at) + 1)
            continue
        }
        # (`[x=1 y=2]`: a named field; methods are left unread (dc_unread))
        if rd_dc_named_next(@reader_ctx) {
            let field:DewyLexeme=reader_ctx.tokens[reader_ctx.at]
            if (rd_dn_reserved(@reader_ctx int64<overflow='wrap'>(field.name)) or (reader_nodes[n].kind =? 'map_lit')) {
                return 0
            }
            reader_ctx.at = (int64<overflow='wrap'>(reader_ctx.at) + 2)
            # (`[f=() => ...]`: a method, dw_method_row, when the function reaches a row)
            let method:bool=(rd_dc_lambda_next(@reader_ctx) or ((rd_dn_peek(@reader_ctx) =? 'langle') and rd_dc_generic_lambda_next(@reader_ctx)))
            let value:int64=rd_dc_expr(@reader_ctx @reader_nodes 11)
            if ((value =? 0) or (method not=? (reader_nodes[value].kind =? 'lambda'))) {
                return 0
            }
            let entry:int64=node_mk(@reader_nodes 'namedarg' rd_mkpos(reader_ctx.file field.start))
            reader_nodes[entry].name = field.name
            reader_nodes[entry].a = int32<overflow='wrap'>(value)
            items.push(entry);
            named = true
            continue
        }
        # (`[$field("answer")=42]`: a field named by a compile-time string, dw_field_name)
        if rd_dc_field_next(@reader_ctx) {
            let entry:int64=rd_dc_field_entry(@reader_ctx @reader_nodes)
            if ((entry =? 0) or (reader_nodes[n].kind =? 'map_lit')) {
                return 0
            }
            items.push(entry);
            named = true
            continue
        }
        # (a flow or block element may express several values or none: then the literal collects
        # them, dw_collector)
        let first:DewyToken=rd_dn_peek(@reader_ctx)
        if ((((first =? 'kw_if') or (first =? 'kw_loop')) or (first =? 'kw_match')) or (first =? 'lbrace')) {
            flows = true
        }
        # (`[xs... 1]`: an element spread; `["a" -> 1]`: a dictionary's entry)
        let item_start:int64=reader_ctx.tokens[reader_ctx.at].start
        let item_at:int64=reader_ctx.at
        let item:int64=0
        if (first =? 'kw_loop') {
            item = rd_dc_flow(@reader_ctx @reader_nodes)
            if ((item =? 0) or (not rd_dc_flow_ends(@reader_ctx))) {
                return 0
            }
        }
        else {
            let saved_spread:int64=reader_ctx.reader.dc_spread_depth
            reader_ctx.reader.dc_spread_depth = (int64<overflow='wrap'>(reader_ctx.depth) + 1)
            item = rd_dc_expr(@reader_ctx @reader_nodes 21)
            reader_ctx.reader.dc_spread_depth = saved_spread
        }
        if (item =? 0) {
            return 0
        }
        if ((first =? 'lparen') and (rd_dc_closing(@reader_ctx item_at) =? (int64<overflow='wrap'>(reader_ctx.at) - 1))) {
            grouped.push(items.length);
        }
        if (rd_dn_peek(@reader_ctx) =? 'arrow') {
            if (items.length =? 0) {
                reader_nodes[n].kind = 'map_lit'
            }
            if ((reader_nodes[n].kind not=? 'map_lit') or rd_has_flag(@reader_nodes item NF_SPREAD)) {
                return 0
            }
            reader_ctx.at = (int64<overflow='wrap'>(reader_ctx.at) + 1)
            let value:int64=rd_dc_expr(@reader_ctx @reader_nodes 21)
            if (value =? 0) {
                return 0
            }
            let pair:int64=node_mk(@reader_nodes 'pair' rd_mkpos(reader_ctx.file item_start))
            reader_nodes[pair].a = int32<overflow='wrap'>(item)
            reader_nodes[pair].b = int32<overflow='wrap'>(value)
            item = pair
        }
        else # (`["a" -> 1 2]`: dw_expr's mistake, should nothing else read it)
        if (reader_nodes[n].kind =? 'map_lit') {
            let extra:string=reader_ctx.stores.host[0].bytes_slice(reader_ctx.source item_start reader_ctx.tokens[(int64<overflow='wrap'>(reader_ctx.at) - 1)].stop)
            return rd_dc_hint(@reader_ctx rd_mkpos(reader_ctx.file item_start) "each dictionary item needs one `key -> value` pair; remove the extra `{extra}` or give it a key")
        }
        if (not rd_has_flag(@reader_nodes item NF_SPREAD)) {
            positional = true
        }
        # (an attached `;` discards the element: a collector, dw_collects; a pure value's is
        # warned of)
        if (((rd_dn_peek(@reader_ctx) =? 'semi') and (not reader_ctx.tokens[reader_ctx.at].space)) and (not reader_ctx.tokens[reader_ctx.at].newline)) {
            if (not rd_dc_discardable(@reader_ctx @reader_nodes item)) {
                if (not rd_dc_pure(@reader_nodes item)) {
                    return 0
                }
                pure_at.push(rd_mkpos(reader_ctx.file item_start));
            }
            reader_ctx.at = (int64<overflow='wrap'>(reader_ctx.at) + 1)
            discards.push(items.length);
        }
        items.push(item);
        starts.push(rd_mkpos(reader_ctx.file item_start));
        breaks.push(0)
    }
    reader_ctx.flags.comma_stop = saved
    let collects:bool=(discards.length >? 0)
    if ((pure_at.length >? 0) and (not rd_dc_pure_discards(@reader_ctx pure_at rows))) {
        return 0
    }
    if flows {
        loop i in 0.. and item in items {
            if (((not rd_has_flag(@reader_nodes item NF_SPREAD)) and (not (i in? grouped))) and rd_dc_multi(@reader_ctx @reader_nodes item)) {
                collects = true
            }
        }
    }
    if collects {
        if ((named and positional) and (not rows)) {
            return rd_dc_hint(@reader_ctx rd_dc_mixed_at(@reader_ctx @reader_nodes items starts) "Dewy does not yet support a record item without a field name and =")
        }
        if (((named or rows) or (reader_nodes[n].kind =? 'map_lit')) or (flows and (reader_ctx.reader.dc_targets_made not=? targets))) {
            return 0
        }
        return rd_dc_collector(@reader_ctx @reader_nodes items starts discards grouped pos)
    }
    # (a record's rows are named fields and spreads, dw_record_entry)
    if named {
        if ((positional and (not rows)) and reader_ctx.flags.report_now) {
            rd_dc_mixed_record(@reader_ctx @reader_nodes items starts);
        }
        else if (positional or rows) {
            return 0
        }
        reader_nodes[n].kind = 'record_lit'
        if (not rd_dc_literal_methods(@reader_ctx @reader_nodes items)) {
            return 0
        }
    }
    if rows {
        return rd_dc_rows(@reader_ctx @reader_nodes n items breaks pos)
    }
    node_set_list(@reader_nodes @reader_ctx.stores.lists[0] n items);
    return n
}

# `$assert condition`, `$runtime_assert condition, message`, or either with its arguments
# listed, `$assert(condition, "message")`: the statement calling the intrinsic, as
# dw_directive makes it. Other directives, settings and labels are left unread (dc_unread).
rd_dc_assert_alone=(@reader_ctx:ParserContext token:DewyLexeme runtime:bool):>int64=>$unsafe {
    let name:string="assert"
    if runtime {
        name = "runtime_assert"
    }
    reader_ctx.stores.host[0].dn_error(token.start "`${name}` needs a condition: `${name} condition` or `${name} condition, \"message\"`")
}

rd_dc_assertion=(@reader_ctx:ParserContext @reader_nodes:array<Node> token:DewyLexeme):>int64=>$unsafe {
    let source:string=reader_ctx.source
    let width:int64=(int64<overflow='wrap'>((int64<overflow='wrap'>(token.stop) - int64<overflow='wrap'>(token.start))) - 1)
    let runtime:bool=((width =? 14) and rd_dn_matches((source as array<uint8>).ptr (int64<overflow='wrap'>(token.start) + 1) token.stop "runtime_assert"))
    if ((not runtime) and (not ((width =? 6) and rd_dn_matches((source as array<uint8>).ptr (int64<overflow='wrap'>(token.start) + 1) token.stop "assert")))) {
        return 0
    }
    let pos:int64=rd_mkpos(reader_ctx.file token.start)
    reader_ctx.at = (int64<overflow='wrap'>(reader_ctx.at) + 1)
    let next:DewyLexeme=reader_ctx.tokens[reader_ctx.at]
    # (`$assert` alone: dn_directive's mistake)
    if (next.newline or (not dn_can_start(@reader_ctx.tokens reader_ctx.at))) {
        return rd_dc_assert_alone(@reader_ctx token runtime)
    }
    let listed:bool=((next.symbol =? 'lparen') and (not next.space))
    if listed {
        reader_ctx.at = (int64<overflow='wrap'>(reader_ctx.at) + 1)
    }
    let first:int64=reader_ctx.tokens[reader_ctx.at].start
    let saved:bool=reader_ctx.flags.comma_stop
    reader_ctx.flags.comma_stop = true
    let condition:int64=rd_dc_expr(@reader_ctx @reader_nodes 0)
    # (a range the condition does not take leaves the cursor at -1)
    if (condition =? 0) {
        reader_ctx.flags.comma_stop = saved
        return 0
    }
    let stop:int64=reader_ctx.tokens[(int64<overflow='wrap'>(reader_ctx.at) - 1)].stop
    let message:int64=0
    if ((condition not=? 0) and rd_dn_accept(@reader_ctx 'comma')) {
        let written:int64=reader_ctx.at
        message = rd_dc_expr(@reader_ctx @reader_nodes 0)
        # (an `$assert` message is a plain string literal: is left unread (dc_unread) others)
        if (((message not=? 0) and (not runtime)) and (((reader_ctx.at not=? (int64<overflow='wrap'>(written) + 1)) or (reader_nodes[message].kind not=? 'str_lit')) or (reader_nodes[message].aux not=? 0))) {
            # (dw_directive's mistake, noted)
            if reader_ctx.flags.report_now {
                rd_dc_report(@reader_ctx rd_mkpos(reader_ctx.file reader_ctx.tokens[written].start) "a `$assert` message is a string literal: the compiler reports it");
            }
            else {
                message = 0
            }
        }
        if (message =? 0) {
            condition = 0
        }
    }
    reader_ctx.flags.comma_stop = saved
    if (condition =? 0) {
        return 0
    }
    # (`$assert(1 <? 2` then `}`: dn_directive's mistake, should nothing else read it)
    if (listed and (not rd_dn_accept(@reader_ctx 'rparen'))) {
        return rd_dc_hint(@reader_ctx rd_mkpos(reader_ctx.file reader_ctx.tokens[reader_ctx.at].start) "expected ')'")
    }
    # (`$assert x >? 0;`: the statement ends, its value discarded, dw_stmt's statement end)
    let ended:bool=((rd_dn_peek(@reader_ctx) =? 'semi') and rd_dc_accept_semi(@reader_ctx (not reader_ctx.reader.dc_unbraced)))
    if ((not ended) and (not rd_dc_statement_ends(@reader_ctx))) {
        return 0
    }
    let args:array<int64>=[condition]
    if (message not=? 0) {
        args.push(message);
    }
    else if runtime {
        let text:int64=node_mk(@reader_nodes 'str_lit' pos)
        reader_nodes[text].sval = int32<overflow='wrap'>(reader_ctx.stores.host[0].intern("{"assertion failed: "}{reader_ctx.stores.host[0].join(reader_ctx.stores.host[0].words(reader_ctx.stores.host[0].bytes_slice(source first stop)) " ")}"))
        args.push(text);
    }
    let callee:int64=node_mk(@reader_nodes 'ident' pos)
    reader_nodes[callee].name = int32<overflow='wrap'>(reader_ctx.stores.host[0].intern((if runtime "$runtime_assert" else "$assert")))
    let call:int64=node_mk(@reader_nodes 'call' pos)
    reader_nodes[call].a = int32<overflow='wrap'>(callee)
    node_set_list(@reader_nodes @reader_ctx.stores.lists[0] call args);
    rd_dc_directive_statement(@reader_nodes call pos ended)
}

# `target op= value` (dw_stmt's assignment).
rd_dc_assign_node=(@reader_ctx:ParserContext @reader_nodes:array<Node> op0:DewyToken left:int64 right:int64 pos:int64):>int64=>$unsafe {
    let op:DewyToken=op0
    let n:int64=node_mk(@reader_nodes 'assign' pos)
    let scalar:DewyToken=dn_token_undot(op)
    if (scalar not=? 'none') {
        rd_add_flag(@reader_nodes n NF_BROADCAST);
        op = scalar
    }
    reader_nodes[n].op = int32<overflow='wrap'>(int64<overflow='wrap'>(rd_dn_assign_tok(op)))
    if ((op =? 'and_assign') or (op =? 'or_assign')) {
        reader_nodes[n].aux2 = 1
    }
    if ((((op =? 'slash_assign') or (op =? 'floor_assign')) or (op =? 'percent_assign')) or (op =? 'power_assign')) {
        reader_nodes[n].sval = int32<overflow='wrap'>(reader_ctx.stores.host[0].intern((if (op =? 'slash_assign') "__dewy_divide" else (if (op =? 'floor_assign') "__floor_div" else (if (op =? 'percent_assign') "__floor_mod" else "__dewy_power")))))
    }
    reader_nodes[n].a = int32<overflow='wrap'>(left)
    reader_nodes[n].b = int32<overflow='wrap'>(right)
    n
}

rd_dc_atom=(@reader_ctx:ParserContext @reader_nodes:array<Node>):>int64=>$unsafe {
    let token:DewyLexeme=reader_ctx.tokens[reader_ctx.at]
    let op:DewyToken=token.symbol
    let pos:int64=rd_mkpos(reader_ctx.file token.start)
    reader_ctx.at = (int64<overflow='wrap'>(reader_ctx.at) + 1)
    # (names first: the commonest atom)
    if ((token.kind =? 'identifier') and ((op =? 'none') or (op =? 'kw_test'))) {
        let name:int64=int64<overflow='wrap'>(token.name)
        # `xs[end]`: the index's last (dw_expr's `$index_end`), per axis
        if ((name =? reader_ctx.reader.dn_end_id) and (reader_ctx.reader.dc_index_node not=? 0)) {
            return rd_dc_index_end(@reader_ctx @reader_nodes pos)
        }
        # (`end` and `new` outside brackets: dw_expr's mistakes; the rest of the statement is read)
        if (((name =? reader_ctx.reader.dn_end_id) or (name =? reader_ctx.reader.dn_new_id)) or (name =? reader_ctx.reader.dn_type_id)) {
            return rd_dc_outside_index(@reader_ctx @reader_nodes name pos)
        }
        if (name =? reader_ctx.reader.dn_none_id) {
            return node_mk(@reader_nodes 'none_lit' pos)
        }
        let n:int64=node_mk(@reader_nodes 'ident' pos)
        reader_nodes[n].name = rd_dw_value_name(@reader_ctx token.name pos)
        return n
    }
    if (op =? 'kw_concurrent') {
        return rd_dc_concurrent(@reader_ctx @reader_nodes token false)
    }
    if (op =? 'kw_spawn') {
        return rd_dc_spawn(@reader_ctx @reader_nodes token)
    }
    # (`in + 1`: a word operator where a value starts is a name, dw_expr's identifier)
    if ((((((token.kind =? 'identifier') and (op not=? 'kw_not')) and (op not=? 'kw_and')) and (op not=? 'kw_or')) and rd_dc_word_operator(op)) and reader_ctx.flags.report_now) {
        return rd_dc_word_name(@reader_ctx @reader_nodes token pos)
    }
    if (token.kind =? 'source_integer') {
        let source:string=reader_ctx.source
        let bytes:ptr<uint8>=(source as array<uint8>).ptr
        let first:int64=token.start
        if ((((int64<overflow='wrap'>(first) + 1) <? token.stop) and (bytes[first] =? b'0')) and (bytes[(int64<overflow='wrap'>(first) + 1)] =? b'd')) {
            first = (int64<overflow='wrap'>(first) + 2)
        }
        let value:uint64=0
        let wide:bool=false
        loop k in [first..token.stop) {
            let c:uint8=bytes[k]
            if (c =? b'_') {
                continue
            }
            let digit:uint64=uint64<overflow='wrap'>((uint8<overflow='wrap'>(c) - uint8<overflow='wrap'>(b'0')))
            if (value >? ((uint64<overflow='wrap'>(uint64(9223372036854775807)) - uint64<overflow='wrap'>(digit)) // 10)) {
                wide = true
                break
            }
            value = (uint64<overflow='wrap'>((uint64<overflow='wrap'>(value) * 10)) + uint64<overflow='wrap'>(digit))
        }
        if wide {
            return rd_dc_wide_integer(@reader_ctx @reader_nodes token pos)
        }
        let n:int64=node_mk(@reader_nodes 'int_lit' pos)
        reader_nodes[n].ival = (value transmute int64)
        rd_add_flag(@reader_nodes n NF_LITERAL);
        return n
    }
    if (token.kind =? 'integer') {
        return rd_dc_wide_integer(@reader_ctx @reader_nodes token pos)
    }
    # `0x"0a0b"`: the bytes a based string spells (dw_binary)
    if (token.kind =? 'based_string') {
        return rd_dc_based_string(@reader_ctx @reader_nodes token pos)
    }
    if (token.kind =? 'source_real') {
        let fast:float64?=rd_dc_short_real(@reader_ctx token)
        if (fast isnt? none) {
            let n:int64=node_mk(@reader_nodes 'float_lit' pos)
            reader_nodes[n].fval = fast
            reader_nodes[n].sval = int32<overflow='wrap'>(reader_ctx.stores.host[0].intern_sub(reader_ctx.source token.start (int64<overflow='wrap'>(token.stop) - int64<overflow='wrap'>(token.start))))
            rd_add_flag(@reader_nodes n NF_LITERAL);
            return n
        }
        return rd_dc_long_real(@reader_ctx @reader_nodes token pos)
    }
    # (`x in? ..b`, `x in? ..`: an open range, dw_iterable's)
    if ((op =? 'range') and (reader_ctx.reader.dc_member_depth =? reader_ctx.depth)) {
        reader_ctx.at = (int64<overflow='wrap'>(reader_ctx.at) - 1)
        return rd_dc_member_range(@reader_ctx @reader_nodes pos)
    }
    # `[0..n)`, `[1,4..11]`, `(a..b]`: a range value (dw_range_value); in a membership, the range
    # itself, which may be open (`x in? [..0]`, dw_membership)
    if (((((op =? 'lbrack') or (op =? 'lparen')) and (rd_dn_peek(@reader_ctx) not=? 'kw_loop')) and (rd_dn_peek(@reader_ctx) not=? 'kw_parallel')) and rd_dc_range_inside(@reader_ctx (int64<overflow='wrap'>(reader_ctx.at) - 1))) {
        let range:int64=rd_dc_range_atom(@reader_ctx @reader_nodes)
        if (range >=? 0) {
            return range
        }
    }
    if (op =? 'lparen') {
        let after:DewyToken=rd_dn_peek(@reader_ctx)
        if (dn_partial_operator(after) or ((after =? 'kw_not') and (dn_token_invert(reader_ctx.tokens[(int64<overflow='wrap'>(reader_ctx.at) + 1)].symbol) not=? 'none'))) {
            return rd_dc_partial(@reader_ctx @reader_nodes token)
        }
        return rd_dc_group(@reader_ctx @reader_nodes pos)
    }
    # `if c a else b` and `match` as values; loops and `$target` chains are left unread (dc_unread)
    if ((op =? 'kw_if') or (op =? 'kw_match')) {
        reader_ctx.at = (int64<overflow='wrap'>(reader_ctx.at) - 1)
        return rd_dc_flow(@reader_ctx @reader_nodes)
    }
    if ((op =? 'kw_loop') and reader_ctx.flags.report_now) {
        return rd_dc_loop_value(@reader_ctx @reader_nodes pos)
    }
    # `$unsafe expression`: the boundary holds over the expression (dw_unsafe_scope)
    if (token.kind =? 'metatag') {
        let tagged:int64=rd_dc_metatag_atom(@reader_ctx @reader_nodes token pos)
        if (tagged >=? 0) {
            return tagged
        }
        if (not rd_dc_unsafe_at(@reader_ctx (int64<overflow='wrap'>(reader_ctx.at) - 1))) {
            return rd_dc_tag_unread(@reader_ctx token pos)
        }
        let operand:int64=rd_dc_expr(@reader_ctx @reader_nodes 0)
        if (operand =? 0) {
            return 0
        }
        rd_dc_unsafe_scope(@reader_ctx pos);
        return operand
    }
    # `@x` selects a place; `@f(a)` partially evaluates f
    if (op =? 'at') {
        let operand:int64=reader_ctx.at
        let e:int64=rd_dc_expr(@reader_ctx @reader_nodes 160)
        if (e =? 0) {
            return 0
        }
        # (`@(m.lock())`: the operand is one group, whose call takes the place it returns)
        if (((reader_nodes[e].kind =? 'call') and (reader_ctx.tokens[operand].symbol =? 'lparen')) and (rd_dc_closing(@reader_ctx operand) =? (int64<overflow='wrap'>(reader_ctx.at) - 1))) {
            reader_nodes[e].aux2 = int32<overflow='wrap'>(AUX2_PLACE)
        }
        else if (reader_nodes[e].kind =? 'call') {
            reader_nodes[e].aux2 = int32<overflow='wrap'>(AUX2_PARTIAL)
        }
        else {
            rd_add_flag(@reader_nodes e (NF_MUT or NF_AT));
        }
        return e
    }
    # `{ ... }`: a block whose value is its last statement's (dw_block)
    if (op =? 'lbrace') {
        reader_ctx.at = (int64<overflow='wrap'>(reader_ctx.at) - 1)
        return rd_dc_body(@reader_ctx @reader_nodes)
    }
    # `[loop i in xs f(i)]`: a comprehension
    if ((op =? 'lbrack') and (rd_dn_peek(@reader_ctx) =? 'kw_loop')) {
        return rd_dc_comprehension(@reader_ctx @reader_nodes)
    }
    if ((op =? 'lbrack') and (rd_dn_peek(@reader_ctx) =? 'kw_parallel')) {
        let region:int64=rd_dc_parallel(@reader_ctx @reader_nodes rd_dn_take(@reader_ctx) true)
        if ((region =? 0) or (not rd_dn_accept(@reader_ctx 'rbrack'))) {
            return 0
        }
        return region
    }
    # `[a b c]`, `[x=1 y=2]`, `["a" -> 1]`, `[base... x=1]`, `[1 2 ; 3 4]`
    if (op =? 'lbrack') {
        return rd_dc_array_literal(@reader_ctx @reader_nodes pos)
    }
    # `.-xs`: elementwise negation (dw_expr's prefix)
    if ((op =? 'dot_minus') or (op =? 'dot_plus')) {
        let e:int64=rd_dc_expr(@reader_ctx @reader_nodes dn_prefix_power(op false))
        if (e =? 0) {
            return 0
        }
        let n:int64=node_mk(@reader_nodes 'unary' pos)
        reader_nodes[n].op = int32<overflow='wrap'>(int64<overflow='wrap'>((if (op =? 'dot_minus') 59 else 58)))
        reader_nodes[n].a = int32<overflow='wrap'>(e)
        rd_add_flag(@reader_nodes n NF_BROADCAST);
        return n
    }
    # `~x`: `not x` at a tighter precedence (dw_expr's prefix)
    if (op =? 'tilde') {
        let e:int64=rd_dc_expr(@reader_ctx @reader_nodes dn_prefix_power(op false))
        if (e =? 0) {
            return 0
        }
        let n:int64=node_mk(@reader_nodes 'not_' pos)
        reader_nodes[n].op = int32<overflow='wrap'>(int64<overflow='wrap'>(int64(58)))
        reader_nodes[n].a = int32<overflow='wrap'>(e)
        return n
    }
    if (((op =? 'plus') or (op =? 'minus')) or (op =? 'kw_not')) {
        let e:int64=rd_dc_expr(@reader_ctx @reader_nodes dn_prefix_power(op false))
        if (e =? 0) {
            return 0
        }
        if (((op =? 'minus') and (reader_nodes[e].kind =? 'int_lit')) and (reader_nodes[e].aux2 =? 0)) {
            if (rd_has_flag(@reader_nodes e NF_U64) and (reader_nodes[e].ival not=? (int64<overflow='wrap'>(int64(-9223372036854775807)) - 1))) {
                let magnitude:uint64=uint64<overflow='wrap'>(reader_nodes[e].ival)
                return rd_dc_bigint_value(@reader_ctx [(magnitude and 0xFFFFFFFF) (magnitude >> 32)] pos true)
            }
            reader_nodes[e].ival = (-int64<overflow='wrap'>(reader_nodes[e].ival))
            reader_nodes[e].pos = pos
            reader_nodes[e].aux2 = 1
            rd_clear_flag(@reader_nodes e NF_U64);
            return e
        }
        if ((op =? 'minus') and (reader_nodes[e].kind =? 'float_lit')) {
            reader_nodes[e].fval = (-reader_nodes[e].fval)
            if (reader_nodes[e].sval not=? 0) {
                reader_nodes[e].sval = int32<overflow='wrap'>(reader_ctx.stores.host[0].intern("{"-"}{rd_name_of(@reader_ctx int64<overflow='wrap'>(reader_nodes[e].sval))}"))
            }
            reader_nodes[e].pos = pos
            return e
        }
        let n:int64=node_mk(@reader_nodes (if (op =? 'kw_not') 'not_' else 'unary') pos)
        reader_nodes[n].op = int32<overflow='wrap'>(int64<overflow='wrap'>((if (op =? 'minus') 59 else 58)))
        reader_nodes[n].a = int32<overflow='wrap'>(e)
        return n
    }
    if ((token.kind =? 'quoted') or (token.kind =? 'rawquoted')) {
        return rd_dn_string(@reader_ctx @reader_nodes token)
    }
    if (token.kind =? 'boolean') {
        let n:int64=node_mk(@reader_nodes 'bool_lit' pos)
        reader_nodes[n].ival = (if (int64<overflow='wrap'>(token.name) =? reader_ctx.reader.dn_true_id) int64(1) else int64(0))
        return n
    }
    if (reader_ctx.flags.report_now and ((token.kind =? 'op') or (token.kind =? 'eof'))) {
        return rd_dc_atom_mistake(@reader_ctx token)
    }
    rd_dc_atom_unread(@reader_ctx token pos)
}

# A token no value starts with (dn_atom's mistakes, at once); 0 for one read as another form.
rd_dc_atom_mistake=(@reader_ctx:ParserContext token:DewyLexeme):>int64=>$unsafe {
    let symbol:DewyToken=token.symbol
    if (token.kind =? 'eof') {
        return reader_ctx.stores.host[0].dn_error(token.start "expected an expression")
    }
    if (((((((((((((symbol =? 'ellipsis') or (symbol =? 'lparen')) or (symbol =? 'lbrack')) or (symbol =? 'lbrace')) or (symbol =? 'langle')) or (symbol =? 'tilde')) or (symbol =? 'plus')) or (symbol =? 'minus')) or (symbol =? 'dot_plus')) or (symbol =? 'dot_minus')) or (symbol =? 'at')) or (symbol =? 'kw_not')) or (symbol =? 'range')) {
        return 0
    }
    let text:string=rd_dn_payload(@reader_ctx token)
    let after_colon:bool=((symbol =? 'colon') or ((reader_ctx.at >=? 2) and (reader_ctx.tokens[(int64<overflow='wrap'>(reader_ctx.at) - 2)].symbol =? 'colon')))
    # (`(from:int64)`, `let loop = 1`: a keyword where a name was meant)
    if (((((symbol =? 'colon') or (symbol =? 'assign')) and (reader_ctx.at >=? 2)) and (reader_ctx.tokens[(int64<overflow='wrap'>(reader_ctx.at) - 2)].symbol not=? 'none')) and (not reader_ctx.tokens[(int64<overflow='wrap'>(reader_ctx.at) - 1)].newline)) {
        let word:string=dn_token_text(reader_ctx.tokens[(int64<overflow='wrap'>(reader_ctx.at) - 2)].symbol)
        let named:bool=((symbol =? 'assign') or ((reader_ctx.tokens[(int64<overflow='wrap'>(reader_ctx.at) - 2)].stop =? token.start) and (not (word in? ["else" "loop" "if" "match"]))))
        if (((named and ((word as array<uint8>).length >? 0)) and ((word as array<uint8>)[0] >=? b'a')) and ((word as array<uint8>)[0] <=? b'z')) {
            return reader_ctx.stores.host[0].dn_error(reader_ctx.tokens[(int64<overflow='wrap'>(reader_ctx.at) - 2)].start "`{word}` is a keyword, so it cannot name a variable, parameter or field: choose another name")
        }
    }
    if (after_colon and ((symbol =? 'colon') or (symbol =? 'rbrack'))) {
        return reader_ctx.stores.host[0].dn_error(token.start "expected an expression, found '{text}' (a slice is a range in the brackets: `xs[1..]`, `xs[..n)`, `xs[a..b)`; `xs.reversed()` reverses; `:` gives a type)")
    }
    # (`x := 1`: a binding written as another language declares one)
    if (((((symbol =? 'assign') and (reader_ctx.at >=? 3)) and (reader_ctx.tokens[(int64<overflow='wrap'>(reader_ctx.at) - 2)].symbol =? 'colon')) and (reader_ctx.tokens[(int64<overflow='wrap'>(reader_ctx.at) - 2)].stop =? token.start)) and (reader_ctx.tokens[(int64<overflow='wrap'>(reader_ctx.at) - 3)].kind =? 'identifier')) {
        let bound:string=rd_dn_payload(@reader_ctx reader_ctx.tokens[(int64<overflow='wrap'>(reader_ctx.at) - 3)])
        reader_ctx.stores.host[0].dn_error(reader_ctx.tokens[(int64<overflow='wrap'>(reader_ctx.at) - 3)].start "a new local binding uses `let {bound} = value`; an existing binding uses `{bound} = value`");
    }
    let habit:string=dn_operator_habit(@reader_ctx.tokens reader_ctx.at text)
    reader_ctx.stores.host[0].dn_error(token.start "expected an expression, found '{text}'{habit}")
}

# (`1 +` then `return 0`: a keyword statement as an operator's operand, dw_expr's mistake, should
# nothing else read it)
rd_dc_atom_unread=(@reader_ctx:ParserContext token:DewyLexeme pos:int64):>int64=>$unsafe {
    let op:DewyToken=token.symbol
    if (((((((op =? 'kw_return') or (op =? 'kw_break')) or (op =? 'kw_continue')) or (op =? 'kw_let')) or (op =? 'kw_const')) and (reader_ctx.at >=? 2)) and (dn_power(reader_ctx.tokens[(int64<overflow='wrap'>(reader_ctx.at) - 2)].symbol) >? 0)) {
        rd_dc_hint(@reader_ctx pos "expected a value after `{rd_dn_payload(@reader_ctx reader_ctx.tokens[(int64<overflow='wrap'>(reader_ctx.at) - 2)])}`; `{rd_dn_payload(@reader_ctx token)}` begins a statement");
    }
    0
}

rd_dc_axes=(@reader_ctx:ParserContext @reader_nodes:array<Node> n:int64 first:int64 first_range:int64):>bool=>$unsafe {
    let args:array<int64>=[]
    let mark:int64=reader_ctx.reader.dc_axis_ranges.length
    if (first not=? 0) {
        args.push(first);
        reader_ctx.reader.dc_axis_ranges.push(first_range);
    }
    loop (not rd_dn_accept(@reader_ctx 'rbrack')) {
        let token:DewyLexeme=reader_ctx.tokens[reader_ctx.at]
        if (token.kind =? 'eof') {
            return rd_dc_axes_end(@reader_ctx mark false)
        }
        reader_nodes[n].aux2 = int32<overflow='wrap'>(args.length)
        reader_ctx.reader.dc_range_call = 0
        if rd_dc_named_next(@reader_ctx) {
            reader_ctx.at = (int64<overflow='wrap'>(reader_ctx.at) + 2)
            let value:int64=rd_dc_expr(@reader_ctx @reader_nodes 11)
            if (value =? 0) {
                return rd_dc_axes_end(@reader_ctx mark false)
            }
            let named:int64=node_mk(@reader_nodes 'namedarg' rd_mkpos(reader_ctx.file token.start))
            reader_nodes[named].name = token.name
            reader_nodes[named].a = int32<overflow='wrap'>(value)
            args.push(named);
            reader_ctx.reader.dc_axis_ranges.push(0);
            continue
        }
        if rd_dc_whole_axis(@reader_ctx) {
            let whole:int64=node_mk(@reader_nodes 'range' rd_mkpos(reader_ctx.file reader_ctx.tokens[(int64<overflow='wrap'>(reader_ctx.at) + 1)].start))
            reader_ctx.at = (int64<overflow='wrap'>(reader_ctx.at) + 3)
            args.push(whole);
            reader_ctx.reader.dc_axis_ranges.push(whole);
            continue
        }
        let saved_axis:int64=reader_ctx.reader.dc_axis_depth
        reader_ctx.reader.dc_axis_depth = (int64<overflow='wrap'>(reader_ctx.depth) + 1)
        let open_before:int64=reader_ctx.reader.dc_open_axes
        let arg:int64=rd_dc_expr(@reader_ctx @reader_nodes 0)
        reader_ctx.reader.dc_axis_depth = saved_axis
        if ((arg =? 0) or ((reader_ctx.reader.dc_open_axes not=? open_before) and (reader_ctx.reader.dc_range_call not=? arg))) {
            return rd_dc_axes_end(@reader_ctx mark false)
        }
        args.push(arg);
        let slice:int64=0
        if (reader_ctx.reader.dc_range_call =? arg) {
            slice = reader_ctx.reader.dc_range_node
        }
        reader_ctx.reader.dc_axis_ranges.push(slice);
    }
    # (a whole axis alone, `xs[[..]]`, is an array literal is left unread (dc_unread))
    if (((args.length =? 1) and (reader_nodes[args[0]].kind =? 'range')) and (reader_ctx.reader.dc_axis_ranges[mark] =? args[0])) {
        return rd_dc_axes_end(@reader_ctx mark false)
    }
    if (args.length >? 1) {
        loop i in [0..args.length) {
            if (reader_ctx.reader.dc_axis_ranges[(int64<overflow='wrap'>(mark) + int64<overflow='wrap'>(i))] not=? 0) {
                args[i] = reader_ctx.reader.dc_axis_ranges[(int64<overflow='wrap'>(mark) + int64<overflow='wrap'>(i))]
            }
        }
    }
    node_set_list(@reader_nodes @reader_ctx.stores.lists[0] n args);
    rd_dc_axes_end(@reader_ctx mark true)
}

rd_dc_axes_end=(@reader_ctx:ParserContext mark:int64 read:bool):>bool=>$unsafe {
    reader_ctx.reader.dc_axis_ranges.truncate(mark);
    read
}

# `0x"0a0b"`: the bytes a based string spells (dw_binary).
rd_dc_based_string=(@reader_ctx:ParserContext @reader_nodes:array<Node> token:DewyLexeme pos:int64):>int64=>$unsafe {
    let problem:LiteralProblem=LiteralProblem[message="" at=0 unsupported=false]
    let packed:array<uint8>=literal_packed(@problem rd_dn_payload(@reader_ctx token))
    # (dw_literal_problem's mistakes, noted)
    if ((problem.message as array<uint8>).length >? 0) {
        if (not reader_ctx.flags.report_now) {
            return 0
        }
        if problem.unsupported {
            rd_dc_unsupported(@reader_ctx pos problem.message);
        }
        else {
            rd_dc_report(@reader_ctx pos problem.message);
        }
    }
    let text:int64=node_mk(@reader_nodes 'str_lit' pos)
    reader_nodes[text].sval = int32<overflow='wrap'>(reader_ctx.stores.host[0].intern(reader_ctx.stores.host[0].str_from_bytes(packed)))
    let callee:int64=node_mk(@reader_nodes 'ident' pos)
    reader_nodes[callee].name = int32<overflow='wrap'>(reader_ctx.stores.host[0].intern("bytes"))
    let call:int64=node_mk(@reader_nodes 'call' pos)
    reader_nodes[call].a = int32<overflow='wrap'>(callee)
    node_set_list(@reader_nodes @reader_ctx.stores.lists[0] call [text]);
    call
}

# dw_bigint_value, its module's bigint import asked for undoably: a retry that discards the
# literal discards the request with it (dn_edits_undo).
rd_dc_bigint_value=(@reader_ctx:ParserContext limbs:array<uint64> pos:int64 negative:bool):>int64=>$unsafe {
    if (reader_ctx.stores.host[0].g_dw_bigint_import() =? 0) {
        reader_ctx.reader.dn_edit_at.push(DN_EDIT_BIGINT);
        reader_ctx.reader.dn_edit_was.push(reader_ctx.tokens[(int64<overflow='wrap'>(reader_ctx.at) - 1)]);
    }
    reader_ctx.stores.host[0].dw_bigint_value(limbs pos negative)
}

rd_dc_binary=(@reader_ctx:ParserContext @reader_nodes:array<Node> op:DewyToken left:int64 right:int64 pos:int64):>int64=>$unsafe {
    let scalar:DewyToken=dn_token_uninvert(op)
    if (scalar not=? op) {
        let inner:int64=rd_dc_binary(@reader_ctx @reader_nodes scalar left right pos)
        if (inner =? 0) {
            return 0
        }
        let n:int64=node_mk(@reader_nodes 'not_' pos)
        reader_nodes[n].a = int32<overflow='wrap'>(inner)
        return n
    }
    if ((((op =? 'slash') or (op =? 'floor')) or (op =? 'percent')) or (op =? 'caret')) {
        let k:int64=(if (op =? 'slash') int64(0) else (if (op =? 'caret') int64(1) else (if (op =? 'floor') int64(2) else int64(3))))
        let callee:int64=node_mk(@reader_nodes 'ident' pos)
        reader_nodes[callee].name = int32<overflow='wrap'>(rd_dc_builtin(@reader_ctx k))
        let n:int64=node_mk(@reader_nodes 'call' pos)
        reader_nodes[n].a = int32<overflow='wrap'>(callee)
        node_set_list(@reader_nodes @reader_ctx.stores.lists[0] n [left right]);
        return n
    }
    let token:int64=rd_dc_binary_token(op)
    if (token =? 0) {
        return 0
    }
    let n:int64=node_mk(@reader_nodes (if (op =? 'kw_and') 'and_' else (if (op =? 'kw_or') 'or_' else 'binary')) pos)
    reader_nodes[n].op = int32<overflow='wrap'>(int64<overflow='wrap'>(token))
    reader_nodes[n].a = int32<overflow='wrap'>(left)
    reader_nodes[n].b = int32<overflow='wrap'>(right)
    n
}

rd_dc_binary_token=(op:DewyToken):>int64=>$unsafe {
    match op {
        <'plus'> => {
            58
        }
        <'minus'> => {
            59
        }
        <'star' | 'multiply_apply'> => {
            60
        }
        <'eq'> => {
            69
        }
        <'contains'> => {
            12
        }
        <'lt'> => {
            71
        }
        <'le'> => {
            72
        }
        <'gt'> => {
            73
        }
        <'ge'> => {
            74
        }
        <'shl'> => {
            67
        }
        <'shr'> => {
            68
        }
        <'kw_and' | 'amp'> => {
            63
        }
        <'kw_or' | 'pipe'> => {
            64
        }
        <'kw_xor'> => {
            65
        }
        _ => {
            0
        }
    }
}

# A parameter's name bound once among the function's (`_` any number of times).
rd_dc_bind_once=(@reader_ctx:ParserContext @bound:dict<int64 bool> named:int64):>bool=>$unsafe {
    if ((named =? 0) or (rd_dc_word(@reader_ctx named) =? DC_HOLE)) {
        return true
    }
    if bound.has(named) {
        return false
    }
    bound[named] = true
    true
}

# The names of an unpacking pattern after its `[`, through its `]` (dw_binding_items): names,
# `_`, nested patterns, a name's type (`x:int64`), a rest (`...rest`) or a drop (`...`); empty for
# any other item (a renaming, a default), which is left unread (dc_unread).
rd_dc_binding_items=(@reader_ctx:ParserContext @reader_nodes:array<Node> @seen:array<int64> close:DewyToken='rbrack'):>array<int64>=>$unsafe {
    let out:array<int64>=[]
    let opening:int64=(int64<overflow='wrap'>(reader_ctx.at) - 1)
    let rests:int64=0
    # (the next name collects what the others leave)
    let rest:bool=false
    # (the last item takes a postfix `...`: a name or a nested pattern)
    let plain:bool=true
    let last_pos:int64=0
    loop (not rd_dn_accept(@reader_ctx close)) {
        let t:DewyLexeme=reader_ctx.tokens[reader_ctx.at]
        let pos:int64=rd_mkpos(reader_ctx.file t.start)
        if (t.symbol =? 'ellipsis') {
            let next:DewyLexeme=reader_ctx.tokens[(int64<overflow='wrap'>(reader_ctx.at) + 1)]
            if (rest or (not plain)) {
                return []
            }
            if (out.length =? 0) {
                # (opening the pattern: dn_atom's `...` before a name or the closer)
                if ((close =? 'rbrack') and (not ((next.symbol =? 'rbrack') or (next.kind =? 'identifier')))) {
                    return []
                }
                if ((close =? 'rparen') and (not ((next.symbol =? 'rparen') or ((next.kind =? 'identifier') and (((reader_ctx.tokens[(int64<overflow='wrap'>(reader_ctx.at) + 2)].symbol =? 'colon') or (reader_ctx.tokens[(int64<overflow='wrap'>(reader_ctx.at) + 2)].kind =? 'identifier')) or (reader_ctx.tokens[(int64<overflow='wrap'>(reader_ctx.at) + 2)].symbol =? 'rparen')))))) {
                    return []
                }
            }
            rests = (int64<overflow='wrap'>(rests) + 1)
            # (dw_binding_items' mistake, noted)
            if (rests >? 1) {
                if (not reader_ctx.flags.report_now) {
                    return []
                }
                rd_dc_report(@reader_ctx pos "a pattern level has one `...`: the rest is what the other names leave");
            }
            reader_ctx.at = (int64<overflow='wrap'>(reader_ctx.at) + 1)
            if ((not next.space) and (next.kind =? 'identifier')) {
                rest = true
                continue
            }
            if ((next.symbol not=? close) and (not next.space)) {
                return []
            }
            # (a drop: at the `...` opening the pattern, else at the item it follows)
            let hole:int64=node_mk(@reader_nodes 'hole' (if (out.length =? 0) pos else last_pos))
            rd_add_flag(@reader_nodes hole NF_SPREAD);
            out.push(hole);
            plain = false
            continue
        }
        # (`banana as [x y]`: the field banana unpacked, dw_binding_one)
        let renamed:int64=0
        if (((((t.kind =? 'identifier') and (t.symbol =? 'none')) and (reader_ctx.tokens[(int64<overflow='wrap'>(reader_ctx.at) + 1)].symbol =? 'kw_as')) and (reader_ctx.tokens[(int64<overflow='wrap'>(reader_ctx.at) + 2)].symbol =? 'lbrack')) and (not rd_dn_reserved(@reader_ctx int64<overflow='wrap'>(t.name)))) {
            if rest {
                return []
            }
            renamed = int64<overflow='wrap'>(t.name)
            reader_ctx.at = (int64<overflow='wrap'>(reader_ctx.at) + 2)
            t = reader_ctx.tokens[reader_ctx.at]
            pos = rd_mkpos(reader_ctx.file t.start)
        }
        if (t.symbol =? 'lbrack') {
            if rest {
                return []
            }
            reader_ctx.at = (int64<overflow='wrap'>(reader_ctx.at) + 1)
            let pattern:int64=node_mk(@reader_nodes 'tuple' pos)
            if (renamed not=? 0) {
                reader_nodes[pattern].sval = int32<overflow='wrap'>(renamed)
            }
            let inner:array<int64>=rd_dc_binding_items(@reader_ctx @reader_nodes @seen)
            if (inner.length =? 0) {
                return []
            }
            node_set_list(@reader_nodes @reader_ctx.stores.lists[0] pattern inner);
            out.push(pattern);
            plain = true
            last_pos = pos
            # (`[[x]:array<int64>]`: dw_binding_one's mistake, noted; the type read)
            if ((((rd_dn_peek(@reader_ctx) =? 'colon') and (close =? 'rbrack')) and reader_ctx.flags.report_now) and (rd_dc_annotated_pattern(@reader_ctx @reader_nodes pos) =? 0)) {
                return []
            }
            continue
        }
        if ((t.kind not=? 'identifier') or (t.symbol not=? 'none')) {
            return []
        }
        # (the mistakes dw_binding_one reports: a default, a reserved word)
        if ((reader_ctx.tokens[(int64<overflow='wrap'>(reader_ctx.at) + 1)].symbol =? 'assign') and (not reader_ctx.tokens[(int64<overflow='wrap'>(reader_ctx.at) + 1)].space)) {
            reader_ctx.stores.host[0].fatal(pos "`=` in a pattern is reserved for defaults, which are not implemented; rename a field with `as`: `[field as name] = record`");
        }
        if rd_dn_reserved(@reader_ctx int64<overflow='wrap'>(t.name)) {
            reader_ctx.stores.host[0].dewy_reserved_name(rd_name_of(@reader_ctx int64<overflow='wrap'>(t.name)) pos);
            return []
        }
        reader_ctx.at = (int64<overflow='wrap'>(reader_ctx.at) + 1)
        let annotation:int64=0
        if (rd_dn_peek(@reader_ctx) =? 'colon') {
            reader_ctx.at = (int64<overflow='wrap'>(reader_ctx.at) + 1)
            let saved_rename:bool=reader_ctx.reader.dc_rename_follows
            reader_ctx.reader.dc_rename_follows = true
            annotation = rd_dc_annotation(@reader_ctx @reader_nodes 45)
            reader_ctx.reader.dc_rename_follows = saved_rename
            if (annotation =? 0) {
                return []
            }
        }
        # `apple as a`, `apple:int64 as a`: the field apple bound as a (dw_binding_one's renaming)
        let source:int64=0
        if (rd_dn_peek(@reader_ctx) =? 'kw_as') {
            let target:DewyLexeme=reader_ctx.tokens[(int64<overflow='wrap'>(reader_ctx.at) + 1)]
            if (((rest or (target.kind not=? 'identifier')) or (target.symbol not=? 'none')) or rd_dn_reserved(@reader_ctx int64<overflow='wrap'>(target.name))) {
                return []
            }
            source = int64<overflow='wrap'>(t.name)
            t = target
            pos = rd_mkpos(reader_ctx.file t.start)
            reader_ctx.at = (int64<overflow='wrap'>(reader_ctx.at) + 2)
        }
        let after:DewyLexeme=reader_ctx.tokens[reader_ctx.at]
        # (`[a... b]`: dw_binding_items' mistake, noted; read as a drop)
        if ((((((after.symbol =? 'ellipsis') and (not after.space)) and (annotation =? 0)) and (source =? 0)) and (not rest)) and reader_ctx.flags.report_now) {
            rd_dc_report(@reader_ctx pos "in a pattern, the rest is written before its name: `[first ...{rd_dn_payload(@reader_ctx t)}]` (`...` alone drops it)");
            after = reader_ctx.tokens[(int64<overflow='wrap'>(reader_ctx.at) + 1)]
            if (after.space or (after.symbol =? close)) {
                reader_ctx.at = (int64<overflow='wrap'>(reader_ctx.at) + 1)
            }
        }
        if ((not after.space) and (after.symbol not=? close)) {
            return []
        }
        let hole:bool=(rd_dc_word(@reader_ctx int64<overflow='wrap'>(t.name)) =? DC_HOLE)
        if (not hole) {
            if (int64<overflow='wrap'>(t.name) in? seen) {
                if (source =? 0) {
                    reader_ctx.stores.host[0].fatal(pos "duplicate unpacking name '{rd_name_of(@reader_ctx int64<overflow='wrap'>(t.name))}'");
                }
                return []
            }
            seen.push(int64<overflow='wrap'>(t.name));
        }
        let n:int64=node_mk(@reader_nodes (if hole 'hole' else 'ident') pos)
        reader_nodes[n].name = t.name
        reader_nodes[n].a = int32<overflow='wrap'>(annotation)
        if (source not=? 0) {
            reader_nodes[n].sval = int32<overflow='wrap'>(source)
        }
        if rest {
            rd_add_flag(@reader_nodes n NF_SPREAD);
        }
        rest = false
        out.push(n);
        plain = ((annotation =? 0) and (source =? 0))
        last_pos = pos
    }
    if rest {
        return []
    }
    if ((out.length =? 0) or (((out.length =? 1) and (reader_nodes[out[0]].kind =? 'hole')) and rd_has_flag(@reader_nodes out[0] NF_SPREAD))) {
        return rd_dc_binds_nothing(@reader_ctx @reader_nodes out opening close)
    }
    out
}

# `[]`, `[...]`: a pattern binding nothing (dw_binding_items' mistakes, noted; the pattern kept).
rd_dc_binds_nothing=(@reader_ctx:ParserContext @reader_nodes:array<Node> out:array<int64> opening:int64 close:DewyToken):>array<int64>=>$unsafe {
    if ((not reader_ctx.flags.report_now) or (close not=? 'rbrack')) {
        return []
    }
    let pos:int64=rd_mkpos(reader_ctx.file reader_ctx.tokens[opening].start)
    if (out.length =? 0) {
        rd_dc_unsupported(@reader_ctx pos "an empty unpacking target");
        return [node_mk(@reader_nodes 'hole' pos)]
    }
    rd_dc_report(@reader_ctx pos "this pattern binds nothing: to run the value and drop it, attach `;`, as in `f();`");
    out
}

# `$setting` or `$setting=true|false` alone as a block's statement: 1 on, 0 off; -1 when it is not
# that (dc_parser.at stays).
rd_dc_block_setting=(@reader_ctx:ParserContext):>int64=>$unsafe {
    let at:int64=(int64<overflow='wrap'>(reader_ctx.at) + 1)
    let value:int64=1
    if (reader_ctx.tokens[at].symbol =? 'assign') {
        let written:DewyLexeme=reader_ctx.tokens[(int64<overflow='wrap'>(at) + 1)]
        if (written.kind not=? 'boolean') {
            # (`$prototype=1`: dw_dir_boolean's mistake, reported once the statement is read)
            if ((not reader_ctx.flags.report_now) or (not rd_dc_lone_value(@reader_ctx (int64<overflow='wrap'>(at) + 1)))) {
                return (-1)
            }
            rd_dc_report(@reader_ctx rd_mkpos(reader_ctx.file written.start) "`${rd_dn_payload(@reader_ctx reader_ctx.tokens[reader_ctx.at])}` takes a literal true or false");
        }
        else if (int64<overflow='wrap'>(written.name) not=? reader_ctx.reader.dn_true_id) {
            value = 0
        }
        at = (int64<overflow='wrap'>(at) + 2)
    }
    let next:DewyLexeme=reader_ctx.tokens[at]
    if ((next.kind not=? 'eof') and (next.symbol not=? 'rbrace')) {
        if ((((((dn_power(next.symbol) >? 0) or (next.symbol =? 'kw_not')) or (next.symbol =? 'dot')) or (next.symbol =? 'question')) or (next.symbol =? 'ellipsis')) or (next.symbol =? 'semi')) {
            return (-1)
        }
        if (((not next.space) and (not next.newline)) and (((((next.symbol =? 'lparen') or (next.symbol =? 'lbrack')) or (next.symbol =? 'langle')) or (next.kind =? 'quoted')) or (next.kind =? 'rawquoted'))) {
            return (-1)
        }
    }
    reader_ctx.at = at
    value
}

rd_dc_block_tail_kind=(@reader_ctx:ParserContext @reader_nodes:array<Node> block:int64):>int64=>$unsafe {
    dr_block_tail_kind(@reader_nodes @reader_ctx.stores.lists[0] block)
}

# A flow body is a statement block even when its braces are omitted. These
# functions participate in the enclosing construction transaction: an unknown
# head, label, declaration or expression is left unread (dc_unread).
rd_dc_body=(@reader_ctx:ParserContext @reader_nodes:array<Node>):>int64=>$unsafe {
    # (`=> $unsafe { ... }`: the boundary covers the block, which stays the body itself, dw_block)
    if (((reader_ctx.tokens[reader_ctx.at].kind =? 'metatag') and (reader_ctx.tokens[(int64<overflow='wrap'>(reader_ctx.at) + 1)].symbol =? 'lbrace')) and rd_dc_unsafe_at(@reader_ctx reader_ctx.at)) {
        let opening:DewyLexeme=reader_ctx.tokens[reader_ctx.at]
        reader_ctx.at = (int64<overflow='wrap'>(reader_ctx.at) + 1)
        let n:int64=rd_dc_body(@reader_ctx @reader_nodes)
        if ((n =? 0) or (not rd_dc_flow_ends(@reader_ctx))) {
            return 0
        }
        rd_dc_unsafe_scope(@reader_ctx rd_mkpos(reader_ctx.file opening.start));
        return n
    }
    let saved:bool=reader_ctx.reader.dc_unbraced
    reader_ctx.reader.dc_unbraced = (rd_dn_peek(@reader_ctx) not=? 'lbrace')
    let n:int64=rd_dc_body_read(@reader_ctx @reader_nodes)
    reader_ctx.reader.dc_unbraced = saved
    n
}

# A metatag opening a braced body's statement: a setting (dc_settings), a labelled loop or a
# mistake dc_body_tag notes, 1 (read); 0 for a directive, -1 a form left unread (dc_unread).
rd_dc_body_metatag=(@reader_ctx:ParserContext @reader_nodes:array<Node> @statements:array<int64>):>int64=>$unsafe {
    let tag:DewyLexeme=reader_ctx.tokens[reader_ctx.at]
    let name:string=rd_dn_payload(@reader_ctx tag)
    # (`$include_bytes(p"asset") as name`: a statement, dc_include_binding)
    if ((dn_directive_form(name) not=? 0) or (name =? "include_bytes")) {
        return 0
    }
    if reader_ctx.stores.host[0].dw_dir_name(name) {
        let value:int64=rd_dc_block_setting(@reader_ctx)
        if (value <? 0) {
            return (-1)
        }
        reader_ctx.reader.dc_settings.push(name);
        reader_ctx.reader.dc_setting_values.push(value);
        reader_ctx.reader.dc_setting_at.push(rd_mkpos(reader_ctx.file tag.start));
        return 1
    }
    # (`$build.mode = ...`: a mistake in a body, dc_statement's dc_body_setting)
    if (((name =? "target") or (name =? "build")) and (reader_ctx.tokens[rd_dc_setting_place_end(@reader_ctx reader_ctx.at)].symbol =? 'assign')) {
        return 0
    }
    let mistake:int64=rd_dc_body_tag(@reader_ctx name tag)
    if (mistake not=? 0) {
        return mistake
    }
    reader_ctx.at = (int64<overflow='wrap'>(reader_ctx.at) + 1)
    let statement:int64=rd_dc_statement(@reader_ctx @reader_nodes)
    if (statement =? 0) {
        return (-1)
    }
    let k:NK=reader_nodes[statement].kind
    if (((k not=? 'loopx') and (k not=? 'for_')) and (k not=? 'while_')) {
        return (-1)
    }
    reader_nodes[statement].sval = int32<overflow='wrap'>(reader_ctx.stores.host[0].intern(name))
    statements.push(statement);
    1
}

rd_dc_body_read=(@reader_ctx:ParserContext @reader_nodes:array<Node>):>int64=>$unsafe {
    reader_ctx.reader.dc_top_level = false
    # (a braced body is a block of statements, an unbraced one the statement alone: dn_expr's depth)
    let braced:bool=(rd_dn_peek(@reader_ctx) =? 'lbrace')
    if braced {
        reader_ctx.depth = (int64<overflow='wrap'>(reader_ctx.depth) + 1)
    }
    if ((int64<overflow='wrap'>(reader_ctx.depth) + int64<overflow='wrap'>(reader_ctx.reader.dn_depth)) >? 256) {
        return 0
    }
    let pos:int64=rd_mkpos(reader_ctx.file reader_ctx.tokens[reader_ctx.at].start)
    reader_ctx.at = (int64<overflow='wrap'>(reader_ctx.at) + int64<overflow='wrap'>((if braced int64(1) else int64(0))))
    let n:int64=node_mk(@reader_nodes 'block' pos)
    let statements:array<int64>=[]
    let last_start:int64=reader_ctx.at
    let settings:int64=reader_ctx.reader.dc_settings.length
    loop true {
        if (braced and rd_dn_accept(@reader_ctx 'rbrace')) {
            break
        }
        if (reader_ctx.tokens[reader_ctx.at].kind =? 'eof') {
            if (braced and reader_ctx.flags.report_now) {
                rd_dc_unclosed(@reader_ctx pos "}");
            }
            return 0
        }
        let start:int64=reader_ctx.at
        last_start = start
        if (braced and reader_ctx.flags.unread_here) {
            reader_ctx.status.hint_pos = 0
        }
        let node_start:int64=reader_nodes.length
        let list_start:int64=reader_ctx.stores.lists[0].length
        let depth:int64=reader_ctx.depth
        let edits:int64=reader_ctx.reader.dn_edit_at.length
        # `$runtime_checks`, `$no_nan=false`: a setting holding throughout the block, wherever
        # written (dw_dir_block); `$outer loop ...`: a loop's label (dw_block)
        if ((reader_ctx.tokens[reader_ctx.at].kind =? 'metatag') and braced) {
            let tagged:int64=rd_dc_body_metatag(@reader_ctx @reader_nodes @statements)
            if (tagged <? 0) {
                return 0
            }
            if (tagged >? 0) {
                continue
            }
        }
        # (`$field(name)=value` ending a record comprehension's body: a row, dc_record_loop)
        if (reader_ctx.reader.dc_map_ok and rd_dc_field_next(@reader_ctx)) {
            let entry:int64=rd_dc_field_entry(@reader_ctx @reader_nodes)
            if (entry =? 0) {
                return 0
            }
            let statement:int64=node_mk(@reader_nodes 'exprstmt' reader_nodes[entry].pos)
            reader_nodes[statement].a = int32<overflow='wrap'>(entry)
            statements.push(statement);
            if (not braced) {
                break
            }
            continue
        }
        reader_ctx.reader.dc_splice_ok = true
        let statement:int64=rd_dc_statement(@reader_ctx @reader_nodes)
        # `if $target.os =? "windows" { ... } else { ... }`: the compiled arm's statements, here
        # (dw_target_splice)
        if (((statement not=? 0) and (reader_ctx.reader.dc_live_at =? start)) and (reader_ctx.tokens[start].symbol =? 'kw_if')) {
            loop spliced in node_kids(@reader_nodes @reader_ctx.stores.lists[0] statement) {
                statements.push(spliced);
            }
            if (not braced) {
                break
            }
            continue
        }
        if (statement =? 0) {
            let value:int64=0
            if ((reader_ctx.reader.dc_value_start =? start) and (reader_ctx.reader.dc_value not=? 0)) {
                value = reader_ctx.reader.dc_value
                reader_ctx.depth = depth
            }
            else {
                reader_ctx.at = start
                reader_nodes.truncate(node_start);
                reader_ctx.stores.lists[0].truncate(list_start);
                rd_dn_edits_undo(@reader_ctx edits);
                # A failed expression may leave the recursion counter elevated.
                reader_ctx.depth = depth
                value = rd_dc_expr(@reader_ctx @reader_nodes 0)
                reader_ctx.depth = depth
                # (a chain whose compiled arm is spliced is no value here)
                if (((value not=? 0) and (reader_ctx.reader.dc_live_at =? start)) and (reader_ctx.tokens[start].symbol =? 'kw_if')) {
                    value = 0
                }
            }
            reader_ctx.reader.dc_value = 0
            reader_ctx.reader.dc_value_start = (-1)
            # (`key -> value` ending a dictionary comprehension's body: an entry, dc_collect)
            if (((value not=? 0) and reader_ctx.reader.dc_map_ok) and (rd_dn_peek(@reader_ctx) =? 'arrow')) {
                reader_ctx.at = (int64<overflow='wrap'>(reader_ctx.at) + 1)
                let entry:int64=rd_dc_expr(@reader_ctx @reader_nodes 21)
                if (entry =? 0) {
                    value = 0
                }
                else {
                    let pair:int64=node_mk(@reader_nodes 'pair' rd_mkpos(reader_ctx.file reader_ctx.tokens[start].start))
                    reader_nodes[pair].a = int32<overflow='wrap'>(value)
                    reader_nodes[pair].b = int32<overflow='wrap'>(entry)
                    value = pair
                    reader_ctx.reader.dc_pairs_made = (int64<overflow='wrap'>(reader_ctx.reader.dc_pairs_made) + 1)
                }
            }
            if (value =? 0) {
                # (in a module function's braced body, a statement read no way is reported here;
                # elsewhere the enclosing reading gives up, dc_unread)
                if ((braced and reader_ctx.flags.unread_here) and (reader_ctx.tokens[start].kind not=? 'metatag')) {
                    rd_dc_unread(@reader_ctx start);
                }
                return 0
            }
            let at:int64=rd_mkpos(reader_ctx.file reader_ctx.tokens[start].start)
            if rd_dc_accept_semi(@reader_ctx braced) {
                statement = node_mk(@reader_nodes 'assign' at)
                reader_nodes[statement].op = int32<overflow='wrap'>(int64<overflow='wrap'>(int64(47)))
                reader_nodes[statement].a = int32<overflow='wrap'>(node_mk(@reader_nodes 'hole' at))
                reader_nodes[statement].b = int32<overflow='wrap'>(value)
            }
            else {
                # (`$unsafe f()`: the statement is its operand's, dw_stmt)
                if rd_dc_unsafe_at(@reader_ctx start) {
                    at = rd_mkpos(reader_ctx.file reader_ctx.tokens[(int64<overflow='wrap'>(start) + 1)].start)
                }
                statement = node_mk(@reader_nodes 'exprstmt' at)
                reader_nodes[statement].a = int32<overflow='wrap'>(value)
            }
        }
        statements.push(statement);
        if (not braced) {
            break
        }
    }
    # (a block whose last statement is tagged: dc_collect leaves it unread)
    if ((statements.length >? 0) and (reader_ctx.tokens[last_start].kind =? 'metatag')) {
        reader_ctx.collection.tagged_last[n] = true
    }
    if (reader_ctx.reader.dc_settings.length >? settings) {
        # (through its closing brace: its last syntax node is the last position inside, dw_dir_last)
        reader_ctx.collection.tagged_last[n] = true
        let end_:int64=rd_mkpos(reader_ctx.file reader_ctx.tokens[(int64<overflow='wrap'>(reader_ctx.at) - 1)].start)
        loop i in [settings..reader_ctx.reader.dc_settings.length) {
            rd_dc_scope_undoable(@reader_ctx);
            reader_ctx.stores.host[0].dw_dir_apply(reader_ctx.reader.dc_settings[i] reader_ctx.reader.dc_setting_values[i] reader_ctx.reader.dc_setting_at[i] pos end_ false);
        }
        reader_ctx.reader.dc_settings.truncate(settings);
        reader_ctx.reader.dc_setting_values.truncate(settings);
        reader_ctx.reader.dc_setting_at.truncate(settings);
    }
    node_set_list(@reader_nodes @reader_ctx.stores.lists[0] n statements);
    if braced {
        reader_ctx.depth = (int64<overflow='wrap'>(reader_ctx.depth) - 1)
    }
    n
}

# `$build.mode = ...` in a body (dw_stmt's mistake, noted): the value read on.
rd_dc_body_setting=(@reader_ctx:ParserContext @reader_nodes:array<Node> place_stop:int64):>int64=>$unsafe {
    rd_dc_report(@reader_ctx rd_mkpos(reader_ctx.file reader_ctx.tokens[reader_ctx.at].start) "`{rd_dc_setting_text(@reader_ctx place_stop)}` is set at the top level of the program's main file, on a line of its own");
    reader_ctx.at = (int64<overflow='wrap'>(place_stop) + 1)
    rd_dc_expr(@reader_ctx @reader_nodes 0)
}

# A metatag in a body that is no setting: 0 for a loop's label (`$outer loop ...`); a mistake
# noted, once the block is read (1, the tag and an `=` read): `$shadowable` or `$supported_targets`
# (dw_metatag_fail), a label before no loop (dw_label_fail); -1 a form left unread (dc_unread).
rd_dc_body_tag=(@reader_ctx:ParserContext name:string tag:DewyLexeme):>int64=>$unsafe {
    if (((name =? "shadowable") or (name =? "supported_targets")) and reader_ctx.flags.report_now) {
        if (name =? "shadowable") {
            rd_dc_report(@reader_ctx rd_mkpos(reader_ctx.file tag.start) "`$shadowable` marks a module-level const: `$shadowable const name = ...` at the top of the file");
        }
        else {
            rd_dc_report(@reader_ctx rd_mkpos(reader_ctx.file tag.start) "`$supported_targets` is a module directive; put it at file scope");
        }
        reader_ctx.at = (int64<overflow='wrap'>(reader_ctx.at) + 1)
        rd_dn_accept(@reader_ctx 'assign');
        return 1
    }
    # (`$capture`, `$unsafe_assume ...` in a body: dw_metatag_fail's and dw_unimplemented's mistakes)
    if (((name =? "capture") or rd_dc_unbuilt(name)) and reader_ctx.flags.report_now) {
        return (int64<overflow='wrap'>(rd_dc_fail_now(@reader_ctx rd_mkpos(reader_ctx.file tag.start) reader_ctx.stores.host[0].metatag_fail_text(name))) - 1)
    }
    if (((((((name =? "target") or (name =? "build")) or (name =? "capture")) or (name =? "include_bytes")) or (name =? "shadowable")) or (name =? "supported_targets")) or dw_designed_directive(name)) {
        return (-1)
    }
    let next:DewyLexeme=reader_ctx.tokens[(int64<overflow='wrap'>(reader_ctx.at) + 1)]
    if (next.symbol =? 'kw_loop') {
        return 0
    }
    # (a label is a tag alone: one an expression goes on from is no label)
    if (((not reader_ctx.flags.report_now) or (dn_power(next.symbol) >? 0)) or ((((not next.space) and (not next.newline)) and (next.kind not=? 'eof')) and (next.symbol not=? 'rbrace'))) {
        return (-1)
    }
    if (name =? "explicit_allocation_failure") {
        rd_dc_report(@reader_ctx rd_mkpos(reader_ctx.file tag.start) "`$explicit_allocation_failure` is a module directive; put it at file scope, at the top");
    }
    else {
        rd_dc_report(@reader_ctx rd_mkpos(reader_ctx.file tag.start) "a loop label must be followed by a loop (`${name}` is not a directive)");
    }
    reader_ctx.at = (int64<overflow='wrap'>(reader_ctx.at) + 1)
    1
}

# The names a pattern binds (dw_bound_names).
rd_dc_bound=(@reader_ctx:ParserContext @reader_nodes:array<Node> bindings:array<int64> @out:array<int64>):>void=>$unsafe {
    dm_bound(@reader_nodes @reader_ctx.stores.lists[0] bindings @out);
}

# `$breakpoint` alone (dn_directive's form 3, dw_directive): the call showing the live bindings.
rd_dc_breakpoint=(@reader_ctx:ParserContext @reader_nodes:array<Node> token:DewyLexeme):>int64=>$unsafe {
    let pos:int64=rd_mkpos(reader_ctx.file token.start)
    reader_ctx.at = (int64<overflow='wrap'>(reader_ctx.at) + 1)
    let ended:bool=((rd_dn_peek(@reader_ctx) =? 'semi') and rd_dc_accept_semi(@reader_ctx (not reader_ctx.reader.dc_unbraced)))
    if ((not ended) and (not rd_dc_statement_ends(@reader_ctx))) {
        return 0
    }
    rd_dc_directive_statement(@reader_nodes rd_bc_call(@reader_ctx @reader_nodes "$breakpoint" [] pos) pos ended)
}

# An elementwise operator's node (dw_broadcast): 0 for one is left unread (dc_unread).
rd_dc_broadcast=(@reader_ctx:ParserContext @reader_nodes:array<Node> op:DewyToken a:int64 b:int64 pos:int64):>int64=>$unsafe {
    if ((((op =? 'slash') or (op =? 'floor')) or (op =? 'percent')) or (op =? 'caret')) {
        let k:int64=(if (op =? 'slash') int64(0) else (if (op =? 'caret') int64(1) else (if (op =? 'floor') int64(2) else int64(3))))
        let callee:int64=node_mk(@reader_nodes 'ident' pos)
        reader_nodes[callee].name = int32<overflow='wrap'>(rd_dc_builtin(@reader_ctx k))
        let n:int64=node_mk(@reader_nodes 'call' pos)
        reader_nodes[n].a = int32<overflow='wrap'>(callee)
        node_set_list(@reader_nodes @reader_ctx.stores.lists[0] n [a b]);
        rd_add_flag(@reader_nodes n NF_BROADCAST);
        return n
    }
    let spelling:DewyToken=dn_token_uninvert(op)
    if (not ((((((((spelling =? 'plus') or (spelling =? 'minus')) or (spelling =? 'star')) or (spelling =? 'eq')) or (spelling =? 'lt')) or (spelling =? 'le')) or (spelling =? 'gt')) or (spelling =? 'ge'))) {
        return 0
    }
    let n:int64=node_mk(@reader_nodes 'binary' pos)
    reader_nodes[n].op = int32<overflow='wrap'>(int64<overflow='wrap'>(int64(85)))
    reader_nodes[n].aux = int32<overflow='wrap'>((dn_token_text(spelling) as array<uint8>)[0])
    reader_nodes[n].aux2 = (if ((spelling =? 'le') or (spelling =? 'ge')) int32(1) else int32(0))
    reader_nodes[n].ival = (if (spelling not=? op) 1 else 0)
    reader_nodes[n].a = int32<overflow='wrap'>(a)
    reader_nodes[n].b = int32<overflow='wrap'>(b)
    n
}

# `$build.debug`, `$build.opt`: syntax_target_field's mistake (false for `mode`).
rd_dc_build_member=(@reader_ctx:ParserContext member:DewyLexeme pos:int64):>bool=>$unsafe {
    let text:string=rd_dn_payload(@reader_ctx member)
    if (text =? "mode") {
        return false
    }
    if (text =? "debug") {
        rd_dc_report(@reader_ctx pos "`$build` has `mode` ('debug' or 'release'), not `debug`: test `$build.mode =? 'debug'`");
    }
    else {
        rd_dc_report(@reader_ctx pos "`$build` has `mode` ('debug' or 'release'), not `{text}`");
    }
    true
}

# `$build.mode = 'release'` or `$target = 'aarch64-linux'` at the top of a module: checked and
# applied where it is (dw_build_setting); a statement declaring nothing. 0 for another form.
rd_dc_build_setting=(@reader_ctx:ParserContext @reader_nodes:array<Node>):>int64=>$unsafe {
    let token:DewyLexeme=reader_ctx.tokens[reader_ctx.at]
    let place_stop:int64=rd_dc_setting_place_end(@reader_ctx reader_ctx.at)
    if (place_stop <? 0) {
        return 0
    }
    let target:bool=(rd_dn_payload(@reader_ctx token) =? "target")
    let assigned:bool=(reader_ctx.tokens[place_stop].symbol =? 'assign')
    if (target and (not assigned)) {
        return 0
    }
    let pos:int64=rd_mkpos(reader_ctx.file token.start)
    let text:string=rd_dc_setting_text(@reader_ctx place_stop)
    if ((text =? "$target.arch") or (text =? "$target.os")) {
        reader_ctx.stores.host[0].fatal(pos "`{text}` is part of the target: set the whole target, as `$target = 'aarch64-linux'`");
    }
    if (text =? "$build") {
        reader_ctx.stores.host[0].fatal(pos "`$build` is set one member at a time: `$build.mode = 'release'`");
    }
    if ((text not=? "$target") and (text not=? "$build.mode")) {
        # (`$build.debug`: syntax_target_field's mistake)
        if (target or (not rd_dc_build_member(@reader_ctx reader_ctx.tokens[(int64<overflow='wrap'>(place_stop) - 1)] pos))) {
            return 0
        }
        rd_dc_flush_report(@reader_ctx);
    }
    if (not assigned) {
        reader_ctx.stores.host[0].fatal(pos "`$build.mode` is set to 'debug' or 'release': `$build.mode = 'release'`");
    }
    let value:DewyLexeme=reader_ctx.tokens[(int64<overflow='wrap'>(place_stop) + 1)]
    let after:DewyLexeme=reader_ctx.tokens[(int64<overflow='wrap'>(place_stop) + 2)]
    let literal:int64=(if (((value.kind =? 'quoted') and rd_dc_plain_quote(@reader_ctx value)) or (value.kind =? 'rawquoted')) rd_dn_string(@reader_ctx @reader_nodes value) else int64(0))
    if ((((literal =? 0) or (reader_nodes[literal].kind not=? 'str_lit')) or (rd_nkids(@reader_nodes literal) >? 0)) or ((after.kind not=? 'eof') and (not after.newline))) {
        let example:string=(if target "aarch64-linux" else "release")
        reader_ctx.stores.host[0].fatal(rd_mkpos(reader_ctx.file value.start) "`{text}` is set to a name in quotes, as `{text} = '{example}'`");
    }
    reader_ctx.stores.host[0].build_setting_apply(target text pos rd_mkpos(reader_ctx.file value.start) rd_name_of(@reader_ctx int64<overflow='wrap'>(reader_nodes[literal].sval)));
    reader_ctx.at = (int64<overflow='wrap'>(place_stop) + 2)
    rd_dn_node(@reader_ctx 'compact_stmt' "$nothing" token.start)
}

rd_dc_builtin=(@reader_ctx:ParserContext k:int64):>int64=>$unsafe {
    if ((reader_ctx.reader.dc_builtins.length =? 0) or (reader_ctx.reader.dc_builtins[k] =? 0)) {
        rd_dc_builtin_name(@reader_ctx k);
    }
    reader_ctx.reader.dc_builtins[k]
}

rd_dc_builtin_name=(@reader_ctx:ParserContext k:int64):>void=>$unsafe {
    if (reader_ctx.reader.dc_builtins.length =? 0) {
        reader_ctx.reader.dc_builtins = [0 0 0 0 0]
    }
    reader_ctx.reader.dc_builtins[k] = reader_ctx.stores.host[0].intern(["__dewy_divide" "__dewy_power" "__floor_div" "__floor_mod" "__dewy_iter"][k])
}

# `$setting`, `$setting=true` or `$setting=false` on a line of its own at the top of a
# module: a compact statement naming the setting (child_right 1 on, 0 off), applied where
# dw_dir_statement applies one read from syntax (dw_top_declarations). Other metatag
# lines (directives, bundle definitions, build settings, markers) are left unread (dc_unread).
# `$name = { $setting  $setting=false  $default_row = <row> }` at a module's top: the bundle
# (dw_dir_define's), defined as it is read; 0 for a form is left unread (dc_unread).
rd_dc_bundle=(@reader_ctx:ParserContext token:DewyLexeme):>int64=>$unsafe {
    let name:string=rd_dn_payload(@reader_ctx token)
    if (((reader_ctx.tokens[(int64<overflow='wrap'>(reader_ctx.at) + 1)].symbol not=? 'assign') or (reader_ctx.tokens[(int64<overflow='wrap'>(reader_ctx.at) + 2)].symbol not=? 'lbrace')) or reader_ctx.stores.host[0].dw_dir_known(name)) {
        return 0
    }
    # (dw_dir_define's mistakes)
    if (reader_ctx.stores.host[0].dir_builtin(name) or (name =? "realtime")) {
        reader_ctx.stores.host[0].fatal(rd_mkpos(reader_ctx.file token.start) "`${name}` is a builtin setting, not a bundle");
    }
    if (reader_ctx.stores.host[0].dir_bundle_index(reader_ctx.stores.host[0].intern(name)) >=? 0) {
        reader_ctx.stores.host[0].fatal(rd_mkpos(reader_ctx.file token.start) "the bundle `${name}` is already defined");
    }
    let start:int64=reader_ctx.at
    let bundle:DirBundle=DirBundle[name=reader_ctx.stores.host[0].intern(name) settings=[] values=[] row=0 at=rd_mkpos(reader_ctx.file token.start) includes=[] include_at=[]]
    let rows:int64=reader_ctx.stores.host[0].g_effect_syntax_len()
    let blocks:bool=reader_ctx.stores.host[0].g_effect_blocks_demanded()
    reader_ctx.at = (int64<overflow='wrap'>(reader_ctx.at) + 3)
    let read:bool=true
    loop read and (not rd_dn_accept(@reader_ctx 'rbrace')) {
        let member:DewyLexeme=reader_ctx.tokens[reader_ctx.at]
        # (dw_dir_define's mistakes, at once)
        if (member.kind not=? 'metatag') {
            reader_ctx.stores.host[0].fatal(rd_mkpos(reader_ctx.file member.start) "a bundle lists settings: `$name`, `$name=false`, or `$default_row = <effect row>`");
        }
        else {
            let text:string=rd_dn_payload(@reader_ctx member)
            let pos:int64=rd_mkpos(reader_ctx.file member.start)
            reader_ctx.at = (int64<overflow='wrap'>(reader_ctx.at) + 1)
            if (text =? "default_row") {
                if ((bundle.row not=? 0) or (not rd_dn_accept(@reader_ctx 'assign'))) {
                    reader_ctx.stores.host[0].fatal(pos "`$default_row` takes one effect row, as written after `&` on a function: `$default_row = no allocates`");
                }
                else {
                    if (not rd_dc_effect_atom_start(reader_ctx.tokens[reader_ctx.at])) {
                        reader_ctx.stores.host[0].fatal(rd_mkpos(reader_ctx.file reader_ctx.tokens[reader_ctx.at].start) "effect pilot requires reads<place>, mutates<place>, or no_effects");
                    }
                    let entries:array<EffectSyntax>=[]
                    # (a bundle's row demands what it excludes only where it is applied: dir_apply_rows)
                    let saved_demand:bool=reader_ctx.stores.host[0].g_effect_panics_demanded()
                    read = rd_dc_effect_entries(@reader_ctx @entries true)
                    reader_ctx.stores.host[0].g_effect_panics_demanded_set(saved_demand)
                    if read {
                        reader_ctx.stores.host[0].g_effect_syntax_push(entries);
                        bundle.row = (int64<overflow='wrap'>(reader_ctx.stores.host[0].g_effect_syntax_len()) - 1)
                    }
                }
            }
            else {
                let enabled:int64=1
                if rd_dn_accept(@reader_ctx 'assign') {
                    let value:DewyLexeme=reader_ctx.tokens[reader_ctx.at]
                    if (value.kind not=? 'boolean') {
                        if (not rd_dc_lone_value(@reader_ctx reader_ctx.at)) {
                            read = false
                        }
                        else if ((text not=? "unsafe") and (text not=? "audited_wait")) {
                            reader_ctx.stores.host[0].fatal(rd_mkpos(reader_ctx.file value.start) "`${text}` takes a literal true or false");
                        }
                    }
                    else if (int64<overflow='wrap'>(value.name) not=? reader_ctx.reader.dn_true_id) {
                        enabled = 0
                    }
                    reader_ctx.at = (int64<overflow='wrap'>(reader_ctx.at) + 1)
                }
                if ((text =? "unsafe") and read) {
                    reader_ctx.stores.host[0].fatal(pos "`$unsafe` cannot be bundled: write it where the unsafe code is, so each boundary is visible");
                }
                if ((text =? "audited_wait") and read) {
                    reader_ctx.stores.host[0].fatal(pos "`$audited_wait` cannot be bundled: write it in each audited adapter, so each audit is visible");
                }
                else if (text =? "explicit_allocation_failure") {
                    if ((enabled not=? 1) and read) {
                        reader_ctx.stores.host[0].fatal(pos "a bundle can turn `$explicit_allocation_failure` on, not off: it is a module policy");
                    }
                    bundle.allocation_failure = true
                }
                else # (any other name is a bundle it includes, defined before or after: dir_bundle_resolve)
                if (not reader_ctx.stores.host[0].dir_builtin(text)) {
                    if (reader_ctx.stores.host[0].dw_dir_known(text) and read) {
                        reader_ctx.stores.host[0].fatal(pos "a bundle lists builtin settings (`$runtime_checks`, `$explicit_copies`, `$no_nan`, …), other bundles and `$default_row`, not `${text}`");
                    }
                    if ((enabled not=? 1) and read) {
                        reader_ctx.stores.host[0].fatal(pos "a bundle includes another bundle whole: `${text}`, not `${text}=false`");
                    }
                    bundle.includes.push(reader_ctx.stores.host[0].intern(text));
                    bundle.include_at.push(pos);
                }
                else {
                    bundle.settings.push(reader_ctx.stores.host[0].intern(text));
                    bundle.values.push(enabled);
                }
            }
        }
        let next:DewyLexeme=reader_ctx.tokens[reader_ctx.at]
        if ((read and (not next.newline)) and (next.symbol not=? 'rbrace')) {
            read = false
        }
    }
    let next:DewyLexeme=reader_ctx.tokens[reader_ctx.at]
    if ((not read) or ((next.kind not=? 'eof') and (not next.newline))) {
        reader_ctx.at = start
        reader_ctx.stores.host[0].g_effect_syntax_truncate(rows);
        reader_ctx.stores.host[0].g_effect_blocks_demanded_set(blocks)
        return 0
    }
    reader_ctx.stores.host[0].g_dir_bundles_push(bundle);
    rd_dn_node(@reader_ctx 'compact_stmt' "$nothing" token.start)
}

# A byte literal's string, as dw_byte_literal makes it: 0 where that reports a
# mistake (is left unread (dc_unread))
rd_dc_byte_literal=(@reader_ctx:ParserContext @reader_nodes:array<Node> token:DewyLexeme):>int64=>$unsafe {
    if (token.kind not=? 'quoted') {
        return 0
    }
    let source:string=reader_ctx.source
    let width:int64=dn_quote_width(source token.start token.stop)
    let stop:int64=(int64<overflow='wrap'>(token.stop) - int64<overflow='wrap'>(width))
    let problem:LiteralProblem=LiteralProblem[message="" at=0 unsupported=false]
    let text:array<uint8>=[]
    let pos:int64=rd_mkpos(reader_ctx.file token.start)
    if ((literal_string_text(@problem @text source (int64<overflow='wrap'>(token.start) + int64<overflow='wrap'>(width)) stop) <? stop) or ((problem.message as array<uint8>).length >? 0)) {
        # (`b"x{n}"`: dw_byte_literal's mistake, noted; `b'\q'`, dn_string's, should nothing else read it)
        if ((problem.message as array<uint8>).length >? 0) {
            return rd_dc_hint(@reader_ctx rd_mkpos(reader_ctx.file problem.at) problem.message)
        }
        if (not reader_ctx.flags.report_now) {
            return 0
        }
        rd_dc_report(@reader_ctx pos "a byte literal is not interpolated: write `\\\{` for a brace, or convert text, as in `bytes(\"...\")`");
        return rd_bc_int(@reader_nodes 0 pos)
    }
    let single:bool=((source as array<uint8>)[token.start] =? b'\'')
    if (single and (text.length not=? 1)) {
        if (not reader_ctx.flags.report_now) {
            return 0
        }
        rd_dc_report(@reader_ctx pos "`b'...'` is one byte, and this holds {text.length} (`b\"...\"` is an array of bytes)");
        return rd_bc_int(@reader_nodes 0 pos)
    }
    let u8:int64=node_mk(@reader_nodes 'tname' pos)
    reader_nodes[u8].name = int32<overflow='wrap'>(reader_ctx.stores.host[0].intern("u8"))
    let n:int64=node_mk(@reader_nodes 'cast' pos)
    if single {
        reader_nodes[n].a = int32<overflow='wrap'>(rd_bc_int(@reader_nodes int64<overflow='wrap'>(text[0]) pos))
        reader_nodes[n].b = int32<overflow='wrap'>(u8)
        return n
    }
    let elements:array<int64>=[]
    loop c in text {
        elements.push(rd_bc_int(@reader_nodes int64<overflow='wrap'>(c) pos));
    }
    let values:int64=node_mk(@reader_nodes 'array' pos)
    node_set_list(@reader_nodes @reader_ctx.stores.lists[0] values elements);
    let t:int64=node_mk(@reader_nodes 'tarray' pos)
    reader_nodes[t].a = int32<overflow='wrap'>(u8)
    reader_nodes[n].a = int32<overflow='wrap'>(values)
    reader_nodes[n].b = int32<overflow='wrap'>(t)
    n
}

# `[@n]() => n` at `=>`: dw_function's mistake, noted; the body read on.
rd_dc_capture_list=(@reader_ctx:ParserContext @reader_nodes:array<Node> left:int64 pos:int64 first_at:int64):>int64=>$unsafe {
    if (((not reader_ctx.flags.report_now) or (reader_nodes[left].kind not=? 'call')) or (reader_ctx.tokens[first_at].symbol not=? 'lbrack')) {
        return 0
    }
    let opening:int64=(int64<overflow='wrap'>(rd_dc_closing(@reader_ctx first_at)) + 1)
    if ((reader_ctx.tokens[opening].symbol not=? 'lparen') or (rd_dc_closing(@reader_ctx opening) not=? (int64<overflow='wrap'>(reader_ctx.at) - 1))) {
        return 0
    }
    rd_dc_unsupported(@reader_ctx pos "a separate capture list; use ($capture @name) in the parameter list");
    reader_ctx.at = (int64<overflow='wrap'>(reader_ctx.at) + 1)
    if (rd_dc_expr(@reader_ctx @reader_nodes 30) =? 0) {
        return 0
    }
    1
}

# `$capture` then another tag or the list's end: noted (the list's `(` is opening).
rd_dc_capture_missing=(@reader_ctx:ParserContext next:DewyLexeme opening:DewyLexeme):>bool=>$unsafe {
    if (not reader_ctx.flags.report_now) {
        return false
    }
    if (next.symbol =? 'rparen') {
        rd_dc_unsupported(@reader_ctx rd_mkpos(reader_ctx.file opening.start) "$capture without a local name");
    }
    else if (rd_dn_payload(@reader_ctx next) =? "capture") {
        rd_dc_unsupported(@reader_ctx rd_mkpos(reader_ctx.file next.start) "$capture without a local name");
    }
    true
}

# `$capture _`, `$capture @r.n`: noted, and the route read.
rd_dc_capture_other=(@reader_ctx:ParserContext place:bool target:DewyLexeme):>bool=>$unsafe {
    if (not reader_ctx.flags.report_now) {
        return false
    }
    let at:int64=target.start
    if place {
        at = reader_ctx.tokens[(int64<overflow='wrap'>(reader_ctx.at) - 1)].start
    }
    rd_dc_unsupported(@reader_ctx rd_mkpos(reader_ctx.file at) "a capture other than an enclosing local name");
    reader_ctx.at = (int64<overflow='wrap'>(reader_ctx.at) + 1)
    loop (rd_dn_peek(@reader_ctx) =? 'dot') and (reader_ctx.tokens[(int64<overflow='wrap'>(reader_ctx.at) + 1)].kind =? 'identifier') {
        reader_ctx.at = (int64<overflow='wrap'>(reader_ctx.at) + 2)
    }
    true
}

# The type after `as`, `is?` or `transmute`; `bytes as string ?? ""` (cast): no type has a
# fallback, so this converts to an optional and falls back, as `(bytes as string | none) ?? ""`
# (the fallback is dc_expr's next operator).
rd_dc_cast_type=(@reader_ctx:ParserContext @reader_nodes:array<Node> cast:bool power:int64):>int64=>$unsafe {
    let type_at:int64=reader_ctx.at
    reader_ctx.reader.dc_cast_coalesce = cast
    let t:int64=rd_dc_annotation(@reader_ctx @reader_nodes power)
    reader_ctx.reader.dc_cast_coalesce = false
    if (((t =? 0) or (not cast)) or (rd_dn_peek(@reader_ctx) not=? 'coalesce')) {
        return t
    }
    let type_pos:int64=rd_mkpos(reader_ctx.file reader_ctx.tokens[type_at].start)
    let missing:int64=node_mk(@reader_nodes 'tname' type_pos)
    reader_nodes[missing].name = int32<overflow='wrap'>(rd_dc_none_type(@reader_ctx))
    let optional:int64=node_mk(@reader_nodes 'tunion' type_pos)
    node_set_list(@reader_nodes @reader_ctx.stores.lists[0] optional [t missing]);
    optional
}

# The chain from entry mark on, as dw_chain makes it: each operand evaluated once, in order (a
# temporary holds one that is not plain), later links only while it holds. 0: a chain that turns
# (is left unread (dc_unread)).
rd_dc_chain_build=(@reader_ctx:ParserContext @reader_nodes:array<Node> mark:int64 pos:int64):>int64=>$unsafe {
    let way:int64=0
    loop k in [(int64<overflow='wrap'>(mark) + 1)..reader_ctx.reader.dc_chain_ops.length) {
        let w:int64=dw_chain_way(reader_ctx.reader.dc_chain_ops[k])
        if (w =? 0) {
            continue
        }
        if ((way not=? 0) and (w not=? way)) {
            # (dw_chain's mistake, noted)
            if (not reader_ctx.flags.report_now) {
                rd_dc_chain_truncate(@reader_ctx mark);
                return 0
            }
            rd_dc_report(@reader_ctx pos "a comparison chain goes one way: rising (`a <? b <=? c`) or falling (`a >? b >=? c`), with `=?` in either; join other comparisons with `and`");
        }
        way = w
    }
    let statements:array<int64>=[]
    let first:int64=reader_ctx.reader.dc_chain_operands[mark]
    if (not rd_dc_chain_plain(@reader_ctx @reader_nodes mark)) {
        first = reader_ctx.stores.host[0].dw_chain_temp(first @statements pos)
    }
    let chain:int64=rd_dc_chain_from(@reader_ctx @reader_nodes (int64<overflow='wrap'>(mark) + 1) first pos)
    rd_dc_chain_truncate(@reader_ctx mark);
    reader_ctx.reader.dc_chains_made = (int64<overflow='wrap'>(reader_ctx.reader.dc_chains_made) + 1)
    if ((chain =? 0) or (statements.length =? 0)) {
        return chain
    }
    statements.push(rd_bc_stmt(@reader_nodes chain pos));
    rd_bc_block(@reader_ctx @reader_nodes statements pos)
}

# The link at entry k, from the value left of it (dw_chain_from).
rd_dc_chain_from=(@reader_ctx:ParserContext @reader_nodes:array<Node> k:int64 left:int64 pos:int64):>int64=>$unsafe {
    let comparison:int64=node_mk(@reader_nodes 'binary' pos)
    reader_nodes[comparison].op = int32<overflow='wrap'>(int64<overflow='wrap'>(rd_dc_binary_token(reader_ctx.reader.dc_chain_ops[k])))
    reader_nodes[comparison].a = int32<overflow='wrap'>(left)
    let right:int64=reader_ctx.reader.dc_chain_operands[k]
    reader_nodes[comparison].b = int32<overflow='wrap'>(right)
    if ((int64<overflow='wrap'>(k) + 1) =? reader_ctx.reader.dc_chain_ops.length) {
        return comparison
    }
    let statements:array<int64>=[]
    let next:int64=0
    if rd_dc_chain_plain(@reader_ctx @reader_nodes k) {
        # (read again: a plain operand is evaluated where each link reads it)
        let saved:int64=reader_ctx.at
        reader_ctx.at = reader_ctx.reader.dc_chain_starts[k]
        next = rd_dc_expr(@reader_ctx @reader_nodes (int64<overflow='wrap'>(dn_power(reader_ctx.reader.dc_chain_ops[k])) + 1))
        reader_ctx.at = saved
        if (next =? 0) {
            return 0
        }
    }
    else {
        let value:int64=reader_ctx.stores.host[0].dw_chain_temp(right @statements pos)
        reader_nodes[comparison].b = int32<overflow='wrap'>(value)
        next = rd_bc_ident(@reader_ctx @reader_nodes rd_name_of(@reader_ctx int64<overflow='wrap'>(reader_nodes[value].name)) pos)
    }
    let both:int64=node_mk(@reader_nodes 'and_' pos)
    reader_nodes[both].a = int32<overflow='wrap'>(comparison)
    let rest:int64=rd_dc_chain_from(@reader_ctx @reader_nodes (int64<overflow='wrap'>(k) + 1) next pos)
    if (rest =? 0) {
        return 0
    }
    reader_nodes[both].b = int32<overflow='wrap'>(rest)
    if (statements.length =? 0) {
        return both
    }
    statements.push(rd_bc_stmt(@reader_nodes both pos));
    rd_bc_block(@reader_ctx @reader_nodes statements pos)
}

# The chain goes on at token (a comparison, or one through `not` that dc_expr refuses).
rd_dc_chain_goes_on=(@reader_ctx:ParserContext token:DewyLexeme minimum:int64):>bool=>$unsafe {
    let op:DewyToken=token.symbol
    if (token.kind =? 'eof') {
        return false
    }
    if (op =? 'kw_not') {
        op = dn_token_invert(reader_ctx.tokens[(int64<overflow='wrap'>(reader_ctx.at) + 1)].symbol)
        if (op =? 'none') {
            return false
        }
    }
    else if (((reader_ctx.reader.dn_angles >? 0) and (op =? 'gt')) and (not token.space)) {
        return false
    }
    let scalar:DewyToken=dn_token_uninvert(op)
    if ((dw_chain_way(scalar) =? 2) and (scalar not=? 'not_eq')) {
        return false
    }
    (dn_power(op) >=? minimum)
}

# The operand at entry k is read twice without changing anything (dw_chain_plain): a name, a
# literal or a member of one, unparenthesized.
rd_dc_chain_plain=(@reader_ctx:ParserContext @reader_nodes:array<Node> k:int64):>bool=>$unsafe {
    let t:DewyLexeme=reader_ctx.tokens[reader_ctx.reader.dc_chain_starts[k]]
    if (not (((((t.kind =? 'identifier') or (t.kind =? 'source_integer')) or (t.kind =? 'integer')) or (t.kind =? 'source_real')) or (t.kind =? 'boolean'))) {
        return false
    }
    rd_dc_plain_operand(@reader_nodes reader_ctx.reader.dc_chain_operands[k])
}

rd_dc_chain_push=(@reader_ctx:ParserContext op:DewyToken operand:int64 at:int64):>void=>$unsafe {
    reader_ctx.reader.dc_chain_ops.push(op);
    reader_ctx.reader.dc_chain_operands.push(operand);
    reader_ctx.reader.dc_chain_starts.push(at);
}

rd_dc_chain_truncate=(@reader_ctx:ParserContext mark:int64):>void=>$unsafe {
    reader_ctx.reader.dc_chain_ops.truncate(mark);
    reader_ctx.reader.dc_chain_operands.truncate(mark);
    reader_ctx.reader.dc_chain_starts.truncate(mark);
}

# `xs[$clamp a..b)` after its `[`: the slice truncated to the receiver (dw_clamp_slice), into n.
rd_dc_clamp=(@reader_ctx:ParserContext @reader_nodes:array<Node> n:int64):>bool=>$unsafe {
    let tag_at:int64=reader_ctx.at
    let tag:DewyLexeme=reader_ctx.tokens[reader_ctx.at]
    if (((int64<overflow='wrap'>(tag.stop) - int64<overflow='wrap'>(tag.start)) not=? 6) or (rd_dn_payload(@reader_ctx tag) not=? "clamp")) {
        return rd_dc_index_tag_mistake(@reader_ctx tag false)
    }
    reader_ctx.at = (int64<overflow='wrap'>(reader_ctx.at) + 1)
    let pos:int64=rd_mkpos(reader_ctx.file reader_ctx.tokens[reader_ctx.at].start)
    let first:int64=0
    if (rd_dn_peek(@reader_ctx) not=? 'range') {
        let saved_comma:bool=reader_ctx.flags.comma_stop
        reader_ctx.flags.comma_stop = true
        reader_ctx.reader.dc_range_top = true
        first = rd_dc_expr(@reader_ctx @reader_nodes 0)
        reader_ctx.reader.dc_range_top = false
        reader_ctx.flags.comma_stop = saved_comma
        if (first =? 0) {
            return false
        }
        if (rd_dn_peek(@reader_ctx) not=? 'range') {
            reader_ctx.at = (int64<overflow='wrap'>(reader_ctx.at) - 1)
            loop (reader_ctx.tokens[reader_ctx.at].kind not=? 'metatag') {
                reader_ctx.at = (int64<overflow='wrap'>(reader_ctx.at) - 1)
            }
            return rd_dc_index_tag_mistake(@reader_ctx tag true)
        }
    }
    reader_ctx.at = (int64<overflow='wrap'>(reader_ctx.at) + 1)
    let last:int64=0
    if dn_range_bound(@reader_ctx.tokens reader_ctx.at) {
        last = rd_dc_expr(@reader_ctx @reader_nodes 101)
        if (last =? 0) {
            return false
        }
    }
    let inclusive:bool=rd_dn_accept(@reader_ctx 'rbrack')
    if ((not inclusive) and (not rd_dn_accept(@reader_ctx 'rparen'))) {
        # (`xs[$clamp 1..2 3]`: entries after the range)
        if (reader_ctx.tokens[reader_ctx.at].kind =? 'eof') {
            return false
        }
        reader_ctx.at = tag_at
        return rd_dc_index_tag_mistake(@reader_ctx tag true)
    }
    let r:int64=node_mk(@reader_nodes 'range' pos)
    reader_nodes[r].a = int32<overflow='wrap'>(first)
    reader_nodes[r].b = int32<overflow='wrap'>(last)
    if inclusive {
        rd_add_flag(@reader_nodes r NF_INCLUSIVE);
    }
    let block:int64=reader_ctx.stores.host[0].dw_clamp_block(n r)
    reader_nodes[n] = reader_nodes[block]
    true
}

rd_dc_closes=(@reader_ctx:ParserContext):>bool=>$unsafe {
    ((rd_dn_peek(@reader_ctx) =? 'rangle') or (reader_ctx.reader.dn_edits_on and rd_dn_closer_joined(@reader_ctx)))
}

# The index of the bracket closing the one at `at` (-1: none).
rd_dc_closing=(@reader_ctx:ParserContext at:int64):>int64=>$unsafe {
    dc_scan_closing(@reader_ctx.tokens at)
}

# `count ?? 0 + 1` is `count ?? (0 + 1)`: a literal fallback followed by arithmetic usually meant
# the other tree (dw_coalesce_arithmetic's warning). The fallback's left spine of unparenthesized
# arithmetic down to the literal it starts with; its last right operand is quoted when it is a word.
rd_dc_coalesce_arithmetic=(@reader_ctx:ParserContext @reader_nodes:array<Node> left:int64 left_at:int64 right:int64 right_at:int64):>void=>$unsafe {
    let leaf:DewyLexeme=reader_ctx.tokens[right_at]
    if (((leaf.kind not=? 'source_integer') and (leaf.kind not=? 'integer')) and (leaf.kind not=? 'source_real')) {
        return
    }
    let first:int64=right
    let sym:string=""
    let rest:int64=0
    loop true {
        let k:NK=reader_nodes[first].kind
        let o:string=""
        if ((k =? 'binary') and (not rd_has_flag(@reader_nodes first NF_JUXT))) {
            let t:int64=int64<overflow='wrap'>(reader_nodes[first].op)
            if (t =? 58) {
                o = "+"
            }
            else if (t =? 59) {
                o = "-"
            }
            else if (t =? 60) {
                o = "*"
            }
            if (o not=? "") {
                sym = o
                rest = int64<overflow='wrap'>(reader_nodes[first].b)
                first = int64<overflow='wrap'>(reader_nodes[first].a)
                continue
            }
        }
        if (((k =? 'call') and (reader_nodes[int64<overflow='wrap'>(reader_nodes[first].a)].kind =? 'ident')) and (rd_nkids(@reader_nodes first) =? 2)) {
            let callee:int64=int64<overflow='wrap'>(reader_nodes[int64<overflow='wrap'>(reader_nodes[first].a)].name)
            if (callee =? rd_dc_builtin(@reader_ctx 0)) {
                o = "/"
            }
            else if (callee =? rd_dc_builtin(@reader_ctx 2)) {
                o = "//"
            }
            else if (callee =? rd_dc_builtin(@reader_ctx 3)) {
                o = "%"
            }
            if (o not=? "") {
                sym = o
                rest = node_kids(@reader_nodes @reader_ctx.stores.lists[0] first)[1]
                first = node_kids(@reader_nodes @reader_ctx.stores.lists[0] first)[0]
                continue
            }
        }
        break
    }
    if (((sym =? "") or ((reader_nodes[first].kind not=? 'int_lit') and (reader_nodes[first].kind not=? 'float_lit'))) or (rd_pos_off(reader_nodes[first].pos) not=? leaf.start)) {
        return
    }
    let name:string=rd_dc_operand_text(@reader_ctx @reader_nodes left left_at)
    if (name =? "") {
        name = "value"
    }
    let lit:string=rd_dn_payload(@reader_ctx leaf)
    let tail:string="..."
    let at:int64=rd_pos_off(reader_nodes[rest].pos)
    let rk:NK=reader_nodes[rest].kind
    if (((((rk =? 'ident') or (rk =? 'int_lit')) or (rk =? 'float_lit')) or (rk =? 'bool_lit')) or (rk =? 'none_lit')) {
        loop i in [right_at..reader_ctx.at) {
            let t:DewyLexeme=reader_ctx.tokens[i]
            if (t.start =? at) {
                if ((reader_ctx.tokens[(int64<overflow='wrap'>(i) - 1)].symbol not=? 'lparen') and ((((t.kind =? 'identifier') or (t.kind =? 'source_integer')) or (t.kind =? 'integer')) or (t.kind =? 'source_real'))) {
                    tail = rd_dn_payload(@reader_ctx t)
                }
                break
            }
        }
    }
    reader_ctx.stores.host[0].warn(reader_nodes[right].pos "arithmetic binds more tightly than `??`, so this fallback includes `{lit} {sym} {tail}`, not just `{lit}`: write `({name} ?? {lit}) {sym} {tail}` to use the chosen value, or `{name} ?? ({lit} {sym} {tail})` to keep this meaning");
}

# A comprehension's statement collecting into `accumulator` (dw_collect): a value is pushed (a
# call's own values, as its sink gives them), an entry of a dictionary (`map`) as its pair, a
# flow collects in each body, a `{ ... }` value in its last statement; other statements collect
# nothing. 0: a form collected another way.
rd_dc_collect=(@reader_ctx:ParserContext @reader_nodes:array<Node> statement:int64 accumulator:int64 map:bool=false):>int64=>$unsafe {
    dr_collect(@reader_ctx.collection @reader_nodes @reader_ctx.stores.lists[0] @reader_ctx.stores.builder[0] statement accumulator map)
}

rd_dc_collect_block=(@reader_ctx:ParserContext @reader_nodes:array<Node> block:int64 accumulator:int64 map:bool):>bool=>$unsafe {
    dr_collect_block(@reader_ctx.collection @reader_nodes @reader_ctx.stores.lists[0] @reader_ctx.stores.builder[0] block accumulator map)
}

# `[0 {1 2} if c 3]`: a literal collecting every value its elements express, in order
# (dw_collector); starts, where each element is written; discards, those an attached `;` discards.
rd_dc_collector=(@reader_ctx:ParserContext @reader_nodes:array<Node> items:array<int64> starts:array<int64> discards:array<int64> grouped:array<int64> pos:int64):>int64=>$unsafe {
    let accumulator:int64=reader_ctx.stores.host[0].intern("$dewy_collection_{reader_nodes.length}")
    let decl:int64=node_mk(@reader_nodes 'vardecl' pos)
    reader_nodes[decl].name = int32<overflow='wrap'>(accumulator)
    reader_nodes[decl].b = int32<overflow='wrap'>(node_mk(@reader_nodes 'array' pos))
    let statements:array<int64>=[]
    loop i in 0.. and item in items {
        let at:int64=starts[i]
        if (i in? discards) {
            let n:int64=node_mk(@reader_nodes 'assign' at)
            reader_nodes[n].op = int32<overflow='wrap'>(int64<overflow='wrap'>(int64(47)))
            reader_nodes[n].a = int32<overflow='wrap'>(node_mk(@reader_nodes 'hole' at))
            reader_nodes[n].b = int32<overflow='wrap'>(item)
            statements.push(n);
            continue
        }
        if rd_has_flag(@reader_nodes item NF_SPREAD) {
            rd_clear_flag(@reader_nodes item NF_SPREAD);
            let receiver:int64=node_mk(@reader_nodes 'ident' at)
            reader_nodes[receiver].name = int32<overflow='wrap'>(accumulator)
            rd_add_flag(@reader_nodes receiver NF_MUT);
            let callee:int64=node_mk(@reader_nodes 'field' at)
            reader_nodes[callee].a = int32<overflow='wrap'>(receiver)
            reader_nodes[callee].name = int32<overflow='wrap'>(reader_ctx.stores.host[0].intern("extend"))
            let call:int64=node_mk(@reader_nodes 'call' at)
            reader_nodes[call].a = int32<overflow='wrap'>(callee)
            node_set_list(@reader_nodes @reader_ctx.stores.lists[0] call [item]);
            let statement:int64=node_mk(@reader_nodes 'exprstmt' at)
            reader_nodes[statement].a = int32<overflow='wrap'>(call)
            statements.push(statement);
            continue
        }
        let k:NK=reader_nodes[item].kind
        # (`[(match x {...}) {2 3}]`: a parenthesized element is one value, pushed)
        if ((i in? grouped) and (k not=? 'call')) {
            let statement:int64=node_mk(@reader_nodes 'exprstmt' at)
            reader_nodes[statement].a = int32<overflow='wrap'>(rd_dc_push(@reader_ctx @reader_nodes accumulator item at))
            statements.push(statement);
            continue
        }
        if ((k =? 'match_') or (k =? 'parallel_region')) {
            return 0
        }
        if ((((k =? 'if_') or (k =? 'for_')) or (k =? 'while_')) or (k =? 'loopx')) {
            rd_add_flag(@reader_nodes item NF_STMT);
            if (rd_dc_collect(@reader_ctx @reader_nodes item accumulator) =? 0) {
                return 0
            }
            statements.push(item);
            continue
        }
        if ((k =? 'block') and (not rd_has_flag(@reader_nodes item NF_COMPREHENSION))) {
            if (not rd_dc_collect_block(@reader_ctx @reader_nodes item accumulator false)) {
                return 0
            }
            statements.push(item);
            continue
        }
        let statement:int64=node_mk(@reader_nodes 'exprstmt' at)
        reader_nodes[statement].a = int32<overflow='wrap'>(item)
        statement = rd_dc_collect(@reader_ctx @reader_nodes statement accumulator)
        if (statement =? 0) {
            return 0
        }
        statements.push(statement);
    }
    let body:int64=node_mk(@reader_nodes 'block' pos)
    node_set_list(@reader_nodes @reader_ctx.stores.lists[0] body statements);
    let result:int64=node_mk(@reader_nodes 'exprstmt' pos)
    let value:int64=node_mk(@reader_nodes 'ident' pos)
    reader_nodes[value].name = int32<overflow='wrap'>(accumulator)
    reader_nodes[result].a = int32<overflow='wrap'>(value)
    let block:int64=node_mk(@reader_nodes 'block' pos)
    node_set_list(@reader_nodes @reader_ctx.stores.lists[0] block [decl body result]);
    rd_add_flag(@reader_nodes block NF_COMPREHENSION);
    block
}

# `:` after a value (a type annotation): 1 when its mistake is noted and its
# type read on (`xs[1:2]`), 2 where it ends the value (an `if` condition's, dc_colon_body), 0
# otherwise, or the mistake reported at once (`x:int64 => x` as an argument).
rd_dc_colon=(@reader_ctx:ParserContext @reader_nodes:array<Node> left:int64 pos:int64 minimum:int64):>int64=>$unsafe {
    if (not reader_ctx.flags.report_now) {
        return 0
    }
    let bad:DewyLexeme=reader_ctx.tokens[(int64<overflow='wrap'>(reader_ctx.at) + 1)]
    if ((bad.kind =? 'op') or (not dn_can_start(@reader_ctx.tokens (int64<overflow='wrap'>(reader_ctx.at) + 1)))) {
        return rd_dc_operator_mistake(@reader_ctx)
    }
    if (reader_ctx.reader.dn_in_interpolation >? 0) {
        return 0
    }
    if ((reader_ctx.reader.dc_condition_depth =? reader_ctx.depth) or ((reader_ctx.reader.dc_top_level and (reader_ctx.depth =? 1)) and (minimum =? 11))) {
        return 2
    }
    if (((minimum <=? 30) and (reader_nodes[left].kind =? 'ident')) and (left =? (int64<overflow='wrap'>(reader_nodes.length) - 1))) {
        reader_ctx.at = (int64<overflow='wrap'>(reader_ctx.at) + 1)
        if (rd_dc_expr(@reader_ctx @reader_nodes 46) =? 0) {
            return 0
        }
        if (rd_dn_peek(@reader_ctx) not=? 'function') {
            return rd_dc_colon_value(@reader_ctx pos)
        }
        return rd_dc_fail_now(@reader_ctx pos "only one bare parameter name may omit the parentheses; write an annotated or typed signature as `(x:int64) => ...`")
    }
    if (reader_ctx.reader.dc_axis_depth not=? reader_ctx.depth) {
        return rd_dc_colon_value(@reader_ctx pos)
    }
    rd_dc_report(@reader_ctx pos rd_dc_colon_text());
    reader_ctx.at = (int64<overflow='wrap'>(reader_ctx.at) + 1)
    if (rd_dc_expr(@reader_ctx @reader_nodes 46) =? 0) {
        return 0
    }
    1
}

# `if c: ...` (dn_flow's mistake, at once): the condition goes on through the `:` and its type, and
# no body follows; 0 where one does.
rd_dc_colon_body=(@reader_ctx:ParserContext @reader_nodes:array<Node> keyword:DewyLexeme):>int64=>$unsafe {
    if (not reader_ctx.flags.report_now) {
        return 0
    }
    reader_ctx.at = (int64<overflow='wrap'>(reader_ctx.at) + 1)
    if ((rd_dc_expr(@reader_ctx @reader_nodes 46) =? 0) or dn_can_start(@reader_ctx.tokens reader_ctx.at)) {
        return 0
    }
    let next:DewyToken=rd_dn_peek(@reader_ctx)
    let habit:string=" (a condition takes no colon: its body goes in braces, `{dn_token_text(keyword.symbol)} x >? 3 \{ ... }`)"
    if (((((next =? 'gt') or (next =? 'lt')) or (next =? 'rangle')) or (next =? 'ge')) or (next =? 'le')) {
        habit = " (comparisons end with `?`: `x >? y`, `x <=? y`)"
    }
    reader_ctx.stores.host[0].dn_error(reader_ctx.tokens[reader_ctx.at].start "expected a body after '{dn_token_text(keyword.symbol)}'{habit}")
}

rd_dc_colon_text=():>string=>$unsafe {
    "`:` gives a type here (`x:int64`), not a value: a slice is a range in the brackets, `xs[1..3)`, and a dictionary entry is `key -> value`"
}

# (the mistake should the statement read no other way)
rd_dc_colon_value=(@reader_ctx:ParserContext pos:int64):>int64=>$unsafe {
    rd_dc_hint(@reader_ctx pos rd_dc_colon_text())
}

# A mutable binding or a live source in a combined loop (dw_loop_head's mistakes, noted).
rd_dc_combined_mistake=(@reader_ctx:ParserContext @reader_nodes:array<Node> head:int64):>bool=>$unsafe {
    if (not reader_ctx.flags.report_now) {
        return false
    }
    if rd_has_flag(@reader_nodes head NF_MUT) {
        rd_dc_unsupported(@reader_ctx reader_nodes[head].pos "a mutable binding in a combined loop; use a separate loop @item in items");
    }
    else {
        rd_dc_unsupported(@reader_ctx (reader_ctx.reader.dc_live_at_pos.get(head) ?? reader_nodes[head].pos) "live iteration (`in @items`) in a combined loop; use `loop item in @items` alone");
    }
    true
}

# `f(1, 2)`: arguments separated by commas (dw_comma_fail's mistake, noted at the first argument a
# comma follows), read again from `start` through the closer.
rd_dc_comma_arguments=(@reader_ctx:ParserContext @reader_nodes:array<Node> start:int64 close:DewyToken @args:array<int64>):>bool=>$unsafe {
    let depth:int64=0
    let k:int64=start
    loop true {
        let t:DewyLexeme=reader_ctx.tokens[k]
        if (t.kind =? 'eof') {
            return false
        }
        if ((depth =? 0) and ((((t.symbol =? close) or (t.symbol =? 'rparen')) or (t.symbol =? 'rbrack')) or (t.symbol =? 'rbrace'))) {
            return false
        }
        if ((depth =? 0) and (t.symbol =? 'comma')) {
            break
        }
        if (((t.symbol =? 'lparen') or (t.symbol =? 'lbrack')) or (t.symbol =? 'lbrace')) {
            depth = (int64<overflow='wrap'>(depth) + 1)
        }
        if (((t.symbol =? 'rparen') or (t.symbol =? 'rbrack')) or (t.symbol =? 'rbrace')) {
            depth = (int64<overflow='wrap'>(depth) - 1)
        }
        k = (int64<overflow='wrap'>(k) + 1)
    }
    rd_dc_comma_mistake(@reader_ctx rd_mkpos(reader_ctx.file reader_ctx.tokens[start].start));
    reader_ctx.at = start
    let saved:bool=reader_ctx.flags.comma_stop
    reader_ctx.flags.comma_stop = true
    loop (not rd_dn_accept(@reader_ctx close)) {
        if rd_dn_accept(@reader_ctx 'comma') {
            continue
        }
        # (`f(1, 2` and nothing after: the reading fails)
        let arg:int64=0
        if (reader_ctx.tokens[reader_ctx.at].kind not=? 'eof') {
            arg = rd_dc_expr(@reader_ctx @reader_nodes 0)
        }
        if (arg =? 0) {
            reader_ctx.flags.comma_stop = saved
            return false
        }
        args.push(arg);
    }
    reader_ctx.flags.comma_stop = saved
    true
}

rd_dc_comma_mistake=(@reader_ctx:ParserContext pos:int64):>void=>$unsafe {
    rd_dc_report(@reader_ctx pos rd_dc_comma_text());
}

# `a, b in` at `at`: names separated by commas, then `in`.
rd_dc_comma_names=(@reader_ctx:ParserContext at:int64):>bool=>$unsafe {
    let k:int64=at
    loop (reader_ctx.tokens[k].kind =? 'identifier') and (reader_ctx.tokens[(int64<overflow='wrap'>(k) + 1)].symbol =? 'comma') {
        k = (int64<overflow='wrap'>(k) + 2)
    }
    (((k >? at) and (reader_ctx.tokens[k].kind =? 'identifier')) and (reader_ctx.tokens[(int64<overflow='wrap'>(k) + 1)].symbol =? 'kw_in'))
}

rd_dc_comma_text=():>string=>$unsafe {
    "Dewy separates arguments, parameters and elements with spaces, not commas: `add(1 2)`, `(a:int64 b:int64) => ...`, `[1 2 3]` (a comma steps a range, as in `[0,2..10]`)"
}

rd_dc_comparison=(op:int64):>bool=>$unsafe {
    ((((((op =? 69) or (op =? 70)) or (op =? 71)) or (op =? 72)) or (op =? 73)) or (op =? 74))
}

# `[loop ... ]` after its `[`: the loop collects the values its bodies end with (dw_comprehension);
# `key -> value` entries make a dictionary. A parallel or record comprehension is read
# elsewhere.
rd_dc_comprehension=(@reader_ctx:ParserContext @reader_nodes:array<Node>):>int64=>$unsafe {
    let pos:int64=rd_mkpos(reader_ctx.file reader_ctx.tokens[reader_ctx.at].start)
    let saved_map:bool=reader_ctx.reader.dc_map_ok
    let made:int64=(int64<overflow='wrap'>(reader_ctx.reader.dc_pairs_made) - int64<overflow='wrap'>(reader_ctx.collection.pairs_collected))
    reader_ctx.reader.dc_map_ok = true
    let flow:int64=rd_dc_flow(@reader_ctx @reader_nodes)
    reader_ctx.reader.dc_map_ok = saved_map
    if (flow =? 0) {
        return 0
    }
    if (not rd_dn_accept(@reader_ctx 'rbrack')) {
        return rd_dc_row_outside(@reader_ctx @reader_nodes flow)
    }
    # (`[loop f in fields(T) $field(f.name)=x.$field(f.name)]`: a record's rows, dw_record_loop)
    if rd_dc_record_tail(@reader_ctx @reader_nodes flow) {
        return rd_dc_record_loop(@reader_ctx @reader_nodes flow)
    }
    rd_add_flag(@reader_nodes flow NF_STMT);
    let accumulator:int64=reader_ctx.stores.host[0].intern("$dewy_collection_{reader_nodes.length}")
    let decl:int64=node_mk(@reader_nodes 'vardecl' pos)
    reader_nodes[decl].name = int32<overflow='wrap'>(accumulator)
    reader_nodes[decl].b = int32<overflow='wrap'>(node_mk(@reader_nodes 'array' pos))
    let map:bool=(rd_dc_tail_kind(@reader_ctx @reader_nodes flow) =? 2)
    # (dw_collection_kind's mistake, noted where it finds it; each value then collected as it is)
    let mixed:int64=rd_dc_mixed_at(@reader_ctx @reader_nodes flow)
    if (mixed not=? 0) {
        if (not reader_ctx.flags.report_now) {
            return 0
        }
        rd_dc_report(@reader_ctx mixed "a comprehension cannot mix array elements and dictionary entries");
    }
    let saved_mixed:bool=reader_ctx.collection.mixed
    reader_ctx.collection.mixed = (mixed not=? 0)
    let collected:int64=rd_dc_collect(@reader_ctx @reader_nodes flow accumulator map)
    reader_ctx.collection.mixed = saved_mixed
    if ((collected =? 0) or ((int64<overflow='wrap'>(reader_ctx.reader.dc_pairs_made) - int64<overflow='wrap'>(reader_ctx.collection.pairs_collected)) not=? made)) {
        return 0
    }
    let result:int64=node_mk(@reader_nodes 'exprstmt' pos)
    let value:int64=node_mk(@reader_nodes 'ident' pos)
    reader_nodes[value].name = int32<overflow='wrap'>(accumulator)
    reader_nodes[result].a = int32<overflow='wrap'>(value)
    let block:int64=node_mk(@reader_nodes 'block' pos)
    node_set_list(@reader_nodes @reader_ctx.stores.lists[0] block [decl flow result]);
    rd_add_flag(@reader_nodes block NF_COMPREHENSION);
    if (not map) {
        return block
    }
    let callee:int64=node_mk(@reader_nodes 'ident' pos)
    reader_nodes[callee].name = int32<overflow='wrap'>(reader_ctx.stores.host[0].intern("__map_of"))
    let call:int64=node_mk(@reader_nodes 'call' pos)
    reader_nodes[call].a = int32<overflow='wrap'>(callee)
    node_set_list(@reader_nodes @reader_ctx.stores.lists[0] call [block]);
    call
}

# `concurrent { ... }`, `concurrent name { ... }` after its keyword (dw_concurrent): `transparent`, a
# statement. Its statements are read directly, none deferred (a deferred `spawn` would be projected
# outside its group).
rd_dc_concurrent=(@reader_ctx:ParserContext @reader_nodes:array<Node> token:DewyLexeme transparent:bool):>int64=>$unsafe {
    let pos:int64=rd_mkpos(reader_ctx.file token.start)
    # (its hidden names' number: beyond any syntax index)
    let serial:int64=(int64<overflow='wrap'>((int64<overflow='wrap'>(int64(1)) << 32)) + int64<overflow='wrap'>(reader_nodes.length))
    let name:string="$group{serial}"
    if (rd_dn_peek(@reader_ctx) not=? 'lbrace') {
        let group:DewyLexeme=reader_ctx.tokens[reader_ctx.at]
        if (group.kind not=? 'identifier') {
            return rd_dc_concurrent_mistake(@reader_ctx group.start "concurrent needs a group name or a braced body")
        }
        if (group.symbol not=? 'none') {
            return 0
        }
        name = rd_dn_payload(@reader_ctx group)
        # (a named group is placed at its name)
        pos = rd_mkpos(reader_ctx.file group.start)
        reader_ctx.at = (int64<overflow='wrap'>(reader_ctx.at) + 1)
        if (rd_dn_peek(@reader_ctx) not=? 'lbrace') {
            return rd_dc_concurrent_mistake(@reader_ctx reader_ctx.tokens[reader_ctx.at].start "concurrent needs a braced body")
        }
    }
    reader_ctx.stores.host[0].g_dw_task_groups_push(name);
    let saved_unread:bool=reader_ctx.flags.unread_here
    reader_ctx.flags.unread_here = false
    let body:int64=rd_dc_body(@reader_ctx @reader_nodes)
    reader_ctx.flags.unread_here = saved_unread
    reader_ctx.stores.host[0].g_dw_task_groups_pop();
    if ((body =? 0) or (not rd_dc_flow_ends(@reader_ctx))) {
        return 0
    }
    reader_ctx.stores.host[0].dw_task_group(pos name serial body transparent)
}

# (dn_atom's mistakes, at once)
rd_dc_concurrent_mistake=(@reader_ctx:ParserContext at:int64 msg:string):>int64=>$unsafe {
    if (not reader_ctx.flags.report_now) {
        return 0
    }
    reader_ctx.stores.host[0].dn_error(at msg)
}

rd_dc_condition=(@reader_ctx:ParserContext @reader_nodes:array<Node> base:int64):>int64=>$unsafe {
    let pos:int64=rd_mkpos(reader_ctx.file reader_ctx.tokens[reader_ctx.at].start)
    reader_ctx.reader.dn_angles = (int64<overflow='wrap'>(reader_ctx.reader.dn_angles) + 1)
    let predicate:int64=rd_dc_ref_predicate_read(@reader_ctx @reader_nodes 0)
    reader_ctx.reader.dn_angles = (int64<overflow='wrap'>(reader_ctx.reader.dn_angles) - 1)
    if ((predicate =? 0) or rd_dc_membership(@reader_nodes predicate)) {
        return 0
    }
    let k:NK=reader_nodes[predicate].kind
    let tested:int64=predicate
    if (k =? 'not_') {
        tested = int64<overflow='wrap'>(reader_nodes[predicate].a)
    }
    # (`m in? 2..254`: membership in a contiguous range, dw_ref_predicate's)
    if (not ((k =? 'and_') or ((reader_nodes[tested].kind =? 'binary') and (rd_dc_comparison(int64<overflow='wrap'>(reader_nodes[tested].op)) or ((k =? 'binary') and (reader_nodes[tested].op =? int32<overflow='wrap'>(int64<overflow='wrap'>(int64(12))))))))) {
        return 0
    }
    reader_ctx.stores.host[0].g_refine_active_set(true)
    let n:int64=node_mk(@reader_nodes 'trefined' pos)
    reader_nodes[n].a = int32<overflow='wrap'>(base)
    reader_nodes[n].name = int32<overflow='wrap'>(reader_ctx.reader.dc_pattern_binder)
    reader_nodes[n].b = int32<overflow='wrap'>(rd_dc_ref_predicate(@reader_nodes predicate))
    n
}

# `if x = 2 { ... }`: an assignment as the condition (dw_flow's mistake, should nothing else read it),
# the condition as written again with `=?` when it ends on its line at a `{`.
rd_dc_condition_assign=(@reader_ctx:ParserContext start:int64):>int64=>$unsafe {
    let pos:int64=rd_mkpos(reader_ctx.file reader_ctx.tokens[start].start)
    let k:int64=(int64<overflow='wrap'>(reader_ctx.at) + 1)
    loop (reader_ctx.tokens[k].kind not=? 'eof') and (reader_ctx.tokens[k].symbol not=? 'lbrace') and (not reader_ctx.tokens[k].newline) {
        k = (int64<overflow='wrap'>(k) + 1)
    }
    if (((k =? (int64<overflow='wrap'>(reader_ctx.at) + 1)) or (reader_ctx.tokens[k].symbol not=? 'lbrace')) or reader_ctx.tokens[k].newline) {
        return rd_dc_hint(@reader_ctx pos "a condition compares with `=?`, not `=`")
    }
    let src:string=reader_ctx.source
    let left:string=reader_ctx.stores.host[0].bytes_slice(src reader_ctx.tokens[start].start reader_ctx.tokens[(int64<overflow='wrap'>(reader_ctx.at) - 1)].stop)
    let right:string=reader_ctx.stores.host[0].bytes_slice(src reader_ctx.tokens[(int64<overflow='wrap'>(reader_ctx.at) + 1)].start reader_ctx.tokens[(int64<overflow='wrap'>(k) - 1)].stop)
    rd_dc_hint(@reader_ctx pos "a condition compares with `=?`: write `if {left} =? {right} \{ ... }`")
}

# `const x:int64` without a value (dw_declare's mistake): none stands in for it.
rd_dc_const_missing=(@reader_ctx:ParserContext @reader_nodes:array<Node> n:int64):>void=>$unsafe {
    rd_dc_unsupported(@reader_ctx reader_nodes[n].pos "a const declaration without an initializer");
    reader_nodes[n].b = int32<overflow='wrap'>(node_mk(@reader_nodes 'none_lit' reader_nodes[n].pos))
}

rd_dc_copy_last=(@reader_ctx:ParserContext @reader_nodes:array<Node> block:int64):>bool=>$unsafe {
    dr_copy_last(@reader_nodes @reader_ctx.stores.lists[0] @reader_ctx.stores.texts[0] block)
}

# The value is written `....copy()` (dw_copy_result).
rd_dc_copy_value=(@reader_ctx:ParserContext @reader_nodes:array<Node> n:int64):>bool=>$unsafe {
    dr_copy_value(@reader_nodes @reader_ctx.stores.lists[0] @reader_ctx.stores.texts[0] n)
}

rd_dc_declaration=(@reader_ctx:ParserContext @reader_nodes:array<Node> constant:bool bare:bool=false):>int64=>$unsafe {
    let token:DewyLexeme=reader_ctx.tokens[reader_ctx.at]
    # `let [a b] = value`, `let (a b) = values`: an unpacking declaration (dw_declare's pattern)
    if (((token.symbol =? 'lbrack') or (token.symbol =? 'lparen')) and (not bare)) {
        reader_ctx.at = (int64<overflow='wrap'>(reader_ctx.at) + 1)
        let n:int64=node_mk(@reader_nodes 'vardecl' rd_mkpos(reader_ctx.file token.start))
        let seen:array<int64>=[]
        let close:DewyToken='rbrack'
        if (token.symbol =? 'lparen') {
            close = 'rparen'
        }
        let binders:array<int64>=rd_dc_binding_items(@reader_ctx @reader_nodes @seen close)
        if (binders.length =? 0) {
            return 0
        }
        if ((close =? 'rparen') and (binders.length <? 2)) {
            return rd_dc_grouped_binder(@reader_ctx (int64<overflow='wrap'>(reader_ctx.at) - 1))
        }
        node_set_list(@reader_nodes @reader_ctx.stores.lists[0] n binders);
        if rd_dn_accept(@reader_ctx 'colon') {
            let annotation:int64=rd_dc_annotation(@reader_ctx @reader_nodes)
            if (annotation =? 0) {
                return 0
            }
            reader_nodes[n].a = int32<overflow='wrap'>(annotation)
        }
        if ((not rd_dn_accept(@reader_ctx 'assign')) or rd_dc_lambda_next(@reader_ctx)) {
            return 0
        }
        reader_ctx.depth = (int64<overflow='wrap'>(reader_ctx.depth) + 1)
        let initial:int64=rd_dc_expr(@reader_ctx @reader_nodes 11)
        reader_ctx.depth = (int64<overflow='wrap'>(reader_ctx.depth) - 1)
        if ((initial =? 0) or (reader_nodes[initial].kind =? 'lambda')) {
            return 0
        }
        reader_nodes[n].b = int32<overflow='wrap'>(initial)
        if constant {
            rd_add_flag(@reader_nodes n NF_RDONLY);
        }
        rd_dc_accept_semi(@reader_ctx true);
        return n
    }
    # (`let and = 3`, `let end = 20`: a word operator or a reserved word as the name, dw_declare's
    # mistakes, reported once the declaration is read)
    let word:bool=false
    let reserved:bool=false
    if ((token.kind not=? 'identifier') or ((token.symbol not=? 'none') and (token.symbol not=? 'kw_test'))) {
        word = (((not bare) and rd_dc_word_operator(token.symbol)) and ((reader_ctx.tokens[(int64<overflow='wrap'>(reader_ctx.at) + 1)].symbol =? 'assign') or (reader_ctx.tokens[(int64<overflow='wrap'>(reader_ctx.at) + 1)].symbol =? 'colon')))
        if (not word) {
            return 0
        }
    }
    else if rd_dn_reserved(@reader_ctx int64<overflow='wrap'>(token.name)) {
        if bare {
            return 0
        }
        reserved = true
    }
    reader_ctx.at = (int64<overflow='wrap'>(reader_ctx.at) + 1)
    let n:int64=node_mk(@reader_nodes 'vardecl' rd_mkpos(reader_ctx.file token.start))
    reader_nodes[n].name = token.name
    if rd_dn_accept(@reader_ctx 'colon') {
        let outer:int64=reader_ctx.reader.dc_pattern_binder
        reader_ctx.reader.dc_pattern_binder = int64<overflow='wrap'>(token.name)
        let typed_at:int64=reader_ctx.at
        let annotation:int64=rd_dc_annotation(@reader_ctx @reader_nodes)
        reader_ctx.reader.dc_pattern_binder = outer
        if (annotation =? 0) {
            return rd_dc_untyped(@reader_ctx typed_at)
        }
        reader_nodes[n].a = int32<overflow='wrap'>(annotation)
    }
    if rd_dn_accept(@reader_ctx 'assign') {
        # (`name:T = value` without `let` declares at the top of a module only, dw_stmt)
        # (a module's annotated function literal is a value of that type, its parameter names
        # among it: `let f:<(amount:int64):>int64> = (x) => x*2`)
        let typed:bool=(reader_ctx.reader.dc_top_level and (reader_nodes[n].a not=? 0))
        if ((bare and (not reader_ctx.reader.dc_top_level)) or (((not reader_ctx.flags.fn_body) and (not typed)) and rd_dc_lambda_next(@reader_ctx))) {
            return 0
        }
        reader_ctx.reader.dc_initial_at = reader_ctx.at
        reader_ctx.depth = (int64<overflow='wrap'>(reader_ctx.depth) + 1)
        let initial:int64=rd_dc_expr(@reader_ctx @reader_nodes 11)
        reader_ctx.depth = (int64<overflow='wrap'>(reader_ctx.depth) - 1)
        if (((initial =? 0) or (((reader_nodes[initial].kind =? 'lambda') and (not reader_ctx.flags.fn_body)) and (not typed))) or rd_dc_inferred_refinement(@reader_ctx @reader_nodes initial)) {
            return 0
        }
        reader_nodes[n].b = int32<overflow='wrap'>(initial)
    }
    else {
        let next:DewyLexeme=reader_ctx.tokens[reader_ctx.at]
        if ((((dn_power(next.symbol) >? 0) or (next.symbol =? 'dot')) or (next.symbol =? 'question')) or (next.symbol =? 'ellipsis')) {
            return rd_dc_unnamed(@reader_ctx @reader_nodes n)
        }
        if ((not next.space) and (((((next.symbol =? 'lparen') or (next.symbol =? 'lbrack')) or (next.symbol =? 'langle')) or (next.kind =? 'quoted')) or (next.kind =? 'rawquoted'))) {
            return rd_dc_unnamed(@reader_ctx @reader_nodes n)
        }
        if constant {
            rd_dc_const_missing(@reader_ctx @reader_nodes n);
        }
    }
    if word {
        rd_dc_word_operator_at(@reader_ctx token);
    }
    if reserved {
        rd_dc_reserved_at(@reader_ctx token);
    }
    if constant {
        let value:int64=int64<overflow='wrap'>(reader_nodes[n].b)
        if ((rd_dw_const_number(@reader_nodes value) or (reader_nodes[value].kind =? 'str_lit')) or (reader_nodes[value].kind =? 'none_lit')) {
            reader_nodes[n].kind = 'const_'
        }
        else {
            rd_add_flag(@reader_nodes n NF_RDONLY);
        }
    }
    reader_ctx.stores.host[0].decimal_let(n);
    rd_dc_accept_semi(@reader_ctx (not (bare and reader_ctx.reader.dc_unbraced)));
    n
}

# A module statement the direct grammar read that declares nothing (`name = (...) => $intrinsic`):
# its nodes go.
rd_dc_declares_nothing=(@reader_ctx:ParserContext @reader_nodes:array<Node> head:int64 node_start:int64 list_start:int64 edits:int64):>int64=>$unsafe {
    let stop:int64=reader_ctx.at
    rd_dn_edits_undo(@reader_ctx edits);
    reader_nodes.truncate(node_start);
    reader_ctx.stores.lists[0].truncate(list_start);
    reader_ctx.at = stop
    rd_dn_node(@reader_ctx 'compact_stmt' "$nothing" reader_ctx.tokens[head].start)
}

# `def main():` at the top of a module, the declaration's target no name (dw_declare's mistake,
# noted; its type read on); 0 for any other target.
rd_dc_def_habit=(@reader_ctx:ParserContext @reader_nodes:array<Node> left:int64):>int64=>$unsafe {
    let pos:int64=reader_nodes[left].pos
    let at:int64=rd_pos_off(pos)
    let src:string=reader_ctx.source
    let habit:bool=false
    loop w in ["def " "function " "fn " "func "] {
        if ((at >=? (w as array<uint8>).length) and (reader_ctx.stores.host[0].bytes_slice(src (int64<overflow='wrap'>(at) - int64<overflow='wrap'>((w as array<uint8>).length)) at) =? w)) {
            habit = true
        }
    }
    if (not habit) {
        return 0
    }
    rd_dc_report(@reader_ctx pos "a function is a value bound to its name: `main = () => \{ ... }`, `add = (a:int64 b:int64) => a + b`");
    reader_ctx.at = (int64<overflow='wrap'>(reader_ctx.at) + 1)
    if (rd_dc_expr(@reader_ctx @reader_nodes 46) =? 0) {
        return 0
    }
    let statement:int64=node_mk(@reader_nodes 'exprstmt' pos)
    reader_nodes[statement].a = int32<overflow='wrap'>(left)
    statement
}

# `$test(cases=…)`, `$export(name='…')` or `$supported_targets = [...]` on a line of its own at the
# top of a module: a compact statement holding what its consumer reads (dw_test_spec's test,
# dw_export_begin's name, dw_supported_targets' names); 0 for any other form, or one they report.
rd_dc_directive_line=(@reader_ctx:ParserContext @reader_nodes:array<Node> token:DewyLexeme):>int64=>$unsafe {
    let name:string=rd_dn_payload(@reader_ctx token)
    if (((name not=? "test") and (name not=? "export")) and (name not=? "supported_targets")) {
        return 0
    }
    let start:int64=reader_ctx.at
    let node_start:int64=reader_nodes.length
    let list_start:int64=reader_ctx.stores.lists[0].length
    let pos:int64=rd_mkpos(reader_ctx.file token.start)
    let after:DewyLexeme=reader_ctx.tokens[(int64<overflow='wrap'>(reader_ctx.at) + 1)]
    let n:int64=0
    if (name =? "supported_targets") {
        if (after.symbol =? 'assign') {
            reader_ctx.at = (int64<overflow='wrap'>(reader_ctx.at) + 2)
            n = rd_dc_target_list(@reader_ctx @reader_nodes)
        }
    }
    else if ((after.symbol =? 'lparen') and (not after.space)) {
        reader_ctx.at = (int64<overflow='wrap'>(reader_ctx.at) + 2)
        reader_ctx.depth = 0
        n = (if (name =? "test") rd_dc_test_cases(@reader_ctx @reader_nodes pos) else rd_dc_export_name(@reader_ctx @reader_nodes pos))
    }
    let next:DewyLexeme=reader_ctx.tokens[reader_ctx.at]
    if ((n =? 0) or ((next.kind not=? 'eof') and (not ((next.newline and (dn_power(next.symbol) =? 0)) and (next.symbol not=? 'kw_not'))))) {
        reader_ctx.at = start
        reader_nodes.truncate(node_start);
        reader_ctx.stores.lists[0].truncate(list_start);
        return 0
    }
    let id:int64=rd_dn_node(@reader_ctx 'compact_stmt' "{"$"}{name}" token.start)
    reader_ctx.reader.dewy_syntax[id].child_left = n
    id
}

# A directive's call as a statement (dw_stmt): with its `;` (ended), the value discarded.
rd_dc_directive_statement=(@reader_nodes:array<Node> call:int64 pos:int64 ended:bool):>int64=>$unsafe {
    if ended {
        let n:int64=node_mk(@reader_nodes 'assign' pos)
        reader_nodes[n].op = int32<overflow='wrap'>(int64<overflow='wrap'>(int64(47)))
        reader_nodes[n].a = int32<overflow='wrap'>(node_mk(@reader_nodes 'hole' pos))
        reader_nodes[n].b = int32<overflow='wrap'>(call)
        return n
    }
    let n:int64=node_mk(@reader_nodes 'exprstmt' pos)
    reader_nodes[n].a = int32<overflow='wrap'>(call)
    n
}

# A value an attached `;` may discard without a warning (dw_pure): a call.
rd_dc_discardable=(@reader_ctx:ParserContext @reader_nodes:array<Node> n:int64):>bool=>$unsafe {
    if ((reader_nodes[n].kind not=? 'call') or rd_has_flag(@reader_nodes n NF_SPREAD)) {
        return false
    }
    let callee:int64=int64<overflow='wrap'>(reader_nodes[n].a)
    ((reader_nodes[callee].kind not=? 'ident') or ((reader_nodes[callee].name not=? int32<overflow='wrap'>(rd_dc_builtin(@reader_ctx 0))) and (reader_nodes[callee].name not=? int32<overflow='wrap'>(rd_dc_builtin(@reader_ctx 1)))))
}

# After `.`: `f.(xs)`, the call broadcast over its arguments (dw_expr's broadcast call), or
# `value.$field(name)`, a member named by a compile-time string (dw_field_name); 0 for another form.
rd_dc_dot_form=(@reader_ctx:ParserContext @reader_nodes:array<Node> left:int64 after_call:bool pos:int64):>int64=>$unsafe {
    let member:DewyLexeme=reader_ctx.tokens[reader_ctx.at]
    if (member.symbol =? 'lparen') {
        reader_ctx.at = (int64<overflow='wrap'>(reader_ctx.at) + 1)
        let n:int64=node_mk(@reader_nodes 'call' pos)
        reader_nodes[n].a = int32<overflow='wrap'>(left)
        rd_add_flag(@reader_nodes n NF_BROADCAST);
        if (reader_nodes[left].kind =? 'field') {
            rd_add_flag(@reader_nodes int64<overflow='wrap'>(reader_nodes[left].a) NF_MUT);
        }
        if (not rd_dc_arguments(@reader_ctx @reader_nodes n 'rparen')) {
            return 0
        }
        return n
    }
    if ((reader_ctx.tokens[(int64<overflow='wrap'>(reader_ctx.at) + 1)].symbol not=? 'lparen') or (rd_dn_payload(@reader_ctx member) not=? "field")) {
        return 0
    }
    reader_ctx.at = (int64<overflow='wrap'>(reader_ctx.at) + 2)
    let computed:int64=rd_dc_expr(@reader_ctx @reader_nodes 0)
    if ((computed =? 0) or (not rd_dn_accept(@reader_ctx 'rparen'))) {
        return 0
    }
    let n:int64=node_mk(@reader_nodes 'field' pos)
    reader_nodes[n].a = int32<overflow='wrap'>(left)
    reader_nodes[n].b = int32<overflow='wrap'>(computed)
    if after_call {
        rd_add_flag(@reader_nodes n NF_JUXT);
    }
    n
}

# `array<<(x:int64):>int64>>`: an adjacent `<<` opens two angle brackets; its first `<` is split
# off in place (dn_double_angle), the other left for the type argument.
rd_dc_double_angle=(@reader_ctx:ParserContext):>bool=>$unsafe {
    if (((reader_ctx.tokens[reader_ctx.at].symbol not=? 'shl') or reader_ctx.tokens[reader_ctx.at].space) or (not dn_double_closes(@reader_ctx.tokens reader_ctx.at))) {
        return false
    }
    rd_dn_token_edit(@reader_ctx reader_ctx.at);
    reader_ctx.tokens[reader_ctx.at].start = (int64<overflow='wrap'>(reader_ctx.tokens[reader_ctx.at].start) + 1)
    reader_ctx.tokens[reader_ctx.at].symbol = 'langle'
    true
}

# A left-out arm, passed over: the names its tokens and its strings' interpolations use are noted
# (dw_target_dropped_name); false where it does not end.
rd_dc_dropped_arm=(@reader_ctx:ParserContext):>bool=>$unsafe {
    let stop:int64=reader_ctx.at
    if (rd_dn_peek(@reader_ctx) =? 'lbrace') {
        stop = (int64<overflow='wrap'>(rd_dc_closing(@reader_ctx reader_ctx.at)) + 1)
    }
    else {
        stop = rd_dc_arm_end(@reader_ctx reader_ctx.at)
    }
    if (stop <=? reader_ctx.at) {
        return false
    }
    rd_dc_dropped_names(@reader_ctx reader_ctx.tokens reader_ctx.at stop);
    reader_ctx.at = stop
    true
}

rd_dc_dropped_names=(@reader_ctx:ParserContext tokens:array<DewyLexeme> first:int64 stop:int64):>void=>$unsafe {
    loop k in [first..stop) {
        let t:DewyLexeme=tokens[k]
        if ((t.kind =? 'identifier') and ((t.symbol =? 'none') or (t.symbol =? 'kw_test'))) {
            reader_ctx.stores.host[0].dw_target_dropped_name(int64<overflow='wrap'>(t.name) rd_mkpos(reader_ctx.file t.start));
        }
        else if (t.kind =? 'quoted') {
            rd_dc_dropped_quoted(@reader_ctx t);
        }
    }
}

# (the names a string's interpolations use, lexed as dn_string reads them)
rd_dc_dropped_quoted=(@reader_ctx:ParserContext token:DewyLexeme):>void=>$unsafe {
    let source:string=reader_ctx.source
    let width:int64=dn_quote_width(source token.start token.stop)
    let i:int64=(int64<overflow='wrap'>(token.start) + int64<overflow='wrap'>(width))
    let stop:int64=(int64<overflow='wrap'>(token.stop) - int64<overflow='wrap'>(width))
    let problem:LiteralProblem=LiteralProblem[message="" at=0 unsupported=false]
    let bytes_:array<uint8>=[]
    loop (i <? stop) {
        i = literal_string_text(@problem @bytes_ source i stop)
        if (((problem.message as array<uint8>).length >? 0) or (i >=? stop)) {
            return
        }
        let first:int64=(int64<overflow='wrap'>(i) + 1)
        i = reader_ctx.stores.host[0].dn_interpolation_close(source first stop)
        let end_:int64=reader_ctx.stores.host[0].spec_colon(source first i)
        if (end_ <? 0) {
            end_ = i
        }
        let inner:array<DewyLexeme>=reader_ctx.stores.host[0].dn_lex(reader_ctx.file first end_ true)
        rd_dc_dropped_names(@reader_ctx inner 0 inner.length);
        i = (int64<overflow='wrap'>(i) + 1)
    }
}

# A parameter binding n repeats one before it: dw_function's mistake, where the parameters are
# certainly a function's (a lambda's, or a declaration's whose `)` meets `=>`, dc_literal_at).
rd_dc_duplicate_parameter=(@reader_ctx:ParserContext @reader_nodes:array<Node> n:int64 certain:bool):>int64=>$unsafe {
    if (certain or ((reader_ctx.reader.dc_literal_at >=? 0) and rd_dc_lambda_next_at(@reader_ctx reader_ctx.reader.dc_literal_at))) {
        reader_ctx.stores.host[0].fatal(reader_nodes[n].pos "duplicate parameter binding '{rd_name_of(@reader_ctx int64<overflow='wrap'>(reader_nodes[n].name))}'");
    }
    0
}

# An effect atom where a type is (`Action<no mutates<Disk>>`, `twice<no_effects>(...)`): no_effects,
# allocates, blocks, panics, `reads<...>`, `mutates<...>`, or one of these after `no` (dw_type's row).
rd_dc_effect_atom_at=(@reader_ctx:ParserContext at:int64):>bool=>$unsafe {
    let token:DewyLexeme=reader_ctx.tokens[at]
    if (token.symbol not=? 'none') {
        return false
    }
    let word:int64=rd_dc_word(@reader_ctx int64<overflow='wrap'>(token.name))
    if ((((word =? DC_NO_EFFECTS) or (word =? DC_ALLOCATES)) or (word =? DC_BLOCKS)) or (word =? DC_PANICS)) {
        return true
    }
    if ((word =? DC_READS) or (word =? DC_MUTATES)) {
        return ((reader_ctx.tokens[(int64<overflow='wrap'>(at) + 1)].symbol =? 'langle') and (not reader_ctx.tokens[(int64<overflow='wrap'>(at) + 1)].space))
    }
    if (int64<overflow='wrap'>(token.name) not=? reader_ctx.reader.dn_no_id) {
        return false
    }
    let next:DewyLexeme=reader_ctx.tokens[(int64<overflow='wrap'>(at) + 1)]
    let following:int64=(if ((next.kind =? 'identifier') and (next.symbol =? 'none')) rd_dc_word(@reader_ctx int64<overflow='wrap'>(next.name)) else int64(0))
    (((((following =? DC_READS) or (following =? DC_MUTATES)) or (following =? DC_ALLOCATES)) or (following =? DC_BLOCKS)) or (following =? DC_PANICS))
}

# A token an effect row's atom may start with (dw_effect_atom reports any other).
rd_dc_effect_atom_start=(token:DewyLexeme):>bool=>$unsafe {
    ((token.kind =? 'identifier') or (token.symbol =? 'kw_not'))
}

# An effect row's entries from dc_parser.at, each after its `&` (`bare`: the first without one, a
# bundle's `$default_row`); false at a form left unread (dc_unread).
rd_dc_effect_entries=(@reader_ctx:ParserContext @entries:array<EffectSyntax> bare:bool):>bool=>$unsafe {
    let empty:bool=false
    let first:bool=bare
    loop (first or rd_dn_accept(@reader_ctx 'amp')) {
        first = false
        let token:DewyLexeme=reader_ctx.tokens[reader_ctx.at]
        let negative:bool=((token.symbol =? 'kw_not') or ((((token.kind =? 'identifier') and (token.symbol =? 'none')) and (int64<overflow='wrap'>(token.name) =? reader_ctx.reader.dn_no_id)) and (reader_ctx.tokens[(int64<overflow='wrap'>(reader_ctx.at) + 1)].kind =? 'identifier')))
        if negative {
            reader_ctx.at = (int64<overflow='wrap'>(reader_ctx.at) + 1)
        }
        let atom:DewyLexeme=reader_ctx.tokens[reader_ctx.at]
        if ((atom.kind not=? 'identifier') or (atom.symbol not=? 'none')) {
            return false
        }
        reader_ctx.at = (int64<overflow='wrap'>(reader_ctx.at) + 1)
        let id:int64=int64<overflow='wrap'>(atom.name)
        let word:int64=rd_dc_word(@reader_ctx id)
        let pos:int64=rd_mkpos(reader_ctx.file atom.start)
        # `reads<x>`, `mutates<grid.cells>`: one place (dw_effect_path)
        if ((((word =? DC_READS) or (word =? DC_MUTATES)) and (rd_dn_peek(@reader_ctx) =? 'langle')) and (not reader_ctx.tokens[reader_ctx.at].space)) {
            if empty {
                return false
            }
            reader_ctx.at = (int64<overflow='wrap'>(reader_ctx.at) + 1)
            let path:array<int64>=[]
            loop true {
                let part:DewyLexeme=reader_ctx.tokens[reader_ctx.at]
                if ((part.kind not=? 'identifier') or (part.symbol not=? 'none')) {
                    return false
                }
                path.push(reader_ctx.stores.host[0].intern(rd_dn_payload(@reader_ctx part)));
                reader_ctx.at = (int64<overflow='wrap'>(reader_ctx.at) + 1)
                if (not rd_dn_accept(@reader_ctx 'dot')) {
                    break
                }
            }
            if (not rd_dn_accept(@reader_ctx 'rangle')) {
                if (not (reader_ctx.reader.dn_edits_on and rd_dn_closer_joined(@reader_ctx))) {
                    return false
                }
                rd_dn_split_closer(@reader_ctx);
            }
            let kind:EffectKind='write'
            if (word =? DC_READS) {
                kind = 'read'
            }
            entries.push(EffectSyntax[kind=kind path=path pos=pos negative=negative]);
            continue
        }
        if ((((rd_dn_peek(@reader_ctx) =? 'langle') or (rd_dn_peek(@reader_ctx) =? 'lparen')) or (rd_dn_peek(@reader_ctx) =? 'dot')) or (rd_dn_peek(@reader_ctx) =? 'lbrack')) {
            return false
        }
        if (word =? DC_NO_EFFECTS) {
            if ((negative or empty) or (entries.length not=? 0)) {
                return false
            }
            empty = true
            continue
        }
        if empty {
            return false
        }
        if (negative and ((word =? DC_READS) or (word =? DC_MUTATES))) {
            entries.push(EffectSyntax[kind=(if (word =? DC_READS) 'read' else 'write') path=[] pos=pos negative=true]);
        }
        else if (word =? DC_ALLOCATES) {
            entries.push(EffectSyntax[kind='alloc' path=[] pos=pos negative=negative]);
        }
        else if (word =? DC_BLOCKS) {
            # (dw_effect_atom's mistakes, noted)
            if ((not negative) and (not rd_dc_granted(@reader_ctx pos "blocks"))) {
                return false
            }
            entries.push(EffectSyntax[kind='block' path=[] pos=pos negative=true]);
            reader_ctx.stores.host[0].g_effect_blocks_demanded_set(true)
        }
        else if (word =? DC_PANICS) {
            if ((not negative) and (not rd_dc_granted(@reader_ctx pos "panics"))) {
                return false
            }
            entries.push(EffectSyntax[kind='panic' path=[] pos=pos negative=true]);
            reader_ctx.stores.host[0].g_effect_panics_demanded_set(true)
        }
        else {
            entries.push(EffectSyntax[kind='opaque' path=[id] pos=pos negative=negative variable=true]);
        }
    }
    true
}

# `:Effect` after a type parameter's name (taken): it names an effect row.
rd_dc_effect_param=(@reader_ctx:ParserContext):>bool=>$unsafe {
    let kind:DewyLexeme=reader_ctx.tokens[(int64<overflow='wrap'>(reader_ctx.at) + 1)]
    if (((rd_dn_peek(@reader_ctx) not=? 'colon') or (kind.kind not=? 'identifier')) or (rd_dn_payload(@reader_ctx kind) not=? "Effect")) {
        return false
    }
    reader_ctx.at = (int64<overflow='wrap'>(reader_ctx.at) + 2)
    true
}

# `:>R & no allocates & no blocks`: a function's effect row, atom by atom
# (dw_effect_result and dw_effect_atom read the same atoms in this order).
rd_dc_effect_row=(@reader_ctx:ParserContext @reader_nodes:array<Node> owner:int64):>bool=>$unsafe {
    let entries:array<EffectSyntax>=[]
    if (not rd_dc_effect_entries(@reader_ctx @entries false)) {
        return false
    }
    reader_ctx.stores.host[0].g_effects_active_set(true)
    reader_ctx.stores.host[0].g_effect_syntax_push(entries);
    reader_nodes[owner].sval = int32<overflow='wrap'>((int64<overflow='wrap'>(reader_ctx.stores.host[0].g_effect_syntax_len()) - 1))
    true
}

# Such an atom: a type naming its row (aux -8, sval the row).
rd_dc_effect_type=(@reader_ctx:ParserContext @reader_nodes:array<Node> token:DewyLexeme):>int64=>$unsafe {
    let entries:array<EffectSyntax>=[]
    if (not rd_dc_effect_entries(@reader_ctx @entries true)) {
        return 0
    }
    reader_ctx.stores.host[0].g_effect_syntax_push(entries);
    let n:int64=node_mk(@reader_nodes 'tname' rd_mkpos(reader_ctx.file token.start))
    reader_nodes[n].aux = (-8)
    reader_nodes[n].sval = int32<overflow='wrap'>((int64<overflow='wrap'>(reader_ctx.stores.host[0].g_effect_syntax_len()) - 1))
    reader_ctx.stores.host[0].g_effects_active_set(true)
    n
}

rd_dc_empty_name=(@reader_ctx:ParserContext):>int64=>$unsafe {
    if (reader_ctx.reader.dc_empty_id <? 0) {
        reader_ctx.reader.dc_empty_id = reader_ctx.stores.host[0].intern("")
    }
    reader_ctx.reader.dc_empty_id
}

# `T & ~value`: T refined to leave value out (dw_type's `& ~`).
rd_dc_excluded=(@reader_ctx:ParserContext @reader_nodes:array<Node> base:int64 value:int64 pos:int64):>int64=>$unsafe {
    let n:int64=node_mk(@reader_nodes 'trefined' pos)
    reader_nodes[n].a = int32<overflow='wrap'>(base)
    let binder:int64=reader_ctx.stores.host[0].intern("$refinement")
    reader_nodes[n].name = int32<overflow='wrap'>(binder)
    let named:int64=node_mk(@reader_nodes 'ident' pos)
    reader_nodes[named].name = int32<overflow='wrap'>(binder)
    let predicate:int64=node_mk(@reader_nodes 'binary' pos)
    reader_nodes[predicate].op = int32<overflow='wrap'>(int64<overflow='wrap'>(int64(70)))
    reader_nodes[predicate].a = int32<overflow='wrap'>(named)
    reader_nodes[predicate].b = int32<overflow='wrap'>(value)
    reader_nodes[n].b = int32<overflow='wrap'>(predicate)
    reader_ctx.stores.host[0].g_refine_active_set(true)
    n
}

rd_dc_expect=(@reader_ctx:ParserContext @reader_nodes:array<Node> token:DewyLexeme fail:bool):>int64=>$unsafe {
    if ((reader_ctx.reader.dc_fn_result not=? 1) and (not rd_dc_expect_context(@reader_ctx token))) {
        return 0
    }
    let pos:int64=rd_mkpos(reader_ctx.file token.start)
    reader_ctx.at = (int64<overflow='wrap'>(reader_ctx.at) + 1)
    let next:DewyLexeme=reader_ctx.tokens[reader_ctx.at]
    let present:bool=((not next.newline) and dn_can_start(@reader_ctx.tokens reader_ctx.at))
    let condition:int64=0
    let message:int64=0
    let first:int64=0
    let stop:int64=0
    let described:string=""
    let saved:bool=reader_ctx.flags.comma_stop
    if fail {
        if present {
            reader_ctx.flags.comma_stop = true
            message = rd_dc_expr(@reader_ctx @reader_nodes 0)
            reader_ctx.flags.comma_stop = saved
            if (message =? 0) {
                return 0
            }
        }
    }
    else {
        if (not present) {
            return 0
        }
        let listed:bool=((next.symbol =? 'lparen') and (not next.space))
        if listed {
            reader_ctx.at = (int64<overflow='wrap'>(reader_ctx.at) + 1)
        }
        first = reader_ctx.at
        let chains:int64=reader_ctx.reader.dc_chains_made
        reader_ctx.flags.comma_stop = true
        condition = rd_dc_expr(@reader_ctx @reader_nodes 0)
        stop = reader_ctx.at
        if ((condition not=? 0) and rd_dn_accept(@reader_ctx 'comma')) {
            message = rd_dc_expr(@reader_ctx @reader_nodes 0)
            if (message =? 0) {
                condition = 0
            }
        }
        reader_ctx.flags.comma_stop = saved
        if (((condition =? 0) or (listed and (not rd_dn_accept(@reader_ctx 'rparen')))) or (reader_ctx.reader.dc_chains_made not=? chains)) {
            return 0
        }
        let source:string=reader_ctx.source
        described = reader_ctx.stores.host[0].join(reader_ctx.stores.host[0].words(reader_ctx.stores.host[0].bytes_slice(source reader_ctx.tokens[first].start reader_ctx.tokens[(int64<overflow='wrap'>(stop) - 1)].stop)) " ")
    }
    if (not rd_dc_statement_ends(@reader_ctx)) {
        return 0
    }
    let where:int64=pos
    let notes:int64=0
    if (condition not=? 0) {
        where = rd_mkpos(reader_ctx.file reader_ctx.tokens[first].start)
        notes = rd_dc_expect_notes(@reader_ctx @reader_nodes condition first stop described pos)
        if (notes =? 0) {
            return 0
        }
    }
    else {
        notes = rd_dw_text(@reader_ctx @reader_nodes "" pos)
    }
    let said:int64=message
    if (said =? 0) {
        said = rd_dw_text(@reader_ctx @reader_nodes "" pos)
    }
    reader_ctx.stores.host[0].dw_expectation(pos where described said notes condition)
}

# `$expect condition [, message]`, `$fail [message]` after its tag, a statement (dw_expect). A form
# dw_expect reports, and a condition holding a comparison chain, are left unread (dc_unread).
# `$expect` outside a function, or in one giving a value (dw_expect's mistakes, noted).
rd_dc_expect_context=(@reader_ctx:ParserContext token:DewyLexeme):>bool=>$unsafe {
    if ((not reader_ctx.flags.report_now) or (reader_ctx.reader.dc_fn_result <? 0)) {
        return false
    }
    let name:string=rd_dn_payload(@reader_ctx token)
    if (reader_ctx.reader.dc_fn_result =? 0) {
        rd_dc_report(@reader_ctx rd_mkpos(reader_ctx.file token.start) "`${name}` belongs in a function: a test, or a helper a test calls");
    }
    else {
        rd_dc_report(@reader_ctx rd_mkpos(reader_ctx.file token.start) "`${name}` returns from its function when it fails, and this function gives a value: expectations live in `void` functions (a test, or a helper it calls); return the value to the test that checks it");
    }
    true
}

# What a failed comparison shows of its operands (dw_expect_notes), the condition read from token
# first up to stop: each place written as a route (`xs.length`, `grid[0 1]`), each other operand
# but a literal as written, with its value read again. 0: an operand not read again.
rd_dc_expect_notes=(@reader_ctx:ParserContext @reader_nodes:array<Node> condition:int64 first:int64 stop:int64 described:string pos:int64):>int64=>$unsafe {
    let root:int64=condition
    # (a parenthesized condition, and a `not` before it, are no comparison)
    if ((reader_ctx.tokens[first].symbol =? 'lparen') and (rd_dc_closing(@reader_ctx first) =? (int64<overflow='wrap'>(stop) - 1))) {
        return rd_dw_text(@reader_ctx @reader_nodes "" pos)
    }
    if (reader_nodes[root].kind =? 'not_') {
        if (reader_ctx.tokens[first].symbol =? 'kw_not') {
            return rd_dw_text(@reader_ctx @reader_nodes "" pos)
        }
        root = int64<overflow='wrap'>(reader_nodes[root].a)
    }
    if (reader_nodes[root].kind not=? 'binary') {
        return rd_dw_text(@reader_ctx @reader_nodes "" pos)
    }
    let t:int64=int64<overflow='wrap'>(reader_nodes[root].op)
    if (not (((((t =? 69) or (t =? 71)) or (t =? 72)) or (t =? 73)) or (t =? 74))) {
        return rd_dw_text(@reader_ctx @reader_nodes "" pos)
    }
    # (the comparison's operator, the first outside brackets)
    let depth:int64=0
    let at:int64=first
    let op:DewyToken='none'
    let right:int64=0
    loop (at <? stop) {
        let symbol:DewyToken=reader_ctx.tokens[at].symbol
        if (((symbol =? 'lparen') or (symbol =? 'lbrack')) or (symbol =? 'lbrace')) {
            depth = (int64<overflow='wrap'>(depth) + 1)
        }
        else if (((symbol =? 'rparen') or (symbol =? 'rbrack')) or (symbol =? 'rbrace')) {
            depth = (int64<overflow='wrap'>(depth) - 1)
        }
        else if (depth =? 0) {
            if (((symbol =? 'kw_not') and ((int64<overflow='wrap'>(at) + 1) <? stop)) and (dn_token_invert(reader_ctx.tokens[(int64<overflow='wrap'>(at) + 1)].symbol) not=? 'none')) {
                op = dn_token_invert(reader_ctx.tokens[(int64<overflow='wrap'>(at) + 1)].symbol)
                right = (int64<overflow='wrap'>(at) + 2)
                break
            }
            let scalar:DewyToken=dn_token_uninvert(symbol)
            if (((((scalar =? 'eq') or (scalar =? 'lt')) or (scalar =? 'le')) or (scalar =? 'gt')) or (scalar =? 'ge')) {
                op = symbol
                right = (int64<overflow='wrap'>(at) + 1)
                break
            }
        }
        at = (int64<overflow='wrap'>(at) + 1)
    }
    if ((right =? 0) or (rd_dc_binary_token(dn_token_uninvert(op)) not=? t)) {
        return 0
    }
    let n:int64=node_mk(@reader_nodes 'str_lit' pos)
    reader_nodes[n].aux = 1
    let pieces:array<int64>=[]
    let texts:array<string>=rd_dw_comparison_sides(@reader_ctx described dn_token_uninvert(op))
    let sides:array<int64>=[int64<overflow='wrap'>(reader_nodes[root].a) int64<overflow='wrap'>(reader_nodes[root].b)]
    let starts:array<int64>=[first right]
    loop i in [0..2) {
        let side:int64=sides[i]
        let shown:string=rd_dc_operand_text(@reader_ctx @reader_nodes side starts[i])
        if (((shown =? "") and (not rd_dc_literal_operand(@reader_ctx @reader_nodes side starts[i]))) and (texts.length =? 2)) {
            shown = texts[i]
        }
        if (shown =? "") {
            continue
        }
        let lead:string="note: "
        if (pieces.length >? 0) {
            lead = "\nnote: "
        }
        pieces.push(rd_dw_text(@reader_ctx @reader_nodes "{lead}{shown} is " pos));
        # (read again: the note evaluates its operand anew)
        let saved_at:int64=reader_ctx.at
        let saved_comma:bool=reader_ctx.flags.comma_stop
        reader_ctx.at = starts[i]
        reader_ctx.flags.comma_stop = true
        let again:int64=rd_dc_expr(@reader_ctx @reader_nodes (int64<overflow='wrap'>(dn_power(op)) + 1))
        reader_ctx.flags.comma_stop = saved_comma
        reader_ctx.at = saved_at
        if (again =? 0) {
            return 0
        }
        let part:int64=node_mk(@reader_nodes 'pair' pos)
        reader_nodes[part].a = int32<overflow='wrap'>(again)
        reader_nodes[part].sval = (-1)
        pieces.push(part);
    }
    if (pieces.length =? 0) {
        return rd_dw_text(@reader_ctx @reader_nodes "" pos)
    }
    node_set_list(@reader_nodes @reader_ctx.stores.lists[0] n pieces);
    n
}

# `$export(` then `name='c_name'` or nothing, through `)` (dw_export_begin): the name as a string.
rd_dc_export_name=(@reader_ctx:ParserContext @reader_nodes:array<Node> pos:int64):>int64=>$unsafe {
    let text:string=""
    loop (not rd_dn_accept(@reader_ctx 'rparen')) {
        let value:DewyLexeme=reader_ctx.tokens[(int64<overflow='wrap'>(reader_ctx.at) + 2)]
        if (((((not rd_dc_named_next(@reader_ctx)) or (rd_dn_payload(@reader_ctx reader_ctx.tokens[reader_ctx.at]) not=? "name")) or (text not=? "")) or (value.kind not=? 'quoted')) or (not rd_dc_plain_quote(@reader_ctx value))) {
            return 0
        }
        let literal:int64=rd_dn_string(@reader_ctx @reader_nodes value)
        if (((literal =? 0) or (reader_nodes[literal].kind not=? 'str_lit')) or (rd_nkids(@reader_nodes literal) >? 0)) {
            return 0
        }
        text = rd_name_of(@reader_ctx int64<overflow='wrap'>(reader_nodes[literal].sval))
        if (text =? "") {
            return 0
        }
        reader_ctx.at = (int64<overflow='wrap'>(reader_ctx.at) + 3)
    }
    let n:int64=node_mk(@reader_nodes 'str_lit' pos)
    reader_nodes[n].sval = int32<overflow='wrap'>(reader_ctx.stores.host[0].intern(text))
    n
}

rd_dc_expr=(@reader_ctx:ParserContext @reader_nodes:array<Node> minimum:int64):>int64=>$unsafe {
    reader_ctx.depth = (int64<overflow='wrap'>(reader_ctx.depth) + 1)
    if ((int64<overflow='wrap'>(reader_ctx.depth) + int64<overflow='wrap'>(reader_ctx.reader.dn_depth)) >? 256) {
        return rd_dc_too_deep(@reader_ctx)
    }
    let opening:DewyLexeme=reader_ctx.tokens[reader_ctx.at]
    let pos:int64=rd_mkpos(reader_ctx.file opening.start)
    let first_at:int64=reader_ctx.at
    let left:int64=0
    # `(params) => body`, `x => body`: a lambda, where `=>` may apply (dw_function)
    # (`x => body` is found at its `=>`, below)
    let lambda:bool=((minimum <=? 30) and (((opening.symbol =? 'lparen') and rd_dc_lambda_next(@reader_ctx)) or ((opening.symbol =? 'langle') and rd_dc_generic_lambda_next(@reader_ctx))))
    if lambda {
        let type_params:array<int64>=[]
        if (opening.symbol =? 'langle') {
            # `<T>(x:T) => x`: a generic lambda
            type_params = rd_dc_type_params(@reader_ctx @reader_nodes)
            if (type_params.length =? 0) {
                return 0
            }
        }
        else {
            reader_ctx.at = (int64<overflow='wrap'>(reader_ctx.at) + 1)
        }
        reader_ctx.depth = (int64<overflow='wrap'>(reader_ctx.depth) + 3)
        left = rd_dc_function_literal(@reader_ctx @reader_nodes int32<overflow='wrap'>(rd_dc_empty_name(@reader_ctx)) opening type_params true)
    }
    else {
        # A plain name is the common atom. Keep its construction in this loop:
        # passing context and nodes to the general atom reader otherwise spills
        # its cold paths' registers for every name. Special names still go there.
        if opening.kind =? 'identifier' and (opening.symbol =? 'none' or opening.symbol =? 'kw_test') and int64(opening.name) not=? reader_ctx.reader.dn_end_id and int64(opening.name) not=? reader_ctx.reader.dn_new_id and int64(opening.name) not=? reader_ctx.reader.dn_type_id and int64(opening.name) not=? reader_ctx.reader.dn_none_id {
            reader_ctx.at = int64<overflow='wrap'>(reader_ctx.at) + 1
            left = node_mk(@reader_nodes 'ident' pos)
            reader_nodes[left].name = rd_dw_value_name(@reader_ctx opening.name pos)
        } else {
            left = rd_dc_atom(@reader_ctx @reader_nodes)
        }
    }
    if (left =? 0) {
        return 0
    }
    # (a name, a field route or a parenthesized group: `head(...)` may be a coefficient)
    let juxt_head:bool=((not lambda) and ((opening.symbol =? 'lparen') or ((opening.kind =? 'identifier') and (reader_nodes[left].kind =? 'ident'))))
    # (a parenthesized group, while nothing has applied to it: `(5)x`, `(x)2` multiply)
    let group:int64=(if (((not lambda) and (opening.symbol =? 'lparen')) and (reader_ctx.tokens[(int64<overflow='wrap'>(reader_ctx.at) - 1)].symbol =? 'rparen')) left else int64((-1)))
    # (the call this loop made last: a member or index right after it is marked)
    let last_call:int64=0
    # (left is a comparison this loop made)
    let compared:bool=false
    # (its operator, and where its right operand starts)
    let compared_op:DewyToken='none'
    let compared_at:int64=0
    # (the chain being read: its first entry in dc_chain_ops, dc_chain_build)
    let chain:int64=(-1)
    loop true {
        let token:DewyLexeme=reader_ctx.tokens[reader_ctx.at]
        let op:DewyToken=token.symbol
        if ((chain >=? 0) and (not rd_dc_chain_goes_on(@reader_ctx token minimum))) {
            left = rd_dc_chain_build(@reader_ctx @reader_nodes chain pos)
            chain = (-1)
            if (left =? 0) {
                return 0
            }
        }
        # Delimiters have no continuation here; chain closure above still runs first.
        if op =? 'rparen' or op =? 'rbrack' or op =? 'rbrace' or op =? 'semi' or (op =? 'none' and token.space) {break}
        if (token.kind =? 'eof') {
            break
        }
        if ((token.newline and (dn_power(op) =? 0)) and (op not=? 'kw_not')) {
            break
        }
        if ((reader_ctx.reader.dn_angles >? 0) and ((((op =? 'shr') or (op =? 'shr_assign')) or (op =? 'angle_assign')) or ((op =? 'gt') and (not token.space)))) {
            break
        }
        if ((not token.space) and (((((token.kind =? 'identifier') or (op =? 'lparen')) or (token.kind =? 'source_integer')) or (token.kind =? 'source_real')) or (token.kind =? 'integer'))) {
            let pk:DewyKind=reader_ctx.tokens[(int64<overflow='wrap'>(reader_ctx.at) - 1)].kind
            if (((((left =? group) or (pk =? 'source_integer')) or (pk =? 'source_real')) or (pk =? 'integer')) and dn_juxtaposed(@reader_ctx.tokens reader_ctx.at (left =? group))) {
                if (minimum >? 135) {
                    break
                }
                let right:int64=rd_dc_expr(@reader_ctx @reader_nodes 136)
                if (right =? 0) {
                    return 0
                }
                left = rd_dc_binary(@reader_ctx @reader_nodes 'multiply_apply' left right pos)
                rd_add_flag(@reader_nodes left NF_JUXT);
                juxt_head = false
                continue
            }
            if ((op not=? 'lparen') and dn_juxt_excluded(@reader_ctx.tokens reader_ctx.at)) {
                return rd_dc_juxt_mistake(@reader_ctx)
            }
        }
        if ((op =? 'dot') and (minimum <=? 170)) {
            reader_ctx.at = (int64<overflow='wrap'>(reader_ctx.at) + 1)
            let member:DewyLexeme=reader_ctx.tokens[reader_ctx.at]
            # `f.(xs)`: the call broadcast over its arguments; `value.$field(name)`: a member named
            # by a compile-time string
            if (((member.symbol =? 'lparen') and (not member.space)) or (member.kind =? 'metatag')) {
                left = rd_dc_dot_form(@reader_ctx @reader_nodes left (left =? last_call) pos)
                if (left =? 0) {
                    return 0
                }
                if (reader_nodes[left].kind =? 'call') {
                    juxt_head = false
                }
                continue
            }
            if (member.kind not=? 'identifier') {
                return rd_dc_member_mistake(@reader_ctx member)
            }
            reader_ctx.at = (int64<overflow='wrap'>(reader_ctx.at) + 1)
            # `$target.arch`, `$target.os`: that part of the name (dw_target_field)
            if ((((reader_ctx.reader.dc_targets_made >? 0) and (left =? (int64<overflow='wrap'>(reader_nodes.length) - 1))) and (rd_dc_target_of(@reader_ctx @reader_nodes left) =? 0)) and rd_dc_target_member(@reader_ctx @reader_nodes left member)) {
                continue
            }
            let n:int64=node_mk(@reader_nodes 'field' pos)
            reader_nodes[n].a = int32<overflow='wrap'>(left)
            reader_nodes[n].name = member.name
            if (left =? last_call) {
                rd_add_flag(@reader_nodes n NF_JUXT);
            }
            reader_ctx.stores.host[0].dewy_note_member(n);
            left = n
            continue
        }
        if (((not token.space) and (op =? 'lparen')) and (minimum <=? 170)) {
            reader_ctx.at = (int64<overflow='wrap'>(reader_ctx.at) + 1)
            let n:int64=node_mk(@reader_nodes 'call' pos)
            reader_nodes[n].a = int32<overflow='wrap'>(left)
            if juxt_head {
                rd_add_flag(@reader_nodes n NF_JUXT);
            }
            if (reader_nodes[left].kind =? 'field') {
                rd_add_flag(@reader_nodes int64<overflow='wrap'>(reader_nodes[left].a) NF_MUT);
            }
            # (`members(<'a' | 1>)`: members(U) takes a type, grouped as in a type position)
            if (((rd_dn_peek(@reader_ctx) =? 'langle') and (reader_nodes[left].kind =? 'ident')) and rd_dc_named_members(@reader_ctx @reader_nodes left)) {
                if (not rd_dc_members_type(@reader_ctx @reader_nodes n)) {
                    return 0
                }
                left = n
                last_call = n
                juxt_head = false
                continue
            }
            if (not rd_dc_arguments(@reader_ctx @reader_nodes n 'rparen')) {
                return 0
            }
            left = n
            last_call = n
            juxt_head = false
            continue
        }
        # `xs[i]`, `Point[x y]`, `Point[x=1 y=2]`; ranges, `end`, `new` and
        # `set[...]` are left unread (dc_unread).
        if (((not token.space) and (op =? 'lbrack')) and (minimum <=? 170)) {
            # `set[a b]`: a set of the literal's elements (dw_expr's `__dewy_set`)
            if (((reader_nodes[left].kind =? 'ident') and (rd_dc_word(@reader_ctx int64<overflow='wrap'>(reader_nodes[left].name)) =? DC_SET)) and (left =? (int64<overflow='wrap'>(reader_nodes.length) - 1))) {
                let elements:int64=rd_dc_atom(@reader_ctx @reader_nodes)
                if (elements =? 0) {
                    return 0
                }
                left = rd_dc_set_call(@reader_ctx @reader_nodes elements pos)
                juxt_head = false
                continue
            }
            reader_ctx.at = (int64<overflow='wrap'>(reader_ctx.at) + 1)
            let n:int64=node_mk(@reader_nodes 'index' pos)
            reader_nodes[n].a = int32<overflow='wrap'>(left)
            if (left =? last_call) {
                rd_add_flag(@reader_nodes n NF_JUXT);
            }
            # (`end` inside is this index's last: dw_index_context)
            let saved_index:int64=reader_ctx.reader.dc_index_node
            reader_ctx.reader.dc_index_node = n
            let read:bool=rd_dc_index(@reader_ctx @reader_nodes n)
            reader_ctx.reader.dc_index_node = saved_index
            if (not read) {
                return 0
            }
            reader_nodes[n].aux2 = 0
            left = n
            juxt_head = false
            continue
        }
        # `f<T>(x)`: the application as a type, and its arguments again as types
        if (((not token.space) and (op =? 'langle')) and (minimum <=? 160)) {
            # (`b.read<uint64>(2)`: a module's name, dw_type's `.`)
            let name_token:DewyLexeme=reader_ctx.tokens[(int64<overflow='wrap'>(reader_ctx.at) - 1)]
            let first:int64=(int64<overflow='wrap'>(reader_ctx.at) - 1)
            if (not rd_dc_named_base(@reader_nodes left)) {
                left = rd_dc_type_applied(@reader_ctx @reader_nodes left pos)
                if (left =? 0) {
                    return 0
                }
                juxt_head = false
                continue
            }
            if ((((((reader_nodes[left].kind =? 'field') and (reader_ctx.at >=? 3)) and (reader_ctx.tokens[(int64<overflow='wrap'>(reader_ctx.at) - 2)].symbol =? 'dot')) and (reader_ctx.tokens[(int64<overflow='wrap'>(reader_ctx.at) - 3)].kind =? 'identifier')) and (reader_nodes[int64<overflow='wrap'>(reader_nodes[left].a)].kind =? 'ident')) and (reader_nodes[int64<overflow='wrap'>(reader_nodes[left].a)].pos =? rd_mkpos(reader_ctx.file reader_ctx.tokens[(int64<overflow='wrap'>(reader_ctx.at) - 3)].start))) {
                first = (int64<overflow='wrap'>(reader_ctx.at) - 3)
            }
            else if (((reader_nodes[left].kind not=? 'ident') or (name_token.kind not=? 'identifier')) or (reader_nodes[left].pos not=? rd_mkpos(reader_ctx.file name_token.start))) {
                return 0
            }
            let at:int64=reader_ctx.at
            reader_ctx.at = first
            let edits:int64=reader_ctx.reader.dn_edit_at.length
            let whole:int64=rd_dc_type_named(@reader_ctx @reader_nodes)
            # (`small = int64<i => ...>`: a refinement names a type, dw_top_declarations)
            if ((whole =? 0) or (reader_nodes[whole].kind =? 'trefined')) {
                return 0
            }
            let stop:int64=reader_ctx.at
            let n:int64=node_mk(@reader_nodes 'typeapply' pos)
            reader_nodes[n].a = int32<overflow='wrap'>(left)
            reader_nodes[n].c = int32<overflow='wrap'>(whole)
            let args:array<int64>=[]
            # (`int64<overflow='wrap'>(x)`: a policy is no type argument)
            if (reader_nodes[whole].aux not=? (-9)) {
                # (the arguments read again from their original tokens: a closer split again)
                rd_dn_edits_undo(@reader_ctx edits);
                reader_ctx.at = (int64<overflow='wrap'>(at) + 1)
                loop (not rd_dn_accept(@reader_ctx 'rangle')) {
                    let arg:int64=rd_dc_annotation(@reader_ctx @reader_nodes)
                    if (arg =? 0) {
                        return 0
                    }
                    args.push(arg);
                }
                if (reader_ctx.at not=? stop) {
                    return 0
                }
            }
            node_set_list(@reader_nodes @reader_ctx.stores.lists[0] n args);
            left = n
            juxt_head = false
            continue
        }
        if ((op =? 'kw_or_throw') and (minimum <=? 48)) {
            reader_ctx.at = (int64<overflow='wrap'>(reader_ctx.at) + 1)
            let n:int64=node_mk(@reader_nodes 'propagate' pos)
            reader_nodes[n].a = int32<overflow='wrap'>(left)
            left = n
            juxt_head = false
            continue
        }
        if (((not token.space) and ((token.kind =? 'quoted') or (token.kind =? 'rawquoted'))) and (minimum <=? 170)) {
            # `b'a'`, `b"abc"`: a byte, or an array of bytes (dw_byte_literal)
            if ((reader_nodes[left].kind =? 'ident') and (rd_dc_word(@reader_ctx int64<overflow='wrap'>(reader_nodes[left].name)) =? DC_B)) {
                let written:DewyLexeme=reader_ctx.tokens[(int64<overflow='wrap'>(reader_ctx.at) - 1)]
                if ((written.kind not=? 'identifier') or (reader_nodes[left].pos not=? rd_mkpos(reader_ctx.file written.start))) {
                    return 0
                }
                let literal:int64=rd_dc_byte_literal(@reader_ctx @reader_nodes token)
                if (literal =? 0) {
                    return 0
                }
                reader_ctx.at = (int64<overflow='wrap'>(reader_ctx.at) + 1)
                left = literal
                last_call = literal
                juxt_head = false
                continue
            }
            reader_ctx.at = (int64<overflow='wrap'>(reader_ctx.at) + 1)
            let arg:int64=rd_dn_string(@reader_ctx @reader_nodes token)
            if (arg =? 0) {
                return 0
            }
            let n:int64=node_mk(@reader_nodes 'call' pos)
            reader_nodes[n].a = int32<overflow='wrap'>(left)
            if (reader_nodes[left].kind =? 'field') {
                rd_add_flag(@reader_nodes int64<overflow='wrap'>(reader_nodes[left].a) NF_MUT);
            }
            node_set_list(@reader_nodes @reader_ctx.stores.lists[0] n [arg]);
            left = n
            last_call = n
            juxt_head = false
            continue
        }
        if ((op =? 'kw_not') and ((int64<overflow='wrap'>(reader_ctx.at) + 1) <? reader_ctx.tokens.length)) {
            let inverted:DewyToken=dn_token_invert(reader_ctx.tokens[(int64<overflow='wrap'>(reader_ctx.at) + 1)].symbol)
            if (inverted not=? 'none') {
                op = inverted
            }
        }
        if ((op =? 'comma') and reader_ctx.flags.comma_stop) {
            break
        }
        # `x => body`: the name just read is a lambda's one parameter
        if (((((((op =? 'function') and (minimum <=? 30)) and (left =? (int64<overflow='wrap'>(reader_nodes.length) - 1))) and (reader_nodes[left].kind =? 'ident')) and (opening.kind =? 'identifier')) and (reader_ctx.tokens[(int64<overflow='wrap'>(reader_ctx.at) - 1)].start =? opening.start)) and rd_dc_lambda_next_at(@reader_ctx (int64<overflow='wrap'>(reader_ctx.at) - 1))) {
            reader_nodes.truncate(left);
            reader_ctx.at = (int64<overflow='wrap'>(reader_ctx.at) - 1)
            reader_ctx.depth = (int64<overflow='wrap'>(reader_ctx.depth) + 3)
            left = rd_dc_function_literal(@reader_ctx @reader_nodes int32<overflow='wrap'>(rd_dc_empty_name(@reader_ctx)) opening [] true true)
            if (left =? 0) {
                return 0
            }
            juxt_head = false
            group = (-1)
            continue
        }
        # (`key -> value` as a comprehension's element: dc_body_read pairs them)
        if (reader_ctx.reader.dc_map_ok and (op =? 'arrow')) {
            break
        }
        let power:int64=dn_power(op)
        if ((power =? 0) or (power <? minimum)) {
            break
        }
        # (a slice's first bound ends at its `..`; elsewhere a range is left unread (dc_unread))
        # (`evens = 0,2..100`: a stepped range's two starts, below)
        let step:int64=0
        if ((((op =? 'comma') and (reader_ctx.reader.dc_index_node =? 0)) and (reader_ctx.reader.dc_member_depth not=? reader_ctx.depth)) and (minimum <=? dn_power('range'))) {
            reader_ctx.at = (int64<overflow='wrap'>(reader_ctx.at) + 1)
            step = rd_dc_expr(@reader_ctx @reader_nodes (int64<overflow='wrap'>(power) + 1))
            if ((step =? 0) or (rd_dn_peek(@reader_ctx) not=? 'range')) {
                # (`[1, 2, 3]`: commas after the first element, not a stepped range's starts;
                # dw_comma_fail's mistake, should nothing else read it)
                if ((((step not=? 0) and (first_at >? 0)) and (reader_ctx.tokens[(int64<overflow='wrap'>(first_at) - 1)].symbol =? 'lbrack')) and (not rd_dc_range_follows(@reader_ctx reader_ctx.at))) {
                    rd_dc_hint(@reader_ctx pos rd_dc_comma_text());
                }
                return 0
            }
            op = 'range'
            power = dn_power(op)
        }
        if (op =? 'range') {
            if ((reader_ctx.reader.dc_range_top and (minimum =? 0)) and (step =? 0)) {
                break
            }
            # (`x in? a..b`, `x in? a..`: the range itself, dw_membership; elsewhere `a..b` and
            # `a,b..c` are range values, dw_range_value)
            let member:bool=(reader_ctx.reader.dc_member_depth =? reader_ctx.depth)
            if ((not member) and ((reader_ctx.reader.dc_index_node not=? 0) or reader_ctx.reader.dc_range_top)) {
                return 0
            }
            reader_ctx.at = (int64<overflow='wrap'>(reader_ctx.at) + 1)
            let last:int64=0
            if dn_range_bound(@reader_ctx.tokens reader_ctx.at) {
                last = rd_dc_expr(@reader_ctx @reader_nodes (int64<overflow='wrap'>(power) + 1))
                if (last =? 0) {
                    return 0
                }
            }
            let n:int64=node_mk(@reader_nodes 'range' pos)
            reader_nodes[n].a = int32<overflow='wrap'>(left)
            reader_nodes[n].b = int32<overflow='wrap'>(last)
            rd_add_flag(@reader_nodes n NF_INCLUSIVE);
            if (step not=? 0) {
                if member {
                    return 0
                }
                reader_nodes[n].c = int32<overflow='wrap'>(step)
                rd_add_flag(@reader_nodes n NF_STEP);
            }
            left = n
            if (not member) {
                if (last =? 0) {
                    return 0
                }
                left = reader_ctx.stores.host[0].dw_range_value(n)
            }
            juxt_head = false
            continue
        }
        if ((((op =? 'plus') or (op =? 'minus')) and token.space) and (not reader_ctx.tokens[(int64<overflow='wrap'>(reader_ctx.at) + 1)].space)) {
            break
        }
        # `x is? T`, `x isnt? T`, `x as T`, `x transmute T`: a type on the right
        if ((token.symbol =? op) and ((((op =? 'is_type') or (op =? 'isnt_type')) or (op =? 'kw_as')) or (op =? 'kw_transmute'))) {
            if (compared and ((op =? 'is_type') or (op =? 'isnt_type'))) {
                return 0
            }
            reader_ctx.at = (int64<overflow='wrap'>(reader_ctx.at) + 1)
            let t:int64=rd_dc_cast_type(@reader_ctx @reader_nodes (op =? 'kw_as') power)
            if (t =? 0) {
                return 0
            }
            let n:int64=node_mk(@reader_nodes (if ((op =? 'kw_as') or (op =? 'kw_transmute')) 'cast' else 'istype') pos)
            reader_nodes[n].a = int32<overflow='wrap'>(left)
            reader_nodes[n].b = int32<overflow='wrap'>(t)
            if (op =? 'kw_transmute') {
                reader_nodes[n].aux2 = 1
            }
            if (op =? 'isnt_type') {
                let inverted:int64=node_mk(@reader_nodes 'not_' pos)
                reader_nodes[inverted].a = int32<overflow='wrap'>(n)
                n = inverted
            }
            left = n
            compared = false
            juxt_head = false
            continue
        }
        # `a ?? b`: an arithmetic fallback (`a ?? 1 + n`) has a warning of its own
        if (op =? 'coalesce') {
            # `x ??<A | B> fallback`: the fallback only for the kinds listed, one type (c)
            if ((((int64<overflow='wrap'>(reader_ctx.at) + 1) <? reader_ctx.tokens.length) and (not reader_ctx.tokens[(int64<overflow='wrap'>(reader_ctx.at) + 1)].space)) and ((reader_ctx.tokens[(int64<overflow='wrap'>(reader_ctx.at) + 1)].symbol =? 'langle') or (reader_ctx.tokens[(int64<overflow='wrap'>(reader_ctx.at) + 1)].symbol =? 'lt'))) {
                left = rd_dc_listed_coalesce(@reader_ctx @reader_nodes left power pos)
                if (left =? 0) {
                    return 0
                }
                compared = false
                juxt_head = false
                continue
            }
            reader_ctx.at = (int64<overflow='wrap'>(reader_ctx.at) + 1)
            let right_at:int64=reader_ctx.at
            let right:int64=rd_dc_expr(@reader_ctx @reader_nodes power)
            if (right =? 0) {
                return 0
            }
            rd_dc_coalesce_arithmetic(@reader_ctx @reader_nodes left first_at right right_at);
            let n:int64=node_mk(@reader_nodes 'coalesce' pos)
            reader_nodes[n].a = int32<overflow='wrap'>(left)
            reader_nodes[n].b = int32<overflow='wrap'>(right)
            left = n
            compared = false
            juxt_head = false
            continue
        }
        # `x |> f`, `f <| x`: the value supplied to the callable (dw_expr's pipes)
        if ((op =? 'pipe_right') or (op =? 'pipe_left')) {
            left = rd_dc_pipe(@reader_ctx @reader_nodes op left power pos)
            if (left =? 0) {
                return 0
            }
            compared = false
            juxt_head = false
            continue
        }
        # `a nand b`: `not (a and b)`, as `nor` and `xnor` are of `or` and `xor` (the `not` at the word)
        if (((op =? 'kw_nand') or (op =? 'kw_nor')) or (op =? 'kw_xnor')) {
            left = rd_dc_word_not(@reader_ctx @reader_nodes op left power pos)
            if (left =? 0) {
                return 0
            }
            compared = false
            juxt_head = false
            continue
        }
        let scalar_op:DewyToken=dn_token_uninvert(op)
        if (((((rd_dc_binary_token(scalar_op) =? 0) and (op not=? 'slash')) and (op not=? 'floor')) and (op not=? 'percent')) and (op not=? 'caret')) {
            # (`xs[1:2]`, `if c:`, `item in xs`, `[@n]() => n`: the mistakes of operators no value
            # takes, dc_colon)
            if (op =? 'colon') {
                let way:int64=rd_dc_colon(@reader_ctx @reader_nodes left pos minimum)
                if (way =? 0) {
                    return 0
                }
                if (way =? 2) {
                    break
                }
                continue
            }
            if (op =? 'kw_in') {
                if (rd_dc_in_mistake(@reader_ctx @reader_nodes pos) =? 0) {
                    return 0
                }
                continue
            }
            if (op =? 'function') {
                if (rd_dc_capture_list(@reader_ctx @reader_nodes left pos first_at) =? 0) {
                    return 0
                }
                continue
            }
            # `xs .+ ys`, `a .* 2`: elementwise (dw_broadcast)
            let scalar:DewyToken=dn_token_undot(op)
            if ((scalar =? 'none') or (token.symbol not=? op)) {
                return rd_dc_operator_mistake(@reader_ctx)
            }
            reader_ctx.at = (int64<overflow='wrap'>(reader_ctx.at) + 1)
            let right:int64=rd_dc_expr(@reader_ctx @reader_nodes (if dn_right_associative(op) power else (int64<overflow='wrap'>(power) + 1)))
            if (right =? 0) {
                return 0
            }
            left = rd_dc_broadcast(@reader_ctx @reader_nodes scalar left right pos)
            if (left =? 0) {
                return 0
            }
            compared = false
            juxt_head = false
            continue
        }
        # `a <? b <=? c`: a comparison chain (dw_chain), its links read in order; one through
        # `not` is left unread (dc_unread)
        let chained:bool=((dw_chain_way(scalar_op) not=? 2) or (scalar_op =? 'not_eq'))
        if (chained and compared) {
            if ((token.symbol not=? op) or (scalar_op not=? op)) {
                return rd_dc_not_chain(@reader_ctx pos)
            }
            if (chain <? 0) {
                if ((reader_nodes[left].kind not=? 'binary') or (dn_token_uninvert(compared_op) not=? compared_op)) {
                    return rd_dc_not_chain(@reader_ctx pos)
                }
                chain = reader_ctx.reader.dc_chain_ops.length
                rd_dc_chain_push(@reader_ctx 'none' int64<overflow='wrap'>(reader_nodes[left].a) first_at);
                rd_dc_chain_push(@reader_ctx compared_op int64<overflow='wrap'>(reader_nodes[left].b) compared_at);
            }
            reader_ctx.at = (int64<overflow='wrap'>(reader_ctx.at) + 1)
            let at:int64=reader_ctx.at
            let right:int64=rd_dc_expr(@reader_ctx @reader_nodes (int64<overflow='wrap'>(power) + 1))
            if (right =? 0) {
                return 0
            }
            rd_dc_chain_push(@reader_ctx op right at);
            continue
        }
        reader_ctx.at = (int64<overflow='wrap'>(reader_ctx.at) + 1)
        if (token.symbol =? 'kw_not') {
            reader_ctx.at = (int64<overflow='wrap'>(reader_ctx.at) + 1)
        }
        let membership:bool=((op =? 'contains') or (op =? 'not_contains'))
        if membership {
            reader_ctx.reader.dc_range_call = 0
        }
        compared_op = op
        compared_at = reader_ctx.at
        let saved_member:int64=reader_ctx.reader.dc_member_depth
        if membership {
            reader_ctx.reader.dc_member_depth = (int64<overflow='wrap'>(reader_ctx.depth) + 1)
        }
        let right:int64=rd_dc_expr(@reader_ctx @reader_nodes (if dn_right_associative(op) power else (int64<overflow='wrap'>(power) + 1)))
        reader_ctx.reader.dc_member_depth = saved_member
        if (right =? 0) {
            return 0
        }
        # (`x in? [0..9]`: membership in the range itself, dw_membership)
        if (membership and (reader_ctx.reader.dc_range_call =? right)) {
            if ((not rd_has_flag(@reader_nodes reader_ctx.reader.dc_range_node NF_STEP)) and (not rd_has_flag(@reader_nodes reader_ctx.reader.dc_range_node NF_EXCL_FIRST))) {
                right = reader_ctx.reader.dc_range_node
            }
            else # (in a refinement's predicate the range itself, whatever its bounds: dc_ref_ranges)
            if (reader_ctx.reader.dc_refining >? 0) {
                rd_dc_note_member_range(@reader_ctx right);
            }
        }
        # (`f & g` of function literals: an overload group, declared at module level only)
        if (((op =? 'amp') and (rd_dc_overloads(@reader_nodes left) or rd_dc_overloads(@reader_nodes right))) and (not rd_dc_local_group(@reader_ctx first_at minimum))) {
            return 0
        }
        # (`a(x)^2` with the call unparenthesized: the power may take the group, juxtapose.jo)
        let powered_call:bool=((op =? 'caret') and (left =? last_call))
        left = rd_dc_binary(@reader_ctx @reader_nodes op left right pos)
        if powered_call {
            rd_add_flag(@reader_nodes left NF_JUXT);
        }
        compared = chained
        juxt_head = false
    }
    if (chain >=? 0) {
        left = rd_dc_chain_build(@reader_ctx @reader_nodes chain pos)
        if (left =? 0) {
            return 0
        }
    }
    # These suffixes belong to this expression, but have not migrated yet.
    let token:DewyLexeme=reader_ctx.tokens[reader_ctx.at]
    if ((not token.space) and ((((token.symbol =? 'lbrack') or (token.symbol =? 'langle')) or (token.kind =? 'quoted')) or (token.kind =? 'rawquoted'))) {
        return 0
    }
    if ((token.symbol =? 'question') or (token.symbol =? 'ellipsis')) {
        # (`xs...` as a whole array element: dc_spread_depth; anywhere else unread)
        if ((token.symbol =? 'question') or (minimum >? 170)) {
            return 0
        }
        if (reader_ctx.depth not=? reader_ctx.reader.dc_spread_depth) {
            if ((not reader_ctx.flags.report_now) or (rd_dc_spread_outside(@reader_ctx pos) =? 0)) {
                return 0
            }
            reader_ctx.depth = (int64<overflow='wrap'>(reader_ctx.depth) - 1)
            return left
        }
        let after:DewyLexeme=reader_ctx.tokens[(int64<overflow='wrap'>(reader_ctx.at) + 1)]
        if (((((not (((after.space or after.newline) or (after.symbol =? 'rbrack')) or (after.symbol =? 'rparen'))) or (dn_power(after.symbol) >? 0)) or (after.symbol =? 'dot')) or (after.symbol =? 'question')) or (after.symbol =? 'ellipsis')) {
            return 0
        }
        reader_ctx.at = (int64<overflow='wrap'>(reader_ctx.at) + 1)
        rd_add_flag(@reader_nodes left NF_SPREAD);
    }
    reader_ctx.depth = (int64<overflow='wrap'>(reader_ctx.depth) - 1)
    left
}

# An expression as a statement (dw_stmt); with its `;`, its value discarded (at `ended`, where
# the statement starts).
rd_dc_expression_statement=(@reader_ctx:ParserContext @reader_nodes:array<Node> ended:int64 at:int64 read:int64):>int64=>$unsafe {
    let value:int64=read
    let first:int64=reader_ctx.at
    if (value =? 0) {
        value = rd_dc_expr(@reader_ctx @reader_nodes 0)
    }
    if (((value =? 0) or (reader_nodes[value].kind =? 'lambda')) or (((read =? 0) and (reader_ctx.reader.dc_live_at =? first)) and (reader_ctx.tokens[first].symbol =? 'kw_if'))) {
        return 0
    }
    if rd_dn_accept_semi(@reader_ctx) {
        let n:int64=node_mk(@reader_nodes 'assign' ended)
        reader_nodes[n].op = int32<overflow='wrap'>(int64<overflow='wrap'>(int64(47)))
        reader_nodes[n].a = int32<overflow='wrap'>(node_mk(@reader_nodes 'hole' ended))
        reader_nodes[n].b = int32<overflow='wrap'>(value)
        return n
    }
    let n:int64=node_mk(@reader_nodes 'exprstmt' at)
    reader_nodes[n].a = int32<overflow='wrap'>(value)
    n
}

rd_dc_extern=(@reader_ctx:ParserContext @reader_nodes:array<Node> n:int64 ps:array<int64>):>int64=>$unsafe {
    reader_ctx.at = (int64<overflow='wrap'>(reader_ctx.at) + 1)
    let pos:int64=reader_nodes[n].pos
    # (dw_extern_finish's mistakes, noted: a lambda, no result type)
    if ((reader_nodes[n].kind =? 'lambda') or (((not rd_has_flag(@reader_nodes n NF_GENERIC)) and (reader_nodes[n].a =? 0)) and (not rd_has_flag(@reader_nodes n NF_VOID)))) {
        if (not reader_ctx.flags.report_now) {
            return 0
        }
        if (reader_nodes[n].kind =? 'lambda') {
            rd_dc_report(@reader_ctx pos "`$extern` declares a module-level function: `strlen = (s:ptr<uint8>):>uint64 => $extern`");
        }
        else {
            rd_dc_report(@reader_ctx pos "a `$extern` function states its result type, `:>int32` or `:>void`: there is no body to infer it from");
        }
    }
    if rd_has_flag(@reader_nodes n NF_GENERIC) {
        return rd_dc_extern_mistake(@reader_ctx pos "a `$extern` function cannot be generic: C has one signature per symbol")
    }
    let symbol:string=""
    let library:string=""
    let listed_lib:bool=false
    if ((rd_dn_peek(@reader_ctx) =? 'lparen') and (not reader_ctx.tokens[reader_ctx.at].space)) {
        reader_ctx.at = (int64<overflow='wrap'>(reader_ctx.at) + 1)
        loop (not rd_dn_accept(@reader_ctx 'rparen')) {
            let arg:DewyLexeme=reader_ctx.tokens[reader_ctx.at]
            if (not rd_dc_named_next(@reader_ctx)) {
                return rd_dc_extern_mistake(@reader_ctx rd_mkpos(reader_ctx.file arg.start) "`$extern` takes keyword arguments: name=, lib=")
            }
            let key:string=rd_dn_payload(@reader_ctx arg)
            let value:DewyLexeme=reader_ctx.tokens[(int64<overflow='wrap'>(reader_ctx.at) + 2)]
            if ((key not=? "name") and (key not=? "lib")) {
                return rd_dc_extern_mistake(@reader_ctx rd_mkpos(reader_ctx.file arg.start) "`$extern` takes keyword arguments: name=, lib=")
            }
            if ((value.kind not=? 'quoted') or (not rd_dc_plain_quote(@reader_ctx value))) {
                return rd_dc_extern_mistake(@reader_ctx rd_mkpos(reader_ctx.file value.start) "`$extern({key}=...)` takes a string literal")
            }
            reader_ctx.at = (int64<overflow='wrap'>(reader_ctx.at) + 3)
            let source:string=reader_ctx.source
            let width:int64=dn_quote_width(source value.start value.stop)
            let stop:int64=(int64<overflow='wrap'>(value.stop) - int64<overflow='wrap'>(width))
            let problem:LiteralProblem=LiteralProblem[message="" at=0 unsupported=false]
            let bytes_:array<uint8>=[]
            if ((literal_string_text(@problem @bytes_ source (int64<overflow='wrap'>(value.start) + int64<overflow='wrap'>(width)) stop) <? stop) or ((problem.message as array<uint8>).length >? 0)) {
                return 0
            }
            if (((key =? "name") and (symbol not=? "")) or ((key =? "lib") and listed_lib)) {
                return rd_dc_extern_mistake(@reader_ctx rd_mkpos(reader_ctx.file arg.start) "`{key}=` is given twice")
            }
            if (bytes_.length =? 0) {
                return rd_dc_extern_mistake(@reader_ctx rd_mkpos(reader_ctx.file value.start) "`{key}=` needs a name")
            }
            let text:string=reader_ctx.stores.host[0].str_from_bytes(bytes_)
            if (key =? "name") {
                symbol = text
            }
            else {
                listed_lib = true
                library = text
            }
        }
    }
    loop p in ps {
        if rd_has_flag(@reader_nodes p NF_MUT) {
            return rd_dc_extern_mistake(@reader_ctx reader_nodes[p].pos "a C function takes values, not `@` places: pass a `ptr<T>`")
        }
        if (reader_nodes[p].b not=? 0) {
            return rd_dc_extern_mistake(@reader_ctx reader_nodes[p].pos "a `$extern` parameter has no default: C gives every argument")
        }
        if (reader_nodes[p].a =? 0) {
            return rd_dc_extern_mistake(@reader_ctx reader_nodes[p].pos "a `$extern` parameter states its type: C has one signature per symbol")
        }
        if (rd_nkids(@reader_nodes p) >? 0) {
            return rd_dc_extern_mistake(@reader_ctx reader_nodes[p].pos "a `$extern` parameter is one name")
        }
    }
    let next:DewyLexeme=reader_ctx.tokens[reader_ctx.at]
    if ((next.kind not=? 'eof') and (not ((next.newline and (dn_power(next.symbol) =? 0)) and (next.symbol not=? 'kw_not')))) {
        return 0
    }
    loop p in ps {
        reader_ctx.stores.host[0].dw_ffi_c_types(int64<overflow='wrap'>(reader_nodes[p].a));
    }
    reader_ctx.stores.host[0].dw_ffi_c_types(int64<overflow='wrap'>(reader_nodes[n].a));
    rd_add_flag(@reader_nodes n NF_EXTERN);
    node_set_list(@reader_nodes @reader_ctx.stores.lists[0] n ps);
    let attrs:array<int64>=[]
    if ((not reader_ctx.stores.host[0].g_target_wasm()) or listed_lib) {
        attrs.push(reader_ctx.stores.host[0].dw_ffi_attr("lib" rd_bc_str(@reader_ctx @reader_nodes reader_ctx.stores.host[0].dw_ffi_library(library) pos) pos));
    }
    if (symbol not=? "") {
        attrs.push(reader_ctx.stores.host[0].dw_ffi_attr("symbol" rd_bc_str(@reader_ctx @reader_nodes symbol pos) pos));
    }
    reader_ctx.stores.host[0].dw_ffi_attach(n attrs);
    n
}

# `$extern`, `$extern(name='c_name' lib='m')` as a module function's body, at its tag (dw_ffi_body,
# dw_extern_finish). A form dw_extern_finish reports is left unread (dc_unread).
# (dw_extern_finish's and dw_ffi_options' mistakes, after any noted, should nothing else read the
# declaration)
rd_dc_extern_mistake=(@reader_ctx:ParserContext pos:int64 msg:string):>int64=>$unsafe {
    if (reader_ctx.status.report_pos =? 0) {
        rd_dc_hint(@reader_ctx pos msg);
    }
    0
}

rd_dc_fact_arm=(@reader_ctx:ParserContext @reader_nodes:array<Node> owner:int64):>int64=>$unsafe {
    let token:DewyLexeme=reader_ctx.tokens[reader_ctx.at]
    let member:int64=0
    let tag:int64=0
    if (token.kind =? 'boolean') {
        reader_ctx.at = (int64<overflow='wrap'>(reader_ctx.at) + 1)
        tag = (if (int64<overflow='wrap'>(token.name) =? reader_ctx.reader.dn_true_id) int64(2) else int64(1))
        reader_ctx.stores.host[0].g_result_boolean_masks_item_set(owner ((reader_ctx.stores.host[0].g_result_boolean_masks_get(owner) ?? 0) or tag))
        reader_ctx.stores.host[0].g_result_active_set(true)
        reader_ctx.stores.host[0].g_refine_active_set(true)
        member = node_mk(@reader_nodes 'tname' rd_mkpos(reader_ctx.file token.start))
        reader_nodes[member].name = int32<overflow='wrap'>(reader_ctx.stores.host[0].intern("bool"))
    }
    else {
        reader_ctx.reader.dc_effects_follow = true
        member = rd_dc_annotation(@reader_ctx @reader_nodes dn_power('pipe'))
        reader_ctx.reader.dc_effects_follow = false
        if (member =? 0) {
            return 0
        }
    }
    if ((rd_dn_peek(@reader_ctx) not=? 'amp') or (reader_ctx.tokens[(int64<overflow='wrap'>(reader_ctx.at) + 1)].symbol not=? 'langle')) {
        return member
    }
    reader_ctx.at = (int64<overflow='wrap'>(reader_ctx.at) + 1)
    let predicate:int64=rd_dc_facts(@reader_ctx @reader_nodes)
    if (predicate =? 0) {
        return 0
    }
    let clauses:array<ResultClause>=(reader_ctx.stores.host[0].g_result_syntax_get(owner) ?? [])
    clauses.push(ResultClause[member=member predicate=predicate boolean=tag]);
    reader_ctx.stores.host[0].g_result_syntax_item_set(owner clauses)
    reader_ctx.stores.host[0].g_result_active_set(true)
    reader_ctx.stores.host[0].g_refine_active_set(true)
    member
}

# Such a result (dw_result_type): its arms joined left to right; a boolean arm is a bool marked in
# result_boolean_masks, an arm's facts a ResultClause of the function `owner`.
rd_dc_fact_result=(@reader_ctx:ParserContext @reader_nodes:array<Node> owner:int64):>int64=>$unsafe {
    let pos:int64=rd_mkpos(reader_ctx.file reader_ctx.tokens[reader_ctx.at].start)
    let n:int64=rd_dc_fact_arm(@reader_ctx @reader_nodes owner)
    loop (n not=? 0) and (rd_dn_peek(@reader_ctx) =? 'pipe') {
        reader_ctx.at = (int64<overflow='wrap'>(reader_ctx.at) + 1)
        let right:int64=rd_dc_fact_arm(@reader_ctx @reader_nodes owner)
        if (right =? 0) {
            return 0
        }
        let union:int64=node_mk(@reader_nodes 'tunion' pos)
        node_set_list(@reader_nodes @reader_ctx.stores.lists[0] union [n right]);
        n = union
    }
    n
}

# A result type with a boolean arm or facts on an arm is next (`:>true & <a >? 0> | false`,
# `:>Yes & <a >? 0> | No`), before the `=>`.
rd_dc_fact_result_next=(@reader_ctx:ParserContext):>bool=>$unsafe {
    let at:int64=reader_ctx.at
    let depth:int64=0
    loop true {
        let t:DewyLexeme=reader_ctx.tokens[at]
        let s:DewyToken=t.symbol
        if ((t.kind =? 'eof') or ((depth =? 0) and ((s =? 'function') or (s =? 'lbrace')))) {
            return false
        }
        if (((s =? 'lparen') or (s =? 'lbrack')) or (s =? 'langle')) {
            depth = (int64<overflow='wrap'>(depth) + 1)
        }
        else if (((s =? 'rparen') or (s =? 'rbrack')) or (s =? 'rangle')) {
            if (depth =? 0) {
                return false
            }
            depth = (int64<overflow='wrap'>(depth) - 1)
        }
        else if ((depth =? 0) and ((t.kind =? 'boolean') or ((s =? 'amp') and (reader_ctx.tokens[(int64<overflow='wrap'>(at) + 1)].symbol =? 'langle')))) {
            return true
        }
        at = (int64<overflow='wrap'>(at) + 1)
    }
    false
}

# `<a >? 0 b <? a>` at its `<`: the propositions, joined by `and` (0: none, or one not read).
rd_dc_facts=(@reader_ctx:ParserContext @reader_nodes:array<Node>):>int64=>$unsafe {
    reader_ctx.at = (int64<overflow='wrap'>(reader_ctx.at) + 1)
    let predicate:int64=0
    loop (not rd_dn_accept(@reader_ctx 'rangle')) {
        if (reader_ctx.tokens[reader_ctx.at].kind =? 'eof') {
            return 0
        }
        reader_ctx.reader.dn_angles = (int64<overflow='wrap'>(reader_ctx.reader.dn_angles) + 1)
        let entry:int64=rd_dc_ref_predicate_read(@reader_ctx @reader_nodes 0)
        reader_ctx.reader.dn_angles = (int64<overflow='wrap'>(reader_ctx.reader.dn_angles) - 1)
        if ((entry =? 0) or rd_dc_membership(@reader_nodes entry)) {
            return 0
        }
        let term:int64=rd_dc_ref_predicate(@reader_nodes entry)
        if (predicate =? 0) {
            predicate = term
        }
        else {
            let both:int64=node_mk(@reader_nodes 'and_' reader_nodes[term].pos)
            reader_nodes[both].a = int32<overflow='wrap'>(predicate)
            reader_nodes[both].b = int32<overflow='wrap'>(term)
            predicate = both
        }
    }
    predicate
}

# A mistake certain where it is read: reported now, after one noted earlier, when it may be.
rd_dc_fail_now=(@reader_ctx:ParserContext pos:int64 msg:string):>int64=>$unsafe {
    rd_dc_report(@reader_ctx pos msg);
    if reader_ctx.flags.report_now {
        rd_dc_flush_report(@reader_ctx);
    }
    0
}

rd_dc_field_and_method=(@reader_ctx:ParserContext @reader_nodes:array<Node> struct_:int64 method:int64):>bool=>$unsafe {
    if (not reader_ctx.flags.report_now) {
        return false
    }
    rd_dc_fail_now(@reader_ctx rd_dc_method_name_at(@reader_ctx @reader_nodes method) "'{rd_name_of(@reader_ctx int64<overflow='wrap'>(reader_nodes[method].name))}' is both a field and a method of {rd_name_of(@reader_ctx int64<overflow='wrap'>(reader_nodes[struct_].name))}");
    false
}

# `$field(name)=value` (dc_field_next): the row (dw_record_entry), its name computed; 0 for a form
# is left unread (dc_unread).
rd_dc_field_entry=(@reader_ctx:ParserContext @reader_nodes:array<Node>):>int64=>$unsafe {
    let pos:int64=rd_mkpos(reader_ctx.file reader_ctx.tokens[reader_ctx.at].start)
    reader_ctx.at = (int64<overflow='wrap'>(reader_ctx.at) + 2)
    let computed:int64=rd_dc_expr(@reader_ctx @reader_nodes 0)
    if ((((computed =? 0) or (not rd_dn_accept(@reader_ctx 'rparen'))) or (not rd_dn_accept(@reader_ctx 'assign'))) or rd_dc_lambda_next(@reader_ctx)) {
        return 0
    }
    let value:int64=rd_dc_expr(@reader_ctx @reader_nodes 11)
    if ((value =? 0) or (reader_nodes[value].kind =? 'lambda')) {
        return 0
    }
    let entry:int64=node_mk(@reader_nodes 'namedarg' pos)
    reader_nodes[entry].b = int32<overflow='wrap'>(computed)
    reader_nodes[entry].a = int32<overflow='wrap'>(value)
    entry
}

# `$field(name)=value` is next: a row named by a compile-time string.
rd_dc_field_next=(@reader_ctx:ParserContext):>bool=>$unsafe {
    let token:DewyLexeme=reader_ctx.tokens[reader_ctx.at]
    (((((token.kind =? 'metatag') and ((int64<overflow='wrap'>(token.stop) - int64<overflow='wrap'>(token.start)) =? 6)) and (reader_ctx.tokens[(int64<overflow='wrap'>(reader_ctx.at) + 1)].symbol =? 'lparen')) and (not reader_ctx.tokens[(int64<overflow='wrap'>(reader_ctx.at) + 1)].space)) and (rd_dn_payload(@reader_ctx token) =? "field"))
}

rd_dc_flow=(@reader_ctx:ParserContext @reader_nodes:array<Node>):>int64=>$unsafe {
    reader_ctx.depth = (int64<overflow='wrap'>(reader_ctx.depth) + 1)
    if ((int64<overflow='wrap'>(reader_ctx.depth) + int64<overflow='wrap'>(reader_ctx.reader.dn_depth)) >? 256) {
        return 0
    }
    let token:DewyLexeme=rd_dn_take(@reader_ctx)
    if (token.symbol =? 'kw_match') {
        let n:int64=rd_dc_match(@reader_ctx @reader_nodes token)
        if (n not=? 0) {
            reader_ctx.depth = (int64<overflow='wrap'>(reader_ctx.depth) - 1)
        }
        return n
    }
    if ((token.symbol not=? 'kw_if') and (token.symbol not=? 'kw_loop')) {
        return 0
    }
    let start:int64=(int64<overflow='wrap'>(reader_ctx.at) - 1)
    let pos:int64=rd_mkpos(reader_ctx.file token.start)
    let n:int64=node_mk(@reader_nodes 'if_' pos)
    let head:int64=0
    let fold:int64=(-1)
    if (token.symbol =? 'kw_loop') {
        let braced:bool=(rd_dn_peek(@reader_ctx) =? 'lbrace')
        head = rd_dc_loop_head(@reader_ctx @reader_nodes)
        if (head =? 0) {
            return 0
        }
        # (`loop { ... }` then a new line: the block is the condition and the next line the body)
        if (((((braced and (reader_nodes[head].op =? 4)) and (reader_nodes[int64<overflow='wrap'>(reader_nodes[head].a)].kind =? 'block')) and (reader_ctx.tokens[(int64<overflow='wrap'>(reader_ctx.at) - 1)].symbol =? 'rbrace')) and reader_ctx.tokens[reader_ctx.at].newline) and dn_can_start(@reader_ctx.tokens reader_ctx.at)) {
            rd_dc_loop_body_warning(@reader_ctx);
        }
    }
    else {
        let saved_condition:int64=reader_ctx.reader.dc_condition_depth
        reader_ctx.reader.dc_condition_depth = (int64<overflow='wrap'>(reader_ctx.depth) + 1)
        let condition_at:int64=reader_ctx.at
        let condition:int64=rd_dc_expr(@reader_ctx @reader_nodes 0)
        reader_ctx.reader.dc_condition_depth = saved_condition
        if (condition =? 0) {
            # (`if x = 2`: the condition's value ends at `=`; a range it does not take leaves the cursor at -1)
            if ((reader_ctx.at >? condition_at) and (rd_dn_peek(@reader_ctx) =? 'assign')) {
                return rd_dc_condition_assign(@reader_ctx condition_at)
            }
            return 0
        }
        if (rd_dn_peek(@reader_ctx) =? 'colon') {
            return rd_dc_colon_body(@reader_ctx @reader_nodes token)
        }
        reader_nodes[n].a = int32<overflow='wrap'>(condition)
        # (`if $target.os =? "windows" a else b`: one arm is compiled, dw_flow's dw_target_condition)
        if (reader_ctx.reader.dc_targets_made >? 0) {
            fold = rd_dc_target_fold(@reader_ctx @reader_nodes condition)
            if (fold =? (-2)) {
                return 0
            }
        }
    }
    if (not dn_can_start(@reader_ctx.tokens reader_ctx.at)) {
        return rd_dc_no_body(@reader_ctx @reader_nodes token n head)
    }
    if ((fold >=? 0) and rd_dc_unsafe_at(@reader_ctx reader_ctx.at)) {
        return 0
    }
    let body:int64=rd_dc_body(@reader_ctx @reader_nodes)
    if (body =? 0) {
        return 0
    }
    reader_nodes[n].b = int32<overflow='wrap'>(body)
    let alternative:int64=0
    let rest:int64=0
    let rest_live:bool=true
    if rd_dn_accept(@reader_ctx 'kw_else') {
        if ((rd_dn_peek(@reader_ctx) =? 'kw_if') or (rd_dn_peek(@reader_ctx) =? 'kw_match')) {
            let rest_at:int64=reader_ctx.at
            let saved_dropping:int64=reader_ctx.reader.dc_dropping
            if (fold =? 1) {
                reader_ctx.reader.dc_dropping = (int64<overflow='wrap'>(reader_ctx.reader.dc_dropping) + 1)
            }
            rest = rd_dc_flow(@reader_ctx @reader_nodes)
            reader_ctx.reader.dc_dropping = saved_dropping
            if (rest =? 0) {
                return 0
            }
            rest_live = (reader_ctx.reader.dc_live_at =? rest_at)
            # (a folded chain's value is its compiled arm's body, a block itself: dw_flow)
            if (reader_nodes[rest].kind =? 'block') {
                alternative = rest
            }
            else {
                alternative = node_mk(@reader_nodes 'block' pos)
                node_set_list(@reader_nodes @reader_ctx.stores.lists[0] alternative [rd_dc_flow_stmt(@reader_nodes rest)]);
            }
        }
        else {
            if ((fold >=? 0) and rd_dc_unsafe_at(@reader_ctx reader_ctx.at)) {
                return 0
            }
            alternative = rd_dc_body(@reader_ctx @reader_nodes)
            if (alternative =? 0) {
                return 0
            }
        }
        reader_nodes[n].c = int32<overflow='wrap'>(alternative)
    }
    if (fold >=? 0) {
        # (the arms left out are read, never checked: the names they use are noted)
        let value:int64=0
        # (a false test's names too: dw_target_splice notes the whole arm)
        if ((fold =? 0) or (reader_ctx.reader.dc_dropping >? 0)) {
            rd_dc_target_dropped(@reader_ctx @reader_nodes int64<overflow='wrap'>(reader_nodes[n].a));
        }
        if (fold =? 1) {
            if (alternative not=? 0) {
                rd_dc_target_dropped(@reader_ctx @reader_nodes alternative);
            }
            value = body
        }
        else {
            rd_dc_target_dropped(@reader_ctx @reader_nodes body);
            if (rest not=? 0) {
                if (reader_nodes[rest].kind =? 'match_') {
                    return 0
                }
                value = rest
            }
            else if (alternative not=? 0) {
                value = alternative
            }
            else {
                value = node_mk(@reader_nodes 'block' pos)
            }
        }
        reader_ctx.reader.dc_live_at = (if ((fold =? 1) or rest_live) start else int64((-1)))
        reader_ctx.depth = (int64<overflow='wrap'>(reader_ctx.depth) - 1)
        return value
    }
    if (reader_ctx.reader.dc_live_at =? start) {
        reader_ctx.reader.dc_live_at = (-1)
    }
    if (head not=? 0) {
        if (alternative not=? 0) {
            reader_nodes[n].kind = 'loopx'
            reader_nodes[n].a = int32<overflow='wrap'>(head)
        }
        else if (reader_nodes[head].op =? 1) {
            reader_nodes[n].kind = 'for_'
            reader_nodes[n].a = reader_nodes[head].a
            if rd_has_flag(@reader_nodes head NF_MUT) {
                rd_add_flag(@reader_nodes n NF_MUT);
            }
            node_set_list(@reader_nodes @reader_ctx.stores.lists[0] n node_kids(@reader_nodes @reader_ctx.stores.lists[0] head));
        }
        else if (reader_nodes[head].op =? 4) {
            reader_nodes[n].kind = 'while_'
            reader_nodes[n].a = reader_nodes[head].a
        }
        else {
            reader_nodes[n].kind = 'loopx'
            reader_nodes[n].a = int32<overflow='wrap'>(head)
        }
    }
    reader_ctx.depth = (int64<overflow='wrap'>(reader_ctx.depth) - 1)
    n
}

# A flow's arm bodies: an `else if` or `else match` goes on the same flow (dc_flow's block at the
# chain's own position).
rd_dc_flow_arms=(@reader_ctx:ParserContext @reader_nodes:array<Node> flow:int64 @arms:array<int64>):>void=>$unsafe {
    dr_flow_arms(@reader_nodes @reader_ctx.stores.lists[0] flow @arms);
}

# Nothing continues the expression a braced body or an arm ends (it would apply to that body or
# arm).
rd_dc_flow_ends=(@reader_ctx:ParserContext):>bool=>$unsafe {
    let t:DewyLexeme=reader_ctx.tokens[reader_ctx.at]
    if (t.kind =? 'eof') {
        return true
    }
    if ((((((dn_power(t.symbol) >? 0) or (t.symbol =? 'semi')) or (t.symbol =? 'dot')) or (t.symbol =? 'question')) or (t.symbol =? 'ellipsis')) or (t.symbol =? 'kw_or_throw')) {
        return false
    }
    (((((t.space or t.newline) or (t.symbol =? 'rbrace')) or (t.symbol =? 'rparen')) or (t.symbol =? 'rbrack')) or (t.symbol =? 'kw_else'))
}

# A `match` in a block is a statement holding it (dw_flow_stmt).
rd_dc_flow_stmt=(@reader_nodes:array<Node> n:int64):>int64=>$unsafe {
    if (reader_nodes[n].kind not=? 'match_') {
        return n
    }
    let s:int64=node_mk(@reader_nodes 'exprstmt' reader_nodes[n].pos)
    reader_nodes[s].a = int32<overflow='wrap'>(n)
    s
}

rd_dc_flush_report=(@reader_ctx:ParserContext):>void=>$unsafe {
    if (reader_ctx.status.report_pos =? 0) {
        return
    }
    let pos:int64=reader_ctx.status.report_pos
    reader_ctx.status.report_pos = 0
    reader_ctx.stores.host[0].fatal(pos reader_ctx.status.report_text);
}

# `{ x int; y int }` at `at`: the fields as Dewy writes them, `x:int64 y:int64`; "" for other forms.
rd_dc_foreign_fields=(@reader_ctx:ParserContext at:int64):>string=>$unsafe {
    if (reader_ctx.tokens[at].symbol not=? 'lbrace') {
        return ""
    }
    let out:string=""
    let k:int64=(int64<overflow='wrap'>(at) + 1)
    loop (reader_ctx.tokens[k].symbol not=? 'rbrace') {
        let field:DewyLexeme=reader_ctx.tokens[k]
        if (field.kind =? 'eof') {
            return ""
        }
        let kind:DewyLexeme=reader_ctx.tokens[(int64<overflow='wrap'>(k) + 1)]
        if (((field.kind not=? 'identifier') or (kind.kind not=? 'identifier')) or kind.newline) {
            return ""
        }
        let dewy:string=rd_dc_foreign_type(@reader_ctx rd_dn_payload(@reader_ctx kind))
        if (dewy =? "") {
            return ""
        }
        if (out not=? "") {
            out = "{out}{" "}"
        }
        out = "{"{"{out}{rd_dn_payload(@reader_ctx field)}"}{":"}"}{dewy}"
        k = (int64<overflow='wrap'>(k) + 2)
        if (reader_ctx.tokens[k].symbol =? 'semi') {
            k = (int64<overflow='wrap'>(k) + 1)
        }
    }
    out
}

# A statement no reading takes, written as another language declares or loops (dc_unread's
# mistake): `type Op = ...`, `type Point struct { ... }`, `for _, x := range xs { ... }`.
rd_dc_foreign_habit=(@reader_ctx:ParserContext at:int64):>void=>$unsafe {
    let token:DewyLexeme=reader_ctx.tokens[at]
    if ((((at >? 0) and (not token.newline)) and (reader_ctx.tokens[(int64<overflow='wrap'>(at) - 1)].kind =? 'identifier')) and (rd_dn_payload(@reader_ctx reader_ctx.tokens[(int64<overflow='wrap'>(at) - 1)]) =? "for")) {
        reader_ctx.stores.host[0].fatal(rd_mkpos(reader_ctx.file reader_ctx.tokens[(int64<overflow='wrap'>(at) - 1)].start) "iterate values with `loop x in xs \{ ... }`, or key and value with `loop [key value] in m \{ ... }`");
    }
    let name:DewyLexeme=reader_ctx.tokens[(int64<overflow='wrap'>(at) + 1)]
    if ((((token.kind not=? 'identifier') or (token.name not=? int32<overflow='wrap'>(reader_ctx.reader.dn_type_id))) or (name.kind not=? 'identifier')) or name.newline) {
        return
    }
    let pos:int64=rd_mkpos(reader_ctx.file token.start)
    let written:string=rd_dn_payload(@reader_ctx name)
    let after:DewyLexeme=reader_ctx.tokens[(int64<overflow='wrap'>(at) + 2)]
    let src:string=reader_ctx.source
    if (((after.symbol =? 'assign') and (not reader_ctx.tokens[(int64<overflow='wrap'>(at) + 3)].newline)) and (reader_ctx.tokens[(int64<overflow='wrap'>(at) + 3)].kind not=? 'eof')) {
        let k:int64=(int64<overflow='wrap'>(at) + 3)
        loop (reader_ctx.tokens[(int64<overflow='wrap'>(k) + 1)].kind not=? 'eof') and (not reader_ctx.tokens[(int64<overflow='wrap'>(k) + 1)].newline) {
            k = (int64<overflow='wrap'>(k) + 1)
        }
        let aliased:string=reader_ctx.stores.host[0].bytes_slice(src reader_ctx.tokens[(int64<overflow='wrap'>(at) + 3)].start reader_ctx.tokens[k].stop)
        reader_ctx.stores.host[0].fatal(pos "a type alias binds a name with `:type =`: write `{written}:type = {aliased}`");
    }
    if ((after.kind not=? 'identifier') or (rd_dn_payload(@reader_ctx after) not=? "struct")) {
        return
    }
    let listing:string=rd_dc_foreign_fields(@reader_ctx (int64<overflow='wrap'>(at) + 3))
    if (listing =? "") {
        reader_ctx.stores.host[0].fatal(pos "a record type uses `:type =`: write `{written}:type = [field:type ...]`");
    }
    reader_ctx.stores.host[0].fatal(pos "a record type uses `:type =`: write `{written}:type = [{listing}]`");
}

# A builtin type another language spells w, as Dewy does ("" for others).
rd_dc_foreign_type=(@reader_ctx:ParserContext w:string):>string=>$unsafe {
    if ((w =? "int") or (w =? "i64")) {
        return "int64"
    }
    if ((w =? "uint") or (w =? "u64")) {
        return "uint64"
    }
    if (((w =? "float") or (w =? "number")) or (w =? "f64")) {
        return "float64"
    }
    if ((w =? "bool") or (w =? "boolean")) {
        return "bool"
    }
    if ((w =? "string") or (w =? "str")) {
        return "string"
    }
    if (w =? "byte") {
        return "uint8"
    }
    if ((rd_dc_integer_name(@reader_ctx reader_ctx.stores.host[0].intern(w)) or (w =? "float32")) or (w =? "float64")) {
        return w
    }
    rd_dewy_type_word(@reader_ctx w)
}

# (the member captures of closures and the propositions of proofs a discarded reading made: their
# nodes are gone)
rd_dc_forget_tables=(@reader_ctx:ParserContext node_start:int64):>void=>$unsafe {
    if (reader_ctx.reach.captures.length >? 0) {
        let gone:array<int64>=[]
        loop [n members] in reader_ctx.reach.captures {
            if (n >=? node_start) {
                gone.push(n);
            }
        }
        loop n in gone {
            reader_ctx.reach.captures.remove(n);
        }
    }
    if (reader_ctx.stores.host[0].g_proof_pending() and (reader_ctx.stores.host[0].g_proof_decls_len() >? 0)) {
        let proofs:array<int64>=[]
        loop [n predicate] in reader_ctx.stores.host[0].g_proof_decls() {
            if (n >=? node_start) {
                proofs.push(n);
            }
        }
        loop n in proofs {
            reader_ctx.stores.host[0].g_proof_decls_remove(n);
        }
    }
}

# Module functions with scalar signatures and migrated bodies need no syntax
# tree. A contextual signature or body retries the full declaration grammar.
rd_dc_function=(@reader_ctx:ParserContext @reader_nodes:array<Node>):>int64=>$unsafe {
    let token:DewyLexeme=reader_ctx.tokens[reader_ctx.at]
    # (`let name = (...) => ...` and `const name = ...` declare a module function too)
    if ((token.symbol =? 'kw_let') or (token.symbol =? 'kw_const')) {
        reader_ctx.at = (int64<overflow='wrap'>(reader_ctx.at) + 1)
        token = reader_ctx.tokens[reader_ctx.at]
    }
    # (`spawn = (...) => ...`: before `=`, `spawn` is a name, dn_atom)
    if (((token.kind not=? 'identifier') or (((token.symbol not=? 'none') and (token.symbol not=? 'kw_test')) and (token.symbol not=? 'kw_spawn'))) or rd_dn_reserved(@reader_ctx int64<overflow='wrap'>(token.name))) {
        return 0
    }
    if (reader_ctx.tokens[(int64<overflow='wrap'>(reader_ctx.at) + 1)].symbol not=? 'assign') {
        return 0
    }
    # `name = <T U>(params) => body`: a generic function (dw_type_params)
    if (reader_ctx.tokens[(int64<overflow='wrap'>(reader_ctx.at) + 2)].symbol =? 'langle') {
        reader_ctx.at = (int64<overflow='wrap'>(reader_ctx.at) + 2)
        let opening:DewyLexeme=reader_ctx.tokens[reader_ctx.at]
        let type_params:array<int64>=rd_dc_type_params(@reader_ctx @reader_nodes)
        if (type_params.length =? 0) {
            return 0
        }
        if (rd_dc_word(@reader_ctx int64<overflow='wrap'>(token.name)) =? DC_MAIN) {
            return rd_dc_generic_main(@reader_ctx opening)
        }
        reader_ctx.depth = (int64<overflow='wrap'>(reader_ctx.depth) + 3)
        let n:int64=rd_dc_function_literal(@reader_ctx @reader_nodes token.name opening type_params)
        if (n =? 0) {
            return 0
        }
        rd_dn_accept_semi(@reader_ctx);
        return n
    }
    # `g = x => body`: one parameter, named alone (dw_function's bare parameter)
    let bare:DewyLexeme=reader_ctx.tokens[(int64<overflow='wrap'>(reader_ctx.at) + 2)]
    if (((((bare.kind =? 'identifier') and (bare.symbol =? 'none')) and (reader_ctx.tokens[(int64<overflow='wrap'>(reader_ctx.at) + 3)].symbol =? 'function')) and (not rd_dn_reserved(@reader_ctx int64<overflow='wrap'>(bare.name)))) and (rd_dc_word(@reader_ctx int64<overflow='wrap'>(token.name)) not=? DC_MAIN)) {
        reader_ctx.at = (int64<overflow='wrap'>(reader_ctx.at) + 2)
        reader_ctx.depth = (int64<overflow='wrap'>(reader_ctx.depth) + 3)
        let n:int64=rd_dc_function_literal(@reader_ctx @reader_nodes token.name bare bare=true)
        if (n =? 0) {
            return 0
        }
        rd_dn_accept_semi(@reader_ctx);
        return n
    }
    if (reader_ctx.tokens[(int64<overflow='wrap'>(reader_ctx.at) + 2)].symbol not=? 'lparen') {
        return 0
    }
    # `twice = (*2)`: a partial application, a module function of its own (dw_function)
    if rd_dc_partial_at(@reader_ctx (int64<overflow='wrap'>(reader_ctx.at) + 2)) {
        if (rd_dc_word(@reader_ctx int64<overflow='wrap'>(token.name)) =? DC_MAIN) {
            return 0
        }
        reader_ctx.at = (int64<overflow='wrap'>(reader_ctx.at) + 3)
        reader_ctx.depth = (int64<overflow='wrap'>(reader_ctx.depth) + 3)
        let n:int64=rd_dc_partial(@reader_ctx @reader_nodes reader_ctx.tokens[(int64<overflow='wrap'>(reader_ctx.at) - 1)] token.name)
        if ((n =? 0) or (dn_power(rd_dn_peek(@reader_ctx)) >? 0)) {
            return 0
        }
        rd_dn_accept_semi(@reader_ctx);
        return n
    }
    reader_ctx.at = (int64<overflow='wrap'>(reader_ctx.at) + 2)
    # Account for the enclosing assignment, signature and parameter grammar.
    reader_ctx.depth = (int64<overflow='wrap'>(reader_ctx.depth) + 3)
    # (`name = (<T>(xs:T) => ...)`: a group of one generic member, below)
    # (`((w h):array<int64 length=2>) => ...`: a grouped parameter pattern opens the list)
    if (((reader_ctx.tokens[(int64<overflow='wrap'>(reader_ctx.at) + 1)].symbol not=? 'lparen') and (not ((reader_ctx.tokens[(int64<overflow='wrap'>(reader_ctx.at) + 1)].symbol =? 'langle') and rd_dc_generic_lambda_next_at(@reader_ctx (int64<overflow='wrap'>(reader_ctx.at) + 1))))) or ((reader_ctx.tokens[(int64<overflow='wrap'>(reader_ctx.at) + 1)].symbol =? 'lparen') and rd_dc_lambda_next_at(@reader_ctx reader_ctx.at))) {
        reader_ctx.at = (int64<overflow='wrap'>(reader_ctx.at) + 1)
        reader_ctx.reader.dc_literal_at = (int64<overflow='wrap'>(reader_ctx.at) - 1)
        let n:int64=rd_dc_function_literal(@reader_ctx @reader_nodes token.name reader_ctx.tokens[(int64<overflow='wrap'>(reader_ctx.at) - 1)])
        reader_ctx.reader.dc_literal_at = (-1)
        if (n =? 0) {
            return 0
        }
        rd_dn_accept_semi(@reader_ctx);
        return n
    }
    # `name = ((a:T):>R => ...) & ((b:U):>R => ...)`: an overload group, one
    # declaration per member (an entry point's, dw_top_declarations' mistake, noted)
    if (rd_dc_word(@reader_ctx int64<overflow='wrap'>(token.name)) =? DC_MAIN) {
        if (not reader_ctx.flags.report_now) {
            return 0
        }
        rd_dc_unsupported(@reader_ctx rd_mkpos(reader_ctx.file token.start) "an overloaded entry point");
    }
    reader_ctx.reader.dc_made.clear();
    # (`name = (((a:T) => a) & ((b:U) => b))`: the group parenthesized as a whole)
    let wrapped:bool=((reader_ctx.tokens[(int64<overflow='wrap'>(reader_ctx.at) + 1)].symbol =? 'lparen') and (((reader_ctx.tokens[(int64<overflow='wrap'>(reader_ctx.at) + 2)].symbol =? 'lparen') and rd_dc_lambda_next_at(@reader_ctx (int64<overflow='wrap'>(reader_ctx.at) + 2))) or ((reader_ctx.tokens[(int64<overflow='wrap'>(reader_ctx.at) + 2)].symbol =? 'langle') and rd_dc_generic_lambda_next_at(@reader_ctx (int64<overflow='wrap'>(reader_ctx.at) + 2)))))
    if wrapped {
        reader_ctx.at = (int64<overflow='wrap'>(reader_ctx.at) + 1)
    }
    loop true {
        # (`(() => 42) & 42`: dw_overload_members' mistake, noted)
        if (((rd_dn_peek(@reader_ctx) not=? 'lparen') and (reader_ctx.reader.dc_made.length >? 0)) and reader_ctx.flags.report_now) {
            if (rd_dc_overload_value(@reader_ctx @reader_nodes) =? 0) {
                return 0
            }
            if (rd_dn_peek(@reader_ctx) not=? 'amp') {
                break
            }
            reader_ctx.at = (int64<overflow='wrap'>(reader_ctx.at) + 1)
            continue
        }
        if (not rd_dn_accept(@reader_ctx 'lparen')) {
            return 0
        }
        # (`(<T>(n:int64):>array<T> => ...)`: a generic member)
        let opening:DewyLexeme=reader_ctx.tokens[reader_ctx.at]
        let type_params:array<int64>=[]
        if (opening.symbol =? 'langle') {
            type_params = rd_dc_type_params(@reader_ctx @reader_nodes)
            if (type_params.length =? 0) {
                return 0
            }
        }
        else if (not rd_dn_accept(@reader_ctx 'lparen')) {
            return 0
        }
        reader_ctx.depth = (int64<overflow='wrap'>(reader_ctx.depth) + int64<overflow='wrap'>((if (reader_ctx.reader.dc_made.length =? 0) int64(1) else int64(2))))
        let n:int64=rd_dc_function_literal(@reader_ctx @reader_nodes token.name opening type_params)
        if ((n =? 0) or (not rd_dn_accept(@reader_ctx 'rparen'))) {
            return 0
        }
        reader_ctx.depth = (int64<overflow='wrap'>(reader_ctx.depth) - int64<overflow='wrap'>((if (reader_ctx.reader.dc_made.length =? 0) int64(1) else int64(2))))
        reader_ctx.reader.dc_made.push(n);
        if (rd_dn_peek(@reader_ctx) not=? 'amp') {
            break
        }
        reader_ctx.at = (int64<overflow='wrap'>(reader_ctx.at) + 1)
    }
    if (wrapped and (not rd_dn_accept(@reader_ctx 'rparen'))) {
        return 0
    }
    rd_dn_accept_semi(@reader_ctx);
    reader_ctx.reader.dc_made[0]
}

# `(params):>result => body`, after its opening parenthesis.
# A lambda (a function literal in an expression, dw_function's unnamed function) may list
# `$capture name` and `$capture @name` among its parameters; `bare`, it has one
# parameter name instead of a list (`x => x + 1`, opening that name).
rd_dc_function_literal=(@reader_ctx:ParserContext @reader_nodes:array<Node> name_id:int32 opening:DewyLexeme type_params:array<int64>=[] lambda:bool=false bare:bool=false):>int64=>$unsafe {
    let name:string=rd_name_of(@reader_ctx int64<overflow='wrap'>(name_id))
    let n:int64=node_mk(@reader_nodes 'fn_' rd_mkpos(reader_ctx.file opening.start))
    if lambda {
        reader_nodes[n].kind = 'lambda'
    }
    reader_nodes[n].name = name_id
    if (type_params.length >? 0) {
        node_set_list2(@reader_nodes @reader_ctx.stores.lists[0] n type_params);
        rd_add_flag(@reader_nodes n NF_GENERIC);
    }
    let ps:array<int64>=[]
    let captures:array<int64>=[]
    let bound:dict<int64 bool>=[]
    # (`... by:int64`: a bare `...` ends the positional run; the parameters after it are named
    # only, dewy_param_kinds)
    let keyword_only:bool=false
    let kinds_at:int64=reader_ctx.reader.dc_kinds.length
    # (`(a:int64, b:int64)`: once a comma follows an annotation, one ends each, dc_comma_mistake below)
    let commas:bool=false
    loop true {
        if bare {
            if (ps.length >? 0) {
                break
            }
        }
        else if rd_dn_accept(@reader_ctx 'rparen') {
            break
        }
        let first:DewyLexeme=reader_ctx.tokens[reader_ctx.at]
        if ((((first.symbol =? 'ellipsis') and (not bare)) and (not keyword_only)) and (reader_ctx.tokens[(int64<overflow='wrap'>(reader_ctx.at) - 1)].symbol =? 'lparen')) {
            let after:DewyLexeme=reader_ctx.tokens[(int64<overflow='wrap'>(reader_ctx.at) + 1)]
            if ((((after.kind not=? 'identifier') or (after.symbol not=? 'none')) or (not after.space)) or (reader_ctx.tokens[(int64<overflow='wrap'>(reader_ctx.at) + 2)].symbol not=? 'colon')) {
                if (not rd_dc_rest_parameter(@reader_ctx)) {
                    return 0
                }
                continue
            }
            keyword_only = true
            reader_ctx.at = (int64<overflow='wrap'>(reader_ctx.at) + 1)
            continue
        }
        if ((first.kind =? 'metatag') and (not bare)) {
            # (dw_function's mistakes: another modifier, `$capture` on a module function, before no
            # name, or before something else)
            let tagged:int64=rd_dc_parameter_tag(@reader_ctx first lambda)
            if (tagged <? 0) {
                return 0
            }
            if (tagged >? 0) {
                continue
            }
            reader_ctx.at = (int64<overflow='wrap'>(reader_ctx.at) + 1)
            let next:DewyLexeme=reader_ctx.tokens[reader_ctx.at]
            if ((next.kind =? 'metatag') or (next.symbol =? 'rparen')) {
                if ((type_params.length >? 0) or (not rd_dc_capture_missing(@reader_ctx next opening))) {
                    return 0
                }
                continue
            }
            let place:bool=rd_dn_accept(@reader_ctx 'at')
            let target:DewyLexeme=reader_ctx.tokens[reader_ctx.at]
            if (((target.kind =? 'identifier') and ((target.symbol =? 'none') or (target.symbol =? 'kw_test'))) and ((rd_dc_word(@reader_ctx int64<overflow='wrap'>(target.name)) =? DC_HOLE) or ((reader_ctx.tokens[(int64<overflow='wrap'>(reader_ctx.at) + 1)].symbol =? 'dot') and (not reader_ctx.tokens[(int64<overflow='wrap'>(reader_ctx.at) + 1)].space)))) {
                if (not rd_dc_capture_other(@reader_ctx place target)) {
                    return 0
                }
                continue
            }
            if ((((target.kind not=? 'identifier') or ((target.symbol not=? 'none') and (target.symbol not=? 'kw_test'))) or rd_dn_reserved(@reader_ctx int64<overflow='wrap'>(target.name))) or (rd_dc_word(@reader_ctx int64<overflow='wrap'>(target.name)) =? DC_HOLE)) {
                return 0
            }
            if bound.has(int64<overflow='wrap'>(target.name)) {
                # (dw_function's mistake; a method's member captures it checks apart)
                if (reader_ctx.reach.scope.length =? 0) {
                    reader_ctx.stores.host[0].fatal(rd_mkpos(reader_ctx.file target.start) "duplicate parameter binding '{rd_dn_payload(@reader_ctx target)}'");
                }
                return 0
            }
            reader_ctx.at = (int64<overflow='wrap'>(reader_ctx.at) + 1)
            let cap:int64=node_mk(@reader_nodes 'ident' rd_mkpos(reader_ctx.file target.start))
            reader_nodes[cap].name = rd_dw_value_name(@reader_ctx target.name reader_nodes[cap].pos)
            if place {
                rd_add_flag(@reader_nodes cap NF_MUT);
            }
            bound[int64<overflow='wrap'>(target.name)] = true
            captures.push(cap);
            continue
        }
        # (`<value:int64>`: a positional-only parameter, kind 2)
        let angled:bool=((not bare) and (first.symbol =? 'langle'))
        if angled {
            reader_ctx.at = (int64<overflow='wrap'>(reader_ctx.at) + 1)
        }
        let by_place:bool=(((not bare) and (not angled)) and rd_dn_accept(@reader_ctx 'at'))
        let parameter:DewyLexeme=reader_ctx.tokens[reader_ctx.at]
        # (`(@[x y]:T)`: dw_param's mistake, noted; read as the pattern)
        if ((by_place and (parameter.symbol =? 'lbrack')) and reader_ctx.flags.report_now) {
            by_place = rd_dc_mutable_pattern(@reader_ctx parameter)
        }
        let p:int64=node_mk(@reader_nodes 'param' rd_mkpos(reader_ctx.file first.start))
        if angled {
            reader_nodes[p].pos = rd_mkpos(reader_ctx.file parameter.start)
        }
        let pattern:bool=(((((parameter.symbol =? 'lbrack') or (parameter.symbol =? 'lparen')) and (not bare)) and (not by_place)) and (not angled))
        if pattern {
            # `([a b]:array<int64>) => ...`, `((a b):array<int64>) => ...`: the argument unpacked
            # (dw_param's pattern)
            reader_ctx.at = (int64<overflow='wrap'>(reader_ctx.at) + 1)
            let seen:array<int64>=[]
            let close:DewyToken='rbrack'
            if (parameter.symbol =? 'lparen') {
                close = 'rparen'
            }
            let binders:array<int64>=rd_dc_binding_items(@reader_ctx @reader_nodes @seen close)
            if ((binders.length =? 0) or ((close =? 'rparen') and (binders.length <? 2))) {
                return 0
            }
            reader_nodes[p].name = int32<overflow='wrap'>(reader_ctx.stores.host[0].intern("$parameter{p}"))
            node_set_list(@reader_nodes @reader_ctx.stores.lists[0] p binders);
        }
        else {
            # (`(new:int64)`, `(in:int64)`, `(from:int64)`: dc_parameter_word)
            if ((parameter.kind not=? 'identifier') or ((parameter.symbol not=? 'none') and (parameter.symbol not=? 'kw_test'))) {
                if (not rd_dc_parameter_word(@reader_ctx parameter)) {
                    return 0
                }
            }
            else if rd_dn_reserved(@reader_ctx int64<overflow='wrap'>(parameter.name)) {
                rd_dc_reserved_at(@reader_ctx parameter);
            }
            reader_ctx.at = (int64<overflow='wrap'>(reader_ctx.at) + 1)
            reader_nodes[p].name = parameter.name
        }
        if by_place {
            rd_add_flag(@reader_nodes p NF_MUT);
        }
        if bare {
            ps.push(p);
            break
        }
        let kind:int64=0
        if keyword_only {
            kind = 1
        }
        if angled {
            kind = 2
            if (rd_dn_peek(@reader_ctx) not=? 'colon') {
                return 0
            }
        }
        reader_ctx.reader.dc_kinds.push(kind);
        if rd_dn_accept(@reader_ctx 'colon') {
            reader_ctx.reader.dc_parameter_type = true
            if angled {
                reader_ctx.reader.dc_type_args = (int64<overflow='wrap'>(reader_ctx.reader.dc_type_args) + 1)
            }
            let type_at:int64=reader_ctx.at
            let type_edits:int64=reader_ctx.reader.dn_edit_at.length
            let type_depth:int64=reader_ctx.depth
            let saved_comma:bool=reader_ctx.flags.comma_stop
            if commas {
                reader_ctx.flags.comma_stop = true
            }
            let annotation:int64=rd_dc_annotation(@reader_ctx @reader_nodes)
            if (((((annotation =? 0) and (not commas)) and (not bare)) and reader_ctx.flags.report_now) and (rd_dn_peek(@reader_ctx) =? 'comma')) {
                commas = true
                reader_ctx.at = type_at
                rd_dn_edits_undo(@reader_ctx type_edits);
                reader_ctx.depth = type_depth
                reader_ctx.flags.comma_stop = true
                annotation = rd_dc_annotation(@reader_ctx @reader_nodes)
            }
            reader_ctx.flags.comma_stop = saved_comma
            if angled {
                reader_ctx.reader.dc_type_args = (int64<overflow='wrap'>(reader_ctx.reader.dc_type_args) - 1)
            }
            reader_ctx.reader.dc_parameter_type = false
            if (annotation =? 0) {
                return 0
            }
            reader_nodes[p].a = int32<overflow='wrap'>(annotation)
            # (`value:int64 ...`: the positional run ends after this parameter; `...rest` attached
            # is a rest parameter, which dw_function reports)
            if (((rd_dn_peek(@reader_ctx) =? 'ellipsis') and (not bare)) and (not angled)) {
                let after:DewyLexeme=reader_ctx.tokens[(int64<overflow='wrap'>(reader_ctx.at) + 1)]
                if (((not after.space) and (after.kind =? 'identifier')) and (not keyword_only)) {
                    if (not rd_dc_rest_parameter(@reader_ctx)) {
                        return 0
                    }
                }
                else {
                    if ((keyword_only or (after.symbol =? 'assign')) or ((not after.space) and (after.kind =? 'identifier'))) {
                        return 0
                    }
                    reader_ctx.at = (int64<overflow='wrap'>(reader_ctx.at) + 1)
                    keyword_only = true
                }
            }
        }
        if angled {
            if (not rd_dn_accept(@reader_ctx 'rangle')) {
                if (not (reader_ctx.reader.dn_edits_on and rd_dn_closer_joined(@reader_ctx))) {
                    return 0
                }
                rd_dn_split_closer(@reader_ctx);
            }
            if (rd_dn_peek(@reader_ctx) =? 'assign') {
                return 0
            }
        }
        if rd_dn_accept(@reader_ctx 'assign') {
            let initial:int64=rd_dc_expr(@reader_ctx @reader_nodes 11)
            if (initial =? 0) {
                return 0
            }
            reader_nodes[p].b = int32<overflow='wrap'>(initial)
        }
        if pattern {
            loop leaf in reader_ctx.stores.host[0].binding_leaves(node_kids(@reader_nodes @reader_ctx.stores.lists[0] p)) {
                if (not rd_dc_bind_once(@reader_ctx @bound int64<overflow='wrap'>(reader_nodes[leaf].name))) {
                    return rd_dc_duplicate_parameter(@reader_ctx @reader_nodes leaf lambda)
                }
            }
        }
        else if (not rd_dc_bind_once(@reader_ctx @bound int64<overflow='wrap'>(parameter.name))) {
            return rd_dc_duplicate_parameter(@reader_ctx @reader_nodes p (lambda and (not by_place)))
        }
        ps.push(p);
        # (`(a:int64, b:int64)`: dw_comma_fail's mistake at the parameter, noted; the rest read on)
        if ((rd_dn_peek(@reader_ctx) =? 'comma') and commas) {
            rd_dc_comma_mistake(@reader_ctx rd_mkpos(reader_ctx.file first.start));
            reader_ctx.at = (int64<overflow='wrap'>(reader_ctx.at) + 1)
        }
    }
    if ((name =? "main") and ((ps.length >? 1) or ((ps.length =? 1) and rd_has_flag(@reader_nodes ps[0] NF_MUT)))) {
        return 0
    }
    if (reader_ctx.reader.dc_kinds.length >? kinds_at) {
        let any_kind:bool=false
        loop i in [kinds_at..reader_ctx.reader.dc_kinds.length) {
            any_kind = (any_kind or (reader_ctx.reader.dc_kinds[i] not=? 0))
        }
        if any_kind {
            reader_ctx.stores.host[0].g_dewy_param_kinds_item_set(n reader_ctx.reader.dc_kinds[kinds_at..reader_ctx.reader.dc_kinds.length))
        }
        reader_ctx.reader.dc_kinds.truncate(kinds_at);
    }
    if (captures.length >? 0) {
        # (a generic function's second list holds its type parameters: its captures are a block)
        if (type_params.length >? 0) {
            let listed:int64=node_mk(@reader_nodes 'block' reader_nodes[n].pos)
            node_set_list(@reader_nodes @reader_ctx.stores.lists[0] listed captures);
            reader_nodes[n].d = int32<overflow='wrap'>(listed)
        }
        else {
            node_set_list2(@reader_nodes @reader_ctx.stores.lists[0] n captures);
        }
    }
    if ((not bare) and rd_dn_accept(@reader_ctx 'returns')) {
        # (`:> @T`: a method lending a place, its type kept apart, dw_function's place_written)
        if (rd_dn_peek(@reader_ctx) =? 'at') {
            reader_ctx.at = (int64<overflow='wrap'>(reader_ctx.at) + 1)
            let written:int64=rd_dc_annotation(@reader_ctx @reader_nodes dn_prefix_power('at' false))
            if (written =? 0) {
                return 0
            }
            # (`:> @T | Busy`: the other alternatives are written for the reader only)
            loop (rd_dn_peek(@reader_ctx) =? 'pipe') {
                let other:DewyLexeme=reader_ctx.tokens[(int64<overflow='wrap'>(reader_ctx.at) + 1)]
                if (((other.kind not=? 'identifier') or (other.symbol not=? 'none')) or ((reader_ctx.tokens[(int64<overflow='wrap'>(reader_ctx.at) + 2)].symbol not=? 'pipe') and (reader_ctx.tokens[(int64<overflow='wrap'>(reader_ctx.at) + 2)].symbol not=? 'function'))) {
                    return 0
                }
                reader_ctx.at = (int64<overflow='wrap'>(reader_ctx.at) + 2)
            }
            if (rd_dn_peek(@reader_ctx) not=? 'function') {
                return 0
            }
            reader_ctx.stores.host[0].g_place_written_item_set(n written)
            reader_ctx.reader.dn_edit_at.push((int64<overflow='wrap'>(DN_EDIT_BIGINT) - int64<overflow='wrap'>(n)));
            reader_ctx.reader.dn_edit_was.push(reader_ctx.tokens[(int64<overflow='wrap'>(reader_ctx.at) - 1)]);
        }
        else if ((((reader_ctx.tokens[reader_ctx.at].kind =? 'identifier') and (int64<overflow='wrap'>(reader_ctx.tokens[reader_ctx.at].name) =? reader_ctx.reader.dn_void_id)) and (reader_ctx.tokens[(int64<overflow='wrap'>(reader_ctx.at) + 1)].symbol not=? 'pipe')) and (not ((reader_ctx.tokens[(int64<overflow='wrap'>(reader_ctx.at) + 1)].symbol =? 'amp') and (reader_ctx.tokens[(int64<overflow='wrap'>(reader_ctx.at) + 2)].symbol =? 'langle')))) {
            reader_ctx.at = (int64<overflow='wrap'>(reader_ctx.at) + 1)
            rd_add_flag(@reader_nodes n (NF_VOID or NF_WRITTEN_VOID));
        }
        else if (reader_ctx.stores.host[0].g_proof_pending() and (rd_dn_peek(@reader_ctx) =? 'langle')) {
            # (`$proof` then `:><a <=? c>`: the propositions it proves, joined, dw_function)
            let predicate:int64=rd_dc_facts(@reader_ctx @reader_nodes)
            if (predicate =? 0) {
                return 0
            }
            reader_ctx.stores.host[0].g_proof_decls_item_set(n predicate)
            rd_add_flag(@reader_nodes n NF_VOID);
        }
        else if rd_dc_fact_result_next(@reader_ctx) {
            let result:int64=rd_dc_fact_result(@reader_ctx @reader_nodes n)
            if (result =? 0) {
                return 0
            }
            reader_nodes[n].a = int32<overflow='wrap'>(result)
        }
        else {
            reader_ctx.reader.dc_effects_follow = true
            reader_ctx.reader.dc_grouped = 0
            let result:int64=rd_dc_annotation(@reader_ctx @reader_nodes 30)
            reader_ctx.reader.dc_effects_follow = false
            # (`:>A | B & no_effects` puts the row on the last alternative: an error; `(A | B) & ...`
            # is the row of the whole result)
            if ((result =? 0) or ((((reader_nodes[result].kind =? 'tunion') and (result not=? reader_ctx.reader.dc_grouped)) and (rd_dn_peek(@reader_ctx) =? 'amp')) and (not rd_dc_row_grouping(@reader_ctx @reader_nodes result)))) {
                return 0
            }
            let packed:int64=rd_dc_pack(@reader_ctx @reader_nodes result)
            if ((((packed =? result) and (reader_nodes[packed].kind =? 'tarray')) and (reader_nodes[packed].ival <? 0)) and (rd_dn_peek(@reader_ctx) =? 'amp')) {
                return 0
            }
            reader_nodes[n].a = int32<overflow='wrap'>(packed)
        }
        if ((rd_dn_peek(@reader_ctx) =? 'amp') and (not rd_dc_effect_row(@reader_ctx @reader_nodes n))) {
            return 0
        }
    }
    if (not rd_dn_accept(@reader_ctx 'function')) {
        return 0
    }
    reader_ctx.depth = (int64<overflow='wrap'>(reader_ctx.depth) - 1)
    # (`() => $extern` as a value: dw_extern_finish's mistake)
    if (((lambda and (reader_ctx.tokens[reader_ctx.at].kind =? 'metatag')) and reader_ctx.flags.report_now) and rd_dc_lambda_extern(@reader_ctx)) {
        return rd_dc_extern(@reader_ctx @reader_nodes n ps)
    }
    if lambda {
        let in_body:bool=reader_ctx.flags.fn_body
        reader_ctx.flags.fn_body = true
        let outer_result:int64=reader_ctx.reader.dc_fn_result
        reader_ctx.reader.dc_fn_result = (if (reader_nodes[n].a not=? 0) int64(2) else int64(1))
        let saved_map:bool=reader_ctx.reader.dc_map_ok
        reader_ctx.reader.dc_map_ok = false
        let body:int64=rd_dc_operand_body(@reader_ctx @reader_nodes)
        reader_ctx.reader.dc_map_ok = saved_map
        reader_ctx.reader.dc_fn_result = outer_result
        reader_ctx.flags.fn_body = in_body
        if (body =? 0) {
            return 0
        }
        reader_ctx.depth = (int64<overflow='wrap'>(reader_ctx.depth) - 2)
        return reader_ctx.stores.host[0].dw_finish_function(n ps body name)
    }
    # (`=> $extern(name='c_name')`: a C function, no body)
    if (((reader_ctx.tokens[reader_ctx.at].kind =? 'metatag') and (not reader_ctx.reader.dc_method_body)) and (rd_dn_payload(@reader_ctx reader_ctx.tokens[reader_ctx.at]) =? "extern")) {
        return rd_dc_extern(@reader_ctx @reader_nodes n ps)
    }
    # (`=> $intrinsic`: the compiler provides it, the declaration binds nothing: dw_intrinsic_check)
    if ((((reader_ctx.tokens[reader_ctx.at].kind =? 'metatag') and (not reader_ctx.reader.dc_method_body)) and (type_params.length =? 0)) and rd_dc_intrinsic_next(@reader_ctx)) {
        let next:DewyLexeme=reader_ctx.tokens[(int64<overflow='wrap'>(reader_ctx.at) + 1)]
        if ((name =? "") or ((next.kind not=? 'eof') and (not ((next.newline and (dn_power(next.symbol) =? 0)) and (next.symbol not=? 'kw_not'))))) {
            return 0
        }
        if (reader_ctx.stores.host[0].intrinsic_of(reader_ctx.stores.host[0].intern(name)) <? 0) {
            return rd_dc_not_intrinsic(@reader_ctx @reader_nodes n name)
        }
        reader_ctx.at = (int64<overflow='wrap'>(reader_ctx.at) + 1)
        reader_ctx.reader.dc_nothing = true
        return n
    }
    let concrete:bool=(type_params.length =? 0)
    loop p in ps {
        if (reader_nodes[p].a =? 0) {
            concrete = false
        }
    }
    let body:int64=(if ((concrete and (not reader_ctx.reader.dc_method_body)) and ((reader_nodes[n].a not=? 0) or ((reader_ctx.tokens[reader_ctx.at].kind =? 'lazy_body') and rd_has_flag(@reader_nodes n NF_VOID)))) rd_dc_lazy_body(@reader_ctx @reader_nodes) else int64(0))
    if ((body =? 0) and (reader_ctx.tokens[reader_ctx.at].kind =? 'lazy_body')) {
        reader_ctx.stores.host[0].dn_expand_lazy();
    }
    if (body =? 0) {
        reader_ctx.flags.unread_here = true
        reader_ctx.flags.fn_body = true
        let outer_result:int64=reader_ctx.reader.dc_fn_result
        reader_ctx.reader.dc_fn_result = (if (reader_nodes[n].a not=? 0) int64(2) else int64(1))
        body = rd_dc_body(@reader_ctx @reader_nodes)
        reader_ctx.reader.dc_fn_result = outer_result
        reader_ctx.flags.fn_body = false
        reader_ctx.flags.unread_here = false
    }
    if (body =? 0) {
        return 0
    }
    reader_ctx.depth = (int64<overflow='wrap'>(reader_ctx.depth) - 2)
    reader_ctx.stores.host[0].dw_finish_function(n ps body name)
}

# `<(x:T @y:U):>R>`: a function type, its parameters' labels and types (dw_type's `:>`); an effect
# row on it is left unread (dc_unread).
rd_dc_function_type=(@reader_ctx:ParserContext @reader_nodes:array<Node> angled:bool=true):>int64=>$unsafe {
    reader_ctx.at = (int64<overflow='wrap'>(reader_ctx.at) + int64<overflow='wrap'>((if angled int64(2) else int64(1))))
    let pos:int64=rd_mkpos(reader_ctx.file reader_ctx.tokens[(int64<overflow='wrap'>(reader_ctx.at) - 1)].start)
    let n:int64=node_mk(@reader_nodes 'tfn' pos)
    let types_:array<int64>=[]
    let labels:array<int64>=[]
    loop (not rd_dn_accept(@reader_ctx 'rparen')) {
        let first:DewyLexeme=reader_ctx.tokens[reader_ctx.at]
        let place:bool=rd_dn_accept(@reader_ctx 'at')
        let label:DewyLexeme=reader_ctx.tokens[reader_ctx.at]
        if ((((label.kind not=? 'identifier') or ((label.symbol not=? 'none') and (label.symbol not=? 'kw_test'))) or rd_dn_reserved(@reader_ctx int64<overflow='wrap'>(label.name))) or (reader_ctx.tokens[(int64<overflow='wrap'>(reader_ctx.at) + 1)].symbol not=? 'colon')) {
            return 0
        }
        reader_ctx.at = (int64<overflow='wrap'>(reader_ctx.at) + 2)
        let t:int64=rd_dc_annotation(@reader_ctx @reader_nodes)
        if (t =? 0) {
            return 0
        }
        # (dw_type's mistakes, noted: a default, a label written twice)
        if ((rd_dn_peek(@reader_ctx) =? 'assign') and ((not reader_ctx.flags.report_now) or (rd_dc_type_default(@reader_ctx @reader_nodes label) =? 0))) {
            return 0
        }
        if place {
            rd_add_flag(@reader_nodes t NF_MUT);
        }
        if (rd_dc_word(@reader_ctx int64<overflow='wrap'>(label.name)) not=? DC_HOLE) {
            loop earlier in labels {
                if (reader_nodes[earlier].name =? label.name) {
                    if (not reader_ctx.flags.report_now) {
                        return 0
                    }
                    rd_dc_report(@reader_ctx rd_mkpos(reader_ctx.file label.start) "duplicate callable parameter name '{rd_dn_payload(@reader_ctx label)}'");
                }
            }
        }
        let named:int64=node_mk(@reader_nodes 'ident' rd_mkpos(reader_ctx.file first.start))
        reader_nodes[named].name = label.name
        labels.push(named);
        types_.push(t);
    }
    if (not rd_dn_accept(@reader_ctx 'returns')) {
        return 0
    }
    if (((reader_ctx.tokens[reader_ctx.at].kind =? 'identifier') and (int64<overflow='wrap'>(reader_ctx.tokens[reader_ctx.at].name) =? reader_ctx.reader.dn_void_id)) and (reader_ctx.tokens[(int64<overflow='wrap'>(reader_ctx.at) + 1)].symbol not=? 'pipe')) {
        reader_ctx.at = (int64<overflow='wrap'>(reader_ctx.at) + 1)
    }
    else {
        # (its closer may be joined: `dict<string <(x:int64):>int64>>`; without angles, the
        # enclosing type argument's, `array<():>int64>`)
        let saved_args:int64=reader_ctx.reader.dc_type_args
        let saved_follow:bool=reader_ctx.reader.dc_effects_follow
        if angled {
            reader_ctx.reader.dc_type_args = 1
        }
        reader_ctx.reader.dc_grouped = 0
        reader_ctx.reader.dc_effects_follow = true
        let result:int64=rd_dc_annotation(@reader_ctx @reader_nodes)
        reader_ctx.reader.dc_effects_follow = saved_follow
        reader_ctx.reader.dc_type_args = (if angled int64(0) else saved_args)
        if ((result =? 0) or (((reader_nodes[result].kind =? 'tunion') and (result not=? reader_ctx.reader.dc_grouped)) and (rd_dn_peek(@reader_ctx) =? 'amp'))) {
            return 0
        }
        let packed:int64=rd_dc_pack(@reader_ctx @reader_nodes result)
        if ((((packed =? result) and (reader_nodes[packed].kind =? 'tarray')) and (reader_nodes[packed].ival <? 0)) and (rd_dn_peek(@reader_ctx) =? 'amp')) {
            return 0
        }
        reader_nodes[n].a = int32<overflow='wrap'>(packed)
    }
    # (`<(x:int64):>int64 & E>`: its effect row, dw_effect_suffix)
    if ((rd_dn_peek(@reader_ctx) =? 'amp') and (not rd_dc_effect_row(@reader_ctx @reader_nodes n))) {
        return 0
    }
    if (not angled) {
        node_set_list(@reader_nodes @reader_ctx.stores.lists[0] n types_);
        node_set_list2(@reader_nodes @reader_ctx.stores.lists[0] n labels);
        return n
    }
    if (not rd_dn_accept(@reader_ctx 'rangle')) {
        if (not (reader_ctx.reader.dn_edits_on and rd_dn_closer_joined(@reader_ctx))) {
            return 0
        }
        rd_dn_split_closer(@reader_ctx);
    }
    node_set_list(@reader_nodes @reader_ctx.stores.lists[0] n types_);
    node_set_list2(@reader_nodes @reader_ctx.stores.lists[0] n labels);
    n
}

# `<T U>(params) =>` opens here.
rd_dc_generic_lambda_next=(@reader_ctx:ParserContext):>bool=>$unsafe {
    rd_dc_generic_lambda_next_at(@reader_ctx reader_ctx.at)
}

rd_dc_generic_lambda_next_at=(@reader_ctx:ParserContext start:int64):>bool=>$unsafe {
    let at:int64=(int64<overflow='wrap'>(start) + 1)
    loop (reader_ctx.tokens[at].kind =? 'identifier') and (reader_ctx.tokens[at].symbol =? 'none') {
        at = (int64<overflow='wrap'>(at) + 1)
    }
    (((((at >? (int64<overflow='wrap'>(start) + 1)) and (reader_ctx.tokens[at].symbol =? 'rangle')) and (reader_ctx.tokens[(int64<overflow='wrap'>(at) + 1)].symbol =? 'lparen')) and (not reader_ctx.tokens[(int64<overflow='wrap'>(at) + 1)].space)) and rd_dc_lambda_next_at(@reader_ctx (int64<overflow='wrap'>(at) + 1)))
}

rd_dc_generic_main=(@reader_ctx:ParserContext opening:DewyLexeme):>int64=>$unsafe {
    rd_dc_fail_now(@reader_ctx rd_mkpos(reader_ctx.file opening.start) "Dewy does not yet support a generic entry point")
}

rd_dc_granted=(@reader_ctx:ParserContext pos:int64 word:string):>bool=>$unsafe {
    if (not reader_ctx.flags.report_now) {
        return false
    }
    rd_dc_report(@reader_ctx pos "`{word}` is inferred, never granted: a row can only exclude it, `& no {word}`");
    true
}

rd_dc_group=(@reader_ctx:ParserContext @reader_nodes:array<Node> pos:int64):>int64=>$unsafe {
    # (`(a b)`: several values, dw_values; each may be spread, `(xs... 1)`)
    let saved_spread:int64=reader_ctx.reader.dc_spread_depth
    reader_ctx.reader.dc_spread_depth = (int64<overflow='wrap'>(reader_ctx.depth) + 1)
    let n:int64=rd_dc_expr(@reader_ctx @reader_nodes 0)
    let items:array<int64>=[]
    loop (n not=? 0) and (not rd_dn_accept(@reader_ctx 'rparen')) {
        if (items.length =? 0) {
            items.push(n);
        }
        if ((not dn_can_start(@reader_ctx.tokens reader_ctx.at)) or (reader_ctx.tokens[reader_ctx.at].symbol =? 'rparen')) {
            n = 0
            break
        }
        reader_ctx.reader.dc_spread_depth = (int64<overflow='wrap'>(reader_ctx.depth) + 1)
        let item:int64=rd_dc_expr(@reader_ctx @reader_nodes 0)
        if (item =? 0) {
            n = 0
        }
        else {
            items.push(item);
        }
    }
    reader_ctx.reader.dc_spread_depth = saved_spread
    if (n =? 0) {
        return 0
    }
    if (items.length =? 0) {
        # (`(xs...)`: dw_expr's mistake, should nothing else read it)
        if rd_has_flag(@reader_nodes n NF_SPREAD) {
            return rd_dc_hint(@reader_ctx reader_nodes[n].pos "spread is supported inside array or record literals and call arguments: `[values... item]`, `[base... field=value]`, `add(pair...)`")
        }
        return n
    }
    let values:int64=node_mk(@reader_nodes 'tuple' pos)
    reader_nodes[values].aux = int32<overflow='wrap'>(TUPLE_VALUES)
    node_set_list(@reader_nodes @reader_ctx.stores.lists[0] values items);
    return values
}

# `let (a) = (1)`: one name in parentheses, `)` at close (dw_declare's mistake, should nothing else
# read it), written again without them when the value ends its line.
rd_dc_grouped_binder=(@reader_ctx:ParserContext close:int64):>int64=>$unsafe {
    let opening:int64=rd_dc_open_paren(@reader_ctx close)
    let pos:int64=rd_mkpos(reader_ctx.file reader_ctx.tokens[opening].start)
    let src:string=reader_ctx.source
    let keyword:string=rd_dn_payload(@reader_ctx reader_ctx.tokens[(int64<overflow='wrap'>(opening) - 1)])
    let written:string=reader_ctx.stores.host[0].bytes_slice(src reader_ctx.tokens[(int64<overflow='wrap'>(opening) + 1)].start reader_ctx.tokens[(int64<overflow='wrap'>(close) - 1)].stop)
    let first:int64=(int64<overflow='wrap'>(close) + 2)
    if (((reader_ctx.tokens[(int64<overflow='wrap'>(close) + 1)].symbol not=? 'assign') or reader_ctx.tokens[first].newline) or (reader_ctx.tokens[first].kind =? 'eof')) {
        return rd_dc_hint(@reader_ctx pos "a parenthesized name is not a binding pattern: write `{keyword} {written} = value`")
    }
    let last:int64=first
    loop (reader_ctx.tokens[(int64<overflow='wrap'>(last) + 1)].kind not=? 'eof') and (not reader_ctx.tokens[(int64<overflow='wrap'>(last) + 1)].newline) and (reader_ctx.tokens[(int64<overflow='wrap'>(last) + 1)].symbol not=? 'rbrace') {
        last = (int64<overflow='wrap'>(last) + 1)
    }
    # (a value wholly in parentheses, `(1)`, is written without them)
    if ((((reader_ctx.tokens[first].symbol =? 'lparen') and (reader_ctx.tokens[last].symbol =? 'rparen')) and (rd_dc_closing(@reader_ctx first) =? last)) and (last >? (int64<overflow='wrap'>(first) + 1))) {
        first = (int64<overflow='wrap'>(first) + 1)
        last = (int64<overflow='wrap'>(last) - 1)
    }
    let value:string=reader_ctx.stores.host[0].bytes_slice(src reader_ctx.tokens[first].start reader_ctx.tokens[last].stop)
    rd_dc_hint(@reader_ctx pos "a parenthesized name is not a binding pattern: write `{keyword} {written} = {value}`")
}

# A parenthesized update is the update (dw_stmt's grouped assignment): 0 for another form.
rd_dc_grouped_update=(@reader_ctx:ParserContext @reader_nodes:array<Node>):>int64=>$unsafe {
    reader_ctx.at = (int64<overflow='wrap'>(reader_ctx.at) + 1)
    let pos:int64=rd_mkpos(reader_ctx.file reader_ctx.tokens[reader_ctx.at].start)
    let left:int64=rd_dc_expr(@reader_ctx @reader_nodes 11)
    if ((left =? 0) or (reader_nodes[left].kind =? 'lambda')) {
        return 0
    }
    let op:DewyToken=rd_dn_peek(@reader_ctx)
    if (not dn_token_assignment(op)) {
        return 0
    }
    reader_ctx.at = (int64<overflow='wrap'>(reader_ctx.at) + 1)
    let right:int64=rd_dc_expr(@reader_ctx @reader_nodes 11)
    if (((right =? 0) or (reader_nodes[right].kind =? 'lambda')) or (not rd_dn_accept(@reader_ctx 'rparen'))) {
        return 0
    }
    rd_dc_assign_node(@reader_ctx @reader_nodes op left right pos)
}

# An `and` chain from its first term (`and` binds more tightly than `or`).
rd_dc_head_and=(@reader_ctx:ParserContext @reader_nodes:array<Node> first:int64):>int64=>$unsafe {
    let left:int64=first
    loop (left not=? 0) and (rd_dn_peek(@reader_ctx) =? 'kw_and') {
        reader_ctx.at = (int64<overflow='wrap'>(reader_ctx.at) + 1)
        left = rd_dc_head_join(@reader_ctx @reader_nodes 2 left rd_dc_head_term(@reader_ctx @reader_nodes))
    }
    left
}

# A combined iteration binds by value, and steps a stepped range by its iterator.
rd_dc_head_combined=(@reader_ctx:ParserContext @reader_nodes:array<Node> head:int64):>bool=>$unsafe {
    if (reader_nodes[head].op not=? 1) {
        return true
    }
    if (rd_has_flag(@reader_nodes head NF_MUT) or reader_ctx.stores.host[0].g_dewy_live_sources_has(int64<overflow='wrap'>(reader_nodes[head].a))) {
        return rd_dc_combined_mistake(@reader_ctx @reader_nodes head)
    }
    let it:int64=int64<overflow='wrap'>(reader_nodes[head].a)
    if ((reader_nodes[it].kind =? 'range') and rd_has_flag(@reader_nodes it NF_STEP)) {
        if (reader_nodes[it].b =? 0) {
            it = rd_bc_call(@reader_ctx @reader_nodes "__dewy_open_range_iter" [int64<overflow='wrap'>(reader_nodes[it].a) int64<overflow='wrap'>(reader_nodes[it].c)] reader_nodes[it].pos)
        }
        else {
            it = rd_bc_call(@reader_ctx @reader_nodes "__dewy_iter" [reader_ctx.stores.host[0].dw_range_value(it)] reader_nodes[it].pos)
        }
        reader_nodes[head].a = int32<overflow='wrap'>(it)
    }
    true
}

# `a and b`, `a or b`: each side a combined head (dw_loop_head's `combined`).
rd_dc_head_join=(@reader_ctx:ParserContext @reader_nodes:array<Node> op:int64 a:int64 b:int64):>int64=>$unsafe {
    if ((((a =? 0) or (b =? 0)) or (not rd_dc_head_combined(@reader_ctx @reader_nodes a))) or (not rd_dc_head_combined(@reader_ctx @reader_nodes b))) {
        return 0
    }
    let n:int64=node_mk(@reader_nodes 'lhead' reader_nodes[a].pos)
    reader_nodes[n].op = int32<overflow='wrap'>(op)
    reader_nodes[n].a = int32<overflow='wrap'>(a)
    reader_nodes[n].b = int32<overflow='wrap'>(b)
    reader_ctx.stores.host[0].head_collapse(n)
}

# `loop name in w=tree.walk()`, `loop c in text as T`: dw_loop_head's and dn_expr's mistakes;
# false for any other head.
rd_dc_head_mistake=(@reader_ctx:ParserContext @reader_nodes:array<Node> head:int64):>bool=>$unsafe {
    if ((not reader_ctx.flags.report_now) or (reader_nodes[head].op not=? 1)) {
        return false
    }
    let next:DewyLexeme=reader_ctx.tokens[reader_ctx.at]
    if ((next.symbol =? 'kw_as') or (next.symbol =? 'kw_transmute')) {
        reader_ctx.stores.host[0].dn_error(next.start "`{dn_token_text(next.symbol)}` binds more loosely than `in`, so this converts the whole loop header: parenthesize the source, as in `loop c in (text {dn_token_text(next.symbol)} array<uint8>)`");
    }
    if (next.symbol not=? 'assign') {
        return false
    }
    let it:int64=int64<overflow='wrap'>(reader_nodes[head].a)
    let it_name:string="it"
    if (((reader_nodes[it].kind =? 'call') and (rd_nkids(@reader_nodes it) =? 1)) and (reader_nodes[rd_kid(@reader_ctx @reader_nodes it 0)].kind =? 'ident')) {
        it_name = rd_name_of(@reader_ctx int64<overflow='wrap'>(reader_nodes[rd_kid(@reader_ctx @reader_nodes it 0)].name))
    }
    rd_dc_report(@reader_ctx reader_nodes[head].pos "bind the iterator first, then loop over its place so the body can steer it: `let {it_name}=source` then `loop item in @{it_name} \{ ... }`");
    reader_ctx.at = (int64<overflow='wrap'>(reader_ctx.at) + 1)
    (rd_dc_expr(@reader_ctx @reader_nodes 11) not=? 0)
}

# `name in xs`, `@name in xs` (each element in place), `[a b] in xs` (unpacked), or a condition.
rd_dc_head_term=(@reader_ctx:ParserContext @reader_nodes:array<Node>):>int64=>$unsafe {
    let head:int64=node_mk(@reader_nodes 'lhead' rd_mkpos(reader_ctx.file reader_ctx.tokens[reader_ctx.at].start))
    let first:DewyToken=reader_ctx.tokens[reader_ctx.at].symbol
    let place:bool=(first =? 'at')
    let at:int64=reader_ctx.at
    if place {
        at = (int64<overflow='wrap'>(at) + 1)
    }
    # (`loop @[x] in xs`: dw_loop_head's mistake, noted; read as the pattern)
    if ((place and (reader_ctx.tokens[at].symbol =? 'lbrack')) and reader_ctx.flags.report_now) {
        rd_dc_unsupported(@reader_ctx rd_mkpos(reader_ctx.file reader_ctx.tokens[at].start) "unpacking a mutable loop binding; use a named @item and its fields");
        place = false
        reader_ctx.at = (int64<overflow='wrap'>(reader_ctx.at) + 1)
    }
    let named:bool=(((reader_ctx.tokens[at].kind =? 'identifier') and (reader_ctx.tokens[at].symbol =? 'none')) and (reader_ctx.tokens[(int64<overflow='wrap'>(at) + 1)].symbol =? 'kw_in'))
    # (`loop none in xs`: dw_loop_head's mistake)
    if (named and rd_dn_reserved(@reader_ctx int64<overflow='wrap'>(reader_ctx.tokens[at].name))) {
        rd_dc_reserved_at(@reader_ctx reader_ctx.tokens[at]);
    }
    if (not (named or ((reader_ctx.tokens[at].symbol =? 'lbrack') and (not place)))) {
        # (`loop k, v in pairs`: dw_loop_head's mistake, at once)
        if (reader_ctx.flags.report_now and rd_dc_comma_names(@reader_ctx at)) {
            return rd_dc_fail_now(@reader_ctx rd_mkpos(reader_ctx.file reader_ctx.tokens[at].start) "several loop names go in brackets: `loop [key value] in pairs \{ ... }`")
        }
        let saved_head:int64=reader_ctx.reader.dc_head_depth
        reader_ctx.reader.dc_head_depth = (int64<overflow='wrap'>(reader_ctx.depth) + 1)
        let condition:int64=rd_dc_expr(@reader_ctx @reader_nodes 71)
        reader_ctx.reader.dc_head_depth = saved_head
        # (`loop 1 in xs`: no name binds, dw_loop_head's mistake should nothing else read it)
        if ((condition =? 0) and (rd_dn_peek(@reader_ctx) =? 'kw_in')) {
            return rd_dc_hint(@reader_ctx reader_nodes[head].pos "a loop binding needs a name or pattern: write `loop x in items \{ ... }`")
        }
        if (condition =? 0) {
            return 0
        }
        # (`x in? xs`: a membership, a condition; `f(x) in xs` is no expression dc_expr reads)
        reader_nodes[head].op = 4
        reader_nodes[head].a = int32<overflow='wrap'>(condition)
        return head
    }
    reader_nodes[head].op = 1
    if place {
        rd_add_flag(@reader_nodes head NF_MUT);
        reader_ctx.at = (int64<overflow='wrap'>(reader_ctx.at) + 1)
    }
    let binder_pos:int64=rd_mkpos(reader_ctx.file reader_ctx.tokens[reader_ctx.at].start)
    if named {
        let value:int64=node_mk(@reader_nodes 'ident' binder_pos)
        reader_nodes[value].name = rd_dw_value_name(@reader_ctx reader_ctx.tokens[reader_ctx.at].name binder_pos)
        reader_ctx.at = (int64<overflow='wrap'>(reader_ctx.at) + 2)
        node_set_list(@reader_nodes @reader_ctx.stores.lists[0] head [value]);
    }
    else {
        reader_ctx.at = (int64<overflow='wrap'>(reader_ctx.at) + 1)
        let seen:array<int64>=[]
        let binders:array<int64>=rd_dc_binding_items(@reader_ctx @reader_nodes @seen)
        if ((binders.length =? 0) or (not rd_dn_accept(@reader_ctx 'kw_in'))) {
            return 0
        }
        # (one element still unpacks the iteration value)
        if (binders.length =? 1) {
            let pattern:int64=node_mk(@reader_nodes 'tuple' binder_pos)
            node_set_list(@reader_nodes @reader_ctx.stores.lists[0] pattern binders);
            binders = [pattern]
        }
        node_set_list(@reader_nodes @reader_ctx.stores.lists[0] head binders);
    }
    let it:int64=0
    if place {
        # (in place: a name or a field route of one, read as it is; `loop @x in @xs`, dw_loop_head's
        # mistake should nothing else read it)
        if (rd_dn_peek(@reader_ctx) =? 'at') {
            return rd_dc_hint(@reader_ctx reader_nodes[head].pos "`loop @item in @items` combines two places: iterate the live array by value (`loop item in @items`) or edit its elements in place (`loop @item in items`)")
        }
        it = rd_dc_expr(@reader_ctx @reader_nodes 96)
        if (it =? 0) {
            return 0
        }
        let root:int64=it
        loop (reader_nodes[root].kind =? 'field') {
            root = int64<overflow='wrap'>(reader_nodes[root].a)
        }
        if (reader_nodes[root].kind not=? 'ident') {
            if (not reader_ctx.flags.report_now) {
                return 0
            }
            rd_dc_unsupported(@reader_ctx reader_nodes[head].pos "mutable iteration over this expression; use an array binding or a field of one");
        }
    }
    else if (rd_dn_peek(@reader_ctx) =? 'at') {
        # `loop x in @xs`: the place iterated live, one name bound (dw_live_loop)
        if (not named) {
            if (not reader_ctx.flags.report_now) {
                return 0
            }
            rd_dc_report(@reader_ctx binder_pos "a live loop (`in @items`) binds one name: bind the element, then unpack it in the body");
        }
        let live_at:int64=reader_ctx.at
        reader_ctx.at = (int64<overflow='wrap'>(reader_ctx.at) + 1)
        it = rd_dc_expr(@reader_ctx @reader_nodes dn_prefix_power('at' false))
        if ((it =? 0) or (dn_power(rd_dn_peek(@reader_ctx)) >=? 96)) {
            return 0
        }
        let root:int64=it
        loop (reader_nodes[root].kind =? 'field') {
            root = int64<overflow='wrap'>(reader_nodes[root].a)
        }
        if (reader_nodes[root].kind not=? 'ident') {
            return 0
        }
        reader_ctx.stores.host[0].g_dewy_live_sources_item_set(it true)
        reader_ctx.reader.dc_live_at_pos[head] = rd_mkpos(reader_ctx.file reader_ctx.tokens[live_at].start)
        reader_ctx.reader.dn_edit_at.push((int64<overflow='wrap'>(DN_EDIT_LIVE) - int64<overflow='wrap'>(it)));
        reader_ctx.reader.dn_edit_was.push(reader_ctx.tokens[(int64<overflow='wrap'>(reader_ctx.at) - 1)]);
    }
    else {
        it = rd_dc_iterable(@reader_ctx @reader_nodes)
    }
    if (it =? 0) {
        return 0
    }
    reader_nodes[head].a = int32<overflow='wrap'>(it)
    head
}

rd_dc_hide=(@reader_ctx:ParserContext names:array<int64>):>void=>$unsafe {
    let reader_builder=reader_ctx.stores.builder
    dm_hide(@reader_ctx @reader_builder[0] names);
}

# First hint since the statement began, retained only if no reading succeeds.
rd_dc_hint=(@reader_ctx:ParserContext pos:int64 msg:string):>int64=>$unsafe {
    dc_parser_hint(@reader_ctx.status pos msg)
}

# `import m`, `import m as n`, `import p"file.dewy"`, `from m import a, b as c` (dw_import); a
# parenthesized selection and the reversed order are left unread (dc_unread).
rd_dc_import=(@reader_ctx:ParserContext @reader_nodes:array<Node>):>int64=>$unsafe {
    let keyword:DewyLexeme=rd_dn_take(@reader_ctx)
    let n:int64=node_mk(@reader_nodes 'import_' rd_mkpos(reader_ctx.file keyword.start))
    # (`import (a b) from p"x"` is `from p"x" import (a b)`, dw_import)
    let imported:array<int64>=[]
    let reversed:bool=((keyword.symbol =? 'kw_import') and (rd_dn_peek(@reader_ctx) =? 'lparen'))
    if reversed {
        if ((not rd_dc_import_list(@reader_ctx @reader_nodes @imported)) or (not rd_dn_accept(@reader_ctx 'kw_from'))) {
            return 0
        }
    }
    let spec:DewyLexeme=reader_ctx.tokens[reader_ctx.at]
    if (not rd_dc_import_word(@reader_ctx spec)) {
        return 0
    }
    reader_ctx.at = (int64<overflow='wrap'>(reader_ctx.at) + 1)
    let value:string=rd_dn_payload(@reader_ctx spec)
    let path:DewyLexeme=reader_ctx.tokens[reader_ctx.at]
    if (((rd_dc_word(@reader_ctx int64<overflow='wrap'>(spec.name)) =? DC_P) and (not path.space)) and (path.kind =? 'quoted')) {
        if (not rd_dc_plain_quote(@reader_ctx path)) {
            return 0
        }
        let text:int64=rd_dn_string(@reader_ctx @reader_nodes path)
        if (text =? 0) {
            return 0
        }
        value = rd_name_of(@reader_ctx int64<overflow='wrap'>(reader_nodes[text].sval))
        reader_nodes[n].aux2 = 1
        reader_ctx.at = (int64<overflow='wrap'>(reader_ctx.at) + 1)
    }
    let alias:string=""
    if rd_dn_accept(@reader_ctx 'kw_as') {
        if (not rd_dc_import_alias(@reader_ctx reader_ctx.tokens[reader_ctx.at])) {
            return 0
        }
        alias = rd_dn_payload(@reader_ctx rd_dn_take(@reader_ctx))
    }
    reader_nodes[n].sval = int32<overflow='wrap'>(reader_ctx.stores.host[0].intern(value))
    reader_nodes[n].name = int32<overflow='wrap'>(reader_ctx.stores.host[0].intern(strip_ext(reader_ctx.stores.host[0].file_name(value))))
    if (alias not=? "") {
        reader_nodes[n].name = int32<overflow='wrap'>(reader_ctx.stores.host[0].intern(alias))
    }
    if ((keyword.symbol =? 'kw_from') or reversed) {
        if ((not reversed) and ((not rd_dn_accept(@reader_ctx 'kw_import')) or (not rd_dc_import_list(@reader_ctx @reader_nodes @imported)))) {
            return 0
        }
        reader_nodes[n].aux = 2
        node_set_list(@reader_nodes @reader_ctx.stores.lists[0] n imported);
    }
    else if ((alias =? "") and (reader_nodes[n].aux2 =? 1)) {
        reader_nodes[n].aux = 3
    }
    let next:DewyLexeme=reader_ctx.tokens[reader_ctx.at]
    # (`from m import a b`, `import m n`: dn_stmt's mistakes, at once)
    if (((not next.newline) and reader_ctx.flags.report_now) and dn_can_start(@reader_ctx.tokens reader_ctx.at)) {
        rd_dc_import_mistake(@reader_ctx ((keyword.symbol =? 'kw_import') and (not reversed)));
    }
    # (`import a, b`: dw_import's mistake, should nothing else read it)
    if (((next.symbol =? 'comma') and (keyword.symbol =? 'kw_import')) and (not reversed)) {
        return rd_dc_hint(@reader_ctx rd_mkpos(reader_ctx.file spec.start) "Dewy does not yet support this module path; use a library name or p\"file.dewy\"")
    }
    if (((next.kind not=? 'eof') and (not ((next.newline and (dn_power(next.symbol) =? 0)) and (next.symbol not=? 'kw_not')))) and (not (((next.symbol =? 'semi') and (not next.space)) and (not next.newline)))) {
        return 0
    }
    rd_dn_accept_semi(@reader_ctx);
    n
}

# An alias (`as void`: dw_import's mistake, a reserved word).
rd_dc_import_alias=(@reader_ctx:ParserContext token:DewyLexeme):>bool=>$unsafe {
    if (((token.kind =? 'identifier') and (token.symbol =? 'none')) and rd_dn_reserved(@reader_ctx int64<overflow='wrap'>(token.name))) {
        rd_dc_reserved_at(@reader_ctx token);
        return true
    }
    rd_dc_import_word(@reader_ctx token)
}

# The names an import selects, in order, each with an optional alias: `a, b as c` or `(a b as c)`;
# a group may be one of the comma-separated names, `(A as B), c` (dw_import_words).
rd_dc_import_list=(@reader_ctx:ParserContext @reader_nodes:array<Node> @imported:array<int64>):>bool=>$unsafe {
    let grouped:bool=false
    loop true {
        if ((not grouped) and rd_dn_accept(@reader_ctx 'lparen')) {
            grouped = true
        }
        let word:DewyLexeme=reader_ctx.tokens[reader_ctx.at]
        if (not rd_dc_import_word(@reader_ctx word)) {
            return false
        }
        reader_ctx.at = (int64<overflow='wrap'>(reader_ctx.at) + 1)
        let item:int64=node_mk(@reader_nodes 'ident' rd_mkpos(reader_ctx.file word.start))
        reader_nodes[item].name = rd_dw_value_name(@reader_ctx word.name reader_nodes[item].pos)
        if rd_dn_accept(@reader_ctx 'kw_as') {
            if (not rd_dc_import_alias(@reader_ctx reader_ctx.tokens[reader_ctx.at])) {
                return false
            }
            reader_nodes[item].aux = int32<overflow='wrap'>(reader_ctx.stores.host[0].intern(rd_dn_payload(@reader_ctx rd_dn_take(@reader_ctx))))
        }
        imported.push(item);
        if (grouped and rd_dn_accept(@reader_ctx 'rparen')) {
            if (rd_dn_peek(@reader_ctx) not=? 'comma') {
                return true
            }
            reader_ctx.at = (int64<overflow='wrap'>(reader_ctx.at) + 1)
            grouped = false
        }
        else if ((not rd_dn_accept(@reader_ctx 'comma')) and (not grouped)) {
            return true
        }
    }
    true
}

rd_dc_import_mistake=(@reader_ctx:ParserContext module:bool):>void=>$unsafe {
    if module {
        reader_ctx.stores.host[0].dn_error(reader_ctx.tokens[reader_ctx.at].start "an `import` line takes one module: put the next on a line of its own, or take names from a module with `from m import a, b`");
    }
    reader_ctx.stores.host[0].dn_error(reader_ctx.tokens[reader_ctx.at].start "imported names are separated by commas, `import a, b`, or listed in parentheses, `import (a b)`");
}

# A name an import may bind (not a reserved word or one with a meaning of its own).
rd_dc_import_word=(@reader_ctx:ParserContext token:DewyLexeme):>bool=>$unsafe {
    if (((token.kind not=? 'identifier') or (token.symbol not=? 'none')) or rd_dn_reserved(@reader_ctx int64<overflow='wrap'>(token.name))) {
        return false
    }
    let name:int64=int64<overflow='wrap'>(token.name)
    (((((name not=? reader_ctx.reader.dn_end_id) and (name not=? reader_ctx.reader.dn_new_id)) and (name not=? reader_ctx.reader.dn_type_id)) and (name not=? reader_ctx.reader.dn_none_id)) and (rd_dn_payload(@reader_ctx token) not=? "Cancelled"))
}

# `item in xs` outside a loop's head (Python's `for x in xs`, `if x in xs`): dw_expr's mistake,
# noted; its right operand read on.
rd_dc_in_mistake=(@reader_ctx:ParserContext @reader_nodes:array<Node> pos:int64):>int64=>$unsafe {
    if (((not reader_ctx.flags.report_now) or (reader_ctx.reader.dn_in_interpolation >? 0)) or (reader_ctx.reader.dc_head_depth =? reader_ctx.depth)) {
        return 0
    }
    rd_dc_report(@reader_ctx pos "`in` names a loop's values, as in `loop item in items \{ ... }`; membership is `in?`, as in `if x in? xs \{ ... }`");
    reader_ctx.at = (int64<overflow='wrap'>(reader_ctx.at) + 1)
    rd_dc_expr(@reader_ctx @reader_nodes (int64<overflow='wrap'>(dn_power('kw_in')) + 1))
}

# `$include_bytes(p"asset") as name`, a statement: the asset's bytes bound to the name (dw_stmt's
# asset binding).
rd_dc_include_binding=(@reader_ctx:ParserContext @reader_nodes:array<Node> token:DewyLexeme):>int64=>$unsafe {
    let pos:int64=rd_mkpos(reader_ctx.file token.start)
    reader_ctx.at = (int64<overflow='wrap'>(reader_ctx.at) + 1)
    if ((not rd_dc_include_form(@reader_ctx)) or (reader_ctx.tokens[(int64<overflow='wrap'>(reader_ctx.at) + 4)].symbol not=? 'kw_as')) {
        return 0
    }
    let name:DewyLexeme=reader_ctx.tokens[(int64<overflow='wrap'>(reader_ctx.at) + 5)]
    if (((name.kind not=? 'identifier') or (name.symbol not=? 'none')) or rd_dn_reserved(@reader_ctx int64<overflow='wrap'>(name.name))) {
        return 0
    }
    let n:int64=node_mk(@reader_nodes 'vardecl' pos)
    let value:int64=rd_dc_include_bytes(@reader_ctx @reader_nodes pos)
    if (value =? 0) {
        return 0
    }
    reader_ctx.at = (int64<overflow='wrap'>(reader_ctx.at) + 2)
    reader_nodes[n].name = name.name
    reader_nodes[n].b = int32<overflow='wrap'>(value)
    rd_dc_accept_semi(@reader_ctx (not reader_ctx.reader.dc_unbraced));
    n
}

# `$include_bytes(p"asset")` after its tag: the asset's bytes, `embed("asset")` (dw_include); the
# forms dw_include reports are left unread (dc_unread).
rd_dc_include_bytes=(@reader_ctx:ParserContext @reader_nodes:array<Node> pos:int64):>int64=>$unsafe {
    if (not rd_dc_include_form(@reader_ctx)) {
        return 0
    }
    let path:DewyLexeme=reader_ctx.tokens[(int64<overflow='wrap'>(reader_ctx.at) + 2)]
    reader_ctx.at = (int64<overflow='wrap'>(reader_ctx.at) + 4)
    let text:int64=rd_dn_string(@reader_ctx @reader_nodes path)
    if ((text =? 0) or (reader_nodes[text].kind not=? 'str_lit')) {
        return 0
    }
    let callee:int64=node_mk(@reader_nodes 'ident' pos)
    reader_nodes[callee].name = int32<overflow='wrap'>(reader_ctx.stores.host[0].intern("embed"))
    let call:int64=node_mk(@reader_nodes 'call' pos)
    reader_nodes[call].a = int32<overflow='wrap'>(callee)
    node_set_list(@reader_nodes @reader_ctx.stores.lists[0] call [text]);
    call
}

# `(p"asset")` after `$include_bytes`.
rd_dc_include_form=(@reader_ctx:ParserContext):>bool=>$unsafe {
    let opening:DewyLexeme=reader_ctx.tokens[reader_ctx.at]
    let p:DewyLexeme=reader_ctx.tokens[(int64<overflow='wrap'>(reader_ctx.at) + 1)]
    let path:DewyLexeme=reader_ctx.tokens[(int64<overflow='wrap'>(reader_ctx.at) + 2)]
    ((((((((opening.symbol =? 'lparen') and (not opening.space)) and (p.kind =? 'identifier')) and (p.symbol =? 'none')) and (rd_dn_payload(@reader_ctx p) =? "p")) and (path.kind =? 'quoted')) and (not path.space)) and (reader_ctx.tokens[(int64<overflow='wrap'>(reader_ctx.at) + 3)].symbol =? 'rparen'))
}

# An index's entries after its `[`, through its `]`: `xs[i]`, `m[i j]`, `Point[x=1 y=2]`, or one
# slice, `xs[a..b]`, `xs[a..b)`, `xs[a..]`, `xs[..b)`.
rd_dc_index=(@reader_ctx:ParserContext @reader_nodes:array<Node> n:int64):>bool=>$unsafe {
    if (reader_ctx.tokens[reader_ctx.at].kind =? 'metatag') {
        return rd_dc_clamp(@reader_ctx @reader_nodes n)
    }
    if rd_dc_new_inside(@reader_ctx) {
        return rd_dc_new_axes(@reader_ctx @reader_nodes n)
    }
    # (`mean[loop r in rs r*2]`: one comprehension, dw_comprehension)
    if (rd_dn_peek(@reader_ctx) =? 'kw_loop') {
        let made:int64=rd_dc_comprehension(@reader_ctx @reader_nodes)
        if (made =? 0) {
            return false
        }
        node_set_list(@reader_nodes @reader_ctx.stores.lists[0] n [made]);
        reader_nodes[n].b = int32<overflow='wrap'>(made)
        return true
    }
    # (`sum[parallel x in xs x*x]`: one parallel comprehension, dw_parallel)
    if (rd_dn_peek(@reader_ctx) =? 'kw_parallel') {
        let region:int64=rd_dc_parallel(@reader_ctx @reader_nodes rd_dn_take(@reader_ctx) true)
        if ((region =? 0) or (not rd_dn_accept(@reader_ctx 'rbrack'))) {
            return false
        }
        node_set_list(@reader_nodes @reader_ctx.stores.lists[0] n [region]);
        reader_nodes[n].b = int32<overflow='wrap'>(region)
        return true
    }
    let first_pos:int64=rd_mkpos(reader_ctx.file reader_ctx.tokens[reader_ctx.at].start)
    let first:int64=0
    if ((rd_dn_peek(@reader_ctx) =? 'rbrack') or rd_dc_named_next(@reader_ctx)) {
        if (not rd_dc_axes(@reader_ctx @reader_nodes n 0 0)) {
            return false
        }
        if (rd_nkids(@reader_nodes n) =? 1) {
            reader_nodes[n].b = int32<overflow='wrap'>(rd_kid(@reader_ctx @reader_nodes n 0))
        }
        return true
    }
    let first_range:int64=0
    if rd_dc_whole_axis(@reader_ctx) {
        # (`m[[..] 1]`: a whole axis, among several)
        first = node_mk(@reader_nodes 'range' rd_mkpos(reader_ctx.file reader_ctx.tokens[(int64<overflow='wrap'>(reader_ctx.at) + 1)].start))
        first_range = first
        reader_ctx.at = (int64<overflow='wrap'>(reader_ctx.at) + 3)
    }
    let second:int64=0
    if ((first_range =? 0) and (rd_dn_peek(@reader_ctx) not=? 'range')) {
        # (`xs[a,b..c]`: a stepped slice's two starts, dw_iterable's comma)
        let saved_comma:bool=reader_ctx.flags.comma_stop
        reader_ctx.flags.comma_stop = true
        reader_ctx.reader.dc_range_top = true
        reader_ctx.reader.dc_range_call = 0
        let saved_axis:int64=reader_ctx.reader.dc_axis_depth
        reader_ctx.reader.dc_axis_depth = (int64<overflow='wrap'>(reader_ctx.depth) + 1)
        let open_before:int64=reader_ctx.reader.dc_open_axes
        first = rd_dc_expr(@reader_ctx @reader_nodes 0)
        reader_ctx.reader.dc_axis_depth = saved_axis
        reader_ctx.reader.dc_range_top = false
        if (((first not=? 0) and (reader_ctx.reader.dc_open_axes not=? open_before)) and (reader_ctx.reader.dc_range_call not=? first)) {
            first = 0
        }
        if ((first not=? 0) and (reader_ctx.reader.dc_range_call =? first)) {
            first_range = reader_ctx.reader.dc_range_node
        }
        if (((first not=? 0) and (first_range =? 0)) and rd_dn_accept(@reader_ctx 'comma')) {
            reader_ctx.reader.dc_range_top = true
            second = rd_dc_expr(@reader_ctx @reader_nodes 0)
            reader_ctx.reader.dc_range_top = false
            # (`xs[0,1,2..]`: dw_iterable's mistake, should nothing else read it)
            if ((second not=? 0) and (rd_dn_peek(@reader_ctx) =? 'comma')) {
                rd_dc_hint(@reader_ctx first_pos "Dewy does not yet support a stepped range without exactly two starting values");
            }
            if ((second =? 0) or (rd_dn_peek(@reader_ctx) not=? 'range')) {
                first = 0
            }
        }
        reader_ctx.flags.comma_stop = saved_comma
        if (first =? 0) {
            return false
        }
    }
    if (rd_dn_peek(@reader_ctx) =? 'range') {
        reader_ctx.at = (int64<overflow='wrap'>(reader_ctx.at) + 1)
        # (`xs[..]`: the whole array)
        if ((first =? 0) and (rd_dn_peek(@reader_ctx) =? 'rbrack')) {
            let range:int64=node_mk(@reader_nodes 'range' rd_mkpos(reader_ctx.file reader_ctx.tokens[(int64<overflow='wrap'>(reader_ctx.at) - 1)].start))
            reader_ctx.at = (int64<overflow='wrap'>(reader_ctx.at) + 1)
            node_set_list(@reader_nodes @reader_ctx.stores.lists[0] n [range]);
            reader_nodes[n].b = int32<overflow='wrap'>(range)
            return true
        }
        if ((first =? 0) and (not dn_range_bound(@reader_ctx.tokens reader_ctx.at))) {
            return rd_dc_no_operand(@reader_ctx)
        }
        let last:int64=0
        if dn_range_bound(@reader_ctx.tokens reader_ctx.at) {
            last = rd_dc_expr(@reader_ctx @reader_nodes 101)
            if (last =? 0) {
                return false
            }
        }
        let inclusive:bool=rd_dn_accept(@reader_ctx 'rbrack')
        if ((not inclusive) and (not rd_dn_accept(@reader_ctx 'rparen'))) {
            return false
        }
        let range:int64=node_mk(@reader_nodes 'range' first_pos)
        reader_nodes[range].a = int32<overflow='wrap'>(first)
        reader_nodes[range].b = int32<overflow='wrap'>(last)
        if (second not=? 0) {
            reader_nodes[range].c = int32<overflow='wrap'>(second)
            rd_add_flag(@reader_nodes range NF_STEP);
        }
        if inclusive {
            rd_add_flag(@reader_nodes range NF_INCLUSIVE);
        }
        node_set_list(@reader_nodes @reader_ctx.stores.lists[0] n [range]);
        reader_nodes[n].b = int32<overflow='wrap'>(range)
        return true
    }
    if (not rd_dc_axes(@reader_ctx @reader_nodes n first first_range)) {
        return false
    }
    if (rd_nkids(@reader_nodes n) =? 1) {
        reader_nodes[n].b = int32<overflow='wrap'>(rd_kid(@reader_ctx @reader_nodes n 0))
    }
    true
}

# `xs[end]` in the index being read: its last, per axis (dw_expr's `$index_end`).
rd_dc_index_end=(@reader_ctx:ParserContext @reader_nodes:array<Node> pos:int64):>int64=>$unsafe {
    let base:string="$index_end{reader_ctx.reader.dc_index_node}"
    reader_nodes[reader_ctx.reader.dc_index_node].sval = int32<overflow='wrap'>(reader_ctx.stores.host[0].intern(base))
    let axis:int64=int64<overflow='wrap'>(reader_nodes[reader_ctx.reader.dc_index_node].aux2)
    let spelled:string=(if (axis =? 0) base else "{base}_{axis}")
    rd_comp_ident(@reader_nodes reader_ctx.stores.host[0].intern(spelled) pos)
}

# `xs[$wrap 1..2)`, `xs[$clamp 1]` at the tag (dw_clamp_slice's mistakes, noted; the entries
# passed over through the index's closer).
rd_dc_index_tag_mistake=(@reader_ctx:ParserContext tag:DewyLexeme clamp:bool):>bool=>$unsafe {
    if ((not reader_ctx.flags.report_now) or (reader_ctx.tokens[reader_ctx.at].kind not=? 'metatag')) {
        return false
    }
    if clamp {
        rd_dc_report(@reader_ctx rd_mkpos(reader_ctx.file tag.start) "`$clamp` truncates one range: `xs[$clamp a..b)`");
    }
    else {
        rd_dc_report(@reader_ctx rd_mkpos(reader_ctx.file tag.start) "`${rd_dn_payload(@reader_ctx tag)}` is not an index setting: `$clamp` truncates a slice to the receiver, as in `xs[$clamp a..b)`");
    }
    let depth:int64=0
    reader_ctx.at = (int64<overflow='wrap'>(reader_ctx.at) + 1)
    loop (reader_ctx.tokens[reader_ctx.at].kind not=? 'eof') {
        let t:DewyToken=reader_ctx.tokens[reader_ctx.at].symbol
        reader_ctx.at = (int64<overflow='wrap'>(reader_ctx.at) + 1)
        if (((t =? 'lparen') or (t =? 'lbrack')) or (t =? 'lbrace')) {
            depth = (int64<overflow='wrap'>(depth) + 1)
        }
        else if (((t =? 'rparen') or (t =? 'rbrack')) or (t =? 'rbrace')) {
            if (depth =? 0) {
                return true
            }
            depth = (int64<overflow='wrap'>(depth) - 1)
        }
    }
    false
}

# `nonzero = int64 & ~0` at the top of a module names a refined type (dw_top_declarations), which
# is left unread (dc_unread).
rd_dc_inferred_refinement=(@reader_ctx:ParserContext @reader_nodes:array<Node> n:int64):>bool=>$unsafe {
    (((reader_ctx.reader.dc_top_level and (reader_nodes[n].kind =? 'binary')) and (reader_nodes[n].op =? int32<overflow='wrap'>(int64<overflow='wrap'>(int64(63))))) and (reader_nodes[int64<overflow='wrap'>(reader_nodes[n].b)].kind =? 'not_'))
}

rd_dc_inline_default=(@reader_ctx:ParserContext @reader_nodes:array<Node> field:DewyLexeme):>int64=>$unsafe {
    rd_dc_unsupported(@reader_ctx rd_mkpos(reader_ctx.file field.start) "an inline record field without a type; use a named record for defaults");
    reader_ctx.at = (int64<overflow='wrap'>(reader_ctx.at) + 1)
    rd_dc_expr(@reader_ctx @reader_nodes 11)
}

# The tokens of an integer literal at `at`, `5` (1) or `-1` (2), as a type's singleton is written
# (dw_int_leaf); 0 for anything else.
rd_dc_int_leaf=(@reader_ctx:ParserContext at:int64):>int64=>$unsafe {
    let t:DewyLexeme=reader_ctx.tokens[at]
    if ((t.kind =? 'source_integer') or (t.kind =? 'integer')) {
        return 1
    }
    if (t.symbol not=? 'minus') {
        return 0
    }
    let next:DewyLexeme=reader_ctx.tokens[(int64<overflow='wrap'>(at) + 1)]
    if ((next.kind =? 'source_integer') or (next.kind =? 'integer')) {
        return 2
    }
    0
}

rd_dc_integer_name=(@reader_ctx:ParserContext id:int64):>bool=>$unsafe {
    (rd_name_of(@reader_ctx id) in? ["int8" "int16" "int32" "int64" "uint8" "uint16" "uint32" "uint64"])
}

# The operands of an intersection after its declaration's `=`: names, and one row list whose
# fields and methods the record adds (dw_intersection, dw_type_methods). 0 for other forms.
rd_dc_intersection=(@reader_ctx:ParserContext @reader_nodes:array<Node> token:DewyLexeme pos:int64):>int64=>$unsafe {
    let n:int64=node_mk(@reader_nodes 'struct_' pos)
    reader_nodes[n].name = token.name
    node_set_list(@reader_nodes @reader_ctx.stores.lists[0] n []);
    let components:array<int64>=[]
    let names:array<int64>=[]
    let rows:bool=false
    loop true {
        if (rd_dn_peek(@reader_ctx) =? 'lbrack') {
            if rows {
                return 0
            }
            rows = true
            reader_ctx.at = (int64<overflow='wrap'>(reader_ctx.at) + 1)
            if ((not rd_dc_record_fields(@reader_ctx @reader_nodes n @names)) or (reader_ctx.reader.dc_transfer_bits not=? 0)) {
                return 0
            }
            loop hook in reader_ctx.reader.dc_method_hooks {
                if (hook not=? 0) {
                    return 0
                }
            }
        }
        else {
            let leaf:DewyLexeme=reader_ctx.tokens[reader_ctx.at]
            # (`$abstract type of any & [...]`: dw_type's mistake)
            if ((leaf.kind =? 'metatag') and reader_ctx.flags.report_now) {
                return rd_dc_fail_now(@reader_ctx rd_mkpos(reader_ctx.file leaf.start) reader_ctx.stores.host[0].metatag_fail_text(rd_dn_payload(@reader_ctx leaf)))
            }
            if ((leaf.kind not=? 'identifier') or (leaf.symbol not=? 'none')) {
                return 0
            }
            let t:int64=rd_dc_type_named(@reader_ctx @reader_nodes)
            if (t =? 0) {
                return 0
            }
            components.push(t);
        }
        if (not rd_dn_accept(@reader_ctx 'amp')) {
            break
        }
    }
    if ((dn_power(rd_dn_peek(@reader_ctx)) >? 0) or ((not rd_dc_statement_ends(@reader_ctx)) and (rd_dn_peek(@reader_ctx) not=? 'semi'))) {
        return 0
    }
    rd_dn_accept_semi(@reader_ctx);
    if (not rd_dc_record_members(@reader_ctx @reader_nodes n names)) {
        return 0
    }
    reader_ctx.stores.host[0].g_struct_components_item_set(n components)
    n
}

# An `&` joins the declared type's operands at the top (not `int64 & ~0`, a refinement).
rd_dc_intersection_next=(@reader_ctx:ParserContext):>bool=>$unsafe {
    let depth:int64=0
    let k:int64=reader_ctx.at
    let found:bool=false
    loop (k <? reader_ctx.tokens.length) {
        let t:DewyLexeme=reader_ctx.tokens[k]
        if ((t.kind =? 'eof') or (((k >? reader_ctx.at) and (depth =? 0)) and t.newline)) {
            break
        }
        let symbol:DewyToken=t.symbol
        if ((((symbol =? 'lparen') or (symbol =? 'lbrack')) or (symbol =? 'lbrace')) or (symbol =? 'langle')) {
            depth = (int64<overflow='wrap'>(depth) + 1)
        }
        else if ((((symbol =? 'rparen') or (symbol =? 'rbrack')) or (symbol =? 'rbrace')) or (symbol =? 'rangle')) {
            depth = (int64<overflow='wrap'>(depth) - 1)
        }
        else if ((depth =? 0) and (symbol =? 'amp')) {
            if (reader_ctx.tokens[(int64<overflow='wrap'>(k) + 1)].symbol =? 'tilde') {
                return false
            }
            found = true
        }
        k = (int64<overflow='wrap'>(k) + 1)
    }
    found
}

rd_dc_intrinsic_next=(@reader_ctx:ParserContext):>bool=>$unsafe {
    (rd_dn_payload(@reader_ctx reader_ctx.tokens[reader_ctx.at]) =? "intrinsic")
}

# What a loop iterates, after `in` (dw_iterable): a range, bracketed (`[a..b]`, `[a..b)`, `(a..b]`,
# `(a..b)`) or not (`a..b`, `a..`, inclusive), stepped by a second start (`[a,b..c)`), or a value
# (its iteration, `__dewy_iter`). A live place (`in @xs`) is left unread (dc_unread).
rd_dc_iterable=(@reader_ctx:ParserContext @reader_nodes:array<Node>):>int64=>$unsafe {
    let opening:int64=reader_ctx.at
    if (reader_ctx.tokens[reader_ctx.at].symbol =? 'at') {
        return 0
    }
    if ((reader_ctx.tokens[reader_ctx.at].symbol =? 'lbrack') or (reader_ctx.tokens[reader_ctx.at].symbol =? 'lparen')) {
        let start:int64=reader_ctx.at
        let node_start:int64=reader_nodes.length
        let list_start:int64=reader_ctx.stores.lists[0].length
        let edits:int64=reader_ctx.reader.dn_edit_at.length
        reader_ctx.at = (int64<overflow='wrap'>(reader_ctx.at) + 1)
        let range:int64=rd_dc_range(@reader_ctx @reader_nodes true)
        if ((range not=? 0) or (reader_ctx.at <? 0)) {
            return range
        }
        # (not a range: the brackets hold a value, `[1 2 3]`, `(xs)`)
        reader_ctx.at = start
        reader_nodes.truncate(node_start);
        reader_ctx.stores.lists[0].truncate(list_start);
        rd_dn_edits_undo(@reader_ctx edits);
    }
    let range:int64=rd_dc_range(@reader_ctx @reader_nodes false)
    if (reader_ctx.at <? 0) {
        return 0
    }
    if (range not=? 0) {
        return range
    }
    reader_ctx.at = reader_ctx.reader.dc_range_at
    let first:int64=reader_ctx.reader.dc_range_first
    if (((rd_dn_peek(@reader_ctx) not=? 'lbrace') and (dn_power(rd_dn_peek(@reader_ctx)) >=? 96)) and (not rd_dc_signed_next(@reader_ctx))) {
        return 0
    }
    let callee:int64=node_mk(@reader_nodes 'ident' rd_mkpos(reader_ctx.file reader_ctx.tokens[opening].start))
    reader_nodes[callee].name = int32<overflow='wrap'>(rd_dc_builtin(@reader_ctx 4))
    let n:int64=node_mk(@reader_nodes 'call' rd_mkpos(reader_ctx.file reader_ctx.tokens[opening].start))
    reader_nodes[n].a = int32<overflow='wrap'>(callee)
    node_set_list(@reader_nodes @reader_ctx.stores.lists[0] n [first]);
    n
}

# `f(2)g(3)`: dn_expr's mistake, at once.
rd_dc_juxt_mistake=(@reader_ctx:ParserContext):>int64=>$unsafe {
    if reader_ctx.flags.report_now {
        reader_ctx.stores.host[0].dn_error(reader_ctx.tokens[reader_ctx.at].start dn_juxt_excluded_message(@reader_ctx.tokens reader_ctx.at));
    }
    0
}

# `(from:int64)`: the parse mistake, a keyword as a name.
rd_dc_keyword_name=(@reader_ctx:ParserContext token:DewyLexeme):>int64=>$unsafe {
    reader_ctx.stores.host[0].dn_error(token.start rd_dc_keyword_text(token.symbol))
}

rd_dc_keyword_text=(word:DewyToken):>string=>$unsafe {
    "`{dn_token_text(word)}` is a keyword, so it cannot name a variable, parameter or field: choose another name"
}

rd_dc_kind_of=(@reader_ctx:ParserContext @reader_nodes:array<Node> statement:int64):>int64=>$unsafe {
    dr_kind_of(@reader_ctx.collection @reader_nodes @reader_ctx.stores.lists[0] statement)
}

rd_dc_lambda_extern=(@reader_ctx:ParserContext):>bool=>$unsafe {
    (rd_dn_payload(@reader_ctx reader_ctx.tokens[reader_ctx.at]) =? "extern")
}

# A lambda opens here: a name then `=>`, or a parenthesized list then `=>` or `:>`.
rd_dc_lambda_next=(@reader_ctx:ParserContext):>bool=>$unsafe {
    rd_dc_lambda_next_at(@reader_ctx reader_ctx.at)
}

rd_dc_lambda_next_at=(@reader_ctx:ParserContext start:int64):>bool=>$unsafe {
    let dn_at_saved:int64=reader_ctx.at
    reader_ctx.at = start
    let yes:bool=rd_dc_lambda_opens(@reader_ctx)
    reader_ctx.at = dn_at_saved
    yes
}

rd_dc_lambda_opens=(@reader_ctx:ParserContext):>bool=>$unsafe {
    if (reader_ctx.tokens[reader_ctx.at].kind =? 'identifier') {
        return (((reader_ctx.tokens[reader_ctx.at].symbol =? 'none') or (reader_ctx.tokens[reader_ctx.at].symbol =? 'kw_test')) and (reader_ctx.tokens[(int64<overflow='wrap'>(reader_ctx.at) + 1)].symbol =? 'function'))
    }
    if (reader_ctx.tokens[reader_ctx.at].symbol not=? 'lparen') {
        return false
    }
    let next:DewyToken=reader_ctx.tokens[(int64<overflow='wrap'>(reader_ctx.at) + 1)].symbol
    if (not ((((((((next =? 'rparen') or (next =? 'at')) or (((next =? 'langle') and (reader_ctx.tokens[(int64<overflow='wrap'>(reader_ctx.at) + 2)].kind =? 'identifier')) and (reader_ctx.tokens[(int64<overflow='wrap'>(reader_ctx.at) + 3)].symbol =? 'colon'))) or (next =? 'lbrack')) or (next =? 'lparen')) or (next =? 'ellipsis')) or (reader_ctx.tokens[(int64<overflow='wrap'>(reader_ctx.at) + 1)].kind =? 'metatag')) or ((reader_ctx.tokens[(int64<overflow='wrap'>(reader_ctx.at) + 1)].kind =? 'identifier') and ((((reader_ctx.tokens[(int64<overflow='wrap'>(reader_ctx.at) + 2)].symbol =? 'colon') or (reader_ctx.tokens[(int64<overflow='wrap'>(reader_ctx.at) + 2)].symbol =? 'rparen')) or (reader_ctx.tokens[(int64<overflow='wrap'>(reader_ctx.at) + 2)].kind =? 'identifier')) or (reader_ctx.tokens[(int64<overflow='wrap'>(reader_ctx.at) + 2)].symbol =? 'assign'))))) {
        return false
    }
    let depth:int64=0
    let at:int64=reader_ctx.at
    loop (at <? reader_ctx.tokens.length) {
        let symbol:DewyToken=reader_ctx.tokens[at].symbol
        if (reader_ctx.tokens[at].kind =? 'eof') {
            return false
        }
        if (symbol =? 'lparen') {
            depth = (int64<overflow='wrap'>(depth) + 1)
        }
        if (symbol =? 'rparen') {
            depth = (int64<overflow='wrap'>(depth) - 1)
            if (depth =? 0) {
                break
            }
        }
        at = (int64<overflow='wrap'>(at) + 1)
    }
    let after:DewyToken=reader_ctx.tokens[(int64<overflow='wrap'>(at) + 1)].symbol
    ((after =? 'function') or (after =? 'returns'))
}

rd_dc_last_kind=(@reader_ctx:ParserContext @reader_nodes:array<Node> block:int64):>int64=>$unsafe {
    dr_last_kind(@reader_ctx.collection @reader_nodes @reader_ctx.stores.lists[0] block)
}

rd_dc_lazy_body=(@reader_ctx:ParserContext @reader_nodes:array<Node>):>int64=>$unsafe {
    if (reader_ctx.tokens[reader_ctx.at].kind =? 'lazy_body') {
        let t:DewyLexeme=reader_ctx.tokens[reader_ctx.at]
        let b:int64=node_mk(@reader_nodes 'block' rd_mkpos(reader_ctx.file t.start))
        reader_nodes[b].aux2 = DC_LAZY_SPAN
        reader_nodes[b].ival = t.start
        reader_ctx.reader.dc_lazy_span_end[b] = t.stop
        reader_ctx.at = (int64<overflow='wrap'>(reader_ctx.at) + 1)
        return b
    }
    if ((not (reader_ctx.reader.dc_lazy_on or reader_ctx.reader.dc_lib_lazy)) or (reader_ctx.tokens[reader_ctx.at].symbol not=? 'lbrace')) {
        return 0
    }
    let start:int64=reader_ctx.at
    let at:int64=(int64<overflow='wrap'>(start) + 1)
    let depth:int64=1
    loop (at <? reader_ctx.tokens.length) {
        let t:DewyLexeme=reader_ctx.tokens[at]
        if (t.symbol =? 'lbrace') {
            depth = (int64<overflow='wrap'>(depth) + 1)
        }
        if (t.symbol =? 'rbrace') {
            depth = (int64<overflow='wrap'>(depth) - 1)
        }
        if (depth =? 0) {
            let b:int64=node_mk(@reader_nodes 'block' rd_mkpos(reader_ctx.file reader_ctx.tokens[start].start))
            reader_nodes[b].aux2 = DC_LAZY_BODY
            reader_nodes[b].ival = start
            reader_ctx.at = (int64<overflow='wrap'>(at) + 1)
            if reader_ctx.reader.dc_lazy_on {
                reader_ctx.stores.host[0].g_dc_lazy_used_set(true)
            }
            return b
        }
        # These can declare names/imports or affect whole-program analysis at
        # parse time. Large/base literals may synthesize a bigint import.
        if (((((((t.kind =? 'metatag') or (t.kind =? 'integer')) or (t.kind =? 'based_string')) or (t.symbol =? 'function')) or (t.symbol =? 'kw_import')) or (t.symbol =? 'kw_from')) or (t.symbol =? 'coalesce')) {
            return 0
        }
        if ((t.kind =? 'source_integer') and ((int64<overflow='wrap'>(t.stop) - int64<overflow='wrap'>(t.start)) >? 18)) {
            return 0
        }
        # Interpolations can hide declarations, bigint imports or parse warnings.
        if (t.kind =? 'quoted') {
            let source:string=reader_ctx.source
            loop i in [t.start..t.stop) {
                if ((source as array<uint8>)[i] =? b'\{') {
                    return 0
                }
            }
        }
        at = (int64<overflow='wrap'>(at) + 1)
    }
    0
}

# `$lend(@owner reserve=n) body` after its tag (dn_directive's form 4, dw_directive): the call
# lending the owner's bytes to the body.
rd_dc_lend=(@reader_ctx:ParserContext @reader_nodes:array<Node> token:DewyLexeme):>int64=>$unsafe {
    let pos:int64=rd_mkpos(reader_ctx.file token.start)
    if (not rd_dn_accept(@reader_ctx 'lparen')) {
        return 0
    }
    let owner:int64=rd_dc_expr(@reader_ctx @reader_nodes 0)
    if (owner =? 0) {
        return 0
    }
    let reservation:int64=0
    if (((reader_ctx.tokens[reader_ctx.at].kind =? 'identifier') and (rd_dn_payload(@reader_ctx reader_ctx.tokens[reader_ctx.at]) =? "reserve")) and (reader_ctx.tokens[(int64<overflow='wrap'>(reader_ctx.at) + 1)].symbol =? 'assign')) {
        reader_ctx.at = (int64<overflow='wrap'>(reader_ctx.at) + 2)
        reservation = rd_dc_expr(@reader_ctx @reader_nodes 0)
        if (reservation =? 0) {
            return 0
        }
    }
    if (not rd_dn_accept(@reader_ctx 'rparen')) {
        return 0
    }
    let body:int64=rd_dc_expr(@reader_ctx @reader_nodes 0)
    if (body =? 0) {
        return 0
    }
    if (reservation =? 0) {
        reservation = rd_bc_int(@reader_nodes 0 pos)
    }
    rd_bc_call(@reader_ctx @reader_nodes "$lend" [owner reservation body] pos)
}

rd_dc_lifecycle_tag=(@reader_ctx:ParserContext token:DewyLexeme):>int64=>$unsafe {
    let name:string=rd_dn_payload(@reader_ctx token)
    if (name =? "__drop__") {
        return 1
    }
    if (name =? "__copy__") {
        return 2
    }
    if (name =? "__move__") {
        return 3
    }
    0
}

# `x ??<A | B> fallback` at `??`: the fallback only for the kinds listed, one type (c).
rd_dc_listed_coalesce=(@reader_ctx:ParserContext @reader_nodes:array<Node> left:int64 power:int64 pos:int64):>int64=>$unsafe {
    reader_ctx.at = (int64<overflow='wrap'>(reader_ctx.at) + 1)
    reader_ctx.tokens[reader_ctx.at].symbol = 'langle'
    reader_ctx.at = (int64<overflow='wrap'>(reader_ctx.at) + 1)
    reader_ctx.reader.dc_type_args = (int64<overflow='wrap'>(reader_ctx.reader.dc_type_args) + 1)
    let kinds:int64=rd_dc_annotation(@reader_ctx @reader_nodes)
    reader_ctx.reader.dc_type_args = (int64<overflow='wrap'>(reader_ctx.reader.dc_type_args) - 1)
    if (kinds =? 0) {
        return 0
    }
    if (not rd_dn_accept(@reader_ctx 'rangle')) {
        # (`??<A B>`: dw_expr's mistake, should nothing else read it)
        if (not (reader_ctx.reader.dn_edits_on and rd_dn_closer_joined(@reader_ctx))) {
            return rd_dc_hint(@reader_ctx pos "`??<...>` lists the kinds it covers as one type: `??<Missing | ParseError>`")
        }
        rd_dn_split_closer(@reader_ctx);
    }
    let right:int64=rd_dc_expr(@reader_ctx @reader_nodes power)
    if (right =? 0) {
        return 0
    }
    let n:int64=node_mk(@reader_nodes 'coalesce' pos)
    reader_nodes[n].a = int32<overflow='wrap'>(left)
    reader_nodes[n].b = int32<overflow='wrap'>(right)
    reader_nodes[n].c = int32<overflow='wrap'>(kinds)
    n
}

# A record literal's function rows, among its entries: each that reaches a row by name is a
# method, taking the object first (dw_literal_method); the rows registered (dw_register_literal_methods).
# False for a function the reach does not follow.
rd_dc_literal_methods=(@reader_ctx:ParserContext @reader_nodes:array<Node> entries:array<int64>):>bool=>$unsafe {
    let members:array<int64>=[]
    let any:bool=false
    loop entry in entries {
        if (reader_nodes[entry].kind not=? 'namedarg') {
            continue
        }
        if (reader_nodes[entry].name not=? 0) {
            members.push(int64<overflow='wrap'>(reader_nodes[entry].name));
        }
        if (reader_nodes[int64<overflow='wrap'>(reader_nodes[entry].a)].kind =? 'lambda') {
            any = true
        }
    }
    if (not any) {
        return true
    }
    loop entry in entries {
        if ((reader_nodes[entry].kind not=? 'namedarg') or (reader_nodes[int64<overflow='wrap'>(reader_nodes[entry].a)].kind not=? 'lambda')) {
            continue
        }
        let fn_:int64=int64<overflow='wrap'>(reader_nodes[entry].a)
        let receiver:int64=reader_ctx.stores.host[0].intern("$self{reader_nodes.length}")
        reader_ctx.reach.used.remove(receiver);
        let saved:dict<int64 int64>=reader_ctx.reach.scope
        let inner:dict<int64 int64>=[]
        loop [name other] in saved {
            inner[name] = other
        }
        loop name in members {
            inner[name] = receiver
        }
        reader_ctx.reach.scope = inner
        let reached:bool=rd_dc_reach_fn(@reader_ctx @reader_nodes fn_)
        reader_ctx.reach.scope = saved
        if (not reached) {
            return false
        }
        if (not reader_ctx.reach.used.has(receiver)) {
            continue
        }
        let pos:int64=reader_nodes[fn_].pos
        let object_type:int64=node_mk(@reader_nodes 'ident' pos)
        reader_nodes[object_type].name = int32<overflow='wrap'>(reader_ctx.stores.host[0].intern("$Object{receiver}"))
        if rd_has_flag(@reader_nodes fn_ NF_GENERIC) {
            node_set_list2(@reader_nodes @reader_ctx.stores.lists[0] fn_ [([object_type])... (node_kids2(@reader_nodes @reader_ctx.stores.lists[0] fn_))...]);
        }
        else {
            let captures:array<int64>=node_kids2(@reader_nodes @reader_ctx.stores.lists[0] fn_)
            if (captures.length >? 0) {
                let listed:int64=node_mk(@reader_nodes 'block' pos)
                node_set_list(@reader_nodes @reader_ctx.stores.lists[0] listed captures);
                reader_nodes[fn_].d = int32<overflow='wrap'>(listed)
            }
            node_set_list2(@reader_nodes @reader_ctx.stores.lists[0] fn_ [object_type]);
            rd_add_flag(@reader_nodes fn_ NF_GENERIC);
        }
        let receiver_type:int64=node_mk(@reader_nodes 'tname' pos)
        reader_nodes[receiver_type].name = reader_nodes[object_type].name
        reader_ctx.stores.host[0].dw_add_receiver(fn_ receiver receiver_type)
    }
    reader_ctx.reader.dn_edit_at.push((int64<overflow='wrap'>(DN_EDIT_METHODS) - int64<overflow='wrap'>(reader_ctx.stores.host[0].g_dewy_methods_len())));
    reader_ctx.reader.dn_edit_was.push(reader_ctx.tokens[(int64<overflow='wrap'>(reader_ctx.at) - 1)]);
    reader_ctx.stores.host[0].dw_register_literal_methods(entries);
    true
}

rd_dc_literal_node=(@reader_ctx:ParserContext @reader_nodes:array<Node> n:int64):>bool=>$unsafe {
    let k:NK=reader_nodes[n].kind
    if ((((k =? 'int_lit') or (k =? 'float_lit')) or (k =? 'bool_lit')) or (k =? 'none_lit')) {
        return true
    }
    if (k =? 'str_lit') {
        return (reader_nodes[n].aux =? 0)
    }
    if (k =? 'call') {
        return (reader_nodes[n].aux2 =? (-1))
    }
    if (k not=? 'array') {
        return false
    }
    loop item in node_kids(@reader_nodes @reader_ctx.stores.lists[0] n) {
        if (rd_has_flag(@reader_nodes item NF_SPREAD) or (not rd_dc_literal_node(@reader_ctx @reader_nodes item))) {
            return false
        }
    }
    true
}

# A literal operand (dw_literal_operand): its value is what is written.
rd_dc_literal_operand=(@reader_ctx:ParserContext @reader_nodes:array<Node> n:int64 start:int64):>bool=>$unsafe {
    if (reader_ctx.tokens[start].symbol =? 'lparen') {
        return false
    }
    rd_dc_literal_node(@reader_ctx @reader_nodes n)
}

# A union with a literal member, from the members read so far (union, its leaves): the integers
# one refined int64, the strings one string set, then the other members in order (dw_literal_type,
# dw_pipe_leaves).
rd_dc_literal_union=(@reader_ctx:ParserContext @reader_nodes:array<Node> union:int64 boundary:int64 pos:int64):>int64=>$unsafe {
    let texts:array<string>=[]
    let ints:array<int64>=[]
    let others:array<int64>=[]
    if (union not=? 0) {
        rd_dc_union_leaves(@reader_ctx @reader_nodes union @others);
    }
    if (union not=? 0) {
        reader_ctx.at = (int64<overflow='wrap'>(reader_ctx.at) + 1)
    }
    loop true {
        if (rd_dc_type_member(@reader_ctx @reader_nodes @texts @ints @others) <? 0) {
            return 0
        }
        if (not ((rd_dn_peek(@reader_ctx) =? 'pipe') and (dn_power('pipe') >? boundary))) {
            break
        }
        reader_ctx.at = (int64<overflow='wrap'>(reader_ctx.at) + 1)
    }
    let parts:array<int64>=[]
    if (ints.length >? 0) {
        let lo:int64=ints[0]
        let hi:int64=ints[0]
        loop v in ints {
            lo = min(lo v)
            hi = max(hi v)
        }
        # (too many gaps: dw_int_singleton_type's mistake, should nothing else read it)
        if (((int64<overflow='wrap'>((int64<overflow='wrap'>((int64<overflow='wrap'>(hi) - int64<overflow='wrap'>(lo))) - int64<overflow='wrap'>(ints.length))) + 1) >? 24) or ((int64<overflow='wrap'>(hi) - int64<overflow='wrap'>(lo)) <? 0)) {
            return rd_dc_hint(@reader_ctx pos "an integer singleton union with more than 24 missing values between its least and greatest members")
        }
        parts.push(reader_ctx.stores.host[0].dw_int_singleton_type(ints pos));
    }
    if (texts.length >? 0) {
        let strings:int64=node_mk(@reader_nodes 'tname' pos)
        reader_nodes[strings].aux = (-7)
        reader_nodes[strings].ival = reader_ctx.stores.host[0].str_set_type(texts)
        parts.push(strings);
    }
    loop other in others {
        parts.push(other);
    }
    let n:int64=parts[0]
    loop k in [1..parts.length) {
        let joined:int64=node_mk(@reader_nodes 'tunion' pos)
        node_set_list(@reader_nodes @reader_ctx.stores.lists[0] joined [n parts[k]]);
        n = joined
    }
    reader_ctx.reader.dc_literal_seen = true
    n
}

# `((a:T) => a) & (...)` as a local declaration's value (dc_initial_at: where it starts), at the
# `&`: dw_declare's mistake, noted (read as the binary).
rd_dc_local_group=(@reader_ctx:ParserContext first_at:int64 minimum:int64):>bool=>$unsafe {
    if ((((first_at not=? reader_ctx.reader.dc_initial_at) or (minimum not=? 11)) or (not reader_ctx.flags.fn_body)) or (not reader_ctx.flags.report_now)) {
        return false
    }
    rd_dc_unsupported(@reader_ctx rd_mkpos(reader_ctx.file reader_ctx.tokens[first_at].start) "a local overload group; declare it at module level");
    true
}

# 'width' as a field and a method (dw_type_methods' mistake, at once: the declaration is read), at
# the method's name, two tokens before its `(`.
# A local type's rows: a method is dw_declare's mistake, noted at its name.
rd_dc_local_members=(@reader_ctx:ParserContext @reader_nodes:array<Node>):>bool=>$unsafe {
    let methods:array<int64>=reader_ctx.reader.dc_methods
    reader_ctx.reader.dc_methods = []
    reader_ctx.reader.dc_method_hooks = []
    if (methods.length =? 0) {
        return true
    }
    if (not reader_ctx.flags.report_now) {
        return false
    }
    rd_dc_unsupported(@reader_ctx rd_dc_method_name_at(@reader_ctx @reader_nodes methods[0]) "methods on a local type; declare the type at module level");
    true
}

rd_dc_local_type=(@reader_ctx:ParserContext @reader_nodes:array<Node>):>int64=>$unsafe {
    let after:DewyLexeme=reader_ctx.tokens[(int64<overflow='wrap'>(reader_ctx.at) + 5)]
    if (((after.kind =? 'identifier') and (after.name =? int32<overflow='wrap'>(reader_ctx.reader.dn_type_id))) and (reader_ctx.tokens[(int64<overflow='wrap'>(reader_ctx.at) + 6)].symbol =? 'kw_of')) {
        return 0
    }
    let start:int64=reader_ctx.at
    reader_ctx.at = (int64<overflow='wrap'>(reader_ctx.at) + 5)
    if rd_dc_intersection_next(@reader_ctx) {
        return 0
    }
    reader_ctx.at = start
    let saved:bool=reader_ctx.reader.dc_local_type_on
    reader_ctx.reader.dc_local_type_on = true
    let n:int64=rd_dc_type_declaration(@reader_ctx @reader_nodes)
    reader_ctx.reader.dc_local_type_on = saved
    n
}

# `let Name:type = ` in a body.
rd_dc_local_type_next=(@reader_ctx:ParserContext):>bool=>$unsafe {
    let token:DewyLexeme=reader_ctx.tokens[(int64<overflow='wrap'>(reader_ctx.at) + 1)]
    let annotation:DewyLexeme=reader_ctx.tokens[(int64<overflow='wrap'>(reader_ctx.at) + 3)]
    (((((token.kind =? 'identifier') and (reader_ctx.tokens[(int64<overflow='wrap'>(reader_ctx.at) + 2)].symbol =? 'colon')) and (annotation.kind =? 'identifier')) and (annotation.name =? int32<overflow='wrap'>(reader_ctx.reader.dn_type_id))) and (reader_ctx.tokens[(int64<overflow='wrap'>(reader_ctx.at) + 4)].symbol =? 'assign'))
}

# One token, a number, a string or a name, ending its statement.
rd_dc_lone_value=(@reader_ctx:ParserContext at:int64):>bool=>$unsafe {
    let t:DewyLexeme=reader_ctx.tokens[at]
    if (not (((t.kind =? 'source_integer') or (t.kind =? 'quoted')) or ((t.kind =? 'identifier') and (t.symbol =? 'none')))) {
        return false
    }
    let next:DewyLexeme=reader_ctx.tokens[(int64<overflow='wrap'>(at) + 1)]
    (((next.kind =? 'eof') or (next.symbol =? 'rbrace')) or (((next.newline and (dn_power(next.symbol) =? 0)) and (next.symbol not=? 'kw_not')) and (next.symbol not=? 'dot')))
}

# A real literal dc_short_real does not read exactly.
rd_dc_long_real=(@reader_ctx:ParserContext @reader_nodes:array<Node> token:DewyLexeme pos:int64):>int64=>$unsafe {
    let number:string=reader_ctx.stores.host[0].replace(rd_dn_payload(@reader_ctx token) "_" "")
    let value:float64?=reader_ctx.stores.host[0].to_float(number)
    # (beyond float64: the checker reports it)
    if (value is? none) {
        return 0
    }
    let n:int64=node_mk(@reader_nodes 'float_lit' pos)
    reader_nodes[n].fval = value
    reader_nodes[n].sval = int32<overflow='wrap'>(reader_ctx.stores.host[0].intern(number))
    rd_add_flag(@reader_nodes n NF_LITERAL);
    n
}

rd_dc_loop_body_warning=(@reader_ctx:ParserContext):>void=>$unsafe {
    reader_ctx.stores.host[0].warn(rd_mkpos(reader_ctx.file reader_ctx.tokens[reader_ctx.at].start) "this line is the body of the loop above, whose block is its condition: a loop is `loop condition body`, so a loop that runs until `break` or `return` is `loop true \{ ... }`; to keep this meaning, start the body on the condition's line");
}

# A loop's header, as dw_loop_head reads it: `binder in iterable` terms and conditions, joined by
# `and` and `or` (two joined conditions are one, head_collapse).
rd_dc_loop_head=(@reader_ctx:ParserContext @reader_nodes:array<Node>):>int64=>$unsafe {
    let head:int64=rd_dc_head_term(@reader_ctx @reader_nodes)
    if (head =? 0) {
        return 0
    }
    if (rd_dn_peek(@reader_ctx) =? 'lbrace') {
        return head
    }
    if ((rd_dn_peek(@reader_ctx) =? 'kw_and') or (rd_dn_peek(@reader_ctx) =? 'kw_or')) {
        head = rd_dc_head_and(@reader_ctx @reader_nodes head)
        loop (head not=? 0) and (rd_dn_peek(@reader_ctx) =? 'kw_or') {
            reader_ctx.at = (int64<overflow='wrap'>(reader_ctx.at) + 1)
            let term:int64=rd_dc_head_term(@reader_ctx @reader_nodes)
            head = rd_dc_head_join(@reader_ctx @reader_nodes 3 head rd_dc_head_and(@reader_ctx @reader_nodes term))
        }
    }
    if (head =? 0) {
        return 0
    }
    if (((dn_power(rd_dn_peek(@reader_ctx)) >? 0) and (not rd_dc_signed_next(@reader_ctx))) and (not rd_dc_head_mistake(@reader_ctx @reader_nodes head))) {
        return 0
    }
    head
}

# `x = loop c {...} else v`: a loop as a value (dw_expr's mistake, noted; the flow read).
rd_dc_loop_value=(@reader_ctx:ParserContext @reader_nodes:array<Node> pos:int64):>int64=>$unsafe {
    rd_dc_unsupported(@reader_ctx pos "a loop used as a value; use return or a comprehension");
    reader_ctx.at = (int64<overflow='wrap'>(reader_ctx.at) - 1)
    rd_dc_flow(@reader_ctx @reader_nodes)
}

# `$test`, `$proof`, `$export`, `$shadowable` or `$explicit_allocation_failure` alone at the top of
# a module, marking what follows: its metatag syntax, as dn_atom reads it (dewy_fast_file,
# dw_top_declarations). 0 for any other form.
rd_dc_marker=(@reader_ctx:ParserContext token:DewyLexeme):>int64=>$unsafe {
    let name:string=rd_dn_payload(@reader_ctx token)
    if (not (((((name =? "test") or (name =? "proof")) or (name =? "export")) or (name =? "shadowable")) or (name =? "explicit_allocation_failure"))) {
        return 0
    }
    let next:DewyLexeme=reader_ctx.tokens[(int64<overflow='wrap'>(reader_ctx.at) + 1)]
    if ((next.kind not=? 'eof') and (not ((next.newline and (dn_power(next.symbol) =? 0)) and (next.symbol not=? 'kw_not')))) {
        if (((((((not next.space) or (dn_power(next.symbol) >? 0)) or (next.symbol =? 'kw_not')) or (next.symbol =? 'semi')) or (next.symbol =? 'dot')) or (next.symbol =? 'question')) or (next.symbol =? 'ellipsis')) {
            return 0
        }
    }
    let start:int64=reader_ctx.at
    reader_ctx.stores.host[0].dn_expand_lazy();
    reader_ctx.at = (int64<overflow='wrap'>(reader_ctx.at) + 1)
    let id:int64=rd_dn_node(@reader_ctx token.kind name token.start name=token.name)
    id
}

# `match value { pattern => body ... }`, or one arm without braces, then an optional
# `else`, after its keyword: as dw_match and dw_flow make it. Patterns are a name, `_`,
# `name:T` or `<literal>`; shapes, sequences, byte and refined patterns
# too.
rd_dc_match=(@reader_ctx:ParserContext @reader_nodes:array<Node> token:DewyLexeme):>int64=>$unsafe {
    let pos:int64=rd_mkpos(reader_ctx.file token.start)
    let n:int64=node_mk(@reader_nodes 'match_' pos)
    let first:int64=reader_ctx.at
    let scrutinee:int64=rd_dc_expr(@reader_ctx @reader_nodes 0)
    if ((scrutinee =? 0) or (not dn_can_start(@reader_ctx.tokens reader_ctx.at))) {
        return 0
    }
    # (`match (x y)`: a sequence of values, each read once, dw_match)
    if ((((reader_nodes[scrutinee].kind =? 'tuple') and (reader_nodes[scrutinee].aux =? int32<overflow='wrap'>(TUPLE_VALUES))) and (reader_ctx.tokens[first].symbol =? 'lparen')) and (rd_dc_closing(@reader_ctx first) =? (int64<overflow='wrap'>(reader_ctx.at) - 1))) {
        loop item in node_kids(@reader_nodes @reader_ctx.stores.lists[0] scrutinee) {
            if rd_has_flag(@reader_nodes item NF_SPREAD) {
                return 0
            }
        }
        reader_nodes[scrutinee].aux = 0
    }
    reader_nodes[n].a = int32<overflow='wrap'>(scrutinee)
    let arms:array<int64>=[]
    let opening:DewyLexeme=reader_ctx.tokens[reader_ctx.at]
    if rd_dn_accept(@reader_ctx 'lbrace') {
        loop (not rd_dn_accept(@reader_ctx 'rbrace')) {
            if (reader_ctx.tokens[reader_ctx.at].kind =? 'eof') {
                return 0
            }
            let arm:int64=rd_dc_arm(@reader_ctx @reader_nodes)
            if (arm =? 0) {
                return 0
            }
            arms.push(arm);
        }
        # (`let n = match x {...}; n`: `;` ends the statement the match is the value of; `{...} + 1`
        # is no arm, dw_arm_fail's mistake should nothing else read it)
        if ((not rd_dc_flow_ends(@reader_ctx)) and (rd_dn_peek(@reader_ctx) not=? 'semi')) {
            return rd_dc_hint(@reader_ctx rd_mkpos(reader_ctx.file opening.start) "Dewy does not yet support a match arm without =>")
        }
    }
    else {
        let arm:int64=rd_dc_arm(@reader_ctx @reader_nodes)
        if (arm =? 0) {
            return 0
        }
        arms.push(arm);
    }
    if rd_dn_accept(@reader_ctx 'kw_else') {
        let rest:int64=0
        if ((rd_dn_peek(@reader_ctx) =? 'kw_if') or (rd_dn_peek(@reader_ctx) =? 'kw_match')) {
            rest = rd_dc_flow(@reader_ctx @reader_nodes)
            if ((rest =? 0) or (reader_nodes[rest].kind =? 'block')) {
                return 0
            }
            let block:int64=node_mk(@reader_nodes 'block' reader_nodes[rest].pos)
            node_set_list(@reader_nodes @reader_ctx.stores.lists[0] block [rd_dc_flow_stmt(@reader_nodes rest)]);
            rest = block
        }
        else {
            rest = rd_dc_body(@reader_ctx @reader_nodes)
            if (rest =? 0) {
                return 0
            }
        }
        let fallback:int64=node_mk(@reader_nodes 'arm' reader_nodes[rest].pos)
        node_set_list(@reader_nodes @reader_ctx.stores.lists[0] fallback [node_mk(@reader_nodes 'pwild' reader_nodes[rest].pos)]);
        reader_nodes[fallback].b = int32<overflow='wrap'>(rest)
        arms.push(fallback)
    }
    node_set_list(@reader_nodes @reader_ctx.stores.lists[0] n arms);
    n
}

# `value.` then no name (dn_expr's mistake, at once).
rd_dc_member_mistake=(@reader_ctx:ParserContext member:DewyLexeme):>int64=>$unsafe {
    if (not reader_ctx.flags.report_now) {
        return 0
    }
    if ((member.kind =? 'metatag') and dw_designed_directive(rd_dn_payload(@reader_ctx member))) {
        return reader_ctx.stores.host[0].dn_error(member.start "`${rd_dn_payload(@reader_ctx member)}` is part of the design but not implemented yet")
    }
    reader_ctx.stores.host[0].dn_error(member.start "expected a member name")
}

# The open range at `..` (its first bound 0), as a membership reads it (dw_iterable's slice).
rd_dc_member_range=(@reader_ctx:ParserContext @reader_nodes:array<Node> pos:int64):>int64=>$unsafe {
    reader_ctx.at = (int64<overflow='wrap'>(reader_ctx.at) + 1)
    let last:int64=0
    if dn_range_bound(@reader_ctx.tokens reader_ctx.at) {
        last = rd_dc_expr(@reader_ctx @reader_nodes 101)
        if (last =? 0) {
            return 0
        }
    }
    let n:int64=node_mk(@reader_nodes 'range' pos)
    reader_nodes[n].b = int32<overflow='wrap'>(last)
    if (last not=? 0) {
        rd_add_flag(@reader_nodes n NF_INCLUSIVE);
    }
    n
}

# `members(<'a' | 1>)` after its `(`: members(U) takes a type, grouped as in a type position, into
# the call n.
rd_dc_members_type=(@reader_ctx:ParserContext @reader_nodes:array<Node> n:int64):>bool=>$unsafe {
    let at:int64=reader_ctx.at
    let t:int64=rd_dc_type_primary(@reader_ctx @reader_nodes)
    # (`members(<1 | 2>, 3)`: dw_comma_fail's mistake, should nothing else read it)
    if ((t not=? 0) and (rd_dn_peek(@reader_ctx) =? 'comma')) {
        rd_dc_hint(@reader_ctx rd_mkpos(reader_ctx.file reader_ctx.tokens[at].start) rd_dc_comma_text());
    }
    if ((t =? 0) or (not rd_dn_accept(@reader_ctx 'rparen'))) {
        return false
    }
    node_set_list(@reader_nodes @reader_ctx.stores.lists[0] n [t]);
    true
}

# `in?` under `not` in a refinement's predicate, but in a contiguous range (dw_ref_predicate reads
# only the conjunction's own memberships as slices, dc_ref_ranges; another stays a value).
rd_dc_membership=(@reader_nodes:array<Node> n:int64 top:bool=true):>bool=>$unsafe {
    let k:NK=reader_nodes[n].kind
    if (k =? 'and_') {
        return (rd_dc_membership(@reader_nodes int64<overflow='wrap'>(reader_nodes[n].a) top) or rd_dc_membership(@reader_nodes int64<overflow='wrap'>(reader_nodes[n].b) top))
    }
    if (k =? 'not_') {
        return rd_dc_membership(@reader_nodes int64<overflow='wrap'>(reader_nodes[n].a) false)
    }
    if ((top or (k not=? 'binary')) or (reader_nodes[n].op not=? int32<overflow='wrap'>(int64<overflow='wrap'>(int64(12))))) {
        return false
    }
    let r:int64=int64<overflow='wrap'>(reader_nodes[n].b)
    (not (((reader_nodes[r].kind =? 'range') and (not rd_has_flag(@reader_nodes r NF_STEP))) and (not rd_has_flag(@reader_nodes r NF_EXCL_FIRST))))
}

# A metatag value: `$target`, `$build.mode` (the name being compiled for, the build's mode,
# dw_expr), `$allocator`, `$lend`, `$include_bytes`; 0 for another form, left unread
# (dc_unread), -1 for none of these (dc_atom goes on).
rd_dc_metatag_atom=(@reader_ctx:ParserContext @reader_nodes:array<Node> token:DewyLexeme pos:int64):>int64=>$unsafe {
    let width:int64=(int64<overflow='wrap'>(token.stop) - int64<overflow='wrap'>(token.start))
    if ((width =? 7) and (rd_dn_payload(@reader_ctx token) =? "target")) {
        return rd_dc_target_value(@reader_ctx @reader_nodes 0 pos (-1))
    }
    if ((width =? 6) and (rd_dn_payload(@reader_ctx token) =? "build")) {
        let dot:DewyLexeme=reader_ctx.tokens[reader_ctx.at]
        let member:DewyLexeme=reader_ctx.tokens[(int64<overflow='wrap'>(reader_ctx.at) + 1)]
        # (`$build.debug`: syntax_target_field's mistake)
        if (((((reader_ctx.flags.report_now and (dot.symbol =? 'dot')) and (not dot.space)) and (not member.space)) and (member.kind =? 'identifier')) and rd_dc_build_member(@reader_ctx member pos)) {
            reader_ctx.at = (int64<overflow='wrap'>(reader_ctx.at) + 2)
            return rd_dc_target_value(@reader_ctx @reader_nodes 3 pos member.start)
        }
        if (((((dot.symbol not=? 'dot') or dot.space) or member.space) or (member.kind not=? 'identifier')) or (rd_dn_payload(@reader_ctx member) not=? "mode")) {
            return 0
        }
        reader_ctx.at = (int64<overflow='wrap'>(reader_ctx.at) + 2)
        return rd_dc_target_value(@reader_ctx @reader_nodes 3 pos member.start)
    }
    if ((width =? 10) and (rd_dn_payload(@reader_ctx token) =? "allocator")) {
        return rd_dc_allocator(@reader_ctx @reader_nodes token)
    }
    if ((width =? 5) and (rd_dn_payload(@reader_ctx token) =? "lend")) {
        return rd_dc_lend(@reader_ctx @reader_nodes token)
    }
    if ((width =? 14) and (rd_dn_payload(@reader_ctx token) =? "include_bytes")) {
        return rd_dc_include_bytes(@reader_ctx @reader_nodes pos)
    }
    # (`let y = $expect true`: dw_directive's mistake)
    if ((((width =? 7) and (rd_dn_payload(@reader_ctx token) =? "expect")) or ((width =? 5) and (rd_dn_payload(@reader_ctx token) =? "fail"))) and reader_ctx.flags.report_now) {
        return rd_dc_fail_now(@reader_ctx pos "`${rd_dn_payload(@reader_ctx token)}` is a statement: it returns from its function when it fails, so it cannot give a value")
    }
    (-1)
}

# Where a method's name is written: two tokens before its `(`.
rd_dc_method_name_at=(@reader_ctx:ParserContext @reader_nodes:array<Node> method:int64):>int64=>$unsafe {
    let at:int64=rd_pos_off(reader_nodes[method].pos)
    let k:int64=reader_ctx.at
    loop (k >? 2) and (reader_ctx.tokens[k].start not=? at) {
        k = (int64<overflow='wrap'>(k) - 1)
    }
    rd_mkpos(reader_ctx.file reader_ctx.tokens[(int64<overflow='wrap'>(k) - 2)].start)
}

# `type of` at token `at`.
rd_dc_mint_at=(@reader_ctx:ParserContext at:int64):>bool=>$unsafe {
    (((reader_ctx.tokens[at].kind =? 'identifier') and (reader_ctx.tokens[at].name =? int32<overflow='wrap'>(reader_ctx.reader.dn_type_id))) and (reader_ctx.tokens[(int64<overflow='wrap'>(at) + 1)].symbol =? 'kw_of'))
}

# (where the first such element is written; 0 for none)
rd_dc_mixed_at=(@reader_ctx:ParserContext @reader_nodes:array<Node> items:array<int64> starts:array<int64>):>int64=>$unsafe {
    let k:int64=0
    loop item in items {
        if (reader_nodes[item].kind =? 'namedarg') {
            continue
        }
        if ((not rd_has_flag(@reader_nodes item NF_SPREAD)) and (k <? starts.length)) {
            return starts[k]
        }
        k = (int64<overflow='wrap'>(k) + 1)
    }
    0
}

# Where a comprehension's flow mixes elements and entries, as dw_collection_kind finds it: the first
# arm body whose kind differs from those before it among its flow's arms (an `else if` chain's or
# an `else match`'s arms are one flow's); 0 for none.
rd_dc_mixed_at=(@reader_ctx:ParserContext @reader_nodes:array<Node> flow:int64):>int64=>$unsafe {
    reader_ctx.collection.mixed_pos = 0
    rd_dc_kind_of(@reader_ctx @reader_nodes flow);
    reader_ctx.collection.mixed_pos
}

# `[x=42 2]`: an element neither named nor spread among fields (dw_record_entry's mistake, noted).
# (starts: where each element not a field is written)
rd_dc_mixed_record=(@reader_ctx:ParserContext @reader_nodes:array<Node> items:array<int64> starts:array<int64>):>void=>$unsafe {
    let at:int64=rd_dc_mixed_at(@reader_ctx @reader_nodes items starts)
    if (at not=? 0) {
        rd_dc_unsupported(@reader_ctx at "a record item without a field name and =");
    }
}

# `{ ... }` of module statements (dn_bracketed_from's braces), bodies read eagerly.
rd_dc_module_block=(@reader_ctx:ParserContext @reader_nodes:array<Node>):>int64=>$unsafe {
    let opening:DewyLexeme=rd_dn_take(@reader_ctx)
    let saved_rows:bool=reader_ctx.reader.dn_rows
    reader_ctx.reader.dn_rows = false
    let saved_lazy:bool=reader_ctx.reader.dc_lazy_on
    let saved_lib:bool=reader_ctx.reader.dc_lib_lazy
    reader_ctx.reader.dc_lazy_on = false
    reader_ctx.reader.dc_lib_lazy = false
    let children:array<int64>=[]
    loop (not rd_dn_accept(@reader_ctx 'rbrace')) {
        if (reader_ctx.tokens[reader_ctx.at].kind =? 'eof') {
            reader_ctx.stores.host[0].dn_error(opening.start "expected '{dn_token_text('rbrace')}' before end of file");
        }
        let before:int64=reader_ctx.at
        children.push(rd_dn_statement(@reader_ctx @reader_nodes true));
        if (reader_ctx.at =? before) {
            reader_ctx.stores.host[0].dn_error(reader_ctx.tokens[reader_ctx.at].start "expected a block element");
        }
    }
    reader_ctx.reader.dc_lazy_on = saved_lazy
    reader_ctx.reader.dc_lib_lazy = saved_lib
    reader_ctx.reader.dn_rows = saved_rows
    rd_dn_node(@reader_ctx 'block' "{"{dn_token_text('lbrace')}{dn_token_text('rbrace')}"}{":"}" opening.start children)
}

# A braced arm is next that nothing after its `}` continues but `else` (as an arm's body,
# dn_expr would apply it).
rd_dc_module_block_next=(@reader_ctx:ParserContext):>bool=>$unsafe {
    if (rd_dn_peek(@reader_ctx) not=? 'lbrace') {
        return false
    }
    let close:int64=rd_dc_closing(@reader_ctx reader_ctx.at)
    if (close <? 0) {
        return false
    }
    let after:DewyLexeme=reader_ctx.tokens[(int64<overflow='wrap'>(close) + 1)]
    (((after.kind =? 'eof') or (after.symbol =? 'kw_else')) or ((after.newline and (dn_power(after.symbol) =? 0)) and (after.symbol not=? 'kw_not')))
}

# `net.NetError` at the module's name: a module's type (dw_type's `.`).
rd_dc_module_type=(@reader_ctx:ParserContext @reader_nodes:array<Node> token:DewyLexeme):>int64=>$unsafe {
    let member:DewyLexeme=reader_ctx.tokens[(int64<overflow='wrap'>(reader_ctx.at) + 2)]
    reader_ctx.at = (int64<overflow='wrap'>(reader_ctx.at) + 3)
    let n:int64=node_mk(@reader_nodes 'tname' rd_mkpos(reader_ctx.file token.start))
    reader_nodes[n].sval = int32<overflow='wrap'>(reader_ctx.stores.host[0].intern(rd_dn_payload(@reader_ctx token)))
    reader_nodes[n].name = int32<overflow='wrap'>(reader_ctx.stores.host[0].intern(rd_dn_payload(@reader_ctx member)))
    rd_dc_type_arguments(@reader_ctx @reader_nodes n 0)
}

# An element expressing a number of values other than one (dw_multi_element): a block of other
# than one statement, a loop, an `if` without `else`, or one holding such a body.
rd_dc_multi=(@reader_ctx:ParserContext @reader_nodes:array<Node> n:int64):>bool=>$unsafe {
    if (n <=? 0) {
        return false
    }
    let k:NK=reader_nodes[n].kind
    if (k =? 'exprstmt') {
        return rd_dc_multi(@reader_ctx @reader_nodes int64<overflow='wrap'>(reader_nodes[n].a))
    }
    if (k =? 'block') {
        if (rd_has_flag(@reader_nodes n NF_COMPREHENSION) or rd_has_flag(@reader_nodes n NF_DISCARD)) {
            return false
        }
        return ((rd_nkids(@reader_nodes n) not=? 1) or rd_dc_multi(@reader_ctx @reader_nodes rd_kid(@reader_ctx @reader_nodes n 0)))
    }
    if (((k =? 'for_') or (k =? 'while_')) or (k =? 'loopx')) {
        return true
    }
    if (k =? 'if_') {
        return ((rd_dc_multi(@reader_ctx @reader_nodes int64<overflow='wrap'>(reader_nodes[n].b)) or (reader_nodes[n].c =? 0)) or rd_dc_multi(@reader_ctx @reader_nodes int64<overflow='wrap'>(reader_nodes[n].c)))
    }
    if (k =? 'match_') {
        loop arm in node_kids(@reader_nodes @reader_ctx.stores.lists[0] n) {
            if rd_dc_multi(@reader_ctx @reader_nodes int64<overflow='wrap'>(reader_nodes[arm].b)) {
                return true
            }
        }
    }
    false
}

rd_dc_mutable_pattern=(@reader_ctx:ParserContext first:DewyLexeme):>bool=>$unsafe {
    rd_dc_unsupported(@reader_ctx rd_mkpos(reader_ctx.file first.start) "unpacking a mutable parameter; use a named @ parameter");
    false
}

# The value a type application is written on is a name, or a field route from one.
rd_dc_named_base=(@reader_nodes:array<Node> n:int64):>bool=>$unsafe {
    let base:int64=n
    loop (reader_nodes[base].kind =? 'field') {
        base = int64<overflow='wrap'>(reader_nodes[base].a)
    }
    (reader_nodes[base].kind =? 'ident')
}

rd_dc_named_members=(@reader_ctx:ParserContext @reader_nodes:array<Node> n:int64):>bool=>$unsafe {
    (rd_name_of(@reader_ctx int64<overflow='wrap'>(reader_nodes[n].name)) =? "members")
}

# `name=value` is next (a named argument or a record field).
rd_dc_named_next=(@reader_ctx:ParserContext):>bool=>$unsafe {
    let token:DewyLexeme=reader_ctx.tokens[reader_ctx.at]
    (((token.kind =? 'identifier') and ((token.symbol =? 'none') or (token.symbol =? 'kw_test'))) and (reader_ctx.tokens[(int64<overflow='wrap'>(reader_ctx.at) + 1)].symbol =? 'assign'))
}

# `m[new ..]`, `m[.. new]`, `m[[..] end new]`: an index inserting axes, through its `]` (dw_expr's
# `new` entries, dw_new_range): each `new` the name `$new`, `..` beside one a whole axis; the
# other entries as dc_axes reads them. The node becomes a new_axis.
rd_dc_new_axes=(@reader_ctx:ParserContext @reader_nodes:array<Node> n:int64):>bool=>$unsafe {
    let args:array<int64>=[]
    let mark:int64=reader_ctx.reader.dc_axis_ranges.length
    let entries:int64=0
    loop (not rd_dn_accept(@reader_ctx 'rbrack')) {
        let token:DewyLexeme=reader_ctx.tokens[reader_ctx.at]
        if (token.kind =? 'eof') {
            return rd_dc_axes_end(@reader_ctx mark false)
        }
        entries = (int64<overflow='wrap'>(entries) + 1)
        reader_nodes[n].aux2 = int32<overflow='wrap'>(args.length)
        let pos:int64=rd_mkpos(reader_ctx.file token.start)
        let new_first:bool=((token.kind =? 'identifier') and (int64<overflow='wrap'>(token.name) =? reader_ctx.reader.dn_new_id))
        if (new_first or (token.symbol =? 'range')) {
            # (`new`, `new ..`, `new .. new`, `.. new`, `..`)
            let at:int64=reader_ctx.at
            if new_first {
                at = (int64<overflow='wrap'>(at) + 1)
            }
            if (reader_ctx.tokens[at].symbol not=? 'range') {
                if (not new_first) {
                    return rd_dc_axes_end(@reader_ctx mark false)
                }
                reader_ctx.at = at
                args.push(rd_bc_ident(@reader_ctx @reader_nodes "$new" pos));
                reader_ctx.reader.dc_axis_ranges.push(0);
                continue
            }
            let last:DewyLexeme=reader_ctx.tokens[(int64<overflow='wrap'>(at) + 1)]
            let new_last:bool=((dn_range_bound(@reader_ctx.tokens (int64<overflow='wrap'>(at) + 1)) and (last.kind =? 'identifier')) and (int64<overflow='wrap'>(last.name) =? reader_ctx.reader.dn_new_id))
            # (`xs[new..1]`: dw_new_range's mistake, noted; the bound read on)
            if (((new_first and (not new_last)) and dn_range_bound(@reader_ctx.tokens (int64<overflow='wrap'>(at) + 1))) and reader_ctx.flags.report_now) {
                rd_dc_report(@reader_ctx pos "`new` is an index entry, not a range endpoint: write `xs[new ..]` or `xs[.. new]`, and bracket a range next to it, as in `xs[new [1..end]]`");
                reader_ctx.at = (int64<overflow='wrap'>(at) + 1)
                if (rd_dc_expr(@reader_ctx @reader_nodes 101) =? 0) {
                    return rd_dc_axes_end(@reader_ctx mark false)
                }
                args.push(rd_bc_ident(@reader_ctx @reader_nodes "$new" pos));
                args.push(node_mk(@reader_nodes 'range' pos));
                loop k in [0..(int64<overflow='wrap'>((int64<overflow='wrap'>(args.length) - int64<overflow='wrap'>(reader_ctx.reader.dc_axis_ranges.length))) + int64<overflow='wrap'>(mark))) {
                    reader_ctx.reader.dc_axis_ranges.push(0);
                }
                continue
            }
            if (dn_range_bound(@reader_ctx.tokens (int64<overflow='wrap'>(at) + 1)) and (not (new_last and ((reader_ctx.tokens[(int64<overflow='wrap'>(at) + 2)].symbol =? 'rbrack') or reader_ctx.tokens[(int64<overflow='wrap'>(at) + 2)].space)))) {
                return rd_dc_axes_end(@reader_ctx mark false)
            }
            # (`..` alone among several entries: a whole axis, dw_iterable's slice)
            if ((not new_first) and (not new_last)) {
                reader_ctx.at = (int64<overflow='wrap'>(at) + 1)
                let whole:int64=node_mk(@reader_nodes 'range' pos)
                args.push(whole);
                reader_ctx.reader.dc_axis_ranges.push(whole);
                continue
            }
            reader_ctx.at = (int64<overflow='wrap'>(at) + 1)
            if new_first {
                args.push(rd_bc_ident(@reader_ctx @reader_nodes "$new" pos));
            }
            args.push(node_mk(@reader_nodes 'range' pos));
            if new_last {
                reader_ctx.at = (int64<overflow='wrap'>(reader_ctx.at) + 1)
                args.push(rd_bc_ident(@reader_ctx @reader_nodes "$new" pos));
            }
            loop k in [0..(int64<overflow='wrap'>((int64<overflow='wrap'>(args.length) - int64<overflow='wrap'>(reader_ctx.reader.dc_axis_ranges.length))) + int64<overflow='wrap'>(mark))) {
                reader_ctx.reader.dc_axis_ranges.push(0);
            }
            continue
        }
        if rd_dc_named_next(@reader_ctx) {
            return rd_dc_axes_end(@reader_ctx mark false)
        }
        if rd_dc_whole_axis(@reader_ctx) {
            let whole:int64=node_mk(@reader_nodes 'range' rd_mkpos(reader_ctx.file reader_ctx.tokens[(int64<overflow='wrap'>(reader_ctx.at) + 1)].start))
            reader_ctx.at = (int64<overflow='wrap'>(reader_ctx.at) + 3)
            args.push(whole);
            reader_ctx.reader.dc_axis_ranges.push(whole);
            continue
        }
        reader_ctx.reader.dc_range_call = 0
        reader_ctx.reader.dc_range_top = true
        let arg:int64=rd_dc_expr(@reader_ctx @reader_nodes 0)
        reader_ctx.reader.dc_range_top = false
        if (arg =? 0) {
            return rd_dc_axes_end(@reader_ctx mark false)
        }
        let slice:int64=0
        if (reader_ctx.reader.dc_range_call =? arg) {
            slice = reader_ctx.reader.dc_range_node
        }
        # (`m[1..end new]`: a range written without brackets, inclusive)
        if rd_dn_accept(@reader_ctx 'range') {
            if (slice not=? 0) {
                return rd_dc_axes_end(@reader_ctx mark false)
            }
            let first_bound:int64=arg
            let last:int64=0
            if dn_range_bound(@reader_ctx.tokens reader_ctx.at) {
                last = rd_dc_expr(@reader_ctx @reader_nodes 101)
                if (last =? 0) {
                    return rd_dc_axes_end(@reader_ctx mark false)
                }
            }
            arg = node_mk(@reader_nodes 'range' pos)
            reader_nodes[arg].a = int32<overflow='wrap'>(first_bound)
            reader_nodes[arg].b = int32<overflow='wrap'>(last)
            rd_add_flag(@reader_nodes arg NF_INCLUSIVE);
            slice = arg
        }
        args.push(arg);
        reader_ctx.reader.dc_axis_ranges.push(slice);
    }
    # (several entries: a bracketed range among them is a slice, dw_iterable)
    if (entries >? 1) {
        loop i in [0..args.length) {
            if (reader_ctx.reader.dc_axis_ranges[(int64<overflow='wrap'>(mark) + int64<overflow='wrap'>(i))] not=? 0) {
                args[i] = reader_ctx.reader.dc_axis_ranges[(int64<overflow='wrap'>(mark) + int64<overflow='wrap'>(i))]
            }
        }
    }
    reader_nodes[n].kind = 'new_axis'
    node_set_list(@reader_nodes @reader_ctx.stores.lists[0] n args);
    if (args.length =? 1) {
        reader_nodes[n].b = int32<overflow='wrap'>(args[0])
    }
    rd_dc_axes_end(@reader_ctx mark true)
}

# An index's entries, from dc_parser.at through its `]`, name `new` at their top.
rd_dc_new_inside=(@reader_ctx:ParserContext):>bool=>$unsafe {
    let depth:int64=0
    let k:int64=reader_ctx.at
    loop (k <? reader_ctx.tokens.length) {
        let t:DewyLexeme=reader_ctx.tokens[k]
        if (t.kind =? 'eof') {
            return false
        }
        let symbol:DewyToken=t.symbol
        if (((symbol =? 'lparen') or (symbol =? 'lbrack')) or (symbol =? 'lbrace')) {
            depth = (int64<overflow='wrap'>(depth) + 1)
        }
        else if (((symbol =? 'rparen') or (symbol =? 'rbrack')) or (symbol =? 'rbrace')) {
            if (depth =? 0) {
                return false
            }
            depth = (int64<overflow='wrap'>(depth) - 1)
        }
        else if (((depth =? 0) and (t.kind =? 'identifier')) and (int64<overflow='wrap'>(t.name) =? reader_ctx.reader.dn_new_id)) {
            return true
        }
        k = (int64<overflow='wrap'>(k) + 1)
    }
    false
}

# `if x > 3 {`, `loop { ... }` then no body (dn_flow's mistakes, at once): the condition's next token
# starts no body; 0 where the condition reads on (`:`).
rd_dc_no_body=(@reader_ctx:ParserContext @reader_nodes:array<Node> keyword:DewyLexeme n:int64 head:int64):>int64=>$unsafe {
    if (not reader_ctx.flags.report_now) {
        return 0
    }
    let next:DewyToken=rd_dn_peek(@reader_ctx)
    if (next =? 'colon') {
        return 0
    }
    let braced:bool=(((((keyword.symbol =? 'kw_loop') and (reader_nodes[head].op =? 4)) and (reader_nodes[int64<overflow='wrap'>(reader_nodes[head].a)].kind =? 'block')) and (reader_ctx.tokens[(int64<overflow='wrap'>(reader_ctx.at) - 1)].symbol =? 'rbrace')) and (reader_ctx.tokens[rd_dc_open_brace(@reader_ctx (int64<overflow='wrap'>(reader_ctx.at) - 1))].start =? rd_pos_off(reader_nodes[int64<overflow='wrap'>(reader_nodes[head].a)].pos)))
    if braced {
        reader_ctx.stores.host[0].dn_error(reader_ctx.tokens[reader_ctx.at].start "expected a body after this loop's condition: a loop is `loop condition body`, so a loop that runs until `break` or `return` is `loop true \{ ... }`");
    }
    let habit:string=""
    if (((((next =? 'gt') or (next =? 'lt')) or (next =? 'rangle')) or (next =? 'ge')) or (next =? 'le')) {
        habit = " (comparisons end with `?`: `x >? y`, `x <=? y`)"
    }
    reader_ctx.stores.host[0].dn_error(reader_ctx.tokens[reader_ctx.at].start "expected a body after '{dn_token_text(keyword.symbol)}'{habit}")
}

# A parenthesized group after its `(`: one value, or several (`(a b)`, dw_values), through `)`.
# (`xs[..)`: no value at dc_parser.at, dn_atom's mistake, should nothing else read it)
rd_dc_no_operand=(@reader_ctx:ParserContext):>bool=>$unsafe {
    let token:DewyLexeme=reader_ctx.tokens[reader_ctx.at]
    if (token.kind not=? 'op') {
        return false
    }
    let text:string=rd_dn_payload(@reader_ctx token)
    rd_dc_hint(@reader_ctx rd_mkpos(reader_ctx.file token.start) "expected an expression, found '{text}'{dn_operator_habit(@reader_ctx.tokens (int64<overflow='wrap'>(reader_ctx.at) + 1) text)}");
    false
}

rd_dc_none_type=(@reader_ctx:ParserContext):>int64=>$unsafe {
    if (reader_ctx.reader.dc_none_id =? 0) {
        reader_ctx.reader.dc_none_id = reader_ctx.stores.host[0].intern("none")
    }
    reader_ctx.reader.dc_none_id
}

# `a <? b not =? c` (dw_expr's mistake, at once: reading on would take another reading).
rd_dc_not_chain=(@reader_ctx:ParserContext pos:int64):>int64=>$unsafe {
    if reader_ctx.flags.report_now {
        rd_dc_fail_now(@reader_ctx pos "`not` comparisons do not chain; join the comparisons with `and`");
    }
    0
}

# (dw_intrinsic_check's mistake)
rd_dc_not_intrinsic=(@reader_ctx:ParserContext @reader_nodes:array<Node> n:int64 name:string):>int64=>$unsafe {
    if (not reader_ctx.flags.report_now) {
        return 0
    }
    rd_dc_fail_now(@reader_ctx reader_nodes[n].pos "'{name}' is not a function the compiler provides, so it cannot be `$intrinsic`: give it a body, or `$extern` for a C function")
}

rd_dc_note_member_range=(@reader_ctx:ParserContext value:int64):>void=>$unsafe {
    reader_ctx.reader.dc_member_ranges[value] = reader_ctx.reader.dc_range_node
}

# The `{` the `}` at `at` closes.
rd_dc_open_brace=(@reader_ctx:ParserContext at:int64):>int64=>$unsafe {
    let depth:int64=0
    let k:int64=at
    loop (k >? 0) {
        let t:DewyToken=reader_ctx.tokens[k].symbol
        if (((t =? 'rbrace') or (t =? 'rbrack')) or (t =? 'rparen')) {
            depth = (int64<overflow='wrap'>(depth) + 1)
        }
        if (((t =? 'lbrace') or (t =? 'lbrack')) or (t =? 'lparen')) {
            depth = (int64<overflow='wrap'>(depth) - 1)
            if (depth =? 0) {
                return k
            }
        }
        k = (int64<overflow='wrap'>(k) - 1)
    }
    0
}

# The `(` the `)` at `at` closes.
rd_dc_open_paren=(@reader_ctx:ParserContext at:int64):>int64=>$unsafe {
    let depth:int64=0
    let k:int64=at
    loop (k >? 0) {
        if (reader_ctx.tokens[k].symbol =? 'rparen') {
            depth = (int64<overflow='wrap'>(depth) + 1)
        }
        if (reader_ctx.tokens[k].symbol =? 'lparen') {
            depth = (int64<overflow='wrap'>(depth) - 1)
            if (depth =? 0) {
                return k
            }
        }
        k = (int64<overflow='wrap'>(k) - 1)
    }
    k
}

# The right operand of `=>` as a block (dw_block): braced, or one statement.
rd_dc_operand_body=(@reader_ctx:ParserContext @reader_nodes:array<Node>):>int64=>$unsafe {
    let first:int64=reader_ctx.at
    let opening:DewyLexeme=reader_ctx.tokens[reader_ctx.at]
    if ((opening.symbol =? 'lbrace') or ((opening.kind =? 'metatag') and (reader_ctx.tokens[(int64<overflow='wrap'>(reader_ctx.at) + 1)].symbol =? 'lbrace'))) {
        return rd_dc_body(@reader_ctx @reader_nodes)
    }
    let statement:int64=0
    if (opening.symbol =? 'kw_concurrent') {
        # (a statement: the group expresses nothing, dw_stmt)
        reader_ctx.at = (int64<overflow='wrap'>(reader_ctx.at) + 1)
        statement = rd_dc_concurrent(@reader_ctx @reader_nodes opening true)
        if (statement =? 0) {
            return 0
        }
    }
    else if (((opening.symbol =? 'kw_if') or (opening.symbol =? 'kw_match')) or (opening.symbol =? 'kw_loop')) {
        statement = rd_dc_flow(@reader_ctx @reader_nodes)
        if (statement =? 0) {
            return 0
        }
        # (a chain folding to its compiled arm: that arm's statements, dw_block's dw_target_splice)
        if ((reader_ctx.reader.dc_live_at =? first) and (opening.symbol =? 'kw_if')) {
            if reader_ctx.collection.tagged_last.has(statement) {
                return 0
            }
            let spliced:int64=node_mk(@reader_nodes 'block' rd_mkpos(reader_ctx.file opening.start))
            node_set_list(@reader_nodes @reader_ctx.stores.lists[0] spliced node_kids(@reader_nodes @reader_ctx.stores.lists[0] statement));
            return spliced
        }
        rd_add_flag(@reader_nodes statement NF_STMT);
        statement = rd_dc_flow_stmt(@reader_nodes statement)
    }
    else if (((opening.symbol =? 'kw_return') or (opening.symbol =? 'kw_break')) or (opening.symbol =? 'kw_continue')) {
        # (`=> return x`: the statement, dn_stmt within the operand)
        statement = rd_dc_statement(@reader_ctx @reader_nodes)
        if (statement =? 0) {
            return 0
        }
    }
    else if ((opening.symbol =? 'lparen') and rd_dc_update_next(@reader_ctx)) {
        statement = rd_dc_grouped_update(@reader_ctx @reader_nodes)
        if (statement =? 0) {
            return 0
        }
    }
    else {
        let value:int64=rd_dc_expr(@reader_ctx @reader_nodes 30)
        if (value =? 0) {
            return 0
        }
        # (`=> $unsafe f()`: the statement is its operand's, dw_stmt)
        let written:int64=opening.start
        if rd_dc_unsafe_at(@reader_ctx first) {
            written = reader_ctx.tokens[(int64<overflow='wrap'>(first) + 1)].start
        }
        statement = node_mk(@reader_nodes 'exprstmt' rd_mkpos(reader_ctx.file written))
        reader_nodes[statement].a = int32<overflow='wrap'>(value)
    }
    let body:int64=node_mk(@reader_nodes 'block' rd_mkpos(reader_ctx.file opening.start))
    node_set_list(@reader_nodes @reader_ctx.stores.lists[0] body [statement]);
    body
}

# A place's route as written (dw_operand_text): "" for anything else.
rd_dc_operand_text=(@reader_ctx:ParserContext @reader_nodes:array<Node> n:int64 start:int64):>string=>$unsafe {
    if (reader_ctx.tokens[start].kind not=? 'identifier') {
        return ""
    }
    rd_dc_route_text(@reader_ctx @reader_nodes n)
}

# An operator dc_expr does not read, before an operator no value starts with (`x == 3`, `xs[1:]`):
# the parse mistake at that operator (dn_atom's), at once; 0 otherwise.
rd_dc_operator_mistake=(@reader_ctx:ParserContext):>int64=>$unsafe {
    if ((not reader_ctx.flags.report_now) or (dn_power(reader_ctx.tokens[reader_ctx.at].symbol) =? 0)) {
        return 0
    }
    let bad:DewyLexeme=reader_ctx.tokens[(int64<overflow='wrap'>(reader_ctx.at) + 1)]
    if (bad.kind not=? 'op') {
        return 0
    }
    reader_ctx.at = (int64<overflow='wrap'>(reader_ctx.at) + 2)
    rd_dc_atom_mistake(@reader_ctx bad)
}

# `end` and `new` outside brackets: dw_expr's mistakes, the rest of the statement read
# (a value in their place); 0 for `type` and anywhere else.
rd_dc_outside_index=(@reader_ctx:ParserContext @reader_nodes:array<Node> name:int64 pos:int64):>int64=>$unsafe {
    # (`type of x` as a value: dw_expr's mistake, should nothing else read it)
    if ((name =? reader_ctx.reader.dn_type_id) and (rd_dn_peek(@reader_ctx) =? 'kw_of')) {
        return rd_dc_hint(@reader_ctx pos "`type of ...` forms a type, not a runtime value; bind it with `T:type = type of ...`")
    }
    if (((reader_ctx.reader.dc_index_node not=? 0) or (not reader_ctx.flags.report_now)) or (name =? reader_ctx.reader.dn_type_id)) {
        return 0
    }
    if (name =? reader_ctx.reader.dn_end_id) {
        rd_dc_report(@reader_ctx pos "`end` is the last index inside brackets, as in `xs[end]` or `xs[1..end]`; outside them, use `xs.length - 1`");
    }
    else {
        rd_dc_report(@reader_ctx pos "`new` inserts an axis as an entry inside brackets, as in `xs[new]` or `xs[.. new]`");
    }
    node_mk(@reader_nodes 'none_lit' pos)
}

rd_dc_overload_value=(@reader_ctx:ParserContext @reader_nodes:array<Node>):>int64=>$unsafe {
    rd_dc_unsupported(@reader_ctx rd_mkpos(reader_ctx.file reader_ctx.tokens[reader_ctx.at].start) "an overload group member other than a function literal");
    rd_dc_expr(@reader_ctx @reader_nodes (int64<overflow='wrap'>(dn_power('amp')) + 1))
}

rd_dc_overloads=(@reader_nodes:array<Node> n:int64):>bool=>$unsafe {
    if (reader_nodes[n].kind =? 'lambda') {
        return true
    }
    (((reader_nodes[n].kind =? 'binary') and (reader_nodes[n].op =? int32<overflow='wrap'>(int64<overflow='wrap'>(int64(63))))) and (rd_dc_overloads(@reader_nodes int64<overflow='wrap'>(reader_nodes[n].a)) or rd_dc_overloads(@reader_nodes int64<overflow='wrap'>(reader_nodes[n].b))))
}

# `:>(int64 int64)`: several result values, an array type marked with ival -(their number), its
# list each value's type (dw_pack_type): from the group of types dc_type_primary read last.
rd_dc_pack=(@reader_ctx:ParserContext @reader_nodes:array<Node> result:int64):>int64=>$unsafe {
    if (((result not=? reader_ctx.reader.dc_grouped) or (reader_nodes[result].kind not=? 'ttuple')) or (reader_nodes[result].aux not=? int32<overflow='wrap'>(TUPLE_VALUES))) {
        return result
    }
    let members:array<int64>=node_kids(@reader_nodes @reader_ctx.stores.lists[0] result)
    reader_nodes[result].kind = 'tarray'
    reader_nodes[result].aux = 0
    reader_nodes[result].a = int32<overflow='wrap'>(members[0])
    reader_nodes[result].ival = (-int64<overflow='wrap'>(members.length))
    result
}

# `parallel x in xs body`, `parallel @x in xs body` after its keyword; `collect`, a comprehension's
# (`[parallel x in xs f(x)]`): the region dw_parallel makes. A form it reports is left unread
# (dc_unread).
rd_dc_parallel=(@reader_ctx:ParserContext @reader_nodes:array<Node> token:DewyLexeme collect:bool):>int64=>$unsafe {
    let pos:int64=rd_mkpos(reader_ctx.file token.start)
    let mutable:bool=rd_dn_accept(@reader_ctx 'at')
    let binder:DewyLexeme=reader_ctx.tokens[reader_ctx.at]
    # (`parallel true {}`: dw_parallel's mistake)
    if ((((not mutable) and (reader_ctx.tokens[(int64<overflow='wrap'>(reader_ctx.at) + 1)].symbol not=? 'kw_in')) and (binder.symbol not=? 'lparen')) and reader_ctx.flags.report_now) {
        return rd_dc_fail_now(@reader_ctx rd_mkpos(reader_ctx.file binder.start) "Dewy does not yet support a parallel loop without one bounded iterable")
    }
    if (((binder.kind not=? 'identifier') or (binder.symbol not=? 'none')) or (reader_ctx.tokens[(int64<overflow='wrap'>(reader_ctx.at) + 1)].symbol not=? 'kw_in')) {
        return 0
    }
    # (`[parallel @x in xs x]`: dw_parallel's mistake, should nothing else read it)
    if ((collect and mutable) and (not rd_dn_reserved(@reader_ctx int64<overflow='wrap'>(binder.name)))) {
        return rd_dc_parallel_place(@reader_ctx binder)
    }
    if (collect and mutable) {
        return 0
    }
    if rd_dn_reserved(@reader_ctx int64<overflow='wrap'>(binder.name)) {
        rd_dc_reserved_at(@reader_ctx binder);
    }
    reader_ctx.at = (int64<overflow='wrap'>(reader_ctx.at) + 2)
    let source:int64=rd_dc_expr(@reader_ctx @reader_nodes (int64<overflow='wrap'>(dn_power('kw_in')) + 1))
    if ((((source =? 0) or (dn_power(rd_dn_peek(@reader_ctx)) >? 0)) or (rd_dn_peek(@reader_ctx) =? 'kw_not')) or (not dn_can_start(@reader_ctx.tokens reader_ctx.at))) {
        return 0
    }
    let param:int64=node_mk(@reader_nodes 'param' rd_mkpos(reader_ctx.file binder.start))
    reader_nodes[param].name = binder.name
    let saved_unread:bool=reader_ctx.flags.unread_here
    let saved_result:int64=reader_ctx.reader.dc_fn_result
    reader_ctx.flags.unread_here = false
    reader_ctx.reader.dc_fn_result = (if collect int64(1) else int64(0))
    let saved_map:bool=reader_ctx.reader.dc_map_ok
    reader_ctx.reader.dc_map_ok = false
    let body:int64=rd_dc_body(@reader_ctx @reader_nodes)
    reader_ctx.reader.dc_map_ok = saved_map
    reader_ctx.reader.dc_fn_result = saved_result
    reader_ctx.flags.unread_here = saved_unread
    if ((body =? 0) or (rd_dn_peek(@reader_ctx) =? 'kw_else')) {
        return 0
    }
    if (not rd_dc_parallel_exits(@reader_ctx @reader_nodes body 0)) {
        # (dw_parallel_exits' mistakes, at once)
        if (not reader_ctx.flags.report_now) {
            return 0
        }
        rd_dc_flush_report(@reader_ctx);
        reader_ctx.stores.host[0].dw_parallel_exits(body 0);
    }
    let fn_:int64=node_mk(@reader_nodes 'lambda' pos)
    rd_add_flag(@reader_nodes fn_ NF_LANG_BODY);
    if ((not collect) and (not mutable)) {
        rd_add_flag(@reader_nodes fn_ NF_VOID);
    }
    if mutable {
        let ret:int64=node_mk(@reader_nodes 'return_' pos)
        reader_nodes[ret].a = int32<overflow='wrap'>(rd_bc_ident(@reader_ctx @reader_nodes rd_name_of(@reader_ctx int64<overflow='wrap'>(binder.name)) pos))
        let statements:array<int64>=node_kids(@reader_nodes @reader_ctx.stores.lists[0] body)
        statements.push(ret);
        node_set_list(@reader_nodes @reader_ctx.stores.lists[0] body statements);
        rd_add_flag(@reader_nodes source NF_MUT);
        reader_ctx.stores.host[0].dw_finish_function(fn_ [param] body "");
    }
    else {
        node_set_list(@reader_nodes @reader_ctx.stores.lists[0] fn_ [param]);
        reader_nodes[fn_].b = int32<overflow='wrap'>(body)
    }
    let call:int64=rd_bc_call(@reader_ctx @reader_nodes (if mutable "parallel_update" else (if collect "__dewy_parallel_collect" else "__dewy_parallel_each")) [source fn_] pos)
    let region:int64=node_mk(@reader_nodes 'parallel_region' pos)
    reader_nodes[region].a = int32<overflow='wrap'>(call)
    if collect {
        return region
    }
    let statement:int64=node_mk(@reader_nodes 'exprstmt' pos)
    reader_nodes[statement].a = int32<overflow='wrap'>(region)
    rd_add_flag(@reader_nodes statement NF_STMT);
    statement
}

# No `return` leaves a parallel body, nor a `break` or `continue` outside a loop in it
# (dw_parallel_exits reports them).
rd_dc_parallel_exits=(@reader_ctx:ParserContext @reader_nodes:array<Node> n:int64 depth:int64):>bool=>$unsafe {
    if (((n <=? 0) or (reader_nodes[n].kind =? 'lambda')) or (reader_nodes[n].kind =? 'fn_')) {
        return true
    }
    let k:NK=reader_nodes[n].kind
    if ((k =? 'return_') or (((k =? 'break_') or (k =? 'continue_')) and (depth =? 0))) {
        return false
    }
    let inner:int64=depth
    if (((k =? 'for_') or (k =? 'while_')) or (k =? 'loopx')) {
        inner = (int64<overflow='wrap'>(inner) + 1)
    }
    if (((not rd_dc_parallel_exits(@reader_ctx @reader_nodes int64<overflow='wrap'>(reader_nodes[n].a) depth)) or (not rd_dc_parallel_exits(@reader_ctx @reader_nodes int64<overflow='wrap'>(reader_nodes[n].b) inner))) or (not rd_dc_parallel_exits(@reader_ctx @reader_nodes int64<overflow='wrap'>(reader_nodes[n].c) depth))) {
        return false
    }
    loop child in node_kids(@reader_nodes @reader_ctx.stores.lists[0] n) {
        if (not rd_dc_parallel_exits(@reader_ctx @reader_nodes child depth)) {
            return false
        }
    }
    true
}

# `[parallel @x in xs x]`: a place as a comprehension's binding (dw_parallel's mistake, should nothing
# else read it).
rd_dc_parallel_place=(@reader_ctx:ParserContext binder:DewyLexeme):>int64=>$unsafe {
    let source:DewyLexeme=reader_ctx.tokens[(int64<overflow='wrap'>(reader_ctx.at) + 2)]
    let iterable:string="..."
    if ((source.kind =? 'identifier') and (source.symbol =? 'none')) {
        iterable = rd_dn_payload(@reader_ctx source)
    }
    rd_dc_hint(@reader_ctx rd_mkpos(reader_ctx.file binder.start) "parallel comprehension bindings are values: write `parallel {rd_dn_payload(@reader_ctx binder)} in {iterable} ...`")
}

# A metatag among parameters at dc_parser.at: 0 for a lambda's `$capture`; 1 for a mistake noted and its
# tag read, another modifier or a module function's `$capture`; -1 a form left unread
# (dc_unread).
rd_dc_parameter_tag=(@reader_ctx:ParserContext tag:DewyLexeme lambda:bool):>int64=>$unsafe {
    let text:string=rd_dn_payload(@reader_ctx tag)
    if (lambda and (text =? "capture")) {
        return 0
    }
    if ((not reader_ctx.flags.report_now) or ((text not=? "capture") and dw_designed_directive(text))) {
        return (-1)
    }
    if (text not=? "capture") {
        rd_dc_report(@reader_ctx rd_mkpos(reader_ctx.file tag.start) "unknown parameter modifier `${text}` (the one modifier is `$capture`)");
    }
    else {
        rd_dc_unsupported(@reader_ctx rd_mkpos(reader_ctx.file tag.start) "$capture on a module function");
    }
    reader_ctx.at = (int64<overflow='wrap'>(reader_ctx.at) + 1)
    1
}

# A parameter named by a word: `(in:int64)`, a word operator (dw_param's mistake, noted: true), or
# `(from:int64)`, a keyword (a parse mistake, at once); false for any other.
rd_dc_parameter_word=(@reader_ctx:ParserContext parameter:DewyLexeme):>bool=>$unsafe {
    if ((reader_ctx.tokens[(int64<overflow='wrap'>(reader_ctx.at) + 1)].symbol not=? 'colon') or reader_ctx.tokens[(int64<overflow='wrap'>(reader_ctx.at) + 1)].space) {
        return false
    }
    let word:DewyToken=parameter.symbol
    if (((((word =? 'kw_from') or (word =? 'kw_import')) or (word =? 'kw_return')) or (word =? 'kw_break')) or (word =? 'kw_continue')) {
        rd_dc_keyword_name(@reader_ctx parameter);
    }
    if ((word =? 'kw_not') or (not rd_dc_word_operator(word))) {
        return false
    }
    rd_dc_word_operator_at(@reader_ctx parameter);
    true
}

# `((x:int64):>int64)` at its `(`: dw_type's mistake, noted; the function type read on.
rd_dc_paren_function_type=(@reader_ctx:ParserContext @reader_nodes:array<Node> token:DewyLexeme):>int64=>$unsafe {
    reader_ctx.at = (int64<overflow='wrap'>(reader_ctx.at) + 1)
    let n:int64=rd_dc_function_type(@reader_ctx @reader_nodes false)
    if ((n =? 0) or (not rd_dn_accept(@reader_ctx 'rparen'))) {
        return 0
    }
    rd_dc_report(@reader_ctx rd_mkpos(reader_ctx.file token.start) "function types use angle brackets: replace the outer (...) with <...>, as in `<(x:int64):>int64>`");
    n
}

rd_dc_partial=(@reader_ctx:ParserContext @reader_nodes:array<Node> opening:DewyLexeme name_id:int32=0):>int64=>$unsafe {
    let pos:int64=rd_mkpos(reader_ctx.file opening.start)
    if (reader_ctx.reader.dc_partial_name =? 0) {
        reader_ctx.reader.dc_partial_name = reader_ctx.stores.host[0].intern("$partial")
    }
    let slot:int64=(int64<overflow='wrap'>(reader_ctx.at) - 1)
    reader_ctx.tokens[slot] = DewyLexeme[kind='identifier' name=int32<overflow='wrap'>(reader_ctx.reader.dc_partial_name) start=opening.start stop=opening.stop space=opening.space newline=opening.newline]
    reader_ctx.at = slot
    let saved_angles:int64=reader_ctx.reader.dn_angles
    reader_ctx.reader.dn_angles = 0
    let value:int64=rd_dc_expr(@reader_ctx @reader_nodes 0)
    reader_ctx.reader.dn_angles = saved_angles
    reader_ctx.tokens[slot] = opening
    if ((value =? 0) or (not rd_dn_accept(@reader_ctx 'rparen'))) {
        return 0
    }
    let n:int64=node_mk(@reader_nodes (if (name_id not=? 0) 'fn_' else 'lambda') pos)
    reader_nodes[n].name = (if (name_id not=? 0) name_id else int32<overflow='wrap'>(rd_dc_empty_name(@reader_ctx)))
    let p:int64=node_mk(@reader_nodes 'param' pos)
    reader_nodes[p].name = int32<overflow='wrap'>(reader_ctx.reader.dc_partial_name)
    let statement:int64=node_mk(@reader_nodes 'exprstmt' pos)
    reader_nodes[statement].a = int32<overflow='wrap'>(value)
    let body:int64=node_mk(@reader_nodes 'block' pos)
    node_set_list(@reader_nodes @reader_ctx.stores.lists[0] body [statement]);
    reader_ctx.stores.host[0].dw_finish_function(n [p] body (if (name_id not=? 0) rd_name_of(@reader_ctx int64<overflow='wrap'>(name_id)) else ""))
}

# `(*2)`, `(=? limit)`, `(as float64)` after its `(`: a one-parameter lambda whose operand stands
# in place of the parenthesis (dn_partial).
# (a partial application opens at `at`, `(*2)`)
rd_dc_partial_at=(@reader_ctx:ParserContext at:int64):>bool=>$unsafe {
    let after:DewyToken=reader_ctx.tokens[(int64<overflow='wrap'>(at) + 1)].symbol
    ((reader_ctx.tokens[at].symbol =? 'lparen') and (dn_partial_operator(after) or ((after =? 'kw_not') and (dn_token_invert(reader_ctx.tokens[(int64<overflow='wrap'>(at) + 2)].symbol) not=? 'none'))))
}

# A name binds (`_` nothing), `name:T` tests a type, `<literal>` a value (dw_pattern).
rd_dc_pattern=(@reader_ctx:ParserContext @reader_nodes:array<Node>):>int64=>$unsafe {
    let token:DewyLexeme=reader_ctx.tokens[reader_ctx.at]
    let pos:int64=rd_mkpos(reader_ctx.file token.start)
    # (`else => ...` inside the braces: dw_pattern's mistake, noted; read as `_`)
    if (((token.symbol =? 'kw_else') and (reader_ctx.tokens[(int64<overflow='wrap'>(reader_ctx.at) + 1)].symbol =? 'function')) and reader_ctx.flags.report_now) {
        rd_dc_report(@reader_ctx pos "`else` follows the arms, outside the braces: `match v \{...} else ...`; as an arm, `_ => ...` matches everything left");
        reader_ctx.at = (int64<overflow='wrap'>(reader_ctx.at) + 1)
        return node_mk(@reader_nodes 'pwild' pos)
    }
    if (token.symbol =? 'langle') {
        reader_ctx.at = (int64<overflow='wrap'>(reader_ctx.at) + 1)
        let literal:DewyLexeme=reader_ctx.tokens[reader_ctx.at]
        # `<b'x'>`: a byte (dw_byte_char)
        let quote:DewyLexeme=reader_ctx.tokens[(int64<overflow='wrap'>(reader_ctx.at) + 1)]
        if (((((literal.kind =? 'identifier') and (literal.symbol =? 'none')) and (rd_dc_word(@reader_ctx int64<overflow='wrap'>(literal.name)) =? DC_B)) and (quote.kind =? 'quoted')) and (not quote.space)) {
            if (((reader_ctx.source as array<uint8>)[quote.start] not=? b'\'') or (not rd_dc_plain_quote(@reader_ctx quote))) {
                return 0
            }
            let text:int64=rd_dn_string(@reader_ctx @reader_nodes quote)
            if ((text =? 0) or ((rd_name_of(@reader_ctx int64<overflow='wrap'>(reader_nodes[text].sval)) as array<uint8>).length not=? 1)) {
                return 0
            }
            reader_ctx.at = (int64<overflow='wrap'>(reader_ctx.at) + 2)
            if (not rd_dn_accept(@reader_ctx 'rangle')) {
                return 0
            }
            let p:int64=node_mk(@reader_nodes 'plit' pos)
            reader_nodes[p].a = int32<overflow='wrap'>(rd_bc_int(@reader_nodes int64<overflow='wrap'>((rd_name_of(@reader_ctx int64<overflow='wrap'>(reader_nodes[text].sval)) as array<uint8>)[0]) pos))
            return p
        }
        # `<Busy>`, `<int64|string>`, `<'e'|'w'>`: a type (dw_pattern's `<>`)
        if ((((literal.kind =? 'identifier') and (literal.symbol =? 'none')) and (int64<overflow='wrap'>(literal.name) not=? reader_ctx.reader.dn_none_id)) or ((literal.kind =? 'quoted') and (reader_ctx.tokens[(int64<overflow='wrap'>(reader_ctx.at) + 1)].symbol =? 'pipe'))) {
            reader_ctx.reader.dc_type_args = (int64<overflow='wrap'>(reader_ctx.reader.dc_type_args) + 1)
            let t:int64=rd_dc_annotation(@reader_ctx @reader_nodes)
            reader_ctx.reader.dc_type_args = (int64<overflow='wrap'>(reader_ctx.reader.dc_type_args) - 1)
            if (t =? 0) {
                return 0
            }
            if (not rd_dn_accept(@reader_ctx 'rangle')) {
                if (not (reader_ctx.reader.dn_edits_on and rd_dn_closer_joined(@reader_ctx))) {
                    return 0
                }
                rd_dn_split_closer(@reader_ctx);
            }
            let p:int64=node_mk(@reader_nodes 'ptype' pos)
            reader_nodes[p].a = int32<overflow='wrap'>(t)
            return p
        }
        # `<0|1|2>`, `<-1|1>`: integer singletons, a type (dw_literal_type)
        let leaf:int64=rd_dc_int_leaf(@reader_ctx reader_ctx.at)
        if ((leaf >? 0) and (reader_ctx.tokens[(int64<overflow='wrap'>(reader_ctx.at) + int64<overflow='wrap'>(leaf))].symbol =? 'pipe')) {
            reader_ctx.reader.dc_type_args = (int64<overflow='wrap'>(reader_ctx.reader.dc_type_args) + 1)
            let t:int64=rd_dc_annotation(@reader_ctx @reader_nodes)
            reader_ctx.reader.dc_type_args = (int64<overflow='wrap'>(reader_ctx.reader.dc_type_args) - 1)
            if (t =? 0) {
                return 0
            }
            if (not rd_dn_accept(@reader_ctx 'rangle')) {
                if (not (reader_ctx.reader.dn_edits_on and rd_dn_closer_joined(@reader_ctx))) {
                    return 0
                }
                rd_dn_split_closer(@reader_ctx);
            }
            let p:int64=node_mk(@reader_nodes 'ptype' pos)
            reader_nodes[p].a = int32<overflow='wrap'>(t)
            return p
        }
        let negative:bool=(literal.symbol =? 'minus')
        if negative {
            literal = reader_ctx.tokens[(int64<overflow='wrap'>(reader_ctx.at) + 1)]
        }
        let integer:bool=((literal.kind =? 'source_integer') or (literal.kind =? 'integer'))
        if ((not integer) and (negative or (not (((literal.kind =? 'boolean') or (((literal.kind =? 'identifier') and (literal.symbol =? 'none')) and (int64<overflow='wrap'>(literal.name) =? reader_ctx.reader.dn_none_id))) or ((literal.kind =? 'quoted') and rd_dc_plain_quote(@reader_ctx literal)))))) {
            return 0
        }
        let before:int64=reader_ctx.at
        reader_ctx.reader.dn_angles = (int64<overflow='wrap'>(reader_ctx.reader.dn_angles) + 1)
        let value:int64=rd_dc_expr(@reader_ctx @reader_nodes 0)
        reader_ctx.reader.dn_angles = (int64<overflow='wrap'>(reader_ctx.reader.dn_angles) - 1)
        if (((value =? 0) or (reader_ctx.at not=? (int64<overflow='wrap'>(before) + int64<overflow='wrap'>((if negative int64(2) else int64(1)))))) or (not rd_dn_accept(@reader_ctx 'rangle'))) {
            return 0
        }
        let p:int64=node_mk(@reader_nodes 'plit' pos)
        reader_nodes[p].a = int32<overflow='wrap'>(value)
        return p
    }
    # `[sign:1 limbs]`: an object's shape, each part a named field; `(a b)`: a sequence of two or more
    if ((token.symbol =? 'lbrack') or (token.symbol =? 'lparen')) {
        let shape:bool=(token.symbol =? 'lbrack')
        let close:DewyToken='rparen'
        if shape {
            close = 'rbrack'
        }
        reader_ctx.at = (int64<overflow='wrap'>(reader_ctx.at) + 1)
        let parts:array<int64>=[]
        loop (not rd_dn_accept(@reader_ctx close)) {
            if (reader_ctx.tokens[reader_ctx.at].kind =? 'eof') {
                return 0
            }
            let saved_part:bool=reader_ctx.reader.dc_sequence_part
            reader_ctx.reader.dc_sequence_part = (not shape)
            let part:int64=rd_dc_pattern(@reader_ctx @reader_nodes)
            reader_ctx.reader.dc_sequence_part = saved_part
            if ((part =? 0) or (shape and (reader_nodes[part].name =? 0))) {
                return 0
            }
            parts.push(part);
        }
        if ((not shape) and (parts.length <? 2)) {
            return 0
        }
        let p:int64=node_mk(@reader_nodes (if shape 'pshape' else 'pseq') pos)
        node_set_list(@reader_nodes @reader_ctx.stores.lists[0] p parts);
        return p
    }
    if ((token.kind not=? 'identifier') or ((token.symbol not=? 'none') and (token.symbol not=? 'kw_test'))) {
        return 0
    }
    # (`none => 2`: dw_pattern_names' mistake, should nothing else read it)
    if rd_dn_reserved(@reader_ctx int64<overflow='wrap'>(token.name)) {
        return rd_dc_hint(@reader_ctx pos rd_dewy_reserved_text(rd_dn_payload(@reader_ctx token)))
    }
    reader_ctx.at = (int64<overflow='wrap'>(reader_ctx.at) + 1)
    let named:bool=(rd_dc_word(@reader_ctx int64<overflow='wrap'>(token.name)) not=? DC_HOLE)
    if (not rd_dn_accept(@reader_ctx 'colon')) {
        let p:int64=node_mk(@reader_nodes 'pwild' pos)
        if named {
            reader_nodes[p].name = token.name
        }
        return p
    }
    let written:DewyLexeme=reader_ctx.tokens[reader_ctx.at]
    # `answer:42`, `s:"yes"`, `x:none`: one literal, a value (dw_pattern's literal); `n:1|2`,
    # `other:'e'|'w'`: literals joined, a type
    let leaf:int64=rd_dc_int_leaf(@reader_ctx reader_ctx.at)
    if ((leaf =? 0) and (((written.kind =? 'boolean') or ((written.kind =? 'quoted') and rd_dc_plain_quote(@reader_ctx written))) or ((written.kind =? 'identifier') and (int64<overflow='wrap'>(written.name) =? reader_ctx.reader.dn_none_id)))) {
        leaf = 1
    }
    if ((leaf >? 0) and (reader_ctx.tokens[(int64<overflow='wrap'>(reader_ctx.at) + int64<overflow='wrap'>(leaf))].symbol not=? 'pipe')) {
        let before:int64=reader_ctx.at
        let value:int64=rd_dc_atom(@reader_ctx @reader_nodes)
        if ((value =? 0) or (reader_ctx.at not=? (int64<overflow='wrap'>(before) + int64<overflow='wrap'>(leaf)))) {
            return 0
        }
        let p:int64=node_mk(@reader_nodes 'plit' pos)
        reader_nodes[p].a = int32<overflow='wrap'>(value)
        if named {
            reader_nodes[p].name = token.name
        }
        return p
    }
    if (((leaf =? 0) and (written.symbol not=? 'lbrack')) and (((written.kind not=? 'identifier') or (written.symbol not=? 'none')) or (int64<overflow='wrap'>(written.name) =? reader_ctx.reader.dn_none_id))) {
        return 0
    }
    let outer:int64=reader_ctx.reader.dc_pattern_binder
    if named {
        reader_ctx.reader.dc_pattern_binder = int64<overflow='wrap'>(token.name)
    }
    let t:int64=rd_dc_annotation(@reader_ctx @reader_nodes 45)
    reader_ctx.reader.dc_pattern_binder = outer
    if (t =? 0) {
        return 0
    }
    let p:int64=node_mk(@reader_nodes 'ptype' pos)
    reader_nodes[p].a = int32<overflow='wrap'>(t)
    if named {
        reader_nodes[p].name = token.name
    }
    p
}

# `x |> f`, `f <| x` at the operator: the value supplied to the callable (dw_expr's pipes).
rd_dc_pipe=(@reader_ctx:ParserContext @reader_nodes:array<Node> op:DewyToken left:int64 power:int64 pos:int64):>int64=>$unsafe {
    reader_ctx.at = (int64<overflow='wrap'>(reader_ctx.at) + 1)
    let right:int64=rd_dc_expr(@reader_ctx @reader_nodes (if dn_right_associative(op) power else (int64<overflow='wrap'>(power) + 1)))
    if (right =? 0) {
        return 0
    }
    let n:int64=node_mk(@reader_nodes 'call' pos)
    let callee:int64=right
    let supplied:int64=left
    if (op =? 'pipe_left') {
        callee = left
        supplied = right
    }
    reader_nodes[n].a = int32<overflow='wrap'>(callee)
    node_set_list(@reader_nodes @reader_ctx.stores.lists[0] n [supplied]);
    n
}

rd_dc_plain_operand=(@reader_nodes:array<Node> n:int64):>bool=>$unsafe {
    let k:NK=reader_nodes[n].kind
    if ((((k =? 'ident') or (k =? 'none_lit')) or (k =? 'bool_lit')) or (k =? 'float_lit')) {
        return true
    }
    if (k =? 'int_lit') {
        return (reader_nodes[n].aux2 =? 0)
    }
    # (an exact integer literal)
    if (k =? 'call') {
        return (reader_nodes[n].aux2 =? (-1))
    }
    ((k =? 'field') and rd_dc_plain_operand(@reader_nodes int64<overflow='wrap'>(reader_nodes[n].a)))
}

# A quoted literal without interpolation.
rd_dc_plain_quote=(@reader_ctx:ParserContext token:DewyLexeme):>bool=>$unsafe {
    let source:string=reader_ctx.source
    let i:int64=token.start
    loop (i <? token.stop) {
        let c:uint8=(source as array<uint8>)[i]
        if (c =? b'\{') {
            return false
        }
        # (`'\{'`: an escaped brace opens nothing)
        if (c =? b'\\') {
            i = (int64<overflow='wrap'>(i) + 1)
        }
        i = (int64<overflow='wrap'>(i) + 1)
    }
    true
}

rd_dc_policy=(@reader_ctx:ParserContext token:DewyLexeme):>int64=>$unsafe {
    if (token.kind not=? 'quoted') {
        return 0
    }
    let source:string=reader_ctx.source
    let quote:uint8=(source as array<uint8>)[token.start]
    if (((quote not=? b'\'') and (quote not=? b'"')) or ((source as array<uint8>)[(int64<overflow='wrap'>(token.stop) - 1)] not=? quote)) {
        return 0
    }
    let width:int64=(int64<overflow='wrap'>((int64<overflow='wrap'>(token.stop) - int64<overflow='wrap'>(token.start))) - 2)
    if ((width =? 4) and rd_dn_matches((source as array<uint8>).ptr (int64<overflow='wrap'>(token.start) + 1) token.stop "wrap")) {
        return 1
    }
    if ((width =? 8) and rd_dn_matches((source as array<uint8>).ptr (int64<overflow='wrap'>(token.start) + 1) token.stop "saturate")) {
        return 2
    }
    0
}

# `'wrap'` 1, `'saturate'` 2, as an overflow policy is written (anything else 0)
rd_dc_policy_mistake=(@reader_ctx:ParserContext policy:int64):>int64=>$unsafe {
    let at:int64=rd_mkpos(reader_ctx.file reader_ctx.tokens[(int64<overflow='wrap'>(reader_ctx.at) - 2)].start)
    if (policy =? 0) {
        let token:DewyLexeme=reader_ctx.tokens[reader_ctx.at]
        if (token.kind not=? 'quoted') {
            return rd_dc_hint(@reader_ctx at "an overflow policy is a quoted name: use 'wrap' or 'saturate'")
        }
        let written:string=reader_ctx.stores.host[0].bytes_slice(reader_ctx.source token.start token.stop)
        return rd_dc_hint(@reader_ctx at "unknown overflow policy {written}; use 'wrap' or 'saturate'")
    }
    rd_dc_hint(@reader_ctx at "an integer type takes one overflow policy; remove the second `overflow=...`")
}

# `<overflow='wrap'>` is next, after the type's name.
rd_dc_policy_only=(@reader_ctx:ParserContext):>bool=>$unsafe {
    let at:int64=(int64<overflow='wrap'>(reader_ctx.at) + 2)
    if ((int64<overflow='wrap'>(at) + 3) >=? reader_ctx.tokens.length) {
        return false
    }
    let setting:DewyLexeme=reader_ctx.tokens[at]
    if (((setting.kind not=? 'identifier') or (setting.symbol not=? 'none')) or (rd_dc_word(@reader_ctx int64<overflow='wrap'>(setting.name)) not=? DC_OVERFLOW)) {
        return false
    }
    (((reader_ctx.tokens[(int64<overflow='wrap'>(at) + 1)].symbol =? 'assign') and (rd_dc_policy(@reader_ctx reader_ctx.tokens[(int64<overflow='wrap'>(at) + 2)]) not=? 0)) and (reader_ctx.tokens[(int64<overflow='wrap'>(at) + 3)].symbol =? 'rangle'))
}

# A value whose discarding does nothing (dw_pure): a literal, a name, or arithmetic of them.
rd_dc_pure=(@reader_nodes:array<Node> n:int64):>bool=>$unsafe {
    let k:NK=reader_nodes[n].kind
    if ((((k =? 'ident') or (k =? 'int_lit')) or (k =? 'float_lit')) or (k =? 'bool_lit')) {
        return true
    }
    if (k =? 'str_lit') {
        return (rd_nkids(@reader_nodes n) =? 0)
    }
    if (k =? 'unary') {
        return ((not rd_has_flag(@reader_nodes n NF_BROADCAST)) and rd_dc_pure(@reader_nodes int64<overflow='wrap'>(reader_nodes[n].a)))
    }
    if ((k not=? 'binary') or rd_has_flag(@reader_nodes n NF_BROADCAST)) {
        return false
    }
    let op:int32=reader_nodes[n].op
    (((((((op =? int32<overflow='wrap'>(int64<overflow='wrap'>(int64(58)))) or (op =? int32<overflow='wrap'>(int64<overflow='wrap'>(int64(59))))) or (op =? int32<overflow='wrap'>(int64<overflow='wrap'>(int64(60))))) or (op =? int32<overflow='wrap'>(int64<overflow='wrap'>(int64(61))))) or (op =? int32<overflow='wrap'>(int64<overflow='wrap'>(int64(65))))) and rd_dc_pure(@reader_nodes int64<overflow='wrap'>(reader_nodes[n].a))) and rd_dc_pure(@reader_nodes int64<overflow='wrap'>(reader_nodes[n].b)))
}

# Pure values an attached `;` discards, where each is written: dw_discard_check's warning, or its
# mistake among rows (false).
rd_dc_pure_discards=(@reader_ctx:ParserContext pure_at:array<int64> rows:bool):>bool=>$unsafe {
    if rows {
        rd_dc_fail_now(@reader_ctx pure_at[0] "this `;` is attached to the value before it, which discards that value and does nothing here: {reader_ctx.stores.host[0].g_DW_ROW_HINT()}");
        return false
    }
    loop at in pure_at {
        reader_ctx.stores.host[0].warn(at "this `;` is attached to the value before it, which discards that value, so `[1 2; 3 4]` is `[1 3 4]`: {reader_ctx.stores.host[0].g_DW_ROW_HINT()}; to drop the value, leave it out");
    }
    true
}

# `accumulator.push(value)`
rd_dc_push=(@reader_ctx:ParserContext @reader_nodes:array<Node> accumulator:int64 value:int64 pos:int64):>int64=>$unsafe {
    dr_push(@reader_nodes @reader_ctx.stores.lists[0] @reader_ctx.stores.builder[0] accumulator value pos)
}

rd_dc_quoted_next=(@reader_ctx:ParserContext at:int64):>bool=>$unsafe {
    ((reader_ctx.tokens[at].kind =? 'quoted') or (reader_ctx.tokens[at].kind =? 'rawquoted'))
}

rd_dc_ragged=(@reader_ctx:ParserContext level:int64 size:int64 first:int64 pos:int64):>void=>$unsafe {
    let what:string=(if (level =? 1) "rows" else (if (level =? 2) "blocks" else "parts"))
    let unit:string=(if (level =? 1) "elements" else (if (level =? 2) "rows" else "parts"))
    rd_dc_report(@reader_ctx pos "the {what} of an array literal must have the same size: this one has {size} {unit}, the first has {first}");
}

# A loop's range from its first bound; `bracketed`, after `[` or `(`, through its closer. 0 when
# what is here is no range (then dc_range_first holds the value read, ending at dc_range_at),
# or with dc_parser.at -1 when it is a range the direct grammar does not take.
rd_dc_range=(@reader_ctx:ParserContext @reader_nodes:array<Node> bracketed:bool value:bool=false open:bool=false):>int64=>$unsafe {
    let grouped:bool=(bracketed and (reader_ctx.tokens[(int64<overflow='wrap'>(reader_ctx.at) - 1)].symbol =? 'lparen'))
    let pos:int64=rd_mkpos(reader_ctx.file reader_ctx.tokens[reader_ctx.at].start)
    reader_ctx.reader.dc_range_first = 0
    let first:int64=0
    let second:int64=0
    if ((open or (((value and reader_ctx.flags.report_now) and (rd_dn_peek(@reader_ctx) =? 'range')) and dn_range_bound(@reader_ctx.tokens (int64<overflow='wrap'>(reader_ctx.at) + 1)))) and rd_dn_accept(@reader_ctx 'range')) {
        # (`x in? [..b]`: a membership's range may be open, dw_iterable's slice; a stored one,
        # dc_stored_open's mistake)
        first = 0
    }
    else {
        if (rd_dn_peek(@reader_ctx) =? 'range') {
            return rd_dc_range_fail(@reader_ctx)
        }
        # (`(+ 1)`: a partial application, dn_partial)
        if (grouped and (dn_partial_operator(rd_dn_peek(@reader_ctx)) or (rd_dn_peek(@reader_ctx) =? 'kw_not'))) {
            return rd_dc_range_fail(@reader_ctx)
        }
        # (`[m.keys...]`: a spread element, so the brackets hold a value)
        let saved_spread:int64=reader_ctx.reader.dc_spread_depth
        if bracketed {
            reader_ctx.reader.dc_spread_depth = (int64<overflow='wrap'>(reader_ctx.depth) + 1)
        }
        first = rd_dc_expr(@reader_ctx @reader_nodes 106)
        reader_ctx.reader.dc_spread_depth = saved_spread
        if (first =? 0) {
            return rd_dc_range_fail(@reader_ctx)
        }
        if rd_has_flag(@reader_nodes first NF_SPREAD) {
            reader_ctx.reader.dc_range_first = first
            reader_ctx.reader.dc_range_at = reader_ctx.at
            return 0
        }
        if rd_dn_accept(@reader_ctx 'comma') {
            second = rd_dc_expr(@reader_ctx @reader_nodes 106)
            if (second =? 0) {
                return rd_dc_range_fail(@reader_ctx)
            }
            # (`[0,1,2..5]` iterated: dw_iterable's mistake, noted)
            if (((rd_dn_peek(@reader_ctx) =? 'comma') and (not value)) and reader_ctx.flags.report_now) {
                rd_dc_stepped_arity(@reader_ctx @reader_nodes pos);
            }
            # (`[0,1,2..5]` as a value: dw_range_value's mistake, should nothing else read it)
            if (rd_dn_peek(@reader_ctx) =? 'comma') {
                rd_dc_hint(@reader_ctx pos "Dewy does not yet support a stepped range without exactly two starting values");
            }
            if (rd_dn_peek(@reader_ctx) not=? 'range') {
                return rd_dc_range_fail(@reader_ctx)
            }
        }
        if (not rd_dn_accept(@reader_ctx 'range')) {
            reader_ctx.reader.dc_range_first = first
            reader_ctx.reader.dc_range_at = reader_ctx.at
            return 0
        }
    }
    let last:int64=0
    if dn_range_bound(@reader_ctx.tokens reader_ctx.at) {
        last = rd_dc_expr(@reader_ctx @reader_nodes 101)
        if (last =? 0) {
            return rd_dc_range_fail(@reader_ctx)
        }
    }
    let inclusive:bool=true
    if bracketed {
        if rd_dn_accept(@reader_ctx 'rbrack') {
            inclusive = true
        }
        else if rd_dn_accept(@reader_ctx 'rparen') {
            inclusive = false
        }
        else if (((not grouped) and ((rd_dn_peek(@reader_ctx) =? 'kw_as') or (rd_dn_peek(@reader_ctx) =? 'kw_transmute'))) and reader_ctx.flags.report_now) {
            return rd_dc_range_cast(@reader_ctx @reader_nodes)
        }
        else {
            return rd_dc_range_fail(@reader_ctx)
        }
        if value {
            let n:int64=node_mk(@reader_nodes 'range' pos)
            # (`[..]`: the whole range, no bound to include)
            if ((first =? 0) and (last =? 0)) {
                return n
            }
            reader_nodes[n].a = int32<overflow='wrap'>(first)
            reader_nodes[n].b = int32<overflow='wrap'>(last)
            if (second not=? 0) {
                reader_nodes[n].c = int32<overflow='wrap'>(second)
                rd_add_flag(@reader_nodes n NF_STEP);
            }
            if inclusive {
                rd_add_flag(@reader_nodes n NF_INCLUSIVE);
            }
            if grouped {
                rd_add_flag(@reader_nodes n NF_EXCL_FIRST);
            }
            return n
        }
        # (`[0..n).reversed()`: the brackets are a value the expression goes on with)
        let after:DewyToken=reader_ctx.tokens[reader_ctx.at].symbol
        if ((((after =? 'dot') or (after =? 'question')) or (after =? 'ellipsis')) or ((not reader_ctx.tokens[reader_ctx.at].space) and (((((after =? 'lparen') or (after =? 'lbrack')) or (after =? 'langle')) or (reader_ctx.tokens[reader_ctx.at].kind =? 'quoted')) or (reader_ctx.tokens[reader_ctx.at].kind =? 'rawquoted')))) {
            return rd_dc_range_fail(@reader_ctx)
        }
    }
    if (((rd_dn_peek(@reader_ctx) not=? 'lbrace') and (dn_power(rd_dn_peek(@reader_ctx)) >=? 96)) and (not rd_dc_signed_next(@reader_ctx))) {
        return rd_dc_range_fail(@reader_ctx)
    }
    let n:int64=node_mk(@reader_nodes 'range' pos)
    reader_nodes[n].a = int32<overflow='wrap'>(first)
    reader_nodes[n].b = int32<overflow='wrap'>(last)
    if (second not=? 0) {
        reader_nodes[n].c = int32<overflow='wrap'>(second)
        rd_add_flag(@reader_nodes n NF_STEP);
    }
    if inclusive {
        rd_add_flag(@reader_nodes n NF_INCLUSIVE);
    }
    if grouped {
        rd_add_flag(@reader_nodes n NF_EXCL_FIRST);
        return rd_bc_call(@reader_ctx @reader_nodes "__dewy_iter" [reader_ctx.stores.host[0].dw_range_value(n)] pos)
    }
    n
}

# A bracketed range at dc_parser.at (after its opener), as dc_atom reads one: its value, or in a
# membership the range itself; -1 when the brackets hold no range (nothing read).
rd_dc_range_atom=(@reader_ctx:ParserContext @reader_nodes:array<Node>):>int64=>$unsafe {
    let start:int64=reader_ctx.at
    let node_start:int64=reader_nodes.length
    let list_start:int64=reader_ctx.stores.lists[0].length
    let edits:int64=reader_ctx.reader.dn_edit_at.length
    let member:bool=(reader_ctx.reader.dc_member_depth =? reader_ctx.depth)
    let axis:bool=(reader_ctx.reader.dc_axis_depth =? reader_ctx.depth)
    let range:int64=rd_dc_range(@reader_ctx @reader_nodes true true (member or axis))
    if (reader_ctx.at <? 0) {
        return 0
    }
    if (range not=? 0) {
        # (`[1..]`: a slice's or a loop's, not a value: dewy_range_value reports it; an axis among
        # several takes it as a slice, dw_iterable)
        if ((reader_nodes[range].a =? 0) or (reader_nodes[range].b =? 0)) {
            # (dewy_range_value's mistake, noted)
            if ((not axis) and ((not member) or rd_has_flag(@reader_nodes range NF_EXCL_FIRST))) {
                return rd_dc_stored_open(@reader_ctx @reader_nodes range)
            }
            if axis {
                reader_ctx.reader.dc_open_axes = (int64<overflow='wrap'>(reader_ctx.reader.dc_open_axes) + 1)
            }
            reader_ctx.reader.dc_range_call = range
            reader_ctx.reader.dc_range_node = range
            return range
        }
        let value:int64=reader_ctx.stores.host[0].dw_range_value(range)
        reader_ctx.reader.dc_range_call = value
        reader_ctx.reader.dc_range_node = range
        return value
    }
    reader_ctx.at = start
    reader_nodes.truncate(node_start);
    reader_ctx.stores.lists[0].truncate(list_start);
    rd_dn_edits_undo(@reader_ctx edits);
    (-1)
}

# `[0..n as int64)` at `as` (dn_block's mistake, at once): `as` converts the whole range, then `)`.
rd_dc_range_cast=(@reader_ctx:ParserContext @reader_nodes:array<Node>):>int64=>$unsafe {
    let op:DewyToken=rd_dn_take(@reader_ctx).symbol
    if ((rd_dc_cast_type(@reader_ctx @reader_nodes (op =? 'kw_as') dn_power(op)) =? 0) or (rd_dn_peek(@reader_ctx) not=? 'rparen')) {
        return rd_dc_range_fail(@reader_ctx)
    }
    reader_ctx.stores.host[0].dn_error(reader_ctx.tokens[reader_ctx.at].start "expected an expression, found ')': `{dn_token_text(op)}` binds more loosely than `..`, so here it converts the whole range; parenthesize the bound, as in `[0..(n as int64))`")
}

rd_dc_range_fail=(@reader_ctx:ParserContext):>int64=>$unsafe {
    reader_ctx.at = (-1)
    0
}

# A `..` follows at `at`'s depth before its group closes: `[0,1,2..5]` is a range of too many starts.
rd_dc_range_follows=(@reader_ctx:ParserContext at:int64):>bool=>$unsafe {
    let depth:int64=0
    let k:int64=at
    loop (reader_ctx.tokens[k].kind not=? 'eof') {
        let t:DewyToken=reader_ctx.tokens[k].symbol
        if ((depth =? 0) and (t =? 'range')) {
            return true
        }
        if (((t =? 'lparen') or (t =? 'lbrack')) or (t =? 'lbrace')) {
            depth = (int64<overflow='wrap'>(depth) + 1)
        }
        if (((t =? 'rparen') or (t =? 'rbrack')) or (t =? 'rbrace')) {
            if (depth =? 0) {
                return false
            }
            depth = (int64<overflow='wrap'>(depth) - 1)
        }
        k = (int64<overflow='wrap'>(k) + 1)
    }
    false
}

# The brackets opening at `at` hold a range at their top: a `..` not inside other brackets.
rd_dc_range_inside=(@reader_ctx:ParserContext at:int64):>bool=>$unsafe {
    let depth:int64=0
    let k:int64=at
    loop (k <? reader_ctx.tokens.length) {
        let t:DewyLexeme=reader_ctx.tokens[k]
        if (t.kind =? 'eof') {
            return false
        }
        let symbol:DewyToken=t.symbol
        if (((symbol =? 'lparen') or (symbol =? 'lbrack')) or (symbol =? 'lbrace')) {
            depth = (int64<overflow='wrap'>(depth) + 1)
        }
        else if (((symbol =? 'rparen') or (symbol =? 'rbrack')) or (symbol =? 'rbrace')) {
            depth = (int64<overflow='wrap'>(depth) - 1)
            if (depth =? 0) {
                return false
            }
        }
        else if ((symbol =? 'range') and (depth =? 1)) {
            return true
        }
        k = (int64<overflow='wrap'>(k) + 1)
    }
    false
}

# Resolve member names in n, as a body's names meet them. False: a
# form this does not follow.
rd_dc_reach=(@reader_ctx:ParserContext @reader_nodes:array<Node> n:int64):>bool=>$unsafe {
    let reader_builder=reader_ctx.stores.builder
    let reader_texts=reader_ctx.stores.texts
    let reader_lists=reader_ctx.stores.lists
    dm_reach(@reader_ctx @reader_nodes @reader_lists[0] @reader_builder[0] @reader_texts[0] n)
}

rd_dc_reach_all=(@reader_ctx:ParserContext @reader_nodes:array<Node> xs:array<int64>):>bool=>$unsafe {
    let reader_builder=reader_ctx.stores.builder
    let reader_texts=reader_ctx.stores.texts
    let reader_lists=reader_ctx.stores.lists
    dm_reach_all(@reader_ctx @reader_nodes @reader_lists[0] @reader_builder[0] @reader_texts[0] xs)
}

rd_dc_reach_flow=(@reader_ctx:ParserContext @reader_nodes:array<Node> n:int64):>bool=>$unsafe {
    let reader_builder=reader_ctx.stores.builder
    let reader_texts=reader_ctx.stores.texts
    let reader_lists=reader_ctx.stores.lists
    dm_reach_flow(@reader_ctx @reader_nodes @reader_lists[0] @reader_builder[0] @reader_texts[0] n)
}

# A function: its result and parameters' types and defaults, its captures, then its body with
# its parameters and captures hiding members (dw_function).
rd_dc_reach_fn=(@reader_ctx:ParserContext @reader_nodes:array<Node> n:int64):>bool=>$unsafe {
    let reader_builder=reader_ctx.stores.builder
    let reader_texts=reader_ctx.stores.texts
    let reader_lists=reader_ctx.stores.lists
    dm_reach_fn(@reader_ctx @reader_nodes @reader_lists[0] @reader_builder[0] @reader_texts[0] n)
}

rd_dc_reach_head=(@reader_ctx:ParserContext @reader_nodes:array<Node> h:int64):>bool=>$unsafe {
    let reader_builder=reader_ctx.stores.builder
    let reader_texts=reader_ctx.stores.texts
    let reader_lists=reader_ctx.stores.lists
    dm_reach_head(@reader_ctx @reader_nodes @reader_lists[0] @reader_builder[0] @reader_texts[0] h)
}

# `binders in source`: the binders hide members in the body, not in the source (dw_loop_head).
rd_dc_reach_in=(@reader_ctx:ParserContext @reader_nodes:array<Node> binders:array<int64> source:int64):>bool=>$unsafe {
    let reader_builder=reader_ctx.stores.builder
    let reader_texts=reader_ctx.stores.texts
    let reader_lists=reader_ctx.stores.lists
    dm_reach_in(@reader_ctx @reader_nodes @reader_lists[0] @reader_builder[0] @reader_texts[0] binders source)
}

rd_dc_reach_match=(@reader_ctx:ParserContext @reader_nodes:array<Node> n:int64):>bool=>$unsafe {
    let reader_builder=reader_ctx.stores.builder
    let reader_texts=reader_ctx.stores.texts
    let reader_lists=reader_ctx.stores.lists
    dm_reach_match(@reader_ctx @reader_nodes @reader_lists[0] @reader_builder[0] @reader_texts[0] n)
}

rd_dc_reach_statement=(@reader_ctx:ParserContext @reader_nodes:array<Node> s:int64):>bool=>$unsafe {
    let reader_builder=reader_ctx.stores.builder
    let reader_texts=reader_ctx.stores.texts
    let reader_lists=reader_ctx.stores.lists
    dm_reach_statement(@reader_ctx @reader_nodes @reader_lists[0] @reader_builder[0] @reader_texts[0] s)
}

rd_dc_reach_statements=(@reader_ctx:ParserContext @reader_nodes:array<Node> block:int64):>bool=>$unsafe {
    let reader_builder=reader_ctx.stores.builder
    let reader_texts=reader_ctx.stores.texts
    let reader_lists=reader_ctx.stores.lists
    dm_reach_statements(@reader_ctx @reader_nodes @reader_lists[0] @reader_builder[0] @reader_texts[0] block)
}

rd_dc_reach_type=(@reader_ctx:ParserContext @reader_nodes:array<Node> t:int64):>bool=>$unsafe {
    let reader_builder=reader_ctx.stores.builder
    let reader_texts=reader_ctx.stores.texts
    let reader_lists=reader_ctx.stores.lists
    dm_reach_type(@reader_ctx @reader_nodes @reader_lists[0] @reader_builder[0] @reader_texts[0] t)
}

rd_dc_record_fields=(@reader_ctx:ParserContext @reader_nodes:array<Node> n:int64 @names:array<int64>):>bool=>$unsafe {
    let fields:array<int64>=[]
    reader_ctx.reader.dc_methods.clear();
    reader_ctx.reader.dc_method_hooks.clear();
    reader_ctx.reader.dc_transfer_bits = 0
    reader_ctx.reader.dc_transfer_at = 0
    let hook:int64=0
    loop (not rd_dn_accept(@reader_ctx 'rbrack')) {
        let first:DewyLexeme=reader_ctx.tokens[reader_ctx.at]
        # (`$send`, `$sync=false`, `$unsafe` among the rows: the type's transfer claims, dw_transfer_row)
        if (((first.kind =? 'metatag') and (hook =? 0)) and rd_dc_transfer_row(@reader_ctx first)) {
            continue
        }
        if (first.kind =? 'metatag') {
            # (`$__drop__`, `$__copy__`, `$__move__` before a method, on the line before it or not)
            let tag:int64=rd_dc_lifecycle_tag(@reader_ctx first)
            let next:DewyLexeme=reader_ctx.tokens[(int64<overflow='wrap'>(reader_ctx.at) + 1)]
            if ((tag not=? 0) and (hook not=? 0)) {
                return rd_dc_record_mistake(@reader_ctx first.start "a lifecycle tag must precede one method")
            }
            if ((tag =? 0) or (not (next.newline or (next.space and (next.kind =? 'identifier'))))) {
                return false
            }
            hook = tag
            reader_ctx.at = (int64<overflow='wrap'>(reader_ctx.at) + 1)
            continue
        }
        let by_place:bool=rd_dn_accept(@reader_ctx 'at')
        let field:DewyLexeme=reader_ctx.tokens[reader_ctx.at]
        if ((field.kind not=? 'identifier') or ((field.symbol not=? 'none') and (field.symbol not=? 'kw_test'))) {
            return false
        }
        # (`[start:int64 end:int64]`: dw_row_names' mistake)
        if (rd_dn_reserved(@reader_ctx int64<overflow='wrap'>(field.name)) and ((reader_ctx.tokens[(int64<overflow='wrap'>(reader_ctx.at) + 1)].symbol =? 'colon') or (reader_ctx.tokens[(int64<overflow='wrap'>(reader_ctx.at) + 1)].symbol =? 'assign'))) {
            rd_dc_reserved_at(@reader_ctx field);
        }
        else if rd_dn_reserved(@reader_ctx int64<overflow='wrap'>(field.name)) {
            return false
        }
        # (`pair = <U>(other:U) => ...`: a generic method, its own type parameters after the type's)
        let generic:bool=((((not by_place) and (reader_ctx.tokens[(int64<overflow='wrap'>(reader_ctx.at) + 1)].symbol =? 'assign')) and (reader_ctx.tokens[(int64<overflow='wrap'>(reader_ctx.at) + 2)].symbol =? 'langle')) and rd_dc_generic_lambda_next_at(@reader_ctx (int64<overflow='wrap'>(reader_ctx.at) + 2)))
        if (generic or ((((not by_place) and (reader_ctx.tokens[(int64<overflow='wrap'>(reader_ctx.at) + 1)].symbol =? 'assign')) and (reader_ctx.tokens[(int64<overflow='wrap'>(reader_ctx.at) + 2)].symbol =? 'lparen')) and rd_dc_lambda_next_at(@reader_ctx (int64<overflow='wrap'>(reader_ctx.at) + 2)))) {
            if (rd_dc_word(@reader_ctx int64<overflow='wrap'>(field.name)) =? DC_MAIN) {
                return rd_dc_record_mistake(@reader_ctx field.start "a method cannot be named main")
            }
            reader_ctx.at = (int64<overflow='wrap'>(reader_ctx.at) + 2)
            let opening:DewyLexeme=reader_ctx.tokens[reader_ctx.at]
            let type_params:array<int64>=[]
            if generic {
                type_params = rd_dc_type_params(@reader_ctx @reader_nodes)
                if (type_params.length =? 0) {
                    return false
                }
            }
            else {
                reader_ctx.at = (int64<overflow='wrap'>(reader_ctx.at) + 1)
            }
            reader_ctx.depth = (int64<overflow='wrap'>(reader_ctx.depth) + 3)
            let saved:bool=reader_ctx.reader.dc_method_body
            reader_ctx.reader.dc_method_body = true
            let method:int64=rd_dc_function_literal(@reader_ctx @reader_nodes field.name opening type_params)
            reader_ctx.reader.dc_method_body = saved
            if ((method =? 0) or (rd_dn_peek(@reader_ctx) =? 'semi')) {
                return false
            }
            reader_ctx.reader.dc_methods.push(method);
            reader_ctx.reader.dc_method_hooks.push(hook);
            hook = 0
            names.push(int64<overflow='wrap'>(field.name));
            continue
        }
        if (hook not=? 0) {
            return rd_dc_record_mistake(@reader_ctx first.start "a lifecycle tag requires a method")
        }
        reader_ctx.at = (int64<overflow='wrap'>(reader_ctx.at) + 1)
        let f:int64=node_mk(@reader_nodes 'vardecl' rd_mkpos(reader_ctx.file first.start))
        reader_nodes[f].name = field.name
        let typed:bool=rd_dn_accept(@reader_ctx 'colon')
        if typed {
            let outer:int64=reader_ctx.reader.dc_pattern_binder
            reader_ctx.reader.dc_pattern_binder = int64<overflow='wrap'>(field.name)
            let annotation:int64=rd_dc_annotation(@reader_ctx @reader_nodes)
            reader_ctx.reader.dc_pattern_binder = outer
            if (annotation =? 0) {
                return false
            }
            reader_nodes[f].a = int32<overflow='wrap'>(annotation)
        }
        if rd_dn_accept(@reader_ctx 'assign') {
            let initial:int64=rd_dc_expr(@reader_ctx @reader_nodes 11)
            # (`speak = () => ...` reads as a method above)
            if ((initial =? 0) or (reader_nodes[initial].kind =? 'lambda')) {
                return false
            }
            reader_nodes[f].b = int32<overflow='wrap'>(initial)
        }
        else if (not typed) {
            return false
        }
        if by_place {
            rd_add_flag(@reader_nodes f NF_MUT);
        }
        fields.push(f);
        names.push(int64<overflow='wrap'>(field.name))
    }
    if (hook not=? 0) {
        return false
    }
    node_set_list(@reader_nodes @reader_ctx.stores.lists[0] n fields);
    true
}

# A record comprehension's loops, each one binder, down to its one row (dw_record_loop); 0 for a
# shape is left unread (dc_unread).
rd_dc_record_loop=(@reader_ctx:ParserContext @reader_nodes:array<Node> n:int64):>int64=>$unsafe {
    let k:NK=reader_nodes[n].kind
    if (k =? 'for_') {
        if ((((rd_nkids(@reader_nodes n) not=? 1) or (reader_nodes[rd_kid(@reader_ctx @reader_nodes n 0)].kind not=? 'ident')) or (reader_nodes[n].c not=? 0)) or rd_has_flag(@reader_nodes n NF_MUT)) {
            return 0
        }
        let body:int64=rd_dc_record_loop(@reader_ctx @reader_nodes int64<overflow='wrap'>(reader_nodes[n].b))
        if (body =? 0) {
            return 0
        }
        let loop_:int64=node_mk(@reader_nodes 'record_loop' reader_nodes[n].pos)
        reader_nodes[loop_].a = reader_nodes[n].a
        reader_nodes[loop_].name = reader_nodes[rd_kid(@reader_ctx @reader_nodes n 0)].name
        reader_nodes[loop_].b = int32<overflow='wrap'>(body)
        return loop_
    }
    if (k =? 'block') {
        if (rd_nkids(@reader_nodes n) not=? 1) {
            return 0
        }
        return rd_dc_record_loop(@reader_ctx @reader_nodes rd_kid(@reader_ctx @reader_nodes n 0))
    }
    if ((k =? 'exprstmt') and (reader_nodes[int64<overflow='wrap'>(reader_nodes[n].a)].kind =? 'namedarg')) {
        return int64<overflow='wrap'>(reader_nodes[n].a)
    }
    0
}

# What dw_type_methods records for a declared type: its rows' names (a parent's members are
# inherited), and the methods dc_record_fields read, each a module function taking the object
# first, its bare member names read through that receiver. False: a form left unread
# (methods of a type whose members are known only later, a name the frontend renames).
rd_dc_record_members=(@reader_ctx:ParserContext @reader_nodes:array<Node> struct_:int64 names:array<int64>):>bool=>$unsafe {
    if reader_ctx.reader.dc_local_type_on {
        return rd_dc_local_members(@reader_ctx @reader_nodes)
    }
    let receiver:int64=reader_ctx.stores.host[0].intern("$self")
    let file:int64=rd_pos_file(reader_nodes[struct_].pos)
    let types_here:dict<int64 dict<int64 int64>>=(reader_ctx.stores.host[0].g_dw_type_members_get(file) ?? [])
    let inherited:dict<int64 int64>=[]
    let parent:int64=int64<overflow='wrap'>(reader_nodes[struct_].a)
    let deferred:bool=false
    if ((parent not=? 0) and (reader_nodes[parent].kind =? 'tname')) {
        let parent_name:int64=int64<overflow='wrap'>(reader_nodes[parent].name)
        let known:dict<int64 int64>?=types_here.get(parent_name)
        if known isnt? none {
            inherited = known
            deferred = reader_ctx.stores.host[0].dewy_deferred_here(file parent_name)
        }
        else {
            deferred = (rd_name_of(@reader_ctx parent_name) not in? ["error" "exception" "any"])
        }
    }
    else if (parent not=? 0) {
        deferred = true
    }
    let methods:array<int64>=reader_ctx.reader.dc_methods
    let hooks:array<int64>=reader_ctx.reader.dc_method_hooks
    reader_ctx.reader.dc_methods = []
    reader_ctx.reader.dc_method_hooks = []
    let members:dict<int64 int64>=[]
    if (methods.length >? 0) {
        loop [name member] in inherited {
            members[name] = receiver
        }
        # (with members still unknown, inherited from another module or a later type, the other
        # names wait for them, dewy_defer_name)
        if deferred {
            members[reader_ctx.stores.host[0].dewy_inherited_key()] = struct_
        }
        loop name in names {
            if (rd_name_of(@reader_ctx name) in? ["printl" "print" "int" "bigint" "__dewy_print" "__dewy_int"]) {
                return false
            }
            members[name] = receiver
        }
        loop method in methods {
            loop other in node_kids(@reader_nodes @reader_ctx.stores.lists[0] struct_) {
                if (reader_nodes[other].name =? reader_nodes[method].name) {
                    return rd_dc_field_and_method(@reader_ctx @reader_nodes struct_ method)
                }
            }
        }
        # (every method resolves before any is finished: a retry undoes the nodes only)
        reader_ctx.reach.waiting.clear();
        reader_ctx.reach.waiting_names.clear();
        reader_ctx.reach.waiting_callees.clear();
        loop method in methods {
            reader_ctx.reach.scope = members
            let reached:bool=rd_dc_reach_fn(@reader_ctx @reader_nodes method)
            reader_ctx.reach.scope = []
            if (not reached) {
                return false
            }
        }
    }
    if deferred {
        reader_ctx.stores.host[0].dewy_defer_type(struct_ file);
    }
    loop i in 0.. and waiting in reader_ctx.reach.waiting {
        reader_ctx.stores.host[0].dewy_defer_name(struct_ waiting reader_ctx.reach.waiting_names[i]);
    }
    loop callee in reader_ctx.reach.waiting_callees {
        reader_ctx.stores.host[0].dewy_defer_callee(callee);
    }
    reader_ctx.reach.waiting.clear();
    reader_ctx.reach.waiting_names.clear();
    reader_ctx.reach.waiting_callees.clear();
    let decls:array<int64>=[]
    let extra_names:array<int64>=[]
    let extra_decls:array<int64>=[]
    let made:array<int64>=[struct_]
    let k:int64=0
    loop name in names {
        if ((k <? methods.length) and (reader_nodes[methods[k]].name =? int32<overflow='wrap'>(name))) {
            let method:int64=methods[k]
            let label:string=rd_name_of(@reader_ctx name)
            let lent:array<int64>=reader_ctx.stores.host[0].place_method_split(method receiver label)
            reader_ctx.stores.host[0].dw_method_finish(method struct_ node_kids2(@reader_nodes @reader_ctx.stores.lists[0] struct_) receiver);
            if (hooks[k] not=? 0) {
                reader_ctx.stores.host[0].ownership_declare(struct_ method hooks[k]);
            }
            made.push(method);
            decls.push(method);
            loop extra in lent {
                reader_ctx.stores.host[0].dw_method_finish(extra struct_ node_kids2(@reader_nodes @reader_ctx.stores.lists[0] struct_) receiver);
                made.push(extra);
                extra_names.push(int64<overflow='wrap'>(reader_nodes[extra].name));
                extra_decls.push(extra);
            }
            k = (int64<overflow='wrap'>(k) + 1)
        }
        else {
            decls.push(0);
        }
    }
    let row_names:array<int64>=names
    loop i in [0..extra_names.length) {
        row_names.push(extra_names[i]);
        decls.push(extra_decls[i]);
    }
    let first:int64=reader_ctx.stores.host[0].g_dewy_methods_len()
    let group:dict<int64 int64>=reader_ctx.stores.host[0].dewy_method_group(row_names decls inherited)
    reader_ctx.stores.host[0].g_dewy_decl_members_item_set(struct_ group)
    reader_ctx.stores.host[0].g_dewy_decl_methods_item_set(struct_ [first reader_ctx.stores.host[0].g_dewy_methods_len()])
    types_here[int64<overflow='wrap'>(reader_nodes[struct_].name)] = group
    reader_ctx.stores.host[0].g_dw_type_members_item_set(file types_here)
    if (methods.length >? 0) {
        reader_ctx.stores.host[0].g_dewy_type_members_item_set(struct_ group)
        reader_ctx.reader.dc_made = made
    }
    true
}

# A record type's rows after its `[`, through its `]` (dw_param of each field): its fields, the
# rows' names in order; methods (`name = (params) => body`, a lifecycle tag before one) wait in
# dc_methods for dc_record_members. Transfer rows and other tags are left unread (dc_unread).
# (dw_record_type's mistakes, should nothing else read the type)
rd_dc_record_mistake=(@reader_ctx:ParserContext at:int64 msg:string):>bool=>$unsafe {
    rd_dc_hint(@reader_ctx rd_mkpos(reader_ctx.file at) msg);
    false
}

# A comprehension's last value is a computed row (dw_collection_kind 3).
rd_dc_record_tail=(@reader_ctx:ParserContext @reader_nodes:array<Node> n:int64):>bool=>$unsafe {
    let last:int64=rd_dc_tail_value(@reader_ctx @reader_nodes n)
    ((last not=? 0) and (reader_nodes[last].kind =? 'namedarg'))
}

# `[x:T y:U]`, a record type; `[T U]`, a tuple type (dw_type's `[]:`).
rd_dc_record_type=(@reader_ctx:ParserContext @reader_nodes:array<Node>):>int64=>$unsafe {
    let pos:int64=rd_mkpos(reader_ctx.file reader_ctx.tokens[reader_ctx.at].start)
    reader_ctx.at = (int64<overflow='wrap'>(reader_ctx.at) + 1)
    let named:bool=((((reader_ctx.tokens[reader_ctx.at].kind =? 'identifier') and (reader_ctx.tokens[(int64<overflow='wrap'>(reader_ctx.at) + 1)].symbol =? 'colon')) or (rd_dn_peek(@reader_ctx) =? 'rbrack')) or ((((rd_dn_peek(@reader_ctx) =? 'at') and (reader_ctx.tokens[(int64<overflow='wrap'>(reader_ctx.at) + 1)].kind =? 'identifier')) and (reader_ctx.tokens[(int64<overflow='wrap'>(reader_ctx.at) + 2)].symbol =? 'colon')) and reader_ctx.flags.report_now))
    let n:int64=node_mk(@reader_nodes (if named 'trecord' else 'ttuple') pos)
    let items:array<int64>=[]
    loop (not rd_dn_accept(@reader_ctx 'rbrack')) {
        if (reader_ctx.tokens[reader_ctx.at].kind =? 'eof') {
            return 0
        }
        if named {
            # (`[@x:int64]`: dw_type's mistake, noted)
            if (rd_dn_peek(@reader_ctx) =? 'at') {
                if (not reader_ctx.flags.report_now) {
                    return 0
                }
                rd_dc_unsupported(@reader_ctx rd_mkpos(reader_ctx.file reader_ctx.tokens[reader_ctx.at].start) "a mutable inline record field; mutability belongs on the parameter");
                reader_ctx.at = (int64<overflow='wrap'>(reader_ctx.at) + 1)
            }
            let field:DewyLexeme=reader_ctx.tokens[reader_ctx.at]
            if ((((field.kind not=? 'identifier') or ((field.symbol not=? 'none') and (field.symbol not=? 'kw_test'))) or rd_dn_reserved(@reader_ctx int64<overflow='wrap'>(field.name))) or (reader_ctx.tokens[(int64<overflow='wrap'>(reader_ctx.at) + 1)].symbol not=? 'colon')) {
                return 0
            }
            reader_ctx.at = (int64<overflow='wrap'>(reader_ctx.at) + 2)
            let f:int64=node_mk(@reader_nodes 'vardecl' rd_mkpos(reader_ctx.file field.start))
            reader_nodes[f].name = field.name
            let outer:int64=reader_ctx.reader.dc_pattern_binder
            reader_ctx.reader.dc_pattern_binder = int64<overflow='wrap'>(field.name)
            let t:int64=rd_dc_annotation(@reader_ctx @reader_nodes)
            reader_ctx.reader.dc_pattern_binder = outer
            if (t =? 0) {
                return 0
            }
            # (`[x:int64=42]`: dw_type's mistake, noted; the value read)
            if ((rd_dn_peek(@reader_ctx) =? 'assign') and ((not reader_ctx.flags.report_now) or (rd_dc_inline_default(@reader_ctx @reader_nodes field) =? 0))) {
                return 0
            }
            reader_nodes[f].a = int32<overflow='wrap'>(t)
            items.push(f);
            continue
        }
        if (reader_ctx.tokens[(int64<overflow='wrap'>(reader_ctx.at) + 1)].symbol =? 'colon') {
            return 0
        }
        let t:int64=rd_dc_annotation(@reader_ctx @reader_nodes)
        if (t =? 0) {
            return 0
        }
        items.push(t);
    }
    node_set_list(@reader_nodes @reader_ctx.stores.lists[0] n items);
    n
}

# A refinement's conjunction is a bare `and` (dw_ref_predicate).
rd_dc_ref_predicate=(@reader_nodes:array<Node> n:int64):>int64=>$unsafe {
    if (reader_nodes[n].kind not=? 'and_') {
        return n
    }
    let both:int64=node_mk(@reader_nodes 'and_' reader_nodes[n].pos)
    reader_nodes[both].a = int32<overflow='wrap'>(rd_dc_ref_predicate(@reader_nodes int64<overflow='wrap'>(reader_nodes[n].a)))
    reader_nodes[both].b = int32<overflow='wrap'>(rd_dc_ref_predicate(@reader_nodes int64<overflow='wrap'>(reader_nodes[n].b)))
    both
}

rd_dc_ref_predicate_read=(@reader_ctx:ParserContext @reader_nodes:array<Node> minimum:int64):>int64=>$unsafe {
    reader_ctx.reader.dc_refining = (int64<overflow='wrap'>(reader_ctx.reader.dc_refining) + 1)
    let predicate:int64=rd_dc_expr(@reader_ctx @reader_nodes minimum)
    reader_ctx.reader.dc_refining = (int64<overflow='wrap'>(reader_ctx.reader.dc_refining) - 1)
    if ((predicate not=? 0) and (reader_ctx.reader.dc_member_ranges.length >? 0)) {
        rd_dc_ref_ranges(@reader_ctx @reader_nodes predicate);
    }
    if (reader_ctx.reader.dc_refining =? 0) {
        reader_ctx.reader.dc_member_ranges.clear();
    }
    predicate
}

rd_dc_ref_ranges=(@reader_ctx:ParserContext @reader_nodes:array<Node> n:int64):>void=>$unsafe {
    let k:NK=reader_nodes[n].kind
    if (k =? 'and_') {
        rd_dc_ref_ranges(@reader_ctx @reader_nodes int64<overflow='wrap'>(reader_nodes[n].a));
        rd_dc_ref_ranges(@reader_ctx @reader_nodes int64<overflow='wrap'>(reader_nodes[n].b));
    }
    else if ((k =? 'binary') and (reader_nodes[n].op =? int32<overflow='wrap'>(int64<overflow='wrap'>(int64(12))))) {
        let range:int64?=reader_ctx.reader.dc_member_ranges.get(int64<overflow='wrap'>(reader_nodes[n].b))
        if range isnt? none {
            reader_nodes[n].b = int32<overflow='wrap'>(range)
        }
    }
}

# A parameter's refined integer type, `int64<(>? 0)>`.
rd_dc_refined_parameter=(@reader_ctx:ParserContext @reader_nodes:array<Node>):>int64=>$unsafe {
    let start:int64=reader_ctx.at
    reader_ctx.reader.dc_parameter_type = false
    let direct:int64=rd_dc_type_named(@reader_ctx @reader_nodes)
    reader_ctx.reader.dc_parameter_type = true
    if (direct =? 0) {
        rd_dc_unread(@reader_ctx start);
    }
    direct
}

# The refinement of base at dc_parser.at (dw_type's condition: a `trefined` naming its value).
rd_dc_refinement=(@reader_ctx:ParserContext @reader_nodes:array<Node> base:int64):>int64=>$unsafe {
    let first:DewyLexeme=reader_ctx.tokens[reader_ctx.at]
    let pos:int64=rd_mkpos(reader_ctx.file first.start)
    let binder:int64=0
    let predicate:int64=0
    if (first.symbol =? 'lparen') {
        # (dn_partial: the group's operand is `$partial`, standing in place of its parenthesis)
        if (reader_ctx.reader.dc_partial_id =? 0) {
            reader_ctx.reader.dc_partial_id = reader_ctx.stores.host[0].intern("$partial")
        }
        let slot:int64=reader_ctx.at
        reader_ctx.tokens[reader_ctx.at] = DewyLexeme[kind='identifier' name=int32<overflow='wrap'>(reader_ctx.reader.dc_partial_id) start=first.start stop=first.stop space=first.space newline=first.newline]
        let saved_angles:int64=reader_ctx.reader.dn_angles
        reader_ctx.reader.dn_angles = 0
        predicate = rd_dc_ref_predicate_read(@reader_ctx @reader_nodes 0)
        reader_ctx.reader.dn_angles = saved_angles
        reader_ctx.tokens[slot] = first
        if ((predicate =? 0) or (not rd_dn_accept(@reader_ctx 'rparen'))) {
            return 0
        }
        binder = reader_ctx.reader.dc_partial_id
    }
    else {
        binder = int64<overflow='wrap'>(first.name)
        reader_ctx.at = (int64<overflow='wrap'>(reader_ctx.at) + 2)
        reader_ctx.reader.dn_angles = (int64<overflow='wrap'>(reader_ctx.reader.dn_angles) + 1)
        predicate = rd_dc_ref_predicate_read(@reader_ctx @reader_nodes 30)
        reader_ctx.reader.dn_angles = (int64<overflow='wrap'>(reader_ctx.reader.dn_angles) - 1)
        if (predicate =? 0) {
            return 0
        }
    }
    if rd_dc_membership(@reader_nodes predicate) {
        return 0
    }
    reader_ctx.stores.host[0].g_refine_active_set(true)
    let n:int64=node_mk(@reader_nodes 'trefined' pos)
    reader_nodes[n].a = int32<overflow='wrap'>(base)
    reader_nodes[n].name = int32<overflow='wrap'>(binder)
    reader_nodes[n].b = int32<overflow='wrap'>(rd_dc_ref_predicate(@reader_nodes predicate))
    n
}

# `name = T<condition>` or `name = T & ~value` at the top of a module (`let` or `const` before it,
# or neither): the alias of the refined type; 0 for anything else (dc_parser.at stays).
rd_dc_refinement_alias=(@reader_ctx:ParserContext @reader_nodes:array<Node>):>int64=>$unsafe {
    let start:int64=reader_ctx.at
    if ((reader_ctx.tokens[reader_ctx.at].symbol =? 'kw_let') or (reader_ctx.tokens[reader_ctx.at].symbol =? 'kw_const')) {
        reader_ctx.at = (int64<overflow='wrap'>(reader_ctx.at) + 1)
    }
    if ((int64<overflow='wrap'>(reader_ctx.at) + 4) >=? reader_ctx.tokens.length) {
        reader_ctx.at = start
        return 0
    }
    let token:DewyLexeme=reader_ctx.tokens[reader_ctx.at]
    let base:DewyLexeme=reader_ctx.tokens[(int64<overflow='wrap'>(reader_ctx.at) + 2)]
    if ((((((token.kind not=? 'identifier') or (token.symbol not=? 'none')) or rd_dn_reserved(@reader_ctx int64<overflow='wrap'>(token.name))) or (reader_ctx.tokens[(int64<overflow='wrap'>(reader_ctx.at) + 1)].symbol not=? 'assign')) or (base.kind not=? 'identifier')) or (base.symbol not=? 'none')) {
        reader_ctx.at = start
        return 0
    }
    # (`nonzero = int64 & ~0`: the value excluded, dw_type's `& ~`)
    let excluded:bool=((reader_ctx.tokens[(int64<overflow='wrap'>(reader_ctx.at) + 3)].symbol =? 'amp') and (reader_ctx.tokens[(int64<overflow='wrap'>(reader_ctx.at) + 4)].symbol =? 'tilde'))
    if ((not excluded) and (((reader_ctx.tokens[(int64<overflow='wrap'>(reader_ctx.at) + 3)].symbol not=? 'langle') or reader_ctx.tokens[(int64<overflow='wrap'>(reader_ctx.at) + 3)].space) or (not rd_dc_refinement_arguments(@reader_ctx (int64<overflow='wrap'>(reader_ctx.at) + 3))))) {
        reader_ctx.at = start
        return 0
    }
    reader_ctx.at = (int64<overflow='wrap'>(reader_ctx.at) + 2)
    let t:int64=rd_dc_type_named(@reader_ctx @reader_nodes)
    if excluded {
        if ((t =? 0) or (rd_dn_peek(@reader_ctx) not=? 'amp')) {
            return 0
        }
        reader_ctx.at = (int64<overflow='wrap'>(reader_ctx.at) + 2)
        let value:int64=rd_dc_expr(@reader_ctx @reader_nodes dn_prefix_power('tilde' false))
        if (value =? 0) {
            return 0
        }
        t = rd_dc_excluded(@reader_ctx @reader_nodes t value rd_mkpos(reader_ctx.file base.start))
    }
    if (((t =? 0) or (reader_nodes[t].kind not=? 'trefined')) or (dn_power(rd_dn_peek(@reader_ctx)) >? 0)) {
        return 0
    }
    let n:int64=node_mk(@reader_nodes 'typealias' rd_mkpos(reader_ctx.file token.start))
    reader_nodes[n].name = token.name
    reader_nodes[n].a = int32<overflow='wrap'>(t)
    rd_dn_accept_semi(@reader_ctx);
    n
}

# The type arguments opening at `at` hold a condition at their top (dw_top_declarations' test): a
# `=>` or a comparison, or a group opening with one.
rd_dc_refinement_arguments=(@reader_ctx:ParserContext at:int64):>bool=>$unsafe {
    let depth:int64=0
    let k:int64=at
    loop (k <? reader_ctx.tokens.length) {
        let t:DewyLexeme=reader_ctx.tokens[k]
        let symbol:DewyToken=t.symbol
        if (t.kind =? 'eof') {
            return false
        }
        if ((((symbol =? 'langle') or (symbol =? 'lparen')) or (symbol =? 'lbrack')) or (symbol =? 'lbrace')) {
            depth = (int64<overflow='wrap'>(depth) + 1)
            if (((depth =? 2) and (symbol =? 'lparen')) and rd_dc_refinement_next_at(@reader_ctx k)) {
                return true
            }
        }
        else if ((((symbol =? 'rangle') or (symbol =? 'rparen')) or (symbol =? 'rbrack')) or (symbol =? 'rbrace')) {
            depth = (int64<overflow='wrap'>(depth) - 1)
            if (depth =? 0) {
                return false
            }
        }
        else if (depth =? 1) {
            let scalar:DewyToken=dn_token_uninvert(symbol)
            if ((((((((symbol =? 'function') or (symbol =? 'kw_and')) or (scalar =? 'eq')) or (scalar =? 'lt')) or (scalar =? 'le')) or (scalar =? 'gt')) or (scalar =? 'ge')) or (scalar =? 'contains')) {
                return true
            }
        }
        k = (int64<overflow='wrap'>(k) + 1)
    }
    false
}

# A refinement is next among a type's arguments: a partial comparison, `(>? 0)`, or one value's
# predicate, `i => ...`; `(in? a..b)` a contiguous range's.
rd_dc_refinement_next=(@reader_ctx:ParserContext):>bool=>$unsafe {
    let t:DewyLexeme=reader_ctx.tokens[reader_ctx.at]
    if ((t.kind =? 'identifier') and (t.symbol =? 'none')) {
        return (reader_ctx.tokens[(int64<overflow='wrap'>(reader_ctx.at) + 1)].symbol =? 'function')
    }
    if (t.symbol not=? 'lparen') {
        return false
    }
    let op:DewyToken=reader_ctx.tokens[(int64<overflow='wrap'>(reader_ctx.at) + 1)].symbol
    if (op =? 'kw_not') {
        op = dn_token_invert(reader_ctx.tokens[(int64<overflow='wrap'>(reader_ctx.at) + 2)].symbol)
    }
    ((((((((((((op =? 'eq') or (op =? 'not_eq')) or (op =? 'lt')) or (op =? 'not_lt')) or (op =? 'gt')) or (op =? 'not_gt')) or (op =? 'le')) or (op =? 'not_le')) or (op =? 'ge')) or (op =? 'not_ge')) or (op =? 'contains')) or (op =? 'not_contains'))
}

rd_dc_refinement_next_at=(@reader_ctx:ParserContext at:int64):>bool=>$unsafe {
    let saved:int64=reader_ctx.at
    reader_ctx.at = at
    let yes:bool=rd_dc_refinement_next(@reader_ctx)
    reader_ctx.at = saved
    yes
}

# A mistake reported once the whole statement is read: the reading notes it (dc_report) and goes
# on; a module statement or body read through reports the first (dc_flush_report).
rd_dc_report=(@reader_ctx:ParserContext pos:int64 msg:string):>void=>$unsafe {
    dc_parser_report(@reader_ctx.status pos msg);
}

# A reserved word read as a name (dewy_reserved_name's mistake).
rd_dc_reserved_at=(@reader_ctx:ParserContext token:DewyLexeme):>void=>$unsafe {
    rd_dc_report(@reader_ctx rd_mkpos(reader_ctx.file token.start) rd_dewy_reserved_text(rd_dn_payload(@reader_ctx token)));
}

rd_dc_reserved_target=(@reader_ctx:ParserContext @reader_nodes:array<Node> left:int64):>void=>$unsafe {
    if (reader_nodes[left].kind =? 'none_lit') {
        rd_dc_report(@reader_ctx reader_nodes[left].pos rd_dewy_reserved_text("none"));
    }
    else {
        rd_dc_report(@reader_ctx reader_nodes[left].pos rd_dewy_reserved_text(rd_name_of(@reader_ctx int64<overflow='wrap'>(reader_nodes[left].name))));
    }
}

# `...rest` at the `...` among parameters (dw_function's mistake, noted; read as a parameter).
rd_dc_rest_parameter=(@reader_ctx:ParserContext):>bool=>$unsafe {
    let name:DewyLexeme=reader_ctx.tokens[(int64<overflow='wrap'>(reader_ctx.at) + 1)]
    if ((((not reader_ctx.flags.report_now) or name.space) or (name.kind not=? 'identifier')) or (name.symbol not=? 'none')) {
        return false
    }
    let word:string=rd_dn_payload(@reader_ctx name)
    rd_dc_report(@reader_ctx rd_mkpos(reader_ctx.file reader_ctx.tokens[reader_ctx.at].start) "rest parameters (`...{word}`) are not implemented yet; a bare `...` ends the positional run, so write `... {word}` for a keyword-only parameter");
    reader_ctx.at = (int64<overflow='wrap'>(reader_ctx.at) + 1)
    true
}

rd_dc_route_text=(@reader_ctx:ParserContext @reader_nodes:array<Node> n:int64):>string=>$unsafe {
    let source:string=reader_ctx.source
    let at:int64=rd_pos_off(reader_nodes[n].pos)
    if ((source as array<uint8>)[at] =? b'(') {
        return ""
    }
    let k:NK=reader_nodes[n].kind
    if (k =? 'ident') {
        return rd_dc_word_at(@reader_ctx at)
    }
    if (k =? 'field') {
        let base:string=rd_dc_route_text(@reader_ctx @reader_nodes int64<overflow='wrap'>(reader_nodes[n].a))
        if (base not=? "") {
            return "{base}.{rd_name_of(@reader_ctx int64<overflow='wrap'>(reader_nodes[n].name))}"
        }
        return ""
    }
    if (k not=? 'index') {
        return ""
    }
    let base:string=rd_dc_route_text(@reader_ctx @reader_nodes int64<overflow='wrap'>(reader_nodes[n].a))
    let indices:array<string>=[]
    loop entry in node_kids(@reader_nodes @reader_ctx.stores.lists[0] n) {
        let written:int64=rd_pos_off(reader_nodes[entry].pos)
        let before:int64=(int64<overflow='wrap'>(written) - 1)
        loop (before >? 0) and (((source as array<uint8>)[before] =? b' ') or ((source as array<uint8>)[before] =? b'\t')) {
            before = (int64<overflow='wrap'>(before) - 1)
        }
        if (((source as array<uint8>)[before] =? b'(') or ((source as array<uint8>)[before] =? b'@')) {
            return ""
        }
        if (((reader_nodes[entry].kind =? 'int_lit') and (reader_nodes[entry].aux2 =? 0)) and rd_is_digit((source as array<uint8>)[written])) {
            indices.push(rd_dc_word_at(@reader_ctx written));
        }
        else {
            let inner:string=rd_dc_route_text(@reader_ctx @reader_nodes entry)
            if (inner =? "") {
                return ""
            }
            indices.push(inner);
        }
    }
    if ((base not=? "") and (indices.length >? 0)) {
        return "{base}[{reader_ctx.stores.host[0].join(indices " ")}]"
    }
    ""
}

# `:>A | B & no_effects`: the row on the last alternative (dw_effect_result's mistake, noted).
rd_dc_row_grouping=(@reader_ctx:ParserContext @reader_nodes:array<Node> result:int64):>bool=>$unsafe {
    if ((not reader_ctx.flags.report_now) or (reader_ctx.tokens[(int64<overflow='wrap'>(reader_ctx.at) + 1)].symbol =? 'tilde')) {
        return false
    }
    rd_dc_report(@reader_ctx reader_nodes[rd_kid(@reader_ctx @reader_nodes result (int64<overflow='wrap'>(rd_nkids(@reader_nodes result)) - 1))].pos "effects describe the whole result: parenthesize the alternatives before them, `:>(A | B) & no_effects`");
    true
}

# (`[loop i in xs $field("a")=i 3]`, `[loop x in xs x -> 1 2]`: a computed row or an entry among
# other elements, dw_metatag_fail's or dw_expr's mistake, should nothing else read it)
rd_dc_row_outside=(@reader_ctx:ParserContext @reader_nodes:array<Node> flow:int64):>int64=>$unsafe {
    let last:int64=rd_dc_tail_value(@reader_ctx @reader_nodes flow)
    if (last =? 0) {
        return 0
    }
    if (reader_nodes[last].kind =? 'namedarg') {
        return rd_dc_hint(@reader_ctx reader_nodes[last].pos reader_ctx.stores.host[0].metatag_fail_text("field"))
    }
    if (reader_nodes[last].kind =? 'pair') {
        return rd_dc_hint(@reader_ctx reader_nodes[last].pos "a dictionary comprehension emits one `key -> value` pair per iteration")
    }
    0
}

# `[1 2 ; 3 4]`: the elements of an array literal in rows (each element's breaks after it), a
# matrix, or for more levels the elements reshaped (dw_rows_literal). 0 for a literal it reports.
rd_dc_rows=(@reader_ctx:ParserContext @reader_nodes:array<Node> n:int64 elements:array<int64> breaks:array<int64> pos:int64):>int64=>$unsafe {
    loop item in elements {
        if ((reader_nodes[n].kind not=? 'array') or rd_has_flag(@reader_nodes item NF_SPREAD)) {
            return 0
        }
    }
    let rank:int64=1
    loop b in breaks {
        rank = max(rank (int64<overflow='wrap'>(b) + 1))
    }
    let dims=fill((-1) rank)
    let counts=fill(0 rank)
    loop i in 0.. and b in breaks {
        counts[0] = (counts[0] + 1)
        let close:int64=(int64<overflow='wrap'>(rank) - 1)
        if ((int64<overflow='wrap'>(i) + 1) <? breaks.length) {
            close = b
        }
        loop level in [1..close] {
            let size=counts[(int64<overflow='wrap'>(level) - 1)]
            if (dims[(int64<overflow='wrap'>(level) - 1)] <? 0) {
                dims[(int64<overflow='wrap'>(level) - 1)] = size
            }
            else if (dims[(int64<overflow='wrap'>(level) - 1)] not=? size) {
                # (dw_rows_literal's mistake, noted)
                if (not reader_ctx.flags.report_now) {
                    return 0
                }
                rd_dc_ragged(@reader_ctx level size dims[(int64<overflow='wrap'>(level) - 1)] reader_nodes[elements[i]].pos);
            }
            counts[(int64<overflow='wrap'>(level) - 1)] = 0
            counts[level] = (counts[level] + 1)
        }
    }
    dims[(int64<overflow='wrap'>(rank) - 1)] = counts[(int64<overflow='wrap'>(rank) - 1)]
    if (rank =? 2) {
        reader_nodes[n].kind = 'matrix'
        node_set_list(@reader_nodes @reader_ctx.stores.lists[0] n elements);
        reader_nodes[n].ival = dims[0]
        return n
    }
    node_set_list(@reader_nodes @reader_ctx.stores.lists[0] n elements);
    let shape:array<int64>=[]
    let k:int64=(int64<overflow='wrap'>(rank) - 1)
    loop (k >=? 0) {
        shape.push(rd_bc_int(@reader_nodes dims[k] pos));
        k = (int64<overflow='wrap'>(k) - 1)
    }
    let sizes:int64=node_mk(@reader_nodes 'array' pos)
    node_set_list(@reader_nodes @reader_ctx.stores.lists[0] sizes shape);
    rd_bc_call(@reader_ctx @reader_nodes "reshape" [n sizes] pos)
}

# The setting scopes pushed from here on go if this attempt is retried (dn_edits_undo).
rd_dc_scope_undoable=(@reader_ctx:ParserContext):>void=>$unsafe {
    reader_ctx.reader.dn_edit_at.push((int64<overflow='wrap'>(int64(-1)) - int64<overflow='wrap'>(reader_ctx.stores.host[0].g_dir_scopes_len())));
    reader_ctx.reader.dn_edit_was.push(reader_ctx.tokens[(int64<overflow='wrap'>(reader_ctx.at) - 1)]);
}

rd_dc_set_call=(@reader_ctx:ParserContext @reader_nodes:array<Node> elements:int64 pos:int64):>int64=>$unsafe {
    rd_bc_call(@reader_ctx @reader_nodes "__dewy_set" [elements] pos)
}

rd_dc_setting=(@reader_ctx:ParserContext token:DewyLexeme):>int64=>$unsafe {
    let name:string=rd_dn_payload(@reader_ctx token)
    if ((dn_directive_form(name) not=? 0) or (not reader_ctx.stores.host[0].dw_dir_name(name))) {
        return 0
    }
    let at:int64=(int64<overflow='wrap'>(reader_ctx.at) + 1)
    let enabled:int64=1
    if (reader_ctx.tokens[at].symbol =? 'assign') {
        let value:DewyLexeme=reader_ctx.tokens[(int64<overflow='wrap'>(at) + 1)]
        if value.newline {
            return 0
        }
        if (value.kind not=? 'boolean') {
            # (`$explicit_copies = 1`: dw_dir_boolean's mistake)
            if (rd_dc_lone_value(@reader_ctx (int64<overflow='wrap'>(at) + 1)) or ((value.symbol =? 'lbrace') and reader_ctx.stores.host[0].dir_builtin(name))) {
                return rd_dc_fail_now(@reader_ctx rd_mkpos(reader_ctx.file value.start) "`${name}` takes a literal true or false")
            }
            return 0
        }
        if (int64<overflow='wrap'>(value.name) not=? reader_ctx.reader.dn_true_id) {
            enabled = 0
        }
        at = (int64<overflow='wrap'>(at) + 2)
    }
    let next:DewyLexeme=reader_ctx.tokens[at]
    if ((next.kind not=? 'eof') and (not (((next.newline and (dn_power(next.symbol) =? 0)) and (next.symbol not=? 'kw_not')) and (next.symbol not=? 'semi')))) {
        return 0
    }
    reader_ctx.at = at
    let id:int64=rd_dn_node(@reader_ctx 'compact_stmt' name token.start)
    reader_ctx.reader.dewy_syntax[id].child_right = enabled
    id
}

# Where `$target`, `$build` or a member of either written at token `at` ends (the token after it):
# -1 for anything else.
rd_dc_setting_place_end=(@reader_ctx:ParserContext at:int64):>int64=>$unsafe {
    let token:DewyLexeme=reader_ctx.tokens[at]
    let width:int64=(int64<overflow='wrap'>(token.stop) - int64<overflow='wrap'>(token.start))
    if (not (((width =? 7) and (rd_dn_payload(@reader_ctx token) =? "target")) or ((width =? 6) and (rd_dn_payload(@reader_ctx token) =? "build")))) {
        return (-1)
    }
    let dot:DewyLexeme=reader_ctx.tokens[(int64<overflow='wrap'>(at) + 1)]
    let member:DewyLexeme=reader_ctx.tokens[(int64<overflow='wrap'>(at) + 2)]
    if ((((dot.symbol =? 'dot') and (not dot.space)) and (not member.space)) and (member.kind =? 'identifier')) {
        return (int64<overflow='wrap'>(at) + 3)
    }
    (int64<overflow='wrap'>(at) + 1)
}

# How the setting place ending before token `place_stop` is written: `$target`, `$build`, `$build.mode`.
rd_dc_setting_text=(@reader_ctx:ParserContext place_stop:int64):>string=>$unsafe {
    let start:int64=(if (reader_ctx.tokens[(int64<overflow='wrap'>(place_stop) - 1)].kind =? 'metatag') (int64<overflow='wrap'>(place_stop) - 1) else (int64<overflow='wrap'>(place_stop) - 3))
    let text:string="{"$"}{rd_dn_payload(@reader_ctx reader_ctx.tokens[start])}"
    if ((int64<overflow='wrap'>(place_stop) - int64<overflow='wrap'>(start)) =? 3) {
        text = "{"{text}{"."}"}{rd_dn_payload(@reader_ctx reader_ctx.tokens[(int64<overflow='wrap'>(place_stop) - 1)])}"
    }
    text
}

# A plain real literal (no base prefix or separators) whose significant digits
# and exponent are exact doubles: one correctly rounded operation, as to_float's
# own fast path computes, without materializing the literal's text.
rd_dc_short_real=(@reader_ctx:ParserContext token:DewyLexeme):>float64?=>$unsafe {
    let source:string=reader_ctx.source
    let bytes:ptr<uint8>=(source as array<uint8>).ptr
    let k:int64=token.start
    let stop:int64=token.stop
    if (((bytes[k] =? b'0') and ((int64<overflow='wrap'>(k) + 1) <? stop)) and (bytes[(int64<overflow='wrap'>(k) + 1)] =? b'd')) {
        return none
    }
    let mant:uint64=0
    let digits:int64=0
    let zeros:int64=0
    let exp:int64=0
    let point:bool=false
    loop (k <? stop) {
        let c:uint8=bytes[k]
        if (c =? b'.') {
            point = true
        }
        else if ((c =? b'e') or (c =? b'E')) {
            break
        }
        else if ((c <? b'0') or (c >? b'9')) {
            return none
        }
        else if ((digits >? 0) or (c not=? b'0')) {
            if (digits =? 19) {
                return none
            }
            mant = (uint64<overflow='wrap'>((uint64<overflow='wrap'>(mant) * 10)) + uint64<overflow='wrap'>(uint64<overflow='wrap'>((uint8<overflow='wrap'>(c) - uint8<overflow='wrap'>(b'0')))))
            digits = (int64<overflow='wrap'>(digits) + 1)
            zeros = (if (c =? b'0') (int64<overflow='wrap'>(zeros) + 1) else int64(0))
            if point {
                exp = (int64<overflow='wrap'>(exp) - 1)
            }
        }
        else if point {
            exp = (int64<overflow='wrap'>(exp) - 1)
        }
        k = (int64<overflow='wrap'>(k) + 1)
    }
    if (k <? stop) {
        k = (int64<overflow='wrap'>(k) + 1)
        let negative:bool=false
        if ((bytes[k] =? b'+') or (bytes[k] =? b'-')) {
            negative = (bytes[k] =? b'-')
            k = (int64<overflow='wrap'>(k) + 1)
        }
        let e:int64=0
        loop (k <? stop) {
            let c:uint8=bytes[k]
            if (((c <? b'0') or (c >? b'9')) or (e >? 1000)) {
                return none
            }
            e = (int64<overflow='wrap'>((int64<overflow='wrap'>(e) * 10)) + int64<overflow='wrap'>(int64<overflow='wrap'>((uint8<overflow='wrap'>(c) - uint8<overflow='wrap'>(b'0')))))
            k = (int64<overflow='wrap'>(k) + 1)
        }
        exp = (int64<overflow='wrap'>(exp) + int64<overflow='wrap'>((if negative (-int64<overflow='wrap'>(e)) else e)))
    }
    if (digits =? 0) {
        return 0.0
    }
    loop (zeros >? 0) {
        mant = (mant // 10)
        digits = (int64<overflow='wrap'>(digits) - 1)
        zeros = (int64<overflow='wrap'>(zeros) - 1)
        exp = (int64<overflow='wrap'>(exp) + 1)
    }
    if (((digits >? 15) or (exp <? (-22))) or (exp >? 22)) {
        return none
    }
    if (exp >=? 0) {
        return (float64(mant) * reader_ctx.stores.host[0].__pow10(exp))
    }
    (float64(mant) / reader_ctx.stores.host[0].__pow10((-int64<overflow='wrap'>(exp))))
}

# `xs -1`: a sign attached to what follows, spaced from what precedes, starts the next value
# (dc_expr ends there, as an expression does).
rd_dc_signed_next=(@reader_ctx:ParserContext):>bool=>$unsafe {
    let t:DewyLexeme=reader_ctx.tokens[reader_ctx.at]
    ((((t.symbol =? 'plus') or (t.symbol =? 'minus')) and t.space) and (not reader_ctx.tokens[(int64<overflow='wrap'>(reader_ctx.at) + 1)].space))
}

# `spawn value`, `spawn(group) value` after its keyword (dw_spawn); `spawn(...)` as a call and
# `spawn` outside a group the direct grammar reads are left unread (dc_unread).
rd_dc_spawn=(@reader_ctx:ParserContext @reader_nodes:array<Node> token:DewyLexeme):>int64=>$unsafe {
    let pos:int64=rd_mkpos(reader_ctx.file token.start)
    let next:DewyToken=rd_dn_peek(@reader_ctx)
    if ((next =? 'assign') or (next =? 'colon')) {
        return 0
    }
    let g:int64=0
    if ((next =? 'lparen') and (not reader_ctx.tokens[reader_ctx.at].space)) {
        let close:int64=rd_dc_closing(@reader_ctx reader_ctx.at)
        if (close <? 0) {
            return 0
        }
        let after:DewyLexeme=reader_ctx.tokens[(int64<overflow='wrap'>(close) + 1)]
        # (`spawn("/bin/sh" [])`: the process API's call, unless one group is followed by a value)
        let call:bool=(((((((((close =? (int64<overflow='wrap'>(reader_ctx.at) + 1)) or (not dn_can_start(@reader_ctx.tokens (int64<overflow='wrap'>(close) + 1)))) or after.newline) or (dn_power(after.symbol) >? 0)) or (after.symbol =? 'kw_return')) or (after.symbol =? 'kw_let')) or (after.symbol =? 'kw_const')) or (after.symbol =? 'kw_break')) or (after.symbol =? 'kw_continue'))
        if (not call) {
            let group_at:int64=reader_ctx.at
            let node_start:int64=reader_nodes.length
            let list_start:int64=reader_ctx.stores.lists[0].length
            let edits:int64=reader_ctx.reader.dn_edit_at.length
            reader_ctx.at = (int64<overflow='wrap'>(reader_ctx.at) + 1)
            g = rd_dc_expr(@reader_ctx @reader_nodes 0)
            if (g =? 0) {
                return 0
            }
            if (reader_ctx.at not=? close) {
                call = true
                reader_ctx.at = group_at
                reader_nodes.truncate(node_start);
                reader_ctx.stores.lists[0].truncate(list_start);
                rd_dn_edits_undo(@reader_ctx edits);
            }
        }
        if call {
            let callee:int64=node_mk(@reader_nodes 'ident' pos)
            reader_nodes[callee].name = rd_dw_value_name(@reader_ctx int32<overflow='wrap'>(reader_ctx.stores.host[0].intern("spawn")) pos)
            return callee
        }
        reader_ctx.at = (int64<overflow='wrap'>(reader_ctx.at) + 1)
    }
    else if (reader_ctx.stores.host[0].g_dw_task_groups_len() =? 0) {
        # (dw_spawn's mistake, noted; the value read on)
        if (not reader_ctx.flags.report_now) {
            return 0
        }
        rd_dc_report(@reader_ctx pos "spawn needs an enclosing concurrent group, or an explicit spawn(group)");
        g = node_mk(@reader_nodes 'hole' pos)
    }
    else {
        g = rd_bc_ident(@reader_ctx @reader_nodes reader_ctx.stores.host[0].g_dw_task_groups_item((int64<overflow='wrap'>(reader_ctx.stores.host[0].g_dw_task_groups_len()) - 1)) pos)
    }
    let value:int64=rd_dc_expr(@reader_ctx @reader_nodes 0)
    if (value =? 0) {
        return 0
    }
    reader_ctx.stores.host[0].dw_task_spawn(g value pos)
}

# `xs...` where no spread goes (dw_expr's mistake, noted; the `...` read).
rd_dc_spread_outside=(@reader_ctx:ParserContext pos:int64):>int64=>$unsafe {
    rd_dc_report(@reader_ctx pos "spread is supported inside array or record literals and call arguments: `[values... item]`, `[base... field=value]`, `add(pair...)`");
    reader_ctx.at = (int64<overflow='wrap'>(reader_ctx.at) + 1)
    1
}

# Statement contexts are distinct from arguments, parameters and record
# elements. Keep that context at the construction boundary.
rd_dc_statement=(@reader_ctx:ParserContext @reader_nodes:array<Node>):>int64=>$unsafe {
    let start:int64=reader_ctx.at
    let token:DewyLexeme=reader_ctx.tokens[reader_ctx.at]
    let pos:int64=rd_mkpos(reader_ctx.file token.start)
    let op:DewyToken=token.symbol
    let splice:bool=reader_ctx.reader.dc_splice_ok
    reader_ctx.reader.dc_splice_ok = false
    if ((op =? 'kw_if') or (op =? 'kw_loop')) {
        let n:int64=rd_dc_flow(@reader_ctx @reader_nodes)
        if (n =? 0) {
            return 0
        }
        # (a chain folding to its compiled arm splices that arm's statements into a block that reads
        # it, dc_body_read)
        if ((reader_ctx.reader.dc_live_at =? start) and (op =? 'kw_if')) {
            if (((not splice) or (rd_dn_peek(@reader_ctx) =? 'semi')) or reader_ctx.collection.tagged_last.has(n)) {
                return 0
            }
            return n
        }
        rd_add_flag(@reader_nodes n NF_STMT);
        # (`loop c xs.pop();`: what the statement expresses is discarded)
        if rd_dc_accept_semi(@reader_ctx (not reader_ctx.reader.dc_unbraced)) {
            let discard:int64=node_mk(@reader_nodes 'block' pos)
            node_set_list(@reader_nodes @reader_ctx.stores.lists[0] discard [n]);
            rd_add_flag(@reader_nodes discard NF_DISCARD);
            return discard
        }
        return n
    }
    if (op =? 'kw_match') {
        let n:int64=rd_dc_flow(@reader_ctx @reader_nodes)
        if ((n =? 0) or (rd_dn_peek(@reader_ctx) =? 'semi')) {
            return 0
        }
        rd_add_flag(@reader_nodes n NF_STMT);
        return rd_dc_flow_stmt(@reader_nodes n)
    }
    if (op =? 'kw_parallel') {
        reader_ctx.at = (int64<overflow='wrap'>(reader_ctx.at) + 1)
        let n:int64=rd_dc_parallel(@reader_ctx @reader_nodes token false)
        if ((n =? 0) or (rd_dn_peek(@reader_ctx) =? 'semi')) {
            return 0
        }
        return n
    }
    if (op =? 'kw_concurrent') {
        reader_ctx.at = (int64<overflow='wrap'>(reader_ctx.at) + 1)
        let n:int64=rd_dc_concurrent(@reader_ctx @reader_nodes token true)
        if ((n =? 0) or (rd_dn_peek(@reader_ctx) =? 'semi')) {
            return 0
        }
        return n
    }
    if (op =? 'kw_return') {
        reader_ctx.at = (int64<overflow='wrap'>(reader_ctx.at) + 1)
        let n:int64=node_mk(@reader_nodes 'return_' pos)
        if (dn_can_start(@reader_ctx.tokens reader_ctx.at) and (not reader_ctx.tokens[reader_ctx.at].newline)) {
            let value:int64=rd_dc_expr(@reader_ctx @reader_nodes 0)
            if (value =? 0) {
                return 0
            }
            reader_nodes[n].a = int32<overflow='wrap'>(value)
        }
        rd_dn_accept_semi(@reader_ctx);
        return n
    }
    if ((op =? 'kw_break') or (op =? 'kw_continue')) {
        reader_ctx.at = (int64<overflow='wrap'>(reader_ctx.at) + 1)
        let n:int64=node_mk(@reader_nodes (if (op =? 'kw_break') 'break_' else 'continue_') pos)
        if ((reader_ctx.tokens[reader_ctx.at].kind =? 'metatag') and (not reader_ctx.tokens[reader_ctx.at].newline)) {
            reader_nodes[n].name = int32<overflow='wrap'>(reader_ctx.stores.host[0].intern(rd_dn_payload(@reader_ctx rd_dn_take(@reader_ctx))))
        }
        rd_dn_accept_semi(@reader_ctx);
        return n
    }
    if ((op =? 'kw_let') or (op =? 'kw_const')) {
        if rd_dc_local_type_next(@reader_ctx) {
            return rd_dc_local_type(@reader_ctx @reader_nodes)
        }
        reader_ctx.at = (int64<overflow='wrap'>(reader_ctx.at) + 1)
        return rd_dc_declaration(@reader_ctx @reader_nodes (op =? 'kw_const'))
    }
    if ((token.kind =? 'identifier') and (reader_ctx.tokens[(int64<overflow='wrap'>(reader_ctx.at) + 1)].symbol =? 'colon')) {
        return rd_dc_declaration(@reader_ctx @reader_nodes false true)
    }
    if (token.kind =? 'metatag') {
        if (not rd_dc_unsafe_at(@reader_ctx reader_ctx.at)) {
            let width:int64=(int64<overflow='wrap'>(token.stop) - int64<overflow='wrap'>(token.start))
            if (((width =? 7) and (rd_dn_payload(@reader_ctx token) =? "expect")) or ((width =? 5) and (rd_dn_payload(@reader_ctx token) =? "fail"))) {
                return rd_dc_expect(@reader_ctx @reader_nodes token (width =? 5))
            }
            if ((width =? 11) and (rd_dn_payload(@reader_ctx token) =? "breakpoint")) {
                return rd_dc_breakpoint(@reader_ctx @reader_nodes token)
            }
            if ((width =? 14) and (rd_dn_payload(@reader_ctx token) =? "include_bytes")) {
                return rd_dc_include_binding(@reader_ctx @reader_nodes token)
            }
            # (`$unsafe_assume x`: dw_unimplemented's mistake)
            if (reader_ctx.flags.report_now and rd_dc_unbuilt(rd_dn_payload(@reader_ctx token))) {
                return rd_dc_fail_now(@reader_ctx pos reader_ctx.stores.host[0].metatag_fail_text(rd_dn_payload(@reader_ctx token)))
            }
            let place_end:int64=rd_dc_setting_place_end(@reader_ctx reader_ctx.at)
            if ((place_end >? 0) and (reader_ctx.tokens[place_end].symbol =? 'assign')) {
                return rd_dc_body_setting(@reader_ctx @reader_nodes place_end)
            }
            return rd_dc_assertion(@reader_ctx @reader_nodes token)
        }
        reader_ctx.at = (int64<overflow='wrap'>(reader_ctx.at) + 1)
        let n:int64=rd_dc_statement(@reader_ctx @reader_nodes)
        if (n not=? 0) {
            rd_dc_unsafe_scope(@reader_ctx pos);
        }
        return n
    }
    if ((op =? 'lparen') and rd_dc_update_next(@reader_ctx)) {
        let update:int64=rd_dc_grouped_update(@reader_ctx @reader_nodes)
        if ((update =? 0) or (not rd_dc_flow_ends(@reader_ctx))) {
            return 0
        }
        return update
    }
    # `[a b] = value`, `(a b) = values`: unpacked into names (dw_stmt's pattern target)
    if (((op =? 'lbrack') or (op =? 'lparen')) and (reader_ctx.tokens[(int64<overflow='wrap'>(rd_dc_closing(@reader_ctx reader_ctx.at)) + 1)].symbol =? 'assign')) {
        return rd_dc_unpacking_assignment(@reader_ctx @reader_nodes (op =? 'lparen') pos)
    }
    # Assignment operands are values rather than binding patterns.
    if ((token.kind not=? 'identifier') or ((op not=? 'none') and (op not=? 'kw_test'))) {
        return 0
    }
    let left:int64=rd_dc_expr(@reader_ctx @reader_nodes 11)
    # (`x => y = 1`: the lambda would be the target, an arm's mistake: dw_arm_fail)
    if ((left =? 0) or (reader_nodes[left].kind =? 'lambda')) {
        return 0
    }
    op = rd_dn_peek(@reader_ctx)
    if ((op =? 'colon') and reader_ctx.reader.dc_top_level) {
        return rd_dc_def_habit(@reader_ctx @reader_nodes left)
    }
    if ((op not=? 'assign') and (not dn_token_assignment(op))) {
        # (no assignment follows: what was read is the statement's value, as dc_expr(0) reads it)
        reader_ctx.reader.dc_value = left
        reader_ctx.reader.dc_value_start = start
        return 0
    }
    # (`none = 1`, `void = 1`: a reserved word cannot be bound)
    if ((op =? 'assign') and ((reader_nodes[left].kind =? 'none_lit') or ((reader_nodes[left].kind =? 'ident') and rd_dn_reserved(@reader_ctx int64<overflow='wrap'>(reader_nodes[left].name))))) {
        # (at the top of a module, dw_top_declarations' mistake)
        if (not reader_ctx.reader.dc_top_level) {
            return 0
        }
        rd_dc_reserved_target(@reader_ctx @reader_nodes left);
    }
    reader_ctx.at = (int64<overflow='wrap'>(reader_ctx.at) + 1)
    if ((not reader_ctx.flags.fn_body) and rd_dc_lambda_next(@reader_ctx)) {
        return 0
    }
    reader_ctx.depth = (int64<overflow='wrap'>(reader_ctx.depth) + 1)
    let right:int64=rd_dc_expr(@reader_ctx @reader_nodes 11)
    reader_ctx.depth = (int64<overflow='wrap'>(reader_ctx.depth) - 1)
    # (outside a function body, `name = (...) => ...` may declare a module function: a `$target`
    # arm's statements are module declarations, dw_top_declarations)
    if (((right =? 0) or ((reader_nodes[right].kind =? 'lambda') and (not reader_ctx.flags.fn_body))) or rd_dc_inferred_refinement(@reader_ctx @reader_nodes right)) {
        return 0
    }
    let n:int64=rd_dc_assign_node(@reader_ctx @reader_nodes op left right pos)
    rd_dc_accept_semi(@reader_ctx (not reader_ctx.reader.dc_unbraced));
    n
}

# What follows ends the statement, as it ends an expression.
rd_dc_statement_ends=(@reader_ctx:ParserContext):>bool=>$unsafe {
    let after:DewyLexeme=reader_ctx.tokens[reader_ctx.at]
    if (after.kind =? 'eof') {
        return true
    }
    if ((((((((dn_power(after.symbol) >? 0) or (after.symbol =? 'comma')) or (after.symbol =? 'semi')) or (after.symbol =? 'dot')) or (after.symbol =? 'question')) or (after.symbol =? 'ellipsis')) or (after.symbol =? 'kw_or_throw')) or (after.symbol =? 'kw_not')) {
        return false
    }
    ((((after.space or after.newline) or (after.symbol =? 'rbrace')) or (after.symbol =? 'rparen')) or (after.symbol =? 'rbrack'))
}

rd_dc_stepped_arity=(@reader_ctx:ParserContext @reader_nodes:array<Node> pos:int64):>void=>$unsafe {
    rd_dc_unsupported(@reader_ctx pos "a stepped range without exactly two starting values");
    loop rd_dn_accept(@reader_ctx 'comma') {
        if (rd_dc_expr(@reader_ctx @reader_nodes 106) =? 0) {
            return
        }
    }
}

rd_dc_stored_open=(@reader_ctx:ParserContext @reader_nodes:array<Node> range:int64):>int64=>$unsafe {
    if (not reader_ctx.flags.report_now) {
        return 0
    }
    rd_dc_report(@reader_ctx reader_nodes[range].pos "a stored range needs both endpoints; open ranges can be used directly in loops or membership");
    range
}

# A tag no top-level form takes when set (`$frob = 3`): dw_metatag_fail reports it.
rd_dc_tag_mistake=(@reader_ctx:ParserContext name:string):>bool=>$unsafe {
    (((((((not reader_ctx.stores.host[0].dw_dir_name(name)) and (not reader_ctx.stores.host[0].dw_dir_known(name))) and (name not=? "supported_targets")) and (name not=? "target")) and (name not=? "build")) and (name not=? "export")) and (name not=? "test"))
}

# (`let n = $unsafe`: a tag no value form fits, dw_metatag_fail's mistake, should nothing else
# read it)
rd_dc_tag_unread=(@reader_ctx:ParserContext token:DewyLexeme pos:int64):>int64=>$unsafe {
    let name:string=rd_dn_payload(@reader_ctx token)
    if (name not=? "target") {
        rd_dc_hint(@reader_ctx pos reader_ctx.stores.host[0].metatag_fail_text(name));
    }
    0
}

# What a comprehension's first collected value is (dw_collection_kind): 1 a value, 2 a dictionary
# entry, 0 none.
rd_dc_tail_kind=(@reader_ctx:ParserContext @reader_nodes:array<Node> statement:int64):>int64=>$unsafe {
    dr_tail_kind(@reader_nodes @reader_ctx.stores.lists[0] statement)
}

# (the value of a flow's last statement, through its loops and blocks; 0 for none)
rd_dc_tail_value=(@reader_ctx:ParserContext @reader_nodes:array<Node> n:int64):>int64=>$unsafe {
    let k:NK=reader_nodes[n].kind
    if ((((k =? 'for_') or (k =? 'while_')) or (k =? 'loopx')) or (k =? 'if_')) {
        return rd_dc_tail_value(@reader_ctx @reader_nodes int64<overflow='wrap'>(reader_nodes[n].b))
    }
    if (k =? 'block') {
        if (rd_nkids(@reader_nodes n) =? 0) {
            return 0
        }
        return rd_dc_tail_value(@reader_ctx @reader_nodes rd_kid(@reader_ctx @reader_nodes n (int64<overflow='wrap'>(rd_nkids(@reader_nodes n)) - 1)))
    }
    if (k =? 'exprstmt') {
        return int64<overflow='wrap'>(reader_nodes[n].a)
    }
    0
}

# A module-level `if` chain testing `$target` or `$build`, after which only the compiled arm's
# declarations exist (dw_target_splice): a flow holding that arm alone, its statements read as
# module statements (dn_statement); the names the other arms use are noted (dw_target_dropped).
# 0 before the compiled arm when a condition does not fold (is left unread (dc_unread) it).
rd_dc_target_chain=(@reader_ctx:ParserContext @reader_nodes:array<Node>):>int64=>$unsafe {
    let start:int64=reader_ctx.tokens[reader_ctx.at].start
    let live:bool=false
    let compiled:int64=0
    loop true {
        reader_ctx.at = (int64<overflow='wrap'>(reader_ctx.at) + 1)
        let tag:DewyLexeme=reader_ctx.tokens[reader_ctx.at]
        if ((not live) and ((tag.kind not=? 'metatag') or ((rd_dn_payload(@reader_ctx tag) not=? "target") and (rd_dn_payload(@reader_ctx tag) not=? "build")))) {
            return 0
        }
        reader_ctx.depth = 0
        let condition:int64=rd_dc_expr(@reader_ctx @reader_nodes 0)
        if ((condition =? 0) or (not dn_can_start(@reader_ctx.tokens reader_ctx.at))) {
            return 0
        }
        let taken:bool=false
        if (not live) {
            let fold:int64=rd_dc_target_fold(@reader_ctx @reader_nodes condition)
            if (fold <? 0) {
                return 0
            }
            taken = (fold =? 1)
        }
        if taken {
            if (not rd_dc_module_block_next(@reader_ctx)) {
                return 0
            }
            compiled = rd_dc_module_block(@reader_ctx @reader_nodes)
            live = true
        }
        else {
            rd_dc_target_dropped(@reader_ctx @reader_nodes condition);
            if (not rd_dc_dropped_arm(@reader_ctx)) {
                return 0
            }
        }
        if (not rd_dn_accept(@reader_ctx 'kw_else')) {
            break
        }
        if (rd_dn_peek(@reader_ctx) =? 'kw_if') {
            continue
        }
        if (not live) {
            if (not rd_dc_module_block_next(@reader_ctx)) {
                return 0
            }
            compiled = rd_dc_module_block(@reader_ctx @reader_nodes)
        }
        else if (not rd_dc_dropped_arm(@reader_ctx)) {
            return 0
        }
        break
    }
    # (the compiled arm, alone: dw_top_declarations splices its declarations, dw_target_live)
    rd_dn_node(@reader_ctx 'flow' "" start (if (compiled not=? 0) [compiled] else []))
}

rd_dc_target_compare=(@reader_ctx:ParserContext @reader_nodes:array<Node> n:int64):>int64=>$unsafe {
    if (reader_nodes[n].kind not=? 'binary') {
        return (-1)
    }
    let op:int32=reader_nodes[n].op
    if (op =? int32<overflow='wrap'>(int64<overflow='wrap'>(int64(69)))) {
        let left:int64=int64<overflow='wrap'>(reader_nodes[n].a)
        let right:int64=int64<overflow='wrap'>(reader_nodes[n].b)
        if (rd_dc_target_of(@reader_ctx @reader_nodes right) >=? 0) {
            right = left
            left = int64<overflow='wrap'>(reader_nodes[n].b)
        }
        let field:int64=rd_dc_target_of(@reader_ctx @reader_nodes left)
        if (field <? 0) {
            return (-1)
        }
        let name:string=rd_dc_target_literal(@reader_ctx @reader_nodes right field)
        if (name =? "") {
            return reader_ctx.reader.dc_target_problem
        }
        return (if (name =? reader_ctx.stores.host[0].dw_target_field_value(field)) int64(1) else int64(0))
    }
    if (op not=? int32<overflow='wrap'>(int64<overflow='wrap'>(int64(12)))) {
        return (-1)
    }
    let field:int64=rd_dc_target_of(@reader_ctx @reader_nodes int64<overflow='wrap'>(reader_nodes[n].a))
    let list:int64=int64<overflow='wrap'>(reader_nodes[n].b)
    if (((field <? 0) or (reader_nodes[list].kind not=? 'array')) or rd_has_flag(@reader_nodes list NF_COMPREHENSION)) {
        return (-1)
    }
    let found:int64=0
    loop entry in node_kids(@reader_nodes @reader_ctx.stores.lists[0] list) {
        let name:string=rd_dc_target_literal(@reader_ctx @reader_nodes entry field)
        if (name =? "") {
            return reader_ctx.reader.dc_target_problem
        }
        if (name =? reader_ctx.stores.host[0].dw_target_field_value(field)) {
            found = 1
        }
    }
    found
}

# The names an arm a fold leaves out uses (dw_target_dropped), from its nodes.
rd_dc_target_dropped=(@reader_ctx:ParserContext @reader_nodes:array<Node> n:int64):>void=>$unsafe {
    if (reader_ctx.reader.dc_target_members.length =? 0) {
        reader_ctx.stores.host[0].dw_target_dropped_node(n);
    }
    else {
        rd_dc_target_dropped_walk(@reader_ctx @reader_nodes n);
    }
}

rd_dc_target_dropped_walk=(@reader_ctx:ParserContext @reader_nodes:array<Node> n:int64):>void=>$unsafe {
    if ((n <=? 0) or (n >=? reader_nodes.length)) {
        return
    }
    if ((reader_nodes[n].kind =? 'str_lit') and (rd_dc_target_of(@reader_ctx @reader_nodes n) >? 0)) {
        let at:int64?=reader_ctx.reader.dc_target_members.get(n)
        if at isnt? none {
            reader_ctx.stores.host[0].dw_target_dropped_name(reader_ctx.stores.host[0].intern((if (rd_dc_target_of(@reader_ctx @reader_nodes n) =? 1) "arch" else (if (rd_dc_target_of(@reader_ctx @reader_nodes n) =? 2) "os" else "mode"))) at);
        }
        return
    }
    if (reader_nodes[n].kind =? 'ident') {
        reader_ctx.stores.host[0].dw_target_dropped_name(int64<overflow='wrap'>(reader_nodes[n].name) reader_nodes[n].pos);
    }
    let mask:int64=reader_ctx.stores.host[0].isolation_children(reader_nodes[n].kind)
    if (reader_nodes[n].kind =? 'lambda') {
        mask = (((1 or 2) or 4) or 16)
        loop c in node_kids2(@reader_nodes @reader_ctx.stores.lists[0] n) {
            rd_dc_target_dropped_walk(@reader_ctx @reader_nodes c);
        }
    }
    if (mask <? 0) {
        mask = (((1 or 2) or 4) or 16)
    }
    if ((mask and 1) not=? 0) {
        rd_dc_target_dropped_walk(@reader_ctx @reader_nodes int64<overflow='wrap'>(reader_nodes[n].a));
    }
    if ((mask and 2) not=? 0) {
        rd_dc_target_dropped_walk(@reader_ctx @reader_nodes int64<overflow='wrap'>(reader_nodes[n].b));
    }
    if ((mask and 4) not=? 0) {
        rd_dc_target_dropped_walk(@reader_ctx @reader_nodes int64<overflow='wrap'>(reader_nodes[n].c));
    }
    if ((mask and 16) not=? 0) {
        loop c in node_kids(@reader_nodes @reader_ctx.stores.lists[0] n) {
            rd_dc_target_dropped_walk(@reader_ctx @reader_nodes c);
        }
    }
}

# A condition made only of `$target`, its fields or `$build.mode` compared with string literals
# (target_fold): 1 true, 0 false, -1 any other condition; -2 a name the design does not give,
# which is left unread (dc_unread).
rd_dc_target_fold=(@reader_ctx:ParserContext @reader_nodes:array<Node> n:int64):>int64=>$unsafe {
    if ((reader_ctx.reader.dc_targets_made =? 0) or (n <=? 0)) {
        return (-1)
    }
    let k:NK=reader_nodes[n].kind
    if (k =? 'not_') {
        let fold:int64=(-1)
        # (`a not =? b`: an inverted comparison; `not c`, but not `~c`)
        if (reader_nodes[n].op =? 0) {
            fold = rd_dc_target_compare(@reader_ctx @reader_nodes int64<overflow='wrap'>(reader_nodes[n].a))
        }
        else {
            if ((reader_ctx.source as array<uint8>).ptr[rd_pos_off(reader_nodes[n].pos)] =? b'~') {
                return (-1)
            }
            fold = rd_dc_target_fold(@reader_ctx @reader_nodes int64<overflow='wrap'>(reader_nodes[n].a))
        }
        if (fold <? 0) {
            return fold
        }
        return (int64<overflow='wrap'>(int64(1)) - int64<overflow='wrap'>(fold))
    }
    if ((k =? 'and_') or (k =? 'or_')) {
        let left:int64=rd_dc_target_fold(@reader_ctx @reader_nodes int64<overflow='wrap'>(reader_nodes[n].a))
        if (left <? 0) {
            return left
        }
        let right:int64=rd_dc_target_fold(@reader_ctx @reader_nodes int64<overflow='wrap'>(reader_nodes[n].b))
        if (right <? 0) {
            return right
        }
        if (k =? 'and_') {
            return (left and right)
        }
        return (left or right)
    }
    rd_dc_target_compare(@reader_ctx @reader_nodes n)
}

# `[...]` of target names after `$supported_targets =` (dw_supported_targets): each a plain string
# literal naming a target.
rd_dc_target_list=(@reader_ctx:ParserContext @reader_nodes:array<Node>):>int64=>$unsafe {
    if (rd_dn_peek(@reader_ctx) not=? 'lbrack') {
        return 0
    }
    let list:int64=node_mk(@reader_nodes 'array' rd_mkpos(reader_ctx.file reader_ctx.tokens[reader_ctx.at].start))
    reader_ctx.at = (int64<overflow='wrap'>(reader_ctx.at) + 1)
    let names:array<int64>=[]
    loop (not rd_dn_accept(@reader_ctx 'rbrack')) {
        let token:DewyLexeme=reader_ctx.tokens[reader_ctx.at]
        if ((token.kind not=? 'quoted') and (token.kind not=? 'rawquoted')) {
            return 0
        }
        reader_ctx.at = (int64<overflow='wrap'>(reader_ctx.at) + 1)
        let literal:int64=rd_dn_string(@reader_ctx @reader_nodes token)
        if (literal =? 0) {
            return 0
        }
        if (rd_dc_target_literal(@reader_ctx @reader_nodes literal 0 false) =? "") {
            # (syntax_target_literal's mistake, should nothing else read it)
            if (reader_ctx.reader.dc_target_problem =? (-2)) {
                rd_dc_hint(@reader_ctx reader_nodes[literal].pos rd_dc_target_text(@reader_ctx rd_name_of(@reader_ctx int64<overflow='wrap'>(reader_nodes[literal].sval)) 0));
            }
            return 0
        }
        names.push(literal);
    }
    node_set_list(@reader_nodes @reader_ctx.stores.lists[0] list names);
    list
}

rd_dc_target_literal=(@reader_ctx:ParserContext @reader_nodes:array<Node> n:int64 field:int64 report:bool=true):>string=>$unsafe {
    reader_ctx.reader.dc_target_problem = (-1)
    if ((((reader_nodes[n].kind not=? 'str_lit') or (rd_nkids(@reader_nodes n) >? 0)) or (rd_dc_target_of(@reader_ctx @reader_nodes n) >=? 0)) or rd_has_flag(@reader_nodes n NF_SPREAD)) {
        return ""
    }
    let name:string=rd_name_of(@reader_ctx int64<overflow='wrap'>(reader_nodes[n].sval))
    let known:bool=false
    if (field =? 3) {
        known = ((name =? "release") or (name =? "debug"))
    }
    else if (field =? 1) {
        known = (name in? target_arches())
    }
    else if (field =? 2) {
        known = (name in? target_oses())
    }
    else {
        known = ((name in? target_names()) and (((target_os_of(name) not=? "none") or (name =? "wasm32")) or (name =? "c89")))
    }
    if known {
        return name
    }
    if ((not reader_ctx.flags.report_now) or (not report)) {
        reader_ctx.reader.dc_target_problem = (-2)
        return ""
    }
    # (syntax_target_literal's mistakes, reported once the statement is read)
    rd_dc_report(@reader_ctx reader_nodes[n].pos rd_dc_target_text(@reader_ctx name field));
    name
}

# `$target.arch`, `$target.os`: that part of the name (dw_target_field).
rd_dc_target_member=(@reader_ctx:ParserContext @reader_nodes:array<Node> left:int64 member:DewyLexeme):>bool=>$unsafe {
    let word:string=rd_dn_payload(@reader_ctx member)
    if ((word not=? "arch") and (word not=? "os")) {
        return false
    }
    rd_dc_target_note(@reader_ctx @reader_nodes left (if (word =? "arch") int64(1) else int64(2)) member.start);
    true
}

rd_dc_target_note=(@reader_ctx:ParserContext @reader_nodes:array<Node> n:int64 field:int64 member:int64):>void=>$unsafe {
    reader_nodes[n].sval = int32<overflow='wrap'>(reader_ctx.stores.host[0].intern((if (field =? 0) reader_ctx.stores.host[0].dw_target_name() else reader_ctx.stores.host[0].dw_target_field_value(field))))
    reader_ctx.reader.dc_targets_made = (int64<overflow='wrap'>(reader_ctx.reader.dc_targets_made) + 1)
    reader_ctx.reader.dc_target_fields[n] = field
    reader_ctx.reader.dc_target_pos[n] = reader_nodes[n].pos
    if (member >=? 0) {
        reader_ctx.reader.dc_target_members[n] = rd_mkpos(reader_ctx.file member)
    }
    else {
        reader_ctx.reader.dc_target_members.remove(n);
    }
}

# The field the string n reads (dc_target_note), -1 for any other node.
rd_dc_target_of=(@reader_ctx:ParserContext @reader_nodes:array<Node> n:int64):>int64=>$unsafe {
    if ((n <=? 0) or (reader_nodes[n].kind not=? 'str_lit')) {
        return (-1)
    }
    let field:int64?=reader_ctx.reader.dc_target_fields.get(n)
    if field isnt? none {
        if ((reader_ctx.reader.dc_target_pos.get(n) ?? (-1)) =? reader_nodes[n].pos) {
            return field
        }
    }
    (-1)
}

rd_dc_target_text=(@reader_ctx:ParserContext name:string field:int64):>string=>$unsafe {
    if (field =? 3) {
        return "unknown build mode \"{name}\": `$build.mode` is \"release\" or \"debug\""
    }
    if (field =? 1) {
        return "unknown processor \"{name}\": `$target.arch` is one of {reader_ctx.stores.host[0].join(target_arches() ", ")}"
    }
    if (field =? 2) {
        return "unknown system \"{name}\": `$target.os` is one of {reader_ctx.stores.host[0].join(target_oses() ", ")}"
    }
    if (not (name in? target_names())) {
        return "unknown target \"{name}\": `$target` is one of {reader_ctx.stores.host[0].join(target_names() ", ")}"
    }
    "`$target` is a full target name, never \"{name}\" alone (which asks for the current machine): test the processor with `$target.arch =? \"{name}\"`, or name the system too, as \"{name}-linux\""
}

rd_dc_target_value=(@reader_ctx:ParserContext @reader_nodes:array<Node> field:int64 pos:int64 member:int64):>int64=>$unsafe {
    let n:int64=node_mk(@reader_nodes 'str_lit' pos)
    rd_dc_target_note(@reader_ctx @reader_nodes n field member);
    n
}

# `test "name" { ... }`: another language's test block, which dn_stmt reports.
rd_dc_test_block=(@reader_ctx:ParserContext at:int64):>bool=>$unsafe {
    let token:DewyLexeme=reader_ctx.tokens[at]
    if (token.kind =? 'eof') {
        return false
    }
    let next:DewyLexeme=reader_ctx.tokens[(int64<overflow='wrap'>(at) + 1)]
    ((((token.symbol =? 'kw_test') and next.space) and ((next.kind =? 'quoted') or (next.kind =? 'rawquoted'))) and (not next.newline))
}

# `$test(` then its cases, through `)` (dw_test_spec): the test, its function still to come.
rd_dc_test_cases=(@reader_ctx:ParserContext @reader_nodes:array<Node> pos:int64):>int64=>$unsafe {
    let key:DewyLexeme=reader_ctx.tokens[reader_ctx.at]
    # (dw_test_spec's mistakes, at once)
    if (key.symbol =? 'rparen') {
        reader_ctx.stores.host[0].fatal(pos reader_ctx.stores.host[0].g_DC_TEST_USAGE());
    }
    if (((key.kind not=? 'identifier') or (rd_dn_payload(@reader_ctx key) not=? "cases")) or (reader_ctx.tokens[(int64<overflow='wrap'>(reader_ctx.at) + 1)].symbol not=? 'assign')) {
        if (((key.kind =? 'identifier') and (key.symbol =? 'none')) and (reader_ctx.tokens[(int64<overflow='wrap'>(reader_ctx.at) + 1)].symbol =? 'assign')) {
            reader_ctx.stores.host[0].fatal(rd_mkpos(reader_ctx.file key.start) reader_ctx.stores.host[0].g_DC_TEST_USAGE());
        }
        return 0
    }
    reader_ctx.at = (int64<overflow='wrap'>(reader_ctx.at) + 2)
    let n:int64=node_mk(@reader_nodes 'test_' pos)
    reader_nodes[n].aux = 1
    reader_nodes[n].ival = 1
    let opening:DewyLexeme=reader_ctx.tokens[reader_ctx.at]
    if (((opening.symbol =? 'lparen') or (opening.symbol =? 'lbrack')) and (not rd_dc_range_inside(@reader_ctx reader_ctx.at))) {
        reader_ctx.at = (int64<overflow='wrap'>(reader_ctx.at) + 1)
        let close:DewyToken=(if (opening.symbol =? 'lparen') 'rparen' else 'rbrack')
        let cases:array<int64>=[]
        loop (not rd_dn_accept(@reader_ctx close)) {
            let element:DewyLexeme=reader_ctx.tokens[reader_ctx.at]
            if (((element.kind =? 'eof') or (element.symbol =? 'comma')) or (element.symbol =? 'semi')) {
                return 0
            }
            let value:int64=rd_dc_expr(@reader_ctx @reader_nodes 0)
            if (value =? 0) {
                return 0
            }
            # (`[a=1 b=2]`: the case's arguments by name)
            let args:array<int64>=[value]
            if ((reader_nodes[value].kind =? 'record_lit') and (element.symbol =? 'lbrack')) {
                args = node_kids(@reader_nodes @reader_ctx.stores.lists[0] value)
                loop arg in args {
                    if ((reader_nodes[arg].kind not=? 'namedarg') or (reader_nodes[int64<overflow='wrap'>(reader_nodes[arg].a)].kind =? 'lambda')) {
                        return 0
                    }
                }
            }
            let case:int64=node_mk(@reader_nodes 'block' rd_mkpos(reader_ctx.file element.start))
            node_set_list(@reader_nodes @reader_ctx.stores.lists[0] case args);
            cases.push(case);
        }
        if (cases.length =? 0) {
            reader_ctx.stores.host[0].fatal(rd_mkpos(reader_ctx.file opening.start) "`$test(cases=…)` needs at least one case");
        }
        node_set_list(@reader_nodes @reader_ctx.stores.lists[0] n cases);
    }
    else {
        let value:int64=rd_dc_expr(@reader_ctx @reader_nodes 0)
        if (value =? 0) {
            return 0
        }
        reader_nodes[n].a = int32<overflow='wrap'>(value)
    }
    if (not rd_dn_accept(@reader_ctx 'rparen')) {
        return 0
    }
    n
}

# The token written at offset off, at or before dc_parser.at (-1 for none).
rd_dc_token_from=(@reader_ctx:ParserContext off:int64):>int64=>$unsafe {
    let k:int64=reader_ctx.at
    loop (k >=? 0) and (reader_ctx.tokens[k].start >? off) {
        k = (int64<overflow='wrap'>(k) - 1)
    }
    if ((k <? 0) or (reader_ctx.tokens[k].start not=? off)) {
        return (-1)
    }
    k
}

# (dn_expr's mistake, at once)
rd_dc_too_deep=(@reader_ctx:ParserContext):>int64=>$unsafe {
    if reader_ctx.flags.report_now {
        reader_ctx.stores.host[0].dn_error(reader_ctx.tokens[reader_ctx.at].start "expression is nested too deeply");
    }
    0
}

# The record's transfer tags, as dw_transfer_row records them, once its declaration is read.
rd_dc_transfer_apply=(@reader_ctx:ParserContext decl:int64):>void=>$unsafe {
    if (reader_ctx.reader.dc_transfer_bits =? 0) {
        return
    }
    reader_ctx.stores.host[0].g_transfer_tags_item_set(decl ((reader_ctx.stores.host[0].g_transfer_tags_get(decl) ?? 0) or reader_ctx.reader.dc_transfer_bits))
    if (reader_ctx.reader.dc_transfer_at not=? 0) {
        reader_ctx.stores.host[0].g_transfer_claim_pos_item_set(decl reader_ctx.reader.dc_transfer_at)
    }
    reader_ctx.reader.dc_transfer_bits = 0
    reader_ctx.reader.dc_transfer_at = 0
}

rd_dc_transfer_row=(@reader_ctx:ParserContext tag:DewyLexeme):>bool=>$unsafe {
    let name:string=rd_dn_payload(@reader_ctx tag)
    if (((name not=? "send") and (name not=? "sync")) and (name not=? "unsafe")) {
        return false
    }
    let at:int64=(int64<overflow='wrap'>(reader_ctx.at) + 1)
    let on:bool=true
    if (reader_ctx.tokens[at].symbol =? 'assign') {
        if (name =? "unsafe") {
            return false
        }
        if (reader_ctx.tokens[(int64<overflow='wrap'>(at) + 1)].kind not=? 'boolean') {
            return (rd_dc_transfer_value(@reader_ctx name reader_ctx.tokens[(int64<overflow='wrap'>(at) + 1)]) not=? 0)
        }
        on = (int64<overflow='wrap'>(reader_ctx.tokens[(int64<overflow='wrap'>(at) + 1)].name) =? reader_ctx.reader.dn_true_id)
        at = (int64<overflow='wrap'>(at) + 2)
    }
    let next:DewyLexeme=reader_ctx.tokens[at]
    if (not (((next.symbol =? 'rbrack') or (next.kind =? 'metatag')) or next.newline)) {
        return false
    }
    let bit:int64=0
    if (name =? "unsafe") {
        if ((next.kind not=? 'metatag') and (next.symbol not=? 'rbrack')) {
            return false
        }
        bit = reader_ctx.stores.host[0].g_TRANSFER_UNSAFE()
    }
    else if (name =? "send") {
        bit = (if on reader_ctx.stores.host[0].g_TRANSFER_SEND_CLAIM() else reader_ctx.stores.host[0].g_TRANSFER_SEND_OFF())
    }
    else {
        bit = (if on reader_ctx.stores.host[0].g_TRANSFER_SYNC_CLAIM() else reader_ctx.stores.host[0].g_TRANSFER_SYNC_OFF())
    }
    reader_ctx.reader.dc_transfer_bits = (reader_ctx.reader.dc_transfer_bits or bit)
    if ((bit =? reader_ctx.stores.host[0].g_TRANSFER_SEND_CLAIM()) or (bit =? reader_ctx.stores.host[0].g_TRANSFER_SYNC_CLAIM())) {
        reader_ctx.reader.dc_transfer_at = rd_mkpos(reader_ctx.file tag.start)
    }
    reader_ctx.at = at
    true
}

# (`$send=1`: dw_dir_boolean's mistake, should nothing else read it)
rd_dc_transfer_value=(@reader_ctx:ParserContext name:string value:DewyLexeme):>int64=>$unsafe {
    rd_dc_hint(@reader_ctx rd_mkpos(reader_ctx.file value.start) "`${name}` takes a literal true or false")
}

# `xs[0]<int64>`, `make().f<int64>` at the `<`: no type is named, only its arguments, each a type
# (dw_expr's type application).
rd_dc_type_applied=(@reader_ctx:ParserContext @reader_nodes:array<Node> left:int64 pos:int64):>int64=>$unsafe {
    reader_ctx.at = (int64<overflow='wrap'>(reader_ctx.at) + 1)
    let args:array<int64>=[]
    reader_ctx.reader.dc_type_args = (int64<overflow='wrap'>(reader_ctx.reader.dc_type_args) + 1)
    loop (not rd_dn_accept(@reader_ctx 'rangle')) {
        if (reader_ctx.reader.dn_edits_on and rd_dn_closer_joined(@reader_ctx)) {
            rd_dn_split_closer(@reader_ctx);
            break
        }
        let arg:int64=rd_dc_annotation(@reader_ctx @reader_nodes)
        if (arg =? 0) {
            reader_ctx.reader.dc_type_args = (int64<overflow='wrap'>(reader_ctx.reader.dc_type_args) - 1)
            return 0
        }
        args.push(arg);
    }
    reader_ctx.reader.dc_type_args = (int64<overflow='wrap'>(reader_ctx.reader.dc_type_args) - 1)
    let n:int64=node_mk(@reader_nodes 'typeapply' pos)
    reader_nodes[n].a = int32<overflow='wrap'>(left)
    node_set_list(@reader_nodes @reader_ctx.stores.lists[0] n args);
    n
}

rd_dc_type_arguments=(@reader_ctx:ParserContext @reader_nodes:array<Node> n0:int64 word:int64 opened:bool=false):>int64=>$unsafe {
    let n:int64=n0
    let pos:int64=reader_nodes[n].pos
    if (opened or ((not reader_ctx.tokens[reader_ctx.at].space) and rd_dn_accept(@reader_ctx 'langle'))) {
        let args:array<int64>=[]
        let length:int64=0
        let constraint:int64=0
        # (its dimensions, from here on dc_shapes)
        let shape:int64=reader_ctx.reader.dc_shapes.length
        loop true {
            # (`array<array<T>>`, `array<T>?`, `xs:array<T>=[]`: dn_bracketed_from's split)
            if (reader_ctx.reader.dn_edits_on and rd_dn_closer_joined(@reader_ctx)) {
                rd_dn_split_closer(@reader_ctx);
                break
            }
            if rd_dn_accept(@reader_ctx 'rangle') {
                break
            }
            # `array<T length=n>`, `T<overflow='wrap'>` (dw_type's type application)
            if rd_dc_named_next(@reader_ctx) {
                let setting:int64=rd_dc_word(@reader_ctx int64<overflow='wrap'>(reader_ctx.tokens[reader_ctx.at].name))
                reader_ctx.at = (int64<overflow='wrap'>(reader_ctx.at) + 2)
                # `array<T length=[m n]>`: a shape (dw_shape_type)
                if ((((((setting =? DC_LENGTH) and (word =? DC_ARRAY)) and (args.length =? 1)) and (length =? 0)) and (reader_ctx.reader.dc_shapes.length =? shape)) and (rd_dn_peek(@reader_ctx) =? 'lbrack')) {
                    reader_ctx.at = (int64<overflow='wrap'>(reader_ctx.at) + 1)
                    let saved_comma:bool=reader_ctx.flags.comma_stop
                    reader_ctx.flags.comma_stop = false
                    reader_ctx.reader.dn_angles = (int64<overflow='wrap'>(reader_ctx.reader.dn_angles) + 1)
                    let read:bool=true
                    loop read and (not rd_dn_accept(@reader_ctx 'rbrack')) {
                        let dim:int64=0
                        if ((rd_dn_peek(@reader_ctx) not=? 'semi') and (reader_ctx.tokens[reader_ctx.at].kind not=? 'eof')) {
                            dim = rd_dc_expr(@reader_ctx @reader_nodes 0)
                        }
                        if (dim =? 0) {
                            read = false
                        }
                        else {
                            reader_ctx.reader.dc_shapes.push(dim);
                        }
                    }
                    reader_ctx.reader.dn_angles = (int64<overflow='wrap'>(reader_ctx.reader.dn_angles) - 1)
                    reader_ctx.flags.comma_stop = saved_comma
                    if (((not read) or (reader_ctx.reader.dc_shapes.length =? shape)) or (not rd_dc_closes(@reader_ctx))) {
                        reader_ctx.reader.dc_shapes.truncate(shape);
                        return 0
                    }
                    continue
                }
                if (((((setting =? DC_LENGTH) and (word =? DC_ARRAY)) and (args.length =? 1)) and (length =? 0)) and (rd_dn_peek(@reader_ctx) not=? 'lbrack')) {
                    let saved_comma:bool=reader_ctx.flags.comma_stop
                    reader_ctx.flags.comma_stop = false
                    reader_ctx.reader.dn_angles = (int64<overflow='wrap'>(reader_ctx.reader.dn_angles) + 1)
                    length = rd_dc_expr(@reader_ctx @reader_nodes (int64<overflow='wrap'>(dn_power('assign')) + 1))
                    reader_ctx.reader.dn_angles = (int64<overflow='wrap'>(reader_ctx.reader.dn_angles) - 1)
                    reader_ctx.flags.comma_stop = saved_comma
                    if (length =? 0) {
                        return 0
                    }
                    # (`array<int64 length=2 length=3>`: dw_type's mistake, should nothing else read it)
                    if ((not rd_dc_closes(@reader_ctx)) and dn_can_start(@reader_ctx.tokens reader_ctx.at)) {
                        let again:DewyLexeme=reader_ctx.tokens[reader_ctx.at]
                        if ((((again.kind =? 'identifier') and (again.symbol =? 'none')) and (rd_dc_word(@reader_ctx int64<overflow='wrap'>(again.name)) =? DC_LENGTH)) and (reader_ctx.tokens[(int64<overflow='wrap'>(reader_ctx.at) + 1)].symbol =? 'assign')) {
                            let once:string=reader_ctx.stores.host[0].bytes_slice(reader_ctx.source rd_pos_off(pos) reader_ctx.tokens[(int64<overflow='wrap'>(reader_ctx.at) - 1)].stop)
                            return rd_dc_hint(@reader_ctx pos "array length may be specified once: use `{once}>`")
                        }
                        return rd_dc_hint(@reader_ctx pos "Dewy does not yet support array type constraints; use array<T> or array<T length=N>")
                    }
                    if (not rd_dc_closes(@reader_ctx)) {
                        return 0
                    }
                    continue
                }
                # (`array<int64 length=2 length=3>`: dw_type's mistake, should nothing else read it)
                if (((word =? DC_ARRAY) and (args.length =? 1)) and (((length not=? 0) or (constraint not=? 0)) or (reader_ctx.reader.dc_shapes.length >? shape))) {
                    return rd_dc_hint(@reader_ctx pos "Dewy does not yet support array type constraints; use array<T> or array<T length=N>")
                }
                # (`array<int64 capacity=2>`: dw_type's mistake, noted; the value read)
                if ((((word =? DC_ARRAY) and (setting not=? DC_OVERFLOW)) and reader_ctx.flags.report_now) and (rd_dc_array_constraint(@reader_ctx @reader_nodes) not=? 0)) {
                    continue
                }
                if ((setting not=? DC_OVERFLOW) or ((word >=? DC_ARRAY) and (word <=? DC_TOTALDICT))) {
                    return 0
                }
                let policy:int64=rd_dc_policy(@reader_ctx reader_ctx.tokens[reader_ctx.at])
                # (`uint8<overflow='wrapping'>`, a second policy: dw_type's mistakes, should nothing
                # else read the type)
                if ((policy =? 0) or (reader_nodes[n].aux =? (-9))) {
                    return rd_dc_policy_mistake(@reader_ctx policy)
                }
                reader_ctx.at = (int64<overflow='wrap'>(reader_ctx.at) + 1)
                if (not rd_dc_closes(@reader_ctx)) {
                    # (a second policy: dw_type's mistakes, should nothing else read the type)
                    if (rd_dc_named_next(@reader_ctx) and (rd_dc_word(@reader_ctx int64<overflow='wrap'>(reader_ctx.tokens[reader_ctx.at].name)) =? DC_OVERFLOW)) {
                        reader_ctx.at = (int64<overflow='wrap'>(reader_ctx.at) + 2)
                        rd_dc_policy_mistake(@reader_ctx rd_dc_policy(@reader_ctx reader_ctx.tokens[reader_ctx.at]));
                    }
                    return 0
                }
                let wrapper:int64=node_mk(@reader_nodes 'tname' pos)
                reader_nodes[wrapper].aux = (-9)
                reader_nodes[wrapper].a = int32<overflow='wrap'>(n)
                reader_nodes[wrapper].ival = policy
                n = wrapper
                continue
            }
            # `array<T length >? 0>`: a condition on the array (dw_type's array constraint)
            if ((((word =? DC_ARRAY) and (args.length =? 1)) and (length =? 0)) and (reader_ctx.reader.dc_shapes.length =? shape)) {
                reader_ctx.reader.dn_angles = (int64<overflow='wrap'>(reader_ctx.reader.dn_angles) + 1)
                let predicate:int64=rd_dc_ref_predicate_read(@reader_ctx @reader_nodes 0)
                reader_ctx.reader.dn_angles = (int64<overflow='wrap'>(reader_ctx.reader.dn_angles) - 1)
                if (((predicate =? 0) or rd_dc_membership(@reader_nodes predicate)) or (not rd_dc_closes(@reader_ctx))) {
                    return 0
                }
                let tested:int64=predicate
                if (reader_nodes[tested].kind =? 'not_') {
                    tested = int64<overflow='wrap'>(reader_nodes[tested].a)
                }
                if (not ((reader_nodes[predicate].kind =? 'and_') or ((reader_nodes[tested].kind =? 'binary') and (rd_dc_comparison(int64<overflow='wrap'>(reader_nodes[tested].op)) or (reader_nodes[tested].op =? int32<overflow='wrap'>(int64<overflow='wrap'>(int64(12)))))))) {
                    return 0
                }
                constraint = predicate
                continue
            }
            # `int64<(>? 0)>`, `addr<(<? xs.length)>`, `int64<i => 0 <=? i>`: a refinement
            if (((word =? 0) or (word =? DC_ADDR)) and rd_dc_refinement_next(@reader_ctx)) {
                let refined:int64=rd_dc_refinement(@reader_ctx @reader_nodes n)
                if (refined =? 0) {
                    return 0
                }
                n = refined
                continue
            }
            let arg_start:int64=reader_ctx.at
            let arg_nodes:int64=reader_nodes.length
            let arg_lists:int64=reader_ctx.stores.lists[0].length
            let arg_edits:int64=reader_ctx.reader.dn_edit_at.length
            reader_ctx.reader.dc_type_args = (int64<overflow='wrap'>(reader_ctx.reader.dc_type_args) + 1)
            let child:int64=rd_dc_annotation(@reader_ctx @reader_nodes)
            reader_ctx.reader.dc_type_args = (int64<overflow='wrap'>(reader_ctx.reader.dc_type_args) - 1)
            if (((child =? 0) and ((word =? 0) or (word =? DC_ADDR))) and (args.length =? 0)) {
                # `int64<0 <=? x and x <=? 255>`: a condition on the value (its binder the field's,
                # the declaration's or the arm's, dw_pattern_binder)
                reader_ctx.at = arg_start
                reader_nodes.truncate(arg_nodes);
                reader_ctx.stores.lists[0].truncate(arg_lists);
                rd_dn_edits_undo(@reader_ctx arg_edits);
                let refined:int64=rd_dc_condition(@reader_ctx @reader_nodes n)
                if (refined =? 0) {
                    return 0
                }
                n = refined
                continue
            }
            if (child =? 0) {
                return 0
            }
            args.push(child);
        }
        if (reader_ctx.reader.dc_shapes.length >? shape) {
            let dims:array<int64>=reader_ctx.reader.dc_shapes[shape..reader_ctx.reader.dc_shapes.length)
            reader_ctx.reader.dc_shapes.truncate(shape);
            reader_nodes[n].kind = 'tarray'
            reader_nodes[n].name = 0
            reader_nodes[n].a = int32<overflow='wrap'>(args[0])
            reader_nodes[n].aux = int32<overflow='wrap'>(dims.length)
            reader_nodes[n].ival = 1
            node_set_list(@reader_nodes @reader_ctx.stores.lists[0] n dims);
        }
        else if (length not=? 0) {
            reader_nodes[n].kind = 'tarray'
            reader_nodes[n].name = 0
            reader_nodes[n].a = int32<overflow='wrap'>(args[0])
            reader_nodes[n].b = int32<overflow='wrap'>(length)
        }
        else if (word =? DC_ARRAY) {
            if (args.length not=? 1) {
                return 0
            }
            reader_nodes[n].kind = 'tarray'
            reader_nodes[n].name = 0
            reader_nodes[n].a = int32<overflow='wrap'>(args[0])
            if (constraint not=? 0) {
                reader_ctx.stores.host[0].g_refine_active_set(true)
                let qualified:int64=node_mk(@reader_nodes 'trefined' pos)
                reader_nodes[qualified].a = int32<overflow='wrap'>(n)
                reader_nodes[qualified].b = int32<overflow='wrap'>(rd_dc_ref_predicate(@reader_nodes constraint))
                return qualified
            }
        }
        else if (word =? DC_PTR) {
            if (args.length not=? 1) {
                return 0
            }
            reader_nodes[n].kind = 'tptr'
            reader_nodes[n].name = 0
            reader_nodes[n].a = int32<overflow='wrap'>(args[0])
        }
        else if ((word =? DC_DICT) or (word =? DC_TOTALDICT)) {
            if (args.length not=? 2) {
                return 0
            }
            reader_nodes[n].kind = 'tmap'
            reader_nodes[n].name = 0
            reader_nodes[n].a = int32<overflow='wrap'>(args[0])
            reader_nodes[n].b = int32<overflow='wrap'>(args[1])
            if (word =? DC_TOTALDICT) {
                reader_ctx.stores.host[0].g_refine_active_set(true)
                reader_nodes[n].aux = 1
            }
        }
        else if (args.length >? 0) {
            # (type arguments on a refinement: dw_type reports them)
            if ((reader_nodes[n].kind not=? 'tname') or (rd_nkids(@reader_nodes n) not=? 0)) {
                return 0
            }
            node_set_list(@reader_nodes @reader_ctx.stores.lists[0] n args);
        }
    }
    n
}

# `Name:type = [field:T  field:T=default  field=default]`, a record without
# methods, lifecycle tags or type parameters; `Name:type = T|U` an alias; `Name = type of Base`,
# `Name = type of [fields]` or `Name = type of Base & [fields]` (`:type` or not), a nominal type.
rd_dc_type_declaration=(@reader_ctx:ParserContext @reader_nodes:array<Node>):>int64=>$unsafe {
    # `small = int64<i => 0 <=? i>`: a refinement names a type (dw_top_declarations, dw_declare)
    let refined:int64=rd_dc_refinement_alias(@reader_ctx @reader_nodes)
    if (refined not=? 0) {
        return refined
    }
    # (`let Name:type = ...` declares it too, dw_declare)
    let word:DewyToken=reader_ctx.tokens[reader_ctx.at].symbol
    if (((word =? 'kw_let') or (word =? 'kw_const')) and (reader_ctx.tokens[(int64<overflow='wrap'>(reader_ctx.at) + 2)].symbol =? 'colon')) {
        reader_ctx.at = (int64<overflow='wrap'>(reader_ctx.at) + 1)
    }
    let after:DewyToken=reader_ctx.tokens[(int64<overflow='wrap'>(reader_ctx.at) + 1)].symbol
    if ((after not=? 'colon') and (after not=? 'assign')) {
        return 0
    }
    let token:DewyLexeme=reader_ctx.tokens[reader_ctx.at]
    if (((token.kind not=? 'identifier') or ((token.symbol not=? 'none') and (token.symbol not=? 'kw_test'))) or rd_dn_reserved(@reader_ctx int64<overflow='wrap'>(token.name))) {
        return 0
    }
    let annotated:bool=((((reader_ctx.tokens[(int64<overflow='wrap'>(reader_ctx.at) + 1)].symbol =? 'colon') and (reader_ctx.tokens[(int64<overflow='wrap'>(reader_ctx.at) + 2)].kind =? 'identifier')) and (reader_ctx.tokens[(int64<overflow='wrap'>(reader_ctx.at) + 2)].name =? int32<overflow='wrap'>(reader_ctx.reader.dn_type_id))) and (reader_ctx.tokens[(int64<overflow='wrap'>(reader_ctx.at) + 3)].symbol =? 'assign'))
    # (`E = (type of error) & [...]`: the nominal type grouped, dw_declare's mint)
    let minted:bool=((reader_ctx.tokens[(int64<overflow='wrap'>(reader_ctx.at) + 1)].symbol =? 'assign') and (rd_dc_mint_at(@reader_ctx (int64<overflow='wrap'>(reader_ctx.at) + 2)) or ((reader_ctx.tokens[(int64<overflow='wrap'>(reader_ctx.at) + 2)].symbol =? 'lparen') and rd_dc_mint_at(@reader_ctx (int64<overflow='wrap'>(reader_ctx.at) + 3)))))
    if ((not annotated) and (not minted)) {
        return 0
    }
    reader_ctx.reader.dc_methods.clear();
    reader_ctx.reader.dc_method_hooks.clear();
    reader_ctx.at = (int64<overflow='wrap'>(reader_ctx.at) + int64<overflow='wrap'>((if annotated int64(4) else int64(2))))
    let pos:int64=rd_mkpos(reader_ctx.file token.start)
    let grouped:bool=((reader_ctx.tokens[reader_ctx.at].symbol =? 'lparen') and rd_dc_mint_at(@reader_ctx (int64<overflow='wrap'>(reader_ctx.at) + 1)))
    if grouped {
        reader_ctx.at = (int64<overflow='wrap'>(reader_ctx.at) + 1)
    }
    if rd_dc_mint_at(@reader_ctx reader_ctx.at) {
        reader_ctx.at = (int64<overflow='wrap'>(reader_ctx.at) + 2)
        let n:int64=node_mk(@reader_nodes 'struct_' pos)
        reader_nodes[n].name = token.name
        let names:array<int64>=[]
        if ((rd_dn_peek(@reader_ctx) =? 'lbrack') and (not grouped)) {
            reader_ctx.at = (int64<overflow='wrap'>(reader_ctx.at) + 1)
            if (not rd_dc_record_fields(@reader_ctx @reader_nodes n @names)) {
                return 0
            }
        }
        else {
            let base:int64=rd_dc_type_named(@reader_ctx @reader_nodes)
            if (((base =? 0) or (reader_nodes[base].kind not=? 'tname')) or (rd_nkids(@reader_nodes base) not=? 0)) {
                return 0
            }
            if (grouped and (not rd_dn_accept(@reader_ctx 'rparen'))) {
                return 0
            }
            reader_nodes[n].a = int32<overflow='wrap'>(base)
            if rd_dn_accept(@reader_ctx 'amp') {
                if ((not rd_dn_accept(@reader_ctx 'lbrack')) or (not rd_dc_record_fields(@reader_ctx @reader_nodes n @names))) {
                    return 0
                }
            }
            else {
                node_set_list(@reader_nodes @reader_ctx.stores.lists[0] n []);
            }
        }
        if ((not rd_dc_statement_ends(@reader_ctx)) or (not rd_dc_record_members(@reader_ctx @reader_nodes n names))) {
            return 0
        }
        rd_dc_transfer_apply(@reader_ctx n);
        return n
    }
    if (not annotated) {
        return 0
    }
    # `Name:type = A & B & [f:T]`: a record with the fields of each (dw_intersection)
    if rd_dc_intersection_next(@reader_ctx) {
        return rd_dc_intersection(@reader_ctx @reader_nodes token pos)
    }
    # `Name:type = <T U>[fields]`: a generic record (dw_type_params)
    let type_params:array<int64>=[]
    # (`<T>[...]`: type parameters, plain names then a record; `<(x:T):>R>`, `<'a' | 1>`: an alias)
    if ((((rd_dn_peek(@reader_ctx) =? 'langle') and (reader_ctx.tokens[(int64<overflow='wrap'>(reader_ctx.at) + 1)].kind =? 'identifier')) and (reader_ctx.tokens[(int64<overflow='wrap'>(reader_ctx.at) + 1)].symbol =? 'none')) and (((reader_ctx.tokens[(int64<overflow='wrap'>(reader_ctx.at) + 2)].symbol =? 'rangle') or (reader_ctx.tokens[(int64<overflow='wrap'>(reader_ctx.at) + 2)].kind =? 'identifier')) or ((reader_ctx.tokens[(int64<overflow='wrap'>(reader_ctx.at) + 2)].symbol =? 'colon') and (rd_dn_payload(@reader_ctx reader_ctx.tokens[(int64<overflow='wrap'>(reader_ctx.at) + 3)]) =? "Effect")))) {
        reader_ctx.at = (int64<overflow='wrap'>(reader_ctx.at) + 1)
        loop (not rd_dn_accept(@reader_ctx 'rangle')) {
            let binder:DewyLexeme=reader_ctx.tokens[reader_ctx.at]
            if ((((binder.kind not=? 'identifier') or (binder.symbol not=? 'none')) or rd_dn_reserved(@reader_ctx int64<overflow='wrap'>(binder.name))) or (rd_dc_word(@reader_ctx int64<overflow='wrap'>(binder.name)) =? DC_HOLE)) {
                return 0
            }
            loop seen in type_params {
                if (reader_nodes[seen].name =? binder.name) {
                    return 0
                }
            }
            reader_ctx.at = (int64<overflow='wrap'>(reader_ctx.at) + 1)
            let t:int64=node_mk(@reader_nodes 'ident' rd_mkpos(reader_ctx.file binder.start))
            reader_nodes[t].name = binder.name
            if rd_dc_effect_param(@reader_ctx) {
                reader_nodes[t].aux = 1
            }
            type_params.push(t);
        }
        if ((type_params.length =? 0) or reader_ctx.tokens[reader_ctx.at].space) {
            return 0
        }
        # `Pair:type = <T>(array<T length=2>)`: a generic alias of the one type in parentheses
        if rd_dn_accept(@reader_ctx 'lparen') {
            let alias:int64=rd_dc_annotation(@reader_ctx @reader_nodes)
            if (((alias =? 0) or (not rd_dn_accept(@reader_ctx 'rparen'))) or (dn_power(rd_dn_peek(@reader_ctx)) >? 0)) {
                return 0
            }
            let n:int64=node_mk(@reader_nodes 'typealias' pos)
            reader_nodes[n].name = token.name
            reader_nodes[n].a = int32<overflow='wrap'>(alias)
            node_set_list2(@reader_nodes @reader_ctx.stores.lists[0] n type_params);
            rd_add_flag(@reader_nodes n NF_GENERIC);
            rd_dn_accept_semi(@reader_ctx);
            return n
        }
        if (rd_dn_peek(@reader_ctx) not=? 'lbrack') {
            return 0
        }
    }
    # (`Entry:type = [int64 string]`: a type per position, an alias, dw_positional_types)
    let positional:bool=false
    if ((rd_dn_peek(@reader_ctx) =? 'lbrack') and (type_params.length =? 0)) {
        let first:DewyLexeme=reader_ctx.tokens[(int64<overflow='wrap'>(reader_ctx.at) + 1)]
        positional = (((((first.symbol not=? 'rbrack') and (first.kind not=? 'metatag')) and (first.symbol not=? 'at')) and (reader_ctx.tokens[(int64<overflow='wrap'>(reader_ctx.at) + 2)].symbol not=? 'colon')) and (reader_ctx.tokens[(int64<overflow='wrap'>(reader_ctx.at) + 2)].symbol not=? 'assign'))
    }
    if ((rd_dn_peek(@reader_ctx) not=? 'lbrack') or positional) {
        # `Apply:type = (x:int64):>int64`: a function type without its angle brackets (dw_type's `:>`)
        let alias:int64=0
        let alias_at:int64=reader_ctx.at
        if ((rd_dn_peek(@reader_ctx) =? 'lparen') and (reader_ctx.tokens[(int64<overflow='wrap'>(rd_dc_closing(@reader_ctx reader_ctx.at)) + 1)].symbol =? 'returns')) {
            alias = rd_dc_function_type(@reader_ctx @reader_nodes false)
        }
        else {
            alias = rd_dc_annotation(@reader_ctx @reader_nodes)
        }
        if ((alias =? 0) or (dn_power(rd_dn_peek(@reader_ctx)) >? 0)) {
            return rd_dc_untyped(@reader_ctx alias_at)
        }
        let n:int64=node_mk(@reader_nodes 'typealias' pos)
        reader_nodes[n].name = token.name
        reader_nodes[n].a = int32<overflow='wrap'>(alias)
        rd_dn_accept_semi(@reader_ctx);
        return n
    }
    reader_ctx.at = (int64<overflow='wrap'>(reader_ctx.at) + 1)
    let n:int64=node_mk(@reader_nodes 'struct_' pos)
    reader_nodes[n].name = token.name
    if (type_params.length >? 0) {
        node_set_list2(@reader_nodes @reader_ctx.stores.lists[0] n type_params);
        rd_add_flag(@reader_nodes n NF_GENERIC);
    }
    let names:array<int64>=[]
    if ((not rd_dc_record_fields(@reader_ctx @reader_nodes n @names)) or (dn_power(rd_dn_peek(@reader_ctx)) >? 0)) {
        return 0
    }
    rd_dn_accept_semi(@reader_ctx);
    if (not rd_dc_record_members(@reader_ctx @reader_nodes n names)) {
        return 0
    }
    rd_dc_transfer_apply(@reader_ctx n);
    n
}

rd_dc_type_default=(@reader_ctx:ParserContext @reader_nodes:array<Node> label:DewyLexeme):>int64=>$unsafe {
    rd_dc_unsupported(@reader_ctx rd_mkpos(reader_ctx.file label.start) "defaults in a function type; declare defaults on a directly called function");
    reader_ctx.at = (int64<overflow='wrap'>(reader_ctx.at) + 1)
    rd_dc_expr(@reader_ctx @reader_nodes 11)
}

rd_dc_type_factor=(@reader_ctx:ParserContext @reader_nodes:array<Node>):>int64=>$unsafe {
    let pos:int64=rd_mkpos(reader_ctx.file reader_ctx.tokens[reader_ctx.at].start)
    let n:int64=rd_dc_type_primary(@reader_ctx @reader_nodes)
    if (n =? 0) {
        return 0
    }
    rd_dc_type_power(@reader_ctx @reader_nodes n pos)
}

# `(int64 int64)` after its first type: several values' types through `)` (dw_type's group of two
# or more).
rd_dc_type_group=(@reader_ctx:ParserContext @reader_nodes:array<Node> first:int64 pos:int64):>int64=>$unsafe {
    let members:array<int64>=[first]
    loop (not rd_dn_accept(@reader_ctx 'rparen')) {
        if (reader_ctx.tokens[reader_ctx.at].kind =? 'eof') {
            return 0
        }
        let member:int64=rd_dc_annotation(@reader_ctx @reader_nodes)
        if (member =? 0) {
            return 0
        }
        members.push(member);
    }
    let n:int64=node_mk(@reader_nodes 'ttuple' pos)
    reader_nodes[n].aux = int32<overflow='wrap'>(TUPLE_VALUES)
    node_set_list(@reader_nodes @reader_ctx.stores.lists[0] n members);
    n
}

# A union's member: a type (its node, kept in others too), a plain string literal (its text in
# texts once) or an integer (its value in ints once): 0 for a literal. -1: none of these.
rd_dc_type_member=(@reader_ctx:ParserContext @reader_nodes:array<Node> @texts:array<string> @ints:array<int64> @others:array<int64>):>int64=>$unsafe {
    let token:DewyLexeme=reader_ctx.tokens[reader_ctx.at]
    # (`('b' | 'a')`: a group's members are the union's, dw_pipe_leaves)
    if (token.symbol =? 'lparen') {
        reader_ctx.at = (int64<overflow='wrap'>(reader_ctx.at) + 1)
        loop true {
            if (rd_dc_type_member(@reader_ctx @reader_nodes @texts @ints @others) <? 0) {
                return (-1)
            }
            if (rd_dn_peek(@reader_ctx) not=? 'pipe') {
                break
            }
            reader_ctx.at = (int64<overflow='wrap'>(reader_ctx.at) + 1)
        }
        if (not rd_dn_accept(@reader_ctx 'rparen')) {
            return (-1)
        }
        return 0
    }
    if ((token.kind =? 'quoted') or (token.kind =? 'rawquoted')) {
        if ((token.kind =? 'quoted') and (not rd_dc_plain_quote(@reader_ctx token))) {
            return (-1)
        }
        let literal:int64=rd_dn_string(@reader_ctx @reader_nodes token)
        if (literal =? 0) {
            return (-1)
        }
        reader_ctx.at = (int64<overflow='wrap'>(reader_ctx.at) + 1)
        let text:string=rd_name_of(@reader_ctx int64<overflow='wrap'>(reader_nodes[literal].sval))
        if (not (text in? texts)) {
            texts.push(text);
        }
        return 0
    }
    let leaf:int64=rd_dc_int_leaf(@reader_ctx reader_ctx.at)
    if (leaf >? 0) {
        let before:int64=reader_ctx.at
        let value:int64=rd_dc_atom(@reader_ctx @reader_nodes)
        # (beyond int64: dw_int_singletons reports it)
        if ((((value =? 0) or (reader_ctx.at not=? (int64<overflow='wrap'>(before) + int64<overflow='wrap'>(leaf)))) or (reader_nodes[value].kind not=? 'int_lit')) or rd_has_flag(@reader_nodes value NF_U64)) {
            return (-1)
        }
        if (not (reader_nodes[value].ival in? ints)) {
            ints.push(reader_nodes[value].ival);
        }
        return 0
    }
    let n:int64=rd_dc_type_term(@reader_ctx @reader_nodes)
    if (n =? 0) {
        return (-1)
    }
    others.push(n);
    n
}

rd_dc_type_named=(@reader_ctx:ParserContext @reader_nodes:array<Node>):>int64=>$unsafe {
    let token:DewyLexeme=reader_ctx.tokens[reader_ctx.at]
    if (((token.kind not=? 'identifier') or ((token.symbol not=? 'none') and (token.symbol not=? 'kw_test'))) or (token.name =? 0)) {
        return 0
    }
    let id:int64=int64<overflow='wrap'>(token.name)
    # `net.NetError`: a module's type (dw_type's `.`)
    if (((reader_ctx.tokens[(int64<overflow='wrap'>(reader_ctx.at) + 1)].symbol =? 'dot') and (reader_ctx.tokens[(int64<overflow='wrap'>(reader_ctx.at) + 2)].kind =? 'identifier')) and (reader_ctx.tokens[(int64<overflow='wrap'>(reader_ctx.at) + 2)].symbol =? 'none')) {
        return rd_dc_module_type(@reader_ctx @reader_nodes token)
    }
    let spelled:int64=rd_dc_type_spelled(@reader_ctx id)
    if (spelled <? 0) {
        return rd_dc_unspelled(@reader_ctx token)
    }
    let word:int64=rd_dc_word(@reader_ctx id)
    if (word =? DC_ADDR) {
        reader_ctx.stores.host[0].g_refine_active_set(true)
    }
    # Parameter refinements use the existing annotation parser. Keeping the
    # declaration direct lets its body remain lazy instead of expanding it.
    # (an overflow policy alone, `uint32<overflow='wrap'>`, is no refinement)
    if (((((reader_ctx.reader.dc_parameter_type and (word =? 0)) and (not reader_ctx.tokens[(int64<overflow='wrap'>(reader_ctx.at) + 1)].space)) and (reader_ctx.tokens[(int64<overflow='wrap'>(reader_ctx.at) + 1)].symbol =? 'langle')) and (not rd_dc_policy_only(@reader_ctx))) and rd_dc_integer_name(@reader_ctx id)) {
        return rd_dc_refined_parameter(@reader_ctx @reader_nodes)
    }
    reader_ctx.at = (int64<overflow='wrap'>(reader_ctx.at) + 1)
    let n:int64=node_mk(@reader_nodes 'tname' rd_mkpos(reader_ctx.file token.start))
    reader_nodes[n].name = int32<overflow='wrap'>(spelled)
    if reader_ctx.tokens[reader_ctx.at].space {
        return n
    }
    if (reader_ctx.tokens[reader_ctx.at].symbol =? 'langle') {
        n = rd_dc_type_arguments(@reader_ctx @reader_nodes n word)
        # (`array<int64><0 <? length>`: a condition on the array type, dw_type's refined application)
        if ((((n not=? 0) and (word =? DC_ARRAY)) and (rd_dn_peek(@reader_ctx) =? 'langle')) and (not reader_ctx.tokens[reader_ctx.at].space)) {
            n = rd_dc_type_arguments(@reader_ctx @reader_nodes n 0)
        }
        return n
    }
    if rd_dc_double_angle(@reader_ctx) {
        return rd_dc_type_arguments(@reader_ctx @reader_nodes n word true)
    }
    n
}

# `<T U>(` at `<`: a function's type parameters (dw_type_params), through the `(` opening its
# parameters; empty for any other form.
rd_dc_type_params=(@reader_ctx:ParserContext @reader_nodes:array<Node>):>array<int64>=>$unsafe {
    let opening:DewyLexeme=reader_ctx.tokens[reader_ctx.at]
    if (not rd_dn_accept(@reader_ctx 'langle')) {
        return []
    }
    let type_params:array<int64>=[]
    loop (not rd_dn_accept(@reader_ctx 'rangle')) {
        let binder:DewyLexeme=reader_ctx.tokens[reader_ctx.at]
        # (dw_type_params' mistakes: `<T of int64>`, a reserved word, `<T T>`)
        if (binder.symbol =? 'kw_of') {
            rd_dc_fail_now(@reader_ctx rd_mkpos(reader_ctx.file binder.start) "Dewy does not yet support constrained type parameters; use plain type parameter names");
            return []
        }
        if (((binder.kind not=? 'identifier') or (binder.symbol not=? 'none')) or (rd_dc_word(@reader_ctx int64<overflow='wrap'>(binder.name)) =? DC_HOLE)) {
            return []
        }
        if rd_dn_reserved(@reader_ctx int64<overflow='wrap'>(binder.name)) {
            rd_dc_reserved_at(@reader_ctx binder);
        }
        loop seen in type_params {
            if (reader_nodes[seen].name =? binder.name) {
                rd_dc_fail_now(@reader_ctx rd_mkpos(reader_ctx.file binder.start) "duplicate type parameter '{rd_dn_payload(@reader_ctx binder)}'");
                return []
            }
        }
        reader_ctx.at = (int64<overflow='wrap'>(reader_ctx.at) + 1)
        let t:int64=node_mk(@reader_nodes 'ident' rd_mkpos(reader_ctx.file binder.start))
        reader_nodes[t].name = binder.name
        # (`<E:Effect>`: an effect row's parameter, dw_type_params)
        if rd_dc_effect_param(@reader_ctx) {
            reader_nodes[t].aux = 1
        }
        type_params.push(t);
    }
    if (((type_params.length =? 0) and (reader_ctx.tokens[reader_ctx.at].symbol =? 'lparen')) and (not reader_ctx.tokens[reader_ctx.at].space)) {
        rd_dc_fail_now(@reader_ctx rd_mkpos(reader_ctx.file opening.start) "Dewy does not yet support an empty type parameter declaration");
        return []
    }
    if (((type_params.length =? 0) or reader_ctx.tokens[reader_ctx.at].space) or (not rd_dn_accept(@reader_ctx 'lparen'))) {
        return []
    }
    type_params
}

rd_dc_type_power=(@reader_ctx:ParserContext @reader_nodes:array<Node> n:int64 pos:int64):>int64=>$unsafe {
    if (rd_dn_peek(@reader_ctx) not=? 'caret') {
        return n
    }
    reader_ctx.at = (int64<overflow='wrap'>(reader_ctx.at) + 1)
    let exponent:int64=rd_dc_expr(@reader_ctx @reader_nodes 140)
    if (exponent =? 0) {
        return 0
    }
    let q:int64=node_mk(@reader_nodes 'tquantity' pos)
    reader_nodes[q].op = int32<overflow='wrap'>(int64<overflow='wrap'>(int64(65)))
    reader_nodes[q].a = int32<overflow='wrap'>(n)
    reader_nodes[q].b = int32<overflow='wrap'>(exponent)
    q
}

# A named type with optional type arguments, a grouped type `(A | B)`, a record type
# `[x:T y:U]` or `[T U]`, or a function type `<(x:T):>R>`; then `?` suffixes.
rd_dc_type_primary=(@reader_ctx:ParserContext @reader_nodes:array<Node>):>int64=>$unsafe {
    let token:DewyLexeme=reader_ctx.tokens[reader_ctx.at]
    let n:int64=0
    if ((token.kind =? 'identifier') and rd_dc_effect_atom_at(@reader_ctx reader_ctx.at)) {
        return rd_dc_effect_type(@reader_ctx @reader_nodes token)
    }
    if (token.kind =? 'identifier') {
        n = rd_dc_type_named(@reader_ctx @reader_nodes)
    }
    else if (((token.symbol =? 'lparen') and (reader_ctx.reader.dc_type_args >? 0)) and (reader_ctx.tokens[(int64<overflow='wrap'>(rd_dc_closing(@reader_ctx reader_ctx.at)) + 1)].symbol =? 'returns')) {
        # `array<():>int64>`: a type argument may be a function type without its own angle brackets
        n = rd_dc_function_type(@reader_ctx @reader_nodes false)
    }
    else if ((((token.symbol =? 'lparen') and (reader_ctx.tokens[(int64<overflow='wrap'>(reader_ctx.at) + 1)].symbol =? 'lparen')) and (reader_ctx.tokens[(int64<overflow='wrap'>(rd_dc_closing(@reader_ctx (int64<overflow='wrap'>(reader_ctx.at) + 1))) + 1)].symbol =? 'returns')) and reader_ctx.flags.report_now) {
        n = rd_dc_paren_function_type(@reader_ctx @reader_nodes token)
        if (n =? 0) {
            return 0
        }
    }
    else if (token.symbol =? 'lparen') {
        # (dw_type of its one element; a joined closer cannot end a type in it)
        reader_ctx.at = (int64<overflow='wrap'>(reader_ctx.at) + 1)
        let saved:int64=reader_ctx.reader.dc_type_args
        reader_ctx.reader.dc_type_args = 0
        let saved_literal:bool=reader_ctx.reader.dc_literal_seen
        reader_ctx.reader.dc_literal_seen = false
        n = rd_dc_annotation(@reader_ctx @reader_nodes)
        if ((n not=? 0) and (not rd_dn_accept(@reader_ctx 'rparen'))) {
            n = rd_dc_type_group(@reader_ctx @reader_nodes n rd_mkpos(reader_ctx.file token.start))
        }
        reader_ctx.reader.dc_type_args = saved
        let literal:bool=reader_ctx.reader.dc_literal_seen
        reader_ctx.reader.dc_literal_seen = saved_literal
        # (a group holding a literal flattens into the union around it: dc_annotation reads
        # it again as one, dw_pipe_leaves)
        reader_ctx.reader.dc_grouped_literal = literal
        if ((n =? 0) or literal) {
            return 0
        }
        reader_ctx.reader.dc_grouped = n
    }
    else if ((token.symbol =? 'lbrack') or ((token.symbol =? 'langle') and (reader_ctx.tokens[(int64<overflow='wrap'>(reader_ctx.at) + 1)].symbol =? 'lparen'))) {
        # (inside, a joined closer ends no type argument)
        let saved:int64=reader_ctx.reader.dc_type_args
        reader_ctx.reader.dc_type_args = 0
        n = (if (token.symbol =? 'lbrack') rd_dc_record_type(@reader_ctx @reader_nodes) else rd_dc_function_type(@reader_ctx @reader_nodes))
        reader_ctx.reader.dc_type_args = saved
    }
    else if (token.symbol =? 'langle') {
        # `<int64 | string>`, `<'fast' | 1>`: a type in angle brackets is that type (dw_type's `<>`)
        reader_ctx.at = (int64<overflow='wrap'>(reader_ctx.at) + 1)
        reader_ctx.reader.dc_type_args = (int64<overflow='wrap'>(reader_ctx.reader.dc_type_args) + 1)
        n = rd_dc_annotation(@reader_ctx @reader_nodes)
        reader_ctx.reader.dc_type_args = (int64<overflow='wrap'>(reader_ctx.reader.dc_type_args) - 1)
        if (n =? 0) {
            return 0
        }
        if (not rd_dn_accept(@reader_ctx 'rangle')) {
            if (not (reader_ctx.reader.dn_edits_on and rd_dn_closer_joined(@reader_ctx))) {
                return 0
            }
            rd_dn_split_closer(@reader_ctx);
        }
    }
    if (n =? 0) {
        return 0
    }
    loop rd_dn_accept(@reader_ctx 'question') {
        let optional:int64=node_mk(@reader_nodes 'topt' rd_mkpos(reader_ctx.file token.start))
        reader_nodes[optional].a = int32<overflow='wrap'>(n)
        n = optional
    }
    # (`x as float32 (y)`: a spaced group is the next operand's; among type arguments, a spaced
    # `<` opens the next, `dict<string <(x:int64):>int64>>`)
    let next:DewyToken=reader_ctx.tokens[reader_ctx.at].symbol
    # (in a sequence pattern a spaced `<` opens the next part, `(a:int64 <string>)`)
    if (((next =? 'dot') or ((next =? 'langle') and (((reader_ctx.reader.dc_type_args =? 0) and (not (reader_ctx.reader.dc_sequence_part and reader_ctx.tokens[reader_ctx.at].space))) or (not reader_ctx.tokens[reader_ctx.at].space)))) or (((next =? 'lbrack') or (next =? 'lparen')) and (not reader_ctx.tokens[reader_ctx.at].space))) {
        return 0
    }
    n
}

rd_dc_type_spelled=(@reader_ctx:ParserContext id:int64):>int64=>$unsafe {
    if ((id <? reader_ctx.reader.dc_type_spelling.length) and (reader_ctx.reader.dc_type_spelling[id] not=? 0)) {
        return int64<overflow='wrap'>(reader_ctx.reader.dc_type_spelling[id])
    }
    rd_dc_type_spelling_of(@reader_ctx id)
}

rd_dc_type_spelling_of=(@reader_ctx:ParserContext id:int64):>int64=>$unsafe {
    if (reader_ctx.reader.dc_type_spelling.length <? reader_ctx.stores.texts[0].length) {
        reader_ctx.reader.dc_type_spelling.resize((int64<overflow='wrap'>(reader_ctx.stores.texts[0].length) + 64));
    }
    let name:string=rd_name_of(@reader_ctx id)
    let spelled:int64=(-1)
    if (not (name in? ["type" "uint" "no_effects" "allocates" "blocks" "panics" "reads" "mutates" "no"])) {
        let mapped:string=rd_dw_type_name(@reader_ctx name)
        spelled = (if (mapped =? name) id else reader_ctx.stores.host[0].intern(mapped))
    }
    if (id <? reader_ctx.reader.dc_type_spelling.length) {
        reader_ctx.reader.dc_type_spelling[id] = int32<overflow='wrap'>(spelled)
    }
    spelled
}

# `float64 * Length / Time`, `Length^2`: a quantity type (dw_type's `*`, `/`, `^`).
rd_dc_type_term=(@reader_ctx:ParserContext @reader_nodes:array<Node>):>int64=>$unsafe {
    let pos:int64=rd_mkpos(reader_ctx.file reader_ctx.tokens[reader_ctx.at].start)
    let n:int64=rd_dc_type_primary(@reader_ctx @reader_nodes)
    let next:DewyToken=rd_dn_peek(@reader_ctx)
    if ((n =? 0) or (((next not=? 'star') and (next not=? 'slash')) and (next not=? 'caret'))) {
        return n
    }
    rd_dc_type_term_from(@reader_ctx @reader_nodes n pos)
}

rd_dc_type_term_from=(@reader_ctx:ParserContext @reader_nodes:array<Node> first:int64 pos:int64):>int64=>$unsafe {
    let n:int64=rd_dc_type_power(@reader_ctx @reader_nodes first pos)
    loop (n not=? 0) and ((rd_dn_peek(@reader_ctx) =? 'star') or (rd_dn_peek(@reader_ctx) =? 'slash')) {
        let op:int64=(if (rd_dn_take(@reader_ctx).symbol =? 'star') 60 else 61)
        let right:int64=rd_dc_type_factor(@reader_ctx @reader_nodes)
        if (right =? 0) {
            return 0
        }
        let q:int64=node_mk(@reader_nodes 'tquantity' pos)
        reader_nodes[q].op = int32<overflow='wrap'>(int64<overflow='wrap'>(op))
        reader_nodes[q].a = int32<overflow='wrap'>(n)
        reader_nodes[q].b = int32<overflow='wrap'>(right)
        n = q
    }
    n
}

# A directive of the design not built yet, written as a statement (dw_unimplemented's).
rd_dc_unbuilt=(name:string):>bool=>$unsafe {
    (((name =? "unsafe_assume") or (name =? "abstract")) or (name =? "no_prelude"))
}

# `{` or `[` at pos with no closer before the end (dn_bracketed_from's mistake, at once).
rd_dc_unclosed=(@reader_ctx:ParserContext pos:int64 close:string):>void=>$unsafe {
    reader_ctx.stores.host[0].dn_error(rd_pos_off(pos) "expected '{close}' before end of file");
}

rd_dc_union_leaves=(@reader_ctx:ParserContext @reader_nodes:array<Node> n:int64 @out:array<int64>):>void=>$unsafe {
    if (reader_nodes[n].kind =? 'tunion') {
        rd_dc_union_leaves(@reader_ctx @reader_nodes rd_kid(@reader_ctx @reader_nodes n 0) @out);
        rd_dc_union_leaves(@reader_ctx @reader_nodes rd_kid(@reader_ctx @reader_nodes n 1) @out);
    }
    else {
        out.push(n);
    }
}

# `let value + 1`, `let value[1]`, `let value:int64 + 1`: dw_declare's mistake (or dw_type's, on
# the type the rest extends), should nothing else read it.
rd_dc_unnamed=(@reader_ctx:ParserContext @reader_nodes:array<Node> n:int64):>int64=>$unsafe {
    let typed:int64=int64<overflow='wrap'>(reader_nodes[n].a)
    let name:int64=rd_dc_token_from(@reader_ctx rd_pos_off(reader_nodes[n].pos))
    if (name <=? 0) {
        if ((typed not=? 0) and (dn_power(rd_dn_peek(@reader_ctx)) >? 0)) {
            return rd_dc_hint(@reader_ctx reader_nodes[typed].pos "Dewy does not yet support this type expression")
        }
        return rd_dc_hint(@reader_ctx reader_nodes[n].pos "Dewy does not yet support this declaration")
    }
    let src:string=reader_ctx.source
    let keyword:string=rd_dn_payload(@reader_ctx reader_ctx.tokens[(int64<overflow='wrap'>(name) - 1)])
    let written:string=rd_dn_payload(@reader_ctx reader_ctx.tokens[name])
    if ((typed not=? 0) and (dn_power(rd_dn_peek(@reader_ctx)) >? 0)) {
        let annotation:string=reader_ctx.stores.host[0].bytes_slice(src rd_pos_off(reader_nodes[typed].pos) reader_ctx.tokens[(int64<overflow='wrap'>(reader_ctx.at) - 1)].stop)
        return rd_dc_hint(@reader_ctx reader_nodes[typed].pos "a type annotation ends before `=`: write `{keyword} {written}:{annotation} = expression`")
    }
    rd_dc_hint(@reader_ctx reader_nodes[n].pos "a variable binding needs a value: write `{keyword} {written} = expression`")
}

# `[a b] = value`, `(a b) = values` (grouped) at its opener: the pattern target's assignment.
rd_dc_unpacking_assignment=(@reader_ctx:ParserContext @reader_nodes:array<Node> grouped:bool pos:int64):>int64=>$unsafe {
    reader_ctx.at = (int64<overflow='wrap'>(reader_ctx.at) + 1)
    let seen:array<int64>=[]
    let close:DewyToken='rbrack'
    if grouped {
        close = 'rparen'
    }
    let binders:array<int64>=rd_dc_binding_items(@reader_ctx @reader_nodes @seen close)
    if ((binders.length =? 0) or (grouped and (binders.length <? 2))) {
        return 0
    }
    reader_ctx.at = (int64<overflow='wrap'>(reader_ctx.at) + 1)
    if rd_dc_lambda_next(@reader_ctx) {
        return 0
    }
    reader_ctx.depth = (int64<overflow='wrap'>(reader_ctx.depth) + 1)
    let right:int64=rd_dc_expr(@reader_ctx @reader_nodes 11)
    reader_ctx.depth = (int64<overflow='wrap'>(reader_ctx.depth) - 1)
    if ((right =? 0) or (reader_nodes[right].kind =? 'lambda')) {
        return 0
    }
    let pattern:int64=node_mk(@reader_nodes 'tuple' pos)
    node_set_list(@reader_nodes @reader_ctx.stores.lists[0] pattern binders);
    let n:int64=node_mk(@reader_nodes 'assign' pos)
    reader_nodes[n].op = int32<overflow='wrap'>(int64<overflow='wrap'>(int64(47)))
    reader_nodes[n].a = int32<overflow='wrap'>(pattern)
    reader_nodes[n].b = int32<overflow='wrap'>(right)
    rd_dc_accept_semi(@reader_ctx (not reader_ctx.reader.dc_unbraced));
    n
}

# The direct parser reads no form that starts at token `at`: the mistake its readings gave up
# on (dc_hint), else the first noted, else that the form is not read.
rd_dc_unread=(@reader_ctx:ParserContext at:int64):>void=>$unsafe {
    let cut:int64=dc_scan_cut(@reader_ctx.tokens at)
    if (cut >=? 0) {
        rd_dc_cut_off(@reader_ctx cut);
    }
    if (reader_ctx.status.hint_pos not=? 0) {
        reader_ctx.stores.host[0].fatal(reader_ctx.status.hint_pos reader_ctx.status.hint_text);
    }
    if (reader_ctx.status.report_pos not=? 0) {
        reader_ctx.stores.host[0].fatal(reader_ctx.status.report_pos reader_ctx.status.report_text);
    }
    rd_dc_foreign_habit(@reader_ctx at);
    reader_ctx.stores.host[0].fatal(rd_mkpos(reader_ctx.file reader_ctx.tokens[at].start) "Dewy does not read this form");
}

# A statement the end of the text cuts off (dc_unread's mistake, before any noted): the bracket it
# leaves open, or the end after a token it cannot end with (dc_scan_cut).
rd_dc_cut_off=(@reader_ctx:ParserContext cut:int64):>void=>$unsafe {
    let token:DewyLexeme=reader_ctx.tokens[cut]
    let pos:int64=rd_mkpos(reader_ctx.file token.start)
    if (token.kind =? 'eof') {
        reader_ctx.stores.host[0].fatal(pos "unexpected end of file");
    }
    let close:DewyToken='rbrace'
    if (token.symbol =? 'lparen') {
        close = 'rparen'
    }
    else if (token.symbol =? 'lbrack') {
        close = 'rbrack'
    }
    reader_ctx.stores.host[0].fatal(pos "expected '{dn_token_text(close)}' before end of file");
}

# `$unsafe` opens a boundary over the expression after it, on its line or the next
# (dn_directive): not `$unsafe=false`, a tag alone or one before another tag.
rd_dc_unsafe_at=(@reader_ctx:ParserContext at:int64):>bool=>$unsafe {
    if ((reader_ctx.tokens[at].kind not=? 'metatag') or (not reader_ctx.reader.dn_edits_on)) {
        return false
    }
    let token:DewyLexeme=reader_ctx.tokens[at]
    if (((int64<overflow='wrap'>(token.stop) - int64<overflow='wrap'>(token.start)) not=? 7) or (rd_dn_payload(@reader_ctx token) not=? "unsafe")) {
        return false
    }
    let next:DewyLexeme=reader_ctx.tokens[(int64<overflow='wrap'>(at) + 1)]
    ((dn_can_start(@reader_ctx.tokens (int64<overflow='wrap'>(at) + 1)) and (next.symbol not=? 'assign')) and (next.kind not=? 'metatag'))
}

# The `$unsafe` boundary written at `at`, through the last token read (dw_unsafe_scope ends it at
# the operand's last syntax node: nothing lies between). A retry removes it, dn_edits_undo.
rd_dc_unsafe_scope=(@reader_ctx:ParserContext at:int64):>void=>$unsafe {
    if (reader_ctx.reader.dc_unsafe_name =? 0) {
        reader_ctx.reader.dc_unsafe_name = reader_ctx.stores.host[0].intern("unsafe")
    }
    let last:DewyLexeme=reader_ctx.tokens[(int64<overflow='wrap'>(reader_ctx.at) - 1)]
    rd_dc_scope_undoable(@reader_ctx);
    reader_ctx.stores.host[0].dir_set(reader_ctx.reader.dc_unsafe_name 1 at rd_mkpos(reader_ctx.file (int64<overflow='wrap'>(last.stop) - 1)) at);
}

# A word no type is spelled with (dw_type's mistake, should nothing else read it).
rd_dc_unspelled=(@reader_ctx:ParserContext token:DewyLexeme):>int64=>$unsafe {
    if (rd_dn_payload(@reader_ctx token) =? "uint") {
        rd_dc_hint(@reader_ctx rd_mkpos(reader_ctx.file token.start) "unbounded `uint` is unsupported; choose a fixed width such as `uint64`");
    }
    0
}

# `what` is not supported (dw_fail's mistake).
rd_dc_unsupported=(@reader_ctx:ParserContext pos:int64 what:string):>void=>$unsafe {
    rd_dc_report(@reader_ctx pos "Dewy does not yet support {what}");
}

# A declaration's type read no way (dw_type's mistake, should nothing else read it).
rd_dc_untyped=(@reader_ctx:ParserContext at:int64):>int64=>$unsafe {
    let token:DewyLexeme=reader_ctx.tokens[at]
    # (`let value:int64 + 1`: the rest extends a type that is one name)
    let after:DewyToken=reader_ctx.tokens[(int64<overflow='wrap'>(at) + 1)].symbol
    let keyword:DewyToken='none'
    if (at >=? 3) {
        keyword = reader_ctx.tokens[(int64<overflow='wrap'>(at) - 3)].symbol
    }
    if (((((((((((keyword =? 'kw_let') or (keyword =? 'kw_const')) and (token.kind =? 'identifier')) and (reader_ctx.tokens[(int64<overflow='wrap'>(at) - 1)].symbol =? 'colon')) and (dn_power(after) >? 0)) and (after not=? 'assign')) and (after not=? 'pipe')) and (after not=? 'amp')) and (after not=? 'langle')) and (after not=? 'question')) and (after not=? 'coalesce')) {
        return rd_dc_hint(@reader_ctx rd_mkpos(reader_ctx.file token.start) "a type annotation ends before `=`: write `{rd_dn_payload(@reader_ctx reader_ctx.tokens[(int64<overflow='wrap'>(at) - 3)])} {rd_dn_payload(@reader_ctx reader_ctx.tokens[(int64<overflow='wrap'>(at) - 2)])}:{rd_dn_payload(@reader_ctx token)} = expression`")
    }
    # (`let value:return=1`: a keyword then `=`, dn_atom's mistake)
    if (((token.symbol not=? 'none') and (token.kind =? 'identifier')) and (reader_ctx.tokens[(int64<overflow='wrap'>(at) + 1)].symbol =? 'assign')) {
        return rd_dc_hint(@reader_ctx rd_mkpos(reader_ctx.file token.start) rd_dc_keyword_text(token.symbol))
    }
    rd_dc_hint(@reader_ctx rd_mkpos(reader_ctx.file token.start) "Dewy does not yet support this type expression")
}

# `(count += 1)` is next: parentheses holding an update at their top.
rd_dc_update_next=(@reader_ctx:ParserContext):>bool=>$unsafe {
    let close:int64=rd_dc_closing(@reader_ctx reader_ctx.at)
    if ((close <? 0) or (reader_ctx.tokens[(int64<overflow='wrap'>(reader_ctx.at) + 1)].kind not=? 'identifier')) {
        return false
    }
    let depth:int64=0
    loop k in [(int64<overflow='wrap'>(reader_ctx.at) + 1)..close) {
        let symbol:DewyToken=reader_ctx.tokens[k].symbol
        if (((symbol =? 'lparen') or (symbol =? 'lbrack')) or (symbol =? 'lbrace')) {
            depth = (int64<overflow='wrap'>(depth) + 1)
        }
        else if (((symbol =? 'rparen') or (symbol =? 'rbrack')) or (symbol =? 'rbrace')) {
            depth = (int64<overflow='wrap'>(depth) - 1)
        }
        else if ((depth =? 0) and dn_token_assignment(symbol)) {
            return true
        }
    }
    false
}

# `$warn_if condition "message"` on the line before a module function (dw_warn_if_attr): a
# compact statement holding the attribute the function takes (dw_top_declarations).
rd_dc_warn_if=(@reader_ctx:ParserContext @reader_nodes:array<Node> token:DewyLexeme):>int64=>$unsafe {
    if (((int64<overflow='wrap'>(token.stop) - int64<overflow='wrap'>(token.start)) not=? 8) or (rd_dn_payload(@reader_ctx token) not=? "warn_if")) {
        return 0
    }
    let pos:int64=rd_mkpos(reader_ctx.file token.start)
    reader_ctx.at = (int64<overflow='wrap'>(reader_ctx.at) + 1)
    if (reader_ctx.tokens[reader_ctx.at].newline or (not dn_can_start(@reader_ctx.tokens reader_ctx.at))) {
        reader_ctx.stores.host[0].fatal(pos "`$warn_if` takes a condition and a message: `$warn_if condition \"message\"`");
    }
    let saved:bool=reader_ctx.flags.comma_stop
    reader_ctx.flags.comma_stop = true
    let condition:int64=rd_dc_expr(@reader_ctx @reader_nodes 0)
    if (condition =? 0) {
        return 0
    }
    rd_dn_accept(@reader_ctx 'comma');
    if (reader_ctx.tokens[reader_ctx.at].newline or (not dn_can_start(@reader_ctx.tokens reader_ctx.at))) {
        return reader_ctx.stores.host[0].dn_error(token.start "`$warn_if` needs a message after its condition: `$warn_if condition \"message\"`")
    }
    let written:DewyLexeme=reader_ctx.tokens[reader_ctx.at]
    let message:int64=rd_dc_expr(@reader_ctx @reader_nodes 0)
    reader_ctx.flags.comma_stop = saved
    if (message =? 0) {
        return 0
    }
    if ((reader_nodes[message].kind not=? 'str_lit') or ((written.kind not=? 'quoted') and (written.kind not=? 'rawquoted'))) {
        reader_ctx.stores.host[0].fatal(rd_mkpos(reader_ctx.file written.start) "a `$warn_if` message is a string literal: the compiler shows it");
    }
    let next:DewyLexeme=reader_ctx.tokens[reader_ctx.at]
    if ((next.kind not=? 'eof') and (not next.newline)) {
        return 0
    }
    let at:int64=reader_ctx.stores.host[0].dw_ffi_attr("warn_if" condition pos)
    reader_nodes[at].b = int32<overflow='wrap'>(message)
    let id:int64=rd_dn_node(@reader_ctx 'compact_stmt' "$warn_if" token.start)
    reader_ctx.reader.dewy_syntax[id].child_left = at
    id
}

rd_dc_whole_axis=(@reader_ctx:ParserContext):>bool=>$unsafe {
    (((rd_dn_peek(@reader_ctx) =? 'lbrack') and (reader_ctx.tokens[(int64<overflow='wrap'>(reader_ctx.at) + 1)].symbol =? 'range')) and (reader_ctx.tokens[(int64<overflow='wrap'>(reader_ctx.at) + 2)].symbol =? 'rbrack'))
}

# An integer literal the plain decimal reading does not take: based, or beyond int64 (dw_expr's
# integer: a uint64 literal, or an exact one, dw_big_integer). 0 for a mistake, left unread
# (dc_unread).
rd_dc_wide_integer=(@reader_ctx:ParserContext @reader_nodes:array<Node> token:DewyLexeme pos:int64):>int64=>$unsafe {
    let text:string=rd_dn_payload(@reader_ctx token)
    let p:LiteralProblem=LiteralProblem[message="" at=0 unsupported=false]
    let value:uint64?=literal_unsigned(@p text)
    if value isnt? none {
        if ((p.message as array<uint8>).length >? 0) {
            return 0
        }
        let n:int64=node_mk(@reader_nodes 'int_lit' pos)
        reader_nodes[n].ival = (value transmute int64)
        rd_add_flag(@reader_nodes n NF_LITERAL);
        if (reader_nodes[n].ival <? 0) {
            rd_add_flag(@reader_nodes n NF_U64);
        }
        return n
    }
    if ((p.message as array<uint8>).length >? 0) {
        return 0
    }
    let limbs:array<uint64>=literal_limbs(@p text)
    if ((p.message as array<uint8>).length >? 0) {
        return 0
    }
    rd_dc_bigint_value(@reader_ctx limbs pos false)
}

rd_dc_word=(@reader_ctx:ParserContext id:int64):>int64=>$unsafe {
    let reader_texts=reader_ctx.stores.texts
    dc_parser_word(@reader_ctx @reader_texts[0] id)
}

# The name or number written at offset at.
rd_dc_word_at=(@reader_ctx:ParserContext at:int64):>string=>$unsafe {
    let source:string=reader_ctx.source
    let stop:int64=at
    loop (stop <? (source as array<uint8>).length) and (rd_is_alnum((source as array<uint8>)[stop]) or ((source as array<uint8>)[stop] =? b'_')) {
        stop = (int64<overflow='wrap'>(stop) + 1)
    }
    reader_ctx.stores.host[0].bytes_slice(source at stop)
}

# A word operator where a value starts is a name (`in + 1`, dw_expr's identifier).
rd_dc_word_name=(@reader_ctx:ParserContext @reader_nodes:array<Node> token:DewyLexeme pos:int64):>int64=>$unsafe {
    let n:int64=node_mk(@reader_nodes 'ident' pos)
    reader_nodes[n].name = rd_dw_value_name(@reader_ctx int32<overflow='wrap'>(reader_ctx.stores.host[0].intern(rd_dn_payload(@reader_ctx token))) pos)
    n
}

# `a nand b` at the operator: `not (a and b)`, as `nor` and `xnor` are of `or` and `xor`, the `not`
# at the word.
rd_dc_word_not=(@reader_ctx:ParserContext @reader_nodes:array<Node> op:DewyToken left:int64 power:int64 pos:int64):>int64=>$unsafe {
    let word:DewyLexeme=rd_dn_take(@reader_ctx)
    let right:int64=rd_dc_expr(@reader_ctx @reader_nodes (int64<overflow='wrap'>(power) + 1))
    if (right =? 0) {
        return 0
    }
    let base:DewyToken='kw_and'
    if (op =? 'kw_nor') {
        base = 'kw_or'
    }
    if (op =? 'kw_xnor') {
        base = 'kw_xor'
    }
    let inner:int64=rd_dc_binary(@reader_ctx @reader_nodes base left right pos)
    if (inner =? 0) {
        return 0
    }
    let n:int64=node_mk(@reader_nodes 'not_' rd_mkpos(reader_ctx.file word.start))
    reader_nodes[n].op = int32<overflow='wrap'>(int64<overflow='wrap'>(int64(58)))
    reader_nodes[n].a = int32<overflow='wrap'>(inner)
    n
}

# A word operator, which is never a name (dw_word_operator_name).
rd_dc_word_operator=(t:DewyToken):>bool=>$unsafe {
    ((((((((((t =? 'kw_and') or (t =? 'kw_or')) or (t =? 'kw_not')) or (t =? 'kw_xor')) or (t =? 'kw_nand')) or (t =? 'kw_nor')) or (t =? 'kw_xnor')) or (t =? 'kw_in')) or (t =? 'kw_as')) or (t =? 'kw_transmute'))
}

rd_dc_word_operator_at=(@reader_ctx:ParserContext token:DewyLexeme):>void=>$unsafe {
    rd_dc_report(@reader_ctx rd_mkpos(reader_ctx.file token.start) "`{dn_token_text(token.symbol)}` is a word operator, not a name: choose another name");
}

# (its mistake, "" for a name that may be bound)
rd_dewy_reserved_text=(name:string):>string=>$unsafe {
    if ((name as array<uint8>).length <? 3) {
        return ""
    }
    let c:uint8=(name as array<uint8>)[0]
    if (((c not=? b'e') and (c not=? b'n')) and (c not=? b'v')) {
        return ""
    }
    let role:string=""
    if (name =? "end") {
        role = "inside brackets it is the last index, as in `xs[end]`"
    }
    else if (name =? "new") {
        role = "inside brackets it inserts an axis, as in `xs[new]`"
    }
    else if (name =? "none") {
        role = "it is the empty value"
    }
    else if (name =? "void") {
        role = "it is the type of no value"
    }
    if (role =? "") {
        return ""
    }
    "'{name}' is reserved, not a name: {role} (use `{name}_`)"
}

# Dewy's name for a builtin type Sloppy spells w ("" when w is not one).
rd_dewy_type_word=(@reader_ctx:ParserContext w:string):>string=>$unsafe {
    if (w =? "str") {
        return "string"
    }
    if (w =? "byte") {
        return "uint8"
    }
    if ((w =? "f64") or (w =? "f32")) {
        return "{"float"}{reader_ctx.stores.host[0].bytes_slice(w 1 (w as array<uint8>).length)}"
    }
    if ((((w =? "i8") or (w =? "i16")) or (w =? "i32")) or (w =? "i64")) {
        return "{"int"}{reader_ctx.stores.host[0].bytes_slice(w 1 (w as array<uint8>).length)}"
    }
    if ((((w =? "u8") or (w =? "u16")) or (w =? "u32")) or (w =? "u64")) {
        return "{"uint"}{reader_ctx.stores.host[0].bytes_slice(w 1 (w as array<uint8>).length)}"
    }
    ""
}

rd_dn_accept=(@reader_ctx:ParserContext symbol:DewyToken):>bool=>$unsafe {
    if (rd_dn_peek(@reader_ctx) not=? symbol) {
        return false
    }
    reader_ctx.at = (int64<overflow='wrap'>(reader_ctx.at) + 1)
    true
}

rd_dn_accept_semi=(@reader_ctx:ParserContext):>bool=>$unsafe {
    if (rd_dn_peek(@reader_ctx) not=? 'semi') {
        return false
    }
    let token:DewyLexeme=reader_ctx.tokens[reader_ctx.at]
    if (reader_ctx.reader.dn_rows and (token.space or token.newline)) {
        return false
    }
    if (token.space or token.newline) {
        reader_ctx.stores.host[0].dn_error(token.start "an unattached `;` is reserved for array-dimension selection: attach it to the statement it ends, `f();`, or leave it out");
    }
    reader_ctx.at = (int64<overflow='wrap'>(reader_ctx.at) + 1)
    true
}

# The compact operator of a combined assignment token.
rd_dn_assign_tok=(op:DewyToken):>int64=>$unsafe {
    match op {
        <'assign'> => {
            47
        }
        <'plus_assign'> => {
            48
        }
        <'minus_assign'> => {
            49
        }
        <'slash_assign' | 'floor_assign'> => {
            51
        }
        <'percent_assign'> => {
            52
        }
        <'power_assign' | 'xor_assign'> => {
            55
        }
        <'shl_assign'> => {
            56
        }
        <'shr_assign'> => {
            57
        }
        <'amp_assign' | 'and_assign'> => {
            53
        }
        <'pipe_assign' | 'or_assign'> => {
            54
        }
        _ => {
            50
        }
    }
}

# A generic closer joined to what follows (`>>`, `>=`, `>?` unspaced) closes one angle:
# its first `>` is consumed in place, leaving the rest for the enclosing grammar.
rd_dn_closer_joined=(@reader_ctx:ParserContext):>bool=>$unsafe {
    let op:DewyToken=rd_dn_peek(@reader_ctx)
    ((((op =? 'shr') or (op =? 'shr_assign')) or (op =? 'angle_assign')) or ((op =? 'gt') and (not reader_ctx.tokens[reader_ctx.at].space)))
}

rd_dn_edits_clear=(@reader_ctx:ParserContext mark:int64=0):>void=>$unsafe {
    reader_ctx.reader.dn_edit_at.truncate(mark);
    reader_ctx.reader.dn_edit_was.truncate(mark);
}

# (`kept`: the direct nodes stay, compare mode's: their place and live-source marks stay too)
rd_dn_edits_undo=(@reader_ctx:ParserContext mark:int64=0 kept:bool=false):>void=>$unsafe {
    let i:int64=(int64<overflow='wrap'>(reader_ctx.reader.dn_edit_at.length) - 1)
    loop (i >=? mark) {
        let at:int64=reader_ctx.reader.dn_edit_at[i]
        if (at =? DN_EDIT_BIGINT) {
            reader_ctx.stores.host[0].g_dw_bigint_import_set(0)
        }
        else if (at <? DN_EDIT_BIGINT) {
            if kept {
                at = 0
            }
            else if (at <=? DN_EDIT_METHODS) {
                reader_ctx.stores.host[0].g_dewy_methods_truncate((int64<overflow='wrap'>(DN_EDIT_METHODS) - int64<overflow='wrap'>(at)));
            }
            else if (at <=? DN_EDIT_LIVE) {
                reader_ctx.stores.host[0].g_dewy_live_sources_remove((int64<overflow='wrap'>(DN_EDIT_LIVE) - int64<overflow='wrap'>(at)));
            }
            else {
                reader_ctx.stores.host[0].g_place_written_remove((int64<overflow='wrap'>(DN_EDIT_BIGINT) - int64<overflow='wrap'>(at)));
            }
        }
        else if (at <? 0) {
            reader_ctx.stores.host[0].g_dir_scopes_truncate((int64<overflow='wrap'>((-int64<overflow='wrap'>(at))) - 1));
        }
        else {
            reader_ctx.tokens[at] = reader_ctx.reader.dn_edit_was[i]
        }
        i = (int64<overflow='wrap'>(i) - 1)
    }
    rd_dn_edits_clear(@reader_ctx mark);
}

rd_dn_matches=(source:ptr<uint8> at:int64 stop:int64 value:string):>bool=>$unsafe {
    if ((value as array<uint8>).length >? (int64<overflow='wrap'>(stop) - int64<overflow='wrap'>(at))) {
        return false
    }
    loop i in [0..(value as array<uint8>).length) {
        if (source[(int64<overflow='wrap'>(at) + int64<overflow='wrap'>(i))] not=? (value as array<uint8>)[i]) {
            return false
        }
    }
    true
}

rd_dn_node=(@reader_ctx:ParserContext kind:DewyKind text:string offset:int64 children:array<int64>=[] name:int32=0):>int64=>$unsafe {
    syntax_node(@reader_ctx.reader.dewy_syntax kind text rd_mkpos(reader_ctx.file offset) children name)
}

# Tokens contain only scalar tags, name IDs and source spans. Materialize text
# only when projection needs a literal payload; grammar lookahead copies no
# reference-counted strings. Formatting uses the spans and tags directly.
rd_dn_payload=(@reader_ctx:ParserContext token:DewyLexeme):>string=>$unsafe {
    if (token.symbol not=? 'none') {
        return dn_token_text(token.symbol)
    }
    if (token.name not=? 0) {
        return rd_name_of(@reader_ctx int64<overflow='wrap'>(token.name))
    }
    let source:string=reader_ctx.source
    let first:int64=token.start
    if (token.kind =? 'metatag') {
        return reader_ctx.stores.host[0].bytes_slice(source (int64<overflow='wrap'>(first) + 1) token.stop)
    }
    if (token.kind =? 'integer') {
        return "{"{reader_ctx.stores.host[0].bytes_slice(source first (int64<overflow='wrap'>(first) + 2))}{":"}"}{reader_ctx.stores.host[0].bytes_slice(source (int64<overflow='wrap'>(first) + 2) token.stop)}"
    }
    if (token.kind =? 'based_string') {
        return "{"{reader_ctx.stores.host[0].bytes_slice(source first (int64<overflow='wrap'>(first) + 2))}{":"}"}{reader_ctx.stores.host[0].bytes_slice(source (int64<overflow='wrap'>(first) + 3) (int64<overflow='wrap'>(token.stop) - 1))}"
    }
    if (((((token.kind =? 'source_integer') or (token.kind =? 'source_real')) and ((int64<overflow='wrap'>(first) + 1) <? token.stop)) and ((source as array<uint8>)[first] =? b'0')) and ((source as array<uint8>)[(int64<overflow='wrap'>(first) + 1)] =? b'd')) {
        first = (int64<overflow='wrap'>(first) + 2)
    }
    reader_ctx.stores.host[0].bytes_slice(source first token.stop)
}

rd_dn_peek=(@reader_ctx:ParserContext):>DewyToken=>$unsafe {
    reader_ctx.tokens[reader_ctx.at].symbol
}

rd_dn_reserved=(@reader_ctx:ParserContext name:int64):>bool=>$unsafe {
    ((name <? reader_ctx.reader.dn_reserved_words.length) and reader_ctx.reader.dn_reserved_words[name])
}

rd_dn_split_closer=(@reader_ctx:ParserContext):>void=>$unsafe {
    rd_dn_token_edit(@reader_ctx reader_ctx.at);
    reader_ctx.tokens[reader_ctx.at].start = (int64<overflow='wrap'>(reader_ctx.tokens[reader_ctx.at].start) + 1)
    let tail:DewyLexeme=reader_ctx.tokens[reader_ctx.at]
    reader_ctx.tokens[reader_ctx.at].symbol = dn_token_kind(reader_ctx.stores.host[0].bytes_slice(reader_ctx.source tail.start tail.stop))
}

rd_dn_statement=(@reader_ctx:ParserContext @reader_nodes:array<Node> top:bool=false):>int64=>$unsafe {
    let saved_now:bool=reader_ctx.flags.report_now
    reader_ctx.flags.report_now = top
    let read:int64=rd_dn_statement_read(@reader_ctx @reader_nodes top)
    reader_ctx.flags.report_now = saved_now
    read
}

rd_dn_statement_read=(@reader_ctx:ParserContext @reader_nodes:array<Node> top:bool):>int64=>$unsafe {
    if top {
        reader_ctx.status.hint_pos = 0
    }
    # (`test "adds" { ... }`: dn_stmt's mistake, at once)
    if ((reader_ctx.tokens[reader_ctx.at].symbol =? 'kw_test') and rd_dc_test_block(@reader_ctx reader_ctx.at)) {
        reader_ctx.stores.host[0].dn_error(reader_ctx.tokens[reader_ctx.at].start "a test is a function marked `$test` on the line before it: `$test` then `let adds_numbers = () => $expect add(20 22) =? 42`");
    }
    if (top and (reader_ctx.tokens[reader_ctx.at].kind =? 'metatag')) {
        let built:int64=rd_dc_build_setting(@reader_ctx @reader_nodes)
        if (built not=? 0) {
            return built
        }
        let setting:int64=rd_dc_setting(@reader_ctx reader_ctx.tokens[reader_ctx.at])
        if (setting not=? 0) {
            return setting
        }
        let marker:int64=rd_dc_marker(@reader_ctx reader_ctx.tokens[reader_ctx.at])
        if (marker not=? 0) {
            return marker
        }
        let line:int64=rd_dc_directive_line(@reader_ctx @reader_nodes reader_ctx.tokens[reader_ctx.at])
        if (line not=? 0) {
            return line
        }
        let bundle:int64=rd_dc_bundle(@reader_ctx reader_ctx.tokens[reader_ctx.at])
        if (bundle not=? 0) {
            rd_dc_flush_report(@reader_ctx);
            return bundle
        }
        let soft:int64=rd_dc_warn_if(@reader_ctx @reader_nodes reader_ctx.tokens[reader_ctx.at])
        if (soft not=? 0) {
            return soft
        }
        # (`$frob = 3`, `$no_prelude = true`, `$bogus` alone: dw_metatag_fail's mistake)
        let alone:bool=((reader_ctx.tokens[(int64<overflow='wrap'>(reader_ctx.at) + 1)].kind =? 'eof') or ((reader_ctx.tokens[(int64<overflow='wrap'>(reader_ctx.at) + 1)].newline and (reader_ctx.tokens[(int64<overflow='wrap'>(reader_ctx.at) + 1)].symbol not=? 'kw_loop')) and (dn_power(reader_ctx.tokens[(int64<overflow='wrap'>(reader_ctx.at) + 1)].symbol) =? 0)))
        if ((alone or ((reader_ctx.tokens[(int64<overflow='wrap'>(reader_ctx.at) + 1)].symbol =? 'assign') and (reader_ctx.tokens[(int64<overflow='wrap'>(reader_ctx.at) + 2)].symbol not=? 'lbrace'))) and rd_dc_tag_mistake(@reader_ctx rd_dn_payload(@reader_ctx reader_ctx.tokens[reader_ctx.at]))) {
            return rd_dc_fail_now(@reader_ctx rd_mkpos(reader_ctx.file reader_ctx.tokens[reader_ctx.at].start) reader_ctx.stores.host[0].metatag_fail_text(rd_dn_payload(@reader_ctx reader_ctx.tokens[reader_ctx.at])))
        }
    }
    # (`$unsafe` then a declaration: its boundary covers the declaration, dw_top_declarations)
    let head:int64=reader_ctx.at
    if (top and rd_dc_unsafe_at(@reader_ctx reader_ctx.at)) {
        reader_ctx.at = (int64<overflow='wrap'>(reader_ctx.at) + 1)
    }
    let start:int64=reader_ctx.at
    let node_start:int64=reader_nodes.length
    let list_start:int64=reader_ctx.stores.lists[0].length
    let edits:int64=reader_ctx.reader.dn_edit_at.length
    reader_ctx.depth = 0
    let value:int64=0
    let report_pos:int64=reader_ctx.status.report_pos
    let reports:int64=reader_ctx.status.reports
    if top {
        let syntax_start:int64=reader_ctx.reader.dewy_syntax.length
        reader_ctx.reader.dc_made.clear();
        let word:DewyToken=reader_ctx.tokens[reader_ctx.at].symbol
        # `if $target =? "wasm32" { ... } else { ... }`: the compiled arm's declarations
        if ((word =? 'kw_if') and (reader_ctx.tokens[(int64<overflow='wrap'>(reader_ctx.at) + 1)].kind =? 'metatag')) {
            let chain:int64=rd_dc_target_chain(@reader_ctx @reader_nodes)
            if (chain >? 0) {
                if (head not=? start) {
                    rd_dc_unsafe_scope(@reader_ctx rd_mkpos(reader_ctx.file reader_ctx.tokens[head].start));
                }
                rd_dn_edits_clear(@reader_ctx edits);
                rd_dc_flush_report(@reader_ctx);
                return chain
            }
            reader_ctx.at = start
            reader_ctx.reader.dewy_syntax.truncate(syntax_start);
        }
        value = (if ((word =? 'kw_import') or (word =? 'kw_from')) rd_dc_import(@reader_ctx @reader_nodes) else rd_dc_type_declaration(@reader_ctx @reader_nodes))
        if (value =? 0) {
            reader_ctx.at = start
            reader_nodes.truncate(node_start);
            reader_ctx.stores.lists[0].truncate(list_start);
            reader_ctx.depth = 0
            reader_ctx.reader.dc_nothing = false
            reader_ctx.status.report_pos = report_pos
            reader_ctx.status.reports = reports
            value = rd_dc_function(@reader_ctx @reader_nodes)
            if reader_ctx.reader.dc_nothing {
                reader_ctx.reader.dc_nothing = false
                if ((value =? 0) or (head not=? start)) {
                    value = 0
                }
                else {
                    return rd_dc_declares_nothing(@reader_ctx @reader_nodes head node_start list_start edits)
                }
            }
        }
        if (value =? 0) {
            rd_dn_edits_undo(@reader_ctx edits);
            reader_ctx.at = start
            reader_nodes.truncate(node_start);
            reader_ctx.stores.lists[0].truncate(list_start);
            reader_ctx.reader.dewy_syntax.truncate(syntax_start);
            reader_ctx.reader.dc_made.clear();
            rd_dc_forget_tables(@reader_ctx node_start);
            reader_ctx.depth = 0
            reader_ctx.status.report_pos = report_pos
            reader_ctx.status.reports = reports
        }
    }
    # (in a block is left unread (dc_unread), a statement's syntax may be read as syntax: an
    # expression statement or `$unsafe` collects, dw_collect, and ends an arena's value,
    # dw_copy_result)
    if ((value =? 0) and (top or (not rd_dc_unsafe_at(@reader_ctx start)))) {
        reader_ctx.reader.dc_top_level = top
        value = rd_dc_statement(@reader_ctx @reader_nodes)
        reader_ctx.reader.dc_top_level = false
    }
    if ((((value =? 0) and top) and (reader_ctx.tokens[start].kind not=? 'metatag')) and (not rd_dc_test_block(@reader_ctx start))) {
        let read:int64=0
        if (reader_ctx.reader.dc_value_start =? start) {
            read = reader_ctx.reader.dc_value
        }
        else {
            reader_ctx.at = start
            reader_nodes.truncate(node_start);
            reader_ctx.stores.lists[0].truncate(list_start);
            rd_dn_edits_undo(@reader_ctx edits);
            reader_ctx.status.report_pos = report_pos
            reader_ctx.status.reports = reports
        }
        reader_ctx.depth = 0
        value = rd_dc_expression_statement(@reader_ctx @reader_nodes rd_mkpos(reader_ctx.file reader_ctx.tokens[head].start) rd_mkpos(reader_ctx.file reader_ctx.tokens[start].start) read)
    }
    reader_ctx.reader.dc_value = 0
    reader_ctx.reader.dc_value_start = (-1)
    if (value =? 0) {
        rd_dc_unread(@reader_ctx head);
    }
    if (head not=? start) {
        rd_dc_unsafe_scope(@reader_ctx rd_mkpos(reader_ctx.file reader_ctx.tokens[head].start));
    }
    if (top and (reader_ctx.status.reports not=? reports)) {
        rd_dc_flush_report(@reader_ctx);
    }
    if top {
        rd_dn_edits_clear(@reader_ctx edits);
    }
    let id:int64=rd_dn_node(@reader_ctx 'compact_stmt' "" reader_ctx.tokens[head].start)
    reader_ctx.reader.dewy_syntax[id].child_left = value
    if (top and (reader_ctx.reader.dc_made.length >? 0)) {
        reader_ctx.reader.dewy_syntax[id].children = reader_ctx.reader.dc_made
        reader_ctx.reader.dc_made = []
    }
    id
}

rd_dn_string=(@reader_ctx:ParserContext @reader_nodes:array<Node> token:DewyLexeme):>int64=>$unsafe {
    let source:string=reader_ctx.source
    let raw:bool=(token.kind =? 'rawquoted')
    let opening:int64=token.start
    if raw {
        opening = (int64<overflow='wrap'>(opening) + 1)
    }
    let width:int64=dn_quote_width(source opening token.stop)
    let i:int64=(int64<overflow='wrap'>(opening) + int64<overflow='wrap'>(width))
    let stop:int64=(int64<overflow='wrap'>(token.stop) - int64<overflow='wrap'>(width))
    if raw {
        return rd_dn_text(@reader_ctx @reader_nodes reader_ctx.stores.host[0].bytes_slice(source i stop) token.start)
    }
    let chunks:array<int64>=[]
    let bytes_:array<uint8>=[]
    let chunk_start:int64=i
    let interpolated:bool=false
    loop (i <? stop) {
        # (literals.dewy reads the text up to an interpolation)
        i = literal_string_text(@reader_ctx.reader.dn_string_problem @bytes_ source i stop)
        if ((reader_ctx.reader.dn_string_problem.message as array<uint8>).length >? 0) {
            reader_ctx.stores.host[0].dn_error(reader_ctx.reader.dn_string_problem.at reader_ctx.reader.dn_string_problem.message);
        }
        if (i >=? stop) {
            break
        }
        interpolated = true
        if (bytes_.length >? 0) {
            chunks.push(rd_dn_text(@reader_ctx @reader_nodes reader_ctx.stores.host[0].str_from_bytes(bytes_) chunk_start));
            bytes_.clear();
        }
        let first:int64=(int64<overflow='wrap'>(i) + 1)
        i = reader_ctx.stores.host[0].dn_interpolation_close(source first stop)
        # (`{x:.2f}`: a format spec after the value's last top-level colon)
        let colon:int64=reader_ctx.stores.host[0].spec_colon(source first i)
        let saved_tokens:array<DewyLexeme>=reader_ctx.tokens
        let saved_at:int64=reader_ctx.at
        let saved_angles:int64=reader_ctx.reader.dn_angles
        let saved_comma:bool=reader_ctx.flags.comma_stop
        reader_ctx.tokens = reader_ctx.stores.host[0].dn_lex(reader_ctx.file first (if (colon >=? 0) colon else i) true)
        reader_ctx.at = 0
        reader_ctx.reader.dn_angles = 0
        reader_ctx.flags.comma_stop = false
        reader_ctx.reader.dn_in_interpolation = (int64<overflow='wrap'>(reader_ctx.reader.dn_in_interpolation) + 1)
        let expression:int64=rd_dc_expr(@reader_ctx @reader_nodes 0)
        if ((expression not=? 0) and (reader_ctx.tokens[reader_ctx.at].kind not=? 'eof')) {
            reader_ctx.stores.host[0].dn_error(reader_ctx.tokens[reader_ctx.at].start "expected one interpolation expression");
        }
        reader_ctx.reader.dn_in_interpolation = (int64<overflow='wrap'>(reader_ctx.reader.dn_in_interpolation) - 1)
        reader_ctx.tokens = saved_tokens
        reader_ctx.at = saved_at
        reader_ctx.reader.dn_angles = saved_angles
        reader_ctx.flags.comma_stop = saved_comma
        let spec:string=(if (colon >=? 0) reader_ctx.stores.host[0].bytes_slice(source (int64<overflow='wrap'>(colon) + 1) i) else "")
        if (expression =? 0) {
            return 0
        }
        let part:int64=node_mk(@reader_nodes 'pair' rd_mkpos(reader_ctx.file first))
        reader_nodes[part].a = int32<overflow='wrap'>(expression)
        reader_nodes[part].sval = (if (colon >=? 0) int32<overflow='wrap'>(reader_ctx.stores.host[0].intern(spec)) else int32((-1)))
        chunks.push(part);
        i = (int64<overflow='wrap'>(i) + 1)
        chunk_start = i
    }
    if (not interpolated) {
        return rd_dn_text(@reader_ctx @reader_nodes reader_ctx.stores.host[0].str_from_bytes(bytes_) token.start)
    }
    if (bytes_.length >? 0) {
        chunks.push(rd_dn_text(@reader_ctx @reader_nodes reader_ctx.stores.host[0].str_from_bytes(bytes_) chunk_start));
    }
    let n:int64=node_mk(@reader_nodes 'str_lit' rd_mkpos(reader_ctx.file token.start))
    reader_nodes[n].aux = 1
    node_set_list(@reader_nodes @reader_ctx.stores.lists[0] n chunks);
    n
}

rd_dn_take=(@reader_ctx:ParserContext):>DewyLexeme=>$unsafe {
    let value:DewyLexeme=reader_ctx.tokens[reader_ctx.at]
    reader_ctx.at = (int64<overflow='wrap'>(reader_ctx.at) + 1)
    value
}

# String decoding is shared; the construction target selects syntax nodes for
# the reference parser or compact nodes for the value parser.
rd_dn_text=(@reader_ctx:ParserContext @reader_nodes:array<Node> text:string offset:int64):>int64=>$unsafe {
    let n:int64=node_mk(@reader_nodes 'str_lit' rd_mkpos(reader_ctx.file offset))
    reader_nodes[n].sval = int32<overflow='wrap'>(reader_ctx.stores.host[0].intern(text))
    n
}

rd_dn_token_edit=(@reader_ctx:ParserContext at:int64):>void=>$unsafe {
    if (not reader_ctx.reader.dn_edits_on) {
        return
    }
    reader_ctx.reader.dn_edit_at.push(at);
    reader_ctx.reader.dn_edit_was.push(reader_ctx.tokens[at]);
}

# The two operands of a comparison as written, split at its operator outside
# brackets and quotes ([] when the operator is not found once).
rd_dw_comparison_sides=(@reader_ctx:ParserContext text:string op:DewyToken):>array<string>=>$unsafe {
    let spelled:string=dn_token_text(op)
    let depth:int64=0
    let quote:uint8=0
    let at:int64=(-1)
    let i:int64=0
    loop (i <? (text as array<uint8>).length) {
        let c:uint8=(text as array<uint8>)[i]
        if (quote not=? 0) {
            if (c =? b'\\') {
                i = (int64<overflow='wrap'>(i) + 1)
            }
            else if (c =? quote) {
                quote = 0
            }
        }
        else if ((c =? b'"') or (c =? b'\'')) {
            quote = c
        }
        else if (((c =? b'(') or (c =? b'[')) or (c =? b'\{')) {
            depth = (int64<overflow='wrap'>(depth) + 1)
        }
        else if (((c =? b')') or (c =? b']')) or (c =? b'\}')) {
            depth = (int64<overflow='wrap'>(depth) - 1)
        }
        else if (((depth =? 0) and ((int64<overflow='wrap'>(i) + int64<overflow='wrap'>((spelled as array<uint8>).length)) <=? (text as array<uint8>).length)) and (reader_ctx.stores.host[0].bytes_slice(text i (int64<overflow='wrap'>(i) + int64<overflow='wrap'>((spelled as array<uint8>).length))) =? spelled)) {
            # (`<?` inside `<=?`, `=?` inside `not=?`: the whole operator only)
            let before:uint8=(if (i >? 0) (text as array<uint8>)[(int64<overflow='wrap'>(i) - 1)] else uint8<overflow='wrap'>(b' '))
            let negated:bool=((i >=? 3) and (reader_ctx.stores.host[0].bytes_slice(text (int64<overflow='wrap'>(i) - 3) i) =? "not"))
            if (((((before not=? b'<') and (before not=? b'>')) and (before not=? b'=')) and (before not=? b'.')) and (not negated)) {
                if (at >=? 0) {
                    return []
                }
                at = i
                i = (int64<overflow='wrap'>(i) + int64<overflow='wrap'>((spelled as array<uint8>).length))
                continue
            }
        }
        i = (int64<overflow='wrap'>(i) + 1)
    }
    if (at <? 0) {
        return []
    }
    [reader_ctx.stores.host[0].trim(reader_ctx.stores.host[0].bytes_slice(text 0 at)) reader_ctx.stores.host[0].trim(reader_ctx.stores.host[0].bytes_slice(text (int64<overflow='wrap'>(at) + int64<overflow='wrap'>((spelled as array<uint8>).length)) (text as array<uint8>).length))]
}

# Pure scalar syntax can stay a compile-time expression. Anything that reads a
# name, calls code or constructs a collection must retain one initialized value.
rd_dw_const_number=(@reader_nodes:array<Node> n:int64):>bool=>$unsafe {
    let k:NK=reader_nodes[n].kind
    if (((k =? 'int_lit') or (k =? 'float_lit')) or (k =? 'bool_lit')) {
        return true
    }
    if ((k =? 'unary') or (k =? 'not_')) {
        return rd_dw_const_number(@reader_nodes int64<overflow='wrap'>(reader_nodes[n].a))
    }
    if (((k =? 'binary') or (k =? 'and_')) or (k =? 'or_')) {
        return (rd_dw_const_number(@reader_nodes int64<overflow='wrap'>(reader_nodes[n].a)) and rd_dw_const_number(@reader_nodes int64<overflow='wrap'>(reader_nodes[n].b)))
    }
    false
}

rd_dw_text=(@reader_ctx:ParserContext @reader_nodes:array<Node> text:string pos:int64):>int64=>$unsafe {
    let n:int64=node_mk(@reader_nodes 'str_lit' pos)
    reader_nodes[n].sval = int32<overflow='wrap'>(reader_ctx.stores.host[0].intern(text))
    n
}

# Surface type spellings share one translation in both construction paths.
rd_dw_type_name=(@reader_ctx:ParserContext name:string):>string=>$unsafe {
    if (name =? "addr") {
        reader_ctx.stores.host[0].g_refine_active_set(true)
    }
    db_type_name(name)
}

rd_dw_value_name=(@reader_ctx:ParserContext name:int32 pos:int64):>int32=>$unsafe {
    if (reader_ctx.reader.dw_renamed.length =? 0) {
        rd_reader_initialize_names(@reader_ctx);
    }
    db_value_name(@reader_ctx.reader.dw_renamed name pos)
}

rd_has_flag=(@reader_nodes:array<Node> n:int64 f:int64):>bool=>$unsafe {
    ((int64<overflow='wrap'>(reader_nodes[n].flags) and f) not=? 0)
}

rd_is_alnum=(c:uint8):>bool=>$unsafe {
    (rd_is_alpha(c) or rd_is_digit(c))
}

rd_is_alpha=(c:uint8):>bool=>$unsafe {
    ((((c >=? b'a') and (c <=? b'z')) or ((c >=? b'A') and (c <=? b'Z'))) or (c =? b'_'))
}

# String utilities. Strings are immutable UTF-8 byte sequences; indexing gives bytes.
rd_is_digit=(c:uint8):>bool=>$unsafe {
    ((c >=? b'0') and (c <=? b'9'))
}

rd_kid=(@reader_ctx:ParserContext @reader_nodes:array<Node> n:int64 i:int64):>int64=>$unsafe {
    int64<overflow='wrap'>(reader_ctx.stores.lists[0][(int64<overflow='wrap'>(int64<overflow='wrap'>(reader_nodes[n].list)) + int64<overflow='wrap'>(i))])
}

rd_kids=(@reader_ctx:ParserContext @reader_nodes:array<Node> n:int64):>array<int64>=>$unsafe {
    node_kids(@reader_nodes @reader_ctx.stores.lists[0] n)
}

rd_kids2=(@reader_ctx:ParserContext @reader_nodes:array<Node> n:int64):>array<int64>=>$unsafe {
    node_kids2(@reader_nodes @reader_ctx.stores.lists[0] n)
}

# (the one-line field reads and flag tests stay here, where they inline into their callers)
rd_mk=(@reader_nodes:array<Node> kind:NK pos:int64):>int64=>$unsafe {
    node_mk(@reader_nodes kind pos)
}

# position encoding: file index in the high bits, byte offset in the low 40 bits
rd_mkpos=(file:int64 off:int64):>int64=>$unsafe {
    ((int64<overflow='wrap'>(file) << 40) or off)
}

rd_name_of=(@reader_ctx:ParserContext id:int64):>string=>$unsafe {
    reader_ctx.stores.texts[0][id]
}

rd_nkids=(@reader_nodes:array<Node> n:int64):>int64=>$unsafe {
    int64<overflow='wrap'>(reader_nodes[n].nlist)
}

rd_pos_file=(p:int64):>int64=>$unsafe {
    (p >> 40)
}

rd_pos_off=(p:int64):>int64=>$unsafe {
    (p and 0xFFFFFFFFFF)
}

rd_reader_initialize_names=(@reader_ctx:ParserContext):>void=>$unsafe {
    reader_ctx.stores.host[0].dw_renamed_init();
}

rd_set_list=(@reader_ctx:ParserContext @reader_nodes:array<Node> n:int64 xs:array<int64>):>void=>$unsafe {
    node_set_list(@reader_nodes @reader_ctx.stores.lists[0] n xs);
}

rd_set_list2=(@reader_ctx:ParserContext @reader_nodes:array<Node> n:int64 xs:array<int64>):>void=>$unsafe {
    node_set_list2(@reader_nodes @reader_ctx.stores.lists[0] n xs);
}

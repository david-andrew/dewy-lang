use 'lower_closures.dewy'
use 'lower_storage.dewy'
use 'lower_analysis.dewy'
use 'lower_helpers.dewy'
use 'lower_group.dewy'
use 'checker_state.dewy'
use 'math_lower.jo'
use 'refinement_types.dewy'
# Scoped parallel regions survive checking. A small fixed collector whose only
# uses are constant element reads needs neither a collection ABI nor a job on
# the sequential path. Other regions retain the ordinary library lowering.
use 'lower.jo'
use 'ast.jo'
use 'check.jo'
use 'expr.jo'
use 'types.jo'
use 'util.jo'
use 'ir.jo'
use 'ownership.jo'
use 'partition.jo'
use 'facts.jo'
use 'ownership_types.dewy'
use 'lower_primitives.dewy'
use 'lower_races.dewy'
use 'ir_builders.dewy'
use 'math_ops.dewy'
use 'parallel_ops.dewy'

struct ParallelRegion:
    call: int
    callback: int
    first: int
    count: int

# Function-local lowering state, reset by begin_fn (including fused workers).
# Values are the joined scalar results, in source order.
parallel_serial = false
parallel_scalars: {int: int[]}
parallel_owned: {int: int}

# Register compiler-only runtime ABIs while checking the region, before the
# checked program is frozen for emission. Ordinary bulk loops do not need them.
# The legacy scheduler gives random() a separate stream. Keep that boundary
# unless the transitive body is known not to observe it. Unknown callback calls
# and large graphs conservatively retain the library path. This visited set is
# private to one query: optimistic cycle edges cannot publish a false summary.
# A promoted job's native ABI is (ignored closure environment, job-address).
# Its adapter owns the result representation, including narrow integers and
# floats. Scheduling itself never needs to inspect the result type.

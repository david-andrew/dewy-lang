$runtime_checks
from p"lower.jo" import (VC_AGG VC_INT begin_fn data_size e_daddr e_gaddr ffi_keys ffi_offs ffi_slot late_binding mac_imports rt str_data)
from p"ir.jo" import (VF VI VS e_bin e_call1 e_call2 e_calli e_iconst e_load e_mov e_ret e_store e_zero emit ir vreg)
from p"types.jo" import (align_up prune tkind tsize types)
from p"lower_storage.dewy" import (endc iff norm opt_has ret_vt vc vt_of)
from p"util.jo" import (fatal name_of)
from p"check.jo" import (fns target_macos target_windows)
from p"ast.jo" import (nodes)
from p"pe_format.dewy" import (pe_imports)
# Direct recursive lowering; shared state has one owner in lower.jo.
LFFWord:type=int64<overflow='wrap'>
mac_bound_lib=(lib:string):>string=>$unsafe {
    if starts_with(lib "/") {return lib}
    if lib =? "libc.so.6" or lib =? "libm.so.6" or lib =? "libdl.so.2" or lib =? "libpthread.so.0" {return "/usr/lib/libSystem.B.dylib"}
    return ""
}
c_nullable=(t0:LFFWord):>bool=>$unsafe {
    let t=prune(t0)
    return types.ptr[t].kind =? 'opt' and tkind(LFFWord(types.ptr[t].elem)) =? 'ptr'
}
lower_extern_thunk=(lf:LFFWord f:LFFWord):>void=>$unsafe {
    begin_fn(fns.ptr[f].sym lf);
    let lib=fns.ptr[f].clib
    let nm=name_of(LFFWord(nodes.ptr[LFFWord(fns.ptr[f].decl)].name))
    if (fns.ptr[f].csym).length >? 0 {nm=fns.ptr[f].csym}
    let ret:LFFWord=LFFWord(fns.ptr[f].ret)
    # (Dewy's ptr<T>?: an optional held as a value, null to C when it is none)
    let sret=if c_nullable(ret) {vreg(VI)} else {-1}
    let ps:array<int64>=[]
    loop t in fns.ptr[f].ptypes {
        if vc(t) =? VC_AGG and not c_nullable(t) {fatal(nodes.ptr[LFFWord(fns.ptr[f].decl)].pos "C functions can only take scalar or pointer arguments");}
        if tkind(t) =? 'array' {fatal(nodes.ptr[LFFWord(fns.ptr[f].decl)].pos "a C function cannot take an array: declare the parameter as a pointer (*f32) and pass data(xs)");}
        ps.push(vreg(vt_of(t)));
    }
    ir.nparams = ir.vtypes.length;
    # (a str goes to C as its bytes, ending in a zero byte: a char *)
    let cps:array<int64>=[]
    loop i in [0..fns.ptr[f].ptypes.length) and t in fns.ptr[f].ptypes {
        if c_nullable(t) {
            let p=vreg(VI)
            e_mov(p e_iconst(0));
            iff(opt_has(ps.ptr[i] LFFWord(types.ptr[prune(t)].elem)));
            e_mov(p e_load(VI ps.ptr[i] 0 8));
            endc();
            cps.push(p);
        }
        else if tkind(t) =? 'str_' {cps.push(e_call1(rt("__c_str") ps.ptr[i] VI));}
        else if fns.ptr[f].cvariadic >? 0 and i >=? LFFWord(fns.ptr[f].cvariadic) - 1 and vt_of(t) =? VS {
            # C promotes variadic floats to double. Fixed f32 parameters keep
            # their declared type; narrow integers already use extended registers.
            let d=vreg(VF)
            emit('f2f' VF d ps.ptr[i] 0 0 0);
            cps.push(d);
        }
        else {cps.push(ps.ptr[i]);}
    }
    if vc(ret) =? VC_AGG and sret <? 0 {fatal(nodes.ptr[LFFWord(fns.ptr[f].decl)].pos "C functions can only return scalars or pointers");}
    ir.ret = ret_vt(ret);
    data_size=align_up(data_size 8)
    let slot=data_size
    data_size += 8;
    ffi_slot[slot] = ffi_offs.length;
    ffi_offs.push(slot);
    ffi_keys.push("ffi|{lib}|{nm}");
    let fp=vreg(VI)
    let imp:LFFWord=-1
    if target_windows and lower(lib) =? "kernel32.dll" {imp=LFFWord(pe_imports.index_of(nm) ?? -1)}
    if imp >=? 0 {
        # (one of the functions the program imports: from the import table, compiler/pe.jo)
        emit('intr' VI fp 0 0 int32<overflow='wrap'>(imp) 10);
    }
    else if target_macos and (mac_bound_lib(lib)).length >? 0 and (not late_binding or nm =? "dlopen" or nm =? "dlsym" or nm =? "dlerror") {
        # (dyld has put it in the slot, or null where its library is missing)
        mac_imports.push([slot mac_bound_lib(lib) nm]);
        e_mov(fp e_load(VI e_gaddr(slot) 0 8));
        iff(e_bin('eq' VI fp e_iconst(0)));
        e_call2(rt("__ffi_missing") e_daddr(str_data(lib)) e_daddr(str_data(nm)) -1);
        endc();
    }
    else {
        let rlib=lib
        if target_macos and (mac_bound_lib(lib)).length >? 0 {rlib=mac_bound_lib(lib)}
        e_mov(fp e_load(VI e_gaddr(slot) 0 8));
        iff(e_bin('eq' VI fp e_iconst(0)));
        e_mov(fp e_call2(rt("__ffi_resolve") e_daddr(str_data(rlib)) e_daddr(str_data(nm)) VI));
        e_store(e_gaddr(slot) 0 fp 8);
        endc();
    }
    let r=e_calli(fp cps (if sret >=? 0 {VI} else {ret_vt(ret)}) true)
    # (C's variadic arguments: on Apple's arm64 they go on the stack)
    if fns.ptr[f].cvariadic >? 0 {ir.code.ptr[ir.code.length - 1].imm = LFFWord(fns.ptr[f].cvariadic);}
    if sret >=? 0 {
        e_zero(sret tsize(ret));
        e_store(sret 0 r 8);
        e_store(sret 8 e_bin('ne' VI r e_iconst(0)) 1);
        e_ret(sret);
        return
    }
    if vc(ret) =? VC_INT {r=norm(r ret)}
    e_ret(r);
}

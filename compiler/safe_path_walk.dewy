            if not ut_first {continue}
            let bits=ut_arg_bits(x)
            if bits <? 0 {ut_mark_unproven(pl ut_origin(x "unproven text given to `{name_of(PathWalkWord(nodes.ptr[d].name))}`"))} else if bits not=? 0 {
                # (this function's own parameters: what their callers give them follows, along edges)
                loop j in 0.. and src in fns.ptr[ut_cur].params {
                    if j >=? UT_PARAMS {break}
                    if bits & (PathWalkWord(1) << (UT_JOIN + j)) =? 0 {continue}
                    let pair=src * 4294967296 + pl
                    if ut_upairs.has(pair) {continue}
                    ut_upairs[pair]=true
                    ut_uto.push(pl)
                    ut_unext.push(ut_uhead[src])
                    ut_uhead[src]=ut_uto.length - 1
                    if ut_lu[src] not=? 0 {ut_mark_unproven(pl ut_lu[src])}
                }
            }
        }
    }
    if not ut_first {return}
    if ut_safe_used {
        let mask=ut_param_safe.get(d) ?? 0
        if mask not=? 0 and not pos_in_lib(nodes.ptr[n].pos) {
            loop i in [0..min(na 62)) {
                let x=kid(n i)
                if mask & (PathWalkWord(1) << i) not=? 0 and not ut_safe(x) {
                    let pn=name_of(PathWalkWord(nodes.ptr[kid(d i)].name))
                    ut_unproven(x "{name_of(PathWalkWord(nodes.ptr[d].name))}'s `{pn}` is a SafePath")
                }
            }
        }
    }
    # (a soft precondition `x isnt? SafePath`: decided once the facts settle, unless proven here)
    if ut_paths_used and wi_decls.has(d) {
        loop w in wi_decls[d] {
            if w.kind not=? WI_PATH or w.param >=? na {continue}
            let x=kid(n w.param)
            let safe=if w.wrapped {ut_safe_text(x)} else {ut_safe(x)}
            if not safe {ut_sink_calls.push([x ut_cur d])}
        }
    }
}
# the source text of a simple argument (a name, or a field of one), or ""
ut_arg_text=(x0:PathWalkWord):>string=>$unsafe {
    let x=ut_strip(x0)
    if x =? 0 {return ""}
    if nodes.ptr[x].kind =? 'ident' {
        let nm=name_of(PathWalkWord(nodes.ptr[x].name))
        if (nm as array<uint8>).length >? 0 and (nm as array<uint8>)[0] not=? b'$' {return nm}
        return ""
    }
    if nodes.ptr[x].kind =? 'field' {
        let b=ut_arg_text(PathWalkWord(nodes.ptr[x].a))
        if (b as array<uint8>).length >? 0 {return "{b}.{name_of(PathWalkWord(nodes.ptr[x].name))}"}
    }
    ""
}
# the base a path argument was built on (`{root}/...`: root), for the fix; "root" when unknown
ut_base_text=(x0:PathWalkWord):>string=>$unsafe {
    let x=ut_strip(x0)
    if x not=? 0 and nodes.ptr[x].kind =? 'ident' and nodes.ptr[x].aux =? int32(1) and nodes.ptr[x].sym >? 0 {
        # (a local made by p"{root}/...": its initializer)
        let l=ut_root(PathWalkWord(nodes.ptr[x].sym))
        if ut_linit[l] not=? 0 {x=ut_strip(ut_linit[l])}
    }
    if x not=? 0 and nodes.ptr[x].kind =? 'call' and nkids(x) =? 1 {
        let s=ut_strip(kid(x 0))
        if nodes.ptr[s].kind =? 'str_lit' and nodes.ptr[s].aux not=? 0 and nkids(s) >? 0 {
            let first=kid(s 0)
            if nodes.ptr[first].kind =? 'pair' {
                let v=ut_strip(PathWalkWord(nodes.ptr[first].a))
                if ut_is_path(PathWalkWord(nodes.ptr[v].type)) {
                    let t=ut_arg_text(v)
                    if (t as array<uint8>).length >? 0 {return t}
                }
            }
        }
    }
    "root"
}
# (the fixes, as the editor offers them: lsp.jo reads the first)
ut_fixes=(x:PathWalkWord):>string=>{
    let arg=ut_arg_text(x)
    let base=ut_base_text(x)
    let fix=if (arg as array<uint8>).length >? 0 {arg} else {"..."}
    "validate it, `{base}.confine({fix}) or_throw`, or test it first, `if {base}.contains({fix}) \{...}`"
}
ut_warn_sinks=():>void=>$unsafe {
    let seen=dict<int64 bool>()
    loop item in ut_sink_calls {
        let x=item[0]
        if seen.has(x) {continue}
        seen[x]=true
        ut_cur=item[1]
        let o=ut_traversal(x)
        ut_cur=0
        let message=""
        loop w in wi_decls[item[2]] {
            if w.kind =? WI_PATH {message=w.message}
        }
        if o not=? 0 {
            warn(nodes.ptr[x].pos "{ut_shown(x)} {message} ({ut_origin_text(o nodes.ptr[x].pos)}): {ut_fixes(x)}")
        }
        else if dir_confine_paths(nodes.ptr[x].pos) {
            warn(nodes.ptr[x].pos "{ut_shown(x)} is not proven to stay inside a base, which `$confine_external_paths` asks of every path a file-system operation gets: {ut_fixes(x)}, or opt this scope out with `$confine_external_paths=false`")
        }
    }
}
# check_program, once every function is checked
ut_run=():>void=>$unsafe {
    let taint=ut_paths_used
    if not ut_safe_used and not taint {return}
    let n=locals.length + 1
    ut_lo=fill(0 n)
    ut_lm=fill(0 n)
    ut_li=fill(0 n)
    ut_lu=fill(0 n)
    ut_lp=fill(0 n)
    ut_lr=fill(0 n)
    ut_lf=fill(0 n)
    ut_ls=fill(0 n)
    ut_linit=fill(0 n)
    ut_queued=fill(0 fns.length + 1)
    ut_walked=fill(0 fns.length + 1)
    ut_rr=fill(0 fns.length + 1)
    ut_ehead=fill((-1) n)
    ut_uhead=fill((-1) n)
    ut_fu=fill(0 fns.length + 1)
    ut_fk=fill(0 fns.length + 1)
    ut_tb=fill(0 types.length + 1)
    # (module initializers first: globals are declared there)
    let order:array<int64>=[]
    loop mi in [0..modules.length) {
        if modules[mi].is_prelude {continue}
        let f=PathWalkWord(modules[mi].init_fn)
        if f >? 0 and f <? fns.length and fns.ptr[f].body not=? 0 and dewy_at(nodes.ptr[PathWalkWord(fns.ptr[f].body)].pos) and not pos_in_lib(nodes.ptr[PathWalkWord(fns.ptr[f].body)].pos) {order.push(f)}
    }
    # (callees are mostly instantiated after their callers: the latest first, so results are
    # known before their calls are walked)
    let f=fns.length - 1
    loop f >=? 1 {
        if fns.ptr[f].kind not=? int32(FK_INIT) and ut_user_fn(f) {order.push(f)}
        f -= 1
    }
    loop f0 in order {ut_enqueue(f0)}
    let i:PathWalkWord=0
    loop true {
        loop i <? ut_queue.length {
            f=ut_queue[i]
            i += 1
            ut_queued[f]=0
            ut_walk_fn(f)
            if not taint and i >=? order.length {break}
        }
        if not taint or not ut_follow_edges() {break}
    }
    if taint {ut_warn_sinks()}
    ut_sink_calls=[]
}

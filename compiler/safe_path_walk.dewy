    let k=nodes.ptr[n].kind
    if k =? 'lambda' or k =? 'fn_' or k =? 'struct_' or k =? 'enum_' or k =? 'typealias' or k =? 'tname' or k =? 'fnref' {return}
    if k =? 'block' {
        ut_visit_list(n)
        return
    }
    if k =? 'vardecl' {
        let v=PathWalkWord(nodes.ptr[n].b)
        ut_visit(v)
        let id=PathWalkWord(nodes.ptr[n].sym)
        if v =? 0 or id <=? 0 {return}
        let global=ut_global_decl(n id)
        let o=ut_val(v)
        let m=ut_m
        if global {
            ut_mark_global(id o m)
            if ut_first and ut_global_single(id) {
                if ut_is_path(PathWalkWord(globals.ptr[id].type)) and ut_safe(v) {ut_safe_globals[id]=true} else if prune(PathWalkWord(globals.ptr[id].type)) =? T_STR {
                    let c=ut_text_class(v)
                    if c not=? 0 {ut_text_globals[id]=c}
                }
            }
            return
        }
        if o not=? 0 or m not=? 0 {ut_flow(id v)}
        if not ut_first {return}

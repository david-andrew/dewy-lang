            let lt=PathWalkWord(locals.ptr[id].type)
            if prune(lt) =? T_STR {
                let c=ut_text_class(v)
                ut_ls[id] |= c << 2
            }
        }
        return
    }
    if k =? 'assign' {
        ut_visit(PathWalkWord(nodes.ptr[n].a))
        ut_visit(PathWalkWord(nodes.ptr[n].b))
        let target=PathWalkWord(nodes.ptr[n].a)
        let field:PathWalkWord=0
        loop target not=? 0 and (nodes.ptr[target].kind =? 'field' or nodes.ptr[target].kind =? 'index') {
            field=if nodes.ptr[target].kind =? 'field' {PathWalkWord(nodes.ptr[target].name)} else {0}
            target=PathWalkWord(nodes.ptr[target].a)
        }
        if target =? 0 or nodes.ptr[target].kind not=? 'ident' {return}
        let o=ut_val(PathWalkWord(nodes.ptr[n].b))
        let m=ut_m
        if nodes.ptr[target].aux =? int32(1) and nodes.ptr[target].sym >? 0 {
            let l=PathWalkWord(nodes.ptr[target].sym)
            if o not=? 0 or m not=? 0 {
                # (`x.f = v`: that field; `x = v`: all of it; an element: all of it)
                if field not=? 0 {ut_mark_field(l field o m)} else if target =? PathWalkWord(nodes.ptr[n].a) {ut_flow(l PathWalkWord(nodes.ptr[n].b))}
                else {ut_mark_local(l o m)}
            }
            if ut_first and target =? PathWalkWord(nodes.ptr[n].a) and (ut_ls[l] | ut_ls[ut_root(l)]) & UT_L_DECLARED not=? 0 and not ut_safe(PathWalkWord(nodes.ptr[n].b)) {
                ut_unproven(PathWalkWord(nodes.ptr[n].b) "`{name_of(PathWalkWord(nodes.ptr[target].name))}` is declared a SafePath")
            }
        }
        else if nodes.ptr[target].aux =? int32(2) {
            ut_mark_global(PathWalkWord(nodes.ptr[target].sym) o m)
        }
        return
    }
    if k =? 'return_' {
        ut_visit(PathWalkWord(nodes.ptr[n].a))
        if nodes.ptr[n].a not=? 0 {ut_returned(PathWalkWord(nodes.ptr[n].a))}
        return
    }
    if k =? 'if_' {
        ut_visit(PathWalkWord(nodes.ptr[n].a))
        let mark=ut_narrowed.length
        ut_guarded(PathWalkWord(nodes.ptr[n].a) @ut_narrowed)
        ut_visit(PathWalkWord(nodes.ptr[n].b))
        ut_narrowed.truncate(mark)
        ut_visit(PathWalkWord(nodes.ptr[n].c))
        return
    }
    if k =? 'call' {
        ut_visit(PathWalkWord(nodes.ptr[n].a))
        loop i in [0..nkids(n)) {ut_visit(kid(n i))}
        ut_call(n)
        return
    }
    if (k =? 'for_' or k =? 'match_') and nodes.ptr[n].sym >? 0 {
        # (the loop's variable holds the elements; the arms' bindings hold what is matched)
        let o=ut_val(PathWalkWord(nodes.ptr[n].a))
        ut_mark_local(PathWalkWord(nodes.ptr[n].sym) o ut_m)
    }
    ut_visit(PathWalkWord(nodes.ptr[n].a))
    ut_visit(PathWalkWord(nodes.ptr[n].b))
    # (a checked loop's c and d are locals, a partial's d a function instance: not nodes)
    if k not=? 'for_' {
        ut_visit(PathWalkWord(nodes.ptr[n].c))
        if k not=? 'partial' {ut_visit(PathWalkWord(nodes.ptr[n].d))}
    }
    loop i in [0..nkids(n)) {ut_visit(kid(n i))}
    if k not=? 'match_' and k not=? 'fn_' {
        loop i in [0..nkids2(n)) {ut_visit(kid2(n i))}
    }
}
ut_call=(n:PathWalkWord):>void=>$unsafe {
    let f=PathWalkWord(nodes.ptr[n].sym)
    let d=ut_callee_decl(n)
    if d =? 0 {return}
    ut_callee_kind(n);
    let na=nkids(n)
    if ut_user_fn(f) {
        # (what each argument holds reaches the parameter, and whether its text is proven)
        loop i in [0..min(na fns.ptr[f].params.length UT_PARAMS)) {
            let pl=PathWalkWord(fns.ptr[f].params[i])
            if not ut_text_type(PathWalkWord(locals.ptr[pl].type)) {continue}
            let x=kid(n i)
            let o=ut_val(x)
            let m=ut_m
            if o not=? 0 {ut_mark_in(pl o)}
            if m & UT_PASS not=? 0 {ut_edges(m & UT_PASS pl * 4 + 3)}
            if m & ~UT_PASS not=? 0 {ut_mark_in(pl ut_concrete(ut_cur m & ~UT_PASS))}

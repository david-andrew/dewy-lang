repl_start = () -> str:
    repl_next = repl_region()
    src = "__repl_main = (): __repl_serve({repl_next}, {REPL_REGION_SIZE})\n"
    cache = os_path(temp_dir()) + "/dewy-repl"
    mkdir(cache)
    path = "{cache}/repl-{ps_self_id()}{ps_exe_ext()}"
    # read_source looks up virtual text by its normalized path. TMPDIR often
    # ends in a slash (including on macOS), so normalize the stored key too.
    main_src = path_norm("{cache}/<input>")
    ide_texts[main_src] = src
    repl_image = true
    bss_reserve = REPL_DATA_RESERVE
    # (the session's module is the one the inputs add to)
    built = compile(main_src, path)
    if len(built) == 0: return "could not build the session program"
    loop i in 0.. and m in modules:
        if m.is_main: repl_mainm = i
    late_binding = true
    # (inputs `use` files relative to the current directory)
    modules[repl_mainm].dir = cwd()
    files[int(modules[repl_mainm].file)].is_dewy = true
    mod_bits[repl_mainm] |= 2
    loop f in init_fns: repl_modules_inited[int(fns[f].mod)] = true
    loop i in [0..lfuncs.len()):
        a = 0
        if i < fn_addr.len() and fn_addr[i] >= 0: a = img_text_addr + fn_addr[i]
        lf_abs.push(a)
    ro_segs.push((0, rodata.len(), img_ro_addr))
    ro_shipped = rodata.len()
    loop lf, off in cabi_adapter: repl_cabi_abs[lf] = img_text_addr + off
    loop g in global_ids:
        if modules[int(globals[g].mod)].is_prelude and global_off.get(g) != none: repl_inited[g] = true
    if ps_windows():
        # start it with two pipes, their handles in DEWY_REPL_PIPES
        why = rs_start_windows(path)
        if len(why) > 0: return why
    else:
        # start it, with its end of two pipes as fds 3 and 4
        a = ps_pipe(false)
        b = ps_pipe(false)
        pid = ps_fork()
        if pid == 0:
            ps_dup2(a[0], 3)
            ps_dup2(b[1], 4)
            __exec_unslid(path, [path])
            ps_exit(127)
        ps_close(a[0])
        ps_close(b[1])
        repl_to = a[1]
        repl_from = b[0]
        if not repl_started(): return "the session program did not start"
        delete_file(path)
    repl_jbuf = __alloc(192)                    # (arm64's __setjmp keeps 168 bytes)
    ""
# 0: completed, 1: failed input (keep the session), 2: session ended.
repl_run_input = (text: str) -> int:
    c = repl_try(text, true)
    if not c.ok: return 1
    o = c.out
    repl_inputs += 1
    repl_send(1, o.addr, o.code)
    # (with the end of the globals: what the session copies before running it, on Windows)
    h = [2, o.addr + o.entry, img_data_addr + data_size + 8]
    repl_write(data(h) as *u8, 24)
    r = repl_wait_reply()
    if r < 0:
        eprint("the session ended")
        return 2
    if r >= 512:
        if r - 512 == 101: return 1             # a panic (it said why)
        repl_end()
        exit(r - 512)                          # exit() in the input
    if r == 256 + 2: eprint("interrupted; the session is as it was before this input")
    else if r >= 256: eprint("crashed (signal {r - 256}); the session is as it was before this input")
    if r >= 256: return 1
    0
# names that could go at the end of text (what is typed of the name being completed is dropped):
# the checker, at a placeholder name (as the language server does), then the compiler's memory
# put back as it was
repl_completions = (text: str) -> str[]:
    a = len(text)
    loop a > 0 and (is_alnum(text[a - 1]) or text[a - 1] >= 0x80): a -= 1
    probe = text[..a) + "__dewy_complete__\n"
    got = rs_complete(probe)
    prefix = text[a..]
    out: str[]
    loop l in split(got, "\n"):
        if not starts_with(l, "C\t"): continue
        e = find_byte(l, '\t', 2)
        if e < 0: e = len(l)
        name = l[2..e)
        if not starts_with(name, prefix) or out.contains(name): continue
        if starts_with(name, "__") and not starts_with(prefix, "_"): continue
        out.push(name)
    out.sort()
    out
repl_load_history = ():
    if let path = env("DEWY_REPL_HISTORY"):
        repl_hist_path = path
    else:
        home = env("HOME") ?? ""
        if ps_windows() and len(home) == 0: home = os_path(env("USERPROFILE") ?? "")
        if len(home) == 0: return
        repl_hist_path = "{home}/.dewy_history"
    if len(repl_hist_path) == 0: return
    if let h = read_file(repl_hist_path):
        loop l in lines(h):
            if len(l) > 0: repl_history.push(l)
repl_main = ():
    ide_doc = "<input>.dewy"
    repl_tty = rs_terminal()
    why = repl_start()
    if len(why) > 0:
        eprint("dewy-core: {why}")
        exit(1)
    rs_console_keys()
    if repl_tty:
        repl_out("Dewy (:help for help; braces may span lines; ctrl-d quits)\n")
        repl_load_history()
    loop true:
        repl_raw(true)
        text0 = repl_read()
        repl_raw(false)
        if text0 == none: break
        text = text0!
        if len(trim(text)) == 0: continue
        t1 = trim(text)
        if t1 == "exit" or t1 == "quit" or t1 == ":q" or t1 == ":quit" or t1 == ":exit": break
        if t1 == ":help" or t1 == ":h" or t1 == "help":
            repl_out(repl_help)
            continue
        if starts_with(t1, ":type ") or starts_with(t1, ":t ") or starts_with(t1, ":doc "):
            what = trim(t1[find_byte(t1, ' ') + 1..])
            # (built into the language: print, len of an array, ...: what they are, as API.md says)
            bi = repl_builtin_doc(what)
            if len(bi) > 0: repl_out(bi)
            repl_sig_query = true
            repl_sig = ""
            quiet = len(bi) > 0
            if quiet: quiet_errors = true
            c = repl_try(what + "\n", false)
            quiet_errors = false
            repl_sig_query = false
            repl_sig = ""
            if c.ok:
                if c.show: repl_out(c.type + "\n")
                else if not quiet: repl_out("void\n")
            continue
        if not repl_run(text): break
    repl_save_history()
    repl_end()
    exit(0)

use 'deadlock.jo'
use 'ast.jo'
use 'check.jo'
use 'util.jo'
use 'lower_helpers.dewy'
use 'isolation_ops.dewy'
use 'deadlock_locations.dewy'
use 'deadlock_walk.dewy'
use 'deadlock_channels.dewy'

dc_event = (kind: int, loc: DlLoc, site: int):
    dc_event_at(kind, loc, site, dc_branch > 0)

dc_event_at = (kind: int, loc: DlLoc, site: int, branch: bool):
    dc_count += 1
    if dc_count > DC_EVENTS:
        dc_complete = false
        return
    loops: int[]
    loop x in dc_loops: loops.push(x)
    locs: DlLoc[]
    sites: int[]
    loop h in dc_held:
        locs.push(h.loc)
        sites.push(h.site)
    dc_ev.push(DcEvent(kind, loc, loops, branch, locs, sites, site))

dc_drop = (mark: int):
    loop dc_held.len() > mark: dc_held.pop()

# A permit's reservation holds a slot until its permit is sent or dropped. The walk keeps the
# permits in scope (dc_permits: the local holding one, and an alias per match arm's binding),
# watches `send` on them and any other use, and gives the slot back where the scope ends
# (kind 9) unless the permit was sent (nothing) or sent on some path or given away (kind 10:
# the slot may be free again, which only lowers what is certain).
dc_permit_find = (sym: int) -> int:
    if sym <= 0: return -1
    i = dc_permits.len() - 1
    loop i >= 0 and dc_permits[i].sym != sym: i -= 1
    i

dc_permit_open = (call: int, sym: int):
    if sym <= 0 or call == 0: return
    op = dc_chan_call(call)
    sure = op == 1 and dc_branch == 0
    dc_permits.push(DcPermit(dc_loc(kid(call, 0)), nodes[call].pos, sym, dc_permits.len(), dc_branch, dc_loops.len(), 0, sure))

dc_permit_alias = (n: int) -> bool:
    sym = int(nodes[n].sym)
    e = dc_strip(int(nodes[n].b))
    if sym <= 0 or e == 0 or nodes[e].kind != .ident: return false
    i = dc_permit_find(int(nodes[e].sym))
    if i < 0: return false
    p = dc_permits[i]
    dc_permits.push(DcPermit(p.loc, p.site, sym, p.root, p.depth, p.nloops, 0, p.sure))
    true

dc_permit_use = (n: int):
    i = dc_permit_find(int(nodes[n].sym))
    if i < 0: return
    r = dc_permits[i].root
    if dc_permits[r].state == 0: dc_permits[r].state = 2

# Every use inside a function value: it may run anywhere, so the permit is given away.
dc_permit_scan = (n: int):
    if n == 0: return
    if nodes[n].kind == .ident: dc_permit_use(n)
    dc_permit_scan(int(nodes[n].a))
    dc_permit_scan(int(nodes[n].b))
    dc_permit_scan(int(nodes[n].c))
    loop c in kids(n): dc_permit_scan(c)

# `permit.send(value)` on a permit in scope: sent, on every path or on some.
dc_permit_send = (n: int) -> bool:
    if nodes[n].aux != 0 or nodes[n].sym <= 0 or nkids(n) != 2: return false
    d = int(fns[int(nodes[n].sym)].decl)
    if d == 0 or name_of(int(nodes[d].name)) != "send" or not ends_with(files[pos_file(nodes[d].pos)].path, "/prelude/reserved.dewy"): return false
    e = dc_strip(kid(n, 0))
    if e == 0 or nodes[e].kind != .ident: return false
    i = dc_permit_find(int(nodes[e].sym))
    if i < 0: return false
    r = dc_permits[i].root
    if dc_permits[r].state == 0:
        if dc_branch == dc_permits[r].depth and dc_loops.len() == dc_permits[r].nloops: dc_permits[r].state = 1
        else: dc_permits[r].state = 2
    dc_walk(kid(n, 1))
    true

dc_release = (mark: int):
    loop dc_permits.len() > mark:
        i = dc_permits.len() - 1
        p = dc_permits[i]
        if p.root == i and p.state != 1:
            kind = if p.state == 0: 9 else: 10
            dc_event_at(kind, p.loc, p.site, not p.sure)
        dc_permits.pop()

dc_walk = (n: int):
    if n == 0 or dc_count > DC_EVENTS: return
    k = nodes[n].kind
    if k == .lambda or k == .fnref:
        if dc_permits.len() > 0: dc_permit_scan(n)
        return
    if k == .ident and dc_permits.len() > 0: dc_permit_use(n)
    if k == .block:
        mark = dc_held.len()
        pmark = dc_permits.len()
        loop c in kids(n): dc_walk(c)
        if nodes[n].aux != 5:
            dc_drop(mark)
            dc_release(pmark)
        return
    if k == .match_ and dc_reserve_call(int(nodes[n].a)) != 0:
        # (the scrutinee is evaluated on every path; its permit is the match's hidden local, which
        # each arm's binding aliases)
        loop g in value_helper_calls(n): dc_enter(g, 0)
        pmark = dc_permits.len()
        hold = dc_held.len()
        dc_walk(int(nodes[n].a))
        dc_permit_open(dc_reserve_call(int(nodes[n].a)), int(nodes[n].sym))
        dc_branch += 1
        loop c in kids(n):
            dc_walk(c)
            dc_drop(hold)
        dc_branch -= 1
        dc_release(pmark)
        return
    if k == .vardecl:
        init = int(nodes[n].b)
        loop init != 0 and nodes[init].kind == .conv: init = int(nodes[init].a)
        if init != 0 and nodes[init].kind == .call:
            what = dl_lock_call(init)
            if what == "lock" or what == "try_lock$acquire" or what == "__take":
                loc = dc_loc(dl_receiver(init))
                if what == "lock": dc_event(4, loc, nodes[init].pos)
                dc_held.push(DlHeld(loc, nodes[init].pos, int(nodes[n].sym)))
                return
        if dc_permit_alias(n): return
        dc_walk(int(nodes[n].b))
        dc_permit_open(dc_reserve_call(int(nodes[n].b)), int(nodes[n].sym))
        return
    if k == .if_ or k == .iflet:
        dc_walk(int(nodes[n].a))
        mark = dc_held.len()
        dc_branch += 1
        dc_walk(int(nodes[n].b))
        dc_drop(mark)
        dc_walk(int(nodes[n].c))
        dc_drop(mark)
        dc_branch -= 1
        return
    if k == .for_ or k == .while_:
        trips = dc_trip_count(n)
        if k == .for_: dc_walk(int(nodes[n].a))
        cond = int(nodes[n].a)
        # (a body that may not run: a loop on a condition, or an empty range)
        maybe = trips == 0 or trips < 0 and not (k == .while_ and nodes[cond].kind == .bool_lit and nodes[cond].ival == 1)
        dc_loops.push(dc_trips.len())
        dc_trips.push(trips)
        if maybe: dc_branch += 1
        if k == .while_: dc_walk(cond)
        mark = dc_held.len()
        dc_walk(int(nodes[n].b))
        dc_drop(mark)
        if maybe: dc_branch -= 1
        dc_loops.pop()
        return
    if k == .call:
        dc_call(n)
        return
    if k == .propagate or k == .parallel_region:
        dc_walk(int(nodes[n].a))
        return
    loop g in value_helper_calls(n): dc_enter(g, 0)
    branches = k == .match_ or k == .arm
    if branches: dc_branch += 1
    mask = isolation_children(k)
    if mask < 0:
        dc_walk(int(nodes[n].a))
        dc_walk(int(nodes[n].b))
        dc_walk(int(nodes[n].c))
        loop c in kids(n): dc_walk(c)
    else:
        if mask & 1 != 0: dc_walk(int(nodes[n].a))
        if mask & 2 != 0: dc_walk(int(nodes[n].b))
        if mask & 4 != 0: dc_walk(int(nodes[n].c))
        if mask & 16 != 0:
            mark = dc_held.len()
            loop c in kids(n):
                dc_walk(c)
                if branches: dc_drop(mark)
        if mask & 32 != 0:
            loop c in kids2(n): dc_walk(c)
    if branches: dc_branch -= 1

dc_call = (n: int):
    pos = nodes[n].pos
    if dc_permits.len() > 0 and dc_permit_send(n): return
    what = dl_lock_call(n)
    if what == "__lock_all":
        words = kid(n, 1)
        if nodes[words].kind == .namedarg: words = int(nodes[words].a)
        loop c in kids(words):
            call = c
            loop nodes[call].kind == .conv: call = int(nodes[call].a)
            if nodes[call].kind == .call: dc_event(4, dc_loc(dl_receiver(call)), pos)
        return
    if ends_with(what, "$release"):
        if nkids(n) >= 2:
            g = kid(n, 1)
            if nodes[g].kind == .ident and nodes[g].sym > 0:
                loop i in [0..dc_held.len()):
                    if dc_held[i].guard == int(nodes[g].sym):
                        dc_held.remove(i)
                        break
        return
    if len(what) > 0: return
    op = dc_chan_call(n)
    if op > 0:
        loop i in [1..nkids(n)): dc_walk(kid(n, i))
        loc = dc_loc(kid(n, 0))
        if fns[int(nodes[n].sym)].mod == dc_smod: dc_ends[dl_key(loc)] = true
        if loc.root == 0 or not loc.exact or len(loc.route) > 0 or loc.root != 2 and loc.root != 1: dc_precise = false
        if op == 3: dc_closes = true
        if op == 6 or op == 7:
            dc_attempts[dl_key(loc)] = true
            if loc.root != 1 and loc.root != 2 or not loc.exact or len(loc.route) > 0: dc_unknown_attempt = true
        dc_event(op, loc, pos)
        return
    # (a select in a loop, or a merged inbox, lists receives: a consumer of each channel, whichever it takes
    # from; a select that runs once takes one value)
    waits = dc_wait_set(n)
    if waits == 2 or waits == 1 and dc_loops.len() > 0:
        loop c in written_args(n):
            source = dc_wait_source(c)
            if source == 0: continue
            loc = dc_loc(source)
            if loc.root == 0 or not loc.exact or len(loc.route) > 0 or loc.root != 2 and loc.root != 1: dc_precise = false
            dc_event(8, loc, pos)
    loop c in kids(n): dc_walk(c)
    if nodes[n].aux == 1 or nodes[n].aux == 4:
        # (a function value: what it waits for is not in view)
        dc_walk(int(nodes[n].a))
        dc_complete = false
        return
    if nodes[n].aux != 0 or nodes[n].sym <= 0: return
    g = int(nodes[n].sym)
    d = int(fns[g].decl)
    gname = if d != 0: name_of(int(nodes[d].name)) else: ""
    if gname == "__task_spawn" and nkids(n) == 2:
        h = dl_fn_arg(kid(n, 1))
        if h > 0 and fns[h].body != 0:
            if dc_pending.len() >= DC_ACTORS:
                dc_complete = false
                return
            ffns: int[]
            fcalls: int[]
            loop x in dc_ffns: ffns.push(x)
            loop x in dc_fcalls: fcalls.push(x)
            ffns.push(h)
            fcalls.push(0)
            dc_pending.push(DcSpawn(h, ffns, fcalls, dc_multi or dc_loops.len() > 0, dl_key(dc_loc(kid(n, 0))), pos))
        return
    if gname == "cancel" and pos_in_lib(nodes[d].pos): dc_cancels = true
    if gname == "cancel" and pos_in_lib(nodes[d].pos): dc_cancels = true
    if gname == "__task_join" and nkids(n) == 1:
        dc_event(5, dc_loc(kid(n, 0)), pos)
        return
    if fns[g].parallel_api: return
    # (a function given as a value to a call not walked here, as a library helper's)
    if not dl_relevant.has(g):
        loop c in kids(n):
            h = dl_fn_arg(c)
            if h > 0 and dl_relevant.has(h): dc_complete = false
        return
    dc_enter(g, n)

dc_enter = (g: int, n: int):
    if not dl_relevant.has(g) or fns[g].body == 0: return
    if dc_ffns.contains(g) or dc_ffns.len() > DC_DEPTH:
        dc_complete = false
        return
    dc_ffns.push(g)
    dc_fcalls.push(n)
    dc_walk(int(fns[g].body))
    dc_ffns.pop()
    dc_fcalls.pop()

dc_collect = ():
    dc_ev = []
    loop f in init_fns + [main_fn]:
        if f <= 0 or not dl_relevant.has(f): continue
        dc_ffns = []
        dc_fcalls = []
        dc_enter(f, 0)
    dc_actors.push(DcActor(dc_ev, "the program's thread", false, "", 0))
    i = 0
    loop i < dc_pending.len():
        s = dc_pending[i]
        i += 1
        dc_ev = []
        dc_ffns = s.ffns
        dc_fcalls = s.fcalls
        dc_loops = []
        dc_held = []
        dc_permits = []
        dc_branch = 0
        dc_multi = s.multi
        # Even a task with no waits can cancel its siblings by failing. Keep
        # its result summary, but demand a body walk only for relevant effects.
        if dl_relevant.has(s.h): dc_walk(int(fns[s.h].body))
        dc_actors.push(DcActor(dc_ev, "the task spawned at {dl_line(s.site)}", s.multi, s.group, int(fns[s.h].ret)))

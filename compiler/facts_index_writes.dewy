$runtime_checks

from p"effect_types.dewy" import (PlaceIdentity)
from p"facts.jo" import (FACT_CAP FACT_PROJECTION_SCAN FACT_RECORD FACT_ROW_SCAN FactBinding FactDifference FactProjection FactState fact_pair_key fact_projection_key fact_root_key fact_terms)
from p"facts_compare.dewy" import (fact_open_endpoint)
from p"facts_collect.dewy" import (fact_compact)
from p"facts_projection_queries.dewy" import (fact_projection_find fact_projections_indexed)
from p"facts_row_queries.dewy" import (fact_rows_indexed)
from p"facts_value_queries.dewy" import (fact_binding fact_index_get fact_index_hash fact_slot)
from p"refinement_types.dewy" import (FACT_MAX FACT_MIN FactBound FactTerm)

IndexWord:type=int64<overflow='wrap'>

# (an empty index sized to take n entries without growing)
fact_index_sized=(n:IndexWord):>array<int64>=>{
    let slots:IndexWord=8
    loop slots <? n * 2 + 2 {slots*=2}
    fill(int64(0) slots * 2 + 1)
}
fact_index_put=(@index:array<int64> key:IndexWord value:IndexWord):>void=>{
    if index.length =? 0 {index=fill(int64(0) 17)}
    if (IndexWord(index[0]) + 1) * 4 >=? index.length {
        let old=index
        let slots:IndexWord=(IndexWord(old.length) - 1) >> 1
        index=fill(int64(0) slots * 4 + 1)
        loop i in [0..slots) {
            let at:IndexWord=2 + i * 2
            if old[at] not=? 0 {fact_index_put(@index old[at - 1] IndexWord(old[at]) - 1)}
        }
    }
    let mask:IndexWord=((IndexWord(index.length) - 1) >> 1) - 1
    let slot:IndexWord=fact_index_hash(key mask)
    loop true {
        let i:IndexWord=1 + slot * 2
        if index[i + 1] =? 0 {
            index[0]=IndexWord(index[0]) + 1
            index[i]=key
            index[i + 1]=value + 1
            return
        }
        if index[i] =? key {
            index[i + 1]=value + 1
            return
        }
        slot=(slot + 1) & mask
    }
}
# Ordered records retain deterministic witnesses and budgets; hash indexes only
# locate records. Monotonically allocated values use their ordered ID vector
# as a binary-search index: O(log V) lookup, amortized O(1) append. Only a
# header mixing frames needs a hash index. Other lookups are expected O(1);
# state occupies O(V+P+D), including the copy-on-write index box.
fact_add_value=(@s:FactState v:IndexWord b:FactBound):>void=>{
    if v >? 0 and v <? fact_terms.length {fact_terms[v].slot=s.ids.length}
    if s.index[0].slots.length =? 0 and s.ids.length >? 0 and v <? s.ids[s.ids.length - 1] {
        s.index[0].slots=fact_index_sized(s.ids.length * 2)
        loop i in [0..s.ids.length) {fact_index_put(@s.index[0].slots s.ids[i] i)}
    }
    if s.index[0].slots.length not=? 0 {fact_index_put(@s.index[0].slots v s.ids.length)}
    s.ids.push(v)
    s.bounds.push(b)
}
# Small projection sets keep only their ordered records. Build the indexes
# on the first insertion reaching FACT_PROJECTION_SCAN, then maintain them.
# O(P) queries while P < 32; expected O(1) indexed queries above that, with
# O(P) promotion once per growing state. No new facts or budget are introduced.
fact_add_projection=(@s:FactState p:FactProjection):>void=>{
    let existing=fact_projection_find(s p.base p.selector p.element)
    if existing >=? 0 and s.projections[existing].value =? p.value {return}
    if not fact_projections_indexed(s) {
        if s.projections.length + 1 <? FACT_PROJECTION_SCAN {
            s.projections.push(p)
            return
        }
        let projections=s.projections
        s.projections=[]
        loop projection in projections {fact_index_projection(@s projection)}
    }
    fact_index_projection(@s p)
}
fact_index_projection=(@s:FactState p:FactProjection):>void=>{
    let i:IndexWord=s.projections.length
    let key=fact_projection_key(p.base p.selector p.element)
    if fact_index_get(s.index[0].projection_index key) <? 0 {fact_index_put(@s.index[0].projection_index key i)}
    if not p.element and fact_index_get(s.index[0].projection_value p.value) <? 0 {fact_index_put(@s.index[0].projection_value p.value i)}
    let tail:IndexWord=fact_index_get(s.index[0].projection_tail p.base)
    if tail >=? 0 {s.index[0].projection_next[tail]=i} else {fact_index_put(@s.index[0].projection_head p.base i)}
    fact_index_put(@s.index[0].projection_tail p.base i)
    s.index[0].projection_next.push(-1)
    s.projections.push(p)
}
# (v's row record, made on its first row; counts the row)
fact_difference_touch=(@s:FactState v:IndexWord):>int64=>{
    let r:IndexWord=fact_index_get(s.index[0].difference_value v)
    if r <? 0 {
        r=s.index[0].difference_record.length // FACT_RECORD
        fact_index_put(@s.index[0].difference_value v r)
        # (pushed one by one: `+=` would copy the whole record list)
        s.index[0].difference_record.push(0)
        loop _ in [0..4) {s.index[0].difference_record.push(-1)}
    }
    let count:IndexWord=r * FACT_RECORD
    s.index[0].difference_record[count]=IndexWord(s.index[0].difference_record[count]) + 1
    r
}
fact_add_difference=(@s:FactState row:FactDifference):>void=>{
    if not fact_rows_indexed(s) {
        if s.differences.length + 1 <? FACT_ROW_SCAN {
            s.differences.push(row)
            return
        }
        # (outgrown: index every row so far, then this one)
        let rows=s.differences
        s.differences=[]
        loop r in rows {fact_index_difference(@s r)}
    }
    fact_index_difference(@s row)
}
fact_index_difference=(@s:FactState row:FactDifference):>void=>{
    let i:IndexWord=s.differences.length
    fact_index_put(@s.index[0].difference_index fact_pair_key(row.a row.b) i)
    let ra:IndexWord=fact_difference_touch(@s row.a)
    let rb:IndexWord=fact_difference_touch(@s row.b)
    loop direction in [IndexWord(0)..2) {
        let r=if direction =? 0 {rb} else {ra}
        let at:IndexWord=r * FACT_RECORD + 1 + direction * 2
        let tail:IndexWord=s.index[0].difference_record[at + 1]
        if tail >=? 0 {s.index[0].difference_next[tail * 2 + direction]=i} else {s.index[0].difference_record[at]=i}
        s.index[0].difference_record[at + 1]=i
        s.index[0].difference_next.push(-1)
    }
    s.differences.push(row)
}
fact_new=(@s:FactState b:FactBound term:FactTerm=FactTerm[]):>int64=>{
    if s.ids.length >=? FACT_CAP and not s.full {fact_compact(@s)}
    if s.ids.length >=? FACT_CAP {return 0}
    let v:IndexWord=fact_terms.length
    if v >=? 0x80000000 {return 0}
    fact_terms.push(term)
    fact_add_value(@s v b)
    v
}
fact_reindex=(@s:FactState):>void=>{
    let hashed=s.index[0].slots.length not=? 0
    s.index[0].slots=[]
    if hashed {
        loop i in [0..s.ids.length) {fact_index_put(@s.index[0].slots s.ids[i] i)}
    }
    let projections=s.projections
    s.projections=[]
    s.index[0].projection_index=[]
    s.index[0].projection_head=[]
    s.index[0].projection_tail=[]
    s.index[0].projection_next=[]
    s.index[0].projection_value=[]
    loop p in projections {fact_add_projection(@s p)}
    let differences=s.differences
    s.differences=[]
    s.index[0].difference_index=[]
    s.index[0].difference_value=[]
    s.index[0].difference_record=[]
    s.index[0].difference_next=[]
    loop row in differences {fact_add_difference(@s row)}
}
fact_constant=(@s:FactState x:IndexWord at:IndexWord=0):>int64=>fact_new(@s FactBound(x x x not=? 0) FactTerm(origin=at))
fact_bind=(@s:FactState p:PlaceIdentity v:IndexWord):>void=>{
    if p.declaration =? 0 {return}
    let i:IndexWord=fact_binding(s p)
    if i >=? 0 {s.bindings[i].value=v} else if s.bindings.length <? FACT_CAP {
        fact_index_put(@s.index[0].roots fact_root_key(p) s.bindings.length)
        s.bindings.push(FactBinding(p v))
    }
}
# A replacement keeps the replaced value as the route's single tombstone.
fact_rebind=(@s:FactState p:PlaceIdentity v:IndexWord at:IndexWord prior:IndexWord):>void=>{
    fact_bind(@s p v)
    let i:IndexWord=fact_binding(s p)
    if i >=? 0 and at not=? 0 {
        s.bindings[i].event=at
        s.bindings[i].prior=prior
    }
}
fact_set_bound=(@s:FactState v:IndexWord b0:FactBound exact:bool=false):>void=>{
    let i:IndexWord=fact_slot(s v)
    if i <? 0 {return}
    let b=b0
    if b.lo >? b.hi or b.nz and b.lo =? 0 and b.hi =? 0 {s.live=false}
    # Nonzero at an interval endpoint excludes it: `n not=? 0` with `n >=? 0`
    # is `n >=? 1` (an early-returned empty length makes `xs[0]`, `xs[end]` safe).
    else if b.nz and b.lo =? 0 {b.lo=1} else if b.nz and b.hi =? 0 {b.hi=-1}
    # (an `int` narrowed onto an open MIN/MAX endpoint, `n >=? MAX`, is at
    # least MAX, not MAX itself: it stays wide unless that endpoint was real)
    if s.live and not exact and not b.wide and b.lo =? b.hi and (b.hi =? FACT_MAX or b.lo =? FACT_MIN) and fact_open_endpoint(s v b.hi =? FACT_MAX) {
        b.wide=true
        b.nz=true
    }
    s.bounds[i]=b
}

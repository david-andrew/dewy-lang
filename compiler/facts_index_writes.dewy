$runtime_checks

from p"effect_types.dewy" import (PlaceIdentity)
from p"facts.jo" import (FACT_CAP FACT_PROJECTION_SCAN FACT_RECORD FACT_ROW_SCAN FactBinding FactDifference FactProjection FactState fact_terms)
from p"facts_slice_builder.dewy" import (fact_comparison fact_root_key)
from p"facts_compare.dewy" import (fact_open_endpoint)
from p"facts_collect.dewy" import (fact_compact)
from p"facts_projection_queries.dewy" import (fact_projection_find fact_projections_indexed)
from p"facts_row_queries.dewy" import (fact_rows_indexed)
from p"facts_value_queries.dewy" import (fact_binding fact_binding_ref fact_index_get fact_index_get_raw fact_index_hash fact_slot fact_slot_ref)
from p"refinement_types.dewy" import (FACT_MAX FACT_MIN FactBound FactTerm)

IndexWord:type=int64<overflow='wrap'>

# Lightweight undo trail for zero-clone in-place rollback of diverging branches.
FactCheckpoint:type=[
    ids_len:int64
    bin_len:int64
    proj_len:int64
    diff_len:int64
    cond_len:int64
    bnd_top:int64
    bin_top:int64
    diff_top:int64
    diff_a_mask:int64
    diff_b_mask:int64
    proj_base_mask:int64
    cmp_mask:int64
    has_roots:bool
    full:bool
]
let ft_active:IndexWord=0
let ft_bnd_slot:array<int32>=[]
let ft_bnd_old:array<FactBound>=[]
let ft_bin_idx:array<int32>=[]
let ft_bin_old:array<FactBinding>=[]
let ft_diff_idx:array<int32>=[]
let ft_diff_old:array<FactDifference>=[]

ft_is_active=():>bool=>ft_active >? 0
ft_depth=():>IndexWord=>ft_active
ft_record_bound=(slot:IndexWord old:FactBound):>void=>{
    ft_bnd_slot.push(int32<overflow='wrap'>(slot))
    ft_bnd_old.push(old)
}
ft_record_bind=(idx:IndexWord old:FactBinding):>void=>{
    ft_bin_idx.push(int32<overflow='wrap'>(idx))
    ft_bin_old.push(old)
}
ft_record_diff=(idx:IndexWord old:FactDifference):>void=>{
    ft_diff_idx.push(int32<overflow='wrap'>(idx))
    ft_diff_old.push(old)
}
ft_begin=(s:FactState):>FactCheckpoint=>$unsafe {
    ft_active += 1
    FactCheckpoint(
        s.ids.length
        s.bindings.length
        s.projections.length
        s.differences.length
        s.conditional.length
        ft_bnd_slot.length
        ft_bin_idx.length
        ft_diff_idx.length
        s.diff_a_mask
        s.diff_b_mask
        s.proj_base_mask
        s.cmp_mask
        s.index.ptr[0].roots.length not=? 0
        s.full
    )
}
ft_rollback=(@s:FactState cp:FactCheckpoint):>void=>$unsafe {
    ft_active -= 1
    s.live=true
    s.full=cp.full
    s.diff_a_mask=cp.diff_a_mask
    s.diff_b_mask=cp.diff_b_mask
    s.proj_base_mask=cp.proj_base_mask
    s.cmp_mask=cp.cmp_mask
    if s.ids.length >? cp.ids_len {
        s.ids.truncate(cp.ids_len)
        s.bounds.truncate(cp.ids_len)
    }
    if s.index.ptr[0].slots.length not=? 0 {s.index[0].slots=[]}
    let bi:IndexWord=IndexWord(ft_bnd_slot.length) - 1
    loop bi >=? cp.bnd_top {
        let sl=IndexWord(ft_bnd_slot.ptr[bi])
        if sl <? cp.ids_len {s.bounds[sl]=ft_bnd_old.ptr[bi]}
        bi -= 1
    }
    if ft_bnd_slot.length >? cp.bnd_top {
        ft_bnd_slot.truncate(cp.bnd_top)
        ft_bnd_old.truncate(cp.bnd_top)
    }
    let bin_shrank=s.bindings.length >? cp.bin_len
    if bin_shrank {s.bindings.truncate(cp.bin_len)}
    if bin_shrank and s.index.ptr[0].roots.length not=? 0 {
        if cp.bin_len >=? 16 {
            let ridx=fact_index_sized(cp.bin_len * 2)
            let bp=s.bindings.ptr
            loop k in [IndexWord(0)..cp.bin_len) {fact_index_put(@ridx fact_root_key(bp[k].place) k)}
            s.index[0].roots=ridx
        } else {
            s.index[0].roots=[]
        }
    } else if not cp.has_roots and s.index.ptr[0].roots.length not=? 0 {
        s.index[0].roots=[]
    }
    let ni:IndexWord=IndexWord(ft_bin_idx.length) - 1
    loop ni >=? cp.bin_top {
        let idx=IndexWord(ft_bin_idx.ptr[ni])
        if idx <? cp.bin_len {s.bindings[idx]=ft_bin_old.ptr[ni]}
        ni -= 1
    }
    if ft_bin_idx.length >? cp.bin_top {
        ft_bin_idx.truncate(cp.bin_top)
        ft_bin_old.truncate(cp.bin_top)
    }
    if s.projections.length >? cp.proj_len {
        s.projections.truncate(cp.proj_len)
        if s.index.ptr[0].projection_next.length not=? 0 {
            let projections=s.projections
            s.projections=[]
            s.proj_base_mask=0
            s.index[0].projection_index=[]
            s.index[0].projection_head=[]
            s.index[0].projection_tail=[]
            s.index[0].projection_next=[]
            s.index[0].projection_value=[]
            loop p in projections {fact_add_projection(@s p)}
        }
    }
    if s.differences.length >? cp.diff_len {
        s.differences.truncate(cp.diff_len)
        if s.index.ptr[0].difference_next.length not=? 0 {
            let differences=s.differences
            s.differences=[]
            s.diff_a_mask=0
            s.diff_b_mask=0
            s.index[0].difference_index=[]
            s.index[0].difference_value=[]
            s.index[0].difference_record=[]
            s.index[0].difference_next=[]
            loop row in differences {fact_add_difference(@s row)}
        }
    }
    let di:IndexWord=IndexWord(ft_diff_idx.length) - 1
    loop di >=? cp.diff_top {
        let idx=IndexWord(ft_diff_idx.ptr[di])
        if idx <? cp.diff_len {s.differences[idx]=ft_diff_old.ptr[di]}
        di -= 1
    }
    if ft_diff_idx.length >? cp.diff_top {
        ft_diff_idx.truncate(cp.diff_top)
        ft_diff_old.truncate(cp.diff_top)
    }
    if s.conditional.length >? cp.cond_len {s.conditional.truncate(cp.cond_len)}
}

# (an empty index sized to take n entries without growing)
fact_index_sized=(n:IndexWord):>array<int64>=>{
    let slots:IndexWord=8
    loop slots <? n * 2 + 2 {slots*=2}
    fill(int64(0) slots * 2 + 1)
}
fact_index_grow=(@index:array<int64>):>void=>$unsafe {
    if index.length =? 0 {
        index=fill(int64(0) 17)
        return
    }
    let old=index
    let slots:IndexWord=(IndexWord(old.length) - 1) >> 1
    let nslots:IndexWord=slots * 2
    index=fill(int64(0) nslots * 2 + 1)
    let nmask:IndexWord=nslots - 1
    let np=index.ptr
    let oldp=old.ptr
    let count:IndexWord=0
    loop i in [0..slots) {
        let at:IndexWord=2 + (i << 1)
        let rv:IndexWord=oldp[at]
        if rv not=? 0 {
            let rk:IndexWord=oldp[at - 1]
            let s:IndexWord=((rk xor (rk >> 32)) * 0x9e3779b1) & nmask
            loop np[2 + (s << 1)] not=? 0 {s=(s + 1) & nmask}
            np[1 + (s << 1)]=rk
            np[2 + (s << 1)]=rv
            count += 1
        }
    }
    np[0]=count
}
fact_index_put=(@index:array<int64> key:IndexWord value:IndexWord):>void=>$unsafe {
    let n:IndexWord=index.length
    if n =? 0 or (IndexWord(index.ptr[0]) + 1) * 4 >=? n {
        fact_index_grow(@index)
        n=index.length
    }
    let mask:IndexWord=((n - 1) >> 1) - 1
    let slot:IndexWord=((key xor (key >> 32)) * 0x9e3779b1) & mask
    let rp=index.ptr
    let want:IndexWord=value + 1
    loop true {
        let i:IndexWord=1 + (slot << 1)
        let cur:IndexWord=rp[i + 1]
        if cur =? 0 {
            rp[0]=IndexWord(rp[0]) + 1
            rp[i]=key
            rp[i + 1]=want
            return
        }
        if rp[i] =? key {
            if cur not=? want {rp[i + 1]=want}
            return
        }
        slot=(slot + 1) & mask
    }
}
# Ordered records retain deterministic witnesses and budgets; hash indexes only
# locate records. Monotonically allocated values use their ordered ID vector
# as a binary-search index: O(log V) lookup, amortized O(1) append. Only a
# header mixing frames needs a hash index. Other lookups are expected O(1);
# state occupies O(V+P+D), including the copy-on-write index box.
fact_add_value=(@s:FactState v:IndexWord b:FactBound):>void=>$unsafe {
    let n:IndexWord=s.ids.length
    if v >? 0 and v <? fact_terms.length {fact_terms.ptr[v].slot=n}
    if s.index.ptr[0].slots.length =? 0 {
        if n >? 0 and v <? s.ids.ptr[n - 1] {
            let sl=fact_index_sized(n * 2)
            let idsp=s.ids.ptr
            loop i in [0..n) {fact_index_put(@sl idsp[i] i)}
            fact_index_put(@sl v n)
            s.index[0].slots=sl
        }
    } else {
        fact_index_put(@s.index[0].slots v n)
    }
    s.ids.push(v)
    s.bounds.push(b)
}
# Small projection sets keep only their ordered records. Build the indexes
# on the first insertion reaching FACT_PROJECTION_SCAN, then maintain them.
# O(P) queries while P < 32; expected O(1) indexed queries above that, with
# O(P) promotion once per growing state. No new facts or budget are introduced.
fact_add_projection=(@s:FactState p:FactProjection):>void=>{
    let existing=fact_projection_find(s p.base p.selector p.element)
    if existing >=? 0 and s.projections[existing].value =? p.value {return}
    s.proj_base_mask=IndexWord(s.proj_base_mask) | (IndexWord(1) << (IndexWord(p.base) & 63))
    if not fact_projections_indexed(s) {
        if s.projections.length + 1 <? FACT_PROJECTION_SCAN {
            s.projections.push(p)
            return
        }
        let projections=s.projections
        s.projections=[]
        let sz=projections.length * 2
        s.index[0].projection_index=fact_index_sized(sz)
        s.index[0].projection_value=fact_index_sized(sz)
        s.index[0].projection_head=fact_index_sized(projections.length)
        s.index[0].projection_tail=fact_index_sized(projections.length)
        loop projection in projections {fact_index_projection(@s projection)}
    }
    fact_index_projection(@s p)
}
fact_index_projection=(@s:FactState p:FactProjection):>void=>$unsafe {
    let i:IndexWord=s.projections.length
    let key=fact_projection_key(p.base p.selector p.element)
    if fact_index_get_raw(s.index[0].projection_index.ptr s.index[0].projection_index.length key) <? 0 {fact_index_put(@s.index[0].projection_index key i)}
    if not p.element and fact_index_get_raw(s.index[0].projection_value.ptr s.index[0].projection_value.length p.value) <? 0 {fact_index_put(@s.index[0].projection_value p.value i)}
    let tail:IndexWord=fact_index_get_raw(s.index[0].projection_tail.ptr s.index[0].projection_tail.length p.base)
    if tail >=? 0 {s.index[0].projection_next[tail]=i} else {fact_index_put(@s.index[0].projection_head p.base i)}
    fact_index_put(@s.index[0].projection_tail p.base i)
    s.index[0].projection_next.push(-1)
    s.projections.push(p)
}
# (v's row record, made on its first row; counts the row)
fact_difference_touch=(@s:FactState v:IndexWord):>int64=>$unsafe {
    let r:IndexWord=fact_index_get_raw(s.index[0].difference_value.ptr s.index[0].difference_value.length v)
    if r <? 0 {
        r=s.index[0].difference_record.length // FACT_RECORD
        fact_index_put(@s.index[0].difference_value v r)
        # (pushed one by one: `+=` would copy the whole record list)
        s.index[0].difference_record.push(0)
        loop _ in [0..4) {s.index[0].difference_record.push(-1)}
    }
    let count:IndexWord=r * FACT_RECORD
    s.index[0].difference_record[count]=IndexWord(s.index[0].difference_record[count]) + 1
    r
}
fact_add_difference=(@s:FactState row:FactDifference):>void=>{
    s.diff_a_mask=IndexWord(s.diff_a_mask) | (IndexWord(1) << (IndexWord(row.a) & 63))
    s.diff_b_mask=IndexWord(s.diff_b_mask) | (IndexWord(1) << (IndexWord(row.b) & 63))
    if not fact_rows_indexed(s) {
        if s.differences.length + 1 <? FACT_ROW_SCAN {
            s.differences.push(row)
            return
        }
        # (outgrown: index every row so far, then this one)
        let rows=s.differences
        s.differences=[]
        s.index[0].difference_index=fact_index_sized(rows.length * 2)
        s.index[0].difference_value=fact_index_sized(rows.length)
        loop r in rows {fact_index_difference(@s r)}
    }
    fact_index_difference(@s row)
}
fact_index_difference=(@s:FactState row:FactDifference):>void=>{
    let i:IndexWord=s.differences.length
    fact_index_put(@s.index[0].difference_index fact_pair_key(row.a row.b) i)
    let ra:IndexWord=fact_difference_touch(@s row.a)
    let rb:IndexWord=fact_difference_touch(@s row.b)
    loop direction in [IndexWord(0)..2) {
        let r=if direction =? 0 {rb} else {ra}
        let at:IndexWord=r * FACT_RECORD + 1 + direction * 2
        let tail:IndexWord=s.index[0].difference_record[at + 1]
        if tail >=? 0 {s.index[0].difference_next[tail * 2 + direction]=i} else {s.index[0].difference_record[at]=i}
        s.index[0].difference_record[at + 1]=i
        s.index[0].difference_next.push(-1)
    }
    s.differences.push(row)
}
fact_new=(@s:FactState b:FactBound term:FactTerm=FactTerm[]):>int64=>{
    if s.ids.length >=? FACT_CAP and not s.full {fact_compact(@s)}
    if s.ids.length >=? FACT_CAP {return 0}
    let v:IndexWord=fact_terms.length
    if v >=? 0x80000000 {return 0}
    if term.a not=? 0 and term.b not=? 0 and fact_comparison(term.op) {
        s.cmp_mask=IndexWord(s.cmp_mask) | (IndexWord(1) << (IndexWord(term.a) & 63)) | (IndexWord(1) << (IndexWord(term.b) & 63))
    }
    fact_terms.push(term)
    fact_add_value(@s v b)
    v
}
fact_reindex=(@s:FactState):>void=>{
    let hashed=s.index[0].slots.length not=? 0
    s.index[0].slots=[]
    if hashed {
        loop i in [0..s.ids.length) {fact_index_put(@s.index[0].slots s.ids[i] i)}
    }
    let projections=s.projections
    s.projections=[]
    s.proj_base_mask=0
    s.index[0].projection_index=[]
    s.index[0].projection_head=[]
    s.index[0].projection_tail=[]
    s.index[0].projection_next=[]
    s.index[0].projection_value=[]
    loop p in projections {fact_add_projection(@s p)}
    let differences=s.differences
    s.differences=[]
    s.diff_a_mask=0
    s.diff_b_mask=0
    s.index[0].difference_index=[]
    s.index[0].difference_value=[]
    s.index[0].difference_record=[]
    s.index[0].difference_next=[]
    loop row in differences {fact_add_difference(@s row)}
}
fact_constant=(@s:FactState x:IndexWord at:IndexWord=0):>int64=>fact_new(@s FactBound(x x x not=? 0) FactTerm(origin=at))
fact_bind=(@s:FactState p:PlaceIdentity v:IndexWord):>void=>$unsafe {
    if p.declaration =? 0 {return}
    let i:IndexWord=fact_binding_ref(@s p)
    if i >=? 0 {
        if ft_active >? 0 {ft_record_bind(i s.bindings.ptr[i])}
        s.bindings[i].value=v
    } else if s.bindings.length <? FACT_CAP {
        let idx:IndexWord=s.bindings.length
        if s.index.ptr[0].roots.length not=? 0 {
            fact_index_put(@s.index[0].roots fact_root_key(p) idx)
        } else if idx + 1 >=? 16 {
            let ridx=fact_index_sized((idx + 1) * 2)
            let bp=s.bindings.ptr
            loop k in [IndexWord(0)..idx) {fact_index_put(@ridx fact_root_key(bp[k].place) k)}
            fact_index_put(@ridx fact_root_key(p) idx)
            s.index[0].roots=ridx
        }
        s.bindings.push(FactBinding(p v))
    }
}
# A replacement keeps the replaced value as the route's single tombstone.
fact_rebind=(@s:FactState p:PlaceIdentity v:IndexWord at:IndexWord prior:IndexWord):>void=>$unsafe {
    if p.declaration =? 0 {return}
    let i:IndexWord=fact_binding_ref(@s p)
    if i >=? 0 {
        if ft_active >? 0 {ft_record_bind(i s.bindings.ptr[i])}
        s.bindings[i].value=v
        if at not=? 0 {
            s.bindings[i].event=at
            s.bindings[i].prior=prior
        }
    } else if s.bindings.length <? FACT_CAP {
        let idx:IndexWord=s.bindings.length
        if s.index.ptr[0].roots.length not=? 0 {
            fact_index_put(@s.index[0].roots fact_root_key(p) idx)
        } else if idx + 1 >=? 16 {
            let ridx=fact_index_sized((idx + 1) * 2)
            let bp=s.bindings.ptr
            loop k in [IndexWord(0)..idx) {fact_index_put(@ridx fact_root_key(bp[k].place) k)}
            fact_index_put(@ridx fact_root_key(p) idx)
            s.index[0].roots=ridx
        }
        if at not=? 0 {s.bindings.push(FactBinding(p v at prior))}
        else {s.bindings.push(FactBinding(p v))}
    }
}
fact_set_bound=(@s:FactState v:IndexWord b0:FactBound exact:bool=false):>void=>$unsafe {
    let i:IndexWord=fact_slot_ref(@s v)
    if i <? 0 {return}
    let b=b0
    if b.lo >? b.hi or b.nz and b.lo =? 0 and b.hi =? 0 {s.live=false}
    # Nonzero at an interval endpoint excludes it: `n not=? 0` with `n >=? 0`
    # is `n >=? 1` (an early-returned empty length makes `xs[0]`, `xs[end]` safe).
    else if b.nz and b.lo =? 0 {b.lo=1} else if b.nz and b.hi =? 0 {b.hi=-1}
    # (an `int` narrowed onto an open MIN/MAX endpoint, `n >=? MAX`, is at
    # least MAX, not MAX itself: it stays wide unless that endpoint was real)
    if s.live and not exact and not b.wide and b.lo =? b.hi and (b.hi =? FACT_MAX or b.lo =? FACT_MIN) and fact_open_endpoint(s v b.hi =? FACT_MAX) {
        b.wide=true
        b.nz=true
    }
    if s.bounds.ptr[i] =? b {return}
    if ft_active >? 0 {ft_record_bound(i s.bounds.ptr[i])}
    s.bounds[i]=b
}

from p"facts_values.dewy" import (fact_pair_key fact_projection_key)

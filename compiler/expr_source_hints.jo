regroup_op_name = (p: int) -> str:
    k = nodes[p].kind
    if k == .and_: return "and"
    if k == .or_: return "or"
    if k == .not_: return "not"
    op_text(nodes[p].op as Tok, nodes[p].pos)
# the source between two places of one file, on one line, without the blanks around it ("" if not)
regroup_source = (f: int, from0: int, to0: int) -> str:
    src = files[f].src
    from = from0
    to = to0
    loop from < to and (src[from] == ' ' or src[from] == '\t'): from += 1
    loop to > from and (src[to - 1] == ' ' or src[to - 1] == '\t'): to -= 1
    if from >= to or to > len(src) or to - from > 80: return ""
    loop i in [from..to):
        if src[i] == '\n': return ""
    src[from..to)
# whether text closes no bracket it did not open (else its operand was written inside parentheses)
regroup_balanced = (text: str) -> bool:
    depth = 0
    loop c in text:
        if c == 40 or c == 91: depth += 1
        else if c == 41 or c == 93: depth -= 1
        if depth < 0: return false
    true
# the text of the type a cast names: a name, with its type arguments
regroup_type_text = (c: int) -> str:
    t = int(nodes[c].b)
    f = pos_file(nodes[t].pos)
    src = files[f].src
    from = pos_off(nodes[t].pos)
    to = from
    depth = 0
    loop to < len(src):
        ch = src[to]
        if ch == '<': depth += 1
        else if ch == '>': depth -= 1
        else if depth == 0 and not is_ident_char(ch) and ch != '.': break
        to += 1
    if depth != 0: return ""
    src[from..to)
# An interpolation as written in a string, after its `{` (not `printl(x)`'s
# own): the source before its expression is a brace. O(spaces).
written_interpolation = (e: int) -> bool:
    f = pos_file(nodes[e].pos)
    if f < 0 or f >= files.len(): return false
    src = files[f].src
    o = pos_off(nodes[e].pos) - 1
    loop o >= 0 and (src[o] == ' ' or src[o] == '\t' or src[o] == '\n'): o -= 1
    o >= 0 and src[o] == 123
# Node n is e or inside it. Error paths only; O(nodes of e), depth 64.
node_within = (e: int, n: int, depth: int = 0) -> bool:
    if e <= 0 or depth > 64: return false
    if e == n: return true
    mask = isolation_children(nodes[e].kind)
    if mask < 0: return false
    if mask & 1 != 0 and node_within(int(nodes[e].a), n, depth + 1) or mask & 2 != 0 and node_within(int(nodes[e].b), n, depth + 1) or mask & 4 != 0 and node_within(int(nodes[e].c), n, depth + 1): return true
    if mask & 16 != 0:
        loop i in [0..nkids(e)):
            if node_within(kid(e, i), n, depth + 1): return true
    false
# Why a Dewy optional does not fit a plain type. A value optional twice
# (`xs.get(i)` of optional elements) needs a check per level, and a name
# narrowed once from one still holds an optional.
optional_hint = (n: int, from: int) -> str:
    inner = telem(prune(from))
    if tkind(inner) == .opt: return " (this value is optional twice, {dt(prune(from))}: none for a missing value, or a present value that is none itself; check it with `is? none` once for each)"
    e = n
    loop nodes[e].kind == .conv: e = int(nodes[e].a)
    root = 0
    if nodes[e].kind == .unwrap: root = int(nodes[e].a)
    else if nodes[e].kind == .ident and nodes[e].aux == i32(int(SK.local)):
        l = int(nodes[e].sym)
        if int(locals[l].flags) & LF_ALIAS != 0 and locals[l].alias != 0 and nodes[int(locals[l].alias)].kind == .unwrap: root = int(nodes[int(locals[l].alias)].a)
    if root != 0 and tkind(prune(ntype(root))) == .opt and tkind(telem(prune(ntype(root)))) == .opt:
        name = if nodes[root].kind == .ident: "`{name_of(int(nodes[root].name))}`" else: "it"
        return " ({name} was optional twice, {dt(prune(ntype(root)))}, and `is? none` ruled out only the outer none: the value present may be none itself; check it again with `is? none`)"
    " (this value may be none; check it with `is?none` before using its value)"

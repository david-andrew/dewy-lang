# Filesystem publication for the Dewy PE32+ image owner.
use 'util.jo'
use 'pe_format.dewy'

write_pe = (path: str, text: u8[], entry_off: int, ro: u8[], data_size: int, gui: bool, info: u8[], icon: u8[], pdb: str, guid: u8[]) -> bool:
    image = pe_image(text, entry_off, ro, data_size, gui, info, icon, pdb, guid)
    delete_file(path)
    if not write_bytes(path, image): return false
    chmod(path, 0x1ED)

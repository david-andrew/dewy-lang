# Dewy spellings of the foreign-function interface (docs/LANGUAGE.md, "Foreign
# functions"), lowered onto the extern machinery that `extern`, `@lib`,
# `@symbol` and `@export` in implementation-language sources already use (compiler/check.jo, lower_extern_thunk):
#   $extern
#   strlen = (s:ptr<uint8>):>uint64
#   $extern(name='Sleep' lib='kernel32')
#   sleep_ms = (ms:uint32):>void
#   $intrinsic
#   sqrt = (x:float64):>float64
#   $export            (or $export(name='c_name')) before a module function
use 'util.jo'
use 'ast.jo'
use 'check.jo'
use 'expr.jo'
use 'dewy_nodes.jo'
use 'dewy_tokens.dewy'





# `$export` / `$export(name='c_name')` before a module function: callable from C
# (with the C calling convention; its name is the symbol where the target has one).
dw_export_pos = 0
dw_export_name = ""

arm64_emit_entry=(inits:array<int64> main_lf:ArmWord main_code:bool entry_end_lf:ArmWord watch_build:bool WATCH_CODE_AT:ArmWord WATCH_CODE_SIZE:ArmWord):>ArmWord=>$unsafe {
    let start=ArmWord(a_code[0].length)
    w32(0x910003E9)
    a_adr_data(10  1  0)
    a_str(9  10  0)
    if watch_build {
        a_mov_imm(0  WATCH_CODE_AT)
        a_mov_imm(1  WATCH_CODE_SIZE)
        a_movz(2  7  0)
        a_mov_imm(3  0x104022)
        a_mov_imm(4  -1)
        a_movz(5  0  0)
        a_mov_imm(8  222)
        a_svc()
        a_mov_imm(9  WATCH_CODE_AT)
        a_cmp(0  9)
        let j=ArmWord(a_code[0].length)
        w32(0x54000000 | AC_NE)
        a_mov_imm(10  0x6A6F74776174636B)
        a_str(10  9  0)
        wr32(j  rd32(j) | ((((ArmWord(a_code[0].length) - j) // 4) & 0x7FFFF) << 5))
    }
    loop f in inits {
        a_call_fix.push([ArmWord(a_code[0].length)  f])
        a_bl()
    }
    a_movz(19  0  0)
    if main_lf >=? 0 {
        a_call_fix.push([ArmWord(a_code[0].length)  main_lf])
        a_bl()
        if main_code {
            a_mov(19  0)
        }
    }
    if entry_end_lf >=? 0 {
        a_call_fix.push([ArmWord(a_code[0].length)  entry_end_lf])
        a_bl()
    }
    a_mov(0  19)
    a_mov_imm(8  94)
    a_svc()
    start
}
arm64_emit_entry_mac=(inits:array<int64> main_lf:ArmWord main_code:bool entry_end_lf:ArmWord):>ArmWord=>$unsafe {
    let start=ArmWord(a_code[0].length)
    w32(0xA9BF7BFD)
    w32(0x910003FD)
    w32(0xA9BF53F3)
    a_sub_imm(9  1  8)
    a_adr_data(10  1  0)
    a_str(9  10  0)
    loop f in inits {
        a_call_fix.push([ArmWord(a_code[0].length)  f])
        a_bl()
    }
    a_movz(19  0  0)
    if main_lf >=? 0 {
        a_call_fix.push([ArmWord(a_code[0].length)  main_lf])
        a_bl()
        if main_code {
            a_mov(19  0)
        }
    }
    if entry_end_lf >=? 0 {
        a_call_fix.push([ArmWord(a_code[0].length)  entry_end_lf])
        a_bl()
    }
    a_mov(0  19)
    w32(0xA8C153F3)
    w32(0xA8C17BFD)
    a_ret()
    start
}
arm64_patch_module=(text_addr:ArmWord ro_addr:ArmWord data_addr:ArmWord @fn_addr:array<int64> @stub_addr:array<int64>):>ArmWord=>$unsafe {
    let targets=fn_addr.ptr as ptr<ArmWord>
    let stubs=stub_addr.ptr as ptr<ArmWord>
    let fixes0=a_call_fix.ptr as ptr<[ArmWord ArmWord]>
    loop i in [ArmWord(0)..ArmWord(a_call_fix.length)) {
        let f=fixes0[i]
        let t:ArmWord=targets[f[1]]
        if t <? 0 {
            return f[1]
        }
        wr32(f[0]  rd32(f[0]) | (((t - ArmWord(f[0])) // 4) & 0x3FFFFFF))
    }
    let fixes1=a_stub_fix.ptr as ptr<[ArmWord ArmWord]>
    loop i in [ArmWord(0)..ArmWord(a_stub_fix.length)) {
        let f=fixes1[i]
        let t:ArmWord=stubs[f[1]]
        wr32(f[0]  rd32(f[0]) | (((t - ArmWord(f[0])) // 4) & 0x3FFFFFF))
    }
    let fixes2=a_faddr_fix.ptr as ptr<[ArmWord ArmWord]>
    loop i in [ArmWord(0)..ArmWord(a_faddr_fix.length)) {
        let f=fixes2[i]
        let t:ArmWord=targets[f[1]]
        if t <? 0 {
            return f[1]
        }
        a_patch_adrp(f[0]  text_addr  text_addr + t)
    }
    let fixes3=a_data_fix.ptr as ptr<[ArmWord ArmWord ArmWord]>
    loop i in [ArmWord(0)..ArmWord(a_data_fix.length)) {
        let f=fixes3[i]
        let base=ro_addr
        if f[1] =? 1 {
            base = data_addr
        }
        a_patch_adrp(f[0]  text_addr  base + ArmWord(f[2]))
    }
    -1
}

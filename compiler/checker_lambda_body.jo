use 'check.jo'
use 'ast.jo'
use 'ast_rest.dewy'
use 'checker_expr.dewy'
use 'checker_sinks.dewy'
use 'checker_state.dewy'
use 'checks_assign_hooks.dewy'
use 'checks_stmt_hooks.dewy'
use 'checks_thin.dewy'
use 'diagnostic_exit.dewy'
use 'errors.jo'
use 'expr.jo'
use 'refine.jo'
use 'refine_metadata.dewy'
use 'refine_rare.dewy'
use 'type_ops.dewy'
use 'types.jo'

check_lambda_body = (f: int, lam: int, ret_hint: int):
    fns[f].state = 1
    parent = cx
    ctxs.push(FnCtx(i32(f), i32(parent), 0, false, 0, ctxs[parent].mod, ctxs[parent].floor))
    cx = ctxs.len() - 1
    mark = scope_mark()
    if has_flag(lam, NF_GENERIC): push_type_params(lam, fns[f].targs)
    loop original in lambda_captures(lam):
        cap = if has_flag(lam, NF_GENERIC): clone(original) else: original
        nm = int(nodes[cap].name)
        s = lookup(nm)
        # Folded lexical constants need no environment slot, but they are
        # still valid explicit captures. Keep the capture declaration intact.
        if s != 0 and syms[s].kind == .const_ and nm < check_scopes.top.len() and check_scopes.top[nm] >= int(ctxs[cx].floor) and check_scopes.syms[check_scopes.top[nm]] == s:
            check_expr(clone(cap), 0)
            continue
        capture_decl = cap
        check_expr(cap, 0)
        capture_decl = 0
        local = 0
        if nodes[cap].kind == .ident and nodes[cap].aux == i32(int(SK.local)):
            local = int(nodes[cap].sym)
            loop narrowed_var(local) != 0: local = narrowed_var(local)
        if local == 0 or int(locals[local].flags) & LF_CAPTURE == 0:
            fatal(nodes[cap].pos, "a capture must name an enclosing local variable")
    loop i in [0..fns[f].ptypes.len()):
        p = kid(lam, i)
        l = new_local(int(nodes[p].name), fns[f].ptypes[i], nodes[p].pos)
        fl = LF_PARAM
        if has_flag(p, NF_MUT): fl |= LF_MUTPARAM
        locals[l].flags = i32(fl)
        fns[f].params.push(l)
    declared = 0
    spawned_hint = 0
    old_formals = refine_bindings.formals
    old_self = refine_bindings.self
    if refine_active:
        refine_bindings.formals = []
        refine_bindings.self = 0
        loop p in kids(lam): refine_bindings.formals.push(int(nodes[p].name))
    if nodes[lam].a != 0:
        declared = resolve_result_type(int(nodes[lam].a))
        pack_written(f, int(nodes[lam].a))
    else if has_flag(lam, NF_VOID): declared = T_VOID
    refine_bindings.formals = old_formals
    refine_bindings.self = old_self
    if refine_active: ref_validate_signature(fns[f].ptypes, declared, ref_decl_mask(lam), nodes[lam].pos)
    if declared != 0: ctxs[cx].ret = i32(declared)
    else if ret_hint != 0 and not has_var(prune(ret_hint)): ctxs[cx].ret = i32(ret_hint)
    else:
        # (a `spawn` body infers what it throws, as a function with no declared result does;
        # its result, with them, then settles what the call wants)
        if nodes[lam].aux2 == 17 and dewy_at(nodes[lam].pos):
            spawned_hint = ret_hint
            ctxs[cx].ret = i32(mk_var())
            infer_throws[f] = []
            infer_returns[f] = []
        else if ret_hint != 0: ctxs[cx].ret = i32(ret_hint)
        else: ctxs[cx].ret = i32(mk_var())
        ctxs[cx].infer_ret = true
    body = int(fns[f].body)
    infer = ctxs[cx].infer_ret
    want = infer or tkind(int(ctxs[cx].ret)) != .void_
    exp = 0
    if not infer: exp = int(ctxs[cx].ret)
    if want and nkids(body) > 0 and nodes[kid(body, nkids(body) - 1)].kind == .exprstmt: returned_place(int(nodes[kid(body, nkids(body) - 1)].a))
    saved_sink = sink_fn
    sink_body_mode = sink_body_kind(body, infer and types[prune(int(ctxs[cx].ret))].kind == .var, want, int(ctxs[cx].ret), not infer and sink_written(lam))
    if fns[f].pack_n > 0: exp = sink_pack_body(f)
    else if sink_lambda_pack != 0:
        # (as the type says: `(int64 int64)`, that many values, as a written result; an array's
        # element, any number of them, pushed)
        sink_body_mode = SINK_BODY
        lp = prune(sink_lambda_pack)
        if is_values(lp):
            sink_want_n = int(types[lp].nargs)
            sink_want_elem = targ(lp, 0)
        else:
            sink_want_elem = int(types[lp].elem)
            sink_no_tuple = true
        exp = 0
    sink_lambda_pack = 0
    # (a parallel or spawn body the compiler made keeps its values as the array it collects)
    if has_flag(lam, NF_LANG_BODY) and sink_body_mode == SINK_BODY: sink_no_tuple = true
    sink_fn = sinks.len()
    bt = check_block(body, exp, want)
    sink_fn = saved_sink
    r = prune(int(ctxs[cx].ret))
    if infer:
        if types[r].kind == .var:
            if nodes[body].aux != 0:
                v = block_value(body)
                if has_flag(v, NF_LITERAL):
                    bt = lit_default(v)
                    set_block_value(body, coerce(v, bt))
                if not unify(r, bt): fatal(nodes[body].pos, "lambda returns {dt(bt)}, expected {dt(r)}")
            else: unify(r, T_VOID)
        else if types[r].kind == .void_: nodes[body].aux = 0
        else if nodes[body].aux != 0: set_block_value(body, coerce(block_value(body), r))
        else if bt != T_NEVER and not void_arm_end(body, r): fatal(nodes[body].pos, "lambda must return a value of type {dt(r)}")
    else if want:
        if nodes[body].aux != 0: set_block_value(body, coerce(block_value(body), r))
        else if bt != T_NEVER and not void_arm_end(body, r): fatal(nodes[body].pos, "lambda must return a value of type {dt(r)}")
    else: nodes[body].aux = 0
    body_result_throws(f, body)
    if spawned_hint != 0: unify(spawned_hint, int(ctxs[cx].ret))
    fns[f].ret = ctxs[cx].ret
    fns[f].state = 2
    scope_reset(mark)
    ctxs.pop()
    cx = parent

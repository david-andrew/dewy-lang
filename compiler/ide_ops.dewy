$runtime_checks

from p"@lib/core/str.jo" import (ends_with)
from p"ast.jo" import (kid nkids nodes)
from p"check.jo" import (LF_CONST LF_PARAM fns locals)
from p"ide.jo" import (IK_BUILTIN IK_CONST IK_FIELD IK_FN IK_LOCAL IK_PARAM decl_done ide_doc ide_lines ide_on)
from p"ide_index.dewy" import (ide_esc ide_ref)
from p"lex.jo" import (is_ident_char)
from p"module_paths.dewy" import (path_norm)
from p"type_ops.dewy" import (type_str zonk)
from p"util.jo" import (files name_of pos_file pos_off)

IdeWord:type=int64<overflow='wrap'>
ide_emit=(line:string):>void=>{
    ide_lines.push(line)
}
ide_is_name_byte=(c:uint8):>bool=>{
    is_ident_char(c)
}
ide_local_kind=(l:IdeWord):>int64=>$unsafe {
    if IdeWord(locals.ptr[l].flags) & LF_CONST not=? 0 {return IK_CONST}
    if IdeWord(locals.ptr[l].flags) & LF_PARAM not=? 0 {return IK_PARAM}
    IK_LOCAL
}
ide_fn_ref=(p:IdeWord name:IdeWord f:IdeWord):>void=>$unsafe {
    if not ide_on or f <=? 0 or fns.ptr[f].decl =? 0 {return}
    ide_ref(p name IK_FN nodes.ptr[IdeWord(fns.ptr[f].decl)].pos 0 f)
}
# field i of struct (or variant) declaration d
ide_field_ref=(p:IdeWord name:IdeWord d:IdeWord i:IdeWord field_type:IdeWord):>void=>$unsafe {
    if not ide_on or d =? 0 or i <? 0 or i >=? nkids(d) {return}
    ide_ref(p name IK_FIELD nodes.ptr[kid(d i)].pos field_type 0)
}
# a call of a builtin function (call node n)
ide_builtin_ref=(n:IdeWord name:IdeWord):>void=>$unsafe {
    if nodes.ptr[n].a not=? 0 {ide_ref(nodes.ptr[IdeWord(nodes.ptr[n].a)].pos name IK_BUILTIN 0 0 0)}
}
# Display types for the edited language, including imported implementation declarations.
ide_type_str=(t:IdeWord):>string=>{
    type_str(t ends_with(ide_doc ".dewy"))
}
ide_type_info=(t:IdeWord):>string=>{
    if t =? 0 {return ""}
    ide_type_str(zonk(t))
}
ide_pos_str=(p:IdeWord):>string=>{
    "{pos_file(p)}:{pos_off(p)}"
}
ide_decl=(p:IdeWord name:IdeWord kind:IdeWord snippet:string doc:string):>void=>{
    if p <? 0 or decl_done.get(p) not=? none {return}
    decl_done[p]=true
    ide_emit("D\t{ide_pos_str(p)}\t{(name_of(name) as array<uint8>).length}\t{kind}\t{ide_esc(name_of(name))}\t{ide_esc(snippet)}\t{ide_esc(doc)}")
}
ide_self_ref=(p:IdeWord nm:IdeWord info:string):>void=>{
    if p <? 0 {return}
    ide_emit("R\t{ide_pos_str(p)}\t{(name_of(nm) as array<uint8>).length}\t{ide_pos_str(p)}\t{ide_esc(info)}")
}
ide_find_file=(path:string):>int64=>{
    loop i in 0.. and f in files {
        if path_norm(f.path) =? path {return i}
    }
    -1
}
ide_warn=(p:IdeWord msg:string):>void=>{
    ide_emit("W\t{ide_pos_str(p)}\t{ide_esc(msg)}")
}

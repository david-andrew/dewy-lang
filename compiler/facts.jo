        if not rhs.live: result = FactBound(int(not take), int(not take), not take)
        else if not s.live: result = fact_bound(rhs, b)
        else if fact_truth(rhs, b) == int(not take): result = FactBound(int(not take), int(not take), not take)
        s = fact_join(s, rhs, n)
        return fact_new(s, result, FactTerm((if take: Tok.kw_and else: Tok.kw_or), a, b))
    if (k == .while_ or k == .for_) and fact_loops.len() == 0 and fact_speculating == 0:
        fact_loop_steps = 0; fact_loop_exhausted = false
    if k == .while_ and nodes[n].aux == 0:
        fact_while(n, s)
        return 0
    if k == .for_ and nodes[n].aux == 0 and not has_flag(int(nodes[n].a), NF_STEP):
        fact_range(n, s)
        return 0
    if k == .for_ and nodes[n].aux == 0 and nodes[int(nodes[n].a)].kind == .range and nodes[int(nodes[n].a)].c != 0:
        fact_stepped(n, s)
        return 0
    if k == .while_ or k == .for_:
        # An indexed array loop evaluates its source once, before the loop.
        base = 0
        # (`loop @x in xs`, aux 2, cannot resize or replace xs: its length is read once too)
        indexed = k == .for_ and (nodes[n].aux == 1 or nodes[n].aux == 2) and nodes[n].c != 0 and files[pos_file(nodes[n].pos)].is_dewy
        mapped = k == .for_ and nodes[n].aux == 3 and is_map_entries_type(fact_type(ntype(int(nodes[n].a))))
        if indexed or mapped: base = fact_capture(int(nodes[n].a), s)
        if indexed and fact_comprehensions.has(n): fact_comprehension_sources[n] = base
        pushes: (int, int)[]
        growers: (int, int)[]
        sums: (int, FactBound)[]
        scaled: (int, int, int)[]
        if indexed:
            pushes = fact_counted_pushes(n, s)
            growers = fact_growing_pushes(n, s, pushes)
            scaled = fact_scaled_pushes(n, s)
            # (one iteration per element of the evaluated source; every
            # length is within the enabled address-space ceiling)

# Sparse panic sites collected only by a complete obligation-free body walk.
fact_panic_sites: {int: int[]} = {}
fact_panic_collect = false
fact_panic_pending: int[]
use 'ide.jo'
fact_has_deferred = false
fact_deferred: {int: bool} = {}
fact_deferred_checks: {int: int[]} = {}
fact_deferred_proving = false
use 'exact.jo'
use 'math_lower.jo'
# Finite value facts and the cheap lowering domain. Places name storage;
# values name immutable evaluations. Isolation alone never establishes purity.
use 'ast.jo'
use 'icount.jo'
use 'lex.jo'
use 'types.jo'
use 'util.jo'
use 'expr.jo'
use 'lower.jo'
use 'check.jo'
use 'comptime.jo'
use 'isolation.jo'
use 'refine.jo'
use 'proofs.jo'
use 'places.jo'
use 'effects.jo'
use 'ownership.jo'
use 'witness.jo'
use 'directives.jo'
use 'warn_if.jo'
use 'string_domains.jo'

enum FactPolicy: RuntimeAllowed, RequireStatic
enum FactReason: missing, write, call, join, loop_, unsupported, budget, callee

struct FactBound:
    lo: int = -9223372036854775807 - 1
    hi: int = 9223372036854775807
    nz: bool = false
    reason: FactReason = .missing
    witness: int = 0
    wide: bool = false  # unknown mathematical extent beyond the endpoint representation

struct FactTerm:
    op: Tok = .eof
    a: int = 0
    b: int = 0
    origin: int = 0
    type: int = 0
    slot: int = -1

# One tombstone per invalidated route: the event that last replaced the
# place and the value it replaced. Witnesses only; never evidence.
struct FactBinding:
    place: PlaceIdentity
    value: int
    event: int = 0
    prior: int = 0

struct FactProjection:
    base: int
    selector: int
    element: bool
    value: int

# Sparse mathematical difference constraints: a - b <= limit. Endpoints are
# immutable evaluations, so writes retire routes without rewriting old facts.
struct FactDifference:
    a: int
    b: int
    limit: int
    at: int = 0

struct FactIndexes:
    slots: int[]
    roots: int[]
    projection_index: int[]
    projection_head: int[]
    projection_tail: int[]
    projection_value: int[]
    projection_next: int[]
    difference_index: int[]
    # (one record per value a row touches: incident rows, then the head and
    # tail of its row chains by b (direction 0) and by a (direction 1))
    difference_value: int[]
    difference_record: int[]
    difference_next: int[]

fact_empty_index = [FactIndexes()]

struct FactState:
    index: FactIndexes[] = fact_empty_index
    conditional: ResultEvidence[]
    differences: FactDifference[]
    projections: FactProjection[]
    bindings: FactBinding[]
    ids: int[]
    bounds: FactBound[]
    live: bool = true
    full: bool = false

struct FactRequest:
    node: int
    owner: int

struct FactLoop:
    back: FactState = FactState(live = false)
    exits: FactState = FactState(live = false)

struct FactLoan:
    place: PlaceIdentity
    capacity: int
struct FactSliceEdges:
    heads: int[]
    nodes: int[]
    next: int[]

# A slice's nodes, node -> FACT_MEMBER | FACT_VALUE | FACT_ACTIVE: a dense
# array from node `base` when its nodes lie close together (a body's usually
# do), else an open-address index (base -1).
const FACT_MEMBER = 1
const FACT_VALUE = 2
const FACT_ACTIVE = 4
const FACT_CONTRACT = 8
struct FactSlice:
    flags: int[]
    # (a probe also reads floor calls the facts pass's slice leaves out)
    probe_only: bool = false
    base: int = -1

fact_slice_flags = (n: int) -> int:
    if fact_slice.base < 0: return max(0, fact_index_get(fact_slice.flags, n))
    i = n - fact_slice.base
    if i < 0 or i >= fact_slice.flags.len(): return 0
    fact_slice.flags[i]

fact_slice = FactSlice()
fact_slice_cache: {int: FactSlice} = {}

fact_loans: FactLoan[]

fact_returns_cache: {int: bool} = {}

fact_loops: FactLoop[]
fact_speculating = 0
fact_pending_defers = 0
fact_loop_steps = 0
fact_loop_exhausted = false

fact_divisors: {int: int} = {}
fact_requests: FactRequest[]
fact_terms: FactTerm[]

# A fork's closure (the function argument of `parallel_range`/`parallel_map`,
# which call it before they return) starts from what its creator knew of its
# snapshot captures and of the lengths of the arrays it borrows by partition
# (which nobody resizes during the fork): intervals and rows among them.
struct FactForkEntry:
    inner: int[]
    length: bool[]
    bounds: FactBound[]
    rows: FactDifference[]
fact_fork_nodes: {int: bool} = {}
fact_decided: {int: bool} = {}
fact_policy_default = false    # RequireStatic is the no-traps default, not a harness's
fact_fork_entries: {int: FactForkEntry} = {}
fact_parallel_bounds: {int: FactBound} = {}
fact_validated: {int: bool} = {}
fact_owner = 0
fact_query = false
fact_policy = FactPolicy.RuntimeAllowed
const FACT_CAP = 256
const FACT_STEPS = 4096
const FACT_MIN = -9223372036854775807 - 1
const FACT_MAX = 9223372036854775807
# Projection selector of an integer's nonnegative part, max(0, n): the length
# `fill(x n)` gets, shared by every fill of the same count.
const FACT_CLAMPED = -7
const FACT_ELEMENT_LENGTH = -16

# A runtime-child walk, never into nested function bodies. Closed calls
# keep comptime's existing semantics; an open operand must NEVER reach ct_run.
fact_open = (e: int) -> bool:
    todo = [e]
    loop todo.len() > 0:
        n = todo.pop()
        if n == 0: continue
        if nodes[n].kind == .ident:
            kind = nodes[n].aux as SK
            if kind == .local or kind == .global:
                if binding_const_init(kind, int(nodes[n].sym), nodes[n].pos) == 0: return true
        mask = isolation_children(nodes[n].kind)
        if mask < 0: return true
        if mask & 1 != 0: todo.push(int(nodes[n].a))
        if mask & 2 != 0: todo.push(int(nodes[n].b))
        if mask & 4 != 0: todo.push(int(nodes[n].c))
        if mask & 16 != 0:
            loop c in kids(n): todo.push(c)
    false

# Length facts and callee summaries can cross lexical scopes. When any scope
# opts out, their shared domain uses only the signed storage limit; an assumed
# ceiling must not reach that scope through an alias, summary or capture.
# Node-local lowering still applies the enabled axiom at its exact use site.
# This conservative O(1) choice needs no provenance pass or global body walk.
fact_length_max = () -> int:
    if dir_assumed_bounds_any: return FACT_MAX
    if ptr_size == 4: return 4294967295
    (1 << 56) - 1

fact_scalar = (t0: int) -> bool:
    t = fact_type(t0)
    types[t].kind == .bool_ or types[t].kind == .int_

fact_comparison = (op: Tok) -> bool:
    op == .eq or op == .ne or op == .lt or op == .le or op == .gt or op == .ge

# The erased subset has no calls (including overloaded operators), projections,
# raw access or implicit helpers. Nonlinear arithmetic is pure but unsupported.
fact_pure = (e: int, budget: mut int) -> int:
    if e == 0: return 0
    budget -= 1
    if budget < 0: return e
    k = nodes[e].kind
    if k == .int_lit or k == .bool_lit: return 0
    if k == .str_lit and nodes[e].aux == 0: return 0
    if k == .ident:
        if nodes[e].aux == i32(int(SK.local)) or nodes[e].aux == i32(int(SK.global)): return 0
    if k == .index and nodes[e].b != 0 and (tkind(ntype(int(nodes[e].a))) == .array or tkind(ntype(int(nodes[e].a))) == .fixed):
        a = fact_pure(int(nodes[e].a), budget)
        if a != 0: return a
        return fact_pure(int(nodes[e].b), budget)
    if k == .field and (nodes[e].aux >= 0 and tkind(ntype(int(nodes[e].a))) == .struct_ or nodes[e].aux == -2 and tkind(ntype(int(nodes[e].a))) == .tuple):
        return fact_pure(int(nodes[e].a), budget)
    if k == .intrinsic and nodes[e].aux == i32(int(IN.len)):
        return fact_pure(kid(e, 0), budget)
    if k == .not_ or k == .unary or k == .conv:
        if not fact_scalar(ntype(e)) or not fact_scalar(ntype(int(nodes[e].a))): return e
        if k == .conv and nodes[e].aux != i32(int(CV.int_)) and nodes[e].aux != i32(int(CV.none_)): return e
        return fact_pure(int(nodes[e].a), budget)
    if k == .and_ or k == .or_ or k == .binary and nodes[e].aux == 0:
        if not fact_scalar(ntype(int(nodes[e].a))) or not fact_scalar(ntype(int(nodes[e].b))): return e
        a = fact_pure(int(nodes[e].a), budget)
        if a != 0: return a
        return fact_pure(int(nodes[e].b), budget)
    e

fact_queue = (n: int, cond: int, message: int):
    if message != 0 and (nodes[message].kind != .str_lit or nodes[message].aux != 0):
        fatal(nodes[message].pos, "cannot prove assertion: unsupported symbolic message; erased operands must be pure scalar fact terms")
    # Keep settled narrowing tests, but never erase an effectful tested value.
    if nodes[cond].kind == .istype and nodes[cond].aux == -3:
        value = int(nodes[cond].a)
        loop nodes[value].kind == .narrow: value = int(nodes[value].a)
        if nodes[value].kind == .ident:
            set_list(n, [])
            return
    if proof_active and cx >= 0 and proof_decls.has(int(fns[int(ctxs[cx].inst)].decl)):
        proof_term(cond)
        fact_requests.push(FactRequest(n, int(ctxs[cx].inst)))
        return
    if not fact_open(cond):
        # Even `effect() or true` must pass through comptime's effect checks.
        budget = 128
        if fact_pure(cond, budget) == 0: prove_assertion(cond, message)
        else if ct_values[ct_run(cond)].i == 0: assertion_refuted(cond, message)
        set_list(n, [])
        return
    budget = 128
    bad = fact_pure(cond, budget)
    if budget < 0: fact_unknown(cond, FactBound(reason = .budget, witness = bad))
    if bad != 0:
        if bad != cond: wit_note(nodes[bad].pos, "this operand is outside the fact language")
        wit_help("")
        fatal(nodes[cond].pos, "cannot prove assertion: unsupported symbolic operand; erased operands must be pure scalar fact terms")
    owner = if cx >= 0: int(ctxs[cx].inst) else: 0
    fact_requests.push(FactRequest(n, owner))

# Policies share the same numeric domain and unsigned endpoint encoding.
fact_type = (t0: int) -> int:
    t = exact_representation(t0)
    if is_int(t) and types[t].bits == 64 and not types[t].sign: return T_U64
    t

fact_domain = (t0: int, reason: FactReason = .missing, at: int = 0) -> FactBound:
    t = fact_type(t0)
    r = FactBound(reason = reason, witness = at)
    if types[t].kind == .bool_: r.lo = 0; r.hi = 1
    else if types[t].kind == .int_ and types[t].bits < 64:
        bits = int(types[t].bits)
        r.lo = if types[t].sign: -(1 << (bits - 1)) else: 0
        r.hi = if types[t].sign: (1 << (bits - 1)) - 1 else: (1 << bits) - 1
    r

fact_slot = (s: FactState, v: int) -> int:
    # A value's latest insertion is a hint, never cross-branch evidence.
    # Validate against this frame before falling back to its own index.
    if v > 0 and v < fact_terms.len():
        hint = fact_terms[v].slot
        if hint >= 0 and hint < s.ids.len() and s.ids[hint] == v: return hint
    # (a hashed index may be shared with a longer ancestor: an entry counts
    # only when it still names v's position)
    if s.index[0].slots.len() != 0:
        i = fact_index_get(s.index[0].slots, v)
        if i >= 0 and i < s.ids.len() and s.ids[i] == v: return i
        return -1
    if s.ids.len() == 0 or v < s.ids[0] or v > s.ids[s.ids.len() - 1]: return -1
    lo = 0; hi = s.ids.len()
    loop lo < hi:
        mid = (lo + hi) / 2
        if s.ids[mid] < v: lo = mid + 1
        else: hi = mid
    if lo < s.ids.len() and s.ids[lo] == v: return lo
    -1

fact_bound = (s: FactState, v: int) -> FactBound:
    i = fact_slot(s, v)
    if i < 0: return FactBound(reason = .budget, wide = true)
    s.bounds[i]

fact_new = (s: mut FactState, b: FactBound, term: FactTerm = FactTerm()) -> int:
    if s.ids.len() >= FACT_CAP and not s.full: fact_compact(s)
    if s.ids.len() >= FACT_CAP: return 0
    v = fact_terms.len()
    if v >= 0x80000000: return 0
    fact_terms.push(term)
    fact_add_value(s, v, b)
    v

# A compact open-address index: (key, record+1) pairs after an entry count.
# Empty slots have record=0, so all signed keys are usable. Doubling at half
# occupancy gives amortized O(1) insertion and expected O(1) lookup. These
# arrays copy with the fact state; there is no mutable cross-branch cache.
fact_index_hash = (key: int, mask: int) -> int:
    ((key xor (key >> 32)) * 0x9e3779b1) & mask

fact_index_get = (index: int[], key: int) -> int:
    if index.len() == 0: return -1
    mask = (index.len() - 1) / 2 - 1
    slot = fact_index_hash(key, mask)
    loop true:
        i = 1 + slot * 2
        if index[i + 1] == 0: return -1
        if index[i] == key: return index[i + 1] - 1
        slot = (slot + 1) & mask
    -1

# (an empty index sized to take n entries without growing)
fact_index_sized = (n: int) -> int[]:
    slots = 8
    loop slots < n * 2 + 2: slots *= 2
    fill(0, slots * 2 + 1)

fact_index_put = (index: mut int[], key: int, value: int):
    if index.len() == 0: index = fill(0, 17)
    if (index[0] + 1) * 4 >= index.len():
        old = index
        index = fill(0, (old.len() - 1) * 2 + 1)
        loop i in [0..(old.len() - 1) / 2):
            if old[2 + i * 2] != 0: fact_index_put(index, old[1 + i * 2], old[2 + i * 2] - 1)
    mask = (index.len() - 1) / 2 - 1
    slot = fact_index_hash(key, mask)
    loop true:
        i = 1 + slot * 2
        if index[i + 1] == 0:
            index[0] += 1
            index[i] = key
            index[i + 1] = value + 1
            return
        if index[i] == key:
            index[i + 1] = value + 1
            return
        slot = (slot + 1) & mask

fact_root_key = (p: PlaceIdentity) -> int: (p.declaration << 3) | int(p.root)
fact_pair_key = (a: int, b: int) -> int: (a << 32) | b
fact_projection_key = (base: int, selector: int, element: bool) -> int:
    (base << 33) | (int(element) << 32) | (selector & 0xffffffff)

# Ordered records retain deterministic witnesses and budgets; hash indexes only
# locate records. Monotonically allocated values use their ordered ID vector
# as a binary-search index: O(log V) lookup, amortized O(1) append. Only a
# header mixing frames needs a hash index. Other lookups are expected O(1);
# state occupies O(V+P+D), including the copy-on-write index box.
fact_add_value = (s: mut FactState, v: int, b: FactBound):
    if v > 0 and v < fact_terms.len(): fact_terms[v].slot = s.ids.len()
    if s.index[0].slots.len() == 0 and s.ids.len() > 0 and v < s.ids[s.ids.len() - 1]:
        s.index[0].slots = fact_index_sized(s.ids.len() * 2)
        loop i in [0..s.ids.len()): fact_index_put(s.index[0].slots, s.ids[i], i)
    if s.index[0].slots.len() != 0: fact_index_put(s.index[0].slots, v, s.ids.len())
    s.ids.push(v)
    s.bounds.push(b)

fact_add_projection = (s: mut FactState, p: FactProjection):
    i = s.projections.len()
    key = fact_projection_key(p.base, p.selector, p.element)
    existing = fact_index_get(s.index[0].projection_index, key)
    if existing >= 0 and s.projections[existing].value == p.value: return
    if existing < 0: fact_index_put(s.index[0].projection_index, key, i)
    if not p.element and fact_index_get(s.index[0].projection_value, p.value) < 0: fact_index_put(s.index[0].projection_value, p.value, i)
    tail = fact_index_get(s.index[0].projection_tail, p.base)
    if tail >= 0: s.index[0].projection_next[tail] = i
    else: fact_index_put(s.index[0].projection_head, p.base, i)
    fact_index_put(s.index[0].projection_tail, p.base, i)
    s.index[0].projection_next.push(-1)
    s.projections.push(p)

const FACT_RECORD = 5

# (v's row record, made on its first row; counts the row)
fact_difference_touch = (s: mut FactState, v: int) -> int:
    r = fact_index_get(s.index[0].difference_value, v)
    if r < 0:
        r = s.index[0].difference_record.len() / FACT_RECORD
        fact_index_put(s.index[0].difference_value, v, r)
        # (pushed one by one: `+=` would copy the whole record list)
        s.index[0].difference_record.push(0)
        loop _ in [0..4): s.index[0].difference_record.push(-1)
    s.index[0].difference_record[r * FACT_RECORD] += 1
    r

# A state's rows are indexed only once there are FACT_ROW_SCAN of them.
# Fewer rows (nearly every state) are scanned in order instead: the same rows
# in the same order as the index's chains give, with no index to build when a
# join or a loop header assembles a state, or to copy when a branch changes
# one. A scan is O(rows), as the distance budget already charges a source.
const FACT_ROW_SCAN = 32

fact_rows_indexed = (s: FactState) -> bool: s.index[0].difference_next.len() != 0

# The row a - b <= limit's position, or -1.
fact_row_find = (s: FactState, a: int, b: int) -> int:
    if fact_rows_indexed(s): return fact_index_get(s.index[0].difference_index, fact_pair_key(a, b))
    i = s.differences.len() - 1
    loop i >= 0:
        if s.differences[i].a == a and s.differences[i].b == b: return i
        i -= 1
    -1

# Rows touching v, or -1 when none does.
fact_incident = (s: FactState, v: int) -> int:
    if not fact_rows_indexed(s):
        count = 0
        loop row in s.differences: count += int(row.a == v) + int(row.b == v)
        return if count == 0: -1 else: count
    r = fact_index_get(s.index[0].difference_value, v)
    if r < 0: return -1
    s.index[0].difference_record[r * FACT_RECORD]

# The first row from v (direction 0: rows by b; 1: rows by a), or -1.
fact_difference_head = (s: FactState, v: int, direction: int) -> int:
    if not fact_rows_indexed(s): return fact_row_scan(s, v, direction, 0)
    r = fact_index_get(s.index[0].difference_value, v)
    if r < 0: return -1
    s.index[0].difference_record[r * FACT_RECORD + 1 + direction * 2]

# The row after ri from the same value in the same direction, or -1.
fact_difference_next = (s: FactState, ri: int, direction: int) -> int:
    if fact_rows_indexed(s): return s.index[0].difference_next[ri * 2 + direction]
    row = s.differences[ri]
    v = row.a
    if direction == 0: v = row.b
    fact_row_scan(s, v, direction, ri + 1)

fact_row_scan = (s: FactState, v: int, direction: int, from: int) -> int:
    loop i in [from..s.differences.len()):
        row = s.differences[i]
        if direction == 0 and row.b == v or direction == 1 and row.a == v: return i
    -1

fact_add_difference = (s: mut FactState, row: FactDifference):
    if not fact_rows_indexed(s):
        if s.differences.len() + 1 < FACT_ROW_SCAN:
            s.differences.push(row)
            return
        # (outgrown: index every row so far, then this one)
        rows = s.differences
        s.differences = []
        loop r in rows: fact_index_difference(s, r)
    fact_index_difference(s, row)

fact_index_difference = (s: mut FactState, row: FactDifference):
    i = s.differences.len()
    fact_index_put(s.index[0].difference_index, fact_pair_key(row.a, row.b), i)
    ra = fact_difference_touch(s, row.a)
    rb = fact_difference_touch(s, row.b)
    loop direction in [0..2):
        r = if direction == 0: rb else: ra
        at = r * FACT_RECORD + 1 + direction * 2
        tail = s.index[0].difference_record[at + 1]
        if tail >= 0: s.index[0].difference_next[tail * 2 + direction] = i
        else: s.index[0].difference_record[at] = i
        s.index[0].difference_record[at + 1] = i
        s.index[0].difference_next.push(-1)
    s.differences.push(row)

fact_reindex = (s: mut FactState):
    hashed = s.index[0].slots.len() != 0
    s.index[0].slots = []
    if hashed:
        loop i in [0..s.ids.len()): fact_index_put(s.index[0].slots, s.ids[i], i)
    projections = s.projections
    s.projections = []; s.index[0].projection_index = []; s.index[0].projection_head = []; s.index[0].projection_tail = []; s.index[0].projection_next = []; s.index[0].projection_value = []
    loop p in projections: fact_add_projection(s, p)
    differences = s.differences
    s.differences = []; s.index[0].difference_index = []; s.index[0].difference_value = []; s.index[0].difference_record = []; s.index[0].difference_next = []
    loop row in differences: fact_add_difference(s, row)

# A full state drops the values nothing current reaches: bindings and their
# tombstones, result evidence, entry snapshots, loans and the newest values,
# and what their projections and terms reach. A dropped value is unknown from
# then on: it loses its facts, never gains one.
fact_compact = (s: mut FactState):
    keep: {int: bool} = {}
    work: int[]
    loop b in s.bindings:
        work.push(b.value)
        work.push(b.prior)
    loop c in s.conditional:
        work.push(c.result)
        if c.payload != 0: work.push(c.payload)
        work += c.values
    work += refine_entry
    loop loan in fact_loans: work.push(loan.capacity)
    # (the newest values: operands of the expression being evaluated)
    loop j in [max(0, s.ids.len() - 32)..s.ids.len()): work.push(s.ids[j])
    # (terms are followed two levels: an accumulator's chain of sums is not
    # kept whole)
    depth = fill(0, work.len())
    i = 0
    loop i < work.len():
        v = work[i]
        d = depth[i]
        i += 1
        if v <= 0 or v >= fact_terms.len() or keep.has(v): continue
        keep[v] = true
        if d < 2:
            work.push(fact_terms[v].a)
            work.push(fact_terms[v].b)
            depth.push(d + 1)
            depth.push(d + 1)
        pi = fact_index_get(s.index[0].projection_head, v)
        loop pi >= 0:
            p = s.projections[pi]
            pi = s.index[0].projection_next[pi]
            work.push(p.value)
            depth.push(d)
            if p.element:
                work.push(p.selector)
                depth.push(d)
    ids: int[]
    bounds: FactBound[]
    loop j in [0..s.ids.len()):
        if keep.has(s.ids[j]):
            ids.push(s.ids[j])
            bounds.push(s.bounds[j])
    projections: FactProjection[]
    loop p in s.projections:
        if keep.has(p.base) and keep.has(p.value): projections.push(p)
    differences: FactDifference[]
    loop row in s.differences:
        if keep.has(row.a) and keep.has(row.b): differences.push(row)
    s.ids = ids
    s.bounds = bounds
    s.projections = projections
    s.differences = differences
    fact_reindex(s)
    # (too little freed: stop compacting this state rather than thrash)
    s.full = ids.len() > FACT_CAP - FACT_CAP / 8

# A scope's end drops the values it made that nothing live reaches: every
# value made before the scope began stays (an enclosing expression may hold
# it), as do the scope's result and whatever bindings, evidence and kept
# values reach through projections (and terms, two levels). Only a sizeable
# saving rebuilds the state. O(V + P + D), stamps instead of a hash set.
fact_stamp: int[]
fact_stamp_gen = 0
fact_collect = (s: mut FactState, boundary: int, result: int):
    fresh = 0
    loop v in s.ids:
        if v >= boundary: fresh += 1
    if fresh < 16: return
    if fact_stamp.len() < fact_terms.len(): fact_stamp += fill(0, fact_terms.len() - fact_stamp.len() + 1024)
    fact_stamp_gen += 1
    gen = fact_stamp_gen
    work: int[]
    depth: int[]
    work.push(result)
    loop b in s.bindings:
        work.push(b.value)
        work.push(b.prior)
    loop c in s.conditional:
        work.push(c.result)
        if c.payload != 0: work.push(c.payload)
        work += c.values
    work += refine_entry
    loop loan in fact_loans: work.push(loan.capacity)
    work += fact_summary_entry
    depth = fill(0, work.len())
    kept = 0
    i = 0
    loop i < work.len():
        v = work[i]
        d = depth[i]
        i += 1
        if v <= 0 or v >= fact_terms.len() or fact_stamp[v] == gen: continue
        fact_stamp[v] = gen
        if v >= boundary: kept += 1
        if d < 2:
            work.push(fact_terms[v].a)
            work.push(fact_terms[v].b)
            depth.push(d + 1)
            depth.push(d + 1)
        pi = fact_index_get(s.index[0].projection_head, v)
        loop pi >= 0:
            p = s.projections[pi]
            pi = s.index[0].projection_next[pi]
            work.push(p.value)
            depth.push(d)
            if p.element:
                work.push(p.selector)
                depth.push(d)
        # (a row relates its endpoints: a temporary between two live values,
        # `i+1 <? n`, still says something about them)
        loop direction in [0..2):
            ri = fact_difference_head(s, v, direction)
            loop ri >= 0:
                row = s.differences[ri]
                ri = fact_difference_next(s, ri, direction)
                work.push(if direction == 0: row.a else: row.b)
                depth.push(0)
    total = 0
    loop v in s.ids:
        if fact_stamp[v] == gen: total += 1
    if (s.ids.len() - total) * 4 < s.ids.len(): return
    ids: int[]
    bounds: FactBound[]
    loop j in [0..s.ids.len()):
        if fact_stamp[s.ids[j]] == gen:
            ids.push(s.ids[j])
            bounds.push(s.bounds[j])
    projections: FactProjection[]
    loop p in s.projections:
        if p.base > 0 and p.base < fact_terms.len() and fact_stamp[p.base] == gen and p.value > 0 and p.value < fact_terms.len() and fact_stamp[p.value] == gen: projections.push(p)
    differences: FactDifference[]
    loop row in s.differences:
        if fact_stamp[row.a] == gen and fact_stamp[row.b] == gen: differences.push(row)
    s.ids = ids
    s.bounds = bounds
    s.projections = projections
    s.differences = differences
    fact_reindex(s)

fact_constant = (s: mut FactState, x: int, at: int = 0) -> int:
    fact_new(s, FactBound(x, x, x != 0), FactTerm(origin = at))

fact_place = (e: int) -> PlaceIdentity: place_scalar_root(e)

# (a join's root index may be shared with a predecessor holding more
# bindings: an entry counts only when it still names p's position)
fact_binding = (s: FactState, p: PlaceIdentity) -> int:
    i = fact_index_get(s.index[0].roots, fact_root_key(p))
    if i >= 0 and i < s.bindings.len() and s.bindings[i].place == p: return i
    -1

fact_bind = (s: mut FactState, p: PlaceIdentity, v: int):
    if p.declaration == 0: return
    i = fact_binding(s, p)
    if i >= 0: s.bindings[i].value = v
    else if s.bindings.len() < FACT_CAP:
        fact_index_put(s.index[0].roots, fact_root_key(p), s.bindings.len())
        s.bindings.push(FactBinding(p, v))

# A replacement keeps the replaced value as the route's single tombstone.
fact_rebind = (s: mut FactState, p: PlaceIdentity, v: int, at: int, prior: int):
    fact_bind(s, p, v)
    i = fact_binding(s, p)
    if i >= 0 and at != 0:
        s.bindings[i].event = at
        s.bindings[i].prior = prior

# Aggregates have immutable evaluated identities too. A projection belongs to
# that value, never to a source spelling; a store rebuilds the enclosing value.
fact_project = (s: mut FactState, base: int, selector: int, element: bool, t: int) -> int:
    if base == 0: return fact_new(s, fact_domain(t))
    if not element:
        i = fact_index_get(s.index[0].projection_index, fact_projection_key(base, selector, false))
        if i >= 0: return s.projections[i].value
    else:
        i = fact_index_get(s.index[0].projection_head, base)
        loop i >= 0:
            p = s.projections[i]
            i = s.index[0].projection_next[i]
            if p.element and (p.selector == selector or fact_compare(s, .eq, p.selector, selector) == 1): return p.value
    v = fact_new(s, fact_domain(t), FactTerm(type = t))
    if not element and selector == -1:
        fact_set_bound(s, v, FactBound(0, fact_length_max()))
    if s.projections.len() < FACT_CAP: fact_add_projection(s, FactProjection(base, selector, element, v))
    if refine_active:
        # A field's contract may name its siblings: every stored record was
        # validated whole, so the field's value relates to theirs in base.
        args: int[]
        if not element and selector >= 0 and ref_has_fields(t): args = fact_field_args(s, base)
        ref_assume(t, v, args, s)
    v

# max(0, n) as a projection of n, so every use of one count (fills of the same
# n, a callee's result length summarized by its count parameter) has one value.
fact_clamped = (s: mut FactState, count: int, at: int = 0) -> int:
    c = fact_bound(s, count)
    size = fact_project(s, count, FACT_CLAMPED, false, T_INT)
    old = fact_bound(s, size)
    fact_set_bound(s, size, FactBound(max(old.lo, max(0, c.lo)), min(old.hi, max(0, min(c.hi, fact_length_max())))))
    fact_difference(s, count, size, 0, at)
    if c.lo >= 0: fact_difference(s, size, count, 0, at)
    size

# A direct call of the prelude function named name (parallel_lower.jo's test).
fact_prelude_call = (n: int, name: str) -> bool:
    if nodes[n].kind != .call or nodes[n].aux != 0 or nodes[n].sym <= 0: return false
    f = int(nodes[n].sym)
    d = int(fns[f].decl)
    d != 0 and modules[int(fns[f].mod)].is_prelude and name_of(int(nodes[d].name)) == name

# A direct call of the bundled library's function named name (std/thread.jo's
# `parallel_range`, a reviewed contract).
fact_library_call = (n: int, name: str) -> bool:
    if nodes[n].kind != .call or nodes[n].aux != 0 or nodes[n].sym <= 0: return false
    d = int(fns[int(nodes[n].sym)].decl)
    d != 0 and pos_in_lib(nodes[d].pos) and name_of(int(nodes[d].name)) == name

# Reviewed array emptiness contract. O(1), only when a demanded expression
# reads the result; mutation continues to invalidate the receiver normally.
fact_empty_array_call = (n: int) -> bool:
    if nkids(n) != 1 or not fact_library_call(n, "is_empty"): return false
    t = fact_type(ntype(kid(n, 0)))
    if types[t].kind != .array and types[t].kind != .fixed: return false
    d = int(fns[int(nodes[n].sym)].decl)
    files[pos_file(nodes[d].pos)].path == lib_dir + "/core/array.jo"

# The bundled delimiter split always appends its final part when the
# separator is nonempty. Empty separators and whitespace splitting differ.
# Binding identity is checked, never an arbitrary user function's spelling.
fact_split_call = (n: int) -> bool:
    if (nkids(n) != 2 and nkids(n) != 3) or not fact_library_call(n, "split"): return false
    d = int(fns[int(nodes[n].sym)].decl)
    files[pos_file(nodes[d].pos)].path == lib_dir + "/core/str.jo" and fact_type(ntype(kid(n, 1))) == T_STR

# Whitespace splitting emits only nonempty strings; delimiter splitting can
# emit empty fields. This belongs to the bundled implementation, not its name.
fact_words_call = (n: int) -> bool:
    if nkids(n) != 1 or not (fact_library_call(n, "split") or fact_library_call(n, "words")): return false
    d = int(fns[int(nodes[n].sym)].decl)
    files[pos_file(nodes[d].pos)].path == lib_dir + "/core/str.jo"

# The bundled array search's successful arm is a position in its evaluated
# input snapshot. Publish through the ordinary conditional-result mechanism:
# Missing supplies no index evidence, especially when the input is empty.
fact_search_predicate = 0
fact_search_call = (n: int) -> bool:
    if nkids(n) != 2 or not fact_library_call(n, "__dewy_index_of"): return false
    d = int(fns[int(nodes[n].sym)].decl)
    files[pos_file(nodes[d].pos)].path == lib_dir + "/std/dewy.jo"

fact_search_result = (n: int, result: int, values: int[], s: mut FactState):
    if s.conditional.len() >= 32: return
    if fact_search_predicate == 0:
        fact_search_predicate = ref_intern([RefAtom(.ge, RefTerm(), RefTerm(1, 0)), RefAtom(.lt, RefTerm(), RefTerm(2, 0, path = [-1]))])
    f = int(nodes[n].sym)
    tag = union_index(prune(int(fns[f].ret)), T_INT)
    if tag < 0: return
    selector = result_selector(f, result, s)
    payload = fact_project(s, result, -4, false, T_INT)
    s.conditional.push(ResultEvidence(selector, tag, fact_search_predicate, values, fns[f].ptypes, payload, T_INT))

# The fields of record value base, by ordinal, for a dependent field contract.
# O(fields); each sibling is projected once per record value.
fact_field_args = (s: mut FactState, base: int) -> int[]:
    t = fact_type(fact_terms[base].type)
    if t <= 0 or types[t].kind != .struct_: return []
    si = int(types[t].st)
    args: int[]
    loop i in [0..int(structs[si].nfields)):
        f = fields[int(structs[si].fields) + i]
        args.push(fact_project(s, base, int(f.name), false, int(f.type)))
    args

fact_replace = (s: mut FactState, base: int, selector: int, element: bool, value: int, t: int) -> int:
    v = fact_new(s, fact_domain(t), FactTerm(type = t))
    old = s.projections
    links = s.index[0].projection_next
    pi = fact_index_get(s.index[0].projection_head, base)
    loop pi >= 0:
        p = old[pi]
        pi = links[pi]
        if element and not p.element and p.selector == FACT_ELEMENT_LENGTH: continue
        if p.element == element:
            if not element and p.selector == selector: continue
            # Different selector identities do not prove different elements.
            if element and fact_compare(s, .ne, p.selector, selector) != 1: continue
        if s.projections.len() < FACT_CAP: fact_add_projection(s, FactProjection(v, p.selector, p.element, p.value))
    if s.projections.len() < FACT_CAP: fact_add_projection(s, FactProjection(v, selector, element, value))
    v

fact_read = (s: mut FactState, e: int) -> int:
    if nodes[e].kind == .ident and nodes[e].aux == i32(int(SK.local)):
        l = int(nodes[e].sym)
        if int(locals[l].flags) & LF_ALIAS != 0 and locals[l].alias != 0: return fact_capture(int(locals[l].alias), s)
    p = fact_place(e)
    if p.declaration == 0: return fact_new(s, FactBound(reason = .unsupported, witness = e), FactTerm(type = ntype(e)))
    i = fact_binding(s, p)
    if i >= 0: return s.bindings[i].value
    t = refine_storage(e, ntype(e))
    v = fact_new(s, fact_domain(t), FactTerm(type = t))
    fact_bind(s, p, v)
    if refine_active: ref_assume(t, v, [], s)
    if p.root == .global:
        if t == T_MATH_INT:
            bound = fact_global_integer(p.declaration)
            if not bound.wide: fact_set_bound(s, v, bound)
        size = fact_global_length(p.declaration)
        if size >= 0 and s.projections.len() < FACT_CAP: fact_add_projection(s, FactProjection(v, -1, false, fact_constant(s, size)))
    v

# A literal-initialized script integer that no checked write can replace.
# Seed only demanded reads, O(1), using the existing global write flags.
# Include the zero-initialized value too: a helper may run during initialization.
# Mutable literal unions keep their existing whole-write-domain inference.
fact_global_integer = (g: int) -> FactBound:
    unknown = FactBound(wide = true)
    if g <= 0 or g >= globals.len() or globals[g].fn_written or globals[g].init_written or globals[g].exposed: return unknown
    d = int(globals[g].decl)
    if d == 0 or nodes[d].kind != .vardecl: return unknown
    init = domain_leaf(int(nodes[d].b))
    if init == 0 or nodes[init].kind != .int_lit or oversized_literal(init): return unknown
    x = nodes[init].ival
    FactBound(min(0, x), max(0, x))

# The length of an immutable global literal: O(elements) for arrays,
# O(bytes) for ASCII strings (CR and non-ASCII graphemes stay unknown).
fact_global_length = (g: int) -> int:
    if g <= 0 or g >= globals.len() or globals[g].fn_written or globals[g].init_written or globals[g].exposed: return -1
    kind = tkind(fact_type(int(globals[g].type)))
    if kind != .array and kind != .str_: return -1
    d = int(globals[g].decl)
    if d == 0 or nodes[d].kind != .vardecl: return -1
    init = int(nodes[d].b)
    if kind == .str_:
        if init == 0 or nodes[init].kind != .str_lit or nkids(init) != 0 or nodes[init].sval < 0: return -1
        text = name_of(int(nodes[init].sval))
        loop c in text:
            if c >= 128 or c == 13: return -1
        return len(text)
    loop init != 0 and nodes[init].kind == .conv and nodes[init].aux == i32(int(CV.fixed2arr)): init = int(nodes[init].a)
    if init == 0 or nodes[init].kind != .array or nodes[init].b != 0 or nodes[init].aux != 0: return -1
    loop i in [0..nkids(init)):
        if has_flag(kid(init, i), NF_SPREAD): return -1
    nkids(init)

struct FactRoute:
    root: int = 0
    selectors: int[]
    elements: bool[]
    types: int[]
    sites: int[]    # each selector's index node (0 for a field)

# Capture target selectors once. Rebuilding ancestor values below is a pure
# operation over those captured selectors, never a second syntax evaluation.
fact_route = (e: int, s: mut FactState, depth: int = 0) -> FactRoute:
    if e == 0 or depth > 32: return FactRoute()
    k = nodes[e].kind
    if k == .ident:
        if nodes[e].aux == i32(int(SK.local)):
            l = int(nodes[e].sym)
            if int(locals[l].flags) & LF_ALIAS != 0 and locals[l].alias != 0: return fact_route(int(locals[l].alias), s, depth + 1)
        return FactRoute(e)
    if k == .field or k == .index:
        route = fact_route(int(nodes[e].a), s, depth + 1)
        selector = if k == .field: (if nodes[e].aux == -2: int(nodes[e].ival) else: int(nodes[e].name)) else: fact_capture(int(nodes[e].b), s)
        route.selectors.push(selector)
        route.elements.push(k == .index)
        route.types.push(refine_storage(e, ntype(e)))
        route.sites.push(if k == .index: e else: 0)
        return route
    fact_capture(e, s)
    FactRoute()

fact_route_values = (s: mut FactState, route: FactRoute) -> int[]:
    if route.root == 0: return []
    values = [fact_read(s, route.root)]
    loop i in [0..route.selectors.len()):
        values.push(fact_project(s, values[i], route.selectors[i], route.elements[i], route.types[i]))
    values

fact_store_route = (s: mut FactState, route: FactRoute, value0: int, at: int, bounds: bool = false):
    p = fact_place(route.root)
    if p.declaration == 0: fact_forget(s, at, .write, true); return
    values = fact_route_values(s, route)
    if bounds and fact_speculating == 0 and fact_probe_on: fact_probe_route(s, route, values)
    else if bounds and fact_speculating == 0 and (fact_policy == .RequireStatic or fact_query): fact_route_bounds(s, route, values)
    if values.len() > 0 and s.conditional.len() > 0: result_replaced(values[values.len() - 1], at, s)
    value = value0
    i = route.selectors.len() - 1
    loop i >= 0:
        t = if i == 0: ntype(route.root) else: route.types[i - 1]
        value = fact_replace(s, values[i], route.selectors[i], route.elements[i], value, t)
        i -= 1
    if fact_exposed(p): fact_forget(s, at, .write, false, p)
    fact_rebind(s, p, value, at, if values.len() > 0: values[0] else: 0)

# Component i of an unpacked value of type t0: a tuple's field or an array's
# element (a record's is not tracked by position).
fact_component = (s: mut FactState, value: int, t0: int, i: int, ct: int) -> int:
    t = fact_type(t0)
    if tkind(t) == .tuple: return fact_project(s, value, i, false, ct)
    if tkind(t) == .array or tkind(t) == .fixed: return fact_project(s, value, fact_constant(s, i), true, ct)
    fact_new(s, fact_domain(ct))

# An unpacking store `(a b) = value` writes each component's route.
fact_store_pattern = (s: mut FactState, target: int, value: int, at: int, depth: int = 0):
    k = nodes[target].kind
    if k == .hole: return
    if k == .tuple and depth < 32:
        loop i in [0..nkids(target)):
            c = kid(target, i)
            if nodes[c].kind != .hole: fact_store_pattern(s, c, fact_component(s, value, ntype(target), i, ntype(c)), at, depth + 1)
        return
    route = fact_route(target, s)
    fact_store_route(s, route, value, at, true)

# A store's element selectors carry the obligation a load's do (fact_capture's index).
fact_route_bounds = (s: mut FactState, route: FactRoute, values: int[]):
    loop i in [0..route.selectors.len()):
        n = route.sites[i]
        if n == 0 or i >= values.len() or has_flag(n, NF_INBOUNDS): continue
        t = fact_type(if i == 0: ntype(route.root) else: route.types[i - 1])
        if types[t].kind != .array and types[t].kind != .fixed: continue
        index = route.selectors[i]
        length = if types[t].kind == .fixed: fact_constant(s, fixed_len(t)) else: fact_project(s, values[i], -1, false, T_INT)
        zero = fact_constant(s, 0)
        lo = fact_compare(s, .le, zero, index)
        hi = fact_compare(s, .lt, index, length)
        dir_index(n, lo == 1 and hi == 1)
        if lo != 1 or hi != 1: wit_index(n, s, index, length, lo, hi)

# Effect verification asks which accesses a body's own facts keep in bounds.
# A probe records answers instead of reporting obligations. Borrowed partition
# lowering can also use these answers: its checked ABI makes mutable array
# parameters disjoint and forbids resizing, copying, escaping and opaque calls.
fact_probe_on = false
fact_probe_disjoint = 0
fact_probe: {int: bool} = {}
fact_probe_diverged = false

# Under the static policy a probe runs the facts pass's own transfer, with
# index failures recorded instead of reported. A probe that proved everything,
# reported nothing and never diverged from that transfer is the facts pass's
# run of its body: facts_finalize reuses it rather than analysing it again.
# The run is the facts pass's only while its inputs are: its slice, and the
# effect footprints of the callees it consulted (rows can differ after the
# probes settle, where a row reached its region budget).
struct FactFootprint:
    kind: int
    writes: EffectAtom[]
struct FactProbeRun:
    proven: {int: bool}
    refine: bool
    slice: int[]
    slice_base: int
    callees: int[]
    footprints: FactFootprint[]
fact_probe_runs: {int: FactProbeRun} = {}
fact_probe_callees: int[]
fact_probe_footprints: FactFootprint[]

# What fact_call_effects reads of a direct callee's settled row.
fact_footprint = (f: int) -> FactFootprint:
    if not effects_demand(f, true): return FactFootprint(1, [])
    if fns[f].body != 0 and fns[f].state != 2: return FactFootprint(2, [])
    writes: EffectAtom[]
    loop event in effect_summaries[f].events:
        if event.atom.kind == .opaque or event.atom.kind == .escape: return FactFootprint(3, [])
        if event.atom.kind == .write: writes.push(event.atom)
    FactFootprint(4, writes)

fact_footprint_same = (a: FactFootprint, b: FactFootprint) -> bool:
    if a.kind != b.kind or a.writes.len() != b.writes.len(): return false
    loop i in [0..a.writes.len()):
        if a.writes[i] != b.writes[i]: return false
    true

fact_probe_note = (f: int):
    if fact_probe_callees.contains(f): return
    fact_probe_callees.push(f)
    fact_probe_footprints.push(fact_footprint(f))

# Whether the facts pass would run f's body exactly as its probe did.
fact_probe_reusable = (f: int, run: FactProbeRun) -> bool:
    if fact_policy != .RequireStatic or proof_active or result_active or wi_fact_calls.len() > 0 or wit_collect and not wit_measure or run.refine != (refine_active or refine_requests.len() > 0): return false
    fact_slice_prepare(f)
    if fact_slice.base != run.slice_base or fact_slice.flags.len() != run.slice.len(): return false
    loop i in [0..run.slice.len()):
        if fact_slice.flags[i] != run.slice[i]: return false
    loop i in [0..run.callees.len()):
        if not fact_footprint_same(fact_footprint(run.callees[i]), run.footprints[i]): return false
    true

fact_probe_record = (n: int, proven: bool):
    ok = proven
    if let old = fact_probe.get(n): ok = ok and old
    fact_probe[n] = ok

fact_probe_index = (n: int, s: mut FactState, index: int, length: int):
    zero = fact_constant(s, 0)
    fact_probe_record(n, fact_compare(s, .le, zero, index) == 1 and fact_compare(s, .lt, index, length) == 1)

# (a check of the probe's own: the facts pass would not make this constant)
fact_probe_divisor = (n: int, s: mut FactState, divisor: int, operand: int):
    fact_probe_diverged = true
    zero = fact_constant(s, ref_encoded(0, ntype(operand)))
    fact_probe_record(n, fact_compare(s, .ne, divisor, zero) == 1)

fact_probe_route = (s: mut FactState, route: FactRoute, values: int[]):
    loop i in [0..route.selectors.len()):
        n = route.sites[i]
        if n == 0 or i >= values.len() or has_flag(n, NF_INBOUNDS): continue
        t = fact_type(if i == 0: ntype(route.root) else: route.types[i - 1])
        if types[t].kind != .array and types[t].kind != .fixed: continue
        length = if types[t].kind == .fixed: fact_constant(s, fixed_len(t)) else: fact_project(s, values[i], -1, false, T_INT)
        fact_probe_index(n, s, route.selectors[i], length)

# Analyze f's body from an unknown entry (plus its checked parameter
# refinements) and return the element accesses proven in bounds on every path
# that reaches them. Nested runs are refused: the caller keeps its obligation.
fact_probe_function = (f: int, disjoint: bool = false) -> {int: bool}:
    fact_probe = {}
    if fact_owner != 0 or fact_probe_on or f <= 0 or f >= fns.len() or fns[f].state != 2 or fns[f].body == 0: return fact_probe
    saved_proof = proof_active
    saved_result = result_active
    proof_active = false
    result_active = false
    fact_probe_on = true
    fact_probe_disjoint = if disjoint: f else: 0
    fact_owner = f
    fact_terms = [FactTerm()]
    state = FactState()
    refine = refine_active or refine_requests.len() > 0
    if refine: refine_fact_entry(f, state)
    if fact_fork_entries.len() > 0 or fact_parallel_bounds.len() > 0: fact_fork_seed(f, state)
    fact_slice_prepare(f)
    fact_probe_diverged = fact_slice.probe_only
    fact_probe_callees = []
    fact_probe_footprints = []
    reported = wit_collected + dir_sites.len()
    fact_capture(int(fns[f].body), state)
    if not disjoint and fact_policy == .RequireStatic and not saved_proof and not saved_result and not (wit_collect and not wit_measure) and not fact_probe_diverged and reported == wit_collected + dir_sites.len():
        all = true
        loop _, ok in fact_probe:
            if not ok: all = false
        if all: fact_probe_runs[f] = FactProbeRun(fact_probe, refine, fact_slice.flags, fact_slice.base, fact_probe_callees, fact_probe_footprints)
    fact_probe_callees = []
    fact_probe_footprints = []
    fact_slice = FactSlice()
    fact_owner = 0
    fact_terms = []
    fact_probe_on = false
    fact_probe_disjoint = 0
    proof_active = saved_proof
    result_active = saved_result
    fact_probe

# A callee's return summary: the interval of an array result's length, or of
# a word result, over every return of an erased speculative run of its body
# from an unknown entry (with its parameter refinements). Speculation reports
# nothing and validates nothing; recursion and an exhausted run give unknown.
# An array result may also keep a parameter's entry length plus a small
# constant on every return (`same`: that parameter's ordinal, else -1).
struct FactSummary:
    length: FactBound
    value: FactBound
    seen: bool = false
    same: int = -1
    delta: int = 0
    upper: int = -1          # scalar result <= entry array length + upper_delta
    upper_delta: int = 0
    host: bool = false       # every scalar return has finite host endpoints

fact_summaries: {int: FactSummary} = {}
fact_summary_owner = 0
# The function of a request analyzed again outside its body's run.
fact_retry_owner = 0
fact_summary_acc = FactSummary()
fact_summary_entry: int[]    # each array parameter's entry length value (0: none)

# The parameter whose entry length the result length equals plus a constant in
# [-2, 2]: at most a few distance queries per array parameter and return.
fact_summary_relation = (s: FactState, length: int) -> (int, int):
    loop i in [0..fact_summary_entry.len()):
        l = fact_summary_entry[i]
        if l == 0: continue
        loop c in [-2..3):
            if fact_distance(s, length, l, c) and fact_distance(s, l, length, -c): return (i, c)
    (-1, 0)

fact_summary_record = (s: mut FactState, r: int):
    t = fact_type(int(fns[fact_summary_owner].ret))
    length = FactBound()
    value = FactBound()
    same = -1
    delta = 0
    if r != 0 and tkind(t) == .array:
        lv = fact_project(s, r, -1, false, T_INT)
        length = fact_bound(s, lv)
        if fact_summary_entry.len() > 0:
            same, delta = fact_summary_relation(s, lv)
    else if r != 0: value = fact_bound(s, r)
    # (a mathematical int result of fixed-width or singleton returns is a
    # finite int64 value; O(incident rows) per return)
    host = r != 0 and fact_type(t) == T_MATH_INT and (not fact_summary_acc.seen or fact_summary_acc.host) and fact_host_finite(s, r)
    upper = -1
    upper_delta = 0
    if r != 0 and fact_scalar(t) and is_int(t) and t != T_U64:
        # One source-selected array endpoint per result; at most two bounded
        # queries per array parameter/return, no pair enumeration. Once a
        # result arm loses the relation, later arms cannot restore it.
        loop i in [0..fact_summary_entry.len()):
            length_value = fact_summary_entry[i]
            if length_value == 0: continue
            if fact_summary_acc.seen and fact_summary_acc.upper != i: continue
            limit = if not fact_summary_acc.seen or fact_summary_acc.upper_delta == -1: -1 else: 0
            holds = fact_entails(s, r, length_value, limit)
            if not holds and limit != 0:
                limit = 0
                holds = fact_entails(s, r, length_value, limit)
            if holds:
                upper = i; upper_delta = limit
                break
    if fact_summary_acc.seen:
        length = fact_hull(fact_summary_acc.length, length, 0)
        value = fact_hull(fact_summary_acc.value, value, 0)
        if fact_summary_acc.same != same or fact_summary_acc.delta != delta: same = -1
    fact_summary_acc = FactSummary(length, value, true, same, delta, upper, upper_delta, host)
    # A hull only widens. Once it says nothing the result's own domain does
    # not, and no argument-length relation survives (once lost, it stays
    # lost), the rest of the run cannot bound anything a caller asks: stop it
    # (an unbounded summary counts the same as none).
    if same < 0 and upper < 0 and fact_summary_vacuous(fact_summary_acc, t):
        fact_loop_steps = FACT_STEPS + 1
        fact_loop_exhausted = true

fact_summary_vacuous = (acc: FactSummary, t: int) -> bool:
    if tkind(t) == .array: return acc.length.lo <= 0 and acc.length.hi >= fact_length_max()
    d = fact_domain(t)
    acc.value.lo <= d.lo and acc.value.hi >= d.hi and not acc.value.nz and not acc.host

fact_summary = (f: int) -> FactSummary:
    if let known = fact_summaries.get(f): return known
    unknown = FactSummary(FactBound(), FactBound())
    d = int(fns[f].decl)
    t = fact_type(int(fns[f].ret))
    if fns[f].state != 2 or fns[f].body == 0 or fns[f].kind == FK_INIT or fns[f].caps.len() != 0 or d != 0 and has_flag(d, NF_EXTERN) or effect_unavailable.has(f): return unknown
    if tkind(t) != .array and not (fact_scalar(t) and is_int(t)): return unknown
    fact_summaries[f] = unknown
    saved = (fact_owner, fact_summary_owner, fact_speculating, fact_loop_steps, fact_loop_exhausted, proof_active, result_active, fact_pending_defers, fact_probe_on, fact_query)
    saved_entry = refine_entry
    saved_loops = fact_loops
    saved_acc = fact_summary_acc
    saved_slice = fact_slice
    saved_lengths = fact_summary_entry
    fact_owner = f
    fact_summary_owner = f
    fact_speculating += 1
    fact_loop_steps = 0
    fact_loop_exhausted = false
    proof_active = false
    result_active = false
    fact_pending_defers = 0
    fact_probe_on = false
    fact_query = false
    fact_loops = []
    fact_summary_acc = FactSummary()
    state = FactState()
    # Width conversions request refinements without enabling declared contracts.
    # A summary/deferred walk still needs its own entry, never its caller's slots.
    refine_entry = []
    if refine_active or refine_owners.has(f): refine_fact_entry(f, state)
    fact_summary_entry = []
    if tkind(t) == .array or fact_scalar(t) and is_int(t) and t != T_U64:
        loop l in fns[f].params:
            pt = fact_type(int(locals[l].type))
            v = 0
            if tkind(pt) == .array:
                place = PlaceIdentity(.local, int(locals[l].owner), l)
                i = fact_binding(state, place)
                if i >= 0: v = state.bindings[i].value
                else:
                    v = fact_new(state, FactBound(), FactTerm(type = pt))
                    fact_bind(state, place, v)
                v = fact_project(state, v, -1, false, T_INT)
            # (a count parameter: the result may be max(0, n) long, `fill(x n)`)
            else if tkind(t) == .array and fact_scalar(pt) and is_int(pt) and pt != T_U64:
                v = fact_clamped(state, fact_read(state, mk_ident_local(l, locals[l].pos)))
            fact_summary_entry.push(v)
    fact_slice_prepare(f, true)
    r = fact_capture(int(fns[f].body), state)
    if state.live: fact_summary_record(state, r)
    result = if fact_loop_exhausted or not fact_summary_acc.seen: unknown else: fact_summary_acc
    fact_owner = saved.0
    fact_summary_owner = saved.1
    fact_speculating = saved.2
    fact_loop_steps = saved.3
    fact_loop_exhausted = saved.4
    proof_active = saved.5
    result_active = saved.6
    fact_pending_defers = saved.7
    fact_probe_on = saved.8
    fact_query = saved.9
    refine_entry = saved_entry
    fact_loops = saved_loops
    fact_summary_acc = saved_acc
    fact_slice = saved_slice
    fact_summary_entry = saved_lengths
    fact_summaries[f] = result
    result

fact_store = (s: mut FactState, e: int, value: int, at: int):
    route = fact_route(e, s)
    fact_store_route(s, route, value, at)

fact_exposed = (p: PlaceIdentity) -> bool:
    # Checked references record escape while names are resolved (O(1) per use).
    # Only its own initializer may treat a closed script binding as a local;
    # ordinary function summaries must never assume its initial value.
    if p.root == .global:
        g = p.declaration
        if g <= 0 or fact_owner <= 0: return true
        return globals[g].fn_accessed or globals[g].fn_written or globals[g].exposed or fns[fact_owner].kind != FK_INIT or modules[int(globals[g].mod)].init_fn != i32(fact_owner)
    if p.root != .local: return true
    # (a Dewy dictionary's address is taken only to pass it as a mutable
    # argument, for that call: its summary names what it writes)
    flags = int(locals[p.declaration].flags)
    if flags & LF_VALUEITER != 0: flags &= ~LF_BYREF
    if flags & (LF_MUTPARAM | LF_SHARED | LF_CAPTURE | LF_BYREF | LF_EXPOSED) == 0 and flags & LF_ADDR != 0 and is_map_type(int(locals[p.declaration].type)) and fact_dewy_local(p.declaration): return false
    # Only the closed, checked partition ABI supplies this guarantee. Ordinary
    # callers and speculative summaries retain conservative alias invalidation.
    if fact_probe_disjoint != 0 and fact_owner == fact_probe_disjoint and int(locals[p.declaration].owner) == fact_probe_disjoint and tkind(int(locals[p.declaration].type)) == .array and int(locals[p.declaration].flags) & LF_MUTPARAM != 0: return false
    flags & (LF_MUTPARAM | LF_SHARED | LF_CAPTURE | LF_ADDR | LF_BYREF | LF_EXPOSED) != 0

# A dictionary local passed mutably to a call (not exposed, fact_exposed) has
# a new value after it, whatever the callee's summary says or lacks.
fact_forget_mutable_maps = (n: int, s: mut FactState):
    mask = checked_call_mutmask(n)
    if mask == 0: return
    loop i in [0..min(nkids(n), 62)):
        if mask & (1 << i) == 0: continue
        e = kid(n, i)
        loop nodes[e].kind == .addr or nodes[e].kind == .conv: e = int(nodes[e].a)
        p = place_base(place_route(e))
        if p.declaration <= 0 or (p.root != .local and p.root != .global): continue
        t = if p.root == .local: int(locals[p.declaration].type) else: int(globals[p.declaration].type)
        if not is_map_type(t): continue
        j = fact_binding(s, p)
        if j < 0: continue
        s.bindings[j] = FactBinding(p, fact_new(s, fact_domain(t, .call, n), FactTerm(type = t)), n, if s.bindings[j].event == n: s.bindings[j].prior else: s.bindings[j].value)

fact_dewy_local = (l: int) -> bool:
    f = int(locals[l].owner)
    f > 0 and f < fns.len() and fns[f].decl != 0 and files[pos_file(nodes[int(fns[f].decl)].pos)].is_dewy

# Distinct `@` parameters of one Dewy function are disjoint storage: each call
# passes them places the mutable-argument check proves apart (provisional).
fact_disjoint = (p: PlaceIdentity, q: PlaceIdentity) -> bool:
    if p.root != .local or q.root != .local or p.declaration == q.declaration or p.declaration == 0 or q.declaration == 0: return false
    a = p.declaration; b = q.declaration
    if locals[a].owner != locals[b].owner or int(locals[a].flags) & LF_MUTPARAM == 0 or int(locals[b].flags) & LF_MUTPARAM == 0: return false
    f = int(locals[a].owner)
    f > 0 and f < fns.len() and fns[f].decl != 0 and files[pos_file(nodes[int(fns[f].decl)].pos)].is_dewy

fact_exposed_bound = (s: FactState) -> bool:
    loop binding in s.bindings:
        if fact_exposed(binding.place): return true
    false

# A write through an exposed place p forgets every exposed root but those
# disjoint from p.
fact_forget = (s: mut FactState, at: int, reason: FactReason, all: bool = false, written: PlaceIdentity = PlaceIdentity(.local, 0, 0)):
    loop i in [0..s.bindings.len()):
        p = s.bindings[i].place
        if not all and not fact_exposed(p): continue
        if not all and fact_disjoint(written, p): continue
        t = if p.root == .local: int(locals[p.declaration].type) else: int(globals[p.declaration].type)
        v = fact_new(s, fact_domain(t, reason, at), FactTerm(type = t))
        fact_holds_contract(s, t, v)
        s.bindings[i] = FactBinding(p, v, at, s.bindings[i].value)

# A place declared with a refined type holds its contract whatever changed it:
# every write to it was checked against that type. (A dependency names only
# stable bindings: ref_term.)
fact_holds_contract = (s: mut FactState, t: int, v: int):
    if refine_active and v != 0: ref_assume(t, v, [], s)

# A call that never returns ends its path: what it writes is never read, so
# its callee tree is not summarized for it.
fact_ends_path = (n: int) -> bool: ntype(n) == T_NEVER or nodes[n].aux == 0 and library_exit_call(n)

fact_path_call_effects = (n: int, s: mut FactState):
    if fact_ends_path(n): effects_demand(0, true)
    else: fact_call_effects(n, s)

# A settled summary can preserve exposed roots across read-only calls.
# Opaque/callback/hidden-helper effects still invalidate every exposed root.
fact_call_effects = (n: int, s: mut FactState):
    f = int(nodes[n].sym)
    fact_forget_mutable_maps(n, s)
    # (a callee opaque by its signature forgets the same exposed roots its
    # summary would: its call tree is not visited for it)
    if nodes[n].aux == 0 and f > 0 and f < fns.len() and not (fns[f].body != 0 and fns[f].state != 2) and effect_signature_opaque(f):
        effects_demand(0, true)
        fact_forget(s, n, .call)
        return
    # (a return summary's run does not settle callee effect rows for itself:
    # a callee not yet settled forgets every exposed root, as an opaque call)
    if fact_summary_owner != 0 and nodes[n].aux == 0 and f > 0 and f < effect_summaries.len() and not effect_summaries[f].done:
        fact_forget(s, n, .call)
        return
    # (a call can change only exposed roots and its place arguments: with
    # neither bound here, its effect row has nothing to tell this state)
    if nodes[n].aux == 0 and checked_call_mutmask(n) == 0 and not fact_exposed_bound(s): return
    if fact_probe_on and nodes[n].aux == 0: fact_probe_note(f)
    if nodes[n].aux != 0 or not effects_demand(f, true):
        fact_forget(s, n, .call)
        return
    if fns[f].body != 0 and fns[f].state != 2:
        fact_forget(s, n, .callee)
        return
    events = effect_summaries[f].events
    loop event in events:
        if event.atom.kind == .opaque or event.atom.kind == .escape:
            fact_forget(s, n, .call)
            return
    loop event in events:
        if event.atom.kind != .write: continue
        p = place_base(event.atom.place)
        if p.root == .formal:
            i = p.declaration - 1
            if i < 0 or i >= nkids(n): fact_forget(s, n, .call); return
            p = place_base(place_route(kid(n, i)))
        if p.declaration == 0: fact_forget(s, n, .call); return
        # Alias overlap is conservative until its provenance is represented.
        if fact_exposed(p): fact_forget(s, n, .call, false, p)
        i = fact_binding(s, p)
        if i >= 0:
            t = if p.root == .local: int(locals[p.declaration].type) else: int(globals[p.declaration].type)
            s.bindings[i] = FactBinding(p, fact_new(s, fact_domain(t, .call, n), FactTerm(type = t)), n, if s.bindings[i].event == n: s.bindings[i].prior else: s.bindings[i].value)

fact_truth = (s: FactState, v: int) -> int:
    b = fact_bound(s, v)
    if b.lo == 0 and b.hi == 0: return 0
    if b.nz or b.lo > 0 or b.hi < 0: return 1
    -1

# (cap: incident rows per term; a constant offset's exact rows get twice
# the usual eight, so `b[p+1] … b[p+4]` after one guard all keep theirs)
fact_difference = (s: mut FactState, a: int, b: int, limit: int, at: int = 0, cap: int = 8):
    if a == 0 or b == 0 or a == b: return
    i = fact_row_find(s, a, b)
    if i >= 0:
        if limit < s.differences[i].limit: s.differences[i] = FactDifference(a, b, limit, at)
        return
    if s.differences.len() < 256 and max(0, fact_incident(s, a)) < cap and max(0, fact_incident(s, b)) < cap:
        fact_add_difference(s, FactDifference(a, b, limit, at))

# Bounded single-source relaxation, never an all-pairs closure. Exhaustion
# simply declines additional inference; every discovered path is still valid.
fact_distance = (s: FactState, a: int, b: int, limit: int) -> bool:
    if a == 0 or b == 0: return false
    if a == b: return limit >= 0
    direct = fact_row_find(s, a, b)
    if direct >= 0 and s.differences[direct].limit <= limit: return true
    # (no row leaves b: the relaxation below would find nothing)
    if fact_difference_head(s, b, 0) < 0: return false
    terms = [b]
    distances = [0]
    pending = [0]
    cursor = 0
    visits = 0
    loop cursor < pending.len() and visits < 256:
        index = pending[cursor]
        cursor += 1
        source = terms[index]
        distance = distances[index]
        previous = -1
        ri = fact_difference_head(s, source, 0)
        loop ri >= 0:
            row = s.differences[ri]
            # Charge the original ordered scan's budget, including skipped rows.
            visits += ri - previous
            previous = ri
            ri = fact_difference_next(s, ri, 0)
            if visits > 256: return false
            if not fact_add_fits(distance, row.limit): continue
            value = distance + row.limit
            if row.a == a and value <= limit: return true
            # (at most 32 terms: a scan beats hashing)
            slot = -1
            loop t in [0..terms.len()):
                if terms[t] == row.a: slot = t; break
            if slot < 0:
                if terms.len() >= 32: continue
                slot = terms.len()
                terms.push(row.a)
                distances.push(value)
                pending.push(slot)
            else if value < distances[slot]:
                distances[slot] = value
                pending.push(slot)
        visits += s.differences.len() - 1 - previous
    false

# The smallest d found with a - b <= d (FACT_MAX: none), by fact_distance's
# bounded relaxation.
fact_shortest = (s: FactState, a: int, b: int) -> int:
    if a == 0 or b == 0: return FACT_MAX
    if a == b: return 0
    best = FACT_MAX
    direct = fact_row_find(s, a, b)
    if direct >= 0: best = s.differences[direct].limit
    if fact_difference_head(s, b, 0) < 0: return best
    terms = [b]
    distances = [0]
    pending = [0]
    cursor = 0
    visits = 0
    loop cursor < pending.len() and visits < 256:
        index = pending[cursor]
        cursor += 1
        source = terms[index]
        distance = distances[index]
        previous = -1
        ri = fact_difference_head(s, source, 0)
        loop ri >= 0:
            row = s.differences[ri]
            visits += ri - previous
            previous = ri
            ri = fact_difference_next(s, ri, 0)
            if visits > 256: return best
            if not fact_add_fits(distance, row.limit): continue
            value = distance + row.limit
            if row.a == a:
                best = min(best, value)
                continue
            slot = -1
            loop t in [0..terms.len()):
                if terms[t] == row.a: slot = t; break
            if slot < 0:
                if terms.len() >= 32: continue
                slot = terms.len()
                terms.push(row.a)
                distances.push(value)
                pending.push(slot)
            else if value < distances[slot]:
                distances[slot] = value
                pending.push(slot)
        visits += s.differences.len() - 1 - previous
    best

# Rows for a sum of two symbolic operands, v = a + b, through terms already
# evaluated (a guard's `first+n <=? xs.length`, a range's `n-col`): with
# w = a + c, b - c <= d gives v - w <= d; with t = c - a, b - t <= d gives
# v - c <= d (each mirrored). Found before v exists, so a bounded sum is no
# possible wrap. O(terms) candidates, two bounded relaxations each.
fact_sum_rows = (s: FactState, a: int, b: int) -> FactDifference[]:
    rows: FactDifference[]
    loop i in [0..s.ids.len()):
        t = s.ids[i]
        term = fact_terms[t]
        if term.a == 0 or term.b == 0: continue
        loop side in [0..2):
            mine = if side == 0: a else: b
            other = if side == 0: b else: a
            if term.op == .plus and (term.a == mine or term.b == mine):
                c = if term.a == mine: term.b else: term.a
                up = fact_shortest(s, other, c)
                if up != FACT_MAX: rows.push(FactDifference(0, t, up))
                down = fact_shortest(s, c, other)
                if down != FACT_MAX: rows.push(FactDifference(t, 0, down))
            else if term.op == .minus and term.b == mine:
                up = fact_shortest(s, other, t)
                if up != FACT_MAX: rows.push(FactDifference(0, term.a, up))
                down = fact_shortest(s, t, other)
                if down != FACT_MAX: rows.push(FactDifference(term.a, 0, down))
            if rows.len() >= 8: return rows
    rows

# Selected affine rows share a single symbolic root. Normalize only on query,
# with a 32-node budget; unrelated roots and nonlinear products stay unknown.
struct FactAffine:
    root: int = 0
    scale: int = 0
    offset: int = 0
    valid: bool = true

fact_affine = (s: FactState, v: int, budget: mut int) -> FactAffine:
    budget -= 1
    if v == 0 or budget < 0: return FactAffine(valid = false)
    bound = fact_bound(s, v)
    if bound.lo == bound.hi: return FactAffine(offset = bound.lo)
    t = fact_terms[v]
    if t.op != .plus and t.op != .minus and t.op != .star: return FactAffine(v, 1)
    a = fact_affine(s, t.a, budget)
    b = fact_affine(s, t.b, budget)
    if not a.valid or not b.valid: return FactAffine(valid = false)
    if t.op == .star:
        if a.root == 0:
            swap = a; a = b; b = swap
        if b.root != 0 or math_word_overflow(2, a.scale, b.offset) or math_word_overflow(2, a.offset, b.offset): return FactAffine(valid = false)
        return FactAffine(a.root, a.scale * b.offset, a.offset * b.offset)
    if a.root != 0 and b.root != 0 and a.root != b.root: return FactAffine(valid = false)
    if t.op == .minus:
        if b.scale == FACT_MIN or b.offset == FACT_MIN: return FactAffine(valid = false)
        b.scale = -b.scale; b.offset = -b.offset
    if not fact_add_fits(a.scale, b.scale) or not fact_add_fits(a.offset, b.offset): return FactAffine(valid = false)
    FactAffine((if a.root != 0: a.root else: b.root), a.scale + b.scale, a.offset + b.offset)

fact_affine_compare = (s: FactState, op: Tok, av: int, bv: int) -> int:
    budget = 32
    a = fact_affine(s, av, budget)
    b = fact_affine(s, bv, budget)
    if not a.valid or not b.valid or a.root != b.root: return -1
    if b.scale == FACT_MIN or b.offset == FACT_MIN: return -1
    if not fact_add_fits(a.scale, -b.scale) or not fact_add_fits(a.offset, -b.offset): return -1
    scale = a.scale - b.scale
    offset = a.offset - b.offset
    domain = if a.root == 0: FactBound(0, 0) else: fact_bound(s, a.root)
    if math_word_overflow(2, domain.lo, scale) or math_word_overflow(2, domain.hi, scale): return -1
    low = min(domain.lo * scale, domain.hi * scale)
    high = max(domain.lo * scale, domain.hi * scale)
    if not fact_add_fits(low, offset) or not fact_add_fits(high, offset): return -1
    low += offset; high += offset
    if op == .lt:
        if high < 0: return 1
        if low >= 0: return 0
    if op == .le:
        if high <= 0: return 1
        if low > 0: return 0
    if op == .eq:
        if low == 0 and high == 0: return 1
        if high < 0 or low > 0: return 0
    -1

fact_compare = (s: FactState, op: Tok, a: int, b: int) -> int:
    x = fact_bound(s, a)
    y = fact_bound(s, b)
    if x.wide or y.wide: return -1
    # Intervals already decide separated or singleton ranges. Do not search
    # predicates and relation rows for an answer the endpoints give directly.
    if op == .eq or op == .ne:
        if x.hi < y.lo or y.hi < x.lo or x.nz and y.lo == 0 and y.hi == 0 or y.nz and x.lo == 0 and x.hi == 0: return int(op == .ne)
        if x.lo == x.hi and y.lo == y.hi: return int((x.lo == y.lo) == (op == .eq))
    else if op == .lt:
        if x.hi < y.lo: return 1
        if x.lo >= y.hi and (x.lo != FACT_MIN or fact_host_endpoint(s, a, false)) and (y.hi != FACT_MAX or fact_host_endpoint(s, b, true)): return 0
    else if op == .le:
        if x.hi <= y.lo and (x.hi != FACT_MAX or fact_host_endpoint(s, a, true)) and (y.lo != FACT_MIN or fact_host_endpoint(s, b, false)): return 1
        if x.lo > y.hi: return 0
    else if op == .gt:
        if x.lo > y.hi: return 1
        if x.hi <= y.lo and (x.hi != FACT_MAX or fact_host_endpoint(s, a, true)) and (y.lo != FACT_MIN or fact_host_endpoint(s, b, false)): return 0
    else if op == .ge:
        if x.lo >= y.hi and (x.lo != FACT_MIN or fact_host_endpoint(s, a, false)) and (y.hi != FACT_MAX or fact_host_endpoint(s, b, true)): return 1
        if x.hi < y.lo: return 0
    if a != 0 and b != 0:
        loop i in [0..s.ids.len()):
            term = fact_terms[s.ids[i]]
            if term.a == a and term.b == b and term.op == op and s.bounds[i].lo == s.bounds[i].hi: return int(s.bounds[i].lo != 0)
    if op == .gt: return fact_compare(s, .lt, b, a)
    if op == .ge: return fact_compare(s, .le, b, a)
    if op == .ne:
        r = fact_compare(s, .eq, a, b)
        return if r < 0: -1 else: 1 - r
    if a != 0 and a == b: return if op == .lt: 0 else: 1
    if op == .lt and fact_distance(s, a, b, -1): return 1
    if op == .lt and fact_distance(s, b, a, 0): return 0
    if op == .le and fact_distance(s, a, b, 0): return 1
    if op == .le and fact_distance(s, b, a, -1): return 0
    if op == .eq:
        if fact_distance(s, a, b, 0) and fact_distance(s, b, a, 0): return 1
        if fact_distance(s, a, b, -1) or fact_distance(s, b, a, -1): return 0
        if x.hi < y.lo or y.hi < x.lo: return 0
        if x.nz and y.lo == 0 and y.hi == 0 or y.nz and x.lo == 0 and x.hi == 0: return 0
        if x.lo == x.hi and y.lo == y.hi: return int(x.lo == y.lo)
    if op == .lt:
        if x.hi < y.lo: return 1
        if x.lo >= y.hi and (x.lo != FACT_MIN or fact_host_endpoint(s, a, false)) and (y.hi != FACT_MAX or fact_host_endpoint(s, b, true)): return 0
    if op == .le:
        if x.hi <= y.lo and (x.hi != FACT_MAX or fact_host_endpoint(s, a, true)) and (y.lo != FACT_MIN or fact_host_endpoint(s, b, false)): return 1
        if x.lo > y.hi: return 0
    fact_affine_compare(s, op, a, b)

fact_inverse = (op: Tok) -> Tok:
    if op == .eq: return .ne
    if op == .ne: return .eq
    if op == .lt: return .ge
    if op == .le: return .gt
    if op == .gt: return .le
    .lt

fact_set_bound = (s: mut FactState, v: int, b0: FactBound):
    i = fact_slot(s, v)
    if i < 0: return
    b = b0
    if b.lo > b.hi or b.nz and b.lo == 0 and b.hi == 0: s.live = false
    # Nonzero at an interval endpoint excludes it: `n not=? 0` with `n >=? 0`
    # is `n >=? 1` (an early-returned empty length makes `xs[0]`, `xs[end]` safe).
    else if b.nz and b.lo == 0: b.lo = 1
    else if b.nz and b.hi == 0: b.hi = -1
    s.bounds[i] = b

# Assume the CAPTURED Boolean, never reevaluate its syntax after later effects.
fact_assume = (s: mut FactState, v: int, truth: bool):
    if v == 0: return
    known = fact_truth(s, v)
    if known >= 0 and (known == 1) != truth: s.live = false
    t = fact_terms[v]
    fact_set_bound(s, v, FactBound(int(truth), int(truth), truth))
    if t.op == .kw_not:
        fact_assume(s, t.a, not truth)
        return
    if not fact_comparison(t.op): return
    op = if truth: t.op else: fact_inverse(t.op)
    a = t.a
    b = t.b
    if op == .gt or op == .ge:
        a = t.b
        b = t.a
        op = if op == .gt: Tok.lt else: Tok.le
    x = fact_bound(s, a)
    y = fact_bound(s, b)
    # A true comparison can bring an exact offset back into the host domain.
    # Require its opposite endpoint to be strictly inside that domain: an
    # endpoint at MIN/MAX may stand for an unbounded side of a wide value.
    if op == .eq:
        if x.wide and not y.wide: x = y; fact_set_bound(s, a, x)
        else if y.wide and not x.wide: y = x; fact_set_bound(s, b, y)
    else if op == .lt or op == .le:
        if x.wide and not y.wide and x.lo > FACT_MIN:
            x.hi = y.hi
            x.wide = false
            fact_set_bound(s, a, x)
        if y.wide and not x.wide and y.hi < FACT_MAX:
            y.lo = x.lo
            y.wide = false
            fact_set_bound(s, b, y)
    if x.wide or y.wide: return
    if op == .eq:
        fact_difference(s, a, b, 0, t.origin)
        fact_difference(s, b, a, 0, t.origin)
        lo = max(x.lo, y.lo)
        hi = min(x.hi, y.hi)
        x.lo = lo; y.lo = lo; x.hi = hi; y.hi = hi
        x.nz = x.nz or y.nz; y.nz = x.nz
    else if op == .ne:
        # A disequality tightens an already ordered symbolic pair too.
        # The existing bounded indexed path query supplies the ordering.
        if x.lo != x.hi and y.lo != y.hi:
            if fact_distance(s, a, b, 0): fact_difference(s, a, b, -1, t.origin)
            else if fact_distance(s, b, a, 0): fact_difference(s, b, a, -1, t.origin)
        if y.lo == 0 and y.hi == 0: x.nz = true
        if x.lo == 0 and x.hi == 0: y.nz = true
        # (a constant at an interval's end moves that end inward: `x not=? MAX`
        # leaves room for x+1, `r not=? -1` with r >=? -1 makes r >=? 0)
        if y.lo == y.hi and x.lo < x.hi:
            if x.lo == y.lo: x.lo += 1
            else if x.hi == y.lo: x.hi -= 1
        else if x.lo == x.hi and y.lo < y.hi:
            if y.lo == x.lo: y.lo += 1
            else if y.hi == x.lo: y.hi -= 1
    else if op == .lt or op == .le:
        d = if op == .lt: 1 else: 0
        fact_difference(s, a, b, -d, t.origin)
        if d == 1 and (y.hi == FACT_MIN or x.lo == FACT_MAX): s.live = false
        else:
            x.hi = min(x.hi, y.hi - d)
            y.lo = max(y.lo, x.lo + d)
    fact_set_bound(s, a, x)
    fact_set_bound(s, b, y)
    if op == .lt or op == .le:
        fact_offset_narrow(s, a, x)
        fact_offset_narrow(s, b, y)

# A compared offset `i+c` (or `i-c`) narrows i too: `i+1 <? stop` bounds i
# below stop-1, so a counter guarded at an offset stays below a length. O(1).
fact_offset_narrow = (s: mut FactState, v: int, b: FactBound):
    t = fact_terms[v]
    if t.op != .plus and t.op != .minus or t.a == 0 or t.b == 0: return
    c = fact_bound(s, t.b)
    if c.lo != c.hi or c.lo == FACT_MIN or c.lo == FACT_MAX: return
    k = if t.op == .plus: c.lo else: -c.lo
    x = fact_bound(s, t.a)
    if x.reason == .budget and x.lo == FACT_MIN and x.hi == FACT_MAX: return
    if b.hi != FACT_MAX and fact_add_fits(b.hi, -k): x.hi = min(x.hi, b.hi - k)
    if b.lo != FACT_MIN and fact_add_fits(b.lo, -k): x.lo = max(x.lo, b.lo - k)
    fact_set_bound(s, t.a, x)

# Publish an arm's scalar result, including its incident difference rows.
# O(incident rows), indexed and capped by the existing fact-row budget. Only
# demanded if-expressions use this; no all-pairs closure or new candidate scan.
fact_selected = (s: mut FactState, selected: int, value: int, at: int):
    if not s.live or value == 0: return
    fact_set_bound(s, selected, fact_bound(s, value))
    loop direction in [0..2):
        ri = fact_difference_head(s, value, direction)
        rows: FactDifference[]
        loop ri >= 0:
            rows.push(s.differences[ri])
            ri = fact_difference_next(s, ri, direction)
        loop row in rows:
            fact_difference(s, (if row.a == value: selected else: row.a), (if row.b == value: selected else: row.b), row.limit, at)
    fact_difference(s, selected, value, 0, at)
    fact_difference(s, value, selected, 0, at)

# Join only candidate rows touching a demanded scalar result. The peer may
# prove them by intervals as well as graph paths (e.g. the constant arm of
# `if n < 12: n else: 12`). O(incident rows x bounded entailment).
fact_selected_rows = (s: mut FactState, arm: FactState, peer: FactState, selected: int):
    if not arm.live or not peer.live: return
    loop direction in [0..2):
        ri = fact_difference_head(arm, selected, direction)
        loop ri >= 0:
            row = arm.differences[ri]
            ri = fact_difference_next(arm, ri, direction)
            if fact_slot(s, row.a) < 0 or fact_slot(s, row.b) < 0: continue
            if fact_entails(peer, row.a, row.b, row.limit): fact_difference(s, row.a, row.b, row.limit, row.at)

fact_hull = (a: FactBound, b: FactBound, at: int) -> FactBound:
    FactBound(min(a.lo, b.lo), max(a.hi, b.hi), (a.nz or a.lo > 0 or a.hi < 0) and (b.nz or b.lo > 0 or b.hi < 0), fact_hull_reason(at), at, a.wide or b.wide)

fact_hull_reason = (at: int) -> FactReason:
    if at != 0 and (nodes[at].kind == .while_ or nodes[at].kind == .for_): FactReason.loop_ else: FactReason.join

# Every value's interval hulled at once: the reason is the join point's.
fact_hull_all = (s: mut FactState, a: FactState, b: FactState, count: int, at: int):
    reason = fact_hull_reason(at)
    loop i in [0..count):
        x = a.bounds[i]
        y = b.bounds[i]
        if x == y: continue
        s.bounds[i] = FactBound(min(x.lo, y.lo), max(x.hi, y.hi), (x.nz or x.lo > 0 or x.hi < 0) and (y.nz or y.lo > 0 or y.hi < 0), reason, at, x.wide or y.wide)

# A phi keeps a shared representation, including a fixed word's finite
# endpoints and uint64's biased encoding. Bounds still join independently.
# O(1); never recover a fixed type from only one predecessor.
# Different representations whose values both have finite host endpoints (a
# fixed signed or narrow word, a singleton) share int64's: the hull is finite.
# uint64's biased encoding joins only itself. O(1) per differing binding.
fact_join_term = (sa: FactState, a: int, sb: FactState, b: int) -> FactTerm:
    t = fact_terms[a].type
    if t == fact_terms[b].type: return FactTerm(type = t)
    FactTerm(type = if fact_signed_host(sa, a) and fact_signed_host(sb, b): T_INT else: 0)

# A finite host value whose bounds are not uint64's biased encoding. O(1).
fact_signed_host = (s: FactState, v: int) -> bool:
    fact_type(fact_terms[v].type) != T_U64 and fact_host_value(s, v)

# A value hull (a conditional expression, coalescing, match arms) keeps its
# static type unless that is mathematical int and both incoming values have
# finite host endpoints; then the hull is a finite int64 value. Bounded by
# the incident rows fact_host_endpoint inspects; evaluated once per hull.
fact_hull_type = (t: int, sa: FactState, a: int, sb: FactState, b: int) -> int:
    if fact_type(t) != T_MATH_INT or not fact_host_finite(sa, a) or not fact_host_finite(sb, b): return t
    T_INT

fact_host_finite = (s: FactState, v: int) -> bool:
    if v == 0 or fact_type(fact_terms[v].type) == T_U64: return false
    fact_host_value(s, v) or fact_host_endpoint(s, v, false) and fact_host_endpoint(s, v, true)

fact_join = (a: FactState, b: FactState, at: int) -> FactState:
    if not a.live: return b
    if not b.live: return a
    # Identical frames need only an interval hull. In particular, branching
    # on a captured guard need not rebuild every immutable projection index.
    if a.ids == b.ids and a.bindings == b.bindings and a.projections == b.projections and a.differences == b.differences and a.conditional == b.conditional:
        s = a
        s.full = false
        fact_hull_all(s, a, b, s.bounds.len(), at)
        return s
    s = FactState()
    if a.conditional.len() > 0 and b.conditional.len() > 0:
        evidence_index: {ResultEvidence: bool} = {}
        loop evidence in b.conditional: evidence_index[evidence] = true
        loop evidence in a.conditional:
            if evidence_index.has(evidence): s.conditional.push(evidence)
    # Keep immutable evaluations shared by both paths, including snapshots.
    shared = true
    if a.ids == b.ids:
        s.ids = a.ids
        s.index[0].slots = a.index[0].slots
        s.bounds = a.bounds
        fact_hull_all(s, a, b, s.bounds.len(), at)
    else:
        # Both paths usually extend one entry frame with their own values: the
        # shared values are then a's prefix, kept with a's index. O(V).
        k = 0
        common = min(a.ids.len(), b.ids.len())
        loop k < common and a.ids[k] == b.ids[k]: k += 1
        prefix = true
        loop i in [k..a.ids.len()):
            if fact_slot(b, a.ids[i]) >= 0: prefix = false; break
        if prefix:
            s.ids = a.ids
            s.ids.truncate(k)
            s.bounds = a.bounds
            s.bounds.truncate(k)
            s.index[0].slots = a.index[0].slots
            fact_hull_all(s, a, b, k, at)
        else:
            shared = false
            loop i in [0..a.ids.len()):
                j = fact_slot(b, a.ids[i])
                if j >= 0: fact_add_value(s, a.ids[i], fact_hull(a.bounds[i], b.bounds[j], at))
    # When one path's projections are the other's first ones (the other path
    # only added projections), the shared projections are exactly the shorter
    # list: keep it with its index. O(P) comparisons, no hashing.
    kp = 0
    common_projections = min(a.projections.len(), b.projections.len())
    loop kp < common_projections and a.projections[kp] == b.projections[kp]: kp += 1
    from = -1
    if shared and (kp == a.projections.len() or kp == b.projections.len()):
        from = if kp == b.projections.len(): 1 else: 0
        shorter = if from == 1: b.projections else: a.projections
        loop p in shorter:
            if fact_slot(s, p.base) < 0 or fact_slot(s, p.value) < 0: from = -1; break
    if from >= 0:
        source = if from == 1: b else: a
        s.projections = source.projections
        s.index[0].projection_index = source.index[0].projection_index
        s.index[0].projection_head = source.index[0].projection_head
        s.index[0].projection_tail = source.index[0].projection_tail
        s.index[0].projection_next = source.index[0].projection_next
        s.index[0].projection_value = source.index[0].projection_value
    else:
        # (b holds p when p is on b's chain for p.base: every projection is chained)
        loop p in a.projections:
            if fact_slot(s, p.base) < 0 or fact_slot(s, p.value) < 0: continue
            qi = fact_index_get(b.index[0].projection_head, p.base)
            loop qi >= 0:
                if b.projections[qi] == p: break
                qi = b.index[0].projection_next[qi]
            if qi >= 0: fact_add_projection(s, p)
    if a.bindings == b.bindings and a.projections == b.projections:
        s.bindings = a.bindings
        s.index[0].roots = a.index[0].roots
        fact_join_shared_rows(s, a, b)
        return s
    renamed = false
    left: int[]
    right: int[]
    merged: int[]
    # (merged value pairs: a scan while few, then an open-address index;
    # values are below 2^31)
    pairs: int[]
    # Both paths keep their common ancestor's bindings in its order (a place
    # is appended when first bound): the aligned positions merge in place,
    # keeping a's positions and so a's root index. O(1) each, no hashing
    # unless the values differ.
    aligned = 0
    common = min(a.bindings.len(), b.bindings.len())
    loop aligned < common and a.bindings[aligned].place == b.bindings[aligned].place: aligned += 1
    s.bindings = a.bindings
    s.bindings.truncate(aligned)
    s.index[0].roots = a.index[0].roots
    loop i in [0..aligned):
        binding = a.bindings[i]
        other = b.bindings[i].value
        v = binding.value
        if v != other: renamed = true
        pair = fact_pair_key(v, other)
        prior = fact_pair_find(left, right, pairs, v, other)
        if prior >= 0: v = merged[prior]
        else if v != other: v = fact_new(s, fact_hull(fact_bound(a, v), fact_bound(b, other), at), fact_join_term(a, v, b, other))
        # (the tombstone survives when both paths share it)
        r = if v == binding.value and b.bindings[i].event == binding.event and binding.event != 0: binding else: FactBinding(binding.place, v)
        if r != binding: s.bindings[i] = r
        if prior < 0:
            fact_pair_add(left, right, pairs, pair)
            left.push(binding.value); right.push(other); merged.push(v)
    loop ai in [aligned..a.bindings.len()):
        binding = a.bindings[ai]
        j = fact_binding(b, binding.place)
        if j < 0: continue
        other = b.bindings[j].value
        v = binding.value
        if v != other: renamed = true
        pair = fact_pair_key(v, other)
        prior = fact_pair_find(left, right, pairs, v, other)
        if prior >= 0: v = merged[prior]
        else if v != other: v = fact_new(s, fact_hull(fact_bound(a, v), fact_bound(b, other), at), fact_join_term(a, v, b, other))
        fact_bind(s, binding.place, v)
        if v == binding.value and b.bindings[j].event == binding.event: fact_rebind(s, binding.place, v, binding.event, binding.prior)
        if prior < 0:
            fact_pair_add(left, right, pairs, pair)
            left.push(binding.value); right.push(other); merged.push(v)
    # Match projections of merged aggregate values, including current lengths.
    # (each side's non-element projections chained by base value, in order:
    # the same matches as scanning both lists for every merged value)
    cursor = 0
    element_keys: {(int, int): int} = {}
    element_keys_ready = false
    loop cursor < merged.len() and merged.len() < FACT_CAP:
        pi = fact_index_get(a.index[0].projection_head, left[cursor])
        loop pi >= 0:
            p = a.projections[pi]
            pi = a.index[0].projection_next[pi]
            selector = p.selector
            qi = fact_index_get(b.index[0].projection_index, fact_projection_key(right[cursor], selector, p.element))
            if p.element:
                key = fact_bound(a, selector)
                if key.lo == key.hi and not key.wide:
                    # Constants created separately in the arms have different
                    # value IDs. Index the peer's constant selectors once, O(P).
                    if not element_keys_ready:
                        loop j in [0..b.projections.len()):
                            candidate = b.projections[j]
                            if not candidate.element: continue
                            cb = fact_bound(b, candidate.selector)
                            if cb.lo == cb.hi and not cb.wide: element_keys[(candidate.base, cb.lo)] = j
                        element_keys_ready = true
                    qi = element_keys.get((right[cursor], key.lo)) ?? -1
                    if qi >= 0 and fact_slot(s, selector) < 0: selector = fact_constant(s, key.lo)
                else if fact_slot(s, selector) < 0: continue
            if qi < 0: continue
            q = b.projections[qi]
            if merged.len() >= FACT_CAP: break
            v = p.value
            if v != q.value: renamed = true
            pair = fact_pair_key(v, q.value)
            prior = fact_pair_find(left, right, pairs, v, q.value)
            if prior >= 0: v = merged[prior]
            else if v != q.value: v = fact_new(s, fact_hull(fact_bound(a, v), fact_bound(b, q.value), at), fact_join_term(a, v, b, q.value))
            if s.projections.len() < FACT_CAP: fact_add_projection(s, FactProjection(merged[cursor], selector, p.element, v))
            if prior < 0:
                fact_pair_add(left, right, pairs, pair)
                left.push(p.value); right.push(q.value); merged.push(v)
        cursor += 1
    if a.differences.len() == 0 and b.differences.len() == 0: return s
    # (renamings: the last pair naming a value wins)
    left_merge: int[]; right_merge: int[]
    left_right: int[]; right_left: int[]
    if renamed and merged.len() > 32:
        loop i in [0..merged.len()):
            fact_index_put(left_merge, left[i], merged[i]); fact_index_put(right_merge, right[i], merged[i])
            fact_index_put(left_right, left[i], right[i]); fact_index_put(right_left, right[i], left[i])
    # A shared prefix consists of facts already present in both predecessors.
    # Keep its rows without proving each one again or recounting incidents.
    # Endpoints must survive in the common frame; renamed rows still follow.
    common_rows = 0
    loop common_rows < min(a.differences.len(), b.differences.len()):
        row = a.differences[common_rows]
        if row != b.differences[common_rows] or fact_slot(s, row.a) < 0 or fact_slot(s, row.b) < 0: break
        common_rows += 1
    if common_rows == a.differences.len():
        s.differences = a.differences
        s.index[0].difference_index = a.index[0].difference_index
        s.index[0].difference_value = a.index[0].difference_value
        s.index[0].difference_record = a.index[0].difference_record
        s.index[0].difference_next = a.index[0].difference_next
    else:
        loop i in [0..common_rows): fact_add_difference(s, a.differences[i])
    # Select rows from either predecessor, rename into the merge frame, and
    # require a proof from the other. Branch-local evaluations never escape.
    # (a row its renaming leaves as it is was just offered as it is: when
    # that offer held, the renamed one is the same call again, skipped. A
    # renamed endpoint equal to the original renames to it on the other side
    # too, or to nothing)
    loop ri in [0..a.differences.len()):
        row = a.differences[ri]
        kept = ri < common_rows or fact_slot(s, row.a) >= 0 and fact_slot(s, row.b) >= 0 and fact_distance(b, row.a, row.b, row.limit)
        if kept and ri >= common_rows: fact_difference(s, row.a, row.b, row.limit, row.at)
        if not renamed: continue
        aa = fact_rename(row.a, left, merged, left_merge, s)
        bb = fact_rename(row.b, left, merged, left_merge, s)
        if kept and aa == row.a and bb == row.b: continue
        ra = fact_rename(row.a, left, right, left_right, b)
        rb = fact_rename(row.b, left, right, left_right, b)
        if aa != 0 and bb != 0 and fact_distance(b, ra, rb, row.limit): fact_difference(s, aa, bb, row.limit, row.at)
    # (a tighter row on one side can replace the row the other side shares)
    loop ri in [0..b.differences.len()):
        row = b.differences[ri]
        kept = ri < common_rows or fact_slot(s, row.a) >= 0 and fact_slot(s, row.b) >= 0 and fact_distance(a, row.a, row.b, row.limit)
        if kept and ri >= common_rows: fact_difference(s, row.a, row.b, row.limit, row.at)
        if not renamed: continue
        aa = fact_rename(row.a, right, merged, right_merge, s)
        bb = fact_rename(row.b, right, merged, right_merge, s)
        if kept and aa == row.a and bb == row.b: continue
        ra = fact_rename(row.a, right, left, right_left, a)
        rb = fact_rename(row.b, right, left, right_left, a)
        if aa != 0 and bb != 0 and fact_distance(a, ra, rb, row.limit): fact_difference(s, aa, bb, row.limit, row.at)
    s

# v renamed through the last i with from[i] == v (an index once there are many).
fact_rename = (v: int, from: int[], to: int[], index: int[], shared: FactState) -> int:
    if index.len() != 0:
        value = fact_index_get(index, v)
        if value >= 0: return value
    else:
        i = from.len() - 1
        loop i >= 0:
            if from[i] == v: return to[i]
            i -= 1
    if fact_slot(shared, v) >= 0: return v
    0

# The first merged pair (v, other): a scan over at most 32, then indexed.
fact_pair_find = (left: int[], right: int[], index: int[], v: int, other: int) -> int:
    if index.len() != 0: return fact_index_get(index, fact_pair_key(v, other))
    loop i in [0..left.len()):
        if left[i] == v and right[i] == other: return i
    -1

fact_pair_add = (left: int[], right: int[], index: mut int[], pair: int):
    if index.len() == 0 and left.len() >= 32:
        index = fact_index_sized(64)
        loop i in [0..left.len()):
            key = fact_pair_key(left[i], right[i])
            if fact_index_get(index, key) < 0: fact_index_put(index, key, i)
    if index.len() != 0: fact_index_put(index, pair, left.len())

fact_unknown = (n: int, b: FactBound, what: str = "assertion", contract: int = 0): wit_unknown(n, b, what, contract)

fact_field_node = (e: int) -> bool:
    nodes[e].kind == .field and (nodes[e].aux >= 0 and tkind(ntype(int(nodes[e].a))) == .struct_ or nodes[e].aux == -2 and tkind(ntype(int(nodes[e].a))) == .tuple)

# Pre-kill one changing route `root.f…[i]…`. Its root gets a fresh value that
# keeps what the route cannot change: sibling fields along it, and the length
# of the first array whose elements it writes. Everything at and below the
# written element (or, with `resize`, the route's own value) is unknown.
fact_change_route = (s: mut FactState, target: int, resize: bool, at: int, reason: FactReason):
    if target != 0 and nodes[target].kind == .hole: return
    if target != 0 and nodes[target].kind == .tuple:
        loop c in kids(target): fact_change_route(s, c, resize, at, reason)
        return
    chain: int[]
    e = target
    depth = 0
    loop e != 0 and depth < 32:
        depth += 1
        if fact_field_node(e) or nodes[e].kind == .index and nodes[e].b != 0:
            chain.push(e)
            e = int(nodes[e].a)
        # (an element alias, `loop @x in xs`, writes the place it names)
        else if nodes[e].kind == .ident and nodes[e].aux == i32(int(SK.local)) and int(locals[int(nodes[e].sym)].flags) & LF_ALIAS != 0 and locals[int(nodes[e].sym)].alias != 0:
            e = int(locals[int(nodes[e].sym)].alias)
        else: break
    p = fact_place(e)
    if e == 0 or nodes[e].kind != .ident or p.declaration == 0:
        fact_forget(s, at, reason, true)
        return
    # (the root's own prior value first: forgetting exposed roots replaces it)
    i = fact_binding(s, p)
    old = if i >= 0: s.bindings[i].value else: 0
    if fact_exposed(p): fact_forget(s, at, reason, false, p)
    fresh = fact_new(s, fact_domain(ntype(e), reason, at), FactTerm(type = ntype(e)))
    fact_holds_contract(s, refine_storage(e, ntype(e)), fresh)
    fact_bind(s, p, fresh)
    j = chain.len() - 1
    loop j >= 0 and old != 0 and fresh != 0:
        c = chain[j]
        if nodes[c].kind == .index:
            t = fact_type(ntype(int(nodes[c].a)))
            if types[t].kind != .array and types[t].kind != .fixed: return
            # (an element write never resizes the array it indexes)
            if types[t].kind == .fixed: return
            # (the length of the old value is an evaluation too, even if unread so far)
            length = fact_project(s, old, -1, false, T_INT)
            if length != 0 and s.projections.len() < FACT_CAP: fact_add_projection(s, FactProjection(fresh, -1, false, length))
            return
        selector = if nodes[c].aux == -2: int(nodes[c].ival) else: int(nodes[c].name)
        child = 0
        kept: FactProjection[]
        qi = fact_index_get(s.index[0].projection_head, old)
        loop qi >= 0:
            q = s.projections[qi]
            qi = s.index[0].projection_next[qi]
            if q.element: continue
            if q.selector == selector: child = q.value
            else: kept.push(FactProjection(fresh, q.selector, false, q.value))
        loop q in kept:
            if s.projections.len() < FACT_CAP: fact_add_projection(s, q)
        if j == 0 and resize: return
        t = refine_storage(c, ntype(c))
        if child == 0: child = fact_project(s, old, selector, false, t)
        if child == 0: return
        next = fact_new(s, fact_domain(t, reason, at), FactTerm(type = t))
        if s.projections.len() < FACT_CAP: fact_add_projection(s, FactProjection(fresh, selector, false, next))
        old = child
        fresh = next
        j -= 1

fact_pure_intrinsic = (id: IN) -> bool:
    id == .sqrt or id == .vec_ctor or id == .floor_ or id == .ceil_ or id == .fabs or id == .fmin or id == .fmax or id == .mul_hi

# Text joins and comparisons (2) and vector and matrix arithmetic (7 to 11:
# expr.jo check_vec_binary) read their operands and write nothing.
fact_pure_binary = (n: int) -> bool:
    aux = int(nodes[n].aux)
    aux == 2 or aux >= 7 and aux <= 11

# Numeric conversions between floats and integers write nothing.
fact_pure_conversion = (n: int) -> bool:
    aux = nodes[n].aux
    aux == i32(int(CV.int2float)) or aux == i32(int(CV.float2int)) or aux == i32(int(CV.float_)) or aux == i32(int(CV.wrap_int)) or aux == i32(int(CV.saturate_int))

fact_reads_only = (id: IN) -> bool:
    id == .len or id == .arrcap or id == .sizeof or id == .alignof or id == .static_assert or id == .runtime_assert or id == .assert or id == .panic or id == .unreachable or fact_pure_intrinsic(id)

# A remainder or nonnegative constant mask has an unconditional finite range.
# During loop havoc retain the hull with entry, so zero iterations and every
# other store remain covered. No speculative source bound is used. Only visited
# on the obligation's active slice; O(conversion depth), indexed binding access.
fact_bounded_change = (n: int, s: mut FactState, at: int, reason: FactReason) -> bool:
    if nodes[n].op != i32(int(Tok.assign)): return false
    target = int(nodes[n].a)
    if nodes[target].kind != .ident: return false
    p = fact_place(target)
    if p.declaration == 0 or fact_exposed(p) or fact_type(ntype(target)) == T_U64: return false
    rhs = fact_progress_strip(int(nodes[n].b))
    kind = 0
    operand = 0
    if nodes[rhs].kind == .binary and nodes[rhs].aux == 0 and nodes[rhs].op == i32(int(Tok.percent)) and files[pos_file(nodes[rhs].pos)].is_dewy and is_int(ntype(rhs)):
        kind = 2
        operand = int(nodes[rhs].b)
    else if nodes[rhs].kind == .binary and nodes[rhs].aux == 0 and nodes[rhs].op == i32(int(Tok.amp)) and is_int(ntype(rhs)):
        kind = 4
        operand = int(nodes[rhs].b)
        if nodes[fact_progress_strip(operand)].kind != .int_lit: operand = int(nodes[rhs].a)
    else if nodes[rhs].kind == .call:
        kind = fact_floor_call(rhs)
        if kind == 2 or kind == 4: operand = kid(rhs, 1)
    if operand == 0: return false
    divisor = fact_progress_strip(operand)
    if nodes[divisor].kind != .int_lit or oversized_literal(divisor): return false
    limit = nodes[divisor].ival
    if kind == 2 and limit == 0 or kind == 4 and limit < 0: return false
    low = if kind == 2 and limit < 0: limit + 1 else: 0
    high = if kind == 4: limit else if limit > 0: limit - 1 else: 0
    domain = fact_domain(ntype(target))
    if low < domain.lo or high > domain.hi: return false
    i = fact_binding(s, p)
    if i < 0: return false
    old = fact_bound(s, s.bindings[i].value)
    fact_change_route(s, target, false, at, reason)
    i = fact_binding(s, p)
    if i >= 0: fact_set_bound(s, s.bindings[i].value, fact_hull(old, FactBound(low, high), at))
    true

# Conservative loop fallback: pre-kill every syntactically changing route.
# This is also used for iterators whose backedge transfer is not modeled.
fact_changes = (n: int, s: mut FactState, at: int, reason: FactReason = .loop_):
    if n == 0: return
    if fact_slice_flags(n) & (FACT_MEMBER | FACT_ACTIVE) == FACT_MEMBER: return
    k = nodes[n].kind
    # (an element or field store havocs only its route within its root: fact_change_route)
    if k == .assign and not fact_bounded_change(n, s, at, reason): fact_change_route(s, int(nodes[n].a), false, at, reason)
    if k == .intrinsic:
        id = nodes[n].aux as IN
        if id == .push or id == .pop or id == .insert or id == .remove or id == .clear or id == .extend or id == .resize or id == .truncate or id == .setlen:
            fact_change_route(s, kid(n, 0), true, at, reason)
    # (a direct call havocs what its summary writes; reading lengths and
    # erased or failing assertions write nothing; a record is built in place)
    if k == .call and nodes[n].aux == 0: fact_call_effects(n, s)
    else if k == .call and nodes[n].aux == 2: s = s
    else if k == .intrinsic and fact_reads_only(nodes[n].aux as IN): s = s
    # (a closure's creation writes nothing: fact_capture)
    else if k == .call or k == .intrinsic or k == .lambda and ownership_decls.len() != 0 or k == .partial: fact_forget(s, at, reason)
    mask = isolation_children(k)
    if mask < 0: fact_forget(s, at, reason, true); return
    if mask & 1 != 0: fact_changes(int(nodes[n].a), s, at, reason)
    if mask & 2 != 0: fact_changes(int(nodes[n].b), s, at, reason)
    if mask & 4 != 0: fact_changes(int(nodes[n].c), s, at, reason)
    if mask & 16 != 0:
        loop c in kids(n): fact_changes(c, s, at, reason)

struct FactPaths:
    yes: FactState
    no: FactState
    reason: FactBound
    value: int = 0      # the captured comparison of a leaf condition
    entry: FactState = FactState(live = false)  # its state before assumption, for `$assert` diagnostics

# Split during evaluation: RHS effects see the appropriate LHS edge, and
# success can only narrow the old captured value, not its replacement.
fact_condition = (n: int, entry: FactState) -> FactPaths:
    k = nodes[n].kind
    if k == .not_:
        p = fact_condition(int(nodes[n].a), entry)
        return FactPaths(p.no, p.yes, p.reason)
    if k == .and_ or k == .or_:
        a = fact_condition(int(nodes[n].a), entry)
        b = fact_condition(int(nodes[n].b), if k == .and_: a.yes else: a.no)
        reason = if a.yes.live and a.no.live: a.reason else: b.reason
        if k == .and_: return FactPaths(b.yes, fact_join(a.no, b.no, n), reason)
        return FactPaths(fact_join(a.yes, b.yes, n), b.no, reason)
    yes = entry
    v = fact_capture(n, yes)
    no = yes
    reason = fact_bound(yes, v)
    entry_state = if fact_query: yes else: FactState(live = false)
    fact_assume(yes, v, true)
    fact_assume(no, v, false)
    if yes.conditional.len() > 0:
        result_activate(yes)
        result_activate(no)
    FactPaths(yes, no, reason, v, entry_state)

# Assume an optional's or union's tag is (or is not) wanted.
fact_tag = (s: mut FactState, value: int, wanted: int, truth: bool):
    if value == 0 or not s.live: return
    tag = fact_project(s, value, -3, false, T_INT)
    fact_assume(s, fact_new(s, fact_domain(T_BOOL), FactTerm(.eq, tag, fact_constant(s, wanted))), truth)
    if truth and s.conditional.len() > 0: result_activate(s)

# The tag one pattern establishes, or -1.
fact_pattern_tag = (p: int, st: int) -> int:
    k = nodes[p].kind
    if is_union(st) and k == .pvariant: return int(nodes[p].aux2)
    if is_union(st) and k == .plit: return int(nodes[p].aux2)
    if types[st].kind == .opt:
        if k == .ptype and nodes[p].aux2 != 1: return 1
        if k == .plit and nodes[int(nodes[p].a)].kind == .none_lit: return 0
    -1

fact_unmodeled = (s: mut FactState, n: int, reason: FactReason) -> int:
    b = if exact_has_node(n): FactBound(reason = reason, witness = n, wide = true) else: fact_domain(ntype(n), reason, n)
    if fact_query: fact_unknown(n, b)
    fact_new(s, b)

fact_add_fits = (a: int, b: int) -> bool:
    if b > 0: return a <= FACT_MAX - b
    if b < 0: return a >= FACT_MIN - b
    true

# The tightest bound on v that rows give through other terms' intervals
# (v - t <= d with t <= hi, or the mirror), over a bounded single-source
# search like fact_distance's.
fact_relational = (s: FactState, v: int, upper: bool) -> int:
    best = if upper: fact_bound(s, v).hi else: fact_bound(s, v).lo
    terms = [v]
    distances = [0]
    seen: {int: bool} = {v: true}
    cursor = 0
    visits = 0
    loop cursor < terms.len():
        source = terms[cursor]
        distance = distances[cursor]
        cursor += 1
        previous = -1
        ri = fact_difference_head(s, source, int(upper))
        loop ri >= 0:
            row = s.differences[ri]
            visits += ri - previous
            previous = ri
            ri = fact_difference_next(s, ri, int(upper))
            if visits > 256: return best
            if not fact_add_fits(distance, row.limit): continue
            other = if upper: row.b else: row.a
            value = distance + row.limit
            o = fact_bound(s, other)
            if upper and o.hi != FACT_MAX and fact_add_fits(o.hi, value): best = min(best, o.hi + value)
            if not upper and o.lo != FACT_MIN and value != FACT_MIN and fact_add_fits(o.lo, -value): best = max(best, o.lo - value)
            if not seen.has(other) and terms.len() < 32:
                seen[other] = true
                terms.push(other)
                distances.push(value)
        visits += s.differences.len() - 1 - previous
    best

fact_arithmetic = (s: mut FactState, n: int, op: Tok, a: int, b: int) -> int:
    if fact_type(ntype(n)) == T_U64: return exact_unsigned_fact(s, n, op, a, b)
    x = fact_bound(s, a); y = fact_bound(s, b)
    if x.wide or y.wide: return fact_unmodeled(s, n, .unsupported)
    if op != .star:
        # An interval beyond the host word may still be bounded through rows (a
        # lockstep counter stepping after its partner's guard).
        ylo = if op == .minus: (if y.hi == FACT_MAX: FACT_MIN else: -y.hi) else: y.lo
        yhi = if op == .minus: (if y.lo == FACT_MIN: FACT_MAX else: -y.lo) else: y.hi
        if not fact_add_fits(x.hi, yhi): x.hi = fact_relational(s, a, true)
        if not fact_add_fits(x.lo, ylo): x.lo = fact_relational(s, a, false)
        if op == .plus and not fact_add_fits(x.hi, y.hi): y.hi = fact_relational(s, b, true)
        if op == .plus and not fact_add_fits(x.lo, y.lo): y.lo = fact_relational(s, b, false)
        if op == .minus and not fact_add_fits(x.hi, yhi): y.lo = fact_relational(s, b, false)
        if op == .minus and not fact_add_fits(x.lo, ylo): y.hi = fact_relational(s, b, true)
    if op == .star:
        # Mathematical ints multiply exactly too. Two bounded variable
        # operands need the same four endpoint products as fixed exact ints.
        if not exact_has_node(n) and prune(ntype(n)) != T_MATH_INT and x.lo != x.hi and y.lo != y.hi: return fact_unmodeled(s, n, .unsupported)
        if math_word_overflow(2, x.lo, y.lo) or math_word_overflow(2, x.lo, y.hi) or math_word_overflow(2, x.hi, y.lo) or math_word_overflow(2, x.hi, y.hi): return fact_unmodeled(s, n, .unsupported)
        lo = min(min(x.lo * y.lo, x.lo * y.hi), min(x.hi * y.lo, x.hi * y.hi))
        hi = max(max(x.lo * y.lo, x.lo * y.hi), max(x.hi * y.lo, x.hi * y.hi))
        if not exact_has_node(n) and (not sa_fits(lo, ntype(n)) or not sa_fits(hi, ntype(n))): return fact_unmodeled(s, n, .unsupported)
        return fact_new(s, FactBound(lo, hi, lo > 0 or hi < 0), FactTerm(op, a, b, n, ntype(n)))
    # (two symbolic operands: the same sum again, or rows through terms
    # already evaluated, which can also bound it)
    sums: FactDifference[]
    if op == .plus and a != 0 and b != 0 and x.lo != x.hi and y.lo != y.hi:
        loop i in [0..s.ids.len()):
            t = fact_terms[s.ids[i]]
            if t.op == .plus and t.type == ntype(n) and (t.a == a and t.b == b or t.a == b and t.b == a): return s.ids[i]
        sums = fact_sum_rows(s, a, b)
    if op == .minus:
        if y.lo == FACT_MIN: return fact_unmodeled(s, n, .unsupported)
        lo = -y.hi
        y.hi = -y.lo
        y.lo = lo
    lo = FACT_MIN; hi = FACT_MAX
    low = fact_add_fits(x.lo, y.lo); high = fact_add_fits(x.hi, y.hi)
    if low: lo = x.lo + y.lo
    if high: hi = x.hi + y.hi
    # (a difference of two related values: `high - low` with `low <=? high`
    # is at least 0. Only for operands with rows: two bounded searches)
    if op == .minus and a != b and a != 0 and b != 0 and x.lo != x.hi and fact_incident(s, a) >= 0 and fact_incident(s, b) >= 0:
        d = fact_shortest(s, a, b)
        if d != FACT_MAX and (not high or d < hi): hi = d; high = true
        e = fact_shortest(s, b, a)
        if e != FACT_MAX and e != FACT_MIN and (not low or -e > lo): lo = -e; low = true
    loop r in sums:
        if r.a == 0:
            c = fact_bound(s, r.b)
            if c.hi != FACT_MAX and fact_add_fits(c.hi, r.limit) and (not high or c.hi + r.limit < hi):
                hi = c.hi + r.limit; high = true
        else:
            c = fact_bound(s, r.a)
            if c.lo != FACT_MIN and r.limit != FACT_MIN and fact_add_fits(c.lo, -r.limit) and (not low or c.lo - r.limit > lo):
                lo = c.lo - r.limit; low = true
    if not low or not high:
        if exact_has_node(n): return fact_new(s, FactBound(lo, hi, lo > 0 or hi < 0, wide = true), FactTerm(op, a, b, n, ntype(n)))
        return fact_unmodeled(s, n, .unsupported)
    if not exact_has_node(n) and (not sa_fits(lo, ntype(n)) or not sa_fits(hi, ntype(n))): return fact_unmodeled(s, n, .unsupported)
    # (`i+2` again names the value the last `i+2` made: a scanner's reads
    # `b[i] b[i+1] b[i+2]` and its guard `i+2 <? n` share rows instead of
    # spending i's incident rows. O(incident rows of a), at most 8)
    if y.lo == y.hi and y.lo != FACT_MIN:
        same = fact_offset_value(s, a, y.lo)
        if same != 0: return same
    value = fact_new(s, FactBound(lo, hi, lo > 0 or hi < 0), FactTerm(op, a, b, n, ntype(n)))
    loop r in sums: fact_difference(s, (if r.a == 0: value else: r.a), (if r.b == 0: value else: r.b), r.limit, n)
    if y.lo == y.hi and y.lo != FACT_MIN:
        fact_difference(s, value, a, y.lo, 0, 16)
        fact_difference(s, a, value, -y.lo, 0, 16)
    if op == .plus and x.lo == x.hi and x.lo != FACT_MIN:
        fact_difference(s, value, b, x.lo, 0, 16)
        fact_difference(s, b, value, -x.lo, 0, 16)
    value

# A value x with x - a = c exactly (rows both ways), or 0.
fact_offset_value = (s: FactState, a: int, c: int) -> int:
    if c == FACT_MIN: return 0
    ri = fact_difference_head(s, a, 0)
    loop ri >= 0:
        row = s.differences[ri]
        ri = fact_difference_next(s, ri, 0)
        if row.limit != c or row.a == a: continue
        back = fact_row_find(s, a, row.a)
        if back >= 0 and s.differences[back].limit == -c: return row.a
    0

fact_divisor = (s: mut FactState, n: int, a: int, b: int, modulo: bool) -> bool:
    operand = if nodes[n].kind == .call: kid(n, 1) else: int(nodes[n].b)
    # (an exact rational is zero when its numerator is: expr.jo rational_divisor)
    t = representation_type(ntype(operand))
    if types[t].kind == .struct_:
        numerator = fact_project(s, b, intern("numerator"), false, T_MATH_INT)
        nothing = fact_constant(s, 0)
        truth = fact_compare(s, .ne, numerator, nothing)
        if truth != 1: wit_divisor(n, s, numerator, nothing, operand, truth == 0)
        return truth == 1
    zero = fact_constant(s, ref_encoded(0, ntype(operand)))
    truth = fact_compare(s, .ne, b, zero)
    if truth != 1: wit_divisor(n, s, b, zero, operand, truth == 0)
    truth == 1

# Call only after excluding zero and MIN / -1. Jo divides toward zero;
# Dewy's floor quotient rounds downward when the signs differ. O(1).
fact_quotient = (a: int, b: int, floor: bool) -> int:
    q = a / b
    if floor and (a < 0) != (b < 0) and a % b != 0: q -= 1
    q

# Integer `//` and `%` by a nonzero divisor (kind 1, 2), or by a power of two
# as a shift count or mask (3, 4). Dewy's remainder has the divisor's sign, so
# `x % n` lies in [0, n) for positive n; Sloppy's truncating forms agree when the
# dividend is nonnegative. A nonnegative dividend bounds both results, and
# halving a positive one makes it smaller.
fact_floor = (s: mut FactState, n: int, kind: int, a: int, b: int, floor: bool) -> int:
    x = fact_bound(s, a); y = fact_bound(s, b)
    # A clipped host endpoint is not an upper bound on a wide intermediate.
    # Only floor remainder/masking can discard that unknown extent using the
    # finite divisor alone. Division and right shift must retain it.
    if y.wide or x.wide and (kind == 1 or kind == 3 or not floor): return fact_unmodeled(s, n, .unsupported)
    if x.lo < 1: x.lo = max(x.lo, fact_relational(s, a, false))
    # Shrinking an unbounded mathematical value does not make it a word.
    # Endpoint sentinels must not become finite merely by division/shift.
    if (kind == 1 or kind == 3) and (not fact_host_endpoint(s, a, false) or not fact_host_endpoint(s, a, true)): return fact_unmodeled(s, n, .unsupported)
    # (a shift count stays below the word; a mask is any nonnegative value)
    if kind == 3 or kind == 4:
        if y.lo < 0 or kind == 3 and y.hi > 62: return fact_unmodeled(s, n, .unsupported)
    else if kind == 1 and y.hi < 0:
        # The four corners bound division on a strictly negative denominator
        # interval. MIN / -1 is outside the host domain: decline, never wrap.
        if not fact_host_endpoint(s, b, false): return fact_unmodeled(s, n, .unsupported)
        if x.lo == FACT_MIN and y.hi == -1: return fact_unmodeled(s, n, .unsupported)
        ll = fact_quotient(x.lo, y.lo, floor)
        lh = fact_quotient(x.lo, y.hi, floor)
        hl = fact_quotient(x.hi, y.lo, floor)
        hh = fact_quotient(x.hi, y.hi, floor)
        low = min(min(ll, lh), min(hl, hh))
        high = max(max(ll, lh), max(hl, hh))
        return fact_new(s, FactBound(low, high, low > 0 or high < 0), FactTerm(type = ntype(n)))
    else if kind == 2 and floor and y.hi < 0:
        # Floor remainder has its divisor's sign, including for a wide
        # dividend: d < x % d <= 0. No negation of MIN is needed. O(1).
        if not fact_host_endpoint(s, b, false): return fact_unmodeled(s, n, .unsupported)
        return fact_new(s, FactBound(y.lo + 1, 0), FactTerm(.eof, a, b, n, ntype(n)))
    else if y.lo < 1: return fact_unmodeled(s, n, .unsupported)
    if x.lo < 0 and kind == 1 and not x.wide and not y.wide:
        low = x.lo / y.lo
        if floor and x.lo % y.lo != 0: low -= 1
        divisor = if x.hi < 0: y.hi else: y.lo
        high = x.hi / divisor
        if floor and x.hi < 0 and x.hi % divisor != 0: high -= 1
        return fact_new(s, FactBound(low, high, low > 0 or high < 0), FactTerm(type = ntype(n)))
    if x.lo < 0 and (not floor or kind == 1 or kind == 3): return fact_unmodeled(s, n, .unsupported)
    r = FactBound()
    if kind == 2 or kind == 4:
        r.lo = 0
        r.hi = if kind == 2 and fact_host_endpoint(s, b, true): y.hi - 1 else: y.hi
        if x.lo >= 0 and not x.wide: r.hi = min(r.hi, x.hi)
    else if kind == 1:
        r.lo = x.lo / y.hi
        r.hi = x.hi / y.lo
    else:
        r.lo = x.lo >> y.hi
        r.hi = x.hi >> y.lo
    v = fact_new(s, r, FactTerm(.eof, a, b, n, ntype(n)))
    fact_set_bound(s, v, r)
    if kind == 2: fact_difference(s, v, b, -1, n)
    if kind == 4: fact_difference(s, v, b, 0, n)
    smaller = kind == 1 and x.lo >= 1 and y.lo >= 2 or kind == 3 and x.lo >= 1 and y.lo >= 1
    if x.lo >= 0:
        distance = if kind == 1: x.lo / y.lo - x.lo else if kind == 3: (x.lo >> y.lo) - x.lo else if smaller: -1 else: 0
        fact_difference(s, v, a, distance, n)
    v

# uint64's forms on its order-preserving encoding (value xor MIN, so rows and
# comparisons between two uint64 values read as unsigned): every result is at
# most the dividend, `x % n` lies in [0, n) and a mask bounds `x & m`.
fact_floor_unsigned = (s: mut FactState, n: int, kind: int, a: int, b: int) -> int:
    x = fact_bound(s, a); y = fact_bound(s, b)
    if x.wide or y.wide: return fact_unmodeled(s, n, .unsupported)
    if (kind == 1 or kind == 2) and y.lo == FACT_MIN: return fact_unmodeled(s, n, .unsupported)
    if kind == 3 and (y.lo < 0 or y.hi > 63): return fact_unmodeled(s, n, .unsupported)
    r = FactBound(FACT_MIN, x.hi)
    if kind == 2: r.hi = min(x.hi, y.hi - 1)
    else if kind == 4: r.hi = min(x.hi, y.hi)
    else if kind == 1:
        r.lo = int(u64(x.lo xor FACT_MIN) / u64(y.hi xor FACT_MIN)) xor FACT_MIN
        r.hi = int(u64(x.hi xor FACT_MIN) / u64(y.lo xor FACT_MIN)) xor FACT_MIN
    else:
        r.lo = int(u64(x.lo xor FACT_MIN) >> u64(y.hi)) xor FACT_MIN
        r.hi = int(u64(x.hi xor FACT_MIN) >> u64(y.lo)) xor FACT_MIN
    v = fact_new(s, r, FactTerm(.eof, a, b, n, T_U64))
    if kind == 2: fact_difference(s, v, b, -1, n)
    if kind == 4: fact_difference(s, v, b, 0, n)
    fact_difference(s, v, a, 0, n)
    v

# Bit operations on nonnegative operands, one interval step each: a mask
# bounds `x & m` by m, `|` and `xor` stay below the next power of two of the
# larger operand, `>>` shrinks and `<<` grows within the result type (else a
# possible wrap). uint64 operands use the order-preserving encoding (value xor
# MIN); arithmetic bounds are converted before shifting or combining bits.
fact_bitwise = (s: mut FactState, n: int, op: Tok, a: int, b: int) -> int:
    x = fact_bound(s, a); y = fact_bound(s, b)
    # A finite nonnegative mask bounds even an arbitrarily wide exact operand.
    # Do not discard this proof just because the other side exceeded a word.
    if op == .amp and (x.wide or y.wide) and fact_type(ntype(n)) != T_U64:
        if not x.wide and x.lo >= 0 or not y.wide and y.lo >= 0:
            hi = if not x.wide and x.lo >= 0 and not y.wide and y.lo >= 0: min(x.hi, y.hi) else if not x.wide and x.lo >= 0: x.hi else: y.hi
            return fact_new(s, FactBound(0, hi), FactTerm(.eof, a, b, n, ntype(n)))
    if x.wide or y.wide: return fact_unmodeled(s, n, .unsupported)
    r = FactBound()
    if fact_type(ntype(n)) == T_U64:
        if fact_type(ntype(int(nodes[n].a))) != T_U64: return fact_unmodeled(s, n, .unsupported)
        if op == .amp and fact_type(ntype(int(nodes[n].b))) == T_U64:
            r = FactBound(FACT_MIN, min(x.hi, y.hi))
        else if (op == .pipe or op == .caret) and fact_type(ntype(int(nodes[n].b))) == T_U64:
            top = max(u64(x.hi xor FACT_MIN), u64(y.hi xor FACT_MIN))
            mask: u64 = 0
            loop mask < top: mask = (mask << 1) | 1
            low = if op == .pipe: max(x.lo, y.lo) else: FACT_MIN
            r = FactBound(low, int(mask) xor FACT_MIN)
        else if op == .shr and y.lo >= 0 and y.hi <= 63:
            r = FactBound(int(u64(x.lo xor FACT_MIN) >> u64(y.hi)) xor FACT_MIN, int(u64(x.hi xor FACT_MIN) >> u64(y.lo)) xor FACT_MIN)
        else if op == .shl and y.lo >= 0 and y.hi <= 63:
            high = u64(x.hi xor FACT_MIN)
            if high > (u64(18446744073709551615) >> u64(y.hi)): return fact_unmodeled(s, n, .unsupported)
            r = FactBound(int(u64(x.lo xor FACT_MIN) << u64(y.lo)) xor FACT_MIN, int(high << u64(y.hi)) xor FACT_MIN)
        else: return fact_unmodeled(s, n, .unsupported)
        return fact_new(s, r, FactTerm(.eof, a, b, n, T_U64))
    if op == .amp and (x.lo >= 0 or y.lo >= 0):
        r.lo = 0
        r.hi = if x.lo >= 0 and y.lo >= 0: min(x.hi, y.hi) else if x.lo >= 0: x.hi else: y.hi
    else if (op == .pipe or op == .caret) and x.lo >= 0 and y.lo >= 0:
        top = max(x.hi, y.hi)
        mask = 0
        loop mask < top: mask = (mask << 1) | 1
        r.lo = if op == .pipe: max(x.lo, y.lo) else: 0
        r.hi = mask
    else if op == .shr and y.lo >= 0 and y.hi <= 63:
        # Arithmetic right shift is monotone in x. For negative x increasing
        # the count raises the result; for nonnegative x it lowers it.
        # Mathematical int's endpoint sentinels are not finite bounds.
        if fact_type(ntype(int(nodes[n].a))) == T_MATH_INT and (not fact_host_endpoint(s, a, false) or not fact_host_endpoint(s, a, true)): return fact_unmodeled(s, n, .unsupported)
        r.lo = x.lo >> (if x.lo < 0: y.lo else: y.hi)
        r.hi = x.hi >> (if x.hi < 0: y.hi else: y.lo)
    else if op == .shl and x.lo >= 0 and y.lo >= 0 and y.hi <= 62:
        if x.hi > (FACT_MAX >> y.hi): return fact_unmodeled(s, n, .unsupported)
        r.lo = x.lo << y.lo
        r.hi = x.hi << y.hi
        if not exact_has_node(n) and not sa_fits(r.hi, ntype(n)): return fact_unmodeled(s, n, .unsupported)
    else: return fact_unmodeled(s, n, .unsupported)
    r.nz = r.lo > 0
    v = fact_new(s, r, FactTerm(.eof, a, b, n, ntype(n)))
    # (a row only where an interval cannot say it: a symbolic mask, as
    # `i & (n-1)`; constant masks and shifts are exact enough as intervals)
    if op == .amp and y.lo >= 0 and y.lo != y.hi: fact_difference(s, v, b, 0, n)
    if op == .amp and x.lo >= 0 and x.lo != x.hi and (y.lo < 0 or y.lo != y.hi): fact_difference(s, v, a, 0, n)
    v

fact_extremum_call = (n: int) -> bool:
    nkids(n) == 2 and fact_scalar(ntype(n)) and is_int(ntype(n)) and fact_type(ntype(n)) != T_U64 and (fact_prelude_call(n, "min") or fact_prelude_call(n, "max"))

# The prelude's integer `min(a b)` (or `max`): one of its operands, so its
# interval is theirs combined, and a row below (above) each operand. O(1).
fact_extremum = (s: mut FactState, n: int, a: int, b: int, lower: bool) -> int:
    x = fact_bound(s, a); y = fact_bound(s, b)
    r = if lower: FactBound(min(x.lo, y.lo), min(x.hi, y.hi)) else: FactBound(max(x.lo, y.lo), max(x.hi, y.hi))
    # A wide side uses MIN/MAX as infinity. Clamping can replace both with
    # finite endpoints, even when the clamped intermediate exceeded a word.
    r.wide = (x.wide or y.wide) and (r.lo == FACT_MIN or r.hi == FACT_MAX)
    r.nz = r.lo > 0 or r.hi < 0 or x.nz and y.nz
    v = fact_new(s, r, FactTerm(.eof, a, b, n, fact_hull_type(ntype(n), s, a, s, b)))
    if lower:
        fact_difference(s, v, a, 0, n)
        fact_difference(s, v, b, 0, n)
    else:
        fact_difference(s, a, v, 0, n)
        fact_difference(s, b, v, 0, n)
    v

# `b =? 0` for an exact rational b (the library's `__eq__` with a rational
# constant zero, expr.jo rational_constants): b's numerator is zero, the
# projection an exact division's divisor obligation reads (fact_divisor).
# The other operand's position, or -1.
fact_name_rational_eq = 0
fact_rational_zero_test = (n: int) -> int:
    if nodes[n].kind != .call or nodes[n].aux != 0 or nodes[n].sym <= 0 or nkids(n) != 2 or rational_constants.len() == 0: return -1
    d = int(fns[int(nodes[n].sym)].decl)
    if d == 0: return -1
    if fact_name_rational_eq == 0: fact_name_rational_eq = intern("__eq__")
    if int(nodes[d].name) != fact_name_rational_eq or files[pos_file(nodes[d].pos)].path != lib_dir + "/rational.dewy": return -1
    loop i in [0..2):
        e = kid(n, i)
        loop nodes[e].kind == .conv: e = int(nodes[e].a)
        if let parts = rational_constants.get(e):
            if parts.0 == 0: return 1 - i
    -1

# A library integer or rational power, `x^n` with an integer n: every one fails
# only for a negative exponent (a rational's for a zero base as well), so n >= 0
# is the caller's obligation.
fact_name_power = 0
fact_name_pow = 0
fact_name_pow_op = 0
fact_power_call = (n: int) -> bool:
    if nodes[n].kind != .call or nodes[n].aux != 0 or nodes[n].sym <= 0 or nkids(n) != 2: return false
    d = int(fns[int(nodes[n].sym)].decl)
    if d == 0: return false
    if fact_name_power == 0:
        fact_name_power = intern("__dewy_power")
        fact_name_pow = intern("pow")
        fact_name_pow_op = intern("__pow__")
    name = int(nodes[d].name)
    if name != fact_name_power and name != fact_name_pow and name != fact_name_pow_op: return false
    e = representation_type(ntype(kid(n, 1)))
    (is_int(e) or e == T_MATH_INT) and pos_in_lib(nodes[d].pos)

fact_power_check = (n: int, s: mut FactState, exponent: int): fact_nonnegative(n, s, exponent, kid(n, 1), "the exponent")

# An `int` shifted by a signed count (`x << n`, `x >>= n`): a negative count
# fails, so n >= 0 is an obligation. A fixed width's count is unsigned: total.
fact_shift_obliged = (n: int) -> bool:
    k = nodes[n].kind
    op = (if k == .assign: compound_op(int(nodes[n].op)) else: int(nodes[n].op)) as Tok
    if nodes[n].aux != 0 or (k != .binary and k != .assign) or (op != .shl and op != .shr) or prune(ntype(int(nodes[n].a))) != T_MATH_INT: return false
    count = prune(ntype(int(nodes[n].b)))
    count == T_MATH_INT or is_int(count) and types[count].sign

# A stepped range, `[a, b..c]` (a loop's, or the library's IntRange): its step
# b - a must be nonzero, so b not=? a is an obligation. n: the stepped `for_`,
# or the `__dewy_range` call with a literal `true` for `stepped`.
fact_name_range = 0
fact_range_call = (n: int) -> bool:
    if nodes[n].kind != .call or nodes[n].aux != 0 or nodes[n].sym <= 0 or nkids(n) != 5: return false
    d = int(fns[int(nodes[n].sym)].decl)
    if d == 0: return false
    if fact_name_range == 0: fact_name_range = intern("__dewy_range")
    stepped = kid(n, 3)
    int(nodes[d].name) == fact_name_range and pos_in_lib(nodes[d].pos) and nodes[stepped].kind == .bool_lit and nodes[stepped].ival != 0

fact_stepped_loop = (n: int) -> bool:
    it = int(nodes[n].a)
    nodes[n].kind == .for_ and nodes[n].aux == 0 and nodes[it].kind == .range and has_flag(it, NF_STEP) and nodes[it].c != 0

# Exhaustion is a separate obligation from a nonzero step. Only a 64-bit
# counter starting well inside its domain with a small fixed step may use the
# progress axiom. Narrow counters and huge steps must prove their backedge safe.
fact_open_range = (n: int) -> bool:
    if nodes[n].kind != .for_ or nodes[n].aux != 0: return false
    it = int(nodes[n].a)
    # An unbounded semantic-int range lowers with an exact, promoting cursor.
    nodes[it].kind == .range and nodes[it].b == 0 and dewy_at(nodes[n].pos) and prune(int(locals[int(nodes[n].sym)].type)) != T_MATH_INT

# The marked, small-start 64-bit range has a lexical progress axiom. It
# needs no value-flow proof; opt-out scopes and every other range retain
# their ordinary exhaustion obligation. Querying this certificate is O(1).
fact_range_assumed = (n: int) -> bool:
    nodes[n].aux2 == i32(RANGE_EXHAUSTION) and nodes[n].ival != 0 and dir_value(dir_name_assumed_bounds, nodes[n].pos) != 1

fact_range_exhaustion = (n: int, entry: FactState, first: int, second: int, edges: FactLoop):
    if not fact_open_range(n) or fact_speculating != 0 or fact_summary_owner != 0: return
    fact_validated[n] = true
    t = fact_type(int(locals[int(nodes[n].sym)].type))
    start = fact_bound(entry, first)
    delta = FactBound(1, 1)
    if second != 0:
        stop = fact_bound(entry, second)
        delta = FactBound(wide = true)
        if not start.wide and not stop.wide and start.lo != FACT_MIN and start.hi != FACT_MIN and fact_add_fits(stop.lo, -start.hi) and fact_add_fits(stop.hi, -start.lo): delta = FactBound(stop.lo - start.hi, stop.hi - start.lo)
    assumed = is_int(t) and types[t].bits == 64 and dir_value(dir_name_assumed_bounds, nodes[n].pos) != 1 and not start.wide and start.lo >= -72057594037927936 and start.hi <= 72057594037927936 and not delta.wide and delta.lo == delta.hi and delta.lo >= -65536 and delta.hi <= 65536
    proven = assumed or not edges.back.live
    if not proven:
        back = edges.back
        l = int(nodes[n].sym)
        binding = fact_binding(back, PlaceIdentity(.local, int(locals[l].owner), l))
        if binding >= 0 and stable_loop_index(l):
            current = fact_bound(back, back.bindings[binding].value)
            domain = fact_domain(t)
            if not current.wide and not delta.wide and fact_add_fits(current.lo, delta.lo) and fact_add_fits(current.hi, delta.hi):
                proven = current.lo + delta.lo >= domain.lo and current.hi + delta.hi <= domain.hi
    if fact_probe_on:
        fact_probe_record(n, proven)
        return
    if not proven:
        if dir_defer(n, "cannot prove the open range does not exhaust its integer type", true): return
        wit_fail(nodes[n].pos, "cannot prove the open range does not exhaust its integer type")

fact_step_check = (n: int, s: mut FactState, first: int, second: int, first_node: int, second_node: int):
    if fact_speculating != 0 or not (fact_policy == .RequireStatic or fact_query or fact_probe_on): return
    c = fact_compare(s, .ne, second, first)
    if fact_probe_on:
        fact_probe_record(n, c == 1)
        return
    if c == 1: return
    b = wit_side(second, second_node)
    a = wit_side(first, first_node)
    relation = wit_relation_text(.ne, b, a)
    missing = wit_relation(s, s, .ne, b, a, c == 0)
    wit_context(0)
    if c == 0:
        wit_help(relation)
        if dir_defer(n, "the range step is zero", true): return
        wit_fail(nodes[n].pos, "the range step is zero")
        return
    wit_unknown(n, fact_bound(s, second), "the range step is nonzero", 0, relation, missing)

# value (operand's) >= 0, as `what` requires: proven, an error, or a check of its scope.
fact_nonnegative = (n: int, s: mut FactState, value: int, operand: int, what: str):
    if fact_speculating != 0 or not (fact_policy == .RequireStatic or fact_query or fact_probe_on): return
    zero = fact_constant(s, 0)
    c = fact_compare(s, .ge, value, zero)
    if fact_probe_on:
        fact_probe_record(n, c == 1)
        return
    if c == 1: return
    side = wit_side(value, operand)
    nil = WitSide(zero, 0, "0", false, true)
    missing = wit_relation(s, s, .ge, side, nil, c == 0)
    wit_context(0)
    if c == 0:
        wit_help(wit_relation_text(.ge, side, nil))
        if dir_defer(n, "{what} is negative", true): return
        wit_fail(nodes[n].pos, "{what} is negative")
        return
    wit_unknown(n, fact_bound(s, value), "{what} is >= 0", 0, wit_relation_text(.ge, side, nil), missing)

# The narrowing whose obligation the check around it answers: an array index
# (in bounds, it fits) or a refinement bounded on both sides within the width.
fact_covered = 0
fact_refinement_covers = (r: int) -> int:
    inner = int(nodes[r].a)
    if nodes[inner].kind != .conv or nodes[inner].aux != i32(int(CV.int_)) or prune(ntype(int(nodes[inner].a))) != T_MATH_INT: return 0
    known, allowed = int_intervals(zonk(int(nodes[r].aux2)))
    if not known or allowed.len() == 0 or allowed[0] == FACT_MIN or allowed[allowed.len() - 1] == FACT_MAX: return 0
    inner

# A captured fixed-width value or singleton has real host endpoints, unlike
# an unconstrained mathematical int. Conversions preserve value identity, so
# widening int64 to int and storing it back need not invent strict bounds.
# O(1), using the existing value-indexed term; wide intermediates never qualify.
fact_host_value = (s: FactState, value: int) -> bool:
    if value == 0: return false
    b = fact_bound(s, value)
    if b.wide: return false
    if b.lo == b.hi: return true
    t = fact_type(fact_terms[value].type)
    is_int(t) and t != T_MATH_INT and t != T_U64

# Endpoint sentinels become finite through a current guard too. Inspect only
# this value's indexed incident rows (at most 16), not every value in the body.
# The other endpoint must itself have a finite interval; do not recurse through
# rows, so a cycle of unconstrained values cannot manufacture a bound.
fact_host_endpoint = (s: FactState, value: int, upper: bool) -> bool:
    b = fact_bound(s, value)
    if b.wide: return false
    if (if upper: b.hi != FACT_MAX else: b.lo != FACT_MIN) or fact_host_value(s, value): return true
    ri = fact_difference_head(s, value, int(upper))
    loop ri >= 0:
        row = s.differences[ri]
        ri = fact_difference_next(s, ri, int(upper))
        other = if upper: row.b else: row.a
        q = fact_bound(s, other)
        if q.wide: continue
        if upper:
            if (q.hi != FACT_MAX or fact_host_value(s, other)) and fact_add_fits(q.hi, row.limit): return true
        else if row.limit != FACT_MIN:
            if (q.lo != FACT_MIN or fact_host_value(s, other)) and fact_add_fits(q.lo, -row.limit): return true
    false

# An `int` converted to a fixed width (`int32(x)`, `x as int32`, a store into a
# fixed-width place): x must fit, proven, an error or a check of its scope.
# An `int`'s endpoint sentinels need strict bounds unless a captured fixed
# value or current guard establishes that endpoint is finite. True when proven.
fact_narrow_check = (n: int, s: mut FactState, value: int) -> bool:
    to = representation_type(ntype(n))
    bits = int(types[to].bits)
    sign = types[to].sign
    low = if not sign: 0 else if bits >= 64: FACT_MIN else: -(1 << (bits - 1))
    high = if bits >= 64: FACT_MAX else if sign: (1 << (bits - 1)) - 1 else: (1 << bits) - 1
    lo_op = if low == FACT_MIN and not fact_host_endpoint(s, value, false): Tok.gt else: Tok.ge
    hi_op = if high == FACT_MAX and not fact_host_endpoint(s, value, true): Tok.lt else: Tok.le
    lo = fact_constant(s, low)
    hi = fact_constant(s, high)
    lc = fact_compare(s, lo_op, value, lo)
    hc = fact_compare(s, hi_op, value, hi)
    # (a binding's covering set of written values: string_domains.jo)
    proven = lc == 1 and hc == 1 or int_domain_proven.has(n) or exact_progress_math.has(n)
    if fact_speculating != 0: return proven
    if fact_probe_on:
        fact_probe_record(n, proven)
        return proven
    if proven or n == fact_covered or not s.live or not (fact_policy == .RequireStatic or fact_query): return proven
    upper = hc != 1 and (lc != 0 or hc == 0)
    side = wit_side(value, int(nodes[n].a))
    limit = if upper: high else: low
    bound = WitSide((if upper: hi else: lo), 0, "{limit}", false, true)
    op = if upper: Tok.le else: Tok.ge
    refuted = (if upper: hc else: lc) == 0
    missing = wit_relation(s, s, op, side, bound, refuted)
    relation = wit_relation_text(op, side, bound)
    wit_context(0)
    if refuted:
        wit_help(relation)
        shown = if side.text != "": side.text else: "the value"
        if dir_defer(n, "{shown} does not fit {dt(ntype(n))}", true): return false
        wit_fail(nodes[n].pos, "{shown} does not fit {dt(ntype(n))}")
        return false
    wit_unknown(n, fact_bound(s, value), "`{relation}` for the conversion to {dt(ntype(n))}", 0, relation, missing)
    false

# The builtin floor helper a Dewy `//` or `%` resolved to (fact_floor's kind), or 0.
fact_floor_call = (n: int) -> int:
    if nodes[n].aux != 0 or nodes[n].sym <= 0 or nkids(n) != 2: return 0
    f = int(nodes[n].sym)
    if fns[f].decl == 0 or not pos_in_lib(nodes[int(fns[f].decl)].pos): return 0
    if not fact_scalar(ntype(n)): return 0
    name = name_of(int(nodes[int(fns[f].decl)].name))
    if name == "__floor_div": return 1
    if name == "__floor_mod": return 2
    if name == "__floor_div_pow2": return 3
    if name == "__floor_mod_pow2": return 4
    0

# Dewy strings index and slice by grapheme: `text.length`, `text[i]` and
# `text[a..b)` reach the facts pass as calls of the library's grapheme helpers
# (1, 2 and 3 here). Their length is the string value's length projection, as
# an array's is; the index and the slice are obligations, as an array's are.
fact_name_string_length = 0
fact_name_string_index = 0
fact_name_string_slice = 0
fact_name_byte_slice = 0
fact_string_call = (n: int) -> int:
    if nodes[n].kind != .call or nodes[n].aux != 0 or nodes[n].sym <= 0: return 0
    d = int(fns[int(nodes[n].sym)].decl)
    if d == 0: return 0
    if fact_name_string_length == 0:
        fact_name_string_length = intern("__dewy_string_length")
        fact_name_string_index = intern("__dewy_string_index")
        fact_name_string_slice = intern("__dewy_string_slice")
        fact_name_byte_slice = intern("__dewy_byte_slice")
    name = int(nodes[d].name)
    k = if name == fact_name_string_length and nkids(n) == 1: 1 else if name == fact_name_string_index and nkids(n) == 2: 2 else if name == fact_name_string_slice and nkids(n) == 5: 3 else if name == fact_name_byte_slice and nkids(n) == 3: 4 else: 0
    if k == 0 or not pos_in_lib(nodes[d].pos): return 0
    k

# A string's byte view, the value `text as array<uint8>` is: one per string value, so
# its length and the bytes guards read relate to every view of the same text.
const FACT_BYTE_VIEW = -6
const FACT_ASCII_TEXT = -15
fact_byte_view = (s: mut FactState, text: int) -> int: fact_project(s, text, FACT_BYTE_VIEW, false, mk_array(T_U8))

# `text.byte_slice(a b)`: 0 <=? a <=? b <=? the text's byte length, and each end a char
# boundary: 0, the byte length, or an index whose byte the facts hold below 0x80 or at
# least 0xC0 (a guard `bytes[a] <? 0x80` on the text's byte view). The result's byte
# length is b - a. O(1) queries.
fact_byte_slice = (n: int, s: mut FactState, values: int[]) -> int:
    view = fact_byte_view(s, values[0])
    length = fact_project(s, view, -1, false, T_INT)
    lo = values[1]
    hi = values[2]
    if fact_speculating == 0 and (fact_policy == .RequireStatic or fact_query):
        zero = fact_constant(s, 0)
        checks = [fact_compare(s, .le, zero, lo), fact_compare(s, .le, lo, hi), fact_compare(s, .le, hi, length)]
        bounded = checks[0] == 1 and checks[1] == 1 and checks[2] == 1
        starts = fact_char_boundary(s, view, length, lo) and fact_char_boundary(s, view, length, hi)
        if fact_probe_on: fact_probe_record(n, bounded and starts)
        else if not bounded: wit_slice_at(n, s, lo, hi, length, checks, kid(n, 0), kid(n, 1), kid(n, 2), false)
        else if not starts:
            first = fact_char_boundary(s, view, length, lo)
            which = if first: kid(n, 2) else: kid(n, 1)
            byte = fact_project(s, view, (if first: hi else: lo), true, T_U8)
            end = if first: "stop" else: "start"
            wit_unknown(n, fact_bound(s, byte), "byte_slice's {end} `{wit_text(which)}` is a char boundary", 0, "({wit_text(kid(n, 0))} as array<uint8>)[{wit_text(which)}] <? 0x80")
    value = fact_new(s, FactBound(), FactTerm(type = ntype(n)))
    size = fact_arithmetic(s, kid(n, 2), .minus, hi, lo)
    if s.projections.len() + 1 < FACT_CAP:
        bytes = fact_byte_view(s, value)
        fact_add_projection(s, FactProjection(bytes, -1, false, size))
    value

fact_char_boundary = (s: mut FactState, view: int, length: int, at: int) -> bool:
    # (within the bounds, which are proven first: at most 0 is 0, at least the length is it)
    # (the constant first: the state is taken before later arguments run)
    zero = fact_constant(s, 0)
    if fact_compare(s, .le, at, zero) == 1 or fact_compare(s, .ge, at, length) == 1: return true
    # ASCII belongs to the immutable string, never a mutable byte array.
    pi = fact_index_get(s.index[0].projection_value, view)
    if pi >= 0:
        p = s.projections[pi]
        if p.selector == FACT_BYTE_VIEW and fact_index_get(s.index[0].projection_index, fact_projection_key(p.base, FACT_ASCII_TEXT, false)) >= 0: return true
    byte = fact_project(s, view, at, true, T_U8)
    b = fact_bound(s, byte)
    if b.hi < 0x80 or b.lo >= 0xc0: return true
    false

# `xs.pop()` needs an element (`xs.length >? 0`); `xs.pop(i)` an index in
# bounds, as `xs[i]` does. Both are checked at run time where deferred.
fact_removal = (n: int, s: mut FactState, index: int, length: int):
    zero = fact_constant(s, 0)
    if nodes[n].aux == i32(int(IN.pop)):
        c = fact_compare(s, .gt, length, zero)
        if c != 1: wit_operation(n, s, .gt, WitSide(length, kid(n, 0), (if wit_text(kid(n, 0)) != "": "{wit_text(kid(n, 0))}.length" else: ""), true), WitSide(zero, 0, "0", false, true), c, "pop() of an empty array", "pop() has an element to remove")
        return
    lo = fact_compare(s, .le, zero, index)
    hi = fact_compare(s, .lt, index, length)
    if lo != 1 or hi != 1: wit_index(n, s, index, length, lo, hi, kid(n, 0), kid(n, 1))

fact_string_index = (n: int, s: mut FactState, index: int, length: int):
    if fact_speculating != 0 or not (fact_policy == .RequireStatic or fact_query): return
    zero = fact_constant(s, 0)
    lo = fact_compare(s, .le, zero, index)
    hi = fact_compare(s, .lt, index, length)
    if fact_probe_on: fact_probe_record(n, lo == 1 and hi == 1)
    else if lo != 1 or hi != 1: wit_index(n, s, index, length, lo, hi, kid(n, 0), kid(n, 1))

# `xs.swap(i j)` needs both indexes in bounds and `xs.insert(value i)` a
# position 0 <=? i <=? xs.length: obligations of the call, as an index is (the
# library's helper checks them where they are deferred). 4 swap, 5 insert, or 0.
# `bytes.read<uint64>(i)` needs 0 <=? i and i + 8 <=? bytes.length (4 for uint32, 2 for
# uint16): 10 plus the width here.
# `reshape(xs a b)` (to four dimensions) needs each dimension >= 0 and their
# product xs.length: 20 plus the dimensions. A slice assignment `xs[a..b) = v`
# (no step) needs 0 <=? a <=? b <=? xs.length, as a slice does, and an array v
# of b - a elements: 30 for one value, 31 for an array. A dotted expression over
# 1-D arrays (`xs .+ ys`) needs their lengths equal, or 1: 40, for `__bcast`.
fact_name_swap = 0
fact_name_insert = 0
fact_name_reshape = 0
fact_name_put_slice = 0
fact_name_bcast = 0
fact_name_reads: int[]
fact_array_call = (n: int) -> int:
    if nodes[n].kind != .call or nodes[n].aux != 0 or nodes[n].sym <= 0 or nkids(n) < 1 or nkids(n) > 8: return 0
    d = int(fns[int(nodes[n].sym)].decl)
    if d == 0: return 0
    if fact_name_swap == 0:
        fact_name_swap = intern("swap")
        fact_name_insert = intern("__dewy_insert")
        fact_name_reshape = intern("reshape")
        fact_name_put_slice = intern("__dewy_put_slice")
        fact_name_bcast = intern("__bcast")
        fact_name_reads = [intern("__dewy_read_u64"), intern("__dewy_read_u32"), intern("__dewy_read_u16")]
    name = int(nodes[d].name)
    k = 0
    if nkids(n) == 1: k = if name == fact_name_bcast and nodes[kid(n, 0)].kind == .array: 40 else: 0
    else if name == fact_name_reshape and nkids(n) >= 3 and nkids(n) <= 5: k = 19 + nkids(n)
    else if name == fact_name_put_slice and nkids(n) == 8: k = fact_put_slice_kind(n)
    else if nkids(n) == 3: k = if name == fact_name_swap: 4 else if name == fact_name_insert: 5 else: 0
    else if nkids(n) == 2: k = if name == fact_name_reads[0]: 18 else if name == fact_name_reads[1]: 14 else if name == fact_name_reads[2]: 12 else: 0
    if k == 0 or not pos_in_lib(nodes[d].pos): return 0
    rk = tkind(fact_type(ntype(kid(n, 0))))
    if rk != .array and not (rk == .fixed and k >= 30 and k < 40): return 0
    k

# (literal flags only: a stepped one keeps its check)
fact_put_slice_kind = (n: int) -> int:
    loop i in [4..7):
        if nodes[kid(n, i)].kind != .bool_lit: return 0
    if nodes[kid(n, 6)].ival != 0: return 0
    vk = tkind(representation_type(ntype(kid(n, 7))))
    if vk == .array or vk == .fixed: 31 else: 30

# Dictionary key presence (no traps): `d[k]`, `d[k] += 1` and `d.pop(k)` need
# k in d, an obligation of the call as an index is; so does a set's `s.pop(v)`. `k in? d` is a projection
# of d's value on k's (an element projection: a dictionary has no other), true
# after a guard or a store into d[k]; any other change of d gives d a new
# value. O(1) per call. 1 `in?`, 2 read, 3 changed entry, 4 pop, 5 stored
# entry, or 0.
fact_name_contains = 0
fact_name_has = 0
fact_name_read = 0
fact_name_present = 0
fact_name_pop = 0
fact_name_entry = 0
fact_name_store = 0
fact_map_call = (n: int) -> int:
    if nodes[n].kind != .call or nodes[n].aux != 0 or nodes[n].sym <= 0 or nkids(n) < 2: return 0
    d = int(fns[int(nodes[n].sym)].decl)
    if d == 0: return 0
    if fact_name_contains == 0:
        fact_name_contains = intern("contains")
        fact_name_has = intern("has")
        fact_name_read = intern("[]")
        fact_name_present = intern("__map_entry_present")
        fact_name_pop = intern("pop")
        fact_name_entry = intern("__map_entry")
        fact_name_store = intern("[]=")
    name = int(nodes[d].name)
    k = if name == fact_name_contains or name == fact_name_has: 1 else if name == fact_name_read: 2 else if name == fact_name_present: 3 else if name == fact_name_pop: 4 else if name == fact_name_entry or name == fact_name_store: 5 else: 0
    if k == 0 or k != 5 and nkids(n) != 2 or not pos_in_lib(nodes[d].pos): return 0
    # (a set's membership is its entries' keys: `v in? s` and `s.pop(v)`)
    t = representation_type(ntype(kid(n, 0)))
    if is_dewy_set_type(t): return if k == 1 or k == 4: k else: 0
    if not is_map_type(t): return 0
    k

# The key's value; a plain string literal is one value however often written,
# and so is a binding never written after its declaration (a loop's element
# among them, which may be read again each time it is named, by reference to
# an element its loop does not change). Such a value is
# one per declaration, not per execution: a fact about it made in one
# iteration reaches the next only through the loop's header, which joins it
# with the entry, where the declaration has not happened.
fact_map_key = (s: mut FactState, e0: int, value: int) -> int:
    e = e0
    loop nodes[e].kind == .narrow or nodes[e].kind == .conv: e = int(nodes[e].a)
    if nodes[e].kind == .str_lit and nkids(e) == 0 and nodes[e].sval >= 0: return fact_constant(s, (1 << 42) + int(nodes[e].sval))
    if nodes[e].kind == .ident and nodes[e].aux == i32(int(SK.local)) and not has_flag(e, NF_GLOBAL):
        l = int(nodes[e].sym)
        if l > 0 and int(locals[l].flags) & (LF_PARAM | LF_MUTPARAM | LF_ASSIGNED | LF_CAPTURE | LF_CAPTURED | LF_SHARED | LF_ADDR | LF_ELEMALIAS | LF_SOAMUT) == 0 and fact_dewy_local(l): return fact_constant(s, (2 << 42) + l)
    value

fact_map_member = (s: mut FactState, n: int, map: int, key: int) -> int:
    fact_project(s, map, fact_map_key(s, kid(n, 1), key), true, T_BOOL)

fact_map_receiver = (s: mut FactState, n: int, value: int) -> int:
    route = fact_route(kid(n, 0), s)
    held = fact_route_values(s, route)
    if held.len() > 0: held[held.len() - 1] else: value

fact_map_check = (n: int, s: mut FactState, values: int[]):
    if fact_speculating != 0 or not (fact_policy == .RequireStatic or fact_query): return
    # (a totaldict has every key its type admits)
    e = kid(n, 0)
    loop e > 0:
        if is_total_dict(ntype(e)) or refine_active and is_total_dict(refine_storage(e, ntype(e))): return
        if nodes[e].kind != .conv and nodes[e].kind != .narrow and nodes[e].kind != .addr: break
        e = int(nodes[e].a)
    member = fact_map_member(s, n, fact_map_receiver(s, n, values[0]), values[1])
    proven = fact_truth(s, member) == 1
    if fact_probe_on:
        fact_probe_record(n, proven)
        return
    if not proven: wit_key(n)

fact_array_call_check = (n: int, s: mut FactState, values: int[], kind: int):
    if fact_speculating != 0 or not (fact_policy == .RequireStatic or fact_query): return
    # (the receiver is a place, as a builtin operation's is)
    route = fact_route(kid(n, 0), s)
    held = fact_route_values(s, route)
    base = if held.len() > 0: held[held.len() - 1] else: values[0]
    length = fact_project(s, base, -1, false, T_INT)
    zero = fact_constant(s, 0)
    if kind == 40:
        fact_bcast_check(n, s)
        return
    if kind >= 30:
        # (a fixed array's length is its type's)
        t = representation_type(ntype(kid(n, 0)))
        if tkind(t) == .fixed: length = fact_constant(s, fixed_len(t))
        fact_put_slice_check(n, s, values, length, kind == 31)
        return
    if kind > 20:
        fact_reshape_check(n, s, values, length)
        return
    if kind > 10:
        # (i + width <=? length: i - length <=? -width)
        width = kind - 10
        index = values[1]
        lo = fact_compare(s, .le, zero, index)
        hi = fact_entails(s, index, length, -width)
        if fact_probe_on: fact_probe_record(n, lo == 1 and hi)
        else if lo != 1 or not hi:
            i = wit_text(kid(n, 1))
            upper = "{i} + {width} <=? {wit_text(kid(n, 0))}.length"
            relation = if lo == 1: upper else if hi: "0 <=? {i}" else: "0 <=? {i} and {upper}"
            missing = if lo == 1: "upper bound" else if hi: "lower bound" else: "lower and upper bounds"
            wit_unknown(n, fact_bound(s, index), "read<uint{width * 8}> is in bounds", 0, relation, missing)
        return
    positions = if kind == 4: [1, 2] else: [2]
    loop i in positions:
        index = values[i]
        lo = fact_compare(s, .le, zero, index)
        hi = if kind == 4: fact_compare(s, .lt, index, length) else: fact_compare(s, .le, index, length)
        if fact_probe_on:
            fact_probe_record(n, lo == 1 and hi == 1)
            continue
        if lo == 1 and hi == 1: continue
        # (an insertion position may be the length itself: one past the last index)
        bound = if kind == 4: length else: fact_arithmetic(s, kid(n, 0), .plus, length, fact_constant(s, 1))
        wit_index(n, s, index, bound, lo, hi, kid(n, 0), kid(n, i))
        return

# reshape's dimensions: each >= 0, their product the length (a product the
# facts model: all but one dimension constant). O(dimensions).
fact_reshape_check = (n: int, s: mut FactState, values: int[], length: int):
    zero = fact_constant(s, 0)
    product = values[1]
    loop i in [1..values.len()):
        if fact_compare(s, .ge, values[i], zero) != 1:
            if fact_probe_on: fact_probe_record(n, false)
            else: wit_unknown(n, fact_bound(s, values[i]), "reshape's dimension `{wit_text(kid(n, i))}` is >= 0", 0, "{wit_text(kid(n, i))} >=? 0")
            return
        if i > 1: product = fact_arithmetic(s, kid(n, i), .star, product, values[i])
    proven = fact_compare(s, .eq, length, product) == 1
    if fact_probe_on: fact_probe_record(n, proven)
    else if not proven:
        dims: str[]
        loop i in [1..values.len()): dims.push(wit_text(kid(n, i)))
        receiver = wit_text(kid(n, 0))
        relation = if receiver != "": "{receiver}.length =? {join(dims, "*")}" else: ""
        whose = if receiver != "": "`" + receiver + "`'s" else: "the"
        wit_unknown(n, fact_bound(s, product), "reshape's dimensions multiply to {whose} element count", 0, relation)

# The lengths of a dotted expression's 1-D operands (an array of them, the
# compiler's): each 1 (stretched) or the same as the others. O(operands).
fact_bcast_check = (n: int, s: mut FactState):
    one = fact_constant(s, 1)
    first = 0
    loop c in kids(kid(n, 0)):
        v = fact_capture(c, s)
        if fact_compare(s, .eq, v, one) == 1: continue
        if first == 0:
            first = v
            continue
        if fact_compare(s, .eq, v, first) == 1: continue
        if fact_probe_on: fact_probe_record(n, false)
        else: wit_unknown(n, fact_bound(s, v), "the operands of this elementwise operation have matching lengths", 0, "")
        return
    if fact_probe_on: fact_probe_record(n, true)

# A slice assignment's bounds (fact_string_slice's) and, for an array, its length.
fact_put_slice_check = (n: int, s: mut FactState, values: int[], length: int, many: bool):
    inclusive = nodes[kid(n, 4)].ival != 0
    bounded = nodes[kid(n, 5)].ival != 0
    lo = values[1]
    hi = length
    if bounded:
        hi = values[3]
        if inclusive: hi = fact_arithmetic(s, kid(n, 3), .plus, hi, fact_constant(s, 1))
    zero = fact_constant(s, 0)
    checks = [fact_compare(s, .le, zero, lo), fact_compare(s, .le, lo, hi), fact_compare(s, .le, hi, length)]
    bounds = checks[0] == 1 and checks[1] == 1 and checks[2] == 1
    count = true
    if bounds and many:
        size = fact_arithmetic(s, kid(n, 3), .minus, hi, lo)
        vt = representation_type(ntype(kid(n, 7)))
        given = if tkind(vt) == .fixed: fact_constant(s, fixed_len(vt)) else: fact_project(s, values[7], -1, false, T_INT)
        count = fact_compare(s, .eq, given, size) == 1
        if not count and not fact_probe_on:
            text = wit_text(kid(n, 7))
            what = if text != "": "`" + text + "`" else: "array"
            relation = if text != "": text + ".length =? the slice's length" else: ""
            wit_unknown(n, fact_bound(s, given), "the assigned {what} has the slice's length", 0, relation)
            return
    if fact_probe_on: fact_probe_record(n, bounds and count)
    else if not bounds: wit_slice_at(n, s, lo, hi, length, checks, kid(n, 0), kid(n, 1), (if bounded: kid(n, 3) else: 0), inclusive)

# `text[a..b)`: 0 <=? a <=? b <=? text.length (an inclusive end counts one
# more, an open end is the length); the slice's length is their difference.
fact_string_slice = (n: int, s: mut FactState, values: int[], length: int) -> int:
    inclusive = nodes[kid(n, 3)].kind == .bool_lit and nodes[kid(n, 3)].ival != 0
    stop = nodes[kid(n, 4)].kind != .bool_lit or nodes[kid(n, 4)].ival != 0
    lo = values[1]
    hi = length
    if stop:
        hi = values[2]
        if inclusive: hi = fact_arithmetic(s, kid(n, 2), .plus, hi, fact_constant(s, 1))
    if fact_speculating == 0 and (fact_policy == .RequireStatic or fact_query):
        zero = fact_constant(s, 0)
        checks = [fact_compare(s, .le, zero, lo), fact_compare(s, .le, lo, hi), fact_compare(s, .le, hi, length)]
        if fact_probe_on: fact_probe_record(n, checks[0] == 1 and checks[1] == 1 and checks[2] == 1)
        else if checks[0] != 1 or checks[1] != 1 or checks[2] != 1:
            wit_slice_at(n, s, lo, hi, length, checks, kid(n, 0), kid(n, 1), (if stop: kid(n, 2) else: 0), inclusive)
    value = fact_new(s, FactBound(), FactTerm(type = ntype(n)))
    size = fact_arithmetic(s, kid(n, if stop: 2 else: 1), .minus, hi, lo)
    if s.projections.len() < FACT_CAP: fact_add_projection(s, FactProjection(value, -1, false, size))
    value

# a - b <= limit, from rows or from the two intervals.
fact_entails = (s: FactState, a: int, b: int, limit: int) -> bool:
    if fact_distance(s, a, b, limit): return true
    x = fact_bound(s, a); y = fact_bound(s, b)
    not x.wide and not y.wide and y.lo != FACT_MIN and fact_add_fits(x.hi, -y.lo) and x.hi - y.lo <= limit

# A non-element projection of an immutable entry value (a snapshot's length,
# say) first read in the body names the same evaluation at entry. Copy it
# there at its domain, so backedge rows about it can be checked against entry.
fact_loop_materialize = (entry: mut FactState, back: FactState, v: int, depth: int = 0) -> bool:
    if fact_slot(entry, v) >= 0: return true
    if depth > 2 or entry.ids.len() >= FACT_CAP or entry.projections.len() >= FACT_CAP: return false
    pi = fact_index_get(back.index[0].projection_value, v)
    if pi >= 0:
        p = back.projections[pi]
        if not fact_loop_materialize(entry, back, p.base, depth + 1): return false
        b = fact_domain(fact_terms[v].type)
        if p.selector == -1: b = FactBound(0, fact_length_max())
        fact_add_value(entry, v, b)
        fact_add_projection(entry, p)
        return true
    false

# Intervals are candidates at a changing loop header, and so are backedge rows
# relating a changing scalar to an immutable evaluation (`k <? s.length` after
# a combined loop's guard). A row is kept only when entry entails it too; the
# header settles only when the same rows return, so each kept row holds on
# initiation and preservation. Guards select rows; assertions never do.
fact_loop_header = (entry: mut FactState, back: FactState, old: FactState, at: int, widen: bool) -> FactState:
    changing: {int: bool} = {}
    started: {int: bool} = {}
    binding_values: int[]
    counters: int[]
    if back.live and entry.live:
        loop i in [0..back.bindings.len()):
            binding = back.bindings[i]
            if fact_index_get(binding_values, binding.value) < 0: fact_index_put(binding_values, binding.value, i)
            original = fact_binding(entry, binding.place)
            if original < 0 or entry.bindings[original].value == binding.value: continue
            t = if binding.place.root == .local: int(locals[binding.place.declaration].type) else: int(globals[binding.place.declaration].type)
            if fact_scalar(t):
                changing[binding.value] = true
                # (a changing place's entry value: a path back to it measures
                # the iterations so far, a row that never settles)
                started[entry.bindings[original].value] = true
            b = fact_bound(entry, entry.bindings[original].value)
            if fact_scalar(t) and types[fact_type(t)].kind == .int_ and b.lo == b.hi: counters.push(i)
    # Lockstep counters: two changing integers that start at constants keep
    # the difference entry gives them when the backedge entails it too (a
    # combined loop's range and hidden indices step together).
    lockstep: FactDifference[]
    if counters.len() <= 8:
        loop i in counters:
            x = fact_bound(entry, entry.bindings[fact_binding(entry, back.bindings[i].place)].value)
            loop j in counters:
                y = fact_bound(entry, entry.bindings[fact_binding(entry, back.bindings[j].place)].value)
                if i == j or y.lo == FACT_MIN or not fact_add_fits(x.lo, -y.lo) or x.lo - y.lo == FACT_MIN: continue
                if fact_entails(back, back.bindings[i].value, back.bindings[j].value, x.lo - y.lo): lockstep.push(FactDifference(i, j, x.lo - y.lo))
    carried: FactDifference[]
    offsets: int[]
    if changing.len() > 0 and nodes[at].kind == .while_: fact_offset_guarded(int(nodes[at].a), offsets, 0)
    if changing.len() > 0:
        loop row in back.differences:
            upper = changing.has(row.a)
            if not upper and not changing.has(row.b): continue
            if fact_loop_materialize(entry, back, if upper: row.b else: row.a): carried.push(row)
        # A counter guarded through an offset (`loop i+2 <? n {… i+=3}`)
        # relates to the bound only along a path through the body's own
        # values: offer the tightest path to each immutable evaluation too.
        # One bounded search per changing scalar and direction (32 terms,
        # 256 rows), as fact_relational's.
        # Offset-tested counters retain their existing path candidates.
        loop binding in back.bindings:
            if not changing.has(binding.value) or binding.place.root != .local or binding.place.declaration not in offsets: continue
            fact_loop_paths(entry, back, binding.value, true, changing, started, carried)
        if nodes[at].kind == .while_:
            direct: FactDifference[]
            fact_guarded_rows(int(nodes[at].a), back, changing, direct, 0)
            # Multiple advancing guard counters already use the lockstep
            # budget; do not crowd their shared endpoints with more rows.
            if direct.len() == 1: carried.push(direct[0])
        # A counter stepped down (`high-=1`) stays at most its entry value,
        # and below what entry bounds that value by (`high=xs.length`: high
        # stays at most the length): candidates from entry, kept only when
        # the backedge entails them. A rising counter with a symbolic start
        # retains the dual lower bound; constant starts need only intervals.
        # O(changing counters x their entry rows, at most 8), one bounded
        # relaxation per candidate.
        loop binding in back.bindings:
            v = binding.value
            if not changing.has(v): continue
            term = fact_terms[v]
            if term.op != .plus and term.op != .minus or term.a == 0 or term.b == 0: continue
            step = fact_bound(back, term.b)
            if step.lo != step.hi or step.lo == 0 or step.lo == FACT_MIN: continue
            falling = (step.lo < 0) == (term.op == .plus)
            e = fact_binding(entry, binding.place)
            if e < 0: continue
            start = entry.bindings[e].value
            if not falling:
                initial = fact_bound(entry, start)
                # Constant starts already have an interval lower bound.
                if initial.lo == initial.hi: continue
                if fact_entails(back, start, v, 0): carried.push(FactDifference(start, v, 0))
                ri = fact_difference_head(entry, start, 0)
                seen = 0
                loop ri >= 0 and seen < 8:
                    row = entry.differences[ri]
                    ri = fact_difference_next(entry, ri, 0)
                    seen += 1
                    if row.b == start and row.a != start and fact_entails(back, row.a, v, row.limit): carried.push(FactDifference(row.a, v, row.limit))
                continue
            if fact_entails(back, v, start, 0): carried.push(FactDifference(v, start, 0))
            ri = fact_difference_head(entry, start, 1)
            seen = 0
            loop ri >= 0 and seen < 8:
                row = entry.differences[ri]
                ri = fact_difference_next(entry, ri, 1)
                seen += 1
                if row.a == start and row.b != start and fact_entails(back, v, row.b, row.limit): carried.push(FactDifference(v, row.b, row.limit))
    # Only bindings and stable direct projections survive into a loop header.
    # Joining every temporary and difference row first builds a state we would
    # immediately throw away. Merge the demanded roots directly, O(B + P),
    # using the existing place/projection indexes.
    source = if entry.live: entry else: back
    predecessor = if entry.live: back else: entry
    # Entry evaluations are immutable snapshots and survive every header.
    # Keep their indexes instead of rebuilding them after every changing root.
    s = entry
    s.live = entry.live or back.live
    s.full = false
    s.bindings = []
    s.conditional = []
    s.index[0].roots = []
    loop binding in source.bindings:
        v = binding.value
        peer = if predecessor.live: fact_binding(predecessor, binding.place) else: -1
        if predecessor.live and peer < 0: continue
        peer_value = if peer >= 0: predecessor.bindings[peer].value else: v
        bound = fact_bound(source, v)
        if peer >= 0: bound = fact_hull(bound, fact_bound(predecessor, peer_value), at)
        bound.reason = .loop_; bound.witness = at
        previous = fact_binding(old, binding.place)
        t = if binding.place.root == .local: int(locals[binding.place.declaration].type) else: int(globals[binding.place.declaration].type)
        if widen and previous >= 0:
            before = fact_bound(old, old.bindings[previous].value)
            domain = fact_domain(t, .loop_, at)
            bound.lo = if bound.lo < before.lo: domain.lo else: before.lo
            # (a counter the condition tests at an offset, growing below any
            # length, stops first at the largest length, where a guard on a
            # length or a bound below one holds it (`loop i+1 <? stop`); past
            # it, at the domain)
            limit = fact_length_max()
            offset = offsets.len() > 0 and binding.place.root == .local and binding.place.declaration in offsets
            bound.hi = if bound.hi <= before.hi: before.hi else if offset and before.hi < limit and bound.hi <= limit and domain.hi > limit: limit else: domain.hi
        # Stable values keep their immutable identities and projection facts.
        original = fact_binding(entry, binding.place)
        if original >= 0 and entry.bindings[original].value == v and v == peer_value:
            slot = fact_slot(s, v)
            if slot < 0: fact_add_value(s, v, bound)
            else if s.bounds[slot] != bound: s.bounds[slot] = bound
            fact_bind(s, binding.place, v)
        else:
            # (only the contract's interval: its rows to fresh literals would
            # never settle the header)
            if refine_active: bound = ref_interval(t, bound)
            # (a mathematical int that entry and the backedge both hold
            # within int64 stays there, even when widened to the domain;
            # stability compares this representation too)
            fact_bind(s, binding.place, fact_new(s, bound, FactTerm(type = fact_hull_type(t, source, v, predecessor, peer_value))))
    # A changing aggregate keeps the lengths and fields entry and backedge
    # share (an element write leaves its length); stability re-validates them.
    loop binding in source.bindings:
        h = fact_binding(s, binding.place)
        if h < 0 or s.bindings[h].value == binding.value: continue
        peer = if predecessor.live: fact_binding(predecessor, binding.place) else: -1
        if predecessor.live and peer < 0: continue
        pi = fact_index_get(source.index[0].projection_head, binding.value)
        loop pi >= 0:
            p = source.projections[pi]
            pi = source.index[0].projection_next[pi]
            if p.element or fact_slot(entry, p.value) < 0: continue
            if peer >= 0:
                qi = fact_index_get(predecessor.index[0].projection_index, fact_projection_key(predecessor.bindings[peer].value, p.selector, false))
                if qi < 0 or predecessor.projections[qi].value != p.value: continue
            if s.projections.len() < FACT_CAP: fact_add_projection(s, FactProjection(s.bindings[h].value, p.selector, false, p.value))
    loop row in carried:
        upper = changing.has(row.a)
        value = if upper: row.a else: row.b
        other = if upper: row.b else: row.a
        found = fact_index_get(binding_values, value)
        if found < 0: continue
        e = fact_binding(entry, back.bindings[found].place)
        h = fact_binding(s, back.bindings[found].place)
        if e < 0 or h < 0 or fact_slot(s, other) < 0: continue
        start = entry.bindings[e].value
        v = s.bindings[h].value
        if upper and not fact_entails(entry, start, other, row.limit): continue
        if not upper and not fact_entails(entry, other, start, row.limit): continue
        # (widening: a row the last header lacked or held tighter, as a
        # counter's distance from its symbolic start, is dropped)
        if widen:
            p = fact_binding(old, back.bindings[found].place)
            if p >= 0 and old.bindings[p].value != start:
                r = if upper: fact_row_find(old, old.bindings[p].value, other) else: fact_row_find(old, other, old.bindings[p].value)
                if r < 0 or old.differences[r].limit < row.limit: continue
        o = fact_bound(s, other)
        b = fact_bound(s, v)
        if upper:
            fact_difference(s, v, other, row.limit, row.at)
            if fact_add_fits(o.hi, row.limit): b.hi = min(b.hi, o.hi + row.limit)
        else:
            fact_difference(s, other, v, row.limit, row.at)
            if o.lo != FACT_MIN and row.limit != FACT_MIN and fact_add_fits(o.lo, -row.limit): b.lo = max(b.lo, o.lo - row.limit)
        fact_set_bound(s, v, b)
    loop row in lockstep:
        p = fact_binding(s, back.bindings[row.a].place)
        q = fact_binding(s, back.bindings[row.b].place)
        if p < 0 or q < 0: continue
        a = s.bindings[p].value; b = s.bindings[q].value
        fact_difference(s, a, b, row.limit, at)
        x = fact_bound(s, a); y = fact_bound(s, b)
        if fact_add_fits(y.hi, row.limit): x.hi = min(x.hi, y.hi + row.limit)
        if x.lo != FACT_MIN and fact_add_fits(x.lo, -row.limit): y.lo = max(y.lo, x.lo - row.limit)
        fact_set_bound(s, a, x)
        fact_set_bound(s, b, y)
    s

# Locals a loop condition compares at a constant offset (`i+2 <? n`), through
# `and`/`or`. O(condition nodes), at most 16 deep.
fact_offset_guarded = (e: int, out: mut int[], depth: int):
    if e == 0 or depth > 16: return
    k = nodes[e].kind
    if k == .and_ or k == .or_:
        fact_offset_guarded(int(nodes[e].a), out, depth + 1)
        fact_offset_guarded(int(nodes[e].b), out, depth + 1)
        return
    if k != .binary or not fact_comparison(nodes[e].op as Tok): return
    loop side in [int(nodes[e].a), int(nodes[e].b)]:
        x = side
        loop x != 0 and nodes[x].kind == .conv: x = int(nodes[x].a)
        if x == 0 or nodes[x].kind != .binary or (nodes[x].op != i32(int(Tok.plus)) and nodes[x].op != i32(int(Tok.minus))): continue
        loop operand in [int(nodes[x].a), int(nodes[x].b)]:
            if nodes[operand].kind == .ident and nodes[operand].aux == i32(int(SK.local)): out.push(int(nodes[operand].sym))

# Read an already established scalar/field/array-length identity without
# evaluating syntax or replaying effects. O(route depth), at most 16.
fact_guard_value = (e: int, s: FactState, depth: int = 0) -> int:
    if e == 0 or depth > 16: return 0
    k = nodes[e].kind
    if k == .conv: return fact_guard_value(int(nodes[e].a), s, depth + 1)
    if k == .ident:
        i = fact_binding(s, fact_place(e))
        return if i >= 0: s.bindings[i].value else: 0
    base = 0; selector = 0
    if fact_field_node(e):
        base = fact_guard_value(int(nodes[e].a), s, depth + 1)
        selector = if nodes[e].aux == -2: int(nodes[e].ival) else: int(nodes[e].name)
    else if k == .call and fact_string_call(e) == 1:
        base = fact_guard_value(kid(e, 0), s, depth + 1)
        selector = -1
    else if k == .intrinsic and nodes[e].aux == i32(int(IN.len)) and nkids(e) == 1 and tkind(fact_type(ntype(kid(e, 0)))) == .array:
        base = fact_guard_value(kid(e, 0), s, depth + 1)
        selector = -1
    if base == 0: return 0
    i = fact_index_get(s.index[0].projection_index, fact_projection_key(base, selector, false))
    if i >= 0: return s.projections[i].value
    0

# A direct scanner comparison selects only its named endpoint, not every
# reachable row (which would spend a coupled counter's incident-row budget).
# O(condition nodes), depth <= 16, one bounded indexed path query per selected
# pair. These are candidates: fact_loop_header still checks entry/preservation.
fact_guarded_rows = (e: int, back: FactState, changing: {int: bool}, carried: mut FactDifference[], depth: int):
    if e == 0 or depth > 16: return
    k = nodes[e].kind
    if k == .and_ or k == .or_:
        fact_guarded_rows(int(nodes[e].a), back, changing, carried, depth + 1)
        fact_guarded_rows(int(nodes[e].b), back, changing, carried, depth + 1)
        return
    if k != .binary or nodes[e].aux != 0 or not fact_comparison(nodes[e].op as Tok): return
    sides = [int(nodes[e].a), int(nodes[e].b)]
    loop direction in [0..2):
        a = sides[direction]; b = sides[1 - direction]
        loop nodes[a].kind == .conv: a = int(nodes[a].a)
        loop nodes[b].kind == .conv: b = int(nodes[b].a)
        if nodes[a].kind != .ident: continue
        v = fact_guard_value(a, back); other = fact_guard_value(b, back)
        if v == 0 or other == 0: continue
        if not changing.has(v) or changing.has(other): continue
        limit = fact_shortest(back, v, other)
        if limit != FACT_MAX: carried.push(FactDifference(v, other, limit, e))

# Rows v - o <= d (upper) or o - v <= d from back's paths out of changing v to
# values entry holds (or materializes) that do not change, beyond direct rows.
fact_loop_paths = (entry: mut FactState, back: FactState, v: int, upper: bool, changing: {int: bool}, started: {int: bool}, carried: mut FactDifference[]):
    terms = [v]
    distances = [0]
    cursor = 0
    visits = 0
    loop cursor < terms.len():
        source = terms[cursor]
        distance = distances[cursor]
        cursor += 1
        previous = -1
        ri = fact_difference_head(back, source, int(upper))
        loop ri >= 0:
            row = back.differences[ri]
            visits += ri - previous
            previous = ri
            ri = fact_difference_next(back, ri, int(upper))
            if visits > 256: return
            if not fact_add_fits(distance, row.limit): continue
            other = if upper: row.b else: row.a
            value = distance + row.limit
            seen = -1
            loop t in [0..terms.len()):
                if terms[t] == other: seen = t
            if seen >= 0:
                if value < distances[seen]: distances[seen] = value
                continue
            if terms.len() >= 32: continue
            terms.push(other)
            distances.push(value)
    loop t in [1..terms.len()):
        o = terms[t]
        if changing.has(o) or started.has(o) or not fact_loop_materialize(entry, back, o): continue
        carried.push(if upper: FactDifference(v, o, distances[t]) else: FactDifference(o, v, distances[t]))

# Nothing is known of v beyond its interval: no projections, no rows.
fact_top = (s: FactState, v: int) -> bool:
    fact_index_get(s.index[0].projection_head, v) < 0 and fact_incident(s, v) < 0

# Two header aggregates whose contents changed (an element written each
# iteration) are settled when they carry the same non-element projections:
# the same evaluated lengths and fields, and nothing else known.
fact_same_shape = (a: FactState, b: FactState, x: int, y: int) -> bool:
    count = 0
    pi = fact_index_get(a.index[0].projection_head, x)
    loop pi >= 0:
        p = a.projections[pi]
        pi = a.index[0].projection_next[pi]
        if p.element: return false
        count += 1
        qi = fact_index_get(b.index[0].projection_index, fact_projection_key(y, p.selector, false))
        if qi < 0 or b.projections[qi].value != p.value: return false
    qi = fact_index_get(b.index[0].projection_head, y)
    loop qi >= 0:
        count -= 1
        qi = b.index[0].projection_next[qi]
    count == 0 and fact_incident(a, x) < 0 and fact_incident(b, y) < 0

fact_loop_stable = (a: FactState, b: FactState) -> bool:
    loop binding in a.bindings:
        i = fact_binding(b, binding.place)
        if i < 0: return false
        x = fact_bound(a, binding.value)
        y = fact_bound(b, b.bindings[i].value)
        if x.lo != y.lo or x.hi != y.hi or x.nz != y.nz or fact_terms[binding.value].type != fact_terms[b.bindings[i].value].type: return false
        # Aggregate identity carries its projections; an equal top interval
        # alone is not evidence that a changed aggregate has stabilized. Two
        # header aggregates with no projections or rows are both top.
        t = if binding.place.root == .local: int(locals[binding.place.declaration].type) else: int(globals[binding.place.declaration].type)
        if not fact_scalar(t) and binding.value != b.bindings[i].value and not (fact_top(a, binding.value) and fact_top(b, b.bindings[i].value)) and not fact_same_shape(a, b, binding.value, b.bindings[i].value): return false
    # Carried rows must return unchanged, renamed into the next frame.
    if a.differences.len() != b.differences.len(): return false
    renamed: {int: int} = {}
    loop binding in a.bindings:
        if renamed.has(binding.value): continue
        i = fact_binding(b, binding.place)
        renamed[binding.value] = if i >= 0: b.bindings[i].value else: 0
    loop row in a.differences:
        x = renamed.get(row.a) ?? row.a
        y = renamed.get(row.b) ?? row.b
        i = fact_row_find(b, x, y)
        if i < 0 or b.differences[i].limit != row.limit: return false
    true

# Iterator transfers publish their pre-killed exit state and optional counted
# lengths, not the body's backedge. In a return-summary run the body is only
# demanded if it can itself return from this function. Checking runs still
# visit it for every obligation. The memoized query is O(nodes + edges).
fact_may_return = (n: int) -> bool:
    if n == 0: return false
    if let known = fact_returns_cache.get(n): return known
    yes = nodes[n].kind == .return_
    if not yes:
        loop c in fact_slice_children(n):
            if fact_may_return(c): yes = true; break
    fact_returns_cache[n] = yes
    yes

fact_loop_body = (n: int, body: mut FactState) -> FactLoop:
    if nodes[n].kind == .for_ and fact_summary_owner != 0 and not fact_may_return(int(nodes[n].b)): return FactLoop()
    fact_loops.push(FactLoop())
    fact_capture(int(nodes[n].b), body)
    edges = fact_loops.pop()
    edges.back = fact_join(edges.back, body, n)
    edges

fact_while = (n: int, s: mut FactState):
    outer = fact_speculating
    entry = s
    header = s
    settled = false
    fact_speculating += 1
    # Eager interval widening converges quickly; a fourth round lets
    # dependencies between changing counters settle before validation.
    paths = FactPaths(FactState(live = false), FactState(live = false), FactBound())
    edges = FactLoop()
    loop iteration in [0..4):
        if fact_loop_exhausted: break
        paths = fact_condition(int(nodes[n].a), header)
        edges = fact_loop_body(n, paths.yes)
        next = fact_loop_header(entry, edges.back, header, n, true)
        settled = fact_loop_stable(header, next)
        header = next
        if settled: break
    if settled and not fact_loop_exhausted:
        # A settled round's header equals the one it ran with, so its
        # backedge is what a run with the settled header gives: narrow from
        # it rather than walking the body again.
        next = fact_loop_header(entry, edges.back, header, n, false)
        same = fact_loop_stable(header, next)
        header = next
        # (inside an enclosing loop's speculation nothing is published: a
        # header that narrowing left unchanged exits as the settled round did)
        if same and outer > 0:
            fact_speculating = outer
            s = fact_join(paths.no, edges.exits, n)
            return
    fact_speculating = outer
    if not settled or fact_loop_exhausted:
        # Restart at top for every syntactically changing route, then validate
        # normally. Speculative obligation answers are never published.
        header = entry
        fact_changes(n, header, n, .budget)
    paths = fact_condition(int(nodes[n].a), header)
    edges = fact_loop_body(n, paths.yes)
    s = fact_join(paths.no, edges.exits, n)

# A comprehension that fills a fixed-size array of plain elements in place:
# `let acc=[]`, one range or array loop whose body is straight-line
# declarations ending in one push onto acc, then acc. Its push, or 0.
fact_fixed_comprehension = (b: int, to: int) -> int:
    if nodes[b].kind != .block or not has_flag(b, NF_COMPREHENSION) or nkids(b) != 3 or not files[pos_file(nodes[b].pos)].is_dewy: return 0
    t = fact_type(to)
    if tkind(t) != .fixed or is_managed(int(types[t].elem)) or ownership_type(int(types[t].elem)): return 0
    decl = kid(b, 0)
    loop_ = kid(b, 1)
    last = kid(b, 2)
    if nodes[decl].kind != .vardecl or nodes[decl].sym <= 0 or nkids(decl) != 0 or nodes[loop_].kind != .for_ or nodes[last].kind != .exprstmt: return 0
    acc = int(nodes[decl].sym)
    init = int(nodes[decl].b)
    if init == 0 or nodes[init].kind != .array or nkids(init) != 0 or nodes[init].b != 0: return 0
    if not type_eq(telem(int(locals[acc].type)), int(types[t].elem)): return 0
    result = int(nodes[last].a)
    if nodes[result].kind != .ident or nodes[result].sym != i32(acc): return 0
    if nodes[loop_].aux == 0:
        it = int(nodes[loop_].a)
        if nodes[it].kind != .range or nodes[it].b == 0 or has_flag(it, NF_STEP): return 0
    else if nodes[loop_].aux == 1:
        k = tkind(ntype(int(nodes[loop_].a)))
        if k != .array and k != .fixed: return 0
    else: return 0
    if fact_mentions(int(nodes[loop_].a), acc): return 0
    body = int(nodes[loop_].b)
    nb = nkids(body)
    if nb == 0 or nodes[kid(body, nb - 1)].kind != .exprstmt: return 0
    loop i in [0..nb - 1):
        item = kid(body, i)
        if nodes[item].kind != .vardecl or not comprehension_value(int(nodes[item].b)) or fact_mentions(int(nodes[item].b), acc): return 0
    push = int(nodes[kid(body, nb - 1)].a)
    if nodes[push].kind != .intrinsic or nodes[push].aux != i32(int(IN.push)) or nkids(push) != 2: return 0
    receiver = kid(push, 0)
    if nodes[receiver].kind != .ident or nodes[receiver].sym != i32(acc) or not comprehension_value(kid(push, 1)) or fact_mentions(kid(push, 1), acc): return 0
    push

# Its loop runs exactly the fixed length's times: a range from 0 to that
# constant, or an array loop over a fixed array of that length.
fact_fixed_comprehension_exact = (b: int, to: int) -> bool:
    n = fixed_len(fact_type(to))
    loop_ = kid(b, 1)
    if nodes[loop_].aux == 1: return tkind(fact_type(ntype(int(nodes[loop_].a)))) == .fixed and fixed_len(fact_type(ntype(int(nodes[loop_].a)))) == n
    it = int(nodes[loop_].a)
    known_lo, lo = integer_constant(int(nodes[it].a))
    known_hi, hi = integer_constant(int(nodes[it].b))
    if not known_lo or not known_hi: return false
    if has_flag(it, NF_INCLUSIVE): hi += 1
    lo == 0 and hi == n

# A counted push: a local array the loop body pushes onto exactly once on
# every completed iteration, with readonly uses but no other mutation (no
# break or continue), so after the loop its length is its entry length plus the
# iteration count (a comprehension's accumulator, `out.push(f(x))`).
fact_mentions = (n: int, l: int) -> bool:
    if n == 0: return false
    k = nodes[n].kind
    if k == .ident: return nodes[n].aux == i32(int(SK.local)) and nodes[n].sym == i32(l)
    mask = isolation_children(k)
    if mask < 0: return k != .lambda
    if mask & 1 != 0 and fact_mentions(int(nodes[n].a), l): return true
    if mask & 2 != 0 and fact_mentions(int(nodes[n].b), l): return true
    if mask & 4 != 0 and fact_mentions(int(nodes[n].c), l): return true
    if mask & 16 != 0:
        loop c in kids(n):
            if fact_mentions(c, l): return true
    false

fact_labeled_exit = (n: int) -> bool:
    if n == 0: return false
    k = nodes[n].kind
    if k == .break_ or k == .continue_: return nodes[n].name != 0
    mask = isolation_children(k)
    if mask < 0: return k != .lambda
    if mask & 1 != 0 and fact_labeled_exit(int(nodes[n].a)): return true
    if mask & 2 != 0 and fact_labeled_exit(int(nodes[n].b)): return true
    if mask & 4 != 0 and fact_labeled_exit(int(nodes[n].c)): return true
    if mask & 16 != 0:
        loop c in kids(n):
            if fact_labeled_exit(c): return true
    false

fact_push_receiver = (e: int) -> int:
    if nodes[e].kind == .ident and nodes[e].aux == i32(int(SK.local)): return int(nodes[e].sym)
    0

# The pushes onto l on every path through n, or -1 when paths differ or l is
# used otherwise.
fact_push_count = (n: int, l: int) -> int:
    if n == 0: return 0
    k = nodes[n].kind
    if k == .break_ or k == .continue_: return -1
    if k == .lambda: return 0
    if k == .intrinsic and nodes[n].aux == i32(int(IN.push)) and nkids(n) == 2 and fact_push_receiver(kid(n, 0)) == l:
        inner = fact_push_count(kid(n, 1), l)
        return if inner < 0: -1 else: inner + 1
    # Readonly indexing/length arithmetic may inspect the growing array.
    # Other calls, storage escapes and writes cannot mint a growth fact.
    if k == .assign and fact_mentions(int(nodes[n].a), l): return -1
    if (k == .call or k == .addr or k == .intrinsic and nodes[n].aux != i32(int(IN.len))) and fact_mentions(n, l): return -1
    # (a nested loop may exit this one only through a labeled break or continue)
    if k == .while_ or k == .for_: return if fact_mentions(n, l) or fact_labeled_exit(n): -1 else: 0
    if k == .and_ or k == .or_ or k == .coalesce: return if fact_mentions(n, l): -1 else: 0
    if k == .if_ or k == .iflet:
        if fact_mentions(int(nodes[n].a), l): return -1
        y = fact_push_count(int(nodes[n].b), l)
        z = fact_push_count(int(nodes[n].c), l)
        return if y == z: y else: -1
    if k == .match_:
        if fact_mentions(int(nodes[n].a), l): return -1
        common = -2
        exhaustive = false
        loop arm in kids(n):
            if fact_mentions(int(nodes[arm].a), l) or fact_mentions(int(nodes[arm].c), l): return -1
            loop p in kids(arm):
                if fact_mentions(p, l): return -1
                if nodes[p].kind == .pwild and nodes[arm].a == 0 and nodes[arm].c == 0: exhaustive = true
            c = fact_push_count(int(nodes[arm].b), l)
            if c < 0 or common >= 0 and c != common: return -1
            common = c
        if common < 0: return 0
        return if exhaustive or common == 0: common else: -1
    if k == .ident: return 0
    mask = isolation_children(k)
    if mask < 0: return -1
    total = 0
    parts: int[]
    if mask & 1 != 0: parts.push(int(nodes[n].a))
    if mask & 2 != 0: parts.push(int(nodes[n].b))
    if mask & 4 != 0: parts.push(int(nodes[n].c))
    if mask & 16 != 0: parts += kids(n)
    loop c in parts:
        x = fact_push_count(c, l)
        if x < 0: return -1
        total += x
    total

# Each counted-push local of loop n with its entry length.
fact_counted_pushes = (n: int, s: mut FactState) -> (int, int)[]:
    found: (int, int)[]
    body = int(nodes[n].b)
    candidates: int[]
    fact_push_candidates(body, candidates)
    loop l in candidates:
        if int(locals[l].flags) & (LF_CAPTURED | LF_SHARED | LF_ADDR | LF_BYREF | LF_ALIAS | LF_MUTPARAM | LF_EXPOSED) != 0: continue
        if tkind(fact_type(int(locals[l].type))) != .array: continue
        if fact_mentions(int(nodes[n].a), l) or fact_push_count(body, l) != 1: continue
        i = fact_binding(s, PlaceIdentity(.local, int(locals[l].owner), l))
        if i < 0: continue
        found.push((l, fact_project(s, s.bindings[i].value, -1, false, T_INT)))
    found

# A counted push never shrinks its receiver. Seed the entry lower bound at
# each head; its upper bound remains unknown until the counted exit.
# O(candidate arrays), using the same checked inventory as counted lengths.
fact_growing_lengths = (s: mut FactState, pushes: (int, int)[]):
    loop item in pushes:
        lower = fact_bound(s, item.1).lo
        if lower <= 0: continue
        i = fact_binding(s, PlaceIdentity(.local, int(locals[item.0].owner), item.0))
        if i < 0: continue
        length = fact_project(s, s.bindings[i].value, -1, false, T_INT)
        b = fact_bound(s, length)
        b.lo = max(b.lo, lower)
        fact_set_bound(s, length, b)

fact_push_candidates = (n: int, out: mut int[]):
    if n == 0 or out.len() >= 8: return
    k = nodes[n].kind
    if k == .intrinsic and nodes[n].aux == i32(int(IN.push)) and nkids(n) == 2:
        l = fact_push_receiver(kid(n, 0))
        if l > 0 and not out.contains(l): out.push(l)
    mask = isolation_children(k)
    if mask < 0: return
    if mask & 1 != 0: fact_push_candidates(int(nodes[n].a), out)
    if mask & 2 != 0: fact_push_candidates(int(nodes[n].b), out)
    if mask & 4 != 0: fact_push_candidates(int(nodes[n].c), out)
    if mask & 16 != 0:
        loop c in kids(n): fact_push_candidates(c, out)

# After the loop: each counted local's length is its entry length plus count.
fact_counted_lengths = (n: int, s: mut FactState, pushes: (int, int)[], count: int):
    if count == 0: return
    c = fact_bound(s, count)
    if c.lo < 0: return
    loop entry in pushes:
        i = fact_binding(s, PlaceIdentity(.local, int(locals[entry.0].owner), entry.0))
        if i < 0: continue
        e = fact_bound(s, entry.1)
        lo = if fact_add_fits(e.lo, c.lo): e.lo + c.lo else: 0
        hi = if fact_add_fits(e.hi, c.hi): e.hi + c.hi else: FACT_MAX
        total = fact_new(s, FactBound(min(max(lo, 0), fact_length_max()), min(hi, fact_length_max())), FactTerm(.plus, entry.1, count, n, T_INT))
        if e.lo == e.hi:
            fact_difference(s, total, count, e.lo, n)
            fact_difference(s, count, total, -e.lo, n)
        if s.projections.len() < FACT_CAP: fact_add_projection(s, FactProjection(s.bindings[i].value, -1, false, total))

# Relations a range loop keeps between scalars it changes (`low <=? high`
# while tracking a minimum and maximum): pairs of changed scalar places whose
# entry values a row (or one shared value) relates. Candidates only, to be
# validated by fact_range_invariants. A value with one known value (a
# constant start) is left to its interval. At most 8 places, 8 rows.
fact_range_candidates = (pre: FactState, s: FactState) -> (PlaceIdentity, PlaceIdentity, int)[]:
    out: (PlaceIdentity, PlaceIdentity, int)[]
    places: PlaceIdentity[]
    starts: int[]
    loop binding in s.bindings:
        if places.len() >= 8: break
        if binding.place.root != .local: continue
        i = fact_binding(pre, binding.place)
        if i < 0 or pre.bindings[i].value == binding.value or not fact_scalar(int(locals[binding.place.declaration].type)): continue
        start = pre.bindings[i].value
        b = fact_bound(pre, start)
        if b.lo == b.hi: continue
        places.push(binding.place)
        starts.push(start)
    if places.len() < 2: return out
    loop i in [0..places.len()):
        loop j in [0..places.len()):
            if i == j or out.len() >= 8: continue
            d = fact_shortest(pre, starts[i], starts[j])
            if d != FACT_MAX: out.push((places[i], places[j], d))
    out

fact_range_assume = (s: mut FactState, rows: (PlaceIdentity, PlaceIdentity, int)[], at: int):
    loop row in rows:
        i = fact_binding(s, row.0)
        j = fact_binding(s, row.1)
        if i >= 0 and j >= 0: fact_difference(s, s.bindings[i].value, s.bindings[j].value, row.2, at)

# The candidates every backedge and break keeps (a state that is not live
# keeps them all).
fact_range_kept = (edges: FactLoop, rows: (PlaceIdentity, PlaceIdentity, int)[]) -> (PlaceIdentity, PlaceIdentity, int)[]:
    out: (PlaceIdentity, PlaceIdentity, int)[]
    loop row in rows:
        held = true
        loop t in [edges.back, edges.exits]:
            if not t.live: continue
            i = fact_binding(t, row.0)
            j = fact_binding(t, row.1)
            if i < 0 or j < 0 or not fact_distance(t, t.bindings[i].value, t.bindings[j].value, row.2): held = false
        if held: out.push(row)
    out

# A range loop's body with its loop value bound and bounded by the range.
fact_range_body = (n: int, s: FactState, lo: int, hi: int) -> FactState:
    iterator = int(nodes[n].a)
    body = s
    l = int(nodes[n].sym)
    v = fact_new(body, fact_domain(int(locals[l].type)))
    fact_bind(body, PlaceIdentity(.local, int(locals[l].owner), l), v)
    lower = fact_new(body, fact_domain(T_BOOL), FactTerm(.ge, v, lo))
    upper = fact_new(body, fact_domain(T_BOOL), FactTerm((if has_flag(iterator, NF_INCLUSIVE): Tok.le else: Tok.lt), v, hi))
    fact_assume(body, lower, true)
    if nodes[iterator].b != 0: fact_assume(body, upper, true)
    body

# Houdini over the candidates: a speculative pass with all of them assumed at
# the head drops those a backedge or break loses, and a second pass must keep
# the rest, or none is kept. Each kept row holds at entry and is preserved, so
# it holds at every head and at the exit. At most two extra body passes, only
# for a loop with related changing scalars.
fact_range_invariants = (n: int, pre: FactState, s: mut FactState, lo: int, hi: int):
    if fact_loop_exhausted: return
    rows = fact_range_candidates(pre, s)
    if rows.len() == 0: return
    outer = fact_speculating
    fact_speculating += 1
    settled = false
    loop round in [0..2):
        trial = s
        fact_range_assume(trial, rows, n)
        body = fact_range_body(n, trial, lo, hi)
        edges = fact_loop_body(n, body)
        if not edges.back.live and not edges.exits.live: break
        kept = fact_range_kept(edges, rows)
        if kept.len() == rows.len():
            settled = true
            break
        rows = kept
        if rows.len() == 0: break
    fact_speculating = outer
    if settled and not fact_loop_exhausted: fact_range_assume(s, rows, n)

# A bounded range can update a private scalar at most once per iteration.
# Use declared operand ranges, not a speculative backedge: even conditional
# updates stay within entry + [0,count] * delta. O(body nodes); nested loops
# and exposed locals remain unknown. Fixed-width targets are demanded only by
# static exact stores. A mathematical int counter (`count += 1`) needs no
# store proof; its sum bounds later narrowing of the counter.
fact_range_sums = (n: int, s: FactState, lo: int, hi: int) -> (int, FactBound)[]:
    it = int(nodes[n].a)
    if nodes[it].b == 0: return []
    x = fact_bound(s, lo); y = fact_bound(s, hi)
    if x.wide or y.wide or x.lo == FACT_MIN or y.hi == FACT_MAX or not fact_add_fits(y.hi, -x.lo): return []
    count = max(0, y.hi - x.lo)
    if has_flag(it, NF_INCLUSIVE):
        if count == FACT_MAX: return []
        count += 1
    fact_counted_sums(n, s, count)

# The sums of a loop that runs at most count times (see fact_range_sums).
fact_counted_sums = (n: int, s: FactState, count: int) -> (int, FactBound)[]:
    out: (int, FactBound)[]
    exact = exact_proof_demands.has(fact_owner) and count <= 1048576
    work = [int(nodes[n].b)]
    stores: (int, int)[]
    seen: {int: bool} = {}
    bad: {int: bool} = {}
    loop work.len() > 0:
        e = work.pop()
        if e == 0: continue
        k = nodes[e].kind
        if k == .while_ or k == .for_ or k == .lambda or k == .partial or k == .defer_: return out
        if k == .assign:
            a = int(nodes[e].a)
            if nodes[a].kind == .tuple: return out
            if nodes[a].kind == .ident and nodes[a].aux == i32(int(SK.local)):
                l = int(nodes[a].sym)
                if seen.has(l): bad[l] = true
                seen[l] = true
                store = int(nodes[e].b)
                operation = 0
                if exact_has_store(store):
                    if exact and fact_exact_demand(store): operation = fact_progress_strip(int(nodes[store].a))
                else if fact_type(int(locals[l].type)) == T_MATH_INT: operation = fact_progress_strip(store)
                if operation > 0 and nodes[operation].kind == .binary and nodes[operation].aux == 0 and (nodes[operation].op == i32(int(Tok.plus)) or nodes[operation].op == i32(int(Tok.minus))) and fact_progress_same(a, int(nodes[operation].a)) and not exact_has_node(int(nodes[operation].b)):
                    stores.push((l, operation))
                else: bad[l] = true
        mask = isolation_children(k)
        if mask < 0: return out
        if mask & 1 != 0: work.push(int(nodes[e].a))
        if mask & 2 != 0: work.push(int(nodes[e].b))
        if mask & 4 != 0: work.push(int(nodes[e].c))
        if mask & 16 != 0:
            loop c in kids(e): work.push(c)
    loop item in stores:
        l = item.0; e = item.1
        if bad.has(l) or int(locals[l].flags) & (LF_CAPTURE | LF_CAPTURED | LF_SHARED | LF_ADDR | LF_BYREF | LF_ALIAS | LF_MUTPARAM | LF_EXPOSED) != 0: continue
        i = fact_binding(s, PlaceIdentity(.local, int(locals[l].owner), l))
        if i < 0: continue
        entry = fact_bound(s, s.bindings[i].value)
        rhs = int(nodes[e].b)
        # A widening conversion keeps the operand's declared interval.
        loop nodes[rhs].kind == .conv and nodes[rhs].aux == i32(int(CV.int_)):
            before = fact_domain(ntype(int(nodes[rhs].a)))
            after = fact_domain(ntype(rhs))
            if before.wide or after.wide or before.lo < after.lo or before.hi > after.hi: break
            rhs = int(nodes[rhs].a)
        delta = fact_domain(ntype(rhs))
        # (a literal step is its own interval; a mathematical int is unbounded)
        if nodes[rhs].kind == .int_lit and not oversized_literal(rhs) and not has_flag(rhs, NF_U64): delta = FactBound(nodes[rhs].ival, nodes[rhs].ival)
        else if fact_type(ntype(rhs)) == T_MATH_INT: continue
        if entry.wide or delta.wide or delta.lo < -2147483648 or delta.hi > 2147483647: continue
        low = min(0, delta.lo); high = max(0, delta.hi)
        if nodes[e].op == i32(int(Tok.minus)):
            low = min(0, -delta.hi); high = max(0, -delta.lo)
        if count > 0 and (-low > FACT_MAX / count or high > FACT_MAX / count): continue
        low *= count; high *= count
        # (a mathematical int's endpoint sentinels mean unbounded: keep them)
        if low != 0 and entry.lo == FACT_MIN or high != 0 and entry.hi == FACT_MAX: continue
        if not fact_add_fits(entry.lo, low) or not fact_add_fits(entry.hi, high): continue
        out.push((l, FactBound(entry.lo + low, entry.hi + high)))
    out

fact_range = (n: int, s: mut FactState):
    iterator = int(nodes[n].a)
    lo = fact_capture(int(nodes[iterator].a), s)
    hi = fact_capture(int(nodes[iterator].b), s)
    pushes = fact_counted_pushes(n, s)
    sums = fact_range_sums(n, s, lo, hi)
    # A local the body sets only to the loop's value (`best=i`, the argmax)
    # holds its entry value or some earlier i: at most hi-1 whenever its
    # entry value is (a sentinel -1, a first index 0).
    kept: (int, FactBound, bool, bool)[]
    if nodes[iterator].b != 0 and not has_flag(iterator, NF_INCLUSIVE) and int(nodes[n].sym) != 0:
        loop l in fact_index_carried(int(nodes[n].b), int(nodes[n].sym)):
            i = fact_binding(s, PlaceIdentity(.local, int(locals[l].owner), l))
            if i < 0: continue
            e = s.bindings[i].value
            kept.push((l, fact_bound(s, e), fact_entails(s, e, hi, -1), fact_entails(s, e, lo, 0)))
    pre = s
    fact_changes(n, s, n)
    loop sum in sums:
        i = fact_binding(s, PlaceIdentity(.local, int(locals[sum.0].owner), sum.0))
        if i >= 0: fact_set_bound(s, s.bindings[i].value, sum.1)
    loop entry in kept:
        i = fact_binding(s, PlaceIdentity(.local, int(locals[entry.0].owner), entry.0))
        if i < 0: continue
        v = s.bindings[i].value
        x = fact_bound(s, lo); y = fact_bound(s, hi)
        b = fact_bound(s, v)
        b.lo = max(b.lo, min(entry.1.lo, x.lo))
        if y.hi != FACT_MIN: b.hi = min(b.hi, max(entry.1.hi, y.hi - 1))
        fact_set_bound(s, v, b)
        if entry.2: fact_difference(s, v, hi, -1, n)
    if s.live and int(nodes[n].sym) != 0: fact_range_invariants(n, pre, s, lo, hi)
    after = s
    body = fact_range_body(n, s, lo, hi)
    fact_growing_lengths(body, pushes)
    # A nonempty iteration establishes lo < hi. Entry <= lo and every
    # replacement < hi therefore bound the carried value inside the body,
    # even when a zero-iteration exit cannot establish entry < hi.
    loop entry in kept:
        if not entry.3: continue
        i = fact_binding(body, PlaceIdentity(.local, int(locals[entry.0].owner), entry.0))
        if i >= 0: fact_difference(body, body.bindings[i].value, hi, -1, n)
    edges = fact_loop_body(n, body)
    fact_range_exhaustion(n, pre, lo, 0, edges)
    s = after
    if pushes.len() > 0 and nodes[iterator].b != 0:
        # (the iteration count, hi-lo or hi-lo+1, when the range is not reversed)
        extra = if has_flag(iterator, NF_INCLUSIVE): 1 else: 0
        x = fact_bound(s, lo); y = fact_bound(s, hi)
        if fact_compare(s, .le, lo, hi) == 1 or extra == 1 and fact_compare(s, .le, lo, hi) >= 0 and x.lo == x.hi and y.lo == y.hi and y.lo + 1 >= x.lo:
            if x.lo != FACT_MIN and y.lo != FACT_MIN and fact_add_fits(y.hi, -x.lo + extra) and fact_add_fits(y.lo, -x.hi + extra):
                count = fact_new(s, FactBound(max(0, y.lo - x.hi + extra), y.hi - x.lo + extra), FactTerm(.minus, hi, lo, n, T_INT))
                if x.lo == x.hi:
                    fact_difference(s, count, hi, extra - x.lo, n)
                    fact_difference(s, hi, count, x.lo - extra, n)
                fact_counted_lengths(n, s, pushes, count)
                return
        # (`[0..n)` runs max(0, n) times, the length `fill(x n)` has)
        if extra == 0 and x.lo == 0 and x.hi == 0:
            fact_counted_lengths(n, s, pushes, fact_clamped(s, hi, n))
            return
        # (an unknown count is still never negative: the pushes only grow it)
        fact_counted_lengths(n, s, pushes, fact_new(s, FactBound(0, FACT_MAX)))

# Locals that body writes only by `x = l` (l the loop variable), and nothing
# else: no compound or other stores, no `@x`, no closure. O(body nodes).
fact_index_carried = (body: int, l: int) -> int[]:
    copies: {int: bool} = {l: true}   # l and locals declared as its copy
    stores: (int, int)[]              # (target, the local it is set to, or 0)
    bad: {int: bool} = {}
    work = [body]
    loop work.len() > 0:
        e = work.pop()
        if e == 0: continue
        k = nodes[e].kind
        if k == .lambda or k == .partial: return []
        if k == .vardecl and nodes[e].sym > 0 and nodes[e].b != 0 and nkids(e) == 0:
            value = int(nodes[e].b)
            if nodes[value].kind == .ident and nodes[value].aux == i32(int(SK.local)) and int(nodes[value].sym) == l: copies[int(nodes[e].sym)] = true
        if k == .assign and nodes[int(nodes[e].a)].kind == .ident and nodes[int(nodes[e].a)].aux == i32(int(SK.local)):
            target = int(nodes[int(nodes[e].a)].sym)
            value = int(nodes[e].b)
            # (a value-preserving integer conversion, `best=i` into an `int`)
            loop nodes[value].kind == .conv and nodes[value].aux == i32(int(CV.int_)): value = int(nodes[value].a)
            if nodes[e].op == i32(int(Tok.assign)) and nodes[value].kind == .ident and nodes[value].aux == i32(int(SK.local)): stores.push((target, int(nodes[value].sym)))
            else: bad[target] = true
        if k == .addr and nodes[int(nodes[e].a)].kind == .ident: bad[int(nodes[int(nodes[e].a)].sym)] = true
        mask = isolation_children(k)
        if mask < 0: return []
        if mask & 1 != 0: work.push(int(nodes[e].a))
        if mask & 2 != 0: work.push(int(nodes[e].b))
        if mask & 4 != 0: work.push(int(nodes[e].c))
        if mask & 16 != 0:
            loop c in kids(e): work.push(c)
        if mask & 32 != 0:
            loop c in kids2(e): work.push(c)
    loop store in stores:
        if not copies.has(store.1) or copies.has(store.0): bad[store.0] = true
    out: int[]
    loop store in stores:
        if not bad.has(store.0) and not fact_exposed(PlaceIdentity(.local, int(locals[store.0].owner), store.0)) and fact_scalar(int(locals[store.0].type)) and store.0 not in out: out.push(store.0)
    out

# A stepped range `[first,second..end)`: the step's sign, when known, bounds
# each value between first and end (the lowering stops before passing end).
fact_stepped = (n: int, s: mut FactState):
    iterator = int(nodes[n].a)
    first = fact_capture(int(nodes[iterator].a), s)
    second = fact_capture(int(nodes[iterator].c), s)
    end = if nodes[iterator].b != 0: fact_capture(int(nodes[iterator].b), s) else: 0
    up = fact_compare(s, .lt, first, second) == 1
    down = fact_compare(s, .lt, second, first) == 1
    if not up and not down or fact_probe_on: fact_step_check(n, s, first, second, int(nodes[iterator].a), int(nodes[iterator].c))
    entry = s
    fact_changes(n, s, n)
    after = s
    body = s
    l = int(nodes[n].sym)
    v = fact_new(body, fact_domain(int(locals[l].type)))
    fact_bind(body, PlaceIdentity(.local, int(locals[l].owner), l), v)
    inclusive = has_flag(iterator, NF_INCLUSIVE)
    if up or down:
        near = if up: FactTerm(.ge, v, first) else: FactTerm(.le, v, first)
        fact_assume(body, fact_new(body, fact_domain(T_BOOL), near), true)
        if end != 0:
            far = if up: FactTerm((if inclusive: Tok.le else: Tok.lt), v, end) else: FactTerm((if inclusive: Tok.ge else: Tok.gt), v, end)
            fact_assume(body, fact_new(body, fact_domain(T_BOOL), far), true)
    edges = fact_loop_body(n, body)
    fact_range_exhaustion(n, entry, first, second, edges)
    s = after

# Each iteration's hidden index lies in [0, length) of the source's entry
# value; the source is a snapshot, so a body that resizes the original
# rebinds that place and the length stays the snapshot's.
fact_loop_index = (n: int, base: int, s: mut FactState):
    t = fact_type(ntype(int(nodes[n].a)))
    if types[t].kind != .array and types[t].kind != .fixed: return
    length = if types[t].kind == .fixed: fact_constant(s, fixed_len(t)) else: fact_project(s, base, -1, false, T_INT)
    l = int(nodes[n].c)
    hi = fact_bound(s, length).hi
    v = fact_new(s, FactBound(0, (if hi > FACT_MIN: hi - 1 else: hi), reason = .loop_, witness = n), FactTerm(type = int(locals[l].type)))
    fact_bind(s, PlaceIdentity(.local, int(locals[l].owner), l), v)
    fact_difference(s, v, length, -1, n)
    fact_set_bound(s, v, fact_bound(s, v))

# A readonly iteration over a complete finite element inventory takes its
# interval hull, never one selected element's facts. Demand-only, O(P), capped
# by the ordinary projection budget. Mutations rebuild aggregate identities.
fact_loop_elements = (n: int, base: int, s: mut FactState):
    l = int(nodes[n].sym)
    if nodes[n].aux != 1 or l <= 0: return
    t = fact_type(int(locals[l].type))
    if not fact_scalar(t) and t != T_STR: return
    if t == T_STR:
        pi = fact_index_get(s.index[0].projection_index, fact_projection_key(base, FACT_ELEMENT_LENGTH, false))
        if pi >= 0:
            value = fact_new(s, FactBound(), FactTerm(type = t))
            if s.projections.len() < FACT_CAP: fact_add_projection(s, FactProjection(value, -1, false, s.projections[pi].value))
            fact_bind(s, PlaceIdentity(.local, int(locals[l].owner), l), value)
            return
    length = fact_bound(s, fact_project(s, base, -1, false, T_INT))
    if length.wide or length.lo != length.hi or length.lo <= 0 or length.hi > 64: return
    seen: {int: bool} = {}
    bound = FactBound()
    first = true
    pi = fact_index_get(s.index[0].projection_head, base)
    loop pi >= 0:
        p = s.projections[pi]
        pi = s.index[0].projection_next[pi]
        if not p.element: continue
        key = fact_bound(s, p.selector)
        if key.wide or key.lo != key.hi or key.lo < 0 or key.lo >= length.lo or seen.has(key.lo): continue
        seen[key.lo] = true
        v = p.value
        if t == T_STR: v = fact_project(s, v, -1, false, T_INT)
        b = fact_bound(s, v)
        bound = if first: b else: fact_hull(bound, b, n)
        first = false
    if seen.len() != length.lo: return
    value = fact_new(s, (if t == T_STR: FactBound() else: bound), FactTerm(type = t))
    if t == T_STR and s.projections.len() < FACT_CAP: fact_add_projection(s, FactProjection(value, -1, false, fact_new(s, bound)))
    fact_bind(s, PlaceIdentity(.local, int(locals[l].owner), l), value)

# A backwards slice of checked syntax and storage definitions. Build only for
# an actual consumer (obligations, a bounds probe, or a return summary). Each
# syntax/dependency edge is visited once: expected O(N+E), O(N+E) space. Storage
# is flow-insensitive here; the forward transfer still decides which write and
# guard reaches each obligation. Effects and control keep their original order.
fact_slice_children = (n: int) -> int[]:
    out: int[]
    mask = isolation_children(nodes[n].kind)
    if mask < 0: return out
    if mask & 1 != 0: out.push(int(nodes[n].a))
    if mask & 2 != 0: out.push(int(nodes[n].b))
    if mask & 4 != 0: out.push(int(nodes[n].c))
    if mask & 16 != 0:
        loop i in [0..nkids(n)): out.push(kid(n, i))
    out

# n's children onto out, in fact_slice_children's order (no list per node).
fact_slice_push_children = (out: mut int[], n: int):
    mask = isolation_children(nodes[n].kind)
    if mask < 0: return
    if mask & 1 != 0: out.push(int(nodes[n].a))
    if mask & 2 != 0: out.push(int(nodes[n].b))
    if mask & 4 != 0: out.push(int(nodes[n].c))
    if mask & 16 != 0:
        loop i in [0..nkids(n)): out.push(kid(n, i))

fact_slice_member = (parents: mut FactSliceEdges, work: mut int[], c: int, n: int):
    if c == 0: return
    fact_slice_parent(parents, c, n)
    work.push(c)

fact_slice_edge = (edges: mut FactSliceEdges, key: int, node: int):
    edges.next.push(fact_index_get(edges.heads, key))
    fact_index_put(edges.heads, key, edges.nodes.len())
    edges.nodes.push(node)

# Node-indexed scratch for building one slice: flags and the head of each
# node's parent-edge chain, valid where the stamp is the current generation.
# Membership costs O(1) without hashing; only the finished slice is indexed.
fact_mark_gen = 0
fact_mark_stamp: int[]
fact_mark_flags: int[]
fact_mark_head: int[]
fact_mark_touched: int[]

fact_mark_begin = ():
    if fact_mark_stamp.len() < nodes.len():
        fact_mark_stamp = fill(0, nodes.len() * 2 + 64)
        fact_mark_flags = fill(0, fact_mark_stamp.len())
        fact_mark_head = fill(0, fact_mark_stamp.len())
        fact_mark_gen = 0
    fact_mark_gen += 1
    fact_mark_touched = []

fact_mark_of = (n: int) -> int:
    if fact_mark_stamp[n] != fact_mark_gen: return 0
    fact_mark_flags[n]

fact_mark_touch = (n: int):
    if fact_mark_stamp[n] == fact_mark_gen: return
    fact_mark_stamp[n] = fact_mark_gen
    fact_mark_flags[n] = 0
    fact_mark_head[n] = -1
    fact_mark_touched.push(n)

fact_mark_set = (n: int, flags: int):
    fact_mark_touch(n)
    fact_mark_flags[n] = flags

fact_mark_parent = (n: int) -> int:
    if fact_mark_stamp[n] != fact_mark_gen: return -1
    fact_mark_head[n]

fact_slice_parent = (parents: mut FactSliceEdges, child: int, node: int):
    fact_mark_touch(child)
    parents.next.push(fact_mark_head[child])
    fact_mark_head[child] = parents.nodes.len()
    parents.nodes.push(node)

fact_slice_writer = (writers: mut FactSliceEdges, p: PlaceIdentity, n: int):
    if p.declaration == 0: return
    key = fact_root_key(p)
    fact_slice_edge(writers, key, n)

fact_slice_target = (writers: mut FactSliceEdges, n: int, at: int):
    if nodes[n].kind == .tuple:
        loop c in kids(n): fact_slice_target(writers, c, at)
        return
    root = n
    loop nodes[root].kind == .field or nodes[root].kind == .index: root = int(nodes[root].a)
    fact_slice_writer(writers, fact_place(root), at)

# A contract reads its value and referenced actuals; proving it does not
# demand the callee's return summary. Called only for written argument
# contracts, O(predicate atoms), with node-indexed slice deduplication.
fact_slice_contract_actuals = (call: int, arg: int, values: mut int[]):
    values.push(arg)
    rt = prune(int(nodes[arg].aux2))
    if types[rt].kind != .refined:
        values.push(call)
        return
    loop atom in ref_predicates[int(types[rt].st)]:
        if (atom.a.kind == 2 or atom.a.kind == 5) and atom.a.value >= 0 and atom.a.value < nkids(call): values.push(kid(call, atom.a.value))
        if (atom.b.kind == 2 or atom.b.kind == 5) and atom.b.value >= 0 and atom.b.value < nkids(call): values.push(kid(call, atom.b.value))

fact_slice_prepare = (f: int, summary: bool = false):
    key = (f << 4) | int(summary) | (int(fact_probe_on) << 1) | (int(fact_policy == .RequireStatic) << 2) | (int(result_active or proof_active) << 3)
    if let cached = fact_slice_cache.get(key): fact_slice = cached; return
    # (O(body nodes + edges) for the slice: node-indexed scratch marks, an
    # expected O(1) index for writers and for the finished slice)
    fact_mark_begin()
    parents = FactSliceEdges()
    writers = FactSliceEdges()
    roots: int[]
    exposed_writes: int[]
    opaque_writes: int[]
    work = [int(fns[f].body)]
    values: int[]
    active: int[]
    forks: int[]
    probe_only = false
    if summary or result_active: values.push(int(fns[f].body))
    cursor = 0
    loop cursor < work.len():
        n = work[cursor]; cursor += 1
        if n == 0 or fact_mark_of(n) & FACT_MEMBER != 0: continue
        fact_mark_set(n, FACT_MEMBER)
        k = nodes[n].kind
        if not summary and fact_exact_demand(n): values.push(n)
        # (children visited in place, a, b, c then kids: no list per node)
        mask = isolation_children(k)
        if mask > 0:
            if mask & 1 != 0: fact_slice_member(parents, work, int(nodes[n].a), n)
            if mask & 2 != 0: fact_slice_member(parents, work, int(nodes[n].b), n)
            if mask & 4 != 0: fact_slice_member(parents, work, int(nodes[n].c), n)
            if mask & 16 != 0:
                loop i in [0..nkids(n)): fact_slice_member(parents, work, kid(n, i), n)
        if k == .vardecl:
            if ownership_decls.len() != 0 and nodes[n].b != 0 and ownership_fact_type(ntype(int(nodes[n].b))): active.push(n)
            l = int(nodes[n].sym)
            if l != 0:
                p = if has_flag(n, NF_GLOBAL): PlaceIdentity(.global, 0, l) else: PlaceIdentity(.local, int(locals[l].owner), l)
                fact_slice_writer(writers, p, n)
            loop c in kids(n):
                l = int(nodes[c].sym)
                if l > 0 and not has_flag(c, NF_GLOBAL): fact_slice_writer(writers, PlaceIdentity(.local, int(locals[l].owner), l), n)
        if k == .assign:
            target = int(nodes[n].a)
            fact_slice_target(writers, target, n)
            if not summary and (fact_probe_on or fact_policy == .RequireStatic) and fact_shift_obliged(n): values.push(n)
            root = target
            loop nodes[root].kind == .field or nodes[root].kind == .index: root = int(nodes[root].a)
            p = fact_place(root)
            if p.declaration == 0: opaque_writes.push(n)
            else if fact_exposed(p): exposed_writes.push(n)
        if k == .for_ or k == .iflet or k == .match_:
            l = int(nodes[n].sym)
            if l > 0: fact_slice_writer(writers, PlaceIdentity(.local, int(locals[l].owner), l), n)
            if k == .for_ and not summary and (fact_probe_on or fact_policy == .RequireStatic) and (fact_stepped_loop(n) or fact_open_range(n)): values.push(n)
        if k == .if_ or k == .while_ or k == .for_ or k == .iflet or k == .match_ or k == .and_ or k == .or_ or k == .coalesce:
            # A while can prevent a later obligation from being reached,
            # even when none of its writes feed that obligation.
            if k == .while_: active.push(n)
        else if k == .return_:
            active.push(n)
            if summary or result_active: values.push(int(nodes[n].a))
        else if k == .break_ or k == .continue_ or k == .defer_: active.push(n)
        else if k == .call:
            if ntype(n) == T_NEVER or nodes[n].aux == 0 and library_exit_call(n): active.push(n)
            if not summary and (fact_probe_on or fact_policy == .RequireStatic) and (fact_library_call(n, "parallel_range") or fact_library_call(n, "parallel_map")):
                loop arg in kids(n):
                    if nodes[arg].kind == .lambda and nodes[arg].sym > 0:
                        fact_fork_nodes[arg] = true
                        forks.push(arg)
            if result_active or proof_active or fact_divisors.has(n): values.push(n)
            else if not summary and (fact_probe_on or fact_policy == .RequireStatic) and fact_string_call(n) >= 2: values.push(n)
            else if not summary and (fact_probe_on or fact_policy == .RequireStatic) and fact_rational_zero_test(n) >= 0:
                values.push(n)
                values.push(kid(n, fact_rational_zero_test(n)))
            else if not summary and (fact_probe_on or fact_policy == .RequireStatic) and fact_power_call(n):
                values.push(n)
                values.push(kid(n, 1))
            else if not summary and (fact_probe_on or fact_policy == .RequireStatic) and fact_range_call(n):
                values.push(n)
                values.push(kid(n, 0))
                values.push(kid(n, 1))
            else if not summary and (fact_probe_on or fact_policy == .RequireStatic) and (fact_array_call(n) != 0 or fact_map_call(n) != 0):
                active.push(n)
                values.push(n)
                loop arg in kids(n): values.push(arg)
            else if fact_probe_on and fact_floor_call(n) != 0:
                values.push(n)
                probe_only = true
            loop arg in kids(n):
                if ownership_decls.len() != 0 and ownership_fact_type(ntype(arg)): active.push(n)
                if nodes[arg].kind == .conv and nodes[arg].aux == i32(int(CV.refinement)):
                    if nodes[n].aux == 0 and nodes[n].sym > 0:
                        fact_mark_set(n, fact_mark_of(n) | FACT_CONTRACT)
                        fact_slice_contract_actuals(n, arg, values)
                    else: values.push(n)
            if wi_fact_calls.len() > 0 and wi_fact_calls.has(n):
                values.push(n)
                loop arg in kids(n): values.push(arg)
            callee = int(nodes[n].sym)
            if nodes[n].aux == 0 and callee > 0 and ref_refined_result(int(fns[callee].ret)): values.push(n)
            if nodes[n].aux == 0 and callee > 0 and callee < effect_summaries.len() and effect_summaries[callee].done:
                loop event in effect_summaries[int(nodes[n].sym)].events:
                    if event.atom.kind == .opaque or event.atom.kind == .escape: exposed_writes.push(n)
                    if event.atom.kind != .write: continue
                    p = place_base(event.atom.place)
                    if p.root == .formal:
                        i = p.declaration - 1
                        p = if i >= 0 and i < nkids(n): place_base(place_route(kid(n, i))) else: PlaceIdentity(.local, 0, 0)
                    if p.declaration == 0: exposed_writes.push(n)
                    else:
                        fact_slice_writer(writers, p, n)
                        if fact_exposed(p): exposed_writes.push(n)
            else if nodes[n].aux != 2 and nodes[n].aux != 3:
                exposed_writes.push(n)
                mask = checked_call_mutmask(n)
                loop i in [0..nkids(n)):
                    if mask & (1 << i) != 0: fact_slice_target(writers, kid(n, i), n)
        else if k == .intrinsic:
            id = nodes[n].aux as IN
            if id == .push or id == .pop or id == .clear or id == .reserve or id == .insert or id == .remove or id == .extend or id == .truncate or id == .resize:
                fact_slice_target(writers, kid(n, 0), n)
                # (removing needs an element, truncating a nonnegative count)
                if not summary and fact_policy == .RequireStatic and (id == .pop or id == .remove or id == .truncate):
                    active.push(n)
                    values.push(n)
            else if id == .static_assert or id == .runtime_assert or id == .assert or id == .panic or id == .unreachable or id == .lend or id == .loan_length or id == .loan_store: values.push(n)
            else if id != .len and not fact_pure_intrinsic(id): opaque_writes.push(n)
        else if k == .index:
            if not summary and (fact_probe_on or fact_policy == .RequireStatic) and not has_flag(n, NF_INBOUNDS) and fact_bounded_index(n):
                active.push(n)
                values.push(int(nodes[n].b))
                if types[fact_type(ntype(int(nodes[n].a)))].kind != .fixed: values.push(int(nodes[n].a))
        else if k == .conv:
            if nodes[n].aux == i32(int(CV.refinement)): values.push(n)
            # (an `int` narrowed to a fixed width: an obligation, and effect_failure asks whether it fits)
            else if (fact_probe_on or fact_policy == .RequireStatic) and not summary and nodes[n].aux == i32(int(CV.int_)) and prune(ntype(int(nodes[n].a))) == T_MATH_INT and prune(ntype(n)) != T_MATH_INT: values.push(n)
            else if ownership_decls.len() != 0 and nodes[n].aux == i32(int(CV.explicit_copy)) and ownership_fact_type(ntype(n)): opaque_writes.push(n)
            else if nodes[n].aux != i32(int(CV.int_)) and nodes[n].aux != i32(int(CV.none_)) and nodes[n].aux != i32(int(CV.fixed2arr)) and not fact_pure_conversion(n): exposed_writes.push(n)
        else if k == .binary:
            if nodes[n].aux != 0 and not fact_pure_binary(n): exposed_writes.push(n)
            else if not summary and (fact_probe_on or fact_policy == .RequireStatic) and (nodes[n].op == i32(int(Tok.slash)) or nodes[n].op == i32(int(Tok.percent)) or fact_shift_obliged(n)): values.push(n)
        # (a closure writes only when called: fact_capture)
        else if k == .lambda and ownership_decls.len() == 0: pass
        else if k == .lambda or k == .partial or k == .fnref or k == .map_lit or k == .cast or mask < 0: opaque_writes.push(n)
        else if k == .str_lit and nodes[n].aux != 0: exposed_writes.push(n)
    # (a fork closure's creation reads its captures: their definitions)
    loop lam in forks:
        values.push(lam)
        loop cap in fns[int(nodes[lam].sym)].caps:
            o = int(cap.outer)
            if o <= 0: continue
            edge = fact_index_get(writers.heads, fact_root_key(PlaceIdentity(.local, int(locals[o].owner), o)))
            loop edge >= 0:
                definition = writers.nodes[edge]
                edge = writers.next[edge]
                if nodes[definition].kind == .call: active.push(definition)
                else: values.push(definition)
    cursor = 0
    acursor = 0
    any_root = false
    any_exposed = false
    loop cursor < values.len() or acursor < active.len():
        if acursor < active.len():
            n = active[acursor]; acursor += 1
            if n == 0: continue
            mark = fact_mark_of(n)
            if mark & FACT_ACTIVE != 0: continue
            fact_mark_set(n, mark | FACT_ACTIVE)
            edge = fact_mark_parent(n)
            loop edge >= 0:
                active.push(parents.nodes[edge])
                edge = parents.next[edge]
            k = nodes[n].kind
            if k == .if_ or k == .while_ or k == .for_ or k == .iflet or k == .match_ or k == .and_ or k == .or_ or k == .coalesce:
                values.push(int(nodes[n].a))
                if k == .match_:
                    loop arm in kids(n):
                        loop p in kids(arm): values.push(p)
            continue
        n = values[cursor]; cursor += 1
        if n == 0: continue
        mark = fact_mark_of(n)
        if mark & FACT_VALUE != 0: continue
        fact_mark_set(n, mark | FACT_VALUE)
        active.push(n)
        k = nodes[n].kind
        if k == .ident:
            p = fact_place(n)
            root = fact_root_key(p)
            if fact_index_get(roots, root) < 0:
                fact_index_put(roots, root, 0)
                edge = fact_index_get(writers.heads, root)
                loop edge >= 0:
                    definition = writers.nodes[edge]
                    edge = writers.next[edge]
                    if nodes[definition].kind == .call: active.push(definition)
                    else: values.push(definition)
            if not any_root:
                any_root = true
                loop w in opaque_writes: values.push(w)
            if not any_exposed and p.declaration != 0 and fact_exposed(p):
                any_exposed = true
                loop write in exposed_writes:
                    if nodes[write].kind == .call: active.push(write)
                    else: values.push(write)
            if nodes[n].aux == i32(int(SK.local)):
                l = int(nodes[n].sym)
                if int(locals[l].flags) & LF_ALIAS != 0 and locals[l].alias != 0: values.push(int(locals[l].alias))
        if k == .block:
            if nkids(n) > 0: values.push(kid(n, nkids(n) - 1))
        else if k == .for_ or k == .while_: values.push(int(nodes[n].a))
        # (a fork closure's creation reads its captures, pushed above, not its body)
        else if k == .lambda: pass
        else if k == .call and nodes[n].aux == 0 and not result_active and not proof_active and not fact_divisors.has(n) and fact_floor_call(n) == 0 and fact_string_call(n) == 0 and not fact_extremum_call(n) and not fact_empty_array_call(n) and not fact_split_call(n) and not fact_words_call(n) and not fact_search_call(n) and not ref_refined_result(int(fns[int(nodes[n].sym)].ret)):
            # Ordinary summaries start from unknown formals: their return
            # facts do not depend on the actual values. Argument obligations
            # and effects remain separate roots of this slice.
            ret = fact_type(int(fns[int(nodes[n].sym)].ret))
            array_result = tkind(ret) == .array
            # Array lengths also bound scalar search results. Demand these
            # actuals only for result kinds the summary domain can describe.
            if array_result or fact_scalar(ret) and is_int(ret) and ret != T_U64:
                loop arg in kids(n):
                    at = fact_type(ntype(arg))
                    if tkind(at) == .array or tkind(at) == .fixed or array_result and fact_scalar(at) and is_int(at) and at != T_U64: values.push(arg)
        else if k == .intrinsic and nodes[n].aux == i32(int(IN.remove)):
            values.push(kid(n, 0))
            values.push(kid(n, 1))
        else if k == .intrinsic and (nodes[n].aux == i32(int(IN.push)) or nodes[n].aux == i32(int(IN.pop)) or nodes[n].aux == i32(int(IN.clear)) or nodes[n].aux == i32(int(IN.reserve)) or nodes[n].aux == i32(int(IN.insert))): values.push(kid(n, 0))
        else if k == .intrinsic and (nodes[n].aux == i32(int(IN.extend)) or nodes[n].aux == i32(int(IN.truncate)) or nodes[n].aux == i32(int(IN.resize))):
            values.push(kid(n, 0))
            values.push(kid(n, 1))
        else: fact_slice_push_children(values, n)
    lo = nodes.len()
    hi = -1
    count = 0
    loop n in fact_mark_touched:
        if fact_mark_flags[n] != 0:
            lo = min(lo, n); hi = max(hi, n)
            count += 1
    if hi >= lo and hi - lo < 4 * count + 64:
        flags = fill(0, hi - lo + 1)
        loop n in fact_mark_touched:
            if fact_mark_flags[n] != 0: flags[n - lo] = fact_mark_flags[n]
        fact_slice = FactSlice(flags, probe_only, lo)
    else:
        flags = fact_index_sized(count)
        loop n in fact_mark_touched:
            if fact_mark_flags[n] != 0: fact_index_put(flags, n, fact_mark_flags[n])
        fact_slice = FactSlice(flags, probe_only)
    fact_slice_cache[key] = fact_slice

# At a fork closure's creation: its captures' facts, by capture. O(k^2)
# bounded relaxations for k <= 16 captured terms.
fact_fork_record = (lam: int, s: mut FactState):
    f = int(nodes[lam].sym)
    if f <= 0 or f >= fns.len(): return
    entry = FactForkEntry()
    values: int[]
    loop cap in fns[f].caps:
        o = int(cap.outer)
        inner = int(cap.inner)
        if o <= 0 or inner <= 0 or values.len() >= 16: continue
        flags = int(locals[inner].flags)
        t = fact_type(int(locals[o].type))
        snapshot = flags & LF_VALUECAP != 0
        array = tkind(t) == .array and (snapshot or flags & LF_PARTBORROW != 0)
        if not array and not (snapshot and fact_scalar(t) and is_int(t) and t != T_U64): continue
        p = PlaceIdentity(.local, int(locals[o].owner), o)
        i = fact_binding(s, p)
        v = 0
        if i >= 0: v = s.bindings[i].value
        else:
            v = fact_new(s, fact_domain(t), FactTerm(type = t))
            fact_bind(s, p, v)
        if v == 0: continue
        if array: v = fact_project(s, v, -1, false, T_INT)
        entry.inner.push(inner)
        entry.length.push(array)
        values.push(v)
    loop v in values: entry.bounds.push(fact_bound(s, v))
    loop i in [0..values.len()):
        loop j in [0..values.len()):
            if i == j: continue
            d = fact_shortest(s, values[i], values[j])
            if d != FACT_MAX: entry.rows.push(FactDifference(i, j, d))
    fact_fork_entries[lam] = entry

fact_fork_seed = (f: int, s: mut FactState):
    if fns[f].kind != FK_LAMBDA: return
    if let bound = fact_parallel_bounds.get(f):
        l = fns[f].params[0]
        value = fact_new(s, bound, FactTerm(type = T_INT))
        fact_bind(s, PlaceIdentity(.local, f, l), value)
    entry = fact_fork_entries.get(int(fns[f].decl)) ?? FactForkEntry()
    values: int[]
    loop i in [0..entry.inner.len()):
        inner = entry.inner[i]
        p = PlaceIdentity(.local, f, inner)
        v = fact_new(s, entry.bounds[i], FactTerm(type = T_INT))
        values.push(v)
        if entry.length[i]:
            t = int(locals[inner].type)
            array = fact_new(s, FactBound(), FactTerm(type = t))
            if s.projections.len() < FACT_CAP: fact_add_projection(s, FactProjection(array, -1, false, v))
            fact_bind(s, p, array)
        else: fact_bind(s, p, v)
    loop r in entry.rows: fact_difference(s, values[r.a], values[r.b], r.limit)

# Both value-demanded and contract-only calls check actuals after their
# effects, in the same source evaluation order and with the same entry.
fact_call_arguments = (n: int, s: mut FactState) -> int[]:
    values = fill(0, nkids(n))
    loop i in call_eval_order(n):
        arg = kid(n, i)
        if nodes[arg].kind == .conv and nodes[arg].aux == i32(int(CV.refinement)):
            outer = fact_covered
            fact_covered = fact_refinement_covers(arg)
            values[i] = fact_capture(int(nodes[arg].a), s)
            fact_covered = outer
        else: values[i] = fact_capture(arg, s)
        if ownership_decls.len() != 0: values[i] = fact_owner_value(arg, values[i], s)
    loop i in [0..nkids(n)):
        arg = kid(n, i)
        if nodes[arg].kind != .conv or nodes[arg].aux != i32(int(CV.refinement)): continue
        # (a refined arm of this function's own result, made a union
        # member: its formals are this function's parameters)
        if nodes[n].aux == 3 and nkids(n) == 1 and ref_signature_has(fact_owner, zonk(int(nodes[arg].aux2))): ref_check(arg, values[i], ref_fact_current_entry(s), s)
        else: ref_check(arg, values[i], values, s)
    values

# Undemanded values still execute their effectful descendants. Ordinary calls
# apply the same settled write summary without requesting a numeric return
# summary. Control, obligations and opaque operations use the full transfer.
fact_slice_capture = (n: int, s: mut FactState) -> int:
    k = nodes[n].kind
    if k == .call:
        fact_capture(int(nodes[n].a), s)
        if fact_slice_flags(n) & FACT_CONTRACT != 0: fact_call_arguments(n, s)
        else:
            loop i in call_eval_order(n):
                arg = kid(n, i)
                value = fact_capture(arg, s)
                if ownership_decls.len() != 0: fact_owner_value(arg, value, s)
        if nodes[n].aux != 2 and nodes[n].aux != 3: fact_path_call_effects(n, s)
        if fact_ends_path(n): s.live = false
        return 0
    if k == .vardecl or k == .assign:
        if k == .assign and nodes[n].op != i32(int(Tok.assign)): fact_capture(int(nodes[n].a), s)
        fact_capture(int(nodes[n].b), s)
        if ownership_decls.len() != 0: fact_owner_value(int(nodes[n].b), 0, s)
        if k == .assign:
            route = fact_route(int(nodes[n].a), s)
            if nodes[n].op == i32(int(Tok.assign)) and fact_speculating == 0:
                if fact_probe_on: fact_probe_route(s, route, fact_route_values(s, route))
                else if fact_policy == .RequireStatic or fact_query: fact_route_bounds(s, route, fact_route_values(s, route))
        return 0
    mask = isolation_children(k)
    if mask > 0:
        if mask & 1 != 0: fact_capture(int(nodes[n].a), s)
        if mask & 2 != 0: fact_capture(int(nodes[n].b), s)
        if mask & 4 != 0: fact_capture(int(nodes[n].c), s)
        if mask & 16 != 0:
            loop i in [0..nkids(n)): fact_capture(kid(n, i), s)
    return 0

fact_bounded_index = (n: int) -> bool:
    t = types[fact_type(ntype(int(nodes[n].a)))].kind
    t == .array or t == .fixed

# Whether a body holds something the facts pass decides: an index or slice,
# a division, a refinement or narrowing, an assertion, a loan, a string
# position. A syntactic walk of every operand (a place's route included), so
# it cannot miss what the transfer would visit. O(body nodes).
fact_obligation_node = (n: int) -> bool:
    k = nodes[n].kind
    if k == .index: return not has_flag(n, NF_INBOUNDS) and fact_bounded_index(n)
    if k == .binary:
        if nodes[n].aux == 0 and (nodes[n].op == i32(int(Tok.slash)) or nodes[n].op == i32(int(Tok.percent))) and is_int(ntype(int(nodes[n].b))) and not fact_literal_nonzero(int(nodes[n].b)): return true
        return fact_shift_obliged(n)
    if k == .assign: return fact_shift_obliged(n)
    if k == .for_: return fact_stepped_loop(n) or fact_open_range(n)
    if k == .conv:
        if exact_has_store(n) and not exact_decided(n) or nodes[n].aux == i32(int(CV.refinement)): return true
        return nodes[n].aux == i32(int(CV.int_)) and prune(ntype(int(nodes[n].a))) == T_MATH_INT and prune(ntype(n)) != T_MATH_INT
    if k == .call:
        if wi_fact_calls.has(n) or fact_divisors.has(n) or fact_range_call(n): return true
        if (fact_floor_call(n) != 0 and not fact_literal_nonzero(kid(n, 1))) or fact_string_call(n) >= 2 or fact_array_call(n) != 0 or fact_power_call(n): return true
        map = fact_map_call(n)
        if map >= 2 and map <= 4: return true
        # A fork closure's obligations start from its creator's facts.
        if fact_library_call(n, "parallel_range") or fact_library_call(n, "parallel_map"):
            loop arg in kids(n):
                if nodes[arg].kind == .lambda:
                    fact_panic_collect = false
                    if fact_obliged(int(nodes[arg].b)): return true
        return false
    if k == .intrinsic:
        id = nodes[n].aux as IN
        return id == .static_assert or id == .runtime_assert or id == .assert or nodes[n].aux2 == i32(RANGE_EXHAUSTION) or id == .lend or id == .loan_length or id == .loan_store or id == .loan_address or id == .loan_load or id == .pop or id == .remove or id == .truncate
    false

fact_obliged = (n: int) -> bool:
    if n <= 0 or n >= nodes.len(): return false
    k = nodes[n].kind
    if fact_panic_collect:
        if k == .parallel_region: fact_panic_collect = false
        else if k == .intrinsic or k == .call or k == .fnref or k == .lambda or k == .pair or k == .partial or k == .binary and nodes[n].aux == 1: fact_panic_pending.push(n)
    if k == .lambda: return false
    if k == .ident:
        if nodes[n].aux == i32(int(SK.local)):
            l = int(nodes[n].sym)
            if l > 0 and int(locals[l].flags) & LF_ALIAS != 0 and locals[l].alias != 0:
                fact_panic_collect = false
                return fact_obliged(int(locals[l].alias))
        return false
    mask = isolation_children(k)
    if mask == 0: return false
    # A finite lowering width is required even when runtime checks are allowed.
    if n < exact_marks.len() and exact_marks[n] & 128 != 0: return true
    if fact_obligation_node(n):
        policy = dir_policy(nodes[n].pos)
        if policy == DIR_STATIC or policy == DIR_PROTOTYPE or dir_obligations or ide_on or dir_forced: return true
        fact_has_deferred = true
    if mask < 0: mask = 7 | 16 | 32
    if mask & 1 != 0 and fact_obliged(int(nodes[n].a)): return true
    if mask & 2 != 0 and fact_obliged(int(nodes[n].b)): return true
    if mask & 4 != 0 and fact_obliged(int(nodes[n].c)): return true
    if mask & 16 != 0:
        loop child in kids(n):
            if fact_obliged(child): return true
    if mask & 32 != 0:
        loop i in [0..nkids2(n)):
            if fact_obliged(kid2(n, i)): return true
    false

# A block's own declarations go out of scope at its end: nothing can name
# them again, so their bindings leave the state (their values stay until a
# compaction finds nothing reaching them). The state then grows with the live
# places, not with every declaration a body ever made: joins, calls and loops
# visit bindings. O(bindings bound inside the block).
fact_scope_exit = (s: mut FactState, n: int, first: int):
    owner = 0
    declared: int[]
    loop c in kids(n):
        if nodes[c].kind != .vardecl or has_flag(c, NF_GLOBAL): continue
        if nkids(c) == 0:
            if nodes[c].sym != 0: declared.push(int(nodes[c].sym))
        else:
            loop d in kids(c):
                if nodes[d].sym != 0 and not has_flag(d, NF_GLOBAL): declared.push(int(nodes[d].sym))
    if declared.len() == 0: return
    kept: FactBinding[]
    loop i in [first..s.bindings.len()):
        b = s.bindings[i]
        if b.place.root == .local and declared.contains(b.place.declaration) and int(locals[b.place.declaration].flags) & (LF_CAPTURED | LF_SHARED) == 0: continue
        kept.push(b)
    if kept.len() == s.bindings.len() - first: return
    s.bindings.truncate(first)
    loop b in kept:
        fact_index_put(s.index[0].roots, fact_root_key(b.place), s.bindings.len())
        s.bindings.push(b)

fact_capture = (n: int, s: mut FactState) -> int:
    marks = if n > 0 and n < exact_marks.len(): int(exact_marks[n]) else: 0
    if marks & 67 == 0: return fact_capture_value(n, s)
    if n > 0 and nodes[n].kind == .intrinsic and nodes[n].aux == i32(int(IN.fixed_abs)):
        value = fact_capture(kid(n, 0), s)
        b = fact_bound(s, value)
        if not b.wide and b.lo >= 0: return value
        if not b.wide and b.lo > FACT_MIN:
            hi = max(-b.lo, b.hi)
            lo = if b.hi < 0: -b.hi else: 0
            return fact_new(s, FactBound(lo, hi), FactTerm(type = ntype(n)))
        return fact_unmodeled(s, n, .unsupported)
    if n > 0 and exact_has_node(n) and nodes[n].kind == .binary and nodes[n].op == i32(int(Tok.starstar)):
        fact_capture(int(nodes[n].a), s)
        exponent = fact_capture(int(nodes[n].b), s)
        exact_shift_fact(n, exponent, s)
        return fact_unmodeled(s, n, .unsupported)
    if marks & 64 != 0:
        fact_capture(int(nodes[n].a), s)
        return fact_new(s, fact_domain(ntype(n)), FactTerm(type = ntype(n)))
    if n > 0 and exact_has_store(n): return exact_fact_store(n, fact_capture(int(nodes[n].a), s), s)
    value = fact_capture_value(n, s)
    if n > 0 and fact_speculating == 0 and exact_has_node(n): exact_value_fact(n, value, s)
    value

fact_capture_value = (n: int, s: mut FactState) -> int:
    if n == 0 or not s.live: return 0
    if fact_speculating > 0:
        fact_loop_steps += 1
        if fact_loop_steps > FACT_STEPS:
            fact_loop_exhausted = true
            return 0
    mark = fact_slice_flags(n)
    if mark & FACT_MEMBER != 0:
        if mark & FACT_ACTIVE == 0: return 0
        k = nodes[n].kind
        control = k == .index or k == .block or k == .if_ or k == .iflet or k == .match_ or k == .while_ or k == .for_ or k == .return_ or k == .break_ or k == .continue_ or k == .and_ or k == .or_ or k == .coalesce
        if not control and mark & FACT_VALUE == 0: return fact_slice_capture(n, s)
    k = nodes[n].kind
    if k == .int_lit or k == .bool_lit:
        if not fact_scalar(ntype(n)): return fact_new(s, FactBound(reason = .unsupported, witness = n))
        x = ref_encoded(nodes[n].ival, ntype(n))
        # A uint64 constant is biased; its type lets a witness decode it.
        if fact_type(ntype(n)) == T_U64: return fact_new(s, FactBound(x, x, x != 0), FactTerm(origin = n, type = T_U64))
        return fact_constant(s, x, n)
    # (an ASCII string literal's length is its byte count; "\r\n" is one grapheme)
    if k == .str_lit and nodes[n].aux != 1 and fact_type(ntype(n)) == T_STR and nodes[n].sval >= 0:
        text = name_of(int(nodes[n].sval))
        ascii = true
        loop c in text:
            if c >= 128 or c == 13: ascii = false
        if ascii:
            value = fact_new(s, FactBound(), FactTerm(type = T_STR))
            # (and its byte view's: `"abc" as array<uint8>` has 3 elements)
            if s.projections.len() + 4 < FACT_CAP:
                fact_add_projection(s, FactProjection(value, FACT_ASCII_TEXT, false, fact_constant(s, 1)))
                count = fact_constant(s, len(text))
                fact_add_projection(s, FactProjection(value, -1, false, count))
                fact_add_projection(s, FactProjection(fact_byte_view(s, value), -1, false, count))
            return value
    # An optional's or union's tag (-3: 0 for none, 1 for a value, or the
    # member) and payload (-4) are projections of its immutable evaluation.
    if k == .istype:
        value = fact_capture(int(nodes[n].a), s)
        if nodes[n].aux == -3: return fact_constant(s, 1)
        tag = fact_project(s, value, -3, false, T_INT)
        wanted = if nodes[n].aux >= 0: int(nodes[n].aux) else if nodes[n].aux == -2: 1 else: 0
        other = fact_constant(s, wanted)
        return fact_new(s, fact_domain(T_BOOL), FactTerm(.eq, tag, other))
    if k == .narrow or k == .unwrap:
        value = fact_capture(int(nodes[n].a), s)
        return fact_project(s, value, -4, false, ntype(n))
    if k == .ident: return fact_read(s, n)
    if k == .field and (nodes[n].aux >= 0 and tkind(ntype(int(nodes[n].a))) == .struct_ or nodes[n].aux == -2 and tkind(ntype(int(nodes[n].a))) == .tuple):
        base = fact_capture(int(nodes[n].a), s)
        selector = if nodes[n].aux == -2: int(nodes[n].ival) else: int(nodes[n].name)
        return fact_project(s, base, selector, false, refine_storage(n, ntype(n)))
    if k == .tuple:
        value = fact_new(s, FactBound(), FactTerm(type = ntype(n)))
        loop i in [0..nkids(n)):
            v = fact_capture(kid(n, i), s)
            if s.projections.len() < FACT_CAP: fact_add_projection(s, FactProjection(value, i, false, v))
        return value
    # A slice reads its source, then its bounds, and has their difference as
    # its length: 0 <=? lo <=? hi <=? length (an inclusive end is hi+1).
    if k == .index and nodes[n].aux == 1 and nodes[nodes[n].b].kind == .range and not has_flag(int(nodes[n].b), NF_STEP):
        r = int(nodes[n].b)
        base = fact_capture(int(nodes[n].a), s)
        t = fact_type(ntype(int(nodes[n].a)))
        if types[t].kind != .array and types[t].kind != .fixed: return fact_unmodeled(s, n, .unsupported)
        length = if types[t].kind == .fixed: fact_constant(s, fixed_len(t)) else: fact_project(s, base, -1, false, T_INT)
        lo = if nodes[r].a != 0: fact_capture(int(nodes[r].a), s) else: fact_constant(s, 0)
        hi = length
        if nodes[r].b != 0:
            hi = fact_capture(int(nodes[r].b), s)
            if has_flag(r, NF_INCLUSIVE): hi = fact_arithmetic(s, int(nodes[r].b), .plus, hi, fact_constant(s, 1))
        if fact_speculating == 0 and (fact_policy == .RequireStatic or fact_query or fact_probe_on):
            zero = fact_constant(s, 0)
            checks = [fact_compare(s, .le, zero, lo), fact_compare(s, .le, lo, hi), fact_compare(s, .le, hi, length)]
            # (a probe records its answer: never a report)
            if fact_probe_on: fact_probe_record(n, checks[0] == 1 and checks[1] == 1 and checks[2] == 1)
            else if checks[0] != 1 or checks[1] != 1 or checks[2] != 1: wit_slice(n, s, lo, hi, length, checks)
        value = fact_new(s, FactBound(), FactTerm(type = ntype(n)))
        size = length
        if nodes[r].a != 0 or nodes[r].b != 0: size = fact_arithmetic(s, (if nodes[r].b != 0: int(nodes[r].b) else: int(nodes[r].a)), .minus, hi, lo)
        if s.projections.len() < FACT_CAP: fact_add_projection(s, FactProjection(value, -1, false, size))
        return value
    if k == .index and nodes[n].b != 0:
        base = 0
        index = 0
        # (an `int` index's narrowing is the index's own obligation: in bounds, it fits)
        outer = fact_covered
        kind = types[representation_type(ntype(int(nodes[n].a)))].kind
        fact_covered = if kind == .array or kind == .fixed: int(nodes[n].b) else: 0
        if nodes[int(nodes[n].a)].kind == .ident:
            index = fact_capture(int(nodes[n].b), s)
            base = fact_capture(int(nodes[n].a), s)
        else:
            base = fact_capture(int(nodes[n].a), s)
            index = fact_capture(int(nodes[n].b), s)
        fact_covered = outer
        t = fact_type(ntype(int(nodes[n].a)))
        if types[t].kind == .array or types[t].kind == .fixed:
            length = if types[t].kind == .fixed: fact_constant(s, fixed_len(t)) else: fact_project(s, base, -1, false, T_INT)
            if fact_speculating == 0 and fact_probe_on and fact_policy != .RequireStatic: fact_probe_index(n, s, index, length)
            # (an index the compiler generated in bounds, as an elementwise loop's reads)
            else if fact_speculating == 0 and (fact_policy == .RequireStatic or fact_query) and not has_flag(n, NF_INBOUNDS):
                zero = fact_constant(s, 0)
                lo = fact_compare(s, .le, zero, index)
                hi = fact_compare(s, .lt, index, length)
                if fact_probe_on: fact_probe_record(n, lo == 1 and hi == 1)
                else:
                    dir_index(n, lo == 1 and hi == 1)
                    if lo != 1 or hi != 1: wit_index(n, s, index, length, lo, hi)
            return fact_project(s, base, index, true, int(types[t].elem))
        return fact_unmodeled(s, n, .unsupported)
    # `fill(x n)`, an array of n copies (none when n is negative): the value,
    # then the count, which is the length.
    if k == .array and nodes[n].b != 0 and nkids(n) == 1 and tkind(fact_type(ntype(n))) == .array:
        fact_capture(kid(n, 0), s)
        count = fact_capture(int(nodes[n].b), s)
        value = fact_new(s, FactBound(), FactTerm(type = ntype(n)))
        c = fact_bound(s, count)
        # (the length is max(0, n): n itself whenever n is nonnegative, as
        # the allocation succeeded)
        size = if c.lo < 0 or c.hi > fact_length_max(): fact_clamped(s, count, n) else: count
        if s.projections.len() < FACT_CAP: fact_add_projection(s, FactProjection(value, -1, false, size))
        return value
    if k == .array and nodes[n].aux == 0:
        value = fact_new(s, FactBound(), FactTerm(type = ntype(n)))
        loop i in [0..nkids(n)):
            v = fact_capture(kid(n, i), s)
            if s.projections.len() < FACT_CAP: fact_add_projection(s, FactProjection(value, fact_constant(s, i), true, v))
        if s.projections.len() < FACT_CAP: fact_add_projection(s, FactProjection(value, -1, false, fact_constant(s, nkids(n))))
        return value
    if result_active and k == .none_lit:
        value = fact_new(s, FactBound(), FactTerm(type = ntype(n)))
        fact_add_projection(s, FactProjection(value, -3, false, fact_constant(s, 0)))
        return value
    if k == .str_lit and nodes[n].aux == 0 or k == .float_lit or k == .none_lit or k == .null_lit or k == .dotname: return 0
    if k == .str_lit:
        # Interpolation evaluates each part in order, then calls its formatter,
        # which (like any opaque call) may write exposed roots; a builtin
        # number's, boolean's or string's writes nothing.
        loop part in kids(n):
            if nodes[part].kind != .pair: continue
            fact_capture(int(nodes[part].a), s)
            pt = prune(ntype(int(nodes[part].a)))
            if types[pt].kind != .int_ and types[pt].kind != .float_ and types[pt].kind != .bool_ and types[pt].kind != .str_: fact_forget(s, part, .call)
        return fact_new(s, FactBound(reason = .unsupported, witness = n))
    if k == .addr: return fact_capture(int(nodes[n].a), s)
    # Creating a closure evaluates nothing (defaults are the actuals of its
    # calls) and writes nothing: its body runs only when called, and every
    # call that can reach it, indirect or through a callee's summary, forgets
    # what the body may write. (Ownership may move captures: still opaque.)
    if k == .lambda and fact_speculating == 0 and fact_fork_nodes.has(n): fact_fork_record(n, s)
    if k == .lambda and ownership_decls.len() == 0: return 0
    if k == .lambda or k == .fnref or k == .partial:
        fact_capture(int(nodes[n].a), s)
        loop child in kids(n): fact_capture(child, s)
        fact_forget(s, n, .call)
        return 0
    if k == .unary:
        a = fact_capture(int(nodes[n].a), s)
        if nodes[n].op == i32(int(Tok.minus)) and fact_scalar(ntype(n)):
            return fact_arithmetic(s, n, .minus, fact_constant(s, 0), a)
        return fact_unmodeled(s, n, .unsupported)
    if k == .exprstmt: return fact_capture(int(nodes[n].a), s)
    if k == .block:
        r = 0
        defers: int[]
        pending = fact_pending_defers
        first = s.bindings.len()
        boundary = fact_terms.len()
        collect_at = max(32, s.ids.len() * 2)
        long_block = nkids(n) > 32
        loop c in kids(n):
            if nodes[c].kind == .defer_:
                defers.push(int(nodes[c].a))
                fact_pending_defers += 1
            else:
                r = fact_capture(c, s)
                # A statement can finish a temporary or lexical owner whose
                # hook writes exposed storage. Until lifecycle edges carry
                # precise footprints, never export those facts across cleanup.
                if ownership_decls.len() != 0: fact_forget(s, c, .call)
                if long_block and s.live and s.ids.len() >= collect_at:
                    fact_collect(s, boundary, r)
                    collect_at = s.ids.len() + max(32, s.ids.len())
        loop i in [0..defers.len()): fact_capture(defers[defers.len() - 1 - i], s)
        fact_pending_defers = pending
        if s.live and s.bindings.len() > first: fact_scope_exit(s, n, first)
        if s.live and s.ids.len() > 64: fact_collect(s, boundary, r)
        return r
    if k == .return_:
        r = fact_capture(int(nodes[n].a), s)
        if ownership_decls.len() != 0: r = fact_owner_value(int(nodes[n].a), r, s)
        if proof_active and proof_decls.has(int(fns[fact_owner].decl)): proof_exit(fact_owner, n, s)
        if result_active: result_exit(fact_owner, r, n, s)
        if fact_summary_owner != 0 and fact_summary_owner == fact_owner: fact_summary_record(s, r)
        s.live = false
        return r
    if k == .break_ or k == .continue_:
        if fact_pending_defers > 0: fact_forget(s, n, .write, true)
        level = fact_loops.len() - 1 - int(nodes[n].ival)
        if level >= 0:
            if k == .break_: fact_loops[level].exits = fact_join(fact_loops[level].exits, s, n)
            else: fact_loops[level].back = fact_join(fact_loops[level].back, s, n)
        s.live = false
        return 0
    if k == .vardecl:
        r = if nodes[n].b != 0: fact_capture(int(nodes[n].b), s) else: fact_constant(s, 0, n)
        if ownership_decls.len() != 0: r = fact_owner_value(int(nodes[n].b), r, s)
        l = int(nodes[n].sym)
        if nkids(n) > 0 and not has_flag(n, NF_GLOBAL):
            # (unpacking: each name binds its component)
            loop i in [0..nkids(n)):
                c = kid(n, i)
                if nodes[c].kind == .hole: continue
                if nodes[c].sym <= 0 or has_flag(c, NF_GLOBAL): fact_forget(s, n, .write, true); return 0
                cl = int(nodes[c].sym)
                fact_bind(s, PlaceIdentity(.local, int(locals[cl].owner), cl), fact_component(s, r, ntype(int(nodes[n].b)), i, int(locals[cl].type)))
            return r
        if nkids(n) > 0 or l == 0: fact_forget(s, n, .write, true); return 0
        if has_flag(n, NF_GLOBAL): fact_bind(s, PlaceIdentity(.global, 0, l), r)
        else if not (nodes[n].aux2 == 1 and int(locals[l].flags) & LF_PARAM != 0): fact_bind(s, PlaceIdentity(.local, int(locals[l].owner), l), r)
        return r
    if k == .assign:
        a = int(nodes[n].a)
        old = 0
        if nodes[n].op != i32(int(Tok.assign)): old = fact_capture(a, s)
        r = fact_capture(int(nodes[n].b), s)
        if ownership_decls.len() != 0: r = fact_owner_value(int(nodes[n].b), r, s)
        op = nodes[n].op as Tok
        if (op == .shleq or op == .shreq) and fact_shift_obliged(n): fact_nonnegative(n, s, r, int(nodes[n].b), "the shift count")
        if nodes[a].kind == .tuple and op == .assign:
            fact_store_pattern(s, a, r, n)
            return r
        if nodes[n].aux == 0 and (op == .pluseq or op == .minuseq):
            arithmetic_op = if op == .pluseq: Tok.plus else: Tok.minus
            r = fact_arithmetic(s, a, arithmetic_op, old, r)
        else if op != .assign or nodes[n].aux != 0: r = fact_new(s, fact_domain(ntype(a), .write, n))
        # (a compound one's target was read above, with its obligations)
        route = fact_route(a, s)
        fact_store_route(s, route, r, n, op == .assign)
        return r
    if k == .if_:
        paths = fact_condition(int(nodes[n].a), s)
        y = fact_capture(int(nodes[n].b), paths.yes)
        z = fact_capture(int(nodes[n].c), paths.no)
        # Allocate the shared result only after its operands finish: a long
        # condition/arm may collect unrooted temporary values. Both incoming
        # frames name this evaluation, each with its own checked evidence.
        selected = 0
        if mark & FACT_VALUE != 0 and fact_scalar(ntype(n)) and paths.yes.ids.len() < FACT_CAP and paths.no.ids.len() < FACT_CAP and fact_terms.len() < 0x80000000:
            selected = fact_terms.len()
            fact_terms.push(FactTerm(type = fact_hull_type(ntype(n), paths.yes, y, paths.no, z)))
            fact_add_value(paths.yes, selected, fact_bound(paths.yes, y))
            fact_add_value(paths.no, selected, fact_bound(paths.no, z))
        if selected != 0:
            fact_selected(paths.yes, selected, y, n)
            fact_selected(paths.no, selected, z, n)
            s = fact_join(paths.yes, paths.no, n)
            fact_selected_rows(s, paths.yes, paths.no, selected)
            fact_selected_rows(s, paths.no, paths.yes, selected)
            return selected
        result = fact_hull(fact_bound(paths.yes, y), fact_bound(paths.no, z), n)
        hull = fact_hull_type(ntype(n), paths.yes, y, paths.no, z)
        if not paths.yes.live: result = fact_bound(paths.no, z); hull = fact_terms[z].type
        if not paths.no.live: result = fact_bound(paths.yes, y); hull = fact_terms[y].type
        s = fact_join(paths.yes, paths.no, n)
        return fact_new(s, result, FactTerm(type = hull))
    if k == .and_ or k == .or_:
        paths = fact_condition(n, s)
        result = fact_domain(T_BOOL)
        if not paths.yes.live: result = FactBound(0, 0)
        if not paths.no.live: result = FactBound(1, 1, true)
        s = fact_join(paths.yes, paths.no, n)
        return fact_new(s, result)
    if (k == .while_ or k == .for_) and fact_loops.len() == 0 and fact_speculating == 0:
        fact_loop_steps = 0; fact_loop_exhausted = false
    if k == .while_ and nodes[n].aux == 0:
        fact_while(n, s)
        return 0
    if k == .for_ and nodes[n].aux == 0 and not has_flag(int(nodes[n].a), NF_STEP):
        fact_range(n, s)
        return 0
    if k == .for_ and nodes[n].aux == 0 and nodes[int(nodes[n].a)].kind == .range and nodes[int(nodes[n].a)].c != 0:
        fact_stepped(n, s)
        return 0
    if k == .while_ or k == .for_:
        # An indexed array loop evaluates its source once, before the loop.
        base = 0
        # (`loop @x in xs`, aux 2, cannot resize or replace xs: its length is read once too)
        indexed = k == .for_ and (nodes[n].aux == 1 or nodes[n].aux == 2) and nodes[n].c != 0 and files[pos_file(nodes[n].pos)].is_dewy
        if indexed: base = fact_capture(int(nodes[n].a), s)
        pushes: (int, int)[]
        sums: (int, FactBound)[]
        if indexed:
            pushes = fact_counted_pushes(n, s)
            # (one iteration per element of the evaluated source; every
            # length is within the enabled address-space ceiling)
            t = fact_type(ntype(int(nodes[n].a)))
            trips = fact_length_max()
            if types[t].kind == .fixed: trips = fixed_len(t)
            else:
                b = fact_bound(s, fact_project(s, base, -1, false, T_INT))
                if not b.wide: trips = max(0, min(trips, b.hi))
            sums = fact_counted_sums(n, s, trips)
        fact_changes(n, s, n)
        loop sum in sums:
            i = fact_binding(s, PlaceIdentity(.local, int(locals[sum.0].owner), sum.0))
            if i >= 0: fact_set_bound(s, s.bindings[i].value, sum.1)
        after = s
        body = s
        fact_growing_lengths(body, pushes)
        if indexed:
            fact_loop_index(n, base, body)
            fact_loop_elements(n, base, body)
        else: fact_capture(int(nodes[n].a), body)
        fact_loop_body(n, body)
        s = after
        if pushes.len() > 0:
            t = fact_type(ntype(int(nodes[n].a)))
            count = if types[t].kind == .fixed: fact_constant(s, fixed_len(t)) else: fact_project(s, base, -1, false, T_INT)
            fact_counted_lengths(n, s, pushes, count)
        return 0
    if k == .not_:
        a = fact_capture(int(nodes[n].a), s)
        v = fact_truth(s, a)
        b = if v < 0: fact_domain(T_BOOL) else: FactBound(1 - v, 1 - v, v == 0)
        return fact_new(s, b, FactTerm(.kw_not, a, 0, n))
    if k == .binary:
        a = fact_capture(int(nodes[n].a), s)
        if result_active and nodes[int(nodes[n].b)].kind == .none_lit and tkind(ntype(int(nodes[n].a))) == .opt:
            tag = fact_project(s, a, -3, false, T_INT)
            zero = fact_constant(s, 0)
            return fact_new(s, fact_domain(T_BOOL), FactTerm(nodes[n].op as Tok, tag, zero))
        b = fact_capture(int(nodes[n].b), s)
        op = nodes[n].op as Tok
        if (op == .shl or op == .shr) and fact_shift_obliged(n): fact_nonnegative(n, s, b, int(nodes[n].b), "the shift count")
        if nodes[n].aux == 0 and fact_scalar(ntype(int(nodes[n].a))) and fact_scalar(ntype(int(nodes[n].b))) and fact_comparison(op):
            unsigned_a = fact_type(ntype(int(nodes[n].a))) == T_U64
            unsigned_b = fact_type(ntype(int(nodes[n].b))) == T_U64
            if unsigned_a != unsigned_b:
                if unsigned_a: a = exact_fact_signed(s, a)
                else: b = exact_fact_signed(s, b)
            truth = fact_compare(s, op, a, b)
            x = fact_bound(s, a); y = fact_bound(s, b)
            reason = if x.lo != x.hi: x else: y
            result = fact_domain(T_BOOL, reason.reason, reason.witness)
            if truth >= 0: result = FactBound(truth, truth, truth != 0)
            return fact_new(s, result, FactTerm(op, a, b, n))
        if nodes[n].aux == 0 and fact_scalar(ntype(n)) and (op == .plus or op == .minus or op == .star): return fact_arithmetic(s, n, op, a, b)
        if fact_speculating == 0 and fact_policy == .RequireStatic and nodes[n].aux == 0 and (op == .slash or op == .percent) and is_int(ntype(int(nodes[n].b))):
            proven = fact_divisor(s, n, a, b, op == .percent)
            if fact_probe_on: fact_probe_record(n, proven)
        else if fact_speculating == 0 and fact_probe_on and nodes[n].aux == 0 and (op == .slash or op == .percent) and is_int(ntype(int(nodes[n].b))):
            fact_probe_divisor(n, s, b, int(nodes[n].b))
        if nodes[n].aux == 0 and (op == .slash or op == .percent) and fact_type(ntype(n)) == T_U64 and fact_type(ntype(int(nodes[n].a))) == T_U64 and fact_type(ntype(int(nodes[n].b))) == T_U64:
            return fact_floor_unsigned(s, n, (if op == .slash: 1 else: 2), a, b)
        if nodes[n].aux == 0 and (op == .slash or op == .percent) and fact_scalar(ntype(n)) and fact_type(ntype(n)) != T_U64 and fact_scalar(ntype(int(nodes[n].a))) and fact_scalar(ntype(int(nodes[n].b))):
            return fact_floor(s, n, (if op == .slash: 1 else: 2), a, b, files[pos_file(nodes[n].pos)].is_dewy)
        if nodes[n].aux == 0 and (op == .amp or op == .pipe or op == .caret or op == .shr or op == .shl) and fact_scalar(ntype(n)) and is_int(ntype(n)):
            exact_shift_fact(n, b, s)
            return fact_bitwise(s, n, op, a, b)
        if nodes[n].aux != 0 and not fact_pure_binary(n): fact_forget(s, n, .call)
        return fact_unmodeled(s, n, .unsupported)
    if k == .conv:
        outer = fact_covered
        if nodes[n].aux == i32(int(CV.refinement)): fact_covered = fact_refinement_covers(n)
        a = fact_capture(int(nodes[n].a), s)
        fact_covered = outer
        if result_active and nodes[n].aux == i32(int(CV.opt)):
            value = fact_new(s, FactBound(), FactTerm(type = ntype(n)))
            if s.projections.len() + 2 < FACT_CAP:
                fact_add_projection(s, FactProjection(value, -3, false, fact_constant(s, 1)))
                fact_add_projection(s, FactProjection(value, -4, false, a))
            return value
        if nodes[n].aux == i32(int(CV.refinement)):
            ref_check(n, a, ref_fact_current_entry(s), s)
            return a
        if nodes[n].aux == i32(int(CV.explicit_copy)):
            if ownership_decls.len() != 0 and ownership_fact_type(ntype(n)):
                fact_forget(s, n, .call, true)
                return fact_new(s, fact_domain(ntype(n), .call, n), FactTerm(type = ntype(n)))
            return a
        if nodes[n].aux == i32(int(CV.fixed2arr)): return a
        if nodes[n].aux == i32(int(CV.set_text)): return fact_new(s, FactBound(), FactTerm(type = ntype(n)))
        b = fact_bound(s, a)
        from = fact_type(ntype(int(nodes[n].a)))
        to = fact_type(ntype(n))
        if nodes[n].aux == i32(int(CV.wrap_int)) or nodes[n].aux == i32(int(CV.saturate_int)):
            if not b.wide and from == to and (to == T_U64 or sa_fits(b.lo, to) and sa_fits(b.hi, to)): return a
            if not b.wide and to == T_U64 and from != T_U64 and b.lo >= 0:
                return fact_new(s, FactBound(b.lo xor FACT_MIN, b.hi xor FACT_MIN), FactTerm(type = T_U64))
            if not b.wide and from != T_U64 and to != T_U64 and sa_fits(b.lo, to) and sa_fits(b.hi, to): return a
            return fact_new(s, fact_domain(to, .unsupported, n), FactTerm(type = to))
        # (an `int` narrowed to a fixed width: the proven narrowing, an
        # obligation; effect_failure asks whether it fits)
        if nodes[n].aux == i32(int(CV.int_)) and prune(ntype(int(nodes[n].a))) == T_MATH_INT and prune(ntype(n)) != T_MATH_INT and fact_scalar(ntype(n)):
            proven = fact_narrow_check(n, s, a)
            # A progress-axiom narrowing supplies its fixed storage domain;
            # its mathematical intermediate must not remain unbounded downstream.
            if proven and exact_progress_math.has(n): return fact_new(s, fact_domain(to), FactTerm(type = to))
            if (proven or n == fact_covered) and to != T_U64: return a
            if not proven or b.lo < 0: return fact_unmodeled(s, n, .unsupported)
            return fact_new(s, FactBound(b.lo xor FACT_MIN, b.hi xor FACT_MIN), FactTerm(type = T_U64))
        if from == to and nodes[n].aux == i32(int(CV.int_)): return a
        if ntype(n) != ntype(int(nodes[n].a)) and (ntype(n) == T_U64 or ntype(int(nodes[n].a)) == T_U64):
            # (a value both types hold converts exactly: decode or encode its interval)
            if fact_scalar(ntype(n)) and fact_scalar(ntype(int(nodes[n].a))) and nodes[n].aux == i32(int(CV.int_)):
                if ntype(n) == T_U64 and b.lo >= 0: return fact_new(s, FactBound(b.lo xor FACT_MIN, b.hi xor FACT_MIN), FactTerm(type = T_U64))
                if ntype(n) != T_U64 and b.hi < 0 and sa_fits(b.lo xor FACT_MIN, ntype(n)) and sa_fits(b.hi xor FACT_MIN, ntype(n)):
                    r = FactBound(b.lo xor FACT_MIN, b.hi xor FACT_MIN)
                    r.nz = r.lo > 0
                    return fact_new(s, r, FactTerm(type = ntype(n)))
            return fact_unmodeled(s, n, .unsupported)
        if fact_scalar(ntype(n)) and fact_scalar(ntype(int(nodes[n].a))) and (nodes[n].aux == i32(int(CV.int_)) or nodes[n].aux == i32(int(CV.none_))):
            fits = sa_fits(b.lo, ntype(n)) and sa_fits(b.hi, ntype(n))
            if fits: return a
            return fact_unmodeled(s, n, .unsupported)
        if not fact_pure_conversion(n): fact_forget(s, n, .call)
        return fact_new(s, FactBound(reason = .unsupported, witness = n))
    if k == .intrinsic:
        id = nodes[n].aux as IN
        if id == .lend:
            extra = fact_capture(kid(n, 1), s)
            base = fact_capture(kid(n, 0), s)
            length = fact_project(s, base, -1, false, T_INT)
            # (typed by the reservation: the `$lend` block itself is not an integer)
            limit = fact_arithmetic(s, kid(n, 1), .plus, length, extra)
            # (the constant first: a by-value state argument is taken before later arguments run)
            zero = fact_constant(s, 0)
            if fact_speculating == 0 and fact_compare(s, .ge, extra, zero) == 0:
                loan_error(n, "negative reservation")
            fact_loans.push(FactLoan(place_route(kid(n, 0)), limit))
            result = fact_capture(kid(n, 2), s)
            fact_loans.pop()
            return result
        if id == .loan_length:
            value = fact_capture(kid(n, 1), s)
            if fact_speculating == 0:
                loop loan in fact_loans:
                    if loan.place == place_route(kid(n, 0)):
                        zero = fact_constant(s, 0)
                        lo = fact_compare(s, .ge, value, zero)
                        hi = fact_compare(s, .le, value, loan.capacity)
                        if lo == 0 or hi == 0: loan_error(n, "set_length exceeds the reserved capacity")
                        if fact_policy == .RequireStatic and (lo != 1 or hi != 1): fact_unknown(n, fact_bound(s, value), "loan capacity")
            route = fact_route(kid(n, 0), s)
            fresh = fact_new(s, FactBound(), FactTerm(type = ntype(kid(n, 0))))
            fact_add_projection(s, FactProjection(fresh, -1, false, value))
            fact_store_route(s, route, fresh, n)
            return 0
        if id == .loan_address or id == .loan_load or id == .loan_store:
            # Raw writes invalidate element facts; no address becomes evidence.
            if id == .loan_store: fact_forget(s, n, .write, true)
            return fact_new(s, fact_domain(ntype(n)))
        # (a float square root, rounding, min/max or vector constructor reads
        # its operands and writes nothing)
        if fact_pure_intrinsic(id):
            loop c in kids(n): fact_capture(c, s)
            return fact_new(s, fact_domain(ntype(n)))
        # (`bytes(text)`, which `text as array<uint8>` is: the text's byte view)
        if id == .to_bytes and nkids(n) == 1 and tkind(ntype(kid(n, 0))) == .str_: return fact_byte_view(s, fact_capture(kid(n, 0), s))
        if id == .len:
            base = fact_capture(kid(n, 0), s)
            t = fact_type(ntype(kid(n, 0)))
            if types[t].kind == .fixed: return fact_constant(s, fixed_len(t))
            return fact_project(s, base, -1, false, T_INT)
        if id == .push or id == .pop or id == .clear or id == .reserve or id == .insert or id == .remove:
            a = kid(n, 0)
            # Intrinsics lower value/selector operands before reacquiring the
            # receiver. Insertion evaluates the value before its position.
            position = 0
            if id == .insert:
                fact_capture(kid(n, 2), s)
                position = fact_capture(kid(n, 1), s)
            else:
                loop i in [1..nkids(n)): position = fact_capture(kid(n, i), s)
            route = fact_route(a, s)
            values = fact_route_values(s, route)
            base = if values.len() > 0: values[values.len() - 1] else: 0
            length = fact_project(s, base, -1, false, T_INT)
            if id == .reserve: return 0
            if (id == .pop or id == .remove) and fact_speculating == 0 and (fact_policy == .RequireStatic or fact_query): fact_removal(n, s, position, length)
            fresh = fact_new(s, FactBound(), FactTerm(type = ntype(a)))
            size = fact_new(s, FactBound(0, fact_length_max(), reason = .write, witness = n))
            if id == .clear: size = fact_constant(s, 0)
            else:
                old = fact_bound(s, length)
                delta = if id == .push or id == .insert: 1 else: -1
                if old.lo >= 0 and (delta < 0 or old.hi < FACT_MAX):
                    size = fact_new(s, FactBound(max(0, old.lo + delta), min(fact_length_max(), max(0, old.hi + delta))))
                # (the new length is the old one plus or minus one exactly: a
                # row where an interval cannot say it (`let i=xs.length`,
                # `xs.push(v)`, `return i` below the new length), outside loops)
                if old.lo != old.hi and fact_loops.len() == 0:
                    fact_difference(s, size, length, delta, n)
                    fact_difference(s, length, size, -delta, n)
            if s.projections.len() < FACT_CAP: fact_add_projection(s, FactProjection(fresh, -1, false, size))
            fact_store_route(s, route, fresh, n, true)
            return fact_new(s, fact_domain(ntype(n)))
        # `xs.extend(ys)` grows by ys's length, `truncate(k)` never grows,
        # `resize(k)` makes max(0, k): the operand first, then the receiver,
        # as push's.
        if id == .extend or id == .truncate or id == .resize:
            operand = fact_capture(kid(n, 1), s)
            a = kid(n, 0)
            route = fact_route(a, s)
            values = fact_route_values(s, route)
            base = if values.len() > 0: values[values.len() - 1] else: 0
            length = fact_project(s, base, -1, false, T_INT)
            old = fact_bound(s, length)
            size = 0
            if id == .resize: size = fact_clamped(s, operand, n)
            else if id == .truncate:
                if fact_speculating == 0 and (fact_policy == .RequireStatic or fact_query) and files[pos_file(nodes[n].pos)].is_dewy:
                    zero = fact_constant(s, 0)
                    c = fact_compare(s, .ge, operand, zero)
                    if c != 1: wit_operation(n, s, .ge, wit_side(operand, kid(n, 1)), WitSide(zero, 0, "0", false, true), c, "truncate's count is negative", "truncate's count is nonnegative")
                size = fact_new(s, FactBound(0, max(0, old.hi), reason = .write, witness = n))
                fact_difference(s, size, length, 0, n)
            else:
                ot = fact_type(ntype(kid(n, 1)))
                added = if tkind(ot) == .fixed: fact_constant(s, fixed_len(ot)) else if tkind(ot) == .array: fact_project(s, operand, -1, false, T_INT) else: 0
                grown = if added != 0: fact_bound(s, added) else: FactBound(0, fact_length_max())
                lo = if old.lo >= 0 and grown.lo >= 0 and fact_add_fits(old.lo, grown.lo): min(old.lo + grown.lo, fact_length_max()) else: 0
                size = fact_new(s, FactBound(lo, fact_length_max(), reason = .write, witness = n))
                fact_difference(s, length, size, 0, n)
                if added != 0 and grown.lo == grown.hi:
                    fact_difference(s, size, length, grown.lo, n)
                    fact_difference(s, length, size, -grown.lo, n)
            fresh = fact_new(s, FactBound(), FactTerm(type = ntype(a)))
            if s.projections.len() < FACT_CAP: fact_add_projection(s, FactProjection(fresh, -1, false, size))
            fact_store_route(s, route, fresh, n, true)
            return fact_new(s, fact_domain(ntype(n)))
        if id == .panic or id == .unreachable:
            # Never returns: its message is evaluated, then the path ends.
            loop c in kids(n): fact_capture(c, s)
            s.live = false
            return 0
        if id == .assert and nodes[n].aux2 == i32(RANGE_EXHAUSTION):
            paths = fact_condition(kid(n, 0), s)
            if fact_speculating == 0:
                fact_validated[n] = true
                proven = not paths.no.live or fact_range_assumed(n)
                if fact_probe_on: fact_probe_record(n, proven)
                else if not proven:
                    if not dir_defer(n, "cannot prove the open range does not exhaust its integer type", true): wit_fail(nodes[n].pos, "cannot prove the open range does not exhaust its integer type")
            s = paths.yes
            return 0
        if id == .static_assert:
            if nkids(n) == 0 or fact_speculating > 0: return 0
            fact_validated[n] = true
            fact_query = true
            paths = fact_condition(kid(n, 0), s)
            fact_query = false
            if not paths.yes.live or paths.no.live: wit_assertion(kid(n, 0), (if nkids(n) > 1: kid(n, 1) else: 0), paths, s)
            return 0
        if id == .assert and nodes[n].aux2 == i32(UNPACK_OBLIGATION) and fact_speculating == 0 and nkids(n) > 0:
            # (an unpacking's or a spread's length: proven, its check goes; unproven, it stays
            # where the scope allows a runtime check, and is an error elsewhere)
            fact_validated[n] = true
            fact_query = true
            paths = fact_condition(kid(n, 0), s)
            fact_query = false
            if paths.yes.live and not paths.no.live:
                nodes[n].aux = i32(int(IN.static_assert))
                set_list(n, [])
                return 0
            wit_obligation = n
            wit_assertion(kid(n, 0), (if nkids(n) > 1: kid(n, 1) else: 0), paths, s)
            wit_obligation = 0
            s = paths.yes
            return 0
        if id == .runtime_assert or id == .assert:
            paths = fact_condition(kid(n, 0), s)
            if fact_speculating == 0 and id == .runtime_assert and not paths.yes.live: assertion_refuted(kid(n, 0), 0)
            s = paths.yes
            # Messages execute only on failure, never on this success edge.
            return 0
    if k == .call:
        if result_active and nodes[n].aux == 3:
            payload = fact_capture(kid(n, 0), s)
            value = fact_new(s, FactBound(), FactTerm(type = ntype(n)))
            if s.projections.len() + 2 < FACT_CAP:
                fact_add_projection(s, FactProjection(value, -3, false, fact_constant(s, int(nodes[n].aux2))))
                fact_add_projection(s, FactProjection(value, -4, false, payload))
            return value
        if proof_active and nodes[n].aux == 0 and nodes[n].sym > 0 and proof_decls.has(int(fns[int(nodes[n].sym)].decl)):
            proof_call(n, s)
            return 0
        fact_capture(int(nodes[n].a), s)
        values = fact_call_arguments(n, s)
        if wi_fact_calls.len() > 0 and wi_fact_calls.has(n): wi_fact_check(n, values, s)
        if fact_speculating == 0:
            floor_probe = fact_probe_on and nkids(n) == 2 and (fact_floor_call(n) == 1 or fact_floor_call(n) == 2)
            # (a divisor's call keeps its two operands: a wrapper takes the
            # obligation along, expr.jo move_divisor)
            obligation = if values.len() == 2: fact_divisors.get(n) ?? 0 else: 0
            if obligation != 0:
                proven = fact_divisor(s, n, values[0], values[1], obligation == 2)
                if floor_probe: fact_probe_record(n, proven)
            else if floor_probe: fact_probe_divisor(n, s, values[1], kid(n, 1))
            if values.len() == 2 and fact_power_call(n): fact_power_check(n, s, values[1])
            if values.len() == 5 and fact_range_call(n): fact_step_check(n, s, values[0], values[1], kid(n, 0), kid(n, 1))
        if fact_empty_array_call(n):
            t = fact_type(ntype(kid(n, 0)))
            length = if types[t].kind == .fixed: fact_constant(s, fixed_len(t)) else: fact_project(s, values[0], -1, false, T_INT)
            return fact_new(s, fact_domain(T_BOOL), FactTerm(.eq, length, fact_constant(s, 0)))
        array = fact_array_call(n)
        if array != 0: fact_array_call_check(n, s, values, array)
        if array >= 30:
            # (a slice assignment changes elements, not the length)
            a = kid(n, 0)
            route = fact_route(a, s)
            held = fact_route_values(s, route)
            length = fact_project(s, (if held.len() > 0: held[held.len() - 1] else: values[0]), -1, false, T_INT)
            fresh = fact_new(s, FactBound(), FactTerm(type = ntype(a)))
            if s.projections.len() < FACT_CAP: fact_add_projection(s, FactProjection(fresh, -1, false, length))
            fact_store_route(s, route, fresh, n, true)
            return fact_new(s, fact_domain(ntype(n)))
        map = if fact_policy == .RequireStatic or fact_query or fact_probe_on: fact_map_call(n) else: 0
        if map >= 2 and map <= 4: fact_map_check(n, s, values)
        if map != 0:
            before = fact_map_receiver(s, n, values[0])
            # (asking for a builtin key reads the dictionary and nothing else:
            # an exposed one is not forgotten, as its summary, through the
            # hashing's generic calls, would have it)
            kt = representation_type(ntype(kid(n, 1)))
            if map > 2 or not (fact_scalar(kt) or kt == T_STR): fact_path_call_effects(n, s)
            if map == 1: return fact_map_member(s, n, before, values[1])
            # (the entry is there now, in d's value after the change, and so is
            # every key known there before: a store removes none)
            if map == 3 or map == 5:
                after = fact_map_receiver(s, n, fact_capture(kid(n, 0), s))
                if after != before:
                    keys: int[]
                    i = fact_index_get(s.index[0].projection_head, before)
                    loop i >= 0:
                        q = s.projections[i]
                        i = s.index[0].projection_next[i]
                        if q.element and fact_truth(s, q.value) == 1: keys.push(q.selector)
                    loop key in keys: fact_assume(s, fact_project(s, after, key, true, T_BOOL), true)
                fact_assume(s, fact_map_member(s, n, after, values[1]), true)
            return fact_new(s, fact_domain(ntype(n), .call, n), FactTerm(type = ntype(n)))
        zero_test = fact_rational_zero_test(n)
        if zero_test >= 0 and values[zero_test] != 0:
            numerator = fact_project(s, values[zero_test], intern("numerator"), false, T_MATH_INT)
            return fact_new(s, fact_domain(T_BOOL), FactTerm(.eq, numerator, fact_constant(s, 0)))
        string = fact_string_call(n)
        if string == 4: return fact_byte_slice(n, s, values)
        if string != 0:
            length = fact_project(s, values[0], -1, false, T_INT)
            if string == 1: return length
            if string == 3: return fact_string_slice(n, s, values, length)
            fact_string_index(n, s, values[1], length)
            return fact_new(s, fact_domain(ntype(n)), FactTerm(type = ntype(n)))
        if nodes[n].aux == 2:
            result = fact_new(s, FactBound(), FactTerm(type = ntype(n)))
            si = int(types[fact_type(ntype(n))].st)
            loop i in [0..values.len()):
                name = int(fields[int(structs[si].fields) + i].name)
                value = if kid(n, i) == 0: fact_constant(s, 0) else: values[i]
                if s.projections.len() < FACT_CAP: fact_add_projection(s, FactProjection(result, name, false, value))
            return result
        fact_path_call_effects(n, s)
        floor = fact_floor_call(n)
        if floor != 0 and fact_type(ntype(n)) == T_U64: return fact_floor_unsigned(s, n, floor, values[0], values[1])
        if floor != 0: return fact_floor(s, n, floor, values[0], values[1], true)
        if fact_extremum_call(n): return fact_extremum(s, n, values[0], values[1], fact_prelude_call(n, "min"))
        if fact_ends_path(n): s.live = false
        result = fact_new(s, fact_domain(ntype(n), .missing, n), FactTerm(type = ntype(n)))
        if nodes[n].aux == 0 and nodes[n].sym > 0:
            f = int(nodes[n].sym)
            entry = values
            loop i in [0..values.len()):
                if i < fns[f].params.len() and int(locals[fns[f].params[i]].flags) & LF_MUTPARAM != 0: values[i] = fact_capture(kid(n, i), s)
            ref_assume(int(fns[f].ret), result, values, s)
            ref_arm_publish(f, result, values, s)
            if fact_search_call(n): fact_search_result(n, result, entry, s)
            if result_active: result_publish(f, result, values, s)
            # (reviewed prelude contracts: `parallel_range(n f)` has max(0, n)
            # results, `parallel_map(xs f)` one per element)
            if nkids(n) == 2 and tkind(fact_type(ntype(n))) == .array:
                if fact_library_call(n, "parallel_range") and fact_scalar(ntype(kid(n, 0))):
                    fact_add_projection(s, FactProjection(result, -1, false, fact_clamped(s, entry[0], n)))
                else if fact_library_call(n, "parallel_map") and tkind(fact_type(ntype(kid(n, 0)))) == .array:
                    fact_add_projection(s, FactProjection(result, -1, false, fact_project(s, entry[0], -1, false, T_INT)))
            if fact_words_call(n) and s.projections.len() < FACT_CAP:
                fact_add_projection(s, FactProjection(result, FACT_ELEMENT_LENGTH, false, fact_new(s, FactBound(1, fact_length_max()))))
            if fact_split_call(n):
                separator = fact_project(s, entry[1], -1, false, T_INT)
                if fact_bound(s, separator).lo > 0:
                    length = fact_project(s, result, -1, false, T_INT)
                    bound = fact_bound(s, length)
                    bound.lo = max(1, bound.lo)
                    fact_set_bound(s, length, bound)
            summary = fact_summary(f)
            if summary.seen:
                if tkind(fact_type(int(fns[f].ret))) == .array:
                    length = fact_project(s, result, -1, false, T_INT)
                    b = fact_bound(s, length)
                    fact_set_bound(s, length, FactBound(max(b.lo, summary.length.lo), min(b.hi, summary.length.hi)))
                    if summary.same >= 0 and summary.same < entry.len():
                        at = fact_type(ntype(kid(n, summary.same)))
                        other = if tkind(at) == .fixed: fact_constant(s, fixed_len(at)) else if fact_scalar(at): fact_clamped(s, entry[summary.same], n) else: fact_project(s, entry[summary.same], -1, false, T_INT)
                        fact_difference(s, length, other, summary.delta, n)
                        fact_difference(s, other, length, -summary.delta, n)
                        o = fact_bound(s, other)
                        b = fact_bound(s, length)
                        lo = if o.lo >= 0 and fact_add_fits(o.lo, summary.delta): max(b.lo, o.lo + summary.delta) else: b.lo
                        hi = if o.hi <= fact_length_max() and fact_add_fits(o.hi, summary.delta): min(b.hi, o.hi + summary.delta) else: b.hi
                        fact_set_bound(s, length, FactBound(lo, hi))
                else:
                    b = fact_bound(s, result)
                    fact_set_bound(s, result, FactBound(max(b.lo, summary.value.lo), min(b.hi, summary.value.hi), b.nz or summary.value.nz))
                    if summary.host and result != 0: fact_terms[result].type = T_INT
                    if summary.upper >= 0 and summary.upper < entry.len():
                        other = fact_project(s, entry[summary.upper], -1, false, T_INT)
                        fact_difference(s, result, other, summary.upper_delta, n)
        else if nodes[n].aux == 1:
            ft = prune(ntype(int(nodes[n].a)))
            if types[ft].kind == .fn_: ref_assume(int(types[ft].elem), result, values, s)
        return result
    if k == .coalesce or k == .iflet:
        # The value path knows the tag and binds the payload; the other path
        # knows none. Each path's own writes invalidate as anywhere else.
        value = fact_capture(int(nodes[n].a), s)
        yes = s
        fact_tag(yes, value, 1, true)
        fact_tag(s, value, 1, false)
        y = 0
        if k == .coalesce:
            y = if nodes[n].aux == 1: value else: fact_project(yes, value, -4, false, ntype(n))
        else:
            l = int(nodes[n].sym)
            if l != 0: fact_bind(yes, PlaceIdentity(.local, int(locals[l].owner), l), fact_project(yes, value, -4, false, int(locals[l].type)))
            y = fact_capture(int(nodes[n].b), yes)
        z = fact_capture((if k == .coalesce: int(nodes[n].b) else: int(nodes[n].c)), s)
        result = fact_hull(fact_bound(yes, y), fact_bound(s, z), n)
        hull = fact_hull_type(ntype(n), yes, y, s, z)
        if not yes.live: result = fact_bound(s, z); hull = fact_terms[z].type
        if not s.live: result = fact_bound(yes, y); hull = fact_terms[y].type
        s = fact_join(yes, s, n)
        # (an owned binding ends here; its hook may write exposed storage)
        if k == .iflet and ownership_decls.len() != 0: fact_forget(s, n, .call)
        return fact_new(s, result, FactTerm(type = hull))
    if k == .map_lit:
        # (each entry is inserted by a call: an unknown callee's effects)
        keys: (int, int)[]
        loop p in kids(n):
            keys.push((int(nodes[p].a), fact_capture(int(nodes[p].a), s)))
            fact_capture(int(nodes[p].b), s)
            fact_forget(s, n, .call)
        result = fact_new(s, fact_domain(ntype(n)))
        # (every key written is in it: fact_map_check)
        if is_map_type(representation_type(ntype(n))):
            loop key in keys: fact_assume(s, fact_project(s, result, fact_map_key(s, key.0, key.1), true, T_BOOL), true)
        return result
    if k == .match_:
        # Arms are tried in order: each sees its predecessors' pattern
        # operands and failed tags, and a matched arm knows its tag.
        subject = int(nodes[n].a)
        value = fact_capture(subject, s)
        hidden = int(nodes[n].sym)
        if hidden != 0: fact_bind(s, PlaceIdentity(.local, int(locals[hidden].owner), hidden), value)
        exits = FactState(live = false)
        result = FactBound()
        first = true
        loop arm in kids(n):
            wild = false
            low = 0
            high = 0
            loop p in kids(arm):
                if nodes[p].kind == .pwild: wild = true
                if nodes[p].kind == .plit or nodes[p].kind == .prange: low = fact_capture(int(nodes[p].a), s)
                if nodes[p].kind == .prange: high = fact_capture(int(nodes[p].b), s)
            path = s
            # (a range arm, as a guard `k:int64<0 <=? k <? 3>` becomes: its bounds hold in the body)
            if nkids(arm) == 1 and nodes[kid(arm, 0)].kind == .prange and fact_scalar(ntype(subject)) and is_int(fact_type(ntype(subject))) and types[fact_type(ntype(subject))].sign:
                fact_assume(path, fact_new(path, fact_domain(T_BOOL), FactTerm(.le, low, value)), true)
                upper = if has_flag(kid(arm, 0), NF_INCLUSIVE): Tok.le else: Tok.lt
                fact_assume(path, fact_new(path, fact_domain(T_BOOL), FactTerm(upper, value, high)), true)
            wanted = if nkids(arm) == 1: fact_pattern_tag(kid(arm, 0), prune(ntype(subject))) else: -1
            if wanted >= 0:
                fact_tag(path, value, wanted, true)
                # (a literal can fail on its own member)
                if nodes[kid(arm, 0)].kind != .plit or not is_union(prune(ntype(subject))): fact_tag(s, value, wanted, false)
            r = fact_capture(int(nodes[arm].b), path)
            if path.live:
                result = if first: fact_bound(path, r) else: fact_hull(result, fact_bound(path, r), n)
                first = false
            exits = fact_join(exits, path, n)
            if wild: s.live = false
        # Without a value, no arm matching falls through; with one, it panics.
        valued = not has_flag(n, NF_STMT) and vc(ntype(n)) != VC_VOID and ntype(n) != T_NEVER
        if not valued: exits = fact_join(exits, s, n)
        s = exits
        if ownership_decls.len() != 0: fact_forget(s, n, .call)
        return fact_new(s, if first: fact_domain(ntype(n)) else: result)
    if k == .field and nodes[n].aux == -3:
        # (a variant's payload field, bound by a match arm)
        fact_capture(int(nodes[n].a), s)
        return fact_new(s, fact_domain(ntype(n)))
    # Opaque forms cannot export facts; evaluate each child from top so control
    # alternatives, implicit hooks and raw aliases cannot mint stale evidence.
    fact_forget(s, n, .unsupported, true)
    mask = isolation_children(k)
    if mask & 1 != 0 and mask >= 0: fact_capture(int(nodes[n].a), s)
    if mask & 2 != 0 and mask >= 0: fact_capture(int(nodes[n].b), s)
    if mask & 4 != 0 and mask >= 0: fact_capture(int(nodes[n].c), s)
    if mask & 16 != 0 and mask >= 0:
        loop c in kids(n):
            fact_forget(s, n, .unsupported, true)
            fact_capture(c, s)
    fact_forget(s, n, .unsupported, true)
    return fact_new(s, FactBound(reason = .unsupported, witness = n))

# A function is the library's when its module was read from the library
# directory (its body position cannot say: the prelude's initializer starts at
# offset 0 of file 0, which is no position at all).
fn_in_lib = (f: int) -> bool:
    m = int(fns[f].mod)
    if m >= 0 and m < modules.len():
        file = int(modules[m].file)
        return len(lib_root) > 0 and file >= 0 and file < files.len() and starts_with(files[file].path, lib_root)
    pos_in_lib(nodes[int(fns[f].body)].pos)

# The default progress axiom covers additive updates of 64-bit storage by a
# stored machine-word amount. It is not a proof of a multiply, an unbounded
# exact intermediate, or a narrower counter. The scoped opt-out requires the
# ordinary range proof instead. Candidate recognition runs only at exact stores;
# its increment walk is O(increment nodes × place depth), with no body-wide analysis.
fact_progress_strip = (n0: int) -> int:
    n = n0
    loop nodes[n].kind == .conv and (nodes[n].aux == i32(int(CV.none_)) or nodes[n].aux == i32(int(CV.int_))): n = int(nodes[n].a)
    n

fact_progress_same = (a0: int, b0: int, depth: int = 0) -> bool:
    if depth > 32: return false
    a = fact_progress_strip(a0); b = fact_progress_strip(b0)
    k = nodes[a].kind
    if k != nodes[b].kind: return false
    if k == .ident: return nodes[a].aux == nodes[b].aux and nodes[a].sym == nodes[b].sym and (nodes[a].aux == i32(int(SK.local)) or nodes[a].aux == i32(int(SK.global)))
    if k == .int_lit: return nodes[a].ival == nodes[b].ival
    if k == .field:
        return nodes[a].aux == nodes[b].aux and nodes[a].name == nodes[b].name and nodes[a].ival == nodes[b].ival and fact_progress_same(int(nodes[a].a), int(nodes[b].a), depth + 1)
    if k == .index and nodes[a].aux == 0 and nodes[b].aux == 0 and nodes[a].b != 0 and nodes[b].b != 0:
        return fact_progress_same(int(nodes[a].a), int(nodes[b].a), depth + 1) and fact_progress_same(int(nodes[a].b), int(nodes[b].b), depth + 1)
    false

# A recurrence such as x += x is geometric growth, not bounded progress.
# Inspect only the candidate increment, never an unrelated function body.
# Preparation already records writes. A query follows their indexed heads,
# including assignments later in the body, with a 64-node budget. Epoch marks
# break independent recurrence cycles without hiding a path to the counter.
# O(N+E) collection, O(64*C*P) queries for C candidates and place depth P,
# O(L+W) indexed storage; ordinary scalar counters have P=1.
fact_progress_root = (n0: int) -> int:
    n = n0
    loop depth in [0..32):
        n = fact_progress_strip(n)
        if nodes[n].kind == .field or nodes[n].kind == .index or nodes[n].kind == .unwrap or nodes[n].kind == .narrow:
            n = int(nodes[n].a)
        else if nodes[n].kind == .ident and nodes[n].aux == i32(int(SK.local)) and int(locals[int(nodes[n].sym)].flags) & LF_ALIAS != 0 and locals[int(nodes[n].sym)].alias != 0:
            n = int(locals[int(nodes[n].sym)].alias)
        else: return n
    0

# Distinct dynamic indices may designate the same element. Only different
# literal indices and different field routes prove these stores disjoint.
fact_progress_may_alias = (a0: int, b0: int, depth: int = 0) -> bool:
    if depth >= 32: return true
    a = fact_progress_strip(a0); b = fact_progress_strip(b0)
    if nodes[a].kind == .ident or nodes[b].kind == .ident: return fact_progress_same(fact_progress_root(a), fact_progress_root(b))
    if nodes[a].kind != nodes[b].kind: return false
    if nodes[a].kind == .field:
        return nodes[a].name == nodes[b].name and nodes[a].ival == nodes[b].ival and fact_progress_may_alias(int(nodes[a].a), int(nodes[b].a), depth + 1)
    if nodes[a].kind == .index:
        ai = int(nodes[a].b); bi = int(nodes[b].b)
        if ai == 0 or bi == 0: return true
        if nodes[ai].kind == .int_lit and nodes[bi].kind == .int_lit and nodes[ai].ival != nodes[bi].ival: return false
        return fact_progress_may_alias(int(nodes[a].a), int(nodes[b].a), depth + 1)
    true

# A bounded increment cannot secretly count iterations controlled by the
# accumulator. Control links share the same 64-edge dependency budget.
fact_progress_control_depends = (head0: int, target: int) -> bool:
    head = head0
    loop head > 0:
        exact_dependency_budget -= 1
        if exact_dependency_budget < 0 or fact_progress_depends(exact_control_values[head - 1], target): return true
        head = exact_control_parents[head - 1]
    false

fact_progress_place_depends = (n: int, target: int) -> bool:
    root = fact_progress_root(n)
    if nodes[root].kind == .array or nodes[root].kind == .tuple: return fact_progress_depends(root, target)
    if nodes[root].kind == .ident and nodes[root].aux == i32(int(SK.global)):
        g = int(nodes[root].sym)
        counter = fact_progress_root(target)
        # An immutable module value predates a private local accumulator.
        # It cannot contain that local's later progress, including in scripts.
        if nodes[counter].kind == .ident and nodes[counter].aux == i32(int(SK.local)) and not globals[g].fn_written and not globals[g].init_written and not globals[g].exposed: return false
        return true
    if nodes[root].kind != .ident or nodes[root].aux != i32(int(SK.local)): return true
    l = int(nodes[root].sym)
    if int(locals[l].flags) & (LF_ALIAS | LF_CAPTURE | LF_SHARED | LF_EXPOSED | LF_ELEMALIAS | LF_SOAELEM) != 0: return true
    if l < exact_progress_opaque.len() and exact_progress_opaque[l]: return true
    if l < exact_initializers.len() and exact_initializers[l] > 0:
        if fact_progress_depends(exact_initializers[l], target): return true
    edge = if l < exact_write_heads.len(): exact_write_heads[l] else: 0
    loop edge > 0:
        exact_dependency_budget -= 1
        if exact_dependency_budget < 0: return true
        at = edge - 1
        written = exact_write_targets[at]
        if exact_write_seen[at] != exact_dependency_epoch and fact_progress_may_alias(written, n):
            exact_write_seen[at] = exact_dependency_epoch
            if fact_progress_depends(exact_write_values[at], target) or fact_progress_control_depends(exact_write_controls[at], target): return true
        edge = exact_write_next[at]
    false

fact_progress_local_depends = (l: int, target: int) -> bool:
    exact_dependency_budget -= 1
    if exact_dependency_budget < 0: return true
    root = fact_progress_strip(target)
    if nodes[root].kind == .ident and nodes[root].aux == i32(int(SK.local)) and nodes[root].sym == i32(l): return true
    if l <= 0 or l >= locals.len(): return true
    t = exact_representation(int(locals[l].type))
    # Aggregate actuals can carry the counter into a called helper too.
    # Follow their indexed definitions/writes under the same query budget.
    if l < exact_progress_opaque.len() and exact_progress_opaque[l]: return true
    flags = int(locals[l].flags)
    if is_fn_type(t) and flags & LF_RESIZED != 0: return true
    if flags & LF_ALIAS != 0 and locals[l].alias != 0: return fact_progress_depends(int(locals[l].alias), target)
    # Read-only iteration aliases draw from the indexed source snapshot.
    if l < exact_iteration_sources.len() and exact_iteration_sources[l] != 0:
        source = exact_iteration_sources[l]
        if nodes[source].kind == .range: return fact_progress_depends(source, target)
        return fact_progress_place_depends(source, target)
    # An array parameter predates a private scalar accumulator. Its entry
    # contents cannot depend on that local; indexed writes still can. Unknown
    # mutation and insertion were rejected above, while pop only removes data.
    root = fact_progress_strip(target)
    if types[t].kind == .array and flags & LF_PARAM != 0 and nodes[root].kind == .ident and nodes[root].aux == i32(int(SK.local)):
        counter = int(nodes[root].sym)
        if int(locals[counter].flags) & (LF_MUTPARAM | LF_ALIAS | LF_BYREF | LF_ADDR | LF_CAPTURE | LF_SHARED | LF_EXPOSED) == 0:
            flags &= ~(LF_MUTPARAM | LF_BYREF | LF_ADDR)
    # Writes through aliases/captures are outside this local assignment index.
    if flags & (LF_MUTPARAM | LF_ALIAS | LF_BYREF | LF_ADDR | LF_SHARED | LF_EXPOSED) != 0: return true
    if l >= exact_dependency_seen.len(): exact_dependency_seen.resize(locals.len())
    if exact_dependency_seen[l] == exact_dependency_epoch: return false
    exact_dependency_seen[l] = exact_dependency_epoch
    if flags & LF_CAPTURE != 0:
        if fact_progress_local_depends(int(locals[l].outer), target): return true
    if l < exact_initializers.len() and exact_initializers[l] > 0:
        if fact_progress_depends(exact_initializers[l], target): return true
    edge = if l < exact_write_heads.len(): exact_write_heads[l] else: 0
    loop edge > 0:
        if fact_progress_depends(exact_write_values[edge - 1], target) or fact_progress_control_depends(exact_write_controls[edge - 1], target): return true
        edge = exact_write_next[edge - 1]
    false

fact_progress_depends = (n: int, target: int) -> bool:
    if n <= 0: return false
    exact_dependency_budget -= 1
    if exact_dependency_budget < 0: return true
    if fact_progress_same(n, target): return true
    # The enabled array bound already limits every length independently of
    # element contents. Field writes cannot make a loop's length unbounded.
    if nodes[n].kind == .intrinsic and nodes[n].aux == i32(int(IN.len)) and positive_bound(n, false) >= 0: return false
    if nodes[n].kind == .ident:
        if nodes[n].aux == i32(int(SK.local)): return fact_progress_local_depends(int(nodes[n].sym), target)
        if nodes[n].aux == i32(int(SK.global)): return true
    if nodes[n].kind == .field or nodes[n].kind == .index:
        if fact_progress_place_depends(n, target): return true
        # The route query already follows only writes that can reach this
        # field/element; inspecting its whole aggregate would lose that fact.
        if nodes[n].kind == .index: return fact_progress_depends(int(nodes[n].b), target)
        return false
    if nodes[n].kind == .lambda or nodes[n].kind == .call:
        root = fact_progress_root(target)
        # A call can read global storage without an explicit actual argument.
        if nodes[root].kind == .ident and nodes[root].aux == i32(int(SK.global)): return true
        f = int(nodes[n].sym)
        if nodes[n].kind == .lambda and has_flag(n, NF_GENERIC): return true
        if f > 0 and f < fns.len():
            loop capture in fns[f].caps:
                if nodes[root].kind == .ident and nodes[root].aux == i32(int(SK.local)) and nodes[root].sym == capture.outer: return true
                if fact_progress_local_depends(int(capture.outer), target): return true
    mask = isolation_children(nodes[n].kind)
    if mask <= 0: return false
    if mask & 1 != 0 and fact_progress_depends(int(nodes[n].a), target): return true
    if mask & 2 != 0 and fact_progress_depends(int(nodes[n].b), target): return true
    if mask & 4 != 0 and fact_progress_depends(int(nodes[n].c), target): return true
    if mask & 16 != 0:
        loop child in kids(n):
            if fact_progress_depends(child, target): return true
    false

# Across a temporary, a changed index must not turn a copy between elements
# into progress of one counter. Field/array routes must remain stable.
fact_progress_stable = (n0: int) -> bool:
    n = fact_progress_strip(n0)
    k = nodes[n].kind
    if k == .ident:
        return nodes[n].aux == i32(int(SK.local)) and int(locals[int(nodes[n].sym)].flags) & (LF_RESIZED | LF_ALIAS | LF_CAPTURE | LF_CAPTURED | LF_SHARED) == 0
    if k == .int_lit: return true
    if k == .field: return fact_progress_stable(int(nodes[n].a))
    if k == .index and nodes[n].aux == 0:
        index = fact_progress_strip(int(nodes[n].b))
        stable = nodes[index].kind == .int_lit or nodes[index].kind == .ident and nodes[index].aux == i32(int(SK.local)) and stable_loop_index(int(nodes[index].sym))
        return stable and fact_progress_stable(int(nodes[n].a))
    false

fact_progress_note = (assignment: int):
    target = int(nodes[assignment].a)
    store = int(nodes[assignment].b)
    if nodes[store].kind == .ident and nodes[store].aux == i32(int(SK.local)) and fact_progress_stable(target):
        l = int(nodes[store].sym)
        if l > 0 and l < exact_initializers.len() and int(locals[l].flags) & (LF_PARAM | LF_CAPTURE | LF_CAPTURED | LF_ALIAS | LF_BYREF | LF_ADDR | LF_SHARED | LF_EXPOSED) == 0:
            candidate = exact_initializers[l]
            if candidate > 0 and exact_has_store(candidate): store = candidate
    mathematical = nodes[store].kind == .conv and nodes[store].aux == i32(int(CV.int_)) and exact_representation(ntype(int(nodes[store].a))) == T_MATH_INT
    if not exact_has_store(store) and not mathematical: return
    t = exact_representation(ntype(target))
    if not is_int(t) or t == T_MATH_INT or types[t].bits != 64 or int_policy(t) != 0: return
    if dir_scopes.len() > 0 and dir_value(dir_name_assumed_bounds, nodes[store].pos) == 1: return
    source = int(nodes[store].a)
    operation = fact_progress_strip(source)
    if nodes[operation].kind != .binary or nodes[operation].aux != 0: return
    op = nodes[operation].op as Tok
    if op != .plus and op != .minus: return
    increment = int(nodes[operation].b)
    if not fact_progress_same(target, int(nodes[operation].a)):
        if op != .plus or not fact_progress_same(target, increment): return
        increment = int(nodes[operation].a)
    exact_dependency_epoch += 1
    exact_dependency_budget = 64
    # A syntactically bounded increment stays bounded even if it refers to
    # the accumulator (for example count & 255). Reuse that existing proof.
    if fact_progress_depends(increment, target) and positive_bound(increment, false) < 0: return
    it = exact_representation(ntype(increment))
    if mathematical:
        # A masked or otherwise bounded mathematical increment need not box
        # the fixed accumulator merely to add it. The axiom supplies the fit.
        if not types[t].sign or positive_bound(increment, false) < 0: return
        exact_progress_math[store] = true
        exact_reserve(store)
        exact_marks[store] |= 64
        return
    if exact_has_node(increment) or not is_int(it) or it == T_MATH_INT or types[it].bits > 64: return
    exact_decide(store, true)
    exact_marks[store] |= 32
    # The assumed boundary makes this cloned root a machine-word operation.
    # Its operands are stored values; no wider intermediate is discarded.
    if source == operation: exact_unmark(source)
    if exact_measure_on:
        site = exact_measure_sites[store]
        site.category = "progress-axiom"
        exact_measure_sites[store] = site

fact_exact_demand = (n: int) -> bool:
    (exact_has_store(n) and not exact_decided(n) and (fact_deferred_proving or dir_obligations or dir_policy(nodes[n].pos) == DIR_STATIC)) or (n >= 0 and n < exact_marks.len() and exact_marks[n] & 128 != 0)

# (Jo sources, the compiler's own, keep runtime checks: none is demanded)
fn_dewy = (f: int) -> bool:
    m = int(fns[f].mod)
    if m >= 0 and m < modules.len():
        file = int(modules[m].file)
        return file >= 0 and file < files.len() and files[file].is_dewy
    files[pos_file(nodes[int(fns[f].body)].pos)].is_dewy

facts_finalize = ():
    if proof_active: proof_prepare()
    if loan_owners.len() == 0 and fact_requests.len() == 0 and refine_requests.len() == 0 and wi_fact_requests.len() == 0 and proof_calls.len() == 0 and not proof_active and not result_active and fact_policy == .RuntimeAllowed and exact_stores.len() == 0 and exact_owners.len() == 0: return
    demanded: {int: bool} = {}
    loop request in wi_fact_requests: demanded[request.owner] = true
    loop f, _ in loan_owners: demanded[f] = true
    if proof_active:
        loop call in proof_calls: demanded[call.owner] = true
        loop f in [1..fns.len()):
            if proof_decls.has(int(fns[f].decl)): demanded[f] = true
    loop request in fact_requests: demanded[request.owner] = true
    if result_active:
        loop f in [1..fns.len()):
            if result_contracts.has(int(fns[f].decl)): demanded[f] = true
    mandatory = demanded
    loop request in refine_requests: demanded[request.owner] = true
    loop f, _ in exact_proof_demands: demanded[f] = true
    if fact_policy == .RequireStatic:
        loop f in [1..fns.len()):
            if fns[f].body != 0 and fns[f].state == 2 and not fn_in_lib(f) and fn_dewy(f): demanded[f] = true
    # (closures after the functions that create them: a fork's entry facts)
    order: int[]
    loop f, _ in demanded:
        if f > 0 and f < fns.len() and fns[f].kind != FK_LAMBDA: order.push(f)
    loop f, _ in demanded:
        if f <= 0 or f >= fns.len() or fns[f].kind == FK_LAMBDA: order.push(f)
    loop f in order:
        # (another process's body: it decides its own; a body already
        # decided here is not decided again)
        if effect_unavailable.has(f) or fact_decided.has(f): continue
        fact_decided[f] = true
        if f <= 0 or f >= isolation_limit or fns[f].state != 2: fatal(-1, "cannot prove assertion: unsettled checked body")
        icb = ic_fn(IC_FACTS, f)
        if let run = fact_probe_runs.get(f):
            if fact_probe_reusable(f, run):
                loop n, _ in run.proven:
                    if nodes[n].kind == .index and not has_flag(n, NF_INBOUNDS): dir_index(n, true)
                ic_restore(icb)
                continue
        fact_owner = f
        fact_terms = [FactTerm()]
        state = FactState()
        previous_policy = fact_policy
        if proof_active and proof_decls.has(int(fns[f].decl)): fact_policy = .RequireStatic
        # (a body with no partial operation, assertion or contract has
        # nothing to decide: its loops and calls are not walked for it)
        fact_has_deferred = false
        fact_panic_collect = true
        fact_panic_pending = []
        uniform_defer = not dir_obligations and not ide_on and not dir_forced and not exact_proof_demands.has(f) and dir_uniform_runtime(nodes[int(fns[f].body)].pos)
        if not mandatory.has(f) and not result_active and not (proof_active and proof_decls.has(int(fns[f].decl))) and ownership_decls.len() == 0 and not loan_owners.has(f) and (uniform_defer or not fact_obliged(int(fns[f].body))):
            if not uniform_defer and fact_panic_collect: fact_panic_sites[f] = fact_panic_pending
            fact_panic_collect = false
            if uniform_defer or fact_has_deferred: fact_deferred[f] = true
            fact_policy = previous_policy
            ic_restore(icb)
            continue
        fact_panic_collect = false
        if refine_active or refine_requests.len() > 0: refine_fact_entry(f, state)
        if fact_fork_entries.len() > 0 or fact_parallel_bounds.len() > 0: fact_fork_seed(f, state)
        fact_slice_prepare(f)
        result = fact_capture(int(fns[f].body), state)
        if result_active: result_exit(f, result, int(fns[f].body), state)
        if proof_active and proof_decls.has(int(fns[f].decl)): proof_exit(f, int(fns[f].body), state)
        fact_policy = previous_policy
        ic_restore(icb)
    fact_owner = 0
    fact_slice = FactSlice()
    exact_finish()
    # A conservative transfer must never silently lose an obligation (opaque
    # controls, deferred cleanup, or checked nodes absent from a published body).
    # Retry such a request with no evidence, never as compile-time execution.
    loop request in fact_requests:
        if not fact_validated.has(request.node):
            fact_terms = [FactTerm()]
            state = FactState()
            fact_retry_owner = request.owner
            fact_capture(request.node, state)
    loop request in refine_requests:
        if not fact_validated.has(request.node) and not fact_validated.has(ref_wrapped_check(request.node)):
            fact_terms = [FactTerm()]
            state = FactState()
            refine_entry = []
            fact_retry_owner = request.owner
            fact_capture(request.node, state)
    fact_retry_owner = 0
    loop request in fact_requests:
        # (an unpacking's length left unproven stays, a runtime check)
        if nodes[request.node].aux == i32(int(IN.static_assert)): set_list(request.node, [])
    fact_requests = []
    fact_terms = []
    if proof_active: proof_erase()
    if wi_fact_requests.len() > 0: wi_fact_finish()
    if wit_collected > 0 and not wit_measure: stop(1)

# Harness-only policy; this is not a strict-lane surface or no-panic claim. The test tools
# ask for it with `--internal-fact-policy=...` before the command (main.jo); no setting
# from the environment changes what a build means.
fact_internal_policy = ""

facts_reset = ():
    fact_search_predicate = 0
    exact_reset()
    fact_slice = FactSlice()
    fact_slice_cache = {}
    fact_fork_nodes = {}
    fact_fork_entries = {}
    fact_parallel_bounds = {}
    fact_decided = {}
    fact_deferred = {}
    fact_deferred_checks = {}
    fact_deferred_proving = false
    fact_panic_sites = {}
    fact_panic_collect = false
    fact_panic_pending = []
    fact_policy_default = false
    fact_probe_runs = {}
    fact_returns_cache = {}
    fact_owner = 0
    fact_summaries = {}
    fact_summary_owner = 0
    fact_requests = []
    fact_divisors = {}
    fact_validated = {}
    fact_query = false
    fact_policy = FactPolicy.RuntimeAllowed
    if len(fact_internal_policy) > 0:
        policy = fact_internal_policy
        if policy == "require-static" or policy == "require-static-all" or policy == "require-static-measure": fact_policy = .RequireStatic
        wit_collect = policy == "require-static-all" or policy == "require-static-measure"
        # (measure: report every failure and build anyway, so `build --time`
        # shows what analysing every function costs)
        wit_measure = policy == "require-static-measure"

positive_bounds_fn = -1
positive_collecting_writes = false
positive_bounds: {int: int} = {}
positive_epoch = 1
positive_cache: int[]
positive_stamp: int[]

# Upper bound of a nonnegative integer expression, or -1 when unknown.
# The bound itself must fit the analysis host word; wider results are unknown.
# During write collection, do not use local bounds (no circular assumptions).
positive_bound = (n: int, use_locals: bool) -> int:
    if not use_locals: return positive_bound_value(n, false)
    if n >= positive_cache.len():
        positive_cache.resize(max(n + 1, nodes.len()))
        positive_stamp.resize(positive_cache.len())
    if positive_stamp[n] == positive_epoch: return positive_cache[n]
    value = positive_bound_value(n, true)
    positive_cache[n] = value
    positive_stamp[n] = positive_epoch
    value

# One cache entry per expression in a lowering context. Statements and range
# scopes advance the epoch; no facts are reused across changed loop assumptions.
# O(demanded expression nodes/edges) per context, O(N) indexed storage.
positive_bound_value = (n: int, use_locals: bool) -> int:
    if n == 0: return -1
    t = exact_representation(ntype(n))
    if types[t].kind != .int_: return -1
    # An exact conversion is an unrounded intermediate until its store. Its
    # destination type must not hide the source range from that obligation.
    if exact_has_node(n) and nodes[n].kind == .conv and (nodes[n].aux == i32(int(CV.int_)) or nodes[n].aux == i32(int(CV.none_))):
        return positive_bound(int(nodes[n].a), use_locals)
    if not types[t].sign and int(types[t].bits) < 64 and not exact_has_node(n): return (1 << int(types[t].bits)) - 1
    if t != T_INT and t != T_MATH_INT: return -1
    k = nodes[n].kind
    if k == .int_lit:
        if has_flag(n, NF_U64) or nodes[n].ival < 0: return -1
        return nodes[n].ival
    if k == .ident and nodes[n].aux == i32(int(SK.local)) and use_locals:
        if let limit = math_word_limits.get(int(nodes[n].sym)): return limit
        loop i in [0..nonneg_locals.len()):
            if nonneg_locals[i] == int(nodes[n].sym): return nonneg_limits[i]
        l = int(nodes[n].sym)
        fl = int(locals[l].flags)
        if fl & LF_DECL == 0 or fl & (LF_PARAM | LF_MUTPARAM | LF_CAPTURE | LF_CAPTURED | LF_ALIAS | LF_BYREF | LF_ADDR | LF_SHARED | LF_SOAELEM | LF_ELEMALIAS | LF_QUIET) != 0: return -1
        if positive_bounds_fn != cur_fn:
            positive_bounds_fn = cur_fn
            positive_bounds.clear()
            math_prepare_writes()
        return positive_bounds.get(l) ?? -1
    if k == .conv and (nodes[n].aux == i32(int(CV.int_)) or nodes[n].aux == i32(int(CV.fixed_store))):
        return positive_bound(int(nodes[n].a), use_locals)
    if k == .intrinsic and nodes[n].aux == i32(int(IN.len)) and nkids(n) == 1:
        t = prune(ntype(kid(n, 0)))
        # (no allocation outgrows the address space: 2^56 bytes on any target)
        if types[t].kind == .array:
            if dir_value(dir_name_assumed_bounds, nodes[n].pos) == 1: return -1
            # An initializer outside a nested opt-out must not seed an
            # assumed local range later reused inside that opt-out.
            if positive_collecting_writes and dir_assumed_bounds_any: return -1
            return if tsize(telem(t)) > 0: (1 << 56) / tsize(telem(t)) else: 9223372036854775807
    modulus = positive_modulus(n)
    if modulus > 0: return modulus - 1
    if k != .binary or nodes[n].aux != 0: return -1
    op = nodes[n].op as Tok
    if op == .amp:
        a = positive_bound(int(nodes[n].a), use_locals)
        b = positive_bound(int(nodes[n].b), use_locals)
        if a >= 0 and b >= 0: return min(a, b)
        return max(a, b)
    if op != .plus and op != .star: return -1
    a = positive_bound(int(nodes[n].a), use_locals)
    b = positive_bound(int(nodes[n].b), use_locals)
    if a < 0 or b < 0: return -1
    if op == .plus:
        if a > 9223372036854775807 - b: return -1
        return a + b
    if b == 0: return 0
    if a > 9223372036854775807 / b: return -1
    a * b

positive_local_write = (l: int, bound: int):
    if l <= 0 or int(locals[l].owner) != cur_fn: return
    fl = int(locals[l].flags)
    skip = LF_PARAM | LF_MUTPARAM | LF_CAPTURE | LF_CAPTURED | LF_ALIAS | LF_BYREF | LF_ADDR | LF_SHARED | LF_SOAELEM | LF_ELEMALIAS | LF_QUIET
    if fl & LF_DECL == 0 or fl & skip != 0 or (prune(int(locals[l].type)) != T_INT and prune(int(locals[l].type)) != T_MATH_INT): return
    old = positive_bounds.get(l) ?? bound
    if old < 0 or bound < 0: positive_bounds[l] = -1
    else: positive_bounds[l] = max(old, bound)

positive_target_write = (n: int, bound: int):
    if nodes[n].kind == .ident and nodes[n].aux == i32(int(SK.local)):
        positive_local_write(int(nodes[n].sym), bound)
    else if nodes[n].kind == .tuple:
        loop i in [0..nkids(n)): positive_target_write(kid(n, i), -1)

positive_write = (n: int):
    k = nodes[n].kind
    if k == .vardecl and not has_flag(n, NF_GLOBAL):
        if nkids(n) == 0:
            b = int(nodes[n].b)
            positive_local_write(int(nodes[n].sym), if b == 0: 0 else: positive_bound(b, false))
        else:
            loop i in [0..nkids(n)): positive_local_write(int(nodes[kid(n, i)].sym), -1)
    if k == .assign:
        bound = -1
        if nodes[n].op == i32(int(Tok.assign)) and nodes[n].aux == 0: bound = positive_bound(int(nodes[n].b), false)
        positive_target_write(int(nodes[n].a), bound)


# Storage summaries are collected once per loop, including its condition.
# Outer loops reuse inner inventories; lowering retains all pointer/uniqueness
# prerequisites independently of numeric bounds. Cache lifetime is one function.
struct FactStorage:
    bases: int[]
    kill: int[]
    escape: int[]
    written: int[]
    calls: bool
    opaque: bool
fact_storage_cache: {int: FactStorage} = {}

fact_storage_loop = (n: int) -> FactStorage:
    if let cached = fact_storage_cache.get(n): return cached
    saved = FactStorage(fp_bases, fp_kill, fp_escape, fp_written, fp_calls, fp_lambda)
    fp_bases = []; fp_kill = []; fp_escape = []; fp_written = []
    fp_calls = false; fp_lambda = false
    fact_storage_scan(int(nodes[n].b), 0)
    if nodes[n].kind == .while_: fact_storage_scan(int(nodes[n].a), 0)
    result = FactStorage(fp_bases, fp_kill, fp_escape, fp_written, fp_calls, fp_lambda)
    fact_storage_cache[n] = result
    fp_bases = saved.bases; fp_kill = saved.kill
    fp_escape = saved.escape; fp_written = saved.written
    fp_calls = saved.calls; fp_lambda = saved.opaque
    result

# ctx: 0 the value is used (copied, passed), 1 it is only indexed or measured
fact_storage_scan = (n: int, ctx: int):
    if n == 0: return
    k = nodes[n].kind
    if k == .for_ or k == .while_:
        summary = fact_storage_loop(n)
        loop v in summary.bases: fp_bases.push(v)
        loop v in summary.kill: fp_kill.push(v)
        loop v in summary.escape: fp_escape.push(v)
        loop v in summary.written: fp_written.push(v)
        fp_calls = fp_calls or summary.calls or not ambient_storage_stable(n)
        fp_lambda = fp_lambda or summary.opaque
        if k == .for_:
            if has_flag(n, NF_MUT):
                key = lpath_key(int(nodes[n].a))
                if key != 0: fp_kill.push(key)
            fact_storage_scan(int(nodes[n].a), 0)
        return
    # An unclassified operation may also affect its local actuals. Merely
    # marking ambient calls would still allow caching a private local array.
    mask = isolation_children(k)
    if mask < 0 or k == .intrinsic and not isolation_intrinsic(nodes[n].aux as IN):
        fp_lambda = true
        return
    if not ambient_storage_stable(n): fp_calls = true
    if k == .lambda:
        fp_lambda = true
        return
    if k == .ident and nodes[n].aux == i32(int(SK.local)) and int(locals[int(nodes[n].sym)].flags) & LF_ELEMALIAS != 0:
        # (x of `mut x in xs` in a combined loop: writing x writes xs, which the body does not show)
        key = lpath_key(int(nodes[int(locals[int(nodes[n].sym)].alias)].a))
        if key != 0: fp_kill.push(key)
        return
    if k == .ident or k == .field:
        key = lpath_key(n)
        if key != 0:
            if ctx == 0: fp_escape.push(key)
            if k == .field: fact_storage_scan(int(nodes[n].a), 1)
            return
        if k == .field: fact_storage_scan(int(nodes[n].a), 0)
        return
    if k == .index:
        base = int(nodes[n].a)
        if lpath_key(base) != 0 and tkind(ntype(base)) == .array: fp_bases.push(base)
        # A slice retains its source while its bounds run; writes in those
        # bounds must still detach, including when the slice is inside a loop.
        fact_storage_scan(base, if nodes[n].aux == 1: 0 else: 1)
        fact_storage_scan(int(nodes[n].b), 0)
        loop i in [0..nkids(n)): fact_storage_scan(kid(n, i), 0)
        return
    if k == .assign:
        fact_storage_target(int(nodes[n].a))
        fact_storage_scan(int(nodes[n].b), 0)
        return
    # (a pointer to a variable, or to an array's elements, may write it: data() also makes the
    # array one of its own first, which may move it)
    if k == .addr or (k == .cast or k == .conv) and raw_view(n):
        key = lpath_key(int(nodes[n].a))
        if key != 0: fp_kill.push(key)
        fact_storage_scan(int(nodes[n].a), 1)
        return
    if k == .intrinsic and nkids(n) > 0:
        id = nodes[n].aux as IN
        if id == .push or id == .pop or id == .insert or id == .remove or id == .clear or id == .reserve or id == .resize or id == .truncate or id == .extend or id == .arrdata:
            key = lpath_key(kid(n, 0))
            if key != 0: fp_kill.push(key)
            fact_storage_scan(kid(n, 0), 1)
            loop i in [1..nkids(n)): fact_storage_scan(kid(n, i), 0)
            return
        if id == .len or id == .arrcap:
            fact_storage_scan(kid(n, 0), 1)
            return
    if k == .call:
        mm = checked_call_mutmask(n)
        loop i in [0..nkids(n)):
            if mm & (1 << i) != 0:
                key = lpath_key(kid(n, i))
                if key != 0: fp_kill.push(key)
                # (`@xs[i]` writes an element, like an assignment to it: xs must be made unique)
                else: fact_storage_target(kid(n, i))
    if k == .for_ and has_flag(n, NF_MUT):
        # (loop mut x in p may make p a copy of its own)
        key = lpath_key(int(nodes[n].a))
        if key != 0: fp_kill.push(key)
    if mask & 1 != 0: fact_storage_scan(int(nodes[n].a), 0)
    if mask & 2 != 0: fact_storage_scan(int(nodes[n].b), 0)
    if mask & 4 != 0: fact_storage_scan(int(nodes[n].c), 0)
    if mask & 16 != 0:
        loop i in [0..nkids(n)): fact_storage_scan(kid(n, i), 0)
    if mask & 32 != 0:
        loop i in [0..nkids2(n)): fact_storage_scan(kid2(n, i), 0)

# an assignment target: the arrays along it have elements written; a path itself is replaced
fact_storage_target = (t: int):
    if not ambient_storage_stable(t): fp_calls = true
    k = nodes[t].kind
    # (an element alias's array: written)
    r = t
    loop nodes[r].kind == .field: r = int(nodes[r].a)
    if nodes[r].kind == .ident and nodes[r].aux == i32(int(SK.local)) and int(locals[int(nodes[r].sym)].flags) & LF_ELEMALIAS != 0:
        fact_storage_scan(r, 0)
        return
    if k == .index:
        base = int(nodes[t].a)
        key = lpath_key(base)
        if key != 0:
            fp_written.push(key)
            if tkind(ntype(base)) == .array: fp_bases.push(base)
            fact_storage_scan(base, 1)
        else: fact_storage_target(base)
        fact_storage_scan(int(nodes[t].b), 0)
        loop i in [0..nkids(t)): fact_storage_scan(kid(t, i), 0)
        return
    key = lpath_key(t)
    if key != 0:
        fp_kill.push(key)
        if k == .field: fact_storage_scan(int(nodes[t].a), 1)
        return
    if k == .field:
        fact_storage_target(int(nodes[t].a))
        return
    fact_storage_scan(t, 0)


# Cheap lowering facts share this module; full relational states stay demanded.
# bounds: the length is fixed, and an empty (null) A never enters the loop.
len_of_local: {int: int}        # local n -> local A when n := A.len() and neither ever changes
safe_index: (int, int, bool)[]  # (array local, loop variable local, keep its null check)
nonneg_locals: int[]            # loop variables of ranges that start at a value >= 0
nonneg_limits: int[]            # matching constant upper limits, or -1
# A loop's control counter stays in range, but its user-visible variable can
# be reassigned, passed by reference, or changed by a closure in the body.
stable_loop_index = (l: int) -> bool:
    if l < 0: return false
    fl = int(locals[l].flags)
    fl & (LF_ASSIGNED | LF_ALIAS | LF_CAPTURE | LF_BYREF | LF_ADDR) == 0 and not is_shared(l)

# e is an integer expression that is never negative
# The step-1 int/int64 boundary changes semantic type but preserves every bit
# and value. Existing index/length proofs can look through just that boundary.
# This is representation-specific: step 2 must prove a word representation first.
word_integer_value = (n0: int) -> int:
    n = n0
    loop nodes[n].kind == .conv and nodes[n].aux == i32(int(CV.int_)):
        inner = int(nodes[n].a)
        source = prune(ntype(inner))
        target = prune(ntype(n))
        if not ((source == T_INT and target == T_MATH_INT) or (source == T_MATH_INT and target == T_INT)): break
        n = inner
    n

is_nonneg = (e0: int) -> bool:
    e = word_integer_value(e0)
    if e == 0: return false
    k = nodes[e].kind
    if k == .int_lit: return nodes[e].ival >= 0
    if k == .ident and nodes[e].aux == i32(int(SK.local)): return nonneg_locals.contains(int(nodes[e].sym))
    if k == .intrinsic and (nodes[e].aux as IN) == .len: return true
    # Positive operands alone do not prove a word-sized sum/product is
    # nonnegative: it can overflow. Keep the check without a range proof.
    false

# A, if e is A.len() / len(A) for an array local A that is never modified, else -1
fixed_array_len = (e0: int) -> int:
    e = word_integer_value(e0)
    if e == 0 or nodes[e].kind != .intrinsic or (nodes[e].aux as IN) != .len or nkids(e) != 1: return -1
    a = kid(e, 0)
    if nodes[a].kind != .ident or nodes[a].aux != i32(int(SK.local)): return -1
    ak = types[prune(ntype(a))].kind
    if ak != .array and ak != .str_: return -1          # (a str's length changes only when it is assigned)
    l = int(nodes[a].sym)
    if not fixed_array_local(l): return -1
    l

# the length of array local l cannot change during this function
fixed_array_local = (l: int) -> bool:
    # element writes keep the length; writing the variable itself (or a mut parameter, which
    # could be the caller's global) may not
    fl = int(locals[l].flags)
    if fl & (LF_RESIZED | LF_ALIAS | LF_BYREF) != 0 or is_shared(l): return false
    if fl & LF_MUTPARAM != 0 and not ambient_length_stable(cur_fn): return false
    true

array_len_expr: {int: int}      # array local A -> E when A := [x; E] and A is never resized

# x and y always have the same value: literals, unchanging locals and + - * of those
same_value = (x: int, y: int) -> bool:
    if x == 0 or y == 0 or nodes[x].kind != nodes[y].kind: return false
    k = nodes[x].kind
    if k == .int_lit: return nodes[x].ival == nodes[y].ival
    if k == .ident:
        if nodes[x].aux != i32(int(SK.local)) or nodes[y].aux != i32(int(SK.local)) or nodes[x].sym != nodes[y].sym: return false
        return int(locals[int(nodes[x].sym)].flags) & LF_ASSIGNED == 0
    if k == .binary:
        op = nodes[x].op as Tok
        if nodes[y].op != nodes[x].op or (op != .plus and op != .minus and op != .star): return false
        return same_value(int(nodes[x].a), int(nodes[y].a)) and same_value(int(nodes[x].b), int(nodes[y].b))
    if k == .intrinsic:
        a = fixed_array_len(x)
        return a >= 0 and a == fixed_array_len(y)
    false

# A bounded ascending range with a nonnegative start never yields a negative
# index. For steps, require ordered literal starts; dynamic/descending steps
# keep their ordinary checks until there is a stronger proof.
nonnegative_range = (it: int) -> bool:
    if nodes[it].b == 0 or not is_nonneg(int(nodes[it].a)): return false
    if not has_flag(it, NF_STEP): return true
    a = int(nodes[it].a)
    b = int(nodes[it].c)
    nodes[a].kind == .int_lit and nodes[b].kind == .int_lit and nodes[b].ival > nodes[a].ival

# the array locals whose length bounds the range `it`
range_bounds_arrays = (it: int) -> int[]:
    out: int[]
    if not nonnegative_range(it) or has_flag(it, NF_INCLUSIVE): return out
    hi = word_integer_value(int(nodes[it].b))
    if hi == 0: return out
    a = fixed_array_len(hi)
    if a >= 0: out.push(a)
    if nodes[hi].kind == .ident and nodes[hi].aux == i32(int(SK.local)):
        n = int(nodes[hi].sym)
        if int(locals[n].flags) & LF_ASSIGNED == 0:
            if let b = len_of_local.get(n):
                if fixed_array_local(b): out.push(b)
    loop arr, e in array_len_expr:
        if int(locals[arr].owner) == cur_fn and fixed_array_local(arr) and same_value(hi, e): out.push(arr)
    out

# Dominating early returns can establish a minimum immutable array length.
# These lexical entries need no relational pass; only bounded indices query
# them, and block exit removes them. At most 16 active guards are retained.
lower_length_guards: (int, int)[]
lower_length_guard = (n0: int):
    if lower_length_guards.len() >= 16: return
    n = n0
    if nodes[n].kind == .exprstmt: n = int(nodes[n].a)
    if nodes[n].kind != .if_ or nodes[n].c != 0: return
    body = int(nodes[n].b)
    if nodes[body].kind != .block or nkids(body) != 1 or nodes[kid(body, 0)].kind != .return_: return
    condition = int(nodes[n].a)
    if nodes[condition].kind != .binary or nodes[condition].aux != 0: return
    if nodes[condition].op != i32(int(Tok.lt)): return
    array = fixed_array_len(int(nodes[condition].a))
    if array < 0: return
    flags = int(locals[array].flags)
    if flags & (LF_ASSIGNED | LF_MUTPARAM | LF_CAPTURE | LF_CAPTURED | LF_ADDR | LF_ALIAS | LF_BYREF | LF_SHARED) != 0: return
    known, length = integer_constant(int(nodes[condition].b))
    if known and length > 0: lower_length_guards.push((array, length))

# 0: needs a bounds check, 1: in bounds, 2: in bounds but keep the null check (other
# accesses to the array in the loop are checked and can build on it)
index_safety = (arr: int, idx0: int) -> int:
    idx = word_integer_value(idx0)
    if lower_length_guards.len() > 0 and nodes[arr].kind == .ident and nodes[arr].aux == i32(int(SK.local)):
        loop guard in lower_length_guards:
            if guard.0 == int(nodes[arr].sym):
                bound = positive_bound(idx, true)
                if bound >= 0 and bound < guard.1: return 1
    if safe_index.len() == 0: return 0
    if nodes[arr].kind != .ident or nodes[idx].kind != .ident: return 0
    if nodes[arr].aux != i32(int(SK.local)) or nodes[idx].aux != i32(int(SK.local)): return 0
    a = int(nodes[arr].sym)
    j = int(nodes[idx].sym)
    loop p in safe_index:
        if p.0 == a and p.1 == j:
            if p.2: return 2
            return 1
    0

# does the loop body index array local a with anything but the loop variables in `ok`
# (this loop's, and those of nested loops that are in bounds for a too)?
other_index_of = (n: int, a: int, ok: int[], seen: mut bool[]) -> bool:
    if n <= 0 or n >= seen.len() or seen[n]: return false
    seen[n] = true
    k = nodes[n].kind
    if k == .index:
        b = int(nodes[n].a)
        if nodes[b].kind == .ident and nodes[b].aux == i32(int(SK.local)) and int(nodes[b].sym) == a:
            ix = word_integer_value(int(nodes[n].b))
            if not (nodes[ix].kind == .ident and nodes[ix].aux == i32(int(SK.local)) and ok.contains(int(nodes[ix].sym))): return true
    if k == .for_:
        inner = ok
        it = int(nodes[n].a)
        if int(nodes[n].aux) == 0 and stable_loop_index(int(nodes[n].sym)) and range_bounds_arrays(it).contains(a): inner.push(int(nodes[n].sym))
        return other_index_of(it, a, ok, seen) or other_index_of(int(nodes[n].b), a, inner, seen)
    loop c in [int(nodes[n].a), int(nodes[n].b), int(nodes[n].c), int(nodes[n].d)]:
        if other_index_of(c, a, ok, seen): return true
    loop i in [0..nkids(n)):
        if other_index_of(kid(n, i), a, ok, seen): return true
    loop i in [0..nkids2(n)):
        if other_index_of(kid2(n, i), a, ok, seen): return true
    false

# Share range facts between unit and stepped loops. Array paths can still be
# hoisted when the counter is mutable, but only stable indices prove bounds.
range_facts_begin = (s: int, l: int) -> (int, int, bool):
    positive_epoch += 1
    safe_arrs: int[]
    nonneg = false
    bound = 0
    if nodes[s].aux == 0 and stable_loop_index(l):
        it = int(nodes[s].a)
        nonneg = nonnegative_range(it)
        if nonneg:
            safe_arrs = range_bounds_arrays(it)
            if not has_flag(it, NF_INCLUSIVE):
                hi = word_integer_value(int(nodes[it].b))
                if nodes[hi].kind == .intrinsic and (nodes[hi].aux as IN) == .len and nkids(hi) == 1: bound = kid(hi, 0)
    if nonneg:
        nonneg_locals.push(l)
        hi = int(nodes[int(nodes[s].a)].b)
        limit = -1
        if nodes[hi].kind == .int_lit and not has_flag(hi, NF_U64) and nodes[hi].ival > 0:
            limit = nodes[hi].ival
            if not has_flag(int(nodes[s].a), NF_INCLUSIVE): limit -= 1
        if limit < 0 and bound != 0 and tkind(ntype(bound)) == .array:
            limit = 9223372036854775807 / max(1, tsize(telem(ntype(bound)))) - 1
        nonneg_limits.push(limit)
    nfp = fp_begin(s, l, bound, 0)
    loop sa in safe_arrs:
        seen = fill(false, nodes.len())
        ok = [l]
        loop p in safe_index:
            if p.0 == sa: ok.push(p.1)
        safe_index.push((sa, l, other_index_of(int(nodes[s].b), sa, ok, seen)))
    (nfp, safe_arrs.len(), nonneg)

range_facts_end = (facts: (int, int, bool)):
    positive_epoch += 1
    loop _ in [0..facts.1): safe_index.pop()
    fp_end(facts.0)
    if facts.2:
        nonneg_locals.pop()
        nonneg_limits.pop()

# An owning boundary may execute a non-value-preserving lifecycle hook.
# Captured scalar results remain values; only the transferred aggregate loses
# its identity, and hook effects invalidate facts about exposed storage.
fact_owner_value = (n: int, value: int, s: mut FactState) -> int:
    if n == 0 or not ownership_fact_type(ntype(n)): return value
    k = nodes[n].kind
    if k != .ident and k != .field: return value
    fact_forget(s, n, .call, true)
    fact_new(s, fact_domain(ntype(n), .call, n), FactTerm(type = ntype(n)))

# Branches often change only intervals and guard rows. Their storage identities
# need no phi pairs or projection matching, only the common relation facts.
fact_join_shared_rows = (s: mut FactState, a: FactState, b: FactState):
    common = 0
    loop common < min(a.differences.len(), b.differences.len()):
        row = a.differences[common]
        if row != b.differences[common] or fact_slot(s, row.a) < 0 or fact_slot(s, row.b) < 0: break
        common += 1
    if common == a.differences.len():
        s.differences = a.differences
        s.index[0].difference_index = a.index[0].difference_index
        s.index[0].difference_value = a.index[0].difference_value
        s.index[0].difference_record = a.index[0].difference_record
        s.index[0].difference_next = a.index[0].difference_next
    else:
        loop i in [0..common): fact_add_difference(s, a.differences[i])
    loop i in [common..a.differences.len()):
        row = a.differences[i]
        if fact_slot(s, row.a) >= 0 and fact_slot(s, row.b) >= 0 and fact_distance(b, row.a, row.b, row.limit): fact_difference(s, row.a, row.b, row.limit, row.at)
    loop i in [common..b.differences.len()):
        row = b.differences[i]
        if fact_slot(s, row.a) >= 0 and fact_slot(s, row.b) >= 0 and fact_distance(a, row.a, row.b, row.limit): fact_difference(s, row.a, row.b, row.limit, row.at)

fact_literal_nonzero = (n0: int) -> bool:
    n = n0
    loop nodes[n].kind == .conv and nodes[n].aux == i32(int(CV.none_)): n = int(nodes[n].a)
    nodes[n].kind == .int_lit and nodes[n].ival != 0

# Runtime-enabled bodies need no proof until a static caller asks whether
# they can panic. Each deferred body is visited at most once on that demand.
fact_complete_deferred = (f: int):
    if not fact_deferred.has(f): return
    fact_deferred.remove(f)
    previous_proving = fact_deferred_proving
    fact_deferred_proving = true
    loop key in [0..16): fact_slice_cache.remove((f << 4) | key)
    pending = fact_deferred_checks.get(f) ?? []
    fact_deferred_checks.remove(f)
    if pending.len() > 0:
        # These were evidence-free fallback answers, not visits of the body.
        # The full transfer below decides every path, then retries any omitted
        # boundary. Never retain a provisional panic after its check is proved.
        if effect_panic_pending.has(f):
            effect_panic_nodes.remove(f)
            effect_panic_texts.remove(f)
            effect_panic_pending.remove(f)
        loop n in pending:
            if exact_has_store(n): exact_marks[n] &= 231
            fact_validated.remove(n)
    icb = ic_fn(IC_FACTS, f)
    fact_owner = f
    fact_terms = [FactTerm()]
    state = FactState()
    # Width conversions request refinements without enabling declared contracts.
    # A summary/deferred walk still needs its own entry, never its caller's slots.
    refine_entry = []
    if refine_active or refine_owners.has(f): refine_fact_entry(f, state)
    if fact_fork_entries.len() > 0 or fact_parallel_bounds.len() > 0: fact_fork_seed(f, state)
    fact_slice_prepare(f)
    fact_capture(int(fns[f].body), state)
    # Evidence-free retries have no function entry to refresh, but retain
    # their owner for any panic obligation they cannot prove.
    fact_owner = 0
    fact_retry_owner = f
    loop n in pending:
        fact_terms = [FactTerm()]
        state = FactState()
        if exact_has_store(n):
            if not exact_decided(n): exact_fact_store(n, 0, state)
        else if not fact_validated.has(n):
            refine_entry = []
            fact_capture(n, state)
    fact_retry_owner = 0
    fact_terms = []
    fact_slice = FactSlice()
    directives_after_facts()
    fact_deferred_proving = previous_proving
    ic_restore(icb)

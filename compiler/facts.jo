        if ownership_fact_cleanup and s.live and not unscoped: fact_drop_forget(s, n, fact_drop_block(n))
        if s.live and s.bindings.len() > first and not unscoped: fact_scope_exit(s, n, first)
        if s.live and s.ids.len() > 64: fact_collect(s, boundary, r)
        return r
    if k == .return_:
        r = fact_capture(int(nodes[n].a), s)
        if ownership_decls.len() != 0: r = fact_owner_value(int(nodes[n].a), r, s)
        # (the exit drops every owner still live, before the caller reads)
        if ownership_fact_cleanup and s.live: fact_drop_forget(s, n, fact_drop_exit(fact_owner))
        if proof_active and proof_decls.has(int(fns[fact_owner].decl)): proof_exit(fact_owner, n, s)
        if result_active: result_exit(fact_owner, r, n, s)
        if fact_summary_owner != 0 and fact_summary_owner == fact_owner: fact_summary_record(s, r)

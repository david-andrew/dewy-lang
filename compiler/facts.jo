                # owners: forget what their hooks may write (facts_forgets).
                if ownership_fact_cleanup and s.live: fact_drop_forget(s, c, fact_drop_statement(c))
                if long_block and s.live and s.ids.len() >= collect_at:
                    fact_collect(s, boundary, r)

# One tombstone per invalidated route: the event that last replaced the
# place and the value it replaced. Witnesses only; never evidence.
struct FactBinding:
    place: PlaceIdentity
    value: int
    event: int = 0
    prior: int = 0

struct FactProjection:
    base: int
    selector: int
    element: bool
    value: int

# Sparse mathematical difference constraints: a - b <= limit. Endpoints are
# immutable evaluations, so writes retire routes without rewriting old facts.
struct FactDifference:
    a: int
    b: int
    limit: int
    at: int = 0

struct FactIndexes:
    slots: int[]
    roots: int[]
    projection_index: int[]
    projection_head: int[]
    projection_tail: int[]
    projection_value: int[]
    projection_next: int[]
    difference_index: int[]
    # (one record per value a row touches: incident rows, then the head and
    # tail of its row chains by b (direction 0) and by a (direction 1))
    difference_value: int[]
    difference_record: int[]
    difference_next: int[]

fact_empty_index = [FactIndexes()]

struct FactState:
    index: FactIndexes[] = fact_empty_index
    conditional: ResultEvidence[]
    differences: FactDifference[]
    projections: FactProjection[]
    bindings: FactBinding[]
    ids: int[]
    bounds: FactBound[]
    live: bool = true
    full: bool = false

struct FactLoop:
    back: FactState = FactState(live = false)
    exits: FactState = FactState(live = false)

struct FactLoan:
    place: PlaceIdentity
    capacity: int
struct FactSliceEdges:
    heads: int[]
    nodes: int[]
    next: int[]

# A slice's nodes, node -> FACT_MEMBER | FACT_VALUE | FACT_ACTIVE: a dense
# array from node `base` when its nodes lie close together (a body's usually
# do), else an open-address index (base -1).
const FACT_MEMBER = 1
const FACT_VALUE = 2
const FACT_ACTIVE = 4
const FACT_CONTRACT = 8
struct FactSlice:
    flags: int[]
    # (a probe also reads floor calls the facts pass's slice leaves out)
    probe_only: bool = false
    base: int = -1
    # (whether the function assigns a local of fact_carried_type, which only
    # a loop iterating its header bounds: fact_iterates)
    carried: bool = true
    # (whether it pushes into a local array of rows: fact_pushed_rows)
    rows: bool = true
    plan: int = 0
    callees: int[]
    versions: int[]
    exact_demands: int[]
    index_demands: int[]
    # (index obligations `a[x]` of a local x and a field path a: fact_loop_bounds)
    loop_indexes: int[]
    float_context: bool = false

fact_slice_flags = (n: int) -> int:
    if fact_slice.base < 0: return max(0, fact_index_get(fact_slice.flags, n))
    i = n - fact_slice.base
    if i < 0 or i >= fact_slice.flags.len(): return 0
    fact_slice.flags[i]

fact_slice = FactSlice()
fact_slice_cache: {int: FactSlice} = {}
fact_plan_serial = 0

# A plan reads the settled call row's writes, escapes and opacity, in order.
# Generation/tick checks avoid revisiting unchanged rows; a graph rebuild may
# keep the same dependency version, but widening or settlement invalidates it.
struct FactPlanDependency:
    stamp: int
    tick: int
    version: int
    atoms: EffectAtom[]
fact_plan_dependencies: {int: FactPlanDependency} = {}
fact_plan_version = (f: int) -> int:
    if f <= 0 or f >= effect_summaries.len() or not effect_summaries[f].done: return 0
    stamp = effect_summaries[f].stamp
    tick = effect_summaries[f].changed_at
    old = fact_plan_dependencies.get(f) ?? FactPlanDependency(-1, -1, 0, [])
    if old.stamp == stamp and old.tick == tick: return old.version
    atoms: EffectAtom[]
    loop event in effect_summaries[f].events:
        if event.atom.kind == .write or event.atom.kind == .opaque or event.atom.kind == .escape: atoms.push(event.atom)
    version = old.version
    if version == 0 or old.atoms != atoms:
        fact_plan_serial += 1
        version = fact_plan_serial
    fact_plan_dependencies[f] = FactPlanDependency(stamp, tick, version, atoms)
    version

# Body/demand rewrites discard every mode and any completed probe together.
fact_plan_forget = (f: int):
    loop key in [0..16): fact_slice_cache.remove((f << 4) | key)
    fact_probe_runs.remove(f)

fact_loans: FactLoan[]
# The arguments a call has evaluated while its later ones run (a record
# literal's earlier fields): compaction keeps them. O(1) per argument.
fact_pending: int[]

fact_returns_cache: {int: bool} = {}
fact_return_escapes_cache: {int: bool} = {}

fact_loops: FactLoop[]
# Open element-hull frames of enclosing range and array loops (fact_push_open).
struct FactPushes:
    at: int
    locals: int[]
    lengths: bool[]
    bounds: FactBound[]
    seen: bool[]
    sites: int[][]
    recorded: {int: bool}
    rows: int = 0
    matching: bool = false
    # (the comprehension's accumulator, which alone may match rows)
    acc: int = 0
    # (per local: the one length every pushed row has, a value loop entry
    # held or a length of one, 0 before a push, -1 none: fact_push_same)
    same: int[]
    same_base: int[]
    same_offset: int[]
    entry: FactState = FactState(live = false)
    # (per local: a value every pushed integer is below, one evaluated before
    # the loop, 0 before a push, -1 none: fact_push_below)
    below: int[]
    # (per candidate: the tuple component it describes, -1 the whole element)
    parts: int[]
    mark: int = 0

fact_push_frames: FactPushes[]
fact_comprehensions: {int: int} = {}   # a comprehension's loop -> its accumulator
fact_hull_owner = -1                    # the last function given an element hull

fact_speculating = 0
fact_pending_defers = 0
fact_loop_steps = 0
fact_loop_exhausted = false

fact_divisors: {int: int} = {}
fact_requests: FactRequest[]
fact_fixed_requests: FactRequest[]
fact_terms: FactTerm[]
# Evaluated actuals of demanded record/tuple-returning calls. A field projection
# requests its own cached return summary; no whole-program constructor census.
fact_constructor_actuals: {int: int[]} = {}
fact_constructor_types: {int: bool} = {}
fact_constructor_bodies: {int: bool} = {}
fact_constructor_calls: {int: bool} = {}

# A fork's closure (the function argument of `parallel_range`/`parallel_map`,
# which call it before they return) starts from what its creator knew of its
# snapshot captures and of the lengths of the arrays it borrows by partition
# (which nobody resizes during the fork): intervals and rows among them.
struct FactForkEntry:
    inner: int[]
    length: bool[]
    maps: bool[]
    bounds: FactBound[]
    rows: FactDifference[]
    # (the creator's values of the captures, for fact_key_record)
    values: int[]
# A key callback's parameter (fact_key_record): the hull of the receiver's
# elements, and rows to its fork entry's captures (a: -1 for the parameter).
struct FactKeyParam:
    bound: FactBound
    rows: FactDifference[]
    maps: int[]             # capture locals sharing the receiver's key snapshot
fact_key_params: {int: FactKeyParam} = {}
fact_fork_nodes: {int: bool} = {}
fact_decided: {int: bool} = {}
fact_policy_default = false    # RequireStatic is the no-traps default, not a harness's
fact_fork_entries: {int: FactForkEntry} = {}
fact_parallel_bounds: {int: FactBound} = {}
fact_validated: {int: bool} = {}
fact_owner = 0
fact_query = false
fact_policy = FactPolicy.RuntimeAllowed
const FACT_CAP = 256
const FACT_STEPS = 4096
fact_step_limit = FACT_STEPS
# Projection selector of an integer's nonnegative part, max(0, n): the length
# `fill(x n)` gets, shared by every fill of the same count.
const FACT_CLAMPED = -7
const FACT_ELEMENT_LENGTH = -16
# Projection selector of an integer array's element hull: the interval every
# element lies in. Built by recorded pushes; an element write drops it.
const FACT_ELEMENT_VALUE = -17
# Projection selector of a dictionary value's key positions (fact_map_entry).
const FACT_MAP_POSITIONS = -18
# Every element of a fill is a copy of this immutable value. Element writes
# drop the uniform projection; snapshots retain theirs.
const FACT_ELEMENT_COPY = -19
const FACT_POOL_POSITIONS = -20
const FACT_MAP_DENSE = -21
# Matching row lengths, indexed by the same position in an immutable source.
const FACT_ROW_SOURCE = -22
# A key collection belongs to one immutable dictionary snapshot; each selected
# key retains that identity. Neither tag promises membership in a later value.
const FACT_KEYS_SOURCE = -23
const FACT_KEY_SOURCE = -24
# An immutable inventory whose elements were permuted, never position identities.
const FACT_ELEMENT_SOURCE = -25
# The key positions of the dictionaries a comprehension builds from this
# source's elements, in order (fact_map_of): the same for each such dictionary.
const FACT_KEYS_POSITIONS = -26
# Every element of this array of rows has this one length.
const FACT_ELEMENT_SAME_LENGTH = -27
# Every element of this integer array is below this value (`[loop i in
# [0..n) i]`'s are below n). Built by recorded pushes; an element write drops it.
const FACT_ELEMENT_BELOW = -28
# A dictionary value made by adding keys (stores or `insert_if_absent`) to a
# comprehension's dictionary (fact_grown_roots): it holds every key that
# dictionary held.
const FACT_MAP_GROWN = -29
# The keys a comprehension's dictionary takes from one field of this source's
# elements (fact_map_of): its value's projection on each field name is that
# dictionary, so a loop element's field is a key of it (fact_loop_elements).
const FACT_FIELD_KEYS = -30
# A value holding a self-length contract: every element <= length + this constant
# (ref_self_assume). A place's new value gets it again from the place's type.
const FACT_SELF_BOUND = -31
# A value holding a sibling bound on its elements: every element <= this value, a sibling's
# length + c read with the record (ref_sib_assume).
const FACT_SIB_BOUND = -33
# Injective text identities, materialized only in a demanded narrowing proof.
const FACT_TEXT_ID = -32
# Component c (< 8) of every element of this array of tuples, an integer: its
# hull (FACT_COMPONENT_FACTS - 2c) and a value it is below (one less), as
# FACT_ELEMENT_VALUE and FACT_ELEMENT_BELOW for an integer array (`[loop i in
# [0..n) [i i]]`'s are below n). c = FACT_ROW_ELEMENTS: every element of every
# row of an array of integer arrays. Built by recorded pushes; an element write drops them.
const FACT_COMPONENT_FACTS = -64
const FACT_ROW_ELEMENTS = 8

# What held of every element of base holds of what a shrink left of them: its copy, hull and
# bound, and a literal's inventory as a hull, positions being gone. O(inventory), only with a
# self-length type about, whose shrink obligations are its one consumer.
fact_shrunk_elements = (s: mut FactState, base: int, fresh: int):
    if base == 0 or s.projections.len() + 3 >= FACT_CAP: return
    loop selector in [FACT_ELEMENT_COPY, FACT_ELEMENT_BELOW]:
        i = fact_projection_find(s, base, selector, false)
        if i >= 0: fact_add_projection(s, FactProjection(fresh, selector, false, s.projections[i].value))
    hull = fact_projection_find(s, base, FACT_ELEMENT_VALUE, false)
    if hull >= 0:
        fact_add_projection(s, FactProjection(fresh, FACT_ELEMENT_VALUE, false, s.projections[hull].value))
        return
    parts = fact_inventory(s, base)
    if parts.len() == 0: return
    whole = fact_bound(s, parts[0])
    loop part in parts:
        one = fact_bound(s, part)
        whole = FactBound(min(whole.lo, one.lo), max(whole.hi, one.hi))
    fact_add_projection(s, FactProjection(fresh, FACT_ELEMENT_VALUE, false, fact_new(s, whole)))

fact_grown_roots: {int: bool} = {}
fact_name_vals = 0

# The array-length ceiling is the target's `addr` range (2^48 native, 2^32
# WebAssembly: an array's positions are `addr` values), an axiom
# `$no_assumed_bounds` turns off in its scope, decided by where the analyzed code is: a function whose body
# is in such a scope or holds one uses only the signed storage limit; every other
# function keeps the ceiling for its own proofs, whatever its callers or the other
# modules set. Its summary, asked for by a strict function, is computed and cached
# apart without the ceiling (fact_summary), so none reaches the strict scope through
# a call; the exact domain decides by file (dir_assumed_bounds_file). Facts with no
# owning function (retried requests without one) take the strict limit when any
# scope sets it. O(1) per query, O(body) once per function in a file holding a
# nested strict scope.
fact_length_max = () -> int:
    if dir_assumed_bounds_any and fact_length_strict(): return FACT_MAX
    # (ref_addr_max: the same range `addr` is declared with)
    if ptr_size == 4: return 4294967295
    281474976710655

# A heap's entry count after a push (delta 1) or a pop (-1) of the old count
# `length`: exactly one more or one fewer, as a retained row pair and an exact
# interval, as an array's insert keeps its length. O(1).
fact_heap_length = (s: mut FactState, length: int, delta: int, n: int) -> int:
    old = fact_bound(s, length)
    size = if delta > 0: fact_new(s, FactBound(min(fact_length_max(), old.lo + 1), fact_length_max())) else: fact_new(s, FactBound(0, fact_length_max()))
    if delta > 0 and old.hi < fact_length_max(): fact_set_bound(s, size, FactBound(old.lo + 1, old.hi + 1))
    if delta < 0 and old.lo >= 0: fact_set_bound(s, size, FactBound(max(0, old.lo - 1), max(0, old.hi - 1)))
    if old.lo != old.hi:
        fact_difference(s, size, length, delta, n)
        fact_difference(s, length, size, -delta, n)
    size

fact_length_owner = -1
# (a callee's summary asked for by such a function: computed, and cached apart,
# without the ceiling, so none reaches the strict scope through it)
fact_length_forced = false
fact_length_owner_strict = false
fact_length_gen = -1
fact_length_strict_fns: {int: bool} = {}

fact_length_strict = () -> bool:
    if fact_length_forced: return true
    f = if fact_owner != 0: fact_owner else: fact_retry_owner
    if f <= 0 or f >= fns.len(): return true
    if fact_length_gen != dir_scopes_gen:
        fact_length_gen = dir_scopes_gen
        fact_length_strict_fns = {}
        fact_length_owner = -1
    if f == fact_length_owner: return fact_length_owner_strict
    strict = false
    if let known = fact_length_strict_fns.get(f): strict = known
    else:
        strict = fact_length_strict_body(int(fns[f].body))
        fact_length_strict_fns[f] = strict
    fact_length_owner = f
    fact_length_owner_strict = strict
    strict

# (a body in a `$no_assumed_bounds` scope, or holding one: a scope of the
# setting that starts inside the body's positions)
fact_length_strict_body = (body: int) -> bool:
    if body <= 0: return true
    p = nodes[body].pos
    if p <= 0: return true
    if dir_value(dir_name_assumed_bounds, p) == 1: return true
    file = p >> 40
    later = false
    loop s in dir_scopes:
        if s.setting == dir_name_assumed_bounds and s.value == 1 and s.start > p and s.start >> 40 == file: later = true
    if not later: return false
    end = fact_max_pos(body)
    loop s in dir_scopes:
        if s.setting == dir_name_assumed_bounds and s.value == 1 and s.start > p and s.start <= end: return true
    false

# (the last position in n's tree; a node the walk does not know, or a lambda,
# gives its file's end, so a nested scope is never missed)
fact_max_pos = (n: int) -> int:
    if n <= 0: return 0
    out = nodes[n].pos
    mask = isolation_children(nodes[n].kind)
    if mask < 0 or nodes[n].kind == .lambda: return (out >> 40 << 40) | 0xFFFFFFFFFF
    if mask & 1 != 0: out = max(out, fact_max_pos(int(nodes[n].a)))
    if mask & 2 != 0: out = max(out, fact_max_pos(int(nodes[n].b)))
    if mask & 4 != 0: out = max(out, fact_max_pos(int(nodes[n].c)))
    if mask & 16 != 0:
        loop i in [0..nkids(n)): out = max(out, fact_max_pos(kid(n, i)))
    out

# A record key type that equals itself and hashes as it did (so a key a snapshot of
# d.keys holds is found again in d): no hash of its own, fields that are such keys
# (whole numbers, booleans, text, such records; never floats, NaN being unequal to
# itself), and no equality of its own or one that compares each field to the same field
# of the other (`__eq__=(a:Date b:Date):>bool=>a._days =? b._days`). Read from the value
# helpers checking chose (check_value_members); a type checking never asked about is
# not one. O(fields + the equality's body), memoized per type.
fact_reflexive_keys: {int: bool} = {}
fact_reflexive_key = (t0: int, depth: int = 0) -> bool:
    t = representation_type(prune(t0))
    if is_int(t) and fact_scalar(t) or t == T_STR or t == T_BOOL: return true
    if depth > 4 or tkind(t) != .struct_ or is_map_type(t) or is_dewy_set_type(t): return false
    if let known = fact_reflexive_keys.get(t): return known
    fact_reflexive_keys[t] = false
    if not value_hash_fns.has(t) or not value_equal_fns.has(t) or value_hash_fns[t] != 0: return false
    si = int(types[t].st)
    loop i in [0..int(structs[si].nfields)):
        if not fact_reflexive_key(int(fields[int(structs[si].fields) + i].type), depth + 1): return false
    eq = value_equal_fns[t]
    if eq != 0 and (fns[eq].params.len() != 2 or not fact_reflexive_eq(int(fns[eq].body), fns[eq].params[0], fns[eq].params[1], depth)): return false
    fact_reflexive_keys[t] = true
    true

# `a.f =? b.f` joined by `and`, each field a reflexive key, a and b the equality's two
# parameters in order (fact_reflexive_key). O(body).
fact_reflexive_eq = (e0: int, a0: int, b0: int, depth: int) -> bool:
    e = e0
    a = a0
    b = b0
    # (a body block first binds its own `a` and `b` from the parameters: compare those)
    if e > 0 and nodes[e].kind == .block and nkids(e) >= 1:
        loop i in [0..nkids(e) - 1):
            c = kid(e, i)
            init = int(nodes[c].b)
            if nodes[c].kind != .vardecl or init <= 0 or nodes[init].kind != .ident or int(locals[int(nodes[c].sym)].flags) & LF_ASSIGNED != 0: return false
            if int(nodes[init].sym) == a: a = int(nodes[c].sym)
            else if int(nodes[init].sym) == b: b = int(nodes[c].sym)
            else: return false
        e = kid(e, nkids(e) - 1)
    loop e > 0 and (nodes[e].kind == .return_ or nodes[e].kind == .exprstmt): e = int(nodes[e].a)
    if e <= 0: return false
    if nodes[e].kind == .and_: return fact_reflexive_eq(int(nodes[e].a), a, b, depth) and fact_reflexive_eq(int(nodes[e].b), a, b, depth)
    x = 0; y = 0
    # (any representation's `=?`, text's and an exact integer's too: the fields' types decide)
    if nodes[e].kind == .binary and nodes[e].op == i32(int(Tok.eq)):
        x = int(nodes[e].a); y = int(nodes[e].b)
    else if nodes[e].kind == .call and nodes[e].aux == 0 and nkids(e) == 2: x = kid(e, 0); y = kid(e, 1)
    else: return false
    if nodes[x].kind != .field or nodes[y].kind != .field or nodes[x].name != nodes[y].name or nodes[x].aux < 0: return false
    p = int(nodes[x].a); q = int(nodes[y].a)
    if nodes[p].kind != .ident or nodes[q].kind != .ident or int(nodes[p].sym) != a or int(nodes[q].sym) != b: return false
    if not fact_reflexive_key(ntype(x), depth + 1): return false
    # (a record field compared through its own equality, which must be that one)
    # (text compared by the library's own text equality)
    if nodes[e].kind == .call:
        ft = representation_type(prune(ntype(x)))
        f = int(nodes[e].sym)
        if ft == T_STR: return f > 0 and fns[f].decl != 0 and pos_in_lib(nodes[int(fns[f].decl)].pos)
        return tkind(ft) == .struct_ and value_equal_fns.get(ft) == f
    true

fact_scalar = (t0: int) -> bool:
    t = fact_type(t0)
    types[t].kind == .bool_ or types[t].kind == .int_

fact_comparison = (op: Tok) -> bool:
    op == .eq or op == .ne or op == .lt or op == .le or op == .gt or op == .ge

# Policies share the same numeric domain and unsigned endpoint encoding.
fact_type = (t0: int) -> int:
    t = exact_representation(t0)
    if is_int(t) and types[t].bits == 64 and not types[t].sign: return T_U64
    t

fact_domain = (t0: int, reason: FactReason = .missing, at: int = 0) -> FactBound:
    t = fact_type(t0)
    r = FactBound(reason = reason, witness = at)
    if types[t].kind == .bool_: r.lo = 0; r.hi = 1
    else if types[t].kind == .int_ and types[t].bits < 64:
        bits = int(types[t].bits)
        r.lo = if types[t].sign: -(1 << (bits - 1)) else: 0
        r.hi = if types[t].sign: (1 << (bits - 1)) - 1 else: (1 << bits) - 1
    r

fact_new = (s: mut FactState, b: FactBound, term: FactTerm = FactTerm()) -> int:
    if s.ids.len() >= FACT_CAP and not s.full: fact_compact(s)
    if s.ids.len() >= FACT_CAP: return 0
    v = fact_terms.len()
    if v >= 0x80000000: return 0
    fact_terms.push(term)
    fact_add_value(s, v, b)
    v

fact_root_key = (p: PlaceIdentity) -> int: (p.declaration << 3) | int(p.root)
fact_pair_key = (a: int, b: int) -> int: (a << 32) | b
fact_projection_key = (base: int, selector: int, element: bool) -> int:
    (base << 33) | (int(element) << 32) | (selector & 0xffffffff)

# Small projection sets keep only their ordered records. Build the indexes
# on the first insertion reaching FACT_PROJECTION_SCAN, then maintain them.
# O(P) queries while P < 32; expected O(1) indexed queries above that, with
# O(P) promotion once per growing state. No new facts or budget are introduced.
const FACT_PROJECTION_SCAN = 32

const FACT_RECORD = 5

# A state's rows are indexed only once there are FACT_ROW_SCAN of them.
# Fewer rows (nearly every state) are scanned in order instead: the same rows
# in the same order as the index's chains give, with no index to build when a
# join or a loop header assembles a state, or to copy when a branch changes
# one. A scan is O(rows), as the distance budget already charges a source.
const FACT_ROW_SCAN = 32

fact_reindex = (s: mut FactState):
    hashed = s.index[0].slots.len() != 0
    s.index[0].slots = []
    if hashed:
        loop i in [0..s.ids.len()): fact_index_put(s.index[0].slots, s.ids[i], i)
    projections = s.projections
    s.projections = []; s.index[0].projection_index = []; s.index[0].projection_head = []; s.index[0].projection_tail = []; s.index[0].projection_next = []; s.index[0].projection_value = []
    loop p in projections: fact_add_projection(s, p)
    differences = s.differences
    s.differences = []; s.index[0].difference_index = []; s.index[0].difference_value = []; s.index[0].difference_record = []; s.index[0].difference_next = []
    loop row in differences: fact_add_difference(s, row)

# A scope's end drops the values it made that nothing live reaches: every
# value made before the scope began stays (an enclosing expression may hold
# it), as do the scope's result and whatever bindings, evidence and kept
# values reach through projections (and terms, two levels). Only a sizeable
# saving rebuilds the state. O(V + P + D), stamps instead of a hash set.
fact_stamp: int[]
fact_stamp_gen = 0

fact_constant = (s: mut FactState, x: int, at: int = 0) -> int:
    fact_new(s, FactBound(x, x, x != 0), FactTerm(origin = at))

fact_place = (e: int) -> PlaceIdentity: place_scalar_root(e)

fact_bind = (s: mut FactState, p: PlaceIdentity, v: int):
    if p.declaration == 0: return
    i = fact_binding(s, p)
    if i >= 0: s.bindings[i].value = v
    else if s.bindings.len() < FACT_CAP:
        fact_index_put(s.index[0].roots, fact_root_key(p), s.bindings.len())
        s.bindings.push(FactBinding(p, v))

# A replacement keeps the replaced value as the route's single tombstone.
fact_rebind = (s: mut FactState, p: PlaceIdentity, v: int, at: int, prior: int):
    fact_bind(s, p, v)
    i = fact_binding(s, p)
    if i >= 0 and at != 0:
        s.bindings[i].event = at
        s.bindings[i].prior = prior

# Aggregates have immutable evaluated identities too. A projection belongs to
# that value, never to a source spelling; a store rebuilds the enclosing value.
fact_project = (s: mut FactState, base: int, selector: int, element: bool, t: int) -> int:
    if base == 0: return fact_fresh(s, t)
    if not element:
        i = fact_projection_find(s, base, selector, false)
        if i >= 0: return s.projections[i].value
    else:
        i = fact_projection_first(s, base)
        loop i >= 0:
            p = s.projections[i]
            i = fact_projection_after(s, i)
            if p.element and (p.selector == selector or fact_compare(s, .eq, p.selector, selector) == 1): return p.value
        i = fact_projection_find(s, base, FACT_ELEMENT_COPY, false)
        if i >= 0: return s.projections[i].value
    if not element and selector == FACT_TEXT_ID:
        origin = fact_terms[base].origin
        if origin > 0 and nodes[origin].kind == .str_lit and nodes[origin].aux == 0 and nodes[origin].sval >= 0:
            return fact_constant(s, int(nodes[origin].sval))
    v = fact_new(s, fact_domain(t), FactTerm(type = t))
    if not element and selector == -1:
        fact_set_bound(s, v, FactBound(0, fact_length_max()))
    if element and fact_hull_owner == fact_owner:
        hull = fact_projection_find(s, base, FACT_ELEMENT_VALUE, false)
        if hull >= 0:
            b = fact_bound(s, v); h = fact_bound(s, s.projections[hull].value)
            fact_set_bound(s, v, FactBound(max(b.lo, h.lo), min(b.hi, h.hi), b.nz or h.nz))
        below = fact_projection_find(s, base, FACT_ELEMENT_BELOW, false)
        if below >= 0: fact_difference(s, v, s.projections[below].value, -1, 0, 16)
        if tkind(fact_type(t)) == .tuple: fact_component_bounds(s, base, v, fact_type(t))
        else if tkind(fact_type(t)) == .array: fact_row_bounds(s, base, v)
    if element and tkind(fact_type(t)) == .array:
        source = fact_projection_find(s, base, FACT_ROW_SOURCE, false)
        if source >= 0 and s.projections.len() + 2 < FACT_CAP:
            other = s.projections[source].value
            row = fact_project(s, other, selector, true, telem(fact_type(fact_terms[other].type)))
            length = fact_project(s, row, -1, false, T_INT)
            fact_add_projection(s, FactProjection(v, -1, false, length))
    # (every element has one length: fact_push_close)
    if element and (fact_type(t) == T_STR or tkind(fact_type(t)) == .array):
        same = fact_projection_find(s, base, FACT_ELEMENT_SAME_LENGTH, false)
        if same >= 0 and s.projections.len() < FACT_CAP and fact_projection_find(s, v, -1, false) < 0: fact_add_projection(s, FactProjection(v, -1, false, s.projections[same].value))
    # Element-length hulls describe each selected value separately: two
    # arbitrary elements have the same bounds, not necessarily equal lengths.
    if element and (fact_type(t) == T_STR or tkind(fact_type(t)) == .array):
        hull = fact_projection_find(s, base, FACT_ELEMENT_LENGTH, false)
        if hull >= 0 and s.projections.len() < FACT_CAP and fact_projection_find(s, v, -1, false) < 0:
            fact_add_projection(s, FactProjection(v, -1, false, fact_new(s, fact_bound(s, s.projections[hull].value), FactTerm(type = T_INT))))
    if not element and selector >= 0 and fact_constructor_actuals.len() > 0 and (tkind(fact_type(t)) == .array or tkind(fact_type(fact_terms[base].type)) == .tuple and fact_scalar(t) and is_int(t)) and fact_constructor_actuals.has(base):
        fact_constructor_field(s, base, selector, v)
    # (an element of a literal, by an index not known: what all of them share)
    if element:
        parts = fact_inventory(s, base)
        if parts.len() > 0: fact_inventory_bound(s, v, parts, t, 0)
    if s.projections.len() < FACT_CAP: fact_add_projection(s, FactProjection(base, selector, element, v))
    if refine_active:
        if element and ref_self_active:
            ref_self_element_row(s, base, v)
            ref_sib_element_row(s, base, v)
        # A field's contract may name its siblings: every stored record was
        # validated whole, so the field's value relates to theirs in base.
        args: int[]
        if not element and selector >= 0 and ref_has_fields(t):
            # (inside a run changing tied fields the record may not hold its contract yet)
            if fact_pair_transient: return v
            args = fact_field_args(s, base)
        ref_assume(t, v, args, s)
    v

# The prelude's single-element first/last are reads of this array snapshot.
# User overloads and slicing overloads have no such contract. O(1).
fact_name_first = 0
fact_name_last = 0

# The prelude's `xs.min_by(key)` and `xs.max_by(key)` return one of the
# receiver's elements (its body reads xs[i] and returns one), so the result
# is an element read at a position below the length: what holds of every
# element (a hull, a bound below a value, a literal's inventory) holds of
# it. Exact library identity; O(1).
fact_name_min_by = 0
fact_name_max_by = 0

# Reviewed copies: sorted returns one element per input element; graphemes
# uses the same cursor as Dewy's string length. Key provenance survives sorting.
# Demand-driven O(1) recognition, exact library identity, immutable entry value.
fact_name_sorted = 0
fact_name_sorted_by = 0
fact_name_graphemes = 0
fact_name_sorted_with = 0

# The bundled count visits the by-value array snapshot once. A callback or
# equality hook may change the caller's storage, but cannot change the count's
# input snapshot. Record its bounds AFTER ordinary call-effect invalidation.
fact_name_count = 0

# Reviewed entry-count contract: the bundled dictionary's `len` counts its
# keys array less the deleted entries still in it, and a set's is its
# dictionary's, so each is a length within the address-space ceiling, as an
# array's. A projection of the evaluated value: every insertion or removal
# passes the receiver mutably, which replaces that value. O(1).
fact_name_len = 0
fact_name_gpu_read = 0
fact_name_gpu_write = 0
fact_name_gpu_atomics: int[]
# (lib/game/gpubuffer.jo's file, once loaded, and how many files there were when it was looked for)
fact_gpu_file = -1
fact_gpu_files_seen = 0

# Reviewed nonempty requirements: an array's `min(xs)` and `max(xs)` (an N-D
# array's: of its flat storage, `m.data.length >? 0`), a set's
# `s.pop()` (any member) and a heap's `h.pop()`, `h.peek()` and
# `h.peek_priority()` need an element, so `xs.length >? 0` is the call's
# obligation, as an index's bound is (each library body states it as its one
# failure). A set's or heap's length is the entry-count projection above. O(1).
fact_name_peek = 0
fact_name_peek_priority = 0
fact_name_take = 0
fact_name_push = 0
fact_name_least = 0
fact_name_most = 0

# A program's `sum(xs)` of checked 64-bit integers (core/array.jo; an N-D
# array's sums its flat storage, std/nd.jo) fails only when the exact sum
# leaves the element type, so "the exact sum fits" is the caller's obligation,
# proven here over every running sum (stricter). In any order every prefix lies between the sum of the elements' negative
# lower bounds and the sum of their positive upper bounds: a literal's
# inventory term by term, else the element hull (a fill's value, a
# comprehension's pushes, the type's range) times the length's upper bound.
# Demand: these calls only; O(1), or O(elements <= 64) for an inventory.
fact_name_sum = 0

# The bundled array search's successful arm is a position in its evaluated
# input snapshot. Publish through the ordinary conditional-result mechanism:
# Missing supplies no index evidence, especially when the input is empty.
fact_search_predicate = 0
fact_text_search_predicate = 0
fact_text_from_predicate = 0

# The bundled text search (`text.find(sub)`, `text.find(sub start)`,
# `text.rfind(sub)`) succeeds with the grapheme count of a byte prefix of the
# text that ends where a match starts, so at most the text's own count: every
# segmentation rule decides a boundary from what precedes it and the one
# scalar after it, so a prefix's inner boundaries are the text's own. (A start
# past the text fails in the slice that finds its byte offset.) Reviewed
# library contract by binding identity: 0 <= position <= text.length, not an
# index (a match inside the last cluster counts the whole text).
fact_name_find = 0
fact_name_rfind = 0

# The bundled regex search constructs one capture string per group, including
# unmatched optional groups (empty strings). Attach the count to the successful
# Match payload of this evaluated result, not to a pattern spelling or a place.
# Only demanded calls use this reviewed contract: O(result members), then
# indexed projections. Constant patterns use the library's bounded parser once
# per interned pattern, cached for this compilation; no duplicated grammar or
# matching-table construction. Hooks may change returned aggregates on copy.
fact_name_regex = 0
fact_name_regex_find = 0
fact_regex_counts: {int: int} = {}

# Seed demanded immutable globals from effect-free value construction, using
# the ordinary transfer functions. Never execute an initializer or a user
# function here. Eligibility is cached per global; O(min(nodes, 128)) once,
# then the normal bounded literal/projection transfer at a demanded read.
fact_constant_globals: {int: bool} = {}

struct FactRoute:
    root: int = 0
    selectors: int[]
    elements: bool[]
    types: int[]
    sites: int[]    # each selector's index node (0 for a field)

# A call's receiver route (a dictionary's, a pool's or an array's place, as
# `d.vals[__map_entry_present(d k)]` for `d[k].pop(j)`) was evaluated once,
# as the call's argument: its index nodes' selector values are kept, tagged
# with the call whose arguments evaluated them, and fact_receiver_route
# rebuilds the route from them instead of evaluating the selectors again
# (`d[next()][k] = x` calls next once). O(1) per index node.
fact_route_call = 0
fact_route_reuse = 0
fact_route_selectors: {int: (int, int)} = {}

# The narrowing whose obligation the check around it answers: an array index
# (in bounds, it fits) or a refinement bounded on both sides within the width.
fact_covered = 0

# A completed checked access establishes its captured bounds on the normal
# edge. The obligation is answered FIRST; an unproven no-traps access never
# supplies its own proof. Only final walks use this transfer, not speculative
# loop candidates or return summaries. Value identities retire naturally on
# replacement/resizing. O(1) indexed rows/bounds under the fact-state budget.
fact_index_success = (n: int, s: mut FactState, index: int, length: int):
    if fact_speculating != 0 or fact_query or dir_policy(nodes[n].pos) == DIR_STATIC: return
    if proof_active and fact_owner > 0 and proof_decls.has(int(fns[fact_owner].decl)): return
    if index == 0 or length == 0 or not s.live: return
    fact_assume(s, fact_new(s, fact_domain(T_BOOL), FactTerm(.le, fact_constant(s, 0), index, n)), true)
    fact_assume(s, fact_new(s, fact_domain(T_BOOL), FactTerm(.lt, index, length, n)), true)

# Effect verification asks which accesses a body's own facts keep in bounds.
# A probe records answers instead of reporting obligations. Borrowed partition
# lowering can also use these answers: its checked ABI makes mutable array
# parameters disjoint and forbids resizing, copying, escaping and opaque calls.
fact_probe_on = false
fact_probe_disjoint = 0
fact_probe: {int: bool} = {}
fact_probe_diverged = false

# Under the static policy a probe runs the facts pass's own transfer, with
# index failures recorded instead of reported. A probe that proved everything,
# reported nothing and never diverged from that transfer is the facts pass's
# run of its body: facts_finalize reuses it rather than analysing it again.
# The run is the facts pass's only while its inputs are: its slice, and the
# effect footprints of the callees it consulted (rows can differ after the
# probes settle, where a row reached its region budget).
struct FactFootprint:
    kind: int
    writes: EffectAtom[]
struct FactProbeRun:
    proven: {int: bool}
    refine: bool
    plan: int
    slice: int[]
    slice_base: int
    callees: int[]
    footprints: FactFootprint[]
fact_probe_runs: {int: FactProbeRun} = {}
fact_probe_callees: int[]
fact_probe_footprints: FactFootprint[]

# A callee's return summary: the interval of an array result's length, or of
# a word result, over every return of an erased speculative run of its body
# from an unknown entry (with its parameter refinements). Speculation reports
# nothing and validates nothing; an exhausted run gives unknown. Direct
# recursion may assume mutable lengths unchanged, then verifies that invariant.
# An array result may also keep a parameter's entry length plus a small
# constant on every return (`same`: that parameter's ordinal, else -1).
struct FactSummary:
    length: FactBound
    value: FactBound
    seen: bool = false
    same: int = -1
    delta: int = 0
    upper: int = -1          # scalar result <= entry array length + upper_delta
    upper_delta: int = 0
    host: bool = false       # every scalar return has finite host endpoints
    post: int = -1           # scalar result < this mutable array's EXIT length
    lengths: int[]           # mutable array parameters: 0 unknown, 1 same, 2 grows
    upper_field: int = 0     # upper (post) names that record parameter's array field
    post_field: int = 0
    global_post: int = 0    # scalar result < this module array's EXIT length
    kept_fields: int[]      # (parameter, signed field) pairs: positive same length, negative non-shrinking

fact_summaries: {int: FactSummary} = {}
fact_summary_owner = 0
fact_summary_field = 0
fact_constructor_budget = -1
# Private induction hypothesis for a direct self-call only. Never published
# in fact_summaries until every returning path verifies it.
fact_summary_assumed: int[]
fact_summary_used = false
# The function of a request analyzed again outside its body's run.
fact_retry_owner = 0
fact_summary_acc = FactSummary()
fact_summary_entry: int[]    # each array parameter's entry length value (0: none)
# (record parameter, array field, entry length value): a result bounded by a
# record's array, `best(f)` a position in `f.moves`. At most 8, int results only.
fact_summary_fields: (int, int, int)[]
# N-D state is separate: ordinary scalar/length summaries do not carry or copy it.
# Only demanded mutable N-D parameters populate this cache (one mask per callee).
fact_shape_summaries: {int: int} = {}
fact_summary_shape_mask = 0
fact_summary_shapes: (int, int, int)[] # demanded N-D shape/data-length entry identities

# Whether a plain record type has an array field (a summary may bound a
# scalar result by its length). Cached per type; O(fields) once.
fact_record_array_types: {int: bool} = {}

# A raw pointer's reinterpretation, `p as ptr<U>` (or an array's or string's elements as
# one): it reads its operand and writes nothing; writes through it are a store's or a call's.
fact_pointer_cast = (n: int) -> bool:
    if nodes[n].kind != .cast or nodes[n].a == 0: return false
    to = tkind(representation_type(ntype(n)))
    from = tkind(representation_type(ntype(int(nodes[n].a))))
    to == .ptr and (from == .ptr or from == .array or from == .str_)

fact_exposed = (p: PlaceIdentity) -> bool:
    # Checked references record escape while names are resolved (O(1) per use).
    # Only its own initializer may treat a closed script binding as a local;
    # ordinary function summaries must never assume its initial value.
    if p.root == .global:
        g = p.declaration
        # A checked const has no mutable route, including through its elements.
        # Calls cannot replace any of its value projections. Its initializer
        # still binds its actual value through the ordinary store transfer.
        if g > 0 and readonly_global(g): return false
        if g <= 0 or fact_owner <= 0: return true
        return globals[g].fn_accessed or globals[g].fn_written or globals[g].exposed or fns[fact_owner].kind != FK_INIT or modules[int(globals[g].mod)].init_fn != i32(fact_owner)
    if p.root != .local: return true
    # (a Dewy dictionary's or pool's address is taken only to pass it as a
    # mutable argument, for that call: its summary names what it writes)
    # A lock place cannot escape its guard. Mutable actuals still invalidate
    # it at their calls; unrelated calls cannot reach it through the mutex.
    if place_locked.has(p.declaration): return false
    flags = int(locals[p.declaration].flags)
    if flags & LF_BYREF != 0 and (flags & LF_VALUEITER != 0 or map_loop_values.has(p.declaration)): flags &= ~LF_BYREF
    if flags & (LF_MUTPARAM | LF_SHARED | LF_CAPTURE | LF_BYREF | LF_EXPOSED) == 0 and flags & LF_ADDR != 0 and (is_map_type(int(locals[p.declaration].type)) or fact_pool_type(int(locals[p.declaration].type))) and fact_dewy_local(p.declaration): return false
    # (and so is any Dewy local's that nothing captures, aliases or exposes:
    # `@xs` lends it to that call alone, which fact_forget_mutable_args havocs)
    if flags & FACT_LENT == LF_ADDR and fact_dewy_local(p.declaration): return false
    # (also when closures capture it only by snapshot: a value capture owns its
    # copy and reaches no storage of the local; a place capture of an owner
    # also sets LF_ADDR, so owner types stay exposed, as check.jo capture_in)
    if flags & FACT_LENT == LF_ADDR | LF_CAPTURED and fact_dewy_local(p.declaration) and not (ownership_decls.len() != 0 and ownership_fact_type(int(locals[p.declaration].type))): return false
    # Only the closed, checked partition ABI supplies this guarantee. Ordinary
    # callers and speculative summaries retain conservative alias invalidation.
    if fact_probe_disjoint != 0 and fact_owner == fact_probe_disjoint and int(locals[p.declaration].owner) == fact_probe_disjoint and tkind(int(locals[p.declaration].type)) == .array and int(locals[p.declaration].flags) & LF_MUTPARAM != 0: return false
    flags & (LF_MUTPARAM | LF_SHARED | LF_CAPTURE | LF_ADDR | LF_BYREF | LF_EXPOSED) != 0

# A local that is no parameter and is only lent to calls (`@buf`, a Jo
# `mut` argument) holds its own storage (a copy is copy-on-write): a write to
# it changes no other place, though calls may still change it. O(1).
fact_own_local = (p: PlaceIdentity) -> bool:
    if p.root != .local or p.declaration <= 0: return false
    flags = int(locals[p.declaration].flags)
    flags & FACT_LENT == LF_ADDR and flags & LF_PARAM == 0 and tkind(fact_type(int(locals[p.declaration].type))) == .array

# Address-taking flags of a local: only LF_ADDR (passed by `@` to calls) lends
# it to a call without exposing it beyond the call.
const FACT_LENT = LF_ADDR | LF_MUTPARAM | LF_SHARED | LF_CAPTURE | LF_CAPTURED | LF_BYREF | LF_EXPOSED | LF_ALIAS | LF_ELEMALIAS | LF_SOAELEM | LF_PARTBORROW | LF_OWNERBORROW

# A dictionary or pool local passed mutably to a call (not exposed,
# fact_exposed) has a new value after it, whatever the callee's summary says
# or lacks.
fact_forget_mutable_maps = (n: int, s: mut FactState, lent: bool = false, at0: int = 0, reason: FactReason = .call):
    mask = checked_call_mutmask(n)
    if mask == 0: return
    at = if at0 == 0: n else: at0
    loop i in [0..min(nkids(n), 62)):
        if mask & (1 << i) == 0: continue
        e = kid(n, i)
        loop nodes[e].kind == .addr or nodes[e].kind == .conv: e = int(nodes[e].a)
        p = fact_written_root(e)
        if p.declaration <= 0 or (p.root != .local and p.root != .global): continue
        t = if p.root == .local: int(locals[p.declaration].type) else: int(globals[p.declaration].type)
        if is_map_type(t) or fact_pool_type(t):
            if lent: continue
        else if not lent or fact_exposed(p): continue
        if fact_routed_write(s, e, at, reason): continue
        j = fact_binding(s, p)
        if j < 0: continue
        s.bindings[j] = FactBinding(p, fact_new(s, fact_domain(t, reason, at), FactTerm(type = t)), at, if s.bindings[j].event == at: s.bindings[j].prior else: s.bindings[j].value)

# Exact bundled declarations, cached once per instantiated sink. No user
# spelling match or callback exemption; O(1) at each demanded call.
fact_text_sinks: {int: bool} = {}
# Lifecycle hook footprints (facts_forgets.dewy): per concrete type, and per
# node * 4 + site (0 statement, 1 block end, 2 loop region, 3 function exit).
fact_drop_types: {int: int[]} = {}
fact_drop_sites: {int: int[]} = {}
# Whether storage of one type can lie in another's (facts_forgets.dewy), per type pair.
fact_reach_cache: {int: bool} = {}

struct FactCallWrites:
    place: PlaceIdentity
    binding: int
    paths: int[][]

# A settled field write rebuilds only its demanded ancestor projections.
# The unknown leaf inherits its declared contract, never its previous value.
# Field-name lookup is cached per (type, field); O(fields) once, then O(1).
# Batched transfer is O(write-route lengths + tracked ancestor projections),
# within the existing state cap. Map/pool internals widen to their root.
fact_call_field_types: {(int, int): int} = {}

# (cap: incident rows per term; a constant offset's exact rows get twice
# the usual eight, so `b[p+1] … b[p+4]` after one guard all keep theirs)
fact_difference = (s: mut FactState, a: int, b: int, limit: int, at: int = 0, cap: int = 8):
    if a == 0 or b == 0 or a == b: return
    i = fact_row_find(s, a, b)
    if i >= 0:
        if limit < s.differences[i].limit: s.differences[i] = FactDifference(a, b, limit, at)
        return
    if s.differences.len() < 256 and max(0, fact_incident(s, a)) < cap and max(0, fact_incident(s, b)) < cap:
        fact_add_difference(s, FactDifference(a, b, limit, at))

# Bounded single-source relaxation, never an all-pairs closure. Exhaustion
# simply declines additional inference; every discovered path is still valid.
fact_distance = (s: FactState, a: int, b: int, limit: int) -> bool:
    if a == 0 or b == 0: return false
    if a == b: return limit >= 0
    direct = fact_row_find(s, a, b)
    if direct >= 0 and s.differences[direct].limit <= limit: return true
    # (no row leaves b: the relaxation below would find nothing)
    if fact_difference_head(s, b, 0) < 0: return false
    terms = [b]
    distances = [0]
    pending = [0]
    cursor = 0
    visits = 0
    loop cursor < pending.len() and visits < 256:
        index = pending[cursor]
        cursor += 1
        source = terms[index]
        distance = distances[index]
        # A path can end at an interval, not only the same value identity.
        # Guards narrow bounds after equality rows were recorded (for example,
        # a shape binder becoming nonempty). Query only these visited values;
        # no eager propagation or new rows. Open/wide endpoints prove nothing.
        x = fact_bound(s, a)
        y = fact_bound(s, source)
        if not x.wide and not y.wide and x.hi != FACT_MAX and y.lo != FACT_MIN and fact_add_fits(x.hi, -y.lo):
            gap = x.hi - y.lo
            if fact_add_fits(gap, distance) and gap + distance <= limit: return true
        ri = fact_difference_head(s, source, 0)
        loop ri >= 0:
            row = s.differences[ri]
            visits += 1
            ri = fact_difference_next(s, ri, 0)
            if visits > 256: return false
            if not fact_add_fits(distance, row.limit): continue
            value = distance + row.limit
            if row.a == a and value <= limit: return true
            # (at most 32 terms: a scan beats hashing)
            slot = -1
            loop t in [0..terms.len()):
                if terms[t] == row.a: slot = t; break
            if slot < 0:
                if terms.len() >= 32: continue
                slot = terms.len()
                terms.push(row.a)
                distances.push(value)
                pending.push(slot)
            else if value < distances[slot]:
                distances[slot] = value
                pending.push(slot)
    false

# The smallest d found with a - b <= d (FACT_MAX: none), by fact_distance's
# bounded relaxation.
fact_shortest = (s: FactState, a: int, b: int) -> int:
    if a == 0 or b == 0: return FACT_MAX
    if a == b: return 0
    best = FACT_MAX
    direct = fact_row_find(s, a, b)
    if direct >= 0: best = s.differences[direct].limit
    if fact_difference_head(s, b, 0) < 0: return best
    terms = [b]
    distances = [0]
    pending = [0]
    cursor = 0
    visits = 0
    loop cursor < pending.len() and visits < 256:
        index = pending[cursor]
        cursor += 1
        source = terms[index]
        distance = distances[index]
        ri = fact_difference_head(s, source, 0)
        loop ri >= 0:
            row = s.differences[ri]
            visits += 1
            ri = fact_difference_next(s, ri, 0)
            if visits > 256: return best
            if not fact_add_fits(distance, row.limit): continue
            value = distance + row.limit
            if row.a == a:
                best = min(best, value)
                continue
            slot = -1
            loop t in [0..terms.len()):
                if terms[t] == row.a: slot = t; break
            if slot < 0:
                if terms.len() >= 32: continue
                slot = terms.len()
                terms.push(row.a)
                distances.push(value)
                pending.push(slot)
            else if value < distances[slot]:
                distances[slot] = value
                pending.push(slot)
    best

# Rows for a sum of two symbolic operands, v = a + b, through terms already
# evaluated (a guard's `first+n <=? xs.length`, a range's `n-col`): with
# w = a + c, b - c <= d gives v - w <= d; with t = c - a, b - t <= d gives
# v - c <= d (each mirrored). Found before v exists, so a bounded sum is no
# possible wrap. O(terms) candidates, two bounded relaxations each.
fact_sum_rows = (s: FactState, a: int, b: int) -> FactDifference[]:
    rows: FactDifference[]
    loop i in [0..s.ids.len()):
        t = s.ids[i]
        term = fact_terms[t]
        if term.a == 0 or term.b == 0: continue
        loop side in [0..2):
            mine = if side == 0: a else: b
            other = if side == 0: b else: a
            if term.op == .plus and (term.a == mine or term.b == mine):
                c = if term.a == mine: term.b else: term.a
                up = fact_shortest(s, other, c)
                if up != FACT_MAX: rows.push(FactDifference(0, t, up))
                down = fact_shortest(s, c, other)
                if down != FACT_MAX: rows.push(FactDifference(t, 0, down))
            else if term.op == .minus and term.b == mine:
                up = fact_shortest(s, other, t)
                if up != FACT_MAX: rows.push(FactDifference(0, term.a, up))
                down = fact_shortest(s, t, other)
                if down != FACT_MAX: rows.push(FactDifference(term.a, 0, down))
            if rows.len() >= 8: return rows
    rows

# Compose two independently bounded operands only when a comparison needs
# them. No speculative rows consume the ordinary graph's incident budgets.
# O(active terms), with bounded indexed distance queries, no state changes.
fact_sum_compare = (s: FactState, a: int, b: int, limit: int) -> bool:
    if a == 0 or b == 0: return false
    sum = fact_terms[a]
    if sum.op != .plus or sum.a == 0 or sum.b == 0: return false
    loop side in [0..2):
        mine = if side == 0: sum.a else: sum.b
        other = if side == 0: sum.b else: sum.a
        difference = fact_terms[mine]
        if difference.op == .minus and difference.a != 0 and difference.b != 0:
            up = fact_shortest(s, other, difference.b)
            tail = if up == FACT_MAX: FACT_MAX else: fact_shortest(s, difference.a, b)
            if up != FACT_MAX and tail != FACT_MAX and fact_add_fits(up, tail) and up + tail <= limit: return true
    loop t in s.ids:
        term = fact_terms[t]
        if t == a or term.op != .plus or term.a == 0 or term.b == 0: continue
        tail = fact_shortest(s, t, b)
        if tail == FACT_MAX: continue
        loop side in [0..2):
            x = if side == 0: term.a else: term.b
            y = if side == 0: term.b else: term.a
            up = fact_shortest(s, sum.a, x)
            if up == FACT_MAX: continue
            down = fact_shortest(s, sum.b, y)
            if down == FACT_MAX or not fact_add_fits(up, down): continue
            total = up + down
            if fact_add_fits(total, tail) and total + tail <= limit: return true
    false

# y - h <= d: the shortest row path, else the operands' intervals. FACT_MAX: none.
fact_gap = (s: FactState, y: int, h: int) -> int:
    if y == h: return 0
    best = fact_shortest(s, y, h)
    p = fact_signed_bound(s, y)
    q = fact_signed_bound(s, h)
    if not p.wide and not q.wide and p.hi != FACT_MAX and q.lo != FACT_MIN and fact_add_fits(p.hi, -q.lo): best = min(best, p.hi - q.lo)
    best

# v - b <= d: a bounded row path, else v's interval or one row from v to an
# interval, against b's lower end (`h*w <=? INT64_MAX` through
# `xs.length =? h*w`). O(fact_distance + 16 incident rows).
fact_below = (s: FactState, v: int, b: int, d: int) -> bool:
    if fact_distance(s, v, b, d): return true
    low = fact_signed_bound(s, b)
    top = fact_signed_bound(s, v)
    if low.wide or top.wide or low.lo == FACT_MIN: return false
    best = top.hi
    ri = fact_difference_head(s, v, 1)
    seen = 0
    loop ri >= 0 and seen < 16:
        row = s.differences[ri]
        ri = fact_difference_next(s, ri, 1)
        seen += 1
        o = fact_signed_bound(s, row.b)
        if not o.wide and o.hi != FACT_MAX and fact_add_fits(o.hi, row.limit): best = min(best, o.hi + row.limit)
    best != FACT_MAX and fact_add_fits(best, -low.lo) and best - low.lo <= d

# A product with a shared factor, on demand: a = y*w (+ x) against a
# retained t = h*w, then t - b. With w >= wl >= 0 and y - h <= dy <= 0,
# a - t = (y-h)*w + x <= dy*wl + x, and with dy <= -1 and x - w <= dx,
# also <= (dy+1)*wl + dx: `r*w + c <? xs.length` from `xs.length =? h*w`,
# `0 <=? c <? w` and `r <? h`. Retained arithmetic terms are exact (a product
# that may wrap is never kept), so the algebra is the mathematical one.
# Only a compare whose left side is a product, or a sum with one (nested
# once, `(k*n + col) + j`), gets here.
# O(active terms) per factor order, plus two bounded relaxations and 16
# incident rows per retained product sharing w.
fact_product_compare = (s: FactState, a: int, b: int, limit: int) -> bool:
    if a == 0 or b == 0: return false
    t = fact_terms[a]
    if t.a == 0 or t.b == 0: return false
    if t.op != .star and t.op != .plus: return false
    if fact_bound(s, a).wide: return false
    # (the product and up to two addends: `p`, `p + x`, `(p + x) + x2`)
    loop pick in [0..6):
        p = a
        x = 0
        x2 = 0
        if t.op == .star:
            if pick > 0: break
        else if pick < 2:
            p = if pick == 0: t.a else: t.b
            x = if pick == 0: t.b else: t.a
        else:
            u = if pick < 4: t.a else: t.b
            x2 = if pick < 4: t.b else: t.a
            ut = fact_terms[u]
            if ut.op != .plus or ut.a == 0 or ut.b == 0: continue
            p = if pick % 2 == 0: ut.a else: ut.b
            x = if pick % 2 == 0: ut.b else: ut.a
        pt = fact_terms[p]
        if pt.op != .star or pt.a == 0 or pt.b == 0: continue
        if fact_bound(s, p).wide: continue
        xb = if x == 0: FactBound(0, 0) else: fact_signed_bound(s, x)
        if x2 != 0:
            extra = fact_signed_bound(s, x2)
            xb.wide = xb.wide or extra.wide
            xb.lo = if xb.lo != FACT_MIN and extra.lo != FACT_MIN and fact_add_fits(xb.lo, extra.lo): xb.lo + extra.lo else: FACT_MIN
            xb.hi = if xb.hi != FACT_MAX and extra.hi != FACT_MAX and fact_add_fits(xb.hi, extra.hi): xb.hi + extra.hi else: FACT_MAX
        if xb.wide: continue
        loop side in [0..2):
            y = if side == 0: pt.a else: pt.b
            w = if side == 0: pt.b else: pt.a
            if side == 1 and y == w: break
            wb = fact_signed_bound(s, w)
            if wb.wide: continue
            wl = wb.lo
            dx = if x == 0: FACT_MAX else if x2 == 0: fact_gap(s, x, w) else: fact_pair_gap(s, x, x2, w)
            # (x <= w + dx with x >= x.lo: w >= x.lo - dx)
            if wl < 0 and dx != FACT_MAX and dx != FACT_MIN and xb.lo != FACT_MIN and fact_add_fits(xb.lo, -dx): wl = max(wl, xb.lo - dx)
            if wl < 0: continue
            loop v in s.ids:
                tt = fact_terms[v]
                if tt.op != .star or tt.a != w and tt.b != w: continue
                h = if tt.a == w: tt.b else: tt.a
                if h == 0 or fact_bound(s, v).wide: continue
                dy = fact_gap(s, y, h)
                if dy == FACT_MAX or dy > 0 or math_word_overflow(2, dy, wl): continue
                up = FACT_MAX
                if x == 0: up = dy * wl
                else:
                    if xb.hi != FACT_MAX and fact_add_fits(dy * wl, xb.hi): up = dy * wl + xb.hi
                    if dy <= -1 and dx != FACT_MAX and not math_word_overflow(2, dy + 1, wl) and fact_add_fits((dy + 1) * wl, dx): up = min(up, (dy + 1) * wl + dx)
                if up == FACT_MAX or up == FACT_MIN or not fact_add_fits(limit, -up): continue
                if fact_below(s, v, b, limit - up): return true
    false

# x + x2 - w <= d with no term for x + x2: through a retained w - x
# (`j <? n - col` bounds `col + j` below n), else the intervals.
# O(active terms) plus one bounded relaxation per such difference.
fact_pair_gap = (s: FactState, x: int, x2: int, w: int) -> int:
    best = FACT_MAX
    p = fact_signed_bound(s, x)
    q = fact_signed_bound(s, x2)
    r = fact_signed_bound(s, w)
    if not p.wide and not q.wide and not r.wide and p.hi != FACT_MAX and q.hi != FACT_MAX and r.lo != FACT_MIN and fact_add_fits(p.hi, q.hi) and fact_add_fits(p.hi + q.hi, -r.lo): best = p.hi + q.hi - r.lo
    loop v in s.ids:
        m = fact_terms[v]
        if m.op != .minus or m.a != w or m.b != x and m.b != x2: continue
        d = fact_gap(s, (if m.b == x: x2 else: x), v)
        if d < best: best = d
    best

# A sum p + q against b through a retained difference m = x - p: q - m <= u and
# x - b <= t give p + q - b = (q - m) + (x - b) <= u + t, so `start+size <? len`
# from the guard `size <? len-start`. Retained arithmetic terms are exact, so the
# algebra is the mathematical one; a uint64's biased terms are never composed.
# Only a compare whose left side is a sum gets here. O(active terms) with two
# bounded distance queries per difference of an operand.
fact_guard_compare = (s: FactState, a: int, b: int, limit: int) -> bool:
    if a == 0 or b == 0: return false
    sum = fact_terms[a]
    if sum.op != .plus or sum.a == 0 or sum.b == 0 or fact_type(sum.type) == T_U64 or fact_type(fact_terms[b].type) == T_U64: return false
    loop m in s.ids:
        term = fact_terms[m]
        if term.op != .minus or term.a == 0 or term.b == 0 or term.b != sum.a and term.b != sum.b: continue
        if fact_type(term.type) == T_U64 or fact_type(fact_terms[term.a].type) == T_U64: continue
        other = if term.b == sum.a: sum.b else: sum.a
        if fact_type(fact_terms[other].type) == T_U64: continue
        up = fact_shortest(s, other, m)
        if up == FACT_MAX: continue
        tail = fact_shortest(s, term.a, b)
        if tail != FACT_MAX and fact_add_fits(up, tail) and up + tail <= limit: return true
    false

# Selected affine rows share a single symbolic root. Normalize only on query,
# with a 32-node budget; unrelated roots and nonlinear products stay unknown.
struct FactAffine:
    root: int = 0
    scale: int = 0
    offset: int = 0
    valid: bool = true

fact_affine = (s: FactState, v: int, budget: mut int) -> FactAffine:
    budget -= 1
    if v == 0 or budget < 0: return FactAffine(valid = false)
    bound = fact_bound(s, v)
    # (a wide singleton is an `int` beyond int64, not that constant)
    if bound.lo == bound.hi and not bound.wide: return FactAffine(offset = bound.lo)
    t = fact_terms[v]
    if t.op != .plus and t.op != .minus and t.op != .star: return FactAffine(v, 1)
    a = fact_affine(s, t.a, budget)
    b = fact_affine(s, t.b, budget)
    if not a.valid or not b.valid: return FactAffine(valid = false)
    if t.op == .star:
        if a.root == 0:
            swap = a; a = b; b = swap
        if b.root != 0 or math_word_overflow(2, a.scale, b.offset) or math_word_overflow(2, a.offset, b.offset): return FactAffine(valid = false)
        return FactAffine(a.root, a.scale * b.offset, a.offset * b.offset)
    if a.root != 0 and b.root != 0 and a.root != b.root: return FactAffine(valid = false)
    if t.op == .minus:
        if b.scale == FACT_MIN or b.offset == FACT_MIN: return FactAffine(valid = false)
        b.scale = -b.scale; b.offset = -b.offset
    if not fact_add_fits(a.scale, b.scale) or not fact_add_fits(a.offset, b.offset): return FactAffine(valid = false)
    FactAffine((if a.root != 0: a.root else: b.root), a.scale + b.scale, a.offset + b.offset)

fact_affine_compare = (s: FactState, op: Tok, av: int, bv: int) -> int:
    # A sum relative to one of its captured operands needs only the other
    # operand's sign, even if that operand has no difference rows. Query
    # existing indexed terms only: O(1), no new rows or body walk. Retained
    # non-wide arithmetic terms denote exact values, never a possible wrap.
    loop side in [0..2):
        sum = fact_terms[if side == 0: av else: bv]
        base = if side == 0: bv else: av
        if base == 0 or sum.op != .plus or sum.a != base and sum.b != base: continue
        other = if sum.a == base: sum.b else: sum.a
        if other == 0: continue
        bound = fact_bound(s, other)
        if bound.wide: continue
        if op == .eq:
            if bound.lo == 0 and bound.hi == 0: return 1
            if bound.nz or bound.lo > 0 or bound.hi < 0: return 0
        else if op == .lt:
            if side == 0:
                if bound.hi < 0: return 1
                if bound.lo >= 0: return 0
            else:
                if bound.lo > 0: return 1
                if bound.hi <= 0: return 0
        else if op == .le:
            if side == 0:
                if bound.hi <= 0: return 1
                if bound.lo > 0: return 0
            else:
                if bound.lo >= 0: return 1
                if bound.hi < 0: return 0
    budget = 32
    a = fact_affine(s, av, budget)
    b = fact_affine(s, bv, budget)
    if not a.valid or not b.valid or a.root != b.root: return -1
    if b.scale == FACT_MIN or b.offset == FACT_MIN: return -1
    if not fact_add_fits(a.scale, -b.scale) or not fact_add_fits(a.offset, -b.offset): return -1
    scale = a.scale - b.scale
    offset = a.offset - b.offset
    domain = if a.root == 0: FactBound(0, 0) else: fact_bound(s, a.root)
    if domain.wide and scale != 0: return -1
    # (an open `int` end of the root is infinite: that side of the difference is unbounded)
    lo_open = scale != 0 and domain.lo == FACT_MIN and fact_open_endpoint(s, a.root, false)
    hi_open = scale != 0 and domain.hi == FACT_MAX and fact_open_endpoint(s, a.root, true)
    if lo_open: domain.lo = if hi_open: 0 else: domain.hi
    if hi_open: domain.hi = domain.lo
    if math_word_overflow(2, domain.lo, scale) or math_word_overflow(2, domain.hi, scale): return -1
    low = min(domain.lo * scale, domain.hi * scale)
    high = max(domain.lo * scale, domain.hi * scale)
    if not fact_add_fits(low, offset) or not fact_add_fits(high, offset): return -1
    low += offset; high += offset
    if lo_open and scale > 0 or hi_open and scale < 0: low = FACT_MIN
    if hi_open and scale > 0 or lo_open and scale < 0: high = FACT_MAX
    if op == .lt:
        if high < 0: return 1
        if low >= 0: return 0
    if op == .le:
        if high <= 0: return 1
        if low > 0: return 0
    if op == .eq:
        if low == 0 and high == 0: return 1
        if high < 0 or low > 0: return 0
    -1

fact_compare = (s: FactState, op: Tok, a: int, b: int) -> int:
    x = fact_bound(s, a)
    y = fact_bound(s, b)
    if x.wide or y.wide:
        if (op == .lt or op == .le) and fact_guard_compare(s, a, b, (if op == .lt: -1 else: 0)): return 1
        # (a wide value marked nonzero still differs from a zero)
        if (op == .eq or op == .ne) and (x.nz and not y.wide and y.lo == 0 and y.hi == 0 or y.nz and not x.wide and x.lo == 0 and x.hi == 0): return int(op == .ne)
        return -1
    # Intervals already decide separated or singleton ranges. Do not search
    # predicates and relation rows for an answer the endpoints give directly.
    if op == .eq or op == .ne:
        if x.hi < y.lo or y.hi < x.lo or x.nz and y.lo == 0 and y.hi == 0 or y.nz and x.lo == 0 and x.hi == 0: return int(op == .ne)
        if x.lo == x.hi and y.lo == y.hi: return int((x.lo == y.lo) == (op == .eq))
    else if op == .lt:
        if x.hi < y.lo: return 1
        if x.lo >= y.hi and (x.lo != FACT_MIN or fact_host_endpoint(s, a, false)) and (y.hi != FACT_MAX or fact_host_endpoint(s, b, true)): return 0
    else if op == .le:
        if x.hi <= y.lo and (x.hi != FACT_MAX or fact_host_endpoint(s, a, true)) and (y.lo != FACT_MIN or fact_host_endpoint(s, b, false)): return 1
        if x.lo > y.hi: return 0
    else if op == .gt:
        if x.lo > y.hi: return 1
        if x.hi <= y.lo and (x.hi != FACT_MAX or fact_host_endpoint(s, a, true)) and (y.lo != FACT_MIN or fact_host_endpoint(s, b, false)): return 0
    else if op == .ge:
        if x.lo >= y.hi and (x.lo != FACT_MIN or fact_host_endpoint(s, a, false)) and (y.hi != FACT_MAX or fact_host_endpoint(s, b, true)): return 1
        if x.hi < y.lo: return 0
    if a != 0 and b != 0:
        loop i in [0..s.ids.len()):
            term = fact_terms[s.ids[i]]
            if term.a == a and term.b == b and term.op == op and s.bounds[i].lo == s.bounds[i].hi: return int(s.bounds[i].lo != 0)
    if op == .gt: return fact_compare(s, .lt, b, a)
    if op == .ge: return fact_compare(s, .le, b, a)
    if op == .ne:
        r = fact_compare(s, .eq, a, b)
        return if r < 0: -1 else: 1 - r
    if a != 0 and a == b: return if op == .lt: 0 else: 1
    if op == .lt and fact_distance(s, a, b, -1): return 1
    if op == .lt and fact_distance(s, b, a, 0): return 0
    if op == .le and fact_distance(s, a, b, 0): return 1
    if op == .le and fact_distance(s, b, a, -1): return 0
    if op == .eq:
        if fact_distance(s, a, b, 0) and fact_distance(s, b, a, 0): return 1
        if fact_distance(s, a, b, -1) or fact_distance(s, b, a, -1): return 0
        if x.hi < y.lo or y.hi < x.lo: return 0
        if x.nz and y.lo == 0 and y.hi == 0 or y.nz and x.lo == 0 and x.hi == 0: return 0
        if x.lo == x.hi and y.lo == y.hi: return int(x.lo == y.lo)
    if op == .lt:
        if x.hi < y.lo: return 1
        if x.lo >= y.hi and (x.lo != FACT_MIN or fact_host_endpoint(s, a, false)) and (y.hi != FACT_MAX or fact_host_endpoint(s, b, true)): return 0
    if op == .le:
        if x.hi <= y.lo and (x.hi != FACT_MAX or fact_host_endpoint(s, a, true)) and (y.lo != FACT_MIN or fact_host_endpoint(s, b, false)): return 1
        if x.lo > y.hi: return 0
    if (op == .lt or op == .le) and fact_sum_compare(s, a, b, (if op == .lt: -1 else: 0)): return 1
    if (op == .lt or op == .le) and fact_product_compare(s, a, b, (if op == .lt: -1 else: 0)): return 1
    if (op == .lt or op == .le) and fact_guard_compare(s, a, b, (if op == .lt: -1 else: 0)): return 1
    fact_affine_compare(s, op, a, b)

fact_inverse = (op: Tok) -> Tok:
    if op == .eq: return .ne
    if op == .ne: return .eq
    if op == .lt: return .ge
    if op == .le: return .gt
    if op == .gt: return .le
    .lt

# A MIN/MAX endpoint of an `int` (or an untyped value) is open: it may stand
# for values beyond int64, unless a singleton, a captured fixed value or a
# current guard makes it real. uint64's biased endpoints are real (0, 2^64-1).
# O(1) plus at most 16 incident rows.
fact_open_endpoint = (s: FactState, v: int, upper: bool) -> bool:
    v != 0 and fact_type(fact_terms[v].type) != T_U64 and not fact_host_endpoint(s, v, upper)

# Neither of v's MIN/MAX ends is open. O(fact_open_endpoint).
fact_real_ends = (s: FactState, v: int, b: FactBound) -> bool:
    (b.lo != FACT_MIN or not fact_open_endpoint(s, v, false)) and (b.hi != FACT_MAX or not fact_open_endpoint(s, v, true))

fact_set_bound = (s: mut FactState, v: int, b0: FactBound, exact: bool = false):
    i = fact_slot(s, v)
    if i < 0: return
    b = b0
    if b.lo > b.hi or b.nz and b.lo == 0 and b.hi == 0: s.live = false
    # Nonzero at an interval endpoint excludes it: `n not=? 0` with `n >=? 0`
    # is `n >=? 1` (an early-returned empty length makes `xs[0]`, `xs[end]` safe).
    else if b.nz and b.lo == 0: b.lo = 1
    else if b.nz and b.hi == 0: b.hi = -1
    # (an `int` narrowed onto an open MIN/MAX endpoint, `n >=? MAX`, is at
    # least MAX, not MAX itself: it stays wide unless that endpoint was real)
    if s.live and not exact and not b.wide and b.lo == b.hi and (b.hi == FACT_MAX or b.lo == FACT_MIN) and fact_open_endpoint(s, v, b.hi == FACT_MAX):
        b.wide = true
        b.nz = true
    s.bounds[i] = b

# A `let` binding's `and`/`or` value (fact_saving while it is captured):
# a saved Boolean, assumed again where it is tested.
fact_saving = false
fact_saved_boolean = (n0: int) -> bool:
    n = n0
    loop n > 0 and nodes[n].kind == .not_: n = int(nodes[n].a)
    n > 0 and (nodes[n].kind == .and_ or nodes[n].kind == .or_)

# A saved Boolean's right operand runs on one path only, but the places it
# reads, the elements it reads at a local index (`xs[i]`) and its literals
# hold the same values on both paths at the split. Evaluate them before the
# split: both paths then share their identities, so assuming the saved
# Boolean narrows later reads. Reads only, never closures or nested control;
# at most `budget` nodes. (fact_shared_literals: the literals' values, which
# the operand's own evaluation reuses, scanned only while it is evaluated.)
fact_shared_literals: (int, int)[]

# Assume the CAPTURED Boolean, never reevaluate its syntax after later effects.
fact_equal_arrays: {int: (int, int, int)} = {}
fact_assume = (s: mut FactState, v: int, truth: bool):
    if v == 0: return
    known = fact_truth(s, v)
    if known >= 0 and (known == 1) != truth: s.live = false
    t = fact_terms[v]
    fact_set_bound(s, v, FactBound(int(truth), int(truth), truth))
    if t.op == .kw_and and truth or t.op == .kw_or and not truth:
        fact_assume(s, t.a, truth)
        fact_assume(s, t.b, truth)
        return
    if t.op == .kw_not:
        fact_assume(s, t.a, not truth)
        return
    if not fact_comparison(t.op):
        # This Boolean remembers the evaluated operands' lengths, not their
        # mutable source places. Reassigning either operand cannot reuse it.
        if t.origin != 0 and fact_length_comparison(t.origin):
            equal = truth == (nodes[t.origin].op == i32(int(Tok.eq)))
            if equal:
                fact_assume(s, fact_new(s, fact_domain(T_BOOL), FactTerm(.eq, t.a, t.b)), true)
                # (equal int arrays of a small known length have equal elements: `m.length =? [33 33]`)
                # (by node: its latest evaluation, the one this value names; term numbers are reused)
                pair = fact_equal_arrays.get(t.origin) ?? (0, 0, 0)
                if pair.0 == v:
                    x = fact_bound(s, t.a)
                    y = fact_bound(s, t.b)
                    count = if x.lo == x.hi: x.lo else if y.lo == y.hi: y.lo else: -1
                    if count >= 0 and count <= 4:
                        loop axis in [0..count):
                            index = fact_constant(s, axis)
                            left = fact_project(s, pair.1, index, true, T_INT)
                            right = fact_project(s, pair.2, index, true, T_INT)
                            fact_assume(s, fact_new(s, fact_domain(T_BOOL), FactTerm(.eq, left, right)), true)
            else:
                x = fact_bound(s, t.a); y = fact_bound(s, t.b)
                if x.lo == 0 and x.hi == 0 or y.lo == 0 and y.hi == 0:
                    fact_assume(s, fact_new(s, fact_domain(T_BOOL), FactTerm(.ne, t.a, t.b)), true)
            return
        # Byte-prefix/suffix success on a nonempty pattern implies at least
        # one grapheme, even when combining marks merge at the boundary.
        if truth and t.origin != 0 and fact_affix_call(t.origin) and fact_bound(s, t.b).lo > 0:
            fact_assume(s, fact_new(s, fact_domain(T_BOOL), FactTerm(.ge, t.a, fact_constant(s, fact_affix_floor(kid(t.origin, 1))))), true)
        # A byte prefix has no more graphemes than its text: a boundary is
        # decided by the scalars before it and the one after, so the prefix's
        # inner boundaries are the text's, and its end is at most the text's.
        # (Not a suffix: `ZWJ emoji` alone splits where `emoji ZWJ emoji` joins.)
        if truth and t.origin != 0 and fact_affix_call(t.origin) and nodes[int(fns[int(nodes[t.origin].sym)].decl)].name == i32(fact_name_starts_with):
            fact_assume(s, fact_new(s, fact_domain(T_BOOL), FactTerm(.le, t.b, t.a)), true)
        return
    op = if truth: t.op else: fact_inverse(t.op)
    a = t.a
    b = t.b
    if op == .gt or op == .ge:
        a = t.b
        b = t.a
        op = if op == .gt: Tok.lt else: Tok.le
    x = fact_bound(s, a)
    y = fact_bound(s, b)
    # A true comparison can bring an exact offset back into the host domain.
    # Require its opposite endpoint to be strictly inside that domain: an
    # endpoint at MIN/MAX may stand for an unbounded side of a wide value.
    # The other side's MIN/MAX end must be real too: an open `int` end would
    # hand a wide int64 sum a real-looking word bound (`a+b <? m`).
    if op == .eq:
        if x.wide and not y.wide and fact_real_ends(s, b, y): x = y; fact_set_bound(s, a, x, y.lo == y.hi)
        else if y.wide and not x.wide and fact_real_ends(s, a, x): y = x; fact_set_bound(s, b, y, x.lo == x.hi)
    else if op == .lt or op == .le:
        # (each bounded on its far end, `top <=? bottom` after `top = max(1 ..)` and
        # `bottom = min(n-2 ..)`: the pair lies between those ends, so neither is wide)
        if x.wide and y.wide and (x.lo != FACT_MIN or not fact_open_endpoint(s, a, false)) and (y.hi != FACT_MAX or not fact_open_endpoint(s, b, true)):
            x.hi = min(x.hi, y.hi)
            x.wide = false
            fact_set_bound(s, a, x, not fact_open_endpoint(s, b, true))
            y.lo = max(y.lo, x.lo)
            y.wide = false
            fact_set_bound(s, b, y, not fact_open_endpoint(s, a, false))
            x = fact_bound(s, a)
            y = fact_bound(s, b)
        if x.wide and not y.wide and x.lo > FACT_MIN and (y.hi != FACT_MAX or not fact_open_endpoint(s, b, true)):
            x.hi = y.hi
            x.wide = false
            # (below a real MAX, at least MAX is exactly MAX)
            fact_set_bound(s, a, x, not fact_open_endpoint(s, b, true))
            x = fact_bound(s, a)
        if y.wide and not x.wide and y.hi < FACT_MAX and (x.lo != FACT_MIN or not fact_open_endpoint(s, a, false)):
            y.lo = x.lo
            y.wide = false
            fact_set_bound(s, b, y, not fact_open_endpoint(s, a, false))
            y = fact_bound(s, b)
        # A first guard may bound only one end of a wide result. Keep its
        # captured relation so a later guard can establish the other end.
        if x.wide or y.wide:
            if not y.wide and (y.hi != FACT_MAX or fact_host_value(s, b)) or not x.wide and (x.lo != FACT_MIN or fact_host_value(s, a)):
                fact_difference(s, a, b, (if op == .lt: -1 else: 0), t.origin)
            if x.wide: fact_guarded_word(s, a); x = fact_bound(s, a)
            if y.wide: fact_guarded_word(s, b); y = fact_bound(s, b)
        # (below an `int` literal in [2^63, 2^64): a row, the only place
        # that ceiling fits, for a conversion to uint64)
        if y.wide and not x.wide and fact_u64_literal(b) < 0: fact_difference(s, a, b, (if op == .lt: -1 else: 0), t.origin)
    # Excluding zero does not require a host-word interval. Keep this fact
    # for a 65-bit difference or an arbitrarily wide mathematical integer.
    if op == .ne and (x.wide or y.wide):
        if not y.wide and y.lo == 0 and y.hi == 0:
            x.nz = true
            fact_set_bound(s, a, x)
        if not x.wide and x.lo == 0 and x.hi == 0:
            y.nz = true
            fact_set_bound(s, b, y)
    if x.wide or y.wide: return
    exact = false
    if op == .eq:
        fact_difference(s, a, b, 0, t.origin)
        fact_difference(s, b, a, 0, t.origin)
        lo = max(x.lo, y.lo)
        hi = min(x.hi, y.hi)
        x.lo = lo; y.lo = lo; x.hi = hi; y.hi = hi
        x.nz = x.nz or y.nz; y.nz = x.nz
        # (equal to a real MIN/MAX endpoint is exactly that value)
        if lo == hi and (hi == FACT_MAX or lo == FACT_MIN):
            upper = hi == FACT_MAX
            exact = not fact_open_endpoint(s, a, upper) or not fact_open_endpoint(s, b, upper)
    else if op == .ne:
        # A disequality tightens an already ordered symbolic pair too.
        # The existing bounded indexed path query supplies the ordering.
        if x.lo != x.hi and y.lo != y.hi:
            if fact_distance(s, a, b, 0): fact_difference(s, a, b, -1, t.origin)
            else if fact_distance(s, b, a, 0): fact_difference(s, b, a, -1, t.origin)
        if y.lo == 0 and y.hi == 0: x.nz = true
        if x.lo == 0 and x.hi == 0: y.nz = true
        # (a constant at an interval's end moves that end inward: `x not=? MAX`
        # leaves room for x+1, `r not=? -1` with r >=? -1 makes r >=? 0)
        # An open `int` endpoint at MIN/MAX does not move: n not=? MAX may be above it.
        if y.lo == y.hi and x.lo < x.hi:
            if x.lo == y.lo and (x.lo != FACT_MIN or not fact_open_endpoint(s, a, false)): x.lo += 1
            else if x.hi == y.lo and (x.hi != FACT_MAX or not fact_open_endpoint(s, a, true)): x.hi -= 1
        else if x.lo == x.hi and y.lo < y.hi:
            if y.lo == x.lo and (y.lo != FACT_MIN or not fact_open_endpoint(s, b, false)): y.lo += 1
            else if y.hi == x.lo and (y.hi != FACT_MAX or not fact_open_endpoint(s, b, true)): y.hi -= 1
    else if op == .lt or op == .le:
        d = if op == .lt: 1 else: 0
        # An open `int` endpoint at MIN/MAX bounds nothing and refutes nothing:
        # `MAX <? n` holds for n above int64. Past a real one the edge is dead.
        x_open = x.lo == FACT_MIN and fact_open_endpoint(s, a, false)
        y_open = y.hi == FACT_MAX and fact_open_endpoint(s, b, true)
        # (a guard's own relation, written by the program: the wider cap)
        fact_difference(s, a, b, -d, t.origin, 16)
        if d == 1 and (y.hi == FACT_MIN and not x_open or x.lo == FACT_MAX and not y_open): s.live = false
        else:
            below = if y.hi == FACT_MIN: FACT_MIN else: y.hi - d
            above = if x.lo == FACT_MAX: FACT_MAX else: x.lo + d
            if not y_open: x.hi = min(x.hi, below)
            if not x_open: y.lo = max(y.lo, above)
    fact_set_bound(s, a, x, exact)
    fact_set_bound(s, b, y, exact)
    if op == .lt or op == .le:
        fact_offset_narrow(s, a, x)
        fact_offset_narrow(s, b, y)
    else:
        fact_remainder_decided(s, a)
        fact_remainder_decided(s, b)

# A compared offset `i+c` (or `i-c`) narrows i too: `i+1 <? stop` bounds i
# below stop-1, so a counter guarded at an offset stays below a length. O(1).
fact_offset_narrow = (s: mut FactState, v: int, b: FactBound):
    t = fact_terms[v]
    if t.op != .plus and t.op != .minus or t.a == 0 or t.b == 0: return
    c = fact_bound(s, t.b)
    operand = t.a
    # (`k + x`, the constant first, is the same offset of x)
    if (c.lo != c.hi or c.lo == FACT_MIN or c.lo == FACT_MAX) and t.op == .plus:
        c = fact_bound(s, t.a)
        operand = t.b
    if c.lo != c.hi or c.lo == FACT_MIN or c.lo == FACT_MAX: return
    k = if t.op == .plus: c.lo else: -c.lo
    x = fact_bound(s, operand)
    if x.reason == .budget and x.lo == FACT_MIN and x.hi == FACT_MAX: return
    if b.hi != FACT_MAX and fact_add_fits(b.hi, -k): x.hi = min(x.hi, b.hi - k)
    if b.lo != FACT_MIN and fact_add_fits(b.lo, -k): x.lo = max(x.lo, b.lo - k)
    fact_set_bound(s, operand, x)
    # Once a guard brought the exact offset into range, retain its identity
    # as well as its interval. The next evaluation of i+k then finds the
    # guarded value through fact_offset_value. O(1), indexed rows.
    if not b.wide:
        fact_difference(s, v, operand, k, 0, 16)
        fact_difference(s, operand, v, -k, 0, 16)

struct FactPaths:
    yes: FactState
    no: FactState
    reason: FactBound
    value: int = 0      # the captured comparison of a leaf condition
    entry: FactState = FactState(live = false)  # its state before assumption, for `$assert` diagnostics

# Implication records, append-only: a state's evidence names one by index
# (ResultEvidence tag -2, base = index + 1), so copying a state copies no
# arrays. The antecedent is (op0, a0, b0), the consequent (op1, a1, b1); an
# operand is a value, or a constant when its kind bit (k: 1 a0, 2 b0, 4 a1,
# 8 b1) is set.
struct FactImplication:
    op0: Tok
    a0: int
    b0: int
    op1: Tok
    a1: int
    b1: int
    k: int

fact_implications: FactImplication[]
fact_either_wanted = 0   # (an if's condition: 1 its `or` paths, 2 its `and` refutations)

fact_unmodeled = (s: mut FactState, n: int, reason: FactReason) -> int:
    b = if exact_has_node(n): FactBound(reason = reason, witness = n, wide = true) else: fact_domain(ntype(n), reason, n)
    if fact_query: fact_unknown(n, b)
    fact_new(s, b, FactTerm(type = fact_fresh_type(ntype(n))))

fact_add_fits = (a: int, b: int) -> bool:
    if b > 0: return a <= FACT_MAX - b
    if b < 0: return a >= FACT_MIN - b
    true

# Only a quotient/shift consumer requests a 65-bit mathematical sum term.
# Do not retain arbitrary wide loop updates and perturb their fixed point.
# One current AST identity, restored across nested captures: O(1) state.
fact_sum_operand = 0

# `b =? 0`, `b <? 0` or `0 <? b` for an exact rational b (the library's `__eq__`
# or `__lt__` with a rational constant zero, expr.jo rational_constants): what
# b's numerator says, since its denominator is positive; the projection an exact
# division's divisor obligation reads (fact_divisor).
# The other operand's position, or -1.
fact_name_rational_eq = 0
fact_name_rational_lt = 0

# `rational(numerator denominator)` of integers: its one failure is a zero
# denominator, the caller's obligation as a division's divisor. O(1).
fact_name_rational = 0

# A program's exact `a.divmod(b)` (lib/rational.dewy): its one failure is a
# zero divisor, the caller's obligation as `a // b`'s (fact_divisor reads b's
# numerator). Library calls keep the callee's panic (effects.jo). O(1).
fact_name_divmod = 0

# A library integer or rational power, `x^n` with an integer n: every one fails
# only for a negative exponent (a rational's for a zero base as well), so n >= 0
# is the caller's obligation.
fact_name_power = 0
fact_name_pow = 0
fact_name_pow_op = 0

# The library's range constructors, whose one failure is a zero step: the
# position of the `first` argument (the second value follows it) when the call
# passes a literal `stepped` that is `step` (an open counter's is always
# stepped), or -1. `__dewy_range(first second last stepped inclusive)`, a matrix
# axis's `__nd_axis_slice(first second last inclusive bounded stepped
# exclusive_first)`, an update's `__dewy_slice_range(size first second last
# inclusive bounded stepped)` and `__dewy_open_range_iter(first second)`. O(1).
fact_name_range = 0
fact_name_axis_slice = 0
fact_name_slice_range = 0
fact_name_open_range = 0

# Dewy strings index and slice by grapheme: `text.length`, `text[i]` and
# `text[a..b)` reach the facts pass as calls of the library's grapheme helpers
# (1, 2 and 3 here). Their length is the string value's length projection, as
# an array's is; the index and the slice are obligations, as an array's are.
fact_name_starts_with = 0
fact_name_ends_with = 0

fact_name_string_length = 0
fact_name_string_index = 0
fact_name_string_slice = 0
fact_name_byte_slice = 0

# A string's byte view, the value `text as array<uint8>` is: one per string value, so
# its length and the bytes guards read relate to every view of the same text.
const FACT_BYTE_VIEW = -6
const FACT_ASCII_TEXT = -15

# `xs.swap(i j)` needs both indexes in bounds and `xs.insert(value i)` a
# position 0 <=? i <=? xs.length: obligations of the call, as an index is (the
# library's helper checks them where they are deferred). 4 swap, 5 insert, or 0.
# `bytes.read<uint64>(i)` needs 0 <=? i and i + 8 <=? bytes.length (4 for uint32, 2 for
# uint16): 10 plus the width here.
# `reshape(xs a b)` (to four dimensions) needs each dimension >= 0 and their
# product xs.length: 20 plus the dimensions. A slice assignment `xs[a..b) = v`
# (no step) needs 0 <=? a <=? b <=? xs.length, as a slice does, and an array v
# of b - a elements: 30 for one value, 31 for an array. A dotted expression over
# 1-D arrays (`xs .+ ys`) needs their lengths equal, or 1: 40, for `__bcast`.
fact_name_swap = 0
fact_name_insert = 0
fact_name_reshape = 0
fact_name_put_slice = 0
fact_name_bcast = 0
fact_name_reads: int[]
fact_name_permutations: int[]

# Dictionary key presence (no traps): `d[k]`, `d[k] += 1` and `d.pop(k)` need
# k in d, an obligation of the call as an index is; so does a set's `s.pop(v)`. `k in? d` is a projection
# of d's value on k's (an element projection: a dictionary has no other), true
# after a guard or a store into d[k]; any other change of d gives d a new
# value. O(1) per call. 1 `in?`, 2 read, 3 changed entry, 4 pop, 5 stored
# entry, 6 optional get, or 0.
fact_name_contains = 0
fact_name_has = 0
fact_name_read = 0
fact_name_present = 0
fact_name_pop = 0
fact_name_entry = 0
fact_name_store = 0
fact_name_get = 0

# Pool handle membership (no traps): `pool[h]`, `pool[h] = x` and a direct
# update's `__pool_index(pool h)` need `pool.has(h)`, the calls' one failure,
# an obligation as a dictionary key's presence is. has(h) reads only the
# pool's slot tables, which add, remove and clear alone change (lib/std/pool.jo
# keeps them so whatever its public fields hold): h's membership is an element
# projection of the pool's value on h's, an integer, >= 1 for a member and 0
# for none. A store into `items` or `handles`, element or whole, keeps a
# pool's memberships (fact_replace, fact_change_route); so does `[]=`. `has`
# is the projection's test. `add`'s handle is a member of the new value and of
# no older one: its projection is a rank above every finite rank of the
# members before, so ranks are pairwise distinct among handles one add apart,
# and only there; a handle a guard admits ranks [1, max], overlapping every
# other. `remove(h)` makes h no member and keeps exactly the members whose
# rank interval is disjoint from h's (provably another handle), or all when h
# is known to be no member. Any other change of the pool (clear, retain, an
# opaque or effectful call) gives it a new value with no memberships. O(1) per
# call, plus O(members) projection copies per add, remove or store.
# 1 has, 2 `[]`, 3 `__pool_index`, 4 `[]=`, 5 add, 6 remove, or 0.
fact_pool_names: int[]
fact_pool_path = ""

# Handle positions name the pool's immutable slot-table value, separately
# from its public items array. Public item edits keep positions, but bounds
# and payloads are always read from the CURRENT items value. Private-table
# writes, removal and opaque calls drop positions. Demand-only O(1) lookup;
# add/store copy O(tracked projections), within the existing state budget.
fact_pool_items_name = 0

# (and so is a field path of one, `s.region`: one value per declaration and
# path, numbered in fact_key_paths. O(path depth))
fact_key_paths: {(int, int): int}
# Captured selectors are keyed by checked local identity, never by spelling.
# Only a declaration holding the exact recorded source node enters this map.
fact_selector_sources: {int: int}

# `d.insert_if_absent(k x)` leaves k a key of d whether or not it added it,
# and removes none: the same transfer as `d[k] = x` (Python's setdefault).
fact_name_insert_if_absent = 0

# `d.clear()` on a dictionary leaves it with no entries: its new value says its length is zero (a
# dictionary field's sibling bound then holds of it whatever the sibling becomes).
fact_name_map_clear = 0
fact_map_clear_call = (n: int) -> bool:
    if nodes[n].kind != .call or nodes[n].aux != 0 or nodes[n].sym <= 0 or nkids(n) != 1: return false
    d = int(fns[int(nodes[n].sym)].decl)
    if fact_name_map_clear == 0: fact_name_map_clear = intern("clear")
    if d == 0 or int(nodes[d].name) != fact_name_map_clear or files[pos_file(nodes[d].pos)].path != lib_dir + "/core/map.jo": return false
    t = representation_type(ntype(kid(n, 0)))
    if not is_map_type(t) or ownership_decls.len() != 0 and ownership_fact_type(ntype(kid(n, 0))): return false
    kt = representation_type(struct_targ(int(types[t].st), 0))
    fact_scalar(kt) or kt == T_STR
# `d.pop(k)`, `d.pop(k default=x)` and `d.get(k x)` on a dictionary whose values a sibling's length bounds
# (1, 2 and 3; else 0): the result is below the bound (when the default is), as `d[k]` is. O(1).
fact_map_bounded_call = (n: int) -> int:
    if nodes[n].kind != .call or nodes[n].aux != 0 or nodes[n].sym <= 0: return 0
    count = nkids(n)
    if count != 2 and count != 3: return 0
    d = int(fns[int(nodes[n].sym)].decl)
    if d == 0 or not pos_in_lib(nodes[d].pos): return 0
    if fact_name_pop == 0: fact_name_pop = intern("pop")
    if fact_name_get == 0: fact_name_get = intern("get")
    name = int(nodes[d].name)
    kind = if name == fact_name_pop: count - 1 else if name == fact_name_get and count == 3: 3 else: 0
    if kind == 0: return 0
    t = representation_type(ntype(kid(n, 0)))
    if not is_map_type(t) or ownership_decls.len() != 0 and ownership_fact_type(ntype(kid(n, 0))): return 0
    kt = representation_type(struct_targ(int(types[t].st), 0))
    if fact_scalar(kt) or kt == T_STR: kind else: 0
fact_map_bounded = (n: int, s: mut FactState, values: int[], kind: int) -> int:
    # (an entry's value holds the dictionary's value type: `>=? 0` unless it states its own lower bound)
    domain = fact_domain(ntype(n), .missing, n)
    held = representation_type(ntype(kid(n, 0)))
    if is_int(fact_type(ntype(n))): domain = ref_interval(struct_targ(int(types[held].st), 1), domain)
    result = fact_new(s, domain, FactTerm(type = ntype(n)))
    if kind == 1 or kind == 2:
        # (a removal rewrites the dictionary field alone: its siblings keep what is known of them)
        route = fact_receiver_route(n, s)
        if route.root == 0: return 0
        written = fact_place(route.root)
        if written.declaration == 0: return 0
        if fact_exposed(written): fact_forget(s, n, .call, false, written, true)
        fact_store_route(s, route, fact_new(s, FactBound(), FactTerm(type = ntype(kid(n, 0)))), n)
    if kind == 1: ref_sib_map_read(s, values[0], result, n)
    else: ref_sib_default_read(s, values[0], result, values[2], kid(n, 2), n)
    result
fact_map_clear = (n: int, s: mut FactState) -> bool:
    target = kid(n, 0)
    loop nodes[target].kind == .addr or nodes[target].kind == .conv: target = int(nodes[target].a)
    route = fact_receiver_route(n, s)
    if route.root == 0: return false
    written = fact_place(route.root)
    if written.declaration == 0: return false
    if fact_exposed(written): fact_forget(s, n, .call, false, written, true)
    after = fact_new(s, FactBound(), FactTerm(type = ntype(target)))
    fact_add_projection(s, FactProjection(after, -1, false, fact_constant(s, 0)))
    fact_store_route(s, route, after, n)
    true

# Reviewed dense dictionary snapshots share their two immutable arrays. A
# removal or insertion drops the dense marker; no tombstone layout is inferred.
fact_map_snapshot_name = 0

# `[loop x in xs x -> v]` (`__map_of` of a comprehension's pairs): every
# element of the evaluated source xs becomes a key, when each iteration pushes
# exactly one pair (no filter, break or continue) and every pair's key is the
# loop's own immutable element. xs's value then names the result as its key
# snapshot (FACT_KEYS_SOURCE), as `[d.keys...]` does, so its elements are
# members of that dictionary value and of any later one keeping its key
# positions. Demand-only: O(loop body) on an evaluated __map_of call.
fact_map_of_name = 0
fact_comprehension_sources: {int: int} = {}   # a comprehension's array loop -> its evaluated source

# `loop x in xs { if x not in? d d[x] = v }` (or `d[x] = v`, or
# `d.insert_if_absent(x v)`): after the loop every element of the evaluated
# xs is a key of d. Each completed iteration ends with x a member of d (the
# body's own backedge proves it, continue edges included), no break leaves
# early, and the body only adds keys to d: the loop havoc (fact_changes) of
# the body keeps a key d held. So xs's value names d's exit value as its key
# snapshot (FACT_KEYS_SOURCE), and a literal's stable elements are members.
# Candidates are found once per loop, O(body); each costs one membership
# lookup and one havoc walk of the body on a copy of the exit state.
fact_ensured_keys_cache: {int: (int, int)[]} = {}

# Assignments in loop n's body to integer locals declared before it (a running
# `m = max(m x)`), candidates for iterating its header (fact_carried_type).
# Memoized syntax walk, O(body nodes) once per loop; nested loops are walked
# as part of it.
fact_carried_cache: {int: int[]} = {}

# Locals a loop's body pushes rows into, declared before it: the
# candidates for a length every pushed row shares. O(body), once per loop.
fact_pushed_rows_cache: {int: int[]} = {}

# A backwards slice of checked syntax and storage definitions. Build only for
# an actual consumer (obligations, a bounds probe, or a return summary). Each
# syntax/dependency edge is visited once: expected O(N+E), O(N+E) space. Storage
# is flow-insensitive here; the forward transfer still decides which write and
# guard reaches each obligation. Effects and control keep their original order.
fact_slice_children = (n: int) -> int[]:
    out: int[]
    mask = isolation_children(nodes[n].kind)
    if mask < 0: return out
    if mask & 1 != 0: out.push(int(nodes[n].a))
    if mask & 2 != 0: out.push(int(nodes[n].b))
    if mask & 4 != 0: out.push(int(nodes[n].c))
    if mask & 16 != 0:
        loop i in [0..nkids(n)): out.push(kid(n, i))
    out

# n's children onto out, in fact_slice_children's order (no list per node).
fact_slice_push_children = (out: mut int[], n: int):
    mask = isolation_children(nodes[n].kind)
    if mask < 0: return
    if mask & 1 != 0: out.push(int(nodes[n].a))
    if mask & 2 != 0: out.push(int(nodes[n].b))
    if mask & 4 != 0: out.push(int(nodes[n].c))
    if mask & 16 != 0:
        loop i in [0..nkids(n)): out.push(kid(n, i))

fact_slice_member = (parents: mut FactSliceEdges, work: mut int[], c: int, n: int):
    if c == 0: return
    fact_slice_parent(parents, c, n)
    work.push(c)

fact_slice_edge = (edges: mut FactSliceEdges, key: int, node: int):
    edges.next.push(fact_index_get(edges.heads, key))
    fact_index_put(edges.heads, key, edges.nodes.len())
    edges.nodes.push(node)

# Node-indexed scratch for building one slice: flags and the head of each
# node's parent-edge chain, valid where the stamp is the current generation.
# Membership costs O(1) without hashing; only the finished slice is indexed.
fact_mark_gen = 0
fact_mark_stamp: int[]
fact_mark_flags: int[]
fact_mark_head: int[]
fact_mark_touched: int[]

fact_mark_begin = ():
    if fact_mark_stamp.len() < nodes.len():
        fact_mark_stamp = fill(0, nodes.len() * 2 + 64)
        fact_mark_flags = fill(0, fact_mark_stamp.len())
        fact_mark_head = fill(0, fact_mark_stamp.len())
        fact_mark_gen = 0
    fact_mark_gen += 1
    fact_mark_touched = []

fact_mark_of = (n: int) -> int:
    if fact_mark_stamp[n] != fact_mark_gen: return 0
    fact_mark_flags[n]

fact_mark_touch = (n: int):
    if fact_mark_stamp[n] == fact_mark_gen: return
    fact_mark_stamp[n] = fact_mark_gen
    fact_mark_flags[n] = 0
    fact_mark_head[n] = -1
    fact_mark_touched.push(n)

fact_mark_set = (n: int, flags: int):
    fact_mark_touch(n)
    fact_mark_flags[n] = flags

fact_mark_parent = (n: int) -> int:
    if fact_mark_stamp[n] != fact_mark_gen: return -1
    fact_mark_head[n]

fact_slice_parent = (parents: mut FactSliceEdges, child: int, node: int):
    fact_mark_touch(child)
    parents.next.push(fact_mark_head[child])
    fact_mark_head[child] = parents.nodes.len()
    parents.nodes.push(node)

fact_slice_writer = (writers: mut FactSliceEdges, p: PlaceIdentity, n: int):
    if p.declaration == 0: return
    key = fact_root_key(p)
    fact_slice_edge(writers, key, n)

fact_slice_target = (writers: mut FactSliceEdges, n: int, at: int):
    if nodes[n].kind == .tuple:
        loop i in [0..nkids(n)): fact_slice_target(writers, kid(n, i), at)
        return
    fact_slice_writer(writers, fact_slice_root(n), at)

# The variable a write target changes: through fields, elements, local
# places (`let q = @r.xs`, `loop @x in xs`) and narrowed names (`if r is? T`),
# which write the variable they name, or none. O(route depth).
# A call's mutable (`@`) arguments, each written by it.
fact_slice_place_arguments = (writers: mut FactSliceEdges, n: int):
    mask = checked_call_mutmask(n)
    loop i in [0..nkids(n)):
        if mask & (1 << i) != 0: fact_slice_target(writers, kid(n, i), n)

fact_slice_root = (n: int) -> PlaceIdentity:
    root = n
    depth = 0
    loop root != 0 and depth < 64:
        depth += 1
        k = nodes[root].kind
        if k == .field or k == .index or k == .addr or fact_payload_node(root): root = int(nodes[root].a)
        else if k == .ident and nodes[root].aux == i32(int(SK.local)) and int(locals[int(nodes[root].sym)].flags) & LF_ALIAS != 0 and locals[int(nodes[root].sym)].alias != 0 and not place_locked.has(int(nodes[root].sym)): root = int(locals[int(nodes[root].sym)].alias)
        else: break
    fact_place(root)

# A contract reads its value and referenced actuals; proving it does not
# demand the callee's return summary. Called only for written argument
# contracts, O(predicate atoms), with node-indexed slice deduplication.
fact_slice_contract_actuals = (call: int, arg: int, values: mut int[]):
    values.push(arg)
    rt = prune(int(nodes[arg].aux2))
    if types[rt].kind != .refined:
        values.push(call)
        return
    loop atom in ref_predicates[int(types[rt].st)]:
        if (atom.a.kind == 2 or atom.a.kind == 5) and atom.a.value >= 0 and atom.a.value < nkids(call): values.push(kid(call, atom.a.value))
        if (atom.b.kind == 2 or atom.b.kind == 5) and atom.b.value >= 0 and atom.b.value < nkids(call): values.push(kid(call, atom.b.value))

fact_slice_prepare = (f: int, summary: bool = false):
    key = (f << 4) | int(summary) | (int(fact_probe_on) << 1) | (int(fact_policy == .RequireStatic) << 2) | (int(result_active or proof_active) << 3)
    # A mode retains its original plan through effect settlement, as before.
    # Dependencies gate sharing with a mode that has not prepared its plan yet;
    # refreshing an established mode would change its proof/witness budget.
    if let cached = fact_slice_cache.get(key): fact_slice = cached; return
    # Static probes and finalizers have the same demand roots except floor
    # probes. Share their canonical plan only with unchanged dependencies.
    share = not summary and fact_policy == .RequireStatic
    peer = key xor 2
    if share:
        if let cached = fact_slice_cache.get(peer):
            if not cached.probe_only and fact_plan_current(cached):
                fact_slice = cached
                fact_slice_cache[key] = cached
                return
    # (O(body nodes + edges) for the slice: node-indexed scratch marks, an
    # expected O(1) index for writers and for the finished slice)
    fact_mark_begin()
    parents = FactSliceEdges()
    writers = FactSliceEdges()
    roots: int[]
    exposed_writes: int[]
    opaque_writes: int[]
    work = [int(fns[f].body)]
    values: int[]
    active: int[]
    forks: int[]
    accumulators: {int: bool} = {}
    dependencies: {int: bool} = {}
    callees: int[]
    versions: int[]
    exact_demands: int[]
    index_demands: int[]
    loop_indexes: int[]
    # (locals assigned other than by a step of their own value or a record's
    # unrefined integer field, and those so assigned: loop_indexes keeps
    # positions of the first kind only)
    plain_writes: {int: bool} = {}
    stepped_writes: {int: bool} = {}
    carried = false
    rows = false
    probe_only = false
    members = fact_member_shared and f == fact_member_owner and not summary
    # Preparation visits only exact owners. Gate its node indexes once per
    # slice; unrelated bodies and summary slices have no exact value roots.
    exact = not summary and exact_marks.len() > 0 and exact_owners.has(f)
    representation = exact and f < exact_rep_owners.len() and exact_rep_owners[f]
    if summary or result_active: values.push(int(fns[f].body))
    if summary:
        loop l in fns[f].params:
            if int(locals[l].flags) & LF_MUTPARAM != 0 and (tkind(fact_type(int(locals[l].type))) == .array or is_nd(fact_type(int(locals[l].type))) or fact_record_arrays(fact_type(int(locals[l].type)))):
                values.push(mk_ident_local(l, locals[l].pos))
    cursor = 0
    loop cursor < work.len():
        n = work[cursor]; cursor += 1
        if n == 0 or fact_mark_of(n) & FACT_MEMBER != 0: continue
        fact_mark_set(n, FACT_MEMBER)
        k = nodes[n].kind
        if exact:
            if fact_exact_demand(n):
                values.push(n)
                if share: exact_demands.push(n)
            else if representation and n < exact_rep_demands.len() and exact_rep_demands[n]: values.push(n)
        # (children visited in place, a, b, c then kids: no list per node)
        mask = isolation_children(k)
        # (`parallel` under `$no_assumed_bounds`: its range's size is an obligation)
        if k == .parallel_region and dir_assumed_bounds_any: fact_slice_member(parents, work, int(nodes[n].a), n)
        if mask > 0:
            if mask & 1 != 0: fact_slice_member(parents, work, int(nodes[n].a), n)
            if mask & 2 != 0: fact_slice_member(parents, work, int(nodes[n].b), n)
            if mask & 4 != 0: fact_slice_member(parents, work, int(nodes[n].c), n)
            if mask & 16 != 0:
                walk = nkids(n)
                if members and k == .block and walk > 1 and fact_member_admit(n): walk = 1
                loop i in [0..walk): fact_slice_member(parents, work, kid(n, i), n)
        if k == .block and has_flag(n, NF_COMPREHENSION) and nkids(n) > 0 and nodes[kid(n, 0)].kind == .vardecl: accumulators[int(nodes[kid(n, 0)].sym)] = true
        if k == .vardecl:
            if ownership_decls.len() != 0 and nodes[n].b != 0 and ownership_fact_type(ntype(int(nodes[n].b))): active.push(n)
            l = int(nodes[n].sym)
            if l != 0:
                p = if has_flag(n, NF_GLOBAL): PlaceIdentity(.global, 0, l) else: PlaceIdentity(.local, int(locals[l].owner), l)
                fact_slice_writer(writers, p, n)
            loop j in [0..nkids(n)):
                c = kid(n, j)
                l = int(nodes[c].sym)
                if l > 0 and not has_flag(c, NF_GLOBAL): fact_slice_writer(writers, PlaceIdentity(.local, int(locals[l].owner), l), n)
        if not rows and k == .intrinsic and nodes[n].aux == i32(int(IN.push)) and nkids(n) == 2 and fact_push_receiver(kid(n, 0)) > 0 and fact_row_array(ntype(kid(n, 0))): rows = true
        if k == .assign:
            target = int(nodes[n].a)
            if nodes[target].kind == .ident and nodes[target].aux == i32(int(SK.local)) and fact_carried_type(int(locals[int(nodes[target].sym)].type), f): carried = true
            if nodes[target].kind == .ident and nodes[target].aux == i32(int(SK.local)):
                if fact_loop_step(int(nodes[n].b), int(nodes[target].sym)) or fact_loop_unbounded_field(int(nodes[n].b)): stepped_writes[int(nodes[target].sym)] = true
                else: plain_writes[int(nodes[target].sym)] = true
            fact_slice_target(writers, target, n)
            if not summary and (fact_probe_on or fact_policy == .RequireStatic) and fact_shift_obliged(n): values.push(n)
            root = target
            raw = false
            loop nodes[root].kind == .field or nodes[root].kind == .index:
                if nodes[root].kind == .index and tkind(fact_type(ntype(int(nodes[root].a)))) == .ptr: raw = true
                root = int(nodes[root].a)
            p = fact_place(root)
            # (a store through a raw pointer writes what raw access exposed: fact_route_raw)
            if raw or p.declaration != 0 and fact_exposed(p) and not fact_own_local(p): exposed_writes.push(n)
            else if p.declaration == 0: opaque_writes.push(n)
        if k == .for_ or k == .iflet or k == .match_:
            l = int(nodes[n].sym)
            if l > 0: fact_slice_writer(writers, PlaceIdentity(.local, int(locals[l].owner), l), n)
            if k == .for_ and nodes[n].aux == 3 and nodes[n].aux2 > 0:
                vl = int(nodes[n].aux2)
                fact_slice_writer(writers, PlaceIdentity(.local, int(locals[vl].owner), vl), n)
            if k == .for_ and not summary and (fact_probe_on or fact_policy == .RequireStatic) and (fact_stepped_loop(n) or fact_open_range(n)): values.push(n)
        if k == .if_ or k == .while_ or k == .for_ or k == .iflet or k == .match_ or k == .and_ or k == .or_ or k == .coalesce:
            # A while can prevent a later obligation from being reached,
            # even when none of its writes feed that obligation.
            if k == .while_: active.push(n)
        else if k == .return_:
            active.push(n)
            if summary or result_active: values.push(int(nodes[n].a))
        else if k == .break_ or k == .continue_ or k == .defer_: active.push(n)
        else if k == .call:
            if ntype(n) == T_NEVER or nodes[n].aux == 0 and library_exit_call(n): active.push(n)
            if not summary and (fact_probe_on or fact_policy == .RequireStatic) and (fact_library_call(n, "parallel_range") or fact_library_call(n, "parallel_map") or fact_parallel_array(n)):
                loop j in [0..nkids(n)):
                    arg = kid(n, j)
                    if nodes[arg].kind == .lambda and nodes[arg].sym > 0:
                        fact_fork_nodes[arg] = true
                        forks.push(arg)
                if fact_parallel_array(n):
                    values.push(n)
                    values.push(kid(n, 0))
            if not summary and dir_assumed_bounds_any and fact_parallel_range_call(n):
                active.push(n)
                values.push(n)
                if fact_library_call(kid(n, 0), "__dewy_range"):
                    values.push(kid(kid(n, 0), 0))
                    values.push(kid(kid(n, 0), 2))
            if not summary and (fact_probe_on or fact_policy == .RequireStatic) and fact_key_callback(n) > 0:
                arg = fact_key_callback(n)
                fact_fork_nodes[arg] = true
                forks.push(arg)
                values.push(n)
                values.push(kid(n, 0))
            if result_active or proof_active or fact_divisors.has(n) or fact_rational_constructor(n) or fact_rational_promotion(n) or fact_rational_divmod(n): values.push(n)
            else if not summary and (fact_probe_on or fact_policy == .RequireStatic) and fact_string_call(n) >= 2: values.push(n)
            else if not summary and (fact_probe_on or fact_policy == .RequireStatic) and fact_rational_zero_test(n) >= 0:
                values.push(n)
                values.push(kid(n, fact_rational_zero_test(n)))
            else if not summary and (fact_probe_on or fact_policy == .RequireStatic) and fact_power_call(n):
                values.push(n)
                values.push(kid(n, 1))
                values.push(kid(n, 0))
            else if not summary and (fact_probe_on or fact_policy == .RequireStatic) and fact_range_call(n):
                first = fact_range_first(n, true)
                values.push(n)
                values.push(kid(n, first))
                values.push(kid(n, first + 1))
            else if not summary and (fact_probe_on or fact_policy == .RequireStatic) and (nd_mutable_call(n) or fact_array_call(n) != 0 or fact_map_call(n) != 0 or fact_map_insert_call(n) or ref_self_active and (fact_map_clear_call(n) or fact_map_bounded_call(n) != 0) or fact_nonempty_call(n) or fact_heap_call(n) != 0 or fact_exact_sum_call(n) or fact_pool_call(n) != 0 or fact_gpu_index_call(n)):
                active.push(n)
                values.push(n)
                loop j in [0..nkids(n)): values.push(kid(n, j))
            else if (fact_probe_on or share) and fact_floor_call(n) != 0:
                if fact_probe_on: values.push(n)
                probe_only = true
            loop j in [0..nkids(n)):
                arg = kid(n, j)
                if ownership_decls.len() != 0 and ownership_fact_type(ntype(arg)): active.push(n)
                if nodes[arg].kind == .conv and nodes[arg].aux == i32(int(CV.refinement)):
                    if nodes[n].aux == 0 and nodes[n].sym > 0:
                        fact_mark_set(n, fact_mark_of(n) | FACT_CONTRACT)
                        fact_slice_contract_actuals(n, arg, values)
                    else: values.push(n)
            if wi_fact_calls.len() > 0 and wi_fact_calls.has(n):
                values.push(n)
                loop j in [0..nkids(n)): values.push(kid(n, j))
            callee = int(nodes[n].sym)
            if share and nodes[n].aux == 0 and callee > 0 and not dependencies.has(callee):
                dependencies[callee] = true
                callees.push(callee)
                versions.push(fact_plan_version(callee))
            if nodes[n].aux == 0 and callee > 0 and ref_refined_result(int(fns[callee].ret)): values.push(n)
            if nodes[n].aux == 0 and callee > 0 and callee < effect_summaries.len() and effect_summaries[callee].done:
                opaque = false
                loop event in effect_summaries[int(nodes[n].sym)].events:
                    if event.atom.kind == .opaque or event.atom.kind == .escape or event.atom.kind == .io and fact_fn_in_lib(f):
                        exposed_writes.push(n)
                        opaque = true
                    if event.atom.kind != .write: continue
                    p = place_base(event.atom.place)
                    if p.root == .formal:
                        i = p.declaration - 1
                        p = if i >= 0 and i < nkids(n): fact_written_root(kid(n, i)) else: PlaceIdentity(.local, 0, 0)
                    if p.declaration == 0: exposed_writes.push(n)
                    else:
                        fact_slice_writer(writers, p, n)
                        if fact_exposed(p) and not fact_own_local(p): exposed_writes.push(n)
                # (an opaque callee writes its place arguments too: fact_call_effects forgets them)
                if opaque: fact_slice_place_arguments(writers, n)
            else if nodes[n].aux != 2 and nodes[n].aux != 3:
                exposed_writes.push(n)
                fact_slice_place_arguments(writers, n)
        else if k == .intrinsic:
            id = nodes[n].aux as IN
            if id == .push or id == .pop or id == .clear or id == .reserve or id == .insert or id == .remove or id == .extend or id == .truncate or id == .resize:
                fact_slice_target(writers, kid(n, 0), n)
                # (as an assignment's: a write to an exposed root, a global or an
                # `@` parameter, may change every other exposed root)
                p = fact_slice_root(kid(n, 0))
                if p.declaration == 0: opaque_writes.push(n)
                else if fact_exposed(p) and not fact_own_local(p): exposed_writes.push(n)
                # (removing needs an element, truncating a nonnegative count)
                if not summary and fact_policy == .RequireStatic and (id == .pop or id == .remove or id == .truncate):
                    active.push(n)
                    values.push(n)
            else if id == .static_assert or id == .runtime_assert or id == .assert or id == .panic or id == .unreachable or id == .lend or id == .loan_length or id == .loan_store: values.push(n)
            else if id != .len and not fact_pure_intrinsic(id): opaque_writes.push(n)
        else if k == .index:
            if not summary and (fact_probe_on or fact_policy == .RequireStatic) and not has_flag(n, NF_INBOUNDS) and fact_bounded_index(n):
                if share: index_demands.push(n)
                if fact_loop_index_local(n) > 0: loop_indexes.push(n)
                active.push(n)
                values.push(int(nodes[n].b))
                if types[fact_type(ntype(int(nodes[n].a)))].kind != .fixed: values.push(int(nodes[n].a))
        else if k == .conv:
            if ff_integer_demand(n): values.push(n)
            if nodes[n].aux == i32(int(CV.refinement)) or nodes[n].aux == i32(int(CV.arr2fixed)): values.push(n)
            # (an `int` narrowed to a fixed width: an obligation, and effect_failure asks whether it fits)
            else if (fact_probe_on or fact_policy == .RequireStatic) and not summary and nodes[n].aux == i32(int(CV.int_)) and prune(ntype(int(nodes[n].a))) == T_MATH_INT and prune(ntype(n)) != T_MATH_INT: values.push(n)
            else if ownership_decls.len() != 0 and nodes[n].aux == i32(int(CV.explicit_copy)) and ownership_fact_type(ntype(n)): opaque_writes.push(n)
            else if nodes[n].aux != i32(int(CV.int_)) and nodes[n].aux != i32(int(CV.none_)) and nodes[n].aux != i32(int(CV.fixed2arr)) and not fact_pure_conversion(n): exposed_writes.push(n)
        else if k == .binary:
            if nodes[n].aux != 0 and not fact_pure_binary(n): exposed_writes.push(n)
            else if not summary and (fact_probe_on or fact_policy == .RequireStatic) and (nodes[n].op == i32(int(Tok.slash)) or nodes[n].op == i32(int(Tok.percent)) or fact_shift_obliged(n)): values.push(n)
        # (a closure writes only when called: fact_capture)
        else if k == .lambda and ownership_decls.len() == 0: pass
        else if k == .lambda or k == .partial and fact_partial_opaque(n) or k == .fnref and fact_handle_opaque(n) or k == .map_lit or k == .cast and not fact_enum_cast(n) and not fact_pointer_cast(n) or mask < 0: opaque_writes.push(n)
        else if k == .str_lit and nodes[n].aux != 0: exposed_writes.push(n)
        if not summary and nd_mutable_signatures.len() != 0 and nd_mutable_handle(n): values.push(n)
    # (a fork closure's creation reads its captures: their definitions)
    loop lam in forks:
        values.push(lam)
        loop cap in fns[int(nodes[lam].sym)].caps:
            o = int(cap.outer)
            if o <= 0: continue
            edge = fact_index_get(writers.heads, fact_root_key(PlaceIdentity(.local, int(locals[o].owner), o)))
            loop edge >= 0:
                definition = writers.nodes[edge]
                edge = writers.next[edge]
                if nodes[definition].kind == .call: active.push(definition)
                else: values.push(definition)
    cursor = 0
    acursor = 0
    any_root = false
    any_exposed = false
    loop cursor < values.len() or acursor < active.len():
        if acursor < active.len():
            n = active[acursor]; acursor += 1
            if n == 0: continue
            mark = fact_mark_of(n)
            if mark & FACT_ACTIVE != 0: continue
            fact_mark_set(n, mark | FACT_ACTIVE)
            edge = fact_mark_parent(n)
            loop edge >= 0:
                active.push(parents.nodes[edge])
                edge = parents.next[edge]
            k = nodes[n].kind
            # A demanded plain alias store still evaluates an indexed route.
            # Its declaration has no runtime initializer left in the body;
            # demand the alias so its selectors and container definitions feed
            # the bounds/membership obligation in fact_store_route. O(1) here,
            # with the existing node-indexed worklist visiting each route once.
            if k == .assign:
                target = int(nodes[n].a)
                if nodes[target].kind == .ident and nodes[target].aux == i32(int(SK.local)):
                    l = int(nodes[target].sym)
                    if int(locals[l].flags) & LF_ALIAS != 0: values.push(target)
            if k == .if_ or k == .while_ or k == .for_ or k == .iflet or k == .match_ or k == .and_ or k == .or_ or k == .coalesce:
                values.push(int(nodes[n].a))
                if k == .match_:
                    loop j in [0..nkids(n)):
                        arm = kid(n, j)
                        loop ki in [0..nkids(arm)): values.push(kid(arm, ki))
            continue
        n = values[cursor]; cursor += 1
        if n == 0: continue
        mark = fact_mark_of(n)
        if mark & FACT_VALUE != 0: continue
        fact_mark_set(n, mark | FACT_VALUE)
        active.push(n)
        k = nodes[n].kind
        if k == .ident:
            p = fact_place(n)
            root = fact_root_key(p)
            if fact_index_get(roots, root) < 0:
                fact_index_put(roots, root, 0)
                edge = fact_index_get(writers.heads, root)
                loop edge >= 0:
                    definition = writers.nodes[edge]
                    edge = writers.next[edge]
                    if nodes[definition].kind == .call: active.push(definition)
                    else: values.push(definition)
            if not any_root:
                any_root = true
                loop w in opaque_writes: values.push(w)
            if not any_exposed and p.declaration != 0 and fact_exposed(p):
                any_exposed = true
                loop write in exposed_writes:
                    if nodes[write].kind == .call: active.push(write)
                    else: values.push(write)
            if nodes[n].aux == i32(int(SK.local)):
                l = int(nodes[n].sym)
                if int(locals[l].flags) & LF_ALIAS != 0 and locals[l].alias != 0: values.push(int(locals[l].alias))
        if k == .block:
            if nkids(n) > 0: values.push(kid(n, nkids(n) - 1))
        else if k == .for_ or k == .while_: values.push(int(nodes[n].a))
        # (a store's check reads the array it stores into)
        else if k == .conv and nodes[n].b != 0 and nodes[n].aux == i32(int(CV.refinement)):
            values.push(int(nodes[n].a))
            values.push(int(nodes[n].b))
        # (a fork closure's creation reads its captures, pushed above, not its body)
        else if k == .lambda: pass
        else if k == .call and fact_nd_call(n) != 0:
            loop j in [0..nkids(n)): values.push(kid(n, j))
        else if k == .call and ntype(n) == T_BOOL and nodes[n].aux == 0 and nodes[n].sym > 0 and fact_predicate_summary(int(nodes[n].sym)) != 0:
            loop j in [0..nkids(n)): values.push(kid(n, j))
        else if k == .call and fact_map_snapshot_call(n): values.push(kid(n, 0))
        else if k == .call and fact_regex_call(n):
            loop j in [0..nkids(n)): values.push(kid(n, j))
        else if k == .call and fact_integer_gcd_call(n):
            loop j in [0..nkids(n)): values.push(kid(n, j))
        # (a length-preserving call's length is its receiver's: `let ks = d.keys` then `ks.values`
        # needs ks's definition)
        else if k == .call and (fact_copy_length_call(n) or fact_endpoint_call(n) != 0 or fact_same_length_call(n) or fact_chosen_call(n)): values.push(kid(n, 0))
        else if k == .call and nodes[n].aux == 0 and not result_active and not proof_active and not fact_divisors.has(n) and not fact_rational_constructor(n) and not fact_rational_promotion(n) and not fact_rational_divmod(n) and fact_floor_call(n) == 0 and fact_string_call(n) == 0 and not fact_extremum_call(n) and not fact_mod_call(n) and not fact_empty_array_call(n) and not fact_entry_count_call(n) and not fact_split_call(n) and not fact_words_call(n) and not fact_lines_call(n) and not fact_search_call(n) and not fact_affix_call(n) and not fact_parallel_array(n) and not ref_refined_result(int(fns[int(nodes[n].sym)].ret)):
            # Ordinary summaries start from unknown formals: their return
            # facts do not depend on the actual values. Argument obligations
            # and effects remain separate roots of this slice.
            ret = fact_type(int(fns[int(nodes[n].sym)].ret))
            constructor = (types[ret].kind == .struct_ or types[ret].kind == .tuple) and fact_constructor_type(ret) and fact_constructor_body(int(nodes[n].sym))
            if constructor: fact_constructor_calls[n] = true
            array_result = tkind(ret) == .array or constructor
            # Array lengths also bound scalar search results. Demand these
            # actuals only for result kinds the summary domain can describe.
            if array_result or fact_scalar(ret) and is_int(ret) and ret != T_U64 or fact_summary_payload(ret) != 0:
                loop j in [0..nkids(n)):
                    arg = kid(n, j)
                    at = fact_type(ntype(arg))
                    if tkind(at) == .array or tkind(at) == .fixed or array_result and fact_scalar(at) and is_int(at) and at != T_U64: values.push(arg)
                    # (a record's array field bounds a scalar result too: fact_summary_fields)
                    else if not array_result and fact_record_arrays(at): values.push(arg)
        else if k == .intrinsic and nodes[n].aux == i32(int(IN.remove)):
            values.push(kid(n, 0))
            values.push(kid(n, 1))
        else if k == .intrinsic and (nodes[n].aux == i32(int(IN.push)) or nodes[n].aux == i32(int(IN.pop)) or nodes[n].aux == i32(int(IN.clear)) or nodes[n].aux == i32(int(IN.reserve)) or nodes[n].aux == i32(int(IN.insert))):
            values.push(kid(n, 0))
            if nodes[n].aux == i32(int(IN.push)) and nkids(n) == 2 and tkind(fact_type(ntype(kid(n, 1)))) == .array: values.push(kid(n, 1))
            # (an integer comprehension's pushes join its element hull)
            if nodes[n].aux == i32(int(IN.push)) and nkids(n) == 2 and accumulators.has(fact_push_receiver(kid(n, 0))) and (fact_scalar(ntype(kid(n, 1))) and is_int(ntype(kid(n, 1))) or fact_int_components(fact_type(ntype(kid(n, 1)))) > 0): values.push(kid(n, 1))
        else if k == .intrinsic and (nodes[n].aux == i32(int(IN.extend)) or nodes[n].aux == i32(int(IN.truncate)) or nodes[n].aux == i32(int(IN.resize)) or nodes[n].aux == i32(int(IN.setlen))):
            values.push(kid(n, 0))
            values.push(kid(n, 1))
        else: fact_slice_push_children(values, n)
    lo = nodes.len()
    hi = -1
    count = 0
    loop n in fact_mark_touched:
        if fact_mark_flags[n] != 0:
            lo = min(lo, n); hi = max(hi, n)
            count += 1
    if hi >= lo and hi - lo < 4 * count + 64:
        flags = fill(0, hi - lo + 1)
        loop n in fact_mark_touched:
            if fact_mark_flags[n] != 0: flags[n - lo] = fact_mark_flags[n]
        fact_slice = FactSlice(flags, probe_only, lo, carried, rows)
    else:
        flags = fact_index_sized(count)
        loop n in fact_mark_touched:
            if fact_mark_flags[n] != 0: fact_index_put(flags, n, fact_mark_flags[n])
        fact_slice = FactSlice(flags, probe_only, carried = carried, rows = rows)
    fact_plan_serial += 1
    fact_slice.plan = fact_plan_serial
    fact_slice.callees = callees
    fact_slice.versions = versions
    fact_slice.exact_demands = exact_demands
    fact_slice.index_demands = index_demands
    loop m in loop_indexes:
        x = fact_loop_index_local(m)
        if plain_writes.has(x) and not stepped_writes.has(x): fact_slice.loop_indexes.push(m)
    if share: fact_slice.float_context = dir_floats_any or ff_conversions.has(fact_owner)
    # (a plan that walks only member templates serves only the shared decide run)
    if not members or fact_member_admitted.len() == 0: fact_slice_cache[key] = fact_slice

# Inline scalar callbacks receive the hull of the evaluated array snapshot.
# Only this call owns that lambda; named/reused callbacks get no special facts.
# O(projections of the demanded source), using the existing hull/inventory index.
fact_name_parallel_arrays: int[]

# `xs.sorted(key=(i) => -rank[i])`: the library's key callbacks (sorted,
# sort, min_by, max_by, group_by and their _by spellings) are called with
# elements of the evaluated receiver only. An inline integer callback owned
# by the call starts from those elements' hull and their bound below a value
# (FACT_ELEMENT_BELOW), related to its snapshot captures (fact_fork_record).
# The literal lambda argument, or 0. O(1).
fact_key_names: int[]

# Whether a body holds something the facts pass decides: an index or slice,
# a division, a refinement or narrowing, an assertion, a loan, a string
# position. A syntactic walk of every operand (a place's route included), so
# it cannot miss what the transfer would visit. O(body nodes).
fact_obligation_node = (n: int) -> bool:
    k = nodes[n].kind
    if nd_mutable_signatures.len() != 0 and nd_mutable_handle(n): return true
    if k == .index: return not has_flag(n, NF_INBOUNDS) and fact_bounded_index(n)
    if k == .binary:
        if nodes[n].aux == 0 and (nodes[n].op == i32(int(Tok.slash)) or nodes[n].op == i32(int(Tok.percent))) and is_int(ntype(int(nodes[n].b))) and not fact_literal_nonzero(int(nodes[n].b)): return true
        return fact_shift_obliged(n)
    if k == .assign: return fact_shift_obliged(n)
    if k == .for_: return fact_stepped_loop(n) or fact_open_range(n)
    if k == .conv:
        if ff_integer_demand(n): return true
        if exact_has_store(n) and not exact_decided(n) or nodes[n].aux == i32(int(CV.refinement)) or nodes[n].aux == i32(int(CV.arr2fixed)): return true
        return nodes[n].aux == i32(int(CV.int_)) and prune(ntype(int(nodes[n].a))) == T_MATH_INT and prune(ntype(n)) != T_MATH_INT
    if k == .call:
        if wi_fact_calls.has(n) or fact_divisors.has(n) or fact_range_call(n) or nd_mutable_call(n) or fact_rational_constructor(n) and not fact_literal_nonzero(kid(n, 1)) or fact_rational_divmod(n): return true
        if (fact_floor_call(n) != 0 and not fact_literal_nonzero(kid(n, 1))) or fact_string_call(n) >= 2 or fact_array_call(n) != 0 or fact_power_call(n): return true
        map = fact_map_call(n)
        if map >= 2 and map <= 4 or fact_nonempty_call(n) or fact_exact_sum_call(n) or fact_gpu_index_call(n): return true
        pool = fact_pool_call(n)
        if pool >= 2 and pool <= 4: return true
        # A fork closure's obligations start from its creator's facts.
        if dir_assumed_bounds_any and fact_parallel_range_call(n): return true
        if fact_library_call(n, "parallel_range") or fact_library_call(n, "parallel_map") or fact_parallel_array(n):
            loop i in [0..nkids(n)):
                arg = kid(n, i)
                if nodes[arg].kind == .lambda:
                    fact_panic_collect = false
                    if fact_obliged(int(nodes[arg].b)): return true
        # (and so do a key callback's: fact_key_callback)
        key = fact_key_callback(n)
        if key > 0:
            fact_panic_collect = false
            if fact_obliged(int(nodes[key].b)): return true
        return false
    if k == .intrinsic:
        id = nodes[n].aux as IN
        return id == .static_assert or id == .runtime_assert or id == .assert or nodes[n].aux2 == i32(RANGE_EXHAUSTION) or id == .lend or id == .loan_length or id == .loan_store or id == .loan_address or id == .loan_load or id == .pop or id == .remove or id == .truncate
    false

fact_obliged = (n: int) -> bool:
    if n <= 0 or n >= nodes.len(): return false
    k = nodes[n].kind
    if fact_panic_collect:
        if k == .parallel_region: fact_panic_collect = false
        else if k == .intrinsic or k == .call or k == .fnref or k == .lambda or k == .pair or k == .partial or k == .binary and nodes[n].aux == 1: fact_panic_pending.push(n)
    if k == .lambda: return nd_mutable_handle(n)
    if k == .ident:
        if nodes[n].aux == i32(int(SK.local)):
            l = int(nodes[n].sym)
            if l > 0 and int(locals[l].flags) & LF_ALIAS != 0 and locals[l].alias != 0:
                fact_panic_collect = false
                return fact_obliged(int(locals[l].alias))
        return false
    mask = isolation_children(k)
    if mask == 0: return false
    # A finite lowering width is required even when runtime checks are allowed.
    if n < exact_marks.len() and exact_marks[n] & 128 != 0: return true
    if fact_obligation_node(n):
        policy = dir_policy(nodes[n].pos)
        if policy == DIR_STATIC or policy == DIR_PROTOTYPE or dir_obligations or ide_on or dir_forced: return true
        fact_has_deferred = true
    if mask < 0: mask = 7 | 16 | 32
    if mask & 1 != 0 and fact_obliged(int(nodes[n].a)): return true
    if mask & 2 != 0 and fact_obliged(int(nodes[n].b)): return true
    if mask & 4 != 0 and fact_obliged(int(nodes[n].c)): return true
    if mask & 16 != 0:
        loop j in [0..nkids(n)):
            child = kid(n, j)
            if fact_obliged(child): return true
    if mask & 32 != 0:
        loop i in [0..nkids2(n)):
            if fact_obliged(kid2(n, i)): return true
    false

fact_capture = (n: int, s: mut FactState) -> int:
    marks = if n > 0 and n < exact_marks.len(): int(exact_marks[n]) else: 0
    if marks & 67 == 0:
        value = fact_capture_value(n, s)
        if n > 0 and fact_speculating == 0 and (fact_owner < exact_rep_owners.len() and exact_rep_owners[fact_owner]) and prune(ntype(n)) == T_MATH_INT: exact_value_fact(n, value, s)
        return value
    if n > 0 and nodes[n].kind == .intrinsic and nodes[n].aux == i32(int(IN.fixed_abs)):
        value = fact_capture(kid(n, 0), s)
        b = fact_bound(s, value)
        if not b.wide and b.lo >= 0: return value
        if not b.wide and b.lo > FACT_MIN:
            hi = max(-b.lo, b.hi)
            lo = if b.hi < 0: -b.hi else: 0
            return fact_new(s, FactBound(lo, hi), FactTerm(type = ntype(n)))
        return fact_unmodeled(s, n, .unsupported)
    if n > 0 and exact_has_node(n) and nodes[n].kind == .binary and nodes[n].op == i32(int(Tok.starstar)):
        fact_capture(int(nodes[n].a), s)
        exponent = fact_capture(int(nodes[n].b), s)
        exact_shift_fact(n, exponent, s)
        return fact_unmodeled(s, n, .unsupported)
    if marks & 64 != 0:
        value = fact_capture(int(nodes[n].a), s)
        if ff_integer_demand(n): ff_integer_record(n, value, s)
        return fact_new(s, fact_domain(ntype(n)), FactTerm(type = ntype(n)))
    if n > 0 and exact_has_store(n): return exact_fact_store(n, fact_capture(int(nodes[n].a), s), s)
    value = fact_capture_value(n, s)
    if n > 0 and fact_speculating == 0 and (exact_has_node(n) or (fact_owner < exact_rep_owners.len() and exact_rep_owners[fact_owner]) and prune(ntype(n)) == T_MATH_INT): exact_value_fact(n, value, s)
    value

fact_literal = (s: mut FactState, n: int) -> int:
    if not fact_scalar(ntype(n)): return fact_new(s, FactBound(reason = .unsupported, witness = n))
    x = ref_encoded(nodes[n].ival, ntype(n))
    # A uint64 constant is biased; its type lets a witness decode it.
    if fact_type(ntype(n)) == T_U64: return fact_new(s, FactBound(x, x, x != 0), FactTerm(origin = n, type = T_U64))
    # An `int` literal above int64 is positive, with an open upper end.
    # Keep its origin for uint64 guards; never claim a finite host endpoint.
    if has_flag(n, NF_U64) and x < 0: return fact_new(s, FactBound(1, FACT_MAX, true), FactTerm(origin = n, type = T_MATH_INT))
    fact_constant(s, x, n)

# A final body walk can prove a branch unreachable (including a generated
# broadcast alternative). Its refinement checks need no evidence-free retry.
# Do not publish this during speculation, summaries or probes, and never walk
# into a nested function. Indexed visits cost O(nodes in demanded dead paths).
fact_dead_refinements: {int: bool}

# Explicit string membership is one boolean projection of the captured value.
# Keep it across joins without approximating a finite text set by an interval.
# Only narrowing proofs consume it: O(1) indexed state, O(members)
# comparisons at an unproved test, and no extra body walk.
fact_string_set = (n: int, s: mut FactState) -> int:
    test_info = string_set_tests[n]
    source = fact_capture(test_info.0, s)
    selector = -1073741824 - test_info.1
    old = fact_projection_find(s, source, selector, false)
    if old >= 0: return s.projections[old].value
    # Evaluate the ordinary comparisons when no matching guard is held. This
    # preserves equality/disjunction proofs, while explicit type guards share
    # their captured membership value through joins.
    string_set_tests.remove(n)
    value = fact_capture(n, s)
    string_set_tests[n] = test_info
    if source != 0 and s.projections.len() < FACT_CAP: fact_add_projection(s, FactProjection(source, selector, false, value))
    value

fact_capture_value = (n: int, s: mut FactState) -> int:
    if n == 0: return 0
    if not s.live:
        if refine_owners.len() > 0: fact_refinements_unreachable(n)
        return 0
    if fact_speculating > 0:
        if fact_constructor_budget >= 0:
            if fact_constructor_budget == 0:
                fact_loop_exhausted = true
                return 0
            fact_constructor_budget -= 1
        fact_loop_steps += 1
        if fact_loop_steps > fact_step_limit:
            fact_loop_exhausted = true
            return 0
    mark = fact_slice_flags(n)
    if mark & FACT_MEMBER != 0:
        if mark & FACT_ACTIVE == 0: return 0
        k = nodes[n].kind
        control = k == .index or k == .block or k == .if_ or k == .iflet or k == .match_ or k == .while_ or k == .for_ or k == .return_ or k == .break_ or k == .continue_ or k == .and_ or k == .or_ or k == .coalesce
        if not control and mark & FACT_VALUE == 0: return fact_slice_capture(n, s)
    k = nodes[n].kind
    if (k == .call or k == .conv) and rational_constants.len() > 0:
        if let fraction = rational_constants.get(n):
            value = fact_new(s, FactBound(), FactTerm(type = ntype(n)))
            if s.projections.len() + 2 < FACT_CAP:
                fact_add_projection(s, FactProjection(value, intern("numerator"), false, fact_constant(s, fraction.0)))
                fact_add_projection(s, FactProjection(value, intern("denominator"), false, fact_constant(s, fraction.1)))
            return value
    if k == .block and has_flag(n, NF_COMPREHENSION) and nkids(n) > 1 and nodes[kid(n, 0)].kind == .vardecl:
        fact_comprehensions[kid(n, 1)] = int(nodes[kid(n, 0)].sym)
        # (this evaluation's source only: fact_map_of)
        if fact_comprehension_sources.len() > 0: fact_comprehension_sources.remove(kid(n, 1))
    if k == .dotname and tkind(ntype(n)) == .enum_ and simple_enum(ntype(n)):
        si = int(types[prune(ntype(n))].st)
        return fact_constant(s, variants[int(structs[si].variants) + int(nodes[n].aux)].value, n)
    if k == .int_lit or k == .bool_lit:
        loop shared in fact_shared_literals:
            if shared.0 == n and fact_slot(s, shared.1) >= 0: return shared.1
        return fact_literal(s, n)
    if k == .str_lit and fact_member_template >= 0 and fact_member_literal(n): return fact_new(s, FactBound(), FactTerm(type = T_STR))
    # (an ASCII string literal's length is its byte count; "\r\n" is one grapheme)
    if k == .str_lit and nodes[n].aux != 1 and fact_type(ntype(n)) == T_STR and nodes[n].sval >= 0:
        text = name_of(int(nodes[n].sval))
        ascii = true
        loop c in text:
            if c >= 128 or c == 13: ascii = false
        if ascii:
            origin = if string_set_owners.len() > 0 and string_set_owners.has(fact_owner): n else: 0
            value = fact_new(s, FactBound(), FactTerm(origin = origin, type = T_STR))
            # (and its byte view's: `"abc" as array<uint8>` has 3 elements)
            if s.projections.len() + 4 < FACT_CAP:
                fact_add_projection(s, FactProjection(value, FACT_ASCII_TEXT, false, fact_constant(s, 1)))
                count = fact_constant(s, len(text))
                fact_add_projection(s, FactProjection(value, -1, false, count))
                fact_add_projection(s, FactProjection(fact_byte_view(s, value), -1, false, count))
            return value
        # (another is one value too, so guards on its byte view reach `byte_slice`)
        if nodes[n].aux == 0 and nkids(n) == 0: return fact_new(s, FactBound(), FactTerm(origin = n, type = T_STR))
    # An optional's or union's tag (-3: 0 for none, 1 for a value, or the
    # member) and payload (-4) are projections of its immutable evaluation.
    if k == .istype:
        value = fact_capture(int(nodes[n].a), s)
        if nodes[n].aux == -3: return fact_constant(s, 1)
        tag = fact_project(s, value, -3, false, T_INT)
        wanted = if nodes[n].aux >= 0: int(nodes[n].aux) else if nodes[n].aux == -2: 1 else: 0
        other = fact_constant(s, wanted)
        return fact_new(s, fact_domain(T_BOOL), FactTerm(.eq, tag, other))
    if k == .narrow or k == .unwrap:
        value = fact_capture(int(nodes[n].a), s)
        return fact_project(s, value, -4, false, ntype(n))
    if k == .ident: return fact_read(s, n)
    if k == .field and (nodes[n].aux >= 0 and tkind(ntype(int(nodes[n].a))) == .struct_ or nodes[n].aux == -2 and tkind(ntype(int(nodes[n].a))) == .tuple):
        base = fact_capture(int(nodes[n].a), s)
        selector = if nodes[n].aux == -2: int(nodes[n].ival) else: int(nodes[n].name)
        stored = refine_storage(n, ntype(n))
        held = fact_project(s, base, selector, false, stored)
        if ref_self_active:
            ref_self_place_read(n, held, s)
            # (a field a call or a sibling's store kept: the record holds its bound again)
            if not fact_pair_transient and ref_sib_contract(stored): ref_assume(stored, held, fact_field_args(s, base), s)
        return held
    if k == .tuple:
        value = fact_new(s, FactBound(), FactTerm(type = ntype(n)))
        loop i in [0..nkids(n)):
            v = fact_capture(kid(n, i), s)
            if s.projections.len() < FACT_CAP: fact_add_projection(s, FactProjection(value, i, false, v))
        return value
    # A slice reads its source, then its bounds, and has their difference as
    # its length: 0 <=? lo <=? hi <=? length (an inclusive end is hi+1).
    if k == .index and nodes[n].aux == 1 and nodes[nodes[n].b].kind == .range and not has_flag(int(nodes[n].b), NF_STEP):
        r = int(nodes[n].b)
        base = fact_capture(int(nodes[n].a), s)
        t = fact_type(ntype(int(nodes[n].a)))
        if types[t].kind != .array and types[t].kind != .fixed: return fact_unmodeled(s, n, .unsupported)
        length = if types[t].kind == .fixed: fact_constant(s, fixed_len(t)) else: fact_project(s, base, -1, false, T_INT)
        lo = if nodes[r].a != 0: fact_capture(int(nodes[r].a), s) else: fact_constant(s, 0)
        hi = length
        if nodes[r].b != 0:
            hi = fact_capture(int(nodes[r].b), s)
            if has_flag(r, NF_INCLUSIVE): hi = fact_arithmetic(s, int(nodes[r].b), .plus, hi, fact_constant(s, 1))
        if fact_speculating == 0 and (fact_policy == .RequireStatic or fact_query or fact_probe_on):
            zero = fact_constant(s, 0)
            checks = [fact_compare(s, .le, zero, lo), fact_compare(s, .le, lo, hi), fact_compare(s, .le, hi, length)]
            # (a probe records its answer: never a report)
            if fact_probe_on: fact_probe_record(n, checks[0] == 1 and checks[1] == 1 and checks[2] == 1)
            else if checks[0] != 1 or checks[1] != 1 or checks[2] != 1: wit_slice(n, s, lo, hi, length, checks)
        value = fact_new(s, FactBound(), FactTerm(type = ntype(n)))
        size = length
        if nodes[r].a != 0 or nodes[r].b != 0: size = fact_arithmetic(s, (if nodes[r].b != 0: int(nodes[r].b) else: int(nodes[r].a)), .minus, hi, lo)
        if s.projections.len() < FACT_CAP: fact_add_projection(s, FactProjection(value, -1, false, size))
        if ownership_decls.len() == 0 or not ownership_fact_type(ntype(n)): fact_slice_elements(s, base, value, lo, hi)
        return value
    if k == .index and nodes[n].b != 0:
        base = 0
        index = 0
        # (an `int` index's narrowing is the index's own obligation: in bounds, it fits)
        outer = fact_covered
        kind = types[representation_type(ntype(int(nodes[n].a)))].kind
        fact_covered = if kind == .array or kind == .fixed: int(nodes[n].b) else: 0
        if nodes[int(nodes[n].a)].kind == .ident:
            index = fact_capture(int(nodes[n].b), s)
            base = fact_capture(int(nodes[n].a), s)
        else:
            base = fact_capture(int(nodes[n].a), s)
            index = fact_capture(int(nodes[n].b), s)
        fact_covered = outer
        if fact_route_call != 0: fact_route_selectors[n] = (fact_route_call, index)
        t = fact_type(ntype(int(nodes[n].a)))
        if types[t].kind == .array or types[t].kind == .fixed:
            length = if types[t].kind == .fixed: fact_constant(s, fixed_len(t)) else: fact_project(s, base, -1, false, T_INT)
            if fact_speculating == 0 and fact_probe_on and fact_policy != .RequireStatic: fact_probe_index(n, s, index, length)
            # (an index the compiler generated in bounds, as an elementwise loop's reads)
            else if fact_speculating == 0 and (fact_policy == .RequireStatic or fact_query) and not has_flag(n, NF_INBOUNDS):
                zero = fact_constant(s, 0)
                lo = fact_compare(s, .le, zero, index)
                hi = fact_compare(s, .lt, index, length)
                if fact_probe_on: fact_probe_record(n, lo == 1 and hi == 1)
                else:
                    dir_index(n, lo == 1 and hi == 1)
                    if lo != 1 or hi != 1: wit_index(n, s, index, length, lo, hi)
                if lo != 1 or hi != 1: fact_index_success(n, s, index, length)
            return fact_keys_element(s, base, fact_project(s, base, index, true, int(types[t].elem)))
        return fact_unmodeled(s, n, .unsupported)
    # `fill(x n)`, an array of n copies (none when n is negative): the value,
    # then the count, which is the length.
    if k == .array and nodes[n].b != 0 and nkids(n) == 1 and tkind(fact_type(ntype(n))) == .array:
        element = fact_capture(kid(n, 0), s)
        count = fact_capture(int(nodes[n].b), s)
        value = fact_new(s, FactBound(), FactTerm(type = ntype(n)))
        c = fact_bound(s, count)
        # (the length is max(0, n): n itself whenever n is nonnegative, as
        # the allocation succeeded)
        size = if c.lo < 0 or c.hi > fact_length_max(): fact_clamped(s, count, n) else: count
        if s.projections.len() < FACT_CAP: fact_add_projection(s, FactProjection(value, -1, false, size))
        if value != 0 and element != 0 and (ownership_decls.len() == 0 or not ownership_fact_type(ntype(n))) and s.projections.len() < FACT_CAP:
            fact_add_projection(s, FactProjection(value, FACT_ELEMENT_COPY, false, element))
        return value
    if k == .array and nodes[n].aux == 0:
        value = fact_new(s, FactBound(), FactTerm(type = ntype(n)))
        loop i in [0..nkids(n)):
            v = fact_capture(kid(n, i), s)
            if s.projections.len() < FACT_CAP: fact_add_projection(s, FactProjection(value, fact_constant(s, i), true, v))
        if s.projections.len() < FACT_CAP: fact_add_projection(s, FactProjection(value, -1, false, fact_constant(s, nkids(n))))
        return value
    if k == .map_lit:
        kt = struct_targ(int(types[fact_type(ntype(n))].st), 0)
        if (fact_scalar(kt) or kt == T_STR) and (ownership_decls.len() == 0 or not ownership_fact_type(ntype(n))):
            keys: int[]
            raw: int[]
            payloads: int[]
            loop j in [0..nkids(n)):
                pair = kid(n, j)
                e = int(nodes[pair].a)
                key = fact_capture(e, s)
                keys.push(fact_map_key(s, e, key))
                raw.push(key)
                payloads.push(fact_capture(int(nodes[pair].b), s))
            value = fact_new(s, FactBound(), FactTerm(type = ntype(n)))
            loop key in keys:
                if s.projections.len() < FACT_CAP: fact_add_projection(s, FactProjection(value, key, true, fact_constant(s, 1)))
            # (`[]` has no entries: a sibling bound on a dictionary's values holds of it)
            if keys.len() == 0 and ref_self_active and s.projections.len() < FACT_CAP: fact_add_projection(s, FactProjection(value, -1, false, fact_constant(s, 0)))
            fact_map_literal(n, s, value, keys, raw, payloads)
            return value
    # (a summary's `none` too: an optional result's present arm excludes it)
    if k == .none_lit and (result_active or fact_summary_owner != 0 or fact_summary_payload(fact_type(ntype(n))) != 0):
        value = fact_new(s, FactBound(), FactTerm(type = ntype(n)))
        fact_add_projection(s, FactProjection(value, -3, false, fact_constant(s, 0)))
        return value
    if k == .str_lit and nodes[n].aux == 0 or k == .float_lit or k == .none_lit or k == .null_lit or k == .dotname: return 0
    if k == .str_lit:
        # Interpolation evaluates each part in order, then calls its formatter,
        # which (like any opaque call) may write exposed roots; a builtin
        # number's, boolean's or string's writes nothing.
        loop j in [0..nkids(n)):
            part = kid(n, j)
            if nodes[part].kind != .pair: continue
            fact_capture(int(nodes[part].a), s)
            if not fact_builtin_formatter(part): fact_forget(s, part, .call)
        return fact_new(s, FactBound(reason = .unsupported, witness = n))
    if k == .addr or k == .parallel_region: return fact_capture(int(nodes[n].a), s)
    # Creating a closure evaluates nothing (defaults are the actuals of its
    # calls) and writes nothing: its body runs only when called, and every
    # call that can reach it, indirect or through a callee's summary, forgets
    # what the body may write. (Ownership may move captures: still opaque.)
    if nd_mutable_signatures.len() != 0 and nd_mutable_handle(n): fact_nd_need(n, s, .eq, fact_fresh(s, T_INT), fact_constant(s, 1), "function handle checks its mutable shaped parameters on entry")
    if k == .lambda and fact_speculating == 0 and fact_fork_nodes.has(n): fact_fork_record(n, s)
    if k == .lambda and ownership_decls.len() == 0: return 0
    # (a partial application evaluates its arguments, holes aside, and saves
    # them, and a handle its closure value: the values its calls read; those
    # calls forget what the function may write)
    if k == .lambda or k == .fnref or k == .partial:
        fact_capture(int(nodes[n].a), s)
        loop j in [0..nkids(n)): fact_capture(kid(n, j), s)
        if k == .lambda or k == .partial and fact_partial_opaque(n) or k == .fnref and fact_handle_opaque(n): fact_forget(s, n, .call, k == .partial and fact_partial_place(n))
        return 0
    if k == .unary:
        a = fact_capture(int(nodes[n].a), s)
        if nodes[n].op == i32(int(Tok.minus)) and fact_scalar(ntype(n)):
            return fact_arithmetic(s, n, .minus, fact_constant(s, 0), a)
        return fact_unmodeled(s, n, .unsupported)
    if k == .exprstmt: return fact_capture(int(nodes[n].a), s)
    if k == .block:
        if fact_member_shared and nkids(n) > 1 and fact_member_block(n, s): return 0
        r = 0
        defers: int[]
        pending = fact_pending_defers
        first = s.bindings.len()
        boundary = fact_terms.len()
        collect_at = max(32, s.ids.len() * 2)
        long_block = nkids(n) > 32
        loop j in [0..nkids(n)):
            c = kid(n, j)
            if nodes[c].kind == .defer_:
                defers.push(int(nodes[c].a))
                fact_pending_defers += 1
            else if ref_pair_stmts.len() > 0 and ref_pair_stmts.has(c):
                # (a statement of a run changing tied fields: the record's contract may not hold)

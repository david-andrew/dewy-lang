            selected = fact_terms.len()
            fact_terms.push(FactTerm(type = fact_hull_type(ntype(n), paths.yes, y, paths.no, z)))
            fact_add_value(paths.yes, selected, fact_bound(paths.yes, y))
            fact_add_value(paths.no, selected, fact_bound(paths.no, z))
        if selected != 0:
            fact_selected(paths.yes, selected, y, n)
            fact_selected(paths.no, selected, z, n)
            s = fact_join(paths.yes, paths.no, n)
            fact_selected_rows(s, paths.yes, paths.no, selected)
            fact_selected_rows(s, paths.no, paths.yes, selected)
            return selected
        result = fact_hull(fact_bound(paths.yes, y), fact_bound(paths.no, z), n)
        hull = fact_hull_type(ntype(n), paths.yes, y, paths.no, z)
        if not paths.yes.live: result = fact_bound(paths.no, z); hull = fact_terms[z].type
        if not paths.no.live: result = fact_bound(paths.yes, y); hull = fact_terms[y].type
        if fact_summary_field != 0 and type_eq(fact_type(ntype(n)), fact_type(int(fns[fact_summary_owner].ret))):

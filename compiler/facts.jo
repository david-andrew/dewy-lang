            entry = values
            loop i in [0..values.len()):
                if i < fns[f].params.len() and int(locals[fns[f].params[i]].flags) & LF_MUTPARAM != 0: values[i] = fact_after_call(n, kid(n, i), s)
            ref_assume(int(fns[f].ret), result, values, s)
            ref_arm_publish(f, result, values, s)
            if fact_search_call(n): fact_search_result(n, result, entry, s)
            if nkids(n) == 1 or nkids(n) == 3: fact_regex_search_result(n, result, entry, s)
            if result_active: result_publish(f, result, values, s)
            # (reviewed prelude contracts: `parallel_range(n f)` has max(0, n)
            # results, `parallel_map(xs f)` one per element)
            if nkids(n) == 2 and tkind(fact_type(ntype(n))) == .array:
                if fact_library_call(n, "parallel_range") and fact_scalar(ntype(kid(n, 0))):
                    fact_add_projection(s, FactProjection(result, -1, false, fact_clamped(s, entry[0], n)))
                else if fact_library_call(n, "parallel_map") and tkind(fact_type(ntype(kid(n, 0)))) == .array:
                    fact_add_projection(s, FactProjection(result, -1, false, fact_project(s, entry[0], -1, false, T_INT)))
            if fact_copy_length_call(n) and s.projections.len() < FACT_CAP:
                fact_add_projection(s, FactProjection(result, -1, false, fact_project(s, entry[0], -1, false, T_INT)))
                fact_keys_copy(s, entry[0], result)
                fact_permuted_elements(s, entry[0], result)
            if fact_words_call(n) and s.projections.len() < FACT_CAP:
                fact_add_projection(s, FactProjection(result, FACT_ELEMENT_LENGTH, false, fact_new(s, FactBound(1, fact_length_max()))))
            if fact_lines_call(n):
                source_length = fact_project(s, entry[0], -1, false, T_INT)
                source = fact_bound(s, source_length)
                length = fact_project(s, result, -1, false, T_INT)
                bound = fact_bound(s, length)
                if source.lo > 0: bound.lo = max(1, bound.lo)
                if source.hi == 0: bound.hi = 0
                fact_set_bound(s, length, bound)
            if fact_split_call(n):
                separator = fact_project(s, entry[1], -1, false, T_INT)
                if fact_bound(s, separator).lo > 0:
                    length = fact_project(s, result, -1, false, T_INT)
                    bound = fact_bound(s, length)
                    bound.lo = max(1, bound.lo)
                    fact_set_bound(s, length, bound)
            counted = fact_count_call(n)
            if counted:
                length = fact_project(s, entry[0], -1, false, T_INT)
                fact_set_bound(s, result, FactBound(0, fact_bound(s, length).hi))
                fact_difference(s, result, length, 0, n)
            summary = if counted: FactSummary() else: fact_summary(f)
            if summary.seen:
                fact_summary_kept_upper(n, f, entry, summary, s)
                payload = fact_summary_payload(fact_type(int(fns[f].ret)))
                if payload != 0: fact_summary_payload_publish(f, result, entry, payload, summary, s)
                else if tkind(fact_type(int(fns[f].ret))) == .array:
                    length = fact_project(s, result, -1, false, T_INT)
                    b = fact_bound(s, length)
                    fact_set_bound(s, length, FactBound(max(b.lo, summary.length.lo), min(b.hi, summary.length.hi)))
                    if summary.same >= 0 and summary.same < entry.len():
                        at = fact_type(ntype(kid(n, summary.same)))
                        other = if tkind(at) == .fixed: fact_constant(s, fixed_len(at)) else if fact_scalar(at): fact_clamped(s, entry[summary.same], n) else: fact_project(s, entry[summary.same], -1, false, T_INT)
                        fact_difference(s, length, other, summary.delta, n)
                        fact_difference(s, other, length, -summary.delta, n)
                        o = fact_bound(s, other)
                        b = fact_bound(s, length)
                        lo = if o.lo >= 0 and fact_add_fits(o.lo, summary.delta): max(b.lo, o.lo + summary.delta) else: b.lo
                        hi = if o.hi <= fact_length_max() and fact_add_fits(o.hi, summary.delta): min(b.hi, o.hi + summary.delta) else: b.hi
                        fact_set_bound(s, length, FactBound(lo, hi))
                else:
                    b = fact_bound(s, result)
                    fact_set_bound(s, result, FactBound(max(b.lo, summary.value.lo), min(b.hi, summary.value.hi), b.nz or summary.value.nz))
                    if summary.host and result != 0: fact_terms[result].type = T_INT
                    if summary.upper >= 0 and summary.upper < entry.len():
                        other = fact_summary_length(s, entry[summary.upper], summary.upper_field, f, summary.upper)
                        fact_difference(s, result, other, summary.upper_delta, n)
                    if summary.global_post > 0:
                        # Effects have run. Relate to this exit snapshot only;
                        # subsequent writes invalidate it by ordinary routing.
                        g = summary.global_post
                        place = PlaceIdentity(.global, 0, g)
                        binding_index = fact_binding(s, place)
                        after = 0
                        if binding_index >= 0: after = s.bindings[binding_index].value
                        else:
                            after = fact_new(s, FactBound(), FactTerm(type = int(globals[g].type)))
                            fact_bind(s, place, after)
                        fact_difference(s, result, fact_project(s, after, -1, false, T_INT), -1, n)
                    if summary.post >= 0:
                        after = fact_summary_actual(n, summary.post, s)
                        if after != 0:
                            length = fact_summary_length(s, after, summary.post_field, f, summary.post)
                            fact_difference(s, result, length, -1, n)
        else if nodes[n].aux == 1:
            ft = prune(ntype(int(nodes[n].a)))
            if types[ft].kind == .fn_: ref_assume(int(types[ft].elem), result, values, s)
        return result
    if k == .coalesce or k == .iflet:
        # The value path knows the tag and binds the payload; the other path
        # knows none. Each path's own writes invalidate as anywhere else.
        value = fact_capture(int(nodes[n].a), s)
        yes = s
        fact_tag(yes, value, 1, true)
        fact_tag(s, value, 1, false)
        y = 0
        if k == .coalesce:
            # The present arm retains the optional's payload contract even if
            # the fallback widens the expression's result type. O(1), demanded
            # only while transferring this coalesce; no extra body walk.
            optional = fact_type(ntype(int(nodes[n].a)))
            payload = if tkind(optional) == .opt: telem(optional) else: ntype(n)
            y = if nodes[n].aux == 1: value else: fact_project(yes, value, -4, false, payload)
        else:
            l = int(nodes[n].sym)
            if l != 0: fact_bind(yes, PlaceIdentity(.local, int(locals[l].owner), l), fact_project(yes, value, -4, false, int(locals[l].type)))
            y = fact_capture(int(nodes[n].b), yes)
        z = fact_capture((if k == .coalesce: int(nodes[n].b) else: int(nodes[n].c)), s)
        result = fact_hull(fact_bound(yes, y), fact_bound(s, z), n)
        hull = fact_hull_type(ntype(n), yes, y, s, z)
        if not yes.live: result = fact_bound(s, z); hull = fact_terms[z].type
        if not s.live: result = fact_bound(yes, y); hull = fact_terms[y].type
        no = s
        s = fact_join(yes, no, n)
        # (an owned binding ends here; its hook may write exposed storage)
        if k == .iflet and ownership_fact_cleanup and s.live and ownership_fact_type(ntype(int(nodes[n].a))): fact_drop_forget(s, n, fact_drop_footprint(ntype(int(nodes[n].a))))
        joined = fact_new(s, result, FactTerm(type = hull))
        if mark & FACT_VALUE != 0: fact_join_length(s, joined, yes, y, no, z, n)
        return joined
    if k == .map_lit:
        # (each entry is inserted by a call: an unknown callee's effects)
        keys: (int, int)[]
        loop j in [0..nkids(n)):
            p = kid(n, j)
            keys.push((int(nodes[p].a), fact_capture(int(nodes[p].a), s)))
            fact_capture(int(nodes[p].b), s)
            fact_forget(s, n, .call)
        result = fact_fresh(s, ntype(n))
        # (every key written is in it: fact_map_check)
        if is_map_type(representation_type(ntype(n))):
            loop key in keys: fact_assume(s, fact_project(s, result, fact_map_key(s, key.0, key.1), true, T_BOOL), true)
        return result
    if k == .match_:
        # Arms are tried in order: each sees its predecessors' pattern
        # operands and failed tags, and a matched arm knows its tag.
        subject = int(nodes[n].a)
        value = fact_capture(subject, s)
        hidden = int(nodes[n].sym)
        if hidden != 0: fact_bind(s, PlaceIdentity(.local, int(locals[hidden].owner), hidden), value)
        exits = FactState(live = false)
        result = FactBound()
        first = true
        loop j in [0..nkids(n)):
            arm = kid(n, j)
            wild = false
            low = 0
            high = 0
            loop ki in [0..nkids(arm)):
                p = kid(arm, ki)
                if nodes[p].kind == .pwild: wild = true
                if nodes[p].kind == .plit or nodes[p].kind == .prange: low = fact_capture(int(nodes[p].a), s)
                if nodes[p].kind == .prange: high = fact_capture(int(nodes[p].b), s)
            path = s
            # (a range arm, as a guard `k:int64<0 <=? k <? 3>` becomes: its bounds hold in the body)
            if nkids(arm) == 1 and nodes[kid(arm, 0)].kind == .prange and fact_scalar(ntype(subject)) and is_int(fact_type(ntype(subject))) and types[fact_type(ntype(subject))].sign:
                fact_assume(path, fact_new(path, fact_domain(T_BOOL), FactTerm(.le, low, value)), true)
                upper = if has_flag(kid(arm, 0), NF_INCLUSIVE): Tok.le else: Tok.lt
                fact_assume(path, fact_new(path, fact_domain(T_BOOL), FactTerm(upper, value, high)), true)
            wanted = if nkids(arm) == 1: fact_pattern_tag(kid(arm, 0), prune(ntype(subject))) else: -1
            if wanted >= 0:
                fact_tag(path, value, wanted, true)
                # (a literal can fail on its own member)
                if nodes[kid(arm, 0)].kind != .plit or not is_union(prune(ntype(subject))): fact_tag(s, value, wanted, false)
            r = fact_capture(int(nodes[arm].b), path)
            if path.live:
                result = if first: fact_bound(path, r) else: fact_hull(result, fact_bound(path, r), n)
                first = false
            exits = fact_join(exits, path, n)
            if wild: s.live = false
        # Without a value, no arm matching falls through; with one, it panics.
        valued = not has_flag(n, NF_STMT) and vc(ntype(n)) != VC_VOID and ntype(n) != T_NEVER
        if not valued: exits = fact_join(exits, s, n)
        s = exits
        # (an arm's owned binding, or the subject the match owns, ends here)
        if ownership_fact_cleanup and s.live and ownership_fact_type(ntype(subject)): fact_drop_forget(s, n, fact_drop_footprint(ntype(subject)))
        return fact_new(s, if first: fact_domain(ntype(n)) else: result)
    # (a partial application's hole is a parameter of the function it makes)
    if k == .hole: return 0
    if k == .field and nodes[n].aux == -3:
        # (a variant's payload field, bound by a match arm)
        fact_capture(int(nodes[n].a), s)
        return fact_fresh(s, ntype(n))
    if k == .field and nodes[n].aux == -4 and is_vec(ntype(int(nodes[n].a))):
        # (a vector lane or swizzle read, `p.x`: reads its vector, writes
        # nothing. One lane is a projection of the vector's value, as a
        # field is, so `id.x` read twice is one value; a swizzle stays fresh)
        base = fact_capture(int(nodes[n].a), s)
        if base != 0 and not is_vec(ntype(n)): return fact_project(s, base, int(nodes[n].name), false, ntype(n))
        return fact_fresh(s, ntype(n))
    # Opaque forms cannot export facts; evaluate each child from top so control
    # alternatives, implicit hooks and raw aliases cannot mint stale evidence.
    fact_forget(s, n, .unsupported, true)
    mask = isolation_children(k)
    if mask & 1 != 0 and mask >= 0: fact_capture(int(nodes[n].a), s)
    if mask & 2 != 0 and mask >= 0: fact_capture(int(nodes[n].b), s)
    if mask & 4 != 0 and mask >= 0: fact_capture(int(nodes[n].c), s)
    if mask & 16 != 0 and mask >= 0:
        loop j in [0..nkids(n)):
            c = kid(n, j)
            fact_forget(s, n, .unsupported, true)
            fact_capture(c, s)
    fact_forget(s, n, .unsupported, true)
    return fact_new(s, FactBound(reason = .unsupported, witness = n))

# A function is the library's when its module was read from the library
# directory (its body position cannot say: the prelude's initializer starts at
# offset 0 of file 0, which is no position at all).
fn_in_lib = (f: int) -> bool:
    m = int(fns[f].mod)
    if m >= 0 and m < modules.len():
        file = int(modules[m].file)
        return len(lib_root) > 0 and file >= 0 and file < files.len() and starts_with(files[file].path, lib_root)
    pos_in_lib(nodes[int(fns[f].body)].pos)

# __bcast(lengths) of 1-D operands each proven equal to one length, or to 1: that length
# (all ones: 1), as the elementwise result's. 0 when unknown. O(operands).
fact_bcast_common = (n: int, s: mut FactState) -> int:
    lengths = kid(n, 0)
    if nodes[lengths].kind != .array: return 0
    one = fact_constant(s, 1)
    first = 0
    loop c in kids(lengths):
        v = fact_capture(c, s)
        if fact_compare(s, .eq, v, one) == 1: continue
        if first == 0: first = v
        else if fact_compare(s, .eq, v, first) != 1: return 0
    if first == 0: return one
    first

fact_exact_demand = (n: int) -> bool:
    (exact_has_store(n) and not exact_decided(n) and (fact_deferred_proving or dir_obligations or dir_policy(nodes[n].pos) == DIR_STATIC or exact_shader_owners.has(exact_stores.get(n) ?? 0))) or (n >= 0 and n < exact_marks.len() and exact_marks[n] & 128 != 0)

# (Jo sources, the compiler's own, keep runtime checks: none is demanded)
fn_dewy = (f: int) -> bool:
    m = int(fns[f].mod)
    if m >= 0 and m < modules.len():
        file = int(modules[m].file)
        return file >= 0 and file < files.len() and files[file].is_dewy
    files[pos_file(nodes[int(fns[f].body)].pos)].is_dewy

# Admitted members(U) copies (member_replay.jo) differ only in their member
# literal. A decide run analyses such a block once: its first copy, from the
# entry with every place that copy changes havocked and its member literals
# unknown text. That state covers every copy's entry (the entry after earlier
# copies' changes) and that analysis every copy's, so each proof holds in each
# copy, and its exit covers the block's. A parallel walk copies the template's
# decisions to the other copies. A failure or deferral anywhere in the body
# restores the decisions before and decides it again copy by copy, with the
# full plan: shared or not, a body gets the decisions of the copy-by-copy run.
# O(B + M*B) node visits in place of M transfers and plans (B template nodes).
fact_member_shared = false
fact_member_failed = false
fact_member_owner = 0
fact_member_template = -1
fact_member_admitted: {int: int[]}

# Harness-only policy; this is not a strict-lane surface or no-panic claim. The test tools
# ask for it with `--internal-fact-policy=...` before the command (main.jo); no setting
# from the environment changes what a build means.
fact_internal_policy = ""

positive_bounds_fn = -1
positive_collecting_writes = false
positive_bounds: {int: int} = {}
positive_epoch = 1
positive_cache: int[]
positive_stamp: int[]

# Upper bound of a nonnegative integer expression, or -1 when unknown.
# The bound itself must fit the analysis host word; wider results are unknown.
# During write collection, do not use local bounds (no circular assumptions).
positive_bound = (n: int, use_locals: bool) -> int:
    if not use_locals: return positive_bound_value(n, false)
    if n >= positive_cache.len():
        positive_cache.resize(max(n + 1, nodes.len()))
        positive_stamp.resize(positive_cache.len())
    if positive_stamp[n] == positive_epoch: return positive_cache[n]
    value = positive_bound_value(n, true)
    positive_cache[n] = value
    positive_stamp[n] = positive_epoch
    value

# One cache entry per expression in a lowering context. Statements and range
# scopes advance the epoch; no facts are reused across changed loop assumptions.
# O(demanded expression nodes/edges) per context, O(N) indexed storage.
positive_bound_value = (n: int, use_locals: bool) -> int:
    if n == 0: return -1
    t = exact_representation(ntype(n))
    if types[t].kind != .int_: return -1
    # An exact conversion is an unrounded intermediate until its store. Its
    # destination type must not hide the source range from that obligation.
    if exact_has_node(n) and nodes[n].kind == .conv and (nodes[n].aux == i32(int(CV.int_)) or nodes[n].aux == i32(int(CV.none_))):
        return positive_bound(int(nodes[n].a), use_locals)
    if not types[t].sign and int(types[t].bits) < 64 and not exact_has_node(n): return (1 << int(types[t].bits)) - 1
    if t != T_INT and t != T_MATH_INT: return -1
    k = nodes[n].kind
    if k == .int_lit:
        if has_flag(n, NF_U64) or nodes[n].ival < 0: return -1
        return nodes[n].ival
    # Literal regions own their callback. Its immutable formal is bounded
    # even while collecting the writes of the source-level parameter binding.
    if not target_wasm and not target_arm64 and k == .ident and nodes[n].aux == i32(int(SK.local)):
        l = int(nodes[n].sym)
        if int(locals[l].flags) & (LF_ASSIGNED | LF_MUTPARAM | LF_CAPTURED | LF_ALIAS | LF_BYREF | LF_ADDR | LF_EXPOSED | LF_SHARED) == 0 and cur_fn > 0 and fns[cur_fn].kind == FK_LAMBDA and fns[cur_fn].params.len() == 1 and fns[cur_fn].params[0] == l:
            if let bound = fact_parallel_bounds.get(cur_fn):
                if not bound.wide and bound.lo >= 0: return bound.hi
    if k == .ident and nodes[n].aux == i32(int(SK.local)) and use_locals:
        if let limit = math_word_limits.get(int(nodes[n].sym)): return limit
        loop i in [0..nonneg_locals.len()):
            if nonneg_locals[i] == int(nodes[n].sym): return nonneg_limits[i]
        l = int(nodes[n].sym)
        fl = int(locals[l].flags)
        if fl & LF_DECL == 0 or fl & (LF_PARAM | LF_MUTPARAM | LF_CAPTURE | LF_CAPTURED | LF_ALIAS | LF_BYREF | LF_ADDR | LF_SHARED | LF_SOAELEM | LF_ELEMALIAS | LF_QUIET) != 0: return -1
        if positive_bounds_fn != cur_fn:
            positive_bounds_fn = cur_fn
            positive_bounds.clear()
            math_prepare_writes()
        return positive_bounds.get(l) ?? -1
    if k == .conv and (nodes[n].aux == i32(int(CV.int_)) or nodes[n].aux == i32(int(CV.fixed_store))):
        return positive_bound(int(nodes[n].a), use_locals)
    if k == .intrinsic and nodes[n].aux == i32(int(IN.len)) and nkids(n) == 1:
        t = prune(ntype(kid(n, 0)))
        # (no allocation outgrows the address space: 2^56 bytes on any target)
        if types[t].kind == .array:
            if dir_value(dir_name_assumed_bounds, nodes[n].pos) == 1: return -1
            # An initializer outside a nested opt-out must not seed an
            # assumed local range later reused inside that opt-out.
            if positive_collecting_writes and dir_assumed_bounds_any: return -1
            return if tsize(telem(t)) > 0: (1 << 56) / tsize(telem(t)) else: 9223372036854775807
    modulus = positive_modulus(n)
    if modulus > 0: return modulus - 1
    if k != .binary or nodes[n].aux != 0: return -1
    op = nodes[n].op as Tok
    if op == .amp:
        a = positive_bound(int(nodes[n].a), use_locals)
        b = positive_bound(int(nodes[n].b), use_locals)
        if a >= 0 and b >= 0: return min(a, b)
        return max(a, b)
    if op != .plus and op != .star: return -1
    a = positive_bound(int(nodes[n].a), use_locals)
    b = positive_bound(int(nodes[n].b), use_locals)
    if a < 0 or b < 0: return -1
    if op == .plus:
        if a > 9223372036854775807 - b: return -1
        return a + b
    if b == 0: return 0
    if a > 9223372036854775807 / b: return -1
    a * b

positive_local_write = (l: int, bound: int):
    if l <= 0 or int(locals[l].owner) != cur_fn: return
    fl = int(locals[l].flags)
    skip = LF_PARAM | LF_MUTPARAM | LF_CAPTURE | LF_CAPTURED | LF_ALIAS | LF_BYREF | LF_ADDR | LF_SHARED | LF_SOAELEM | LF_ELEMALIAS | LF_QUIET
    if fl & LF_DECL == 0 or fl & skip != 0 or (prune(int(locals[l].type)) != T_INT and prune(int(locals[l].type)) != T_MATH_INT): return
    old = positive_bounds.get(l) ?? bound
    if old < 0 or bound < 0: positive_bounds[l] = -1
    else: positive_bounds[l] = max(old, bound)

positive_target_write = (n: int, bound: int):
    if nodes[n].kind == .ident and nodes[n].aux == i32(int(SK.local)):
        positive_local_write(int(nodes[n].sym), bound)
    else if nodes[n].kind == .tuple:
        loop i in [0..nkids(n)): positive_target_write(kid(n, i), -1)

positive_write = (n: int):
    k = nodes[n].kind
    if k == .vardecl and not has_flag(n, NF_GLOBAL):
        if nkids(n) == 0:
            b = int(nodes[n].b)
            positive_local_write(int(nodes[n].sym), if b == 0: 0 else: positive_bound(b, false))
        else:
            loop i in [0..nkids(n)): positive_local_write(int(nodes[kid(n, i)].sym), -1)
    if k == .assign:
        bound = -1
        if nodes[n].op == i32(int(Tok.assign)) and nodes[n].aux == 0: bound = positive_bound(int(nodes[n].b), false)
        positive_target_write(int(nodes[n].a), bound)

# Storage summaries are collected once per loop, including its condition.
# Outer loops reuse inner inventories; lowering retains all pointer/uniqueness
# prerequisites independently of numeric bounds. Cache lifetime is one function.
struct FactStorage:
    bases: int[]
    kill: int[]
    escape: int[]
    written: int[]
    calls: bool
    opaque: bool
fact_storage_cache: {int: FactStorage} = {}

fact_storage_loop = (n: int) -> FactStorage:
    if let cached = fact_storage_cache.get(n): return cached
    saved = FactStorage(fp_bases, fp_kill, fp_escape, fp_written, fp_calls, fp_lambda)
    fp_bases = []; fp_kill = []; fp_escape = []; fp_written = []
    fp_calls = false; fp_lambda = false
    fact_storage_scan(int(nodes[n].b), 0)
    if nodes[n].kind == .while_: fact_storage_scan(int(nodes[n].a), 0)
    result = FactStorage(fp_bases, fp_kill, fp_escape, fp_written, fp_calls, fp_lambda)
    fact_storage_cache[n] = result
    fp_bases = saved.bases; fp_kill = saved.kill
    fp_escape = saved.escape; fp_written = saved.written
    fp_calls = saved.calls; fp_lambda = saved.opaque
    result

# ctx: 0 the value is used (copied, passed), 1 it is only indexed or measured
fact_storage_scan = (n: int, ctx: int):
    if n == 0: return
    k = nodes[n].kind
    if k == .for_ or k == .while_:
        summary = fact_storage_loop(n)
        loop v in summary.bases: fp_bases.push(v)
        loop v in summary.kill: fp_kill.push(v)
        loop v in summary.escape: fp_escape.push(v)
        loop v in summary.written: fp_written.push(v)
        fp_calls = fp_calls or summary.calls or not ambient_storage_stable(n)
        fp_lambda = fp_lambda or summary.opaque
        if k == .for_:
            if has_flag(n, NF_MUT):
                key = lpath_key(int(nodes[n].a))
                if key != 0: fp_kill.push(key)
            fact_storage_scan(int(nodes[n].a), 0)
        return
    # An unclassified operation may also affect its local actuals. Merely
    # marking ambient calls would still allow caching a private local array.
    mask = isolation_children(k)
    if mask < 0 or k == .intrinsic and not isolation_intrinsic(nodes[n].aux as IN):
        fp_lambda = true
        return
    if not ambient_storage_stable(n): fp_calls = true
    if k == .lambda:
        fp_lambda = true
        return
    if k == .ident and nodes[n].aux == i32(int(SK.local)) and int(locals[int(nodes[n].sym)].flags) & LF_ELEMALIAS != 0:
        # (x of `mut x in xs` in a combined loop: writing x writes xs, which the body does not show)
        key = lpath_key(int(nodes[int(locals[int(nodes[n].sym)].alias)].a))
        if key != 0: fp_kill.push(key)
        return
    if k == .ident or k == .field:
        key = lpath_key(n)
        if key != 0:
            if ctx == 0: fp_escape.push(key)
            if k == .field: fact_storage_scan(int(nodes[n].a), 1)
            return
        if k == .field: fact_storage_scan(int(nodes[n].a), 0)
        return
    if k == .index:
        base = int(nodes[n].a)
        if lpath_key(base) != 0 and tkind(ntype(base)) == .array: fp_bases.push(base)
        # A slice retains its source while its bounds run; writes in those
        # bounds must still detach, including when the slice is inside a loop.
        fact_storage_scan(base, if nodes[n].aux == 1: 0 else: 1)
        fact_storage_scan(int(nodes[n].b), 0)
        loop i in [0..nkids(n)): fact_storage_scan(kid(n, i), 0)
        return
    if k == .assign:
        fact_storage_target(int(nodes[n].a))
        fact_storage_scan(int(nodes[n].b), 0)
        return
    # (a pointer to a variable, or to an array's elements, may write it: data() also makes the
    # array one of its own first, which may move it)
    if k == .addr or (k == .cast or k == .conv) and raw_view(n):
        key = lpath_key(int(nodes[n].a))
        if key != 0: fp_kill.push(key)
        fact_storage_scan(int(nodes[n].a), 1)
        return
    if k == .intrinsic and nkids(n) > 0:
        id = nodes[n].aux as IN
        if id == .push or id == .pop or id == .insert or id == .remove or id == .clear or id == .reserve or id == .resize or id == .truncate or id == .extend or id == .arrdata:
            key = lpath_key(kid(n, 0))
            if key != 0: fp_kill.push(key)
            fact_storage_scan(kid(n, 0), 1)
            loop i in [1..nkids(n)): fact_storage_scan(kid(n, i), 0)
            return
        if id == .len or id == .arrcap:
            fact_storage_scan(kid(n, 0), 1)
            return
    if k == .call:
        mm = checked_call_mutmask(n)
        loop i in [0..nkids(n)):
            if mm & (1 << i) != 0:
                key = lpath_key(kid(n, i))
                if key != 0: fp_kill.push(key)
                # (`@xs[i]` writes an element, like an assignment to it: xs must be made unique)
                else: fact_storage_target(kid(n, i))
    if k == .for_ and has_flag(n, NF_MUT):
        # (loop mut x in p may make p a copy of its own)
        key = lpath_key(int(nodes[n].a))
        if key != 0: fp_kill.push(key)
    if mask & 1 != 0: fact_storage_scan(int(nodes[n].a), 0)
    if mask & 2 != 0: fact_storage_scan(int(nodes[n].b), 0)
    if mask & 4 != 0: fact_storage_scan(int(nodes[n].c), 0)
    if mask & 16 != 0:
        loop i in [0..nkids(n)): fact_storage_scan(kid(n, i), 0)
    if mask & 32 != 0:
        loop i in [0..nkids2(n)): fact_storage_scan(kid2(n, i), 0)

# an assignment target: the arrays along it have elements written; a path itself is replaced
fact_storage_target = (t: int):
    if not ambient_storage_stable(t): fp_calls = true
    k = nodes[t].kind
    # (an element alias's array: written)
    r = t
    loop nodes[r].kind == .field: r = int(nodes[r].a)
    if nodes[r].kind == .ident and nodes[r].aux == i32(int(SK.local)) and int(locals[int(nodes[r].sym)].flags) & LF_ELEMALIAS != 0:
        fact_storage_scan(r, 0)
        return
    if k == .index:
        base = int(nodes[t].a)
        key = lpath_key(base)
        if key != 0:
            fp_written.push(key)
            if tkind(ntype(base)) == .array: fp_bases.push(base)
            fact_storage_scan(base, 1)
        else: fact_storage_target(base)
        fact_storage_scan(int(nodes[t].b), 0)
        loop i in [0..nkids(t)): fact_storage_scan(kid(t, i), 0)
        return
    key = lpath_key(t)
    if key != 0:
        fp_kill.push(key)
        if k == .field: fact_storage_scan(int(nodes[t].a), 1)
        return
    if k == .field:
        fact_storage_target(int(nodes[t].a))
        return
    fact_storage_scan(t, 0)

# Cheap lowering facts share this module; full relational states stay demanded.
# bounds: the length is fixed, and an empty (null) A never enters the loop.
len_of_local: {int: int}        # local n -> local A when n := A.len() and neither ever changes
safe_index: (int, int, bool)[]  # (array local, loop variable local, keep its null check)
nonneg_locals: int[]            # loop variables of ranges that start at a value >= 0
nonneg_limits: int[]            # matching constant upper limits, or -1
# A loop's control counter stays in range, but its user-visible variable can
# be reassigned, passed by reference, or changed by a closure in the body.
stable_loop_index = (l: int) -> bool:
    if l < 0: return false
    fl = int(locals[l].flags)
    fl & (LF_ASSIGNED | LF_ALIAS | LF_CAPTURE | LF_BYREF | LF_ADDR) == 0 and not is_shared(l)

# e is an integer expression that is never negative
# The step-1 int/int64 boundary changes semantic type but preserves every bit
# and value. Existing index/length proofs can look through just that boundary.
# This is representation-specific: step 2 must prove a word representation first.
word_integer_value = (n0: int) -> int:
    n = n0
    loop nodes[n].kind == .conv and nodes[n].aux == i32(int(CV.int_)):
        inner = int(nodes[n].a)
        source = prune(ntype(inner))
        target = prune(ntype(n))
        if not ((source == T_INT and target == T_MATH_INT) or (source == T_MATH_INT and target == T_INT)): break
        n = inner
    n

is_nonneg = (e0: int) -> bool:
    e = word_integer_value(e0)
    if e == 0: return false
    k = nodes[e].kind
    if k == .int_lit: return nodes[e].ival >= 0
    if k == .ident and nodes[e].aux == i32(int(SK.local)): return nonneg_locals.contains(int(nodes[e].sym))
    if k == .intrinsic and (nodes[e].aux as IN) == .len: return true
    # Positive operands alone do not prove a word-sized sum/product is
    # nonnegative: it can overflow. Keep the check without a range proof.
    false

# A, if e is A.len() / len(A) for an array local A that is never modified, else -1
fixed_array_len = (e0: int) -> int:
    e = word_integer_value(e0)
    if e == 0 or nodes[e].kind != .intrinsic or (nodes[e].aux as IN) != .len or nkids(e) != 1: return -1
    a = kid(e, 0)
    if nodes[a].kind != .ident or nodes[a].aux != i32(int(SK.local)): return -1
    ak = types[prune(ntype(a))].kind
    if ak != .array and ak != .str_: return -1          # (a str's length changes only when it is assigned)
    l = int(nodes[a].sym)
    if not fixed_array_local(l): return -1
    l

# the length of array local l cannot change during this function
fixed_array_local = (l: int) -> bool:
    # element writes keep the length; writing the variable itself (or a mut parameter, which
    # could be the caller's global) may not
    fl = int(locals[l].flags)
    if fl & (LF_RESIZED | LF_ALIAS | LF_BYREF) != 0 or is_shared(l): return false
    if fl & LF_MUTPARAM != 0 and not ambient_length_stable(cur_fn): return false
    true

array_len_expr: {int: int}      # array local A -> E when A := [x; E] and A is never resized

# x and y always have the same value: literals, unchanging locals and + - * of those
same_value = (x: int, y: int) -> bool:
    if x == 0 or y == 0 or nodes[x].kind != nodes[y].kind: return false
    if nodes[x].kind == .conv:
        return nodes[x].aux == nodes[y].aux and ntype(x) == ntype(y) and same_value(int(nodes[x].a), int(nodes[y].a))
    k = nodes[x].kind
    if k == .int_lit: return nodes[x].ival == nodes[y].ival
    if k == .ident:
        if nodes[x].aux != i32(int(SK.local)) or nodes[y].aux != i32(int(SK.local)) or nodes[x].sym != nodes[y].sym: return false
        return int(locals[int(nodes[x].sym)].flags) & LF_ASSIGNED == 0
    if k == .binary:
        op = nodes[x].op as Tok
        if nodes[y].op != nodes[x].op or (op != .plus and op != .minus and op != .star): return false
        return same_value(int(nodes[x].a), int(nodes[y].a)) and same_value(int(nodes[x].b), int(nodes[y].b))
    if k == .intrinsic:
        a = fixed_array_len(x)
        return a >= 0 and a == fixed_array_len(y)
    false

# A bounded ascending range with a nonnegative start never yields a negative
# index. For steps, require ordered literal starts; dynamic/descending steps
# keep their ordinary checks until there is a stronger proof.
nonnegative_range = (it: int) -> bool:
    if nodes[it].b == 0 or not is_nonneg(int(nodes[it].a)): return false
    if not has_flag(it, NF_STEP): return true
    a = int(nodes[it].a)
    b = int(nodes[it].c)
    nodes[a].kind == .int_lit and nodes[b].kind == .int_lit and nodes[b].ival > nodes[a].ival

# the array locals whose length bounds the range `it`
range_bounds_arrays = (it: int) -> int[]:
    out: int[]
    if not nonnegative_range(it) or has_flag(it, NF_INCLUSIVE): return out
    hi = word_integer_value(int(nodes[it].b))
    if hi == 0: return out
    a = fixed_array_len(hi)
    if a >= 0: out.push(a)
    if nodes[hi].kind == .ident and nodes[hi].aux == i32(int(SK.local)):
        n = int(nodes[hi].sym)
        if int(locals[n].flags) & LF_ASSIGNED == 0:
            if let b = len_of_local.get(n):
                if fixed_array_local(b): out.push(b)
    loop arr, e in array_len_expr:
        if int(locals[arr].owner) == cur_fn and fixed_array_local(arr) and same_value(hi, e): out.push(arr)
    out

# Dominating early returns can establish a minimum immutable array length.
# These lexical entries need no relational pass; only bounded indices query
# them, and block exit removes them. At most 16 active guards are retained.
lower_length_guards: (int, int)[]
lower_length_guard = (n0: int):
    if lower_length_guards.len() >= 16: return
    n = n0
    if nodes[n].kind == .exprstmt: n = int(nodes[n].a)
    if nodes[n].kind != .if_ or nodes[n].c != 0: return
    body = int(nodes[n].b)
    if nodes[body].kind != .block or nkids(body) != 1 or nodes[kid(body, 0)].kind != .return_: return
    condition = int(nodes[n].a)
    if nodes[condition].kind != .binary or nodes[condition].aux != 0: return
    if nodes[condition].op != i32(int(Tok.lt)): return
    array = fixed_array_len(int(nodes[condition].a))
    if array < 0: return
    flags = int(locals[array].flags)
    if flags & (LF_ASSIGNED | LF_MUTPARAM | LF_CAPTURE | LF_CAPTURED | LF_ADDR | LF_ALIAS | LF_BYREF | LF_SHARED) != 0: return
    known, length = integer_constant(int(nodes[condition].b))
    if known and length > 0: lower_length_guards.push((array, length))

# 0: needs a bounds check, 1: in bounds, 2: in bounds but keep the null check (other
# accesses to the array in the loop are checked and can build on it)
index_safety = (arr: int, idx0: int) -> int:
    idx = word_integer_value(idx0)
    if lower_length_guards.len() > 0 and nodes[arr].kind == .ident and nodes[arr].aux == i32(int(SK.local)):
        loop guard in lower_length_guards:
            if guard.0 == int(nodes[arr].sym):
                bound = positive_bound(idx, true)
                if bound >= 0 and bound < guard.1: return 1
    if safe_index.len() == 0: return 0
    if nodes[arr].kind != .ident or nodes[idx].kind != .ident: return 0
    if nodes[arr].aux != i32(int(SK.local)) or nodes[idx].aux != i32(int(SK.local)): return 0
    a = int(nodes[arr].sym)
    j = int(nodes[idx].sym)
    loop p in safe_index:
        if p.0 == a and p.1 == j:
            if p.2: return 2
            return 1
    0

# does the loop body index array local a with anything but the loop variables in `ok`
# (this loop's, and those of nested loops that are in bounds for a too)?
other_index_of = (n: int, a: int, ok: int[], seen: mut bool[]) -> bool:
    if n <= 0 or n >= seen.len() or seen[n]: return false
    seen[n] = true
    k = nodes[n].kind
    if k == .index:
        b = int(nodes[n].a)
        if nodes[b].kind == .ident and nodes[b].aux == i32(int(SK.local)) and int(nodes[b].sym) == a:
            ix = word_integer_value(int(nodes[n].b))
            if not (nodes[ix].kind == .ident and nodes[ix].aux == i32(int(SK.local)) and ok.contains(int(nodes[ix].sym))): return true
    if k == .for_:
        inner = ok
        it = int(nodes[n].a)
        if int(nodes[n].aux) == 0 and stable_loop_index(int(nodes[n].sym)) and range_bounds_arrays(it).contains(a): inner.push(int(nodes[n].sym))
        return other_index_of(it, a, ok, seen) or other_index_of(int(nodes[n].b), a, inner, seen)
    # (a checked `for` returned above; a partial's d is a function instance)
    loop c in [int(nodes[n].a), int(nodes[n].b), kid_c(n), kid_d(n)]:
        if other_index_of(c, a, ok, seen): return true
    loop i in [0..nkids(n)):
        if other_index_of(kid(n, i), a, ok, seen): return true
    loop i in [0..nkids2(n)):
        if other_index_of(kid2(n, i), a, ok, seen): return true
    false

# Share range facts between unit and stepped loops. Array paths can still be
# hoisted when the counter is mutable, but only stable indices prove bounds.
range_facts_begin = (s: int, l: int) -> (int, int, bool):
    positive_epoch += 1
    safe_arrs: int[]
    nonneg = false
    bound = 0
    if nodes[s].aux == 0 and stable_loop_index(l):
        it = int(nodes[s].a)
        nonneg = nonnegative_range(it)
        if nonneg:
            safe_arrs = range_bounds_arrays(it)
            if not has_flag(it, NF_INCLUSIVE):
                hi = word_integer_value(int(nodes[it].b))
                if nodes[hi].kind == .intrinsic and (nodes[hi].aux as IN) == .len and nkids(hi) == 1: bound = kid(hi, 0)
    if nonneg:
        nonneg_locals.push(l)
        hi = int(nodes[int(nodes[s].a)].b)
        limit = -1
        if nodes[hi].kind == .int_lit and not has_flag(hi, NF_U64) and nodes[hi].ival > 0:
            limit = nodes[hi].ival
            if not has_flag(int(nodes[s].a), NF_INCLUSIVE): limit -= 1
        if limit < 0 and bound != 0 and tkind(ntype(bound)) == .array:
            limit = 9223372036854775807 / max(1, tsize(telem(ntype(bound)))) - 1
        nonneg_limits.push(limit)
    nfp = fp_begin(s, l, bound, 0)
    loop sa in safe_arrs:
        seen = fill(false, nodes.len())
        ok = [l]
        loop p in safe_index:
            if p.0 == sa: ok.push(p.1)
        safe_index.push((sa, l, other_index_of(int(nodes[s].b), sa, ok, seen)))
    (nfp, safe_arrs.len(), nonneg)

range_facts_end = (facts: (int, int, bool)):
    positive_epoch += 1
    loop _ in [0..facts.1): safe_index.pop()
    fp_end(facts.0)
    if facts.2:
        nonneg_locals.pop()
        nonneg_limits.pop()


# How a loop's body state is made from its head (fact_loop_bounds): a while
# loop's condition holds, a range loop binds its value, an indexed array loop
# its position below the source's length, an entry loop its key and value;
# any other loop evaluates its source again.
const FACT_PREP_CONDITION = 0
const FACT_PREP_RANGE = 1
const FACT_PREP_INDEXED = 2
const FACT_PREP_MAPPED = 3
const FACT_PREP_CAPTURE = 4
# The state an array, string or entry loop's body starts from (an indexed or
# entry loop's source evaluated once as base), as fact_capture's loop transfer.
fact_loop_prepare = (n: int, body: mut FactState, prep: int, base: int, pushes: (int, int)[]):
    fact_growing_lengths(body, pushes)
    if prep == FACT_PREP_INDEXED:
        fact_loop_index(n, base, body)
        ref_sib_loop_elements(n, base, body)
    else if prep == FACT_PREP_MAPPED: fact_map_loop(n, base, body)
    else: fact_capture(int(nodes[n].a), body)

# The local x of an index obligation `a[x]` on a path a (a local or an `@`
# parameter, or a field of one) into a resizable array, or 0. O(path depth).
fact_loop_index_local = (m: int) -> int:
    if tkind(fact_type(ntype(int(nodes[m].a)))) != .array: return 0
    a = int(nodes[m].a)
    loop fact_field_node(a): a = int(nodes[a].a)
    if nodes[a].kind != .ident or nodes[a].aux != i32(int(SK.local)): return 0
    x = int(nodes[m].b)
    loop nodes[x].kind == .conv: x = int(nodes[x].a)
    if nodes[x].kind != .ident or nodes[x].aux != i32(int(SK.local)): return 0
    int(nodes[x].sym)

# The demand for fact_loop_bounds: index obligations inside or after loop n
# whose position is a local declared before it that the body assigns (an
# active carried assignment). The slice keeps only positions the function
# never steps from their own value (`i += 1`, a scanner's, which no step
# re-establishes unguarded: the header's guards keep those) nor sets to an
# unrefined record field. O(the slice's such obligations), then one memoized
# body walk; at most 4 kept.
fact_loop_bound_demands = (n: int) -> int[]:
    out: int[]
    if fact_slice.loop_indexes.len() == 0: return out
    carried: int[]
    walked = false
    loop m in fact_slice.loop_indexes:
        if nodes[m].pos < nodes[n].pos: continue
        x = fact_loop_index_local(m)
        if locals[x].pos >= nodes[n].pos: continue
        if not walked:
            carried = fact_carried_assigns(n)
            walked = true
        loop e in carried:
            if int(nodes[int(nodes[e].a)].sym) == x and fact_slice_flags(e) & (FACT_MEMBER | FACT_ACTIVE) != FACT_MEMBER:
                out.push(m)
                break
        if out.len() >= 4: break
    out

# Whether e reads a record's integer field with no contract (`leaf =
# node.next`, a link that may be a sentinel): it bounds nothing. O(1).
fact_loop_unbounded_field = (e0: int) -> bool:
    e = e0
    loop e != 0 and nodes[e].kind == .conv: e = int(nodes[e].a)
    e != 0 and fact_field_node(e) and is_int(ntype(e)) and refine_storage(e, ntype(e)) == ntype(e)

# Whether e is x plus or minus something (an assignment stepping x). O(1).
fact_loop_step = (e0: int, x: int) -> bool:
    e = e0
    loop e != 0 and nodes[e].kind == .conv: e = int(nodes[e].a)
    if e == 0 or nodes[e].kind != .binary or nodes[e].op != i32(int(Tok.plus)) and nodes[e].op != i32(int(Tok.minus)): return false
    loop side in [int(nodes[e].a), int(nodes[e].b)]:
        v = side
        loop v != 0 and nodes[v].kind == .conv: v = int(nodes[v].a)
        if v != 0 and nodes[v].kind == .ident and nodes[v].aux == i32(int(SK.local)) and int(nodes[v].sym) == x: return true
    false

# Obligation m's position x and its array's length in s: the path's route
# only projects evaluated identities, never evaluating syntax. O(path depth).
fact_loop_bound_terms = (s: mut FactState, m: int) -> (int, int):
    l = fact_loop_index_local(m)
    i = fact_binding(s, PlaceIdentity(.local, int(locals[l].owner), l))
    if i < 0: return (0, 0)
    held = fact_route_values(s, fact_route(int(nodes[m].a), s))
    if held.len() == 0: return (0, 0)
    (s.bindings[i].value, fact_project(s, held[held.len() - 1], -1, false, T_INT))

# The demanded obligations whose relation entry s holds: reading their paths
# there, as fact_loop_roots seeds a while loop's, keeps those evaluations'
# identities at every head the body leaves them. O(demands x path depth).
fact_loop_bound_entry = (demands: int[], s: mut FactState) -> int[]:
    kept: int[]
    if demands.len() == 0 or not s.live: return kept
    loop m in demands:
        if fact_loop_bound_holds(s, m): kept.push(m)
    kept

# Whether s holds 0 <= x < a.length: one bounded relaxation.
fact_loop_bound_holds = (s: mut FactState, m: int) -> bool:
    if not s.live: return true
    terms = fact_loop_bound_terms(s, m)
    if terms.0 == 0: return false
    zero = fact_constant(s, 0)
    fact_compare(s, .le, zero, terms.0) == 1 and fact_compare(s, .lt, terms.0, terms.1) == 1

fact_loop_bound_assume = (s: mut FactState, m: int, at: int):
    terms = fact_loop_bound_terms(s, m)
    if terms.0 == 0: return
    fact_difference(s, terms.0, terms.1, -1, at)
    b = fact_bound(s, terms.0)
    h = fact_bound(s, terms.1).hi
    b.lo = max(b.lo, 0)
    if h > 0 and h != FACT_MAX: b.hi = min(b.hi, h - 1)
    fact_set_bound(s, terms.0, b)

# A position a loop's body assigns stays an index of an array the body only
# grows: `0 <=? x <? a.length` is an invariant of loop n when entry holds it
# (held_at_entry, fact_loop_bound_entry) and, assumed at head s (settled or
# havocked), the body's backedge holds it again, however the body changed x and a. Each assignment of x must
# establish it; a pop, truncation, replacement or aliased shrink of a, or a
# call that may write it, fails the backedge. Candidates are the demanded
# obligations (fact_loop_bound_demands); one that fails is dropped and the
# rest are checked again from a head without it, so each kept relation is
# inductive. The body walk starts as the loop's own does (prep).
# O(rounds x body): at most 5 speculative body walks, in the nest's shared
# step budget; an exhausted or skipped walk keeps nothing.
fact_loop_bounds = (n: int, s: mut FactState, held_at_entry: int[], prep: int, base: int, lo: int, hi: int, pushes: (int, int)[]) -> bool:
    if fact_loop_exhausted or not s.live: return false
    if fact_summary_owner != 0 and not fact_may_return(int(nodes[n].b)): return false
    kept = held_at_entry
    outer = fact_speculating
    steps = fact_loop_steps
    verified = false
    loop attempt in [0..5):
        if kept.len() == 0 or fact_loop_exhausted: break
        head = s
        loop m in kept: fact_loop_bound_assume(head, m, n)
        fact_speculating += 1
        body = head
        if prep == FACT_PREP_CONDITION: body = fact_condition(int(nodes[n].a), head).yes
        else if prep == FACT_PREP_RANGE: body = fact_iteration_body(n, head, true, 0, lo, hi, pushes)
        else: fact_loop_prepare(n, body, prep, base, pushes)
        edges = fact_loop_body(n, body)
        fact_speculating = outer
        if fact_loop_exhausted: break
        held: int[]
        loop m in kept:
            if fact_loop_bound_holds(edges.back, m): held.push(m)
        if held.len() == kept.len():
            verified = true
            break
        kept = held
    # (outside any speculation these walks are this rule's own: the real
    # walk and its inner loops keep the budget they had)
    if outer == 0:
        fact_loop_steps = steps
        fact_loop_exhausted = false
    if not verified: return false
    loop m in kept: fact_loop_bound_assume(s, m, n)
    true
        return joined
    if k == .and_ or k == .or_:
        if string_set_owners.len() > 0 and string_set_owners.has(fact_owner) and string_set_tests.has(n): return fact_string_set(n, s)
        if fact_summary_owner != 0 or mark != 0 and mark & FACT_VALUE == 0:
            paths = fact_condition(n, s)
            result = fact_domain(T_BOOL)

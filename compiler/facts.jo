            if source >= 0 and s.projections.len() < FACT_CAP: fact_add_projection(s, FactProjection(key, FACT_KEY_SOURCE, false, s.projections[source].value))
            r = key
        if ownership_decls.len() != 0: r = fact_owner_value(int(nodes[n].b), r, s)

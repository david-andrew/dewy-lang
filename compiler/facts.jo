            sums = fact_counted_sums(n, s, trips)
        # (positions the body keeps below a length: fact_loop_bounds)
        demands = fact_loop_bound_entry(fact_loop_bound_demands(n), s)
        hulls = indexed and fact_push_open(n, s, base)
        iterated = indexed and fact_iterate(n, s, false, base, 0, 0, pushes + growers, sums)
        if not iterated:
            fact_changes(n, s, n)
            loop sum in sums:
                i = fact_binding(s, PlaceIdentity(.local, int(locals[sum.0].owner), sum.0))
                if i >= 0: fact_set_bound(s, s.bindings[i].value, sum.1)
        prep = if indexed: FACT_PREP_INDEXED else if mapped: FACT_PREP_MAPPED else: FACT_PREP_CAPTURE
        bounded = demands.len() > 0 and fact_loop_bounds(n, s, demands, prep, base, 0, 0, pushes + growers)
        after = s
        body = s
        fact_loop_prepare(n, body, prep, base, pushes + growers)
        edges = fact_loop_body(n, body)
        # (an iterated or bounded header holds at every head, not inside the
        # body: a break joins it)
        s = if iterated or bounded: fact_join(after, edges.exits, n) else: after
        if indexed and nodes[n].aux == 1 and base != 0 and edges.back.live and not edges.exits.live: fact_ensured_close(n, base, edges.back, s)
        if hulls: fact_push_close(n, s)
        fact_growing_lengths(s, growers)
        if pushes.len() > 0 or scaled.len() > 0:
            t = fact_type(ntype(int(nodes[n].a)))
            count = if types[t].kind == .fixed: fact_constant(s, fixed_len(t)) else: fact_project(s, base, -1, false, T_INT)
            fact_counted_lengths(n, s, pushes, count)
            fact_scaled_lengths(n, s, scaled, count)
        return 0
    if k == .not_:
        a = fact_capture(int(nodes[n].a), s)
        v = fact_truth(s, a)
        b = if v < 0: fact_domain(T_BOOL) else: FactBound(1 - v, 1 - v, v == 0)
        return fact_new(s, b, FactTerm(.kw_not, a, 0, n))
    if k == .binary:
        sum_operand = fact_sum_operand
        if nodes[n].op == i32(int(Tok.shr)) or nodes[n].op == i32(int(Tok.slash)): fact_sum_operand = fact_sum_source(int(nodes[n].a))
        a = fact_capture(int(nodes[n].a), s)
        fact_sum_operand = sum_operand
        if result_active and nodes[int(nodes[n].b)].kind == .none_lit and tkind(ntype(int(nodes[n].a))) == .opt:
            tag = fact_project(s, a, -3, false, T_INT)
            zero = fact_constant(s, 0)
            return fact_new(s, fact_domain(T_BOOL), FactTerm(nodes[n].op as Tok, tag, zero))
        b = fact_capture(int(nodes[n].b), s)
        op = nodes[n].op as Tok
        set_proof = string_set_owners.len() > 0 and string_set_owners.has(fact_owner)
        if set_proof and string_set_tests.has(n): return fact_string_set(n, s)
        if (op == .shl or op == .shr) and fact_shift_obliged(n): fact_nonnegative(n, s, b, int(nodes[n].b), "the shift count")
        if set_proof and nodes[n].aux == 2 and (op == .eq or op == .ne):
            x = fact_project(s, a, FACT_TEXT_ID, false, T_INT)
            y = fact_project(s, b, FACT_TEXT_ID, false, T_INT)
            truth = fact_compare(s, op, x, y)
            result = if truth >= 0: FactBound(truth, truth, truth != 0) else: fact_domain(T_BOOL)
            return fact_new(s, result, FactTerm(op, x, y, n))
        literal_words = set_proof and (op == .eq or op == .ne) and str_set_of(ntype(int(nodes[n].a))) != 0 and str_set_of(ntype(int(nodes[n].b))) != 0
        if nodes[n].aux == 0 and (literal_words or fact_scalar(ntype(int(nodes[n].a))) and fact_scalar(ntype(int(nodes[n].b)))) and fact_comparison(op):
            unsigned_a = fact_type(ntype(int(nodes[n].a))) == T_U64
            unsigned_b = fact_type(ntype(int(nodes[n].b))) == T_U64
            if unsigned_a != unsigned_b:
                if unsigned_a: a = exact_fact_signed(s, a)
                else: b = exact_fact_signed(s, b)
            truth = fact_compare(s, op, a, b)
            x = fact_bound(s, a); y = fact_bound(s, b)
            reason = if x.lo != x.hi: x else: y
            result = fact_domain(T_BOOL, reason.reason, reason.witness)
            if truth >= 0: result = FactBound(truth, truth, truth != 0)
            return fact_new(s, result, FactTerm(op, a, b, n))
        if nodes[n].aux == 0 and fact_scalar(ntype(n)) and (op == .plus or op == .minus or op == .star): return fact_arithmetic(s, n, op, a, b)
        if fact_speculating == 0 and fact_policy == .RequireStatic and nodes[n].aux == 0 and (op == .slash or op == .percent) and is_int(ntype(int(nodes[n].b))):
            proven = fact_divisor(s, n, a, b, op == .percent)
            if fact_probe_on: fact_probe_record(n, proven)
        else if fact_speculating == 0 and fact_probe_on and nodes[n].aux == 0 and (op == .slash or op == .percent) and is_int(ntype(int(nodes[n].b))):
            fact_probe_divisor(n, s, b, int(nodes[n].b))
        if nodes[n].aux == 0 and (op == .slash or op == .percent) and fact_type(ntype(n)) == T_U64 and fact_type(ntype(int(nodes[n].a))) == T_U64 and fact_type(ntype(int(nodes[n].b))) == T_U64:
            return fact_floor_unsigned(s, n, (if op == .slash: 1 else: 2), a, b)
        if nodes[n].aux == 0 and (op == .slash or op == .percent) and fact_scalar(ntype(n)) and fact_type(ntype(n)) != T_U64 and fact_scalar(ntype(int(nodes[n].a))) and fact_scalar(ntype(int(nodes[n].b))):
            return fact_floor(s, n, (if op == .slash: 1 else: 2), a, b, files[pos_file(nodes[n].pos)].is_dewy)
        if nodes[n].aux == 0 and (op == .amp or op == .pipe or op == .caret or op == .shr or op == .shl) and fact_scalar(ntype(n)) and is_int(ntype(n)):
            exact_shift_fact(n, b, s)
            return fact_bitwise(s, n, op, a, b)
        if fact_length_comparison(n):
            at = fact_type(ntype(int(nodes[n].a)))
            bt = fact_type(ntype(int(nodes[n].b)))
            al = if tkind(at) == .fixed: fact_constant(s, fixed_len(at)) else: fact_project(s, a, -1, false, T_INT)
            bl = if tkind(bt) == .fixed: fact_constant(s, fixed_len(bt)) else: fact_project(s, b, -1, false, T_INT)
            v = fact_new(s, fact_domain(T_BOOL), FactTerm(a = al, b = bl, origin = n, type = T_BOOL))
            if tkind(at) == .array and tkind(bt) == .array and telem(at) == T_INT and telem(bt) == T_INT: fact_equal_arrays[n] = (v, a, b)
            return v
        if nodes[n].aux != 0 and not fact_pure_binary(n): fact_forget(s, n, .call)
        return fact_unmodeled(s, n, .unsupported)
    if fact_enum_cast(n) or fact_pointer_cast(n):
        fact_capture(int(nodes[n].a), s)
        return fact_fresh(s, ntype(n))
    if k == .conv:
        outer = fact_covered
        if nodes[n].aux == i32(int(CV.refinement)): fact_covered = fact_refinement_covers(n)
        a = fact_capture(int(nodes[n].a), s)
        fact_covered = outer
        # Only parser-originated oversized literals carry this sign marker.
        # O(1) at a demanded conversion; open endpoints are not exact values.
        if nodes[n].aux == i32(int(CV.big2math)) and nodes[n].aux2 != 0:
            bound = if nodes[n].aux2 < 0: FactBound(FACT_MIN, -1, true) else: FactBound(1, FACT_MAX, true)
            return fact_new(s, bound, FactTerm(origin = n, type = T_MATH_INT))
        # Widening a signed word/exact word expression to int is the same
        # mathematical value, even when its interval is unbounded. Reuse its
        # value and provenance; unsigned coordinates still need decoding below.
        if nodes[n].aux == i32(int(CV.int_)) and ntype(n) == T_MATH_INT and ntype(int(nodes[n].a)) == T_INT: return a
        if nodes[n].aux == i32(int(CV.opt)):
            if ownership_decls.len() != 0: a = fact_owner_value(int(nodes[n].a), a, s)
            value = fact_new(s, FactBound(), FactTerm(type = ntype(n)))
            if s.projections.len() + 2 < FACT_CAP:
                fact_add_projection(s, FactProjection(value, -3, false, fact_constant(s, 1)))
                fact_add_projection(s, FactProjection(value, -4, false, a))
            return value
        if nodes[n].aux == i32(int(CV.refinement)):
            ref_check(n, a, ref_fact_current_entry(s), s)
            return a
        if nodes[n].aux == i32(int(CV.explicit_copy)):
            if ownership_decls.len() != 0 and ownership_fact_type(ntype(n)):
                fact_forget(s, n, .call, true)
                return fact_new(s, fact_domain(ntype(n), .call, n), FactTerm(type = ntype(n)))
            return a
        if nodes[n].aux == i32(int(CV.fixed2arr)): return a
        if nodes[n].aux == i32(int(CV.arr2fixed)):
            fact_fixed_check(n, s, a)
            if not fact_pure_conversion(n): fact_forget(s, n, .call)
            return fact_fresh(s, ntype(n))
        if ff_integer_demand(n):
            ff_integer_record(n, a, s)
            return fact_fresh(s, ntype(n))
        if nodes[n].aux == i32(int(CV.set_text)): return fact_new(s, FactBound(), FactTerm(type = ntype(n)))
        # (an exact quantity and its number are one value: lowering erases the
        # unit, so `b not=? 0kg` guards `a / b`'s rational divisor. O(1))
        # (an integer quantity's number too, and a unit constant, `3s` or `cm`, is its number)
        if (nodes[n].aux == i32(int(CV.none_)) or nodes[n].aux == i32(int(CV.quantity_const))) and fact_unit_erased(ntype(int(nodes[n].a)), ntype(n)): return a
        b = fact_bound(s, a)
        from = fact_type(ntype(int(nodes[n].a)))
        to = fact_type(ntype(n))
        if nodes[n].aux == i32(int(CV.int_)) and types[from].kind == .enum_ and simple_enum(from) and is_int(to):
            if not b.wide and sa_fits(b.lo, to) and sa_fits(b.hi, to): return a
            return fact_unmodeled(s, n, .unsupported)
        if nodes[n].aux == i32(int(CV.wrap_int)) or nodes[n].aux == i32(int(CV.saturate_int)):
            if not b.wide and from == to and (to == T_U64 or sa_fits(b.lo, to) and sa_fits(b.hi, to)): return a
            if not b.wide and to == T_U64 and from != T_U64 and b.lo >= 0:
                return fact_new(s, FactBound(b.lo xor FACT_MIN, b.hi xor FACT_MIN), FactTerm(type = T_U64))
            if not b.wide and from != T_U64 and to != T_U64 and sa_fits(b.lo, to) and sa_fits(b.hi, to): return a
            return fact_new(s, fact_domain(to, .unsupported, n), FactTerm(type = to))
        # (an `int` narrowed to a fixed width: the proven narrowing, an
        # obligation; effect_failure asks whether it fits)
        if nodes[n].aux == i32(int(CV.int_)) and prune(ntype(int(nodes[n].a))) == T_MATH_INT and prune(ntype(n)) != T_MATH_INT and fact_scalar(ntype(n)):
            proven = fact_narrow_check(n, s, a)
            # A progress-axiom narrowing supplies its fixed storage domain;
            # its mathematical intermediate must not remain unbounded downstream.
            if proven and exact_progress_math.has(n): return fact_new(s, fact_domain(to), FactTerm(type = to))
            if to != T_U64:
                # Successful checked narrowing preserves the mathematical
                # value too. Its obligation is still checked above; a summary
                # describes only returning paths. O(1) interval intersection.
                domain = fact_domain(to)
                b.lo = max(b.lo, domain.lo); b.hi = min(b.hi, domain.hi)
                b.wide = false
                # Keep the existing witness when no proof established this
                # conversion: later uses know its value, not why it fitted.
                if not proven and n != fact_covered: b.reason = .unsupported; b.witness = n
                fact_set_bound(s, a, b, true)
                return a
            if not proven or b.lo < 0: return fact_unmodeled(s, n, .unsupported)
            # (an open or wide upper end, capped by a guard, is uint64's own)
            top = if b.wide or b.hi == FACT_MAX and fact_open_endpoint(s, a, true): FACT_MAX else: b.hi xor FACT_MIN
            return fact_new(s, FactBound(b.lo xor FACT_MIN, top), FactTerm(type = T_U64))
        if from == to and nodes[n].aux == i32(int(CV.int_)): return a
        # (uint64 values, `uint64<overflow='wrap'>` too, hold encoded intervals: fact_type)
        if from != to and (to == T_U64 or from == T_U64):
            # (a value both types hold converts exactly: decode or encode its interval)
            if fact_scalar(ntype(n)) and fact_scalar(ntype(int(nodes[n].a))) and nodes[n].aux == i32(int(CV.int_)):
                if to == T_U64 and b.lo >= 0: return fact_new(s, FactBound(b.lo xor FACT_MIN, b.hi xor FACT_MIN), FactTerm(type = T_U64))
                if to != T_U64 and b.hi < 0 and sa_fits(b.lo xor FACT_MIN, ntype(n)) and sa_fits(b.hi xor FACT_MIN, ntype(n)):
                    r = FactBound(b.lo xor FACT_MIN, b.hi xor FACT_MIN)
                    r.nz = r.lo > 0
                    return fact_new(s, r, FactTerm(type = ntype(n)))
                # (a uint64 interval reaching past int64's top, as an `int`: its
                # low end stays, the top is open, and the term remembers its
                # origin, so fact_u64_capped knows it is at most 2^64-1)
                if to == T_MATH_INT and not b.wide and b.lo < 0 and b.hi >= 0 and (b.lo xor FACT_MIN) < FACT_MAX: return fact_new(s, FactBound(b.lo xor FACT_MIN, FACT_MAX, (b.lo xor FACT_MIN) > 0), FactTerm(origin = n, type = to))
            return fact_unmodeled(s, n, .unsupported)
        if fact_scalar(ntype(n)) and fact_scalar(ntype(int(nodes[n].a))) and (nodes[n].aux == i32(int(CV.int_)) or nodes[n].aux == i32(int(CV.none_))):
            fits = sa_fits(b.lo, ntype(n)) and sa_fits(b.hi, ntype(n))
            if fits: return a
            return fact_unmodeled(s, n, .unsupported)
        # (a float truncated to an integer: within the truncated ends of the
        # range the float walk finds for it, as the conversion fails outside
        # the target and for NaN. O(1) after one memoized walk of the owner)
        if nodes[n].aux == i32(int(CV.float2int)) and fact_scalar(ntype(n)) and is_int(to) and to != T_U64:
            if let r = ff_conversion_operand(fact_owner, n):
                if r.lo > -9.0e18 and r.hi < 9.0e18 and r.lo <= r.hi:
                    domain = fact_domain(to)
                    lo = max(int(r.lo), domain.lo); hi = min(int(r.hi), domain.hi)
                    if lo <= hi: return fact_new(s, FactBound(lo, hi, lo > 0 or hi < 0), FactTerm(type = ntype(n)))
        if not fact_pure_conversion(n): fact_forget(s, n, .call)
        return fact_new(s, FactBound(reason = .unsupported, witness = n))
    if k == .intrinsic:
        # (a GPU program, compiled from its literal function: the call runs nothing here)
        if nodes[n].aux == i32(int(IN.gpu_kernel)): return fact_fresh(s, ntype(n))
        id = nodes[n].aux as IN
        # (an array's or string's raw pointer reads its value and may make the array its own,
        # which changes no value; later writes through it are a call's or a store's)
        if id == .arrdata and nkids(n) == 1:
            fact_capture(kid(n, 0), s)
            return fact_fresh(s, ntype(n))
        if id == .setlen:
            size = fact_capture(kid(n, 1), s)
            route = fact_route(kid(n, 0), s)
            fresh = fact_new(s, FactBound(), FactTerm(type = ntype(kid(n, 0))))
            # Only the compiler's private dotted output is known to have just
            # been allocated and reserved. An arbitrary user call may detach
            # a shared array and lose its spare capacity before this write.
            if has_flag(n, NF_PRIVATE_SETLEN) and s.projections.len() < FACT_CAP:
                fact_add_projection(s, FactProjection(fresh, -1, false, size))
            fact_store_route(s, route, fresh, n, true)
            return fact_fresh(s, ntype(n))
        if id == .lend:
            extra = fact_capture(kid(n, 1), s)
            base = fact_capture(kid(n, 0), s)
            length = fact_project(s, base, -1, false, T_INT)
            # (typed by the reservation: the `$lend` block itself is not an integer)
            limit = fact_arithmetic(s, kid(n, 1), .plus, length, extra)
            # (the constant first: a by-value state argument is taken before later arguments run)
            zero = fact_constant(s, 0)
            if fact_speculating == 0 and fact_compare(s, .ge, extra, zero) == 0:
                loan_error(n, "negative reservation")
            fact_loans.push(FactLoan(place_route(kid(n, 0)), limit))
            result = fact_capture(kid(n, 2), s)
            fact_loans.pop()
            return result
        if id == .loan_length:
            value = fact_capture(kid(n, 1), s)
            if fact_speculating == 0:
                loop loan in fact_loans:
                    if loan.place == place_route(kid(n, 0)):
                        zero = fact_constant(s, 0)
                        lo = fact_compare(s, .ge, value, zero)
                        hi = fact_compare(s, .le, value, loan.capacity)
                        if lo == 0 or hi == 0: loan_error(n, "set_length exceeds the reserved capacity")
                        if fact_policy == .RequireStatic and (lo != 1 or hi != 1): fact_unknown(n, fact_bound(s, value), "loan capacity")
            route = fact_route(kid(n, 0), s)
            fresh = fact_new(s, FactBound(), FactTerm(type = ntype(kid(n, 0))))
            fact_add_projection(s, FactProjection(fresh, -1, false, value))
            fact_store_route(s, route, fresh, n)
            return 0
        if id == .loan_address or id == .loan_load or id == .loan_store:
            # Raw writes invalidate element facts; no address becomes evidence.
            if id == .loan_store: fact_forget(s, n, .write, true)
            return fact_fresh(s, ntype(n))
        # (a float square root, rounding, min/max or vector constructor reads
        # its operands and writes nothing)
        if fact_pure_intrinsic(id):
            loop j in [0..nkids(n)): fact_capture(kid(n, j), s)
            return fact_fresh(s, ntype(n))
        # (`bytes(text)`, which `text as array<uint8>` is: the text's byte view)
        if id == .to_bytes and nkids(n) == 1 and tkind(ntype(kid(n, 0))) == .str_: return fact_byte_view(s, fact_capture(kid(n, 0), s))
        if id == .len:
            base = fact_capture(kid(n, 0), s)
            t = fact_type(ntype(kid(n, 0)))
            if types[t].kind == .fixed: return fact_constant(s, fixed_len(t))
            return fact_project(s, base, -1, false, T_INT)
        if id == .push or id == .pop or id == .clear or id == .reserve or id == .insert or id == .remove:
            a = kid(n, 0)
            # Intrinsics lower value/selector operands before reacquiring the
            # receiver. Insertion evaluates its position before its value.
            position = 0
            loop i in [1..nkids(n)):
                captured = fact_capture(kid(n, i), s)
                if i == 1 or id != .insert: position = captured
            if id == .push and fact_push_frames.len() > 0: fact_push_record(n, s, position)
            route = fact_route(a, s)
            values = fact_route_values(s, route)
            base = if values.len() > 0: values[values.len() - 1] else: 0
            length = fact_project(s, base, -1, false, T_INT)
            if id == .reserve: return 0
            if (id == .pop or id == .remove) and fact_speculating == 0 and (fact_policy == .RequireStatic or fact_query): fact_removal(n, s, position, length)
            fresh = fact_new(s, FactBound(), FactTerm(type = ntype(a)))
            result = 0
            plain = ownership_decls.len() == 0 or not ownership_fact_type(ntype(a))
            if plain and id == .pop:
                last = fact_arithmetic(s, a, .minus, length, fact_constant(s, 1))
                result = fact_project(s, base, last, true, ntype(n))
            size = fact_new(s, FactBound(0, fact_length_max(), reason = .write, witness = n))
            if id == .clear: size = fact_constant(s, 0)
            else:
                old = fact_bound(s, length)
                delta = if id == .push or id == .insert: 1 else: -1
                if old.lo >= 0 and (delta < 0 or old.hi < FACT_MAX):
                    size = fact_new(s, FactBound(max(0, old.lo + delta), min(fact_length_max(), max(0, old.hi + delta))))
                # (the new length is the old one plus or minus one exactly: a
                # row where an interval cannot say it (`let i=xs.length`,
                # `xs.push(v)`, `return i` below the new length), outside
                # loops, and for a removal in them, which an insertion can undo)
                # (and in a run changing a record's tied fields, which its end checks together)
                if old.lo != old.hi and (fact_loops.len() == 0 or delta < 0 or fact_pair_transient):
                    fact_difference(s, size, length, delta, n)
                    fact_difference(s, length, size, -delta, n)
                # (in a loop, an insertion's row only says it grew: a head keeps a length the backedge
                # holds at least at entry's, fact_loop_shape)
                else if old.lo != old.hi and delta > 0 and fact_incident(s, length) >= 0: fact_difference(s, length, size, 0, n)
                # (a sibling bound's elements stay below a length that only grew, though it was a constant)
                else if old.lo == old.hi and delta > 0 and ref_self_active: fact_difference(s, length, size, 0, n)
            if plain and id == .push and position != 0 and fact_loops.len() == 0 and tkind(fact_type(ntype(kid(n, 1)))) == .array:
                appended = fact_replace(s, base, length, true, position, ntype(a))
                fresh = fact_replace(s, appended, -1, false, size, ntype(a))
            else if s.projections.len() < FACT_CAP: fact_add_projection(s, FactProjection(fresh, -1, false, size))
            if ref_self_active and plain and (id == .pop or id == .remove): fact_shrunk_elements(s, base, fresh)
            fact_store_route(s, route, fresh, n, true)
            return if result != 0: result else: fact_fresh(s, ntype(n))
        # `xs.extend(ys)` grows by ys's length, `truncate(k)` never grows,
        # `resize(k)` makes max(0, k): the operand first, then the receiver,
        # as push's.
        if id == .extend or id == .truncate or id == .resize:
            operand = fact_capture(kid(n, 1), s)
            a = kid(n, 0)
            route = fact_route(a, s)
            values = fact_route_values(s, route)
            base = if values.len() > 0: values[values.len() - 1] else: 0
            length = fact_project(s, base, -1, false, T_INT)
            old = fact_bound(s, length)
            size = 0
            if id == .resize: size = fact_clamped(s, operand, n)
            else if id == .truncate:
                if fact_speculating == 0 and (fact_policy == .RequireStatic or fact_query) and files[pos_file(nodes[n].pos)].is_dewy:
                    zero = fact_constant(s, 0)
                    c = fact_compare(s, .ge, operand, zero)
                    if c != 1: wit_operation(n, s, .ge, wit_side(operand, kid(n, 1)), WitSide(zero, 0, "0", false, true), c, "truncate's count is negative", "truncate's count is nonnegative")
                count = fact_bound(s, operand)
                size = fact_new(s, FactBound(min(old.lo, max(0, count.lo)), min(old.hi, max(0, count.hi)), reason = .write, witness = n))
                fact_difference(s, size, length, 0, n)
                # (a count known within the length is the new length exactly: `truncate(half)`)
                if not count.wide and count.lo >= 0 and fact_compare(s, .le, operand, length) == 1:
                    fact_difference(s, size, operand, 0, n)
                    fact_difference(s, operand, size, 0, n)
            else:
                ot = fact_type(ntype(kid(n, 1)))
                added = if tkind(ot) == .fixed: fact_constant(s, fixed_len(ot)) else if tkind(ot) == .array: fact_project(s, operand, -1, false, T_INT) else: 0
                grown = if added != 0: fact_bound(s, added) else: FactBound(0, fact_length_max())
                lo = if old.lo >= 0 and grown.lo >= 0 and fact_add_fits(old.lo, grown.lo): min(old.lo + grown.lo, fact_length_max()) else: 0
                hi = if old.hi >= 0 and grown.hi >= 0 and fact_add_fits(old.hi, grown.hi): min(old.hi + grown.hi, fact_length_max()) else: fact_length_max()
                size = fact_new(s, FactBound(lo, hi, reason = .write, witness = n))
                fact_difference(s, length, size, 0, n)
                if added != 0 and grown.lo == grown.hi:
                    fact_difference(s, size, length, grown.lo, n)
                    fact_difference(s, length, size, -grown.lo, n)
                # (an empty receiver, as `[s...]`'s: the new length is the operand's)
                else if added != 0 and old.lo == 0 and old.hi == 0: size = added
                # (a receiver of known length, as `[x ys...]`'s: the operand's length plus it)

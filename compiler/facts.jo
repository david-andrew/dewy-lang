        outer = fact_covered
        init = int(nodes[n].b)
        if index_update_arrays.len() > 0 and index_update_arrays.has(int(nodes[n].name)) and init != 0 and nodes[init].kind == .conv and nodes[init].aux == i32(int(CV.int_)): fact_covered = init
        r = if nodes[n].b != 0: fact_capture(int(nodes[n].b), s) else: fact_default_value(n, s)

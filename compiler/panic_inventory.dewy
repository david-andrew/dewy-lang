$runtime_checks
from p"directives.jo" import (DIR_PROTOTYPE DIR_RUNTIME dir_assume_local_asserts dir_name_assumed_bounds dir_policy dir_value)
from p"expr.jo" import (IN ntype)
from p"check.jo" import (LF_ADDR LF_ALIAS LF_ASSIGNED LF_BYREF LF_CAPTURE LF_CAPTURED LF_EXPOSED LF_MUTPARAM LF_PARAM LF_SHARED LF_VALUEPARAM fns lib_dir locals modules)
from p"ast.jo" import (NF_EXTERN NF_U64 RANGE_EXHAUSTION has_flag kid nkids nodes)
from p"types.jo" import (T_INT T_MATH_INT T_STR is_int tkind)
from p"draw_context.jo" import (draw_context_guard draw_required)
from p"effect_control.dewy" import (effect_name)
from p"effects.jo" import (effect_panic_nodes effect_panic_pending effect_panic_texts effect_panics_demanded effect_panics_settled panic_answer panic_draw panic_edge_at panic_edge_end panic_edges panic_index panic_lib panic_local panic_local_via panic_low panic_name_format panic_name_fraction panic_name_policy_power panic_name_pow panic_name_pow_op panic_name_power panic_name_rational panic_name_to panic_serial panic_stack panic_stop panic_via panic_witness)
from p"effect_sites.dewy" import (effect_write_sites)
from p"exact.jo" import (exact_has_node)
from p"facts.jo" import (fact_array_call fact_complete_deferred fact_divisors fact_exact_sum_call fact_floor_call fact_map_call fact_nonempty_call fact_panic_sites fact_pool_call fact_power_call fact_progress_strip fact_range_call fact_range_first fact_rational_constructor fact_rational_divmod fact_string_call fn_in_lib positive_bound)
from p"util.jo" import (files intern lib_root name_of pos_file pos_in_lib pos_str)
from p"isolation.jo" import (isolation_children)
from p"refine.jo" import (representation_type str_set_of str_sets)
from p"lower_helpers.dewy" import (value_helper_calls)
# Demanded panic inventory; shared state has one owner in effects.jo.
PanicWord:type=int64<overflow='wrap'>
effect_panics_reset=():>void=>$unsafe {
    effect_panics_demanded=false
    effect_panics_settled=false
    effect_panic_nodes=dict<int64 int64>()
    effect_panic_pending=dict<int64 bool>()
    effect_panic_texts=dict<int64 string>()
    panic_index=[]
    panic_low=[]
    panic_answer=[]
    panic_witness=[]
    panic_via=[]
    panic_local=[]
    panic_local_via=[]
    panic_edge_at=[]
    panic_edge_end=[]
    panic_edges=[]
    panic_stack=[]
    panic_serial=0
}
# A deferred obligation (`$runtime_checks`, `$prototype`, or the default while
# it is still runtime checks) at n in f's body.
effect_panic_note=(f:PanicWord n:PanicWord what:string provisional:bool=false):>void=>$unsafe {
    if f <=? 0 {return}
    let cached_old=effect_panic_nodes.get(f)
    if cached_old not=? none {
        let old=cached_old
        let pending=effect_panic_pending.has(f)
        # Prefer a settled check to a provisional one, then a check whose scope
        # refuses the local assumption: a local witness must not hide it.
        if pending =? provisional {
            if not dir_assume_local_asserts(nodes.ptr[old].pos) or dir_assume_local_asserts(nodes.ptr[n].pos) {return}
        }
        else if provisional {return}
    }
    if provisional {effect_panic_pending[f] = true;}
    else {effect_panic_pending.remove(f);}
    effect_panic_nodes[f] = n;
    effect_panic_texts[f] = what;
}
# The exhaustive-match fallback cannot run. A marked range check is decided
# by facts as an obligation; message text never exempts an exhaustion panic.
panic_synthesized=(n:PanicWord):>bool=>$unsafe {
    if nodes.ptr[n].aux2 =? int32(RANGE_EXHAUSTION) {return true}
    if nkids(n) =? 0 or nodes.ptr[kid(n 0)].kind not=? 'str_lit' {return false}
    return name_of(PanicWord(nodes.ptr[kid(n 0)].sval)) =? "no match arm matched"
}
# A string argument's possible texts where the compiler knows them: a literal, a
# binding written once by its declaration (its initial value), or a value whose
# type is a set of literal strings. None: unknown.
panic_literal_texts=(e0:PanicWord):>array<string>?=>$unsafe {
    let e=e0
    loop nodes.ptr[e].kind =? 'conv' {e=PanicWord(nodes.ptr[e].a)}
    if nodes.ptr[e].kind =? 'ident' and nodes.ptr[e].aux =? int32(1) {
        let l:PanicWord=PanicWord(nodes.ptr[e].sym)
        if PanicWord(locals.ptr[l].flags) & (LF_ASSIGNED | LF_CAPTURE | LF_CAPTURED | LF_SHARED | LF_ADDR | LF_PARAM) not=? 0 {return none}
        loop q in effect_write_sites(l) {
            if nodes.ptr[q].kind =? 'vardecl' and nodes.ptr[q].sym =? int32(l) and nodes.ptr[q].b not=? 0 {e=PanicWord(nodes.ptr[q].b)}
        }
        loop nodes.ptr[e].kind =? 'conv' {e=PanicWord(nodes.ptr[e].a)}
    }
    if nodes.ptr[e].kind =? 'str_lit' and nkids(e) =? 0 and nodes.ptr[e].sval >? 0 {return [name_of(PanicWord(nodes.ptr[e].sval))]}
    let id=str_set_of(ntype(e))
    if id <=? 0 {return none}
    let texts:array<string>=[]
    loop member in str_sets.ptr[id] {texts.push(member);}
    return texts
}
# `format(x spec)` with a specification the library accepts for x, a literal or
# a known one (panic_literal_texts) (lib/core/fmt.jo and lib/math_int.jo,
# __format_checked) cannot fail: a bad specification is its only failure.
# Checked here once per call, as its own grammar.
panic_format_literal=(n:PanicWord):>bool=>$unsafe {
    if nkids(n) not=? 2 {return false}
    let d:PanicWord=PanicWord(fns.ptr[PanicWord(nodes.ptr[n].sym)].decl)
    if panic_name_format =? 0 {
        panic_name_format=intern("format")
        panic_name_to=intern("to")
    }
    if d =? 0 or PanicWord(nodes.ptr[d].name) not=? panic_name_format {return false}
    let path=files.ptr[pos_file(nodes.ptr[d].pos)].path
    if path not=? "{lib_dir}/core/fmt.jo" and path not=? "{lib_dir}/math_int.jo" {return false}
    let t=representation_type(ntype(kid(n 0)))
    let cached_texts=panic_literal_texts(kid(n 1))
    if cached_texts not=? none {
        let texts=cached_texts
        loop spec in texts {
            if not panic_format_spec(spec t) {return false}
        }
        return true
    }
    return false
}
panic_format_spec=(spec:string t:PanicWord):>bool=>$unsafe {
    let bytes=spec as array<uint8>
    let text=t =? T_STR
    let kinds=if text {"s"} else if tkind(t) =? 'float_' {"feEgG%"} else if is_int(t) or t =? T_MATH_INT {"dxXbofeEgG%"} else {""}
    if kinds =? "" {return false}
    let i:PanicWord=0
    let m=bytes.length
    if m >=? 2 and (bytes.ptr[1] =? 60 or bytes.ptr[1] =? 62 or bytes.ptr[1] =? 94) {i=2}
    else if m >=? 1 and (bytes.ptr[0] =? 60 or bytes.ptr[0] =? 62 or bytes.ptr[0] =? 94) {i=1}
    let flags=i
    if i <? m and bytes.ptr[i] =? 43 {i += 1;}
    if i <? m and bytes.ptr[i] =? 35 {i += 1;}
    let alt=i >? flags and bytes.ptr[i - 1] =? 35
    let plus=i >? flags and bytes.ptr[flags] =? 43
    let first=i
    loop i <? m and (bytes.ptr[i] >=? 48 and bytes.ptr[i] <=? 57) {i += 1;}
    let zero=i >? first and bytes.ptr[first] =? 48
    if i - first >? 18 {return false}
    let group:PanicWord=0
    if i <? m and (bytes.ptr[i] =? 44 or bytes.ptr[i] =? 95) {
        group=PanicWord(bytes.ptr[i])
        i += 1;
    }
    let precision=false
    if i <? m and bytes.ptr[i] =? 46 {
        i += 1;
        first=i
        loop i <? m and (bytes.ptr[i] >=? 48 and bytes.ptr[i] <=? 57) {i += 1;}
        if i =? first or i - first >? 18 {return false}
        precision=true
    }
    let kind:PanicWord=0
    if i <? m {
        if find_byte(kinds bytes.ptr[i]) <? 0 {return false}
        kind=PanicWord(bytes.ptr[i])
        i += 1;
    }
    if i not=? m {return false}
    let integer_base=kind not=? 0 and find_byte("xXbo" uint8<overflow='wrap'>(kind)) >=? 0
    if alt and not integer_base or group not=? 0 and integer_base {return false}
    if not text and precision and kind not=? 0 and find_byte("dxXbo" uint8<overflow='wrap'>(kind)) >=? 0 {return false}
    return not text or not (precision or plus or alt or zero or group not=? 0)
}
# `x.to(device)` with a literal device this build places on ('best' or 'cpu':
# lib/std/nd.jo) cannot fail, a literal-typed binding included.
panic_device_literal=(n:PanicWord):>bool=>$unsafe {
    if nkids(n) not=? 2 or panic_name_to =? 0 {return false}
    let d:PanicWord=PanicWord(fns.ptr[PanicWord(nodes.ptr[n].sym)].decl)
    if d =? 0 or PanicWord(nodes.ptr[d].name) not=? panic_name_to or files.ptr[pos_file(nodes.ptr[d].pos)].path not=? "{lib_dir}/std/nd.jo" {return false}
    let cached_texts=panic_literal_texts(kid(n 1))
    if cached_texts not=? none {
        let texts=cached_texts
        loop text in texts {
            if text not=? "best" and text not=? "cpu" {return false}
        }
        return true
    }
    return false
}
# The accepted progress axiom also covers Atomic<int64>.add. A syntactically
# bounded step needs no history. Otherwise only a stored, immutable scalar
# parameter is admitted here: a load of the counter (including via a local)
# could be geometric growth. Unknown steps keep the ordinary panic obligation.
# This is an O(step-expression) query only at calls of the resolved primitive;
# it creates no graph and never changes the checked implementation's trap.
panic_atomic_progress=(n:PanicWord):>bool=>$unsafe {
    if nkids(n) not=? 3 or nodes.ptr[n].aux not=? 0 or nodes.ptr[n].sym <=? 0 {return false}
    let f:PanicWord=PanicWord(nodes.ptr[n].sym)
    let d:PanicWord=PanicWord(fns.ptr[f].decl)
    if d =? 0 or name_of(PanicWord(nodes.ptr[d].name)) not=? "add" or files.ptr[pos_file(nodes.ptr[d].pos)].path not=? "{lib_dir}/std/thread.jo" {return false}
    if fns.ptr[f].targs.length not=? 1 or fns.ptr[f].targs.ptr[0] not=? T_INT {return false}
    if dir_value(dir_name_assumed_bounds nodes.ptr[n].pos) =? 1 {return false}
    let step=kid(n 1)
    let literal=panic_literal(step)
    if literal not=? 0 {return true}
    if positive_bound(step false) >=? 0 {return true}
    if exact_has_node(step) {return false}
    step=fact_progress_strip(step)
    if nodes.ptr[step].kind not=? 'ident' or nodes.ptr[step].aux not=? int32(1) {return false}
    let l:PanicWord=PanicWord(nodes.ptr[step].sym)
    let flags:PanicWord=PanicWord(locals.ptr[l].flags)
    return flags & (LF_PARAM | LF_VALUEPARAM) not=? 0 and flags & (LF_ASSIGNED | LF_MUTPARAM | LF_ALIAS | LF_BYREF | LF_ADDR | LF_CAPTURE | LF_CAPTURED | LF_SHARED | LF_EXPOSED) =? 0
}
# A program's `d[k]` (or `d[k] += 1`, `d.pop(k)`): the key's presence is its
# obligation (facts.jo fact_map_check), proven, an error or its own check.
panic_map_obligation=(n:PanicWord):>bool=>$unsafe {
    let m=fact_map_call(n)
    if m >=? 2 and m <=? 4 {return true}
    # (a pool's `pool[h]`, `pool[h] = x` and `__pool_index`: the handle's membership)
    m=fact_pool_call(n)
    return m >=? 2 and m <=? 4
}
panic_literal=(e0:PanicWord):>int64=>$unsafe {
    let e=e0
    loop e >? 0 and nodes.ptr[e].kind =? 'conv' {e=PanicWord(nodes.ptr[e].a)}
    if e >? 0 and (nodes.ptr[e].kind =? 'int_lit' and not has_flag(e NF_U64) or nodes.ptr[e].kind =? 'bool_lit') {return e}
    return 0
}
panic_literal_safe=(n:PanicWord):>bool=>$unsafe {
    if k_call_args(n) <? 2 {return false}
    let d:PanicWord=PanicWord(fns.ptr[PanicWord(nodes.ptr[n].sym)].decl)
    if d =? 0 or not pos_in_lib(nodes.ptr[d].pos) {return false}
    if panic_name_power =? 0 {
        panic_name_power=intern("__dewy_power")
        # (a wrapping or saturating word's power: its products cannot fail)
        panic_name_policy_power=intern("__dewy_policy_power")
        panic_name_rational=intern("rational")
        panic_name_pow=intern("pow")
        panic_name_pow_op=intern("__pow__")
        panic_name_fraction=intern("_fraction")
    }
    let name:PanicWord=PanicWord(nodes.ptr[d].name)
    # (a range constructor's: unstepped, or two distinct literal first values)
    if fact_range_first(n false) >=? 0 {return true}
    let first=fact_range_first(n true)
    if first >=? 0 {
        let a=panic_literal(kid(n first))
        let b=panic_literal(kid(n first + 1))
        return a not=? 0 and b not=? 0 and nodes.ptr[a].ival not=? nodes.ptr[b].ival
    }
    if (name =? panic_name_power or name =? panic_name_policy_power or name =? panic_name_pow or name =? panic_name_pow_op) and nkids(n) =? 2 {
        let e=panic_literal(kid(n 1))
        return e not=? 0 and nodes.ptr[e].ival >=? 0
    }
    if (name =? panic_name_rational or name =? panic_name_fraction) and nkids(n) =? 2 {
        let e=panic_literal(kid(n 1))
        return e not=? 0 and nodes.ptr[e].ival not=? 0
    }
    return false
}
# A range whose two first values are distinct literals: its step is not zero.
panic_literal_step=(it:PanicWord):>bool=>$unsafe {
    let a=panic_literal(PanicWord(nodes.ptr[it].a))
    let b=panic_literal(PanicWord(nodes.ptr[it].c))
    return a not=? 0 and b not=? 0 and nodes.ptr[a].ival not=? nodes.ptr[b].ival
}
k_call_args=(n:PanicWord):>int64=>$unsafe {
    if nodes.ptr[n].kind =? 'call' and nodes.ptr[n].aux =? 0 and nodes.ptr[n].sym >? 0 {return nkids(n)}
    return 0
}
panic_edge=(f:PanicWord g:PanicWord n:PanicWord):>void=>$unsafe {
    if g <=? 0 or g >=? fns.length or g =? f {return}
    panic_edges.push(g);
    panic_edges.push(n);
}
panic_site=(f:PanicWord n:PanicWord):>void=>$unsafe {
    # (a library body's answer is settled by its first panic; its call sites are not checked)
    if n =? 0 or panic_stop and panic_witness.ptr[f] not=? 0 {return}
    let k=nodes.ptr[n].kind
    if k =? 'intrinsic' {
        let id=nodes.ptr[n].aux as IN
        # (the library's `assert` and `unreachable` state its invariants; its
        # `panic` is a failure a caller can cause. In a program, `assert` is a
        # check the compiler made, as unpacking's: an obligation for facts)
        let explicit=id =? IN.panic or id =? IN.runtime_assert or id =? IN.unreachable and not panic_lib
        if explicit and panic_witness.ptr[f] =? 0 and not panic_synthesized(n) {
            # Library panics state caller preconditions, not the library's own
            # handling. Keep their unconditional answer and short-circuit scan.
            if (id =? IN.panic and not panic_lib or id =? IN.runtime_assert) and dir_assume_local_asserts(nodes.ptr[n].pos) {
                if panic_local.ptr[f] =? 0 {panic_local.ptr[f] = n;}
            }
            else {panic_witness.ptr[f] = n;}
        }
    }
    else if k =? 'call' and nodes.ptr[n].aux =? 0 or k =? 'fnref' or k =? 'lambda' or k =? 'pair' or k =? 'partial' and nodes.ptr[n].aux =? 0 {
        # Draw context is checked at the program/library boundary, like bounds.
        if panic_draw and k =? 'call' and nodes.ptr[n].sym =? int32(draw_context_guard) {
            draw_required.ptr[f] = true;
            return
        # (a call whose precondition is the caller's obligation, as a string
        # index or a divisor: proven, an error, or a check of the caller's own)
        }
        if nodes.ptr[n].sym >? 0 and not (k =? 'call' and (fact_string_call(n) >=? 2 or fact_array_call(n) not=? 0 or fact_floor_call(n) not=? 0 or fact_divisors.has(n) or fact_rational_constructor(n) or fact_power_call(n) or panic_format_literal(n) or panic_device_literal(n) or panic_atomic_progress(n) or not panic_lib and (panic_map_obligation(n) or fact_range_call(n) or fact_nonempty_call(n) or fact_exact_sum_call(n) or fact_rational_divmod(n)) or panic_literal_safe(n))) {panic_edge(f PanicWord(nodes.ptr[n].sym) n);}
    }
    if k =? 'binary' or k =? 'intrinsic' {
        loop g in value_helper_calls(n) {panic_edge(f g n);}
    }
}
# The full walk is needed only when fact demand did not inventory the body.
panic_node=(f:PanicWord n:PanicWord):>void=>$unsafe {
    if n =? 0 or panic_stop and panic_witness.ptr[f] not=? 0 {return}
    panic_site(f n);
    let k=nodes.ptr[n].kind
    if k =? 'parallel_region' {
        panic_node(f PanicWord(nodes.ptr[n].a));
        return
    }
    let mask=isolation_children(k)
    if mask <? 0 {return}
    if mask & 1 not=? 0 {panic_node(f PanicWord(nodes.ptr[n].a));}
    if mask & 2 not=? 0 {panic_node(f PanicWord(nodes.ptr[n].b));}
    if mask & 4 not=? 0 {panic_node(f PanicWord(nodes.ptr[n].c));}
    if mask & 16 not=? 0 {
        loop i in [0..nkids(n)) {panic_node(f kid(n i));}
    }
}
panic_scan=(f:PanicWord):>void=>$unsafe {
    fact_complete_deferred(f);
    panic_edge_at.ptr[f] = panic_edges.length;
    panic_edge_end.ptr[f] = panic_edges.length;
    let d:PanicWord=PanicWord(fns.ptr[f].decl)
    let cached_n=effect_panic_nodes.get(f)
    if cached_n not=? none {
        let n=cached_n
        if dir_assume_local_asserts(nodes.ptr[n].pos) {panic_local.ptr[f] = n;}
        else {panic_witness.ptr[f] = n;}
    }
    if fns.ptr[f].state not=? 2 or fns.ptr[f].body =? 0 or d not=? 0 and has_flag(d NF_EXTERN) {return}
    if d not=? 0 and modules.ptr[PanicWord(fns.ptr[f].mod)].is_prelude and files.ptr[pos_file(nodes.ptr[d].pos)].path =? "{lib_dir}/core/rt.jo" {return}
    panic_lib=fn_in_lib(f)
    panic_draw=panic_lib and draw_context_guard not=? 0
    panic_stop=panic_lib and not panic_draw
    let cached_sites=fact_panic_sites.get(f)
    if cached_sites not=? none {
        let sites=cached_sites
        loop n in sites {panic_site(f n);}
    }
    else {panic_node(f PanicWord(fns.ptr[f].body));}
    panic_edge_end.ptr[f] = panic_edges.length;
}
# The solver (Tarjan over scanned bodies) runs in effect_panics.dewy; these
# are its services: a body's scan, a component's draw check, a call's opt-in.
panic_host_scan=(f:int64):>bool=>$unsafe {
    panic_scan(f);
    return fn_in_lib(f)
}
panic_host_opted=(n:int64):>bool=>$unsafe {
    let p=nodes.ptr[n].pos
    if p >? 0 and not pos_in_lib(p) and dir_assume_local_asserts(p) {
        let policy=dir_policy(p)
        if policy =? DIR_RUNTIME or policy =? DIR_PROTOTYPE {return true}
    }
    return false
}
# A function's name as a program writes it (`xs.insert` reaches `__dewy_insert`).
effect_shown_name=(f:PanicWord):>string=>$unsafe {
    let name=effect_name(f)
    if starts_with(name "__dewy_") {return remove_prefix(name "__dewy_")}
    return name
}
# Why f may panic, following its witnesses: `first -> the library: first of an
# empty array (lib/core/array.jo:5:20)`.
effect_panic_reason=(f:PanicWord):>string=>$unsafe {
    let chain=effect_shown_name(f)
    let g=f
    let seen=[f]
    loop depth in [0..8) {
        let h=panic_via.ptr[g]
        if h =? 0 {break}
        if seen.contains(h) {
            chain="{chain} (recursive)"
            break
        }
        seen.push(h);
        let hd:PanicWord=PanicWord(fns.ptr[h].decl)
        # (the library's own helpers are its business)
        if hd =? 0 or not pos_in_lib(nodes.ptr[hd].pos) or not starts_with(effect_name(h) "__") {chain="{chain} -> {effect_name(h)}"}
        g=h
    }
    let n=panic_witness.ptr[g]
    if n =? 0 {return chain}
    let what=""
    let cached_text=effect_panic_texts.get(g)
    if cached_text not=? none {
        let text=cached_text
        if panic_witness.ptr[g] =? effect_panic_nodes[g] {what="runtime check: {dir_text(text)}"}
    }
    if what =? "" and nodes.ptr[n].kind =? 'intrinsic' {
        let id=nodes.ptr[n].aux as IN
        what=if id =? IN.runtime_assert {"`$runtime_assert`"} else if id =? IN.unreachable {"unreachable"} else if id =? IN.assert {"assert"} else {"panic"}
        if nkids(n) >? 0 and nodes.ptr[kid(n 0)].kind =? 'str_lit' and nodes.ptr[kid(n 0)].sval >? 0 and nkids(kid(n 0)) =? 0 {what="{what} \"{name_of(PanicWord(nodes.ptr[kid(n 0)].sval))}\""}
    }
    if what =? "" {return chain}
    let at=pos_str(nodes.ptr[n].pos)
    if starts_with(at lib_root) {at="lib{remove_prefix(at lib_root)}"}
    return "{chain}: {what} at {at}"
}
dir_text=(what:string):>string=>$unsafe {
    if starts_with(what "cannot prove ") {return remove_prefix(what "cannot prove ")}
    return what
}

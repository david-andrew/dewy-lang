$runtime_checks
from p"checker_scope_symbols.dewy" import (scope_reset)

from p"checker_hooks.dewy" import (block_sibling)
from p"checker_sinks.dewy" import (sink_close)
from p"node_store.dewy" import (Node node_aux2 node_op)
from p"source_types.dewy" import SrcFile
from p"checker_state.dewy" import (CheckerScope StatementWatch)
from p"checker_types.dewy" import TypeInfo
from p"type_inference.dewy" import (tu_prune tu_zonk)
from p"checker_vardecls.dewy" import vd_decl
from p"checker_assigns.dewy" import va_assign
from p"checker_statements.dewy" import (st_const st_drop st_defer st_when)
from p"checker_exprstmts.dewy" import es_statement
from p"checker_loops.dewy" import (xb_while xb_jump)
from p"checker_for_loops.dewy" import fl_for
from p"checker_returns.dewy" import xt_return
from p"checker_conditionals.dewy" import xf_if
from p"checker_literals.dewy" import xl_finish
from p"checker_expr.dewy" import check_expr
from p"literal_snapshots.dewy" import (literal_snapshot_context literal_sequence_context)
from p"checker_store_checks.dewy" import (stmt_assign)
from p"checker_block_entries.dewy" import (block_open)
from p"checks_assign_hooks.dewy" import (block_expand block_direct block_final)
from p"checks_stmt_hooks.dewy" import (stmt_special stmt_error stmt_terminates)
# A block's statements in its scope, and each statement sent to its checker: a
# declaration, an assignment (or the declaration it makes, or a dropped value), an
# expression, a loop, a return or jump, a local constant, `defer`, `when` and an `if`
# run in their Dewy leaves, as do the way a block's values go (its sink), the value
# statement ending a value block and its result; `if let`, a checked `if` again, `$expect`
# tests, reflected scopes, shaped dimensions and the value a value
# block ends with are host services, as are its sinks (where a body's, an arm's or a
# binding's values go) when it has them. Sibling records followed through the block
# are asked about only while their tables are live. O(statements) plus their checking;
# statements may grow every arena, so nodes and lists are reread by ID.
BWord:type=int64<overflow='wrap'>
CheckerBlockInput:type=[
    nodes:ptr<array<Node>>
    lists:ptr<array<int32>>
    files:ptr<array<SrcFile>>
    types:ptr<array<TypeInfo>>
    last:ptr<int64>
    scopes:ptr<CheckerScope>
    context:ptr<int64>
    watch:ptr<StatementWatch>
    sibling_block:ptr<int64>
    sibling_index:ptr<int64>
    flow_local:ptr<int64>
    body_mode:ptr<int64>
    arm_next:ptr<int64>
    bind_next:ptr<int64>
    discarding:ptr<bool>
    exact:ptr<bool>
    void_type:ptr<int64>
    never_type:ptr<int64>
]
let bk_nodes:ptr<array<Node>>=$unsafe (uint64(0) as ptr<array<Node>>)
let bk_lists:ptr<array<int32>>=$unsafe (uint64(0) as ptr<array<int32>>)
let bk_files:ptr<array<SrcFile>>=$unsafe (uint64(0) as ptr<array<SrcFile>>)
let bk_types:ptr<array<TypeInfo>>=$unsafe (uint64(0) as ptr<array<TypeInfo>>)
let bk_last:ptr<int64>=$unsafe (uint64(0) as ptr<int64>)
let bk_scopes:ptr<CheckerScope>=$unsafe (uint64(0) as ptr<CheckerScope>)
let bk_context:ptr<int64>=$unsafe (uint64(0) as ptr<int64>)
let bk_watch:ptr<StatementWatch>=$unsafe (uint64(0) as ptr<StatementWatch>)
let bk_sibling_block:ptr<int64>=$unsafe (uint64(0) as ptr<int64>)
let bk_sibling_index:ptr<int64>=$unsafe (uint64(0) as ptr<int64>)
let bk_flow_local:ptr<int64>=$unsafe (uint64(0) as ptr<int64>)
let bk_body_mode:ptr<int64>=$unsafe (uint64(0) as ptr<int64>)
let bk_arm_next:ptr<int64>=$unsafe (uint64(0) as ptr<int64>)
let bk_bind_next:ptr<int64>=$unsafe (uint64(0) as ptr<int64>)
let bk_discarding:ptr<bool>=$unsafe (uint64(0) as ptr<bool>)
let bk_exact:ptr<bool>=$unsafe (uint64(0) as ptr<bool>)
let bk_void_type:ptr<int64>=$unsafe (uint64(0) as ptr<int64>)
let bk_never_type:ptr<int64>=$unsafe (uint64(0) as ptr<int64>)
checker_blocks_bind=(input:ptr<CheckerBlockInput>):>BWord=>$unsafe {
    bk_nodes=input[0].nodes
    bk_lists=input[0].lists
    bk_files=input[0].files
    bk_types=input[0].types
    bk_last=input[0].last
    bk_scopes=input[0].scopes
    bk_context=input[0].context
    bk_watch=input[0].watch
    bk_sibling_block=input[0].sibling_block
    bk_sibling_index=input[0].sibling_index
    bk_flow_local=input[0].flow_local
    bk_body_mode=input[0].body_mode
    bk_arm_next=input[0].arm_next
    bk_bind_next=input[0].bind_next
    bk_discarding=input[0].discarding
    bk_exact=input[0].exact
    bk_void_type=input[0].void_type
    bk_never_type=input[0].never_type
    0
}
bk_flag=(n:BWord f:BWord):>bool=>$unsafe {BWord(bk_nodes[0].ptr[n].flags) & f not=? 0}
# `x = value`: `_ = value` drops it, a first `x = value` declares x (Tok.assign 47; a
# spawn's call aux2 17).
bk_assign=(s:BWord):>void=>$unsafe {
    let lhs=BWord(bk_nodes[0].ptr[s].a)
    let op=node_op(bk_nodes[0].ptr[s].op_ext)
    let lk=bk_nodes[0].ptr[lhs].kind
    if lk =? 'hole' and op =? 47 {st_drop(s); return}
    if op =? 47 and (lk =? 'ident' or lk =? 'tuple') {
        if stmt_assign(s) {vd_decl(s); return}
    } else {
        let b=BWord(bk_nodes[0].ptr[s].b)
        if bk_nodes[0].ptr[b].kind =? 'call' and node_aux2(bk_nodes[0].ptr[b].op_ext) =? 17 {stmt_error(s 3)}
    }
    let r=va_assign(s)
    if r not=? s {bk_nodes[0].ptr[s]=bk_nodes[0].ptr[r]}
}
bk_stmt_dim_slow=(s:BWord):>void=>$unsafe {
    stmt_special(s 2)
    let nd=bk_nodes[0].ptr + s
    let k=nd[0].kind
    if k =? 'reflect_scope' {stmt_special(s 3); return}
    if (k =? 'vardecl' or k =? 'const_') and BWord(nd[0].flags) & 128 not=? 0 {return}
    if k =? 'vardecl' {vd_decl(s)}
    else if k =? 'const_' {st_const(s)}
    else if k =? 'assign' {bk_assign(s)}
    else {bk_stmt(s)}
}
bk_stmt_watched=(s:BWord b:BWord):>void=>$unsafe {
    if bk_watch[0].sibling_flow >? 0 {block_sibling(s 0 1)}
    if bk_watch[0].sibling_known >? 0 {block_sibling(s b 2)}
    else {bk_stmt(s)}
}
bk_stmt_loop_plain=(b:BWord n:BWord):>void=>$unsafe {
    let i:BWord=0
    loop i <? n {
        let s=BWord(bk_lists[0].ptr[BWord(bk_nodes[0].ptr[b].list) + i])
        bk_sibling_index[0]=i
        if bk_watch[0].sibling_flow >? 0 or bk_watch[0].sibling_known >? 0 {bk_stmt_watched(s b)}
        else {bk_stmt(s)}
        let l=bk_flow_local[0]
        if l not=? 0 {
            block_sibling(l bk_nodes[0].ptr[s].pos 3)
            bk_flow_local[0]=0
        }
        i=i + 1
    }
}
# One statement (NF_CHECKED 128: a quantity constant settled before its module's code
# ran; a shaped parameter's dimension is aux2 1789).
bk_stmt=(s:BWord):>void=>$unsafe {
    match bk_nodes[0].ptr[s].kind {
        <'exprstmt'> => {es_statement(s)}
        <'vardecl'> => {
            if node_aux2(bk_nodes[0].ptr[s].op_ext) =? 1789 {bk_stmt_dim_slow(s); return}
            if BWord(bk_nodes[0].ptr[s].flags) & 128 =? 0 {vd_decl(s)}
        }
        <'assign'> => {
            if bk_exact[0] and node_op(bk_nodes[0].ptr[s].op_ext) not=? 47 and bk_context[0] >=? 0 {stmt_special(s 1)}
            bk_assign(s)
        }
        <'if_'> => {bk_if(s)}
        <'return_'> => {xt_return(s)}
        <'for_'> => {fl_for(s)}
        <'while_'> => {xb_while(s)}
        <'const_'> => {if BWord(bk_nodes[0].ptr[s].flags) & 128 =? 0 {st_const(s)}}
        <'break_' | 'continue_'> => {xb_jump(s)}
        <'iflet'> => {stmt_special(s 4)}
        <'defer_'> => {st_defer(s)}
        <'when_'> => {st_when(s)}
        <'block'> => {bk_block(s 0 false);}
        <'reflect_scope'> => {stmt_special(s 3)}
        <'fn_' | 'struct_' | 'enum_' | 'import_'> => {stmt_error(s 1)}
        <'test_' | 'build_'> => {}
        _ => {stmt_error(s 2)}
    }
}
# An `if` statement (NF_STMT 16); one checked before (NF_CHECKED 128 with its type) goes
# to the host whole. (A frame of its own: the dispatcher's stays as small as it was.)
bk_if=(s:BWord):>void=>$unsafe {
    let f=BWord(bk_nodes[0].ptr[s].flags)
    if f & 128 not=? 0 and bk_nodes[0].ptr[s].type not=? 0 {
        stmt_special(s 4)
        return
    }
    bk_nodes[0].ptr[s].flags=int32<overflow='wrap'>(f | 16)
    xl_finish(s xf_if(s 0) 0);
    if bk_watch[0].expectations >? 0 {stmt_special(s 5)}
}
# How a block's values go (sink modes: 1 one value, 2 a function body's, 3 an arm's,
# 4 a collector's, 6 a binding's; -1 none): a body's mode set by its function, else a Dewy
# value block's by its place (NF_COMPREHENSION 67108864). A discarding block (NF_DISCARD
# 8) is the host's whole (open -1, -2 wanting a value); a sink is opened by it.
bk_open=(b:BWord want_value:bool):>BWord=>$unsafe {
    let mode:BWord=-1
    if bk_body_mode[0] >=? 0 {
        mode=bk_body_mode[0]
        bk_body_mode[0]=-1
    } else if bk_flag(b 8) {
        return block_open(b if want_value {-2} else {-1})
    } else if want_value and bk_files[0].ptr[BWord(bk_nodes[0].ptr[b].pos) >> 40].is_dewy {
        if bk_flag(b 67108864) {mode=4}
        else if bk_arm_next[0] =? b {mode=3}
        else if bk_bind_next[0] =? b {mode=6}
        else {mode=1}
    }
    bk_arm_next[0]=0
    bk_bind_next[0]=0
    if mode >=? 0 {
        block_open(b mode);
        bk_discarding[0]=false
    }
    mode
}
# The value statement ending a value block: its result type, or -1 when it is a statement
# (a spawn's call, aux2 17). An `if` ending it and a value going to a body, an arm or a
# binding (collected) are the host's; NF_STMT 16 off a match, NF_CHECKED 128.
bk_final=(b:BWord i:BWord expected:BWord mode:BWord):>BWord=>$unsafe {
    let s=BWord(bk_lists[0].ptr[BWord(bk_nodes[0].ptr[b].list) + i])
    let k=bk_nodes[0].ptr[s].kind
    if k =? 'if_' or k =? 'iflet' {return block_final(b i expected mode)}
    if k not=? 'exprstmt' {return -1}
    let e=BWord(bk_nodes[0].ptr[s].a)
    if bk_nodes[0].ptr[e].kind =? 'call' and node_aux2(bk_nodes[0].ptr[e].op_ext) =? 17 {return -1}
    if mode =? 2 or mode =? 3 or mode =? 6 {return block_final(b i expected mode)}
    if bk_nodes[0].ptr[e].kind =? 'match_' {bk_nodes[0].ptr[e].flags=int32<overflow='wrap'>(BWord(bk_nodes[0].ptr[e].flags) & -17)}
    let result=BWord(check_expr(e expected))
    bk_nodes[0].ptr[s].a=int32<overflow='wrap'>(bk_last[0])
    if bk_types[0].ptr[tu_prune(result)].kind not=? 'void_' {bk_nodes[0].ptr[b].aux=1}
    if result =? bk_never_type[0] {bk_nodes[0].ptr[b].aux=0}
    bk_nodes[0].ptr[s].flags=int32<overflow='wrap'>(BWord(bk_nodes[0].ptr[s].flags) | 128)
    result
}
# A value block's result: never when its last statement ends every path (NF_FLOW_RETURNS
# 1073741824), its inference variables solved (TF_HAS_VAR 1); then its sink closed.
bk_finish=(b:BWord result0:BWord mode:BWord n:BWord want_value:bool):>BWord=>$unsafe {
    let result=result0
    if want_value {
        if bk_nodes[0].ptr[b].aux =? 0 and n >? 0 and stmt_terminates(BWord(bk_lists[0].ptr[BWord(bk_nodes[0].ptr[b].list) + n - 1])) {result=bk_never_type[0]}
        if bk_flag(b 1073741824) {result=bk_never_type[0]}
        if result not=? 0 and BWord(bk_types[0].ptr[result].flags) & 1 not=? 0 {result=tu_zonk(result)}
    }
    if mode >=? 0 {result=BWord(sink_close(b result))}
    result
}
# A block (its statements' tests are written out: a call costs more than they do;
# NF_LOOP_SETUP 131072, NF_FLOW_RETURNS 1073741824, NF_DISCARD 8; sinks: body
# 2, bind 6), its value's type when want_value.
bk_block=(b:BWord expected:BWord want_value:bool):>BWord=>$unsafe {
    # (a lowered combined loop is a statement wherever it stands: its body's values go where
    # the loop's own would, to the enclosing collector or body, as a single-header loop's do)
    # Mark synthetic sequencing unscoped only after parsing: parser-level lifting
    # would detach the receiving context. Ownership/lowering still see the scope.
    let bn0=bk_nodes[0].ptr + b
    let baux2=node_aux2(bn0[0].op_ext)
    if baux2 =? -17 or baux2 =? -20 or baux2 =? -21 {
        bn0[0].flags=int32<overflow='wrap'>(BWord(bn0[0].flags) | 4)
        if want_value and baux2 =? -17 {literal_snapshot_context(b expected)}
        else if want_value and baux2 =? -21 {literal_sequence_context(b expected)}
        bn0=bk_nodes[0].ptr + b
    }
    let pos=BWord(bn0[0].pos)
    let bflags=BWord(bn0[0].flags)
    if want_value and (bflags & 131072) not=? 0 and bk_files[0].ptr[pos >> 40].is_dewy {
        bk_block(b 0 false);
        let result=if bk_flag(b 1073741824) {bk_never_type[0]} else {bk_void_type[0]}
        bk_nodes[0].ptr[b].type=int32<overflow='wrap'>(result)
        return result
    }
    let mode:BWord=-1
    let was_discarding=bk_discarding[0]
    if want_value or bk_body_mode[0] >=? 0 or (bflags & 8) not=? 0 {mode=bk_open(b want_value)}
    else {
        bk_arm_next[0]=0
        bk_bind_next[0]=0
    }
    let counted=mode =? 2 or mode =? 6
    let bn=bk_nodes[0].ptr + b
    let transparent=bn[0].aux =? 5 and not want_value
    # (`( ... )`, NF_UNSCOPED 4: its names stay visible after it, value or not)
    let unscoped=(BWord(bn[0].flags) & 4) not=? 0
    let n0=BWord(bn[0].nlist)
    if n0 >? 0 {
        let lbase_p=bk_lists[0].ptr + BWord(bn[0].list)
        let np=bk_nodes[0].ptr
        let i:BWord=0
        loop i <? n0 {
            if np[BWord(lbase_p[i])].kind =? 'when_' {
                block_expand(b)
                break
            }
            i=i + 1
        }
    }
    let mark=bk_scopes[0].names.length
    let result=bk_void_type[0]
    let bn2=bk_nodes[0].ptr + b
    bn2[0].aux=0
    let n=BWord(bn2[0].nlist)
    let saved_block=bk_sibling_block[0]
    let saved_index=bk_sibling_index[0]
    bk_sibling_block[0]=b
    if not want_value and not counted {
        bk_stmt_loop_plain(b n)
    } else {
        let i:BWord=0
        loop i <? n {
            let s=BWord(bk_lists[0].ptr[BWord(bk_nodes[0].ptr[b].list) + i])
            bk_sibling_index[0]=i
            if counted {block_direct(s)}
            let value:BWord=-1
            if i =? n - 1 and want_value {value=bk_final(b i expected mode)}
            if value >=? 0 {result=value}
            else {
                if bk_watch[0].sibling_flow >? 0 or bk_watch[0].sibling_known >? 0 {bk_stmt_watched(s b)}
                else {bk_stmt(s)}
                let l=bk_flow_local[0]
                if l not=? 0 {
                    block_sibling(l bk_nodes[0].ptr[s].pos 3)
                    bk_flow_local[0]=0
                }
            }
            i=i + 1
        }
    }
    if bk_watch[0].sibling_flow >? 0 {block_sibling(b 0 4)}
    bk_sibling_block[0]=saved_block
    bk_sibling_index[0]=saved_index
    if want_value or mode >=? 0 {result=bk_finish(b result mode n want_value)}
    if mode >=? 0 {bk_discarding[0]=was_discarding}
    let bnf=bk_nodes[0].ptr + b
    bnf[0].type=int32<overflow='wrap'>(result)
    if transparent {bnf[0].aux=5}
    else if not unscoped and bk_scopes[0].names.length not=? mark {scope_reset(mark)}
    result
}

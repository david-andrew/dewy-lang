# Frozen twin of call_forward.dewy for the builds without a Dewy frontend: they forward nothing,
# and check every call through a function value as such.
value_call_forward = (n: int, giver: int, decls: int[], args: int[], expected: int) -> int: -1
value_binding_forward = (n: int, callee: int, args: int[], expected: int) -> int: -1

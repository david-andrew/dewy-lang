use 'ir_types.dewy'
use 'ir.jo'
use 'ir_builders.dewy'
use 'opt_workspace.dewy'
use 'opt.jo'

# Frozen scalar-replacement pass from opt.jo.
# ---------------- small slots to registers ----------------
# Non-escaping slots of at most four lanes (32 bytes) become registers. Standalone byte and
# two-byte slots use one integer lane. Four-byte lanes cover
# vec2..vec4 and small i32/f32 records; eight-byte lanes cover i64/f64 records.
# Mixed-width accesses, incompatible lane kinds, and escaping addresses retain
# memory storage. Address discovery also selects lane widths, without another
# full optimization pass. Larger records stay in memory to bound register pressure.
# One function-local indexed workspace, shared by discovery, escape validation
# and rewriting. Its storage is reused, but no pointer escapes an optimization.
struct SraValue:
    slot: int = -1
    offset: int

struct SraSlot:
    width: int = 8
    ok: bool

struct SraLane:
    kind: int              # 0 untyped bits, 1 float, 2 integer
    reg: int = -1

sra_value_storage: SraValue[]
sra_slot_storage: SraSlot[]
sra_lane_storage: SraLane[]
sra_values: *SraValue
sra_slots: *SraSlot
sra_lanes: *SraLane
sra_nv = 0

sra_workspace = (nv: int, ns: int):
    if sra_value_storage.len() < nv: sra_value_storage.resize(nv)
    if sra_slot_storage.len() < ns: sra_slot_storage.resize(ns)
    if sra_lane_storage.len() < ns * 4: sra_lane_storage.resize(ns * 4)
    sra_values = data(sra_value_storage)
    sra_slots = data(sra_slot_storage)
    sra_lanes = data(sra_lane_storage)
    # Other fields belong to a definition, a resolved address, or a lane.
    # Initialize them when publishing that state, not for every unused vreg.
    loop v in [0..nv):
        sra_values[v].slot = -1
    loop slot in [0..ns):
        size = int(ir.slot_size[slot])
        width = 8
        if size == 1 or size == 2: width = size
        else if size % 8 != 0: width = 4
        sra_slots[slot] = SraSlot(width, false)

sra_shift = (width: int) -> int: if width == 8: 3 else: width >> 1

# May this byte range be used as lanes of kind k (0: just bits, copied)?
sra_lane_use = (s: int, off: int, bytes: int, k: int) -> bool:
    width = sra_slots[s].width
    if int(ir.slot_size[s]) >> sra_shift(width) > 4: return false
    if k == 1 and width < 4: return false
    if off < 0 or off & (width - 1) != 0 or bytes & (width - 1) != 0 or off + bytes > int(ir.slot_size[s]): return false
    loop i in [0..(bytes >> sra_shift(width))):
        j = s * 4 + (off >> sra_shift(width)) + i
        if k != 0:
            if sra_lanes[j].kind != 0 and sra_lanes[j].kind != k: return false
            sra_lanes[j].kind = k
    true

# Copies join lanes into classes. The forward pass keeps integer and float memory apart, so a
# copy between lanes and memory must access each word as what it is: a lane that is only copied
# (kind 0) takes the one kind its class shows. A class showing neither kind, or both, that a copy
# joins to memory keeps its slots in memory (each slot leaving makes its other classes reach
# memory too), where the copy stays a copy. O(P + L log L) for P pending operations and L lanes;
# nothing is allocated for a function whose slots meet no copy.
sra_find = (parent: mut int[], j: int) -> int:
    let j = j
    loop parent[j] != j:
        parent[j] = parent[parent[j]]
        j = parent[j]
    j

sra_lane_first = (v: int) -> int: sra_values[v].slot * 4 + (sra_values[v].offset >> sra_shift(sra_slots[sra_values[v].slot].width))
sra_lane_count = (s: int) -> int: int(ir.slot_size[s]) >> sra_shift(sra_slots[s].width)

sra_copy_kinds = (code: *Ins, pending: int[], ns: int):
    copies: int[]
    loop pos in pending:
        if code[pos].op == .copy: copies.push(pos)
    if copies.len() == 0: return
    n = ns * 4
    parent = fill(0, n)
    loop j in [0..n): parent[j] = j
    flags = fill(0, n)             # at a class root: 1 float, 2 integer, 4 reaches memory
    loop pos in copies:
        ins = code[pos]
        a = int(ins.a)
        b = int(ins.b)
        pa = sra_is_p(a)
        pb = sra_is_p(b)
        if not pa and not pb: continue
        m = int(ins.imm) >> sra_shift(sra_slots[sra_values[if pa: a else: b].slot].width)
        loop i in [0..m):
            if pa and pb:
                ra = sra_find(parent, sra_lane_first(a) + i)
                rb = sra_find(parent, sra_lane_first(b) + i)
                if ra != rb:
                    parent[ra] = rb
                    flags[rb] = flags[rb] | flags[ra]
            else:
                x = if pa: a else: b
                r = sra_find(parent, sra_lane_first(x) + i)
                flags[r] = flags[r] | 4
    head = fill(-1, n)             # at a class root: its first lane; then each lane's next
    next = fill(-1, n)
    loop s in [0..ns):
        if not sra_slots[s].ok: continue
        loop i in [0..sra_lane_count(s)):
            j = s * 4 + i
            r = sra_find(parent, j)
            flags[r] = flags[r] | sra_lanes[j].kind
            next[j] = head[r]
            head[r] = j
    # slots of the classes with no single kind that reach memory leave, which can make more
    # classes reach memory: each slot leaves once
    work: int[]
    loop s in [0..ns):
        if not sra_slots[s].ok: continue
        loop i in [0..sra_lane_count(s)):
            f = flags[sra_find(parent, s * 4 + i)]
            if f & 4 != 0 and (f & 3 == 0 or f & 3 == 3):
                work.push(s)
                break
    loop work.len() > 0:
        s = work.pop()
        if not sra_slots[s].ok: continue
        sra_slots[s].ok = false
        loop i in [0..sra_lane_count(s)):
            r = sra_find(parent, s * 4 + i)
            if flags[r] & 4 != 0: continue
            flags[r] = flags[r] | 4
            if flags[r] & 3 == 1 or flags[r] & 3 == 2: continue
            j = head[r]
            loop j >= 0:
                work.push(j >> 2)
                j = next[j]
    loop s in [0..ns):
        if not sra_slots[s].ok: continue
        loop i in [0..sra_lane_count(s)):
            f = flags[sra_find(parent, s * 4 + i)] & 3
            if sra_lanes[s * 4 + i].kind == 0 and (f == 1 or f == 2): sra_lanes[s * 4 + i].kind = f

sra_is_p = (v: int) -> bool: v >= 0 and v < sra_nv and sra_values[v].slot >= 0 and sra_slots[sra_values[v].slot].ok
sra_lane_of = (v: int, i: int) -> int: sra_lanes[sra_values[v].slot * 4 + (sra_values[v].offset >> sra_shift(sra_slots[sra_values[v].slot].width)) + i].reg

# Definition updates are O(removed + emitted operations), with no rebuild.
# SRA preserves control structure. Uses/CFG are indexed once after its rewrite;
# forward maintains output use counts, shared by DCE and cleanup.
sra_index_nv = 0
sra_emit = (out: mut Ins[], ins: Ins):
    loop sra_index_nv < ir.vtypes.len():
        o_resize_one(sra_index_nv)
        sra_index_nv += 1
    if ins.dst >= 0 and o_defines(ins.op):
        o_regs[int(ins.dst)].ndef += 1
    out.push(ins)

# A lane as vreg type ty, preserving bits between equal-width float/integer lanes.
sra_as_ty = (out: mut Ins[], x: int, ty: int) -> int:
    if vtype(x) == ty: return x
    t = vreg(ty)
    if ty != VI: sra_emit(out, Ins(.bits2f, i32(ty), i32(t), i32(x), 0, 0, 0))
    else: sra_emit(out, Ins(.f2bits, i32(vtype(x)), i32(t), i32(x), 0, 0, 0))
    t

# Resolve only address definitions that have a use. The chain follows strictly
# earlier definitions, so it is acyclic; each candidate is memoized once. The
# explicit stack avoids compiler-stack growth for long address chains.
sra_chain: int[]
sra_resolve_address = (value: int) -> int:
    sra_chain.clear()
    v = value
    loop sra_values[v].slot == -2:
        pos = o_regs[v].defpos
        if o_regs[v].ndef != 1:
            sra_values[v].slot = -1
            break
        ins = ir.code[pos]
        a = int(ins.a)
        if sra_values[a].slot == -1 or o_regs[a].defpos >= pos:
            sra_values[v].slot = -1
            break
        if ins.op == .add:
            b = int(ins.b)
            if not is_kv(b) and not (o_regs[b].ndef == 1 and ir.code[o_regs[b].defpos].op == .iconst and o_regs[b].defpos < pos):
                sra_values[v].slot = -1
                break
        sra_chain.push(v)
        v = a
    loop sra_chain.len() > 0:
        d = sra_chain.pop()
        ins = ir.code[o_regs[d].defpos]
        a = int(ins.a)
        sra_values[d].slot = sra_values[a].slot
        if sra_values[a].slot >= 0:
            offset = sra_values[a].offset
            if ins.op == .add:
                b = int(ins.b)
                offset += if is_kv(b): kv_of(b) else: ir.code[o_regs[b].defpos].imm
            sra_values[d].offset = offset
    sra_values[value].slot

# Keep the overwhelmingly common cached query separate from chain resolution.
sra_address = (value: int) -> int:
    if value < 0: return -1
    slot = sra_values[value].slot
    if slot == -2: return sra_resolve_address(value)
    slot

sra_escape = (value: int):
    slot = sra_address(value)
    if slot >= 0: sra_slots[slot].ok = false

# O(N + U + A + M + output): one definition index, one use walk, and a
# worklist containing only M slot-memory operations. Address resolution visits
# each of A demanded definitions once. The final rewrite runs only on success.
sra_nested = false
o_sra = ():
    sra_nested = false
    o_resize(ir.vtypes.len())
    ns = ir.slot_size.len()
    if ns == 0: return
    code = data(ir.code)
    count = ir.code.len()
    nv = ir.vtypes.len()
    sra_nv = nv
    sra_workspace(nv, ns)
    roots: int[]
    loop pos in [0..count):
        ins = &code[pos]
        d = int(ins.dst)
        op = ins.op
        if d < 0 or not o_defines(op): continue
        o_regs[d].ndef += 1
        o_regs[d].defpos = i32(pos)
        if op == .slot: roots.push(pos)
        else if op == .mov or op == .add: sra_values[d].slot = -2
    any = false
    loop pos in roots:
        ins = &code[pos]
        d = int(ins.dst)
        slot = int(ins.a)
        if o_regs[d].ndef == 1 and int(ir.slot_size[slot]) <= 32:
            sra_values[d].slot = slot
            sra_values[d].offset = 0
            sra_slots[slot].ok = true
            any = true
        else: sra_values[d].slot = -1
    if not any: return
    pending: int[]
    loop pos in [0..count):
        ins = &code[pos]
        op = ins.op
        a = int(ins.a)
        b = int(ins.b)
        c = int(ins.c)
        match op:
            slot, zeroslots: continue
            mov, add:
                if sra_address(int(ins.dst)) >= 0: continue
                sra_escape(a)
                if op == .add: sra_escape(b)
                continue
            load:
                sa = sra_address(a)
                if sa >= 0:
                    if o_regs[a].defpos < pos and sra_slots[sa].width == 8 and c & 15 != 8: sra_slots[sa].width = 4
                    if c & M_INDEX == 0:
                        pending.push(pos)
                        continue
                sra_escape(a)
                if c & M_INDEX != 0: sra_escape(b)
                continue
            store:
                sa = sra_address(a)
                sb = sra_address(b)
                if sb >= 0: sra_slots[sb].ok = false
                if c & M_INDEX != 0:
                    sd = sra_address(int(ins.dst))
                    if sd >= 0: sra_slots[sd].ok = false
                if sa >= 0:
                    if o_regs[a].defpos < pos and sra_slots[sa].width == 8 and c & 15 != 8: sra_slots[sa].width = 4
                    pending.push(pos)
                continue
            vop:
                sa = sra_address(a)
                sb = sra_address(b)
                sc = sra_address(c)
                if sa >= 0 and o_regs[a].defpos < pos: sra_slots[sa].width = 4
                if sb >= 0 and o_regs[b].defpos < pos: sra_slots[sb].width = 4
                if sc >= 0 and o_regs[c].defpos < pos: sra_slots[sc].width = 4
                if sa >= 0 or sb >= 0 or sc >= 0: pending.push(pos)
                continue
            copy, zero:
                sa = sra_address(a)
                sb = if op == .copy: sra_address(b) else: -1
                if sa >= 0 and o_regs[a].defpos < pos and sra_slots[sa].width == 8 and (sra_values[a].offset % 8 != 0 or ins.imm % 8 != 0): sra_slots[sa].width = 4
                if sb >= 0 and o_regs[b].defpos < pos and sra_slots[sb].width == 8 and (sra_values[b].offset % 8 != 0 or ins.imm % 8 != 0): sra_slots[sb].width = 4
                if sa >= 0 or sb >= 0: pending.push(pos)
                continue
            nop, iconst, fconst, gaddr, daddr, faddr, block, loop, end, else_, br, trap, vzu: pass
            intr, call, syscall, calli, callc:
                loop k in [a..a + b): sra_escape(int(ir.args[k]))
                if op == .calli or op == .callc: sra_escape(c)
            ret:
                if a >= 0: sra_escape(a)
            if_, brif, brtable, assume, neg, not_, fneg, fsqrt, fabs, ffloor, fceil, ftrunc, sext8, sext16, sext32, zext8, zext16, zext32, i2f, u2f, f2i, f2f, bits2f, f2bits, vsplat:
                sra_escape(a)
            memcpy, memset, select, memeq, findbyte, scanbytes, findb:
                sra_escape(a)
                sra_escape(b)
                sra_escape(c)
            vst:
                sra_escape(a)
                sra_escape(b)
                sra_escape(int(ins.dst))
            _:
                sra_escape(a)
                sra_escape(b)
    # Lanes keep their observed numeric kind; copy-only lanes contain integer bits.
    any = false
    loop s in [0..ns):
        if int(ir.slot_size[s]) & (sra_slots[s].width - 1) != 0 or int(ir.slot_size[s]) >> sra_shift(sra_slots[s].width) > 4: sra_slots[s].ok = false
        if sra_slots[s].ok: any = true
    if not any: return
    loop lane in [0..ns * 4): sra_lanes[lane].kind = 0
    loop pos in pending:
        ins = &code[pos]
        op = ins.op
        a = int(ins.a)
        b = int(ins.b)
        c = int(ins.c)
        # every use of a slot address must be one of these
        if op == .load and a >= 0 and sra_values[a].slot >= 0 and c & M_INDEX == 0:
            if c & 15 != sra_slots[sra_values[a].slot].width or not sra_lane_use(sra_values[a].slot, sra_values[a].offset + ins.imm, c & 15, if c & M_FLOAT != 0: 1 else: 2): sra_slots[sra_values[a].slot].ok = false
            continue
        if op == .store:
            if b >= 0 and sra_values[b].slot >= 0: sra_slots[sra_values[b].slot].ok = false
            if c & M_INDEX != 0 and int(ins.dst) >= 0 and sra_values[int(ins.dst)].slot >= 0: sra_slots[sra_values[int(ins.dst)].slot].ok = false
            if a >= 0 and sra_values[a].slot >= 0:
                if c & M_INDEX != 0 or c & 15 != sra_slots[sra_values[a].slot].width or not sra_lane_use(sra_values[a].slot, sra_values[a].offset + ins.imm, c & 15, if c & M_FLOAT != 0: 1 else: 2): sra_slots[sra_values[a].slot].ok = false
            continue
        if op == .vop:
            n = (ins.imm >> 4) & 7
            if a >= 0 and sra_values[a].slot >= 0 and not sra_lane_use(sra_values[a].slot, sra_values[a].offset, 4 * n, 1): sra_slots[sra_values[a].slot].ok = false
            if ins.imm & VOP_SPLAT_B != 0:
                if b >= 0 and sra_values[b].slot >= 0: sra_slots[sra_values[b].slot].ok = false
            else if b >= 0 and sra_values[b].slot >= 0 and not sra_lane_use(sra_values[b].slot, sra_values[b].offset, 4 * n, 1): sra_slots[sra_values[b].slot].ok = false
            if ins.imm & VOP_SPLAT_C != 0:
                if c >= 0 and sra_values[c].slot >= 0: sra_slots[sra_values[c].slot].ok = false
            else if c >= 0 and sra_values[c].slot >= 0 and not sra_lane_use(sra_values[c].slot, sra_values[c].offset, 4 * n, 1): sra_slots[sra_values[c].slot].ok = false
            continue
        if op == .copy:
            # Keep one side in memory when copy endpoints use different lane widths.
            if a >= 0 and b >= 0 and sra_values[a].slot >= 0 and sra_values[b].slot >= 0 and sra_slots[sra_values[a].slot].width != sra_slots[sra_values[b].slot].width:
                if sra_slots[sra_values[a].slot].width > sra_slots[sra_values[b].slot].width: sra_slots[sra_values[a].slot].ok = false
                else: sra_slots[sra_values[b].slot].ok = false
            if a >= 0 and sra_values[a].slot >= 0 and not sra_lane_use(sra_values[a].slot, sra_values[a].offset, int(ins.imm), 0): sra_slots[sra_values[a].slot].ok = false
            if b >= 0 and sra_values[b].slot >= 0 and not sra_lane_use(sra_values[b].slot, sra_values[b].offset, int(ins.imm), 0): sra_slots[sra_values[b].slot].ok = false
            continue
        if op == .zero:
            if a >= 0 and sra_values[a].slot >= 0 and not sra_lane_use(sra_values[a].slot, sra_values[a].offset, int(ins.imm), 0): sra_slots[sra_values[a].slot].ok = false
            continue
        if (op == .add or op == .mov) and int(ins.dst) >= 0 and sra_values[int(ins.dst)].slot >= 0: continue
        if op == .slot: continue
        if op == .zeroslots: continue
        ir_operands(ins[0])
        loop operand_index in [0..ir_use_count):
            let u = ir_use(operand_index)
            if sra_values[u].slot >= 0: sra_slots[sra_values[u].slot].ok = false
    sra_copy_kinds(code, pending, ns)
    # a register per lane
    any = false
    loop s in [0..ns):
        if not sra_slots[s].ok: continue
        loop i in [0..(int(ir.slot_size[s]) >> sra_shift(sra_slots[s].width))):
            ty = if sra_lanes[s * 4 + i].kind == 1: (if sra_slots[s].width == 8: VF else: VS) else: VI
            sra_lanes[s * 4 + i].reg = vreg(ty)
            any = true
    if not any: return
    # Rewrite, updating the shared definition index at each mutation.
    sra_index_nv = nv
    out: Ins[]
    out.reserve(count + count / 4)
    loop input_pos in [0..count):
        ins = &code[input_pos]
        op = ins.op
        a = int(ins.a)
        b = int(ins.b)
        c = int(ins.c)
        d = int(ins.dst)
        if (op == .slot or op == .add or op == .mov) and sra_is_p(d):
            o_regs[d].ndef -= 1
            continue
        if op == .load and sra_is_p(a):
            o_regs[d].ndef -= 1
            width = sra_slots[sra_values[a].slot].width
            ty = if width == 8: VF else: VS
            x = sra_lane_of(a, int((ins.imm >> sra_shift(width))))
            if c & M_FLOAT != 0: sra_emit(out, Ins(.mov, i32(ty), i32(d), i32(sra_as_ty(out, x, ty)), 0, 0, 0))
            else if width == 8: sra_emit(out, Ins(.mov, VI, i32(d), i32(sra_as_ty(out, x, VI)), 0, 0, 0))
            else:
                conv = if width == 1: Op.zext8 else if width == 2: Op.zext16 else: Op.zext32
                if c & M_SIGNED != 0: conv = if width == 1: Op.sext8 else if width == 2: Op.sext16 else: Op.sext32
                sra_emit(out, Ins(conv, VI, i32(d), i32(sra_as_ty(out, x, VI)), 0, 0, 0))
            continue
        if op == .store and sra_is_p(a):
            if sra_address(b) >= 0: sra_nested = true
            x = sra_lane_of(a, int((ins.imm >> sra_shift(sra_slots[sra_values[a].slot].width))))
            sra_emit(out, Ins(.mov, i32(vtype(x)), i32(x), i32(sra_as_ty(out, b, vtype(x))), 0, 0, 0))
            continue
        if op == .vop and (sra_is_p(a) or (ins.imm & VOP_SPLAT_B == 0 and sra_is_p(b)) or (ins.imm & VOP_SPLAT_C == 0 and sra_is_p(c))):
            n = (ins.imm >> 4) & 7
            fop = [Op.fadd, Op.fsub, Op.fmul, Op.fdiv][ins.imm & 3]
            loop i in [0..n):
                x = b
                if ins.imm & VOP_SPLAT_B == 0:
                    if sra_is_p(b): x = sra_as_ty(out, sra_lane_of(b, i), VS)
                    else:
                        x = vreg(VS)
                        sra_emit(out, Ins(.load, VS, i32(x), i32(b), 0, i32(4 | M_FLOAT), 4 * i))
                y = c
                if ins.imm & VOP_SPLAT_C == 0:
                    if sra_is_p(c): y = sra_as_ty(out, sra_lane_of(c, i), VS)
                    else:
                        y = vreg(VS)
                        sra_emit(out, Ins(.load, VS, i32(y), i32(c), 0, i32(4 | M_FLOAT), 4 * i))
                r = vreg(VS)
                sra_emit(out, Ins(fop, VS, i32(r), i32(x), i32(y), 0, 0))
                # (lane i of the result needs only lane i of the operands: written at once, so
                # it is computed right into its lane, even when the destination is a source)
                if sra_is_p(a):
                    t = sra_lane_of(a, i)
                    sra_emit(out, Ins(.mov, i32(vtype(t)), i32(t), i32(sra_as_ty(out, r, vtype(t))), 0, 0, 0))
                else: sra_emit(out, Ins(.store, VS, 0, i32(a), i32(r), i32(4 | M_FLOAT), 4 * i))
            continue
        if op == .copy and (sra_is_p(a) or sra_is_p(b)):
            width = sra_slots[sra_values[if sra_is_p(a): a else: b].slot].width
            n = int((ins.imm >> sra_shift(width)))
            xs: int[]
            loop i in [0..n):
                if sra_is_p(b): xs.push(sra_lane_of(b, i))
                else:
                    ty = if sra_is_p(a): vtype(sra_lane_of(a, i)) else: VI
                    x = vreg(ty)
                    m = width
                    if ty != VI: m = width | M_FLOAT
                    sra_emit(out, Ins(.load, i32(ty), i32(x), i32(b), 0, i32(m), width * i))
                    xs.push(x)
            loop i in [0..n):
                if sra_is_p(a):
                    t = sra_lane_of(a, i)
                    sra_emit(out, Ins(.mov, i32(vtype(t)), i32(t), i32(sra_as_ty(out, xs[i], vtype(t))), 0, 0, 0))
                else:
                    m = width
                    if vtype(xs[i]) != VI: m = width | M_FLOAT
                    sra_emit(out, Ins(.store, i32(vtype(xs[i])), 0, i32(a), i32(xs[i]), i32(m), width * i))
            continue
        if op == .zero and sra_is_p(a):
            loop i in [0..int((ins.imm >> sra_shift(sra_slots[sra_values[a].slot].width)))):
                t = sra_lane_of(a, i)
                if vtype(t) != VI:
                    sra_emit(out, Ins(.fconst, i32(vtype(t)), i32(t), 0, 0, 0, 0))
                else: sra_emit(out, Ins(.mov, VI, i32(t), i32(k_vreg(0)), 0, 0, 0))
            continue
        out.push(ins[0])
        if op == .zeroslots:
            # (lanes of slots cleared here start at zero)
            loop k in [0..b):
                item = int(ir.args[a + k])
                if item & 1 == 0 and sra_slots[item >> 1].ok:
                    s = item >> 1
                    loop i in [0..(int(ir.slot_size[s]) >> sra_shift(sra_slots[s].width))):
                        t = sra_lanes[s * 4 + i].reg
                        if vtype(t) != VI: sra_emit(out, Ins(.fconst, i32(vtype(t)), i32(t), 0, 0, 0, 0))
                        else: sra_emit(out, Ins(.mov, VI, i32(t), i32(k_vreg(0)), 0, 0, 0))
    ir.code = out

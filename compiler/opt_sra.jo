use 'opt_rewrite.dewy'
use 'opt_registers.dewy'
use 'ir_types.dewy'
use 'ir.jo'
use 'ir_builders.dewy'
use 'opt_workspace.dewy'
use 'opt.jo'

# Frozen scalar-replacement pass from opt.jo.
# ---------------- small slots to registers ----------------
# Non-escaping slots of at most four lanes (32 bytes) become registers. Standalone byte and
# two-byte slots use one integer lane. Four-byte lanes cover
# vec2..vec4 and small i32/f32 records; eight-byte lanes cover i64/f64 records.
# Mixed-width accesses, incompatible lane kinds, and escaping addresses retain
# memory storage. Address discovery also selects lane widths, without another
# full optimization pass. Larger records stay in memory to bound register pressure.
# One function-local indexed workspace, shared by discovery, escape validation
# and rewriting. Its storage is reused, but no pointer escapes an optimization.
struct SraValue:
    slot: i32 = -1
    offset: i32

struct SraSlot:
    width: int = 8
    ok: bool
    in_loop: bool

struct SraLane:
    kind: int              # 0 untyped bits, 1 float, 2 integer
    reg: int = -1

sra_value_storage: SraValue[]
sra_slot_storage: SraSlot[]
sra_lane_storage: SraLane[]
sra_values: *SraValue
sra_slots: *SraSlot
sra_lanes: *SraLane
sra_nv = 0
sra_ok_count = 0

sra_workspace = (nv: int, ns: int):
    lanes = ns * 4
    if sra_value_storage.len() < nv: sra_value_storage.resize(nv); sra_values = data(sra_value_storage)
    if sra_slot_storage.len() < ns: sra_slot_storage.resize(ns); sra_slots = data(sra_slot_storage)
    if sra_lane_storage.len() < lanes: sra_lane_storage.resize(lanes); sra_lanes = data(sra_lane_storage)
    if nv > 0: mem_set(sra_values as *u8, 255, nv * size_of(SraValue))
    sizes = data(ir.slot_size)
    loop slot in [0..ns):
        size = int(sizes[slot])
        width = 8
        if size == 1 or size == 2: width = size
        else if size & 7 != 0: width = 4
        sra_slots[slot] = SraSlot(width, false, false)

sra_shift = (width: int) -> int: if width == 8: 3 else: width >> 1

# May this byte range be used as lanes of kind k (0: just bits, copied)?
sra_lane_use = (s: int, off: int, bytes: int, k: int) -> bool:
    width = sra_slots[s].width
    shift = sra_shift(width) & 63
    size = int(ir.slot_size[s])
    if size >> shift > 4: return false
    if k == 1 and width < 4: return false
    if off < 0 or off & (width - 1) != 0 or bytes & (width - 1) != 0 or off + bytes > size: return false
    first = s * 4 + (off >> shift)
    loop i in [0..(bytes >> shift)):
        if k != 0:
            j = first + i
            if sra_lanes[j].kind != 0 and sra_lanes[j].kind != k: return false
            sra_lanes[j].kind = k
    true

# Copies join lanes into classes. The forward pass keeps integer and float memory apart, so a
# copy between lanes and memory must access each word as what it is: a lane that is only copied
# (kind 0) takes the one kind its class shows. A class showing neither kind, or both, that a copy
# joins to memory keeps its slots in memory (each slot leaving makes its other classes reach
# memory too), where the copy stays a copy. O(P + L log L) for P pending operations and L lanes;
# nothing is allocated for a function whose slots meet no copy.
sra_find = (parent: mut int[], j0: int) -> int:
    j = j0
    loop parent[j] != j:
        parent[j] = parent[parent[j]]
        j = parent[j]
    j

sra_lane_first = (v: int) -> int:
    slot = int(sra_values[v].slot)
    slot * 4 + (int(sra_values[v].offset) >> (sra_shift(sra_slots[slot].width) & 63))
sra_lane_count = (s: int) -> int: int(ir.slot_size[s]) >> (sra_shift(sra_slots[s].width) & 63)

sra_copy_kinds = (code: *Ins, pending: int[], ns: int):
    copies: int[]
    loop pos in pending:
        if code[pos].op == .copy: copies.push(pos)
    if copies.len() == 0: return
    n = ns * 4
    parent = fill(0, n)
    loop j in [0..n): parent[j] = j
    flags = fill(0, n)             # at a class root: 1 float, 2 integer, 4 reaches memory
    loop pos in copies:
        ins = code + pos
        a = int(ins.a)
        b = int(ins.b)
        pa = sra_is_p(a)
        pb = sra_is_p(b)
        if not pa and not pb: continue
        m = int(ins.imm) >> (sra_shift(sra_slots[int(sra_values[if pa: a else: b].slot)].width) & 63)
        loop i in [0..m):
            if pa and pb:
                ra = sra_find(parent, sra_lane_first(a) + i)
                rb = sra_find(parent, sra_lane_first(b) + i)
                if ra != rb:
                    parent[ra] = rb
                    flags[rb] = flags[rb] | flags[ra]
            else:
                r = sra_find(parent, sra_lane_first(if pa: a else: b) + i)
                flags[r] = flags[r] | 4
    head = fill(-1, n)             # at a class root: its first lane; then each lane's next
    next = fill(-1, n)
    loop s in [0..ns):
        if not sra_slots[s].ok: continue
        loop i in [0..sra_lane_count(s)):
            j = s * 4 + i
            r = sra_find(parent, j)
            flags[r] = flags[r] | sra_lanes[j].kind
            next[j] = head[r]
            head[r] = j
    # slots of the classes with no single kind that reach memory leave, which can make more
    # classes reach memory: each slot leaves once
    work: int[]
    loop s in [0..ns):
        if not sra_slots[s].ok: continue
        loop i in [0..sra_lane_count(s)):
            f = flags[sra_find(parent, s * 4 + i)]
            if f & 4 != 0 and (f & 3 == 0 or f & 3 == 3):
                work.push(s)
                break
    loop work.len() > 0:
        s = work.pop()
        if not sra_slots[s].ok: continue
        sra_slots[s].ok = false
        loop i in [0..sra_lane_count(s)):
            r = sra_find(parent, s * 4 + i)
            if flags[r] & 4 != 0: continue
            flags[r] = flags[r] | 4
            if flags[r] & 3 == 1 or flags[r] & 3 == 2: continue
            j = head[r]
            loop j >= 0:
                work.push(j >> 2)
                j = next[j]
    loop s in [0..ns):
        if not sra_slots[s].ok: continue
        loop i in [0..sra_lane_count(s)):
            lane = s * 4 + i
            f = flags[sra_find(parent, lane)] & 3
            if sra_lanes[lane].kind == 0 and (f == 1 or f == 2): sra_lanes[lane].kind = f

sra_is_p = (v: int) -> bool: v >= 0 and v < sra_nv and int(sra_values[v].slot) >= 0 and sra_slots[int(sra_values[v].slot)].ok
sra_lane_of = (v: int, i: int) -> int:
    slot = int(sra_values[v].slot)
    sra_lanes[slot * 4 + (int(sra_values[v].offset) >> (sra_shift(sra_slots[slot].width) & 63)) + i].reg

# Definition updates are O(removed + emitted operations), with no rebuild.
# SRA preserves control structure. Uses/CFG are indexed once after its rewrite;
# forward maintains output use counts, shared by DCE and cleanup.
sra_index_nv = 0
sra_emit = (out: mut Ins[], ins: Ins):
    loop sra_index_nv < ir.vtypes.len():
        ow_resize_one(sra_index_nv)
        if not opt_allow_cse:
            o_regs[sra_index_nv].first = 0
            o_regs[sra_index_nv].dop = 0
        sra_index_nv += 1
    if ins.dst >= 0 and o_defines(ins.op):
        o_regs[int(ins.dst)].ndef += 1
    out.push(ins)

# A lane as vreg type ty, preserving bits between equal-width float/integer lanes.
sra_as_ty = (out: mut Ins[], x: int, ty: int) -> int:
    if vtype(x) == ty: return x
    t = vreg(ty)
    if ty != VI: sra_emit(out, Ins(.bits2f, i32(ty), i32(t), i32(x), 0, 0, 0))
    else: sra_emit(out, Ins(.f2bits, i32(vtype(x)), i32(t), i32(x), 0, 0, 0))
    t

# Resolve only address definitions that have a use. The chain follows strictly
# earlier definitions, so it is acyclic; each candidate is memoized once. The
# explicit stack avoids compiler-stack growth for long address chains.
sra_chain: int[]
sra_resolve_address = (value: int) -> int:
    sra_chain.clear()
    code = data(ir.code)
    v = value
    loop int(sra_values[v].slot) == -2:
        pos = int(o_regs[v].defpos)
        if o_regs[v].ndef != 1:
            sra_values[v].slot = -1
            break
        ins = code + pos
        a = int(ins.a)
        if int(sra_values[a].slot) == -1 or int(o_regs[a].defpos) >= pos:
            sra_values[v].slot = -1
            break
        if ins.op == .add:
            b = int(ins.b)
            if not is_kv(b) and not (o_regs[b].ndef == 1 and code[int(o_regs[b].defpos)].op == .iconst and int(o_regs[b].defpos) < pos):
                sra_values[v].slot = -1
                break
        sra_chain.push(v)
        v = a
    loop sra_chain.len() > 0:
        d = sra_chain.pop()
        ins = code + int(o_regs[d].defpos)
        a = int(ins.a)
        sra_values[d].slot = sra_values[a].slot
        if int(sra_values[a].slot) >= 0:
            offset = int(sra_values[a].offset)
            if ins.op == .add:
                b = int(ins.b)
                offset += if is_kv(b): kv_of(b) else: code[int(o_regs[b].defpos)].imm
            if offset < -2147483648 or offset > 2147483647: sra_values[d].slot = -1
            else: sra_values[d].offset = i32(offset)
    int(sra_values[value].slot)

# Keep the overwhelmingly common cached query separate from chain resolution.
sra_address = (value: int) -> int:
    if value < 0: return -1
    slot = int(sra_values[value].slot)
    if slot == -2: return sra_resolve_address(value)
    slot

sra_escape = (value: int):
    if value < 0: return
    slot = int(sra_values[value].slot)
    if slot == -1: return
    if slot == -2: slot = sra_resolve_address(value)
    if slot >= 0 and sra_slots[slot].ok:
        sra_slots[slot].ok = false
        sra_ok_count -= 1

sra_narrow = (slot: int, a: int, pos: int, mode: int):
    if int(o_regs[a].defpos) < pos and sra_slots[slot].width == 8 and mode & 15 != 8: sra_slots[slot].width = 4

sra_narrow_copy = (slot: int, a: int, pos: int, bytes: int):
    if slot >= 0 and int(o_regs[a].defpos) < pos and sra_slots[slot].width == 8 and (int(sra_values[a].offset) & 7 != 0 or bytes & 7 != 0): sra_slots[slot].width = 4

sra_use_lanes = (v: int, off: int, bytes: int, k: int):
    if v >= 0 and int(sra_values[v].slot) >= 0 and not sra_lane_use(int(sra_values[v].slot), int(sra_values[v].offset) + off, bytes, k): sra_slots[int(sra_values[v].slot)].ok = false

sra_keep = (v: int):
    if v >= 0 and int(sra_values[v].slot) >= 0: sra_slots[int(sra_values[v].slot)].ok = false

sra_zero_lane = (out: mut Ins[], t: int):
    if vtype(t) != VI: sra_emit(out, Ins(.fconst, i32(vtype(t)), i32(t), 0, 0, 0, 0))
    else: sra_emit(out, Ins(.mov, i32(VI), i32(t), i32(k_vreg(0)), 0, 0, 0))

sra_nested = false
sra_roots: int[]
sra_pending: int[]
sra_roots_p: *int
sra_pending_p: *int
sra_roots_cap = 0
sra_pending_cap = 0

sra_push_root = (n: int, pos: int) -> int:
    if n >= sra_roots_cap:
        nc = if sra_roots_cap < 64: 64 else: sra_roots_cap * 2
        sra_roots.resize(nc)
        sra_roots_p = data(sra_roots)
        sra_roots_cap = nc
    sra_roots_p[n] = pos
    n + 1

sra_push_pending = (n: int, pos: int) -> int:
    if n >= sra_pending_cap:
        nc = if sra_pending_cap < 128: 128 else: sra_pending_cap * 2
        sra_pending.resize(nc)
        sra_pending_p = data(sra_pending)
        sra_pending_cap = nc
    sra_pending_p[n] = pos
    n + 1

sra_rewrite = (code: *Ins, count: int, nv: int, ns: int, pending_n: int):
    sizes = data(ir.slot_size)
    any = false
    loop s in [0..ns):
        size = int(sizes[s])
        width = sra_slots[s].width
        if size & (width - 1) != 0 or size >> (sra_shift(width) & 63) > 4: sra_slots[s].ok = false
        if sra_slots[s].ok: any = true
    if not any: return
    loop lane in [0..ns * 4): sra_lanes[lane].kind = 0
    pp = sra_pending_p
    loop pi in [0..pending_n):
        pos = pp[pi]
        ins = code + pos
        match ins.op:
            load:
                a = int(ins.a)
                c = int(ins.c)
                if a >= 0 and int(sra_values[a].slot) >= 0 and c & M_INDEX == 0:
                    slot = int(sra_values[a].slot)
                    kind = if c & M_FLOAT != 0: 1 else: 2
                    if c & 15 != sra_slots[slot].width or not sra_lane_use(slot, int(sra_values[a].offset) + ins.imm, c & 15, kind): sra_slots[slot].ok = false
                else:
                    ir_operands(ins[0])
                    loop operand_index in [0..ir_use_count): sra_keep(ir_use(operand_index))
            store:
                a = int(ins.a)
                c = int(ins.c)
                sra_keep(int(ins.b))
                if c & M_INDEX != 0: sra_keep(int(ins.dst))
                if a >= 0 and int(sra_values[a].slot) >= 0:
                    slot = int(sra_values[a].slot)
                    kind = if c & M_FLOAT != 0: 1 else: 2
                    if c & M_INDEX != 0 or c & 15 != sra_slots[slot].width or not sra_lane_use(slot, int(sra_values[a].offset) + ins.imm, c & 15, kind): sra_slots[slot].ok = false
            vop:
                imm = ins.imm
                bytes = ((imm >> 4) & 7) * 4
                sra_use_lanes(int(ins.a), 0, bytes, 1)
                if imm & VOP_SPLAT_B != 0: sra_keep(int(ins.b))
                else: sra_use_lanes(int(ins.b), 0, bytes, 1)
                if imm & VOP_SPLAT_C != 0: sra_keep(int(ins.c))
                else: sra_use_lanes(int(ins.c), 0, bytes, 1)
            copy:
                a = int(ins.a)
                b = int(ins.b)
                if a >= 0 and b >= 0 and int(sra_values[a].slot) >= 0 and int(sra_values[b].slot) >= 0 and sra_slots[int(sra_values[a].slot)].width != sra_slots[int(sra_values[b].slot)].width:
                    if sra_slots[int(sra_values[a].slot)].width > sra_slots[int(sra_values[b].slot)].width: sra_slots[int(sra_values[a].slot)].ok = false
                    else: sra_slots[int(sra_values[b].slot)].ok = false
                sra_use_lanes(a, 0, ins.imm, 0)
                sra_use_lanes(b, 0, ins.imm, 0)
            zero: sra_use_lanes(int(ins.a), 0, ins.imm, 0)
            _:
                ir_operands(ins[0])
                loop operand_index in [0..ir_use_count): sra_keep(ir_use(operand_index))
    __set_len(sra_pending, pending_n)
    sra_copy_kinds(code, sra_pending, ns)
    __set_len(sra_pending, sra_pending_cap)
    any = false
    loop s in [0..ns):
        if not sra_slots[s].ok: continue
        width = sra_slots[s].width
        loop i in [0..(int(sizes[s]) >> (sra_shift(width) & 63))):
            lane = s * 4 + i
            ty = if sra_lanes[lane].kind == 1: (if width == 8: VF else: VS) else: VI
            sra_lanes[lane].reg = vreg(ty)
            any = true
    if not any: return
    sra_index_nv = nv
    out: Ins[]
    out.reserve(count + (count >> 2))
    loop input_pos in [0..count):
        ins = code + input_pos
        match ins.op:
            slot, add, mov:
                d = int(ins.dst)
                if sra_is_p(d): o_regs[d].ndef -= 1
                else: out.push(ins[0])
            load:
                a = int(ins.a)
                if sra_is_p(a):
                    d = int(ins.dst)
                    c = int(ins.c)
                    o_regs[d].ndef -= 1
                    width = sra_slots[int(sra_values[a].slot)].width
                    ty = if width == 8: VF else: VS
                    x = sra_lane_of(a, ins.imm >> (sra_shift(width) & 63))
                    if c & M_FLOAT != 0: sra_emit(out, Ins(.mov, i32(ty), i32(d), i32(sra_as_ty(out, x, ty)), 0, 0, 0))
                    else if width == 8: sra_emit(out, Ins(.mov, i32(VI), i32(d), i32(sra_as_ty(out, x, VI)), 0, 0, 0))
                    else:
                        conv = if width == 1: Op.zext8 else if width == 2: Op.zext16 else: Op.zext32
                        if c & M_SIGNED != 0: conv = if width == 1: Op.sext8 else if width == 2: Op.sext16 else: Op.sext32
                        sra_emit(out, Ins(conv, i32(VI), i32(d), i32(sra_as_ty(out, x, VI)), 0, 0, 0))
                else: out.push(ins[0])
            store:
                a = int(ins.a)
                if sra_is_p(a):
                    b = int(ins.b)
                    if sra_address(b) >= 0: sra_nested = true
                    x = sra_lane_of(a, ins.imm >> (sra_shift(sra_slots[int(sra_values[a].slot)].width) & 63))
                    sra_emit(out, Ins(.mov, i32(vtype(x)), i32(x), i32(sra_as_ty(out, b, vtype(x))), 0, 0, 0))
                else: out.push(ins[0])
            vop:
                a = int(ins.a)
                b = int(ins.b)
                c = int(ins.c)
                imm = ins.imm
                if sra_is_p(a) or (imm & VOP_SPLAT_B == 0 and sra_is_p(b)) or (imm & VOP_SPLAT_C == 0 and sra_is_p(c)):
                    which = imm & 3
                    fop = if which == 0: Op.fadd else if which == 1: Op.fsub else if which == 2: Op.fmul else: Op.fdiv
                    loop i in [0..((imm >> 4) & 7)):
                        x = b
                        if imm & VOP_SPLAT_B == 0:
                            if sra_is_p(b): x = sra_as_ty(out, sra_lane_of(b, i), VS)
                            else:
                                x = vreg(VS)
                                sra_emit(out, Ins(.load, i32(VS), i32(x), i32(b), 0, i32(4 | M_FLOAT), i * 4))
                        y = c
                        if imm & VOP_SPLAT_C == 0:
                            if sra_is_p(c): y = sra_as_ty(out, sra_lane_of(c, i), VS)
                            else:
                                y = vreg(VS)
                                sra_emit(out, Ins(.load, i32(VS), i32(y), i32(c), 0, i32(4 | M_FLOAT), i * 4))
                        r = vreg(VS)
                        sra_emit(out, Ins(fop, i32(VS), i32(r), i32(x), i32(y), 0, 0))
                        if sra_is_p(a):
                            t = sra_lane_of(a, i)
                            sra_emit(out, Ins(.mov, i32(vtype(t)), i32(t), i32(sra_as_ty(out, r, vtype(t))), 0, 0, 0))
                        else: sra_emit(out, Ins(.store, i32(VS), 0, i32(a), i32(r), i32(4 | M_FLOAT), i * 4))
                else: out.push(ins[0])
            copy:
                a = int(ins.a)
                b = int(ins.b)
                pa = sra_is_p(a)
                pb = sra_is_p(b)
                if pa or pb:
                    width = sra_slots[int(sra_values[if pa: a else: b].slot)].width
                    n = ins.imm >> (sra_shift(width) & 63)
                    xs: int[]
                    loop i in [0..n):
                        if pb: xs.push(sra_lane_of(b, i))
                        else:
                            ty = if pa: vtype(sra_lane_of(a, i)) else: VI
                            x = vreg(ty)
                            m = width
                            if ty != VI: m = width | M_FLOAT
                            sra_emit(out, Ins(.load, i32(ty), i32(x), i32(b), 0, i32(m), width * i))
                            xs.push(x)
                    loop i in [0..n):
                        if pa:
                            t = sra_lane_of(a, i)
                            sra_emit(out, Ins(.mov, i32(vtype(t)), i32(t), i32(sra_as_ty(out, xs[i], vtype(t))), 0, 0, 0))
                        else:
                            m = width
                            if vtype(xs[i]) != VI: m = width | M_FLOAT
                            sra_emit(out, Ins(.store, i32(vtype(xs[i])), 0, i32(a), i32(xs[i]), i32(m), width * i))
                else: out.push(ins[0])
            zero:
                a = int(ins.a)
                if sra_is_p(a):
                    loop i in [0..(ins.imm >> (sra_shift(sra_slots[int(sra_values[a].slot)].width) & 63))): sra_zero_lane(out, sra_lane_of(a, i))
                else: out.push(ins[0])
            zeroslots:
                out.push(ins[0])
                args = data(ir.args)
                a = int(ins.a)
                loop k in [0..int(ins.b)):
                    item = int(args[a + k])
                    if item & 1 == 0 and sra_slots[item >> 1].ok:
                        s = item >> 1
                        loop i in [0..(int(sizes[s]) >> (sra_shift(sra_slots[s].width) & 63))): sra_zero_lane(out, sra_lanes[s * 4 + i].reg)
            _: out.push(ins[0])
    ir.code = out

sra_esc_v = (u: int) -> bool:
    if u >= 0 and int(sra_values[u].slot) != -1:
        sra_escape(u)
        return sra_ok_count == 0
    false

o_sra = ():
    sra_nested = false
    opt_sra_counted = false
    if opt_allow_cse: o_resize(ir.vtypes.len())
    else: o_resize_fast(ir.vtypes.len())
    ns = ir.slot_size.len()
    if ns == 0: return
    sizes = data(ir.slot_size)
    has_small = false
    loop slot in [0..ns):
        if int(sizes[slot]) <= 32: has_small = true; break
    if not has_small: return
    opt_sra_counted = true
    code = data(ir.code)
    count = ir.code.len()
    nv = ir.vtypes.len()
    sra_nv = nv
    sra_workspace(nv, ns)
    roots_n = 0
    dec = o_decode
    args0 = data(ir.args)
    regs = o_regs
    sv = sra_values
    slots = sra_slots
    loop pos in [0..count):
        ins = code + pos
        op = ins.op
        dw = dec[int((ins as *u32)[0])]
        if (dw & 1) == 0:
            if op == .zeroslots:
                a0 = int(ins.a)
                loop k in [a0..a0 + int(ins.b)):
                    item = int(args0[k])
                    if (item & 1) == 1: regs[item >> 1].ndef += 2
            continue
        d = int(ins.dst)
        if d >= 0:
            rd = regs + d
            rd.ndef += 1
            rd.defpos = i32(pos)
            if op == .slot:
                s = int(ins.a)
                if int(sizes[s]) <= 32:
                    roots_n = sra_push_root(roots_n, pos)
                    if rd.ndef == 1: sv[d].slot = i32(s); sv[d].offset = 0
                    else: sv[d].slot = -1
            else if roots_n > 0 and (op == .mov or op == .add):
                a = int(ins.a)
                if a >= 0 and int(sv[a].slot) != -1: sv[d].slot = -2
        if (dw & 4096) != 0 and roots_n > 0:
            a0 = int(ins.a)
            loop k in [a0..a0 + int(ins.b)):
                u = int(args0[k])
                if u >= 0:
                    su = int(sv[u].slot)
                    if su >= 0: slots[su].width = -1
    if roots_n == 0: return
    sra_ok_count = 0
    rp = sra_roots_p
    loop ri in [0..roots_n):
        rins = code + rp[ri]
        d = int(rins.dst)
        slot = int(rins.a)
        if regs[d].ndef == 1 and slots[slot].width > 0:
            sv[d].slot = i32(slot)
            sv[d].offset = 0
            if not slots[slot].ok:
                slots[slot].ok = true
                sra_ok_count += 1
        else: sv[d].slot = -1
    if sra_ok_count == 0: return
    pending_n = 0
    loop pos in [0..count):
        ins = code + pos
        match ins.op:
            slot, zeroslots, nop, iconst, fconst, gaddr, daddr, faddr, block, loop, else_, end, br, trap, vzu: pass
            mov:
                d = int(ins.dst)
                a = int(ins.a)
                sd = int(sv[d].slot)
                if sd != -1 or (a >= 0 and int(sv[a].slot) != -1):
                    if sd == -2:
                        if regs[d].ndef != 1 or a < 0 or int(sv[a].slot) == -1:
                            sv[d].slot = -1; sd = -1
                        else: sd = sra_resolve_address(d)
                    if sd < 0 and a >= 0 and int(sv[a].slot) != -1:
                        sra_escape(a)
                        if sra_ok_count == 0: return
            add:
                d = int(ins.dst)
                a = int(ins.a)
                sd = int(sv[d].slot)
                if sd != -1 or (a >= 0 and int(sv[a].slot) != -1):
                    if sd == -2:
                        if regs[d].ndef != 1 or a < 0 or int(sv[a].slot) == -1:
                            sv[d].slot = -1; sd = -1
                        else: sd = sra_resolve_address(d)
                    if sd < 0:
                        if a >= 0 and int(sv[a].slot) != -1: sra_escape(a)
                        b = int(ins.b)
                        if b >= 0 and int(sv[b].slot) != -1: sra_escape(b)
                        if sra_ok_count == 0: return
                else:
                    b = int(ins.b)
                    if b >= 0 and int(sv[b].slot) != -1:
                        sra_escape(b)
                        if sra_ok_count == 0: return
            load:
                a = int(ins.a)
                c = int(ins.c)
                sa = if a >= 0: (if int(sv[a].slot) == -2: sra_resolve_address(a) else: int(sv[a].slot)) else: -1
                if sa >= 0:
                    sra_narrow(sa, a, pos, c)
                    if c & M_INDEX == 0: pending_n = sra_push_pending(pending_n, pos)
                    else:
                        if slots[sa].ok: slots[sa].ok = false; sra_ok_count -= 1
                        b = int(ins.b)
                        if b >= 0 and int(sv[b].slot) != -1: sra_escape(b)
                        if sra_ok_count == 0: return
                else if c & M_INDEX != 0:
                    b = int(ins.b)
                    if b >= 0 and int(sv[b].slot) != -1:
                        sra_escape(b)
                        if sra_ok_count == 0: return
            store:
                a = int(ins.a)
                sa = if a >= 0: (if int(sv[a].slot) == -2: sra_resolve_address(a) else: int(sv[a].slot)) else: -1
                b = int(ins.b)
                if b >= 0 and int(sv[b].slot) != -1:
                    sra_escape(b)
                    if sra_ok_count == 0: return
                if int(ins.c) & M_INDEX != 0:
                    sd = int(ins.dst)
                    if sd >= 0 and int(sv[sd].slot) != -1:
                        sra_escape(sd)
                        if sra_ok_count == 0: return
                if sa >= 0:
                    sra_narrow(sa, a, pos, int(ins.c))
                    pending_n = sra_push_pending(pending_n, pos)
            vop:
                a = int(ins.a)
                b = int(ins.b)
                c = int(ins.c)
                sa = sra_address(a)
                sb = sra_address(b)
                sc = sra_address(c)
                if sa >= 0 and int(regs[a].defpos) < pos: slots[sa].width = 4
                if sb >= 0 and int(regs[b].defpos) < pos: slots[sb].width = 4
                if sc >= 0 and int(regs[c].defpos) < pos: slots[sc].width = 4
                if sa >= 0 or sb >= 0 or sc >= 0: pending_n = sra_push_pending(pending_n, pos)
            copy:
                a = int(ins.a)
                b = int(ins.b)
                sa = sra_address(a)
                sb = sra_address(b)
                sra_narrow_copy(sa, a, pos, ins.imm)
                sra_narrow_copy(sb, b, pos, ins.imm)
                if sa >= 0 or sb >= 0: pending_n = sra_push_pending(pending_n, pos)
            zero:
                a = int(ins.a)
                sa = sra_address(a)
                sra_narrow_copy(sa, a, pos, ins.imm)
                if sa >= 0: pending_n = sra_push_pending(pending_n, pos)
            intr, call, syscall, calli, callc:
                a = int(ins.a)
                loop k in [a..a + int(ins.b)):
                    if sra_esc_v(int(args0[k])): return
                if (ins.op == .calli or ins.op == .callc) and sra_esc_v(int(ins.c)): return
            ret, if_, brif, brtable, assume, neg, not_, fneg, fsqrt, fabs, ffloor, fceil, ftrunc, sext8, sext16, sext32, zext8, zext16, zext32, i2f, u2f, f2i, f2f, bits2f, f2bits, vsplat:
                if sra_esc_v(int(ins.a)): return
            memcpy, memset, select, memeq, findbyte, scanbytes, findb:
                if sra_esc_v(int(ins.a)) or sra_esc_v(int(ins.b)) or sra_esc_v(int(ins.c)): return
            vst:
                if sra_esc_v(int(ins.a)) or sra_esc_v(int(ins.b)) or sra_esc_v(int(ins.dst)): return
            _:
                if sra_esc_v(int(ins.a)) or sra_esc_v(int(ins.b)): return
    if sra_ok_count == 0: return
    sra_rewrite(code, count, nv, ns, pending_n)

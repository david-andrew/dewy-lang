# Demand loading for the prelude (lib/core, lib/std, lib/game). Each file is indexed by a fresh
# scan (scan.jo): its top-level units (a declaration with its attributes, or a `when` block), their
# spans and the names they declare. Nothing else of a unit is lexed or parsed until one of its names
# is asked for (demand_prelude_name, from every lookup); then every unit declaring that name is
# parsed and registered, in module and file order, so an overload family is whole before one of
# it is chosen. Units that are not plain declarations (statements, imports) and nominal types
# (closed before checking: errors.jo) are parsed at once; exports once their module is in use (with
# its first unit asked for). Interactive sessions, and a game's library when the program has an
# update or draw, are parsed whole.
use 'check.jo'
use 'icount.jo'
use 'util.jo'
use 'ast.jo'
use 'frontend.jo'
use 'parse.jo'
use 'scan.jo'
use 'ide.jo'
use 'main.jo'
use 'refine.jo'

prelude_game_hint = false
prelude_lazy = false
pu_mod: int[]                   # unit -> its module
pu_done: bool[]                 # unit -> parsed
pm_exports: {int: int[]}        # module -> its units with exports: parsed once it is in use
# the names the index found, by their bytes (open addressing): each entry's first sight, its hash,
# and the units declaring it (in module and file order), parsed once the name is asked for
struct PnEntry:
    hash: int
    at: *u8                     # the name's bytes (in its source, which lives as long as the compile)
    len: int
    post: i32                   # its first posting (a unit, then the next posting), or -1
    last: i32
    done: bool
struct PnPost:
    unit: i32
    next: i32
pn_slots: i32[]
pn_entries: PnEntry[]
pn_posts: PnPost[]
pn_pending = 0
pn_seen: bool[]                 # by name: looked for in the index already
prelude_new_decls: int[]        # declarations parsed on demand, in that order (dewy_methods.jo)

# Whether the prelude is indexed: interactive sessions need future names and complete completion
# lists, and so parse it all
prelude_lazy_setup = ():
    prelude_lazy = not (ide_on or repl_image or watch_build)

# Index the prelude file at path as a module of its own; false: load it whole (load_module)
defer_prelude = (path: str, sub: str) -> bool:
    if not prelude_lazy or (sub == "game" and prelude_game_hint): return false
    src = read_source(path)
    if src == none: return false
    slash = rfind(path, "/")
    d = path[..slash)
    fi = files.len()
    files.push(SrcFile(path, d, src!))
    mi = modules.len()
    modules.push(Module(name = i32(intern(strip_ext(path[slash + 1..]))), file = i32(fi), dir = d, is_prelude = true))
    module_by_path[module_path_key(path)] = mi
    icb = ic_switch(IC_LOAD, IC_LIB)
    r = scan_source(src!)
    eager: int[]
    loop u in [r.0..r.1):
        pu_mod.push(mi)
        pu_done.push(false)
        if su_flags[u] & (SU_EAGER | SU_NOMINAL) != 0: eager.push(u)
        else:
            # (exports join once their module is in use: with its first unit asked for)
            if su_flags[u] & SU_EXPORT != 0:
                xs = pm_exports.get(mi) ?? []
                xs.push(u)
                pm_exports[mi] = xs
            p = data(src!)
            loop x in [su_name0[u]..su_name0[u + 1]):
                e = pn_entry(p + su_name_at[x], su_name_len[x])
                last = int(pn_entries[e].last)
                if last < 0 or int(pn_posts[last].unit) != u:
                    k = pn_posts.len()
                    pn_posts.push(PnPost(i32(u), -1))
                    if last < 0: pn_entries[e].post = i32(k)
                    else: pn_posts[last].next = i32(k)
                    pn_entries[e].last = i32(k)
    modules[mi].decls = prelude_parse_units(eager)
    ic_restore(icb)
    true

# The index entry of the name at p[0..n), made if it is new
pn_entry = (p: *u8, n: int) -> int:
    if pn_slots.len() == 0: pn_slots = fill(i32(0), 1 << 13)
    h = hash_bytes(p, n)
    mask = pn_slots.len() - 1
    i = h & mask
    slots = data(pn_slots)
    entries = data(pn_entries)
    loop true:
        e = int(slots[i])
        if e == 0: break
        e -= 1
        if entries[e].hash == h and entries[e].len == n and __mem_eq(entries[e].at, p, n): return e
        i = (i + 1) & mask
    e = pn_entries.len()
    pn_entries.push(PnEntry(h, p, n, -1, -1, false))
    pn_pending += 1
    slots[i] = i32(e + 1)
    if pn_entries.len() * 2 > pn_slots.len():
        # (grown: every entry placed again)
        pn_slots = fill(i32(0), pn_slots.len() * 2)
        mask = pn_slots.len() - 1
        slots = data(pn_slots)
        entries = data(pn_entries)
        loop k in [0..pn_entries.len()):
            j = entries[k].hash & mask
            loop slots[j] != 0: j = (j + 1) & mask
            slots[j] = i32(k + 1)
    e

# The entry of an interned name, or -1 (looked for once per name)
pn_find = (name: int) -> int:
    if pn_pending == 0: return -1
    if name < pn_seen.len() and pn_seen[name]: return -1
    loop pn_seen.len() <= name: pn_seen.push(false)
    pn_seen[name] = true
    if pn_slots.len() == 0: return -1
    s = names[name]
    n = len(s)
    h = hash_bytes(data(s), n)
    mask = pn_slots.len() - 1
    i = h & mask
    loop true:
        e = int(pn_slots[i])
        if e == 0: return -1
        e -= 1
        if pn_entries[e].hash == h and pn_entries[e].len == n and __mem_eq(pn_entries[e].at, data(s), n): return e
        i = (i + 1) & mask
    -1

# Parse units (of one module, in file order); their declarations
prelude_parse_units = (us: int[]) -> int[]:
    out: int[]
    loop u in us:
        if pu_done[u]: continue
        pu_done[u] = true
        m = pu_mod[u]
        f = int(modules[m].file)
        if pl_on:
            pl_units.push(f)
            pl_units.push(su_start[u])
            pl_units.push(su_end[u])
        loop d in parse_span(f, su_start[u], su_end[u]): out.push(d)
    out

# The units declaring name, parsed and registered (with their modules' other declarations, in
# file order)
prelude_demand_units = (name: int):
    e = pn_find(name)
    if e >= 0: prelude_demand_entry(e)

prelude_demand_entry = (e: int):
    if pn_entries[e].done: return
    pn_entries[e].done = true
    pn_pending -= 1
    us: int[]
    k0 = int(pn_entries[e].post)
    loop k0 >= 0:
        us.push(int(pn_posts[k0].unit))
        k0 = int(pn_posts[k0].next)
    icb = ic_switch(IC_LOAD, IC_LIB)
    k = 0
    loop k < us.len():
        m = pu_mod[us[k]]
        group: int[]
        loop k < us.len() and pu_mod[us[k]] == m:
            group.push(us[k])
            k += 1
        if let xs = pm_exports.get(m):
            pm_exports.remove(m)
            loop x in xs:
                if not pu_done[x] and not group.contains(x): group.push(x)
            # (in file order)
            loop a in [1..group.len()):
                v = group[a]
                b = a
                loop b > 0 and group[b - 1] > v:
                    group[b] = group[b - 1]
                    b -= 1
                group[b] = v
        decls = prelude_parse_units(group)
        if decls.len() == 0: continue
        loop d in decls: prelude_new_decls.push(d)
        # (the module's declarations stay in file order)
        loop d in decls:
            i = modules[m].decls.len()
            modules[m].decls.push(d)
            loop i > 0 and nodes[modules[m].decls[i - 1]].pos > nodes[d].pos:
                modules[m].decls[i] = modules[m].decls[i - 1]
                i -= 1
            modules[m].decls[i] = d
        ic_restore(icb)
        if m < registered.len() and registered[m]: register_decls(m, decls)
        icb = ic_switch(IC_LOAD, IC_LIB)
    ic_restore(icb)

# Every unit still unparsed (a diagnostic listing every name, an explicit import of a whole module)
prelude_demand_all = ():
    loop e in [0..pn_entries.len()): prelude_demand_entry(e)

# Names the compiler reads from the prelude map directly (prelude.get(intern("...")) and
# rt_global): registered with their modules from the start (tests/test_prelude_loading.py keeps
# this list whole)
prelude_known = ["Map", "NDArray", "Missing", "Console", "Set", "__crash_install", "__c_threads", "__cpu_avx2", "__loop_budget", "__mt_active", "__hash_key"]
prelude_known_names = ():
    loop nm in prelude_known: demand_prelude_name(intern(nm))

math_runtime_loaded = false
math_eval_loaded = false

demand_prelude_name = (name: int):
    if not math_runtime_loaded and starts_with(name_of(name), "__mi_"):
        math_runtime_loaded = true
        first_module = modules.len()
        first_import = from_imports.len()
        register_module(load_module(lib_dir + "/math_runtime.jo", true, -1))
        mi = first_module
        loop mi < modules.len():
            register_module(mi)
            mi += 1
        bind_from_imports(first_import)
        if module_ctx.len() > 0: setup_module_contexts(init_fns[0])
        late_module_imports = true
    if not math_eval_loaded and starts_with(name_of(name), "__mc_"):
        math_eval_loaded = true
        first_module = modules.len()
        first_import = from_imports.len()
        register_module(load_module(lib_dir + "/math_eval.jo", true, -1))
        mi = first_module
        loop mi < modules.len():
            register_module(mi)
            mi += 1
        bind_from_imports(first_import)
        if module_ctx.len() > 0: setup_module_contexts(init_fns[0])
        late_module_imports = true
    # (all overload owners before one is selected; registration and later lazy body checks can
    # demand further names, reaching a fixed point)
    if pn_pending > 0: prelude_demand_units(name)

# Deferred declarations retain the eager prelude's module/within-file order.
prelude_decl_before = (a: int, b: int) -> bool:
    if nodes[a].mod != nodes[b].mod: return nodes[a].mod < nodes[b].mod
    nodes[a].pos < nodes[b].pos

order_prelude_globals = (decls: mut int[]):
    loop i in [1..decls.len()):
        d = decls[i]
        j = i
        loop j > 0 and prelude_decl_before(d, decls[j - 1]):
            decls[j] = decls[j - 1]
            j -= 1
        decls[j] = d

# Dewy's prelude (lib/prelude/*.dewy): library modules every Dewy module sees, under its own
# names and over the Sloppy prelude, whose family of a name a Dewy prelude declaration replaces (a
# module's own declaration replaces it in turn). The same scan indexes the files on the first
# name a Dewy module does not declare itself; a file is loaded (an ordinary library module, its
# bodies parsed when reached) once one of its names is asked for. Cost: the files' bytes once, then
# a probe per name a Dewy module looks for outside itself.
dp_scanned = false
dp_paths: str[]                 # file -> path
dp_mods: int[]                  # file -> its module once loaded, or -1
dp_loaded: int[]                # the loaded modules (Dewy modules initialize after them)
dp_names: {int: int}            # name -> the file declaring it

dp_scan = ():
    dp_scanned = true
    dir = lib_dir + "/prelude"
    names_ = list_dir(dir)
    names_.sort()
    icb = ic_switch(IC_LOAD, IC_LIB)
    loop n in names_:
        if not ends_with(n, ".dewy"): continue
        path = "{dir}/{n}"
        src = read_source(path)
        if src == none: continue
        f = dp_paths.len()
        dp_paths.push(path)
        dp_mods.push(-1)
        r = scan_source(src!)
        loop x in [su_name0[r.0]..su_name0[r.1]):
            name = intern_sub(src!, su_name_at[x], su_name_len[x])
            if not is_private(name) and dp_names.get(name) == none: dp_names[name] = f
    ic_restore(icb)

# The Dewy prelude module declaring name (loaded on first use), or -1
dewy_prelude_module = (name: int) -> int:
    if not dp_scanned: dp_scan()
    f = dp_names.get(name) ?? -1
    if f < 0: return -1
    m = dp_mods[f]
    if m < 0:
        first_module = modules.len()
        first_import = from_imports.len()
        active = refine_active
        m = load_module(dp_paths[f], false, 0)
        dp_mods[f] = m
        dp_loaded.push(m)
        mi = first_module
        loop mi < modules.len():
            register_module(mi)
            mi += 1
        bind_from_imports(first_import)
        if module_ctx.len() > 0: setup_module_contexts(init_fns[0])
        late_module_imports = true
        # (a refinement written in its declarations turns the program-wide machinery on once
        # one of them is resolved: refine_resume)
        if refine_active and not active:
            refine_active = false
            loop mi in [first_module..modules.len()): refine_deferred[mi] = true
    m

# The file (under lib/) declaring the prelude's name, "" when the prelude has none: its
# indexes only, so nothing is loaded or parsed (a splat import's shadowing warning)
prelude_source = (name: int) -> str:
    if not dp_scanned: dp_scan()
    if let f = dp_names.get(name): return prelude_shown_path(dp_paths[f])
    if let s = prelude.get(name):
        if syms[s].decl != 0: return prelude_shown_path(files[pos_file(nodes[int(syms[s].decl)].pos)].path)
    if pn_slots.len() != 0:
        nm = names[name]
        n = len(nm)
        h = hash_bytes(data(nm), n)
        mask = pn_slots.len() - 1
        i = h & mask
        loop true:
            e = int(pn_slots[i])
            if e == 0: break
            e -= 1
            if pn_entries[e].hash == h and pn_entries[e].len == n and __mem_eq(pn_entries[e].at, data(nm), n):
                post = int(pn_entries[e].post)
                if post < 0: break
                mi = pu_mod[int(pn_posts[post].unit)]
                return prelude_shown_path(files[int(modules[mi].file)].path)
            i = (i + 1) & mask
    ""

prelude_shown_path = (path: str) -> str:
    if starts_with(path, lib_dir + "/"): return "lib/" + path[len(lib_dir) + 1..]
    path

# The Dewy prelude's binding of name, or 0
dewy_prelude_lookup = (name: int) -> int:
    m = dewy_prelude_module(name)
    if m < 0: return 0
    modules[m].names.get(name) ?? 0

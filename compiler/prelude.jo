prelude_index_files: str[]

std_file_init = (file: int) -> str:
    if prelude_index_files.len() == 0: prelude_index_files = PRELUDE_FILES
    prelude_index_files[file]

std_file_for = (nm: str, game: bool = false) -> str:
    n = len(nm)
    if n == 0: return ""
    rows = if game: GAME_FILE_SPEC else: STD_FILE_SPEC
    offsets = if game: GAME_PREFIX_SPEC else: STD_PREFIX_SPEC
    p = data(nm)
    mask = len(offsets) / 2 - 2
    b = (17 * int(p[0]) + 31 * int(p[n / 2]) + 7 * int(p[n - 1]) + n) & mask
    # Records hold the length and file number, then the name bytes. Game records
    # also have a mask for the targets on which this file may load individually.
    header = if game: 3 else: 2
    off = (data(offsets) as *u16) + b
    i = int(off[0])
    stop = int(off[1])
    r = data(rows)
    loop i < stop:
        size = int(r[i])
        if size == n and __mem_eq(p, r + i + header, n):
            file = int(r[i + 1])
            if game:
                # Bit order matches TARGET_BITS in the generator.
                target = if target_wasm: 8 else if target_macos: 4 else if target_windows: 2 else: 1
                if int(r[i + 2]) & target != 0: return std_file_init(file)
            else:
                if file >= 128: return ""
                return std_file_init(file)
        i += size + header
    ""

game_file_for = (nm: str) -> str:
    # Game APIs use the bulk loader so their cross-file overloads and platform
    # backends are registered before checking any game code. Private runtime
    # hooks can be reached from outside the game without loading the whole game.
    if not starts_with(nm, "__"): return ""
    std_file_for(nm, true)

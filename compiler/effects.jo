# Interned callback contracts and demanded place/row inference.
# Absence of a declaration never means purity.
# The arena, graph and cost inventory are demanded only by explicit contracts
# (or the internal policy). Ordinary isolation keeps its weaker legacy meaning.
use 'ast.jo'
use 'icount.jo'
use 'util.jo'
use 'lex.jo'
use 'types.jo'
use 'check.jo'
use 'expr.jo'
use 'places.jo'
use 'isolation.jo'
use 'refine.jo'
use 'facts.jo'
use 'floats.jo'
use 'ownership.jo'
use 'ir.jo'
use 'copies.jo'
use 'directives.jo'
use 'concurrency.jo'
use 'arena.jo'
use 'lower.jo'
use 'effect_library.jo'
use 'node_store.dewy'
use 'draw_context.jo'

enum EffectKind: read, write, alloc, detach, costly_copy, panic, io, block, spawn, escape, opaque, remainder
struct EffectAtom:
    kind: EffectKind
    place: PlaceIdentity = PlaceIdentity(.local, 0, 0)
    row: int = 0
struct EffectSyntax:
    kind: EffectKind
    path: int[]
    pos: int
    negative: bool = false
    variable: bool = false
struct EffectContract:
    atoms: EffectAtom[]
    exclusions: EffectAtom[]
    variables: int[]
    open: bool = false
struct EffectEvent:
    atom: EffectAtom
    witness: int
    via: int = 0
    via_fn: int = 0
struct EffectEdge:
    callee: int
    origin: int
    actuals: PlaceIdentity[]
struct EffectSummary:
    footprint_only: bool = false
    footprint_opaque: bool = false
    index: int
    low: int
    done: bool
    events: EffectEvent[]
    edges: EffectEdge[]
    isolation: IsolationReason
    isolation_witness: int
    stamp: int = 0
    # Capped at the region budget with an opaque event: no later add changes it.
    capped: bool = false
    # First edge per (callee, actuals): later duplicates translate to the same
    # atoms, which the row already absorbed. Computed once per function.
    unique: int[]
    unique_ready: bool = false
    # Modification tick, and the tick at which its last propagation began.
    changed_at: int = 0
    propagated_at: int = 0
# Indexed event state: (function stamp, atom) -> present. A widened row takes
# a fresh stamp, so its stale keys simply stop matching. O(1) expected per add.
# Direct body inventories survive the bounds-settle restart. Only panic sites
# change when proofs discharge bounds; edges, storage effects and isolation
# witnesses are immutable during that restart.
struct EffectBody:
    events: EffectEvent[]
    panics: EffectEvent[]
    edges: EffectEdge[]
    isolation: IsolationReason
    witness: int

effect_bodies: {int: EffectBody} = {}
effect_body_cache = false
effect_footprints_only = false
effect_body_owner = 0
effect_body_panics: EffectEvent[]

struct EffectEventKey:
    stamp: int
    atom: EffectAtom
struct EffectEdgeKey:
    callee: int
    actuals: PlaceIdentity[]
# No public strict spelling. The closed pilot inventories every reserved cost.
struct EffectPolicy:
    prohibitions: int
    require_static: bool

struct EffectObligation:
    source: int
    bound: int

loan_owners: {int: bool} = {}
effect_declared: {int: int} = {}   # fn -> its declared closed row, 0 when none (effect_declared_row)

effect_obligations: EffectObligation[]
effect_inference_busy = false
effect_solving = false
effect_final = false

effect_policy = EffectPolicy()
effects_active = false
effect_syntax: EffectSyntax[][] = [[]]
effect_contracts: EffectContract[] = [EffectContract()]
effect_summaries: EffectSummary[]
# Bodies another process checks (a partitioned check's other roots): opaque here.
effect_unavailable: {int: bool} = {}
effect_seen: int[]
effect_stack: int[]
effect_event_index: {EffectEventKey: bool} = {}
effect_stamps = 0
effect_ticks = 0
# for_ nodes marked by the current graph, by loop variable (was an all-nodes scan).
effect_for_marks: {int: int[]} = {}
# Post-check node site indexes, replacing whole-AST scans: writes by local
# (declarations, assignments through field/index selectors), scalar writes by
# the local their root resolves to, and direct calls/references by function.
# Ascending linked lists, used once checking is final (matching nodes no
# longer change in place). Append-only growth extends them in O(new nodes +
# new keys); graph/exact rewrites invalidate them. Queries cost O(their sites).
effect_ix_nodes = 0
effect_ix_locals = 0
effect_ix_heads: int[][] = [[], [], []]
effect_ix_tails: int[][] = [[], [], []]
effect_ix_next: int[][] = [[], [], []]
# effect_plain answers by representation type, for top-level queries.
effect_plain_cache: {int: bool} = {}
effect_share_cache: {int: bool} = {}
effect_serial = 0
effect_limit = 0
# Element accesses charged a possible failure in the current graph (owner,
# node), and those a facts probe of their owner's body proved in bounds.
effect_bound_sites: (int, int)[]
# Waiting is inferred only where a row excludes it: a program that writes `no blocks`
# (parallel bodies ask concurrency.jo directly)
effect_blocks_demanded = false
effect_bounds_proven: {int: bool} = {}

effects_reset = ():
    effect_footprints_only = false
    effect_bodies = {}
    effect_body_cache = false
    effect_body_owner = 0
    effect_body_panics = []
    effect_panics_reset()
    concurrency_calls = []
    concurrency_tasks = []
    concurrency_runtime_needed = false
    concurrency_ffi_start = 0
    concurrency_block_memo = {}
    effect_bound_sites = []
    effect_bounds_proven = {}
    effect_declared = {}
    loan_owners = {}
    effects_active = false
    effect_obligations = []
    effect_inference_busy = false
    effect_solving = false
    effect_final = false
    effect_policy = EffectPolicy()
    if let policy = env("DEWY_INTERNAL_EFFECT_POLICY"):
        if policy == "scalar-no-effects":
            effect_policy = EffectPolicy(-1, true)
            fact_policy = .RequireStatic
    effect_syntax = [[]]
    effect_contracts = [EffectContract()]
    effect_summaries = []
    effect_seen = []
    effect_stack = []
    effect_serial = 0
    effect_limit = 0
    effect_event_index = {}
    effect_for_marks = {}
    effect_plain_cache = {}
    effect_share_cache = {}
    effect_library_reset()
    effect_ix_nodes = 0
    effect_ix_locals = 0
    places_reset()

effect_intern = (atoms0: EffectAtom[], exclusions0: EffectAtom[] = [], variables0: int[] = [], open: bool = false) -> int:
    atoms: EffectAtom[]
    exclusions: EffectAtom[]
    variables: int[]
    loop a in atoms0:
        if not atoms.contains(a): atoms.push(a)
    loop a in exclusions0:
        if not exclusions.contains(a): exclusions.push(a)
    loop v in variables0:
        if not variables.contains(v): variables.push(v)
    loop i in [1..effect_contracts.len()):
        old = effect_contracts[i]
        if old.open != open or old.atoms.len() != atoms.len() or old.exclusions.len() != exclusions.len() or old.variables.len() != variables.len(): continue
        same = true
        loop a in atoms:
            if not old.atoms.contains(a): same = false
        loop a in exclusions:
            if not old.exclusions.contains(a): same = false
        loop v in variables:
            if not old.variables.contains(v): same = false
        if same: return i
    effect_contracts.push(EffectContract(atoms, exclusions, variables, open))
    effect_contracts.len() - 1

# Rows occupy kind-checked specialization slots, never runtime values.
effect_type = (contract: int) -> int:
    mk_type(TypeInfo(kind = .effect, st = i32(contract)), effect_contracts[contract].variables)

effect_subst = (contract: int, args: int[], zoning: bool = false) -> int:
    if contract == 0: return 0
    row = effect_contracts[contract]
    if row.variables.len() == 0: return contract
    atoms = row.atoms
    exclusions = row.exclusions
    variables: int[]
    open = row.open
    loop v in row.variables:
        t = if zoning: zonk(v) else: subst(v, args)
        if tkind(t) == .effect:
            r = effect_contracts[int(types[t].st)]
            atoms += r.atoms
            exclusions += r.exclusions
            variables += r.variables
            open = open or r.open
        else: variables.push(t)
    effect_intern(atoms, exclusions, variables, open)

effect_contract = (decl: int, params: int[], labels: int[], mask: int) -> int:
    syntax = int(nodes[decl].sval)
    if syntax == 0: return 0
    atoms: EffectAtom[]
    exclusions: EffectAtom[]
    variables: int[]
    positive = effect_syntax[syntax].len() == 0
    inherited_open = false
    loop entry in effect_syntax[syntax]:
        if not entry.negative: positive = true
        if entry.variable:
            sym = lookup(entry.path[0])
            if sym == 0 or syms[sym].kind != .type_ or tkind(int(syms[sym].ref)) != .effect: fatal(entry.pos, "effect row requires an Effect binder")
            row = effect_contracts[int(types[int(syms[sym].ref)].st)]
            atoms += row.atoms
            exclusions += row.exclusions
            variables += row.variables
            inherited_open = inherited_open or row.open
            continue
        if entry.path.len() == 0:
            atom = EffectAtom(entry.kind)
            if entry.negative: exclusions.push(atom)
            else: atoms.push(atom)
            continue
        name = entry.path[0]
        p = PlaceIdentity(.local, 0, 0)
        t = 0
        projection_start = 1
        loop i in [0..labels.len()):
            if labels[i] != name: continue
            if mask & (1 << i) == 0: fatal(entry.pos, "effect place '{name_of(name)}' must be an @ parameter")
            p = PlaceIdentity(.formal, 0, i + 1)
            t = params[i]
        if p.declaration == 0:
            s = lookup(name)
            if s != 0 and syms[s].kind == .module and entry.path.len() > 1:
                s = module_lookup(int(syms[s].ref), entry.path[1])
                projection_start = 2
            if s != 0 and syms[s].kind == .alias_:
                rt = resolve_alias(int(syms[s].ref), [], entry.pos)
                if tkind(rt) != .struct_ and tkind(rt) != .enum_: fatal(entry.pos, "effect resource requires nominal identity")
                p = PlaceIdentity(.resource, 0, int(structs[int(types[rt].st)].decl))
            else if s != 0 and (syms[s].kind == .struct_ or syms[s].kind == .enum_):
                p = PlaceIdentity(.resource, 0, int(syms[s].ref))
            else if s == 0 or (syms[s].kind != .global and syms[s].kind != .const_): fatal(entry.pos, "unknown effect place '{name_of(name)}'")
            if p.declaration == 0:
                g = int(syms[s].ref)
                ensure_global(g, entry.pos)
                p = PlaceIdentity(.global, 0, g)
                t = int(globals[g].type)
        loop i in [projection_start..entry.path.len()):
            t = representation_type(t)
            if tkind(t) != .struct_: fatal(entry.pos, "effect projection needs a record field")
            si = int(types[t].st)
            check_struct_fields(si)
            found = false
            loop j in [0..int(structs[si].nfields)):
                fi = int(structs[si].fields) + j
                if int(fields[fi].name) == entry.path[i]:
                    t = int(fields[fi].type)
                    found = true
                    break
            if not found: fatal(entry.pos, "unknown effect field '{name_of(entry.path[i])}'")
            p = place_project(p, entry.path[i])
            if p.declaration == 0: fatal(entry.pos, "effect place exceeds projection budget")
        atom = EffectAtom(entry.kind, p)
        if entry.negative: exclusions.push(atom)
        else if not atoms.contains(atom): atoms.push(atom)
        if atoms.len() > 32: fatal(entry.pos, "effect row exceeds region budget")
    loop a in atoms:
        loop e in exclusions:
            if effect_overlap(a, e): fatal(nodes[decl].pos, "contradictory effect permission and exclusion")
    effect_intern(atoms, exclusions, variables, not positive or inherited_open)

effect_argument = (tn: int) -> int:
    if nodes[tn].kind == .tname and nodes[tn].aux == -8: return effect_type(effect_contract(tn, [], [], 0))
    if nodes[tn].kind == .tname:
        sym = lookup(int(nodes[tn].name))
        if sym != 0 and syms[sym].kind == .type_ and tkind(int(syms[sym].ref)) == .effect: return int(syms[sym].ref)
    fatal(nodes[tn].pos, "generic argument kind mismatch: expected Effect row")
    0

# An unchecked external implementation cannot manufacture callable guarantees,
# including when an alias or aggregate hides the qualifying wrapper.
effect_qualified_type = (t0: int, seen: mut int[]) -> bool:
    t = prune(t0)
    if t == 0 or seen.contains(t): return false
    if seen.len() >= 64: return true
    seen.push(t)
    k = types[t].kind
    if k == .callable: return true
    if k == .array or k == .fixed or k == .opt or k == .ptr or k == .refined: return effect_qualified_type(telem(t), seen)
    if k == .fn_ or k == .cfn or k == .tuple:
        if effect_qualified_type(telem(t), seen): return true
        loop i in [0..int(types[t].nargs)):
            if effect_qualified_type(targ(t, i), seen): return true
    if k == .struct_ or k == .enum_:
        si = int(types[t].st)
        check_struct_fields(si)
        loop i in [0..int(structs[si].nfields)):
            if effect_qualified_type(int(fields[int(structs[si].fields) + i].type), seen): return true
        loop i in [0..int(structs[si].nvariants)):
            v = int(structs[si].variants) + i
            loop j in [0..int(variants[v].nfields)):
                if effect_qualified_type(int(fields[int(variants[v].fields) + j].type), seen): return true
    false

effect_generic_argument = (tn: int) -> int:
    if nodes[tn].kind == .tname:
        if nodes[tn].aux == -8: return effect_argument(tn)
        sym = lookup(int(nodes[tn].name))
        if sym != 0 and syms[sym].kind == .type_ and tkind(int(syms[sym].ref)) == .effect: return int(syms[sym].ref)
    resolve_type(tn)

effect_decl_contract = (decl: int, params: int[]) -> int:
    if decl == 0 or nodes[decl].sval == 0: return 0
    labels: int[]
    mask = 0
    loop i in [0..nkids(decl)):
        p = kid(decl, i)
        labels.push(int(nodes[p].name))
        if has_flag(p, NF_MUT): mask |= 1 << i
    effect_contract(decl, params, labels, mask)

mk_callable_contract = (base: int, contract: int, capability: int = 0) -> int:
    cap = capability
    if types[prune(base)].kind == .callable: cap = max(cap, int(types[prune(base)].bits))
    if contract == 0 and cap == 0: return base
    variables: int[]
    if contract != 0: variables = effect_contracts[contract].variables
    mk_type(TypeInfo(kind = .callable, elem = i32(callable_base(base)), st = i32(contract), bits = i32(cap)), variables)

callable_base = (t0: int) -> int:
    t = prune(t0)
    if types[t].kind == .callable: return int(types[t].elem)
    t

callable_contract = (t0: int) -> int:
    t = prune(t0)
    if types[t].kind == .callable: return int(types[t].st)
    0

effect_overlap = (a: EffectAtom, b: EffectAtom) -> bool:
    if a.kind == .opaque or b.kind == .opaque: return true
    # (I/O may wait on its device: `no blocks` excludes it)
    if a.kind == .block and b.kind == .io or a.kind == .io and b.kind == .block: return true
    # (a storage detach allocates: `allocates` covers it, `no allocates` excludes it)
    if a.kind == .alloc and b.kind == .detach or a.kind == .detach and b.kind == .alloc: return true
    if a.kind != b.kind: return false
    a.place.declaration == 0 or b.place.declaration == 0 or place_covers(a.place, b.place) or place_covers(b.place, a.place)

effect_excluded = (row: EffectContract, atom: EffectAtom) -> bool:
    loop exclusion in row.exclusions:
        if effect_overlap(exclusion, atom): return true
    false

effect_allows = (contract: int, atom: EffectAtom) -> bool:
    if atom.kind == .remainder: return effect_rows_fit(atom.row, contract)
    row = effect_contracts[contract]
    loop exclusion in row.exclusions:
        # Waiting is classified separately from residual implementation costs,
        # and so is panicking (effect_panics, after facts: dir_panics_finalize).
        if atom.kind == .opaque and exclusion.kind == .block: continue
        if exclusion.kind == .panic and (atom.kind == .opaque or atom.kind == .panic): continue
        if effect_overlap(exclusion, atom): return false
    if row.open: return true
    loop permission in row.atoms:
        if permission.kind == atom.kind and (permission.place.declaration == 0 or place_covers(permission.place, atom.place)): return true
        if permission.kind == .alloc and atom.kind == .detach: return true
    false

effect_rows_fit = (source: int, dest: int) -> bool:
    if dest == 0: return true
    if source == 0: return false
    sr = effect_contracts[source]
    dr = effect_contracts[dest]
    if sr.open and not dr.open: return false
    loop ex in dr.exclusions:
        if sr.open and not sr.exclusions.contains(ex): return false
    loop atom in sr.atoms:
        if atom.kind == .opaque and dr.exclusions.contains(EffectAtom(.block)) and not sr.exclusions.contains(EffectAtom(.block)): return false
        if not effect_allows(dest, atom): return false
    loop v in sr.variables:
        if not dr.variables.contains(v): return false
    true

effect_contract_fits = (from: int, to: int) -> bool:
    effect_rows_fit(callable_contract(from), callable_contract(to))

# Explicit callback-place permissions are checked here, before extracting E.
# A foreign formal ordinal can never enter a nonlocal row substitution.
effect_match = (source: int, dest: int, binds: mut int[]) -> bool:
    if dest == 0: return true
    if source == 0: return false
    dr = effect_contracts[dest]
    if dr.variables.len() == 0: return effect_rows_fit(source, dest)
    if dr.variables.len() != 1: return false
    sr = effect_contracts[source]
    rest: EffectAtom[]
    exclusions: EffectAtom[]
    loop a in sr.atoms:
        if effect_allows(dest, a): continue
        if place_base(a.place).root == .formal: return false
        loop ex in dr.exclusions:
            if effect_overlap(a, ex): return false
        rest.push(a)
    loop ex in sr.exclusions:
        if place_base(ex.place).root != .formal: exclusions.push(ex)
    t = effect_type(effect_intern(rest, exclusions, sr.variables, sr.open))
    v = dr.variables[0]
    if tkind(v) == .param:
        slot = int(types[v].id)
        if slot < binds.len() and binds[slot] != 0 and tkind(binds[slot]) == .effect:
            binds[slot] = effect_type(effect_join(int(types[binds[slot]].st), int(types[t].st)))
            return true
    match_type(v, t, binds, 1) >= 0

# Compatibility is speculative during checking, then rechecked against every
# reaching source at the helper fixed point. No declaration is rewritten.
effect_top = () -> int: effect_intern([EffectAtom(.opaque)])

effect_join = (left: int, right: int) -> int:
    a = effect_contracts[left]
    b = effect_contracts[right]
    exclusions: EffectAtom[]
    loop e in a.exclusions + b.exclusions:
        bound = effect_intern([], [e], [], true)
        if effect_rows_fit(left, bound) and effect_rows_fit(right, bound): exclusions.push(e)
    effect_intern(a.atoms + b.atoms, exclusions, a.variables + b.variables, a.open or b.open)

effect_prepare_node = (n: int, seen: mut int[], depth: int):
    if n == 0 or depth > 32: return
    k = nodes[n].kind
    if (k == .call and nodes[n].aux == 0) or k == .fnref: effect_prepare(int(nodes[n].sym), seen, depth + 1)
    mask = isolation_children(k)
    if mask < 0: return
    if mask & 1 != 0: effect_prepare_node(int(nodes[n].a), seen, depth + 1)
    if mask & 2 != 0: effect_prepare_node(int(nodes[n].b), seen, depth + 1)
    if mask & 4 != 0: effect_prepare_node(int(nodes[n].c), seen, depth + 1)
    if mask & 16 != 0:
        loop c in kids(n): effect_prepare_node(c, seen, depth + 1)

effect_prepare = (f: int, seen: mut int[], depth: int):
    if f <= 0 or f >= fns.len() or depth > 32 or seen.contains(f): return
    seen.push(f)
    if fns[f].state == 0: check_fn_body(f)
    if fns[f].state == 2: effect_prepare_node(int(fns[f].body), seen, depth + 1)

effect_graph_reset = (reuse_bodies: bool = false):
    effect_footprints_only = false
    if not reuse_bodies:
        effect_bodies = {}
        effect_body_cache = false
    effect_body_owner = 0
    effect_body_panics = []
    # Discharging bounds changes no write, use or declaration site.
    if not reuse_bodies:
        effect_ix_nodes = 0
        effect_ix_locals = 0
    effect_limit = fns.len()
    effect_summaries = fill(EffectSummary(), effect_limit)
    effect_seen = fill(0, nodes.len())
    effect_event_index = {}
    if not reuse_bodies:
        effect_for_marks = {}
        effect_plain_cache = {}
        effect_share_cache = {}
    effect_stack = []
    effect_serial = 0

effect_function_row = (f: int) -> int:
    if effect_footprints_only:
        # An indirect row discovered during footprint solving is conservatively
        # opaque; never reset the active Tarjan stack. Contract roots ask again
        # outside that traversal and receive the full graph.
        if effect_stack.len() > 0: return effect_top()
        effect_graph_reset()
    if f <= 0 or f >= fns.len(): return effect_top()
    if not effect_final and not effect_solving:
        if effect_inference_busy: return effect_top()
        effect_inference_busy = true
        seen: int[]
        effect_prepare(f, seen, 0)
        effect_inference_busy = false
        effect_graph_reset()
    if f >= effect_limit: return effect_top()
    if effect_summaries[f].index == 0:
        previous = effect_solving
        effect_solving = true
        effect_visit(f)
        effect_solving = previous
    if not effect_summaries[f].done: return effect_top()
    atoms: EffectAtom[]
    loop event in effect_summaries[f].events:
        atom = event.atom
        base = place_base(atom.place)
        if base.root == .formal:
            if base.owner != f: return effect_top()
            atom.place = place_append(PlaceIdentity(.formal, 0, base.declaration), atom.place)
        atoms.push(atom)
    exclusions: EffectAtom[]
    if effect_blocks_demanded and not concurrency_fn_blocks(f): exclusions.push(EffectAtom(.block))
    effect_intern(atoms, exclusions)

# Collect result expressions without interpreting loop locals as syntax nodes.
effect_returns = (n: int, out: mut int[]):
    if n == 0: return
    k = nodes[n].kind
    if k == .return_:
        value_leaves(int(nodes[n].a), out)
        return
    mask = isolation_children(k)
    if mask < 0: return
    if mask & 1 != 0: effect_returns(int(nodes[n].a), out)
    if mask & 2 != 0: effect_returns(int(nodes[n].b), out)
    if mask & 4 != 0: effect_returns(int(nodes[n].c), out)
    if mask & 16 != 0:
        loop c in kids(n): effect_returns(c, out)

# The local an assignment target writes through field/index selectors, or 0.
effect_write_root = (q: int) -> int:
    target = int(nodes[q].a)
    loop nodes[target].kind == .field or nodes[target].kind == .index: target = int(nodes[target].a)
    if nodes[target].kind == .ident and nodes[target].aux == i32(int(SK.local)): return int(nodes[target].sym)
    0

# Node q's key in site index `kind` (0 writes, 1 scalar writes, 2 uses), or 0.
effect_site_key = (kind: int, q: int) -> int:
    k = nodes[q].kind
    if kind == 2: return if (k == .call and nodes[q].aux == 0 or k == .fnref) and nodes[q].sym > 0: int(nodes[q].sym) else: 0
    if k == .vardecl: return if has_flag(q, NF_GLOBAL) or nodes[q].sym <= 0: 0 else: int(nodes[q].sym)
    if k != .assign: return 0
    if kind == 0: return effect_write_root(q)
    p = place_scalar_root(int(nodes[q].a))
    if p.root != .local: return 0
    p.declaration

effect_index_build = ():
    if effect_ix_nodes == nodes.len() and effect_ix_locals == locals.len(): return
    # Finalized nodes do not change. Appended analysis/lowering nodes extend
    # the index once, instead of rebuilding every earlier body's sites.
    # O(new nodes + new keys), with ascending per-key chains maintained by tails.
    if effect_ix_nodes == 0:
        effect_ix_heads = [[], [], []]
        effect_ix_tails = [[], [], []]
        effect_ix_next = [[], [], []]
    loop kind in [0..3):
        limit = if kind == 2: fns.len() + 1 else: locals.len() + 1
        if effect_ix_heads[kind].len() < limit:
            effect_ix_heads[kind].resize(limit)
            effect_ix_tails[kind].resize(limit)
        effect_ix_next[kind].resize(nodes.len())
    loop q in [max(1, effect_ix_nodes)..nodes.len()):
        k = nodes[q].kind
        if k == .vardecl or k == .assign:
            effect_index_link(0, effect_site_key(0, q), q)
            effect_index_link(1, effect_site_key(1, q), q)
        else if k == .call or k == .fnref:
            effect_index_link(2, effect_site_key(2, q), q)
    effect_ix_nodes = nodes.len()
    effect_ix_locals = locals.len()

effect_index_link = (kind: int, key: int, q: int):
    if key <= 0: return
    if key >= effect_ix_heads[kind].len():
        effect_ix_heads[kind].resize(key + 1)
        effect_ix_tails[kind].resize(key + 1)
    tail = effect_ix_tails[kind][key]
    if tail == 0: effect_ix_heads[kind][key] = q
    else: effect_ix_next[kind][tail] = q
    effect_ix_tails[kind][key] = q

# Candidate nodes in ascending order; callers still test each one in full.
# While checking is open, nodes change in place: scan them all.
effect_sites = (kind: int, key: int) -> int[]:
    out: int[]
    if key <= 0:
        loop q in [1..nodes.len()): out.push(q)
        return out
    if not effect_final:
        if kind == 2:
            loop q in [1..nodes.len()):
                k = nodes[q].kind
                if (k == .call or k == .fnref) and effect_site_key(kind, q) == key: out.push(q)
            return out
        loop q in [1..nodes.len()):
            k = nodes[q].kind
            if (k == .vardecl or k == .assign) and effect_site_key(kind, q) == key: out.push(q)
        return out
    effect_index_build()
    q = if key < effect_ix_heads[kind].len(): effect_ix_heads[kind][key] else: 0
    loop q != 0:
        out.push(q)
        q = effect_ix_next[kind][q]
    out

effect_write_sites = (l: int) -> int[]: effect_sites(0, l)
effect_scalar_sites = (l: int) -> int[]: effect_sites(1, l)
effect_use_sites = (f: int) -> int[]: effect_sites(2, f)

# Projection selectors are field ordinals; -1 joins all array elements. Joining
# every assignment is intentionally flow-insensitive, including later writes.
effect_source_row = (n: int, path: int[] = [], depth: int = 0) -> int:
    if n == 0 or depth > 16: return effect_top()
    k = nodes[n].kind
    if k == .conv:
        inner = int(nodes[n].a)
        return effect_source_row(inner, path, depth + 1)
    if path.len() == 0 and callable_contract(ntype(n)) != 0: return callable_contract(ntype(n))
    if path.len() == 0 and (k == .fnref or k == .lambda and not has_flag(n, NF_GENERIC)): return effect_function_row(int(nodes[n].sym))
    if k == .field: return effect_source_row(int(nodes[n].a), [int(nodes[n].aux)] + path, depth + 1)
    if k == .index: return effect_source_row(int(nodes[n].a), [-1] + path, depth + 1)
    if k == .ident and nodes[n].aux == i32(int(SK.local)):
        l = int(nodes[n].sym)
        if int(locals[l].flags) & (LF_CAPTURE | LF_CAPTURED | LF_EXPOSED | LF_ADDR | LF_SHARED | LF_ALIAS) != 0:
            return effect_top()
        if int(locals[l].flags) & LF_PARAM != 0: return effect_top()
        row = 0
        loop q in effect_write_sites(l):
            rhs = 0
            rest = path
            if nodes[q].kind == .vardecl and not has_flag(q, NF_GLOBAL) and nodes[q].sym == i32(l): rhs = int(nodes[q].b)
            if nodes[q].kind == .assign:
                target = int(nodes[q].a)
                selectors: int[]
                loop nodes[target].kind == .field or nodes[target].kind == .index:
                    selectors.insert(0, if nodes[target].kind == .field: int(nodes[target].aux) else: -1)
                    target = int(nodes[target].a)
                if nodes[target].kind == .ident and nodes[target].aux == i32(int(SK.local)) and nodes[target].sym == i32(l):
                    overlap = true
                    loop i in [0..min(selectors.len(), path.len())):
                        if selectors[i] != path[i]: overlap = false
                    if overlap:
                        if selectors.len() > path.len(): return effect_top()
                        rhs = int(nodes[q].b)
                        rest = path[selectors.len()..]
            if rhs == 0: continue
            # Unchecked later assignments are covered by the final obligation.
            if not effect_final and nodes[rhs].type == 0: continue
            r = effect_source_row(rhs, rest, depth + 1)
            row = if row == 0: r else: effect_join(row, r)
        return if row == 0: effect_top() else: row
    if path.len() > 0:
        rest = path[1..]
        if k == .array and path[0] == -1:
            row = 0
            loop child in kids(n):
                r = effect_source_row(child, rest, depth + 1)
                row = if row == 0: r else: effect_join(row, r)
            return if row == 0: effect_top() else: row
        if k == .call and nodes[n].aux == 2 and path[0] >= 0 and path[0] < nkids(n): return effect_source_row(kid(n, path[0]), rest, depth + 1)
    if k == .call and nodes[n].aux == 0:
        f = int(nodes[n].sym)
        if f <= 0 or f >= fns.len(): return effect_top()
        if not effect_final and fns[f].state == 0: check_fn_body(f)
        if fns[f].state != 2: return effect_top()
        leaves: int[]
        effect_returns(int(fns[f].body), leaves)
        value_leaves(int(fns[f].body), leaves)
        row = 0
        loop leaf in leaves:
            r = effect_source_row(leaf, path, depth + 1)
            row = if row == 0: r else: effect_join(row, r)
        return if row == 0: effect_top() else: row
    if path.len() == 0 and k == .partial:
        source = if nodes[n].aux == 0: effect_function_row(int(nodes[n].sym)) else: effect_source_row(int(nodes[n].a), [], depth + 1)
        row = effect_contracts[source]
        atoms: EffectAtom[]
        loop a0 in row.atoms:
            a = a0
            base = place_base(a.place)
            if base.root == .formal:
                slot = base.declaration - 1
                if slot < 0 or slot >= nkids(n): return effect_top()
                if nodes[kid(n, slot)].kind != .hole: return effect_top()
                ordinal = 0
                loop i in [0..slot + 1):
                    if nodes[kid(n, i)].kind == .hole: ordinal += 1
                a.place = place_append(PlaceIdentity(.formal, 0, ordinal), a.place)
            atoms.push(a)
        # Open bounds with bound formal exclusions need a route substitution.
        if row.open: return effect_top()
        loop exclusion in row.exclusions:
            if place_base(exclusion.place).root == .formal: return effect_top()
        return effect_intern(atoms, row.exclusions)
    if k == .if_ or k == .block or k == .exprstmt:
        leaves: int[]
        value_leaves(n, leaves)
        if leaves.len() == 1 and leaves[0] == n: return effect_top()
        row = 0
        loop leaf in leaves:
            r = effect_source_row(leaf, path, depth + 1)
            row = if row == 0: r else: effect_join(row, r)
        return if row == 0: effect_top() else: row
    effect_top()

# Unannotated mutable storage carries source provenance rather than freezing
# the initializer's upper bound. Declared fields/signatures keep their bounds.
effect_storage_type = (t: int) -> int:
    k = tkind(t)
    if k == .callable: return callable_base(t)
    if k == .array: return mk_array(effect_storage_type(telem(t)))
    if k == .opt: return mk_opt(effect_storage_type(telem(t)))
    if k == .fixed: return mk_fixed(effect_storage_type(telem(t)), fixed_len(t))
    t

effect_infer_callable = (n: int, expected: int) -> int:
    t = ntype(n)
    if callable_contract(expected) == 0 or callable_contract(t) != 0 or not is_fn_type(t): return t
    # Freeze the expression before its checked conversion changes its type.
    source = nodes.len()
    nodes.push(nodes[n])
    row = effect_source_row(source)
    effect_obligations.push(EffectObligation(source, row))
    mk_callable_contract(t, row)


# Residual implementation inventory used by check and both code generators.
# No optimization-dependent capacity/uniqueness discharge in this slice.
# Immutable shares (text, `int`, records of them: effect_share) and reviewed
# library string operations (effect_library.jo) are classified; unsupported
# adapters and other managed operations stay top, even with an Alloc event:
# allocation permission alone never promises failure-free execution.
effect_scalar = (t0: int) -> bool:
    t = representation_type(t0)
    types[t].kind == .bool_ or types[t].kind == .int_ and t != T_MATH_INT

# A fixed-width float is a word as well: copying, reading or storing one costs
# nothing hidden, and its `+ - * /` and comparisons are single instructions
# that never fail (a `$finite_floats` obligation is checked by floats.jo).
effect_float = (t0: int) -> bool: types[representation_type(t0)].kind == .float_

effect_float_op = (op: Tok) -> bool:
    op == .plus or op == .minus or op == .star or op == .slash or op == .eq or op == .ne or op == .lt or op == .le or op == .gt or op == .ge

# A word-sized `int` literal is a constant: a shift count such as the `3` in
# `x >> 3` lowers to an immediate, with no promotion or check.
effect_count_literal = (n: int) -> bool:
    nodes[n].kind == .int_lit and prune(ntype(n)) == T_MATH_INT and nodes[n].ival >= 0 and not has_flag(n, NF_U64)

effect_word_op = (op: Tok) -> bool:
    op == .plus or op == .minus or op == .star or op == .amp or op == .pipe or op == .caret or op == .kw_xor or op == .shl or op == .shr or op == .eq or op == .ne or op == .lt or op == .le or op == .gt or op == .ge

# Inline POD records use the same layout decision as lowering. A recursive
# box, custom lifecycle or managed field is never certified as a free copy.
effect_plain = (t0: int, depth: int = 0) -> bool:
    t = representation_type(t0)
    if effect_scalar(t) or effect_float(t): return true
    if depth == 0:
        k = tkind(t)
        if k == .struct_ or k == .enum_ or k == .tuple or k == .fixed or k == .opt:
            if let known = effect_plain_cache.get(t): return known
            answer = effect_plain_type(t)
            effect_plain_cache[t] = answer
            return answer
    effect_plain_type(t, depth)

effect_plain_type = (t: int, depth: int = 0) -> bool:
    # (an Arena is a handle: copying, reading or dropping one allocates nothing, arena.jo)
    if arena_fns.len() > 0 and arena_handle(t): return true
    # (a union of plain members, `int64 | Oops`, is plain: a tag and a payload)
    if depth <= 16 and tkind(t) == .enum_:
        layout(t)
        si = int(types[t].st)
        if structs[si].drop_fn != 0: return false
        loop v in [0..int(structs[si].nvariants)):
            vi = int(structs[si].variants) + v
            loop j in [0..int(variants[vi].nfields)):
                fi = int(variants[vi].fields) + j
                if fields[fi].boxed or not effect_plain(int(fields[fi].type), depth + 1): return false
        return true
    # (an optional plain value is inline: a flag beside the payload)
    if depth <= 16 and tkind(t) == .opt: return not math_optional(t) and effect_plain(int(types[t].elem), depth + 1)
    # (a fixed array or tuple of plain elements is inline storage with no lifecycle)
    if depth <= 16 and tkind(t) == .fixed: return effect_plain(int(types[t].elem), depth + 1)
    if depth <= 16 and tkind(t) == .tuple:
        loop i in [0..int(types[t].nargs)):
            if not effect_plain(targ(t, i), depth + 1): return false
        return true
    if depth > 16 or tkind(t) != .struct_: return false
    layout(t)
    si = int(types[t].st)
    if structs[si].drop_fn != 0: return false
    loop i in [0..int(structs[si].nfields)):
        fi = int(structs[si].fields) + i
        if fields[fi].boxed or not effect_plain(int(fields[fi].type), depth + 1): return false
    true

# A payload-free enum (a literal union such as `'ready' | 'blocked'`) is one
# word: its members are constants and `=?` compares words.
effect_simple_enum = (t0: int) -> bool:
    t = representation_type(t0)
    if tkind(t) != .enum_: return false
    layout(t)
    structs[int(types[t].st)].simple_enum

# An immutable share: a plain value, text, an `int` (a word, or an immutable
# big payload), or an inline record, union, tuple or optional of shares with no
# lifecycle hooks. Copying one costs at most a reference count, never an
# allocation: reading, binding, passing, returning or building one inline is
# free (a recursive box still allocates, effect_access).
effect_share = (t0: int, depth: int = 0) -> bool:
    t = representation_type(t0)
    if effect_plain(t) or ownership_scalar(t): return true
    if types[t].kind == .str_ or t == T_MATH_INT: return true
    k = tkind(t)
    if depth > 16 or k != .struct_ and k != .enum_ and k != .tuple and k != .opt: return false
    if let known = effect_share_cache.get(t): return known
    # (a recursive type is no share: its cycle goes through a box)
    effect_share_cache[t] = false
    answer = effect_share_type(t, depth)
    effect_share_cache[t] = answer
    answer

effect_share_type = (t: int, depth: int) -> bool:
    k = tkind(t)
    if k == .opt: return effect_share(int(types[t].elem), depth + 1)
    if k == .tuple:
        loop i in [0..int(types[t].nargs)):
            if not effect_share(targ(t, i), depth + 1): return false
        return true
    if ownership_type(t): return false
    layout(t)
    si = int(types[t].st)
    if structs[si].drop_fn != 0: return false
    if k == .enum_:
        loop v in [0..int(structs[si].nvariants)):
            vi = int(structs[si].variants) + v
            loop j in [0..int(variants[vi].nfields)):
                fi = int(variants[vi].fields) + j
                if fields[fi].boxed or not effect_share(int(fields[fi].type), depth + 1): return false
        return true
    loop i in [0..int(structs[si].nfields)):
        fi = int(structs[si].fields) + i
        if fields[fi].boxed or not effect_share(int(fields[fi].type), depth + 1): return false
    true

# A value whose copy is a share: a share, or a dynamic array of shares (copy on
# write: a copy shares the storage; a later write's detach is that write's own
# cost, as the growth intrinsics and element stores classify it).
effect_value = (t0: int) -> bool:
    t = representation_type(t0)
    if tkind(t) == .array: return effect_share(telem(t))
    effect_share(t)

# A reviewed library operation's class (effect_library.jo) as its summary: its
# residual costs, and a write of each mutable parameter.
effect_library_summary = (f: int, c: EffectClass, d: int):
    if c == .allocates or c == .allocates_panics: effect_add(f, EffectEvent(EffectAtom(.alloc), d))
    if c == .allocates_panics: effect_add(f, EffectEvent(EffectAtom(.panic), d))
    loop i in [0..fns[f].params.len()):
        if int(locals[fns[f].params[i]].flags) & LF_MUTPARAM != 0: effect_add(f, EffectEvent(EffectAtom(.write, PlaceIdentity(.formal, f, i + 1)), d))

# A site that answers for its callee's one failure: a string index or slice
# (the caller's obligation where the library states it: its facts discharge
# it), or a format specification the library accepts for the value, written
# as a literal (`{x:.2f}`, `format(x ".2f")`).
effect_caller_obligation = (n: int) -> bool:
    k = nodes[n].kind
    if k == .call: return fact_string_call(n) >= 2 or nodes[n].aux == 0 and nodes[n].sym > 0 and panic_format_literal(n)
    k == .pair and nodes[n].sval >= 0 and panic_format_spec(name_of(int(nodes[n].sval)), representation_type(ntype(int(nodes[n].a))))

# Reviewed intrinsic identities, assigned by name resolution, never filenames
# or user spelling. -1 means unclassified. Bits are residual may-costs, not
# authority to mutate the actual; place access is collected independently.
effect_intrinsic_cost = (id: IN) -> int:
    if id == .fixed_abs: return 0
    if id == .len or id == .arrcap or id == .sizeof or id == .alignof or id == .zeroed or id == .mul_hi: return 0
    if id == .hash: return 0 # resolved value hooks are separate call edges
    if id == .static_assert: return 0 # erased
    if id == .push or id == .insert or id == .reserve or id == .resize or id == .extend or id == .fill:
        return (1 << int(EffectKind.alloc)) | (1 << int(EffectKind.detach)) | (1 << int(EffectKind.panic))
    if id == .pop or id == .remove or id == .clear or id == .truncate:
        return (1 << int(EffectKind.alloc)) | (1 << int(EffectKind.detach)) | (1 << int(EffectKind.panic))
    if id == .fmt_struct or id == .json_fields or id == .fmt_elem or id == .dewy_fmt or id == .dewy_fmt_elem:
        return (1 << int(EffectKind.alloc)) | (1 << int(EffectKind.opaque))
    if id == .panic or id == .assert or id == .runtime_assert or id == .unreachable: return 1 << int(EffectKind.panic)
    -1

# One reporting seam for implementation plans. This deliberately records may
# costs before optimizations; later planners may only discharge them with
# shared placement/ownership evidence, never a hoped-for lowering choice.
effect_plan_cost = (f: int, n: int, mask: int):
    if mask < 0:
        effect_opaque(f, n)
        return
    loop i in [int(EffectKind.alloc)..int(EffectKind.opaque) + 1):
        if mask & (1 << i) != 0: effect_add(f, EffectEvent(EffectAtom(i as EffectKind), n))

# Lowering may introduce checked intrinsics after helper discovery. A demanded
# summary must already cover their costs; otherwise fail closed before emission.
# Ordinary compilation does not consult or allocate effect state here.
effect_lower_intrinsic = (f: int, n: int):
    if not effects_active and effect_policy.prohibitions == 0: return
    if f <= 0 or f >= effect_limit or not effect_summaries[f].done: return
    # (a reviewed library class stands for its whole body)
    if effect_library_class(f) != .unclassified: return
    # (an explicit-allocation-failure frame: counted as allocation by its scan)
    if effect_oom_frame(n): return
    if nodes[n].aux2 == i32(RANGE_EXHAUSTION) and (effect_bounds_proven.has(n) or fact_range_assumed(n)): return
    mask = effect_intrinsic_cost(nodes[n].aux as IN)
    covered = 0
    loop event in effect_summaries[f].events:
        if event.atom.kind == .opaque: return
        covered |= 1 << int(event.atom.kind)
    if mask < 0 or mask & ~covered != 0:
        fatal(nodes[n].pos, "effect implementation plan introduced an unclassified intrinsic cost after verification")

# Drop authority belongs to the owner even on early exits or failed later
# construction. Inline components contribute their own hook edges; unproved
# indirect layouts remain blocked by the ownership planner.
effect_cleanup = (f: int, t0: int, n: int, p: PlaceIdentity, depth: int = 0):
    t = representation_type(t0)
    if depth > 32:
        effect_opaque(f, n)
        return
    if tkind(t) == .array or tkind(t) == .fixed:
        effect_cleanup(f, telem(t), n, p, depth + 1)
        return
    if tkind(t) != .struct_: return
    layout(t)
    si = int(types[t].st)
    g = int(structs[si].drop_fn)
    if g != 0: effect_summaries[f].edges.push(EffectEdge(g, n, [p]))
    if ownership_decls.len() == 0: return
    if depth > 32:
        effect_opaque(f, n)
        return
    loop i in [0..int(structs[si].nfields)):
        ft = int(fields[int(structs[si].fields) + i].type)
        if ownership_type(ft): effect_cleanup(f, ft, n, p, depth + 1)


# A place atom of a read or write: the kinds a summary may widen to a root.
effect_place_atom = (a: EffectAtom) -> bool: (a.kind == .read or a.kind == .write) and a.place.declaration != 0

effect_restamp = (f: int):
    effect_ticks += 1
    effect_summaries[f].changed_at = effect_ticks
    effect_stamps += 1
    effect_summaries[f].stamp = effect_stamps
    loop old in effect_summaries[f].events: effect_event_index[EffectEventKey(effect_stamps, old.atom)] = true

effect_add = (f: int, event: EffectEvent) -> bool:
    if effect_footprints_only:
        kind = event.atom.kind
        if kind == .opaque or kind == .escape: effect_summaries[f].footprint_opaque = true
        else if kind != .write and kind != .remainder: return false
    if f == effect_body_owner and event.atom.kind == .panic: effect_body_panics.push(event)
    # (allocation proven within an arena's acquired capacity is not hidden: arena.jo)
    if arena_fns.len() > 0 and arena_capacity_exempt(event): return false
    covered = effect_place_atom(event.atom)
    root = if covered: place_base(event.atom.place) else: event.atom.place
    if effect_summaries[f].stamp == 0:
        effect_stamps += 1
        effect_summaries[f].stamp = effect_stamps
    stamp = effect_summaries[f].stamp
    if effect_event_index.has(EffectEventKey(stamp, event.atom)): return false
    if effect_summaries[f].capped: return false
    # (a whole-root event already covers its fields)
    if covered and effect_event_index.has(EffectEventKey(stamp, EffectAtom(event.atom.kind, root))): return false
    if effect_summaries[f].events.len() >= 32:
        # Past the budget every place event widens to its whole root, still an
        # upper bound: a kernel touching many fields of one record stays exact
        # about which records it reads and writes.
        kept: EffectEvent[]
        loop old0 in effect_summaries[f].events:
            old = old0
            if effect_place_atom(old.atom): old.atom.place = place_base(old.atom.place)
            seen = false
            loop k in kept:
                if k.atom == old.atom: seen = true
            if not seen: kept.push(old)
        wide = event
        if covered: wide.atom.place = root
        loop k in kept:
            if k.atom == wide.atom:
                effect_summaries[f].events = kept
                effect_restamp(f)
                return true
        if kept.len() < 32:
            kept.push(wide)
            effect_summaries[f].events = kept
            effect_restamp(f)
            return true
        effect_summaries[f].events = kept
        effect_restamp(f)
        effect_summaries[f].capped = true
        loop old in effect_summaries[f].events:
            if old.atom.kind == .opaque: return false
        effect_summaries[f].events.push(EffectEvent(EffectAtom(.opaque), event.witness, event.via))
        effect_event_index[EffectEventKey(effect_summaries[f].stamp, EffectAtom(.opaque))] = true
        return true
    effect_summaries[f].events.push(event)
    effect_event_index[EffectEventKey(stamp, event.atom)] = true
    effect_ticks += 1
    effect_summaries[f].changed_at = effect_ticks
    true

effect_opaque = (f: int, n: int): effect_add(f, EffectEvent(EffectAtom(.opaque), n))

# Locals never cross call edges. Externally visible roots use owner-qualified
# formal ordinals, global declarations, or conservatively opaque provenance.
effect_export = (f: int, p0: PlaceIdentity) -> PlaceIdentity:
    p = place_base(p0)
    if p.root == .local:
        l = p.declaration
        if l <= 0 or l >= locals.len(): return PlaceIdentity(.local, 0, 0)
        fl = int(locals[l].flags)
        if fl & (LF_CAPTURE | LF_SHARED | LF_CAPTURED) != 0: return PlaceIdentity(.local, 0, 0)
        if fl & LF_MUTPARAM != 0:
            loop i in [0..fns[f].params.len()):
                if fns[f].params[i] == l: return place_append(PlaceIdentity(.formal, f, i + 1), p0)
            return PlaceIdentity(.local, 0, 0)
    p0

# Identity alone is not a storage proof. Recursive fields can introduce
# box_unique (allocation/detach) while taking the address of a scalar leaf.
# Consult the same layout/boxed-field decision as both lowerers.
effect_place_inventory = (n: int, depth: int = 0) -> bool:
    if n == 0 or depth > 32: return false
    k = nodes[n].kind
    if k == .addr: return effect_place_inventory(int(nodes[n].a), depth + 1)
    if effect_fixed_index(n): return effect_place_inventory(int(nodes[n].a), depth + 1)
    if k == .field:
        t = prune(ntype(int(nodes[n].a)))
        if types[t].kind != .struct_ or nodes[n].aux < 0: return false
        layout(t)
        fi = int(structs[int(types[t].st)].fields) + int(nodes[n].aux)
        if fields[fi].boxed: return false
        return effect_place_inventory(int(nodes[n].a), depth + 1)
    if k != .ident: return false
    if nodes[n].aux == i32(int(SK.global)): return true
    if nodes[n].aux != i32(int(SK.local)): return false
    l = int(nodes[n].sym)
    flags = int(locals[l].flags)
    if flags & LF_ALIAS != 0:
        # (a binding narrowed by `is?` names its payload, or the union's
        # remaining members: the test proved the tag)
        return effect_place_inventory(effect_narrowed(int(locals[l].alias)), depth + 1)
    flags & (LF_CAPTURE | LF_CAPTURED | LF_SHARED | LF_BYREF | LF_EXPOSED) == 0

# The value a narrowing alias reads: an optional's payload, a union's member,
# or the union's remaining members re-tagged in place; n itself otherwise.
effect_narrowed = (n: int) -> int:
    k = nodes[n].kind
    if k == .unwrap or k == .narrow or k == .conv and nodes[n].aux == i32(int(CV.union_)) and effect_share(ntype(n)) and effect_share(ntype(int(nodes[n].a))): return int(nodes[n].a)
    n

# `xs[i]`: one index. The checker keeps the written selector as the only kid
# (a compound update reads a captured copy); scanning both is conservative.
effect_single_index = (n: int) -> bool:
    nodes[n].kind == .index and nodes[n].b != 0 and nkids(n) <= 1

# An element of a fixed array is inline storage of the array: `xs[i]` with a
# word index. Element routes are coarse (the whole array), never invented.
effect_fixed_index = (n: int) -> bool:
    if not effect_single_index(n): return false
    t = representation_type(ntype(int(nodes[n].a)))
    tkind(t) == .fixed and effect_plain(int(types[t].elem)) and effect_word(int(nodes[n].b))

# A read-only element read: a fixed array's, or an array of shares' (a
# shared immutable view; reading it neither detaches nor allocates).
effect_index_read = (n: int) -> bool:
    if effect_fixed_index(n): return true
    if not effect_single_index(n): return false
    t = representation_type(ntype(int(nodes[n].a)))
    tkind(t) == .array and effect_share(telem(t)) and effect_word(int(nodes[n].b))

effect_route = (n: int, depth: int = 0) -> PlaceIdentity:
    if depth > 32: return PlaceIdentity(.local, 0, 0)
    k = nodes[n].kind
    if k == .addr or effect_fixed_index(n): return effect_route(int(nodes[n].a), depth + 1)
    if k == .field and tkind(ntype(int(nodes[n].a))) == .struct_: return place_project(effect_route(int(nodes[n].a), depth + 1), int(nodes[n].name))
    if k == .ident and nodes[n].aux == i32(int(SK.local)) and int(locals[int(nodes[n].sym)].flags) & LF_ALIAS != 0:
        # (a binding narrowed by `is?` reads the optional's or union's own storage)
        alias = int(locals[int(nodes[n].sym)].alias)
        if effect_narrowed(alias) != alias: return effect_route(effect_narrowed(alias), depth + 1)
    if k == .field or k == .ident and nodes[n].aux == i32(int(SK.local)) and int(locals[int(nodes[n].sym)].flags) & LF_ALIAS != 0: return place_route(n, depth)
    place_scalar_root(n)

# An element access can fail unless its index is proven in bounds: by the
# checker (a constant into a fixed array, a generated in-bounds index), by an
# unsigned index type covering a fixed array, or by the owner body's facts.
effect_bounds = (f: int, n: int):
    if has_flag(n, NF_INBOUNDS) or effect_bounds_proven.has(n): return
    ix = int(nodes[n].b)
    t = representation_type(ntype(int(nodes[n].a)))
    if tkind(t) == .fixed:
        if nodes[ix].kind == .int_lit and not has_flag(ix, NF_U64) and nodes[ix].ival >= 0 and nodes[ix].ival < fixed_len(t): return
        it = prune(ntype(ix))
        if types[it].kind == .int_ and not types[it].sign and int(types[it].bits) < 32 and (1 << int(types[it].bits)) <= fixed_len(t): return
    effect_failure(f, n)

# A possible failure at n (an index, a divisor, a refinement check) unless the
# owner body's facts discharge it; the facts probe answers each site.
effect_failure = (f: int, n: int):
    if effect_bounds_proven.has(n) or fact_range_assumed(n): return
    effect_bound_sites.push((f, n))
    effect_add(f, EffectEvent(EffectAtom(.panic), n))

# The selectors a target place evaluates: element indices and their bounds.
effect_target_parts = (f: int, n: int, depth: int = 0):
    if n == 0 or depth > 32: return
    k = nodes[n].kind
    if effect_fixed_index(n):
        effect_scan_node(f, int(nodes[n].b))
        loop c in kids(n): effect_scan_node(f, c)
        effect_bounds(f, n)
    if k == .addr or k == .field or effect_fixed_index(n): effect_target_parts(f, int(nodes[n].a), depth + 1)

# Semantic-integer counters proven to stay small immediates, by local: the
# magnitude bound of a counted loop's counter over small bounds.
effect_counters: {int: int} = {}

# A semantic integer that provably stays a small immediate (no promotion, no
# check): a nonnegative literal, a small counter, and sums, differences and
# products of them. Its magnitude bound, or -1.
effect_small = (n: int, depth: int = 0) -> int:
    if n == 0 or depth > 8: return -1
    k = nodes[n].kind
    if k == .int_lit and is_int(ntype(n)) and not has_flag(n, NF_U64) and nodes[n].ival >= 0: return if nodes[n].ival < (1 << 31): nodes[n].ival else: -1
    if k == .ident and nodes[n].aux == i32(int(SK.local)) and prune(ntype(n)) == T_MATH_INT: return effect_counters.get(int(nodes[n].sym)) ?? -1
    # (a value-preserving integer conversion of a small value)
    if k == .conv and (nodes[n].aux == i32(int(CV.int_)) or nodes[n].aux == i32(int(CV.none_))) and is_int(ntype(n)): return effect_small(int(nodes[n].a), depth + 1)
    if k != .binary or nodes[n].aux != 0 or prune(ntype(n)) != T_MATH_INT: return -1
    op = nodes[n].op as Tok
    if op != .plus and op != .minus and op != .star: return -1
    a = effect_small(int(nodes[n].a), depth + 1)
    b = effect_small(int(nodes[n].b), depth + 1)
    if a < 0 or b < 0: return -1
    r = if op == .star: a * b else: a + b
    if r >= (1 << 40): return -1
    r

# A word operand, or a semantic integer that stays a small immediate.
effect_word = (n: int) -> bool: effect_scalar(ntype(n)) or effect_small(n) >= 0

# An integer: a word or an `int`.
effect_integer = (n: int) -> bool:
    t = representation_type(ntype(n))
    t == T_MATH_INT or effect_scalar(t) and types[t].kind == .int_

# The word inside a value-preserving widening of a word to `int`, or n.
effect_unwidened = (n: int) -> int:
    if nodes[n].kind == .conv and (nodes[n].aux == i32(int(CV.int_)) or nodes[n].aux == i32(int(CV.none_))) and prune(ntype(n)) == T_MATH_INT and effect_scalar(ntype(int(nodes[n].a))): return int(nodes[n].a)
    n

# A counted loop over a word range: its bounds are evaluated once, and its
# counter is a private word (or a small semantic integer, recorded).
effect_range_loop = (n: int) -> bool:
    it = int(nodes[n].a)
    if nodes[it].kind != .range or nodes[n].sym <= 0: return false
    l = int(nodes[n].sym)
    small = prune(int(locals[l].type)) == T_MATH_INT
    if not small and not effect_scalar(int(locals[l].type)): return false
    if int(locals[l].flags) & (LF_ASSIGNED | LF_CAPTURE | LF_CAPTURED | LF_SHARED | LF_BYREF | LF_ADDR | LF_EXPOSED) != 0: return false
    bound = 0
    loop c in [int(nodes[it].a), int(nodes[it].b), int(nodes[it].c)]:
        if c == 0: continue
        if small:
            m = effect_small(c)
            if m < 0: return false
            bound = max(bound, m + 1)
        else if not effect_scalar(ntype(c)) and not effect_count_literal(c): return false
    if small: effect_counters[l] = bound
    true

# A fixed array literal is built in place: its elements, or zeros.
effect_fixed_literal = (n: int) -> bool:
    t = representation_type(ntype(n))
    if nodes[n].kind != .array or nodes[n].b != 0 or tkind(t) != .fixed or not effect_plain(t): return false
    loop c in kids(n):
        if has_flag(c, NF_SPREAD): return false
    true

# Proven immutable startup constants need no external read: a literal word,
# or a fixed array of literal words.
effect_const_literal = (g: int) -> bool:
    if globals[g].is_const:
        init = int(globals[g].init)
        return init != 0 and (nodes[init].kind == .int_lit or nodes[init].kind == .bool_lit)
    if not readonly_global(g): return false
    init = int(nodes[int(globals[g].decl)].b)
    if init == 0: return false
    if nodes[init].kind == .conv and nodes[init].aux == i32(int(CV.none_)): init = int(nodes[init].a)
    if nodes[init].kind != .array or nodes[init].b != 0 or tkind(representation_type(int(globals[g].type))) != .fixed: return false
    loop c in kids(init):
        if nodes[c].kind != .int_lit and nodes[c].kind != .bool_lit or has_flag(c, NF_SPREAD): return false
    true

effect_access = (f: int, n: int, write: bool):
    if not effect_value(ntype(n)) or not effect_place_inventory(n): effect_opaque(f, n)
    if write and nodes[n].kind == .field:
        t = representation_type(ntype(int(nodes[n].a)))
        layout(t)
        if int(types[t].flags) & TF_BOXED != 0: effect_plan_cost(f, n, 1 << int(EffectKind.alloc))
    p = effect_export(f, effect_route(n))
    if p.declaration == 0:
        effect_opaque(f, n)
        return
    if p.root == .local: return
    if p.root == .global and not write and effect_const_literal(p.declaration): return
    kind = if write: EffectKind.write else: EffectKind.read
    effect_add(f, EffectEvent(EffectAtom(kind, p), n))

effect_isolation_block = (f: int, reason: IsolationReason, n: int):
    if effect_summaries[f].isolation == .none_:
        effect_summaries[f].isolation = reason
        effect_summaries[f].isolation_witness = n

# One full collection even after a blocker. Legacy isolation reuses the
# conservative blocker and direct edges from this scan, never a row permission.
# A bounded backward proof for storage costs only. An invocation contract does
# not prove that copying an arbitrary environment is free. Join every source;
# lost provenance, recursion or an exposed entry point remains unknown.
effect_bare = (n: int, depth: int = 0) -> bool:
    if n == 0 or depth > 16: return false
    k = nodes[n].kind
    if k == .conv: return effect_bare(int(nodes[n].a), depth + 1)
    if k == .lambda and not has_flag(n, NF_GENERIC): return nodes[n].sym > 0 and fns[int(nodes[n].sym)].caps.len() == 0
    if k == .fnref: return nodes[n].aux != 1 and nodes[n].aux != 2 and nodes[n].sym > 0 and not fns[int(nodes[n].sym)].has_env
    if k != .ident or nodes[n].aux != i32(int(SK.local)): return false
    l = int(nodes[n].sym)
    flags = int(locals[l].flags)
    if flags & (LF_CAPTURE | LF_CAPTURED | LF_SHARED | LF_ADDR | LF_EXPOSED) != 0: return false
    if flags & LF_PARAM != 0:
        owner = int(locals[l].owner)
        slot = -1
        loop i in [0..fns[owner].params.len()):
            if fns[owner].params[i] == l: slot = i
        if slot < 0 or fns[owner].cabi or len(fns[owner].export_name) != 0: return false
        found = false
        loop q in effect_use_sites(owner):
            if nodes[q].kind == .fnref and nodes[q].sym == i32(owner): return false
            if nodes[q].kind != .call or nodes[q].aux != 0 or nodes[q].sym != i32(owner): continue
            if slot >= nkids(q) or not effect_bare(kid(q, slot), depth + 1): return false
            found = true
        return found
    found = false
    loop q in effect_scalar_sites(l):
        if nodes[q].kind == .vardecl and not has_flag(q, NF_GLOBAL) and nodes[q].sym == i32(l):
            if not effect_bare(int(nodes[q].b), depth + 1): return false
            found = true
        if nodes[q].kind == .assign and place_scalar_root(int(nodes[q].a)) == PlaceIdentity(.local, int(locals[l].owner), l):
            if not effect_bare(int(nodes[q].b), depth + 1): return false
    found

effect_readonly_binding = (n: int) -> bool:
    if nodes[n].kind != .vardecl or nodes[n].aux2 != 1: return false
    if dbg_on and (not copies_on or not copy_strict(n)): return false
    l = int(nodes[n].sym)
    a = int(nodes[n].b)
    if a == 0 or nodes[a].kind != .ident or nodes[a].aux != i32(int(SK.local)): return false
    p = int(nodes[a].sym)
    if int(locals[p].flags) & LF_PARAM == 0 or int(locals[p].flags) & (LF_MUTPARAM | LF_ADDR | LF_CAPTURE | LF_CAPTURED) != 0: return false
    if locals[p].owner != locals[l].owner or locals[p].name != locals[l].name or not type_eq(int(locals[p].type), int(locals[l].type)): return false
    if copies_on and copy_bindings.has(l): return false
    if int(locals[l].flags) & (LF_ASSIGNED | LF_ADDR | LF_CAPTURE | LF_CAPTURED | LF_BYREF | LF_ALIAS | LF_EXPOSED | LF_SHARED) != 0: return false
    t = representation_type(int(locals[l].type))
    if tkind(t) == .array and effect_scalar(telem(t)): return true
    is_fn_type(t) and effect_bare(a)

effect_indirect = (f: int, n: int):
    callee = int(nodes[n].a)
    contract = callable_contract(ntype(callee))
    if contract == 0 and (effects_active or effect_policy.prohibitions != 0): contract = effect_source_row(callee)
    effect_scan_node(f, callee)
    ft = callable_base(ntype(callee))
    loop i in [0..nkids(n)):
        a = kid(n, i)
        if int(types[ft].mutmask) & (1 << i) == 0: effect_scan_node(f, a)
        else if not effect_place_inventory(a): effect_opaque(f, a)
    if contract == 0:
        effect_opaque(f, n)
        return
    row = effect_contracts[contract]
    if row.variables.len() != 0: effect_opaque(f, n)
    if row.open:
        # Preserve proven nonlocal exclusions instead of turning an open bound
        # into an unconstrained opaque call. Formal exclusions need remapping.
        exclusions: EffectAtom[]
        loop ex in row.exclusions:
            if place_base(ex.place).root != .formal: exclusions.push(ex)
        remainder = effect_intern([], exclusions, [], true)
        effect_add(f, EffectEvent(EffectAtom(.remainder, row = remainder), n))
    loop atom0 in row.atoms:
        atom = atom0
        base = place_base(atom.place)
        if base.root == .formal:
            i = base.declaration - 1
            if i < 0 or i >= nkids(n): atom = EffectAtom(.opaque)
            else:
                actual = effect_export(f, place_route(kid(n, i)))
                atom.place = place_append(actual, atom.place)
                if atom.place.declaration == 0: atom = EffectAtom(.opaque)
                else if atom.place.root == .local: continue
        effect_add(f, EffectEvent(atom, n))

# A call of the frame compiler/oom.jo wraps an allocating function's body in
# under `$explicit_allocation_failure` (`__setjmp(__oom_frame())` included).
effect_oom_frame = (n: int) -> bool:
    k = nodes[n].kind
    if k == .intrinsic and nodes[n].aux == i32(int(IN.setjmp)) and nkids(n) == 1: return effect_oom_frame(kid(n, 0))
    if k != .call or nodes[n].aux != 0 or nodes[n].sym <= 0 or nkids(n) != 0: return false
    g = int(nodes[n].sym)
    if g >= fns.len() or fns[g].decl == 0 or not fn_in_lib(g): return false
    name = effect_name(g)
    name in ["__oom_frame", "__oom_caught", "__oom_release", "__oom_unsupported"]

effect_scan_node = (f: int, n: int):
    if n == 0 or effect_footprints_only and effect_summaries[f].footprint_opaque: return
    if effect_seen[n] == f: return
    effect_seen[n] = f
    k = nodes[n].kind
    if k == .for_:
        marks = effect_for_marks.get(int(nodes[n].sym)) ?? []
        if not marks.contains(n):
            marks.push(n)
            effect_for_marks[int(nodes[n].sym)] = marks
    # These shortened place walks omit evaluated-root visits. Keep the legacy
    # adapter conservative rather than accidentally proving a global/alias pure.
    if k == .field or k == .assign: effect_isolation_block(f, .node, n)
    hidden: int[]
    reason = isolation_effect(n, hidden)
    if reason != .none_: effect_isolation_block(f, reason, n)
    if k == .ident:
        if nodes[n].aux == i32(int(SK.global)): effect_isolation_block(f, .global_, n)
        else if nodes[n].aux != i32(int(SK.local)): effect_isolation_block(f, .node, n)
        else if int(locals[int(nodes[n].sym)].flags) & (LF_CAPTURE | LF_ADDR) != 0: effect_isolation_block(f, .capture, n)
    if ownership_decls.len() != 0:
        source = 0
        if k == .vardecl or k == .assign: source = int(nodes[n].b)
        else if k == .return_ or k == .conv and nodes[n].aux == i32(int(CV.explicit_copy)): source = int(nodes[n].a)
        if source != 0: effect_owner_init(f, source, n)
    # (`$assert` is erased: proven at compile time, its operands never run)
    if k == .intrinsic and nodes[n].aux == i32(int(IN.static_assert)): return
    # (an explicit-allocation-failure frame's bookkeeping, compiler/oom.jo: the
    # frame exists only for a function that may allocate, and its thread-state
    # words are the allocator's own; it is allocation, not an external effect)
    if effect_oom_frame(n):
        effect_add(f, EffectEvent(EffectAtom(.alloc), n))
        return
    if k == .intrinsic and nodes[n].aux2 == i32(RANGE_EXHAUSTION):
        effect_failure(f, n)
        return
    if k == .intrinsic:
        cost = effect_intrinsic_cost(nodes[n].aux as IN)
        effect_plan_cost(f, n, cost)
        if nkids(n) > 0 and cost > 0 and isolation_intrinsic(nodes[n].aux as IN):
            effect_access(f, kid(n, 0), true)
    if k == .array and (nkids(n) > 0 or nodes[n].b != 0) and not effect_fixed_literal(n): effect_plan_cost(f, n, 1 << int(EffectKind.alloc))
    if k == .str_lit and nkids(n) > 0: effect_plan_cost(f, n, 1 << int(EffectKind.alloc))
    # (an interpolated part: its formatter writes the interpolation's own buffer)
    if k == .pair and nodes[n].sym > 0 and nodes[n].b == 0:
        effect_summaries[f].edges.push(EffectEdge(int(nodes[n].sym), n, [PlaceIdentity(.local, f, n)]))
        effect_scan_node(f, int(nodes[n].a))
        return
    if k == .lambda and nodes[n].sym > 0 and fns[int(nodes[n].sym)].caps.len() != 0:
        effect_plan_cost(f, n, 1 << int(EffectKind.alloc))
    if k == .partial: effect_plan_cost(f, n, 1 << int(EffectKind.alloc))
    if k == .conv and (nodes[n].aux == i32(int(CV.fixed2arr)) or nodes[n].aux == i32(int(CV.fn2clos)) or nodes[n].aux == i32(int(CV.explicit_copy)) and not effect_plain(ntype(n)) and not ownership_scalar(ntype(n))):
        effect_plan_cost(f, n, 1 << int(EffectKind.alloc))
    if k == .call and nodes[n].aux == 2:
        effect_cleanup(f, ntype(n), n, PlaceIdentity(.local, f, n))
        t = representation_type(ntype(n))
        layout(t)
        if int(types[t].flags) & TF_BOXED != 0: effect_plan_cost(f, n, 1 << int(EffectKind.alloc))
    if k == .vardecl and not has_flag(n, NF_GLOBAL) and nodes[n].sym > 0:
        l = int(nodes[n].sym)
        effect_cleanup(f, int(locals[l].type), n, effect_export(f, PlaceIdentity(.local, f, l)))
    if ownership_literal_print(n):
        effect_add(f, EffectEvent(EffectAtom(.io), n))
        effect_isolation_block(f, .node, n)
        return
    if k == .call and nodes[n].aux == 1:
        effect_indirect(f, n)
        return
    # (a comprehension into a fixed array of plain elements fills it in place:
    # a counted range loop and its element values; a count not proven to be
    # the length may fail)
    if k == .conv and nodes[n].aux == i32(int(CV.arr2fixed)) and fact_fixed_comprehension(int(nodes[n].a), ntype(n)) != 0:
        b = int(nodes[n].a)
        loop_ = kid(b, 1)
        push = fact_fixed_comprehension(b, ntype(n))
        if nodes[loop_].aux != 0 or not effect_range_loop(loop_):
            effect_opaque(f, n)
            return
        inner: int[]
        if isolation_effect(loop_, inner) != .none_: effect_isolation_block(f, .node, loop_)
        loop g in inner: effect_summaries[f].edges.push(EffectEdge(g, loop_, []))
        it = int(nodes[loop_].a)
        loop c in [int(nodes[it].a), int(nodes[it].b), int(nodes[it].c)]: effect_scan_node(f, c)
        body = int(nodes[loop_].b)
        loop i in [0..nkids(body) - 1): effect_scan_node(f, kid(body, i))
        effect_scan_node(f, kid(push, 1))
        if not fact_fixed_comprehension_exact(b, ntype(n)): effect_failure(f, n)
        return
    # (a builtin floor `//` or `%` on words is the inline word operation; only
    # a divisor not proven nonzero can fail)
    if k == .call and nodes[n].aux == 0 and effect_scalar(ntype(n)) and fact_floor_call(n) != 0:
        loop c in kids(n): effect_scan_node(f, c)
        if fact_floor_call(n) <= 2: effect_failure(f, n)
        return
    if k == .call and nodes[n].aux == 0:
        g = int(nodes[n].sym)
        routes: PlaceIdentity[]
        if g <= 0 or g >= effect_limit:
            effect_opaque(f, n)
            return
        loop i in [0..nkids(n)):
            a = kid(n, i)
            mutable = i < fns[g].params.len() and int(locals[fns[g].params[i]].flags) & LF_MUTPARAM != 0
            if mutable:
                effect_isolation_block(f, .node, a)
                p = effect_export(f, place_route(a))
                routes.push(p)
                if p.declaration == 0 or not effect_place_inventory(a): effect_opaque(f, a)
                # A supported place route has no evaluated selector or helper.
                # Unsupported actuals must still contribute their own effects.
                if p.declaration == 0: effect_scan_node(f, a)
            else:
                routes.push(PlaceIdentity(.local, 0, 0))
                effect_scan_node(f, a)
                if ownership_decls.len() != 0: effect_owner_init(f, a, n)
        effect_summaries[f].edges.push(EffectEdge(g, n, routes))
        if not effect_value(int(fns[g].ret)) and int(fns[g].ret) != T_VOID: effect_opaque(f, n)
        # (a string index or slice: in bounds by the caller's facts, or a possible failure)
        if fact_string_call(n) >= 2: effect_failure(f, n)
        return
    if k == .assign:
        effect_target_parts(f, int(nodes[n].a))
        effect_access(f, int(nodes[n].a), true)
        if nodes[n].op != i32(int(Tok.assign)):
            effect_access(f, int(nodes[n].a), false)
            if not effect_word_op(compound_op(int(nodes[n].op)) as Tok): effect_opaque(f, n)
            # (an `int` shifted by a signed count fails for a negative one: facts.jo)
            else if fact_shift_obliged(n) and not effect_count_literal(int(nodes[n].b)): effect_failure(f, n)
        effect_scan_node(f, int(nodes[n].b))
        return
    if k == .ident and nodes[n].aux == i32(int(SK.local)):
        l = int(nodes[n].sym)
        if effect_small(n) >= 0: return
        t = representation_type(ntype(n))
        if is_fn_type(t) and effect_bare(n): return
        if tkind(t) == .array and effect_scalar(telem(t)) and int(locals[l].flags) & LF_PARAM != 0:
            if int(locals[l].flags) & LF_MUTPARAM == 0: return
            # (a mutable parameter's storage is the caller's: reading it is a read of the formal)
            p = effect_export(f, place_scalar_root(n))
            if p.declaration != 0 and p.root == .formal:
                effect_add(f, EffectEvent(EffectAtom(.read, p), n))
                return
        if effect_share(t) and int(locals[l].flags) & LF_BYREF != 0:
            loop q in effect_for_marks.get(l) ?? []:
                if effect_seen[q] == f and nodes[q].kind == .for_ and nodes[q].sym == i32(l) and not has_flag(q, NF_MUT) and tkind(ntype(int(nodes[q].a))) == .array: return
        loop q in kids(int(fns[f].body)):
            if nodes[q].kind == .vardecl and not has_flag(q, NF_GLOBAL) and nodes[q].sym == i32(l) and effect_readonly_binding(q): return
    if k == .ident or k == .field:
        effect_access(f, n, false)
        return
    if k == .for_ and effect_range_loop(n):
        loop c in [int(nodes[int(nodes[n].a)].a), int(nodes[int(nodes[n].a)].b), int(nodes[int(nodes[n].a)].c), int(nodes[n].b)]: effect_scan_node(f, c)
        # (a zero step fails unless the owner's facts show it is not: facts.jo fact_step_check)
        if fact_open_range(n) or fact_stepped_loop(n) and not panic_literal_step(int(nodes[n].a)): effect_failure(f, n)
        loop g in hidden: effect_summaries[f].edges.push(EffectEdge(g, n, []))
        return
    if effect_index_read(n):
        effect_scan_node(f, int(nodes[n].a))
        effect_scan_node(f, int(nodes[n].b))
        loop c in kids(n): effect_scan_node(f, c)
        effect_bounds(f, n)
        return
    supported = false
    if k == .intrinsic: supported = effect_intrinsic_cost(nodes[n].aux as IN) >= 0
    else if k == .call and nodes[n].aux == 2: supported = effect_share(ntype(n))
    # (a member into a union of shares: `return Oops` from `:>(int64|Oops)`)
    else if k == .call and nodes[n].aux == 3: supported = effect_share(ntype(n))
    # (a literal is static data; an interpolation's allocation is counted above)
    else if k == .str_lit: supported = true
    else if k == .fnref or k == .lambda: supported = effect_bare(n)
    else if k == .for_: supported = tkind(ntype(int(nodes[n].a))) == .array and effect_share(telem(ntype(int(nodes[n].a)))) and not has_flag(n, NF_MUT)
    # (an `int` literal is a constant, whatever its sign)
    else if k == .int_lit or k == .bool_lit: supported = effect_scalar(ntype(n)) or effect_count_literal(n) or effect_small(n) >= 0 or k == .int_lit and prune(ntype(n)) == T_MATH_INT and not has_flag(n, NF_U64)
    else if k == .float_lit: supported = effect_float(ntype(n))
    else if k == .array: supported = effect_fixed_literal(n)
    # (a conditional loop is visible control flow, not a hidden cost: its
    # condition and body answer for their own operations)
    else if k == .block or k == .exprstmt or k == .return_ or k == .if_ or k == .while_ or k == .and_ or k == .or_ or k == .not_ or k == .defer_ or k == .break_ or k == .continue_: supported = true
    else if k == .tuple: supported = effect_share(ntype(n))
    else if k == .vardecl and nkids(n) > 0:
        # (unpacking plain components into private locals)
        supported = effect_plain(ntype(int(nodes[n].b))) and not has_flag(n, NF_GLOBAL)
        loop c in kids(n):
            if nodes[c].kind == .hole: continue
            if has_flag(c, NF_GLOBAL) or nodes[c].sym <= 0: supported = false
            else if int(locals[int(nodes[c].sym)].flags) & (LF_CAPTURE | LF_CAPTURED | LF_SHARED | LF_BYREF) != 0: supported = false
    else if k == .vardecl:
        l = int(nodes[n].sym)
        if effect_readonly_binding(n): return
        supported = l > 0 and (effect_value(int(locals[l].type)) or is_fn_type(int(locals[l].type)) and effect_bare(int(nodes[n].b))) and int(locals[l].flags) & (LF_CAPTURE | LF_CAPTURED | LF_SHARED | LF_BYREF) == 0
    else if k == .binary:
        shift = nodes[n].op == i32(int(Tok.shl)) or nodes[n].op == i32(int(Tok.shr))
        count_ok = effect_scalar(ntype(int(nodes[n].b))) or shift and effect_count_literal(int(nodes[n].b))
        supported = nodes[n].aux == 0 and effect_word_op(nodes[n].op as Tok) and effect_scalar(ntype(int(nodes[n].a))) and count_ok
        # (word division and remainder: a zero divisor is a possible failure)
        if not supported and nodes[n].aux == 0 and (nodes[n].op == i32(int(Tok.slash)) or nodes[n].op == i32(int(Tok.percent))) and effect_scalar(ntype(int(nodes[n].a))) and effect_scalar(ntype(int(nodes[n].b))):
            supported = true
            divisor = int(nodes[n].b)
            if nodes[divisor].kind != .int_lit or nodes[divisor].ival == 0: effect_failure(f, n)
        if not supported and nodes[n].aux == 0 and effect_float_op(nodes[n].op as Tok) and effect_float(ntype(int(nodes[n].a))) and effect_float(ntype(int(nodes[n].b))): supported = true
        # (members of one literal union compare as words)
        if not supported and nodes[n].aux == 0 and (nodes[n].op == i32(int(Tok.eq)) or nodes[n].op == i32(int(Tok.ne))):
            supported = effect_simple_enum(ntype(int(nodes[n].a))) and effect_simple_enum(ntype(int(nodes[n].b)))
        # (small semantic integers: arithmetic that cannot promote, comparisons)
        if not supported and nodes[n].aux == 0 and effect_word(int(nodes[n].a)) and effect_word(int(nodes[n].b)):
            supported = effect_small(n) >= 0 or (effect_word_op(nodes[n].op as Tok) and effect_scalar(ntype(n)))
        # (a small counter against a word widened to `int`: compared as two
        # words, so the widened word is never packed)
        if not supported and nodes[n].aux == 0 and effect_scalar(ntype(n)) and fact_comparison(nodes[n].op as Tok):
            a = effect_unwidened(int(nodes[n].a))
            b = effect_unwidened(int(nodes[n].b))
            if (a != int(nodes[n].a) or b != int(nodes[n].b)) and effect_word(a) and effect_word(b):
                loop g in hidden: effect_summaries[f].edges.push(EffectEdge(g, n, []))
                effect_scan_node(f, a)
                effect_scan_node(f, b)
                return
        # (text compares by reading both, and the library's `+` on text
        # allocates; `int`s compare as words or by reading a big payload, and
        # `+ - *` on one may grow it into a big integer, which allocates)
        if not supported and nodes[n].aux == 2 and types[representation_type(ntype(int(nodes[n].a)))].kind == .str_ and types[representation_type(ntype(int(nodes[n].b)))].kind == .str_:
            supported = fact_comparison(nodes[n].op as Tok) or nodes[n].op == i32(int(Tok.plus))
            if nodes[n].op == i32(int(Tok.plus)): effect_plan_cost(f, n, 1 << int(EffectKind.alloc))
        if not supported and nodes[n].aux == 0 and fact_comparison(nodes[n].op as Tok) and effect_integer(int(nodes[n].a)) and effect_integer(int(nodes[n].b)): supported = true
        if not supported and nodes[n].aux == 0 and prune(ntype(n)) == T_MATH_INT and effect_integer(int(nodes[n].a)) and effect_integer(int(nodes[n].b)) and (nodes[n].op == i32(int(Tok.plus)) or nodes[n].op == i32(int(Tok.minus)) or nodes[n].op == i32(int(Tok.star))):
            supported = true
            effect_plan_cost(f, n, 1 << int(EffectKind.alloc))
        # (an `int` shifted may grow into a big integer, which allocates; a
        # negative signed count fails unless the owner's facts show it is not)
        if not supported and shift and nodes[n].aux == 0 and prune(ntype(n)) == T_MATH_INT and effect_integer(int(nodes[n].a)) and effect_integer(int(nodes[n].b)):
            supported = true
            effect_plan_cost(f, n, 1 << int(EffectKind.alloc))
            if fact_shift_obliged(n) and not effect_count_literal(int(nodes[n].b)): effect_failure(f, n)
    else if k == .dotname or k == .none_lit: supported = effect_share(ntype(n))
    # (an optional's or union's tag test, payload and fallback are inline reads)
    else if k == .istype or k == .narrow or k == .coalesce: supported = effect_share(ntype(int(nodes[n].a))) and (k == .istype or effect_share(ntype(n)))
    else if k == .unary:
        supported = effect_scalar(ntype(n)) and (nodes[n].op == i32(int(Tok.minus)) or nodes[n].op == i32(int(Tok.plus)) or nodes[n].op == i32(int(Tok.tilde)))
        supported = supported or effect_float(ntype(n)) and (nodes[n].op == i32(int(Tok.minus)) or nodes[n].op == i32(int(Tok.plus)))
        # (negating an `int` may grow it: -(-2^63))
        if not supported and prune(ntype(n)) == T_MATH_INT and (nodes[n].op == i32(int(Tok.minus)) or nodes[n].op == i32(int(Tok.plus))):
            supported = true
            effect_plan_cost(f, n, 1 << int(EffectKind.alloc))
    else if k == .conv and nodes[n].aux == i32(int(CV.explicit_copy)) and ownership_scalar(ntype(n)): supported = true
    else if k == .conv and nodes[n].aux == i32(int(CV.refinement)):
        # A proven refinement check is erased; an unproven one may fail.
        supported = effect_plain(ntype(n))
        if supported and not type_eq(ntype(int(nodes[n].a)), int(nodes[n].aux2)): effect_failure(f, n)
    # (wrapping a value as an optional, or one union as a wider one, fills the
    # flag or tag and the payload in place)
    else if k == .conv and (nodes[n].aux == i32(int(CV.opt)) or nodes[n].aux == i32(int(CV.union_))): supported = effect_share(ntype(n)) and effect_share(ntype(int(nodes[n].a)))
    else if k == .conv and nodes[n].aux == i32(int(CV.set_text)): supported = true
    # (a word widened to an `int` may need a big payload: an allocation)
    else if k == .conv and nodes[n].aux == i32(int(CV.int_)) and prune(ntype(n)) == T_MATH_INT and effect_scalar(ntype(int(nodes[n].a))):
        supported = true
        if effect_small(int(nodes[n].a)) < 0: effect_plan_cost(f, n, 1 << int(EffectKind.alloc))
    # (an `int` narrowed to a fixed width fails unless the owner's facts show it fits)
    else if k == .conv and nodes[n].aux == i32(int(CV.int_)) and prune(ntype(int(nodes[n].a))) == T_MATH_INT and effect_scalar(ntype(n)) and effect_small(int(nodes[n].a)) < 0:
        supported = true
        effect_failure(f, n)
    # (an `int` wrapped or saturated to a fixed width is total: a read of its
    # low limbs, lib/math_runtime.jo __mi_low_word and __mi_clamp_word)
    else if k == .conv and (nodes[n].aux == i32(int(CV.wrap_int)) or nodes[n].aux == i32(int(CV.saturate_int))) and prune(ntype(int(nodes[n].a))) == T_MATH_INT and effect_scalar(ntype(n)): supported = true
    # (a float to an integer fails for NaN, an infinity or a value out of
    # range unless the owner's float facts show it fits, floats.jo; an `int`
    # result may need a big payload)
    else if k == .conv and nodes[n].aux == i32(int(CV.float2int)) and effect_float(ntype(int(nodes[n].a))) and (effect_scalar(ntype(n)) or prune(ntype(n)) == T_MATH_INT):
        supported = true
        if prune(ntype(n)) == T_MATH_INT: effect_plan_cost(f, n, 1 << int(EffectKind.alloc))
        effect_failure(f, n)
    # (a word to a float, or one float width to another: one instruction; a
    # float to an integer is checked, and a semantic integer's is a call)
    else if k == .conv and (nodes[n].aux == i32(int(CV.int2float)) and effect_scalar(ntype(int(nodes[n].a))) or nodes[n].aux == i32(int(CV.float_))): supported = effect_float(ntype(n))

    else if k == .conv:
        supported = (effect_scalar(ntype(n)) and effect_word(int(nodes[n].a)) or effect_small(n) >= 0 or is_fn_type(ntype(n)) and effect_bare(int(nodes[n].a))) and (nodes[n].aux == i32(int(CV.none_)) or nodes[n].aux == i32(int(CV.int_)) or nodes[n].aux == i32(int(CV.wrap_int)) or nodes[n].aux == i32(int(CV.saturate_int)) or nodes[n].aux == i32(int(CV.fixed_store)))
    if not supported: effect_opaque(f, n)
    # Hidden calls cannot be trusted by annotation or pathname. They remain
    # explicit dependencies for witnesses and legacy isolation even when this
    # pilot's cost inventory has already rejected their containing operation.
    loop g in hidden: effect_summaries[f].edges.push(EffectEdge(g, n, []))
    if hidden.len() > 0 and (k == .binary or k == .intrinsic):
        operand = if k == .binary: int(nodes[n].a) else if nkids(n) > 0: kid(n, 0) else: 0
        if operand != 0 and is_managed(representation_type(ntype(operand))):
            # Callback snapshots may copy managed values. No uniqueness proof
            # is available at this boundary yet, so retain the residual cost.
            effect_plan_cost(f, n, 1 << int(EffectKind.alloc))
    mask = isolation_children(k)
    if mask < 0: return
    if mask & 1 != 0: effect_scan_node(f, int(nodes[n].a))
    if mask & 2 != 0: effect_scan_node(f, int(nodes[n].b))
    if mask & 4 != 0: effect_scan_node(f, int(nodes[n].c))
    if mask & 16 != 0:
        loop c in kids(n): effect_scan_node(f, c)
    if mask & 32 != 0:
        loop c in kids2(n): effect_scan_node(f, c)

effect_edge_event = (f: int, edge: EffectEdge, event0: EffectEvent) -> EffectEvent:
    event = event0
    event.via = edge.origin
    event.via_fn = edge.callee
    p = event.atom.place
    base = place_base(p)
    if base.root == .formal:
        i = base.declaration - 1
        if base.owner != edge.callee or i < 0 or i >= edge.actuals.len(): event.atom = EffectAtom(.opaque)
        else:
            actual = edge.actuals[i]
            if actual.declaration == 0: event.atom = EffectAtom(.opaque)
            else:
                event.atom.place = place_append(actual, p)
                if event.atom.place.declaration == 0: event.atom = EffectAtom(.opaque)
    event

# A declared closed row is the contract callers see, not the body's narrower inferred
# row: a caller is checked against what the callee may do, as declared. Open (negative
# only) rows and rows with variables still left open show the inferred events.

effect_declared_row = (g: int) -> int:
    if let known = effect_declared.get(g): return known
    c = 0
    d = int(fns[g].decl)
    if d != 0 and nodes[d].sval != 0 and fns[g].kind != FK_LAMBDA and nodes[d].kind == .fn_:
        k = effect_subst(int(decl_infos[decl_info(d)].sig.contract), fns[g].targs)
        if k != 0 and not effect_contracts[k].open and effect_contracts[k].variables.len() == 0: c = k
    effect_declared[g] = c
    c

effect_unique_edges = (f: int):
    seen: {EffectEdgeKey: bool} = {}
    unique: int[]
    edges = effect_summaries[f].edges
    loop i in [0..edges.len()):
        key = EffectEdgeKey(edges[i].callee, edges[i].actuals)
        if seen.has(key): continue
        seen[key] = true
        unique.push(i)
    effect_summaries[f].unique = unique
    effect_summaries[f].unique_ready = true

# Re-propagating f is a no-op when no callee changed since f's last pass:
# every re-offered atom is already present, covered by its root, or capped.
effect_stale = (f: int) -> bool:
    if effect_summaries[f].propagated_at == 0: return true
    since = effect_summaries[f].propagated_at
    loop i in effect_summaries[f].unique:
        g = effect_summaries[f].edges[i].callee
        if g > 0 and g < effect_limit and effect_summaries[g].changed_at > since: return true
    false

effect_propagate = (f: int) -> bool:
    if not effect_summaries[f].unique_ready: effect_unique_edges(f)
    if not effect_stale(f): return false
    effect_ticks += 1
    effect_summaries[f].propagated_at = effect_ticks
    changed = false
    loop index in effect_summaries[f].unique:
        edge = effect_summaries[f].edges[index]
        g = edge.callee
        if g <= 0 or g >= effect_limit:
            if effect_add(f, EffectEvent(EffectAtom(.opaque), edge.origin)): changed = true
            continue
        declared = effect_declared_row(g)
        if declared != 0:
            d = int(fns[g].decl)
            loop atom0 in effect_contracts[declared].atoms:
                atom = atom0
                if atom.place.root == .formal:
                    base = place_base(atom.place)
                    atom.place = place_append(PlaceIdentity(.formal, g, base.declaration), atom.place)
                e = effect_edge_event(f, edge, EffectEvent(atom, d))
                if (e.atom.kind == .read or e.atom.kind == .write) and e.atom.place.declaration != 0 and e.atom.place.root == .local: continue
                if effect_add(f, e): changed = true
            continue
        # Snapshot: self-edges can append to this same arena row.
        events = effect_summaries[g].events
        obligation = -1
        loop event in events:
            if event.atom.kind == .panic:
                if obligation < 0: obligation = int(effect_caller_obligation(edge.origin))
                if obligation == 1: continue
            e = effect_edge_event(f, edge, event)
            if (e.atom.kind == .read or e.atom.kind == .write) and e.atom.place.declaration != 0 and e.atom.place.root == .local: continue
            if effect_add(f, e): changed = true
    changed

# Whether facts may treat a call of f as opaque by its signature alone, without
# visiting its call tree: f takes or returns a value that is not plain. A
# superset of effect_visit's signature checks, which accept shares
# (effect_share) and reviewed library classes: forgetting more is sound.
effect_signature_opaque = (f: int) -> bool:
    d = int(fns[f].decl)
    if fns[f].state != 2 or fns[f].body == 0 or fns[f].kind == FK_INIT or (d != 0 and has_flag(d, NF_EXTERN)):
        return not (d != 0 and has_flag(d, NF_EXTERN) and effect_declared_row(f) != 0)
    if fns[f].caps.len() != 0 or fns[f].kind == FK_PARTIAL or fns[f].cabi: return true
    if not effect_plain(int(fns[f].ret)) and not ownership_scalar(int(fns[f].ret)) and int(fns[f].ret) != T_VOID: return true
    loop l in fns[f].params:
        t = representation_type(int(locals[l].type))
        if int(locals[l].flags) & LF_MUTPARAM == 0 and not effect_plain(t) and not is_fn_type(t) and not (tkind(t) == .array and effect_scalar(telem(t))): return true
    false

# (its opaque conditions imply effect_signature_opaque's)
effect_visit = (f: int):
    effect_serial += 1
    effect_summaries[f].index = effect_serial
    effect_summaries[f].low = effect_serial
    effect_stack.push(f)
    effect_summaries[f].footprint_only = effect_footprints_only
    if effect_footprints_only and effect_signature_opaque(f):
        # Numeric consumers already forget every exposed root for this row.
        # Its body and callee graph cannot change that answer. Full contracts
        # request a fresh full graph; isolation uses its own syntax fallback.
        effect_opaque(f, int(fns[f].decl))
    else if let body = effect_bodies.get(f):
        effect_summaries[f].edges = body.edges
        effect_summaries[f].isolation = body.isolation
        effect_summaries[f].isolation_witness = body.witness
        loop event in body.events:
            if event.atom.kind != .panic: effect_add(f, event)
        loop event in body.panics:
            if not effect_bounds_proven.has(event.witness): effect_add(f, event)
    else:
        old_owner = effect_body_owner
        old_panics = effect_body_panics
        if effect_body_cache:
            effect_body_owner = f
            effect_body_panics = []
        d = int(fns[f].decl)
        # (a foreign function is opaque unless it declares a closed row, which is
        # trusted: the claim its unsafe callers rely on)
        trusted = d != 0 and has_flag(d, NF_EXTERN) and effect_declared_row(f) != 0
        if effect_blocks_demanded and not trusted and concurrency_fn_blocks(f): effect_add(f, EffectEvent(EffectAtom(.block), d))
        library = effect_library_class(f)
        if library != .unclassified: effect_library_summary(f, library, d)
        else if fns[f].state != 2 or fns[f].body == 0 or fns[f].kind == FK_INIT or (d != 0 and has_flag(d, NF_EXTERN)) or effect_unavailable.has(f):
            if not trusted: effect_opaque(f, d)
            effect_isolation_block(f, .unavailable, d)
        else:
            if fns[f].caps.len() != 0 or fns[f].kind == FK_PARTIAL:
                effect_opaque(f, int(fns[f].body))
                effect_isolation_block(f, .capture, int(fns[f].body))
            if fns[f].cabi: effect_opaque(f, d)
            if not effect_value(int(fns[f].ret)) and int(fns[f].ret) != T_VOID: effect_opaque(f, d)
            loop i in [0..fns[f].params.len()):
                l = fns[f].params[i]
                t = representation_type(int(locals[l].type))
                if int(locals[l].flags) & LF_MUTPARAM == 0 and not effect_value(t) and not is_fn_type(t): effect_opaque(f, d)
            effect_scan_node(f, int(fns[f].body))
        if effect_body_cache:
            direct = effect_summaries[f]
            if not direct.capped and direct.events.len() < 32: effect_bodies[f] = EffectBody(direct.events, effect_body_panics, direct.edges, direct.isolation, direct.isolation_witness)
            effect_body_owner = old_owner
            effect_body_panics = old_panics
    # An opaque footprint already invalidates every exposed root. No edge
    # or remaining body can refine that answer; full effect users rebuild.
    if effect_footprints_only and effect_summaries[f].footprint_opaque: effect_summaries[f].edges = []
    loop edge in effect_summaries[f].edges:
        g = edge.callee
        if g <= 0 or g >= effect_limit: continue
        if effect_summaries[g].index == 0:
            effect_visit(g)
            if not effect_summaries[g].done: effect_summaries[f].low = min(effect_summaries[f].low, effect_summaries[g].low)
        else if not effect_summaries[g].done: effect_summaries[f].low = min(effect_summaries[f].low, effect_summaries[g].index)
    if effect_summaries[f].low != effect_summaries[f].index: return
    start = effect_stack.len() - 1
    loop effect_stack[start] != f: start -= 1
    # Substitute on EVERY edge, including backedges, until this component is
    # settled. Bounded region sets/projection depth ensure monotone termination.
    # (a member whose callees did not change since its last pass is skipped)
    loop true:
        changed = false
        loop i in [start..effect_stack.len()):
            if effect_propagate(effect_stack[i]): changed = true
        if not changed: break
    loop effect_stack.len() > start:
        g = effect_stack.pop()
        effect_summaries[g].done = true

effect_name = (f: int) -> str:
    d = int(fns[f].decl)
    if d != 0: return name_of(int(nodes[d].name))
    "<helper>"

effect_place_name = (p: PlaceIdentity) -> str:
    if p.parent != 0: return "{effect_place_name(place_parents[p.parent])}.{name_of(p.selector)}"
    if p.root == .global: return name_of(int(globals[p.declaration].name))
    if p.root == .resource and p.declaration > 0 and p.declaration < nodes.len() and nodes[p.declaration].name > 0: return name_of(int(nodes[p.declaration].name))
    if p.root == .formal and p.owner > 0:
        d = int(fns[p.owner].decl)
        if d != 0: return name_of(int(nodes[kid(d, p.declaration - 1)].name))
    "unknown place"

effect_witness = (f: int, event0: EffectEvent) -> str:
    chain = effect_name(f)
    event = event0
    seen = [f]
    loop depth in [0..8):
        if event.via == 0: break
        g = event.via_fn
        if g <= 0 or g >= effect_limit: break
        # (the chain stops where it enters the library, whose helpers are its own)
        gd = int(fns[g].decl)
        if gd != 0 and pos_in_lib(nodes[gd].pos):
            name = effect_name(g)
            chain += if starts_with(name, "__"): " -> the library" else: " -> {name} (the library)"
            break
        chain += " -> {effect_name(g)}"
        if seen.contains(g):
            chain += " (recursive component)"
            break
        seen.push(g)
        next = EffectEvent(EffectAtom(.opaque), 0)
        loop candidate in effect_summaries[g].events:
            if candidate.witness == event.witness:
                next = candidate
                break
        event = next
    chain

# A declared contract, or main under the internal policy.
effect_root = (f: int) -> bool:
    d = int(fns[f].decl)
    policy_root = effect_policy.prohibitions != 0 and f == main_fn
    if d == 0 or (nodes[d].sval == 0 and not policy_root): return false
    not (fns[f].kind == FK_LAMBDA and has_flag(d, NF_GENERIC) and fns[f].body == 0 and not fns[f].has_env)

# Summaries first charge every unproven element access a possible failure.
# One facts probe per owning body then discharges what its own facts prove,
# and the graph is solved again. Probe answers depend only on callees' write
# footprints, which discharging a failure cannot change.
effect_settle_bounds = ():
    effect_body_cache = true
    effect_bound_sites = []
    loop obligation in effect_obligations: effect_source_row(obligation.source)
    loop f in [1..effect_limit):
        if effect_root(f) and effect_summaries[f].index == 0: effect_visit(f)
    sites = effect_bound_sites
    effect_bound_sites = []
    if sites.len() == 0: return
    # Index the sites by owner once; each site's proof is consumed once.
    by_owner: {int: int[]} = {}
    owners: int[]
    loop site in sites:
        if not by_owner.has(site.0): owners.push(site.0)
        owned = by_owner.get(site.0) ?? []
        owned.push(site.1)
        by_owner[site.0] = owned
    proved = false
    loop f in owners:
        found = fact_probe_function(f)
        floats: {int: bool} = {}
        loop n in by_owner[f]:
            if nodes[n].kind == .conv and nodes[n].aux == i32(int(CV.float2int)):
                floats = ff_probe_function(f)
                break
        loop n in by_owner[f]:
            if (found.get(n) ?? false) or (floats.get(n) ?? false):
                effect_bounds_proven[n] = true
                proved = true
    if proved: effect_graph_reset(true)

effects_finalize = ():
    if not effects_active and effect_policy.prohibitions == 0: return
    effect_final = true
    effect_graph_reset()
    effect_settle_bounds()
    loop obligation in effect_obligations:
        actual = effect_source_row(obligation.source)
        if not effect_rows_fit(actual, obligation.bound):
            fatal(nodes[obligation.source].pos, "cannot prove callable effect contract: a reaching source exceeds the inferred row")
    loop f in [1..effect_limit):
        if not effect_root(f): continue
        d = int(fns[f].decl)
        policy_root = effect_policy.prohibitions != 0 and f == main_fn
        contract = if fns[f].kind == FK_LAMBDA and not has_flag(d, NF_GENERIC): callable_contract(int(fns[f].fntype)) else: effect_subst(int(decl_infos[decl_info(d)].sig.contract), fns[f].targs)
        if effect_summaries[f].index == 0: effect_visit(f)
        # A concrete prohibited cost is more informative than an earlier
        # conservative aggregate/signature blocker. Preserve the call-site
        # diagnostic and the allocating operation's original witness.
        ordered: EffectEvent[]
        loop event in effect_summaries[f].events:
            if event.atom.kind == .alloc: ordered.push(event)
        loop event in effect_summaries[f].events:
            if event.atom.kind != .alloc and event.atom.kind != .opaque: ordered.push(event)
        loop event in effect_summaries[f].events:
            if event.atom.kind == .opaque: ordered.push(event)
        loop event in ordered:
            atom = event.atom
            if atom.place.root == .formal:
                base = place_base(atom.place)
                atom.place = place_append(PlaceIdentity(.formal, 0, base.declaration), atom.place)
            prohibited = policy_root and (effect_policy.prohibitions & (1 << int(atom.kind)) != 0 or atom.kind == .opaque)
            if (contract == 0 or effect_allows(contract, atom)) and not prohibited: continue
            at = if event.via != 0: event.via else: event.witness
            if at == 0: at = d
            what = if atom.kind == .write: "mutation" else if atom.kind == .read: "read" else if atom.kind == .alloc: "allocation" else if atom.kind == .panic: "possible failure" else if atom.kind == .detach: "storage detach" else if atom.kind == .io: "I/O" else if atom.kind == .block: "blocking operation" else if atom.kind == .costly_copy: "costly copy" else if atom.kind == .escape: "escape" else if atom.kind == .spawn: "spawn" else: "opaque operation or unproved implementation cost"
            if event.atom.place.declaration != 0 and not starts_with(effect_place_name(event.atom.place), "__"): what += " of '{effect_place_name(event.atom.place)}'"
            chain = effect_witness(f, event)
            origin = if event.witness != 0 and not pos_in_lib(nodes[event.witness].pos): "; witness at {pos_str(nodes[event.witness].pos)}" else if event.witness != 0: "" else: "; witness at {pos_str(nodes[d].pos)}"
            row = if contract != 0: effect_contracts[contract] else: EffectContract()
            why = if contract == 0: "is forbidden by the effect policy" else if row.exclusions.len() > 0 and effect_excluded(row, atom): "exceeds the contract (its row excludes it)" else if row.atoms.len() == 0 and row.variables.len() == 0 and not row.open: "exceeds the closed row (no_effects permits none)" else: "exceeds the closed row (the contract does not permit it)"
            hint = if arena_fns.len() > 0 and event.witness > 0: arena_capacity_hint(event.witness) else: ""
            fatal(nodes[at].pos, "effect contract violation in '{effect_name(f)}': {what} {why}; {chain}{origin}{hint}{dir_row_origin(d)}")

# Facts request only summaries of calls they actually analyze. Ordinary code
# with no refinement consumers pays neither an arena allocation nor a walk.
effects_demand = (f: int, footprints: bool = false) -> bool:
    if effect_footprints_only and not footprints: effect_graph_reset()
    effect_final = true
    if effect_limit == 0:
        effect_footprints_only = footprints and not effects_active and effect_policy.prohibitions == 0
        effect_limit = fns.len()
        effect_summaries = fill(EffectSummary(), effect_limit)
        effect_seen = fill(0, nodes.len())
        effect_event_index = {}
        effect_for_marks = {}
        effect_plain_cache = {}
        effect_share_cache = {}
    if f <= 0 or f >= effect_limit: return false
    if effect_summaries[f].index == 0:
        icb = ic_phase(IC_EFFECTS)
        effect_visit(f)
        ic_restore(icb)
    effect_summaries[f].done

# Lowering consults summaries too. Cover nodes made since the arena was sized
# before a fresh visit scans them; later functions remain unknown.
effects_demand_late = (f: int) -> bool:
    if effect_limit != 0:
        loop effect_seen.len() < nodes.len(): effect_seen.push(0)
    effects_demand(f)

# ---------------- panics ----------------
# `panics` (docs/design/decisions.md, 2026-10-23): a function may fail a runtime
# check or otherwise panic. Its sources: an obligation its scope deferred to a
# runtime check (the facts pass names the owner: effect_panic_note), an
# explicit panic, assert, `$runtime_assert` or unreachable, and every callee,
# transitively (a handle or closure it makes is a callee: it may be invoked).
# The library's implicit checks are its invariants: what a caller must provide
# is a contract (a refined parameter the caller proves) or an explicit panic,
# which counts. Allocation failure is environmental, outside no traps, and so is
# the runtime (lib/core/rt.jo). Demanded only when some scope is no-traps or a
# row excludes panics: each reached body is walked once and the call graph
# solved by Tarjan's algorithm, O(nodes of the reached bodies + call edges).
# A `$runtime_assert` is its module's own explicit handling (decisions.md,
# 2026-10-23): it makes its function, and callers in the same module, panic
# only for callers in other modules (answer 3), unless its scope says
# `$assume_local_asserts=false` (docs/design/assumptions.md). A call across
# modules of a function that panics only so panics outright (answer 2).
effect_panics_demanded = false
effect_panics_settled = false         # deferred obligations are known: answers are final
effect_panic_pending: {int: bool} = {}
effect_panic_nodes: {int: int} = {}   # function -> a deferred obligation's node
effect_panic_texts: {int: str} = {}   # and what it requires
panic_index: int[]                    # Tarjan order (0: not visited)
panic_low: int[]
panic_answer: int[]                   # 0 open, 1 cannot panic, 2 may panic, 3 only for other modules
panic_witness: int[]                  # a source node, or the edge's node
panic_via: int[]                      # the callee that edge reaches (0: a source)
panic_local: int[]                    # while open: a module-local source (answer 3), or its edge
panic_local_via: int[]
panic_edge_at: int[]                  # its edges in panic_edges: [at..end)
panic_edge_end: int[]
panic_edges: int[]                    # pairs (callee, node)
panic_stack: int[]
panic_serial = 0
panic_lib = false                     # the body being walked is the library's
panic_draw = false                    # this library body needs draw-precondition discovery
panic_stop = false                    # stop this library walk after its first independent panic
panic_name_format = 0
panic_name_to = 0

effect_panics_reset = ():
    effect_panics_demanded = false
    effect_panics_settled = false
    effect_panic_nodes = {}
    effect_panic_pending = {}
    effect_panic_texts = {}
    panic_index = []
    panic_low = []
    panic_answer = []
    panic_witness = []
    panic_via = []
    panic_local = []
    panic_local_via = []
    panic_edge_at = []
    panic_edge_end = []
    panic_edges = []
    panic_stack = []
    panic_serial = 0

# A deferred obligation (`$runtime_checks`, `$prototype`, or the default while
# it is still runtime checks) at n in f's body.
effect_panic_note = (f: int, n: int, what: str, provisional: bool = false):
    if f <= 0: return
    if effect_panic_nodes.has(f) and not (effect_panic_pending.has(f) and not provisional): return
    if provisional: effect_panic_pending[f] = true
    else: effect_panic_pending.remove(f)
    effect_panic_nodes[f] = n
    effect_panic_texts[f] = what

panic_grow = ():
    m = fns.len()
    if panic_index.len() >= m: return
    if draw_context_guard != 0 and draw_required.len() < m: draw_required.resize(m)
    extra = m - panic_index.len()
    panic_index += fill(0, extra)
    panic_low += fill(0, extra)
    panic_answer += fill(0, extra)
    panic_witness += fill(0, extra)
    panic_via += fill(0, extra)
    panic_local += fill(0, extra)
    panic_local_via += fill(0, extra)
    panic_edge_at += fill(0, extra)
    panic_edge_end += fill(0, extra)

# The exhaustive-match fallback cannot run. A marked range check is decided
# by facts as an obligation; message text never exempts an exhaustion panic.
panic_synthesized = (n: int) -> bool:
    if nodes[n].aux2 == i32(RANGE_EXHAUSTION): return true
    if nkids(n) == 0 or nodes[kid(n, 0)].kind != .str_lit: return false
    name_of(int(nodes[kid(n, 0)].sval)) == "no match arm matched"

# A string argument's possible texts where the compiler knows them: a literal, a
# binding written once by its declaration (its initial value), or a value whose
# type is a set of literal strings. None: unknown.
panic_literal_texts = (e0: int) -> str[]?:
    e = e0
    loop nodes[e].kind == .conv: e = int(nodes[e].a)
    if nodes[e].kind == .ident and nodes[e].aux == i32(int(SK.local)):
        l = int(nodes[e].sym)
        if int(locals[l].flags) & (LF_ASSIGNED | LF_CAPTURE | LF_CAPTURED | LF_SHARED | LF_ADDR | LF_PARAM) != 0: return none
        loop q in effect_write_sites(l):
            if nodes[q].kind == .vardecl and nodes[q].sym == i32(l) and nodes[q].b != 0: e = int(nodes[q].b)
        loop nodes[e].kind == .conv: e = int(nodes[e].a)
    if nodes[e].kind == .str_lit and nkids(e) == 0 and nodes[e].sval > 0: return [name_of(int(nodes[e].sval))]
    id = str_set_of(ntype(e))
    if id <= 0: return none
    texts: str[]
    loop member in str_sets[id]: texts.push(member)
    texts

# `format(x spec)` with a specification the library accepts for x, a literal or
# a known one (panic_literal_texts) (lib/core/fmt.jo and lib/math_int.jo,
# __format_checked) cannot fail: a bad specification is its only failure.
# Checked here once per call, as its own grammar.
panic_format_literal = (n: int) -> bool:
    if nkids(n) != 2: return false
    d = int(fns[int(nodes[n].sym)].decl)
    if panic_name_format == 0:
        panic_name_format = intern("format")
        panic_name_to = intern("to")
    if d == 0 or int(nodes[d].name) != panic_name_format: return false
    path = files[pos_file(nodes[d].pos)].path
    if path != lib_dir + "/core/fmt.jo" and path != lib_dir + "/math_int.jo": return false
    t = representation_type(ntype(kid(n, 0)))
    if let texts = panic_literal_texts(kid(n, 1)):
        loop spec in texts:
            if not panic_format_spec(spec, t): return false
        return true
    false

panic_format_spec = (spec: str, t: int) -> bool:
    text = t == T_STR
    kinds = if text: "s" else if tkind(t) == .float_: "feEgG%" else if is_int(t) or t == T_MATH_INT: "dxXbofeEgG%" else: ""
    if kinds == "": return false
    i = 0
    m = len(spec)
    if m >= 2 and (spec[1] == '<' or spec[1] == '>' or spec[1] == '^'): i = 2
    else if m >= 1 and (spec[0] == '<' or spec[0] == '>' or spec[0] == '^'): i = 1
    flags = i
    if i < m and spec[i] == '+': i += 1
    if i < m and spec[i] == '#': i += 1
    alt = i > flags and spec[i - 1] == '#'
    plus = i > flags and spec[flags] == '+'
    first = i
    loop i < m and is_digit(spec[i]): i += 1
    zero = i > first and spec[first] == '0'
    if i - first > 18: return false
    group = 0
    if i < m and (spec[i] == ',' or spec[i] == '_'):
        group = int(spec[i])
        i += 1
    precision = false
    if i < m and spec[i] == '.':
        i += 1
        first = i
        loop i < m and is_digit(spec[i]): i += 1
        if i == first or i - first > 18: return false
        precision = true
    kind = 0
    if i < m:
        if find_byte(kinds, spec[i]) < 0: return false
        kind = int(spec[i])
        i += 1
    if i != m: return false
    integer_base = kind != 0 and find_byte("xXbo", u8(kind)) >= 0
    if alt and not integer_base or group != 0 and integer_base: return false
    if not text and precision and kind != 0 and find_byte("dxXbo", u8(kind)) >= 0: return false
    not text or not (precision or plus or alt or zero or group != 0)

# `x.to(device)` with a literal device this build places on ('best' or 'cpu':
# lib/std/nd.jo) cannot fail, a literal-typed binding included.
panic_device_literal = (n: int) -> bool:
    if nkids(n) != 2 or panic_name_to == 0: return false
    d = int(fns[int(nodes[n].sym)].decl)
    if d == 0 or int(nodes[d].name) != panic_name_to or files[pos_file(nodes[d].pos)].path != lib_dir + "/std/nd.jo": return false
    if let texts = panic_literal_texts(kid(n, 1)):
        loop text in texts:
            if text != "best" and text != "cpu": return false
        return true
    false

# A program's `d[k]` (or `d[k] += 1`, `d.pop(k)`): the key's presence is its
# obligation (facts.jo fact_map_check), proven, an error or its own check.
panic_map_obligation = (n: int) -> bool:
    m = fact_map_call(n)
    if m >= 2 and m <= 4: return true
    # (a pool's `pool[h]`, `pool[h] = x` and `__pool_index`: the handle's membership)
    m = fact_pool_call(n)
    m >= 2 and m <= 4

# A literal argument the library's one failure cannot happen with: a range
# without a step (or with a literal step that is not zero), a power with a
# literal exponent >= 0 (every library `pow` and `__pow__` fails only for a
# negative one), a rational with a literal nonzero denominator.
panic_name_power = 0
panic_name_rational = 0
panic_name_pow = 0
panic_name_pow_op = 0
panic_name_fraction = 0
panic_literal = (e0: int) -> int:
    e = e0
    loop e > 0 and nodes[e].kind == .conv: e = int(nodes[e].a)
    if e > 0 and (nodes[e].kind == .int_lit and not has_flag(e, NF_U64) or nodes[e].kind == .bool_lit): return e
    0

panic_literal_safe = (n: int) -> bool:
    if k_call_args(n) < 2: return false
    d = int(fns[int(nodes[n].sym)].decl)
    if d == 0 or not pos_in_lib(nodes[d].pos): return false
    if panic_name_power == 0:
        panic_name_power = intern("__dewy_power")
        panic_name_rational = intern("rational")
        panic_name_pow = intern("pow")
        panic_name_pow_op = intern("__pow__")
        panic_name_fraction = intern("_fraction")
    name = int(nodes[d].name)
    # (a range constructor's: unstepped, or two distinct literal first values)
    if fact_range_first(n, false) >= 0: return true
    first = fact_range_first(n, true)
    if first >= 0:
        a = panic_literal(kid(n, first))
        b = panic_literal(kid(n, first + 1))
        return a != 0 and b != 0 and nodes[a].ival != nodes[b].ival
    if (name == panic_name_power or name == panic_name_pow or name == panic_name_pow_op) and nkids(n) == 2:
        e = panic_literal(kid(n, 1))
        return e != 0 and nodes[e].ival >= 0
    if (name == panic_name_rational or name == panic_name_fraction) and nkids(n) == 2:
        e = panic_literal(kid(n, 1))
        return e != 0 and nodes[e].ival != 0
    false

# A range whose two first values are distinct literals: its step is not zero.
panic_literal_step = (it: int) -> bool:
    a = panic_literal(int(nodes[it].a))
    b = panic_literal(int(nodes[it].c))
    a != 0 and b != 0 and nodes[a].ival != nodes[b].ival

k_call_args = (n: int) -> int: if nodes[n].kind == .call and nodes[n].aux == 0 and nodes[n].sym > 0: nkids(n) else: 0

panic_edge = (f: int, g: int, n: int):
    if g <= 0 or g >= fns.len() or g == f: return
    panic_edges.push(g)
    panic_edges.push(n)

panic_site = (f: int, n: int):
    # (a library body's answer is settled by its first panic; its call sites are not checked)
    if n == 0 or panic_stop and panic_witness[f] != 0: return
    k = nodes[n].kind
    if k == .intrinsic:
        id = nodes[n].aux as IN
        # (the library's `assert` and `unreachable` state its invariants; its
        # `panic` is a failure a caller can cause. In a program, `assert` is a
        # check the compiler made, as unpacking's: an obligation for facts)
        explicit = id == .panic or id == .runtime_assert or id == .unreachable and not panic_lib
        if explicit and panic_witness[f] == 0 and not panic_synthesized(n):
            if id == .runtime_assert and dir_assume_local_asserts(nodes[n].pos):
                if panic_local[f] == 0: panic_local[f] = n
            else: panic_witness[f] = n
    else if k == .call and nodes[n].aux == 0 or k == .fnref or k == .lambda or k == .pair or k == .partial and nodes[n].aux == 0:
        # Draw context is checked at the program/library boundary, like bounds.
        if panic_draw and k == .call and nodes[n].sym == i32(draw_context_guard):
            draw_required[f] = true
            return
        # (a call whose precondition is the caller's obligation, as a string
        # index or a divisor: proven, an error, or a check of the caller's own)
        if nodes[n].sym > 0 and not (k == .call and (fact_string_call(n) >= 2 or fact_array_call(n) != 0 or fact_floor_call(n) != 0 or fact_divisors.has(n) or fact_power_call(n) or panic_format_literal(n) or panic_device_literal(n) or not panic_lib and (panic_map_obligation(n) or fact_range_call(n) or fact_nonempty_call(n)) or panic_literal_safe(n))): panic_edge(f, int(nodes[n].sym), n)
    if k == .binary or k == .intrinsic:
        loop g in value_helper_calls(n): panic_edge(f, g, n)

# The full walk is needed only when fact demand did not inventory the body.
panic_node = (f: int, n: int):
    if n == 0 or panic_stop and panic_witness[f] != 0: return
    panic_site(f, n)
    k = nodes[n].kind
    if k == .parallel_region:
        panic_node(f, int(nodes[n].a))
        return
    mask = isolation_children(k)
    if mask < 0: return
    if mask & 1 != 0: panic_node(f, int(nodes[n].a))
    if mask & 2 != 0: panic_node(f, int(nodes[n].b))
    if mask & 4 != 0: panic_node(f, int(nodes[n].c))
    if mask & 16 != 0:
        loop c in kids(n): panic_node(f, c)

panic_scan = (f: int):
    fact_complete_deferred(f)
    panic_edge_at[f] = panic_edges.len()
    panic_edge_end[f] = panic_edges.len()
    d = int(fns[f].decl)
    if let n = effect_panic_nodes.get(f): panic_witness[f] = n
    if fns[f].state != 2 or fns[f].body == 0 or d != 0 and has_flag(d, NF_EXTERN): return
    if d != 0 and modules[int(fns[f].mod)].is_prelude and files[pos_file(nodes[d].pos)].path == lib_dir + "/core/rt.jo": return
    panic_lib = fn_in_lib(f)
    panic_draw = panic_lib and draw_context_guard != 0
    panic_stop = panic_lib and not panic_draw
    if let sites = fact_panic_sites.get(f):
        loop n in sites: panic_site(f, n)
    else: panic_node(f, int(fns[f].body))
    panic_edge_end[f] = panic_edges.len()

panic_visit = (f: int):
    panic_serial += 1
    panic_index[f] = panic_serial
    panic_low[f] = panic_serial
    panic_stack.push(f)
    panic_scan(f)
    library = fn_in_lib(f)
    loop i in [0..(panic_edge_end[f] - panic_edge_at[f]) / 2):
        if library and panic_witness[f] != 0 and draw_context_guard == 0: break
        e = panic_edge_at[f] + 2 * i
        g = panic_edges[e]
        if panic_index[g] == 0:
            panic_visit(g)
            if panic_answer[g] == 0: panic_low[f] = min(panic_low[f], panic_low[g])
        else if panic_answer[g] == 0: panic_low[f] = min(panic_low[f], panic_index[g])
        if panic_witness[f] == 0 and panic_reaches(f, g):
            panic_witness[f] = panic_edges[e + 1]
            panic_via[f] = g
        else if panic_answer[g] == 3 and panic_local[f] == 0:
            panic_local[f] = panic_edges[e + 1]
            panic_local_via[f] = g
    if panic_low[f] != panic_index[f]: return
    # (a component: its members reach one another, so one may panic if any
    # does; a module-local panic spanning modules is no longer local)
    start = panic_stack.len() - 1
    loop panic_stack[start] != f: start -= 1
    if draw_context_guard != 0: draw_context_component(start)
    any = false
    local = false
    spans = false
    loop i in [start..panic_stack.len()):
        g = panic_stack[i]
        if panic_witness[g] != 0: any = true
        if panic_local[g] != 0: local = true
        if fns[g].mod != fns[f].mod: spans = true
    if local and spans: any = true
    answer = if any: 2 else if local: 3 else: 1
    loop i in [start..panic_stack.len()):
        g = panic_stack[i]
        if answer == 3 or panic_witness[g] == 0 and panic_local[g] != 0:
            panic_witness[g] = panic_local[g]
            panic_via[g] = panic_local_via[g]
        if answer != 1 and panic_witness[g] == 0:
            loop j in [0..(panic_edge_end[g] - panic_edge_at[g]) / 2):
                e = panic_edge_at[g] + 2 * j
                h = panic_edges[e]
                if panic_answer[h] == 0 and panic_index[h] >= panic_index[f] and panic_witness[g] == 0:
                    panic_witness[g] = panic_edges[e + 1]
                    panic_via[g] = h
        panic_answer[g] = answer
    loop panic_stack.len() > start: panic_stack.pop()

# Whether f's call of g (answered) may panic in f: g may panic for every
# caller, or only for callers outside its module and f is one.
panic_reaches = (f: int, g: int) -> bool:
    a = panic_answer[g]
    a == 2 or a == 3 and fns[g].mod != fns[f].mod

# Whether f may panic for some caller (its witness: panic_witness/panic_via).
# Answers settle once facts have run; a body checked later is walked on its
# first question.
effect_panics = (f: int) -> bool:
    if f <= 0 or f >= fns.len(): return false
    panic_grow()
    if panic_index[f] == 0: panic_visit(f)
    panic_answer[f] >= 2

# A function's name as a program writes it (`xs.insert` reaches `__dewy_insert`).
effect_shown_name = (f: int) -> str:
    name = effect_name(f)
    if starts_with(name, "__dewy_"): return name[7..]
    name

# Why f may panic, following its witnesses: `first -> the library: first of an
# empty array (lib/core/array.jo:5:20)`.
effect_panic_reason = (f: int) -> str:
    chain = effect_shown_name(f)
    g = f
    seen = [f]
    loop depth in [0..8):
        h = panic_via[g]
        if h == 0: break
        if seen.contains(h):
            chain += " (recursive)"
            break
        seen.push(h)
        hd = int(fns[h].decl)
        # (the library's own helpers are its business)
        if hd == 0 or not pos_in_lib(nodes[hd].pos) or not starts_with(effect_name(h), "__"): chain += " -> {effect_name(h)}"
        g = h
    n = panic_witness[g]
    if n == 0: return chain
    what = ""
    if let text = effect_panic_texts.get(g):
        if panic_witness[g] == effect_panic_nodes[g]: what = "runtime check: {dir_text(text)}"
    if what == "" and nodes[n].kind == .intrinsic:
        id = nodes[n].aux as IN
        what = if id == .runtime_assert: "`$runtime_assert`" else if id == .unreachable: "unreachable" else if id == .assert: "assert" else: "panic"
        if nkids(n) > 0 and nodes[kid(n, 0)].kind == .str_lit and nodes[kid(n, 0)].sval > 0 and nkids(kid(n, 0)) == 0: what += " \"{name_of(int(nodes[kid(n, 0)].sval))}\""
    if what == "": return chain
    at = pos_str(nodes[n].pos)
    if starts_with(at, lib_root): at = "lib" + at[len(lib_root)..]
    "{chain}: {what} at {at}"

dir_text = (what: str) -> str:
    if starts_with(what, "cannot prove "): return what[13..]
    what

# Scoped bytes share place normalization and transitive call footprints with
# effects. This walk is demanded only for functions containing byte operations.
struct ByteLoan:
    node: int
    place: PlaceIdentity
    writable: bool
    first_local: int
    origin: int
loan_stack: ByteLoan[]
loan_origins: {int: int} = {}
loan_ids: int[]
loan_generation = 0
loan_steps = 0

loan_error = (n: int, reason: str):
    fatal(nodes[n].pos, "scoped loan: {reason}")

loan_owner = (n: int) -> int:
    p = place_route(n)
    loop i in [0..loan_stack.len()):
        if place_covers(loan_stack[i].place, p) or place_covers(p, loan_stack[i].place): return i
    -1

loan_mark = (local: int, origins: int):
    old = loan_origins.get(local) ?? 0
    if old | origins != old:
        loan_origins[local] = old | origins
        loan_generation += 1

loan_publish = (n: int, p: PlaceIdentity, origins: int):
    loop loan in loan_stack:
        if origins & loan.origin == 0: continue
        if p.root != .local or p.parent != 0 or p.declaration < loan.first_local:
            loan_error(n, "address cannot escape the scoped expression through a store")

loan_call = (n: int):
    if nodes[n].aux == 2: return
    if nodes[n].aux != 0 or not effects_demand(int(nodes[n].sym)):
        loan_error(n, "call has no checked nonescaping storage contract")
    loop event in effect_summaries[int(nodes[n].sym)].events:
        a = event.atom
        if a.kind == .opaque or a.kind == .escape or a.kind == .remainder:
            loan_error(n, "call may escape or invalidate loan storage")
        p = a.place
        base = place_base(p)
        if base.root == .capture or base.root == .global: loan_error(n, "call may access nonlocal loan storage")
        if base.root == .formal:
            i = base.declaration - 1
            if i >= 0 and i < nkids(n): p = place_append(place_route(kid(n, i)), p)
        loop loan in loan_stack:
            if p.declaration != 0 and (place_covers(p, loan.place) or place_covers(loan.place, p)):
                loan_error(n, "call may access the active loan owner")

loan_visit = (n: int) -> int:
    if n == 0: return 0
    loan_steps += 1
    if loan_steps > 65536: loan_error(n, "address analysis budget exhausted")
    k = nodes[n].kind
    active = loan_stack.len() != 0
    if k == .intrinsic:
        id = nodes[n].aux as IN
        if id == .lend:
            owner = kid(n, 0)
            if loan_owner(owner) >= 0: loan_error(n, "nested conflicting loan")
            if loan_visit(kid(n, 1)) != 0: loan_error(n, "address-derived reservation")
            p = place_route(owner)
            if p.declaration == 0 or p.parent != 0: loan_error(n, "owner must have stable named storage")
            if p.root == .local and int(locals[p.declaration].flags) & (LF_ALIAS | LF_EXPOSED | LF_SHARED | LF_CAPTURE | LF_MUTPARAM) != 0: loan_error(n, "owner has a conflicting alias or exposed storage view")
            if not loan_ids.contains(n): loan_ids.push(n)
            origin = -1
            loop i in [0..min(8, loan_ids.len())):
                if loan_ids[i] == n: origin = 1 << i
            loan_stack.push(ByteLoan(n, p, has_flag(n, NF_MUT), int(nodes[n].ival), origin))
            tainted = loan_visit(kid(n, 2))
            loan_stack.pop()
            if tainted & origin != 0: loan_error(n, "address cannot escape the scoped expression as its result")
            return tainted
        if id == .loan_address or id == .loan_length:
            i = loan_owner(kid(n, 0))
            if i < 0: loan_error(n, "byte operation requires an active owner loan")
            if id == .loan_address: return loan_stack[i].origin
            if not loan_stack[i].writable: loan_error(n, "set_length requires a writable loan")
            if loan_visit(kid(n, 1)) != 0: loan_error(n, "address-derived length cannot be published")
            return 0
        if id == .loan_load or id == .loan_store:
            if not active: loan_error(n, "raw byte operation requires a scoped loan")
            if id == .loan_load:
                if loan_visit(kid(n, 0)) == 0: loan_error(n, "raw load requires a loan-derived address")
            else:
                if loan_visit(kid(n, 0)) != 0: loan_error(n, "address cannot escape through a raw store")
                origins = loan_visit(kid(n, 1))
                if origins == 0: loan_error(n, "raw store requires a loan-derived address")
                loop loan in loan_stack:
                    if origins & loan.origin != 0 and not loan.writable: loan_error(n, "raw write through a readonly loan")
            return 0
        if active and id == .len and loan_owner(kid(n, 0)) >= 0: return 0
    if k == .ident:
        if active and loan_owner(n) >= 0: loan_error(n, "owner cannot be copied, resized, replaced or aliased during a loan")
        p = place_route(n)
        return if p.root == .local: loan_origins.get(p.declaration) ?? 0 else: 0
    if active and (k == .lambda or k == .fnref or k == .partial): loan_error(n, "closure capture during a loan is not supported")
    if k == .block:
        result = 0
        loop child in kids(n): result = loan_visit(child)
        return result
    if k == .vardecl:
        tainted = loan_visit(int(nodes[n].b))
        if tainted != 0:
            p = PlaceIdentity((if has_flag(n, NF_GLOBAL): PlaceRoot.global else: PlaceRoot.local), 0, int(nodes[n].sym))
            loan_publish(n, p, tainted)
            loan_mark(p.declaration, tainted)
        return 0
    if k == .assign:
        if active and place_base(place_route(int(nodes[n].a))).root != .local:
            loan_error(n, "nonlocal replacement may invalidate loan storage")
        tainted = loan_visit(int(nodes[n].b))
        old = loan_visit(int(nodes[n].a))
        if tainted | old != 0:
            p = place_route(int(nodes[n].a))
            loan_publish(n, p, tainted | old)
            loan_mark(p.declaration, tainted | old)
        return 0
    if k == .return_:
        if loan_visit(int(nodes[n].a)) != 0: loan_error(n, "address cannot escape through return")
        return 0
    if active and (k == .if_ or k == .while_ or k == .for_ or k == .match_ or k == .iflet or k == .and_ or k == .or_ or k == .coalesce):
        if loan_visit(int(nodes[n].a)) != 0: loan_error(n, "address-derived control flow cannot publish loan bits")
    mask = isolation_children(k)
    tainted = 0
    if mask >= 0:
        if mask & 1 != 0: tainted = loan_visit(int(nodes[n].a)) | tainted
        if mask & 2 != 0: tainted = loan_visit(int(nodes[n].b)) | tainted
        if mask & 4 != 0: tainted = loan_visit(int(nodes[n].c)) | tainted
        if mask & 16 != 0:
            loop child in kids(n): tainted = loan_visit(child) | tainted
    else if active: loan_error(n, "unsupported address transform")
    if active and k == .call:
        if tainted != 0: loan_error(n, "address cannot escape through a call or record field")
        loan_call(n)
    if active and k == .intrinsic:
        if tainted != 0: loan_error(n, "intrinsic has no reviewed address-retention contract")
        id = nodes[n].aux as IN
        if id != .len and id != .runtime_assert and id != .static_assert and id != .assert:
            loan_error(n, "intrinsic may invalidate loan storage")
    if tainted != 0 and (k == .tuple or k == .array): loan_error(n, "address cannot escape through aggregate storage")
    tainted

loans_finalize = ():
    loop f, _ in loan_owners:
        loan_origins = {}
        loan_ids = []
        loan_generation = 0
        loan_stack = []
        loan_steps = 0
        # Monotone place origins reach a fixed point across loop backedges.
        loop true:
            before = loan_generation
            loan_visit(int(fns[f].body))
            if loan_generation == before: break
    loan_origins = {}

# Owning boundaries must publish every optional hook edge before verification.
# Last-use elision never grants permission to omit a hook's possible effects.
effect_owner_init = (f: int, source: int, origin: int):
    t = prune(ntype(source))
    if not ownership_type(t): return
    k = nodes[source].kind
    move = nodes[origin].kind != .conv or nodes[origin].aux != i32(int(CV.explicit_copy))
    if k != .ident and k != .field and move: return
    p = if k == .ident or k == .field: effect_export(f, place_route(source)) else: PlaceIdentity(.local, f, source)
    effect_owner_components(f, t, origin, p, move)

effect_owner_components = (f: int, t: int, origin: int, p: PlaceIdentity, move: bool, depth: int = 0):
    if depth > 32:
        effect_opaque(f, origin)
        return
    if tkind(t) == .array or tkind(t) == .fixed:
        effect_owner_components(f, telem(t), origin, p, move and tkind(t) == .fixed, depth + 1)
        return
    if let copier = owner_map_copies.get(t):
        effect_summaries[f].edges.push(EffectEdge(copier, origin, [p]))
        return
    if let hook = ownership_copies.get(t): effect_summaries[f].edges.push(EffectEdge(hook, origin, [p]))
    if move:
        if let hook = ownership_moves.get(t): effect_summaries[f].edges.push(EffectEdge(hook, origin, [p]))
    si = int(types[prune(t)].st)
    loop i in [0..int(structs[si].nfields)):
        ft = int(fields[int(structs[si].fields) + i].type)
        if ownership_type(ft): effect_owner_components(f, ft, origin, p, move, depth + 1)

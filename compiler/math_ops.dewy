# Direct recursive lowering; shared state has one owner in math_lower.jo.
MathWord:type=int64<overflow='wrap'>
math_word=(word:MathWord):>Val=>$unsafe {
    if is_kv(word) {
        let value=kv_of(word)
        if value >=? -4611686018427387904 and value <=? 4611686018427387903 {
            return V(e_iconst(value << 1) false)
        }
        return math_call("__mi_word" [word])
    }
    let out=vreg(VI)
    let tagged=e_bin('shl' VI word e_iconst(1))
    iff(e_bin('eq' VI e_bin('shrs' VI tagged e_iconst(1)) word));
    e_mov(out tagged);
    els();
    let old=ir_cold
    ir_cold=true
    e_mov(out e_call(rt("__mi_word") [word] VI));
    ir_cold=old
    endc();
    return V(out true)
}
math_pack_word=(e:MathWord word:MathWord):>Val=>$unsafe {
    if exact_small_math(e) >=? 0 {return V(e_bin('shl' VI word e_iconst(1)) false)}
    let t=representation_type(ntype(e))
    if t not=? T_MATH_INT and is_int(t) and types.ptr[t].bits <? 63 {
        let bound=fact_domain(t)
        if bound.lo >=? -4611686018427387904 and bound.hi <=? 4611686018427387903 {
            return V(e_bin('shl' VI word e_iconst(1)) false)
        }
    }
    let limit=positive_bound(e true)
    if limit >=? 0 and limit <=? 4611686018427387903 {return V(e_bin('shl' VI word e_iconst(1)) false)}
    return math_word(word)
}
math_call=(name:string args:array<int64> result:MathWord=0):>Val=>$unsafe {
    let t=if result =? 0 {T_MATH_INT} else {result}
    if vc(t) not=? VC_AGG {return V(e_call(rt(name) args vt_of(t)) true)}
    let s=new_temp(t)
    let a=e_slot(s)
    e_zero(a tsize(t));
    e_call(rt(name) [a args...] -1);
    return Val[a true s]
}
math_payload_type=():>int64=>$unsafe {
    let f=runtime_fn("__mi_payload")
    return mk_array(telem(prune(MathWord(fns.ptr[f].ret))))
}
math_tag=(a:MathWord):>int64=>$unsafe {
    return e_bin('and_' VI a e_iconst(1))
}
math_untag=(a:MathWord):>int64=>$unsafe {
    return e_bin('shrs' VI a e_iconst(1))
}
math_signed=(a:MathWord):>int64=>$unsafe {
    let result=vreg(VI)
    e_mov(result math_untag(a));
    iff(math_tag(a));
    let old=ir_cold
    ir_cold=true
    e_mov(result e_call(rt("__mi_signed") [a] VI));
    ir_cold=old
    endc();
    return result
}
math_count=(e:MathWord):>int64=>$unsafe {
    if prune(ntype(e)) =? T_MATH_INT and math_proven_word(e) {return math_word_expr(e)}
    let value=gen_expr(e)
    borrow(value ntype(e));
    if prune(ntype(e)) =? T_MATH_INT {return math_signed(value.v)}
    return value.v
}
math_compare=(op:Tok a:MathWord b:MathWord):>int64=>$unsafe {
    let result=vreg(VI)
    let tag=math_tag(e_bin('or_' VI a b))
    iff(e_bin('eq' VI tag e_iconst(0)));
    e_mov(result e_bin(int_op(op true) VI a b));
    els();
    let old=ir_cold
    ir_cold=true
    let comparison=e_call(rt("__mi_compare") [a b] VI)
    e_mov(result e_bin(int_op(op true) VI comparison e_iconst(0)));
    ir_cold=old
    endc();
    return result
}
math_binary=(op:Tok a:MathWord b:MathWord):>Val=>$unsafe {
    let out=vreg(VI)
    e_mov(out e_iconst(0));
    let tag=math_tag(e_bin('or_' VI a b))
    let operation=if op =? 'plus' {0} else if op =? 'minus' {1} else if op =? 'star' {2} else if op =? 'slash' {3} else if op =? 'percent' {4} else if op =? 'amp' {5} else if op =? 'pipe' {6} else {7}
    blk();
    let done=ctl
    iff(e_bin('eq' VI tag e_iconst(0)));
    let x=a
    let y=b
    if op =? 'star' {x=math_untag(a)}
    if op =? 'slash' or op =? 'percent' {
        x=math_untag(a)
        y=math_untag(b)
    }
    let result:MathWord=0
    let bad=e_iconst(0)
    if op =? 'plus' or op =? 'minus' {
        result=e_bin(int_op(op true) VI x y)
        if not target_wasm {
            bad=e_bin((if op =? 'plus' {Op.overflow_add} else {Op.overflow_sub}) VI x y)
        }
        else {
            let left=e_bin('xor' VI x result)
            let right=e_bin('xor' VI (if op =? 'plus' {y} else {x}) (if op =? 'plus' {result} else {y}))
            bad=e_bin('lts' VI e_bin('and_' VI left right) e_iconst(0))
        }
    }
    else if op =? 'star' {
        result=e_bin('mul' VI x y)
        if not target_wasm {
            bad=e_bin('overflow_mul' VI x y)
        }
        else {
            bad=vreg(VI)
            e_mov(bad e_iconst(0));
            iff(e_bin('eq' VI x e_iconst(-1)));
            e_mov(bad e_bin('eq' VI y e_iconst(-9223372036854775807 - 1)));
            els();
            iff(e_bin('ne' VI x e_iconst(0)));
            e_mov(bad e_bin('ne' VI e_bin('divs' VI result x) y));
            endc();
            endc();
        }
    }
    else if op =? 'slash' or op =? 'percent' {
        bad=e_bin('or_' VI e_bin('eq' VI y e_iconst(0)) e_bin('and_' VI e_bin('eq' VI x e_iconst(-4611686018427387904)) e_bin('eq' VI y e_iconst(-1))))
        # The hardware division must remain inside the proven-safe arm.
    }
    else {result=e_bin(int_op(op true) VI x y)}
    iff(e_bin('eq' VI bad e_iconst(0)));
    if op =? 'slash' or op =? 'percent' {result=e_bin(int_op(op true) VI x y)}
    if op =? 'slash' or op =? 'percent' {result=e_bin('shl' VI result e_iconst(1))}
    e_mov(out result);
    br_to(done);
    endc();
    endc();
    # Both source values are still live here, including their original words.
    let old=ir_cold
    ir_cold=true
    e_mov(out e_call(rt("__mi_slow") [a b e_iconst(operation)] VI));
    ir_cold=old
    endc();
    return V(out true)
}
math_shift=(op:Tok a:MathWord count:MathWord signed_count:bool):>Val=>$unsafe {
    if signed_count {math_int_guard(e_bin('lts' VI count e_iconst(0)));}
    let out=vreg(VI)
    e_mov(out e_iconst(0));
    blk();
    let done=ctl
    iff(e_bin('eq' VI math_tag(a) e_iconst(0)));
    let x=a
    iff(e_bin('geu' VI count e_iconst(64)));
    if op =? 'shr' {
        e_mov(out e_bin('and_' VI e_bin('shrs' VI x e_iconst(63)) e_iconst(-2)));
        br_to(done);
    }
    else {
        brif_to(e_bin('eq' VI x e_iconst(0)) done);
    }
    els();
    let result=e_bin(int_op(op true) VI x count)
    if op =? 'shl' {iff(e_bin('eq' VI e_bin('shrs' VI result count) x));}
    if op =? 'shr' {result=e_bin('and_' VI result e_iconst(-2))}
    e_mov(out result);
    br_to(done);
    if op =? 'shl' {endc();}
    endc();
    endc();
    let old=ir_cold
    ir_cold=true
    e_mov(out e_call(rt("__mi_shift") [a count e_iconst(int64(op =? 'shr'))] VI));
    ir_cold=old
    endc();
    return V(out true)
}
math_main=(f:MathWord):>int64=>$unsafe {
    helper_params(0);
    ir.ret = VI;
    let a=e_call(lf_of_inst(f) [] VI)
    let result=math_signed(a)
    release(a T_MATH_INT);
    return e_ret(result)
}
math_word_bound=(e:MathWord):>bool=>$unsafe {
    if e =? 0 {return false}
    if e <? exact_ranges.length and exact_ranges.ptr[e] >? 0 and exact_ranges.ptr[e] <=? 64 {return true}
    # An expanded fixed-width expression keeps its storage type in the AST.
    # That type cannot justify discarding its high words at an int boundary.
    if exact_has_node(e) {
        if exact_bits(e) <=? 64 {return true}
        return not exact_count_bound(e).wide
    }
    let t=prune(ntype(e))
    if t not=? T_MATH_INT {return is_int(t) and (types.ptr[t].sign or MathWord(types.ptr[t].bits) <? 64)}
    if nodes.ptr[e].kind =? 'int_lit' {return not has_flag(e NF_U64) or nodes.ptr[e].ival >=? 0}
    if not exact_count_bound(e).wide {return true}
    if nodes.ptr[e].kind =? 'conv' and nodes.ptr[e].aux =? int32<overflow='wrap'>(1) {return math_word_bound(MathWord(nodes.ptr[e].a))}
    return false
}
math_word_range=(s:MathWord):>bool=>$unsafe {
    let it:MathWord=MathWord(nodes.ptr[s].a)
    if not math_proven_word(MathWord(nodes.ptr[it].a)) or not math_proven_word(MathWord(nodes.ptr[it].b)) {return false}
    if has_flag(it NF_STEP) {return math_proven_word(MathWord(nodes.ptr[it].c))}
    return true
}
math_loop_slot=():>int64=>$unsafe {
    let slot=new_temp(T_MATH_INT)
    let l=locals.length
    locals.push(Local[type = int32<overflow='wrap'>(T_MATH_INT) owner = int32<overflow='wrap'>(cur_fn) offset = int32<overflow='wrap'>(slot)]);
    scope_add_local(l);
    let address=e_slot(slot)
    e_zero(address 8);
    return address
}
gen_math_for=(s:MathWord):>void=>$unsafe {
    let it:MathWord=MathWord(nodes.ptr[s].a)
    let l:MathWord=MathWord(nodes.ptr[s].sym)
    # Scope ownership also releases promoted bounds on return and outer break.
    let ctr=math_loop_slot()
    let endv=math_loop_slot()
    let step=math_loop_slot()
    stmt_begin();
    e_store(ctr 0 gen_owned(MathWord(nodes.ptr[it].a)).v 8);
    let open_end=nodes.ptr[it].b =? 0
    if not open_end {e_store(endv 0 gen_owned(MathWord(nodes.ptr[it].b)).v 8);}
    if has_flag(it NF_STEP) {
        let second=gen_borrowed(MathWord(nodes.ptr[it].c)).v
        e_store(step 0 math_binary('minus' second e_load(VI ctr 0 8)).v 8);
    }
    else {e_store(step 0 math_word(e_iconst(1)).v 8);}
    let zero=math_word(e_iconst(0)).v
    iff(math_compare('eq' e_load(VI step 0 8) zero));
    e_call_nr(rt("__panic") [e_daddr(str_data("range step must be nonzero"))] -1);
    endc();
    let up=math_compare('gt' e_load(VI step 0 8) zero)
    stmt_end();
    scope_add_local(l);
    blk();
    let brk=ctl
    lop();
    let top=ctl
    if not open_end {
        let inclusive=has_flag(it NF_INCLUSIVE)
        iff(up);
        brif_to(math_compare((if inclusive {Tok.gt} else {Tok.ge}) e_load(VI ctr 0 8) e_load(VI endv 0 8)) brk);
        els();
        brif_to(math_compare((if inclusive {Tok.lt} else {Tok.le}) e_load(VI ctr 0 8) e_load(VI endv 0 8)) brk);
        endc();
    }
    let target=local_place(l true)
    release(read_place(target T_MATH_INT) T_MATH_INT);
    let value=e_load(VI ctr 0 8)
    retain(value T_MATH_INT);
    write_place(target T_MATH_INT value);
    blk();
    let cont=ctl
    loops.push(LoopInfo[brk cont scope_locals.length tl_items.length building.length]);
    gen_loop_body(MathWord(nodes.ptr[s].b));
    loops.pop();
    endc();
    let next=math_binary('plus' e_load(VI ctr 0 8) e_load(VI step 0 8))
    drop_at(ctr T_MATH_INT);
    e_store(ctr 0 next.v 8);
    br_to(top);
    endc();
    endc();
}
math_prepare_capture=(l:MathWord):>void=>$unsafe {
    if prune(MathWord(locals.ptr[l].type)) not=? T_MATH_INT or dbg_on or watch_build {return}
    let fl:MathWord=MathWord(locals.ptr[l].flags)
    if fl & (LF_CAPTURE | LF_VALUECAP) not=? LF_CAPTURE | LF_VALUECAP or fl & (LF_ASSIGNED | LF_ADDR | LF_EXPOSED | LF_SHARED | LF_ALIAS | LF_BYREF | LF_OWNERBORROW | LF_PARTBORROW) not=? 0 {return}
    let n=mk_ident_local(l locals.ptr[l].pos)
    if not exact_count_bound(n).wide {math_word_captures[l] = true;}
}
math_static_bits=(n:MathWord depth:MathWord=0):>int64=>$unsafe {
    if n =? 0 or depth >? 32 {return 0}
    if math_proven_word(n) {return 64}
    if math_local_is(n MathWord(nodes.ptr[n].sym)) {
        let cached_width=math_static_widths.get(MathWord(nodes.ptr[n].sym))
    if cached_width not=? none {let width=cached_width;return width}
    }
    if exact_has_node(n) {return exact_bits(n)}
    if is_int(ntype(n)) and prune(ntype(n)) not=? T_MATH_INT {return exact_bits(n)}
    let k=nodes.ptr[n].kind
    if k =? 'int_lit' {return if has_flag(n NF_U64) and nodes.ptr[n].ival <? 0 {65} else {64}}
    if k =? 'conv' and (nodes.ptr[n].aux =? int32<overflow='wrap'>(1) or nodes.ptr[n].aux =? int32<overflow='wrap'>(0)) {return math_static_bits(MathWord(nodes.ptr[n].a) depth + 1)}
    if k =? 'binary' and nodes.ptr[n].aux =? 0 {
        let a=math_static_bits(MathWord(nodes.ptr[n].a) depth + 1)
        let b=math_static_bits(MathWord(nodes.ptr[n].b) depth + 1)
        if a =? 0 or b =? 0 {return 0}
        let op=cx_token_values.ptr[MathWord(nodes.ptr[n].op)]
        if op =? 'plus' or op =? 'minus' {return max(a b) + 1}
        if op =? 'star' {return a + b}
        if op =? 'amp' or op =? 'pipe' or op =? 'caret' {return max(a b)}
    }
    if k =? 'call' and nodes.ptr[n].aux =? 0 {
        let helper=fact_floor_call(n)
        if helper =? 3 or helper =? 4 {
            let a=math_static_bits(kid(n 0) depth + 1)
            let [known amount]=integer_constant(kid(n 1))
            if a >? 0 and known and amount >=? 0 {
                if helper =? 3 {return max(1 a - amount)}
                return min(a exact_type_width(kid(n 1)) // 2)
            }
        }
    }
    if k =? 'unary' {
        let a=math_static_bits(MathWord(nodes.ptr[n].a) depth + 1)
        return if a >? 0 {a + int64(nodes.ptr[n].op =? int32<overflow='wrap'>(59))} else {0}
    }
    if k =? 'block' and nodes.ptr[n].aux not=? 0 {return math_static_bits(block_value(n) depth + 1)}
    if k =? 'if_' {
        let a=math_static_bits(MathWord(nodes.ptr[n].b) depth + 1)
        let b=math_static_bits(MathWord(nodes.ptr[n].c) depth + 1)
        return if a >? 0 and b >? 0 {max(a b)} else {0}
    }
    return 0
}
math_static_value=(n:MathWord):>array<int64>=>$unsafe {
    if math_local_is(n MathWord(nodes.ptr[n].sym)) {
        let cached_words=math_static_regs.get(MathWord(nodes.ptr[n].sym))
    if cached_words not=? none {let words=cached_words;
            let out:array<int64>=[]
            loop word in words {out.push(freeze_scalar(word T_INT));}
            return out
        }
    }
    if math_proven_word(n) {return [freeze_scalar(math_word_expr(n) T_INT)]}
    if exact_has_node(n) or prune(ntype(n)) not=? T_MATH_INT {return exact_value(n)}
    let k=nodes.ptr[n].kind
    if k =? 'int_lit' {return [e_iconst(nodes.ptr[n].ival) e_iconst(0)]}
    if k =? 'conv' {return math_static_value(MathWord(nodes.ptr[n].a))}
    let count=(math_static_bits(n) + 63) // 64
    if k =? 'unary' {
        let words=math_static_value(MathWord(nodes.ptr[n].a))
        if nodes.ptr[n].op =? int32<overflow='wrap'>(59) {return exact_neg(words count)}
        if nodes.ptr[n].op =? int32<overflow='wrap'>(66) {
            loop i in [0..words.length) {words.ptr[i] = e_un('not_' VI words.ptr[i]);}
        }
        return words
    }
    if k =? 'binary' {
        let a=math_static_value(MathWord(nodes.ptr[n].a)); let b=math_static_value(MathWord(nodes.ptr[n].b))
        let op=cx_token_values.ptr[MathWord(nodes.ptr[n].op)]
        if op =? 'plus' or op =? 'minus' {return exact_add(a b count op =? 'minus')}
        if op =? 'star' {return exact_mul(a b count)}
        a=exact_extend(a count); b=exact_extend(b count)
        let out:array<int64>=[]
        loop i in [0..count) {out.push(e_bin(int_op(op true) VI a.ptr[i] b.ptr[i]));}
        return out
    }
    if k =? 'call' {
        let a=math_static_value(kid(n 0))
        let [known amount]=integer_constant(kid(n 1))
        if fact_floor_call(n) =? 4 {return [e_bin('and_' VI a.ptr[0] e_iconst(amount))]}
        return exact_extend(exact_shift_literal(a amount a.length true) count)
    }
    if k =? 'block' {
        scope_push();
        let out:array<int64>=[]
        loop i in [0..nkids(n)) {
            let statement=kid(n i)
            if i =? nkids(n) - 1 {
                stmt_begin();
                loop word in math_static_value(MathWord(nodes.ptr[statement].a)) {out.push(freeze_scalar(word T_INT));}
                stmt_end();
            }
            else {gen_stmt(statement);}
        }
        scope_pop();
        return out
    }
    let out:array<int64>=[]
    loop i in [0..count) {out.push(vreg(VI));}
    iff(gen_expr(MathWord(nodes.ptr[n].a)).v);
    let yes=exact_extend(math_static_value(MathWord(nodes.ptr[n].b)) count)
    loop i in [0..count) {e_mov(out.ptr[i] yes[i]);}
    els();
    let no=exact_extend(math_static_value(MathWord(nodes.ptr[n].c)) count)
    loop i in [0..count) {e_mov(out.ptr[i] no[i]);}
    endc();
    return out
}
math_reset_unused=(n:MathWord l:MathWord @budget:MathWord):>bool=>$unsafe {
    if n =? 0 {return true}
    budget -= 1;
    if budget <? 0 {return false}
    let k=nodes.ptr[n].kind
    if math_local_is(n l) {return false}
    if k =? 'lambda' or k =? 'fn_' or k =? 'defer_' or k =? 'return_' or k =? 'break_' or k =? 'continue_' or k =? 'for_' or k =? 'while_' {return false}
    let mask=isolation_children(k)
    if mask <? 0 {return false}
    if mask & 1 not=? 0 and not math_reset_unused(MathWord(nodes.ptr[n].a) l @budget) {return false}
    if mask & 2 not=? 0 and not math_reset_unused(MathWord(nodes.ptr[n].b) l @budget) {return false}
    if mask & 4 not=? 0 and not math_reset_unused(MathWord(nodes.ptr[n].c) l @budget) {return false}
    if mask & 16 not=? 0 {
        loop child in kids(n) {
            if not math_reset_unused(child l @budget) {return false}
        }
    }
    if mask & 32 not=? 0 {
        loop child in kids2(n) {
            if not math_reset_unused(child l @budget) {return false}
        }
    }
    return true
}
math_reset_interval=(n:MathWord l:MathWord):>[bool int64]=>$unsafe {
    if nodes.ptr[n].kind not=? 'or_' {return [false 0]}
    let left:MathWord=MathWord(nodes.ptr[n].a); let right:MathWord=MathWord(nodes.ptr[n].b)
    if nodes.ptr[left].kind not=? 'binary' or nodes.ptr[right].kind not=? 'binary' or nodes.ptr[left].aux not=? 0 or nodes.ptr[right].aux not=? 0 {return [false 0]}
    if nodes.ptr[left].op not=? int32<overflow='wrap'>(71) or nodes.ptr[right].op not=? int32<overflow='wrap'>(74) {return [false 0]}
    if not math_local_is(word_integer_value(MathWord(nodes.ptr[left].a)) l) or not math_local_is(word_integer_value(MathWord(nodes.ptr[right].a)) l) {return [false 0]}
    let [known_lo lo]=integer_constant(MathWord(nodes.ptr[left].b))
    let [known_hi hi]=integer_constant(MathWord(nodes.ptr[right].b))
    if not known_lo or not known_hi or lo >=? hi or has_flag(MathWord(nodes.ptr[left].b) NF_U64) or has_flag(MathWord(nodes.ptr[right].b) NF_U64) {return [false 0]}
    if exact_count_bound(MathWord(nodes.ptr[left].b)).wide or exact_count_bound(MathWord(nodes.ptr[right].b)).wide {return [false 0]}

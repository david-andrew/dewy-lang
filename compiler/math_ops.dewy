math_default_formatter=(f0:MathWord):>bool=>$unsafe {
    let f=f0
    loop _ in [0..4) {
        if f <=? 0 or fns.ptr[f].decl =? 0 {return false}
        let d:MathWord=MathWord(fns.ptr[f].decl)
        let path=files.ptr[pos_file(nodes.ptr[d].pos)].path
        let name=name_of(MathWord(nodes.ptr[d].name))
        if path =? "{lib_dir}/math_int.jo" and name =? "__fmt" {return true}
        if path not=? "{lib_dir}/core/fmt.jo" or name not=? "__dewy_fmt" {return false}
        let body:MathWord=MathWord(fns.ptr[f].body)
        if nodes.ptr[body].kind not=? 'block' or nkids(body) not=? 1 {return false}
        let statement=kid(body 0)
        if nodes.ptr[statement].kind not=? 'exprstmt' {return false}
        let call:MathWord=MathWord(nodes.ptr[statement].a)
        if nodes.ptr[call].kind not=? 'call' or nodes.ptr[call].aux not=? 0 {return false}
        f=MathWord(nodes.ptr[call].sym)

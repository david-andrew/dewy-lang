use 'nd_contract_query.dewy'
use 'lower_storage.dewy'
use 'host_binds.jo'
use 'checker_expr.dewy'
# N-D contracts use the existing refinement engine and immutable projections.
# Internal paths: -2 is rank, -3-axis is an extent; ordinary array length is -1.
# Signature work is O(parameters + dimensions), only for written shapes. Call
# transfer is O(rank), capped at four for scalar indexing, with indexed facts.
# Floating matrix algorithms use at most two axes and immutable successful
# result projections; classification is cached, and only demanded calls run it.
use 'checker_tokens.dewy'
use 'checker_types.dewy'
use 'refinement_types.dewy'
use 'refine_resolve.dewy'
use 'refine_predicates.dewy'
use 'ast.jo'
use 'check.jo'
use 'types.jo'
use 'type_ops.dewy'
use 'word_overflow.dewy'
use 'expr.jo'
use 'checks_thin_expr.dewy'
use 'checks_builders.dewy'
use 'lex.jo'
use 'util.jo'
use 'lower.jo'
use 'ir.jo'
use 'directives.jo'
use 'witness.jo'
use 'witness_ops.dewy'
use 'facts.jo'
use 'facts_arith.dewy'
use 'facts_forgets.dewy'
use 'facts_routes.dewy'
use 'facts_changes.dewy'
use 'facts_library.dewy'
use 'facts_probes.dewy'
use 'refine.jo'
use 'refine_transfers.dewy'
use 'refine_metadata.dewy'
use 'refine_rare.dewy'
use 'effects.jo'
use 'ownership.jo'
use 'nd_slices.dewy'
use 'sequence_selectors.dewy'
use 'ownership_types.dewy'
use 'lower_primitives.dewy'
use 'ir_builders.dewy'
use 'effect_values.dewy'
use 'nd_contract_ops.dewy'

const ND_STORAGE_VALID = -2147483647
const ND_STORAGE_SHAPES = -2147483646

nd_shape_predicates: {int: bool} = {}
nd_mutable_signatures: {int: int[]} = {}
nd_mutable_instances: {int: int[]} = {}
nd_mutable_checks: {int: int[]} = {}

# A shape written in two places interns to one predicate: a diagnostic then
# names neither declaration rather than whichever was read last. O(1).
nd_span_shared: {int: bool} = {}

fact_nd_names: {int: int} = {}
fact_nd_functions: int[]

# Shared entry points for classification and contract transfer.
fact_nd_call = (n: int) -> int: nd_query_call(n)
fact_nd_plain_store = (n: int) -> bool: nd_query_plain_store(n)
fact_nd_reads_only = (n: int) -> bool: nd_query_reads_only(n)
nd_mutable_call = (n: int) -> bool: nd_query_mutable_call(n)
nd_mutable_entry = (f: int, s: mut FactState): nd_query_mutable_entry(f, s)
nd_mutable_check = (n: int, s: mut FactState, values: int[]): nd_query_mutable_check(n, s, values)
nd_mutable_handle = (n: int) -> bool: nd_query_mutable_handle(n)
nd_call_entry = (n: int, s: mut FactState, values: mut int[]): nd_query_call_entry(n, s, values)
nd_contracts_reset = (): nd_query_reset()

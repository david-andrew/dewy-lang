$runtime_checks
OverflowWord:type=int64<overflow='wrap'>
# Word overflow predicate shared by semantic folding and IR folding. Operands
# are bit patterns in the implementation language, whose int remains wrapping.
math_word_overflow=(operation:OverflowWord x:OverflowWord y:OverflowWord):>bool=>{
    if operation =? 0 {
        let r=x + y
        return ((x xor r) & (y xor r)) <? 0
    }
    if operation =? 1 {
        let r=x - y
        return ((x xor y) & (x xor r)) <? 0
    }
    if operation =? 2 {
        let ax=if x <? 0 {uint64<overflow='wrap'>(-(x + 1)) + 1} else {uint64<overflow='wrap'>(x)}
        let ay=if y <? 0 {uint64<overflow='wrap'>(-(y + 1)) + 1} else {uint64<overflow='wrap'>(y)}
        let limit=if (x <? 0) not=? (y <? 0) {uint64<overflow='wrap'>(9223372036854775807) + 1} else {uint64<overflow='wrap'>(9223372036854775807)}
        return ay not=? 0 and ax >? limit // ay
    }
    if operation =? 3 {return y =? 0 or (x =? -9223372036854775807 - 1 and y =? -1)}
    if y <? 0 {return true}
    if y >=? 64 {return x not=? 0}
    ((x << y) >> y) not=? x
}

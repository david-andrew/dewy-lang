# (the ones a call with the wrong number of arguments could have meant: "; there are f(a: int),
# f(a: int, b: int)")
overloads_text = (decls: int[], err: str) -> str:
    if decls.len() < 2: return ""
    # (only when how many arguments was wrong: a wrong one's type is said already)
    if len(err) > 0 and not starts_with(err, "too many") and not starts_with(err, "missing"): return ""
    s = ""
    k = 0
    loop d in decls:
        if starts_with(name_of(int(nodes[d].name)), "__"): continue
        if k == 4: return s + " ..."
        if k == 0: s = "; there are "
        else: s += ", "
        s += call_text(d)
        k += 1
    s
call_text = (d: int) -> str:
    if caller_dewy(): return dewy_call_text(d)
    s = "{name_of(int(nodes[d].name))}("
    loop i in [0..nkids(d)):
        if i > 0: s += ", "
        s += ide_param_text(nodes[kid(d, i)].pos)
    s + ")"
# (a declaration as a Dewy program sees it: its Dewy name, `@` for a mutable parameter and Dewy
# types, whitespace between parameters, whichever language declares it)
dewy_call_text = (d: int) -> str:
    saved = ts_params
    ts_params = type_param_names(d)
    s = dewy_call_text_in(d)
    ts_params = saved
    s
# (a generic declaration's type parameters by their names, for its signature's types)
type_param_names = (d: int) -> int[]:
    out: int[]
    loop i in [0..nkids2(d)): out.push(int(nodes[kid2(d, i)].name))
    out
# (a type of declaration d's signature, as a diagnostic shows it)
sig_dt = (d: int, t: int) -> str:
    saved = ts_params
    ts_params = type_param_names(d)
    s = dt(t)
    ts_params = saved
    s
dewy_call_text_in = (d: int) -> str:
    nm = int(nodes[d].name)
    alt = ide_dewy_alt(nm)
    sig = fn_sig(d)
    if alt == 0: alt = nm
    s = "{name_of(alt)}("
    # (a method by its type, without its hidden receiver)
    first = 0
    if dewy_is_method(d) and sig.params.len() > 0:
        s = "{dt(sig.params[0])}.{name_of(alt)}("
        first = 1
    loop i in [first..nkids(d)):
        p = kid(d, i)
        if i > first: s += " "
        if has_flag(p, NF_MUT) or int(sig.mutmask) & (1 << i) != 0: s += "@"
        pn = name_of(int(nodes[p].name))
        if starts_with(pn, "$parameter"): pn = "_"
        s += pn
        if i < sig.params.len() and sig.params[i] != 0: s += ":{dt(sig.params[i])}"
    s += ")"
    s
# ---------------- reading values from text (lib/std/text.jo) ----------------
# __read_fields(r, x) for a value of type t: statements that read it with r (a __TextIn)
read_code = (t: int, rn: str, xn: str, pos: int) -> int[]:
    k = types[t].kind
    st: int[]
    if k == .struct_:
        # Name(field=value, ...): by name, in any order; others skipped, missing ones left as they are
        si = int(types[t].st)
        check_struct_fields(si)
        st.push(rcall("__tx_open", rn, [], pos))
        chain = rcall("__tx_skip", rn, [], pos)
        # (a Dewy record's field without a default must be in the text, an optional one is none: nothing is invented for it)
        dewy = files[pos_file(nodes[int(structs[si].decl)].pos)].is_dewy
        required: int[]
        i = int(structs[si].nfields) - 1
        loop i >= 0:
            f = fields[int(structs[si].fields) + i]
            fi = i
            i -= 1
            fk = tkind(int(f.type))
            if fk == .fn_ or fk == .cfn or fk == .ptr: continue        # (left as they are)
            fname = name_of(int(f.name))
            rd = rcall("__read", rn, [bc_field(bc_ident(xn, pos), fname, pos)], pos)
            # (the field's name kept while it is read: errors say where they are)
            body = [rd, rcall("__tx_at", rn, [bc_str(fname, pos)], pos)]
            if dewy and int(f.defval) == 0 and fk != .opt:
                required.insert(0, fi)
                body.push(bc_assign(bc_ident("__seen{fi}", pos), bc_bool(true, pos), pos))
            chain = bc_if(bc_call("__tx_name_is", [bc_ident(rn, pos), bc_str(fname, pos)], pos), body, [chain], pos)
        loop fi in required: st.push(bc_let("__seen{fi}", bc_bool(false, pos), pos))
        w = mk(.while_, pos)
        nodes[w].a = i32(bc_call("__tx_field", [bc_ident(rn, pos)], pos))
        nodes[w].b = i32(bc_block([chain], pos))
        st.push(w)
        loop fi in required:
            fname = name_of(int(fields[int(structs[si].fields) + fi].name))
            st.push(bc_if(bc_ident("__seen{fi}", pos), [], [rcall("__tx_missing", rn, [bc_str(fname, pos)], pos)], pos))
    else if k == .tuple:
        st.push(rcall("__tx_want", rn, [bc_int('(', pos)], pos))
        loop i in [0..int(types[t].nargs)):
            st.push(rcall("__tx_sep", rn, [bc_int(i, pos)], pos))
            el = mk(.field, pos)
            nodes[el].a = i32(bc_ident(xn, pos))
            nodes[el].aux = -2
            nodes[el].ival = i
            st.push(rcall("__read", rn, [el], pos))
        st.push(rcall("__tx_eat", rn, [bc_int(',', pos)], pos))
        st.push(rcall("__tx_want", rn, [bc_int(')', pos)], pos))
    else if k == .vec and t != T_MAT4:
        # vec2(1.5, 2.0)
        st.push(rcall("__tx_open", rn, [], pos))
        ct = T_F32
        if types[t].sign: ct = T_I32
        loop i in [0..int(types[t].bits)):
            st.push(rcall("__tx_sep", rn, [bc_int(i, pos)], pos))
            v = "__c{i}"
            st.push(bc_decl(v, ct, pos))
            st.push(rcall("__read", rn, [bc_ident(v, pos)], pos))
            st.push(bc_assign(bc_field(bc_ident(xn, pos), ["x", "y", "z", "w"][i], pos), bc_ident(v, pos), pos))
        st.push(rcall("__tx_eat", rn, [bc_int(',', pos)], pos))
        st.push(rcall("__tx_want", rn, [bc_int(')', pos)], pos))
    else if k == .fixed:
        st.push(rcall("__tx_want", rn, [bc_int('[', pos)], pos))
        el = mk(.index, pos)
        nodes[el].a = i32(bc_ident(xn, pos))
        nodes[el].b = i32(bc_ident("__i", pos))
        st.push(bc_loop("__i", bc_int(fixed_len(t), pos), [rcall("__tx_sep", rn, [bc_ident("__i", pos)], pos), rcall("__read", rn, [el], pos)], pos))
        st.push(rcall("__tx_eat", rn, [bc_int(',', pos)], pos))
        st.push(rcall("__tx_want", rn, [bc_int(']', pos)], pos))
    else if k == .enum_ and is_union(t):
        # the member's value as it is written: told apart by how it starts (a struct by its name)
        st.push(bc_let("__k", bc_call("__tx_kind", [bc_ident(rn, pos)], pos), pos))
        ms = union_members(t)
        has_int = false
        loop m in ms:
            if is_int(m): has_int = true
        chain = rcall("__tx_fail_found", rn, [bc_str("expected a {dt(t)}", pos)], pos)
        # (enums last: a bare name could be one of them, Name(...) a struct)
        loop pass_ in [0..2):
            i = ms.len() - 1
            loop i >= 0:
                m = prune(ms[i])
                i -= 1
                mk_ = types[m].kind
                if (mk_ == .enum_) != (pass_ == 0): continue
                c = 0
                if mk_ == .str_: c = kind_is(1, pos)
                else if is_int(m): c = kind_is(2, pos)
                else if is_float(m):
                    c = kind_is(3, pos)
                    if not has_int: c = bc_logic(.or_, c, kind_is(2, pos), pos)
                else if mk_ == .bool_: c = kind_is(5, pos)
                else if mk_ == .array or mk_ == .fixed: c = kind_is(8, pos)
                else if is_map_type(m): c = kind_is(9, pos)
                else if mk_ == .tuple: c = kind_is(10, pos)
                else if mk_ == .struct_ or mk_ == .vec:
                    nm = type_str(m)
                    if mk_ == .struct_: nm = structs[int(types[m].st)].name
                    c = bc_logic(.and_, kind_is(6, pos), bc_bin(.eq, bc_field(bc_ident(rn, pos), "name", pos), bc_str(nm, pos), pos), pos)
                else if mk_ == .enum_: c = bc_logic(.or_, kind_is(6, pos), kind_is(7, pos), pos)
                if c == 0: continue
                v = "__u{i + 1}"
                body = [bc_decl(v, m, pos), bc_stmt(bc_call("__default_init", [bc_ident(v, pos)], pos), pos), rcall("__read", rn, [bc_ident(v, pos)], pos), bc_assign(bc_ident(xn, pos), bc_ident(v, pos), pos)]
                chain = bc_if(c, body, [chain], pos)
        st.push(chain)
    else if k == .enum_:
        # a variant by name: hard, or rect(1.0, 2.0)
        si = int(types[t].st)
        check_struct_fields(si)
        st.push(bc_let("__wrapped", bc_call("__tx_enum_open", [bc_ident(rn, pos)], pos), pos))
        st.push(bc_let("__w", bc_call("__tx_word", [bc_ident(rn, pos), mk(.bool_lit, pos)], pos), pos))
        st.push(bc_if(bc_ident("__wrapped", pos), [rcall("__tx_want", rn, [bc_int(':', pos)], pos)], [], pos))
        vs = ""
        loop vi in [0..int(structs[si].nvariants)):
            if vi > 0: vs += ", "
            vs += name_of(int(variants[int(structs[si].variants) + vi].name))
        chain = rcall("__tx_bad", rn, [bc_str("expected a {dt(t)} ({vs})", pos)], pos)
        v = int(structs[si].nvariants) - 1
        loop v >= 0:
            vi = int(structs[si].variants) + v
            v -= 1
            vn = name_of(int(variants[vi].name))
            dn = mk(.dotname, pos)
            nodes[dn].name = variants[vi].name
            nf = int(variants[vi].nfields)
            body: int[]
            if nf == 0:
                body.push(bc_if(bc_ident("__wrapped", pos), [rcall("__tx_bad", rn, [bc_str("expected a variant name as a JSON string", pos)], pos)], [], pos))
                body.push(bc_assign(bc_ident(xn, pos), dn, pos))
            else:
                body.push(rcall("__tx_want", rn, [bc_int('(', pos)], pos))
                vargs: int[]
                loop j in [0..nf):
                    a = "__a{j}"
                    body.push(rcall("__tx_sep", rn, [bc_int(j, pos)], pos))
                    body.push(bc_decl(a, int(fields[int(variants[vi].fields) + j].type), pos))
                    body.push(bc_stmt(bc_call("__default_init", [bc_ident(a, pos)], pos), pos))
                    body.push(rcall("__read", rn, [bc_ident(a, pos)], pos))
                    vargs.push(bc_ident(a, pos))
                body.push(rcall("__tx_eat", rn, [bc_int(',', pos)], pos))
                body.push(rcall("__tx_want", rn, [bc_int(')', pos)], pos))
                c = mk(.call, pos)
                nodes[c].a = i32(dn)
                set_list(c, vargs)
                body.push(bc_assign(bc_ident(xn, pos), c, pos))
            chain = bc_if(bc_bin(.eq, bc_ident("__w", pos), bc_str(vn, pos), pos), body, [chain], pos)
        st.push(chain)
        st.push(bc_if(bc_ident("__wrapped", pos), [rcall("__tx_want", rn, [bc_int('}}', pos)], pos)], [], pos))
    else: fatal(pos, "a value of type {dt(t)} cannot be read from text")
    st
# f(r, args...) as a statement
rcall = (f: str, rn: str, args: int[], pos: int) -> int: bc_stmt(bc_call(f, [bc_ident(rn, pos)] + args, pos), pos)
bc_logic = (k: NK, a: int, b: int, pos: int) -> int:
    n = mk(k, pos)
    nodes[n].a = i32(a)
    nodes[n].b = i32(b)
    n
kind_is = (c: int, pos: int) -> int: bc_bin(.eq, bc_ident("__k", pos), bc_int(c, pos), pos)

$runtime_checks

from p"ast.jo" import (NF_BROADCAST NF_CHECKED NF_EXPLICIT_INTEGER NF_RECORD NF_GLOBAL NF_MUT nodes add_flag has_flag kid kids mk nkids)
from p"check.jo" import (LF_CONST LF_MUTPARAM compound_op dewy_at fns globals locals)
from p"checker_exact.dewy" import (exact_math_operand)
from p"checks_assign_hooks.dewy" import (block_value)
from p"checks_thin.dewy" import (readonly_global)
from p"directive_queries.dewy" import (dir_policy)
from p"directives.jo" import (DIR_STATIC)
from p"effects.jo" import (effect_ix_locals effect_ix_nodes effect_seen effect_unavailable)
from p"exact.jo" import (ExactMeasure exact_candidate_heads exact_candidate_next exact_candidate_nodes exact_collect_writes exact_control_head exact_control_parents exact_control_values exact_count_nodes exact_decided exact_demands exact_effect_owners exact_float_purity exact_full_owners exact_has_node exact_has_store exact_initializers exact_iteration_sources exact_local_widths exact_lower_sites exact_mark exact_marks exact_match_literals exact_measure_on exact_measure_sites exact_owners exact_progress_assignments exact_progress_opaque exact_proof_demands exact_raw_values exact_rep_demands exact_rep_owners exact_shader_owners exact_shader_roots exact_shifts exact_stores exact_type_values exact_type_widths exact_unmark exact_word_reads exact_write_controls exact_write_heads exact_write_next exact_write_plain exact_write_seen exact_write_targets exact_write_values)
from p"exact_check_hooks.dewy" import (exact_operation exact_representation exact_type)
from p"exact_cold_walk.dewy" import (exact_reserve exact_shader_calls)
from p"exact_count_bounds.dewy" import (exact_bounded_count exact_count_bound)
from p"exact_measure.dewy" import (exact_measure_boundary exact_measure_visit)
from p"exact_static_widths.dewy" import (exact_type_width)
from p"expr.jo" import (CV IN integer_constant ntype wrap_conv)
from p"facts.jo" import (fact_plan_forget)
from p"facts_lifecycle.dewy" import (fn_in_lib)
from p"facts_progress.dewy" import (fact_progress_note fact_progress_root)
from p"facts_ranges.dewy" import (fact_floor_call)
from p"isolation_ops.dewy" import (isolation_children)
from p"node_store.dewy" import (Node)
from p"pcheck_drive.dewy" import (pc_restore)
from p"types.jo" import (T_BOOL T_INT T_MATH_INT is_int prune telem tkind types)

PrepareWord:type=int64<overflow='wrap'>
# Fixed SK and Tok ordinals from checker_state and checker_tokens.
const PREP_SK_LOCAL:int32=1
const PREP_SK_GLOBAL:int32=2
const PREP_TOK_MINUS:int32=59
const PREP_TOK_SLASH:int32=61
const PREP_TOK_PERCENT:int32=62
const PREP_TOK_SHR:int32=68
const PREP_TOK_AMP:int32=63
const PREP_TOK_SHL:int32=67
const PREP_TOK_PLUS:int32=58
const PREP_TOK_STAR:int32=60
const PREP_TOK_PIPE:int32=64
const PREP_TOK_CARET:int32=65
const PREP_TOK_ASSIGN:int32=47
const PREP_TOK_STARSTAR:int32=79

exact_shader_demand=():>array<int64>=>$unsafe {
    let seen:dict<int64 bool>=[]
    let out:array<int64>=[]
    let work=exact_shader_roots
    exact_shader_roots.clear()
    loop work.length >? 0 {
        let f=work.pop()
        if f <=? 0 or f >=? fns.length or seen.has(f) or fns.ptr[f].body =? 0 or fn_in_lib(f) {continue}
        seen[f] = true
        exact_shader_owners[f] = true
        out.push(f)
        exact_shader_calls(PrepareWord(fns.ptr[f].body) @work)
    }
    out
}

exact_store=(n:PrepareWord owner:PrepareWord):>void=>$unsafe {
    if not exact_has_node(n) or exact_has_store(n) {return}
    let t=ntype(n)
    if not exact_type(t nodes.ptr[n].pos) {return}
    let k=nodes.ptr[n].kind
    if k =? 'block' and nodes.ptr[n].aux not=? 0 {
        exact_store(block_value(n) owner)
        exact_unmark(n)
        return
    }
    if k =? 'if_' or k =? 'iflet' or k =? 'match_' {
        if k =? 'match_' {
            loop arm in kids(n) {exact_store(PrepareWord(nodes.ptr[arm].b) owner)}
        }
        else {
            exact_store(PrepareWord(nodes.ptr[n].b) owner)
            exact_store(PrepareWord(nodes.ptr[n].c) owner)
        }
        exact_unmark(n)
        return
    }
    let width:PrepareWord=exact_type_width(n)
    let fits=width >? 0 and (if types.ptr[exact_representation(t)].sign {width >> 1 <=? types.ptr[exact_representation(t)].bits} else {width & 1 not=? 0 and width >> 1 <=? PrepareWord(types.ptr[exact_representation(t)].bits) + 1})
    if fits {
        if exact_measure_on {exact_measure_sites[n] = ExactMeasure(owner t "proven")}
        return
    }
    let inner=nodes.length
    nodes.push(nodes.ptr[n])
    if exact_shifts.has(n) {exact_shifts[inner] = exact_shifts[n]}
    exact_mark(inner)
    nodes.ptr[n] = Node[kind = 'conv' pos = nodes.ptr[inner].pos a = int32(inner) aux = int32(int64(CV.fixed_store)) type = int32(t) flags = int32(NF_CHECKED)]
    exact_unmark(n)
    exact_stores[n] = owner
    exact_marks[n] |= 2
    if n <? exact_type_widths.length {exact_type_widths[n] = 0}
    if exact_measure_on {exact_measure_sites[n] = ExactMeasure(owner t "runtime-check")}
}

exact_named_constant=(n:PrepareWord):>bool=>$unsafe {
    if nodes.ptr[n].kind not=? 'ident' {return false}
    if nodes.ptr[n].aux =? PREP_SK_GLOBAL {
        let g=PrepareWord(nodes.ptr[n].sym)
        return readonly_global(g) and not globals.ptr[g].exposed
    }
    nodes.ptr[n].aux =? PREP_SK_LOCAL and PrepareWord(locals.ptr[PrepareWord(nodes.ptr[n].sym)].flags) & LF_CONST not=? 0
}

exact_constant_use=(n:PrepareWord):>bool=>$unsafe {
    if exact_named_constant(n) {return true}
    if nodes.ptr[n].kind =? 'binary' and nodes.ptr[n].aux =? 0 {
        return exact_named_constant(PrepareWord(nodes.ptr[n].a)) or exact_named_constant(PrepareWord(nodes.ptr[n].b))
    }
    false
}

exact_prepare_operand=(n:PrepareWord):>int64=>$unsafe {
    let word=exact_math_operand(n)
    if word not=? n or prune(ntype(n)) not=? T_MATH_INT {return word}
    if nodes.ptr[n].kind =? 'conv' and nodes.ptr[n].aux =? int32(int64(CV.int_)) {
        let source=PrepareWord(nodes.ptr[n].a)
        let t=exact_representation(ntype(source))
        # A stored signed policy word has the same value when lifted to int.
        # Keep its policy operation intact beneath an identity conversion.
        if is_int(t) and types.ptr[t].sign and types.ptr[t].bits =? 64 {
            word=mk('conv' nodes.ptr[n].pos)
            nodes.ptr[word] = Node[kind = 'conv' pos = nodes.ptr[n].pos a = int32(source) aux = int32(int64(CV.none_)) type = int32(T_INT) flags = int32(NF_CHECKED)]
            return word
        }
    }
    if nodes.ptr[n].kind not=? 'ident' {return n}
    # A local constant may be an inferred `int`. Stored globals retain their
    # read and include their initial zero in exact_count_bound below.
    let local=nodes.ptr[n].aux =? PREP_SK_LOCAL
    if local and PrepareWord(locals.ptr[PrepareWord(nodes.ptr[n].sym)].flags) & LF_CONST not=? 0 {
        let width:PrepareWord=exact_type_width(n)
        let index=exact_type_widths[n]
        if index <? -1 and width >> 1 <=? 64 {
            let value=PrepareWord(exact_type_values[n])
            if index & 1 =? 0 {value=-value}
            word=mk('int_lit' nodes.ptr[n].pos)
            nodes.ptr[word].type = int32(T_INT)
            nodes.ptr[word].ival = value
            add_flag(word NF_CHECKED)
            return word
        }
    }
    if not local and nodes.ptr[n].aux not=? PREP_SK_GLOBAL {return n}
    let bound=exact_count_bound(n)
    if bound.wide {return n}
    word=mk('conv' nodes.ptr[n].pos)
    nodes.ptr[word].a = int32(n)
    nodes.ptr[word].aux = int32(int64(CV.int_))
    nodes.ptr[word].type = int32(T_INT)
    exact_word_reads[word] = true
    word
}

exact_prepare_math=(n:PrepareWord):>bool=>$unsafe {
    if nodes.ptr[n].kind not=? 'call' and nodes.ptr[n].kind not=? 'binary' and nodes.ptr[n].kind not=? 'unary' {return false}
    if nodes.ptr[n].aux not=? 0 or prune(ntype(n)) not=? T_MATH_INT or not dewy_at(nodes.ptr[n].pos) {return false}
    if nodes.ptr[n].kind =? 'unary' {
        if nodes.ptr[n].op not=? PREP_TOK_MINUS {return false}
        let a=exact_prepare_operand(PrepareWord(nodes.ptr[n].a))
        if exact_representation(ntype(a)) not=? T_INT {return false}
        nodes.ptr[n].a = int32(a)
        nodes.ptr[n].type = int32(T_INT)
        wrap_conv(n CV.int_ T_MATH_INT)
        return true
    }
    if nodes.ptr[n].kind =? 'call' {
        let floor=fact_floor_call(n)
        if floor <? 1 or floor >? 4 {return false}
        let a=exact_prepare_operand(kid(n 0))
        let b=exact_prepare_operand(kid(n 1))
        if exact_representation(ntype(a)) not=? T_INT or exact_representation(ntype(b)) not=? T_INT {return false}
        nodes.ptr[n] = Node[kind = 'binary' pos = nodes.ptr[n].pos a = int32(a) b = int32(b) type = int32(T_INT) op = (if floor =? 1 {PREP_TOK_SLASH} else if floor =? 2 {PREP_TOK_PERCENT} else if floor =? 3 {PREP_TOK_SHR} else {PREP_TOK_AMP}) aux2 = -1 flags = int32(NF_CHECKED)]
        wrap_conv(n CV.int_ T_MATH_INT)
        return true
    }
    if nodes.ptr[n].kind not=? 'binary' {return false}
    let op=nodes.ptr[n].op
    let right=PrepareWord(nodes.ptr[n].b)
    if op =? PREP_TOK_SHL or op =? PREP_TOK_SHR {
        # Dynamic int64 shifts preserve unsigned count interpretation in a
        # wrapper. A final nonnegative bound proves that wrapper is an identity.
        let count_type=exact_representation(ntype(right))
        if nodes.ptr[right].kind =? 'conv' and nodes.ptr[right].aux =? int32(int64(CV.wrap_int)) and is_int(count_type) and not types.ptr[count_type].sign and types.ptr[count_type].bits =? 64 {
            let source=PrepareWord(nodes.ptr[right].a)
            if exact_bounded_count(source) {right=source}
        }
        let [known count]=integer_constant(right)
        if not known or count <? 0 or count >=? 1048576 {
            if not exact_bounded_count(right) {return false}
        }
    }
    else if op not=? PREP_TOK_PLUS and op not=? PREP_TOK_MINUS and op not=? PREP_TOK_STAR and op not=? PREP_TOK_AMP and op not=? PREP_TOK_PIPE and op not=? PREP_TOK_CARET {return false}
    let a=exact_prepare_operand(PrepareWord(nodes.ptr[n].a))
    let b=exact_prepare_operand(right)
    if exact_representation(ntype(a)) not=? T_INT {return false}
    if exact_representation(ntype(b)) not=? T_INT {
        # A bounded shift count keeps its original fixed storage width.
        if op not=? PREP_TOK_SHL and op not=? PREP_TOK_SHR or not is_int(ntype(b)) or prune(ntype(b)) =? T_MATH_INT {return false}
    }
    nodes.ptr[n].a = int32(a)
    nodes.ptr[n].b = int32(b)
    nodes.ptr[n].type = int32(T_INT)
    wrap_conv(n CV.int_ T_MATH_INT)
    true
}

exact_prepare_node=(n:PrepareWord owner:PrepareWord store:bool):>void=>$unsafe {
    if n <=? 0 {return}
    # Scalar leaves carry no arithmetic or writes. Strings may contain
    # interpolation expressions, so retain their ordinary child traversal.
    # Node starts with NK's int32 ordinal. Integer through identifier is 1..7,
    # with the interpolated string at 3. Check this before entering the body walk.
    let ordinal=((nodes.ptr + n) as ptr<int32>)[0]
    if ordinal >=? 1 and ordinal <=? 7 and ordinal not=? 3 {return}
    exact_prepare_body(n owner store)
}

exact_prepare_body=(n:PrepareWord owner:PrepareWord store:bool):>void=>$unsafe {
    if n >=? exact_marks.length {exact_reserve(n)}
    let mark=exact_marks.ptr[n]
    if mark & 4 not=? 0 {
        if store and mark & 3 =? 1 {exact_store(n owner)}
        return
    }
    exact_marks[n] |= 4
    # Reveal/wrap nodes around scalar arithmetic are representation identities.
    # Keep the checked visibility type, but do not make them storage boundaries.
    # Refinement conversions retain their own nodes and redacted diagnostics.
    loop nodes.ptr[n].kind =? 'conv' and nodes.ptr[n].aux =? int32(int64(CV.none_)) {
        let child=PrepareWord(nodes.ptr[n].a)
        let t=ntype(n)
        let ct=ntype(child)
        if not is_int(exact_representation(t)) or exact_representation(t) not=? exact_representation(ct) {break}
        let kind=nodes.ptr[child].kind
        if kind not=? 'binary' and kind not=? 'unary' and kind not=? 'ident' and kind not=? 'int_lit' and not (kind =? 'conv' and nodes.ptr[child].aux =? int32(int64(CV.none_))) {break}
        nodes.ptr[n] = nodes.ptr[child]
        nodes.ptr[n].type = int32(t)
    }
    # Local compound arithmetic has the same left-before-right evaluation as
    # a simple binary assignment. Expose it before write/representation proofs.
    if nodes.ptr[n].kind =? 'assign' and nodes.ptr[n].aux =? 0 and nodes.ptr[n].op not=? PREP_TOK_ASSIGN {
        let target=PrepareWord(nodes.ptr[n].a)
        if nodes.ptr[target].kind =? 'ident' and nodes.ptr[target].aux =? PREP_SK_LOCAL and prune(ntype(target)) =? T_MATH_INT {
            let op=compound_op(PrepareWord(nodes.ptr[n].op))
            if op =? PREP_TOK_PLUS or op =? PREP_TOK_MINUS or op =? PREP_TOK_STAR or op =? PREP_TOK_AMP or op =? PREP_TOK_PIPE or op =? PREP_TOK_CARET {
                let left=nodes.length
                nodes.push(nodes.ptr[target])
                let value=mk('binary' nodes.ptr[n].pos)
                nodes.ptr[value] = Node[kind = 'binary' pos = nodes.ptr[n].pos a = int32(left) b = nodes.ptr[n].b op = int32(PrepareWord(op)) type = int32(T_MATH_INT) flags = int32(NF_CHECKED)]
                nodes.ptr[n].b = int32(value)
                nodes.ptr[n].op = PREP_TOK_ASSIGN
            }
        }
    }
    let k=nodes.ptr[n].kind
    if k =? 'array' and has_flag(n NF_BROADCAST) and tkind(ntype(n)) =? 'array' and exact_representation(telem(ntype(n))) =? T_MATH_INT {exact_demands[owner] = true}
    if exact_collect_writes and (k =? 'vardecl' or k =? 'assign' or k =? 'for_' or k =? 'while_' or k =? 'lambda' or k =? 'fn_' or k =? 'return_' or k =? 'break_' or k =? 'continue_') {exact_lower_sites.push(n)}
    if k =? 'lambda' or k =? 'fn_' {return}
    if exact_measure_on {
        if store {exact_measure_boundary(n owner)}
        else {exact_measure_visit(n owner false)}
    }
    # Classify only the relevant kind. This demanded walk already has k;
    # unrelated nodes need neither arithmetic/type queries nor policy tests.
    let math=false
    let operator=false
    let cmp=false
    let conversion=false
    let policy=false
    let control=false
    if k =? 'binary' {
        math=exact_operation(n)
        operator=nodes.ptr[n].aux =? 0 and exact_type(ntype(n) nodes.ptr[n].pos)
        cmp=nodes.ptr[n].aux =? 0 and ntype(n) =? T_BOOL
    }
    else if k =? 'unary' or k =? 'intrinsic' {math=exact_operation(n)}
    else if k =? 'conv' {
        conversion=(nodes.ptr[n].aux =? int32(int64(CV.int_)) or nodes.ptr[n].aux =? int32(int64(CV.none_))) and exact_type(ntype(n) nodes.ptr[n].pos)
        policy=nodes.ptr[n].aux =? int32(int64(CV.wrap_int)) or nodes.ptr[n].aux =? int32(int64(CV.saturate_int)) or nodes.ptr[n].aux =? int32(int64(CV.int2float)) or ntype(n) =? T_MATH_INT
    }
    else if k =? 'if_' or k =? 'iflet' or k =? 'block' or k =? 'exprstmt' or k =? 'match_' or k =? 'arm' or k =? 'coalesce' {control=true}
    if math and nodes.ptr[n].kind =? 'binary' and (nodes.ptr[n].op =? PREP_TOK_SHL or nodes.ptr[n].op =? PREP_TOK_STARSTAR) {
        let [known count]=integer_constant(PrepareWord(nodes.ptr[n].b))
        if count <? 0 and not types.ptr[exact_representation(ntype(PrepareWord(nodes.ptr[n].b)))].sign {known=false}
        if known and count <? 1048576 {exact_shifts[n] = max(0 count)}
        else {
            exact_demands[owner] = true
            exact_count_nodes.push([n owner])
            exact_marks[n] |= 128
        }
    }
    let previous_control:PrepareWord=0
    if k =? 'while_' or k =? 'for_' {
        previous_control=exact_control_head
        exact_control_values.push(PrepareWord(nodes.ptr[n].a))
        exact_control_parents.push(previous_control)
        prepare_control_head[0]=exact_control_values.length
    }
    if policy and k =? 'conv' and (nodes.ptr[n].aux =? int32(int64(CV.wrap_int)) or nodes.ptr[n].aux =? int32(int64(CV.saturate_int))) and exact_named_constant(PrepareWord(nodes.ptr[n].a)) {
        let word=exact_prepare_operand(PrepareWord(nodes.ptr[n].a))
        nodes.ptr[n].a = int32(word)
    }
    let mask=isolation_children(k)
    if mask >? 0 {
        if mask & 1 not=? 0 {exact_prepare_node(PrepareWord(nodes.ptr[n].a) owner not (math or operator or cmp or conversion or policy or k =? 'exprstmt' or k =? 'match_' and exact_match_literals(n)))}
        if mask & 2 not=? 0 {exact_prepare_node(PrepareWord(nodes.ptr[n].b) owner not (math or operator or cmp or control))}
        if mask & 4 not=? 0 {exact_prepare_node(PrepareWord(nodes.ptr[n].c) owner not control)}
        if mask & 16 not=? 0 {
            loop i in [0..nkids(n)) {exact_prepare_node(kid(n i) owner not math and k not=? 'block' and k not=? 'match_')}
        }
    }
    if (k =? 'call' or k =? 'binary' or k =? 'unary') and prune(ntype(n)) =? T_MATH_INT and exact_prepare_math(n) {
        exact_marks[n] &= 251
        exact_prepare_node(n owner store)
        return
    }
    if conversion and prune(ntype(PrepareWord(nodes.ptr[n].a))) =? T_MATH_INT {
        let source=PrepareWord(nodes.ptr[n].a)
        if exact_named_constant(source) and not exact_word_reads.has(n) {
            let word=exact_prepare_operand(source)
            if word not=? source {
                nodes.ptr[n].a = int32(word)
                exact_mark(n) # narrower destinations still need their own fit proof
            }
        }
        if nodes.ptr[n].a =? int32(source) {
            if nodes.ptr[source].kind =? 'conv' and nodes.ptr[source].aux =? int32(int64(CV.int_)) and exact_type(ntype(PrepareWord(nodes.ptr[source].a)) nodes.ptr[n].pos) {nodes.ptr[n].a = nodes.ptr[source].a}
            else if not exact_word_reads.has(n) {exact_demands[owner] = true}
        }
    }
    # Arm coercion rewrites the tail after check_block cached its type.
    # Keep both directions synchronized: a word arm widened to int must not
    # be read as an untagged word, and a narrowed arm must expose its fit check.
    if k =? 'block' and nodes.ptr[n].aux not=? 0 {
        let tail=block_value(n)
        if prune(ntype(n)) =? T_MATH_INT or prune(ntype(tail)) =? T_MATH_INT {nodes.ptr[n].type = nodes.ptr[tail].type}
    }
    let expanded=math or operator and (exact_has_node(PrepareWord(nodes.ptr[n].a)) or exact_has_node(PrepareWord(nodes.ptr[n].b)))
    if conversion or k =? 'exprstmt' {expanded=exact_has_node(PrepareWord(nodes.ptr[n].a))}
    if k =? 'if_' or k =? 'iflet' {expanded=exact_has_node(PrepareWord(nodes.ptr[n].b)) or exact_has_node(PrepareWord(nodes.ptr[n].c))}
    if k =? 'block' and nodes.ptr[n].aux not=? 0 {expanded=exact_has_node(block_value(n))}
    if k =? 'match_' {
        loop arm in kids(n) {
            if exact_has_node(PrepareWord(nodes.ptr[arm].b)) {expanded=true}
        }
    }
    if expanded and nodes.ptr[n].type not=? 0 and exact_type(ntype(n) nodes.ptr[n].pos) {exact_mark(n)}
    if cmp and (exact_has_node(PrepareWord(nodes.ptr[n].a)) or exact_has_node(PrepareWord(nodes.ptr[n].b))) {exact_mark(n)}
    if k =? 'coalesce' and exact_has_node(PrepareWord(nodes.ptr[n].b)) and exact_type(ntype(n) nodes.ptr[n].pos) {exact_mark(n)}
    if exact_marks.ptr[n] & 3 =? 1 and (store or k =? 'conv' and has_flag(n NF_EXPLICIT_INTEGER)) {exact_store(n owner)}
    # A dynamic mathematical shift may still have a word-sized value at this
    # use. Ask the existing flow proof before choosing the tagged shift helper.
    # This is representation demand, never an added source fit obligation.
    if k =? 'binary' and nodes.ptr[n].aux =? 0 and nodes.ptr[n].op =? PREP_TOK_SHL and prune(ntype(n)) =? T_MATH_INT {
        if owner >=? exact_rep_owners.length {exact_rep_owners.resize(max(owner + 1 fns.length))}
        exact_rep_owners[owner] = true
        if n >=? exact_rep_demands.length {exact_rep_demands.resize(nodes.length)}
        exact_rep_demands[n] = true
        exact_proof_demands[owner] = true
    }
    if k =? 'for_' and nodes.ptr[n].aux =? 0 {
        let it=PrepareWord(nodes.ptr[n].a)
        loop endpoint in [PrepareWord(nodes.ptr[it].a) PrepareWord(nodes.ptr[it].b) PrepareWord(nodes.ptr[it].c)] {
            if endpoint not=? 0 and prune(ntype(endpoint)) =? T_MATH_INT and exact_count_bound(endpoint).wide {
                if owner >=? exact_rep_owners.length {exact_rep_owners.resize(max(owner + 1 fns.length))}
                exact_rep_owners[owner] = true
                if endpoint >=? exact_rep_demands.length {exact_rep_demands.resize(nodes.length)}
                exact_rep_demands[endpoint] = true
                exact_proof_demands[owner] = true
            }
        }
    }
    if k =? 'for_' and (nodes.ptr[n].aux =? 0 or nodes.ptr[n].aux =? 1) and nodes.ptr[n].sym >? 0 and not has_flag(n NF_MUT) {
        let l=PrepareWord(nodes.ptr[n].sym)
        if l >=? exact_iteration_sources.length {exact_iteration_sources.resize(locals.length)}
        exact_iteration_sources[l] = PrepareWord(nodes.ptr[n].a)
    }
    if k =? 'vardecl' and nodes.ptr[n].sym >? 0 and not has_flag(n NF_GLOBAL) {
        let l=PrepareWord(nodes.ptr[n].sym)
        if l >=? exact_initializers.length {exact_initializers.resize(max(l + 1 locals.length))}
        exact_initializers[l] = PrepareWord(nodes.ptr[n].b)
    }
    if k =? 'call' and nodes.ptr[n].aux =? 0 and nodes.ptr[n].sym >? 0 {
        let called=PrepareWord(nodes.ptr[n].sym)
        loop i in [0..min(nkids(n) fns.ptr[called].params.length)) {
            if PrepareWord(locals.ptr[fns.ptr[called].params[i]].flags) & LF_MUTPARAM =? 0 {continue}
            let root=fact_progress_root(kid(n i))
            if nodes.ptr[root].kind =? 'ident' and nodes.ptr[root].aux =? PREP_SK_LOCAL {
                let l=PrepareWord(nodes.ptr[root].sym)
                if l >=? exact_progress_opaque.length {exact_progress_opaque.resize(locals.length)}
                exact_progress_opaque[l] = true
            }
        }
    }
    if k =? 'intrinsic' and nkids(n) >? 0 {
        let id=nodes.ptr[n].aux as IN
        if id =? IN.push or id =? IN.insert or id =? IN.extend or id =? IN.fill or id =? IN.resize or id =? IN.truncate or id =? IN.reserve {
            let root=fact_progress_root(kid(n 0))
            if nodes.ptr[root].kind =? 'ident' and nodes.ptr[root].aux =? PREP_SK_LOCAL {
                let l=PrepareWord(nodes.ptr[root].sym)
                if l >=? exact_progress_opaque.length {exact_progress_opaque.resize(locals.length)}
                exact_progress_opaque[l] = true
            }
        }
    }
    if k =? 'assign' {
        exact_progress_assignments.push(n)
        let target=PrepareWord(nodes.ptr[n].a)
        let root=fact_progress_root(target)
        if nodes.ptr[root].kind =? 'ident' and nodes.ptr[root].aux =? PREP_SK_LOCAL {
            let l=PrepareWord(nodes.ptr[root].sym)
            if l >=? exact_write_heads.length {exact_write_heads.resize(max(l + 1 locals.length))}
            exact_write_values.push(PrepareWord(nodes.ptr[n].b))
            exact_write_plain.push(nodes.ptr[n].op =? PREP_TOK_ASSIGN and nodes.ptr[n].aux =? 0)
            exact_write_targets.push(target)
            exact_write_seen.push(0)
            exact_write_controls.push(exact_control_head)
            exact_write_next.push(exact_write_heads[l])
            exact_write_heads[l] = exact_write_values.length
        }
    }
    if k =? 'while_' or k =? 'for_' {
        if exact_collect_writes {exact_lower_sites.push(-1)}
        prepare_control_head[0]=previous_control
    }
}

exact_pure_float_tree=(n:PrepareWord):>bool=>$unsafe {
    if n <? exact_float_purity.length and exact_float_purity[n] not=? 0 {return exact_float_purity[n] =? 2}
    let k=nodes.ptr[n].kind
    let pure=k =? 'ident' or k =? 'int_lit' or k =? 'bool_lit'
    if k =? 'unary' or k =? 'conv' {pure=exact_pure_float_tree(PrepareWord(nodes.ptr[n].a))}
    else if k =? 'binary' and nodes.ptr[n].aux =? 0 {pure=exact_pure_float_tree(PrepareWord(nodes.ptr[n].a)) and exact_pure_float_tree(PrepareWord(nodes.ptr[n].b))}
    if n >=? exact_float_purity.length {exact_float_purity.resize(max(n + 1 nodes.length))}
    exact_float_purity[n] = if pure {2} else {1}
    pure
}

exact_prepare_floats=(f:PrepareWord):>bool=>$unsafe {
    if exact_measure_on or exact_full_owners.has(f) or f >=? exact_candidate_heads.length or exact_candidate_heads[f] =? 0 {return false}
    let at:PrepareWord=exact_candidate_heads[f]
    loop at >? 0 {
        let n=exact_candidate_nodes[at - 1]
        if nodes.ptr[n].kind =? 'conv' and nodes.ptr[n].aux =? int32(int64(CV.int2float)) and exact_pure_float_tree(n) {exact_prepare_node(n f false)}
        at=exact_candidate_next[at - 1]
    }
    at=exact_candidate_heads[f]
    loop at >? 0 {
        let n=exact_candidate_nodes[at - 1]
        if n >=? exact_marks.length or exact_marks[n] & 4 =? 0 {return false}
        at=exact_candidate_next[at - 1]
    }
    true
}

exact_prepare=():>void=>$unsafe {
    if exact_owners.length >? 0 {prepare_marks[0]=fill(uint8(0) PrepareWord(nodes.length) * 2 + 64)}
    let owners:array<int64>=[]
    loop [f _] in exact_owners {owners.push(f)}
    owners.sort()
    loop f in owners {
        # A checking worker reports this demand alongside its closed-state
        # summary. Restore only demanded bodies before obligations are decided.
        pc_restore(f)
        if f <=? 0 or f >=? fns.length or fns.ptr[f].state not=? 2 or effect_unavailable.has(f) {continue}
        if f >=? exact_effect_owners.length {exact_effect_owners.resize(fns.length)}
        exact_effect_owners[f] = true
        let body=PrepareWord(fns.ptr[f].body)
        if exact_prepare_floats(f) {continue}
        fact_plan_forget(f);
        # Reuse this demanded traversal for lowering's write inventory.
        # Each write/control boundary is recorded once, O(N+E); lowering
        # replays O(writes + controls) instead of walking the body again.
        prepare_collect_writes[0]=not fns.ptr[f].writes_ready
        exact_lower_sites.clear()
        exact_prepare_node(body f false)
        if exact_collect_writes {
            fns.ptr[f].write_sites = exact_lower_sites
            fns.ptr[f].writes_ready = true
        }
        prepare_collect_writes[0]=false
        exact_lower_sites.clear()
        if nodes.ptr[body].kind =? 'block' and nodes.ptr[body].aux not=? 0 {
            if exact_measure_on {exact_measure_boundary(block_value(body) f)}
            exact_store(block_value(body) f)
        }
    }
    loop candidate in exact_count_nodes {
        let original=candidate[0]
        let n=if exact_has_store(original) {PrepareWord(nodes.ptr[original].a)} else {original}
        let bound=exact_count_bound(PrepareWord(nodes.ptr[n].b))
        if not bound.wide and bound.hi <? 1048576 {
            exact_shifts[n] = max(0 bound.hi)
            exact_marks[original] &= 127
        }
        else {exact_proof_demands[candidate[1]] = true}
    }
    loop assignment in exact_progress_assignments {fact_progress_note(assignment)}
    loop [n owner] in exact_stores {
        if not exact_decided(n) {
            exact_demands[owner] = true
            if dir_policy(nodes.ptr[n].pos) =? DIR_STATIC {exact_proof_demands[owner] = true}
        }
    }
    # Exact stores rewrite existing checked nodes as well as appending them.
    prepare_ix_nodes[0]=0
    prepare_ix_locals[0]=0
    if effect_seen.length >? 0 {effect_seen.resize(nodes.length)}
    exact_local_widths.clear()
    exact_raw_values.clear()
}

let prepare_control_head:ptr<int64>=$unsafe (uint64(0) as ptr<int64>)
let prepare_collect_writes:ptr<bool>=$unsafe (uint64(0) as ptr<bool>)
let prepare_ix_nodes:ptr<int64>=$unsafe (uint64(0) as ptr<int64>)
let prepare_ix_locals:ptr<int64>=$unsafe (uint64(0) as ptr<int64>)
let prepare_marks:ptr<array<uint8>>=$unsafe (uint64(0) as ptr<array<uint8>>)
exact_preparation_bind=(exact_control_head:ptr<int64> exact_collect_writes:ptr<bool> effect_ix_nodes:ptr<int64> effect_ix_locals:ptr<int64> exact_marks:ptr<array<uint8>>):>int64=>{
    prepare_control_head=exact_control_head
    prepare_collect_writes=exact_collect_writes
    prepare_ix_nodes=effect_ix_nodes
    prepare_ix_locals=effect_ix_locals
    prepare_marks=exact_marks
    0
}

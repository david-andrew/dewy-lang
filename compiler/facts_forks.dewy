ForkWord:type=int64<overflow='wrap'>
# Closures and lazy bodies (not only a library call's inline callback) whose body owes a
# proof: the facts their creator knew of the values they capture by value and never assign
# seed the body, as `if step <=? 0 return` before `(i) => i // step`. The capture is a copy,
# so a later change of the outer binding does not reach it, and the body cannot change it.
# Creator function -> its closures' lambda nodes; the closures recorded under that rule.
# Filled by fact_seed_closures for one finalization. O(captures) per closure.
let fact_seed_lambdas:dict<int64 array<int64>>=[]
let fact_general_forks:dict<int64 bool>=[]
# (a library call's inline callback, which the call runs while it holds what the callback
# shares: the existing fork rules, whatever else it may be)
let fact_inline_forks:dict<int64 bool>=[]
# A key callback's receiver's refined element type, by the callback (0 when its records
# disagree): every element it is called with was stored as that type, so its parameter
# holds the contract (`idx.sorted(key=(v) => names[v])`).
let fact_key_elements:dict<int64 int64>=[]
# A key callback whose receiver is a field bounded by a sibling (`t.order.sort(key=(i) =>
# t.words[i])`), by the callback: its unchanged copy of that record and the field's type, or
# [0 0] when its records disagree. The copy holds the same sibling, so the parameter is below it.
let fact_key_records:dict<int64 [int64 int64]>=[]
fact_seed_reset=():>void=>{
    fact_key_records=[]
    fact_key_elements=[]
    fact_seed_lambdas=[]
    fact_general_forks=[]
    fact_inline_forks=[]
}
# The function creating closure f when the closure captures a value its creator's facts can
# describe, else 0. O(captures).
fact_seed_creator=(f:ForkWord):>ForkWord=>$unsafe {
    if f <=? 0 or f >=? fns.length or fns.ptr[f].kind not=? FK_LAMBDA and fns.ptr[f].kind not=? FK_GENERATOR {return 0}
    let lam=ForkWord(fns.ptr[f].decl)
    if lam <=? 0 or nodes.ptr[lam].kind not=? 'lambda' and nodes.ptr[lam].kind not=? 'lazy_' or has_flag(lam NF_GENERIC) or fact_fork_nodes.has(lam) {return 0}
    let creator:ForkWord=0
    loop cap in fns.ptr[f].caps {
        let o=int64(cap.outer)
        let inner=int64(cap.inner)
        if o <=? 0 or inner <=? 0 {continue}
        if fact_seed_capture(o inner) {creator=ForkWord(locals.ptr[o].owner)}
    }
    if creator =? f {return 0}
    creator
}
fact_seed_capture=(o:ForkWord inner:ForkWord):>bool=>$unsafe {
    let flags=ForkWord(locals.ptr[inner].flags)
    if flags & LF_VALUECAP =? 0 or flags & (LF_ASSIGNED | LF_ADDR | LF_SHARED | LF_EXPOSED) not=? 0 {return false}
    let t=fact_type(ForkWord(locals.ptr[o].type))
    tkind(t) =? 'array' or fact_scalar(t) and is_int(t) and t not=? T_U64
}
fact_seed_note=(creator:ForkWord lam:ForkWord):>void=>{
    let held=fact_seed_lambdas.get(creator) ?? []
    held.push(lam)
    fact_seed_lambdas[creator]=held
    fact_general_forks[lam]=true
}
# At a fork closure's creation: its captures' facts, by capture. O(k^2)
# bounded relaxations for k <= 16 captured terms. A general closure (fact_seed_lambdas) may
# be created at more than one evaluation: each record keeps only what every one gave.
fact_fork_record=(lam:ForkWord @s:FactState):>void=>$unsafe {
    let f=ForkWord(nodes.ptr[lam].sym)
    if f <=? 0 or f >=? fns.length {return}
    let general=fact_general_forks.has(lam) and not fact_inline_forks.has(lam)
    let entry=FactForkEntry()
    let values:array<int64>=[]
    loop cap in fns.ptr[f].caps {
        let o=int64(cap.outer)
        let inner=int64(cap.inner)
        if o <=? 0 or inner <=? 0 or values.length >=? 16 {continue}
        if general and not fact_seed_capture(o inner) {continue}
        let flags=ForkWord(locals.ptr[inner].flags)
        let t=fact_type(ForkWord(locals.ptr[o].type))
        let snapshot=flags & LF_VALUECAP not=? 0
        let array=tkind(t) =? 'array' and (snapshot or flags & LF_PARTBORROW not=? 0)
        let map=snapshot and flags & (LF_ASSIGNED | LF_ADDR | LF_SHARED | LF_EXPOSED) =? 0 and is_map_type(t) and not (ownership_decls.length not=? 0 and ownership_fact_type(t))
        if not array and not map and not (snapshot and fact_scalar(t) and is_int(t) and t not=? T_U64) {continue}
        let p=PlaceIdentity('local' ForkWord(locals.ptr[o].owner) o)
        let i=fact_binding(s p)
        let v:ForkWord=0
        if i >=? 0 {v=s.bindings[i].value}
        else {
            v=fact_new(@s fact_domain(t) FactTerm(type=t))
            fact_bind(@s p v)
        }
        if v =? 0 {continue}
        if array {v=fact_project(@s v (-1) false T_INT)}
        entry.inner.push(inner)
        entry.length.push(array)
        entry.maps.push(map)
        values.push(v)
    }
    loop v in values {entry.bounds.push(fact_bound(s v))}
    entry.values=values
    loop i in [0..values.length) {
        loop j in [0..values.length) {
            if i =? j or entry.maps[i] or entry.maps[j] {continue}
            let d=fact_shortest(s values[i] values[j])
            if d not=? FACT_MAX {entry.rows.push(FactDifference(i j d))}
        }
    }
    let previous=if general {fact_fork_entries.get(lam)} else {none}
    if previous not=? none {
        let before:FactForkEntry=previous
        if before.inner not=? entry.inner or before.length not=? entry.length {return}
        loop i in [0..entry.bounds.length) {entry.bounds[i]=fact_hull(before.bounds[i] entry.bounds[i] lam)}
        let kept:array<FactDifference>=[]
        loop r in entry.rows {
            loop q in before.rows {
                if q.a =? r.a and q.b =? r.b {kept.push(FactDifference(r.a r.b max(q.limit r.limit)))}
            }
        }
        entry.rows=kept
    }
    fact_fork_entries[lam]=entry
}
fact_parallel_array=(n:ForkWord):>bool=>$unsafe {
    if nodes.ptr[n].kind not=? 'call' or nodes.ptr[n].aux not=? 0 or nodes.ptr[n].sym <=? 0 or nkids(n) not=? 2 or nodes.ptr[kid(n 1)].kind not=? 'lambda' or has_flag(kid(n 1) NF_GENERIC) {return false}
    let d=ForkWord(fns.ptr[ForkWord(nodes.ptr[n].sym)].decl)
    if d =? 0 {return false}
    if fact_name_parallel_arrays.length =? 0 {fact_name_parallel_arrays=[intern("__dewy_parallel_collect") intern("__dewy_parallel_each") intern("parallel_map")]}
    if not (ForkWord(nodes.ptr[d].name) in? fact_name_parallel_arrays and pos_in_lib(nodes.ptr[d].pos)) {return false}
    if tkind(fact_type(ntype(kid(n 0)))) =? 'array' {return true}
    # (`[parallel i in [a..b) e]`: a range's positions, not parallel_map's)
    ForkWord(nodes.ptr[d].name) not=? fact_name_parallel_arrays[2] and fact_parallel_range_source(kid(n 0))
}
fact_parallel_range_source=(r:ForkWord):>bool=>$unsafe {
    nodes.ptr[r].kind =? 'call' and nkids(r) =? 5 and fact_library_call(r "__dewy_range")
}
# An endpoint read again for the range's positions: a literal or a name (reading it twice
# gives what the range read), else 0.
fact_parallel_endpoint=(e0:ForkWord):>ForkWord=>$unsafe {
    let e=e0
    loop nodes.ptr[e].kind =? 'conv' {e=ForkWord(nodes.ptr[e].a)}
    if nodes.ptr[e].kind =? 'int_lit' or nodes.ptr[e].kind =? 'ident' {return e}
    0
}
fact_parallel_endpoint_bound=(e:ForkWord @s:FactState):>FactBound=>$unsafe {
    if nodes.ptr[e].kind =? 'int_lit' {return FactBound(nodes.ptr[e].ival nodes.ptr[e].ival)}
    fact_bound(s fact_capture(e @s))
}
# The positions `__dewy_range(first second last stepped inclusive)` visits: from first up to
# last (before it unless inclusive), or, stepped, between the two. O(1).
fact_parallel_range_bound=(r:ForkWord @s:FactState t:ForkWord):>FactBound=>$unsafe {
    let domain=fact_domain(t)
    let first=fact_parallel_endpoint(kid(r 0))
    let last=fact_parallel_endpoint(kid(r 2))
    if first =? 0 or last =? 0 {return domain}
    let a=fact_parallel_endpoint_bound(first @s)
    let b=fact_parallel_endpoint_bound(last @s)
    if a.wide or b.wide {return domain}
    let stepped=kid(r 3)
    let inclusive=kid(r 4)
    let plain=nodes.ptr[stepped].kind =? 'bool_lit' and nodes.ptr[stepped].ival =? 0
    let closed=nodes.ptr[inclusive].kind not=? 'bool_lit' or nodes.ptr[inclusive].ival not=? 0
    let lo=if plain {a.lo} else {min(a.lo b.lo)}
    let hi=if plain {b.hi} else {max(a.hi b.hi)}
    if plain and not closed {
        if hi =? int64.min {return domain}
        hi=hi - 1
    }
    FactBound(max(lo domain.lo) min(hi domain.hi))
}
fact_parallel_record=(n:ForkWord @s:FactState base:ForkWord):>void=>$unsafe {
    if fact_speculating not=? 0 or fact_summary_owner not=? 0 or not fact_parallel_array(n) {return}
    let f=ForkWord(nodes.ptr[kid(n 1)].sym)
    if f <=? 0 or fns.ptr[f].params.length not=? 1 {return}
    let t=fact_type(ForkWord(locals.ptr[fns.ptr[f].params[0]].type))
    if not fact_scalar(t) or t =? T_U64 {return}
    let bound=fact_domain(t)
    if tkind(fact_type(ntype(kid(n 0)))) not=? 'array' {bound=fact_parallel_range_bound(kid(n 0) @s t)}
    else {
        let pi=fact_projection_find(s base FACT_ELEMENT_VALUE false)
        if pi >=? 0 {bound=fact_bound(s s.projections[pi].value)}
        let parts=fact_inventory(s base)
        if parts.length >? 0 {
            bound=fact_bound(s parts[0])
            loop i in [1..parts.length) {bound=fact_hull(bound fact_bound(s parts[i]) n)}
        }
    }
    # (an `int` parameter's unknown side is unbounded, not a 64-bit word's end)
    if prune(ForkWord(locals.ptr[fns.ptr[f].params[0]].type)) =? T_MATH_INT and (bound.lo =? int64.min or bound.hi =? int64.max) {bound.wide=true}
    let previous=fact_parallel_bounds.get(f)
    if previous not=? none {bound=fact_hull(previous bound n)}
    fact_parallel_bounds[f]=bound
}
fact_key_callback=(n:ForkWord):>ForkWord=>$unsafe {
    if nodes.ptr[n].kind not=? 'call' or nodes.ptr[n].aux not=? 0 or nodes.ptr[n].sym <=? 0 or nkids(n) <? 2 {return 0}
    let d=ForkWord(fns.ptr[ForkWord(nodes.ptr[n].sym)].decl)
    if d =? 0 or not pos_in_lib(nodes.ptr[d].pos) {return 0}
    if fact_key_names.length =? 0 {fact_key_names=[intern("sorted") intern("sorted_by") intern("sort") intern("sort_by") intern("min_by") intern("max_by") intern("group_by") intern("map") intern("filter")]}
    if ForkWord(nodes.ptr[d].name) not in? fact_key_names {return 0}
    let callback=kid(n 1)
    if nodes.ptr[callback].kind not=? 'lambda' or has_flag(callback NF_GENERIC) or nodes.ptr[callback].sym <=? 0 {return 0}
    let f=ForkWord(nodes.ptr[callback].sym)
    if fns.ptr[f].params.length not=? 1 {return 0}
    # (an array's elements, or a set's members: `d.keys.sorted(key=...)`)
    let receiver=fact_type(ntype(kid(n 0)))
    let element:ForkWord=if tkind(receiver) =? 'array' {telem(receiver)} else if is_dewy_set_type(receiver) {struct_targ(ForkWord(types.ptr[receiver].st) 0)} else {return 0}
    let t=fact_type(ForkWord(locals.ptr[fns.ptr[f].params[0]].type))
    # (or a record key that equals itself and hashes as it did: membership alone)
    if (not fact_scalar(t) or not is_int(t) or t =? T_U64) and t not=? T_STR and not fact_reflexive_key(t) {return 0}
    if t not=? fact_type(element) {return 0}
    callback
}
# Each record describes this call's receiver; another evaluation of the call
# hulls its bound and keeps only rows both give. O(captures).
fact_key_record=(n:ForkWord @s:FactState base:ForkWord):>void=>$unsafe {
    if fact_speculating not=? 0 or fact_summary_owner not=? 0 or base =? 0 {return}
    let lam=fact_key_callback(n)
    let f=ForkWord(nodes.ptr[lam].sym)
    let entry=fact_fork_entries.get(lam) ?? FactForkEntry()
    let t=fact_type(ForkWord(locals.ptr[fns.ptr[f].params[0]].type))
    let bound=fact_element_hull(@s base t)
    let parts=fact_inventory(s base)
    if parts.length >? 0 {
        bound=fact_bound(s parts[0])
        loop i in [1..parts.length) {bound=fact_hull(bound fact_bound(s parts[i]) n)}
    }
    let rows:array<FactDifference>=[]
    let below=fact_projection_find(s base FACT_ELEMENT_BELOW false)
    if below >=? 0 {
        let top=s.projections[below].value
        loop j in [0..entry.values.length) {
            let d=if entry.values[j] =? top {0} else {fact_shortest(s top entry.values[j])}
            if d not=? FACT_MAX and d >? FACT_MIN + 1 {rows.push(FactDifference((-1) j d - 1))}
        }
    }
    # (a self-length or sibling-bounded receiver's elements are below a length the callback
    # may capture: `order.sort(key=(i) => words[i])` after `words.length =? order.length`)
    let own=fact_projection_find(s base FACT_SELF_BOUND false)
    if own >=? 0 {fact_key_rows(@s fact_project(@s base (-1) false T_INT) fact_bound(s s.projections[own].value).hi entry @rows)}
    let sib=fact_projection_find(s base FACT_SIB_BOUND false)
    if sib >=? 0 {fact_key_rows(@s s.projections[sib].value 0 entry @rows)}
    # Membership crosses the closure boundary only for the identical
    # immutable dictionary snapshot, never a shared/mutable capture or name.
    # O(captures^2), capped at 16, using indexed key-source projections.
    let maps:array<int64>=[]
    let source=fact_projection_find(s base FACT_KEYS_SOURCE false)
    if source >=? 0 {
        let held=s.projections[source].value
        loop j in [0..entry.values.length) {
            if entry.maps[j] and entry.values[j] =? held {maps.push(entry.inner[j])}
        }
    }
    let previous=fact_key_params.get(f)
    if previous not=? none {
        bound=fact_hull(previous.bound bound n)
        let common:array<int64>=[]
        loop j in maps {
            if previous.maps.contains(j) {common.push(j)}
        }
        maps=common
        let kept:array<FactDifference>=[]
        loop r in rows {
            loop q in previous.rows {
                if q.b =? r.b {kept.push(FactDifference((-1) r.b max(q.limit r.limit)))}
            }
        }
        rows=kept
    }
    fact_key_params[f]=FactKeyParam(bound rows maps)
    let receiver=fact_type(ntype(kid(n 0)))
    let element:ForkWord=if tkind(receiver) =? 'array' {telem(receiver)} else if is_dewy_set_type(receiver) {struct_targ(ForkWord(types.ptr[receiver].st) 0)} else {0}
    if element not=? 0 and tkind(prune(element)) not=? 'refined' {element=0}
    let held=fact_key_elements.get(f)
    fact_key_elements[f]=if held not=? none and held not=? element {0} else {element}
    let record=fact_key_record_capture(kid(n 0) f)
    let known=fact_key_records.get(f)
    fact_key_records[f]=if known not=? none and known not=? record {[0 0]} else {record}
}
# The callback's unchanged copy of the record whose sibling-bounded field r is, and that
# field's type; else [0 0]. O(captures).
fact_key_record_capture=(r:ForkWord f:ForkWord):>[int64 int64]=>$unsafe {
    if not ref_self_active or nodes.ptr[r].kind not=? 'field' or nodes.ptr[r].aux <? 0 {return [0 0]}
    let t=prune(refine_storage(r ntype(r)))
    if not ref_sib_contract(t) {return [0 0]}
    let root=ForkWord(nodes.ptr[r].a)
    if nodes.ptr[root].kind not=? 'ident' or nodes.ptr[root].aux not=? int32(1) {return [0 0]}
    let o=ForkWord(nodes.ptr[root].sym)
    loop cap in fns.ptr[f].caps {
        if int64(cap.outer) not=? o or int64(cap.inner) <=? 0 {continue}
        let inner=int64(cap.inner)
        let flags=ForkWord(locals.ptr[inner].flags)
        if flags & LF_VALUECAP =? 0 or flags & (LF_ASSIGNED | LF_ADDR | LF_SHARED | LF_EXPOSED) not=? 0 {return [0 0]}
        return [inner t]
    }
    [0 0]
}
# The key parameter below each sibling bound of the receiver's field, read with the callback's
# copy of the record. O(fields + atoms).
fact_key_sibling=(@s:FactState f:ForkWord record:[int64 int64] value:ForkWord):>void=>$unsafe {
    let p=PlaceIdentity('local' f record[0])
    let i=fact_binding(s p)
    let held=if i >=? 0 {s.bindings[i].value} else {0}
    if held =? 0 {
        let t=ForkWord(locals.ptr[record[0]].type)
        held=fact_new(@s fact_domain(t) FactTerm(type=t))
        fact_bind(@s p held)
    }
    let args=fact_field_args(@s held)
    loop atom in ref_predicates[ForkWord(types.ptr[record[1]].st)] {
        if not ref_sib_atom(atom) or atom.b.kind not=? 5 {continue}
        let limit=ref_sib_limit(atom args @s)
        if limit not=? 0 {fact_difference(@s value limit 0 0 16)}
    }
}
# Every element is at most top + k: a row to each captured value top is within a known
# distance of. O(captures).
fact_key_rows=(@s:FactState top:ForkWord k:ForkWord entry:FactForkEntry @rows:array<FactDifference>):>void=>{
    # (offsets are written constants; both stay far from the ends of int64)
    let far=ForkWord(1) << 61
    if top =? 0 or k >=? far or k <=? -far {return}
    loop j in [0..entry.values.length) {
        if entry.maps[j] {continue}
        let d=if entry.values[j] =? top {0} else {fact_shortest(s top entry.values[j])}
        if d <? far and d >? -far {rows.push(FactDifference((-1) j d + k))}
    }
}
fact_fork_seed=(f:ForkWord @s:FactState):>void=>$unsafe {
    if fns.ptr[f].kind not=? FK_LAMBDA and fns.ptr[f].kind not=? FK_GENERATOR {return}
    let bound=fact_parallel_bounds.get(f)
    if bound not=? none {
        let l=fns.ptr[f].params[0]
        let value=fact_new(@s bound FactTerm(type=T_INT))
        fact_bind(@s PlaceIdentity('local' f l) value)
    }
    let entry=fact_fork_entries.get(ForkWord(fns.ptr[f].decl)) ?? FactForkEntry()
    let values:array<int64>=[]
    loop i in [0..entry.inner.length) {
        let inner=entry.inner[i]
        let p=PlaceIdentity('local' f inner)
        let capture_type=if entry.maps[i] {ForkWord(locals.ptr[inner].type)} else {T_INT}
        let v=fact_new(@s entry.bounds[i] FactTerm(type=capture_type))
        values.push(v)
        if entry.length[i] {
            let t=ForkWord(locals.ptr[inner].type)
            let array=fact_new(@s FactBound() FactTerm(type=t))
            if s.projections.length <? FACT_CAP {fact_add_projection(@s FactProjection(array (-1) false v))}
            fact_bind(@s p array)
        }
        else {fact_bind(@s p v)}
    }
    loop r in entry.rows {fact_difference(@s values[r.a] values[r.b] r.limit)}
    # (a constant a contract names is the copy this closure captured: ref_capture_links)
    if ref_named_locals.length >? 0 and fns.ptr[f].caps.length >? 0 {ref_capture_links(f @s)}
    let key=fact_key_params.get(f)
    if key not=? none {
        let l=fns.ptr[f].params[0]
        let value=fact_new(@s key.bound FactTerm(type=ForkWord(locals.ptr[l].type)))
        fact_bind(@s PlaceIdentity('local' f l) value)
        let et=fact_key_elements.get(f) ?? 0
        if et >? 0 {ref_assume(et value [] @s)}
        let record=fact_key_records.get(f) ?? [0 0]
        if record[0] >? 0 {fact_key_sibling(@s f record value)}
        loop r in key.rows {
            if r.b >=? 0 and r.b <? values.length {fact_difference(@s value values[r.b] r.limit 0 16)}
        }
        loop capture in key.maps {
            let j=entry.inner.index_of(capture) ?? (-1)
            if j >=? 0 and j <? values.length and s.projections.length <? FACT_CAP {
                fact_add_projection(@s FactProjection(value FACT_KEY_SOURCE false values[j]))
            }
        }
    }
}
# Both value-demanded and contract-only calls check actuals after their
# effects, in the same source evaluation order and with the same entry.
fact_call_arguments=(n:ForkWord @s:FactState):>array<int64>=>$unsafe {
    let values:array<int64>=fill(0 nkids(n))
    let pending=fact_pending.length
    loop i in call_eval_order(n) {
        let arg=kid(n i)
        if nodes.ptr[arg].kind =? 'conv' and nodes.ptr[arg].aux =? int32(int64(CV.refinement)) {
            let outer=fact_covered
            fact_covered=fact_refinement_covers(arg)
            values[i]=fact_capture(ForkWord(nodes.ptr[arg].a) @s)
            fact_covered=outer
        }
        # (an `int` text index's narrowing is the index's own obligation, as an array's)
        else if i =? 1 and nodes.ptr[arg].kind =? 'conv' and fact_string_call(n) =? 2 {
            let outer=fact_covered
            fact_covered=arg
            values[i]=fact_capture(arg @s)
            fact_covered=outer
        }
        else {values[i]=fact_capture(arg @s)}
        if ownership_decls.length not=? 0 and not (i =? 0 and fact_borrowed_receiver(n)) {values[i]=fact_owner_value(arg values[i] @s)}
        fact_pending.push(values[i])
    }
    nd_call_entry(n @s @values)
    loop i in [0..nkids(n)) {
        let arg=kid(n i)
        if nodes.ptr[arg].kind not=? 'conv' or nodes.ptr[arg].aux not=? int32(int64(CV.refinement)) {continue}
        # (a refined arm of this function's own result, made a union
        # member: its formals are this function's parameters)
        if nodes.ptr[n].aux =? 3 and nkids(n) =? 1 and ref_signature_has(fact_owner zonk(ForkWord(node_aux2(nodes.ptr[arg].op_ext)))) {ref_check(arg values[i] ref_fact_current_entry(@s) @s)}
        else {ref_check(arg values[i] values @s)}
    }
    nd_mutable_check(n @s values)
    fact_pending.truncate(pending)
    values
}
# Undemanded values still execute their effectful descendants. Ordinary calls
# apply the same settled write summary without requesting a numeric return
# summary. Control, obligations and opaque operations use the full transfer.
fact_slice_capture=(n:ForkWord @s:FactState):>ForkWord=>$unsafe {
    let k=nodes.ptr[n].kind
    if k =? 'call' {
        fact_capture(ForkWord(nodes.ptr[n].a) @s);
        if fact_slice_flags(n) & FACT_CONTRACT not=? 0 {fact_call_arguments(n @s);}
        else {
            loop i in call_eval_order(n) {
                let arg=kid(n i)
                let value=fact_capture(arg @s)
                if ownership_decls.length not=? 0 and not (i =? 0 and fact_borrowed_receiver(n)) {fact_owner_value(arg value @s);}
            }
        }
        let nd=fact_nd_call(n)
        if nd >=? 160 and fact_sequence_store_call(n) {fact_sequence_store(n @s n 'write')}
        else if nd not=? 0 and fact_nd_plain_store(n) {fact_nd_store(n @s n 'write')}
        else if nd not=? 0 and fact_nd_reads_only(n) {s=s}
        else if nodes.ptr[n].aux not=? 2 and nodes.ptr[n].aux not=? 3 {fact_path_call_effects(n @s)}
        if fact_ends_path(n) {s.live=false}
        return 0
    }
    if k =? 'vardecl' or k =? 'assign' {
        if k =? 'assign' and node_op(nodes.ptr[n].op_ext) not=? int32(47) {fact_capture(ForkWord(nodes.ptr[n].a) @s);}
        fact_capture(ForkWord(nodes.ptr[n].b) @s);
        if ownership_decls.length not=? 0 {fact_owner_value(ForkWord(nodes.ptr[n].b) 0 @s);}
        if k =? 'assign' {
            let route=fact_route(ForkWord(nodes.ptr[n].a) @s)
            if node_op(nodes.ptr[n].op_ext) =? int32(47) and fact_speculating =? 0 {
                if fact_probe_on {fact_probe_route(@s route fact_route_values(@s route))}
                else if fact_policy =? 'RequireStatic' or fact_query {fact_route_bounds(@s route fact_route_values(@s route))}
            }
        }
        return 0
    }
    # (a parallel region outside the slice still gives its callback's parameter what it
    # visits: a range's positions, or a named array's elements, read again here)
    if k =? 'parallel_region' {
        let call=ForkWord(nodes.ptr[n].a)
        if nodes.ptr[call].kind not=? 'call' or nkids(call) =? 0 {return 0}
        # (its source's own obligations first: a narrowed endpoint, an index)
        let source=kid(call 0)
        let value=fact_capture(source @s)
        if fact_parallel_array(call) {
            if tkind(fact_type(ntype(source))) not=? 'array' {fact_parallel_record(call @s 0)}
            else if nodes.ptr[source].kind =? 'ident' {fact_parallel_record(call @s value)}
        }
        return 0
    }
    let mask=isolation_children(k)
    if mask >? 0 {
        if mask & 1 not=? 0 {fact_capture(ForkWord(nodes.ptr[n].a) @s);}
        if mask & 2 not=? 0 {fact_capture(ForkWord(nodes.ptr[n].b) @s);}
        if mask & 4 not=? 0 {fact_capture(ForkWord(nodes.ptr[n].c) @s);}
        if mask & 16 not=? 0 {
            loop i in [0..nkids(n)) {fact_capture(kid(n i) @s);}
        }
    }
    return 0
}

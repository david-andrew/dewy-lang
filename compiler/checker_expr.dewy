# The expression dispatcher: an already checked node, then each kind sent to its
# leaf. A name is looked up here (the scope stack, then the module lookup cache);
# only a cache miss asks the host. A binary operator's operands are checked here and
# two plain numbers go to the numeric leaf; rare operators and every other operand
# type are host services, as are calls, a few rare kinds and literal preparation
# (grouped values, spreads, union members).
# Jo callers call `check_expr` directly; leaves below this one in the import order
# reach it through their host records. O(1) per node plus its kind's checking; host
# calls may grow every arena, so nodes are reread by ID.
XEWord:type=int64<overflow='wrap'>
CheckerExprInput:type=[
    nodes:ptr<array<Node>>
    types:ptr<array<TypeInfo>>
    files:ptr<array<SrcFile>>
    syms:ptr<array<Sym>>
    scopes:ptr<CheckerScope>
    contexts:ptr<array<FnCtx>>
    context:ptr<int64>
    ml_at:ptr<array<int64>>
    ml_mod:ptr<array<int64>>
    ml_sym:ptr<array<int64>>
    ml_tick:ptr<array<int64>>
    ml_struct:ptr<int64>
    sentinel:ptr<int64>
    temperature:ptr<bool>
    values:ptr<bool>
    watch:ptr<StatementWatch>
    last:ptr<int64>
    bool_type:ptr<int64>
    int_type:ptr<int64>
    u64_type:ptr<int64>
    math_int:ptr<int64>
    quantity_right:ptr<int64>
]
let xe_nodes:ptr<array<Node>>=$unsafe (uint64(0) as ptr<array<Node>>)
let xe_types:ptr<array<TypeInfo>>=$unsafe (uint64(0) as ptr<array<TypeInfo>>)
let xe_files:ptr<array<SrcFile>>=$unsafe (uint64(0) as ptr<array<SrcFile>>)
let xe_syms:ptr<array<Sym>>=$unsafe (uint64(0) as ptr<array<Sym>>)
let xe_scopes:ptr<CheckerScope>=$unsafe (uint64(0) as ptr<CheckerScope>)
let xe_contexts:ptr<array<FnCtx>>=$unsafe (uint64(0) as ptr<array<FnCtx>>)
let xe_context:ptr<int64>=$unsafe (uint64(0) as ptr<int64>)
let xe_ml_at:ptr<array<int64>>=$unsafe (uint64(0) as ptr<array<int64>>)
let xe_ml_mod:ptr<array<int64>>=$unsafe (uint64(0) as ptr<array<int64>>)
let xe_ml_sym:ptr<array<int64>>=$unsafe (uint64(0) as ptr<array<int64>>)
let xe_ml_tick:ptr<array<int64>>=$unsafe (uint64(0) as ptr<array<int64>>)
let xe_ml_struct:ptr<int64>=$unsafe (uint64(0) as ptr<int64>)
let xe_sentinel:ptr<int64>=$unsafe (uint64(0) as ptr<int64>)
let xe_temperature:ptr<bool>=$unsafe (uint64(0) as ptr<bool>)
let xe_values:ptr<bool>=$unsafe (uint64(0) as ptr<bool>)
let xe_watch:ptr<StatementWatch>=$unsafe (uint64(0) as ptr<StatementWatch>)
let xe_last:ptr<int64>=$unsafe (uint64(0) as ptr<int64>)
let xe_bool_type:ptr<int64>=$unsafe (uint64(0) as ptr<int64>)
let xe_int_type:ptr<int64>=$unsafe (uint64(0) as ptr<int64>)
let xe_u64_type:ptr<int64>=$unsafe (uint64(0) as ptr<int64>)
let xe_math_int:ptr<int64>=$unsafe (uint64(0) as ptr<int64>)
let xe_quantity_right:ptr<int64>=$unsafe (uint64(0) as ptr<int64>)
checker_expr_bind=(input:ptr<CheckerExprInput>):>XEWord=>$unsafe {
    xe_nodes=input[0].nodes
    xe_types=input[0].types
    xe_files=input[0].files
    xe_syms=input[0].syms
    xe_scopes=input[0].scopes
    xe_contexts=input[0].contexts
    xe_context=input[0].context
    xe_ml_at=input[0].ml_at
    xe_ml_mod=input[0].ml_mod
    xe_ml_sym=input[0].ml_sym
    xe_ml_tick=input[0].ml_tick
    xe_ml_struct=input[0].ml_struct
    xe_sentinel=input[0].sentinel
    xe_temperature=input[0].temperature
    xe_values=input[0].values
    xe_watch=input[0].watch
    xe_last=input[0].last
    xe_bool_type=input[0].bool_type
    xe_int_type=input[0].int_type
    xe_u64_type=input[0].u64_type
    xe_math_int=input[0].math_int
    xe_quantity_right=input[0].quantity_right
    0
}
# A name bound in the module (not a scope above the function's floor): the lookup
# cache's entry while its stamp for the name holds, else the host's lookup.
xe_module=(name:XEWord):>XEWord=>$unsafe {
    let c=xe_context[0]
    let m:XEWord=if c >=? 0 {XEWord(xe_contexts[0].ptr[c].mod)} else {-1}
    if name <? xe_ml_at[0].length {
        let stamp=if name <? xe_ml_tick[0].length and xe_ml_tick[0].ptr[name] >? xe_ml_struct[0] {xe_ml_tick[0].ptr[name]} else {xe_ml_struct[0]}
        if xe_ml_at[0].ptr[name] =? stamp and xe_ml_mod[0].ptr[name] =? m {return xe_ml_sym[0].ptr[name]}
    }
    expr_module(m name)
}
# A name from the current context: its scope binding above the function's floor, else
# the module's. Jo callers call it directly.
lookup=(name:XEWord):>XEWord=>$unsafe {
    let c=xe_context[0]
    let floor:XEWord=if c >=? 0 {XEWord(xe_contexts[0].ptr[c].floor)} else {0}
    if name <? xe_scopes[0].top.length {
        let i=xe_scopes[0].top.ptr[name]
        if i >=? floor {return xe_scopes[0].syms.ptr[i]}
    }
    xe_module(name)
}
# A call argument a for a parameter of type pt: checked with pt wanted, then coerced
# to it. Arguments of mutable parameters, values written with `@` (NF_MUT, 1) and
# coercions that change something are the host's (it skips the steps done here).
finish_arg=(a:XEWord pt:XEWord is_mut:bool):>void=>$unsafe {
    if is_mut {
        xe_arg(a pt true)
        return
    }
    if xe_nodes[0].ptr[a].kind =? 'hole' {
        xe_nodes[0][a].type=int32<overflow='wrap'>(pt)
        return
    }
    if (XEWord(xe_nodes[0].ptr[a].flags) & 128) =? 0 or xe_nodes[0].ptr[a].type =? 0 {
        check_expr(a pt);
        xe_nodes[0][a].flags=xe_nodes[0].ptr[a].flags | 128
    }
    if (XEWord(xe_nodes[0].ptr[a].flags) & 1) not=? 0 or not cq_settled(xe_nodes xe_types a pt) {xe_arg(a pt false)}
}
xe_arg=(a:XEWord pt:XEWord is_mut:bool):>void=>$unsafe {arg_finish_rest(a pt is_mut)}
# The call group's inputs beyond the dispatcher's: node lists, locals, the interned
# `members` (0 until reflection first asks) and `__dewy_set`; rare argument preparation
# (a `members(U)` argument, an array spreading a record) is the host's.
CheckerCallHost:type=[
    members:<(node:int64):>void>
    spread:<(node:int64):>void>
]
CheckerCallInput:type=[
    lists:ptr<array<int32>>
    locals:ptr<array<Local>>
    members_name:ptr<int64>
    set_name:ptr<int64>
    host:ptr<CheckerCallHost>
    names:ptr<array<string>>
    values_hit:ptr<array<bool>>
    spread_call:ptr<array<bool>>
    functions:ptr<array<FnInst>>
]
let xe_lists:ptr<array<int32>>=$unsafe (uint64(0) as ptr<array<int32>>)
let xe_locals:ptr<array<Local>>=$unsafe (uint64(0) as ptr<array<Local>>)
let xe_members_name:ptr<int64>=$unsafe (uint64(0) as ptr<int64>)
let xe_set_name:ptr<int64>=$unsafe (uint64(0) as ptr<int64>)
let xe_call_host:ptr<CheckerCallHost>=$unsafe (uint64(0) as ptr<CheckerCallHost>)
let xe_names:ptr<array<string>>=$unsafe (uint64(0) as ptr<array<string>>)
let xe_values_hit:ptr<array<bool>>=$unsafe (uint64(0) as ptr<array<bool>>)
let xe_spread_call:ptr<array<bool>>=$unsafe (uint64(0) as ptr<array<bool>>)
let xe_functions:ptr<array<FnInst>>=$unsafe (uint64(0) as ptr<array<FnInst>>)
checker_call_bind=(input:ptr<CheckerCallInput>):>XEWord=>$unsafe {
    xe_lists=input[0].lists
    xe_locals=input[0].locals
    xe_members_name=input[0].members_name
    xe_set_name=input[0].set_name
    xe_call_host=input[0].host
    xe_names=input[0].names
    xe_values_hit=input[0].values_hit
    xe_spread_call=input[0].spread_call
    xe_functions=input[0].functions
    0
}
xe_marked=(marks:ptr<array<bool>> a:XEWord):>bool=>$unsafe {a <? marks[0].length and marks[0].ptr[a]}
# An unchecked name argument that cannot give several values (check.jo values_candidate's
# false answers): written `@x` (NF_MUT 1), unbound, bound to neither a variable nor a
# function, or a local of a type that holds one value and is not callable. Globals and
# functions are the host's.
xe_one_value=(a:XEWord):>bool=>$unsafe {
    if (XEWord(xe_nodes[0].ptr[a].flags) & 1) not=? 0 {return true}
    let s=lookup(XEWord(xe_nodes[0].ptr[a].name))
    if s =? 0 {return true}
    let sk=xe_syms[0].ptr[s].kind
    if sk =? 'local' {
        let held=XEWord(xe_locals[0].ptr[XEWord(xe_syms[0].ptr[s].ref)].type)
        if held =? 0 {return true}
        let k=xe_kind_of(held)
        return k =? 'bool_' or k =? 'int_' or k =? 'float_' or k =? 'str_' or k =? 'array' or k =? 'enum_' or k =? 'fixed' or k =? 'range' or k =? 'vec' or k =? 'quantity' or k =? 'ptr'
    }
    sk not=? 'global' and sk not=? 'fns'
}
# check.jo values_call's common answer without the host: true when it would expand
# nothing and check nothing first (an operator's own `__f`/`$f`, or arguments that are
# checked or wait for their parameter, none spreading, packed or naming several values;
# `members(U)` arguments are the host's). O(arguments).
values_settled=(n:XEWord):>bool=>$unsafe {
    let callee=XEWord(xe_nodes[0].ptr[n].a)
    if xe_nodes[0].ptr[callee].kind =? 'ident' {
        let text=xe_names[0].ptr[XEWord(xe_nodes[0].ptr[callee].name)]
        if text.startswith("__") or (text.startswith("$") and text not=? "$") {return true}
    }
    let count=XEWord(xe_nodes[0].ptr[n].nlist)
    let base=XEWord(xe_nodes[0].ptr[n].list)
    let i:XEWord=0
    loop i <? count {
        let original=XEWord(xe_lists[0].ptr[base + i])
        i=i + 1
        let named=xe_nodes[0].ptr[original].kind =? 'namedarg'
        let a=original
        if named {a=XEWord(xe_nodes[0].ptr[original].a)}
        let k=xe_nodes[0].ptr[a].kind
        let flags=XEWord(xe_nodes[0].ptr[a].flags)
        if k =? 'call' {
            let m=xe_members_name[0]
            if m =? 0 or XEWord(xe_nodes[0].ptr[XEWord(xe_nodes[0].ptr[a].a)].name) =? m {return false}
        }
        if not named {
            if k =? 'tuple' and xe_nodes[0].ptr[a].aux =? 7 {return false}
            if (flags & 1024) not=? 0 or xe_marked(xe_values_hit a) {return false}
        }
        if (flags & 128) =? 0 {
            if k =? 'ident' {
                if not named and not xe_one_value(a) {return false}
            } else if k =? 'call' {
                if not ctx_dependent(a) and not xe_marked(xe_spread_call a) {return false}
            }
        }
    }
    true
}
# Before an overload is picked, each argument's literal shape is settled: set, record,
# map and Dewy array literals by their members; a function named as a value (a module
# function, or a Dewy function-typed local not written with `@`) is marked
# NF_FNREF_ARG (4096) so it is passed, not called. O(arguments and literal members);
# host calls may grow every arena, so nodes are reread by ID.
check_args_untyped=(args:array<int64>):>void=>$unsafe {
    let i:XEWord=0
    loop i <? args.length {
        xe_untyped(args[i])
        i=i + 1
    }
}
xe_untyped_kids=(n:XEWord):>void=>$unsafe {
    let base=XEWord(xe_nodes[0].ptr[n].list)
    let count=XEWord(xe_nodes[0].ptr[n].nlist)
    let i:XEWord=0
    loop i <? count {
        xe_untyped(XEWord(xe_lists[0].ptr[base + i]))
        i=i + 1
    }
}
xe_untyped_pairs=(n:XEWord):>void=>$unsafe {
    let base=XEWord(xe_nodes[0].ptr[n].list)
    let count=XEWord(xe_nodes[0].ptr[n].nlist)
    let i:XEWord=0
    loop i <? count {
        let pair=XEWord(xe_lists[0].ptr[base + i])
        xe_untyped(XEWord(xe_nodes[0].ptr[pair].a))
        xe_untyped(XEWord(xe_nodes[0].ptr[pair].b))
        i=i + 1
    }
}
# `__dewy_set(...)`, a set literal not yet checked.
xe_set_call=(a:XEWord):>bool=>$unsafe {
    let node=xe_nodes[0].ptr + a
    if node[0].type not=? 0 or node[0].nlist not=? 1 {return false}
    let callee=xe_nodes[0].ptr + XEWord(node[0].a)
    callee[0].kind =? 'ident' and XEWord(callee[0].name) =? xe_set_name[0]
}
# An array whose first member spreads (NF_SPREAD 1024) in Dewy may be a record literal.
xe_spread=(a:XEWord):>void=>$unsafe {
    let node=xe_nodes[0].ptr + a
    if node[0].b not=? 0 or node[0].nlist =? 0 {return}
    if (XEWord(xe_nodes[0].ptr[XEWord(xe_lists[0].ptr[XEWord(node[0].list)])].flags) & 1024) =? 0 {return}
    xe_call_host[0].spread(a)
}
xe_members=(a:XEWord):>void=>$unsafe {xe_call_host[0].members(a)}
xe_fn_kind=(t:XEWord):>bool=>$unsafe {
    let k=xe_kind_of(t)
    k =? 'fn_' or k =? 'cfn' or k =? 'polyfn' or k =? 'callable'
}
xe_untyped=(a0:XEWord):>void=>$unsafe {
    let a=a0
    if xe_nodes[0].ptr[a].kind =? 'namedarg' {a=XEWord(xe_nodes[0].ptr[a].a)}
    if xe_nodes[0].ptr[a].kind =? 'call' {
        let m=xe_members_name[0]
        if m =? 0 or XEWord(xe_nodes[0].ptr[XEWord(xe_nodes[0].ptr[a].a)].name) =? m {xe_members(a)}
        if xe_nodes[0].ptr[a].kind =? 'call' and xe_set_call(a) {
            xe_untyped_kids(a)
            return
        }
    }
    if xe_nodes[0].ptr[a].kind =? 'array' {xe_spread(a)}
    let k=xe_nodes[0].ptr[a].kind
    if k =? 'record_lit' {
        xe_untyped_kids(a)
        return
    }
    if k =? 'map_lit' and ctx_dependent(a) {
        xe_untyped_pairs(a)
        return
    }
    if k =? 'array' and xe_files[0][xe_nodes[0].ptr[a].pos >> 40].is_dewy and ctx_dependent(a) {
        xe_untyped_kids(a)
        return
    }
    let base=a
    if k =? 'typeapply' {base=XEWord(xe_nodes[0].ptr[a].a)}
    if not xe_flag(a 128) {
        let bk=xe_nodes[0].ptr[base].kind
        if bk =? 'ident' {xe_fnref(a base)}
        else if bk =? 'field' and xe_nodes[0].ptr[XEWord(xe_nodes[0].ptr[base].a)].kind =? 'ident' {xe_module_fn(a base)}
    }
    if ctx_dependent(a) or xe_flag(a 128) {return}
    check_expr(a 0);
    xe_add_flag(a 128)
}
# A function named alone; or a Dewy function-typed local named alone, not with `@`
# (NF_MUT 1): its parameter's type says whether that is a call or a mistaken `@`.
xe_fnref=(a:XEWord base:XEWord):>void=>$unsafe {
    let s=lookup(XEWord(xe_nodes[0].ptr[base].name))
    if s =? 0 {return}
    let sk=xe_syms[0].ptr[s].kind
    if sk =? 'fns' {xe_add_flag(a 4096)}
    else if sk =? 'local' and a =? base and not xe_flag(a 1) and xe_files[0][xe_nodes[0].ptr[a].pos >> 40].is_dewy and xe_fn_kind(XEWord(xe_locals[0].ptr[XEWord(xe_syms[0].ptr[s].ref)].type)) {xe_add_flag(a 4096)}
}
# `cm.step`: a module's function, checked with the parameter's type as a plain one is.
xe_module_fn=(a:XEWord base:XEWord):>void=>$unsafe {
    let ms=lookup(XEWord(xe_nodes[0].ptr[XEWord(xe_nodes[0].ptr[base].a)].name))
    if ms =? 0 or xe_syms[0].ptr[ms].kind not=? 'module' {return}
    let fs=expr_module(XEWord(xe_syms[0].ptr[ms].ref) XEWord(xe_nodes[0].ptr[base].name))
    if fs not=? 0 and xe_syms[0].ptr[fs].kind =? 'fns' {xe_add_flag(a 4096)}
}
# Frozen SK ordinals past `local`, the ABI checker_idents.dewy reads.
xe_kind=(k:SK):>XEWord=>{
    if k =? 'global' {return 2}
    if k =? 'fns' {return 3}
    if k =? 'struct_' {return 4}
    if k =? 'enum_' {return 5}
    if k =? 'const_' {return 6}
    if k =? 'module' {return 7}
    if k =? 'type_' {return 8}
    if k =? 'builtin' {return 9}
    if k =? 'alias_' {return 10}
    if k =? 'reflected' {return 11}
    0
}
# Cold host requests kept out of the name path's frame.
xe_complete=():>void=>$unsafe {expr_complete()}
xe_unknown=(n:XEWord expected:XEWord name:XEWord):>void=>$unsafe {ident_unknown(n expected name)}
# A name read after its leaf: a temperature difference, then several values.
xe_read=(n:XEWord t:XEWord):>XEWord=>$unsafe {
    let it=t
    if xe_temperature[0] {it=temperature_read(n it)}
    if xe_values[0] {expr_values_use(n it)}
    it
}
# A name read as a value: its scope binding above the current function's floor, else
# the module's; the identifier leaf reads the binding.
xe_ident=(n:XEWord expected:XEWord):>XEWord=>$unsafe {
    let nm=XEWord(xe_nodes[0].ptr[n].name)
    if xe_sentinel[0] not=? 0 and nm =? xe_sentinel[0] {xe_complete()}
    let c=xe_context[0]
    let floor:XEWord=if c >=? 0 {XEWord(xe_contexts[0].ptr[c].floor)} else {0}
    let s:XEWord=0
    let i:XEWord=if nm <? xe_scopes[0].top.length {xe_scopes[0].top.ptr[nm]} else {-1}
    if i >=? floor {s=xe_scopes[0].syms.ptr[i]} else {s=xe_module(nm)}
    if s =? 0 {xe_unknown(n expected nm)}
    let flags:XEWord=if xe_watch[0].const_views >? 0 {1} else {0}
    if xe_watch[0].decimal_globals >? 0 {flags=flags | 2}
    let sym=xe_syms[0].ptr + s
    let sk=sym[0].kind
    let kind:XEWord=if sk =? 'local' {1} else {xe_kind(sk)}
    let t=xj_ident(n expected kind XEWord(sym[0].ref) s flags).type
    if xe_temperature[0] or xe_values[0] {return xe_read(n t)}
    t
}
# Kinds below the commonest: literals, operators, conversions and aggregates in their
# leaves; lambdas, blocks, matches, ranges and the other rare kinds on the host.
xe_other=(n:XEWord expected:XEWord):>XEWord=>$unsafe {
    let k=xe_nodes[0].ptr[n].kind
    if k =? 'float_lit' or k =? 'bool_lit' or k =? 'none_lit' or k =? 'null_lit' {return xl_check_scalar(n expected)}
    let ex=xl_expected(expected)
    if k =? 'array' or (ex not=? 0 and (k =? 'map_lit' or k =? 'record_lit' or k =? 'tuple')) {ex=expr_literal(n expected ex)}
    let t:XEWord=0
    if k =? 'dotname' {t=xv_check(n ex)}
    else if k =? 'typeapply' {
        let r=xa_check(n expected ex)
        if r.bypass {return r.type}
        t=r.type
    } else if k =? 'unary' {
        let r=xu_check(n expected ex)
        if r.bypass {return r.type}
        t=r.type
    } else if k =? 'and_' or k =? 'or_' or k =? 'not_' {
        let r=xg_check(n expected ex)
        if r.bypass {return r.type}
        t=r.type
    } else if k =? 'istype' {t=xi_check(n)}
    else if k =? 'coalesce' or k =? 'unwrap' {
        let r=xo_check(n expected ex)
        if r.bypass {return r.type}
        t=r.type
    } else if k =? 'array' or k =? 'record_lit' {
        let r=xr_check(n expected ex)
        if r.bypass {return r.type}
        t=r.type
    } else if k =? 'map_lit' or k =? 'tuple' {
        let r=xk_check(n expected ex)
        if r.bypass {return r.type}
        t=r.type
    } else if k =? 'iflet' {t=xf_iflet(n ex)}
    else if k =? 'cast' {
        let r=xc_check(n expected)
        if r.bypass {return r.type}
        t=r.type
    } else if k =? 'addr' or k =? 'conv' or k =? 'fnref' or k =? 'parallel_region' or k =? 'hole' or k =? 'namedarg' {t=xp_check(n expected)}
    else {return expr_other(n expected)}
    xl_finish(n t expected)
}
# Binary operators (frozen Tok ordinals: kw_in 12, plus 58, minus 59, star 60, amp 63,
# pipe 64, caret 65, shl 67, shr 68, eq 69, ne 70, lt 71 ... ge 74, kw_xor 82, dotop 85).
xe_kind_of=(t:XEWord):>TK=>$unsafe {xe_types[0].ptr[tu_prune(t)].kind}
xe_flag=(n:XEWord f:XEWord):>bool=>$unsafe {XEWord(xe_nodes[0].ptr[n].flags) & f not=? 0}
xe_add_flag=(n:XEWord f:XEWord):>void=>$unsafe {xe_nodes[0][n].flags=int32<overflow='wrap'>(XEWord(xe_nodes[0].ptr[n].flags) | f)}
xe_dewy_at=(pos:int64):>bool=>$unsafe {
    let f=pos >> 40
    pos >? 0 and f <? xe_files[0].length and xe_files[0].ptr[f].is_dewy
}
# A one-character string literal (NF_CHARLIKE 512).
xe_charlike=(n:XEWord):>bool=>$unsafe {xe_nodes[0].ptr[n].kind =? 'str_lit' and xe_flag(n 512)}
# How a quantity operand was written, before it is checked (units.jo): `2 * m`, `-2 * m`.
xe_quantity_literal=(e:XEWord):>bool=>$unsafe {
    if e =? 0 or xe_flag(e 128) {return false}
    let node=xe_nodes[0].ptr + e
    if node[0].kind =? 'unary' {return xe_quantity_literal(XEWord(node[0].a))}
    if node[0].kind =? 'binary' and node[0].op =? 60 {
        let x=xe_nodes[0].ptr[XEWord(node[0].a)].kind
        return (x =? 'int_lit' or x =? 'float_lit') and xe_nodes[0].ptr[XEWord(node[0].b)].kind =? 'ident'
    }
    false
}
xe_quantity_name=(e:XEWord):>bool=>$unsafe {
    if e =? 0 or xe_flag(e 128) {return false}
    let k=xe_nodes[0].ptr[e].kind
    k =? 'ident' or (k =? 'field' and xe_nodes[0].ptr[XEWord(xe_nodes[0].ptr[e].a)].kind =? 'ident')
}
# A collection literal operand of `=? not=? & | ^ -` in Dewy, which takes the other side's type.
xe_literal_operand=(e:XEWord):>bool=>$unsafe {
    let node=xe_nodes[0].ptr + e
    let k=node[0].kind
    if k =? 'array' or k =? 'record_lit' or k =? 'map_lit' {return true}
    # (a set literal is the call `__dewy_set(...)`, not yet checked)
    k =? 'call' and node[0].type =? 0 and node[0].nlist =? 1 and xe_nodes[0].ptr[XEWord(node[0].a)].kind =? 'ident' and dewy_set_literal(e)
}
# `a xor b`: not=? on bools, ^ on integers.
xe_xor=(n:XEWord expected:XEWord):>XEWord=>$unsafe {
    let ta=tu_prune(check_expr(xe_nodes[0].ptr[n].a 0))
    xe_nodes[0][n].a=int32<overflow='wrap'>(xe_last[0])
    xe_add_flag(XEWord(xe_nodes[0].ptr[n].a) 128)
    xe_nodes[0][n].op=if ta =? xe_bool_type[0] {70} else {65}
    check_expr(n expected)
}
# 'a' =? c: the literal is a character code when the other side is an integer.
xe_char=(n:XEWord):>void=>$unsafe {
    if not xe_charlike(XEWord(xe_nodes[0].ptr[n].a)) or xe_charlike(XEWord(xe_nodes[0].ptr[n].b)) {return}
    let tb=check_expr(xe_nodes[0].ptr[n].b 0)
    xe_nodes[0][n].b=int32<overflow='wrap'>(xe_last[0])
    xe_add_flag(XEWord(xe_nodes[0].ptr[n].b) 128)
    if xe_kind_of(tb) =? 'int_' {binary_char_code(XEWord(xe_nodes[0].ptr[n].a))}
}
# `x in a..b` in its leaf, other memberships on the host.
xe_in=(n:XEWord expected:XEWord):>XEWord=>$unsafe {
    let b=XEWord(xe_nodes[0].ptr[n].b)
    if xe_nodes[0].ptr[b].kind =? 'range' and not xe_flag(b 32768) {
        let ordered=range_membership_ordered(n expected)
        if ordered >=? 0 {return ordered}
        return xy_check(n expected)
    }
    binary_membership(n expected)
}
# Cold requests out of the operator's frame.
xe_decimals=(a:XEWord b:XEWord):>void=>$unsafe {
    binary_decimal(a)
    binary_decimal(b)
}
xe_literal_hint=(e:XEWord t:XEWord op:XEWord hint:XEWord):>XEWord=>$unsafe {
    if not binary_context(e t op) {return hint}
    let p=tu_prune(t)
    if xe_types[0].ptr[p].kind =? 'opt' {return XEWord(xe_types[0].ptr[p].elem)}
    p
}
xe_first=(b:XEWord):>XEWord=>$unsafe {
    let t=tu_prune(check_expr(b 0))
    xe_add_flag(b 128)
    t
}
# Both operands checked here: the hint from the expected type (or a literal's other side),
# then the second operand in the first's type. Two plain numbers go to the numeric leaf;
# a secret, a quantity, text, an optional, a struct and every other pair to the host.
xe_binary=(n:XEWord expected:XEWord):>XEWord=>$unsafe {
    let op=XEWord(xe_nodes[0].ptr[n].op)
    if op =? 85 {return check_dotted(n expected)}
    if op =? 60 and xe_flag(n 536870912) {binary_juxt(n)}
    if op =? 82 {return xe_xor(n expected)}
    if op not=? 58 and op not=? 60 and xe_nodes[0].ptr[XEWord(xe_nodes[0].ptr[n].a)].kind =? 'str_lit' {xe_char(n)}
    if op =? 12 {return xe_in(n expected)}
    let is_cmp=op >=? 69 and op <=? 74
    let is_shift=op =? 67 or op =? 68
    let hint:XEWord=0
    if not is_cmp and expected not=? 0 {
        let ek=xe_kind_of(expected)
        if ek =? 'int_' or ek =? 'float_' or ek =? 'vec' {hint=expected}
        else if ek =? 'quantity' {hint=binary_quantity_hint(expected)}
    }
    let a=XEWord(xe_nodes[0].ptr[n].a)
    let b=XEWord(xe_nodes[0].ptr[n].b)
    if (op =? 69 or op =? 70) and xe_watch[0].decimal_adapted >? 0 {xe_decimals(a b)}
    let flags:XEWord=0
    if op =? 58 or op =? 59 {
        if xe_quantity_literal(a) {flags=1}
        if xe_quantity_literal(b) or (b =? xe_quantity_right[0] and b not=? 0) {flags=flags | 2}
    } else if op =? 60 {
        if xe_quantity_name(a) {flags=1}
        if xe_quantity_name(b) {flags=flags | 2}
        # ("-" * 40 is forty dashes: a character's code multiplied means nothing)
        let ca=xe_charlike(a)
        let cb=xe_charlike(b)
        if ca and not cb {xe_nodes[0][a].flags=xe_nodes[0].ptr[a].flags & ~512}
        if cb and not ca {xe_nodes[0][b].flags=xe_nodes[0].ptr[b].flags & ~512}
    }
    if op =? 58 {
        let ca=xe_charlike(a)
        let cb=xe_charlike(b)
        if ca {flags=flags | 4}
        if cb {flags=flags | 8}
        # ('a' + i: a character's code and a number, as i + 'a' is; the number decides)
        if ca and not cb and hint =? 0 and xe_flag(a 8) {
            let tb0=xe_first(b)
            if xe_types[0].ptr[tb0].kind =? 'int_' {hint=tb0}
        }
    }
    let literal_op=(op =? 69 or op =? 70 or op =? 63 or op =? 64 or op =? 65 or op =? 59) and xe_files[0][xe_nodes[0].ptr[n].pos >> 40].is_dewy
    let a_literal=literal_op and xe_literal_operand(a)
    let b_literal=literal_op and xe_literal_operand(b)
    # Type-checking the typed operand first supplies context without moving either
    # operand in the runtime expression or checking it twice.
    if a_literal and not b_literal {hint=xe_literal_hint(a xe_first(b) op hint)}
    let ta=tu_prune(check_expr(a hint))
    let tb:XEWord=0
    let bk=xe_nodes[0].ptr[b].kind
    if bk =? 'none_lit' or bk =? 'null_lit' or bk =? 'dotname' {tb=tu_prune(check_expr(b ta))}
    else {
        let h:XEWord=0
        let tk=xe_types[0].ptr[ta].kind
        if not xe_flag(a 256) and not is_shift and (tk =? 'int_' or tk =? 'float_') {
            h=ta
            # (exact_potential is pure: the cheaper test first)
            if is_cmp and (bk =? 'int_lit' or bk =? 'unary') and exact_potential(a) {h=if xe_flag(b 2097152) {xe_u64_type[0]} else {xe_int_type[0]}}
        }
        if not a_literal and b_literal {h=xe_literal_hint(b ta op h)}
        # (an n-dimensional array against, or times, an array written out)
        if bk =? 'array' and tk =? 'struct_' and (op =? 69 or op =? 70 or op =? 60) {h=binary_nd_hint(n ta h)}
        tb=tu_prune(check_expr(b h))
    }
    if xe_types[0].ptr[ta].kind =? 'secret' or xe_types[0].ptr[tb].kind =? 'secret' {return binary_secret(n a b)}
    # Static-width exact intermediates fused before scalar arithmetic is chosen.
    let mi=xe_math_int[0]
    if (XEWord(xe_nodes[0].ptr[a].type) =? mi or XEWord(xe_nodes[0].ptr[b].type) =? mi) and xe_dewy_at(xe_nodes[0].ptr[n].pos) {
        let wa=XEWord(exact_math_operand(a))
        let wb=XEWord(exact_math_operand(b))
        let ua=XEWord(xe_nodes[0].ptr[wa].type)
        let ub=XEWord(xe_nodes[0].ptr[wb].type)
        # Shifts keep their independent count type. Other operations need the
        # int64 join to preserve exact arithmetic after peeling the int boundary.
        if ua not=? mi and ub not=? mi and xe_word(ua) and xe_word(ub) and (is_shift or num_join(ua ub) =? xe_int_type[0]) {
            a=wa
            b=wb
            xe_nodes[0][n].a=int32<overflow='wrap'>(a)
            xe_nodes[0][n].b=int32<overflow='wrap'>(b)
            ta=tu_prune(ua)
            tb=tu_prune(ub)
        }
    }
    # Two plain numbers, neither a written fraction nor a character: the arithmetic.
    if not is_shift and ta not=? mi and tb not=? mi {
        let fka=xe_types[0].ptr[ta].kind
        let fkb=xe_types[0].ptr[tb].kind
        if (fka =? 'int_' or fka =? 'float_') and (fkb =? 'int_' or fkb =? 'float_') and not (op =? 69 and fka =? 'float_') {
            let ak=xe_nodes[0].ptr[a].kind
            let bk2=xe_nodes[0].ptr[b].kind
            if ak not=? 'float_lit' and bk2 not=? 'float_lit' and ak not=? 'str_lit' and bk2 not=? 'str_lit' {return xw_numeric(n int32<overflow='wrap'>(op) a b ta tb is_cmp)}
        }
    }
    binary_rest(n expected a b ta tb hint flags)
}
# An integer type without an overflow policy (types.jo is_int, int_policy).
xe_word=(t0:XEWord):>bool=>$unsafe {
    let t=tu_prune(t0)
    xe_types[0].ptr[t].kind =? 'int_' and (t =? xe_math_int[0] or xe_types[0].ptr[t].st =? 0)
}
# A call: a big integer literal's call form, an elementwise call, the destination hints
# of generated shape and map rows, the core library's unchecked `__at`, `@` partial
# evaluation and values to expand go first; check_call then picks and checks it, and the
# picked function's atomic, task, parallel, float-key and pack obligations are recorded.
# O(1) here plus the services; services may grow every arena, so nodes are reread by ID.
check_call_expr=(n:XEWord expected:XEWord):>XEWord=>$unsafe {
    let ex:XEWord=if expected =? 0 {0} else {xl_expected(expected)}
    if xe_nodes[0].ptr[n].aux2 =? -1 {
        let r=call_int_literal(n ex)
        if r >=? 0 {return r}
    }
    # NF_BROADCAST 16384
    if xe_flag(n 16384) {return check_dotted(n expected)}
    let callee=XEWord(xe_nodes[0].ptr[n].a)
    if ex not=? 0 and xe_nodes[0].ptr[callee].kind =? 'ident' {
        let count=XEWord(xe_nodes[0].ptr[n].nlist)
        if count =? 2 and (xe_types[0].ptr[ex].kind =? 'array' or is_nd(ex)) and xe_names[0].ptr[XEWord(xe_nodes[0].ptr[callee].name)] =? "__shape_value" {
            check_expr(xe_kid(n 0) ex);
            xe_set_kid(n 0 xe_last[0])
        }
        if count =? 1 and xe_names[0].ptr[XEWord(xe_nodes[0].ptr[callee].name)] =? "__map_of" {call_map_rows(n ex)}
    }
    if is_unchecked_at(n) {
        let xs=xe_kid(n 0)
        let i=xe_kid(n 1)
        xe_nodes[0][n].kind='index'
        xe_nodes[0][n].a=int32<overflow='wrap'>(xs)
        xe_nodes[0][n].b=int32<overflow='wrap'>(i)
        # NF_INBOUNDS 524288
        xe_add_flag(n 524288)
        return check_expr(n expected)
    }
    # AUX2_PARTIAL -10; NF_JUXT 536870912
    if xe_nodes[0].ptr[n].aux2 =? -10 {
        if xe_flag(n 536870912) and juxt_head_numeric(n) {juxt_factor(n);}
        return dewy_partial(n expected)
    }
    if xe_nodes[0].ptr[n].nlist >? 0 and xe_nodes[0].ptr[n].aux2 =? 0 and xe_dewy_at(xe_nodes[0].ptr[n].pos) and not xe_numeric_head(n) {
        if not values_settled(n) {
            let vt=values_call(n expected)
            if vt >=? 0 {return xl_finish(n vt expected)}
        }
    }
    let t=check_call(n expected)
    # (a call the check replaced, `int64(x)` of an int64 now x itself: its sym is not a function)
    if xe_nodes[0].ptr[n].kind not=? 'call' {return xl_finish(n t expected)}
    if xe_nodes[0].ptr[n].aux =? 2 and xe_nodes[0].ptr[n].nlist >? 1 and not xe_dewy_at(xe_nodes[0].ptr[n].pos) {dewy_data_after_give(n)}
    if xe_called(n) >? 0 {
        if xe_functions[0].ptr[xe_called(n)].atomic_api {concurrency_atomic_call(n)}
        if xe_functions[0].ptr[xe_called(n)].task_api {
            concurrency_tasks.push(n)
            concurrency_runtime_needed=true
        }
    }
    if xe_nodes[0].ptr[n].nlist =? 2 and xe_called(n) >? 0 and xe_functions[0].ptr[xe_called(n)].parallel_api {
        concurrency_calls.push(n)
        parallel_prepare(n)
    }
    if xe_called(n) >? 0 and xe_nodes[0].ptr[n].nlist >=? 1 and xe_dewy_at(xe_nodes[0].ptr[n].pos) {map_float_key(n)}
    if xe_called(n) >? 0 and xe_functions[0].ptr[xe_called(n)].pack not=? 0 {sink_pack_call(n)} else if xe_nodes[0].ptr[n].aux =? 1 and xe_fn_pack(callable_base(tu_prune(XEWord(xe_nodes[0].ptr[XEWord(xe_nodes[0].ptr[n].a)].type)))) {sink_pack_call(n)}
    xl_finish(n t expected)
}
# A call by its callee's kind: the head checks every call gets, then a type application,
# a name (its juxtaposed and len forms, the habit checks outside the library, the
# function picked by name, from a `p"..."` module when it names one), an enum variant,
# a member, a type or generic index, else the callee as a value. The named path runs
# here; the rest are services. O(arguments) plus the services.
check_call=(n:XEWord expected:XEWord):>XEWord=>$unsafe {
    let head=call_head(n expected)
    if head >=? 0 {return head}
    let callee=XEWord(xe_nodes[0].ptr[n].a)
    let ck=xe_nodes[0].ptr[callee].kind
    if ck =? 'typeapply' {return call_typeapply(n expected)}
    if ck =? 'ident' {
        let special=call_ident_special(n expected)
        if special >=? 0 {return special}
        let name=XEWord(xe_nodes[0].ptr[callee].name)
        let args=node_kids(@xe_nodes[0] @xe_lists[0] n)
        if not pos_in_lib(xe_nodes[0].ptr[n].pos) {habit_call_check(n name args)}
        # (path_literal_module answers a module or -1)
        return call_by_name(n name path_literal_module(n callee args) args expected false)
    }
    if ck =? 'dotname' {return call_dotname(n expected)}
    if ck =? 'field' {return call_member(n expected)}
    if ck =? 'index' {
        let indexed=call_index(n expected)
        if indexed >=? 0 {return indexed}
    }
    call_value(n expected)
}
# Receiver checking and member dispatch; O(arguments) plus the services. Save the
# type-receiver context across recursion, then use the receiver checking produced.
# Cold services retain diagnostics, type values, callable fields and name rewrites.
call_member=(n:XEWord expected:XEWord):>XEWord=>$unsafe {
    let callee=XEWord(xe_nodes[0].ptr[n].a)
    let args=node_kids(@xe_nodes[0] @xe_lists[0] n)
    if xe_flag(callee 536870912) {juxt_member_check(callee)}
    if xe_flag(n 536870912) and juxt_head_numeric(n) {
        juxt_product(n)
        return check_expr(n expected)
    }
    let recv=XEWord(xe_nodes[0].ptr[callee].a)
    let saved_receiver=type_receiver_at
    type_receiver_at=recv
    let rt:int64=tu_prune(check_expr(recv receiver_literal_hint(recv XEWord(xe_nodes[0].ptr[callee].name) args.length expected xe_nodes[0].ptr[n].pos)))
    type_receiver_at=saved_receiver
    recv=xe_last[0]
    xe_nodes[0][callee].a=int32<overflow='wrap'>(recv)
    let fname:int64=XEWord(xe_nodes[0].ptr[callee].name)
    let prepared=call_member_prepare(n callee recv @rt args expected)
    if prepared >=? 0 {return prepared}
    let rk=xe_types[0].ptr[rt].kind
    if rk =? 'module' {return call_by_name(n fname XEWord(xe_types[0].ptr[rt].mod) args expected false)}
    if rk =? 'typeval' {return call_member_type(n callee rt fname args expected)}
    if is_soa(rt) {return check_soa_method(n recv fname args expected)}
    if fname =? id_dewy_len {dewy_len_check(callee true rt recv)}
    if rk =? 'struct_' or rk =? 'ptr' {
        let field=call_member_callable(n callee recv rt fname args expected)
        if field >=? 0 {return field}
    }
    let tail=call_member_tail(n callee recv rt @fname @args expected)
    if tail >=? 0 {return tail}
    xe_add_flag(recv 128)
    let nl:array<int64>=[recv]
    loop a in args {nl.push(a)}
    node_set_list(@xe_nodes[0] @xe_lists[0] n nl)
    call_by_name(n fname -1 nl expected true)
}

# A call by name, from module mod_scope when it is one (else as the file sees the name), or
# a method's when ufcs: the core library's rewrites, array intrinsics, the name's symbol
# when it is not a function family (variables, constructors, conversions, builtins), then
# its families and the overload picked from them; no function of the name is an intrinsic
# or a diagnostic. The steps are services; O(1) here plus theirs.
call_by_name=(n:XEWord name:XEWord mod_scope:XEWord args:array<int64> expected:XEWord ufcs:bool):>XEWord=>$unsafe {
    let early=call_name_early(n name mod_scope args expected ufcs)
    if early >=? 0 {return early}
    let ii0=if intrinsic_of(name) <? 0 {-1} else {call_name_intrinsic(n intrinsic_of(name))}
    let hidden=ii0 =? -2
    let ii:XEWord=if hidden {-1} else {ii0}
    if ii >=? 0 and args.length >? 0 {
        let arr=call_name_array(n name mod_scope args expected ufcs ii)
        if arr >=? 0 {return arr}
    }
    let decls:array<int64>=[]
    if not ufcs {
        let s=if mod_scope >=? 0 {module_lookup(mod_scope name)} else {lookup(name)}
        # (a function family's symbol matters only for a type's conversion of one argument
        # and the library's take, release and relocate)
        if s not=? 0 and (xe_syms[0].ptr[s].kind not=? 'fns' or xe_fns_special(name args.length)) {
            let named=call_name_sym(n name mod_scope s args expected hidden @decls)
            if named >=? 0 {return named}
        }
    }
    let collected=call_name_collect(n name mod_scope args expected ufcs @decls)
    if collected >=? 0 {return collected}
    if decls.length =? 0 {return call_name_unknown(n name mod_scope args expected ufcs ii hidden)}
    resolve_fn_call(n name decls args expected 0 ufcs)
}
# Could a function family's symbol answer a call of count arguments (call_name_sym's kinds)?
xe_fns_special=(name:XEWord count:XEWord):>bool=>$unsafe {count =? 1 or (count =? 2 and (name =? take_name or name =? release_name)) or (count =? 3 and name =? relocate_name)}
xe_kid=(n:XEWord i:XEWord):>XEWord=>$unsafe {XEWord(xe_lists[0].ptr[XEWord(xe_nodes[0].ptr[n].list) + i])}
xe_set_kid=(n:XEWord i:XEWord v:XEWord):>void=>$unsafe {xe_lists[0][XEWord(xe_nodes[0].ptr[n].list) + i]=int32<overflow='wrap'>(v)}
# The function a call resolved to by name (aux 0), else 0.
xe_called=(n:XEWord):>XEWord=>$unsafe {if xe_nodes[0].ptr[n].aux =? 0 and xe_nodes[0].ptr[n].sym >? 0 {XEWord(xe_nodes[0].ptr[n].sym)} else {0}}
# A juxtaposed product headed by a number (`2 x`, `3 f.x`): not a call to expand.
xe_numeric_head=(n:XEWord):>bool=>$unsafe {
    if not xe_flag(n 536870912) {return false}
    let k=xe_nodes[0].ptr[XEWord(xe_nodes[0].ptr[n].a)].kind
    (k =? 'ident' or k =? 'field') and juxt_head_numeric(n)
}
# A function type that expresses several values (types.jo fn_type_pack).
xe_fn_pack=(t:XEWord):>bool=>$unsafe {xe_types[0].ptr[t].kind =? 'fn_' and xe_types[0].ptr[t].sign}
# Host records and Jo callers take machine words: the ABI of `(int, int) -> int`.
check_expr=(n0:int64 expected0:int64):>int64=>$unsafe {
    let n=XEWord(n0)
    let expected=XEWord(expected0)
    xe_last[0]=n
    let node=xe_nodes[0].ptr + n
    # NF_CHECKED 128: a node checked before keeps its type.
    if node[0].type not=? 0 and XEWord(node[0].flags) & 128 not=? 0 {return XEWord(node[0].type)}
    let k=node[0].kind
    if k =? 'ident' {return xe_ident(n expected)}
    if k =? 'int_lit' {return xl_check_int(n expected)}
    if k =? 'binary' {return xl_finish(n xe_binary(n expected) expected)}
    if k =? 'call' {return check_call_expr(n expected)}
    if k =? 'field' {return xs_field(n expected)}
    if k =? 'if_' {return xl_finish(n xf_if(n xl_expected(expected)) expected)}
    if k =? 'index' {
        let it=xs_index(n expected)
        if xe_watch[0].sibling_known not=? 0 {return expr_sibling(n it)}
        return it
    }
    if k =? 'str_lit' {return xl_check_str(n expected)}
    xe_other(n expected)
}
# Intrinsic calls: the node made an intrinsic, its arguments checked, its type. The
# common array intrinsics (len, cap, push, pop, clear), syscall, mem_copy, mem_set,
# panic and bytes are checked here; every other
# intrinsic, the soa and Dewy-text lengths, places, value-loop resizes, refinement
# length updates and diagnostics are host services. O(arguments) plus their checking;
# host calls may grow every arena, so nodes and types are reread by ID.
# Jo callers call `check_intrinsic` directly (frozen IN ordinals: len 1, push 2, pop 3,
# clear 6, syscall 9, memcpy 10, memset 11, panic 14, to_bytes 19, arrcap 27).
XNWord:type=int64<overflow='wrap'>
CheckerIntrinsicHost:type=[
    rest:<(node:int64 id:int64 args:array<int64> expected:int64):>int64>
    nargs:<(node:int64 count:int64 lo:int64 hi:int64 name:string):>void>
    error:<(node:int64 code:int64 type_id:int64):>void>
    coerce:<(node:int64 type_id:int64):>int64>
    length:<(node:int64 arg:int64 type_id:int64 expected:int64):>int64>
    resize:<(receiver:int64 operation:string pos:int64):>void>
    place:<(node:int64 for_mut:bool):>void>
    length_mutation:<(node:int64 type_id:int64):>int64>
]
CheckerIntrinsicInput:type=[
    nodes:ptr<array<Node>>
    lists:ptr<array<int32>>
    types:ptr<array<TypeInfo>>
    structs:ptr<array<StructInfo>>
    files:ptr<array<SrcFile>>
    value_loops:ptr<array<ValueLoop>>
    refine:ptr<bool>
    void_type:ptr<int64>
    int_type:ptr<int64>
    str_type:ptr<int64>
    u8_type:ptr<int64>
    rawptr_type:ptr<int64>
    never_type:ptr<int64>
    host:ptr<CheckerIntrinsicHost>
]
let xn_nodes:ptr<array<Node>>=$unsafe (uint64(0) as ptr<array<Node>>)
let xn_lists:ptr<array<int32>>=$unsafe (uint64(0) as ptr<array<int32>>)
let xn_types:ptr<array<TypeInfo>>=$unsafe (uint64(0) as ptr<array<TypeInfo>>)
let xn_structs:ptr<array<StructInfo>>=$unsafe (uint64(0) as ptr<array<StructInfo>>)
let xn_files:ptr<array<SrcFile>>=$unsafe (uint64(0) as ptr<array<SrcFile>>)
let xn_value_loops:ptr<array<ValueLoop>>=$unsafe (uint64(0) as ptr<array<ValueLoop>>)
let xn_refine:ptr<bool>=$unsafe (uint64(0) as ptr<bool>)
let xn_void_type:ptr<int64>=$unsafe (uint64(0) as ptr<int64>)
let xn_int_type:ptr<int64>=$unsafe (uint64(0) as ptr<int64>)
let xn_str_type:ptr<int64>=$unsafe (uint64(0) as ptr<int64>)
let xn_u8_type:ptr<int64>=$unsafe (uint64(0) as ptr<int64>)
let xn_rawptr_type:ptr<int64>=$unsafe (uint64(0) as ptr<int64>)
let xn_never_type:ptr<int64>=$unsafe (uint64(0) as ptr<int64>)
let xn_host:ptr<CheckerIntrinsicHost>=$unsafe (uint64(0) as ptr<CheckerIntrinsicHost>)
checker_intrinsics_bind=(input:ptr<CheckerIntrinsicInput>):>XNWord=>$unsafe {
    xn_nodes=input[0].nodes
    xn_lists=input[0].lists
    xn_types=input[0].types
    xn_structs=input[0].structs
    xn_files=input[0].files
    xn_value_loops=input[0].value_loops
    xn_refine=input[0].refine
    xn_void_type=input[0].void_type
    xn_int_type=input[0].int_type
    xn_str_type=input[0].str_type
    xn_u8_type=input[0].u8_type
    xn_rawptr_type=input[0].rawptr_type
    xn_never_type=input[0].never_type
    xn_host=input[0].host
    0
}
xn_kind=(t:XNWord):>TK=>$unsafe {xn_types[0].ptr[t].kind}
# Argument i checked (once) and coerced to expected (when one is wanted): its type.
xn_arg=(args:array<int64> i:XNWord expected:XNWord):>XNWord=>$unsafe {
    let a=args[i]
    if xn_nodes[0].ptr[a].kind =? 'namedarg' {xn_host[0].error(a 6 0)}
    if (XNWord(xn_nodes[0].ptr[a].flags) & 128) =? 0 or xn_nodes[0].ptr[a].type =? 0 {
        check_expr(a expected);
        xn_nodes[0][a].flags=xn_nodes[0].ptr[a].flags | 128
    }
    if expected not=? 0 and not cq_settled(xn_nodes xn_types a expected) {xn_host[0].coerce(a expected);}
    tu_prune(XNWord(xn_nodes[0].ptr[a].type))
}
# A receiver whose length changes: no loop over its value may be running, and it is a place.
xn_resized=(n:XNWord a:XNWord operation:string):>void=>$unsafe {
    if xn_value_loops[0].length >? 0 {xn_host[0].resize(a operation xn_nodes[0].ptr[n].pos)}
    xn_host[0].place(a false)
}
# A syscall argument: an integer (a literal or other width coerced to int), a pointer
# (null as a raw pointer) or a bool.
xn_syscall_arg=(args:array<int64> i:XNWord):>void=>$unsafe {
    let t=xn_arg(args i 0)
    let a=args[i]
    if (XNWord(xn_nodes[0].ptr[a].flags) & 256) not=? 0 {
        xn_host[0].coerce(a xn_int_type[0]);
        return
    }
    let k=xn_kind(t)
    if k =? 'null_' {xn_nodes[0][a].type=int32<overflow='wrap'>(xn_rawptr_type[0])}
    else if k =? 'int_' {
        if t not=? xn_int_type[0] {xn_host[0].coerce(a xn_int_type[0]);}
    } else if k not=? 'ptr' and k not=? 'bool_' {xn_host[0].error(a 9 0)}
}
check_intrinsic=(n:XNWord id:XNWord args:array<int64> expected:XNWord):>XNWord=>$unsafe {
    if id not=? 1 and id not=? 2 and id not=? 3 and id not=? 6 and id not=? 27 and id not=? 9 and id not=? 10 and id not=? 11 and id not=? 14 and id not=? 19 {return xn_host[0].rest(n id args expected)}
    xn_nodes[0][n].kind='intrinsic'
    xn_nodes[0][n].aux=int32<overflow='wrap'>(id)
    node_set_list(@xn_nodes[0] @xn_lists[0] n args)
    xn_nodes[0][n].a=0
    let nargs=XNWord(args.length)
    let r=xn_void_type[0]
    if id =? 1 or id =? 27 {
        if nargs not=? 1 {xn_host[0].nargs(n nargs 1 1 "len")}
        let t=xn_arg(args 0 0)
        let k=xn_kind(t)
        if (k =? 'struct_' and xn_structs[0].ptr[XNWord(xn_types[0].ptr[t].st)].soa_) or (id =? 1 and k =? 'str_' and xn_files[0][xn_nodes[0].ptr[n].pos >> 40].is_dewy) {return xn_host[0].length(n args[0] t expected)}
        if k not=? 'array' and k not=? 'str_' and not (id =? 1 and k =? 'fixed') {xn_host[0].error(n 1 t)}
        xn_nodes[0][n].type=int32<overflow='wrap'>(xn_int_type[0])
        return xn_int_type[0]
    }
    if id =? 2 {
        if nargs >? 2 {xn_host[0].error(n 2 0)}
        if nargs not=? 2 {xn_host[0].nargs(n nargs 2 2 "push")}
        let t=xn_arg(args 0 0)
        if xn_kind(t) not=? 'array' {xn_host[0].error(n 3 t)}
        xn_resized(n args[0] "push")
        xn_arg(args 1 XNWord(xn_types[0].ptr[t].elem));
    } else if id =? 3 {
        if nargs not=? 1 {xn_host[0].nargs(n nargs 1 1 "pop")}
        let t=xn_arg(args 0 0)
        if xn_kind(t) not=? 'array' {xn_host[0].error(n 4 t)}
        xn_resized(n args[0] "pop")
        r=XNWord(xn_types[0].ptr[t].elem)
    } else if id =? 6 {
        if nargs not=? 1 {xn_host[0].nargs(n nargs 1 1 "clear")}
        let t=xn_arg(args 0 0)
        if xn_kind(t) not=? 'array' {xn_host[0].error(n 5 t)}
        xn_resized(n args[0] "clear")
    } else if id =? 9 {
        if nargs <? 1 or nargs >? 7 {xn_host[0].error(n 8 0)}
        let i:XNWord=0
        loop i <? nargs {
            xn_syscall_arg(args i)
            i=i + 1
        }
        r=xn_int_type[0]
    } else if id =? 10 or id =? 11 {
        if nargs not=? 3 {
            if id =? 10 {xn_host[0].nargs(n nargs 3 3 "mem_copy")} else {xn_host[0].nargs(n nargs 3 3 "mem_set")}
        }
        if xn_kind(xn_arg(args 0 0)) not=? 'ptr' {xn_host[0].error(args[0] 7 0)}
        if id =? 10 {
            if xn_kind(xn_arg(args 1 0)) not=? 'ptr' {xn_host[0].error(args[1] 7 0)}
        } else {xn_arg(args 1 xn_int_type[0]);}
        xn_arg(args 2 xn_int_type[0]);
    } else if id =? 14 {
        if nargs >? 1 {xn_host[0].nargs(n nargs 0 1 "panic")}
        if nargs >? 0 {xn_arg(args 0 xn_str_type[0]);}
        r=xn_never_type[0]
    } else {
        if nargs not=? 1 {xn_host[0].nargs(n nargs 1 1 "bytes")}
        xn_arg(args 0 xn_str_type[0]);
        r=tb_mk_array(xn_u8_type[0])
    }
    xn_nodes[0][n].type=int32<overflow='wrap'>(r)
    if xn_refine[0] {return xn_host[0].length_mutation(n r)}
    r
}

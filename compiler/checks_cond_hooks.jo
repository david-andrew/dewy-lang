cond_returned = (changes: int, jumps: int, body: int) -> void: narrow_returned(changes, jumps, body)
cond_reset = (mark: int) -> void: scope_reset(mark)
cond_restore = (changes: int) -> void: cond_restored.push(narrow_restore(changes))
cond_merge = () -> void: narrow_merge(cond_restored.pop())
cond_promote = (first: int, limit: int) -> void: narrow_promote(first, limit)
cond_fill_subject = (cond: int, b: int) -> int:
    fill = opt_fill_subject(cond)
    if fill != 0: opt_fill_watch.push(OptFill(subject = i32(fill), block = i32(b)))
    fill
cond_fill_end = (b: int) -> bool:
    nl = int(opt_fill_watch.pop().alias)
    nl != 0 and int(locals[nl].flags) & LF_UNNARROWED == 0 and not stmt_terminates(b)
cond_then_literal = (b: int) -> int:
    if not literal_tree(block_tail(b)): return 0
    clone(block_tail(b))
cond_sink = (n: int, b: int) -> void: sink_arm(n, b)
cond_union = (a: int, b: int) -> int: mk_union([a, b])
# (both values take the expected type; without one, their join)
cond_join = (va: int, vb: int, ex: int, pos: int) -> int:
    if ex == 0: return join_types(va, vb, pos)
    coerce(va, ex)
    coerce(vb, ex)
    ex
cond_error = (n: int, t: int, code: int) -> void:
    if code == 1:
        cond = int(nodes[n].a)
        ex = t
        if not is_chain_end(cond): fatal(nodes[n].pos, "this `if` must give {a_type(ex)}, but it has no `else`")
        subject = if nodes[int(nodes[cond].a)].kind == .ident: "`{name_of(int(nodes[int(nodes[cond].a)].name))}`" else: "the value"
        fatal(nodes[n].pos, "this `if` must give {a_type(ex)}, but it has no `else`: when {subject} is not {a_type(resolve_type(int(nodes[cond].b)))}, it gives nothing (add `else` with a value, or a test for each remaining type)")
    if code == 2: fatal(nodes[n].pos, "an if expression needs an else branch")
    if code == 3: fatal(nodes[n].pos, "both branches of an if expression need a value")
    fatal(nodes[int(nodes[n].a)].pos, "'if let x = value' needs an optional value, found {dt(t)}")

use 'refine.jo'
use 'checker_expr.dewy'
use 'checker_tokens.dewy'
# Place-returning methods (docs/design/decisions.md: round 6, batch 13 and the small batch).
#
# A method whose body gives `@member` (inferred), or that is written `lock = () :> @T => ...`,
# lends a place inside its object. `let a = @(acct.lock())` takes it: `a` is a checked local
# place, the same as `let a = @acct.balance`, and what the method holds while lending it is
# released after the place's last use.
#
# Representation (ours): nothing outlives the caller's block, so no lifetime reaches the lowering.
# - The method's function gives, in place of the place, its guard: a record of the locals its
#   body declared before lending (or `true` when there are none). Its route from the object
#   (`balance`, `vault.balance`) is kept here; the caller re-applies it to the receiver, so the
#   place is a lexical alias of the receiver's member, every access re-evaluated from the root.
# - A method that may give another value first (`if held return Busy`) is split at its last such
#   return: `m` decides (`true` when it lends) and `m$acquire` makes the guard. Unions do not
#   hold resources yet, so the guard never travels in one.
# - The caller binds the guard to a hidden local and hands it to `__place_release` (dropping it)
#   right after the statement holding the place's last use; an earlier exit drops it with the
#   block. The place cannot be placed again, captured or returned, and its receiver cannot be
#   replaced, passed whole as a place, or lend a second place while it is live: all static,
#   lexical checks over the statements between the declaration and the last use.
use 'ast.jo'
use 'types.jo'
use 'check.jo'
use 'expr.jo'
use 'util.jo'
use 'sibling_types.jo'
use 'lex.jo'
use 'deadlock.jo'
use 'places.jo'

struct PlaceMethod:
    route: int[]          # member names from the object down to the place
    written: int = 0      # the written place type node (`:> @T`), 0 when inferred
    fails: bool = false   # may give another value first: `m` decides, `m$acquire` holds
    guards: int = 0       # locals held while the place is live (0: nothing to release)
    release: int = 0      # the name of the method dropping them, `m$release`
    at: int = 0           # where the method gives its place (a library's route is the library's)

place_methods: {int: PlaceMethod}   # method declaration -> how it lends its place
place_written: {int: int}           # function -> its written place type (dw_function)
place_call_decl = 0                 # the place method the last taken `@(...)` call resolved to
place_count = 0


# ---------------- calls ----------------

const AUX2_PLACE_TAKEN = -12      # a call `@(...)` whose place place_let/place_match take







place_hidden: int[]   # statements the receiver's binding made, to keep in the block











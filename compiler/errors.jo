# Nominal exception families share the existing tagged-union representation.
# The program's declarations are closed before signatures are checked, so parent
# storage can retain every concrete child's identity and complete payload.
use 'ast.jo'
use 'types.jo'
use 'util.jo'
use 'check.jo'
use 'expr.jo'
use 'ownership.jo'

exception_type = 0
error_type = 0
nominal_parent: {int: int}
nominal_types: int[]
nominal_ready = false
nominal_resolving: {int: bool}
nominal_families: {int: int}

exception_builtins = ():
    loop name in ["exception", "error", "Canceled", "Timeout", "OutOfMemory"]:
        d = mk(.struct_, 0)
        nodes[d].name = i32(intern(name))
        t = get_struct_inst(d, [])
        structs[int(types[t].st)].resolved = true
        universe[intern(name)] = new_sym(intern(name), .type_, t, d)
        nominal_types.push(t)
        if name == "exception": exception_type = t
        else if name == "error":
            error_type = t
            nominal_parent[t] = exception_type
        else: nominal_parent[t] = exception_type

nominal_descends = (t: int, parent: int) -> bool:
    current = t
    loop current != 0:
        if current == parent: return true
        current = nominal_parent.get(current, 0)
    false

exception_member = (t: int) -> bool:
    t == T_NONE or nominal_descends(t, exception_type)

# Flatten optionals as well as general unions for classification and forwarding.
value_members = (t: int) -> int[]:
    if tkind(t) == .opt: return [T_NONE] + value_members(telem(t))
    if is_union(t): return union_members(t)
    [t]

nominal_family = (t: int) -> int:
    if not nominal_ready or (t != exception_type and t != error_type and not nominal_parent.has(t)): return t
    if ownership_nominals.has(t): return t
    if let found = nominal_families.get(t): return found
    members: int[]
    loop child in nominal_types:
        if nominal_descends(child, t): members.push(child)
    if t == exception_type: members.push(T_NONE)
    result = mk_union(members)
    nominal_families[t] = result
    result

nominal_resolve = (t: int):
    if nominal_parent.has(t) or t == exception_type: return
    if nominal_resolving.get(t, false): fatal(nodes[int(structs[int(types[t].st)].decl)].pos, "nominal ancestry contains a cycle")
    nominal_resolving[t] = true
    d = int(structs[int(types[t].st)].decl)
    # (type of any: the root of a family of its own, minted under nothing)
    if mint_of_any(d):
        nominal_parent[t] = 0
        nominal_resolving[t] = false
        return
    saved = cx
    ctxs.push(FnCtx(i32(new_inst(FK_INIT, int(nodes[d].mod), "nominal")), -1, i32(T_VOID), false, 0, nodes[d].mod, i32(sc_names.len())))
    cx = ctxs.len() - 1
    parent = resolve_type(int(nodes[d].a))
    ctxs.pop()
    cx = saved
    if not nominal_types.contains(parent):
        if tkind(parent) != .struct_ or not ownership_declared(int(structs[int(types[parent].st)].decl)):
            if files[pos_file(nodes[d].pos)].is_dewy and tkind(parent) == .struct_:
                pn = dt(parent)
                fatal(nodes[d].pos, "`type of {pn}` needs a minted parent: start the family with `{pn}:type=type of any & [...]` (its fields and methods are inherited), or use `type of error` for errors")
            fatal(nodes[d].pos, "type of currently requires exception, error, or a nominal descendant")
        ownership_nominals[parent] = true
        ownership_nominals[t] = true
    else:
        nominal_resolve(parent)
        if ownership_nominals.has(parent): ownership_nominals[t] = true
    nominal_parent[t] = parent
    nominal_resolving[t] = false

mint_of_any = (d: int) -> bool:
    p = int(nodes[d].a)
    nodes[p].kind == .tname and name_of(int(nodes[p].name)) == "any" and nkids(p) == 0 and files[pos_file(nodes[d].pos)].is_dewy

prepare_nominals = ():
    loop m in modules:
        loop d in m.decls:
            if nodes[d].kind != .struct_: continue
            if not nominal_declaration(d): continue
            if nkids2(d) != 0: fatal(nodes[d].pos, "generic nominal types are not yet implemented")
            nominal_types.push(get_struct_inst(d, []))
    loop t in nominal_types: nominal_resolve(t)
    nominal_ready = true

# Dewy functions without a declared result: the exception kinds (not none) their
# returns and or_throw give, by instance, and the returns to give the joined result
infer_throws: {int: int[]} = {}
infer_returns: {int: int[]} = {}

# `return e` in such a function, e an exception (or a value-or-exception union): its
# kinds are thrown, joined to the result when the body is done (false: an ordinary value)
infer_throw = (s: int, t0: int) -> bool:
    f = int(ctxs[cx].inst)
    if not ctxs[cx].infer_ret or not infer_throws.has(f): return false
    t = prune(t0)
    members = value_members(t)
    thrown: int[]
    rest: int[]
    loop m in members:
        if m != T_NONE and exception_member(m): thrown.push(m)
        else: rest.push(m)
    if thrown.len() == 0: return false
    if rest.len() > 0:
        ret = prune(int(ctxs[cx].ret))
        value = if rest.len() == 1: rest[0] else: mk_union(rest)
        if tkind(ret) == .var: unify(ret, value)
        else if not can_coerce(0, value, ret): return false
    known = infer_throws[f]
    loop m in thrown:
        if not known.contains(m): known.push(m)
    infer_throws[f] = known
    infer_note_return(s)
    true

infer_note_return = (s: int):
    f = int(ctxs[cx].inst)
    returns = infer_returns[f]
    returns.push(s)
    infer_returns[f] = returns

# The result of a function that threw: its value part (void, never or a type) and
# the thrown kinds; every return gives it
infer_finish = (f: int, body: int) -> int:
    thrown = infer_throws[f]
    r = prune(int(ctxs[cx].ret))
    if thrown.len() == 0: return r
    members: int[]
    if r != T_NEVER:
        loop m in value_members(r): members.push(m)
    loop m in thrown: members.push(m)
    final = if members.len() == 1: members[0] else: mk_union(members)
    ctxs[cx].ret = i32(final)
    ctxs[cx].infer_ret = false
    loop s in infer_returns[f]:
        if nodes[s].a != 0: nodes[s].a = i32(coerce(int(nodes[s].a), final))
        else if union_has_void(final):
            check_expr(bc_block([], nodes[s].pos), final)
            nodes[s].a = i32(coerce(last_checked, final))
    n = nkids(body)
    if nodes[body].aux != 0: set_block_value(body, coerce(block_value(body), final))
    else if r == T_VOID and not (n > 0 and stmt_terminates(kid(body, n - 1))): void_arm_end(body, final)
    final

# A propagation is ordinary control flow, so gen_return performs all temporary,
# partial-expression, defer and enclosing-scope cleanup on the early path.
check_propagate = (n: int, expected: int) -> int:
    pos = nodes[n].pos
    inst = int(ctxs[cx].inst)
    # (a Dewy function without a declared result infers the kinds it throws)
    inferring = ctxs[cx].infer_ret and infer_throws.has(inst)
    if fns[inst].kind == FK_INIT or (ctxs[cx].infer_ret and not inferring):
        fatal(pos, "or_throw requires an enclosing function with a declared return type")
    at = prune(check_expr(int(nodes[n].a), 0))
    a = last_checked
    add_flag(a, NF_CHECKED)
    members = value_members(at)
    exceptions: int[]
    loop t in members:
        if not exception_member(t): continue
        if inferring and t == T_NONE: fatal(pos, "or_throw cannot propagate none from a function without a declared result type: declare it, as `:>T?`, or handle none here")
        if not inferring and not can_coerce(0, t, int(ctxs[cx].ret)):
            # (an optional result with errors: `none` is an exception too, so
            # keeping the optional takes a match that forwards only the errors)
            errors = ""
            loop m in members:
                if m != T_NONE and exception_member(m):
                    if errors != "": errors += " "
                    errors += "failure:{dt(m)} => return failure"
            if t == T_NONE and errors != "" and dewy_at(pos):
                fatal(pos, "or_throw cannot propagate none: it forwards every exception alternative, and `none` is one (`T?` is `T | none`), but the declared return type is {dt(int(ctxs[cx].ret))}; to forward only the errors and keep the optional, match the value: `match value \{ {errors} ... }`")
            fatal(pos, "or_throw cannot propagate {dt(t)}: the declared return type is {dt(int(ctxs[cx].ret))}")
        exceptions.push(t)
    if exceptions.len() == 0:
        nodes[n] = nodes[a]
        return check_expr(n, expected)
    name = "$propagate{n}"
    stmts = [bc_let(name, a, pos)]
    loop t in exceptions:
        ret = mk(.return_, pos)
        if t == T_NONE: nodes[ret].a = i32(mk(.none_lit, pos))
        else: nodes[ret].a = i32(bc_ident(name, pos))
        if exceptions.len() == members.len() and t == exceptions[exceptions.len() - 1]:
            stmts.push(ret)
            break
        condition = mk(.istype, pos)
        nodes[condition].a = i32(bc_ident(name, pos))
        nodes[condition].b = i32(type_node_of(t, pos))
        branch = mk(.if_, pos)
        nodes[branch].a = i32(condition)
        nodes[branch].b = i32(bc_block([ret], pos))
        add_flag(branch, NF_STMT)
        stmts.push(branch)
    if exceptions.len() != members.len(): stmts.push(bc_stmt(bc_ident(name, pos), pos))
    nodes[n] = nodes[bc_block(stmts, pos)]
    check_expr(n, expected)

# Read-only receiver navigation. Only the receiver forwards, never arguments.
# A narrowed concrete error still exposes its own payload fields normally.
forward_member = (n: int, receiver: int, t: int, expected: int) -> int:
    pos = nodes[n].pos
    # A method's own object (a family's member, seen through its parent) is read,
    # not forwarded: every member of the family has the parent's members.
    own = nodes[receiver].kind == .ident and starts_with(name_of(int(nodes[receiver].name)), "$self")
    if cur_assign != 0 and int(nodes[cur_assign].a) == n:
        if own: fatal(pos, "a method of a type with minted children cannot change its object yet")
        fatal(pos, "cannot assign through a union receiver; narrow it with is? first")
    name = "$receiver{n}"
    add_flag(receiver, NF_CHECKED)
    members = value_members(t)
    chain = 0
    j = members.len() - 1
    loop j >= 0:
        member = members[j]
        base = bc_ident(name, pos)
        value = base
        if member == T_NONE: value = mk(.none_lit, pos)
        else if own or not exception_member(member): value = bc_field(base, name_of(int(nodes[n].name)), pos)
        body = bc_block([bc_stmt(value, pos)], pos)
        if chain == 0: chain = body
        else:
            condition = mk(.istype, pos)
            nodes[condition].a = i32(bc_ident(name, pos))
            nodes[condition].b = i32(type_node_of(member, pos))
            branch = mk(.if_, pos)
            nodes[branch].a = i32(condition)
            nodes[branch].b = i32(body)
            nodes[branch].c = i32(chain)
            nodes[branch].aux2 = -8  # explicit union join, not numeric branch promotion
            chain = bc_block([bc_stmt(branch, pos)], pos)
        j -= 1
    nodes[n] = nodes[bc_block([bc_let(name, receiver, pos), bc_stmt(chain, pos)], pos)]
    check_expr(n, 0)

# A union or optional with an exception alternative and a value alternative.
forwards_exceptions = (t0: int) -> bool:
    t = prune(t0)
    if not is_union(t) and tkind(t) != .opt: return false
    exceptions = 0
    loop member in value_members(t):
        if member == T_NONE or exception_member(member): exceptions += 1
    exceptions > 0 and exceptions < value_members(t).len()

# `r.m(a)` with r forwarding: the receiver and then the arguments are
# evaluated once; an exception or none receiver is the result, any other
# alternative calls m. Only the receiver forwards, never arguments.
forward_call = (n: int, name: int, args: int[], expected: int) -> int:
    pos = nodes[n].pos
    receiver = unnamed(args[0])
    t = prune(ntype(receiver))
    recv = "$receiver{n}"
    add_flag(receiver, NF_CHECKED)
    stmts = [bc_let(recv, receiver, pos)]
    loop i in [1..args.len()):
        a = args[i]
        stmts.push(bc_let("$argument{n}_{i}", (if nodes[a].kind == .namedarg: int(nodes[a].a) else: a), pos))
    members = value_members(t)
    chain = 0
    j = members.len() - 1
    loop j >= 0:
        member = members[j]
        value = 0
        if member == T_NONE: value = mk(.none_lit, pos)
        else if exception_member(member): value = bc_ident(recv, pos)
        else:
            call_args = [bc_ident(recv, pos)]
            loop i in [1..args.len()):
                if nodes[args[i]].kind == .namedarg:
                    named = mk(.namedarg, nodes[args[i]].pos)
                    nodes[named].name = nodes[args[i]].name
                    nodes[named].a = i32(bc_ident("$argument{n}_{i}", pos))
                    call_args.push(named)
                else: call_args.push(bc_ident("$argument{n}_{i}", pos))
            value = bc_call(name_of(name), call_args, pos)
        body = bc_block([bc_stmt(value, pos)], pos)
        if chain == 0: chain = body
        else:
            condition = mk(.istype, pos)
            nodes[condition].a = i32(bc_ident(recv, pos))
            nodes[condition].b = i32(type_node_of(member, pos))
            branch = mk(.if_, pos)
            nodes[branch].a = i32(condition)
            nodes[branch].b = i32(body)
            nodes[branch].c = i32(chain)
            nodes[branch].aux2 = -8  # explicit union join, not numeric branch promotion
            chain = bc_block([bc_stmt(branch, pos)], pos)
        j -= 1
    stmts.push(bc_stmt(chain, pos))
    nodes[n] = nodes[bc_block(stmts, pos)]
    check_expr(n, expected)

family_annotation = (t: int) -> bool:
    if not is_union(t) and tkind(t) != .opt: return false
    loop parent, family in nominal_families:
        if family == t: return true
    false

nominal_declaration = (d: int) -> bool:
    # Sloppy library metadata is explicit, and ignored by the C seed.
    if nodes[d].c != 0:
        loop attr in kids(int(nodes[d].c)):
            if name_of(int(nodes[attr].name)) == "nominal":
                a = int(nodes[attr].a)
                if nodes[a].kind != .ident: fatal(nodes[attr].pos, "nominal metadata requires a parent type")
                ty = mk(.tname, nodes[a].pos)
                nodes[ty].name = nodes[a].name
                nodes[d].a = i32(ty)
    nodes[d].a != 0

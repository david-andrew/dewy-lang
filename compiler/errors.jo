use 'checker_expr.dewy'
use 'checker_propagate.dewy'
use 'checker_state.dewy'
# Nominal exception families share the existing tagged-union representation.
# The program's declarations are closed before signatures are checked, so parent
# storage can retain every concrete child's identity and complete payload.
use 'ast.jo'
use 'types.jo'
use 'util.jo'
use 'check.jo'
use 'expr.jo'
use 'ownership.jo'
use 'oom.jo'
use 'ownership_types.dewy'
use 'error_ops.dewy'

exception_type = 0
error_type = 0
out_of_memory_type = 0
nominal_parent: {int: int}
nominal_types: int[]
nominal_ready = false
nominal_resolving: {int: bool}
nominal_families: {int: int}

# Generic nominal types (`Unsent[T]`, lib/prelude/outcomes.jo), by declaration: their parent, a
# builtin family or a nongeneric nominal type. Each instance descends from it once made
# (nominal_instance), so it forwards and matches as the family's; but a family's union is
# closed before checking, so it holds no instance: a task failing with one reports its
# `reason` to its group (concurrency_report).
nominal_generic: {int: int}

# Dewy functions without a declared result: the exception kinds (not none) their
# returns and or_throw give, by instance, and the returns to give the joined result
infer_throws: {int: int[]} = {}
infer_returns: {int: int[]} = {}

propagate_host = CheckerPropagateHost(check_expr, propagate_inferring, value_members, exception_member, can_coerce, propagate_rewrite, propagate_error)
propagate_input = CheckerPropagateInput(&nodes, &fns, &ctxs, &cx, &last_checked, &T_NONE, &propagate_host)
propagate_binding = checker_propagate_bind(&propagate_input)


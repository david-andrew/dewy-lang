exact_reserve = (n: int):
    if n >= exact_marks.len(): exact_marks.resize(max(n + 1, exact_marks.len() * 2 + 64))
exact_shader_calls = (n: int, work: mut int[]):
    if n == 0: return
    k = nodes[n].kind
    if k == .call and nodes[n].aux == 0 and nodes[n].sym > 0: work.push(int(nodes[n].sym))
    mask = isolation_children(k)
    if mask < 0: return
    if mask & 1 != 0: exact_shader_calls(int(nodes[n].a), work)
    if mask & 2 != 0: exact_shader_calls(int(nodes[n].b), work)
    if mask & 4 != 0: exact_shader_calls(int(nodes[n].c), work)
    if mask & 16 != 0:
        loop i in [0..nkids(n)): exact_shader_calls(kid(n, i), work)

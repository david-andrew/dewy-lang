from p"diagnostic_exit.dewy" import fatal
$runtime_checks

from p"ast.jo" import nodes
from p"check.jo" import modules
from p"directives.jo" import (dir_module_start dir_program_any dir_program_values dir_rules_from_host dir_scopes)
from p"settings.jo" import settings_path
from p"util.jo" import (files intern name_of pos_file)
# Entry headers supply the outermost runtime defaults. Imported headers cannot
# pick the importer's policy; functions install their own frames at entry.
dir_program_setting=(name:string):>bool=>{
    name =? "time.zone" or name =? "time.rules" or name =? "time.zone_source" or name =? "time.gap" or name =? "time.fold" or name =? "program.max_cores"
}
# O(module declarations + settings), with no call inventory or per-function map.
dir_program_prepare=():>void=>$unsafe {
    if not dir_program_any {return}
    dir_program_values=dict<int64 int64>()
    dir_rules_from_host=false
    let entry_main:int64=0
    let main_name=intern("main")
    loop m in modules {
        if files[int64(m.file)].path not=? settings_path {continue}
        loop d in m.decls {
            if nodes.ptr[d].kind =? 'fn_' and nodes.ptr[d].name =? int32(main_name) and nodes.ptr[d].b not=? 0 and files[pos_file(nodes.ptr[d].pos)].path =? settings_path {
                entry_main=nodes.ptr[int64(nodes.ptr[d].b)].pos
            }
        }
    }
    loop i in [0..dir_scopes.length) {
        let s=dir_scopes[i]
        let name=name_of(s.setting)
        if not dir_program_setting(name) {continue}
        let header=s.start =? dir_module_start(pos_file(s.start))
        let legacy=s.start =? entry_main and s.value >=? 2
        if (name =? "program.max_cores" or name =? "time.rules" or name =? "time.zone_source") and not header and not legacy {
            fatal(s.at "scoped `${name}` is not yet supported; use a literal setting at the top of the entry file or its main body")
        }
        if files[pos_file(s.start)].path not=? settings_path {continue}
        # Keep the existing entry-main forms process-wide until scoped caps and packs land.
        if legacy and (name =? "time.rules" or name =? "program.max_cores" or name =? "time.zone_source") {
            dir_program_values[s.setting]=i
            if name =? "time.zone_source" {dir_rules_from_host=true}
        }
        if not header {continue}
        dir_program_values[s.setting]=i
        if name =? "time.zone_source" {dir_rules_from_host=true}
    }
}
dir_program_finalize=():>void=>dir_program_prepare()

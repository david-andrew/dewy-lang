use 'source_queries.dewy'
# Frozen recursive lowering from ir.jo.
use 'ir_types.dewy'
use 'ir.jo'
use 'util.jo'
use 'diagnostic_exit.dewy'

ir_fn_has_loop: bool[]

mem_index = (ins: Ins) -> int:
    if int(ins.c) & M_INDEX == 0: return -1
    if ins.op == .store: return int(ins.dst)
    int(ins.b)


mem_scale = (ins: Ins) -> int: (int(ins.c) >> 8) & 3


ir_begin = (name: str, fn_index: int):
    ir.name = name
    ir.nparams = 0
    ir.ret = -1
    ir.vtypes.clear()
    ir.slot_size.clear()
    ir.slot_align.clear()
    ir.code.clear()
    ir.args.clear()
    ir.cabi = false
    ir.noinline = false
    ir.export_name = ""
    ir.fn_index = fn_index
    if fn_index >= 0:
        if fn_index >= ir_fn_has_loop.len():
            ir_fn_has_loop.resize(fn_index + 64)
        ir_fn_has_loop[fn_index] = false
    ir.raw_mem = false
    ir.kval.clear()
    ir.decl_pos = 0
    ir.dbg_locals.clear()
    if ir.code.cap() < 48: ir.code.reserve(48)
    if ir.vtypes.cap() < 48: ir.vtypes.reserve(48)
    if ir.args.cap() < 16: ir.args.reserve(16)
    if ir.kval.cap() < 48: ir.kval.reserve(48)
    kc_fn += 1


vreg = (ty: int) -> int:
    idx = ir.vtypes.len()
    ir.vtypes.push(i8(ty))
    idx


vtype = (v: int) -> int:
    t = int(ir.vtypes[v])
    if t == VK: return VI
    t


is_kv = (v: int) -> bool: int(ir.vtypes[v]) == VK

kv_of = (v: int) -> int: ir.kval[v]


k_vreg = (v: int) -> int:
    slot = ((v xor (v >> 8))) & 255
    if kc_epoch[slot] == kc_fn and kc_val[slot] == v: return kc_reg[slot]
    d = k_vreg_new(v)
    kc_epoch[slot] = kc_fn
    kc_val[slot] = v
    kc_reg[slot] = d
    d


k_vreg_new = (v: int) -> int:
    d = ir.vtypes.len()
    ir.vtypes.push(i8(VK))
    old = ir.kval.len()
    if old <= d:
        need = d + 1
        kp = data(ir.kval)
        if kp == null or (kp - 3)[0] != 1 or (kp - 3)[2] < need:
            ir.kval.reserve(max(need, ir.kval.cap() * 2))
            kp = data(ir.kval)
        if d > old: mem_set((kp + old) as *u8, 0, (d - old) * 8)
        (kp - 3)[1] = need
        kp[d] = v
        return d
    ir.kval[d] = v
    d


ir_fits32 = (v: int) -> bool: v >= -2147483648 and v <= 2147483647


new_slot = (size: int, align: int) -> int:
    ir.slot_size.push(i32(size))
    a = align
    if a < 8: a = 8
    ir.slot_align.push(i32(a))
    ir.slot_size.len() - 1


ir_line_fill = ():
    npos = ir_positions.len()
    old_n = ir_lines.len()
    if old_n > npos:
        ir_lines.clear()
        old_n = 0
    if old_n >= npos: return
    ir_lines.resize(npos)
    lf = -1
    li = 0
    ls_p: *int = null
    ls_n = 0
    pos_p = data(ir_positions)
    line_p = data(ir_lines)
    nfiles = files.len()
    start_k = if old_n > 1: old_n else: 1
    loop k in [start_k..npos):
        p = pos_p[k]
        f = pos_file(p)
        if f < 0 or f >= nfiles: continue
        off = pos_off(p)
        if f != lf:
            line_col(p)
            ls_p = data(src_lines.starts[f])
            ls_n = src_lines.starts[f].len()
            lf = f
            li = 0
        if off < ls_p[li] or (li + 4 < ls_n and off >= ls_p[li + 4]):
            lo = 0
            hi = ls_n
            loop lo + 1 < hi:
                mid = (lo + hi) >> 1
                if ls_p[mid] <= off: lo = mid
                else: hi = mid
            li = lo
        else:
            loop li + 1 < ls_n and ls_p[li + 1] <= off: li += 1
        line_p[k] = li + 1


ir_line = (i: int) -> int:
    if ir_lines.len() != ir_positions.len(): ir_line_fill()
    if i <= 0 or i >= ir_lines.len(): return 0
    ir_lines[i]


ir_set_pos = (p: int):
    if p == 0: return
    if ir_positions[ir_pos] == p: return
    ir_positions.push(p)
    ir_pos = ir_positions.len() - 1


emit = (op: Op, ty: int, dst: int, a: int, b: int, c0: int, imm: int) -> int:
    c = c0
    if ir_cold and op == .call and c == 0: c = 2
    idx = ir.code.len()
    ir.code.push(Ins(op, i32(ty), i32(dst), i32(a), i32(b), i32(c), imm, i32(ir_pos)))
    idx


e_iconst_wide = (v: int) -> int:
    d = ir.vtypes.len()
    ir.vtypes.push(i8(VI))
    ir.code.push(Ins(.iconst, i32(VI), i32(d), 0, 0, 0, v, i32(ir_pos)))
    d


e_iconst = (v: int) -> int:
    if ir_fits32(v): return k_vreg(v)
    e_iconst_wide(v)


e_fconst = (f: f64, ty: int) -> int:
    d = ir.vtypes.len()
    ir.vtypes.push(i8(ty))
    bits = int(f64_bits(f))
    if ty == VS: bits = int(f32_bits(f32(f)))
    ir.code.push(Ins(.fconst, i32(ty), i32(d), 0, 0, 0, bits, i32(ir_pos)))
    d


e_bin_ret_type = (op: Op, ty: int) -> int:
    match op:
        feq, fne, flt, fle, fgt, fge, eq, ne, lts, les, gts, ges, ltu, leu, gtu, geu: VI
        _: ty


e_bin = (op: Op, ty: int, a: int, b: int) -> int:
    rt = if ty == VI: VI else: e_bin_ret_type(op, ty)
    d = ir.vtypes.len()
    ir.vtypes.push(i8(rt))
    ir.code.push(Ins(op, i32(ty), i32(d), i32(a), i32(b), 0, 0, i32(ir_pos)))
    d


e_un = (op: Op, ty: int, a: int) -> int:
    d = ir.vtypes.len()
    ir.vtypes.push(i8(ty))
    ir.code.push(Ins(op, i32(ty), i32(d), i32(a), 0, 0, 0, i32(ir_pos)))
    d


e_mov = (dst: int, src: int) -> int:
    t = int(ir.vtypes[dst])
    if t == VK: ice("assignment to a constant vreg")
    idx = ir.code.len()
    ir.code.push(Ins(.mov, i32(t), i32(dst), i32(src), 0, 0, 0, i32(ir_pos)))
    idx


e_addi = (a: int, k: int) -> int:
    if k == 0: return a
    kv = e_iconst(k)
    d = ir.vtypes.len()
    ir.vtypes.push(i8(VI))
    ir.code.push(Ins(.add, i32(VI), i32(d), i32(a), i32(kv), 0, 0, i32(ir_pos)))
    d


e_load = (ty: int, addr: int, off: int, mode: int) -> int:
    d = ir.vtypes.len()
    ir.vtypes.push(i8(ty))
    ir.code.push(Ins(.load, i32(ty), i32(d), i32(addr), 0, i32(mode), off, i32(ir_pos)))
    d


e_store = (addr: int, off: int, val: int, mode: int) -> int:
    t = int(ir.vtypes[val])
    if t == VK: t = VI
    idx = ir.code.len()
    ir.code.push(Ins(.store, i32(t), 0, i32(addr), i32(val), i32(mode), off, i32(ir_pos)))
    idx


e_slot = (s: int) -> int:
    d = ir.vtypes.len()
    ir.vtypes.push(i8(VI))
    ir.code.push(Ins(.slot, i32(VI), i32(d), i32(s), 0, 0, 0, i32(ir_pos)))
    d


e_copy = (dst: int, src: int, size: int) -> int:
    idx = ir.code.len()
    ir.code.push(Ins(.copy, i32(VI), 0, i32(dst), i32(src), 0, size, i32(ir_pos)))
    idx


e_vop = (dst: int, bsrc: int, csrc: int, kind: int, n: int, flags: int) -> int:
    idx = ir.code.len()
    ir.code.push(Ins(.vop, i32(VI), 0, i32(dst), i32(bsrc), i32(csrc), kind | (n << 4) | flags, i32(ir_pos)))
    idx


e_zero = (dst: int, size: int) -> int:
    idx = ir.code.len()
    ir.code.push(Ins(.zero, i32(VI), 0, i32(dst), 0, 0, size, i32(ir_pos)))
    idx


e_call0 = (f: int, rtype: int) -> int:
    start = ir.args.len()
    e_call_span(f, start, 0, rtype)


e_call1 = (f: int, a0: int, rtype: int) -> int:
    start = ir.args.len()
    ir.args.push(i32(a0))
    e_call_span(f, start, 1, rtype)


e_call2 = (f: int, a0: int, a1: int, rtype: int) -> int:
    start = ir.args.len()
    ir.args.push(i32(a0))
    ir.args.push(i32(a1))
    e_call_span(f, start, 2, rtype)


e_call3 = (f: int, a0: int, a1: int, a2: int, rtype: int) -> int:
    start = ir.args.len()
    ir.args.push(i32(a0))
    ir.args.push(i32(a1))
    ir.args.push(i32(a2))
    e_call_span(f, start, 3, rtype)


e_call4 = (f: int, a0: int, a1: int, a2: int, a3: int, rtype: int) -> int:
    start = ir.args.len()
    ir.args.push(i32(a0))
    ir.args.push(i32(a1))
    ir.args.push(i32(a2))
    ir.args.push(i32(a3))
    e_call_span(f, start, 4, rtype)


e_call_span = (f: int, start: int, n: int, rtype: int) -> int:
    d = -1
    if rtype >= 0:
        d = ir.vtypes.len()
        ir.vtypes.push(i8(rtype))
    c = if ir_cold: 2 else: 0
    ir.code.push(Ins(.call, i32(rtype), i32(d), i32(start), i32(n), i32(c), f, i32(ir_pos)))
    d


e_call = (f: int, args: int[], rt: int) -> int:
    start = ir.args.len()
    loop a in args: ir.args.push(i32(a))
    d = -1
    if rt >= 0:
        d = ir.vtypes.len()
        ir.vtypes.push(i8(rt))
    c = if ir_cold: 2 else: 0
    ir.code.push(Ins(.call, i32(rt), i32(d), i32(start), i32(args.len()), i32(c), f, i32(ir_pos)))
    d


e_calli = (fp: int, args: int[], rt: int, cabi: bool) -> int:
    start = ir.args.len()
    loop a in args: ir.args.push(i32(a))
    d = -1
    if rt >= 0:
        d = ir.vtypes.len()
        ir.vtypes.push(i8(rt))
    op = Op.calli
    if cabi: op = .callc
    ir.code.push(Ins(op, i32(rt), i32(d), i32(start), i32(args.len()), i32(fp), 0, i32(ir_pos)))
    d


e_block = () -> int:
    idx = ir.code.len()
    ir.code.push(Ins(.block, 0, 0, 0, 0, 0, 0, i32(ir_pos)))
    idx


e_loop = () -> int:
    fi = ir.fn_index
    if fi >= 0 and fi < ir_fn_has_loop.len(): ir_fn_has_loop[fi] = true
    idx = ir.code.len()
    ir.code.push(Ins(.loop, 0, 0, 0, 0, 0, int(ir_cold), i32(ir_pos)))
    idx


e_if = (c: int) -> int:
    idx = ir.code.len()
    ir.code.push(Ins(.if_, 0, 0, i32(c), 0, 0, 0, i32(ir_pos)))
    idx


e_else = () -> int:
    idx = ir.code.len()
    ir.code.push(Ins(.else_, 0, 0, 0, 0, 0, 0, i32(ir_pos)))
    idx


e_end = () -> int:
    idx = ir.code.len()
    ir.code.push(Ins(.end, 0, 0, 0, 0, 0, 0, i32(ir_pos)))
    idx


e_br = (depth: int) -> int:
    idx = ir.code.len()
    ir.code.push(Ins(.br, 0, 0, 0, 0, 0, depth, i32(ir_pos)))
    idx


e_brif = (c: int, depth: int) -> int:
    idx = ir.code.len()
    ir.code.push(Ins(.brif, 0, 0, i32(c), 0, 0, depth, i32(ir_pos)))
    idx


e_brtable = (idx: int, depths: int[], default_depth: int) -> int:
    start = ir.args.len()
    loop d in depths: ir.args.push(i32(d))
    pos = ir.code.len()
    ir.code.push(Ins(.brtable, 0, 0, i32(idx), i32(depths.len()), i32(start), default_depth, i32(ir_pos)))
    pos


e_ret = (v: int) -> int:
    idx = ir.code.len()
    ir.code.push(Ins(.ret, 0, 0, i32(v), 0, 0, 0, i32(ir_pos)))
    idx


e_trap = () -> int:
    idx = ir.code.len()
    ir.code.push(Ins(.trap, 0, 0, 0, 0, 0, 0, i32(ir_pos)))
    idx


op_name = (op: Op) -> str: "{op}"


ir_dump_capture = false
ir_dump_lines: str[]
dump_ir_line = (line: str):
    if ir_dump_capture: ir_dump_lines.push(line)
    else: print(line)

dump_ir = ():
    dump_ir_line("fn {ir.name} (params {ir.nparams}, ret {ir.ret}):")
    loop i in 0.. and s in ir.slot_size: dump_ir_line("  slot{i}: size {s} align {ir.slot_align[i]}")
    ind = 1
    loop ins in ir.code:
        if ins.op == .end or ins.op == .else_: ind -= 1
        pad = repeat("  ", ind)
        line = "{pad}{ins.op}"
        if ins.dst >= 0 and ins.op != .store and ins.op != .br and ins.op != .brif and ins.op != .brtable and ins.op != .block and ins.op != .loop and ins.op != .end and ins.op != .if_ and ins.op != .else_ and ins.op != .ret: line = "{pad}v{ins.dst} = {ins.op}"
        line += " a={ins.a} b={ins.b} c={ins.c} imm={ins.imm} ty={ins.ty}"
        if ins.op == .call or ins.op == .calli or ins.op == .callc or ins.op == .syscall or ins.op == .intr:
            al = ""
            loop k in [0..int(ins.b)): al += " v{ir.args[int(ins.a) + k]}"
            line += " args:{al}"
        dump_ir_line(line)
        if ins.op == .block or ins.op == .loop or ins.op == .if_ or ins.op == .else_: ind += 1


ir_use = (i: int) -> int:
    if ir_use_span >= 0:
        if i < ir_use_span_count: return int(ir.args[ir_use_span + i])
        return ir_use_values.2
    # The three integer fields are contiguous. Every caller bounds i by the
    # descriptor's count (at most three on this inline path).
    (&ir_use_values as *int)[i]


ir_has_use = (v: int) -> bool:
    loop i in [0..ir_use_count):
        if ir_use(i) == v: return true
    false


ir_operands = (ins: Ins) -> int:
    ir_use_count = 0
    ir_use_span = -1
    a = int(ins.a)
    bb = int(ins.b)
    d = int(ins.dst)
    ir_use_values.0 = a
    ir_use_values.1 = bb
    ir_use_values.2 = int(ins.c)
    match ins.op:
        nop, block, loop, end, else_, br, trap, zeroslots: return -1
        iconst, fconst, slot, gaddr, daddr, faddr: return d
        intr, call, syscall:
            ir_use_span = a
            ir_use_span_count = bb
            ir_use_count = bb
            return d
        calli, callc:
            ir_use_span = a
            ir_use_span_count = bb
            ir_use_count = bb + 1
            return d
        if_, brif, brtable, assume:
            ir_use_count = 1
            return -1
        ret:
            if a >= 0: ir_use_count = 1
            return -1
        store:
            ir_use_count = 2
            if int(ins.c) & M_INDEX != 0:
                ir_use_values.2 = d
                ir_use_count = 3
            return -1
        vst:
            ir_use_values.2 = d
            ir_use_count = 3
            return -1
        vsplat:
            ir_use_count = 1
            return d
        vzu: return -1
        copy:
            ir_use_count = 2
            return -1
        zero:
            ir_use_count = 1
            return -1
        memcpy, memset, vop:
            ir_use_count = 3
            return -1
        select, memeq, findbyte, scanbytes, findb:
            ir_use_count = 3
            return d
        load:
            ir_use_count = 1
            if int(ins.c) & M_INDEX != 0: ir_use_count = 2
            return d
        mov, neg, not_, fneg, fsqrt, fabs, ffloor, fceil, ftrunc, sext8, sext16, sext32, zext8, zext16, zext32, i2f, u2f, f2i, f2f, bits2f, f2bits:
            ir_use_count = 1
            return d
        _:
            ir_use_count = 2
            return d

# Frozen exact arithmetic queries extracted from exact.jo.
use 'node_store.dewy'
use 'checker_types.dewy'
use 'source_types.dewy'
use 'type_inference.dewy'
struct CheckerExactInput:
    nodes: *(Node[])
    lists: *(i32[])
    types: *(TypeInfo[])
    files: *(SrcFile[])
    int_type: *int
    u64_type: *int
    math_int: *int
ex_nodes: *(Node[])
ex_lists: *(i32[])
ex_types: *(TypeInfo[])
ex_files: *(SrcFile[])
ex_int_type: *int
ex_u64_type: *int
ex_math_int: *int
checker_exact_bind = (input: *CheckerExactInput) -> int:
    ex_nodes = input[0].nodes
    ex_lists = input[0].lists
    ex_types = input[0].types
    ex_files = input[0].files
    ex_int_type = input[0].int_type
    ex_u64_type = input[0].u64_type
    ex_math_int = input[0].math_int
    0
ex_type_of = (n: int) -> int: int(ex_nodes[0][n].type)
ex_dewy = (pos: int) -> bool:
    f = pos >> 40
    pos > 0 and f < ex_files[0].len() and ex_files[0][f].is_dewy
ex_representation = (t0: int) -> int:
    t = int(tu_prune(t0))
    if ex_types[0][t].kind == .refined: t = int(tu_prune(int(ex_types[0][t].elem)))
    loop ex_types[0][t].kind == .secret:
        t = int(tu_prune(int(ex_types[0][t].elem)))
        if ex_types[0][t].kind == .refined: t = int(tu_prune(int(ex_types[0][t].elem)))
    t
ex_type = (t0: int, pos: int) -> bool:
    if t0 == ex_int_type[0] or t0 == ex_u64_type[0]: return ex_dewy(pos)
    if t0 == ex_math_int[0]: return false
    t = ex_representation(t0)
    if ex_types[0][t].kind != .int_ or t == ex_math_int[0] or ex_types[0][t].st != 0: return false
    ex_dewy(pos) or ex_types[0][t].bits < 64
ex_operation = (n: int) -> bool:
    k = ex_nodes[0][n].kind
    op = int(ex_nodes[0][n].op)
    if k == .intrinsic: return ex_nodes[0][n].aux == 89
    if k == .unary:
        if op != 59: return false
    else if k == .binary and ex_nodes[0][n].aux == 0:
        if op != 58 and op != 59 and op != 60 and op != 79 and op != 61 and op != 67: return false
    else: return false
    t = int(ex_nodes[0][n].type)
    if t == 0 or not ex_type(t, ex_nodes[0][n].pos): return false
    k != .binary or op != 61 or ex_types[0][ex_representation(t)].sign
ex_kid = (n: int, i: int) -> int: int(ex_lists[0][int(ex_nodes[0][n].list) + i])
exact_potential = (n: int) -> bool:
    if n <= 0: return false
    if ex_operation(n): return true
    k = ex_nodes[0][n].kind
    op = int(ex_nodes[0][n].op)
    if k == .binary and (op == 63 or op == 64 or op == 65): return exact_potential(int(ex_nodes[0][n].a)) or exact_potential(int(ex_nodes[0][n].b))
    if k == .conv and (ex_nodes[0][n].aux == 1 or ex_nodes[0][n].aux == 0): return exact_potential(int(ex_nodes[0][n].a))
    if k == .if_ or k == .iflet: return exact_potential(int(ex_nodes[0][n].b)) or exact_potential(int(ex_nodes[0][n].c))
    if k == .coalesce: return exact_potential(int(ex_nodes[0][n].b))
    if k == .match_:
        loop i in [0..int(ex_nodes[0][n].nlist)):
            if exact_potential(int(ex_nodes[0][ex_kid(n, i)].b)): return true
    if k == .block and ex_nodes[0][n].aux != 0: return exact_potential(int(ex_nodes[0][ex_kid(n, int(ex_nodes[0][n].nlist) - 1)].a))
    if k == .exprstmt: return exact_potential(int(ex_nodes[0][n].a))
    false
exact_math_operand = (n: int) -> int:
    if ex_type_of(n) != ex_math_int[0]: return n
    value = n
    loop ex_nodes[0][value].kind == .conv and ex_nodes[0][value].aux == 0:
        child = int(ex_nodes[0][value].a)
        if ex_representation(ex_type_of(child)) != ex_math_int[0]: break
        value = child
    if ex_nodes[0][value].kind == .int_lit and (int(ex_nodes[0][value].flags) & 2097152 == 0 or ex_nodes[0][value].ival >= 0):
        word = ex_nodes[0].len()
        ex_nodes[0].push(ex_nodes[0][value])
        ex_nodes[0][word].type = i32(ex_int_type[0])
        return word
    if ex_nodes[0][value].kind == .conv and ex_nodes[0][value].aux == 1:
        a = int(ex_nodes[0][value].a)
        if ex_type_of(a) == ex_int_type[0] and ex_dewy(ex_nodes[0][value].pos): return a
    n
exact_candidate = (n: int) -> bool:
    k = ex_nodes[0][n].kind
    if k == .binary:
        op = int(ex_nodes[0][n].op)
        return ex_operation(n) or ((op == 63 or op == 64 or op == 65) and exact_potential(n))
    if k == .unary or k == .intrinsic: return ex_operation(n)
    if k == .conv and ex_nodes[0][n].aux == 2: return exact_potential(int(ex_nodes[0][n].a))
    false

use 'errors.jo'
use 'ast.jo'
use 'checker_decl_slots.dewy'
use 'check.jo'
use 'checker_signature.dewy'
use 'error_ops.dewy'
use 'types.jo'

# Shared by named member lookup and the complete diagnostic/IDE listing.
# Read the cached signature in place; no candidate needs a signature copy.
method_decl_for = (decl: int, rt: int) -> bool:
    di = decl_info(decl)
    if not decl_infos[di].sig.done: fn_sig(decl)
    if decl_infos[di].sig.params.len() == 0: return false
    p0 = prune(decl_infos[di].sig.params[0])
    # (a method of a minted parent takes its family, which this type is in)
    types[p0].kind != .var and (types[p0].kind == types[rt].kind or type_eq(p0, rt) or family_annotation(p0) and value_members(p0).contains(rt))

module_of_type = (t0: int) -> int:
    t = prune(t0)
    k = types[t].kind
    if (k == .struct_ or k == .enum_) and types[t].st != 0 or (k == .struct_ or k == .enum_): return int(nodes[int(structs[int(types[t].st)].decl)].mod)
    -1

# The modules whose functions are methods of t: its own, then those of the types it is
# minted under (a minted child has its parents' methods, wherever they were declared)
method_modules = (t0: int) -> int[]:
    out: int[]
    t = prune(t0)
    loop t != 0:
        m = module_of_type(t)
        if m >= 0 and not out.contains(m): out.push(m)
        t = nominal_parent.get(t, 0)
    out

$runtime_checks

from p"@lib/core/rt.jo" import (__str_slice)
from p"@lib/core/str.jo" import (find_byte is_alpha)
from p"dewy_context.jo" import (dc_parser)
from p"dewy_fast.jo" import (DN_BRACE_HINT dn_lexer dn_word_tokens)
from p"dewy_lex.dewy" import (dn_interpolation_end)
from p"dewy_tokens.dewy" import (DewyLexeme dn_token_kind dn_token_text)
from p"diagnostic_exit.dewy" import (fatal)
from p"util.jo" import (err_notes files intern mkpos name_of names)

FastLexWord:type=int64<overflow='wrap'>

dn_init_words=():>void=>{
    dc_parser.reader.dn_no_id=intern("no")
    dc_parser.reader.dn_end_id=intern("end")
    dc_parser.reader.dn_type_id=intern("type")
    dc_parser.reader.dn_none_id=intern("none")
    dc_parser.reader.dn_new_id=intern("new")
    dc_parser.reader.dn_void_id=intern("void")
    dc_parser.reader.dn_reserved_words=fill(false names.length)
    loop word in [dc_parser.reader.dn_end_id dc_parser.reader.dn_new_id dc_parser.reader.dn_none_id dc_parser.reader.dn_void_id] {
        dc_parser.reader.dn_reserved_words[word]=true
    }
    dc_parser.reader.dn_true_id=intern("true")
    dc_parser.reader.dn_false_id=intern("false")
    dc_parser.reader.dn_is_id=intern("is")
    dc_parser.reader.dn_isnt_id=intern("isnt")
    dc_parser.reader.dn_in_id=intern("in")
    let words=["as" "and" "break" "const" "continue" "else" "from" "import" "if" "in" "let" "loop" "parallel" "concurrent" "spawn" "match" "not" "of" "or" "or_throw" "return" "test" "transmute" "xor" "nand" "nor" "xnor"]
    loop word in words {intern(word);}
    dn_word_tokens=fill('none' names.length)
    loop word in words {dn_word_tokens[intern(word)]=dn_token_kind(word)}
}

dn_error=(offset:int64 message:string):>int64=>{
    if dc_parser.reader.dn_in_interpolation >? 0 {
        fatal(mkpos(dc_parser.file offset) "{message}, inside a string interpolation ({DN_BRACE_HINT}; `fmt'.2f'(value)` formats a number)")
    }
    fatal(mkpos(dc_parser.file offset) message)
    0
}

dn_lex_problem=():>int64=>{
    if dn_lexer.note_at >=? 0 {
        err_notes.push([mkpos(dc_parser.file dn_lexer.note_at) "note: this `\{` starts a string interpolation; for a literal brace write `\\\{`"])
    }
    dn_error(dn_lexer.problem_at dn_lexer.problem)
}

dn_interpolation_close=(source:string start:int64 stop:int64):>int64=>{
    let e=dn_interpolation_end(@dn_lexer source start stop 0 false)
    if e <? 0 {dn_lex_problem();}
    e
}

dn_ident_start=(c:uint8):>bool=>is_alpha(c) or c =? 95 or c >=? 128

# One spelling per name: subscript digits become `_` digits, superscript digits
# become `‾` digits, and the micro sign becomes Greek mu.
dn_identifier_canonical=(s:string):>string=>{
    let bytes=s as array<uint8>
    let out=""
    let run:FastLexWord=0
    let i:FastLexWord=0
    let n:FastLexWord=bytes.length
    loop i <? n {
        let c=bytes[i]
        let digit:FastLexWord=-1
        let kind:FastLexWord=0
        let width:FastLexWord=1
        if c =? 226 and i + 2 <? n and bytes[i + 1] =? 130 and bytes[i + 2] >=? 128 and bytes[i + 2] <=? 137 {
            digit=FastLexWord(bytes[i + 2]) - 128
            kind=1
            width=3
        }
        else if c =? 226 and i + 2 <? n and bytes[i + 1] =? 129 and (bytes[i + 2] =? 176 or (bytes[i + 2] >=? 180 and bytes[i + 2] <=? 185)) {
            digit=FastLexWord(bytes[i + 2]) - 176
            kind=2
            width=3
        }
        else if c =? 194 and i + 1 <? n and (bytes[i + 1] =? 185 or bytes[i + 1] =? 178 or bytes[i + 1] =? 179) {
            digit=if bytes[i + 1] =? 185 {1} else if bytes[i + 1] =? 178 {2} else {3}
            kind=2
            width=2
        }
        else if (c =? 95 or (c =? 226 and i + 2 <? n and bytes[i + 1] =? 128 and bytes[i + 2] =? 190)) and i + (if c =? 95 {1} else {3}) <? n and bytes[i + (if c =? 95 {1} else {3})] >=? 48 and bytes[i + (if c =? 95 {1} else {3})] <=? 57 {
            kind=if c =? 95 {1} else {2}
            i+=if c =? 95 {1} else {3}
            if run not=? kind {
                let mark=if kind =? 1 {"_"} else {"‾"}
                out="{out}{mark}"
            }
            loop i <? n and bytes[i] >=? 48 and bytes[i] <=? 57 {
                out="{out}{__str_slice(s i i + 1)}"
                i+=1
            }
            run=kind
            continue
        }
        if digit >=? 0 {
            if run not=? kind {
                let mark=if kind =? 1 {"_"} else {"‾"}
                out="{out}{mark}"
            }
            out="{out}{digit}"
            run=kind
            i+=width
            continue
        }
        if c =? 194 and i + 1 <? n and bytes[i + 1] =? 181 {
            out="{out}μ"
            i+=2
            run=0
            continue
        }
        out="{out}{__str_slice(s i i + 1)}"
        run=0
        i+=1
    }
    out
}

dn_lex_canonical=(s:string a:int64 b:int64):>int64=>intern(dn_identifier_canonical(__str_slice(s a b)))
dn_lex_newline=(s:string a:int64 b:int64):>bool=>find_byte(__str_slice(s a b) 10) >=? 0
dn_lex_slice=(s:string a:int64 b:int64):>string=>__str_slice(s a b)

# Materialize text only when projection needs a literal payload.
dn_payload=(token:DewyLexeme):>string=>{
    if token.symbol not=? 'none' {return dn_token_text(token.symbol)}
    if token.name not=? 0 {return name_of(FastLexWord(token.name))}
    let source=files[dc_parser.file].src
    let first:FastLexWord=token.start
    if token.kind =? 'metatag' {return __str_slice(source first + 1 token.stop)}
    if token.kind =? 'integer' {return "{__str_slice(source first first + 2)}:{__str_slice(source first + 2 token.stop)}"}
    if token.kind =? 'based_string' {return "{__str_slice(source first first + 2)}:{__str_slice(source first + 3 token.stop - 1)}"}
    let bytes=source as array<uint8>
    if (token.kind =? 'source_integer' or token.kind =? 'source_real') and first + 1 <? token.stop and bytes[first] =? 48 and bytes[first + 1] =? 100 {first+=2}
    __str_slice(source first token.stop)
}

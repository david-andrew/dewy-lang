use 'lower_closures.dewy'
use 'lower_storage.dewy'
use 'lower_determinism.dewy'
use 'native_debug.dewy'
use 'elf_format.dewy'
use 'x64_emit.dewy'
use 'driver_pipeline.dewy'
use 'x64_allocate.dewy'
use 'ir_types.dewy'
use 'pcheck.jo'
# Fused partition workers (x86-64 Linux, default builds). After whole-program finalization,
# worker processes (fork: copies of the checked program) each lower, optimize and emit a share
# of the checked functions, and send back each function's machine code with a journal of what
# its lowering referred to that the fork did not have yet (functions, helpers, strings, globals,
# constants, warnings). The compiler then lowers in its usual order, replaying a function's
# journal where a worker made it (what lowering it here would have added, added in the same
# order) and lowering it here where none did. Then it joins the code in that order, moving each
# function's references to where those things are here: the same bytes as lowering and
# emitting every function here. A worker that could not see a function it might have inlined
# (fast_inline_into) leaves that function to be made here.
#
# INVARIANT: a function's journal must hold every reference its lowering makes to a function,
# helper, string, global or constant that the fork did not have, whatever the worker lowered
# before it. So a new cache in lowering that lives across functions (one that can skip
# lf_of_inst, lf_helper, str_data, global_addr_off, box_dflt_off or a raw constant, as
# note_mt_active and loc_data could) must be journaled or bypassed while fused_on. Otherwise
# places come out in another order and the binary changes with the number of workers.
# tests/test_core_fused_determinism.py enforces this.

use 'main.jo'
use 'util.jo'
use 'ir.jo'
use 'x64.jo'
use 'check.jo'
use 'lower.jo'
use 'types.jo'
use 'type_ops.dewy'
use 'ast.jo'
use 'par.jo'
use 'par_ops.dewy'
use 'inline.jo'
use 'inline_ops.dewy'
use 'opt.jo'
use 'lower_functions.dewy'
use 'lower_primitives.dewy'
use 'fused_ops.dewy'
use 'fused_ir.dewy'

struct FzLocal:
    lf: int
    owned: bool
    taint: bool
    kind: int
    j0: int
    j1: int
    ir: IrFn

fzw_f0 = 0
fzw_t0 = 0
fzw_g0 = 0
fzw_grown = false
fzw_recs: FzLocal[]
fzw_have: {int: int} = {}

struct FzRec:
    w: int
    lf: int
    lkind: int
    ka: int
    kb: int
    kc: int
    owned: bool
    taint: bool
    kind: int
    ents: int[]
    texts: str[]
    raws: u8[][]
    assumed: int[]
    uses: int[]
    irp: int            # (where its IR is in the worker's bytes; -1: none)
    chunk: int          # (where its machine code is; -1: none)
    valid: bool
    raw_par: int[]      # (its replayed raw constants' offsets here)

# by worker: its bytes, and where its functions, constants and data are here
fz_rd: ParIn[]                 # (a reader of its bytes, kept: a reader made anew copies them)
fz_mlf: {int: int}[]
fz_mro: {int: int}[]
fz_mdt: {int: int}[]
fz_mrc: {int: int}[]           # (emission constants: always found exactly)
fz_kro: int[][]
fz_kdt: int[][]

fz_recs: FzRec[]
fz_by_inst: {int: int} = {}
fz_by_helper: {str: int} = {}
fz_qrec: {int: int} = {}        # lf here -> the record that made it

# ---- in a worker: what lowering and emission refer to ----
fused_on = false
fz_lf0 = 0                  # (lowered functions, rodata and data the fork had)
fz_r0 = 0
fz_d0 = 0
fz_j: int[]                 # journal: kind, local, a, b, c per entry (fz_note)
fz_texts: str[]
fz_raws: u8[]
fz_ro: int[]                # emission constants: bits, local offset

fz_pinit = 0
fz_ready = false            # (worker results to replay and join)
# The layout that makes a function's code the same wherever it is made (functions at multiples
# of 64 bytes, line rows by source position, extern thunks without an inherited position): for
# the programs workers may make, whatever the number of workers, so that one process makes the
# same bytes. Other programs keep the ordinary layout.
fz_layout = false







# Worker trace stream, replayed in worker order by the parent.
fz_trace_fd = -1

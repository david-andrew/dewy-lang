$runtime_checks
from p"checker_call_queries.dewy" import (collect_fns ctx_dependent)
from p"coercion_queries.dewy" import (can_coerce)
from p"call_argument_checks.dewy" import (match_type)
from p"expression_types.dewy" import (ntype)
from p"checker_call_cost.dewy" import (Cand)
from p"ast.jo" import (kid nkids nodes)
from p"check.jo" import (decl_infos syms)
from p"checker_expr.dewy" import (lookup)
from p"checker_signature.dewy" import (fn_sig)
from p"checks_thin_expr.dewy" import (call_waits_binds call_waits_local call_waits_mark call_waits_skips expected_bind_fits subst_partial text_literal)
from p"expr.jo" import (literal_typed_elements literal_typed_names)
from p"literal_context.dewy" import (is_lit)
from p"node_store.dewy" import (call_waits_never node_nlist2)
from p"types.jo" import (T_INT has_var)

WaitWord:type=int64<overflow='wrap'>
# Does the unchecked call a take its type from the parameter it meets, as a literal does
# (node_store.dewy)? 1: the name's one function has a type parameter no parameter mentions
# (`text=<A>(s:string):>Node<A>`); 2: a bare literal alone gives one, and a is an element of an
# array literal argument. An array literal argument marks those elements and answers 0.
# O(parameters) once per name, then skipped (call_waits_never) when the answer was no.
call_waits=(a:int64):>int64=>$unsafe {
    if nodes.ptr[a].kind =? 'array' {
        loop i in [0..nkids(a)) {
            let e=kid(a i)
            if nodes.ptr[e].kind not=? 'call' or nodes.ptr[e].type not=? 0 {continue}
            let head=WaitWord(nodes.ptr[e].a)
            if nodes.ptr[head].kind not=? 'ident' {continue}
            let name=WaitWord(nodes.ptr[head].name)
            if call_waits_skips(name) or not literal_typed_call(e) {continue}
            literal_typed_elements[e]=true
            literal_typed_names[name]=true
            if name <? call_waits_never.length {call_waits_never[name]=false}
        }
        return 0
    }
    if nodes.ptr[a].kind not=? 'call' or nodes.ptr[a].type not=? 0 or nodes.ptr[WaitWord(nodes.ptr[a].a)].kind not=? 'ident' {return 0}
    if literal_typed_elements.has(a) {return 2}
    let name=WaitWord(nodes.ptr[WaitWord(nodes.ptr[a].a)].name)
    let s=lookup(name)
    if s not=? 0 and syms.ptr[s].kind =? 'local' {return 0}
    if s =? 0 or syms.ptr[s].kind not=? 'fns' or syms.ptr[s].decl =? 0 or node_nlist2(nodes.ptr[WaitWord(syms.ptr[s].decl)].op_ext) =? 0 {
        call_waits_mark(name)
        return 0
    }
    let found=false
    let d=call_waits_decl(name)
    if d not=? 0 {
        let sig=fn_sig(d)
        if sig.ret not=? 0 {
            loop id in [0..WaitWord(node_nlist2(nodes.ptr[d].op_ext))) {
                let binds=call_waits_binds(int64(sig.ntp) id)
                let mentioned=false
                loop p in sig.params {
                    if subst_partial(p @binds) not=? p {mentioned=true}
                }
                if not mentioned and subst_partial(int64(sig.ret) @binds) not=? int64(sig.ret) {found=true}
            }
        }
    }
    # (a generic function of the same name in another module may be missed: its call then says
    # `cannot infer`, not wrong code)
    if not found {call_waits_mark(name)}
    if found {1} else {0}
}
# (the name's one generic function, or 0)
call_waits_decl=(name:WaitWord):>WaitWord=>$unsafe {
    let own:array<int64>=[]
    collect_fns(name @own)
    if own.length not=? 1 or node_nlist2(nodes.ptr[own[0]].op_ext) =? 0 {return 0}
    own[0]
}
literal_typed_call=(e:WaitWord):>bool=>$unsafe {
    if nodes.ptr[WaitWord(nodes.ptr[e].a)].kind not=? 'ident' {return false}
    let name=WaitWord(nodes.ptr[WaitWord(nodes.ptr[e].a)].name)
    if call_waits_local(name) {return false}
    let s=lookup(name)
    if s =? 0 or syms.ptr[s].kind not=? 'fns' or syms.ptr[s].decl =? 0 or node_nlist2(nodes.ptr[WaitWord(syms.ptr[s].decl)].op_ext) =? 0 {
        call_waits_mark(name)
        return false
    }
    let d=call_waits_decl(name)
    if d =? 0 {
        call_waits_mark(name)
        return false
    }
    let sig=fn_sig(d)
    if nkids(e) >? sig.params.length {return false}
    loop id in [0..WaitWord(node_nlist2(nodes.ptr[d].op_ext))) {
        let literal=false
        let other=false
        let binds=call_waits_binds(int64(sig.ntp) id)
        loop i in 0.. and p in sig.params {
            let given=subst_partial(p @binds)
            if given =? p {continue}
            if i >=? nkids(e) or given not=? T_INT or not (is_lit(kid(e i)) or text_literal(kid(e i))) {other=true}
            else {literal=true}
        }
        if literal and not other {return true}
    }
    false
}

# (`let s:set<Op> = set(['push'])`, `let x:Box<Op> = box('push')`: a type parameter bound only by arguments that take their
# type from where they go, as the text in an array literal, takes what the expected result
# gives it, as such a literal written there would; only where the call as bound would not
# give the expected type, so a call that fits keeps its types)
expected_binds=(@cd:Cand expected:WaitWord given:array<int64>):>void=>$unsafe {
    let held=cd.binds
    let sret=int64(decl_infos.ptr[cd.di].sig.ret)
    if match_type(sret expected @held 0) >=? 0 {
        let fitted=subst_partial(sret @held)
        if has_var(fitted) or can_coerce(0 fitted expected) {
            loop i in 0.. and b in held {
                if cd.binds[i] =? 0 and expected_bind_fits(b) {cd.binds[i]=b}
            }
            return
        }
    }
    let ret=subst_partial(sret @cd.binds)
    if not has_var(ret) and can_coerce(0 ret expected) {return}
    let eb:array<int64>=fill(0 int64(decl_infos.ptr[cd.di].sig.ntp))
    loop i in 0.. and t in given {eb[i]=t}
    loop i in 0.. and a in cd.args {
        if a =? 0 or is_lit(a) or ctx_dependent(a) or nodes[a].type =? 0 or text_literal(a) {continue}
        if match_type(decl_infos.ptr[cd.di].sig.params.ptr[i] ntype(a) @eb 0) <? 0 {return}
    }
    if match_type(sret expected @eb 0) <? 0 {return}
    loop i in 0.. and b in eb {
        if expected_bind_fits(b) {cd.binds[i]=b}
    }
}

$runtime_checks
from p"ast.jo" import (nodes)
from p"util.jo" import (intern name_of)
from p"checker_state.dewy" import (SK Sym Local)
from p"check.jo" import (PositionGuard check_scopes ctxs cx fns locals loop_serials position_guards syms)
from p"node_store.dewy" import (node_op)

CheckerScopeSymbolsWord:type=int64<overflow='wrap'>

new_sym_push_slow=(name:CheckerScopeSymbolsWord kind:SK r:CheckerScopeSymbolsWord decl:CheckerScopeSymbolsWord):>void=>{
    syms.push(Sym[name=int32<overflow='wrap'>(name) kind=kind ref=int32<overflow='wrap'>(r) decl=int32<overflow='wrap'>(decl)])
}

new_sym=(name:CheckerScopeSymbolsWord kind:SK r:CheckerScopeSymbolsWord decl:CheckerScopeSymbolsWord):>CheckerScopeSymbolsWord=>$unsafe {
    let sp=syms.ptr
    let sh=(sp as ptr<int64>) - 3
    let s=CheckerScopeSymbolsWord(sh[1])
    if sh[0] =? 1 and s <? CheckerScopeSymbolsWord(sh[2]) {
        sp[s]=Sym[name=int32<overflow='wrap'>(name) kind=kind ref=int32<overflow='wrap'>(r) decl=int32<overflow='wrap'>(decl)]
        sh[1]=int64(s + 1)
    } else {
        new_sym_push_slow(name kind r decl)
    }
    s
}

push_scope_sym_grow=(name:CheckerScopeSymbolsWord):>void=>$unsafe {
    let old_len=CheckerScopeSymbolsWord(check_scopes.top.length)
    let new_len:CheckerScopeSymbolsWord=if old_len =? 0 {1024} else {old_len * 2}
    loop new_len <=? name {new_len *= 2}
    check_scopes.top.resize(new_len)
    mem_set((check_scopes.top.ptr + old_len) as ptr<uint8> 255 (new_len - old_len) * 8)
}

push_scope_sym_push_slow=(prev:CheckerScopeSymbolsWord name:CheckerScopeSymbolsWord sym:CheckerScopeSymbolsWord):>void=>{
    check_scopes.prev.push(prev)
    check_scopes.names.push(name)
    check_scopes.syms.push(sym)
}

push_scope_sym=(name:CheckerScopeSymbolsWord sym:CheckerScopeSymbolsWord):>void=>$unsafe {
    if name >=? check_scopes.top.length {push_scope_sym_grow(name)}
    let top_p=check_scopes.top.ptr
    let prev=CheckerScopeSymbolsWord(top_p[name])
    let np=check_scopes.names.ptr
    let sp=check_scopes.syms.ptr
    let pp=check_scopes.prev.ptr
    let nh=(np as ptr<int64>) - 3
    let sh=(sp as ptr<int64>) - 3
    let ph=(pp as ptr<int64>) - 3
    let nlen=CheckerScopeSymbolsWord(nh[1])
    top_p[name]=int64(nlen)
    if ((nh[0] - 1) | (sh[0] - 1) | (ph[0] - 1)) =? 0 and nlen <? CheckerScopeSymbolsWord(nh[2]) and nlen <? CheckerScopeSymbolsWord(sh[2]) and nlen <? CheckerScopeSymbolsWord(ph[2]) {
        pp[nlen]=int64(prev)
        np[nlen]=int64(name)
        sp[nlen]=int64(sym)
        let n1=int64(nlen + 1)
        ph[1]=n1
        nh[1]=n1
        sh[1]=n1
    } else {
        push_scope_sym_push_slow(prev name sym)
    }
}

scope_mark=():>int64=>check_scopes.names.length

scope_reset=(mark:int64):>void=>$unsafe {
    if position_guards.length >? 0 {
        loop position_guards.length >? 0 and position_guards.ptr[CheckerScopeSymbolsWord(position_guards.length) - 1].mark >=? mark {position_guards.pop();}
    }
    let names_p=check_scopes.names.ptr
    let nh=(names_p as ptr<int64>) - 3
    let i=CheckerScopeSymbolsWord(nh[1]) - 1
    if i >=? mark {
        let top_p=check_scopes.top.ptr
        let prev_p=check_scopes.prev.ptr
        loop i >=? mark {
            top_p[names_p[i]]=prev_p[i]
            i -= 1
        }
        let sh=(check_scopes.syms.ptr as ptr<int64>) - 3
        let ph=(prev_p as ptr<int64>) - 3
        if ((nh[0] - 1) | (sh[0] - 1) | (ph[0] - 1)) =? 0 {
            nh[1]=mark
            sh[1]=mark
            ph[1]=mark
        } else {
            if nh[0] =? 1 {nh[1]=mark} else {check_scopes.names.truncate(mark)}
            if sh[0] =? 1 {sh[1]=mark} else {check_scopes.syms.truncate(mark)}
            if ph[0] =? 1 {ph[1]=mark} else {check_scopes.prev.truncate(mark)}
        }
    }
}

let css_underscore_id:int64=0
new_local_push_slow=(name:int64 t:int64 inst:CheckerScopeSymbolsWord pos:int64 dloops:int64):>void=>{
    locals.push(Local[name=int32<overflow='wrap'>(name) type=int32<overflow='wrap'>(t) owner=int32<overflow='wrap'>(inst) pos=pos dloops=int32<overflow='wrap'>(dloops)])
}
new_local=(name:int64 t:int64 pos:int64):>int64=>$unsafe {
    let inst=CheckerScopeSymbolsWord(ctxs.ptr[cx].inst)
    let lp=locals.ptr
    let lh=(lp as ptr<int64>) - 3
    let l=CheckerScopeSymbolsWord(lh[1])
    let dloops=loop_serials.length
    if lh[0] =? 1 and l <? CheckerScopeSymbolsWord(lh[2]) {
        lp[l]=Local[name=int32<overflow='wrap'>(name) type=int32<overflow='wrap'>(t) owner=int32<overflow='wrap'>(inst) pos=pos dloops=int32<overflow='wrap'>(dloops)]
        lh[1]=int64(l + 1)
    } else {
        new_local_push_slow(name t inst pos dloops)
    }
    fns.ptr[inst].locals.push(int64(l))
    if name not=? 0 {
        if css_underscore_id =? 0 {css_underscore_id=intern("_")}
        if name not=? css_underscore_id {push_scope_sym(name new_sym(name 'local' l 0))}
    }
    int64(l)
}

# An indexed target's forms (checker_assigns.dewy va_index, given the receiver's type bt):
# 1 Dewy ranges made values, 2 a range of an array's elements, 3 a stepped range off an
# n-dimensional array refused, 4 a record's soa element, part or `[]=` call, 5 an array's
# elements picked by a mask or indexes; the rewritten statement, or 0
# A condition that has just been found to hold or not: `i =? k` on a local is noted, with a scope
# entry so that the branch's reset takes it back. O(1).
let id_position_guard:CheckerScopeSymbolsWord=0
position_guard_note=(c:int64 holds:bool):>void=>$unsafe {
    let op=node_op(nodes.ptr[c].op_ext)
    # Frozen Tok.eq and Tok.ne ordinals.
    if not (op =? 69 and holds or op =? 70 and not holds) {return}
    let a=CheckerScopeSymbolsWord(nodes.ptr[c].a)
    let b=CheckerScopeSymbolsWord(nodes.ptr[c].b)
    if nodes.ptr[a].kind =? 'int_lit' {
        let literal=a
        a=b
        b=literal
    }
    if nodes.ptr[a].kind not=? 'ident' or nodes.ptr[a].aux not=? 1 or nodes.ptr[b].kind not=? 'int_lit' {return}
    position_guards.push(PositionGuard(local=nodes.ptr[a].sym value=int32<overflow='wrap'>(nodes.ptr[b].ival) mark=int32(scope_mark())))
    if id_position_guard =? 0 {id_position_guard=intern("$position_guard")}
    push_scope_sym(id_position_guard 0)
}

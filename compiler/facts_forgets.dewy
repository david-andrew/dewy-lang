ForgetWord:type=int64<overflow='wrap'>
# The root a mutable argument writes: its place's, through elements as well as
# fields (`f(@xs[i])`, and `d[k].clear()` on `d.vals[__map_entry_present(d k)]`),
# or none. O(route depth).
fact_written_root=(e0:ForgetWord):>PlaceIdentity=>$unsafe {
    let p=place_base(place_route(e0))
    if p.declaration not=? 0 {return p}
    let e=e0
    let indexed=false
    let depth:ForgetWord=0
    loop e not=? 0 and depth <? 32 {
        depth += 1
        let k=nodes.ptr[e].kind
        if k =? 'index' and nodes.ptr[e].b not=? 0 or fact_payload_node(e) {indexed=true}
        # (a local place, `let q = @xs[i]` or `loop @x in xs`, and a narrowed
        # name write the place they name)
        else if k =? 'ident' and nodes.ptr[e].aux =? int32(1) and ForgetWord(locals.ptr[ForgetWord(nodes.ptr[e].sym)].flags) & LF_ALIAS not=? 0 and locals.ptr[ForgetWord(nodes.ptr[e].sym)].alias not=? 0 and not place_locked.has(ForgetWord(nodes.ptr[e].sym)) {
            e=ForgetWord(locals.ptr[ForgetWord(nodes.ptr[e].sym)].alias)
            indexed=true
            continue
        }
        else if k not=? 'addr' and k not=? 'conv' and not fact_field_node(e) {break}
        e=ForgetWord(nodes.ptr[e].a)
    }
    if not indexed or e =? 0 {return p}
    place_base(place_route(e))
}
# A call's write through an element place, `f(@xs[i])` or `f(@d[k])` (on
# `d.vals[...]`), changes that route alone: its root gets a new value keeping
# what the route cannot change (fact_change_route: an array's length, a
# dictionary's keys and positions). False when the place is not one, for the
# caller's own rule. O(route depth + the root's projections).
fact_routed_write=(@s:FactState e0:ForgetWord at:ForgetWord reason:FactReason paths:array<array<int64>>=[]):>bool=>{
    let e=fact_routed_place(e0)
    if e =? 0 {return false}
    fact_change_route(@s e false at reason paths)
    true
}
# The element place a mutable argument names (`@xs[i]`, `@d[k]`), or 0.
fact_routed_place=(e0:ForgetWord):>ForgetWord=>$unsafe {
    let e=e0
    loop nodes.ptr[e].kind =? 'addr' or nodes.ptr[e].kind =? 'conv' {e=ForgetWord(nodes.ptr[e].a)}
    if place_base(place_route(e)).declaration not=? 0 or fact_written_root(e).declaration =? 0 {return 0}
    e
}
# An opaque call's effects: every exposed root, and each local lent to it.
fact_forget_call=(@s:FactState n:ForgetWord reason:FactReason at:ForgetWord=0):>void=>{
    let site=if at =? 0 {n} else {at}
    fact_forget(@s site reason)
    fact_forget_mutable_maps(n @s true at reason)
}
fact_dewy_local=(l:ForgetWord):>bool=>$unsafe {
    let f=ForgetWord(locals.ptr[l].owner)
    if f <=? 0 or f >=? fns.length {return false}
    # (a Dewy module's top level is its initializer's body)
    if fns.ptr[f].decl =? 0 {return fns.ptr[f].kind =? FK_INIT and files[ForgetWord(modules[ForgetWord(fns.ptr[f].mod)].file)].is_dewy}
    files[pos_file(nodes.ptr[ForgetWord(fns.ptr[f].decl)].pos)].is_dewy
}
# Distinct `@` parameters of one Dewy function are disjoint storage: each call
# passes them places the mutable-argument check proves apart (provisional).
fact_disjoint=(p:PlaceIdentity q:PlaceIdentity):>bool=>$unsafe {
    # (a written local only lent to calls is its own storage: fact_own_local)
    if fact_own_local(p) and not (q.root =? p.root and q.declaration =? p.declaration) {return true}
    # (two globals are two storages: neither is ever a place of the other)
    if p.root =? 'global' and q.root =? 'global' {return p.declaration not=? q.declaration and p.declaration >? 0 and q.declaration >? 0}
    if p.root not=? 'local' or q.root not=? 'local' or p.declaration =? q.declaration or p.declaration =? 0 or q.declaration =? 0 {return false}
    let a=p.declaration
    let b=q.declaration
    if locals.ptr[a].owner not=? locals.ptr[b].owner or ForgetWord(locals.ptr[a].flags) & LF_MUTPARAM =? 0 or ForgetWord(locals.ptr[b].flags) & LF_MUTPARAM =? 0 {return false}
    let f=ForgetWord(locals.ptr[a].owner)
    f >? 0 and f <? fns.length and fns.ptr[f].decl not=? 0 and files[pos_file(nodes.ptr[ForgetWord(fns.ptr[f].decl)].pos)].is_dewy
}
# Whether two places' types keep their storage apart: no write to one changes
# the other. Storage overlaps only when one lies inside the other, and a
# global lies inside nothing but itself, so a written global threatens a
# place whose type it can contain (an `@` parameter bound to it or a part of
# it), and a written local one whose type contains it or lies in it. Raw
# addresses (a place reached by `ptr`, `data`) can be viewed as any type, and
# pointers, callables and unresolved generics reach anything: all stay
# conservative. O(1) cached; once per type pair O(component types).
fact_type_disjoint=(w:PlaceIdentity q:PlaceIdentity):>bool=>$unsafe {
    if w.declaration <=? 0 or q.declaration <=? 0 or w.root =? q.root and w.declaration =? q.declaration {return false}
    if fact_place_raw(w) or fact_place_raw(q) {return false}
    let wt=if w.root =? 'local' {ForgetWord(locals.ptr[w.declaration].type)} else {ForgetWord(globals.ptr[w.declaration].type)}
    let qt=if q.root =? 'local' {ForgetWord(locals.ptr[q.declaration].type)} else {ForgetWord(globals.ptr[q.declaration].type)}
    if w.root =? 'global' {return not fact_type_reaches(wt qt)}
    if q.root =? 'global' {return not fact_type_reaches(qt wt)}
    not fact_type_reaches(wt qt) and not fact_type_reaches(qt wt)
}
# A place whose address was taken as a raw pointer (a global's escape, a
# local's `.ptr`): a view of it may have any type.
fact_place_raw=(p:PlaceIdentity):>bool=>$unsafe {
    if p.root =? 'global' {return globals.ptr[p.declaration].exposed}
    p.root not=? 'local' or ForgetWord(locals.ptr[p.declaration].flags) & LF_EXPOSED not=? 0
}
fact_exposed_bound=(s:FactState):>bool=>$unsafe {
    loop i in [0..s.bindings.length) {
        if fact_exposed(s.bindings.ptr[i].place) {return true}
    }
    false
}
# A write through an exposed place p forgets every exposed root but those
# disjoint from p.
fact_forget=(@s:FactState at:ForgetWord reason:FactReason all:bool=false written:PlaceIdentity=PlaceIdentity('local' 0 0) keep_written:bool=false text_sink:bool=false):>void=>$unsafe {
    loop i in [0..s.bindings.length) {
        let p=s.bindings.ptr[i].place
        if not all and not fact_exposed(p) {continue}
        # Output's internal buffers remain mutable. Preserve only checked
        # program globals that cannot alias those buffers through an escape.
        if text_sink and p.root =? 'global' and not globals.ptr[p.declaration].exposed {
            let d=ForgetWord(globals.ptr[p.declaration].decl)
            if d not=? 0 and dewy_at(nodes.ptr[d].pos) and not pos_in_lib(nodes.ptr[d].pos) {continue}
        }
        if text_sink and p.root =? 'local' and fact_sink_disjoint_param(p.declaration) {continue}
        if not all and (fact_disjoint(written p) or keep_written and p =? written or fact_type_disjoint(written p)) {continue}
        let t=if p.root =? 'local' {ForgetWord(locals.ptr[p.declaration].type)} else {ForgetWord(globals.ptr[p.declaration].type)}
        let v=fact_new(@s fact_domain(t reason at) FactTerm(type=t))
        fact_holds_contract(@s t v)
        let old=s.bindings.ptr[i].value
        if not all and fact_raw_exposed_array(p) and old not=? 0 and v not=? 0 {
            let length=fact_project(@s old (-1) false T_INT)
            if length not=? 0 and s.projections.length <? FACT_CAP {fact_add_projection(@s FactProjection(v (-1) false length))}
        }
        s.bindings.ptr[i]=FactBinding(p v at old)
    }
}
# An array local exposed only as raw storage (`xs.ptr`, `data(xs)`): the
# pointer reaches its elements, never its descriptor, so a call may change
# its elements but not its length. O(1).
fact_raw_exposed_array=(p:PlaceIdentity):>bool=>$unsafe {
    if p.root not=? 'local' or p.declaration <=? 0 {return false}
    let l=p.declaration
    let lent=LF_ADDR | LF_MUTPARAM | LF_SHARED | LF_CAPTURE | LF_CAPTURED | LF_BYREF | LF_EXPOSED | LF_ALIAS | LF_ELEMALIAS | LF_SOAELEM | LF_PARTBORROW | LF_OWNERBORROW
    ForgetWord(locals.ptr[l].flags) & lent =? LF_EXPOSED and tkind(fact_type(ForgetWord(locals.ptr[l].type))) =? 'array' and fact_dewy_local(l)
}
# A program function's `@` parameter: a text sink writes only the library's
# own output state, whose globals only the runtime names, so `printl` keeps the
# facts of `@pos` and `@inv`. O(1).
fact_sink_disjoint_param=(l:ForgetWord):>bool=>$unsafe {
    if ForgetWord(locals.ptr[l].flags) & LF_MUTPARAM =? 0 or not fact_dewy_local(l) {return false}
    let d=ForgetWord(fns.ptr[ForgetWord(locals.ptr[l].owner)].decl)
    d not=? 0 and not pos_in_lib(nodes.ptr[d].pos)
}
# Whether this analysis is of a library function. O(1).
fact_owner_in_lib=():>bool=>{
    fact_fn_in_lib(fact_owner)
}
fact_fn_in_lib=(f:ForgetWord):>bool=>$unsafe {
    if f <=? 0 or f >=? fns.length {return true}
    let d=ForgetWord(fns.ptr[f].decl)
    d =? 0 or pos_in_lib(nodes.ptr[d].pos)
}
# A place declared with a refined type holds its contract whatever changed it:
# every write to it was checked against that type. (A dependency names only
# stable bindings: ref_term.)
fact_holds_contract=(@s:FactState t:ForgetWord v:ForgetWord):>void=>{
    if refine_active and v not=? 0 {ref_assume(t v [] @s)}
}
# A call that never returns ends its path: what it writes is never read, so
# its callee tree is not summarized for it.
fact_ends_path=(n:ForgetWord):>bool=>$unsafe {
    ntype(n) =? T_NEVER or nodes.ptr[n].aux =? 0 and library_exit_call(n)
}
# A call needs length transfer only when its caller already tracks a mutable
# array's length. Reuse the bounded return summary, cached per function; no
# analysis for untouched/undemanded arrays. O(actual route depths + affected
# lengths), plus the existing once-per-callee, budgeted summary traversal.
fact_path_call_effects=(n:ForgetWord @s:FactState):>void=>$unsafe {
    if fact_ends_path(n) {effects_demand(0 true); return}
    let lengths:array<[int64 int64]>=[]
    let shapes:array<[int64 int64 int64]>=[]
    let record_lengths:array<[int64 int64 int64]>=[]
    if nodes.ptr[n].aux =? 0 and nodes.ptr[n].sym >? 0 and checked_call_mutmask(n) not=? 0 {
        let f=ForgetWord(nodes.ptr[n].sym)
        loop i in [0..min(nkids(n) fns.ptr[f].params.length)) {
            let l=fns.ptr[f].params[i]
            if ForgetWord(locals.ptr[l].flags) & LF_MUTPARAM =? 0 {continue}
            let pt=fact_type(ForgetWord(locals.ptr[l].type))
            if fact_record_arrays(pt) {
                fact_tracked_record_lengths(n i pt @s @record_lengths)
                continue
            }
            if tkind(pt) not=? 'array' and (tkind(pt) not=? 'struct_' or not is_nd(pt)) {continue}
            let v=fact_summary_actual(n i @s true)
            if v =? 0 {continue}
            if tkind(pt) not=? 'array' {
                let p=fact_projection_find(s v intern("shape") false)
                if p >=? 0 {shapes.push([i s.projections[p].value fact_nd_data_length(@s v)])}
            }
            else {
                let p=fact_projection_find(s v (-1) false)
                if p >=? 0 {lengths.push([i s.projections[p].value])}
            }
        }
    }
    let summary=FactSummary()
    let shape_mask:ForgetWord=0
    if shapes.length >? 0 {effects_demand(ForgetWord(nodes.ptr[n].sym) true);}
    if lengths.length >? 0 or shapes.length >? 0 or record_lengths.length >? 0 {
        if ForgetWord(nodes.ptr[n].sym) =? fact_summary_owner and fact_summary_assumed.length >? 0 {
            fact_summary_used=true
            summary.lengths=fact_summary_assumed
        }
        else {
            summary=fact_summary(ForgetWord(nodes.ptr[n].sym) true)
            if shapes.length >? 0 {shape_mask=fact_shape_summaries.get(ForgetWord(nodes.ptr[n].sym)) ?? 0}
        }
    }
    fact_call_effects(n @s)
    # Only an already demanded shape requests the bounded body summary. On
    # every returning path it must preserve both immutable identities; an
    # unknown write, replacement, callback or pending cleanup refuses reuse.
    # O(actual routes + tracked shapes), within the existing summary budget.
    loop entry in shapes {
        let i=entry[0]
        if i >=? 62 or shape_mask & (ForgetWord(1) << ForgetWord(i)) =? 0 {continue}
        let v=fact_summary_actual(n i @s)
        if v =? 0 or s.projections.length + 3 >=? FACT_CAP {continue}
        fact_add_projection(@s FactProjection(v intern("shape") false entry[1]))
        let data=fact_project(@s v intern("data") false mk_array(nd_elem(representation_type(fact_terms[v].type))))
        fact_add_projection(@s FactProjection(data (-1) false entry[2]))
    }
    loop pair in lengths {
        let i=pair[0]
        if i >=? summary.lengths.length or summary.lengths[i] =? 0 {continue}
        let v=fact_summary_actual(n i @s)
        if v =? 0 {continue}
        # An unchanged length is the SAME immutable evaluation. Reusing it
        # avoids chains of equalities through recursive calls and joins.
        if summary.lengths[i] =? 1 and s.projections.length <? FACT_CAP {
            fact_add_projection(@s FactProjection(v (-1) false pair[1]))
            continue
        }
        let after=fact_project(@s v (-1) false T_INT)
        fact_difference(@s pair[1] after 0 n)
        if summary.lengths[i] =? 1 {fact_difference(@s after pair[1] 0 n)}
        let b=fact_bound(s after)
        let old=fact_bound(s pair[1])
        let high=if summary.lengths[i] =? 1 {min(b.hi old.hi)} else {b.hi}
        fact_set_bound(@s after FactBound(max(b.lo old.lo) high))
    }
    # Record fields reuse exact lengths or carry the old length as a lower bound.
    loop entry in record_lengths {
        let mode=fact_field_mode(summary.kept_fields entry[0] entry[1])
        if mode =? 0 or s.projections.length >=? FACT_CAP {continue}
        let v=fact_summary_actual(n entry[0] @s)
        if v =? 0 {continue}
        let pt=fact_type(ForgetWord(locals.ptr[fns.ptr[ForgetWord(nodes.ptr[n].sym)].params[entry[0]]].type))
        let field=fact_project(@s v entry[1] false fact_call_field_type(pt entry[1]))
        if field =? 0 {continue}
        if mode =? 1 {fact_add_projection(@s FactProjection(field (-1) false entry[2]))}
        else {
            let after=fact_project(@s field (-1) false T_INT)
            fact_difference(@s entry[2] after 0 n)
            let b=fact_bound(s after)
            fact_set_bound(@s after FactBound(max(b.lo fact_bound(s entry[2]).lo) b.hi))
        }
    }
}
# Names are positive interned IDs; a negative field records growth only.
# At most eight demanded fields per summary, no scan of unrelated state.
fact_field_mode=(kept:array<int64> parameter:ForgetWord field:ForgetWord):>ForgetWord=>$unsafe {
    let i:ForgetWord=0
    loop i + 1 <? kept.length {
        if kept.ptr[i] =? parameter {
            if kept.ptr[i + 1] =? field {return 1}
            if kept.ptr[i + 1] =? -field {return 2}
        }
        i += 2
    }
    0
}
fact_kept_field=(kept:array<int64> parameter:ForgetWord field:ForgetWord):>bool=>$unsafe {
    let i:ForgetWord=0
    loop i + 1 <? kept.length {
        if kept.ptr[i] =? parameter and kept.ptr[i + 1] =? field {return true}
        i += 2
    }
    false
}
# (the array fields of a mutable record actual whose length this state tracks: the demand for
# their summary. O(fields), at most eight, as the summary's own list)
fact_tracked_record_lengths=(n:ForgetWord i:ForgetWord pt:ForgetWord @s:FactState @out:array<[int64 int64 int64]>):>void=>$unsafe {
    let v=fact_summary_actual(n i @s true)
    if v =? 0 {return}
    let si=ForgetWord(types.ptr[pt].st)
    loop k in [0..min(ForgetWord(structs.ptr[si].nfields) 8)) {
        let name=ForgetWord(fields.ptr[ForgetWord(structs.ptr[si].fields) + k].name)
        let p=fact_projection_find(s v name false)
        if p <? 0 {continue}
        let q=fact_projection_find(s s.projections[p].value (-1) false)
        if q >=? 0 {out.push([i name s.projections[q].value])}
    }
}
# A settled summary can preserve exposed roots across read-only calls.
# Opaque/callback/hidden-helper effects still invalidate every exposed root.
fact_call_effects=(n:ForgetWord @s:FactState):>void=>$unsafe {
    let f=ForgetWord(nodes.ptr[n].sym)
    fact_forget_mutable_maps(n @s)
    # Formatting operands have already run. These bundled text sinks touch
    # runtime output buffers only, never a program's global or lent places.
    # Keep their full I/O/cost effects; this is solely a write-footprint rule.
    if nodes.ptr[n].aux =? 0 and fact_text_sink(f) {fact_forget(@s n 'call' text_sink=true); return}
    # (a callee opaque by its signature forgets the same exposed roots its
    # summary would: its call tree is not visited for it)
    if nodes.ptr[n].aux =? 0 and f >? 0 and f <? fns.length and not (fns.ptr[f].body not=? 0 and fns.ptr[f].state not=? 2) and effect_signature_opaque(f) {
        # A reviewed library class writes only its mutable actuals. With
        # none, allocator/bookkeeping opacity cannot change caller places.
        # Reuse the cached contract, O(1); do not walk a runtime call tree.
        if checked_call_mutmask(n) =? 0 and effect_library_class(f) not=? EffectClass.unclassified {return}
        effects_demand(0 true);
        fact_forget_call(@s n 'call')
        return
    }
    # (a return summary's run does not settle callee effect rows for itself:
    # a callee not yet settled forgets every exposed root, as an opaque call)
    if fact_summary_owner not=? 0 and nodes.ptr[n].aux =? 0 and f >? 0 and f <? effect_summaries.length and not effect_summaries.ptr[f].done {
        fact_forget_call(@s n 'call')
        return
    }
    # (a call can change only exposed roots and its place arguments: with
    # neither bound here, its effect row has nothing to tell this state)
    if nodes.ptr[n].aux =? 0 and checked_call_mutmask(n) =? 0 and not fact_exposed_bound(s) {return}
    if fact_probe_on and nodes.ptr[n].aux =? 0 {fact_probe_note(f)}
    if nodes.ptr[n].aux not=? 0 or not effects_demand(f true) {
        fact_forget_call(@s n 'call')
        return
    }
    if fns.ptr[f].body not=? 0 and fns.ptr[f].state not=? 2 {
        fact_forget_call(@s n 'callee')
        return
    }
    let events=effect_summaries.ptr[f].events
    loop e in [0..events.length) {
        if events.ptr[e].atom.kind not=? 'opaque' {continue}
        # (opaque only for calls of its own callbacks, known here: their rows
        # instead, fact_callback_events)
        # (with no exposed fact at stake the opaque call forgets nothing more)
        let known:array<EffectEvent>=[]
        if not fact_exposed_bound(s) or not fact_callback_ready(f) or not fact_callback_events(n f @known) {
            fact_forget_call(@s n 'call')
            return
        }
        loop event in effect_summaries.ptr[f].events {
            if event.atom.kind not=? 'opaque' {known.push(event);}
        }
        events=known
        break
    }
    loop e in [0..events.length) {
        let kind=events.ptr[e].atom.kind
        # (a library caller's own facts may describe the output state a helper's text sink writes)
        if kind =? 'opaque' or kind =? 'escape' or kind =? 'io' and fact_owner_in_lib() {
            fact_forget_call(@s n 'call')
            return
        }
    }
    # (an element place argument, `hurt(@fs[i])`, changes only what the
    # callee writes in it: its written paths, on every tracked element)
    let routed:dict<int64 array<array<int64>>>=[]
    loop e in [0..events.length) {
        if events.ptr[e].atom.kind not=? 'write' {continue}
        let p=place_base(events.ptr[e].atom.place)
        let i=p.declaration - 1
        if p.root not=? 'formal' or i <? 0 or i >=? nkids(n) or fact_routed_place(kid(n i)) =? 0 {continue}
        let paths=routed.get(i) ?? []
        paths.push(place_path(events.ptr[e].atom.place))
        routed[i]=paths
    }
    if routed.length >? 0 {
        loop i in [0..nkids(n)) {
            let paths=routed.get(i)
            if paths not=? none {fact_routed_write(@s kid(n i) n 'call' paths);}
        }
    }
    let groups:array<FactCallWrites>=[]
    let by_root:array<int64>=[]
    loop e in [0..events.length) {
        if events.ptr[e].atom.kind not=? 'write' {continue}
        let route=events.ptr[e].atom.place
        let p=place_base(route)
        let path=place_path(route)
        if p.root =? 'formal' {
            let i=p.declaration - 1
            if i <? 0 or i >=? nkids(n) {fact_forget_call(@s n 'call'); return}
            if routed.has(i) {continue}
            let actual=place_route(kid(n i))
            p=place_base(actual)
            if actual.parent not=? 0 {path=[place_path(actual)... path...]}
        }
        if p.declaration =? 0 {fact_forget_call(@s n 'call'); return}
        let i=fact_binding(s p)
        if i <? 0 {
            if fact_exposed(p) {fact_forget(@s n 'call' false p)}
            continue
        }
        let old=s.bindings[i].value
        if path.length =? 0 or fact_projection_first(s old) <? 0 {
            if fact_exposed(p) {fact_forget(@s n 'call' false p true)}
            let t=if p.root =? 'local' {ForgetWord(locals.ptr[p.declaration].type)} else {ForgetWord(globals.ptr[p.declaration].type)}
            let value=fact_new(@s fact_domain(t 'call' n) FactTerm(type=t))
            fact_holds_contract(@s t value)
            fact_rebind(@s p value n old)
            continue
        }
        let g=fact_index_get(by_root i)
        if g <? 0 {
            g=groups.length
            fact_index_put(@by_root i g)
            groups.push(FactCallWrites(p i))
        }
        let group_paths=groups[g].paths
        group_paths.push(path)
        groups[g].paths=group_paths
    }
    loop group in groups {
        let p=group.place
        let old=s.bindings[group.binding].value
        # Other exposed roots may alias this one. Read the old value only
        # after earlier groups have invalidated any such alias.
        if fact_exposed(p) {fact_forget(@s n 'call' false p true)}
        let t=if p.root =? 'local' {ForgetWord(locals.ptr[p.declaration].type)} else {ForgetWord(globals.ptr[p.declaration].type)}
        let value=fact_call_write(@s old t group.paths 0 n)
        fact_rebind(@s p value n old)
    }
}
# The function a callback argument runs: a literal lambda or a named
# function with no environment, whose effect row is settled (a summary run
# uses only rows already settled; otherwise demanded here). 0 when unknown.
fact_callback_fn=(e0:ForgetWord):>ForgetWord=>$unsafe {
    let e=e0
    loop nodes.ptr[e].kind =? 'conv' {e=ForgetWord(nodes.ptr[e].a)}
    let f:ForgetWord=0
    if nodes.ptr[e].kind =? 'lambda' and not has_flag(e NF_GENERIC) {f=ForgetWord(nodes.ptr[e].sym)}
    else if nodes.ptr[e].kind =? 'fnref' and nodes.ptr[e].aux not=? 1 and nodes.ptr[e].aux not=? 2 and nodes.ptr[e].sym >? 0 and not fns.ptr[ForgetWord(nodes.ptr[e].sym)].has_env {f=ForgetWord(nodes.ptr[e].sym)}
    if f <=? 0 or f >=? fns.length {return 0}
    if fact_summary_owner not=? 0 and (f >=? effect_summaries.length or not effect_summaries.ptr[f].done) {return 0}
    if not effects_demand(f true) {return 0}
    f
}
# Callee f's row is complete and opaque only for its own callbacks. A
# footprint scan stops at a callback call (EffectSummary.cut) until a call
# needs those rows: the first, outside summary runs and effect traversals,
# rebuilds the footprint graph to scan past them for the rest of the compile
# (once per compile; programs that never need it pay nothing).
fact_callback_ready=(f:ForgetWord):>bool=>$unsafe {
    if effect_summaries.ptr[f].opaque_other or effect_summaries.ptr[f].callbacks =? 0 {return false}
    if not effect_summaries.ptr[f].cut {return true}
    if effect_callbacks_full or fact_summary_owner not=? 0 or not effect_footprints_only or effect_stack.length >? 0 or effect_solving or effect_inference_busy {return false}
    effect_callbacks_full=true
    effect_graph_reset()
    effect_footprints_only=true
    if not effects_demand(f true) {return false}
    not effect_summaries.ptr[f].opaque_other and effect_summaries.ptr[f].callbacks not=? 0 and not effect_summaries.ptr[f].cut
}
# Call n's callee f is opaque only for calls of its own callbacks
# (EffectSummary.callbacks). With each one's argument known here, those calls
# do what the argument's settled row says: its events go to out, unless one
# is opaque, escapes, or writes a place other than a global (a write to its
# own formal reaches a place f chose). O(callbacks + their rows).
fact_callback_events=(n:ForgetWord f:ForgetWord @out:array<EffectEvent>):>bool=>$unsafe {
    let mask=ForgetWord(effect_summaries.ptr[f].callbacks)
    if effect_summaries.ptr[f].opaque_other or effect_summaries.ptr[f].cut or mask =? 0 {return false}
    loop i in [0..min(nkids(n) 62)) {
        if mask & (ForgetWord(1) << i) =? 0 {continue}
        mask=mask & ~(ForgetWord(1) << i)
        let g=fact_callback_fn(kid(n i))
        if g =? 0 {return false}
        loop event in effect_summaries.ptr[g].events {
            let kind=event.atom.kind
            if kind =? 'opaque' or kind =? 'escape' or kind =? 'remainder' {return false}
            if kind =? 'write' and event.atom.place.root not=? 'global' {return false}
            out.push(event);
        }
    }
    mask =? 0
}
# A callback argument that writes no place outside its own locals: a literal
# lambda or a named function whose settled effect row holds no write, escape
# or opaque event. Calling it changes no caller place through any alias.
# O(row) once the callee's row is settled, on demand.
fact_callback_writes_nothing=(e0:ForgetWord):>bool=>$unsafe {
    let f=fact_callback_fn(e0)
    if f =? 0 {return false}
    loop event in effect_summaries.ptr[f].events {
        let kind=event.atom.kind
        if kind =? 'write' or kind =? 'escape' or kind =? 'opaque' or kind =? 'remainder' {return false}
    }
    true
}
# Scalars can select a program formatter. Only the resolved builtin word
# leaf or reviewed library formatter has no external writes.
fact_builtin_formatter=(part:ForgetWord):>bool=>$unsafe {
    let f=ForgetWord(nodes.ptr[part].sym)
    if f <=? 0 {return false}
    if f =? (runtime_insts.get("__fmt_word") ?? 0) {return true}
    effect_library_class(f) not=? EffectClass.unclassified
}
fact_text_sink=(f:ForgetWord):>bool=>$unsafe {
    if f <=? 0 or f >=? fns.length {return false}
    let known=fact_text_sinks.get(f)
    if known not=? none {return known}
    let d=ForgetWord(fns.ptr[f].decl)
    let sink=false
    if d not=? 0 and nodes.ptr[d].kind =? 'fn_' and fns.ptr[f].params.length =? 1 {
        let name=name_of(ForgetWord(nodes.ptr[d].name))
        let path=files[pos_file(nodes.ptr[d].pos)].path
        sink=(name =? "__print_str" and path =? "{lib_dir}/core/rt.jo" or name =? "write" and path =? "{lib_dir}/core/os.jo") and ForgetWord(locals.ptr[fns.ptr[f].params[0]].type) =? T_STR
    }
    fact_text_sinks[f]=sink
    sink
}
fact_call_field_type=(t:ForgetWord selector:ForgetWord):>ForgetWord=>{
    let known=fact_call_field_types.get([t selector])
    if known not=? none {return known}
    let ft=shape_field_type(t selector)
    fact_call_field_types[[t selector]]=ft
    ft
}
fact_call_write=(@s:FactState old:ForgetWord t:ForgetWord paths:array<array<int64>> depth:ForgetWord at:ForgetWord):>ForgetWord=>{
    let whole=false
    loop path in paths {
        if depth >=? path.length {whole=true}
    }
    let fresh=fact_new(@s fact_domain(t 'call' at) FactTerm(type=t))
    let pi=fact_projection_first(s old)
    if whole or pi <? 0 or tkind(fact_type(t)) not=? 'struct_' or is_map_type(fact_type(t)) or fact_pool_type(t) {
        fact_holds_contract(@s t fresh)
        return fresh
    }
    # Index the written children, then visit each demanded projection once.
    # No projection is created for an unread or wholly overwritten field.
    let replaced:array<int64>=[]
    let by_field=dict<int64 array<array<int64>>>()
    loop path in paths {
        let selector=path[depth]
        if depth + 1 =? path.length {fact_index_put(@replaced selector 1); continue}
        let routes=by_field.get(selector) ?? []
        routes.push(path)
        by_field[selector]=routes
    }
    let prior=s.projections
    let links=s.index[0].projection_next
    loop pi >=? 0 {
        let p=prior[pi]
        pi=fact_projection_next_in(prior links pi)
        if p.element or p.selector <? 0 or fact_index_get(replaced p.selector) >=? 0 {continue}
        let routes=by_field.get(p.selector) ?? []
        let value=p.value
        if routes.length >? 0 {
            let ft=fact_call_field_type(fact_type(t) p.selector)
            if ft =? 0 {continue}
            value=fact_call_write(@s value ft routes depth + 1 at)
        }
        if s.projections.length <? FACT_CAP {fact_add_projection(@s FactProjection(fresh p.selector false value))}
    }
    fresh
}
# Lifecycle footprints. A drop, copy or move hook runs only at an owning
# boundary: a statement's end for the temporaries it drops and the places it
# replaces, a block's end for its owners, a match's or binding's end for the
# owner it took, a function's exits for its owners and owned parameters.
# There facts forget only what the hooks that can run there may change, from
# their settled effect rows: [flags globals...], flag 1 any exposed place (an
# opaque, escaping or unsettled hook, a callable's captures), 2 I/O. A
# hook's own receiver is the value leaving its place: its writes change no
# place another statement reads. Demanded at those sites only, in programs
# declaring a hook; cached per type and per site: O(component types + hook
# events) and O(site nodes), once each.
fact_drop_footprint=(t0:ForgetWord):>array<int64>=>$unsafe {
    let t=ow_representation(t0)
    let known=fact_drop_types.get(t)
    if known not=? none {return known}
    let out:array<int64>=[0]
    let seen:array<int64>=[]
    if fact_drop_type(t @out @seen 0) {fact_drop_types[t]=out}
    out
}
# (false when a hook's row was not settled for a return summary's run: the
# answer is then the unknown footprint, not cached)
fact_drop_type=(t:ForgetWord @out:array<int64> @seen:array<int64> depth:ForgetWord):>bool=>$unsafe {
    if out[0] & 1 not=? 0 or seen.contains(t) {return true}
    if depth >? 32 or ownership_callable_cap(t) not=? 0 {
        out[0]=out[0] | 1
        return true
    }
    seen.push(t)
    let k=tkind(t)
    if k =? 'fixed' or k =? 'array' or k =? 'opt' or k =? 'box' {return fact_drop_type(ow_representation(telem(t)) @out @seen depth + 1)}
    if k not=? 'tuple' and k not=? 'enum_' and k not=? 'struct_' {return true}
    let settled=true
    if k =? 'struct_' {
        let si=ForgetWord(types.ptr[t].st)
        settled=fact_drop_hook(ForgetWord(structs.ptr[si].drop_fn) true @out)
        settled=fact_drop_hook(ownership_copies.get(t) ?? 0 false @out) and settled
        settled=fact_drop_hook(ownership_moves.get(t) ?? 0 true @out) and settled
        settled=fact_drop_hook(owner_map_copies.get(t) ?? 0 false @out) and settled
        let parent=ow_parents[0].get(t) ?? 0
        if parent not=? 0 {settled=fact_drop_type(ow_representation(parent) @out @seen depth + 1) and settled}
    }
    let parts=if k =? 'enum_' {ow_variant_types(t)} else {ow_field_types(t)}
    loop ft in parts {
        if ownership_fact_type(ft) {settled=fact_drop_type(ow_representation(ft) @out @seen depth + 1) and settled}
    }
    settled
}
fact_drop_hook=(g:ForgetWord receiver:bool @out:array<int64>):>bool=>$unsafe {
    if g <=? 0 or out[0] & 1 not=? 0 {return true}
    if g >=? fns.length or fns.ptr[g].body =? 0 or fns.ptr[g].state not=? 2 {
        out[0]=out[0] | 1
        return true
    }
    # (a return summary's run does not settle callee rows: fact_call_effects)
    if fact_summary_owner not=? 0 and (g >=? effect_summaries.length or not effect_summaries.ptr[g].done) {
        out[0]=out[0] | 1
        return false
    }
    if not effects_demand(g true) {
        out[0]=out[0] | 1
        return true
    }
    let events=effect_summaries.ptr[g].events
    loop e in [0..events.length) {
        let kind=events.ptr[e].atom.kind
        if kind =? 'opaque' or kind =? 'escape' {
            out[0]=out[0] | 1
            return true
        }
        if kind =? 'io' {out[0]=out[0] | 2}
        if kind not=? 'write' {continue}
        let p=place_base(events.ptr[e].atom.place)
        if p.root =? 'global' and p.declaration >? 0 {fact_drop_global(@out p.declaration)}
        else if not (receiver and p.root =? 'formal' and p.declaration =? 1) {
            out[0]=out[0] | 1
            return true
        }
    }
    true
}
fact_drop_global=(@out:array<int64> g:ForgetWord):>void=>{
    loop i in [1..out.length) {
        if out[i] =? g {return}
    }
    out.push(g)
}
fact_drop_union=(@out:array<int64> fp:array<int64>):>void=>{
    out[0]=out[0] | fp[0]
    loop i in [1..fp.length) {fact_drop_global(@out fp[i])}
}
fact_drop_add=(@out:array<int64> t:ForgetWord):>bool=>{
    fact_drop_union(@out fact_drop_footprint(t))
    fact_drop_types.has(ow_representation(t))
}
# Whether a footprint can change anything this function's facts describe.
fact_drop_any=(fp:array<int64>):>bool=>{
    fp.length >? 1 or fp[0] & 1 not=? 0 or fp[0] & 2 not=? 0 and fact_owner_in_lib()
}
# What a statement's own boundaries may run: the hooks of the temporaries it
# drops, of the places it replaces, of the owners it passes by value. A
# nested block's statements and end, and a closure's body, are sites of
# their own. O(the statement's nodes outside nested blocks), once.
fact_drop_statement=(c:ForgetWord):>array<int64>=>$unsafe {
    let key=c * 4
    let known=fact_drop_sites.get(key)
    if known not=? none {return known}
    let out:array<int64>=[0]
    if fact_drop_scan(c 0 @out false) {fact_drop_sites[key]=out}
    out
}
# A block's end drops the owners its declarations made, after its defers.
fact_drop_block=(n:ForgetWord):>array<int64>=>$unsafe {
    let key=n * 4 + 1
    let known=fact_drop_sites.get(key)
    if known not=? none {return known}
    let out:array<int64>=[0]
    if fact_drop_block_into(n @out) {fact_drop_sites[key]=out}
    out
}
# (an unscoped `( ... )` block's declarations are its enclosing block's, NF_UNSCOPED 4)
fact_drop_block_into=(n:ForgetWord @out:array<int64>):>bool=>$unsafe {
    let settled=true
    loop j in [0..nkids(n)) {
        let c=kid(n j)
        let k=nodes.ptr[c].kind
        if k =? 'vardecl' and nodes.ptr[c].sym >? 0 and not has_flag(c NF_GLOBAL) and not has_flag(c NF_ALIASDECL) {
            let t=ForgetWord(locals.ptr[ForgetWord(nodes.ptr[c].sym)].type)
            if ownership_fact_type(t) {settled=fact_drop_add(@out t) and settled}
        }
        else if k =? 'defer_' {settled=fact_drop_scan(ForgetWord(nodes.ptr[c].a) 0 @out false) and settled}
        else if k =? 'block' and has_flag(c 4) {settled=fact_drop_block_into(c @out) and settled}
    }
    settled
}
# Everything a function's exits may drop: every owner its body declares,
# takes, copies or replaces, and its owned parameters. O(body nodes), once.
fact_drop_exit=(f:ForgetWord):>array<int64>=>$unsafe {
    let body=ForgetWord(fns.ptr[f].body)
    let key=body * 4 + 3
    let known=fact_drop_sites.get(key)
    if known not=? none {return known}
    let out:array<int64>=[0]
    let settled=fact_drop_scan(body 0 @out true)
    loop i in [0..fns.ptr[f].params.length) {
        let l=fns.ptr[f].params.ptr[i]
        let t=ForgetWord(locals.ptr[l].type)
        # A borrowed method receiver has no cleanup at this function's exit.
        if i =? 0 and effect_method_borrows(f) {continue}
        if ForgetWord(locals.ptr[l].flags) & LF_MUTPARAM =? 0 and ownership_fact_type(t) {settled=fact_drop_add(@out t) and settled}
    }
    if settled {fact_drop_sites[key]=out}
    out
}
# Everything a loop's or region's trips may drop: every owner it declares,
# takes, copies or replaces, nested blocks included. O(region nodes), once.
fact_drop_region=(n:ForgetWord):>array<int64>=>$unsafe {
    let key=n * 4 + 2
    let known=fact_drop_sites.get(key)
    if known not=? none {return known}
    let out:array<int64>=[0]
    if fact_drop_scan(n 0 @out true) {fact_drop_sites[key]=out}
    out
}
# Whether cleanup at f's exits may change what its return summary records.
fact_drop_pending=(f:ForgetWord):>bool=>$unsafe {
    if not ownership_fact_cleanup or f <=? 0 or f >=? fns.length or fns.ptr[f].body =? 0 {return ownership_fact_cleanup}
    fact_drop_any(fact_drop_exit(f))
}
# A deep scan also enters nested blocks, with the owners their ends drop
# (declarations) and those a match or binding drops at its end.
fact_drop_scan=(n:ForgetWord parent:ForgetWord @out:array<int64> deep:bool):>bool=>$unsafe {
    if n <=? 0 or out[0] & 1 not=? 0 {return true}
    let k=nodes.ptr[n].kind
    # (a pattern evaluates no owner: its bindings drop at its match's end)
    if k =? 'lambda' or k =? 'ptype' or k =? 'pshape' or k =? 'pseq' or k =? 'block' and not deep and parent not=? 0 {return true}
    let settled=true
    if fact_drop_counted(n parent) {settled=fact_drop_add(@out ntype(n))}
    # (an assignment drops the place's old owner)
    if k =? 'assign' and ownership_fact_type(ntype(ForgetWord(nodes.ptr[n].a))) {settled=fact_drop_add(@out ntype(ForgetWord(nodes.ptr[n].a))) and settled}
    if deep and k =? 'vardecl' and nodes.ptr[n].sym >? 0 and not has_flag(n NF_GLOBAL) and not has_flag(n NF_ALIASDECL) {
        let t=ForgetWord(locals.ptr[ForgetWord(nodes.ptr[n].sym)].type)
        if ownership_fact_type(t) {settled=fact_drop_add(@out t) and settled}
    }
    if deep and (k =? 'match_' or k =? 'iflet') and ownership_fact_type(ntype(ForgetWord(nodes.ptr[n].a))) {settled=fact_drop_add(@out ntype(ForgetWord(nodes.ptr[n].a))) and settled}
    let mask=isolation_children(k)
    if mask <? 0 {
        out[0]=out[0] | 1
        return true
    }
    if mask & 1 not=? 0 {settled=fact_drop_scan(ForgetWord(nodes.ptr[n].a) n @out deep) and settled}
    if mask & 2 not=? 0 {settled=fact_drop_scan(ForgetWord(nodes.ptr[n].b) n @out deep) and settled}
    if mask & 4 not=? 0 {settled=fact_drop_scan(ForgetWord(nodes.ptr[n].c) n @out deep) and settled}
    if mask & 16 not=? 0 {
        loop i in [0..nkids(n)) {settled=fact_drop_scan(kid(n i) n @out deep) and settled}
    }
    settled
}
# A method call's receiver (its first argument) is borrowed, not moved: its
# owner drops it later, so passing it runs no hook. O(1).
fact_borrowed_receiver=(call:ForgetWord):>bool=>$unsafe {
    nodes.ptr[call].aux =? 0 and nodes.ptr[call].sym >? 0 and effect_method_borrows(ForgetWord(nodes.ptr[call].sym))
}
# An owner-typed node at an owning boundary of its statement: a temporary
# the statement drops, an owner passed by value (the callee may drop it), a
# copy. A place read borrows (a transfer by declaration, assignment or
# return is fact_owner_value's), and a fresh result a declaration,
# assignment, return or record field takes is adopted, running no hook.
fact_drop_counted=(n:ForgetWord parent:ForgetWord):>bool=>$unsafe {
    let k=nodes.ptr[n].kind
    if k =? 'vardecl' or k =? 'assign' or k =? 'addr' or not ownership_fact_type(ntype(n)) {return false}
    if parent =? 0 {return true}
    let pk=nodes.ptr[parent].kind
    if k =? 'ident' or k =? 'field' or k =? 'index' or k =? 'narrow' {
        if pk =? 'call' and nkids(parent) >? 0 and kid(parent 0) =? n and fact_borrowed_receiver(parent) {return false}
        if pk =? 'call' or pk =? 'partial' or pk =? 'intrinsic' or pk =? 'array' or pk =? 'tuple' or pk =? 'map_lit' or pk =? 'pair' {return true}
        return k =? 'index' and (pk =? 'vardecl' or pk =? 'assign' or pk =? 'return_')
    }
    if k =? 'call' and (pk =? 'vardecl' or pk =? 'assign' or pk =? 'return_' or pk =? 'call' and nodes.ptr[parent].aux =? 2) {return false}
    true
}
# Forget what a footprint may change: any exposed place for an unknown hook
# (and, as for calls, for I/O in a library body); otherwise each written
# global and every exposed place whose storage can lie inside one (an `@`
# parameter or alias bound to it or a part of it). O(bindings × written
# globals × their component types).
fact_drop_forget=(@s:FactState at:ForgetWord fp:array<int64>):>void=>$unsafe {
    if not fact_drop_any(fp) {return}
    if fp[0] & 1 not=? 0 or fp[0] & 2 not=? 0 and fact_owner_in_lib() {
        fact_forget(@s at 'call')
        return
    }
    loop i in [0..s.bindings.length) {
        let p=s.bindings.ptr[i].place
        if not fact_exposed(p) {continue}
        let t=if p.root =? 'local' {ForgetWord(locals.ptr[p.declaration].type)} else {ForgetWord(globals.ptr[p.declaration].type)}
        let hit=false
        loop j in [1..fp.length) {
            if p.root =? 'global' {hit=hit or p.declaration =? fp[j]}
            else {hit=hit or fact_type_reaches(ForgetWord(globals.ptr[fp[j]].type) t)}
        }
        if not hit {continue}
        let v=fact_new(@s fact_domain(t 'call' at) FactTerm(type=t))
        fact_holds_contract(@s t v)
        s.bindings.ptr[i]=FactBinding(p v at s.bindings.ptr[i].value)
    }
}
# Whether storage of type lt can lie inside storage of type gt (or be it).
# Cached per pair; O(gt's component types) once, depth 8.
fact_type_reaches=(gt:ForgetWord lt:ForgetWord):>bool=>{
    let key=gt * 4294967296 + lt
    let known=fact_reach_cache.get(key)
    if known not=? none {return known}
    let reaches=fact_type_opaque(ow_representation(lt)) or fact_drop_reaches(gt ow_representation(lt) 0)
    fact_reach_cache[key]=reaches
    reaches
}
fact_type_opaque=(t:ForgetWord):>bool=>$unsafe {
    let k=tkind(t)
    k =? 'ptr' or k =? 'var' or k =? 'param' or k =? 'callable' or k =? 'fn_' or k =? 'cfn'
}
# Whether two types may name the same storage: one type, or one kind of
# scalar (`int32` and `int64<overflow='wrap'>` are not told apart) or of
# container over such storage. O(nesting).
fact_type_same=(a:ForgetWord b:ForgetWord):>bool=>$unsafe {
    if a =? b {return true}
    let k=tkind(a)
    if k not=? tkind(b) {return false}
    if fact_type_leaf(a) {return true}
    if k =? 'array' or k =? 'fixed' or k =? 'opt' or k =? 'box' {return fact_type_same(ow_representation(telem(a)) ow_representation(telem(b)))}
    false
}
# A type without component storage or addresses.
fact_type_leaf=(t:ForgetWord):>bool=>$unsafe {
    let k=tkind(t)
    k =? 'int_' or k =? 'float_' or k =? 'bool_' or k =? 'str_' or k =? 'void_' or k =? 'null_' or k =? 'none_lit' or k =? 'range' or k =? 'vec' or k =? 'quantity' or k =? 'dimension'
}
fact_drop_reaches=(gt0:ForgetWord lt:ForgetWord depth:ForgetWord):>bool=>$unsafe {
    let gt=ow_representation(gt0)
    if depth >? 8 or fact_type_same(gt lt) {return true}
    let k=tkind(gt)
    if k =? 'array' or k =? 'fixed' or k =? 'opt' or k =? 'box' {return fact_drop_reaches(telem(gt) lt depth + 1)}
    if k =? 'tuple' or k =? 'struct_' or k =? 'enum_' {
        let parts=if k =? 'enum_' {ow_variant_types(gt)} else {ow_field_types(gt)}
        loop ft in parts {
            if fact_drop_reaches(ft lt depth + 1) {return true}
        }
        return false
    }
    not fact_type_leaf(gt)
}

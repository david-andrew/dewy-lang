$runtime_checks
from p"expression_types.dewy" import (ntype)

from p"effect_types.dewy" import (EffectAtom)
from p"ast.jo" import (NF_EXTERN has_flag kid kid2 kids lists nkids nkids2 nodes)
from p"effect_contracts.dewy" import (callable_contract)
from p"concurrency_types.dewy" import (concurrency_transfer concurrency_why)
from p"concurrency.jo" import (concurrency_block_memo)
from p"effect_lattice.dewy" import (effect_allows)
from p"effects.jo" import (effect_contracts)
from p"effect_sources.dewy" import (effect_source_row)
from p"util.jo" import (files name_of pos_file)
from p"diagnostic_exit.dewy" import (fatal)
from p"check.jo" import (fns lib_dir modules)
from p"checker_signature.dewy" import (fn_sig)
from p"isolation_ops.dewy" import (iso_child_p isolation_children)
from p"policy_value_queries.dewy" import (setting_value_target)
from p"types.jo" import (tkind)
from p"ownership_hooks.dewy" import (ownership_literal_print)
from p"lower_helpers.dewy" import (value_helper_calls)
from p"concurrency_parsafe.dewy" import (parsafe_is_param parsafe_vouched_nonblocking)
from p"lower_races.dewy" import (local_literal_fn)
from p"node_store.dewy" import (NK Node node_sval)
# Demanded waiting-effect queries; shared state has one owner in concurrency.jo.
WaitingWord:type=int64<overflow='wrap'>
let cw_file_class:array<int8>=[]
let cw_file_path:array<string>=[]
let cw_file_lib:string=""
cw_classify_file=(fi:WaitingWord):>int8=>$unsafe {
    if cw_file_lib not=? lib_dir {
        cw_file_class.clear()
        cw_file_path.clear()
        cw_file_lib=lib_dir
    }
    let p=files.ptr[fi].path
    if fi <? cw_file_class.length {
        let c=cw_file_class.ptr[fi]
        if c not=? int8(0) and cw_file_path.ptr[fi] =? p {return c}
    } else {
        let need=max(fi + 16 files.length + 16)
        cw_file_class.resize(need)
        cw_file_path.resize(need)
    }
    let cls:int8=int8(1)
    if p =? "{lib_dir}/std/tasks.jo" {cls=int8(2)}
    else if p =? "{lib_dir}/std/thread.jo" {cls=int8(3)}
    else if p =? "{lib_dir}/prelude/mpmc.jo" {cls=int8(4)}
    else if p =? "{lib_dir}/prelude/spsc.jo" {cls=int8(5)}
    else if p =? "{lib_dir}/std/task_core.jo" {cls=int8(6)}
    else if p =? "{lib_dir}/std/settings.jo" or p =? "{lib_dir}/runtime/settings_frames.jo" or p =? "{lib_dir}/runtime/settings_permits.jo" or p =? "{lib_dir}/core/rt.jo" {cls=int8(7)}
    cw_file_class[fi]=cls
    cw_file_path[fi]=p
    cls
}
let cw_seen_gen:array<int32>=[]
let cw_seen_list:array<int32>=[]
let cw_seen_cur:int32=0
let cw_seen_active:bool=false

concurrency_fn_blocks=(f:WaitingWord):>bool=>$unsafe {
    if concurrency_block_memo.has(f) {return concurrency_block_memo[f]}
    if not cw_seen_active {
        if cw_seen_gen.length <=? fns.length {cw_seen_gen.resize(fns.length + 64)}
        cw_seen_cur=int32<overflow='wrap'>(int64(cw_seen_cur) + 1)
        if cw_seen_cur =? int32(0) {
            mem_set(cw_seen_gen.ptr as ptr<uint8> 0 cw_seen_gen.length * 4)
            cw_seen_cur=int32(1)
        }
        cw_seen_list.clear()
        cw_seen_active=true
        let dummy:dict<int64 bool>=[]
        let r=concurrency_blocks(f @dummy)
        cw_seen_active=false
        if r {concurrency_block_memo[f] = true;}
        else {
            let lp=cw_seen_list.ptr
            let ln:WaitingWord=cw_seen_list.length
            loop i in [WaitingWord(0)..ln) {concurrency_block_memo[WaitingWord(lp[i])] = false;}
        }
        return r
    }
    let seen:dict<int64 bool>=dict<int64 bool>()
    let r=concurrency_blocks(f @seen)
    if r {concurrency_block_memo[f] = true;}
    else {
        loop g in seen.keys() {concurrency_block_memo[g] = false;}
    }
    return r
}
concurrency_blocks=(f:WaitingWord @seen:dict<int64 bool> sharing:bool=false):>bool=>$unsafe {
    if f <=? 0 or f >=? fns.length {return true}
    if not sharing and concurrency_block_memo.has(f) {return concurrency_block_memo[f]}
    if not sharing and cw_seen_active {
        if f >=? cw_seen_gen.length {cw_seen_gen.resize(f + 64)}
        if cw_seen_gen.ptr[f] =? cw_seen_cur {return false}
        cw_seen_gen.ptr[f]=cw_seen_cur
        cw_seen_list.push(int32<overflow='wrap'>(f))
    } else {
        if seen.has(f) {return false}
        seen[f] = true;
    }
    let d:WaitingWord=WaitingWord(fns.ptr[f].decl)
    if d =? 0 {return true}
    if modules.ptr[WaitingWord(fns.ptr[f].mod)].is_prelude {
        # Blocking public boundaries. Fork-join is safe inline and is not a
        # waiting-lane join. Its checked callbacks supply the obligations.
        if fns.ptr[f].parallel_api {return false}
        let fc=cw_classify_file(pos_file(nodes.ptr[d].pos))
        if fc =? int8(2) {return true}
        let name=name_of(WaitingWord(nodes.ptr[d].name))
        if name =? "sleep" or name =? "__sleep_ns" or name =? "read_file" or name =? "write_file" or name =? "read_line" or name =? "read_stdin" or name =? "print" or name =? "printl" or name =? "__print_str" or name =? "write" or name =? "flush" or name =? "__task_join" or name =? "__group_join" {return true}
        # Runtime internals are trusted nonblocking unless classified here;
        # raw syscalls/foreign code in user modules remain conservative.
        # (a channel's waits are the waiting lane's: a parallel body must not wait on a sibling)
        if fc =? int8(3) {
            return name =? "__chan_send_wait" or name =? "__chan_receive_wait" or name =? "__chan_send_wait_until" or name =? "__chan_receive_wait_until" or name =? "__chan_reserve_wait" or name =? "__chan_reserve_wait_until" or name =? "__ticker_wait"
        }
        if fc =? int8(4) {
            return name =? "__mpmc_send_wait" or name =? "__mpmc_receive_wait" or name =? "__mpmc_send_wait_until" or name =? "__mpmc_receive_wait_until" or name =? "__mpmc_reserve_wait" or name =? "__mpmc_reserve_wait_until"
        }
        if fc =? int8(5) {
            return name =? "__spsc_send_wait" or name =? "__spsc_receive_wait" or name =? "__spsc_send_wait_until" or name =? "__spsc_receive_wait_until" or name =? "__spsc_reserve_wait" or name =? "__spsc_reserve_wait_until"
        }
        # (the running task's state; its input operations wait)
        if fc =? int8(6) and (name =? "__task_slot" or name =? "__task_context" or name =? "__task_scope_canceled" or name =? "__task_canceled" or name =? "__task_shield_enter" or name =? "__task_shield_leave" or name =? "__task_file_code" or name =? "__task_file_begin" or name =? "__task_lock" or name =? "__task_unlock") {return false}
        if name.startswith("__fj_") {return false}
        # Core admission is scheduler coordination; joins release credits before
        # waiting, so it cannot wait on a user sibling while holding its slot.
        if fc =? int8(7) {return false}
        if name =? "panic" {return false}
    }
    # (a foreign function whose declared row excludes `blocks`, `& no_effects` or
    # `& no blocks`, is trusted not to wait, as part of its unsafe claim)
    if has_flag(d NF_EXTERN) {
        if node_sval(nodes.ptr[d].op_ext) =? 0 {return true}
        let row:WaitingWord=WaitingWord(fn_sig(d).contract)
        return row =? 0 or effect_allows(row EffectAtom['block']) or effect_contracts.ptr[row].atoms.contains(EffectAtom['opaque'])
    }
    if fns.ptr[f].body =? 0 {return true}
    return concurrency_blocks_node(WaitingWord(fns.ptr[f].body) @seen sharing)
}
# Whether a function a direct call gives may wait. A parameter passed on was answered for at the
# call that reached this body; any other function value cannot be followed. O(arguments) plus
# the demanded walk of each function given, once per walk.
concurrency_given_blocks=(n:WaitingWord @seen:dict<int64 bool>):>bool=>$unsafe {
    loop a in kids(n) {
        if tkind(ntype(a)) not=? 'fn_' {continue}
        let b=setting_value_target(a)
        loop nodes.ptr[b].kind =? 'conv' {b=WaitingWord(nodes.ptr[b].a)}
        let k=nodes.ptr[b].kind
        if k =? 'lambda' or k =? 'fnref' or k =? 'partial' and nodes.ptr[b].aux not=? 1 {
            if concurrency_blocks(WaitingWord(nodes.ptr[b].sym) @seen true) {return true}
        }
        else if not parsafe_is_param(b) {return true}
    }
    return false
}
cw_build_act_tab=():>array<uint8>=>$unsafe {
    let tab=fill(uint8(0) 128)
    loop i in [0..128) {
        let m=int64(iso_child_p[i])
        if m >? 0 {tab.ptr[i]=uint8(m)}
    }
    let tmp=[Node[kind='nil']]
    let tagp=tmp.ptr as ptr<uint32>
    let skips:array<NK>=['lambda' 'fnref' 'partial']
    loop k in skips {
        tmp.ptr[0].kind=k
        tab.ptr[int64(tagp[0])]=uint8(0)
    }
    tmp.ptr[0].kind='parallel_region'
    tab.ptr[int64(tagp[0])]=uint8(1)
    let specials:array<NK>=['ident' 'call' 'intrinsic' 'binary' 'pair']
    loop k in specials {
        tmp.ptr[0].kind=k
        let idx=int64(tagp[0])
        tab.ptr[idx]=uint8(int64(tab.ptr[idx]) | 128)
    }
    tab
}
let cw_act_tab:array<uint8>=cw_build_act_tab()
let cw_act_p:ptr<uint8>=$unsafe cw_act_tab.ptr
let cw_stack:array<int32>=[]
let cw_sp:WaitingWord=0

cw_check_special=(n:WaitingWord @seen:dict<int64 bool> sharing:bool):>bool=>$unsafe {
    let k=nodes.ptr[n].kind
    match k {
        <'ident'> => {
            if sharing and nodes.ptr[n].aux =? int32(2) {
                let held:dict<int64 bool>=dict<int64 bool>()
                if not concurrency_transfer(ntype(n) @held true) {fatal(nodes.ptr[n].pos "shared global does not satisfy inferred Sync{concurrency_why()}");}
            }
            return false
        }
        <'call'> => {
            if ownership_literal_print(n) {return true}
            # (walking a parallel body: what a call gives answers here for its callee's call through that parameter)
            if nodes.ptr[n].aux =? 0 and sharing and concurrency_given_blocks(n @seen) {return true}
            if nodes.ptr[n].aux =? 0 and concurrency_blocks(WaitingWord(nodes.ptr[n].sym) @seen sharing) {return true}
            # (a callback parameter's callers check that what they give does not wait: parsafe)
            # (a local bound once to a literal: walk that literal, as for one given to a call)
            let literal:WaitingWord=if nodes.ptr[n].aux =? 1 {local_literal_fn(WaitingWord(nodes.ptr[n].a) 0)} else {0}
            if literal >? 0 {
                if concurrency_blocks(literal @seen sharing) {return true}
            }
            else if (nodes.ptr[n].aux =? 1 or nodes.ptr[n].aux =? 4) and not parsafe_vouched_nonblocking(WaitingWord(nodes.ptr[n].a)) and not (sharing and parsafe_is_param(WaitingWord(nodes.ptr[n].a))) {
                let contract=callable_contract(ntype(WaitingWord(nodes.ptr[n].a)))
                if contract =? 0 {
                    contract=effect_source_row(WaitingWord(nodes.ptr[n].a))
                }
                if contract =? 0 or effect_allows(contract EffectAtom['block']) or effect_contracts.ptr[contract].atoms.contains(EffectAtom['opaque']) {return true}
            }
            return false
        }
        <'intrinsic'> => {
            if nodes.ptr[n].aux =? int32(9) {
                # Clocks and process/affinity queries cannot wait on another task.
                let op=if nkids(n) >? 0 {kid(n 0)} else {0}
                let number=if op not=? 0 and nodes.ptr[op].kind =? 'int_lit' {nodes.ptr[op].ival} else {-1}
                if number not=? 39 and number not=? 60 and number not=? 186 and number not=? 204 and number not=? 228 {return true}
            }
            loop f in value_helper_calls(n) {
                if concurrency_blocks(f @seen sharing) {return true}
            }
            return false
        }
        <'binary'> => {
            if nodes.ptr[n].aux not=? 0 {
                loop f in value_helper_calls(n) {
                    if concurrency_blocks(f @seen sharing) {return true}
                }
            }
            return false
        }
        <'pair'> => {
            if nodes.ptr[n].sym >? 0 and concurrency_blocks(WaitingWord(nodes.ptr[n].sym) @seen sharing) {return true}
            return false
        }
        _ => {return false}
    }
}

concurrency_blocks_node=(n0:WaitingWord @seen:dict<int64 bool> sharing:bool=false):>bool=>$unsafe {
    if n0 =? 0 {return false}
    let sp0=cw_sp
    if WaitingWord(cw_stack.length) <? sp0 + 64 {cw_stack.resize(sp0 + 256)}
    let sp=sp0
    let cap:WaitingWord=WaitingWord(cw_stack.length)
    let st=cw_stack.ptr
    let np=nodes.ptr
    let ap=cw_act_p
    let n=n0
    loop true {
        if n =? 0 {
            if sp <=? sp0 {break}
            sp -= 1
            n=WaitingWord(st[sp])
            continue
        }
        let act:WaitingWord=WaitingWord(ap[WaitingWord(((np + n) as ptr<uint32>)[0])])
        if act =? 0 {
            if sp <=? sp0 {break}
            sp -= 1
            n=WaitingWord(st[sp])
            continue
        }
        if (act & 128) not=? 0 {
            let k=np[n].kind
            let need_check=true
            if k =? 'ident' {need_check=sharing and np[n].aux =? int32(2)}
            else if k =? 'binary' {need_check=np[n].aux not=? 0}
            else if k =? 'pair' {need_check=np[n].sym >? 0}
            if need_check {
                cw_sp=sp
                if cw_check_special(n @seen sharing) {
                    cw_sp=sp0
                    return true
                }
                cap=WaitingWord(cw_stack.length)
                st=cw_stack.ptr
                np=nodes.ptr
            }
            act &= 63
            if act =? 0 {
                if sp <=? sp0 {break}
                sp -= 1
                n=WaitingWord(st[sp])
                continue
            }
        }
        let next:WaitingWord=0
        if (act & 32) not=? 0 {
            let nk2:WaitingWord=WaitingWord(nkids2(n))
            if nk2 >? 0 {
                if sp + nk2 >? cap {cap=(sp + nk2) * 2 + 64; cw_stack.resize(cap); st=cw_stack.ptr}
                let j:WaitingWord=nk2 - 1
                loop j >=? 0 {
                    let ch=WaitingWord(kid2(n j))
                    if ch not=? 0 {st[sp]=int32<overflow='wrap'>(ch); sp += 1}
                    j -= 1
                }
            }
        }
        if (act & 16) not=? 0 {
            let nk:WaitingWord=WaitingWord(np[n].nlist)
            if nk >? 0 {
                let l0:WaitingWord=WaitingWord(np[n].list)
                let lp=lists.ptr
                if (act & 7) =? 0 {
                    if nk >? 1 {
                        if sp + nk >? cap {cap=(sp + nk) * 2 + 64; cw_stack.resize(cap); st=cw_stack.ptr}
                        let j:WaitingWord=nk - 1
                        loop j >? 0 {
                            let ch=lp[l0 + j]
                            if ch not=? 0 {st[sp]=ch; sp += 1}
                            j -= 1
                        }
                    }
                    n=WaitingWord(lp[l0])
                    continue
                }
                if sp + nk >? cap {cap=(sp + nk) * 2 + 64; cw_stack.resize(cap); st=cw_stack.ptr}
                let j:WaitingWord=nk - 1
                loop j >=? 0 {
                    let ch=lp[l0 + j]
                    if ch not=? 0 {st[sp]=ch; sp += 1}
                    j -= 1
                }
            }
        }
        if (act & 4) not=? 0 {
            let c:WaitingWord=WaitingWord(np[n].c)
            if c not=? 0 {
                if sp >=? cap {cap=cap * 2 + 64; cw_stack.resize(cap); st=cw_stack.ptr}
                st[sp]=int32<overflow='wrap'>(c); sp += 1
            }
        }
        if (act & 2) not=? 0 {
            let b:WaitingWord=WaitingWord(np[n].b)
            if b not=? 0 {
                if (act & 1) =? 0 {
                    n=b
                    continue
                }
                if sp >=? cap {cap=cap * 2 + 64; cw_stack.resize(cap); st=cw_stack.ptr}
                st[sp]=int32<overflow='wrap'>(b); sp += 1
            }
        }
        if (act & 1) not=? 0 {next=WaitingWord(np[n].a)}
        n=next
    }
    cw_sp=sp0
    false
}

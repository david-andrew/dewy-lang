# (the local a named wait qualifier `@w` names, 0 when q is no such qualifier)
named_wait_qualifier = (q: int) -> int:
    text = name_of(q)
    if len(text) < 2 or not starts_with(text, "@"): return 0
    s = lookup(intern(text[1..]))
    if s == 0 or syms[s].kind != .local: return 0
    s
# `(@w).Closed`, `(@w).<string>`, `(@w).types` (decisions.md, batch 7): the type the named wait w
# gives with that name, as a wait handle's member names its outcome; 0 when tn names no `@w`.
named_wait_type = (tn: int) -> int:
    s = named_wait_qualifier(int(nodes[tn].sval))
    if s == 0: return 0
    t = prune(int(locals[int(syms[s].ref)].type))
    q = "(" + name_of(int(nodes[tn].sval)) + ")"
    if tkind(t) != .fn_: fatal(nodes[tn].pos, "`{q}` names a named wait, `let w = @lines.receive`; {dt(t)} is not one")
    outcomes = prune(telem(t))
    nm = int(nodes[tn].name)
    if name_of(nm) == "<>":
        if nkids(tn) != 1: fatal(nodes[tn].pos, "`{q}.<T>` selects one type")
        return resolve_type(kid(tn, 0))
    if name_of(nm) == "types": return outcomes
    found: int[]
    loop a in value_members(outcomes):
        if type_short_name(a) == name_of(nm): found.push(prune(a))
    if found.len() == 1: return found[0]
    if found.len() > 1: fatal(nodes[tn].pos, "{q} gives more than one type named {name_of(nm)}: write the one meant, `{q}.<{dt(found[0])}>`")
    fatal(nodes[tn].pos, "{q} gives {dt(outcomes)}, none of them named {name_of(nm)}")
    0
# (the object of the `$__consume__` method being checked: its own, moved in, so it may write it)
consumed_receiver = (l: int) -> bool:
    if ownership_consumers.len() == 0 or cx < 0: return false
    f = int(ctxs[cx].inst)
    f > 0 and fns[f].decl != 0 and ownership_consumers.has(int(fns[f].decl)) and fns[f].params.len() > 0 and fns[f].params[0] == l
# `select(@lines.receive @heart.next ...)` (decisions.md, batch 7): each wait it is given is a
# channel's `receive` or a ticker's `next`, written in the call on a local or a field chain;
# the same operation twice is an error. O(arguments^2), only for select's calls.
select_call = (n: int) -> bool:
    f = int(nodes[n].sym)
    if f <= 0 or nodes[n].aux != 0 or fns[f].decl == 0: return false
    d = int(fns[f].decl)
    name_of(int(nodes[d].name)) == "select" and files[pos_file(nodes[d].pos)].path == lib_dir + "/std/tasks.jo"
# (a call whose result a match can tell apart by source: select, race or first_ok, which record
# the argument that gave it)
source_call = (n: int) -> bool:
    if select_call(n): return true
    f = int(nodes[n].sym)
    if f <= 0 or nodes[n].aux != 0 or fns[f].decl == 0: return false
    d = int(fns[f].decl)
    name = name_of(int(nodes[d].name))
    path = files[pos_file(nodes[d].pos)].path
    if name != "race" and name != "first_ok": return false
    path == lib_dir + "/prelude/first_ok.dewy"
select_check = (n: int):
    waits: int[]
    loop a0 in kids(n):
        a = select_wait_arg(a0)
        if tkind(ntype(a)) != .fn_: continue
        w = wait_partial(a)
        l = named_wait_local(a)
        if w == 0 and l != 0:
            w = named_wait(n, a, l)
            if w < 0: return
        if w == 0: fatal(nodes[a].pos, "select waits on operations written in the call, on a local or a field: `@lines.receive`, `@heart.next`, or `@w` for a `let w = @lines.receive` in this function. It cannot follow a function value, a helper's result or an indexed element (bind `let ch = channels[i]`, then `@ch.receive`), and its own `timeout=` is the deadline")
        op = int(nodes[int(fns[int(nodes[w].sym)].decl)].name)
        loop v in waits:
            if int(nodes[int(fns[int(nodes[v].sym)].decl)].name) == op and select_same_place(kid(v, 0), kid(w, 0)): fatal(nodes[a].pos, "this operation is listed twice: select takes at most one value from it, so write it once")
        waits.push(w)
# (a select argument with conversions and `if cond ... else none`'s `__select_when` taken off)
select_wait_arg = (a0: int) -> int:
    a = a0
    loop nodes[a].kind == .conv: a = int(nodes[a].a)
    if nodes[a].kind == .call and nkids(a) == 2 and nodes[a].sym > 0 and nodes[a].aux == 0 and fns[int(nodes[a].sym)].decl != 0 and name_of(int(nodes[int(fns[int(nodes[a].sym)].decl)].name)) == "__select_when":
        a = kid(a, 1)
        loop nodes[a].kind == .conv: a = int(nodes[a].a)
    a
# (the local a named wait argument names, 0 for another form)
named_wait_local = (a0: int) -> int:
    a = a0
    loop nodes[a].kind == .conv: a = int(nodes[a].a)
    if nodes[a].kind != .ident or has_flag(a, NF_GLOBAL) or nodes[a].sym <= 0: return 0
    int(nodes[a].sym)
nw_walk = (n: int):
    if n <= 0: return
    at = nw_at
    nw_at += 1
    k = nodes[n].kind
    if k == .vardecl and nodes[n].sym == i32(nw_local) and not has_flag(n, NF_GLOBAL) and nw_decl == 0:
        nw_decl = n
        nw_decl_at = at
        nw_decl_loops = nw_loops
    if n == nw_call:
        nw_call_at = at
        nw_call_loops = nw_loops
    if k == .assign:
        nw_writes.push(n)
        nw_write_at.push(at)
    if k == .lambda:
        loop cap in lambda_captures(n):
            if has_flag(cap, NF_MUT):
                nw_writes.push(cap)
                nw_write_at.push(at)
        return
    loop_node = k == .while_ or k == .for_
    if loop_node:
        nw_loops.push(n)
        nw_loop_start[n] = at
    mask = isolation_children(k)
    if mask < 0: mask = 0
    if mask & 1 != 0: nw_walk(int(nodes[n].a))
    if mask & 2 != 0: nw_walk(int(nodes[n].b))
    if mask & 4 != 0: nw_walk(int(nodes[n].c))
    if mask & 16 != 0:
        loop child in kids(n): nw_walk(child)
    if loop_node:
        nw_loops.pop()
        nw_loop_end[n] = nw_at - 1
    if n == nw_call: nw_call_end = nw_at - 1
# (the names along a place: its root local's id, negated, then each field's name)
nw_path = (n0: int) -> int[]:
    out: int[]
    n = n0
    loop nodes[n].kind == .conv or nodes[n].kind == .field or nodes[n].kind == .index:
        if nodes[n].kind == .field: out.push(int(nodes[n].name))
        if nodes[n].kind == .index: out.clear()
        n = int(nodes[n].a)
    if nodes[n].kind != .ident or has_flag(n, NF_GLOBAL): return []
    out.push(-int(nodes[n].sym))
    out.reverse()
    out
# (does a write to the place target replace w, or the receiver path or an ancestor of it?)
nw_overlaps = (target: int, receiver: int[]) -> bool:
    path = nw_path(target)
    if path.len() == 0: return false
    if path[0] == -nw_local: return true
    if path[0] != receiver[0]: return false
    loop i in [0..min(path.len(), receiver.len())):
        if path[i] != receiver[i]: return false
    true
# The wait w names in the call n, checked against rules 3-5 (its declaration in this function,
# a stable receiver, nothing changing them while it is pending).
named_wait = (n: int, a: int, l: int) -> int:
    nw_local = l
    nw_name = int(locals[l].name)
    nw_call = n
    nw_decl = 0
    nw_at = 0
    nw_decl_at = -1
    nw_call_at = -1
    nw_call_end = -1
    nw_loops.clear()
    nw_loop_start.clear()
    nw_loop_end.clear()
    nw_writes.clear()
    nw_write_at.clear()
    owner = int(locals[l].owner)
    nw_walk(int(fns[owner].body))
    # (a checked copy of the call, as a match on it makes, is not in the body: the call itself is)
    if nw_call_at < 0: return -1
    w = name_of(nw_name)
    if nw_decl == 0 or nw_decl_at > nw_call_at or int(locals[l].flags) & LF_PARAM != 0: fatal(nodes[a].pos, "select waits on `@{w}` only when {w} is a wait prepared in this function, `let {w} = @lines.receive`; a parameter, a captured value or a stored result is not one: write the wait in the call")
    init = int(nodes[nw_decl].b)
    prepared = wait_partial(init)
    if prepared == 0: fatal(nodes[a].pos, "{w} is not a prepared wait: a named wait is declared as one, `let {w} = @lines.receive` or `@heart.next`; a helper's result, a stored handle or `if cond @x.receive else none` is not (write the wait, or the condition, in the call)")
    receiver = nw_path(kid(prepared, 0))
    if receiver.len() == 0: fatal(nodes[prepared].pos, "a named wait's receiver is a local or a field chain on one: bind `let ch = ...` and prepare `@ch.receive`")
    root = name_of(int(locals[-receiver[0]].name))
    loop i in [0..nw_writes.len()):
        x = nw_writes[i]
        if nodes[x].kind != .assign:
            # (a closure that captured the place to change it: whenever it runs)
            if int(nodes[x].name) == nw_name or name_of(int(nodes[x].name)) == root: fatal(nodes[x].pos, "this closure captures the place of the wait `{w}` to change it, so select could take from another place than its pattern names: capture a copy, or match the plain type")
            continue
        at = nw_write_at[i]
        live = at > nw_decl_at and at <= nw_call_end
        loop lp in nw_call_loops:
            if not nw_decl_loops.contains(lp) and at >= nw_loop_start[lp] and at <= nw_loop_end[lp]: live = true
        if live and nw_overlaps(int(nodes[x].a), receiver): fatal(nodes[x].pos, "this changes the place the wait `{w}` was prepared on while select can still take from it: from `let {w} = ...` through the match, and around the loop back to it, the receiver and {w} stay as they are. Bind a fresh local for the new value, or match the plain type")
    prepared
select_turned_off = (a0: int) -> int:
    a = a0
    loop nodes[a].kind == .block and nkids(a) == 1 and nodes[kid(a, 0)].kind == .exprstmt: a = int(nodes[kid(a, 0)].a)
    if nodes[a].kind != .if_ or nodes[a].c == 0: return 0
    off = int(nodes[a].c)
    loop nodes[off].kind == .block and nkids(off) == 1 and nodes[kid(off, 0)].kind == .exprstmt: off = int(nodes[kid(off, 0)].a)
    if nodes[off].kind != .none_lit: return 0
    a
select_conditions = (n: int, expected: int) -> int:
    if not dewy_at(nodes[n].pos): return -1
    conditions: int[]
    waits = 0
    args = kids(n)
    loop i in [0..args.len()):
        if nodes[args[i]].kind == .namedarg: continue
        waits += 1
        c = select_turned_off(args[i])
        if c == 0: continue
        conditions.push(int(nodes[c].a))
        on = int(nodes[c].b)
        loop nodes[on].kind == .block and nkids(on) == 1 and nodes[kid(on, 0)].kind == .exprstmt: on = int(nodes[kid(on, 0)].a)
        args[i] = bc_call("__select_when", [int(nodes[c].a), on], nodes[args[i]].pos)
    if conditions.len() == 0: return -1
    pos = nodes[n].pos
    if conditions.len() < waits:
        set_list(n, args)
        return -1
    call = clone(n)
    set_list(call, args)
    # (every wait may be off: one condition must hold, proven where the select is reached)
    either = 0
    loop c in conditions:
        if not select_plain_condition(c): fatal(nodes[c].pos, "every wait of this select can be turned off, so one condition must be proven true before it waits; that needs plain conditions (flags, fields, comparisons): bind this one to a local first")
        if either == 0: either = clone(c)
        else:
            joined = mk(.or_, pos)
            nodes[joined].a = i32(either)
            nodes[joined].b = i32(clone(c))
            either = joined
    check_expr(either, T_BOOL)
    held = last_checked
    check_expr(bc_str("select needs a wait: every wait here can be turned off", pos), T_STR)
    guard = mk(.call, pos)
    nodes[guard].aux2 = i32(UNPACK_OBLIGATION)
    check_intrinsic(guard, int(IN.assert), [held, last_checked], 0)
    fact_requests.push(FactRequest(guard, if cx >= 0: int(ctxs[cx].inst) else: 0))
    statement = mk(.exprstmt, pos)
    nodes[statement].a = i32(guard)
    add_flag(statement, NF_CHECKED)
    nodes[n] = Node(kind = .block, pos = pos, aux = 1)
    set_list(n, [statement, bc_stmt(call, pos)])
    check_expr(n, expected)
# (the obligation itself: the spread arrays' lengths add up to at least one)
race_needs = (n: int) -> int:
    pos = nodes[n].pos
    total = 0
    loop a in kids(n):
        check_expr(a, 0)
        held = last_checked
        length = mk(.call, pos)
        check_intrinsic(length, int(IN.len), [held], 0)
        add_flag(length, NF_CHECKED)
        if total == 0: total = length
        else:
            sum = mk(.binary, pos)
            nodes[sum].op = i32(int(Tok.plus))
            nodes[sum].a = i32(total)
            nodes[sum].b = i32(length)
            check_expr(sum, T_INT)
            total = last_checked
    one = mk(.int_lit, pos)
    nodes[one].ival = 1
    cmp = mk(.binary, pos)
    nodes[cmp].op = i32(int(Tok.ge))
    nodes[cmp].a = i32(total)
    nodes[cmp].b = i32(one)
    check_expr(cmp, T_BOOL)
    cmp = last_checked
    word = name_of(int(nodes[n].ival))
    check_expr(bc_str("{word} needs a call to run: the spread array may be empty", pos), T_STR)
    message = last_checked
    check_intrinsic(n, int(IN.assert), [cmp, message], 0)
    nodes[n].aux2 = i32(UNPACK_OBLIGATION)
    fact_requests.push(FactRequest(n, if cx >= 0: int(ctxs[cx].inst) else: 0))
    last_checked = n
    T_VOID
# (a condition the obligation can read again: names, fields, literals, `not`, `and`, `or` and
# comparisons of them)
select_plain_condition = (c: int) -> bool:
    k = nodes[c].kind
    if k == .ident or k == .bool_lit or k == .int_lit: return true
    if k == .field or k == .not_: return select_plain_condition(int(nodes[c].a))
    if k == .and_ or k == .or_ or k == .binary: return select_plain_condition(int(nodes[c].a)) and select_plain_condition(int(nodes[c].b))
    false
# (the wait a named wait l was declared with while its function is being checked, 0 if none)
named_wait_declared = (l: int) -> int:
    nw_local = l
    nw_call = 0
    nw_decl = 0
    nw_decl_at = -1
    nw_at = 0
    nw_loops.clear()
    nw_writes.clear()
    nw_write_at.clear()
    nw_walk(int(fns[int(locals[l].owner)].body))
    if nw_decl == 0: return 0
    wait_partial(int(nodes[nw_decl].b))
# Source patterns (decisions.md, batch 7): `<heart.Tick>`, `line:lines.string`,
# `x:heart.types & (Tick | Closed)` name the wait that gave the outcome as well as its type. The
# qualifier of p's type when it is such a pattern (a local or global wait handle and a member it
# has as an outcome, not a record's own type member), 0 otherwise.
source_qualifier = (p: int) -> int:
    if nodes[p].kind != .ptype or nodes[p].a == 0: return 0
    tn = int(nodes[p].a)
    if nodes[tn].kind == .tunion and nodes[tn].aux == 11: tn = kid(tn, 0)
    if nodes[tn].kind != .tname or nodes[tn].sval == 0: return 0
    selector = name_of(int(nodes[tn].name)) == "<>"
    if nkids(tn) != 0 and not selector: return 0
    if named_wait_qualifier(int(nodes[tn].sval)) != 0: return int(nodes[tn].sval)
    s = lookup(int(nodes[tn].sval))
    if s == 0 or (syms[s].kind != .local and syms[s].kind != .global): return 0
    t = 0
    if syms[s].kind == .local: t = int(locals[int(syms[s].ref)].type)
    else:
        ensure_global(int(syms[s].ref), nodes[tn].pos)
        t = int(globals[int(syms[s].ref)].type)
    if t == 0 or handle_outcomes(t) == 0 or not selector and record_type_member(t, int(nodes[tn].name)) != 0: return 0
    int(nodes[tn].sval)
# (the variable a wait's receiver path starts from, its name; 0 for another form)
source_receiver = (n0: int) -> int:
    n = n0
    loop nodes[n].kind == .conv: n = int(nodes[n].a)
    if nodes[n].kind != .ident: return 0
    int(nodes[n].name)
# A match with source patterns (decisions.md, batch 7, provenance rules 1, 2, 7 and 8). Eligible
# only on the call that prepared the waits: `match select(...)`, whose waits are written in
# it, or a direct `x.receive` / `x.next`. On a select the match becomes one match per wait the
# select can take, chosen by the winner the call records (`__select_winner`), each on the
# outcomes of that wait: a source pattern stays in its wait's match as its plain type, a plain
# one in every match whose outcomes it meets. -1 when m has no source pattern (O(patterns)).
source_match = (m: int, expected: int) -> int:
    first = 0
    loop arm in kids(m):
        loop p in kids(arm):
            if first == 0 and source_qualifier(p) != 0: first = p
    if first == 0: return -1
    sc = int(nodes[m].a)
    pos = nodes[m].pos
    # (rule 7: a direct receive or next has one slot, its receiver)
    head = sc
    if nodes[head].kind == .call: head = int(nodes[head].a)
    if nodes[head].kind == .field and (name_of(int(nodes[head].name)) == "receive" or name_of(int(nodes[head].name)) == "next" or name_of(int(nodes[head].name)) == "reserve") and select_place(int(nodes[head].a)):
        receiver = source_receiver(int(nodes[head].a))
        inner = inbox_sources(int(nodes[head].a), name_of(int(nodes[head].name)))
        if inner.len() > 0: return inbox_source_match(m, sc, inner, expected)
        loop arm in kids(m):
            loop p in kids(arm):
                q = source_qualifier(p)
                if q != 0 and q != receiver: fatal(nodes[p].pos, "this pattern names {name_of(q)}, but the match is on another wait: only what that wait gives can match here (write the plain type, or match on {name_of(q)}'s own wait)")
        return -1
    callee = if nodes[sc].kind == .call: int(nodes[sc].a) else: 0
    if callee == 0 or nodes[callee].kind != .ident or not (name_of(int(nodes[callee].name)) in ["select", "race", "first_ok"]):
        fatal(nodes[first].pos, "a pattern that names its source (`<heart.Tick>`) needs the match written on the call that prepared the waits, `match select(...)`, or on a direct `receive` or `next`; a stored result, a helper's or another call's has no source: match the plain type")
    # (the waits' outcomes, from a checked copy: the call itself is checked where it is bound)
    check_expr(clone(sc), 0)
    probe = last_checked
    call = probe
    loop nodes[call].kind == .conv: call = int(nodes[call].a)
    # (all waits conditional: `{obligation; select(...)}`)
    if nodes[call].kind == .block and nkids(call) > 0 and nodes[kid(call, nkids(call) - 1)].kind == .exprstmt: call = int(nodes[kid(call, nkids(call) - 1)].a)
    loop nodes[call].kind == .conv: call = int(nodes[call].a)
    if nodes[call].kind != .call or not source_call(call): fatal(nodes[first].pos, "a pattern that names its source needs the match written on `select(...)`, `race(...)` or `first_ok(...)` itself")
    whole = prune(ntype(probe))
    # (each wait: its receiver's name and what it gives)
    receivers: int[]
    named: int[]
    outcomes: int[][]
    taken: int[]
    if spreads_rest(call): fatal(nodes[first].pos, "a pattern that names its source needs the waits written in the call; a spread array's are not: match the plain type")
    loop a0 in written_args(call):
        a = select_wait_arg(a0)
        if tkind(ntype(a)) != .fn_: continue
        w = wait_partial(a)
        l = named_wait_local(a)
        named.push(0)
        if w == 0 and l != 0:
            w = named_wait_declared(l)
            named[named.len() - 1] = intern("@" + name_of(int(locals[l].name)))
        receivers.push(if w != 0: source_receiver(kid(w, 0)) else: 0)
        gives = value_members(prune(telem(ntype(a))))
        outcomes.push(gives)
        loop g in gives: taken.push(prune(g))
    # (the select's own outcomes: Canceled, and Timeout with timeout=)
    own: int[]
    loop w0 in value_members(whole):
        w = prune(w0)
        if not taken.contains(w) or type_short_name(w) == "Canceled" or type_short_name(w) == "Timeout": own.push(w)
    loop arm in kids(m):
        loop p in kids(arm):
            q = source_qualifier(p)
            if q != 0 and not receivers.contains(q) and not named.contains(q): fatal(nodes[p].pos, "{name_of(q)} is not waited on in this select: a pattern names one of the call's waits (`@{name_of(q)}.receive` written in it, or `@w` for a named wait)")
    source_dispatch(m, sc, receivers, named, outcomes, own, whole, select_call(call), expected)
# (source_match's rewrite: one match per wait, chosen by the recorded winner)
source_dispatch = (m: int, sc: int, receivers: int[], named: int[], outcomes: int[][], own: int[], whole: int, on_select: bool, expected: int) -> int:
    pos = nodes[m].pos
    statement = has_flag(m, NF_STMT)
    sel = "$select{m}"
    won = "$select_won{m}"
    branches: int[]
    loop k in [0..outcomes.len() + 1):
        gives = if k < outcomes.len(): outcomes[k] else: own
        if gives.len() == 0: continue
        source = if k < outcomes.len(): receivers[k] else: -1
        alias = if k < outcomes.len(): named[k] else: -1
        arms: int[]
        # (what this wait's unguarded source arms take: a plain arm after them takes the rest)
        covered: int[]
        loop arm in kids(m):
            kept: int[]
            loop p in kids(arm):
                q = source_qualifier(p)
                if q != 0 and q != source and q != alias: continue
                if nodes[p].kind == .ptype and nodes[p].a != 0:
                    was = bare_generic_set(true)
                    tt = prune(resolve_type(int(nodes[p].a)))
                    bare_generic_set(was)
                    held: int[]
                    loop g in value_members(tt):
                        if gives.contains(prune(g)) or family_holds_generic(tt, prune(g)): held.push(prune(g))
                    loop g in gives:
                        if not held.contains(prune(g)) and type_eq(prune(g), tt): held.push(prune(g))
                    if q == 0:
                        rest: int[]
                        loop g in held:
                            if not covered.contains(g): rest.push(g)
                        held = rest
                    else if nodes[arm].a == 0 and nodes[arm].c == 0:
                        loop g in held: covered.push(g)
                    if held.len() == 0: continue
                    np = clone(p)
                    tn = mk(.tname, nodes[p].pos)
                    nodes[tn].aux = -7
                    nodes[tn].ival = if held.len() == 1: held[0] else: mk_union(held)
                    nodes[np].a = i32(tn)
                    kept.push(np)
                else: kept.push(clone(p))
            if kept.len() == 0: continue
            na = clone(arm)
            set_list(na, kept)
            arms.push(na)
        # (the other waits' outcomes never reach this match: an arm that says so covers them)
        catch_all = false
        loop na in arms:
            loop p in kids(na):
                if nodes[p].kind == .pwild: catch_all = true
        if gives.len() < value_members(whole).len() and not catch_all:
            rest = mk(.arm, pos)
            set_list(rest, [mk(.pwild, pos)])
            nodes[rest].b = i32(bc_block([bc_stmt(bc_call("panic", [bc_str("select gave the outcome of another wait", pos)], pos), pos)], pos))
            arms.push(rest)
        branch = mk(.match_, pos)
        nodes[branch].a = i32(bc_ident(sel, pos))
        if statement: add_flag(branch, NF_STMT)
        set_list(branch, arms)
        if on_select: select_source_matches[branch] = true
        select_source_calls[branch] = sc
        branches.push(branch)
        branches.push(if k < outcomes.len(): k else: -1)
    # (the last branch is the else of the others)
    chain = branches[branches.len() - 2]
    i = branches.len() - 4
    loop i >= 0:
        winner = bc_bin(.eq, bc_ident(won, pos), bc_int(branches[i + 1], pos), pos)
        node = mk(.if_, pos)
        nodes[node].a = i32(winner)
        then = bc_block([bc_stmt(branches[i], pos)], pos)
        nodes[then].aux = 1
        otherwise = bc_block([bc_stmt(chain, pos)], pos)
        nodes[otherwise].aux = 1
        nodes[node].b = i32(then)
        nodes[node].c = i32(otherwise)
        if statement:
            nodes[node].b = i32(bc_block([bc_stmt(branches[i], pos)], pos))
            nodes[node].c = i32(bc_block([if nodes[chain].kind == .if_: chain else: bc_stmt(chain, pos)], pos))
            add_flag(node, NF_STMT)
        chain = node
        i -= 2
    last = if statement and nodes[chain].kind == .if_: chain else: bc_stmt(chain, pos)
    statements = [bc_let(sel, sc, pos), bc_let(won, bc_call("__select_winner", [], pos), pos), last]
    nodes[m] = Node(kind = .block, pos = pos, aux = if statement: 0 else: 1)
    set_list(m, statements)
    check_expr(m, expected)
# Rule 6 (decisions.md, batch 7): `match inbox.next` for an `inbox = merged(@a.receive ...)`
# declared in this function names the inner waits, `v:a.int64`; the inbox records which one gave
# the value. The waits of inbox's declaration, [] when x is no such inbox (or the pattern names
# only the inbox itself). A later assignment to the inbox does not carry its table: an error.
inbox_sources = (x0: int, op: str) -> int[]:
    out: int[]
    x = x0
    loop nodes[x].kind == .conv: x = int(nodes[x].a)
    if op != "next" or nodes[x].kind != .ident: return out
    s = lookup(int(nodes[x].name))
    if s == 0 or syms[s].kind != .local: return out
    l = int(syms[s].ref)
    named_wait_declared(l)
    if nw_decl == 0: return out
    init = int(nodes[nw_decl].b)
    loop nodes[init].kind == .conv: init = int(nodes[init].a)
    if nodes[init].kind != .call or nodes[init].sym <= 0 or nodes[init].aux != 0 or fns[int(nodes[init].sym)].decl == 0: return out
    d = int(fns[int(nodes[init].sym)].decl)
    if name_of(int(nodes[d].name)) != "merged" or files[pos_file(nodes[d].pos)].path != lib_dir + "/prelude/inbox.dewy": return out
    if spreads_rest(init): return out
    loop a0 in written_args(init):
        a = select_wait_arg(a0)
        if tkind(ntype(a)) != .fn_: continue
        w = wait_partial(a)
        if w == 0 and named_wait_local(a) != 0: w = named_wait_declared(named_wait_local(a))
        out.push(w)
    out
inbox_source_match = (m: int, sc: int, inner: int[], expected: int) -> int:
    field = sc
    if nodes[field].kind == .call: field = int(nodes[field].a)
    target = int(nodes[field].a)
    loop nodes[target].kind == .conv: target = int(nodes[target].a)
    inbox = int(nodes[target].name)
    # (rule 6: the inbox stays the binding its table was made for)
    named_wait_declared(int(syms[lookup(inbox)].ref))
    nw_walk_assigned(inbox, m)
    check_expr(clone(sc), 0)
    whole = prune(ntype(last_checked))
    receivers: int[]
    named: int[]
    outcomes: int[][]
    taken: int[]
    loop w in inner:
        receivers.push(if w != 0: source_receiver(kid(w, 0)) else: 0)
        named.push(0)
        gives: int[]
        if w != 0:
            loop g in value_members(prune(telem(ntype(w)))):
                if type_short_name(g) != "Closed" and type_short_name(g) != "Canceled": gives.push(prune(g))
        outcomes.push(gives)
        loop g in gives: taken.push(g)
    own: int[]
    loop g0 in value_members(whole):
        g = prune(g0)
        if not taken.contains(g): own.push(g)
    loop arm in kids(m):
        loop p in kids(arm):
            q = source_qualifier(p)
            if q != 0 and q != inbox and not receivers.contains(q): fatal(nodes[p].pos, "{name_of(q)} is not one of this inbox's waits: a pattern on `inbox.next` names a wait of its `merged(...)`")
            if q == inbox: fatal(nodes[p].pos, "a pattern on `{name_of(inbox)}.next` names one of its merged waits (`v:a.string`); the inbox itself is one source only inside `select`")
    source_dispatch(m, sc, receivers, named, outcomes, own, whole, false, expected)
# (an assignment to the local named name anywhere in m's function after its declaration: by name,
# as the rest of the body is not checked yet)
nw_walk_assigned = (name: int, m: int):
    loop i in [0..nw_writes.len()):
        x = nw_writes[i]
        if nodes[x].kind != .assign or nw_write_at[i] <= nw_decl_at: continue
        t = int(nodes[x].a)
        loop nodes[t].kind == .conv or nodes[t].kind == .field: t = int(nodes[t].a)
        if nodes[t].kind == .ident and nodes[t].name == i32(name): fatal(nodes[x].pos, "a match on `{name_of(name)}.next` names the waits of its `merged(...)`, but this assigns {name_of(name)} another value, which does not carry them: bind a new local, or match the plain type")
# `members(U)` of a union of types (decisions.md, batch 7): its alternatives, each a type a
# `loop t in members(U)` binds; [] for a union of literals, which yields its values.
type_alternatives = (u0: int) -> int[]:
    u = prune(u0)
    out: int[]
    if not is_union(u): return out
    loop m0 in union_members(u):
        m = prune(m0)
        if str_set_of(m) != 0 or types[m].kind == .refined: return []
        out.push(m)
    out
# A queue's payload that is, or may be, an outcome its own waits give (decisions.md, batch 7),
# `Closed`, `Canceled` or every exception: the error that says so, "" when none is. A select's arms
# match by type, so such a payload would be taken for the queue's own close or cancellation.
queue_payload_clash = (payload: int, name: str) -> str:
    loop m0 in value_members(payload):
        text = dt(prune(m0))
        if text == "Closed" or text == "Canceled" or text == "exception": return "a {name}'s payload cannot be {text}: its receive gives {text} as its own outcome, so the two could not be told apart; carry it in a record, `[value:{dt(payload)}]`"
    ""
# The progress rule, for its common case (decisions.md, batch 7): in a loop, an arm of a match
# on select that takes a close and changes nothing (no assignment, no break, return or
# or_throw, no call but printing) reaches the next turn, where the closed channel is ready
# again: it spins. O(the arms' bodies), only for a match on select inside a loop.
select_progress = (m: int):
    if cx < 0 or ctxs[cx].loop_depth == 0: return
    sc = int(nodes[m].a)
    loop nodes[sc].kind == .conv: sc = int(nodes[sc].a)
    if not select_source_matches.has(m) and (nodes[sc].kind != .call or not select_call(sc)): return
    # (`timeout=0s`, a poll: a Timeout stays ready as a close does)
    poll = select_poll(select_source_calls.get(m) ?? sc)
    loop arm in kids(m):
        closes = false
        idles = false
        loop p in kids(arm):
            if select_pattern_closes(p): closes = true
            if poll and select_pattern_named(p, "Timeout"): idles = true
        if closes and not select_moves(int(nodes[arm].b)): fatal(nodes[arm].pos, "this close arm spins: a closed channel stays ready, so the next turn of the loop takes the close again; leave the loop (`break`), turn the wait off (`if open @c.receive else none`, then `open = false` here), change what the loop tests, or drain the channels with `merged(...)`, which retires each one as it closes")
        if idles and not select_moves(int(nodes[arm].b)): fatal(nodes[arm].pos, "this Timeout arm spins: a `timeout=0s` poll that finds nothing gives Timeout again on the next turn of the loop; leave the loop (`break`), wait with a real timeout, or do the work that makes a wait ready here")
select_poll = (c0: int) -> bool:
    c = c0
    loop nodes[c].kind == .conv: c = int(nodes[c].a)
    if nodes[c].kind == .block and nkids(c) > 0 and nodes[kid(c, nkids(c) - 1)].kind == .exprstmt: c = int(nodes[kid(c, nkids(c) - 1)].a)
    loop nodes[c].kind == .conv: c = int(nodes[c].a)
    if nodes[c].kind != .call or not select_call(c) or nkids(c) == 0: return false
    last = kid(c, nkids(c) - 1)
    if tkind(ntype(last)) == .fn_: return false
    loop nodes[last].kind == .conv: last = int(nodes[last].a)
    nodes[last].kind == .int_lit and nodes[last].ival == 0 or nodes[last].kind == .float_lit and nodes[last].fval == 0.0
# (does pattern p take the type named name, `<Timeout>`?)
select_pattern_named = (p: int, name: str) -> bool:
    if nodes[p].kind == .pvariant: return name_of(int(nodes[p].name)) == name
    if nodes[p].kind != .ptype or nodes[p].type == 0: return false
    loop member in value_members(prune(int(nodes[p].type))):
        if type_short_name(member) == name: return true
    false
select_pattern_closes = (p: int) -> bool:
    if nodes[p].kind == .pvariant: return name_of(int(nodes[p].name)) == "Closed" or starts_with(name_of(int(nodes[p].name)), "Closed<") or starts_with(name_of(int(nodes[p].name)), "Closed[")
    if nodes[p].kind != .ptype or nodes[p].type == 0: return false
    t = prune(int(nodes[p].type))
    members = if is_union(t): union_members(t) else: [t]
    loop member in members:
        mt = prune(member)
        if tkind(mt) == .struct_ and structs[int(types[mt].st)].decl != 0 and name_of(int(nodes[int(structs[int(types[mt].st)].decl)].name)) == "Closed": return true
    false
# (could n change what the loop does next: an assignment, a jump out, a failure forwarded, or a
# call other than printing)
select_moves = (n: int) -> bool:
    if n == 0: return false
    k = nodes[n].kind
    if k == .lambda: return false
    if k == .assign or k == .break_ or k == .return_ or k == .propagate: return true
    if k == .call:
        f = int(nodes[n].sym)
        if nodes[n].aux != 0 or f <= 0 or fns[f].decl == 0: return true
        name = name_of(int(nodes[int(fns[f].decl)].name))
        if name != "printl" and name != "print" and name != "__print_str": return true
    mask = isolation_children(k)
    if mask < 0: return true
    if mask & 1 != 0 and select_moves(int(nodes[n].a)): return true
    if mask & 2 != 0 and select_moves(int(nodes[n].b)): return true
    if mask & 4 != 0 and select_moves(int(nodes[n].c)): return true
    if mask & 16 != 0:
        loop child in kids(n):
            if select_moves(child): return true
    false
# (a local or a field chain on one)
select_place = (n0: int) -> bool:
    n = n0
    loop nodes[n].kind == .conv or nodes[n].kind == .field: n = int(nodes[n].a)
    nodes[n].kind == .ident
select_same_place = (x0: int, y0: int) -> bool:
    x = x0
    y = y0
    loop nodes[x].kind == .conv: x = int(nodes[x].a)
    loop nodes[y].kind == .conv: y = int(nodes[y].a)
    if nodes[x].kind != nodes[y].kind: return false
    if nodes[x].kind == .ident: return nodes[x].sym == nodes[y].sym and nodes[x].aux == nodes[y].aux
    nodes[x].kind == .field and nodes[x].name == nodes[y].name and select_same_place(int(nodes[x].a), int(nodes[y].a))

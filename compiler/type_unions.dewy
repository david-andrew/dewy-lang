$runtime_checks
from p"checker_types.dewy" import (TypeInfo StructInfo Field Variant)
from p"type_inference.dewy" import (tu_prune tu_has_var tu_equal tu_struct_targ tu_is_union tu_union_members)

# Canonical unions retain arena IDs across lazy rendering and set constructors.
# Flattening and insertion sort preserve the original member and callback order.
UWord:type=int64<overflow='wrap'>
const TF_HAS_VAR=1
TypeUnionHost:type=[
    mk_opt:<(p0:int64):>int64>
    str_set_of:<(p0:int64):>int64>
    str_set_type:<(p0:array<string>):>int64>
    type_str_postfix:<(p0:int64):>string>
    type_str:<(p0:int64):>string>
    intern:<(p0:string):>int64>
]
TypeUnionInput:type=[
    types:ptr<array<TypeInfo>>
    structs:ptr<array<StructInfo>>
    args:ptr<array<int32>>
    fields:ptr<array<Field>>
    variants:ptr<array<Variant>>
    sets:ptr<array<array<string>>>
    never:ptr<int64>
    none_:ptr<int64>
    host:ptr<TypeUnionHost>
]
let uu_inputs:ptr<TypeUnionInput>=$unsafe (uint64(0) as ptr<TypeUnionInput>)
let uu_instances:dict<array<int64> int64>=[]
let uu_candidates:array<int64>=[]
type_union_bind=(input:ptr<TypeUnionInput>):>UWord=>{uu_inputs=input; uu_instances=[]; uu_candidates=[]; 0}
uu_mk_union=(ms0:array<int64>):>UWord=>$unsafe {
    let ms:array<int64>=[]
    let has_none=false
    let work=ms0
    let i:UWord=0
    loop i <? work.length {
        let m=tu_prune(work[i])
        i += 1
        let k=uu_inputs[0].types[0].ptr[m].kind
        if m =? uu_inputs[0].never[0] {continue} # (a value that never exists adds nothing)
        if k =? 'none_lit' {has_none=true}
        else if k =? 'opt' {
            has_none=true
            work.push(UWord(uu_inputs[0].types[0].ptr[m].elem))
        }
        else if tu_is_union(m) {
            loop x in tu_union_members(m) {work.push(x)}
        }
        else {
            let dup=false
            loop x in ms {
                if tu_equal(x  m) {dup=true}
            }
            if not dup {ms.push(m)}
        }
    }
    # Literal string sets join into one set: `Damage | 'none'` with
    # `Damage = 'torn' | 'checksum'` is the set of all three.
    if uu_inputs[0].sets[0].length >? 2 {
        let sets:UWord=0
        loop m in ms {
            if uu_inputs[0].host[0].str_set_of(m) not=? 0 {sets += 1}
        }
        if sets >? 1 {
            let texts:array<string>=[]
            let rest:array<int64>=[]
            loop m in ms {
                let set=uu_inputs[0].host[0].str_set_of(m)
                if set =? 0 {rest.push(m)}
                else {
                    loop text in uu_inputs[0].sets[0].ptr[set] {
                        if not texts.contains(text) {texts.push(text)}
                    }
                }
            }
            rest.push(uu_inputs[0].host[0].str_set_type(texts))
            ms=rest
        }
    }
    # sort by type id (few members: insertion sort)
    loop i in [1..ms.length) {
        let j=i
        loop j >? 0 and ms[j - 1] >? ms[j] {
            let tmp=ms[j]
            ms[j] = ms[j - 1]
            ms[j - 1] = tmp
            j -= 1
        }
    }
    let r=uu_inputs[0].none_[0]
    if ms.length =? 1 {r=ms[0]}
    else if ms.length >? 1 {r=uu_union_inst(ms)}
    if has_none and ms.length >? 0 {r=uu_inputs[0].host[0].mk_opt(r)}
    r
}
uu_union_inst=(ms:array<int64>):>UWord=>$unsafe {
    let stable=true
    loop m in ms {
        if tu_has_var(m) {stable=false}
    }
    if stable {
        let cached=uu_instances.get(ms)
        if cached isnt? none {return cached as int64}
    }
    else {
        loop i in uu_candidates {
            let si=uu_inputs[0].structs[0].ptr[i]
            if UWord(si.ntargs) not=? ms.length {continue}
            let same=true
            loop k in [0..ms.length) {
                if not tu_equal(tu_struct_targ(i  k)  ms[k]) {
                    same=false
                    break
                }
            }
            if same {return UWord(si.type)}
        }
    }
    let name=""
    let hv=false
    loop i in [0..int64(ms.length)) {
        let m=ms[i]
        if i >? 0 {name="{name} | "}
        name="{name}{uu_inputs[0].host[0].type_str_postfix(m)}"
        if tu_has_var(tu_prune(m)) {hv=true}
    }
    let si=StructInfo[decl = 0  ntargs = int32(ms.length)  name = name  union_ = true  resolved = true]
    si.targs = int32(uu_inputs[0].args[0].length)
    loop m in ms {uu_inputs[0].args[0].push(int32(m))}
    si.variants = int32(uu_inputs[0].variants[0].length)
    si.nvariants = int32(ms.length)
    loop i in [0..int64(ms.length)) {
        let m=ms[i]
        uu_inputs[0].variants[0].push(Variant[name = int32(uu_inputs[0].host[0].intern(uu_inputs[0].host[0].type_str(m)))  fields = int32(uu_inputs[0].fields[0].length)  nfields = 1  tag = int32(i)  value = i])
        uu_inputs[0].fields[0].push(Field[name = int32(uu_inputs[0].host[0].intern("0"))  type = int32(m)])
    }
    let idx=uu_inputs[0].structs[0].length
    uu_inputs[0].structs[0].push(si)
    let flags:UWord=0
    if hv {flags=TF_HAS_VAR}
    uu_inputs[0].types[0].push(TypeInfo[kind='enum_'  st = int32(idx)  flags = int32(flags)])
    uu_inputs[0].structs[0][idx].type = int32(uu_inputs[0].types[0].length - 1)
    uu_candidates.push(idx)
    if stable {uu_instances[ms] = uu_inputs[0].types[0].length - 1}
    uu_inputs[0].types[0].length - 1
}

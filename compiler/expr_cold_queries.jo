# is record `to` an operand of intersection `from` (or of one of its operands)?
intersection_within = (from: int, to: int) -> bool:
    if not structs[int(types[from].st)].resolved: check_struct_fields(int(types[from].st))
    loop part in intersection_parts.get(from) ?? []:
        if part == to or intersection_within(part, to): return true
    false
# A Dewy closure's capture of a name its `$capture` list does not mention.
implicit_capture = (l: int) -> bool:
    d = int(fns[int(locals[l].owner)].decl)
    if d == 0 or not files[pos_file(nodes[d].pos)].is_dewy or has_flag(d, NF_LANG_BODY): return false
    loop cap in lambda_captures(d):
        if nodes[cap].name == locals[l].name: return false
    true
src_char = (p: int) -> u8:
    f = pos_file(p)
    if p <= 0 or f < 0 or f >= files.len(): return 0
    o = pos_off(p)
    if o >= len(files[f].src): return 0
    files[f].src[o]
# `T.name` (decisions.md, batch 7): a type's canonical short name, "" when it has none. A
# declared record or a generic one's instance is its declaration's name (`Closed<Job>` is
# `Closed`; the module is not part of it); an alias of a named type is that type's; a builtin is
# its spelling; a text literal is its text when that is a name. Anonymous records and unions
# have none.
type_short_name = (t0: int) -> str:
    t = prune(t0)
    if is_union(t): return ""
    text = ""
    if tkind(t) == .struct_ or tkind(t) == .enum_:
        d = int(structs[int(types[t].st)].decl)
        if d != 0 and nodes[d].name != 0: text = name_of(int(nodes[d].name))
    else:
        set = str_set_of(t)
        if set != 0:
            if str_sets[set].len() == 1: text = str_sets[set].sorted()[0]
        else: text = dt(t)
    if len(text) == 0 or not is_alpha(text[0]): return ""
    loop i in [0..len(text)):
        if not is_alpha(text[i]) and not is_digit(text[i]): return ""
    text

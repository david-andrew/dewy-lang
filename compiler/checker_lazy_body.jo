use 'ast.jo'
use 'icount.jo'
use 'icount_ops.dewy'
use 'parser_text.dewy'

# (a lazy body's lexing and parsing is frontend work, whoever asks for it first)
load_body = (decl: int, f: int):
    b = int(nodes[decl].b)
    if b == 0 or not has_flag(b, NF_LAZY): return
    icl = ic_fn(IC_LOAD, f)
    ensure_body(decl)
    ic_restore(icl)

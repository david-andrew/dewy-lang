use 'checker_state.dewy'
use 'effect_types.dewy'
use 'effect_lattice.dewy'
use 'checker_types.dewy'
# Shared declaration identity. Evaluation values and epochs belong to facts.
use 'ast.jo'
use 'check.jo'
use 'expr.jo'
use 'types.jo'

# A checked Mutex payload is a stable, guard-scoped place. Its raw pointer
# route is for lowering only; analyses use the alias declaration as its root.
# Registered once while taking the place, expected O(1) per lookup.
place_locked: {int: bool} = {}



# Projection parents are interned only on demand. Zero means unknown, never a
# fresh invented root. Field selectors are declaration names, not byte offsets.
# Hash-indexed: O(1) expected per intern (a linear scan made it O(P^2)).
place_parents: PlaceIdentity[] = [PlaceIdentity(.local, 0, 0)]
place_index: {PlaceIdentity: int} = {}

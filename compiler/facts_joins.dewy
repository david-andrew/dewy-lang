JoinWord:type=int64<overflow='wrap'>
let fj_same_gen:array<int32>=[]
let fj_same_idx:array<int32>=[]
let fj_same_g:int32=0
let fj_ren_g:int32=0
let fj_lm_gen:array<int32>=[]
let fj_lm_val:array<int32>=[]
let fj_rm_gen:array<int32>=[]
let fj_rm_val:array<int32>=[]
let fj_lr_gen:array<int32>=[]
let fj_lr_val:array<int32>=[]
let fj_rl_gen:array<int32>=[]
let fj_rl_val:array<int32>=[]
let fj_left_pool:array<int64>=[]
let fj_right_pool:array<int64>=[]
let fj_merged_pool:array<int64>=[]
let fj_chg_l_pool:array<int64>=[]
let fj_chg_r_pool:array<int64>=[]
let fj_chg_idx_pool:array<int64>=[]
let fj_pairs_pool:array<int64>=[]
let fj_elem_keys=dict<[int64 int64] int64>()

fj_ensure_same=(need:JoinWord):>int32=>$unsafe {
    if fj_same_gen.length <? need {
        let sz=need + 256
        fj_same_gen.resize(sz)
        fj_same_idx.resize(sz)
    }
    fj_same_g=int32<overflow='wrap'>(int64(fj_same_g) + 1)
    if fj_same_g =? int32(0) {
        mem_set(fj_same_gen.ptr as ptr<uint8> 0 fj_same_gen.length * 4)
        fj_same_g=int32(1)
    }
    fj_same_g
}

fj_ensure_ren=(need:JoinWord):>int32=>$unsafe {
    if fj_lm_gen.length <? need {
        let sz=need + 256
        fj_lm_gen.resize(sz); fj_lm_val.resize(sz)
        fj_rm_gen.resize(sz); fj_rm_val.resize(sz)
        fj_lr_gen.resize(sz); fj_lr_val.resize(sz)
        fj_rl_gen.resize(sz); fj_rl_val.resize(sz)
    }
    fj_ren_g=int32<overflow='wrap'>(int64(fj_ren_g) + 1)
    if fj_ren_g =? int32(0) {
        let n=fj_lm_gen.length * 4
        mem_set(fj_lm_gen.ptr as ptr<uint8> 0 n)
        mem_set(fj_rm_gen.ptr as ptr<uint8> 0 n)
        mem_set(fj_lr_gen.ptr as ptr<uint8> 0 n)
        mem_set(fj_rl_gen.ptr as ptr<uint8> 0 n)
        fj_ren_g=int32(1)
    }
    fj_ren_g
}

fj_ren_lookup=(v:JoinWord gen_p:ptr<int32> val_p:ptr<int32> rg:int32 cap:JoinWord @shared:FactState):>JoinWord=>$unsafe {
    if v >=? 0 and v <? cap and gen_p[v] =? rg {return JoinWord(val_p[v])}
    if fact_slot_ref(@shared v) >=? 0 {return v}
    0
}

fj_ren_lookup_raw=(v:JoinWord gen_p:ptr<int32> val_p:ptr<int32> rg:int32 cap:JoinWord ids:ptr<int64> n_ids:JoinWord slots_p:ptr<int64> slots_n:JoinWord gterms:ptr<FactTerm> ngterms:JoinWord):>JoinWord=>$unsafe {
    if v >=? 0 and v <? cap and gen_p[v] =? rg {return JoinWord(val_p[v])}
    if n_ids =? 0 {return 0}
    if v >? 0 and v <? ngterms {
        let hint:JoinWord=gterms[v].slot
        if hint >=? 0 and hint <? n_ids and ids[hint] =? v {return v}
    }
    if fact_slot_slow_raw(slots_p slots_n v n_ids ids) >=? 0 {return v}
    0
}

fact_hull=(a:FactBound b:FactBound at:JoinWord):>FactBound=>{
    FactBound(min(a.lo b.lo) max(a.hi b.hi) (a.nz or a.lo >? 0 or a.hi <? 0) and (b.nz or b.lo >? 0 or b.hi <? 0) fact_hull_reason(at) at a.wide or b.wide)
}
fact_hull_reason=(at:JoinWord):>FactReason=>$unsafe {
    if at not=? 0 and (nodes.ptr[at].kind =? 'while_' or nodes.ptr[at].kind =? 'for_') {FactReason.loop_} else {FactReason.join}
}
# Every value's interval hulled at once: the reason is the join point's.
fact_hull_all=(@s:FactState a:FactState b:FactState count:JoinWord at:JoinWord):>void=>$unsafe {
    let ap=a.bounds.ptr
    let bp=b.bounds.ptr
    if ap =? bp {return}
    let reason=fact_hull_reason(at)
    let unique=false
    let sp:ptr<FactBound>=uint64(0) as ptr<FactBound>
    loop i in [0..count) {
        let xp=ap + i
        let yp=bp + i
        if xp[0].lo =? yp[0].lo and xp[0].hi =? yp[0].hi and xp[0].nz =? yp[0].nz and xp[0].wide =? yp[0].wide and xp[0].reason =? yp[0].reason and xp[0].witness =? yp[0].witness {continue}
        let h=FactBound(min(xp[0].lo yp[0].lo) max(xp[0].hi yp[0].hi) (xp[0].nz or xp[0].lo >? 0 or xp[0].hi <? 0) and (yp[0].nz or yp[0].lo >? 0 or yp[0].hi <? 0) reason at xp[0].wide or yp[0].wide)
        if not unique {
            s.bounds[i]=h
            sp=s.bounds.ptr
            unique=true
        } else {
            sp[i]=h
        }
    }
}
# A phi keeps a shared representation, including a fixed word's finite
# endpoints and uint64's biased encoding. Bounds still join independently.
# O(1); never recover a fixed type from only one predecessor.
# Different representations whose values both have finite host endpoints (a
# fixed signed or narrow word, a singleton) share int64's: the hull is finite.
# uint64's biased encoding joins only itself. O(1) per differing binding.
# A conditional array or text keeps the hull of its live arms' lengths (`let [a b]
# = if c [x y] else [z w]` unpacks two). Only when every arm's length is
# known; demanded values only. O(1) indexed projection lookups.
fact_join_length=(@s:FactState v:JoinWord a:FactState x:JoinWord b:FactState y:JoinWord at:JoinWord):>void=>{
    let kind=tkind(fact_type(fact_terms[v].type))
    if (kind not=? 'array' and kind not=? 'str_') or s.projections.length >=? FACT_CAP or not a.live and not b.live {return}
    let bound=FactBound()
    let seen=false
    loop arm in [0..2) {
        let st=if arm =? 0 {a} else {b}
        if not st.live {continue}
        let w=if arm =? 0 {x} else {y}
        if w =? 0 {return}
        let pi=fact_projection_find(st w (-1) false)
        if pi <? 0 {return}
        let c=fact_bound(st st.projections[pi].value)
        if c.wide {return}
        bound=if seen {fact_hull(bound c at)} else {c}
        seen=true
    }
    fact_add_projection(@s FactProjection(v (-1) false fact_new(@s bound FactTerm(type=T_INT))))
}
fact_join_term=(sa:FactState a:JoinWord sb:FactState b:JoinWord):>FactTerm=>{
    let t=fact_terms[a].type
    if t =? fact_terms[b].type {return FactTerm(type=t)}
    # (finite through a guard row too, as fact_hull_type: an untyped hull's MIN/MAX would be open)
    FactTerm(type=(if fact_host_finite(sa a) and fact_host_finite(sb b) {T_INT} else {0}))
}
# A value hull (a conditional expression, coalescing, match arms) keeps its
# static type unless that is mathematical int and both incoming values have
# finite host endpoints; then the hull is a finite int64 value. Bounded by
# the incident rows fact_host_endpoint inspects; evaluated once per hull.
fact_hull_type=(t:JoinWord sa:FactState a:JoinWord sb:FactState b:JoinWord):>JoinWord=>{
    if fact_type(t) not=? T_MATH_INT or not fact_host_finite(sa a) or not fact_host_finite(sb b) {return t}
    T_INT
}
# A dictionary one path grew by adding keys (`if c d[k] = x`) from the
# comprehension dictionary the other kept, or both grew from one: the merge
# holds every key that dictionary held. O(1) indexed lookups per renamed binding.
fact_join_grown=(@s:FactState a:FactState va:JoinWord b:FactState vb:JoinWord merged:JoinWord):>void=>{
    let ra=fact_grown_root(a va)
    if ra =? 0 or ra not=? fact_grown_root(b vb) or fact_slot(s ra) <? 0 or s.projections.length >=? FACT_CAP {return}
    fact_add_projection(@s FactProjection(merged FACT_MAP_GROWN false ra))
}
# The comprehension dictionary map is or grew from, or 0. O(1).
fact_grown_root=(s:FactState map:JoinWord):>JoinWord=>{
    if fact_grown_roots.has(map) {return map}
    let g=fact_projection_find(s map FACT_MAP_GROWN false)
    if g <? 0 {return 0}
    s.projections[g].value
}
# After a key-adding store: after holds every key of before's root, or of
# before itself when its key positions are known (a comprehension's after
# entry changes, fact_map_member). O(1).
fact_map_grew=(@s:FactState before:JoinWord after:JoinWord):>void=>{
    if before =? 0 or fact_slot(s before) <? 0 {return}
    let root=fact_grown_root(s before)
    if root =? 0 and fact_projection_find(s before FACT_MAP_POSITIONS false) >=? 0 {root=before}
    if root not=? 0 and fact_slot(s root) >=? 0 and s.projections.length <? FACT_CAP {fact_add_projection(@s FactProjection(after FACT_MAP_GROWN false root))}
}
fact_host_finite=(s:FactState v:JoinWord):>bool=>{
    if v =? 0 or fact_type(fact_terms[v].type) =? T_U64 {return false}
    fact_host_value(s v) or fact_host_endpoint(s v false) and fact_host_endpoint(s v true)
}
# Consuming join: mutates @a in place when frames match or @b only extends @a
# (zero FactState/index clones) and clears @b so refcounts drop immediately.
fact_join_into=(@a:FactState @b:FactState at:JoinWord):>void=>$unsafe {
    if not a.live {a=b; b=FactState(live=false); return}
    if not b.live {return}
    let same_cond=a.conditional.length =? b.conditional.length and (a.conditional.ptr =? b.conditional.ptr or a.conditional =? b.conditional)
    if same_cond {
        let alen:JoinWord=a.ids.length
        let blen:JoinWord=b.ids.length
        let same_bind=a.bindings.length =? b.bindings.length and (a.bindings.ptr =? b.bindings.ptr or a.bindings =? b.bindings)
        if same_bind {
            let same_ids=alen =? blen and (a.ids.ptr =? b.ids.ptr or a.ids =? b.ids)
            let a_prefix_ids=same_ids
            let swapped=false
            if not a_prefix_ids and alen <=? blen {
                let aids=a.ids.ptr
                let bids=b.ids.ptr
                let k:JoinWord=0
                loop k <? alen and aids[k] =? bids[k] {k += 1}
                if k =? alen {a_prefix_ids=true}
            } else if not a_prefix_ids and blen <? alen {
                let aids=a.ids.ptr
                let bids=b.ids.ptr
                let k:JoinWord=0
                loop k <? blen and aids[k] =? bids[k] {k += 1}
                if k =? blen {
                    let aplen0:JoinWord=a.projections.length
                    let bplen0:JoinWord=b.projections.length
                    let b_pref_p=aplen0 =? bplen0 and (a.projections.ptr =? b.projections.ptr or a.projections =? b.projections)
                    if not b_pref_p and bplen0 <=? aplen0 {
                        let ap0=a.projections.ptr
                        let bp0=b.projections.ptr
                        let kp0:JoinWord=0
                        loop kp0 <? bplen0 and ap0[kp0] =? bp0[kp0] {kp0 += 1}
                        if kp0 =? bplen0 {
                            b_pref_p=true
                            loop j in [bplen0..aplen0) {
                                if ap0[j].element {b_pref_p=false; break}
                            }
                        }
                    }
                    if b_pref_p {
                        let tmp=a; a=b; b=tmp
                        alen=blen
                        blen=b.ids.length
                        a_prefix_ids=true
                        swapped=true
                    }
                }
            }
            if not a_prefix_ids and a.index.ptr[0].slots.length =? 0 and b.index.ptr[0].slots.length =? 0 {
                let aids=a.ids.ptr
                let bids=b.ids.ptr
                let common_id=min(alen blen)
                let k:JoinWord=0
                loop k <? common_id and aids[k] =? bids[k] {k += 1}
                if k >? 0 and k <? alen and k <? blen and (aids[alen - 1] <? bids[k] or aids[k] >? bids[blen - 1]) {
                    let aplen0:JoinWord=a.projections.length
                    let bplen0:JoinWord=b.projections.length
                    if aplen0 =? bplen0 and (a.projections.ptr =? b.projections.ptr or a.projections =? b.projections) {
                        let ap0=a.projections.ptr
                        let pok=true
                        let hi_id=aids[k - 1]
                        loop pi in [JoinWord(0)..aplen0) {
                            if ap0[pi].base >? hi_id or ap0[pi].value >? hi_id {pok=false; break}
                        }
                        if pok {
                            a.ids.truncate(k)
                            a.bounds.truncate(k)
                            alen=k
                            a_prefix_ids=true
                        }
                    }
                }
            }
            if a_prefix_ids {
                let aplen:JoinWord=a.projections.length
                let bplen:JoinWord=b.projections.length
                let same_proj=aplen =? bplen and (a.projections.ptr =? b.projections.ptr or a.projections =? b.projections)
                let a_prefix_proj=same_proj or swapped
                if not a_prefix_proj and aplen <=? bplen {
                    let ap=a.projections.ptr
                    let bp=b.projections.ptr
                    let kp:JoinWord=0
                    loop kp <? aplen and ap[kp] =? bp[kp] {kp += 1}
                    if kp =? aplen {
                        a_prefix_proj=true
                        loop j in [aplen..bplen) {
                            if bp[j].element {a_prefix_proj=false; break}
                        }
                    }
                }
                if a_prefix_proj {
                    let adlen:JoinWord=a.differences.length
                    let bdlen:JoinWord=b.differences.length
                    if not (adlen =? bdlen and (a.differences.ptr =? b.differences.ptr or a.differences =? b.differences)) {
                        let adp=a.differences.ptr
                        let bdp=b.differences.ptr
                        let common:JoinWord=0
                        let mindiff=min(adlen bdlen)
                        loop common <? mindiff and adp[common] =? bdp[common] {common += 1}
                        if common =? adlen {
                            loop i in [common..bdlen) {
                                let row=bdp[i]
                                if fact_slot_ref(@a row.a) >=? 0 and fact_slot_ref(@a row.b) >=? 0 and fact_distance(a row.a row.b row.limit) {
                                    fact_difference(@a row.a row.b row.limit row.at)
                                }
                            }
                        } else {
                            let a_snap=a
                            a.differences=[]
                            a.diff_a_mask=0
                            a.diff_b_mask=0
                            if a.index.ptr[0].difference_next.length not=? 0 {
                                a.index[0].difference_index=[]
                                a.index[0].difference_value=[]
                                a.index[0].difference_record=[]
                                a.index[0].difference_next=[]
                            }
                            fact_join_shared_rows(@a a_snap b)
                        }
                    }
                    a.cmp_mask=JoinWord(a.cmp_mask) | JoinWord(b.cmp_mask)
                    a.full=false
                    let bp=b.bounds.ptr
                    let ap=a.bounds.ptr
                    if ap not=? bp {
                        let reason=fact_hull_reason(at)
                        let unique=false
                        loop i in [0..alen) {
                            let xp=ap + i
                            let yp=bp + i
                            if xp[0].lo =? yp[0].lo and xp[0].hi =? yp[0].hi and xp[0].nz =? yp[0].nz and xp[0].wide =? yp[0].wide and xp[0].reason =? yp[0].reason and xp[0].witness =? yp[0].witness {continue}
                            let h=FactBound(min(xp[0].lo yp[0].lo) max(xp[0].hi yp[0].hi) (xp[0].nz or xp[0].lo >? 0 or xp[0].hi <? 0) and (yp[0].nz or yp[0].lo >? 0 or yp[0].hi <? 0) reason at xp[0].wide or yp[0].wide)
                            if not unique {
                                a.bounds[i]=h
                                ap=a.bounds.ptr
                                unique=true
                            } else {
                                ap[i]=h
                            }
                        }
                    }
                    b=FactState(live=false)
                    return
                }
            }
        }
    }
    a=fact_join(a b at)
    b=FactState(live=false)
}
fact_join=(a:FactState b:FactState at:JoinWord):>FactState=>$unsafe {
    if not a.live {return b}
    if not b.live {return a}
    # Identical frames need only an interval hull. In particular, branching
    # on a captured guard need not rebuild every immutable projection index.
    let same_ids=a.ids.length =? b.ids.length and (a.ids.ptr =? b.ids.ptr or a.ids =? b.ids)
    let same_cond=a.conditional.length =? b.conditional.length and (a.conditional.ptr =? b.conditional.ptr or a.conditional =? b.conditional)
    let same_bind=false
    let bind_checked=false
    let same_proj=false
    let proj_checked=false
    if same_ids and same_cond {
        same_bind=a.bindings.length =? b.bindings.length and (a.bindings.ptr =? b.bindings.ptr or a.bindings =? b.bindings)
        bind_checked=true
        if same_bind {
            same_proj=a.projections.length =? b.projections.length and (a.projections.ptr =? b.projections.ptr or a.projections =? b.projections)
            proj_checked=true
            if same_proj and a.differences.length =? b.differences.length and (a.differences.ptr =? b.differences.ptr or a.differences =? b.differences) {
                let s=a
                s.cmp_mask=JoinWord(a.cmp_mask) | JoinWord(b.cmp_mask)
                s.full=false
                fact_hull_all(@s a b s.bounds.length at)
                return s
            }
        }
    }
    let s=FactState(index=fact_empty_index)
    s.cmp_mask=JoinWord(a.cmp_mask) | JoinWord(b.cmp_mask)
    # (both paths usually inherit one list: keep it without hashing)
    if same_cond {s.conditional=a.conditional}
    else if a.conditional.length >? 0 and b.conditional.length >? 0 {
        let evidence_index=dict<ResultEvidence bool>()
        loop evidence in b.conditional {evidence_index[evidence]=true}
        loop evidence in a.conditional {
            if evidence_index.has(evidence) {s.conditional.push(evidence)}
        }
    }
    # Keep immutable evaluations shared by both paths, including snapshots.
    let shared=true
    let ids_match_a=same_ids
    let ids_match_b=same_ids
    if same_ids {
        s.ids=a.ids
        if a.index.ptr[0].slots.length not=? 0 {s.index[0].slots=a.index[0].slots}
        s.bounds=a.bounds
        fact_hull_all(@s a b s.bounds.length at)
    }
    else {
        # Both paths usually extend one entry frame with their own values: the
        # shared values are then a's prefix, kept with a's index. O(V).
        let k:JoinWord=0
        let alen:JoinWord=a.ids.length
        let blen:JoinWord=b.ids.length
        let common=min(alen blen)
        let aids=a.ids.ptr
        let bids=b.ids.ptr
        loop k <? common and aids[k] =? bids[k] {k += 1}
        let prefix=true
        if k <? alen {
            let sorted=a.index.ptr[0].slots.length =? 0 and b.index.ptr[0].slots.length =? 0
            let disjoint=sorted and (k =? blen or aids[alen - 1] <? bids[k] or aids[k] >? bids[blen - 1])
            if not disjoint {
                loop i in [k..alen) {
                    if fact_slot(b aids[i]) >=? 0 {prefix=false; break}
                }
            }
        }
        if prefix {
            if k <? alen {
                s.ids=a.ids[0..k)
                s.bounds=a.bounds[0..k)
            }
            else {
                s.ids=a.ids
                s.bounds=a.bounds
                ids_match_a=true
            }
            if k =? blen {ids_match_b=true}
            if a.index.ptr[0].slots.length not=? 0 {s.index[0].slots=a.index[0].slots}
            fact_hull_all(@s a b k at)
        }
        else {
            shared=false
            let abp=a.bounds.ptr
            let bbp=b.bounds.ptr
            loop i in [0..alen) {
                let j=fact_slot(b aids[i])
                if j >=? 0 {fact_add_value(@s aids[i] fact_hull(abp[i] bbp[j] at))}
            }
        }
    }
    # When one path's projections are the other's first ones (the other path
    # only added projections), the shared projections are exactly the shorter
    # list: keep it with its index. O(P) comparisons, no hashing.
    let from_:JoinWord=-1
    if shared and not proj_checked {
        same_proj=a.projections.length =? b.projections.length and (a.projections.ptr =? b.projections.ptr or a.projections =? b.projections)
    }
    if same_proj and shared {
        from_=0
        if not ids_match_a {
            let ap=a.projections.ptr
            loop i in [0..a.projections.length) {
                if fact_slot_ref(@s ap[i].base) <? 0 or fact_slot_ref(@s ap[i].value) <? 0 {from_=-1; break}
            }
        }
    }
    else {
        let kp:JoinWord=0
        let ap=a.projections.ptr
        let bp=b.projections.ptr
        let common_projections=min(a.projections.length b.projections.length)
        loop kp <? common_projections and ap[kp] =? bp[kp] {kp += 1}
        if shared and (kp =? a.projections.length or kp =? b.projections.length) {
            from_=if kp =? b.projections.length {1} else {0}
            let skip_check=if from_ =? 1 {ids_match_b} else {ids_match_a}
            if not skip_check {
                if from_ =? 1 {
                    loop i in [0..b.projections.length) {
                        if fact_slot_ref(@s bp[i].base) <? 0 or fact_slot_ref(@s bp[i].value) <? 0 {from_=-1; break}
                    }
                } else {
                    loop i in [0..a.projections.length) {
                        if fact_slot_ref(@s ap[i].base) <? 0 or fact_slot_ref(@s ap[i].value) <? 0 {from_=-1; break}
                    }
                }
            }
        }
    }
    if from_ >=? 0 {
        let src=if from_ =? 1 {b} else {a}
        s.projections=src.projections
        s.proj_base_mask=src.proj_base_mask
        if src.index.ptr[0].projection_next.length not=? 0 {
            s.index[0].projection_index=src.index[0].projection_index
            s.index[0].projection_head=src.index[0].projection_head
            s.index[0].projection_tail=src.index[0].projection_tail
            s.index[0].projection_next=src.index[0].projection_next
            s.index[0].projection_value=src.index[0].projection_value
        }
    }
    else if b.projections.length >? 0 {
        # (b holds p when p is on b's chain for p.base: every projection is chained)
        let ap=a.projections.ptr
        let bp=b.projections.ptr
        let b_pmask0:JoinWord=b.proj_base_mask
        loop i in [0..a.projections.length) {
            let p=ap[i]
            if (b_pmask0 & (JoinWord(1) << (JoinWord(p.base) & 63))) =? 0 {continue}
            if fact_slot_ref(@s p.base) <? 0 or fact_slot_ref(@s p.value) <? 0 {continue}
            let qi=fact_projection_first(b p.base)
            loop qi >=? 0 {
                if bp[qi] =? p {break}
                qi=fact_projection_after(b qi)
            }
            if qi >=? 0 {fact_add_projection(@s p)}
        }
    }
    let proj_prefix_ok=same_proj
    let proj_no_elem=same_proj
    if not proj_prefix_ok and from_ >=? 0 {
        proj_prefix_ok=true
        if from_ =? 0 {
            let bp=b.projections.ptr
            loop j in [a.projections.length..b.projections.length) {
                if bp[j].element {proj_prefix_ok=false; break}
            }
            if proj_prefix_ok {
                proj_no_elem=true
                let ap=a.projections.ptr
                loop j in [0..a.projections.length) {
                    if ap[j].element {proj_no_elem=false; break}
                }
            }
        } else {
            let ap=a.projections.ptr
            loop j in [b.projections.length..a.projections.length) {
                if ap[j].element {proj_prefix_ok=false; break}
            }
            if proj_prefix_ok {
                proj_no_elem=true
                let bp=b.projections.ptr
                loop j in [0..b.projections.length) {
                    if bp[j].element {proj_no_elem=false; break}
                }
            }
        }
    }
    if (proj_prefix_ok and (from_ <=? 0 or proj_no_elem)) and (same_bind or (not bind_checked and a.bindings.length =? b.bindings.length and (a.bindings.ptr =? b.bindings.ptr or a.bindings =? b.bindings))) {
        s.bindings=a.bindings
        if a.index.ptr[0].roots.length not=? 0 {s.index[0].roots=a.index[0].roots}
        fact_join_shared_rows(@s a b)
        return s
    }
    let renamed=false
    let left=fj_left_pool; fj_left_pool=[]; left.clear()
    let right=fj_right_pool; fj_right_pool=[]; right.clear()
    let merged=fj_merged_pool; fj_merged_pool=[]; merged.clear()
    let chg_l=fj_chg_l_pool; fj_chg_l_pool=[]; chg_l.clear()
    let chg_r=fj_chg_r_pool; fj_chg_r_pool=[]; chg_r.clear()
    let chg_idx=fj_chg_idx_pool; fj_chg_idx_pool=[]; chg_idx.clear()
    # (merged value pairs: identity pairs (v, v) use O(1) generation stamp;
    # changed pairs scan a tiny list, then an open-address index)
    let pairs=fj_pairs_pool; fj_pairs_pool=[]; pairs.clear()
    let term_cap:JoinWord=fact_terms.length + 1
    let sg=fj_ensure_same(term_cap)
    let same_gen_p=fj_same_gen.ptr
    let same_idx_p=fj_same_idx.ptr
    # Both paths keep their common ancestor's bindings in its order (a place
    # is appended when first bound): the aligned positions merge in place,
    # keeping a's positions and so a's root index. O(1) each, no hashing
    # unless the values differ.
    let aligned:JoinWord=0
    let abp=a.bindings.ptr
    let bbp=b.bindings.ptr
    let common=min(a.bindings.length b.bindings.length)
    loop aligned <? common {
        let ap=abp + aligned
        let bp=bbp + aligned
        if ap[0].place.declaration not=? bp[0].place.declaration or ap[0].place.root not=? bp[0].place.root or ap[0].place.owner not=? bp[0].place.owner or ap[0].place.parent not=? bp[0].place.parent or ap[0].place.projection not=? bp[0].place.projection or ap[0].place.selector not=? bp[0].place.selector {break}
        aligned += 1
    }
    if aligned <? a.bindings.length {s.bindings=a.bindings[0..aligned)} else {s.bindings=a.bindings}
    if a.index.ptr[0].roots.length not=? 0 {s.index[0].roots=a.index[0].roots}
    loop i in [0..aligned) {
        let ap=abp + i
        let bp=bbp + i
        let bval=ap[0].value
        let other=bp[0].value
        if bval =? other {
            if ap[0].event not=? 0 and bp[0].event not=? ap[0].event {
                s.bindings[i]=FactBinding(ap[0].place bval)
            }
            if bval >=? 0 and bval <? term_cap {
                if same_gen_p[bval] not=? sg {
                    same_gen_p[bval]=sg
                    same_idx_p[bval]=int32<overflow='wrap'>(left.length)
                    left.push(bval)
                    right.push(bval)
                    merged.push(bval)
                }
            } else {
                let prior=fact_pair_find(chg_l chg_r pairs bval bval)
                if prior <? 0 {
                    let pair=fact_pair_key(bval bval)
                    fact_pair_add(chg_l chg_r @pairs pair)
                    chg_l.push(bval); chg_r.push(bval); chg_idx.push(left.length)
                    left.push(bval); right.push(bval); merged.push(bval)
                }
            }
            continue
        }
        renamed=true
        let v=bval
        let prior=fact_pair_find(chg_l chg_r pairs bval other)
        if prior >=? 0 {v=merged.ptr[chg_idx.ptr[prior]]}
        else {
            v=fact_new(@s fact_hull(fact_bound(a v) fact_bound(b other) at) fact_join_term(a v b other))
            fact_join_grown(@s a bval b other v)
        }
        # (the tombstone survives when both paths share it)
        if v not=? bval or (ap[0].event not=? 0 and bp[0].event not=? ap[0].event) {
            s.bindings[i]=FactBinding(ap[0].place v)
        }
        if prior <? 0 {
            let pair=fact_pair_key(bval other)
            fact_pair_add(chg_l chg_r @pairs pair)
            chg_l.push(bval); chg_r.push(other); chg_idx.push(left.length)
            left.push(bval)
            right.push(other)
            merged.push(v)
        }
    }
    loop ai in [aligned..a.bindings.length) {
        let binding=abp[ai]
        let j=fact_binding(b binding.place)
        if j <? 0 {continue}
        let other=bbp[j].value
        let bval=binding.value
        let v=bval
        let prior:JoinWord=-1
        if bval =? other and bval >=? 0 and bval <? term_cap {
            if same_gen_p[bval] =? sg {prior=JoinWord(same_idx_p[bval])}
        } else {
            if bval not=? other {renamed=true}
            let cp=fact_pair_find(chg_l chg_r pairs bval other)
            if cp >=? 0 {prior=chg_idx.ptr[cp]}
        }
        if prior >=? 0 {v=merged.ptr[prior]}
        else if v not=? other {
            v=fact_new(@s fact_hull(fact_bound(a v) fact_bound(b other) at) fact_join_term(a v b other))
            fact_join_grown(@s a bval b other v)
        }
        fact_bind(@s binding.place v)
        if v =? bval and bbp[j].event =? binding.event {fact_rebind(@s binding.place v binding.event binding.prior)}
        if prior <? 0 {
            if bval =? other and bval >=? 0 and bval <? term_cap {
                same_gen_p[bval]=sg
                same_idx_p[bval]=int32<overflow='wrap'>(left.length)
            } else {
                let pair=fact_pair_key(bval other)
                fact_pair_add(chg_l chg_r @pairs pair)
                chg_l.push(bval); chg_r.push(other); chg_idx.push(left.length)
            }
            left.push(bval)
            right.push(other)
            merged.push(v)
        }
    }
    let binding_pairs=merged.length
    # Match projections of merged aggregate values, including current lengths.
    # (each side's non-element projections chained by base value, in order:
    # the same matches as scanning both lists for every merged value)
    if a.projections.length >? 0 and b.projections.length >? 0 {
        let cursor:JoinWord=0
        let element_keys_ready=false
        let ap_p=a.projections.ptr
        let bp_p=b.projections.ptr
        let a_pmask:JoinWord=a.proj_base_mask
        let b_pmask:JoinWord=b.proj_base_mask
        loop cursor <? merged.length and merged.length <? FACT_CAP {
            let lv=left.ptr[cursor]
            let rv=right.ptr[cursor]
            if (proj_no_elem and lv =? rv) or (a_pmask & (JoinWord(1) << (lv & 63))) =? 0 or (b_pmask & (JoinWord(1) << (rv & 63))) =? 0 {
                cursor += 1
                continue
            }
            let pi=fact_projection_first(a lv)
            loop pi >=? 0 {
                let p=ap_p[pi]
                pi=fact_projection_after(a pi)
                let selector=p.selector
                let qi=fact_projection_find(b rv selector p.element)
                if p.element {
                    let key=fact_bound(a selector)
                    if key.lo =? key.hi and not key.wide {
                        # Constants created separately in the arms have different
                        # value IDs. Index the peer's constant selectors once, O(P).
                        if not element_keys_ready {
                            fj_elem_keys.clear()
                            loop j in [0..b.projections.length) {
                                let candidate=bp_p[j]
                                if not candidate.element {continue}
                                let cb=fact_bound(b candidate.selector)
                                if cb.lo =? cb.hi and not cb.wide {fj_elem_keys[[candidate.base cb.lo]]=j}
                            }
                            element_keys_ready=true
                        }
                        qi=fj_elem_keys.get([rv key.lo]) ?? -1
                        if qi >=? 0 and fact_slot_ref(@s selector) <? 0 {selector=fact_constant(@s key.lo)}
                    }
                    else if fact_slot_ref(@s selector) <? 0 {continue}
                }
                if qi <? 0 {continue}
                let q=bp_p[qi]
                if merged.length >=? FACT_CAP {break}
                let pv=p.value
                let qv=q.value
                let v=pv
                let prior:JoinWord=-1
                if pv =? qv and pv >=? 0 and pv <? term_cap {
                    if same_gen_p[pv] =? sg {prior=JoinWord(same_idx_p[pv])}
                } else {
                    if pv not=? qv {renamed=true}
                    let cp=fact_pair_find(chg_l chg_r pairs pv qv)
                    if cp >=? 0 {prior=chg_idx.ptr[cp]}
                }
                if prior >=? 0 {v=merged.ptr[prior]}
                else if v not=? qv {v=fact_new(@s fact_hull(fact_bound(a v) fact_bound(b qv) at) fact_join_term(a v b qv))}
                if s.projections.length <? FACT_CAP {fact_add_projection(@s FactProjection(merged.ptr[cursor] selector p.element v))}
                if prior <? 0 {
                    if pv =? qv and pv >=? 0 and pv <? term_cap {
                        same_gen_p[pv]=sg
                        same_idx_p[pv]=int32<overflow='wrap'>(left.length)
                    } else {
                        let pair=fact_pair_key(pv qv)
                        fact_pair_add(chg_l chg_r @pairs pair)
                        chg_l.push(pv); chg_r.push(qv); chg_idx.push(left.length)
                    }
                    left.push(pv)
                    right.push(qv)
                    merged.push(v)
                }
            }
            cursor += 1
        }
    }
    if renamed {
        loop i in [0..binding_pairs) {
            if left.ptr[i] not=? right.ptr[i] {fact_join_payload(@s a left.ptr[i] b right.ptr[i] merged.ptr[i] left right merged FactBound() false)}
        }
    }
    if a.differences.length =? 0 and b.differences.length =? 0 {
        fj_left_pool=left; fj_right_pool=right; fj_merged_pool=merged
        fj_chg_l_pool=chg_l; fj_chg_r_pool=chg_r; fj_chg_idx_pool=chg_idx; fj_pairs_pool=pairs
        return s
    }
    # (renamings: the last pair naming a value wins, indexed in flat stamp arrays)
    let rcap:JoinWord=0
    let rg:int32=0
    let lm_gen_p:ptr<int32>=uint64(0) as ptr<int32>
    let lm_val_p:ptr<int32>=uint64(0) as ptr<int32>
    let rm_gen_p:ptr<int32>=uint64(0) as ptr<int32>
    let rm_val_p:ptr<int32>=uint64(0) as ptr<int32>
    let lr_gen_p:ptr<int32>=uint64(0) as ptr<int32>
    let lr_val_p:ptr<int32>=uint64(0) as ptr<int32>
    let rl_gen_p:ptr<int32>=uint64(0) as ptr<int32>
    let rl_val_p:ptr<int32>=uint64(0) as ptr<int32>
    let l_chg_mask:JoinWord=0
    let r_chg_mask:JoinWord=0
    if renamed {
        rcap=fact_terms.length + 1
        rg=fj_ensure_ren(rcap)
        lm_gen_p=fj_lm_gen.ptr; lm_val_p=fj_lm_val.ptr
        rm_gen_p=fj_rm_gen.ptr; rm_val_p=fj_rm_val.ptr
        lr_gen_p=fj_lr_gen.ptr; lr_val_p=fj_lr_val.ptr
        rl_gen_p=fj_rl_gen.ptr; rl_val_p=fj_rl_val.ptr
        let ml=merged.length
        let lp=left.ptr
        let rp=right.ptr
        let mp=merged.ptr
        loop i in [0..ml) {
            let lv=lp[i]
            let rv=rp[i]
            let mv=mp[i]
            if lv not=? mv {
                lm_gen_p[lv]=rg; lm_val_p[lv]=int32<overflow='wrap'>(mv)
                l_chg_mask |= (JoinWord(1) << (lv & 63))
            } else if lm_gen_p[lv] =? rg {
                if fact_slot_ref(@s lv) >=? 0 {lm_gen_p[lv]=int32(0)}
                else {lm_val_p[lv]=int32<overflow='wrap'>(mv)}
            }
            if rv not=? mv {
                rm_gen_p[rv]=rg; rm_val_p[rv]=int32<overflow='wrap'>(mv)
                r_chg_mask |= (JoinWord(1) << (rv & 63))
            } else if rm_gen_p[rv] =? rg {
                if fact_slot_ref(@s rv) >=? 0 {rm_gen_p[rv]=int32(0)}
                else {rm_val_p[rv]=int32<overflow='wrap'>(mv)}
            }
            lr_gen_p[lv]=rg; lr_val_p[lv]=int32<overflow='wrap'>(rv)
            rl_gen_p[rv]=rg; rl_val_p[rv]=int32<overflow='wrap'>(lv)
        }
    }
    # A shared prefix consists of facts already present in both predecessors.
    # Keep its rows without proving each one again or recounting incidents.
    # Endpoints must survive in the common frame; renamed rows still follow.
    let common_rows:JoinWord=0
    let adp=a.differences.ptr
    let bdp=b.differences.ptr
    let mindiff=min(a.differences.length b.differences.length)
    let skip_slot_a=ids_match_a or ids_match_b
    if adp =? bdp and a.differences.length =? b.differences.length and ids_match_a {
        common_rows=mindiff
    } else if skip_slot_a {
        loop common_rows <? mindiff {
            if adp[common_rows] not=? bdp[common_rows] {break}
            common_rows += 1
        }
    } else {
        loop common_rows <? mindiff {
            let row=adp[common_rows]
            if row not=? bdp[common_rows] or fact_slot_ref(@s row.a) <? 0 or fact_slot_ref(@s row.b) <? 0 {break}
            common_rows += 1
        }
    }
    if common_rows =? a.differences.length or common_rows =? b.differences.length {
        let src=if common_rows =? a.differences.length {a} else {b}
        s.differences=src.differences
        s.diff_a_mask=src.diff_a_mask
        s.diff_b_mask=src.diff_b_mask
        if src.index.ptr[0].difference_next.length not=? 0 {
            s.index[0].difference_index=src.index[0].difference_index
            s.index[0].difference_value=src.index[0].difference_value
            s.index[0].difference_record=src.index[0].difference_record
            s.index[0].difference_next=src.index[0].difference_next
        }
    }
    else {
        loop i in [0..common_rows) {fact_add_difference(@s adp[i])}
    }
    # Select rows from either predecessor, rename into the merge frame, and
    # require a proof from the other. Branch-local evaluations never escape.
    # (a row its renaming leaves as it is was just offered as it is: when
    # that offer held, the renamed one is the same call again, skipped. A
    # renamed endpoint equal to the original renames to it on the other side
    # too, or to nothing)
    if not renamed {
        loop ri in [common_rows..a.differences.length) {
            let row=adp[ri]
            if (ids_match_a or (fact_slot_ref(@s row.a) >=? 0 and fact_slot_ref(@s row.b) >=? 0)) and fact_distance(b row.a row.b row.limit) {fact_difference(@s row.a row.b row.limit row.at)}
        }
        loop ri in [common_rows..b.differences.length) {
            let row=bdp[ri]
            if (ids_match_b or (fact_slot_ref(@s row.a) >=? 0 and fact_slot_ref(@s row.b) >=? 0)) and fact_distance(a row.a row.b row.limit) {fact_difference(@s row.a row.b row.limit row.at)}
        }
        fj_left_pool=left; fj_right_pool=right; fj_merged_pool=merged
        fj_chg_l_pool=chg_l; fj_chg_r_pool=chg_r; fj_chg_idx_pool=chg_idx; fj_pairs_pool=pairs
        return s
    }
    let aids_p=a.ids.ptr; let an_ids:JoinWord=a.ids.length
    let aslots_p=a.index.ptr[0].slots.ptr; let aslots_n:JoinWord=a.index.ptr[0].slots.length
    let bids_p=b.ids.ptr; let bn_ids:JoinWord=b.ids.length
    let bslots_p=b.index.ptr[0].slots.ptr; let bslots_n:JoinWord=b.index.ptr[0].slots.length
    let gterms=fact_terms.ptr; let ngterms:JoinWord=fact_terms.length
    fj_join_diff_side(@s a b common_rows l_chg_mask lm_gen_p lm_val_p lr_gen_p lr_val_p rg rcap bids_p bn_ids bslots_p bslots_n gterms ngterms)
    fj_join_diff_side(@s b a common_rows r_chg_mask rm_gen_p rm_val_p rl_gen_p rl_val_p rg rcap aids_p an_ids aslots_p aslots_n gterms ngterms)
    if nodes.ptr[at].kind =? 'if_' {fj_join_offsets(@s a b left right merged binding_pairs)}
    # (a value two places held, one replaced on one path only, `let hi = o`
    # then `if hi <? lo hi = lo`: the renaming above follows its last pair;
    # each earlier pair's rows follow here. O(shadowed pairs x their rows))
    let lp2=left.ptr
    let rp2=right.ptr
    let mp2=merged.ptr
    loop i in [0..merged.length) {
        if lp2[i] =? rp2[i] {continue}
        if fj_ren_lookup(rp2[i] rm_gen_p rm_val_p rg rcap @s) not=? mp2[i] {fj_join_pair_rows_fast(@s b a rp2[i] lp2[i] mp2[i] rl_gen_p rl_val_p rm_gen_p rm_val_p rg rcap aids_p an_ids aslots_p aslots_n gterms ngterms)}
        if fj_ren_lookup(lp2[i] lm_gen_p lm_val_p rg rcap @s) not=? mp2[i] {fj_join_pair_rows_fast(@s a b lp2[i] rp2[i] mp2[i] lr_gen_p lr_val_p lm_gen_p lm_val_p rg rcap bids_p bn_ids bslots_p bslots_n gterms ngterms)}
    }
    fj_left_pool=left; fj_right_pool=right; fj_merged_pool=merged
    fj_chg_l_pool=chg_l; fj_chg_r_pool=chg_r; fj_chg_idx_pool=chg_idx; fj_pairs_pool=pairs
    s
}
fj_join_diff_side=(@s:FactState src:FactState peer:FactState common_rows:JoinWord chg_mask:JoinWord m_gen_p:ptr<int32> m_val_p:ptr<int32> r_gen_p:ptr<int32> r_val_p:ptr<int32> rg:int32 rcap:JoinWord pids:ptr<int64> pn_ids:JoinWord pslots:ptr<int64> pslots_n:JoinWord gterms:ptr<FactTerm> ngterms:JoinWord):>void=>$unsafe {
    let dp=src.differences.ptr
    let start_ri:JoinWord=if (chg_mask & (JoinWord(src.diff_a_mask) | JoinWord(src.diff_b_mask))) =? 0 {common_rows} else {0}
    loop ri in [start_ri..src.differences.length) {
        let row=dp[ri]
        if ri <? common_rows {
            if (row.a <? 0 or row.a >=? rcap or m_gen_p[row.a] not=? rg) and (row.b <? 0 or row.b >=? rcap or m_gen_p[row.b] not=? rg) {continue}
            let aa=fj_ren_lookup(row.a m_gen_p m_val_p rg rcap @s)
            let bb=fj_ren_lookup(row.b m_gen_p m_val_p rg rcap @s)
            if aa =? 0 or bb =? 0 or (aa =? row.a and bb =? row.b) {continue}
            let ra=fj_ren_lookup_raw(row.a r_gen_p r_val_p rg rcap pids pn_ids pslots pslots_n gterms ngterms)
            let rb=fj_ren_lookup_raw(row.b r_gen_p r_val_p rg rcap pids pn_ids pslots pslots_n gterms ngterms)
            if ra not=? 0 and rb not=? 0 and fact_distance(peer ra rb row.limit) {fact_difference(@s aa bb row.limit row.at)}
            else if aa not=? row.a and bb =? row.b and ra =? rb and ra not=? 0 and row.limit <? 0 {fact_difference(@s aa bb 0 row.at)}
            continue
        }
        let in_s=fact_slot_ref(@s row.a) >=? 0 and fact_slot_ref(@s row.b) >=? 0
        let kept=in_s and fact_distance(peer row.a row.b row.limit)
        if kept {fact_difference(@s row.a row.b row.limit row.at)}
        let aa=fj_ren_lookup(row.a m_gen_p m_val_p rg rcap @s)
        let bb=fj_ren_lookup(row.b m_gen_p m_val_p rg rcap @s)
        if aa =? 0 or bb =? 0 or (kept and aa =? row.a and bb =? row.b) {continue}
        let ra=fj_ren_lookup_raw(row.a r_gen_p r_val_p rg rcap pids pn_ids pslots pslots_n gterms ngterms)
        let rb=fj_ren_lookup_raw(row.b r_gen_p r_val_p rg rcap pids pn_ids pslots pslots_n gterms ngterms)
        let same_dist=not kept and in_s and ra =? row.a and rb =? row.b
        if not same_dist and ra not=? 0 and rb not=? 0 and fact_distance(peer ra rb row.limit) {fact_difference(@s aa bb row.limit row.at)}
        else if aa not=? row.a and bb =? row.b and ra =? rb and ra not=? 0 and row.limit <? 0 {fact_difference(@s aa bb 0 row.at)}
    }
}
# A value two paths moved by different constants from one common value,
# `if i + 1 <? n { i += 2 } else { i += 1 }`: no row names either path's
# value, but each path bounds it against the common value's rows, so the
# merged value keeps the tightest bound both prove (`i <=? n`). Only for
# such pairs, where an `if` joins its branches (a loop's own analysis carries
# its counters); O(rows of the common value x the steps' spread).
fj_join_offsets=(@s:FactState a:FactState b:FactState left:array<int64> right:array<int64> merged:array<int64> count:JoinWord):>void=>{
    let found:array<int64>=[]
    loop i in [0..count) {
        let lv=left[i]
        let rv=right[i]
        if lv =? rv {continue}
        let [base ka]=fj_offset(a lv)
        let [other kb]=fj_offset(b rv)
        if base =? 0 or base not=? other or ka =? kb or fact_slot_ref(@s base) <? 0 {continue}
        let lo=min(ka kb)
        let hi=max(ka kb)
        if hi - lo >? 8 {continue}
        let m=merged[i]
        found.clear()
        # (stepping up risks only the upper bounds, stepping down the lower ones)
        let direction:JoinWord=if lo >=? 0 {1} else if hi <=? 0 {0} else {-1}
        if direction >=? 0 {
            let ri=fact_difference_head(s base direction)
            loop ri >=? 0 {
                let row=s.differences[ri]
                ri=fact_difference_next(s ri direction)
                # (direction 1: base - c <= L; direction 0: c - base <= L)
                let c=if direction =? 1 {row.b} else {row.a}
                if c =? base or c =? m or found.length >? 24 {continue}
                # (the tightest d both prove, from the loosest that can still prove
                # an index or a slice, d <= 0: a failure leaves every smaller d unproved)
                let first:JoinWord=if direction =? 1 {row.limit + lo} else {row.limit - hi}
                let d:JoinWord=min(0 (if direction =? 1 {row.limit + hi} else {row.limit - lo}))
                let best:JoinWord=1
                loop d >=? first {
                    let both=if direction =? 1 {fact_distance(a lv c d) and fact_distance(b rv c d)} else {fact_distance(a c lv d) and fact_distance(b c rv d)}
                    if not both {break}
                    best=d
                    d -= 1
                }
                if best <=? 0 {
                    found.push(direction)
                    found.push(c)
                    found.push(best)
                }
            }
        }
        loop k in [0..found.length // 3) {
            let c=found[3 * k + 1]
            let d=found[3 * k + 2]
            if found[3 * k] =? 1 {fact_difference(@s m c d)} else {fact_difference(@s c m d)}
        }
    }
}
# v as a common value plus a constant: `x + 2` is [x 2], `x - 1` [x -1],
# anything else [v 0].
fj_offset=(s:FactState v:JoinWord):>[JoinWord JoinWord]=>{
    if v <=? 0 or v >=? fact_terms.length {return [v 0]}
    let t=fact_terms[v]
    if t.op not=? 'plus' and t.op not=? 'minus' or t.a =? 0 or t.b =? 0 {return [v 0]}
    let c=fact_bound(s t.b)
    if c.lo not=? c.hi or c.wide or c.lo =? FACT_MIN or c.lo =? FACT_MAX or c.lo >? 64 or c.lo <? -64 {return [v 0]}
    [t.a (if t.op =? 'plus' {c.lo} else {-c.lo})]
}
fj_join_pair_rows_fast=(@s:FactState from_:FactState peer:FactState v:JoinWord w:JoinWord m:JoinWord to_theirs_g:ptr<int32> to_theirs_v:ptr<int32> to_merged_g:ptr<int32> to_merged_v:ptr<int32> rg:int32 rcap:JoinWord pids:ptr<int64> pn_ids:JoinWord pslots:ptr<int64> pslots_n:JoinWord gterms:ptr<FactTerm> ngterms:JoinWord):>void=>$unsafe {
    loop direction in [0..2) {
        let ri=fact_difference_head(from_ v direction)
        loop ri >=? 0 {
            let row=from_.differences.ptr[ri]
            ri=fact_difference_next(from_ ri direction)
            let other=if direction =? 0 {row.a} else {row.b}
            if other =? v {continue}
            let o=fj_ren_lookup(other to_merged_g to_merged_v rg rcap @s)
            if o =? 0 {continue}
            let po=fj_ren_lookup_raw(other to_theirs_g to_theirs_v rg rcap pids pn_ids pslots pslots_n gterms ngterms)
            if po =? 0 {continue}
            if direction =? 0 and fact_distance(peer po w row.limit) {fact_difference(@s o m row.limit row.at)}
            if direction =? 1 and fact_distance(peer w po row.limit) {fact_difference(@s m o row.limit row.at)}
        }
    }
}
# An optional's tag known to be `none` (0) in s. O(1).
fact_known_none=(s:FactState v:JoinWord):>bool=>{
    let ti=fact_projection_find(s v (-3) false)
    if ti <? 0 {return false}
    let b=fact_bound(s s.projections[ti].value)
    not b.wide and b.lo =? 0 and b.hi =? 0
}
fact_known_some=(s:FactState v:JoinWord):>bool=>{
    let ti=fact_projection_find(s v (-3) false)
    if ti <? 0 {return false}
    let b=fact_bound(s s.projections[ti].value)
    not b.wide and b.lo =? 1 and b.hi =? 1
}
# A merged optional integer whose tag is not 1 on every path (`let best:int?
# = none`, then `if c best = i`): its payload exists only where the merged
# tag is 1. A fact about it that every path holding a payload proves (as a
# row, an interval, or its own tag implication) becomes an implication from
# the merged tag, applied when `is? int`, `??` or a pattern narrows it. Never
# a row: a row through a payload one path lacks would relate that path's
# other values. x in a and y in b merge into m; for a join, left/right/merged
# rename (fact_rename), for a loop header they are empty and only values
# present in s qualify. Demand: optional integer bindings that differ.
# O(B + rows and implications of the payloads), at most 32 candidates, each
# one bounded distance query per path, and 4 implications.
fact_join_payload=(@s:FactState a:FactState x:JoinWord b:FactState y:JoinWord m:JoinWord left:array<int64> right:array<int64> merged:array<int64> bound:FactBound header:bool):>void=>{
    if not s.live or s.conditional.length + 4 >? 32 {return}
    let t=fact_type(fact_terms[m].type)
    let pt=fact_summary_payload(t)
    if pt =? 0 or fact_known_some(a x) and fact_known_some(b y) {return}
    let na=not a.live or fact_known_none(a x)
    let nb=not b.live or fact_known_none(b y)
    if na and nb {return}
    let pa=if na {0} else {fact_projection_value(a x (-4))}
    let pb=if nb {0} else {fact_projection_value(b y (-4))}
    if not na and pa =? 0 or not nb and pb =? 0 {return}
    let held:JoinWord=0
    loop evidence in s.conditional {
            if evidence.tag =? -2 {held += 1}
        }
    if held >=? 12 {return}
    let tag=fact_projection_value(s m (-3))
    if tag =? 0 {
        tag=fact_new(@s FactBound(0 1) FactTerm(type=T_INT))
        fact_add_projection(@s FactProjection(m (-3) false tag))
    }
    let v=fact_projection_value(s m (-4))
    if v =? 0 {
        if na or nb {
            # (one path's payload; a loop header widens it as any changing scalar)
            let p=if na {pb} else {pa}
            let from_=if na {b} else {a}
            v=if header {fact_new(@s bound FactTerm(type=pt))} else if fact_slot(s p) >=? 0 {p} else {fact_new(@s fact_bound(from_ p) FactTerm(type=pt))}
        }
        else {
            let both=if header {bound} else {fact_hull(fact_bound(a pa) fact_bound(b pb) 0)}
            v=fact_new(@s both FactTerm(type=pt))
        }
        fact_add_projection(@s FactProjection(m (-4) false v))
    }
    let ta=fact_projection_value(a x (-3))
    let tb=fact_projection_value(b y (-3))
    # Candidates (op, operand) from the paths that hold a payload, in their frames.
    let ops:array<Tok>=[]
    let operands:array<int64>=[]
    let sides:array<int64>=[]
    loop side in [0..2) {
        if side =? 0 and na or side =? 1 and nb {continue}
        let st=if side =? 0 {a} else {b}
        let p=if side =? 0 {pa} else {pb}
        let tg=if side =? 0 {ta} else {tb}
        loop direction in [0..2) {
            let ri=fact_difference_head(st p direction)
            loop ri >=? 0 and ops.length <? 32 {
                let row=st.differences[ri]
                ri=fact_difference_next(st ri direction)
                if row.limit >? 0 {continue}
                let strict=row.limit <? 0
                if direction =? 1 {
                    let op=if strict {Tok.lt} else {Tok.le}
                    ops.push(op)
                    operands.push(row.b)
                }
                else {
                    let op=if strict {Tok.gt} else {Tok.ge}
                    ops.push(op)
                    operands.push(row.a)
                }
                sides.push(side)
            }
        }
        loop evidence in st.conditional {
            if evidence.tag not=? -2 or ops.length >=? 32 {continue}
            let r=fact_implications[evidence.base - 1]
            if r.k =? 2 and r.op0 =? 'eq' and r.a0 =? tg and r.b0 =? 1 and r.a1 =? p {ops.push(r.op1); operands.push(r.b1); sides.push(side)}
        }
        # (the lengths of the bound arrays and their fields: an index's limits;
        # the first 64 bindings, parameters and early locals)
        let scanned:JoinWord=0
        loop binding in st.bindings {
            scanned += 1
            if ops.length >=? 32 or scanned >? 64 {break}
            let pi=fact_projection_first(st binding.value)
            let depth:JoinWord=0
            loop pi >=? 0 and depth <? 8 and ops.length <? 32 {
                let q=st.projections[pi]
                pi=fact_projection_after(st pi)
                depth += 1
                if q.element {continue}
                let length=if q.selector =? -1 {q.value} else {fact_projection_value(st q.value (-1))}
                if length not=? 0 {ops.push(Tok.lt); operands.push(length); sides.push(side)}
            }
        }
    }
    let done_ops:array<Tok>=[]
    let done:array<int64>=[]
    loop i in [0..ops.length) {
        if done.length >=? 4 or held + done.length >=? 12 {break}
        let side=sides[i]
        let st=if side =? 0 {a} else {b}
        let o=operands[i]
        let target=if side =? 0 {fact_rename(o left merged [] s)} else {fact_rename(o right merged [] s)}
        if target =? 0 or target =? v {continue}
        let duplicate=false
        loop j in [0..done.length) {
            if done_ops[j] =? ops[i] and done[j] =? target {duplicate=true; break}
        }
        if duplicate {continue}
        let mine_tag=if side =? 0 {ta} else {tb}
        let mine_payload=if side =? 0 {pa} else {pb}
        if not fact_payload_holds(st mine_tag mine_payload ops[i] o) {continue}
        # (the other path: none, or it proves the same of its own payload)
        let peer_none=if side =? 0 {nb} else {na}
        if not peer_none {
            let peer=if side =? 0 {b} else {a}
            let peer_tag=if side =? 0 {tb} else {ta}
            let peer_payload=if side =? 0 {pb} else {pa}
            let po=if side =? 0 {fact_rename(o left right [] b)} else {fact_rename(o right left [] a)}
            if po =? 0 or not fact_payload_holds(peer peer_tag peer_payload ops[i] po) {continue}
        }
        fact_implication(@s [Tok.eq 0 tag 1 1] [ops[i] 0 v 0 target])
        done_ops.push(ops[i])
        done.push(target)
    }
}
# The non-element projection value of base at selector in s, or 0. O(1).
fact_projection_value=(s:FactState base:JoinWord selector:JoinWord):>JoinWord=>{
    let pi=fact_projection_find(s base selector false)
    if pi >=? 0 {s.projections[pi].value} else {0}
}
# Whether payload p (tag t) relates to o by op in s, wherever the payload
# exists: a row or the intervals, or s's own implication from its tag.
# One bounded distance query plus O(implications).
fact_payload_holds=(s:FactState t:JoinWord p:JoinWord op:Tok o:JoinWord):>bool=>{
    if op =? 'lt' and fact_entails(s p o (-1)) or op =? 'le' and fact_entails(s p o 0) {return true}
    if op =? 'gt' and fact_entails(s o p (-1)) or op =? 'ge' and fact_entails(s o p 0) {return true}
    if t =? 0 {return false}
    loop evidence in s.conditional {
        if evidence.tag not=? -2 {continue}
        let r=fact_implications[evidence.base - 1]
        if r.k =? 2 and r.op0 =? 'eq' and r.a0 =? t and r.b0 =? 1 and r.op1 =? op and r.a1 =? p and r.b1 =? o {return true}
    }
    false
}
# v renamed through the last i with from[i] == v (an index once there are many).
fact_rename=(v:JoinWord from_:array<int64> to:array<int64> index:array<int64> shared:FactState):>JoinWord=>$unsafe {
    if index.length not=? 0 {
        let value=fact_index_get(index v)
        if value >=? 0 {return value}
    }
    else {
        let i:JoinWord=JoinWord(from_.length) - 1
        loop i >=? 0 {
            if from_.ptr[i] =? v {return to.ptr[i]}
            i -= 1
        }
    }
    if fact_slot(shared v) >=? 0 {return v}
    0
}
# The first merged pair (v, other): a scan over at most 32, then indexed.
fact_pair_find=(left:array<int64> right:array<int64> index:array<int64> v:JoinWord other:JoinWord):>JoinWord=>{
    if index.length not=? 0 {return fact_index_get(index fact_pair_key(v other))}
    loop i in [0..left.length) {
        if left[i] =? v and right[i] =? other {return i}
    }
    -1
}
fact_pair_add=(left:array<int64> right:array<int64> @index:array<int64> pair:JoinWord):>void=>{
    if index.length =? 0 and left.length >=? 32 {
        index=fact_index_sized(64)
        loop i in [0..left.length) {
            let key=fact_pair_key(left[i] right[i])
            if fact_index_get(index key) <? 0 {fact_index_put(@index key i)}
        }
    }
    if index.length not=? 0 {fact_index_put(@index pair left.length)}
}
# A narrowed name's payload, `.narrow`/`.unwrap` of a variable (fact_capture's -4).
fact_payload_node=(e:JoinWord):>bool=>$unsafe {
    (nodes.ptr[e].kind =? 'narrow' or nodes.ptr[e].kind =? 'unwrap') and nodes.ptr[e].a not=? 0
}
fact_field_node=(e:JoinWord):>bool=>$unsafe {
    nodes.ptr[e].kind =? 'field' and (nodes.ptr[e].aux >=? 0 and tkind(ntype(JoinWord(nodes.ptr[e].a))) =? 'struct_' or nodes.ptr[e].aux =? -2 and tkind(ntype(JoinWord(nodes.ptr[e].a))) =? 'tuple')
}
# Branches often change only intervals and guard rows. Their storage identities
# need no phi pairs or projection matching, only the common relation facts.
fact_join_shared_rows=(@s:FactState a:FactState b:FactState):>void=>$unsafe {
    let common:JoinWord=0
    let adp=a.differences.ptr
    let bdp=b.differences.ptr
    let alen:JoinWord=a.differences.length
    let blen:JoinWord=b.differences.length
    let same_a=s.ids.length =? a.ids.length and s.ids.ptr =? a.ids.ptr
    let same_b=s.ids.length =? b.ids.length and s.ids.ptr =? b.ids.ptr
    if same_a and alen =? blen and adp =? bdp {
        s.differences=a.differences
        s.diff_a_mask=a.diff_a_mask
        s.diff_b_mask=a.diff_b_mask
        if a.index.ptr[0].difference_next.length not=? 0 {
            s.index[0].difference_index=a.index[0].difference_index
            s.index[0].difference_value=a.index[0].difference_value
            s.index[0].difference_record=a.index[0].difference_record
            s.index[0].difference_next=a.index[0].difference_next
        }
        return
    }
    let mindiff=min(alen blen)
    loop common <? mindiff {
        let row=adp[common]
        if row not=? bdp[common] or (not same_a and (fact_slot_ref(@s row.a) <? 0 or fact_slot_ref(@s row.b) <? 0)) {break}
        common += 1
    }
    if common =? alen {
        s.differences=a.differences
        s.diff_a_mask=a.diff_a_mask
        s.diff_b_mask=a.diff_b_mask
        if a.index.ptr[0].difference_next.length not=? 0 {
            s.index[0].difference_index=a.index[0].difference_index
            s.index[0].difference_value=a.index[0].difference_value
            s.index[0].difference_record=a.index[0].difference_record
            s.index[0].difference_next=a.index[0].difference_next
        }
    }
    else if common =? blen {
        s.differences=b.differences
        s.diff_a_mask=b.diff_a_mask
        s.diff_b_mask=b.diff_b_mask
        if b.index.ptr[0].difference_next.length not=? 0 {
            s.index[0].difference_index=b.index[0].difference_index
            s.index[0].difference_value=b.index[0].difference_value
            s.index[0].difference_record=b.index[0].difference_record
            s.index[0].difference_next=b.index[0].difference_next
        }
    }
    else {
        loop i in [0..common) {fact_add_difference(@s adp[i])}
    }
    loop i in [common..alen) {
        let row=adp[i]
        if (same_a or (fact_slot_ref(@s row.a) >=? 0 and fact_slot_ref(@s row.b) >=? 0)) and fact_distance(b row.a row.b row.limit) {fact_difference(@s row.a row.b row.limit row.at)}
    }
    loop i in [common..blen) {
        let row=bdp[i]
        if (same_b or (fact_slot_ref(@s row.a) >=? 0 and fact_slot_ref(@s row.b) >=? 0)) and fact_distance(a row.a row.b row.limit) {fact_difference(@s row.a row.b row.limit row.at)}
    }
}

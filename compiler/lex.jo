use 'checker_tokens.dewy'
# Lexer: source text -> tokens, with INDENT/DEDENT for indentation-based blocks.

use 'util.jo'
use 'diagnostic_exit.dewy'
use 'lexer_errors.dewy'
use 'lexer_units.dewy'
use 'lexer_line_closes.dewy'
use 'lexer_line_context.dewy'
use 'lexer_helpers.dewy'

const STRF_RAW = 1
const STRF_TRIPLE = 2
const STRF_SINGLE = 4      # in single quotes: 'a'
const INTF_CHAR = 4
const TF_SPACE = 8          # whitespace right before the token
const TF_NL = 16            # a line break before the token (also inside brackets)
const INTF_UNIT = 32        # a number with a unit suffix (already converted to the base unit)

struct Token:
    kind: Tok
    flags: i32
    pos: int        # encoded position (file + offset)
    start: i32      # byte offset of token text
    len: i32
    ival: int
    fval: f64

hash_key_pinned = __hash_key_pin(0x6A09E667F3BCC909)

keywords: {str: Tok} = {
    "struct": Tok.kw_struct, "enum": Tok.kw_enum, "if": Tok.kw_if, "else": Tok.kw_else,
    "in": Tok.kw_in, "break": Tok.kw_break,
    "continue": Tok.kw_continue, "return": Tok.kw_return, "match": Tok.kw_match, "import": Tok.kw_import,
    "as": Tok.kw_as, "const": Tok.kw_const, "true": Tok.kw_true, "false": Tok.kw_false, "none": Tok.kw_none,
    "null": Tok.kw_null, "and": Tok.kw_and, "or": Tok.kw_or, "not": Tok.kw_not, "mut": Tok.kw_mut,
    "when": Tok.kw_when, "defer": Tok.kw_defer, "extern": Tok.kw_extern, "test": Tok.kw_test,
    "build": Tok.kw_build, "use": Tok.kw_use, "pass": Tok.kw_pass,
    "loop": Tok.kw_loop, "let": Tok.kw_let, "xor": Tok.kw_xor, "is": Tok.kw_is,
}

# lexer state
lx_file = 0
lx_src = ""
lx_p: *u8 = null
lx_n = 0
lx_i = 0
lx_toks: Token[]
lx_indents: int[]
lx_tab_indent = false           # (some line is indented with a tab, and some with spaces: said in errors)
lx_space_indent = false
# contexts: one entry per open bracket or indented block inside brackets, packed as
# (source position << 24) | (payload << 1) | (1 if it is a block)
# payload: indent stack base for blocks, opening token index + 1 for brackets
# (0 for an index too large to pack; partner() retains its bounded fallback).
lx_ctx: int[]
lx_line_indent = 0
lx_lazy = false                 # (a library file: top-level function bodies become one .lazy token each)
lx_line_tok0 = 0                # the first token of the current logical line
lx_decl_lines: Tok[]            # last header at each indentation level (library declarations)

# source offset of the text being lexed (non-zero for expressions inside string literals)
lx_base = 0

# Tokens go straight into lx_toks's zeroed slots (lx_cap of them, lx_count used): only the fields
# that are not zero are written, and the array is cut to lx_count at the end.
lx_slots: *Token = null
const LX_SPARE = 8
lx_count = 0
lx_cap = 0

lx_open_tok: int[]      # token indexes of open brackets (each gets its partner's index)

# keyword kinds by interned name id (Tok.ident for other names)
kw_tok: Tok[]

# token kinds that are keywords (by Tok number)
kw_kinds: bool[]

lx_cls: *u8 = null

lx_number = ():
    p = lx_p
    s = lx_i
    i = s
    v: u64 = 0
    big = false
    if p[i] == '0' and (p[i + 1] == 'x' or p[i + 1] == 'X' or p[i + 1] == 'b' or p[i + 1] == 'B' or p[i + 1] == 'o' or p[i + 1] == 'O'):
        b = p[i + 1]
        base: u64 = 8
        if b == 'x' or b == 'X': base = 16
        if b == 'b' or b == 'B': base = 2
        i += 2
        loop true:
            c = p[i]
            d: u64 = 99
            if c == '_':
                i += 1
                continue
            if c >= '0' and c <= '9': d = u64(c - '0')
            else if c >= 'a' and c <= 'f': d = u64(c - 'a') + 10
            else if c >= 'A' and c <= 'F': d = u64(c - 'A') + 10
            if d >= base: break
            if v > (0xFFFFFFFFFFFFFFFF - d) / base: lx_err(s, "integer literal too large (more than 64 bits)")
            v = v * base + d
            i += 1
        lx_i = i
    else:
        # integers are accumulated directly; floats are re-read by to_float
        loop true:
            c = p[i]
            if c >= '0' and c <= '9':
                if v >= 1844674407370955161 and (v > 1844674407370955161 or c > '5'): big = true
                v = v * 10 + u64(c - '0')
                i += 1
            else if c == '_': i += 1
            else: break
        is_float = false
        if p[i] == '.' and p[i + 1] >= '0' and p[i + 1] <= '9':
            is_float = true
            i += 1
            loop (p[i] >= '0' and p[i] <= '9') or p[i] == '_': i += 1
        if (p[i] == 'e' or p[i] == 'E') and ((p[i + 1] >= '0' and p[i + 1] <= '9') or ((p[i + 1] == '-' or p[i + 1] == '+') and p[i + 2] >= '0' and p[i + 2] <= '9')):
            is_float = true
            i += 1
            if p[i] == '-' or p[i] == '+': i += 1
            loop p[i] >= '0' and p[i] <= '9': i += 1
        lx_i = i
        if is_float:
            if lx_cls[p[i]] & 1 != 0:
                lx_unit(s, lx_float(s, i))
                return
            fv = lx_float(s, i)
            if fv - fv != 0.0: lx_err(s, "number too large: the largest a float holds is about 1.8e308 (INF is infinity; for bigger numbers, `use big`: `big(1, 400)`)")
            lx_emit(.float_lit, s, i - s)
            lx_slots[lx_count - 1].fval = fv
            return
    if lx_cls[p[lx_i]] & 1 != 0:
        lx_unit(s, f64(v))
        return
    if is_ident_char(p[lx_i]): lx_err(lx_i, "invalid character in number literal")
    if big: lx_err(s, "integer literal too large (more than 64 bits)")
    lx_emit(.int_lit, s, lx_i - s)
    lx_slots[lx_count - 1].ival = int(v)

# value of the float literal at [s, e): short literals are exact with one operation (Clinger's
# fast path); anything else goes through the correctly rounded library parser
lx_string = (raw: bool):
    p = lx_p
    s = lx_i
    q = p[s]
    triple = q == '"' and p[s + 1] == '"' and p[s + 2] == '"'
    i = s + 1
    if triple: i = s + 3
    start = i
    depth = 0
    loop true:
        if i >= lx_n:
            if depth > 0: lx_err(s, "unterminated string: a `{{` in it starts an interpolation that does not end (for a brace in the text, write {{{{ or }}}})")
            lx_err(s, "this text has no closing quote: it starts here, and a `\"` ends it")
        c = p[i]
        if depth == 0:
            if c == '\\' and not raw:
                i += 2
                continue
            if triple:
                if c == '"' and p[i + 1] == '"' and p[i + 2] == '"': break
            else if c == q: break
            if not raw and c == '{{':
                if p[i + 1] == '{{':
                    i += 2
                    continue
                # ('{', a brace alone: there is nothing for it to interpolate; "{"a" if c...}" is
                # text inside an interpolation)
                # (p[i + 2] read once p[i + 1] is the quote, so not the 0 after the source)
                if not triple and p[i + 1] == q and i == start and not is_ident_char(p[i + 2]) and p[i + 2] != '"' and p[i + 2] != '\'':
                    i += 1
                    continue
                depth = 1
                i += 1
                continue
            i += 1
        else:
            if c == '{{': depth += 1
            else if c == '}}': depth -= 1
            else if c == '"' or c == '\'':
                i += 1
                loop i < lx_n and p[i] != c:
                    if p[i] == '\\': i += 1
                    i += 1
            i += 1
    # (print("hello) then a line on with print("round {i}"): the text runs over lines and ends
    # at the second print's quote, a letter right after it: the first line's quote is missing)
    if not triple and i + 1 < lx_n:
        nc = p[i + 1]
        if (nc >= 'a' and nc <= 'z') or (nc >= 'A' and nc <= 'Z') or nc == '_':
            k = start
            loop k < i and p[k] != '\n': k += 1
            if k < i: lx_err(s, "this text has no closing quote on its line: a `\"` ends it there (text that goes on over lines is written in triple quotes, \"\"\"...\"\"\")")
    f = 0
    if raw: f |= STRF_RAW
    if triple: f |= STRF_TRIPLE
    if q == '\'': f |= STRF_SINGLE
    k = lx_next()
    t = lx_slots
    t[k].kind = .str_lit
    t[k].flags = i32(f)
    t[k].pos = mkpos(lx_file, lx_base + s)
    t[k].start = i32(start)
    t[k].len = i32(i - start)
    if triple: lx_i = i + 3
    else: lx_i = i + 1

# (from, to: a part of src alone, as a lazy function body: tokens keep their places in src)
lex = (file: int, src: str, from: int = 0, to: int = -1) -> Token[]:
    lx_file = file
    lx_src = src
    lx_p = data(src)
    # (a nil string, the zero value, has no bytes and no 0 after them: the empty text's do)
    if lx_p == null: lx_p = data("")
    lx_n = len(src)
    if to >= 0: lx_n = to
    lx_i = from
    # (about a token per five bytes of source; in a library file the bodies are mostly skipped)
    cap = (lx_n - lx_i) / 5 + 16
    if lx_lazy and cap > 512: cap = 512
    lx_toks = []
    lx_toks.resize(cap)
    lx_slots = data(lx_toks)
    lx_count = 0
    lx_cap = cap
    lx_indents = [0]
    lx_decl_lines = []
    lx_line_tok0 = 0
    lx_tab_indent = false
    lx_space_indent = false
    lx_ctx = [(1 << 1) | 1]
    if kw_tok.len() == 0: init_keywords()
    if lx_cls == null: lx_init_classes()
    lx_line_start()
    p = lx_p
    cls = lx_cls
    kws = data(kw_tok)
    nkw = kw_tok.len()
    at = (lx_file << 40) | lx_base
    # (the scan position is local here; the helpers read and move lx_i)
    i = lx_i
    loop i < lx_n:
        c = p[i]
        if c == ' ' or c == '\t' or c == '\r':
            i += 1
            loop i < lx_n and p[i] == ' ': i += 1
            continue
        if cls[c] & 1 != 0:
            if c == 'r' and (p[i + 1] == '"' or p[i + 1] == '\''):
                lx_i = i + 1
                lx_string(true)
                i = lx_i
                continue
            s = i
            i += 1
            loop cls[p[i]] & 2 != 0: i += 1
            id = intern_sub(src, s, i - s)
            kind = Tok.ident
            if id < nkw: kind = kws[id]
            if lx_count == lx_cap: lx_grow()
            t = lx_slots
            k = lx_count
            lx_count = k + 1
            t[k].kind = kind
            t[k].pos = at + s
            t[k].start = i32(s)
            t[k].len = i32(i - s)
            t[k].ival = id
            continue
        if c == '\\' and p[i + 1] == '\n':
            i += 2
            continue
        if c == '#':
            # (#xs, Lua's length: right after an opening bracket, a comma or an operator)
            if i + 1 < lx_n and is_alpha(p[i + 1]):
                lk = lx_last_kind()
                if lk == .lparen or lk == .lbrack or lk == .comma or lk == .assign or lk == .plus or lk == .minus or lk == .star or lk == .lt or lk == .gt or lk == .eq:
                    lx_err(i, "`#` starts a comment; a length is `xs.len()` (or `len(s)`)")
            i = __find_newline(p, i, lx_n)
            continue
        lx_i = i
        if c == '\n':
            if lx_lazy and lx_ctx.len() == 1 and lx_decl_context() and lx_last_kind() == .colon and lx_decl_line():
                end = lx_body_end(lx_i + 1, lx_line_indent)
                if end > 0:
                    lx_emit_newline()
                    lx_emit(.lazy, lx_i + 1, end - (lx_i + 1))
                    lx_i = end
                    lx_line_start()
                    i = lx_i
                    continue
            lx_i += 1
            if lx_top_block(): lx_emit_newline()
            lx_line_start()
            i = lx_i
            continue
        if c >= '0' and c <= '9':
            lx_number()
            i = lx_i
            continue
        if c == '"' or c == '\'':
            lx_string(false)
            i = lx_i
            continue
        # (src's bytes end with a 0, at len(src): the byte after next, p[i + 2], is read only once
        # c1 is one of an operator's, so not that 0)
        c1 = p[i + 1]
        k = Tok.eof
        n = 1
        match c:
            '(': k = .lparen
            ')': k = .rparen
            '[': k = .lbrack
            ']': k = .rbrack
            '{{': k = .lbrace
            '}}': k = .rbrace
            ',': k = .comma
            ';': k = .semi
            '~': k = .tilde
            '@': k = .at
            ':': k = .colon
            '.':
                k = .dot
                if c1 == '.':
                    k = .dotdot
                    n = 2
                    if p[i + 2] == '.':
                        k = .ellipsis
                        n = 3
                else if c1 == '+' or c1 == '-' or c1 == '*' or c1 == '/' or c1 == '%' or c1 == '^' or c1 == '<' or c1 == '>' or (c1 == '=' and p[i + 2] == '=') or (c1 == '!' and p[i + 2] == '='):
                    # dotted (broadcasting) operator: .+ .* .== .<= ...
                    k = .dotop
                    n = 2
                    if p[i + 2] == '=' and c1 != '+' and c1 != '-' and c1 != '*' and c1 != '/' and c1 != '%' and c1 != '^': n = 3
            '-':
                k = .minus
                if c1 == '>':
                    k = .arrow
                    n = 2
                else if c1 == '=':
                    k = .minuseq
                    n = 2
            '+':
                k = .plus
                if c1 == '=':
                    k = .pluseq
                    n = 2
            '*':
                k = .star
                if c1 == '=':
                    k = .stareq
                    n = 2
                else if c1 == '*':
                    k = .starstar
                    n = 2
            '/':
                k = .slash
                if c1 == '=':
                    k = .slasheq
                    n = 2
            '%':
                k = .percent
                if c1 == '=':
                    k = .percenteq
                    n = 2
            '&':
                k = .amp
                if c1 == '=':
                    k = .ampeq
                    n = 2
            '|':
                k = .pipe
                if c1 == '=':
                    k = .pipeeq
                    n = 2
            '^':
                k = .caret
                if c1 == '=':
                    k = .careteq
                    n = 2
            '=':
                k = .assign
                if c1 == '=':
                    k = .eq
                    n = 2
            '!':
                k = .bang
                if c1 == '=':
                    k = .ne
                    n = 2
            '?':
                k = .question
                if c1 == '?':
                    k = .qq
                    n = 2
            '<':
                k = .lt
                if c1 == '<':
                    k = .shl
                    n = 2
                    if p[i + 2] == '=':
                        k = .shleq
                        n = 3
                else if c1 == '=':
                    k = .le
                    n = 2
            '>':
                k = .gt
                if c1 == '>':
                    k = .shr
                    n = 2
                    if p[i + 2] == '=':
                        k = .shreq
                        n = 3
                else if c1 == '=':
                    k = .ge
                    n = 2
            _:
                if c == '`': lx_err(lx_i, "strings are in double quotes and put values in by themselves: \"score {{n}}\" (no backticks)")
                if c == 0: lx_err(lx_i, "this is not a source file: it holds binary data (a program built from one?)")
                # ($"Score: {s}": C#'s interpolated text)
                if c == '$' and lx_i + 1 < len(lx_src) and lx_src[lx_i + 1] == '"': lx_err(lx_i, "every string can hold values: drop the `$` (`\"Score: \{s}\"`)")
                lx_err(lx_i, "unexpected character '{byte_str(int(c))}'")
        # (a lambda's indented body inside brackets ends at a comma whose line goes on to close the
        # bracket: f(():\n    a(), 5) gives f a lambda and 5; a, b = b, a alone on a line is a tuple)
        if k == .comma:
            if lx_ctx.len() > 1 and lx_top_block() and lx_line_closes(lx_i + 1): lx_close_block_ctx(lx_i)
        else if k == .rparen or k == .rbrack or k == .rbrace:
            lx_close_block_ctx(lx_i)
            if lx_ctx.len() <= 1: lx_err(lx_i, "unmatched '{byte_str(int(c))}'")
            opening = (lx_ctx[lx_ctx.len() - 1] >> 1) & 0x7FFFFF
            if opening > 0: lx_slots[opening - 1].ival = lx_count
            lx_ctx.pop()
        if lx_count == lx_cap: lx_grow()
        t = lx_slots
        tk = lx_count
        lx_count = tk + 1
        t[tk].kind = k
        t[tk].pos = at + i
        t[tk].start = i32(i)
        t[tk].len = i32(n)
        if k == .dotop: t[tk].ival = int(c1)
        lx_i = i + n
        if k == .lparen or k == .lbrack or k == .lbrace:
            opening = if tk < 0x7FFFFE: tk + 1 else: 0
            lx_ctx.push((i << 24) | (opening << 1))
        else if k == .colon and not lx_top_block():
            q = lx_i
            loop p[q] == ' ' or p[q] == '\t' or p[q] == '\r': q += 1
            if p[q] == '#':
                loop q < lx_n and p[q] != '\n': q += 1
            if p[q] == '\n':
                lx_indents.push(lx_line_indent)
                lx_ctx.push((lx_i << 24) | (lx_indents.len() << 1) | 1)
        i = lx_i
    lx_i = i
    lx_close_block_ctx(lx_i)
    if lx_ctx.len() > 1:
        lx_err(lx_ctx[lx_ctx.len() - 1] >> 24, "this bracket is never closed")
    lx_emit_newline()
    loop lx_indents.len() > 1:
        lx_indents.pop()
        lx_emit(.dedent, lx_i, 0)
    lx_emit(.eof, lx_i, 0)
    # (the parser looks up to LX_SPARE tokens ahead without bounds checks: zeroed slots after
    # the eof read as more eofs, also when the tokens fill the array exactly)
    if lx_cap - lx_count < LX_SPARE:
        lx_cap = lx_count + LX_SPARE
        lx_toks.resize(lx_cap)
    lx_toks.truncate(lx_count)
    lx_slots = null
    out = lx_toks
    lx_toks = []
    out

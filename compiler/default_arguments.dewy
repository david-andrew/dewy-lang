$runtime_checks
from p"coerce_expression.dewy" import (coerce)
from p"checker_binding_inputs.dewy" import (binding_leaves)
from p"checker_scope_symbols.dewy" import (new_sym push_scope_sym scope_mark scope_reset)
from p"ast.jo" import (clone kid kids nkids nodes)
from p"callable_checks.dewy" import (simple_arg)
from p"check.jo" import (check_scopes ctxs cx)
from p"checker_expr.dewy" import (check_expr)
from p"checker_state.dewy" import (FnCtx)
from p"checks_thin.dewy" import (push_type_params)
from p"diagnostic_exit.dewy" import (fatal)
from p"literal_context.dewy" import (finalize_literal)
from p"types.jo" import (T_VOID)
from p"node_store.dewy" import (node_d node_mod)

DefaultArgWord:type=int64<overflow='wrap'>

# a default value's names of earlier parameters (of function decl) replaced by their arguments
subst_params=(n:DefaultArgWord decl:DefaultArgWord given:array<int64>):>void=>$unsafe {
    if n =? 0 {return}
    let k=nodes.ptr[n].kind
    if k =? 'lambda' {return}
    if k =? 'ident' {
        loop j in 0.. and v in given {
            if v not=? 0 and nodes.ptr[kid(decl j)].name =? nodes.ptr[n].name {
                if not simple_arg(v) {fatal(nodes.ptr[v].pos "the default of a later parameter uses this argument, so it is computed again there: give a variable or a value (`w = make_w()` first)")}
                let copy=clone(v)
                nodes[n]=nodes[copy]
                return
            }
        }
        return
    }
    subst_params(DefaultArgWord(nodes.ptr[n].a) decl given)
    subst_params(DefaultArgWord(nodes.ptr[n].b) decl given)
    if k not=? 'for_' {
        subst_params(DefaultArgWord(nodes.ptr[n].c) decl given)
        if k not=? 'partial' {subst_params(DefaultArgWord(node_d(nodes.ptr[n].op_ext)) decl given)}
    }
    loop i in [0..nkids(n)) {subst_params(kid(n i) decl given)}
}

default_uses_params=(n:DefaultArgWord decl:DefaultArgWord before:DefaultArgWord):>bool=>$unsafe {
    if n =? 0 {return false}
    let names:array<int64>=[]
    loop i in [0..before) {names.push(int64(nodes.ptr[kid(decl i)].name))}
    default_uses_names(n names)
}

# Whether a default names one of `names` (earlier parameters or fields), outside
# the bindings it makes itself.
default_uses_names=(n:DefaultArgWord names:array<int64> hidden:array<int64>=[]):>bool=>$unsafe {
    if n =? 0 {return false}
    let k=nodes.ptr[n].kind
    if k =? 'ident' {
        let name=int64(nodes.ptr[n].name)
        return not hidden.contains(name) and names.contains(name)
    }
    if k =? 'vardecl' {return default_uses_names(DefaultArgWord(nodes.ptr[n].b) names hidden)}
    if k =? 'lambda' {
        let local_hidden=hidden
        loop i in [0..nkids(n)) {
            let param=kid(n i)
            if default_uses_names(DefaultArgWord(nodes.ptr[param].b) names local_hidden) {return true}
            local_hidden.push(int64(nodes.ptr[param].name))
        }
        return default_uses_names(DefaultArgWord(nodes.ptr[n].b) names local_hidden)
    }
    if k =? 'block' {
        let local_hidden=hidden
        loop i in [0..nkids(n)) {
            let statement=kid(n i)
            if default_uses_names(statement names local_hidden) {return true}
            if nodes.ptr[statement].kind =? 'vardecl' {
                local_hidden.push(int64(nodes.ptr[statement].name))
                loop binding in binding_leaves(kids(statement)) {local_hidden.push(int64(nodes.ptr[binding].name))}
            }
        }
        return false
    }
    if k =? 'for_' {
        if default_uses_names(DefaultArgWord(nodes.ptr[n].a) names hidden) {return true}
        let local_hidden=hidden
        loop binder in binding_leaves(kids(n)) {local_hidden.push(int64(nodes.ptr[binder].name))}
        return default_uses_names(DefaultArgWord(nodes.ptr[n].b) names local_hidden)
    }
    if k =? 'match_' {
        if default_uses_names(DefaultArgWord(nodes.ptr[n].a) names hidden) {return true}
        loop i in [0..nkids(n)) {
            let arm=kid(n i)
            let local_hidden=hidden
            loop j in [0..nkids(arm)) {
                let pattern=kid(arm j)
                if nodes.ptr[pattern].name not=? 0 {local_hidden.push(int64(nodes.ptr[pattern].name))}
            }
            if default_uses_names(DefaultArgWord(nodes.ptr[arm].b) names local_hidden) {return true}
        }
        return false
    }
    if default_uses_names(DefaultArgWord(nodes.ptr[n].a) names hidden) or default_uses_names(DefaultArgWord(nodes.ptr[n].b) names hidden) {return true}
    if default_uses_names(DefaultArgWord(nodes.ptr[n].c) names hidden) or default_uses_names(DefaultArgWord(node_d(nodes.ptr[n].op_ext)) names hidden) {return true}
    loop i in [0..nkids(n)) {
        if default_uses_names(kid(n i) names hidden) {return true}
    }
    false
}

default_arg=(decl:DefaultArgWord i:DefaultArgWord pt:DefaultArgWord given:array<int64>=[] captured:bool=false targs:array<int64>=[]):>DefaultArgWord=>$unsafe {
    let context=@cx
    let d=clone(DefaultArgWord(nodes.ptr[kid(decl i)].b))
    if given.length >? 0 and not captured {subst_params(d decl given)}
    let saved=context
    ctxs.push(FnCtx(ctxs.ptr[saved].inst (-1) int32(T_VOID) false 0 node_mod(nodes.ptr[decl].op_ext) int32(check_scopes.names.length)))
    context=DefaultArgWord(ctxs.length) - 1
    let mark=scope_mark()
    push_type_params(decl targs)
    if captured {
        loop j in 0.. and value in given {
            let param=kid(decl j)
            let name=DefaultArgWord(nodes.ptr[param].name)
            push_scope_sym(name new_sym(name 'local' DefaultArgWord(nodes.ptr[value].sym) param))
        }
    }
    check_expr(d pt);
    if pt not=? 0 {coerce(d pt);}
    else {finalize_literal(d);}
    scope_reset(mark)
    ctxs.pop();
    context=saved
    d
}

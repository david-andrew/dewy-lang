# secret<T> (docs/design/decisions.md, 2026-10-23): a value no output can show.
#
# A secret's representation is its T's (types.jo's mk_secret: layout, and quantity_base for the
# lowering, see through it), so it costs nothing at run time: the wrapper is a type the checker
# keeps apart from T. What the checker allows:
#
# - In: `secret(x)` makes one, and a T goes where a secret<T> is wanted (a declared binding,
#   field, parameter or result) by itself: wrapping hides, so it can never leak.
# - Out: only `s.reveal`, which gives the T. A secret<T> where a T is wanted is a compile error
#   with that fix; so are its other members and anything taking a T (indexing, calls).
# - Operators: comparisons (`=?`, `<?`, ...) give a plain bool, as the program asked the question;
#   arithmetic and the other binary operators give a secret of the result (`k + 1`, `a xor b`).
#   (`=?` on secrets takes time that depends on the values: constant-time comparison is later.)
# - Text: formatting writes `<redacted>` (lib/core/fmt.jo's overloads for secret[T]), so
#   printing, interpolation, records and errors holding one, and `main`'s error report (also in a
#   debug build) never show it; JSON has no writer for it, a compile error.
use 'ast.jo'
use 'types.jo'
use 'check.jo'
use 'expr.jo'
use 'lex.jo'
use 'util.jo'

secret_name = intern("secret")
secret_reveal_name = intern("reveal")

# a symbol of this kind named `secret` is a type of the program's, which `secret<T>` names
secret_type_sym = (k: SK) -> bool: k == .struct_ or k == .enum_ or k == .alias_ or k == .type_

# runtime checks (refine.jo's ref_gen_check) whose failure report shows no values: those
# checking a value on its way into a secret
secret_checks: {int: bool} = {}

secret_hide_checks = (n: int):
    let n = n
    loop nodes[n].kind == .conv:
        if nodes[n].aux == i32(int(CV.refinement)): secret_checks[n] = true
        n = int(nodes[n].a)

# The value of s (a secret) as its T: a conversion the lowering passes through.
secret_reveal = (s: int):
    t = prune(ntype(s))
    if types[t].kind != .secret: return
    wrap_conv(s, CV.none_, prune(int(types[t].elem)))

secret_wrap = (n: int, t: int) -> int:
    st = mk_secret(t)
    wrap_conv(n, CV.none_, st)
    st

# `s.reveal`, and nothing else: a secret has no other members
secret_member = (n: int, bt: int) -> int:
    a = int(nodes[n].a)
    fname = name_of(int(nodes[n].name))
    if int(nodes[n].name) != secret_reveal_name:
        what = "x"
        if nodes[a].kind == .ident: what = name_of(int(nodes[a].name))
        fatal(nodes[n].pos, "a {dt(bt)} has no member '{fname}': its value is hidden (`{what}.reveal.{fname}` uses its value, where using it is intended)")
    et = prune(int(types[bt].elem))
    nodes[n] = Node(kind = .conv, pos = nodes[n].pos, a = i32(a), aux = i32(int(CV.none_)), type = i32(et), flags = i32(NF_CHECKED))
    last_checked = n
    et

# a binary operator with a secret operand: on the values (revealed), and a comparison's bool or a
# secret of the result
secret_binary = (n: int, op: Tok, a: int, b: int) -> int:
    secret_reveal(a)
    secret_reveal(b)
    t = check_expr(n, 0)
    if op == .eq or op == .ne or op == .lt or op == .le or op == .gt or op == .ge: return t
    secret_result(n, t)

# -s, +s, ~s: a secret of the result
secret_unary = (n: int) -> int:
    secret_reveal(int(nodes[n].a))
    secret_result(n, check_expr(n, 0))

# n, an operation on values revealed (of type t), made a secret: a bool, as from a comparison
# an overload makes, is the program's answer
secret_result = (n: int, t: int) -> int:
    if t == T_BOOL or tkind(t) == .void_ or t == T_NEVER: return t
    st = secret_wrap(n, t)
    last_checked = n
    st

# n (of type from) where `to` is wanted, one of them a secret: -1 when the ordinary rules apply
# (an optional or union of secrets, a type still being inferred)
secret_coerce = (n: int, from: int, to: int) -> int:
    fk = types[from].kind
    tk = types[to].kind
    if tk == .secret:
        te = prune(int(types[to].elem))
        if fk == .var:
            unify(from, to)
            return n
        if fk == .secret:
            if type_eq(int(types[from].elem), te):
                nodes[n].type = i32(to)
                return n
            if has_var(from) and unify(from, to): return n
            secret_reveal(n)
        coerce(n, te)
        # (a literal is the secret itself, as it is its T: a constant array of them stays one)
        k = nodes[n].kind
        if k == .int_lit or k == .float_lit or k == .bool_lit or k == .str_lit:
            nodes[n].type = i32(to)
            return n
        wrap_conv(n, CV.none_, to)
        secret_hide_checks(int(nodes[n].a))
        return n
    if tk == .opt or tk == .var or tk == .param or is_union(to) or has_var(to): return -1
    if type_eq(int(types[from].elem), to) or can_coerce(0, int(types[from].elem), to):
        fatal(nodes[n].pos, "a {dt(from)} cannot be used as {dt(to)}: its value is hidden{secret_hint(n)}")
    fatal(nodes[n].pos, "type mismatch: expected {dt(to)}, found {dt(from)}{secret_hint(n)}")
    n

# the fix for a secret used as its value: n's reveal, spelled out
secret_hint = (n: int) -> str:
    what = "x"
    if nodes[n].kind == .ident: what = name_of(int(nodes[n].name))
    " (`{what}.reveal` gives its value, where using it is intended)"

# `x as secret<T>`: x's value as a secret, as `secret(x)` makes it
secret_cast = (n: int, a: int, tt: int) -> int:
    check_expr(a, int(types[tt].elem))
    v = last_checked
    coerce(v, tt)
    nodes[n] = nodes[v]
    last_checked = n
    tt

# can a value of type from go where `to` is wanted, one of them a secret? (-1: the ordinary rules)
secret_can_coerce = (n: int, from: int, to: int) -> int:
    fk = types[from].kind
    tk = types[to].kind
    if fk == .var or tk == .var: return 1
    if tk == .secret:
        fe = from
        fnode = n
        if fk == .secret:
            fe = int(types[from].elem)
            fnode = 0
        if can_coerce(fnode, fe, int(types[to].elem)): return 1
        return 0
    if tk == .opt or is_union(to): return -1
    0

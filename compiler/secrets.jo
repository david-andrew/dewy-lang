use 'secret_checks.dewy'
use 'checker_state.dewy'
use 'checker_expr.dewy'
use 'checker_tokens.dewy'
# secret<T> (docs/design/decisions.md, 2026-10-23): a value no output can show.
#
# A secret's representation is its T's (types.jo's mk_secret: layout, and quantity_base for the
# lowering, see through it), so it costs nothing at run time: the wrapper is a type the checker
# keeps apart from T. What the checker allows:
#
# - In: `secret(x)` makes one, and a T goes where a secret<T> is wanted (a declared binding,
#   field, parameter or result) by itself: wrapping hides, so it can never leak.
# - Out: only `s.reveal`, which gives the T. A secret<T> where a T is wanted is a compile error
#   with that fix; so are its other members and anything taking a T (indexing, calls).
# - Operators: equality gives a plain bool; ordering and arithmetic give a secret of the result.
#   (`=?` on secrets takes time that depends on the values: constant-time comparison is later.)
# - Text: formatting writes `<redacted>` (lib/core/fmt.jo's overloads for secret[T]), so
#   printing, interpolation, records and errors holding one, and `main`'s error report (also in a
#   debug build) never show it; JSON has no writer for it, a compile error.
use 'ast.jo'
use 'types.jo'
use 'type_ops.dewy'
use 'check.jo'
use 'expr.jo'
use 'lex.jo'
use 'util.jo'
use 'node_store.dewy'

secret_name = intern("secret")
secret_reveal_name = intern("reveal")

# Runtime checks entering a secret never show their rejected value.
secret_checks: {int: bool} = {}

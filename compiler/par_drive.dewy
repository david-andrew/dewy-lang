$runtime_checks

from p"@lib/core/rt.jo" import (__olen __str_from_bytes)
from p"@lib/core/os.jo" import (env eprint exit time)

from p"check.jo" import (target_arm64 target_wasm watch_build)
from p"driver_pipeline.dewy" import (emit_now)
from p"ir_builders.dewy" import (ir_dump_capture ir_dump_lines)
from p"ir.jo" import (ir)
from p"ir_types.dewy" import (IrFn)
from p"lower.jo" import (rodata)
from p"main.jo" import (dump repl_image)
from p"par.jo" import (ParIn emit_workers par_here par_read pr)
from p"par_ops.dewy" import (pr_ints pr_n pw pw_ints)
from p"elf_format.dewy" import (elf_syms)
from p"native_debug.dewy" import (dbg_cfi dbg_raw)
from p"pe_format.dewy" import (UW_SAVES unwind_fns uw_data)
from p"proc_sys.dewy" import (ps_close ps_fork ps_pipe ps_wait ps_write_fd)
from p"x64.jo" import (code data_fix fn_addr fn_len x64_code_align)
from p"x64_allocate.dewy" import (ra_dump)
from p"x64_emit.dewy" import (cabi_fix call_fix call_sites line_rows pad_moves ra_stat ro_const ro_new rsp_rows stub_fix)
from p"x64_module.dewy" import (cabi_adapter)

ParWord:type=int64<overflow='wrap'>
# true when the queued functions' code was made in parallel (and joined)
emit_parallel=(q:array<IrFn> fin:array<bool>):>bool=>{
    if $target.os =? 'windows' or $target.arch =? 'wasm32' {
        return false
    } else {
        if target_wasm or target_arm64 or ra_stat or watch_build or repl_image or (ra_dump as array<uint8>).length >? 0 {return false}
        let total:ParWord=0
        loop f in q {total += f.code.length}
        let n=emit_workers()
        # (each worker should have enough to make the fork worth it)
        n=min(n total // 20000)
        let forced=env("DEWY_EMIT_FORCE") not=? none
        if forced {n=max(emit_workers() 1)}
        if (n <? 2 and not forced) or q.length <? n {return false}
        # runs of consecutive functions with about the same amount of IR each
        let cuts=[0]
        let acc:ParWord=0
        loop k in 0.. and f in q {
            acc += f.code.length
            if acc * n >=? total * cuts.length and cuts.length <? n and k + 1 <? q.length {cuts.push(k + 1)}
        }
        cuts.push(q.length)
        # (forked one by one and read in order: each pipe holds what a worker writes until read)
        let r0=rodata.length
        let tm=env("DEWY_PAR_TIME") not=? none
        let ta=time()
        let pids:array<int64>=[]
        let fds:array<int64>=[]
        loop w in [0..cuts.length - 1) {
            let pfd=ps_pipe(true)
            if pfd[0] <? 0 {
                pids.push(-1)
                fds.push(-1)
                continue
            }
            let rfd=pfd[0]
            let wfd=pfd[1]
            let pid=ps_fork()
            if pid =? 0 {
                ps_close(rfd)
                if (env("DEWY_EMIT_FAIL_WORKER") ?? "") =? "{w}" {exit(1)}
                par_worker(q fin cuts[w] cuts[w + 1] r0 wfd)
            }
            ps_close(wfd)
            if pid <? 0 {
                ps_close(rfd)
                pids.push(-1)
                fds.push(-1)
            }
            else {
                pids.push(pid)
                fds.push(rfd)
            }
        }
        let tb=time()
        let tread=0.0
        let tjoin=0.0
        loop w in [0..cuts.length - 1) {
            let got:array<uint8>=[]
            let ok=fds[w] >=? 0
            if ok {
                let t_0=time()
                got=par_read(fds[w])
                tread += time() - t_0
                ps_close(fds[w])
                ok=ps_wait(pids[w]) & 0xFFFF =? 0 and got.length >=? 8
            }
            if ok {
                let t_1=time()
                par_join(got r0 q fin cuts[w])
                tjoin += time() - t_1
            }
            else {
                # (that run, here)
                loop k in [cuts[w]..cuts[w + 1]) {
                    ir=q[k]
                    emit_now(fin[k])
                }
            }
        }
        if tm {eprint("emit: {cuts.length - 1} workers, fork {(tb - ta) * 1000.0} ms, waiting and reading {tread * 1000.0} ms, joining {tjoin * 1000.0} ms, {par_here} functions again here")}
        true
    }
}
# ---- a worker: emit q[a..b), write what came of it to fd, end ----
par_worker=(q:array<IrFn> fin:array<bool> a:ParWord b:ParWord r0:ParWord fd:ParWord):>void=>{
    # Workers retain dumps per function; only the accepted emission prints at join.
    if dump {ir_dump_capture=true}
    __olen=0
    code=[]
    call_fix=[]
    data_fix=[]
    stub_fix=[]
    cabi_fix=[]
    cabi_adapter=[]
    elf_syms=[]
    line_rows=[]
    call_sites=[]
    unwind_fns=[]
    uw_data=[]
    dbg_raw=[]
    dbg_cfi=[]
    ro_new=[]
    rsp_rows=[]
    let tw0=time()
    let out:array<uint8>=[]
    pw(@out b - a)
    loop k in [a..b) {
        ir=q[k]
        # (where it starts in each table: par_join's marks)
        let at:array<int64>=[code.length call_fix.length data_fix.length stub_fix.length cabi_fix.length elf_syms.length line_rows.length call_sites.length unwind_fns.length uw_data.length dbg_raw.length dbg_cfi.length ro_new.length rsp_rows.length]
        if dump {ir_dump_lines=[]}
        emit_now(fin[k])
        if dump {
            pw(@out ir_dump_lines.length)
            loop line in ir_dump_lines {
                let raw=line as array<uint8>
                pw(@out raw.length)
                out.extend(raw)
            }
        }
        pw(@out ir.fn_index)
        pw(@out fn_addr[ir.fn_index])
        pw(@out fn_len[ir.fn_index])
        let moved:ParWord=0
        if pad_moves {moved=1}
        pw(@out moved)
        loop x in at {pw(@out x)}
    }
    let tw1=time()
    pw(@out code.length)
    out.reserve(out.length + code.length + 16 * (call_fix.length + data_fix.length + line_rows.length + call_sites.length) + 1024)
    out.extend(code)
    pw(@out call_fix.length)
    loop f in call_fix {
        pw(@out f[0])
        pw(@out f[1])
    }
    pw(@out data_fix.length)
    loop f in data_fix {
        pw(@out f[0])
        pw(@out f[1])
        pw(@out f[2])
    }
    pw(@out stub_fix.length)
    loop f in stub_fix {
        pw(@out f[0])
        pw(@out f[1])
    }
    pw(@out cabi_fix.length)
    loop f in cabi_fix {
        pw(@out f[0])
        pw(@out f[1])
    }
    pw(@out cabi_adapter.length)
    loop [k2 v] in cabi_adapter {
        pw(@out k2)
        pw(@out v)
    }
    pw(@out elf_syms.length)
    loop s in elf_syms {
        pw(@out (s[0] as array<uint8>).length)
        loop c in bytes(s[0]) {out.push(c)}
        pw(@out s[1])
        pw(@out s[2])
    }
    pw_ints(@out line_rows)
    pw_ints(@out call_sites)
    pw(@out unwind_fns.length)
    loop u in unwind_fns {
        pw(@out u[0])
        pw(@out u[1])
        pw(@out u[2])
        pw(@out u[3])
    }
    pw_ints(@out uw_data)
    pw_ints(@out dbg_raw)
    pw_ints(@out dbg_cfi)
    let news:array<int64>=[]
    loop c in ro_new {
        news.push(c[0])
        news.push(c[1])
    }
    pw_ints(@out news)
    pw_ints(@out rsp_rows)
    let tw2=time()
    if env("DEWY_PAR_TIME") not=? none {
        let report="  worker {a}..{b}: emit {(tw1 - tw0) * 1000.0} ms, pack {(tw2 - tw1) * 1000.0} ms, {out.length} bytes"
        let raw=report as array<uint8>
        pw(@out raw.length)
        out.extend(raw)
    }
    # (the compiler's own output, not yet written, is the parent's to write)
    __olen=0
    ps_write_fd(fd out out.length)
    exit(0)
}
# A run's functions are moved as one where they land as far from where the worker made them as
# a multiple of 32 (so their branch pads fall the same), or, whatever the distance, when their
# pads do not depend on where they start; a function whose pads would move is made here, where
# its place is known, and the run's next function lands elsewhere again.
par_join=(bytes_:array<uint8> r0:ParWord q:array<IrFn> fin:array<bool> a:ParWord):>void=>{
    let r=ParIn(bytes_)
    let align=x64_code_align()
    let nf:ParWord=pr(@r)
    let dumps:array<array<string>>=[]
    let fis:array<ParWord>=[]
    let ats:array<ParWord>=[]
    let lns:array<ParWord>=[]
    let moves:array<ParWord>=[]
    # per function, then once more at the run's end: where it starts in each of the 14 tables
    # (code, call_fix, data_fix, stub_fix, cabi_fix, elf_syms, line_rows, call_sites,
    # unwind_fns, uw_data, dbg_raw, dbg_cfi, constants, rsp_rows)
    let marks:array<ParWord>=[]
    loop _ in [0..nf) {
        if dump {
            let lines:array<string>=[]
            loop _ in [0..pr(@r)) {
                let n:ParWord=pr(@r)
                lines.push(__str_from_bytes(r.b[r.i..r.i + n)))
                r.i += n
            }
            dumps.push(lines)
        }
        fis.push(pr(@r))
        ats.push(pr(@r))
        lns.push(pr(@r))
        moves.push(pr(@r))
        loop _ in [0..14) {marks.push(pr(@r))}
    }
    let nc:ParWord=pr(@r)
    let c0:ParWord=r.i
    r.i += nc
    let calls=pr_n(@r 2)
    let datas=pr_n(@r 3)
    let stubs=pr_n(@r 2)
    let cabis=pr_n(@r 2)
    let adapters=pr_n(@r 2)
    let names:array<string>=[]
    let spos:array<int64>=[]
    let slen:array<int64>=[]
    loop _ in [0..pr(@r)) {
        let n:ParWord=pr(@r)
        names.push(__str_from_bytes(r.b[r.i..r.i + n)))
        r.i += n
        spos.push(pr(@r))
        slen.push(pr(@r))
    }
    let rows=pr_ints(@r)
    let sites=pr_ints(@r)
    let uws=pr_n(@r 4)
    let uwd=pr_ints(@r)
    let raw=pr_ints(@r)
    let cfi=pr_ints(@r)
    let news=pr_ints(@r)
    let frames=pr_ints(@r)
    if env("DEWY_PAR_TIME") not=? none {
        let n:ParWord=pr(@r)
        eprint(__str_from_bytes(r.b[r.i..r.i + n)))
        r.i += n
    }
    let ends:array<ParWord>=[nc calls.length // 2 datas.length // 3 stubs.length // 2 cabis.length // 2 names.length rows.length sites.length uws.length // 4 uwd.length raw.length cfi.length news.length // 2 frames.length]
    loop x in ends {marks.push(x)}
    let starts:array<ParWord>=[]
    let to:array<ParWord>=[]
    let j:ParWord=0
    loop j <? nf {
        loop code.length % align not=? 0 {code.push(0xCC)}
        let shift:ParWord=code.length - ats[j]
        let e:ParWord=j
        loop e <? nf and ((shift & 31) =? 0 or moves[e] =? 0) {e += 1}
        if e =? j {
            ir=q[a + j]
            emit_now(fin[a + j])
            par_here += 1
            loop k in [marks[14 * j + 12]..marks[14 * j + 26]) {
                starts.push(news[2 * k])
                to.push(ro_const(news[2 * k + 1]))
            }
            j += 1
            continue
        }
        let m0:ParWord=14 * j
        let m1:ParWord=14 * e
        # (constants the worker added: their places here, in the order it first used them)
        loop k in [marks[m0 + 12]..marks[m1 + 12]) {
            starts.push(news[2 * k])
            to.push(ro_const(news[2 * k + 1]))
        }
        let cs:ParWord=ats[j]
        let ce:ParWord=marks[m1]
        code.extend(r.b[c0 + cs..c0 + ce))
        loop k in [j..e) {
            if dump {loop line in dumps[k] {printl(line)}}
            let fi:ParWord=fis[k]
            loop fn_addr.length <=? fi {fn_addr.push(-1)}
            loop fn_len.length <=? fi {fn_len.push(0)}
            fn_addr[fi]=ats[k] + shift
            fn_len[fi]=lns[k]
        }
        loop k in [marks[m0 + 1]..marks[m1 + 1]) {call_fix.push([calls[2 * k] + shift calls[2 * k + 1]])}
        loop k in [marks[m0 + 2]..marks[m1 + 2]) {
            let kind:ParWord=datas[3 * k + 1]
            let off:ParWord=datas[3 * k + 2]
            if kind =? 0 and off >=? r0 {
                # (within which of the worker's constants)
                let i:ParWord=starts.length - 1
                loop i >? 0 and starts[i] >? off {i -= 1}
                if i >=? 0 and starts[i] <=? off {off=to[i] + (off - starts[i])}
            }
            data_fix.push([datas[3 * k] + shift kind off])
        }
        loop k in [marks[m0 + 3]..marks[m1 + 3]) {stub_fix.push([stubs[2 * k] + shift stubs[2 * k + 1]])}
        loop k in [marks[m0 + 4]..marks[m1 + 4]) {cabi_fix.push([cabis[2 * k] + shift cabis[2 * k + 1]])}
        loop k in [ParWord(0)..ParWord(adapters.length // 2)) {
            let p:ParWord=adapters[2 * k + 1]
            if p >=? cs and p <? ce {cabi_adapter[adapters[2 * k]]=p + shift}
        }
        let e0:ParWord=elf_syms.length - marks[m0 + 5]
        loop k in [marks[m0 + 5]..marks[m1 + 5]) {elf_syms.push([names[k] spos[k] + shift slen[k]])}
        let k:ParWord=marks[m0 + 6]
        loop k <? marks[m1 + 6] {
            line_rows.push(rows[k] + shift)
            line_rows.push(rows[k + 1])
            k += 2
        }
        k=marks[m0 + 7]
        loop k <? marks[m1 + 7] {
            call_sites.push(sites[k] + shift)
            call_sites.push(sites[k + 1])
            k += 2
        }
        let u0:ParWord=uw_data.length - marks[m0 + 9]
        loop k in [marks[m0 + 8]..marks[m1 + 8]) {
            let sz:ParWord=uws[4 * k + 3]
            if uws[4 * k + 2] =? UW_SAVES {sz += u0}
            unwind_fns.push([uws[4 * k] + shift uws[4 * k + 1] + shift uws[4 * k + 2] sz])
        }
        loop k in [marks[m0 + 9]..marks[m1 + 9]) {uw_data.push(uwd[k])}
        # dbg_raw: per function its symbol, start, length, frame, count; per variable 6 numbers (lo, hi: code)
        k=marks[m0 + 10]
        loop k <? marks[m1 + 10] {
            dbg_raw.push(raw[k] + e0)
            dbg_raw.push(raw[k + 1] + shift)
            dbg_raw.push(raw[k + 2])
            dbg_raw.push(raw[k + 3])
            let cnt:ParWord=raw[k + 4]
            dbg_raw.push(cnt)
            k += 5
            loop _ in [0..cnt) {
                dbg_raw.push(raw[k])
                dbg_raw.push(raw[k + 1])
                dbg_raw.push(raw[k + 2])
                dbg_raw.push(raw[k + 3])
                dbg_raw.push(raw[k + 4] + shift)
                dbg_raw.push(raw[k + 5] + shift)
                k += 6
            }
        }
        # dbg_cfi: per function its start (code), length, body, then the saved registers and epilogues
        k=marks[m0 + 11]
        loop k <? marks[m1 + 11] {
            dbg_cfi.push(cfi[k] + shift)
            dbg_cfi.push(cfi[k + 1])
            dbg_cfi.push(cfi[k + 2])
            let ns:ParWord=cfi[k + 3]
            dbg_cfi.push(ns)
            k += 4
            loop _ in [0..2 * ns) {
                dbg_cfi.push(cfi[k])
                k += 1
            }
            let ne:ParWord=cfi[k]
            dbg_cfi.push(ne)
            k += 1
            loop _ in [0..ne) {
                dbg_cfi.push(cfi[k])
                k += 1
            }
        }
        k=marks[m0 + 13]
        loop k <? marks[m1 + 13] {
            rsp_rows.push(frames[k] + shift)
            rsp_rows.push(frames[k + 1])
            k += 2
        }
        j=e
    }
}

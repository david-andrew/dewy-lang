$runtime_checks
from p"expression_types.dewy" import (ntype)
from p"dewy_method_ops.dewy" import (dewy_is_method)
from p"call_lookup_context.dewy" import (program_fn_named)
from p"@lib/core/str.jo" import (is_digit starts_with)
from p"ast.jo" import (NF_LITERAL has_flag kid nkids nodes)
from p"check.jo" import (ctxs cx fns globals modules)
from p"diagnostic_exit.dewy" import (fatal)
from p"expr.jo" import (DRAWING_FNS back_to_screen draw_to_at drew_in)
from p"call_argument_checks.dewy" import (unnamed)
from p"literal_context.dewy" import (is_lit)
from p"source_warnings.dewy" import (warn)
from p"type_ops.dewy" import (dt)
from p"types.jo" import (T_VEC4 prune type_eq)
from p"util.jo" import (files intern name_of pos_file pos_off)

GameCheckWord:type=int64<overflow='wrap'>
# draw(prog, quad, Other(...)) where prog = make_shader(shader(vs, fs)) takes U: a Shader does not
# carry its uniforms' type, so the one its functions take is found where the global is made
shader_draw_check=(decl:GameCheckWord args:array<int64>):>void=>$unsafe {
    let fnm=name_of(GameCheckWord(nodes.ptr[decl].name))
    if fnm not=? "draw" and not starts_with(fnm "draw_instanced") and not starts_with(fnm "draw_indirect") {return}
    if args.length <? 3 or args[0] =? 0 {return}
    let a0=unnamed(args[0])
    if nodes.ptr[a0].kind not=? 'ident' or nodes.ptr[a0].aux not=? int32(2) or nodes.ptr[a0].type =? 0 or dt(ntype(a0)) not=? "Shader" {return}
    let g=GameCheckWord(nodes.ptr[a0].sym)
    if g <=? 0 or globals.ptr[g].decl =? 0 {return}
    let ut=shader_uniforms_in(GameCheckWord(nodes.ptr[GameCheckWord(globals.ptr[g].decl)].b))
    if ut =? 0 {return}
    let params=nkids(decl)
    let count:GameCheckWord=if params <? args.length {params} else {args.length}
    loop i in [0..count) {
        if name_of(GameCheckWord(nodes.ptr[kid(decl i)].name)) not=? "params" or args[i] =? 0 {continue}
        let a=unnamed(args[i])
        if nodes.ptr[a].type =? 0 or type_eq(prune(ntype(a)) prune(ut)) {return}
        let gn=name_of(GameCheckWord(globals.ptr[g].name))
        fatal(nodes.ptr[a].pos "{gn}'s shader functions take {dt(ut)} as their uniforms, and this is {dt(ntype(a))}: give it a {dt(ut)}");
    }
}
# the uniforms type of the shader functions named in e (make_shader(shader(vs, fs))), or 0
shader_uniforms_in=(e:GameCheckWord):>GameCheckWord=>$unsafe {
    if e =? 0 {return 0}
    if nodes.ptr[e].kind =? 'fnref' {
        let f=GameCheckWord(nodes.ptr[e].sym)
        if f >? 0 and fns.ptr[f].ptypes.length =? 2 and type_eq(GameCheckWord(fns.ptr[f].ret) T_VEC4) {return fns.ptr[f].ptypes[1]}
        return 0
    }
    if nodes.ptr[e].kind =? 'lambda' or nodes.ptr[e].kind =? 'fn_' {return 0}
    let r=shader_uniforms_in(GameCheckWord(nodes.ptr[e].a))
    if r not=? 0 {return r}
    loop i in [0..nkids(e)) {
        r=shader_uniforms_in(kid(e i))
        if r not=? 0 {return r}
    }
    0
}
# rotation_y(45): an angle in degrees given where radians go
angle_check=(decl:GameCheckWord args:array<int64>):>void=>$unsafe {
    let params=nkids(decl)
    let count:GameCheckWord=if params <? args.length {params} else {args.length}
    loop i in [0..count) {
        let a=args[i]
        if a =? 0 or not has_flag(a NF_LITERAL) {continue}
        let k=nodes.ptr[a].kind
        let v:float64=0.0
        if k =? 'int_lit' {v=float64(nodes.ptr[a].ival)}
        else if k =? 'float_lit' {v=nodes.ptr[a].fval}
        else {continue}
        if abs(v) <=? 6.3 {continue}
        let pn=name_of(GameCheckWord(nodes.ptr[kid(decl i)].name))
        let match_param=pn =? "angle" or pn =? "yaw" or pn =? "pitch" or pn =? "roll"
        if not match_param and pn =? "a" {
            let fnm=name_of(GameCheckWord(nodes.ptr[decl].name))
            match_param=starts_with(fnm "rotation") or starts_with(fnm "quat_")
        }
        if match_param {
            let txt=if k =? 'int_lit' {"{nodes.ptr[a].ival}"} else {"{v}"}
            warn(nodes.ptr[a].pos "{txt} radians is more than a whole turn: angles are in radians (a turn is TAU, 6.28); `{txt}deg` is {txt} degrees")
        }
    }
}
# (the value of an argument written as a whole number alone, 6 and not 6.0 or 5 + 1, even where
# it became a float; -1 for anything else: 5 + 1 says the number is meant)
written_int=(a:GameCheckWord):>GameCheckWord=>$unsafe {
    if a =? 0 or not is_lit(a) {return -1}
    if nodes.ptr[a].kind not=? 'int_lit' and nodes.ptr[a].kind not=? 'float_lit' {return -1}
    let f=pos_file(nodes.ptr[a].pos)
    if f <? 0 or f >=? files.length {return -1}
    let src=files[f].src as array<uint8>
    let o:GameCheckWord=pos_off(nodes.ptr[a].pos)
    if o >=? src.length or not is_digit(src[o]) {return -1}
    loop o <? src.length and is_digit(src[o]) {o += 1}
    loop o <? src.length and src[o] =? b' ' {o += 1}
    if o >=? src.length or (src[o] not=? b')' and src[o] not=? b',') {return -1}
    if nodes.ptr[a].kind =? 'int_lit' {return nodes.ptr[a].ival}
    int64(nodes.ptr[a].fval)
}

# a library function called as another language's of the same name is (p5's line(x1, y1, x2,
# y2), fill(r, g, b) and push(); atan(y, x)): what it is here, before its overloads are tried
# checker_call_queries.dewy's habit_call_check leaves the host the names and argument
# counts a habit may have.
habit_rest=(n:int64 name:int64 args:array<int64>):>void=>{
    let nm=name_of(name)
    if program_fn_named(name) {return}
    let na=args.length
    let pos=nodes[n].pos
    if nm =? "line" and na >=? 4 and habit_number(args[0]) and habit_number(args[1]) {fatal(pos "line takes two points: `line(vec2(x1, y1), vec2(x2, y2), width, color)`")}
    if nm =? "text" and na >=? 3 and habit_number(args[1]) and habit_number(args[2]) {fatal(pos "where text goes is one vec2: `text(s, vec2(x, y), size, color)`")}
    if nm =? "clear" and na =? 1 and nodes[unnamed(args[0])].kind =? 'tuple' {fatal(pos "clear takes a color: `clear(rgb(0.1, 0.1, 0.1))` (each from 0 to 1)")}
    if nm =? "fill" and na >=? 3 and habit_number(args[0]) and habit_number(args[1]) and habit_number(args[2]) {fatal(pos "there is no fill color: each shape takes its color, `circle(pos, r, rgb(1, 0, 0))` (fill(x, n) makes an array of n copies of x)")}
    if nm =? "push" and na =? 0 {fatal(pos "push() here is push_transform() (and pop() is pop_transform()); xs.push(x) adds to an array")}
    if nm =? "pop" and na =? 0 {fatal(pos "pop() here is pop_transform(), after push_transform(); xs.pop() takes from an array")}
    if nm =? "map" and na =? 5 {fatal(pos "the range a..b moved to c..d is `remap(x, a, b, c, d)`; map(xs, f) is f of each element")}
    if nm =? "atan" and na =? 2 {fatal(pos "the angle of (x, y) is `atan2(y, x)`; atan takes one number")}
    if nm =? "random" and na =? 1 {
        if nodes[unnamed(args[0])].kind =? 'array' {fatal(pos "a random element is `random_item(xs)`")}
        if habit_number(args[0]) {fatal(pos "random takes where it starts and ends: `random(0, 10)` (a whole number: `random_int(0, 10)`)")}
    }
}

habit_number=(a:GameCheckWord):>bool=>{
    let e=unnamed(a)
    let k=nodes[e].kind
    if k =? 'int_lit' or k =? 'float_lit' {return true}
    if k not=? 'unary' {return false}
    let inner=nodes[GameCheckWord(nodes[e].a)].kind
    inner =? 'int_lit' or inner =? 'float_lit'
}

# drawing in update, clearing after drawing, sleeping in a frame: done where it shows nothing,
# covers what was drawn, or stops the game
frame_call_check=(n:GameCheckWord decl:GameCheckWord):>void=>$unsafe {
    if cx <? 0 {return}
    let ci=GameCheckWord(ctxs.ptr[cx].inst)
    if ci <=? 0 or fns.ptr[ci].decl =? 0 {return}
    let fd=GameCheckWord(fns.ptr[ci].decl)
    let mm=GameCheckWord(nodes.ptr[fd].mod)
    if not modules.ptr[mm].is_main {return}
    let here=if dewy_is_method(fd) {""} else {name_of(GameCheckWord(nodes.ptr[fd].name))}
    let fnm=name_of(GameCheckWord(nodes.ptr[decl].name))
    if DRAWING_FNS.contains(fnm) {
        if here =? "update" {
            if modules.ptr[mm].names.has(intern("draw")) {warn(nodes.ptr[n].pos "{fnm} draws, and update is for changing things: what it draws here is covered when draw clears the screen; draw it in `draw`")}
            else {warn(nodes.ptr[n].pos "{fnm} draws, and update is for changing things: drawing goes in a function of its own, `draw = ():`, which the game calls each frame after update")}
        }
        drew_in[ci]=true
    }
    if fnm =? "draw_to" or fnm =? "draw_to_screen" or starts_with(fnm "begin_") or fnm =? "camera3d" {drew_in.remove(ci);}
    if here =? "draw" and fnm =? "draw_to" and not draw_to_at.has(ci) {draw_to_at[ci]=nodes.ptr[n].pos}
    if here =? "draw" and fnm =? "draw_to_screen" {back_to_screen[ci]=true}
    if fnm =? "clear" and drew_in.has(ci) and here =? "draw" {warn(nodes.ptr[n].pos "clear covers everything drawn before it in this frame: clear the screen first, at the top of draw")}
    if (fnm =? "input" or fnm =? "input_int" or fnm =? "input_float" or fnm =? "read_line" and nkids(decl) =? 0) and (here =? "update" or here =? "draw") {
        warn(nodes.ptr[n].pos "{fnm} waits for a line typed in the terminal, and the game stops while it waits: in the window, `hud_text_field(rect, name)` is a box to type in (or `text_input()`, what was typed this frame)")
    }
    if fnm =? "sleep" and (here =? "update" or here =? "draw") {warn(nodes.ptr[n].pos "sleep stops the whole game, every frame: to wait, count down a timer (`wait -= dt`, act when it is below 0), or `every(1, 2.0)`")}
}

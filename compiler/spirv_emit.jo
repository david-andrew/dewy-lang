use 'spirv.jo'
use 'checker_state.dewy'
use 'checker_tokens.dewy'
use 'util.jo'
use 'lex.jo'
use 'ast.jo'
use 'types.jo'
use 'type_ops.dewy'
use 'check.jo'
use 'checks_assign_hooks.dewy'
use 'expr.jo'
use 'checks_thin_expr.dewy'
use 'glsl.jo'
use 'glsl_ops.dewy'
use 'spirv_ops.dewy'

# the words of a string operand: its bytes and a terminating 0, padded to a whole word
sv_strw = (s: str) -> int[]:
    w: int[]
    n = len(s)
    loop i in [0..n / 4 + 1):
        x = 0
        loop j in [0..4):
            k = i * 4 + j
            if k < n: x = x | (int(s[k]) << (8 * j))
        w.push(x)
    w
# an instruction with a result: returns its id
sv_val = (op: int, ty: int, args: int[]) -> int:
    id = sv_new()
    a: int[] = [ty, id]
    loop x in args: a.push(x)
    sv_code(op, a)
    id
# end the block with a branch (unless it has ended); returns whether it branched
sv_branch = (target: int) -> bool:
    if sv_dead: return false
    sv_ins(sv_body, 249, [target])
    sv_dead = true
    true
# ---------------- types and constants ----------------
sv_type_key = (key: str, op: int, args: int[]) -> int:
    if let id = sv_cache.get(key): return id
    id = sv_new()
    a: int[] = [id]
    loop x in args: a.push(x)
    sv_ins(sv_glob, op, a)
    sv_cache[key] = id
    id
sv_fntype = (ret: int, params: int[]) -> int:
    key = "fn{ret}"
    loop p in params: key += ",{p}"
    a: int[] = [ret]
    loop p in params: a.push(p)
    sv_type_key(key, 33, a)
sv_const = (ty: int, bits: int) -> int:
    key = "c{ty}:{bits}"
    if let id = sv_cache.get(key): return id
    id = sv_new()
    sv_ins(sv_glob, 43, [ty, id, bits])
    sv_cache[key] = id
    id
sv_cbool = (b: bool) -> int:
    key = "false"
    op = 42
    if b:
        key = "true"
        op = 41
    if let id = sv_cache.get(key): return id
    id = sv_new()
    sv_ins(sv_glob, op, [sv_bool(), id])
    sv_cache[key] = id
    id
# the zero value of a type
sv_null = (ty: int) -> int:
    key = "null{ty}"
    if let id = sv_cache.get(key): return id
    id = sv_new()
    sv_ins(sv_glob, 46, [ty, id])
    sv_cache[key] = id
    id
sv_global = (ptrty: int, sc: int) -> int:
    id = sv_new()
    sv_ins(sv_glob, 59, [ptrty, id, sc])
    sv_iface.push(id)
    id
# ---------------- the interface ----------------
# a buffer read as 32-bit words, and an address of one
sv_rawptr = () -> int:
    if let id = sv_cache.get("rawptr"): return id
    u = sv_u32()
    rt = sv_type_key("rawrt", 29, [u])
    sv_deco(rt, 6, [4])
    st = sv_type_key("rawst", 30, [rt])
    sv_deco(st, 2, [])
    sv_mdeco(st, 0, 35, [0])
    sv_mdeco(st, 0, 24, [])
    p = sv_ptr(SC_PSB, st)
    sv_cache["rawptr"] = p
    p
sv_pc_var = () -> int:
    if sv_pc != 0: return sv_pc
    ms = sv_pc_types()
    st = sv_type_key("pcst", 30, ms)
    sv_deco(st, 2, [])
    offs = [0, 8, 16, 24, 28, 32, 36]
    loop i in [0..ms.len()): sv_mdeco(st, i, 35, [offs[i]])
    sv_pc = sv_global(sv_ptr(SC_PUSH, st), SC_PUSH)
    sv_pc
# the texture with index t (a u32), as a sampled image
sv_texture = (t: int) -> int:
    si = sv_sampled_type()
    if sv_textures == 0:
        arr = sv_type_key("texarr", 29, [si])
        sv_textures = sv_global(sv_ptr(SC_UCONST, arr), SC_UCONST)
        sv_deco(sv_textures, 34, [0])
        sv_deco(sv_textures, 33, [0])
    i = sv_val(83, sv_u32(), [t])
    sv_deco(i, 5300, [])
    p = sv_val(65, sv_ptr(SC_UCONST, si), [sv_textures, i])
    sv_deco(p, 5300, [])
    v = sv_load(si, p)
    sv_deco(v, 5300, [])
    v
# ---------------- reading the uniforms (and vertices) from memory ----------------
# the word at byte offset (c + d) of base (c + d is a multiple of 4)
sv_word = (base: int, c: int, d: int) -> int:
    idx = sv_ci(c >> 2)
    if d != 0:
        off = d
        if c != 0: off = sv_val(128, sv_i32(), [d, sv_ci(c)])
        idx = sv_val(195, sv_i32(), [off, sv_ci(2)])
    p = sv_val(65, sv_ptr(SC_PSB, sv_u32()), [base, sv_ci(0), idx])
    id = sv_new()
    sv_code(61, [sv_u32(), id, p, 2, 4])
    id
# bits [bit, bit + count) of the 32-bit-aligned word holding byte offset (c + d), as an i32
sv_subword = (base: int, c: int, d: int, count: int, signed: bool) -> int:
    w = 0
    shift = 0
    if d == 0:
        w = sv_word(base, c & -4, 0)
        shift = sv_ci((c & 3) * 8)
    else:
        off = d
        if c != 0: off = sv_val(128, sv_i32(), [d, sv_ci(c)])
        w = sv_word(base, 0, sv_val(199, sv_i32(), [off, sv_ci(-4)]))
        shift = sv_val(132, sv_i32(), [sv_val(199, sv_i32(), [off, sv_ci(3)]), sv_ci(8)])
    wi = sv_val(124, sv_i32(), [w])
    op = 203
    if signed: op = 202
    sv_val(op, sv_i32(), [wi, shift, sv_ci(count)])
sv_field_offset = (si: int, name: str) -> int:
    loop i in [0..int(structs[si].nfields)):
        f = int(structs[si].fields) + i
        if name_of(int(fields[f].name)) == name: return int(fields[f].offset)
    0
# ---------------- functions ----------------
sv_fn_id = (f: int) -> int:
    if let id = sv_fn_ids.get(f): return id
    id = sv_new()
    sv_fn_ids[f] = id
    sv_pending.push(f)
    id
sv_param_type = (l: int) -> int:
    t = int(locals[l].type)
    if prune(t) == sv_utype: return sv_rawptr()
    ty = sv_type(t, locals[l].pos)
    if int(locals[l].flags) & LF_MUTPARAM != 0: return sv_ptr(SC_FUNCTION, ty)
    ty
# the function's words: header and parameters, then its first block with the variables first
sv_finish_fn = (head: int[]):
    loop w in head: sv_fns.push(w)
    # (the body starts with the first block's label: the variables go right after it)
    loop i in [0..2): sv_fns.push(sv_body[i])
    loop w in sv_vars: sv_fns.push(w)
    loop i in [2..sv_body.len()): sv_fns.push(sv_body[i])
    sv_ins(sv_fns, 56, [])
sv_start_fn = ():
    sv_body = []
    sv_vars = []
    sv_loops = []
    sv_lvar = {}
    sv_lref = {}
    sv_dead = false
    sv_begin(sv_new())
# a loop's header (where the loop is declared) and the blocks it needs: (header, body, continue,
# merge). The header branches to a block of its own, where the condition is computed.
sv_loop_start = () -> (int, int, int, int):
    header = sv_new()
    body = sv_new()
    cont = sv_new()
    merge = sv_new()
    cond = sv_new()
    sv_branch(header)
    sv_begin(header)
    sv_code(246, [merge, cont, 0])
    sv_branch(cond)
    sv_begin(cond)
    (header, body, cont, merge)
# the body, then the continue block (the caller adds what it does, and the branch back)
sv_loop_body = (b: int, merge: int, cont: int):
    sv_loops.push((merge, cont))
    sv_stmts(b)
    sv_loops.pop()
    sv_branch(cont)
    sv_begin(cont)
# a << b, a >> b as on the CPU, where values shift in 64 bits by the count's low 6 bits: by 32
# or more, nothing is left (or the sign, shifting a signed value right)
sv_shift = (code: int, ty: int, a: int, b: int, rt: int) -> int:
    if sv_is_vector(rt): return sv_val(code, ty, [a, b])
    i = sv_i32()
    c = sv_val(199, i, [b, sv_ci(63)])
    r = sv_val(code, ty, [a, sv_val(199, i, [c, sv_ci(31)])])
    far = sv_ci(0)
    if code == 195: far = sv_val(195, ty, [a, sv_ci(31)])
    sv_val(169, ty, [sv_val(175, sv_bool(), [c, sv_ci(32)]), far, r])
# v (32 bits) wrapped to the range of a narrower integer type t, as on the CPU
sv_narrow = (v: int, t0: int) -> int:
    t = sl_type(t0)
    if types[t].kind != .int_: return v
    bits = int(types[t].bits)
    if bits >= 32: return v
    if not types[t].sign: return sv_val(199, sv_i32(), [v, sv_ci((1 << bits) - 1)])
    sh = sv_ci(32 - bits)
    sv_val(195, sv_i32(), [sv_val(196, sv_i32(), [v, sh]), sh])
# a and b, a or b: b is computed only when it decides
sv_logic = (e: int, is_and: bool) -> int:
    bo = sv_bool()
    x = sv_expr(int(nodes[e].a))
    from_ = sv_label
    rhs = sv_new()
    merge = sv_new()
    sv_code(247, [merge, 0])
    if is_and: sv_cond_branch(x, rhs, merge)
    else: sv_cond_branch(x, merge, rhs)
    sv_begin(rhs)
    y = sv_expr(int(nodes[e].b))
    rhs_end = sv_label
    sv_branch(merge)
    sv_begin(merge)
    sv_val(245, bo, [x, from_, y, rhs_end])
sv_intrinsic = (e: int) -> int:
    id = nodes[e].aux as IN
    t = sl_type(ntype(e))
    pos = nodes[e].pos
    ty = sv_type(t, pos)
    if id == .vec_ctor: return sv_vec_ctor(e)
    if id == .sqrt: return sv_val(12, ty, [sv_std, 31, sv_expr(kid(e, 0))])
    if id == .floor_: return sv_val(12, ty, [sv_std, 8, sv_expr(kid(e, 0))])
    if id == .ceil_: return sv_val(12, ty, [sv_std, 9, sv_expr(kid(e, 0))])
    if id == .fabs: return sv_val(12, ty, [sv_std, 4, sv_expr(kid(e, 0))])
    if id == .fmin: return sv_minmax(t, sv_expr(kid(e, 0)), sv_expr(kid(e, 1)), true, pos)
    if id == .fmax: return sv_minmax(t, sv_expr(kid(e, 0)), sv_expr(kid(e, 1)), false, pos)
    sv_err(pos, "this operation is not available in shaders")
    0
# b[i]: where the element is
sv_gbuf_elem = (e: int) -> SvRef:
    i32_ = sv_i32()
    b = sv_expr(kid(e, 0))
    i = sv_expr(kid(e, 1))
    hi = sv_val(12, i32_, [sv_std, 42, sv_val(130, i32_, [sv_gbuf_len(b), sv_ci(1)]), sv_ci(0)])
    i = sv_val(12, i32_, [sv_std, 45, i, sv_ci(0), hi])
    et = gpu_buffer_elem(ntype(kid(e, 0)))
    layout(et)
    SvRef(sv_gbuf_ptr(b), 0, sv_val(132, i32_, [i, sv_ci(tsize(et))]), et)
# the block that runs only when index i is inside buffer b: (the block left, the merge block)
sv_gbuf_inside = (b: int, i: int) -> (int, int):
    u = sv_u32()
    inside = sv_val(176, sv_bool(), [sv_val(124, u, [i]), sv_val(124, u, [sv_gbuf_len(b)])])
    from_ = sv_label
    then = sv_new()
    merge = sv_new()
    sv_code(247, [merge, 0])
    sv_cond_branch(inside, then, merge)
    sv_begin(then)
    (from_, merge)
# b[i] = v
sv_gbuf_store = (e: int):
    pos = nodes[e].pos
    if sv_stage != "compute": sv_err(pos, "GPU buffers are written by compute programs only")
    bt = ntype(kid(e, 0))
    b = sv_expr(kid(e, 0))
    i = sv_expr(kid(e, 1))
    v = sv_expr(kid(e, 2))
    et = gpu_buffer_elem(bt)
    layout(et)
    _, merge = sv_gbuf_inside(b, i)
    sv_write(et, sv_gbuf_ptr(b), 0, sv_val(132, sv_i32(), [i, sv_ci(tsize(et))]), v, pos)
    sv_branch(merge)
    sv_begin(merge)
# a pointer to the word at byte offset (c + d) of buffer memory base
sv_word_ptr = (base: int, c: int, d: int) -> int:
    idx = sv_ci(c >> 2)
    if d != 0:
        off = d
        if c != 0: off = sv_val(128, sv_i32(), [d, sv_ci(c)])
        idx = sv_val(195, sv_i32(), [off, sv_ci(2)])
    sv_val(65, sv_ptr(SC_PSB, sv_u32()), [base, sv_ci(0), idx])
# the low `bits` bits of v (an i32) to bits [8 * ((c + d) & 3), ...) of their word: cleared, then
# set, each atomically, so that the bytes beside them, which other invocations may write, stay
sv_store_sub = (base: int, c: int, d: int, bits: int, v: int):
    u = sv_u32()
    p = 0
    shift = 0
    if d == 0:
        p = sv_word_ptr(base, c & -4, 0)
        shift = sv_cu((c & 3) * 8)
    else:
        off = d
        if c != 0: off = sv_val(128, sv_i32(), [d, sv_ci(c)])
        p = sv_word_ptr(base, 0, sv_val(199, sv_i32(), [off, sv_ci(-4)]))
        shift = sv_val(124, u, [sv_val(132, sv_i32(), [sv_val(199, sv_i32(), [off, sv_ci(3)]), sv_ci(8)])])
    ones = sv_cu((1 << bits) - 1)
    mask = sv_val(196, u, [ones, shift])
    val = sv_val(196, u, [sv_val(199, u, [sv_val(124, u, [v]), ones]), shift])
    sv_val(240, u, [p, sv_cu(1), sv_cu(0), sv_val(200, u, [mask])])
    sv_val(241, u, [p, sv_cu(1), sv_cu(0), val])
sv_subgroup_builtin = (b: int) -> int:
    key = "sgb{b}"
    if let v = sv_cache.get(key): return sv_val(124, sv_i32(), [sv_load(sv_u32(), v)])
    v = sv_builtin_var(sv_u32(), SC_INPUT, b)
    sv_cache[key] = v
    sv_val(124, sv_i32(), [sv_load(sv_u32(), v)])
# ---------------- the stages ----------------
sv_reset = (stage: str):
    sv_bound = 0
    sv_caps = []
    sv_dec = []
    sv_glob = []
    sv_fns = []
    sv_cache = {}
    sv_iface = []
    sv_fn_ids = {}
    sv_pending = []
    sv_pc = 0
    sv_textures = 0
    sv_vid = 0
    sv_iid = 0
    sv_stage = stage
    sv_group = [SV_KERNEL_GROUP, 1, 1]
    sv_std = sv_new()
    # Shader, ImageQuery, ShaderNonUniform, RuntimeDescriptorArray,
    # SampledImageArrayNonUniformIndexing, PhysicalStorageBufferAddresses
    loop c in [1, 50, 5301, 5302, 5307, 5347]: sv_ins(sv_caps, 17, [c])
# translate everything called (functions can call more functions)
sv_drain = ():
    loop sv_pending.len() > 0:
        f = sv_pending.pop()
        if sv_fn_ids.get(f) != none and sv_translated.get(f) == none:
            sv_translated[f] = true
            sv_function(f)
# the parts of a struct passed between the stages, each a variable at its own location: (the
# path of field indices to it, its type)
sv_leaves = (t0: int, path: int[], out: mut (int[], int)[]):
    t = sl_type(t0)
    if types[t].kind == .struct_ and not is_lib_texture(int(types[t].st)):
        si = int(types[t].st)
        check_struct_fields(si)
        loop i in [0..int(structs[si].nfields)):
            p: int[]
            loop x in path: p.push(x)
            p.push(i)
            sv_leaves(int(fields[int(structs[si].fields) + i].type), p, out)
        return
    out.push((path, t))
# the locations a value of type t takes
sv_slots = (t0: int) -> int:
    t = sl_type(t0)
    if t == T_MAT4: return 4
    if types[t].kind == .fixed: return fixed_len(t) * sv_slots(int(types[t].elem))
    1
# the varyings: one variable per part of the vertex function's result after the first (the
# clip position), at consecutive locations; integers are not interpolated
sv_varyings = (otype: int, sc: int, pos: int) -> ((int[], int)[], int[]):
    si = int(types[prune(otype)].st)
    check_struct_fields(si)
    leaves: (int[], int)[]
    loop i in [1..int(structs[si].nfields)): sv_leaves(int(fields[int(structs[si].fields) + i].type), [i], leaves)
    vars: int[]
    loc = 0
    loop lf in leaves:
        if types[prune(lf.1)].kind == .bool_: sv_err(pos, "bools cannot be passed from the vertex to the fragment shader (use an int)")
        v = sv_global(sv_ptr(sc, sv_type(lf.1, pos)), sc)
        sv_deco(v, 30, [loc])
        if sv_is_int_leaf(lf.1) and sc == SC_INPUT: sv_deco(v, 14, [])
        loc += sv_slots(lf.1)
        vars.push(v)
    (leaves, vars)
# the value of type t (a part of the varyings struct at path) rebuilt from the leaf values
sv_rebuild = (t0: int, path: int[], leaves: (int[], int)[], vals: int[], pos: int) -> int:
    t = sl_type(t0)
    loop i in 0.. and lf in leaves:
        if lf.0.len() == path.len():
            same = true
            loop j in [0..path.len()):
                if lf.0[j] != path[j]: same = false
            if same: return vals[i]
    si = int(types[t].st)
    parts: int[]
    loop i in [0..int(structs[si].nfields)):
        p: int[]
        loop x in path: p.push(x)
        p.push(i)
        parts.push(sv_rebuild(int(fields[int(structs[si].fields) + i].type), p, leaves, vals, pos))
    sv_val(80, sv_type(t, pos), parts)
# returns (vertex module, fragment module). With DEWY_SPIRV_DUMP=dir, each is also written to
# dir/<n>.vert.spv and dir/<n>.frag.spv (for spirv-val: tools/spirvtest.py)
spirv_build = (vsf: int, fsf: int) -> (str, str):
    sv_translated = {}
    vs = sv_vertex(vsf)
    sv_translated = {}
    fs = sv_fragment(fsf)
    if let dir = env("DEWY_SPIRV_DUMP"):
        write_file("{dir}/{sv_dumped}.vert.spv", vs)
        write_file("{dir}/{sv_dumped}.frag.spv", fs)
        sv_dumped += 1
    (vs, fs)
# a buffer of 32-bit words that can be written
sv_rawptr_w = () -> int:
    if let id = sv_cache.get("rawptrw"): return id
    rt = sv_type_key("rawrtw", 29, [sv_u32()])
    sv_deco(rt, 6, [4])
    st = sv_type_key("rawstw", 30, [rt])
    sv_deco(st, 2, [])
    sv_mdeco(st, 0, 35, [0])
    p = sv_ptr(SC_PSB, st)
    sv_cache["rawptrw"] = p
    p
# this invocation's index: they are laid out in rows of all the x groups (as many as there may be,
# 65535, then more rows)
sv_invocation = () -> int:
    i = sv_i32()
    uv3 = sv_type_key("uv3", 23, [sv_u32(), 3])
    gid = sv_load(uv3, sv_builtin_var(uv3, SC_INPUT, 28))
    ng = sv_load(uv3, sv_builtin_var(uv3, SC_INPUT, 24))
    gx = sv_val(124, i, [sv_val(81, sv_u32(), [gid, 0])])
    gy = sv_val(124, i, [sv_val(81, sv_u32(), [gid, 1])])
    nx = sv_val(124, i, [sv_val(81, sv_u32(), [ng, 0])])
    sv_val(128, i, [gx, sv_val(132, i, [gy, sv_val(132, i, [nx, sv_ci(SV_KERNEL_GROUP)])])])

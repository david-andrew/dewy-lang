use 'checked_expression_nodes.dewy'
use 'ast.jo'
use 'check.jo'
use 'checker_tokens.dewy'
use 'checker_update_selectors.dewy'
use 'checks_builders.dewy'
use 'checks_thin.dewy'
use 'expr.jo'
use 'util.jo'

# The path from an expression back to its root, outermost access first.
index_update_path = (n: int) -> int[]:
    path: int[]
    let n = n
    loop nodes[n].kind == .field or nodes[n].kind == .index:
        path.push(n)
        n = int(nodes[n].a)
    path

# A compound update reads its target and writes it back. Each selector that
# can run code is evaluated exactly once, from the root outward (left to
# right), before both: `d[f()]["x"] += 1` calls f once. O(path).
compound_selector_capture = (s: int) -> int:
    if nodes[s].op == i32(int(Tok.assign)) or has_flag(s, NF_BROADCAST) or has_flag(s, NF_INDEX_CAPTURED): return 0
    lhs = int(nodes[s].a)
    if nodes[lhs].kind != .index and nodes[lhs].kind != .field: return 0
    pos = nodes[s].pos
    stmts: int[]
    path = index_update_path(lhs)
    i = path.len() - 1
    loop i >= 0:
        part = path[i]
        i -= 1
        if nodes[part].kind != .index or has_flag(part, NF_LIB_INDEX): continue
        selectors = if nodes[part].b != 0: [int(nodes[part].b)] else: kids(part)
        captured: int[]
        loop selector in selectors:
            if nodes[selector].kind == .range or nodes[selector].kind == .hole or not compound_selector_runs(selector):
                captured.push(selector)
                continue
            name = "$selector{bc_count}"
            bc_count += 1
            index_update_sources[intern(name)] = selector
            stmts.push(bc_let(name, selector, pos))
            captured.push(bc_ident(name, pos))
        if nodes[part].b != 0: nodes[part].b = i32(captured[0])
        else: set_list(part, captured)
    if stmts.len() == 0: return 0
    update = nodes.len()
    nodes.push(nodes[s])
    stmts.push(update)
    blk = bc_block(stmts, pos)
    check_stmt(blk)
    blk

# Only dictionary update paths need this work. O(path^2 + RHS): capture keys
# and ordinary indices before the old-value read/RHS, never entry positions.
# Each dictionary's receiver copy contains at most the preceding path.
# Plain RHSs retain the existing single-lookup compound update.
map_update_capture = (lhs: int, rhs: int, before: mut int[]):
    if nodes[lhs].kind != .field and nodes[lhs].kind != .index: return
    path = index_update_path(lhs)
    found = false
    loop part in path:
        if map_place_index(part): found = true
    if not found or not compound_selector_runs(rhs): return
    i = path.len() - 1
    loop i >= 0:
        part = path[i]; i -= 1
        if nodes[part].kind != .index or nodes[part].b == 0: continue
        entry = map_place_index(part)
        selector = if entry: kid(int(nodes[part].b), 1) else: int(nodes[part].b)
        kept = selector
        sk = nodes[selector].kind
        literal = sk == .int_lit or sk == .float_lit or sk == .bool_lit or sk == .str_lit and nkids(selector) == 0
        if not literal:
            kept = capture_value(selector, ntype(selector), before)
            if entry:
                add_flag(before[before.len() - 1], NF_MAP_KEY)
                add_flag(kept, NF_MAP_KEY)
        if entry:
            call = int(nodes[part].b)
            # map_elem_place copied the receiver before these selectors were
            # captured. Refresh it too (rows[i][key] must keep i as well).
            receiver = copy_place(int(nodes[int(nodes[part].a)].a))
            add_flag(receiver, NF_MUT)
            set_kid(call, 0, receiver)
            set_kid(call, 1, kept)
            add_flag(part, NF_RELOOKUP)
        else: nodes[part].b = i32(kept)

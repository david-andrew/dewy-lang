use 'checker_state.dewy'
use 'checker_tokens.dewy'
use 'refinement_types.dewy'
use 'dewy_reader_types.dewy'
# Erased procedures are checked in the finite fact domain, never executed.
use 'ast.jo'
use 'check.jo'
use 'expr.jo'
use 'facts.jo'
use 'facts_forgets.dewy'
use 'facts_conditions.dewy'
use 'refine.jo'
use 'isolation.jo'
use 'types.jo'
use 'lex.jo'
use 'util.jo'
use 'witness.jo'
use 'node_store.dewy'
use 'isolation_ops.dewy'
use 'proof_ops.dewy'

proof_active = false
proof_pending = false
proof_decls: {int: int} = {}
proof_predicates: {int: int} = {}
proof_calls: FactRequest[]

# Declaration metadata stays sparse; conditional witnesses live only in demanded
# states and refer to immutable results and evaluated arguments, never spellings.
struct ResultEvidence:
    result: int
    tag: int
    predicate: int
    values: int[]
    types: int[]
    payload: int = 0   # a refined arm's value (its predicate's own binder)
    base: int = 0      # and that arm's integer representation

result_active = false
result_syntax: {int: ResultClause[]} = {}
result_contracts: {int: ResultClause[]} = {}
result_boolean_masks: {int: int} = {}


use 'checker_state.dewy'
use 'checker_tokens.dewy'
# Shader translation: Sloppy functions -> SPIR-V 1.5 for Vulkan. The same functions become GLSL
# for OpenGL and WebGL (glsl.jo, which checks them first: what it accepts, this accepts).
#
# What a module expects (lib/game/vk.jo provides it):
#   push constants   params, vertices, instances: buffer addresses; vertex and instance strides;
#                    flip: 0, or the height of the window when drawing to it (y is turned over)
#   set 0 binding 0  every texture (combined image samplers); a Texture is its index (Texture.id)
# There is no vertex input state: the vertex function's input is read from the vertex buffer at
# vertex_id() (and the instance's at instance_id()). The uniforms are read in place from the bytes
# of the CPU's struct, so a value of the uniforms' type is an address, not a copy: a large array
# (bones: vec4[192]) is read an element at a time. Clip space is OpenGL's: z goes from -1 to 1 (made
# 0 to 1 here), and a frame drawn to a texture has row 0 at y = -1. A GpuBuffer is its address and
# length; its elements are laid out as the CPU lays them out, read and written a word at a time.

use 'util.jo'
use 'lex.jo'
use 'ast.jo'
use 'types.jo'
use 'type_ops.dewy'
use 'check.jo'
use 'checks_assign_hooks.dewy'
use 'expr.jo'
use 'checks_thin_expr.dewy'
use 'glsl.jo'
use 'glsl_stmts.dewy'
use 'glsl_ops.dewy'
use 'spirv_ops.dewy'
use 'spirv_emit.dewy'
use 'spirv_stmts.dewy'

# where in the push constants (see the comment above)
const SV_PC_PARAMS = 0
const SV_PC_VERTS = 1
const SV_PC_INSTS = 2
const SV_PC_VSTRIDE = 3
const SV_PC_ISTRIDE = 4
const SV_PC_FLIP = 5
const SV_PC_DEPTH = 6        # (compute programs over a 3D grid: its depth, in the padding)

sv_group = [64, 1, 1]        # the workgroup's size (x, y, z) of the compute program being made

# storage classes
const SC_UCONST = 0
const SC_INPUT = 1
const SC_OUTPUT = 3
const SC_FUNCTION = 7
const SC_PUSH = 9
const SC_PSB = 5349

# an address the uniforms (or part of them) are read from: a buffer address, plus a byte offset
# (c: a constant, d: an id of an i32 added to it, or 0)
struct SvRef:
    base: int
    c: int
    d: int
    t: int

sv_bound = 0
sv_caps: int[]
sv_dec: int[]
sv_glob: int[]
sv_fns: int[]
sv_cache: {str: int} = {}
sv_std = 0                     # the GLSL.std.450 instructions
sv_stage = ""                  # "vertex" or "fragment"
sv_iface: int[]                # the global variables the entry point uses
sv_fn_ids: {int: int} = {}     # Sloppy function -> SPIR-V function
sv_pending: int[]              # functions called but not yet translated
sv_translated: {int: bool} = {}
sv_utype = 0                   # the uniforms' type: its values are addresses
sv_pc = 0                      # global variables, made when first used
sv_textures = 0
sv_vid = 0
sv_iid = 0

# the function being translated
sv_body: int[]
sv_vars: int[]
sv_label = 0
sv_dead = false                # the current block has ended (code that follows is unreachable)
sv_loops: (int, int)[]         # (merge, continue) of the loops around
sv_lvar: {int: int} = {}       # local -> its variable (a pointer)
sv_lref: {int: int} = {}       # local of the uniforms' type -> its address

# GLSL.std.450 instructions for the prelude's math functions: (float, int) (0: none)
sv_std_ops: {str: (int, int)} = {
    "sin": (13, 0), "cos": (14, 0), "tan": (15, 0), "asin": (16, 0), "acos": (17, 0), "atan": (18, 0), "atan2": (25, 0),
    "exp": (27, 0), "log": (28, 0), "exp2": (29, 0), "log2": (30, 0), "pow": (26, 0), "sqrt": (31, 0), "abs": (4, 5),
    "floor": (8, 0), "ceil": (9, 0), "fract": (10, 0), "min": (37, 39), "max": (40, 42), "clamp": (43, 45), "mix": (46, 0),
    "lerp": (46, 0), "step": (48, 0), "smoothstep": (49, 0), "norm": (66, 0), "distance": (67, 0), "cross": (68, 0),
    "normalize": (69, 0), "reflect": (71, 0), "inverse": (34, 0), "sign": (6, 7), "sinf": (13, 0), "cosf": (14, 0),
}

# Ordered comparisons plus a bitwise tie preserve -0 for min and +0 for max.
# Select either NaN explicitly; raw GLSL.std.450 FMin/FMax leave it undefined.
sv_minmax = (t: int, a: int, b: int, minimum: bool, pos: int) -> int:
    ty = sv_type(t, pos)
    bt = sv_bool()
    ut = sv_u32()
    if sv_is_vector(t):
        bt = sv_vecb(sv_ncomp(t))
        ut = sv_type_key("uv{sv_ncomp(t)}", 23, [sv_u32(), sv_ncomp(t)])
    tie = sv_val(124, ty, [sv_val(sv_pick(minimum, 197, 199), ut, [sv_val(124, ut, [a]), sv_val(124, ut, [b])])])
    cmp = sv_pick(minimum, 184, 186)
    result = sv_val(169, ty, [sv_val(cmp, bt, [b, a]), b, tie])
    result = sv_val(169, ty, [sv_val(cmp, bt, [a, b]), a, result])
    result = sv_val(169, ty, [sv_val(156, bt, [b]), b, result])
    sv_val(169, ty, [sv_val(156, bt, [a]), a, result])

# atomic operations on an element of a GpuBuffer[i32] or GpuBuffer[u32]: (signed, unsigned) opcode
sv_atomic_ops: {str: (int, int)} = {
    "atomic_add": (234, 234), "atomic_sub": (235, 235), "atomic_min": (236, 237), "atomic_max": (238, 239),
    "atomic_and": (240, 240), "atomic_or": (241, 241), "atomic_xor": (242, 242), "atomic_exchange": (229, 229),
    "atomic_compare_exchange": (230, 230),
}

sv_dumped = 0

# ---------------- GPU array kernels ----------------
# The compute program of a dotted expression on GPU arrays (see glsl_kernel for the GLSL one, and
# __gpu_run in lib/game/gpuarray.jo): each invocation computes one element of the result. Its
# parameters are at the push constants' params address, as 32-bit words:
#   0: the result's address (2 words)   2..5: its shape, padded in front to 4 dimensions
#   6: its number of elements
#   8 + 6k: input k's address (2 words), then its steps per dimension (4: 0 where it stretches)
#   then the f32 numbers, then the i32 ones (desc says which operand is which: see glsl_kernel)
const SV_KERNEL_GROUP = 64

sv_cf = (x: f64) -> int: sv_const(sv_f32(), int(f32_bits(f32(x))))

use 'lower_analysis.dewy'
use 'lower_helpers.dewy'
use 'checker_program.dewy'
# Serial, demanded ambient-isolation proofs over checked instances. This is NOT
# purity or a no-allocation/no-panic contract. Arguments can still be mutated,
# resized and copied; consumers must separately exclude those actual places.
use 'checker_state.dewy'
use 'ast.jo'
use 'types.jo'
use 'check.jo'
use 'expr.jo'
use 'lower.jo'
use 'effects.jo'
use 'ownership.jo'
use 'effect_library.jo'
use 'node_store.dewy'
use 'ownership_types.dewy'
use 'effect_classifiers.dewy'
use 'isolation_ops.dewy'

enum IsolationReason: none_, unavailable, global_, capture, indirect, raw, intrinsic, node

# Rows are indexed by FnInst, never by a declaration or source filename. A
# completed SCC publishes a Boolean (reason == none_) and a blocking witness.
# The witness is a source node when available, otherwise an instance number.
struct IsolationRow:
    index: int
    low: int
    done: bool
    reason: IsolationReason
    witness: int

isolation_rows: IsolationRow[]
isolation_stack: int[]
isolation_seen: int[]
isolation_serial = 0
isolation_limit = 0
isolation_node_limit = 0

import 'concurrency.jo' as concurrency
use 'checker_state.dewy'
# Frozen recursive lowering from lower.jo.
use 'expr.jo'
use 'check.jo'
use 'ast.jo'
use 'lower_analysis.dewy'
use 'util.jo'
use 'lower.jo'
use 'types.jo'
use 'lower_helpers.dewy'
use 'concurrency_parsafe.dewy'

race_check = (callee: int, args: int[], pos: int):
    # (the library's own calls take care of threads themselves)
    if in_lib(pos): return
    who = name_of(int(nodes[int(fns[callee].decl)].name))
    if starts_with(who, "__dewy_parallel"): who = "`parallel`"
    loop a in args:
        if tkind(ntype(a)) == .fn_ and not concurrency.parsafe_vouched(a): race_arg(a, who)


race_arg = (a: int, who: str):
    k = nodes[a].kind
    if k == .conv: race_arg(int(nodes[a].a), who)
    else if k == .lambda: race_scan(int(fns[int(nodes[a].sym)].body), int(nodes[a].sym), who, true)
    else if k == .fnref:
        f = int(nodes[a].sym)
        race_root_callbacks(f, who, nodes[a].pos)
        if nodes[a].aux == 2: race_scan(int(fns[f].body), f, who, true)
        else: race_named(f, who)
    else if k == .partial:
        if nodes[a].aux == 1: race_arg(int(nodes[a].a), who)
        else:
            race_root_callbacks(int(nodes[a].sym), who, nodes[a].pos)
            race_named(int(nodes[a].sym), who)
            # (a function bound here is what the callee's parameter calls)
            loop bound in kids(a):
                if nodes[bound].kind != .hole and tkind(ntype(bound)) == .fn_: race_arg(bound, who)
    else: fatal(nodes[a].pos, "{who} runs this function on many threads at once, so the compiler checks it for data races, which it can only do for a function it can see: pass a function by name or a lambda")


# A function a parallel call runs gets its arguments from the array: a function among them is
# one no call shows. (A task's demand reaches each caller instead: parsafe_demand_task.)
race_root_callbacks = (f: int, who: str, pos: int):
    if starts_with(who, "spawn"): return
    loop t in fns[f].ptypes:
        if tkind(t) == .fn_: fatal(pos, "{who} runs this function on many threads at once, so the compiler checks it for data races, which it can only do for a function it can see: pass a function by name or a lambda")

# A function value a call in checked code gives: visible where it is written, or a parameter of
# the checked function, whose own callers were checked the same way. O(conversions).
race_given = (a0: int, who: str):
    a = a0
    loop nodes[a].kind == .conv: a = int(nodes[a].a)
    k = nodes[a].kind
    if k == .lambda or k == .fnref or k == .partial or k == .hole or race_direct_param(a) or concurrency.parsafe_vouched(a) or starts_with(who, "spawn") and concurrency.parsafe_demand_task(a, a): return
    fatal(nodes[a].pos, "{who} runs this code on many threads at once, so the compiler checks it for data races, which it can only do for a function it can see: pass a function by name or a lambda")

# A parameter of the named function being checked, itself: reached only through a call whose
# argument race_given checked (race_root_callbacks turns away the other way in).
race_direct_param = (a0: int) -> bool:
    a = a0
    loop nodes[a].kind == .conv: a = int(nodes[a].a)
    if nodes[a].kind != .ident or nodes[a].aux != i32(int(SK.local)): return false
    l = int(nodes[a].sym)
    if int(locals[l].flags) & LF_CAPTURE != 0: return false
    concurrency.parsafe_is_param(a) and fns[int(locals[l].owner)].kind == FK_NORMAL

parallel_direct = (f: int, pos: int):
    if f > 0 and fns[f].parallel_api and not in_lib(pos):
        fatal(pos, "'{name_of(int(nodes[int(fns[f].decl)].name))}' runs the function it is given on many threads at once, so it can only be called directly (where the compiler checks that function), not used as a value or partially applied")


type_as_value = (e: int):
    what = "a type"
    if tkind(ntype(e)) == .module: what = "a module"
    fatal(nodes[e].pos, "this is {what}, not a value (a value of a type is made by calling it: `T()`)")


in_lib = (pos: int) -> bool:
    fi = pos_file(pos)
    fi >= 0 and fi < files.len() and starts_with(files[fi].path, lib_dir + "/")


race_named = (f: int, who: str):
    if race_done.contains(f) or fns[f].body == 0: return
    race_done[f] = true
    # (the core and standard libraries take care of threads themselves)
    if fns[f].decl != 0:
        fi = pos_file(int(nodes[int(fns[f].decl)].pos))
        if fi >= 0 and fi < files.len() and starts_with(files[fi].path, lib_dir + "/") and (find(files[fi].path, "/core/") >= 0 or find(files[fi].path, "/std/") >= 0): return
    race_scan(int(fns[f].body), f, who, false)


race_target = (t: int, f: int, who: str, captures: bool, pos: int):
    # (writing through a pointer changes memory the program manages itself, not the variable)
    n = place_var(t)
    if n == 0: return
    nm = name_of(int(nodes[n].name))
    if nodes[n].aux == i32(int(SK.global)):
        fatal(pos, "{who} runs this function on many threads at once, so it must not change the global '{nm}' (a data race): return values instead")
    if captures and nodes[n].aux == i32(int(SK.local)):
        l = int(nodes[n].sym)
        if int(locals[l].owner) != f or int(locals[l].flags) & LF_CAPTURE != 0:
            fatal(pos, "{who} runs this function on many threads at once, so it must not change '{nm}', a variable it captured (a data race): return values instead")


race_scan = (n: int, f: int, who: str, captures: bool):
    if n == 0: return
    loop called in value_helper_calls(n): race_named(called, who)
    k = nodes[n].kind
    # (a closure or function value made here may run here, through a library's callback call,
    # which the scan does not follow; its own captures are checked where the task takes them)
    if k == .lambda:
        inner = int(nodes[n].sym)
        if inner > 0: race_scan(int(fns[inner].body), inner, who, false)
        return
    if (k == .fnref or k == .partial and nodes[n].aux != 1) and nodes[n].sym > 0: race_named(int(nodes[n].sym), who)
    if k == .assign: race_target(int(nodes[n].a), f, who, captures, nodes[n].pos)
    else if k == .intrinsic and nkids(n) > 0:
        id = nodes[n].aux as IN
        if id == .push or id == .pop or id == .insert or id == .remove or id == .clear or id == .reserve or id == .resize or id == .truncate or id == .extend:
            race_target(kid(n, 0), f, who, captures, nodes[n].pos)
    else if k == .call:
        mm = checked_call_mutmask(n)
        loop i in [0..nkids(n)):
            if mm & (1 << i) != 0: race_target(kid(n, i), f, who, captures, nodes[kid(n, i)].pos)
        aux = int(nodes[n].aux)
        if aux == 0 and nodes[n].sym > 0:
            race_named(int(nodes[n].sym), who)
            if not in_lib(nodes[n].pos):
                loop a in kids(n):
                    if tkind(ntype(a)) == .fn_: race_given(a, who)
        # (calling a function value: which one, the compiler cannot tell; the library's are its own,
        # and a callback parameter's are its function's callers' to check, which a task's call demands)
        else if aux == 1 and not in_lib(nodes[n].pos) and not concurrency.parsafe_vouched(int(nodes[n].a)) and not race_direct_param(int(nodes[n].a)) and not (starts_with(who, "spawn") and concurrency.parsafe_demand_task(int(nodes[n].a), n)):
            fatal(nodes[n].pos, "{who} runs this code on many threads at once, so the compiler checks it for data races, which it cannot do through a call of a function value it cannot trace to its caller: call a function by name, or take the function as a parameter, so each call's argument is checked")
    else if k == .for_ and has_flag(n, NF_MUT): race_target(int(nodes[n].a), f, who, captures, nodes[n].pos)
    # (a part of "...{x}...": formatted by a __fmt function, which may be the program's)
    else if k == .pair and nodes[n].sym > 0: race_named(int(nodes[n].sym), who)
    race_scan(int(nodes[n].a), f, who, captures)
    race_scan(int(nodes[n].b), f, who, captures)
    if k != .for_:
        race_scan(int(nodes[n].c), f, who, captures)
        if k != .partial: race_scan(int(nodes[n].d), f, who, captures)
    loop i in [0..nkids(n)): race_scan(kid(n, i), f, who, captures)
    loop i in [0..nkids2(n)): race_scan(kid2(n, i), f, who, captures)

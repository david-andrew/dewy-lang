$runtime_checks
# Demand-driven: nothing is read unless a declaration has a constant check. Cost: O(1) per
# declaration, O(1) per call of one, and one compile-time run of the validator per call with a
# constant argument.
from p"comptime_ops.dewy" import (checked_const_init ct_run)
from p"check_constant.jo" import (cc_passed CheckConstant cc_any cc_decls cc_errors cc_forwards cc_verdicts)
from p"checker_expr.dewy" import lookup
from p"ast.jo" import (NF_CHECKED add_flag kid kids mk nkids nodes set_list)
from p"check.jo" import (fns get_fn_inst syms)
from p"expr.jo" import (CV ntype)
from p"constant_fold_ops.dewy" import (cc_closed_expr cc_fold_first cc_fold_after)
from p"types.jo" import (T_STR is_union prune tkind union_members)
from p"type_ops.dewy" import (dt mk_union union_index)
from p"util.jo" import (name_of pos_in_lib)
from p"diagnostic_exit.dewy" import (fatal)
from p"error_ops.dewy" import (exception_member)
from p"comptime.jo" import (ct_values)
from p"warn_if_ops.dewy" import (wi_param)
from p"unit_rare.dewy" import (time_grid_proven)

ConstantWord:type=int64<overflow='wrap'>
let CC_LOCAL:ConstantWord=1 # SK.local
let CC_GLOBAL:ConstantWord=2 # SK.global
let CC_CONST:ConstantWord=6 # SK.const_
cc_reset=():>void=>{
    cc_forwards=dict<int64 array<int64>>()
    cc_verdicts=dict<string string>()
    cc_decls=dict<int64 array<CheckConstant>>()
    cc_any=false
    cc_errors=dict<int64 string>()
}
# fn_sig, in the declaration's scope: its check, read once.
cc_read_decl=(decl:ConstantWord):>void=>$unsafe {
    if nodes.ptr[decl].c =? 0 or cc_decls.has(decl) or cc_errors.has(decl) {return}
    let checks:array<CheckConstant>=[]
    loop at in kids(ConstantWord(nodes.ptr[decl].c)) {
        # (`$error_if true "..."`: this overload exists to say what to write instead)
        if name_of(ConstantWord(nodes.ptr[at].name)) =? "error_if" {
            let cond=ConstantWord(nodes.ptr[at].a)
            let said=ConstantWord(nodes.ptr[at].b)
            if cond =? 0 or said =? 0 or nodes.ptr[cond].kind not=? 'bool_lit' or nodes.ptr[cond].ival =? 0 or nodes.ptr[said].kind not=? 'str_lit' {fatal(nodes.ptr[at].pos "`$error_if` takes `true` and a message for now: `$error_if true \"write this instead\"`")}
            cc_errors[decl]=name_of(ConstantWord(nodes.ptr[said].sval))
            cc_any=true
            continue
        }
        if name_of(ConstantWord(nodes.ptr[at].name)) not=? "check_constant" {continue}
        let call=ConstantWord(nodes.ptr[at].a)
        let msg=ConstantWord(nodes.ptr[at].b)
        let bad="a constant check names a validator, a parameter and a message: `@check_constant(validator(param), \"message\")`"
        if call =? 0 or msg =? 0 or nodes.ptr[msg].kind not=? 'str_lit' or nodes.ptr[call].kind not=? 'call' or nkids(call) <? 1 {fatal(nodes.ptr[at].pos bad)}
        let callee=ConstantWord(nodes.ptr[call].a)
        if callee =? 0 or nodes.ptr[callee].kind not=? 'ident' {fatal(nodes.ptr[at].pos bad)}
        let params:array<int64>=[]
        loop i in [0..nkids(call)) {
            let param=wi_param(decl kid(call i))
            if param <? 0 {fatal(nodes.ptr[at].pos bad)}
            params.push(param)
        }
        let s=lookup(ConstantWord(nodes.ptr[callee].name))
        if s =? 0 or syms.ptr[s].kind not=? 'fns' {fatal(nodes.ptr[callee].pos "the validator of a constant check is a function: `{name_of(ConstantWord(nodes.ptr[callee].name))}` is none")}
        checks.push(CheckConstant(params ConstantWord(syms.ptr[s].decl) name_of(ConstantWord(nodes.ptr[msg].sval))))
        cc_decls[decl]=checks
        cc_any=true
    }
}
# (the constant string an argument is, or -1 when it is not one)
cc_constant=(x0:ConstantWord):>ConstantWord=>$unsafe {
    let x=x0
    loop i in [0..16) {
        if nodes.ptr[x].kind =? 'conv' and nodes.ptr[x].a not=? 0 and prune(ntype(ConstantWord(nodes.ptr[x].a))) =? T_STR {x=ConstantWord(nodes.ptr[x].a)}
        else {break}
    }
    # (with parts, it is an interpolation)
    if nodes.ptr[x].kind =? 'str_lit' {return if nkids(x) =? 0 {ConstantWord(nodes.ptr[x].sval)} else {-1}}
    if nodes.ptr[x].kind not=? 'ident' {return -1}
    let k=ConstantWord(nodes.ptr[x].aux)
    if k not=? CC_CONST and k not=? CC_GLOBAL and k not=? CC_LOCAL {return -1}
    let initial=checked_const_init(k ConstantWord(nodes.ptr[x].sym) nodes.ptr[x].pos)
    if initial not=? 0 and nodes.ptr[initial].kind =? 'str_lit' and nkids(initial) =? 0 {return ConstantWord(nodes.ptr[initial].sval)}
    -1
}
# expr.jo, a call n of f (declaration decl) whose type is set: its narrowed type, or 0 when it
# stays as it is
cc_call=(n:ConstantWord f:ConstantWord decl:ConstantWord):>ConstantWord=>$unsafe {
    if cc_errors.has(decl) {fatal(nodes.ptr[n].pos cc_errors[decl])}
    if not cc_decls.has(decl) {return 0}
    # (every argument constant and the value a plain record: the value, nothing at run time)
    let folded=cc_fold_first(n decl)
    if folded not=? 0 {return folded}
    # (the first check whose arguments are all closed decides)
    loop c in cc_decls[decl] {
        if c.params.length =? 1 and c.params[0] <? nkids(n) and time_grid_proven(c.validator kid(n c.params[0])) {return cc_narrow(n "OffGrid")}
        let args=cc_arguments(kids(n) c)
        if args.length not=? c.params.length {continue}
        let pos=cc_check_pos(n c)
        let said=cc_verdict(c args pos)
        if said isnt? none {
            if said =? "" {return 0}
            fatal(pos "{c.message}: {said}")
        }
        cc_passed[n]=true
        let after=cc_fold_after(n decl)
        if after not=? 0 {return after}
        return cc_narrow(n)
    }
    0
}
# (at the argument, or at the call when a parameter's default filled it in)
cc_check_pos=(n:ConstantWord c:CheckConstant):>ConstantWord=>$unsafe {
    let pos=nodes.ptr[n].pos
    if nkids(n) >? c.params[0] and not pos_in_lib(nodes.ptr[kid(n c.params[0])].pos) {pos=nodes.ptr[kid(n c.params[0])].pos}
    pos
}
# The validator of c on its constant arguments, run now: none when they pass, else what it said
# ("" promises nothing and fails nothing).
cc_verdict=(c:CheckConstant args:array<int64> pos:ConstantWord):>string|none=>$unsafe {
    # (one run for each validator and constant: `fmt'.2f'` asks the same of every call)
    let key=if args.length =? 1 and nodes.ptr[args[0]].kind =? 'str_lit' {"{c.validator}:{name_of(ConstantWord(nodes.ptr[args[0]].sval))}"} else {""}
    if key not=? "" and cc_verdicts.has(key) {
        let said=cc_verdicts[key]
        return if said =? "\u{1}" {none} else {said}
    }
    let said=cc_verdict_run(c args pos)
    if key not=? "" {cc_verdicts[key]=said ?? "\u{1}"}
    said
}
cc_verdict_run=(c:CheckConstant args:array<int64> pos:ConstantWord):>string|none=>$unsafe {
    let v=get_fn_inst(c.validator [] pos)
    let run=mk('call' pos)
    nodes.ptr[run].sym=int32(v)
    nodes.ptr[run].type=fns.ptr[v].ret
    add_flag(run NF_CHECKED)
    set_list(run args)
    let why=ct_values[ct_run(run)]
    if tkind(why.type) =? 'opt' and why.i not=? 0 {return ct_values[why.items[0]].s}
    if tkind(why.type) =? 'str_' {return why.s}
    none
}
# Overloads told apart only by their constant checks of strings, as `fmt`'s, one for each kind of pattern
# (the interim form of string shapes, D11): with constant arguments, the candidates whose
# validators pass; with others, the candidates without a check. Each entry of decls is a
# candidate's declaration, of args its arguments and of params its parameter types. [] keeps every candidate (fewer
# than two have checks). None passing is a compile error: the first one's message. O(candidates)
# validator runs, only where two candidates have checks.
cc_choose=(n:ConstantWord decls:array<int64> args:array<array<int64>> params:array<array<int64>>):>array<int64>=>$unsafe {
    let checked=0
    loop d in decls {if cc_decls.has(d) {checked+=1}}
    if checked <? 2 {return []}
    let passed:array<int64>=[]
    let plain:array<int64>=[]
    let failed=""
    let failed_pos:ConstantWord=0
    let constant=true
    loop i in [0..decls.length) {
        if not cc_decls.has(decls[i]) {
            plain.push(i)
            continue
        }
        let c=cc_decls[decls[i]][0]
        # (a string a check reads, as a string shape will: other checked values keep every candidate)
        loop p in c.params {
            if p >=? params[i].length or prune(params[i][p]) not=? T_STR {return []}
        }
        let given=cc_arguments(args[i] c)
        if given.length not=? c.params.length {
            constant=false
            continue
        }
        let pos=nodes.ptr[n].pos
        if args[i].length >? c.params[0] and not pos_in_lib(nodes.ptr[args[i][c.params[0]]].pos) {pos=nodes.ptr[args[i][c.params[0]]].pos}
        let said=cc_verdict(c given pos)
        if said is? none {passed.push(i)}
        else if failed_pos =? 0 and said not=? "" {
            failed="{c.message}: {said}"
            failed_pos=pos
        }
    }
    if passed.length >? 0 {return passed}
    if constant and failed_pos not=? 0 {fatal(failed_pos failed)}
    plain
}
# The constants a check's parameters are given, as its validator takes them; short when one is not.
cc_arguments=(xs:array<int64> c:CheckConstant):>array<int64>=>$unsafe {
    let args:array<int64>=[]
    loop p in c.params {
        if p >=? xs.length {return args}
        let x=xs[p]
        let text=cc_constant(x)
        # (a string the parameter takes as itself; in a wider type, the argument keeps its conversion)
        if text >=? 0 and prune(ntype(x)) =? T_STR {
            let arg=mk('str_lit' nodes.ptr[x].pos)
            nodes.ptr[arg].sval=int32(text)
            nodes.ptr[arg].type=int32(T_STR)
            add_flag(arg NF_CHECKED)
            args.push(arg)
        } else {
            if not cc_closed_expr(x 0) {return args}
            args.push(x)
        }
    }
    args
}
# A call that cannot fail: its type without the exceptions, or its value when that is one plain record.
cc_narrow=(n:ConstantWord only:string=""):>ConstantWord=>$unsafe {
    # (it cannot fail: what is left of the result once its exceptions are gone)
    let rt=prune(ntype(n))
    if not is_union(rt) {return 0}
    let kept:array<int64>=[]
    loop m in union_members(rt) {
        if not exception_member(m) or only not=? "" and dt(m) not=? only {kept.push(m)}
    }
    if kept.length =? 0 or kept.length =? union_members(rt).length {return 0}
    let inner=nodes.length
    nodes.push(nodes.ptr[n])
    let e=mk('narrow' nodes.ptr[n].pos)
    let t=kept[0]
    if kept.length =? 1 {nodes.ptr[e].aux=int32(union_index(rt t))}
    else {
        t=mk_union(kept)
        nodes.ptr[e].kind='conv'
        nodes.ptr[e].aux=int32(int64(CV.union_))
    }
    nodes.ptr[e].a=int32(inner)
    nodes.ptr[e].type=int32(t)
    add_flag(e NF_CHECKED)
    nodes.ptr[n]=nodes.ptr[e]
    t
}

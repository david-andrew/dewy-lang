$runtime_checks
from p"@lib/core/os.jo" import (cwd delete_file env eprint exit mkdir read_file)
from p"@lib/core/str.jo" import (is_alnum split starts_with trim)
from p"check.jo" import (fns global_ids globals init_fns mod_bits modules repl_sig repl_sig_query)
from p"ide.jo" import (ide_doc ide_texts)
from p"lower.jo" import (data_size global_off late_binding lfuncs rodata)
from p"main.jo" import (bss_reserve compile img_data_addr img_ro_addr img_text_addr repl_image)
from p"module_paths.dewy" import (os_path path_norm)
from p"proc_sys.dewy" import (ps_close ps_dup2 ps_exe_ext ps_exit ps_fork ps_pipe ps_self_id)
from p"repl.jo" import (REPL_DATA_RESERVE REPL_REGION_SIZE lf_abs repl_cabi_abs repl_end repl_from repl_help repl_hist_path repl_history repl_inited repl_inputs repl_jbuf repl_mainm repl_modules_inited repl_next repl_out repl_raw repl_region repl_run repl_send repl_to repl_try repl_tty repl_wait_reply repl_write ro_segs ro_shipped rs_complete rs_console_keys rs_start_windows rs_terminal)
from p"repl_ops.dewy" import (repl_builtin_doc repl_read repl_save_history repl_started)
from p"util.jo" import (files quiet_errors)
from p"x64.jo" import (fn_addr)
from p"x64_module.dewy" import (cabi_adapter)

DriveWord:type=int64<overflow='wrap'>
repl_start=():>string=>$unsafe {
    repl_next=repl_region()
    let src="__repl_main = (): __repl_serve({repl_next}, {REPL_REGION_SIZE})\n"
    let cache="{os_path(temp_dir())}/dewy-repl"
    mkdir(cache);
    let path="{cache}/repl-{ps_self_id()}{ps_exe_ext()}"
    # read_source looks up virtual text by its normalized path. TMPDIR often
    # ends in a slash (including on macOS), so normalize the stored key too.
    let main_src=path_norm("{cache}/<input>")
    ide_texts[main_src]=src
    repl_image=true
    bss_reserve=REPL_DATA_RESERVE
    # (the session's module is the one the inputs add to)
    let built=compile(main_src path)
    if (built as array<uint8>).length =? 0 {return "could not build the session program"}
    loop i in 0.. and m in modules {
        if m.is_main {repl_mainm=i}
    }
    late_binding=true
    # (inputs `use` files relative to the current directory)
    modules[repl_mainm].dir=cwd()
    files[DriveWord(modules[repl_mainm].file)].is_dewy=true
    mod_bits[repl_mainm] |= 2
    loop f in init_fns {repl_modules_inited[DriveWord(fns.ptr[f].mod)]=true}
    loop i in [0..lfuncs.length) {
        let a:DriveWord=0
        if i <? fn_addr.length and fn_addr[i] >=? 0 {a=img_text_addr + fn_addr[i]}
        lf_abs.push(a)
    }
    ro_segs.push([0 rodata.length img_ro_addr])
    ro_shipped=rodata.length
    loop [lf off] in cabi_adapter {repl_cabi_abs[lf]=img_text_addr + off}
    loop g in global_ids {
        if modules[DriveWord(globals.ptr[g].mod)].is_prelude and global_off.get(g) not=? none {repl_inited[g]=true}
    }
    if $target.os =? 'windows' {
        # start it with two pipes, their handles in DEWY_REPL_PIPES
        let why=rs_start_windows(path)
        if (why as array<uint8>).length >? 0 {return why}
    }
    else {
        # start it, with its end of two pipes as fds 3 and 4
        let a=ps_pipe(false)
        let b=ps_pipe(false)
        let pid=ps_fork()
        if pid =? 0 {
            ps_dup2(a[0] 3)
            ps_dup2(b[1] 4)
            __exec_unslid(path [path]);
            ps_exit(127)
        }
        ps_close(a[0])
        ps_close(b[1])
        repl_to=a[1]
        repl_from=b[0]
        if not repl_started() {return "the session program did not start"}
        delete_file(path);
    }
    repl_jbuf=__alloc(192)
    ""
}
# 0: completed, 1: failed input (keep the session), 2: session ended.
repl_run_input=(text:string):>int64=>{
    let c=repl_try(text true)
    if not c.ok {return 1}
    let o=c.out
    repl_inputs += 1
    repl_send(1 o.addr o.code)
    # (with the end of the globals: what the session copies before running it, on Windows)
    let h:array<int64>=[2 o.addr + o.entry img_data_addr + data_size + 8]
    repl_write($unsafe (data(h) as ptr<uint8>) 24)
    let r=repl_wait_reply()
    if r <? 0 {
        eprint("the session ended")
        return 2
    }
    if r >=? 512 {
        if r - 512 =? 101 {return 1}
        repl_end()
        exit(r - 512)
    }
    if r =? 256 + 2 {eprint("interrupted; the session is as it was before this input")} else if r >=? 256 {eprint("crashed (signal {r - 256}); the session is as it was before this input")}
    if r >=? 256 {return 1}
    0
}
# names that could go at the end of text (what is typed of the name being completed is dropped):
# the checker, at a placeholder name (as the language server does), then the compiler's memory
# put back as it was
repl_completions=(text:string):>array<string>=>{
    let a=(text as array<uint8>).length
    loop a >? 0 and (is_alnum((text as array<uint8>)[a - 1]) or (text as array<uint8>)[a - 1] >=? 0x80) {a -= 1}
    let probe="{text.byte_slice(0 a)}__dewy_complete__\n"
    let got=rs_complete(probe)
    let prefix=text.byte_slice(a (text as array<uint8>).length)
    let out:array<string>=[]
    loop l in split(got "\n") {
        if not starts_with(l "C\t") {continue}
        let e=find_byte(l b'\t' 2)
        if e <? 0 {e=(l as array<uint8>).length}
        let name=l.byte_slice(2 e)
        if not starts_with(name prefix) or out.contains(name) {continue}
        if starts_with(name "__") and not starts_with(prefix "_") {continue}
        out.push(name)
    }
    out.sort()
    out
}
repl_load_history=():>void=>{
    let path=env("DEWY_REPL_HISTORY")
    if path not=? none {
        repl_hist_path=path
    }
    else {
        let home=env("HOME") ?? ""
        if $target.os =? 'windows' {
            if (home as array<uint8>).length =? 0 {home=os_path(env("USERPROFILE") ?? "")}
        }
        if (home as array<uint8>).length =? 0 {return}
        repl_hist_path="{home}/.dewy_history"
    }
    if (repl_hist_path as array<uint8>).length =? 0 {return}
    let h=read_file(repl_hist_path)
    if h not=? none {
        loop l in lines(h) {
            if (l as array<uint8>).length >? 0 {repl_history.push(l)}
        }
    }
}
repl_main=():>void=>{
    ide_doc="<input>.dewy"
    repl_tty=rs_terminal()
    let why=repl_start()
    if (why as array<uint8>).length >? 0 {
        eprint("dewy-core: {why}")
        exit(1)
    }
    rs_console_keys()
    if repl_tty {
        repl_out("Dewy (:help for help; braces may span lines; ctrl-d quits)\n")
        repl_load_history()
    }
    loop true {
        repl_raw(true)
        let text0=repl_read()
        repl_raw(false)
        if text0 =? none {break}
        let text=text0 ?? ""
        if (trim(text) as array<uint8>).length =? 0 {continue}
        let t1=trim(text)
        if t1 =? "exit" or t1 =? "quit" or t1 =? ":q" or t1 =? ":quit" or t1 =? ":exit" {break}
        if t1 =? ":help" or t1 =? ":h" or t1 =? "help" {
            repl_out(repl_help)
            continue
        }
        if starts_with(t1 ":type ") or starts_with(t1 ":t ") or starts_with(t1 ":doc ") {
            let what=trim(t1.byte_slice(find_byte(t1 b' ') + 1 (t1 as array<uint8>).length))
            # (built into the language: print, len of an array, ...: what they are, as API.md says)
            let bi=repl_builtin_doc(what)
            if (bi as array<uint8>).length >? 0 {repl_out(bi)}
            repl_sig_query=true
            repl_sig=""
            let quiet=(bi as array<uint8>).length >? 0
            if quiet {quiet_errors=true}
            let c=repl_try("{what}\n" false)
            quiet_errors=false
            repl_sig_query=false
            repl_sig=""
            if c.ok {
                if c.show {repl_out("{c.type}\n")} else if not quiet {repl_out("void\n")}
            }
            continue
        }
        if not repl_run(text) {break}
    }
    repl_save_history()
    repl_end()
    exit(0)
}

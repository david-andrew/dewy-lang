# Frozen library classification from effect_library.jo.
use 'effect_library.jo'
use 'check.jo'
use 'types.jo'
use 'effects.jo'
use 'util.jo'
use 'expr.jo'
use 'ast.jo'
use 'refine.jo'
use 'effect_values.dewy'

effect_library_reset = ():
    effect_class_cache = {}
    effect_class_text = {}


effect_library_class = (g: int) -> EffectClass:
    if let known = effect_class_cache.get(g): return known
    c = effect_library_classify(g)
    effect_class_cache[g] = c
    c


# What a formatting leaf writes without a hook: text, a flag, a number or `int`.
effect_library_leaf = (t0: int) -> bool:
    t = prune(t0)
    if t == T_STR or t == T_MATH_INT: return true
    k = types[t].kind
    k == .int_ or k == .float_ or k == .bool_


# The buffer is a mutable byte array; the remaining parameters are leaves.
effect_library_formatter = (g: int) -> bool:
    params = fns[g].params
    if params.len() < 2: return false
    b = prune(int(locals[params[0]].type))
    if int(locals[params[0]].flags) & LF_MUTPARAM == 0 or types[b].kind != .array or prune(int(types[b].elem)) != T_U8: return false
    loop i in [1..params.len()):
        if not effect_library_leaf(int(locals[params[i]].type)): return false
    true


effect_library_classify = (g: int) -> EffectClass:
    if g <= 0 or g >= fns.len(): return .unclassified
    d = int(fns[g].decl)
    if d == 0 or nodes[d].kind != .fn_ or len(lib_root) == 0: return .unclassified
    path = files[pos_file(nodes[d].pos)].path
    if not starts_with(path, lib_root): return .unclassified
    file = path[len(lib_root)..]
    if file == "/core/str.jo" or file == "/std/graphemes.jo" or file == "/std/dewy.jo": effect_class_text[g] = true
    name = name_of(int(nodes[d].name))
    # Exact builtin declarations: these return shape/data snapshots or their
    # lengths, without element hooks or shape assertions.
    if file == "/std/nd.jo" and name in ["__nd_length", "ndim", "size", "flatten"] and fns[g].params.len() == 1:
        t = representation_type(int(locals[fns[g].params[0]].type))
        if is_nd(t) and effect_share(nd_elem(t)): return .reads
    if file == "/core/fmt.jo" or file == "/math_int.jo":
        if name in ["__fmt", "__dewy_fmt", "__fmt_elem", "__dewy_fmt_elem", "__fmt_u64", "__fmt_hex", "__fmt_float", "__fmt_fixed"]:
            # (an interpolation's writer, `"{name}{row}"`: it appends a leaf to
            # its own buffer, so a helper that formats keeps its caller's roots)
            if not effect_library_formatter(g): return .unclassified
            effect_class_text[g] = true
            return .allocates
        if name == "__fmt_spec":
            if not effect_library_formatter(g): return .unclassified
            effect_class_text[g] = true
            return .allocates_panics
        if name == "format" and fns[g].params.len() == 2 and effect_library_leaf(int(locals[fns[g].params[0]].type)): return .allocates_panics
        return .unclassified
    if file == "/core/rt.jo":
        if name in ["__str_eq", "__str_cmp", "__mem_eq", "__str_hash", "__str_khash", "__hash_bytes"]: return .reads
        # (not __str_append or __buf_finish: they write through a raw pointer)
        if name in ["__str_concat", "__str_from_bytes", "__str_new", "__buf_append_str", "__buf_append_raw", "__buf_byte", "__buf_reserve"]: return .allocates
        return .unclassified
    if file == "/core/str.jo":
        if name in ["find", "rfind", "find_byte", "contains", "starts_with", "ends_with", "count", "hash", "__has_byte", "__has_char", "__memchr"]: return .reads
        if name in ["trim", "trim_start", "trim_end", "split", "words", "lines", "join", "replace", "upper", "lower", "__str_from", "__buf_finish_val", "__case_text", "to_int", "to_float"]: return .allocates
        return .unclassified
    if file == "/math_runtime.jo":
        if name == "__mi_parse_word": return .reads
        # (`to_int` on text: it writes only its result, so a helper that parses keeps its caller's roots)
        if name in ["__mi_parse", "__mi_parse_limited", "__mi_parse_slow"]:
            effect_class_text[g] = true
            return .allocates
        return .unclassified
    if file == "/std/graphemes.jo":
        if name == "__dewy_string_length": return .reads
        # (a search from a grapheme position fails for a negative one)
        if name == "__dewy_find" or name == "__dewy_rfind": return if fns[g].params.len() == 2: .allocates else: .allocates_panics
        if name == "__dewy_string_index" or name == "__dewy_string_slice": return .allocates_panics
        return .unclassified
    if file == "/std/dewy.jo":
        if name == "is_empty" and fns[g].params.len() == 1 and prune(int(locals[fns[g].params[0]].type)) == T_STR: return .reads
        # (a character class collects the text's graphemes and reads the
        # embedded Unicode table)
        if name in ["is_alpha", "is_digit", "is_space", "is_alnum"] and fns[g].params.len() == 1 and prune(int(locals[fns[g].params[0]].type)) == T_STR: return .allocates
        if name == "remove_prefix" or name == "remove_suffix": return .allocates
        if name == "__dewy_byte_slice": return .allocates_panics
    # (a dictionary lookup by a word or text key hashes and compares the key
    # with builtin operations and reads the table; `[]` panics on a missing
    # key. As facts' fact_map_reads_only: a const table read in a helper)
    # (its size and fresh arrays of word, text or share entries: it writes only its result, so a
    # helper with a dictionary of its own keeps its caller's roots)
    if file == "/core/map.jo" and name in ["len", "is_empty", "keys", "values", "__map_entries"] and fns[g].params.len() == 1:
        m = representation_type(int(locals[fns[g].params[0]].type))
        if is_map_type(m) and effect_share(struct_targ(int(types[m].st), 0)) and effect_share(struct_targ(int(types[m].st), 1)):
            if name == "len" or name == "is_empty": return .reads
            effect_class_text[g] = true
            return .allocates
    if file == "/core/map.jo" and name == "__map_of" and fns[g].params.len() == 1:
        m = representation_type(int(fns[g].ret))
        if is_map_type(m) and effect_share(struct_targ(int(types[m].st), 0)) and effect_share(struct_targ(int(types[m].st), 1)):
            effect_class_text[g] = true
            return .allocates
    if file == "/core/map.jo" and name in ["get", "contains", "has", "[]"] and fns[g].params.len() == 2:
        m = representation_type(int(locals[fns[g].params[0]].type))
        k = representation_type(int(locals[fns[g].params[1]].type))
        if is_map_type(m) and (effect_scalar(k) or k == T_STR) and effect_share(struct_targ(int(types[m].st), 1)):
            return if name == "[]": .allocates_panics else: .reads
    # (the exact numbers' Dewy library: value code over word arrays that calls
    # only arithmetic, text and math builtins and `panic`, with no global
    # state. Reviewed, it allocates, may fail and writes only its own `@`
    # parameters, so rational arithmetic in a helper keeps its caller's roots)
    if file == "/bigint.dewy" or file == "/rational.dewy":
        loop l in fns[g].params:
            t = representation_type(int(locals[l].type))
            if is_fn_type(t) or int(locals[l].flags) & LF_MUTPARAM == 0 and not effect_value(t): return .unclassified
        if not effect_value(int(fns[g].ret)) and int(fns[g].ret) != T_VOID: return .unclassified
        effect_class_text[g] = true
        return .allocates_panics
    # (`set"..."`: a fresh set of the text's graphemes, as a character class
    # collects them; it writes only its own result)
    if file == "/std/dewy_sets.jo" and name == "set" and fns[g].params.len() == 1 and prune(int(locals[fns[g].params[0]].type)) == T_STR:
        effect_class_text[g] = true
        return .allocates
    .unclassified

# The Sloppy compiler.
#   sloppy file.jo [args]     compile and run
#   sloppy build file.jo [-o out] [--target wasm32] [--release]
#   sloppy watch file.jo [args]     run it, and reload it while its files change (watch.jo)

build:
    opt = release

use 'util.jo'
use 'module_paths.dewy'
use 'lex.jo'
use 'ast.jo'
use 'parse.jo'
use 'types.jo'
use 'check.jo'
use 'spelling.dewy'

# The Dewy compiler.
#   dewy file.jo [args]     compile and run
#   dewy build file.jo [-o out] [--target wasm32] [--release]
#   dewy watch file.jo [args]     run it, and reload it while its files change (watch.jo)

build:
    opt = release

use 'util.jo'
use 'module_paths.dewy'

const DEWY_CORE_VERSION = "0.0.0-dev"

usage = (status: int = 2):
    eprint("usage: dewy-core                         (a terminal: the interactive prompt; piped input: run it as a program)\n       dewy-core [run] [--release|--debug] [--target T] file.dewy [args...]\n       dewy-core [--release|--debug] [--target T] [--web] [--time]   (the program read from standard input)\n       dewy-core build file.dewy [-o output] [--target x86_64-linux|aarch64-linux|aarch64-mac|x86_64-windows|wasm32] [--release|--debug] [--time] [--exit-codes]\n       dewy-core check [--obligations] file.dewy\n       dewy-core test [--watch] [--release|--debug] [--json] file.dewy [name filters...]\n       dewy-core watch file.dewy [args...]\n       dewy-core new <directory> [game|arcade|platformer|3d|story|online|program]\n       dewy-core lsp\n       dewy-core --version\n       dewy-core --print-lib\n\n--release and --debug choose the build mode and --target the target, overriding the file's\n`$build.mode = ...` and `$target = ...` (with a warning where they differ); the default is a\ndebug build for this machine.\n\nExperimental Dewy compiler. Implementation/library .jo sources are also accepted.\nBuild from this repository to update; see docs/DEVELOPMENT.md.")
    exit(status)

# An option the command line does not have. A metatag's name (`--runtime-checks`,
# `$no_hidden_costs=false`) gets the reason: a program's safety and meaning are set in its
# source, never on the command line, which sets only the build mode and the target.
cli_option_refused = (x: str):
    name = x
    loop len(name) > 0 and (name[0] == '-' or name[0] == '$'): name = name[1..]
    eq = find(name, "=")
    if eq >= 0: name = name[..eq)
    tag = ""
    loop c in name: tag += if c == '-': "_" else: byte_str(int(c))
    # (the metatags the compiler knows, and the bundles of lib/directives.dewy)
    bundles = read_file("{lib_dir}/directives.dewy") ?? ""
    known = len(tag) > 0 and (dw_dir_known(tag) or tag == "default_row" or starts_with(bundles, "${tag} ") or find(bundles, "\n${tag} ") >= 0)
    if known and tag != "target" and tag != "build":
        eprint("dewy-core: `${tag}` cannot be set from the command line; write it in the program's source (the command line sets only the build mode, --release or --debug, and the target, --target)")
        exit(2)
    eprint("dewy-core: unknown option '{x}'")
    usage()

find_lib_dir = () -> str:
    if let e = env("DEWY_CORE_LIB"):
        if len(e) > 0: return os_path(e)
    exe = os_path(exe_path())
    d = exe
    s = rfind(d, "/")
    if s >= 0: d = d[..s)
    s = rfind(d, "/")
    if s >= 0: d = d[..s)
    if not file_exists("{d}/lib/core/rt.jo"):
        eprint("dewy-core: cannot find the standard library next to {exe} (expected {d}/lib); set DEWY_CORE_LIB to its location")
        exit(2)
    "{d}/lib"

dump = false
host_ir = false                # scalar IR for the optional optimized compiler-host build
debug_info = false            # DWARF line tables (sloppy build)
debug_vars = false            # and where variables are, with their types (sloppy build -g)
exit_codes_only = false          # (dewy build --exit-codes: main's exit codes, and nothing built)
timing = false

# build options written in the program itself:
#   build:
#       target = wasm32
#       output = "game"
build_output = ""

# the target, from the command line or else the main file: for building, checking and the
# language server alike
setup_target = ():
    host = host_target_name()
    tgt = build_target
    # (one the file names wrongly: the checker says where)
    if len(target_problem(tgt, host)) > 0: tgt = ""
    if len(cli_target) > 0: tgt = cli_target
    if native_only: tgt = host
    if tgt == "": tgt = host
    why = target_problem(tgt, host)
    if len(why) > 0:
        eprint("dewy-core: {why}")
        exit(2)
    # (a processor alone: this machine)
    if not (tgt in supported_target_names()): tgt = host
    target_wasm = tgt == "wasm32"
    target_windows = tgt == "x86_64-windows"
    target_macos = tgt == "aarch64-mac"
    target_arm64 = tgt == "aarch64-linux" or target_macos
    if target_wasm: ptr_size = 4

# (a game's update or draw, as the checker finds it: a top-level `name =` or `let name =`, at
# the start of a line; a method call such as hasher.update(...) is not one)
declares_top = (src: str, name: str) -> bool:
    at = find(src, name)
    loop at >= 0:
        b = at
        if b >= 4 and src[b - 1] == ' ' and src[b - 4] == 'l' and src[b - 3] == 'e' and src[b - 2] == 't': b -= 4
        e = at + len(name)
        loop e < len(src) and src[e] == ' ': e += 1
        if (b == 0 or src[b - 1] == '\n') and e < len(src) and src[e] == '=' and (e + 1 >= len(src) or src[e + 1] != '='): return true
        at = find(src, name, at + len(name))
    false

# (a quick read of the main file's build block before anything is checked; check_build_block
# reports its mistakes)
scan_build_block = (path: str):
    src = read_source(path) ?? ""
    # Games reach most of the game prelude. Avoid indexing/hashing it only to
    # load it all again. False positives merely choose eager loading; names
    # discovered later still work through ordinary demand loading.
    prelude_game_hint = declares_top(src, "update") or declares_top(src, "draw")
    # find a top-level `build:` line, then read its indented lines
    at = pkg_block_at(src)
    # (the packages it names: where they are, fetched if need be)
    pkg_specs = []
    pkg_dirs = {}
    pkg_errs = {}
    pkg_scan_at(pkg_specs, path, src, at)
    pkg_resolve_all(path)
    build_target = ""
    build_target_at = -1
    build_target_seen = false
    file_mode = ""
    file_mode_at = -1
    file_mode_seen = false
    settings_path = path
    if at >= 0: scan_build_lines(src, at)
    if ends_with(path, ".dewy"): scan_settings(src)
    mode = if len(cli_mode) > 0: cli_mode else if len(file_mode) > 0: file_mode else: "debug"
    opt_release = mode == "release"
    release_build = opt_release

# A Sloppy build block's indented `name = value` lines, from the `build:` line at at.
scan_build_lines = (src: str, at: int):
    i = find_byte(src, '\n', at)
    loop i >= 0 and i < len(src):
        j = find_byte(src, '\n', i + 1)
        if j < 0: j = len(src)
        line = src[i + 1..j)
        i = j
        t = trim(line)
        if len(t) == 0 or t[0] == '#': continue
        if line[0] != ' ' and line[0] != '\t': break
        eq = find(t, "=")
        if eq < 0: continue
        key = trim(t[..eq))
        val = trim(t[eq + 1..])
        h = find(val, "#")
        if h >= 0: val = trim(val[..h))
        if len(val) >= 2 and val[0] == '"': val = val[1..len(val) - 1)
        if key == "target": build_target = val
        else if key == "output": build_output = val
        else if key == "name": program_name = val
        else if key == "opt": file_mode = if val == "release": "release" else: "debug"

# A Dewy file's `$target = 'name'` and `$build.mode = 'name'` lines (at the start of a line,
# outside comments and multi-line strings, the value a string literal, then nothing but a
# comment). The parser checks each in place: dw_build_setting.
scan_settings = (src: str):
    if find(src, "$") < 0: return
    depth = 0                   # (inside `#{ ... }#`, nesting)
    i = 0
    loop i < len(src):
        c = src[i]
        if c == '#' and i + 1 < len(src) and src[i + 1] == 123:
            depth += 1
            i += 2
        else if depth > 0 and c == 125 and i + 1 < len(src) and src[i + 1] == '#':
            depth -= 1
            i += 2
        else if depth > 0: i += 1
        else if c == '#':
            loop i < len(src) and src[i] != '\n': i += 1
        else if c == '"' or c == '\'':
            # (a string: a triple-quoted one may span lines, any other ends with its line)
            if i + 2 < len(src) and src[i + 1] == c and src[i + 2] == c:
                e = find(src, src[i..i + 3), i + 3)
                i = if e < 0: len(src) else: e + 3
            else:
                i += 1
                loop i < len(src) and src[i] != c and src[i] != '\n':
                    if src[i] == '\\': i += 1
                    i += 1
                if i < len(src) and src[i] == c: i += 1
        else if c == '$' and (i == 0 or src[i - 1] == '\n'):
            scan_setting(src, i)
            i += 1
        else: i += 1

# The setting on the line starting at i, if it is one.
scan_setting = (src: str, i: int):
    j = find_byte(src, '\n', i)
    if j < 0: j = len(src)
    t = src[i..j)
    key = ""
    if starts_with(t, "$target"): key = "target"
    else if starts_with(t, "$build.mode"): key = "mode"
    if len(key) == 0: return
    k = if key == "target": 7 else: 11
    loop k < len(t) and (t[k] == ' ' or t[k] == '\t'): k += 1
    if k + 1 >= len(t) or t[k] != '=' or t[k + 1] == '=' or t[k + 1] == '?': return
    k += 1
    loop k < len(t) and (t[k] == ' ' or t[k] == '\t'): k += 1
    if k >= len(t) or (t[k] != '\'' and t[k] != '"'): return
    e = find_byte(t, t[k], k + 1)
    if e < 0: return
    val = t[k + 1..e)
    rest = trim(t[e + 1..])
    if len(rest) > 0 and rest[0] != '#': return
    # (the first of each: a second is an error the parser reports)
    if key == "target" and build_target_at < 0:
        build_target = val
        build_target_at = i
    else if key == "mode" and file_mode_at < 0:
        file_mode = val
        file_mode_at = i

lower_only = false      # (the language server: what lowering finds wrong, without code)
# the interactive prompt (repl.jo): the program's main is the session's server, and there is
# room after its globals for those later inputs declare
repl_image = false
bss_reserve = 0
img_text_addr = 0
img_ro_addr = 0
img_data_addr = 0

# (functions lowered, waiting for their machine code: emit_queued, after all are lowered, so
# that the code can be made on several processors)
emit_queue: IrFn[]
emit_queue_rel: bool[]          # (a release function still to version and LICM: rel_finish)
queue_emit = false

emit_function = ():
    if lower_only: return
    if queue_emit:
        emit_queue.push(ir)
        emit_queue_rel.push(false)
        return
    emit_now(false)

# a release build's last passes over a function, before its code is made
rel_finish = ():
    kc_fn += 1
    opt_ret_sink(ir.code, ir.vtypes, ir.fn_index)
    loop_versioning()
    ir.code = o_licm(ir.code)

emit_now = (finish: bool):
    icb = ic_phase(IC_OPT)
    if finish: rel_finish()
    else if not opt_release and not dbg_on:
        # Tiny leaves expand before the local pass; short array/float kernels
        # also get vectorization. Debug builds retain original local locations.
        kc_fn += 1
        if not watch_build and not repl_image: fast_inline_into()
        optimize()
        if not watch_build and not repl_image: fast_vectorize()
    ic_restore(icb)
    if host_ir:
        dump_host_ir()
        return
    if dump: dump_ir()
    if target_wasm: wasm_collect()
    else if target_arm64: arm64_function()
    else: x64_function()

# Versioned build-tool interchange, not a public program backend. Export after
# the ordinary scalar optimization passes; unknown operations fail in c_host.py.
dump_host_values = (name: str, values):
    # Explicit widening also works in the intentionally small C bootstrap.
    wide: int[]
    loop x in values: wide.push(int(x))
    print("{name} {wide}")

dump_host_ir = ():
    print("FN {ir.fn_index} {ir.nparams} {ir.ret} {ir.noinline}")
    print("NAME {ir.name}")
    dump_host_values("VT", ir.vtypes)
    dump_host_values("KV", ir.kval)
    dump_host_values("SS", ir.slot_size)
    dump_host_values("SA", ir.slot_align)
    dump_host_values("ARGS", ir.args)
    loop x in ir.code: print("I {x.op} {x.ty} {x.dst} {x.a} {x.b} {x.c} {x.imm}")
    print("END")

# release builds: optimize everything, inline small functions, optimize callers again, emit
release_pipeline = ():
    icb = ic_phase(IC_OPT)
    rt0 = time()
    loop k in [0..rel_fns.len()):
        ir = rel_fns[k]
        kc_fn += 1
        optimize()
        rel_fns[k] = ir
    rt1 = time()
    snap = rel_fns
    can = fill(0, snap.len())
    loop k in 0.. and f in snap: can[k] = inlinable(f)
    # callees before callers: a function is inlined with what it inlined itself (so whether it
    # is small enough is judged by what it finally is)
    loop k in callee_order(snap):
        ir = snap[k]
        kc_fn += 1
        if inline_into(k, snap, can):
            optimize()
            snap[k] = ir
            can[k] = inlinable(ir)
    rt2 = time()
    ic_restore(icb)
    loop k in [0..snap.len()):
        ir = snap[k]
        if queue_emit:
            # (versioned and LICM'd with its code: where code is made in parallel, there too)
            emit_queue.push(ir)
            emit_queue_rel.push(true)
            continue
        rel_finish()
        emit_function()
    rel_fns = []
    if env("DEWY_PAR_TIME") != none: eprint("release: optimize {(rt1 - rt0) * 1000.0:.1} ms, inline {(rt2 - rt1) * 1000.0:.1} ms, versioning and licm {(time() - rt2) * 1000.0:.1} ms")

# Inlining and constant folding can remove a lowered function's last caller.
# Keep entry points, exports, and functions reached by calls or stored addresses.
prune_emit_queue = (roots: int[]):
    by_index = fill(-1, lfuncs.len())
    loop k in 0.. and f in emit_queue: by_index[f.fn_index] = k
    live = fill(false, emit_queue.len())
    todo = roots
    loop f in emit_queue:
        if len(f.export_name) > 0: todo.push(f.fn_index)
    loop todo.len() > 0:
        lf = todo.pop()
        if lf < 0: continue
        k = by_index[lf]
        if k < 0 or live[k]: continue
        live[k] = true
        loop ins in emit_queue[k].code:
            if ins.op == .call or ins.op == .faddr or ins.op == .checked_add or ins.op == .checked_sub or ins.op == .checked_mul: todo.push(int(ins.imm))
    n = 0
    loop k in [0..emit_queue.len()):
        if not live[k]: continue
        emit_queue[n] = emit_queue[k]
        emit_queue_rel[n] = emit_queue_rel[k]
        n += 1
    emit_queue.truncate(n)
    emit_queue_rel.truncate(n)

# the machine code of the queued functions, in order
emit_queued = ():
    q = emit_queue
    fin = emit_queue_rel
    emit_queue = []
    emit_queue_rel = []
    queue_emit = false
    if fz_ready:
        fz_ready = false
        fz_emit(q)
        return
    if not opt_release and not dbg_on: fast_inline_prepare(q)
    if not host_ir and emit_parallel(q, fin): return
    t0 = time()
    loop k in 0.. and f in q:
        ir = f
        icb = ic_lf(IC_EMIT, f.fn_index)
        emit_now(fin[k])
        ic_restore(icb)
    if env("DEWY_PAR_TIME") != none: eprint("emit: here, {(time() - t0) * 1000.0:.1} ms")

# the functions in an order where each comes after the ones it calls (but in cycles)
callee_order = (fs: IrFn[]) -> int[]:
    n = fs.len()
    state = fill(0, n)              # 0 not seen, 1 on the path, 2 placed
    order: int[]
    stack: int[]
    next_ins: int[]                 # per stack entry: where to continue scanning its code
    loop r in [0..n):
        if state[r] != 0: continue
        stack.push(r)
        next_ins.push(0)
        state[r] = 1
        loop stack.len() > 0:
            top = stack.len() - 1
            k = stack[top]
            fc = fs[k].code
            i = next_ins[top]
            child = -1
            loop i < fc.len() and child < 0:
                ins = fc[i]
                i += 1
                if ins.op == .call and ins.c != 1 and ins.imm < rel_by_index.len():
                    j = rel_by_index[int(ins.imm)]
                    if j >= 0 and state[j] == 0: child = j
            next_ins[top] = i
            if child >= 0:
                state[child] = 1
                stack.push(child)
                next_ins.push(0)
            else:
                state[k] = 2
                order.push(k)
                stack.pop()
                next_ins.pop()
    order

# Count physical source lines, including comments and blank lines. Loaded
# library bodies may remain lazy, so this is input volume, not checked LOC.
source_counts = ():
    dewy_lines = 0
    dewy_bytes = 0
    impl_lines = 0
    impl_bytes = 0
    loop file in files:
        lines = 0
        loop byte in file.src:
            if byte == '\n': lines += 1
        if len(file.src) > 0 and file.src[len(file.src) - 1] != '\n': lines += 1
        if file.is_dewy:
            dewy_lines += lines
            dewy_bytes += len(file.src)
        else:
            impl_lines += lines
            impl_bytes += len(file.src)
    eprint("sources: {files.len()} files, {dewy_lines} Dewy lines ({dewy_bytes} bytes), {impl_lines} implementation lines ({impl_bytes} bytes)")

compile = (path: str, out0: str) -> str:
    if watch_build and not watch_first: late_binding = true
    t0 = time()
    if timing:
        pl_on = true
        ic_start()
    ra_stat = env("DEWY_RASTAT") != none
    ra_verbose = (env("DEWY_RASTAT") ?? "") == "v"
    if env("DEWY_RA_LINEAR") != none: ra_prio = false
    ra_dump = env("DEWY_RADUMP") ?? ""
    ra_only = env("DEWY_RA_ONLY") ?? ""
    scan_build_block(path)
    if lower_only: opt_release = false
    main_error_payloads = debug_vars
    setup_target()
    if host_ir:
        if target_wasm or target_arm64 or target_windows or watch_build or repl_image or lower_only:
            eprint("--host-ir requires a Linux x86-64 build")
            exit(2)
        opt_release = true
        print("DEWY_HOST_IR 1")
    # (debug information for variables: x86-64 and arm64 Linux, macOS, Windows)
    dbg_on = debug_vars and debug_info and not watch_build and not lower_only and not target_wasm
    out = out0
    if target_wasm and not ends_with(out, ".html") and not ends_with(out, ".zip"): out = out + ".html"
    if target_windows:
        if ends_with(out, ".bin"): out = out[..len(out) - 4)
        if not ends_with(out, ".exe"): out = out + ".exe"
    init_types()
    want_cpu_flag = (opt_release or not dbg_on and not watch_build and not repl_image) and not target_wasm and not target_arm64 and not lower_only
    want_loop_watch = target_wasm and not opt_release and not lower_only
    mulh_ok = not target_wasm
    rotate32_ok = not target_wasm and not target_arm64
    checked_flags = not target_wasm
    # (code made after lowering everything, except where code is patched in place as it is made)
    queue_emit = not watch_build and not repl_image and not lower_only
    check_program(path)
    if exit_codes_only:
        dc_flush_warnings()
        if errors_only: exit(error_exit)
        print_exit_codes()
        exit(0)
    dc_flush_warnings()
    # (a run for the errors after the first: no more to find, and nothing is built)
    if errors_only: exit(error_exit)
    if target_wasm and not program_named: web_save_name_check()
    # (functions left unchecked after errors in them cannot be lowered)
    if lower_only and ide_skip.len() > 0: return ""
    if lower_only: det_check_program()
    if repl_image: repl_set_main()
    ic_switch(IC_OWNERSHIP, IC_SHARED)
    isolation_reset()
    loans_finalize()
    arena_finalize()
    partition_finalize()
    ic_switch(IC_FACTS, IC_SHARED)
    # (a row excluding panics needs the program's deferred obligations named)
    if effect_panics_demanded: dir_force()
    pc_before_facts()
    facts_finalize()
    pc_after_facts()
    directives_after_facts()
    floats_after_facts()
    ic_switch(IC_EFFECTS, IC_SHARED)
    dir_panics_finalize()
    ic_switch(IC_OWNERSHIP, IC_SHARED)
    copies_reset()
    if ownership_decls.len() != 0:
        # Initialize thread bookkeeping before construction can acquire a resource.
        init_fns.insert(1, runtime_fn("__owner_start"))
    if concurrency_ffi_start != 0: init_fns.insert(1, concurrency_ffi_start)
    find_unique_globals(not watch_build and not repl_image and not lower_only)
    if not dbg_on and not watch_build and not repl_image and not lower_only: callback_prepare()
    t1 = time()
    ic_switch(IC_LOWER, IC_SHARED)
    roots: int[]
    loop f in init_fns: roots.push(lf_of_inst(f))
    # Source promises apply to checked bodies even when no caller reaches
    # them. The emitter still prunes unreachable code in ordinary builds.
    if copies_on:
        loop f in [1..fns.len()):
            body = int(fns[f].body)
            if body != 0 and (copy_strict(body) or ownership_functions.has(f)): lf_of_inst(f)
    # exports from user code are always kept; library exports only when their module is used
    exp_done = fill(false, export_fns.len())
    used_mods: {int: bool} = {}
    loop k in 0.. and f in export_fns:
        if not modules[int(fns[f].mod)].is_prelude:
            lf_of_inst(f)
            exp_done[k] = true
    main_lf = -1
    entry_fn = if main_entry_fn != 0: main_entry_fn else: main_fn
    if entry_fn != 0:
        main_lf = lf_of_inst(entry_fn)
        if prune(int(fns[entry_fn].ret)) == T_MATH_INT: main_lf = lf_helper(.math_main, T_MATH_INT, entry_fn)
    # (main = () -> int: its value is the exit code)
    main_code = entry_fn != 0 and is_int(prune(int(fns[entry_fn].ret)))
    main_exit_lf = -1
    if main_code and target_wasm: main_exit_lf = lf_of_inst(runtime_fn("exit"))
    # (after main: what print has collected, written out)
    entry_end_lf = -1
    if not target_wasm and not lower_only and not repl_image: entry_end_lf = lf_of_inst(runtime_fn("__end_flush"))
    pinit = init_fns[0]
    pinit_lf = roots[0]
    # (vectorized loops ask whether the processor has AVX2: the runtime finds out at start)
    lx_vec_on = want_cpu_flag and not host_ir
    if lx_vec_on:
        cs = prelude.get(intern("__cpu_avx2")) ?? 0
        if cs != 0 and syms[cs].kind == .global: global_addr_off(int(syms[cs].ref))
        else: lx_vec_on = false
    # (worker processes lower, optimize and emit most functions: fused.jo)
    fused_fork(pinit_lf)
    tlow = time()
    i = 0
    loop true:
        loop i < lfuncs.len():
            if i == pinit_lf:
                i += 1
                continue
            if lfuncs[i].kind == LK_INST:
                fd = int(fns[lfuncs[i].inst].decl)
                if fd != 0 and nodes[fd].mod != 0 or fd != 0:
                    fm = int(nodes[fd].mod)
                    if used_mods.get(fm) == none:
                        used_mods[fm] = true
                        loop k in 0.. and f in export_fns:
                            if not exp_done[k] and nodes[int(fns[f].decl)].mod == i32(fm):
                                exp_done[k] = true
                                lf_of_inst(f)
            if lfuncs[i].kind == LK_INST and fns[lfuncs[i].inst].decl != 0 and has_flag(int(fns[lfuncs[i].inst].decl), NF_EXTERN):
                fi = lfuncs[i].inst
                if target_wasm or lower_only:
                    i += 1
                    continue
                if len(fns[fi].clib) == 0: fatal(nodes[int(fns[fi].decl)].pos, "extern functions need @lib(\"library.so\") on native targets")
                extern_lib_check(fi)
                # (fused.jo's programs: no source position of its own, not one left by whichever
                # function came before)
                if fz_layout: ir_pos = 0
                lower_extern_thunk(i, fi)
                emit_function()
                i += 1
                continue
            if fz_ready and fz_replay(i):
                i += 1
                continue
            icb = ic_lf(IC_LOWER, i)
            lower_function(i)
            if opt_release: rel_collect()
            else: emit_function()
            ic_restore(icb)
            i += 1

        # library globals: initialize only the ones compiled code refers to (fixed point)
        nglob = global_off.len()
        decls: int[]
        loop g in global_ids:
            if not modules[int(globals[g].mod)].is_prelude or global_off.get(g) == none: continue
            d = int(globals[g].decl)
            if not decls.contains(d): decls.push(d)
        order_prelude_globals(decls)
        set_list(int(fns[pinit].body), decls)
        nl = lfuncs.len()
        lower_function(pinit_lf)
        if lfuncs.len() > nl or global_off.len() > nglob: continue
        if opt_release: rel_collect()
        else: emit_function()
        break
    if lower_only: return ""
    if env("DEWY_PAR_TIME") != none: eprint("lower: {(time() - tlow) * 1000.0:.1} ms here")
    if watch_build and not watch_first:
        watch_lower_inits()
        watch_lower_migrate()
    ic_switch(IC_EMIT, IC_SHARED)
    if opt_release: release_pipeline()
    if queue_emit:
        if opt_release and not watch_build and not repl_image:
            prune_emit_queue(roots + [main_lf, main_exit_lf, entry_end_lf])
        emit_queued()
    t2 = time()
    ic_switch(IC_OTHER, IC_SHARED)
    if host_ir:
        print("META {data_size} {main_lf} {main_code} {entry_end_lf} {mt_active_off}")
        dump_host_values("ROOTS", roots)
        dump_host_values("DATA", rodata)
        return ""
    ok = false
    size = 0
    if target_wasm:
        mod = wasm_module(roots, main_lf, -1)
        size = mod.len()
        ok = write_html(out, mod, program_name, program_icon)
    else if target_windows:
        x64_stubs()
        entry = x64_entry_win(roots, main_lf)
        text_rva, ro_rva, data_rva, idata_size = pe_layout(code.len(), rodata.len())
        img_text_addr = PE_BASE + text_rva
        img_ro_addr = PE_BASE + ro_rva
        img_data_addr = PE_BASE + data_rva + idata_size
        x64_resolve(img_text_addr, img_ro_addr, img_data_addr)
        # (sloppy watch: after the first build, a patch for the program running)
        if watch_build and not watch_first: ok = watch_make_patch()
        else:
            # (debuggers get a PDB beside what `sloppy build` writes)
            pdb = ""
            guid: u8[]
            if debug_info and not watch_build:
                pdb = strip_ext(out) + ".pdb"
                guid = pdb_guid(code)
            ok = write_pe(out, code, entry, rodata, data_size + 8 + bss_reserve, (update_fn != 0 or draw_fn != 0) and not test_mode, pe_backtrace_info(), program_icon, pdb_name(pdb), guid)
            if ok and len(pdb) > 0: ok = write_pdb(pdb, guid, code.len(), pe_section_headers, path, "dewy-core {DEWY_CORE_VERSION}")
            if ok and watch_build: watch_record_image()
        size = code.len()
    else if target_macos:
        arm64_stubs()
        entry = arm64_entry_mac(roots, main_lf)
        info = pe_backtrace_info()
        if watch_build and (update_fn != 0 or draw_present()):
            # (sloppy watch, a game: the code and read-only data run from a region of their own,
            # copied there by a loader, macho.jo; after the first build, a patch for the game)
            ro_at = (code.len() + 15) & ~15
            blob_len = (ro_at + rodata.len() + 7) & ~7
            loader_len = macho_watch_loader(0, 0, 0, 0).len()
            text_off, ro_off, info_off, text_size = macho_layout(loader_len, blob_len, info.len())
            img_text_addr = MACHO_WATCH_CODE
            img_ro_addr = MACHO_WATCH_CODE + ro_at
            img_data_addr = MACHO_BASE + text_size
            arm64_resolve(img_text_addr, img_ro_addr, img_data_addr)
            if not watch_first: ok = watch_make_patch()
            else:
                blob = code
                loop blob.len() < ro_at: blob.push(0)
                loop b in rodata: blob.push(b)
                loop blob.len() < blob_len: blob.push(0)
                loader = macho_watch_loader(img_data_addr, MACHO_BASE + ro_off, blob_len, entry)
                elf_syms = []
                ok = write_macho(out, loader, 0, blob, info, data_size + 8 + bss_reserve, program_name, true)
                if ok: watch_record_image()
        else:
            text_off, ro_off, info_off, text_size = macho_layout(code.len(), rodata.len(), info.len())
            img_text_addr = MACHO_BASE + text_off
            img_ro_addr = MACHO_BASE + ro_off
            img_data_addr = MACHO_BASE + text_size
            arm64_resolve(img_text_addr, img_ro_addr, img_data_addr)
            macho_dwarf = []
            # (with -g only: the same compiler, built on Linux and on a Mac, is the same bytes, with
            # no paths of either in it)
            dw_data_addr = img_data_addr
            if debug_vars and not watch_build: macho_dwarf = dwarf_sections(img_text_addr, code.len(), path, DEWY_CORE_VERSION)
            mac_out = out
            if ends_with(out, ".app") and not watch_build:
                mac_out = macos_bundle(out, program_name, program_icon)
                if len(mac_out) == 0: fatal(0, "cannot make the app bundle {out}")
            ok = write_macho(mac_out, code, entry, rodata, info, data_size + 8 + bss_reserve, program_name, false)
            if ok and watch_build: watch_record_image()
        size = code.len()
    else if target_arm64:
        elf_machine = 183
        elf_page = 0x10000
        arm64_stubs()
        entry = arm64_entry(roots, main_lf)
        text_off, ro_off, data_off = elf_layout(code.len(), rodata.len())
        img_text_addr = ELF_BASE + text_off
        img_ro_addr = ELF_BASE + ro_off
        img_data_addr = ELF_BASE + data_off
        arm64_resolve(img_text_addr, img_ro_addr, img_data_addr)
        # (sloppy watch: after the first build, a patch for the program running)
        if watch_build and not watch_first: ok = watch_make_patch()
        else:
            elf_extra = [(".dewy_lines", x64_line_table())]
            # (with -g only, as on macOS)
            dw_data_addr = img_data_addr
            if debug_vars: elf_extra = elf_extra + dwarf_sections(img_text_addr, code.len(), path, DEWY_CORE_VERSION)
            ok = write_elf(out, code, entry, rodata, data_size + 8 + bss_reserve)
            if ok and watch_build: watch_record_image()
        size = code.len()
    else:
        x64_stubs()
        entry = x64_entry(roots, main_lf)
        text_off, ro_off, data_off = elf_layout(code.len(), rodata.len())
        img_text_addr = ELF_BASE + text_off
        img_ro_addr = ELF_BASE + ro_off
        img_data_addr = ELF_BASE + data_off
        x64_resolve(img_text_addr, img_ro_addr, img_data_addr)
        # (sloppy watch: after the first build, a patch for the program running)
        if watch_build and not watch_first: ok = watch_make_patch()
        else:
            # (backtraces always; debuggers and profilers get DWARF in what `sloppy build` writes)
            elf_extra = [(".dewy_lines", x64_line_table())]
            dw_data_addr = img_data_addr
            if debug_info: elf_extra = elf_extra + dwarf_sections(img_text_addr, code.len(), path, DEWY_CORE_VERSION)
            ok = write_elf(out, code, entry, rodata, data_size + 8 + bss_reserve)
            if ok and watch_build: watch_record_image()
        size = code.len()
    t3 = time()
    if ra_stat: eprint("regalloc: spill cost {ra_spill_cost}, save cost {ra_save_cost} (int) {ra_save_x} (float), of {ra_total} weighted accesses\n")
    if timing:
        eprint("check {(t1 - t0) * 1000.0:.1} ms, lower+codegen {(t2 - t1) * 1000.0:.1} ms, write {(t3 - t2) * 1000.0:.1} ms; {lfuncs.len()} functions, {nodes.len()} nodes, {size} bytes of code")
        ic_report()
        ic_lines_report()
        source_counts()
    if not ok:
        # (a patch for sloppy watch tells its own trouble)
        if not watch_build or watch_first: eprint("error: cannot write {out} (a directory there, or no permission?)")
        return ""
    out

open_in_browser = (path: str) -> bool:
    when TARGET == "windows":
        return spawn_detached("C:\\Windows\\System32\\cmd.exe", ["cmd", "/c", "start", "", path])
    else:
        return spawn_detached("/usr/bin/xdg-open", ["xdg-open", path])

# `dewy-core --internal-fact-policy=require-static check ...`: the test tools' fact policy
# (facts.jo), right after the program's name, where no command or program argument goes
internal_options = (a: str[]) -> str[]:
    if a.len() > 2 and starts_with(a[1], "--internal-fact-policy="):
        fact_internal_policy = a[1][len("--internal-fact-policy=")..]
        return [a[0]] + a[2..]
    if a.len() > 2 and a[1] == "--internal-collide-locals":
        collide_locals = true
        return internal_options([a[0]] + a[2..])
    a

main = ():
    __copies_min = 0       # (DEWY_COPIES is for the program it runs, not the compiler's own copies)
    a = args()
    if a.len() > 2 and a[1] == "--eager-bodies":
        dc_eager = true
        a = [a[0]] + a[2..]
    a = internal_options(a)
    if a.len() >= 2 and (a[1] == "--version" or a[1] == "version"):
        print("dewy-core {DEWY_CORE_VERSION}")
        return
    if a.len() >= 2 and (a[1] == "--help" or a[1] == "help" or a[1] == "-h"): usage(0)
    # (sloppy build --help: the commands' options, not a file named --help; a program's own
    # arguments, as in `sloppy game.jo --help`, stay its)
    if a.len() >= 3 and (a[1] == "build" or a[1] == "check" or a[1] == "test" or a[1] == "fmt" or a[1] == "new" or a[1] == "watch"):
        hi = 2
        loop hi < a.len():
            if a[hi] == "--help" or a[hi] == "-h": usage(0)
            hi += 1
    if a.len() >= 2 and (a[1] == "update" or a[1] == "upgrade"):
        eprint("dewy-core: update this toolchain by rebuilding from the Dewy repository; see docs/DEVELOPMENT.md")
        exit(2)
    if a.len() >= 2 and a[1] == "add":
        eprint("dewy-core: '{a[1]}' is not yet available for Dewy; see docs/DEVELOPMENT.md")
        exit(2)
    # (the next errors after one in a function: next_error_run, ide.jo)
    if a.len() > 3 and a[1] == "--skip-fns":
        loop s in split(a[2], ","):
            c = find(s, ":")
            # (w and a warning's place and length: shown by the run before)
            if len(s) > 0 and s[0] == 'w': shown_warnings.push(s)
            else if c > 0:
                err_skips.push(s)
                ide_skip[mkpos(to_int(s[..c)) ?? 0, to_int(s[c + 1..]) ?? 0)] = true
        errors_only = true
        rest = [a[0]]
        loop i in [3..a.len()): rest.push(a[i])
        a = rest
    if a.len() > 2 and a[1] == "--eager-bodies":
        dc_eager = true
        a = [a[0]] + a[2..]
    a = internal_options(a)
    if a.len() >= 2 and (a[1] == "build" or a[1] == "check" or a[1] == "test" or a[1] == "run" or ends_with(a[1], ".jo") or ends_with(a[1], ".dewy")): more_errors = true
    lib_dir = find_lib_dir()
    lib_root = lib_dir
    if a.len() >= 2 and a[1] == "--print-lib":
        if a.len() != 2: usage(2)
        print(lib_dir)
        return
    # (sloppy watch on Windows: each build in a process of its own: watch.jo, w32_compile)
    when TARGET == "windows":
        if a.len() >= 8 and a[1] == "watch" and a[2] == "--build":
            if a.len() > 8: test_mode = a[8] == "1"
            if a.len() > 9: cli_mode = if a[9] == "1": "release" else if a[9] == "d": "debug" else: ""
            watch_build_child(a[3], a[4], a[5], a[6] == "1", a[7])
            return
    # no file: the interactive prompt at a terminal, else the program on standard input
    if a.len() < 2:
        if stdin_is_terminal():
            repl_main()
            return
        run_stdin()
        return
    if a[1] == "build":
        if a.len() < 3: usage()
        debug_info = true
        path = ""
        out = ""
        i = 2
        loop i < a.len():
            x = a[i]
            if x == "-o" and i + 1 < a.len():
                out = a[i + 1]
                i += 1
            else if x == "--target" and i + 1 < a.len():
                cli_target = a[i + 1]
                i += 1
            else if x == "--ir": dump = true
            else if x == "--host-ir": host_ir = true
            else if x == "-g": debug_vars = true
            else if x == "--release" or x == "--debug": cli_mode = x[2..]
            else if x == "--time": timing = true
            else if x == "--exit-codes": exit_codes_only = true
            else if starts_with(x, "-") or starts_with(x, "$"): cli_option_refused(x)
            else: path = os_path(x)
            i += 1
        if len(path) == 0: usage()
        scan_build_block(path)
        if len(out) == 0 and len(build_output) > 0:
            # (the build block's output: beside the program, unless it is a full path)
            out = os_path(build_output)
            s = rfind(path, "/")
            if not is_abs_path(out) and s >= 0: out = path[..s + 1) + out
        if len(out) == 0:
            out = path
            out = strip_ext(out)
            if out == path: out = path + ".bin"     # (no extension: not over the source)
        # (-o game.zip, -o game.html, -o game.exe: what is asked for, without --target or a
        # `$target` in the file)
        if len(cli_target) == 0 and len(build_target) == 0:
            if ends_with(out, ".html") or ends_with(out, ".zip"): cli_target = "wasm32"
            else if ends_with(out, ".exe"): cli_target = "x86_64-windows"
        # (-o dist/game.zip: the directory made if it is not there)
        sl = max(rfind(out, "/"), rfind(out, "\\"))
        if sl > 0: make_dirs(out[..sl))
        made = compile(path, out)
        if host_ir: return
        if len(made) == 0: exit(1)
        # (where it is, said at a terminal: a script that builds gets no line it did not ask for)
        if is_terminal(): print("made {made}")
        return
    if a[1] == "lsp":
        lsp_main()
        return
    if a[1] == "new":
        new_project(lib_dir, a)
        return
    if a[1] == "fmt":
        fmt_main(a)
        return
    if a[1] == "add":
        pkg_add_main(a)
        return
    # (building and running fetch the packages a program names; the language server does not)
    pkg_fetch = true
    if a[1] == "check":
        # type check only
        if a.len() > 3 and a[2] == "--obligations":
            dir_obligations = true
            a = [a[0], a[1]] + a[3..]
        else if a.len() > 3 and a[3] == "--obligations":
            dir_obligations = true
            a = [a[0], a[1], a[2]] + a[4..]
        if a.len() < 3: usage()
        if let s = env("DEWY_STOP"): stop_after = s
        path = os_path(a[2])
        # (the test blocks are checked too, as sloppy test would)
        test_mode = true
        check_all = true
        if len(stop_after) > 0:
            scan_build_block(path)
            setup_target()
            init_types()
            check_program(path)
            dc_flush_warnings()
            if errors_only: exit(error_exit)
            return
        # (and lowered without making code: some errors are found there, as a `loop mut` that
        # resizes its array, a data race, a shader's)
        lower_only = true
        compile(path, "")
        if errors_only: exit(error_exit)
        if dir_obligations: dir_print_obligations()
        return
    first = 1
    test_watch = false
    test_json = false
    if a[1] == "run": first = 2          # (sloppy run game.jo is sloppy game.jo)
    if a[1] == "test":
        test_mode = true
        error_exit = 102
        first = 2
    # options for running come before the file (what follows it goes to the program)
    loop first < a.len() and starts_with(a[first], "--"):
        x = a[first]
        if x == "--web": cli_target = "wasm32"
        else if x == "--release" or x == "--debug": cli_mode = x[2..]
        else if x == "--watch" and test_mode: test_watch = true
        else if x == "--json" and test_mode: test_json = true
        else if x == "--time": timing = true
        else if x == "--target" and first + 1 < a.len():
            cli_target = a[first + 1]
            first += 1
        else: cli_option_refused(x)
        first += 1
    if first < a.len() and starts_with(a[first], "$"): cli_option_refused(a[first])
    # (`dewy test` with no path tests the current directory)
    if first >= a.len() and test_mode: a.push(".")
    # (options and no file: the program on standard input; at a terminal there is none to run)
    if first >= a.len() and a[1] != "run" and not stdin_is_terminal():
        run_stdin()
        return
    if first >= a.len(): usage()
    if a[first] == "watch" or test_watch:
        if not test_watch: first += 1
        if a.len() <= first: usage()
        if cli_target == "wasm32" and not test_mode: fatal(0, "dewy-core watch runs programs natively (for the web, use dewy-core build --target wasm32)")
        native_only = true
        wargs: str[]
        loop i in [first + 1..a.len()): wargs.push(a[i])
        watch_main(os_path(a[first]), wargs)
        return
    if a[first] == "test":
        if a.len() < first + 2: usage()
        test_mode = true
        error_exit = 102
        first += 1
    if test_mode: native_only = true  # tests run natively even for web games
    when TARGET == "windows":
        if test_mode: __test_process_group()
    path = os_path(a[first])
    if test_mode and is_dir(path):
        words: str[]
        loop i in [first + 1..a.len()): words.push(a[i])
        exit(test_directory(path, words, test_json))
    if not file_exists(path) and not ends_with(path, ".jo") and not ends_with(path, ".dewy") and find(path, "/") < 0:
        near = ""
        loop c in ["run", "build", "watch", "test", "check", "fmt", "add", "new", "lsp", "update", "help", "version"]:
            lim = 2
            if len(c) <= 3: lim = 1
            if edit_distance(a[first], c, lim) <= lim and len(near) == 0: near = " (did you mean 'dewy-core {c}'?)"
        if len(near) == 0: near = " (dewy-core help lists them; a program runs with dewy-core game.dewy)"
        eprint("dewy-core: unknown command '{a[first]}'{near}")
        exit(1)
    base = path_stem(path)
    if test_mode: base = base + ".test"
    # (one program per path: two main.jo in two directories, run at once, are two programs)
    full = path
    if len(full) == 0 or (full[0] != '/' and find(full, ":") < 0): full = os_path(cwd()) + "/" + path
    # (args()[0] is the program as it was named: the source file)
    run_args = [path]
    if test_json: run_args.push("--json")
    loop i in [first + 1..a.len()): run_args.push(a[i])
    build_and_exec(path, base, full, run_args)

# dewy-core with no file and input that is not a terminal: the program on standard input, read
# whole, as a file named <stdin> in the current directory (its `use`s are relative to it)
run_stdin = ():
    pkg_fetch = true
    more_errors = true
    buf: u8[]
    loop true:
        n = buf.len()
        buf.resize(n + 65536)
        r = __read_fd(0, data(buf) + n, 65536)
        if r <= 0:
            buf.resize(n)
            break
        buf.resize(n + r)
    text = str_from_bytes(buf)
    path = "<stdin>.dewy"
    ide_texts[path_norm(path)] = text
    full = os_path(cwd()) + "/" + path
    build_and_exec(path, "stdin", full + "\n" + text, [path])

# standard input is a terminal (not a file or a pipe)
stdin_is_terminal = () -> bool:
    when TARGET == "windows":
        m: u32[] = [0]
        return GetConsoleMode(GetStdHandle(u32(0xFFFFFFF6)), data(m)) != 0
    else:
        t = fill(u8(0), 64)
        return syscall(16, 0, 0x5401, data(t)) == 0

# build the program at path into the run cache (named base, its key hashed into the name) and
# run it with run_args
build_and_exec = (path: str, base: str, key: str, run_args: str[]):
    cache = core_cache()
    name = "{base}-{path_hash(key)}"
    if (time_ns() / 1000) % 64 == 0: clean_cache(cache)
    out = "{cache}/{name}.bin"
    # (made beside it, then put in its place: a copy of the program still running is not
    # written over; Windows cannot replace a running program, so there it is written in place)
    tmp = out
    if not target_windows and not target_wasm and cli_target != "wasm32" and cli_target != "x86_64-windows": tmp = "{cache}/{name}.{time_ns()}.new"
    built = compile(path, tmp)
    if len(built) == 0: exit(error_exit)
    if built == tmp and tmp != out and not target_wasm:
        if rename_file(tmp, out): built = out
    if target_wasm:
        # open the page in the default browser, detached (the browser's output does not
        # reach this terminal, and sloppy returns at once)
        if open_in_browser(built): eprint("dewy-core: opened {built} in the browser")
        else: eprint("dewy-core: built {built}; open it in a browser")
        exit(0)
    exec(built, run_args)
    eprint("dewy-core: failed to run {built}")
    exit(1)

# dewy-core test directory: each .dewy file under it with a line starting `$test` (not in hidden
# directories or __dewycache__) tested in a process of its own, one line per file, then the
# failures' output and the counts. The status is the failures (at most 100), or 101 when a test
# aborted, 102 when a file did not build.
test_directory = (dir: str, words: str[], json: bool) -> int:
    files: str[]
    test_files(dir, files)
    files.sort()
    passed = 0
    failed = 0
    aborted = false
    broken = false
    failures: str[]
    doc = JsonDoc([])
    loop f in files:
        args = ["test"]
        if len(cli_mode) > 0: args.push("--{cli_mode}")
        args = args + ["--json", f] + words
        ran = run_program(exe_path(), args)
        marks = ""
        filed = 0
        ran_tests = 0
        loop line in split(ran.1, "\n"):
            if len(line) == 0: continue
            root = json_parse(doc, line)
            named = json_get(doc, root, "test")
            if named == 0:
                # (the file's summary: none when its tests' names do not match the words)
                if json and ran_tests > 0: print(line[..len(line) - 1) + ",\"file\":{json_quote(f)}\}")
                continue
            ran_tests += 1
            if json: print(line)
            status = json_str(doc, json_get(doc, root, "status"))
            if status == "pass":
                passed += 1
                marks += "."
            else:
                failed += 1
                filed += 1
                marks += "F"
                failures.push("{f}: {json_str(doc, named)}")
                failures.push(json_str(doc, json_get(doc, root, "output")))
        if ran.0 == 101: aborted = true
        if ran.0 == 102 or ran.0 < 0:
            broken = true
            marks += "(did not build)"
        else if ran_tests == 0: continue
        if not json: print("{f} {marks}")
    if passed + failed == 0 and not broken:
        if words.len() > 0: eprint("no test's name under {dir} has any of {join(words, ", ")} in it")
        else: eprint("no tests under {dir}: a test is a function marked `$test` on the line before it")
        return 1
    status = min(failed, 100)
    if aborted: status = 101
    if broken: status = 102
    if json:
        print("\{\"passed\":{passed},\"failed\":{failed},\"files\":{files.len()},\"exit\":{status}\}")
        return status
    i = 0
    loop i + 1 < failures.len():
        print("--- FAIL {failures[i]}")
        write(failures[i + 1])
        if len(failures[i + 1]) > 0 and not ends_with(failures[i + 1], "\n"): print("")
        i += 2
    summary = "{passed} passed"
    if failed > 0: summary = "{failed} failed, " + summary
    print(summary)
    status

test_files = (dir: str, found: mut str[]):
    loop name in list_dir(dir):
        if starts_with(name, ".") or name == "__dewycache__": continue
        p = "{dir}/{name}"
        if is_dir(p): test_files(p, found)
        else if ends_with(name, ".dewy"):
            if let text = read_file(p):
                loop line in split(text, "\n"):
                    if starts_with(line, "$test"):
                        found.push(p)
                        break

# (@lib("libc.so.6") in a Windows build: the program fails when it calls the function)
extern_lib_check = (fi: int):
    d = int(fns[fi].decl)
    if pos_in_lib(nodes[d].pos): return
    cl = fns[fi].clib
    lc = lower(cl)
    other = ""
    if target_windows and (find(lc, ".so") >= 0 or ends_with(lc, ".dylib")): other = "a Windows program loads DLLs (msvcrt.dll has the C library)"
    else if not target_windows and ends_with(lc, ".dll"): other = "a Linux or macOS program loads .so or .dylib libraries"
    else if target_macos and find(lc, ".so") >= 0: other = "a macOS program loads .dylib libraries (/usr/lib/libSystem.B.dylib has the C library)"
    else if not target_macos and not target_windows and ends_with(lc, ".dylib"): other = "a Linux program loads .so libraries (libc.so.6 has the C library)"
    if len(other) > 0: warn(nodes[d].pos, "{jd(nodes[d].pos, "@lib(\"{cl}\")", "lib='{cl}'")} is another system's library: {other}; {jd(nodes[d].pos, "`when TARGET == \"windows\":` gives each system its own @lib", "`if $target.os =? \"windows\" \{...}` gives each system its own declaration")} (as it is, the program stops when it calls {name_of(int(nodes[d].name))})")

# programs left in the run cache: those not run for a week go (and half-made ones of crashed
# builds); past 500 MB, the oldest go until it is half that
clean_cache = (cache: str):
    # (now, as the file system tells time: a file just written)
    write_file(cache + "/.now", "")
    now = file_time(cache + "/.now") ?? 0.0
    if now == 0.0: return
    kept: (f64, str, int)[]
    total = 0
    loop f in list_dir(cache):
        p = cache + "/" + f
        if let t = file_time(p):
            if now - t > 7.0 * 86400.0 or (ends_with(f, ".new") and now - t > 3600.0): delete_file(p)
            else if f != ".now":
                n = file_size(p) ?? 0
                kept.push((t, p, n))
                total += n
    if total <= 500 << 20: return
    kept.sort_by((k): k.0)
    loop k in kept:
        if total <= 250 << 20: break
        if delete_file(k.1): total -= k.2

# (a web page that saves, with no name in its build block: pages on one site, as itch.io's,
# share their browser's storage, and every game.jo would read and write the others' saves)
web_save_name_check = ():
    loop fi in [1..fns.len()):
        d = int(fns[fi].decl)
        if fns[fi].state != 2 or d == 0 or not pos_in_lib(nodes[d].pos): continue
        nm = name_of(int(nodes[d].name))
        if nm == "save_data" or nm == "save_value":
            at = -1
            hint = "give it a name of its own: `build:` and `name = \"Drone Arena\"` below it"
            loop m in modules:
                if m.is_main:
                    at = mkpos(int(m.file), 0)
                    if files[int(m.file)].is_dewy: hint = "choose a distinct .dewy source filename before publishing, and keep it the same for native and web builds"
            warn(at, "this web page saves under the name '{program_name}' (its file's): pages on one site, as itch.io's, share their storage, so {hint}")
            return

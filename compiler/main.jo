use 'formatter_cli.dewy'

const DEWY_CORE_VERSION = "0.0.0-dev"

dump = false
host_ir = false                # scalar IR for the optional optimized compiler-host build
debug_info = false            # DWARF line tables (dewy build)
debug_vars = false            # and where variables are, with their types (dewy build -g)
exit_codes_only = false          # (dewy build --exit-codes: main's exit codes, and nothing built)
timing = false

# build options written in the program itself:
#   build:
#       target = wasm32
#       output = "game"
build_output = ""

lower_only = false      # (the language server: what lowering finds wrong, without code)
# the interactive prompt (repl.jo): the program's main is the session's server, and there is
# room after its globals for those later inputs declare
repl_image = false
bss_reserve = 0
img_text_addr = 0
img_ro_addr = 0
img_data_addr = 0

driver_context = DriverState(&ir, &kc_fn, &rel_fns, &rel_by_index, &lower_only, &opt_release, &dbg_on, &watch_build, &repl_image, &host_ir, &dump, &target_wasm, &target_arm64, &fz_ready)
driver_version = (): loop_versioning()
driver_services = DriverHost(optimize, fast_inline_into, fast_vectorize, driver_version, o_licm, dump_host_ir, dump_ir, wasm_collect, arm64_function, x64_function, inlinable, inline_into, fast_inline_prepare, emit_parallel, fz_emit, ic_phase, ic_lf, ic_restore, time, driver_release_timing, driver_emit_timing)
driver_binding = driver_bind(&driver_context, &driver_services)

use 'lexer_scan.dewy'

use 'driver_timing.dewy'

use 'driver_options.dewy'

use 'driver_dispatch.dewy'

use 'driver_commands.dewy'

use 'driver_check.dewy'

use 'host_ir_values.dewy'

use 'witness_nodes.dewy'

use 'warn_if_facts.dewy'

use 'rational_types.dewy'

use 'driver_entry.dewy'
main = ():
    driver_main()

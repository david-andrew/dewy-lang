use 'dewy_context.jo'
# `build --time`'s instruction split: user-space instructions this process
# retires, by phase and by whose code the work is for (the program's own,
# the library's, or neither). Linux x86-64 only; off unless --time asks.
use 'check.jo'
use 'lower.jo'
use 'util.jo'
use 'ast.jo'
use 'lazy_bodies.jo'

const IC_LOAD = 0
const IC_CHECK = 1
const IC_FACTS = 2
const IC_EFFECTS = 3
const IC_OWNERSHIP = 4
const IC_LOWER = 5
const IC_OPT = 6
const IC_EMIT = 7
const IC_OTHER = 8
const IC_PHASES = 9
const IC_SHARED = 0
const IC_ROOT = 1
const IC_LIB = 2

ic_on = false
ic_fd = -1
ic_last = 0
ic_bucket = IC_OTHER * 3
ic_counts: int[]

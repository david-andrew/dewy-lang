$runtime_checks
from p"ast.jo" import (NF_COMPREHENSION NF_INCLUSIVE NF_STEP has_flag kid kid2 nkids nkids2 nodes)
from p"check.jo" import (locals)
from p"checker_tokens.dewy" import (Tok)
from p"directives.jo" import (dir_index)
from p"effect_types.dewy" import (PlaceIdentity)
from p"expr.jo" import (CV IN integer_constant ntype)
from p"facts.jo" import (FACT_CAP FACT_ELEMENT_BELOW FACT_ELEMENT_COPY FACT_ELEMENT_LENGTH FACT_ELEMENT_SAME_LENGTH FACT_ELEMENT_SOURCE FACT_ELEMENT_VALUE FACT_FIELD_KEYS FACT_KEYS_SOURCE FACT_KEY_SOURCE FactDifference FactProjection FactState fact_add_fits fact_add_projection fact_assume fact_bind fact_binding fact_bound fact_capture fact_compare fact_component_bounds fact_component_selector fact_constant fact_difference fact_difference_head fact_difference_next fact_distance fact_domain fact_exposed fact_fresh fact_hull_owner fact_int_components fact_new fact_open_endpoint fact_owner fact_policy fact_probe_on fact_project fact_projection_after fact_projection_find fact_projection_first fact_push_frames fact_query fact_row_bounds fact_scalar fact_set_bound fact_speculating fact_terms fact_type fact_validated)
from p"facts_ranges.dewy" import (fact_host_endpoint fact_range_exhaustion fact_step_check)
from p"facts_changes.dewy" import (fact_changes fact_partial_opaque)
from p"facts_conditions.dewy" import (fact_implication)
from p"facts_joins.dewy" import (fact_hull fact_known_none)
from p"facts_loops.dewy" import (fact_loop_body)
from p"facts_maps.dewy" import (fact_keys_element)
from p"facts_probes.dewy" import (fact_probe_record)
from p"facts_pushes.dewy" import (fact_mentions)
from p"facts_summaries.dewy" import (fact_summary_payload)
from p"isolation_ops.dewy" import (isolation_children)
from p"lower_views.dewy" import (comprehension_value)
from p"ownership.jo" import (ownership_decls)
from p"ownership_types.dewy" import (ownership_fact_type ownership_type)
from p"refine.jo" import (representation_type)
from p"refinement_types.dewy" import (FACT_MAX FACT_MIN FactBound FactTerm)
from p"types.jo" import (T_BOOL T_INT T_MATH_INT T_STR fields fixed_len is_managed structs targ telem tkind type_eq types)
from p"util.jo" import (fatal files pos_file)
from p"witness.jo" import (wit_text wit_unknown)

ElementWord:type=int64<overflow='wrap'>
# Optional/union coercions wrap an already requested boundary in place.
# Follow just that value spine, as ref_wrapped_check does for refinements.
fact_fixed_node=(n0:ElementWord):>ElementWord=>$unsafe {
    let n=n0
    loop depth in [0..32) {
        if nodes.ptr[n].kind =? 'conv' and nodes.ptr[n].aux =? int32(int64(CV.arr2fixed)) {return n}
        if nodes.ptr[n].kind =? 'conv' and nodes.ptr[n].a not=? 0 {n=ElementWord(nodes.ptr[n].a)}
        else if nodes.ptr[n].kind =? 'call' and nodes.ptr[n].aux =? 3 and nkids(n) =? 1 {n=kid(n 0)}
        else {break}
    }
    fatal(nodes.ptr[n0].pos "cannot locate fixed-size array conversion after wrapping")
    n0
}
# A dynamic-to-fixed conversion has one length equality obligation. Demand
# only its operand and existing length projection; O(1) lookup plus the bounded
# difference query. Every analyzed visit must prove it to erase the check.
fact_fixed_check=(n:ElementWord @s:FactState value:ElementWord):>void=>$unsafe {
    if fact_speculating not=? 0 or not s.live {return}
    let count=fixed_len(representation_type(ntype(n)))
    let length:ElementWord=0
    let proven=false
    if value not=? 0 {
        length=fact_project(@s value (-1) false T_INT)
        let expected=fact_constant(@s count)
        proven=fact_compare(s 'eq' length expected) =? 1
    }
    if fact_probe_on {
        fact_probe_record(n proven)
        return
    }
    fact_validated[n]=true
    dir_index(n proven)
    if not proven and (fact_policy =? 'RequireStatic' or fact_query) {
        let shown=wit_text(ElementWord(nodes.ptr[n].a))
        if shown =? "" {shown="the array"}
        wit_unknown(n fact_bound(s length) "fixed-size array conversion needs {count} elements" 0 "{shown}.length =? {count}")
    }
}
# A comprehension that fills a fixed-size array of plain elements in place:
# `let acc=[]`, one range or array loop whose body is straight-line
# declarations ending in one push onto acc, then acc. Its push, or 0.
fact_fixed_comprehension=(b:ElementWord to:ElementWord):>ElementWord=>$unsafe {
    if nodes.ptr[b].kind not=? 'block' or not has_flag(b NF_COMPREHENSION) or nkids(b) not=? 3 or not files[pos_file(nodes.ptr[b].pos)].is_dewy {return 0}
    let t=fact_type(to)
    if tkind(t) not=? 'fixed' or is_managed(ElementWord(types.ptr[t].elem)) or ownership_type(ElementWord(types.ptr[t].elem)) {return 0}
    let decl=kid(b 0)
    let loop_=kid(b 1)
    let last=kid(b 2)
    if nodes.ptr[decl].kind not=? 'vardecl' or nodes.ptr[decl].sym <=? 0 or nkids(decl) not=? 0 or nodes.ptr[loop_].kind not=? 'for_' or nodes.ptr[last].kind not=? 'exprstmt' {return 0}
    let acc=ElementWord(nodes.ptr[decl].sym)
    let init=ElementWord(nodes.ptr[decl].b)
    if init =? 0 or nodes.ptr[init].kind not=? 'array' or nkids(init) not=? 0 or nodes.ptr[init].b not=? 0 {return 0}
    if not type_eq(telem(ElementWord(locals.ptr[acc].type)) ElementWord(types.ptr[t].elem)) {return 0}
    let result=ElementWord(nodes.ptr[last].a)
    if nodes.ptr[result].kind not=? 'ident' or nodes.ptr[result].sym not=? int32(acc) {return 0}
    if nodes.ptr[loop_].aux =? 0 {
        let it=ElementWord(nodes.ptr[loop_].a)
        if nodes.ptr[it].kind not=? 'range' or nodes.ptr[it].b =? 0 or has_flag(it NF_STEP) {return 0}
    }
    else if nodes.ptr[loop_].aux =? 1 {
        let k=tkind(ntype(ElementWord(nodes.ptr[loop_].a)))
        if k not=? 'array' and k not=? 'fixed' {return 0}
    }
    else {return 0}
    if fact_mentions(ElementWord(nodes.ptr[loop_].a) acc) {return 0}
    let body=ElementWord(nodes.ptr[loop_].b)
    let nb=nkids(body)
    if nb =? 0 or nodes.ptr[kid(body nb - 1)].kind not=? 'exprstmt' {return 0}
    loop i in [0..nb - 1) {
        let item=kid(body i)
        if nodes.ptr[item].kind not=? 'vardecl' or not comprehension_value(ElementWord(nodes.ptr[item].b)) or fact_mentions(ElementWord(nodes.ptr[item].b) acc) {return 0}
    }
    let push=ElementWord(nodes.ptr[kid(body nb - 1)].a)
    if nodes.ptr[push].kind not=? 'intrinsic' or nodes.ptr[push].aux not=? int32(int64(IN.push)) or nkids(push) not=? 2 {return 0}
    let receiver=kid(push 0)
    if nodes.ptr[receiver].kind not=? 'ident' or nodes.ptr[receiver].sym not=? int32(acc) or not comprehension_value(kid(push 1)) or fact_mentions(kid(push 1) acc) {return 0}
    push
}
# Its loop runs exactly the fixed length's times: a range from 0 to that
# constant, or an array loop over a fixed array of that length.
fact_fixed_comprehension_exact=(b:ElementWord to:ElementWord):>bool=>$unsafe {
    let n=fixed_len(fact_type(to))
    let loop_=kid(b 1)
    if nodes.ptr[loop_].aux =? 1 {return tkind(fact_type(ntype(ElementWord(nodes.ptr[loop_].a)))) =? 'fixed' and fixed_len(fact_type(ntype(ElementWord(nodes.ptr[loop_].a)))) =? n}
    let it=ElementWord(nodes.ptr[loop_].a)
    let [known_lo lo]=integer_constant(ElementWord(nodes.ptr[it].a))
    let [known_hi hi]=integer_constant(ElementWord(nodes.ptr[it].b))
    if not known_lo or not known_hi {return false}
    if has_flag(it NF_INCLUSIVE) {hi += 1}
    lo =? 0 and hi =? n
}
# An optional local that entered a range loop as `none` and that the body
# sets only to the loop's value: where present, its payload is some i in
# [lo, hi). The interval holds on the payload itself (vacuous where absent);
# the relation to hi is an implication from its tag (fact_join_payload's
# reason). O(1) plus at most two implications.
fact_found_payload=(@s:FactState l:ElementWord lo:ElementWord hi:ElementWord):>void=>$unsafe {
    let i=fact_binding(s PlaceIdentity('local' ElementWord(locals.ptr[l].owner) l))
    if i <? 0 or not s.live or s.conditional.length + 2 >? 32 {return}
    let v=s.bindings[i].value
    let pt=fact_summary_payload(fact_type(ElementWord(locals.ptr[l].type)))
    if fact_known_none(s v) or s.projections.length + 2 >=? FACT_CAP {return}
    let held:ElementWord=0
    loop evidence in s.conditional {
            if evidence.tag =? -2 {held += 1}
        }
    if held + 2 >? 12 {return}
    let tag=fact_project(@s v (-3) false T_INT)
    let t=fact_bound(s tag)
    fact_set_bound(@s tag FactBound(max(0 t.lo) min(1 t.hi)))
    let p=fact_project(@s v (-4) false pt)
    let x=fact_bound(s lo)
    let y=fact_bound(s hi)
    let b=fact_bound(s p)
    if not x.wide {b.lo=max(b.lo x.lo)}
    if not y.wide and y.hi not=? FACT_MIN {b.hi=min(b.hi y.hi - 1)}
    fact_set_bound(@s p b)
    fact_implication(@s [Tok.eq 0 tag 1 1] [Tok.lt 0 p 0 hi])
    fact_implication(@s [Tok.eq 0 tag 1 1] [Tok.ge 0 p 0 lo])
}
# Locals that body writes only by `x = l` (l the loop variable), and nothing
# else: no compound or other stores, no `@x`, no closure. O(body nodes).
fact_index_carried=(body:ElementWord l:ElementWord):>array<int64>=>$unsafe {
    let copies:dict<int64 bool>=[]
    copies[l]=true

    let stores:array<[int64 int64]>=[]
    let bad=dict<int64 bool>()
    let work=[body]
    loop work.length >? 0 {
        let e=work.pop()
        if e =? 0 {continue}
        let k=nodes.ptr[e].kind
        if k =? 'lambda' or k =? 'partial' and fact_partial_opaque(e) {return []}
        if k =? 'vardecl' and nodes.ptr[e].sym >? 0 and nodes.ptr[e].b not=? 0 and nkids(e) =? 0 {
            let value=ElementWord(nodes.ptr[e].b)
            if nodes.ptr[value].kind =? 'ident' and nodes.ptr[value].aux =? int32(1) and ElementWord(nodes.ptr[value].sym) =? l {copies[ElementWord(nodes.ptr[e].sym)]=true}
        }
        if k =? 'assign' and nodes.ptr[ElementWord(nodes.ptr[e].a)].kind =? 'ident' and nodes.ptr[ElementWord(nodes.ptr[e].a)].aux =? int32(1) {
            let target=ElementWord(nodes.ptr[ElementWord(nodes.ptr[e].a)].sym)
            let value=ElementWord(nodes.ptr[e].b)
            # (a value-preserving integer conversion, `best=i` into an `int`, or an `int?`)
            loop nodes.ptr[value].kind =? 'conv' and (nodes.ptr[value].aux =? int32(int64(CV.int_)) or nodes.ptr[value].aux =? int32(int64(CV.opt))) {value=ElementWord(nodes.ptr[value].a)}
            if nodes.ptr[e].op =? int32(47) and nodes.ptr[value].kind =? 'ident' and nodes.ptr[value].aux =? int32(1) {stores.push([target ElementWord(nodes.ptr[value].sym)])}
            else {bad[target]=true}
        }
        if k =? 'addr' and nodes.ptr[ElementWord(nodes.ptr[e].a)].kind =? 'ident' {bad[ElementWord(nodes.ptr[ElementWord(nodes.ptr[e].a)].sym)]=true}
        let mask=isolation_children(k)
        if mask <? 0 {return []}
        if mask & 1 not=? 0 {work.push(ElementWord(nodes.ptr[e].a))}
        if mask & 2 not=? 0 {work.push(ElementWord(nodes.ptr[e].b))}
        if mask & 4 not=? 0 {work.push(ElementWord(nodes.ptr[e].c))}
        if mask & 16 not=? 0 {
            loop j in [0..nkids(e)) {work.push(kid(e j))}
        }
        if mask & 32 not=? 0 {
            loop j in [0..nkids2(e)) {work.push(kid2(e j))}
        }
    }
    loop store in stores {
        if not copies.has(store[1]) or copies.has(store[0]) {bad[store[0]]=true}
    }
    let out:array<int64>=[]
    loop store in stores {
        if not bad.has(store[0]) and not fact_exposed(PlaceIdentity('local' ElementWord(locals.ptr[store[0]].owner) store[0])) and (fact_scalar(ElementWord(locals.ptr[store[0]].type)) or fact_summary_payload(fact_type(ElementWord(locals.ptr[store[0]].type))) not=? 0) and store[0] not in? out {out.push(store[0])}
    }
    out
}
# A stepped range `[first,second..end)`: the step's sign, when known, bounds
# each value between first and end (the lowering stops before passing end).
fact_stepped=(n:ElementWord @s:FactState):>void=>$unsafe {
    let iterator=ElementWord(nodes.ptr[n].a)
    let first=fact_capture(ElementWord(nodes.ptr[iterator].a) @s)
    let second=fact_capture(ElementWord(nodes.ptr[iterator].c) @s)
    let end_=if nodes.ptr[iterator].b not=? 0 {fact_capture(ElementWord(nodes.ptr[iterator].b) @s)} else {0}
    let up=fact_compare(s 'lt' first second) =? 1
    let down=fact_compare(s 'lt' second first) =? 1
    if not up and not down or fact_probe_on {fact_step_check(n @s first second ElementWord(nodes.ptr[iterator].a) ElementWord(nodes.ptr[iterator].c))}
    let entry=s
    fact_changes(n @s n)
    let after=s
    let body=s
    let l=ElementWord(nodes.ptr[n].sym)
    let v=fact_fresh(@body ElementWord(locals.ptr[l].type))
    fact_bind(@body PlaceIdentity('local' ElementWord(locals.ptr[l].owner) l) v)
    let inclusive=has_flag(iterator NF_INCLUSIVE)
    if up or down {
        let near=if up {FactTerm('ge' v first)} else {FactTerm('le' v first)}
        fact_assume(@body fact_new(@body fact_domain(T_BOOL) near) true)
        if end_ not=? 0 {
            let far=if up {FactTerm((if inclusive {Tok.le} else {Tok.lt}) v end_)} else {FactTerm((if inclusive {Tok.ge} else {Tok.gt}) v end_)}
            fact_assume(@body fact_new(@body fact_domain(T_BOOL) far) true)
        }
    }
    let edges=fact_loop_body(n @body)
    fact_range_exhaustion(n entry first second edges)
    s=after
}
# Each iteration's hidden index lies in [0, length) of the source's entry
# value; the source is a snapshot, so a body that resizes the original
# rebinds that place and the length stays the snapshot's.
fact_loop_index=(n:ElementWord base:ElementWord @s:FactState):>void=>$unsafe {
    let t=fact_type(ntype(ElementWord(nodes.ptr[n].a)))
    if types.ptr[t].kind not=? 'array' and types.ptr[t].kind not=? 'fixed' {return}
    let length=if types.ptr[t].kind =? 'fixed' {fact_constant(@s fixed_len(t))} else {fact_project(@s base (-1) false T_INT)}
    let l=ElementWord(nodes.ptr[n].c)
    let hi=fact_bound(s length).hi
    let v=fact_new(@s FactBound(0 (if hi >? FACT_MIN {hi - 1} else {hi}) reason='loop_' witness=n) FactTerm(type=ElementWord(locals.ptr[l].type)))
    fact_bind(@s PlaceIdentity('local' ElementWord(locals.ptr[l].owner) l) v)
    fact_difference(@s v length (-1) n)
    fact_set_bound(@s v fact_bound(s v))
}
# A readonly iteration over a complete finite element inventory takes its
# interval hull, never one selected element's facts. Demand-only, O(P), capped
# by the ordinary projection budget. Mutations rebuild aggregate identities.
# An element of a key snapshot (FACT_KEYS_SOURCE) is a key besides, and one
# of an array whose elements are below a value is below it: inside the body
# the source is not empty, so the bound value is one of its elements.
fact_loop_elements=(n:ElementWord base:ElementWord @s:FactState):>void=>$unsafe {
    let l=ElementWord(nodes.ptr[n].sym)
    if nodes.ptr[n].aux not=? 1 or l <=? 0 or base =? 0 {return}
    let place=PlaceIdentity('local' ElementWord(locals.ptr[l].owner) l)
    let below=fact_projection_find(s base FACT_ELEMENT_BELOW false)
    let field_keys=fact_projection_find(s base FACT_FIELD_KEYS false)
    if below <? 0 and field_keys <? 0 and fact_projection_find(s base FACT_KEYS_SOURCE false) <? 0 {
        fact_loop_element(n base @s)
        return
    }
    let i=fact_binding(s place)
    let before=if i >=? 0 {s.bindings[i].value} else {0}
    fact_loop_element(n base @s)
    i=fact_binding(s place)
    let value=if i >=? 0 and s.bindings[i].value not=? before {s.bindings[i].value} else {fact_fresh(@s ElementWord(locals.ptr[l].type))}
    if below >=? 0 {fact_difference(@s value s.projections[below].value (-1) n 16)}
    fact_bind(@s place fact_keys_element(@s base value))
    # (the element's field the dictionary took its keys from is a key of it)
    if field_keys >=? 0 {fact_field_keys(@s s.projections[field_keys].value value ElementWord(locals.ptr[l].type))}
}
# Each field name the view (FACT_FIELD_KEYS) holds: the element's field is a
# key of that dictionary (FACT_KEY_SOURCE). O(the view's projections).
fact_field_keys=(@s:FactState view:ElementWord value:ElementWord t0:ElementWord):>void=>$unsafe {
    let t=fact_type(t0)
    if tkind(t) not=? 'struct_' {return}
    let si=ElementWord(types.ptr[t].st)
    let held:array<FactProjection>=[]
    let pi=fact_projection_first(s view)
    loop pi >=? 0 {
        held.push(s.projections[pi])
        pi=fact_projection_after(s pi)
    }
    loop p in held {
        if p.element or p.selector <=? 0 {continue}
        loop i in [0..ElementWord(structs.ptr[si].nfields)) {
            let f=fields.ptr[ElementWord(structs.ptr[si].fields) + i]
            if int64(f.name) not=? p.selector or s.projections.length >=? FACT_CAP {continue}
            let key=fact_project(@s value p.selector false int64(f.type))
            fact_add_projection(@s FactProjection(key FACT_KEY_SOURCE false p.value))
        }
    }
}
fact_loop_element=(n:ElementWord base:ElementWord @s:FactState):>void=>$unsafe {
    let l=ElementWord(nodes.ptr[n].sym)
    let uniform=fact_projection_find(s base FACT_ELEMENT_COPY false)
    if uniform >=? 0 {
        fact_bind(@s PlaceIdentity('local' ElementWord(locals.ptr[l].owner) l) s.projections[uniform].value)
        return
    }
    let t=fact_type(ElementWord(locals.ptr[l].type))
    let sized=t =? T_STR or tkind(t) =? 'array'
    if not fact_scalar(t) and not sized and tkind(t) not=? 'tuple' and tkind(t) not=? 'struct_' {return}
    if sized and fact_push_frames.length >? 0 {
        let index=fact_binding(s PlaceIdentity('local' fact_owner ElementWord(nodes.ptr[n].c)))
        if index >=? 0 {
            let value=fact_project(@s base s.bindings[index].value true t)
            fact_bind(@s PlaceIdentity('local' ElementWord(locals.ptr[l].owner) l) value)
            return
        }
    }
    if sized {
        let same=fact_projection_find(s base FACT_ELEMENT_SAME_LENGTH false)
        if same >=? 0 {
            let value=fact_new(@s FactBound() FactTerm(type=t))
            if s.projections.length <? FACT_CAP {fact_add_projection(@s FactProjection(value (-1) false s.projections[same].value))}
            if fact_hull_owner =? fact_owner and tkind(t) =? 'array' {fact_row_bounds(@s base value)}
            fact_bind(@s PlaceIdentity('local' ElementWord(locals.ptr[l].owner) l) value)
            return
        }
        let pi=fact_projection_find(s base FACT_ELEMENT_LENGTH false)
        if pi >=? 0 {
            let value=fact_new(@s FactBound() FactTerm(type=t))
            if s.projections.length <? FACT_CAP {fact_add_projection(@s FactProjection(value (-1) false fact_new(@s fact_bound(s s.projections[pi].value) FactTerm(type=T_INT))))}
            if fact_hull_owner =? fact_owner and tkind(t) =? 'array' {fact_row_bounds(@s base value)}
            fact_bind(@s PlaceIdentity('local' ElementWord(locals.ptr[l].owner) l) value)
            return
        }
    }
    # (an element hull, without a complete inventory)
    let hull=if not fact_scalar(t) or fact_hull_owner not=? fact_owner {-1} else {fact_projection_find(s base FACT_ELEMENT_VALUE false)}
    if hull >=? 0 {fact_bind(@s PlaceIdentity('local' ElementWord(locals.ptr[l].owner) l) fact_new(@s fact_bound(s s.projections[hull].value) FactTerm(type=t)))}
    let parts=fact_inventory(s base)
    if parts.length =? 0 {
        # (a tuple's integer components, by the facts every element's have)
        if fact_hull_owner =? fact_owner and fact_int_components(t) >? 0 {
            let value=fact_new(@s FactBound() FactTerm(type=t))
            fact_component_bounds(@s base value t)
            fact_bind(@s PlaceIdentity('local' ElementWord(locals.ptr[l].owner) l) value)
        }
        return
    }
    let value=fact_new(@s FactBound() FactTerm(type=t))
    fact_inventory_bound(@s value parts t n)
    fact_bind(@s PlaceIdentity('local' ElementWord(locals.ptr[l].owner) l) value)
}
# Permutations keep an immutable element inventory, not the positions of its
# values. Flatten the source link: O(1) transfer, then the existing bounded
# inventory query only when a consumer reads an element. Hooked elements can
# change on copy, so they supply no inventory. All element writes drop the link.
fact_permuted_elements=(@s:FactState before:ElementWord after:ElementWord):>void=>{
    if before =? 0 or after =? 0 or s.projections.length >=? FACT_CAP {return}
    let t=fact_type(fact_terms[before].type)
    if tkind(t) not=? 'array' and tkind(t) not=? 'fixed' {return}
    if ownership_decls.length not=? 0 and ownership_fact_type(telem(t)) {return}
    # (what holds of every element, as a comprehension's value hull, holds of
    # every element of the permutation: `[loop i in [0..n) i].sorted(key=f)`)
    loop selector in [FACT_ELEMENT_VALUE FACT_ELEMENT_LENGTH FACT_ELEMENT_SAME_LENGTH FACT_ELEMENT_BELOW] {
        let held=fact_projection_find(s before selector false)
        if held >=? 0 and s.projections.length <? FACT_CAP {fact_add_projection(@s FactProjection(after selector false s.projections[held].value))}
    }
    loop c in [0..fact_int_components(fact_type(telem(t)))) {
        loop below in [false true] {
            let held=fact_projection_find(s before fact_component_selector(c below) false)
            if held >=? 0 and s.projections.length <? FACT_CAP {fact_add_projection(@s FactProjection(after fact_component_selector(c below) false s.projections[held].value))}
        }
    }
    let uniform=fact_projection_find(s before FACT_ELEMENT_COPY false)
    if uniform >=? 0 {
        fact_add_projection(@s FactProjection(after FACT_ELEMENT_COPY false s.projections[uniform].value))
        return
    }
    let source=fact_projection_find(s before FACT_ELEMENT_SOURCE false)
    let original=if source >=? 0 {s.projections[source].value} else {before}
    fact_add_projection(@s FactProjection(after FACT_ELEMENT_SOURCE false original))
}
# The values of all of base's elements, when each is known by a constant index
# (a literal's, at most 64 of them); none otherwise. O(base's projections).
fact_inventory=(s:FactState base0:ElementWord):>array<int64>=>{
    let base=base0
    let source=fact_projection_find(s base FACT_ELEMENT_SOURCE false)
    if source >=? 0 {base=s.projections[source].value}
    let parts:array<int64>=[]
    let li=fact_projection_find(s base (-1) false)
    if li <? 0 {return parts}
    let length=fact_bound(s s.projections[li].value)
    if length.wide or length.lo not=? length.hi or length.lo <=? 0 or length.hi >? 64 {return parts}
    let seen=dict<int64 bool>()
    let pi=fact_projection_first(s base)
    loop pi >=? 0 {
        let p=s.projections[pi]
        pi=fact_projection_after(s pi)
        if not p.element {continue}
        let key=fact_bound(s p.selector)
        if key.wide or key.lo not=? key.hi or key.lo <? 0 or key.lo >=? length.lo or seen.has(key.lo) {continue}
        seen[key.lo]=true
        parts.push(p.value)
    }
    if seen.length not=? length.lo {parts.clear()}
    parts
}
# A selected scalar satisfies only relations shared by every inventory entry.
# Candidate rows come from the first entry's indexed incident list; each other
# entry must entail the substituted row. Demand-only O(parts x incident rows x
# bounded entailment), within the existing inventory and difference budgets.
fact_inventory_rows=(@s:FactState value:ElementWord parts:array<int64> at:ElementWord):>void=>{
    let first=parts[0]
    if first =? 0 or value =? 0 {return}
    loop direction in [0..2) {
        let rows:array<FactDifference>=[]
        let ri=fact_difference_head(s first direction)
        loop ri >=? 0 {
            rows.push(s.differences[ri])
            ri=fact_difference_next(s ri direction)
        }
        loop row in rows {
            let shared=true
            loop j in [1..parts.length) {
                let a=if direction =? 1 {parts[j]} else {row.a}
                let b=if direction =? 0 {parts[j]} else {row.b}
                if fact_distance(s a b row.limit) {continue}
                let x=fact_bound(s a)
                let y=fact_bound(s b)
                # Mathematical integer endpoints are sentinels until proved
                # finite; they cannot establish a row by interval arithmetic.
                if x.wide or y.wide or y.lo =? FACT_MIN or x.hi =? FACT_MAX and fact_open_endpoint(s a true) or not fact_add_fits(x.hi (-y.lo)) or x.hi - y.lo >? row.limit {
                    shared=false
                    break
                }
            }
            if shared {fact_difference(@s (if direction =? 1 {value} else {row.a}) (if direction =? 0 {value} else {row.b}) row.limit at)}
        }
    }
}
# What every element of an inventory shares, given to value (one element, of
# type t): a scalar's hull, a string's or array's length hull, or each scalar
# component's hull for tuples/records, nesting at most four levels and eight
# fields per level. O(parts x visited components), capped by FACT_CAP.
fact_inventory_bound=(@s:FactState value:ElementWord parts:array<int64> t:ElementWord at:ElementWord depth:ElementWord=0):>void=>$unsafe {
    if depth >=? 4 or parts.length =? 0 {return}
    # Copy/transfer hooks can construct different fields for each element.
    # A literal inventory describes those inputs, not a hook's output values.
    if ownership_decls.length not=? 0 and ownership_fact_type(t) {return}
    if fact_scalar(t) {
        let joined=fact_bound(s parts[0])
        loop j in [1..parts.length) {joined=fact_hull(joined fact_bound(s parts[j]) at)}
        if joined.wide {return}
        let old=fact_bound(s value)
        fact_set_bound(@s value FactBound(max(old.lo joined.lo) min(old.hi joined.hi) old.nz or joined.nz))
        fact_inventory_rows(@s value parts at)
        # A hull touching a host sentinel can still have a finite endpoint:
        # every constituent must establish that side. Keep it as a value row,
        # never by changing the mathematical integer's representation type.
        # Only endpoint hulls demand this O(parts x bounded incident rows) query.
        if t =? T_MATH_INT {
            if joined.lo =? FACT_MIN {
                let finite=true
                loop part in parts {
                    if not fact_host_endpoint(s part false) {finite=false; break}
                }
                if finite {fact_difference(@s fact_constant(@s FACT_MIN) value 0)}
            }
            if joined.hi =? FACT_MAX {
                let finite=true
                loop part in parts {
                    if not fact_host_endpoint(s part true) {finite=false; break}
                }
                if finite {fact_difference(@s value fact_constant(@s FACT_MAX) 0)}
            }
        }
        return
    }
    let record=tkind(t) =? 'struct_' and structs.ptr[ElementWord(types.ptr[t].st)].nvariants =? 0 and not structs.ptr[ElementWord(types.ptr[t].st)].union_ and not structs.ptr[ElementWord(types.ptr[t].st)].soa_
    let components=if record {min(ElementWord(structs.ptr[ElementWord(types.ptr[t].st)].nfields) 8)} else if tkind(t) =? 'tuple' {min(ElementWord(types.ptr[t].nargs) 8)} else {1}
    let sized=t =? T_STR or tkind(t) =? 'array'
    if not sized and not record and tkind(t) not=? 'tuple' {return}
    loop c in [0..components) {
        let f=if record {ElementWord(structs.ptr[ElementWord(types.ptr[t].st)].fields) + c} else {0}
        let ct=if sized {T_INT} else if record {fact_type(ElementWord(fields.ptr[f].type))} else {fact_type(targ(t c))}
        let selector=if sized {-1} else if record {ElementWord(fields.ptr[f].name)} else {c}
        if s.projections.length >=? FACT_CAP {continue}
        if not fact_scalar(ct) {
            if tkind(ct) not=? 'struct_' and tkind(ct) not=? 'tuple' and tkind(ct) not=? 'array' and ct not=? T_STR {continue}
            let children:array<int64>=[]
            loop part in parts {children.push(fact_project(@s part selector false ct))}
            let child=fact_project(@s value selector false ct)
            fact_inventory_bound(@s child children ct at depth + 1)
            continue
        }
        let joined=FactBound()
        loop j in [0..parts.length) {
            let b=fact_bound(s fact_project(@s parts[j] selector false ct))
            joined=if j =? 0 {b} else {fact_hull(joined b at)}
        }
        # (what the elements share bounds it: where that is too little, nothing
        # establishes more, whatever iterates them)
        joined.reason='missing'
        joined.witness=0
        fact_add_projection(@s FactProjection(value selector false fact_new(@s joined FactTerm(type=ct))))
        # (arrays of one short length: each position's hull, as a tuple's)
        if not sized or t =? T_STR or joined.wide or joined.lo not=? joined.hi or joined.hi >? 8 {continue}
        let et=fact_type(ElementWord(types.ptr[t].elem))
        if not fact_scalar(et) {continue}
        loop k in [0..joined.lo) {
            let item=FactBound()
            loop j in [0..parts.length) {
                let b=fact_bound(s fact_project(@s parts[j] fact_constant(@s k) true et))
                item=if j =? 0 {b} else {fact_hull(item b at)}
            }
            item.reason='missing'
            item.witness=0
            if s.projections.length <? FACT_CAP {fact_add_projection(@s FactProjection(value fact_constant(@s k) true fact_new(@s item FactTerm(type=et))))}
        }
    }
}

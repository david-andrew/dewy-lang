from p"lower_primitives.dewy" import (e_daddr e_gaddr global_addr_off lf_helper lf_of_inst rt rt_global)
from p"lower_closures.dewy" import (closure_scalar_environment drop_stack_closure)
$runtime_checks
from p"ir.jo" import (A_RC1 M_FLOAT M_HDR M_SIGNED VF VI VS e_addi e_bin e_block e_br e_brif e_call0 e_call1 e_call2 e_call3 e_copy e_else e_end e_fconst e_iconst e_if e_load e_loop e_mov e_slot e_store e_un e_zero emit ir ir_cold ir_pos is_kv kv_of new_slot vreg)
from p"lower.jo" import (BOX_HDR BuildItem HK LowerTypePlan LowerZero Place TempItem VC_AGG VC_FLT VC_INT VC_VOID Val arg_snapshots box_dflt_data building cond_depth ctl env_v lop_watch lower_epoch lower_has_nops lower_mark_serial lower_planning lower_types lower_zeros mt_active_off opt_release pinned_box pinned_type ro_starts rodata scope_defers scope_locals tl_cond tl_items tl_nop tl_values)
from p"ir.jo" import (CALL_IF_SHARED CALL_RC_DEC CALL_RC_INC)
from p"checker_state.dewy" import (SK)
from p"check.jo" import (jd)
from p"types.jo" import (dt)
from p"check.jo" import (LF_ALIAS LF_BYREF LF_CAPTURE LF_OWNERBORROW LF_PARAM LF_PARTBORROW LF_SHARED LF_VALUECAP locals prelude syms)
from p"types.jo" import (T_INT T_MATH_INT box_default fields is_aggregate is_managed layout math_optional mk_array mk_box mk_ptr prune ptr_size structs talign tkind tsize type_has_fn types variants)
from p"copies.jo" import (copy_inputs)
from p"util.jo" import (fatal ice intern name_of)
from p"lower_helpers.dewy" import (field_list)
from p"fused.jo" import (fused_on fz_note fz_r0)
from p"expr.jo" import (is_map_type ntype)
from p"math_lower.jo" import (math_payload_type math_tag math_word_captures)
from p"ast.jo" import (nodes)

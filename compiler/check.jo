use 'pcheck.jo'
use 'units.jo'
use 'errors.jo'
use 'watch.jo'
use 'frontend.jo'
# Semantic analysis: modules, scopes, declarations, function instances, statements.

use 'util.jo'
use 'pkg.jo'
use 'lex.jo'
use 'ast.jo'
use 'parse.jo'
use 'types.jo'
use 'expr.jo'
use 'ide.jo'
use 'poly_closure.jo'
use 'prelude.jo'
use 'comptime.jo'
use 'facts.jo'
use 'refine.jo'
use 'proofs.jo'
use 'effects.jo'
use 'ownership.jo'
use 'reflection.jo'
use 'dewy_methods.jo'

enum SK: none_, local, global, fns, struct_, enum_, const_, module, type_, builtin, alias_, reflected

struct Sym:
    name: i32
    kind: SK
    ref: i32
    decl: i32
    next: i32
    surface: i32 = 0   # a library function seen only from Dewy (1) or only from Jo (2): dewy_surface

struct Module:
    name: i32
    file: i32
    dir: str
    names: {int: int}
    uses: int[]
    imports: (int, int)[]     # resolved module and import position, for every import form
    decls: int[]
    is_prelude: bool
    is_main: bool
    inits: int[]
    init_fn: i32

const LF_PARAM = 1
const LF_MUTPARAM = 2
const LF_CAPTURE = 4
const LF_ALIAS = 8
const LF_ASSIGNED = 16
const LF_BYREF = 32
const LF_ADDR = 64     # address is taken (must live in memory)
const LF_RESIZED = 128 # the variable itself is written (not just its elements or fields)
const LF_CAPTURED = 256 # a closure captures this variable
const LF_DECL = 512     # declared by `x = value` / `x: T`
const LF_UNNARROWED = 2048  # a narrowed name (alias) whose variable was assigned another type
const LF_SOAELEM = 4096     # loop p in ps (ps a soa array): p stands for ps[i] (see soa_loop)
const LF_SOAMUT = 8192      # ... and the loop is `loop mut`
const LF_ELEMALIAS = 16384  # `mut x in xs` in a combined loop: x stands for xs[k] (writes to x write xs)
const LF_READ = 32768       # its value is read somewhere (not only the base of a write: v.f = 1)
const LF_QUIET = 65536      # a loop counter or part of `a, b = f()`: not warned about when unused
const LF_EXPOSED = 1048576 # raw storage exposure needs owned storage, including private captures
const LF_OWNERBORROW = 8388608 # nonescaping resource capture: pointer, not an owned cell
const LF_VALUECAP = 262144  # Dewy capture owns a snapshot; outer links stop here
const LF_CONST = 131072     # Dewy const: one initialized value, no writes through the binding
assign_root = 0                 # (the variable an assignment being checked writes through)
copy_writes: {int: int} = {}    # local -> where its fields or elements are first written
gcopy_writes: {int: int} = {}   # the same for globals
global_read: bool[]             # by global: its value is read somewhere
open_globals: int[]             # globals made empty (`xs = []`) whose element type is still open

const LF_SHARED = 1024  # modified after a closure captured it, or by the closure: closures and
                        # the function share it by reference (it lives in a heap cell, see lower.jo)

struct Local:
    name: i32
    type: i32
    flags: i32
    const_init: i32         # checked initializer for constant-expression contexts
    alias: i32
    owner: i32
    pos: int
    offset: i32
    env_off: i32
    vreg: i32
    outer: i32      # LF_CAPTURE: the enclosing function's variable this one captures
    dloops: i32     # loops being checked when it was declared
    soa: i32        # LF_SOAELEM: the (unchecked) ps[i] it stands for
    wloop: i32      # outermost loop (inside its scope) that modifies it before any capture

struct Global:
    name: i32
    type: i32
    decl: i32
    mod: i32
    sym: str
    state: i32
    is_const: bool
    init: i32
    addr: i32
    fn_written: bool    # some function (not top-level code) changes it

struct Capture:
    outer: i32
    inner: i32

const FK_NORMAL = 0
const FK_LAMBDA = 1
const FK_THUNK = 2
const FK_PARTIAL = 3
const FK_INIT = 4

struct FnInst:
    decl: i32
    body: i32
    targs: int[]
    ptypes: int[]
    params: int[]
    ret: i32
    sym: str
    state: i32
    kind: i32
    has_env: bool
    caps: Capture[]
    env_size: i32
    mod: i32
    partial: i32
    target: i32
    locals: int[]
    fntype: i32
    cabi: bool
    deterministic: bool # callback results should depend only on their state and inputs
    parallel: bool      # @parallel: the functions it is given run on many threads at once
    write_sites: int[]  # finalization events for integer write proofs
    writes_ready: bool
    no_indexes: bool    # finalized normal body has no indexing; init/lambda bodies stay unknown
    no_user_globals: bool # finalized body cannot mention a closed-program array candidate
    noinline: bool      # @noinline: call it rather than copy it into its callers
    gdepth: i32         # generic instances: how many were being checked, one inside the other, when it was made
    export_name: str
    aux_void: bool
    clib: str
    csym: str
    cvariadic: i32      # @variadic(n): a C function with n fixed parameters, then C's `...` (0: none)
    use_pos: int        # generic instances: the call that made it (for errors inside it) ...
    made_in: i32        # ... in the body of this instance (0: none)

struct FnSig:
    contract: i32
    ntp: i32
    nexplicit: i32
    params: int[]
    ret: i32
    mutmask: i32
    generic: bool
    done: bool

struct DeclInfo:
    insts: int[]
    sig: FnSig

struct FnInstanceKey:
    decl: int
    args: int[]

# Concrete types are interned: their IDs are their equality keys. Keep the
# declaration's instance list for inference-bearing arguments and IDE ordering.
fn_instances: {FnInstanceKey: int} = {}

struct FnCtx:
    inst: i32
    parent: i32
    ret: i32
    infer_ret: bool
    loop_depth: i32
    mod: i32
    floor: i32

syms: Sym[] = [Sym()]
modules: Module[]
module_by_path: {str: int} = {}
universe: {int: int} = {}
prelude: {int: int} = {}
locals: Local[] = [Local()]
globals: Global[] = [Global()]
fns: FnInst[] = [FnInst()]
decl_infos: DeclInfo[] = [DeclInfo()]
ctxs: FnCtx[]
cx = -1
sc_names: int[]
sc_syms: int[]
inst_counter = 0
lib_dir = ""
target_wasm = false
target_windows = false        # (Windows x64: compiler/pe.jo)
target_arm64 = false          # (Linux on arm64: compiler/arm64.jo)
target_macos = false          # (macOS on arm64: compiler/arm64.jo, compiler/macho.jo)
main_fn = 0
test_mode = false        # `sloppy test`: run the main file's test blocks instead of main()
expectation_ifs: {int: bool} = {}   # Dewy's `$expect`s: `if not condition { report; return }`
check_all = false        # (sloppy check: the tests and the game loop both checked; nothing runs)
test_decls: int[]
update_fn = 0
draw_fn = 0
init_fns: int[]
build_node = 0
program_icon: u8[] = []         # the build block's icon (a PNG), for Windows programs and web pages
program_js = ""                 # the build block's js file's text: in a web page, before the program starts
icon_node = 0                   # PROGRAM_ICON's value: the icon's bytes (Linux windows show it)
program_name = ""               # PROGRAM_NAME: the build block's name, else the main file's (set in check_program)
global_ids: int[]

new_sym = (name: int, kind: SK, r: int, decl: int) -> int:
    syms.push(Sym(i32(name), kind, i32(r), i32(decl), 0))
    syms.len() - 1

own_consts: bool[]            # by name: a constant of the program's own (not the library's)

scope_add_module = (m: int, name: int, kind: SK, r: int, decl: int) -> int:
    # (look the name up in place: holding a copy of the table would make the insert below copy it)
    found: int? = none
    if modules[m].is_prelude: found = prelude.get(name)
    else: found = modules[m].names.get(name)
    if let ex = found:
        if syms[ex].kind == .fns and kind == .fns:
            s = new_sym(name, kind, r, decl)
            if decl != 0 and modules[m].is_prelude: syms[s].surface = i32(dewy_surface(name, decl))
            if modules[m].is_prelude:
                prev = 0
                e = ex
                loop e != 0 and not prelude_decl_before(decl, int(syms[e].decl)):
                    prev = e
                    e = int(syms[e].next)
                syms[s].next = i32(e)
                if prev == 0: prelude[name] = s
                else: syms[prev].next = i32(s)
                return prelude[name]
            e = ex
            loop syms[e].next != 0: e = int(syms[e].next)
            syms[e].next = i32(s)
            return ex
        if decl != 0 and syms[ex].decl != 0:
            if syms[ex].kind == .const_ and kind == .global: fatal(nodes[decl].pos, "'{name_of(name)}' is a constant ({pos_str(nodes[int(syms[ex].decl)].pos)}): it cannot change")
            fatal(nodes[decl].pos, "'{name_of(name)}' is already defined at {pos_str(nodes[int(syms[ex].decl)].pos)}")
    s = new_sym(name, kind, r, decl)
    if kind == .fns and decl != 0 and modules[m].is_prelude: syms[s].surface = i32(dewy_surface(name, decl))
    if modules[m].is_prelude: prelude[name] = s
    else:
        modules[m].names[name] = s
        if kind == .const_:
            loop own_consts.len() <= name: own_consts.push(false)
            own_consts[name] = true
    s

# Scopes are one stack of (name, symbol); each name also links its bindings, newest first, so
# a lookup is one step instead of a scan: sc_top[name] -> newest index, sc_prev[i] -> older one.
sc_prev: int[]
sc_top: int[]

push_scope_sym = (name: int, sym: int):
    loop sc_top.len() <= name: sc_top.push(-1)
    sc_prev.push(sc_top[name])
    sc_top[name] = sc_names.len()
    sc_names.push(name)
    sc_syms.push(sym)

scope_mark = () -> int: sc_names.len()
scope_reset = (mark: int):
    i = sc_names.len() - 1
    loop i >= mark:
        sc_top[sc_names[i]] = sc_prev[i]
        i -= 1
    sc_names.truncate(mark)
    sc_syms.truncate(mark)
    sc_prev.truncate(mark)

module_lookup = (m: int, name: int) -> int:
    demand_prelude_name(name)
    user = m >= 0 and not modules[m].is_prelude
    if m >= 0:
        if modules[m].is_prelude:
            if let s = prelude.get(name): return s
        else:
            if let s = modules[m].names.get(name): return s
            loop u in modules[m].uses:
                if modules[u].is_prelude:
                    if let s = prelude.get(name):
                        if not lib_private(name): return s
                else:
                    if let s = modules[u].names.get(name):
                        if not is_private(name): return s
    if let s = prelude.get(name):
        if not user or not lib_private(name): return s
    if let s = universe.get(name): return s
    0

# names starting with _ stay in their module: `use` does not bring them (`import m` reaches
# them as m._x, `from m import _x` by name). The library's are hidden from programs; its __
# names are the runtime's, which code the compiler writes calls
is_private = (name: int) -> bool:
    s = name_of(name)
    len(s) > 0 and s[0] == '_'

lib_private = (name: int) -> bool:
    s = name_of(name)
    len(s) > 1 and s[0] == '_' and s[1] != '_'

# from m import a, b as c: each name bound in the importing module (functions join any of its
# own with that name, as overloads)
from_imports: int[]

bind_from_imports = (start: int = 0):
    check_import_cycles()
    loop di in [start..from_imports.len()):
        d = from_imports[di]
        m = int(nodes[d].mod)
        im = int(nodes[d].sym)
        loop i in [0..nkids(d)):
            id = kid(d, i)
            nm = int(nodes[id].name)
            if ide_sentinel != 0 and nm == ide_sentinel: ide_complete_module(im)
            alias = nm
            if nodes[id].aux != 0:
                alias = int(nodes[id].aux)
                if ide_on: ide_alias_of[alias] = nm
            s = 0
            if modules[im].is_prelude: s = prelude.get(nm) ?? 0
            else: s = modules[im].names.get(nm) ?? 0
            if s == 0 or syms[s].kind == .module:
                cands: int[]
                if not modules[im].is_prelude:
                    loop k, v in modules[im].names: cands.push(k)
                fatal(nodes[id].pos, "'{name_of(int(nodes[d].sval))}' has no '{name_of(nm)}'{suggestion(name_of(nm), cands)}")
            if files[int(modules[m].file)].is_dewy: rational_one_spelling(im, nm, nodes[id].pos, "drop `{name_of(nm)}` from the import and ")
            if ide_on:
                if syms[s].kind == .fns and syms[s].decl != 0: ide_ref(nodes[id].pos, nm, IK_FN, nodes[int(syms[s].decl)].pos, 0, -int(syms[s].decl))
                else: ide_sym_ref(id, s)
            if syms[s].kind == .fns:
                if let ex = modules[m].names.get(alias):
                    if syms[ex].kind != .fns: fatal(nodes[id].pos, "cannot import '{name_of(alias)}': this module has a '{name_of(alias)}' (at {pos_str(nodes[int(syms[ex].decl)].pos)}); import it with another name: {name_of(nm)} as ...")
                o = s
                loop o != 0:
                    scope_add_module(m, alias, .fns, int(syms[o].ref), int(syms[o].decl))
                    o = int(syms[o].next)
            else:
                if let ex = modules[m].names.get(alias):
                    where = "at {pos_str(nodes[d].pos)}"
                    if syms[ex].decl != 0: where = "at {pos_str(nodes[int(syms[ex].decl)].pos)}"
                    fatal(nodes[id].pos, "cannot import '{name_of(alias)}': this module has a '{name_of(alias)}' ({where}); import it with another name: {name_of(nm)} as ...")
                modules[m].names[alias] = new_sym(alias, syms[s].kind, int(syms[s].ref), int(syms[s].decl))

# The bundled exact fraction's types are the builtin `rational` and
# `rational<int64>`: their library names are not a second spelling.
rational_one_spelling = (im: int, nm: int, pos: int, how: str):
    if files[int(modules[im].file)].path != lib_dir + "/rational.dewy": return
    builtin = if name_of(nm) == "Rational": "rational" else if name_of(nm) == "RationalWord": "rational<int64>" else: ""
    if builtin != "": fatal(pos, "the exact fraction type is the builtin `{builtin}`: {how}write `{builtin}`")

# Dewy's name for a builtin type Jo spells w ("" when w is not one).
dewy_type_word = (w: str) -> str:
    if w == "str": return "string"
    if w == "byte": return "uint8"
    if w == "f64" or w == "f32": return "float" + w[1..]
    if w == "i8" or w == "i16" or w == "i32" or w == "i64": return "int" + w[1..]
    if w == "u8" or w == "u16" or w == "u32" or w == "u64": return "uint" + w[1..]
    ""

# Dewy source names the builtin types one way: a Jo spelling written there (and
# resolved to the builtin, not a binding of the program's) is rejected. Only
# text the source spells counts, not names the compiler builds at its positions.
jo_type_names: {int: bool} = {}
jo_type_spelling = (nm: int, s: int, pos: int):
    if jo_type_names.len() == 0:
        loop w in ["str", "byte", "f32", "f64", "i8", "i16", "i32", "i64", "u8", "u16", "u32", "u64"]: jo_type_names[intern(w)] = true
    if not jo_type_names.has(nm) or s == 0 or not dewy_at(pos) or (universe.get(nm) ?? 0) != s: return
    w = name_of(nm)
    src = files[pos_file(pos)].src
    off = pos_off(pos)
    stop = off + len(w)
    if stop > len(src) or (stop < len(src) and is_ident_char(src[stop])): return
    loop i in [0..len(w)):
        if src[off + i] != w[i]: return
    dewy = dewy_type_word(w)
    fatal(pos, "`{w}` is not a Dewy type name: write `{dewy}`")

# look up a name from the current context
lookup = (name: int) -> int:
    floor = 0
    m = -1
    if cx >= 0:
        floor = int(ctxs[cx].floor)
        m = int(ctxs[cx].mod)
    if name < sc_top.len():
        i = sc_top[name]
        if i >= floor: return sc_syms[i]
    module_lookup(m, name)

# ---------------- "did you mean" ----------------
# edit distance where swapping two neighbors counts once (optimal string alignment)
edit_distance = (a: str, b: str, limit: int) -> int:
    n = len(a)
    m = len(b)
    if abs(n - m) > limit: return limit + 1
    pp = fill(0, m + 1)
    prev = fill(0, m + 1)
    cur = fill(0, m + 1)
    loop j in [0..m + 1): prev[j] = j
    loop i in [1..n + 1):
        cur[0] = i
        best = i
        loop j in [1..m + 1):
            c = 1
            if fold_case(a[i - 1]) == fold_case(b[j - 1]): c = 0
            v = min(min(prev[j] + 1, cur[j - 1] + 1), prev[j - 1] + c)
            if i > 1 and j > 1 and fold_case(a[i - 1]) == fold_case(b[j - 2]) and fold_case(a[i - 2]) == fold_case(b[j - 1]): v = min(v, pp[j - 2] + 1)
            cur[j] = v
            if v < best: best = v
        if best > limit: return limit + 1
        tmp = pp
        pp = prev
        prev = cur
        cur = tmp
    prev[m]

# the closest of the candidate names (" (did you mean 'x'?)"), or ""; ties go to the longest
# common prefix, and a short name that starts the misspelling (len / lenght) counts as close
# (recv: the type whose member was asked for; a habit that names a member, `.length`, is
# told only when that type has it)
suggestion = (name: str, candidates: int[], recv: int = 0) -> str:
    h = habit_name(name)
    if len(h) > 0:
        # (`push` only where there is one: a texture's size is not its len)
        w = h
        if w[0] == '`': w = w[1..len(w) - 1)
        if find(w, "(") > 0 and find(w, " ") < 0: w = w[..find(w, "("))     # (`random_item(xs)`: random_item)
        if find(w, ".") > 0: w = w[find(w, ".") + 1..]                       # (`xs.remove(0)`: remove)
        known = w == "true" or w == "false" or w == "none" or find(w, " ") >= 0 or find(w, "`") >= 0 or (len(w) > 0 and w[0] == '.')
        if recv != 0 and len(w) > 1 and w[0] == '.':
            e = 1
            loop e < len(w) and is_ident_char(w[e]): e += 1
            member = w[1..e)
            known = receiver_fits((if member == "length": "len" else: member), recv)
        loop c in candidates:
            if known: break
            if name_of(c) == w: known = true
        if known:
            if starts_with(h, "nothing: "): return " (none is needed: {h[9..]})"
            return " (use {h})"
    # (Score for score: the same but for its capitals)
    loop c in candidates:
        cn = name_of(c)
        if cn != name and len(cn) == len(name) and lower(cn) == lower(name): return " (did you mean '{cn}'? names care about capital letters)"
    # (BROWN, SKYBLUE: a color's name in capitals; only names in capitals are near it)
    caps = len(name) >= 3
    loop ch in name:
        if ch >= 'a' and ch <= 'z': caps = false
    limit = 1
    if len(name) > 4: limit = 2
    # (a one- or two-letter name is close to too many: only another case of it)
    if len(name) <= 2: limit = 0
    best = ""
    bs = 1000000
    loop c in candidates:
        cn = name_of(c)
        if caps and cn != upper(cn): continue
        if cn == name or len(cn) == 0 or cn[0] == '_': continue
        d = edit_distance(name, cn, limit)
        pre = 0
        loop pre < len(cn) and pre < len(name) and fold_case(cn[pre]) == fold_case(name[pre]): pre += 1
        if d > limit and pre == len(cn) and pre >= 3: d = limit
        # (poly for polygon: the start of a longer name)
        longer = 0
        # (save for save_data: the first word of a longer name, before all others)
        if pre == len(name) and pre >= 3 and len(cn) > pre and cn[pre] == '_':
            d = 0
            longer = len(cn)
        else if d > limit and pre == len(name) and pre >= 4 and len(cn) <= 2 * len(name):
            d = limit
            longer = len(cn)          # (the shortest such: polygon before polyline)
        if d > limit: continue
        score = d * 100 - pre + longer
        if score < bs:
            bs = score
            best = cn
    if len(best) > 0: return " (did you mean '{best}'?)"
    if caps: return " (the colors with names are WHITE, BLACK, RED, GREEN, BLUE, YELLOW, ORANGE, PURPLE, CYAN, MAGENTA and GRAY; any other is rgb(0.5, 0.3, 0.1), each from 0 to 1)"
    ""

# what Sloppy calls a name from another language ("`push`"), or ""
repl_sig_query = false          # (the REPL's `:type name`: a function's versions go to repl_sig)
repl_sig = ""

HABITS = ["index", "`find(s, x)` for text (-1 when it is not there), `index_of(xs, x)` for an array", "path_exists", "`file_exists(path)`", "exists", "`file_exists(path)`", "stat", "`file_size(path)`, `file_time(path)`, `is_dir(path)`",
    "sys_exit", "`exit(code)`", "stderr", "`eprint(...)`", "realpath", "`abs_path(path)`", "abspath", "`abs_path(path)`",
    "getenv", "`env(name)` (none when it is not set)", "sprintf", "a string with `\{x}` in it (`\"\{n:5.2}\"` formats)", "remove_file", "`delete_file(path)`", "split_whitespace", "`words(s)`", "strptime", "`parse_date(\"2026-10-14 08:15\")` (ISO dates and times)", "fromisoformat", "`parse_date(text)`", "parse_datetime", "`parse_date(text)`", "hexdigest", "`sha256(bytes or text)` (64 hex digits)", "errno", "`file_error()` (why the last file operation failed)", "strerror", "`file_error()` (why the last file operation failed)", "last_error", "`file_error()` (why the last file operation failed)",
    "mkdir_all", "`make_dirs(path)`", "makedirs", "`make_dirs(path)`", "read_lines", "`lines(read_file(path) ?? \"\")` (or `read_line()` for standard input, a line at a time)",
    "has_point", "`contains(r, p)`", "rect_contains", "`contains(r, p)`", "point_in_rect", "`contains(r, p)`",
    "mouse_scroll", "`mouse_wheel()`", "text_size", "`text_width(s, size)`", "measure_text", "`text_width(s, size)`",
    "get_ticks", "`time()` (or `elapsed()`, the game's clock)", "str_to_int", "`to_int(s)`", "parse_int", "`to_int(s)`",
    "list_files", "`list_dir(path)`", "erase", "`remove(i)`", "input_text", "`hud_text_field(r, value)` (or `ui_text_field` in a menu)",
    "ui_input_text", "`hud_text_field(r, value)` (or `ui_text_field` in a menu)", "deep_copy", "nothing: `ys = xs` copies (arrays and structs are values)",
    "mouse_button_pressed", "`mouse_pressed(.left)`", "mouse_button_down", "`mouse_down(.left)`", "get_mouse_position", "`mouse_pos()`", "mouse_position", "`mouse_pos()`",
    "is_key_down", "`key_down(.space)`", "is_key_pressed", "`key_pressed(.space)`", "IsKeyDown", "`key_down(.space)`",
    "delta_time", "`dt`, what update is given: `update = (dt: f64):`", "deltaTime", "`dt`, what update is given: `update = (dt: f64):`", "get_frame_time", "`dt`, what update is given: `update = (dt: f64):`",

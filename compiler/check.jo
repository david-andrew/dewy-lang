struct Module:
    name: i32
    file: i32
    dir: str
    names: {int: int}
    uses: int[]
    imports: (int, int)[]     # resolved module and import position, for every import form
    decls: int[]
    is_prelude: bool
    is_main: bool
    inits: int[]
    init_fn: i32

const LF_VALUEITER = 33554432 # readonly element of a Dewy array snapshot
const LF_PARAM = 1
const LF_MUTPARAM = 2
const LF_CAPTURE = 4
const LF_ALIAS = 8
const LF_ASSIGNED = 16
const LF_BYREF = 32
const LF_ADDR = 64     # address is taken (must live in memory)
const LF_RESIZED = 128 # the variable itself is written (not just its elements or fields)
const LF_CAPTURED = 256 # a closure captures this variable
const LF_DECL = 512     # declared by `x = value` / `x: T`
const LF_UNNARROWED = 2048  # a narrowed name (alias) whose variable was assigned another type
const LF_SOAELEM = 4096     # loop p in ps (ps a soa array): p stands for ps[i] (see soa_loop)
const LF_SOAMUT = 8192      # ... and the loop is `loop mut`
const LF_ELEMALIAS = 16384  # `mut x in xs` in a combined loop: x stands for xs[k] (writes to x write xs)
const LF_READ = 32768       # its value is read somewhere (not only the base of a write: v.f = 1)
const LF_QUIET = 65536      # a loop counter or part of `a, b = f()`: not warned about when unused
const LF_EXPOSED = 1048576 # raw storage exposure needs owned storage, including private captures
const LF_PARTBORROW = 16777216 # mutable array capture, admitted only by checked scoped partitions
const LF_OWNERBORROW = 8388608 # nonescaping resource capture: pointer, not an owned cell
const LF_VALUECAP = 262144  # Dewy capture owns a snapshot; outer links stop here
const LF_CONST = 131072     # Dewy const: one initialized value, no writes through the binding
const LF_VALUEPARAM = 524288 # a Dewy value parameter's own binding (dw_finish_function): a parameter
                             # in the source, a private mutable copy to the compiler (not LF_PARAM)
assign_root = 0                 # (the variable an assignment being checked writes through)
copy_writes: {int: int} = {}    # local -> where its fields or elements are first written
gcopy_writes: {int: int} = {}   # the same for globals
global_read: bool[]             # by global: its value is read somewhere
open_globals: int[]             # globals made empty (`xs = []`) whose element type is still open

const LF_SHARED = 1024  # modified after a closure captured it, or by the closure: closures and
                        # the function share it by reference (it lives in a heap cell, see lower.jo)

const FK_NORMAL = 0
const FK_LAMBDA = 1
const FK_THUNK = 2
const FK_PARTIAL = 3
const FK_INIT = 4

# Concrete types are interned: their IDs are their equality keys. Keep the
# declaration's instance list for inference-bearing arguments and IDE ordering.
fn_instances: {FnInstanceKey: int} = {}

syms: Sym[] = [Sym()]
modules: Module[]
module_by_path: {str: int} = {}
universe: {int: int} = {}
prelude: {int: int} = {}
locals: Local[] = [Local()]
globals: Global[] = [Global()]
fns: FnInst[] = [FnInst()]
decl_infos: DeclInfo[] = [DeclInfo()]
ctxs: FnCtx[]
cx = -1
check_scopes = CheckerScope()
statement_watch = StatementWatch()  # (the rare tables' sizes: checker_state.dewy)
inst_counter = 0
lib_dir = ""
target_wasm = false
target_windows = false        # (Windows x64: compiler/pe_format.dewy)
target_arm64 = false          # (Linux on arm64: compiler/arm64.jo)
nchk_wanted = false           # (x86-64 Linux: index checks' length loads are their null tests, M_NULLF; main.jo)
target_macos = false          # (macOS on arm64: compiler/arm64.jo, compiler/macho.jo)
main_fn = 0
release_build = false    # (a release build: console.debug is left out)
main_error_payloads = false     # (a debug build, -g: an error reaching main is printed whole)
main_entry_fn = 0        # (a Dewy main giving errors: the entry that reports them and gives the exit code)
main_exit_kinds: int[]   # (its error kinds, in exit-code order, and their codes)
main_exit_codes: int[]
main_exit_pinned: bool[]
test_mode = false        # `dewy test`: run the main file's test blocks instead of main()
expectation_ifs: {int: bool} = {}   # Dewy's `$expect`s: `if not condition { report; return }`
check_all = false        # (dewy check: the tests and the game loop both checked; nothing runs)
test_decls: int[]
update_fn = 0
draw_fn = 0
init_fns: int[]
build_node = 0
program_icon: u8[] = []         # the build block's icon (a PNG), for Windows programs and web pages
program_js = ""                 # the build block's js file's text: in a web page, before the program starts
icon_node = 0                   # PROGRAM_ICON's value: the icon's bytes (Linux windows show it)
program_name = ""               # PROGRAM_NAME: the build block's name, else the main file's (set in check_program)
global_ids: int[]

own_consts: bool[]            # by name: a constant of the program's own (not the library's)

# (a dominating `i =? k` on a local, in force until its branch's scope closes)
struct PositionGuard:
    local: i32
    value: i32
    mark: i32
position_guards: PositionGuard[]

# Scopes are one stack of (name, symbol); each name also links its bindings, newest first, so
# a lookup is one step instead of a scan: check_scopes.top[name] -> newest index, check_scopes.prev[i] -> older one.

# What a name reaches at module level changes only with a binding of that name or with the
# module structure (imports; the universe, complete before checking starts). Each change takes
# the next tick: ml_stamp(name) is the tick as of which name's answers stand, and an answer kept
# with the stamp it was found under holds while the stamp is the same. The editor does without.
ml_tick = 1
ml_struct = 1
ml_name_tick: int[]
game_lookup_ok = true
# By name, the modules (not the prelude) whose own tables bind it: a list through home_next from
# home_first[name] (an entry + 1; 0 ends it), built from every table when first asked (most
# programs' modules use none: Dewy imports) and kept from then on by bind_module_name. A table
# only grows, and only through bind_module_name, so a module not listed binds nothing of the name:
# the lookups through a module's uses ask the listed ones alone. Flat arrays: no allocation a name.
homes_built = false
home_first: int[]
home_mod: int[]
home_next: int[]
# The same bindings indexed for checker_call_queries.dewy's name_family: the prelude's by name
# (0: none), and each module's through a list by name from name_first[name] (an entry + 1; 0
# ends it) of (module, binding). Kept by prelude_bind and name_bind, the tables' only writers
# (the REPL's redefinition clears an entry's binding, name_unbind).
prelude_syms: int[]
name_first: int[]
name_mod: int[]
name_sym: int[]
name_next: int[]
# By module, for checker_call_queries.dewy's collect_fns: 1 a prelude module, 2 a Dewy file
# (mod_bits), and its uses (mod_uses, as modules[m].uses)
mod_bits: int[]
mod_uses: int[][]

# (by module, whether a prelude module is among its uses: then each use is asked in turn)
prelude_used: bool[]

# module_lookup's last answer for each name: the module asked from, the binding, and its stamp
ml_sym: int[]
ml_mod: int[]
ml_at: int[]

# demand_prelude_name, once per name: after its first call for a name it has nothing left to do
# for it (its units are parsed and registered, or it has none; the math runtimes are loaded)
demanded: bool[]
# from m import a, b as c: each name bound in the importing module (functions join any of its
# own with that name, as overloads)
from_imports: int[]

# Dewy source names the builtin types one way: a Sloppy spelling written there (and
# resolved to the builtin, not a binding of the program's) is rejected. Only
# text the source spells counts, not names the compiler builds at its positions.
jo_type_names: bool[]           # (by name)
repl_sig_query = false          # (the REPL's `:type name`: a function's versions go to repl_sig)
repl_sig = ""




late_module_imports = false


# (a module `use`d by another is registered first, so that a top-level `x = ...` there sees the
# used module's x: name_assignable)
registered: bool[]

# ---------------- type resolution ----------------
values_type_ok = false   # (resolve_binding_type: a binding's whole type may be several values)

# Intersection records (`A & B & [f:T]`, dewy_parse's dw_intersection): their
# declaration's operand types, and each record type's operand records, which a
# value of it becomes field by field.
struct_components: {int: int[]} = {}
intersection_parts: {int: int[]} = {}

# ---------------- functions ----------------
# Modules whose parse would have turned the program-wide refinement machinery on, held off
# until one of their declarations is resolved (dewy_prelude_module): `mod` of floats does not
# pay for the refined divisor of `mod` of integers.
refine_deferred: {int: bool}

# (operators get names: ([]) is op_index, shown as such in backtraces: lib/std/backtrace.jo)
OP_NAMES = ["[]", "index", "[]=", "set", "+", "add", "-", "sub", "*", "mul", "/", "div", "%", "mod", "==", "eq", "<", "lt", "^", "pow"]

# (@no_web("why"): a function that does nothing in a browser, said where a web build's program
# calls it)
no_web_warned: {int: bool}


# (--internal-collide-locals, a self-test: a checked loop's index local takes the loop's own
# node number, so a walk reading the loop's c as a node meets the loop again and never ends)
collide_locals = false




# Implementation-language closures capture variables by reference. A variable never modified
# once captured behaves the same when copied, so only the others need LF_SHARED. A modification that
# comes before the capture in the source still counts when a loop around both repeats it.
loop_serials: int[]     # the loops being checked (innermost last)
loop_serial_next = 0


# `const view = @route`: the route's root may not be written while the view
# is still to be used (later in order, or again around a loop begun after it).
struct ConstView:
    view: int
    root: int
    depth: int           # loop_serials.len() at the declaration
    used: int[]          # serials of loops begun after it that use the view
    write: int = 0       # a write not yet followed by a use

const_views: ConstView[]


module_ctx: int[]
module_frames: FnCtx[]


# `x == 6`, `speed + 1`, `true` as a statement: a value made and dropped, which changes nothing
# (written for `=`, `+=` or `return true`)
discarding = false        # (checking `_ = value`: dropped on purpose, no warning)


# ---------------- multiple expressions (docs/design/multi_expressions.md) ----------------
# A Dewy block expresses each non-void value its statements give, in source order, through
# nested statement blocks, `if`/`match` arms and loops. A sink is the context they go to.
# Only blocks that express a value before their end pay for this.
const SINK_NONE = 0       # dropped: module code, a body giving `void`
const SINK_ONE = 1        # one value: the block's last expression; another is an error
const SINK_BODY = 2       # an inferred function body: one value, or a pack of several
const SINK_ARM = 3        # an arm of the `if`/`match` ending a BODY (or ARM): expresses into the BODY
const SINK_COLLECTOR = 4  # loop capture, `[...]` with blocks: pushes onto its accumulator
const SINK_VOID = 5       # a body written `:>void` (or `:>void | E`): expressing a value is an error
const SINK_BIND = 6       # a binding's value, `x = { 1 2 }`: one value, or several it holds as `(T T)`

# (Sink and its modes: checker_exprstmts.dewy)
sinks: Sink[]
# (values a BODY expressed before it needed an accumulator: exprstmts, and whether
# each is a last value, its own or an ARM's)
sink_pending: int[]
sink_pfinal: bool[]
sink_body_mode = -1      # (set just before a function body's check_block)
sink_arm_next = 0        # (the arm block check_if/match_ is about to check as an ARM)
sink_final = 0           # (the expression ending the innermost BODY or ARM)
sink_pack_site = 0       # (the expression where a pack is taken: a consumer sets it)
sink_pack_hit = 0        # (... and a call of a pack function there sets this)
sink_fn = -1             # (the sink of the function body being checked)
or_throw_returns: {int: bool} = {}   # positions of the returns `or_throw` writes (errors.jo)
sink_want_n = 0          # (a written `:>(T T)` body about to open: its count and type)
sink_want_elem = 0
sink_lambda_pack = 0     # (a lambda checked as a function type giving several values: their type)
spread_calls: bool[]   # (by node: calls spread into an array, `[f()...]`: they may give several values)
sink_splice: {int: int[]}        # (a held value's statement: the statements it becomes, sink_hold)
sink_no_tuple = false            # (a body about to open whose values are always pushed onto an array)
sink_bind_next = 0               # (the block a binding is about to check as its value: a BIND ...)
sink_bind_expect = 0             # (... and the several values its written type says it holds)

# Function f's result is written `:>(int64 int64)` (result type node tn): calls give
# several values, and its body must express that many.
# `return value` in a body: a BODY that becomes a pack cannot also return one.
# The call of a function expressing several values: only a consumer that set
# sink_pack_site takes them; everywhere else is a place for one value.
# ---------------- several values as one thing (substitution invariance) ----------------
# A group `(a b)` and a binding holding several values (`pair = (1 2)`, `pair = f()`) have
# type `(T T)`, laid out as a tuple. A call giving several values returns them in an array.
# Either is taken only where its consumer set sink_pack_site: a collector, a statement, a
# body's values, a binding, an unpacking, or call arguments (expanded into several).

values_index_base = 0     # (the base of an index being checked: `pair[0]` says how to index)

# Several values (type t) used at n: taken where a consumer asked; elsewhere it is one value's place.
mv_count = 0

# Blocks run in checker_blocks.dewy; these are its services.
# (a sink opened for b in mode; mode -1 or -2 (wanting a value): how a discarding block's
# values go, worked out here)

pack_result_ok = false

# (how many soa element aliases were made: none, and no name is one)
soa_aliases = 0

# (loops made by map_tidy_first: the map is tidied already)
map_tidied: {int: bool} = {}

# An iterator loop's iterable written with `or_throw` after it (`loop x in inbox or_throw {`),
# by its node: the failures to forward (a type node), or 0 for all of them.
throwing_iters: {int: int} = {}

# A written `loop x in xs` binder (Dewy; O(1) per write, plus one declaration per written
# binder): x starts each step as a copy of the element and belongs to the step, as if the
# loop held `let x = element`. Whether the last write is read is read off LF_READ, which
# each write clears (reads are checked in source order); a write inside a further loop may
# be read by that loop's next round, so any earlier read counts. A use by place may give the
# value on, so it counts as a read unless it is all a statement does (loop_copy_use).
struct LoopCopyWrite:
    pos: int        # the last write
    kept: bool      # it may be read: no dead-store warning
    by_place: bool  # some write passed it by place

loop_copy_writes: {int: LoopCopyWrite} = {}
loop_copy_refined: {int: int} = {}    # a written binder's element type, when refined

# (the value variables of loops over dictionaries: a change is made through the key)
map_loop_values: {int: bool} = {}

# Arrays a Dewy loop iterates by value (`loop x in xs`), while their bodies are
# checked: the loop sees the value at entry, so changing the array's length in
# the body is an error naming the two meanings the program could have wanted.
# (ValueLoop: checker_state.dewy)
value_loops: ValueLoop[]

const ASSIGN_OPS = 0

# Labels belong to active loops in one function-checking context. They cannot
# cross a function boundary, including a closure checked inside the loop.
loop_labels: LoopLabel[]

int_update_lhs = 0      # (the integer binding a compound update is checked for, as `total` in `total += x`,
int_update_pos = 0      # and the update's position)


# Only writes to narrowed aliases need rollback between sibling branches.
# The log avoids scanning all locals or copying checker state for every branch.
narrow_changes: int[]

narrow_jumps: NarrowJump[]



# Index narrowing aliases by their underlying local declaration. Writes visit
# only that root's aliases: O(alias depth + dependent narrowings), with O(1)
# expected indexed links and one entry per narrowing. No scan of all locals.
narrow_store_heads: {int: int}
narrow_store_next: {int: int}

# returns the (possibly replaced) statement node
# `x = ...` in a function, where x is a global declared below the function in the same file:
# that reads like a new local variable, but changes the global, so it gets a warning (a loop
# counter `k` in a helper quietly being the script's `k` further down). Declaring the global
# above the function says it is meant.
late_warned: {int: bool}
# An update through a custom [] / []= pair reads, edits and writes back the
# selected value. Walk from the root outward so nested containers compose:
#     e = pool[h]; e.inventory[i] = v; pool[h] = e
# Receiver indices and the custom index are captured once, in source order.
elem_tmp_n = 0

# Capture an index even when it is a variable: the update's right side may
# change that variable before the selected value is written back.
index_update_sources: {int: int} = {}   # a captured index's name -> the expression it holds (for messages)
index_update_arrays: {int: bool} = {}   # captured names used only to index arrays (facts.jo)





# Dewy's s = "{s}..." on a text variable: appended in place, as s += "..." would be in the
# implementation language; the other copies all of s each time (a loop of them is quadratic).
# The variable is read first either way, so only a local that nothing else can change while
# the rest is evaluated (no closure shares it) is appended to.
interp_appends: {int: bool} = {}

# Assignments run in checker_assigns.dewy; these are its services.
assign_before: int[]    # (selectors captured before the values of the assignments being checked)
# (1 the refined storage written, 2 a refined field's checked store (or 0), 3 a text
# domain's write, 4 an integer domain's)
# The value checked to lt (settle 1: converted to lt, but for a release's zeroed bytes;
# 2: a variable's value of another type refused first)

# `let cursor = @xs[i]`, `let entry = @table[k]`, `let f = @r.a`, `let p = @xs`:
# a local name for the element, entry, field or variable itself, its key or
# index evaluated once.
local_place_count = 0

# A shaped parameter's dimension (dw_shape_prologue): a name already bound to a
# value is checked against the argument's dimension; otherwise the name binds it.
const SHAPE_DIM = 1789

# `x = value` (or `a, b = value`) that declares x, made a declaration; otherwise a spawn's
# handle and a global declared below are looked at
# Sparse preorder events for lowering's integer write proofs. Negative loop
# nodes close the enclosing-loop stack; nested closures contribute only their
# boundary. Save/restore around finalization, which can check other instances.
zonk_write_sites: int[]
zonk_collect_writes = false
# (a function's return type given out while its body is still being checked: what has it may
# change as that body goes on)
type_exposures = 0


# Names used in arms a `$target` or `$build` test left out, by position (dw_target_dropped).
dewy_target_dropped: {int: int[]}






# Count index nodes during the existing finalization walk. A negative summary
# lets lowering avoid path proofs that cannot discover an indexed array.
# Likewise, normal bodies without user globals or narrowed aliases cannot
# disprove closed-program ownership. Init/lambda bodies remain unsummarized.
zonk_indexes = 0
zonk_user_globals = 0

# ---------------- static assertions ----------------
# Closed `$assert` requests keep this constant/evaluator fast path. facts.jo
# queues open scalar requests until checked bodies and helpers have settled;
# runtime values never fall through from a failed fact query into ct_run.
# sa_blocker is the first part that left a constant value unknown.
struct SVal:
    known: bool
    is_str: bool
    i: int
    s: str

sa_blocker = 0

# ---------------- program ----------------
runtime_memeq = -1            # private bounded memory comparison, native lowering
runtime_streq = -1            # private string equality, including nil/empty values
want_cpu_flag = false           # (x86-64 builds: the vectorizer may use __cpu_avx2)
want_loop_watch = false         # (debug web builds: loops count down to __loop_watchdog)
watch_build = false             # (built for `dewy watch`: WATCH is true in the program)
runtime_names = ["__alloc", "__free", "__panic", "__panic_bounds", "__panic_slice", "__panic_unwrap", "__free_obj", "__arr_clone", "__arr_push_slot",
    "__arr_reserve", "__arr_insert_slot", "__arr_remove_slot", "__arr_slice", "__fixed_slice", "__arr_concat", "__str_concat", "__str_eq",
    "__str_cmp", "__str_slice", "__str_append", "__buf_finish", "__buf_append_str", "__arr_resize", "__arr_repeat", "__arr_filled",
    "__print_str", "__str_from_bytes", "__assert_fail", "__hash_bytes", "__str_hash", "__div_zero", "__rc_inc", "__rc_dec",
    "__arr_extend", "__arr_extend_raw", "__rc_dec_test", "__out_flush", "__end_flush", "__box_new", "__box_free", "__box_clone", "__box_defer", "__box_next"]
optional_runtime = ["__requirement_fail", "__panic_narrow", "__mac_syscall"]
float_int_demanded = false     # (a float-to-integer conversion needs __float_int_fail)
runtime_insts: {str: int} = {}
# Runtime pieces with closures of their own are checked only once something needs them: the
# C-call thunks' once an extern is instantiated, vector formatting's and matrix products' where
# the checker meets them (expr.jo). Hello pays for neither.
runtime_ffi_scan = 1
runtime_ffi_done = false





dfs_state: bool[]
skip_main = false
export_decls: int[]
export_fns: int[]
program_named = false         # (the build block gave the name)

# Generated helpers preserve collection semantics and record protocols defined
# alongside their types, including inside arrays, optionals and enum payloads.
value_helper_types: {int: int} = {}  # bit 0: equality, bit 1: hashing
value_equal_fns: {int: int} = {}
value_hash_fns: {int: int} = {}




# ---------------- several values into calls and groups (multi_expressions.md) ----------------
# A group's items or a call's positional arguments, each several-valued one in place of its
# values, in order: `add(pair)` is `add(1 2)` when `pair = (1 2)`. Groups and spread array
# literals are spliced as written; a binding holding several values gives its parts; a call
# giving a static number of them, or a container spread with `...`, is held first (pre).
# Items before a held one that could have an effect are held too: all run in written order.
# call: the call whose arguments these are (0 for a group): a spread array of unknown
# length fills the positional parameters its function has left.
struct ValuesItem:
    count: int      # values it gives (1; k; -1 for an array of unknown length)
    spread: bool    # a container spread with `...`
    hidden: bool    # a binding or a call: how many it gives is not written here

values_hint_pos: int[]      # (inlay hints: where an argument giving several values is ...)
values_hint_first: int[]    # (... the first position its values fill ...)
values_hint_label: str[]    # (... and the parameters they fill, once the call is resolved)
values_hint_mark = 0        # (the first of the hints the arguments being expanded made)
values_hits: bool[]    # (by node: call arguments checked early that gave several values)

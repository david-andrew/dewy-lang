struct Module:
    name: i32
    file: i32
    dir: str
    names: {int: int}
    uses: int[]
    imports: (int, int)[]     # resolved module and import position, for every import form
    decls: int[]
    is_prelude: bool
    is_main: bool
    inits: int[]
    init_fn: i32

const LF_VALUEITER = 33554432 # readonly element of a Dewy array snapshot
const LF_PARAM = 1
const LF_MUTPARAM = 2
const LF_CAPTURE = 4
const LF_ALIAS = 8
const LF_ASSIGNED = 16
const LF_BYREF = 32
const LF_ADDR = 64     # address is taken (must live in memory)
const LF_RESIZED = 128 # the variable itself is written (not just its elements or fields)
const LF_CAPTURED = 256 # a closure captures this variable
const LF_DECL = 512     # declared by `x = value` / `x: T`
const LF_UNNARROWED = 2048  # a narrowed name (alias) whose variable was assigned another type
const LF_SOAELEM = 4096     # loop p in ps (ps a soa array): p stands for ps[i] (see soa_loop)
const LF_SOAMUT = 8192      # ... and the loop is `loop mut`
const LF_ELEMALIAS = 16384  # `mut x in xs` in a combined loop: x stands for xs[k] (writes to x write xs)
const LF_READ = 32768       # its value is read somewhere (not only the base of a write: v.f = 1)
const LF_QUIET = 65536      # a loop counter or part of `a, b = f()`: not warned about when unused
const LF_EXPOSED = 1048576 # raw storage exposure needs owned storage, including private captures
const LF_PARTBORROW = 16777216 # mutable array capture, admitted only by checked scoped partitions
const LF_OWNERBORROW = 8388608 # nonescaping resource capture: pointer, not an owned cell
const LF_VALUECAP = 262144  # Dewy capture owns a snapshot; outer links stop here
const LF_CONST = 131072     # Dewy const: one initialized value, no writes through the binding
const LF_VALUEPARAM = 524288 # a Dewy value parameter's own binding (dw_finish_function): a parameter
                             # in the source, a private mutable copy to the compiler (not LF_PARAM)
assign_root = 0                 # (the variable an assignment being checked writes through)
copy_writes: {int: int} = {}    # local -> where its fields or elements are first written
gcopy_writes: {int: int} = {}   # the same for globals
global_read: bool[]             # by global: its value is read somewhere
open_globals: int[]             # globals made empty (`xs = []`) whose element type is still open

const LF_SHARED = 1024  # modified after a closure captured it, or by the closure: closures and
                        # the function share it by reference (it lives in a heap cell, see lower.jo)

const FK_NORMAL = 0
const FK_LAMBDA = 1
const FK_THUNK = 2
const FK_PARTIAL = 3
const FK_INIT = 4

# Concrete types are interned: their IDs are their equality keys. Keep the
# declaration's instance list for inference-bearing arguments and IDE ordering.
fn_instances: {FnInstanceKey: int} = {}

syms: Sym[] = [Sym()]
modules: Module[]
module_by_path: {str: int} = {}
universe: {int: int} = {}
prelude: {int: int} = {}
locals: Local[] = [Local()]
globals: Global[] = [Global()]
fns: FnInst[] = [FnInst()]
decl_infos: DeclInfo[] = [DeclInfo()]
ctxs: FnCtx[]
cx = -1
check_scopes = CheckerScope()
statement_watch = StatementWatch()  # (the rare tables' sizes: checker_state.dewy)
inst_counter = 0
lib_dir = ""
target_wasm = false
target_windows = false        # (Windows x64: compiler/pe_format.dewy)
target_arm64 = false          # (Linux on arm64: compiler/arm64.jo)
nchk_wanted = false           # (x86-64 Linux: index checks' length loads are their null tests, M_NULLF; main.jo)
target_macos = false          # (macOS on arm64: compiler/arm64.jo, compiler/macho.jo)
main_fn = 0
release_build = false    # (a release build: console.debug is left out)
main_error_payloads = false     # (a debug build, -g: an error reaching main is printed whole)
main_entry_fn = 0        # (a Dewy main giving errors: the entry that reports them and gives the exit code)
main_exit_kinds: int[]   # (its error kinds, in exit-code order, and their codes)
main_exit_codes: int[]
main_exit_pinned: bool[]
test_mode = false        # `dewy test`: run the main file's test blocks instead of main()
expectation_ifs: {int: bool} = {}   # Dewy's `$expect`s: `if not condition { report; return }`
check_all = false        # (dewy check: the tests and the game loop both checked; nothing runs)
test_decls: int[]
update_fn = 0
draw_fn = 0
init_fns: int[]
build_node = 0
program_icon: u8[] = []         # the build block's icon (a PNG), for Windows programs and web pages
program_js = ""                 # the build block's js file's text: in a web page, before the program starts
icon_node = 0                   # PROGRAM_ICON's value: the icon's bytes (Linux windows show it)
program_name = ""               # PROGRAM_NAME: the build block's name, else the main file's (set in check_program)
global_ids: int[]

new_sym = (name: int, kind: SK, r: int, decl: int) -> int:
    syms.push(Sym(i32(name), kind, i32(r), i32(decl), 0))
    syms.len() - 1

own_consts: bool[]            # by name: a constant of the program's own (not the library's)

scope_add_module = (m: int, name: int, kind: SK, r: int, decl: int) -> int:
    ml_bump_name(name)
    # (look the name up in place: holding a copy of the table would make the insert below copy it)
    found: int? = none
    if modules[m].is_prelude: found = prelude.get(name)
    else: found = modules[m].names.get(name)
    if let ex = found:
        if syms[ex].kind == .fns and kind == .fns:
            s = new_sym(name, kind, r, decl)
            if decl != 0 and modules[m].is_prelude: syms[s].surface = i32(dewy_surface(name, decl))
            if modules[m].is_prelude:
                prev = 0
                e = ex
                loop e != 0 and not prelude_decl_before(decl, int(syms[e].decl)):
                    prev = e
                    e = int(syms[e].next)
                syms[s].next = i32(e)
                if prev == 0: prelude_bind(name, s)
                else: syms[prev].next = i32(s)
                return prelude[name]
            e = ex
            loop syms[e].next != 0: e = int(syms[e].next)
            syms[e].next = i32(s)
            return ex
        if decl != 0 and syms[ex].decl != 0:
            if syms[ex].kind == .const_ and kind == .global: fatal(nodes[decl].pos, "'{name_of(name)}' is a constant ({pos_str(nodes[int(syms[ex].decl)].pos)}): it cannot change")
            fatal(nodes[decl].pos, "'{name_of(name)}' is already defined at {pos_str(nodes[int(syms[ex].decl)].pos)}")
    s = new_sym(name, kind, r, decl)
    if kind == .fns and decl != 0 and modules[m].is_prelude: syms[s].surface = i32(dewy_surface(name, decl))
    if modules[m].is_prelude: prelude_bind(name, s)
    else:
        bind_module_name(m, name, s)
        if kind == .const_:
            loop own_consts.len() <= name: own_consts.push(false)
            own_consts[name] = true
    s

# (a dominating `i =? k` on a local, in force until its branch's scope closes)
struct PositionGuard:
    local: i32
    value: i32
    mark: i32
position_guards: PositionGuard[]

# Scopes are one stack of (name, symbol); each name also links its bindings, newest first, so
# a lookup is one step instead of a scan: check_scopes.top[name] -> newest index, check_scopes.prev[i] -> older one.

push_scope_sym = (name: int, sym: int):
    loop check_scopes.top.len() <= name: check_scopes.top.push(-1)
    check_scopes.prev.push(check_scopes.top[name])
    check_scopes.top[name] = check_scopes.names.len()
    check_scopes.names.push(name)
    check_scopes.syms.push(sym)

scope_mark = () -> int: check_scopes.names.len()
scope_reset = (mark: int):
    loop position_guards.len() > 0 and int(position_guards[position_guards.len() - 1].mark) >= mark: position_guards.pop()
    i = check_scopes.names.len() - 1
    loop i >= mark:
        check_scopes.top[check_scopes.names[i]] = check_scopes.prev[i]
        i -= 1
    check_scopes.names.truncate(mark)
    check_scopes.syms.truncate(mark)
    check_scopes.prev.truncate(mark)

# What a name reaches at module level changes only with a binding of that name or with the
# module structure (imports; the universe, complete before checking starts). Each change takes
# the next tick: ml_stamp(name) is the tick as of which name's answers stand, and an answer kept
# with the stamp it was found under holds while the stamp is the same. The editor does without.
ml_tick = 1
ml_struct = 1
ml_name_tick: int[]
ml_bump_name = (name: int):
    ml_tick += 1
    if ml_name_tick.len() <= name: ml_name_tick.resize(name * 2 + 64)
    ml_name_tick[name] = ml_tick
ml_stamp = (name: int) -> int:
    if name < ml_name_tick.len() and ml_name_tick[name] > ml_struct: return ml_name_tick[name]
    ml_struct

# By name, the modules (not the prelude) whose own tables bind it: a list through home_next from
# home_first[name] (an entry + 1; 0 ends it), built from every table when first asked (most
# programs' modules use none: Dewy imports) and kept from then on by bind_module_name. A table
# only grows, and only through bind_module_name, so a module not listed binds nothing of the name:
# the lookups through a module's uses ask the listed ones alone. Flat arrays: no allocation a name.
homes_built = false
home_first: int[]
home_mod: int[]
home_next: int[]
bind_module_name = (m: int, name: int, s: int):
    modules[m].names[name] = s
    if homes_built: home_add(m, name)
    name_bind(m, name, s)

# The same bindings indexed for checker_call_queries.dewy's name_family: the prelude's by name
# (0: none), and each module's through a list by name from name_first[name] (an entry + 1; 0
# ends it) of (module, binding). Kept by prelude_bind and name_bind, the tables' only writers
# (the REPL's redefinition clears an entry's binding, name_unbind).
prelude_syms: int[]
name_first: int[]
name_mod: int[]
name_sym: int[]
name_next: int[]
prelude_bind = (name: int, s: int):
    prelude[name] = s
    if prelude_syms.len() <= name: prelude_syms.resize(name * 2 + 64)
    prelude_syms[name] = s
name_bind = (m: int, name: int, s: int):
    if name_first.len() <= name: name_first.resize(name * 2 + 64)
    e = name_first[name]
    loop e != 0:
        if name_mod[e - 1] == m:
            name_sym[e - 1] = s
            return
        e = name_next[e - 1]
    name_mod.push(m)
    name_sym.push(s)
    name_next.push(name_first[name])
    name_first[name] = name_mod.len()

# By module, for checker_call_queries.dewy's collect_fns: 1 a prelude module, 2 a Dewy file
# (mod_bits), and its uses (mod_uses, as modules[m].uses)
mod_bits: int[]
mod_uses: int[][]

# (by module, whether a prelude module is among its uses: then each use is asked in turn)
prelude_used: bool[]

# The one use of module m whose table can bind name, -1 for none; -2 when its uses must each be
# asked in order (a prelude among them, or more than one module binding the name; bound_in
# tells which may). O(uses).
use_home = (m: int, name: int) -> int:
    if modules[m].uses.len() == 0: return -1
    if not homes_built: homes_build()
    if m < prelude_used.len() and prelude_used[m]: return -2
    if name >= home_first.len() or home_first[name] == 0: return -1
    h = home_first[name] - 1
    if home_next[h] != 0: return -2
    if modules[m].uses.contains(home_mod[h]): home_mod[h] else: -1

# module_lookup's last answer for each name: the module asked from, the binding, and its stamp
ml_sym: int[]
ml_mod: int[]
ml_at: int[]

# demand_prelude_name, once per name: after its first call for a name it has nothing left to do
# for it (its units are parsed and registered, or it has none; the math runtimes are loaded)
demanded: bool[]
demand_name = (name: int):
    if name < demanded.len() and demanded[name]: return
    if demanded.len() <= name: demanded.resize(name * 2 + 64)
    demanded[name] = true
    demand_prelude_name(name)

module_lookup = (m: int, name: int) -> int:
    if name < ml_at.len() and ml_at[name] == ml_stamp(name) and ml_mod[name] == m: return ml_sym[name]
    s = module_lookup_now(m, name)
    if not ide_on:
        if ml_at.len() <= name:
            grown = name * 2 + 64
            ml_at.resize(grown)
            ml_mod.resize(grown)
            ml_sym.resize(grown)
        ml_at[name] = ml_stamp(name)
        ml_mod[name] = m
        ml_sym[name] = s
    s

module_lookup_now = (m: int, name: int) -> int:
    demand_name(name)
    user = m >= 0 and not modules[m].is_prelude
    if m >= 0:
        if modules[m].is_prelude:
            if let s = prelude.get(name): return s
        else:
            if let s = modules[m].names.get(name): return s
            h = use_home(m, name)
            if h >= 0 and not is_private(name):
                if let s = modules[h].names.get(name): return s
            if h == -2:
                loop u in modules[m].uses:
                    if modules[u].is_prelude:
                        if let s = prelude.get(name):
                            if not lib_private(name): return s
                    else if bound_in(u, name):
                        if let s = modules[u].names.get(name):
                            if not is_private(name): return s
            if files[int(modules[m].file)].is_dewy and not is_private(name):
                s = dewy_prelude_lookup(name)
                if s != 0: return s
    if let s = prelude.get(name):
        if not user or not lib_private(name): return s
    if let s = universe.get(name): return s
    0

# from m import a, b as c: each name bound in the importing module (functions join any of its
# own with that name, as overloads)
from_imports: int[]

# Dewy source names the builtin types one way: a Sloppy spelling written there (and
# resolved to the builtin, not a binding of the program's) is rejected. Only
# text the source spells counts, not names the compiler builds at its positions.
jo_type_names: bool[]           # (by name)
jo_type_spelling = (nm: int, s: int, pos: int):
    if jo_type_names.len() == 0:
        loop w in ["str", "byte", "f32", "f64", "i8", "i16", "i32", "i64", "u8", "u16", "u32", "u64"]:
            id = intern(w)
            if jo_type_names.len() <= id: jo_type_names.resize(id + 1)
            jo_type_names[id] = true
    if nm >= jo_type_names.len() or not jo_type_names[nm] or s == 0 or not dewy_at(pos) or (universe.get(nm) ?? 0) != s: return
    w = name_of(nm)
    src = files[pos_file(pos)].src
    off = pos_off(pos)
    stop = off + len(w)
    if stop > len(src) or (stop < len(src) and is_ident_char(src[stop])): return
    loop i in [0..len(w)):
        if src[off + i] != w[i]: return
    dewy = dewy_type_word(w)
    fatal(pos, "`{w}` is not a Dewy type name: write `{dewy}`")

repl_sig_query = false          # (the REPL's `:type name`: a function's versions go to repl_sig)
repl_sig = ""

cur_mod = () -> int:
    if cx >= 0: return int(ctxs[cx].mod)
    0

# The current module binds name itself, by a declaration or `from m import name`: its
# choice, which Dewy's own reading of a prelude name (the strict `to_int`, a grapheme
# `find`) does not replace: an import may shadow the prelude's. O(1).
bound_here = (name: int) -> bool:
    m = cur_mod()
    m >= 0 and m < modules.len() and not modules[m].is_prelude and modules[m].names.has(name)




late_module_imports = false
# The seed resolves this entry directly from expr.jo's checker import.
ensure_bundled_import = (file: str, alias: str, pos: int): register_bundled_import(file, alias, pos)



# The names in a destructuring pattern, in source order. Keep the tree until
# checking the source type; registration and declaration detection need leaves.
binding_leaves = (bindings: int[]) -> int[]: flatten_binding_leaves(bindings)

# `x = value` where no variable x exists yet is a declaration
# (m >= 0: at the top level of module m, where only that module's globals count)
assign_declares = (s: int, m: int) -> bool:
    if nodes[s].kind != .assign or nodes[s].op != i32(int(Tok.assign)): return false
    lhs = int(nodes[s].a)
    lk = nodes[lhs].kind
    if lk == .ident: return not name_assignable(int(nodes[lhs].name), m)
    if lk != .tuple: return false
    any = false
    loop c in binding_leaves(kids(lhs)):
        ck = nodes[c].kind
        if ck == .hole: continue
        if ck != .ident: return false
        if name_assignable(int(nodes[c].name), m): return false
        any = true
    any

# (at the top level: the module's own variables, and those of the modules it `use`s and of the
# library, as in a function: `ui_style = ...` there changes the library's, not a new one)
# Another module's __ name (its own state) is not changed so: the line makes one of this module's
# (and in the library, whose modules share their names, it is an error to have two)
name_assignable = (nm: int, m: int) -> bool:
    if m < 0: return var_visible(nm)
    s = module_lookup(m, nm)
    if s == 0 or syms[s].kind != .global: return false
    if is_private(nm) and int(globals[int(syms[s].ref)].mod) != m: return false
    true

assign_to_decl = (s: int):
    lhs = int(nodes[s].a)
    if nodes[lhs].kind == .ident and files[pos_file(nodes[s].pos)].is_dewy:
        cs = lookup(int(nodes[lhs].name))
        if cs != 0 and syms[cs].kind == .const_ and not decl_shadowable(int(syms[cs].decl)):
            fatal(nodes[lhs].pos, "cannot modify const '{name_of(int(nodes[lhs].name))}'; use let to declare a new binding")
        # (a module's function is a const binding too: only a `$shadowable` one, as the
        # prelude's are, is shadowed by a plain `name = ...`)
        if cs != 0 and syms[cs].kind == .fns and syms[cs].decl != 0 and not decl_shadowable(int(syms[cs].decl)) and cx >= 0:
            fatal(nodes[lhs].pos, "'{name_of(int(nodes[lhs].name))}' is a function ({pos_str(nodes[int(syms[cs].decl)].pos)}): it cannot be shadowed by assignment; use let to declare a new binding")
    if nodes[lhs].kind == .ident and cx >= 0 and int(nodes[lhs].name) < own_consts.len() and own_consts[int(nodes[lhs].name)]:
        # (MAX = 4 would make a variable hiding the program's constant MAX)
        cs = lookup(int(nodes[lhs].name))
        if cs != 0 and syms[cs].kind == .const_ and syms[cs].decl != 0 and not decl_shadowable(int(syms[cs].decl)):
            cn = name_of(int(nodes[lhs].name))
            cp = nodes[int(syms[cs].decl)].pos
            if pos_in_lib(cp): fatal(nodes[lhs].pos, "'{cn}' is a constant of the library: it cannot change (`let {cn} = ...` makes a variable of that name)")
            ln, cc = line_col(cp)
            fatal(nodes[lhs].pos, "'{cn}' is a constant (`const` on line {ln}): it cannot change; to change it as the game runs, make it a variable there, without `const`")
    nodes[s].kind = .vardecl
    nodes[s].a = 0
    if nodes[lhs].kind == .ident:
        nodes[s].name = nodes[lhs].name
        nodes[s].pos = nodes[lhs].pos
    else:
        nodes[s].list = nodes[lhs].list
        nodes[s].nlist = nodes[lhs].nlist

# (a module `use`d by another is registered first, so that a top-level `x = ...` there sees the
# used module's x: name_assignable)
registered: bool[]

register_decls = (m: int, decls: int[]):
    loop d in decls:
        nodes[d].mod = i32(m)
        if nodes[d].kind == .assign and assign_declares(d, m): assign_to_decl(d)
        k = nodes[d].kind
        nm = int(nodes[d].name)
        # (on_hit = (n: int): ... after `on_hit: (int) -> void = ...`: a new value for that variable)
        if k == .fn_ and not modules[m].is_prelude and not has_flag(d, NF_EXTERN):
            if let ex = modules[m].names.get(nm):
                if syms[ex].kind == .global:
                    lam = mk(.lambda, nodes[d].pos)
                    nodes[lam] = nodes[d]
                    nodes[lam].kind = .lambda
                    nodes[lam].name = 0
                    nodes[d] = nodes[bc_assign(bc_ident(name_of(nm), nodes[d].pos), lam, nodes[d].pos)]
                    nodes[d].mod = i32(m)
                    modules[m].inits.push(d)
                    continue
        if k == .fn_:
            scope_add_module(m, nm, .fns, 0, d)
            if nodes[d].c != 0:
                loop ai in [0..nkids(int(nodes[d].c))):
                    if name_of(int(nodes[kid(int(nodes[d].c), ai)].name)) == "export": export_decls.push(d)
        else if k == .struct_:
            if nominal_ready and nominal_declaration(d): fatal(nodes[d].pos, "nominal types must be declared before function checking; late nominal imports are not yet implemented")
            scope_add_module(m, nm, .struct_, d, d)
        else if k == .enum_: scope_add_module(m, nm, .enum_, d, d)
        else if k == .typealias: scope_add_module(m, nm, .alias_, d, d)
        else if k == .const_:
            globals.push(Global(name = i32(nm), decl = i32(d), mod = i32(m), is_const = true))
            scope_add_module(m, nm, .const_, globals.len() - 1, d)
        else if k == .import_:
            rel = name_of(int(nodes[d].sval))
            path = "{modules[m].dir}/{rel}.jo"
            if nodes[d].aux2 == 1:
                # use 'file.jo': relative to the importing file
                path = use_path(rel, modules[m].dir, lib_dir)
                # ('package/file.jo': a file of a package)
                pn = package_name(rel)
                if not starts_with(rel, "@lib/") and not file_exists(path) and len(pn) > 0:
                    if let why = pkg_errs.get(pn): fatal(nodes[d].pos, why)
                    if let pd = pkg_dirs.get(pn): path = package_file(rel, pd)
                if not file_exists(path):
                    watch_missing_input(path)
                    fatal(nodes[d].pos, "cannot find '{rel}' (looked for {path})")
            else if pkg_dirs.get(rel) != none or pkg_errs.get(rel) != none:
                # a package (pkg.jo): its main file
                if let why = pkg_errs.get(rel): fatal(nodes[d].pos, why)
                pd = pkg_dirs[rel]
                path = pkg_main(rel, pd) ?? ""
                if len(path) == 0: fatal(nodes[d].pos, "package '{rel}' has no main file ({rel}.jo, or only one .jo file at its root): import one of its files, as import '{rel}/file.jo'")
            else:
                # Named modules may be written in either language. Prefer the
                # importer's language within each directory; local files win.
                # Exclude the importing file itself (physics.dewy may import
                # the bundled physics implementation).
                current = files[int(modules[m].file)].path
                dewy = files[int(modules[m].file)].is_dewy
                stems = module_search_stems(modules[m].dir, lib_dir, rel)
                path = module_source(stems[0], dewy, current, true)
                # (a file beside it with a library module's name: that file, said once)
                if len(path) > 0 and not pos_in_lib(nodes[d].pos) and len(module_source(stems[1], dewy)) > 0:
                    warn(nodes[d].pos, "this imports {path}, not the library's {rel} (a file beside this one has its name)")
                searched = 1
                loop len(path) == 0 and searched < stems.len():
                    path = module_source(stems[searched], dewy)
                    searched += 1
                if len(path) == 0: fatal(nodes[d].pos, "cannot find module '{rel}'{missing_module_hint(rel)}")
            # (the library behind `bigint` is the compiler's: the type is built in)
            if path == lib_dir + "/bigint.dewy" and not starts_with(name_of(int(nodes[d].name)), "$") and files[int(modules[m].file)].is_dewy and not pos_in_lib(nodes[d].pos):
                fatal(nodes[d].pos, "`bigint` is built in, so there is nothing to import: `let n:bigint = 2^100`, and `to_int(text)` reads decimal text (`none` when it is not a number)")
            im = load_module(path, false, nodes[d].pos)
            modules[m].imports.push((im, nodes[d].pos))
            import_edge_added()
            if nodes[d].aux == 1:
                ml_bump()
                use_added(m, im)
                register_module(im)
            else if nodes[d].aux == 2 or nodes[d].aux == 3:
                # from x import a, b (and Dewy's import p"x.dewy", every name): bound once every
                # module's names are known (bind_from_imports)
                nodes[d].sym = i32(im)
                from_imports.push(d)
            else: scope_add_module(m, nm, .module, im, d)
        else if k == .when_: eval_when_toplevel(m, d)
        else if k == .build_:
            if modules[m].is_main: build_node = d
        else if k == .test_:
            if test_mode and modules[m].is_main: test_decls.push(d)
        else if k == .vardecl:
            if nodes[d].nlist > 0:
                loop id in binding_leaves(kids(d)):
                    if nodes[id].kind == .hole: continue
                    g = new_global(int(nodes[id].name), d, m)
                    nodes[id].sym = i32(g)
                    add_flag(id, NF_GLOBAL)
                    scope_add_module(m, int(nodes[id].name), .global, g, id)
            else:
                g = new_global(nm, d, m)
                nodes[d].sym = i32(g)
                scope_add_module(m, nm, .global, g, d)
            add_flag(d, NF_GLOBAL)
            if not modules[m].is_prelude: modules[m].inits.push(d)
        else:
            if modules[m].is_prelude: fatal(nodes[d].pos, "statements are not allowed at the top level of library modules")
            modules[m].inits.push(d)

# is there a variable of this name in scope (assigning to it changes it)?
var_visible = (nm: int) -> bool:
    s = lookup(nm)
    if s == 0: return false
    k = syms[s].kind
    k == .local or k == .global

# ---------------- type resolution ----------------
values_type_ok = false   # (resolve_binding_type: a binding's whole type may be several values)
resolve_type_name = (tn: int) -> CheckerTypeName:
    if nodes[tn].aux == -8: fatal(nodes[tn].pos, "Effect row is not a value type")
    nm = int(nodes[tn].name)
    s = 0
    if nodes[tn].sval != 0:
        # (`(@w).Closed`: a type a named wait gives, decisions.md batch 7)
        wait_member = named_wait_type(tn)
        if wait_member != 0: return CheckerTypeName(0, wait_member)
        ms = lookup(int(nodes[tn].sval))
        if ms != 0 and syms[ms].kind == .reflected and name_of(nm) == "type": return CheckerTypeName(0, int(fields[int(syms[ms].ref)].type))
        # (`heart.<Tick>`: the type itself, selected on a wait, decisions.md batch 7)
        if ms != 0 and (syms[ms].kind == .local or syms[ms].kind == .global) and name_of(nm) == "<>":
            if nkids(tn) != 1: fatal(nodes[tn].pos, "`{name_of(int(nodes[tn].sval))}.<T>` selects one type")
            return CheckerTypeName(0, resolve_type(kid(tn, 0)))
        # (`r.Png`, `heart.Tick`: a value's type member, decisions.md batch 7)
        if ms != 0 and syms[ms].kind != .module:
            member = value_type_member(ms, nm, nodes[tn].pos)
            if member != 0: return CheckerTypeName(0, member)
            if syms[ms].kind == .local or syms[ms].kind == .global:
                q = name_of(int(nodes[tn].sval))
                vt = if syms[ms].kind == .local: int(locals[int(syms[ms].ref)].type) else: int(globals[int(syms[ms].ref)].type)
                why = handle_member_error(q, vt, nm)
                if len(why) > 0: fatal(nodes[tn].pos, why)
                fatal(nodes[tn].pos, "'{q}' has no member '{name_of(nm)}' that is a type")
        if ms == 0 or syms[ms].kind != .module: fatal(nodes[tn].pos, "unknown module '{name_of(int(nodes[tn].sval))}'")
        s = module_lookup(int(syms[ms].ref), nm)
        if name_of(int(nodes[tn].sval))[0] != '$' and files[pos_file(nodes[tn].pos)].is_dewy: rational_one_spelling(int(syms[ms].ref), nm, nodes[tn].pos, "")
    else:
        if ide_sentinel != 0 and nm == ide_sentinel: ide_complete_types()
        s = lookup(nm)
        jo_type_spelling(nm, s, nodes[tn].pos)
        if nm == ut_safe_name: ut_note_type_name(nm, nodes[tn].pos)
        # `rational`: the builtin exact type (the bundled library's), unless a type shadows it.
        if name_of(nm) == "rational" and (s == 0 or syms[s].kind == .fns) and files[pos_file(nodes[tn].pos)].is_dewy:
            return CheckerTypeName(5, 0)
    # `secret<T>`: the builtin wrapper (types.jo's mk_secret), unless a type shadows it
    if nm == secret_name and nodes[tn].sval == 0 and (s == 0 or not secret_type_sym(syms[s].kind)):
        if nkids(tn) != 1: fatal(nodes[tn].pos, jd(nodes[tn].pos, "`secret` takes one type argument: `secret[str]`", "`secret` takes one type argument: `secret<string>`"))
        return CheckerTypeName(4, 0)
    if s == 0:
        if name_of(nm) == "none": return CheckerTypeName(0, T_NONE)
        # (push = (h: mut Heap[T], x: T): a generic function names its type parameters)
        tn_s = name_of(nm)
        if len(tn_s) <= 2 and tn_s[0] >= 'A' and tn_s[0] <= 'Z' and cx >= 0 and fns.len() > int(ctxs[cx].inst):
            fatal(nodes[tn].pos, jd(nodes[tn].pos, "unknown type '{tn_s}' (a generic function names its type parameters after its name: `f[{tn_s}] = (x: {tn_s}) -> {tn_s}: ...`; a generic struct, `struct Heap[{tn_s}]:`)", "unknown type '{tn_s}' (a generic function declares its type parameters first: `f = <{tn_s}>(x:{tn_s}):>{tn_s} => ...`; a generic record, `Heap:type = <{tn_s}>[items:array<{tn_s}>]`)"))
        if name_of(nm) == "Cancelled": fatal(nodes[tn].pos, "unknown type `Cancelled`; use `Canceled` (US spelling)")
        fatal(nodes[tn].pos, "unknown type '{name_of(nm)}'{suggestion(name_of(nm), type_names())}")
    sk = syms[s].kind
    # (str = (b: Big) -> str: a function of the program's named as a type, its `str` there
    # still the type)
    if sk == .fns:
        if let u = universe.get(nm):
            s = u
            sk = syms[s].kind
    if ide_on: ide_sym_ref(tn, s)
    if sk == .alias_: return CheckerTypeName(1, int(syms[s].ref))
    if sk == .type_:
        t = int(syms[s].ref)
        if nodes[tn].nlist == 0:
            if tkind(t) == .effect: fatal(nodes[tn].pos, "Effect row is not a value type")
            return CheckerTypeName(0, nominal_family(t))
        return CheckerTypeName(3, t)
    if sk == .struct_ or sk == .enum_:
        d = int(syms[s].ref)
        if nkids2(d) == 0 and nkids(tn) == 0: return CheckerTypeName(0, nominal_family(get_struct_inst(d, [])))
        # (`<Closed>`, `is? Closed`: every instance, while a test's type is resolved)
        if bare_generic_ok and nkids(tn) == 0 and nkids2(d) > 0 and nodes[kid2(d, 0)].b == 0:
            family = generic_family_type(d)
            if family != 0: return CheckerTypeName(0, family)
        return CheckerTypeName(2, d)
    if dewy_at(nodes[tn].pos):
        integer = named_integer_type(tn, s)
        if integer != 0: return CheckerTypeName(0, integer)
    h = habit_name(name_of(nm))
    if len(h) > 0: fatal(nodes[tn].pos, "'{name_of(nm)}' is not a type (use {h})")
    fatal(nodes[tn].pos, "'{name_of(nm)}' is not a type")
    CheckerTypeName()

binding_const_init = (kind: SK, ref: int, pos: int) -> int:
    if kind == .const_:
        if globals[ref].init != 0: return int(globals[ref].init)
        if globals[ref].decl != 0: return int(nodes[int(globals[ref].decl)].b)
    else if kind == .global and readonly_global(ref):
        ensure_global(ref, pos)
        return int(nodes[int(globals[ref].decl)].b)
    else if kind == .local:
        let ref = ref
        loop int(locals[ref].flags) & LF_CAPTURE != 0: ref = int(locals[ref].outer)
        if int(locals[ref].flags) & LF_CONST != 0: return int(locals[ref].const_init)
    0


# A generic type's arguments with those left out filled in from its declaration: `Date` is
# `Date<Gregorian>` when it says `<C=Gregorian>`. The defaults read in the declaration's own scope.
type_param_defaults = (d: int, targs: int[], inferred: int[] = []) -> int[]:
    if targs.len() >= nkids2(d): return targs
    out = targs
    loop i in [targs.len()..nkids2(d)):
        if i < inferred.len() and inferred[i] != 0:
            out.push(inferred[i])
            continue
        fallback = int(nodes[kid2(d, i)].b)
        if fallback == 0: return targs
        saved = cx
        ctxs.push(FnCtx(i32(new_inst(FK_INIT, int(nodes[d].mod), "typedef")), -1, i32(T_VOID), false, 0, nodes[d].mod, i32(check_scopes.names.len())))
        cx = ctxs.len() - 1
        mark = scope_mark()
        out.push(resolve_type(fallback))
        scope_reset(mark)
        ctxs.pop()
        cx = saved
    out

subst = (t0: int, targs: int[]) -> int: ts_subst(t0, targs)

# Intersection records (`A & B & [f:T]`, dewy_parse's dw_intersection): their
# declaration's operand types, and each record type's operand records, which a
# value of it becomes field by field.
struct_components: {int: int[]} = {}
intersection_parts: {int: int[]} = {}

check_struct_fields = (si: int):
    if structs[si].resolved: return
    cf_check_struct_fields(si)

module_of_type = (t0: int) -> int:
    t = prune(t0)
    k = types[t].kind
    if (k == .struct_ or k == .enum_) and types[t].st != 0 or (k == .struct_ or k == .enum_): return int(nodes[int(structs[int(types[t].st)].decl)].mod)
    -1

# The modules whose functions are methods of t: its own, then those of the types it is
# minted under (a minted child has its parents' methods, wherever they were declared)
method_modules = (t0: int) -> int[]:
    out: int[]
    t = prune(t0)
    loop t != 0:
        m = module_of_type(t)
        if m >= 0 and not out.contains(m): out.push(m)
        t = nominal_parent.get(t, 0)
    out

# ---------------- functions ----------------
decl_info = (decl: int) -> int:
    if nodes[decl].sym != 0: return int(nodes[decl].sym)
    cs_decl_info(decl)

# Modules whose parse would have turned the program-wide refinement machinery on, held off
# until one of their declarations is resolved (dewy_prelude_module): `mod` of floats does not
# pay for the refined divisor of `mod` of integers.
refine_deferred: {int: bool}

# (operators get names: ([]) is op_index, shown as such in backtraces: lib/std/backtrace.jo)
OP_NAMES = ["[]", "index", "[]=", "set", "+", "add", "-", "sub", "*", "mul", "/", "div", "%", "mod", "==", "eq", "<", "lt", "^", "pow"]

sanitize = (s: str) -> str:
    if len(s) > 0 and not is_alnum(s[0]) and s[0] != '_':
        i = 0
        loop i < OP_NAMES.len():
            if OP_NAMES[i] == s: return "op_{OP_NAMES[i + 1]}"
            i += 2
        return "op"
    # (a name of letters and digits, not too long, is its own)
    plain = len(s) <= 41
    loop c in s:
        if not plain: break
        if not is_alnum(c): plain = false
    if plain: return s
    b: u8[]
    loop c in s:
        if is_alnum(c): b.push(c)
        else: b.push('X')
        if b.len() > 40: break
    str_from_bytes(b)

# (@no_web("why"): a function that does nothing in a browser, said where a web build's program
# calls it)
no_web_warned: {int: bool}

get_fn_inst = (decl: int, targs: int[], use_pos: int) -> int: ci_get_fn_inst(decl, targs, use_pos)


# (--internal-collide-locals, a self-test: a checked loop's index local takes the loop's own
# node number, so a walk reading the loop's c as a node meets the loop again and never ends)
collide_locals = false
collide_local = (s: int):
    if collide_locals and locals.len() < s: locals.resize(s)

new_local = (name: int, t: int, pos: int) -> int:
    inst = int(ctxs[cx].inst)
    locals.push(Local(name = i32(name), type = i32(t), owner = i32(inst), pos = pos, dloops = i32(loop_serials.len())))
    l = locals.len() - 1
    fns[inst].locals.push(l)
    if name != 0 and name_of(name) != "_": push_scope_sym(name, new_sym(name, .local, l, 0))
    l





# Implementation-language closures capture variables by reference. A variable never modified
# once captured behaves the same when copied, so only the others need LF_SHARED. A modification that
# comes before the capture in the source still counts when a loop around both repeats it.
loop_serials: int[]     # the loops being checked (innermost last)
loop_serial_next = 0


# `const view = @route`: the route's root may not be written while the view
# is still to be used (later in order, or again around a loop begun after it).
struct ConstView:
    view: int
    root: int
    depth: int           # loop_serials.len() at the declaration
    used: int[]          # serials of loops begun after it that use the view
    write: int = 0       # a write not yet followed by a use

const_views: ConstView[]

# root variable r is modified (inside a closure if via_closure)
note_write = (r: int, via_closure: bool, pos: int):
    if files[pos_file(locals[r].pos)].is_dewy: return
    f = int(locals[r].flags)
    if via_closure or f & LF_CAPTURED != 0:
        locals[r].flags = i32(f | LF_SHARED)
        check_shareable(r, pos)
    else:
        d = int(locals[r].dloops)
        if loop_serials.len() > d: locals[r].wloop = i32(loop_serials[d])


module_ctx: int[]
module_frames: FnCtx[]

# Module state outlives a check, but temporary function contexts are a stack.
# Keep inactive module frames outside that stack so loading another module
# during an expression cannot interfere with its caller's push/pop lifetime.
enter_module_context = (m: int) -> bool:
    if module_ctx[m] >= 0: return false
    module_ctx[m] = ctxs.len()
    ctxs.push(module_frames[m])
    true

# the global a narrowed name's place (g.f narrowed by `is`) belongs to, or -1
alias_global = (l: int) -> int:
    if int(locals[l].flags) & LF_ALIAS == 0 or locals[l].alias == 0: return -1
    n = int(locals[l].alias)
    loop nodes[n].kind == .field or nodes[n].kind == .index or nodes[n].kind == .narrow or nodes[n].kind == .unwrap or nodes[n].kind == .conv: n = int(nodes[n].a)
    if nodes[n].kind == .ident and nodes[n].aux == i32(int(SK.global)): return int(nodes[n].sym)
    -1

# (in_flow: its declaration reached among the top-level statements, after what they narrowed,
# `if r == none: panic(...)` say, which it then sees; elsewhere it is checked on its own)
ensure_global = (g: int, use_pos: int, in_flow: bool = false):
    if globals[g].state == 2: return
    if globals[g].state == 1:
        gn = name_of(int(globals[g].name))
        global_cycle_across_modules(g, use_pos)
        fatal(use_pos, "'{gn}' is used in its own first value, before it has one: give it one first ({jd(use_pos, "`{gn} = 0`", "`let {gn} = 0`")} on a line above), then change it")
    globals[g].state = 1
    ensuring_globals.push(g)
    saved = cx
    m = int(globals[g].mod)
    entered = enter_module_context(m)
    flow = in_flow and cx == module_ctx[m]
    cx = module_ctx[m]
    saved_floor = ctxs[cx].floor
    if not flow: ctxs[cx].floor = i32(check_scopes.names.len())
    d = int(globals[g].decl)
    if globals[g].is_const:
        t = 0
        if nodes[d].a != 0:
            ref_holder_arm(int(nodes[d].a), int(nodes[d].name))
            t = resolve_binding_type(int(nodes[d].a))
        cl = clone(int(nodes[d].b))
        et = values_init(cl, t)
        cl = last_checked
        if t != 0: cl = coerce(cl, t)
        else if has_flag(cl, NF_LITERAL):
            t = lit_default(cl)
        else: t = et
        globals[g].type = i32(zonk(t))
        globals[g].init = nodes[d].b      # unchecked original: each use checks a fresh copy
    else if nodes[d].nlist > 0:
        if not has_flag(d, NF_CHECKED):
            t = check_binding_input(d)
            unpacked = unpack_binding(int(nodes[d].b), t, kids(d), nodes[d].pos)
            t = unpacked.0
            set_list(d, unpacked.1)
            nodes[d].b = i32(last_checked)
            if types[t].kind != .tuple or int(types[t].nargs) != nkids(d): fatal(nodes[d].pos, "expected a tuple with {nkids(d)} elements (or an array), found {dt(t)}")
            loop k in [0..nkids(d)):
                id = kid(d, k)
                if nodes[id].kind == .hole: continue
                gg = int(nodes[id].sym)
                globals[gg].type = i32(zonk(targ(t, k)))
                globals[gg].state = 2
            add_flag(d, NF_CHECKED)
            nodes[d].type = i32(t)
    else:
        t = 0
        if nodes[d].a != 0:
            ref_holder_arm(int(nodes[d].a), int(nodes[d].name))
            t = resolve_binding_type(int(nodes[d].a))
        if refine_active and types[prune(t)].kind == .refined and nodes[d].b == 0: nodes[d].b = i32(struct_default(t, nodes[d].pos))
        # (x: T, a struct with default field values: it starts with them)
        if nodes[d].b == 0 and t != 0: nodes[d].b = i32(struct_default(t, nodes[d].pos))
        # (Dewy's `let g:T` with no value: given one before any read, dg_check_program)
        if nodes[d].b == 0 and dewy_at(nodes[d].pos): dg_record(g)
        tk_unit = 0
        if nodes[d].b != 0:
            global_place_decl(d)
            if t == 0 and dewy_at(nodes[d].pos): tk_unit = tk_literal_unit(int(nodes[d].b))
            et = values_init(int(nodes[d].b), t)
            nodes[d].b = i32(last_checked)
            if quat_nodes.has(int(nodes[d].b)): quat_globals[g] = true
            if t != 0: nodes[d].b = i32(coerce(int(nodes[d].b), t))
            else:
                t = et
                if has_flag(int(nodes[d].b), NF_LITERAL):
                    t = decimal_binding_type(nodes[d].pos, lit_default(int(nodes[d].b)))
                    nodes[d].b = i32(coerce(int(nodes[d].b), t))
                    decimal_global(g, nodes[d].pos, t)
                else if is_quantity(t):
                    exact = t
                    t = decimal_quantity_start(nodes[d].pos, int(nodes[d].b), exact)
                    if t != exact: nodes[d].b = i32(coerce(int(nodes[d].b), t))
                    decimal_global(g, nodes[d].pos, t)
        t = zonk(t)
        if t == 0: fatal(nodes[d].pos, "global needs a type or a value")
        if tk_unit != 0:
            t = temperature_binding(d, t, tk_unit, true)
            tk_bindings[-g - 1] = d
        if has_var(prune(t)):
            # (enemies = [] at the top level: its elements' type comes from a function that pushes
            # one, as a local's does; settled once everything is checked)
            vk = nodes[int(nodes[d].b)].kind
            if nodes[d].a == 0 and vk == .array and nkids(int(nodes[d].b)) == 0 and tkind(t) == .array: open_globals.push(g)
            else: fatal(nodes[d].pos, "cannot infer the type of '{name_of(int(globals[g].name))}'; add a type annotation{empty_hint(name_of(int(globals[g].name)), t)}")
        if tkind(t) == .void_:
            if empty_braces(int(nodes[d].b)): fatal(nodes[d].pos, empty_braces_text(name_of(int(globals[g].name))))
            fatal(nodes[d].pos, "cannot assign a value of type void")
        if tkind(t) == .null_: fatal(nodes[d].pos, "`null` is for C's pointers; a value that may be missing is `none`, with its type written: {jd(nodes[d].pos, "`{name_of(int(globals[g].name))}: Enemy? = none`", "`let {name_of(int(globals[g].name))}:Enemy? = none`")}")
        if tkind(t) == .typeval or tkind(t) == .module: fatal(nodes[d].pos, "'{name_of(int(globals[g].name))}' cannot hold a type or module (a value of a type is made by calling it: `T()`)")
        globals[g].type = i32(t)
        if t == T_STR and nodes[d].a == 0 and dewy_at(nodes[d].pos): string_domain_declare(-g - 1, int(nodes[d].b))
        else if t == T_MATH_INT and nodes[d].a == 0 and dewy_at(nodes[d].pos): int_domain_declare(-g - 1, int(nodes[d].b))
        # Exact quantity constants have no runtime storage or initialization.
        if has_flag(d, NF_RDONLY) and is_quantity(t) and quantity_constant_scale(int(nodes[d].b)) >= 0:
            globals[g].is_const = true
            globals[g].init = nodes[d].b
            nodes[d].kind = .const_
        add_flag(d, NF_CHECKED)
    globals[g].state = 2
    ensuring_globals.pop()
    ctxs[cx].floor = saved_floor
    leave_module_context(m, entered)
    cx = saved


# `x == 6`, `speed + 1`, `true` as a statement: a value made and dropped, which changes nothing
# (written for `=`, `+=` or `return true`)
discarding = false        # (checking `_ = value`: dropped on purpose, no warning)


# ---------------- multiple expressions (docs/design/multi_expressions.md) ----------------
# A Dewy block expresses each non-void value its statements give, in source order, through
# nested statement blocks, `if`/`match` arms and loops. A sink is the context they go to.
# Only blocks that express a value before their end pay for this.
const SINK_NONE = 0       # dropped: module code, a body giving `void`
const SINK_ONE = 1        # one value: the block's last expression; another is an error
const SINK_BODY = 2       # an inferred function body: one value, or a pack of several
const SINK_ARM = 3        # an arm of the `if`/`match` ending a BODY (or ARM): expresses into the BODY
const SINK_COLLECTOR = 4  # loop capture, `[...]` with blocks: pushes onto its accumulator
const SINK_VOID = 5       # a body written `:>void` (or `:>void | E`): expressing a value is an error
const SINK_BIND = 6       # a binding's value, `x = { 1 2 }`: one value, or several it holds as `(T T)`

# (Sink and its modes: checker_exprstmts.dewy)
sinks: Sink[]
# (values a BODY expressed before it needed an accumulator: exprstmts, and whether
# each is a last value, its own or an ARM's)
sink_pending: int[]
sink_pfinal: bool[]
sink_body_mode = -1      # (set just before a function body's check_block)
sink_arm_next = 0        # (the arm block check_if/match_ is about to check as an ARM)
sink_final = 0           # (the expression ending the innermost BODY or ARM)
sink_pack_site = 0       # (the expression where a pack is taken: a consumer sets it)
sink_pack_hit = 0        # (... and a call of a pack function there sets this)
sink_fn = -1             # (the sink of the function body being checked)
or_throw_returns: {int: bool} = {}   # positions of the returns `or_throw` writes (errors.jo)
sink_want_n = 0          # (a written `:>(T T)` body about to open: its count and type)
sink_want_elem = 0
sink_lambda_pack = 0     # (a lambda checked as a function type giving several values: their type)
spread_calls: bool[]   # (by node: calls spread into an array, `[f()...]`: they may give several values)
sink_splice: {int: int[]}        # (a held value's statement: the statements it becomes, sink_hold)
sink_no_tuple = false            # (a body about to open whose values are always pushed onto an array)
sink_bind_next = 0               # (the block a binding is about to check as its value: a BIND ...)
sink_bind_expect = 0             # (... and the several values its written type says it holds)

# Function f's result is written `:>(int64 int64)` (result type node tn): calls give
# several values, and its body must express that many.
# `return value` in a body: a BODY that becomes a pack cannot also return one.
# The call of a function expressing several values: only a consumer that set
# sink_pack_site takes them; everywhere else is a place for one value.
# ---------------- several values as one thing (substitution invariance) ----------------
# A group `(a b)` and a binding holding several values (`pair = (1 2)`, `pair = f()`) have
# type `(T T)`, laid out as a tuple. A call giving several values returns them in an array.
# Either is taken only where its consumer set sink_pack_site: a collector, a statement, a
# body's values, a binding, an unpacking, or call arguments (expanded into several).

values_index_base = 0     # (the base of an index being checked: `pair[0]` says how to index)

# Several values (type t) used at n: taken where a consumer asked; elsewhere it is one value's place.
mv_count = 0

# `value` pushed (or a pack extended) onto sink i's accumulator, in exprstmt s.
# The value(s) of exprstmt s, a statement of BODY/BIND i's own block while their number is
# static, held in locals: the block gives them at its end as `(T T)` (sink_close), with no
# array. A BODY's values have one type, as an array's elements would.
# Several values held as one `(T T)` (a group or a binding) expressed into sink i: each pushed.
# Sink i's pending values pushed in order (it needs an accumulator after all).
# Exprstmt s gives a value of type t in the innermost sink (a pack when `pack`).
# A value expressed into BODY r, written `:>(T T)`: counted when it is a statement of the
# body's own block, outside loops; another (in a branch or loop) has no static count.
# Arm block b of `if`/`match` e, which ends a BODY or ARM: its values go to the BODY.
# Function f's body, written `:>(T T)`, is about to be checked: a BODY that must express
# exactly that many values of T (no expected type for each: they are pushed as T).
# A value-giving `if`/`match` whose arms gave their values to a BODY that became a
# pack: a statement now, its arms' last values pushed.
# (a block ending in an `if` made a statement: the statement itself, as check_stmt has it)
# The end of block b, sink i: a BODY whose values are more than its last one
# becomes a pack, `{ $pack = [] ... $pack.push(v) ... $pack }`.
check_block = (b: int, expected: int, want_value: bool) -> int: bk_block(b, expected, want_value)
# Blocks run in checker_blocks.dewy; these are its services.
# (a sink opened for b in mode; mode -1 or -2 (wanting a value): how a discarding block's
# values go, worked out here)

pack_result_ok = false

# loop p in ps (ps a soa array): loop i in [0..len(ps)): p = ps[i]
soa_loop = (s: int):
    it = int(nodes[s].a)
    if nodes[it].kind == .range: return
    t = prune(check_expr(it, 0))
    it = last_checked
    nodes[s].a = i32(it)
    if not is_soa(t): return
    pos = nodes[s].pos
    ik = nodes[it].kind
    if ik != .ident and ik != .field: fatal(pos, "a loop over a soa array needs the array in a variable")
    nv = nkids(s)
    if nv == 2 and nodes[s].ival != 1: fatal(pos, "`loop a, b in` unpacks pairs; to count the elements write `loop i in 0.. and p in ps`")
    pv = kid(s, nv - 1)
    ixn = "__sl{bc_count}"
    bc_count += 1
    if nv == 2: ixn = name_of(int(nodes[kid(s, 0)].name))
    r = mk(.range, pos)
    nodes[r].a = i32(bc_int(0, pos))
    nodes[r].b = i32(bc_call("len", [clone(it)], pos))
    ix = mk(.index, pos)
    nodes[ix].a = i32(clone(it))
    nodes[ix].b = i32(bc_ident(ixn, pos))
    body = int(nodes[s].b)
    # p stands for ps[i]: p.x is ps.x[i]; only a use of p as a whole reads every field
    el = bc_let(name_of(int(nodes[pv].name)), ix, pos)
    add_flag(el, NF_SOA)
    if has_flag(s, NF_MUT): add_flag(el, NF_MUT)
    clear_flag(s, NF_MUT)
    stmts = [el]
    loop x in kids(body): stmts.push(x)
    set_list(body, stmts)
    set_list(s, [bc_ident(ixn, pos)])
    nodes[s].a = i32(r)

# (how many soa element aliases were made: none, and no name is one)
soa_aliases = 0

# the soa element alias local a name stands for here, or 0
soa_alias_of = (e: int) -> int:
    if nodes[e].kind != .ident: return 0
    s = lookup(int(nodes[e].name))
    if s == 0 or syms[s].kind != .local: return 0
    l = int(syms[s].ref)
    if int(locals[l].flags) & LF_SOAELEM == 0: return 0
    l

# loop a, b in xs (an array of pairs): loop t in xs: let a, b = t
unpack_loop = (s: int):
    dewy = files[pos_file(nodes[s].pos)].is_dewy
    if nkids(s) < 2 or (not dewy and nkids(s) != 2) or nodes[s].ival == 1: return
    it = int(nodes[s].a)
    if nodes[it].kind == .range: fatal(nodes[s].pos, "`loop a, b in` unpacks pairs; a range has single numbers")
    t = prune(check_expr(it, 0))
    nodes[s].a = i32(last_checked)
    if types[t].kind != .array and types[t].kind != .fixed: return
    pos = nodes[s].pos
    et = prune(int(types[t].elem))
    if not dewy and (types[et].kind != .tuple or int(types[et].nargs) != 2): fatal(pos, "`loop a, b in xs` unpacks pairs, but the elements are {dt(et)}; to count them write `loop i in 0.. and x in xs`")
    if has_flag(s, NF_MUT): fatal(pos, "`loop mut` cannot unpack pairs")
    tn = "__lt{bc_count}"
    bc_count += 1
    d = mk(.vardecl, pos)
    set_list(d, kids(s))
    nodes[d].b = i32(bc_ident(tn, pos))
    body = int(nodes[s].b)
    stmts = [d]
    loop x in kids(body): stmts.push(x)
    set_list(body, stmts)
    set_list(s, [bc_ident(tn, pos)])

# `loop mut k, v in m` over a map: { __map_tidy(m); the loop } (nothing in it gone, so that the
# loop's indexes are its entries'); true when s was made that block, and checked
map_tidy_first = (s: int) -> bool:
    if not has_flag(s, NF_MUT) or map_tidied.has(s): return false
    it = int(nodes[s].a)
    if nodes[it].kind == .range: return false
    t = prune(check_expr(it, 0))
    nodes[s].a = i32(last_checked)
    if not is_map_type(t): return false
    pos = nodes[s].pos
    l = nodes.len()
    nodes.push(nodes[s])
    map_tidied[l] = true
    mc = copy_place(int(nodes[s].a))
    add_flag(mc, NF_MUT)
    tidy = synth_call("__map_tidy", [mc], pos)
    b = mk(.block, pos)
    set_list(b, [tidy, l])
    nodes[s] = nodes[b]
    check_stmt(s)
    true

# (loops made by map_tidy_first: the map is tidied already)
map_tidied: {int: bool} = {}

# A cursor loop is ordinary scoped control flow over a retained input and a
# mutable boundary cursor. Advance before the body so continue needs no fixup.
dewy_cursor_loop = (s: int) -> bool:
    it = int(nodes[s].a)
    if not is_dewy_cursor_iter(ntype(it)): return false
    pos = nodes[s].pos
    nv = nkids(s)
    if has_flag(s, NF_MUT) or nv > 1 and nodes[s].ival != 1: fatal(pos, "this iterator binds one value; use `i in 0.. and value in sequence` to count")
    tag = "__grapheme{bc_count}"
    bc_count += 1
    seq = tag + "s"
    index = tag + "i"
    if nv == 2: index = name_of(int(nodes[kid(s, 0)].name))
    name = int(nodes[kid(s, nv - 1)].name)
    add_flag(it, NF_CHECKED)
    setup = [bc_let(seq, it, pos), bc_let(index, bc_int(-1, pos), pos)]
    done = bc_call("__dewy_iter_done", [bc_ident(seq, pos), bc_ident(index, pos)], pos)
    value = bc_call("__dewy_iter_value", [bc_ident(seq, pos), bc_ident(index, pos)], pos)
    advance: int[]
    if is_dewy_range_type(ntype(it), "__DewyRangeIter"):
        # Keep a counted range's hot state in scalar locals. Passing a mutable
        # iterator record to a helper would load/store it on every iteration.
        loop field in ["cursor", "delta", "remaining", "done"]:
            initial = bc_field(bc_ident(seq, pos), field, pos)
            if field == "cursor" or field == "delta": initial = bc_call("__dewy_range_cursor", [initial], pos)
            if field == "remaining": initial = bc_call("__dewy_range_remaining", [initial], pos)
            setup.push(bc_let(tag + field, initial, pos))
        done = bc_ident(tag + "done", pos)
        value = bc_call("__dewy_range_word", [bc_ident(tag + "cursor", pos)], pos)
        advance.push(lx_assign(bc_ident(tag + "cursor", pos), .pluseq, bc_ident(tag + "delta", pos), pos))
    head = [lx_assign(bc_ident(index, pos), .pluseq, bc_int(1, pos), pos), lx_if(done, mk(.break_, pos), pos), lx_let(name, value, pos)]
    if is_dewy_range_type(ntype(it), "__DewyRangeIter"): head.remove(1)
    loop item in advance: head.push(item)
    loop item in kids(int(nodes[s].b)): head.push(item)
    if is_dewy_range_type(ntype(it), "__DewyRangeIter"):
        # An inclusive unsigned counter also represents all 2^64 values when
        # remaining is zero. Reuse the normal counted-loop backend and keep
        # the empty test outside its back edge.
        range = mk(.range, pos)
        nodes[range].a = i32(bc_call("u64", [bc_int(0, pos)], pos))
        nodes[range].b = i32(bc_bin(.minus, bc_ident(tag + "remaining", pos), bc_int(1, pos), pos))
        add_flag(range, NF_INCLUSIVE)
        loop_ = mk(.for_, pos)
        nodes[loop_].sval = nodes[s].sval
        nodes[loop_].a = i32(range)
        nodes[loop_].b = i32(lx_block(head, pos))
        set_list(loop_, [bc_ident(tag + "counter", pos)])
        setup.push(lx_if(bc_bin(.eq, done, lx_bool(false, pos), pos), loop_, pos))
        nodes[s] = nodes[lx_block(setup, pos)]
        check_stmt(s)
        return true
    w = mk(.while_, pos)
    nodes[w].sval = nodes[s].sval
    tr = mk(.bool_lit, pos)
    nodes[tr].ival = 1
    nodes[w].a = i32(tr)
    nodes[w].b = i32(lx_block(head, pos))
    setup.push(w)
    nodes[s] = nodes[lx_block(setup, pos)]
    check_stmt(s)
    true

# An iterator loop's iterable written with `or_throw` after it (`loop x in inbox or_throw {`),
# by its node: the failures to forward (a type node), or 0 for all of them.
throwing_iters: {int: int} = {}

dewy_iterator_loop = (s: int, place: int = 0) -> bool:
    it = int(nodes[s].a)
    pos = nodes[s].pos
    if place == 0 and (nodes[it].kind == .range or not dewy_at(pos) or not dewy_iterator_type(prune(ntype(it)))): return false
    # (`loop x in inbox or_throw {`: each step's failures leave the function, so x is the payload)
    throwing = place == 0 and throwing_iters.has(it)
    if has_flag(s, NF_MUT): fatal(pos, "an iterator yields values; `loop @item in items` needs stored array elements")
    if nkids(s) != 1: fatal(pos, "an iterator loop binds one value; unpack it in the body")
    step = "__step{bc_count}"
    setup: int[]
    receiver = place
    if place == 0:
        iterator = "__iterator{bc_count}"
        add_flag(it, NF_CHECKED)
        setup.push(bc_let(iterator, it, pos))
        receiver = bc_ident(iterator, pos)
    bc_count += 1
    add_flag(receiver, NF_MUT)
    taken = bc_let(step, bc_method(receiver, "next", [], pos), pos)
    finished = mk(.istype, pos)
    nodes[finished].a = i32(bc_ident(step, pos))
    none_type = mk(.tname, pos)
    nodes[none_type].name = i32(intern("none"))
    nodes[finished].b = i32(none_type)
    # Event sources use Closed<T> for normal exhaustion. This is the ordinary
    # iterator protocol, independent of the source's module or concrete type.
    outcomes = handle_outcomes(prune(ntype(it)))
    terminal: int[]
    canceled = false
    event_source = false
    if outcomes != 0:
        loop outcome in value_members(outcomes):
            if outcome == T_NONE: terminal.push(none_type)
            if standard_wait_outcome(outcome) == intern("Closed"):
                terminal.push(type_node_of(outcome, pos))
                event_source = true
            if outcome == int(syms[universe[intern("Canceled")]].ref): canceled = true
    if terminal.len() > 0:
        end_types = mk(.tunion, pos)
        set_list(end_types, terminal)
        nodes[finished].b = i32(end_types)
    binder = kid(s, 0)
    element = mk(.vardecl, nodes[binder].pos)
    if nodes[binder].kind == .tuple: set_list(element, kids(binder))
    else:
        nodes[element].name = nodes[binder].name
        nodes[element].a = nodes[binder].a
    nodes[element].b = i32(bc_ident(step, pos))
    if not throwing and event_source and canceled:
        propagated = mk(.propagate, nodes[binder].pos)
        nodes[propagated].a = nodes[element].b
        nodes[propagated].b = i32(type_node_of(int(syms[universe[intern("Canceled")]].ref), pos))
        nodes[element].b = i32(propagated)
    if throwing:
        # (after the none test, so only the payload and its failures remain)
        thrown = mk(.propagate, nodes[binder].pos)
        nodes[thrown].a = nodes[element].b
        nodes[thrown].b = i32(throwing_iters[it])
        nodes[element].b = i32(thrown)
    body = lx_block([taken, lx_if(finished, mk(.break_, pos), pos), element] + kids(int(nodes[s].b)), pos)
    steps = mk(.while_, pos)
    nodes[steps].a = i32(bc_bool(true, pos))
    nodes[steps].b = i32(body)
    nodes[steps].sval = nodes[s].sval
    setup.push(steps)
    nodes[s] = nodes[lx_block(setup, pos)]
    check_stmt(s)
    true

# A written `loop x in xs` binder (Dewy; O(1) per write, plus one declaration per written
# binder): x starts each step as a copy of the element and belongs to the step, as if the
# loop held `let x = element`. Whether the last write is read is read off LF_READ, which
# each write clears (reads are checked in source order); a write inside a further loop may
# be read by that loop's next round, so any earlier read counts. A use by place may give the
# value on, so it counts as a read unless it is all a statement does (loop_copy_use).
struct LoopCopyWrite:
    pos: int        # the last write
    kept: bool      # it may be read: no dead-store warning
    by_place: bool  # some write passed it by place

loop_copy_writes: {int: LoopCopyWrite} = {}
loop_copy_refined: {int: int} = {}    # a written binder's element type, when refined

# Indexed user containers use their existing length / [] operations. Retain the
# input value and length once, then reuse the ordinary counted-loop lowering.
dewy_sequence_loop = (s: int) -> bool:
    it = int(nodes[s].a)
    if nodes[it].kind == .range: return false
    t = prune(ntype(it))
    if types[t].kind != .struct_ or is_map_type(t) or is_map_entries_type(t) or is_soa(t) or is_dewy_cursor_iter(t): return false
    if structs[int(types[t].st)].name == "Range" and for_date_range_value(s, it, t): return true
    pos = nodes[s].pos
    if has_flag(s, NF_MUT): fatal(pos, "custom sequence iteration yields values; update the container through its indices")
    tag = "__sequence{bc_count}"
    bc_count += 1
    add_flag(it, NF_CHECKED)
    seq = bc_let(tag, it, pos)
    index = tag + "i"
    bindings = kids(s)
    counted = bindings.len() == 2 and nodes[s].ival == 1
    if counted: index = name_of(int(nodes[bindings[0]].name))
    read = lx_index(bc_ident(tag, pos), bc_ident(index, pos), pos)
    binding = mk(.vardecl, pos)
    nodes[binding].b = i32(read)
    if bindings.len() == 1 or counted:
        nodes[binding].name = nodes[bindings[bindings.len() - 1]].name
    else: set_list(binding, bindings)
    body = lx_block([binding] + kids(int(nodes[s].b)), pos)
    range = mk(.range, pos)
    nodes[range].a = i32(bc_int(0, pos))
    nodes[range].b = i32(bc_method(bc_ident(tag, pos), sequence_length_name(t), [], pos))
    counted_loop = mk(.for_, pos)
    nodes[counted_loop].a = i32(range)
    nodes[counted_loop].b = i32(body)
    nodes[counted_loop].sval = nodes[s].sval
    set_list(counted_loop, [bc_ident(index, pos)])
    nodes[s] = nodes[lx_block([seq, counted_loop], pos)]
    check_stmt(s)
    true

# A nested loop binding first receives the ordinary iteration value, then uses
# the same destructuring declaration as local code. This also handles a map's
# value without changing its key/value iteration or snapshot behavior.
dewy_nested_loop_bindings = (s: int):
    if not files[pos_file(nodes[s].pos)].is_dewy: return
    declarations: int[]
    loop i in [0..nkids(s)):
        binding = kid(s, i)
        if nodes[binding].kind != .tuple and nodes[binding].a == 0: continue
        # Array/custom-sequence patterns keep their field names until unpacked.
        # A dictionary's key/value binders are separate iteration values.
        if nodes[binding].kind != .tuple:
            it = prune(ntype(int(nodes[s].a)))
            if not is_map_type(it) and not is_map_entries_type(it): continue
        if has_flag(s, NF_MUT): fatal(nodes[binding].pos, "nested loop bindings yield independent values, not mutable aliases")
        name = "$unpack_loop{bc_count}"
        bc_count += 1
        d = mk(.vardecl, nodes[binding].pos)
        if nodes[binding].kind == .tuple: set_list(d, kids(binding))
        else:
            nodes[d].name = nodes[binding].name
            nodes[d].a = nodes[binding].a
        nodes[d].b = i32(bc_ident(name, nodes[binding].pos))
        declarations.push(d)
        set_kid(s, i, bc_ident(name, nodes[binding].pos))
    if declarations.len() > 0:
        body = int(nodes[s].b)
        set_list(body, declarations + kids(body))

# (the value variables of loops over dictionaries: a change is made through the key)
map_loop_values: {int: bool} = {}

# Suggestions are spelled in the language of the source they are about.
dewy_at = (pos: int) -> bool:
    f = pos_file(pos)
    pos > 0 and f < files.len() and files[f].is_dewy

# Arrays a Dewy loop iterates by value (`loop x in xs`), while their bodies are
# checked: the loop sees the value at entry, so changing the array's length in
# the body is an error naming the two meanings the program could have wanted.
# (ValueLoop: checker_state.dewy)
value_loops: ValueLoop[]

value_loop_resize = (receiver: int, operation: str, pos: int):
    i = value_loops.len() - 1
    loop i >= 0:
        v = value_loops[i]
        if v.context == cx and same_route(v.route, receiver):
            src = route_text(v.route)
            el = if v.name != 0: name_of(v.name) else: "item"
            fatal(pos, "`{operation}` changes the length of `{src}`, which `loop {el} in {src}` iterates by its value at loop entry, so the loop would not see the change: write `loop {el} in @{src}` to iterate the live array, or bind a snapshot first (`let snapshot = {src}` then `loop {el} in snapshot`)")
        i -= 1

const ASSIGN_OPS = 0

# Labels belong to active loops in one function-checking context. They cannot
# cross a function boundary, including a closure checked inside the loop.
loop_labels: LoopLabel[]

compound_op = (op: int) -> int:
    k = op as Tok
    match k:
        pluseq: int(Tok.plus)
        minuseq: int(Tok.minus)
        stareq: int(Tok.star)
        slasheq: int(Tok.slash)
        percenteq: int(Tok.percent)
        ampeq: int(Tok.amp)
        pipeeq: int(Tok.pipe)
        careteq: int(Tok.caret)
        shleq: int(Tok.shl)
        shreq: int(Tok.shr)
        _: 0

int_update_lhs = 0      # (the integer binding a compound update is checked for, as `total` in `total += x`,
int_update_pos = 0      # and the update's position)

# Dewy's arithmetic helpers implement floor division, exact division and power.
# Keep the update as an assignment until its place and indices are resolved.
compound_value = (s: int, left: int, right: int) -> int:
    if nodes[s].sval != 0:
        n = bc_call(name_of(int(nodes[s].sval)), [left, right], nodes[s].pos)
        if has_flag(s, NF_BROADCAST): add_flag(n, NF_BROADCAST)
        return n
    # (Dewy's `and=`/`or=`: the logical operator, short-circuiting on booleans)
    logical = nodes[s].aux2 == 1 and not has_flag(s, NF_BROADCAST)
    kind = NK.binary
    if logical:
        kind = NK.or_
        if nodes[s].op == i32(int(Tok.ampeq)): kind = NK.and_
    n = mk(kind, nodes[s].pos)
    nodes[n].op = i32(compound_op(int(nodes[s].op)))
    if has_flag(s, NF_BROADCAST):
        nodes[n].aux = i32(tok_text(nodes[n].op as Tok)[0])
        nodes[n].op = i32(int(Tok.dotop))
    nodes[n].a = i32(left)
    nodes[n].b = i32(right)
    n

compound_checked = (s: int, left: int, right: int, target: int) -> int:
    # (t -= 5°C on a temperature takes away a difference: the literal reads as one)
    literal = is_quantity(target) and quantity_literal_syntax(right)
    n = compound_value(s, left, right)
    if literal: quantity_update_right = right
    # (`let total = 0` then `total += x` with a float x: var_type_error says where total was made)
    # (`x /= 2` keeps its own hint, `//=`)
    if nodes[left].kind == .ident and (nodes[left].aux == i32(int(SK.local)) or nodes[left].aux == i32(int(SK.global))) and is_int(representation_type(prune(target))) and nodes[s].op != i32(int(Tok.slasheq)):
        int_update_lhs = mk(.ident, nodes[left].pos)
        nodes[int_update_lhs].aux = nodes[left].aux
        nodes[int_update_lhs].sym = nodes[left].sym
        nodes[int_update_lhs].name = nodes[left].name
        if nodes[left].name == 0: nodes[int_update_lhs].name = if nodes[left].aux == i32(int(SK.local)): locals[int(nodes[left].sym)].name else: globals[int(nodes[left].sym)].name
        int_update_pos = nodes[s].pos
    result = prune(check_expr(n, (if has_flag(s, NF_BROADCAST): target else: 0)))
    quantity_update_right = 0
    if is_quantity(target) and quantity_point(target) and quantity_is_delta(result): fatal(nodes[s].pos, "this update leaves a difference, not a temperature point, so the point cannot hold it: subtract a difference (`5K`), or keep the difference in a new binding")
    t = prune(target)
    if decimal_target != 0 and decimal_float_write(result, t): return last_checked
    quantity_float_update(s, target, result)
    # Built-in compound arithmetic keeps the destination's fixed width,
    # just as += does, even when a library helper computes in 64 bits.
    if nodes[s].sval != 0 and ((is_int(t) and is_int(result)) or (is_float(t) and is_float(result))):
        if result != t: wrap_conv(last_checked, (if is_int(t): CV.int_ else: CV.float_), t)
    r = coerce(last_checked, target)
    int_update_lhs = 0
    r

# the variable a narrowing alias (see narrow_var) stands for, or 0
narrowed_var = (l: int) -> int:
    if int(locals[l].flags) & LF_ALIAS == 0: return 0
    e = int(locals[l].alias)
    # (an optional union's kept members: x in its condition, `x != none`)
    if nodes[e].kind == .if_ and opt_rest_aliases.has(e): e = int(nodes[e].a)
    else if nodes[e].kind != .narrow and nodes[e].kind != .unwrap and (nodes[e].kind != .conv or nodes[e].aux != i32(int(CV.union_))): return 0
    a = int(nodes[e].a)
    if nodes[a].kind != .ident or nodes[a].aux != i32(int(SK.local)): return 0
    int(nodes[a].sym)


# Only writes to narrowed aliases need rollback between sibling branches.
# The log avoids scanning all locals or copying checker state for every branch.
narrow_changes: int[]

narrow_jumps: NarrowJump[]



# Index narrowing aliases by their underlying local declaration. Writes visit
# only that root's aliases: O(alias depth + dependent narrowings), with O(1)
# expected indexed links and one entry per narrowing. No scan of all locals.
narrow_store_heads: {int: int}
narrow_store_next: {int: int}

narrow_store_root = (l0: int) -> int:
    l = l0
    loop int(locals[l].flags) & LF_ALIAS != 0 and locals[l].alias != 0:
        u = narrowed_var(l)
        if u != 0: l = u
        else:
            a = int(locals[l].alias)
            if nodes[a].kind != .ident or nodes[a].aux != i32(int(SK.local)): return 0
            l = int(nodes[a].sym)
    l

narrow_store_register = (l: int):
    if narrowed_var(l) == 0: return
    root = narrow_store_root(l)
    if root == 0: return
    narrow_store_next[l] = narrow_store_heads.get(root) ?? 0
    narrow_store_heads[root] = l

# A whole-variable replacement invalidates tag evidence through every name
# for that storage. Payload writes of the same member retain their tag.
unnarrow_assign = (s: int):
    lhs = int(nodes[s].a)
    if nodes[lhs].kind != .ident: return
    sy = lookup(int(nodes[lhs].name))
    if sy == 0 or syms[sy].kind != .local: return
    l = int(syms[sy].ref)
    u = narrowed_var(l)
    head = 0
    if narrow_store_heads.len() > 0: head = narrow_store_heads.get(narrow_store_root(l)) ?? 0
    if u == 0 and head == 0: return
    rt = prune(check_expr(int(nodes[s].b), 0))
    rhs = last_checked
    nodes[s].b = i32(rhs)
    add_flag(rhs, NF_CHECKED)
    loop head != 0:
        alias = head
        head = narrow_store_next.get(alias) ?? 0
        if int(locals[alias].owner) != int(ctxs[cx].inst): continue
        if int(locals[alias].flags) & LF_UNNARROWED != 0: continue
        if not narrow_store_keeps(alias, rhs, rt): narrow_invalidate(alias)
        # Replacing the parent also retires narrowed paths inside its payload.
        if path_narrows > 0 and alias < path_rooted_l.len() and path_rooted_l[alias]: path_forget("#L{alias}")
    if u == 0 or narrow_store_keeps(l, rhs, rt): return
    narrow_invalidate(l)
    nm = int(nodes[lhs].name)
    push_scope_sym(nm, new_sym(nm, .local, u, 0))

# returns the (possibly replaced) statement node
# `x = ...` in a function, where x is a global declared below the function in the same file:
# that reads like a new local variable, but changes the global, so it gets a warning (a loop
# counter `k` in a helper quietly being the script's `k` further down). Declaring the global
# above the function says it is meant.
late_warned: {int: bool}
check_late_global = (s: int):
    if cx < 0 or nodes[s].op != i32(int(Tok.assign)): return
    if ctxs[cx].mod >= 0 and modules[int(ctxs[cx].mod)].is_prelude: return
    lhs = int(nodes[s].a)
    if nodes[lhs].kind != .ident: return
    inst = int(ctxs[cx].inst)
    if inst <= 0 or inst >= fns.len(): return
    fd = int(fns[inst].decl)
    if fd == 0: return
    nm = int(nodes[lhs].name)
    sym = lookup(nm)
    if sym == 0 or syms[sym].kind != .global or syms[sym].decl == 0: return
    gpos = nodes[int(syms[sym].decl)].pos
    fpos = nodes[fd].pos
    if pos_file(gpos) != pos_file(fpos) or pos_off(gpos) <= pos_off(fpos): return
    # (an error, not a warning: a global added further down would quietly change what the
    # function does)
    fatal(nodes[lhs].pos, "'{name_of(nm)}' is the global variable declared below this function (at {pos_str(gpos)}), so this would change it: for a variable of the function's own, write `let {name_of(nm)} = ...` (or use another name); to mean the global, declare it above the function")

# An update through a custom [] / []= pair reads, edits and writes back the
# selected value. Walk from the root outward so nested containers compose:
#     e = pool[h]; e.inventory[i] = v; pool[h] = e
# Receiver indices and the custom index are captured once, in source order.
elem_tmp_n = 0

# The path from an expression back to its root, outermost access first.
index_update_path = (n: int) -> int[]:
    path: int[]
    let n = n
    loop nodes[n].kind == .field or nodes[n].kind == .index:
        path.push(n)
        n = int(nodes[n].a)
    path

# Capture an index even when it is a variable: the update's right side may
# change that variable before the selected value is written back.
index_update_sources: {int: int} = {}   # a captured index's name -> the expression it holds (for messages)
index_update_arrays: {int: bool} = {}   # captured names used only to index arrays (facts.jo)





# A compound update reads its target and writes it back. Each selector that
# can run code is evaluated exactly once, from the root outward (left to
# right), before both: `d[f()]["x"] += 1` calls f once. O(path).
compound_selector_capture = (s: int) -> int:
    if nodes[s].op == i32(int(Tok.assign)) or has_flag(s, NF_BROADCAST) or has_flag(s, NF_INDEX_CAPTURED): return 0
    lhs = int(nodes[s].a)
    if nodes[lhs].kind != .index and nodes[lhs].kind != .field: return 0
    pos = nodes[s].pos
    stmts: int[]
    path = index_update_path(lhs)
    i = path.len() - 1
    loop i >= 0:
        part = path[i]
        i -= 1
        if nodes[part].kind != .index or has_flag(part, NF_LIB_INDEX): continue
        selectors = if nodes[part].b != 0: [int(nodes[part].b)] else: kids(part)
        captured: int[]
        loop selector in selectors:
            if nodes[selector].kind == .range or nodes[selector].kind == .hole or not compound_selector_runs(selector):
                captured.push(selector)
                continue
            name = "$selector{bc_count}"
            bc_count += 1
            index_update_sources[intern(name)] = selector
            stmts.push(bc_let(name, selector, pos))
            captured.push(bc_ident(name, pos))
        if nodes[part].b != 0: nodes[part].b = i32(captured[0])
        else: set_list(part, captured)
    if stmts.len() == 0: return 0
    update = nodes.len()
    nodes.push(nodes[s])
    stmts.push(update)
    blk = bc_block(stmts, pos)
    check_stmt(blk)
    blk

elem_field_assign = (s: int) -> int:
    if has_flag(s, NF_INDEX_CAPTURED): return 0
    lhs = int(nodes[s].a)
    path = index_update_path(lhs)
    ix = 0
    direct_pool = -1
    i = path.len() - 1
    loop i >= 0:
        candidate = path[i]
        i -= 1
        if nodes[candidate].kind != .index or nodes[candidate].b == 0: continue
        if candidate == lhs and nodes[s].op == i32(int(Tok.assign)): continue
        # Inspect a copy: checking an overloaded index rewrites it to a call,
        # but the original receiver path is needed for capture and writeback.
        bt = prune(check_expr(clone(int(nodes[candidate].a)), 0))
        if types[bt].kind == .struct_ and not is_map_type(bt) and not is_soa(bt) and not is_part_index(candidate, bt):
            ix = candidate
            if pool_direct_update(s, ix, bt): direct_pool = module_of_type(bt)
            break
    if ix == 0: return 0
    pos = nodes[s].pos
    stmts: int[]
    receiver_path = index_update_path(int(nodes[ix].a))
    j = receiver_path.len() - 1
    loop j >= 0:
        part = receiver_path[j]
        j -= 1
        if nodes[part].kind == .index and nodes[part].b != 0:
            index_update_capture(part, stmts)
    iname = index_update_capture(ix, stmts)
    if direct_pool >= 0:
        recv = int(nodes[ix].a)
        # Qualify the library helper so a local function with the same name
        # cannot intercept the compiler-generated lookup.
        ensure_bundled_import("std/pool.jo", "$dewy_pool", pos)
        library = bc_ident("$dewy_pool", pos)
        checked_index = mk(.call, pos)
        nodes[checked_index].a = i32(bc_field(library, "__pool_index", pos))
        set_list(checked_index, [clone(recv), comp_ident(iname, pos)])
        storage = bc_field(recv, "items", pos)
        nodes[ix] = Node(kind = .index, pos = pos, a = i32(storage), b = i32(checked_index))
        add_flag(ix, NF_LIB_INDEX)
        c0 = nodes.len()
        nodes.push(nodes[s])
        stmts.push(c0)
        blk0 = mk(.block, pos)
        set_list(blk0, stmts)
        check_stmt(blk0)
        return blk0
    if ix == lhs:
        c0 = nodes.len()
        nodes.push(nodes[s])
        add_flag(c0, NF_INDEX_CAPTURED)
        stmts.push(c0)
        blk0 = mk(.block, pos)
        set_list(blk0, stmts)
        check_stmt(blk0)
        return blk0
    r0 = clone(int(nodes[ix].a))
    r1 = clone(int(nodes[ix].a))
    elem_tmp_n += 1
    ename = intern("__elem{elem_tmp_n}")
    rd = mk(.index, pos)
    nodes[rd].a = i32(r0)
    nodes[rd].b = i32(comp_ident(iname, pos))
    de = mk(.vardecl, pos)
    nodes[de].name = i32(ename)
    nodes[de].b = i32(rd)
    stmts.push(de)
    # The remaining field/index path operates on the selected value.
    f = lhs
    loop int(nodes[f].a) != ix: f = int(nodes[f].a)
    nodes[f].a = i32(comp_ident(ename, pos))
    update_at = stmts.len()
    stmts.push(s)
    wr = mk(.index, pos)
    nodes[wr].a = i32(r1)
    nodes[wr].b = i32(comp_ident(iname, pos))
    back = mk(.assign, pos)
    nodes[back].op = i32(int(Tok.assign))
    nodes[back].a = i32(wr)
    nodes[back].b = i32(comp_ident(ename, pos))
    stmts.push(back)
    blk = mk(.block, pos)
    # (the original statement, now e.f = v, is checked inside the block)
    c = nodes.len()
    nodes.push(nodes[s])
    stmts[update_at] = c
    set_list(blk, stmts)
    check_stmt(blk)
    blk

# s = s + x on text or an array: s += x, which adds to the end in place; the other copies all of
# s each time, and a loop of them takes time growing with the square of the length
append_assign = (s: int):
    lhs = int(nodes[s].a)
    if nodes[lhs].kind != .ident: return
    spine: int[]
    n = int(nodes[s].b)
    loop nodes[n].kind == .binary and nodes[n].op == i32(int(Tok.plus)):
        spine.push(n)
        n = int(nodes[n].a)
    if spine.len() == 0 or nodes[n].kind != .ident or nodes[n].name != nodes[lhs].name: return
    sy = lookup(int(nodes[lhs].name))
    if sy == 0 or (syms[sy].kind != .local and syms[sy].kind != .global): return
    t = prune(check_expr(clone(lhs), 0))
    if tkind(t) != .str_ and tkind(t) != .array: return
    # (s + a + b is (s + a) + b: s, then the rest in order, appended)
    rest = int(nodes[spine[spine.len() - 1]].b)
    if spine.len() == 1: nodes[s].b = i32(rest)
    else: nodes[spine[spine.len() - 2]].a = i32(rest)
    nodes[s].op = i32(int(Tok.pluseq))

# Dewy's s = "{s}..." on a text variable: appended in place, as s += "..." would be in the
# implementation language; the other copies all of s each time (a loop of them is quadratic).
# The variable is read first either way, so only a local that nothing else can change while
# the rest is evaluated (no closure shares it) is appended to.
interp_appends: {int: bool} = {}

interp_append_assign = (s: int):
    lhs = int(nodes[s].a)
    rhs = int(nodes[s].b)
    if nodes[lhs].kind != .ident or nodes[rhs].kind != .str_lit or nodes[rhs].aux != 1 or nkids(rhs) < 2: return
    first = kid(rhs, 0)
    if nodes[first].kind != .pair or nodes[first].sval != -1: return
    v = int(nodes[first].a)
    if nodes[v].kind != .ident or nodes[v].name != nodes[lhs].name: return
    sy = lookup(int(nodes[lhs].name))
    if sy == 0 or syms[sy].kind != .local: return
    l = int(syms[sy].ref)
    if int(locals[l].flags) & (LF_CAPTURED | LF_SHARED | LF_BYREF | LF_CAPTURE | LF_ALIAS | LF_ELEMALIAS | LF_SOAELEM | LF_CONST) != 0: return
    if prune(int(locals[l].type)) != T_STR: return
    rest = kids(rhs)
    rest.remove(0)
    set_list(rhs, rest)
    nodes[s].op = i32(int(Tok.pluseq))
    interp_appends[s] = true

dewy_end_assign = (s: int) -> int:
    ix = 0
    part = int(nodes[s].a)
    loop nodes[part].kind == .field or nodes[part].kind == .index:
        if nodes[part].kind == .index and nodes[part].sval != 0: ix = part
        part = int(nodes[part].a)
    if ix == 0: return 0
    pos = nodes[ix].pos
    receiver = int(nodes[ix].a)
    source_type = prune(check_expr(clone(receiver), 0))
    stable = dewy_end_place(last_checked)
    stmts: int[]
    receiver_path = index_update_path(receiver)
    j = receiver_path.len() - 1
    loop j >= 0:
        part = receiver_path[j]
        j -= 1
        if nodes[part].kind == .index and nodes[part].b != 0: index_update_capture(part, stmts)
    name = "$index_target{bc_count}"
    bc_count += 1
    end_source = clone(receiver)
    if not stable:
        stmts.push(bc_let(name, end_source, pos))
        end_source = bc_ident(name, pos)
        nodes[ix].a = i32(bc_ident(name, pos))
    loop binding in dewy_index_end_bindings(ix, end_source, source_type): stmts.push(binding)
    nodes[ix].sval = 0
    update = nodes.len()
    nodes.push(nodes[s])
    stmts.push(update)
    if not stable: stmts.push(bc_assign(receiver, bc_ident(name, pos), pos))
    blk = bc_block(stmts, pos)
    check_stmt(blk)
    blk

# Only dictionary update paths need this work. O(path^2 + RHS): capture keys
# and ordinary indices before the old-value read/RHS, never entry positions.
# Each dictionary's receiver copy contains at most the preceding path.
# Plain RHSs retain the existing single-lookup compound update.
map_update_capture = (lhs: int, rhs: int, before: mut int[]):
    if nodes[lhs].kind != .field and nodes[lhs].kind != .index: return
    path = index_update_path(lhs)
    found = false
    loop part in path:
        if map_place_index(part): found = true
    if not found or not compound_selector_runs(rhs): return
    i = path.len() - 1
    loop i >= 0:
        part = path[i]; i -= 1
        if nodes[part].kind != .index or nodes[part].b == 0: continue
        entry = map_place_index(part)
        selector = if entry: kid(int(nodes[part].b), 1) else: int(nodes[part].b)
        kept = selector
        sk = nodes[selector].kind
        literal = sk == .int_lit or sk == .float_lit or sk == .bool_lit or sk == .str_lit and nkids(selector) == 0
        if not literal:
            kept = capture_value(selector, ntype(selector), before)
            if entry:
                add_flag(before[before.len() - 1], NF_MAP_KEY)
                add_flag(kept, NF_MAP_KEY)
        if entry:
            call = int(nodes[part].b)
            # map_elem_place copied the receiver before these selectors were
            # captured. Refresh it too (rows[i][key] must keep i as well).
            receiver = copy_place(int(nodes[int(nodes[part].a)].a))
            add_flag(receiver, NF_MUT)
            set_kid(call, 0, receiver)
            set_kid(call, 1, kept)
            add_flag(part, NF_RELOOKUP)
        else: nodes[part].b = i32(kept)

# Assignments run in checker_assigns.dewy; these are its services.
assign_before: int[]    # (selectors captured before the values of the assignments being checked)
# The source's forms: a `[end]`-indexed target's update (returned), `x = x + ...` appends,
# narrowing undone by a write, a soa element's write to its array.
assign_prelude = (s: int) -> int:
    if files[pos_file(nodes[s].pos)].is_dewy:
        end_update = dewy_end_assign(s)
        if end_update != 0: return end_update
    if nodes[s].op == i32(int(Tok.assign)):
        unnarrow_assign(s)
        if dewy_at(nodes[s].pos): interp_append_assign(s)
        else: append_assign(s)
    sl = soa_alias_of(int(nodes[s].a))
    if sl != 0:
        # p = value in `loop mut p in ps`: ps[i] = value
        if int(locals[sl].flags) & LF_SOAMUT == 0: fatal(nodes[s].pos, "cannot modify loop variable '{name_of(int(locals[sl].name))}' (use `{mutable_loop_syntax(nodes[s].pos)}`)")
        nodes[s].a = i32(clone(int(locals[sl].soa)))
    0
# An indexed target's forms (checker_assigns.dewy va_index, given the receiver's type bt):
# 1 Dewy ranges made values, 2 a range of an array's elements, 3 a stepped range off an
# n-dimensional array refused, 4 a record's soa element, part or `[]=` call, 5 an array's
# elements picked by a mask or indexes; the rewritten statement, or 0
# A condition that has just been found to hold or not: `i =? k` on a local is noted, with a scope
# entry so that the branch's reset takes it back. O(1).
position_guard_note = (c: int, holds: bool):
    op = int(nodes[c].op)
    if not (op == int(Tok.eq) and holds or op == int(Tok.ne) and not holds): return
    a = int(nodes[c].a)
    b = int(nodes[c].b)
    if nodes[a].kind == .int_lit: a, b = b, a
    if nodes[a].kind != .ident or nodes[a].aux != i32(int(SK.local)) or nodes[b].kind != .int_lit: return
    position_guards.push(PositionGuard(local = nodes[a].sym, value = i32(nodes[b].ival), mark = i32(scope_mark())))
    push_scope_sym(intern("$position_guard"), 0)

assign_place = (lhs: int):
    check_place(lhs, false)
    return
# (1 the refined storage written, 2 a refined field's checked store (or 0), 3 a text
# domain's write, 4 an integer domain's)
assign_refine = (s: int, lt: int, code: int) -> int:
    lhs = int(nodes[s].a)
    op = int(nodes[s].op)
    if code == 1: return refine_storage(lhs, lt)
    if code == 2:
        if ref_self_active and ref_self_stored(lt): return ref_self_store(s, lt)
        return ref_field_store(s, lt)
    if code == 3: string_domain_write(lhs, if op == int(Tok.assign): int(nodes[s].b) else: 0)
    else: int_domain_write(lhs, int(nodes[s].b), if op == int(Tok.assign): 0 else: op)
    0
# The value checked to lt (settle 1: converted to lt, but for a release's zeroed bytes;
# 2: a variable's value of another type refused first)
assign_value = (s: int, lt: int, settle: int) -> int:
    rt = prune(if values_any and is_values(lt): values_init(int(nodes[s].b), lt) else: check_expr(int(nodes[s].b), lt))
    if settle == 0: return rt
    v = last_checked
    if settle == 2 and rt != lt and not can_coerce(v, rt, lt): var_type_error(int(nodes[s].a), lt, rt, nodes[v].pos)
    if nodes[v].kind != .intrinsic or nodes[v].aux != i32(int(IN.zeroed)): nodes[s].b = i32(coerce(v, lt))
    rt


# `let cursor = @xs[i]`, `let entry = @table[k]`, `let f = @r.a`, `let p = @xs`:
# a local name for the element, entry, field or variable itself, its key or
# index evaluated once.
local_place_count = 0

decl_values = (e: int, expected: int) -> int: values_init(e, expected)

# A shaped parameter's dimension (dw_shape_prologue): a name already bound to a
# value is checked against the argument's dimension; otherwise the name binds it.
const SHAPE_DIM = 1789

# `x = value` (or `a, b = value`) that declares x, made a declaration; otherwise a spawn's
# handle and a global declared below are looked at
stmt_assign = (s: int) -> bool:
    if assign_declares(s, -1):
        assign_to_decl(s)
        return true
    if nodes[int(nodes[s].b)].kind == .call and nodes[int(nodes[s].b)].aux2 == 17: spawn_value_error(nodes[int(nodes[s].b)].pos)
    check_late_global(s)
    false

# Sparse preorder events for lowering's integer write proofs. Negative loop
# nodes close the enclosing-loop stack; nested closures contribute only their
# boundary. Save/restore around finalization, which can check other instances.
zonk_write_sites: int[]
zonk_collect_writes = false
# (a function's return type given out while its body is still being checked: what has it may
# change as that body goes on)
type_exposures = 0

# a function's variables whose fields or elements it changes but whose value it never reads: a
# copy changed for nothing (`if let e = enemies.find(...): e.hp -= 5` leaves the enemy as it was)
copy_write_warnings = (f: int):
    if poly_families.len() > 1 and poly_pending_warnings.get(f) == true: return
    unused_local_warnings(f)
    if copy_writes.len() == 0: return
    skip = LF_READ | LF_PARAM | LF_MUTPARAM | LF_CAPTURE | LF_CAPTURED | LF_ADDR | LF_ALIAS | LF_BYREF | LF_ELEMALIAS | LF_SOAELEM | LF_SHARED
    loop l in fns[f].locals:
        if not copy_writes.has(l) or int(locals[l].flags) & skip != 0: continue
        nm = name_of(int(locals[l].name))
        if starts_with(nm, "#") or starts_with(nm, "$") or starts_with(nm, "__") or pos_in_lib(locals[l].pos): continue
        warn_unused_copy(copy_writes[l], nm)


# Names used in arms a `$target` or `$build` test left out, by position (dw_target_dropped).
dewy_target_dropped: {int: int[]}



# (scor = 1 in a function, for the global score: a variable of its own, made and never read)
unused_local_warnings = (f: int):
    skip = LF_READ | LF_PARAM | LF_MUTPARAM | LF_CAPTURE | LF_CAPTURED | LF_ADDR | LF_ALIAS | LF_BYREF | LF_ELEMALIAS | LF_SOAELEM | LF_SHARED | LF_QUIET
    loop l in fns[f].locals:
        fl = int(locals[l].flags)
        if fl & LF_DECL == 0 or fl & skip != 0 or copy_writes.has(l): continue
        nm = name_of(int(locals[l].name))
        # Dewy desugaring uses reserved $ names for evaluation-order captures.
        # Their values may be overridden; they are not bindings the user can fix.
        if len(nm) == 0 or starts_with(nm, "_") or starts_with(nm, "#") or starts_with(nm, "$") or pos_in_lib(locals[l].pos): continue
        if dewy_target_dropped.len() > 0 and target_dropped_use(f, l): continue
        near = ""
        if files[pos_file(locals[l].pos)].is_dewy:
            m = int(fns[f].mod)
            near = dewy_unused_name_hint(nm, m)
            if len(near) == 0 and m >= 0:
                loop used in modules[m].uses:
                    near = dewy_unused_name_hint(nm, used)
                    if len(near) > 0: break
        else:
            loop gi in [0..globals.len()):
                gn = name_of(int(globals[gi].name))
                lim = 1
                if len(nm) >= 6: lim = 2
                if gn != nm and len(nm) >= 3 and len(gn) > 0 and gn[0] == nm[0] and not globals[gi].is_const and not modules[int(globals[gi].mod)].is_prelude and gn != upper(gn) and lower(gn) != lower(nm) and edit_distance(gn, nm, lim) <= lim:
                    near = " (did you mean the variable '{gn}'? that one is changed by writing its name exactly)"
                    break
                # (the global of a file this one does not use: the assignment made a variable of the
                # function's own instead of changing it)
                gf = int(modules[int(globals[gi].mod)].file)
                lf = pos_file(locals[l].pos)
                if gn == nm and not modules[int(globals[gi].mod)].is_prelude and gf >= 0 and lf >= 0 and gf != lf:
                    # (as `use` would name it from here)
                    shown = files[gf].path
                    if starts_with(shown, files[lf].dir + "/"): shown = shown[len(files[lf].dir) + 1..]
                    near = ": it is a variable of this function's own, as the global '{gn}' of {shown} is not seen from this file (`use '{shown}'` at its top lets it change that one)"
                    break
        # (a parameter a function type asks for, `(waiting:[int int] tick:int)` for a controller
        # that reads only the tick: an underscore says it is unused on purpose)
        if fl & LF_ASSIGNED == 0 and len(near) == 0 and files[pos_file(locals[l].pos)].is_dewy:
            loop p in fns[f].params:
                if locals[p].name == locals[l].name and locals[p].pos == locals[l].pos: near = " (a parameter kept for the function's type can be named `_{nm}`)"
        # (score = 0 in update, then score += 1: it starts again each frame, and nothing reads it)
        fnm = ""
        if fns[f].decl != 0 and nodes[int(fns[f].decl)].kind == .fn_: fnm = name_of(int(nodes[int(fns[f].decl)].name))
        if fl & LF_ASSIGNED != 0 and len(near) == 0 and (fnm == "update" or fnm == "draw") and not dewy_is_method(int(fns[f].decl)):
            warn(locals[l].pos, "'{nm}' starts again here each frame, as a variable made in {fnm} belongs to that one run, and is never read: to keep it from frame to frame, give it its first value at the top of the file, outside the functions")
        else if fl & LF_ASSIGNED != 0 and len(near) == 0: warn(locals[l].pos, "'{nm}' is given a value here, and changed, but never read")
        else: warn(locals[l].pos, "'{nm}' is given a value here but never used{near}")




# Count index nodes during the existing finalization walk. A negative summary
# lets lowering avoid path proofs that cannot discover an indexed array.
# Likewise, normal bodies without user globals or narrowed aliases cannot
# disprove closed-program ownership. Init/lambda bodies remain unsummarized.
zonk_indexes = 0
zonk_user_globals = 0

constant_binding = (e: int) -> int:
    if nodes[e].type != 0 and (nodes[e].aux == i32(int(SK.local)) or nodes[e].aux == i32(int(SK.global))):
        return binding_const_init(nodes[e].aux as SK, int(nodes[e].sym), nodes[e].pos)
    s = lookup(int(nodes[e].name))
    if s != 0:
        if syms[s].kind == .type_: return integer_parameter_literal(e)
        return binding_const_init(syms[s].kind, int(syms[s].ref), nodes[e].pos)
    0

ceval = (e: int) -> CVal: constant_eval(nodes, names, files, constant_host, e)

# ---------------- static assertions ----------------
# Closed `$assert` requests keep this constant/evaluator fast path. facts.jo
# queues open scalar requests until checked bodies and helpers have settled;
# runtime values never fall through from a failed fact query into ct_run.
# sa_blocker is the first part that left a constant value unknown.
struct SVal:
    known: bool
    is_str: bool
    i: int
    s: str

sa_blocker = 0

sa_fits = (v: int, t0: int) -> bool:
    t = prune(t0)
    if t == 0: return false
    if types[t].kind != .int_: return types[t].kind == .bool_
    bits = int(types[t].bits)
    if bits >= 64: return types[t].sign or v >= 0
    if types[t].sign: return v >= -(1 << (bits - 1)) and v < (1 << (bits - 1))
    v >= 0 and v < (1 << bits)

# ---------------- program ----------------
runtime_memeq = -1            # private bounded memory comparison, native lowering
runtime_streq = -1            # private string equality, including nil/empty values
want_cpu_flag = false           # (x86-64 builds: the vectorizer may use __cpu_avx2)
want_loop_watch = false         # (debug web builds: loops count down to __loop_watchdog)
watch_build = false             # (built for `dewy watch`: WATCH is true in the program)
runtime_names = ["__alloc", "__free", "__panic", "__panic_bounds", "__panic_slice", "__panic_unwrap", "__free_obj", "__arr_clone", "__arr_push_slot",
    "__arr_reserve", "__arr_insert_slot", "__arr_remove_slot", "__arr_slice", "__fixed_slice", "__arr_concat", "__str_concat", "__str_eq",
    "__str_cmp", "__str_slice", "__str_append", "__buf_finish", "__buf_append_str", "__arr_resize", "__arr_repeat", "__arr_filled",
    "__print_str", "__str_from_bytes", "__assert_fail", "__hash_bytes", "__str_hash", "__div_zero", "__rc_inc", "__rc_dec",
    "__arr_extend", "__arr_extend_raw", "__rc_dec_test", "__out_flush", "__end_flush", "__box_new", "__box_free", "__box_clone", "__box_defer", "__box_next"]
optional_runtime = ["__requirement_fail", "__panic_narrow", "__mac_syscall"]
float_int_demanded = false     # (a float-to-integer conversion needs __float_int_fail)
runtime_insts: {str: int} = {}
# Runtime pieces with closures of their own are checked only once something needs them: the
# C-call thunks' once an extern is instantiated, vector formatting's and matrix products' where
# the checker meets them (expr.jo). Hello pays for neither.
runtime_ffi_scan = 1
runtime_ffi_done = false


runtime_fn = (name: str) -> int:
    if let f = runtime_insts.get(name): return f
    demand_name(intern(name))
    s = prelude.get(intern(name)) ?? 0
    if s == 0 or syms[s].kind != .fns: ice("missing runtime function {name}")
    f = get_fn_inst(int(syms[s].decl), [], nodes[int(syms[s].decl)].pos)
    runtime_insts[name] = f
    if starts_with(name, "__mi_") or starts_with(name, "__exact_"): check_pending_functions(f)
    f




dfs_state: bool[]
skip_main = false
export_decls: int[]
export_fns: int[]
order_modules = (m: int, out: mut int[]):
    if dfs_state[m]: return
    dfs_state[m] = true
    loop d in modules[m].decls:
        if nodes[d].kind == .import_:
            if nodes[d].aux == 2 or nodes[d].aux == 3: order_modules(int(nodes[d].sym), out)
            else if nodes[d].aux == 1:
                loop u in modules[m].uses: order_modules(u, out)
            else if let s = modules[m].names.get(int(nodes[d].name)):
                if syms[s].kind == .module: order_modules(int(syms[s].ref), out)
    if dp_loaded.len() > 0 and files[int(modules[m].file)].is_dewy:
        loop dm in dp_loaded: order_modules(dm, out)
    out.push(m)

program_named = false         # (the build block gave the name)

# Generated helpers preserve collection semantics and record protocols defined
# alongside their types, including inside arrays, optionals and enum payloads.
value_helper_types: {int: int} = {}  # bit 0: equality, bit 1: hashing
value_equal_fns: {int: int} = {}
value_hash_fns: {int: int} = {}

note_value_helpers = (t: int, hashing: bool = false):
    k = tkind(t)
    if k == .array or k == .fixed or k == .opt or k == .struct_ or k == .tuple or k == .enum_:
        bit = if hashing: 2 else: 1
        value_helper_types[t] = (value_helper_types.get(t) ?? 0) | bit




# ---------------- several values into calls and groups (multi_expressions.md) ----------------
# A group's items or a call's positional arguments, each several-valued one in place of its
# values, in order: `add(pair)` is `add(1 2)` when `pair = (1 2)`. Groups and spread array
# literals are spliced as written; a binding holding several values gives its parts; a call
# giving a static number of them, or a container spread with `...`, is held first (pre).
# Items before a held one that could have an effect are held too: all run in written order.
# call: the call whose arguments these are (0 for a group): a spread array of unknown
# length fills the positional parameters its function has left.
struct ValuesItem:
    count: int      # values it gives (1; k; -1 for an array of unknown length)
    spread: bool    # a container spread with `...`
    hidden: bool    # a binding or a call: how many it gives is not written here

values_hint_pos: int[]      # (inlay hints: where an argument giving several values is ...)
values_hint_first: int[]    # (... the first position its values fill ...)
values_hint_label: str[]    # (... and the parameters they fill, once the call is resolved)
values_hint_mark = 0        # (the first of the hints the arguments being expanded made)
values_hits: bool[]    # (by node: call arguments checked early that gave several values)

warning_collect_in = (mod: int, name: int, hide: int, ds: mut int[]): collect_in(mod, name, hide, &ds)
values_collect_fns = (name: int, ds: mut int[]): collect_fns(name, &ds)
values_collect_module = (mod: int, name: int, ds: mut int[]): collect_module(mod, name, &ds)


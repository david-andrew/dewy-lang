    "int", "`int64`", "Int", "`int64`", "integer", "`int64`", "long", "`int64`", "i64", "`int64`", "i32", "`int32`", "u8", "`uint8`", "u64", "`uint64`",
    "str", "`string`", "String", "`string`", "char", "`string` (a character is a one-character string)",
    "list", "`array<T>` (as `array<int64>`)", "List", "`array<T>` (as `array<int64>`)", "vector", "`array<T>` (as `array<int64>`)", "Vec", "`array<T>` (as `array<int64>`)",
    "dict", "`dict<K V>` (as `dict<string int64>`)", "Dict", "`dict<K V>` (as `dict<string int64>`)", "HashMap", "`dict<K V>` (as `dict<string int64>`)", "map", "`dict<K V>` (as `dict<string int64>`)",
    "length", "`.length`", "size", "`.length`", "len", "`.length`", "toString", "`string(x)`", "to_string", "`string(x)`",
    "forEach", "`loop x in xs \{ ... }`", "items", "`loop [key value] in m \{ ... }`", "entries", "`loop [key value] in m \{ ... }`",
    "self", "a parameter: functions take what they work on first (`move = (@p:Player dt:float64) => ...`, called as `p.move(dt)`)",
    "this", "a parameter: functions take what they work on first (`move = (@p:Player dt:float64) => ...`, called as `p.move(dt)`)",
    "includes", "`contains` or `x in? xs`", "delta_time", "`dt`, what update is given: `update = (dt:float64) => ...`", "deltaTime", "`dt`, what update is given: `update = (dt:float64) => ...`",
    "open", "`read_text(path)` (or `p\"file\".read_text`) gives the text or a file error; `write_text(path text)` and `append_file(path text)` write",
    "os", "the plain functions: `read_text`, `list_directory`, `run`, `env`, and paths, `p\"dir/file\"`",
    "isinstance", "`x is? T` (which member of a union x holds)", "Number", "`to_float(s)` (none when it is not a number) or `float64(x)`",
    "list_files", "`list_directory(path)`", "list_dir", "`list_directory(path)`",
    "copy", "nothing: `ys = xs` copies (arrays and records are values)", "clone", "nothing: `ys = xs` copies (arrays and records are values)", "deep_copy", "nothing: `ys = xs` copies (arrays and records are values)",
    "ljust", "`format(s \"<10\")`", "rjust", "`format(s \">10\")`", "center", "`format(s \"^10\")`", "zfill", "`format(n \"05\")`",
    "removeprefix", "a slice after checking `s.startswith(p)`: `s[p.length..]`", "removesuffix", "a slice after checking `s.endswith(p)`: `s[..s.length - p.length)`",
    "isEmpty", "`.length =? 0`", "isdigit", "a regular expression, `s.matches(regex(r\"\\d+\"))`, or `to_int(s) isnt? none`", "isalpha", "a regular expression: `s.matches(regex(r\"[a-zA-Z]+\"))`",
    "isspace", "`s.trim() =? \"\"`", "ord", "`bytes(c)[0]` (the first UTF-8 byte; `chr(n)` goes back)", "setdefault", "`if k not in? m \{m[k] = v}`",
    "str", "`string(x)`", "float", "`float64(x)`, or `to_float(s)` for text", "items", "`loop [key value] in m \{ ... }`",
    "null", "`none`", "nil", "`none`", "None", "`none`", "undefined", "`none`", "True", "`true`", "False", "`false`",
    "is", "`=?` to compare values; `x is? T` tests a type", "isupper", "`s =? upper(s)`", "islower", "`s =? lower(s)`",
    "try", "nothing: errors are values, handled with `match result \{ ... }`, `if result is? error`, or passed on with `result or_throw`",
    "except", "`match result \{ ... }` or `if result is? error`: errors are values", "catch", "`match result \{ ... }` or `if result is? error`: errors are values",
    "raise", "`return MyError[...]`: an error is a value the function returns, named in its result type as `:>int64|MyError`",
    "throw", "`return MyError[...]`: an error is a value the function returns, named in its result type as `:>int64|MyError`", "while", "`loop condition \{ ... }`, which repeats while the condition holds", "append", "`push`"]

DEWY_MAP_HABITS = ["size", "`m.length`", "length", "`m.length`", "has_key", "`m.has(k)` or `k in? m`", "containsKey", "`m.has(k)` or `k in? m`",
    "items", "`loop [key value] in m \{ ... }`", "forEach", "`loop [key value] in m \{ ... }`"]

# names from other languages for maps' operations
MAP_HABITS = ["set", "`m[k] = v`", "size", "`m.len()`", "length", "`m.len()`", "delete", "`m.remove(k)`", "has_key", "`m.has(k)` or `k in m`",
    "containsKey", "`m.has(k)` or `k in m`", "put", "`m[k] = v`", "items", "`loop k, v in m:`", "forEach", "`loop k, v in m:`"]

map_habit_name = (name: str) -> str:
    i = 0
    if ts_dewy:
        loop i + 1 < DEWY_MAP_HABITS.len():
            if DEWY_MAP_HABITS[i] == name: return DEWY_MAP_HABITS[i + 1]
            i += 2
        i = 0
    loop i + 1 < MAP_HABITS.len():
        if MAP_HABITS[i] == name: return if ts_dewy and jo_shaped(MAP_HABITS[i + 1]): "" else: MAP_HABITS[i + 1]
        i += 2
    ""

habit_name = (name: str) -> str:
    i = 0
    if ts_dewy:
        loop i + 1 < DEWY_HABITS.len():
            if DEWY_HABITS[i] == name: return DEWY_HABITS[i + 1]
            i += 2
        i = 0
    loop i < HABITS.len():
        if HABITS[i] == name: return if ts_dewy and jo_shaped(HABITS[i + 1]): "" else: HABITS[i + 1]
        i += 2
    ""

# (a hint written for Jo: its types, its commas between arguments, its `mut` and `->`, or a
# library spelling Dewy has another for; a Dewy program is better told nothing than that)
JO_HINT_WORDS = ["str", "f64", "f32", "i64", "i32", "i16", "i8", "u64", "u32", "u16", "u8", "mut", "struct", "enum", "elif", "len"]
jo_shaped = (hint: str) -> bool:
    if find(hint, ", ") >= 0 or find(hint, "[]") >= 0 or find(hint, "): ") >= 0 or find(hint, "->") >= 0 or find(hint, "if let") >= 0: return true
    i = 0
    loop i < len(hint):
        if not is_ident_start(hint[i]):
            i += 1
            continue
        j = i
        loop j < len(hint) and (is_alnum(hint[j]) or hint[j] == '_'): j += 1
        w = hint[i..j)
        if w in JO_HINT_WORDS or dewy_surface_table().has(intern(w)): return true
        i = j
    false

# an example of the annotation for an empty array or map
empty_hint = (nm: str, t0: int) -> str:
    t = prune(t0)
    if ts_dewy:
        if types[t].kind == .array: return " (`let {nm}:array<int64> = []` for an array of integers)"
        if is_map_type(t): return " (`let {nm}:dict<string int64> = []` for a dictionary from text to integers)"
        return ""
    if types[t].kind == .array:
        et = pushed_type(nm)
        if len(et) > 0: return " (`{nm}: {et}[] = []`: an array of {et}s, as pushed later)"
        return " (`{nm}: int[] = []` for an array of ints)"
    if is_map_type(t): return " (`{nm}: \{str: int} = \{}` for a map from text to ints)"
    ""

# enemies = [] and later enemies.push(vec2(...)): the type of what goes in, as written
pushed_type = (nm: str) -> str:
    id = intern(nm)
    loop i in [1..nodes.len()):
        if nodes[i].kind != .call or nkids(i) != 1: continue
        f = int(nodes[i].a)
        if f == 0 or nodes[f].kind != .field or name_of(int(nodes[f].name)) != "push": continue
        r = int(nodes[f].a)
        if r == 0 or nodes[r].kind != .ident or int(nodes[r].name) != id: continue
        x = kid(i, 0)
        xk = nodes[x].kind
        if xk == .str_lit: return "str"
        if xk == .int_lit: return "int"
        if xk == .float_lit: return "f64"
        if xk == .call and nodes[int(nodes[x].a)].kind == .ident:
            cn = name_of(int(nodes[int(nodes[x].a)].name))
            if cn == "rgb" or cn == "rgba" or cn == "hex": return "vec4"
            if cn == "vec2" or cn == "vec3" or cn == "vec4" or cn == "ivec2" or cn == "ivec3" or (len(cn) > 0 and cn[0] >= 'A' and cn[0] <= 'Z'): return cn
    ""

# a variable of this name was declared earlier in the function, in a block that has ended
gone_local_hint = (nm: int, at: int) -> str:
    if cx < 0: return ""
    inst = int(ctxs[cx].inst)
    l = locals.len() - 1
    loop l > 0:
        if int(locals[l].name) == nm and int(locals[l].owner) == inst and locals[l].pos < at and pos_file(locals[l].pos) == pos_file(at):
            ln, c = line_col(locals[l].pos)
            return " (the '{name_of(nm)}' made on line {ln} is inside a block that has ended; give it a value before that block to use it here)"
        l -= 1
    # (pos made in update, used in draw: each function's variables are its own)
    l = locals.len() - 1
    loop l > 0:
        o = int(locals[l].owner)
        if int(locals[l].name) == nm and o != inst and int(locals[l].flags) & LF_DECL != 0 and o > 0 and o < fns.len() and fns[o].decl != 0 and not pos_in_lib(locals[l].pos):
            fname = name_of(int(nodes[int(fns[o].decl)].name))
            ln, c = line_col(locals[l].pos)
            return " (the '{name_of(nm)}' made on line {ln} belongs to {fname}; for both to use it, give it its first value at the top level, outside the functions)"
        l -= 1
    ""

fold_case = (c: u8) -> u8:
    if c >= 'A' and c <= 'Z': return c + 32
    c

# names visible from the current scope: locals, the module, the standard library, built-ins
visible_names = () -> int[]:
    out = sc_names
    loop k, v in modules[cur_mod()].names: out.push(k)
    loop k, v in prelude: out.push(k)
    loop k, v in universe: out.push(k)
    out

type_names = () -> int[]:
    out: int[]
    dewy = files[int(modules[cur_mod()].file)].is_dewy
    loop tbl in [modules[cur_mod()].names, prelude, universe]:
        loop k, s in tbl:
            sk = syms[s].kind
            if dewy and universe.get(k) == s and dewy_type_word(name_of(k)) != "": continue
            if sk == .type_ or sk == .struct_ or sk == .enum_: out.push(k)
    out

# functions that could be called as recv.f(...): their first parameter has the receiver's kind
method_names = (recv: int) -> int[]:
    out: int[]
    rt = prune(recv)
    tables = [modules[cur_mod()].names, prelude]
    loop tm in method_modules(rt):
        if tm != cur_mod(): tables.push(modules[tm].names)
    loop tbl in tables:
        loop k, s0 in tbl:
            s = s0
            loop s != 0:
                if syms[s].kind == .fns and syms[s].decl != 0 and nkids(int(syms[s].decl)) > 0:
                    sig = fn_sig(int(syms[s].decl))
                    if sig.params.len() > 0:
                        p0 = prune(sig.params[0])
                        # (a method of a minted parent takes its family, which this type is in)
                        if types[p0].kind != .var and (types[p0].kind == types[rt].kind or type_eq(p0, rt) or family_annotation(p0) and value_members(p0).contains(rt)):
                            out.push(k)
                            break
                s = int(syms[s].next)
    out

cur_mod = () -> int:
    if cx >= 0: return int(ctxs[cx].mod)
    0

# (the game loop's functions and main keep their own kind of result)
__never_skip = (decl: int) -> bool:
    if nodes[decl].c != 0: return true          # (attributes: @cabi, @export... keep their types)
    nm = name_of(int(nodes[decl].name))
    nm == "main" or nm == "update" or nm == "draw"

# ---------------- modules ----------------
module_source = (stem: str, dewy: bool, exclude: str = "", watch_candidates: bool = false) -> str:
    extensions = if dewy: [".dewy", ".jo"] else: [".jo", ".dewy"]
    loop extension in extensions:
        path = stem + extension
        if path == exclude: continue
        if file_exists(path): return path
        if watch_candidates: watch_missing_input(path)
    ""

# Normalize graph identity without changing source paths: library checks also
# accept a relative lib_dir and compare it with the original source spelling.
module_path_key = (path: str) -> str:
    ide_norm(if is_abs_path(path): path else: "{os_path(cwd())}/{path}")

find_module = (path: str) -> int: module_by_path.get(module_path_key(path)) ?? -1

load_module = (path: str, is_prelude: bool, from: int) -> int:
    key = module_path_key(path)
    ex = module_by_path.get(key) ?? -1
    if ex >= 0:
        if prelude_pending.has(ex): register_module(ex)
        return ex
    src = read_source(path)
    if src == none: fatal(from, "cannot read '{path}'")
    d = "."
    slash = rfind(path, "/")
    if slash >= 0: d = path[..slash)
    files.push(SrcFile(path, d, src!, ends_with(path, ".dewy")))
    fi = files.len() - 1
    base = path
    if slash >= 0: base = path[slash + 1..]
    base = strip_ext(base)
    m = Module(name = i32(intern(base)), file = i32(fi), dir = d, is_prelude = is_prelude)
    modules.push(m)
    mi = modules.len() - 1
    module_by_path[key] = mi
    p_lazy = is_prelude and not ide_on
    decls = source_declarations(fi)
    p_lazy = false
    modules[mi].decls = decls
    mi

# Search from each Dewy module for a path back to itself. Traversing Jo
# modules catches mixed cycles, while visited nodes terminate Jo-only cycles.
# Compiler self-builds contain no Dewy modules and need no graph walks.
check_import_path = (root: int, m: int, seen: mut bool[], path: mut int[]) -> void:
    seen[m] = true
    path.push(m)
    loop edge in modules[m].imports:
        next = edge.0
        if next == root:
            names: str[]
            loop part in path: names.push(files[int(modules[part].file)].path)
            names.push(files[int(modules[root].file)].path)
            cycle = join(names, " -> ")
            fatal(edge.1, "Dewy module import cycle: {cycle}")
        if not seen[next]: check_import_path(root, next, seen, path)
    path.pop()
    return

check_import_cycles = ():
    loop m in [0..modules.len()):
        if not files[int(modules[m].file)].is_dewy: continue
        seen = fill(false, modules.len())
        path: int[]
        check_import_path(m, m, seen, path)

late_module_imports = false

# Some language operations need a bundled module only once their types are
# known. Add an ordinary qualified import and initialize any newly discovered
# modules, without rebinding imports that have already been processed.
ensure_bundled_import = (file: str, alias: str, pos: int):
    m = cur_mod()
    name = intern(alias)
    if modules[m].names.get(name) != none: return
    if files[int(modules[m].file)].path == lib_dir + "/" + file:
        scope_add_module(m, name, .module, m, 0)
        return
    first_module = modules.len()
    first_import = from_imports.len()
    d = mk(.import_, pos)
    nodes[d].aux2 = 1
    nodes[d].sval = i32(intern("@lib/{file}"))
    nodes[d].name = i32(name)
    register_decls(m, [d])
    modules[m].decls.push(d)
    mi = first_module
    loop mi < modules.len():
        register_module(mi)
        mi += 1
    bind_from_imports(first_import)
    if module_ctx.len() > 0: setup_module_contexts(init_fns[0])
    late_module_imports = true

eval_when_toplevel = (m: int, w: int):
    saved = cx
    ctxs.push(FnCtx(0, -1, i32(T_VOID), false, 0, i32(m), i32(sc_names.len())))
    cx = ctxs.len() - 1
    cond = const_eval_bool(int(nodes[w].a))
    ctxs.pop()
    cx = saved
    blk = int(nodes[w].c)
    if cond: blk = int(nodes[w].b)
    if blk == 0: return
    register_decls(m, kids(blk))

# The names in a destructuring pattern, in source order. Keep the tree until
# checking the source type; registration and declaration detection need leaves.
binding_leaves = (bindings: int[]) -> int[]:
    nested = false
    loop b in bindings:
        if nodes[b].kind == .tuple: nested = true; break
    if not nested: return bindings
    leaves: int[]
    loop b in bindings:
        if nodes[b].kind == .tuple:
            loop leaf in binding_leaves(kids(b)): leaves.push(leaf)
        else: leaves.push(b)
    leaves

# `x = value` where no variable x exists yet is a declaration
# (m >= 0: at the top level of module m, where only that module's globals count)
assign_declares = (s: int, m: int) -> bool:
    if nodes[s].kind != .assign or nodes[s].op != i32(int(Tok.assign)): return false
    lhs = int(nodes[s].a)
    lk = nodes[lhs].kind
    if lk == .ident: return not name_assignable(int(nodes[lhs].name), m)
    if lk != .tuple: return false
    any = false
    loop c in binding_leaves(kids(lhs)):
        ck = nodes[c].kind
        if ck == .hole: continue
        if ck != .ident: return false
        if name_assignable(int(nodes[c].name), m): return false
        any = true
    any

# (at the top level: the module's own variables, and those of the modules it `use`s and of the
# library, as in a function: `ui_style = ...` there changes the library's, not a new one)
# Another module's __ name (its own state) is not changed so: the line makes one of this module's
# (and in the library, whose modules share their names, it is an error to have two)
name_assignable = (nm: int, m: int) -> bool:
    if m < 0: return var_visible(nm)
    s = module_lookup(m, nm)
    if s == 0 or syms[s].kind != .global: return false
    if is_private(nm) and int(globals[int(syms[s].ref)].mod) != m: return false
    true

assign_to_decl = (s: int):
    lhs = int(nodes[s].a)
    if nodes[lhs].kind == .ident and files[pos_file(nodes[s].pos)].is_dewy:
        cs = lookup(int(nodes[lhs].name))
        if cs != 0 and syms[cs].kind == .const_:
            fatal(nodes[lhs].pos, "cannot modify const '{name_of(int(nodes[lhs].name))}'; use let to declare a new binding")
    if nodes[lhs].kind == .ident and cx >= 0 and int(nodes[lhs].name) < own_consts.len() and own_consts[int(nodes[lhs].name)]:
        # (MAX = 4 would make a variable hiding the program's constant MAX)
        cs = lookup(int(nodes[lhs].name))
        if cs != 0 and syms[cs].kind == .const_ and syms[cs].decl != 0 and not decl_in_prelude(int(syms[cs].decl)):
            cn = name_of(int(nodes[lhs].name))
            cp = nodes[int(syms[cs].decl)].pos
            if pos_in_lib(cp): fatal(nodes[lhs].pos, "'{cn}' is a constant of the library: it cannot change (`let {cn} = ...` makes a variable of that name)")
            ln, cc = line_col(cp)
            fatal(nodes[lhs].pos, "'{cn}' is a constant (`const` on line {ln}): it cannot change; to change it as the game runs, make it a variable there, without `const`")
    nodes[s].kind = .vardecl
    nodes[s].a = 0
    if nodes[lhs].kind == .ident:
        nodes[s].name = nodes[lhs].name
        nodes[s].pos = nodes[lhs].pos
    else:
        nodes[s].list = nodes[lhs].list
        nodes[s].nlist = nodes[lhs].nlist

# (a module `use`d by another is registered first, so that a top-level `x = ...` there sees the
# used module's x: name_assignable)
registered: bool[]
register_module = (m: int):
    loop registered.len() <= m: registered.push(false)
    if registered[m]: return
    parse_prelude_module(m)
    registered[m] = true
    register_decls(m, modules[m].decls)

register_decls = (m: int, decls: int[]):
    loop d in decls:
        nodes[d].mod = i32(m)
        if nodes[d].kind == .assign and assign_declares(d, m): assign_to_decl(d)
        k = nodes[d].kind
        nm = int(nodes[d].name)
        # (on_hit = (n: int): ... after `on_hit: (int) -> void = ...`: a new value for that variable)
        if k == .fn_ and not modules[m].is_prelude and not has_flag(d, NF_EXTERN):
            if let ex = modules[m].names.get(nm):
                if syms[ex].kind == .global:
                    lam = mk(.lambda, nodes[d].pos)
                    nodes[lam] = nodes[d]
                    nodes[lam].kind = .lambda
                    nodes[lam].name = 0
                    nodes[d] = nodes[bc_assign(bc_ident(name_of(nm), nodes[d].pos), lam, nodes[d].pos)]
                    nodes[d].mod = i32(m)
                    modules[m].inits.push(d)
                    continue
        if k == .fn_:
            scope_add_module(m, nm, .fns, 0, d)
            if nodes[d].c != 0:
                loop ai in [0..nkids(int(nodes[d].c))):
                    if name_of(int(nodes[kid(int(nodes[d].c), ai)].name)) == "export": export_decls.push(d)
        else if k == .struct_:
            if nominal_ready and nominal_declaration(d): fatal(nodes[d].pos, "nominal types must be declared before function checking; late nominal imports are not yet implemented")
            scope_add_module(m, nm, .struct_, d, d)
        else if k == .enum_: scope_add_module(m, nm, .enum_, d, d)
        else if k == .typealias: scope_add_module(m, nm, .alias_, d, d)
        else if k == .const_:
            globals.push(Global(name = i32(nm), decl = i32(d), mod = i32(m), is_const = true))
            scope_add_module(m, nm, .const_, globals.len() - 1, d)
        else if k == .import_:
            rel = name_of(int(nodes[d].sval))
            path = "{modules[m].dir}/{rel}.jo"
            if nodes[d].aux2 == 1:
                # use 'file.jo': relative to the importing file
                path = rel
                bundled = starts_with(rel, "@lib/")
                if bundled: path = "{lib_dir}/{rel[5..]}"
                else:
                    if not is_abs_path(rel): path = "{modules[m].dir}/{rel}"
                    if len(modules[m].dir) == 0: path = rel
                # ('package/file.jo': a file of a package)
                sl = find(rel, "/")
                if not bundled and not file_exists(path) and sl > 0:
                    pn = rel[..sl)
                    if let why = pkg_errs.get(pn): fatal(nodes[d].pos, why)
                    if let pd = pkg_dirs.get(pn): path = "{pd}/{rel[sl + 1..]}"
                if not file_exists(path):
                    watch_missing_input(path)
                    fatal(nodes[d].pos, "cannot find '{rel}' (looked for {path})")
            else if pkg_dirs.get(rel) != none or pkg_errs.get(rel) != none:
                # a package (pkg.jo): its main file
                if let why = pkg_errs.get(rel): fatal(nodes[d].pos, why)
                pd = pkg_dirs[rel]
                path = pkg_main(rel, pd) ?? ""
                if len(path) == 0: fatal(nodes[d].pos, "package '{rel}' has no main file ({rel}.jo, or only one .jo file at its root): import one of its files, as import '{rel}/file.jo'")
            else:
                # Named modules may be written in either language. Prefer the
                # importer's language within each directory; local files win.
                # Exclude the importing file itself (physics.dewy may import
                # the bundled physics implementation).
                current = files[int(modules[m].file)].path
                dewy = files[int(modules[m].file)].is_dewy
                path = module_source("{modules[m].dir}/{rel}", dewy, current, true)
                # (a file beside it with a library module's name: that file, said once)
                if len(path) > 0 and not pos_in_lib(nodes[d].pos) and len(module_source("{lib_dir}/{rel}", dewy)) > 0:
                    warn(nodes[d].pos, "this imports {path}, not the library's {rel} (a file beside this one has its name)")
                if len(path) == 0: path = module_source("{lib_dir}/{rel}", dewy)
                if len(path) == 0: path = module_source("{lib_dir}/std/{rel}", dewy)
                if len(path) == 0: path = module_source("{lib_dir}/game/{rel}", dewy)
                if len(path) == 0: path = module_source("{lib_dir}/core/{rel}", dewy)
                if len(path) == 0:
                    pym = ""
                    if rel == "re": pym = ": regular expressions are there without an import, `regex(r\"\\d+\")`"
                    else if rel == "sys": pym = ": `args()` is the command line, `exit(code)` ends the program"
                    else if rel == "json": pym = ": `parse_json(s)` and `to_json(x)` are there without an import"
                    else if rel == "os" or rel == "shutil" or rel == "pathlib" or rel == "glob": pym = ": files are there without an import: `read_file`, `list_dir`, `walk_dir`, `glob`, `make_dirs`, `rename_file`, `join_path`"
                    else if rel == "time" or rel == "datetime": pym = ": `time()`, `unix_time()`, `now()` (a Date) and `sleep(s)` are there without an import"
                    else if rel == "random" or rel == "math": pym = ": `random()`, `random_int(lo, hi)`, `sqrt`, `floor`, `PI` are there without an import"
                    else if rel == "csv": pym = ": `csv_rows(text)` is there without an import"
                    else if rel == "collections": pym = ": maps start missing keys at zero (`counts[w] += 1`); `sorted_by`, `unique`, `group_by`"
                    else if rel == "subprocess": pym = ": `run_program(\"ls\", [\"-l\"])` (its exit code and output)"
                    else if rel == "argparse": pym = ": a struct of the options (`verbose = false`, `out = \"a.txt\"`, `files: str[]`), then `opts = parse_args[Options](\"what it does\")`"
                    else if rel == "hashlib": pym = ": `sha256(text_or_bytes)` is there without an import (as hex digits)"
                    fatal(nodes[d].pos, "cannot find module '{rel}'{pym}")
            im = load_module(path, false, nodes[d].pos)
            modules[m].imports.push((im, nodes[d].pos))
            if nodes[d].aux == 1:
                modules[m].uses.push(im)
                register_module(im)
            else if nodes[d].aux == 2:
                # from x import a, b: bound once every module's names are known (bind_from_imports)
                nodes[d].sym = i32(im)
                from_imports.push(d)
            else: scope_add_module(m, nm, .module, im, d)
        else if k == .when_: eval_when_toplevel(m, d)
        else if k == .build_:
            if modules[m].is_main: build_node = d
        else if k == .test_:
            if test_mode and modules[m].is_main: test_decls.push(d)
        else if k == .vardecl:
            if nodes[d].nlist > 0:
                loop id in binding_leaves(kids(d)):
                    if nodes[id].kind == .hole: continue
                    g = new_global(int(nodes[id].name), d, m)
                    nodes[id].sym = i32(g)
                    add_flag(id, NF_GLOBAL)
                    scope_add_module(m, int(nodes[id].name), .global, g, id)
            else:
                g = new_global(nm, d, m)
                nodes[d].sym = i32(g)
                scope_add_module(m, nm, .global, g, d)
            add_flag(d, NF_GLOBAL)
            if not modules[m].is_prelude: modules[m].inits.push(d)
        else:
            if modules[m].is_prelude: fatal(nodes[d].pos, "statements are not allowed at the top level of library modules")
            modules[m].inits.push(d)


# is there a variable of this name in scope (assigning to it changes it)?
var_visible = (nm: int) -> bool:
    s = lookup(nm)
    if s == 0: return false
    k = syms[s].kind
    k == .local or k == .global

new_global = (name: int, decl: int, m: int) -> int:
    inst_counter += 1
    globals.push(Global(name = i32(name), decl = i32(decl), mod = i32(m), sym = "g_{name_of(name)}_{inst_counter}"))
    g = globals.len() - 1
    global_ids.push(g)
    g

# ---------------- type resolution ----------------
resolve_type = (tn: int) -> int:
    if nodes[tn].kind == .tname and nodes[tn].aux == -7: return int(nodes[tn].ival)
    k = nodes[tn].kind
    if k == .trefined: return resolve_refinement(tn)
    if k == .tquantity: return resolve_quantity_type(tn)
    # (Dewy's array<T> and dict<K V>: the type words, for the editor)
    if ide_on and (k == .tarray or k == .tmap) and nodes[tn].pos > 0 and files[pos_file(nodes[tn].pos)].is_dewy:
        ide_ref(nodes[tn].pos, intern(if k == .tarray: "array" else: "dict"), IK_TYPE, 0, 0, 0)
    if k == .tname:
        if nodes[tn].aux == -8: fatal(nodes[tn].pos, "Effect row is not a value type")
        nm = int(nodes[tn].name)
        s = 0
        if nodes[tn].sval != 0:
            ms = lookup(int(nodes[tn].sval))
            if ms != 0 and syms[ms].kind == .reflected and name_of(nm) == "type": return int(fields[int(syms[ms].ref)].type)
            if ms == 0 or syms[ms].kind != .module: fatal(nodes[tn].pos, "unknown module '{name_of(int(nodes[tn].sval))}'")
            s = module_lookup(int(syms[ms].ref), nm)
            if name_of(int(nodes[tn].sval))[0] != '$' and files[pos_file(nodes[tn].pos)].is_dewy: rational_one_spelling(int(syms[ms].ref), nm, nodes[tn].pos, "")
        else:
            if ide_sentinel != 0 and nm == ide_sentinel: ide_complete_types()
            s = lookup(nm)
            jo_type_spelling(nm, s, nodes[tn].pos)
            # `rational`: the builtin exact type (the bundled library's), unless a type shadows it.
            if name_of(nm) == "rational" and (s == 0 or syms[s].kind == .fns) and files[pos_file(nodes[tn].pos)].is_dewy:
                if nkids(tn) == 0: return decimal_type(nodes[tn].pos)
                if nkids(tn) == 1 and resolve_type(kid(tn, 0)) == T_INT: return word_rational_type(nodes[tn].pos)
                fatal(nodes[tn].pos, "`rational` is the exact type and `rational<int64>` its one fixed-width form")
        if s == 0:
            if name_of(nm) == "none": return T_NONE
            # (push = (h: mut Heap[T], x: T): a generic function names its type parameters)
            tn_s = name_of(nm)
            if len(tn_s) <= 2 and tn_s[0] >= 'A' and tn_s[0] <= 'Z' and cx >= 0 and fns.len() > int(ctxs[cx].inst):
                fatal(nodes[tn].pos, jd(nodes[tn].pos, "unknown type '{tn_s}' (a generic function names its type parameters after its name: `f[{tn_s}] = (x: {tn_s}) -> {tn_s}: ...`; a generic struct, `struct Heap[{tn_s}]:`)", "unknown type '{tn_s}' (a generic function declares its type parameters first: `f = <{tn_s}>(x:{tn_s}):>{tn_s} => ...`; a generic record, `Heap:type = <{tn_s}>[items:array<{tn_s}>]`)"))
            fatal(nodes[tn].pos, "unknown type '{name_of(nm)}'{suggestion(name_of(nm), type_names())}")
        sk = syms[s].kind
        # (str = (b: Big) -> str: a function of the program's named as a type, its `str` there
        # still the type)
        if sk == .fns:
            if let u = universe.get(nm):
                s = u
                sk = syms[s].kind
        if ide_on: ide_sym_ref(tn, s)
        if sk == .alias_:
            targs: int[]
            d = int(syms[s].ref)
            loop i in [0..nkids(tn)):
                if i < nkids2(d) and nodes[kid2(d, i)].aux == 1: targs.push(effect_argument(kid(tn, i)))
                else: targs.push(resolve_type(kid(tn, i)))
            return nominal_family(resolve_alias(int(syms[s].ref), targs, nodes[tn].pos))
        if sk == .type_:
            if tkind(int(syms[s].ref)) == .effect: fatal(nodes[tn].pos, "Effect row is not a value type")
            if nodes[tn].nlist > 0:
                if fixed_size_arg(tn): return mk_fixed_checked(int(syms[s].ref), fixed_size(kid(tn, 0)), nodes[tn].pos)
                fatal(nodes[tn].pos, "type '{name_of(nm)}' takes no type arguments")
            return nominal_family(int(syms[s].ref))
        if sk == .struct_ or sk == .enum_:
            d = int(syms[s].ref)
            ntp = nkids2(d)
            if ntp == 0 and fixed_size_arg(tn):
                return mk_fixed_checked(get_struct_inst(d, []), fixed_size(kid(tn, 0)), nodes[tn].pos)
            if nkids(tn) != ntp: fatal(nodes[tn].pos, "type '{name_of(nm)}' expects {ntp} type argument(s), got {nkids(tn)}")
            targs: int[]
            loop i in [0..ntp): targs.push(resolve_type(kid(tn, i)))
            return nominal_family(get_struct_inst(d, targs))
        h = habit_name(name_of(nm))
        if len(h) > 0: fatal(nodes[tn].pos, "'{name_of(nm)}' is not a type (use {h})")
        fatal(nodes[tn].pos, "'{name_of(nm)}' is not a type")
    if k == .trecord:
        let fields = kids(tn)
        seen: {int: bool} = {}
        old_fields = refine_fields
        if refine_active:
            refine_fields = []
            loop field in fields:
                name = int(nodes[field].name)
                i = 0
                loop i < refine_fields.len() and name_of(refine_fields[i]) < name_of(name): i += 1
                refine_fields.insert(i, name)
        loop field in fields:
            name = int(nodes[field].name)
            if seen.has(name): fatal(nodes[field].pos, "duplicate record field '{name_of(name)}'")
            seen[name] = true
            t = resolve_type(int(nodes[field].a))
            if tkind(t) == .void_ or tkind(t) == .typeval:
                fatal(nodes[field].pos, "inline record fields need value types")
            nodes[field].type = i32(t)
        refine_fields = old_fields
        t = dewy_record_schema(tn, fields)
        if refine_active: ref_validate_record(t, nodes[tn].pos)
        return t
    if k == .tarray:
        if nodes[tn].b != 0: return mk_fixed_checked(resolve_type(int(nodes[tn].a)), fixed_size(int(nodes[tn].b)), nodes[tn].pos)
        if nodes[tn].aux >= 2: return nd_of(resolve_type(int(nodes[tn].a)), nodes[tn].pos)
        if has_flag(tn, NF_SOA):
            et = resolve_type(int(nodes[tn].a))
            # (soa T[] of a generic function's T: a struct once it is known)
            if (tkind(et) != .struct_ and tkind(et) != .param) or is_soa(et): fatal(nodes[tn].pos, "soa T[] needs a struct type T, not {dt(et)}")
            if soa_decl == 0: soa_decl = mk(.struct_, 0)
            return soa_inst(et)
        return mk_array(resolve_type(int(nodes[tn].a)))
    if k == .tmap:
        s = prelude.get(intern("Map")) ?? 0
        if s == 0: fatal(nodes[tn].pos, "Map type is not available")
        return get_struct_inst(int(syms[s].ref), [resolve_type(int(nodes[tn].a)), resolve_type(int(nodes[tn].b))])
    if k == .ttuple:
        el: int[]
        loop i in [0..nkids(tn)): el.push(resolve_type(kid(tn, i)))
        if el.len() == 0: return T_VOID
        return mk_tuple(el)
    if k == .topt: return mk_opt(resolve_type(int(nodes[tn].a)))
    if k == .tunion:
        ms: int[]
        loop i in [0..nkids(tn)): ms.push(resolve_type(kid(tn, i)))
        return mk_union(ms)
    if k == .tptr: return mk_ptr(resolve_type(int(nodes[tn].a)))
    if k == .tfn:
        old_formals = refine_formals
        old_self = refine_self
        if refine_active:
            refine_formals = []
            loop p in kids2(tn): refine_formals.push(int(nodes[p].name))
        ps: int[]
        mm = 0
        loop i in [0..nkids(tn)):
            if i < refine_formals.len(): refine_self = refine_formals[i]
            ps.push(resolve_type(kid(tn, i)))
            if has_flag(kid(tn, i), NF_MUT): mm |= 1 << i
        ret = T_VOID
        refine_self = 0
        if nodes[tn].a != 0: ret = resolve_type(int(nodes[tn].a))
        if refine_active: ref_validate_signature(ps, ret, mm, nodes[tn].pos)
        refine_formals = old_formals
        refine_self = old_self
        if has_flag(tn, NF_CABI): return mk_cfn(ps, ret)
        key = 0
        if nkids2(tn) > 0:
            labels: int[]
            loop p in kids2(tn): labels.push(int(nodes[p].name))
            key = fn_label_key(labels)
        base = mk_fn(ps, ret, mm, key)
        if nodes[tn].sval == 0: return base
        names: int[]
        loop p in kids2(tn): names.push(int(nodes[p].name))
        return mk_callable_contract(base, effect_contract(tn, ps, names, mm))
    fatal(nodes[tn].pos, "invalid type")
    0

readonly_global = (g: int) -> bool:
    d = int(globals[g].decl)
    d != 0 and has_flag(d, NF_RDONLY)

binding_const_init = (kind: SK, ref: int, pos: int) -> int:
    if kind == .const_:
        if globals[ref].init != 0: return int(globals[ref].init)
        if globals[ref].decl != 0: return int(nodes[int(globals[ref].decl)].b)
    else if kind == .global and readonly_global(ref):
        ensure_global(ref, pos)
        return int(nodes[int(globals[ref].decl)].b)
    else if kind == .local:
        let ref = ref
        loop int(locals[ref].flags) & LF_CAPTURE != 0: ref = int(locals[ref].outer)
        if int(locals[ref].flags) & LF_CONST != 0: return int(locals[ref].const_init)
    0

# T[N] written as a type name with one argument (the parser cannot tell `int[N]` from a generic
# type's argument): the argument is a constant's name
fixed_size_arg = (tn: int) -> bool:
    if nkids(tn) != 1: return false
    a = kid(tn, 0)
    if nodes[a].kind != .tname or nodes[a].nlist > 0 or nodes[a].sval != 0: return false
    s = lookup(int(nodes[a].name))
    s != 0 and binding_const_init(syms[s].kind, int(syms[s].ref), nodes[tn].pos) != 0

# the size of a fixed-size array type: a number or a compile-time constant
fixed_size = (n: int) -> int:
    v = 0
    if nodes[n].kind == .tname:
        e = mk(.ident, nodes[n].pos)
        nodes[e].name = nodes[n].name
        v = ceval(e).i
    else: v = ceval(n).i
    if v < 1: fatal(nodes[n].pos, "the size of a fixed-size array must be at least 1 (found {v})")
    if v > (1 << 28): fatal(nodes[n].pos, "fixed-size array too large ({v} elements; use {jd(nodes[n].pos, "T[]", "array<T>")} for big arrays)")
    v

mk_fixed_checked = (e: int, n: int, pos: int) -> int:
    if tkind(e) == .void_: fatal(pos, "an array of void")
    mk_fixed(e, n)

# T[,], T[,,] ...: n-dimensional arrays (lib/std/nd.jo)
nd_of = (t: int, pos: int) -> int:
    s = prelude.get(intern("NDArray")) ?? 0
    if s == 0: fatal(pos, "n-dimensional arrays are not available (lib/std/nd.jo is missing)")
    get_struct_inst(int(syms[s].ref), [t])

# type Name[T] = ...: the type it stands for, given its type arguments
resolve_alias = (d: int, targs: int[], use_pos: int) -> int:
    ntp = nkids2(d)
    nm = name_of(int(nodes[d].name))
    if targs.len() != ntp: fatal(use_pos, "type '{nm}' expects {ntp} type argument(s), got {targs.len()}")
    if ntp == 0 and nodes[d].type != 0: return int(nodes[d].type)
    if nodes[d].aux == 1: fatal(nodes[d].pos, "type '{nm}' is defined in terms of itself")
    nodes[d].aux = 1
    saved = cx
    ctxs.push(FnCtx(i32(new_inst(FK_INIT, int(nodes[d].mod), "typedef")), -1, i32(T_VOID), false, 0, nodes[d].mod, i32(sc_names.len())))
    cx = ctxs.len() - 1
    mark = scope_mark()
    push_type_params(d, targs)
    t = resolve_type(int(nodes[d].a))
    scope_reset(mark)
    ctxs.pop()
    cx = saved
    nodes[d].aux = 0
    if ntp == 0: nodes[d].type = i32(t)
    t

subst = (t0: int, targs: int[]) -> int:
    t = prune(t0)
    if t == 0 or not has_var(t): return t
    k = types[t].kind
    if k == .param:
        id = int(types[t].id)
        if id < targs.len() and targs[id] != 0: return targs[id]
        return t
    if k == .var: return t
    if k == .effect: return effect_type(effect_subst(int(types[t].st), targs))
    if k == .callable: return mk_callable_contract(subst(int(types[t].elem), targs), effect_subst(int(types[t].st), targs), int(types[t].bits))
    if k == .refined: return mk_refined(subst(int(types[t].elem), targs), ref_subst(int(types[t].st), targs))
    if k == .quantity: return mk_quantity(subst(int(types[t].elem), targs), int(types[t].st))
    if k == .array: return mk_array(subst(int(types[t].elem), targs))
    if k == .fixed: return mk_fixed(subst(int(types[t].elem), targs), fixed_len(t))
    if k == .ptr: return mk_ptr(subst(int(types[t].elem), targs))
    if k == .opt: return mk_opt(subst(int(types[t].elem), targs))
    if k == .fn_ or k == .tuple or k == .cfn:
        a: int[]
        loop i in [0..int(types[t].nargs)): a.push(subst(targ(t, i), targs))
        if k == .tuple: return mk_tuple(a)
        if k == .cfn: return mk_cfn(a, subst(int(types[t].elem), targs))
        return mk_fn(a, subst(int(types[t].elem), targs), int(types[t].mutmask), int(types[t].st))
    if k == .struct_ or k == .enum_:
        si = int(types[t].st)
        a: int[]
        loop i in [0..int(structs[si].ntargs)): a.push(subst(struct_targ(si, i), targs))
        return get_struct_inst(int(structs[si].decl), a)
    t

push_type_params = (decl: int, targs: int[]):
    loop i in [0..nkids2(decl)):
        if i < targs.len() and (nodes[kid2(decl, i)].aux == 1) != (tkind(targs[i]) == .effect): fatal(nodes[kid2(decl, i)].pos, "generic argument kind mismatch: expected Effect or value type")
        if i < targs.len(): push_scope_sym(int(nodes[kid2(decl, i)].name), new_sym(int(nodes[kid2(decl, i)].name), .type_, targs[i], 0))

check_struct_fields = (si: int):
    if structs[si].resolved: return
    structs[si].resolved = true
    d = int(structs[si].decl)
    targs: int[]
    loop i in [0..int(structs[si].ntargs)): targs.push(struct_targ(si, i))
    saved = cx
    ctxs.push(FnCtx(i32(new_inst(FK_INIT, int(nodes[d].mod), "fielddef")), -1, i32(T_VOID), false, 0, nodes[d].mod, i32(sc_names.len())))
    cx = ctxs.len() - 1
    mark = scope_mark()
    push_type_params(d, targs)
    if nodes[d].kind == .struct_:
        n = nkids(d)
        inherited: Field[]
        parent = nominal_parent.get(int(structs[si].type), 0)
        if parent != 0:
            psi = int(types[parent].st)
            check_struct_fields(psi)
            loop i in [0..int(structs[psi].nfields)): inherited.push(fields[int(structs[psi].fields) + i])
        structs[si].fields = i32(fields.len())
        structs[si].nfields = i32(n + inherited.len())
        loop field in inherited: fields.push(field)
        loop i in [0..n): fields.push(Field())
        old_fields = refine_fields
        if refine_active:
            refine_fields = []
            loop field in inherited: refine_fields.push(int(field.name))
            loop i in [0..n): refine_fields.push(int(nodes[kid(d, i)].name))
        loop i in [0..n):
            f = kid(d, i)
            fi = int(structs[si].fields) + inherited.len() + i
            fields[fi].name = nodes[f].name
            fields[fi].defval = nodes[f].b
            if nodes[f].a != 0: fields[fi].type = i32(resolve_type(int(nodes[f].a)))
            else if nodes[f].b != 0:
                cl = clone(int(nodes[f].b))
                # (a default may name the fields before it)
                inner = scope_mark()
                if files[pos_file(nodes[d].pos)].is_dewy:
                    loop j in [0..inherited.len() + i):
                        earlier = fields[int(structs[si].fields) + j]
                        if earlier.type != 0: new_local(int(earlier.name), int(earlier.type), nodes[f].pos)
                t = check_expr(cl, 0)
                scope_reset(inner)
                if has_flag(cl, NF_LITERAL):
                    t = lit_default(cl)
                fields[fi].type = i32(zonk(t))
            else: fatal(nodes[f].pos, "field needs a type")
            loop k in [0..inherited.len() + i):
                if fields[int(structs[si].fields) + k].name == nodes[f].name: fatal(nodes[f].pos, "duplicate field '{name_of(int(nodes[f].name))}'")
        refine_fields = old_fields
        if refine_active: ref_validate_record(int(structs[si].type), nodes[d].pos)
    else:
        nv = nkids(d)
        structs[si].variants = i32(variants.len())
        structs[si].nvariants = i32(nv)
        loop v in [0..nv): variants.push(Variant())
        next_val = 0
        loop v in [0..nv):
            vn = kid(d, v)
            vi = int(structs[si].variants) + v
            variants[vi].name = nodes[vn].name
            variants[vi].tag = i32(v)
            if nodes[vn].a != 0:
                if nodes[int(nodes[vn].a)].kind != .int_lit: fatal(nodes[vn].pos, "enum value must be an integer literal")
                next_val = nodes[int(nodes[vn].a)].ival
            variants[vi].value = next_val
            next_val += 1
            nf = nkids(vn)
            variants[vi].fields = i32(fields.len())
            variants[vi].nfields = i32(nf)
            loop i in [0..nf): fields.push(Field())
            loop i in [0..nf):
                fn_ = kid(vn, i)
                fi = int(variants[vi].fields) + i
                fields[fi].name = nodes[fn_].name
                fields[fi].type = i32(resolve_type(int(nodes[fn_].a)))
            loop k in [0..v):
                if variants[int(structs[si].variants) + k].name == nodes[vn].name: fatal(nodes[vn].pos, "duplicate variant '{name_of(int(nodes[vn].name))}'")
    scope_reset(mark)
    ctxs.pop()
    cx = saved

module_of_type = (t0: int) -> int:
    t = prune(t0)
    k = types[t].kind
    if (k == .struct_ or k == .enum_) and types[t].st != 0 or (k == .struct_ or k == .enum_): return int(nodes[int(structs[int(types[t].st)].decl)].mod)
    -1

# The modules whose functions are methods of t: its own, then those of the types it is
# minted under (a minted child has its parents' methods, wherever they were declared)
method_modules = (t0: int) -> int[]:
    out: int[]
    t = prune(t0)
    loop t != 0:
        m = module_of_type(t)
        if m >= 0 and not out.contains(m): out.push(m)
        t = nominal_parent.get(t, 0)
    out

# ---------------- functions ----------------
decl_info = (decl: int) -> int:
    if nodes[decl].sym == 0:
        decl_infos.push(DeclInfo())
        nodes[decl].sym = i32(decl_infos.len() - 1)
    int(nodes[decl].sym)

fn_sig = (decl: int) -> FnSig:
    di = decl_info(decl)
    if decl_infos[di].sig.done: return decl_infos[di].sig
    sig = FnSig(done = true)
    sig.nexplicit = i32(nkids2(decl))
    saved = cx
    parent = if nodes[decl].kind == .lambda: cx else: -1
    floor = if parent >= 0: ctxs[parent].floor else: i32(sc_names.len())
    ctxs.push(FnCtx(0, i32(parent), i32(T_VOID), false, 0, nodes[decl].mod, floor))
    cx = ctxs.len() - 1
    mark = scope_mark()
    ntp = nkids2(decl)
    loop i in [0..ntp):
        nm = int(nodes[kid2(decl, i)].name)
        pt = mk_param(i)
        if nodes[kid2(decl, i)].aux == 1: pt = effect_type(effect_intern([], [], [pt]))
        push_scope_sym(nm, new_sym(nm, .type_, pt, 0))
    old_formals = refine_formals
    old_self = refine_self
    refine_formals = []
    if refine_active:
        loop p in kids(decl): refine_formals.push(int(nodes[p].name))
    mm = 0
    loop i in [0..nkids(decl)):
        p = kid(decl, i)
        refine_self = int(nodes[p].name)
        if nodes[p].a != 0: sig.params.push(resolve_type(int(nodes[p].a)))
        else:
            sig.params.push(mk_param(ntp))
            ntp += 1
        if has_flag(p, NF_MUT): mm |= 1 << i
    sig.mutmask = i32(mm)
    sig.ntp = i32(ntp)
    sig.generic = ntp > 0
    refine_self = 0
    if nodes[decl].a != 0: sig.ret = i32(resolve_type(int(nodes[decl].a)))
    else if has_flag(decl, NF_VOID): sig.ret = i32(T_VOID)
    if result_active: result_signature(decl, sig.params, int(sig.ret))
    if proof_active and proof_decls.has(decl):
        if sig.ret != 0 and sig.ret != T_VOID: fatal(nodes[decl].pos, "$proof cannot return a value")
        sig.ret = i32(T_VOID)
        loop p in kids(decl):
            if has_flag(p, NF_MUT) or nodes[p].b != 0: fatal(nodes[p].pos, "$proof forbids defaults and place parameters")
        predicate = proof_decls[decl]
        atoms: RefAtom[]
        if predicate != 0: ref_atoms(predicate, 0, atoms)
        loop atom in atoms: proof_atom_type(atom, sig.params, nodes[decl].pos)
        proof_predicates[decl] = ref_intern(atoms)
    if refine_active:
        ref_validate_signature(sig.params, int(sig.ret), mm, nodes[decl].pos)
        if has_flag(decl, NF_EXTERN):
            loop t in sig.params + [int(sig.ret)]:
                if ref_storage_contract(t): fatal(nodes[decl].pos, "extern refinement contracts require a checked implementation")
    if effects_active and has_flag(decl, NF_EXTERN):
        seen: int[]
        if effect_qualified_type(int(sig.ret), seen): fatal(nodes[decl].pos, "extern callable effect contracts require a checked implementation")
    if nodes[decl].sval != 0: sig.contract = i32(effect_decl_contract(decl, sig.params))
    scope_reset(mark)
    ctxs.pop()
    cx = saved
    refine_formals = old_formals
    refine_self = old_self
    decl_infos[di].sig = sig
    sig

# (operators get names: ([]) is op_index, shown as such in backtraces: lib/std/backtrace.jo)
OP_NAMES = ["[]", "index", "[]=", "set", "+", "add", "-", "sub", "*", "mul", "/", "div", "%", "mod", "==", "eq", "<", "lt", "^", "pow"]

sanitize = (s: str) -> str:
    if len(s) > 0 and not is_alnum(s[0]) and s[0] != '_':
        i = 0
        loop i < OP_NAMES.len():
            if OP_NAMES[i] == s: return "op_{OP_NAMES[i + 1]}"
            i += 2
        return "op"
    b: u8[]
    loop c in s:
        if is_alnum(c): b.push(c)
        else: b.push('X')
        if b.len() > 40: break
    str_from_bytes(b)

new_inst = (kind: int, m: int, base: str) -> int:
    inst_counter += 1
    fns.push(FnInst(kind = i32(kind), mod = i32(m), sym = "f_{base}_{inst_counter}"))
    fns.len() - 1

has_value_return = (n: int) -> bool:
    if n == 0: return false
    k = nodes[n].kind
    if k == .return_: return nodes[n].a != 0
    if k == .lambda: return false
    if has_value_return(int(nodes[n].a)) or has_value_return(int(nodes[n].b)): return true
    if k != .for_ and has_value_return(int(nodes[n].c)): return true
    loop i in [0..nkids(n)):
        if has_value_return(kid(n, i)): return true
    false

# The type of a value the body `b` of the function `name` ends with that does not call it, nor
# any function whose result is still being worked out (is_even and is_odd calling each other),
# (a typed one before a literal), or 0. Each candidate is checked as a copy, here, so it may only
# use names already in scope.
recursive_base_type = (b: int, name: int) -> int:
    pending = [name]
    loop c in ctxs:
        f = int(c.inst)
        if f > 0 and f < fns.len() and fns[f].state == 1 and fns[f].ret == 0 and fns[f].decl != 0:
            pending.push(int(nodes[int(fns[f].decl)].name))
    leaves: int[]
    value_leaves(b, leaves)
    returned_values(b, leaves)
    literal = 0
    loop leaf in leaves:
        if not base_case(leaf, pending): continue
        e = clone(leaf)
        t = check_expr(e, 0)
        if has_flag(e, NF_LITERAL):
            if literal == 0: literal = lit_default(e)
            continue
        if t != 0 and tkind(t) != .var and tkind(t) != .void_ and t != T_NEVER: return prune(t)
    literal

value_leaves = (n: int, out: mut int[]):
    if n == 0: return
    k = nodes[n].kind
    if k == .block:
        if nkids(n) > 0: value_leaves(kid(n, nkids(n) - 1), out)
    else if k == .exprstmt or k == .return_: value_leaves(int(nodes[n].a), out)
    else if k == .if_:
        value_leaves(int(nodes[n].b), out)
        value_leaves(int(nodes[n].c), out)
    else if k == .match_:
        loop arm in kids(n): value_leaves(int(nodes[arm].b), out)
    else: out.push(n)

returned_values = (n: int, out: mut int[]):
    if n == 0 or nodes[n].kind == .lambda: return
    if nodes[n].kind == .return_ and nodes[n].a != 0: value_leaves(int(nodes[n].a), out)
    returned_values(int(nodes[n].a), out)
    returned_values(int(nodes[n].b), out)
    returned_values(int(nodes[n].c), out)
    loop i in [0..nkids(n)): returned_values(kid(n, i), out)

# (an expression that names none of the functions `pending` and nothing out of scope here)
base_case = (n: int, pending: int[]) -> bool:
    if n == 0: return true
    k = nodes[n].kind
    if k == .lambda or k == .block or k == .match_: return false
    if k == .ident and (int(nodes[n].name) in pending or lookup(int(nodes[n].name)) == 0): return false
    if not base_case(int(nodes[n].a), pending) or not base_case(int(nodes[n].b), pending) or not base_case(int(nodes[n].c), pending): return false
    loop i in [0..nkids(n)):
        if not base_case(kid(n, i), pending): return false
    true

# the name of the type a Dewy method belongs to, or ""
method_type_name = (d: int) -> str:
    t = int(nodes[kid(d, 0)].a)
    if t == 0 or nodes[t].kind != .tname: return ""
    name_of(int(nodes[t].name))

syntactic_void = (body: int) -> bool:
    if body == 0 or nkids(body) == 0: return true
    if has_value_return(body): return false
    last = kid(body, nkids(body) - 1)
    k = nodes[last].kind
    if k == .exprstmt: return false
    if k == .if_ or k == .iflet: return nodes[last].c == 0
    true

# (@no_web("why"): a function that does nothing in a browser, said where a web build's program
# calls it)
no_web_warned: {int: bool}
no_web_check = (decl: int, use_pos: int):
    if use_pos <= 0 or pos_in_lib(use_pos) or no_web_warned.has(use_pos): return
    ab = int(nodes[decl].c)
    loop i in [0..nkids(ab)):
        at = kid(ab, i)
        if name_of(int(nodes[at].name)) != "no_web" or nodes[at].a == 0 or nodes[int(nodes[at].a)].kind != .str_lit: continue
        no_web_warned[use_pos] = true
        warn(use_pos, "{name_of(int(nodes[decl].name))} {name_of(int(nodes[int(nodes[at].a)].sval))}")

get_fn_inst = (decl: int, targs: int[], use_pos: int) -> int:
    if nodes[decl].kind == .lambda: return poly_inst(decl, targs, use_pos)
    if target_wasm and nodes[decl].c != 0: no_web_check(decl, use_pos)
    di = decl_info(decl)
    sig = fn_sig(decl)
    concrete = targs.len() > 0
    loop t in targs:
        if has_var(t): concrete = false
    if concrete:
        if let f = fn_instances.get(FnInstanceKey(decl, targs)):
            ensure_ret(f, use_pos)
            return f
    else:
        loop f in decl_infos[di].insts:
            same = fns[f].targs.len() == targs.len()
            loop k in [0..targs.len()):
                if not same: break
                if not type_eq(fns[f].targs[k], targs[k]):
                    same = false
                    break
            if same:
                ensure_ret(f, use_pos)
                return f
    f = new_inst(FK_NORMAL, int(nodes[decl].mod), sanitize(name_of(int(nodes[decl].name))))
    fns[f].decl = i32(decl)
    fns[f].use_pos = use_pos
    if cx >= 0: fns[f].made_in = ctxs[cx].inst
    zt: int[]
    loop t in targs:
        z = zonk(t)
        if has_var(prune(z)):
            fname = name_of(int(nodes[decl].name))
            pz = prune(z)
            # (an empty [] or {} argument: nothing says what it holds)
            if types[pz].kind == .array: fatal(use_pos, "cannot tell what the array given to '{fname}' holds (an empty `[]` says nothing): write the type where the result goes, {jd(use_pos, "`scores: int[] = {fname}(...)`", "`let scores:array<int64> = {fname}(...)`")}, or pass a variable of a known type")
            if is_map_type(pz): fatal(use_pos, "cannot tell what the map given to '{fname}' holds (an empty {jd(use_pos, "`\{}`", "`[]`")} says nothing): write the type where the result goes, {jd(use_pos, "`m: \{str: int} = {fname}(...)`", "`let m:dict<string int64> = {fname}(...)`")}, or pass a variable of a known type")
            if starts_with(fname, "__fmt"): fatal(use_pos, "cannot tell what kind of value this is yet (an empty `[]` says nothing of what it will hold): write its type where it is made, {jd(use_pos, "`xs: int[] = []`", "`let xs:array<int64> = []`")}, or put something in it first")
            fatal(use_pos, "cannot infer the type of an argument to '{fname}'; write the type where the result goes ({jd(use_pos, "`x: T = {fname}(...)`", "`let x:T = {fname}(...)`")}) or give the argument a type")
        # (a generic function that calls itself with bigger type arguments would expand without end)
        zt.push(z)
    fns[f].targs = zt
    # (made while checking another generic instance: one more link of a chain of them, which a
    # function calling itself with ever bigger types makes without end)
    if cx >= 0 and int(ctxs[cx].inst) > 0 and fns[int(ctxs[cx].inst)].targs.len() > 0:
        fns[f].gdepth = fns[int(ctxs[cx].inst)].gdepth + 1
        if fns[f].gdepth > 500: fatal(use_pos, "the generic function '{name_of(int(nodes[decl].name))}' expands without end: generic functions call each other with ever new types (more than 500 deep)")
    loop i in [0..nkids(decl)): fns[f].ptypes.push(subst(sig.params[i], zt))
    ensure_body(decl)
    if sig.ret != 0: fns[f].ret = i32(subst(int(sig.ret), zt))
    else if nodes[decl].b != 0 and syntactic_void(int(nodes[decl].b)): fns[f].ret = i32(T_VOID)
    if refine_active and sig.generic: ref_validate_signature(fns[f].ptypes, int(fns[f].ret), int(sig.mutmask), use_pos)
    if sig.generic: fns[f].body = i32(clone(int(nodes[decl].b)))
    else: fns[f].body = nodes[decl].b
    if has_flag(decl, NF_EXTERN) and fns[f].ret == 0: fns[f].ret = i32(T_VOID)
    # attributes
    if nodes[decl].c != 0:
        ab = int(nodes[decl].c)
        loop i in [0..nkids(ab)):
            at = kid(ab, i)
            an = name_of(int(nodes[at].name))
            if an == "cabi": fns[f].cabi = true
            else if an == "parallel": fns[f].parallel = true
            else if an == "deterministic": fns[f].deterministic = true
            else if an == "noinline": fns[f].noinline = true
            else if an == "plain":
                # (its type arguments are copied as bytes, e.g. to the GPU)
                loop z in zt:
                    p = plain_problem(z)
                    if p != "":
                        held = ""
                        if p != type_str(z): held = " (it holds a {p})"
                        fatal(use_pos, "'{name_of(int(nodes[decl].name))}' takes plain data (numbers, bools, vectors and structs of them), not {dt(z)}{held}")
            else if an == "lib":
                la = int(nodes[at].a)
                # (or a constant naming it: const SQLITE = "libsqlite3.so.0", then @lib(SQLITE))
                if la != 0 and nodes[la].kind == .ident:
                    cs = lookup(int(nodes[la].name))
                    if cs != 0:
                        ci = binding_const_init(syms[cs].kind, int(syms[cs].ref), nodes[la].pos)
                        if ci != 0 and nodes[ci].kind == .str_lit: la = ci
                if la == 0 or nodes[la].kind != .str_lit: fatal(nodes[at].pos, "@lib needs a library name, e.g. @lib(\"libGL.so.1\") or a constant holding one")
                fns[f].clib = name_of(int(nodes[la].sval))
            else if an == "symbol":
                if nodes[at].a == 0 or nodes[int(nodes[at].a)].kind != .str_lit: fatal(nodes[at].pos, "@symbol needs the C name, e.g. @symbol(\"glClear\")")
                fns[f].csym = name_of(int(nodes[int(nodes[at].a)].sval))
            else if an == "variadic":
                if not has_flag(decl, NF_EXTERN) or nodes[at].a == 0 or nodes[int(nodes[at].a)].kind != .int_lit or nodes[int(nodes[at].a)].ival < 0 or nodes[int(nodes[at].a)].ival > fns[f].ptypes.len():
                    fatal(nodes[at].pos, "@variadic needs the number of the C function's fixed parameters, e.g. @variadic(1) for printf (an extern's)")
                fns[f].cvariadic = i32(nodes[int(nodes[at].a)].ival + 1)
            else if an == "export":
                fns[f].cabi = true
                if nodes[at].a != 0: fns[f].export_name = name_of(int(nodes[int(nodes[at].a)].sval))
                else: fns[f].export_name = name_of(int(nodes[decl].name))
            else if an != "no_web":
                why = ""
                if an == "inline" or an == "always_inline" or an == "forceinline": why = " (small functions are put inline automatically; @noinline keeps one out)"
                fatal(nodes[at].pos, "unknown attribute @{an}{why}: there are @noinline, @parallel, @deterministic, @plain, @cabi, @export, @no_web(\"why\"), and for externs @lib, @symbol, @variadic")
    if has_flag(decl, NF_EXTERN) or fns[f].cabi:
        loop t in fns[f].ptypes: check_c_boxes(t, nodes[decl].pos)
        if fns[f].ret != 0: check_c_boxes(int(fns[f].ret), nodes[decl].pos)
    decl_infos[di].insts.push(f)
    if zt.len() > 0: fn_instances[FnInstanceKey(decl, zt)] = f
    ensure_ret(f, use_pos)
    f

# Recursive value fields use private managed boxes, so their containing layout
# cannot be passed to C as an ordinary struct (including through a typed pointer).
check_c_boxes = (t0: int, pos: int):
    t = prune(t0)
    if types[t].kind == .ptr: t = prune(int(types[t].elem))
    pending = [t]
    seen: {int: bool} = {}
    loop pending.len() > 0:
        current = prune(pending.pop())
        if seen.has(current): continue
        seen[current] = true
        if current == T_MATH_INT: fatal(pos, "mathematical int cannot cross the C ABI; use an explicit fixed-width integer")
        k = types[current].kind
        if k == .opt or k == .fixed: pending.push(int(types[current].elem))
        else if k == .tuple:
            loop i in [0..int(types[current].nargs)): pending.push(targ(current, i))
        else if k == .struct_ or k == .enum_:
            si = int(types[current].st)
            check_struct_fields(si)
            decide_boxes(si)
            fs: int[]
            loop i in [0..int(structs[si].nfields)): fs.push(int(structs[si].fields) + i)
            loop v in [0..int(structs[si].nvariants)):
                vi = int(structs[si].variants) + v
                loop i in [0..int(variants[vi].nfields)): fs.push(int(variants[vi].fields) + i)
            loop f in fs:
                if fields[f].boxed:
                    fatal(pos, "recursive value field '{name_of(int(fields[f].name))}' in {dt(current)} uses managed storage and cannot cross the C ABI; use an explicit pointer-based C representation")
                pending.push(int(fields[f].type))

ensure_ret = (f: int, use_pos: int):
    if fns[f].ret != 0: return
    if fns[f].decl != 0: ensure_body(int(fns[f].decl))
    # (a Dewy function whose value is its last expression, `fact = (n:int64) => if n <=? 1 1
    # else n * fact(n - 1)`: its result is that of a branch that does not call it)
    if fns[f].state == 1 and fns[f].decl != 0 and dewy_at(nodes[int(fns[f].decl)].pos):
        c = ctx_for_inst(f)
        # (or one further down: a function it calls, calling it back)
        if c < 0: c = ctx_in_progress(f)
        if c >= 0 and ctxs[c].infer_ret:
            # (or the type an earlier `return` gave it)
            g = prune(int(ctxs[c].ret))
            if tkind(g) == .var:
                g = recursive_base_type(int(fns[f].body), int(nodes[int(fns[f].decl)].name))
                if g != 0: unify(int(ctxs[c].ret), g)
            if g != 0:
                fns[f].ret = i32(g)
                return
    if fns[f].state == 1 and fns[f].decl != 0 and not has_value_return(int(nodes[int(fns[f].decl)].b)):
        fns[f].ret = i32(T_VOID)
        fns[f].aux_void = true
        return
    if fns[f].state == 1: fatal(use_pos, "recursive function '{name_of(int(nodes[int(fns[f].decl)].name))}' needs an explicit return type (add {jd(use_pos, "`-> Type`", "`:>Type`")})")
    check_fn_body(f)

new_local = (name: int, t: int, pos: int) -> int:
    inst = int(ctxs[cx].inst)
    locals.push(Local(name = i32(name), type = i32(t), owner = i32(inst), pos = pos, dloops = i32(loop_serials.len())))
    l = locals.len() - 1
    fns[inst].locals.push(l)
    if name != 0 and name_of(name) != "_": push_scope_sym(name, new_sym(name, .local, l, 0))
    l

# the context of function inst anywhere on the stack of bodies being checked, or -1
ctx_in_progress = (inst: int) -> int:
    c = ctxs.len() - 1
    loop c >= 0:
        if int(ctxs[c].inst) == inst: return c
        c -= 1
    -1

ctx_for_inst = (inst: int) -> int:
    c = cx
    loop c >= 0:
        if int(ctxs[c].inst) == inst: return c
        c = int(ctxs[c].parent)
    -1

# Explicit $capture parameters share only names marked with @. Unlisted Dewy
# captures own values; implementation-language closures keep lexical sharing.
value_capture = (inst: int, name: int) -> bool:
    d = int(fns[inst].decl)
    if d == 0 or not files[pos_file(nodes[d].pos)].is_dewy: return false
    loop cap in lambda_captures(d):
        if nodes[cap].name == i32(name): return not has_flag(cap, NF_MUT)
    true

capture_in = (c: int, l: int) -> int:
    inst = int(ctxs[c].inst)
    if int(locals[l].owner) == inst or ctxs[c].parent < 0: return l
    outer = capture_in(int(ctxs[c].parent), l)
    loop cap in fns[inst].caps:
        if int(cap.outer) == outer: return int(cap.inner)
    flags = LF_CAPTURE
    if value_capture(inst, int(locals[l].name)):
        flags |= LF_VALUECAP | LF_DECL
        flags |= int(locals[outer].flags) & LF_CONST
        locals[outer].flags = locals[outer].flags | i32(LF_CAPTURED)
    else if ownership_decls.len() != 0 and ownership_fact_type(int(locals[outer].type)):
        flags |= LF_OWNERBORROW
        locals[outer].flags |= i32(LF_ADDR | LF_CAPTURED)
    else:
        r = outer
        loop int(locals[r].flags) & LF_CAPTURE != 0 and int(locals[r].flags) & LF_VALUECAP == 0: r = int(locals[r].outer)
        d = int(fns[inst].decl)
        if d != 0 and files[pos_file(nodes[d].pos)].is_dewy:
            check_shareable(r, nodes[d].pos)
            locals[r].flags = locals[r].flags | i32(LF_SHARED)
        capture_root(r)
    locals.push(Local(name = locals[l].name, type = locals[l].type, owner = i32(inst), flags = i32(flags), pos = locals[l].pos, outer = i32(outer)))
    inner = locals.len() - 1
    fns[inst].caps.push(Capture(i32(outer), i32(inner)))
    fns[inst].locals.push(inner)
    inner

capture_local = (l: int) -> int: capture_in(cx, l)

# Implementation-language closures capture variables by reference. A variable never modified
# once captured behaves the same when copied, so only the others need LF_SHARED. A modification that
# comes before the capture in the source still counts when a loop around both repeats it.
loop_serials: int[]     # the loops being checked (innermost last)
loop_serial_next = 0

enter_loop = ():
    loop_serial_next += 1
    loop_serials.push(loop_serial_next)

capture_root = (l: int):
    f = int(locals[l].flags) | LF_CAPTURED
    w = int(locals[l].wloop)
    d = int(locals[l].dloops)
    if not files[pos_file(locals[l].pos)].is_dewy and w != 0 and loop_serials.len() > d and loop_serials[d] == w: f |= LF_SHARED
    locals[l].flags = i32(f)
    if f & LF_SHARED != 0: check_shareable(l, locals[l].pos)

# root variable r is modified (inside a closure if via_closure)
note_write = (r: int, via_closure: bool, pos: int):
    if files[pos_file(locals[r].pos)].is_dewy: return
    f = int(locals[r].flags)
    if via_closure or f & LF_CAPTURED != 0:
        locals[r].flags = i32(f | LF_SHARED)
        check_shareable(r, pos)
    else:
        d = int(locals[r].dloops)
        if loop_serials.len() > d: locals[r].wloop = i32(loop_serials[d])

check_shareable = (r: int, pos: int):
    if int(locals[r].flags) & LF_DECL != 0: return
    nm = name_of(int(locals[r].name))
    # (loop mut g in gems: steps.then(0.1, (): g.scale = 0.0): the element, changed later)
    if int(locals[r].flags) & LF_ALIAS != 0: fatal(pos, "'{nm}' stands for an element only while the loop is there, and the function changing it runs later: change the element by its position, {jd(pos, "`loop i in 0.. and {nm} in xs:` and then `(): xs[i]...`", "`loop i in 0.. and {nm} in xs \{ ... }` and then `() => xs[i]...`")} in the function")
    fatal(pos, "'{nm}' is captured by a closure and modified: only variables declared with `=` can be shared like that (copy it first: `let v = {nm}`)")

module_ctx: int[]
module_frames: FnCtx[]

# Module state outlives a check, but temporary function contexts are a stack.
# Keep inactive module frames outside that stack so loading another module
# during an expression cannot interfere with its caller's push/pop lifetime.
enter_module_context = (m: int) -> bool:
    if module_ctx[m] >= 0: return false
    module_ctx[m] = ctxs.len()
    ctxs.push(module_frames[m])
    true

leave_module_context = (m: int, entered: bool):
    if not entered: return
    module_frames[m] = ctxs.pop()
    module_ctx[m] = -1

setup_module_contexts = (prelude_init: int):
    first = module_ctx.len()
    loop mi in [first..modules.len()):
        inst = prelude_init
        if not modules[mi].is_prelude:
            inst = new_inst(FK_INIT, mi, "init_{sanitize(name_of(int(modules[mi].name)))}")
            b = mk(.block, mkpos(int(modules[mi].file), 0))
            set_list(b, modules[mi].inits)
            fns[inst].body = i32(b)
        modules[mi].init_fn = i32(inst)
        module_frames.push(FnCtx(i32(inst), -1, i32(T_VOID), false, 0, i32(mi), 0))
        module_ctx.push(-1)

# global g is changed here: in a function, that is something a call may do
note_global_write = (g: int):
    if globals[g].fn_written or cx < 0: return
    if fns[int(ctxs[cx].inst)].kind != i32(FK_INIT): globals[g].fn_written = true

# the global a narrowed name's place (g.f narrowed by `is`) belongs to, or -1
alias_global = (l: int) -> int:
    if int(locals[l].flags) & LF_ALIAS == 0 or locals[l].alias == 0: return -1
    n = int(locals[l].alias)
    loop nodes[n].kind == .field or nodes[n].kind == .index or nodes[n].kind == .narrow or nodes[n].kind == .unwrap or nodes[n].kind == .conv: n = int(nodes[n].a)
    if nodes[n].kind == .ident and nodes[n].aux == i32(int(SK.global)): return int(nodes[n].sym)
    -1

# (in_flow: its declaration reached among the top-level statements, after what they narrowed,
# `if r == none: panic(...)` say, which it then sees; elsewhere it is checked on its own)
ensure_global = (g: int, use_pos: int, in_flow: bool = false):
    if globals[g].state == 2: return
    if globals[g].state == 1:
        gn = name_of(int(globals[g].name))
        fatal(use_pos, "'{gn}' is used in its own first value, before it has one: give it one first ({jd(use_pos, "`{gn} = 0`", "`let {gn} = 0`")} on a line above), then change it")
    globals[g].state = 1
    saved = cx
    m = int(globals[g].mod)
    entered = enter_module_context(m)
    flow = in_flow and cx == module_ctx[m]
    cx = module_ctx[m]
    saved_floor = ctxs[cx].floor
    if not flow: ctxs[cx].floor = i32(sc_names.len())
    d = int(globals[g].decl)
    if globals[g].is_const:
        t = 0
        if nodes[d].a != 0: t = resolve_type(int(nodes[d].a))
        cl = clone(int(nodes[d].b))
        et = check_expr(cl, t)
        cl = last_checked
        if t != 0: cl = coerce(cl, t)
        else if has_flag(cl, NF_LITERAL):
            t = lit_default(cl)
        else: t = et
        globals[g].type = i32(zonk(t))
        globals[g].init = nodes[d].b      # unchecked original: each use checks a fresh copy
    else if nodes[d].nlist > 0:
        if not has_flag(d, NF_CHECKED):
            t = check_binding_input(d)
            unpacked = unpack_binding(int(nodes[d].b), t, kids(d), nodes[d].pos)
            t = unpacked.0
            set_list(d, unpacked.1)
            nodes[d].b = i32(last_checked)
            if types[t].kind != .tuple or int(types[t].nargs) != nkids(d): fatal(nodes[d].pos, "expected a tuple with {nkids(d)} elements (or an array), found {dt(t)}")
            loop k in [0..nkids(d)):
                id = kid(d, k)
                if nodes[id].kind == .hole: continue
                gg = int(nodes[id].sym)
                globals[gg].type = i32(zonk(targ(t, k)))
                globals[gg].state = 2
            add_flag(d, NF_CHECKED)
            nodes[d].type = i32(t)
    else:
        t = 0
        if nodes[d].a != 0: t = resolve_type(int(nodes[d].a))
        if refine_active and types[prune(t)].kind == .refined and nodes[d].b == 0: nodes[d].b = i32(struct_default(t, nodes[d].pos))
        # (x: T, a struct with default field values: it starts with them)
        if nodes[d].b == 0 and t != 0: nodes[d].b = i32(struct_default(t, nodes[d].pos))
        if nodes[d].b != 0:
            et = check_expr(int(nodes[d].b), t)
            nodes[d].b = i32(last_checked)
            if quat_nodes.has(int(nodes[d].b)): quat_globals[g] = true
            if t != 0: nodes[d].b = i32(coerce(int(nodes[d].b), t))
            else:
                t = et
                if has_flag(int(nodes[d].b), NF_LITERAL):
                    t = lit_default(int(nodes[d].b))
                    nodes[d].b = i32(coerce(int(nodes[d].b), t))
        t = zonk(t)
        if t == 0: fatal(nodes[d].pos, "global needs a type or a value")
        if has_var(prune(t)):
            # (enemies = [] at the top level: its elements' type comes from a function that pushes
            # one, as a local's does; settled once everything is checked)
            vk = nodes[int(nodes[d].b)].kind
            if nodes[d].a == 0 and vk == .array and nkids(int(nodes[d].b)) == 0 and tkind(t) == .array: open_globals.push(g)
            else: fatal(nodes[d].pos, "cannot infer the type of '{name_of(int(globals[g].name))}'; add a type annotation{empty_hint(name_of(int(globals[g].name)), t)}")
        if tkind(t) == .void_: fatal(nodes[d].pos, "cannot assign a value of type void")
        if tkind(t) == .null_: fatal(nodes[d].pos, "`null` is for C's pointers; a value that may be missing is `none`, with its type written: {jd(nodes[d].pos, "`{name_of(int(globals[g].name))}: Enemy? = none`", "`let {name_of(int(globals[g].name))}:Enemy? = none`")}")
        if tkind(t) == .typeval or tkind(t) == .module: fatal(nodes[d].pos, "'{name_of(int(globals[g].name))}' cannot hold a type or module (a value of a type is made by calling it: `T()`)")
        globals[g].type = i32(t)
        # Exact quantity constants have no runtime storage or initialization.
        if has_flag(d, NF_RDONLY) and is_quantity(t) and quantity_constant_scale(int(nodes[d].b)) >= 0:
            globals[g].is_const = true
            globals[g].init = nodes[d].b
            nodes[d].kind = .const_
        add_flag(d, NF_CHECKED)
    globals[g].state = 2
    ctxs[cx].floor = saved_floor
    leave_module_context(m, entered)
    cx = saved

# xs.sorted(), s.trim() as a statement: a library function that gives a new value of its first
# argument's type, changing none of its arguments, called for nothing (it changes nothing)
unused_result = (x: int, pos: int):
    if discarding: return
    if nodes[x].kind != .call or nodes[x].a != 0 or nodes[x].sym <= 0 or nkids(x) == 0: return
    f = int(nodes[x].sym)
    d = int(fns[f].decl)
    # (the library's: a program's own may well do more, as writing files, and give back something)
    if d == 0 or not modules[int(nodes[d].mod)].is_prelude: return
    if fns[f].ptypes.len() == 0 or nkids(d) != fns[f].ptypes.len() or has_flag(d, NF_EXTERN): return
    r = prune(int(fns[f].ret))
    if tkind(r) == .void_ or r == T_NEVER or not type_eq(r, prune(fns[f].ptypes[0])): return
    # (values: a number or a flag given back is as often a handle or how it went)
    rk = tkind(r)
    if rk != .str_ and rk != .array and rk != .vec and rk != .struct_ and rk != .fixed: return
    if starts_with(name_of(int(nodes[d].name)), "__"): return
    loop i in [0..nkids(d)):
        if has_flag(kid(d, i), NF_MUT): return
    # (at the interactive prompt the value is shown: that is what it is for)
    if files[pos_file(pos)].path == "<input>": return
    fname = name_of(int(nodes[d].name))
    a0 = kid(x, 0)
    how = ""
    if nodes[a0].kind == .ident:
        v = name_of(int(nodes[a0].name))
        how = " (`{v} = {v}.{fname}(...)` keeps it)"
    warn(pos, "{fname} gives a new {dt(r)} and leaves its argument as it was: this does nothing{how}")

# `x == 6`, `speed + 1`, `true` as a statement: a value made and dropped, which changes nothing
# (written for `=`, `+=` or `return true`)
discarding = false        # (checking `_ = value`: dropped on purpose, no warning)

unused_value = (raw: Node, t: int):
    if discarding: return
    if pos_in_lib(raw.pos) or files[pos_file(raw.pos)].path == "<input>": return
    if tkind(prune(t)) == .void_ or t == T_NEVER: return
    k = raw.kind
    name = ""
    if (k == .binary or k == .and_ or k == .or_) and nodes[int(raw.a)].kind == .ident: name = name_of(int(nodes[int(raw.a)].name))
    if k == .binary:
        op = raw.op as Tok
        if op == .eq:
            eq = jd(raw.pos, "`==`", "`=?`")
            if len(name) > 0: warn(raw.pos, "{eq} compares, and the answer is not used: to change '{name}', write `{name} = ...`")
            else: warn(raw.pos, "{eq} compares, and the answer is not used (`=` changes a value)")
            return
        if op == .ne or op == .lt or op == .gt or op == .le or op == .ge:
            warn(raw.pos, "this comparison's answer is not used ({jd(raw.pos, "`if ...:`", "`if ... \{ }`")} acts on it)")
            return
        if op == .plus or op == .minus or op == .star or op == .slash or op == .percent:
            if len(name) > 0: warn(raw.pos, "this value is not used: to change '{name}', write `{name} = ...` (or `{name} {tok_text(op)}= ...`)")
            else: warn(raw.pos, "this value is not used: it changes nothing")
            return
        return
    if k == .and_ or k == .or_ or k == .not_:
        warn(raw.pos, "this condition's answer is not used ({jd(raw.pos, "`if ...:`", "`if ... \{ }`")} acts on it)")
        return
    if k == .bool_lit or k == .int_lit or k == .float_lit or k == .ident or k == .none_lit:
        if tkind(prune(int(ctxs[cx].ret))) != .void_:
            warn(raw.pos, "this value is not used: `return` gives it back from the function")
        else:
            warn(raw.pos, "this value is not used: it changes nothing")

# ---------------- statements ----------------
stmt_terminates = (s: int) -> bool:
    if s == 0: return false
    k = nodes[s].kind
    if k == .return_ or k == .break_ or k == .continue_: return true
    if k == .block: return has_flag(s, NF_FLOW_RETURNS) or (nkids(s) > 0 and stmt_terminates(kid(s, nkids(s) - 1)))
    if k == .if_: return nodes[s].c != 0 and stmt_terminates(int(nodes[s].b)) and stmt_terminates(int(nodes[s].c))
    if k == .exprstmt:
        e = int(nodes[s].a)
        if int(nodes[e].type) == T_NEVER: return true
        # (the library's exit(code): the program ends there)
        if nodes[e].kind == .call and nodes[e].sym > 0 and int(nodes[e].sym) < fns.len():
            d = int(fns[int(nodes[e].sym)].decl)
            if d != 0 and name_of(int(nodes[d].name)) == "exit" and pos_in_lib(nodes[d].pos): return true
        if nodes[e].kind == .match_:
            all = true
            wild = false
            loop i in [0..nkids(e)):
                arm = kid(e, i)
                if not stmt_terminates(int(nodes[arm].b)): all = false
                loop j in [0..nkids(arm)):
                    if nodes[kid(arm, j)].kind == .pwild: wild = true
            return all and (wild or nodes[e].aux2 != 0)
        if nodes[e].kind == .if_: return nodes[e].c != 0 and stmt_terminates(int(nodes[e].b)) and stmt_terminates(int(nodes[e].c))
        return false
    if k == .while_: return nodes[int(nodes[s].a)].kind == .bool_lit and nodes[int(nodes[s].a)].ival != 0 and not has_break(int(nodes[s].b))
    false

has_break = (n: int, depth: int = 0) -> bool:
    if n == 0: return false
    k = nodes[n].kind
    if k == .break_: return nodes[n].ival == depth
    if k == .lambda: return false
    if k == .while_ or k == .for_: return has_break(int(nodes[n].a), depth) or has_break(int(nodes[n].b), depth + 1)
    if has_break(int(nodes[n].a), depth) or has_break(int(nodes[n].b), depth): return true
    if has_break(int(nodes[n].c), depth): return true
    loop i in [0..nkids(n)):
        if has_break(kid(n, i), depth): return true
    false

value_capable = (s: int) -> bool:
    k = nodes[s].kind
    if k == .exprstmt: return true
    if (k == .if_ or k == .iflet) and nodes[s].c != 0: return true
    false

expand_when = (out: mut int[], s: int):
    if nodes[s].kind != .when_:
        out.push(s)
        return
    blk = int(nodes[s].c)
    if const_eval_bool(int(nodes[s].a)): blk = int(nodes[s].b)
    if blk == 0: return
    loop i in [0..nkids(blk)): expand_when(out, kid(blk, i))

check_block = (b: int, expected: int, want_value: bool) -> int:
    has_when = false
    loop i in [0..nkids(b)):
        if nodes[kid(b, i)].kind == .when_: has_when = true
    if has_when:
        nl: int[]
        loop i in [0..nkids(b)): expand_when(nl, kid(b, i))
        set_list(b, nl)
    mark = scope_mark()
    result = T_VOID
    nodes[b].aux = 0
    n = nkids(b)
    loop i in [0..n):
        s = kid(b, i)
        if i == n - 1 and want_value and value_capable(s):
            if nodes[s].kind == .if_ or nodes[s].kind == .iflet:
                es = mk(.exprstmt, nodes[s].pos)
                nodes[es].a = i32(s)
                clear_flag(s, NF_STMT)
                set_kid(b, i, es)
                s = es
            e = int(nodes[s].a)
            if nodes[e].kind == .match_: clear_flag(e, NF_STMT)
            result = check_expr(e, expected)
            nodes[s].a = i32(last_checked)
            if tkind(result) != .void_: nodes[b].aux = 1
            if result == T_NEVER: nodes[b].aux = 0
            add_flag(s, NF_CHECKED)
            continue
        check_stmt(s)
    if want_value and nodes[b].aux == 0 and n > 0 and stmt_terminates(kid(b, n - 1)): result = T_NEVER
    if want_value and has_flag(b, NF_FLOW_RETURNS): result = T_NEVER
    # (an array built by pushing has a solved inference variable inside its type: the plain type
    # matches overloads exactly)
    if want_value and result != 0 and int(types[result].flags) & TF_HAS_VAR != 0: result = zonk(result)
    nodes[b].type = i32(result)
    scope_reset(mark)
    result

# the value expression of a value block
block_value = (b: int) -> int: int(nodes[kid(b, nkids(b) - 1)].a)

# A union with a void member (`:>void | E`): a bare return or the end of the body gives it.
union_has_void = (t: int) -> bool:
    if not is_union(t): return false
    loop m in union_members(t):
        if tkind(m) == .void_: return true
    false
set_block_value = (b: int, e: int): nodes[kid(b, nkids(b) - 1)].a = i32(e)

# loop p in ps (ps a soa array): loop i in [0..len(ps)): p = ps[i]
soa_loop = (s: int):
    it = int(nodes[s].a)
    if nodes[it].kind == .range: return
    t = prune(check_expr(it, 0))
    it = last_checked
    nodes[s].a = i32(it)
    if not is_soa(t): return
    pos = nodes[s].pos
    ik = nodes[it].kind
    if ik != .ident and ik != .field: fatal(pos, "a loop over a soa array needs the array in a variable")
    nv = nkids(s)
    if nv == 2 and nodes[s].ival != 1: fatal(pos, "`loop a, b in` unpacks pairs; to count the elements write `loop i in 0.. and p in ps`")
    pv = kid(s, nv - 1)
    ixn = "__sl{bc_count}"
    bc_count += 1
    if nv == 2: ixn = name_of(int(nodes[kid(s, 0)].name))
    r = mk(.range, pos)
    nodes[r].a = i32(bc_int(0, pos))
    nodes[r].b = i32(bc_call("len", [clone(it)], pos))
    ix = mk(.index, pos)
    nodes[ix].a = i32(clone(it))
    nodes[ix].b = i32(bc_ident(ixn, pos))
    body = int(nodes[s].b)
    # p stands for ps[i]: p.x is ps.x[i]; only a use of p as a whole reads every field
    el = bc_let(name_of(int(nodes[pv].name)), ix, pos)
    add_flag(el, NF_SOA)
    if has_flag(s, NF_MUT): add_flag(el, NF_MUT)
    clear_flag(s, NF_MUT)
    stmts = [el]
    loop x in kids(body): stmts.push(x)
    set_list(body, stmts)
    set_list(s, [bc_ident(ixn, pos)])
    nodes[s].a = i32(r)

# the element alias of a loop over a soa array (see soa_loop)
soa_alias = (s: int):
    tmpl = clone(int(nodes[s].b))
    check_expr(int(nodes[s].b), 0)
    v = last_checked
    l = new_local(int(nodes[s].name), ntype(v), nodes[s].pos)
    f = LF_ALIAS | LF_SOAELEM
    if has_flag(s, NF_MUT): f |= LF_SOAMUT
    locals[l].flags = i32(f)
    locals[l].alias = i32(v)
    locals[l].soa = i32(tmpl)
    nodes[s].kind = .block
    nodes[s].nlist = 0

# the soa element alias local a name stands for here, or 0
soa_alias_of = (e: int) -> int:
    if nodes[e].kind != .ident: return 0
    s = lookup(int(nodes[e].name))
    if s == 0 or syms[s].kind != .local: return 0
    l = int(syms[s].ref)
    if int(locals[l].flags) & LF_SOAELEM == 0: return 0
    l

# p.x for a soa element alias p: ps.x[i]
soa_alias_field = (n: int, l: int) -> int:
    t = int(locals[l].soa)
    f = mk(.field, nodes[n].pos)
    nodes[f].a = i32(clone(int(nodes[t].a)))
    nodes[f].name = nodes[n].name
    ix = mk(.index, nodes[n].pos)
    nodes[ix].a = i32(f)
    nodes[ix].b = i32(clone(int(nodes[t].b)))
    if int(locals[l].flags) & LF_SOAMUT == 0:
        add_flag(ix, NF_RDONLY)
        nodes[ix].name = locals[l].name
    ix

# loop a, b in xs (an array of pairs): loop t in xs: let a, b = t
unpack_loop = (s: int):
    dewy = files[pos_file(nodes[s].pos)].is_dewy
    if nkids(s) < 2 or (not dewy and nkids(s) != 2) or nodes[s].ival == 1: return
    it = int(nodes[s].a)
    if nodes[it].kind == .range: fatal(nodes[s].pos, "`loop a, b in` unpacks pairs; a range has single numbers")
    t = prune(check_expr(it, 0))
    nodes[s].a = i32(last_checked)
    if types[t].kind != .array and types[t].kind != .fixed: return
    pos = nodes[s].pos
    et = prune(int(types[t].elem))
    if not dewy and (types[et].kind != .tuple or int(types[et].nargs) != 2): fatal(pos, "`loop a, b in xs` unpacks pairs, but the elements are {dt(et)}; to count them write `loop i in 0.. and x in xs`")
    if has_flag(s, NF_MUT): fatal(pos, "`loop mut` cannot unpack pairs")
    tn = "__lt{bc_count}"
    bc_count += 1
    d = mk(.vardecl, pos)
    set_list(d, kids(s))
    nodes[d].b = i32(bc_ident(tn, pos))
    body = int(nodes[s].b)
    stmts = [d]
    loop x in kids(body): stmts.push(x)
    set_list(body, stmts)
    set_list(s, [bc_ident(tn, pos)])

# `loop mut k, v in m` over a map: { __map_tidy(m); the loop } (nothing in it gone, so that the
# loop's indexes are its entries'); true when s was made that block, and checked
map_tidy_first = (s: int) -> bool:
    if not has_flag(s, NF_MUT) or map_tidied.has(s): return false
    it = int(nodes[s].a)
    if nodes[it].kind == .range: return false
    t = prune(check_expr(it, 0))
    nodes[s].a = i32(last_checked)
    if not is_map_type(t): return false
    pos = nodes[s].pos
    l = nodes.len()
    nodes.push(nodes[s])
    map_tidied[l] = true
    mc = copy_place(int(nodes[s].a))
    add_flag(mc, NF_MUT)
    tidy = synth_call("__map_tidy", [mc], pos)
    b = mk(.block, pos)
    set_list(b, [tidy, l])
    nodes[s] = nodes[b]
    check_stmt(s)
    true

# (loops made by map_tidy_first: the map is tidied already)
map_tidied: {int: bool} = {}

# A cursor loop is ordinary scoped control flow over a retained input and a
# mutable boundary cursor. Advance before the body so continue needs no fixup.
dewy_cursor_loop = (s: int) -> bool:
    it = int(nodes[s].a)
    if not is_dewy_cursor_iter(ntype(it)): return false
    pos = nodes[s].pos
    nv = nkids(s)
    if has_flag(s, NF_MUT) or nv > 1 and nodes[s].ival != 1: fatal(pos, "this iterator binds one value; use `i in 0.. and value in sequence` to count")
    tag = "__grapheme{bc_count}"
    bc_count += 1
    seq = tag + "s"
    index = tag + "i"
    if nv == 2: index = name_of(int(nodes[kid(s, 0)].name))
    name = int(nodes[kid(s, nv - 1)].name)
    add_flag(it, NF_CHECKED)
    setup = [bc_let(seq, it, pos), bc_let(index, bc_int(-1, pos), pos)]
    done = bc_call("__dewy_iter_done", [bc_ident(seq, pos), bc_ident(index, pos)], pos)
    value = bc_call("__dewy_iter_value", [bc_ident(seq, pos), bc_ident(index, pos)], pos)
    advance: int[]
    if is_dewy_range_type(ntype(it), "__DewyRangeIter"):
        # Keep a counted range's hot state in scalar locals. Passing a mutable
        # iterator record to a helper would load/store it on every iteration.
        loop field in ["cursor", "delta", "remaining", "done"]:
            setup.push(bc_let(tag + field, bc_field(bc_ident(seq, pos), field, pos), pos))
        done = bc_ident(tag + "done", pos)
        value = bc_ident(tag + "cursor", pos)
        advance.push(lx_assign(bc_ident(tag + "cursor", pos), .pluseq, bc_ident(tag + "delta", pos), pos))
    head = [lx_assign(bc_ident(index, pos), .pluseq, bc_int(1, pos), pos), lx_if(done, mk(.break_, pos), pos), lx_let(name, value, pos)]
    if is_dewy_range_type(ntype(it), "__DewyRangeIter"): head.remove(1)
    loop item in advance: head.push(item)
    loop item in kids(int(nodes[s].b)): head.push(item)
    if is_dewy_range_type(ntype(it), "__DewyRangeIter"):
        # An inclusive unsigned counter also represents all 2^64 values when
        # remaining is zero. Reuse the normal counted-loop backend and keep
        # the empty test outside its back edge.
        range = mk(.range, pos)
        nodes[range].a = i32(bc_call("u64", [bc_int(0, pos)], pos))
        nodes[range].b = i32(bc_bin(.minus, bc_ident(tag + "remaining", pos), bc_int(1, pos), pos))
        add_flag(range, NF_INCLUSIVE)
        loop_ = mk(.for_, pos)
        nodes[loop_].sval = nodes[s].sval
        nodes[loop_].a = i32(range)
        nodes[loop_].b = i32(lx_block(head, pos))
        set_list(loop_, [bc_ident(tag + "counter", pos)])
        setup.push(lx_if(bc_bin(.eq, done, lx_bool(false, pos), pos), loop_, pos))
        nodes[s] = nodes[lx_block(setup, pos)]
        check_stmt(s)
        return true
    w = mk(.while_, pos)
    nodes[w].sval = nodes[s].sval
    tr = mk(.bool_lit, pos)
    nodes[tr].ival = 1
    nodes[w].a = i32(tr)
    nodes[w].b = i32(lx_block(head, pos))
    setup.push(w)
    nodes[s] = nodes[lx_block(setup, pos)]
    check_stmt(s)
    true

# Indexed user containers use their existing len / [] operations. Retain the
# input value and length once, then reuse the ordinary counted-loop lowering.
dewy_sequence_loop = (s: int) -> bool:
    it = int(nodes[s].a)
    if nodes[it].kind == .range: return false
    t = prune(ntype(it))
    if types[t].kind != .struct_ or is_map_type(t) or is_map_entries_type(t) or is_soa(t) or is_dewy_cursor_iter(t): return false
    pos = nodes[s].pos
    if has_flag(s, NF_MUT): fatal(pos, "custom sequence iteration yields values; update the container through its indices")
    tag = "__sequence{bc_count}"
    bc_count += 1
    add_flag(it, NF_CHECKED)
    seq = bc_let(tag, it, pos)
    index = tag + "i"
    bindings = kids(s)
    counted = bindings.len() == 2 and nodes[s].ival == 1
    if counted: index = name_of(int(nodes[bindings[0]].name))
    read = lx_index(bc_ident(tag, pos), bc_ident(index, pos), pos)
    binding = mk(.vardecl, pos)
    nodes[binding].b = i32(read)
    if bindings.len() == 1 or counted:
        nodes[binding].name = nodes[bindings[bindings.len() - 1]].name
    else: set_list(binding, bindings)
    body = lx_block([binding] + kids(int(nodes[s].b)), pos)
    range = mk(.range, pos)
    nodes[range].a = i32(bc_int(0, pos))
    nodes[range].b = i32(bc_method(bc_ident(tag, pos), "len", [], pos))
    counted_loop = mk(.for_, pos)
    nodes[counted_loop].a = i32(range)
    nodes[counted_loop].b = i32(body)
    nodes[counted_loop].sval = nodes[s].sval
    set_list(counted_loop, [bc_ident(index, pos)])
    nodes[s] = nodes[lx_block([seq, counted_loop], pos)]
    check_stmt(s)
    true

# A nested loop binding first receives the ordinary iteration value, then uses
# the same destructuring declaration as local code. This also handles a map's
# value without changing its key/value iteration or snapshot behavior.
dewy_nested_loop_bindings = (s: int):
    if not files[pos_file(nodes[s].pos)].is_dewy: return
    declarations: int[]
    loop i in [0..nkids(s)):
        binding = kid(s, i)
        if nodes[binding].kind != .tuple and nodes[binding].a == 0: continue
        # Array/custom-sequence patterns keep their field names until unpacked.
        # A dictionary's key/value binders are separate iteration values.
        if nodes[binding].kind != .tuple:
            it = prune(ntype(int(nodes[s].a)))
            if not is_map_type(it) and not is_map_entries_type(it): continue
        if has_flag(s, NF_MUT): fatal(nodes[binding].pos, "nested loop bindings yield independent values, not mutable aliases")
        name = "$unpack_loop{bc_count}"
        bc_count += 1
        d = mk(.vardecl, nodes[binding].pos)
        if nodes[binding].kind == .tuple: set_list(d, kids(binding))
        else:
            nodes[d].name = nodes[binding].name
            nodes[d].a = nodes[binding].a
        nodes[d].b = i32(bc_ident(name, nodes[binding].pos))
        declarations.push(d)
        set_kid(s, i, bc_ident(name, nodes[binding].pos))
    if declarations.len() > 0:
        body = int(nodes[s].b)
        set_list(body, declarations + kids(body))

# (the value variables of loops over dictionaries: a change is made through the key)
map_loop_values: {int: bool} = {}

mutable_loop_syntax = (pos: int) -> str:
    if files[pos_file(pos)].is_dewy: return "loop @item"
    "loop mut"

# Suggestions are spelled in the language of the source they are about.
dewy_at = (pos: int) -> bool:
    f = pos_file(pos)
    pos > 0 and f < files.len() and files[f].is_dewy

jd = (pos: int, jo: str, dewy: str) -> str: if dewy_at(pos): dewy else: jo

# an operator as the source at pos spells it (Dewy's comparisons end in `?`)
op_text = (op: Tok, pos: int) -> str:
    if not dewy_at(pos): return tok_text(op)
    match op:
        lt: "<?"
        le: "<=?"
        gt: ">?"
        ge: ">=?"
        eq: "=?"
        ne: "not=?"
        _: tok_text(op)

check_for = (s: int):
    if dewy_at(nodes[s].pos) and reflect_loop(s): return
    if has_flag(s, NF_MUT) and files[pos_file(nodes[s].pos)].is_dewy:
        source_type = prune(check_expr(int(nodes[s].a), 0))
        nodes[s].a = i32(last_checked)
        if types[source_type].kind != .array and types[source_type].kind != .fixed:
            fatal(nodes[s].pos, "`loop @item in items` needs stored array elements; ordinary iteration yields values")
    soa_loop(s)
    unpack_loop(s)
    dewy_nested_loop_bindings(s)
    if dewy_cursor_loop(s): return
    if map_tidy_first(s): return
    if dewy_sequence_loop(s): return
    mark = scope_mark()
    enter_loop()
    it = int(nodes[s].a)
    is_mut = has_flag(s, NF_MUT)
    nv = nkids(s)
    n1 = int(nodes[kid(s, 0)].name)
    n2 = 0
    if nv > 1: n2 = int(nodes[kid(s, 1)].name)
    pos = nodes[s].pos
    if nodes[it].kind == .range:
        if nodes[it].a == 0: fatal(nodes[it].pos, "a loop range needs a start")
        t = check_expr(int(nodes[it].a), 0)
        nodes[it].a = i32(last_checked)
        la = has_flag(int(nodes[it].a), NF_LITERAL)
        lb = true
        if nodes[it].b != 0:
            check_expr(int(nodes[it].b), 0)
            nodes[it].b = i32(last_checked)
            lb = has_flag(int(nodes[it].b), NF_LITERAL)
            if la and not lb: t = int(nodes[int(nodes[it].b)].type)
        if has_flag(it, NF_STEP):
            check_expr(int(nodes[it].c), 0)
            nodes[it].c = i32(last_checked)
            if la and lb and not has_flag(int(nodes[it].c), NF_LITERAL): t = int(nodes[int(nodes[it].c)].type)
        if la and lb and (not has_flag(it, NF_STEP) or has_flag(int(nodes[it].c), NF_LITERAL)): t = lit_default(int(nodes[it].a))
        if tkind(t) == .str_: fatal(nodes[it].pos, "text is joined with `+` (or put in a string: \"\{a}\{b}\"); `..` makes a range of numbers")
        if not is_int(t) or nodes[int(nodes[it].a)].kind == .float_lit or nodes[int(nodes[it].b)].kind == .float_lit:
            if is_int(t): t = T_FLOAT
            fatal(nodes[it].pos, "a range counts in whole numbers, not {dt(t)} (for 0.0 to 1.0 in tenths, count to 10 and divide: {jd(nodes[it].pos, "`loop i in [0..10): x = f64(i) / 10.0`", "`loop i in [0..10] \{ let x = float64(i) / 10 }`")})")
        nodes[it].a = i32(coerce(int(nodes[it].a), t))
        if nodes[it].b != 0: nodes[it].b = i32(coerce(int(nodes[it].b), t))
        if has_flag(it, NF_STEP): nodes[it].c = i32(coerce(int(nodes[it].c), t))
        if nv != 1: fatal(pos, "a range loop has one loop variable")
        if is_mut: fatal(pos, "`{mutable_loop_syntax(pos)}` needs an array (a range's numbers are not stored anywhere)")
        l = new_local(n1, t, pos)
        nodes[s].sym = i32(l)
        nodes[s].aux = 0
    else:
        t = prune(check_expr(it, 0))
        it = last_checked
        nodes[s].a = i32(it)
        # (a map with entries removed has them still in place, marked gone: the loop goes over a
        # copy without them; a `loop mut` had the map itself made so, by map_tidy_first)
        if is_map_type(t) and not is_mut and not ownership_fact_type(t):
            add_flag(it, NF_CHECKED)
            lv = int(nodes[synth_call("__map_entries", [it], pos)].a)
            t = prune(check_expr(lv, 0))
            it = last_checked
            nodes[s].a = i32(it)
        if (is_map_type(t) or is_map_entries_type(t)) and nodes[s].ival == 1:
            # `i in 0.. and key in map` counts keys. The native two-binding
            # map loop otherwise means key/value, so iterate its key snapshot.
            add_flag(it, NF_CHECKED)
            t = prune(check_expr(bc_field(it, "__keys", pos), 0))
            it = last_checked
            nodes[s].a = i32(it)
        k = types[t].kind
        if k == .range:
            l = new_local(n1, T_INT, pos)
            nodes[s].sym = i32(l)
            nodes[s].aux = 4
        else if k == .array or k == .str_ or k == .fixed:
            et = T_U8
            if k == .array or k == .fixed: et = int(types[t].elem)
            idxname = 0
            if nv == 2: idxname = n1
            idx = new_local(idxname, T_INT, pos)
            snap = new_local(0, t, pos)
            elname = n1
            if nv == 2: elname = n2
            el = 0
            if is_mut:
                if k == .str_: fatal(pos, "strings are immutable; 'for mut' needs an array")
                cp_inner += 1                  # only the elements change, not the array's length
                check_place(it, true)
                cp_inner -= 1
                el = new_local(elname, et, pos)
                locals[el].flags = i32(int(locals[el].flags) | LF_ALIAS)
                ix = mk(.index, pos)
                # (it is checked; m[k] of a map was made the place in it by check_place)
                base = copy_place(it)
                nodes[ix].a = i32(base)
                nodes[ix].b = i32(mk_ident_local(idx, pos))
                nodes[ix].type = i32(et)
                add_flag(ix, NF_CHECKED)
                if k == .fixed: add_flag(ix, NF_INBOUNDS)
                locals[el].alias = i32(ix)
                nodes[s].aux = 2
            else:
                el = new_local(elname, et, pos)
                locals[el].flags = i32(int(locals[el].flags) | LF_BYREF)
                nodes[s].aux = 1
            nodes[s].sym = i32(el)
            nodes[s].c = i32(idx)
            nodes[s].d = i32(snap)
        else if is_map_type(t) or is_map_entries_type(t):
            si = int(types[t].st)
            check_struct_fields(si)
            kt = int(fields[int(structs[si].fields)].type)
            vt = int(fields[int(structs[si].fields) + 1].type)
            idx = new_local(0, T_INT, pos)
            snap = new_local(0, t, pos)
            kl = new_local(n1, telem(kt), pos)
            locals[kl].flags = i32(int(locals[kl].flags) | LF_BYREF)
            vl = 0
            if nv == 2:
                if is_mut:
                    check_place(it, true)
                    vl = new_local(n2, telem(vt), pos)
                    locals[vl].flags = i32(int(locals[vl].flags) | LF_ALIAS)
                    f = mk(.field, pos)
                    nodes[f].a = i32(clone(it))
                    nodes[f].name = i32(intern("vals"))
                    ix = mk(.index, pos)
                    nodes[ix].a = i32(f)
                    nodes[ix].b = i32(mk_ident_local(idx, pos))
                    check_expr(ix, 0)
                    locals[vl].alias = i32(last_checked)
                else:
                    vl = new_local(n2, telem(vt), pos)
                    locals[vl].flags = i32(int(locals[vl].flags) | LF_BYREF)
                    map_loop_values[vl] = true
            else if is_mut: fatal(pos, "'for mut' over a map needs key and value variables")
            nodes[s].aux = 3
            nodes[s].sym = i32(kl)
            nodes[s].c = i32(idx)
            nodes[s].d = i32(snap)
            nodes[s].aux2 = i32(vl)
        else: fatal(nodes[it].pos, "cannot iterate over a value of type {dt(t)}")
    check_loop_enter(s)
    check_block(int(nodes[s].b), 0, false)
    loop_serials.pop()
    check_loop_leave(s)
    scope_reset(mark)

const ASSIGN_OPS = 0

# Labels belong to active loops in one function-checking context. They cannot
# cross a function boundary, including a closure checked inside the loop.
loop_labels: (int, int, int)[]

check_loop_enter = (s: int):
    ctxs[cx].loop_depth += 1
    label = int(nodes[s].sval)
    if label == 0: return
    loop item in loop_labels:
        if item.0 == cx and item.1 == label: fatal(nodes[s].pos, "duplicate active loop label '${name_of(label)}'")
    loop_labels.push((cx, label, int(ctxs[cx].loop_depth)))

check_loop_leave = (s: int):
    if nodes[s].sval != 0: loop_labels.pop()
    ctxs[cx].loop_depth -= 1

compound_op = (op: int) -> int:
    k = op as Tok
    match k:
        pluseq: int(Tok.plus)
        minuseq: int(Tok.minus)
        stareq: int(Tok.star)
        slasheq: int(Tok.slash)
        percenteq: int(Tok.percent)
        ampeq: int(Tok.amp)
        pipeeq: int(Tok.pipe)
        careteq: int(Tok.caret)
        shleq: int(Tok.shl)
        shreq: int(Tok.shr)
        _: 0

# Dewy's arithmetic helpers implement floor division, exact division and power.
# Keep the update as an assignment until its place and indices are resolved.
compound_value = (s: int, left: int, right: int) -> int:
    if nodes[s].sval != 0:
        n = bc_call(name_of(int(nodes[s].sval)), [left, right], nodes[s].pos)
        if has_flag(s, NF_BROADCAST): add_flag(n, NF_BROADCAST)
        return n
    n = mk(.binary, nodes[s].pos)
    nodes[n].op = i32(compound_op(int(nodes[s].op)))
    if has_flag(s, NF_BROADCAST):
        nodes[n].aux = i32(tok_text(nodes[n].op as Tok)[0])
        nodes[n].op = i32(int(Tok.dotop))
    nodes[n].a = i32(left)
    nodes[n].b = i32(right)
    n

compound_checked = (s: int, left: int, right: int, target: int) -> int:
    n = compound_value(s, left, right)
    result = prune(check_expr(n, 0))
    t = prune(target)
    # Built-in compound arithmetic keeps the destination's fixed width,
    # just as += does, even when a library helper computes in 64 bits.
    if nodes[s].sval != 0 and ((is_int(t) and is_int(result)) or (is_float(t) and is_float(result))):
        if result != t: wrap_conv(last_checked, (if is_int(t): CV.int_ else: CV.float_), t)
    coerce(last_checked, target)

# the variable a narrowing alias (see narrow_var) stands for, or 0
narrowed_var = (l: int) -> int:
    if int(locals[l].flags) & LF_ALIAS == 0: return 0
    e = int(locals[l].alias)
    if nodes[e].kind != .narrow and nodes[e].kind != .unwrap and (nodes[e].kind != .conv or nodes[e].aux != i32(int(CV.union_))): return 0
    a = int(nodes[e].a)
    if nodes[a].kind != .ident or nodes[a].aux != i32(int(SK.local)): return 0
    int(nodes[a].sym)

# a closure using a narrowed name of the function around it: it captures the variable itself
# (so that it sees later changes, as with any captured variable) and narrows it again inside
capture_narrowed = (l: int, pos: int) -> int:
    u = narrowed_var(l)
    inner = 0
    # (a name narrowed twice: its variable's narrowing first)
    if narrowed_var(u) != 0: inner = capture_narrowed(u, pos)
    else: inner = capture_local(u)
    al = int(locals[l].alias)
    e = mk(nodes[al].kind, pos)
    nodes[e].aux = nodes[al].aux
    nodes[e].type = nodes[al].type
    nodes[e].a = i32(mk_ident_local(inner, pos))
    add_flag(e, NF_CHECKED)
    nl = new_local(0, int(locals[l].type), pos)
    locals[nl].name = locals[l].name
    locals[nl].flags = i32(LF_ALIAS)
    locals[nl].alias = i32(e)
    nl

# Only writes to narrowed aliases need rollback between sibling branches.
# The log avoids scanning all locals or copying checker state for every branch.
narrow_changes: int[]

struct NarrowJump:
    context: i32
    depth: i32

narrow_jumps: NarrowJump[]

narrow_restore = (mark: int) -> int[]:
    if narrow_changes.len() == mark: return []
    changed: int[]
    loop i in [mark..narrow_changes.len()):
        l = narrow_changes[i]
        locals[l].flags = i32(int(locals[l].flags) & ~LF_UNNARROWED)
        changed.push(l)
    narrow_changes.truncate(mark)
    changed

narrow_invalidate = (l: int):
    if int(locals[l].flags) & LF_UNNARROWED == 0:
        locals[l].flags = i32(int(locals[l].flags) | LF_UNNARROWED)
        narrow_changes.push(l)

narrow_merge = (changed: int[]):
    loop l in changed: narrow_invalidate(l)

# A returning arm cannot change the state on the path after it. Jumps to an
# enclosing loop must retain writes; jumps contained in the arm do not escape.
# Log targets while checking instead of walking checked ASTs again. Callees
# and nested closures have their own context IDs and cannot exit this branch.
narrow_returned = (mark: int, jumps: int, body: int):
    if not stmt_terminates(body): return
    loop i in [jumps..narrow_jumps.len()):
        jump = narrow_jumps[i]
        if jump.context == i32(cx) and jump.depth <= ctxs[cx].loop_depth: return
    loop i in [mark..narrow_changes.len()):
        l = narrow_changes[i]
        locals[l].flags = i32(int(locals[l].flags) & ~LF_UNNARROWED)
    narrow_changes.truncate(mark)

# x = v where x is narrowed (by `is`) and v is not of the narrowed type: x is the whole variable again
unnarrow_assign = (s: int):
    lhs = int(nodes[s].a)
    if nodes[lhs].kind != .ident: return
    sy = lookup(int(nodes[lhs].name))
    if sy == 0 or syms[sy].kind != .local: return
    l = int(syms[sy].ref)
    u = narrowed_var(l)
    if u == 0: return
    rt = prune(check_expr(int(nodes[s].b), 0))
    nodes[s].b = i32(last_checked)
    add_flag(int(nodes[s].b), NF_CHECKED)
    # (a member assigned to a variable narrowed to that member is stored in place; a variable
    # narrowed to several members is always assigned as a whole)
    al = int(locals[l].alias)
    in_place = nodes[al].kind != .conv
    if in_place and not is_union(rt) and types[rt].kind != .opt and can_coerce(int(nodes[s].b), rt, int(locals[l].type)): return
    narrow_invalidate(l)
    nm = int(nodes[lhs].name)
    push_scope_sym(nm, new_sym(nm, .local, u, 0))

# returns the (possibly replaced) statement node
# `x = ...` in a function, where x is a global declared below the function in the same file:
# that reads like a new local variable, but changes the global, so it gets a warning (a loop
# counter `k` in a helper quietly being the script's `k` further down). Declaring the global
# above the function says it is meant.
late_warned: {int: bool}
check_late_global = (s: int):
    if cx < 0 or nodes[s].op != i32(int(Tok.assign)): return
    if ctxs[cx].mod >= 0 and modules[int(ctxs[cx].mod)].is_prelude: return
    lhs = int(nodes[s].a)
    if nodes[lhs].kind != .ident: return
    inst = int(ctxs[cx].inst)
    if inst <= 0 or inst >= fns.len(): return
    fd = int(fns[inst].decl)
    if fd == 0: return
    nm = int(nodes[lhs].name)
    sym = lookup(nm)
    if sym == 0 or syms[sym].kind != .global or syms[sym].decl == 0: return
    gpos = nodes[int(syms[sym].decl)].pos
    fpos = nodes[fd].pos
    if pos_file(gpos) != pos_file(fpos) or pos_off(gpos) <= pos_off(fpos): return
    # (an error, not a warning: a global added further down would quietly change what the
    # function does)
    fatal(nodes[lhs].pos, "'{name_of(nm)}' is the global variable declared below this function (at {pos_str(gpos)}), so this would change it: for a variable of the function's own, write `let {name_of(nm)} = ...` (or use another name); to mean the global, declare it above the function")

# An update through a custom [] / []= pair reads, edits and writes back the
# selected value. Walk from the root outward so nested containers compose:
#     e = pool[h]; e.inventory[i] = v; pool[h] = e
# Receiver indices and the custom index are captured once, in source order.
elem_tmp_n = 0

# The path from an expression back to its root, outermost access first.
index_update_path = (n: int) -> int[]:
    path: int[]
    let n = n
    loop nodes[n].kind == .field or nodes[n].kind == .index:
        path.push(n)
        n = int(nodes[n].a)
    path

# Capture an index even when it is a variable: the update's right side may
# change that variable before the selected value is written back.
index_update_capture = (ix: int, stmts: mut int[]) -> int:
    pos = nodes[ix].pos
    elem_tmp_n += 1
    name = intern("__index{elem_tmp_n}")
    d = mk(.vardecl, pos)
    nodes[d].name = i32(name)
    nodes[d].b = nodes[ix].b
    stmts.push(d)
    nodes[ix].b = i32(comp_ident(name, pos))
    name

# Reads that cannot run user code or change the place being updated. Checked
# custom indexing is a call and deliberately does not qualify.
pool_update_scalar = (n: int) -> bool:
    t = prune(ntype(n))
    is_numeric(t) or tkind(t) == .bool_

pool_update_read = (n: int) -> bool:
    k = nodes[n].kind
    if k == .ident or k == .int_lit or k == .float_lit or k == .bool_lit: return true
    if k == .field: return pool_update_read(int(nodes[n].a))
    if k == .index and nodes[n].b != 0:
        return tkind(ntype(int(nodes[n].a))) == .array and pool_update_read(int(nodes[n].a)) and pool_update_read(int(nodes[n].b))
    # Inspect checked scalar operators: an overloaded operator has become a
    # call. Do not admit aggregate comparisons or conversions on this basis.
    if k == .unary or k == .not_ or k == .conv:
        a = int(nodes[n].a)
        return pool_update_scalar(n) and pool_update_scalar(a) and pool_update_read(a)
    if k == .binary or k == .and_ or k == .or_:
        a = int(nodes[n].a)
        b = int(nodes[n].b)
        return pool_update_scalar(n) and pool_update_scalar(a) and pool_update_scalar(b) and pool_update_read(a) and pool_update_read(b)
    false

# a `:>void | E` body that runs off its end gives its void member: a final bare return
void_arm_end = (body: int, r: int) -> bool:
    if not union_has_void(r): return false
    ret = mk(.return_, nodes[body].pos)
    check_stmt(ret)
    items = kids(body)
    items.push(ret)
    set_list(body, items)
    true

pool_library_fn = (f: int) -> bool:
    if f <= 0: return false
    d = int(fns[f].decl)
    d != 0 and decl_in_prelude(d) and files[pos_file(nodes[d].pos)].path == lib_dir + "/std/pool.jo"

pool_direct_update = (s: int, ix: int, bt: int) -> bool:
    if types[bt].kind != .struct_ or structs[int(types[bt].st)].name != "Pool": return false
    # Do not bypass a user getter or setter, even for the bundled Pool type.
    get = clone(ix)
    check_expr(get, 0)
    get = last_checked
    if nodes[get].kind != .call or nodes[get].aux != 0 or nkids(get) != 2 or not pool_library_fn(int(nodes[get].sym)): return false
    ht = ntype(kid(get, 1))
    vt = ntype(get)
    if resolve_by_types(intern("__setindex__"), [bt, ht, vt], nodes[s].pos, false) != 0: return false
    if not pool_library_fn(resolve_by_types(intern("[]="), [bt, ht, vt], nodes[s].pos, false)): return false
    # The old read/edit/writeback remains necessary when evaluation can change
    # the pool or invoke a custom arithmetic operator. Start with scalar writes
    # whose operands are scalar expressions over ordinary reads.
    lt = check_expr(clone(int(nodes[s].a)), 0)
    if not is_numeric(prune(lt)) and tkind(lt) != .bool_: return false
    check_expr(clone(int(nodes[s].b)), 0)
    if not pool_update_read(last_checked): return false
    loop part in index_update_path(int(nodes[s].a)):
        if nodes[part].kind != .index: continue
        if nodes[part].b == 0: return false
        check_expr(clone(int(nodes[part].b)), 0)
        if not pool_update_read(last_checked): return false
        if part != ix:
            pt = check_expr(clone(int(nodes[part].a)), 0)
            if tkind(pt) != .array: return false
    true

elem_field_assign = (s: int) -> int:
    if has_flag(s, NF_INDEX_CAPTURED): return 0
    lhs = int(nodes[s].a)
    path = index_update_path(lhs)
    ix = 0
    direct_pool = -1
    i = path.len() - 1
    loop i >= 0:
        candidate = path[i]
        i -= 1
        if nodes[candidate].kind != .index or nodes[candidate].b == 0: continue
        if candidate == lhs and nodes[s].op == i32(int(Tok.assign)): continue
        # Inspect a copy: checking an overloaded index rewrites it to a call,
        # but the original receiver path is needed for capture and writeback.
        bt = prune(check_expr(clone(int(nodes[candidate].a)), 0))
        if types[bt].kind == .struct_ and not is_map_type(bt) and not is_soa(bt) and not is_part_index(candidate, bt):
            ix = candidate
            if pool_direct_update(s, ix, bt): direct_pool = module_of_type(bt)
            break
    if ix == 0: return 0
    pos = nodes[s].pos
    stmts: int[]
    receiver_path = index_update_path(int(nodes[ix].a))
    j = receiver_path.len() - 1
    loop j >= 0:
        part = receiver_path[j]
        j -= 1
        if nodes[part].kind == .index and nodes[part].b != 0:
            index_update_capture(part, stmts)
    iname = index_update_capture(ix, stmts)
    if direct_pool >= 0:
        recv = int(nodes[ix].a)
        # Qualify the library helper so a local function with the same name
        # cannot intercept the compiler-generated lookup.
        ensure_bundled_import("std/pool.jo", "$dewy_pool", pos)
        library = bc_ident("$dewy_pool", pos)
        checked_index = mk(.call, pos)
        nodes[checked_index].a = i32(bc_field(library, "__pool_index", pos))
        set_list(checked_index, [clone(recv), comp_ident(iname, pos)])
        storage = bc_field(recv, "items", pos)
        nodes[ix] = Node(kind = .index, pos = pos, a = i32(storage), b = i32(checked_index))
        c0 = nodes.len()
        nodes.push(nodes[s])
        stmts.push(c0)
        blk0 = mk(.block, pos)
        set_list(blk0, stmts)
        check_stmt(blk0)
        return blk0
    if ix == lhs:
        c0 = nodes.len()
        nodes.push(nodes[s])
        add_flag(c0, NF_INDEX_CAPTURED)
        stmts.push(c0)
        blk0 = mk(.block, pos)
        set_list(blk0, stmts)
        check_stmt(blk0)
        return blk0
    r0 = clone(int(nodes[ix].a))
    r1 = clone(int(nodes[ix].a))
    elem_tmp_n += 1
    ename = intern("__elem{elem_tmp_n}")
    rd = mk(.index, pos)
    nodes[rd].a = i32(r0)
    nodes[rd].b = i32(comp_ident(iname, pos))
    de = mk(.vardecl, pos)
    nodes[de].name = i32(ename)
    nodes[de].b = i32(rd)
    stmts.push(de)
    # The remaining field/index path operates on the selected value.
    f = lhs
    loop int(nodes[f].a) != ix: f = int(nodes[f].a)
    nodes[f].a = i32(comp_ident(ename, pos))
    update_at = stmts.len()
    stmts.push(s)
    wr = mk(.index, pos)
    nodes[wr].a = i32(r1)
    nodes[wr].b = i32(comp_ident(iname, pos))
    back = mk(.assign, pos)
    nodes[back].op = i32(int(Tok.assign))
    nodes[back].a = i32(wr)
    nodes[back].b = i32(comp_ident(ename, pos))
    stmts.push(back)
    blk = mk(.block, pos)
    # (the original statement, now e.f = v, is checked inside the block)
    c = nodes.len()
    nodes.push(nodes[s])
    stmts[update_at] = c
    set_list(blk, stmts)
    check_stmt(blk)
    blk

# s = s + x on text or an array: s += x, which adds to the end in place; the other copies all of
# s each time, and a loop of them takes time growing with the square of the length
append_assign = (s: int):
    lhs = int(nodes[s].a)
    if nodes[lhs].kind != .ident: return
    spine: int[]
    n = int(nodes[s].b)
    loop nodes[n].kind == .binary and nodes[n].op == i32(int(Tok.plus)):
        spine.push(n)
        n = int(nodes[n].a)
    if spine.len() == 0 or nodes[n].kind != .ident or nodes[n].name != nodes[lhs].name: return
    sy = lookup(int(nodes[lhs].name))
    if sy == 0 or (syms[sy].kind != .local and syms[sy].kind != .global): return
    t = prune(check_expr(clone(lhs), 0))
    if tkind(t) != .str_ and tkind(t) != .array: return
    # (s + a + b is (s + a) + b: s, then the rest in order, appended)
    rest = int(nodes[spine[spine.len() - 1]].b)
    if spine.len() == 1: nodes[s].b = i32(rest)
    else: nodes[spine[spine.len() - 2]].a = i32(rest)
    nodes[s].op = i32(int(Tok.pluseq))

# A checked receiver path that can be aliased without running a getter again.
dewy_end_place = (n: int) -> bool:
    k = nodes[n].kind
    if k == .ident: return true
    if k == .field or k == .index: return dewy_end_place(int(nodes[n].a))
    false

dewy_end_assign = (s: int) -> int:
    ix = 0
    part = int(nodes[s].a)
    loop nodes[part].kind == .field or nodes[part].kind == .index:
        if nodes[part].kind == .index and nodes[part].sval != 0: ix = part
        part = int(nodes[part].a)
    if ix == 0: return 0
    pos = nodes[ix].pos
    receiver = int(nodes[ix].a)
    source_type = prune(check_expr(clone(receiver), 0))
    stable = dewy_end_place(last_checked)
    stmts: int[]
    receiver_path = index_update_path(receiver)
    j = receiver_path.len() - 1
    loop j >= 0:
        part = receiver_path[j]
        j -= 1
        if nodes[part].kind == .index and nodes[part].b != 0: index_update_capture(part, stmts)
    name = "$index_target{bc_count}"
    bc_count += 1
    end_source = clone(receiver)
    if not stable:
        stmts.push(bc_let(name, end_source, pos))
        end_source = bc_ident(name, pos)
        nodes[ix].a = i32(bc_ident(name, pos))
    loop binding in dewy_index_end_bindings(ix, end_source, source_type): stmts.push(binding)
    nodes[ix].sval = 0
    update = nodes.len()
    nodes.push(nodes[s])
    stmts.push(update)
    if not stable: stmts.push(bc_assign(receiver, bc_ident(name, pos), pos))
    blk = bc_block(stmts, pos)
    check_stmt(blk)
    blk

# A dotted selection update reads the original source, captures its selector,
# computes the result, then reacquires the destination for writeback. An open
# slice becomes a small stored range before the RHS can resize the destination.
dewy_selection_update = (s: int, matrix: bool = false) -> int:
    lhs = int(nodes[s].a)
    pos = nodes[s].pos
    stmts: int[]
    path = index_update_path(int(nodes[lhs].a))
    j = path.len() - 1
    loop j >= 0:
        part = path[j]
        j -= 1
        if nodes[part].kind == .index and nodes[part].b != 0: index_update_capture(part, stmts)
    elem_tmp_n += 1
    source = "$selection_source{elem_tmp_n}"
    selector = "$selection_index{elem_tmp_n}"
    value = "$selection_value{elem_tmp_n}"
    captured = "$selection{elem_tmp_n}"
    reads = [bc_let(source, clone(int(nodes[lhs].a)), pos)]
    spec = int(nodes[lhs].b)
    if matrix:
        shape = bc_field(bc_ident(source, pos), "shape", pos)
        spec = bc_call("__nd_bound_part", [shape, part_spec(lhs)], pos)
    else if nodes[spec].kind == .range:
        size = bc_method(bc_ident(source, pos), "len", [], pos)
        spec = bc_call("__dewy_slice_range", [size] + dewy_slice_args(spec, pos), pos)
    reads.push(bc_let(selector, spec, pos))
    picked = mk(.index, pos)
    nodes[picked].a = i32(bc_ident(source, pos))
    nodes[picked].b = i32(bc_ident(selector, pos))
    if matrix: picked = bc_call("__nd_slice", [bc_ident(source, pos), bc_ident(selector, pos)], pos)
    pair = mk(.tuple, pos)
    set_list(pair, [bc_ident(selector, pos), picked])
    reads.push(bc_stmt(pair, pos))
    # Release the whole-source snapshot after selecting the old values. Keeping
    # it through writeback would force a full-array COW copy for a tiny update.
    stmts.push(bc_let(captured, bc_block(reads, pos), pos))
    loop i in [0..2):
        field = mk(.field, pos)
        nodes[field].a = i32(bc_ident(captured, pos))
        nodes[field].aux = -2
        nodes[field].ival = i
        name = if i == 0: selector else: value
        stmts.push(bc_let(name, field, pos))
    update = nodes.len()
    nodes.push(nodes[s])
    nodes[update].a = i32(bc_ident(value, pos))
    stmts.push(update)
    # Capturing receiver indices changed checked paths; resolve those paths
    # again with the new index bindings before generating the write.
    if matrix:
        receiver = clone(int(nodes[lhs].a))
        add_flag(receiver, NF_MUT)
        stmts.push(bc_stmt(bc_call("__nd_slice_set", [receiver, bc_ident(selector, pos), bc_ident(value, pos)], pos), pos))
    else:
        nodes[lhs].b = i32(bc_ident(selector, pos))
        stmts.push(bc_assign(clone(lhs), bc_ident(value, pos), pos))
    block = bc_block(stmts, pos)
    check_stmt(block)
    block

check_assign = (s: int) -> int:
    if files[pos_file(nodes[s].pos)].is_dewy:
        end_update = dewy_end_assign(s)
        if end_update != 0: return end_update
    if nodes[s].op == i32(int(Tok.assign)):
        unnarrow_assign(s)
        append_assign(s)
    sl = soa_alias_of(int(nodes[s].a))
    if sl != 0:
        # p = value in `loop mut p in ps`: ps[i] = value
        if int(locals[sl].flags) & LF_SOAMUT == 0: fatal(nodes[s].pos, "cannot modify loop variable '{name_of(int(locals[sl].name))}' (use `{mutable_loop_syntax(nodes[s].pos)}`)")
        nodes[s].a = i32(clone(int(locals[sl].soa)))
    lhs = int(nodes[s].a)
    op = int(nodes[s].op)
    if nodes[lhs].kind == .tuple:
        if op != int(Tok.assign): fatal(nodes[s].pos, "compound assignment to a tuple")
        if files[pos_file(nodes[s].pos)].is_dewy:
            loop binding in binding_leaves(kids(lhs)):
                if nodes[binding].a != 0: fatal(nodes[binding].pos, "type annotations declare bindings; use let or const for typed unpacking")
        t = prune(check_expr(int(nodes[s].b), 0))
        nodes[s].b = i32(last_checked)
        unpacked = unpack_binding(int(nodes[s].b), t, kids(lhs), nodes[s].pos)
        t = unpacked.0
        set_list(lhs, unpacked.1)
        nodes[s].b = i32(last_checked)
        if types[t].kind != .tuple or int(types[t].nargs) != nkids(lhs): fatal(nodes[s].pos, "expected a tuple with {nkids(lhs)} elements (or an array), found {dt(t)}")
        loop i in [0..nkids(lhs)):
            tp = kid(lhs, i)
            if nodes[tp].kind == .hole: continue
            tt = check_expr(tp, 0)
            set_kid(lhs, i, last_checked)
            check_place(last_checked, false)
            if not can_coerce(0, targ(t, i), tt) and not type_eq(targ(t, i), tt): fatal(nodes[tp].pos, "cannot assign {dt(targ(t, i))} to {dt(tt)}")
        if refine_active:
            contracted = false
            loop target in kids(lhs):
                if nodes[target].kind == .hole: continue
                if ref_storage_contract(refine_storage(target, ntype(target))) or ref_dependent_ancestor(target): contracted = true
            if contracted:
                before: int[]
                source = capture_value(int(nodes[s].b), t, before)
                loop i in [0..nkids(lhs)):
                    target = kid(lhs, i)
                    if nodes[target].kind == .hole: continue
                    field = mk(.field, nodes[s].pos)
                    nodes[field].a = i32(source)
                    nodes[field].aux = -2
                    nodes[field].ival = i
                    check_expr(field, 0)
                    field = last_checked
                    store = bc_assign(target, field, nodes[s].pos)
                    before.push(check_assign(store))
                return bc_block(before, nodes[s].pos)
        nodes[s].aux = 1
        converted = false
        loop i in [0..nkids(lhs)):
            target = kid(lhs, i)
            if nodes[target].kind != .hole and not type_eq(targ(t, i), ntype(target)): converted = true
        if converted:
            # Freeze the tuple once, then convert every element before writing
            # destinations. Semantic int and fixed widths have different ABIs.
            elem_tmp_n += 1
            name = "$unpack_convert{elem_tmp_n}"
            pos = nodes[s].pos
            decl = bc_let(name, int(nodes[s].b), pos)
            add_flag(int(nodes[s].b), NF_CHECKED)
            check_stmt(decl)
            values: int[]
            targets: int[]
            loop i in [0..nkids(lhs)):
                field = mk(.field, pos)
                nodes[field].a = i32(bc_ident(name, pos))
                nodes[field].aux = -2
                nodes[field].ival = i
                check_expr(field, 0)
                field = last_checked
                target = kid(lhs, i)
                tt = if nodes[target].kind == .hole: targ(t, i) else: ntype(target)
                values.push(coerce(field, tt))
                targets.push(tt)
            tuple = mk(.tuple, pos)
            nodes[tuple].type = i32(mk_tuple(targets))
            add_flag(tuple, NF_CHECKED)
            set_list(tuple, values)
            nodes[s].b = i32(tuple)
            assignment = nodes.len()
            nodes.push(nodes[s])
            return bc_block([decl, assignment], pos)
        return s
    if nodes[lhs].kind == .field or (nodes[lhs].kind == .index and (op != int(Tok.assign) or nodes[int(nodes[lhs].a)].kind == .index or nodes[int(nodes[lhs].a)].kind == .field)):
        r = elem_field_assign(s)
        if r != 0: return r
    if nodes[lhs].kind == .index:
        bt = prune(check_expr(int(nodes[lhs].a), 0))
        nodes[lhs].a = i32(last_checked)
        dewy_index_ranges(lhs, bt)
        range = int(nodes[lhs].b)
        if range != 0 and nodes[range].kind == .range:
            if types[bt].kind == .array or types[bt].kind == .fixed:
                if has_flag(s, NF_BROADCAST): return dewy_selection_update(s)
                if op != int(Tok.assign): fatal(nodes[s].pos, "compound assignment to picked elements (write an explicit loop)")
                call = dewy_array_slice(lhs, int(nodes[s].b))
                es = mk(.exprstmt, nodes[s].pos)
                check_expr(call, 0)
                nodes[es].a = i32(last_checked)
                return es
            if has_flag(range, NF_STEP) and not is_nd(bt): fatal(nodes[s].pos, "stepped slicing requires an array")
        if is_soa(bt) and nodes[lhs].b != 0: return soa_assign(s)
        if (types[bt].kind == .array or types[bt].kind == .fixed) and nodes[lhs].b != 0 and nodes[int(nodes[lhs].b)].kind != .int_lit and nodes[int(nodes[lhs].b)].kind != .range:
            put = index_array_fn(int(nodes[lhs].b), "__put")
            if len(put) > 0:
                # xs[mask] = v, xs[idxs] = vs: sets the elements picked
                if has_flag(s, NF_BROADCAST): return dewy_selection_update(s)
                if op != int(Tok.assign): fatal(nodes[s].pos, "compound assignment to picked elements (write xs[m] = xs[m] .+ x)")
                recv = int(nodes[lhs].a)
                add_flag(recv, NF_MUT)
                call = dewy_array_selection_call(put, [recv, int(nodes[lhs].b), int(nodes[s].b)], bt, nodes[s].pos)
                es = mk(.exprstmt, nodes[s].pos)
                check_expr(call, 0)
                nodes[es].a = i32(last_checked)
                return es
        if types[bt].kind == .struct_ and is_part_index(lhs, bt):
            # m[.., j] = xs: writes into a part of m
            if has_flag(s, NF_BROADCAST) and is_nd(bt): return dewy_selection_update(s, true)
            if op != int(Tok.assign): fatal(nodes[s].pos, "compound assignment to a part of an array (write m[...] = m[...] .+ x)")
            recv = int(nodes[lhs].a)
            add_flag(recv, NF_MUT)
            call = bc_call("__nd_slice_set", [recv, part_spec(lhs), int(nodes[s].b)], nodes[s].pos)
            es = mk(.exprstmt, nodes[s].pos)
            check_expr(call, 0)
            nodes[es].a = i32(last_checked)
            return es
        # (m[k] += x for a map changes the value in place: see map_elem_place)
        if types[bt].kind == .struct_ and not (op != int(Tok.assign) and is_map_type(bt) and nodes[lhs].b != 0):
            call = mk(.call, nodes[s].pos)
            callee = mk(.ident, nodes[s].pos)
            nodes[callee].name = i32(intern("[]="))
            nodes[call].a = i32(callee)
            recv = int(nodes[lhs].a)
            add_flag(recv, NF_MUT)
            val = int(nodes[s].b)
            # (m[i, j] = v has several indexes)
            ixs = kids(lhs)
            if nodes[lhs].b != 0: ixs = [int(nodes[lhs].b)]
            if op != int(Tok.assign):
                get = mk(.index, nodes[s].pos)
                ga = clone(recv)
                clear_flag(ga, NF_MUT)
                nodes[ga].type = 0
                nodes[get].a = i32(ga)
                if nodes[lhs].b != 0: nodes[get].b = i32(clone(int(nodes[lhs].b)))
                else:
                    cl: int[]
                    loop x in ixs: cl.push(clone(x))
                    set_list(get, cl)
                if nodes[s].sval != 0 or has_flag(s, NF_BROADCAST):
                    gt = check_expr(get, 0)
                    get = last_checked
                    add_flag(get, NF_CHECKED)
                    val = compound_checked(s, get, val, gt)
                    add_flag(val, NF_CHECKED)
                else: val = compound_value(s, get, val)
            set_list(call, [recv] + ixs + [val])
            # (a resolved call, such as m[1] in m[1][2] = 3, is not checked again)
            if nodes[recv].kind != .call: clear_flag(recv, NF_CHECKED)
            es = mk(.exprstmt, nodes[s].pos)
            check_expr(call, 0)
            nodes[es].a = i32(last_checked)
            return es
    # (assigning a narrowed field or global assigns the whole of it)
    plain = op == int(Tok.assign) and nodes[lhs].kind != .ident or op == int(Tok.assign) and path_narrows > 0
    if plain: no_narrow_at = lhs
    cur_assign = s
    # (the variable at the bottom of v.f = 1 or v[i] += 1 is written, not read)
    saved_root = assign_root
    assign_root = place_root(lhs)
    lt = check_expr(lhs, 0)
    assign_root = saved_root
    cur_assign = 0
    no_narrow_at = 0
    lhs = last_checked
    nodes[s].a = i32(lhs)
    check_place(lhs, false)
    # (a local written through and never read: see copy_write_warnings)
    if nodes[lhs].kind == .field or nodes[lhs].kind == .index:
        r = place_root(lhs)
        if r != 0 and nodes[r].kind == .ident and nodes[r].aux == i32(int(SK.local)):
            wl = int(nodes[r].sym)
            if not copy_writes.has(wl): copy_writes[wl] = nodes[s].pos
        else if r != 0 and nodes[r].kind == .ident and nodes[r].aux == i32(int(SK.global)):
            wg = int(nodes[r].sym)
            if not gcopy_writes.has(wg): gcopy_writes[wg] = nodes[s].pos
    if refine_active:
        lt = refine_storage(lhs, lt)
        replacement = ref_field_store(s, lt)
        if replacement != 0: return replacement
    if op == int(Tok.assign):
        rt = prune(check_expr(int(nodes[s].b), lt))
        if rt != lt and nodes[lhs].kind == .ident and (nodes[lhs].aux == i32(int(SK.local)) or nodes[lhs].aux == i32(int(SK.global))) and not can_coerce(last_checked, rt, lt): var_type_error(lhs, lt, rt, nodes[last_checked].pos)
        # (release_call's zero bytes are no value of lt: nothing reads them)
        if nodes[last_checked].kind != .intrinsic or nodes[last_checked].aux != i32(int(IN.zeroed)): nodes[s].b = i32(coerce(last_checked, lt))
        if (nodes[lhs].kind != .ident or nodes[lhs].aux == i32(int(SK.global))) and (path_narrows > 0 or is_union(lt) or tkind(lt) == .opt):
            key = path_key(lhs)
            path_forget(key, rt)
            # x.f = 5 where x.f is int | str: x.f is an int from here on
            if is_union(lt) and union_index(lt, rt) >= 0 and len(key) > 0:
                path_narrows += 1
                narrow_expr(copy_path(lhs), [rt], nodes[s].pos, intern(key))
            # x.f = Enemy() where x.f is an Enemy?: it holds one from here on
            else if tkind(lt) == .opt and len(key) > 0 and type_eq(int(types[prune(lt)].elem), rt): narrow_path(lhs, -2, true)
        else if path_narrows > 0 and nodes[lhs].kind == .ident: path_forget(path_key(lhs))
        return s
    if types[prune(lt)].kind == .refined:
        # The checked replacement reads and writes one selected element.
        # Capture selectors before the old-value read, including scalar names
        # which the RHS could change, rather than replaying the target.
        before: int[]
        path = index_update_path(lhs)
        i = path.len() - 1
        loop i >= 0:
            part = path[i]; i -= 1
            if nodes[part].kind == .index and nodes[part].b != 0:
                selector = int(nodes[part].b)
                if nodes[selector].kind != .int_lit: nodes[part].b = i32(capture_value(selector, ntype(selector), before))
        rd = copy_place(lhs)
        add_flag(rd, NF_CHECKED)
        value = compound_checked(s, rd, int(nodes[s].b), representation_type(lt))
        nodes[s].b = i32(coerce(value, lt))
        nodes[s].op = i32(int(Tok.assign))
        if before.len() > 0: return bc_block(before + [copy_checked(s)], nodes[s].pos)
        return s
    l = prune(lt)
    if types[l].kind == .quantity and quantity_compound(s, l): return s
    if types[l].kind == .str_ and op == int(Tok.pluseq) and not has_flag(s, NF_BROADCAST):
        srt = prune(check_expr(int(nodes[s].b), T_STR))
        if nodes[lhs].kind == .ident and is_numeric(srt) and not can_coerce(last_checked, srt, T_STR): var_type_error(lhs, l, srt, nodes[s].pos)
        nodes[s].b = i32(coerce(last_checked, T_STR))
        nodes[s].aux = 2
        return s
    bop = compound_op(op)
    if types[l].kind == .ptr and nodes[s].sval == 0 and not has_flag(s, NF_BROADCAST):
        check_expr(int(nodes[s].b), T_INT)
        nodes[s].b = i32(coerce(last_checked, T_INT))
        nodes[s].aux = 3
        return s
    if l == T_MATH_INT or nodes[s].sval != 0 or has_flag(s, NF_BROADCAST) or (not is_numeric(l) and types[l].kind != .bool_) or nodes[lhs].kind == .index or nodes[lhs].kind == .field:
        # Helper calls, overloads and vectors: x = operation(x, y). Capture
        # indices before reading x, including names the right side may change.
        # Reacquire indexed/field storage after the RHS: it can resize an array.
        pos = nodes[s].pos
        pre: int[]
        x = lhs
        loop nodes[x].kind == .field or nodes[x].kind == .index:
            if nodes[x].kind == .index and nodes[x].b != 0:
                ib = int(nodes[x].b)
                ik = nodes[ib].kind
                if ik != .int_lit:
                    elem_tmp_n += 1
                    nm = intern("__index{elem_tmp_n}")
                    d = mk(.vardecl, pos)
                    nodes[d].name = i32(nm)
                    nodes[d].b = i32(ib)
                    add_flag(ib, NF_CHECKED)
                    check_stmt(d)
                    pre.insert(0, d)
                    idn = mk(.ident, pos)
                    nodes[idn].name = i32(nm)
                    check_expr(idn, 0)
                    nodes[x].b = i32(last_checked)
            x = int(nodes[x].a)
        rd = copy_place(lhs)
        add_flag(rd, NF_CHECKED)
        nodes[s].b = i32(compound_checked(s, rd, int(nodes[s].b), lt))
        nodes[s].op = i32(int(Tok.assign))
        if pre.len() == 0: return s
        # (the statement, moved, after the index's variables)
        c = nodes.len()
        nodes.push(nodes[s])
        blk = mk(.block, pos)
        set_list(blk, pre + [c])
        return blk
    is_shift = bop == int(Tok.shl) or bop == int(Tok.shr)
    hint = l
    if is_int(l) and is_shift: hint = 0
    # (score += "1": a one-character text is that character's code, 49)
    rb = int(nodes[s].b)
    if is_int(l) and nodes[rb].kind == .str_lit and nodes[rb].aux == 0 and len(name_of(int(nodes[rb].sval))) == 1 and not pos_in_lib(nodes[s].pos):
        ch = name_of(int(nodes[rb].sval))
        warn(nodes[rb].pos, "\"{ch}\" here is the character code of {ch}, not the number: write {ch} without quotes for the number")
    rt = check_expr(int(nodes[s].b), hint)
    nodes[s].b = i32(last_checked)
    if is_shift:
        if not is_int(rt): fatal(nodes[int(nodes[s].b)].pos, "shift amount must be an integer")
        if has_flag(int(nodes[s].b), NF_LITERAL): nodes[s].b = i32(coerce(int(nodes[s].b), T_INT))
    else:
        if is_int(l) and is_float(rt):
            if nodes[lhs].kind == .ident: var_type_error(lhs, l, rt, nodes[s].pos)
            fatal(nodes[s].pos, "cannot apply {tok_text(op as Tok)} to {dt(l)} and {dt(rt)} (int(...) makes the value an int, or make the field a float)")
        nodes[s].b = i32(coerce(int(nodes[s].b), l))
    s

# a function another engine would call, which nothing here does: one warning, saying what is
# called instead (not also that it is never called)
callback_warn = (gs: int, msg: str):
    d = int(syms[gs].decl)
    fn_used[d] = true
    warn(nodes[d].pos, msg)

# x = value where x is a variable of another type: where x was made, and the ways out
var_type_error = (lhs: int, lt: int, rt: int, at: int):
    nm = name_of(int(nodes[lhs].name))
    made = ""
    p = 0
    if nodes[lhs].aux == i32(int(SK.local)) and nodes[lhs].sym > 0: p = locals[int(nodes[lhs].sym)].pos
    else if nodes[lhs].sym > 0 and globals[int(nodes[lhs].sym)].decl > 0: p = nodes[int(globals[int(nodes[lhs].sym)].decl)].pos
    if p > 0 and pos_file(p) == pos_file(at):
        ln, c = line_col(p)
        made = " (made on line {ln})"
    how = "`let {nm} = ...` makes a new variable"
    if is_int(lt) and is_float(rt):
        # (time_left = 30, then time_left -= dt: 30.0 holds fractions)
        start = "0.0"
        if nodes[lhs].aux != i32(int(SK.local)) and nodes[lhs].sym > 0 and globals[int(nodes[lhs].sym)].decl > 0:
            gd = int(globals[int(nodes[lhs].sym)].decl)
            if nodes[gd].b != 0 and nodes[int(nodes[gd].b)].kind == .int_lit: start = "{nodes[int(nodes[gd].b)].ival}.0"
        how = "write its first value with a decimal point (`{nm} = {start}`), so it holds fractions too, or make this a whole number with int(...)"
        fatal(at, "'{nm}' holds whole numbers{made}, and this is a number with a fraction: {how}")
    # (score = "0", then score += 1: a number in quotes is text)
    if tkind(lt) == .str_ and is_numeric(rt):
        fatal(at, "'{nm}' holds text{made} (a value in quotes, \"0\", is text, even with digits): for a number, give it one without quotes (`{nm} = 0`)")
    fatal(at, "'{nm}' has type {dt(lt)}{made} and cannot hold this {dt(rt)}: {how}")

# A type on the whole pattern supplies context before extracting its leaves.
check_binding_input = (s: int) -> int:
    expected = 0
    if nodes[s].a != 0: expected = resolve_type(int(nodes[s].a))
    t = prune(check_expr(int(nodes[s].b), expected))
    nodes[s].b = i32(last_checked)
    if expected != 0:
        nodes[s].b = i32(coerce(int(nodes[s].b), expected))
        t = prune(expected)
    t

check_vardecl = (s: int):
    if has_flag(s, NF_SOA):
        soa_alias(s)
        return
    if has_flag(s, NF_ALIASDECL):
        # (the element of a `mut x in xs` in a combined loop: a name for xs[k] itself)
        arr0 = 0
        if nodes[int(nodes[s].b)].kind == .index: arr0 = int(nodes[int(nodes[s].b)].a)
        check_expr(int(nodes[s].b), 0)
        ix = last_checked
        if arr0 != 0 and nodes[arr0].type != 0 and is_soa(ntype(arr0)): fatal(nodes[s].pos, "a soa array's `mut` elements go in a loop of their own, `loop mut p in ps:`; with a count beside them, by index: `loop i in [0..ps.len()): ps[i].x += ...`")
        check_place(ix, true)
        l = new_local(int(nodes[s].name), ntype(ix), nodes[s].pos)
        locals[l].flags = i32(LF_ALIAS | LF_ELEMALIAS)
        locals[l].alias = i32(ix)
        nodes[s].kind = .block
        nodes[s].nlist = 0
        return
    if nodes[s].nlist > 0:
        if has_flag(s, NF_GLOBAL):
            loop binding in binding_leaves(kids(s)):
                if nodes[binding].kind != .hole:
                    ensure_global(int(nodes[binding].sym), nodes[s].pos, true)
                    return
            # With only discards, no global initializer checks the source for us.
        t = check_binding_input(s)
        unpacked = unpack_binding(int(nodes[s].b), t, kids(s), nodes[s].pos)
        t = unpacked.0
        set_list(s, unpacked.1)
        nodes[s].b = i32(last_checked)
        if types[t].kind != .tuple or int(types[t].nargs) != nkids(s): fatal(nodes[s].pos, "expected a tuple with {nkids(s)} elements (or an array), found {dt(t)}")
        loop i in [0..nkids(s)):
            id = kid(s, i)
            if nodes[id].kind == .hole: continue
            l = new_local(int(nodes[id].name), targ(t, i), nodes[id].pos)
            locals[l].flags = i32(LF_DECL | LF_QUIET)
            if has_flag(s, NF_RDONLY): locals[l].flags = i32(LF_DECL | LF_QUIET | LF_CONST)
            nodes[id].sym = i32(l)
        nodes[s].type = i32(t)
        return
    if has_flag(s, NF_GLOBAL):
        ensure_global(int(nodes[s].sym), nodes[s].pos, true)
        return
    t = 0
    if nodes[s].a != 0:
        previous_self = refine_self
        refine_self = int(nodes[s].name)
        t = resolve_type(int(nodes[s].a))
        refine_self = previous_self
    if refine_active and types[prune(t)].kind == .refined and nodes[s].b == 0: nodes[s].b = i32(struct_default(t, nodes[s].pos))
    nm = name_of(int(nodes[s].name))
    # (x: T, a struct with default field values: it starts with them, as T() would)
    if nodes[s].b == 0 and t != 0: nodes[s].b = i32(struct_default(t, nodes[s].pos))
    if nodes[s].b != 0:
        et = check_expr(int(nodes[s].b), t)
        nodes[s].b = i32(last_checked)
        if t != 0: nodes[s].b = i32(coerce(int(nodes[s].b), t))
        else:
            t = et
            if has_flag(int(nodes[s].b), NF_LITERAL):
                t = lit_default(int(nodes[s].b))
                nodes[s].b = i32(coerce(int(nodes[s].b), t))
            if tkind(t) == .none_lit: fatal(nodes[s].pos, "cannot infer the type of '{nm}' from 'none'; add a type: {nm}: T? = none")
    if effects_active and nodes[s].a == 0 and type_has_fn(t):
        storage = effect_storage_type(t)
        if storage != t:
            wrap_conv(int(nodes[s].b), .none_, storage)
            t = storage
    if t == 0: fatal(nodes[s].pos, "variable needs a type or a value")
    tk = tkind(t)
    if tk == .void_: fatal(nodes[s].pos, "cannot assign a value with no type (void) to '{nm}'{void_rec_hint(int(nodes[s].b))}")
    if tk == .null_: fatal(nodes[s].pos, "`null` is for C's pointers; a value that may be missing is `none`, with its type written: {jd(nodes[s].pos, "`{nm}: Enemy? = none`", "`let {nm}:Enemy? = none`")}")
    if tk == .typeval or tk == .module: fatal(nodes[s].pos, "'{nm}' cannot hold a type or module (a value of a type is made by calling it: `T()`)")
    l = new_local(int(nodes[s].name), t, nodes[s].pos)
    if nodes[s].b != 0 and quat_nodes.has(int(nodes[s].b)): quat_locals[l] = true
    locals[l].flags = i32(LF_DECL)
    if has_flag(s, NF_RDONLY):
        locals[l].flags = i32(LF_DECL | LF_CONST | LF_QUIET)
        locals[l].const_init = nodes[s].b
    if has_flag(s, NF_LOOPCOUNT): locals[l].flags = i32(LF_DECL | LF_QUIET)
    nodes[s].sym = i32(l)
    if ide_on and nodes[s].a == 0: ide_hint_local(s, l)

check_stmt = (s: int):
    k = nodes[s].kind
    if k == .reflect_scope:
        mark = scope_mark()
        reflect_bind(s)
        body = int(nodes[s].b)
        active = reflect_active
        reflect_active = true
        check_block(body, 0, false)
        reflect_active = active
        scope_reset(mark)
        nodes[s] = nodes[body]
        return
    # (a quantity constant ensure_global settled, used before its module's own code ran)
    if (k == .vardecl or k == .const_) and has_flag(s, NF_CHECKED): return
    if k == .vardecl: check_vardecl(s)
    else if k == .const_:
        g = Global(name = nodes[s].name, decl = 0, mod = i32(cur_mod()), is_const = true, state = 2)
        t = 0
        if nodes[s].a != 0: t = resolve_type(int(nodes[s].a))
        cl = clone(int(nodes[s].b))
        et = check_expr(cl, t)
        cl = last_checked
        if t != 0: cl = coerce(cl, t)
        else if has_flag(cl, NF_LITERAL): t = lit_default(cl)
        else: t = et
        g.type = i32(t)
        g.init = nodes[s].b
        globals.push(g)
        push_scope_sym(int(nodes[s].name), new_sym(int(nodes[s].name), .const_, globals.len() - 1, 0))
        nodes[s].kind = .block
        nodes[s].nlist = 0
    else if k == .assign and nodes[int(nodes[s].a)].kind == .hole and nodes[s].op == i32(int(Tok.assign)):
        # (_ = f(): the value made, and dropped on purpose)
        e = int(nodes[s].b)
        nodes[s] = Node(kind = .exprstmt, pos = nodes[s].pos, a = i32(e))
        discarding = true
        check_stmt(s)
        discarding = false
    else if k == .assign and assign_declares(s, -1):
        assign_to_decl(s)
        check_vardecl(s)
    else if k == .assign:
        check_late_global(s)
        r = check_assign(s)
        if r != s:
            nodes[s] = nodes[r]
    else if k == .exprstmt:
        if has_flag(s, NF_CHECKED): return
        e = int(nodes[s].a)
        if repl_sig_query and nodes[e].kind == .ident:
            # (`:type name` at the REPL, for a function: its versions as written, with their notes)
            sy = lookup(int(nodes[e].name))
            if sy != 0 and syms[sy].kind == .fns:
                ds: int[]
                collect_fns(int(nodes[e].name), ds)
                loop d in ds:
                    if len(repl_sig) > 0: repl_sig += "\n"
                    repl_sig += ide_fn_header(d)
                    doc = ide_doc_of(nodes[d].pos)
                    if len(doc) > 0: repl_sig += "\n    " + replace(doc, "\n", "\n    ")
                nodes[e] = Node(kind = .int_lit, pos = nodes[e].pos)
        if nodes[e].kind == .match_: add_flag(e, NF_STMT)
        named = nodes[e].kind == .ident or nodes[e].kind == .field
        raw = nodes[e]
        t = check_expr(e, 0)
        if named and (tkind(t) == .fn_ or tkind(t) == .cfn):
            nm = name_of(int(nodes[e].name))
            fatal(nodes[e].pos, "'{nm}' is a function and is not called here: `{nm}()` calls it")
        nodes[s].a = i32(last_checked)
        unused_result(last_checked, nodes[e].pos)
        unused_value(raw, t)
    else if k == .if_ or k == .iflet:
        add_flag(s, NF_STMT)
        check_expr(s, 0)
        if last_checked != s: nodes[s] = nodes[last_checked]
        if expectation_ifs.has(s): expectation_refuted(s)
    else if k == .while_:
        mark = scope_mark()
        enter_loop()
        if nodes[s].aux == 1:
            t = prune(check_expr(int(nodes[s].a), 0))
            nodes[s].a = i32(last_checked)
            if types[t].kind != .opt:
                nodes[s].a = i32(narrow_optional_source(int(nodes[s].a)))
                t = prune(ntype(int(nodes[s].a)))
            if types[t].kind != .opt: fatal(nodes[int(nodes[s].a)].pos, "'loop let x = value' needs an optional value, found {dt(t)}")
            nodes[s].sym = i32(new_local(int(nodes[s].name), int(types[t].elem), nodes[s].pos))
        else:
            ct = check_expr(int(nodes[s].a), T_BOOL)
            if tkind(ct) == .array or nodes[int(nodes[s].a)].kind == .range: fatal(nodes[s].pos, jd(nodes[s].pos, "`loop cond:` repeats while cond is true; to go through a range or an array, name the element: `loop i in [0..n):` (`loop _ in` when it is not used)", "`loop cond \{ }` repeats while cond is true; to go through a range or an array, name the element: `loop i in [0..n) \{ }` (`loop _ in` when it is not used)"))
            nodes[s].a = i32(coerce(last_checked, T_BOOL))
            # The body runs only after its guard succeeds. Assignment still
            # invalidates these aliases, just as it does inside an if arm.
            narrow_by(int(nodes[s].a), true)
        check_loop_enter(s)
        check_block(int(nodes[s].b), 0, false)
        check_loop_leave(s)
        loop_serials.pop()
        scope_reset(mark)
    else if k == .for_: check_for(s)
    else if k == .return_:
        inst = int(ctxs[cx].inst)
        if fns[inst].kind == FK_INIT and ctxs[cx].parent < 0: fatal(nodes[s].pos, "'return' outside of a function")
        ret = int(ctxs[cx].ret)
        if nodes[s].a != 0:
            if ctxs[cx].infer_ret and tkind(ret) == .var:
                t = check_expr(int(nodes[s].a), 0)
                nodes[s].a = i32(last_checked)
                if has_flag(int(nodes[s].a), NF_LITERAL):
                    t = lit_default(int(nodes[s].a))
                    nodes[s].a = i32(coerce(int(nodes[s].a), t))
                unify(ret, t)
            else:
                rt = prune(ret)
                if tkind(rt) == .void_: fatal(nodes[s].pos, "this function does not return a value")
                check_expr(int(nodes[s].a), rt)
                nodes[s].a = i32(coerce(last_checked, rt))
        else:
            rt = prune(ret)
            if tkind(rt) == .var: unify(rt, T_VOID)
            else if union_has_void(rt):
                # (a bare return in a `:>void | E` function gives its void member)
                check_expr(bc_block([], nodes[s].pos), rt)
                nodes[s].a = i32(coerce(last_checked, rt))
            else if tkind(rt) != .void_: fatal(nodes[s].pos, "missing return value (function returns {dt(rt)})")
    else if k == .break_ or k == .continue_:
        if ctxs[cx].loop_depth == 0:
            w = "continue"
            if k == .break_: w = "break"
            fatal(nodes[s].pos, "'{w}' outside of a loop")
        if nodes[s].name != 0:
            target = -1
            loop item in loop_labels:
                if item.0 == cx and item.1 == int(nodes[s].name): target = item.2
            if target < 0: fatal(nodes[s].pos, "unknown loop label '${name_of(int(nodes[s].name))}'")
            nodes[s].ival = int(ctxs[cx].loop_depth) - target
        narrow_jumps.push(NarrowJump(i32(cx), ctxs[cx].loop_depth - i32(nodes[s].ival)))
    else if k == .defer_:
        if refine_active and ref_mutable_result(int(ctxs[cx].inst)):
            fatal(nodes[s].pos, "projected mutable postconditions with deferred cleanup are not yet supported")
        d = int(nodes[s].a)
        if nodes[d].kind == .block: check_block(d, 0, false)
        else: check_stmt(d)
    else if k == .when_:
        blk = int(nodes[s].c)
        if const_eval_bool(int(nodes[s].a)): blk = int(nodes[s].b)
        if blk == 0:
            nodes[s].kind = .block
            nodes[s].nlist = 0
            return
        loop i in [0..nkids(blk)): check_stmt(kid(blk, i))
        nodes[s].kind = .block
        nodes[s].list = nodes[blk].list
        nodes[s].nlist = nodes[blk].nlist
        nodes[s].aux = 5
    else if k == .block: check_block(s, 0, false)
    else if k == .fn_ or k == .struct_ or k == .enum_ or k == .import_: fatal(nodes[s].pos, "declarations are only allowed at the top level")
    else if k == .test_ or k == .build_: pass
    else: fatal(nodes[s].pos, "invalid statement")

# (a generic instance's body: an error in the library's code is reported at the program's call)
check_fn_body = (f: int):
    if pc_missing.has(f): pc_restore(f)
    if fns[f].state != 0: return
    if fns[f].targs.len() == 0 or fns[f].decl == 0:
        # (an ordinary function's body: not part of the generic instance that led to it)
        if err_trail.len() == 0: __check_fn_body(f)
        else:
            trail = err_trail
            tnames = err_trail_names
            fs = err_trail_fns
            err_trail = []
            err_trail_names = []
            err_trail_fns = []
            __check_fn_body(f)
            err_trail = trail
            err_trail_names = tnames
            err_trail_fns = fs
        return
    # (the calls that led here, outermost first, even when this body is checked later)
    chain: int[]
    g = f
    loop g > 0 and chain.len() < 32 and fns[g].targs.len() > 0 and fns[g].decl != 0:
        chain.insert(0, g)
        g = int(fns[g].made_in)
    loop g2 in chain:
        err_trail.push(fns[g2].use_pos)
        err_trail_names.push(name_of(int(nodes[int(fns[g2].decl)].name)))
        err_trail_fns.push(g2)
    __check_fn_body(f)
    loop _ in chain:
        err_trail.pop()
        err_trail_names.pop()
        err_trail_fns.pop()

# Sparse preorder events for lowering's integer write proofs. Negative loop
# nodes close the enclosing-loop stack; nested closures contribute only their
# boundary. Save/restore around finalization, which can check other instances.
zonk_write_sites: int[]
zonk_collect_writes = false

__check_fn_body = (f: int):
    if fns[f].state != 0: return
    fns[f].state = 1
    decl = int(fns[f].decl)
    saved = cx
    ctxs.push(FnCtx(i32(f), -1, 0, false, 0, fns[f].mod, i32(sc_names.len())))
    cx = ctxs.len() - 1
    mark = scope_mark()
    if decl != 0 and nodes[decl].kind == .fn_:
        push_type_params(decl, fns[f].targs)
        loop i in [0..fns[f].ptypes.len()):
            p = kid(decl, i)
            l = new_local(int(nodes[p].name), fns[f].ptypes[i], nodes[p].pos)
            fl = LF_PARAM
            if has_flag(p, NF_MUT): fl |= LF_MUTPARAM
            locals[l].flags = i32(fl)
            fns[f].params.push(l)
    if decl != 0 and (has_flag(decl, NF_EXTERN) or ide_skip.len() > 0 and ide_skip.get(nodes[decl].pos) != none):
        if fns[f].ret == 0: fns[f].ret = i32(T_NEVER)
        fns[f].state = 2
        scope_reset(mark)
        ctxs.pop()
        cx = saved
        return
    if fns[f].ret != 0: ctxs[cx].ret = fns[f].ret
    else:
        ctxs[cx].ret = i32(mk_var())
        ctxs[cx].infer_ret = true
    body = int(fns[f].body)
    if fns[f].kind == FK_INIT:
        loop i in [0..nkids(body)): check_stmt(kid(body, i))
        fns[f].ret = i32(T_VOID)
    else:
        infer = ctxs[cx].infer_ret
        want = infer or tkind(int(ctxs[cx].ret)) != .void_
        exp = 0
        if not infer: exp = int(ctxs[cx].ret)
        bt = check_block(body, exp, want)
        r = prune(int(ctxs[cx].ret))
        n = nkids(body)
        if infer:
            if types[r].kind == .var:
                if nodes[body].aux != 0:
                    v = block_value(body)
                    if has_flag(v, NF_LITERAL):
                        bt = lit_default(v)
                        set_block_value(body, coerce(v, bt))
                    unify(r, bt)
                # (die = (msg: str): eprint(msg); exit(2): no return, its last line never
                # returns: neither does it, so a call ends its branch as exit's does)
                else if n > 0 and decl != 0 and nodes[decl].kind == .fn_ and stmt_terminates(kid(body, n - 1)) and not __never_skip(decl): unify(r, T_NEVER)
                else: unify(r, T_VOID)
            else if types[r].kind == .void_: nodes[body].aux = 0
            else if nodes[body].aux != 0: set_block_value(body, coerce(block_value(body), r))
            else if bt != T_NEVER and not (n > 0 and stmt_terminates(kid(body, n - 1))):
                fatal(nodes[decl].pos, "function must return a value of type {dt(r)} on all paths")
            fns[f].ret = i32(zonk(int(ctxs[cx].ret)))
            if ide_on and decl != 0 and nodes[decl].kind == .fn_ and ide_indexed(pos_file(nodes[decl].pos)): ide_hint_fns.push(f)
            if fns[f].aux_void and tkind(int(fns[f].ret)) != .void_: fatal(nodes[decl].pos, "recursive function '{name_of(int(nodes[decl].name))}' returns a value; add an explicit return type ({jd(nodes[decl].pos, "`-> Type`", "`:>Type`")})")
        else if want:
            if nodes[body].aux != 0: set_block_value(body, coerce(block_value(body), r))
            else if bt != T_NEVER and not (n > 0 and stmt_terminates(kid(body, n - 1))) and void_arm_end(body, r): pass
            else if bt != T_NEVER and not (n > 0 and stmt_terminates(kid(body, n - 1))):
                p = nodes[body].pos
                if decl != 0: p = nodes[decl].pos
                # (total = a + b as the last line: total is made, and not given back)
                if n > 0:
                    ls = kid(body, n - 1)
                    vn = ""
                    if nodes[ls].kind == .vardecl and nodes[ls].name > 0: vn = name_of(int(nodes[ls].name))
                    else if nodes[ls].kind == .assign and nodes[ls].a != 0 and nodes[int(nodes[ls].a)].kind == .ident: vn = name_of(int(nodes[int(nodes[ls].a)].name))
                    if len(vn) > 0:
                        fatal(nodes[ls].pos, "the function gives back {a_type(r)}, but its last line gives nothing: a last line `{vn}` gives {vn} back")
                    # (if n > 0: x, with no else: nothing when it does not hold)
                    if (nodes[ls].kind == .if_ or nodes[ls].kind == .iflet) and nodes[ls].c == 0:
                        fatal(nodes[ls].pos, "the function gives back {a_type(r)}, but an `if` without `else` gives nothing when it does not hold: add {jd(nodes[ls].pos, "`else:` and the value then", "`else` and the value then")}")
                    fatal(nodes[ls].pos, "the function gives back {a_type(r)}, but its last line gives nothing: end it with the value to give back (or `return value`)")
                fatal(p, "missing return value: function returns {dt(r)}")
    index_mark = zonk_indexes
    global_mark = zonk_user_globals
    saved_sites = zonk_write_sites
    saved_collect = zonk_collect_writes
    zonk_write_sites = []
    zonk_collect_writes = false
    # Other functions retain the demanded lowering walk. No proof is needed
    # merely because a body contains arithmetic or a read-only integer.
    if fns[f].kind == FK_NORMAL:
        loop l in fns[f].locals:
            if prune(int(locals[l].type)) == T_MATH_INT and int(locals[l].flags) & LF_ASSIGNED != 0: zonk_collect_writes = true
    zonk_tree(body)
    fns[f].write_sites = zonk_write_sites
    fns[f].writes_ready = zonk_collect_writes
    zonk_write_sites = saved_sites
    zonk_collect_writes = saved_collect
    fns[f].no_indexes = fns[f].kind == FK_NORMAL and zonk_indexes == index_mark
    fns[f].no_user_globals = fns[f].kind == FK_NORMAL and zonk_user_globals == global_mark
    loop l in fns[f].locals:
        locals[l].type = i32(zonk(int(locals[l].type)))
        if has_var(prune(int(locals[l].type))):
            ln = name_of(int(locals[l].name))
            # (a variable the compiler made, as for a loop: said of what it holds)
            if len(ln) == 0 or starts_with(ln, "__"): fatal(locals[l].pos, "cannot infer the type of what this goes through: write the type where the array is made, as {jd(locals[l].pos, "`xs: int[] = []`", "`let xs:array<int64> = []`")}")
            fatal(locals[l].pos, "cannot infer the type of '{ln}'; add a type annotation{empty_hint(ln, int(locals[l].type))}")
    copy_write_warnings(f)
    fns[f].state = 2
    scope_reset(mark)
    ctxs.pop()
    cx = saved


# the variable at the bottom of a place (v in v.f[2].g), or 0
place_root = (n: int) -> int:
    r = n
    loop r != 0 and (nodes[r].kind == .field or nodes[r].kind == .index): r = int(nodes[r].a)
    if r != 0 and nodes[r].kind == .ident: return r
    0

warn_unused_copy = (pos: int, name: str):
    alias = if files[pos_file(pos)].is_dewy: "loop @e in xs" else: "loop mut e in xs"
    warn(pos, "'{name}' is changed here but never read: it holds a copy (structs and arrays are values), so what it was copied from stays as it was; change that instead (`xs[i].hp -= 5`, `{alias}`)")

# a function's variables whose fields or elements it changes but whose value it never reads: a
# copy changed for nothing (`if let e = enemies.find(...): e.hp -= 5` leaves the enemy as it was)
copy_write_warnings = (f: int):
    if poly_families.len() > 1 and poly_pending_warnings.get(f) == true: return
    unused_local_warnings(f)
    if copy_writes.len() == 0: return
    skip = LF_READ | LF_PARAM | LF_MUTPARAM | LF_CAPTURE | LF_CAPTURED | LF_ADDR | LF_ALIAS | LF_BYREF | LF_ELEMALIAS | LF_SOAELEM | LF_SHARED
    loop l in fns[f].locals:
        if not copy_writes.has(l) or int(locals[l].flags) & skip != 0: continue
        nm = name_of(int(locals[l].name))
        if starts_with(nm, "#") or starts_with(nm, "$") or starts_with(nm, "__") or pos_in_lib(locals[l].pos): continue
        warn_unused_copy(copy_writes[l], nm)

# how many times w appears in src as a whole word
word_count = (src: str, w: str) -> int:
    n = 0
    i = find(src, w)
    loop i >= 0:
        before = i == 0 or not (is_alnum(src[i - 1]) or src[i - 1] == '_')
        e = i + len(w)
        after = e >= len(src) or not (is_alnum(src[e]) or src[e] == '_')
        if before and after and not in_comment(src, i): n += 1
        i = find(src, w, i + 1)
    n

# (a `#` before i on its line, outside quotes)
in_comment = (src: str, i: int) -> bool:
    s = i
    loop s > 0 and src[s - 1] != '\n': s -= 1
    quoted = false
    loop k in [s..i):
        if src[k] == '"': quoted = not quoted
        else if src[k] == '#' and not quoted: return true
    false

# Dewy suggestions use names visible here, including explicit import aliases.
# A similarly named global in an unrelated loaded file is not a useful hint.
dewy_unused_name_hint = (name: str, module: int) -> str:
    if module < 0 or modules[module].is_prelude or len(name) < 3: return ""
    limit = if len(name) >= 6: 2 else: 1
    loop nm, sym in modules[module].names:
        if syms[sym].kind != .global or globals[int(syms[sym].ref)].is_const or lookup(nm) != sym: continue
        candidate = name_of(nm)
        if candidate == name or len(candidate) == 0 or candidate[0] != name[0]: continue
        if candidate == upper(candidate) or lower(candidate) == lower(name): continue
        if edit_distance(candidate, name, limit) <= limit:
            return " (did you mean the visible variable '{candidate}'?)"
    ""

# (scor = 1 in a function, for the global score: a variable of its own, made and never read)
unused_local_warnings = (f: int):
    skip = LF_READ | LF_PARAM | LF_MUTPARAM | LF_CAPTURE | LF_CAPTURED | LF_ADDR | LF_ALIAS | LF_BYREF | LF_ELEMALIAS | LF_SOAELEM | LF_SHARED | LF_QUIET
    loop l in fns[f].locals:
        fl = int(locals[l].flags)
        if fl & LF_DECL == 0 or fl & skip != 0 or copy_writes.has(l): continue
        nm = name_of(int(locals[l].name))
        # Dewy desugaring uses reserved $ names for evaluation-order captures.
        # Their values may be overridden; they are not bindings the user can fix.
        if len(nm) == 0 or starts_with(nm, "_") or starts_with(nm, "#") or starts_with(nm, "$") or pos_in_lib(locals[l].pos): continue
        near = ""
        if files[pos_file(locals[l].pos)].is_dewy:
            m = int(fns[f].mod)
            near = dewy_unused_name_hint(nm, m)
            if len(near) == 0 and m >= 0:
                loop used in modules[m].uses:
                    near = dewy_unused_name_hint(nm, used)
                    if len(near) > 0: break
        else:
            loop gi in [0..globals.len()):
                gn = name_of(int(globals[gi].name))
                lim = 1
                if len(nm) >= 6: lim = 2
                if gn != nm and len(nm) >= 3 and len(gn) > 0 and gn[0] == nm[0] and not globals[gi].is_const and not modules[int(globals[gi].mod)].is_prelude and gn != upper(gn) and lower(gn) != lower(nm) and edit_distance(gn, nm, lim) <= lim:
                    near = " (did you mean the variable '{gn}'? that one is changed by writing its name exactly)"
                    break
                # (the global of a file this one does not use: the assignment made a variable of the
                # function's own instead of changing it)
                gf = int(modules[int(globals[gi].mod)].file)
                lf = pos_file(locals[l].pos)
                if gn == nm and not modules[int(globals[gi].mod)].is_prelude and gf >= 0 and lf >= 0 and gf != lf:
                    # (as `use` would name it from here)
                    shown = files[gf].path
                    if starts_with(shown, files[lf].dir + "/"): shown = shown[len(files[lf].dir) + 1..]
                    near = ": it is a variable of this function's own, as the global '{gn}' of {shown} is not seen from this file (`use '{shown}'` at its top lets it change that one)"
                    break
        # (score = 0 in update, then score += 1: it starts again each frame, and nothing reads it)
        fnm = ""
        if fns[f].decl != 0 and nodes[int(fns[f].decl)].kind == .fn_: fnm = name_of(int(nodes[int(fns[f].decl)].name))
        if fl & LF_ASSIGNED != 0 and len(near) == 0 and (fnm == "update" or fnm == "draw"):
            warn(locals[l].pos, "'{nm}' starts again here each frame, as a variable made in {fnm} belongs to that one run, and is never read: to keep it from frame to frame, give it its first value at the top of the file, outside the functions")
        else if fl & LF_ASSIGNED != 0 and len(near) == 0: warn(locals[l].pos, "'{nm}' is given a value here, and changed, but never read")
        else: warn(locals[l].pos, "'{nm}' is given a value here but never used{near}")

check_lambda_body = (f: int, lam: int, ret_hint: int):
    fns[f].state = 1
    parent = cx
    ctxs.push(FnCtx(i32(f), i32(parent), 0, false, 0, ctxs[parent].mod, ctxs[parent].floor))
    cx = ctxs.len() - 1
    mark = scope_mark()
    if has_flag(lam, NF_GENERIC): push_type_params(lam, fns[f].targs)
    loop original in lambda_captures(lam):
        cap = if has_flag(lam, NF_GENERIC): clone(original) else: original
        nm = int(nodes[cap].name)
        s = lookup(nm)
        # Folded lexical constants need no environment slot, but they are
        # still valid explicit captures. Keep the capture declaration intact.
        if s != 0 and syms[s].kind == .const_ and nm < sc_top.len() and sc_top[nm] >= int(ctxs[cx].floor) and sc_syms[sc_top[nm]] == s:
            check_expr(clone(cap), 0)
            continue
        check_expr(cap, 0)
        local = 0
        if nodes[cap].kind == .ident and nodes[cap].aux == i32(int(SK.local)):
            local = int(nodes[cap].sym)
            loop narrowed_var(local) != 0: local = narrowed_var(local)
        if local == 0 or int(locals[local].flags) & LF_CAPTURE == 0:
            fatal(nodes[cap].pos, "a capture must name an enclosing local variable")
    loop i in [0..fns[f].ptypes.len()):
        p = kid(lam, i)
        l = new_local(int(nodes[p].name), fns[f].ptypes[i], nodes[p].pos)
        fl = LF_PARAM
        if has_flag(p, NF_MUT): fl |= LF_MUTPARAM
        locals[l].flags = i32(fl)
        fns[f].params.push(l)
    declared = 0
    old_formals = refine_formals
    old_self = refine_self
    if refine_active:
        refine_formals = []
        refine_self = 0
        loop p in kids(lam): refine_formals.push(int(nodes[p].name))
    if nodes[lam].a != 0: declared = resolve_type(int(nodes[lam].a))
    else if has_flag(lam, NF_VOID): declared = T_VOID
    refine_formals = old_formals
    refine_self = old_self
    if refine_active: ref_validate_signature(fns[f].ptypes, declared, ref_decl_mask(lam), nodes[lam].pos)
    if declared != 0: ctxs[cx].ret = i32(declared)
    else if ret_hint != 0 and not has_var(prune(ret_hint)): ctxs[cx].ret = i32(ret_hint)
    else:
        if ret_hint != 0: ctxs[cx].ret = i32(ret_hint)
        else: ctxs[cx].ret = i32(mk_var())
        ctxs[cx].infer_ret = true
    body = int(fns[f].body)
    infer = ctxs[cx].infer_ret
    want = infer or tkind(int(ctxs[cx].ret)) != .void_
    exp = 0
    if not infer: exp = int(ctxs[cx].ret)
    bt = check_block(body, exp, want)
    r = prune(int(ctxs[cx].ret))
    if infer:
        if types[r].kind == .var:
            if nodes[body].aux != 0:
                v = block_value(body)
                if has_flag(v, NF_LITERAL):
                    bt = lit_default(v)
                    set_block_value(body, coerce(v, bt))
                if not unify(r, bt): fatal(nodes[body].pos, "lambda returns {dt(bt)}, expected {dt(r)}")
            else: unify(r, T_VOID)
        else if types[r].kind == .void_: nodes[body].aux = 0
        else if nodes[body].aux != 0: set_block_value(body, coerce(block_value(body), r))
        else if bt != T_NEVER and not void_arm_end(body, r): fatal(nodes[body].pos, "lambda must return a value of type {dt(r)}")
    else if want:
        if nodes[body].aux != 0: set_block_value(body, coerce(block_value(body), r))
        else if bt != T_NEVER and not void_arm_end(body, r): fatal(nodes[body].pos, "lambda must return a value of type {dt(r)}")
    else: nodes[body].aux = 0
    fns[f].ret = ctxs[cx].ret
    fns[f].state = 2
    scope_reset(mark)
    ctxs.pop()
    cx = parent

# a call of the function `name` with no arguments, anywhere in n but inside function literals
calls_named = (n: int, name: str) -> bool:
    if n == 0: return false
    k = nodes[n].kind
    if k == .lambda or k == .fn_: return false
    if k == .call and nkids(n) == 0 and nodes[n].a != 0 and nodes[int(nodes[n].a)].kind == .ident and name_of(int(nodes[int(nodes[n].a)].name)) == name: return true
    if calls_named(int(nodes[n].a), name) or calls_named(int(nodes[n].b), name): return true
    if k != .for_ and calls_named(int(nodes[n].c), name): return true
    loop i in [0..nkids(n)):
        if calls_named(kid(n, i), name): return true
    false

# (enemies = [] at the top level, filled by a function: that function is checked first, so the
# type of what it pushes is known where enemies is read)
check_pushers_first = ():
    names: {int: bool}
    loop m in modules:
        if m.is_prelude: continue
        loop d in m.decls:
            if nodes[d].kind == .vardecl and nodes[d].nlist == 0 and nodes[d].a == 0 and nodes[d].b != 0 and nodes[int(nodes[d].b)].kind == .array and nkids(int(nodes[d].b)) == 0: names[int(nodes[d].name)] = true
    if names.len() == 0: return
    loop m in modules:
        if m.is_prelude: continue
        loop d in m.decls:
            if nodes[d].kind == .fn_ and not has_flag(d, NF_EXTERN) and nodes[d].b != 0 and pushes_into(int(nodes[d].b), names) and not fn_sig(d).generic:
                f = get_fn_inst(d, [], nodes[d].pos)
                # (before the top level's code, too, which may read it)
                if fns[f].state == 0: check_fn_body(f)

pushes_into = (n: int, names: {int: bool}) -> bool:
    if n == 0: return false
    k = nodes[n].kind
    if k == .call and nkids(n) == 1:
        f = int(nodes[n].a)
        if f != 0 and nodes[f].kind == .field and name_of(int(nodes[f].name)) == "push":
            r = int(nodes[f].a)
            if r != 0 and nodes[r].kind == .ident and names.has(int(nodes[r].name)): return true
    if pushes_into(int(nodes[n].a), names) or pushes_into(int(nodes[n].b), names): return true
    if k != .for_ and pushes_into(int(nodes[n].c), names): return true
    loop i in [0..nkids(n)):
        if pushes_into(kid(n, i), names): return true
    false

# the open globals' types, now that every function is checked: each is settled, or an error;
# what was checked before it was settled sees its type now
settle_open_globals = ():
    loop g in open_globals:
        t = zonk(int(globals[g].type))
        if has_var(t):
            nm = name_of(int(globals[g].name))
            fatal(nodes[int(globals[g].decl)].pos, "cannot infer the type of '{nm}' (nothing is put in it); add a type annotation{empty_hint(nm, t)}")
        globals[g].type = i32(t)
    loop fi in [1..fns.len()):
        if fns[fi].state != 2: continue
        zonk_tree(int(fns[fi].body))
        loop l in fns[fi].locals: locals[l].type = i32(zonk(int(locals[l].type)))
        loop mut x in fns[fi].ptypes: x = zonk(x)
        loop mut x in fns[fi].targs: x = zonk(x)
        if fns[fi].ret != 0: fns[fi].ret = i32(zonk(int(fns[fi].ret)))
        if fns[fi].fntype != 0: fns[fi].fntype = i32(zonk(int(fns[fi].fntype)))
    loop g in [0..globals.len()):
        if globals[g].type != 0: globals[g].type = i32(zonk(int(globals[g].type)))
        if globals[g].decl != 0: zonk_tree(int(globals[g].decl))

# Count index nodes during the existing finalization walk. A negative summary
# lets lowering avoid path proofs that cannot discover an indexed array.
# Likewise, normal bodies without user globals or narrowed aliases cannot
# disprove closed-program ownership. Init/lambda bodies remain unsummarized.
zonk_indexes = 0
zonk_user_globals = 0

zonk_tree = (n: int):
    if n == 0: return
    if nodes[n].type != 0: nodes[n].type = i32(zonk(int(nodes[n].type)))
    k = nodes[n].kind
    if k == .index: zonk_indexes += 1
    if k == .ident:
        if nodes[n].aux == i32(int(SK.global)):
            if not modules[int(globals[int(nodes[n].sym)].mod)].is_prelude: zonk_user_globals += 1
        else if nodes[n].aux == i32(int(SK.local)) and int(locals[int(nodes[n].sym)].flags) & LF_ALIAS != 0:
            # Narrowed locals may hide a reference to global storage.
            zonk_user_globals += 1
    # Unlike zonking, the write walk stops at function templates. Keep the
    # fallback for a body containing one instead of recording its children.
    if k == .fn_: zonk_collect_writes = false
    if zonk_collect_writes:
        if k == .vardecl or k == .assign or k == .for_ or k == .while_ or k == .lambda or k == .return_ or k == .break_ or k == .continue_: zonk_write_sites.push(n)
    if k == .lambda: return
    zonk_tree(int(nodes[n].a))
    zonk_tree(int(nodes[n].b))
    if k != .for_:
        zonk_tree(int(nodes[n].c))
        if k != .partial: zonk_tree(int(nodes[n].d))
    loop i in [0..nkids(n)): zonk_tree(kid(n, i))
    loop i in [0..nkids2(n)): zonk_tree(kid2(n, i))
    if zonk_collect_writes and (k == .for_ or k == .while_): zonk_write_sites.push(-n)

# ---------------- compile-time evaluation ----------------
struct CVal:
    is_str: bool
    i: int
    s: str

ceval = (e: int) -> CVal:
    k = nodes[e].kind
    if nodes[e].type != 0 or k == .call or k == .index or k == .field or k == .unary:
        checked = e
        if nodes[e].type == 0:
            check_expr(e, 0)
            checked = last_checked
            finalize_literal(checked)
        value = ct_values[ct_run(checked)]
        return CVal(tkind(value.type) == .str_, value.i, value.s)
    if k == .bool_lit or k == .int_lit: return CVal(false, nodes[e].ival, "")
    if k == .str_lit: return CVal(true, 0, name_of(int(nodes[e].sval)))
    if k == .ident:
        initial = 0
        if nodes[e].type != 0 and (nodes[e].aux == i32(int(SK.local)) or nodes[e].aux == i32(int(SK.global))):
            initial = binding_const_init(nodes[e].aux as SK, int(nodes[e].sym), nodes[e].pos)
        else:
            s = lookup(int(nodes[e].name))
            if s != 0: initial = binding_const_init(syms[s].kind, int(syms[s].ref), nodes[e].pos)
        if initial == 0: fatal(nodes[e].pos, "'{name_of(int(nodes[e].name))}' is not a compile-time constant")
        return ceval(initial)
    if k == .not_:
        v = ceval(int(nodes[e].a))
        r = 0
        if v.i == 0: r = 1
        return CVal(false, r, "")
    if k == .and_:
        a = ceval(int(nodes[e].a))
        if a.i == 0: return a
        return ceval(int(nodes[e].b))
    if k == .or_:
        a = ceval(int(nodes[e].a))
        if a.i != 0: return a
        return ceval(int(nodes[e].b))
    if k == .binary:
        a = ceval(int(nodes[e].a))
        b = ceval(int(nodes[e].b))
        op = nodes[e].op as Tok
        if a.is_str or b.is_str:
            eq = a.is_str == b.is_str and a.s == b.s
            if op == .eq: return CVal(false, int(eq), "")
            if op == .ne: return CVal(false, int(not eq), "")
            fatal(nodes[e].pos, "invalid operator on strings in compile-time expression")
        r = 0
        if op == .eq: r = int(a.i == b.i)
        else if op == .ne: r = int(a.i != b.i)
        else if op == .lt: r = int(a.i < b.i)
        else if op == .le: r = int(a.i <= b.i)
        else if op == .gt: r = int(a.i > b.i)
        else if op == .ge: r = int(a.i >= b.i)
        else if op == .plus: r = a.i + b.i
        else if op == .minus: r = a.i - b.i
        else if op == .star: r = a.i * b.i
        else if op == .slash and b.i != 0: r = a.i / b.i
        else if op == .shl: r = if dewy_at(nodes[e].pos) and (b.i >= 64 or b.i < 0): 0 else: a.i << b.i
        else: fatal(nodes[e].pos, "unsupported operator in compile-time expression")
        return CVal(false, r, "")
    fatal(nodes[e].pos, "expression is not a compile-time constant")
    CVal(false, 0, "")

const_eval_bool = (e: int) -> bool: ceval(e).i != 0

# ---------------- static assertions ----------------
# Closed `$assert` requests keep this constant/evaluator fast path. facts.jo
# queues open scalar requests until checked bodies and helpers have settled;
# runtime values never fall through from a failed fact query into ct_run.
# sa_blocker is the first part that left a constant value unknown.
struct SVal:
    known: bool
    is_str: bool
    i: int
    s: str

sa_blocker = 0

sa_unknown = (e: int) -> SVal:
    if sa_blocker == 0: sa_blocker = e
    SVal(false, false, 0, "")

sa_int = (v: int) -> SVal: SVal(true, false, v, "")

# A 64-bit signed operand: arithmetic folds only when it cannot wrap.
sa_wide_signed = (e: int) -> bool:
    t = prune(int(nodes[e].type))
    t != 0 and types[t].kind == .int_ and types[t].sign and int(types[t].bits) == 64

sa_unsigned = (e: int) -> bool:
    t = prune(int(nodes[e].type))
    t != 0 and types[t].kind == .int_ and not types[t].sign

sa_fits = (v: int, t0: int) -> bool:
    t = prune(t0)
    if t == 0: return false
    if types[t].kind != .int_: return types[t].kind == .bool_
    bits = int(types[t].bits)
    if bits >= 64: return types[t].sign or v >= 0
    if types[t].sign: return v >= -(1 << (bits - 1)) and v < (1 << (bits - 1))
    v >= 0 and v < (1 << bits)

static_value = (e: int) -> SVal:
    k = nodes[e].kind
    if k == .bool_lit or k == .int_lit: return sa_int(nodes[e].ival)
    if k == .str_lit and nodes[e].aux == 0: return SVal(true, true, 0, name_of(int(nodes[e].sval)))
    if k == .ident:
        initial = 0
        if nodes[e].type != 0 and (nodes[e].aux == i32(int(SK.local)) or nodes[e].aux == i32(int(SK.global))):
            initial = binding_const_init(nodes[e].aux as SK, int(nodes[e].sym), nodes[e].pos)
        else:
            s = lookup(int(nodes[e].name))
            if s != 0: initial = binding_const_init(syms[s].kind, int(syms[s].ref), nodes[e].pos)
        if initial == 0: return sa_unknown(e)
        return static_value(initial)
    if k == .conv:
        v = static_value(int(nodes[e].a))
        if not v.known or v.is_str: return v
        if nodes[e].aux != i32(int(CV.int_)) or not sa_fits(v.i, int(nodes[e].type)): return sa_unknown(e)
        return v
    if k == .unary and nodes[e].op == i32(int(Tok.minus)):
        v = static_value(int(nodes[e].a))
        if not v.known: return v
        if not sa_wide_signed(e) or v.i == -9223372036854775807 - 1: return sa_unknown(e)
        return sa_int(-v.i)
    if k == .not_:
        v = static_value(int(nodes[e].a))
        if not v.known: return v
        return sa_int(if v.i == 0: 1 else: 0)
    if k == .and_ or k == .or_:
        a = static_value(int(nodes[e].a))
        b = static_value(int(nodes[e].b))
        decisive = if k == .and_: 0 else: 1
        if a.known and (a.i != 0) == (decisive == 1): return sa_int(decisive)
        if b.known and (b.i != 0) == (decisive == 1): return sa_int(decisive)
        if a.known and b.known: return sa_int(1 - decisive)
        return SVal(false, false, 0, "")
    if k == .istype:
        # (already narrowed to exactly this type: always true)
        if nodes[e].aux == -3: return sa_int(1)
        return sa_unknown(e)
    if k == .binary:
        a = static_value(int(nodes[e].a))
        b = static_value(int(nodes[e].b))
        if not a.known: return a
        if not b.known: return b
        op = nodes[e].op as Tok
        if a.is_str or b.is_str:
            if a.is_str != b.is_str: return sa_unknown(e)
            if op == .eq: return sa_int(int(a.s == b.s))
            if op == .ne: return sa_int(int(a.s != b.s))
            return sa_unknown(e)
        if op == .eq: return sa_int(int(a.i == b.i))
        if op == .ne: return sa_int(int(a.i != b.i))
        if op == .lt or op == .le or op == .gt or op == .ge:
            # Order unsigned words by their unsigned values.
            x = a.i
            y = b.i
            if sa_unsigned(int(nodes[e].a)):
                x = x xor (-9223372036854775807 - 1)
                y = y xor (-9223372036854775807 - 1)
            if op == .lt: return sa_int(int(x < y))
            if op == .le: return sa_int(int(x <= y))
            if op == .gt: return sa_int(int(x > y))
            return sa_int(int(x >= y))
        if not sa_wide_signed(e): return sa_unknown(e)
        if op == .plus:
            r = a.i + b.i
            if ((a.i xor r) & (b.i xor r)) < 0: return sa_unknown(e)
            return sa_int(r)
        if op == .minus:
            r = a.i - b.i
            if ((a.i xor b.i) & (a.i xor r)) < 0: return sa_unknown(e)
            return sa_int(r)
        if op == .star:
            if a.i == 0 or b.i == 0: return sa_int(0)
            r = a.i * b.i
            if (a.i == -1 and b.i == -9223372036854775807 - 1) or (b.i == -1 and a.i == -9223372036854775807 - 1) or r / b.i != a.i: return sa_unknown(e)
            return sa_int(r)
        return sa_unknown(e)
    sa_unknown(e)

# 1 when the condition is proven, 0 when it is refuted, -1 when unknown.
static_truth = (e: int) -> int:
    sa_blocker = 0
    v = static_value(e)
    if not v.known: return -1
    if v.i != 0: 1 else: 0

# (an expectation the compiler refutes still builds: the test fails when it runs; `$expect false`
# is written to fail)
expectation_refuted = (s: int):
    c = int(nodes[s].a)
    if nodes[c].kind == .not_ and nodes[int(nodes[c].a)].kind == .bool_lit: return
    if static_truth(c) == 1: warn(nodes[s].pos, "this expectation always fails")

assertion_refuted = (cond: int, message: int):
    why = "this condition is always false"
    if message != 0 and nodes[message].kind == .str_lit and nodes[message].aux == 0: why = name_of(int(nodes[message].sval))
    fatal(nodes[cond].pos, "assertion refuted: {why}")

prove_assertion = (cond: int, message: int):
    truth = static_truth(cond)
    if truth == 1: return
    if truth == 0: assertion_refuted(cond, message)
    if ct_values[ct_run(cond)].i == 0: assertion_refuted(cond, message)

# the build: block of the main file, checked (main.jo's scan_build_block read it before checking
# began, to know the target: here its mistakes are errors with places)
check_build_block = ():
    if build_node == 0: return
    b = int(nodes[build_node].b)
    seen: str[]
    loop i in [0..nkids(b)):
        s = kid(b, i)
        if nodes[s].kind != .assign or nodes[int(nodes[s].a)].kind != .ident:
            fatal(nodes[s].pos, "a build option is `name = value` (target, opt or output)")
        key = name_of(int(nodes[int(nodes[s].a)].name))
        v = int(nodes[s].b)
        word = ""
        if nodes[v].kind == .ident: word = name_of(int(nodes[v].name))
        else if nodes[v].kind == .str_lit and nodes[v].aux == 0: word = name_of(int(nodes[v].sval))
        if seen.contains(key): fatal(nodes[s].pos, "build option '{key}' is set twice")
        seen.push(key)
        if nodes[v].kind == .call and nodes[int(nodes[v].a)].kind == .ident and name_of(int(nodes[int(nodes[v].a)].name)) == "package":
            # name = package("git URL or directory"[, "tag, branch or commit"]): pkg.jo
            if nkids(v) < 1 or nkids(v) > 2: fatal(nodes[v].pos, "a package is package(\"git URL or directory\") or package(\"git URL\", \"tag, branch or commit\")")
            loop k in [0..nkids(v)):
                if nodes[kid(v, k)].kind != .str_lit or nodes[kid(v, k)].aux != 0: fatal(nodes[kid(v, k)].pos, "package() takes strings in quotes")
            continue
        if key == "target":
            if word != "native" and word != "linux" and word != "linux-arm64" and word != "macos" and word != "windows" and word != "wasm":
                fatal(nodes[v].pos, "build option 'target' is native, linux, linux-arm64, macos, windows or wasm")
        else if key == "opt":
            if word != "debug" and word != "release": fatal(nodes[v].pos, "build option 'opt' is debug or release")
        else if key == "output":
            if nodes[v].kind != .str_lit or nodes[v].aux != 0 or len(word) == 0: fatal(nodes[v].pos, "build option 'output' is a file name in quotes: output = \"game\"")
        else if key == "icon":
            if nodes[v].kind != .str_lit or nodes[v].aux != 0 or len(word) == 0: fatal(nodes[v].pos, "build option 'icon' is a PNG file in quotes: icon = \"icon.png\"")
            path = word
            d = files[pos_file(nodes[v].pos)].dir
            if not is_abs_path(path) and len(d) > 0: path = "{d}/{path}"
            b: u8[]
            if let got = read_bytes(path): b = got
            if b.len() == 0: fatal(nodes[v].pos, "cannot read the icon '{path}'")
            if b.len() < 24 or b[0] != 0x89 or b[1] != 'P' or b[2] != 'N' or b[3] != 'G': fatal(nodes[v].pos, "the icon must be a PNG file ('{path}' is not one)")
            w = (int(b[16]) << 24) | (int(b[17]) << 16) | (int(b[18]) << 8) | int(b[19])
            h = (int(b[20]) << 24) | (int(b[21]) << 16) | (int(b[22]) << 8) | int(b[23])
            if w != h or w > 256: fatal(nodes[v].pos, "the icon must be square and at most 256 pixels wide ('{path}' is {w}x{h})")
            program_icon = b
            nodes[icon_node].sval = i32(intern(str_from_bytes(b)))
        else if key == "js":
            if nodes[v].kind != .str_lit or nodes[v].aux != 0 or len(word) == 0: fatal(nodes[v].pos, "build option 'js' is a JavaScript file in quotes: js = \"glue.js\" (for web builds: it gives their `extern` functions)")
            path = word
            d = files[pos_file(nodes[v].pos)].dir
            if not is_abs_path(path) and len(d) > 0: path = "{d}/{path}"
            if let t = read_file(path): program_js = t
            else: fatal(nodes[v].pos, "cannot read the JavaScript file '{path}'")
        else if key == "name":
            if nodes[v].kind != .str_lit or nodes[v].aux != 0 or len(word) == 0: fatal(nodes[v].pos, "build option 'name' is the program's name in quotes: name = \"Star Garden\"")
            loop c in word:
                if c == '/' or c == '\\' or c == ':' or c < ' ': fatal(nodes[v].pos, "the program's name is also its save folder's: it cannot contain / \\ or :")
        else:
            fatal(nodes[int(nodes[s].a)].pos, "unknown build option '{key}' (the options are target, opt, output, name and icon, and packages: name = package(\"git URL\"))")

# ---------------- program ----------------
runtime_memeq = -1            # private bounded memory comparison, native lowering
runtime_streq = -1            # private string equality, including nil/empty values
want_cpu_flag = false           # (x86-64 builds: the vectorizer may use __cpu_avx2)
want_loop_watch = false         # (debug web builds: loops count down to __loop_watchdog)
watch_build = false             # (built for `sloppy watch`: WATCH is true in the program)
runtime_names = ["__alloc", "__free", "__panic", "__panic_bounds", "__panic_slice", "__panic_unwrap", "__free_obj", "__arr_clone", "__arr_push_slot",
    "__arr_reserve", "__arr_insert_slot", "__arr_remove_slot", "__arr_slice", "__fixed_slice", "__arr_concat", "__str_concat", "__str_eq",
    "__str_cmp", "__str_slice", "__str_append", "__buf_finish", "__buf_append_str", "__arr_resize", "__arr_repeat", "__arr_filled",
    "__print_str", "__str_from_bytes", "__assert_fail", "__hash_bytes", "__str_hash", "__div_zero", "__rc_inc", "__rc_dec",
    "__arr_extend", "__arr_extend_raw", "__rc_dec_test", "__out_flush", "__end_flush", "__box_new", "__box_free", "__box_clone", "__box_defer", "__box_next"]
optional_runtime = ["__c_str", "__mat4_mul", "__mat4_mul_vec4", "__fmt_i32", "__fmt_f32", "__ffi_resolve", "__panic_narrow", "__ffi_missing", "__mac_syscall"]
runtime_insts: {str: int} = {}

runtime_fn = (name: str) -> int:
    if let f = runtime_insts.get(name): return f
    demand_prelude_name(intern(name))
    s = prelude.get(intern(name)) ?? 0
    if s == 0 or syms[s].kind != .fns: ice("missing runtime function {name}")
    f = get_fn_inst(int(syms[s].decl), [], nodes[int(syms[s].decl)].pos)
    runtime_insts[name] = f
    if starts_with(name, "__mi_"): check_pending_functions(f)
    f

add_universe = ():
    exception_builtins()
    tys = [("__dewy_int", T_MATH_INT), ("int", T_INT), ("i8", T_I8), ("i16", T_I16), ("i32", T_I32), ("i64", T_INT), ("u8", T_U8), ("byte", T_U8),
        ("u16", T_U16), ("u32", T_U32), ("u64", T_U64), ("f64", T_FLOAT), ("f32", T_F32),
        ("int8", T_I8), ("int16", T_I16), ("int32", T_I32), ("int64", T_INT),
        ("uint8", T_U8), ("uint16", T_U16), ("uint32", T_U32), ("uint64", T_U64),
        ("float32", T_F32), ("float64", T_FLOAT), ("string", T_STR),
        ("bool", T_BOOL), ("str", T_STR), ("void", T_VOID), ("vec2", T_VEC2), ("vec3", T_VEC3), ("vec4", T_VEC4),
        ("mat4", T_MAT4), ("ivec2", T_IVEC2), ("ivec3", T_IVEC3), ("ivec4", T_IVEC4)]
    loop t in tys:
        nm = intern(t.0)
        universe[nm] = new_sym(nm, .type_, t.1, 0)
    active = refine_active
    addr_atoms = [RefAtom(.le, RefTerm(1, 0), RefTerm()), RefAtom(.le, RefTerm(), RefTerm(1, ref_addr_max()))]
    ref_addr_type = mk_refined(T_INT, ref_intern(addr_atoms))
    universe[intern("addr")] = new_sym(intern("addr"), .type_, ref_addr_type, 0)
    refine_active = active
    tv = mk(.str_lit, 0)
    tgt = "linux"
    if target_wasm: tgt = "wasm"
    if target_windows: tgt = "windows"
    if target_macos: tgt = "macos"
    nodes[tv].sval = i32(intern(tgt))
    # (the processor: x86_64, arm64 or wasm32)
    av = mk(.str_lit, 0)
    arch = "x86_64"
    if target_wasm: arch = "wasm32"
    if target_arm64: arch = "arm64"
    nodes[av].sval = i32(intern(arch))
    tr = mk(.bool_lit, 0)
    nodes[tr].ival = 1
    fl = mk(.bool_lit, 0)
    wv = mk(.bool_lit, 0)
    if watch_build: nodes[wv].ival = 1
    pn = mk(.str_lit, 0)
    nodes[pn].sval = i32(intern(program_name))
    # (the icon's bytes: set by check_build_block)
    icon_node = mk(.str_lit, 0)
    nodes[icon_node].sval = i32(intern(""))
    consts = [("TARGET", tv, T_STR), ("ARCH", av, T_STR), ("DEBUG", tr, T_BOOL), ("BOOTSTRAP", fl, T_BOOL), ("WATCH", wv, T_BOOL), ("PROGRAM_NAME", pn, T_STR),
        ("PROGRAM_ICON", icon_node, T_STR)]
    loop c in consts:
        nm = intern(c.0)
        globals.push(Global(name = i32(nm), is_const = true, init = i32(c.1), state = 2, type = i32(c.2)))
        universe[nm] = new_sym(nm, .const_, globals.len() - 1, 0)
    register_quantity_names()
    register_intrinsics()

load_prelude = ():
    # all .jo files in lib/core, lib/std and lib/game are loaded into the shared prelude scope
    # (lib/core must stay compilable by the C bootstrap compiler; lib/std need not)
    read_prelude_index()
    loop sub in ["core", "std", "game"]:
        names_ = list_dir("{lib_dir}/{sub}")
        names_.sort()
        loop n in names_:
            if not ends_with(n, ".jo"): continue
            path = "{lib_dir}/{sub}/{n}"
            if sub == "game":
                if let entry = prelude_index.get(n):
                    if defer_prelude(path, entry): continue
            load_module(path, true, -1)
    # Keep existing fixed-width overloads first for widening ties. Separate from
    # the seed-scanned prelude: old seeds do not know the mathematical type.
    if file_exists(lib_dir + "/math_int.jo"): load_module(lib_dir + "/math_int.jo", true, -1)

dfs_state: bool[]
skip_main = false
export_decls: int[]
export_fns: int[]
order_modules = (m: int, out: mut int[]):
    if dfs_state[m]: return
    dfs_state[m] = true
    loop d in modules[m].decls:
        if nodes[d].kind == .import_:
            if nodes[d].aux == 2: order_modules(int(nodes[d].sym), out)
            else if nodes[d].aux == 1:
                loop u in modules[m].uses: order_modules(u, out)
            else if let s = modules[m].names.get(int(nodes[d].name)):
                if syms[s].kind == .module: order_modules(int(syms[s].ref), out)
    out.push(m)

# statement calling a prelude function with the given argument nodes
# a, b = xs with an array: its elements, as a tuple (__unpack2(xs): the length checked)
unpack_binding = (e: int, t: int, bindings: int[], pos: int) -> (int, int[]):
    if not files[pos_file(pos)].is_dewy: return (unpack_array(e, t, bindings.len(), pos), bindings)
    leaves = binding_leaves(bindings)
    nested = false
    annotated = false
    loop b in bindings:
        if nodes[b].kind == .tuple: nested = true
        if nodes[b].a != 0: annotated = true
    if not nested and not annotated and types[t].kind != .array and types[t].kind != .fixed and types[t].kind != .struct_: return (t, bindings)
    statements: int[]
    values: int[]
    unpack_values(e, t, bindings, pos, statements, values)
    tuple = mk(.tuple, pos)
    set_list(tuple, values)
    result_type = check_expr(tuple, 0)
    result = mk(.exprstmt, pos)
    nodes[result].a = i32(last_checked)
    statements.push(result)
    block = mk(.block, pos)
    nodes[block].type = i32(result_type)
    nodes[block].aux = 1
    set_list(block, statements)
    add_flag(block, NF_CHECKED)
    last_checked = block
    (result_type, leaves)

# Read every leaf before any destination is written. Capturing each container
# once preserves value snapshots and lets nested length checks precede writes.
unpack_values = (e: int, t: int, bindings: int[], pos: int, statements: mut int[], values: mut int[]):
    if is_dewy_set_type(t):
        add_flag(e, NF_CHECKED)
        at = prune(check_expr(bc_call("__dewy_set_values", [e], pos), 0))
        unpack_values(last_checked, at, bindings, pos, statements, values)
        return
    is_fixed = types[t].kind == .fixed
    is_array = types[t].kind == .array or is_fixed
    is_tuple = types[t].kind == .tuple
    is_map = is_map_type(t)
    if not is_array and not is_tuple and types[t].kind != .struct_:
        fatal(pos, "unpacking needs an array, tuple, dictionary or record, found {dt(t)}")
    if is_tuple and int(types[t].nargs) != bindings.len():
        fatal(pos, "expected a tuple with {bindings.len()} elements, found {dt(t)}")
    if is_fixed and fixed_len(t) != bindings.len():
        fatal(pos, "unpacking requires exactly {bindings.len()} elements, found {dt(t)}")
    input = e
    input_type = t
    if is_map:
        add_flag(input, NF_CHECKED)
        input_type = prune(check_expr(bc_call("__map_entries", [input], pos), 0))
        input = last_checked
    source = capture_value(input, input_type, statements)
    if (is_array and not is_fixed) or is_map:
        length = mk(.call, pos)
        length_source = source
        if is_map: length_source = bc_field(source, "__keys", pos)
        check_intrinsic(length, .len, [length_source], 0)
        add_flag(length, NF_CHECKED)
        count = mk(.int_lit, pos)
        nodes[count].ival = bindings.len()
        equal = mk(.binary, pos)
        nodes[equal].op = i32(int(Tok.eq))
        nodes[equal].a = i32(length)
        nodes[equal].b = i32(count)
        message = synth_str("unpacking requires exactly {bindings.len()} elements", pos)
        guard = mk(.call, pos)
        check_intrinsic(guard, .assert, [equal, message], 0)
        statement = mk(.exprstmt, pos)
        nodes[statement].a = i32(guard)
        statements.push(statement)
    loop i in 0.. and binding in bindings:
        value = mk(.field, nodes[binding].pos)
        if is_array: nodes[value].kind = .index
        nodes[value].a = i32(source)
        if is_map:
            index = mk(.int_lit, nodes[binding].pos)
            nodes[index].ival = i
            value = bc_call("__map_pair_at", [source, index], nodes[binding].pos)
        else if is_array:
            index = mk(.int_lit, nodes[binding].pos)
            nodes[index].ival = i
            nodes[value].b = i32(index)
            # The length guard above dominates every element read.
            add_flag(value, NF_INBOUNDS)
        else if is_tuple:
            nodes[value].aux = -2
            nodes[value].ival = i
        else:
            if nodes[binding].kind == .hole: fatal(nodes[binding].pos, "record unpacking names fields; leave unwanted fields out instead of using _")
            if nodes[binding].kind == .tuple: fatal(nodes[binding].pos, "record unpacking needs field names at this level")
            nodes[value].name = nodes[binding].name
        if nodes[binding].kind == .tuple:
            inner = prune(check_expr(value, 0))
            unpack_values(last_checked, inner, kids(binding), nodes[binding].pos, statements, values)
        else:
            if nodes[binding].a != 0:
                target = resolve_type(int(nodes[binding].a))
                check_expr(value, target)
                value = coerce(last_checked, target)
                add_flag(value, NF_CHECKED)
            values.push(value)

unpack_array = (e: int, t: int, n: int, pos: int) -> int:
    if types[t].kind != .array or n < 2 or n > 4: return t
    add_flag(e, NF_CHECKED)
    c = int(nodes[synth_call("__unpack{n}", [e], pos)].a)
    r = prune(check_expr(c, 0))
    last_checked = c
    r

# if __test_begin(name): body; __test_end()   (the body in a process of its own, where it can be)
test_entry = (name: int, body: int[], pos: int) -> int:
    block = mk(.block, pos)
    set_list(block, body + [synth_call("__test_end", [], pos)])
    ifn = mk(.if_, pos)
    nodes[ifn].a = i32(bc_call("__test_begin", [name], pos))
    nodes[ifn].b = i32(block)
    ifn

synth_call = (name: str, args: int[], pos: int) -> int:
    c = mk(.call, pos)
    id = mk(.ident, pos)
    nodes[id].name = i32(intern(name))
    nodes[c].a = i32(id)
    set_list(c, args)
    st = mk(.exprstmt, pos)
    nodes[st].a = i32(c)
    st

synth_str = (s: str, pos: int) -> int:
    n = mk(.str_lit, pos)
    nodes[n].sval = i32(intern(s))
    n

program_named = false         # (the build block gave the name)

# Generated helpers preserve collection semantics and record protocols defined
# alongside their types, including inside arrays, optionals and enum payloads.
value_helper_types: {int: int} = {}  # bit 0: equality, bit 1: hashing
value_equal_fns: {int: int} = {}
value_hash_fns: {int: int} = {}

note_value_helpers = (t: int, hashing: bool = false):
    k = tkind(t)
    if k == .array or k == .fixed or k == .opt or k == .struct_ or k == .tuple or k == .enum_:
        bit = if hashing: 2 else: 1
        value_helper_types[t] = (value_helper_types.get(t) ?? 0) | bit

record_value_member = (t: int, hashing: bool) -> int:
    m = module_of_type(t)
    if m < 0: return 0
    protocol_names = [intern("=="), intern("__eq__")]
    ts = [t, t]
    if hashing:
        protocol_names = [intern("hash")]
        ts = [t]
    decls: int[]
    loop name in protocol_names: collect_module(m, name, decls)
    own: int[]
    loop d in decls:
        if int(nodes[d].mod) == m and fn_sig(d).mutmask == 0: own.push(d)
    if own.len() == 0: return 0
    pos = nodes[int(structs[int(types[t].st)].decl)].pos
    f = resolve_from_types(protocol_names[0], own, ts, pos, false)
    if f == 0: return 0
    # Helpers pass the record's address directly; conversions belong to explicit calls.
    loop pt in fns[f].ptypes:
        if not type_eq(pt, t): return 0
    expected = if hashing: T_U64 else: T_BOOL
    result = int(fns[f].ret)
    compatible = type_eq(result, expected)
    if hashing: compatible = can_coerce(0, result, expected)
    if not compatible:
        fatal(pos, "the value protocol '{name_of(protocol_names[0])}' for {dt(t)} must return {dt(expected)}")
    f

check_value_members = (t0: int, hashing: bool, seen: mut {int: bool}):
    t = prune(t0)
    key = t * 2 + int(hashing)
    if seen.has(key) or has_var(t): return
    seen[key] = true
    if is_value_collection_type(t):
        if hashing and not value_hash_fns.has(t):
            value_hash_fns[t] = resolve_by_types(intern("hash"), [t], 0, true)
        else if not hashing and not value_equal_fns.has(t):
            value_equal_fns[t] = resolve_by_types(intern("=="), [t, t], 0, true)
        # Checking these functions discovers the member operations they use.
        # Their backing-storage representation does not need value helpers.
        return
    k = types[t].kind
    if k == .struct_:
        f = 0
        if hashing:
            if not value_hash_fns.has(t): value_hash_fns[t] = record_value_member(t, true)
            f = value_hash_fns[t]
        else:
            if not value_equal_fns.has(t): value_equal_fns[t] = record_value_member(t, false)
            f = value_equal_fns[t]
        if f != 0: return
    if k == .array or k == .fixed or k == .opt:
        check_value_members(int(types[t].elem), hashing, seen)
    else if k == .tuple:
        loop i in [0..int(types[t].nargs)): check_value_members(targ(t, i), hashing, seen)
    else if k == .struct_ or k == .enum_:
        layout(t)
        si = int(types[t].st)
        if k == .struct_:
            loop i in [0..int(structs[si].nfields)):
                check_value_members(int(fields[int(structs[si].fields) + i].type), hashing, seen)
        else:
            loop i in [0..int(structs[si].nvariants)):
                vi = int(structs[si].variants) + i
                loop j in [0..int(variants[vi].nfields)):
                    check_value_members(int(fields[int(variants[vi].fields) + j].type), hashing, seen)

prepare_value_helpers = () -> bool:
    before = fns.len()
    seen: {int: bool} = {}
    loop t, demand in value_helper_types:
        if demand & 1 != 0: check_value_members(t, false, seen)
        if demand & 2 != 0: check_value_members(t, true, seen)
    fns.len() > before

check_pending_functions = (start: int) -> int:
    k = start
    loop k < fns.len() or prepare_value_helpers():
        pc_try(k)
        if fns[k].state == 0 and (fns[k].kind == FK_NORMAL or fns[k].kind == FK_INIT) and k != 0:
            if fns[k].kind == FK_INIT:
                m = int(fns[k].mod)
                entered = enter_module_context(m)
                cx = module_ctx[m]
                fns[k].state = 1
                mark = scope_mark()
                ctxs[cx].floor = i32(sc_names.len())
                body = int(fns[k].body)
                loop j in [0..nkids(body)): check_stmt(kid(body, j))
                scope_reset(mark)
                zonk_tree(body)
                loop l in fns[k].locals: locals[l].type = i32(zonk(int(locals[l].type)))
                copy_write_warnings(k)
                fns[k].ret = i32(T_VOID)
                fns[k].state = 2
                leave_module_context(m, entered)
                cx = -1
            else: check_fn_body(k)
        k += 1
    k

check_program = (main_path: str):
    ownership_reset()
    facts_reset()
    refine_reset()
    proof_reset()
    effects_reset()
    if len(program_name) > 0: program_named = true
    if len(program_name) == 0:
        program_name = main_path
        s = rfind(program_name, "/")
        if s >= 0: program_name = program_name[s + 1..]
        program_name = strip_ext(program_name)
    add_universe()
    load_prelude()
    mainm = load_module(main_path, false, -1)
    ts_dewy = files[int(modules[mainm].file)].is_dewy
    # The editor checks library documents with an empty main. Named libraries
    # are outside the prelude, so load the opened document explicitly as well.
    if ide_on and starts_with(ide_doc, ide_norm(lib_dir) + "/") and find_module(ide_doc) < 0:
        load_module(ide_doc, false, -1)
    if stop_after == "lex" or stop_after == "parse": exit(0)
    modules[mainm].is_main = true
    i = 0
    loop i < modules.len():
        if not prelude_pending.has(i): register_module(i)
        i += 1
    bind_from_imports()
    dewy_resolve_inherited()
    dewy_infer_methods()
    prepare_nominals()
    check_build_block()
    # (native programs report crashes as they do panics: lib/std/backtrace.jo)
    if not target_wasm and prelude.get(intern("__crash_install")) != none: modules[mainm].inits.insert(0, synth_call("__crash_install", [], 0))
    # programs with update()/draw() run the game loop after main()
    has_upd = modules[mainm].names.get(intern("update")) != none
    has_drw = modules[mainm].names.get(intern("draw")) != none
    # (two updates, as a Scratch project's scripts, one per sprite: only the first would run)
    loop gname in ["update", "draw", "main"]:
        first = 0
        loop d in modules[mainm].decls:
            if nodes[d].kind != .fn_ or name_of(int(nodes[d].name)) != gname: continue
            if first == 0: first = d
            else:
                what = "runs every frame"
                if gname == "draw": what = "draws every frame"
                else if gname == "main": what = "runs once, after the top of the file"
                fl, fc = line_col(nodes[first].pos)
                fatal(nodes[d].pos, "a second {gname} (the first is on line {fl}): a program has one {gname}, which {what}; put the lines of both in it, or make each a function of its own that {gname} calls")
    # (a top-level `loop:` in a game, as Scratch's forever: the frames start after the top level ends)
    if has_upd or has_drw:
        loop d in modules[mainm].decls:
            if nodes[d].kind == .while_ and nodes[int(nodes[d].a)].kind == .bool_lit and nodes[int(nodes[d].a)].ival != 0 and not has_break(int(nodes[d].b)):
                upd = "update"
                if not has_upd: upd = "draw"
                warn(nodes[d].pos, "this loop never ends, so the game never starts: {upd} runs after the lines at the top of the file are done. What repeats each frame goes in {upd}, which is the game's forever loop")
    # (the game ignores what update and draw give back: their last line is a statement, as
    # `world.step(dt)` or a mistaken `pos == pos + v`, which then gets its warning)
    loop gn in ["update", "draw"]:
        if let gs = modules[mainm].names.get(intern(gn)):
            gd = int(syms[gs].decl)
            if syms[gs].kind == .fns and gd != 0 and nodes[gd].kind == .fn_ and nodes[gd].a == 0: add_flag(gd, NF_VOID)
    # (Godot's callbacks, which nothing here calls)
    if not has_upd and not has_drw:
        loop gn in ["_process", "_physics_process", "_ready", "_draw", "_input", "Awake", "FixedUpdate", "LateUpdate", "OnGUI"]:
            if let gs = modules[mainm].names.get(intern(gn)):
                if syms[gs].decl != 0: callback_warn(gs, "nothing calls {gn}: a game is {jd(nodes[int(syms[gs].decl)].pos, "`update = (dt: f64): ...`", "`update=(dt:float64):>void=>\{...}`")}, called each frame, and {jd(nodes[int(syms[gs].decl)].pos, "`draw = (): ...`", "`draw=():>void=>\{...}`")} after it; what runs once goes at the top level")
    # (Draw = ():, updte = (dt: f64): a near miss of the name the game calls, and nothing runs)
    loop want in ["draw", "update"]:
        if modules[mainm].names.get(intern(want)) != none: continue
        lim = 1
        if want == "update": lim = 2
        loop nm, gs in modules[mainm].names:
            if syms[gs].kind != .fns or syms[gs].decl == 0: continue
            s = name_of(nm)
            # (a game's: no main, and the parameters the game would give it)
            gd = int(syms[gs].decl)
            np = 0
            if want == "update": np = 1
            if modules[mainm].names.get(intern("main")) != none or nodes[gd].kind != .fn_ or nkids(gd) != np: continue
            if abs(len(s) - len(want)) <= 1 and edit_distance(s, want, lim) <= lim:
                callback_warn(gs, "nothing calls {s}: the game calls `{want}` each frame (did you mean `{want}`?)")
    # (a quit hook under another name: on_close, Unity's OnApplicationQuit)
    if modules[mainm].names.get(intern("on_quit")) == none:
        loop gn in ["on_close", "onClose", "onQuit", "on_exit", "onExit", "OnApplicationQuit", "on_quit_game", "at_exit", "atexit", "_exit_tree", "beforeunload"]:
            if let gs = modules[mainm].names.get(intern(gn)):
                if syms[gs].kind == .fns and syms[gs].decl != 0: callback_warn(gs, "nothing calls {gn}: when the game closes, it calls `on_quit = (): ...` (did you mean `on_quit`?)")
    # (Unity's collision callbacks: contacts are read, each frame)
    loop gn in ["OnCollisionEnter", "OnCollisionStay", "OnCollisionExit", "OnTriggerEnter", "OnTriggerStay", "OnTriggerExit"]:
        if let gs = modules[mainm].names.get(intern(gn)):
            if syms[gs].kind == .fns and syms[gs].decl != 0: callback_warn(gs, "nothing calls {gn}: read `w.contacts(b)` in update, each frame (`if c.new:` for a touch that just began; sensors' are there too)")
    # (LÖVE's input callbacks: input is asked for, each frame)
    loop gn in ["keypressed", "keyreleased", "mousepressed", "mousereleased", "textinput", "wheelmoved"]:
        if let gs = modules[mainm].names.get(intern(gn)):
            if syms[gs].kind == .fns and syms[gs].decl != 0: callback_warn(gs, "nothing calls {gn}: in update, ask each frame (`key_pressed(.space)`, `mouse_pressed(.left)`, `text_input()`, `mouse_wheel()`)")
    if test_mode and test_decls.len() == 0 and not check_all and not ide_on:
        # (pytest's test_ functions, or no tests at all: "0 tests passed" would say all is well)
        pyt = ""
        loop nm, gs in modules[mainm].names:
            if starts_with(name_of(nm), "test_") and syms[gs].kind == .fns and len(pyt) == 0: pyt = name_of(nm)
        if ends_with(main_path, ".dewy"):
            if len(pyt) > 0: fatal(nodes[int(syms[modules[mainm].names[intern(pyt)]].decl)].pos, "'{pyt}' is a function, not a test: put `$test` on the line before it")
            fatal(-1, "no tests in {main_path}: a test is a function marked `$test` on the line before it (`$test` then `let adds = () => $expect add(1 2) =? 3`)")
        if len(pyt) > 0: fatal(nodes[int(syms[modules[mainm].names[intern(pyt)]].decl)].pos, "'{pyt}' is a function, not a test: a test is written `test \"{pyt[5..]}\":` with its lines below it (`assert(...)` in them)")
        fatal(-1, "no tests in {main_path}: a test is written `test \"adds\":` with its lines below it, as `assert(add(1, 2) == 3)`")
    if test_mode:
        # top-level code runs first (it may set up globals), then each test in order
        if not check_all: skip_main = true
        count = 0
        computed: int[]
        loop d in test_decls:
            pos = nodes[d].pos
            nm = name_of(int(nodes[d].sval))
            if nodes[d].aux == 1:
                # (Dewy's `$test` function: called once, or once per case as name[i])
                if nodes[d].a != 0:
                    # (a computed array of cases: each element, by its index at run time)
                    cases = int(nodes[d].a)
                    index = "$test_case{d}"
                    arg = bc_call("__test_case", [cases, bc_ident(index, pos)], pos)
                    name = bc_call("__test_case_name", [synth_str(nm, pos), bc_ident(index, pos)], pos)
                    modules[mainm].inits.push(bc_loop(index, bc_call("__test_count", [clone(cases)], pos), [test_entry(name, [synth_call(nm, [arg], pos)], pos)], pos))
                    computed.push(clone(cases))
                    continue
                if nkids(d) == 0:
                    modules[mainm].inits.push(test_entry(synth_str(nm, pos), [synth_call(nm, [], pos)], pos))
                    count += 1
                    continue
                loop k in 0.. and case in kids(d):
                    modules[mainm].inits.push(test_entry(synth_str("{nm}[{k}]", nodes[case].pos), [synth_call(nm, kids(case), nodes[case].pos)], nodes[case].pos))
                    count += 1
                continue
            if not files[pos_file(pos)].is_dewy and len(nm) >= 2 and nm[0] == '"': nm = nm[1..len(nm) - 1)
            body = int(nodes[d].b)
            modules[mainm].inits.push(test_entry(synth_str(nm, pos), kids(body), pos))
            count += 1
        cnt = mk(.int_lit, 0)
        nodes[cnt].ival = count
        total = cnt
        loop cases in computed: total = bc_bin(.plus, total, bc_call("__test_count", [cases], 0), 0)
        modules[mainm].inits.push(synth_call("__test_done", [total], 0))
    # (sloppy check: the tests, and the game loop's update and draw too)
    if (not test_mode or check_all) and (has_upd or has_drw):
        user_main = false
        loop st0 in modules[mainm].inits:
            if calls_named(st0, "main"): user_main = true
        if user_main: skip_main = true
        else if let s = modules[mainm].names.get(intern("main")):
            mc = mk(.call, 0)
            mid = mk(.ident, 0)
            nodes[mid].name = i32(intern("main"))
            nodes[mc].a = i32(mid)
            st = mk(.exprstmt, 0)
            nodes[st].a = i32(mc)
            modules[mainm].inits.push(st)
            skip_main = true
        # (before the program's own code: it is a game, so a texture made at the top opens the
        # window; a script's opens none)
        isg = mk(.assign, 0)
        nodes[isg].op = i32(int(Tok.assign))
        isgl = mk(.ident, 0)
        nodes[isgl].name = i32(intern("__is_game"))
        nodes[isg].a = i32(isgl)
        isgv = mk(.bool_lit, 0)
        nodes[isgv].ival = 1
        nodes[isg].b = i32(isgv)
        modules[mainm].inits.insert(0, isg)
        gc = mk(.call, 0)
        gid = mk(.ident, 0)
        nodes[gid].name = i32(intern("__game_run"))
        nodes[gc].a = i32(gid)
        # (at the program's update and draw: a mismatch is reported there)
        ua = mk(.ident, 0)
        if has_upd:
            nodes[ua].name = i32(intern("update"))
            nodes[ua].pos = nodes[int(syms[modules[mainm].names[intern("update")]].decl)].pos
            add_flag(ua, NF_MUT)   # the function itself (Dewy's `@update`)
        else: nodes[ua].name = i32(intern("__no_update"))
        da = mk(.ident, 0)
        if has_drw:
            nodes[da].name = i32(intern("draw"))
            nodes[da].pos = nodes[int(syms[modules[mainm].names[intern("draw")]].decl)].pos
            add_flag(da, NF_MUT)
        else: nodes[da].name = i32(intern("__no_draw"))
        set_list(gc, [ua, da])
        # (quit = (): the game's own, in place of the library's that closes the window)
        if let qq = modules[mainm].names.get(intern("quit")):
            qd2 = int(syms[qq].decl)
            if syms[qq].kind == .fns and qd2 != 0 and nodes[qd2].kind == .fn_ and nkids(qd2) == 0: warn(nodes[qd2].pos, "this quit takes the place of the library's quit(), which closes the window: for what runs as the game ends (to save), write `on_quit = ():`")
        # (on_quit = (): what the game does as it ends: its window closed; quit() closes it)
        if let qs = modules[mainm].names.get(intern("on_quit")):
            qd = int(syms[qs].decl)
            if syms[qs].kind == .fns and qd != 0 and nodes[qd].kind == .fn_ and nkids(qd) == 0:
                # (what its last line gives, on_quit = (): save_value(...)'s bool, is dropped)
                add_flag(qd, NF_VOID)
                qc = mk(.call, 0)
                qf = mk(.ident, 0)
                nodes[qf].name = i32(intern("__set_quit"))
                nodes[qc].a = i32(qf)
                qa = mk(.ident, nodes[qd].pos)
                nodes[qa].name = i32(intern("on_quit"))
                add_flag(qa, NF_MUT)
                set_list(qc, [qa])
                qst = mk(.exprstmt, 0)
                nodes[qst].a = i32(qc)
                modules[mainm].inits.push(qst)
        st2 = mk(.exprstmt, 0)
        nodes[st2].a = i32(gc)
        modules[mainm].inits.push(st2)
    prelude_init = new_inst(FK_INIT, 0, "init_prelude")
    fns[prelude_init].body = i32(mk(.block, 0))
    fns[prelude_init].ret = i32(T_VOID)
    fns[prelude_init].state = 2
    module_ctx = []
    module_frames = []
    setup_module_contexts(prelude_init)
    # Set up testing after runtime globals, before any user module initializer.
    # Imported initializers must see the original arguments and headless mode too.
    test_start = 0
    if test_mode: test_start = runtime_fn("__test_run_begin")
    dfs_state = fill(false, modules.len())
    order: int[]
    order_modules(mainm, order)
    init_fns = [prelude_init]
    if test_start != 0: init_fns.push(test_start)
    loop m in order:
        if not modules[m].is_prelude: init_fns.push(int(modules[m].init_fn))
    cx = -1
    check_pushers_first()
    # (a struct or enum of the program's whose values hold one another without end, a: A, is an
    # error used or not)
    loop m in order:
        if modules[m].is_prelude: continue
        loop nm, s in modules[m].names:
            sk = syms[s].kind
            if (sk == .struct_ or sk == .enum_) and syms[s].decl != 0 and nkids2(int(syms[s].decl)) == 0 and (nodes[int(syms[s].decl)].kind == .struct_ or nodes[int(syms[s].decl)].kind == .enum_):
                layout(get_struct_inst(int(syms[s].decl), []))
    if let s = modules[mainm].names.get(intern("main")):
        # (main() at the end of the file, as in Python: it runs once, there)
        calls_main = false
        loop st in modules[mainm].inits:
            if calls_named(st, "main"): calls_main = true
        if syms[s].kind == .fns and not skip_main and not calls_main:
            main_fn = get_fn_inst(int(syms[s].decl), [], 0)
            rt = prune(int(fns[main_fn].ret))
            if rt != T_VOID and rt != T_NEVER and not is_int(rt):
                fatal(nodes[int(syms[s].decl)].pos, "main must return void or an integer exit code, found {dt(rt)}")
    if let s = modules[mainm].names.get(intern("update")):
        if syms[s].kind == .fns:
            # (update = (dt): ..., its parameter untyped: the seconds the game loop gives it)
            ud = int(syms[s].decl)
            if fn_sig(ud).generic and int(fn_sig(ud).ntp) == 1 and nkids(ud) == 1: update_fn = get_fn_inst(ud, [T_FLOAT], 0)
            else: update_fn = get_fn_inst(ud, [], 0)
    if let s = modules[mainm].names.get(intern("draw")):
        if syms[s].kind == .fns: draw_fn = get_fn_inst(int(syms[s].decl), [], 0)
    loop d in export_decls:
        if not modules[int(nodes[d].mod)].is_prelude: export_fns.push(get_fn_inst(d, [], nodes[d].pos))
    # the program's own functions are all checked, called or not (errors should not hide in
    # unused code); only what is reachable is compiled
    if ide_on: ide_force = ide_find_file(ide_doc)
    loop m in modules:
        if m.is_prelude and int(m.file) != ide_force: continue
        loop d in m.decls:
            if nodes[d].kind == .fn_ and not has_flag(d, NF_EXTERN) and not fn_sig(d).generic: get_fn_inst(d, [], nodes[d].pos)
    loop nm in runtime_names: runtime_fn(nm)
    runtime_memeq = runtime_fn("__mem_eq")
    runtime_streq = runtime_fn("__str_eq")
    loop nm in optional_runtime:
        demand_prelude_name(intern(nm))
        if prelude.get(intern(nm)) != none: runtime_fn(nm)
    # (@cabi functions set __c_threads: lib/core/rt.jo)
    if let ct = prelude.get(intern("__c_threads")):
        if syms[ct].kind == .global: ensure_global(int(syms[ct].ref), 0)
    # (vectorized code reads __cpu_avx2: its initializer must be checked with the rest)
    if want_cpu_flag:
        if let cs = prelude.get(intern("__cpu_avx2")):
            if syms[cs].kind == .global: ensure_global(int(syms[cs].ref), 0)
    # (a web page's loops count down to the watchdog, which stops one that never ends)
    if want_loop_watch:
        if let ls = prelude.get(intern("__loop_budget")):
            if syms[ls].kind == .global:
                ensure_global(int(syms[ls].ref), 0)
                runtime_fn("__loop_watchdog")
    # check everything reachable; library exports join once their module is in use
    k = 0
    exp_added: bool[] = fill(false, export_decls.len())
    loop true:
        k = check_pending_functions(k)
        used: {int: bool} = {}
        loop fi in [1..fns.len()):
            if fns[fi].state == 2 and fns[fi].decl != 0: used[int(nodes[int(fns[fi].decl)].mod)] = true
        more = false
        exp_added.resize(export_decls.len())
        loop ei in 0.. and d in export_decls:
            if exp_added[ei] or not modules[int(nodes[d].mod)].is_prelude: continue
            if used.get(int(nodes[d].mod)) != none:
                exp_added[ei] = true
                export_fns.push(get_fn_inst(d, [], nodes[d].pos))
                more = true
        if not more: break
    pc_finish()
    if poly_families.len() > 1: poly_finish_warnings()
    if open_globals.len() > 0: settle_open_globals()
    # (make_world written and never called: nothing runs it. A file of definitions alone, with
    # no main, update or draw and no statement at its top that does something, is a module that
    # others use: checked by itself, nothing in it is called)
    runs = false
    loop i0 in modules[mainm].inits:
        ik = nodes[i0].kind
        # (statements the file has, not ones made for it: they have no place in it)
        if nodes[i0].pos <= 0 or pos_in_lib(nodes[i0].pos): continue
        if ik != .vardecl and ik != .assign and ik != .const_: runs = true
    loop nm0 in ["main", "update", "draw"]:
        if modules[mainm].names.get(intern(nm0)) != none: runs = true
    # (a const nothing uses is checked too: `const X = no_such(3)` is an error, used or not)
    loop mi in [0..modules.len()):
        if modules[mi].is_prelude: continue
        loop cn, cs in modules[mi].names:
            if syms[cs].kind == .const_ and syms[cs].decl != 0:
                cg = int(syms[cs].ref)
                if globals[cg].decl != 0: ensure_global(cg, nodes[int(syms[cs].decl)].pos)
    # An otherwise unused constant can discover another exact-arithmetic
    # module. Finish its queued bodies before lowering any initialization.
    if k < fns.len():
        k = check_pending_functions(k)
        if open_globals.len() > 0: settle_open_globals()
    if late_module_imports:
        dfs_state = fill(false, modules.len())
        order.clear()
        order_modules(mainm, order)
        init_fns = [prelude_init]
        if test_start != 0: init_fns.push(test_start)
        loop m in order:
            if not modules[m].is_prelude: init_fns.push(int(modules[m].init_fn))
    loop ci, at in draw_to_at:
        if not back_to_screen.has(ci): warn(at, "after draw_to, drawing goes into that picture to the end of the frame, and the screen shows nothing: `draw_to_screen()` comes back to the screen (then `draw_target(rt)` shows the picture)")
    # (nothing runs at all: one word for the whole file, as a module or a program not finished)
    if not ide_on and not test_mode and not runs and not check_all and not ends_with(main_path, "<input>"):
        loop d in modules[mainm].decls:
            if nodes[d].kind != .fn_ or fn_used.has(d) or has_flag(d, NF_EXTERN) or nodes[d].c != 0: continue
            fnm = name_of(int(nodes[d].name))
            warn(nodes[d].pos, "nothing in this file runs: it only makes functions, and making {fnm} does not run it. Lines at the top of the file run when the program starts (`{fnm}()` there calls it); a game's {jd(nodes[d].pos, "`update = (dt: f64):` runs every frame, where `if key_pressed(.space): ...` checks a key. (A file that other files `use` is fine like this.)", "`update=(dt:float64):>void=>\{...}` runs every frame, where `if key_pressed(Key.space) ...` checks a key. (A file that other files import is fine like this.)")}")
            break
    if not ide_on and (not test_mode or check_all) and runs:
        # (a `$test` function: `dewy-core test` runs it)
        tested: {int: bool} = {}
        loop d in modules[mainm].decls:
            if nodes[d].kind == .test_ and nodes[d].aux == 1: tested[int(nodes[d].name)] = true
        loop d in modules[mainm].decls:
            if nodes[d].kind != .fn_ or fn_used.has(d) or has_flag(d, NF_EXTERN) or nodes[d].c != 0 or tested.has(int(nodes[d].name)): continue
            dn = name_of(int(nodes[d].name))
            if dn == "main" or dn == "update" or dn == "draw" or starts_with(dn, "_") or starts_with(dn, "(") or starts_with(dn, "op_"): continue
            # (a method is a member of its type, there for whoever uses the type: only a private
            # type's, `_Name`, is held to this rule)
            if dewy_is_method(d) and not starts_with(method_type_name(d), "_"): continue
            # (its name written anywhere else in the file: an overload used under it, or a use in
            # code for another target, as in `when TARGET == "windows":`)
            if word_count(files[pos_file(nodes[d].pos)].src, dn) > 1: continue
            how = "`{dn}()`"
            if nkids(d) > 0: how = "`{dn}(...)`"
            if dewy_is_method(d) and nkids(d) > 1: how = "`value.{dn}(...)`"
            else if dewy_is_method(d): how = "`value.{dn}`"
            warn(nodes[d].pos, "'{dn}' is never called: nothing runs it (call it, as {how} where it should run)")
    # (globals of the program whose fields or elements are changed and that are never read)
    loop g, wp in gcopy_writes:
        if g < global_read.len() and global_read[g]: continue
        if modules[int(globals[g].mod)].is_prelude or pos_in_lib(wp): continue
        nm = name_of(int(globals[g].name))
        warn_unused_copy(wp, nm)
    # prelude init: referenced prelude globals in declaration order
    pl: int[]
    loop g in global_ids:
        if modules[int(globals[g].mod)].is_prelude and globals[g].state == 2: pl.push(int(globals[g].decl))
    order_prelude_globals(pl)
    set_list(int(fns[prelude_init].body), pl)
    zonk_tree(int(fns[prelude_init].body))
    # Close declared promises after every checked helper has been discovered,
    # including check-only callers and unreachable checked declarations.
    pc_finish()
    if not errors_only:
        ownership_finalize()
        effects_finalize()

# How near one name is to another, for the checker's "did you mean" hints.
#
# A module of the compiler written in Dewy. spelling.jo is its frozen twin for the
# compilers without the Dewy frontend (tools/compiler/build.py); the two keep the same
# interface and give the same answers (tests/test_selfhost_spelling.py).

# ASCII case folding: 'A'..'Z' to 'a'..'z'
fold_case=(c:uint8):>uint8=>if c >=? b'A' and c <=? b'Z' c+32 else c

# edit distance where swapping two neighbors counts once (optimal string alignment);
# letters compare ignoring case; past limit, the answer is only some number above it
edit_distance=(a:string b:string limit:int64):>int64=>{
    let x=a as array<uint8>
    let y=b as array<uint8>
    let n=x.length
    let m=y.length
    if abs(n-m) >? limit {return limit+1}
    let pp:array<int64>=fill(0 m+1)
    let prev:array<int64>=[loop j in [0..m] j]
    let cur:array<int64>=fill(0 m+1)
    loop i in [1..n] {
        # (the three rows the loop rotates keep length m+1)
        $runtime_assert cur.length =? m+1 and prev.length =? cur.length and pp.length =? cur.length
        cur[0]=i
        let best=i
        loop j in [1..m] {
            let c:int64=if fold_case(x[i-1]) =? fold_case(y[j-1]) 0 else 1
            let v=min(min(prev[j]+1 cur[j-1]+1) prev[j-1]+c)
            if i >? 1 and j >? 1 and fold_case(x[i-1]) =? fold_case(y[j-2]) and fold_case(x[i-2]) =? fold_case(y[j-1]) {
                v=min(v (pp.get(j-2) ?? v)+1)
            }
            cur[j]=v
            if v <? best {best=v}
        }
        if best >? limit {return limit+1}
        let tmp=pp
        pp=prev
        prev=cur
        cur=tmp
    }
    prev.get(m) ?? limit+1
}

# A candidate name and how near it is (lower is nearer).
Near:type=[name:string score:int64]

# The closest of the candidate names, as the checker's hint (" (did you mean 'x'?)"), or "".
# Ties go to the longest common prefix, then to the first; a short name that starts the
# misspelling (len / lenght) counts as close.
did_you_mean=(name:string candidates:array<string>):>string=>{
    let x=name as array<uint8>
    let n=x.length
    # (Score for score: the same but for its capitals)
    loop c in candidates {
        if c not=? name and (c as array<uint8>).length =? n and lower(c) =? lower(name) {
            return " (did you mean '{c}'? names care about capital letters)"
        }
    }
    # (BROWN, SKYBLUE: a color's name in capitals; only names in capitals are near it)
    let caps=n >=? 3 and not x.any((b:uint8) => b >=? b'a' and b <=? b'z')
    # (a one- or two-letter name is close to too many: only another case of it)
    let limit:int64=if n <=? 2 0 else if n >? 4 2 else 1
    let near:array<Near>=[]
    loop c in candidates {
        let y=c as array<uint8>
        let m=y.length
        if caps and c not=? upper(c) or c =? name or m =? 0 or y[0] =? b'_' {continue}
        let d=edit_distance(name c limit)
        let pre=0
        loop pre <? m and pre <? n and fold_case(y[pre]) =? fold_case(x[pre]) {pre+=1}
        if d >? limit and pre =? m and pre >=? 3 {d=limit}
        # (poly for polygon: the start of a longer name)
        let longer=0
        if pre =? n and pre >=? 3 and m >? pre and y[pre] =? b'_' {
            # (save for save_data: the first word of a longer name, before all others)
            d=0
            longer=m
        } else if d >? limit and pre =? n and pre >=? 4 and m <=? 2 * n {
            d=limit
            longer=m        # (the shortest such: polygon before polyline)
        }
        if d <=? limit {near.push(Near[c d * 100 - pre + longer])}
    }
    if not near.is_empty {return " (did you mean '{near.min_by((v:Near) => v.score).name}'?)"}
    if caps {return " (the colors with names are WHITE, BLACK, RED, GREEN, BLUE, YELLOW, ORANGE, PURPLE, CYAN, MAGENTA and GRAY; any other is rgb(0.5, 0.3, 0.1), each from 0 to 1)"}
    ""
}

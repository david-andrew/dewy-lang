$runtime_checks
from p"errors.jo" import (nominal_parent)
from p"ast.jo" import (nodes)
from p"check.jo" import (decl_infos)
from p"checker_decl_slots.dewy" import (decl_info)
from p"checker_signature.dewy" import (fn_sig)
from p"error_ops.dewy" import (family_annotation value_members)
from p"types.jo" import (prune structs type_eq types)
from p"node_store.dewy" import (node_mod)

MethodReceiverWord:type=int64<overflow='wrap'>

# Shared by named member lookup and the complete diagnostic/IDE listing.
# Read the cached signature in place; no candidate needs a signature copy.
method_decl_for=(decl:MethodReceiverWord rt:MethodReceiverWord):>bool=>{
    let di=decl_info(decl)
    if not decl_infos[di].sig.done {fn_sig(decl);}
    if decl_infos[di].sig.params.length =? 0 {return false}
    let p=prune(decl_infos[di].sig.params[0])
    if types[p].kind =? 'var' {return false}
    types[p].kind =? types[rt].kind or type_eq(p rt) or family_annotation(p) and value_members(p).contains(rt)
}

module_of_type=(t0:MethodReceiverWord):>MethodReceiverWord=>$unsafe {
    let t=prune(t0)
    let k=types.ptr[t].kind
    if k =? 'struct_' or k =? 'enum_' {return MethodReceiverWord(node_mod(nodes.ptr[MethodReceiverWord(structs.ptr[MethodReceiverWord(types.ptr[t].st)].decl)].op_ext))}
    -1
}

# The modules whose functions are methods of t: its own, then those of the types it is
# minted under (a minted child has its parents' methods, wherever they were declared)
method_modules=(t0:MethodReceiverWord):>array<int64>=>{
    let out:array<int64>=[]
    let t=prune(t0)
    loop t not=? 0 {
        let m=module_of_type(t)
        if m >=? 0 and not out.contains(m) {out.push(m)}
        t=nominal_parent.get(t) ?? 0
    }
    out
}

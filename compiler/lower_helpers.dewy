from p"lower_storage.dewy" import (V arr_len blk box_val br_to brif_to copy_at drop_at endc env_guard env_guarded field_store_type hdr_load hdr_store iff is_shared load_val lop new_temp opt_has opt_value own release ret_vt retain retain_elems store_type store_val vc vt_of)
from p"lower_analysis.dewy" import (fn_writes)
$runtime_checks
from p"lower.jo" import (BOX_HDR VC_AGG VC_FLT VC_INT Val begin_fn ctl e_faddr e_gaddr env_layout global_addr_off hk_key inst_mutmask lf_helper lf_of_inst lfuncs partial_layout rt spawn_body spawn_owned_capture tuple_off value_member_cache)
from p"check.jo" import (FK_PARTIAL LF_ASSIGNED LF_EXPOSED LF_VALUECAP fns locals prelude syms value_equal_fns value_hash_fns)
from p"ir.jo" import (M_FLOAT VI VS e_addi e_bin e_call e_call0 e_call1 e_call2 e_calli e_copy e_fconst e_iconst e_load e_mov e_ret e_slot e_store e_zero emit ir mulh_ok vreg)
from p"types.jo" import (T_MATH_INT T_STR fields fixed_len is_managed layout math_optional prune ptr_size structs targ telem tkind tsize type_has_fn types variants)

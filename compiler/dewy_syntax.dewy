$runtime_checks
from p"targets.dewy" import target_arch_of, target_os_of
# Token kind names shared by diagnostics and the formatter.
from p"dewy_tokens.dewy" import DewyKind

dw_kind_name=(kind:DewyKind):>string=>match kind {
    <'unknown'> => "Unknown"
    <'op'> => "op"
    <'identifier'> => "Identifier"
    <'boolean'> => "Bool"
    <'metatag'> => "Metatag"
    <'based_string'> => "BasedString"
    <'integer'> => "Integer"
    <'source_integer'> => "Integer"
    <'source_real'> => "Real"
    <'quoted'> => "quoted"
    <'rawquoted'> => "rawquoted"
    <'eof'> => "eof"
    <'atom'> => "Atom"
    <'ambiguous'> => "Ambiguous"
    <'binary'> => "BinOp"
    <'block'> => "Block"
    <'combined_assignment'> => "CombinedAssignmentOp"
    <'flat'> => "Flat"
    <'flow'> => "Flow"
    <'interpolated_string'> => "IString"
    <'inverted_comparison'> => "InvertedComparisonOp"
    <'keyword'> => "Keyword"
    <'keyword_expr'> => "KeywordExpr"
    <'operator'> => "Operator"
    <'postfix'> => "Postfix"
    <'prefix'> => "Prefix"
    <'string'> => "String"
    <'string_chunk'> => "StringChunk"
    <'directive'> => "Directive"
    <'compact_expr'> => "CompactExpression"
    <'compact_stmt'> => "CompactStatement"
    <'lazy_body'> => "LazyBody"
}

syntax_target_field_value=(field:int64 target:string mode:string):>string=>{
    if field =? 1 {return target_arch_of(target)}
    if field =? 2 {return target_os_of(target)}
    if field =? 3 {return mode}
    target
}

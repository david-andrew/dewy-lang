$runtime_checks
# The Dewy frontend's syntax tree (dewy_fast.jo builds it, dewy_parse.jo projects it into
# the compact AST): a node, its children, the operator it applies, the reading an ambiguous
# node takes, the kind names diagnostics show, and the conditions on `$target` and `$build`
# that fold while it is projected (docs/LANGUAGE.md, "Targets").
#
# A module of the compiler written in Dewy. dewy_syntax.jo is its frozen twin for the
# compilers without the Dewy frontend (tools/compiler/build.py); the two keep the same
# interface and give the same answers (tests/test_selfhost_dewy_syntax.py). The tree is
# Sloppy's global, passed by place. A mistake found here is recorded in a SyntaxProblem the
# caller passes by place (the first one found; the answer is then meaningless) and reported
# by the caller.

from p"dewy_tokens.dewy" import DewyToken, DewyKind, dn_token_kind, dn_token_uninvert
from p"targets.dewy" import target_names, target_arches, target_oses, target_arch_of, target_os_of

# A node. Binary nodes keep their sentinel and operands inline (child_mode is the sentinel
# plus 1, then child_left and child_right); other nodes use children.
DewySyntax:type=[
    kind:DewyKind
    text:string
    pos:int64
    children:array<int64>
    symbol:DewyToken='none'
    name:int32=0
    child_mode:int64=0
    child_left:int64=0
    child_right:int64=0
]

SyntaxProblem:type=[
    message:string
    at:int64            # the source position
    unsupported:bool    # message names what Dewy does not support yet
]

# A kind's name in diagnostics and in the formatter's checks
dw_kind_name=(kind:DewyKind):>string=>match kind {
    <'unknown'> => "Unknown"
    <'op'> => "op"
    <'identifier'> => "Identifier"
    <'boolean'> => "Bool"
    <'metatag'> => "Metatag"
    <'based_string'> => "BasedString"
    <'integer'> => "Integer"
    <'source_integer'> => "Integer"
    <'source_real'> => "Real"
    <'quoted'> => "quoted"
    <'rawquoted'> => "rawquoted"
    <'eof'> => "eof"
    <'atom'> => "Atom"
    <'ambiguous'> => "Ambiguous"
    <'binary'> => "BinOp"
    <'block'> => "Block"
    <'combined_assignment'> => "CombinedAssignmentOp"
    <'flat'> => "Flat"
    <'flow'> => "Flow"
    <'interpolated_string'> => "IString"
    <'inverted_comparison'> => "InvertedComparisonOp"
    <'keyword'> => "Keyword"
    <'keyword_expr'> => "KeywordExpr"
    <'operator'> => "Operator"
    <'postfix'> => "Postfix"
    <'prefix'> => "Prefix"
    <'string'> => "String"
    <'string_chunk'> => "StringChunk"
    <'directive'> => "Directive"
    <'compact_expr'> => "CompactExpression"
    <'compact_stmt'> => "CompactStatement"
    <'lazy_body'> => "LazyBody"
}

# ---- building (dewy_fast.jo's reference parser) ----

# A new node: its id
syntax_node=(@tree:array<DewySyntax> kind:DewyKind text:string pos:int64 children:array<int64> name:int32):>int64=>{
    let id=tree.length
    tree.push(DewySyntax[kind=kind text=text pos=pos children=children name=name])
    id
}

# A new node applying an operator: child 0 is the ordinary or inverted sentinel, the operands follow
syntax_op_node=(@tree:array<DewySyntax> kind:DewyKind symbol:DewyToken pos:int64 children:array<int64>):>int64=>{
    let id=tree.length
    tree.push(DewySyntax[kind=kind text="" pos=pos children=children symbol=symbol])
    id
}

# `left op right`, where its left operand starts: an inverted comparison (`not=?`) applies its
# scalar operator over the inverted sentinel. A binary node keeps its sentinel and operands inline.
syntax_operator=(@tree:array<DewySyntax> kind:DewyKind op:DewyToken left:int64 right:int64):>int64=>{
    let scalar=dn_token_uninvert(op)
    let sentinel:int64=if scalar not=? op 1 else 0
    let id=tree.length
    let pos=tree[left].pos
    if kind =? 'binary' {
        tree.push(DewySyntax[kind=kind text="" pos=pos children=[] symbol=scalar child_mode=sentinel + 1 child_left=left child_right=right])
    } else {tree.push(DewySyntax[kind=kind text="" pos=pos children=[sentinel left right] symbol=scalar])}
    id
}

# ---- children ----

syntax_child=(@tree:array<DewySyntax> id:int64 at:int64):>int64=>{
    let mode=tree[id].child_mode
    if mode =? 0 {return tree[id].children[at]}
    if at =? 0 {return mode - 1}
    if at =? 1 {return tree[id].child_left}
    tree[id].child_right
}

syntax_children=(@tree:array<DewySyntax> id:int64):>array<int64>=>{
    let mode=tree[id].child_mode
    if mode =? 0 {return tree[id].children}
    [(mode - 1) tree[id].child_left tree[id].child_right]
}

syntax_count=(@tree:array<DewySyntax> id:int64):>int64=>{
    if tree[id].child_mode not=? 0 {return 3}
    tree[id].children.length
}

# the juxtaposed multiplications a reading of an ambiguous node makes
syntax_multiplications=(@tree:array<DewySyntax> id:int64):>int64=>{
    let score:int64=if tree[id].text =? "MultiplyJuxtapose" 1 else 0
    loop child in syntax_children(@tree id) {score+=syntax_multiplications(@tree child)}
    score
}

# The node an atom (a group) holds, and an ambiguous node's reading with the fewest
# multiplications; -1 - id for the ambiguous node id when no reading has fewer than the others.
syntax_unwrap=(@tree:array<DewySyntax> id0:int64):>int64=>{
    let id=id0
    loop true {
        let kind=tree[id].kind
        if kind =? 'atom' {
            id=syntax_child(@tree id 0)
            continue
        }
        if kind not=? 'ambiguous' {return id}
        let best:int64=-1
        let score:int64=1000000000
        let tied=false
        loop child in syntax_children(@tree id) {
            let next=syntax_multiplications(@tree child)
            if next <? score {
                best=child
                score=next
                tied=false
            } else if next =? score {tied=true}
        }
        if best <? 0 or tied {return (0 - id) - 1}
        id=best
    }
    id
}

# The operator an unwrapped node applies ('none' for any other node)
syntax_op=(@tree:array<DewySyntax> id:int64):>DewyToken=>{
    let kind=tree[id].kind
    if kind not=? 'binary' and kind not=? 'prefix' and kind not=? 'postfix' and kind not=? 'flat' {return 'none'}
    let symbol=tree[id].symbol
    if symbol not=? 'none' {return symbol}
    # (otherwise the operator is a child node)
    let op=syntax_child(@tree id 0)
    if kind =? 'binary' and tree[op].kind =? 'combined_assignment' {return dn_token_kind("{tree[syntax_child(@tree op 0)].text}=")}
    tree[op].symbol
}

# ---- mistakes ----

# (the first mistake stays: the caller stops at it)
syntax_fail=(@p:SyntaxProblem at:int64 message:string unsupported:bool)=>{
    if not p.message.is_empty {return}
    p.message=message
    p.at=at
    p.unsupported=unsupported
}

# syntax_unwrap, with an ambiguous node a mistake (then node 0)
unwrapped=(@tree:array<DewySyntax> @p:SyntaxProblem id:int64):>int64=>{
    let u=syntax_unwrap(@tree id)
    if u >=? 0 {return u}
    syntax_fail(@p tree[(0 - u) - 1].pos "an ambiguous expression; use explicit multiplication or parentheses" true)
    0
}

op_of=(@tree:array<DewySyntax> @p:SyntaxProblem id:int64):>DewyToken=>syntax_op(@tree unwrapped(@tree @p id))

name_of=(@tree:array<DewySyntax> @p:SyntaxProblem id:int64):>string=>{
    let u=unwrapped(@tree @p id)
    if tree[u].kind =? 'identifier' {return tree[u].text}
    ""
}

metatag_named=(@tree:array<DewySyntax> @p:SyntaxProblem id:int64 name:string):>bool=>{
    let u=unwrapped(@tree @p id)
    tree[u].kind =? 'metatag' and tree[u].text =? name
}

# ---- `$target` and `$build` ----

syntax_is_target=(@tree:array<DewySyntax> @p:SyntaxProblem id:int64):>bool=>metatag_named(@tree @p id "target")
syntax_is_build=(@tree:array<DewySyntax> @p:SyntaxProblem id:int64):>bool=>metatag_named(@tree @p id "build")

# `$target` (0), `$target.arch` (1), `$target.os` (2) or `$build.mode` (3); -1 for anything
# else. `$build` is the compile-time record of how the program is built: its mode, 'debug' or
# 'release'.
syntax_target_field=(@tree:array<DewySyntax> @p:SyntaxProblem id0:int64):>int64=>{
    let id=unwrapped(@tree @p id0)
    if syntax_is_target(@tree @p id) {return 0}
    if syntax_op(@tree id) not=? 'dot' or syntax_count(@tree id) not=? 3 {return -1}
    let member=name_of(@tree @p syntax_child(@tree id 2))
    if syntax_is_build(@tree @p syntax_child(@tree id 1)) {
        if member =? "mode" {return 3}
        if member =? "debug" {
            syntax_fail(@p tree[id].pos "`$build` has `mode` ('debug' or 'release'), not `debug`: test `$build.mode =? 'debug'`" false)
            return -1
        }
        syntax_fail(@p tree[id].pos "`$build` has `mode` ('debug' or 'release'), not `{member}`" false)
        return -1
    }
    if not syntax_is_target(@tree @p syntax_child(@tree id 1)) {return -1}
    if member =? "arch" {return 1}
    if member =? "os" {return 2}
    -1
}

# The value of a `$target` or `$build` field, building for target in mode
syntax_target_field_value=(field:int64 target:string mode:string):>string=>{
    if field =? 1 {return target_arch_of(target)}
    if field =? 2 {return target_os_of(target)}
    if field =? 3 {return mode}
    target
}

# A target name (field 0), processor (1), system (2) or build mode (3) written as a string
# literal, checked against the names the design gives; "" when id is no string literal.
syntax_target_literal=(@tree:array<DewySyntax> @p:SyntaxProblem id0:int64 field:int64):>string=>{
    let id=unwrapped(@tree @p id0)
    if tree[id].kind not=? 'string' {return ""}
    let name=tree[id].text
    let at=tree[id].pos
    if field =? 3 {
        if name not=? "release" and name not=? "debug" {syntax_fail(@p at "unknown build mode \"{name}\": `$build.mode` is \"release\" or \"debug\"" false)}
        return name
    }
    if field =? 1 {
        if not (name in? target_arches()) {syntax_fail(@p at "unknown processor \"{name}\": `$target.arch` is one of {target_arches().join(", ")}" false)}
        return name
    }
    if field =? 2 {
        if not (name in? target_oses()) {syntax_fail(@p at "unknown system \"{name}\": `$target.os` is one of {target_oses().join(", ")}" false)}
        return name
    }
    if not (name in? target_names()) {
        syntax_fail(@p at "unknown target \"{name}\": `$target` is one of {target_names().join(", ")}" false)
        return name
    }
    if target_os_of(name) =? "none" and name not=? "wasm32" and name not=? "c89" {
        syntax_fail(@p at "`$target` is a full target name, never \"{name}\" alone (which asks for the current machine): test the processor with `$target.arch =? \"{name}\"`, or name the system too, as \"{name}-linux\"" false)
    }
    name
}

# A condition made only of `$target`, `$target.arch`, `$target.os` or `$build.mode` compared
# with string literals (`=?`, `not =?`, and `in?`/`not in?` a literal list), joined by `not`,
# `and` and `or`: its value building for target in mode; none for any other condition (an
# ordinary runtime test).
target_fold=(@tree:array<DewySyntax> @p:SyntaxProblem id0:int64 target:string mode:string):>bool|none=>{
    let id=unwrapped(@tree @p id0)
    if not p.message.is_empty {return none}
    let kind=tree[id].kind
    if kind =? 'block' and tree[id].text =? "():" and syntax_count(@tree id) =? 1 {return target_fold(@tree @p syntax_child(@tree id 0) target mode)}
    let op=syntax_op(@tree id)
    if kind =? 'prefix' and op =? 'kw_not' {
        let inner=target_fold(@tree @p syntax_child(@tree id 1) target mode)
        if inner is? bool {return not inner}
        return none
    }
    if kind not=? 'binary' {return none}
    if op =? 'kw_and' or op =? 'kw_or' {
        let left=target_fold(@tree @p syntax_child(@tree id 1) target mode)
        if not (left is? bool) {return none}
        let right=target_fold(@tree @p syntax_child(@tree id 2) target mode)
        if not (right is? bool) {return none}
        if op =? 'kw_and' {return left and right}
        return left or right
    }
    let inverted=tree[syntax_child(@tree id 0)].kind =? 'inverted_comparison' or op =? 'not_eq' or op =? 'not_contains'
    let left=syntax_child(@tree id 1)
    let right=syntax_child(@tree id 2)
    let found=false
    if op =? 'eq' or op =? 'not_eq' {
        if syntax_target_field(@tree @p right) >=? 0 {
            right=left
            left=syntax_child(@tree id 2)
        }
        let field=syntax_target_field(@tree @p left)
        if field <? 0 or not p.message.is_empty {return none}
        let name=syntax_target_literal(@tree @p right field)
        if name.is_empty or not p.message.is_empty {return none}
        found=name =? syntax_target_field_value(field target mode)
    } else if op =? 'contains' or op =? 'not_contains' {
        let field=syntax_target_field(@tree @p left)
        if field <? 0 or not p.message.is_empty {return none}
        let list=unwrapped(@tree @p right)
        if tree[list].kind not=? 'block' or tree[list].text not=? "[]:" {return none}
        loop entry in syntax_children(@tree list) {
            let name=syntax_target_literal(@tree @p entry field)
            if name.is_empty or not p.message.is_empty {return none}
            if name =? syntax_target_field_value(field target mode) {found=true}
        }
    } else {return none}
    if inverted {return not found}
    found
}

# target_fold as 1 (true), 0 (false) or -1 (no such condition)
syntax_target_condition=(@tree:array<DewySyntax> @p:SyntaxProblem id:int64 target:string mode:string):>int64=>{
    let fold=target_fold(@tree @p id target mode)
    if fold is? bool {return if fold 1 else 0}
    -1
}

# An `if` chain whose every condition is a folded `$target` or `$build` test: the syntax of
# the compiled arm's body (0 when no arm is compiled), or -1.
syntax_target_live=(@tree:array<DewySyntax> @p:SyntaxProblem id0:int64 target:string mode:string):>int64=>{
    let id=unwrapped(@tree @p id0)
    if tree[id].kind not=? 'flow' {return -1}
    loop arm in syntax_children(@tree id) {
        if tree[arm].kind not=? 'keyword_expr' {return arm}
        if tree[syntax_child(@tree arm 0)].text not=? "if" or syntax_count(@tree arm) not=? 3 {return -1}
        let fold=target_fold(@tree @p syntax_child(@tree arm 1) target mode)
        if not (fold is? bool) {return -1}
        if fold {return syntax_child(@tree arm 2)}
    }
    0
}

# `$target`, or `$build` or one of its members (`$target.arch` too: setting it is an error)
syntax_setting_place=(@tree:array<DewySyntax> @p:SyntaxProblem id0:int64):>bool=>{
    let id=unwrapped(@tree @p id0)
    if syntax_is_target(@tree @p id) or syntax_is_build(@tree @p id) {return true}
    syntax_op(@tree id) =? 'dot' and syntax_count(@tree id) =? 3 and (syntax_is_build(@tree @p syntax_child(@tree id 1)) or syntax_is_target(@tree @p syntax_child(@tree id 1)))
}

# how a setting place is written: `$target`, `$build` or `$build.mode`
syntax_setting_text=(@tree:array<DewySyntax> @p:SyntaxProblem id0:int64):>string=>{
    let id=unwrapped(@tree @p id0)
    if syntax_is_target(@tree @p id) {return "$target"}
    if syntax_is_build(@tree @p id) {return "$build"}
    let base=if syntax_is_build(@tree @p syntax_child(@tree id 1)) "$build" else "$target"
    "{base}.{name_of(@tree @p syntax_child(@tree id 2))}"
}

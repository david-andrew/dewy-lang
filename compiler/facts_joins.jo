    rg: i32 = 0
    lm_gen_p: *i32 = null
    lm_val_p: *i32 = null
    rm_gen_p: *i32 = null
    rm_val_p: *i32 = null
    lr_gen_p: *i32 = null
    lr_val_p: *i32 = null
    rl_gen_p: *i32 = null
    rl_val_p: *i32 = null
    if renamed:
        rcap = fact_terms.len() + 1
        rg = fj_ensure_ren(rcap)
        lm_gen_p = data(fj_lm_gen); lm_val_p = data(fj_lm_val)
        rm_gen_p = data(fj_rm_gen); rm_val_p = data(fj_rm_val)
        lr_gen_p = data(fj_lr_gen); lr_val_p = data(fj_lr_val)
        rl_gen_p = data(fj_rl_gen); rl_val_p = data(fj_rl_val)

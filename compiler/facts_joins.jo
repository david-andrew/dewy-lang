            if other == v: continue
            o = fj_ren_lookup(other, to_merged_g, to_merged_v, rg, rcap, s)
            if o == 0: continue
            po = fj_ren_lookup_raw(other, to_theirs_g, to_theirs_v, rg, rcap, pids, pn_ids, pslots, pslots_n, gterms, ngterms)

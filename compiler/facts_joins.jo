fj_join_diff_side = (s: mut FactState, src: FactState, peer: FactState, common_rows: int, m_gen_p: *i32, m_val_p: *i32, r_gen_p: *i32, r_val_p: *i32, rg: i32, rcap: int, pids: *int, pn_ids: int, pslots: *int, pslots_n: int, gterms: *FactTerm, ngterms: int):
    dp = data(src.differences)
    loop ri in [0..src.differences.len()):
        row = dp[ri]
        if ri < common_rows:
            if (row.a < 0 or row.a >= rcap or m_gen_p[row.a] != rg) and (row.b < 0 or row.b >= rcap or m_gen_p[row.b] != rg): continue
            aa = fj_ren_lookup(row.a, m_gen_p, m_val_p, rg, rcap, s)
            bb = fj_ren_lookup(row.b, m_gen_p, m_val_p, rg, rcap, s)
            if aa == 0 or bb == 0 or (aa == row.a and bb == row.b): continue
            ra = fj_ren_lookup_raw(row.a, r_gen_p, r_val_p, rg, rcap, pids, pn_ids, pslots, pslots_n, gterms, ngterms)
            rb = fj_ren_lookup_raw(row.b, r_gen_p, r_val_p, rg, rcap, pids, pn_ids, pslots, pslots_n, gterms, ngterms)
            if ra != 0 and rb != 0 and fact_distance(peer, ra, rb, row.limit): fact_difference(s, aa, bb, row.limit, row.at)

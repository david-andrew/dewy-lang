                else if v != qv: v = fact_new(s, fact_hull(fact_bound(a, v), fact_bound(b, qv), at), fact_join_term(a, v, b, qv))
                if s.projections.len() < FACT_CAP: fact_add_projection(s, FactProjection(data(merged)[cursor], selector, p.element, v))

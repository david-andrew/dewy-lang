fj_same_gen: i32[]
fj_same_idx: i32[]
fj_same_g: i32 = 0
fj_ren_g: i32 = 0
fj_lm_gen: i32[]
fj_lm_val: i32[]
fj_rm_gen: i32[]
fj_rm_val: i32[]
fj_lr_gen: i32[]
fj_lr_val: i32[]
fj_rl_gen: i32[]
fj_rl_val: i32[]
fj_left_pool: int[]
fj_right_pool: int[]
fj_merged_pool: int[]
fj_chg_l_pool: int[]
fj_chg_r_pool: int[]
fj_chg_idx_pool: int[]
fj_pairs_pool: int[]
fj_elem_keys: {(int, int): int} = {}

fj_ensure_same = (need: int) -> i32:
    if fj_same_gen.len() < need:
        sz = need + 256
        fj_same_gen.resize(sz)
        fj_same_idx.resize(sz)
    fj_same_g = i32(int(fj_same_g) + 1)
    if fj_same_g == 0:
        mem_set(data(fj_same_gen) as *u8, 0, fj_same_gen.len() * 4)
        fj_same_g = 1
    fj_same_g

fj_ensure_ren = (need: int) -> i32:
    if fj_lm_gen.len() < need:
        sz = need + 256
        fj_lm_gen.resize(sz); fj_lm_val.resize(sz)
        fj_rm_gen.resize(sz); fj_rm_val.resize(sz)
        fj_lr_gen.resize(sz); fj_lr_val.resize(sz)
        fj_rl_gen.resize(sz); fj_rl_val.resize(sz)
    fj_ren_g = i32(int(fj_ren_g) + 1)
    if fj_ren_g == 0:
        n = fj_lm_gen.len() * 4
        mem_set(data(fj_lm_gen) as *u8, 0, n)
        mem_set(data(fj_rm_gen) as *u8, 0, n)
        mem_set(data(fj_lr_gen) as *u8, 0, n)
        mem_set(data(fj_rl_gen) as *u8, 0, n)
        fj_ren_g = 1
    fj_ren_g

fj_ren_lookup = (v: int, gen_p: *i32, val_p: *i32, rg: i32, cap: int, shared: mut FactState) -> int:
    if v >= 0 and v < cap and gen_p[v] == rg: return int(val_p[v])
    if fact_slot_ref(shared, v) >= 0: return v
    0

fj_ren_lookup_raw = (v: int, gen_p: *i32, val_p: *i32, rg: i32, cap: int, ids: *int, n_ids: int, slots_p: *int, slots_n: int, gterms: *FactTerm, ngterms: int) -> int:
    if v >= 0 and v < cap and gen_p[v] == rg: return int(val_p[v])
    if n_ids == 0: return 0
    if v > 0 and v < ngterms:
        hint = gterms[v].slot
        if hint >= 0 and hint < n_ids and ids[hint] == v: return v
    if fact_slot_slow_raw(slots_p, slots_n, v, n_ids, ids) >= 0: return v
    0

fact_hull = (a: FactBound, b: FactBound, at: int) -> FactBound:
    FactBound(min(a.lo, b.lo), max(a.hi, b.hi), (a.nz or a.lo > 0 or a.hi < 0) and (b.nz or b.lo > 0 or b.hi < 0), fact_hull_reason(at), at, a.wide or b.wide)
fact_hull_reason = (at: int) -> FactReason:
    if at != 0 and (nodes[at].kind == .while_ or nodes[at].kind == .for_): FactReason.loop_ else: FactReason.join
# Every value's interval hulled at once: the reason is the join point's.
fact_hull_all = (s: mut FactState, a: FactState, b: FactState, count: int, at: int):
    ap = data(a.bounds)
    bp = data(b.bounds)
    if ap == bp: return
    reason = fact_hull_reason(at)
    unique = false
    sp: *FactBound = null
    loop i in [0..count):
        xp = ap + i
        yp = bp + i
        if xp.lo == yp.lo and xp.hi == yp.hi and xp.nz == yp.nz and xp.wide == yp.wide and xp.reason == yp.reason and xp.witness == yp.witness: continue
        h = FactBound(min(xp.lo, yp.lo), max(xp.hi, yp.hi), (xp.nz or xp.lo > 0 or xp.hi < 0) and (yp.nz or yp.lo > 0 or yp.hi < 0), reason, at, xp.wide or yp.wide)
        if not unique:
            s.bounds[i] = h
            sp = data(s.bounds)
            unique = true
        else:
            sp[i] = h
# A phi keeps a shared representation, including a fixed word's finite
# endpoints and uint64's biased encoding. Bounds still join independently.
# O(1); never recover a fixed type from only one predecessor.
# Different representations whose values both have finite host endpoints (a
# fixed signed or narrow word, a singleton) share int64's: the hull is finite.
# uint64's biased encoding joins only itself. O(1) per differing binding.
# A conditional array or text keeps the hull of its live arms' lengths (`let [a b]
# = if c [x y] else [z w]` unpacks two). Only when every arm's length is
# known; demanded values only. O(1) indexed projection lookups.
fact_join_length = (s: mut FactState, v: int, a: FactState, x: int, b: FactState, y: int, at: int):
    kind = tkind(fact_type(fact_terms[v].type))
    if (kind != .array and kind != .str_) or s.projections.len() >= FACT_CAP or not a.live and not b.live: return
    bound = FactBound()
    seen = false
    loop arm in [0..2):
        st = if arm == 0: a else: b
        if not st.live: continue
        w = if arm == 0: x else: y
        if w == 0: return
        pi = fact_projection_find(st, w, -1, false)
        if pi < 0: return
        c = fact_bound(st, st.projections[pi].value)
        if c.wide: return
        bound = if seen: fact_hull(bound, c, at) else: c
        seen = true
    fact_add_projection(s, FactProjection(v, -1, false, fact_new(s, bound, FactTerm(type = T_INT))))
fact_join_term = (sa: FactState, a: int, sb: FactState, b: int) -> FactTerm:
    t = fact_terms[a].type
    if t == fact_terms[b].type: return FactTerm(type = t)
    # (finite through a guard row too, as fact_hull_type: an untyped hull's MIN/MAX would be open)
    FactTerm(type = if fact_host_finite(sa, a) and fact_host_finite(sb, b): T_INT else: 0)
# A value hull (a conditional expression, coalescing, match arms) keeps its
# static type unless that is mathematical int and both incoming values have
# finite host endpoints; then the hull is a finite int64 value. Bounded by
# the incident rows fact_host_endpoint inspects; evaluated once per hull.
fact_hull_type = (t: int, sa: FactState, a: int, sb: FactState, b: int) -> int:
    if fact_type(t) != T_MATH_INT or not fact_host_finite(sa, a) or not fact_host_finite(sb, b): return t
    T_INT
# A dictionary one path grew by adding keys (`if c d[k] = x`) from the
# comprehension dictionary the other kept, or both grew from one: the merge
# holds every key that dictionary held. O(1) indexed lookups per renamed binding.
fact_join_grown = (s: mut FactState, a: FactState, va: int, b: FactState, vb: int, merged: int):
    ra = fact_grown_root(a, va)
    if ra == 0 or ra != fact_grown_root(b, vb) or fact_slot(s, ra) < 0 or s.projections.len() >= FACT_CAP: return
    fact_add_projection(s, FactProjection(merged, FACT_MAP_GROWN, false, ra))
# The comprehension dictionary map is or grew from, or 0. O(1).
fact_grown_root = (s: FactState, map: int) -> int:
    if fact_grown_roots.has(map): return map
    g = fact_projection_find(s, map, FACT_MAP_GROWN, false)
    if g < 0: return 0
    s.projections[g].value
# After a key-adding store: after holds every key of before's root, or of
# before itself when its key positions are known (a comprehension's after
# entry changes, fact_map_member). O(1).
fact_map_grew = (s: mut FactState, before: int, after: int):
    if before == 0 or fact_slot(s, before) < 0: return
    root = fact_grown_root(s, before)
    if root == 0 and fact_projection_find(s, before, FACT_MAP_POSITIONS, false) >= 0: root = before
    if root != 0 and fact_slot(s, root) >= 0 and s.projections.len() < FACT_CAP: fact_add_projection(s, FactProjection(after, FACT_MAP_GROWN, false, root))
fact_host_finite = (s: FactState, v: int) -> bool:
    if v == 0 or fact_type(fact_terms[v].type) == T_U64: return false
    fact_host_value(s, v) or fact_host_endpoint(s, v, false) and fact_host_endpoint(s, v, true)
fact_join = (a: FactState, b: FactState, at: int) -> FactState:
    if not a.live: return b
    if not b.live: return a
    # Identical frames need only an interval hull. In particular, branching
    # on a captured guard need not rebuild every immutable projection index.
    same_ids = a.ids.len() == b.ids.len() and (data(a.ids) == data(b.ids) or a.ids == b.ids)
    same_cond = a.conditional.len() == b.conditional.len() and (data(a.conditional) == data(b.conditional) or a.conditional == b.conditional)
    same_bind = false
    bind_checked = false
    same_proj = false
    proj_checked = false
    if same_ids and same_cond:
        same_bind = a.bindings.len() == b.bindings.len() and (data(a.bindings) == data(b.bindings) or a.bindings == b.bindings)
        bind_checked = true
        if same_bind:
            same_proj = a.projections.len() == b.projections.len() and (data(a.projections) == data(b.projections) or a.projections == b.projections)
            proj_checked = true
            if same_proj and a.differences.len() == b.differences.len() and (data(a.differences) == data(b.differences) or a.differences == b.differences):
                s = a
                s.cmp_mask = a.cmp_mask | b.cmp_mask
                s.full = false
                fact_hull_all(s, a, b, s.bounds.len(), at)
                return s
    s = FactState(index = [FactIndexes()])
    s.cmp_mask = a.cmp_mask | b.cmp_mask
    # (both paths usually inherit one list: keep it without hashing)
    if same_cond: s.conditional = a.conditional
    else if a.conditional.len() > 0 and b.conditional.len() > 0:
        evidence_index: {ResultEvidence: bool} = {}
        loop evidence in b.conditional: evidence_index[evidence] = true
        loop evidence in a.conditional:
            if evidence_index.has(evidence): s.conditional.push(evidence)
    # Keep immutable evaluations shared by both paths, including snapshots.
    shared = true
    ids_match_a = same_ids
    ids_match_b = same_ids
    if same_ids:
        s.ids = a.ids
        s.index[0].slots = a.index[0].slots
        s.bounds = a.bounds
        fact_hull_all(s, a, b, s.bounds.len(), at)
    else:
        # Both paths usually extend one entry frame with their own values: the
        # shared values are then a's prefix, kept with a's index. O(V).
        k = 0
        alen = a.ids.len()
        blen = b.ids.len()
        common = min(alen, blen)
        aids = data(a.ids)
        bids = data(b.ids)
        loop k < common and aids[k] == bids[k]: k += 1
        prefix = true
        if k < alen:
            sorted = a.index[0].slots.len() == 0 and b.index[0].slots.len() == 0
            disjoint = sorted and (k == blen or aids[alen - 1] < bids[k] or aids[k] > bids[blen - 1])
            if not disjoint:
                loop i in [k..alen):
                    if fact_slot(b, aids[i]) >= 0: prefix = false; break
        if prefix:
            if k < alen:
                s.ids = a.ids[0..k)
                s.bounds = a.bounds[0..k)
            else:
                s.ids = a.ids
                s.bounds = a.bounds
                ids_match_a = true
            if k == blen: ids_match_b = true
            s.index[0].slots = a.index[0].slots
            fact_hull_all(s, a, b, k, at)
        else:
            shared = false
            loop i in [0..alen):
                j = fact_slot(b, aids[i])
                if j >= 0: fact_add_value(s, aids[i], fact_hull(a.bounds[i], b.bounds[j], at))
    # When one path's projections are the other's first ones (the other path
    # only added projections), the shared projections are exactly the shorter
    # list: keep it with its index. O(P) comparisons, no hashing.
    from = -1
    if shared and not proj_checked:
        same_proj = a.projections.len() == b.projections.len() and (data(a.projections) == data(b.projections) or a.projections == b.projections)
    if same_proj and shared:
        from = 0
        if not ids_match_a:
            ap = data(a.projections)
            loop i in [0..a.projections.len()):
                if fact_slot_ref(s, ap[i].base) < 0 or fact_slot_ref(s, ap[i].value) < 0: from = -1; break
    else:
        kp = 0
        common_projections = min(a.projections.len(), b.projections.len())
        ap = data(a.projections)
        bp = data(b.projections)
        loop kp < common_projections and ap[kp] == bp[kp]: kp += 1
        if shared and (kp == a.projections.len() or kp == b.projections.len()):
            from = if kp == b.projections.len(): 1 else: 0
            skip_check = if from == 1: ids_match_b else: ids_match_a
            if not skip_check:
                if from == 1:
                    loop i in [0..b.projections.len()):
                        if fact_slot_ref(s, bp[i].base) < 0 or fact_slot_ref(s, bp[i].value) < 0: from = -1; break
                else:
                    loop i in [0..a.projections.len()):
                        if fact_slot_ref(s, ap[i].base) < 0 or fact_slot_ref(s, ap[i].value) < 0: from = -1; break
    if from >= 0:
        src = if from == 1: b else: a
        s.projections = src.projections
        s.proj_base_mask = src.proj_base_mask
        s.index[0].projection_index = src.index[0].projection_index
        s.index[0].projection_head = src.index[0].projection_head
        s.index[0].projection_tail = src.index[0].projection_tail
        s.index[0].projection_next = src.index[0].projection_next
        s.index[0].projection_value = src.index[0].projection_value
    else if b.projections.len() > 0:
        # (b holds p when p is on b's chain for p.base: every projection is chained)
        ap = data(a.projections)
        bp = data(b.projections)
        b_pmask0 = b.proj_base_mask
        loop i in [0..a.projections.len()):
            p = ap[i]
            if (b_pmask0 & (1 << (p.base & 63))) == 0: continue
            if fact_slot_ref(s, p.base) < 0 or fact_slot_ref(s, p.value) < 0: continue
            qi = fact_projection_first(b, p.base)
            loop qi >= 0:
                if bp[qi] == p: break
                qi = fact_projection_after(b, qi)
            if qi >= 0: fact_add_projection(s, p)
    if same_proj and (same_bind or (not bind_checked and a.bindings.len() == b.bindings.len() and (data(a.bindings) == data(b.bindings) or a.bindings == b.bindings))):
        s.bindings = a.bindings
        s.index[0].roots = a.index[0].roots
        fact_join_shared_rows(s, a, b)
        return s
    renamed = false
    left = fj_left_pool; fj_left_pool = []; left.clear()
    right = fj_right_pool; fj_right_pool = []; right.clear()
    merged = fj_merged_pool; fj_merged_pool = []; merged.clear()
    chg_l = fj_chg_l_pool; fj_chg_l_pool = []; chg_l.clear()
    chg_r = fj_chg_r_pool; fj_chg_r_pool = []; chg_r.clear()
    chg_idx = fj_chg_idx_pool; fj_chg_idx_pool = []; chg_idx.clear()
    # (merged value pairs: identity pairs (v, v) use O(1) generation stamp;
    # changed pairs scan a tiny list, then an open-address index)
    pairs = fj_pairs_pool; fj_pairs_pool = []; pairs.clear()
    term_cap = fact_terms.len() + 1
    sg = fj_ensure_same(term_cap)
    same_gen_p = data(fj_same_gen)
    same_idx_p = data(fj_same_idx)
    # Both paths keep their common ancestor's bindings in its order (a place
    # is appended when first bound): the aligned positions merge in place,
    # keeping a's positions and so a's root index. O(1) each, no hashing
    # unless the values differ.
    aligned = 0
    abp = data(a.bindings)
    bbp = data(b.bindings)
    common = min(a.bindings.len(), b.bindings.len())
    loop aligned < common:
        ap = abp + aligned
        bp = bbp + aligned
        if ap.place.declaration != bp.place.declaration or ap.place.root != bp.place.root or ap.place.owner != bp.place.owner or ap.place.parent != bp.place.parent or ap.place.projection != bp.place.projection or ap.place.selector != bp.place.selector: break
        aligned += 1
    if aligned < a.bindings.len(): s.bindings = a.bindings[0..aligned)
    else: s.bindings = a.bindings
    s.index[0].roots = a.index[0].roots
    loop i in [0..aligned):
        ap = abp + i
        bp = bbp + i
        bval = ap.value
        other = bp.value
        if bval == other:
            if ap.event != 0 and bp.event != ap.event:
                s.bindings[i] = FactBinding(ap.place, bval)
            if bval >= 0 and bval < term_cap:
                if same_gen_p[bval] != sg:
                    same_gen_p[bval] = sg
                    same_idx_p[bval] = i32(left.len())
                    left.push(bval)
                    right.push(bval)
                    merged.push(bval)
            else:
                prior = fact_pair_find(chg_l, chg_r, pairs, bval, bval)
                if prior < 0:
                    pair = fact_pair_key(bval, bval)
                    fact_pair_add(chg_l, chg_r, pairs, pair)
                    chg_l.push(bval); chg_r.push(bval); chg_idx.push(left.len())
                    left.push(bval); right.push(bval); merged.push(bval)
            continue
        renamed = true
        v = bval
        prior = fact_pair_find(chg_l, chg_r, pairs, bval, other)
        if prior >= 0: v = data(merged)[data(chg_idx)[prior]]
        else:
            v = fact_new(s, fact_hull(fact_bound(a, v), fact_bound(b, other), at), fact_join_term(a, v, b, other))
            fact_join_grown(s, a, bval, b, other, v)
        # (the tombstone survives when both paths share it)
        if v != bval or (ap.event != 0 and bp.event != ap.event):
            s.bindings[i] = FactBinding(ap.place, v)
        if prior < 0:
            pair = fact_pair_key(bval, other)
            fact_pair_add(chg_l, chg_r, pairs, pair)
            chg_l.push(bval); chg_r.push(other); chg_idx.push(left.len())
            left.push(bval); right.push(other); merged.push(v)
    loop ai in [aligned..a.bindings.len()):
        binding = abp[ai]
        j = fact_binding(b, binding.place)
        if j < 0: continue
        other = bbp[j].value
        bval = binding.value
        v = bval
        prior = -1
        if bval == other and bval >= 0 and bval < term_cap:
            if same_gen_p[bval] == sg: prior = int(same_idx_p[bval])
        else:
            if bval != other: renamed = true
            cp = fact_pair_find(chg_l, chg_r, pairs, bval, other)
            if cp >= 0: prior = data(chg_idx)[cp]
        if prior >= 0: v = data(merged)[prior]
        else if v != other:
            v = fact_new(s, fact_hull(fact_bound(a, v), fact_bound(b, other), at), fact_join_term(a, v, b, other))
            fact_join_grown(s, a, bval, b, other, v)
        fact_bind(s, binding.place, v)
        if v == bval and bbp[j].event == binding.event: fact_rebind(s, binding.place, v, binding.event, binding.prior)
        if prior < 0:
            if bval == other and bval >= 0 and bval < term_cap:
                same_gen_p[bval] = sg
                same_idx_p[bval] = i32(left.len())
            else:
                pair = fact_pair_key(bval, other)
                fact_pair_add(chg_l, chg_r, pairs, pair)
                chg_l.push(bval); chg_r.push(other); chg_idx.push(left.len())
            left.push(bval); right.push(other); merged.push(v)
    binding_pairs = merged.len()
    # Match projections of merged aggregate values, including current lengths.
    # (each side's non-element projections chained by base value, in order:
    # the same matches as scanning both lists for every merged value)
    if a.projections.len() > 0 and b.projections.len() > 0:
        cursor = 0
        element_keys_ready = false
        ap_p = data(a.projections)
        bp_p = data(b.projections)
        a_pmask = a.proj_base_mask
        b_pmask = b.proj_base_mask
        loop cursor < merged.len() and merged.len() < FACT_CAP:
            lv = data(left)[cursor]
            rv = data(right)[cursor]
            if (same_proj and lv == rv) or (a_pmask & (1 << (lv & 63))) == 0 or (b_pmask & (1 << (rv & 63))) == 0:
                cursor += 1
                continue
            pi = fact_projection_first(a, lv)
            loop pi >= 0:
                p = ap_p[pi]
                pi = fact_projection_after(a, pi)
                selector = p.selector
                qi = fact_projection_find(b, rv, selector, p.element)
                if p.element:
                    key = fact_bound(a, selector)
                    if key.lo == key.hi and not key.wide:
                        # Constants created separately in the arms have different
                        # value IDs. Index the peer's constant selectors once, O(P).
                        if not element_keys_ready:
                            fj_elem_keys.clear()
                            loop j in [0..b.projections.len()):
                                candidate = bp_p[j]
                                if not candidate.element: continue

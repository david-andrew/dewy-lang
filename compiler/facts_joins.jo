        else if aa != row.a and bb == row.b and ra == rb and ra != 0 and row.limit < 0: fact_difference(s, aa, bb, 0, row.at)
fj_join_pair_rows_fast = (s: mut FactState, from: FactState, peer: FactState, v: int, w: int, m: int, to_theirs_g: *i32, to_theirs_v: *i32, to_merged_g: *i32, to_merged_v: *i32, rg: i32, rcap: int, pids: *int, pn_ids: int, pslots: *int, pslots_n: int, gterms: *FactTerm, ngterms: int):
    loop direction in [0..2):
        ri = fact_difference_head(from, v, direction)
        loop ri >= 0:
            row = data(from.differences)[ri]
            ri = fact_difference_next(from, ri, direction)

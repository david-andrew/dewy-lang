# An optional's tag known to be `none` (0) in s. O(1).
fact_known_none = (s: FactState, v: int) -> bool:
    ti = fact_projection_find(s, v, -3, false)
    if ti < 0: return false
    b = fact_bound(s, s.projections[ti].value)
    not b.wide and b.lo == 0 and b.hi == 0
fact_known_some = (s: FactState, v: int) -> bool:
    ti = fact_projection_find(s, v, -3, false)
    if ti < 0: return false
    b = fact_bound(s, s.projections[ti].value)
    not b.wide and b.lo == 1 and b.hi == 1
# A merged optional integer whose tag is not 1 on every path (`let best:int?
# = none`, then `if c best = i`): its payload exists only where the merged
# tag is 1. A fact about it that every path holding a payload proves (as a
# row, an interval, or its own tag implication) becomes an implication from
# the merged tag, applied when `is? int`, `??` or a pattern narrows it. Never
# a row: a row through a payload one path lacks would relate that path's
# other values. x in a and y in b merge into m; for a join, left/right/merged
# rename (fact_rename), for a loop header they are empty and only values
# present in s qualify. Demand: optional integer bindings that differ.
# O(B + rows and implications of the payloads), at most 32 candidates, each
# one bounded distance query per path, and 4 implications.
fact_join_payload = (s: mut FactState, a: FactState, x: int, b: FactState, y: int, m: int, left: int[], right: int[], merged: int[], bound: FactBound, header: bool):
    if not s.live or s.conditional.len() + 4 > 32: return
    t = fact_type(fact_terms[m].type)
    pt = fact_summary_payload(t)
    if pt == 0 or fact_known_some(a, x) and fact_known_some(b, y): return
    na = not a.live or fact_known_none(a, x)
    nb = not b.live or fact_known_none(b, y)
    if na and nb: return
    pa = if na: 0 else: fact_projection_value(a, x, -4)
    pb = if nb: 0 else: fact_projection_value(b, y, -4)
    if not na and pa == 0 or not nb and pb == 0: return
    held = 0
    loop evidence in s.conditional: held += int(evidence.tag == -2)
    if held >= 12: return
    tag = fact_projection_value(s, m, -3)
    if tag == 0:
        tag = fact_new(s, FactBound(0, 1), FactTerm(type = T_INT))
        fact_add_projection(s, FactProjection(m, -3, false, tag))
    v = fact_projection_value(s, m, -4)
    if v == 0:
        if na or nb:
            # (one path's payload; a loop header widens it as any changing scalar)
            p = if na: pb else: pa
            from = if na: b else: a
            v = if header: fact_new(s, bound, FactTerm(type = pt)) else if fact_slot(s, p) >= 0: p else: fact_new(s, fact_bound(from, p), FactTerm(type = pt))
        else:
            both = if header: bound else: fact_hull(fact_bound(a, pa), fact_bound(b, pb), 0)
            v = fact_new(s, both, FactTerm(type = pt))
        fact_add_projection(s, FactProjection(m, -4, false, v))
    ta = fact_projection_value(a, x, -3)
    tb = fact_projection_value(b, y, -3)
    # Candidates (op, operand) from the paths that hold a payload, in their frames.
    ops: Tok[]
    operands: int[]
    sides: int[]
    loop side in [0..2):
        if side == 0 and na or side == 1 and nb: continue
        st = if side == 0: a else: b
        p = if side == 0: pa else: pb
        tg = if side == 0: ta else: tb
        loop direction in [0..2):
            ri = fact_difference_head(st, p, direction)
            loop ri >= 0 and ops.len() < 32:
                row = st.differences[ri]
                ri = fact_difference_next(st, ri, direction)
                if row.limit > 0: continue
                strict = row.limit < 0
                if direction == 1:
                    op = if strict: Tok.lt else: Tok.le
                    ops.push(op); operands.push(row.b)
                else:
                    op = if strict: Tok.gt else: Tok.ge
                    ops.push(op); operands.push(row.a)
                sides.push(side)
        loop evidence in st.conditional:
            if evidence.tag != -2 or ops.len() >= 32: continue
            r = fact_implications[evidence.base - 1]
            if r.k == 2 and r.op0 == .eq and r.a0 == tg and r.b0 == 1 and r.a1 == p: ops.push(r.op1); operands.push(r.b1); sides.push(side)
        # (the lengths of the bound arrays and their fields: an index's limits;
        # the first 64 bindings, parameters and early locals)
        scanned = 0
        loop binding in st.bindings:
            scanned += 1
            if ops.len() >= 32 or scanned > 64: break
            pi = fact_projection_first(st, binding.value)
            depth = 0
            loop pi >= 0 and depth < 8 and ops.len() < 32:
                q = st.projections[pi]
                pi = fact_projection_after(st, pi)
                depth += 1
                if q.element: continue
                length = if q.selector == -1: q.value else: fact_projection_value(st, q.value, -1)
                if length != 0: ops.push(Tok.lt); operands.push(length); sides.push(side)
    done_ops: Tok[]
    done: int[]
    loop i in [0..ops.len()):
        if done.len() >= 4 or held + done.len() >= 12: break
        side = sides[i]
        st = if side == 0: a else: b
        o = operands[i]
        target = if side == 0: fact_rename(o, left, merged, [], s) else: fact_rename(o, right, merged, [], s)
        if target == 0 or target == v: continue
        duplicate = false
        loop j in [0..done.len()):
            if done_ops[j] == ops[i] and done[j] == target: duplicate = true; break
        if duplicate: continue
        mine_tag = if side == 0: ta else: tb
        mine_payload = if side == 0: pa else: pb
        if not fact_payload_holds(st, mine_tag, mine_payload, ops[i], o): continue
        # (the other path: none, or it proves the same of its own payload)
        peer_none = if side == 0: nb else: na
        if not peer_none:
            peer = if side == 0: b else: a
            peer_tag = if side == 0: tb else: ta
            peer_payload = if side == 0: pb else: pa
            po = if side == 0: fact_rename(o, left, right, [], b) else: fact_rename(o, right, left, [], a)
            if po == 0 or not fact_payload_holds(peer, peer_tag, peer_payload, ops[i], po): continue
        fact_implication(s, (Tok.eq, 0, tag, 1, 1), (ops[i], 0, v, 0, target))
        done_ops.push(ops[i]); done.push(target)
# The non-element projection value of base at selector in s, or 0. O(1).
fact_projection_value = (s: FactState, base: int, selector: int) -> int:
    pi = fact_projection_find(s, base, selector, false)
    if pi >= 0: s.projections[pi].value else: 0
# Whether payload p (tag t) relates to o by op in s, wherever the payload
# exists: a row or the intervals, or s's own implication from its tag.
# One bounded distance query plus O(implications).
fact_payload_holds = (s: FactState, t: int, p: int, op: Tok, o: int) -> bool:
    if op == .lt and fact_entails(s, p, o, -1) or op == .le and fact_entails(s, p, o, 0): return true
    if op == .gt and fact_entails(s, o, p, -1) or op == .ge and fact_entails(s, o, p, 0): return true
    if t == 0: return false
    loop evidence in s.conditional:
        if evidence.tag != -2: continue
        r = fact_implications[evidence.base - 1]
        if r.k == 2 and r.op0 == .eq and r.a0 == t and r.b0 == 1 and r.op1 == op and r.a1 == p and r.b1 == o: return true
    false
# v renamed through the last i with from[i] == v (an index once there are many).
fact_rename = (v: int, from: int[], to: int[], index: int[], shared: FactState) -> int:
    if index.len() != 0:
        value = fact_index_get(index, v)
        if value >= 0: return value
    else:
        i = from.len() - 1
        loop i >= 0:
            if from[i] == v: return to[i]
            i -= 1
    if fact_slot(shared, v) >= 0: return v
    0
# The first merged pair (v, other): a scan over at most 32, then indexed.
fact_pair_find = (left: int[], right: int[], index: int[], v: int, other: int) -> int:
    if index.len() != 0: return fact_index_get(index, fact_pair_key(v, other))
    loop i in [0..left.len()):
        if left[i] == v and right[i] == other: return i
    -1
fact_pair_add = (left: int[], right: int[], index: mut int[], pair: int):
    if index.len() == 0 and left.len() >= 32:
        index = fact_index_sized(64)
        loop i in [0..left.len()):
            key = fact_pair_key(left[i], right[i])
            if fact_index_get(index, key) < 0: fact_index_put(index, key, i)
    if index.len() != 0: fact_index_put(index, pair, left.len())
# A narrowed name's payload, `.narrow`/`.unwrap` of a variable (fact_capture's -4).
fact_payload_node = (e: int) -> bool: (nodes[e].kind == .narrow or nodes[e].kind == .unwrap) and nodes[e].a != 0
fact_field_node = (e: int) -> bool:
    nodes[e].kind == .field and (nodes[e].aux >= 0 and tkind(ntype(int(nodes[e].a))) == .struct_ or nodes[e].aux == -2 and tkind(ntype(int(nodes[e].a))) == .tuple)
# Branches often change only intervals and guard rows. Their storage identities
# need no phi pairs or projection matching, only the common relation facts.
fact_join_shared_rows = (s: mut FactState, a: FactState, b: FactState):
    common = 0
    adp = data(a.differences)
    bdp = data(b.differences)
    alen = a.differences.len()
    blen = b.differences.len()
    same_a = s.ids.len() == a.ids.len() and data(s.ids) == data(a.ids)
    same_b = s.ids.len() == b.ids.len() and data(s.ids) == data(b.ids)
    if same_a and alen == blen and adp == bdp:
        s.differences = a.differences
        s.diff_a_mask = a.diff_a_mask
        s.diff_b_mask = a.diff_b_mask
        s.index[0].difference_index = a.index[0].difference_index
        s.index[0].difference_value = a.index[0].difference_value
        s.index[0].difference_record = a.index[0].difference_record
        s.index[0].difference_next = a.index[0].difference_next
        return
    mindiff = min(alen, blen)
    loop common < mindiff:
        row = adp[common]
        if row != bdp[common] or (not same_a and (fact_slot_ref(s, row.a) < 0 or fact_slot_ref(s, row.b) < 0)): break
        common += 1
    if common == alen:
        s.differences = a.differences
        s.diff_a_mask = a.diff_a_mask
        s.diff_b_mask = a.diff_b_mask
        s.index[0].difference_index = a.index[0].difference_index
        s.index[0].difference_value = a.index[0].difference_value
        s.index[0].difference_record = a.index[0].difference_record
        s.index[0].difference_next = a.index[0].difference_next
    else if common == blen:
        s.differences = b.differences
        s.diff_a_mask = b.diff_a_mask
        s.diff_b_mask = b.diff_b_mask
        s.index[0].difference_index = b.index[0].difference_index
        s.index[0].difference_value = b.index[0].difference_value
        s.index[0].difference_record = b.index[0].difference_record
        s.index[0].difference_next = b.index[0].difference_next
    else:
        loop i in [0..common): fact_add_difference(s, adp[i])
    loop i in [common..alen):
        row = adp[i]
        if (same_a or (fact_slot_ref(s, row.a) >= 0 and fact_slot_ref(s, row.b) >= 0)) and fact_distance(b, row.a, row.b, row.limit): fact_difference(s, row.a, row.b, row.limit, row.at)
    loop i in [common..blen):
        row = bdp[i]
        if (same_b or (fact_slot_ref(s, row.a) >= 0 and fact_slot_ref(s, row.b) >= 0)) and fact_distance(a, row.a, row.b, row.limit): fact_difference(s, row.a, row.b, row.limit, row.at)

# Projection identity/construction services share the existing facts_values import.

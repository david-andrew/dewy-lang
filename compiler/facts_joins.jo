        if fj_ren_lookup(lp2[i], lm_gen_p, lm_val_p, rg, rcap, s) != mp2[i]: fj_join_pair_rows_fast(s, a, b, lp2[i], rp2[i], mp2[i], lr_gen_p, lr_val_p, lm_gen_p, lm_val_p, rg, rcap, bids_p, bn_ids, bslots_p, bslots_n, gterms, ngterms)
    fj_left_pool = left; fj_right_pool = right; fj_merged_pool = merged

$runtime_checks
from p"expression_types.dewy" import (ntype)

from p"member_plan.dewy" import (member_fact_ready member_fact_view)

from p"@lib/core/os.jo" import (eprint)
from p"ast.jo" import (kid lists nkids nodes)
from p"node_store.dewy" import (Node)
from p"checker_state.dewy" import (Local)
from p"check.jo" import (fns locals)
from p"directives.jo" import (dir_proven)
from p"directive_queries.dewy" import (dir_index)
from p"exact.jo" import (exact_marks exact_owners)
from p"expr.jo" import (rational_constants)
from p"facts.jo" import (FactState fact_constructor_actuals fact_fork_entries fact_member_admitted fact_member_failed fact_member_owner fact_member_shared fact_member_template fact_owner fact_parallel_bounds fact_policy fact_probe_on fact_query fact_speculating fact_summary_owner fact_terms fact_validated)
from p"facts_slice_builder.dewy" import (fact_slice_prepare)
from p"facts_capture.dewy" import (fact_capture)
from p"facts_forks.dewy" import (fact_fork_seed)
from p"facts_changes.dewy" import (fact_changes)
from p"float_ops.dewy" import (ff_integer_demand)
from p"ide.jo" import (ide_on)
from p"isolation_ops.dewy" import (iso_child_p isolation_children isolation_node_children)
from p"member_replay.jo" import (member_scope_locals member_scopes member_templates member_trace member_uniform_blocks)
from p"ownership.jo" import (ownership_decls)
from p"proofs.jo" import (proof_active result_active)
from p"refine.jo" import (refine_active refine_requests)
from p"refine_transfers.dewy" import (refine_fact_entry)
from p"refinement_types.dewy" import (FactTerm)
from p"types.jo" import (tkind)
from p"util.jo" import (err_notes)
from p"source_queries.dewy" import (pos_str)
from p"witness.jo" import (wit_tentative wit_tentative_failed)

MemberWord:type=int64<overflow='wrap'>
fact_member_literal=(n:MemberWord):>bool=>$unsafe {
    fact_member_template >=? 0 and member_templates[fact_member_template].positions.has(nodes.ptr[n].pos)
}
fact_member_candidate=(f:MemberWord):>bool=>{
    if member_templates.length =? 0 or fact_policy not=? 'RequireStatic' or fact_probe_on or fact_query or wit_tentative or proof_active or result_active or ide_on {return false}
    if ownership_decls.length not=? 0 or exact_owners.has(f) or fact_summary_owner not=? 0 {return false}
    loop i in [0..member_templates.length) {
        if member_templates[i].owner =? f and member_templates[i].okay {return true}
    }
    false
}
# x and y are the same checked syntax but for member literals and local
# copies. Pairs of the nodes a decision can mark (dir_index, fact_validated)
# go onto pairs. O(nodes), field reads only.
let fms_index:MemberWord=0
let fms_pairs:array<int64>=[]
let fms_has_exact:bool=false
let fms_has_rat:bool=false
let fms_has_pos:bool=false
let fms_locals:ptr<Local>=$unsafe (uint64(0) as ptr<Local>)
let fms_exact:ptr<uint8>=$unsafe (uint64(0) as ptr<uint8>)
let fms_nexact:MemberWord=0

fact_member_same=(x:MemberWord y:MemberWord index:MemberWord @pairs:array<int64>):>bool=>$unsafe {
    fms_index=index
    fms_pairs=pairs
    pairs=[]
    fms_has_exact=exact_marks.length >? 0
    fms_has_rat=rational_constants.length not=? 0
    fms_has_pos=member_templates.ptr[index].positions.length >? 0
    fms_locals=locals.ptr
    fms_nexact=exact_marks.length
    if fms_has_exact {fms_exact=exact_marks.ptr}
    let ok=fact_member_same_fast(x y)
    pairs=fms_pairs
    fms_pairs=[]
    ok
}
let fms_sx:array<int64>=[]
let fms_sy:array<int64>=[]

fact_member_same_fast=(x0:MemberWord y0:MemberWord):>bool=>$unsafe {
    if fms_sx.length <? 256 {
        fms_sx.resize(256)
        fms_sy.resize(256)
    }
    let sx=fms_sx.ptr
    let sy=fms_sy.ptr
    let scap:MemberWord=fms_sx.length
    let sp:MemberWord=1
    sx[0]=x0
    sy[0]=y0
    let lp0=fms_locals
    let icp=iso_child_p
    let has_exact=fms_has_exact
    let nexact=fms_nexact
    let exactp=fms_exact
    let has_rat=fms_has_rat
    let has_pos=fms_has_pos
    loop sp >? 0 {
        sp -= 1
        let x:MemberWord=sx[sp]
        let y:MemberWord=sy[sp]
        if x =? 0 or y =? 0 {
            if x not=? y {return false}
            continue
        }
        let left=nodes[x]
        let right=nodes[y]
        let k=left.kind
        if k not=? right.kind or left.pos not=? right.pos or left.type not=? right.type or left.flags not=? right.flags {return false}
        if has_exact and ((x <? nexact and exactp[x] not=? uint8(0)) or (y <? nexact and exactp[y] not=? uint8(0))) {return false}
        if has_rat and (rational_constants.has(x) or rational_constants.has(y)) {return false}
        if k =? 'ident' {
            if left.name not=? right.name or left.aux not=? right.aux or left.aux2 not=? right.aux2 or left.op not=? right.op or left.ival not=? right.ival or left.sval not=? right.sval or left.d not=? right.d or left.nlist not=? right.nlist or left.nlist2 not=? 0 or right.nlist2 not=? 0 {return false}
            if left.sym not=? right.sym {
                if left.aux not=? int32(1) or left.sym <=? 0 or right.sym <=? 0 {return false}
                let lx=MemberWord(left.sym)
                let ly=MemberWord(right.sym)
                if lp0[lx].type not=? lp0[ly].type or lp0[lx].flags not=? lp0[ly].flags {return false}
            }
            continue
        }
        if k =? 'int_lit' {
            if left.ival not=? right.ival or left.aux not=? right.aux or left.aux2 not=? right.aux2 or left.sym not=? right.sym or left.op not=? right.op or left.name not=? right.name or left.sval not=? right.sval or left.d not=? right.d or left.nlist not=? right.nlist or left.nlist2 not=? 0 or right.nlist2 not=? 0 {return false}
            continue
        }
        if left.op not=? right.op or left.ival not=? right.ival or left.name not=? right.name or left.aux2 not=? right.aux2 or left.d not=? right.d or left.nlist not=? right.nlist or left.nlist2 not=? 0 or right.nlist2 not=? 0 {return false}
        if has_pos and (k =? 'str_lit' or k =? 'dotname') and member_templates.ptr[fms_index].positions.has(left.pos) {
            if k =? 'dotname' and tkind(ntype(x)) =? 'enum_' or k =? 'str_lit' and (left.aux not=? 0 or left.nlist not=? 0) {return false}
        }
        else if left.sval not=? right.sval or left.aux not=? right.aux {return false}
        if left.sym not=? right.sym {
            if k not=? 'vardecl' or left.sym <=? 0 or right.sym <=? 0 {return false}
            let lx=MemberWord(left.sym)
            let ly=MemberWord(right.sym)
            if lp0[lx].type not=? lp0[ly].type or lp0[lx].flags not=? lp0[ly].flags {return false}
        }
        match k {
            <'float_lit'|'bool_lit'|'none_lit'|'null_lit'|'dotname'|'hole'|'break_'|'continue_'|'pwild'|'lambda'> => {continue}
            _ => {}
        }
        if k =? 'index' or k =? 'intrinsic' or k =? 'conv' {
            if k =? 'conv' and ff_integer_demand(x) {return false}
            fms_pairs.push(x)
            fms_pairs.push(y)
        }
        let mask=MemberWord(icp[int64(((nodes.ptr + x) as ptr<uint32>)[0])])
        if mask <? 0 {return false}
        let nlist:MemberWord=if mask & 16 not=? 0 {MemberWord(nodes[x].nlist)} else {0}
        if sp + nlist + 3 >? scap {
            scap=(sp + nlist + 3) * 2
            fms_sx.resize(scap)
            fms_sy.resize(scap)
            sx=fms_sx.ptr
            sy=fms_sy.ptr
        }
        if nlist >? 0 {
            let lx=MemberWord(nodes[x].list)
            let ly=MemberWord(nodes[y].list)
            let i:MemberWord=nlist - 1
            loop i >=? 0 {
                let cx=MemberWord(lists[lx + i])
                let cy=MemberWord(lists[ly + i])
                if (cx | cy) not=? 0 {
                    sx[sp]=cx; sy[sp]=cy; sp += 1
                }
                i -= 1
            }
        }
        if mask & 4 not=? 0 {
            let cx=MemberWord(nodes[x].c); let cy=MemberWord(nodes[y].c)
            if (cx | cy) not=? 0 {sx[sp]=cx; sy[sp]=cy; sp += 1}
        }
        if mask & 2 not=? 0 {
            let bx=MemberWord(nodes[x].b); let by=MemberWord(nodes[y].b)
            if (bx | by) not=? 0 {sx[sp]=bx; sy[sp]=by; sp += 1}
        }
        if mask & 1 not=? 0 {
            let ax=MemberWord(nodes[x].a); let ay=MemberWord(nodes[y].a)
            if (ax | ay) not=? 0 {sx[sp]=ax; sy[sp]=ay; sp += 1}
        }
    }
    true
}
# (the plan's admission of block b: member_lower_block's, every copy the same)
fact_member_admit=(b:MemberWord):>bool=>{
    let index=member_scopes.get(kid(b 0)) ?? -1
    if index <? 0 or not member_templates[index].okay or nkids(b) not=? member_templates[index].texts.length {return false}
    if member_templates[index].requests.length not=? 0 or member_templates[index].refinements.length not=? 0 {return false}
    let template=kid(b 0)
    let pairs:array<int64>=[]
    if member_templates[index].compact and member_templates[index].block =? b {
        fact_member_admitted[b]=member_templates[index].view_proofs
        return true
    }
    loop i in [0..nkids(b)) {
        let scope=kid(b i)
        if (member_scopes.get(scope) ?? -1) not=? index or not member_scope_locals.has(scope) {return false}
        if i >? 0 and not fact_member_same(template scope index @pairs) {return false}
    }
    fact_member_admitted[b]=pairs
    true
}
fact_member_block=(b:MemberWord @s:FactState):>bool=>{
    if not fact_member_admitted.has(b) or fact_owner not=? fact_member_owner or fact_summary_owner not=? 0 or fact_probe_on or fact_member_template >=? 0 {return false}
    let template=kid(b 0)
    fact_changes(template @s b)
    fact_member_template=member_scopes[template]
    fact_capture(template @s);
    fact_member_template=-1
    # (the template's decisions, at the same nodes of every other copy)
    if fact_speculating =? 0 {
        let pairs=fact_member_admitted[b]
        loop i in [0..pairs.length // 2) {
            let x=pairs[2 * i]
            let y=pairs[2 * i + 1]
            let proven=dir_proven.get(x)
            if proven not=? none {dir_index(y proven)}
            if fact_validated.has(x) {fact_validated[y]=true}
        }
    }
    true
}
# f decided with shared member blocks; false: no decision kept, decide it again.
fact_member_decide=(f:MemberWord):>bool=>$unsafe {
    let proven=dir_proven
    let validated=fact_validated
    let notes=err_notes
    member_fact_view(f true)
    fact_member_shared=true
    fact_member_owner=f
    fact_member_failed=false
    fact_member_admitted=dict<int64 array<int64>>()
    wit_tentative=true
    wit_tentative_failed=false
    let state=FactState()
    if refine_active or refine_requests.length >? 0 {refine_fact_entry(f @state)}
    if fact_fork_entries.length >? 0 or fact_parallel_bounds.length >? 0 {fact_fork_seed(f @state)}
    fact_slice_prepare(f)
    if member_fact_ready(f) {fact_capture(MemberWord(fns.ptr[f].body) @state);}
    else {fact_member_failed=true}
    let failed=fact_member_failed or wit_tentative_failed
    if member_trace and fact_member_admitted.length not=? 0 {
        let verdict="shared"
        if failed {verdict="decided again"}
        eprint("member facts {pos_str(nodes.ptr[MemberWord(fns.ptr[f].body)].pos)}: {fact_member_admitted.length} blocks, {verdict}")
    }
    wit_tentative=false
    wit_tentative_failed=false
    fact_member_shared=false
    fact_member_owner=0
    member_fact_view(f false not failed)
    if not failed {
        loop b in fact_member_admitted.keys() {member_uniform_blocks[b]=true}
        fact_member_admitted=dict<int64 array<int64>>()
        return true
    }
    fact_member_admitted=dict<int64 array<int64>>()
    dir_proven=proven
    fact_validated=validated
    err_notes=notes
    fact_terms=[FactTerm()]
    fact_constructor_actuals=dict<int64 array<int64>>()
    false
}

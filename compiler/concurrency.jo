use 'lower_helpers.dewy'
use 'checker_hooks.dewy'
use 'checker_state.dewy'
use 'checker_expr.dewy'
use 'effect_lattice.dewy'
use 'effect_types.dewy'
# Transfer facts and the waiting effect are independent of the scheduler and
# placement. Demand walks use a query-local visited set: a recursive backedge
# must never publish an optimistic nonblocking summary for another query.
# Each query visits its reachable types/functions and AST edges once, with
# indexed membership: expected O(V + E) time and O(V) auxiliary storage.
use 'check.jo'
use 'types.jo'
use 'effects.jo'
use 'lower.jo'
use 'isolation.jo'
use 'expr.jo'
use 'ast.jo'
use 'util.jo'
use 'refine.jo'
use 'ownership.jo'
use 'errors.jo'
use 'ffi.jo'
use 'deadlock.jo'
use 'lower_races.dewy'
use 'ffi_checks.dewy'
use 'effect_contracts.dewy'
use 'effect_sources.dewy'
use 'isolation_ops.dewy'
use 'concurrency_types.dewy'
use 'concurrency_waits.dewy'
use 'concurrency_parsafe.dewy'
use 'concurrency_tasks.dewy'

concurrency_calls: int[]
# A type's transfer rows (`$send=false`, `$sync=false`, claims `$send`/`$sync`,
# `$unsafe`), by its declaration; written by the Dewy parser, usually empty.
TRANSFER_SEND_OFF = 1
TRANSFER_SYNC_OFF = 2
TRANSFER_SEND_CLAIM = 4
TRANSFER_SYNC_CLAIM = 8
TRANSFER_UNSAFE = 16
transfer_tags: {int: int} = {}
transfer_claim_pos: {int: int} = {}
transfer_claims_checked: {int: bool} = {}
concurrency_reason = ""
concurrency_tasks: int[]
concurrency_runtime_needed = false
concurrency_thread_module = -1
concurrency_task_module = -1
concurrency_task_core_module = -1
concurrency_protocol_module = -1  # lib/prelude/protocols.dewy, once a program names it
concurrency_ffi_start = 0

# Settled waiting answers, by function. A query that finds no wait settles every
# function it visited (all their callees were visited too); one that finds a wait
# settles only its root. Effects asks once per function, so the whole program
# costs O(V + E) for nonblocking code instead of a walk per function.
concurrency_block_memo: {int: bool}

# ---------------- callbacks passed into parallel code ----------------
# docs/design/safety_and_concurrency.md, "Callbacks passed into parallel code". A function
# instance that passes a callback parameter into parallel code (a `parallel` call's function,
# or a call through the parameter inside it) records "argument i must be parallel-safe"
# (parsafe_req, by instance and parameter, with the site that made it). Each call of it then
# checks its argument i as that parallel call would (concurrency_callback, race_arg), or, when
# the argument is its own caller's parameter, passes the requirement up to that caller.
# Demand-driven: nothing runs unless a program's parallel call is given a callback parameter;
# then one walk indexes the program's direct calls and function values (O(nodes)), and a
# worklist visits each (instance, parameter) once.
struct ParSafeVia:
    site: int       # the parallel call, or the call passing the parameter on
    callee: int     # the function it is passed on to (0: site is the parallel call)
    param: int      # that function's parameter

parsafe_req: {int: ParSafeVia}
parsafe_fns: {int: bool}        # instances with some parallel-safe parameter
parsafe_work: int[]

# Zero-fill must not fabricate an identity whose private storage needs a factory.
# Only complete root queries are memoized; recursive backedges stay query-local.
concurrency_zero_types: {int: bool}

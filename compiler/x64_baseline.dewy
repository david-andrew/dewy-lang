        }
        <'map_lit'> => {
            let tinfo=bl_tinfo(BlWord(nodes.ptr[e].type))
            if (tinfo & 13) not=? 13 {return false}
            bl_scan_managed=true
            let nk=nkids(e)
            if nk =? 0 {return true}
            let f:BlWord=BlWord(nodes.ptr[e].sym)
            if f <=? 0 or fns.ptr[f].cabi or fns.ptr[f].has_env or fns.ptr[f].parallel_api or fns.ptr[f].deterministic {return false}
            if fns.ptr[f].ptypes.length <? 3 {return false}
            let kt0:BlWord=BlWord(fns.ptr[f].ptypes.ptr[1])
            let vt0:BlWord=BlWord(fns.ptr[f].ptypes.ptr[2])
            let kinfo=bl_tinfo(kt0)
            let vinfo=bl_tinfo(vt0)
            if (kinfo & 1) =? 0 or (vinfo & 1) =? 0 or (kinfo & 12) =? 0 or (vinfo & 12) =? 0 {return false}
            if (kinfo & 12) =? 8 or (vinfo & 12) =? 8 {bl_scan_has_float=true}
            let ck=bl_fn_copies_maybe and (kinfo & 32) not=? 0 and copy_consumes(f  1)
            let cv2=bl_fn_copies_maybe and (vinfo & 32) not=? 0 and copy_consumes(f  2)
            bl_scan_calls += nk
            loop i in [0..nk) {
                let p=kid(e i)
                let ka:BlWord=BlWord(nodes.ptr[p].a)
                let vb:BlWord=BlWord(nodes.ptr[p].b)
                if ck and not bl_copy_own_ok(ka  kt0) {return false}
                if cv2 and not bl_copy_own_ok(vb  vt0) {return false}
                bl_scan_push(vb)
                bl_scan_push(ka)
            }
            true
        }
        <'addr'> => {
            let a:BlWord=BlWord(nodes.ptr[e].a)
            if not bl_can_mut_place(a) {return false}
            bl_scan_push(a)
            true
        }
        <'call'> => {
            if once_slots.length >? 0 and once_slots.has(e) {return false}
            let aux=nodes.ptr[e].aux
            if aux =? 0 {
                if ownership_prints.length >? 0 and ownership_prints.has(e) {return false}
                bl_scan_calls += 1
                bl_scan_fn_calls += 1
                let sym:BlWord=BlWord(nodes.ptr[e].sym)
                if sym <=? 0 or sym =? runtime_memeq or sym =? runtime_streq or fns.ptr[sym].cabi or fns.ptr[sym].has_env or fns.ptr[sym].parallel_api {return false}
                let rtp=prune(BlWord(fns.ptr[sym].ret))
                let nt=prune(ntype(e))
                let ninfo:BlWord=if nt not=? T_NEVER {bl_tinfo(nt)} else {0}
                if rtp =? T_NEVER and nt not=? T_NEVER and (ninfo & 12) not=? 0 {return false}
                let rinfo:BlWord=if rtp not=? T_NEVER {bl_tinfo(rtp)} else {0}
                if rtp not=? T_NEVER and (rinfo & 1) =? 0 {return false}
                if nt not=? T_NEVER and (ninfo & 1) =? 0 {return false}
                if rtp not=? T_NEVER and (rinfo & 80) =? 16 {bl_scan_managed=true}
                let na:BlWord=BlWord(nodes.ptr[e].nlist)
                let lbase:BlWord=BlWord(nodes.ptr[e].list)
                let mm=inst_mutmask(sym)
                let npt=fns.ptr[sym].ptypes.length
                let cargs:array<int64>=[]
                let have_cargs=false
                let cs_set=false
                let cs=bl_fn_copy_strict
                loop i in [0..na) {
                    let arg:BlWord=BlWord(lists.ptr[lbase + i])
                    let pt0:BlWord=if i <? npt {BlWord(fns.ptr[sym].ptypes.ptr[i])} else {BlWord(nodes.ptr[arg].type)}
                    let pinfo=bl_tinfo(pt0)
                    if (pinfo & 1) =? 0 {return false}
                    let is_mut=(mm & (BlWord(1) << i)) not=? 0
                    if is_mut {
                        if not bl_can_mut_place(arg) {return false}
                    } else {
                        if (pinfo & 12) =? 8 {bl_scan_has_float=true}
                        if (pinfo & 32) not=? 0 {
                            if copy_consumes(sym  i) {
                                if not bl_copy_own_ok(arg  pt0) {return false}
                            } else if bl_fn_copies_maybe {
                                if not cs_set {cs=bl_fn_copy_strict or copy_strict(e); cs_set=true}
                                if cs and not bl_expr_always_owned(arg) {
                                    if nodes.ptr[e].c not=? 0 {return false}
                                    if not have_cargs {cargs=kids(e); have_cargs=true}
                                    let need_snap=(mm not=? 0 and shares_mut_root(arg  cargs  mm  (if (pinfo & 16) not=? 0 {sym} else {-2}))) or borrow_may_change(arg  cargs  i  sym)
                                    if need_snap and not bl_copy_own_ok(arg  pt0) {return false}
                                }
                            }
                        }
                    }
                    bl_scan_push(arg)
                }
                return true
            }
            if aux =? 2 {
                let tinfo=bl_tinfo(BlWord(nodes.ptr[e].type))
                let t:BlWord=(tinfo >> 8) & 0xFFFFFF
                if (tinfo & 1) =? 0 or types.ptr[t].kind not=? 'struct_' {return false}
                let si:BlWord=BlWord(types.ptr[t].st)
                let fbase:BlWord=BlWord(structs.ptr[si].fields)
                let lbase:BlWord=BlWord(nodes.ptr[e].list)
                let na:BlWord=BlWord(nodes.ptr[e].nlist)
                loop i in [0..na) {
                    let a:BlWord=BlWord(lists.ptr[lbase + i])
                    if a =? 0 {continue}
                    let f:BlWord=fbase + i
                    if fields.ptr[f].boxed {bl_scan_calls += 1; bl_scan_managed=true}
                    let ft:BlWord=BlWord(fields.ptr[f].type)
                    let finfo=bl_tinfo(ft)
                    if (finfo & 1) =? 0 or (bl_fn_copies_maybe and (finfo & 32) not=? 0 and not bl_copy_own_ok(a  ft)) {return false}
                    bl_scan_push(a)
                }
                return true
            }
            if aux =? 3 {
                let tinfo=bl_tinfo(BlWord(nodes.ptr[e].type))
                let t:BlWord=(tinfo >> 8) & 0xFFFFFF
                if (tinfo & 1) =? 0 or types.ptr[t].kind not=? 'enum_' {return false}
                let si:BlWord=BlWord(types.ptr[t].st)
                let v:BlWord=BlWord(nodes.ptr[e].aux2)
                let na:BlWord=BlWord(nodes.ptr[e].nlist)
                if structs.ptr[si].union_ and na =? 1 {
                    let j=union_index(t  ntype(kid(e 0)))
                    if j >=? 0 {v=j}
                }
                let vi:BlWord=BlWord(structs.ptr[si].variants) + v
                let fbase:BlWord=BlWord(variants.ptr[vi].fields)
                let lbase:BlWord=BlWord(nodes.ptr[e].list)
                loop i in [0..na) {
                    let a:BlWord=BlWord(lists.ptr[lbase + i])
                    let f:BlWord=fbase + i
                    if fields.ptr[f].boxed {bl_scan_calls += 1; bl_scan_managed=true}
                    let ft:BlWord=BlWord(fields.ptr[f].type)
                    let finfo=bl_tinfo(ft)
                    if (finfo & 1) =? 0 or (bl_fn_copies_maybe and (finfo & 32) not=? 0 and not bl_copy_own_ok(a  ft)) {return false}
                    bl_scan_push(a)
                }
                return true
            }
            if aux =? 4 {
                let callee:BlWord=BlWord(nodes.ptr[e].a)
                let ft=prune(ntype(callee))
                if types.ptr[ft].kind not=? 'cfn' {return false}
                let rtp=prune(BlWord(types.ptr[ft].elem))
                if rtp not=? T_NEVER {
                    let rinfo=bl_tinfo(rtp)
                    if (rinfo & 1) =? 0 or (rinfo & 12) =? 12 {return false}
                    if (rinfo & 16) not=? 0 {bl_scan_managed=true}
                }
                let ni:BlWord=0
                let nf:BlWord=0
                loop i in [0..nkids(e)) {
                    let arg=kid(e i)
                    let ainfo=bl_tinfo(BlWord(nodes.ptr[arg].type))
                    if (ainfo & 1) =? 0 or (ainfo & 12) =? 12 {return false}
                    if (ainfo & 12) =? 8 {nf += 1; bl_scan_has_float=true}
                    else {ni += 1}
                    bl_scan_push(arg)
                }
                if ni >? 6 or nf >? 8 {return false}
                bl_scan_calls += 1
                bl_scan_push(callee)
                return true
            }
            false
        }
        <'intrinsic'> => {
            let id=nodes.ptr[e].aux as IN
            let na=nkids(e)
            if id =? IN.static_assert {return true}
            if id =? IN.embed {return na =? 1}
            if id =? IN.argv {return na =? 0}
            if id =? IN.stack_ptr or id =? IN.cpu_features {
                bl_scan_calls += 1
                return na =? 0
            }
            if id =? IN.atomic_add {
                bl_scan_calls += 1
                if na not=? 2 {return false}
                bl_scan_push(kid(e 1)); bl_scan_push(kid(e 0))
                return true
            }
            if id =? IN.atomic_cas {
                bl_scan_calls += 1
                if na not=? 3 {return false}
                bl_scan_push(kid(e 2)); bl_scan_push(kid(e 1)); bl_scan_push(kid(e 0))
                return true
            }
            if id =? IN.sqrt {
                bl_scan_has_float=true
                if na not=? 1 {return false}
                let a0=kid(e 0)
                if (bl_tinfo(BlWord(nodes.ptr[a0].type)) & 13) not=? 9 {return false}
                bl_scan_push(a0)
                return true
            }
            if id =? IN.callc {
                if na <? 1 {return false}
                bl_scan_calls += 1
                let fp0=kid(e 0)
                if (bl_tinfo(BlWord(nodes.ptr[fp0].type)) & 13) not=? 5 {return false}
                let ni:BlWord=0
                let nf:BlWord=0
                loop i in [1..na) {
                    let arg=kid(e i)
                    let ainfo=bl_tinfo(BlWord(nodes.ptr[arg].type))
                    if (ainfo & 1) =? 0 {return false}
                    let avc=ainfo & 12
                    if avc =? 8 {nf += 1; bl_scan_has_float=true}
                    else if avc =? 4 {ni += 1}
                    else {return false}
                    bl_scan_push(arg)
                }
                if ni >? 6 or nf >? 8 {return false}
                bl_scan_push(fp0)
                return true
            }
            if id =? IN.len or id =? IN.arrcap {
                if na not=? 1 {return false}
                let a0=kid(e 0)
                let ak=types.ptr[prune(ntype(a0))].kind
                if ak not=? 'array' and ak not=? 'str_' and not (id =? IN.len and ak =? 'fixed') {return false}
                bl_scan_push(a0)
                return true
            }
            if id =? IN.zeroed {
                if na not=? 0 {return false}
                let tinfo=bl_tinfo(BlWord(nodes.ptr[e].type))
                if (tinfo & 1) =? 0 or (tinfo & 12) =? 0 {return false}
                if (tinfo & 12) =? 8 {bl_scan_has_float=true}
                if (tinfo & 16) not=? 0 {bl_scan_managed=true}
                return true
            }
            if id =? IN.remove {
                if na not=? 2 {return false}
                let a0=kid(e 0)
                let a1=kid(e 1)
                let at=prune(ntype(a0))
                if types.ptr[at].kind not=? 'array' or not bl_can_mut_place(a0) {return false}
                let einfo=bl_tinfo(BlWord(types.ptr[at].elem))
                if (einfo & 1) =? 0 or (einfo & 12) =? 0 {return false}
                bl_scan_calls += 1
                bl_scan_managed=true
                bl_scan_push(a1); bl_scan_push(a0)
                return true
            }
            if id =? IN.pop {
                if na not=? 1 {return false}
                let a0=kid(e 0)
                let at=prune(ntype(a0))
                if types.ptr[at].kind not=? 'array' or not bl_can_mut_place(a0) {return false}
                let einfo=bl_tinfo(BlWord(types.ptr[at].elem))
                if (einfo & 1) =? 0 or (einfo & 12) =? 0 {return false}
                bl_scan_calls += 1
                bl_scan_managed=true
                bl_scan_push(a0)
                return true
            }
            if id =? IN.arrdata {
                if na not=? 1 {return false}
                let a0=kid(e 0)
                let ak=types.ptr[prune(ntype(a0))].kind
                if ak not=? 'array' and ak not=? 'str_' {return false}
                if ak =? 'array' and data_writable(a0) and not is_uniq_array(a0) and not ptr_read_only(e) {
                    if not bl_can_mut_place(a0) {return false}
                }
                bl_scan_push(a0)
                return true
            }
            if id =? IN.to_bytes {
                if na not=? 1 {return false}
                bl_scan_push(kid(e 0))
                return true
            }
            if id =? IN.panic {
                bl_scan_calls += 1
                if na >? 1 {return false}
                if na =? 1 {bl_scan_push(kid(e 0))}
                return true
            }
            if id =? IN.assert or id =? IN.runtime_assert {
                bl_scan_calls += 1
                if na <? 1 or na >? 2 {return false}
                if na =? 2 {bl_scan_push(kid(e 1))}
                bl_scan_push(kid(e 0))
                return true
            }
            if id =? IN.memcpy or id =? IN.memset {
                if na not=? 3 {return false}
                bl_scan_push(kid(e 2)); bl_scan_push(kid(e 1)); bl_scan_push(kid(e 0))
                return true
            }
            if id =? IN.syscall {
                if na <? 1 or na >? 7 {return false}
                bl_scan_calls += 1
                bl_scan_syscall=true
                loop i in [0..na) {bl_scan_push(kid(e i))}
                return true
            }
            if id =? IN.push {
                if arena_runtime_ready or na not=? 2 or (has_flag(e NF_INBOUNDS) and has_flag(e NF_COMPREHENSION)) {return false}
                let a0=kid(e 0)
                let a1=kid(e 1)
                let at=prune(ntype(a0))
                if types.ptr[at].kind not=? 'array' or not bl_can_mut_place(a0) {return false}
                let et0:BlWord=BlWord(types.ptr[at].elem)
                let einfo=bl_tinfo(et0)
                if (einfo & 1) =? 0 or (einfo & 12) =? 0 {return false}
                if bl_fn_copies_maybe and (einfo & 32) not=? 0 and not bl_copy_own_ok(a1  et0) {return false}
                bl_scan_calls += 1
                bl_scan_managed=true
                bl_scan_push(a1); bl_scan_push(a0)
                return true
            }
            if id =? IN.clear {
                if na not=? 1 {return false}
                let a0=kid(e 0)
                let at=prune(ntype(a0))
                if types.ptr[at].kind not=? 'array' or not bl_can_mut_place(a0) {return false}
                if (bl_tinfo(BlWord(types.ptr[at].elem)) & 1) =? 0 {return false}
                bl_scan_calls += 1
                bl_scan_managed=true
                bl_scan_push(a0)
                return true
            }
            if id =? IN.reserve or id =? IN.resize or id =? IN.truncate or id =? IN.setlen {
                if na not=? 2 {return false}
                let a0=kid(e 0)
                let a1=kid(e 1)
                let at=prune(ntype(a0))
                if types.ptr[at].kind not=? 'array' or not bl_can_mut_place(a0) {return false}
                let einfo=bl_tinfo(BlWord(types.ptr[at].elem))
                if (einfo & 1) =? 0 or (einfo & 12) =? 0 {return false}
                bl_scan_calls += 1
                bl_scan_managed=true
                bl_scan_push(a1); bl_scan_push(a0)
                return true
            }
            if id =? IN.extend {
                if na not=? 2 {return false}
                let a0=kid(e 0)
                let a1=kid(e 1)
                let ainfo=bl_tinfo(BlWord(nodes.ptr[a0].type))
                let at:BlWord=(ainfo >> 8) & 0xFFFFFF
                if (ainfo & 1) =? 0 or types.ptr[at].kind not=? 'array' or not bl_can_mut_place(a0) {return false}
                let einfo=bl_tinfo(BlWord(types.ptr[at].elem))
                if (einfo & 1) =? 0 or (einfo & 12) =? 0 {return false}
                if is_slice(a1) {
                    if nodes.ptr[a1].kind not=? 'index' or nodes.ptr[a1].aux not=? 1 {return false}
                    let rng=BlWord(nodes.ptr[a1].b)
                    if nodes.ptr[rng].kind not=? 'range' {return false}
                    let src=BlWord(nodes.ptr[a1].a)
                    let sinfo=bl_tinfo(BlWord(nodes.ptr[src].type))
                    let st:BlWord=(sinfo >> 8) & 0xFFFFFF
                    let sk=types.ptr[st].kind
                    if (sinfo & 1) =? 0 or (sk not=? 'array' and sk not=? 'fixed') {return false}
                    if bl_fn_copies_maybe and (einfo & 32) not=? 0 {return false}
                    bl_scan_calls += 1
                    bl_scan_managed=true
                    bl_scan_push(BlWord(nodes.ptr[rng].b))
                    bl_scan_push(BlWord(nodes.ptr[rng].a))
                    bl_scan_push(src)
                    bl_scan_push(a0)
                    return true
                }
                let binfo=bl_tinfo(BlWord(nodes.ptr[a1].type))
                let bt:BlWord=(binfo >> 8) & 0xFFFFFF
                if types.ptr[bt].kind not=? 'array' {return false}
                if bl_fn_copies_maybe and (einfo & 32) not=? 0 and (bl_fn_copy_strict or copy_strict(e)) and not bl_copy_own_ok(a1  bt) {return false}
                bl_scan_calls += 1
                bl_scan_managed=true
                bl_scan_push(a1); bl_scan_push(a0)
                return true
            }
            if id =? IN.relocate {
                if na not=? 3 {return false}
                let a0=kid(e 0)
                let ainfo=bl_tinfo(BlWord(nodes.ptr[a0].type))
                let at:BlWord=(ainfo >> 8) & 0xFFFFFF
                if types.ptr[at].kind not=? 'array' or not bl_can_mut_place(a0) {return false}
                let einfo=bl_tinfo(BlWord(types.ptr[at].elem))
                if (ainfo & 1) =? 0 or (einfo & 1) =? 0 or (einfo & 12) =? 0 {return false}
                bl_scan_calls += 1
                bl_scan_managed=true
                bl_scan_push(kid(e 2)); bl_scan_push(kid(e 1)); bl_scan_push(a0)
                return true
            }
            false
        }
        <'while_'> => {
            let aux=nodes.ptr[e].aux
            if aux not=? 0 and aux not=? 1 {return false}
            let a:BlWord=BlWord(nodes.ptr[e].a)
            let b0:BlWord=BlWord(nodes.ptr[e].b)
            if aux =? 0 {
                # Leave tight byte-scan loops to gen_scan_loop (AVX2 scanbytes).
                if bl_is_scan_loop(e) {bl_scan_has_scan_loop=true}
            } else {
                let l:BlWord=BlWord(nodes.ptr[e].sym)
                let oinfo=bl_tinfo(BlWord(nodes.ptr[a].type))
                let ot:BlWord=(oinfo >> 8) & 0xFFFFFF
                if l <=? 0 or (oinfo & 1) =? 0 or types.ptr[ot].kind not=? 'opt' {return false}
                if bl_fn_copies_maybe and (oinfo & 32) not=? 0 and not bl_copy_own_ok(a  ot) {return false}
                let fl:BlWord=BlWord(locals.ptr[l].flags)
                if fl & (LF_CAPTURE | LF_CAPTURED | LF_SHARED | LF_ALIAS | LF_BYREF | LF_OWNERBORROW | LF_PARTBORROW) not=? 0 {return false}
            }
            bl_scan_has_loop=true
            bl_scan_has_while=true
            bl_scan_dyn_loop=true
            bl_scan_loops += 1
            if bl_scan_loops >? bl_scan_max_loop_depth {bl_scan_max_loop_depth=bl_scan_loops}
            bl_scan_push(-1)
            bl_scan_push(b0)
            bl_scan_push(a)
            true
        }
        <'for_'> => {
            let aux=nodes.ptr[e].aux
            let a:BlWord=BlWord(nodes.ptr[e].a)
            let b0:BlWord=BlWord(nodes.ptr[e].b)
            if aux =? 0 {
                if nodes.ptr[a].kind not=? 'range' or nodes.ptr[a].b =? 0 {return false}
                let stepped=has_flag(a NF_STEP)
                if stepped and nodes.ptr[a].c =? 0 {return false}
                let l:BlWord=BlWord(nodes.ptr[e].sym)
                if l <=? 0 {return false}
                let fl:BlWord=BlWord(locals.ptr[l].flags)
                if fl & (LF_CAPTURE | LF_CAPTURED | LF_SHARED | LF_ALIAS | LF_BYREF | LF_OWNERBORROW | LF_PARTBORROW) not=? 0 {return false}
                let linfo=bl_tinfo(BlWord(locals.ptr[l].type))
                if (linfo & 13) not=? 5 {return false}
                let ra=BlWord(nodes.ptr[a].a)
                let rb=BlWord(nodes.ptr[a].b)
                if stepped and (linfo & 64) not=? 0 {
                    let rc=BlWord(nodes.ptr[a].c)
                    if (fl & (LF_ASSIGNED | LF_ADDR | LF_MUTPARAM | LF_EXPOSED)) not=? 0 or not bl_is_small_math(ra) or not bl_is_small_math(rb) or not bl_is_small_math(rc) {return false}
                }
                if stepped or nodes.ptr[ra].kind not=? 'int_lit' or nodes.ptr[rb].kind not=? 'int_lit' or nodes.ptr[rb].ival - nodes.ptr[ra].ival >? 64 {bl_scan_dyn_loop=true}
                bl_scan_has_loop=true
                bl_scan_push(-1)
                bl_scan_push(b0)
                bl_scan_push(-2)
                if stepped {bl_scan_push(BlWord(nodes.ptr[a].c))}
                bl_scan_push(rb)
                bl_scan_push(ra)
                return true
            }
            if aux =? 1 {
                if has_flag(e NF_MUT) {return false}
                if nodes.ptr[a].kind =? 'index' and nodes.ptr[a].aux =? 1 {return false}
                let cinfo=bl_tinfo(BlWord(nodes.ptr[a].type))
                let ct:BlWord=(cinfo >> 8) & 0xFFFFFF
                let ck=types.ptr[ct].kind
                if ck not=? 'array' and ck not=? 'str_' and ck not=? 'fixed' {return false}
                if (cinfo & 1) =? 0 {return false}
                if bl_fn_copies_maybe and (cinfo & 32) not=? 0 and not bl_copy_own_ok(a  ct) {return false}
                let el:BlWord=BlWord(nodes.ptr[e].sym)
                let idx:BlWord=BlWord(nodes.ptr[e].c)
                let snap:BlWord=BlWord(nodes.ptr[e].d)
                if el <=? 0 or idx <=? 0 or snap <=? 0 {return false}
                if (BlWord(locals.ptr[el].flags) & LF_BYREF) =? 0 {return false}
                if (BlWord(locals.ptr[idx].flags) & LF_BYREF) not=? 0 or (BlWord(locals.ptr[snap].flags) & LF_BYREF) not=? 0 {return false}
                if (cinfo & 16) not=? 0 {bl_scan_managed=true}
                bl_scan_has_loop=true
                bl_scan_dyn_loop=true
                bl_scan_push(-1)
                bl_scan_push(b0)
                bl_scan_push(-2)
                bl_scan_push(a)
                return true
            }
            if aux =? 3 {
                if has_flag(e NF_MUT) {return false}
                let cinfo=bl_tinfo(BlWord(nodes.ptr[a].type))
                let ct:BlWord=(cinfo >> 8) & 0xFFFFFF
                if (cinfo & 1) =? 0 or types.ptr[ct].kind not=? 'struct_' or ownership_type(ct) {return false}
                if bl_fn_copies_maybe and (cinfo & 32) not=? 0 and not bl_copy_own_ok(a  ct) {return false}
                let si:BlWord=BlWord(types.ptr[ct].st)
                if structs.ptr[si].nfields <? 2 {return false}
                let f0:BlWord=BlWord(structs.ptr[si].fields)
                let f0t=prune(BlWord(fields.ptr[f0].type))
                let f1t=prune(BlWord(fields.ptr[f0 + 1].type))
                if types.ptr[f0t].kind not=? 'array' or types.ptr[f1t].kind not=? 'array' {return false}
                if (bl_tinfo(BlWord(types.ptr[f0t].elem)) & 1) =? 0 or (bl_tinfo(BlWord(types.ptr[f1t].elem)) & 1) =? 0 {return false}
                let el:BlWord=BlWord(nodes.ptr[e].sym)
                let idx:BlWord=BlWord(nodes.ptr[e].c)
                let snap:BlWord=BlWord(nodes.ptr[e].d)
                let vl:BlWord=BlWord(nodes.ptr[e].aux2)
                if el <=? 0 or idx <=? 0 or snap <=? 0 {return false}
                if (BlWord(locals.ptr[el].flags) & LF_BYREF) =? 0 {return false}
                if (BlWord(locals.ptr[idx].flags) & LF_BYREF) not=? 0 or (BlWord(locals.ptr[snap].flags) & LF_BYREF) not=? 0 {return false}
                if vl >? 0 and (BlWord(locals.ptr[vl].flags) & (LF_CAPTURE | LF_CAPTURED | LF_SHARED | LF_ALIAS | LF_OWNERBORROW | LF_PARTBORROW)) not=? 0 {return false}
                if (cinfo & 16) not=? 0 {bl_scan_managed=true}
                bl_scan_has_loop=true
                bl_scan_dyn_loop=true
                bl_scan_push(-1)
                bl_scan_push(b0)
                bl_scan_push(-2)
                bl_scan_push(a)
                return true
            }
            false
        }
        <'match_'> => {
            let a:BlWord=BlWord(nodes.ptr[e].a)
            if bl_fn_exact and exact_has_node(a) and exact_match_literals(e) and exact_bits(a) >? 64 {return false}
            let sinfo=bl_tinfo(BlWord(nodes.ptr[a].type))
            let st:BlWord=(sinfo >> 8) & 0xFFFFFF
            let rtp=prune(ntype(e))
            let hidden:BlWord=BlWord(nodes.ptr[e].sym)
            if hidden <=? 0 or (sinfo & 1) =? 0 {return false}
            if bl_fn_copies_maybe and (sinfo & 32) not=? 0 and not bl_copy_own_ok(a  st) {return false}
            if (BlWord(locals.ptr[hidden].flags) & (LF_CAPTURE | LF_CAPTURED | LF_SHARED | LF_ALIAS | LF_BYREF | LF_OWNERBORROW | LF_PARTBORROW)) not=? 0 {return false}
            if not has_flag(e NF_STMT) and rtp not=? T_NEVER and (bl_tinfo(rtp) & 1) =? 0 {return false}
            if (sinfo & 16) not=? 0 {bl_scan_managed=true}
            bl_scan_push(a)
            loop i in [0..nkids(e)) {
                let arm=kid(e i)
                loop j in [0..nkids(arm)) {
                    let p=kid(arm j)
                    let pk=nodes.ptr[p].kind
                    if pk =? 'pwild' {continue}
                    if pk =? 'pvariant' {
                        if types.ptr[st].kind not=? 'enum_' {return false}
                        continue
                    }
                    if pk =? 'ptype' {
                        if is_union(st) {continue}
                        if types.ptr[st].kind =? 'opt' {continue}
                        return false
                    }
                    if pk =? 'plit' {
                        let pt=st
                        if is_union(pt) {
                            let vi:BlWord=BlWord(nodes.ptr[p].aux2)
                            let f:BlWord=BlWord(variants.ptr[BlWord(structs.ptr[BlWord(types.ptr[pt].st)].variants) + vi].fields)
                            if fields.ptr[f].boxed {return false}
                            pt=prune(BlWord(fields.ptr[f].type))
                        } else if types.ptr[pt].kind =? 'opt' {
                            let pa:BlWord=BlWord(nodes.ptr[p].a)
                            if nodes.ptr[pa].kind =? 'none_lit' {continue}
                            let u=prune(BlWord(types.ptr[pt].elem))
                            if not is_union(u) {return false}
                            let vi:BlWord=BlWord(nodes.ptr[p].aux2)
                            let f:BlWord=BlWord(variants.ptr[BlWord(structs.ptr[BlWord(types.ptr[u].st)].variants) + vi].fields)
                            if fields.ptr[f].boxed {return false}
                            pt=prune(BlWord(fields.ptr[f].type))
                        }
                        if types.ptr[pt].kind =? 'str_' {bl_scan_calls += 1; bl_scan_managed=true}
                        else if (bl_tinfo(pt) & 12) not=? 4 {return false}
                        bl_scan_push(BlWord(nodes.ptr[p].a))
                        continue
                    }
                    if pk =? 'prange' {
                        if (sinfo & 12) not=? 4 {return false}
                        bl_scan_push(BlWord(nodes.ptr[p].b))
                        bl_scan_push(BlWord(nodes.ptr[p].a))
                        continue
                    }
                    return false
                }
                bl_scan_push(BlWord(nodes.ptr[arm].b))
            }
            true
        }
        _ => false
    }
}

bl_can_match_lookup=(m:BlWord):>bool=>$unsafe {
    let st=quantity_base(prune(ntype(BlWord(nodes.ptr[m].a))))
    let rtp=quantity_base(prune(ntype(m)))
    if st =? T_MATH_INT or rtp =? T_MATH_INT {return false}
    let sk=types.ptr[st].kind
    if sk not=? 'int_' and (sk not=? 'enum_' or not structs.ptr[BlWord(types.ptr[st].st)].simple_enum) {return false}
    let rk=types.ptr[rtp].kind
    if rk not=? 'int_' and rk not=? 'bool_' and (rk not=? 'enum_' or not structs.ptr[BlWord(types.ptr[rtp].st)].simple_enum) {return false}
    let n=nkids(m)
    let count:BlWord=0
    let wild:BlWord=-1
    let lo:BlWord=0
    let hi:BlWord=0
    let have=false
    loop i in [0..n) {
        let arm=kid(m i)
        let [cok _cval]=match_arm_constant(arm)
        if not cok {return false}
        loop j in [0..nkids(arm)) {
            let p=kid(arm j)
            let pk=nodes.ptr[p].kind
            if pk =? 'pwild' {if wild <? 0 {wild=i}}
            else if pk =? 'plit' {
                let [pok pv]=pat_int(BlWord(nodes.ptr[p].a))
                if not pok {return false}
                count += 1
                if not have {lo=pv; hi=pv; have=true}
                else {if pv <? lo {lo=pv}; if pv >? hi {hi=pv}}
            } else if pk =? 'pvariant' {
                let si:BlWord=BlWord(types.ptr[st].st)
                let pv:BlWord=variants.ptr[BlWord(structs.ptr[si].variants) + BlWord(nodes.ptr[p].aux2)].value
                count += 1
                if not have {lo=pv; hi=pv; have=true}
                else {if pv <? lo {lo=pv}; if pv >? hi {hi=pv}}
            } else {return false}
        }
    }
    have and count >=? 4 and hi >=? lo and hi - lo <? 1024 and (wild >=? 0 or sk =? 'enum_')
}

bl_can_emit_inst=(_lf:BlWord fi:BlWord):>bool=>$unsafe {
    if want_loop_watch or partition_active or fi =? runtime_memeq or fi =? runtime_streq {return false}
    if member_seen_owners.length >? 0 and member_seen_owners.has(fi) {return false}
    let fp=fns.ptr + fi
    if (fp[0].kind not=? FK_NORMAL and fp[0].kind not=? FK_INIT) or fp[0].cabi or fp[0].has_env or (fp[0].export_name as array<uint8>).length >? 0 {return false}
    let decl:BlWord=BlWord(fp[0].decl)
    if bl_is_hot_lib_fn(decl) {return false}
    let body:BlWord=BlWord(fp[0].body)
    if body <=? 0 {return false}
    let in_lib_fn=decl not=? 0 and pos_in_lib(nodes.ptr[decl].pos)
    bl_fn_copies_maybe=copies_on and dir_index_file_has(dir_name_copies  pos_file(nodes.ptr[body].pos))
    bl_fn_copy_strict=bl_fn_copies_maybe and copy_strict(body)
    bl_fn_exact=exact_owners.length >? 0 and exact_owners.has(fi)
    bl_scan_rare=ff_checks_any or float_keys_any or bl_fn_exact
    if bl_tok_epoch not=? lower_epoch {
        bl_ty_info.clear()
        bl_tok_epoch=lower_epoch
        bl_tok_saw_cycle=false
    }
    if ownership_decls.length not=? 0 and decl not=? 0 {
        if ownership_consumers.has(decl) or (ownership_hooks.get(decl) ?? 0) >? 1 {return false}
    }
    if decl not=? 0 and modules.ptr[BlWord(fp[0].mod)].is_prelude {
        if find_bytes_set(BlWord(nodes.ptr[decl].name)) not=? -1 {return false}
    }
    let rtp=prune(BlWord(fp[0].ret))
    let rinfo:BlWord=if rtp not=? T_NEVER {bl_tinfo(rtp)} else {0}
    if rtp not=? T_NEVER and (rinfo & 1) =? 0 {return false}
    bl_scan_has_float=rtp not=? T_NEVER and (rinfo & 12) =? 8
    bl_scan_mut_math=false
    let sret_extra:BlWord=if rtp not=? T_NEVER and (rinfo & 12) =? 12 {1} else {0}
    bl_scan_managed=rtp not=? T_NEVER and (rinfo & 16) not=? 0
    bl_scan_sret=sret_extra not=? 0
    let is_dewy_fn=decl not=? 0 and files.ptr[pos_file(nodes.ptr[decl].pos)].is_dewy
    loop p in fp[0].params {
        let pinfo=bl_tinfo(BlWord(locals.ptr[p].type))
        if (pinfo & 1) =? 0 {return false}
        let fl:BlWord=BlWord(locals.ptr[p].flags)
        if fl & (LF_CAPTURE | LF_CAPTURED | LF_SHARED | LF_ALIAS | LF_BYREF | LF_OWNERBORROW | LF_PARTBORROW) not=? 0 {return false}
        if (fl & LF_MUTPARAM) =? 0 and (fl & LF_ASSIGNED) not=? 0 and (pinfo & 16) not=? 0 {return false}
        if copies_on and copy_inputs.has(p) {
            if not is_dewy_fn or (fl & LF_MUTPARAM) not=? 0 {return false}
            # Verify that a synthetic copy_bindings vardecl in the body prefix consumes p.
            let found=false
            loop bi in [0..nkids(body)) {
                let st=kid(body bi)
                if nodes.ptr[st].kind not=? 'vardecl' or nodes.ptr[st].aux2 not=? 1 {break}
                let bl:BlWord=BlWord(nodes.ptr[st].sym)
                let biv:BlWord=BlWord(nodes.ptr[st].b)
                if bl >=? 0 and copy_bindings.has(bl) and biv >? 0 and nodes.ptr[biv].kind =? 'ident' and nodes.ptr[biv].aux =? 1 and BlWord(nodes.ptr[biv].sym) =? p {found=true; break}
            }
            if not found {return false}
        }
        if (fl & LF_MUTPARAM) =? 0 and (pinfo & 12) =? 8 {bl_scan_has_float=true}
    }
    let nloc=fp[0].locals.length
    if nloc >? 0 {
        let lo:BlWord=BlWord(fp[0].locals.ptr[0])
        let hi:BlWord=lo
        loop i in [0..nloc) {
            let l:BlWord=BlWord(fp[0].locals.ptr[i])
            if l <? lo {lo=l}
            if l >? hi {hi=l}
            let fl:BlWord=BlWord(locals.ptr[l].flags)
            if fl & (LF_CAPTURE | LF_CAPTURED | LF_SHARED | LF_OWNERBORROW | LF_PARTBORROW) not=? 0 {return false}
            if fl & LF_ALIAS not=? 0 {
                if locals.ptr[l].alias <=? 0 {return false}
                continue
            }
            let linfo=bl_tinfo(BlWord(locals.ptr[l].type))
            if (linfo & 1) =? 0 {return false}
            if (linfo & 12) =? 8 {bl_scan_has_float=true}
            if (fl & (LF_PARAM | LF_BYREF)) =? 0 and (fl & LF_ASSIGNED) not=? 0 and (linfo & 16) not=? 0 {bl_scan_managed=true}
            if (linfo & 64) not=? 0 and (fl & LF_ASSIGNED) not=? 0 {bl_scan_mut_math=true}
        }
        if hi - lo >=? 4096 {return false}
    }
    bl_copies_prepared=false
    bl_copies_fi=fi
    bl_scan_nodes=0
    bl_scan_calls=0
    bl_scan_fn_calls=0
    bl_scan_loops=0
    bl_scan_max_loop_depth=0
    bl_scan_has_loop=false
    bl_scan_has_while=false
    bl_scan_syscall=false
    bl_scan_exact_in_loop=false
    bl_scan_exact_wide_in_loop=false
    bl_scan_dyn_loop=false
    bl_scan_has_scan_loop=false
    if fp[0].kind =? FK_NORMAL and nodes.ptr[body].aux not=? 0 and rtp not=? T_NEVER and vc(rtp) not=? VC_VOID and nkids(body) >? 0 {
        let last_st=kid(body nkids(body) - 1)
        if nodes.ptr[last_st].kind =? 'exprstmt' and not bl_copy_own_ok(BlWord(nodes.ptr[last_st].a)  rtp) {return false}
    }
    if not bl_scan_node(body) {return false}
    if not in_lib_fn and bl_scan_exact_in_loop and bl_scan_dyn_loop and (bl_scan_nodes <=? 110 or (bl_scan_exact_wide_in_loop and bl_scan_nodes <=? 210)) {return false}
    if bl_scan_has_scan_loop and not in_lib_fn and bl_scan_fn_calls <=? 2 and bl_scan_nodes <=? 120 {return false}
    if (bl_scan_max_loop_depth >=? 3 and not in_lib_fn) or (bl_scan_has_while and bl_scan_mut_math and bl_scan_nodes <=? 96) {return false}
    if bl_scan_has_float and bl_scan_has_loop and not in_lib_fn and (bl_scan_calls =? 0 or (bl_scan_nodes <=? 64 and bl_scan_calls <=? 2)) {return false}
    # Preserve default-mode fast_inline_into for tiny unmanaged scalar leaves,
    # 1-call wrappers, and pure constant lookup-table or dense-dispatch match leaves.
    if fp[0].kind =? FK_NORMAL and not (fp[0].noinline and in_lib_fn) and not bl_scan_syscall {
        if bl_scan_calls =? 0 and not bl_scan_managed {
            if bl_scan_nodes <=? (if bl_scan_has_float {96} else if in_lib_fn {16} else {32}) {return false}
            if not bl_scan_has_loop {
                let first:BlWord=0
                let nb=nkids(body)
                loop first <? nb and nodes.ptr[kid(body first)].kind =? 'vardecl' and nodes.ptr[kid(body first)].aux2 =? 1 {first += 1}
                if first + 1 =? nb {
                    let s0=kid(body first)
                    let m0:BlWord=if nodes.ptr[s0].kind =? 'exprstmt' or nodes.ptr[s0].kind =? 'return_' {BlWord(nodes.ptr[s0].a)} else {s0}
                    if m0 >? 0 and nodes.ptr[m0].kind =? 'match_' and (bl_can_match_lookup(m0) or nkids(m0) >=? 8) {return false}
                }
            }
        }
        if bl_scan_calls =? 1 and bl_scan_nodes <=? (if in_lib_fn {16} else {32}) and not bl_scan_managed and not bl_scan_sret and rtp not=? T_NEVER and vc(rtp) not=? VC_VOID {return false}
    }
    true
}

# ---- Scope, temp, and ownership helpers ----

bl_drop_at_reg=(addr_reg:XWord t0:BlWord):>void=>$unsafe {
    let t=quantity_base(prune(t0))
    if not is_managed(t) {return}
    if vc(t) =? VC_INT {
        mov_rm(RAX  addr_reg  0)
        bl_release_val(t)
    } else {
        if addr_reg not=? RDI {mov_rr(RDI  addr_reg)}
        bl_call(lf_helper(HK.drop t 0))
    }
}

bl_copy_at_reg=(addr_reg:XWord t0:BlWord):>void=>$unsafe {
    let t=quantity_base(prune(t0))
    if not is_managed(t) {return}
    if vc(t) =? VC_INT {
        mov_rm(RAX  addr_reg  0)
        bl_retain_val(t)
    } else {
        if addr_reg not=? RDI {mov_rr(RDI  addr_reg)}
        bl_call(lf_helper(HK.copy t 0))
    }
}

bl_fpre=(t0:BlWord):>XWord=>$unsafe {
    if tsize(quantity_base(prune(t0))) =? 4 {0xF3} else {0xF2}
}

bl_movq_xr=(x:XWord r:XWord):>void=>$unsafe {
    b(0x66)
    rex(true  x  0  r  false)
    b(0x0F); b(0x6E)
    modrr(x  r)
}

bl_movq_rx=(r:XWord x:XWord):>void=>$unsafe {
    b(0x66)
    rex(true  x  0  r  false)
    b(0x0F); b(0x7E)
    modrr(x  r)
}

bl_fconst=(x:XWord fval:float64 is_f32:bool):>void=>$unsafe {
    let bits:XWord=if is_f32 {XWord(f32_bits(float32(fval)))} else {XWord(f64_bits(fval))}
    if bits =? 0 {
        sse_rr(0  0x57  x  x) # xorps xmm, xmm
    } else {
        mov_imm(RAX  bits)
        bl_movq_xr(x  RAX)
    }
}

bl_save_res=(t0:BlWord off:XWord):>void=>$unsafe {
    let info=bl_tinfo(t0)
    if (info & 12) =? 8 {sse_rm(if bl_ti_size(info) =? 4 {0xF3} else {0xF2}  0x11  0  RBP  -off)}
    else {mov_mr_rbp(-off  RAX)}
}

bl_load_res=(t0:BlWord off:XWord):>void=>$unsafe {
    let info=bl_tinfo(t0)
    if (info & 12) =? 8 {sse_rm(if bl_ti_size(info) =? 4 {0xF3} else {0xF2}  0x10  0  RBP  -off)}
    else {mov_rm_rbp(RAX  -off)}
}

bl_load_val=(t0:BlWord base:XWord disp:XWord):>void=>$unsafe {
    let info=bl_tinfo(t0)
    let c=info & 12
    if c =? 0 {return}
    if c =? 8 {
        sse_rm(if bl_ti_size(info) =? 4 {0xF3} else {0xF2}  0x10  0  base  disp)
        return
    }
    if c =? 12 {
        if disp =? 0 {if base not=? RAX {mov_rr(RAX  base)}}
        else {lea(RAX  base  disp)}
        return
    }
    load_sized(RAX  base  disp  bl_ti_size(info)  (info & 128) not=? 0)
}

bl_store_val=(t0:BlWord base:XWord disp:XWord val_reg:XWord):>void=>$unsafe {
    let info=bl_tinfo(t0)
    let c=info & 12
    if c =? 0 {return}
    if c =? 8 {
        sse_rm(if bl_ti_size(info) =? 4 {0xF3} else {0xF2}  0x11  0  base  disp)
        return
    }
    if c =? 12 {
        let sz=bl_ti_size(info)
        if disp =? 0 {
            bl_copy_mem(base  val_reg  sz)
        } else {
            # Use R10 for destination when val_reg is RDI/RSI.
            lea(R10  base  disp)
            bl_copy_mem(R10  val_reg  sz)
        }
        return
    }
    store_sized(base  disp  val_reg  bl_ti_size(info))
}

bl_borrow=(t0:BlWord):>void=>$unsafe {
    if not bl_last_owned {return}
    let info=bl_tinfo(t0)
    if (info & 16) =? 0 {
        bl_last_owned=false
        return
    }
    let t=(info >> 8) & 0xFFFFFF
    if (info & 12) =? 12 {
        bl_temps_off.push(bl_last_slot)
        bl_temps_ty.push(t)
        bl_temps_agg.push(true)
    } else {
        let off=bl_tmp_alloc(8)
        mov_mr_rbp(-off  RAX)
        bl_temps_off.push(off)
        bl_temps_ty.push(t)
        bl_temps_agg.push(false)
    }
    bl_last_owned=false
}

bl_own_copy=(e:BlWord t0:BlWord):>void=>$unsafe {
    if bl_last_owned {return}
    let info=bl_tinfo(t0)
    let t=(info >> 8) & 0xFFFFFF
    if (info & 12) =? 12 {
        let sz=bl_ti_size(info)
        let off=bl_tmp_alloc(sz  bl_ti_align(info))
        lea_rbp(R10  -off)
        bl_copy_mem(R10  RAX  sz)
        if (info & 16) not=? 0 {
            lea_rbp(RDI  -off)
            bl_call(lf_helper(HK.copy t 0))
        }
        lea_rbp(RAX  -off)
        bl_last_owned=true
        bl_last_slot=off
        return
    }
    if (info & 16) not=? 0 {
        let ek=nodes.ptr[e].kind
        if not ((ek =? 'str_lit' and nodes.ptr[e].aux =? 0) or ek =? 'null_lit' or ((info & 64) not=? 0 and bl_is_small_math(e))) {
            mov_rr(R10  RAX)
            bl_retain_val(t)
            mov_rr(RAX  R10)
        }
        bl_last_owned=true
        bl_last_slot=-1
    }
}

bl_own=(e:BlWord t0:BlWord):>void=>$unsafe {
    if bl_last_owned {return}
    let info=bl_tinfo(t0)
    if bl_fn_copies_maybe and (info & 32) not=? 0 and copy_strict(e) {
        let ek=nodes.ptr[e].kind
        if not bl_copies_prepared and ek =? 'ident' and nodes.ptr[e].aux =? 1 {bl_ensure_copies()}
        let explicit=(ek =? 'array') or (ek =? 'ident' and nodes.ptr[e].aux =? 1 and copy_noenv.has(BlWord(nodes.ptr[e].sym))) or copy_explicit.has(e)
        if not explicit {
            if (info & 12) =? 12 {
                let sz=bl_ti_size(info)
                let src_off=bl_tmp_alloc(8)
                mov_mr_rbp(-src_off  RAX)
                let off=bl_tmp_alloc(sz  bl_ti_align(info))
                lea_rbp(R10  -off)
                bl_copy_mem(R10  RAX  sz)
                mov_rm_rbp(RAX  -src_off)
                bl_zero_mem(RAX  0  sz)
                lea_rbp(RAX  -off)
                bl_last_owned=true
                bl_last_slot=off
                return
            }
            let voff=bl_tmp_alloc(8)
            mov_mr_rbp(-voff  RAX)
            bl_place_addr(e  false)
            bl_zero_mem(RAX  0  bl_ti_size(info))
            mov_rm_rbp(RAX  -voff)
            bl_last_owned=true
            bl_last_slot=-1
            return
        }
    }
    bl_own_copy(e  t0)
}

bl_box_val=(ft0:BlWord):>void=>$unsafe {
    let ft=prune(ft0)
    bl_test_rr(RAX)
    let is_null=jcc32(CC_E)
    bl_add_imm(RAX  XWord(BOX_HDR))
    let done_j=jmp32()
    patch_here(is_null)
    rel_fixup_lea(RAX  0  XWord(box_dflt_off(ft)))
    patch_here(done_j)
}

bl_box_put=(slot_off:XWord slot_in_rbp:bool ft0:BlWord voff:XWord):>void=>$unsafe {
    let ft=prune(ft0)
    let sz=XWord(tsize(ft))
    let is_opt=types.ptr[ft].kind =? 'opt' and not ptr_optional(ft)
    let skip_j:XWord=-1
    if is_opt {
        b16(0xC031)
        if slot_in_rbp {mov_mr_rbp(slot_off  RAX)}
        else {mov_rm_rbp(R10  -slot_off); mov_mr(R10  0  RAX)}
        load_sized(RAX  RBP  -voff + XWord(tsize(BlWord(types.ptr[ft].elem)))  1  false)
        bl_test_rr(RAX)
        skip_j=jcc32(CC_E)
    }
    mov_imm(RDI  sz)
    bl_call(rt("__box_new"))
    let poff=bl_tmp_alloc(8)
    mov_mr_rbp(-poff  RAX)
    if slot_in_rbp {mov_mr_rbp(slot_off  RAX)}
    else {mov_rm_rbp(R10  -slot_off); mov_mr(R10  0  RAX)}
    if vc(ft) =? VC_AGG {
        lea(RDI  RAX  XWord(BOX_HDR))
        lea_rbp(RSI  -voff)
        bl_copy_mem(RDI  RSI  sz)
    } else {
        bl_load_res(ft  voff)
        mov_rm_rbp(R10  -poff)
        bl_store_val(ft  R10  XWord(BOX_HDR)  RAX)
    }
    if skip_j >=? 0 {patch_here(skip_j)}
}

bl_stmt_end=(tmark:BlWord spmark:XWord):>void=>$unsafe {
    loop bl_temps_off.length >? tmark {
        let off=XWord(bl_temps_off.pop())
        let ty=BlWord(bl_temps_ty.pop())
        let is_agg=bl_temps_agg.pop()
        if ty =? 0 {continue}
        if is_agg {
            lea_rbp(RDI  -off)
            bl_call(lf_helper(HK.drop ty 0))
        } else {
            mov_rm_rbp(RAX  -off)
            bl_release_val(ty)
        }
    }
    bl_sp=spmark
}

bl_emit_scope_drops=(from_i:BlWord to_i:BlWord):>void=>$unsafe {
    let i=from_i - 1
    loop i >=? to_i {
        let off=XWord(bl_scope_off.ptr[i])
        let ty=BlWord(bl_scope_ty.ptr[i])
        if bl_scope_agg.ptr[i] {
            lea_rbp(RDI  -off)
            bl_call(lf_helper(HK.drop ty 0))
        } else {
            mov_rm_rbp(RAX  -off)
            bl_release_val(ty)
        }
        i -= 1
    }
}

bl_emit_temp_drops=(from_i:BlWord to_i:BlWord):>void=>$unsafe {
    let i=from_i - 1
    loop i >=? to_i {
        let off=XWord(bl_temps_off.ptr[i])
        let ty=BlWord(bl_temps_ty.ptr[i])
        if ty =? 0 {i -= 1; continue}
        if bl_temps_agg.ptr[i] {
            lea_rbp(RDI  -off)
            bl_call(lf_helper(HK.drop ty 0))
        } else {
            mov_rm_rbp(RAX  -off)
            bl_release_val(ty)
        }
        i -= 1
    }
}

bl_scope_pop=(smark:BlWord):>void=>$unsafe {
    let n=bl_scope_off.length
    if n >? smark {
        bl_emit_scope_drops(n  smark)
        bl_scope_off.truncate(smark)
        bl_scope_ty.truncate(smark)
        bl_scope_agg.truncate(smark)
    }
}

# Bounds check for array/string pointer in RAX and index in RCX. Preserves RAX and RCX.
bl_bounds_check=(pos:BlWord):>void=>$unsafe {
    b16(0xD231) # xor edx, edx
    bl_test_rr(RAX)
    let is_null=jcc32(CC_E)
    mov_rm(RDX  RAX  8)
    patch_here(is_null)
    op_rr(0x39  true  RDX  RCX) # cmp rcx, rdx
    let ok=jcc32(CC_B)
    mov_rr(RDI  RCX)
    mov_rr(RSI  RDX)
    rel_fixup_lea(RDX  0  XWord(loc_data(pos)))
    bl_set_pos(pos)
    bl_call_pos(rt("__panic_bounds"))
    b16(0x0B0F) # ud2
    patch_here(ok)
}

# Compute address of place e into RAX.
bl_plain_local_off=(e:BlWord):>XWord=>$unsafe {
    if nodes.ptr[e].kind not=? 'ident' or nodes.ptr[e].aux not=? 1 {return 0}
    let idx=bl_loc_idx(BlWord(nodes.ptr[e].sym))
    if idx <? 0 or bl_loc_kind.ptr[idx] not=? int8(0) {return 0}
    let t=quantity_base(prune(ntype(e)))
    if vc(t) not=? VC_INT {return 0}
    XWord(bl_loc_off.ptr[idx])
}

bl_plain_local_reg=(e:BlWord):>XWord=>$unsafe {
    if nodes.ptr[e].kind not=? 'ident' or nodes.ptr[e].aux not=? 1 {return -1}
    let idx=bl_loc_idx(BlWord(nodes.ptr[e].sym))
    if idx <? 0 or bl_loc_kind.ptr[idx] not=? int8(3) {return -1}
    R13
}

bl_load_plain_local=(r:XWord e:BlWord off:XWord):>void=>$unsafe {
    let t=quantity_base(prune(ntype(e)))
    let sg=types.ptr[t].kind =? 'int_' and types.ptr[t].sign
    load_sized(r  RBP  -off  XWord(tsize(t))  sg)
}

bl_is_simple_scalar_index=(e:BlWord):>bool=>$unsafe {
    if nodes.ptr[e].kind not=? 'index' or nodes.ptr[e].aux not=? 0 {return false}
    let t=quantity_base(prune(ntype(e)))
    if vc(t) not=? VC_INT {return false}
    let a:BlWord=BlWord(nodes.ptr[e].a)
    let bt=prune(ntype(a))
    let bk=types.ptr[bt].kind
    if bk not=? 'array' and bk not=? 'str_' {return false}
    if bl_plain_local_off(a) <=? 0 {return false}
    let stride:XWord=if bk =? 'str_' {1} else {XWord(owner_stride(BlWord(types.ptr[bt].elem)))}
    if stride not=? 1 and stride not=? 2 and stride not=? 4 and stride not=? 8 {return false}
    let ixn:BlWord=BlWord(nodes.ptr[e].b)
    if quantity_base(prune(ntype(ixn))) =? T_MATH_INT {return false}
    bl_plain_local_reg(ixn) >=? 0 or bl_plain_local_off(ixn) >? 0 or nodes.ptr[ixn].kind =? 'int_lit'
}

# Emit fast SIB read of simple scalar array/str index into RAX without clobbering R8.
bl_eval_scalar_index=(e:BlWord):>void=>$unsafe {
    let a:BlWord=BlWord(nodes.ptr[e].a)
    let ixn:BlWord=BlWord(nodes.ptr[e].b)
    let al:BlWord=BlWord(nodes.ptr[a].sym)
    let aoff=bl_plain_local_off(a)
    let bt=prune(ntype(a))
    let bk=types.ptr[bt].kind
    let t=quantity_base(prune(ntype(e)))
    let stride:XWord=if bk =? 'str_' {1} else {XWord(owner_stride(BlWord(types.ptr[bt].elem)))}
    let scale:XWord=if stride =? 1 {0} else if stride =? 2 {1} else if stride =? 4 {2} else {3}
    let sg=types.ptr[t].kind =? 'int_' and types.ptr[t].sign
    let ireg=bl_plain_local_reg(ixn)
    let idx_r:XWord=RCX
    if ireg >=? 0 {
        idx_r=ireg
    } else {
        let ioff2=bl_plain_local_off(ixn)
        if ioff2 >? 0 {bl_load_plain_local(RCX  ixn  ioff2)}
        else {mov_imm(RCX  XWord(nodes.ptr[ixn].ival))}
    }
    let proven=has_flag(e NF_INBOUNDS) or (bl_for_reg_active and ireg =? R13 and al =? bl_for_inbounds_arr)
    if proven {
        mov_rm_rbp(RAX  -aoff)
    } else if bl_for_reg_active and al =? bl_for_hoist_arr {
        op_rr(0x39  true  R15  idx_r) # cmp idx_r, r15 (hoisted len)
        let ok=jcc32(CC_B)
        mov_rr(RDI  idx_r)
        mov_rr(RSI  R15)
        rel_fixup_lea(RDX  0  XWord(loc_data(nodes.ptr[e].pos)))
        bl_set_pos(nodes.ptr[e].pos)
        bl_call_pos(rt("__panic_bounds"))
        b16(0x0B0F)
        patch_here(ok)
        mov_rm_rbp(RAX  -aoff)
    } else {
        mov_rm_rbp(RAX  -aoff)
        if idx_r not=? RCX {mov_rr(RCX  idx_r)}
        bl_bounds_check(nodes.ptr[e].pos)
        idx_r=RCX
    }
    use_index(idx_r  scale)
    load_sized(RAX  RAX  24  XWord(tsize(t))  sg)
    use_index(-1  0)
    bl_last_owned=false
    bl_last_slot=-1
}

bl_frozen_off_of=(n:BlWord):>XWord=>$unsafe {
    let k=bl_frozen_node.length
    if k >? 0 {
        let i=k - 1
        loop i >=? 0 {
            if bl_frozen_node.ptr[i] =? n {return XWord(bl_frozen_off.ptr[i])}
            i -= 1
        }
    }
    0
}

bl_eval_index=(ixn:BlWord):>void=>$unsafe {
    let foff=bl_frozen_off_of(ixn)
    if foff >? 0 {
        mov_rm_rbp(RAX  -foff)
        bl_last_owned=false
        bl_last_slot=-1
        return
    }
    bl_eval_borrowed(ixn)
}

bl_place_addr=(e:BlWord write:bool):>void=>$unsafe {
    let k=nodes.ptr[e].kind
    if k =? 'ident' {
        if nodes.ptr[e].aux =? 1 {
            let l:BlWord=BlWord(nodes.ptr[e].sym)
            let idx=bl_loc_idx(l)
            let lk=bl_loc_kind.ptr[idx]
            if lk =? int8(2) {
                bl_place_addr(BlWord(locals.ptr[l].alias)  write)
                return
            }
            let off=XWord(bl_loc_off.ptr[idx])
            if lk =? int8(1) {mov_rm_rbp(RAX  -off)}
            else {lea_rbp(RAX  -off)}
            return
        }
        rel_fixup_lea(RAX  1  XWord(global_addr_off(BlWord(nodes.ptr[e].sym))))
        return
    }
    if k =? 'field' {
        let a:BlWord=BlWord(nodes.ptr[e].a)
        let bt=prune(ntype(a))
        if nodes.ptr[e].aux =? -3 {
            bl_place_addr(a  write)
            layout(bt)
            let si:BlWord=BlWord(types.ptr[bt].st)
            let f:BlWord=BlWord(variants.ptr[BlWord(structs.ptr[si].variants) + BlWord(nodes.ptr[e].aux2)].fields) + BlWord(nodes.ptr[e].ival)
            if fields.ptr[f].boxed {
                mov_rm(RAX  RAX  XWord(fields.ptr[f].offset))
                bl_box_val(BlWord(fields.ptr[f].type))
            } else {
                bl_add_imm(RAX  XWord(fields.ptr[f].offset))
            }
            return
        }
        if types.ptr[bt].kind =? 'ptr' {
            bl_eval_borrowed(a)
            bt=prune(BlWord(types.ptr[bt].elem))
        } else {
            bl_place_addr(a  write)
        }
        layout(bt)
        if types.ptr[bt].kind =? 'tuple' {
            bl_add_imm(RAX  XWord(tuple_off(bt  nodes.ptr[e].ival)))
            return
        }
        let f:BlWord=BlWord(structs.ptr[BlWord(types.ptr[bt].st)].fields) + BlWord(nodes.ptr[e].aux)
        if fields.ptr[f].boxed {
            mov_rm(RAX  RAX  XWord(fields.ptr[f].offset))
            bl_box_val(BlWord(fields.ptr[f].type))
        } else {
            bl_add_imm(RAX  XWord(fields.ptr[f].offset))
        }
        return
    }
    if k =? 'unwrap' {
        let a:BlWord=BlWord(nodes.ptr[e].a)
        let ot=prune(ntype(a))
        bl_place_addr(a  write)
        if ptr_optional(ot) {
            mov_rm(RCX  RAX  0)
        } else {
            load_sized(RCX  RAX  XWord(tsize(BlWord(types.ptr[ot].elem)))  1  false)
        }
        bl_test_rr(RCX)
        let ok=jcc32(CC_NE)
        rel_fixup_lea(RDI  0  XWord(loc_data(nodes.ptr[e].pos)))
        bl_set_pos(nodes.ptr[e].pos)
        bl_call_pos(rt("__panic_unwrap"))
        b16(0x0B0F)
        patch_here(ok)
        return
    }
    if k =? 'narrow' {
        let a:BlWord=BlWord(nodes.ptr[e].a)
        let ut=prune(ntype(a))
        layout(ut)
        bl_place_addr(a  write)
        let vi:BlWord=BlWord(nodes.ptr[e].aux)
        load_sized(RCX  RAX  0  4  false)
        bl_cmp_imm(RCX  XWord(vi))
        let ok=jcc32(CC_E)
        rel_fixup_lea(RDI  0  XWord(loc_data(nodes.ptr[e].pos)))
        bl_set_pos(nodes.ptr[e].pos)
        bl_call_pos(rt("__panic_narrow"))
        b16(0x0B0F)
        patch_here(ok)
        let f:BlWord=BlWord(variants.ptr[BlWord(structs.ptr[BlWord(types.ptr[ut].st)].variants) + vi].fields)
        bl_add_imm(RAX  XWord(fields.ptr[f].offset))
        return
    }
    if k =? 'index' {
        let a:BlWord=BlWord(nodes.ptr[e].a)
        let ixn:BlWord=BlWord(nodes.ptr[e].b)
        let bt=prune(ntype(a))
        let bk=types.ptr[bt].kind
        if bk =? 'ptr' {
            let aoff=bl_plain_local_off(a)
            if aoff >? 0 {
                let foff=bl_frozen_off_of(ixn)
                if foff >? 0 {
                    mov_rm_rbp(RAX  -aoff)
                    mov_rm_rbp(RCX  -foff)
                } else {
                    let ioff2=bl_plain_local_off(ixn)
                    if ioff2 >? 0 {
                        mov_rm_rbp(RAX  -aoff)
                        bl_load_plain_local(RCX  ixn  ioff2)
                    } else if nodes.ptr[ixn].kind =? 'int_lit' {
                        mov_rm_rbp(RAX  -aoff)
                        mov_imm(RCX  XWord(nodes.ptr[ixn].ival))
                    } else {
                        bl_eval_borrowed(ixn)
                        mov_rr(RCX  RAX)
                        mov_rm_rbp(RAX  -aoff)
                    }
                }
            } else {
                let direct=nodes.ptr[a].kind =? 'intrinsic' and (nodes.ptr[a].aux as IN) =? IN.arrdata and nkids(a) =? 1 and nodes.ptr[kid(a 0)].kind =? 'ident'
                let ioff=bl_tmp_alloc(8)
                if direct {
                    bl_eval_index(ixn)
                    mov_mr_rbp(-ioff  RAX)
                    bl_eval_borrowed(a)
                    mov_rm_rbp(RCX  -ioff)
                } else {
                    bl_eval_borrowed(a)
                    mov_mr_rbp(-ioff  RAX)
                    bl_eval_index(ixn)
                    mov_rr(RCX  RAX)
                    mov_rm_rbp(RAX  -ioff)
                }
            }
            bl_imul_imm(RCX  XWord(tsize(BlWord(types.ptr[bt].elem))))
            op_rr(0x01  true  RCX  RAX)
            return
        }
        if bk =? 'array' or bk =? 'str_' {
            let aoff=if not write {bl_plain_local_off(a)} else {0}
            if aoff >? 0 {
                let foff=bl_frozen_off_of(ixn)
                if foff >? 0 {
                    mov_rm_rbp(RAX  -aoff)
                    mov_rm_rbp(RCX  -foff)
                } else {
                    let ioff2=bl_plain_local_off(ixn)
                    if ioff2 >? 0 {
                        mov_rm_rbp(RAX  -aoff)
                        bl_load_plain_local(RCX  ixn  ioff2)
                    } else if nodes.ptr[ixn].kind =? 'int_lit' {
                        mov_rm_rbp(RAX  -aoff)
                        mov_imm(RCX  XWord(nodes.ptr[ixn].ival))
                    } else {
                        bl_eval_borrowed(ixn)
                        mov_rr(RCX  RAX)
                        mov_rm_rbp(RAX  -aoff)
                    }
                }
            } else if write and bk =? 'array' {
                bl_place_addr(a  true)
                let poff=bl_tmp_alloc(8)
                mov_mr_rbp(-poff  RAX)
                if not is_uniq_array(a) {
                    mov_rm(RAX  RAX  0)
                    bl_arr_unique_rax(bt)
                    mov_rm_rbp(R10  -poff)
                    mov_mr(R10  0  RAX)
                }
                bl_eval_index(ixn)
                mov_rr(RCX  RAX)
                mov_rm_rbp(R10  -poff)
                mov_rm(RAX  R10  0)
            } else if nodes.ptr[a].kind =? 'ident' {
                let ioff=bl_tmp_alloc(8)
                bl_eval_index(ixn)
                mov_mr_rbp(-ioff  RAX)
                bl_eval_borrowed(a)
                mov_rm_rbp(RCX  -ioff)
            } else {
                let ioff=bl_tmp_alloc(8)
                bl_eval_borrowed(a)
                mov_mr_rbp(-ioff  RAX)
                bl_eval_index(ixn)
                mov_rr(RCX  RAX)
                mov_rm_rbp(RAX  -ioff)
            }
            if not has_flag(e NF_INBOUNDS) {bl_bounds_check(nodes.ptr[e].pos)}
            let stride:XWord=if bk =? 'str_' {1} else {XWord(owner_stride(BlWord(types.ptr[bt].elem)))}
            bl_imul_imm(RCX  stride)
            op_rr(0x01  true  RCX  RAX)
            bl_add_imm(RAX  24)
            return
        }
        if bk =? 'fixed' {
            let boff=bl_tmp_alloc(8)
            bl_place_addr(a  write)
            mov_mr_rbp(-boff  RAX)
            bl_eval_index(ixn)
            mov_rr(RCX  RAX)
            let flen=fixed_len(bt)
            if nodes.ptr[ixn].kind not=? 'int_lit' and not has_flag(e NF_INBOUNDS) and not fixed_index_domain(ixn  flen) {
                mov_imm(RDX  XWord(flen))
                op_rr(0x39  true  RDX  RCX)
                let ok=jcc32(CC_B)
                mov_rr(RDI  RCX)
                mov_rr(RSI  RDX)
                rel_fixup_lea(RDX  0  XWord(loc_data(nodes.ptr[e].pos)))
                bl_set_pos(nodes.ptr[e].pos)
                bl_call_pos(rt("__panic_bounds"))
                b16(0x0B0F)
                patch_here(ok)
            }
            bl_imul_imm(RCX  XWord(tsize(BlWord(types.ptr[bt].elem))))
            mov_rm_rbp(RAX  -boff)
            op_rr(0x01  true  RCX  RAX)
            return
        }
    }
    # Non-place rvalue expression (read-only): evaluate into temp address.
    let t=prune(ntype(e))
    bl_eval_borrowed(e)
    if vc(t) not=? VC_AGG {
        let toff=bl_tmp_alloc(8)
        bl_save_res(t  toff)
        lea_rbp(RAX  -toff)
    }
}

bl_eval_borrowed=(e:BlWord):>void=>$unsafe {
    bl_eval(e)
    bl_borrow(ntype(e))
}

bl_eval_owned=(e:BlWord):>void=>$unsafe {
    bl_eval(e)
    bl_own(e  ntype(e))
}

# Evaluate a binary scalar/ptr/enum operation (a in RAX, b in RCX).
bl_emit_alu=(op_tok:BlWord lt:BlWord res_ty:BlWord is_floor:bool pos:BlWord bnode:BlWord):>void=>$unsafe {
    let op=cx_token_values.ptr[op_tok]
    let sg=types.ptr[lt].kind =? 'int_' and types.ptr[lt].sign
    if op =? 'plus' {op_rr(0x01  true  RCX  RAX)}
    else if op =? 'minus' {op_rr(0x29  true  RCX  RAX)}
    else if op =? 'star' {
        rex(true  RAX  0  RCX  false)
        b(0x0F); b(0xAF)
        modrr(RAX  RCX)
    }
    else if op =? 'amp' {op_rr(0x21  true  RCX  RAX)}
    else if op =? 'pipe' {op_rr(0x09  true  RCX  RAX)}
    else if op =? 'caret' {op_rr(0x31  true  RCX  RAX)}
    else if op =? 'shl' or op =? 'shr' {
        if op =? 'shr' and int_policy(lt) =? 1 and not sg and types.ptr[lt].bits =? 32 {
            op_rr(0x8B  false  RAX  RAX) # zext32
        }
        let ext:XWord=if op =? 'shl' {4} else if sg {7} else {5}
        if dewy_at(pos) {
            let k=if bnode >? 0 {shift_count_bound(bnode)} else {-1}
            if k >=? 64 {
                if op =? 'shr' and sg {
                    rex(true  0  0  RAX  false); b(0xC1); modrr(7  RAX); b(63)
                } else {
                    b16(0xC031) # xor eax, eax
                }
            } else if k >=? 0 {
                rex(true  0  0  RAX  false); b(0xD3); modrr(ext  RAX)
            } else {
                bl_cmp_imm(RCX  64)
                let ok=jcc32(CC_B)
                if op =? 'shr' and sg {
                    mov_imm(RCX  63)
                    patch_here(ok)
                    rex(true  0  0  RAX  false); b(0xD3); modrr(7  RAX)
                } else {
                    b16(0xC031)
                    let done=jmp32()
                    patch_here(ok)
                    rex(true  0  0  RAX  false); b(0xD3); modrr(ext  RAX)
                    patch_here(done)
                }
            }
        } else {
            rex(true  0  0  RAX  false); b(0xD3); modrr(ext  RAX)
        }
    }
    else if op =? 'slash' or op =? 'percent' {
        let skip_dz=bnode >? 0 and nodes.ptr[bnode].kind =? 'int_lit' and nodes.ptr[bnode].ival not=? 0
        if not skip_dz {
            bl_test_rr(RCX)
            let ok=jcc32(CC_NE)
            rel_fixup_lea(RDI  0  XWord(loc_data(pos)))
            bl_set_pos(pos)
            bl_call_pos(rt("__div_zero"))
            b16(0x0B0F)
            patch_here(ok)
        }
        let need_m1=sg and (tsize(lt) =? 8 or is_floor) and not (bnode >? 0 and nodes.ptr[bnode].kind =? 'int_lit' and nodes.ptr[bnode].ival not=? -1)
        let done_m1:XWord=-1
        if need_m1 {
            bl_cmp_imm(RCX  -1)
            let not_m1=jcc32(CC_NE)
            if op =? 'percent' {b16(0xC031)}
            else {rex(true  0  0  RAX  false); b(0xF7); modrr(3  RAX)} # neg rax
            done_m1=jmp32()
            patch_here(not_m1)
        }
        if sg {
            b(0x48); b(0x99) # cqo
            rex(true  0  0  RCX  false); b(0xF7); modrr(7  RCX) # idiv rcx
            if is_floor {
                bl_test_rr(RDX)
                let no_adj=jcc32(CC_E)
                mov_rr(R11  RDX)
                op_rr(0x31  true  RCX  R11) # xor r11, rcx
                bl_test_rr(R11)
                let same_sgn=jcc32(CC_GE)
                if op =? 'slash' {bl_add_imm(RAX  -1)}
                else {op_rr(0x01  true  RCX  RDX)}
                patch_here(same_sgn)
                patch_here(no_adj)
            }
        } else {
            b16(0xD231) # xor edx, edx
            rex(true  0  0  RCX  false); b(0xF7); modrr(6  RCX) # div rcx
        }
        if op =? 'percent' {mov_rr(RAX  RDX)}
        if done_m1 >=? 0 {patch_here(done_m1)}
    }
    else {
        # Comparison
        op_rr(0x39  true  RCX  RAX) # cmp rax, rcx
        let cc:XWord=if op =? 'eq' {CC_E}
            else if op =? 'ne' {CC_NE}
            else if op =? 'lt' {if sg {CC_L} else {CC_B}}
            else if op =? 'le' {if sg {CC_LE} else {CC_BE}}
            else if op =? 'gt' {if sg {CC_G} else {CC_A}}
            else {if sg {CC_GE} else {CC_AE}}
        setcc(cc)
        return
    }
    if int_policy(res_ty) =? 1 {bl_norm(RAX  res_ty)}
}

# Evaluate a binary float operation (a in XMM0, b in XMM1).
bl_emit_falu=(op_tok:BlWord lt:BlWord):>void=>$unsafe {
    let op=cx_token_values.ptr[op_tok]
    let is_f32=tsize(quantity_base(lt)) =? 4
    let pre:XWord=if is_f32 {0xF3} else {0xF2}
    if op =? 'plus' {sse_rr(pre  0x58  0  1); return}
    if op =? 'minus' {sse_rr(pre  0x5C  0  1); return}
    if op =? 'star' {sse_rr(pre  0x59  0  1); return}
    if op =? 'slash' {sse_rr(pre  0x5E  0  1); return}
    let cpre:XWord=if is_f32 {0} else {0x66}
    if op =? 'lt' or op =? 'le' {
        sse_rr(cpre  0x2E  1  0) # ucomisd/ss xmm1, xmm0
        setcc(if op =? 'lt' {CC_A} else {CC_AE})
        return
    }
    sse_rr(cpre  0x2E  0  1) # ucomisd/ss xmm0, xmm1
    if op =? 'gt' or op =? 'ge' {
        setcc(if op =? 'gt' {CC_A} else {CC_AE})
        return
    }
    if op =? 'eq' {
        b24(0xC0940F) # sete al
        b24(0xC19B0F) # setnp cl
        b16(0xC820) # and al, cl
        b24(0xC0B60F) # movzx eax, al
        return
    }
    b24(0xC0950F) # setne al
    b24(0xC19A0F) # setp cl
    b16(0xC808) # or al, cl
    b24(0xC0B60F) # movzx eax, al
}

bl_emit_f2i_sat=(is_f32:bool):>void=>$unsafe {
    let pre:XWord=if is_f32 {0xF3} else {0xF2}
    let cpre:XWord=if is_f32 {0} else {0x66}
    b(pre); rex(true  RAX  0  0  false); b(0x0F); b(0x2C); modrr(RAX  0) # cvttsd/ss2si rax, xmm0
    rex(true  0  0  RAX  false); b(0x83); modrr(7  RAX); b(1) # cmp rax, 1
    let done=jcc32(1) # jno
    sse_rr(cpre  0x2E  0  0) # ucomi xmm0, xmm0
    let nan=jcc32(CC_P)
    sse_rr(0  0x57  2  2) # xorps xmm2, xmm2
    sse_rr(cpre  0x2E  0  2) # ucomi xmm0, xmm2
    let neg=jcc32(CC_BE)
    mov_imm(RAX  0x7FFFFFFFFFFFFFFF)
    let done2=jmp32()
    patch_here(nan)
    b16(0xC031) # xor eax, eax
    patch_here(done)
    patch_here(neg)
    patch_here(done2)
}

bl_emit_float2int=(e:BlWord a:BlWord fr0:BlWord to0:BlWord):>void=>$unsafe {
    let fr=quantity_base(fr0)
    let to=quantity_base(to0)
    let is_f32=tsize(fr) =? 4
    let pre:XWord=if is_f32 {0xF3} else {0xF2}
    let cpre:XWord=if is_f32 {0} else {0x66}
    let bits:BlWord=64
    let sg=true
    if types.ptr[to].kind =? 'int_' {
        bits=BlWord(types.ptr[to].bits)
        sg=types.ptr[to].sign
    }
    bl_eval_borrowed(a)
    if dewy_at(nodes.ptr[e].pos) {
        if not ff_int_proven.has(e) {
            if is_f32 {sse_rr(0xF3  0x5A  1  0)} # cvtss2sd xmm1, xmm0
            else {sse_rr(0  0x28  1  0)} # movaps xmm1, xmm0
            let low_v:float64=if sg and bits =? 64 {-9223372036854775808.0} else if sg {-float64(BlWord(1) << (bits - 1)) - 1.0} else {-1.0}
            bl_fconst(2  low_v  false)
            sse_rr(0x66  0x2E  1  2) # ucomisd xmm1, xmm2
            let ok_lo=jcc32(if sg and bits =? 64 {CC_AE} else {CC_A})
            let fail_lo=jmp32()
            patch_here(ok_lo)
            let top_v:float64=if bits =? 64 and not sg {18446744073709551616.0} else if bits =? 64 {9223372036854775808.0} else if sg {float64(BlWord(1) << (bits - 1))} else {float64(BlWord(1) << bits)}
            bl_fconst(2  top_v  false)
            sse_rr(0x66  0x2E  2  1) # ucomisd xmm2, xmm1 (top > w)
            let ok_hi=jcc32(CC_A)
            patch_here(fail_lo)
            sse_rr(0  0x28  0  1) # movaps xmm0, xmm1
            rel_fixup_lea(RDI  0  XWord(str_data(dt(to))))
            rel_fixup_lea(RSI  0  XWord(loc_data(nodes.ptr[e].pos)))
            bl_set_pos(nodes.ptr[e].pos)
            bl_call_pos(rt("__float_int_fail"))
            b16(0x0B0F)
            patch_here(ok_hi)
        }
        if bits =? 64 and not sg {
            bl_fconst(1  9223372036854775808.0  is_f32)
            sse_rr(cpre  0x2E  0  1) # ucomi xmm0, 2^63
            let lo_u64=jcc32(CC_B)
            sse_rr(pre  0x5C  0  1) # subsd/ss xmm0, 2^63
            b(pre); rex(true  RAX  0  0  false); b(0x0F); b(0x2C); modrr(RAX  0)
            mov_imm(RCX  XWord(-9223372036854775807 - 1))
            op_rr(0x31  true  RCX  RAX)
            let done_u64=jmp32()
            patch_here(lo_u64)
            b(pre); rex(true  RAX  0  0  false); b(0x0F); b(0x2C); modrr(RAX  0)
            patch_here(done_u64)
            return
        }
        b(pre); rex(true  RAX  0  0  false); b(0x0F); b(0x2C); modrr(RAX  0)
        bl_norm(RAX  to)
        return
    }
    # Jo saturating float2int
    if bits =? 64 and not sg {
        bl_fconst(1  9223372036854775808.0  is_f32)
        sse_rr(cpre  0x2E  0  1)
        let lo_u64=jcc32(CC_B)
        let nan_u64=jcc32(CC_P)
        sse_rr(pre  0x5C  0  1)
        bl_emit_f2i_sat(is_f32)
        mov_imm(RCX  XWord(-9223372036854775807 - 1))
        op_rr(0x31  true  RCX  RAX)
        let done_u64=jmp32()
        patch_here(lo_u64)
        patch_here(nan_u64)
        bl_emit_f2i_sat(is_f32)
        bl_test_rr(RAX)
        let ge0=jcc32(CC_GE)
        b16(0xC031)
        patch_here(ge0)
        patch_here(done_u64)
        return
    }
    bl_emit_f2i_sat(is_f32)
    if bits <? 64 {
        let lo:BlWord=if sg {-(BlWord(1) << (bits - 1))} else {0}
        let hi:BlWord=if sg {(BlWord(1) << (bits - 1)) - 1} else {(BlWord(1) << bits) - 1}
        mov_imm(RCX  XWord(lo))
        op_rr(0x39  true  RCX  RAX)
        let ok_lo=jcc32(CC_GE)
        mov_rr(RAX  RCX)
        patch_here(ok_lo)
        mov_imm(RCX  XWord(hi))
        op_rr(0x39  true  RCX  RAX)
        let ok_hi=jcc32(CC_LE)
        mov_rr(RAX  RCX)
        patch_here(ok_hi)
    }
    bl_norm(RAX  to)
}

bl_math_word_rax=(pos:BlWord):>void=>$unsafe {
    mov_rr(RCX  RAX)
    bl_sh_imm(4  RAX  1)
    mov_rr(RDX  RAX)
    bl_sh_imm(7  RDX  1)
    op_rr(0x39  true  RCX  RDX)
    let ok=jcc32(CC_E)
    mov_rr(RDI  RCX)
    bl_set_pos(pos)
    bl_call_pos(rt("__mi_word"))
    patch_here(ok)
}

bl_math_signed_rax=(pos:BlWord):>void=>$unsafe {
    bl_test_r_imm(RAX  1)
    let slow=jcc32(CC_NE)
    bl_sh_imm(7  RAX  1)
    let done=jmp32()
    patch_here(slow)
    mov_rr(RDI  RAX)
    bl_set_pos(pos)
    bl_call_pos(rt("__mi_signed"))
    patch_here(done)
}

bl_eval_shift_count=(b0:BlWord pos:BlWord):>void=>$unsafe {
    bl_eval_borrowed(b0)
    if quantity_base(prune(ntype(b0))) =? T_MATH_INT {
        mov_rr(RDI  RAX)
        bl_set_pos(pos)
        bl_call_pos(rt("__mi_count"))
    }
}

bl_math_compare_regs=(op:Tok pos:BlWord secret:bool):>void=>$unsafe {
    let cc:XWord=if op =? 'eq' {CC_E}
        else if op =? 'ne' {CC_NE}
        else if op =? 'lt' {CC_L}
        else if op =? 'le' {CC_LE}
        else if op =? 'gt' {CC_G}
        else {CC_GE}
    mov_rr(RDX  RAX)
    op_rr(0x09  true  RCX  RDX)
    bl_test_r_imm(RDX  1)
    let slow=jcc32(CC_NE)
    op_rr(0x39  true  RCX  RAX)
    setcc(cc)
    let done=jmp32()
    patch_here(slow)
    mov_rr(RDI  RAX)
    mov_rr(RSI  RCX)
    bl_set_pos(pos)
    bl_call_pos(rt(if secret {"__mi_ct_compare"} else {"__mi_compare"}))
    bl_cmp_imm(RAX  0)
    setcc(cc)
    patch_here(done)
}

bl_math_binary_regs=(op:Tok pos:BlWord):>void=>$unsafe {
    mov_rr(RDI  RAX)
    mov_rr(RSI  RCX)
    mov_rr(RDX  RAX)
    op_rr(0x09  true  RCX  RDX)
    bl_test_r_imm(RDX  1)
    let slow0=jcc32(CC_NE)
    let slow1:XWord=-1
    let slow2:XWord=-1
    let slow_name:string=if op =? 'plus' {"__mi_add"}
        else if op =? 'minus' {"__mi_sub"}
        else if op =? 'star' {"__mi_mul"}
        else if op =? 'slash' {"__mi_div"}
        else if op =? 'percent' {"__mi_rem"}
        else if op =? 'amp' {"__mi_and"}
        else if op =? 'pipe' {"__mi_or"}
        else {"__mi_xor"}
    if op =? 'plus' {
        op_rr(0x01  true  RCX  RAX)
        slow1=jcc32(0) # jo
    } else if op =? 'minus' {
        op_rr(0x29  true  RCX  RAX)
        slow1=jcc32(0) # jo
    } else if op =? 'star' {
        bl_sh_imm(7  RAX  1)
        rex(true  RAX  0  RCX  false); b(0x0F); b(0xAF); modrr(RAX  RCX)
        slow1=jcc32(0) # jo
    } else if op =? 'amp' {
        op_rr(0x21  true  RCX  RAX)
    } else if op =? 'pipe' {
        op_rr(0x09  true  RCX  RAX)
    } else if op =? 'caret' {
        op_rr(0x31  true  RCX  RAX)
    } else {
        bl_sh_imm(7  RAX  1)
        bl_sh_imm(7  RCX  1)
        bl_test_rr(RCX)
        slow1=jcc32(CC_E)
        bl_cmp_imm(RCX  -1)
        let ok_d=jcc32(CC_NE)
        mov_imm(RDX  -4611686018427387904)
        op_rr(0x39  true  RDX  RAX)
        slow2=jcc32(CC_E)
        patch_here(ok_d)
        b(0x48); b(0x99) # cqo
        rex(true  0  0  RCX  false); b(0xF7); modrr(7  RCX) # idiv rcx
        if op =? 'percent' {mov_rr(RAX  RDX)}
        bl_sh_imm(4  RAX  1)
    }
    let done=jmp32()
    patch_here(slow0)
    if slow1 >=? 0 {patch_here(slow1)}
    if slow2 >=? 0 {patch_here(slow2)}
    bl_set_pos(pos)
    bl_call_pos(rt(slow_name))
    patch_here(done)
}

bl_math_shift_regs=(op:Tok signed_count:bool pos:BlWord):>void=>$unsafe {
    if signed_count {
        bl_test_rr(RCX)
        let ok_s=jcc32(CC_GE)
        bl_emit_int_overflow(pos)
        patch_here(ok_s)
    }
    mov_rr(RDI  RAX)
    mov_rr(RSI  RCX)
    bl_test_r_imm(RAX  1)
    let slow0=jcc32(CC_NE)
    bl_cmp_imm(RCX  64)
    let big=jcc32(CC_AE)
    let slow1:XWord=-1
    if op =? 'shr' {
        rex(true  0  0  RAX  false); b(0xD3); modrr(7  RAX)
        bl_alu_imm(4  RAX  -2)
    } else {
        mov_rr(RDX  RAX)
        rex(true  0  0  RAX  false); b(0xD3); modrr(4  RAX)
        mov_rr(R8  RAX)
        rex(true  0  0  R8  false); b(0xD3); modrr(7  R8)
        op_rr(0x39  true  RDX  R8)
        slow1=jcc32(CC_NE)
    }
    let done1=jmp32()
    patch_here(big)
    let done2:XWord=0
    if op =? 'shr' {
        bl_sh_imm(7  RAX  63)
        bl_alu_imm(4  RAX  -2)
        done2=jmp32()
    } else {
        bl_test_rr(RAX)
        done2=jcc32(CC_E)
    }
    patch_here(slow0)
    if slow1 >=? 0 {patch_here(slow1)}
    mov_imm(RDX  if op =? 'shr' {1} else {0})
    bl_set_pos(pos)
    bl_call_pos(rt("__mi_shift"))
    patch_here(done1)
    patch_here(done2)
}

bl_eval_binary=(e:BlWord):>void=>$unsafe {
    let a:BlWord=BlWord(nodes.ptr[e].a)
    let b0:BlWord=BlWord(nodes.ptr[e].b)
    let lt=prune(ntype(a))
    let aux:BlWord=BlWord(nodes.ptr[e].aux)
    let op_tok:BlWord=BlWord(nodes.ptr[e].op)
    let op=cx_token_values.ptr[op_tok]
    if aux =? 0 and quantity_base(lt) =? T_MATH_INT {
        if (op =? 'shl' or op =? 'shr') and bl_is_small_math(a) and nodes.ptr[b0].kind =? 'int_lit' and not has_flag(b0 NF_U64) and nodes.ptr[b0].ival >=? 0 and nodes.ptr[b0].ival <? 64 and (op =? 'shr' or bl_is_small_math(e)) {
            bl_eval_borrowed(a)
            let sh=XWord(nodes.ptr[b0].ival)
            if op =? 'shr' {
                bl_sh_imm(7  RAX  sh)
                bl_alu_imm(4  RAX  -2)
            } else {
                bl_sh_imm(4  RAX  sh)
            }
            bl_last_owned=false
            return
        }
        if not bl_is_pure_read(b0) {
            bl_eval_owned(a)
            bl_borrow(lt)
        } else {
            bl_eval_borrowed(a)
        }
        let aoff=bl_tmp_alloc(8)
        mov_mr_rbp(-aoff  RAX)
        if op =? 'shl' or op =? 'shr' {
            bl_eval_shift_count(b0  nodes.ptr[e].pos)
            mov_rr(RCX  RAX)
            mov_rm_rbp(RAX  -aoff)
            bl_math_shift_regs(op  types.ptr[prune(ntype(b0))].sign  nodes.ptr[e].pos)
            bl_last_owned=true
            bl_last_slot=-1
            return
        }
        bl_eval_borrowed(b0)
        mov_rr(RCX  RAX)
        mov_rm_rbp(RAX  -aoff)
        let small_ab=bl_is_small_math(a) and bl_is_small_math(b0)
        if op =? 'eq' or op =? 'ne' or op =? 'lt' or op =? 'le' or op =? 'gt' or op =? 'ge' {
            let sec=secret_compares.length >? 0 and secret_compares.get(e) not=? none
            if small_ab and not sec {
                let cc:XWord=if op =? 'eq' {CC_E} else if op =? 'ne' {CC_NE} else if op =? 'lt' {CC_L} else if op =? 'le' {CC_LE} else if op =? 'gt' {CC_G} else {CC_GE}
                op_rr(0x39  true  RCX  RAX)
                setcc(cc)
            } else {
                bl_math_compare_regs(op  nodes.ptr[e].pos  sec)
            }
            bl_last_owned=false
            return
        }
        if small_ab and (op =? 'amp' or op =? 'pipe' or op =? 'caret' or ((op =? 'plus' or op =? 'minus' or op =? 'star') and bl_is_small_math(e))) {
            if op =? 'plus' {op_rr(0x01  true  RCX  RAX)}
            else if op =? 'minus' {op_rr(0x29  true  RCX  RAX)}
            else if op =? 'star' {bl_sh_imm(7  RAX  1); rex(true  RAX  0  RCX  false); b(0x0F); b(0xAF); modrr(RAX  RCX)}
            else if op =? 'amp' {op_rr(0x21  true  RCX  RAX)}
            else if op =? 'pipe' {op_rr(0x09  true  RCX  RAX)}
            else {op_rr(0x31  true  RCX  RAX)}
            bl_last_owned=false
            return
        }
        bl_math_binary_regs(op  nodes.ptr[e].pos)
        bl_last_owned=true
        bl_last_slot=-1
        return
    }
    if aux =? 0 and vc(lt) =? VC_FLT {
        let aoff=bl_tmp_alloc(8)
        bl_eval_borrowed(a)
        bl_save_res(lt  aoff)
        bl_eval_borrowed(b0)
        sse_rr(0  0x28  1  0) # movaps xmm1, xmm0
        bl_load_res(lt  aoff)
        bl_emit_falu(op_tok  lt)
        bl_last_owned=false
        return
    }
    if aux =? 1 {
        if byte_eq_type(lt) {
            let aoff=bl_tmp_alloc(8)
            if not bl_is_pure_read(b0) {
                bl_eval_owned(a)
                bl_borrow(lt)
            } else {
                bl_eval_borrowed(a)
            }
            mov_mr_rbp(-aoff  RAX)
            bl_eval_borrowed(b0)
            mov_rm_rbp(R10  -aoff)
            op_rr(0x39  true  RAX  R10)
            let same_j=jcc32(CC_E)
            op_rr(0x31  false  RCX  RCX)
            bl_test_rr(R10)
            let a0_j=jcc32(CC_E)
            mov_rm(RCX  R10  8)
            patch_here(a0_j)
            op_rr(0x31  false  RDX  RDX)
            bl_test_rr(RAX)
            let b0_j=jcc32(CC_E)
            mov_rm(RDX  RAX  8)
            patch_here(b0_j)
            op_rr(0x39  true  RDX  RCX)
            let neq_j=jcc32(CC_NE)
            bl_test_rr(RCX)
            let zero_j=jcc32(CC_E)
            lea(RDI  R10  24)
            lea(RSI  RAX  24)
            mov_rr(RDX  RCX)
            bl_imul_imm(RDX  XWord(owner_stride(BlWord(types.ptr[lt].elem))))
            bl_set_pos(nodes.ptr[e].pos)
            bl_call_pos(rt("__mem_eq"))
            let done_j=jmp32()
            patch_here(same_j)
            patch_here(zero_j)
            mov_imm(RAX  1)
            let done2_j=jmp32()
            patch_here(neq_j)
            b16(0xC031)
            patch_here(done_j)
            patch_here(done2_j)
            if op =? 'ne' {rex(false  0  0  RAX  false); b(0x83); modrr(6  RAX); b(1)}
            bl_last_owned=false
            return
        }
        # Structural equality via HK.eq helper(&a, &b).
        let ad_off=bl_tmp_alloc(8)
        if (is_managed(lt) or vc(lt) =? VC_AGG) and not bl_is_pure_read(b0) {
            bl_eval_owned(a)
            bl_borrow(lt)
            if vc(lt) not=? VC_AGG {
                let toff=bl_tmp_alloc(8)
                bl_save_res(lt  toff)
                lea_rbp(RAX  -toff)
            }
        } else {
            bl_place_addr(a  false)
        }
        mov_mr_rbp(-ad_off  RAX)
        bl_place_addr(b0  false)
        mov_rr(RSI  RAX)
        mov_rm_rbp(RDI  -ad_off)
        bl_set_pos(nodes.ptr[e].pos)
        bl_call_pos(lf_helper(HK.eq lt 0))
        if op =? 'ne' {rex(false  0  0  RAX  false); b(0x83); modrr(6  RAX); b(1)}
        bl_last_owned=false
        return
    }
    if aux =? 6 {
        # opt == none / opt != none
        bl_eval_borrowed(a)
        if not ptr_optional(lt) {
            let inner:BlWord=BlWord(types.ptr[lt].elem)
            load_sized(RAX  RAX  XWord(tsize(inner))  1  false)
        }
        bl_test_rr(RAX)
        setcc(if op =? 'eq' {CC_E} else {CC_NE})
        bl_last_owned=false
        return
    }
    if aux =? 2 {
        # String concat / eq / cmp
        if not bl_is_pure_read(b0) {
            bl_eval_owned(a)
            bl_borrow(lt)
        } else {
            bl_eval_borrowed(a)
        }
        let aoff=bl_tmp_alloc(8)
        mov_mr_rbp(-aoff  RAX)
        bl_eval_borrowed(b0)
        mov_rr(RSI  RAX)
        mov_rm_rbp(RDI  -aoff)
        bl_set_pos(nodes.ptr[e].pos)
        if op =? 'plus' {
            bl_call_pos(rt("__str_concat"))
            bl_last_owned=true
            bl_last_slot=-1
            return
        }
        if op =? 'eq' or op =? 'ne' {
            bl_call_pos(rt("__str_eq"))
            if op =? 'ne' {rex(false  0  0  RAX  false); b(0x83); modrr(6  RAX); b(1)} # xor eax, 1
            bl_last_owned=false
            return
        }
        bl_call_pos(rt("__str_cmp"))
        bl_cmp_imm(RAX  0)
        let cc:XWord=if op =? 'lt' {CC_L} else if op =? 'le' {CC_LE} else if op =? 'gt' {CC_G} else {CC_GE}
        setcc(cc)
        bl_last_owned=false
        return
    }
    let is_floor=nodes.ptr[e].aux2 =? -1
    let res_ty=prune(ntype(e))
    let sg=types.ptr[lt].kind =? 'int_' and types.ptr[lt].sign
    if aux =? 0 {
        # Power-of-two floor/unsigned division and remainder without idiv.
        if (op =? 'slash' or op =? 'percent') and (is_floor or not sg) {
            let [known divisor]=integer_constant(b0)
            if known and divisor >? 0 and (divisor & (divisor - 1)) =? 0 {
                bl_eval_borrowed(a)
                if op =? 'percent' {
                    let mask=divisor - 1
                    if mask <=? 2147483647 {
                        bl_alu_imm(4  RAX  XWord(mask))
                    } else {
                        mov_imm(RCX  XWord(mask))
                        op_rr(0x21  true  RCX  RAX)
                    }
                } else {
                    bl_sh_imm(if sg {7} else {5}  RAX  bl_ctz_pow2(divisor))
                }
                if int_policy(res_ty) =? 1 {bl_norm(RAX  res_ty)}
                bl_last_owned=false
                return
            }
        }
        # Direct int_lit right-hand operand (no scratch spill or extra moves).
        if nodes.ptr[b0].kind =? 'int_lit' {
            let v=nodes.ptr[b0].ival
            let fits32=v >=? -2147483648 and v <=? 2147483647
            if (op =? 'plus' and fits32) or (op =? 'minus' and v >=? -2147483647 and v <=? 2147483647) or ((op =? 'amp' or op =? 'pipe' or op =? 'caret' or op =? 'star') and fits32) or ((op =? 'shl' or op =? 'shr') and v >=? 0 and v <? 64) or ((op =? 'eq' or op =? 'ne' or op =? 'lt' or op =? 'le' or op =? 'gt' or op =? 'ge') and fits32) {
                bl_eval_borrowed(a)
                if op =? 'plus' {bl_add_imm(RAX  XWord(v))}
                else if op =? 'minus' {bl_add_imm(RAX  XWord(-v))}
                else if op =? 'amp' {bl_alu_imm(4  RAX  XWord(v))}
                else if op =? 'pipe' {bl_alu_imm(1  RAX  XWord(v))}
                else if op =? 'caret' {bl_alu_imm(6  RAX  XWord(v))}
                else if op =? 'star' {bl_imul_imm(RAX  XWord(v))}
                else if op =? 'shl' or op =? 'shr' {
                    if op =? 'shr' and int_policy(lt) =? 1 and not sg and types.ptr[lt].bits =? 32 {
                        op_rr(0x8B  false  RAX  RAX)
                    }
                    let ext:XWord=if op =? 'shl' {4} else if sg {7} else {5}
                    bl_sh_imm(ext  RAX  XWord(v))
                } else {
                    bl_cmp_imm(RAX  XWord(v))
                    let cc:XWord=if op =? 'eq' {CC_E}
                        else if op =? 'ne' {CC_NE}
                        else if op =? 'lt' {if sg {CC_L} else {CC_B}}
                        else if op =? 'le' {if sg {CC_LE} else {CC_BE}}
                        else if op =? 'gt' {if sg {CC_G} else {CC_A}}
                        else {if sg {CC_GE} else {CC_AE}}
                    setcc(cc)
                    bl_last_owned=false
                    return
                }
                if int_policy(res_ty) =? 1 {bl_norm(RAX  res_ty)}
                bl_last_owned=false
                return
            }
        }
    }
    let is_math_sh=(op =? 'shl' or op =? 'shr') and quantity_base(prune(ntype(b0))) =? T_MATH_INT
    let breg=if is_math_sh {-1} else {bl_plain_local_reg(b0)}
    let boff=if is_math_sh or breg >=? 0 {0} else {bl_plain_local_off(b0)}
    bl_eval_borrowed(a)
    if is_math_sh {
        let aoff=bl_tmp_alloc(8)
        mov_mr_rbp(-aoff  RAX)
        bl_eval_shift_count(b0  nodes.ptr[e].pos)
        mov_rr(RCX  RAX)
        mov_rm_rbp(RAX  -aoff)
    } else if breg >=? 0 {
        mov_rr(RCX  breg)
    } else if boff >? 0 {
        bl_load_plain_local(RCX  b0  boff)
    } else if bl_is_pure_leaf(b0) {
        mov_rr(R10  RAX)
        bl_eval_borrowed(b0)
        mov_rr(RCX  RAX)
        mov_rr(RAX  R10)
    } else {
        let aoff=bl_tmp_alloc(8)
        mov_mr_rbp(-aoff  RAX)
        bl_eval_borrowed(b0)
        mov_rr(RCX  RAX)
        mov_rm_rbp(RAX  -aoff)
    }
    if aux =? 4 {
        bl_imul_imm(RCX  XWord(tsize(BlWord(types.ptr[lt].elem))))
        if op =? 'plus' {op_rr(0x01  true  RCX  RAX)}
        else {op_rr(0x29  true  RCX  RAX)}
        bl_last_owned=false
        return
    }
    if aux =? 5 {
        op_rr(0x29  true  RCX  RAX)
        let esz=XWord(tsize(BlWord(types.ptr[lt].elem)))
        if esz >? 1 {
            mov_imm(RCX  esz)
            b(0x48); b(0x99) # cqo
            rex(true  0  0  RCX  false); b(0xF7); modrr(7  RCX)
        }
        bl_last_owned=false
        return
    }
    bl_emit_alu(op_tok  lt  res_ty  is_floor  nodes.ptr[e].pos  b0)
    bl_last_owned=false
}

bl_is_safe_param_arg=(arg:BlWord):>bool=>$unsafe {
    if nodes.ptr[arg].kind not=? 'ident' or nodes.ptr[arg].aux not=? 1 {return false}
    let l:BlWord=BlWord(nodes.ptr[arg].sym)
    let fl:BlWord=BlWord(locals.ptr[l].flags)
    if fl & (LF_MUTPARAM | LF_ADDR | LF_EXPOSED | LF_ASSIGNED | LF_SHARED | LF_BYREF | LF_ALIAS | LF_CAPTURE) not=? 0 {return false}
    true
}

bl_eval_call=(e:BlWord):>void=>$unsafe {
    let aux=nodes.ptr[e].aux
    let t=prune(ntype(e))
    if aux =? 2 {
        # Struct constructor
        let si:BlWord=BlWord(types.ptr[t].st)
        layout(t)
        let sz=XWord(tsize(t))
        let off=bl_tmp_alloc(sz  XWord(talign(t)))
        bl_zero_mem(RBP  -off  sz)
        let smark=bl_scope_off.length
        if is_managed(t) {
            bl_scope_off.push(off); bl_scope_ty.push(t); bl_scope_agg.push(true)
        }
        let nk=nkids(e)
        let has_ord=nodes.ptr[e].c not=? 0
        let order:array<int64>=if has_ord {call_eval_order(e)} else {[]}
        loop k in [0..nk) {
            let i=if has_ord {order.ptr[k]} else {k}
            let a=kid(e i)
            if a =? 0 {continue}
            let f:BlWord=BlWord(structs.ptr[si].fields) + i
            let ft:BlWord=BlWord(fields.ptr[f].type)
            let foff=XWord(fields.ptr[f].offset)
            bl_eval_owned(a)
            if fields.ptr[f].boxed {
                let voff:XWord=if vc(ft) =? VC_AGG {bl_last_slot} else {let vo=bl_tmp_alloc(8); bl_save_res(ft  vo); vo}
                bl_last_owned=false
                bl_box_put(-off + foff  true  ft  voff)
            } else {
                bl_store_val(ft  RBP  -off + foff  RAX)
                bl_last_owned=false
            }
        }
        bl_scope_off.truncate(smark); bl_scope_ty.truncate(smark); bl_scope_agg.truncate(smark)
        lea_rbp(RAX  -off)
        bl_last_owned=true
        bl_last_slot=off
        return
    }
    if aux =? 3 {
        # Enum variant / union constructor
        let si:BlWord=BlWord(types.ptr[t].st)
        layout(t)
        let v:BlWord=BlWord(nodes.ptr[e].aux2)
        if structs.ptr[si].union_ and nkids(e) =? 1 {
            let j=union_index(t  ntype(kid(e 0)))
            if j >=? 0 {v=j}
        }
        let vi:BlWord=BlWord(structs.ptr[si].variants) + v
        if structs.ptr[si].simple_enum {
            mov_imm(RAX  XWord(variants.ptr[vi].value))
            bl_last_owned=false
            return
        }
        let sz=XWord(tsize(t))
        let off=bl_tmp_alloc(sz  XWord(talign(t)))
        bl_zero_mem(RBP  -off  sz)
        mov_imm(RAX  XWord(v))
        store_sized(RBP  -off  RAX  4)
        let smark=bl_scope_off.length
        if is_managed(t) {
            bl_scope_off.push(off); bl_scope_ty.push(t); bl_scope_agg.push(true)
        }
        let nk=nkids(e)
        let has_ord=nodes.ptr[e].c not=? 0
        let order:array<int64>=if has_ord {call_eval_order(e)} else {[]}
        loop k in [0..nk) {
            let i=if has_ord {order.ptr[k]} else {k}
            let a=kid(e i)
            let f:BlWord=BlWord(variants.ptr[vi].fields) + i
            let ft:BlWord=BlWord(fields.ptr[f].type)
            let foff=XWord(fields.ptr[f].offset)
            bl_eval_owned(a)
            if fields.ptr[f].boxed {
                let voff:XWord=if vc(ft) =? VC_AGG {bl_last_slot} else {let vo=bl_tmp_alloc(8); bl_save_res(ft  vo); vo}
                bl_last_owned=false
                bl_box_put(-off + foff  true  ft  voff)
            } else {
                bl_store_val(ft  RBP  -off + foff  RAX)
                bl_last_owned=false
            }
        }
        bl_scope_off.truncate(smark); bl_scope_ty.truncate(smark); bl_scope_agg.truncate(smark)
        lea_rbp(RAX  -off)
        bl_last_owned=true
        bl_last_slot=off
        return
    }
    if aux =? 4 {
        # C function pointer indirect call (gen_cfn_call)
        let callee:BlWord=BlWord(nodes.ptr[e].a)
        let ft=prune(ntype(callee))
        let rtp=prune(BlWord(types.ptr[ft].elem))
        let na=nkids(e)
        let fp_off=bl_tmp_alloc(8)
        bl_eval_borrowed(callee)
        mov_mr_rbp(-fp_off  RAX)
        let base_off:XWord=if na >? 0 {bl_tmp_alloc(XWord(na * 8))} else {0}
        loop i in [0..na) {
            let arg=kid(e i)
            let at=prune(ntype(arg))
            let disp:XWord=-base_off + XWord(i * 8)
            bl_eval_borrowed(arg)
            if vc(at) =? VC_FLT {sse_rm(bl_fpre(at)  0x11  0  RBP  disp)}
            else {mov_mr_rbp(disp  RAX)}
        }
        let int_i:BlWord=0
        let flt_i:BlWord=0
        loop i in [0..na) {
            let at=prune(ntype(kid(e i)))
            let disp:XWord=-base_off + XWord(i * 8)
            if vc(at) =? VC_FLT {
                sse_rm(bl_fpre(at)  0x10  XWord(flt_i)  RBP  disp)
                flt_i += 1
            } else {
                mov_rm_rbp(XWord(int_arg_regs.ptr[int_i])  disp)
                int_i += 1
            }
        }
        mov_rm_rbp(R11  -fp_off)
        bl_set_pos(nodes.ptr[e].pos)
        b24(0xD3FF41) # call r11
        bl_call_site()
        if rtp not=? T_NEVER and vc(rtp) =? VC_INT {
            bl_norm(RAX  rtp)
            bl_last_owned=is_managed(rtp)
        } else {
            bl_last_owned=false
        }
        bl_last_slot=-1
        return
    }
    # Direct call (aux == 0)
    let sym:BlWord=BlWord(nodes.ptr[e].sym)
    if fns.ptr[sym].deterministic {det_check(sym  kids(e)  nodes.ptr[e].pos)}
    let rtp=prune(BlWord(fns.ptr[sym].ret))
    let has_sret=rtp not=? T_NEVER and vc(rtp) =? VC_AGG
    let rslot:XWord=-1
    if has_sret {rslot=bl_tmp_alloc(XWord(tsize(rtp))  XWord(talign(rtp)))}
    let na=nkids(e)
    let mm=inst_mutmask(sym)
    if mm not=? 0 {
        let need_check=false
        loop i in [0..na) {
            if (mm & (BlWord(1) << i)) =? 0 {continue}
            let arg=kid(e i)
            if nodes.ptr[arg].kind not=? 'ident' or (nodes.ptr[arg].aux =? 1 and (BlWord(locals.ptr[BlWord(nodes.ptr[arg].sym)].flags) & LF_ALIAS) not=? 0) {need_check=true; break}
        }
        if need_check {mut_alias_check(kids(e)  mm  sym)}
    }
    let base_off:XWord=if na >? 0 {bl_tmp_alloc(XWord(na * 8))} else {0}
    let has_order=nodes.ptr[e].c not=? 0
    let order:array<int64>=if has_order {call_eval_order(e)} else {[]}
    let snap_mark=bl_snap_idx.length
    let cargs:array<int64>=[]
    let oargs:array<int64>=[]
    let have_cargs=false
    loop k in [0..na) {
        let i=if has_order {order.ptr[k]} else {k}
        let arg=kid(e i)
        let disp:XWord=-base_off + XWord(i * 8)
        if (mm & (BlWord(1) << i)) not=? 0 {
            bl_place_addr(arg  true)
            mov_mr_rbp(disp  RAX)
        } else {
            let pt=if i <? fns.ptr[sym].ptypes.length {prune(BlWord(fns.ptr[sym].ptypes.ptr[i]))} else {prune(ntype(arg))}
            if copies_on and copy_consumes(sym  i) {
                bl_eval_owned(arg)
                bl_last_owned=false
                mov_mr_rbp(disp  RAX)
            } else {
                bl_eval(arg)
                if vc(pt) =? VC_FLT {
                    sse_rm(bl_fpre(pt)  0x11  0  RBP  disp)
                } else {
                    let took_snap=false
                    if not bl_last_owned and (is_managed(pt) or vc(pt) =? VC_AGG) {
                        let need_snap=false
                        if bl_fn_copies_maybe and (copy_strict(arg) or copy_strict(e)) and costly_copy(pt) {
                            if not have_cargs {
                                cargs=kids(e)
                                if has_order {
                                    oargs.reserve(na)
                                    loop oi in [0..na) {oargs.push(cargs.ptr[order.ptr[oi]])}
                                }
                                have_cargs=true
                            }
                            let bargs=if has_order {oargs} else {cargs}
                            need_snap=(mm not=? 0 and shares_mut_root(arg  cargs  mm  (if is_managed(pt) {sym} else {-2}))) or borrow_may_change(arg  bargs  k  sym)
                        } else if not (bl_is_pure_leaf(arg) or (mm =? 0 and bl_is_safe_param_arg(arg))) {
                            # Fast O(1) check: a plain local evaluated last in a non-mut call cannot change.
                            let last_plain=mm =? 0 and k + 1 =? na and nodes.ptr[arg].kind =? 'ident' and nodes.ptr[arg].aux =? 1 and (BlWord(locals.ptr[BlWord(nodes.ptr[arg].sym)].flags) & (LF_MUTPARAM | LF_ADDR | LF_EXPOSED | LF_SHARED | LF_BYREF | LF_ALIAS | LF_CAPTURE)) =? 0
                            need_snap=not last_plain
                        }
                        if need_snap {
                            bl_own(arg  pt)
                            if is_managed(pt) {took_snap=true}
                        }
                    }
                    let tbefore=bl_temps_off.length
                    bl_borrow(pt)
                    if took_snap and bl_temps_off.length >? tbefore {bl_snap_idx.push(bl_temps_off.length - 1)}
                    mov_mr_rbp(disp  RAX)
                }
            }
        }
    }
    let ni:BlWord=if has_sret {1} else {0}
    let nf:BlWord=0
    let nstack:BlWord=0
    loop i in [0..na) {
        let is_mut=(mm & (BlWord(1) << i)) not=? 0
        let pt=if i <? fns.ptr[sym].ptypes.length {prune(BlWord(fns.ptr[sym].ptypes.ptr[i]))} else {prune(ntype(kid(e i)))}
        if not is_mut and vc(pt) =? VC_FLT {
            nf += 1
            if nf >? 8 {nstack += 1}
        } else {
            ni += 1
            if ni >? 6 {nstack += 1}
        }
    }
    let stack_bytes:XWord=0
    if nstack >? 0 {
        let pad:XWord=XWord((nstack & 1) * 8)
        if pad >? 0 {bl_add_imm(RSP  -8)}
        let ri=ni
        let rf=nf
        let i=na - 1
        loop i >=? 0 {
            let disp:XWord=-base_off + XWord(i * 8)
            let is_mut=(mm & (BlWord(1) << i)) not=? 0
            let pt=if i <? fns.ptr[sym].ptypes.length {prune(BlWord(fns.ptr[sym].ptypes.ptr[i]))} else {prune(ntype(kid(e i)))}
            if not is_mut and vc(pt) =? VC_FLT {
                rf -= 1
                if rf >=? 8 {
                    mov_rm_rbp(RAX  disp)
                    bl_push(RAX)
                }
            } else {
                ri -= 1
                if ri >=? 6 {
                    mov_rm_rbp(RAX  disp)
                    bl_push(RAX)
                }
            }
            i -= 1
        }
        stack_bytes=pad + XWord(nstack * 8)
    }
    let int_i:BlWord=0
    let flt_i:BlWord=0
    if has_sret {
        lea_rbp(RDI  -rslot)
        int_i=1
    }
    loop i in [0..na) {
        let disp:XWord=-base_off + XWord(i * 8)
        let is_mut=(mm & (BlWord(1) << i)) not=? 0
        let pt=if i <? fns.ptr[sym].ptypes.length {prune(BlWord(fns.ptr[sym].ptypes.ptr[i]))} else {prune(ntype(kid(e i)))}
        if not is_mut and vc(pt) =? VC_FLT {
            if flt_i <? 8 {sse_rm(bl_fpre(pt)  0x10  XWord(flt_i)  RBP  disp)}
            flt_i += 1
        } else {
            if int_i <? 6 {mov_rm_rbp(XWord(int_arg_regs.ptr[int_i])  disp)}
            int_i += 1
        }
    }
    let target_lf:BlWord=-1
    if callback_calls.length >? 0 {target_lf=callback_calls.get(callback_key(bl_cur_lf  e)) ?? (-1)}
    if target_lf <? 0 {target_lf=lf_of_inst(sym)}
    bl_set_pos(nodes.ptr[e].pos)
    bl_call_pos(target_lf)
    if stack_bytes >? 0 {bl_add_imm(RSP  stack_bytes)}
    if bl_snap_idx.length >? snap_mark {
        if rtp =? T_NEVER {
            loop bl_snap_idx.length >? snap_mark {
                let tidx=BlWord(bl_snap_idx.pop())
                bl_temps_ty[tidx]=0
            }
        } else {
            let need_save=not has_sret and vc(rtp) not=? VC_VOID
            let res_off:XWord=0
            if need_save {
                res_off=bl_tmp_alloc(8)
                bl_save_res(rtp  res_off)
            }
            loop bl_snap_idx.length >? snap_mark {
                let tidx=BlWord(bl_snap_idx.pop())
                let off=XWord(bl_temps_off.ptr[tidx])
                let ty=BlWord(bl_temps_ty.ptr[tidx])
                if ty not=? 0 {
                    if bl_temps_agg.ptr[tidx] {
                        lea_rbp(RDI  -off)
                        bl_call(lf_helper(HK.drop ty 0))
                    } else {
                        mov_rm_rbp(RAX  -off)
                        bl_release_val(ty)
                    }
                    bl_temps_ty[tidx]=0
                }
            }
            if need_save {bl_load_res(rtp  res_off)}
        }
        loop bl_temps_ty.length >? 0 and bl_temps_ty.ptr[bl_temps_ty.length - 1] =? 0 {
            bl_temps_off.pop();
            bl_temps_ty.pop();
            bl_temps_agg.pop();
        }
    }
    if has_sret {
        lea_rbp(RAX  -rslot)
        bl_last_owned=true
        bl_last_slot=rslot
    } else if rtp not=? T_NEVER and vc(rtp) =? VC_INT {
        bl_last_owned=is_managed(rtp)
        bl_last_slot=-1
    } else {
        bl_last_owned=false
        bl_last_slot=-1
    }
}

bl_eval_intrinsic=(e:BlWord):>void=>$unsafe {
    if effects_active or effect_policy.prohibitions not=? 0 {effect_lower_intrinsic(bl_cur_fi  e)}
    let id=nodes.ptr[e].aux as IN
    let na=nkids(e)
    if id =? IN.static_assert {bl_last_owned=false; return}
    if id =? IN.embed {
        rel_fixup_lea(RAX  0  XWord(str_data(name_of(BlWord(nodes.ptr[e].sval)))))
        bl_last_owned=false
        return
    }
    if id =? IN.argv {
        rel_fixup_lea(RAX  1  0)
        mov_rm(RAX  RAX  0)
        bl_last_owned=false
        return
    }
    if id =? IN.atomic_add or id =? IN.atomic_cas or id =? IN.stack_ptr or id =? IN.cpu_features {
        let base_off:XWord=if na >? 0 {bl_tmp_alloc(XWord(na * 8))} else {0}
        loop i in [0..na) {
            bl_eval_borrowed(kid(e i))
            mov_mr_rbp(-base_off + XWord(i * 8)  RAX)
        }
        loop i in [0..na) {mov_rm_rbp(XWord(int_arg_regs.ptr[i])  -base_off + XWord(i * 8))}
        let code:XWord=if id =? IN.atomic_add {6} else if id =? IN.atomic_cas {7} else if id =? IN.stack_ptr {8} else {9}
        b(0xE8)
        b32(0)
        stub_fix.push([XWord(x_code[0].length) - 4  code])
        bl_last_owned=false
        return
    }
    if id =? IN.sqrt {
        let a0=kid(e 0)
        bl_eval_borrowed(a0)
        sse_rr(bl_fpre(ntype(a0))  0x51  0  0) # sqrtsd/sqrtss xmm0, xmm0
        bl_last_owned=false
        return
    }
    if id =? IN.callc {
        let base_off=bl_tmp_alloc(XWord(na * 8))
        loop i in [0..na) {
            let arg=kid(e i)
            let at=prune(ntype(arg))
            bl_eval_borrowed(arg)
            if vc(at) =? VC_FLT {sse_rm(bl_fpre(at)  0x11  0  RBP  -base_off + XWord(i * 8))}
            else {mov_mr_rbp(-base_off + XWord(i * 8)  RAX)}
        }
        let int_i:BlWord=0
        let flt_i:BlWord=0
        loop i in [1..na) {
            let at=prune(ntype(kid(e i)))
            let disp:XWord=-base_off + XWord(i * 8)
            if vc(at) =? VC_FLT {
                sse_rm(bl_fpre(at)  0x10  XWord(flt_i)  RBP  disp)
                flt_i += 1
            } else {
                mov_rm_rbp(XWord(int_arg_regs.ptr[int_i])  disp)
                int_i += 1
            }
        }
        mov_rm_rbp(R11  -base_off)
        bl_set_pos(nodes.ptr[e].pos)
        b24(0xD3FF41) # call r11
        bl_call_site()
        bl_last_owned=false
        return
    }
    if id =? IN.len or id =? IN.arrcap {
        let a0=kid(e 0)
        let at=prune(ntype(a0))
        if id =? IN.len and types.ptr[at].kind =? 'fixed' {
            bl_eval_borrowed(a0)
            mov_imm(RAX  XWord(fixed_len(at)))
            bl_last_owned=false
            return
        }
        bl_eval_borrowed(a0)
        bl_test_rr(RAX)
        let is_null=jcc32(CC_E)
        mov_rm(RAX  RAX  if id =? IN.arrcap {16} else {8})
        patch_here(is_null)
        bl_last_owned=false
        return
    }
    if id =? IN.zeroed {
        let t=prune(ntype(e))
        if vc(t) =? VC_AGG {
            let sz=XWord(tsize(t))
            let off=bl_tmp_alloc(sz  XWord(talign(t)))
            bl_zero_mem(RBP  -off  sz)
            lea_rbp(RAX  -off)
            bl_last_owned=true
            bl_last_slot=off
            return
        }
        if vc(t) =? VC_FLT {
            sse_rr(0  0x57  0  0)
            bl_last_owned=false
            return
        }
        b16(0xC031) # xor eax, eax
        bl_last_owned=is_managed(t)
        bl_last_slot=-1
        return
    }
    if id =? IN.remove {
        let a0=kid(e 0)
        let a1=kid(e 1)
        let at=prune(ntype(a0))
        let et=prune(BlWord(types.ptr[at].elem))
        let esz=XWord(owner_stride(et))
        let poff=bl_tmp_alloc(8)
        let ioff=bl_tmp_alloc(8)
        bl_place_addr(a0  true)
        mov_mr_rbp(-poff  RAX)
        bl_eval_borrowed(a1)
        mov_mr_rbp(-ioff  RAX)
        mov_rm_rbp(RAX  -poff)
        mov_rm(RAX  RAX  0)
        if not is_uniq_array(a0) {
            bl_arr_unique_rax(at)
            mov_rm_rbp(R10  -poff)
            mov_mr(R10  0  RAX)
        }
        mov_rm_rbp(RCX  -ioff)
        bl_bounds_check(nodes.ptr[e].pos)
        bl_imul_imm(RCX  esz)
        op_rr(0x01  true  RCX  RAX)
        bl_add_imm(RAX  24)
        if vc(et) =? VC_AGG {
            let rslot=bl_tmp_alloc(XWord(tsize(et))  XWord(talign(et)))
            lea_rbp(RDI  -rslot)
            bl_copy_mem(RDI  RAX  XWord(tsize(et)))
            mov_rm_rbp(RDI  -poff)
            mov_imm(RSI  esz)
            mov_rm_rbp(RDX  -ioff)
            bl_set_pos(nodes.ptr[e].pos)
            bl_call_pos(rt("__arr_remove_slot"))
            lea_rbp(RAX  -rslot)
            bl_last_owned=true
            bl_last_slot=rslot
            return
        }

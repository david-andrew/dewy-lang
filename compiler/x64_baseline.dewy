            bl_place_addr(a0  true)
            mov_mr_rbp(-poff  RAX)
            if not is_uniq_array(a0) {
                mov_rm(RAX  RAX  0)
                bl_arr_unique_rax(at)
                mov_rm_rbp(R10  -poff)
                mov_mr(R10  0  RAX)
            }
            mov_rm_rbp(RDI  -poff)
            mov_rm_rbp(RSI  -data_off)
            mov_rm_rbp(RDX  -cnt_off)
            mov_imm(RCX  esz)
            bl_set_pos(nodes.ptr[e].pos)
            bl_call_pos(rt("__arr_extend_raw"))
            if is_managed(et) {
                let first_off=bl_tmp_alloc(8)
                let ioff=bl_tmp_alloc(8)
                mov_mr_rbp(-first_off  RAX)
                b16(0xC031)
                mov_mr_rbp(-ioff  RAX)
                let ltop=XWord(x_code[0].length)
                mov_rm_rbp(RCX  -ioff)
                mov_rm_rbp(RDX  -cnt_off)
                op_rr(0x39  true  RDX  RCX)
                let done_c=jcc32(CC_GE)
                bl_imul_imm(RCX  esz)
                mov_rm_rbp(RAX  -first_off)
                op_rr(0x01  true  RCX  RAX)
                bl_copy_at_reg(RAX  et)
                bl_add_m64_imm(RBP  -ioff  1)
                let back=jmp32()
                patch_branch(back  ltop)
                patch_here(done_c)
            }
            bl_last_owned=false
            return
        }
        let ys_off=bl_tmp_alloc(8)
        let cnt_off:XWord=if is_managed(et) {bl_tmp_alloc(8)} else {0}
        let sl_tm:BlWord=bl_temps_off.length
        let sl_sp:XWord=bl_sp
        let whole=copies_on and not is_slice(a1) and not costly_copy(et) and not copy_explicit.has(a1)
        if whole {copy_explicit[a1]=true}

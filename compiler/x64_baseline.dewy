            patch_branch(retry_j  retry_top)
            let done_j=jmp32()
            patch_here(canceled_j)
            mov_imm(RAX  -125)
            patch_here(done_j)
            bl_last_owned=false
            return
        }
        loop i in [0..na) {mov_rm_rbp(XWord(BL_SYSCALL_REGS.ptr[i])  -base_off + XWord(i * 8))}
        b16(0x050F) # syscall
        bl_last_owned=false
        return
    }
    if id =? IN.push {

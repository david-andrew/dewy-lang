        mov_mr(RAX  8  RCX)
        bl_imul_imm(RCX  esz)
        op_rr(0x01  true  RCX  RAX)
        bl_add_imm(RAX  24)
        let ea_off=bl_tmp_alloc(8)
        mov_mr_rbp(-ea_off  RAX)

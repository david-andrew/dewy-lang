from p"x64_emit.dewy" import (call_fix call_sites int_arg_regs line_rows row_pos stub_fix)
from p"x64_encode.dewy" import (CC_A CC_AE CC_B CC_BE CC_E CC_G CC_GE CC_L CC_LE CC_NE CC_P R10 R11 R8 R9 RAX RBP RBX RCX RDI RDX RSI RSP XWord b b16 b24 b32 jcc32 jmp32 lea lea_rbp load_sized mem modrr mov_imm mov_mr mov_mr_rbp mov_rm mov_rm_rbp mov_rr op_rm op_rm64 op_rr patch32 patch_branch patch_here rel_fixup_lea rex rsp_frame setcc sse_rm sse_rr store_sized use_index x_bytes x_code x_data_fix x_encode_begin x_encode_end x_pad_track)

BlWord:type=int64<overflow='wrap'>
const R12:XWord=12
const R13:XWord=13
const R14:XWord=14
const R15:XWord=15
const BL_SYSCALL_REGS:array<int64>=[RAX RDI RSI RDX R10 R8 R9]

bl_fn_begin=(lf:BlWord est:BlWord):>BlWord=>$unsafe {
    loop fn_addr.length <=? lf {fn_addr.push(-1)}
    loop fn_len.length <=? lf {fn_len.push(0)}
    x_encode_begin(XWord(est))
    let rem=XWord(code.length) & 63
    if rem not=? 0 {
        let pad=64 - rem
        mem_set(x_bytes(pad) 0xCC pad)
    }
    let fn_start=BlWord(code.length)
    fn_addr[lf]=fn_start
    rsp_frame=false
    x_pad_track=false
    fn_start
}

bl_fn_end=(lf:BlWord fn_start:BlWord):>void=>$unsafe {
    x_encode_end()
    let flen=BlWord(code.length) - fn_start
    elf_syms.push([sym_name(lfuncs.ptr[lf].name) fn_start flen])
    fn_len[lf]=flen
}

let bl_last_src_pos:BlWord=-1

bl_set_pos=(src_pos:BlWord):>void=>$unsafe {
    if src_pos =? 0 or src_pos =? bl_last_src_pos {return}
    bl_last_src_pos=src_pos
    ir_set_pos(src_pos)
    let p=XWord(ir_pos)
    if p not=? 0 and p not=? row_pos {
        row_pos=p
        line_rows.push(XWord(x_code[0].length))
        line_rows.push(p)
    }
}

bl_call_site=():>void=>$unsafe {
    let p=XWord(ir_pos)
    if p not=? 0 {
        call_sites.push(XWord(x_code[0].length))
        call_sites.push(p)
    }
}

bl_call=(target_lf:BlWord):>void=>$unsafe {
    b(0xE8)
    b32(0)
    call_fix.push([XWord(x_code[0].length) - 4  XWord(target_lf)])
}

bl_call_pos=(target_lf:BlWord):>void=>$unsafe {
    bl_call(target_lf)
    bl_call_site()
}

# Inline refcount increment for pointer in RAX (CALL_RC_INC template: preserves all other regs).
bl_rc_inc=():>void=>$unsafe {
    note_mt_active()
    let base=XWord(x_code[0].length)
    let p=x_bytes(40)
    let q=p as ptr<uint64>
    q[0]=0x3883482374C08548
    q[1]=0x00000D8D481D7E00
    q[2]=0x4805750039800000
    q[3]=0x000D8D480CEB00FF
    q[4]=0x00000000E8000000
    x_data_fix[0].push([base + 14  1  XWord(mt_active_off)])
    call_fix.push([base + 31  XWord(rt("__rc_inc"))])
    stub_fix.push([base + 36  12])
}

# Inline refcount decrement for pointer in RAX (CALL_RC_DEC template: preserves all other regs).
bl_rc_dec=(target_lf:BlWord):>void=>$unsafe {
    note_mt_active()
    let base=XWord(x_code[0].length)
    let p=x_bytes(42)
    let q=p as ptr<uint64>
    q[0]=0x3883482574C08548
    q[1]=0x0D8D4811741F7C01
    q[2]=0x7500398000000000
    q[3]=0x8D480CEB08FF4805
    q[4]=0x0000E8000000000D
    let tail=(p + 40) as ptr<uint16>
    tail[0]=0
    x_data_fix[0].push([base + 16  1  XWord(mt_active_off)])
    call_fix.push([base + 33  XWord(target_lf)])
    stub_fix.push([base + 38  12])
}

# Inline COW uniqueness check for array pointer in RAX (CALL_IF_SHARED template: preserves all other regs).
bl_arr_unique_rax=(at:BlWord):>void=>$unsafe {
    let base=XWord(x_code[0].length)
    let p=x_bytes(23)
    let q0=p as ptr<uint64>
    q0[0]=0x3883481274C08548
    q0[1]=0x00000D8D480C7401
    let q2=(p + 15) as ptr<uint64>
    q2[0]=0x00000000E8000000
    call_fix.push([base + 14  XWord(lf_helper(HK.arruniq at 0))])
    stub_fix.push([base + 19  12])
    bl_call_site()
}

bl_release_target=(t0:BlWord):>BlWord=>$unsafe {
    let t=quantity_base(t0)
    let k=types.ptr[t].kind
    if k =? 'array' and is_managed(BlWord(types.ptr[t].elem)) {return lf_helper(HK.arrrel t 0)}
    if k =? 'box' {return lf_helper(HK.boxrel t 0)}
    rt("__rc_dec")
}

bl_is_plain_release=(t0:BlWord):>bool=>$unsafe {
    let t=quantity_base(t0)
    let k=types.ptr[t].kind
    not ((k =? 'array' and is_managed(BlWord(types.ptr[t].elem))) or k =? 'box')
}

# Direct (stub-free) refcount decrement for pointer in RAX inside helpers (stack 16B aligned).
bl_rc_dec_direct=(target_lf:BlWord plain_free:bool):>void=>$unsafe {
    note_mt_active()
    bl_test_rr(RAX)
    let done0=jcc32(CC_E)
    mov_rm(RCX  RAX  0)
    bl_test_rr(RCX)
    let done1=jcc32(CC_LE)
    rel_fixup_lea(RDX  1  XWord(mt_active_off))
    load_sized(RDX  RDX  0  1  false)
    bl_test_rr(RDX)
    let is_st=jcc32(CC_E)
    mov_rr(RDI  RAX)
    bl_call(target_lf)
    let done2=jmp32()
    patch_here(is_st)
    bl_cmp_imm(RCX  1)
    let do_free=jcc32(CC_LE)
    bl_add_imm(RCX  -1)
    mov_mr(RAX  0  RCX)
    let done3=jmp32()
    patch_here(do_free)
    mov_rr(RDI  RAX)
    bl_call(if plain_free {rt("__free")} else {target_lf})
    patch_here(done0)
    patch_here(done1)
    patch_here(done2)
    patch_here(done3)
}

bl_retain_val=(t0:BlWord):>void=>$unsafe {
    let t=quantity_base(prune(t0))
    if t =? T_MATH_INT {
        bl_test_r_imm(RAX  1)
        let skip=jcc32(CC_E)
        bl_add_imm(RAX  -1)
        bl_rc_inc()
        patch_here(skip)
        return
    }
    bl_rc_inc()
}

bl_release_val=(t0:BlWord):>void=>$unsafe {
    let t=quantity_base(prune(t0))
    if t =? T_MATH_INT {
        bl_test_r_imm(RAX  1)
        let skip=jcc32(CC_E)
        bl_add_imm(RAX  -1)
        bl_rc_dec(bl_release_target(math_payload_type()))
        patch_here(skip)
        return
    }
    bl_rc_dec(bl_release_target(t))
}

bl_plain_managed_field=(ft0:BlWord copy:bool):>bool=>$unsafe {
    if ownership_type(ft0) {return false}
    let ft=quantity_base(ft0)
    if not is_managed(ft) {return true}
    if ownership_type(ft) or math_optional(ft) {return false}
    let k=types.ptr[ft].kind
    if k =? 'generator' or k =? 'fn_' or k =? 'polyfn' or k =? 'callable' {return false}
    if copy and type_has_fn(ft) {return false}
    true
}

bl_emit_field_op=(base:XWord off:XWord ft0:BlWord copy:bool):>void=>$unsafe {
    let ft=quantity_base(ft0)
    if vc(ft) =? VC_INT {
        mov_rm(RAX  base  off)
        if ft =? T_MATH_INT {
            bl_test_r_imm(RAX  1)
            let skip=jcc32(CC_E)
            bl_add_imm(RAX  -1)
            if copy {bl_rc_inc()}
            else {
                let pt=math_payload_type()
                bl_rc_dec_direct(bl_release_target(pt)  bl_is_plain_release(pt))
            }
            patch_here(skip)
            return
        }
        if copy {bl_rc_inc()}
        else {bl_rc_dec_direct(bl_release_target(ft)  bl_is_plain_release(ft))}
        return
    }
    if off =? 0 {mov_rr(RDI  base)}
    else {lea(RDI  base  off)}
    bl_call(lf_helper(if copy {HK.copy} else {HK.drop} ft 0))
}

bl_push=(r:XWord):>void=>$unsafe {
    if r >=? 8 {b(0x41)}
    b(0x50 + (r & 7))
}

bl_pop=(r:XWord):>void=>$unsafe {
    if r >=? 8 {b(0x41)}
    b(0x58 + (r & 7))
}

bl_test_rr=(r:XWord):>void=>$unsafe {
    op_rr(0x85  true  r  r)
}

bl_alu_imm=(ext:XWord r:XWord imm:XWord):>void=>$unsafe {
    if imm >=? -128 and imm <=? 127 {
        rex(true  0  0  r  false)
        b(0x83)
        modrr(ext  r)
        b(imm & 0xFF)
    } else {
        rex(true  0  0  r  false)
        b(0x81)
        modrr(ext  r)
        b32(imm)
    }
}

bl_add_imm=(r:XWord imm:XWord):>void=>$unsafe {
    if imm =? 0 {return}
    bl_alu_imm(0  r  imm)
}

bl_cmp_imm=(r:XWord imm:XWord):>void=>$unsafe {
    bl_alu_imm(7  r  imm)
}

bl_add_m64_imm=(base:XWord disp:XWord imm:XWord):>void=>$unsafe {
    if imm =? 0 {return}
    if imm >=? -128 and imm <=? 127 {
        rex(true  0  0  base  false)
        b(0x83)
        mem(0  base  disp)
        b(imm & 0xFF)
    } else {
        rex(true  0  0  base  false)
        b(0x81)
        mem(0  base  disp)
        b32(imm)
    }
}

bl_cmp_m64_imm=(base:XWord disp:XWord imm:XWord):>void=>$unsafe {
    if imm >=? -128 and imm <=? 127 {
        rex(true  0  0  base  false)
        b(0x83)
        mem(7  base  disp)
        b(imm & 0xFF)
    } else {
        rex(true  0  0  base  false)
        b(0x81)
        mem(7  base  disp)
        b32(imm)
    }
}

bl_test_r_imm=(r:XWord imm:XWord):>void=>$unsafe {
    rex(true  0  0  r  false)
    b(0xF7)
    modrr(0  r)
    b32(imm)
}

bl_sh_imm=(ext:XWord r:XWord sh:XWord):>void=>$unsafe {
    if sh =? 0 {return}
    rex(true  0  0  r  false)
    b(0xC1)
    modrr(ext  r)
    b(sh & 63)
}

bl_ctz_pow2=(v0:BlWord):>XWord=>$unsafe {
    let v=v0
    let sh:XWord=0
    loop v >? 1 {
        v=v >> 1
        sh += 1
    }
    sh
}

bl_imul_imm=(r:XWord imm:XWord):>void=>$unsafe {
    if imm =? 1 {return}
    if imm =? 2 or imm =? 4 or imm =? 8 or imm =? 16 or imm =? 32 or imm =? 64 or imm =? 128 or imm =? 256 {
        let sh:XWord=if imm =? 2 {1} else if imm =? 4 {2} else if imm =? 8 {3} else if imm =? 16 {4} else if imm =? 32 {5} else if imm =? 64 {6} else if imm =? 128 {7} else {8}
        rex(true  0  0  r  false)
        b(0xC1)
        modrr(4  r)
        b(sh)
        return
    }
    if imm >=? -128 and imm <=? 127 {
        rex(true  r  0  r  false)
        b(0x6B)
        modrr(r  r)
        b(imm & 0xFF)
    } else {
        rex(true  r  0  r  false)
        b(0x69)
        modrr(r  r)
        b32(imm)
    }
}

bl_cmp_m32_imm=(base:XWord imm:XWord):>void=>$unsafe {
    if imm >=? -128 and imm <=? 127 {
        if base >=? 8 {b(0x41)}
        b(0x83)
        if (base & 7) =? 5 {b(0x78 | (base & 7)); b(0)}
        else if (base & 7) =? 4 {b(0x3C); b(0x24)}
        else {b(0x38 | (base & 7))}
        b(imm & 0xFF)
    } else {
        if base >=? 8 {b(0x41)}
        b(0x81)
        if (base & 7) =? 5 {b(0x78 | (base & 7)); b(0)}
        else if (base & 7) =? 4 {b(0x3C); b(0x24)}
        else {b(0x38 | (base & 7))}
        b32(imm)
    }
}

bl_norm=(r:XWord t0:BlWord):>void=>$unsafe {
    let t=quantity_base(t0)
    let k=types.ptr[t].kind
    if k =? 'bool_' {
        rex(true  r  0  r  false)
        b(0x0F); b(0xB6)
        modrr(r  r)
        return
    }
    if k not=? 'int_' {return}
    let s=tsize(t)
    let sg=types.ptr[t].sign
    if s =? 4 {
        if sg {op_rr(0x63  true  r  r)}
        else {op_rr(0x8B  false  r  r)}
    } else if s =? 2 {
        rex(true  r  0  r  false)
        b(0x0F); b(if sg {0xBF} else {0xB7})
        modrr(r  r)
    } else if s =? 1 {
        rex(true  r  0  r  false)
        b(0x0F); b(if sg {0xBE} else {0xB6})
        modrr(r  r)
    }
}

# Zero sz bytes at [base + off]. Clobbers RAX, RCX, RDI when sz > 64; only R11 when sz <= 64.
bl_zero_mem=(base:XWord off:XWord sz:XWord):>void=>$unsafe {
    if sz <=? 0 {return}
    if sz <=? 64 {
        b(0x45); b(0x31); b(0xDB) # xor r11d, r11d
        let i:XWord=0
        loop i + 8 <=? sz {mov_mr(base  off + i  R11); i += 8}
        if i + 4 <=? sz {store_sized(base  off + i  R11  4); i += 4}
        if i + 2 <=? sz {store_sized(base  off + i  R11  2); i += 2}
        if i <? sz {store_sized(base  off + i  R11  1)}
        return
    }
    if off =? 0 {if base not=? RDI {mov_rr(RDI  base)}}
    else {lea(RDI  base  off)}
    b16(0xC031) # xor eax, eax
    mov_imm(RCX  sz)
    b16(0xAAF3) # rep stosb
}

# Copy sz bytes from [src] to [dst]. Clobbers R11 (or RDI/RSI/RCX when sz > 64).
bl_copy_mem=(dst:XWord src:XWord sz:XWord):>void=>$unsafe {
    if sz <=? 0 {return}
    if sz <=? 64 {
        let i:XWord=0
        loop i + 8 <=? sz {
            mov_rm(R11  src  i)
            mov_mr(dst  i  R11)
            i += 8
        }
        if i + 4 <=? sz {
            load_sized(R11  src  i  4  false)
            store_sized(dst  i  R11  4)
            i += 4
        }
        if i + 2 <=? sz {
            load_sized(R11  src  i  2  false)
            store_sized(dst  i  R11  2)
            i += 2
        }
        if i <? sz {
            load_sized(R11  src  i  1  false)
            store_sized(dst  i  R11  1)
        }
        return
    }
    if dst =? RSI and src =? RDI {
        mov_rr(R11  src)
        mov_rr(RDI  dst)
        mov_rr(RSI  R11)
    } else if dst =? RSI {
        mov_rr(RDI  dst)
        if src not=? RSI {mov_rr(RSI  src)}
    } else {
        if src not=? RSI {mov_rr(RSI  src)}
        if dst not=? RDI {mov_rr(RDI  dst)}
    }
    mov_imm(RCX  sz)
    b16(0xA4F3) # rep movsb
}

# ---- Helper emitters (HK.drop, HK.copy, HK.arrrel, HK.arruniq) ----

bl_emit_helper_drop_copy=(lf:BlWord t:BlWord copy:bool):>bool=>$unsafe {
    if ownership_type(t) or t =? T_MATH_INT or math_optional(t) {return false}
    if copy and type_has_fn(t) {return false}
    let k=types.ptr[t].kind
    if k =? 'array' or k =? 'box' {
        let fn_start=bl_fn_begin(lf 128)
        if copy {
            mov_rm(RAX  RDI  0)
            bl_rc_inc()
        } else {
            bl_push(RBX)
            mov_rm(RAX  RDI  0)
            bl_rc_dec_direct(bl_release_target(t)  bl_is_plain_release(t))
            bl_pop(RBX)
        }
        b(0xC3)
        bl_fn_end(lf fn_start)
        return true
    }
    if k =? 'fixed' {
        let et:BlWord=BlWord(types.ptr[t].elem)
        let n=fixed_len(t)
        if not is_managed(et) or n <=? 0 {
            let fn_start=bl_fn_begin(lf 32)
            b(0xC3)
            bl_fn_end(lf fn_start)
            return true
        }
        if not bl_plain_managed_field(et copy) {return false}
        let stride:XWord=XWord(tsize(et))
        let fn_start=bl_fn_begin(lf 192)
        bl_push(RBX)
        bl_push(R12)
        bl_push(R13)
        mov_rr(R12  RDI)
        lea(R13  R12  XWord(n * stride))
        let ltop=XWord(x_code[0].length)
        bl_emit_field_op(R12  0  et  copy)
        bl_add_imm(R12  stride)
        op_rr(0x39  true  R13  R12)
        let back=jcc32(CC_B)
        patch_branch(back  ltop)
        bl_pop(R13)
        bl_pop(R12)
        bl_pop(RBX)
        b(0xC3)
        bl_fn_end(lf fn_start)
        return true
    }
    if k =? 'struct_' or k =? 'tuple' {
        let fs=field_list(t)
        let n=fs.length
        let need_call=false
        let nman:BlWord=0
        loop i in [0..n) {
            let ft=fs.ptr[i][0]
            if not is_managed(ft) {continue}
            if not bl_plain_managed_field(ft copy) {return false}
            nman += 1
            if not copy or vc(quantity_base(ft)) not=? VC_INT {need_call=true}
        }
        let fn_start=bl_fn_begin(lf 64 + nman * 80)
        let base:XWord=RDI
        if need_call {
            bl_push(RBX)
            mov_rr(RBX  RDI)
            base=RBX
        }
        loop i in [0..n) {
            let fo=fs.ptr[if copy {i} else {n - 1 - i}]
            if not is_managed(fo[0]) {continue}
            bl_emit_field_op(base  XWord(fo[1])  fo[0]  copy)
        }
        if need_call {bl_pop(RBX)}
        b(0xC3)
        bl_fn_end(lf fn_start)
        return true
    }
    if k =? 'opt' {
        let inner:BlWord=BlWord(types.ptr[t].elem)
        if not is_managed(inner) {
            let fn_start=bl_fn_begin(lf 32)
            b(0xC3)
            bl_fn_end(lf fn_start)
            return true
        }
        if not bl_plain_managed_field(inner copy) {return false}
        let qin=quantity_base(inner)
        if qin =? T_MATH_INT or types.ptr[qin].kind =? 'ptr' {return false}
        let need_call=not copy or vc(qin) not=? VC_INT
        let fn_start=bl_fn_begin(lf 160)
        let base:XWord=RDI
        if need_call {
            bl_push(RBX)
            mov_rr(RBX  RDI)
            base=RBX
        }
        load_sized(RAX  base  XWord(tsize(inner))  1  false)
        bl_test_rr(RAX)
        let skip=jcc32(CC_E)
        bl_emit_field_op(base  0  inner  copy)
        patch_here(skip)
        if need_call {bl_pop(RBX)}
        b(0xC3)
        bl_fn_end(lf fn_start)
        return true
    }
    if k =? 'enum_' {
        layout(t)
        let si:BlWord=BlWord(types.ptr[t].st)
        let nv:BlWord=BlWord(structs.ptr[si].nvariants)
        let need_call=false
        let nman:BlWord=0
        loop v in [0..nv) {
            let vi:BlWord=BlWord(structs.ptr[si].variants) + v
            let nf:BlWord=BlWord(variants.ptr[vi].nfields)
            loop i in [0..nf) {
                let ft=field_store_type(BlWord(variants.ptr[vi].fields) + i)
                if not is_managed(ft) {continue}
                if quantity_base(ft) =? T_MATH_INT or not bl_plain_managed_field(ft copy) {return false}
                nman += 1
                if not copy or vc(quantity_base(ft)) not=? VC_INT {need_call=true}
            }
        }
        let fn_start=bl_fn_begin(lf 96 + nman * 80 + nv * 16)
        let base:XWord=RDI
        if need_call {
            bl_push(RBX)
            mov_rr(RBX  RDI)
            base=RBX
        }
        let exits:array<int64>=[]
        loop v in [0..nv) {
            let vi:BlWord=BlWord(structs.ptr[si].variants) + v
            let nf:BlWord=BlWord(variants.ptr[vi].nfields)
            let any=false
            loop i in [0..nf) {
                if is_managed(field_store_type(BlWord(variants.ptr[vi].fields) + i)) {any=true; break}
            }
            if not any {continue}
            bl_cmp_m32_imm(base  XWord(v))
            let nxt=jcc32(CC_NE)
            loop i in [0..nf) {
                let f:BlWord=BlWord(variants.ptr[vi].fields) + i
                let ft=field_store_type(f)
                if not is_managed(ft) {continue}
                bl_emit_field_op(base  XWord(fields.ptr[f].offset)  ft  copy)
            }
            exits.push(jmp32())
            patch_here(nxt)
        }
        loop ex in exits {patch_here(XWord(ex))}
        if need_call {bl_pop(RBX)}
        b(0xC3)
        bl_fn_end(lf fn_start)
        return true
    }
    false
}

bl_emit_helper_arrrel=(lf:BlWord t:BlWord):>bool=>$unsafe {
    let et:BlWord=BlWord(types.ptr[t].elem)
    if ownership_type(et) or not bl_plain_managed_field(et false) {return false}
    let stride:XWord=XWord(owner_stride(et))
    let fn_start=bl_fn_begin(lf 256)
    bl_push(RBX)
    bl_push(R12)
    bl_push(R13)
    mov_rr(RBX  RDI)
    bl_call(rt("__rc_dec_test"))
    bl_test_rr(RAX)
    let done=jcc32(CC_E)
    mov_rm(R13  RBX  8)
    bl_test_rr(R13)
    let free_it=jcc32(CC_LE)
    lea(R12  RBX  24)
    bl_imul_imm(R13  stride)
    op_rr(0x01  true  R12  R13)
    let ltop=XWord(x_code[0].length)
    bl_emit_field_op(R12  0  et  false)
    bl_add_imm(R12  stride)
    op_rr(0x39  true  R13  R12)
    let back=jcc32(CC_B)
    patch_branch(back  ltop)
    patch_here(free_it)
    mov_rr(RDI  RBX)
    bl_call(rt("__free_obj"))
    patch_here(done)
    bl_pop(R13)
    bl_pop(R12)
    bl_pop(RBX)
    b(0xC3)
    bl_fn_end(lf fn_start)
    true
}

bl_emit_helper_arruniq=(lf:BlWord t:BlWord):>bool=>$unsafe {
    let et:BlWord=BlWord(types.ptr[t].elem)
    let man=is_managed(et) and ownership_copyable(et)
    if man and (ownership_type(et) or not bl_plain_managed_field(et true)) {return false}
    let stride:XWord=XWord(owner_stride(et))
    let fn_start=bl_fn_begin(lf 256)
    mov_rr(RAX  RDI)
    bl_test_rr(RDI)
    let done0=jcc32(CC_E)
    b(0x48); b(0x83); b(0x3F); b(1)
    let done1=jcc32(CC_E)
    if not man {
        bl_push(RBX)
        mov_imm(RSI  stride)
        bl_call(rt("__arr_clone"))
        bl_pop(RBX)
    } else {
        bl_push(RBX)
        bl_push(R12)
        bl_push(R13)
        mov_imm(RSI  stride)
        bl_call(rt("__arr_clone"))
        mov_rr(RBX  RAX)
        mov_rm(R13  RBX  8)
        bl_test_rr(R13)
        let ret_rbx=jcc32(CC_LE)
        lea(R12  RBX  24)
        bl_imul_imm(R13  stride)
        op_rr(0x01  true  R12  R13)
        let ltop=XWord(x_code[0].length)
        bl_emit_field_op(R12  0  et  true)
        bl_add_imm(R12  stride)
        op_rr(0x39  true  R13  R12)
        let back=jcc32(CC_B)
        patch_branch(back  ltop)
        patch_here(ret_rbx)
        mov_rr(RAX  RBX)
        bl_pop(R13)
        bl_pop(R12)
        bl_pop(RBX)
    }
    patch_here(done0)
    patch_here(done1)
    b(0xC3)
    bl_fn_end(lf fn_start)
    true
}

# ---- Direct AST -> x86-64 baseline emitter for LK_INST functions ----

let bl_cur_lf:BlWord=0
let bl_cur_fi:BlWord=0
let bl_cur_ret:BlWord=0
let bl_sret_off:XWord=0
let bl_sp:XWord=0
let bl_frame_max:XWord=0
let bl_loc_base:BlWord=0
let bl_loc_span:BlWord=0
let bl_loc_map:array<int32>=[]
let bl_loc_off:array<int64>=[]
let bl_loc_kind:array<int8>=[]
let bl_loc_src:array<int32>=[]
let bl_loc_len_of:array<int32>=[]
let bl_loc_inited:array<bool>=[]
let bl_loc_small_math:array<bool>=[]
let bl_for_reg_active:bool=false
let bl_for_inbounds_arr:BlWord=-1
let bl_for_hoist_arr:BlWord=-1
let bl_scan_has_loop:bool=false
let bl_scope_off:array<int64>=[]
let bl_scope_ty:array<int64>=[]
let bl_scope_agg:array<bool>=[]
let bl_temps_off:array<int64>=[]
let bl_temps_ty:array<int64>=[]
let bl_temps_agg:array<bool>=[]
let bl_frozen_node:array<int64>=[]
let bl_frozen_off:array<int64>=[]
let bl_snap_idx:array<int64>=[]
let bl_ret_patches:array<int64>=[]
let bl_cond_fails:array<int64>=[]
let bl_defer_nodes:array<int64>=[]
let bl_blk_smark:array<int64>=[]
let bl_blk_dmark:array<int64>=[]
let bl_loop_blk:array<int64>=[]
let bl_loop_tmark:array<int64>=[]
let bl_loop_smark:array<int64>=[]
let bl_loop_dmark:array<int64>=[]
let bl_loop_brk_pos:array<int64>=[]
let bl_loop_brk_depth:array<int64>=[]
let bl_loop_cont_pos:array<int64>=[]
let bl_loop_cont_depth:array<int64>=[]
let bl_last_owned:bool=false
let bl_last_slot:XWord=-1
let bl_scan_nodes:BlWord=0
let bl_scan_calls:BlWord=0
let bl_scan_fn_calls:BlWord=0
let bl_scan_loops:BlWord=0
let bl_scan_max_loop_depth:BlWord=0
let bl_scan_has_while:bool=false
let bl_scan_mut_math:bool=false
let bl_scan_has_float:bool=false
let bl_scan_managed:bool=false
let bl_scan_syscall:bool=false
let bl_scan_sret:bool=false
let bl_scan_exact_in_loop:bool=false
let bl_scan_exact_wide_in_loop:bool=false
let bl_scan_dyn_loop:bool=false
let bl_scan_has_scan_loop:bool=false
let bl_fn_exact:bool=false
let bl_fn_copy_strict:bool=false
let bl_fn_copies_maybe:bool=false
let bl_scan_rare:bool=false
let bl_copies_prepared:bool=false
let bl_copies_fi:BlWord=-1
let bl_ty_info:array<int64>=[]
let bl_tok_epoch:BlWord=-1
let bl_tok_saw_cycle:bool=false
let bl_hot_ids:array<uint8>=[]
let bl_hot_ready:bool=false
let bl_arg_offs:array<int64>=[0 0 0 0 0 0 0 0]

bl_init_hot_ids=():>void=>$unsafe {
    let hnames=["__alloc_z" "__alloc_raw" "__alloc_slow" "__alloc_size" "__grow_alloc" "__free" "__free_obj" "__rc_dec" "__rc_inc" "__arr_new_raw" "__arr_grow" "__arr_grow_more" "__arr_push_slot" "__arr_bytes" "__buf_append_raw" "__buf_byte" "__str_cmp" "__case_text" "get" "[]=" "[]" "has" "contains" "__map_entry" "__map_entry_present" "__map_find" "__map_probe" "__map_add" "__map_rehash" "__map_slot_equal" "__map_hash" "__hk_word" "__hk_mix" "__hk_mum" "__hk_bytes" "__arena_alloc" "find_byte" "__bcast_offset" "__mi_parse" "__mi_sum" "to_int" "sum"]
    loop nm in hnames {
        let id=intern(nm)
        if id >=? bl_hot_ids.length {bl_hot_ids.resize(id + 64)}
        bl_hot_ids.ptr[id]=uint8(1)
    }
    bl_hot_ready=true
}

bl_is_hot_lib_fn=(decl:BlWord):>bool=>$unsafe {
    if decl =? 0 {return false}
    if not bl_hot_ready {bl_init_hot_ids()}
    let id:BlWord=BlWord(nodes.ptr[decl].name)
    id >=? 0 and id <? bl_hot_ids.length and bl_hot_ids.ptr[id] not=? uint8(0) and pos_in_lib(nodes.ptr[decl].pos)
}

bl_tmp_alloc=(sz:XWord al:XWord=8):>XWord=>$unsafe {
    let a=if al >? 8 {al} else {8}
    let s=if sz >? 8 {sz} else {8}
    let next=align_up(bl_sp + s  a)
    bl_sp=next
    if bl_sp >? bl_frame_max {bl_frame_max=bl_sp}
    next
}

bl_loc_idx=(l:BlWord):>BlWord=>$unsafe {
    let d=l - bl_loc_base
    if d <? 0 or d >=? bl_loc_span {return -1}
    BlWord(bl_loc_map.ptr[d]) - 1
}

bl_is_small_math_neg_safe=(e:BlWord):>bool=>$unsafe {
    if e <=? 0 {return false}
    let k=nodes.ptr[e].kind
    if k =? 'int_lit' {
        return not has_flag(e NF_U64) and nodes.ptr[e].ival >? -4611686018427387904 and nodes.ptr[e].ival <=? 4611686018427387903
    }
    if e <? exact_ranges.length and exact_ranges.ptr[e] >? 0 and exact_ranges.ptr[e] <=? 62 {return true}
    if bl_fn_exact and exact_has_node(e) and exact_bits(e) <=? 62 {return true}
    let te=prune(ntype(e))
    if types.ptr[te].kind =? 'refined' {
        let rb=exact_count_refined(te)
        if not rb.wide and rb.lo >? -4611686018427387904 and rb.hi <=? 4611686018427387903 {return true}
    }
    if k =? 'conv' and (nodes.ptr[e].aux =? int32(int64(CV.int_)) or nodes.ptr[e].aux =? int32(int64(CV.none_)) or nodes.ptr[e].aux =? int32(int64(CV.refinement))) {
        let a=BlWord(nodes.ptr[e].a)
        let qfr=quantity_base(prune(ntype(a)))
        if is_int(qfr) and qfr not=? T_MATH_INT and types.ptr[qfr].bits <? 62 and not exact_has_node(a) {return true}
        if bl_is_small_math_neg_safe(a) {return true}
    }
    if exact_small_math(e) >=? 0 {return true}
    let cb=exact_count_bound(e)
    if not cb.wide and cb.lo >? -4611686018427387904 and cb.hi <=? 4611686018427387903 {return true}
    let pb=positive_bound(e  true)
    if pb >=? 0 and pb <=? 4611686018427387903 {return true}
    false
}

bl_is_small_math=(e:BlWord):>bool=>$unsafe {
    if e <=? 0 {return false}
    let k=nodes.ptr[e].kind
    if k =? 'int_lit' {
        return not has_flag(e NF_U64) and nodes.ptr[e].ival >=? -4611686018427387904 and nodes.ptr[e].ival <=? 4611686018427387903
    }
    if k =? 'ident' and nodes.ptr[e].aux =? 1 {
        let idx=bl_loc_idx(BlWord(nodes.ptr[e].sym))
        if idx >=? 0 and bl_loc_small_math.ptr[idx] {return true}
    }
    if e <? exact_ranges.length and exact_ranges.ptr[e] >? 0 and exact_ranges.ptr[e] <=? 63 {return true}
    if bl_fn_exact and exact_has_node(e) and exact_bits(e) <=? 63 {return true}
    let te=prune(ntype(e))
    if types.ptr[te].kind =? 'refined' {
        let rb=exact_count_refined(te)
        if not rb.wide and rb.lo >=? -4611686018427387904 and rb.hi <=? 4611686018427387903 {return true}
    }
    if k =? 'conv' and (nodes.ptr[e].aux =? int32(int64(CV.int_)) or nodes.ptr[e].aux =? int32(int64(CV.none_)) or nodes.ptr[e].aux =? int32(int64(CV.refinement))) {
        let a=BlWord(nodes.ptr[e].a)
        let qfr=quantity_base(prune(ntype(a)))
        if is_int(qfr) and qfr not=? T_MATH_INT and types.ptr[qfr].bits <? 63 and not exact_has_node(a) {return true}
        if bl_is_small_math(a) {return true}
    }
    if k =? 'unary' {
        let op=nodes.ptr[e].op
        if op =? 58 or op =? 78 {if bl_is_small_math(BlWord(nodes.ptr[e].a)) {return true}}
        if op =? 59 {if bl_is_small_math_neg_safe(BlWord(nodes.ptr[e].a)) {return true}}
    }
    if k =? 'binary' and nodes.ptr[e].aux =? 0 {
        let op=cx_token_values.ptr[BlWord(nodes.ptr[e].op)]
        if op =? 'amp' or op =? 'pipe' or op =? 'caret' {
            if bl_is_small_math(BlWord(nodes.ptr[e].a)) and bl_is_small_math(BlWord(nodes.ptr[e].b)) {return true}
        }
        if op =? 'shr' and nodes.ptr[BlWord(nodes.ptr[e].b)].kind =? 'int_lit' and not has_flag(BlWord(nodes.ptr[e].b) NF_U64) and nodes.ptr[BlWord(nodes.ptr[e].b)].ival >=? 0 {
            if bl_is_small_math(BlWord(nodes.ptr[e].a)) {return true}
        }
    }
    if exact_small_math(e) >=? 0 {return true}
    let cb=exact_count_bound(e)
    if not cb.wide and cb.lo >=? -4611686018427387904 and cb.hi <=? 4611686018427387903 {return true}
    let pb=positive_bound(e  true)
    if pb >=? 0 and pb <=? 4611686018427387903 {return true}
    false
}

# Packed per-TypeInfo metadata (valid while bl_tok_epoch == lower_epoch):
# bits 0..1: 0=unseen, 1=ok, 2=bad, 3=in_progress
# bits 2..3: vc (0=VOID, 1=INT, 2=FLT, 3=AGG)
# bit 4 (16): is_managed(q)
# bit 5 (32): copies_on and costly_copy(t)
# bit 6 (64): q == T_MATH_INT
# bit 7 (128): q.kind == 'int_' and q.sign
# bits 8..31: q (quantity_base)
# bits 32..47: tsize (65535 if > 65534)
# bits 48..55: talign (0 if > 127)
bl_tinfo_slow=(t0:BlWord):>BlWord=>$unsafe {
    if t0 <=? 0 {return 2}
    if bl_tok_epoch not=? lower_epoch {
        bl_ty_info.clear()
        bl_tok_epoch=lower_epoch
        bl_tok_saw_cycle=false
    }
    let t=if types.ptr[t0].kind =? 'var' {prune(t0)} else {t0}
    if t not=? t0 and t <? bl_ty_info.length {
        let c=bl_ty_info.ptr[t]
        if c not=? 0 {
            if (c & 3) =? 3 {bl_tok_saw_cycle=true}
            return c
        }
    }
    if t >=? bl_ty_info.length {bl_ty_info.resize(max(t + 64  types.length + 64))}
    let ok=false
    let q:BlWord=0
    let saved_cycle=bl_tok_saw_cycle
    let pushed_prog=false
    if not ownership_type(t) and not type_has_fn(t) {
        q=quantity_base(t)
        if not ownership_type(q) and not math_optional(q) {
            let k=types.ptr[q].kind
            if k =? 'void_' or k =? 'bool_' or k =? 'ptr' or k =? 'str_' or k =? 'cfn' or k =? 'float_' {ok=true}
            else if k =? 'int_' {ok=int_policy(q) not=? 2}
            else if k =? 'array' {
                let et=prune(BlWord(types.ptr[q].elem))
                ok=not ownership_type(et) and not type_has_fn(et) and not math_optional(et)
            }
            else if k =? 'enum_' {
                layout(q)
                let si:BlWord=BlWord(types.ptr[q].st)
                if structs.ptr[si].simple_enum or (BlWord(types.ptr[q].flags) & TF_BOXED) =? 0 {
                    ok=true
                } else {
                    bl_ty_info.ptr[t]=3
                    pushed_prog=true
                    ok=true
                    let nv:BlWord=BlWord(structs.ptr[si].nvariants)
                    loop v in [0..nv) {
                        let vi:BlWord=BlWord(structs.ptr[si].variants) + v
                        let nf:BlWord=BlWord(variants.ptr[vi].nfields)
                        loop i in [0..nf) {
                            let f:BlWord=BlWord(variants.ptr[vi].fields) + i
                            if fields.ptr[f].boxed {
                                let ft=prune(BlWord(fields.ptr[f].type))
                                if ownership_type(ft) or type_has_fn(ft) or math_optional(ft) or not bl_type_ok(ft) {ok=false; break}
                            }
                        }
                        if not ok {break}
                    }
                }
            }
            else if k =? 'struct_' {
                layout(q)
                if (BlWord(types.ptr[q].flags) & TF_BOXED) =? 0 {
                    ok=true
                } else {
                    bl_ty_info.ptr[t]=3
                    pushed_prog=true
                    ok=true
                    let si:BlWord=BlWord(types.ptr[q].st)
                    let nf:BlWord=BlWord(structs.ptr[si].nfields)
                    loop i in [0..nf) {
                        let f:BlWord=BlWord(structs.ptr[si].fields) + i
                        if fields.ptr[f].boxed {
                            let ft=prune(BlWord(fields.ptr[f].type))
                            if ownership_type(ft) or type_has_fn(ft) or math_optional(ft) or not bl_type_ok(ft) {ok=false; break}
                        }
                    }
                }
            }
            else if k =? 'tuple' {
                layout(q)
                ok=(BlWord(types.ptr[q].flags) & TF_BOXED) =? 0
            }
            else if k =? 'fixed' {
                ok=bl_type_ok(BlWord(types.ptr[q].elem))
            }
            else if k =? 'opt' {
                let inner=prune(BlWord(types.ptr[q].elem))
                ok=bl_type_ok(inner)
            }
        }
    }
    let val:BlWord=2
    if ok {
        let c=vc(q)
        let vc_bits:BlWord=if c =? VC_INT {4} else if c =? VC_FLT {8} else if c =? VC_AGG {12} else {0}
        let man_bit:BlWord=if is_managed(q) {16} else {0}
        let cost_bit:BlWord=if copies_on and costly_copy(t) {32} else {0}
        let math_bit:BlWord=if q =? T_MATH_INT {64} else {0}
        let sg_bit:BlWord=if types.ptr[q].kind =? 'int_' and types.ptr[q].sign {128} else {0}
        let sz:BlWord=if c =? VC_VOID {0} else {BlWord(tsize(q))}
        let al:BlWord=if c =? VC_VOID {1} else {BlWord(talign(q))}
        let sz_enc:BlWord=if sz >=? 0 and sz <=? 65534 {sz} else {65535}
        let al_enc:BlWord=if al >? 0 and al <=? 127 {al} else {0}
        val=1 | vc_bits | man_bit | cost_bit | math_bit | sg_bit | ((q & 0xFFFFFF) << 8) | (sz_enc << 32) | (al_enc << 48)
    }
    if pushed_prog and not ok and bl_tok_saw_cycle {
        bl_ty_info.clear()
        bl_tok_epoch=-1
        bl_tok_saw_cycle=false
        return 2
    }
    if pushed_prog {bl_tok_saw_cycle=saved_cycle}
    let need_t=max(max(t t0) + 64  types.length + 64)
    if need_t >? bl_ty_info.length {bl_ty_info.resize(need_t)}
    bl_ty_info.ptr[t]=val
    if t0 not=? t {bl_ty_info.ptr[t0]=val}
    val
}

bl_tinfo=(t0:BlWord):>BlWord=>$unsafe {
    if t0 <=? 0 {return 2}
    if bl_tok_epoch =? lower_epoch and t0 <? bl_ty_info.length {
        let c=bl_ty_info.ptr[t0]
        if c not=? 0 {
            if (c & 3) =? 3 {bl_tok_saw_cycle=true}
            return c
        }
    }
    bl_tinfo_slow(t0)
}

bl_type_ok=(t0:BlWord):>bool=>$unsafe {
    (bl_tinfo(t0) & 1) not=? 0
}

bl_ti_size=(info:BlWord):>XWord=>$unsafe {
    let s=(info >> 32) & 0xFFFF
    if s <? 65535 {return XWord(s)}
    XWord(tsize((info >> 8) & 0xFFFFFF))
}

bl_ti_align=(info:BlWord):>XWord=>$unsafe {
    let a=(info >> 48) & 0xFF
    if a >? 0 {return XWord(a)}
    XWord(talign((info >> 8) & 0xFFFFFF))
}

bl_is_pure_leaf=(e:BlWord):>bool=>$unsafe {
    let k=nodes.ptr[e].kind
    if k =? 'int_lit' {
        if nodes.ptr[e].aux not=? 0 {return false}
        if quantity_base(prune(ntype(e))) =? T_MATH_INT {
            return not has_flag(e NF_U64) and nodes.ptr[e].ival >=? -4611686018427387904 and nodes.ptr[e].ival <=? 4611686018427387903
        }
        return true
    }
    if k =? 'bool_lit' or k =? 'null_lit' or k =? 'str_lit' {return nodes.ptr[e].aux =? 0}
    if k =? 'dotname' {
        let t=prune(ntype(e))
        return types.ptr[t].kind =? 'enum_' and structs.ptr[BlWord(types.ptr[t].st)].simple_enum
    }
    false
}

bl_is_pure_read=(e:BlWord depth:BlWord=0):>bool=>$unsafe {
    if e <=? 0 or depth >? 8 {return false}
    let k=nodes.ptr[e].kind
    if k =? 'ident' or k =? 'int_lit' or k =? 'bool_lit' or k =? 'null_lit' or k =? 'float_lit' or k =? 'dotname' or k =? 'none_lit' {return true}
    if k =? 'str_lit' {return nodes.ptr[e].aux =? 0}
    if k =? 'field' or k =? 'unwrap' or k =? 'narrow' {return bl_is_pure_read(BlWord(nodes.ptr[e].a)  depth + 1)}
    if k =? 'index' {return nodes.ptr[e].aux =? 0 and bl_is_pure_read(BlWord(nodes.ptr[e].a)  depth + 1) and bl_is_pure_read(BlWord(nodes.ptr[e].b)  depth + 1)}
    if k =? 'unary' or k =? 'not_' {return bl_is_pure_read(BlWord(nodes.ptr[e].a)  depth + 1)}
    if k =? 'binary' {return nodes.ptr[e].aux =? 0 and bl_is_pure_read(BlWord(nodes.ptr[e].a)  depth + 1) and bl_is_pure_read(BlWord(nodes.ptr[e].b)  depth + 1)}
    if k =? 'conv' {
        let cv=nodes.ptr[e].aux as CV
        return (cv =? CV.none_ or cv =? CV.int_ or cv =? CV.wrap_int or cv =? CV.bits or cv =? CV.refinement or cv =? CV.quantity_const or cv =? CV.fixed_store) and bl_is_pure_read(BlWord(nodes.ptr[e].a)  depth + 1)
    }
    false
}

bl_can_mut_place=(e:BlWord):>bool=>$unsafe {
    let k=nodes.ptr[e].kind
    if k =? 'ident' {
        let aux=nodes.ptr[e].aux
        if aux =? 2 {return true}
        if aux not=? 1 {return false}
        let l:BlWord=BlWord(nodes.ptr[e].sym)
        if (BlWord(locals.ptr[l].flags) & LF_ALIAS) not=? 0 {
            let al:BlWord=BlWord(locals.ptr[l].alias)
            return al >? 0 and bl_can_mut_place(al)
        }
        return true
    }
    if k =? 'field' {
        let aux=nodes.ptr[e].aux
        if aux <? 0 and aux not=? -3 {return false}
        if boxed_field_of(e) >=? 0 {return false}
        let a:BlWord=BlWord(nodes.ptr[e].a)
        let bt=prune(ntype(a))
        if types.ptr[bt].kind =? 'ptr' {return aux >=? 0}
        return bl_can_mut_place(a)
    }
    if k =? 'index' {
        if nodes.ptr[e].aux not=? 0 {return false}
        let a:BlWord=BlWord(nodes.ptr[e].a)
        let bk=types.ptr[prune(ntype(a))].kind
        return bk =? 'ptr' or ((bk =? 'fixed' or bk =? 'array') and bl_can_mut_place(a))
    }
    if k =? 'unwrap' or k =? 'narrow' {
        return bl_can_mut_place(BlWord(nodes.ptr[e].a))
    }
    false
}

bl_is_plain_movable_place=(e:BlWord):>bool=>$unsafe {
    let n=e
    loop nodes.ptr[n].kind =? 'field' {
        let aux=nodes.ptr[n].aux
        if aux <? 0 and aux not=? -3 {return false}
        if boxed_field_of(n) >=? 0 {return false}
        let a:BlWord=BlWord(nodes.ptr[n].a)
        if types.ptr[prune(ntype(a))].kind =? 'ptr' {return false}
        n=a
    }
    if nodes.ptr[n].kind not=? 'ident' or nodes.ptr[n].aux not=? 1 {return false}
    let l:BlWord=BlWord(nodes.ptr[n].sym)
    (BlWord(locals.ptr[l].flags) & (LF_ALIAS | LF_BYREF | LF_CAPTURE | LF_CAPTURED | LF_SHARED | LF_OWNERBORROW | LF_PARTBORROW)) =? 0
}

bl_expr_always_owned=(e:BlWord):>bool=>$unsafe {
    if e <=? 0 {return false}
    let k=nodes.ptr[e].kind
    if k =? 'array' or k =? 'tuple' or k =? 'map_lit' or k =? 'none_lit' or k =? 'dotname' or k =? 'if_' or k =? 'iflet' or k =? 'match_' or k =? 'block' or k =? 'coalesce' or k =? 'call' {return true}
    if k =? 'index' {return nodes.ptr[e].aux =? 1}
    if k =? 'intrinsic' {
        let id=nodes.ptr[e].aux as IN
        return id =? IN.zeroed or id =? IN.pop or id =? IN.remove
    }
    if k =? 'conv' {
        let cv=nodes.ptr[e].aux as CV
        if cv =? CV.explicit_copy or cv =? CV.opt or cv =? CV.union_ or cv =? CV.arr2fixed or cv =? CV.fixed2arr {return true}
        if cv =? CV.none_ or cv =? CV.quantity_const or cv =? CV.ptr or cv =? CV.refinement {return bl_expr_always_owned(BlWord(nodes.ptr[e].a))}
        return false
    }
    if k =? 'unary' and nodes.ptr[e].op =? 58 {return bl_expr_always_owned(BlWord(nodes.ptr[e].a))}
    false
}

bl_ensure_copies=():>void=>$unsafe {
    if bl_copies_prepared {return}
    bl_copies_prepared=true
    let fi=bl_copies_fi
    let body:BlWord=BlWord(fns.ptr[fi].body)
    let pv_locals:array<int64>=[]
    let nb=nkids(body)
    loop bi in [0..nb) {
        let st=kid(body bi)
        if nodes.ptr[st].kind not=? 'vardecl' or nodes.ptr[st].aux2 not=? 1 {break}
        if bl_is_param_view_decl(st) {
            let pl:BlWord=BlWord(nodes.ptr[st].sym)
            if (BlWord(locals.ptr[pl].flags) & LF_PARAM) =? 0 {
                locals.ptr[pl].flags |= int32<overflow='wrap'>(LF_PARAM)
                pv_locals.push(pl)
            }
        }
    }
    copies_prepare(fi)
    loop pl in pv_locals {
        locals.ptr[pl].flags &= int32<overflow='wrap'>(~LF_PARAM)
    }
}

bl_copy_own_ok=(e:BlWord t0:BlWord):>bool=>$unsafe {
    if not bl_fn_copies_maybe or e <=? 0 {return true}
    let t=prune(t0)
    if not costly_copy(t) or not copy_strict(e) {return true}
    if bl_expr_always_owned(e) {return true}
    if copy_explicit.has(e) {return true}
    if not bl_copies_prepared {bl_ensure_copies()}
    let ek=nodes.ptr[e].kind
    if ek =? 'ident' and nodes.ptr[e].aux =? 1 and copy_noenv.has(BlWord(nodes.ptr[e].sym)) {return true}
    type_eq(ntype(e)  t) and copy_movable(e) and bl_is_plain_movable_place(e)
}

bl_is_param_view_decl=(s:BlWord):>bool=>$unsafe {
    if nodes.ptr[s].kind not=? 'vardecl' or nodes.ptr[s].aux2 not=? 1 or nodes.ptr[s].nlist >? 0 or has_flag(s NF_GLOBAL) {return false}
    let l:BlWord=BlWord(nodes.ptr[s].sym)
    if l <? 0 or (copies_on and copy_bindings.has(l)) {return false}
    let fl:BlWord=BlWord(locals.ptr[l].flags)
    if (fl & (LF_ASSIGNED | LF_ADDR | LF_EXPOSED)) not=? 0 {return false}
    let iv:BlWord=BlWord(nodes.ptr[s].b)
    if iv <=? 0 or nodes.ptr[iv].kind not=? 'ident' or nodes.ptr[iv].aux not=? 1 {return false}
    let src:BlWord=BlWord(nodes.ptr[iv].sym)
    let sfl:BlWord=BlWord(locals.ptr[src].flags)
    if (sfl & LF_PARAM) =? 0 or (sfl & (LF_MUTPARAM | LF_ADDR)) not=? 0 {return false}
    type_eq(prune(BlWord(locals.ptr[src].type))  prune(BlWord(locals.ptr[l].type)))
}

bl_scan_local=(n:BlWord):>BlWord=>$unsafe {
    if n <=? 0 or nodes.ptr[n].kind not=? 'ident' or nodes.ptr[n].aux not=? int32(1) {return -1}
    let l:BlWord=BlWord(nodes.ptr[n].sym)
    if (BlWord(locals.ptr[l].flags) & (LF_MUTPARAM | LF_CAPTURE | LF_ALIAS | LF_BYREF | LF_ADDR | LF_SHARED)) not=? 0 {return -1}
    l
}

bl_scan_inc=(s:BlWord l:BlWord):>bool=>$unsafe {
    if nodes.ptr[s].kind not=? 'assign' or bl_scan_local(BlWord(nodes.ptr[s].a)) not=? l {return false}
    let rhs:BlWord=BlWord(nodes.ptr[s].b)
    if nodes.ptr[s].op =? int32(48) {
        return nodes.ptr[rhs].kind =? 'int_lit' and nodes.ptr[rhs].ival =? 1
    }
    if nodes.ptr[s].op not=? int32(47) {return false}
    if nodes.ptr[rhs].kind =? 'conv' and nodes.ptr[rhs].aux =? int32(int64(CV.fixed_store)) {rhs=BlWord(nodes.ptr[rhs].a)}
    if nodes.ptr[rhs].kind not=? 'binary' or nodes.ptr[rhs].aux not=? 0 or nodes.ptr[rhs].op not=? int32(58) {return false}
    let one:BlWord=BlWord(nodes.ptr[rhs].b)
    bl_scan_local(BlWord(nodes.ptr[rhs].a)) =? l and nodes.ptr[one].kind =? 'int_lit' and nodes.ptr[one].ival =? 1
}

bl_has_u8_index=(n:BlWord depth:BlWord):>bool=>$unsafe {
    if n <=? 0 or depth >? 16 {return false}
    let k=nodes.ptr[n].kind
    if k =? 'index' and prune(ntype(n)) =? T_U8 {return true}
    if k =? 'and_' or k =? 'or_' or k =? 'binary' {
        return bl_has_u8_index(BlWord(nodes.ptr[n].a)  depth + 1) or bl_has_u8_index(BlWord(nodes.ptr[n].b)  depth + 1)
    }
    if k =? 'not_' or k =? 'conv' or k =? 'index' {
        if bl_has_u8_index(BlWord(nodes.ptr[n].a)  depth + 1) {return true}
        return k =? 'index' and bl_has_u8_index(BlWord(nodes.ptr[n].b)  depth + 1)
    }
    false
}

bl_is_scan_loop=(s:BlWord):>bool=>$unsafe {
    if nodes.ptr[s].aux not=? 0 {return false}
    let body:BlWord=BlWord(nodes.ptr[s].b)
    let bound:BlWord=BlWord(nodes.ptr[s].a)
    let predicate:BlWord=0
    let increment:BlWord=0
    let nb=nkids(body)
    if nb =? 1 and nodes.ptr[bound].kind =? 'and_' {
        predicate=BlWord(nodes.ptr[bound].b)
        bound=BlWord(nodes.ptr[bound].a)
        if nodes.ptr[bound].kind =? 'and_' {
            predicate=BlWord(nodes.ptr[s].a)
            let depth:BlWord=0
            loop nodes.ptr[bound].kind =? 'and_' {
                depth += 1
                if depth >? 8 {return false}
                bound=BlWord(nodes.ptr[bound].a)
            }
        }
        increment=kid(body 0)
    } else if nb =? 2 {
        let branch=kid(body 0)
        if nodes.ptr[branch].kind not=? 'if_' or nodes.ptr[branch].c not=? 0 {return false}
        if nkids(BlWord(nodes.ptr[branch].b)) not=? 1 {return false}
        predicate=BlWord(nodes.ptr[branch].a)
        increment=kid(body 1)
    } else {return false}
    if nodes.ptr[bound].kind not=? 'binary' or nodes.ptr[bound].aux not=? 0 or nodes.ptr[bound].op not=? int32(71) {return false}
    let index:BlWord=BlWord(nodes.ptr[bound].a)
    let l=bl_scan_local(index)
    if l <? 0 or prune(ntype(index)) not=? T_INT or not bl_scan_inc(increment  l) {return false}
    bl_has_u8_index(predicate  0)
}

bl_exact_is_1word=(n:BlWord):>bool=>$unsafe {
    if exact_has_node(n) {return exact_bits(n) <=? 64}
    let t=exact_representation(ntype(n))
    if t =? T_MATH_INT {return false}
    if is_int(t) and not types.ptr[t].sign and types.ptr[t].bits =? 64 {return false}
    if nodes.ptr[n].kind =? 'int_lit' and has_flag(n NF_U64) and nodes.ptr[n].ival <? 0 {return false}
    true
}

bl_exact_is_u64_leaf=(n:BlWord):>bool=>$unsafe {
    if n <=? 0 or exact_has_node(n) {return false}
    let t=exact_representation(ntype(n))
    if is_int(t) and not types.ptr[t].sign and types.ptr[t].bits <=? 64 {return true}
    nodes.ptr[n].kind =? 'int_lit' and (has_flag(n NF_U64) or nodes.ptr[n].ival >=? 0)
}

bl_exact_2word_ok=(n:BlWord):>bool=>$unsafe {
    if n <=? 0 {return false}
    if n <? exact_marks.length and (BlWord(exact_marks.ptr[n]) & 128) not=? 0 {return false}
    if exact_join_blocks.length >? 0 and exact_join_blocks.has(n) {return false}
    if not exact_has_node(n) {
        let t=exact_representation(ntype(n))
        return t not=? T_MATH_INT and bl_type_ok(t) and vc(t) =? VC_INT and bl_scan_node(n)
    }
    if bl_scan_loops >? 0 {
        bl_scan_exact_in_loop=true
        if exact_bits(n) >? 64 {bl_scan_exact_wide_in_loop=true}
    }
    if (exact_word_reads.length >? 0 and exact_word_reads.has(n)) or (exact_progress_math.length >? 0 and exact_progress_math.has(n)) {return false}
    bl_scan_nodes += 1
    let k=nodes.ptr[n].kind
    if k =? 'binary' and nodes.ptr[n].aux =? 0 {
        let op=cx_token_values.ptr[BlWord(nodes.ptr[n].op)]
        if op =? 'eq' or op =? 'ne' or op =? 'lt' or op =? 'le' or op =? 'gt' or op =? 'ge' {
            return bl_exact_2word_ok(BlWord(nodes.ptr[n].a)) and bl_exact_2word_ok(BlWord(nodes.ptr[n].b))
        }
        if exact_bits(n) >? 128 {return false}
        let a:BlWord=BlWord(nodes.ptr[n].a)
        let b0:BlWord=BlWord(nodes.ptr[n].b)
        if op =? 'plus' or op =? 'minus' or op =? 'star' or op =? 'amp' or op =? 'pipe' or op =? 'caret' {
            return bl_exact_2word_ok(a) and bl_exact_2word_ok(b0)
        }
        if op =? 'shl' or op =? 'shr' {
            let [known_c lit_c]=integer_constant(b0)
            return known_c and not has_flag(b0 NF_U64) and lit_c >=? 0 and bl_exact_2word_ok(a)
        }
        if op =? 'slash' or op =? 'percent' {
            if dewy_at(nodes.ptr[n].pos) {
                let [known d]=integer_constant(b0)
                if known and not has_flag(b0 NF_U64) and d >? 0 and (d & (d - 1)) =? 0 {
                    return bl_exact_2word_ok(a)
                }
            }
            if bl_exact_is_u64_leaf(a) and bl_exact_is_u64_leaf(b0) {
                return bl_scan_node(a) and bl_scan_node(b0)
            }
            if exact_bits(n) <=? 64 and bl_exact_1word_ok(a) and bl_exact_1word_ok(b0) {return true}
            return false
        }
        return false
    }
    if exact_bits(n) >? 128 {return false}
    if k =? 'unary' and nodes.ptr[n].op =? 59 {return bl_exact_2word_ok(BlWord(nodes.ptr[n].a))}
    if k =? 'exprstmt' or (k =? 'conv' and (nodes.ptr[n].aux =? int32(int64(CV.int_)) or nodes.ptr[n].aux =? int32(int64(CV.none_)))) {
        return bl_exact_2word_ok(BlWord(nodes.ptr[n].a))
    }
    false
}

bl_exact_low_ok=(n:BlWord):>bool=>$unsafe {
    if n <=? 0 {return false}
    if n <? exact_marks.length and (BlWord(exact_marks.ptr[n]) & 128) not=? 0 {return false}
    if exact_join_blocks.length >? 0 and exact_join_blocks.has(n) {return false}
    if not exact_has_node(n) {
        let t=exact_representation(ntype(n))
        return t not=? T_MATH_INT and bl_type_ok(t) and vc(t) =? VC_INT and bl_scan_node(n)
    }
    if bl_scan_loops >? 0 {bl_scan_exact_in_loop=true}
    if (exact_word_reads.length >? 0 and exact_word_reads.has(n)) or (exact_progress_math.length >? 0 and exact_progress_math.has(n)) {return false}
    bl_scan_nodes += 1
    let k=nodes.ptr[n].kind
    if k =? 'binary' and nodes.ptr[n].aux =? 0 {
        let op=cx_token_values.ptr[BlWord(nodes.ptr[n].op)]
        if op =? 'plus' or op =? 'minus' or op =? 'star' or op =? 'amp' or op =? 'pipe' or op =? 'caret' {
            return bl_exact_low_ok(BlWord(nodes.ptr[n].a)) and bl_exact_low_ok(BlWord(nodes.ptr[n].b))
        }
    }
    if k =? 'unary' and nodes.ptr[n].op =? 59 {return bl_exact_low_ok(BlWord(nodes.ptr[n].a))}
    if k =? 'exprstmt' or (k =? 'conv' and (nodes.ptr[n].aux =? int32(int64(CV.int_)) or nodes.ptr[n].aux =? int32(int64(CV.none_)))) {
        return bl_exact_low_ok(BlWord(nodes.ptr[n].a))
    }
    bl_exact_1word_ok(n) or bl_exact_2word_ok(n)
}

bl_exact_1word_ok=(n:BlWord):>bool=>$unsafe {
    if n <=? 0 {return false}
    if n <? exact_marks.length and (BlWord(exact_marks.ptr[n]) & 128) not=? 0 {return false}
    if exact_join_blocks.length >? 0 and exact_join_blocks.has(n) {return false}
    if not exact_has_node(n) {return bl_exact_is_1word(n) and bl_scan_node(n)}
    if bl_scan_loops >? 0 {bl_scan_exact_in_loop=true}
    if (exact_word_reads.length >? 0 and exact_word_reads.has(n)) or (exact_progress_math.length >? 0 and exact_progress_math.has(n)) {return false}
    bl_scan_nodes += 1
    let k=nodes.ptr[n].kind
    if k =? 'binary' and nodes.ptr[n].aux =? 0 {
        let op=cx_token_values.ptr[BlWord(nodes.ptr[n].op)]
        if op =? 'eq' or op =? 'ne' or op =? 'lt' or op =? 'le' or op =? 'gt' or op =? 'ge' {
            let ln:BlWord=BlWord(nodes.ptr[n].a)
            let rn:BlWord=BlWord(nodes.ptr[n].b)
            let [rk rval]=integer_constant(rn)
            if rk and not has_flag(rn NF_U64) and rval =? 0 and exact_has_node(ln) and nodes.ptr[ln].kind =? 'binary' and nodes.ptr[ln].aux =? 0 and cx_token_values.ptr[BlWord(nodes.ptr[ln].op)] =? 'minus' {
                if bl_exact_1word_ok(BlWord(nodes.ptr[ln].a)) and bl_exact_1word_ok(BlWord(nodes.ptr[ln].b)) {return true}
            }
            let [lk lval]=integer_constant(ln)
            if lk and not has_flag(ln NF_U64) and lval =? 0 and exact_has_node(rn) and nodes.ptr[rn].kind =? 'binary' and nodes.ptr[rn].aux =? 0 and cx_token_values.ptr[BlWord(nodes.ptr[rn].op)] =? 'minus' {
                if bl_exact_1word_ok(BlWord(nodes.ptr[rn].a)) and bl_exact_1word_ok(BlWord(nodes.ptr[rn].b)) {return true}
            }
            if bl_exact_1word_ok(ln) and bl_exact_1word_ok(rn) {return true}
            return bl_exact_2word_ok(ln) and bl_exact_2word_ok(rn)
        }
        if exact_bits(n) >? 64 {return false}
        if op =? 'plus' or op =? 'minus' or op =? 'star' or op =? 'amp' or op =? 'pipe' or op =? 'caret' {
            return bl_exact_low_ok(BlWord(nodes.ptr[n].a)) and bl_exact_low_ok(BlWord(nodes.ptr[n].b))
        }
        if op =? 'slash' or op =? 'percent' {
            let a:BlWord=BlWord(nodes.ptr[n].a)
            let b0:BlWord=BlWord(nodes.ptr[n].b)
            if bl_exact_1word_ok(a) and bl_exact_1word_ok(b0) {return true}
            if dewy_at(nodes.ptr[n].pos) {
                let [known d]=integer_constant(b0)
                if known and not has_flag(b0 NF_U64) and d >? 0 and (d & (d - 1)) =? 0 {
                    return bl_exact_2word_ok(a)
                }
            }
            return bl_exact_is_u64_leaf(a) and bl_exact_is_u64_leaf(b0) and bl_scan_node(a) and bl_scan_node(b0)
        }
        if op =? 'shl' or op =? 'shr' {
            let b0:BlWord=BlWord(nodes.ptr[n].b)
            let [known_c lit_c]=integer_constant(b0)
            if not known_c or has_flag(b0 NF_U64) or lit_c <? 0 {return false}
            let a:BlWord=BlWord(nodes.ptr[n].a)
            return (lit_c <? 64 and bl_exact_1word_ok(a)) or bl_exact_2word_ok(a)
        }
        return false
    }
    if exact_bits(n) >? 64 {return false}
    if k =? 'unary' and nodes.ptr[n].op =? 59 {return bl_exact_1word_ok(BlWord(nodes.ptr[n].a))}
    if k =? 'exprstmt' or (k =? 'conv' and (nodes.ptr[n].aux =? int32(int64(CV.int_)) or nodes.ptr[n].aux =? int32(int64(CV.none_)))) {
        return bl_exact_1word_ok(BlWord(nodes.ptr[n].a))
    }
    false
}

bl_exact_store_ok=(e:BlWord):>bool=>$unsafe {
    if e <? exact_marks.length and (BlWord(exact_marks.ptr[e]) & 128) not=? 0 {return false}
    if exact_map_active and exact_map_stores.has(e) {return false}
    if bl_scan_loops >? 0 {bl_scan_exact_in_loop=true}
    if (exact_word_reads.length >? 0 and exact_word_reads.has(e)) or (exact_progress_math.length >? 0 and exact_progress_math.has(e)) {
        let a:BlWord=BlWord(nodes.ptr[e].a)
        let to=prune(ntype(e))
        return bl_type_ok(to) and bl_type_ok(prune(ntype(a))) and vc(to) =? VC_INT and bl_scan_node(a)
    }
    let t=exact_representation(ntype(e))
    if not bl_type_ok(t) or not is_int(t) or types.ptr[t].bits >? 64 {return false}
    let source:BlWord=BlWord(nodes.ptr[e].a)
    let proven=exact_proved(e)
    if not proven {
        let bnd=positive_bound(source  true)
        if bnd >=? 0 and sa_fits(bnd  t) {proven=true}
    }
    if proven {return bl_exact_low_ok(source) or bl_exact_2word_ok(source)}
    loop exact_has_node(source) and (nodes.ptr[source].kind =? 'exprstmt' or (nodes.ptr[source].kind =? 'conv' and (nodes.ptr[source].aux =? int32(int64(CV.int_)) or nodes.ptr[source].aux =? int32(int64(CV.none_))))) {
        source=BlWord(nodes.ptr[source].a)
    }
    if not exact_has_node(source) {
        let st=exact_representation(ntype(source))
        return bl_type_ok(st) and vc(st) =? VC_INT and st not=? T_MATH_INT and bl_scan_node(source)
    }
    let bits=BlWord(types.ptr[t].bits)
    let signed=types.ptr[t].sign
    if bits =? 64 and signed and nodes.ptr[source].kind =? 'unary' and nodes.ptr[source].op =? 59 {
        let opnd:BlWord=BlWord(nodes.ptr[source].a)
        if exact_bits(opnd) <=? 64 and bl_exact_low_ok(opnd) {return true}
    }
    if nodes.ptr[source].kind =? 'binary' and nodes.ptr[source].aux =? 0 {
        let op=cx_token_values.ptr[BlWord(nodes.ptr[source].op)]
        if op =? 'plus' or op =? 'minus' or op =? 'star' {
            let a:BlWord=BlWord(nodes.ptr[source].a)
            let b0:BlWord=BlWord(nodes.ptr[source].b)
            if bits =? 32 {
                let aw=BlWord(exact_type_width(a))
                let bw=BlWord(exact_type_width(b0))
                let fits=aw >? 0 and bw >? 0 and (if signed {aw >> 1 <=? 32 and bw >> 1 <=? 32} else {(aw & bw & 1) not=? 0 and aw >> 1 <=? 33 and bw >> 1 <=? 33})
                if fits and bl_exact_low_ok(a) and bl_exact_low_ok(b0) {return true}
            }
            if bits =? 64 and signed and exact_bits(a) <=? 64 and exact_bits(b0) <=? 64 {
                if bl_exact_low_ok(a) and bl_exact_low_ok(b0) {return true}
            }
            if bits <? 64 and exact_bits(a) <=? 64 and exact_bits(b0) <=? 64 {
                if bl_exact_low_ok(a) and bl_exact_low_ok(b0) {return true}
            }
            if bits =? 64 and not signed {
                let aw=BlWord(exact_type_width(a))
                let bw=BlWord(exact_type_width(b0))
                if aw >? 0 and bw >? 0 and (aw & bw & 1) not=? 0 and aw >> 1 <=? 65 and bw >> 1 <=? 65 {
                    if bl_exact_low_ok(a) and bl_exact_low_ok(b0) {return true}
                }
            }
        }
    }
    bl_exact_1word_ok(source) or bl_exact_2word_ok(source)
}

bl_exact_float_ok=(a:BlWord):>bool=>$unsafe {
    if a <=? 0 or (a <? exact_marks.length and (BlWord(exact_marks.ptr[a]) & 128) not=? 0) {return false}
    if exact_join_blocks.length >? 0 and exact_join_blocks.has(a) {return false}
    if exact_bits(a) <=? 64 and bl_exact_1word_ok(a) {return true}
    bl_exact_2word_ok(a)
}

let bl_scan_stack:array<int32>=[]
let bl_scan_sp:BlWord=0

bl_scan_push=(x:BlWord):>void=>$unsafe {
    if x =? 0 {return}
    let sp=bl_scan_sp
    if sp >=? bl_scan_stack.length {bl_scan_stack.resize(if bl_scan_stack.length >? 0 {bl_scan_stack.length * 2} else {256})}
    bl_scan_stack.ptr[sp]=int32<overflow='wrap'>(x)
    bl_scan_sp=sp + 1
}

bl_scan_node=(e0:BlWord):>bool=>$unsafe {
    let sp0=bl_scan_sp
    let loops0=bl_scan_loops
    if bl_scan_stack.length <? sp0 + 64 {bl_scan_stack.resize(sp0 + 256)}
    let sp=sp0
    let cap=bl_scan_stack.length
    let st=bl_scan_stack.ptr
    let rare=bl_scan_rare
    let copies_maybe=bl_fn_copies_maybe
    let e=e0
    loop true {
        if e <=? 0 {
            if e =? -1 {bl_scan_loops -= 1}
            else if e =? -2 {
                bl_scan_loops += 1
                if bl_scan_loops >? bl_scan_max_loop_depth {bl_scan_max_loop_depth=bl_scan_loops}
            }
            if sp <=? sp0 {bl_scan_sp=sp0; return true}
            sp -= 1
            e=BlWord(st[sp])
            continue
        }
        if rare {
            if ff_checks_any and ff_checks.has(e) {bl_scan_sp=sp0; bl_scan_loops=loops0; return false}
            if float_keys_any and float_keys.has(e) {bl_scan_sp=sp0; bl_scan_loops=loops0; return false}
            if bl_fn_exact {
                if e <? exact_marks.length and (BlWord(exact_marks.ptr[e]) & 128) not=? 0 {bl_scan_sp=sp0; bl_scan_loops=loops0; return false}
                if bl_scan_loops >? 0 and e <? exact_marks.length and (BlWord(exact_marks.ptr[e]) & 3) not=? 0 {bl_scan_exact_in_loop=true}
                if exact_join_blocks.length >? 0 and exact_join_blocks.has(e) {bl_scan_sp=sp0; bl_scan_loops=loops0; return false}
                if nodes.ptr[e].kind =? 'conv' and (nodes.ptr[e].aux as CV) =? CV.fixed_store {
                    bl_scan_nodes += 1
                    bl_scan_sp=sp
                    if not bl_exact_store_ok(e) {bl_scan_sp=sp0; bl_scan_loops=loops0; return false}
                    sp=bl_scan_sp; cap=bl_scan_stack.length; st=bl_scan_stack.ptr
                    if sp <=? sp0 {bl_scan_sp=sp0; return true}
                    sp -= 1; e=BlWord(st[sp]); continue
                }
                if exact_has_node(e) {
                    bl_scan_sp=sp
                    if not bl_exact_low_ok(e) {bl_scan_sp=sp0; bl_scan_loops=loops0; return false}
                    sp=bl_scan_sp; cap=bl_scan_stack.length; st=bl_scan_stack.ptr
                    if sp <=? sp0 {bl_scan_sp=sp0; return true}
                    sp -= 1; e=BlWord(st[sp]); continue
                }
            }
        }
        bl_scan_nodes += 1
        let k=nodes.ptr[e].kind
        match k {
            <'ident'> => {
                let aux=nodes.ptr[e].aux
                if aux not=? 1 and aux not=? 2 {bl_scan_sp=sp0; bl_scan_loops=loops0; return false}
                let t0:BlWord=BlWord(nodes.ptr[e].type)
                let info:BlWord=if t0 >? 0 and t0 <? bl_ty_info.length {bl_ty_info.ptr[t0]} else {0}
                if info =? 0 {info=bl_tinfo_slow(t0)}
                if (info & 1) =? 0 {bl_scan_sp=sp0; bl_scan_loops=loops0; return false}
                if aux =? 1 {
                    let l:BlWord=BlWord(nodes.ptr[e].sym)
                    let fl:BlWord=BlWord(locals.ptr[l].flags)
                    if fl & (LF_CAPTURE | LF_CAPTURED | LF_SHARED | LF_OWNERBORROW | LF_PARTBORROW) not=? 0 {bl_scan_sp=sp0; bl_scan_loops=loops0; return false}
                    if fl & LF_ALIAS not=? 0 {
                        let al:BlWord=BlWord(locals.ptr[l].alias)
                        if al <=? 0 or bl_scan_nodes >? 4096 {bl_scan_sp=sp0; bl_scan_loops=loops0; return false}
                        e=al
                        continue
                    }
                }
                if sp <=? sp0 {bl_scan_sp=sp0; return true}
                sp -= 1; e=BlWord(st[sp]); continue
            }
            <'int_lit'> => {
                let t0:BlWord=BlWord(nodes.ptr[e].type)
                let info:BlWord=if t0 >? 0 and t0 <? bl_ty_info.length {bl_ty_info.ptr[t0]} else {0}
                if info =? 0 {info=bl_tinfo_slow(t0)}
                if (info & 13) not=? 5 {bl_scan_sp=sp0; bl_scan_loops=loops0; return false}
                if sp <=? sp0 {bl_scan_sp=sp0; return true}
                sp -= 1; e=BlWord(st[sp]); continue
            }
            <'bool_lit' | 'null_lit' | 'none_lit' | 'dotname'> => {
                let t0:BlWord=BlWord(nodes.ptr[e].type)
                let info:BlWord=if t0 >? 0 and t0 <? bl_ty_info.length {bl_ty_info.ptr[t0]} else {0}
                if info =? 0 {info=bl_tinfo_slow(t0)}
                if (info & 1) =? 0 {bl_scan_sp=sp0; bl_scan_loops=loops0; return false}
                if sp <=? sp0 {bl_scan_sp=sp0; return true}
                sp -= 1; e=BlWord(st[sp]); continue
            }
            <'str_lit'> => {
                if nodes.ptr[e].aux =? 0 {
                    if sp <=? sp0 {bl_scan_sp=sp0; return true}
                    sp -= 1; e=BlWord(st[sp]); continue
                }
                bl_scan_sp=sp
                if not bl_scan_node_slow(e) {bl_scan_sp=sp0; bl_scan_loops=loops0; return false}
                sp=bl_scan_sp; cap=bl_scan_stack.length; st=bl_scan_stack.ptr
                if sp <=? sp0 {bl_scan_sp=sp0; return true}
                sp -= 1; e=BlWord(st[sp]); continue
            }
            <'exprstmt'> => {
                if refine_active and ref_pair_erased(e) {bl_scan_sp=sp0; bl_scan_loops=loops0; return false}
                e=BlWord(nodes.ptr[e].a)
                continue
            }
            <'not_' | 'defer_'> => {
                e=BlWord(nodes.ptr[e].a)
                continue
            }
            <'and_' | 'or_'> => {
                let b0:BlWord=BlWord(nodes.ptr[e].b)
                if b0 not=? 0 {
                    if sp >=? cap {cap=cap * 2 + 64; bl_scan_stack.resize(cap); st=bl_scan_stack.ptr}
                    st[sp]=int32<overflow='wrap'>(b0); sp += 1
                }
                e=BlWord(nodes.ptr[e].a)
                continue
            }
            <'break_' | 'continue_'> => {
                if bl_scan_loops <=? 0 {bl_scan_sp=sp0; bl_scan_loops=loops0; return false}
                if sp <=? sp0 {bl_scan_sp=sp0; return true}
                sp -= 1; e=BlWord(st[sp]); continue
            }
            <'return_'> => {
                let a:BlWord=BlWord(nodes.ptr[e].a)
                if a =? 0 {
                    if sp <=? sp0 {bl_scan_sp=sp0; return true}
                    sp -= 1; e=BlWord(st[sp]); continue
                }
                if copies_maybe {
                    let t0:BlWord=BlWord(nodes.ptr[a].type)
                    let info:BlWord=if t0 >? 0 and t0 <? bl_ty_info.length {bl_ty_info.ptr[t0]} else {0}
                    if info =? 0 {info=bl_tinfo_slow(t0)}
                    if (info & 32) not=? 0 and not bl_copy_own_ok(a  t0) {bl_scan_sp=sp0; bl_scan_loops=loops0; return false}
                }
                e=a
                continue
            }
            <'unary'> => {
                let op=nodes.ptr[e].op
                let t0:BlWord=BlWord(nodes.ptr[e].type)
                let info:BlWord=if t0 >? 0 and t0 <? bl_ty_info.length {bl_ty_info.ptr[t0]} else {0}
                if info =? 0 {info=bl_tinfo_slow(t0)}
                if (info & 1) =? 0 {bl_scan_sp=sp0; bl_scan_loops=loops0; return false}
                let vc_b=info & 12
                if vc_b =? 8 {
                    bl_scan_has_float=true
                    if op not=? 58 and op not=? 59 {bl_scan_sp=sp0; bl_scan_loops=loops0; return false}
                    e=BlWord(nodes.ptr[e].a)
                    continue
                }
                if (op not=? 58 and op not=? 59 and op not=? 66) or vc_b not=? 4 {bl_scan_sp=sp0; bl_scan_loops=loops0; return false}
                e=BlWord(nodes.ptr[e].a)
                continue
            }
            <'binary'> => {
                if nodes.ptr[e].aux not=? 0 {
                    bl_scan_sp=sp
                    if not bl_scan_node_slow(e) {bl_scan_sp=sp0; bl_scan_loops=loops0; return false}
                    sp=bl_scan_sp; cap=bl_scan_stack.length; st=bl_scan_stack.ptr
                    if sp <=? sp0 {bl_scan_sp=sp0; return true}
                    sp -= 1; e=BlWord(st[sp]); continue
                }
                let a:BlWord=BlWord(nodes.ptr[e].a)
                let b0:BlWord=BlWord(nodes.ptr[e].b)
                let lt0:BlWord=BlWord(nodes.ptr[a].type)
                let linfo:BlWord=if lt0 >? 0 and lt0 <? bl_ty_info.length {bl_ty_info.ptr[lt0]} else {0}
                if linfo =? 0 {linfo=bl_tinfo_slow(lt0)}
                if (linfo & 77) not=? 5 {
                    bl_scan_sp=sp
                    if not bl_scan_node_slow(e) {bl_scan_sp=sp0; bl_scan_loops=loops0; return false}
                    sp=bl_scan_sp; cap=bl_scan_stack.length; st=bl_scan_stack.ptr
                    if sp <=? sp0 {bl_scan_sp=sp0; return true}
                    sp -= 1; e=BlWord(st[sp]); continue
                }
                let rt0:BlWord=BlWord(nodes.ptr[e].type)
                let rinfo:BlWord=if rt0 >? 0 and rt0 <? bl_ty_info.length {bl_ty_info.ptr[rt0]} else {0}
                if rinfo =? 0 {rinfo=bl_tinfo_slow(rt0)}
                if (rinfo & 1) =? 0 {bl_scan_sp=sp0; bl_scan_loops=loops0; return false}
                if b0 not=? 0 {
                    if sp >=? cap {cap=cap * 2 + 64; bl_scan_stack.resize(cap); st=bl_scan_stack.ptr}
                    st[sp]=int32<overflow='wrap'>(b0); sp += 1
                }
                e=a
                continue
            }
            <'field'> => {
                if nodes.ptr[e].aux <? 0 {
                    bl_scan_sp=sp
                    if not bl_scan_node_slow(e) {bl_scan_sp=sp0; bl_scan_loops=loops0; return false}
                    sp=bl_scan_sp; cap=bl_scan_stack.length; st=bl_scan_stack.ptr
                    if sp <=? sp0 {bl_scan_sp=sp0; return true}
                    sp -= 1; e=BlWord(st[sp]); continue
                }
                let a:BlWord=BlWord(nodes.ptr[e].a)
                let at0:BlWord=BlWord(nodes.ptr[a].type)
                let ainfo:BlWord=if at0 >? 0 and at0 <? bl_ty_info.length {bl_ty_info.ptr[at0]} else {0}
                if ainfo =? 0 {ainfo=bl_tinfo_slow(at0)}
                if (ainfo & 1) =? 0 {bl_scan_sp=sp0; bl_scan_loops=loops0; return false}
                let aq:BlWord=(ainfo >> 8) & 0xFFFFFF
                let bk=types.ptr[aq].kind
                if bk not=? 'struct_' and bk not=? 'tuple' {
                    bl_scan_sp=sp
                    if not bl_scan_node_slow(e) {bl_scan_sp=sp0; bl_scan_loops=loops0; return false}
                    sp=bl_scan_sp; cap=bl_scan_stack.length; st=bl_scan_stack.ptr
                    if sp <=? sp0 {bl_scan_sp=sp0; return true}
                    sp -= 1; e=BlWord(st[sp]); continue
                }
                let et0:BlWord=BlWord(nodes.ptr[e].type)
                let einfo:BlWord=if et0 >? 0 and et0 <? bl_ty_info.length {bl_ty_info.ptr[et0]} else {0}
                if einfo =? 0 {einfo=bl_tinfo_slow(et0)}
                if (einfo & 1) =? 0 {bl_scan_sp=sp0; bl_scan_loops=loops0; return false}
                e=a
                continue
            }
            <'index'> => {
                if nodes.ptr[e].aux not=? 0 {
                    bl_scan_sp=sp
                    if not bl_scan_node_slow(e) {bl_scan_sp=sp0; bl_scan_loops=loops0; return false}
                    sp=bl_scan_sp; cap=bl_scan_stack.length; st=bl_scan_stack.ptr
                    if sp <=? sp0 {bl_scan_sp=sp0; return true}
                    sp -= 1; e=BlWord(st[sp]); continue
                }
                let a:BlWord=BlWord(nodes.ptr[e].a)
                let b0:BlWord=BlWord(nodes.ptr[e].b)
                let at0:BlWord=BlWord(nodes.ptr[a].type)
                let ainfo:BlWord=if at0 >? 0 and at0 <? bl_ty_info.length {bl_ty_info.ptr[at0]} else {0}
                if ainfo =? 0 {ainfo=bl_tinfo_slow(at0)}
                if (ainfo & 1) =? 0 {bl_scan_sp=sp0; bl_scan_loops=loops0; return false}
                let aq:BlWord=(ainfo >> 8) & 0xFFFFFF
                let bk=types.ptr[aq].kind
                if bk not=? 'array' and bk not=? 'str_' and bk not=? 'ptr' and bk not=? 'fixed' {bl_scan_sp=sp0; bl_scan_loops=loops0; return false}
                let et0:BlWord=BlWord(nodes.ptr[e].type)
                let einfo:BlWord=if et0 >? 0 and et0 <? bl_ty_info.length {bl_ty_info.ptr[et0]} else {0}
                if einfo =? 0 {einfo=bl_tinfo_slow(et0)}
                if (einfo & 1) =? 0 {bl_scan_sp=sp0; bl_scan_loops=loops0; return false}
                if b0 not=? 0 {
                    if sp >=? cap {cap=cap * 2 + 64; bl_scan_stack.resize(cap); st=bl_scan_stack.ptr}
                    st[sp]=int32<overflow='wrap'>(b0); sp += 1
                }
                e=a
                continue
            }
            <'block'> => {
                if dir_runtime_settings and (has_flag(e NF_UNSCOPED) or nodes.ptr[e].aux =? 5) {bl_scan_sp=sp0; bl_scan_loops=loops0; return false}
                let t0:BlWord=BlWord(nodes.ptr[e].type)
                let tinfo:BlWord=0
                if t0 >? 0 {
                    tinfo=if t0 <? bl_ty_info.length {bl_ty_info.ptr[t0]} else {0}
                    if tinfo =? 0 {tinfo=bl_tinfo_slow(t0)}
                    if (tinfo & 1) =? 0 {bl_scan_sp=sp0; bl_scan_loops=loops0; return false}
                }
                let nb:BlWord=BlWord(nodes.ptr[e].nlist)
                if nb =? 0 {
                    if sp <=? sp0 {bl_scan_sp=sp0; return true}
                    sp -= 1; e=BlWord(st[sp]); continue
                }
                let lbase:BlWord=BlWord(nodes.ptr[e].list)
                if copies_maybe and nodes.ptr[e].aux not=? 0 and t0 >? 0 and (tinfo & 12) not=? 0 and (tinfo & 32) not=? 0 {
                    let last:BlWord=BlWord(lists.ptr[lbase + nb - 1])
                    if nodes.ptr[last].kind =? 'exprstmt' and not bl_copy_own_ok(BlWord(nodes.ptr[last].a)  t0) {bl_scan_sp=sp0; bl_scan_loops=loops0; return false}
                }
                if nb >? 1 {
                    if sp + nb >? cap {cap=(sp + nb) * 2 + 64; bl_scan_stack.resize(cap); st=bl_scan_stack.ptr}
                    let lp=lists.ptr
                    let i:BlWord=nb - 1
                    loop i >? 0 {
                        let ci=lp[lbase + i]
                        if ci not=? 0 {st[sp]=ci; sp += 1}
                        i -= 1
                    }
                }
                e=BlWord(lists.ptr[lbase])
                continue
            }
            <'if_'> => {
                if not has_flag(e NF_STMT) {
                    let t0:BlWord=BlWord(nodes.ptr[e].type)
                    let t:BlWord=if types.ptr[t0].kind =? 'var' {prune(t0)} else {t0}
                    if t not=? T_NEVER {
                        let info:BlWord=if t >? 0 and t <? bl_ty_info.length {bl_ty_info.ptr[t]} else {0}
                        if info =? 0 {info=bl_tinfo_slow(t)}
                        if (info & 1) =? 0 {bl_scan_sp=sp0; bl_scan_loops=loops0; return false}
                    }
                }
                let a:BlWord=BlWord(nodes.ptr[e].a)
                let b0:BlWord=BlWord(nodes.ptr[e].b)
                let ec:BlWord=BlWord(nodes.ptr[e].c)
                if sp + 2 >? cap {cap=cap * 2 + 64; bl_scan_stack.resize(cap); st=bl_scan_stack.ptr}
                if ec not=? 0 {st[sp]=int32<overflow='wrap'>(ec); sp += 1}
                if b0 not=? 0 {st[sp]=int32<overflow='wrap'>(b0); sp += 1}
                e=a
                continue
            }
            <'conv'> => {
                if bl_fn_exact {
                    bl_scan_sp=sp
                    if not bl_scan_node_slow(e) {bl_scan_sp=sp0; bl_scan_loops=loops0; return false}
                    sp=bl_scan_sp; cap=bl_scan_stack.length; st=bl_scan_stack.ptr
                    if sp <=? sp0 {bl_scan_sp=sp0; return true}
                    sp -= 1; e=BlWord(st[sp]); continue
                }
                let cv=nodes.ptr[e].aux as CV
                if cv =? CV.none_ or cv =? CV.quantity_const or cv =? CV.ptr or cv =? CV.int_ or cv =? CV.wrap_int or cv =? CV.bits {
                    let a:BlWord=BlWord(nodes.ptr[e].a)
                    let to0:BlWord=BlWord(nodes.ptr[e].type)
                    let fr0:BlWord=BlWord(nodes.ptr[a].type)
                    let to_i:BlWord=if to0 >? 0 and to0 <? bl_ty_info.length {bl_ty_info.ptr[to0]} else {0}
                    if to_i =? 0 {to_i=bl_tinfo_slow(to0)}
                    let fr_i:BlWord=if fr0 >? 0 and fr0 <? bl_ty_info.length {bl_ty_info.ptr[fr0]} else {0}
                    if fr_i =? 0 {fr_i=bl_tinfo_slow(fr0)}
                    if cv =? CV.none_ or cv =? CV.quantity_const or cv =? CV.ptr {
                        if (to_i & 1) =? 0 or (fr_i & 1) =? 0 {bl_scan_sp=sp0; bl_scan_loops=loops0; return false}
                    } else {
                        if (to_i & 13) not=? 5 or (fr_i & 13) not=? 5 {bl_scan_sp=sp0; bl_scan_loops=loops0; return false}
                    }
                    e=a
                    continue
                }
                bl_scan_sp=sp
                if not bl_scan_node_slow(e) {bl_scan_sp=sp0; bl_scan_loops=loops0; return false}
                sp=bl_scan_sp; cap=bl_scan_stack.length; st=bl_scan_stack.ptr
                if sp <=? sp0 {bl_scan_sp=sp0; return true}
                sp -= 1; e=BlWord(st[sp]); continue
            }
            _ => {
                bl_scan_sp=sp
                if not bl_scan_node_slow(e) {bl_scan_sp=sp0; bl_scan_loops=loops0; return false}
                sp=bl_scan_sp; cap=bl_scan_stack.length; st=bl_scan_stack.ptr
                if sp <=? sp0 {bl_scan_sp=sp0; return true}
                sp -= 1; e=BlWord(st[sp]); continue
            }
        }
    }
    bl_scan_sp=sp0
    true
}

bl_scan_node_slow=(e:BlWord):>bool=>$unsafe {
    let k=nodes.ptr[e].kind
    match k {
        <'float_lit'> => {
            bl_scan_has_float=true
            let info=bl_tinfo(BlWord(nodes.ptr[e].type))
            (info & 13) =? 9
        }
        <'str_lit'> => {
            bl_scan_calls += 1
            bl_scan_managed=true
            let cs=bl_fn_copy_strict or (bl_fn_copies_maybe and copy_strict(e))
            loop i in [0..nkids(e)) {
                let p=kid(e i)
                if nodes.ptr[p].kind =? 'str_lit' {continue}
                let f:BlWord=BlWord(nodes.ptr[p].sym)
                let x:BlWord=BlWord(nodes.ptr[p].a)
                if f <=? 0 {return false}
                let xinfo=bl_tinfo(BlWord(nodes.ptr[x].type))
                if (xinfo & 1) =? 0 {return false}
                if cs and (xinfo & 32) not=? 0 {return false}
                if f not=? format_word_inst {
                    if fns.ptr[f].cabi or fns.ptr[f].has_env or fns.ptr[f].parallel_api or fns.ptr[f].deterministic {return false}
                }
                bl_scan_push(x)
            }
            true
        }
        <'const_'> => {
            let ct0:BlWord=BlWord(nodes.ptr[e].type)
            if ct0 >? 0 and (bl_tinfo(ct0) & 12) =? 8 {bl_scan_has_float=true}
            true
        }
        <'vardecl'> => {
            if nodes.ptr[e].nlist >? 0 {
                let iv:BlWord=BlWord(nodes.ptr[e].b)
                if iv =? 0 {return false}

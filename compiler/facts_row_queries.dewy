$runtime_checks

from p"facts.jo" import (FACT_RECORD FactState fact_index_get fact_pair_key)

RowWord:type=int64<overflow='wrap'>

# Read-only queries over a state's difference rows. A state with fewer than
# FACT_ROW_SCAN rows has no chains: its rows are scanned in order, giving the
# same rows in the same order the index chains give once they exist.
fact_rows_indexed=(s:FactState):>bool=>s.index[0].difference_next.length not=? 0
# The row a - b <= limit's position, or -1.
# (the scan stays inside the unchanged rows: i counts down from length - 1)
fact_row_find=(s:FactState a:RowWord b:RowWord):>int64=>$unsafe {
    if fact_rows_indexed(s) {return fact_index_get(s.index[0].difference_index fact_pair_key(a b))}
    let i:RowWord=s.differences.length - 1
    loop i >=? 0 {
        if s.differences.ptr[i].a =? a and s.differences.ptr[i].b =? b {return i}
        i-=1
    }
    -1
}
# Rows touching v, or -1 when none does.
fact_incident=(s:FactState v:RowWord):>int64=>{
    if not fact_rows_indexed(s) {
        let count:RowWord=0
        loop row in s.differences {count+=int64(row.a =? v) + int64(row.b =? v)}
        return if count =? 0 {-1} else {count}
    }
    let r:RowWord=fact_index_get(s.index[0].difference_value v)
    if r <? 0 {return -1}
    s.index[0].difference_record[r * FACT_RECORD]
}
# The first row from v (direction 0: rows by b; 1: rows by a), or -1.
fact_difference_head=(s:FactState v:RowWord direction:RowWord):>int64=>{
    if not fact_rows_indexed(s) {return fact_row_scan(s v direction 0)}
    let r:RowWord=fact_index_get(s.index[0].difference_value v)
    if r <? 0 {return -1}
    s.index[0].difference_record[r * FACT_RECORD + 1 + direction * 2]
}
# The row after ri from the same value in the same direction, or -1.
fact_difference_next=(s:FactState ri:RowWord direction:RowWord):>int64=>{
    if fact_rows_indexed(s) {return s.index[0].difference_next[ri * 2 + direction]}
    let row=s.differences[ri]
    let v:RowWord=row.a
    if direction =? 0 {v=row.b}
    fact_row_scan(s v direction ri + 1)
}
fact_row_scan=(s:FactState v:RowWord direction:RowWord start:RowWord):>int64=>{
    loop i in [start..RowWord(s.differences.length)) {
        let row=s.differences[i]
        if direction =? 0 and row.b =? v or direction =? 1 and row.a =? v {return i}
    }
    -1
}

$runtime_checks

from p"facts.jo" import (FACT_RECORD FactIndexes FactState)
from p"facts_value_queries.dewy" import (fact_index_get fact_index_get_raw)

RowWord:type=int64<overflow='wrap'>

# Read-only queries over a state's difference rows. A state with fewer than
# FACT_ROW_SCAN rows has no chains: its rows are scanned in order, giving the
# same rows in the same order the index chains give once they exist.
fact_rows_indexed=(s:FactState):>bool=>$unsafe {s.index.ptr[0].difference_next.length not=? 0}
# The row a - b <= limit's position, or -1.
# (the scan stays inside the unchanged rows: i counts down from length - 1)
fact_row_find=(s:FactState a:RowWord b:RowWord):>int64=>$unsafe {
    if (RowWord(s.diff_a_mask) & (RowWord(1) << (a & 63))) =? 0 or (RowWord(s.diff_b_mask) & (RowWord(1) << (b & 63))) =? 0 {return -1}
    let idx=s.index.ptr
    if idx[0].difference_next.length not=? 0 {return fact_index_get_raw(idx[0].difference_index.ptr idx[0].difference_index.length fact_pair_key(a b))}
    let diffs=s.differences.ptr
    let i:RowWord=RowWord(s.differences.length) - 1
    loop i >=? 0 {
        if diffs[i].a =? a and diffs[i].b =? b {return i}
        i-=1
    }
    -1
}
# Rows touching v, or -1 when none does.
fact_incident_indexed=(idx:ptr<FactIndexes> v:RowWord):>int64=>$unsafe {
    let r:RowWord=fact_index_get_raw(idx[0].difference_value.ptr idx[0].difference_value.length v)
    if r <? 0 {return -1}
    idx[0].difference_record.ptr[r * FACT_RECORD]
}
fact_incident_scan=(s:FactState v:RowWord):>int64=>$unsafe {
    let count:RowWord=0
    let diffs=s.differences.ptr
    let n:RowWord=s.differences.length
    loop i in [0..n) {
        if diffs[i].a =? v {count += 1}
        if diffs[i].b =? v {count += 1}
    }
    if count =? 0 {-1} else {count}
}
fact_incident=(s:FactState v:RowWord):>int64=>$unsafe {
    if ((RowWord(s.diff_a_mask) | RowWord(s.diff_b_mask)) & (RowWord(1) << (v & 63))) =? 0 {return -1}
    let idx=s.index.ptr
    if idx[0].difference_next.length =? 0 {return fact_incident_scan(s v)}
    fact_incident_indexed(idx v)
}
# The first row from v (direction 0: rows by b; 1: rows by a), or -1.
fact_difference_head=(s:FactState v:RowWord direction:RowWord):>int64=>$unsafe {
    let m:RowWord=if direction =? 0 {s.diff_b_mask} else {s.diff_a_mask}
    if (m & (RowWord(1) << (v & 63))) =? 0 {return -1}
    let idx=s.index.ptr
    if idx[0].difference_next.length =? 0 {
        let diffs=s.differences.ptr
        let n:RowWord=s.differences.length
        if direction =? 0 {
            loop i in [0..n) {if diffs[i].b =? v {return i}}
        } else {
            loop i in [0..n) {if diffs[i].a =? v {return i}}
        }
        return -1
    }
    let r:RowWord=fact_index_get_raw(idx[0].difference_value.ptr idx[0].difference_value.length v)
    if r <? 0 {return -1}
    idx[0].difference_record.ptr[r * FACT_RECORD + 1 + direction * 2]
}
# The row after ri from the same value in the same direction, or -1.
fact_difference_next=(s:FactState ri:RowWord direction:RowWord):>int64=>$unsafe {
    let idx=s.index.ptr
    if idx[0].difference_next.length not=? 0 {return idx[0].difference_next.ptr[ri * 2 + direction]}
    let diffs=s.differences.ptr
    let n:RowWord=s.differences.length
    if direction =? 0 {
        let v:RowWord=diffs[ri].b
        loop i in [ri + 1..n) {if diffs[i].b =? v {return i}}
    } else {
        let v:RowWord=diffs[ri].a
        loop i in [ri + 1..n) {if diffs[i].a =? v {return i}}
    }
    -1
}
fact_row_scan=(s:FactState v:RowWord direction:RowWord start:RowWord):>int64=>$unsafe {
    let diffs=s.differences.ptr
    let n:RowWord=s.differences.length
    if direction =? 0 {
        loop i in [start..n) {
            if diffs[i].b =? v {return i}
        }
    } else {
        loop i in [start..n) {
            if diffs[i].a =? v {return i}
        }
    }
    -1
}

from p"facts_values.dewy" import (fact_pair_key)

$runtime_checks

from p"@lib/core/str.jo" import (starts_with)
from p"ast.jo" import (nodes)
from p"check.jo" import (LF_PARAM LF_VALUEPARAM ctxs cx fns locals)
from p"directives.jo" import (DIR_PROTOTYPE DIR_RUNTIME DIR_STATIC DirScope dir_code_any dir_code_by_inst dir_code_context_keys dir_code_files dir_code_masks dir_code_memo dir_code_memo_f dir_code_memo_size dir_code_names dir_code_origins dir_code_owner dir_code_runtime_keys dir_code_seen dir_code_slot dir_code_trap_off dir_code_warnings dir_find dir_module_start dir_name_assumed_bounds dir_name_cancellation dir_name_confine dir_name_copies dir_name_deadlocks dir_name_fast_math dir_name_local_asserts dir_name_no_inf dir_name_no_nan dir_name_prototype dir_name_row dir_name_runtime dir_name_warnings dir_row_scopes dir_scopes dir_value)
from p"facts.jo" import (fact_owner fact_retry_owner)
from p"frontend.jo" import (source_force_body)
from p"util.jo" import (files name_of pos_file pos_in_lib)
from p"source_warnings.dewy" import (warn)

# Code vectors: twelve tristates (two bits a slot) and the trap-priority bit. Slots, keys and
# positions are words, as the frozen twin's were.
CodeWord:type=int64<overflow='wrap'>
const __CODE_PRIORITY = 1 << 24
const __CODE_PRESENT = 1 << 25
dir_code_mask=(file:CodeWord):>int64=>{
    if file <? 0 or file >=? dir_code_masks.length {return 0}
    dir_code_masks[file]
}
dir_code_note=(s:DirScope):>void=>{
    dir_code_init()
    let slot=dir_code_slot(s.setting)
    if slot <? 0 {return}
    dir_code_seen=dir_code_seen | (CodeWord(1) << slot)
    # (a module's code vector: only from a scope below its header, or a float policy)
    if not pos_in_lib(s.start) and (s.start not=? dir_module_start(pos_file(s.start)) or s.setting =? dir_name_fast_math or s.setting =? dir_name_no_nan or s.setting =? dir_name_no_inf) {
        dir_code_any=true
        let file=CodeWord(pos_file(s.start))
        if file >=? dir_code_masks.length {dir_code_masks.resize(file + 1)}
        dir_code_masks[file]=dir_code_masks[file] | (CodeWord(1) << slot)
        dir_code_files[file]=dir_code_masks[file]
    }
    if slot <? 2 and s.value not=? 1 {
        let file=pos_file(s.start)
        if s.start not=? dir_module_start(file) or pos_file(s.end) not=? file {dir_code_trap_off=true}
    }
}
dir_code_reset=():>void=>{
    dir_code_masks=[]
    dir_code_seen=0
    dir_code_trap_off=false
    dir_code_memo_f=-1
    dir_code_memo_size=-1
    dir_code_memo=0
}
# The trap policy a vector and the innermost runtime (r) and prototype (q)
# scopes give at p: dir_policy's order of rules, scopes below the header
# winning over the vector; -1 when none applies (the positional default).
dir_code_policy=(code:CodeWord r:CodeWord q:CodeWord p:CodeWord):>int64=>{
    let rv=(code & 3) - 1
    let qv=((code >> 2) & 3) - 1
    let priority=(code & __CODE_PRIORITY) not=? 0
    if dir_scopes.length =? 0 {rv=-1}
    if dir_scopes.length =? 0 {qv=-1}
    let start=dir_module_start(pos_file(p))
    let local_r=r >=? 0 and dir_scopes[r].start not=? start
    let local_q=q >=? 0 and dir_scopes[q].start not=? start
    if local_r {rv=dir_scopes[r].value}
    if local_q {qv=dir_scopes[q].value}
    if local_r or local_q {priority=local_q and (not local_r or dir_scopes[q].start >=? dir_scopes[r].start)}
    dir_trap_rules(rv qv priority)
}
dir_trap_rules=(rv:CodeWord qv:CodeWord priority:bool):>int64=>{
    if qv =? 1 and (rv =? -1 or priority) {return DIR_PROTOTYPE}
    if rv =? 1 {return DIR_RUNTIME}
    if rv =? 0 {return DIR_STATIC}
    if qv =? 1 {return DIR_PROTOTYPE}
    -1
}
# Whether no position can be static under the current vector: it decides a
# runtime or prototype policy and every scope that could override it keeps
# checks on. O(1).
dir_code_never_static=():>bool=>{
    if not dir_code_any or dir_code_trap_off or dir_code_by_inst.length =? 0 {return false}
    let code=CodeWord(dir_code_current())
    if code =? 0 {return false}
    let policy=dir_trap_rules((code & 3) - 1 ((code >> 2) & 3) - 1 (code & __CODE_PRIORITY) not=? 0)
    policy =? DIR_RUNTIME or policy =? DIR_PROTOTYPE
}
dir_code_init=():>void=>{
    if dir_code_names.length not=? 0 {return}
    dir_code_names=[dir_name_runtime dir_name_prototype dir_name_warnings dir_name_copies dir_name_fast_math dir_name_no_nan dir_name_no_inf dir_name_assumed_bounds dir_name_cancellation dir_name_confine dir_name_local_asserts dir_name_deadlocks]
}
# One remembered answer: policy queries ask about the same instance in runs.
# Entries are only added (each at its instance's creation), so the map's size
# tells whether the answer still holds. O(1) on a repeat, O(lambda depth) else.
dir_code_inst=(f:CodeWord):>int64=>{
    let size=CodeWord(dir_code_by_inst.length)
    if f =? dir_code_memo_f and size =? dir_code_memo_size {return dir_code_memo}
    let code:CodeWord=0
    let current=f
    loop current >? 0 and current <? fns.length {
        let found=dir_code_by_inst.get(current)
        if found not=? none {
            code=found
            break
        }
        let d=CodeWord(fns[current].decl)
        if d =? 0 or nodes[d].kind not=? 'lambda' {break}
        current=CodeWord(fns[current].made_in)
    }
    dir_code_memo_f=f
    dir_code_memo_size=size
    dir_code_memo=code
    code
}
dir_code_current=():>int64=>{
    if not dir_code_any {return 0}
    let size=CodeWord(dir_code_by_inst.length)
    if size =? 0 {return 0}
    let f=CodeWord(fact_owner)
    if f <=? 0 {f=fact_retry_owner}
    if f <=? 0 and cx >=? 0 {f=CodeWord(ctxs[cx].inst)}
    if f <=? 0 {f=dir_code_owner}
    if f =? dir_code_memo_f and size =? dir_code_memo_size {return dir_code_memo}
    dir_code_inst(f)
}
# -2 means no inherited vector; -1 is an explicit/default absent component.
dir_code_at=(setting:CodeWord):>int64=>{
    let code=CodeWord(dir_code_current())
    if code =? 0 {return -2}
    let slot=CodeWord(dir_code_slot(setting))
    if slot <? 0 {return -2}
    ((code >> (slot * 2)) & 3) - 1
}
dir_code_local=(setting:CodeWord at:CodeWord):>int64=>{
    let scope=CodeWord(dir_find(setting at))
    if scope >=? 0 and dir_scopes[scope].start not=? dir_module_start(pos_file(at)) {return scope}
    -1
}
dir_code_priority=(at:CodeWord):>bool=>{
    let r=CodeWord(dir_code_local(dir_name_runtime at))
    let q=CodeWord(dir_code_local(dir_name_prototype at))
    if r >=? 0 or q >=? 0 {
        if q <? 0 {return false}
        if r <? 0 {return true}
        return dir_scopes[q].start >=? dir_scopes[r].start
    }
    let code=CodeWord(dir_code_current())
    if code not=? 0 {return (code & __CODE_PRIORITY) not=? 0}
    true
}
# A bundle that supplied this function's fixed effect row also pins the
# code policies needed to honor that row, even when written in the file header.
dir_code_pin=(decl:CodeWord setting:CodeWord body:CodeWord):>int64=>{
    let own=CodeWord(dir_find(setting body))
    if own <? 0 {return -1}
    if dir_scopes[own].start not=? dir_module_start(pos_file(body)) {return own}
    let row=CodeWord(dir_row_scopes.get(decl) ?? -1)
    if row <? 0 and nodes[decl].sval not=? 0 {row=dir_find(dir_name_row body)}
    if row >=? 0 and dir_scopes[row].value >? 0 and dir_scopes[own].bundle not=? 0 and dir_scopes[own].bundle =? dir_scopes[row].bundle {return own}
    -1
}
dir_code_can_vary=(decl:CodeWord):>bool=>{
    let mask=CodeWord(dir_code_mask(pos_file(nodes[decl].pos)))
    if mask =? 0 or nodes[decl].b =? 0 {return false}
    # A required static body is itself the proof for runtime-only sharing;
    # preserve syntax only when a genuinely different body can be requested.
    if mask =? 1 {
        let body=nodes[CodeWord(nodes[decl].b)].pos
        let r=CodeWord(dir_find(dir_name_runtime body))
        let q=CodeWord(dir_find(dir_name_prototype body))
        if (r <? 0 or dir_scopes[r].value not=? 1) and (q <? 0 or dir_scopes[q].value not=? 1) {return false}
    }
    let bit:CodeWord=1
    loop i in [CodeWord(0)..CodeWord(dir_code_names.length)) {
        if (mask & bit) not=? 0 and dir_code_pin(decl dir_code_names[i] nodes[CodeWord(nodes[decl].b)].pos) <? 0 {return true}
        bit=bit << 1
    }
    false
}
dir_code_owner_inst=():>int64=>{
    let f=CodeWord(fact_owner)
    if f <=? 0 {f=fact_retry_owner}
    if f <=? 0 and cx >=? 0 {f=CodeWord(ctxs[cx].inst)}
    if f <=? 0 {f=dir_code_owner}
    f
}
dir_code_origin=(at:CodeWord):>int64=>{
    let f=CodeWord(dir_code_owner_inst())
    loop f >? 0 and f <? fns.length {
        let origin=dir_code_origins.get(f)
        if origin not=? none {return origin}
        let d=CodeWord(fns[f].decl)
        if d =? 0 or nodes[d].kind not=? 'lambda' {break}
        f=CodeWord(fns[f].made_in)
    }
    pos_file(at)
}
dir_code_context=(code:CodeWord origin:CodeWord foreign:bool=false):>int64=>{
    if code =? 0 and not foreign {return 0}
    let key=code | (origin << 32)
    let found=dir_code_context_keys.get(key)
    if found not=? none {return found}
    let id=CodeWord(dir_code_context_keys.length) + 1
    dir_code_context_keys[key]=id
    id
}
dir_code_generic=(decl:CodeWord at:CodeWord):>bool=>{
    if at <=? 0 or not files[pos_file(nodes[decl].pos)].is_dewy {return false}
    dir_code_current() not=? 0 or dir_code_mask(pos_file(at)) not=? 0
}
dir_code_uniform=(decl:CodeWord at:CodeWord):>bool=>$unsafe {
    let file=pos_file(nodes[decl].pos)
    if at <=? 0 {return true}
    if dir_code_current() not=? 0 {return false}
    if pos_file(at) not=? file {return dir_code_mask(pos_file(at)) =? 0}
    let mask=CodeWord(dir_code_mask(file))
    # (the slot's bit and the mask's rest, moved one slot a step: no shift by a variable)
    let rest=mask
    let bit:CodeWord=1
    loop i in [CodeWord(0)..CodeWord(dir_code_names.length)) {
        if rest =? 0 {break}
        if (mask & bit) not=? 0 and dir_code_local(dir_code_names.ptr[i] at) >=? 0 {return false}
        rest=rest >> 1
        bit=bit << 1
    }
    true
}
# (`mixed`: the caller has already found the call not uniform)
dir_code_request=(decl:CodeWord at:CodeWord generic:bool=false mixed:bool=false origin:CodeWord=-1):>int64=>$unsafe {
    if not dir_code_any or nodes[decl].b =? 0 or at <=? 0 {return 0}
    let file=CodeWord(pos_file(nodes[decl].pos))
    let source=if not generic and origin <? 0 CodeWord(dir_code_origin(at)) else origin
    if not generic and (source not=? file or dir_code_mask(file) =? 0) {return 0}
    # A generic closure passed as a value retains its declaration's vector.
    if nodes[decl].kind =? 'lambda' {return dir_code_inst(CodeWord(nodes[decl].aux))}
    if not mixed and dir_code_uniform(decl at) {return 0}
    let body=CodeWord(nodes[CodeWord(nodes[decl].b)].pos)
    let baseline:CodeWord=__CODE_PRESENT | __CODE_PRIORITY
    let result:CodeWord=__CODE_PRESENT
    let priority=dir_code_priority(at)
    let r=CodeWord(dir_code_pin(decl dir_name_runtime body))
    let q=CodeWord(dir_code_pin(decl dir_name_prototype body))
    if r >=? 0 or q >=? 0 {
        priority=q >=? 0
        if r >=? 0 and q >=? 0 {priority=dir_scopes.ptr[q].start >=? dir_scopes.ptr[r].start}
    }
    if priority {result=result | __CODE_PRIORITY}
    if r >=? 0 and q <? 0 {baseline=baseline & (__CODE_PRIORITY xor -1)}
    # (a setting no scope has set: -1 in the body, the caller's vector at the call)
    let current=CodeWord(dir_code_current())
    # (slot i's bit, its two-bit field and that field's unit, moved a slot each step)
    let bit:CodeWord=1
    let field:CodeWord=3
    let unit:CodeWord=1
    loop i in [CodeWord(0)..CodeWord(dir_code_names.length)) {
        if dir_code_seen & bit =? 0 {result=result | (current & field)} else {
            let setting=CodeWord(dir_code_names.ptr[i])
            let own=CodeWord(dir_find(setting body))
            let value:CodeWord=-1
            if own >=? 0 {value=dir_scopes.ptr[own].value}
            if value <? -1 {value=-1}  # runtime fast-math has identical current backends
            baseline=baseline | ((value + 1) * unit)
            if dir_code_pin(decl setting body) <? 0 {value=dir_value(setting at)}
            if value <? -1 {value=-1}
            result=result | ((value + 1) * unit)
        }
        bit=bit << 1
        field=field << 2
        unit=unit << 2
    }
    # Priority matters only when both trap policies are enabled. Canonicalize
    # irrelevant bits so an unchanged policy never creates another body.
    if result & 15 not=? 10 {result=result & (__CODE_PRIORITY xor -1)}
    if baseline & 15 not=? 10 {baseline=baseline & (__CODE_PRIORITY xor -1)}
    if result =? baseline {return 0}
    # A required static instance proves every unpinned obligation. Enabling
    # runtime checks cannot change that body or any of its proven callees.
    if (result & (CodeWord(3) xor -1)) =? (baseline & (CodeWord(3) xor -1)) and (result & 3) =? 2 and (baseline & 12) not=? 8 {dir_code_runtime_keys[decl]=result}
    result
}
# Concrete foreign numerics keep their declared policy; report each call once.
# (the cheapest of its pure tests first; `origin` when the caller has it)
dir_code_foreign_warn=(decl:CodeWord at:CodeWord origin:CodeWord=-1):>void=>{
    if at <=? 0 {return}
    let file=CodeWord(pos_file(nodes[decl].pos))
    if not files[file].is_dewy or origin =? file {return}
    if pos_in_lib(at) or starts_with(name_of(CodeWord(nodes[decl].name)) "__") {return}
    let source=if origin <? 0 CodeWord(dir_code_origin(at)) else origin
    if source =? file or dir_code_warnings.has(at) {return}
    if dir_code_mask(pos_file(at)) =? 0 and dir_code_current() =? 0 {return}
    source_force_body(decl)
    if nodes[decl].b =? 0 or dir_code_seen & (CodeWord(7) << 4) =? 0 {return}
    let body=CodeWord(nodes[CodeWord(nodes[decl].b)].pos)
    loop slot in [CodeWord(4)..7) {
        let setting=CodeWord(dir_code_names[slot])
        let own=CodeWord(dir_find(setting body))
        let prior:CodeWord=-1
        if own >=? 0 {prior=dir_scopes[own].value}
        let requested=CodeWord(dir_value(setting at))
        if requested =? 1 and prior not=? 1 {
            dir_code_warnings[at]=true
            warn(at "`{name_of(CodeWord(nodes[decl].name))}` is not compiled under `${name_of(setting)}`. This call uses the library's numerics.")
            return
        }
    }
}
# A parameter's callable contract retains its declared code, while settings
# frames still flow through the call. The warning is per source call.
dir_code_parameter=(n:CodeWord callee:CodeWord):>void=>{
    if dir_code_seen & (CodeWord(7) << 4) =? 0 {return}
    let target=callee
    loop nodes[target].kind =? 'conv' {target=CodeWord(nodes[target].a)}
    if nodes[target].kind not=? 'ident' or nodes[target].aux not=? 1 {return}
    let local=CodeWord(nodes[target].sym)
    if CodeWord(locals[local].flags) & (LF_PARAM | LF_VALUEPARAM) =? 0 or dir_code_warnings.has(nodes[n].pos) {return}
    loop slot in [CodeWord(4)..7) {
        let setting=CodeWord(dir_code_names[slot])
        if dir_value(setting nodes[n].pos) not=? 1 {continue}
        dir_code_warnings[nodes[n].pos]=true
        warn(nodes[n].pos "`{name_of(CodeWord(locals[local].name))}` is a function parameter. This call's `${name_of(setting)}` does not apply to it; its declared code policy is retained.")
        return
    }
}
# Imported generic numerics are specialized, with one IEEE warning per target.
dir_code_generic_warn=(decl:CodeWord at:CodeWord):>void=>{
    if dir_code_seen & (CodeWord(7) << 4) =? 0 {return}
    if at <=? 0 or pos_in_lib(at) or dir_code_origin(at) =? pos_file(nodes[decl].pos) {return}
    let key=-decl - 1
    if dir_code_warnings.has(key) or nodes[decl].b =? 0 {return}
    let body=CodeWord(nodes[CodeWord(nodes[decl].b)].pos)
    loop slot in [CodeWord(4)..7) {
        let setting=CodeWord(dir_code_names[slot])
        if dir_value(setting at) not=? 1 or dir_code_pin(decl setting body) >=? 0 {continue}
        dir_code_warnings[key]=true
        warn(at "`{name_of(CodeWord(nodes[decl].name))}` is compiled under this call's `${name_of(setting)}`. It is a generic from another module and may rely on IEEE. Pin it with `${name_of(setting)} = false` at the top of its body.")
        return
    }
}

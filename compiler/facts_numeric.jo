# A symbolic value scaled by a constant again (`xs.length*3`, `2*i`, in either
# order): the same product, as a comprehension's length is, so a guard on one
# evaluation (`loop 2*i+1 <? n`) bounds the next. O(values), this shape only.
fact_scaled_again = (s: FactState, a: int, b: int, x: FactBound, y: FactBound) -> int:
    if (x.lo == x.hi) == (y.lo == y.hi): return 0
    v = if x.lo != x.hi: a else: b
    c = if x.lo != x.hi: y.lo else: x.lo
    if v == 0: return 0
    loop i in [0..s.ids.len()):
        t = fact_terms[s.ids[i]]
        if t.op != .star or t.a != v and t.b != v: continue
        other = if t.a == v: t.b else: t.a
        if other == 0 or other == v or fact_slot(s, other) < 0: continue
        k = fact_bound(s, other)
        if k.lo == k.hi and k.lo == c and not k.wide: return s.ids[i]
    0
# An exact `int` product by a constant whose interval leaves the host word at
# one end: the end that fits stays, the other is open. O(1).
fact_scaled_open = (s: mut FactState, n: int, a: int, b: int, x: FactBound, y: FactBound) -> int:
    if (x.lo == x.hi) == (y.lo == y.hi) or x.wide or y.wide: return fact_unmodeled(s, n, .unsupported)
    v = if x.lo != x.hi: x else: y
    c = if x.lo != x.hi: y.lo else: x.lo
    if c == 0 or c == FACT_MIN: return fact_unmodeled(s, n, .unsupported)
    low_end = if c > 0: v.lo else: v.hi
    high_end = if c > 0: v.hi else: v.lo
    low_fits = not math_word_overflow(2, low_end, c)
    high_fits = not math_word_overflow(2, high_end, c)
    if low_fits == high_fits: return fact_unmodeled(s, n, .unsupported)
    lo = if low_fits: low_end * c else: FACT_MIN
    hi = if high_fits: high_end * c else: FACT_MAX
    value = fact_new(s, fact_open_bound(lo, hi, not low_fits, not high_fits), FactTerm(.star, a, b, n, ntype(n)))
    fact_scaled_quotient(s, n, value, a, b, x, y)
    value
# A constant product's rows. `c*g` where g lies below a floor quotient
# `d // c` by the same positive constant (`loop g in [0..d // c)`): c*q <= d,
# so g <= q + L gives c*g <= d + c*L, and `chars[4*g..4*g+4)` stays within
# `chars.length`. O(rows from g, at most 8); demanded only by a constant product.
fact_scaled_quotient = (s: mut FactState, n: int, value: int, a: int, b: int, x: FactBound, y: FactBound):
    if (x.lo == x.hi) == (y.lo == y.hi): return
    g = if x.lo != x.hi: a else: b
    c = if x.lo != x.hi: y.lo else: x.lo
    if g == 0 or c < 1: return
    # (a factor of at least one moves a signed value away from zero: `2*i`
    # of i >= 0 is at least i, so `2*i+1 <? n` bounds i too)
    if c > 1:
        sign = if x.lo != x.hi: x else: y
        if sign.lo >= 0: fact_difference(s, g, value, 0, n)
        else if sign.hi <= 0: fact_difference(s, value, g, 0, n)
    ri = fact_difference_head(s, g, 1)
    seen = 0
    found: FactDifference[]
    loop ri >= 0 and seen < 8:
        row = s.differences[ri]
        ri = fact_difference_next(s, ri, 1)
        seen += 1
        if row.a != g or row.limit == FACT_MIN or math_word_overflow(2, row.limit, c): continue
        if fact_quotient_divisor(s, row.b) != c: continue
        found.push(FactDifference(value, fact_terms[row.b].a, row.limit * c, n))
    loop row in found: fact_difference(s, row.a, row.b, row.limit, row.at)
# An `int` sum or product of two values with real ends has real ends too: at
# a MIN/MAX endpoint it is an int64 value, as fact_hull_type types a hull.
# Only an endpoint at MIN/MAX needs the check (fact_host_finite's rows).
fact_word_type = (s: FactState, n: int, a: int, b: int, lo: int, hi: int) -> int:
    t = ntype(n)
    if lo != FACT_MIN and hi != FACT_MAX or fact_type(t) != T_MATH_INT: return t
    if fact_host_finite(s, a) and fact_host_finite(s, b): return T_INT
    t
# A product with an open (infinite) `int` end: the endpoint products, an
# infinite factor times a nonzero finite one infinite with their sign, times
# 0 zero. O(1).
fact_open_product = (s: mut FactState, n: int, a: int, b: int, x: FactBound, y: FactBound, xlo_open: bool, xhi_open: bool, ylo_open: bool, yhi_open: bool) -> int:
    lo = FACT_MAX; hi = FACT_MIN
    below = false; above = false
    loop i in [0..4):
        p = if i < 2: x.lo else: x.hi
        q = if i % 2 == 0: y.lo else: y.hi
        # (signs: -1/+1 for an infinite end, 0 for a finite one)
        pe = if i < 2: (if xlo_open: -1 else: 0) else: (if xhi_open: 1 else: 0)
        qe = if i % 2 == 0: (if ylo_open: -1 else: 0) else: (if yhi_open: 1 else: 0)
        if pe == 0 and qe == 0:
            if math_word_overflow(2, p, q): return fact_unmodeled(s, n, .unsupported)
            lo = min(lo, p * q); hi = max(hi, p * q)
            continue
        sign = 0
        if pe != 0 and qe != 0: sign = pe * qe
        else if pe != 0: sign = if q > 0: pe else if q < 0: -pe else: 0
        else: sign = if p > 0: qe else if p < 0: -qe else: 0
        if sign > 0: above = true
        else if sign < 0: below = true
        else: lo = min(lo, 0); hi = max(hi, 0)
    if below: lo = FACT_MIN
    if above: hi = FACT_MAX
    if lo > hi: return fact_unmodeled(s, n, .unsupported)
    # (the same product again, `r*w` in a guard and in the index it guards:
    # one value. O(values))
    if a != 0 and b != 0:
        loop i in [0..s.ids.len()):
            t = fact_terms[s.ids[i]]
            if t.op == .star and t.type == ntype(n) and (t.a == a and t.b == b or t.a == b and t.b == a):
                fact_reuse_tighten(s, s.ids[i], lo, hi, not below, not above)
                return s.ids[i]
    fact_new(s, fact_open_bound(lo, hi, below, above), FactTerm(.star, a, b, n, ntype(n)))
# A named sum or product evaluated again keeps the bounds its guards gave it,
# and takes any real end its operands now have: both hold for the one value.
fact_reuse_tighten = (s: mut FactState, v: int, lo: int, hi: int, lo_real: bool, hi_real: bool):
    b = fact_bound(s, v)
    if b.wide: return
    nlo = if lo_real and lo > b.lo: lo else: b.lo
    nhi = if hi_real and hi < b.hi: hi else: b.hi
    if nlo == b.lo and nhi == b.hi: return
    b.lo = nlo
    b.hi = nhi
    b.nz = b.nz or nlo > 0 or nhi < 0
    fact_set_bound(s, v, b)
# An interval with an open end; collapsed onto that end, it is only "at least
# MAX" (or "at most MIN"): wide, as fact_set_bound keeps such a value.
fact_open_bound = (lo: int, hi: int, below: bool, above: bool) -> FactBound:
    r = FactBound(lo, hi, lo > 0 or hi < 0)
    if lo == hi and (above and hi == FACT_MAX or below and lo == FACT_MIN):
        r.wide = true
        r.nz = true
    r
# A value x with x - a = c exactly (rows both ways), or 0.
fact_offset_value = (s: FactState, a: int, c: int) -> int:
    if c == FACT_MIN: return 0
    ri = fact_difference_head(s, a, 0)
    loop ri >= 0:
        row = s.differences[ri]
        ri = fact_difference_next(s, ri, 0)
        if row.limit != c or row.a == a: continue
        back = fact_row_find(s, a, row.a)
        if back >= 0 and s.differences[back].limit == -c: return row.a
    0
fact_divisor = (s: mut FactState, n: int, a: int, b: int, modulo: bool) -> bool:
    operand = if nodes[n].kind == .call: kid(n, 1) else: int(nodes[n].b)
    # (an exact rational is zero when its numerator is: expr.jo rational_divisor)
    t = representation_type(ntype(operand))
    if types[t].kind == .struct_:
        numerator = fact_project(s, b, intern("numerator"), false, T_MATH_INT)
        nothing = fact_constant(s, 0)
        truth = fact_compare(s, .ne, numerator, nothing)
        if truth != 1: wit_divisor(n, s, numerator, nothing, operand, truth == 0)
        return truth == 1
    zero = fact_constant(s, ref_encoded(0, ntype(operand)))
    truth = fact_compare(s, .ne, b, zero)
    if truth != 1: wit_divisor(n, s, b, zero, operand, truth == 0)
    truth == 1
# Call only after excluding zero and MIN / -1. Jo divides toward zero;
# Dewy's floor quotient rounds downward when the signs differ. O(1).
fact_quotient = (a: int, b: int, floor: bool) -> int:
    q = a / b
    if floor and (a < 0) != (b < 0) and a % b != 0: q -= 1
    q
# Divide one exact sum/difference without clipping its 65-bit endpoints.
# a = q*d+r, 0 <= r < d: combine quotients and a remainder carry. No wide
# arithmetic in the compiler, no syntax re-evaluation. Demand-driven O(1)
# plus the bounded, indexed endpoint queries; arbitrary wide inputs decline.
fact_sum_quotient_endpoint = (a: int, b: int, d: int, subtract: bool) -> (bool, int):
    qa = fact_quotient(a, d, true)
    qb = fact_quotient(b, d, true)
    ra = a % d; rb = b % d
    if ra < 0: ra += d
    if rb < 0: rb += d
    carry = if subtract: (if ra < rb: -1 else: 0) else: int(ra >= d - rb)
    if subtract: qb = -qb
    if not fact_add_fits(qa, qb): return (false, 0)
    q = qa + qb
    if not fact_add_fits(q, carry): return (false, 0)
    (true, q + carry)
fact_sum_quotient = (s: mut FactState, n: int, a: int, d: int) -> int:
    if a == 0 or d < 2: return 0
    term = fact_terms[a]
    if term.op != .plus and term.op != .minus or term.a == 0 or term.b == 0: return 0
    if not fact_host_endpoint(s, term.a, false) or not fact_host_endpoint(s, term.a, true) or not fact_host_endpoint(s, term.b, false) or not fact_host_endpoint(s, term.b, true): return 0
    x = fact_bound(s, term.a); y = fact_bound(s, term.b)
    subtract = term.op == .minus
    low = fact_sum_quotient_endpoint(x.lo, (if subtract: y.hi else: y.lo), d, subtract)
    high = fact_sum_quotient_endpoint(x.hi, (if subtract: y.lo else: y.hi), d, subtract)
    if not low.0 or not high.0: return 0
    # Endpoint arithmetic above certified real host endpoints, including MIN/MAX.
    t = if fact_type(ntype(n)) == T_MATH_INT: T_INT else: ntype(n)
    v = fact_new(s, FactBound(low.1, high.1, low.1 > 0 or high.1 < 0), FactTerm(type = t))
    if d == 2 and not subtract: fact_midpoint(s, n, v, a)
    v
# Integer `//` and `%` by a nonzero divisor (kind 1, 2), or by a power of two
# as a shift count or mask (3, 4). Dewy's remainder has the divisor's sign, so
# `x % n` lies in [0, n) for positive n; the truncating form agrees when the
# dividend is nonnegative. A nonnegative dividend bounds both results, and
# halving a positive one makes it smaller.
fact_floor = (s: mut FactState, n: int, kind: int, a: int, b: int, floor: bool) -> int:
    x = fact_bound(s, a); y = fact_bound(s, b)
    if x.wide and not y.wide and kind == 1 and floor and y.lo == y.hi:
        divided = fact_sum_quotient(s, n, a, y.lo)
        if divided != 0: return divided
    # A clipped host endpoint is not an upper bound on a wide intermediate.
    # Only floor remainder/masking can discard that unknown extent using the
    # finite divisor alone. Division and right shift must retain it.
    if y.wide or x.wide and (kind == 1 or kind == 3 or not floor): return fact_unmodeled(s, n, .unsupported)
    if x.lo < 1: x.lo = max(x.lo, fact_relational(s, a, false))
    # Shrinking an unbounded mathematical value does not make it a word.
    # Endpoint sentinels must not become finite merely by division/shift.
    if (kind == 1 or kind == 3) and (not fact_host_endpoint(s, a, false) or not fact_host_endpoint(s, a, true)): return fact_unmodeled(s, n, .unsupported)
    # (a shift count stays below the word; a mask is any nonnegative value)
    if kind == 3 or kind == 4:
        if y.lo < 0 or kind == 3 and y.hi > 62: return fact_unmodeled(s, n, .unsupported)
    else if kind == 1 and y.hi < 0:
        # The four corners bound division on a strictly negative denominator
        # interval. MIN / -1 is outside the host domain: decline, never wrap.
        if not fact_host_endpoint(s, b, false): return fact_unmodeled(s, n, .unsupported)
        if x.lo == FACT_MIN and y.hi == -1: return fact_unmodeled(s, n, .unsupported)
        ll = fact_quotient(x.lo, y.lo, floor)
        lh = fact_quotient(x.lo, y.hi, floor)
        hl = fact_quotient(x.hi, y.lo, floor)
        hh = fact_quotient(x.hi, y.hi, floor)
        low = min(min(ll, lh), min(hl, hh))
        high = max(max(ll, lh), max(hl, hh))
        return fact_new(s, FactBound(low, high, low > 0 or high < 0), FactTerm(type = ntype(n)))
    else if kind == 2 and floor and y.hi < 0:
        # Floor remainder has its divisor's sign, including for a wide
        # dividend: d < x % d <= 0. No negation of MIN is needed. O(1).
        if not fact_host_endpoint(s, b, false): return fact_unmodeled(s, n, .unsupported)
        return fact_new(s, FactBound(y.lo + 1, 0), FactTerm(.eof, a, b, n, ntype(n)))
    else if y.lo < 1: return fact_unmodeled(s, n, .unsupported)
    # (an open divisor end is infinite, not 2^63-1: a quotient by it tends to 0)
    y_open = y.hi == FACT_MAX and fact_open_endpoint(s, b, true)
    if x.lo < 0 and kind == 1 and not x.wide and not y.wide:
        low = x.lo / y.lo
        if floor and x.lo % y.lo != 0: low -= 1
        divisor = if x.hi < 0: y.hi else: y.lo
        high = x.hi / divisor
        if floor and x.hi < 0 and x.hi % divisor != 0: high -= 1
        if x.hi < 0 and y_open: high = if floor: -1 else: 0
        return fact_new(s, FactBound(low, high, low > 0 or high < 0), FactTerm(type = ntype(n)))
    if x.lo < 0 and (not floor or kind == 1 or kind == 3): return fact_unmodeled(s, n, .unsupported)
    r = FactBound()
    if kind == 2 or kind == 4:
        r.lo = 0
        r.hi = if kind == 2 and fact_host_endpoint(s, b, true): y.hi - 1 else: y.hi
        if x.lo >= 0 and not x.wide: r.hi = min(r.hi, x.hi)
    else if kind == 1:
        r.lo = if y_open: 0 else: x.lo / y.hi
        r.hi = x.hi / y.lo
    else:
        r.lo = x.lo >> y.hi
        r.hi = x.hi >> y.lo
    v = fact_new(s, r, FactTerm(.eof, a, b, n, ntype(n)))
    fact_set_bound(s, v, r)
    if kind == 2: fact_difference(s, v, b, -1, n)
    if kind == 4: fact_difference(s, v, b, 0, n)
    smaller = kind == 1 and x.lo >= 1 and y.lo >= 2 or kind == 3 and x.lo >= 1 and y.lo >= 1
    if x.lo >= 0:
        distance = if kind == 1: x.lo / y.lo - x.lo else if kind == 3: (x.lo >> y.lo) - x.lo else if smaller: -1 else: 0
        fact_difference(s, v, a, distance, n)
    if (kind == 1 and y.lo == 2 or kind == 3 and y.lo == 1) and y.lo == y.hi and (floor or x.lo >= 0): fact_midpoint(s, n, v, a)
    v
# The constant positive divisor of a floor quotient value (`d // c`, Dewy's
# `__floor_div` or its power-of-two shift, or a nonnegative dividend's
# truncating `/`), else 0: c*q <= d. O(1).
fact_quotient_divisor = (s: FactState, q: int) -> int:
    t = fact_terms[q]
    if t.op != .eof or t.a == 0 or t.b == 0 or t.origin <= 0 or t.origin >= nodes.len(): return 0
    if fact_slot(s, t.a) < 0 or fact_slot(s, t.b) < 0: return 0
    k = fact_bound(s, t.b)
    if k.lo != k.hi or k.wide: return 0
    o = t.origin
    kind = 0
    if nodes[o].kind == .binary and nodes[o].op == i32(int(Tok.slash)):
        # (truncating division rounds a negative dividend up)
        if not files[pos_file(nodes[o].pos)].is_dewy and fact_bound(s, t.a).lo < 0: return 0
        kind = 1
    else if nodes[o].kind == .call: kind = fact_floor_call(o)
    if kind == 1: return if k.lo >= 1: k.lo else: 0
    if kind == 3: return if k.lo >= 0 and k.lo <= 62: 1 << k.lo else: 0
    0
# A floor midpoint `(lo + hi) // 2` of two related values lies between them:
# with lo - hi <= L (L <= 0), lo + floor(-L/2) <= mid <= hi + floor(L/2), so
# `lo <? hi` gives `lo <=? mid <? hi` (a binary search's probe). O(1) row lookups.
fact_midpoint = (s: mut FactState, n: int, v: int, sum: int):
    t = fact_terms[sum]
    if t.op != .plus or t.a == 0 or t.b == 0 or t.a == t.b: return
    loop side in [0..2):
        p = if side == 0: t.a else: t.b
        q = if side == 0: t.b else: t.a
        r = fact_row_find(s, p, q)
        if r < 0: continue
        limit = s.differences[r].limit
        if limit > 0 or limit == FACT_MIN: continue
        # (floor(L/2) for L <= 0, and -floor(-L/2) = ceil(L/2))
        down = if limit % 2 == 0: limit / 2 else: (limit - 1) / 2
        up = limit / 2
        fact_difference(s, v, q, down, n)
        fact_difference(s, p, v, up, n)
# uint64's forms on its order-preserving encoding (value xor MIN, so rows and
# comparisons between two uint64 values read as unsigned): every result is at
# most the dividend, `x % n` lies in [0, n) and a mask bounds `x & m`.
fact_floor_unsigned = (s: mut FactState, n: int, kind: int, a: int, b: int) -> int:
    x = fact_bound(s, a); y = fact_bound(s, b)
    if x.wide or y.wide: return fact_unmodeled(s, n, .unsupported)
    if (kind == 1 or kind == 2) and y.lo == FACT_MIN: return fact_unmodeled(s, n, .unsupported)
    if kind == 3 and (y.lo < 0 or y.hi > 63): return fact_unmodeled(s, n, .unsupported)
    r = FactBound(FACT_MIN, x.hi)
    if kind == 2: r.hi = min(x.hi, y.hi - 1)
    else if kind == 4: r.hi = min(x.hi, y.hi)
    else if kind == 1:
        r.lo = int(u64(x.lo xor FACT_MIN) / u64(y.hi xor FACT_MIN)) xor FACT_MIN
        r.hi = int(u64(x.hi xor FACT_MIN) / u64(y.lo xor FACT_MIN)) xor FACT_MIN
    else:
        r.lo = int(u64(x.lo xor FACT_MIN) >> u64(y.hi)) xor FACT_MIN
        r.hi = int(u64(x.hi xor FACT_MIN) >> u64(y.lo)) xor FACT_MIN
    v = fact_new(s, r, FactTerm(.eof, a, b, n, T_U64))
    if kind == 2: fact_difference(s, v, b, -1, n)
    if kind == 4: fact_difference(s, v, b, 0, n)
    fact_difference(s, v, a, 0, n)
    v
# Bit operations on nonnegative operands, one interval step each: a mask
# bounds `x & m` by m, `|` and `xor` stay below the next power of two of the
# larger operand, `>>` shrinks and `<<` grows within the result type (else a
# possible wrap). uint64 operands use the order-preserving encoding (value xor
# MIN); arithmetic bounds are converted before shifting or combining bits.
fact_bitwise = (s: mut FactState, n: int, op: Tok, a: int, b: int) -> int:
    x = fact_bound(s, a); y = fact_bound(s, b)
    # Shift counts use their numerical magnitude even when stored as uint64.
    # Decode the interval engine's order-preserving unsigned coordinates only
    # when both endpoints fit a nonnegative signed word.
    if (op == .shl or op == .shr) and b != 0 and fact_type(fact_terms[b].type) == T_U64:
        if y.wide or y.hi >= 0: return fact_unmodeled(s, n, .unsupported)
        y.lo = y.lo xor FACT_MIN
        y.hi = y.hi xor FACT_MIN
    # An exact sum/difference may need 65 bits before a right shift. Reuse
    # the checked quotient endpoints rather than clipping it to a host word.
    # Demand-only O(1) plus the existing indexed endpoint queries.
    if op == .shr and x.wide and not y.wide and y.lo == y.hi and y.lo >= 1 and y.lo <= 62 and fact_type(ntype(n)) != T_U64:
        divided = fact_sum_quotient(s, n, a, 1 << y.lo)
        if divided != 0: return divided
    # A finite nonnegative mask bounds even an arbitrarily wide exact operand.
    # Do not discard this proof just because the other side exceeded a word.
    if op == .amp and (x.wide or y.wide) and fact_type(ntype(n)) != T_U64:
        if not x.wide and x.lo >= 0 or not y.wide and y.lo >= 0:
            hi = if not x.wide and x.lo >= 0 and not y.wide and y.lo >= 0: min(x.hi, y.hi) else if not x.wide and x.lo >= 0: x.hi else: y.hi
            return fact_new(s, FactBound(0, hi), FactTerm(.eof, a, b, n, ntype(n)))
    if x.wide or y.wide: return fact_unmodeled(s, n, .unsupported)
    r = FactBound()
    if fact_type(ntype(n)) == T_U64:
        if fact_type(ntype(int(nodes[n].a))) != T_U64: return fact_unmodeled(s, n, .unsupported)
        if op == .amp and fact_type(ntype(int(nodes[n].b))) == T_U64:
            r = FactBound(FACT_MIN, min(x.hi, y.hi))
        else if (op == .pipe or op == .caret) and fact_type(ntype(int(nodes[n].b))) == T_U64:
            top = max(u64(x.hi xor FACT_MIN), u64(y.hi xor FACT_MIN))
            mask: u64 = 0
            loop mask < top: mask = (mask << 1) | 1
            low = if op == .pipe: max(x.lo, y.lo) else: FACT_MIN
            r = FactBound(low, int(mask) xor FACT_MIN)
        else if op == .shr and y.lo >= 0 and y.hi <= 63:
            r = FactBound(int(u64(x.lo xor FACT_MIN) >> u64(y.hi)) xor FACT_MIN, int(u64(x.hi xor FACT_MIN) >> u64(y.lo)) xor FACT_MIN)
        else if op == .shl and y.lo >= 0 and y.hi <= 63:
            high = u64(x.hi xor FACT_MIN)
            if high > (u64(18446744073709551615) >> u64(y.hi)): return fact_unmodeled(s, n, .unsupported)
            r = FactBound(int(u64(x.lo xor FACT_MIN) << u64(y.lo)) xor FACT_MIN, int(high << u64(y.hi)) xor FACT_MIN)
        else: return fact_unmodeled(s, n, .unsupported)
        return fact_new(s, r, FactTerm(.eof, a, b, n, T_U64))
    if op == .amp and (x.lo >= 0 or y.lo >= 0):
        r.lo = 0
        r.hi = if x.lo >= 0 and y.lo >= 0: min(x.hi, y.hi) else if x.lo >= 0: x.hi else: y.hi
    else if (op == .pipe or op == .caret) and x.lo >= 0 and y.lo >= 0:
        top = max(x.hi, y.hi)
        mask = 0
        loop mask < top: mask = (mask << 1) | 1
        r.lo = if op == .pipe: max(x.lo, y.lo) else: 0
        r.hi = mask
        # (an open `int` end makes no mask: `n | MAX` is at least MAX, not MAX)
        if x.hi == FACT_MAX and fact_open_endpoint(s, a, true) or y.hi == FACT_MAX and fact_open_endpoint(s, b, true):
            r = fact_open_bound(r.lo, FACT_MAX, false, true)
    else if (op == .amp or op == .pipe or op == .caret) and fact_host_finite(s, a) and fact_host_finite(s, b):
        # Finite signed operands have a common sign-extension width. Boolean
        # bit operations cannot introduce a bit beyond it. Retain their possible
        # signs separately, including negative AND and opposite-sign XOR.
        # Demand-only O(word bits); no new facts or expression traversal.
        top = max(max(x.hi, -1 - x.lo), max(y.hi, -1 - y.lo))
        mask = 0
        loop mask < top: mask = (mask << 1) | 1
        negative = if op == .amp: x.lo < 0 and y.lo < 0 else if op == .pipe: x.lo < 0 or y.lo < 0 else: x.lo < 0 and y.hi >= 0 or y.lo < 0 and x.hi >= 0
        positive = if op == .amp: x.hi >= 0 or y.hi >= 0 else if op == .pipe: x.hi >= 0 and y.hi >= 0 else: x.lo < 0 and y.lo < 0 or x.hi >= 0 and y.hi >= 0
        r.lo = if negative: -1 - mask else: 0
        r.hi = if positive: mask else: -1
        r.nz = r.lo > 0 or r.hi < 0
        # These endpoints are finite even at MIN/MAX; mathematical int must
        # not reinterpret the sign-extension envelope as unbounded.
        return fact_new(s, r, FactTerm(.eof, a, b, n, (if fact_type(ntype(n)) == T_MATH_INT: T_INT else: ntype(n))))
    else if op == .shr and y.lo >= 0 and y.hi <= 63:
        # Arithmetic right shift is monotone in x. For negative x increasing
        # the count raises the result; for nonnegative x it lowers it.
        # Mathematical int's endpoint sentinels are not finite bounds.
        if fact_type(ntype(int(nodes[n].a))) == T_MATH_INT and (not fact_host_endpoint(s, a, false) or not fact_host_endpoint(s, a, true)): return fact_unmodeled(s, n, .unsupported)
        r.lo = x.lo >> (if x.lo < 0: y.lo else: y.hi)
        r.hi = x.hi >> (if x.hi < 0: y.hi else: y.lo)
    else if op == .shl and x.lo >= 0 and y.lo >= 0 and y.hi <= 62:
        if x.hi > (FACT_MAX >> y.hi): return fact_unmodeled(s, n, .unsupported)
        r.lo = x.lo << y.lo
        r.hi = x.hi << y.hi
        if not exact_has_node(n) and not sa_fits(r.hi, ntype(n)): return fact_unmodeled(s, n, .unsupported)
    else: return fact_unmodeled(s, n, .unsupported)
    r.nz = r.lo > 0
    v = fact_new(s, r, FactTerm(.eof, a, b, n, ntype(n)))
    # (a row only where an interval cannot say it: a symbolic mask, as
    # `i & (n-1)`; constant masks and shifts are exact enough as intervals)
    if op == .amp and y.lo >= 0 and y.lo != y.hi: fact_difference(s, v, b, 0, n)
    if op == .amp and x.lo >= 0 and x.lo != x.hi and (y.lo < 0 or y.lo != y.hi): fact_difference(s, v, a, 0, n)
    v
fact_extremum_call = (n: int) -> bool:
    nkids(n) == 2 and fact_scalar(ntype(n)) and is_int(ntype(n)) and fact_type(ntype(n)) != T_U64 and (fact_prelude_call(n, "min") or fact_prelude_call(n, "max"))
# The prelude's integer `min(a b)` (or `max`): one of its operands, so its
# interval is theirs combined, and a row below (above) each operand. O(1).
fact_extremum = (s: mut FactState, n: int, a: int, b: int, lower: bool) -> int:
    x = fact_bound(s, a); y = fact_bound(s, b)
    r = if lower: FactBound(min(x.lo, y.lo), min(x.hi, y.hi)) else: FactBound(max(x.lo, y.lo), max(x.hi, y.hi))
    # A wide side uses MIN/MAX as infinity. Clamping can replace both with
    # finite endpoints, even when the clamped intermediate exceeded a word.
    r.wide = (x.wide or y.wide) and (r.lo == FACT_MIN or r.hi == FACT_MAX)
    r.nz = r.lo > 0 or r.hi < 0 or x.nz and y.nz
    # (an open `int` end stays open: `max(n MAX)` is at least MAX, not MAX)
    if not r.wide and r.lo == r.hi and (r.hi == FACT_MAX or r.lo == FACT_MIN):
        xo = fact_open_endpoint(s, a, r.hi == FACT_MAX) and (if r.hi == FACT_MAX: x.hi == FACT_MAX else: x.lo == FACT_MIN)
        yo = fact_open_endpoint(s, b, r.hi == FACT_MAX) and (if r.hi == FACT_MAX: y.hi == FACT_MAX else: y.lo == FACT_MIN)
        # (the extremum's own side takes either operand's open end; the other side needs both)
        own = lower == (r.lo == FACT_MIN)
        if own and (xo or yo) or not own and xo and yo:
            r.wide = true
            r.nz = true
    v = fact_new(s, r, FactTerm(.eof, a, b, n, fact_hull_type(ntype(n), s, a, s, b)))
    if lower:
        fact_difference(s, v, a, 0, n)
        fact_difference(s, v, b, 0, n)
    else:
        fact_difference(s, a, v, 0, n)
        fact_difference(s, b, v, 0, n)
    # The other side holds when both operands obey it. Use only existing
    # incident rows, no candidate pairs or syntax-specific clamp recognition.
    # O(incident rows x bounded entailment), on demanded min/max results only.
    loop operand in [a, b]:
        other = if operand == a: b else: a
        ri = fact_difference_head(s, operand, int(not lower))
        rows: FactDifference[]
        loop ri >= 0:
            rows.push(s.differences[ri])
            ri = fact_difference_next(s, ri, int(not lower))
        loop row in rows:
            peer = if lower: row.a else: row.b
            if peer == v: continue
            if row.limit != 0: continue
            if lower and fact_compare(s, .le, peer, other) == 1: fact_difference(s, peer, v, 0, n)
            else if not lower and fact_compare(s, .le, other, peer) == 1: fact_difference(s, v, peer, 0, n)
    v
fact_rational_zero_test = (n: int) -> int:
    if nodes[n].kind != .call or nodes[n].aux != 0 or nodes[n].sym <= 0 or nkids(n) != 2 or rational_constants.len() == 0: return -1
    d = int(fns[int(nodes[n].sym)].decl)
    if d == 0: return -1
    if fact_name_rational_eq == 0:
        fact_name_rational_eq = intern("__eq__")
        fact_name_rational_lt = intern("__lt__")
    if int(nodes[d].name) != fact_name_rational_eq and int(nodes[d].name) != fact_name_rational_lt or files[pos_file(nodes[d].pos)].path != lib_dir + "/rational.dewy": return -1
    loop i in [0..2):
        e = kid(n, i)
        loop nodes[e].kind == .conv: e = int(nodes[e].a)
        if let parts = rational_constants.get(e):
            if parts.0 == 0: return 1 - i
    -1
fact_rational_constructor = (n: int, count: int = 2) -> bool:
    if nodes[n].kind != .call or nodes[n].aux != 0 or nodes[n].sym <= 0 or nkids(n) != count: return false
    d = int(fns[int(nodes[n].sym)].decl)
    if d == 0: return false
    if fact_name_rational == 0: fact_name_rational = intern("rational")
    if int(nodes[d].name) != fact_name_rational: return false
    path = files[pos_file(nodes[d].pos)].path
    if path != lib_dir + "/prelude/fractions.dewy" and path != lib_dir + "/rational.dewy": return false
    t = fact_quantity_number(ntype(kid(n, count - 1)))
    is_int(t) or t == T_MATH_INT
fact_rational_divmod = (n: int) -> bool:
    if nodes[n].kind != .call or nodes[n].aux != 0 or nodes[n].sym <= 0 or nkids(n) != 2: return false
    d = int(fns[int(nodes[n].sym)].decl)
    if d == 0: return false
    if fact_name_divmod == 0: fact_name_divmod = intern("divmod")
    int(nodes[d].name) == fact_name_divmod and not pos_in_lib(nodes[n].pos) and files[pos_file(nodes[d].pos)].path == lib_dir + "/rational.dewy"
# (a quantity's number type, as lowering erases the unit; any other type's representation)
fact_quantity_number = (t0: int) -> int:
    t = prune(t0)
    if types[t].kind == .quantity: t = prune(int(types[t].elem))
    representation_type(t)
# `rational(a)` of an integer (an integer promoted, as `d/e` promotes e): its
# numerator is a. O(1).
fact_rational_promotion = (n: int) -> bool: nodes[n].kind == .call and nkids(n) == 1 and fact_rational_constructor(n, 1)
# The value of `rational(a b)` (a call that returned, so b is nonzero): its
# reduced numerator is a / gcd(a b) with b's sign folded in, so it is zero
# exactly when a is, and for b > 0 it keeps a's sign within a's interval. A
# constant pair is the reduced constant. Only a demanded constructor call (a
# divisor's, or its own denominator's) gets here. O(1).
fact_rational_made = (s: mut FactState, n: int, a: int, b: int) -> int:
    result = fact_new(s, FactBound(), FactTerm(type = ntype(n)))
    t = fact_quantity_number(ntype(kid(n, 0)))
    if not is_int(t) and t != T_MATH_INT or s.projections.len() + 2 >= FACT_CAP: return result
    x = fact_bound(s, a); y = fact_bound(s, b)
    numerator = 0
    if not x.wide and not y.wide and x.lo == x.hi and y.lo == y.hi and y.lo != 0 and x.lo != FACT_MIN and y.lo != FACT_MIN:
        parts = rational_constant_parts(x.lo, y.lo)
        numerator = fact_constant(s, parts.0)
    else:
        r = fact_domain(T_MATH_INT)
        if y.lo > 0 and not y.wide and not x.wide:
            if x.lo > 0: r = FactBound(1, x.hi, true)
            else if x.hi < 0: r = FactBound(x.lo, -1, true)
            else: r = FactBound(x.lo, x.hi, x.nz)
        else: r.nz = x.nz or x.lo > 0 or x.hi < 0
        numerator = fact_new(s, r, FactTerm(type = T_MATH_INT))
    fact_add_projection(s, FactProjection(result, intern("numerator"), false, numerator))
    result
fact_power_call = (n: int) -> bool:
    if nodes[n].kind != .call or nodes[n].aux != 0 or nodes[n].sym <= 0 or nkids(n) != 2: return false
    d = int(fns[int(nodes[n].sym)].decl)
    if d == 0: return false
    if fact_name_power == 0:
        fact_name_power = intern("__dewy_power")
        fact_name_pow = intern("pow")
        fact_name_pow_op = intern("__pow__")
    name = int(nodes[d].name)
    if name != fact_name_power and name != fact_name_pow and name != fact_name_pow_op: return false
    e = representation_type(ntype(kid(n, 1)))
    (is_int(e) or e == T_MATH_INT) and pos_in_lib(nodes[d].pos)
fact_power_check = (n: int, s: mut FactState, exponent: int, base: int):
    # (a rational base tested nonzero, `if q =? 0 return`, takes any exponent)
    if base != 0 and fact_power_rational(n):
        b = fact_bound(s, fact_project(s, base, intern("numerator"), false, T_MATH_INT))
        if b.nz or b.lo > 0 or b.hi < 0:
            if fact_speculating == 0 and fact_probe_on: fact_probe_record(n, true)
            return
    # (`if n <? 0 and q =? 0 return`: a case split on the base, whose zero
    # case the refuted conjunction gives a nonnegative exponent. One state
    # copy, only with an implication present: fact_either)
    if base != 0 and fact_power_rational(n) and fact_holds_implication(s):
        split = s
        numerator = fact_project(split, base, intern("numerator"), false, T_MATH_INT)
        nothing = fact_constant(split, 0)
        fact_assume(split, fact_new(split, fact_domain(T_BOOL), FactTerm(.eq, numerator, nothing)), true)
        result_activate(split)
        zero = fact_constant(split, 0)
        if not split.live or fact_compare(split, .ge, exponent, zero) == 1:
            if fact_speculating == 0 and fact_probe_on: fact_probe_record(n, true)
            return
    fact_nonnegative(n, s, exponent, kid(n, 1), "the exponent")
fact_holds_implication = (s: FactState) -> bool:
    loop evidence in s.conditional:
        if evidence.tag == -2: return true
    false
fact_power_rational = (n: int) -> bool:
    t = prune(representation_type(ntype(kid(n, 0))))
    if types[t].kind != .struct_: return false
    si = int(types[t].st)
    d = int(structs[si].decl)
    d != 0 and structs[si].name == "Rational" and files[pos_file(nodes[d].pos)].path == lib_dir + "/rational.dewy"
# An `int` shifted by a signed count (`x << n`, `x >>= n`): a negative count
# fails, so n >= 0 is an obligation. A fixed width's count is unsigned: total.
fact_shift_obliged = (n: int) -> bool:
    k = nodes[n].kind
    op = (if k == .assign: compound_op(int(nodes[n].op)) else: int(nodes[n].op)) as Tok
    if nodes[n].aux != 0 or (k != .binary and k != .assign) or (op != .shl and op != .shr) or prune(ntype(int(nodes[n].a))) != T_MATH_INT: return false
    count = prune(ntype(int(nodes[n].b)))
    count == T_MATH_INT or is_int(count) and types[count].sign

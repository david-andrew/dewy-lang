# O(candidates * arguments), with candidate-local binding arrays.
# Services may re-enter checking or grow arenas; retain indices, never elements.
CRWord:type=int64<overflow='wrap'>
resolve_fn_call=(n:CRWord name:CRWord decls:array<int64> args:array<int64> expected:CRWord closure:CRWord=0 ufcs:bool=false):>CRWord=>$unsafe {
    if rational_module_found >=? 0 and exact_family_name(name) {
        let family=exact_members_for(decls name args)
        if family.length >? decls.length {return resolve_fn_call(n name family args expected closure ufcs)}
    }
    if member_record >=? 0 {member_candidates(decls)}
    let has_targs=call_targs.length >? 0
    if has_targs {
        let targs_here=call_targs
        call_targs=[]
        if args.length >? 0 {check_args_untyped(args)}
        if targs_here.length =? 1 and args.length =? 1 and decls.length >? 0 and node_aux2(nodes.ptr[n].op_ext) not=? int32(AUX2_PARTIAL) {
            let grid=grid_convert_call(n name decls[0] args[0] targs_here[0])
            if grid >=? 0 {return grid}
        }
        return resolve_fn_call_slow(n name decls args expected closure ufcs targs_here)
    }
    let n_args=CRWord(args.length)
    if n_args >? 0 {check_args_untyped(args)}
    if decls.length =? 1 and closure =? 0 and node_aux2(nodes.ptr[n].op_ext) not=? int32(AUX2_PARTIAL) {
        let ap=args.ptr
        let np0=nodes.ptr
        let positional=true
        loop i in [CRWord(0)..n_args) {
            let arg=ap[i]
            if arg =? 0 or np0[arg].kind =? 'namedarg' {
                positional=false
                break
            }
        }
        if positional {
            let decl=CRWord(decls.ptr[0])
            let di:CRWord=decl_info(decl)
            if not decl_infos.ptr[di].sig.done {fn_sig(decl);}
            let np:CRWord=CRWord(nodes.ptr[decl].nlist)
            let mutmask=CRWord(decl_infos.ptr[di].sig.mutmask)
            let p0_ref_mut=false
            if refine_active and mutmask =? 1 {
                p0_ref_mut=true
                if np >? 0 {
                    let p0=decl_infos.ptr[di].sig.params.ptr[0]
                    if types.ptr[p0].kind =? 'struct_' and types.ptr[p0].nargs =? 0 {p0_ref_mut=false}
                }
            }
            if not decl_infos.ptr[di].sig.generic and decl_infos.ptr[di].sig.ntp =? 0 and n_args =? np and np <=? 31 and not p0_ref_mut and (dewy_param_kinds.length =? 0 or not dewy_param_kinds.has(decl)) {
                let ok=true
                let exact_mask:CRWord=0
                let empty_binds:array<int64>=[]
                let recv_fits0=false
                let rat_on=rational_module_found >=? 0
                loop i in [CRWord(0)..np) {
                    let a=CRWord(ap[i])
                    let an=nodes.ptr + a
                    let ak=an[0].kind
                    let afl=CRWord(an[0].flags)
                    let nt=CRWord(an[0].type)
                    if not ((afl & 4096) =? 0 and (ak =? 'ident' or ak =? 'int_lit' or ak =? 'binary' or ak =? 'field' or ak =? 'index' or ak =? 'str_lit' or ak =? 'bool_lit' or ak =? 'float_lit' or (ak =? 'call' and nt not=? 0 and node_aux2(an[0].op_ext) not=? -1))) {
                        if ctx_dependent(a) {ok=false; break}
                    }
                    let pt=CRWord(decl_infos.ptr[di].sig.params.ptr[i])
                    if (mutmask & (CRWord(1) << i)) not=? 0 {
                        if call_mutable_cost(a pt @empty_binds @recv_fits0 i =? 0) <? 0 {ok=false; break}
                    } else {
                        let exact=false
                        if nt =? pt and nt not=? 0 and (afl & 256) =? 0 and ak not=? 'str_lit' and ak not=? 'float_lit' {
                            let pti=types.ptr + pt
                            if (CRWord(pti[0].flags) & 1) =? 0 {
                                let tk=pti[0].kind
                                if tk not=? 'opt' and tk not=? 'refined' and tk not=? 'callable' and tk not=? 'polyfn' and (tk not=? 'struct_' or not rat_on or not bundled_word_rational_type(pt)) {
                                    exact=true
                                    if (afl & 129) =? 128 and ak not=? 'hole' {exact_mask |= (CRWord(1) << i)}
                                }
                            }
                        }
                        if not exact and arg_cost(a pt @empty_binds) <? 0 {ok=false; break}
                    }
                }
                if ok {
                    call_decl_checks(n name decl args args np ufcs)
                    let f:CRWord=0
                    if decl_mono_enabled {
                        let mf=CRWord(decl_infos.ptr[di].sig.mono_fn)
                        if mf >? 0 and mf <? fns.length {
                            let dn=nodes.ptr + decl
                            if (CRWord(dn[0].flags) & 4) =? 0 and dn[0].c =? 0 and dn[0].kind not=? 'lambda' and CRWord(fns.ptr[mf].decl) =? decl and fns.ptr[mf].targs.length =? 0 and fns.ptr[mf].ret not=? 0 {f=mf}
                        }
                    }
                    if f =? 0 {f=get_fn_inst(decl empty_binds nodes.ptr[n].pos)}
                    if ide_on {call_ide_ref(n name args decl f)}
                    loop i in [CRWord(0)..np) {
                        let bit=CRWord(1) << i
                        let is_mut=(mutmask & bit) not=? 0
                        let fpt=CRWord(fns.ptr[f].ptypes.ptr[i])
                        if not is_mut and (exact_mask & bit) not=? 0 and fpt =? CRWord(decl_infos.ptr[di].sig.params.ptr[i]) {continue}
                        let a=CRWord(ap[i])
                        if i =? 0 and is_mut and dewy_is_method(decl) and place_method =? 0 {
                            place_method=if nodes.ptr[decl].kind =? 'fn_' {CRWord(nodes.ptr[decl].name)} else {dewy_literal_method_name}
                            finish_arg(a fpt is_mut)
                            place_method=0
                        } else {
                            finish_arg(a fpt is_mut)
                        }
                    }
                    if mutmask not=? 0 and (mutmask & (mutmask - 1)) not=? 0 {check_mutable_arguments(args mutmask nodes.ptr[n].pos)}
                    let same_list=CRWord(nodes.ptr[n].nlist) =? np
                    if same_list and np >? 0 {
                        let lp=lists.ptr + CRWord(nodes.ptr[n].list)
                        loop i in [CRWord(0)..np) {
                            if CRWord(lp[i]) not=? CRWord(ap[i]) {same_list=false; break}
                        }
                    }
                    if not same_list {set_list(n args)}
                    let nn=nodes.ptr + n
                    nn[0].sym = int32<overflow='wrap'>(f)
                    nn[0].aux = 0
                    nn[0].kind = 'call'
                    nn[0].a = 0
                    if proof_active or wi_any or dir_floats_any {call_note_contracts(n f decl false 0)}
                    let r0=CRWord(fns.ptr[f].ret)
                    let result_type:CRWord=if refine_active {refine_read_type(r0)} else if (CRWord(types.ptr[r0].flags) & 1) =? 0 {r0} else {prune(r0)}
                    nodes.ptr[n].type = int32<overflow='wrap'>(result_type)
                    if cc_any and nodes.ptr[decl].c not=? 0 {
                        let narrowed=cc_call(n f decl)
                        if narrowed not=? 0 {return narrowed}
                    }
                    if wi_any and cc_any {call_warn_unsettled(n f decl)}
                    return result_type
                }
            }
        }
    }
    let no_targs:array<int64>=[]
    resolve_fn_call_slow(n name decls args expected closure ufcs no_targs)
}
rfc_pick_best=(n:CRWord name:CRWord args:array<int64> @cands:array<Cand> @first:Cand @nfit:CRWord):>CRWord=>$unsafe {
    # (overloads told apart by their constant checks: the argument chooses, constant_checks.dewy)
    if cc_any {
        let ds:array<int64>=[]
        let xs:array<array<int64>>=[]
        let ps:array<array<int64>>=[]
        loop cd in cands {
            ds.push(cd.decl)
            xs.push(cd.args)
            ps.push(decl_infos.ptr[cd.di].sig.params)
        }
        let kept=cc_choose(n ds xs ps)
        if kept.length >? 0 {
            let chosen:array<Cand>=[]
            loop i in kept {chosen.push(cands[i])}
            cands=chosen
            nfit=chosen.length
            first=chosen[0]
            if nfit =? 1 {return 0}
        }
    }
    let best:CRWord=-1
    loop ci in [0..cands.length) and cd in cands {
        if best <? 0 or cd.cost <? cands.ptr[best].cost {best=ci}
        else if cd.cost =? cands.ptr[best].cost {
            let bc=cands.ptr[best]
            # (after a function that is not generic, one written for the count beats one with a
            # rest parameter)
            let rest_b=rest_bundles.length >? 0 and decl_has_rest(bc.decl)
            let bc_gen=decl_infos.ptr[bc.di].sig.generic
            let cd_gen=decl_infos.ptr[cd.di].sig.generic
            if bc_gen and not cd_gen {best=ci}
            else if bc_gen =? cd_gen and rest_bundles.length >? 0 and rest_b not=? decl_has_rest(cd.decl) {
                if rest_b {best=ci}
            }
            else if bc_gen =? cd_gen and decl_in_prelude(bc.decl) and not decl_in_prelude(cd.decl) {best=ci}
            else if bc_gen =? cd_gen and decl_in_prelude(bc.decl) and decl_in_prelude(cd.decl) and exact_args(cd) >? exact_args(bc) {best=ci}
            else if bc_gen and cd_gen and decl_in_prelude(bc.decl) =? decl_in_prelude(cd.decl) and generic_specificity(cd) >? generic_specificity(bc) {best=ci}
        }
    }
    if not decl_in_prelude(cands.ptr[best].decl) {call_tie_error(n name args cands best)}
    first=cands.ptr[best]
    best
}

rfc_resolve_binds=(n:CRWord name:CRWord @cd:Cand expected:CRWord closure:CRWord targs_here:array<int64> partial:bool):>void=>$unsafe {
    let decl=cd.decl
    let np:CRWord=nkids(decl)
    # Bind holes, context-dependent arguments and expected result types.
    if partial and expected not=? 0 and tkind(expected) =? 'fn_' {
        let rb=cd.binds
        let ok=true
        let j:CRWord=0
        loop i in [0..np) {
            let a=cd.args.ptr[i]
            if a =? 0 or nodes.ptr[a].kind not=? 'hole' {continue}
            if j >=? CRWord(types.ptr[prune(expected)].nargs) or match_type(decl_infos.ptr[cd.di].sig.params.ptr[i] targ(prune(expected) j) @rb 0) <? 0 {ok=false}
            j += 1
        }
        let sret=CRWord(decl_infos.ptr[cd.di].sig.ret)
        if ok and sret not=? 0 and match_type(sret CRWord(types.ptr[prune(expected)].elem) @rb 0) <? 0 {ok=false}
        if ok {cd.binds = rb}
    }
    # (a text literal is typed when it is read, so its call needs the expected result asked)
    if expected not=? 0 and cd.plain and decl_infos.ptr[cd.di].sig.ret not=? 0 and decl_infos.ptr[cd.di].sig.ntp >? 0 {
        loop a in cd.args {
            if a not=? 0 and nodes.ptr[a].kind =? 'str_lit' and nodes.ptr[a].aux not=? 1 {cd.plain=false}
        }
    }
    if not cd.plain and not partial and expected not=? 0 and decl_infos.ptr[cd.di].sig.ret not=? 0 and decl_infos.ptr[cd.di].sig.ntp >? 0 {expected_binds(@cd expected targs_here)}
    if not cd.plain {
        loop i in [0..np) {
            let a=cd.args.ptr[i]
            if a =? 0 or not is_lit(a) {continue}
            let p:CRWord=prune(decl_infos.ptr[cd.di].sig.params.ptr[i])
            if types.ptr[p].kind =? 'param' and cd.binds.ptr[CRWord(types.ptr[p].id)] =? 0 {cd.binds.ptr[CRWord(types.ptr[p].id)] = lit_default(a)}
        }
        loop i in [0..np) {
            let a=cd.args.ptr[i]
            if a =? 0 or not ctx_dependent(a) or nodes.ptr[a].kind =? 'hole' {continue}
            let pt:CRWord=subst_partial(decl_infos.ptr[cd.di].sig.params.ptr[i] @cd.binds)
            if has_var(pt) and expected not=? 0 and decl_infos.ptr[cd.di].sig.ret not=? 0 {
                let rb=cd.binds
                if match_type(CRWord(decl_infos.ptr[cd.di].sig.ret) expected @rb 0) >=? 0 {
                    cd.binds = rb
                    pt=subst_partial(decl_infos.ptr[cd.di].sig.params.ptr[i] @cd.binds)
                }
            }
            # (nothing gives the type of `[button("Play" "P")]`: its literals do, and then its
            # other elements take that)
            if has_var(pt) and nodes.ptr[a].kind =? 'array' {
                loop e in [0..nkids(a)) {
                    let element=kid(a e)
                    if nodes.ptr[element].type =? 0 and nodes.ptr[element].kind =? 'call' and call_waits_hook(element) =? 2 {
                        check_expr(element 0);
                        add_flag(element NF_CHECKED)
                        match_type(CRWord(types.ptr[prune(decl_infos.ptr[cd.di].sig.params.ptr[i])].elem) ntype(element) @cd.binds 1);
                    }
                }
                pt=subst_partial(decl_infos.ptr[cd.di].sig.params.ptr[i] @cd.binds)
            }
            let row=callable_contract(decl_infos.ptr[cd.di].sig.params.ptr[i])
            if row not=? 0 and effect_contracts.ptr[row].variables.length not=? 0 {pt=mk_callable_contract(callable_base(pt) row)}
            check_expr(a pt);
            add_flag(a NF_CHECKED)
            let matched:CRWord=match_type(decl_infos.ptr[cd.di].sig.params.ptr[i] ntype(a) @cd.binds 0)
            if matched <? 0 and callable_contract(decl_infos.ptr[cd.di].sig.params.ptr[i]) not=? 0 {call_resolve_error(1 a name decl 0 partial)}
        }
    }
    if not partial and expected not=? 0 and decl_infos.ptr[cd.di].sig.ret not=? 0 {
        let rb=cd.binds
        if match_type(CRWord(decl_infos.ptr[cd.di].sig.ret) expected @rb 0) >=? 0 {cd.binds = rb}
    }
    loop i in [0..targs_here.length) {
        if not type_eq(cd.binds.ptr[i] targs_here.ptr[i]) {call_resolve_error(2 n name decl 0 partial)}
    }
    # A missing generic parameter can get its type from its default expression.
    if cd.missing {
        loop i in [0..np) {
            if cd.args.ptr[i] not=? 0 {continue}
            let p:CRWord=prune(decl_infos.ptr[cd.di].sig.params.ptr[i])
            if types.ptr[p].kind not=? 'param' or cd.binds.ptr[CRWord(types.ptr[p].id)] not=? 0 {continue}
            let dv:CRWord=CRWord(nodes.ptr[kid(decl i)].b)
            if dv =? 0 {continue}
            let dk=nodes.ptr[dv].kind
            if is_lit(dv) {cd.binds.ptr[CRWord(types.ptr[p].id)] = lit_default(dv)}
            else if dk =? 'bool_lit' {cd.binds.ptr[CRWord(types.ptr[p].id)] = T_BOOL}
            else if dk =? 'str_lit' {cd.binds.ptr[CRWord(types.ptr[p].id)] = T_STR}
            else if dk =? 'ident' and files.ptr[pos_file(nodes.ptr[n].pos)].is_dewy {
                loop j in [0..i) {
                    if nodes.ptr[dv].name not=? nodes.ptr[kid(decl j)].name {continue}
                    let earlier:CRWord=subst_partial(decl_infos.ptr[cd.di].sig.params.ptr[j] @cd.binds)
                    if not has_var(earlier) {cd.binds.ptr[CRWord(types.ptr[p].id)] = earlier}
                }
            }
            if cd.binds.ptr[CRWord(types.ptr[p].id)] =? 0 and files.ptr[pos_file(nodes.ptr[n].pos)].is_dewy and (closure not=? 0 or not default_uses_params(dv decl i)) {
                let ready=true
                loop j in [0..nkids2(decl)) {
                    if cd.binds.ptr[j] =? 0 or has_var(cd.binds.ptr[j]) {ready=false}
                }
                if ready {
                    let inferred=if closure not=? 0 {poly_default_type(decl i cd.binds)} else {default_arg(decl i 0 targs = cd.binds)}
                    cd.binds.ptr[CRWord(types.ptr[p].id)] = ntype(inferred)
                }
            }
        }
    }
    let ntp=CRWord(decl_infos.ptr[cd.di].sig.ntp)
    loop i in [0..ntp) {
        let b=cd.binds.ptr[i]
        if b =? 0 {
            let nsp=decl_infos.ptr[cd.di].sig.params.length
            loop pi in [0..nsp) {
                if param_in_union(decl_infos.ptr[cd.di].sig.params.ptr[pi] i) {cd.binds.ptr[i] = T_NEVER}
            }
            b=cd.binds.ptr[i]
        }
        if b =? 0 or tkind(b) =? 'var' {call_resolve_error(5 n name decl i partial)}
        # (the library's `sum` adds plain numbers: `array<Level>` sums to an int64, which
        # its elements' contract need not admit)
        if refine_active and tkind(b) =? 'refined' and library_sum(decl) {
            sum_refined_elements[n]=b
            cd.binds.ptr[i]=representation_type(b)
        }
    }
    if closure not=? 0 {
        let variant=poly_default_variant(decl cd.args)
        if variant not=? decl {
            cd.decl=variant
            let vdi:CRWord=decl_info(variant)
            if not decl_infos.ptr[vdi].sig.done {fn_sig(variant);}
            cd.di=vdi
            let supplied:array<int64>=[]
            loop arg in cd.args {
                if arg not=? 0 {supplied.push(arg)}
            }
            cd.args = supplied
        }
    }
}

rfc_finish_missing=(n:CRWord name:CRWord decl:CRWord f:CRWord partial:bool @cd:Cand args:array<int64> @fin:array<int64> @statements:array<int64> @refined_array:RefArrayCall):>bool=>$unsafe {
    let np=CRWord(cd.args.length)
    let mutmask=CRWord(decl_infos.ptr[cd.di].sig.mutmask)
    let capture_defaults=false
    let dewy_call=files.ptr[pos_file(nodes.ptr[n].pos)].is_dewy
    if not partial and dewy_call {
        loop i in [0..np) {
            if cd.args.ptr[i] =? 0 and default_uses_params(CRWord(nodes.ptr[kid(decl i)].b) decl i) {capture_defaults=true}
        }
    }
    if capture_defaults and mutmask not=? 0 {call_resolve_error(3 n name decl 0 partial)}
    if refine_active and not partial and not capture_defaults and mutmask =? 1 {
        if fns.ptr[f].ret =? T_VOID {refined_array=ref_array_call_prepare(decl @cd.args fns.ptr[f].ptypes args)}
        ref_sib_dict_call(decl @cd.args fns.ptr[f].ptypes)
    }
    let captured:array<int64>=[]
    if capture_defaults {
        captured=fill(0 np)
        loop source in args {
            let a=unnamed(source)
            loop i in [0..np) {
                if cd.args.ptr[i] not=? a {continue}
                finish_arg(a representation_type(fns.ptr[f].ptypes.ptr[i]) false)
                captured.ptr[i] = capture_value(a representation_type(fns.ptr[f].ptypes.ptr[i]) @statements)
                break
            }
        }
    }
    loop i in [0..np) {
        let a=cd.args.ptr[i]
        let is_mut=if i <? 31 {mutmask & (CRWord(1) << CRWord(i)) not=? 0} else {has_flag(kid(decl i) NF_MUT)}
        if a =? 0 {
            let earlier=if dewy_call and not capture_defaults {[]} else {fin}
            let pt=fns.ptr[f].ptypes.ptr[i]
            if capture_defaults {pt=representation_type(pt)}
            # (a metatag read in a default reads the caller's setting: expr.jo's __setting_read)
            let outer_site=setting_site
            if outer_site =? 0 {setting_site=nodes.ptr[n].pos}
            a=default_arg(decl i pt earlier capture_defaults fns.ptr[f].targs)
            setting_site=outer_site
            if capture_defaults {
                a=capture_value(a representation_type(fns.ptr[f].ptypes.ptr[i]) @statements)
                finish_arg(a fns.ptr[f].ptypes.ptr[i] false)
            }
            fin.push(a)
            continue
        }
        if capture_defaults {
            finish_arg(captured.ptr[i] fns.ptr[f].ptypes.ptr[i] false)
            fin.push(captured.ptr[i])
            continue
        }
        if i =? 0 and is_mut and dewy_is_method(decl) and place_method =? 0 {
            place_method=if nodes.ptr[decl].kind =? 'fn_' {CRWord(nodes.ptr[decl].name)} else {dewy_literal_method_name}
            finish_arg(a fns.ptr[f].ptypes.ptr[i] is_mut)
            place_method=0
        }
        else {finish_arg(a fns.ptr[f].ptypes.ptr[i] is_mut)}
        fin.push(a)
    }
    capture_defaults
}

resolve_fn_call_slow=(n:CRWord name:CRWord decls:array<int64> args:array<int64> expected:CRWord closure:CRWord ufcs:bool targs_here:array<int64>):>CRWord=>$unsafe {
    let positional=true
    let n_args=CRWord(args.length)
    let ap=args.ptr
    let np0=nodes.ptr
    loop i in [CRWord(0)..n_args) {
        let arg=ap[i]
        if arg =? 0 or np0[arg].kind =? 'namedarg' {
            positional=false
            break
        }
    }
    let cands:array<Cand>=[]
    let first=Cand[]
    let nfit:CRWord=0
    let failure=CallFailure[]
    let recv_fits=false
    # A settled numeric argument can rule out overloads before signature work.
    let a0t:CRWord=0
    let a0i:CRWord=0
    if decls.length >? 1 {
        loop i in [0..args.length) and a in args {
            if nodes.ptr[a].kind =? 'namedarg' {break}
            if nodes.ptr[a].type =? 0 or is_lit(a) or ctx_dependent(a) {continue}
            let k=tkind(ntype(a))
            if k =? 'int_' or k =? 'float_' or k =? 'vec' {
                a0t=prune(ntype(a))
                a0i=i
            }
            break
        }
    }
    loop d in decls {
        let np:CRWord=nkids(d)
        let has_kinds=dewy_param_kinds.length >? 0 and dewy_param_kinds.has(d)
        if positional and n_args not=? np and not has_kinds and (rest_bundles.length =? 0 or not decl_has_rest(d)) {
            if (nfit >? 0 or (not ufcs and failure.last_err_arg not=? 0)) and (n_args >? np or nodes.ptr[kid(d n_args)].b =? 0) {
                continue
            }
        }
        let di:CRWord=decl_info(d)
        if not decl_infos.ptr[di].sig.done {
            if a0t not=? 0 and tkind(a0t) =? 'float_' and written_int_param(d a0i) {continue}
            fn_sig(d);
        }
        if a0t not=? 0 and not decl_infos.ptr[di].sig.generic and decl_infos.ptr[di].sig.params.length >? a0i {
            let p0:CRWord=prune(decl_infos.ptr[di].sig.params.ptr[a0i])
            let pk0=tkind(p0)
            if p0 not=? a0t and (pk0 =? 'vec' or pk0 =? 'int_' or pk0 =? 'float_') and not can_coerce(0 a0t p0) {continue}
            if rational_module_found >=? 0 and pk0 =? 'struct_' and tkind(a0t) =? 'float_' and (bundled_rational_type(p0) or bundled_word_rational_type(p0)) {continue}
        }
        if targs_here.length >? 0 and positional and n_args =? np and not has_kinds and nkids2(d) not=? targs_here.length {
            if nfit =? 0 {call_type_arity(name d targs_here @failure)}
            recv_fits=true
            continue
        }
        let cd=Cand[decl = d di = di]
        if positional and n_args =? np and not has_kinds {
            cd.args = args
        }
        else {
            let kinds:array<int64>=if has_kinds {dewy_param_kinds.get(d) ?? []} else {[]}
            if not call_map_candidate(d args @cd kinds ufcs @recv_fits @failure) {continue}
        }
        let sntp=CRWord(decl_infos.ptr[di].sig.ntp)
        if sntp >? 0 {cd.binds = fill(0 sntp)}
        if targs_here.length >? 0 {
            if nkids2(d) not=? targs_here.length {
                if nfit =? 0 {call_type_arity(name d targs_here @failure)}
                recv_fits=true
                continue
            }
            loop i in [0..targs_here.length) and t in targs_here {cd.binds.ptr[i] = t}
        }
        let failed=call_candidate_cost(@cd @recv_fits)
        if failed not=? 0 {
            if nfit =? 0 {call_reject_candidate(cd failed @failure)}
            continue
        }
        if nfit =? 0 {first=cd}
        else {
            if nfit =? 1 {cands.push(first)}
            cands.push(cd)
        }
        nfit += 1
    }
    # Settle comprehensions before comparing multiple surviving candidates.
    if nfit >? 1 and comprehension_settle(args) {
        call_targs=targs_here
        return resolve_fn_call(n name decls args expected closure ufcs)
    }
    if nfit =? 0 {
        if failure.rejected.length >? 0 {call_rejection_text(@failure)}
        call_targs=targs_here
        return call_no_candidate(n name decls args expected ufcs recv_fits @failure)
    }
    if nfit >? 1 {rfc_pick_best(n name args @cands @first @nfit);}
    let decl=first.decl
    let np:CRWord=nkids(decl)
    call_decl_checks(n name decl args first.args np ufcs)
    let partial=(not first.plain and has_hole(args)) or node_aux2(nodes.ptr[n].op_ext) =? int32(AUX2_PARTIAL)
    if not first.plain or partial or first.missing or closure not=? 0 or targs_here.length >? 0 or (expected not=? 0 and decl_infos.ptr[first.di].sig.ret not=? 0) {
        rfc_resolve_binds(n name @first expected closure targs_here partial)
        decl=first.decl
        np=CRWord(first.args.length)
    } else {
        let ntp=CRWord(decl_infos.ptr[first.di].sig.ntp)
        if ntp >? 0 {
            loop i in [0..ntp) {
                let b=first.binds.ptr[i]
                if b =? 0 {
                    let nsp=decl_infos.ptr[first.di].sig.params.length
                    loop pi in [0..nsp) {
                        if param_in_union(decl_infos.ptr[first.di].sig.params.ptr[pi] i) {first.binds.ptr[i] = T_NEVER}
                    }
                    b=first.binds.ptr[i]
                }
                if b =? 0 or tkind(b) =? 'var' {call_resolve_error(5 n name decl i partial)}
                if refine_active and tkind(b) =? 'refined' and library_sum(decl) {
                    sum_refined_elements[n]=b
                    first.binds.ptr[i]=representation_type(b)
                }
            }
        }
    }
    let inst_binds=if rest_bundles.length >? 0 {rest_inst_binds(decl first.args decl_infos.ptr[first.di].sig.params first.binds)} else {first.binds}
    let f:CRWord=get_fn_inst(decl inst_binds nodes.ptr[n].pos)
    if ide_on {call_ide_ref(n name args decl f)}
    let mutmask=CRWord(decl_infos.ptr[first.di].sig.mutmask)
    let capture_defaults=false
    let refined_array=RefArrayCall[]
    let statements:array<int64>=[]
    let fin:array<int64>=[]
    if first.missing {
        capture_defaults=rfc_finish_missing(n name decl f partial @first args @fin @statements @refined_array)
    } else {
        if refine_active and not partial and mutmask =? 1 {
            if fns.ptr[f].ret =? T_VOID {refined_array=ref_array_call_prepare(decl @first.args fns.ptr[f].ptypes args)}
            ref_sib_dict_call(decl @first.args fns.ptr[f].ptypes)
        }
        loop i in [0..np) {
            let a=first.args.ptr[i]
            let is_mut=if i <? 31 {mutmask & (CRWord(1) << CRWord(i)) not=? 0} else {has_flag(kid(decl i) NF_MUT)}
            if i =? 0 and is_mut and dewy_is_method(decl) and place_method =? 0 {
                place_method=if nodes.ptr[decl].kind =? 'fn_' {CRWord(nodes.ptr[decl].name)} else {dewy_literal_method_name}
                finish_arg(a fns.ptr[f].ptypes.ptr[i] is_mut)
                place_method=0
            }
            else {finish_arg(a fns.ptr[f].ptypes.ptr[i] is_mut)}
        }
        fin=first.args
    }
    if mutmask not=? 0 and (mutmask & (mutmask - 1)) not=? 0 {check_mutable_arguments(fin mutmask nodes.ptr[n].pos)}
    let nfin=fin.length
    let same_fin=CRWord(nodes.ptr[n].nlist) =? nfin
    if same_fin and nfin >? 0 {
        let lp=lists.ptr + CRWord(nodes.ptr[n].list)
        let fp=fin.ptr
        loop i in [0..nfin) {
            if CRWord(lp[i]) not=? fp[i] {same_fin=false; break}
        }
    }
    if not same_fin {set_list(n fin)}
    nodes.ptr[n].sym = int32<overflow='wrap'>(f)
    nodes.ptr[n].aux = 0
    nodes.ptr[n].kind = 'call'
    nodes.ptr[n].a = 0
    if closure not=? 0 {
        let reference=poly_fnref(closure f)
        nodes.ptr[n].a = int32<overflow='wrap'>(reference)
        nodes.ptr[n].sym = 0
        nodes.ptr[n].aux = 1
    }
    if fin.length =? 3 and closure =? 0 {
        let nm=fns.ptr[f].sym as array<uint8>
        if nm.length >=? 7 and nm.ptr[0] =? 102 and nm.ptr[1] =? 95 and nm.ptr[2] =? 115 and nm.ptr[3] =? 119 and nm.ptr[4] =? 97 and nm.ptr[5] =? 112 and nm.ptr[6] =? 95 {live_body_indexes += 1}
    }
    if proof_active or wi_any or dir_floats_any {call_note_contracts(n f decl partial closure)}
    if partial {
        nodes.ptr[n].op_ext=node_with_aux2(nodes.ptr[n].op_ext 0)
        return finish_partial(n fns.ptr[f].ptypes mutmask CRWord(fns.ptr[f].ret))
    }
    if not capture_defaults and not (positional and not first.missing) {save_call_order(n args fin)}
    let r0=CRWord(fns.ptr[f].ret)
    let result_type:CRWord=if refine_active {refine_read_type(r0)} else if (CRWord(types.ptr[r0].flags) & 1) =? 0 {r0} else {prune(r0)}
    nodes.ptr[n].type = int32<overflow='wrap'>(result_type)
    if refined_array.candidate not=? 0 {return ref_array_call_finish(n refined_array)}
    if cc_any and nodes.ptr[decl].c not=? 0 and closure =? 0 and not capture_defaults {
        let narrowed=cc_call(n f decl)
        if narrowed not=? 0 {return narrowed}
    }
    if wi_any and cc_any and closure =? 0 {call_warn_unsettled(n f decl)}
    if capture_defaults {call_capture_block(n f @statements)}
    result_type
}
# Each such call's element type as written, by call: what fact_exact_sum_check bounds them by.
let sum_refined_elements:dict<int64 int64>=[]
sum_refined_reset=():>void=>{sum_refined_elements=dict<int64 int64>()}
# The bundled `sum` of an array or matrix, whose result is its elements' number type.
library_sum=(decl:CRWord):>bool=>$unsafe {
    if decl <=? 0 or name_of(CRWord(nodes.ptr[decl].name)) not=? "sum" {return false}
    let path=files.ptr[pos_file(nodes.ptr[decl].pos)].path
    path =? "{lib_dir}/core/array.jo" or path =? "{lib_dir}/std/nd.jo"
}

$runtime_checks
from p"ast.jo" import (NF_U64 has_flag kids nodes)
from p"check.jo" import (LF_ADDR LF_ALIAS LF_BYREF LF_CAPTURE LF_CAPTURED LF_EXPOSED LF_MUTPARAM LF_SHARED locals)
from p"checked_eval.dewy" import (cx_token)
from p"exact.jo" import (exact_bits exact_has_node exact_representation)
from p"exact_guards.jo" import (ExactGuard eg_demanded eg_hi eg_lo eg_owner eg_stack eg_version)
from p"expr.jo" import (integer_constant ntype)
from p"lower.jo" import (cur_fn)
from p"refinement_types.dewy" import (FACT_MAX FACT_MIN)
from p"types.jo" import (T_INT math_word_overflow)

GuardWord:type=int64<overflow='wrap'>
eg_local=(n:GuardWord):>GuardWord=>$unsafe {
    if n <=? 0 or nodes.ptr[n].kind not=? 'ident' or nodes.ptr[n].aux not=? int32(1) or exact_representation(ntype(n)) not=? T_INT {return 0}
    let l=GuardWord(nodes.ptr[n].sym)
    if l <=? 0 or GuardWord(locals.ptr[l].flags) & (LF_MUTPARAM | LF_ALIAS | LF_CAPTURE | LF_CAPTURED | LF_SHARED | LF_ADDR | LF_BYREF | LF_EXPOSED) not=? 0 {return 0}
    l
}
eg_bound=(n:GuardWord):>[int64 int64]=>$unsafe {
    if nodes.ptr[n].kind =? 'int_lit' and not has_flag(n NF_U64) {return [nodes.ptr[n].ival nodes.ptr[n].ival]}
    let l=eg_local(n)
    if l >? 0 and l <? eg_owner.length and eg_owner[l] =? cur_fn {return [eg_lo[l] eg_hi[l]]}
    [FACT_MIN FACT_MAX]
}
eg_constrain=(l:GuardWord lo:GuardWord hi:GuardWord):>void=>{
    let lo=lo
    let hi=hi
    if l >=? eg_owner.length {
        let size=max(l + 1 locals.length)
        eg_lo.resize(size)
        eg_hi.resize(size)
        eg_owner.resize(size)
        eg_version.resize(size)
    }
    eg_stack.push(ExactGuard(l eg_lo[l] eg_hi[l] eg_owner[l] eg_version[l]))
    if eg_owner[l] =? cur_fn {
        lo=max(lo eg_lo[l])
        hi=min(hi eg_hi[l])
    }
    eg_lo[l]=lo
    eg_hi[l]=hi
    eg_owner[l]=cur_fn
}
eg_condition=(n:GuardWord yes:bool @budget:GuardWord):>void=>$unsafe {
    budget -= 1
    if budget <? 0 or n <=? 0 {return}
    let k=nodes.ptr[n].kind
    if k =? 'not_' {eg_condition(GuardWord(nodes.ptr[n].a) not yes @budget); return}
    if k =? 'and_' and yes or k =? 'or_' and not yes {
        eg_condition(GuardWord(nodes.ptr[n].a) yes @budget)
        eg_condition(GuardWord(nodes.ptr[n].b) yes @budget)
        return
    }
    if k not=? 'binary' or nodes.ptr[n].aux not=? 0 {return}
    let l=eg_local(GuardWord(nodes.ptr[n].a))
    if l =? 0 {return}
    let [known value]=integer_constant(GuardWord(nodes.ptr[n].b))
    if not known or has_flag(GuardWord(nodes.ptr[n].b) NF_U64) {return}
    let op=cx_token(nodes.ptr[n].op)
    if not yes {
        if op =? 'lt' {op='ge'}
        else if op =? 'le' {op='gt'}
        else if op =? 'gt' {op='le'}
        else if op =? 'ge' {op='lt'}
        else {return}
    }
    if op =? 'gt' and value <? FACT_MAX {eg_constrain(l value + 1 FACT_MAX)}
    else if op =? 'ge' {eg_constrain(l value FACT_MAX)}
    else if op =? 'lt' and value >? FACT_MIN {eg_constrain(l FACT_MIN value - 1)}
    else if op =? 'le' {eg_constrain(l FACT_MIN value)}
    else if op =? 'eq' {eg_constrain(l value value)}
}
eg_begin=(condition:GuardWord yes:bool):>GuardWord=>{
    let mark=eg_stack.length
    if cur_fn >? 0 and cur_fn <? eg_demanded.length and eg_demanded[cur_fn] {
        let budget:GuardWord=64
        eg_condition(condition yes @budget)
    }
    mark
}
eg_end=(mark:GuardWord):>void=>{
    loop eg_stack.length >? mark {
        let old=eg_stack.pop()
        if eg_version[old.local] =? old.version {
            eg_lo[old.local]=old.lo
            eg_hi[old.local]=old.hi
            eg_owner[old.local]=old.owner
        }
    }
}
eg_write=(n:GuardWord):>void=>$unsafe {
    if eg_stack.length =? 0 {return}
    if nodes.ptr[n].kind =? 'tuple' {
        loop child in kids(n) {eg_write(child)}
        return
    }
    let l=eg_local(n)
    if l >? 0 and l <? eg_owner.length {eg_owner[l]=0; eg_version[l] += 1}
}
eg_loop=():>void=>{
    loop entry in eg_stack {
        eg_owner[entry.local]=0
        eg_version[entry.local] += 1
    }
}
# One signed-word operation can use the endpoints already established above;
# no new relational state, recursive body walk or speculative proof is needed.
eg_fits=(n:GuardWord):>bool=>$unsafe {
    if eg_stack.length =? 0 or nodes.ptr[n].kind not=? 'binary' or nodes.ptr[n].aux not=? 0 {return false}
    let op=cx_token(nodes.ptr[n].op)
    if op not=? 'plus' and op not=? 'minus' {return false}
    let left=GuardWord(nodes.ptr[n].a)
    let right=GuardWord(nodes.ptr[n].b)
    if exact_has_node(left) or exact_has_node(right) or exact_bits(left) >? 64 or exact_bits(right) >? 64 {return false}
    let [a b]=eg_bound(left)
    let [c d]=eg_bound(right)
    if a >? b or c >? d {return false}
    if op =? 'plus' {return not math_word_overflow(0 a c) and not math_word_overflow(0 b d)}
    not math_word_overflow(1 a d) and not math_word_overflow(1 b c)
}

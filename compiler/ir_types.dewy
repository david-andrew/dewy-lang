# Shared IR schema. Storage and hot builders stay with their Jo owners.

Op:type='nop' | 'iconst' | 'fconst' | 'mov' | 'add' | 'sub' | 'mul' | 'divs' | 'divu' | 'rems' | 'remu' | 'and_' | 'or_' | 'xor' | 'shl' | 'shrs' | 'shru' | 'neg' | 'not_' | 'eq' | 'ne' | 'lts' | 'les' | 'gts' | 'ges' | 'ltu' | 'leu' | 'gtu' | 'geu' | 'fadd' | 'fsub' | 'fmul' | 'fdiv' | 'fneg' | 'fsqrt' | 'fmin' | 'fmax' | 'ffloor' | 'fceil' | 'fabs' | 'ftrunc' | 'feq' | 'fne' | 'flt' | 'fle' | 'fgt' | 'fge' | 'sext8' | 'sext16' | 'sext32' | 'zext8' | 'zext16' | 'zext32' | 'i2f' | 'u2f' | 'f2i' | 'f2f' | 'bits2f' | 'f2bits' | 'load' | 'store' | 'slot' | 'gaddr' | 'daddr' | 'faddr' | 'copy' | 'zero' | 'memcpy' | 'memset' | 'zeroslots' | 'vop' | 'call' | 'calli' | 'callc' | 'syscall' | 'intr' | 'block' | 'loop' | 'if_' | 'else_' | 'end' | 'br' | 'brif' | 'ret' | 'trap' | 'select' | 'assume' | 'brtable' | 'vld' | 'vst' | 'vbin' | 'vsplat' | 'vzu' | 'mulhs' | 'mulhu' | 'memeq' | 'checked_add' | 'checked_sub' | 'checked_mul' | 'overflow_add' | 'overflow_sub' | 'overflow_mul' | 'rot32' | 'streq' | 'findbyte' | 'scanbytes' | 'findb'

Ins:type=[
    op:Op='nop'
    ty:int32=0
    dst:int32=0
    a:int32=0
    b:int32=0
    c:int32=0
    imm:int64=0
    pos:int32=0 # where in the source (an index into ir_positions; 0: not known)
]

IrFn:type=[
    name:string=""
    nparams:int64=0
    ret:int64=0 # VI/VF/VS or -1 for none
    vtypes:array<int8>=[]
    slot_size:array<int32>=[]
    slot_align:array<int32>=[]
    code:array<Ins>=[]
    args:array<int32>=[]
    cabi:bool=false
    noinline:bool=false # (@noinline)
    export_name:string=""
    fn_index:int64=0
    raw_mem:bool=false # dereferences raw pointers (disables type-based alias reasoning)
    kval:array<int64>=[] # values of VK vregs (indexed by vreg; may be shorter than vtypes)
    decl_pos:int64=0 # the line of its declaration (an index into ir_positions; 0: none)
    dbg_locals:array<int64>=[] # (debug information: its parameters, then its other variables)
]

# Final-IR use summaries: indexed by vreg, built only after the optimizer has
# finished rewriting operands. Instruction operands remain in Ins and call
# operands in IrFn.args; no duplicated operand arrays or stale optimizer cache.
# All native backend consumers share the counts, intervals and allocation chain.
IrUsePlan:type=[
    first:int64=1 << 60
    last:int64=-1
    ndef:int64=0
    nuse:int64=0
    weight:int64=0
    next_start:int64=-1
]

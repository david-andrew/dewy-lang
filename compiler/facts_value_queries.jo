fact_slot = (s: FactState, v: int) -> int:
    # A value's latest insertion is a hint, never cross-branch evidence.
    # Validate against this frame before falling back to its own index.
    if v > 0 and v < fact_terms.len():
        hint = fact_terms[v].slot
        if hint >= 0 and hint < s.ids.len() and s.ids[hint] == v: return hint
    # (a hashed index may be shared with a longer ancestor: an entry counts
    # only when it still names v's position)
    if s.index[0].slots.len() != 0:
        i = fact_index_get(s.index[0].slots, v)
        if i >= 0 and i < s.ids.len() and s.ids[i] == v: return i
        return -1
    if s.ids.len() == 0 or v < s.ids[0] or v > s.ids[s.ids.len() - 1]: return -1
    lo = 0; hi = s.ids.len()
    loop lo < hi:
        mid = (lo + hi) / 2
        if s.ids[mid] < v: lo = mid + 1
        else: hi = mid
    if lo < s.ids.len() and s.ids[lo] == v: return lo
    -1
fact_bound = (s: FactState, v: int) -> FactBound:
    i = fact_slot(s, v)
    if i < 0: return FactBound(reason = .budget, wide = true)
    s.bounds[i]
# A compact open-address index: (key, record+1) pairs after an entry count.
# Empty slots have record=0, so all signed keys are usable. Doubling at half
# occupancy gives amortized O(1) insertion and expected O(1) lookup. These
# arrays copy with the fact state; there is no mutable cross-branch cache.
fact_index_hash = (key: int, mask: int) -> int:
    ((key xor (key >> 32)) * 0x9e3779b1) & mask
fact_index_get = (index: int[], key: int) -> int:
    if index.len() == 0: return -1
    mask = (index.len() - 1) / 2 - 1
    slot = fact_index_hash(key, mask)
    loop true:
        i = 1 + slot * 2
        if index[i + 1] == 0: return -1
        if index[i] == key: return index[i + 1] - 1
        slot = (slot + 1) & mask
    -1
# (a join's root index may be shared with a predecessor holding more
# bindings: an entry counts only when it still names p's position)
fact_binding = (s: FactState, p: PlaceIdentity) -> int:
    i = fact_index_get(s.index[0].roots, fact_root_key(p))
    if i >= 0 and i < s.bindings.len() and s.bindings[i].place == p: return i
    -1
fact_truth = (s: FactState, v: int) -> int:
    b = fact_bound(s, v)
    if b.lo == 0 and b.hi == 0: return 0
    if b.nz or b.lo > 0 or b.hi < 0: return 1
    -1
# v's interval as signed values: a uint64's biased ends count as unknown (wide).
fact_signed_bound = (s: FactState, v: int) -> FactBound:
    b = fact_bound(s, v)
    if v != 0 and fact_type(fact_terms[v].type) == T_U64: b.wide = true
    b

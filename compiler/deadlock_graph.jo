use 'deadlock.jo'
use 'deadlock_channel_graph.dewy'
use 'deadlock_channels.dewy'
use 'deadlock_certificates.dewy'
use 'ast.jo'
use 'check.jo'
use 'expr.jo'
use 'util.jo'
use 'concurrency.jo'
use 'directives.jo'
use 'lower_helpers.dewy'
use 'lower_races.dewy'
use 'isolation_ops.dewy'
use 'deadlock_locations.dewy'
use 'deadlock_walk.dewy'
use 'deadlock_waits.dewy'

dl_scan_calls = (f: int, n: int):
    if n == 0: return
    k = nodes[n].kind
    if (k == .call and nodes[n].aux == 0 or k == .lambda or k == .fnref) and nodes[n].sym > 0:
        g = int(nodes[n].sym)
        if g != f and g < fns.len():
            list = dl_callers.get(g) ?? []
            list.push(f)
            dl_callers[g] = list
        # (a function given a function value: what it calls back is part of what it takes)
        if k == .call:
            loop a in kids(n):
                if is_fn_type(ntype(a)):
                    list = dl_givens.get(g) ?? []
                    list.push(a)
                    dl_givens[g] = list
    if k == .vardecl and nodes[n].sym > 0 and nkids(n) == 0 and not has_flag(n, NF_GLOBAL): dl_inits[int(nodes[n].sym)] = n
    if k == .vardecl and dc_split(int(nodes[n].b)):
        loop c in kids(n):
            if nodes[c].kind != .hole and nodes[c].sym > 0: dl_inits[int(nodes[c].sym)] = n
    # (the certified protocols' own channel waits are the library's, not the program's)
    if dc_on() and k == .call and nodes[n].aux == 0 and nodes[n].sym > 0 and not dc_is(int(fns[f].mod)) and int(fns[f].mod) != dc_protocols() and dc_chan_call(n) > 0: dc_fns[f] = true
    # Spawning a failing sibling or canceling a group can end a queue wait,
    # including through a helper that performs no queue operation itself.
    if dc_on() and k == .call and nodes[n].aux == 0 and nodes[n].sym > 0:
        g = int(nodes[n].sym)
        if int(fns[g].mod) == concurrency_task_module and not pos_in_lib(nodes[n].pos):
            d = int(fns[g].decl)
            if d != 0 and name_of(int(nodes[d].name)) in ["__task_spawn", "cancel"]: dc_fns[f] = true
    if k != .lambda and k != .fnref:
        loop g in value_helper_calls(n):
            list = dl_callers.get(g) ?? []
            list.push(f)
            dl_callers[g] = list
    if k == .lambda: return
    if k == .propagate or k == .parallel_region:
        dl_scan_calls(f, int(nodes[n].a))
        return
    mask = isolation_children(k)
    if mask < 0:
        dl_scan_calls(f, int(nodes[n].a))
        dl_scan_calls(f, int(nodes[n].b))
        dl_scan_calls(f, int(nodes[n].c))
        loop c in kids(n): dl_scan_calls(f, c)
        return
    if mask & 1 != 0: dl_scan_calls(f, int(nodes[n].a))
    if mask & 2 != 0: dl_scan_calls(f, int(nodes[n].b))
    if mask & 4 != 0: dl_scan_calls(f, int(nodes[n].c))
    if mask & 16 != 0:
        loop c in kids(n): dl_scan_calls(f, c)
    if mask & 32 != 0:
        loop c in kids2(n): dl_scan_calls(f, c)

dl_cycles = ():
    if dl_global_edges.len() == 0: return
    ids: {str: int} = {}
    names_: str[]
    adj: int[][]
    out_edges: int[][]
    loop i in [0..dl_global_edges.len()):
        e = dl_global_edges[i]
        loop key in [dl_key(e.held), dl_key(e.taken)]:
            if not ids.has(key):
                ids[key] = names_.len()
                names_.push(key)
                adj.push([])
                out_edges.push([])
        a = ids[dl_key(e.held)]
        adj[a].push(ids[dl_key(e.taken)])
        out_edges[a].push(i)
    # (the first edge whose target reaches its source: a breadth-first search back, O(V + E) each,
    # stopping at the first cycle found, which is reported)
    loop i in [0..dl_global_edges.len()):
        e = dl_global_edges[i]
        a = ids[dl_key(e.held)]
        b = ids[dl_key(e.taken)]
        if a == b: continue
        prev = fill(-1, names_.len())
        prev[b] = i
        queue = [b]
        q = 0
        found = false
        loop q < queue.len() and not found:
            v = queue[q]
            q += 1
            loop j in out_edges[v]:
                w = ids[dl_key(dl_global_edges[j].taken)]
                if prev[w] >= 0: continue
                prev[w] = j
                if w == a:
                    found = true
                    break
                queue.push(w)
        if not found: continue
        # the path back from b to a
        back: int[]
        v = a
        loop v != b:
            j = prev[v]
            back.insert(0, j)
            v = ids[dl_key(dl_global_edges[j].held)]
        dl_report_cycle(e, back)
        return

dl_report_cycle = (e: DlEdge, back: int[]):
    msg = "lock order cycle: one path {dl_path(e)}"
    loop j in back: msg += "; another {dl_path(dl_global_edges[j])}"
    msg += ". Two tasks on these paths can each hold one lock and wait forever for the other. Take the locks together, in one order: `let [a b] = @(lock_all(x y)) or_throw`"
    if concurrency_tasks.len() == 0 and not deadlock_parallel:
        # (under `$no_deadlocks` the order itself is the certificate, tasks or not)
        sites = [e.held_site, e.at]
        loop j in back:
            sites.push(dl_global_edges[j].held_site)
            sites.push(dl_global_edges[j].taken_site)
            sites.push(dl_global_edges[j].at)
        dl_undecided(e.taken_site, msg + " (no task runs them at once yet)", sites)
        return
    loop j in back: err_notes.push((dl_global_edges[j].taken_site, "note: the other path takes {dl_name(dl_global_edges[j].taken)} here"))
    fatal(e.taken_site, msg)

deadlock_finalize = ():
    # (parallel iterations polling an atomic: only the parallel bodies of a program using atomics)
    if deadlock_atomics:
        dl_report = true
        loop n in concurrency_calls:
            if in_lib(nodes[n].pos): continue
            loop a in kids(n):
                h = dl_fn_arg(a)
                if h > 0 and fns[h].body != 0: dl_polling(h)
        dl_report = false
    # (channels: only once their prelude is loaded; the scan finds the functions calling them)
    dc_mod = dc_module()
    dc_qmod = dc_module("/prelude/mpmc.dewy")
    dc_smod = dc_module("/prelude/spsc.dewy")
    if dc_on() and not dc_called():
        dc_mod = -1
        dc_qmod = -1
        dc_smod = -1
    # (`$no_deadlocks` asks for a certificate of every wait: joins, foreign calls and protocols too)
    certify = dir_deadlocks_any
    pc_mod = pc_module()
    if deadlock_fns.len() == 0 and not dc_on() and not certify: return
    # (the call graph, the owners of locals and the parameters' indexes: one scan)
    loop f in [1..fns.len()):
        if fns[f].state != 2 or fns[f].body == 0: continue
        loop i in [0..fns[f].params.len()): dl_param_index[fns[f].params[i]] = i
        dl_scan_calls(f, int(fns[f].body))
    # (Dewy's value parameters are bound to locals that lead the body: the binding is the
    # parameter)
    if deadlock_fns.len() == 0 and dc_fns.len() == 0 and not certify: return
    work: int[]
    loop f, on in deadlock_fns:
        if not dl_relevant.has(f):
            dl_relevant[f] = true
            work.push(f)
    loop f, on in dc_fns:
        if not dl_relevant.has(f):
            dl_relevant[f] = true
            work.push(f)
    # (callers of a function taking locks, and functions given one as a value; indexed by
    # what they are given, each looked at once)
    given_to: {int: int[]} = {}
    loop g, values in dl_givens:
        loop a in values:
            h = dl_fn_arg(a)
            if h > 0:
                list = given_to.get(h) ?? []
                list.push(g)
                given_to[h] = list
    i = 0
    loop i < work.len():
        f = work[i]
        i += 1
        loop c in (dl_callers.get(f) ?? []) + (given_to.get(f) ?? []):
            if not dl_relevant.has(c):
                dl_relevant[c] = true
                work.push(c)
    if deadlock_fns.len() > 0:
        passes = 0
        dl_changed = true
        loop dl_changed and passes < DL_PASSES:
            dl_changed = false
            passes += 1
            # (callees before callers: the closure's order)
            loop f in work: dl_walk_fn(f)
        dl_report = true
        loop f in work: dl_walk_fn(f)
        dl_cycles()
    if certify: nd_check()
    if dc_fns.len() > 0: dc_analyze()

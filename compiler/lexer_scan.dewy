$runtime_checks

from p"checker_tokens.dewy" import Tok
from p"lex.jo" import (Token STRF_RAW STRF_TRIPLE STRF_SINGLE LX_SPARE lx_file lx_src lx_p lx_n lx_i lx_toks lx_tok_pool lx_indents lx_tab_indent lx_space_indent lx_ctx lx_line_indent lx_lazy lx_line_tok0 lx_decl_lines lx_base lx_slots lx_count lx_cap kw_tok lx_cls)
from p"util.jo" import (intern_new intern_sub mkpos name_hash name_tab names)
from p"intern.dewy" import (hash_bytes name_find_raw same_bytes)
from p"lexer_errors.dewy" import lx_err
from p"lexer_units.dewy" import lx_unit
from p"lexer_line_closes.dewy" import lx_line_closes
from p"lexer_line_context.dewy" import (lx_emit lx_next lx_grow lx_last_kind lx_emit_newline lx_top_block lx_decl_line lx_decl_context lx_close_block_ctx)
from p"lexer_helpers.dewy" import (is_ident_char init_keywords lx_init_classes lx_line_start lx_body_end lx_float)
from p"@lib/core/str.jo" import (is_alpha byte_str)

# Shared Jo state remains the owner. Byte views never own or copy arrays;
# token pointers are reacquired after growth, and offsets wrap as Jo words do.
LexScanWord:type=int64<overflow='wrap'>
LexScanUWord:type=uint64<overflow='wrap'>

lx_number=():>void=>$unsafe {
    let p=lx_p
    let s:LexScanWord=lx_i
    let i:LexScanWord=s
    let v:LexScanUWord=0
    let big=false
    if p[i] =? 48 and (p[i + 1] =? 120 or p[i + 1] =? 88 or p[i + 1] =? 98 or p[i + 1] =? 66 or p[i + 1] =? 111 or p[i + 1] =? 79) {
        let b=p[i + 1]
        let base:LexScanUWord=8
        if b =? 120 or b =? 88 {base=16}
        if b =? 98 or b =? 66 {base=2}
        i += 2
        loop true {
            let c=p[i]
            let d:LexScanUWord=99
            if c =? 95 {
                i += 1
                continue
            }
            if c >=? 48 and c <=? 57 {d=LexScanUWord(c - 48)}
            else if c >=? 97 and c <=? 102 {d=LexScanUWord(c - 97) + 10}
            else if c >=? 65 and c <=? 70 {d=LexScanUWord(c - 65) + 10}
            if d >=? base {break}
            if v >? (0xFFFFFFFFFFFFFFFF - d) // base {lx_err(s "integer literal too large (more than 64 bits)")}
            v=v * base + d
            i += 1
        }
        lx_i=i
    }
    else {
        # integers are accumulated directly; floats are re-read by to_float
        loop true {
            let c=p[i]
            if c >=? 48 and c <=? 57 {
                if v >=? 1844674407370955161 and (v >? 1844674407370955161 or c >? 53) {big=true}
                v=v * 10 + LexScanUWord(c - 48)
                i += 1
            }
            else if c =? 95 {i += 1}
            else {break}
        }
        let is_float=false
        if p[i] =? 46 and p[i + 1] >=? 48 and p[i + 1] <=? 57 {
            is_float=true
            i += 1
            loop (p[i] >=? 48 and p[i] <=? 57) or p[i] =? 95 {i += 1}
        }
        if (p[i] =? 101 or p[i] =? 69) and ((p[i + 1] >=? 48 and p[i + 1] <=? 57) or ((p[i + 1] =? 45 or p[i + 1] =? 43) and p[i + 2] >=? 48 and p[i + 2] <=? 57)) {
            is_float=true
            i += 1
            if p[i] =? 45 or p[i] =? 43 {i += 1}
            loop p[i] >=? 48 and p[i] <=? 57 {i += 1}
        }
        lx_i=i
        if is_float {
            if lx_cls[p[i]] & 1 not=? 0 {
                lx_unit(s lx_float(s i))
                return
            }
            let fv=lx_float(s i)
            if fv - fv not=? 0.0 {lx_err(s "number too large: the largest a float holds is about 1.8e308 (INF is infinity; for bigger numbers, `use big`: `big(1, 400)`)")}
            lx_emit('float_lit' s i - s)
            lx_slots[LexScanWord(lx_count) - 1].ival = LexScanWord(f64_bits(fv))
            return
        }
    }
    if lx_cls[p[lx_i]] & 1 not=? 0 {
        lx_unit(s float64(v))
        return
    }
    if is_ident_char(p[lx_i]) {lx_err(lx_i "invalid character in number literal")}
    if big {lx_err(s "integer literal too large (more than 64 bits)")}
    lx_emit('int_lit' s LexScanWord(lx_i) - s)
    lx_slots[LexScanWord(lx_count) - 1].ival = LexScanWord(v)

}
lx_string=(raw:bool):>void=>$unsafe {
    let p=lx_p
    let s:LexScanWord=lx_i
    let q=p[s]
    let triple=q =? 34 and p[s + 1] =? 34 and p[s + 2] =? 34
    let i:LexScanWord=s + 1
    if triple {i=s + 3}
    let start:LexScanWord=i
    let depth:LexScanWord=0
    loop true {
        if i >=? lx_n {
            if depth >? 0 {lx_err(s "unterminated string: a `\{` in it starts an interpolation that does not end (for a brace in the text, write \{\{ or \}\})")}
            lx_err(s "this text has no closing quote: it starts here, and a `\"` ends it")
        }
        let c=p[i]
        if depth =? 0 {
            if c =? 92 and not raw {
                i += 2
                continue
            }
            if triple {
                if c =? 34 and p[i + 1] =? 34 and p[i + 2] =? 34 {break}
            }
            else if c =? q {break}
            if not raw and c =? 123 {
                if p[i + 1] =? 123 {
                    i += 2
                    continue
                }
                # ('{', a brace alone: there is nothing for it to interpolate; "{"a" if c...}" is
                # text inside an interpolation)
                # (p[i + 2] read once p[i + 1] is the quote, so not the 0 after the source)
                if not triple and p[i + 1] =? q and i =? start and not is_ident_char(p[i + 2]) and p[i + 2] not=? 34 and p[i + 2] not=? 39 {
                    i += 1
                    continue
                }
                depth=1
                i += 1
                continue
            }
            i += 1
        }
        else {
            if c =? 123 {depth += 1}
            else if c =? 125 {depth -= 1}
            else if c =? 34 or c =? 39 {
                i += 1
                loop i <? lx_n and p[i] not=? c {
                    if p[i] =? 92 {i += 1}
                    i += 1
                }
            }
            i += 1
        }
    }
    # (print("hello) then a line on with print("round {i}"): the text runs over lines and ends
    # at the second print's quote, a letter right after it: the first line's quote is missing)
    if not triple and i + 1 <? lx_n {
        let nc=p[i + 1]
        if (nc >=? 97 and nc <=? 122) or (nc >=? 65 and nc <=? 90) or nc =? 95 {
            let k:LexScanWord=start
            loop k <? i and p[k] not=? 10 {k += 1}
            if k <? i {lx_err(s "this text has no closing quote on its line: a `\"` ends it there (text that goes on over lines is written in triple quotes, \"\"\"...\"\"\")")}
        }
    }
    let f:LexScanWord=0
    if raw {f |= STRF_RAW}
    if triple {f |= STRF_TRIPLE}
    if q =? 39 {f |= STRF_SINGLE}
    let k:LexScanWord=lx_next()
    let t=lx_slots
    t[k].kind = 'str_lit'
    t[k].flags = int32<overflow='wrap'>(f)
    t[k].pos = mkpos(lx_file lx_base + s)
    t[k].start = int32<overflow='wrap'>(start)
    t[k].len = int32<overflow='wrap'>(i - start)
    t[k].ival = 0
    if triple {lx_i=i + 3}
    else {lx_i=i + 1}

}
let lx_tok1_arr:array<Tok>=[]
let lx_tok_eq_arr:array<Tok>=[]
let lx_op_mode_arr:array<uint8>=[]
let lx_tok1:ptr<Tok>=$unsafe (uint64(0) as ptr<Tok>)
let lx_tok_eq:ptr<Tok>=$unsafe (uint64(0) as ptr<Tok>)
let lx_op_mode:ptr<uint8>=$unsafe (uint64(0) as ptr<uint8>)

lx_init_op_tables=():>void=>$unsafe {
    lx_tok1_arr=fill(Tok.eof 256)
    lx_tok_eq_arr=fill(Tok.eof 256)
    lx_op_mode_arr=fill(uint8(0) 256)
    lx_tok1=lx_tok1_arr.ptr
    lx_tok_eq=lx_tok_eq_arr.ptr
    lx_op_mode=lx_op_mode_arr.ptr
    # mode 1: 1-char act=0 (; ~ @)
    lx_tok1[59]='semi'; lx_op_mode[59]=1
    lx_tok1[126]='tilde'; lx_op_mode[126]=1
    lx_tok1[64]='at'; lx_op_mode[64]=1
    # mode 2: open bracket (( [ {)
    lx_tok1[40]='lparen'; lx_op_mode[40]=2
    lx_tok1[91]='lbrack'; lx_op_mode[91]=2
    lx_tok1[123]='lbrace'; lx_op_mode[123]=2
    # mode 3: close bracket () ] })
    lx_tok1[41]='rparen'; lx_op_mode[41]=3
    lx_tok1[93]='rbrack'; lx_op_mode[93]=3
    lx_tok1[125]='rbrace'; lx_op_mode[125]=3
    # mode 4: comma (,)
    lx_tok1[44]='comma'; lx_op_mode[44]=4
    # mode 5: colon (:)
    lx_tok1[58]='colon'; lx_op_mode[58]=5
    # mode 6: op or op= (+ / % & | ^ = !)
    lx_tok1[43]='plus'; lx_tok_eq[43]='pluseq'; lx_op_mode[43]=6
    lx_tok1[47]='slash'; lx_tok_eq[47]='slasheq'; lx_op_mode[47]=6
    lx_tok1[37]='percent'; lx_tok_eq[37]='percenteq'; lx_op_mode[37]=6
    lx_tok1[38]='amp'; lx_tok_eq[38]='ampeq'; lx_op_mode[38]=6
    lx_tok1[124]='pipe'; lx_tok_eq[124]='pipeeq'; lx_op_mode[124]=6
    lx_tok1[94]='caret'; lx_tok_eq[94]='careteq'; lx_op_mode[94]=6
    lx_tok1[61]='assign'; lx_tok_eq[61]='eq'; lx_op_mode[61]=6
    lx_tok1[33]='bang'; lx_tok_eq[33]='ne'; lx_op_mode[33]=6
    # mode 7..12: multi-form (? - * < > .)
    lx_tok1[63]='question'; lx_op_mode[63]=7
    lx_tok1[45]='minus'; lx_op_mode[45]=8
    lx_tok1[42]='star'; lx_op_mode[42]=9
    lx_tok1[60]='lt'; lx_op_mode[60]=10
    lx_tok1[62]='gt'; lx_op_mode[62]=11
    lx_tok1[46]='dot'; lx_op_mode[46]=12
}

lx_hash_check=(p:ptr<uint8> i:LexScanWord lim:LexScanWord cnt:LexScanWord):>void=>$unsafe {
    if i + 1 <? lim {
        let nc=p[i + 1]
        if (nc >=? 97 and nc <=? 122) or (nc >=? 65 and nc <=? 90) {
            lx_count=cnt
            let lk=lx_last_kind()
            if lk =? 'lparen' or lk =? 'lbrack' or lk =? 'comma' or lk =? 'assign' or lk =? 'plus' or lk =? 'minus' or lk =? 'star' or lk =? 'lt' or lk =? 'gt' or lk =? 'eq' {
                lx_err(i "`#` starts a comment; a length is `xs.len()` (or `len(s)`)")
            }
        }
    }
}

lx_op_multi=(p:ptr<uint8> i:LexScanWord om:uint8 c:uint8 at:LexScanWord):>LexScanWord=>$unsafe {
    let c1=p[i + 1]
    let k=lx_tok1[c]
    let n:LexScanWord=1
    let iv:LexScanWord=0
    if om =? 12 {
        if c1 =? 46 {
            k='dotdot'; n=2
            if p[i + 2] =? 46 {k='ellipsis'; n=3}
        }
        else if c1 =? 43 or c1 =? 45 or c1 =? 42 or c1 =? 47 or c1 =? 37 or c1 =? 94 or c1 =? 60 or c1 =? 62 or (c1 =? 61 and p[i + 2] =? 61) or (c1 =? 33 and p[i + 2] =? 61) {
            k='dotop'; n=2; iv=LexScanWord(c1)
            if p[i + 2] =? 61 and c1 not=? 43 and c1 not=? 45 and c1 not=? 42 and c1 not=? 47 and c1 not=? 37 and c1 not=? 94 {n=3}
        }
    }
    else if om =? 8 {
        if c1 =? 62 {k='arrow'; n=2}
        else if c1 =? 61 {k='minuseq'; n=2}
    }
    else if om =? 9 {
        if c1 =? 61 {k='stareq'; n=2}
        else if c1 =? 42 {k='starstar'; n=2}
    }
    else if om =? 10 {
        if c1 =? 60 {
            k='shl'; n=2
            if p[i + 2] =? 61 {k='shleq'; n=3}
        }
        else if c1 =? 61 {k='le'; n=2}
    }
    else if om =? 11 {
        if c1 =? 62 {
            k='shr'; n=2
            if p[i + 2] =? 61 {k='shreq'; n=3}
        }
        else if c1 =? 61 {k='ge'; n=2}
    }
    else if c1 =? 63 {k='qq'; n=2}
    if lx_count =? lx_cap {lx_grow()}
    let sl=lx_slots + lx_count
    lx_count += 1
    sl[0].kind = k
    sl[0].flags = 0
    sl[0].pos = at + i
    sl[0].start = int32<overflow='wrap'>(i)
    sl[0].len = int32<overflow='wrap'>(n)
    sl[0].ival = iv
    i + n
}
lx_newline_slow=(i:LexScanWord cnt:LexScanWord ctx_n:LexScanWord):>void=>$unsafe {
    __set_len(lx_ctx ctx_n)
    lx_i=i
    lx_count=cnt
    if lx_lazy and ctx_n =? 1 and lx_decl_context() and lx_last_kind() =? 'colon' and lx_decl_line() {
        let end_:LexScanWord=lx_body_end(LexScanWord(lx_i) + 1 lx_line_indent)
        if end_ >? 0 {
            lx_emit_newline()
            lx_emit('lazy' LexScanWord(lx_i) + 1 end_ - (LexScanWord(lx_i) + 1))
            lx_i=end_
            lx_line_start()
            return
        }
    }
    lx_i=LexScanWord(lx_i) + 1
    if lx_top_block() {lx_emit_newline()}
    lx_line_start()
}
lx_bad_char=(p:ptr<uint8> i:LexScanWord c:uint8):>void=>$unsafe {
    lx_i=i
    if c =? 96 {lx_err(i "strings are in double quotes and put values in by themselves: \"score \{n\}\" (no backticks)")}
    if c =? 0 {lx_err(i "this is not a source file: it holds binary data (a program built from one?)")}
    if c =? 36 and i + 1 <? (lx_src as array<uint8>).length and p[i + 1] =? 34 {lx_err(i "every string can hold values: drop the `$` (`\"Score: \{s}\"`)")}
    lx_err(i "unexpected character '{byte_str(int64(c))}'")
}
let lx_nsp:ptr<int32>=$unsafe (uint64(0) as ptr<int32>)
let lx_nhp:ptr<int64>=$unsafe (uint64(0) as ptr<int64>)
let lx_ntp:ptr<ptr<uint8>>=$unsafe (uint64(0) as ptr<ptr<uint8>>)
let lx_nmask:LexScanWord=-1
lx_intern_slow=(ps:ptr<uint8> ln:LexScanWord):>LexScanWord=>$unsafe {
    let h:LexScanWord=hash_bytes(ps ln)
    let id:LexScanWord=name_find_raw(lx_nsp lx_nhp lx_ntp lx_nmask ps ln h)
    if id >=? 0 {return id}
    let s:LexScanWord=(ps as int64) - (lx_p as int64)
    id=intern_new(lx_src s ln h)
    lx_nsp=name_tab.ptr
    lx_nhp=name_hash.ptr
    lx_ntp=names.ptr as ptr<ptr<uint8>>
    lx_nmask=LexScanWord(name_tab.length) - 1
    id
}
lx_tail_char=(p:ptr<uint8> i:LexScanWord lim:LexScanWord cnt:LexScanWord c:uint8):>LexScanWord=>$unsafe {
    if c =? 34 or c =? 39 {
        lx_i=i
        lx_count=cnt
        lx_string(false)
        return lx_i
    }
    if c =? 35 {
        lx_hash_check(p i lim cnt)
        return __find_newline(p i lim)
    }
    if c =? 9 or c =? 13 {return i + 1}
    if c =? 92 and p[i + 1] =? 10 {return i + 2}
    lx_bad_char(p i c)
    i + 1
}

# A requested byte span retains its original source positions (lazy bodies).
lex=(file:LexScanWord src:string begin:LexScanWord=0 stop:LexScanWord=-1):>array<Token>=>$unsafe {
    lx_file=file
    lx_src=src
    lx_p=(src as array<uint8>).ptr
    # (a nil string, the zero value, has no bytes and no 0 after them: the empty text's do)
    if lx_p =? (uint64(0) as ptr<uint8>) {lx_p=("" as array<uint8>).ptr}
    lx_n=(src as array<uint8>).length
    if stop >=? 0 {lx_n=stop}
    lx_i=begin
    # (about a token per five bytes of source; in a library file the bodies are mostly skipped)
    let ncap:LexScanWord=(LexScanWord(lx_n) - LexScanWord(lx_i)) // 5 + 16
    if lx_lazy and ncap >? 512 {ncap=512}
    lx_toks=lx_tok_pool
    lx_tok_pool=[]
    if cap(lx_toks) <? ncap {lx_toks.reserve(ncap)}
    __set_len(lx_toks ncap)
    lx_slots=lx_toks.ptr
    lx_count=0
    lx_cap=ncap
    lx_indents.clear()
    lx_indents.push(0)
    lx_decl_lines.clear()
    lx_line_tok0=0
    lx_tab_indent=false
    lx_space_indent=false
    lx_ctx.clear()
    if cap(lx_ctx) <? 64 {lx_ctx.reserve(64)}
    lx_ctx.push((1 << 1) | 1)
    if lx_op_mode =? (uint64(0) as ptr<uint8>) {
        if kw_tok.length =? 0 {init_keywords()}
        if lx_cls =? (uint64(0) as ptr<uint8>) {lx_init_classes()}
        lx_init_op_tables()
    }
    lx_line_start()
    let top_indent:LexScanWord=lx_indents.ptr[LexScanWord(lx_indents.length) - 1]
    let p=lx_p
    let cls=lx_cls
    let op_mode=lx_op_mode
    let at:LexScanWord=(lx_file << 40) | lx_base
    lx_nsp=name_tab.ptr
    lx_nhp=name_hash.ptr
    lx_ntp=names.ptr as ptr<ptr<uint8>>
    lx_nmask=LexScanWord(name_tab.length) - 1
    # (the scan position is local here; the helpers read and move lx_i)
    let lim:LexScanWord=lx_n
    let i:LexScanWord=lx_i
    let cnt:LexScanWord=lx_count
    let lcap:LexScanWord=lx_cap
    let slots=lx_slots
    let ctx_p=lx_ctx.ptr
    let ctx_n:LexScanWord=lx_ctx.length
    let ctx_cap:LexScanWord=cap(lx_ctx)
    loop i <? lim {
        let c=p[i]
        if c =? 32 {
            i += 1
            loop p[i] =? 32 {i += 1}
            if i >=? lim {break}
            c=p[i]
        }
        if cls[c] & 1 not=? 0 {
            if c =? 114 and (p[i + 1] =? 34 or p[i + 1] =? 39) {
                lx_i=i + 1
                lx_count=cnt
                lx_string(true)
                i=lx_i
                cnt=lx_count
                lcap=lx_cap
                slots=lx_slots
                continue
            }
            let s:LexScanWord=i
            i += 1
            loop cls[p[i]] & 2 not=? 0 {i += 1}
            let ln:LexScanWord=i - s
            let ps=p + s
            let id:LexScanWord=-1
            if ln <=? 16 {
                let hu:LexScanUWord=LexScanUWord(ln) * 0x9E3779B97F4A7C15
                if ln >? 8 {
                    hu=(hu xor LexScanUWord((ps as ptr<uint64>)[0])) * 0xBF58476D1CE4E5B9
                    hu=(hu xor (hu >> 31)) xor LexScanUWord(((ps + (ln - 8)) as ptr<uint64>)[0])
                } else if ln >=? 4 {
                    hu=hu xor LexScanUWord((ps as ptr<uint32>)[0]) xor (LexScanUWord(((ps + (ln - 4)) as ptr<uint32>)[0]) << 32)
                } else {
                    hu=hu xor LexScanUWord(ps[0]) xor (LexScanUWord(ps[ln >> 1]) << 8) xor (LexScanUWord(ps[ln - 1]) << 16)
                }
                hu=hu * 0xBF58476D1CE4E5B9
                let h:LexScanWord=(hu xor (hu >> 32)) transmute int64
                let e0=LexScanWord(lx_nsp[h & lx_nmask])
                if e0 not=? 0 {
                    let id0=e0 - 1
                    if lx_nhp[id0] =? h {
                        let hdr=lx_ntp[id0]
                        if (hdr as ptr<int64>)[1] =? ln {
                            hdr=hdr + 24
                            if ln >? 8 {
                                if (hdr as ptr<uint64>)[0] =? (ps as ptr<uint64>)[0] and ((hdr + (ln - 8)) as ptr<uint64>)[0] =? ((ps + (ln - 8)) as ptr<uint64>)[0] {id=id0}
                            } else if ln >=? 4 {
                                if (hdr as ptr<uint32>)[0] =? (ps as ptr<uint32>)[0] and ((hdr + (ln - 4)) as ptr<uint32>)[0] =? ((ps + (ln - 4)) as ptr<uint32>)[0] {id=id0}
                            } else if ln >=? 2 {
                                if (hdr as ptr<uint16>)[0] =? (ps as ptr<uint16>)[0] and ((hdr + (ln - 2)) as ptr<uint16>)[0] =? ((ps + (ln - 2)) as ptr<uint16>)[0] {id=id0}
                            } else if hdr[0] =? ps[0] {id=id0}
                        }
                    }
                }
            }
            if id <? 0 {
                id=lx_intern_slow(ps ln)
            }
            let kind:Tok='ident'
            if id <? kw_tok.length {kind=kw_tok.ptr[id]}
            if cnt =? lcap {
                lx_count=cnt
                lx_grow()
                lcap=lx_cap
                slots=lx_slots
            }
            let sl=slots + cnt
            sl[0].kind = kind
            sl[0].flags = 0
            sl[0].pos = at + s
            sl[0].start = int32<overflow='wrap'>(s)
            sl[0].len = int32<overflow='wrap'>(ln)
            sl[0].ival = id
            cnt += 1
            continue
        }
        let om=op_mode[c]
        if om not=? 0 {
            match om {
                <6> => {
                    let k=lx_tok1[c]
                    let n:LexScanWord=1
                    if p[i + 1] =? 61 {k=lx_tok_eq[c]; n=2}
                    if cnt =? lcap {
                        lx_count=cnt; lx_grow(); lcap=lx_cap; slots=lx_slots
                    }
                    let sl=slots + cnt
                    cnt += 1
                    sl[0].kind = k
                    sl[0].flags = 0
                    sl[0].pos = at + i
                    sl[0].start = int32<overflow='wrap'>(i)
                    sl[0].len = int32<overflow='wrap'>(n)
                    sl[0].ival = 0
                    i += n
                    continue
                }
                <2> => {
                    if cnt =? lcap {
                        lx_count=cnt; lx_grow(); lcap=lx_cap; slots=lx_slots
                    }
                    let tk:LexScanWord=cnt
                    let sl=slots + tk
                    cnt += 1
                    sl[0].kind = lx_tok1[c]
                    sl[0].flags = 0
                    sl[0].pos = at + i
                    sl[0].start = int32<overflow='wrap'>(i)
                    sl[0].len = 1
                    sl[0].ival = 0
                    let opening:LexScanWord=if tk <? 0x7FFFFE {tk + 1} else {0}
                    let entry:LexScanWord=(i << 24) | (opening << 1)
                    if ctx_n =? ctx_cap {
                        __set_len(lx_ctx ctx_n)
                        lx_ctx.push(entry)
                        ctx_p=lx_ctx.ptr; ctx_cap=cap(lx_ctx); ctx_n=lx_ctx.length
                    } else {
                        ctx_p[ctx_n]=entry
                        ctx_n+=1
                    }
                    i += 1
                    continue
                }
                <3> => {
                    if ctx_n >? 1 and (ctx_p[ctx_n - 1] & 1) not=? 0 {
                        __set_len(lx_ctx ctx_n)
                        lx_i=i; lx_count=cnt
                        lx_close_block_ctx(i)
                        cnt=lx_count; lcap=lx_cap; slots=lx_slots
                        ctx_p=lx_ctx.ptr; ctx_cap=cap(lx_ctx); ctx_n=lx_ctx.length
                        top_indent=lx_indents.ptr[LexScanWord(lx_indents.length) - 1]
                    }
                    if ctx_n <=? 1 {__set_len(lx_ctx ctx_n); lx_i=i; lx_count=cnt; lx_err(i "unmatched '{byte_str(int64(c))}'")}
                    let opening:LexScanWord=(ctx_p[ctx_n - 1] >> 1) & 0x7FFFFF
                    if opening >? 0 {slots[opening - 1].ival = cnt}
                    ctx_n-=1
                    if cnt =? lcap {
                        lx_count=cnt; lx_grow(); lcap=lx_cap; slots=lx_slots
                    }
                    let sl=slots + cnt
                    cnt += 1
                    sl[0].kind = lx_tok1[c]
                    sl[0].flags = 0
                    sl[0].pos = at + i
                    sl[0].start = int32<overflow='wrap'>(i)
                    sl[0].len = 1
                    sl[0].ival = 0
                    i += 1
                    continue
                }
                <4> => {
                    if ctx_n >? 1 and (ctx_p[ctx_n - 1] & 1) not=? 0 {
                        __set_len(lx_ctx ctx_n)
                        if lx_line_closes(i + 1) {
                            lx_i=i; lx_count=cnt
                            lx_close_block_ctx(i)
                            cnt=lx_count; lcap=lx_cap; slots=lx_slots
                            ctx_p=lx_ctx.ptr; ctx_cap=cap(lx_ctx); ctx_n=lx_ctx.length
                            top_indent=lx_indents.ptr[LexScanWord(lx_indents.length) - 1]
                        }
                    }
                    if cnt =? lcap {
                        lx_count=cnt; lx_grow(); lcap=lx_cap; slots=lx_slots
                    }
                    let sl=slots + cnt
                    cnt += 1
                    sl[0].kind = 'comma'
                    sl[0].flags = 0
                    sl[0].pos = at + i
                    sl[0].start = int32<overflow='wrap'>(i)
                    sl[0].len = 1
                    sl[0].ival = 0
                    i += 1
                    continue
                }
                <5> => {
                    if cnt =? lcap {
                        lx_count=cnt; lx_grow(); lcap=lx_cap; slots=lx_slots
                    }
                    let sl=slots + cnt
                    cnt += 1
                    sl[0].kind = 'colon'
                    sl[0].flags = 0
                    sl[0].pos = at + i
                    sl[0].start = int32<overflow='wrap'>(i)
                    sl[0].len = 1
                    sl[0].ival = 0
                    i += 1
                    if (ctx_p[ctx_n - 1] & 1) =? 0 {
                        let q:LexScanWord=i
                        loop p[q] =? 32 or p[q] =? 9 or p[q] =? 13 {q += 1}
                        if p[q] =? 35 {
                            loop q <? lim and p[q] not=? 10 {q += 1}
                        }
                        if p[q] =? 10 {
                            lx_indents.push(lx_line_indent)
                            top_indent=lx_line_indent
                            let entry:LexScanWord=(i << 24) | (LexScanWord(lx_indents.length) << 1) | 1
                            if ctx_n =? ctx_cap {
                                __set_len(lx_ctx ctx_n)
                                lx_ctx.push(entry)
                                ctx_p=lx_ctx.ptr; ctx_cap=cap(lx_ctx); ctx_n=lx_ctx.length
                            } else {
                                ctx_p[ctx_n]=entry
                                ctx_n+=1
                            }
                        }
                    }
                    continue
                }
                <1> => {
                    if cnt =? lcap {
                        lx_count=cnt; lx_grow(); lcap=lx_cap; slots=lx_slots
                    }
                    let sl=slots + cnt
                    cnt += 1
                    sl[0].kind = lx_tok1[c]
                    sl[0].flags = 0
                    sl[0].pos = at + i
                    sl[0].start = int32<overflow='wrap'>(i)
                    sl[0].len = 1
                    sl[0].ival = 0
                    i += 1
                    continue
                }
                _ => {
                    lx_count=cnt
                    i=lx_op_multi(p i om c at)
                    cnt=lx_count
                    lcap=lx_cap
                    slots=lx_slots
                    continue
                }
            }
        }
        if c =? 10 {
            if ctx_n =? 1 and (not lx_lazy or cnt =? 0 or slots[cnt - 1].kind not=? 'colon') {
                let q:LexScanWord=i + 1
                loop p[q] =? 32 {q += 1}
                let nc=p[q]
                if q <? lim and nc not=? 10 and nc not=? 35 and nc not=? 9 and nc not=? 13 {
                    let ind:LexScanWord=q - (i + 1)
                    if ind =? top_indent {
                        if cnt >? 0 {
                            let lk=slots[cnt - 1].kind
                            if lk not=? 'newline' and lk not=? 'indent' and lk not=? 'dedent' {
                                if cnt =? lcap {
                                    lx_count=cnt; lx_grow(); lcap=lx_cap; slots=lx_slots
                                }
                                let sl=slots + cnt
                                cnt += 1
                                sl[0].kind = 'newline'
                                sl[0].flags = 0
                                sl[0].pos = at + (i + 1)
                                sl[0].start = int32<overflow='wrap'>(i + 1)
                                sl[0].len = 0
                                sl[0].ival = 0
                            }
                        }
                        lx_line_indent=ind
                        if ind >? 0 {lx_space_indent=true}
                        lx_line_tok0=cnt
                        i=q
                        continue
                    }
                }
            }
            lx_newline_slow(i cnt ctx_n)
            i=lx_i
            cnt=lx_count
            lcap=lx_cap
            slots=lx_slots
            ctx_p=lx_ctx.ptr; ctx_cap=cap(lx_ctx); ctx_n=lx_ctx.length
            top_indent=lx_indents.ptr[LexScanWord(lx_indents.length) - 1]
            continue
        }
        if c >=? 48 and c <=? 57 {
            let s:LexScanWord=i
            let d1=p[i + 1]
            if not (c =? 48 and (d1 =? 120 or d1 =? 88 or d1 =? 98 or d1 =? 66 or d1 =? 111 or d1 =? 79)) {
                let v:LexScanUWord=LexScanUWord(c - 48)
                let q:LexScanWord=i + 1
                loop true {
                    let dc=p[q]
                    if dc >=? 48 and dc <=? 57 {
                        v=v * 10 + LexScanUWord(dc - 48)
                        q += 1
                    } else {break}
                }
                let ec=p[q]
                if q - s <=? 18 and cls[ec] =? 0 and ec not=? 46 and ec not=? 95 {
                    if cnt =? lcap {
                        lx_count=cnt; lx_grow(); lcap=lx_cap; slots=lx_slots
                    }
                    let sl=slots + cnt
                    cnt += 1
                    sl[0].kind = 'int_lit'
                    sl[0].flags = 0
                    sl[0].pos = at + s
                    sl[0].start = int32<overflow='wrap'>(s)
                    sl[0].len = int32<overflow='wrap'>(q - s)
                    sl[0].ival = LexScanWord(v)
                    i=q
                    continue
                }
            }
            lx_i=i
            lx_count=cnt
            lx_number()
            i=lx_i
            cnt=lx_count
            lcap=lx_cap
            slots=lx_slots
            continue
        }
        lx_count=cnt
        i=lx_tail_char(p i lim cnt c)
        cnt=lx_count
        lcap=lx_cap
        slots=lx_slots
    }
    __set_len(lx_ctx ctx_n)
    lx_count=cnt
    lx_i=i
    lx_close_block_ctx(lx_i)
    if lx_ctx.length >? 1 {
        lx_err(lx_ctx[LexScanWord(lx_ctx.length) - 1] >> 24 "this bracket is never closed")
    }
    lx_emit_newline()
    loop lx_indents.length >? 1 {
        lx_indents.pop();
        lx_emit('dedent' lx_i 0)
    }
    lx_emit('eof' lx_i 0)
    # (the parser looks up to LX_SPARE tokens ahead without bounds checks: zeroed slots after
    # the eof read as more eofs, also when the tokens fill the array exactly)
    if LexScanWord(lx_cap) - LexScanWord(lx_count) <? LX_SPARE {
        lx_cap=LexScanWord(lx_count) + LX_SPARE
        if cap(lx_toks) <? lx_cap {lx_toks.reserve(lx_cap)}
        __set_len(lx_toks lx_cap)
        lx_slots=lx_toks.ptr
    }
    mem_set((lx_slots + lx_count) as ptr<uint8> 0 LX_SPARE * size_of<Token>)
    lx_toks.truncate(lx_count)
    lx_slots=uint64(0) as ptr<Token>
    let out=lx_toks
    lx_toks=[]
    out
}

$runtime_checks

from p"ir_types.dewy" import (Op)
from p"ir.jo" import (M_INDEX checked_flags ir_operand_layout kc_epoch kc_fn kc_reg kc_val mulh_ok rotate32_ok)
from p"opt_workspace.dewy" import (
    opt_checked_flags opt_decode opt_kc_epoch opt_kc_fn opt_kc_reg opt_kc_val opt_mulh_ok opt_operands
    opt_rotate32_ok
)
from p"opt.jo" import (o_decode opt_bind_addresses)
from p"opt_rewrite.dewy" import (opt_rewrite)
from p"opt_sra.dewy" import (o_sra sra_nested)

# Decode words are wrapping machine words, as in Jo.
CoreWord:type=int64<overflow='wrap'>

# Compact opcode decoding shared by all optimizer walks. Operands stay in Ins
# and IrFn.args; masks describe their locations rather than copying uses.
o_rewrite_mask=(op:Op):>int64=>match op {
    <'nop'|'block'|'loop'|'end'|'else_'|'br'|'trap'|'zeroslots'|'iconst'|'fconst'|'slot'|'gaddr'|'daddr'|'faddr'|'vzu'> => 0
    <'intr'|'call'|'syscall'> => 16
    <'calli'|'callc'> => 20
    <'if_'|'brif'|'zero'|'brtable'|'assume'> => 1
    <'ret'> => 32
    <'memcpy'|'memset'|'select'|'vop'|'memeq'|'findbyte'|'scanbytes'|'findb'> => 7
    <'load'> => 65
    <'store'> => 131
    <'vst'> => 11
    <'mov'|'neg'|'not_'|'fneg'|'fsqrt'|'fabs'|'ffloor'|'fceil'|'ftrunc'|'sext8'|'sext16'|'sext32'|'zext8'|'zext16'|'zext32'|'i2f'|'u2f'|'f2i'|'f2f'|'bits2f'|'f2bits'|'vsplat'> => 1
    _ => 3
}

o_simplify_kind=(op:Op):>int64=>match op {
    <'iconst'> => 1
    <'mov'> => 2
    <'neg'|'not_'|'sext8'|'sext16'|'sext32'|'zext8'|'zext16'|'zext32'> => 3
    <'overflow_add'|'overflow_sub'|'overflow_mul'|'add'|'sub'|'mul'|'divs'|'divu'|'rems'|'remu'|'and_'|'or_'|'xor'|'shl'|'shrs'|'shru'|'rot32'|'eq'|'ne'|'lts'|'les'|'gts'|'ges'|'ltu'|'leu'|'gtu'|'geu'> => 4
    <'checked_add'|'checked_sub'|'checked_mul'> => 5
    <'select'> => 6
    <'calli'> => 7
    _ => 0
}

# The control class also serves the forward and cleanup cursors. Ordinary
# operations take one direct edge rather than redispatching every control opcode.
o_control_kind=(op:Op):>int64=>match op {
    <'nop'> => 1
    <'block'> => 2
    <'loop'> => 3
    <'if_'> => 4
    <'else_'> => 5
    <'end'> => 6
    <'br'> => 7
    <'brif'> => 8
    <'brtable'> => 9
    <'ret'> => 10
    <'trap'> => 11
    <'call'> => 12
    <'mov'> => 13
    <'copy'> => 14
    <'zeroslots'> => 15
    _ => 0
}

o_bit=(b:bool):>CoreWord=>CoreWord(int64(b))

# Literal unions expose text, not ordinals: this ABI-order list follows Op, as
# ir_operand_layouts does. The twin and descriptor tests check every slot.
o_make_decode=():>array<int64>=>{
    let result:array<int64>=[]
    loop op in [ \
        Op.nop Op.iconst Op.fconst Op.mov Op.add Op.sub Op.mul Op.divs \
        Op.divu Op.rems Op.remu Op.and_ Op.or_ Op.xor Op.shl Op.shrs \
        Op.shru Op.neg Op.not_ Op.eq Op.ne Op.lts Op.les Op.gts \
        Op.ges Op.ltu Op.leu Op.gtu Op.geu Op.fadd Op.fsub Op.fmul \
        Op.fdiv Op.fneg Op.fsqrt Op.fmin Op.fmax Op.ffloor Op.fceil Op.fabs \
        Op.ftrunc Op.feq Op.fne Op.flt Op.fle Op.fgt Op.fge Op.sext8 \
        Op.sext16 Op.sext32 Op.zext8 Op.zext16 Op.zext32 Op.i2f Op.u2f Op.f2i \
        Op.f2f Op.bits2f Op.f2bits Op.load Op.store Op.slot Op.gaddr Op.daddr \
        Op.faddr Op.copy Op.zero Op.memcpy Op.memset Op.zeroslots Op.vop Op.call \
        Op.calli Op.callc Op.syscall Op.intr Op.block Op.loop Op.if_ Op.else_ \
        Op.end Op.br Op.brif Op.ret Op.trap Op.select Op.assume Op.brtable \
        Op.vld Op.vst Op.vbin Op.vsplat Op.vzu Op.mulhs Op.mulhu Op.memeq \
        Op.checked_add Op.checked_sub Op.checked_mul Op.overflow_add Op.overflow_sub Op.overflow_mul Op.rot32 Op.streq \
        Op.findbyte Op.scanbytes Op.findb \
    ] {
        let flags=o_bit(o_defines_classify(op)) | (o_bit(o_pure_classify(op)) << 1) | (o_bit(kills_memory_classify(op)) << 2) | (o_bit(o_retargetable_classify(op)) << 3)
        let control=CoreWord(o_control_kind(op))
        let special=control >=? 1 and control <=? 6 or control =? 8 or control =? 15
        flags=flags | (control << 20) | (o_bit(special) << 24)
        result.push(int64(flags | ((CoreWord(cse_arity_classify(op 0)) + 1) << 4) | (CoreWord(o_rewrite_mask(op)) << 8) | (CoreWord(o_simplify_kind(op)) << 16)))
    }
    result
}

o_pure_classify=(op:Op):>bool=>match op {
    <'select'> => true
    <'iconst'|'fconst'|'mov'|'slot'|'gaddr'|'daddr'|'faddr'|'load'> => true
    <'add'|'sub'|'mul'|'divs'|'divu'|'rems'|'remu'|'and_'|'or_'|'xor'|'shl'|'shrs'|'shru'|'rot32'|'neg'|'not_'|'mulhs'|'mulhu'|'overflow_add'|'overflow_sub'|'overflow_mul'> => true
    <'eq'|'ne'|'lts'|'les'|'gts'|'ges'|'ltu'|'leu'|'gtu'|'geu'> => true
    <'fadd'|'fsub'|'fmul'|'fdiv'|'fneg'|'fsqrt'|'fmin'|'fmax'|'ffloor'|'fceil'|'fabs'|'ftrunc'> => true
    <'feq'|'fne'|'flt'|'fle'|'fgt'|'fge'> => true
    <'sext8'|'sext16'|'sext32'|'zext8'|'zext16'|'zext32'|'i2f'|'u2f'|'f2i'|'f2f'|'bits2f'|'f2bits'> => true
    <'vld'|'vbin'|'vsplat'|'memeq'|'streq'|'findbyte'|'scanbytes'> => true
    _ => false
}

# (results may be replaced by an existing equal value)
cse_arity_classify=(op:Op mode:int64):>int64=>match op {
    <'iconst'|'fconst'|'slot'|'gaddr'|'daddr'|'faddr'> => 0
    <'load'> => if mode & M_INDEX not=? 0 {2} else {1}
    <'neg'|'not_'|'fneg'|'fsqrt'|'ffloor'|'fceil'|'fabs'|'ftrunc'> => 1
    <'sext8'|'sext16'|'sext32'|'zext8'|'zext16'|'zext32'|'i2f'|'u2f'|'f2i'|'f2f'|'bits2f'|'f2bits'> => 1
    <'add'|'sub'|'mul'|'divs'|'divu'|'rems'|'remu'|'and_'|'or_'|'xor'|'shl'|'shrs'|'shru'|'rot32'|'mulhs'|'mulhu'|'overflow_add'|'overflow_sub'|'overflow_mul'> => 2
    <'eq'|'ne'|'lts'|'les'|'gts'|'ges'|'ltu'|'leu'|'gtu'|'geu'> => 2
    <'fadd'|'fsub'|'fmul'|'fdiv'|'fmin'|'fmax'|'feq'|'fne'|'flt'|'fle'|'fgt'|'fge'> => 2
    _ => -1
}

o_defines_classify=(op:Op):>bool=>match op {
    <'nop'|'block'|'loop'|'end'|'else_'|'br'|'brif'|'brtable'|'if_'|'ret'|'trap'|'store'|'copy'|'zero'|'memcpy'|'memset'|'zeroslots'|'assume'|'vop'|'vst'|'vzu'> => false
    _ => true
}

kills_memory_classify=(op:Op):>bool=>match op {
    <'store'|'copy'|'zero'|'memcpy'|'memset'|'zeroslots'|'call'|'calli'|'callc'|'syscall'|'intr'|'vop'> => true
    _ => false
}

# The coarse entry: SRA, then the rewrite group over borrowed tables, target
# policies and constant-cache views. A nested slot store retries once.
let sra_retry:bool=false
optimize=():>void=>$unsafe {
    o_sra()
    let nested=sra_nested
    opt_decode=o_decode
    opt_operands=ir_operand_layout.ptr
    opt_checked_flags=checked_flags
    opt_rotate32_ok=rotate32_ok
    opt_mulh_ok=mulh_ok
    opt_kc_val=kc_val.ptr
    opt_kc_reg=kc_reg.ptr
    opt_kc_epoch=kc_epoch.ptr
    opt_kc_fn=kc_fn
    opt_bind_addresses()
    opt_rewrite()
    if nested and not sra_retry {
        sra_retry=true
        optimize()
        sra_retry=false
    }
}

o_retargetable_classify=(op:Op):>bool=>match op {
    # Native flags consume the operands before assigning the result. Wasm
    # checks the saved operands afterwards, so it must retain a fresh local.
    <'checked_add'|'checked_sub'|'checked_mul'> => checked_flags
    <'add'|'sub'|'mul'|'divs'|'divu'|'rems'|'remu'|'and_'|'or_'|'xor'|'shl'|'shrs'|'shru'|'rot32'|'neg'|'not_'|'load'|'mov'|'mulhs'|'mulhu'|'memeq'|'streq'|'findbyte'|'scanbytes'|'overflow_add'|'overflow_sub'|'overflow_mul'> => true
    <'eq'|'ne'|'lts'|'les'|'gts'|'ges'|'ltu'|'leu'|'gtu'|'geu'> => true
    <'fadd'|'fsub'|'fmul'|'fdiv'|'fneg'|'fsqrt'|'fmin'|'fmax'|'ffloor'|'fceil'|'fabs'|'ftrunc'> => true
    <'sext8'|'sext16'|'sext32'|'zext8'|'zext16'|'zext32'|'i2f'|'u2f'|'f2i'|'f2f'|'bits2f'|'f2bits'|'fconst'|'iconst'> => true
    _ => false
}

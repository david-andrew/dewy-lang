$runtime_checks
from p"ast.jo" import (nodes nkids nkids2 kid kid2)
from p"check.jo" import (locals LF_ELEMALIAS)
from p"expr.jo" import (IN)
from p"isolation_ops.dewy" import (isolation_children isolation_intrinsic ambient_sharing_stable)
# Node.aux retains its existing symbol-kind encoding (local 1, global 2).
UQWord:type=int64<overflow='wrap'>
let uq_written:array<int64>=[]
let uq_escaped:array<int64>=[]
let uq_lambda=false
let uq_calls=false
uq_scan=(n:UQWord ctx:UQWord):>void=>$unsafe {
    # ctx: 0 = the value escapes (copied, passed, captured), 1 = indexed read, 2 = indexed write
    if n =? 0 {return}
    let k=nodes.ptr[n].kind
    # An unclassified operation may also affect its local actuals. Merely
    # marking ambient calls would still allow caching a private local array.
    let mask=isolation_children(k)
    if mask <? 0 or k =? 'intrinsic' and not isolation_intrinsic(nodes.ptr[n].aux as IN) {
        uq_lambda=true
        return
    }
    if k =? 'lambda' {
        uq_lambda=true
        return
    }
    if not ambient_sharing_stable(n) {uq_calls=true}
    if k =? 'ident' and nodes.ptr[n].aux =? 1 and UQWord(locals.ptr[UQWord(nodes.ptr[n].sym)].flags) & LF_ELEMALIAS not=? 0 {
        # (as fp_scan: its array is written where the body does not show; left as it is)
        let b:UQWord=UQWord(nodes.ptr[UQWord(locals.ptr[UQWord(nodes.ptr[n].sym)].alias)].a)
        if nodes.ptr[b].kind =? 'ident' and nodes.ptr[b].aux =? 1 {uq_escaped.push(UQWord(nodes.ptr[b].sym))}
        return
    }
    if k =? 'ident' {
        if nodes.ptr[n].aux =? 1 {
            if ctx =? 2 {uq_written.push(UQWord(nodes.ptr[n].sym))}
            else if ctx =? 0 {uq_escaped.push(UQWord(nodes.ptr[n].sym))}
        }
        return
    }
    if k =? 'index' {
        uq_scan(UQWord(nodes.ptr[n].a) if nodes.ptr[n].aux =? 1 {0} else {1})
        uq_scan(UQWord(nodes.ptr[n].b) 0)
        return
    }
    if k =? 'field' {
        uq_scan(UQWord(nodes.ptr[n].a) 1)
        return
    }
    if k =? 'assign' {
        uq_target(UQWord(nodes.ptr[n].a))
        uq_scan(UQWord(nodes.ptr[n].b) 0)
        return
    }
    if k =? 'intrinsic' {
        let id=nodes.ptr[n].aux as IN
        if nkids(n) >? 0 and (id =? IN.len or id =? IN.arrcap or id =? IN.push or id =? IN.pop or id =? IN.insert or id =? IN.remove or id =? IN.clear or id =? IN.reserve or id =? IN.resize or id =? IN.truncate or id =? IN.extend) {
            uq_scan(kid(n 0) 1)
            loop i in [1..nkids(n)) {uq_scan(kid(n i) 0)}
            return
        }
    }
    if mask & 1 not=? 0 {uq_scan(UQWord(nodes.ptr[n].a) 0)}
    if mask & 2 not=? 0 {uq_scan(UQWord(nodes.ptr[n].b) 0)}
    if mask & 4 not=? 0 {uq_scan(UQWord(nodes.ptr[n].c) 0)}
    if mask & 16 not=? 0 {
        loop i in [0..nkids(n)) {uq_scan(kid(n i) 0)}
    }
    if mask & 32 not=? 0 {
        loop i in [0..nkids2(n)) {uq_scan(kid2(n i) 0)}
    }
}
# assignment target: elements of an indexed array (possibly a field of one) are writes
uq_target=(t:UQWord):>void=>$unsafe {
    if not ambient_sharing_stable(t) {uq_calls=true}
    let k=nodes.ptr[t].kind
    if k =? 'index' {
        uq_scan(UQWord(nodes.ptr[t].a) 2)
        uq_scan(UQWord(nodes.ptr[t].b) 0)
    }
    else if k =? 'field' {uq_target(UQWord(nodes.ptr[t].a))}
    else {uq_scan(t 0)}
}

# ---------------- "did you mean" ----------------
# the closest of the candidate names (" (did you mean 'x'?)"), or ""; ties go to the longest
# common prefix, and a short name that starts the misspelling (len / lenght) counts as close
# (recv: the type whose member was asked for; a habit that names a member, `.length`, is
# told only when that type has it)
suggestion = (name: str, candidates: int[], recv: int = 0) -> str:
    h = habit_name(name)
    if len(h) > 0:
        # (`push` only where there is one: a texture's size is not its len)
        w = h
        if w[0] == '`': w = w[1..len(w) - 1)
        if find(w, "(") > 0 and find(w, " ") < 0: w = w[..find(w, "("))     # (`random_item(xs)`: random_item)
        if find(w, ".") > 0: w = w[find(w, ".") + 1..]                       # (`xs.remove(0)`: remove)
        known = w == "true" or w == "false" or w == "none" or find(w, " ") >= 0 or find(w, "`") >= 0 or (len(w) > 0 and w[0] == '.')
        if recv != 0 and len(w) > 1 and w[0] == '.':
            e = 1
            loop e < len(w) and is_ident_char(w[e]): e += 1
            member = w[1..e)
            known = receiver_fits((if member == "length": "len" else: member), recv)
        loop c in candidates:
            if known: break
            if name_of(c) == w: known = true
        if known:
            if starts_with(h, "nothing: "): return " (none is needed: {h[9..]})"
            return " (use {h})"
    # (the nearest of them: spelling.dewy)
    spelled: str[]
    loop c in candidates: spelled.push(name_of(c))
    did_you_mean(name, spelled)
# what this language calls a name from another one ("`push`"), or "" (the tables: habits.dewy)
map_habit_name = (name: str) -> str:
    h = habit(name)
    habit_hint(h.dewy_map, h.sloppy_map)
habit_name = (name: str) -> str:
    h = habit(name)
    habit_hint(h.dewy, h.sloppy)
# (a Dewy program is told Dewy's spelling, else Sloppy's unless that is written for Sloppy: its
# types, its commas between arguments, its `mut` and `->`, or a library spelling Dewy has another
# for; a Dewy program is better told nothing than that)
habit_hint = (dewy_text: str, sloppy_text: str) -> str:
    if not ts_dewy: return sloppy_text
    if len(dewy_text) > 0 or len(sloppy_text) == 0: return dewy_text
    surface: str[]
    loop k in dewy_surface_table().keys(): surface.push(name_of(k))
    if sloppy_shaped(sloppy_text, surface): return ""
    sloppy_text
# an example of the annotation for an empty array or map
empty_hint = (nm: str, t0: int) -> str:
    t = prune(t0)
    if ts_dewy:
        if types[t].kind == .array: return " (`let {nm}:array<int64> = []` for an array of integers, `let {nm}:dict<string int64> = []` for a dictionary)"
        if is_map_type(t): return " (`let {nm}:dict<string int64> = []` for a dictionary from text to integers)"
        return ""
    if types[t].kind == .array:
        et = pushed_type(nm)
        if len(et) > 0: return " (`{nm}: {et}[] = []`: an array of {et}s, as pushed later)"
        return " (`{nm}: int[] = []` for an array of ints)"
    if is_map_type(t): return " (`{nm}: \{str: int} = \{}` for a map from text to ints)"
    ""
# enemies = [] and later enemies.push(vec2(...)): the type of what goes in, as written
pushed_type = (nm: str) -> str:
    id = intern(nm)
    loop i in [1..nodes.len()):
        if nodes[i].kind != .call or nkids(i) != 1: continue
        f = int(nodes[i].a)
        if f == 0 or nodes[f].kind != .field or name_of(int(nodes[f].name)) != "push": continue
        r = int(nodes[f].a)
        if r == 0 or nodes[r].kind != .ident or int(nodes[r].name) != id: continue
        x = kid(i, 0)
        xk = nodes[x].kind
        if xk == .str_lit: return "str"
        if xk == .int_lit: return "int"
        if xk == .float_lit: return "f64"
        if xk == .call and nodes[int(nodes[x].a)].kind == .ident:
            cn = name_of(int(nodes[int(nodes[x].a)].name))
            if cn == "rgb" or cn == "rgba" or cn == "hex": return "vec4"
            if cn == "vec2" or cn == "vec3" or cn == "vec4" or cn == "ivec2" or cn == "ivec3" or (len(cn) > 0 and cn[0] >= 'A' and cn[0] <= 'Z'): return cn
    ""
# a variable of this name was declared earlier in the function, in a block that has ended
gone_local_hint = (nm: int, at: int) -> str:
    if cx < 0: return ""
    inst = int(ctxs[cx].inst)
    l = locals.len() - 1
    loop l > 0:
        if int(locals[l].name) == nm and int(locals[l].owner) == inst and locals[l].pos < at and pos_file(locals[l].pos) == pos_file(at):
            ln, c = line_col(locals[l].pos)
            return " (the '{name_of(nm)}' made on line {ln} is inside a block that has ended; give it a value before that block to use it here)"
        l -= 1
    # (pos made in update, used in draw: each function's variables are its own)
    l = locals.len() - 1
    loop l > 0:
        o = int(locals[l].owner)
        if int(locals[l].name) == nm and o != inst and int(locals[l].flags) & LF_DECL != 0 and o > 0 and o < fns.len() and fns[o].decl != 0 and not pos_in_lib(locals[l].pos):
            fname = name_of(int(nodes[int(fns[o].decl)].name))
            ln, c = line_col(locals[l].pos)
            return " (the '{name_of(nm)}' made on line {ln} belongs to {fname}; for both to use it, give it its first value at the top level, outside the functions)"
        l -= 1
    ""
# names visible from the current scope: locals, the module, the standard library, built-ins
visible_names = () -> int[]:
    prelude_demand_all()
    out = check_scopes.names
    loop k, v in modules[cur_mod()].names: out.push(k)
    loop k, v in prelude: out.push(k)
    loop k, v in universe: out.push(k)
    out
type_names = () -> int[]:
    out: int[]
    prelude_demand_all()
    dewy = files[int(modules[cur_mod()].file)].is_dewy
    loop tbl in [modules[cur_mod()].names, prelude, universe]:
        loop k, s in tbl:
            sk = syms[s].kind
            if dewy and universe.get(k) == s and dewy_type_word(name_of(k)) != "": continue
            if sk == .type_ or sk == .struct_ or sk == .enum_: out.push(k)
    out
# functions that could be called as recv.f(...): their first parameter has the receiver's kind
method_names = (recv: int) -> int[]:
    prelude_demand_all()
    out: int[]
    rt = prune(recv)
    tables = [modules[cur_mod()].names, prelude]
    loop tm in method_modules(rt):
        if tm != cur_mod(): tables.push(modules[tm].names)
    loop tbl in tables:
        loop k, s0 in tbl:
            s = s0
            loop s != 0:
                if syms[s].kind == .fns and syms[s].decl != 0 and nkids(int(syms[s].decl)) > 0:
                    if method_decl_for(int(syms[s].decl), rt):
                        out.push(k)
                        break
                s = int(syms[s].next)
    out
# The named part of method_names, for a member being checked rather than a
# diagnostic listing every spelling. Probe complete overload chains in the
# same visible tables; an unrelated name must not demand its signatures.
# O(visible method modules + overloads of name), with indexed name lookup.
method_name_for = (recv: int, name: int) -> bool:
    demand_name(name)
    rt = prune(recv)
    tables = [modules[cur_mod()].names, prelude]
    loop tm in method_modules(rt):
        if tm != cur_mod(): tables.push(modules[tm].names)
    loop tbl in tables:
        s = tbl.get(name) ?? 0
        loop s != 0:
            if syms[s].kind == .fns and syms[s].decl != 0 and nkids(int(syms[s].decl)) > 0:
                if method_decl_for(int(syms[s].decl), rt): return true
            s = int(syms[s].next)
    false

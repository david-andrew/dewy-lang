w_region = () -> int:
    if target_macos: return MACHO_WATCH_AT
    WATCH_REGION
w_region_size = () -> int:
    if target_macos: return MACHO_WATCH_SIZE
    WATCH_REGION_SIZE
wm_clear = ():
    wm_fkeys = []
    wm_fcanon = []
    wm_flatest = []
    wm_fhash = []
    wm_fidx = {}
    wm_gkeys = []
    wm_gaddr = []
    wm_gsize = []
    wm_gsig = []
    wm_ginit = []
    wm_gdesc = []
    wm_gidx = {}
    wm_ro = {}
    wm_stubs = []
    wm_files = []
wm_add_fn = (k: str, canon: int, latest: int, h: int):
    wm_fidx[k] = wm_fkeys.len()
    wm_fkeys.push(k)
    wm_fcanon.push(canon)
    wm_flatest.push(latest)
    wm_fhash.push(h)
wm_add_glob = (k: str, addr: int, size: int, sig: str, ih: int, desc: str):
    if let i = wm_gidx.get(k):
        wm_gaddr[i] = addr
        wm_gsize[i] = size
        wm_gsig[i] = sig
        wm_ginit[i] = ih
        wm_gdesc[i] = desc
        return
    wm_gidx[k] = wm_gkeys.len()
    wm_gkeys.push(k)
    wm_gaddr.push(addr)
    wm_gsize.push(size)
    wm_gsig.push(sig)
    wm_ginit.push(ih)
    wm_gdesc.push(desc)
# ---- hashing ----
wh_byte = (h: int, b: int) -> int: (h xor (b & 255)) * 1099511628211
wh_int = (h0: int, v: int) -> int:
    h = h0
    loop k in [0..8): h = wh_byte(h, v >> (8 * k))
    h
wh_str = (h0: int, s: str) -> int:
    h = h0
    loop c in s: h = wh_byte(h, int(c))
    wh_byte(h, 0)
# ---- stable names for what a build contains ----
wk_mod = (m: int) -> str:
    if m < 0 or m >= modules.len(): return "?"
    files[int(modules[m].file)].path
wk_inst = (f: int) -> str:
    s = fns[f].sym
    base = s
    if starts_with(base, "f_"): base = base[2..]
    u = rfind(base, "_")
    if u > 0: base = base[..u)
    t = ""
    if fns[f].fntype != 0: t = wk_sig(int(fns[f].fntype), 0)
    ta = ""
    loop a in fns[f].targs: ta = "{ta},{wk_sig(a, 0)}"
    family = ""
    if fns[f].kind == FK_LAMBDA and fns[f].target != 0: family = wk_poly_layout(int(fns[f].target), 0)
    "{wk_mod(int(fns[f].mod))}|{base}|{fns[f].kind}|{t}|{ta}|{family}"
wk_lambda_keys = ():
    wk_lam = {}
    insts: int[]
    encl: int[]
    loop i in [0..lfuncs.len()):
        if lfuncs[i].kind != LK_INST: continue
        f = lfuncs[i].inst
        if f < 0 or fns[f].kind != FK_LAMBDA or fns[f].decl == 0: continue
        insts.push(f)
        encl.push(wk_enclosing(f))
    loop k in 0.. and f in insts:
        p = nodes[int(fns[f].decl)].pos
        rank = 0
        loop j in 0.. and g in insts:
            if encl[j] == encl[k] and nodes[int(fns[g].decl)].pos < p: rank += 1
        caps = ""
        loop c in fns[f].caps:
            inn = int(c.inner)
            mode = int(locals[inn].flags) & LF_VALUECAP
            caps = "{caps},{name_of(int(locals[inn].name))}:{type_str(store_type(inn))}:{mode}"
        en = "?"
        if encl[k] != 0 and nodes[encl[k]].name != 0: en = name_of(int(nodes[encl[k]].name))
        t = ""
        if fns[f].fntype != 0: t = wk_sig(int(fns[f].fntype), 0)
        ta = ""
        loop a in fns[f].targs: ta = "{ta},{wk_sig(a, 0)}"
        family = ""
        if fns[f].target != 0: family = wk_poly_layout(int(fns[f].target), 0)
        wk_lam[f] = "{wk_mod(int(fns[f].mod))}|lambda@{en}#{rank}|{FK_LAMBDA}|{t}|{caps}|{ta}|{family}"
# the top-level declaration a lambda is written in (0: none found)
wk_enclosing = (f: int) -> int:
    p = nodes[int(fns[f].decl)].pos
    m = int(fns[f].mod)
    if m < 0 or m >= modules.len(): return 0
    best = 0
    loop d in modules[m].decls:
        dp = nodes[d].pos
        if pos_file(dp) == pos_file(p) and dp <= p and (best == 0 or dp > nodes[best].pos): best = d
    best
# a key per lfunc ("" for those without code); the same key in two builds is the same function
wk_fn_keys = () -> str[]:
    wk_lambda_keys()
    out: str[]
    seen: {str: int} = {}
    loop i in [0..lfuncs.len()):
        if i >= fn_addr.len() or fn_addr[i] < 0:
            out.push("")
            continue
        k = ""
        if w_mig_lfs.get(i) != none: k = "watch-mig|{lfuncs[i].name}"
        else if lfuncs[i].kind == LK_HELPER:
            k = "h|{lfuncs[i].hkind}|{wk_sig(lfuncs[i].htype, 0)}"
            if lfuncs[i].inst >= 0 and lfuncs[i].inst < fns.len() and (lfuncs[i].hkind == .thunk or lfuncs[i].hkind == .partial or lfuncs[i].hkind == .envdrop or lfuncs[i].hkind == .envcopy): k = "{k}|{wk_inst(lfuncs[i].inst)}"
        else if lfuncs[i].inst == w_init_inst: k = "watch-init"
        else if wk_lam.get(lfuncs[i].inst) != none: k = wk_lam[lfuncs[i].inst]
        else: k = wk_inst(lfuncs[i].inst)
        # (the same key twice: numbered in the order found, which builds keep)
        n = seen.get(k) ?? 0
        seen[k] = n + 1
        if n > 0: k = "{k}#{n}"
        out.push(k)
    out
# what a person calls the function of a key (for messages)
wk_pretty = (k: str) -> str:
    p = split(k, "|")
    if p.len() < 2 or p[0] == "h": return ""
    nm = p[1]
    if p.len() > 2 and p[2] == "{FK_INIT}": return ""
    if starts_with(nm, "lambda@"): return "a lambda in {nm[7..rfind(nm, "#"))}"
    if starts_with(nm, "__"): return ""
    nm
wk_glob = (g: int) -> str: "{wk_mod(int(globals[g].mod))}|{name_of(int(globals[g].name))}"
# the layout of a type, as far as code depends on it
wk_sig = (t0: int, depth: int) -> str:
    t = prune(t0)
    k = types[t].kind
    if k == .polyfn: return wk_poly_layout(int(types[t].st), depth)
    if depth > 6: return type_str(t)
    if k == .fn_ or k == .cfn:
        out = "{k}:{types[t].mutmask}:{name_of(int(types[t].st))}("
        loop i in [0..int(types[t].nargs)): out += wk_sig(targ(t, i), depth + 1) + ","
        return out + ")->" + wk_sig(int(types[t].elem), depth + 1)
    if k == .struct_ or k == .enum_:
        si = int(types[t].st)
        out = "{type_str(t)}:{tsize(t)}("
        loop i in [0..int(structs[si].nfields)):
            f = int(structs[si].fields) + i
            out = "{out}{name_of(int(fields[f].name))}={wk_sig(field_store_type(f), depth + 1)}@{fields[f].offset},"
        loop i in [0..int(structs[si].nvariants)):
            v = int(structs[si].variants) + i
            out = "{out}|{name_of(int(variants[v].name))}"
        "{out})"
    else if k == .array or k == .opt or k == .ptr or k == .box: "{k}({wk_sig(int(types[t].elem), depth + 1)})"
    else if k == .fixed: "{k}{fixed_len(t)}({wk_sig(int(types[t].elem), depth + 1)})"
    else if k == .tuple:
        out = "("
        loop fo in field_list(t): out = "{out}{wk_sig(fo.0, depth + 1)},"
        "{out})"
    else: type_str(t)
# Family IDs are compilation-local. Watch keys use source identity, enclosing
# concrete type arguments, and the complete canonical environment layout.
wk_poly_layout = (family: int, depth: int) -> str:
    d = poly_families[family].decl
    out = "generic@{files[pos_file(nodes[d].pos)].path}:{pos_off(nodes[d].pos)}"
    if depth > 6: return out
    loop frame in poly_families[family].scope.frames:
        f = int(frame.inst)
        if f <= 0: continue
        loop t in fns[f].targs: out += "<" + wk_sig(t, depth + 1) + ">"
    env = poly_families[family].envfn
    env_layout(env)
    out += "[{fns[env].env_size}:"
    loop cap in fns[env].caps:
        inner = int(cap.inner)
        mode = int(locals[inner].flags) & (LF_VALUECAP | LF_ASSIGNED | LF_EXPOSED)
        out += "{name_of(int(locals[inner].name))}@{locals[inner].env_off}:{mode}:{is_shared(inner)}=" + wk_sig(store_type(inner), depth + 1) + ","
    out + "]"
# a global's declaration, as text without comments (a change re-runs it)
wk_decl_hash = (g: int) -> int:
    if let h = w_decl_hashes.get(g): return h
    if w_decl_stack.contains(g): return wh_str(WH0, wk_glob(g))
    d = int(globals[g].decl)
    if d == 0: return 0
    w_decl_stack.push(g)
    h = wk_text_hash(nodes[d].pos, WH0)
    # and what it is made from that is not its text: the GPU programs made from shader functions,
    # and files named in it (an image loaded with embed or read_bytes...)
    refs: int[]
    seen: int[]
    h = wk_init_scan(int(nodes[d].b), int(globals[g].mod), h, refs, seen)
    w_decl_deps[g] = refs
    loop other in refs:
        h = wh_str(h, wk_glob(other))
        h = wh_int(h, wk_decl_hash(other))
    w_decl_stack.pop()
    w_decl_hashes[g] = h
    h
# the text of the statement or declaration at p (without comments)
wk_text_hash = (p: int, h0: int) -> int:
    f = pos_file(p)
    if f < 0 or f >= files.len(): return h0
    src = files[f].src
    i = pos_off(p)
    h = h0
    # its line, and the lines after it indented more (or blank)
    ls = i
    loop ls > 0 and src[ls - 1] != '\n': ls -= 1
    ind = i - ls
    first = true
    loop i < len(src):
        e = find_byte(src, '\n', i)
        if e < 0: e = len(src)
        line = src[i..e)
        if not first:
            t = trim(line)
            lead = len(line) - len(trim_start(line))
            if len(t) > 0 and lead <= ind: break
        first = false
        h = wh_str(h, trim(line[..repl_code_end(line))))
        i = e + 1
    h
# the program's top-level statements (not declarations), which run once, at start
wk_top_hash = () -> int:
    h = WH0
    loop m in modules:
        if m.is_prelude: continue
        loop d in m.inits:
            if has_flag(d, NF_GLOBAL) or nodes[d].pos == 0: continue
            h = wk_text_hash(nodes[d].pos, h)
    h
wk_loop = () -> int:
    out = 0
    if update_fn != 0: out = 1
    if draw_present(): out |= 2
    out
# Follow statically resolved calls made by an initializer. Merely creating a
# closure does not execute its body. Each specialization is scanned once per
# initializer, including mutually recursive helpers; indirect calls stay opaque.
wk_init_scan = (n: int, m: int, h0: int, refs: mut int[], seen: mut int[]) -> int:
    if n <= 0 or n >= nodes.len(): return h0
    h = h0
    k = nodes[n].kind
    if k == .lambda or k == .fnref and nodes[n].aux != 2: return h
    if k == .ident and nodes[n].aux == i32(int(SK.global)):
        g = int(nodes[n].sym)
        if not refs.contains(g): refs.push(g)
    if k == .call and (nodes[n].aux == 0 or nodes[n].aux == 1 and nodes[int(nodes[n].a)].kind == .fnref and nodes[int(nodes[n].a)].aux == 2):
        f = if nodes[n].aux == 0: int(nodes[n].sym) else: int(nodes[int(nodes[n].a)].sym)
        if f > 0 and f < fns.len() and not seen.contains(f):
            seen.push(f)
            h = wk_init_scan(int(fns[f].body), int(fns[f].mod), h, refs, seen)
    if k == .intrinsic and nodes[n].aux == i32(int(IN.shader)):
        if let src = glsl_of.get(n): h = wh_str(h, src)
    if k == .str_lit:
        nm = name_of(int(nodes[n].sval))
        if len(nm) > 0 and len(nm) < 400 and find_byte(nm, '\n') < 0:
            p = nm
            if not starts_with(p, "/") and m >= 0 and m < modules.len() and file_exists("{modules[m].dir}/{nm}"): p = "{modules[m].dir}/{nm}"
            if file_exists(p):
                if let b = read_file(p):
                    h = wh_str(h, b)
                    if not w_assets.contains(p): w_assets.push(p)
    h = wk_init_scan(int(nodes[n].a), m, h, refs, seen)
    h = wk_init_scan(int(nodes[n].b), m, h, refs, seen)
    h = wk_init_scan(kid_c(n), m, h, refs, seen)
    h = wk_init_scan(kid_d(n), m, h, refs, seen)
    loop i in [0..nkids(n)): h = wk_init_scan(kid(n, i), m, h, refs, seen)
    loop i in [0..nkids2(n)): h = wk_init_scan(kid2(n, i), m, h, refs, seen)
    h
watch_record_image = ():
    wm_clear()
    keys = wk_fn_keys()
    relocs_collect()
    if env("DEWY_WATCH_TRACE") != none: watch_trace(keys)
    loop i in [0..keys.len()):
        if len(keys[i]) == 0: continue
        a = img_text_addr + fn_addr[i]
        wm_add_fn(keys[i], a, a, fn_hash(i, keys))
    loop k, off in global_off:
        wd_path = []
        wm_add_glob(wk_glob(k), img_data_addr + off, gsize(k), wk_sig(int(globals[k].type), 0), wk_decl_hash(k), wd_desc(int(globals[k].type)))
    wm_add_glob("__sp0", img_data_addr, 8, "", 0, "")
    loop i in [0..ffi_offs.len()): wm_add_glob(ffi_keys[i], img_data_addr + ffi_offs[i], 8, "", 0, "")
    loop k in [0..ro_starts.len()):
        h = ro_item_hash(k)
        if wm_ro.get(h) == none: wm_ro[h] = img_ro_addr + ro_starts[k]
    wm_stubs = []
    loop s in stub_addr:
        if s >= 0: wm_stubs.push(img_text_addr + s)
        else: wm_stubs.push(0)
    wm_next = WATCH_REGION + 4096           # (after the first page: the region's mark)
    # (macOS: the region holds the program's own code too)
    if target_macos: wm_next = MACHO_WATCH_CODE + ((code.len() + 15) & ~15) + rodata.len()
    wm_data_next = align_up(img_data_addr + data_size + 8, 16)
    wm_data_end = img_data_addr + data_size + 8 + WATCH_DATA_RESERVE
    wm_game = not test_mode and (update_fn != 0 or draw_present())
    wm_loop = wk_loop()
    wm_top = wk_top_hash()
    wm_files_collect()
draw_present = () -> bool:
    loop m in modules:
        if m.is_main: return m.names.get(intern("draw")) != none
    false
wm_files_collect = ():
    wm_files = []
    loop m in modules: wm_files.push(files[int(m.file)].path)
    # A newly created, higher-priority named module can replace a fallback.
    loop p in w_missing_inputs:
        if not wm_files.contains(p): wm_files.push(p)
    loop a in w_assets:
        if not wm_files.contains(a): wm_files.push(a)
    loop a in embedded_files:
        if not wm_files.contains(a): wm_files.push(a)
gsize = (g: int) -> int:
    sz = tsize(int(globals[g].type))
    if sz < 8: sz = 8
    sz
rl_len = (r: int) -> int:
    if rl_form[r] == 2: return 8
    4
relocs_collect = ():
    g_offs = []
    g_ids = []
    pairs: int[]
    loop k, off in global_off: pairs.push(k)
    pairs.sort_by((g: int): global_off[g])
    loop g in pairs:
        g_offs.push(global_off[g])
        g_ids.push(g)
    order: int[]
    # (arm64: calls by BL, function addresses by ADRP + ADD, as x86-64's calls and data)
    cf = call_fix
    df = data_fix
    sf = stub_fix
    forms: int[]
    if target_arm64:
        cf = a_call_fix + a_faddr_fix
        df = a_data_fix
        sf = a_stub_fix
        loop f in a_call_fix: forms.push(1)
        loop f in a_faddr_fix: forms.push(2)
        loop f in a_data_fix: forms.push(2)
        loop f in a_stub_fix: forms.push(1)
    n = cf.len() + df.len() + sf.len()
    pos_all: int[]
    loop f in cf: pos_all.push(f.0)
    loop f in df: pos_all.push(f.0)
    loop f in sf: pos_all.push(f.0)
    loop i in [0..n): order.push(i)
    order.sort_by((i: int): pos_all[i])
    rl_pos = []
    rl_kind = []
    rl_tgt = []
    rl_off = []
    rl_form = []
    nc = cf.len()
    nd = df.len()
    loop i in order:
        rl_pos.push(pos_all[i])
        if target_arm64: rl_form.push(forms[i])
        else: rl_form.push(0)
        if i < nc:
            rl_kind.push(0)
            rl_tgt.push(cf[i].1)
            rl_off.push(0)
        else if i < nc + nd:
            f = df[i - nc]
            if f.1 == 0:
                it = ro_item_of(f.2)
                rl_kind.push(1)
                rl_tgt.push(it)
                rl_off.push(f.2 - ro_starts[it])
            else if ffi_slot.get(f.2) != none:
                rl_kind.push(4)
                rl_tgt.push(f.2)
                rl_off.push(0)
            else:
                g = global_at(f.2)
                rl_kind.push(2)
                rl_tgt.push(g)
                if g < 0: rl_off.push(f.2)
                else: rl_off.push(f.2 - global_off[g])
        else:
            rl_kind.push(3)
            rl_tgt.push(sf[i - nc - nd].1)
            rl_off.push(0)
ro_item_of = (off: int) -> int:
    lo = 0
    hi = ro_starts.len()
    loop lo < hi:
        mid = (lo + hi) / 2
        if ro_starts[mid] <= off: lo = mid + 1
        else: hi = mid
    if lo == 0: ice("read-only data at {off} is in no item")
    lo - 1
ro_item_end = (k: int) -> int:
    if k + 1 < ro_starts.len(): return ro_starts[k + 1]
    rodata.len()
ro_item_hash = (k: int) -> int:
    h = WH0
    loop j in [ro_starts[k]..ro_item_end(k)): h = wh_byte(h, int(rodata[j]))
    h
# the global holding data offset off (-1: the initial stack pointer's word at 0)
global_at = (off: int) -> int:
    if off < 8: return -1
    lo = 0
    hi = g_offs.len()
    loop lo < hi:
        mid = (lo + hi) / 2
        if g_offs[mid] <= off: lo = mid + 1
        else: hi = mid
    if lo == 0: ice("data at {off} is in no global")
    g = g_ids[lo - 1]
    if off >= g_offs[lo - 1] + gsize(g): ice("data at {off} is in no global")
    g
# the first reference at or after code position p
rl_first = (p: int) -> int:
    lo = 0
    hi = rl_pos.len()
    loop lo < hi:
        mid = (lo + hi) / 2
        if rl_pos[mid] < p: lo = mid + 1
        else: hi = mid
    lo
# a function's code with what it refers to by name rather than by place: equal hashes in two
# builds mean the same code
fn_hash = (lf: int, keys: str[]) -> int:
    s = fn_addr[lf]
    e = s + fn_len[lf]
    h = WH0
    r = rl_first(s)
    p = s
    loop p < e:
        if r < rl_pos.len() and rl_pos[r] == p:
            h = wh_int(h, p - s)
            h = wh_str(h, rl_name(r, keys))
            h = wh_int(h, rl_off[r])
            # (arm64: the instructions without their offsets)
            if rl_form[r] == 1: h = wh_int(h, rd32(p) & 0xFC000000)
            else if rl_form[r] == 2:
                h = wh_int(h, rd32(p) & 0x9F00001F)
                h = wh_int(h, rd32(p + 4) & 0xFFC003FF)
            p += rl_len(r)
            r += 1
        else:
            h = wh_byte(h, int(code[p]))
            p += 1
    h
rl_name = (r: int, keys: str[]) -> str:
    k = rl_kind[r]
    t = rl_tgt[r]
    if k == 0: return "F{keys[t]}"
    if k == 1: return "R{ro_item_hash(t)}"
    if k == 2:
        if t < 0: return "G__sp0"
        return "G{wk_glob(t)}"
    if k == 4: return "G{ffi_keys[ffi_slot[t]]}"
    "S{t}"
watch_globals_to_init = () -> int[]:
    out: int[]
    loop k, off in global_off:
        key = wk_glob(k)
        if let i = wm_gidx.get(key):
            if wm_ginit[i] == wk_decl_hash(k):
                # (unchanged, or a layout to convert: watch_globals_to_migrate)
                if wm_gsig[i] == wk_sig(int(globals[k].type), 0) or len(wm_gdesc[i]) > 0: continue
        if globals[k].decl == 0: continue
        out.push(k)
    out.sort()
    # Module registration order can differ from initialization order. Initialize
    # changed dependencies before their consumers, including across imports.
    ordered: int[]
    seen: int[]
    loop g in out: wk_init_order(g, out, seen, ordered)
    ordered
wk_init_order = (g: int, selected: int[], seen: mut int[], out: mut int[]):
    if seen.contains(g): return
    seen.push(g)
    if let deps = w_decl_deps.get(g):
        loop other in deps:
            if selected.contains(other): wk_init_order(other, selected, seen, out)
    out.push(g)
# (after the program's functions are lowered) a function initializing them, lowered too (the
# globals it refers to have room already: the modules' own initialization refers to them)
watch_lower_inits = ():
    decls: int[]
    loop g in watch_globals_to_init():
        d = int(globals[g].decl)
        if nodes[d].b != 0 and nkids(d) == 0:
            if let old = wm_gidx.get(wk_glob(g)):
                if wm_gsig[old] == wk_sig(int(globals[g].type), 0):
                    # Reusing live storage is an assignment, not first-time
                    # initialization: retain the new value and release the old.
                    id = mk(.ident, nodes[d].pos)
                    nodes[id].name = globals[g].name
                    nodes[id].sym = i32(g)
                    nodes[id].aux = i32(int(SK.global))
                    nodes[id].type = globals[g].type
                    add_flag(id, NF_CHECKED)
                    assign = mk(.assign, nodes[d].pos)
                    nodes[assign].op = i32(int(Tok.assign))
                    nodes[assign].a = i32(id)
                    nodes[assign].b = nodes[d].b
                    d = assign
        if not decls.contains(d): decls.push(d)
    w_init_inst = new_inst(FK_INIT, 0, "watch_init")
    b = mk(.block, 0)
    set_list(b, decls)
    fns[w_init_inst].body = i32(b)
    fns[w_init_inst].ret = i32(T_VOID)
    fns[w_init_inst].state = 2
    nl = lfuncs.len()
    w_init_lf = lf_of_inst(w_init_inst)
    i = nl
    loop i < lfuncs.len():
        lower_function(i)
        if opt_release: rel_collect()
        else: emit_function()
        i += 1
# ---- a patch for the running program ----
# messages (lib/std/watch.jo): words [op, a, b], then for op 1 and 4 b bytes
#   1 write the bytes at address a    2 run the function at a    3 jump from a to b
#   4 show text over the game (a: 1 for errors; empty: nothing)   5 the end: apply
wp_put = (op: int, a: int, bytes: u8[]):
    push_i64(w_patch, op)
    push_i64(w_patch, a)
    push_i64(w_patch, bytes.len())
    loop x in bytes: w_patch.push(x)
wp_jump = (from: int, to: int):
    push_i64(w_patch, 3)
    push_i64(w_patch, from)
    push_i64(w_patch, to)
wp_run = (a: int):
    push_i64(w_patch, 2)
    push_i64(w_patch, a)
    push_i64(w_patch, 0)
wp_end = ():
    push_i64(w_patch, 5)
    push_i64(w_patch, 0)
    push_i64(w_patch, 0)
w_place = (n: int) -> int:
    a = align_up(wm_next, 16)
    wm_next = a + n
    if wm_next > w_region() + w_region_size(): fatal(0, "dewy-core watch: no room left for new code (restart the program: r)")
    a
# (DEWY_WATCH_TRACE=file: each function's key, then what its code refers to and its bytes)
watch_trace = (keys: str[]):
    out = ""
    loop i in [0..keys.len()):
        if len(keys[i]) == 0: continue
        out += "{keys[i]}\n"
        s = fn_addr[i]
        r = rl_first(s)
        loop r < rl_pos.len() and rl_pos[r] < s + fn_len[i]:
            out += "  @{rl_pos[r] - s} {rl_name(r, keys)}+{rl_off[r]}\n"
            if rl_kind[r] == 1:
                t = rl_tgt[r]
                b = ""
                loop q in [ro_starts[t]..ro_item_end(t)):
                    c = rodata[q]
                    if c >= 32 and c < 127: b += str_from_bytes(rodata[q..q + 1))
                    else: b += "\\{int(c)}"
                out += "   = ({ro_item_end(t) - ro_starts[t]}) {b}\n"
            r += 1
        h = ""
        loop p in [s..s + fn_len[i]): h += "{int(code[p])} "
        out += "  {h}\n"
    write_file(env("DEWY_WATCH_TRACE") ?? "", out)
watch_make_patch = () -> bool:
    w_patch = []
    w_changed = []
    w_reset = []
    w_added = []
    keys = wk_fn_keys()
    relocs_collect()
    if env("DEWY_WATCH_TRACE") != none: watch_trace(keys)
    inits = watch_globals_to_init()
    w_kept = []
    loop g in w_migrate:
        nm = name_of(int(globals[g].name))
        if not starts_with(nm, "__"): w_kept.push(nm)
    loop g in inits:
        nm = name_of(int(globals[g].name))
        if starts_with(nm, "__"): continue
        if wm_gidx.get(wk_glob(g)) == none: w_added.push(nm)
        else: w_reset.push(nm)
    # globals: where each is in the program (new ones, and those whose layout changed, get new
    # room)
    gaddr: {int: int} = {}
    moved: {int: bool} = {}
    loop k, off in global_off:
        key = wk_glob(k)
        sig = wk_sig(int(globals[k].type), 0)
        ih = wk_decl_hash(k)
        sz = gsize(k)
        a = 0
        if let i = wm_gidx.get(key):
            if wm_gsig[i] == sig: a = wm_gaddr[i]
        if a == 0:
            al = talign(int(globals[k].type))
            if al < 16: al = 16
            a = align_up(wm_data_next, al)
            wm_data_next = a + sz
            if wm_data_next > wm_data_end: fatal(0, "dewy-core watch: no room left for new globals (restart the program: r)")
            moved[k] = true
        gaddr[k] = a
        wd_path = []
        wm_add_glob(key, a, sz, sig, ih, wd_desc(int(globals[k].type)))
    ffi_addr: {int: int} = {}
    loop fi in [0..ffi_offs.len()):
        off = ffi_offs[fi]
        k = ffi_keys[fi]
        if let i = wm_gidx.get(k): ffi_addr[off] = wm_gaddr[i]
        else:
            a = align_up(wm_data_next, 8)
            wm_data_next = a + 8
            ffi_addr[off] = a
            wm_add_glob(k, a, 8, "", 0, "")
    # read-only data: what the program does not have yet goes into the code region
    ro_addr = fill(0, ro_starts.len())
    loop k in [0..ro_starts.len()):
        h = ro_item_hash(k)
        if let a = wm_ro.get(h): ro_addr[k] = a
        else:
            n = ro_item_end(k) - ro_starts[k]
            a = w_place(n)
            ro_addr[k] = a
            wm_ro[h] = a
            wp_put(1, a, rodata[ro_starts[k]..ro_item_end(k)))
    # functions: new ones, and those whose code changed or whose globals moved, get new code
    place = fill(0, keys.len())
    loop i in [0..keys.len()):
        k = keys[i]
        if len(k) == 0: continue
        h = fn_hash(i, keys)
        fresh = true
        if let j = wm_fidx.get(k):
            if wm_fhash[j] == h and not refers_moved(i, moved): fresh = false
        if not fresh: continue
        a = w_place(fn_len[i])
        place[i] = a
        if let j = wm_fidx.get(k):
            wm_flatest[j] = a
            wm_fhash[j] = h
            p = wk_pretty(k)
            # (the program's own functions: not the library's, nor what is made for types)
            user = lfuncs[i].kind == LK_INST and lfuncs[i].inst >= 0 and not modules[int(fns[lfuncs[i].inst].mod)].is_prelude
            if user and len(p) > 0 and not w_changed.contains(p): w_changed.push(p)
        else: wm_add_fn(k, a, a, h)
    # their code, with what it refers to where it is in the program
    loop i in [0..keys.len()):
        if place[i] == 0: continue
        a = place[i]
        s = fn_addr[i]
        n = fn_len[i]
        b = code[s..s + n)
        r = rl_first(s)
        loop r < rl_pos.len() and rl_pos[r] < s + n:
            p = rl_pos[r] - s
            k = rl_kind[r]
            t = rl_tgt[r]
            target = 0
            if k == 0:
                target = wm_fcanon[wm_fidx[keys[t]]]
            else if k == 1: target = ro_addr[t] + rl_off[r]
            else if k == 2:
                if t < 0: target = wm_gaddr[wm_gidx["__sp0"]] + rl_off[r]
                else: target = gaddr[t] + rl_off[r]
            else if k == 4: target = ffi_addr[t]
            else: target = wm_stubs[t]
            f = rl_form[r]
            if f == 0:
                d = target - (a + p + 4)
                loop q in [0..4): b[p + q] = u8((d >> (8 * q)) & 255)
            else if f == 1:
                # (BL reaches 128 MB: further, through a veneer in the region)
                if target - (a + p) >= 1 << 27 or target - (a + p) < -(1 << 27): target = w_veneer(target)
                put32(b, p, (get32(b, p) & 0xFC000000) | (((target - (a + p)) / 4) & 0x3FFFFFF))
            else:
                pages = (target >> 12) - ((a + p) >> 12)
                put32(b, p, (get32(b, p) & 0x9F00001F) | ((pages & 3) << 29) | (((pages >> 2) & 0x7FFFF) << 5))
                put32(b, p + 4, (get32(b, p + 4) & 0xFFC003FF) | ((target & 0xFFF) << 10))
            r += 1
        wp_put(1, a, b)
    # replaced functions: a jump from their first address
    loop i in [0..keys.len()):
        if place[i] == 0: continue
        j = wm_fidx[keys[i]]
        if wm_fcanon[j] != place[i]: wp_jump(wm_fcanon[j], place[i])
    # then globals whose layout changed are converted, and new and changed ones initialized
    if w_mig_lf >= 0: w_run_fn(wm_flatest[wm_fidx[keys[w_mig_lf]]])
    if w_init_lf >= 0 and fn_addr.len() > w_init_lf and fn_addr[w_init_lf] >= 0 and inits.len() > 0:
        w_run_fn(wm_flatest[wm_fidx[keys[w_init_lf]]])
    wp_put(4, 0, [])
    wp_end()
    wm_loop = wk_loop()
    wm_top = wk_top_hash()
    wm_files_collect()
    true
get32 = (b: u8[], p: int) -> int: int(b[p]) | (int(b[p + 1]) << 8) | (int(b[p + 2]) << 16) | (int(b[p + 3]) << 24)
put32 = (b: mut u8[], p: int, x: int):
    loop q in [0..4): b[p + q] = u8((x >> (8 * q)) & 255)
w_veneer = (target: int) -> int:
    if let v = w_veneers.get(target): return v
    v = w_place(16)
    b: u8[]
    loop x in [0x58000050, 0xD61F0200, target & 0xFFFFFFFF, (target >> 32) & 0xFFFFFFFF]:     # ldr x16, #8; br x16
        loop q in [0..4): b.push(u8((x >> (8 * q)) & 255))
    wp_put(1, v, b)
    w_veneers[target] = v
    v
# run a function in the program (through an entry that keeps the stack aligned as calls expect)
w_run_fn = (a: int):
    if target_arm64:
        # stp x29, x30, [sp, #-16]!; mov x29, sp; ldr x16, a; blr x16; ldp x29, x30, [sp], #16; ret
        e = w_place(32)
        st: u8[]
        loop x in [0xA9BF7BFD, 0x910003FD, 0x58000090, 0xD63F0200, 0xA8C17BFD, 0xD65F03C0, a & 0xFFFFFFFF, (a >> 32) & 0xFFFFFFFF]:
            loop q in [0..4): st.push(u8((x >> (8 * q)) & 255))
        wp_put(1, e, st)
        wp_run(e)
        return
    e = w_place(16)
    stub: u8[] = [0x48, 0x83, 0xEC, 0x08, 0xE8, 0, 0, 0, 0, 0x48, 0x83, 0xC4, 0x08, 0xC3]
    d = a - (e + 9)
    loop q in [0..4): stub[5 + q] = u8((d >> (8 * q)) & 255)
    wp_put(1, e, stub)
    wp_run(e)
refers_moved = (lf: int, moved: {int: bool}) -> bool:
    if moved.len() == 0: return false
    s = fn_addr[lf]
    r = rl_first(s)
    loop r < rl_pos.len() and rl_pos[r] < s + fn_len[lf]:
        if rl_kind[r] == 2 and rl_tgt[r] >= 0 and moved.get(rl_tgt[r]) != none: return true
        r += 1
    false
w_dir = (f: str) -> str:
    s = rfind(f, "/")
    if s < 0: return "."
    if s == 0: return "/"
    f[..s)
w_base = (f: str) -> str:
    s = rfind(f, "/")
    if s < 0: return f
    f[s + 1..]
watch_missing_input = (path: str):
    # Test watching uses ordinary code generation, but still needs failed
    # import candidates so creating the missing file can recover the build.
    if watch_build or len(w_failed_path) > 0: w_missing_inputs.push(path)
watch_save_failed_inputs = ():
    if len(w_failed_path) == 0: return
    inputs: str[]
    loop f in files: inputs.push(f.path)
    loop f in embedded_files: inputs.push(f)
    loop f in w_assets: inputs.push(f)
    loop f in w_missing_inputs: inputs.push(f)
    write_file(w_failed_path, inputs.join("\n"))
watch_read_failed_inputs = (path: str):
    loop f in split(read_file(path) ?? "", "\n"):
        if len(f) > 0 and not wm_files.contains(f): wm_files.push(f)
    delete_file(path)
watch_write_result = (res: str):
    gm = 0
    if wm_game: gm = 1
    t = "N\t{wm_next}\t{wm_data_next}\t{wm_data_end}\t{gm}\t{wm_loop}\t{wm_top}\n"
    t += "S"
    loop a in wm_stubs: t += "\t{a}"
    t += "\n"
    lines: str[]
    loop i in [0..wm_fkeys.len()): lines.push("F\t{wm_fkeys[i]}\t{wm_fcanon[i]}\t{wm_flatest[i]}\t{wm_fhash[i]}")
    loop i in [0..wm_gkeys.len()): lines.push("G\t{wm_gkeys[i]}\t{wm_gaddr[i]}\t{wm_gsize[i]}\t{wm_ginit[i]}\t{wm_gsig[i]}\t{wm_gdesc[i]}")
    loop h, a in wm_ro: lines.push("R\t{h}\t{a}")
    loop f in wm_files: lines.push("W\t{f}")
    loop c in w_changed: lines.push("C\t{c}")
    loop c in w_reset: lines.push("Z\t{c}")
    loop c in w_added: lines.push("A\t{c}")
    loop c in w_kept: lines.push("K\t{c}")
    t += lines.join("\n")
    out: u8[]
    push_i64(out, len(t))
    loop c in t: out.push(c)
    push_i64(out, w_patch.len())
    loop x in w_patch: out.push(x)
    write_bytes(res, out)
watch_read_result = (res: str) -> bool:
    b = read_bytes(res) ?? []
    if b.len() < 16: return false
    tl = w_i64(b, 0)
    t = str_from_bytes(b[8..8 + tl))
    pl = w_i64(b, 8 + tl)
    w_patch = b[16 + tl..16 + tl + pl)
    wm_clear()
    w_changed = []
    w_reset = []
    w_added = []
    w_kept = []
    loop line in split(t, "\n"):
        p = split(line, "\t")
        if p.len() == 0: continue
        k = p[0]
        if k == "N" and p.len() >= 7:
            wm_next = to_int(p[1]) ?? 0
            wm_data_next = to_int(p[2]) ?? 0
            wm_data_end = to_int(p[3]) ?? 0
            wm_game = p[4] == "1"
            wm_loop = to_int(p[5]) ?? 0
            wm_top = to_int(p[6]) ?? 0
        else if k == "S":
            loop i in [1..p.len()): wm_stubs.push(to_int(p[i]) ?? 0)
        else if k == "F" and p.len() >= 5: wm_add_fn(p[1], to_int(p[2]) ?? 0, to_int(p[3]) ?? 0, to_int(p[4]) ?? 0)
        else if k == "G" and p.len() >= 7: wm_add_glob(p[1], to_int(p[2]) ?? 0, to_int(p[3]) ?? 0, p[5], to_int(p[4]) ?? 0, p[6])
        else if k == "R" and p.len() >= 3: wm_ro[to_int(p[1]) ?? 0] = to_int(p[2]) ?? 0
        else if k == "W" and p.len() >= 2: wm_files.push(p[1])
        else if k == "C" and p.len() >= 2: w_changed.push(p[1])
        else if k == "Z" and p.len() >= 2: w_reset.push(p[1])
        else if k == "A" and p.len() >= 2: w_added.push(p[1])
        else if k == "K" and p.len() >= 2: w_kept.push(p[1])
    true
w_i64 = (b: u8[], at: int) -> int:
    v = 0
    loop k in [0..8): v = v | (int(b[at + k]) << (8 * k))
    v
# (DEWY_WATCH_LOG=1: each step of a reload, to standard error)
w_log = (msg: str):
    if env("DEWY_WATCH_LOG") != none: eprint("dewy-core watch log: {msg}")
w32_note_file = (f: str):
    if w32_mtimes.get(f) == none: w32_mtimes[f] = w32_mtime(f)
# source files in a directory (a new one may be one a failed build looked for)
w32_sources_in = (d: str) -> int:
    n = 0
    loop nm in list_dir(d):
        if (ends_with(nm, ".jo") or (len(w_ext) > 0 and ends_with(nm, w_ext))) and not starts_with(nm, "."): n += 1
    n
# did a file built from change (or a source file appear)? (and take note of how things are now)
w32_files_changed = () -> bool:
    any = false
    now: (str, int)[]
    loop f, t in w32_mtimes:
        m = w32_mtime(f)
        if m != t:
            now.push((f, m))
            any = true
    loop x in now: w32_mtimes[x.0] = x.1
    counts: (str, int)[]
    loop d, n in w32_dir_count:
        c = w32_sources_in(d)
        if c != n:
            counts.push((d, c))
            if c > n: any = true
    loop x in counts: w32_dir_count[x.0] = x.1
    any
wd_desc = (t0: int) -> str:
    t = prune(t0)
    k = types[t].kind
    sz = tsize(t)
    if k == .int_:
        if types[t].sign: return "i{sz};"
        return "u{sz};"
    if k == .float_: return "f{sz};"
    if k == .bool_: return "b;"
    if k == .str_: return "s;"
    if k == .array: return "A{tsize(int(types[t].elem))}({wd_desc(int(types[t].elem))})"
    if k == .fixed: return "F{tsize(int(types[t].elem))},{fixed_len(t)}({wd_desc(int(types[t].elem))})"
    if k == .opt: return "O{tsize(int(types[t].elem))}({wd_desc(int(types[t].elem))})"
    if k == .box: return "B{tsize(int(types[t].elem))}({wd_desc(int(types[t].elem))})"
    if k == .struct_:
        nm = type_str(t)
        if wd_path.contains(nm): return "R<{nm}>;"
        wd_path.push(nm)
        si = int(types[t].st)
        out = "S{sz}<{nm}>\{"
        loop i in [0..int(structs[si].nfields)):
            f = int(structs[si].fields) + i
            out += "{name_of(int(fields[f].name))}@{fields[f].offset}:{wd_desc(field_store_type(f))},"
        wd_path.pop()
        return out + "}"
    if k == .tuple:
        out = "T{sz}\{"
        loop fo in field_list(t): out += "@{fo.1}:{wd_desc(fo.0)},"
        return out + "}"
    "X{sz}<{wk_sig(t, 0)}>;"
# where the description starting at i ends
wd_end = (s: str, i: int) -> int:
    c = s[i]
    if c == 'A' or c == 'O' or c == 'F' or c == 'B':
        j = find_byte(s, '(', i)
        e = wd_end(s, j + 1)
        return e + 1
    if c == 'S' or c == 'T':
        j = find_byte(s, '\{', i)
        if c == 'S':
            # (past the name: <...> may hold any character but '>')
            j = find_byte(s, '\{', find_byte(s, '>', i))
        j += 1
        loop s[j] != '}':
            j = find_byte(s, ':', j) + 1
            j = wd_end(s, j) + 1                # (and the comma)
        return j + 1
    if c == 'X' or c == 'R': return find_byte(s, ';', find_byte(s, '>', i)) + 1
    find_byte(s, ';', i) + 1
wd_num = (s: str, i: int) -> int:
    v = 0
    j = i
    loop j < len(s) and s[j] >= '0' and s[j] <= '9':
        v = v * 10 + int(s[j] - '0')
        j += 1
    v
# the fields of a struct description: (name, offset, description)
wd_fields = (s: str) -> (str, int, str)[]:
    out: (str, int, str)[]
    j = 0
    if s[0] == 'S': j = find_byte(s, '\{', find_byte(s, '>', 0)) + 1
    else: j = find_byte(s, '\{', 0) + 1
    loop s[j] != '}':
        at = find_byte(s, '@', j)
        nm = s[j..at)
        off = wd_num(s, at + 1)
        d0 = find_byte(s, ':', at) + 1
        d1 = wd_end(s, d0)
        out.push((nm, off, s[d0..d1)))
        j = d1 + 1
    out
wd_name = (s: str) -> str:
    a = find_byte(s, '<', 0)
    s[a + 1..find_byte(s, '>', a))
wd_collect = (s: str):
    i = 0
    loop i < len(s):
        if s[i] == 'S' and i + 1 < len(s) and s[i + 1] >= '0' and s[i + 1] <= '9':
            e = wd_end(s, i)
            nm = wd_name(s[i..e))
            if wd_structs.get(nm) == none: wd_structs[nm] = s[i..e)
        i += 1
watch_globals_to_migrate = () -> int[]:
    out: int[]
    loop k, off in global_off:
        if globals[k].decl == 0: continue
        if let i = wm_gidx.get(wk_glob(k)):
            if len(wm_gdesc[i]) == 0 or wm_gsig[i] == wk_sig(int(globals[k].type), 0): continue
            if wm_ginit[i] != wk_decl_hash(k): continue
            out.push(k)
    out.sort()
    out
w_new_lf = (name: str) -> int:
    lfuncs.push(LFunc(LK_HELPER, -1, .drop, 0, name))
    lf = lfuncs.len() - 1
    w_mig_lfs[lf] = true
    lf
watch_lower_migrate = ():
    w_migrate = watch_globals_to_migrate()
    if w_migrate.len() == 0: return
    wd_structs = {}
    loop g in w_migrate: wd_collect(wm_gdesc[wm_gidx[wk_glob(g)]])
    w_mig_lf = w_new_lf("watch_migrate")
    begin_fn("watch_migrate", w_mig_lf)
    loop g in w_migrate:
        i = wm_gidx[wk_glob(g)]
        op = e_iconst(wm_gaddr[i])
        np = e_gaddr(global_off[g])
        wc_conv(wm_gdesc[i], op, np, int(globals[g].type))
    e_ret(-1)
    w_emit()
    # the conversion functions for structs (which may need more)
    k = 0
    loop k < w_mig_todo.len():
        lf = w_mig_todo[k]
        begin_fn("watch_convert_{k}", lf)
        ps = helper_params(2)
        t = w_mig_nt[k]
        si = int(types[prune(t)].st)
        olds = wd_fields(w_mig_od[k])
        loop i in [0..int(structs[si].nfields)):
            f = int(structs[si].fields) + i
            fnm = name_of(int(fields[f].name))
            found = false
            loop of in olds:
                if of.0 == fnm:
                    found = true
                    wc_conv(of.2, e_addi(ps[0], of.1), e_addi(ps[1], int(fields[f].offset)), field_store_type(f))
            if not found: wc_default(f, ps[1])
        e_ret(-1)
        w_emit()
        k += 1
# convert the value at op (laid out as od) into the zeroed place np of type nt
wc_conv = (od: str, op: int, np: int, nt0: int):
    nt = prune(nt0)
    wd_path = []
    nd = wd_desc(nt)
    tk = types[nt].kind
    sz = tsize(nt)
    c = od[0]
    if od == nd:
        # the same layout: a copy (and the references in it are now held twice)
        if vc(nt) == VC_AGG: e_copy(np, op, sz)
        else: store_val(nt, np, 0, load_val(nt, op, 0))
        copy_at(np, nt)
        return
    if c == 'i' or c == 'u' or c == 'f' or c == 'b':
        # a number of another type
        osz = wd_num(od, 1)
        if c == 'b': osz = 1
        mode = osz
        if c == 'i': mode = osz | M_SIGNED
        if c == 'f': mode = osz | M_FLOAT
        ovt = VI
        if c == 'f':
            ovt = VF
            if osz == 4: ovt = VS
        v = e_load(ovt, op, 0, mode)
        if tk == .float_:
            if ovt == VI:
                d = vreg(vt_of(nt))
                emit(.i2f, vt_of(nt), d, v, 0, 0, 0)
                v = d
            else if ovt != vt_of(nt):
                d = vreg(vt_of(nt))
                emit(.f2f, vt_of(nt), d, v, 0, 0, 0)
                v = d
            e_store(np, 0, v, mem_mode(nt))
        else if tk == .int_ or tk == .bool_:
            if ovt != VI:
                d = vreg(VI)
                emit(.f2i, ovt, d, v, 0, 0, 0)
                v = d
            e_store(np, 0, v, mem_mode(nt))
        return
    if (c == 'S' or c == 'R') and tk == .struct_:
        sd = od
        if c == 'R': sd = wd_structs.get(wd_name(od)) ?? ""
        if len(sd) == 0: return
        e_call(wc_struct_fn(sd, nt), [op, np], -1)
        return
    if c == 'A' and tk == .array:
        oes = wd_num(od, 1)
        ed = od[find_byte(od, '(', 0) + 1..len(od) - 1)
        et = int(types[nt].elem)
        nes = tsize(et)
        oa = e_load(VI, op, 0, 8)
        n = vreg(VI)
        e_mov(n, e_iconst(0))
        iff(e_bin(.ne, VI, oa, e_iconst(0)))
        e_mov(n, hdr_load(oa, 8))
        endc()
        na = e_call(rt("__arr_repeat"), [n, e_iconst(nes)], VI)
        e_store(np, 0, na, 8)
        i = vreg(VI)
        e_mov(i, e_iconst(0))
        blk()
        lop()
        brif_to(e_bin(.ges, VI, i, n), ctl - 1)
        oe = e_bin(.add, VI, e_addi(oa, 24), e_bin(.mul, VI, i, e_iconst(oes)))
        ne = e_bin(.add, VI, e_addi(na, 24), e_bin(.mul, VI, i, e_iconst(nes)))
        wc_conv(ed, oe, ne, et)
        e_mov(i, e_addi(i, 1))
        br_to(ctl)
        endc()
        endc()
        return
    if c == 'F' and tk == .fixed:
        # element by element, as many as both sizes have (the rest stays zero)
        oes = wd_num(od, 1)
        on = wd_num(od, find_byte(od, ',', 0) + 1)
        ed = od[find_byte(od, '(', 0) + 1..len(od) - 1)
        et = int(types[nt].elem)
        nes = tsize(et)
        n = min(on, fixed_len(nt))
        i = vreg(VI)
        e_mov(i, e_iconst(0))
        blk()
        lop()
        brif_to(e_bin(.ges, VI, i, e_iconst(n)), ctl - 1)
        wc_conv(ed, e_bin(.add, VI, op, e_bin(.mul, VI, i, e_iconst(oes))), e_bin(.add, VI, np, e_bin(.mul, VI, i, e_iconst(nes))), et)
        e_mov(i, e_addi(i, 1))
        br_to(ctl)
        endc()
        endc()
        return
    if c == 'O' and tk == .opt:
        ops = wd_num(od, 1)
        ed = od[find_byte(od, '(', 0) + 1..len(od) - 1)
        et = int(types[nt].elem)
        iff(e_bin(.ne, VI, e_load(VI, op, ops, 1), e_iconst(0)))
        e_store(np, tsize(et), e_iconst(1), 1)
        wc_conv(ed, op, np, et)
        endc()
        return
    if c == 'B' and tk == .box:
        # (a new box, its value converted)
        ed = od[find_byte(od, '(', 0) + 1..len(od) - 1)
        et = int(types[nt].elem)
        ob = e_load(VI, op, 0, 8)
        iff(e_bin(.ne, VI, ob, e_iconst(0)))
        nb = e_call(rt("__box_new"), [e_iconst(tsize(et))], VI)
        e_zero(e_addi(nb, BOX_HDR), tsize(et))
        e_store(np, 0, nb, 8)
        wc_conv(ed, e_addi(ob, BOX_HDR), e_addi(nb, BOX_HDR), et)
        endc()
        return
    if c == 'T' and tk == .tuple:
        olds = wd_fields(od)
        news = field_list(nt)
        if olds.len() != news.len(): return
        loop i in 0.. and fo in news: wc_conv(olds[i].2, e_addi(op, olds[i].1), e_addi(np, fo.1), fo.0)
        return
    # (anything else: no value kept)
wc_struct_fn = (sd: str, nt: int) -> int:
    key = "{sd}|{type_str(nt)}"
    if let lf = w_mig_fns.get(key): return lf
    lf = w_new_lf("watch_convert")
    w_mig_fns[key] = lf
    w_mig_todo.push(lf)
    w_mig_od.push(sd)
    w_mig_nt.push(nt)
    lf

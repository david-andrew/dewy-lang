$runtime_checks
from p"checks_thin_expr.dewy" import (subst_partial)
from p"refine_metadata.dewy" import (representation_type)
from p"checks_thin.dewy" import (push_type_params resolve_type)
from p"expression_types.dewy" import (ntype)
from p"checker_scope_symbols.dewy" import (new_sym push_scope_sym scope_mark scope_reset)
from p"aggregate_sources.dewy" import (missing_field_check struct_default)
from p"call_argument_checks.dewy" import (match_type unnamed)
from p"argument_order.dewy" import (map_args)
from p"ide_text.dewy" import (ide_named_args)
from p"literal_context.dewy" import (finalize_literal is_lit lit_default)
from p"util.jo" import (files name_of pos_file)
from p"diagnostic_exit.dewy" import (fatal)
from p"type_ops.dewy" import (dt get_struct_inst layout mk_param)
from p"checker_source_positions.dewy" import (dewy_at)
from p"default_arguments.dewy" import (default_uses_names)
from p"record_construction.dewy" import (default_is_zero)
from p"checker_call_queries.dewy" import (ctx_dependent save_call_order)
from p"concurrency.jo" import (concurrency_task_core_module concurrency_task_module concurrency_thread_module)
from p"concurrency_types.dewy" import (concurrency_require_zero)
from p"expr.jo" import (ctor_fills_zero)
from p"coerce_expression.dewy" import (coerce)
from p"checker_type_entries.dewy" import (check_struct_fields type_param_defaults)
from p"check.jo" import (check_scopes ctxs cx)
from p"checker_expr.dewy" import (check_args_untyped check_expr finish_arg)
from p"checked_expression_nodes.dewy" import (capture_value)
from p"types.jo" import (T_STR T_VOID fields has_var prune struct_targ structs tkind types)
from p"node_store.dewy" import (Node)
from p"ast.jo" import (NF_CHECKED add_flag clone dewy_param_kinds kid kid2 mk nkids nkids2 nodes set_list)
from p"ide.jo" import (IK_FIELD ide_on)
from p"checker_import_discovery.dewy" import (ensure_bundled_import)
from p"checks_builders.dewy" import (bc_field bc_ident)
from p"unit_rare.dewy" import (time_core_type)
from p"checker_state.dewy" import (FnCtx)

StructConstructionWord:type=int64<overflow='wrap'>

# `Duration(text)`, also as `T(text)` and through the prelude's alias: the time library's text
# reader, `Duration | ValidationError`. -1 when this is not that call. O(1).
duration_reader=(n:int64 t:int64 args:array<int64> expected:int64):>int64=>$unsafe {
    if args.length not=? 1 or nodes.ptr[args[0]].kind =? 'namedarg' or not dewy_at(nodes.ptr[n].pos) or not time_core_type(t "Duration") {return -1}
    if prune(check_expr(args[0] 0)) not=? T_STR {return -1}
    let pos=nodes.ptr[n].pos
    ensure_bundled_import("time/core.dewy" "$dewy_time" pos)
    nodes[n] = Node(kind = 'call' pos = pos a = int32<overflow='wrap'>(bc_field(bc_ident("$dewy_time" pos) "read_duration" pos)))
    set_list(n [args[0]])
    check_expr(n expected)
}
struct_ctor=(n:int64 st_type:int64 decl:int64 args:array<int64> expected:int64):>int64=>$unsafe {
    let ctor_fills_zero_slot=@ctor_fills_zero
    if decl not=? 0 and dewy_at(nodes.ptr[n].pos) {
        let module=StructConstructionWord(nodes.ptr[decl].mod)
        if module =? concurrency_thread_module and name_of(StructConstructionWord(nodes.ptr[decl].name)) =? "Atomic" {
            fatal(nodes.ptr[n].pos "construct Atomic with atomic(value); its storage is private")
        }
        if module =? concurrency_task_module or module =? concurrency_task_core_module {
            let name=name_of(StructConstructionWord(nodes.ptr[decl].name))
            if name =? "Task" or name =? "TaskGroup" {fatal(nodes.ptr[n].pos "task handles are created by concurrent and spawn; their storage is private")}
        }
    }
    if args.length =? 1 and decl not=? 0 and nkids2(decl) =? 0 and name_of(StructConstructionWord(nodes.ptr[decl].name)) =? "Duration" {
        let read=duration_reader(n get_struct_inst(decl []) args expected)
        if read >=? 0 {return read}
    }
    let fills_zero=ctor_fills_zero_slot
    ctor_fills_zero_slot=false
    let t=st_type
    if t =? 0 and nkids2(decl) =? 0 {t=get_struct_inst(decl [])}
    if t =? 0 {
        let ntp=nkids2(decl)
        let binds:array<int64>=fill(0 ntp)
        let ex=prune(expected)
        if expected not=? 0 and types.ptr[ex].kind =? 'struct_' and StructConstructionWord(structs.ptr[StructConstructionWord(types.ptr[ex].st)].decl) =? decl {t=ex}
        else {
            let mark=scope_mark()
            loop i in [0..ntp) {
                let nm=StructConstructionWord(nodes.ptr[kid2(decl i)].name)
                push_scope_sym(nm new_sym(nm 'type_' mk_param(i) 0))
            }
            check_args_untyped(args)
            let pnames:array<int64>=[]
            let hasdef:array<bool>=[]
            loop i in [0..nkids(decl)) {
                pnames.push(StructConstructionWord(nodes.ptr[kid(decl i)].name))
                hasdef.push(true)
            }
            let mapped:array<int64>=[]
            let err=map_args(pnames hasdef args @mapped dewy_param_kinds.get(decl) ?? [])
            if (err as array<uint8>).length >? 0 {fatal(nodes.ptr[n].pos err)}
            loop i in [0..nkids(decl)) {
                let a=mapped[i]
                if a =? 0 or ctx_dependent(a) or is_lit(a) {continue}
                let f=kid(decl i)
                if nodes.ptr[f].a =? 0 {continue}
                let pat=resolve_type(StructConstructionWord(nodes.ptr[f].a))
                match_type(pat ntype(a) @binds 0);
            }
            # A literal does not override a declared type default. Known
            # nonliteral fields constrain the type before defaults are filled.
            loop i in [0..nkids(decl)) {
                let a=mapped[i]
                if a =? 0 or not is_lit(a) {continue}
                let f=kid(decl i)
                if nodes.ptr[f].a =? 0 {continue}
                let inferred=binds
                match_type(resolve_type(StructConstructionWord(nodes.ptr[f].a)) lit_default(a) @inferred 0);
                loop j in [0..ntp) {
                    if binds[j] =? 0 and nodes.ptr[kid2(decl j)].b =? 0 {binds[j] = inferred[j]}
                }
            }
            let defaults=type_param_defaults(decl [] binds)
            loop i in 0.. and default_type in defaults {
                if binds[i] =? 0 {binds[i] = default_type}
            }
            loop i in [0..nkids(decl)) {
                let a=mapped[i]
                if a =? 0 or not is_lit(a) {continue}
                let f=kid(decl i)
                if nodes.ptr[f].a =? 0 {continue}
                let pat=resolve_type(StructConstructionWord(nodes.ptr[f].a))
                let hint=subst_partial(pat @binds)
                if has_var(hint) {finalize_literal(a);}
                else {coerce(a hint);}
                match_type(pat ntype(a) @binds 0);
            }
            # As with function calls, first collect known argument types, then
            # check contextual literals/callbacks against the partially bound
            # field types. Empty collections can use another field's type.
            loop i in [0..nkids(decl)) {
                let a=mapped[i]
                if a =? 0 or not ctx_dependent(a) or nodes.ptr[a].kind =? 'hole' {continue}
                let f=kid(decl i)
                if nodes.ptr[f].a =? 0 {continue}
                let pat=resolve_type(StructConstructionWord(nodes.ptr[f].a))
                check_expr(a subst_partial(pat @binds));
                add_flag(a NF_CHECKED)
                match_type(pat ntype(a) @binds 0);
            }
            scope_reset(mark)
            loop i in [0..ntp) {
                if binds[i] =? 0 {
                    let sn=name_of(StructConstructionWord(nodes.ptr[decl].name))
                    let more=""
                    if ntp >? 1 {more=" ..."}
                    let how=""
                    if dewy_at(nodes.ptr[n].pos) {how=" (nothing given says what it is: name it, as in `{sn}<int64{more}>[...]`, or annotate the variable)"}
                    fatal(nodes.ptr[n].pos "cannot infer type parameter '{name_of(StructConstructionWord(nodes.ptr[kid2(decl i)].name))}' of {sn}{how}")
                }
            }
            t=get_struct_inst(decl binds)
        }
    }
    let si=StructConstructionWord(types.ptr[prune(t)].st)
    check_struct_fields(si)
    let nf=StructConstructionWord(structs.ptr[si].nfields)
    let pnames:array<int64>=[]
    let hasdef:array<bool>=[]
    loop i in [0..nf) {
        pnames.push(StructConstructionWord(fields.ptr[StructConstructionWord(structs.ptr[si].fields) + i].name))
        hasdef.push(true)
    }
    let mapped:array<int64>=[]
    let err=map_args(pnames hasdef args @mapped)
    if (err as array<uint8>).length >? 0 {fatal(nodes.ptr[n].pos "in {name_of(StructConstructionWord(nodes.ptr[decl].name))}(...): {err}")}
    if not fills_zero and files.ptr[pos_file(nodes.ptr[decl].pos)].is_dewy {
        # (a Dewy object is built from what is given and its defaults, never from invented zeros)
        loop i in [0..nf) {
            let fi=StructConstructionWord(structs.ptr[si].fields) + i
            # (an optional field defaults to none)
            if mapped[i] =? 0 and StructConstructionWord(fields.ptr[fi].defval) =? 0 and tkind(StructConstructionWord(fields.ptr[fi].type)) not=? 'opt' {
                fatal(nodes.ptr[n].pos "{dt(t)} needs its field '{name_of(StructConstructionWord(fields.ptr[fi].name))}', which has no default")
            }
        }
    }
    missing_field_check(n decl si args mapped)
    if ide_on {
        let fts:array<int64>=[]
        loop i in [0..nf) {fts.push(StructConstructionWord(fields.ptr[StructConstructionWord(structs.ptr[si].fields) + i].type))}
        ide_named_args(args decl IK_FIELD fts)
    }
    # (a struct that holds itself, a: A, says so before its fields' defaults are made: they would
    # make one another without end)
    layout(t)
    # A default naming an earlier field takes the value this construction gives it:
    # explicit values are kept first, in written order, then defaults in field order.
    let dependent=false
    if files.ptr[pos_file(nodes.ptr[decl].pos)].is_dewy {
        let names:array<int64>=[]
        loop i in [0..nf) {
            let fi=StructConstructionWord(structs.ptr[si].fields) + i
            if mapped[i] =? 0 and default_uses_names(StructConstructionWord(fields.ptr[fi].defval) names) {dependent=true}
            names.push(StructConstructionWord(fields.ptr[fi].name))
        }
    }
    let captured:array<int64>=fill(0 nf)
    let statements:array<int64>=[]
    if dependent {
        loop source in args {
            let a=unnamed(source)
            loop i in [0..nf) {
                if mapped[i] not=? a and mapped[i] not=? source {continue}
                if nodes.ptr[a].kind =? 'hole' {fatal(nodes.ptr[a].pos "partial application of constructors is not supported")}
                let ft=representation_type(StructConstructionWord(fields.ptr[StructConstructionWord(structs.ptr[si].fields) + i].type))
                finish_arg(a ft false)
                captured[i] = capture_value(a ft @statements)
                break
            }
        }
    }
    let fin:array<int64>=[]
    loop i in [0..nf) {
        let fi=StructConstructionWord(structs.ptr[si].fields) + i
        let a=mapped[i]
        if dependent and a not=? 0 {
            finish_arg(captured[i] StructConstructionWord(fields.ptr[fi].type) false)
            fin.push(captured[i])
            continue
        }
        if a =? 0 {
            let dv=StructConstructionWord(fields.ptr[fi].defval)
            if dv not=? 0 and not dependent and default_is_zero(dv StructConstructionWord(fields.ptr[fi].type)) {
                concurrency_require_zero(n StructConstructionWord(fields.ptr[fi].type))
                # (filled in place with zeros, not built aside and copied in)
                fin.push(0)
                continue
            }
            if dv not=? 0 {
                let d=clone(dv)
                let context=@cx
                let saved=context
                ctxs.push(FnCtx(ctxs.ptr[saved].inst (-1) int32<overflow='wrap'>(T_VOID) false 0 nodes.ptr[decl].mod int32<overflow='wrap'>(check_scopes.names.length)))
                context=ctxs.length - 1
                let mark=scope_mark()
                let targs:array<int64>=[]
                loop j in [0..StructConstructionWord(structs.ptr[si].ntargs)) {targs.push(struct_targ(si j))}
                push_type_params(decl targs)
                if dependent {
                    loop j in [0..i) {
                        if captured[j] =? 0 {continue}
                        let name=StructConstructionWord(fields.ptr[StructConstructionWord(structs.ptr[si].fields) + j].name)
                        push_scope_sym(name new_sym(name 'local' StructConstructionWord(nodes.ptr[captured[j]].sym) 0))
                    }
                }
                check_expr(d representation_type(StructConstructionWord(fields.ptr[fi].type)));
                coerce(d representation_type(StructConstructionWord(fields.ptr[fi].type)));
                scope_reset(mark)
                ctxs.pop();
                context=saved
                if dependent {
                    d=capture_value(d representation_type(StructConstructionWord(fields.ptr[fi].type)) @statements)
                    finish_arg(d StructConstructionWord(fields.ptr[fi].type) false)
                }
                finish_arg(d StructConstructionWord(fields.ptr[fi].type) false)
                captured[i] = d
                fin.push(d)
            }
            else {
                let d=struct_default(StructConstructionWord(fields.ptr[fi].type) nodes.ptr[n].pos)
                if d =? 0 {concurrency_require_zero(n StructConstructionWord(fields.ptr[fi].type))}
                if dependent and d not=? 0 {
                    d=capture_value(d representation_type(StructConstructionWord(fields.ptr[fi].type)) @statements)
                    finish_arg(d StructConstructionWord(fields.ptr[fi].type) false)
                }
                captured[i] = d
                fin.push(d)
            }
            continue
        }
        if nodes.ptr[a].kind =? 'hole' {fatal(nodes.ptr[a].pos "partial application of constructors is not supported")}
        # (a type member has no storage: nothing is evaluated or stored for it)
        if tkind(StructConstructionWord(fields.ptr[fi].type)) =? 'typeval' {
            fin.push(0)
            continue
        }
        finish_arg(a StructConstructionWord(fields.ptr[fi].type) false)
        fin.push(a)
    }
    nodes[n].kind = 'call'
    nodes[n].aux = 2
    if not dependent {save_call_order(n args fin)}
    set_list(n fin)
    nodes[n].type = int32<overflow='wrap'>(t)
    nodes[n].a = 0
    if dependent {
        let call=nodes.length
        nodes.push(nodes.ptr[n])
        let result=mk('exprstmt' nodes.ptr[n].pos)
        nodes[result].a = int32<overflow='wrap'>(call)
        statements.push(result)
        nodes[n] = Node(kind = 'block' pos = nodes.ptr[n].pos type = int32<overflow='wrap'>(t) aux = 1)
        set_list(n statements)
    }
    t
}

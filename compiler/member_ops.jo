# Frozen recursive lowering from member_lowering.jo.
use 'arm64_emit.dewy'
use 'member_lowering.jo'

member_lower_sets: int[]
member_lower_text = (e: int, reg: int):
    if not member_templates[member_lower_active].positions.has(nodes[e].pos): return
    member_lower_literals.push(MemberLiteral(reg, nodes[e].pos, 1, int(nodes[e].sval)))
    member_lower_sets.push(0)


member_lower_word = (e: int, value: int) -> int:
    # A private constant distinguishes this use from unrelated equal constants.
    # It remains constant during lowering, so all ordinary decisions still apply.
    reg = k_vreg_new(value)
    member_lower_literals.push(MemberLiteral(reg, nodes[e].pos, 0, value))
    member_lower_sets.push(str_set_of(ntype(e)))
    reg


member_match_reg = (m: mut MemberMatch, a: int, b: int) -> bool:
    if a < 0 or b < 0: return a == b
    la = m.literal[a]
    lb = m.next_literal[b]
    if la >= 0 or lb >= 0: return la == lb
    ta = int(ir.vtypes[a])
    tb = int(ir.vtypes[b])
    if ta == 3 or tb == 3: return ta == 3 and tb == 3 and ir.kval[a] == ir.kval[b]
    if a < m.first.regs or a >= m.first.reg_end:
        mapped = m.regs[a]
        if mapped >= 0: return mapped == b
        return a == b
    if b < m.next.regs or b >= m.next.reg_end or ta != tb: return false
    if m.regs[a] >= 0: return m.regs[a] == b
    if m.reverse[b] >= 0: return false
    m.regs[a] = b
    m.reverse[b] = a
    true


member_match_slot = (m: mut MemberMatch, a: int, b: int) -> bool:
    if a < m.first.slots or a >= m.first.slot_end:
        mapped = m.slots[a]
        if mapped >= 0: return mapped == b
        return a == b
    if b < m.next.slots or b >= m.next.slot_end or ir.slot_size[a] != ir.slot_size[b] or ir.slot_align[a] != ir.slot_align[b]: return false
    if m.slots[a] >= 0: return m.slots[a] == b
    if m.slot_reverse[b] >= 0: return false
    m.slots[a] = b
    m.slot_reverse[b] = a
    true


member_match_body = (m: mut MemberMatch) -> bool:
    a_start = m.first.start
    a_end = m.first.end
    a_zeros = m.first.zeros
    a_zero_end = m.first.zero_end
    b_start = m.next.start
    b_end = m.next.end
    b_zeros = m.next.zeros
    b_zero_end = m.next.zero_end
    nlit = m.first.literals.len()
    if a_end - a_start != b_end - b_start or a_zero_end - a_zeros != b_zero_end - b_zeros or nlit != m.next.literals.len(): return false
    alitp = data(m.first.literals)
    blitp = data(m.next.literals)
    litp = data(m.literal)
    nlitp = data(m.next_literal)
    loop i in [0..nlit):
        x = alitp + i
        y = blitp + i
        if x[0].kind != y[0].kind or x[0].pos != y[0].pos: return false
        litp[x[0].reg] = i
        nlitp[y[0].reg] = i
    aa = member_scope_locals[m.first.scope]
    bb = member_scope_locals[m.next.scope]
    if aa.len() != bb.len(): return false
    rp = data(m.regs)
    sp = data(m.slots)
    aap = data(aa)
    bbp = data(bb)
    locp = data(locals)
    loop i in [0..aa.len()):
        x = locp + aap[i]
        y = locp + bbp[i]
        if x[0].type != y[0].type or x[0].flags != y[0].flags or (x[0].offset >= 0) != (y[0].offset >= 0): return false
        if x[0].offset >= 0:
            sp[int(x[0].offset)] = int(y[0].offset)
        else:
            rp[int(x[0].vreg)] = int(y[0].vreg)
    depth = 0
    codep = data(ir.code)
    xa = codep + a_start
    yb = codep + b_start
    posp = data(ir_positions)
    layoutp = data(ir_operand_layout)
    argsp = data(ir.args)
    revp = data(m.reverse)
    vtp = data(ir.vtypes)
    fregs = m.first.regs
    freg_end = m.first.reg_end
    nregs = m.next.regs
    nreg_end = m.next.reg_end
    ncode = a_end - a_start
    loop i in [0..ncode):
        cur_x = xa + i
        cur_y = yb + i
        op = cur_x[0].op
        if op != cur_y[0].op or cur_x[0].ty != cur_y[0].ty or (cur_x[0].pos != cur_y[0].pos and posp[int(cur_x[0].pos)] != posp[int(cur_y[0].pos)]): return false
        match op:
            nop: continue
            ret, brtable, zeroslots: return false
            load, store:
                if int(cur_x[0].c) & M_INDEX != 0: return false
            br, brif:
                if cur_x[0].imm >= depth: return false
            block, loop, if_: depth += 1
            end:
                depth -= 1
                if depth < 0: return false
            _: pass
        mode = layoutp[int(op)]
        if mode & IR_DEF != 0:
            d1 = int(cur_x[0].dst)
            d2 = int(cur_y[0].dst)
            if d1 >= fregs and d1 < freg_end and d2 >= nregs and d2 < nreg_end:
                if rp[d1] == d2: pass
                else if rp[d1] < 0 and revp[d2] < 0 and litp[d1] < 0 and nlitp[d2] < 0 and int(vtp[d1]) != 3 and vtp[d1] == vtp[d2]:
                    rp[d1] = d2
                    revp[d2] = d1
                else if not member_match_reg(m, d1, d2): return false
            else if not member_match_reg(m, d1, d2): return false
        else if cur_x[0].dst != cur_y[0].dst: return false
        if op == .slot:
            if cur_x[0].b != cur_y[0].b or cur_x[0].c != cur_y[0].c: return false
            if not member_match_slot(m, int(cur_x[0].a), int(cur_y[0].a)): return false
        else if mode & IR_ARGS != 0:
            if cur_x[0].b != cur_y[0].b: return false
            xa0 = int(cur_x[0].a)
            ya0 = int(cur_y[0].a)
            loop j in [0..int(cur_x[0].b)):
                r1 = int(argsp[xa0 + j])
                r2 = int(argsp[ya0 + j])
                if not (r2 >= 0 and ((r1 >= fregs and r1 < freg_end and rp[r1] == r2) or (r1 == r2 and r1 >= 0 and r1 < fregs and rp[r1] < 0 and litp[r1] < 0 and nlitp[r2] < 0))):
                    if not member_match_reg(m, r1, r2): return false
            if mode & IR_INDIRECT != 0:
                r1 = int(cur_x[0].c)
                r2 = int(cur_y[0].c)
                if not (r2 >= 0 and ((r1 >= fregs and r1 < freg_end and rp[r1] == r2) or (r1 == r2 and r1 >= 0 and r1 < fregs and rp[r1] < 0 and litp[r1] < 0 and nlitp[r2] < 0))):
                    if not member_match_reg(m, r1, r2): return false
            else if cur_x[0].c != cur_y[0].c: return false
        else:
            count = mode & 7
            if count > 0:
                r1 = int(cur_x[0].a)
                r2 = int(cur_y[0].a)
                if not (r2 >= 0 and ((r1 >= fregs and r1 < freg_end and rp[r1] == r2) or (r1 == r2 and r1 >= 0 and r1 < fregs and rp[r1] < 0 and litp[r1] < 0 and nlitp[r2] < 0))):
                    if not member_match_reg(m, r1, r2): return false
            else if cur_x[0].a != cur_y[0].a: return false
            if count > 1:
                r1 = int(cur_x[0].b)
                r2 = int(cur_y[0].b)
                if not (r2 >= 0 and ((r1 >= fregs and r1 < freg_end and rp[r1] == r2) or (r1 == r2 and r1 >= 0 and r1 < fregs and rp[r1] < 0 and litp[r1] < 0 and nlitp[r2] < 0))):
                    if not member_match_reg(m, r1, r2): return false
            else if cur_x[0].b != cur_y[0].b: return false
            if count > 2:
                r1 = int(cur_x[0].c)
                r2 = int(cur_y[0].c)
                if not (r2 >= 0 and ((r1 >= fregs and r1 < freg_end and rp[r1] == r2) or (r1 == r2 and r1 >= 0 and r1 < fregs and rp[r1] < 0 and litp[r1] < 0 and nlitp[r2] < 0))):
                    if not member_match_reg(m, r1, r2): return false
            else if cur_x[0].c != cur_y[0].c: return false
        if op == .daddr and litp[int(cur_x[0].dst)] >= 0: continue
        if cur_x[0].imm != cur_y[0].imm: return false
    if depth != 0: return false
    lzp = data(lower_zeros)
    loop i in [0..a_zero_end - a_zeros):
        x = lzp + (a_zeros + i)
        y = lzp + (b_zeros + i)
        if x[0].mark >> 32 < a_start or y[0].mark >> 32 < b_start: return false
        if (x[0].mark >> 32) - a_start != (y[0].mark >> 32) - b_start or x[0].count != y[0].count: return false
        loop j in [0..x[0].count):
            xx = int(argsp[x[0].start + j])
            yy = int(argsp[y[0].start + j])
            if xx & 1 != yy & 1: return false
            if xx & 1 != 0:
                if not member_match_reg(m, xx / 2, yy / 2): return false
            else if not member_match_slot(m, xx / 2, yy / 2): return false
    true


# Keep the same rodata and frame layout as the old IR merge. On native x64
# a slot advances the end by align_up(end + size, alignment). After the
# largest alignment in a row, the ending residue repeats on every row.
member_lower_layout = (first: MemberLowered, count: int):
    offset = 0
    stride = 0
    loop pass_no in [0..2):
        before = offset
        loop j in [first.slots..first.slot_end):
            a = int(ir.slot_align[j])
            offset = (offset + int(ir.slot_size[j]) + a - 1) & (0 - a)
        stride = offset - before
    padding = stride * (count - 1)
    # Slot sizes are signed 32-bit. Every stride and chunk is 8-byte aligned.
    loop padding > 0:
        chunk = min(padding, 2147483640)
        new_slot(chunk, 8)
        padding -= chunk

member_lower_table = (parts: MemberLowered[], index: int, count: int) -> int:
    columns: int[][]
    if index >= 0:
        t = member_templates[index]
        has_text = false
        loop literal in parts[0].literals:
            columns.push(t.values[t.columns[literal.pos]])
            if literal.kind == 1: has_text = true
        if has_text:
            loop text in t.texts: str_data(text)
        member_lower_layout(parts[0], count)
    loop rodata.len() % 8 != 0: rodata.push(0)
    base = rodata.len()
    ro_starts.push(base)
    width = parts[0].literals.len()
    # Relative offsets refer only within this block, including fused workers.
    text_at = width * count * 8
    strings: str[]
    loop row in [0..count):
        literals = if index >= 0: parts[0].literals else: parts[row].literals
        loop j in [0..width):
            literal = literals[j]
            value = if index >= 0: columns[j][row] else: literal.value
            if literal.kind == 0: push_i64(rodata, value)
            else:
                text = name_of(value)
                push_i64(rodata, text_at)
                strings.push(text)
                text_at += (24 + len(text) + 1 + 7) / 8 * 8
    loop text in strings:
        push_i64(rodata, -1)
        push_i64(rodata, len(text))
        push_i64(rodata, len(text) + 1)
        loop byte in bytes(text): rodata.push(byte)
        rodata.push(0)
        loop rodata.len() % 8 != 0: rodata.push(0)
    if fused_on: fz_note_raw(base, 8)
    base


member_lower_emit = (parts: MemberLowered[], index: int = -1):
    count = if index >= 0: member_templates[index].texts.len() else: parts.len()
    first = parts[0]
    body = ir.code[first.start..first.end)
    ir.code.truncate(first.start)
    lower_zeros.truncate(first.zero_end)
    table = e_daddr(member_lower_table(parts, index, count))
    row = vreg(VI)
    e_mov(row, table)
    limit = e_addi(table, count * first.literals.len() * 8)
    e_loop()
    values: {int: int} = {}
    loop i in [0..first.literals.len()):
        literal = first.literals[i]
        value = e_load(VI, row, i * 8, 8)
        if literal.kind == 1: value = e_bin(.add, VI, table, value)
        else:
            ir.vtypes[literal.reg] = i8(VI)
            e_mov(literal.reg, value)
        values[literal.reg] = value
    shift = ir.code.len() - first.start
    loop i in [first.zeros..first.zero_end): lower_zeros[i].mark += shift << 32
    loop original in body:
        ins = original
        if ins.op == .daddr:
            if let value = values.get(int(ins.dst)):
                ins.op = .mov
                ins.a = i32(value)
                ins.imm = 0
        ir.code.push(ins)
    e_mov(row, e_addi(row, first.literals.len() * 8))
    e_brif(e_bin(.ltu, VI, row, limit), 0)
    e_end()


member_env_checked = false
member_env_skip = false
member_regs_buf: int[]
member_rev_buf: int[]
member_slots_buf: int[]
member_srev_buf: int[]
member_lit_buf: int[]
member_nlit_buf: int[]

member_grow_neg = (buf: mut int[], need: int):
    old = buf.len()
    if old >= need: return
    buf.resize(need)
    loop i in [old..need): buf[i] = -1

member_lower_block = (b: int) -> bool:
    # Foreign OS formats keep byte identity until their runtime is exercised.
    if target_windows or target_macos: return false
    if member_lower_active >= 0 or dbg_on or debug_vars or tl_items.len() != 0 or building.len() != 0: return false
    index = member_scopes.get(kid(b, 0)) ?? -1
    if index < 0 or not member_templates[index].okay or nkids(b) != member_templates[index].texts.len(): return false
    # A checking-only mode is also a byte-identity oracle for fallback lowering.
    if not member_env_checked:
        member_env_checked = true
        member_env_skip = (env("DEWY_MEMBERS") ?? "") == "checked"
    if member_env_skip: return false
    nk = nkids(b)
    compact = member_templates[index].compact and member_templates[index].block == b
    if not compact:
        loop i in [0..nk):
            scope = kid(b, i)
            if (member_scopes.get(scope) ?? -1) != index or not member_scope_locals.has(scope): return false
    t = member_templates[index]
    uniform = not compact and nk >= 3 and ownership_decls.len() == 0 and t.requests.len() == 0 and t.refinements.len() == 0 and (not fact_decided.has(t.owner) or member_uniform_owners.has(t.owner) or member_uniform_blocks.has(b))
    parts: MemberLowered[]
    first_sets: int[]
    second_sets: int[]
    limit = if uniform: 2 else: nk
    loop i in [0..limit):
        scope = kid(b, i)
        part = MemberLowered(start = ir.code.len(), regs = ir.vtypes.len(), slots = ir.slot_size.len(), zeros = lower_zeros.len(), scope = scope)
        member_lower_active = index
        member_lower_literals = []
        member_lower_sets = []
        cur_block = b
        cur_block_i = i
        gen_stmt(if compact: member_templates[index].body else: scope)
        member_lower_active = -1
        part.end = ir.code.len()
        part.reg_end = ir.vtypes.len()
        part.slot_end = ir.slot_size.len()
        part.zero_end = lower_zeros.len()
        part.literals = member_lower_literals
        if i == 0: first_sets = member_lower_sets
        else if i == 1: second_sets = member_lower_sets
        parts.push(part)
        if compact: break
    first = parts[0]
    if compact:
        if member_trace: eprint("member lowering {pos_str(nodes[b].pos)}: true, {nkids(b)} members, one parameterized body")
        member_lower_emit(parts, index)
        return true
    okay = first.literals.len() > 0
    if okay:
        nv = ir.vtypes.len()
        ns = ir.slot_size.len()
        member_grow_neg(member_regs_buf, nv)
        member_grow_neg(member_rev_buf, nv)
        member_grow_neg(member_slots_buf, ns)
        member_grow_neg(member_srev_buf, ns)
        member_grow_neg(member_lit_buf, nv)
        member_grow_neg(member_nlit_buf, nv)
        m = MemberMatch(first = first, regs = member_regs_buf, reverse = member_rev_buf, slots = member_slots_buf, slot_reverse = member_srev_buf, literal = member_lit_buf, next_literal = member_nlit_buf)
        member_regs_buf = []
        member_rev_buf = []
        member_slots_buf = []
        member_srev_buf = []
        member_lit_buf = []
        member_nlit_buf = []
        loop i in [1..parts.len()):
            if not okay: break
            m.next = parts[i]
            okay = member_match_body(m)
            loop v in [first.regs..first.reg_end): m.regs[v] = -1
            loop s in [first.slots..first.slot_end): m.slots[s] = -1
            loop l in first.literals: m.literal[l.reg] = -1
            loop l in m.next.literals: m.next_literal[l.reg] = -1
            loop v in [m.next.regs..m.next.reg_end): m.reverse[v] = -1
            loop s in [m.next.slots..m.next.slot_end): m.slot_reverse[s] = -1
            loop loc in member_scope_locals[first.scope]:
                x = locals[loc]
                if x.offset >= 0: m.slots[int(x.offset)] = -1
                else: m.regs[int(x.vreg)] = -1
        member_regs_buf = m.regs
        member_rev_buf = m.reverse
        member_slots_buf = m.slots
        member_srev_buf = m.slot_reverse
        member_lit_buf = m.literal
        member_nlit_buf = m.next_literal
    if uniform:
        fast_ok = okay
        if fast_ok:
            nl = first.literals.len()
            text1 = t.texts[1]
            sval1 = intern(text1)
            s1l = data(parts[1].literals)
            f0l = data(first.literals)
            loop j in [0..nl):
                if first_sets[j] != second_sets[j]: fast_ok = false; break
                if f0l[j].kind == 1:
                    if s1l[j].value != sval1: fast_ok = false; break
                else:
                    st = first_sets[j]
                    if st == 0 or not member_words.has(st) or s1l[j].value != member_words[st][text1]: fast_ok = false; break
        if fast_ok:
            nl = first.literals.len()
            f0l = data(first.literals)
            fsp = data(first_sets)
            txtp = data(t.texts)
            has_text = false
            loop j in [0..nl):
                if f0l[j].kind == 1: has_text = true; break
            parts.reserve(nk)
            loop i in [2..nk):
                scope = kid(b, i)
                text = txtp[i]
                if has_text: str_data(text)
                sval = intern(text)
                lits: MemberLiteral[]
                lits.reserve(nl)
                loop j in [0..nl):
                    fl = f0l[j]
                    val = if fl.kind == 1: sval else: member_words[fsp[j]][text]
                    lits.push(MemberLiteral(fl.reg, fl.pos, fl.kind, val))
                parts.push(MemberLowered(scope = scope, literals = lits))
            member_lower_layout(first, nk - 1)
        else:
            # Fallback: lower remaining scopes ordinarily and match if still okay.
            prev_parts = parts.len()
            loop i in [prev_parts..nk):
                scope = kid(b, i)
                part = MemberLowered(start = ir.code.len(), regs = ir.vtypes.len(), slots = ir.slot_size.len(), zeros = lower_zeros.len(), scope = scope)
                member_lower_active = index
                member_lower_literals = []
                member_lower_sets = []
                cur_block = b
                cur_block_i = i
                gen_stmt(scope)
                member_lower_active = -1
                part.end = ir.code.len()
                part.reg_end = ir.vtypes.len()
                part.slot_end = ir.slot_size.len()
                part.zero_end = lower_zeros.len()
                part.literals = member_lower_literals
                parts.push(part)
            if okay:
                nv = ir.vtypes.len()
                ns = ir.slot_size.len()
                member_grow_neg(member_regs_buf, nv)
                member_grow_neg(member_rev_buf, nv)
                member_grow_neg(member_slots_buf, ns)
                member_grow_neg(member_srev_buf, ns)
                member_grow_neg(member_lit_buf, nv)
                member_grow_neg(member_nlit_buf, nv)
                m = MemberMatch(first = first, regs = member_regs_buf, reverse = member_rev_buf, slots = member_slots_buf, slot_reverse = member_srev_buf, literal = member_lit_buf, next_literal = member_nlit_buf)
                member_regs_buf = []
                member_rev_buf = []
                member_slots_buf = []
                member_srev_buf = []
                member_lit_buf = []
                member_nlit_buf = []
                loop i in [prev_parts..parts.len()):
                    if not okay: break
                    m.next = parts[i]
                    okay = member_match_body(m)
                    loop v in [first.regs..first.reg_end): m.regs[v] = -1
                    loop s in [first.slots..first.slot_end): m.slots[s] = -1
                    loop l in first.literals: m.literal[l.reg] = -1
                    loop l in m.next.literals: m.next_literal[l.reg] = -1
                    loop v in [m.next.regs..m.next.reg_end): m.reverse[v] = -1
                    loop s in [m.next.slots..m.next.slot_end): m.slot_reverse[s] = -1
                    loop loc in member_scope_locals[first.scope]:
                        x = locals[loc]
                        if x.offset >= 0: m.slots[int(x.offset)] = -1
                        else: m.regs[int(x.vreg)] = -1
                member_regs_buf = m.regs
                member_rev_buf = m.reverse
                member_slots_buf = m.slots
                member_srev_buf = m.slot_reverse
                member_lit_buf = m.literal
                member_nlit_buf = m.next_literal
    if member_trace: eprint("member lowering {pos_str(nodes[b].pos)}: {okay}, {parts.len()} members, {first.end - first.start} instructions")
    if okay: member_lower_emit(parts)
    true

$runtime_checks

from p"checker_tokens.dewy" import (Tok)
from p"parse.jo" import (p_ntoks p_toks ti)

# The owner binds an EOF-terminated token stream with LX_SPARE zero slots.
# Cursor operations neither grow nor replace it; partner writes only its cached
# matching index. Word arithmetic preserves the original machine-word contract.
CursorWord:type=int64<overflow='wrap'>
pk=():>Tok=>$unsafe {
    p_toks[ti].kind
}
pkn=(k:CursorWord):>Tok=>$unsafe {
    let j=CursorWord(ti) + k
    if j >=? p_ntoks {j=CursorWord(p_ntoks) - 1}
    p_toks[j].kind
}
cur_pos=():>int64=>$unsafe {
    p_toks[ti].pos
}
advance=():>int64=>{
    let i=ti
    if ti <? CursorWord(p_ntoks) - 1 {ti=CursorWord(ti) + 1}
    i
}
accept=(k:Tok):>bool=>$unsafe {
    if p_toks[ti].kind =? k {
        advance();
        return true
    }
    false
}
# spacing comes from the gap between a token and the previous one (only asked about in a few places)
space_before=(i:CursorWord):>bool=>$unsafe {
    if i =? 0 {return true}
    let prev_end=CursorWord(p_toks[i - 1].start) + CursorWord(p_toks[i - 1].len)
    let s=CursorWord(p_toks[i].start)
    # (a string token's start is after its opening quote)
    if p_toks[i].kind =? 'str_lit' {s -= 1}
    if p_toks[i - 1].kind =? 'str_lit' {prev_end += 1}
    s >? prev_end
}
# The lexer records bracket partners in its existing nesting stack. Streams beyond
# the packed token-index limit use this bounded fallback, cached on first demand.
partner=(i:CursorWord):>int64=>$unsafe {
    if p_toks[i].ival >? 0 {return CursorWord(p_toks[i].ival)}
    let depth:CursorWord=0
    let j=i
    loop j <? p_ntoks {
        let k=p_toks[j].kind
        if k =? 'lparen' or k =? 'lbrack' or k =? 'lbrace' {depth += 1} else if k =? 'rparen' or k =? 'rbrack' or k =? 'rbrace' {
            depth -= 1
            if depth =? 0 {break}
        }
        j += 1
    }
    p_toks[i].ival=j
    j
}
# keywords that are also fine as names after '.', in enum variants and in match patterns
is_soft_kw=(k:Tok):>bool=>{
    k =? 'kw_loop' or k =? 'kw_xor' or k =? 'kw_is' or k =? 'kw_let'
}
# old syntax gets a pointer to the new
skip_newlines=():>void=>{
    loop pk() =? 'newline' {advance();}
}
# `and=`, `or=`, `xor=` are compound assignments, not operators followed by '='
word_assign_ahead=():>bool=>{
    pkn(1) =? 'assign' and not space_before(CursorWord(ti) + 1)
}
is_assign_op=(k:Tok):>bool=>{
    match k {
        <'assign'> => true
        <'pluseq'> => true
        <'minuseq'> => true
        <'stareq'> => true
        <'slasheq'> => true
        <'percenteq'> => true
        <'ampeq'> => true
        <'pipeeq'> => true
        <'careteq'> => true
        <'shleq'> => true
        <'shreq'> => true
        <'kw_and'> => word_assign_ahead()
        <'kw_or'> => word_assign_ahead()
        <'kw_xor'> => word_assign_ahead()
        _ => false
    }
}

# Punctuation stored in a dot operator token is an ASCII byte code.
dotop_prec=(i:CursorWord):>int64=>$unsafe {
    let c=CursorWord(p_toks[i].ival)
    if c =? 94 {return 11}
    if c =? 42 or c =? 47 or c =? 37 {return 10}
    if c =? 43 or c =? 45 {return 9}
    2
}

use 'checker_types.dewy'
use 'type_intern.dewy'
use 'type_ops.dewy'
use 'type_queries.dewy'
use 'types.jo'

# Frozen bootstrap twin of type_access.dewy.
type_access_targ = (t: int, i: int) -> int: int(type_args[int(types[t].args) + i])
type_access_tkind = (t: int) -> TK: types[type_access_prune(t)].kind
type_access_telem = (t: int) -> int: int(types[type_access_prune(t)].elem)
type_access_has_var = (t: int) -> bool: int(types[t].flags) & TF_HAS_VAR != 0
type_access_mk_type = (t: TypeInfo, args: int[]) -> int: type_intern(&t, args)
type_access_fn_type_pack = (t: int) -> bool: types[t].kind == .fn_ and types[t].sign
type_access_prune = (t0: int) -> int:
    t = t0
    loop t != 0 and types[t].kind == .var and types[t].ref != 0: t = int(types[t].ref)
    t
type_access_is_int = (t: int) -> bool: types[type_access_prune(t)].kind == .int_
type_access_is_float = (t: int) -> bool: types[type_access_prune(t)].kind == .float_
type_access_is_numeric = (t: int) -> bool:
    k = types[type_access_prune(t)].kind
    k == .int_ or k == .float_
type_access_is_vec = (t: int) -> bool: types[type_access_prune(t)].kind == .vec
type_access_struct_targ = (si: int, i: int) -> int: int(type_args[int(structs[si].targs) + i])
type_access_type_eq = (a0: int, b0: int) -> bool:
    a = type_access_prune(a0)
    b = type_access_prune(b0)
    if a == b: return true
    if a == 0 or b == 0: return false
    if not type_access_has_var(a) and not type_access_has_var(b): return false
    type_query_equal_shape(types, structs, type_args, a, b)
type_access_align_up = (x: int, a: int) -> int: (x + a - 1) & ~(a - 1)
type_access_tsize = (t: int) -> int:
    layout(t)
    int(types[type_access_prune(t)].size)
type_access_talign = (t: int) -> int:
    layout(t)
    a = int(types[type_access_prune(t)].align)
    if a == 0: return 1
    a
type_access_is_union = (t0: int) -> bool:
    t = type_access_prune(t0)
    types[t].kind == .enum_ and structs[int(types[t].st)].union_
type_access_union_members = (t0: int) -> int[]:
    si = int(types[type_access_prune(t0)].st)
    out: int[]
    loop i in [0..int(structs[si].ntargs)): out.push(type_access_struct_targ(si, i))
    out

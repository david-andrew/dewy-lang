use 'util.jo'
use 'check.jo'
use 'settings.jo'
use 'watch.jo'
use 'watch_drive.dewy'
use 'watch_ops.dewy'
use 'proc_sys.jo'
# The watch's target- and bootstrap-conditional pieces (lib/std/watch.jo's signals, Windows's
# processes, pipes and console, inotify), for watch_drive.dewy: the rest of the watch is Dewy.

# a test watch's children end with it
ws_test_signals = ():
    when TARGET == "windows":
        __test_process_group()
    when not BOOTSTRAP and TARGET != "windows" and TARGET != "wasm":
        __watch_tests_signals(&w_pid)

# inotify_init1(IN_NONBLOCK | IN_CLOEXEC) on Linux (-1 elsewhere: files are watched by time)
ws_inotify = () -> int:
    when TARGET == "linux":
        return syscall(294, 0x800 | 0x80000)
    else:
        return -1

# watch a directory: writes, moves, creation and deletion
ws_add_watch = (ino: int, d: str) -> int:
    when TARGET == "windows":
        return -1
    else:
        return syscall(254, ino, data(__zstr(d)), 0x8 | 0x40 | 0x80 | 0x100 | 0x200)

# (a file changed: a moment for the editor to finish)
ws_settle = ():
    when TARGET != "wasm":
        sleep(0.03)

ws_terminate = ():
    when TARGET == "windows":
        TerminateProcess(w_pid as *u8, 1)

# (Windows) the program ended: its exit code, and its handles closed
ws_reap = () -> int:
    when TARGET == "windows":
        WaitForSingleObject(w_pid as *u8, u32(0xFFFFFFFF))
        code: u32[] = [0]
        GetExitCodeProcess(w_pid as *u8, data(code))
        CloseHandle(w_pid as *u8)
        CloseHandle(w_to as *u8)
        CloseHandle(w_from as *u8)
        delete_file(w_out)                            # (a running program's file cannot go before)
        return int(code[0])
    else:
        return -1

# write some of b from at (< 0: an error; -4 on Linux: interrupted, again)
ws_write_some = (fd: int, b: u8[], at: int) -> int:
    when TARGET == "windows":
        n: u32[] = [0]
        if WriteFile(fd as *u8, data(b) + at, u32(min(b.len() - at, 1 << 30)), data(n), null) != 0: return int(n[0])
        return 0
    else:
        return syscall(1, fd, data(b) + at, b.len() - at)

# read the rest of a word into b from at
ws_read_some = (fd: int, b: u8[], at: int) -> int:
    when TARGET == "windows":
        n: u32[] = [0]
        if ReadFile(fd as *u8, data(b) + at, u32(8 - at), data(n), null) != 0: return int(n[0])
        return 0
    else:
        return ps_read(fd, b, at, 8 - at)

# ---- Windows: what fork, pipes, inotify and poll do on Linux ----
# Each build runs in a new process (dewy-core watch --build) given the link map in a file; the
# program gets its pipes' handles in DEWY_WATCH_PIPES; files are watched by when they were
# last written, checked a few times a second.

w32_mtime = (f: str) -> int:
    when TARGET == "windows":
        wf = __wide(f)
        info = fill(u8(0), 40)                        # WIN32_FILE_ATTRIBUTE_DATA
        if GetFileAttributesExW(data(wf), 0, data(info)) == 0: return -1
        return int(((data(info) + 20) as *u32)[0]) | (int(((data(info) + 24) as *u32)[0]) << 32)
    else when TARGET == "macos":
        # (struct stat: st_mtimespec at 48)
        st = fill(0, 18)
        if __c_stat(data(__zstr(f)), data(st) as *u8) != 0: return -1
        return st[6] * 1000000000 + st[7]
    else:
        return -1

# r or q typed in the terminal (0: nothing)
w32_key = () -> int:
    when TARGET == "windows":
        h = GetStdHandle(u32(0xFFFFFFF6))
        mode: u32[] = [0]
        if GetConsoleMode(h, data(mode)) != 0:
            n: u32[] = [0]
            GetNumberOfConsoleInputEvents(h, data(n))
            if n[0] == 0: return 0
            rec = fill(u8(0), 20 * 16)                # INPUT_RECORDs
            got: u32[] = [0]
            ReadConsoleInputW(h, data(rec), 16, data(got))
            loop i in [0..int(got[0])):
                r = data(rec) + i * 20
                # a key going down: its character
                if ((r as *u16)[0] == 1 and ((r + 4) as *i32)[0] != 0):
                    c = int(((r + 14) as *u16)[0])
                    if c == 'r' or c == 'R': return 'r'
                    if c == 'q' or c == 'Q': return 'q'
            return 0
        # (not a terminal: lines, as on Linux)
        avail: u32[] = [0]
        if PeekNamedPipe(h, null, 0, null, data(avail), null) == 0 or avail[0] == 0: return 0
        b = fill(u8(0), int(avail[0]))
        got: u32[] = [0]
        ReadFile(h, data(b), avail[0], data(got), null)
        w32_line += str_from_bytes(b[..int(got[0])))
        k = find(w32_line, "\n")
        if k < 0: return 0
        line = trim(w32_line[..k))
        w32_line = w32_line[k + 1..]
        if line == "r": return 'r'
        if line == "q": return 'q'
        return 0
    else:
        return 0

# 1 a file changed, 2 the program ended, 3 restart, 4 quit

w32_wait = () -> int:
    when TARGET == "windows":
        loop true:
            # (the program first: whether it takes patches must be known when a change comes)
            if w_pid >= 0:
                # the program: gone, or saying (once its game loop starts) whether it takes patches
                avail: u32[] = [0]
                if PeekNamedPipe(w_from as *u8, null, 0, null, data(avail), null) == 0: return 2
                if avail[0] >= 8:
                    v = w_read8()
                    if v < 0: return 2
                    w_ready = v == 0
                    continue
            if w32_files_changed(): return 1
            k = w32_key()
            if k == 'r': return 3
            if k == 'q': return 4
            Sleep(40)
        return 0
    else:
        return 0

# start the program built, with two pipes whose handles it finds in DEWY_WATCH_PIPES

w32_run = ():
    when TARGET == "windows":
        sa = fill(0, 3)
        sa[0] = 24
        sa[2] = 1                                     # inheritable
        to_r: *u8[] = [null]
        to_w: *u8[] = [null]
        from_r: *u8[] = [null]
        from_w: *u8[] = [null]
        CreatePipe(data(to_r), data(to_w), data(sa) as *u8, 0)
        CreatePipe(data(from_r), data(from_w), data(sa) as *u8, 0)
        SetHandleInformation(to_w[0], 1, 0)           # (this side's ends stay here)
        SetHandleInformation(from_r[0], 1, 0)
        name = __wide("DEWY_WATCH_PIPES")
        val = __wide("{to_r[0] as int},{from_w[0] as int}")
        SetEnvironmentVariableW(data(name), data(val))
        argv = [w_out]
        loop x in w_args: argv.push(x)
        wcmd = __wide(__w32_cmdline(argv))
        wexe = __wide(w_out)
        si = fill(0, 13)
        si[0] = 104
        pi = fill(0, 3)
        ok = CreateProcessW(data(wexe), data(wcmd), null, null, 1, 0, null, null, data(si) as *u8, data(pi) as *u8) != 0
        SetEnvironmentVariableW(data(name), null)
        CloseHandle(to_r[0])
        CloseHandle(from_w[0])
        if not ok:
            CloseHandle(to_w[0])
            CloseHandle(from_r[0])
            eprint("dewy-core watch: could not start {w_out}")
            return
        CloseHandle(pi[1] as *u8)
        w_pid = pi[0]
        w_to = to_w[0] as int
        w_from = from_r[0] as int

# build in a new process given the link map; its errors go to the terminal (and are kept for the
# game)

w32_compile = (path: str, first: bool) -> bool:
    when TARGET == "windows":
        state = "{w_cache}/watch-{ps_self_id()}.state"
        res = "{w_cache}/watch-{ps_self_id()}.res"
        if not first: watch_write_result(state)
        delete_file(res)
        delete_file("{res}.inputs")
        sa = fill(0, 3)
        sa[0] = 24
        sa[2] = 1
        er: *u8[] = [null]
        ew: *u8[] = [null]
        CreatePipe(data(er), data(ew), data(sa) as *u8, 0)
        SetHandleInformation(er[0], 1, 0)
        exe = exe_path()
        f = "0"
        if first: f = "1"
        testing = "0"
        release = "0"
        if test_mode: testing = "1"
        if cli_mode == "release": release = "1"
        else if cli_mode == "debug": release = "d"
        wcmd = __wide(__w32_cmdline([exe, "watch", "--build", path, state, res, f, w_out, testing, release]))
        wexe = __wide(exe)
        si = fill(0, 13)
        si[0] = 104
        (data(si) as *u32)[15] = u32(0x100)           # STARTF_USESTDHANDLES
        si[10] = GetStdHandle(u32(0xFFFFFFF6)) as int
        si[11] = GetStdHandle(u32(0xFFFFFFF5)) as int
        si[12] = ew[0] as int
        pi = fill(0, 3)
        started = CreateProcessW(data(wexe), data(wcmd), null, null, 1, 0, null, null, data(si) as *u8, data(pi) as *u8) != 0
        CloseHandle(ew[0])
        w_errors = ""
        if not started:
            CloseHandle(er[0])
            eprint("dewy-core watch: could not start the compiler ({exe})")
            return false
        CloseHandle(pi[1] as *u8)
        buf = fill(u8(0), 4096)
        got: u32[] = [0]
        loop ReadFile(er[0], data(buf), 4096, data(got), null) != 0 and got[0] > 0:
            n = int(got[0])
            __write_fd(2, data(buf), n)
            if len(w_errors) < 4000: w_errors += str_from_bytes(buf[..n))
        CloseHandle(er[0])
        WaitForSingleObject(pi[0] as *u8, u32(0xFFFFFFFF))
        code: u32[] = [0]
        GetExitCodeProcess(pi[0] as *u8, data(code))
        CloseHandle(pi[0] as *u8)
        delete_file(state)
        if code[0] != 0:
            watch_read_failed_inputs("{res}.inputs")
            return false
        ok = watch_read_result(res)
        delete_file(res)
        return ok
    else:
        return false

# dewy-core watch --build (Windows): one build, from the link map in state; the result in res

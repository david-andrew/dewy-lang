use 'util.jo'
use 'check.jo'
use 'settings.jo'
use 'watch.jo'
use 'watch_drive.dewy'
use 'watch_ops.dewy'
use 'proc_sys.dewy'
# The watch's bootstrap-conditional piece (lib/std/watch.jo's signals take the address of
# w_pid), for watch_drive.dewy: the rest of the watch is Dewy.

# a test watch's children end with it
ws_test_signals = ():
    when TARGET == "windows":
        __test_process_group()
    when not BOOTSTRAP and TARGET != "windows" and TARGET != "wasm":
        __watch_tests_signals(&w_pid)

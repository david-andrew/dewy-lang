use 'ast.jo'
use 'dewy_nodes.jo'
use 'dewy_tokens.dewy'
use 'lex.jo'
use 'dewy_fast.jo'
use 'util.jo'
use 'dewy_context.jo'
use 'dewy_direct_ops.dewy'
use 'dewy_directive_ops.dewy'
use 'dewy_fast_lex.dewy'
use 'dewy_lexer.dewy'
use 'dewy_file.dewy'
use 'lexer_helpers.dewy'
use 'lazy_force.dewy'
dn_lex = (file: int, begin: int, stop: int, intern_names: bool = true) -> DewyLexeme[]:
    if intern_names and dn_word_tokens.len() == 0: dn_init_words()
    source = files[file].src
    # Hold the immutable string while scanning its bounded byte span. The
    # guards below are against stop, including interpolation subexpressions.
    assert(begin >= 0 and begin <= stop and stop <= len(source))
    if lx_cls == null: lx_init_classes()
    if dn_symbols.len() == 0: dn_init_symbols()
    classes = data(dn_classes)
    symbols = data(dn_symbols)
    out: DewyLexeme[]
    capacity = (stop - begin) / 2 + 2 + DN_EOF_SPARE
    out.resize(capacity)
    dn_block_comments = []
    state = DewyLexState(dn_skip_bodies, false, dn_metatags, false, false, dc_parser.reader.dn_true_id, dc_parser.reader.dn_false_id, dc_parser.reader.dn_is_id, dc_parser.reader.dn_isnt_id, dc_parser.reader.dn_in_id, dn_word_tokens.len(), &names, &name_hash, &name_tab)
    count = dx_lex(state, &dn_lex_host, dn_lexer, dn_block_comments, source, begin, stop, intern_names, classes, symbols, data(dn_word_tokens), out, capacity)
    dn_metatags = state.metatags
    if state.lazy: dc_parser.reader.dn_lazy_left = true
    spaced = state.space
    newline = state.newline
    capacity = out.len()
    slots = data(out)
    if count + 1 + DN_EOF_SPARE > capacity:
        capacity = count + 1 + DN_EOF_SPARE
        out.resize(capacity)
        slots = data(out)
    loop k in [count..count + DN_EOF_SPARE]: slots[k] = DewyLexeme(.eof, 0, stop, stop, spaced, newline)
    out.truncate(count + 1 + DN_EOF_SPARE)
    out

dewy_fast_file = (file: int) -> int[]:
    dw_bigint_import = 0
    # (a reading may split generic closers: a retry restores them, dn_edits_undo)
    saved_edits_on = dc_parser.reader.dn_edits_on
    dc_parser.reader.dn_edits_on = true
    dc_parser.file = file
    dc_parser.source = files[file].src
    dn_lexer.suspect_brace = -1
    dc_parser.reader.dn_in_interpolation = 0
    dn_metatags = 0
    lib_lazy = dc_lib_lazy_allowed(file) and not dc_lazy_allowed(file)
    dc_parser.reader.dn_lazy_left = false
    dn_skip_bodies = lib_lazy
    dc_parser.tokens = dn_lex(file, 0, len(files[file].src))
    dn_skip_bodies = false
    dw_dir_lexed(file)
    df_file(dc_parser, nodes, dc_file_host, saved_edits_on, lib_lazy, dc_lazy_allowed(file))

frontend_bind = (texts: *int, hashes: *int, names_: *int, host: *int) -> int: 0

use 'directives.jo'
use 'check_constant.jo'
use 'checker_state.dewy'
use 'checker_expr.dewy'
use 'ast.jo'
use 'check.jo'
use 'expr.jo'
use 'types.jo'
use 'type_ops.dewy'
use 'util.jo'
use 'diagnostic_exit.dewy'
use 'errors.jo'
use 'error_ops.dewy'
use 'comptime.jo'
use 'warn_if_ops.dewy'
use 'unit_rare.dewy'
use 'constant_folds.jo'
use 'constant_fold_ops.dewy'
use 'comptime_ops.dewy'

cc_reset = ():
    cc_forwards = {}
    cc_verdicts = {}
    cc_decls = {}
    cc_errors = {}
    cc_any = false

# fn_sig, in the declaration's scope: its check, read once.
cc_read_decl = (decl: int):
    if nodes[decl].c == 0 or cc_decls.has(decl) or cc_errors.has(decl): return
    checks: CheckConstant[]
    loop at in kids(int(nodes[decl].c)):
        # (`$error_if true "...": this overload exists to say what to write instead)
        if name_of(int(nodes[at].name)) == "error_if":
            cond = int(nodes[at].a)
            said = int(nodes[at].b)
            if cond == 0 or said == 0 or nodes[cond].kind != .bool_lit or nodes[cond].ival == 0 or nodes[said].kind != .str_lit: fatal(nodes[at].pos, "`$error_if` takes `true` and a message for now: `$error_if true \"write this instead\"`")
            cc_errors[decl] = name_of(int(nodes[said].sval))
            cc_any = true
            continue
        if name_of(int(nodes[at].name)) != "check_constant": continue
        call = int(nodes[at].a)
        msg = int(nodes[at].b)
        bad = "a constant check names a validator, a parameter and a message: `@check_constant(validator(param), \"message\")`"
        if call == 0 or msg == 0 or nodes[msg].kind != .str_lit or nodes[call].kind != .call or nkids(call) < 1: fatal(nodes[at].pos, bad)
        callee = int(nodes[call].a)
        if callee == 0 or nodes[callee].kind != .ident: fatal(nodes[at].pos, bad)
        params: int[]
        loop i in [0..nkids(call)):
            param = wi_param(decl, kid(call, i))
            if param < 0: fatal(nodes[at].pos, bad)
            params.push(param)
        s = lookup(int(nodes[callee].name))
        if s == 0 or syms[s].kind != .fns: fatal(nodes[callee].pos, "the validator of a constant check is a function: `{name_of(int(nodes[callee].name))}` is none")
        checks.push(CheckConstant(params, int(syms[s].decl), name_of(int(nodes[msg].sval))))
        cc_decls[decl] = checks
        cc_any = true

# (the constant string an argument is, or -1 when it is not one)
cc_constant = (x0: int) -> int:
    x = x0
    loop i in [0..16):
        if nodes[x].kind == .conv and nodes[x].a != 0 and prune(ntype(int(nodes[x].a))) == T_STR: x = int(nodes[x].a)
        else: break
    # (with parts, it is an interpolation)
    if nodes[x].kind == .str_lit: return if nkids(x) == 0: int(nodes[x].sval) else: -1
    if nodes[x].kind != .ident: return -1
    k = nodes[x].aux as SK
    if k != .const_ and k != .global and k != .local: return -1
    initial = binding_const_init(k, int(nodes[x].sym), nodes[x].pos)
    if initial != 0 and nodes[initial].kind == .str_lit and nkids(initial) == 0: return int(nodes[initial].sval)
    -1

# expr.jo, a call n of f (declaration decl) whose type is set: its narrowed type, or 0 when it
# stays as it is
cc_call = (n: int, f: int, decl: int) -> int:
    if cc_errors.has(decl): fatal(nodes[n].pos, cc_errors[decl])
    if not cc_decls.has(decl): return 0
    # (every argument constant and the value a plain record: the value, nothing at run time)
    folded = cc_fold_first(n, decl)
    if folded != 0: return folded
    if dir_runtime_policies.len() > 0 and nkids(n) > 0 and nodes[kid(n, 0)].kind == .str_lit and not pos_in_lib(nodes[n].pos):
        loop c in cc_decls[decl]:
            if files[pos_file(nodes[c.validator].pos)].path != lib_dir + "/time/zones.dewy" or name_of(int(nodes[c.validator].name)) == "zone_error": continue
            start = pos_off(nodes[n].pos)
            stop = pos_off(nodes[kid(n, 0)].pos)
            src = files[pos_file(nodes[n].pos)].src
            literal = stop > start
            loop i in [start..stop):
                if src[i] == 40:
                    literal = false
                    break
            if literal: fatal(nodes[n].pos, "literal validation through inherited run-time time policies is not yet supported; use a delimited zoned(text) call and handle its failures")
    # (the first check whose arguments are all closed decides)
    loop c in cc_decls[decl]:
        if c.params.len() == 1 and c.params[0] < nkids(n) and time_grid_proven(c.validator, kid(n, c.params[0])): return cc_narrow(n, "OffGrid")
        args = cc_arguments(kids(n), c)
        if args.len() != c.params.len(): continue
        pos = cc_check_pos(n, c)
        if let said = cc_verdict(c, args, pos):
            if said == "": return 0
            fatal(pos, "{c.message}: {said}")
        cc_passed[n] = true
        after = cc_fold_after(n, decl)
        if after != 0: return after
        return cc_narrow(n)
    0

# The constants a check's parameters are given, as its validator takes them; short when one is not.
cc_check_pos = (n: int, c: CheckConstant) -> int:
    pos = nodes[n].pos
    if nkids(n) > c.params[0] and not pos_in_lib(nodes[kid(n, c.params[0])].pos): pos = nodes[kid(n, c.params[0])].pos
    pos

cc_verdict = (c: CheckConstant, args: int[], pos: int) -> str?:
    key = ""
    if args.len() == 1 and nodes[args[0]].kind == .str_lit: key = "{c.validator}:{name_of(int(nodes[args[0]].sval))}"
    if key != "" and cc_verdicts.has(key):
        said = cc_verdicts[key]
        return if said == "\x01": none else: said
    said = cc_verdict_run(c, args, pos)
    if key != "": cc_verdicts[key] = said ?? "\x01"
    said

cc_verdict_run = (c: CheckConstant, args: int[], pos: int) -> str?:
    v = get_fn_inst(c.validator, [], pos)
    run = mk(.call, pos)
    nodes[run].sym = i32(v)
    nodes[run].type = fns[v].ret
    add_flag(run, NF_CHECKED)
    set_list(run, args)
    why = ct_values[ct_run(run)]
    if tkind(why.type) == .opt and why.i != 0: return ct_values[why.items[0]].s
    if tkind(why.type) == .str_: return why.s
    none

cc_choose = (n: int, decls: int[], args: int[][], params: int[][]) -> int[]:
    checked = 0
    loop d in decls:
        if cc_decls.has(d): checked += 1
    if checked < 2: return []
    passed: int[]
    plain: int[]
    failed = ""
    failed_pos = 0
    constant = true
    loop i in [0..decls.len()):
        if not cc_decls.has(decls[i]):
            plain.push(i)
            continue
        c = cc_decls[decls[i]][0]
        loop p in c.params:
            if p >= params[i].len() or prune(params[i][p]) != T_STR: return []
        given = cc_arguments(args[i], c)
        if given.len() != c.params.len():
            constant = false
            continue
        pos = nodes[n].pos
        if args[i].len() > c.params[0] and not pos_in_lib(nodes[args[i][c.params[0]]].pos): pos = nodes[args[i][c.params[0]]].pos
        if let said = cc_verdict(c, given, pos):
            if failed_pos == 0 and said != "":
                failed = "{c.message}: {said}"
                failed_pos = pos
        else: passed.push(i)
    if passed.len() > 0: return passed
    if constant and failed_pos != 0: fatal(failed_pos, failed)
    plain

cc_arguments = (xs: int[], c: CheckConstant) -> int[]:
    args: int[]
    loop p in c.params:
        if p >= xs.len(): return args
        x = xs[p]
        text = cc_constant(x)
        # (a string the parameter takes as itself; in a wider type, the argument keeps its conversion)
        if text >= 0 and prune(ntype(x)) == T_STR:
            arg = mk(.str_lit, nodes[x].pos)
            nodes[arg].sval = i32(text)
            nodes[arg].type = i32(T_STR)
            add_flag(arg, NF_CHECKED)
            args.push(arg)
        else:
            if not cc_closed_expr(x, 0): return args
            args.push(x)
    args

# A call that cannot fail: its type without the exceptions, or its value when that is one plain record.
cc_narrow = (n: int, only: str = "") -> int:
    # (it cannot fail: what is left of the result once its exceptions are gone)
    rt = prune(ntype(n))
    if not is_union(rt): return 0
    kept: int[]
    loop m in union_members(rt):
        if not exception_member(m) or only != "" and dt(m) != only: kept.push(m)
    if kept.len() == 0 or kept.len() == union_members(rt).len(): return 0
    inner = nodes.len()
    nodes.push(nodes[n])
    e = mk(.narrow, nodes[n].pos)
    t = kept[0]
    if kept.len() == 1: nodes[e].aux = i32(union_index(rt, t))
    else:
        t = mk_union(kept)
        nodes[e].kind = .conv
        nodes[e].aux = i32(int(CV.union_))
    nodes[e].a = i32(inner)
    nodes[e].type = i32(t)
    add_flag(e, NF_CHECKED)
    nodes[n] = nodes[e]
    t

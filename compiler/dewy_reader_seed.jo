# Frozen complete reader at the atomic Dewy cutover.

use 'intern.dewy'
struct SeedParserHost:
    value_name: (i32, int) -> i32
    intern_new: (str, int, int, int) -> int

rt_reader_word_name = (host: mut SeedParserHost, store: mut Node[], texts: mut str[], hashes: mut int[], slots: mut i32[], text: str, pos: int) -> int:
    n = node_mk(store, .ident, pos)
    h = hash_bytes(data(text), len(text))
    id = name_find(texts, hashes, slots, data(text), len(text), h)
    if id < 0: id = host.intern_new(text, 0, len(text), h)
    store[n].name = host.value_name(i32(id), pos)
    n


rt_reader_name_host = SeedParserHost(dw_value_name, intern_new)

rt_dc_report = (pos: int, msg: str): dc_parser_report(dc_parser.status, pos, msg)

# A mistake certain where it is read: reported now, after one noted earlier, when it may be.

rt_dc_fail_now = (pos: int, msg: str) -> int:
    rt_dc_report(pos, msg)
    if dc_parser.flags.report_now: rt_dc_flush_report()
    0

rt_dc_flush_report = ():
    if dc_parser.status.report_pos == 0: return
    pos = dc_parser.status.report_pos
    dc_parser.status.report_pos = 0
    fatal(pos, dc_parser.status.report_text)

# `what` is not supported (dw_fail's mistake).

rt_dc_unsupported = (pos: int, what: str): rt_dc_report(pos, "Dewy does not yet support {what}")

# `const x:int64` without a value (dw_declare's mistake): none stands in for it.

rt_dc_const_missing = (n: int):
    rt_dc_unsupported(nodes[n].pos, "a const declaration without an initializer")
    nodes[n].b = i32(mk(.none_lit, nodes[n].pos))

rt_dc_word_operator_at = (token: DewyLexeme):
    rt_dc_report(mkpos(dc_parser.file, token.start), "`{dn_token_text(token.symbol)}` is a word operator, not a name: choose another name")

# A parameter named by a word: `(in:int64)`, a word operator (dw_param's mistake, noted: true), or
# `(from:int64)`, a keyword (a parse mistake, at once); false for any other.

rt_dc_parameter_word = (parameter: DewyLexeme) -> bool:
    if dc_parser.tokens[dc_parser.at + 1].symbol != .colon or dc_parser.tokens[dc_parser.at + 1].space: return false
    word = parameter.symbol
    if word == .kw_from or word == .kw_import or word == .kw_return or word == .kw_break or word == .kw_continue: rt_dc_keyword_name(parameter)
    if word == .kw_not or not rt_dc_word_operator(word): return false
    rt_dc_word_operator_at(parameter)
    true

# `(from:int64)`: the parse mistake, a keyword as a name.

rt_dc_keyword_name = (token: DewyLexeme) -> int: dn_error(token.start, rt_dc_keyword_text(token.symbol))

rt_dc_keyword_text = (word: DewyToken) -> str: "`{dn_token_text(word)}` is a keyword, so it cannot name a variable, parameter or field: choose another name"

# A word operator, which is never a name (dw_word_operator_name).

rt_dc_word_operator = (t: DewyToken) -> bool: t == .kw_and or t == .kw_or or t == .kw_not or t == .kw_xor or t == .kw_nand or t == .kw_nor or t == .kw_xnor or t == .kw_in or t == .kw_as or t == .kw_transmute

# A reserved word read as a name (dewy_reserved_name's mistake).

rt_dc_reserved_at = (token: DewyLexeme):
    rt_dc_report(mkpos(dc_parser.file, token.start), dewy_reserved_text(rt_dn_payload(token)))

# First hint since the statement began, retained only if no reading succeeds.

rt_dc_hint = (pos: int, msg: str) -> int: dc_parser_hint(dc_parser.status, pos, msg)

# The direct parser reads no form that starts at token `at`: the mistake its readings gave up
# on (dc_hint), else the first noted, else that the form is not read.

rt_dc_unread = (at: int):
    cut = dc_scan_cut(dc_parser.tokens, at)
    if cut >= 0: rt_dc_cut_off(cut)
    if dc_parser.status.hint_pos != 0: fatal(dc_parser.status.hint_pos, dc_parser.status.hint_text)
    if dc_parser.status.report_pos != 0: fatal(dc_parser.status.report_pos, dc_parser.status.report_text)
    rt_dc_foreign_habit(at)
    fatal(mkpos(dc_parser.file, dc_parser.tokens[at].start), "Dewy does not read this form")

rt_dc_cut_off = (cut: int):
    token = dc_parser.tokens[cut]
    pos = mkpos(dc_parser.file, token.start)
    if token.kind == .eof: fatal(pos, "unexpected end of file")
    close = DewyToken.rbrace
    if token.symbol == .lparen: close = .rparen
    else if token.symbol == .lbrack: close = .rbrack
    fatal(pos, "expected '{dn_token_text(close)}' before end of file")

# A statement no reading takes, written as another language declares or loops (dc_unread's
# mistake): `type Op = ...`, `type Point struct { ... }`, `for _, x := range xs { ... }`.

rt_dc_foreign_habit = (at: int):
    token = dc_parser.tokens[at]
    if at > 0 and not token.newline and dc_parser.tokens[at - 1].kind == .identifier and rt_dn_payload(dc_parser.tokens[at - 1]) == "for": fatal(mkpos(dc_parser.file, dc_parser.tokens[at - 1].start), "iterate values with `loop x in xs \{ ... }`, or key and value with `loop [key value] in m \{ ... }`")
    name = dc_parser.tokens[at + 1]
    if token.kind != .identifier or token.name != i32(dc_parser.reader.dn_type_id) or name.kind != .identifier or name.newline: return
    pos = mkpos(dc_parser.file, token.start)
    written = rt_dn_payload(name)
    after = dc_parser.tokens[at + 2]
    src = files[dc_parser.file].src
    if after.symbol == .assign and not dc_parser.tokens[at + 3].newline and dc_parser.tokens[at + 3].kind != .eof:
        k = at + 3
        loop dc_parser.tokens[k + 1].kind != .eof and not dc_parser.tokens[k + 1].newline: k += 1
        aliased = src[dc_parser.tokens[at + 3].start..dc_parser.tokens[k].stop)
        fatal(pos, "a type alias binds a name with `:type =`: write `{written}:type = {aliased}`")
    if after.kind != .identifier or rt_dn_payload(after) != "struct": return
    listing = rt_dc_foreign_fields(at + 3)
    if listing == "": fatal(pos, "a record type uses `:type =`: write `{written}:type = [field:type ...]`")
    fatal(pos, "a record type uses `:type =`: write `{written}:type = [{listing}]`")

# `{ x int; y int }` at `at`: the fields as Dewy writes them, `x:int64 y:int64`; "" for other forms.

rt_dc_foreign_fields = (at: int) -> str:
    if dc_parser.tokens[at].symbol != .lbrace: return ""
    out = ""
    k = at + 1
    loop dc_parser.tokens[k].symbol != .rbrace:
        field = dc_parser.tokens[k]
        if field.kind == .eof: return ""
        kind = dc_parser.tokens[k + 1]
        if field.kind != .identifier or kind.kind != .identifier or kind.newline: return ""
        dewy = rt_dc_foreign_type(rt_dn_payload(kind))
        if dewy == "": return ""
        if out != "": out = out + " "
        out = out + rt_dn_payload(field) + ":" + dewy
        k += 2
        if dc_parser.tokens[k].symbol == .semi: k += 1
    out

# A builtin type another language spells w, as Dewy does ("" for others).

rt_dc_foreign_type = (w: str) -> str:
    if w == "int" or w == "i64": return "int64"
    if w == "uint" or w == "u64": return "uint64"
    if w == "float" or w == "number" or w == "f64": return "float64"
    if w == "bool" or w == "boolean": return "bool"
    if w == "string" or w == "str": return "string"
    if w == "byte": return "uint8"
    if rt_dc_integer_name(intern(w)) or w == "float32" or w == "float64": return w
    dewy_type_word(w)

rt_dc_lazy_body = () -> int:
    if dc_parser.tokens[dc_parser.at].kind == .lazy_body:
        t = dc_parser.tokens[dc_parser.at]
        b = mk(.block, mkpos(dc_parser.file, t.start))
        nodes[b].aux2 = DC_LAZY_SPAN
        nodes[b].ival = t.start
        dc_parser.reader.dc_lazy_span_end[b] = t.stop
        dc_parser.at += 1
        return b
    if not (dc_parser.reader.dc_lazy_on or dc_parser.reader.dc_lib_lazy) or dc_parser.tokens[dc_parser.at].symbol != .lbrace: return 0
    start = dc_parser.at
    at = start + 1
    depth = 1
    loop at < dc_parser.tokens.len():
        t = dc_parser.tokens[at]
        if t.symbol == .lbrace: depth += 1
        if t.symbol == .rbrace: depth -= 1
        if depth == 0:
            b = mk(.block, mkpos(dc_parser.file, dc_parser.tokens[start].start))
            nodes[b].aux2 = DC_LAZY_BODY
            nodes[b].ival = start
            dc_parser.at = at + 1
            if dc_parser.reader.dc_lazy_on: dc_lazy_used = true
            return b
        # These can declare names/imports or affect whole-program analysis at
        # parse time. Large/base literals may synthesize a bigint import.
        if t.kind == .metatag or t.kind == .integer or t.kind == .based_string or t.symbol == .function or t.symbol == .kw_import or t.symbol == .kw_from or t.symbol == .coalesce: return 0
        if t.kind == .source_integer and t.stop - t.start > 18: return 0
        # Interpolations can hide declarations, bigint imports or parse warnings.
        if t.kind == .quoted:
            source = files[dc_parser.file].src
            loop i in [t.start..t.stop):
                if source[i] == '{': return 0
        at += 1
    0

# The lazy_body tokens of the declaration at dc_parser.at, lexed (it parses another way, or its body
# does not wait): up to the first that ends a line

rt_dc_binary_token = (op: DewyToken) -> Tok:
    match op:
        plus: .plus
        minus: .minus
        star, multiply_apply: .star
        eq: .eq
        contains: .kw_in
        lt: .lt
        le: .le
        gt: .gt
        ge: .ge
        shl: .shl
        shr: .shr
        kw_and, amp: .amp
        kw_or, pipe: .pipe
        kw_xor: .caret
        _: .eof

# The names the direct grammar's arithmetic and iteration call, interned on first use.

rt_dc_builtin = (k: int) -> int:
    if dc_parser.reader.dc_builtins.len() == 0 or dc_parser.reader.dc_builtins[k] == 0: rt_dc_builtin_name(k)
    dc_parser.reader.dc_builtins[k]

rt_dc_builtin_name = (k: int):
    if dc_parser.reader.dc_builtins.len() == 0: dc_parser.reader.dc_builtins = [0, 0, 0, 0, 0]
    dc_parser.reader.dc_builtins[k] = intern(["__dewy_divide", "__dewy_power", "__floor_div", "__floor_mod", "__dewy_iter"][k])

rt_dc_binary = (op: DewyToken, left: int, right: int, pos: int) -> int:
    scalar = dn_token_uninvert(op)
    if scalar != op:
        inner = rt_dc_binary(scalar, left, right, pos)
        if inner == 0: return 0
        n = mk(.not_, pos)
        nodes[n].a = i32(inner)
        return n
    if op == .slash or op == .floor or op == .percent or op == .caret:
        k = if op == .slash: 0 else if op == .caret: 1 else if op == .floor: 2 else: 3
        callee = mk(.ident, pos)
        nodes[callee].name = i32(rt_dc_builtin(k))
        n = mk(.call, pos)
        nodes[n].a = i32(callee)
        set_list(n, [left, right])
        return n
    token = rt_dc_binary_token(op)
    if token == .eof: return 0
    n = mk(if op == .kw_and: NK.and_ else if op == .kw_or: NK.or_ else: NK.binary, pos)
    nodes[n].op = i32(int(token))
    nodes[n].a = i32(left)
    nodes[n].b = i32(right)
    n

# `xs[end]` in the index being read: its last, per axis (dw_expr's `$index_end`).

rt_dc_index_end = (pos: int) -> int:
    base = "$index_end{dc_parser.reader.dc_index_node}"
    nodes[dc_parser.reader.dc_index_node].sval = i32(intern(base))
    axis = int(nodes[dc_parser.reader.dc_index_node].aux2)
    spelled = if axis == 0: base else: "{base}_{axis}"
    comp_ident(intern(spelled), pos)

# `0x"0a0b"`: the bytes a based string spells (dw_binary).

rt_dc_based_string = (token: DewyLexeme, pos: int) -> int:
    problem = LiteralProblem("", 0, false)
    packed = literal_packed(problem, rt_dn_payload(token))
    # (dw_literal_problem's mistakes, noted)
    if len(problem.message) > 0:
        if not dc_parser.flags.report_now: return 0
        if problem.unsupported: rt_dc_unsupported(pos, problem.message)
        else: rt_dc_report(pos, problem.message)
    text = mk(.str_lit, pos)
    nodes[text].sval = i32(intern(str_from_bytes(packed)))
    callee = mk(.ident, pos)
    nodes[callee].name = i32(intern("bytes"))
    call = mk(.call, pos)
    nodes[call].a = i32(callee)
    set_list(call, [text])
    call

# A real literal dc_short_real does not read exactly.

rt_dc_long_real = (token: DewyLexeme, pos: int) -> int:
    number = replace(rt_dn_payload(token), "_", "")
    value = to_float(number)
    # (beyond float64: the checker reports it)
    if value == none: return 0
    n = mk(.float_lit, pos)
    nodes[n].fval = value!
    nodes[n].sval = i32(intern(number))
    add_flag(n, NF_LITERAL)
    n

# A metatag value: `$target`, `$build.mode` (the name being compiled for, the build's mode,
# dw_expr), `$allocator`, `$lend`, `$include_bytes`; 0 for another form, left unread
# (dc_unread), -1 for none of these (dc_atom goes on).

rt_dc_metatag_atom = (token: DewyLexeme, pos: int) -> int:
    width = token.stop - token.start
    if width == 7 and rt_dn_payload(token) == "target": return rt_dc_target_value(0, pos, -1)
    if width == 6 and rt_dn_payload(token) == "build":
        dot = dc_parser.tokens[dc_parser.at]
        member = dc_parser.tokens[dc_parser.at + 1]
        # (`$build.debug`: syntax_target_field's mistake)
        if dc_parser.flags.report_now and dot.symbol == .dot and not dot.space and not member.space and member.kind == .identifier and rt_dc_build_member(member, pos):
            dc_parser.at += 2
            return rt_dc_target_value(3, pos, member.start)
        if dot.symbol != .dot or dot.space or member.space or member.kind != .identifier or rt_dn_payload(member) != "mode": return 0
        dc_parser.at += 2
        return rt_dc_target_value(3, pos, member.start)
    if width == 10 and rt_dn_payload(token) == "allocator": return rt_dc_allocator(token)
    if width == 5 and rt_dn_payload(token) == "lend": return rt_dc_lend(token)
    if width == 14 and rt_dn_payload(token) == "include_bytes": return rt_dc_include_bytes(pos)
    # (`let y = $expect true`: dw_directive's mistake)
    if (width == 7 and rt_dn_payload(token) == "expect" or width == 5 and rt_dn_payload(token) == "fail") and dc_parser.flags.report_now: return rt_dc_fail_now(pos, "`${rt_dn_payload(token)}` is a statement: it returns from its function when it fails, so it cannot give a value")
    -1

# `$build.debug`, `$build.opt`: syntax_target_field's mistake (false for `mode`).

rt_dc_build_member = (member: DewyLexeme, pos: int) -> bool:
    text = rt_dn_payload(member)
    if text == "mode": return false
    if text == "debug": rt_dc_report(pos, "`$build` has `mode` ('debug' or 'release'), not `debug`: test `$build.mode =? 'debug'`")
    else: rt_dc_report(pos, "`$build` has `mode` ('debug' or 'release'), not `{text}`")
    true

# `end` and `new` outside brackets: dw_expr's mistakes, the rest of the statement read
# (a value in their place); 0 for `type` and anywhere else.

rt_dc_outside_index = (name: int, pos: int) -> int:
    # (`type of x` as a value: dw_expr's mistake, should nothing else read it)
    if name == dc_parser.reader.dn_type_id and rt_dn_peek() == .kw_of: return rt_dc_hint(pos, "`type of ...` forms a type, not a runtime value; bind it with `T:type = type of ...`")
    if dc_parser.reader.dc_index_node != 0 or not dc_parser.flags.report_now or name == dc_parser.reader.dn_type_id: return 0
    if name == dc_parser.reader.dn_end_id: rt_dc_report(pos, "`end` is the last index inside brackets, as in `xs[end]` or `xs[1..end]`; outside them, use `xs.length - 1`")
    else: rt_dc_report(pos, "`new` inserts an axis as an entry inside brackets, as in `xs[new]` or `xs[.. new]`")
    mk(.none_lit, pos)

# A word operator where a value starts is a name (`in + 1`, dw_expr's identifier).

rt_dc_word_name = (token: DewyLexeme, pos: int) -> int:
    rt_reader_word_name(rt_reader_name_host, nodes, names, name_hash, name_tab, rt_dn_payload(token), pos)

rt_dc_atom = () -> int:
    token = dc_parser.tokens[dc_parser.at]
    op = token.symbol
    pos = mkpos(dc_parser.file, token.start)
    dc_parser.at += 1
    # (names first: the commonest atom)
    if token.kind == .identifier and (op == .none or op == .kw_test):
        name = int(token.name)
        # `xs[end]`: the index's last (dw_expr's `$index_end`), per axis
        if name == dc_parser.reader.dn_end_id and dc_parser.reader.dc_index_node != 0: return rt_dc_index_end(pos)
        # (`end` and `new` outside brackets: dw_expr's mistakes; the rest of the statement is read)
        if name == dc_parser.reader.dn_end_id or name == dc_parser.reader.dn_new_id or name == dc_parser.reader.dn_type_id: return rt_dc_outside_index(name, pos)
        if name == dc_parser.reader.dn_none_id: return mk(.none_lit, pos)
        n = mk(.ident, pos)
        nodes[n].name = dw_value_name(token.name, pos)
        return n
    if op == .kw_concurrent: return rt_dc_concurrent(token, false)
    if op == .kw_spawn: return rt_dc_spawn(token)
    # (`in + 1`: a word operator where a value starts is a name, dw_expr's identifier)
    if token.kind == .identifier and op != .kw_not and op != .kw_and and op != .kw_or and rt_dc_word_operator(op) and dc_parser.flags.report_now: return rt_dc_word_name(token, pos)
    if token.kind == .source_integer:
        source = files[dc_parser.file].src
        bytes = source.data()
        first = token.start
        if first + 1 < token.stop and bytes[first] == '0' and bytes[first + 1] == 'd': first += 2
        value: u64 = 0
        wide = false
        loop k in [first..token.stop):
            c = bytes[k]
            if c == '_': continue
            digit = u64(c - '0')
            if value > (u64(0x7FFFFFFFFFFFFFFF) - digit) / 10:
                wide = true
                break
            value = value * 10 + digit
        if wide: return rt_dc_wide_integer(token, pos)
        n = mk(.int_lit, pos)
        nodes[n].ival = int(value)
        add_flag(n, NF_LITERAL)
        return n
    if token.kind == .integer: return rt_dc_wide_integer(token, pos)
    # `0x"0a0b"`: the bytes a based string spells (dw_binary)
    if token.kind == .based_string: return rt_dc_based_string(token, pos)
    if token.kind == .source_real:
        fast = rt_dc_short_real(token)
        if fast != none:
            n = mk(.float_lit, pos)
            nodes[n].fval = fast!
            nodes[n].sval = i32(intern_sub(files[dc_parser.file].src, token.start, token.stop - token.start))
            add_flag(n, NF_LITERAL)
            return n
        return rt_dc_long_real(token, pos)
    # (`x in? ..b`, `x in? ..`: an open range, dw_iterable's)
    if op == .range and dc_parser.reader.dc_member_depth == dc_parser.depth:
        dc_parser.at -= 1
        return rt_dc_member_range(pos)
    # `[0..n)`, `[1,4..11]`, `(a..b]`: a range value (dw_range_value); in a membership, the range
    # itself, which may be open (`x in? [..0]`, dw_membership)
    if (op == .lbrack or op == .lparen) and rt_dn_peek() != .kw_loop and rt_dn_peek() != .kw_parallel and rt_dc_range_inside(dc_parser.at - 1):
        range = rt_dc_range_atom()
        if range >= 0: return range
    if op == .lparen:
        after = rt_dn_peek()
        if dn_partial_operator(after) or after == .kw_not and dn_token_invert(dc_parser.tokens[dc_parser.at + 1].symbol) != .none: return rt_dc_partial(token)
        return rt_dc_group(pos)
    # `if c a else b` and `match` as values; loops and `$target` chains are left unread (dc_unread)
    if op == .kw_if or op == .kw_match:
        dc_parser.at -= 1
        return rt_dc_flow()
    if op == .kw_loop and dc_parser.flags.report_now: return rt_dc_loop_value(pos)
    # `$unsafe expression`: the boundary holds over the expression (dw_unsafe_scope)
    if token.kind == .metatag:
        tagged = rt_dc_metatag_atom(token, pos)
        if tagged >= 0: return tagged
        if not rt_dc_unsafe_at(dc_parser.at - 1): return rt_dc_tag_unread(token, pos)
        operand = rt_dc_expr(0)
        if operand == 0: return 0
        rt_dc_unsafe_scope(pos)
        return operand
    # `@x` selects a place; `@f(a)` partially evaluates f
    if op == .at:
        operand = dc_parser.at
        e = rt_dc_expr(160)
        if e == 0: return 0
        # (`@(m.lock())`: the operand is one group, whose call takes the place it returns)
        if nodes[e].kind == .call and dc_parser.tokens[operand].symbol == .lparen and rt_dc_closing(operand) == dc_parser.at - 1: nodes[e].aux2 = i32(AUX2_PLACE)
        else if nodes[e].kind == .call: nodes[e].aux2 = i32(AUX2_PARTIAL)
        else: add_flag(e, NF_MUT | NF_AT)
        return e
    # `{ ... }`: a block whose value is its last statement's (dw_block)
    if op == .lbrace:
        dc_parser.at -= 1
        return rt_dc_body()
    # `[loop i in xs f(i)]`: a comprehension
    if op == .lbrack and rt_dn_peek() == .kw_loop: return rt_dc_comprehension()
    if op == .lbrack and rt_dn_peek() == .kw_parallel:
        region = rt_dc_parallel(rt_dn_take(), true)
        if region == 0 or not rt_dn_accept(.rbrack): return 0
        return region
    # `[a b c]`, `[x=1 y=2]`, `["a" -> 1]`, `[base... x=1]`, `[1 2 ; 3 4]`
    if op == .lbrack: return rt_dc_array_literal(pos)
    # `.-xs`: elementwise negation (dw_expr's prefix)
    if op == .dot_minus or op == .dot_plus:
        e = rt_dc_expr(dn_prefix_power(op, false))
        if e == 0: return 0
        n = mk(.unary, pos)
        nodes[n].op = i32(int(if op == .dot_minus: Tok.minus else: Tok.plus))
        nodes[n].a = i32(e)
        add_flag(n, NF_BROADCAST)
        return n
    # `~x`: `not x` at a tighter precedence (dw_expr's prefix)
    if op == .tilde:
        e = rt_dc_expr(dn_prefix_power(op, false))
        if e == 0: return 0
        n = mk(.not_, pos)
        nodes[n].op = i32(int(Tok.plus))
        nodes[n].a = i32(e)
        return n
    if op == .plus or op == .minus or op == .kw_not:
        e = rt_dc_expr(dn_prefix_power(op, false))
        if e == 0: return 0
        if op == .minus and nodes[e].kind == .int_lit and nodes[e].aux2 == 0:
            if has_flag(e, NF_U64) and nodes[e].ival != -9223372036854775807 - 1:
                magnitude = u64(nodes[e].ival)
                return rt_dc_bigint_value([magnitude & 0xFFFFFFFF, magnitude >> 32], pos, true)
            nodes[e].ival = -nodes[e].ival
            nodes[e].pos = pos
            nodes[e].aux2 = 1
            clear_flag(e, NF_U64)
            return e
        if op == .minus and nodes[e].kind == .float_lit:
            nodes[e].fval = -nodes[e].fval
            if nodes[e].sval != 0: nodes[e].sval = i32(intern("-" + name_of(int(nodes[e].sval))))
            nodes[e].pos = pos
            return e
        n = mk(if op == .kw_not: NK.not_ else: NK.unary, pos)
        nodes[n].op = i32(int(if op == .minus: Tok.minus else: Tok.plus))
        nodes[n].a = i32(e)
        return n
    if token.kind == .quoted or token.kind == .rawquoted: return rt_dn_string(token)
    if token.kind == .boolean:
        n = mk(.bool_lit, pos)
        nodes[n].ival = if int(token.name) == dc_parser.reader.dn_true_id: 1 else: 0
        return n
    if dc_parser.flags.report_now and (token.kind == .op or token.kind == .eof): return rt_dc_atom_mistake(token)
    rt_dc_atom_unread(token, pos)

# (`let n = $unsafe`: a tag no value form fits, dw_metatag_fail's mistake, should nothing else
# read it)

rt_dc_tag_unread = (token: DewyLexeme, pos: int) -> int:
    name = rt_dn_payload(token)
    if name != "target": rt_dc_hint(pos, metatag_fail_text(name))
    0

# (`1 +` then `return 0`: a keyword statement as an operator's operand, dw_expr's mistake, should
# nothing else read it)

rt_dc_atom_unread = (token: DewyLexeme, pos: int) -> int:
    op = token.symbol
    if (op == .kw_return or op == .kw_break or op == .kw_continue or op == .kw_let or op == .kw_const) and dc_parser.at >= 2 and dn_power(dc_parser.tokens[dc_parser.at - 2].symbol) > 0: rt_dc_hint(pos, "expected a value after `{rt_dn_payload(dc_parser.tokens[dc_parser.at - 2])}`; `{rt_dn_payload(token)}` begins a statement")
    0

# A parenthesized group after its `(`: one value, or several (`(a b)`, dw_values), through `)`.
# (`xs[..)`: no value at dc_parser.at, dn_atom's mistake, should nothing else read it)

rt_dc_no_operand = () -> bool:
    token = dc_parser.tokens[dc_parser.at]
    if token.kind != .op: return false
    text = rt_dn_payload(token)
    rt_dc_hint(mkpos(dc_parser.file, token.start), "expected an expression, found '{text}'{dn_operator_habit(dc_parser.tokens, dc_parser.at + 1, text)}")
    false

# A token no value starts with (dn_atom's mistakes, at once); 0 for one read as another form.

rt_dc_atom_mistake = (token: DewyLexeme) -> int:
    symbol = token.symbol
    if token.kind == .eof: return dn_error(token.start, "expected an expression")
    if symbol == .ellipsis or symbol == .lparen or symbol == .lbrack or symbol == .lbrace or symbol == .langle or symbol == .tilde or symbol == .plus or symbol == .minus or symbol == .dot_plus or symbol == .dot_minus or symbol == .at or symbol == .kw_not or symbol == .range: return 0
    text = rt_dn_payload(token)
    after_colon = symbol == .colon or dc_parser.at >= 2 and dc_parser.tokens[dc_parser.at - 2].symbol == .colon
    # (`(from:int64)`, `let loop = 1`: a keyword where a name was meant)
    if (symbol == .colon or symbol == .assign) and dc_parser.at >= 2 and dc_parser.tokens[dc_parser.at - 2].symbol != .none and not dc_parser.tokens[dc_parser.at - 1].newline:
        word = dn_token_text(dc_parser.tokens[dc_parser.at - 2].symbol)
        named = symbol == .assign or dc_parser.tokens[dc_parser.at - 2].stop == token.start and not (word in ["else", "loop", "if", "match"])
        if named and len(word) > 0 and word[0] >= 'a' and word[0] <= 'z': return dn_error(dc_parser.tokens[dc_parser.at - 2].start, "`{word}` is a keyword, so it cannot name a variable, parameter or field: choose another name")
    if after_colon and (symbol == .colon or symbol == .rbrack): return dn_error(token.start, "expected an expression, found '{text}' (a slice is a range in the brackets: `xs[1..]`, `xs[..n)`, `xs[a..b)`; `xs.reversed()` reverses; `:` gives a type)")
    # (`x := 1`: a binding written as another language declares one)
    if symbol == .assign and dc_parser.at >= 3 and dc_parser.tokens[dc_parser.at - 2].symbol == .colon and dc_parser.tokens[dc_parser.at - 2].stop == token.start and dc_parser.tokens[dc_parser.at - 3].kind == .identifier:
        bound = rt_dn_payload(dc_parser.tokens[dc_parser.at - 3])
        dn_error(dc_parser.tokens[dc_parser.at - 3].start, "a new local binding uses `let {bound} = value`; an existing binding uses `{bound} = value`")
    habit = dn_operator_habit(dc_parser.tokens, dc_parser.at, text)
    dn_error(token.start, "expected an expression, found '{text}'{habit}")

# `x = loop c {...} else v`: a loop as a value (dw_expr's mistake, noted; the flow read).

rt_dc_loop_value = (pos: int) -> int:
    rt_dc_unsupported(pos, "a loop used as a value; use return or a comprehension")
    dc_parser.at -= 1
    rt_dc_flow()

rt_dc_group = (pos: int) -> int:
    # (`(a b)`: several values, dw_values; each may be spread, `(xs... 1)`)
    saved_spread = dc_parser.reader.dc_spread_depth
    dc_parser.reader.dc_spread_depth = dc_parser.depth + 1
    n = rt_dc_expr(0)
    items: int[]
    loop n != 0 and not rt_dn_accept(.rparen):
        if items.len() == 0: items.push(n)
        if not dn_can_start(dc_parser.tokens, dc_parser.at) or dc_parser.tokens[dc_parser.at].symbol == .rparen:
            n = 0
            break
        dc_parser.reader.dc_spread_depth = dc_parser.depth + 1
        item = rt_dc_expr(0)
        if item == 0: n = 0
        else: items.push(item)
    dc_parser.reader.dc_spread_depth = saved_spread
    if n == 0: return 0
    if items.len() == 0:
        # (`(xs...)`: dw_expr's mistake, should nothing else read it)
        if has_flag(n, NF_SPREAD): return rt_dc_hint(nodes[n].pos, "spread is supported inside array or record literals and call arguments: `[values... item]`, `[base... field=value]`, `add(pair...)`")
        return n
    values = mk(.tuple, pos)
    nodes[values].aux = i32(TUPLE_VALUES)
    set_list(values, items)
    return values

# A bracketed range at dc_parser.at (after its opener), as dc_atom reads one: its value, or in a
# membership the range itself; -1 when the brackets hold no range (nothing read).

rt_dc_range_atom = () -> int:
    start = dc_parser.at
    node_start = nodes.len()
    list_start = lists.len()
    edits = dc_parser.reader.dn_edit_at.len()
    member = dc_parser.reader.dc_member_depth == dc_parser.depth
    axis = dc_parser.reader.dc_axis_depth == dc_parser.depth
    range = rt_dc_range(true, true, member or axis)
    if dc_parser.at < 0: return 0
    if range != 0:
        # (`[1..]`: a slice's or a loop's, not a value: dewy_range_value reports it; an axis among
        # several takes it as a slice, dw_iterable)
        if nodes[range].a == 0 or nodes[range].b == 0:
            # (dewy_range_value's mistake, noted)
            if not axis and (not member or has_flag(range, NF_EXCL_FIRST)): return rt_dc_stored_open(range)
            if axis: dc_parser.reader.dc_open_axes += 1
            dc_parser.reader.dc_range_call = range
            dc_parser.reader.dc_range_node = range
            return range
        value = dw_range_value(range)
        dc_parser.reader.dc_range_call = value
        dc_parser.reader.dc_range_node = range
        return value
    dc_parser.at = start
    nodes.truncate(node_start)
    lists.truncate(list_start)
    rt_dn_edits_undo(edits)
    -1

rt_dc_stored_open = (range: int) -> int:
    if not dc_parser.flags.report_now: return 0
    rt_dc_report(nodes[range].pos, "a stored range needs both endpoints; open ranges can be used directly in loops or membership")
    range

# An array literal after its `[`, through `]`: elements, a record's named fields and spreads, a
# dictionary's entries, or rows; other comprehensions and collectors are read
# elsewhere.

rt_dc_array_literal = (pos: int) -> int:
    n = mk(.array, pos)
    saved = dc_parser.flags.comma_stop
    dc_parser.flags.comma_stop = false
    items: int[]
    named = false       # (a row is a named field: the literal is a record)
    positional = false  # (an element neither spread nor named)
    breaks: int[]       # (`[1 2 ; 3 4]`: the row breaks after each element, dw_rows_literal)
    rows = false
    discards: int[]     # (`[f(); 7]`: the elements an attached `;` discards)
    pure_at: int[]      # (where those of them whose discarding does nothing are written, dw_pure)
    starts: int[]       # (where each element is written)
    grouped: int[]      # (the elements written as one parenthesized group: each one value, dw_collect)
    flows = false
    targets = dc_parser.reader.dc_targets_made
    loop not rt_dn_accept(.rbrack):
        if dc_parser.tokens[dc_parser.at].kind == .eof:
            if dc_parser.flags.report_now: rt_dc_unclosed(pos, "]")
            return 0
        if rt_dn_peek() == .semi:
            if breaks.len() == 0:
                # (`[; 1 2]`: dw_rows_literal's mistake, noted)
                if not dc_parser.flags.report_now: return 0
                rt_dc_report(mkpos(dc_parser.file, dc_parser.tokens[dc_parser.at].start), "an array literal cannot start with `;`: a `;` ends a row, as in `[1 2 ; 3 4]`")
                dc_parser.at += 1
                continue
            breaks[breaks.len() - 1] += 1
            rows = true
            dc_parser.at += 1
            continue
        # (`[x=1 y=2]`: a named field; methods are left unread (dc_unread))
        if rt_dc_named_next():
            field = dc_parser.tokens[dc_parser.at]
            if rt_dn_reserved(int(field.name)) or nodes[n].kind == .map_lit: return 0
            dc_parser.at += 2
            # (`[f=() => ...]`: a method, dw_method_row, when the function reaches a row)
            method = rt_dc_lambda_next() or rt_dn_peek() == .langle and rt_dc_generic_lambda_next()
            value = rt_dc_expr(11)
            if value == 0 or method != (nodes[value].kind == .lambda): return 0
            entry = mk(.namedarg, mkpos(dc_parser.file, field.start))
            nodes[entry].name = field.name
            nodes[entry].a = i32(value)
            items.push(entry)
            named = true
            continue
        # (`[$field("answer")=42]`: a field named by a compile-time string, dw_field_name)
        if rt_dc_field_next():
            entry = rt_dc_field_entry()
            if entry == 0 or nodes[n].kind == .map_lit: return 0
            items.push(entry)
            named = true
            continue
        # (a flow or block element may express several values or none: then the literal collects
        # them, dw_collector)
        first = rt_dn_peek()
        if first == .kw_if or first == .kw_loop or first == .kw_match or first == .lbrace: flows = true
        # (`[xs... 1]`: an element spread; `["a" -> 1]`: a dictionary's entry)
        item_start = dc_parser.tokens[dc_parser.at].start
        item_at = dc_parser.at
        item = 0
        if first == .kw_loop:
            item = rt_dc_flow()
            if item == 0 or not rt_dc_flow_ends(): return 0
        else:
            saved_spread = dc_parser.reader.dc_spread_depth
            dc_parser.reader.dc_spread_depth = dc_parser.depth + 1
            item = rt_dc_expr(21)
            dc_parser.reader.dc_spread_depth = saved_spread
        if item == 0: return 0
        if first == .lparen and rt_dc_closing(item_at) == dc_parser.at - 1: grouped.push(items.len())
        if rt_dn_peek() == .arrow:
            if items.len() == 0: nodes[n].kind = .map_lit
            if nodes[n].kind != .map_lit or has_flag(item, NF_SPREAD): return 0
            dc_parser.at += 1
            value = rt_dc_expr(21)
            if value == 0: return 0
            pair = mk(.pair, mkpos(dc_parser.file, item_start))
            nodes[pair].a = i32(item)
            nodes[pair].b = i32(value)
            item = pair
        # (`["a" -> 1 2]`: dw_expr's mistake, should nothing else read it)
        else if nodes[n].kind == .map_lit:
            extra = files[dc_parser.file].src[item_start..dc_parser.tokens[dc_parser.at - 1].stop)
            return rt_dc_hint(mkpos(dc_parser.file, item_start), "each dictionary item needs one `key -> value` pair; remove the extra `{extra}` or give it a key")
        if not has_flag(item, NF_SPREAD): positional = true
        # (an attached `;` discards the element: a collector, dw_collects; a pure value's is
        # warned of)
        if rt_dn_peek() == .semi and not dc_parser.tokens[dc_parser.at].space and not dc_parser.tokens[dc_parser.at].newline:
            if not rt_dc_discardable(item):
                if not rt_dc_pure(item): return 0
                pure_at.push(mkpos(dc_parser.file, item_start))
            dc_parser.at += 1
            discards.push(items.len())
        items.push(item)
        starts.push(mkpos(dc_parser.file, item_start))
        breaks.push(0)
    dc_parser.flags.comma_stop = saved
    collects = discards.len() > 0
    if pure_at.len() > 0 and not rt_dc_pure_discards(pure_at, rows): return 0
    if flows:
        loop i in 0.. and item in items:
            if not has_flag(item, NF_SPREAD) and not grouped.contains(i) and rt_dc_multi(item): collects = true
    if collects:
        if named and positional and not rows: return rt_dc_hint(rt_dc_mixed_at(items, starts), "Dewy does not yet support a record item without a field name and =")
        if named or rows or nodes[n].kind == .map_lit or flows and dc_parser.reader.dc_targets_made != targets: return 0
        return rt_dc_collector(items, starts, discards, grouped, pos)
    # (a record's rows are named fields and spreads, dw_record_entry)
    if named:
        if positional and not rows and dc_parser.flags.report_now: rt_dc_mixed_record(items, starts)
        else if positional or rows: return 0
        nodes[n].kind = .record_lit
        if not rt_dc_literal_methods(items): return 0
    if rows: return rt_dc_rows(n, items, breaks, pos)
    set_list(n, items)
    return n

# `[x=42 2]`: an element neither named nor spread among fields (dw_record_entry's mistake, noted).
# (starts: where each element not a field is written)

rt_dc_mixed_record = (items: int[], starts: int[]):
    at = rt_dc_mixed_at(items, starts)
    if at != 0: rt_dc_unsupported(at, "a record item without a field name and =")

# (where the first such element is written; 0 for none)

rt_dc_mixed_at = (items: int[], starts: int[]) -> int:
    k = 0
    loop item in items:
        if nodes[item].kind == .namedarg: continue
        if not has_flag(item, NF_SPREAD) and k < starts.len(): return starts[k]
        k += 1
    0

# An element expressing a number of values other than one (dw_multi_element): a block of other
# than one statement, a loop, an `if` without `else`, or one holding such a body.

rt_dc_mixed_at = (flow: int) -> int:
    dc_parser.collection.mixed_pos = 0
    rt_dc_kind_of(flow)
    dc_parser.collection.mixed_pos

rt_dc_multi = (n: int) -> bool:
    if n <= 0: return false
    k = nodes[n].kind
    if k == .exprstmt: return rt_dc_multi(int(nodes[n].a))
    if k == .block:
        if has_flag(n, NF_COMPREHENSION) or has_flag(n, NF_DISCARD): return false
        return nkids(n) != 1 or rt_dc_multi(kid(n, 0))
    if k == .for_ or k == .while_ or k == .loopx: return true
    if k == .if_: return rt_dc_multi(int(nodes[n].b)) or nodes[n].c == 0 or rt_dc_multi(int(nodes[n].c))
    if k == .match_:
        loop arm in kids(n):
            if rt_dc_multi(int(nodes[arm].b)): return true
    false

# A value an attached `;` may discard without a warning (dw_pure): a call.

rt_dc_discardable = (n: int) -> bool:
    if nodes[n].kind != .call or has_flag(n, NF_SPREAD): return false
    callee = int(nodes[n].a)
    nodes[callee].kind != .ident or (nodes[callee].name != i32(rt_dc_builtin(0)) and nodes[callee].name != i32(rt_dc_builtin(1)))

# Pure values an attached `;` discards, where each is written: dw_discard_check's warning, or its
# mistake among rows (false).

rt_dc_pure_discards = (pure_at: int[], rows: bool) -> bool:
    if rows:
        rt_dc_fail_now(pure_at[0], "this `;` is attached to the value before it, which discards that value and does nothing here: {DW_ROW_HINT}")
        return false
    loop at in pure_at: warn(at, "this `;` is attached to the value before it, which discards that value, so `[1 2; 3 4]` is `[1 3 4]`: {DW_ROW_HINT}; to drop the value, leave it out")
    true

# A value whose discarding does nothing (dw_pure): a literal, a name, or arithmetic of them.

rt_dc_pure = (n: int) -> bool:
    k = nodes[n].kind
    if k == .ident or k == .int_lit or k == .float_lit or k == .bool_lit: return true
    if k == .str_lit: return nkids(n) == 0
    if k == .unary: return not has_flag(n, NF_BROADCAST) and rt_dc_pure(int(nodes[n].a))
    if k != .binary or has_flag(n, NF_BROADCAST): return false
    op = nodes[n].op
    (op == i32(int(Tok.plus)) or op == i32(int(Tok.minus)) or op == i32(int(Tok.star)) or op == i32(int(Tok.slash)) or op == i32(int(Tok.caret))) and rt_dc_pure(int(nodes[n].a)) and rt_dc_pure(int(nodes[n].b))

# `[0 {1 2} if c 3]`: a literal collecting every value its elements express, in order
# (dw_collector); starts, where each element is written; discards, those an attached `;` discards.

rt_dc_collector = (items: int[], starts: int[], discards: int[], grouped: int[], pos: int) -> int:
    accumulator = intern("$dewy_collection_{nodes.len()}")
    decl = mk(.vardecl, pos)
    nodes[decl].name = i32(accumulator)
    nodes[decl].b = i32(mk(.array, pos))
    statements: int[]
    loop i in 0.. and item in items:
        at = starts[i]
        if discards.contains(i):
            n = mk(.assign, at)
            nodes[n].op = i32(int(Tok.assign))
            nodes[n].a = i32(mk(.hole, at))
            nodes[n].b = i32(item)
            statements.push(n)
            continue
        if has_flag(item, NF_SPREAD):
            clear_flag(item, NF_SPREAD)
            receiver = mk(.ident, at)
            nodes[receiver].name = i32(accumulator)
            add_flag(receiver, NF_MUT)
            callee = mk(.field, at)
            nodes[callee].a = i32(receiver)
            nodes[callee].name = i32(intern("extend"))
            call = mk(.call, at)
            nodes[call].a = i32(callee)
            set_list(call, [item])
            statement = mk(.exprstmt, at)
            nodes[statement].a = i32(call)
            statements.push(statement)
            continue
        k = nodes[item].kind
        # (`[(match x {...}) {2 3}]`: a parenthesized element is one value, pushed)
        if grouped.contains(i) and k != .call:
            statement = mk(.exprstmt, at)
            nodes[statement].a = i32(rt_dc_push(accumulator, item, at))
            statements.push(statement)
            continue
        if k == .match_ or k == .parallel_region: return 0
        if k == .if_ or k == .for_ or k == .while_ or k == .loopx:
            add_flag(item, NF_STMT)
            if rt_dc_collect(item, accumulator) == 0: return 0
            statements.push(item)
            continue
        if k == .block and not has_flag(item, NF_COMPREHENSION):
            if not rt_dc_collect_block(item, accumulator, false): return 0
            statements.push(item)
            continue
        statement = mk(.exprstmt, at)
        nodes[statement].a = i32(item)
        statement = rt_dc_collect(statement, accumulator)
        if statement == 0: return 0
        statements.push(statement)
    body = mk(.block, pos)
    set_list(body, statements)
    result = mk(.exprstmt, pos)
    value = mk(.ident, pos)
    nodes[value].name = i32(accumulator)
    nodes[result].a = i32(value)
    block = mk(.block, pos)
    set_list(block, [decl, body, result])
    add_flag(block, NF_COMPREHENSION)
    block

# A record literal's function rows, among its entries: each that reaches a row by name is a
# method, taking the object first (dw_literal_method); the rows registered (dw_register_literal_methods).
# False for a function the reach does not follow.

rt_dc_literal_methods = (entries: int[]) -> bool:
    members: int[]
    any = false
    loop entry in entries:
        if nodes[entry].kind != .namedarg: continue
        if nodes[entry].name != 0: members.push(int(nodes[entry].name))
        if nodes[int(nodes[entry].a)].kind == .lambda: any = true
    if not any: return true
    loop entry in entries:
        if nodes[entry].kind != .namedarg or nodes[int(nodes[entry].a)].kind != .lambda: continue
        fn_ = int(nodes[entry].a)
        receiver = intern("$self{nodes.len()}")
        dc_parser.reach.used.remove(receiver)
        saved = dc_parser.reach.scope
        inner: {int: int} = {}
        loop name, other in saved: inner[name] = other
        loop name in members: inner[name] = receiver
        dc_parser.reach.scope = inner
        reached = rt_dc_reach_fn(fn_)
        dc_parser.reach.scope = saved
        if not reached: return false
        if not dc_parser.reach.used.has(receiver): continue
        pos = nodes[fn_].pos
        object_type = mk(.ident, pos)
        nodes[object_type].name = i32(intern("$Object{receiver}"))
        if has_flag(fn_, NF_GENERIC): set_list2(fn_, [object_type] + kids2(fn_))
        else:
            captures = kids2(fn_)
            if captures.len() > 0:
                listed = mk(.block, pos)
                set_list(listed, captures)
                nodes[fn_].d = i32(listed)
            set_list2(fn_, [object_type])
            add_flag(fn_, NF_GENERIC)
        receiver_type = mk(.tname, pos)
        nodes[receiver_type].name = nodes[object_type].name
        dw_add_receiver(fn_, receiver, receiver_type)
    dc_parser.reader.dn_edit_at.push(DN_EDIT_METHODS - dewy_methods.len())
    dc_parser.reader.dn_edit_was.push(dc_parser.tokens[dc_parser.at - 1])
    dw_register_literal_methods(entries)
    true

# `(*2)`, `(=? limit)`, `(as float64)` after its `(`: a one-parameter lambda whose operand stands
# in place of the parenthesis (dn_partial).
# (a partial application opens at `at`, `(*2)`)

rt_dc_partial_at = (at: int) -> bool:
    after = dc_parser.tokens[at + 1].symbol
    dc_parser.tokens[at].symbol == .lparen and (dn_partial_operator(after) or after == .kw_not and dn_token_invert(dc_parser.tokens[at + 2].symbol) != .none)

# `(*2)` after its `(`: a lambda of `$partial`; `name_id`, the module function `name = (*2)`
# declares.

rt_dc_partial = (opening: DewyLexeme, name_id: i32 = 0) -> int:
    pos = mkpos(dc_parser.file, opening.start)
    if dc_parser.reader.dc_partial_name == 0: dc_parser.reader.dc_partial_name = intern("$partial")
    slot = dc_parser.at - 1
    dc_parser.tokens[slot] = DewyLexeme(.identifier, i32(dc_parser.reader.dc_partial_name), opening.start, opening.stop, opening.space, opening.newline)
    dc_parser.at = slot
    saved_angles = dc_parser.reader.dn_angles
    dc_parser.reader.dn_angles = 0
    value = rt_dc_expr(0)
    dc_parser.reader.dn_angles = saved_angles
    dc_parser.tokens[slot] = opening
    if value == 0 or not rt_dn_accept(.rparen): return 0
    n = mk(if name_id != 0: NK.fn_ else: NK.lambda, pos)
    nodes[n].name = if name_id != 0: name_id else: i32(rt_dc_empty_name())
    p = mk(.param, pos)
    nodes[p].name = i32(dc_parser.reader.dc_partial_name)
    statement = mk(.exprstmt, pos)
    nodes[statement].a = i32(value)
    body = mk(.block, pos)
    set_list(body, [statement])
    dw_finish_function(n, [p], body, if name_id != 0: name_of(int(name_id)) else: "")

# `(p"asset")` after `$include_bytes`.

rt_dc_include_form = () -> bool:
    opening = dc_parser.tokens[dc_parser.at]
    p = dc_parser.tokens[dc_parser.at + 1]
    path = dc_parser.tokens[dc_parser.at + 2]
    opening.symbol == .lparen and not opening.space and p.kind == .identifier and p.symbol == .none and rt_dn_payload(p) == "p" and path.kind == .quoted and not path.space and dc_parser.tokens[dc_parser.at + 3].symbol == .rparen

# `$include_bytes(p"asset")` after its tag: the asset's bytes, `embed("asset")` (dw_include); the
# forms dw_include reports are left unread (dc_unread).

rt_dc_include_bytes = (pos: int) -> int:
    if not rt_dc_include_form(): return 0
    path = dc_parser.tokens[dc_parser.at + 2]
    dc_parser.at += 4
    text = rt_dn_string(path)
    if text == 0 or nodes[text].kind != .str_lit: return 0
    callee = mk(.ident, pos)
    nodes[callee].name = i32(intern("embed"))
    call = mk(.call, pos)
    nodes[call].a = i32(callee)
    set_list(call, [text])
    call

# `$include_bytes(p"asset") as name`, a statement: the asset's bytes bound to the name (dw_stmt's
# asset binding).

rt_dc_include_binding = (token: DewyLexeme) -> int:
    pos = mkpos(dc_parser.file, token.start)
    dc_parser.at += 1
    if not rt_dc_include_form() or dc_parser.tokens[dc_parser.at + 4].symbol != .kw_as: return 0
    name = dc_parser.tokens[dc_parser.at + 5]
    if name.kind != .identifier or name.symbol != .none or rt_dn_reserved(int(name.name)): return 0
    n = mk(.vardecl, pos)
    value = rt_dc_include_bytes(pos)
    if value == 0: return 0
    dc_parser.at += 2
    nodes[n].name = name.name
    nodes[n].b = i32(value)
    rt_dc_accept_semi(not dc_parser.reader.dc_unbraced)
    n

# An integer literal the plain decimal reading does not take: based, or beyond int64 (dw_expr's
# integer: a uint64 literal, or an exact one, dw_big_integer). 0 for a mistake, left unread
# (dc_unread).

rt_dc_wide_integer = (token: DewyLexeme, pos: int) -> int:
    text = rt_dn_payload(token)
    p = LiteralProblem("", 0, false)
    if let value = literal_unsigned(p, text):
        if len(p.message) > 0: return 0
        n = mk(.int_lit, pos)
        nodes[n].ival = int(value)
        add_flag(n, NF_LITERAL)
        if nodes[n].ival < 0: add_flag(n, NF_U64)
        return n
    if len(p.message) > 0: return 0
    limbs = literal_limbs(p, text)
    if len(p.message) > 0: return 0
    rt_dc_bigint_value(limbs, pos, false)

# dw_bigint_value, its module's bigint import asked for undoably: a retry that discards the
# literal discards the request with it (dn_edits_undo).

rt_dc_bigint_value = (limbs: u64[], pos: int, negative: bool) -> int:
    if dw_bigint_import == 0:
        dc_parser.reader.dn_edit_at.push(DN_EDIT_BIGINT)
        dc_parser.reader.dn_edit_was.push(dc_parser.tokens[dc_parser.at - 1])
    dw_bigint_value(limbs, pos, negative)

# The brackets opening at `at` hold a range at their top: a `..` not inside other brackets.

rt_dc_range_inside = (at: int) -> bool:
    depth = 0
    k = at
    loop k < dc_parser.tokens.len():
        t = dc_parser.tokens[k]
        if t.kind == .eof: return false
        symbol = t.symbol
        if symbol == .lparen or symbol == .lbrack or symbol == .lbrace: depth += 1
        else if symbol == .rparen or symbol == .rbrack or symbol == .rbrace:
            depth -= 1
            if depth == 0: return false
        else if symbol == .range and depth == 1: return true
        k += 1
    false

# `[1 2 ; 3 4]`: the elements of an array literal in rows (each element's breaks after it), a
# matrix, or for more levels the elements reshaped (dw_rows_literal). 0 for a literal it reports.

rt_dc_rows = (n: int, elements: int[], breaks: int[], pos: int) -> int:
    loop item in elements:
        if nodes[n].kind != .array or has_flag(item, NF_SPREAD): return 0
    rank = 1
    loop b in breaks: rank = max(rank, b + 1)
    dims = fill(-1, rank)
    counts = fill(0, rank)
    loop i in 0.. and b in breaks:
        counts[0] += 1
        close = rank - 1
        if i + 1 < breaks.len(): close = b
        loop level in [1..close]:
            size = counts[level - 1]
            if dims[level - 1] < 0: dims[level - 1] = size
            else if dims[level - 1] != size:
                # (dw_rows_literal's mistake, noted)
                if not dc_parser.flags.report_now: return 0
                rt_dc_ragged(level, size, dims[level - 1], nodes[elements[i]].pos)
            counts[level - 1] = 0
            counts[level] += 1
    dims[rank - 1] = counts[rank - 1]
    if rank == 2:
        nodes[n].kind = .matrix
        set_list(n, elements)
        nodes[n].ival = dims[0]
        return n
    set_list(n, elements)
    shape: int[]
    k = rank - 1
    loop k >= 0:
        shape.push(bc_int(dims[k], pos))
        k -= 1
    sizes = mk(.array, pos)
    set_list(sizes, shape)
    bc_call("reshape", [n, sizes], pos)

rt_dc_ragged = (level: int, size: int, first: int, pos: int):
    what = if level == 1: "rows" else if level == 2: "blocks" else: "parts"
    unit = if level == 1: "elements" else if level == 2: "rows" else: "parts"
    rt_dc_report(pos, "the {what} of an array literal must have the same size: this one has {size} {unit}, the first has {first}")

# The index of the bracket closing the one at `at` (-1: none).

rt_dc_closing = (at: int) -> int: dc_scan_closing(dc_parser.tokens, at)

# A plain real literal (no base prefix or separators) whose significant digits
# and exponent are exact doubles: one correctly rounded operation, as to_float's
# own fast path computes, without materializing the literal's text.

rt_dc_short_real = (token: DewyLexeme) -> f64?:
    source = files[dc_parser.file].src
    bytes = source.data()
    k = token.start
    stop = token.stop
    if bytes[k] == '0' and k + 1 < stop and bytes[k + 1] == 'd': return none
    mant: u64 = 0
    digits = 0
    zeros = 0
    exp = 0
    point = false
    loop k < stop:
        c = bytes[k]
        if c == '.': point = true
        else if c == 'e' or c == 'E': break
        else if c < '0' or c > '9': return none
        else if digits > 0 or c != '0':
            if digits == 19: return none
            mant = mant * 10 + u64(c - '0')
            digits += 1
            zeros = if c == '0': zeros + 1 else: 0
            if point: exp -= 1
        else if point: exp -= 1
        k += 1
    if k < stop:
        k += 1
        negative = false
        if bytes[k] == '+' or bytes[k] == '-':
            negative = bytes[k] == '-'
            k += 1
        e = 0
        loop k < stop:
            c = bytes[k]
            if c < '0' or c > '9' or e > 1000: return none
            e = e * 10 + int(c - '0')
            k += 1
        exp += if negative: -e else: e
    if digits == 0: return 0.0
    loop zeros > 0:
        mant = mant / 10
        digits -= 1
        zeros -= 1
        exp += 1
    if digits > 15 or exp < -22 or exp > 22: return none
    if exp >= 0: return f64(mant) * __pow10(exp)
    f64(mant) / __pow10(-exp)

rt_dc_expr = (minimum: int) -> int:
    dc_parser.depth += 1
    if dc_parser.depth + dc_parser.reader.dn_depth > 256: return rt_dc_too_deep()
    opening = dc_parser.tokens[dc_parser.at]
    pos = mkpos(dc_parser.file, opening.start)
    first_at = dc_parser.at
    left = 0
    # `(params) => body`, `x => body`: a lambda, where `=>` may apply (dw_function)
    # (`x => body` is found at its `=>`, below)
    lambda = minimum <= 30 and (opening.symbol == .lparen and rt_dc_lambda_next() or opening.symbol == .langle and rt_dc_generic_lambda_next())
    if lambda:
        type_params: int[]
        if opening.symbol == .langle:
            # `<T>(x:T) => x`: a generic lambda
            type_params = rt_dc_type_params()
            if type_params.len() == 0: return 0
        else: dc_parser.at += 1
        dc_parser.depth += 3
        left = rt_dc_function_literal(i32(rt_dc_empty_name()), opening, type_params, true)
    else: left = rt_dc_atom()
    if left == 0: return 0
    # (a name, a field route or a parenthesized group: `head(...)` may be a coefficient)
    juxt_head = not lambda and (opening.symbol == .lparen or opening.kind == .identifier and nodes[left].kind == .ident)
    # (a parenthesized group, while nothing has applied to it: `(5)x`, `(x)2` multiply)
    group = if not lambda and opening.symbol == .lparen and dc_parser.tokens[dc_parser.at - 1].symbol == .rparen: left else: -1
    last_call = 0     # (the call this loop made last: a member or index right after it is marked)
    compared = false    # (left is a comparison this loop made)
    compared_op = DewyToken.none     # (its operator, and where its right operand starts)
    compared_at = 0
    chain = -1          # (the chain being read: its first entry in dc_chain_ops, dc_chain_build)
    loop true:
        token = dc_parser.tokens[dc_parser.at]
        op = token.symbol
        if chain >= 0 and not rt_dc_chain_goes_on(token, minimum):
            left = rt_dc_chain_build(chain, pos)
            chain = -1
            if left == 0: return 0
        if token.kind == .eof: break
        if token.newline and dn_power(op) == 0 and op != .kw_not: break
        if dc_parser.reader.dn_angles > 0 and (op == .shr or op == .shr_assign or op == .angle_assign or (op == .gt and not token.space)): break
        if not token.space and (token.kind == .identifier or op == .lparen or token.kind == .source_integer or token.kind == .source_real or token.kind == .integer):
            pk = dc_parser.tokens[dc_parser.at - 1].kind
            if (left == group or pk == .source_integer or pk == .source_real or pk == .integer) and dn_juxtaposed(dc_parser.tokens, dc_parser.at, left == group):
                if minimum > 135: break
                right = rt_dc_expr(136)
                if right == 0: return 0
                left = rt_dc_binary(.multiply_apply, left, right, pos)
                add_flag(left, NF_JUXT)
                juxt_head = false
                continue
            if op != .lparen and dn_juxt_excluded(dc_parser.tokens, dc_parser.at): return rt_dc_juxt_mistake()
        if op == .dot and minimum <= 170:
            dc_parser.at += 1
            member = dc_parser.tokens[dc_parser.at]
            # `f.(xs)`: the call broadcast over its arguments; `value.$field(name)`: a member named
            # by a compile-time string
            if member.symbol == .lparen and not member.space or member.kind == .metatag:
                left = rt_dc_dot_form(left, left == last_call, pos)
                if left == 0: return 0
                if nodes[left].kind == .call: juxt_head = false
                continue
            if member.kind != .identifier: return rt_dc_member_mistake(member)
            dc_parser.at += 1
            # `$target.arch`, `$target.os`: that part of the name (dw_target_field)
            if dc_parser.reader.dc_targets_made > 0 and left == nodes.len() - 1 and rt_dc_target_of(left) == 0 and rt_dc_target_member(left, member): continue
            n = mk(.field, pos)
            nodes[n].a = i32(left)
            nodes[n].name = member.name
            if left == last_call: add_flag(n, NF_JUXT)
            dewy_note_member(n)
            left = n
            continue
        if not token.space and op == .lparen and minimum <= 170:
            dc_parser.at += 1
            n = mk(.call, pos)
            nodes[n].a = i32(left)
            if juxt_head: add_flag(n, NF_JUXT)
            if nodes[left].kind == .field: add_flag(int(nodes[left].a), NF_MUT)
            # (`members(<'a' | 1>)`: members(U) takes a type, grouped as in a type position)
            if rt_dn_peek() == .langle and nodes[left].kind == .ident and rt_dc_named_members(left):
                if not rt_dc_members_type(n): return 0
                left = n
                last_call = n
                juxt_head = false
                continue
            if not rt_dc_arguments(n, .rparen): return 0
            left = n
            last_call = n
            juxt_head = false
            continue
        # `xs[i]`, `Point[x y]`, `Point[x=1 y=2]`; ranges, `end`, `new` and
        # `set[...]` are left unread (dc_unread).
        if not token.space and op == .lbrack and minimum <= 170:
            # `set[a b]`: a set of the literal's elements (dw_expr's `__dewy_set`)
            if nodes[left].kind == .ident and rt_dc_word(int(nodes[left].name)) == DC_SET and left == nodes.len() - 1:
                elements = rt_dc_atom()
                if elements == 0: return 0
                left = rt_dc_set_call(elements, pos)
                juxt_head = false
                continue
            dc_parser.at += 1
            n = mk(.index, pos)
            nodes[n].a = i32(left)
            if left == last_call: add_flag(n, NF_JUXT)
            # (`end` inside is this index's last: dw_index_context)
            saved_index = dc_parser.reader.dc_index_node
            dc_parser.reader.dc_index_node = n
            read = rt_dc_index(n)
            dc_parser.reader.dc_index_node = saved_index
            if not read: return 0
            nodes[n].aux2 = 0
            left = n
            juxt_head = false
            continue
        # `f<T>(x)`: the application as a type, and its arguments again as types
        if not token.space and op == .langle and minimum <= 160:
            # (`b.read<uint64>(2)`: a module's name, dw_type's `.`)
            name_token = dc_parser.tokens[dc_parser.at - 1]
            first = dc_parser.at - 1
            if not rt_dc_named_base(left):
                left = rt_dc_type_applied(left, pos)
                if left == 0: return 0
                juxt_head = false
                continue
            if nodes[left].kind == .field and dc_parser.at >= 3 and dc_parser.tokens[dc_parser.at - 2].symbol == .dot and dc_parser.tokens[dc_parser.at - 3].kind == .identifier and nodes[int(nodes[left].a)].kind == .ident and nodes[int(nodes[left].a)].pos == mkpos(dc_parser.file, dc_parser.tokens[dc_parser.at - 3].start): first = dc_parser.at - 3
            else if nodes[left].kind != .ident or name_token.kind != .identifier or nodes[left].pos != mkpos(dc_parser.file, name_token.start): return 0
            at = dc_parser.at
            dc_parser.at = first
            edits = dc_parser.reader.dn_edit_at.len()
            whole = rt_dc_type_named()
            # (`small = int64<i => ...>`: a refinement names a type, dw_top_declarations)
            if whole == 0 or nodes[whole].kind == .trefined: return 0
            stop = dc_parser.at
            n = mk(.typeapply, pos)
            nodes[n].a = i32(left)
            nodes[n].c = i32(whole)
            args: int[]
            # (`int64<overflow='wrap'>(x)`: a policy is no type argument)
            if nodes[whole].aux != -9:
                # (the arguments read again from their original tokens: a closer split again)
                rt_dn_edits_undo(edits)
                dc_parser.at = at + 1
                loop not rt_dn_accept(.rangle):
                    arg = rt_dc_annotation()
                    if arg == 0: return 0
                    args.push(arg)
                if dc_parser.at != stop: return 0
            set_list(n, args)
            left = n
            juxt_head = false
            continue
        if op == .kw_or_throw and minimum <= 48:
            dc_parser.at += 1
            n = mk(.propagate, pos)
            nodes[n].a = i32(left)
            left = n
            juxt_head = false
            continue
        if not token.space and (token.kind == .quoted or token.kind == .rawquoted) and minimum <= 170:
            # `b'a'`, `b"abc"`: a byte, or an array of bytes (dw_byte_literal)
            if nodes[left].kind == .ident and rt_dc_word(int(nodes[left].name)) == DC_B:
                written = dc_parser.tokens[dc_parser.at - 1]
                if written.kind != .identifier or nodes[left].pos != mkpos(dc_parser.file, written.start): return 0
                literal = rt_dc_byte_literal(token)
                if literal == 0: return 0
                dc_parser.at += 1
                left = literal
                last_call = literal
                juxt_head = false
                continue
            dc_parser.at += 1
            arg = rt_dn_string(token)
            if arg == 0: return 0
            n = mk(.call, pos)
            nodes[n].a = i32(left)
            if nodes[left].kind == .field: add_flag(int(nodes[left].a), NF_MUT)
            set_list(n, [arg])
            left = n
            last_call = n
            juxt_head = false
            continue
        if op == .kw_not and dc_parser.at + 1 < dc_parser.tokens.len():
            inverted = dn_token_invert(dc_parser.tokens[dc_parser.at + 1].symbol)
            if inverted != .none: op = inverted
        if op == .comma and dc_parser.flags.comma_stop: break
        # `x => body`: the name just read is a lambda's one parameter
        if op == .function and minimum <= 30 and left == nodes.len() - 1 and nodes[left].kind == .ident and opening.kind == .identifier and dc_parser.tokens[dc_parser.at - 1].start == opening.start and rt_dc_lambda_next_at(dc_parser.at - 1):
            nodes.truncate(left)
            dc_parser.at -= 1
            dc_parser.depth += 3
            left = rt_dc_function_literal(i32(rt_dc_empty_name()), opening, [], true, true)
            if left == 0: return 0
            juxt_head = false
            group = -1
            continue
        # (`key -> value` as a comprehension's element: dc_body_read pairs them)
        if dc_parser.reader.dc_map_ok and op == .arrow: break
        power = dn_power(op)
        if power == 0 or power < minimum: break
        # (a slice's first bound ends at its `..`; elsewhere a range is left unread (dc_unread))
        # (`evens = 0,2..100`: a stepped range's two starts, below)
        step = 0
        if op == .comma and dc_parser.reader.dc_index_node == 0 and dc_parser.reader.dc_member_depth != dc_parser.depth and minimum <= dn_power(.range):
            dc_parser.at += 1
            step = rt_dc_expr(power + 1)
            if step == 0 or rt_dn_peek() != .range:
                # (`[1, 2, 3]`: commas after the first element, not a stepped range's starts;
                # dw_comma_fail's mistake, should nothing else read it)
                if step != 0 and first_at > 0 and dc_parser.tokens[first_at - 1].symbol == .lbrack and not rt_dc_range_follows(dc_parser.at): rt_dc_hint(pos, rt_dc_comma_text())
                return 0
            op = DewyToken.range
            power = dn_power(op)
        if op == .range:
            if dc_parser.reader.dc_range_top and minimum == 0 and step == 0: break
            # (`x in? a..b`, `x in? a..`: the range itself, dw_membership; elsewhere `a..b` and
            # `a,b..c` are range values, dw_range_value)
            member = dc_parser.reader.dc_member_depth == dc_parser.depth
            if not member and (dc_parser.reader.dc_index_node != 0 or dc_parser.reader.dc_range_top): return 0
            dc_parser.at += 1
            last = 0
            if dn_range_bound(dc_parser.tokens, dc_parser.at):
                last = rt_dc_expr(power + 1)
                if last == 0: return 0
            n = mk(.range, pos)
            nodes[n].a = i32(left)
            nodes[n].b = i32(last)
            add_flag(n, NF_INCLUSIVE)
            if step != 0:
                if member: return 0
                nodes[n].c = i32(step)
                add_flag(n, NF_STEP)
            left = n
            if not member:
                if last == 0: return 0
                left = dw_range_value(n)
            juxt_head = false
            continue
        if (op == .plus or op == .minus) and token.space and not dc_parser.tokens[dc_parser.at + 1].space: break
        # `x is? T`, `x isnt? T`, `x as T`, `x transmute T`: a type on the right
        if token.symbol == op and (op == .is_type or op == .isnt_type or op == .kw_as or op == .kw_transmute):
            if compared and (op == .is_type or op == .isnt_type): return 0
            dc_parser.at += 1
            t = rt_dc_cast_type(op == .kw_as, power)
            if t == 0: return 0
            n = mk(if op == .kw_as or op == .kw_transmute: NK.cast else: NK.istype, pos)
            nodes[n].a = i32(left)
            nodes[n].b = i32(t)
            if op == .kw_transmute: nodes[n].aux2 = 1
            if op == .isnt_type:
                inverted = mk(.not_, pos)
                nodes[inverted].a = i32(n)
                n = inverted
            left = n
            compared = false
            juxt_head = false
            continue
        # `a ?? b`: an arithmetic fallback (`a ?? 1 + n`) has a warning of its own
        if op == .coalesce:
            # `x ??<A | B> fallback`: the fallback only for the kinds listed, one type (c)
            if dc_parser.at + 1 < dc_parser.tokens.len() and not dc_parser.tokens[dc_parser.at + 1].space and (dc_parser.tokens[dc_parser.at + 1].symbol == .langle or dc_parser.tokens[dc_parser.at + 1].symbol == .lt):
                left = rt_dc_listed_coalesce(left, power, pos)
                if left == 0: return 0
                compared = false
                juxt_head = false
                continue
            dc_parser.at += 1
            right_at = dc_parser.at
            right = rt_dc_expr(power)
            if right == 0: return 0
            rt_dc_coalesce_arithmetic(left, first_at, right, right_at)
            n = mk(.coalesce, pos)
            nodes[n].a = i32(left)
            nodes[n].b = i32(right)
            left = n
            compared = false
            juxt_head = false
            continue
        # `x |> f`, `f <| x`: the value supplied to the callable (dw_expr's pipes)
        if op == .pipe_right or op == .pipe_left:
            left = rt_dc_pipe(op, left, power, pos)
            if left == 0: return 0
            compared = false
            juxt_head = false
            continue
        # `a nand b`: `not (a and b)`, as `nor` and `xnor` are of `or` and `xor` (the `not` at the word)
        if op == .kw_nand or op == .kw_nor or op == .kw_xnor:
            left = rt_dc_word_not(op, left, power, pos)
            if left == 0: return 0
            compared = false
            juxt_head = false
            continue
        scalar_op = dn_token_uninvert(op)
        if rt_dc_binary_token(scalar_op) == .eof and op != .slash and op != .floor and op != .percent and op != .caret:
            # (`xs[1:2]`, `if c:`, `item in xs`, `[@n]() => n`: the mistakes of operators no value
            # takes, dc_colon)
            if op == .colon:
                way = rt_dc_colon(left, pos, minimum)
                if way == 0: return 0
                if way == 2: break
                continue
            if op == .kw_in:
                if rt_dc_in_mistake(pos) == 0: return 0
                continue
            if op == .function:
                if rt_dc_capture_list(left, pos, first_at) == 0: return 0
                continue
            # `xs .+ ys`, `a .* 2`: elementwise (dw_broadcast)
            scalar = dn_token_undot(op)
            if scalar == .none or token.symbol != op: return rt_dc_operator_mistake()
            dc_parser.at += 1
            right = rt_dc_expr(if dn_right_associative(op): power else: power + 1)
            if right == 0: return 0
            left = rt_dc_broadcast(scalar, left, right, pos)
            if left == 0: return 0
            compared = false
            juxt_head = false
            continue
        # `a <? b <=? c`: a comparison chain (dw_chain), its links read in order; one through
        # `not` is left unread (dc_unread)
        chained = dw_chain_way(scalar_op) != 2 or scalar_op == .not_eq
        if chained and compared:
            if token.symbol != op or scalar_op != op: return rt_dc_not_chain(pos)
            if chain < 0:
                if nodes[left].kind != .binary or dn_token_uninvert(compared_op) != compared_op: return rt_dc_not_chain(pos)
                chain = dc_parser.reader.dc_chain_ops.len()
                rt_dc_chain_push(.none, int(nodes[left].a), first_at)
                rt_dc_chain_push(compared_op, int(nodes[left].b), compared_at)
            dc_parser.at += 1
            at = dc_parser.at
            right = rt_dc_expr(power + 1)
            if right == 0: return 0
            rt_dc_chain_push(op, right, at)
            continue
        dc_parser.at += 1
        if token.symbol == .kw_not: dc_parser.at += 1
        membership = op == .contains or op == .not_contains
        if membership: dc_parser.reader.dc_range_call = 0
        compared_op = op
        compared_at = dc_parser.at
        saved_member = dc_parser.reader.dc_member_depth
        if membership: dc_parser.reader.dc_member_depth = dc_parser.depth + 1
        right = rt_dc_expr(if dn_right_associative(op): power else: power + 1)
        dc_parser.reader.dc_member_depth = saved_member
        if right == 0: return 0
        # (`x in? [0..9]`: membership in the range itself, dw_membership)
        if membership and dc_parser.reader.dc_range_call == right:
            if not has_flag(dc_parser.reader.dc_range_node, NF_STEP) and not has_flag(dc_parser.reader.dc_range_node, NF_EXCL_FIRST): right = dc_parser.reader.dc_range_node
            # (in a refinement's predicate the range itself, whatever its bounds: dc_ref_ranges)
            else if dc_parser.reader.dc_refining > 0: rt_dc_note_member_range(right)
        # (`f & g` of function literals: an overload group, declared at module level only)
        if op == .amp and (rt_dc_overloads(left) or rt_dc_overloads(right)) and not rt_dc_local_group(first_at, minimum): return 0
        # (`a(x)^2` with the call unparenthesized: the power may take the group, juxtapose.jo)
        powered_call = op == .caret and left == last_call
        left = rt_dc_binary(op, left, right, pos)
        if powered_call: add_flag(left, NF_JUXT)
        compared = chained
        juxt_head = false
    if chain >= 0:
        left = rt_dc_chain_build(chain, pos)
        if left == 0: return 0
    # These suffixes belong to this expression, but have not migrated yet.
    token = dc_parser.tokens[dc_parser.at]
    if not token.space and (token.symbol == .lbrack or token.symbol == .langle or token.kind == .quoted or token.kind == .rawquoted): return 0
    if token.symbol == .question or token.symbol == .ellipsis:
        # (`xs...` as a whole array element: dc_spread_depth; anywhere else unread)
        if token.symbol == .question or minimum > 170: return 0
        if dc_parser.depth != dc_parser.reader.dc_spread_depth:
            if not dc_parser.flags.report_now or rt_dc_spread_outside(pos) == 0: return 0
            dc_parser.depth -= 1
            return left
        after = dc_parser.tokens[dc_parser.at + 1]
        if not (after.space or after.newline or after.symbol == .rbrack or after.symbol == .rparen) or dn_power(after.symbol) > 0 or after.symbol == .dot or after.symbol == .question or after.symbol == .ellipsis: return 0
        dc_parser.at += 1
        add_flag(left, NF_SPREAD)
    dc_parser.depth -= 1
    left

# (dn_expr's mistake, at once)

rt_dc_too_deep = () -> int:
    if dc_parser.flags.report_now: dn_error(dc_parser.tokens[dc_parser.at].start, "expression is nested too deeply")
    0

# `value.` then no name (dn_expr's mistake, at once).

rt_dc_member_mistake = (member: DewyLexeme) -> int:
    if not dc_parser.flags.report_now: return 0
    if member.kind == .metatag and dw_designed_directive(rt_dn_payload(member)): return dn_error(member.start, "`${rt_dn_payload(member)}` is part of the design but not implemented yet")
    dn_error(member.start, "expected a member name")

# An operator dc_expr does not read, before an operator no value starts with (`x == 3`, `xs[1:]`):
# the parse mistake at that operator (dn_atom's), at once; 0 otherwise.

rt_dc_operator_mistake = () -> int:
    if not dc_parser.flags.report_now or dn_power(dc_parser.tokens[dc_parser.at].symbol) == 0: return 0
    bad = dc_parser.tokens[dc_parser.at + 1]
    if bad.kind != .op: return 0
    dc_parser.at += 2
    rt_dc_atom_mistake(bad)

# `:` after a value (a type annotation): 1 when its mistake is noted and its
# type read on (`xs[1:2]`), 2 where it ends the value (an `if` condition's, dc_colon_body), 0
# otherwise, or the mistake reported at once (`x:int64 => x` as an argument).

rt_dc_colon = (left: int, pos: int, minimum: int) -> int:
    if not dc_parser.flags.report_now: return 0
    bad = dc_parser.tokens[dc_parser.at + 1]
    if bad.kind == .op or not dn_can_start(dc_parser.tokens, dc_parser.at + 1): return rt_dc_operator_mistake()
    if dc_parser.reader.dn_in_interpolation > 0: return 0
    if dc_parser.reader.dc_condition_depth == dc_parser.depth or dc_parser.reader.dc_top_level and dc_parser.depth == 1 and minimum == 11: return 2
    if minimum <= 30 and nodes[left].kind == .ident and left == nodes.len() - 1:
        dc_parser.at += 1
        if rt_dc_expr(46) == 0: return 0
        if rt_dn_peek() != .function: return rt_dc_colon_value(pos)
        return rt_dc_fail_now(pos, "only one bare parameter name may omit the parentheses; write an annotated or typed signature as `(x:int64) => ...`")
    if dc_parser.reader.dc_axis_depth != dc_parser.depth: return rt_dc_colon_value(pos)
    rt_dc_report(pos, rt_dc_colon_text())
    dc_parser.at += 1
    if rt_dc_expr(46) == 0: return 0
    1

rt_dc_colon_text = () -> str: "`:` gives a type here (`x:int64`), not a value: a slice is a range in the brackets, `xs[1..3)`, and a dictionary entry is `key -> value`"

# (the mistake should the statement read no other way)

rt_dc_colon_value = (pos: int) -> int: rt_dc_hint(pos, rt_dc_colon_text())

# `[@n]() => n` at `=>`: dw_function's mistake, noted; the body read on.

rt_dc_capture_list = (left: int, pos: int, first_at: int) -> int:
    if not dc_parser.flags.report_now or nodes[left].kind != .call or dc_parser.tokens[first_at].symbol != .lbrack: return 0
    opening = rt_dc_closing(first_at) + 1
    if dc_parser.tokens[opening].symbol != .lparen or rt_dc_closing(opening) != dc_parser.at - 1: return 0
    rt_dc_unsupported(pos, "a separate capture list; use ($capture @name) in the parameter list")
    dc_parser.at += 1
    if rt_dc_expr(30) == 0: return 0
    1

# `item in xs` outside a loop's head (Python's `for x in xs`, `if x in xs`): dw_expr's mistake,
# noted; its right operand read on.

rt_dc_in_mistake = (pos: int) -> int:
    if not dc_parser.flags.report_now or dc_parser.reader.dn_in_interpolation > 0 or dc_parser.reader.dc_head_depth == dc_parser.depth: return 0
    rt_dc_report(pos, "`in` names a loop's values, as in `loop item in items \{ ... }`; membership is `in?`, as in `if x in? xs \{ ... }`")
    dc_parser.at += 1
    rt_dc_expr(dn_power(.kw_in) + 1)

# `f(2)g(3)`: dn_expr's mistake, at once.

rt_dc_juxt_mistake = () -> int:
    if dc_parser.flags.report_now: dn_error(dc_parser.tokens[dc_parser.at].start, dn_juxt_excluded_message(dc_parser.tokens, dc_parser.at))
    0

# `a <? b not =? c` (dw_expr's mistake, at once: reading on would take another reading).

rt_dc_not_chain = (pos: int) -> int:
    if dc_parser.flags.report_now: rt_dc_fail_now(pos, "`not` comparisons do not chain; join the comparisons with `and`")
    0

# `xs...` where no spread goes (dw_expr's mistake, noted; the `...` read).

rt_dc_spread_outside = (pos: int) -> int:
    rt_dc_report(pos, "spread is supported inside array or record literals and call arguments: `[values... item]`, `[base... field=value]`, `add(pair...)`")
    dc_parser.at += 1
    1

# `$target.arch`, `$target.os`: that part of the name (dw_target_field).

rt_dc_target_member = (left: int, member: DewyLexeme) -> bool:
    word = rt_dn_payload(member)
    if word != "arch" and word != "os": return false
    rt_dc_target_note(left, if word == "arch": 1 else: 2, member.start)
    true

rt_dc_named_members = (n: int) -> bool: name_of(int(nodes[n].name)) == "members"

rt_dc_set_call = (elements: int, pos: int) -> int: bc_call("__dewy_set", [elements], pos)

# `xs[0]<int64>`, `make().f<int64>` at the `<`: no type is named, only its arguments, each a type
# (dw_expr's type application).

rt_dc_type_applied = (left: int, pos: int) -> int:
    dc_parser.at += 1
    args: int[]
    dc_parser.reader.dc_type_args += 1
    loop not rt_dn_accept(.rangle):
        if dc_parser.reader.dn_edits_on and rt_dn_closer_joined():
            rt_dn_split_closer()
            break
        arg = rt_dc_annotation()
        if arg == 0:
            dc_parser.reader.dc_type_args -= 1
            return 0
        args.push(arg)
    dc_parser.reader.dc_type_args -= 1
    n = mk(.typeapply, pos)
    nodes[n].a = i32(left)
    set_list(n, args)
    n

# `x |> f`, `f <| x` at the operator: the value supplied to the callable (dw_expr's pipes).

rt_dc_pipe = (op: DewyToken, left: int, power: int, pos: int) -> int:
    dc_parser.at += 1
    right = rt_dc_expr(if dn_right_associative(op): power else: power + 1)
    if right == 0: return 0
    n = mk(.call, pos)
    callee = right
    supplied = left
    if op == .pipe_left:
        callee = left
        supplied = right
    nodes[n].a = i32(callee)
    set_list(n, [supplied])
    n

# `a nand b` at the operator: `not (a and b)`, as `nor` and `xnor` are of `or` and `xor`, the `not`
# at the word.

rt_dc_word_not = (op: DewyToken, left: int, power: int, pos: int) -> int:
    word = rt_dn_take()
    right = rt_dc_expr(power + 1)
    if right == 0: return 0
    base = DewyToken.kw_and
    if op == .kw_nor: base = .kw_or
    if op == .kw_xnor: base = .kw_xor
    inner = rt_dc_binary(base, left, right, pos)
    if inner == 0: return 0
    n = mk(.not_, mkpos(dc_parser.file, word.start))
    nodes[n].op = i32(int(Tok.plus))
    nodes[n].a = i32(inner)
    n

# `x ??<A | B> fallback` at `??`: the fallback only for the kinds listed, one type (c).

rt_dc_listed_coalesce = (left: int, power: int, pos: int) -> int:
    dc_parser.at += 1
    dc_parser.tokens[dc_parser.at].symbol = .langle
    dc_parser.at += 1
    dc_parser.reader.dc_type_args += 1
    kinds = rt_dc_annotation()
    dc_parser.reader.dc_type_args -= 1
    if kinds == 0: return 0
    if not rt_dn_accept(.rangle):
        # (`??<A B>`: dw_expr's mistake, should nothing else read it)
        if not (dc_parser.reader.dn_edits_on and rt_dn_closer_joined()): return rt_dc_hint(pos, "`??<...>` lists the kinds it covers as one type: `??<Missing | ParseError>`")
        rt_dn_split_closer()
    right = rt_dc_expr(power)
    if right == 0: return 0
    n = mk(.coalesce, pos)
    nodes[n].a = i32(left)
    nodes[n].b = i32(right)
    nodes[n].c = i32(kinds)
    n

# The type after `as`, `is?` or `transmute`; `bytes as string ?? ""` (cast): no type has a
# fallback, so this converts to an optional and falls back, as `(bytes as string | none) ?? ""`
# (the fallback is dc_expr's next operator).

rt_dc_cast_type = (cast: bool, power: int) -> int:
    type_at = dc_parser.at
    dc_parser.reader.dc_cast_coalesce = cast
    t = rt_dc_annotation(power)
    dc_parser.reader.dc_cast_coalesce = false
    if t == 0 or not cast or rt_dn_peek() != .coalesce: return t
    type_pos = mkpos(dc_parser.file, dc_parser.tokens[type_at].start)
    missing = mk(.tname, type_pos)
    nodes[missing].name = i32(rt_dc_none_type())
    optional = mk(.tunion, type_pos)
    set_list(optional, [t, missing])
    optional

# After `.`: `f.(xs)`, the call broadcast over its arguments (dw_expr's broadcast call), or
# `value.$field(name)`, a member named by a compile-time string (dw_field_name); 0 for another form.

rt_dc_dot_form = (left: int, after_call: bool, pos: int) -> int:
    member = dc_parser.tokens[dc_parser.at]
    if member.symbol == .lparen:
        dc_parser.at += 1
        n = mk(.call, pos)
        nodes[n].a = i32(left)
        add_flag(n, NF_BROADCAST)
        if nodes[left].kind == .field: add_flag(int(nodes[left].a), NF_MUT)
        if not rt_dc_arguments(n, .rparen): return 0
        return n
    if dc_parser.tokens[dc_parser.at + 1].symbol != .lparen or rt_dn_payload(member) != "field": return 0
    dc_parser.at += 2
    computed = rt_dc_expr(0)
    if computed == 0 or not rt_dn_accept(.rparen): return 0
    n = mk(.field, pos)
    nodes[n].a = i32(left)
    nodes[n].b = i32(computed)
    if after_call: add_flag(n, NF_JUXT)
    n

# `members(<'a' | 1>)` after its `(`: members(U) takes a type, grouped as in a type position, into
# the call n.

rt_dc_members_type = (n: int) -> bool:
    at = dc_parser.at
    t = rt_dc_type_primary()
    # (`members(<1 | 2>, 3)`: dw_comma_fail's mistake, should nothing else read it)
    if t != 0 and rt_dn_peek() == .comma: rt_dc_hint(mkpos(dc_parser.file, dc_parser.tokens[at].start), rt_dc_comma_text())
    if t == 0 or not rt_dn_accept(.rparen): return false
    set_list(n, [t])
    true

# The value a type application is written on is a name, or a field route from one.

rt_dc_named_base = (n: int) -> bool:
    base = n
    loop nodes[base].kind == .field: base = int(nodes[base].a)
    nodes[base].kind == .ident

# The open range at `..` (its first bound 0), as a membership reads it (dw_iterable's slice).

rt_dc_member_range = (pos: int) -> int:
    dc_parser.at += 1
    last = 0
    if dn_range_bound(dc_parser.tokens, dc_parser.at):
        last = rt_dc_expr(101)
        if last == 0: return 0
    n = mk(.range, pos)
    nodes[n].b = i32(last)
    if last != 0: add_flag(n, NF_INCLUSIVE)
    n

# A comparison chain's entries, read by the dc_expr reading it: each operand, where it starts, and
# the link before it (none before the first).

rt_dc_chain_push = (op: DewyToken, operand: int, at: int):
    dc_parser.reader.dc_chain_ops.push(op)
    dc_parser.reader.dc_chain_operands.push(operand)
    dc_parser.reader.dc_chain_starts.push(at)

# The chain goes on at token (a comparison, or one through `not` that dc_expr refuses).

rt_dc_chain_goes_on = (token: DewyLexeme, minimum: int) -> bool:
    op = token.symbol
    if token.kind == .eof: return false
    if op == .kw_not:
        op = dn_token_invert(dc_parser.tokens[dc_parser.at + 1].symbol)
        if op == .none: return false
    else if dc_parser.reader.dn_angles > 0 and op == .gt and not token.space: return false
    scalar = dn_token_uninvert(op)
    if dw_chain_way(scalar) == 2 and scalar != .not_eq: return false
    dn_power(op) >= minimum

# The chain from entry mark on, as dw_chain makes it: each operand evaluated once, in order (a
# temporary holds one that is not plain), later links only while it holds. 0: a chain that turns
# (is left unread (dc_unread)).

rt_dc_chain_build = (mark: int, pos: int) -> int:
    way = 0
    loop k in [mark + 1..dc_parser.reader.dc_chain_ops.len()):
        w = dw_chain_way(dc_parser.reader.dc_chain_ops[k])
        if w == 0: continue
        if way != 0 and w != way:
            # (dw_chain's mistake, noted)
            if not dc_parser.flags.report_now:
                rt_dc_chain_truncate(mark)
                return 0
            rt_dc_report(pos, "a comparison chain goes one way: rising (`a <? b <=? c`) or falling (`a >? b >=? c`), with `=?` in either; join other comparisons with `and`")
        way = w
    statements: int[]
    first = dc_parser.reader.dc_chain_operands[mark]
    if not rt_dc_chain_plain(mark): first = dw_chain_temp(first, statements, pos)
    chain = rt_dc_chain_from(mark + 1, first, pos)
    rt_dc_chain_truncate(mark)
    dc_parser.reader.dc_chains_made += 1
    if chain == 0 or statements.len() == 0: return chain
    statements.push(bc_stmt(chain, pos))
    bc_block(statements, pos)

rt_dc_chain_truncate = (mark: int):
    dc_parser.reader.dc_chain_ops.truncate(mark)
    dc_parser.reader.dc_chain_operands.truncate(mark)
    dc_parser.reader.dc_chain_starts.truncate(mark)

# The link at entry k, from the value left of it (dw_chain_from).

rt_dc_chain_from = (k: int, left: int, pos: int) -> int:
    comparison = mk(.binary, pos)
    nodes[comparison].op = i32(int(rt_dc_binary_token(dc_parser.reader.dc_chain_ops[k])))
    nodes[comparison].a = i32(left)
    right = dc_parser.reader.dc_chain_operands[k]
    nodes[comparison].b = i32(right)
    if k + 1 == dc_parser.reader.dc_chain_ops.len(): return comparison
    statements: int[]
    next = 0
    if rt_dc_chain_plain(k):
        # (read again: a plain operand is evaluated where each link reads it)
        saved = dc_parser.at
        dc_parser.at = dc_parser.reader.dc_chain_starts[k]
        next = rt_dc_expr(dn_power(dc_parser.reader.dc_chain_ops[k]) + 1)
        dc_parser.at = saved
        if next == 0: return 0
    else:
        value = dw_chain_temp(right, statements, pos)
        nodes[comparison].b = i32(value)
        next = bc_ident(name_of(int(nodes[value].name)), pos)
    both = mk(.and_, pos)
    nodes[both].a = i32(comparison)
    rest = rt_dc_chain_from(k + 1, next, pos)
    if rest == 0: return 0
    nodes[both].b = i32(rest)
    if statements.len() == 0: return both
    statements.push(bc_stmt(both, pos))
    bc_block(statements, pos)

# The operand at entry k is read twice without changing anything (dw_chain_plain): a name, a
# literal or a member of one, unparenthesized.

rt_dc_chain_plain = (k: int) -> bool:
    t = dc_parser.tokens[dc_parser.reader.dc_chain_starts[k]]
    if not (t.kind == .identifier or t.kind == .source_integer or t.kind == .integer or t.kind == .source_real or t.kind == .boolean): return false
    rt_dc_plain_operand(dc_parser.reader.dc_chain_operands[k])

rt_dc_plain_operand = (n: int) -> bool:
    k = nodes[n].kind
    if k == .ident or k == .none_lit or k == .bool_lit or k == .float_lit: return true
    if k == .int_lit: return nodes[n].aux2 == 0
    # (an exact integer literal)
    if k == .call: return nodes[n].aux2 == -1
    # (`b.day - e.day`: sums, differences and products of plain operands read the same twice,
    # and a comparison takes them exactly, where a temporary would store them)
    if k == .binary:
        op = nodes[n].op as Tok
        return (op == .plus or op == .minus or op == .star) and rt_dc_plain_operand(int(nodes[n].a)) and rt_dc_plain_operand(int(nodes[n].b))
    k == .field and rt_dc_plain_operand(int(nodes[n].a))

# An index's entries after its `[`, through its `]`: `xs[i]`, `m[i j]`, `Point[x=1 y=2]`, or one
# slice, `xs[a..b]`, `xs[a..b)`, `xs[a..]`, `xs[..b)`.

rt_dc_index = (n: int) -> bool:
    if dc_parser.tokens[dc_parser.at].kind == .metatag: return rt_dc_clamp(n)
    if rt_dc_new_inside(): return rt_dc_new_axes(n)
    # (`mean[loop r in rs r*2]`: one comprehension, dw_comprehension)
    if rt_dn_peek() == .kw_loop:
        made = rt_dc_comprehension()
        if made == 0: return false
        set_list(n, [made])
        nodes[n].b = i32(made)
        return true
    # (`sum[parallel x in xs x*x]`: one parallel comprehension, dw_parallel)
    if rt_dn_peek() == .kw_parallel:
        region = rt_dc_parallel(rt_dn_take(), true)
        if region == 0 or not rt_dn_accept(.rbrack): return false
        set_list(n, [region])
        nodes[n].b = i32(region)
        return true
    first_pos = mkpos(dc_parser.file, dc_parser.tokens[dc_parser.at].start)
    first = 0
    if rt_dn_peek() == .rbrack or rt_dc_named_next():
        if not rt_dc_axes(n, 0, 0): return false
        if nkids(n) == 1: nodes[n].b = i32(kid(n, 0))
        return true
    first_range = 0
    if rt_dc_whole_axis():
        # (`m[[..] 1]`: a whole axis, among several)
        first = mk(.range, mkpos(dc_parser.file, dc_parser.tokens[dc_parser.at + 1].start))
        first_range = first
        dc_parser.at += 3
    second = 0
    if first_range == 0 and rt_dn_peek() != .range:
        # (`xs[a,b..c]`: a stepped slice's two starts, dw_iterable's comma)
        saved_comma = dc_parser.flags.comma_stop
        dc_parser.flags.comma_stop = true
        dc_parser.reader.dc_range_top = true
        dc_parser.reader.dc_range_call = 0
        saved_axis = dc_parser.reader.dc_axis_depth
        dc_parser.reader.dc_axis_depth = dc_parser.depth + 1
        open_before = dc_parser.reader.dc_open_axes
        first = rt_dc_expr(0)
        dc_parser.reader.dc_axis_depth = saved_axis
        dc_parser.reader.dc_range_top = false
        if first != 0 and dc_parser.reader.dc_open_axes != open_before and dc_parser.reader.dc_range_call != first: first = 0
        if first != 0 and dc_parser.reader.dc_range_call == first: first_range = dc_parser.reader.dc_range_node
        if first != 0 and first_range == 0 and rt_dn_accept(.comma):
            dc_parser.reader.dc_range_top = true
            second = rt_dc_expr(0)
            dc_parser.reader.dc_range_top = false
            # (`xs[0,1,2..]`: dw_iterable's mistake, should nothing else read it)
            if second != 0 and rt_dn_peek() == .comma: rt_dc_hint(first_pos, "Dewy does not yet support a stepped range without exactly two starting values")
            if second == 0 or rt_dn_peek() != .range: first = 0
        dc_parser.flags.comma_stop = saved_comma
        if first == 0: return false
    if rt_dn_peek() == .range:
        dc_parser.at += 1
        # (`xs[..]`: the whole array)
        if first == 0 and rt_dn_peek() == .rbrack:
            range = mk(.range, mkpos(dc_parser.file, dc_parser.tokens[dc_parser.at - 1].start))
            dc_parser.at += 1
            set_list(n, [range])
            nodes[n].b = i32(range)
            return true
        if first == 0 and not dn_range_bound(dc_parser.tokens, dc_parser.at): return rt_dc_no_operand()
        last = 0
        if dn_range_bound(dc_parser.tokens, dc_parser.at):
            last = rt_dc_expr(101)
            if last == 0: return false
        inclusive = rt_dn_accept(.rbrack)
        if not inclusive and not rt_dn_accept(.rparen): return false
        range = mk(.range, first_pos)
        nodes[range].a = i32(first)
        nodes[range].b = i32(last)
        if second != 0:
            nodes[range].c = i32(second)
            add_flag(range, NF_STEP)
        if inclusive: add_flag(range, NF_INCLUSIVE)
        set_list(n, [range])
        nodes[n].b = i32(range)
        return true
    if not rt_dc_axes(n, first, first_range): return false
    if nkids(n) == 1: nodes[n].b = i32(kid(n, 0))
    true

# An index's entries, from dc_parser.at through its `]`, name `new` at their top.

rt_dc_new_inside = () -> bool:
    depth = 0
    k = dc_parser.at
    loop k < dc_parser.tokens.len():
        t = dc_parser.tokens[k]
        if t.kind == .eof: return false
        symbol = t.symbol
        if symbol == .lparen or symbol == .lbrack or symbol == .lbrace: depth += 1
        else if symbol == .rparen or symbol == .rbrack or symbol == .rbrace:
            if depth == 0: return false
            depth -= 1
        else if depth == 0 and t.kind == .identifier and int(t.name) == dc_parser.reader.dn_new_id: return true
        k += 1
    false

# `m[new ..]`, `m[.. new]`, `m[[..] end new]`: an index inserting axes, through its `]` (dw_expr's
# `new` entries, dw_new_range): each `new` the name `$new`, `..` beside one a whole axis; the
# other entries as dc_axes reads them. The node becomes a new_axis.

rt_dc_new_axes = (n: int) -> bool:
    args: int[]
    mark = dc_parser.reader.dc_axis_ranges.len()
    entries = 0
    loop not rt_dn_accept(.rbrack):
        token = dc_parser.tokens[dc_parser.at]
        if token.kind == .eof: return rt_dc_axes_end(mark, false)
        entries += 1
        nodes[n].aux2 = i32(args.len())
        pos = mkpos(dc_parser.file, token.start)
        new_first = token.kind == .identifier and int(token.name) == dc_parser.reader.dn_new_id
        if new_first or token.symbol == .range:
            # (`new`, `new ..`, `new .. new`, `.. new`, `..`)
            at = dc_parser.at
            if new_first: at += 1
            if dc_parser.tokens[at].symbol != .range:
                if not new_first: return rt_dc_axes_end(mark, false)
                dc_parser.at = at
                args.push(bc_ident("$new", pos))
                dc_parser.reader.dc_axis_ranges.push(0)
                continue
            last = dc_parser.tokens[at + 1]
            new_last = dn_range_bound(dc_parser.tokens, at + 1) and last.kind == .identifier and int(last.name) == dc_parser.reader.dn_new_id
            # (`xs[new..1]`: dw_new_range's mistake, noted; the bound read on)
            if new_first and not new_last and dn_range_bound(dc_parser.tokens, at + 1) and dc_parser.flags.report_now:
                rt_dc_report(pos, "`new` is an index entry, not a range endpoint: write `xs[new ..]` or `xs[.. new]`, and bracket a range next to it, as in `xs[new [1..end]]`")
                dc_parser.at = at + 1
                if rt_dc_expr(101) == 0: return rt_dc_axes_end(mark, false)
                args.push(bc_ident("$new", pos))
                args.push(mk(.range, pos))
                loop k in [0..args.len() - dc_parser.reader.dc_axis_ranges.len() + mark): dc_parser.reader.dc_axis_ranges.push(0)
                continue
            if dn_range_bound(dc_parser.tokens, at + 1) and not (new_last and (dc_parser.tokens[at + 2].symbol == .rbrack or dc_parser.tokens[at + 2].space)): return rt_dc_axes_end(mark, false)
            # (`..` alone among several entries: a whole axis, dw_iterable's slice)
            if not new_first and not new_last:
                dc_parser.at = at + 1
                whole = mk(.range, pos)
                args.push(whole)
                dc_parser.reader.dc_axis_ranges.push(whole)
                continue
            dc_parser.at = at + 1
            if new_first: args.push(bc_ident("$new", pos))
            args.push(mk(.range, pos))
            if new_last:
                dc_parser.at += 1
                args.push(bc_ident("$new", pos))
            loop k in [0..args.len() - dc_parser.reader.dc_axis_ranges.len() + mark): dc_parser.reader.dc_axis_ranges.push(0)
            continue
        if rt_dc_named_next(): return rt_dc_axes_end(mark, false)
        if rt_dc_whole_axis():
            whole = mk(.range, mkpos(dc_parser.file, dc_parser.tokens[dc_parser.at + 1].start))
            dc_parser.at += 3
            args.push(whole)
            dc_parser.reader.dc_axis_ranges.push(whole)
            continue
        dc_parser.reader.dc_range_call = 0
        dc_parser.reader.dc_range_top = true
        arg = rt_dc_expr(0)
        dc_parser.reader.dc_range_top = false
        if arg == 0: return rt_dc_axes_end(mark, false)
        slice = 0
        if dc_parser.reader.dc_range_call == arg: slice = dc_parser.reader.dc_range_node
        # (`m[1..end new]`: a range written without brackets, inclusive)
        if rt_dn_accept(.range):
            if slice != 0: return rt_dc_axes_end(mark, false)
            first_bound = arg
            last = 0
            if dn_range_bound(dc_parser.tokens, dc_parser.at):
                last = rt_dc_expr(101)
                if last == 0: return rt_dc_axes_end(mark, false)
            arg = mk(.range, pos)
            nodes[arg].a = i32(first_bound)
            nodes[arg].b = i32(last)
            add_flag(arg, NF_INCLUSIVE)
            slice = arg
        args.push(arg)
        dc_parser.reader.dc_axis_ranges.push(slice)
    # (several entries: a bracketed range among them is a slice, dw_iterable)
    if entries > 1:
        loop i in [0..args.len()):
            if dc_parser.reader.dc_axis_ranges[mark + i] != 0: args[i] = dc_parser.reader.dc_axis_ranges[mark + i]
    nodes[n].kind = .new_axis
    set_list(n, args)
    if args.len() == 1: nodes[n].b = i32(args[0])
    rt_dc_axes_end(mark, true)

# `xs[$clamp a..b)` after its `[`: the slice truncated to the receiver (dw_clamp_slice), into n.

rt_dc_clamp = (n: int) -> bool:
    tag_at = dc_parser.at
    tag = dc_parser.tokens[dc_parser.at]
    if tag.stop - tag.start != 6 or rt_dn_payload(tag) != "clamp": return rt_dc_index_tag_mistake(tag, false)
    dc_parser.at += 1
    pos = mkpos(dc_parser.file, dc_parser.tokens[dc_parser.at].start)
    first = 0
    if rt_dn_peek() != .range:
        saved_comma = dc_parser.flags.comma_stop
        dc_parser.flags.comma_stop = true
        dc_parser.reader.dc_range_top = true
        first = rt_dc_expr(0)
        dc_parser.reader.dc_range_top = false
        dc_parser.flags.comma_stop = saved_comma
        if first == 0: return false
        if rt_dn_peek() != .range:
            dc_parser.at -= 1
            loop dc_parser.tokens[dc_parser.at].kind != .metatag: dc_parser.at -= 1
            return rt_dc_index_tag_mistake(tag, true)
    dc_parser.at += 1
    last = 0
    if dn_range_bound(dc_parser.tokens, dc_parser.at):
        last = rt_dc_expr(101)
        if last == 0: return false
    inclusive = rt_dn_accept(.rbrack)
    if not inclusive and not rt_dn_accept(.rparen):
        # (`xs[$clamp 1..2 3]`: entries after the range)
        if dc_parser.tokens[dc_parser.at].kind == .eof: return false
        dc_parser.at = tag_at
        return rt_dc_index_tag_mistake(tag, true)
    r = mk(.range, pos)
    nodes[r].a = i32(first)
    nodes[r].b = i32(last)
    if inclusive: add_flag(r, NF_INCLUSIVE)
    block = dw_clamp_block(n, r)
    nodes[n] = nodes[block]
    true

# `xs[$wrap 1..2)`, `xs[$clamp 1]` at the tag (dw_clamp_slice's mistakes, noted; the entries
# passed over through the index's closer).

rt_dc_index_tag_mistake = (tag: DewyLexeme, clamp: bool) -> bool:
    if not dc_parser.flags.report_now or dc_parser.tokens[dc_parser.at].kind != .metatag: return false
    if clamp: rt_dc_report(mkpos(dc_parser.file, tag.start), "`$clamp` truncates one range: `xs[$clamp a..b)`")
    else: rt_dc_report(mkpos(dc_parser.file, tag.start), "`${rt_dn_payload(tag)}` is not an index setting: `$clamp` truncates a slice to the receiver, as in `xs[$clamp a..b)`")
    depth = 0
    dc_parser.at += 1
    loop dc_parser.tokens[dc_parser.at].kind != .eof:
        t = dc_parser.tokens[dc_parser.at].symbol
        dc_parser.at += 1
        if t == .lparen or t == .lbrack or t == .lbrace: depth += 1
        else if t == .rparen or t == .rbrack or t == .rbrace:
            if depth == 0: return true
            depth -= 1
    false

# A byte literal's string, as dw_byte_literal makes it: 0 where that reports a
# mistake (is left unread (dc_unread))

rt_dc_byte_literal = (token: DewyLexeme) -> int:
    if token.kind != .quoted: return 0
    source = files[dc_parser.file].src
    width = dn_quote_width(source, token.start, token.stop)
    stop = token.stop - width
    problem = LiteralProblem("", 0, false)
    text: u8[]
    pos = mkpos(dc_parser.file, token.start)
    if literal_string_text(problem, text, source, token.start + width, stop) < stop or len(problem.message) > 0:
        # (`b"x{n}"`: dw_byte_literal's mistake, noted; `b'\q'`, dn_string's, should nothing else read it)
        if len(problem.message) > 0: return rt_dc_hint(mkpos(dc_parser.file, problem.at), problem.message)
        if not dc_parser.flags.report_now: return 0
        rt_dc_report(pos, "a byte literal is not interpolated: write `\\\{` for a brace, or convert text, as in `bytes(\"...\")`")
        return bc_int(0, pos)
    single = source[token.start] == '\''
    if single and text.len() != 1:
        if not dc_parser.flags.report_now: return 0
        rt_dc_report(pos, "`b'...'` is one byte, and this holds {text.len()} (`b\"...\"` is an array of bytes)")
        return bc_int(0, pos)
    u8 = mk(.tname, pos)
    nodes[u8].name = i32(intern("u8"))
    n = mk(.cast, pos)
    if single:
        nodes[n].a = i32(bc_int(int(text[0]), pos))
        nodes[n].b = i32(u8)
        return n
    elements: int[]
    loop c in text: elements.push(bc_int(int(c), pos))
    values = mk(.array, pos)
    set_list(values, elements)
    t = mk(.tarray, pos)
    nodes[t].a = i32(u8)
    nodes[n].a = i32(values)
    nodes[n].b = i32(t)
    n

rt_dc_overloads = (n: int) -> bool:
    if nodes[n].kind == .lambda: return true
    nodes[n].kind == .binary and nodes[n].op == i32(int(Tok.amp)) and (rt_dc_overloads(int(nodes[n].a)) or rt_dc_overloads(int(nodes[n].b)))

# An elementwise operator's node (dw_broadcast): 0 for one is left unread (dc_unread).

rt_dc_broadcast = (op: DewyToken, a: int, b: int, pos: int) -> int:
    if op == .slash or op == .floor or op == .percent or op == .caret:
        k = if op == .slash: 0 else if op == .caret: 1 else if op == .floor: 2 else: 3
        callee = mk(.ident, pos)
        nodes[callee].name = i32(rt_dc_builtin(k))
        n = mk(.call, pos)
        nodes[n].a = i32(callee)
        set_list(n, [a, b])
        add_flag(n, NF_BROADCAST)
        return n
    spelling = dn_token_uninvert(op)
    if not (spelling == .plus or spelling == .minus or spelling == .star or spelling == .eq or spelling == .lt or spelling == .le or spelling == .gt or spelling == .ge): return 0
    n = mk(.binary, pos)
    nodes[n].op = i32(int(Tok.dotop))
    nodes[n].aux = i32(dn_token_text(spelling)[0])
    nodes[n].aux2 = if spelling == .le or spelling == .ge: 1 else: 0
    nodes[n].ival = int(spelling != op)
    nodes[n].a = i32(a)
    nodes[n].b = i32(b)
    n

# `count ?? 0 + 1` is `count ?? (0 + 1)`: a literal fallback followed by arithmetic usually meant
# the other tree (dw_coalesce_arithmetic's warning). The fallback's left spine of unparenthesized
# arithmetic down to the literal it starts with; its last right operand is quoted when it is a word.

rt_dc_coalesce_arithmetic = (left: int, left_at: int, right: int, right_at: int):
    leaf = dc_parser.tokens[right_at]
    if leaf.kind != .source_integer and leaf.kind != .integer and leaf.kind != .source_real: return
    first = right
    sym = ""
    rest = 0
    loop true:
        k = nodes[first].kind
        o = ""
        if k == .binary and not has_flag(first, NF_JUXT):
            t = Tok(int(nodes[first].op))
            if t == .plus: o = "+"
            else if t == .minus: o = "-"
            else if t == .star: o = "*"
            if o != "":
                sym = o
                rest = int(nodes[first].b)
                first = int(nodes[first].a)
                continue
        if k == .call and nodes[int(nodes[first].a)].kind == .ident and nkids(first) == 2:
            callee = int(nodes[int(nodes[first].a)].name)
            if callee == rt_dc_builtin(0): o = "/"
            else if callee == rt_dc_builtin(2): o = "//"
            else if callee == rt_dc_builtin(3): o = "%"
            if o != "":
                sym = o
                rest = kids(first)[1]
                first = kids(first)[0]
                continue
        break
    if sym == "" or (nodes[first].kind != .int_lit and nodes[first].kind != .float_lit) or pos_off(nodes[first].pos) != leaf.start: return
    name = rt_dc_operand_text(left, left_at)
    if name == "": name = "value"
    lit = rt_dn_payload(leaf)
    tail = "..."
    at = pos_off(nodes[rest].pos)
    rk = nodes[rest].kind
    if rk == .ident or rk == .int_lit or rk == .float_lit or rk == .bool_lit or rk == .none_lit:
        loop i in [right_at..dc_parser.at):
            t = dc_parser.tokens[i]
            if t.start == at:
                if dc_parser.tokens[i - 1].symbol != .lparen and (t.kind == .identifier or t.kind == .source_integer or t.kind == .integer or t.kind == .source_real): tail = rt_dn_payload(t)
                break
    warn(nodes[right].pos, "arithmetic binds more tightly than `??`, so this fallback includes `{lit} {sym} {tail}`, not just `{lit}`: write `({name} ?? {lit}) {sym} {tail}` to use the chosen value, or `{name} ?? ({lit} {sym} {tail})` to keep this meaning")

# `name=value` is next (a named argument or a record field).

rt_dc_named_next = () -> bool:
    token = dc_parser.tokens[dc_parser.at]
    token.kind == .identifier and (token.symbol == .none or token.symbol == .kw_test) and dc_parser.tokens[dc_parser.at + 1].symbol == .assign

# `$field(name)=value` is next: a row named by a compile-time string.

rt_dc_field_next = () -> bool:
    token = dc_parser.tokens[dc_parser.at]
    token.kind == .metatag and token.stop - token.start == 6 and dc_parser.tokens[dc_parser.at + 1].symbol == .lparen and not dc_parser.tokens[dc_parser.at + 1].space and rt_dn_payload(token) == "field"

# `$field(name)=value` (dc_field_next): the row (dw_record_entry), its name computed; 0 for a form
# is left unread (dc_unread).

rt_dc_field_entry = () -> int:
    pos = mkpos(dc_parser.file, dc_parser.tokens[dc_parser.at].start)
    dc_parser.at += 2
    computed = rt_dc_expr(0)
    if computed == 0 or not rt_dn_accept(.rparen) or not rt_dn_accept(.assign) or rt_dc_lambda_next(): return 0
    value = rt_dc_expr(11)
    if value == 0 or nodes[value].kind == .lambda: return 0
    entry = mk(.namedarg, pos)
    nodes[entry].b = i32(computed)
    nodes[entry].a = i32(value)
    entry

# Arguments up to the closing bracket, positional or `name=value`.

rt_dc_arguments = (n: int, close: DewyToken, first: int = 0) -> bool:
    args: int[]
    if first != 0: args.push(first)
    # (`f(xs...)`: a call's spread argument, dw_spread_item)
    saved_spread = dc_parser.reader.dc_spread_depth
    opener = dc_parser.at - 1
    loop not rt_dn_accept(close):
        token = dc_parser.tokens[dc_parser.at]
        if token.kind == .eof:
            dc_parser.reader.dc_spread_depth = saved_spread
            # (`f(1` and nothing after: dn_bracketed_from's mistake, should nothing else read it)
            rt_dc_hint(mkpos(dc_parser.file, dc_parser.tokens[opener].start), "expected '{dn_token_text(close)}' before end of file")
            return false
        if rt_dc_named_next():
            dc_parser.at += 2
            dc_parser.reader.dc_spread_depth = saved_spread
            value = rt_dc_expr(11)
            if value == 0: return false
            named = mk(.namedarg, mkpos(dc_parser.file, token.start))
            nodes[named].name = token.name
            nodes[named].a = i32(value)
            args.push(named)
            continue
        dc_parser.reader.dc_spread_depth = dc_parser.depth + 1
        start = dc_parser.at
        arg = rt_dc_expr(0)
        if arg == 0:
            dc_parser.reader.dc_spread_depth = saved_spread
            if not dc_parser.flags.report_now or not rt_dc_comma_arguments(start, close, args): return false
            set_list(n, args)
            return true
        args.push(arg)
    dc_parser.reader.dc_spread_depth = saved_spread
    set_list(n, args)
    true

rt_dc_comma_mistake = (pos: int): rt_dc_report(pos, rt_dc_comma_text())

# A `..` follows at `at`'s depth before its group closes: `[0,1,2..5]` is a range of too many starts.

rt_dc_range_follows = (at: int) -> bool:
    depth = 0
    k = at
    loop dc_parser.tokens[k].kind != .eof:
        t = dc_parser.tokens[k].symbol
        if depth == 0 and t == .range: return true
        if t == .lparen or t == .lbrack or t == .lbrace: depth += 1
        if t == .rparen or t == .rbrack or t == .rbrace:
            if depth == 0: return false
            depth -= 1
        k += 1
    false

rt_dc_comma_text = () -> str: "Dewy separates arguments, parameters and elements with spaces, not commas: `add(1 2)`, `(a:int64 b:int64) => ...`, `[1 2 3]` (a comma steps a range, as in `[0,2..10]`)"

# `f(1, 2)`: arguments separated by commas (dw_comma_fail's mistake, noted at the first argument a
# comma follows), read again from `start` through the closer.

rt_dc_comma_arguments = (start: int, close: DewyToken, args: mut int[]) -> bool:
    depth = 0
    k = start
    loop true:
        t = dc_parser.tokens[k]
        if t.kind == .eof: return false
        if depth == 0 and (t.symbol == close or t.symbol == .rparen or t.symbol == .rbrack or t.symbol == .rbrace): return false
        if depth == 0 and t.symbol == .comma: break
        if t.symbol == .lparen or t.symbol == .lbrack or t.symbol == .lbrace: depth += 1
        if t.symbol == .rparen or t.symbol == .rbrack or t.symbol == .rbrace: depth -= 1
        k += 1
    rt_dc_comma_mistake(mkpos(dc_parser.file, dc_parser.tokens[start].start))
    dc_parser.at = start
    saved = dc_parser.flags.comma_stop
    dc_parser.flags.comma_stop = true
    loop not rt_dn_accept(close):
        if rt_dn_accept(.comma): continue
        arg = 0
        if dc_parser.tokens[dc_parser.at].kind != .eof: arg = rt_dc_expr(0)
        if arg == 0:
            dc_parser.flags.comma_stop = saved
            return false
        args.push(arg)
    dc_parser.flags.comma_stop = saved
    true

# An index's entries through its `]`, after `first` (a range value first_range is the range of,
# or 0): each axis names its own `end` (aux2 while it is read); bracketed ranges among several
# axes are slices.

rt_dc_axes = (n: int, first: int, first_range: int) -> bool:
    args: int[]
    mark = dc_parser.reader.dc_axis_ranges.len()
    if first != 0:
        args.push(first)
        dc_parser.reader.dc_axis_ranges.push(first_range)
    loop not rt_dn_accept(.rbrack):
        token = dc_parser.tokens[dc_parser.at]
        if token.kind == .eof: return rt_dc_axes_end(mark, false)
        nodes[n].aux2 = i32(args.len())
        dc_parser.reader.dc_range_call = 0
        if rt_dc_named_next():
            dc_parser.at += 2
            value = rt_dc_expr(11)
            if value == 0: return rt_dc_axes_end(mark, false)
            named = mk(.namedarg, mkpos(dc_parser.file, token.start))
            nodes[named].name = token.name
            nodes[named].a = i32(value)
            args.push(named)
            dc_parser.reader.dc_axis_ranges.push(0)
            continue
        if rt_dc_whole_axis():
            whole = mk(.range, mkpos(dc_parser.file, dc_parser.tokens[dc_parser.at + 1].start))
            dc_parser.at += 3
            args.push(whole)
            dc_parser.reader.dc_axis_ranges.push(whole)
            continue
        saved_axis = dc_parser.reader.dc_axis_depth
        dc_parser.reader.dc_axis_depth = dc_parser.depth + 1
        open_before = dc_parser.reader.dc_open_axes
        arg = rt_dc_expr(0)
        dc_parser.reader.dc_axis_depth = saved_axis
        if arg == 0 or dc_parser.reader.dc_open_axes != open_before and dc_parser.reader.dc_range_call != arg: return rt_dc_axes_end(mark, false)
        args.push(arg)
        slice = 0
        if dc_parser.reader.dc_range_call == arg: slice = dc_parser.reader.dc_range_node
        dc_parser.reader.dc_axis_ranges.push(slice)
    # (a whole axis alone, `xs[[..]]`, is an array literal is left unread (dc_unread))
    if args.len() == 1 and nodes[args[0]].kind == .range and dc_parser.reader.dc_axis_ranges[mark] == args[0]: return rt_dc_axes_end(mark, false)
    if args.len() > 1:
        loop i in [0..args.len()):
            if dc_parser.reader.dc_axis_ranges[mark + i] != 0: args[i] = dc_parser.reader.dc_axis_ranges[mark + i]
    set_list(n, args)
    rt_dc_axes_end(mark, true)

rt_dc_whole_axis = () -> bool: rt_dn_peek() == .lbrack and dc_parser.tokens[dc_parser.at + 1].symbol == .range and dc_parser.tokens[dc_parser.at + 2].symbol == .rbrack

rt_dc_axes_end = (mark: int, read: bool) -> bool:
    dc_parser.reader.dc_axis_ranges.truncate(mark)
    read

# Named, generic and optional annotations have a known type context. Other
# type forms are left unread (dc_unread) without mutating angle tokens.

rt_dc_annotation = (boundary: int = 10) -> int:
    dc_parser.depth += 1
    if dc_parser.depth + dc_parser.reader.dn_depth > 256: return 0
    pos = mkpos(dc_parser.file, dc_parser.tokens[dc_parser.at].start)
    # `a|b|c` joins left to right; string members make one string set, the union's first
    # member (dw_literal_type).
    n = 0
    kind = dc_parser.tokens[dc_parser.at].kind
    literal = kind == .quoted or kind == .rawquoted or kind == .source_integer or kind == .integer or dc_parser.tokens[dc_parser.at].symbol == .minus and rt_dc_int_leaf(dc_parser.at) > 0
    if not literal:
        start = dc_parser.at
        n = rt_dc_type_primary()
        if n == 0:
            # (`('b' | 'a') | none`: the members of every group, one union, dw_literal_type)
            if not dc_parser.reader.dc_grouped_literal: return 0
            dc_parser.reader.dc_grouped_literal = false
            dc_parser.at = start
            literal = true
    if not literal:
        next = dc_parser.tokens[dc_parser.at].symbol
        if next == .star or next == .slash or next == .caret:
            n = rt_dc_type_term_from(n, pos)
            if n == 0: return 0
        loop rt_dn_peek() == .pipe and dn_power(.pipe) > boundary:
            if rt_dc_quoted_next(dc_parser.at + 1) or rt_dc_int_leaf(dc_parser.at + 1) > 0:
                literal = true
                break
            dc_parser.at += 1
            union_at = dc_parser.at
            right = rt_dc_type_term()
            if right == 0:
                if not dc_parser.reader.dc_grouped_literal: return 0
                dc_parser.reader.dc_grouped_literal = false
                dc_parser.at = union_at - 1
                literal = true
                break
            union = mk(.tunion, pos)
            set_list(union, [n, right])
            n = union
        # (`int64 & ~0`: the type refined to leave the value out, dw_type's `& ~`)
        if dc_parser.tokens[dc_parser.at].symbol == .amp and dc_parser.tokens[dc_parser.at + 1].symbol == .tilde and not literal and dn_power(.amp) > boundary and nodes[n].kind != .tunion:
            dc_parser.at += 2
            value = rt_dc_expr(dn_prefix_power(.tilde, false))
            if value == 0: return 0
            n = rt_dc_excluded(n, value, pos)
    if literal:
        n = rt_dc_literal_union(n, boundary, pos)
        if n == 0: return 0
    if dn_power(rt_dn_peek()) > boundary and not (dc_parser.reader.dc_effects_follow and rt_dn_peek() == .amp) and not (dc_parser.reader.dc_rename_follows and rt_dn_peek() == .kw_as) and not (dc_parser.reader.dc_type_args > 0 and rt_dc_closes()) and not rt_dc_annotation_ends(): return 0
    dc_parser.depth -= 1
    n


# What follows a type ends it though it is an operator: `7 as int8 -3`, a spaced sign before an
# unspaced operand starts the next operand; `t is? T,`, a comma ends an assertion's condition;
# `x as string ?? ""`, dc_expr's optional cast.

rt_dc_annotation_ends = () -> bool:
    after = dc_parser.tokens[dc_parser.at]
    after.symbol == .comma and dc_parser.flags.comma_stop or (after.symbol == .minus or after.symbol == .plus) and after.space and not dc_parser.tokens[dc_parser.at + 1].space or after.symbol == .coalesce and dc_parser.reader.dc_cast_coalesce

rt_dc_quoted_next = (at: int) -> bool: dc_parser.tokens[at].kind == .quoted or dc_parser.tokens[at].kind == .rawquoted

# The tokens of an integer literal at `at`, `5` (1) or `-1` (2), as a type's singleton is written
# (dw_int_leaf); 0 for anything else.

rt_dc_int_leaf = (at: int) -> int:
    t = dc_parser.tokens[at]
    if t.kind == .source_integer or t.kind == .integer: return 1
    if t.symbol != .minus: return 0
    next = dc_parser.tokens[at + 1]
    if next.kind == .source_integer or next.kind == .integer: return 2
    0

# A union with a literal member, from the members read so far (union, its leaves): the integers
# one refined int64, the strings one string set, then the other members in order (dw_literal_type,
# dw_pipe_leaves).

rt_dc_literal_union = (union: int, boundary: int, pos: int) -> int:
    texts: str[]
    ints: int[]
    others: int[]
    if union != 0: rt_dc_union_leaves(union, others)
    if union != 0: dc_parser.at += 1
    loop true:
        if rt_dc_type_member(texts, ints, others) < 0: return 0
        if not (rt_dn_peek() == .pipe and dn_power(.pipe) > boundary): break
        dc_parser.at += 1
    parts: int[]
    if ints.len() > 0:
        lo = ints[0]
        hi = ints[0]
        loop v in ints:
            lo = min(lo, v)
            hi = max(hi, v)
        # (too many gaps: dw_int_singleton_type's mistake, should nothing else read it)
        if hi - lo - ints.len() + 1 > 24 or hi - lo < 0: return rt_dc_hint(pos, "an integer singleton union with more than 24 missing values between its least and greatest members")
        parts.push(dw_int_singleton_type(ints, pos))
    if texts.len() > 0:
        strings = mk(.tname, pos)
        nodes[strings].aux = -7
        nodes[strings].ival = str_set_type(texts)
        parts.push(strings)
    loop other in others: parts.push(other)
    n = parts[0]
    loop k in [1..parts.len()):
        joined = mk(.tunion, pos)
        set_list(joined, [n, parts[k]])
        n = joined
    dc_parser.reader.dc_literal_seen = true
    n

rt_dc_union_leaves = (n: int, out: mut int[]):
    if nodes[n].kind == .tunion:
        rt_dc_union_leaves(kid(n, 0), out)
        rt_dc_union_leaves(kid(n, 1), out)
    else: out.push(n)

# A union's member: a type (its node, kept in others too), a plain string literal (its text in
# texts once) or an integer (its value in ints once): 0 for a literal. -1: none of these.

rt_dc_type_member = (texts: mut str[], ints: mut int[], others: mut int[]) -> int:
    token = dc_parser.tokens[dc_parser.at]
    # (`('b' | 'a')`: a group's members are the union's, dw_pipe_leaves)
    if token.symbol == .lparen:
        dc_parser.at += 1
        loop true:
            if rt_dc_type_member(texts, ints, others) < 0: return -1
            if rt_dn_peek() != .pipe: break
            dc_parser.at += 1
        if not rt_dn_accept(.rparen): return -1
        return 0
    if token.kind == .quoted or token.kind == .rawquoted:
        if token.kind == .quoted and not rt_dc_plain_quote(token): return -1
        literal = rt_dn_string(token)
        if literal == 0: return -1
        dc_parser.at += 1
        text = name_of(int(nodes[literal].sval))
        if not texts.contains(text): texts.push(text)
        return 0
    leaf = rt_dc_int_leaf(dc_parser.at)
    if leaf > 0:
        before = dc_parser.at
        value = rt_dc_atom()
        # (beyond int64: dw_int_singletons reports it)
        if value == 0 or dc_parser.at != before + leaf or nodes[value].kind != .int_lit or has_flag(value, NF_U64): return -1
        if not ints.contains(nodes[value].ival): ints.push(nodes[value].ival)
        return 0
    n = rt_dc_type_term()
    if n == 0: return -1
    others.push(n)
    n


# `float64 * Length / Time`, `Length^2`: a quantity type (dw_type's `*`, `/`, `^`).

rt_dc_type_term = () -> int:
    pos = mkpos(dc_parser.file, dc_parser.tokens[dc_parser.at].start)
    n = rt_dc_type_primary()
    next = rt_dn_peek()
    if n == 0 or next != .star and next != .slash and next != .caret: return n
    rt_dc_type_term_from(n, pos)

rt_dc_type_term_from = (first: int, pos: int) -> int:
    n = rt_dc_type_power(first, pos)
    loop n != 0 and (rt_dn_peek() == .star or rt_dn_peek() == .slash):
        op = if rt_dn_take().symbol == .star: Tok.star else: Tok.slash
        right = rt_dc_type_factor()
        if right == 0: return 0
        q = mk(.tquantity, pos)
        nodes[q].op = i32(int(op))
        nodes[q].a = i32(n)
        nodes[q].b = i32(right)
        n = q
    n

rt_dc_type_factor = () -> int:
    pos = mkpos(dc_parser.file, dc_parser.tokens[dc_parser.at].start)
    n = rt_dc_type_primary()
    if n == 0: return 0
    rt_dc_type_power(n, pos)

rt_dc_type_power = (n: int, pos: int) -> int:
    if rt_dn_peek() != .caret: return n
    dc_parser.at += 1
    exponent = rt_dc_expr(140)
    if exponent == 0: return 0
    q = mk(.tquantity, pos)
    nodes[q].op = i32(int(Tok.caret))
    nodes[q].a = i32(n)
    nodes[q].b = i32(exponent)
    q

# Type arguments being read (dc_type_named): a joined closer may end one, dn_closer_joined.

rt_dc_paren_function_type = (token: DewyLexeme) -> int:
    dc_parser.at += 1
    n = rt_dc_function_type(false)
    if n == 0 or not rt_dn_accept(.rparen): return 0
    rt_dc_report(mkpos(dc_parser.file, token.start), "function types use angle brackets: replace the outer (...) with <...>, as in `<(x:int64):>int64>`")
    n

rt_dc_closes = () -> bool: rt_dn_peek() == .rangle or dc_parser.reader.dn_edits_on and rt_dn_closer_joined()

rt_dc_effect_atom_at = (at: int) -> bool:
    token = dc_parser.tokens[at]
    if token.symbol != .none: return false
    word = rt_dc_word(int(token.name))
    if word == DC_NO_EFFECTS or word == DC_ALLOCATES or word == DC_BLOCKS or word == DC_PANICS: return true
    if word == DC_READS or word == DC_MUTATES: return dc_parser.tokens[at + 1].symbol == .langle and not dc_parser.tokens[at + 1].space
    if int(token.name) != dc_parser.reader.dn_no_id: return false
    next = dc_parser.tokens[at + 1]
    following = if next.kind == .identifier and next.symbol == .none: rt_dc_word(int(next.name)) else: 0
    following == DC_READS or following == DC_MUTATES or following == DC_ALLOCATES or following == DC_BLOCKS or following == DC_PANICS

# Such an atom: a type naming its row (aux -8, sval the row).

rt_dc_effect_type = (token: DewyLexeme) -> int:
    entries: EffectSyntax[]
    if not rt_dc_effect_entries(entries, true): return 0
    effect_syntax.push(entries)
    n = mk(.tname, mkpos(dc_parser.file, token.start))
    nodes[n].aux = -8
    nodes[n].sval = i32(effect_syntax.len() - 1)
    effects_active = true
    n

# A named type with optional type arguments, a grouped type `(A | B)`, a record type
# `[x:T y:U]` or `[T U]`, or a function type `<(x:T):>R>`; then `?` suffixes.

rt_dc_type_primary = () -> int:
    token = dc_parser.tokens[dc_parser.at]
    n = 0
    if token.kind == .identifier and rt_dc_effect_atom_at(dc_parser.at): return rt_dc_effect_type(token)
    if token.kind == .identifier: n = rt_dc_type_named()
    else if token.symbol == .lparen and dc_parser.reader.dc_type_args > 0 and dc_parser.tokens[rt_dc_closing(dc_parser.at) + 1].symbol == .returns:
        # `array<():>int64>`: a type argument may be a function type without its own angle brackets
        n = rt_dc_function_type(false)
    else if token.symbol == .lparen and dc_parser.tokens[dc_parser.at + 1].symbol == .lparen and dc_parser.tokens[rt_dc_closing(dc_parser.at + 1) + 1].symbol == .returns and dc_parser.flags.report_now:
        n = rt_dc_paren_function_type(token)
        if n == 0: return 0
    else if token.symbol == .lparen:
        # (dw_type of its one element; a joined closer cannot end a type in it)
        dc_parser.at += 1
        saved = dc_parser.reader.dc_type_args
        dc_parser.reader.dc_type_args = 0
        saved_literal = dc_parser.reader.dc_literal_seen
        dc_parser.reader.dc_literal_seen = false
        n = rt_dc_annotation()
        if n != 0 and not rt_dn_accept(.rparen): n = rt_dc_type_group(n, mkpos(dc_parser.file, token.start))
        dc_parser.reader.dc_type_args = saved
        literal = dc_parser.reader.dc_literal_seen
        dc_parser.reader.dc_literal_seen = saved_literal
        # (a group holding a literal flattens into the union around it: dc_annotation reads
        # it again as one, dw_pipe_leaves)
        dc_parser.reader.dc_grouped_literal = literal
        if n == 0 or literal: return 0
        dc_parser.reader.dc_grouped = n
    else if token.symbol == .lbrack or token.symbol == .langle and dc_parser.tokens[dc_parser.at + 1].symbol == .lparen:
        # (inside, a joined closer ends no type argument)
        saved = dc_parser.reader.dc_type_args
        dc_parser.reader.dc_type_args = 0
        n = if token.symbol == .lbrack: rt_dc_record_type() else: rt_dc_function_type()
        dc_parser.reader.dc_type_args = saved
    else if token.symbol == .langle:
        # `<int64 | string>`, `<'fast' | 1>`: a type in angle brackets is that type (dw_type's `<>`)
        dc_parser.at += 1
        dc_parser.reader.dc_type_args += 1
        n = rt_dc_annotation()
        dc_parser.reader.dc_type_args -= 1
        if n == 0: return 0
        if not rt_dn_accept(.rangle):
            if not (dc_parser.reader.dn_edits_on and rt_dn_closer_joined()): return 0
            rt_dn_split_closer()
    if n == 0: return 0
    loop rt_dn_accept(.question):
        optional = mk(.topt, mkpos(dc_parser.file, token.start))
        nodes[optional].a = i32(n)
        n = optional
    # (`x as float32 (y)`: a spaced group is the next operand's; among type arguments, a spaced
    # `<` opens the next, `dict<string <(x:int64):>int64>>`)
    next = dc_parser.tokens[dc_parser.at].symbol
    # (in a sequence pattern a spaced `<` opens the next part, `(a:int64 <string>)`)
    if next == .dot or next == .langle and (dc_parser.reader.dc_type_args == 0 and not (dc_parser.reader.dc_sequence_part and dc_parser.tokens[dc_parser.at].space) or not dc_parser.tokens[dc_parser.at].space) or (next == .lbrack or next == .lparen) and not dc_parser.tokens[dc_parser.at].space: return 0
    n

# `(int64 int64)` after its first type: several values' types through `)` (dw_type's group of two
# or more).

rt_dc_type_group = (first: int, pos: int) -> int:
    members = [first]
    loop not rt_dn_accept(.rparen):
        if dc_parser.tokens[dc_parser.at].kind == .eof: return 0
        member = rt_dc_annotation()
        if member == 0: return 0
        members.push(member)
    n = mk(.ttuple, pos)
    nodes[n].aux = i32(TUPLE_VALUES)
    set_list(n, members)
    n

# `[x:T y:U]`, a record type; `[T U]`, a tuple type (dw_type's `[]:`).

rt_dc_record_type = () -> int:
    pos = mkpos(dc_parser.file, dc_parser.tokens[dc_parser.at].start)
    dc_parser.at += 1
    named = dc_parser.tokens[dc_parser.at].kind == .identifier and dc_parser.tokens[dc_parser.at + 1].symbol == .colon or rt_dn_peek() == .rbrack or rt_dn_peek() == .at and dc_parser.tokens[dc_parser.at + 1].kind == .identifier and dc_parser.tokens[dc_parser.at + 2].symbol == .colon and dc_parser.flags.report_now
    n = mk(if named: NK.trecord else: NK.ttuple, pos)
    items: int[]
    loop not rt_dn_accept(.rbrack):
        if dc_parser.tokens[dc_parser.at].kind == .eof: return 0
        if named:
            # (`[@x:int64]`: dw_type's mistake, noted)
            if rt_dn_peek() == .at:
                if not dc_parser.flags.report_now: return 0
                rt_dc_unsupported(mkpos(dc_parser.file, dc_parser.tokens[dc_parser.at].start), "a mutable inline record field; mutability belongs on the parameter")
                dc_parser.at += 1
            field = dc_parser.tokens[dc_parser.at]
            if field.kind != .identifier or (field.symbol != .none and field.symbol != .kw_test) or rt_dn_reserved(int(field.name)) or dc_parser.tokens[dc_parser.at + 1].symbol != .colon: return 0
            dc_parser.at += 2
            f = mk(.vardecl, mkpos(dc_parser.file, field.start))
            nodes[f].name = field.name
            outer = dc_parser.reader.dc_pattern_binder
            dc_parser.reader.dc_pattern_binder = int(field.name)
            t = rt_dc_annotation()
            dc_parser.reader.dc_pattern_binder = outer
            if t == 0: return 0
            # (`[x:int64=42]`: dw_type's mistake, noted; the value read)
            if rt_dn_peek() == .assign and (not dc_parser.flags.report_now or rt_dc_inline_default(field) == 0): return 0
            nodes[f].a = i32(t)
            items.push(f)
            continue
        if dc_parser.tokens[dc_parser.at + 1].symbol == .colon: return 0
        t = rt_dc_annotation()
        if t == 0: return 0
        items.push(t)
    set_list(n, items)
    n

rt_dc_type_default = (label: DewyLexeme) -> int:
    rt_dc_unsupported(mkpos(dc_parser.file, label.start), "defaults in a function type; declare defaults on a directly called function")
    dc_parser.at += 1
    rt_dc_expr(11)

rt_dc_inline_default = (field: DewyLexeme) -> int:
    rt_dc_unsupported(mkpos(dc_parser.file, field.start), "an inline record field without a type; use a named record for defaults")
    dc_parser.at += 1
    rt_dc_expr(11)

# `<(x:T @y:U):>R>`: a function type, its parameters' labels and types (dw_type's `:>`); an effect
# row on it is left unread (dc_unread).

rt_dc_function_type = (angled: bool = true) -> int:
    dc_parser.at += if angled: 2 else: 1
    pos = mkpos(dc_parser.file, dc_parser.tokens[dc_parser.at - 1].start)
    n = mk(.tfn, pos)
    types_: int[]
    labels: int[]
    loop not rt_dn_accept(.rparen):
        first = dc_parser.tokens[dc_parser.at]
        place = rt_dn_accept(.at)
        label = dc_parser.tokens[dc_parser.at]
        if label.kind != .identifier or (label.symbol != .none and label.symbol != .kw_test) or rt_dn_reserved(int(label.name)) or dc_parser.tokens[dc_parser.at + 1].symbol != .colon: return 0
        dc_parser.at += 2
        t = rt_dc_annotation()
        if t == 0: return 0
        # (dw_type's mistakes, noted: a default, a label written twice)
        if rt_dn_peek() == .assign and (not dc_parser.flags.report_now or rt_dc_type_default(label) == 0): return 0
        if place: add_flag(t, NF_MUT)
        if rt_dc_word(int(label.name)) != DC_HOLE:
            loop earlier in labels:
                if nodes[earlier].name == label.name:
                    if not dc_parser.flags.report_now: return 0
                    rt_dc_report(mkpos(dc_parser.file, label.start), "duplicate callable parameter name '{rt_dn_payload(label)}'")
        named = mk(.ident, mkpos(dc_parser.file, first.start))
        nodes[named].name = label.name
        labels.push(named)
        types_.push(t)
    if not rt_dn_accept(.returns): return 0
    if dc_parser.tokens[dc_parser.at].kind == .identifier and int(dc_parser.tokens[dc_parser.at].name) == dc_parser.reader.dn_void_id and dc_parser.tokens[dc_parser.at + 1].symbol != .pipe: dc_parser.at += 1
    else:
        # (its closer may be joined: `dict<string <(x:int64):>int64>>`; without angles, the
        # enclosing type argument's, `array<():>int64>`)
        saved_args = dc_parser.reader.dc_type_args
        saved_follow = dc_parser.reader.dc_effects_follow
        if angled: dc_parser.reader.dc_type_args = 1
        dc_parser.reader.dc_grouped = 0
        dc_parser.reader.dc_effects_follow = true
        result = rt_dc_annotation()
        dc_parser.reader.dc_effects_follow = saved_follow
        dc_parser.reader.dc_type_args = if angled: 0 else: saved_args
        if result == 0 or nodes[result].kind == .tunion and result != dc_parser.reader.dc_grouped and rt_dn_peek() == .amp: return 0
        packed = rt_dc_pack(result)
        if packed == result and nodes[packed].kind == .tarray and nodes[packed].ival < 0 and rt_dn_peek() == .amp: return 0
        nodes[n].a = i32(packed)
    # (`<(x:int64):>int64 & E>`: its effect row, dw_effect_suffix)
    if rt_dn_peek() == .amp and not rt_dc_effect_row(n): return 0
    if not angled:
        set_list(n, types_)
        set_list2(n, labels)
        return n
    if not rt_dn_accept(.rangle):
        if not (dc_parser.reader.dn_edits_on and rt_dn_closer_joined()): return 0
        rt_dn_split_closer()
    set_list(n, types_)
    set_list2(n, labels)
    n

# `:>(int64 int64)`: several result values, an array type marked with ival -(their number), its
# list each value's type (dw_pack_type): from the group of types dc_type_primary read last.

rt_dc_pack = (result: int) -> int:
    if result != dc_parser.reader.dc_grouped or nodes[result].kind != .ttuple or nodes[result].aux != i32(TUPLE_VALUES): return result
    members = kids(result)
    nodes[result].kind = .tarray
    nodes[result].aux = 0
    nodes[result].a = i32(members[0])
    nodes[result].ival = -members.len()
    result

# Names the direct grammar dispatches on, by ID: a type name's compact
# spelling (dw_type_name), cached per name; 0 not yet looked up, -1 a name
# with its own type grammar (effects, `type`, `uint`).

rt_dc_word = (id: int) -> int: dc_parser_word(dc_parser, names, id)

rt_dc_type_spelled = (id: int) -> int:
    if id < dc_parser.reader.dc_type_spelling.len() and dc_parser.reader.dc_type_spelling[id] != 0: return int(dc_parser.reader.dc_type_spelling[id])
    rt_dc_type_spelling_of(id)

rt_dc_type_spelling_of = (id: int) -> int:
    if dc_parser.reader.dc_type_spelling.len() < names.len(): dc_parser.reader.dc_type_spelling.resize(names.len() + 64)
    name = name_of(id)
    spelled = -1
    if not (name in ["type", "uint", "no_effects", "allocates", "blocks", "panics", "reads", "mutates", "no"]):
        mapped = dw_type_name(name)
        spelled = if mapped == name: id else: intern(mapped)
    if id < dc_parser.reader.dc_type_spelling.len(): dc_parser.reader.dc_type_spelling[id] = i32(spelled)
    spelled

rt_dc_unspelled = (token: DewyLexeme) -> int:
    if rt_dn_payload(token) == "uint": rt_dc_hint(mkpos(dc_parser.file, token.start), "unbounded `uint` is unsupported; choose a fixed width such as `uint64`")
    0

rt_dc_type_named = () -> int:
    token = dc_parser.tokens[dc_parser.at]
    if token.kind != .identifier or (token.symbol != .none and token.symbol != .kw_test) or token.name == 0: return 0
    id = int(token.name)
    # `net.NetError`: a module's type (dw_type's `.`)
    if dc_parser.tokens[dc_parser.at + 1].symbol == .dot and dc_parser.tokens[dc_parser.at + 2].kind == .identifier and dc_parser.tokens[dc_parser.at + 2].symbol == .none: return rt_dc_module_type(token)
    spelled = rt_dc_type_spelled(id)
    if spelled < 0: return rt_dc_unspelled(token)
    word = rt_dc_word(id)
    if word == DC_ADDR: refine_active = true
    # Parameter refinements use the existing annotation parser. Keeping the
    # declaration direct lets its body remain lazy instead of expanding it.
    # (an overflow policy alone, `uint32<overflow='wrap'>`, is no refinement)
    if dc_parser.reader.dc_parameter_type and word == 0 and not dc_parser.tokens[dc_parser.at + 1].space and dc_parser.tokens[dc_parser.at + 1].symbol == .langle and not rt_dc_policy_only() and rt_dc_integer_name(id): return rt_dc_refined_parameter()
    dc_parser.at += 1
    n = mk(.tname, mkpos(dc_parser.file, token.start))
    nodes[n].name = i32(spelled)
    if dc_parser.tokens[dc_parser.at].space: return n
    if dc_parser.tokens[dc_parser.at].symbol == .langle:
        n = rt_dc_type_arguments(n, word)
        # (`array<int64><0 <? length>`: a condition on the array type, dw_type's refined application)
        if n != 0 and word == DC_ARRAY and rt_dn_peek() == .langle and not dc_parser.tokens[dc_parser.at].space: n = rt_dc_type_arguments(n, 0)
        return n
    if rt_dc_double_angle(): return rt_dc_type_arguments(n, word, true)
    n

# `net.NetError` at the module's name: a module's type (dw_type's `.`).

rt_dc_module_type = (token: DewyLexeme) -> int:
    member = dc_parser.tokens[dc_parser.at + 2]
    dc_parser.at += 3
    n = mk(.tname, mkpos(dc_parser.file, token.start))
    nodes[n].sval = i32(intern(rt_dn_payload(token)))
    nodes[n].name = i32(intern(rt_dn_payload(member)))
    rt_dc_type_arguments(n, 0)

rt_dc_integer_name = (id: int) -> bool: name_of(id) in ["int8", "int16", "int32", "int64", "uint8", "uint16", "uint32", "uint64"]

# A parameter's refined integer type, `int64<(>? 0)>`.

rt_dc_refined_parameter = () -> int:
    start = dc_parser.at
    dc_parser.reader.dc_parameter_type = false
    direct = rt_dc_type_named()
    dc_parser.reader.dc_parameter_type = true
    if direct == 0: rt_dc_unread(start)
    direct

# `array<<(x:int64):>int64>>`: an adjacent `<<` opens two angle brackets; its first `<` is split
# off in place (dn_double_angle), the other left for the type argument.

rt_dc_double_angle = () -> bool:
    if dc_parser.tokens[dc_parser.at].symbol != .shl or dc_parser.tokens[dc_parser.at].space or not dn_double_closes(dc_parser.tokens, dc_parser.at): return false
    rt_dn_token_edit(dc_parser.at)
    dc_parser.tokens[dc_parser.at].start += 1
    dc_parser.tokens[dc_parser.at].symbol = .langle
    true

# A named type's arguments, `<...>`, if any (dw_type's type application): n holds the name.

rt_dc_type_arguments = (n0: int, word: int, opened: bool = false) -> int:
    n = n0
    pos = nodes[n].pos
    if opened or not dc_parser.tokens[dc_parser.at].space and rt_dn_accept(.langle):
        args: int[]
        length = 0
        constraint = 0
        shape = dc_parser.reader.dc_shapes.len()     # (its dimensions, from here on dc_shapes)
        loop true:
            # (`array<array<T>>`, `array<T>?`, `xs:array<T>=[]`: dn_bracketed_from's split)
            if dc_parser.reader.dn_edits_on and rt_dn_closer_joined():
                rt_dn_split_closer()
                break
            if rt_dn_accept(.rangle): break
            # `array<T length=n>`, `T<overflow='wrap'>` (dw_type's type application)
            if rt_dc_named_next():
                setting = rt_dc_word(int(dc_parser.tokens[dc_parser.at].name))
                dc_parser.at += 2
                # `array<T length=[m n]>`: a shape (dw_shape_type)
                if setting == DC_LENGTH and word == DC_ARRAY and args.len() == 1 and length == 0 and dc_parser.reader.dc_shapes.len() == shape and rt_dn_peek() == .lbrack:
                    dc_parser.at += 1
                    saved_comma = dc_parser.flags.comma_stop
                    dc_parser.flags.comma_stop = false
                    dc_parser.reader.dn_angles += 1
                    read = true
                    loop read and not rt_dn_accept(.rbrack):
                        dim = 0
                        if rt_dn_peek() != .semi and dc_parser.tokens[dc_parser.at].kind != .eof: dim = rt_dc_expr(0)
                        if dim == 0: read = false
                        else: dc_parser.reader.dc_shapes.push(dim)
                    dc_parser.reader.dn_angles -= 1
                    dc_parser.flags.comma_stop = saved_comma
                    if not read or dc_parser.reader.dc_shapes.len() == shape or not rt_dc_closes():
                        dc_parser.reader.dc_shapes.truncate(shape)
                        return 0
                    continue
                if setting == DC_LENGTH and word == DC_ARRAY and args.len() == 1 and length == 0 and rt_dn_peek() != .lbrack:
                    saved_comma = dc_parser.flags.comma_stop
                    dc_parser.flags.comma_stop = false
                    dc_parser.reader.dn_angles += 1
                    length = rt_dc_expr(dn_power(.assign) + 1)
                    dc_parser.reader.dn_angles -= 1
                    dc_parser.flags.comma_stop = saved_comma
                    if length == 0: return 0
                    # (`array<int64 length=2 length=3>`: dw_type's mistake, should nothing else read it)
                    if not rt_dc_closes() and dn_can_start(dc_parser.tokens, dc_parser.at):
                        again = dc_parser.tokens[dc_parser.at]
                        if again.kind == .identifier and again.symbol == .none and rt_dc_word(int(again.name)) == DC_LENGTH and dc_parser.tokens[dc_parser.at + 1].symbol == .assign:
                            once = files[dc_parser.file].src[pos_off(pos)..dc_parser.tokens[dc_parser.at - 1].stop)
                            return rt_dc_hint(pos, "array length may be specified once: use `{once}>`")
                        return rt_dc_hint(pos, "Dewy does not yet support array type constraints; use array<T> or array<T length=N>")
                    if not rt_dc_closes(): return 0
                    continue
                # (`array<int64 length=2 length=3>`: dw_type's mistake, should nothing else read it)
                if word == DC_ARRAY and args.len() == 1 and (length != 0 or constraint != 0 or dc_parser.reader.dc_shapes.len() > shape): return rt_dc_hint(pos, "Dewy does not yet support array type constraints; use array<T> or array<T length=N>")
                # (`array<int64 capacity=2>`: dw_type's mistake, noted; the value read)
                if word == DC_ARRAY and setting != DC_OVERFLOW and dc_parser.flags.report_now and rt_dc_array_constraint() != 0: continue
                if setting != DC_OVERFLOW or (word >= DC_ARRAY and word <= DC_TOTALDICT): return 0
                policy = rt_dc_policy(dc_parser.tokens[dc_parser.at])
                # (`uint8<overflow='wrapping'>`, a second policy: dw_type's mistakes, should nothing
                # else read the type)
                if policy == 0 or nodes[n].aux == -9: return rt_dc_policy_mistake(policy)
                dc_parser.at += 1
                if not rt_dc_closes():
                    # (a second policy: dw_type's mistakes, should nothing else read the type)
                    if rt_dc_named_next() and rt_dc_word(int(dc_parser.tokens[dc_parser.at].name)) == DC_OVERFLOW:
                        dc_parser.at += 2
                        rt_dc_policy_mistake(rt_dc_policy(dc_parser.tokens[dc_parser.at]))
                    return 0
                wrapper = mk(.tname, pos)
                nodes[wrapper].aux = -9
                nodes[wrapper].a = i32(n)
                nodes[wrapper].ival = policy
                n = wrapper
                continue
            # `array<T length >? 0>`: a condition on the array (dw_type's array constraint)
            if word == DC_ARRAY and args.len() == 1 and length == 0 and dc_parser.reader.dc_shapes.len() == shape:
                dc_parser.reader.dn_angles += 1
                predicate = rt_dc_ref_predicate_read(0)
                dc_parser.reader.dn_angles -= 1
                if predicate == 0 or rt_dc_membership(predicate) or not rt_dc_closes(): return 0
                tested = predicate
                if nodes[tested].kind == .not_: tested = int(nodes[tested].a)
                if not (nodes[predicate].kind == .and_ or nodes[tested].kind == .binary and (rt_dc_comparison(Tok(int(nodes[tested].op))) or nodes[tested].op == i32(int(Tok.kw_in)))): return 0
                constraint = predicate
                continue
            # `int64<(>? 0)>`, `addr<(<? xs.length)>`, `int64<i => 0 <=? i>`: a refinement
            if (word == 0 or word == DC_ADDR) and rt_dc_refinement_next():
                refined = rt_dc_refinement(n)
                if refined == 0: return 0
                n = refined
                continue
            arg_start = dc_parser.at
            arg_nodes = nodes.len()
            arg_lists = lists.len()
            arg_edits = dc_parser.reader.dn_edit_at.len()
            dc_parser.reader.dc_type_args += 1
            child = rt_dc_annotation()
            dc_parser.reader.dc_type_args -= 1
            if child == 0 and (word == 0 or word == DC_ADDR) and args.len() == 0:
                # `int64<0 <=? x and x <=? 255>`: a condition on the value (its binder the field's,
                # the declaration's or the arm's, dw_pattern_binder)
                dc_parser.at = arg_start
                nodes.truncate(arg_nodes)
                lists.truncate(arg_lists)
                rt_dn_edits_undo(arg_edits)
                refined = rt_dc_condition(n)
                if refined == 0: return 0
                n = refined
                continue
            if child == 0: return 0
            args.push(child)
        if dc_parser.reader.dc_shapes.len() > shape:
            dims = dc_parser.reader.dc_shapes[shape..dc_parser.reader.dc_shapes.len())
            dc_parser.reader.dc_shapes.truncate(shape)
            nodes[n].kind = .tarray
            nodes[n].name = 0
            nodes[n].a = i32(args[0])
            nodes[n].aux = i32(dims.len())
            nodes[n].ival = 1
            set_list(n, dims)
        else if length != 0:
            nodes[n].kind = .tarray
            nodes[n].name = 0
            nodes[n].a = i32(args[0])
            nodes[n].b = i32(length)
        else if word == DC_ARRAY:
            if args.len() != 1: return 0
            nodes[n].kind = .tarray
            nodes[n].name = 0
            nodes[n].a = i32(args[0])
            if constraint != 0:
                refine_active = true
                qualified = mk(.trefined, pos)
                nodes[qualified].a = i32(n)
                nodes[qualified].b = i32(rt_dc_ref_predicate(constraint))
                return qualified
        else if word == DC_PTR:
            if args.len() != 1: return 0
            nodes[n].kind = .tptr
            nodes[n].name = 0
            nodes[n].a = i32(args[0])
        else if word == DC_DICT or word == DC_TOTALDICT:
            if args.len() != 2: return 0
            nodes[n].kind = .tmap
            nodes[n].name = 0
            nodes[n].a = i32(args[0])
            nodes[n].b = i32(args[1])
            if word == DC_TOTALDICT:
                refine_active = true
                nodes[n].aux = 1
        else if args.len() > 0:
            # (type arguments on a refinement: dw_type reports them)
            if nodes[n].kind != .tname or nkids(n) != 0: return 0
            set_list(n, args)
    n

rt_dc_array_constraint = () -> int:
    rt_dc_unsupported(mkpos(dc_parser.file, dc_parser.tokens[dc_parser.at - 2].start), "array type constraints; use length=N or a length comparison")
    dc_parser.reader.dn_angles += 1
    value = rt_dc_expr(dn_power(.assign) + 1)
    dc_parser.reader.dn_angles -= 1
    value

# A refinement is next among a type's arguments: a partial comparison, `(>? 0)`, or one value's
# predicate, `i => ...`; `(in? a..b)` a contiguous range's.

rt_dc_refinement_next = () -> bool:
    t = dc_parser.tokens[dc_parser.at]
    if t.kind == .identifier and t.symbol == .none: return dc_parser.tokens[dc_parser.at + 1].symbol == .function
    if t.symbol != .lparen: return false
    op = dc_parser.tokens[dc_parser.at + 1].symbol
    if op == .kw_not: op = dn_token_invert(dc_parser.tokens[dc_parser.at + 2].symbol)
    op == .eq or op == .not_eq or op == .lt or op == .not_lt or op == .gt or op == .not_gt or op == .le or op == .not_le or op == .ge or op == .not_ge or op == .contains or op == .not_contains

rt_dc_refinement = (base: int) -> int:
    first = dc_parser.tokens[dc_parser.at]
    pos = mkpos(dc_parser.file, first.start)
    binder = 0
    predicate = 0
    if first.symbol == .lparen:
        # (dn_partial: the group's operand is `$partial`, standing in place of its parenthesis)
        if dc_parser.reader.dc_partial_id == 0: dc_parser.reader.dc_partial_id = intern("$partial")
        slot = dc_parser.at
        dc_parser.tokens[dc_parser.at] = DewyLexeme(.identifier, i32(dc_parser.reader.dc_partial_id), first.start, first.stop, first.space, first.newline)
        saved_angles = dc_parser.reader.dn_angles
        dc_parser.reader.dn_angles = 0
        predicate = rt_dc_ref_predicate_read(0)
        dc_parser.reader.dn_angles = saved_angles
        dc_parser.tokens[slot] = first
        if predicate == 0 or not rt_dn_accept(.rparen): return 0
        binder = dc_parser.reader.dc_partial_id
    else:
        binder = int(first.name)
        dc_parser.at += 2
        dc_parser.reader.dn_angles += 1
        predicate = rt_dc_ref_predicate_read(30)
        dc_parser.reader.dn_angles -= 1
        if predicate == 0: return 0
    if rt_dc_membership(predicate): return 0
    refine_active = true
    n = mk(.trefined, pos)
    nodes[n].a = i32(base)
    nodes[n].name = i32(binder)
    nodes[n].b = i32(rt_dc_ref_predicate(predicate))
    n

rt_dc_condition = (base: int) -> int:
    pos = mkpos(dc_parser.file, dc_parser.tokens[dc_parser.at].start)
    dc_parser.reader.dn_angles += 1
    predicate = rt_dc_ref_predicate_read(0)
    dc_parser.reader.dn_angles -= 1
    if predicate == 0 or rt_dc_membership(predicate): return 0
    k = nodes[predicate].kind
    tested = predicate
    if k == .not_: tested = int(nodes[predicate].a)
    # (`m in? 2..254`: membership in a contiguous range, dw_ref_predicate's)
    if not (k == .and_ or nodes[tested].kind == .binary and (rt_dc_comparison(Tok(int(nodes[tested].op))) or k == .binary and nodes[tested].op == i32(int(Tok.kw_in)))): return 0
    refine_active = true
    n = mk(.trefined, pos)
    nodes[n].a = i32(base)
    nodes[n].name = i32(dc_parser.reader.dc_pattern_binder)
    nodes[n].b = i32(rt_dc_ref_predicate(predicate))
    n

# A refinement's predicate is being read (dc_refining above 0): the ranges its memberships test,
# by the value dc_expr made of each, as dw_ref_predicate reads them (dw_iterable's slice).

rt_dc_ref_predicate_read = (minimum: int) -> int:
    dc_parser.reader.dc_refining += 1
    predicate = rt_dc_expr(minimum)
    dc_parser.reader.dc_refining -= 1
    if predicate != 0 and dc_parser.reader.dc_member_ranges.len() > 0: rt_dc_ref_ranges(predicate)
    if dc_parser.reader.dc_refining == 0: dc_parser.reader.dc_member_ranges.clear()
    predicate

rt_dc_note_member_range = (value: int): dc_parser.reader.dc_member_ranges[value] = dc_parser.reader.dc_range_node

rt_dc_ref_ranges = (n: int):
    k = nodes[n].kind
    if k == .and_:
        rt_dc_ref_ranges(int(nodes[n].a))
        rt_dc_ref_ranges(int(nodes[n].b))
    else if k == .binary and nodes[n].op == i32(int(Tok.kw_in)):
        if let range = dc_parser.reader.dc_member_ranges.get(int(nodes[n].b)): nodes[n].b = i32(range)

rt_dc_comparison = (op: Tok) -> bool: op == .eq or op == .ne or op == .lt or op == .le or op == .gt or op == .ge

# A refinement's conjunction is a bare `and` (dw_ref_predicate).

rt_dc_ref_predicate = (n: int) -> int:
    if nodes[n].kind != .and_: return n
    both = mk(.and_, nodes[n].pos)
    nodes[both].a = i32(rt_dc_ref_predicate(int(nodes[n].a)))
    nodes[both].b = i32(rt_dc_ref_predicate(int(nodes[n].b)))
    both

# `<a >? 0 b <? a>` at its `<`: the propositions, joined by `and` (0: none, or one not read).

rt_dc_facts = () -> int:
    dc_parser.at += 1
    predicate = 0
    loop not rt_dn_accept(.rangle):
        if dc_parser.tokens[dc_parser.at].kind == .eof: return 0
        dc_parser.reader.dn_angles += 1
        entry = rt_dc_ref_predicate_read(0)
        dc_parser.reader.dn_angles -= 1
        if entry == 0 or rt_dc_membership(entry): return 0
        term = rt_dc_ref_predicate(entry)
        if predicate == 0: predicate = term
        else:
            both = mk(.and_, nodes[term].pos)
            nodes[both].a = i32(predicate)
            nodes[both].b = i32(term)
            predicate = both
    predicate

# A result type with a boolean arm or facts on an arm is next (`:>true & <a >? 0> | false`,
# `:>Yes & <a >? 0> | No`), before the `=>`.

rt_dc_fact_result_next = () -> bool:
    at = dc_parser.at
    depth = 0
    loop true:
        t = dc_parser.tokens[at]
        s = t.symbol
        if t.kind == .eof or depth == 0 and (s == .function or s == .lbrace): return false
        if s == .lparen or s == .lbrack or s == .langle: depth += 1
        else if s == .rparen or s == .rbrack or s == .rangle:
            if depth == 0: return false
            depth -= 1
        else if depth == 0 and (t.kind == .boolean or s == .amp and dc_parser.tokens[at + 1].symbol == .langle): return true
        at += 1
    false

# Such a result (dw_result_type): its arms joined left to right; a boolean arm is a bool marked in
# result_boolean_masks, an arm's facts a ResultClause of the function `owner`.

rt_dc_fact_result = (owner: int) -> int:
    pos = mkpos(dc_parser.file, dc_parser.tokens[dc_parser.at].start)
    n = rt_dc_fact_arm(owner)
    loop n != 0 and rt_dn_peek() == .pipe:
        dc_parser.at += 1
        right = rt_dc_fact_arm(owner)
        if right == 0: return 0
        union = mk(.tunion, pos)
        set_list(union, [n, right])
        n = union
    n

rt_dc_fact_arm = (owner: int) -> int:
    token = dc_parser.tokens[dc_parser.at]
    member = 0
    tag = 0
    if token.kind == .boolean:
        dc_parser.at += 1
        tag = if int(token.name) == dc_parser.reader.dn_true_id: 2 else: 1
        result_boolean_masks[owner] = (result_boolean_masks.get(owner) ?? 0) | tag
        result_active = true
        refine_active = true
        member = mk(.tname, mkpos(dc_parser.file, token.start))
        nodes[member].name = i32(intern("bool"))
    else:
        dc_parser.reader.dc_effects_follow = true
        member = rt_dc_annotation(dn_power(.pipe))
        dc_parser.reader.dc_effects_follow = false
        if member == 0: return 0
    if rt_dn_peek() != .amp or dc_parser.tokens[dc_parser.at + 1].symbol != .langle: return member
    dc_parser.at += 1
    predicate = rt_dc_facts()
    if predicate == 0: return 0
    clauses = result_syntax.get(owner) ?? []
    clauses.push(ResultClause(member, predicate, tag))
    result_syntax[owner] = clauses
    result_active = true
    refine_active = true
    member

# `in?` under `not` in a refinement's predicate, but in a contiguous range (dw_ref_predicate reads
# only the conjunction's own memberships as slices, dc_ref_ranges; another stays a value).

rt_dc_membership = (n: int, top: bool = true) -> bool:
    k = nodes[n].kind
    if k == .and_: return rt_dc_membership(int(nodes[n].a), top) or rt_dc_membership(int(nodes[n].b), top)
    if k == .not_: return rt_dc_membership(int(nodes[n].a), false)
    if top or k != .binary or nodes[n].op != i32(int(Tok.kw_in)): return false
    r = int(nodes[n].b)
    not (nodes[r].kind == .range and not has_flag(r, NF_STEP) and not has_flag(r, NF_EXCL_FIRST))

# `'wrap'` 1, `'saturate'` 2, as an overflow policy is written (anything else 0)

rt_dc_policy_mistake = (policy: int) -> int:
    at = mkpos(dc_parser.file, dc_parser.tokens[dc_parser.at - 2].start)
    if policy == 0:
        token = dc_parser.tokens[dc_parser.at]
        if token.kind != .quoted: return rt_dc_hint(at, "an overflow policy is a quoted name: use 'wrap' or 'saturate'")
        written = files[dc_parser.file].src[token.start..token.stop)
        return rt_dc_hint(at, "unknown overflow policy {written}; use 'wrap' or 'saturate'")
    rt_dc_hint(at, "an integer type takes one overflow policy; remove the second `overflow=...`")

rt_dc_policy = (token: DewyLexeme) -> int:
    if token.kind != .quoted: return 0
    source = files[dc_parser.file].src
    quote = source[token.start]
    if (quote != '\'' and quote != '"') or source[token.stop - 1] != quote: return 0
    width = token.stop - token.start - 2
    if width == 4 and rt_dn_matches(source.data(), token.start + 1, token.stop, "wrap"): return 1
    if width == 8 and rt_dn_matches(source.data(), token.start + 1, token.stop, "saturate"): return 2
    0

# `<overflow='wrap'>` is next, after the type's name.

rt_dc_policy_only = () -> bool:
    at = dc_parser.at + 2
    if at + 3 >= dc_parser.tokens.len(): return false
    setting = dc_parser.tokens[at]
    if setting.kind != .identifier or setting.symbol != .none or rt_dc_word(int(setting.name)) != DC_OVERFLOW: return false
    dc_parser.tokens[at + 1].symbol == .assign and rt_dc_policy(dc_parser.tokens[at + 2]) != 0 and dc_parser.tokens[at + 3].symbol == .rangle

# `let value + 1`, `let value[1]`, `let value:int64 + 1`: dw_declare's mistake (or dw_type's, on
# the type the rest extends), should nothing else read it.

rt_dc_unnamed = (n: int) -> int:
    typed = int(nodes[n].a)
    name = rt_dc_token_from(pos_off(nodes[n].pos))
    if name <= 0:
        if typed != 0 and dn_power(rt_dn_peek()) > 0: return rt_dc_hint(nodes[typed].pos, "Dewy does not yet support this type expression")
        return rt_dc_hint(nodes[n].pos, "Dewy does not yet support this declaration")
    src = files[dc_parser.file].src
    keyword = rt_dn_payload(dc_parser.tokens[name - 1])
    written = rt_dn_payload(dc_parser.tokens[name])
    if typed != 0 and dn_power(rt_dn_peek()) > 0:
        annotation = src[pos_off(nodes[typed].pos)..dc_parser.tokens[dc_parser.at - 1].stop)
        return rt_dc_hint(nodes[typed].pos, "a type annotation ends before `=`: write `{keyword} {written}:{annotation} = expression`")
    rt_dc_hint(nodes[n].pos, "a variable binding needs a value: write `{keyword} {written} = expression`")

# The token written at offset off, at or before dc_parser.at (-1 for none).

rt_dc_token_from = (off: int) -> int:
    k = dc_parser.at
    loop k >= 0 and dc_parser.tokens[k].start > off: k -= 1
    if k < 0 or dc_parser.tokens[k].start != off: return -1
    k

# `let (a) = (1)`: one name in parentheses, `)` at close (dw_declare's mistake, should nothing else
# read it), written again without them when the value ends its line.

rt_dc_grouped_binder = (close: int) -> int:
    opening = rt_dc_open_paren(close)
    pos = mkpos(dc_parser.file, dc_parser.tokens[opening].start)
    src = files[dc_parser.file].src
    keyword = rt_dn_payload(dc_parser.tokens[opening - 1])
    written = src[dc_parser.tokens[opening + 1].start..dc_parser.tokens[close - 1].stop)
    first = close + 2
    if dc_parser.tokens[close + 1].symbol != .assign or dc_parser.tokens[first].newline or dc_parser.tokens[first].kind == .eof: return rt_dc_hint(pos, "a parenthesized name is not a binding pattern: write `{keyword} {written} = value`")
    last = first
    loop dc_parser.tokens[last + 1].kind != .eof and not dc_parser.tokens[last + 1].newline and dc_parser.tokens[last + 1].symbol != .rbrace: last += 1
    # (a value wholly in parentheses, `(1)`, is written without them)
    if dc_parser.tokens[first].symbol == .lparen and dc_parser.tokens[last].symbol == .rparen and rt_dc_closing(first) == last and last > first + 1:
        first += 1
        last -= 1
    value = src[dc_parser.tokens[first].start..dc_parser.tokens[last].stop)
    rt_dc_hint(pos, "a parenthesized name is not a binding pattern: write `{keyword} {written} = {value}`")

# The `(` the `)` at `at` closes.

rt_dc_open_paren = (at: int) -> int:
    depth = 0
    k = at
    loop k > 0:
        if dc_parser.tokens[k].symbol == .rparen: depth += 1
        if dc_parser.tokens[k].symbol == .lparen:
            depth -= 1
            if depth == 0: return k
        k -= 1
    k

# A declaration's type read no way (dw_type's mistake, should nothing else read it).

rt_dc_untyped = (at: int) -> int:
    token = dc_parser.tokens[at]
    # (`let value:int64 + 1`: the rest extends a type that is one name)
    after = dc_parser.tokens[at + 1].symbol
    keyword = DewyToken.none
    if at >= 3: keyword = dc_parser.tokens[at - 3].symbol
    if (keyword == .kw_let or keyword == .kw_const) and token.kind == .identifier and dc_parser.tokens[at - 1].symbol == .colon and dn_power(after) > 0 and after != .assign and after != .pipe and after != .amp and after != .langle and after != .question and after != .coalesce:
        return rt_dc_hint(mkpos(dc_parser.file, token.start), "a type annotation ends before `=`: write `{rt_dn_payload(dc_parser.tokens[at - 3])} {rt_dn_payload(dc_parser.tokens[at - 2])}:{rt_dn_payload(token)} = expression`")
    # (`let value:return=1`: a keyword then `=`, dn_atom's mistake)
    if token.symbol != .none and token.kind == .identifier and dc_parser.tokens[at + 1].symbol == .assign: return rt_dc_hint(mkpos(dc_parser.file, token.start), rt_dc_keyword_text(token.symbol))
    rt_dc_hint(mkpos(dc_parser.file, token.start), "Dewy does not yet support this type expression")

rt_dc_declaration = (constant: bool, bare: bool = false) -> int:
    token = dc_parser.tokens[dc_parser.at]
    # `let [a b] = value`, `let (a b) = values`: an unpacking declaration (dw_declare's pattern)
    if (token.symbol == .lbrack or token.symbol == .lparen) and not bare:
        dc_parser.at += 1
        n = mk(.vardecl, mkpos(dc_parser.file, token.start))
        seen: int[]
        close = DewyToken.rbrack
        if token.symbol == .lparen: close = .rparen
        binders = rt_dc_binding_items(seen, close)
        if binders.len() == 0: return 0
        if close == .rparen and binders.len() < 2: return rt_dc_grouped_binder(dc_parser.at - 1)
        set_list(n, binders)
        if rt_dn_accept(.colon):
            annotation = rt_dc_annotation()
            if annotation == 0: return 0
            nodes[n].a = i32(annotation)
        if not rt_dn_accept(.assign) or rt_dc_lambda_next(): return 0
        dc_parser.depth += 1
        initial = rt_dc_expr(11)
        dc_parser.depth -= 1
        if initial == 0 or nodes[initial].kind == .lambda: return 0
        nodes[n].b = i32(initial)
        if constant: add_flag(n, NF_RDONLY)
        rt_dc_accept_semi(true)
        return n
    # (`let and = 3`, `let end = 20`: a word operator or a reserved word as the name, dw_declare's
    # mistakes, reported once the declaration is read)
    word = false
    reserved = false
    if token.kind != .identifier or token.symbol != .none and token.symbol != .kw_test:
        word = not bare and rt_dc_word_operator(token.symbol) and (dc_parser.tokens[dc_parser.at + 1].symbol == .assign or dc_parser.tokens[dc_parser.at + 1].symbol == .colon)
        if not word: return 0
    else if rt_dn_reserved(int(token.name)):
        if bare: return 0
        reserved = true
    dc_parser.at += 1
    n = mk(.vardecl, mkpos(dc_parser.file, token.start))
    nodes[n].name = token.name
    if rt_dn_accept(.colon):
        outer = dc_parser.reader.dc_pattern_binder
        dc_parser.reader.dc_pattern_binder = int(token.name)
        typed_at = dc_parser.at
        annotation = rt_dc_annotation()
        dc_parser.reader.dc_pattern_binder = outer
        if annotation == 0: return rt_dc_untyped(typed_at)
        nodes[n].a = i32(annotation)
    if rt_dn_accept(.assign):
        # (`name:T = value` without `let` declares at the top of a module only, dw_stmt)
        # (a module's annotated function literal is a value of that type, its parameter names
        # among it: `let f:<(amount:int64):>int64> = (x) => x*2`)
        typed = dc_parser.reader.dc_top_level and nodes[n].a != 0
        if bare and not dc_parser.reader.dc_top_level or not dc_parser.flags.fn_body and not typed and rt_dc_lambda_next(): return 0
        dc_parser.reader.dc_initial_at = dc_parser.at
        dc_parser.depth += 1
        initial = rt_dc_expr(11)
        dc_parser.depth -= 1
        if initial == 0 or nodes[initial].kind == .lambda and not dc_parser.flags.fn_body and not typed or rt_dc_inferred_refinement(initial): return 0
        nodes[n].b = i32(initial)
    else:
        next = dc_parser.tokens[dc_parser.at]
        if dn_power(next.symbol) > 0 or next.symbol == .dot or next.symbol == .question or next.symbol == .ellipsis: return rt_dc_unnamed(n)
        if not next.space and (next.symbol == .lparen or next.symbol == .lbrack or next.symbol == .langle or next.kind == .quoted or next.kind == .rawquoted): return rt_dc_unnamed(n)
        if constant: rt_dc_const_missing(n)
    if word: rt_dc_word_operator_at(token)
    if reserved: rt_dc_reserved_at(token)
    if constant:
        value = int(nodes[n].b)
        if dw_const_number(value) or nodes[value].kind == .str_lit or nodes[value].kind == .none_lit: nodes[n].kind = .const_
        else: add_flag(n, NF_RDONLY)
    decimal_let(n)
    rt_dc_accept_semi(not (bare and dc_parser.reader.dc_unbraced))
    n

# A flow body is a statement block even when its braces are omitted. These
# functions participate in the enclosing construction transaction: an unknown
# head, label, declaration or expression is left unread (dc_unread).

rt_dc_body = () -> int:
    # (`=> $unsafe { ... }`: the boundary covers the block, which stays the body itself, dw_block)
    if dc_parser.tokens[dc_parser.at].kind == .metatag and dc_parser.tokens[dc_parser.at + 1].symbol == .lbrace and rt_dc_unsafe_at(dc_parser.at):
        opening = dc_parser.tokens[dc_parser.at]
        dc_parser.at += 1
        n = rt_dc_body()
        if n == 0 or not rt_dc_flow_ends(): return 0
        rt_dc_unsafe_scope(mkpos(dc_parser.file, opening.start))
        return n
    saved = dc_parser.reader.dc_unbraced
    dc_parser.reader.dc_unbraced = rt_dn_peek() != .lbrace
    n = rt_dc_body_read()
    dc_parser.reader.dc_unbraced = saved
    n

# A `;` ending this statement; in an unbraced body only one before `else` (`if c f(); else g()`,
# which the direct grammar has read as the body's own).

rt_dc_accept_semi = (statement: bool) -> bool:
    if statement or rt_dn_peek() == .semi and dc_parser.tokens[dc_parser.at + 1].symbol == .kw_else: return rt_dn_accept_semi()
    false

# (dc_statement's left side when no assignment follows it, read from dc_value_start)

rt_dc_body_read = () -> int:
    dc_parser.reader.dc_top_level = false
    # (a braced body is a block of statements, an unbraced one the statement alone: dn_expr's depth)
    braced = rt_dn_peek() == .lbrace
    if braced: dc_parser.depth += 1
    if dc_parser.depth + dc_parser.reader.dn_depth > 256: return 0
    pos = mkpos(dc_parser.file, dc_parser.tokens[dc_parser.at].start)
    dc_parser.at += if braced: 1 else: 0
    n = mk(.block, pos)
    statements: int[]
    last_start = dc_parser.at
    settings = dc_parser.reader.dc_settings.len()
    loop true:
        if braced and rt_dn_accept(.rbrace): break
        if dc_parser.tokens[dc_parser.at].kind == .eof:
            if braced and dc_parser.flags.report_now: rt_dc_unclosed(pos, "}")
            return 0
        start = dc_parser.at
        last_start = start
        if braced and dc_parser.flags.unread_here: dc_parser.status.hint_pos = 0
        node_start = nodes.len()
        list_start = lists.len()
        depth = dc_parser.depth
        edits = dc_parser.reader.dn_edit_at.len()
        # `$runtime_checks`, `$no_nan=false`: a setting holding throughout the block, wherever
        # written (dw_dir_block); `$outer loop ...`: a loop's label (dw_block)
        if dc_parser.tokens[dc_parser.at].kind == .metatag and braced:
            tagged = rt_dc_body_metatag(statements)
            if tagged < 0: return 0
            if tagged > 0: continue
        # (`$field(name)=value` ending a record comprehension's body: a row, dc_record_loop)
        if dc_parser.reader.dc_map_ok and rt_dc_field_next():
            entry = rt_dc_field_entry()
            if entry == 0: return 0
            statement = mk(.exprstmt, nodes[entry].pos)
            nodes[statement].a = i32(entry)
            statements.push(statement)
            if not braced: break
            continue
        dc_parser.reader.dc_splice_ok = true
        statement = rt_dc_statement()
        # `if $target.os =? "windows" { ... } else { ... }`: the compiled arm's statements, here
        # (dw_target_splice)
        if statement != 0 and dc_parser.reader.dc_live_at == start and dc_parser.tokens[start].symbol == .kw_if:
            loop spliced in kids(statement): statements.push(spliced)
            if not braced: break
            continue
        if statement == 0:
            value = 0
            if dc_parser.reader.dc_value_start == start and dc_parser.reader.dc_value != 0:
                value = dc_parser.reader.dc_value
                dc_parser.depth = depth
            else:
                dc_parser.at = start
                nodes.truncate(node_start)
                lists.truncate(list_start)
                rt_dn_edits_undo(edits)
                # A failed expression may leave the recursion counter elevated.
                dc_parser.depth = depth
                value = rt_dc_expr(0)
                dc_parser.depth = depth
                # (a chain whose compiled arm is spliced is no value here)
                if value != 0 and dc_parser.reader.dc_live_at == start and dc_parser.tokens[start].symbol == .kw_if: value = 0
            dc_parser.reader.dc_value = 0
            dc_parser.reader.dc_value_start = -1
            # (`key -> value` ending a dictionary comprehension's body: an entry, dc_collect)
            if value != 0 and dc_parser.reader.dc_map_ok and rt_dn_peek() == .arrow:
                dc_parser.at += 1
                entry = rt_dc_expr(21)
                if entry == 0: value = 0
                else:
                    pair = mk(.pair, mkpos(dc_parser.file, dc_parser.tokens[start].start))
                    nodes[pair].a = i32(value)
                    nodes[pair].b = i32(entry)
                    value = pair
                    dc_parser.reader.dc_pairs_made += 1
            if value == 0:
                # (in a module function's braced body, a statement read no way is reported here;
                # elsewhere the enclosing reading gives up, dc_unread)
                if braced and dc_parser.flags.unread_here and dc_parser.tokens[start].kind != .metatag: rt_dc_unread(start)
                return 0
            at = mkpos(dc_parser.file, dc_parser.tokens[start].start)
            if rt_dc_accept_semi(braced):
                statement = mk(.assign, at)
                nodes[statement].op = i32(int(Tok.assign))
                nodes[statement].a = i32(mk(.hole, at))
                nodes[statement].b = i32(value)
            else:
                # (`$unsafe f()`: the statement is its operand's, dw_stmt)
                if rt_dc_unsafe_at(start): at = mkpos(dc_parser.file, dc_parser.tokens[start + 1].start)
                statement = mk(.exprstmt, at)
                nodes[statement].a = i32(value)
        statements.push(statement)
        if not braced: break
    # (a block whose last statement is tagged: dc_collect leaves it unread)
    if statements.len() > 0 and dc_parser.tokens[last_start].kind == .metatag: dc_parser.collection.tagged_last[n] = true
    if dc_parser.reader.dc_settings.len() > settings:
        # (through its closing brace: its last syntax node is the last position inside, dw_dir_last)
        dc_parser.collection.tagged_last[n] = true
        end = mkpos(dc_parser.file, dc_parser.tokens[dc_parser.at - 1].start)
        loop i in [settings..dc_parser.reader.dc_settings.len()):
            rt_dc_scope_undoable()
            dw_dir_apply(dc_parser.reader.dc_settings[i], dc_parser.reader.dc_setting_values[i], dc_parser.reader.dc_setting_at[i], pos, end, false)
        dc_parser.reader.dc_settings.truncate(settings)
        dc_parser.reader.dc_setting_values.truncate(settings)
        dc_parser.reader.dc_setting_at.truncate(settings)
    set_list(n, statements)
    if braced: dc_parser.depth -= 1
    n

# `{` or `[` at pos with no closer before the end (dn_bracketed_from's mistake, at once).

rt_dc_unclosed = (pos: int, close: str): dn_error(pos_off(pos), "expected '{close}' before end of file")

# A metatag opening a braced body's statement: a setting (dc_settings), a labelled loop or a
# mistake dc_body_tag notes, 1 (read); 0 for a directive, -1 a form left unread (dc_unread).

rt_dc_body_metatag = (statements: mut int[]) -> int:
    tag = dc_parser.tokens[dc_parser.at]
    name = rt_dn_payload(tag)
    # (`$include_bytes(p"asset") as name`: a statement, dc_include_binding)
    if dn_directive_form(name) != 0 or name == "include_bytes": return 0
    if dw_dir_name(name):
        value = rt_dc_block_setting()
        if value < 0: return -1
        dc_parser.reader.dc_settings.push(name)
        dc_parser.reader.dc_setting_values.push(value)
        dc_parser.reader.dc_setting_at.push(mkpos(dc_parser.file, tag.start))
        return 1
    # (`$build.mode = ...`: a mistake in a body, dc_statement's dc_body_setting)
    if (name == "target" or name == "build") and dc_parser.tokens[rt_dc_setting_place_end(dc_parser.at)].symbol == .assign: return 0
    mistake = rt_dc_body_tag(name, tag)
    if mistake != 0: return mistake
    dc_parser.at += 1
    statement = rt_dc_statement()
    if statement == 0: return -1
    k = nodes[statement].kind
    if k != .loopx and k != .for_ and k != .while_: return -1
    nodes[statement].sval = i32(intern(name))
    statements.push(statement)
    1

# A metatag in a body that is no setting: 0 for a loop's label (`$outer loop ...`); a mistake
# noted, once the block is read (1, the tag and an `=` read): `$shadowable` or `$supported_targets`
# (dw_metatag_fail), a label before no loop (dw_label_fail); -1 a form left unread (dc_unread).

rt_dc_body_tag = (name: str, tag: DewyLexeme) -> int:
    if (name == "shadowable" or name == "supported_targets") and dc_parser.flags.report_now:
        if name == "shadowable": rt_dc_report(mkpos(dc_parser.file, tag.start), "`$shadowable` marks a module-level const: `$shadowable const name = ...` at the top of the file")
        else: rt_dc_report(mkpos(dc_parser.file, tag.start), "`$supported_targets` is a module directive; put it at file scope")
        dc_parser.at += 1
        rt_dn_accept(.assign)
        return 1
    # (`$capture`, `$unsafe_assume ...` in a body: dw_metatag_fail's and dw_unimplemented's mistakes)
    if (name == "capture" or rt_dc_unbuilt(name)) and dc_parser.flags.report_now: return rt_dc_fail_now(mkpos(dc_parser.file, tag.start), metatag_fail_text(name)) - 1
    if name == "target" or name == "build" or name == "capture" or name == "include_bytes" or name == "shadowable" or name == "supported_targets" or dw_designed_directive(name): return -1
    next = dc_parser.tokens[dc_parser.at + 1]
    if next.symbol == .kw_loop: return 0
    # (a label is a tag alone: one an expression goes on from is no label)
    if not dc_parser.flags.report_now or dn_power(next.symbol) > 0 or not next.space and not next.newline and next.kind != .eof and next.symbol != .rbrace: return -1
    if name == "explicit_allocation_failure": rt_dc_report(mkpos(dc_parser.file, tag.start), "`$explicit_allocation_failure` is a module directive; put it at file scope, at the top")
    else: rt_dc_report(mkpos(dc_parser.file, tag.start), "a loop label must be followed by a loop (`${name}` is not a directive)")
    dc_parser.at += 1
    1

# `$target` and its fields read directly (dw_target_field): each such string's field (0 `$target`,
# 1 `.arch`, 2 `.os`, 3 `$build.mode`) and position by node, and where its member is written
# (an arm a test leaves out uses that name, dw_target_dropped).

rt_dc_target_value = (field: int, pos: int, member: int) -> int:
    n = mk(.str_lit, pos)
    rt_dc_target_note(n, field, member)
    n

rt_dc_target_note = (n: int, field: int, member: int):
    nodes[n].sval = i32(intern(if field == 0: dw_target_name() else: dw_target_field_value(field)))
    dc_parser.reader.dc_targets_made += 1
    dc_parser.reader.dc_target_fields[n] = field
    dc_parser.reader.dc_target_pos[n] = nodes[n].pos
    if member >= 0: dc_parser.reader.dc_target_members[n] = mkpos(dc_parser.file, member)
    else: dc_parser.reader.dc_target_members.remove(n)

# The field the string n reads (dc_target_note), -1 for any other node.

rt_dc_target_of = (n: int) -> int:
    if n <= 0 or nodes[n].kind != .str_lit: return -1
    if let field = dc_parser.reader.dc_target_fields.get(n):
        if (dc_parser.reader.dc_target_pos.get(n) ?? -1) == nodes[n].pos: return field
    -1

# A condition made only of `$target`, its fields or `$build.mode` compared with string literals
# (target_fold): 1 true, 0 false, -1 any other condition; -2 a name the design does not give,
# which is left unread (dc_unread).

rt_dc_target_fold = (n: int) -> int:
    if dc_parser.reader.dc_targets_made == 0 or n <= 0: return -1
    k = nodes[n].kind
    if k == .not_:
        fold = -1
        # (`a not =? b`: an inverted comparison; `not c`, but not `~c`)
        if nodes[n].op == 0: fold = rt_dc_target_compare(int(nodes[n].a))
        else:
            if files[dc_parser.file].src.data()[pos_off(nodes[n].pos)] == '~': return -1
            fold = rt_dc_target_fold(int(nodes[n].a))
        if fold < 0: return fold
        return 1 - fold
    if k == .and_ or k == .or_:
        left = rt_dc_target_fold(int(nodes[n].a))
        if left < 0: return left
        right = rt_dc_target_fold(int(nodes[n].b))
        if right < 0: return right
        if k == .and_: return left & right
        return left | right
    rt_dc_target_compare(n)

rt_dc_target_compare = (n: int) -> int:
    if nodes[n].kind != .binary: return -1
    op = nodes[n].op
    if op == i32(int(Tok.eq)):
        left = int(nodes[n].a)
        right = int(nodes[n].b)
        if rt_dc_target_of(right) >= 0:
            right = left
            left = int(nodes[n].b)
        field = rt_dc_target_of(left)
        if field < 0: return -1
        name = rt_dc_target_literal(right, field)
        if name == "": return dc_parser.reader.dc_target_problem
        return if name == dw_target_field_value(field): 1 else: 0
    if op != i32(int(Tok.kw_in)): return -1
    field = rt_dc_target_of(int(nodes[n].a))
    list = int(nodes[n].b)
    if field < 0 or nodes[list].kind != .array or has_flag(list, NF_COMPREHENSION): return -1
    found = 0
    loop entry in kids(list):
        name = rt_dc_target_literal(entry, field)
        if name == "": return dc_parser.reader.dc_target_problem
        if name == dw_target_field_value(field): found = 1
    found

# A plain string literal naming a target (field 0), processor (1), system (2) or build mode (3)
# (syntax_target_literal): "" when n is no such literal, dc_target_problem -2 when it names none.

rt_dc_target_literal = (n: int, field: int, report: bool = true) -> str:
    dc_parser.reader.dc_target_problem = -1
    if nodes[n].kind != .str_lit or nkids(n) > 0 or rt_dc_target_of(n) >= 0 or has_flag(n, NF_SPREAD): return ""
    name = name_of(int(nodes[n].sval))
    known = false
    if field == 3: known = name == "release" or name == "debug"
    else if field == 1: known = name in target_arches()
    else if field == 2: known = name in target_oses()
    else: known = name in target_names() and (target_os_of(name) != "none" or name == "wasm32" or name == "c89")
    if known: return name
    if not dc_parser.flags.report_now or not report:
        dc_parser.reader.dc_target_problem = -2
        return ""
    # (syntax_target_literal's mistakes, reported once the statement is read)
    rt_dc_report(nodes[n].pos, rt_dc_target_text(name, field))
    name

rt_dc_target_text = (name: str, field: int) -> str:
    if field == 3: return "unknown build mode \"{name}\": `$build.mode` is \"release\" or \"debug\""
    if field == 1: return "unknown processor \"{name}\": `$target.arch` is one of {join(target_arches(), ", ")}"
    if field == 2: return "unknown system \"{name}\": `$target.os` is one of {join(target_oses(), ", ")}"
    if not (name in target_names()): return "unknown target \"{name}\": `$target` is one of {join(target_names(), ", ")}"
    "`$target` is a full target name, never \"{name}\" alone (which asks for the current machine): test the processor with `$target.arch =? \"{name}\"`, or name the system too, as \"{name}-linux\""


# The names an arm a fold leaves out uses (dw_target_dropped), from its nodes.

rt_dc_target_dropped = (n: int):
    if dc_parser.reader.dc_target_members.len() == 0: dw_target_dropped_node(n)
    else: rt_dc_target_dropped_walk(n)

rt_dc_target_dropped_walk = (n: int):
    if n <= 0 or n >= nodes.len(): return
    if nodes[n].kind == .str_lit and rt_dc_target_of(n) > 0:
        if let at = dc_parser.reader.dc_target_members.get(n): dw_target_dropped_name(intern(if rt_dc_target_of(n) == 1: "arch" else if rt_dc_target_of(n) == 2: "os" else: "mode"), at)
        return
    if nodes[n].kind == .ident: dw_target_dropped_name(int(nodes[n].name), nodes[n].pos)
    mask = isolation_children(nodes[n].kind)
    if nodes[n].kind == .lambda:
        mask = 1 | 2 | 4 | 16
        loop c in kids2(n): rt_dc_target_dropped_walk(c)
    if mask < 0: mask = 1 | 2 | 4 | 16
    if mask & 1 != 0: rt_dc_target_dropped_walk(int(nodes[n].a))
    if mask & 2 != 0: rt_dc_target_dropped_walk(int(nodes[n].b))
    if mask & 4 != 0: rt_dc_target_dropped_walk(int(nodes[n].c))
    if mask & 16 != 0:
        loop c in kids(n): rt_dc_target_dropped_walk(c)

# What a loop iterates, after `in` (dw_iterable): a range, bracketed (`[a..b]`, `[a..b)`, `(a..b]`,
# `(a..b)`) or not (`a..b`, `a..`, inclusive), stepped by a second start (`[a,b..c)`), or a value
# (its iteration, `__dewy_iter`). A live place (`in @xs`) is left unread (dc_unread).

rt_dc_iterable = () -> int:
    opening = dc_parser.at
    if dc_parser.tokens[dc_parser.at].symbol == .at: return 0
    if dc_parser.tokens[dc_parser.at].symbol == .lbrack or dc_parser.tokens[dc_parser.at].symbol == .lparen:
        start = dc_parser.at
        node_start = nodes.len()
        list_start = lists.len()
        edits = dc_parser.reader.dn_edit_at.len()
        dc_parser.at += 1
        range = rt_dc_range(true)
        if range != 0 or dc_parser.at < 0: return range
        # (not a range: the brackets hold a value, `[1 2 3]`, `(xs)`)
        dc_parser.at = start
        nodes.truncate(node_start)
        lists.truncate(list_start)
        rt_dn_edits_undo(edits)
    range = rt_dc_range(false)
    if dc_parser.at < 0: return 0
    if range != 0: return range
    dc_parser.at = dc_parser.reader.dc_range_at
    first = dc_parser.reader.dc_range_first
    if rt_dn_peek() != .lbrace and dn_power(rt_dn_peek()) >= 96 and not rt_dc_signed_next(): return 0
    callee = mk(.ident, mkpos(dc_parser.file, dc_parser.tokens[opening].start))
    nodes[callee].name = i32(rt_dc_builtin(4))
    n = mk(.call, mkpos(dc_parser.file, dc_parser.tokens[opening].start))
    nodes[n].a = i32(callee)
    set_list(n, [first])
    n

# `[0..n as int64)` at `as` (dn_block's mistake, at once): `as` converts the whole range, then `)`.

rt_dc_range_cast = () -> int:
    op = rt_dn_take().symbol
    if rt_dc_cast_type(op == .kw_as, dn_power(op)) == 0 or rt_dn_peek() != .rparen: return rt_dc_range_fail()
    dn_error(dc_parser.tokens[dc_parser.at].start, "expected an expression, found ')': `{dn_token_text(op)}` binds more loosely than `..`, so here it converts the whole range; parenthesize the bound, as in `[0..(n as int64))`")

# `xs -1`: a sign attached to what follows, spaced from what precedes, starts the next value
# (dc_expr ends there, as an expression does).

rt_dc_signed_next = () -> bool:
    t = dc_parser.tokens[dc_parser.at]
    (t.symbol == .plus or t.symbol == .minus) and t.space and not dc_parser.tokens[dc_parser.at + 1].space

# (dc_range's first value when it reads no range, and where that value ends)

rt_dc_range = (bracketed: bool, value: bool = false, open: bool = false) -> int:
    grouped = bracketed and dc_parser.tokens[dc_parser.at - 1].symbol == .lparen
    pos = mkpos(dc_parser.file, dc_parser.tokens[dc_parser.at].start)
    dc_parser.reader.dc_range_first = 0
    first = 0
    second = 0
    if (open or value and dc_parser.flags.report_now and rt_dn_peek() == .range and dn_range_bound(dc_parser.tokens, dc_parser.at + 1)) and rt_dn_accept(.range):
        # (`x in? [..b]`: a membership's range may be open, dw_iterable's slice; a stored one,
        # dc_stored_open's mistake)
        first = 0
    else:
        if rt_dn_peek() == .range: return rt_dc_range_fail()
        # (`(+ 1)`: a partial application, dn_partial)
        if grouped and (dn_partial_operator(rt_dn_peek()) or rt_dn_peek() == .kw_not): return rt_dc_range_fail()
        # (`[m.keys...]`: a spread element, so the brackets hold a value)
        saved_spread = dc_parser.reader.dc_spread_depth
        if bracketed: dc_parser.reader.dc_spread_depth = dc_parser.depth + 1
        first = rt_dc_expr(106)
        dc_parser.reader.dc_spread_depth = saved_spread
        if first == 0: return rt_dc_range_fail()
        if has_flag(first, NF_SPREAD):
            dc_parser.reader.dc_range_first = first
            dc_parser.reader.dc_range_at = dc_parser.at
            return 0
        if rt_dn_accept(.comma):
            second = rt_dc_expr(106)
            if second == 0: return rt_dc_range_fail()
            # (`[0,1,2..5]` iterated: dw_iterable's mistake, noted)
            if rt_dn_peek() == .comma and not value and dc_parser.flags.report_now: rt_dc_stepped_arity(pos)
            # (`[0,1,2..5]` as a value: dw_range_value's mistake, should nothing else read it)
            if rt_dn_peek() == .comma: rt_dc_hint(pos, "Dewy does not yet support a stepped range without exactly two starting values")
            if rt_dn_peek() != .range: return rt_dc_range_fail()
        if not rt_dn_accept(.range):
            dc_parser.reader.dc_range_first = first
            dc_parser.reader.dc_range_at = dc_parser.at
            return 0
    last = 0
    if dn_range_bound(dc_parser.tokens, dc_parser.at):
        last = rt_dc_expr(101)
        if last == 0: return rt_dc_range_fail()
    inclusive = true
    if bracketed:
        if rt_dn_accept(.rbrack): inclusive = true
        else if rt_dn_accept(.rparen): inclusive = false
        else if not grouped and (rt_dn_peek() == .kw_as or rt_dn_peek() == .kw_transmute) and dc_parser.flags.report_now: return rt_dc_range_cast()
        else: return rt_dc_range_fail()
        if value:
            n = mk(.range, pos)
            # (`[..]`: the whole range, no bound to include)
            if first == 0 and last == 0: return n
            nodes[n].a = i32(first)
            nodes[n].b = i32(last)
            if second != 0:
                nodes[n].c = i32(second)
                add_flag(n, NF_STEP)
            if inclusive: add_flag(n, NF_INCLUSIVE)
            if grouped: add_flag(n, NF_EXCL_FIRST)
            return n
        # (`[0..n).reversed()`: the brackets are a value the expression goes on with)
        after = dc_parser.tokens[dc_parser.at].symbol
        if after == .dot or after == .question or after == .ellipsis or not dc_parser.tokens[dc_parser.at].space and (after == .lparen or after == .lbrack or after == .langle or dc_parser.tokens[dc_parser.at].kind == .quoted or dc_parser.tokens[dc_parser.at].kind == .rawquoted): return rt_dc_range_fail()
    if rt_dn_peek() != .lbrace and dn_power(rt_dn_peek()) >= 96 and not rt_dc_signed_next(): return rt_dc_range_fail()
    n = mk(.range, pos)
    nodes[n].a = i32(first)
    nodes[n].b = i32(last)
    if second != 0:
        nodes[n].c = i32(second)
        add_flag(n, NF_STEP)
    if inclusive: add_flag(n, NF_INCLUSIVE)
    if grouped:
        add_flag(n, NF_EXCL_FIRST)
        return bc_call("__dewy_iter", [dw_range_value(n)], pos)
    n

rt_dc_stepped_arity = (pos: int):
    rt_dc_unsupported(pos, "a stepped range without exactly two starting values")
    loop rt_dn_accept(.comma):
        if rt_dc_expr(106) == 0: return

rt_dc_range_fail = () -> int:
    dc_parser.at = -1
    0

# A loop's header, as dw_loop_head reads it: `binder in iterable` terms and conditions, joined by
# `and` and `or` (two joined conditions are one, head_collapse).

rt_dc_loop_head = () -> int:
    head = rt_dc_head_term()
    if head == 0: return 0
    if rt_dn_peek() == .lbrace: return head
    if rt_dn_peek() == .kw_and or rt_dn_peek() == .kw_or:
        head = rt_dc_head_and(head)
        loop head != 0 and rt_dn_peek() == .kw_or:
            dc_parser.at += 1
            term = rt_dc_head_term()
            head = rt_dc_head_join(3, head, rt_dc_head_and(term))
    if head == 0: return 0
    if dn_power(rt_dn_peek()) > 0 and not rt_dc_signed_next() and not rt_dc_head_mistake(head): return 0
    head

# An `and` chain from its first term (`and` binds more tightly than `or`).

rt_dc_head_and = (first: int) -> int:
    left = first
    loop left != 0 and rt_dn_peek() == .kw_and:
        dc_parser.at += 1
        left = rt_dc_head_join(2, left, rt_dc_head_term())
    left

# `a and b`, `a or b`: each side a combined head (dw_loop_head's `combined`).

rt_dc_head_join = (op: int, a: int, b: int) -> int:
    if a == 0 or b == 0 or not rt_dc_head_combined(a) or not rt_dc_head_combined(b): return 0
    n = mk(.lhead, nodes[a].pos)
    nodes[n].op = i32(op)
    nodes[n].a = i32(a)
    nodes[n].b = i32(b)
    head_collapse(n)

# A combined iteration binds by value, and steps a stepped range by its iterator.

rt_dc_head_combined = (head: int) -> bool:
    if nodes[head].op != 1: return true
    if has_flag(head, NF_MUT) or dewy_live_sources.has(int(nodes[head].a)): return rt_dc_combined_mistake(head)
    it = int(nodes[head].a)
    if nodes[it].kind == .range and has_flag(it, NF_STEP):
        if nodes[it].b == 0: it = bc_call("__dewy_open_range_iter", [int(nodes[it].a), int(nodes[it].c)], nodes[it].pos)
        else: it = bc_call("__dewy_iter", [dw_range_value(it)], nodes[it].pos)
        nodes[head].a = i32(it)
    true

# A mutable binding or a live source in a combined loop (dw_loop_head's mistakes, noted).

rt_dc_combined_mistake = (head: int) -> bool:
    if not dc_parser.flags.report_now: return false
    if has_flag(head, NF_MUT): rt_dc_unsupported(nodes[head].pos, "a mutable binding in a combined loop; use a separate loop @item in items")
    else: rt_dc_unsupported(dc_parser.reader.dc_live_at_pos.get(head) ?? nodes[head].pos, "live iteration (`in @items`) in a combined loop; use `loop item in @items` alone")
    true

rt_dc_head_mistake = (head: int) -> bool:
    if not dc_parser.flags.report_now or nodes[head].op != 1: return false
    next = dc_parser.tokens[dc_parser.at]
    if next.symbol == .kw_as or next.symbol == .kw_transmute: dn_error(next.start, "`{dn_token_text(next.symbol)}` binds more loosely than `in`, so this converts the whole loop header: parenthesize the source, as in `loop c in (text {dn_token_text(next.symbol)} array<uint8>)`")
    if next.symbol == .coalesce: dn_error(next.start, "`??` binds more loosely than `in`, so this applies the fallback to the whole loop header: parenthesize the source, as in `loop x in (a ?? b)`")
    if next.symbol != .assign: return false
    it = int(nodes[head].a)
    it_name = "it"
    if nodes[it].kind == .call and nkids(it) == 1 and nodes[kid(it, 0)].kind == .ident: it_name = name_of(int(nodes[kid(it, 0)].name))
    rt_dc_report(nodes[head].pos, "bind the iterator first, then loop over its place so the body can steer it: `let {it_name}=source` then `loop item in @{it_name} \{ ... }`")
    dc_parser.at += 1
    rt_dc_expr(11) != 0

# `a, b in` at `at`: names separated by commas, then `in`.

rt_dc_comma_names = (at: int) -> bool:
    k = at
    loop dc_parser.tokens[k].kind == .identifier and dc_parser.tokens[k + 1].symbol == .comma: k += 2
    k > at and dc_parser.tokens[k].kind == .identifier and dc_parser.tokens[k + 1].symbol == .kw_in

# `name in xs`, `@name in xs` (each element in place), `[a b] in xs` (unpacked), or a condition.

rt_dc_head_term = () -> int:
    head = mk(.lhead, mkpos(dc_parser.file, dc_parser.tokens[dc_parser.at].start))
    first = dc_parser.tokens[dc_parser.at].symbol
    place = first == .at
    at = dc_parser.at
    if place: at += 1
    # (`loop @[x] in xs`: dw_loop_head's mistake, noted; read as the pattern)
    if place and dc_parser.tokens[at].symbol == .lbrack and dc_parser.flags.report_now:
        rt_dc_unsupported(mkpos(dc_parser.file, dc_parser.tokens[at].start), "unpacking a mutable loop binding; use a named @item and its fields")
        place = false
        dc_parser.at += 1
    named = dc_parser.tokens[at].kind == .identifier and dc_parser.tokens[at].symbol == .none and dc_parser.tokens[at + 1].symbol == .kw_in
    # (`loop none in xs`: dw_loop_head's mistake)
    if named and rt_dn_reserved(int(dc_parser.tokens[at].name)): rt_dc_reserved_at(dc_parser.tokens[at])
    if not (named or dc_parser.tokens[at].symbol == .lbrack and not place):
        # (`loop k, v in pairs`: dw_loop_head's mistake, at once)
        if dc_parser.flags.report_now and rt_dc_comma_names(at): return rt_dc_fail_now(mkpos(dc_parser.file, dc_parser.tokens[at].start), "several loop names go in brackets: `loop [key value] in pairs \{ ... }`")
        saved_head = dc_parser.reader.dc_head_depth
        dc_parser.reader.dc_head_depth = dc_parser.depth + 1
        condition = rt_dc_expr(71)
        dc_parser.reader.dc_head_depth = saved_head
        # (`loop 1 in xs`: no name binds, dw_loop_head's mistake should nothing else read it)
        if condition == 0 and rt_dn_peek() == .kw_in: return rt_dc_hint(nodes[head].pos, "a loop binding needs a name or pattern: write `loop x in items \{ ... }`")
        if condition == 0: return 0
        # (`x in? xs`: a membership, a condition; `f(x) in xs` is no expression dc_expr reads)
        nodes[head].op = 4
        nodes[head].a = i32(condition)
        return head
    nodes[head].op = 1
    if place:
        add_flag(head, NF_MUT)
        dc_parser.at += 1
    binder_pos = mkpos(dc_parser.file, dc_parser.tokens[dc_parser.at].start)
    if named:
        value = mk(.ident, binder_pos)
        nodes[value].name = dw_value_name(dc_parser.tokens[dc_parser.at].name, binder_pos)
        dc_parser.at += 2
        set_list(head, [value])
    else:
        dc_parser.at += 1
        seen: int[]
        binders = rt_dc_binding_items(seen)
        if binders.len() == 0 or not rt_dn_accept(.kw_in): return 0
        # (one element still unpacks the iteration value)
        if binders.len() == 1:
            pattern = mk(.tuple, binder_pos)
            set_list(pattern, binders)
            binders = [pattern]
        set_list(head, binders)
    it = 0
    if place:
        # (in place: a name or a field route of one, read as it is; `loop @x in @xs`, dw_loop_head's
        # mistake should nothing else read it)
        if rt_dn_peek() == .at: return rt_dc_hint(nodes[head].pos, "`loop @item in @items` combines two places: iterate the live array by value (`loop item in @items`) or edit its elements in place (`loop @item in items`)")
        it = rt_dc_expr(96)
        if it == 0: return 0
        root = it
        loop nodes[root].kind == .field: root = int(nodes[root].a)
        if nodes[root].kind != .ident:
            if not dc_parser.flags.report_now: return 0
            rt_dc_unsupported(nodes[head].pos, "mutable iteration over this expression; use an array binding or a field of one")
    else if rt_dn_peek() == .at:
        # `loop x in @xs`: the place iterated live, one name bound (dw_live_loop)
        if not named:
            if not dc_parser.flags.report_now: return 0
            rt_dc_report(binder_pos, "a live loop (`in @items`) binds one name: bind the element, then unpack it in the body")
        live_at = dc_parser.at
        dc_parser.at += 1
        it = rt_dc_expr(dn_prefix_power(.at, false))
        if it == 0 or dn_power(rt_dn_peek()) >= 96: return 0
        root = it
        loop nodes[root].kind == .field: root = int(nodes[root].a)
        if nodes[root].kind != .ident: return 0
        dewy_live_sources[it] = true
        dc_parser.reader.dc_live_at_pos[head] = mkpos(dc_parser.file, dc_parser.tokens[live_at].start)
        dc_parser.reader.dn_edit_at.push(DN_EDIT_LIVE - it)
        dc_parser.reader.dn_edit_was.push(dc_parser.tokens[dc_parser.at - 1])
    else: it = rt_dc_iterable()
    if it == 0: return 0
    nodes[head].a = i32(it)
    head

# The names of an unpacking pattern after its `[`, through its `]` (dw_binding_items): names,
# `_`, nested patterns, a name's type (`x:int64`), a rest (`...rest`) or a drop (`...`); empty for
# any other item (a renaming, a default), which is left unread (dc_unread).

rt_dc_binding_items = (seen: mut int[], close: DewyToken = .rbrack) -> int[]:
    out: int[]
    opening = dc_parser.at - 1
    rests = 0
    rest = false        # (the next name collects what the others leave)
    plain = true        # (the last item takes a postfix `...`: a name or a nested pattern)
    last_pos = 0
    loop not rt_dn_accept(close):
        t = dc_parser.tokens[dc_parser.at]
        pos = mkpos(dc_parser.file, t.start)
        if t.symbol == .ellipsis:
            next = dc_parser.tokens[dc_parser.at + 1]
            if rest or not plain: return []
            if out.len() == 0:
                # (opening the pattern: dn_atom's `...` before a name or the closer)
                if close == .rbrack and not (next.symbol == .rbrack or next.kind == .identifier): return []
                if close == .rparen and not (next.symbol == .rparen or next.kind == .identifier and (dc_parser.tokens[dc_parser.at + 2].symbol == .colon or dc_parser.tokens[dc_parser.at + 2].kind == .identifier or dc_parser.tokens[dc_parser.at + 2].symbol == .rparen)): return []
            rests += 1
            # (dw_binding_items' mistake, noted)
            if rests > 1:
                if not dc_parser.flags.report_now: return []
                rt_dc_report(pos, "a pattern level has one `...`: the rest is what the other names leave")
            dc_parser.at += 1
            if not next.space and next.kind == .identifier:
                rest = true
                continue
            if next.symbol != close and not next.space: return []
            # (a drop: at the `...` opening the pattern, else at the item it follows)
            hole = mk(.hole, if out.len() == 0: pos else: last_pos)
            add_flag(hole, NF_SPREAD)
            out.push(hole)
            plain = false
            continue
        # (`banana as [x y]`: the field banana unpacked, dw_binding_one)
        renamed = 0
        if t.kind == .identifier and t.symbol == .none and dc_parser.tokens[dc_parser.at + 1].symbol == .kw_as and dc_parser.tokens[dc_parser.at + 2].symbol == .lbrack and not rt_dn_reserved(int(t.name)):
            if rest: return []
            renamed = int(t.name)
            dc_parser.at += 2
            t = dc_parser.tokens[dc_parser.at]
            pos = mkpos(dc_parser.file, t.start)
        if t.symbol == .lbrack:
            if rest: return []
            dc_parser.at += 1
            pattern = mk(.tuple, pos)
            if renamed != 0: nodes[pattern].sval = i32(renamed)
            inner = rt_dc_binding_items(seen)
            if inner.len() == 0: return []
            set_list(pattern, inner)
            out.push(pattern)
            plain = true
            last_pos = pos
            # (`[[x]:array<int64>]`: dw_binding_one's mistake, noted; the type read)
            if rt_dn_peek() == .colon and close == .rbrack and dc_parser.flags.report_now and rt_dc_annotated_pattern(pos) == 0: return []
            continue
        if t.kind != .identifier or t.symbol != .none: return []
        # (the mistakes dw_binding_one reports: a default, a reserved word)
        if dc_parser.tokens[dc_parser.at + 1].symbol == .assign and not dc_parser.tokens[dc_parser.at + 1].space: fatal(pos, "`=` in a pattern is reserved for defaults, which are not implemented; rename a field with `as`: `[field as name] = record`")
        if rt_dn_reserved(int(t.name)):
            dewy_reserved_name(name_of(int(t.name)), pos)
            return []
        dc_parser.at += 1
        annotation = 0
        if rt_dn_peek() == .colon:
            dc_parser.at += 1
            saved_rename = dc_parser.reader.dc_rename_follows
            dc_parser.reader.dc_rename_follows = true
            annotation = rt_dc_annotation(45)
            dc_parser.reader.dc_rename_follows = saved_rename
            if annotation == 0: return []
        # `apple as a`, `apple:int64 as a`: the field apple bound as a (dw_binding_one's renaming)
        source = 0
        if rt_dn_peek() == .kw_as:
            target = dc_parser.tokens[dc_parser.at + 1]
            if rest or target.kind != .identifier or target.symbol != .none or rt_dn_reserved(int(target.name)): return []
            source = int(t.name)
            t = target
            pos = mkpos(dc_parser.file, t.start)
            dc_parser.at += 2
        after = dc_parser.tokens[dc_parser.at]
        # (`[a... b]`: dw_binding_items' mistake, noted; read as a drop)
        if after.symbol == .ellipsis and not after.space and annotation == 0 and source == 0 and not rest and dc_parser.flags.report_now:
            rt_dc_report(pos, "in a pattern, the rest is written before its name: `[first ...{rt_dn_payload(t)}]` (`...` alone drops it)")
            after = dc_parser.tokens[dc_parser.at + 1]
            if after.space or after.symbol == close: dc_parser.at += 1
        if not after.space and after.symbol != close: return []
        hole = rt_dc_word(int(t.name)) == DC_HOLE
        if not hole:
            if seen.contains(int(t.name)):
                if source == 0: fatal(pos, "duplicate unpacking name '{name_of(int(t.name))}'")
                return []
            seen.push(int(t.name))
        n = mk(if hole: NK.hole else: NK.ident, pos)
        nodes[n].name = t.name
        nodes[n].a = i32(annotation)
        if source != 0: nodes[n].sval = i32(source)
        if rest: add_flag(n, NF_SPREAD)
        rest = false
        out.push(n)
        plain = annotation == 0 and source == 0
        last_pos = pos
    if rest: return []
    if out.len() == 0 or out.len() == 1 and nodes[out[0]].kind == .hole and has_flag(out[0], NF_SPREAD): return rt_dc_binds_nothing(out, opening, close)
    out

# `[]`, `[...]`: a pattern binding nothing (dw_binding_items' mistakes, noted; the pattern kept).

rt_dc_binds_nothing = (out: int[], opening: int, close: DewyToken) -> int[]:
    if not dc_parser.flags.report_now or close != .rbrack: return []
    pos = mkpos(dc_parser.file, dc_parser.tokens[opening].start)
    if out.len() == 0:
        rt_dc_unsupported(pos, "an empty unpacking target")
        return [mk(.hole, pos)]
    rt_dc_report(pos, "this pattern binds nothing: to run the value and drop it, attach `;`, as in `f();`")
    out

# `[[x]:T]` at the `:`: noted, its type read; 0 when that type is left unread (dc_unread).

rt_dc_annotated_pattern = (pos: int) -> int:
    rt_dc_unsupported(pos, "an annotated nested pattern; annotate its names or the whole declaration")
    dc_parser.at += 1
    rt_dc_annotation(45)

# `if x > 3 {`, `loop { ... }` then no body (dn_flow's mistakes, at once): the condition's next token
# starts no body; 0 where the condition reads on (`:`).

rt_dc_no_body = (keyword: DewyLexeme, n: int, head: int) -> int:
    if not dc_parser.flags.report_now: return 0
    next = rt_dn_peek()
    if next == .colon: return 0
    braced = keyword.symbol == .kw_loop and nodes[head].op == 4 and nodes[int(nodes[head].a)].kind == .block and dc_parser.tokens[dc_parser.at - 1].symbol == .rbrace and dc_parser.tokens[rt_dc_open_brace(dc_parser.at - 1)].start == pos_off(nodes[int(nodes[head].a)].pos)
    if braced: dn_error(dc_parser.tokens[dc_parser.at].start, "expected a body after this loop's condition: a loop is `loop condition body`, so a loop that runs until `break` or `return` is `loop true \{ ... }`")
    habit = ""
    if next == .gt or next == .lt or next == .rangle or next == .ge or next == .le: habit = " (comparisons end with `?`: `x >? y`, `x <=? y`)"
    dn_error(dc_parser.tokens[dc_parser.at].start, "expected a body after '{dn_token_text(keyword.symbol)}'{habit}")

# `if c: ...` (dn_flow's mistake, at once): the condition goes on through the `:` and its type, and
# no body follows; 0 where one does.

rt_dc_colon_body = (keyword: DewyLexeme) -> int:
    if not dc_parser.flags.report_now: return 0
    dc_parser.at += 1
    if rt_dc_expr(46) == 0 or dn_can_start(dc_parser.tokens, dc_parser.at): return 0
    next = rt_dn_peek()
    habit = " (a condition takes no colon: its body goes in braces, `{dn_token_text(keyword.symbol)} x >? 3 \{ ... }`)"
    if next == .gt or next == .lt or next == .rangle or next == .ge or next == .le: habit = " (comparisons end with `?`: `x >? y`, `x <=? y`)"
    dn_error(dc_parser.tokens[dc_parser.at].start, "expected a body after '{dn_token_text(keyword.symbol)}'{habit}")

# The `{` the `}` at `at` closes.

rt_dc_open_brace = (at: int) -> int:
    depth = 0
    k = at
    loop k > 0:
        t = dc_parser.tokens[k].symbol
        if t == .rbrace or t == .rbrack or t == .rparen: depth += 1
        if t == .lbrace or t == .lbrack or t == .lparen:
            depth -= 1
            if depth == 0: return k
        k -= 1
    0

rt_dc_loop_body_warning = ():
    warn(mkpos(dc_parser.file, dc_parser.tokens[dc_parser.at].start), "this line is the body of the loop above, whose block is its condition: a loop is `loop condition body`, so a loop that runs until `break` or `return` is `loop true \{ ... }`; to keep this meaning, start the body on the condition's line")

rt_dc_flow = () -> int:
    dc_parser.depth += 1
    if dc_parser.depth + dc_parser.reader.dn_depth > 256: return 0
    token = rt_dn_take()
    if token.symbol == .kw_match:
        n = rt_dc_match(token)
        if n != 0: dc_parser.depth -= 1
        return n
    if token.symbol != .kw_if and token.symbol != .kw_loop: return 0
    start = dc_parser.at - 1
    pos = mkpos(dc_parser.file, token.start)
    n = mk(.if_, pos)
    head = 0
    fold = -1
    if token.symbol == .kw_loop:
        braced = rt_dn_peek() == .lbrace
        head = rt_dc_loop_head()
        if head == 0: return 0
        # (`loop { ... }` then a new line: the block is the condition and the next line the body)
        if braced and nodes[head].op == 4 and nodes[int(nodes[head].a)].kind == .block and dc_parser.tokens[dc_parser.at - 1].symbol == .rbrace and dc_parser.tokens[dc_parser.at].newline and dn_can_start(dc_parser.tokens, dc_parser.at): rt_dc_loop_body_warning()
    else:
        saved_condition = dc_parser.reader.dc_condition_depth
        dc_parser.reader.dc_condition_depth = dc_parser.depth + 1
        condition_at = dc_parser.at
        condition = rt_dc_expr(0)
        dc_parser.reader.dc_condition_depth = saved_condition
        if condition == 0:
            # (`if x = 2`: the condition's value ends at `=`; a range it does not take leaves the cursor at -1)
            if dc_parser.at > condition_at and rt_dn_peek() == .assign: return rt_dc_condition_assign(condition_at)
            return 0
        if rt_dn_peek() == .colon: return rt_dc_colon_body(token)
        nodes[n].a = i32(condition)
        # (`if $target.os =? "windows" a else b`: one arm is compiled, dw_flow's dw_target_condition)
        if dc_parser.reader.dc_targets_made > 0:
            fold = rt_dc_target_fold(condition)
            if fold == -2: return 0
    if not dn_can_start(dc_parser.tokens, dc_parser.at): return rt_dc_no_body(token, n, head)
    if fold >= 0 and rt_dc_unsafe_at(dc_parser.at): return 0
    body = rt_dc_body()
    if body == 0: return 0
    nodes[n].b = i32(body)
    alternative = 0
    rest = 0
    rest_live = true
    if rt_dn_accept(.kw_else):
        if rt_dn_peek() == .kw_if or rt_dn_peek() == .kw_match:
            rest_at = dc_parser.at
            saved_dropping = dc_parser.reader.dc_dropping
            if fold == 1: dc_parser.reader.dc_dropping += 1
            rest = rt_dc_flow()
            dc_parser.reader.dc_dropping = saved_dropping
            if rest == 0: return 0
            rest_live = dc_parser.reader.dc_live_at == rest_at
            # (a folded chain's value is its compiled arm's body, a block itself: dw_flow)
            if nodes[rest].kind == .block: alternative = rest
            else:
                alternative = mk(.block, pos)
                set_list(alternative, [rt_dc_flow_stmt(rest)])
        else:
            if fold >= 0 and rt_dc_unsafe_at(dc_parser.at): return 0
            alternative = rt_dc_body()
            if alternative == 0: return 0
        nodes[n].c = i32(alternative)
    if fold >= 0:
        # (the arms left out are read, never checked: the names they use are noted)
        value = 0
        # (a false test's names too: dw_target_splice notes the whole arm)
        if fold == 0 or dc_parser.reader.dc_dropping > 0: rt_dc_target_dropped(int(nodes[n].a))
        if fold == 1:
            if alternative != 0: rt_dc_target_dropped(alternative)
            value = body
        else:
            rt_dc_target_dropped(body)
            if rest != 0:
                if nodes[rest].kind == .match_: return 0
                value = rest
            else if alternative != 0: value = alternative
            else: value = mk(.block, pos)
        dc_parser.reader.dc_live_at = if fold == 1 or rest_live: start else: -1
        dc_parser.depth -= 1
        return value
    if dc_parser.reader.dc_live_at == start: dc_parser.reader.dc_live_at = -1
    if head != 0:
        if alternative != 0:
            nodes[n].kind = .loopx
            nodes[n].a = i32(head)
        else if nodes[head].op == 1:
            nodes[n].kind = .for_
            nodes[n].a = nodes[head].a
            if has_flag(head, NF_MUT): add_flag(n, NF_MUT)
            set_list(n, kids(head))
        else if nodes[head].op == 4:
            nodes[n].kind = .while_
            nodes[n].a = nodes[head].a
        else:
            nodes[n].kind = .loopx
            nodes[n].a = i32(head)
    dc_parser.depth -= 1
    n

# `[parallel @x in xs x]`: a place as a comprehension's binding (dw_parallel's mistake, should nothing
# else read it).

rt_dc_parallel_place = (binder: DewyLexeme) -> int:
    source = dc_parser.tokens[dc_parser.at + 2]
    iterable = "..."
    if source.kind == .identifier and source.symbol == .none: iterable = rt_dn_payload(source)
    rt_dc_hint(mkpos(dc_parser.file, binder.start), "parallel comprehension bindings are values: write `parallel {rt_dn_payload(binder)} in {iterable} ...`")

# `parallel x in xs body`, `parallel @x in xs body` after its keyword; `collect`, a comprehension's
# (`[parallel x in xs f(x)]`): the region dw_parallel makes. A form it reports is left unread
# (dc_unread).

rt_dc_parallel = (token: DewyLexeme, collect: bool) -> int:
    pos = mkpos(dc_parser.file, token.start)
    mutable = rt_dn_accept(.at)
    binder = dc_parser.tokens[dc_parser.at]
    # (`parallel true {}`: dw_parallel's mistake)
    if not mutable and dc_parser.tokens[dc_parser.at + 1].symbol != .kw_in and binder.symbol != .lparen and dc_parser.flags.report_now: return rt_dc_fail_now(mkpos(dc_parser.file, binder.start), "Dewy does not yet support a parallel loop without one bounded iterable")
    if binder.kind != .identifier or binder.symbol != .none or dc_parser.tokens[dc_parser.at + 1].symbol != .kw_in: return 0
    # (`[parallel @x in xs x]`: dw_parallel's mistake, should nothing else read it)
    if collect and mutable and not rt_dn_reserved(int(binder.name)): return rt_dc_parallel_place(binder)
    if collect and mutable: return 0
    if rt_dn_reserved(int(binder.name)): rt_dc_reserved_at(binder)
    dc_parser.at += 2
    source = rt_dc_expr(dn_power(.kw_in) + 1)
    if source == 0 or dn_power(rt_dn_peek()) > 0 or rt_dn_peek() == .kw_not or not dn_can_start(dc_parser.tokens, dc_parser.at): return 0
    param = mk(.param, mkpos(dc_parser.file, binder.start))
    nodes[param].name = binder.name
    saved_unread = dc_parser.flags.unread_here
    saved_result = dc_parser.reader.dc_fn_result
    dc_parser.flags.unread_here = false
    dc_parser.reader.dc_fn_result = if collect: 1 else: 0
    saved_map = dc_parser.reader.dc_map_ok
    dc_parser.reader.dc_map_ok = false
    body = rt_dc_body()
    dc_parser.reader.dc_map_ok = saved_map
    dc_parser.reader.dc_fn_result = saved_result
    dc_parser.flags.unread_here = saved_unread
    if body == 0 or rt_dn_peek() == .kw_else: return 0
    if not rt_dc_parallel_exits(body, 0):
        # (dw_parallel_exits' mistakes, at once)
        if not dc_parser.flags.report_now: return 0
        rt_dc_flush_report()
        dw_parallel_exits(body, 0)
    fn_ = mk(.lambda, pos)
    add_flag(fn_, NF_LANG_BODY)
    if not collect and not mutable: add_flag(fn_, NF_VOID)
    if mutable:
        ret = mk(.return_, pos)
        nodes[ret].a = i32(bc_ident(name_of(int(binder.name)), pos))
        statements = kids(body)
        statements.push(ret)
        set_list(body, statements)
        add_flag(source, NF_MUT)
        dw_finish_function(fn_, [param], body, "")
    else:
        set_list(fn_, [param])
        nodes[fn_].b = i32(body)
    call = bc_call(if mutable: "parallel_update" else if collect: "__dewy_parallel_collect" else: "__dewy_parallel_each", [source, fn_], pos)
    region = mk(.parallel_region, pos)
    nodes[region].a = i32(call)
    if collect: return region
    statement = mk(.exprstmt, pos)
    nodes[statement].a = i32(region)
    add_flag(statement, NF_STMT)
    statement

# No `return` leaves a parallel body, nor a `break` or `continue` outside a loop in it
# (dw_parallel_exits reports them).

rt_dc_parallel_exits = (n: int, depth: int) -> bool:
    if n <= 0 or nodes[n].kind == .lambda or nodes[n].kind == .fn_: return true
    k = nodes[n].kind
    if k == .return_ or (k == .break_ or k == .continue_) and depth == 0: return false
    inner = depth
    if k == .for_ or k == .while_ or k == .loopx: inner += 1
    if not rt_dc_parallel_exits(int(nodes[n].a), depth) or not rt_dc_parallel_exits(int(nodes[n].b), inner) or not rt_dc_parallel_exits(int(nodes[n].c), depth): return false
    loop child in kids(n):
        if not rt_dc_parallel_exits(child, depth): return false
    true

# `[loop ... ]` after its `[`: the loop collects the values its bodies end with (dw_comprehension);
# `key -> value` entries make a dictionary. A parallel or record comprehension is read
# elsewhere.

rt_dc_comprehension = () -> int:
    pos = mkpos(dc_parser.file, dc_parser.tokens[dc_parser.at].start)
    saved_map = dc_parser.reader.dc_map_ok
    made = dc_parser.reader.dc_pairs_made - dc_parser.collection.pairs_collected
    dc_parser.reader.dc_map_ok = true
    flow = rt_dc_flow()
    dc_parser.reader.dc_map_ok = saved_map
    if flow == 0: return 0
    if not rt_dn_accept(.rbrack): return rt_dc_row_outside(flow)
    # (`[loop f in fields(T) $field(f.name)=x.$field(f.name)]`: a record's rows, dw_record_loop)
    if rt_dc_record_tail(flow): return rt_dc_record_loop(flow)
    add_flag(flow, NF_STMT)
    accumulator = intern("$dewy_collection_{nodes.len()}")
    decl = mk(.vardecl, pos)
    nodes[decl].name = i32(accumulator)
    nodes[decl].b = i32(mk(.array, pos))
    map = rt_dc_tail_kind(flow) == 2
    # (dw_collection_kind's mistake, noted where it finds it; each value then collected as it is)
    mixed = rt_dc_mixed_at(flow)
    if mixed != 0:
        if not dc_parser.flags.report_now: return 0
        rt_dc_report(mixed, "a comprehension cannot mix array elements and dictionary entries")
    saved_mixed = dc_parser.collection.mixed
    dc_parser.collection.mixed = mixed != 0
    collected = rt_dc_collect(flow, accumulator, map)
    dc_parser.collection.mixed = saved_mixed
    if collected == 0 or dc_parser.reader.dc_pairs_made - dc_parser.collection.pairs_collected != made: return 0
    result = mk(.exprstmt, pos)
    value = mk(.ident, pos)
    nodes[value].name = i32(accumulator)
    nodes[result].a = i32(value)
    block = mk(.block, pos)
    set_list(block, [decl, flow, result])
    add_flag(block, NF_COMPREHENSION)
    if not map: return block
    callee = mk(.ident, pos)
    nodes[callee].name = i32(intern("__map_of"))
    call = mk(.call, pos)
    nodes[call].a = i32(callee)
    set_list(call, [block])
    call

# (`[loop i in xs $field("a")=i 3]`, `[loop x in xs x -> 1 2]`: a computed row or an entry among
# other elements, dw_metatag_fail's or dw_expr's mistake, should nothing else read it)

rt_dc_row_outside = (flow: int) -> int:
    last = rt_dc_tail_value(flow)
    if last == 0: return 0
    if nodes[last].kind == .namedarg: return rt_dc_hint(nodes[last].pos, metatag_fail_text("field"))
    if nodes[last].kind == .pair: return rt_dc_hint(nodes[last].pos, "a dictionary comprehension emits one `key -> value` pair per iteration")
    0

# (the value of a flow's last statement, through its loops and blocks; 0 for none)

rt_dc_tail_value = (n: int) -> int:
    k = nodes[n].kind
    if k == .for_ or k == .while_ or k == .loopx or k == .if_: return rt_dc_tail_value(int(nodes[n].b))
    if k == .block:
        if nkids(n) == 0: return 0
        return rt_dc_tail_value(kid(n, nkids(n) - 1))
    if k == .exprstmt: return int(nodes[n].a)
    0

# A comprehension's last value is a computed row (dw_collection_kind 3).

rt_dc_record_tail = (n: int) -> bool:
    last = rt_dc_tail_value(n)
    last != 0 and nodes[last].kind == .namedarg

# A record comprehension's loops, each one binder, down to its one row (dw_record_loop); 0 for a
# shape is left unread (dc_unread).

rt_dc_record_loop = (n: int) -> int:
    k = nodes[n].kind
    if k == .for_:
        if nkids(n) != 1 or nodes[kid(n, 0)].kind != .ident or nodes[n].c != 0 or has_flag(n, NF_MUT): return 0
        body = rt_dc_record_loop(int(nodes[n].b))
        if body == 0: return 0
        loop_ = mk(.record_loop, nodes[n].pos)
        nodes[loop_].a = nodes[n].a
        nodes[loop_].name = nodes[kid(n, 0)].name
        nodes[loop_].b = i32(body)
        return loop_
    if k == .block:
        if nkids(n) != 1: return 0
        return rt_dc_record_loop(kid(n, 0))
    if k == .exprstmt and nodes[int(nodes[n].a)].kind == .namedarg: return int(nodes[n].a)
    0

# What a comprehension's first collected value is (dw_collection_kind): 1 a value, 2 a dictionary
# entry, 0 none.

rt_dc_tail_kind = (statement: int) -> int:
    dr_tail_kind(nodes, lists, statement)

rt_dc_block_tail_kind = (block: int) -> int:
    dr_block_tail_kind(nodes, lists, block)


# A comprehension's statement collecting into `accumulator` (dw_collect): a value is pushed (a
# call's own values, as its sink gives them), an entry of a dictionary (`map`) as its pair, a
# flow collects in each body, a `{ ... }` value in its last statement; other statements collect
# nothing. 0: a form collected another way.

rt_dc_collect = (statement: int, accumulator: int, map: bool = false) -> int:
    dr_collect(dc_parser.collection, nodes, lists, dw_builder_host, statement, accumulator, map)

# `accumulator.push(value)`

rt_dc_push = (accumulator: int, value: int, pos: int) -> int:
    dr_push(nodes, lists, dw_builder_host, accumulator, value, pos)

# Where a comprehension's flow mixes elements and entries, as dw_collection_kind finds it: the first
# arm body whose kind differs from those before it among its flow's arms (an `else if` chain's or
# an `else match`'s arms are one flow's); 0 for none.

rt_dc_kind_of = (statement: int) -> int:
    dr_kind_of(dc_parser.collection, nodes, lists, statement)

# A flow's arm bodies: an `else if` or `else match` goes on the same flow (dc_flow's block at the
# chain's own position).

rt_dc_flow_arms = (flow: int, arms: mut int[]):
    dr_flow_arms(nodes, lists, flow, arms)

rt_dc_arms_kind = (arms: int[]) -> int:
    dr_arms_kind(dc_parser.collection, nodes, lists, arms)

rt_dc_last_kind = (block: int) -> int:
    dr_last_kind(dc_parser.collection, nodes, lists, block)

rt_dc_collect_block = (block: int, accumulator: int, map: bool) -> bool:
    dr_collect_block(dc_parser.collection, nodes, lists, dw_builder_host, block, accumulator, map)

# A lambda opens here: a name then `=>`, or a parenthesized list then `=>` or `:>`.

rt_dc_lambda_next = () -> bool: rt_dc_lambda_next_at(dc_parser.at)

rt_dc_lambda_next_at = (start: int) -> bool:
    dn_at_saved = dc_parser.at
    dc_parser.at = start
    yes = rt_dc_lambda_opens()
    dc_parser.at = dn_at_saved
    yes

rt_dc_lambda_opens = () -> bool:
    if dc_parser.tokens[dc_parser.at].kind == .identifier: return (dc_parser.tokens[dc_parser.at].symbol == .none or dc_parser.tokens[dc_parser.at].symbol == .kw_test) and dc_parser.tokens[dc_parser.at + 1].symbol == .function
    if dc_parser.tokens[dc_parser.at].symbol != .lparen: return false
    next = dc_parser.tokens[dc_parser.at + 1].symbol
    if not (next == .rparen or next == .at or next == .langle and dc_parser.tokens[dc_parser.at + 2].kind == .identifier and dc_parser.tokens[dc_parser.at + 3].symbol == .colon or next == .lbrack or next == .lparen or next == .ellipsis or dc_parser.tokens[dc_parser.at + 1].kind == .metatag or dc_parser.tokens[dc_parser.at + 1].kind == .identifier and (dc_parser.tokens[dc_parser.at + 2].symbol == .colon or dc_parser.tokens[dc_parser.at + 2].symbol == .rparen or dc_parser.tokens[dc_parser.at + 2].kind == .identifier or dc_parser.tokens[dc_parser.at + 2].symbol == .assign)): return false
    depth = 0
    at = dc_parser.at
    loop at < dc_parser.tokens.len():
        symbol = dc_parser.tokens[at].symbol
        if dc_parser.tokens[at].kind == .eof: return false
        if symbol == .lparen: depth += 1
        if symbol == .rparen:
            depth -= 1
            if depth == 0: break
        at += 1
    after = dc_parser.tokens[at + 1].symbol
    after == .function or after == .returns

# `<T U>(params) =>` opens here.

rt_dc_generic_lambda_next = () -> bool: rt_dc_generic_lambda_next_at(dc_parser.at)

rt_dc_generic_lambda_next_at = (start: int) -> bool:
    at = start + 1
    loop dc_parser.tokens[at].kind == .identifier and dc_parser.tokens[at].symbol == .none: at += 1
    at > start + 1 and dc_parser.tokens[at].symbol == .rangle and dc_parser.tokens[at + 1].symbol == .lparen and not dc_parser.tokens[at + 1].space and rt_dc_lambda_next_at(at + 1)

rt_dc_none_type = () -> int:
    if dc_parser.reader.dc_none_id == 0: dc_parser.reader.dc_none_id = intern("none")
    dc_parser.reader.dc_none_id

rt_dc_empty_name = () -> int:
    if dc_parser.reader.dc_empty_id < 0: dc_parser.reader.dc_empty_id = intern("")
    dc_parser.reader.dc_empty_id

# A `match` in a block is a statement holding it (dw_flow_stmt).

rt_dc_flow_stmt = (n: int) -> int:
    if nodes[n].kind != .match_: return n
    s = mk(.exprstmt, nodes[n].pos)
    nodes[s].a = i32(n)
    s

# `match value { pattern => body ... }`, or one arm without braces, then an optional
# `else`, after its keyword: as dw_match and dw_flow make it. Patterns are a name, `_`,
# `name:T` or `<literal>`; shapes, sequences, byte and refined patterns
# too.

rt_dc_match = (token: DewyLexeme) -> int:
    pos = mkpos(dc_parser.file, token.start)
    n = mk(.match_, pos)
    first = dc_parser.at
    scrutinee = rt_dc_expr(0)
    if scrutinee == 0 or not dn_can_start(dc_parser.tokens, dc_parser.at): return 0
    # (`match (x y)`: a sequence of values, each read once, dw_match)
    if nodes[scrutinee].kind == .tuple and nodes[scrutinee].aux == i32(TUPLE_VALUES) and dc_parser.tokens[first].symbol == .lparen and rt_dc_closing(first) == dc_parser.at - 1:
        loop item in kids(scrutinee):
            if has_flag(item, NF_SPREAD): return 0
        nodes[scrutinee].aux = 0
    nodes[n].a = i32(scrutinee)
    arms: int[]
    opening = dc_parser.tokens[dc_parser.at]
    if rt_dn_accept(.lbrace):
        loop not rt_dn_accept(.rbrace):
            if dc_parser.tokens[dc_parser.at].kind == .eof: return 0
            arm = rt_dc_arm()
            if arm == 0: return 0
            arms.push(arm)
        # (`let n = match x {...}; n`: `;` ends the statement the match is the value of; `{...} + 1`
        # is no arm, dw_arm_fail's mistake should nothing else read it)
        if not rt_dc_flow_ends() and rt_dn_peek() != .semi: return rt_dc_hint(mkpos(dc_parser.file, opening.start), "Dewy does not yet support a match arm without =>")
    else:
        arm = rt_dc_arm()
        if arm == 0: return 0
        arms.push(arm)
    if rt_dn_accept(.kw_else):
        rest = 0
        if rt_dn_peek() == .kw_if or rt_dn_peek() == .kw_match:
            rest = rt_dc_flow()
            if rest == 0 or nodes[rest].kind == .block: return 0
            block = mk(.block, nodes[rest].pos)
            set_list(block, [rt_dc_flow_stmt(rest)])
            rest = block
        else:
            rest = rt_dc_body()
            if rest == 0: return 0
        fallback = mk(.arm, nodes[rest].pos)
        set_list(fallback, [mk(.pwild, nodes[rest].pos)])
        nodes[fallback].b = i32(rest)
        arms.push(fallback)
    set_list(n, arms)
    n

# Nothing continues the expression a braced body or an arm ends (it would apply to that body or
# arm).

rt_dc_flow_ends = () -> bool:
    t = dc_parser.tokens[dc_parser.at]
    if t.kind == .eof: return true
    if dn_power(t.symbol) > 0 or t.symbol == .semi or t.symbol == .dot or t.symbol == .question or t.symbol == .ellipsis or t.symbol == .kw_or_throw: return false
    t.space or t.newline or t.symbol == .rbrace or t.symbol == .rparen or t.symbol == .rbrack or t.symbol == .kw_else

# `pattern => body`: an arm; an unbraced body ends where `=>`'s operand ends.

rt_dc_arm = () -> int:
    first = dc_parser.tokens[dc_parser.at]
    pattern = rt_dc_pattern()
    if pattern == 0: return 0
    if not rt_dn_accept(.function): return rt_dc_arm_arrow(first)
    arm = mk(.arm, mkpos(dc_parser.file, first.start))
    set_list(arm, [pattern])
    body = rt_dc_operand_body()
    if body == 0: return 0
    # (`n:int64 => total = n`: dw_arm_fail's mistake, noted; the value read on)
    if (rt_dn_peek() == .assign or dn_token_assignment(rt_dn_peek())) and dc_parser.flags.report_now:
        rt_dc_report(nodes[arm].pos, "an arm whose body assigns needs braces, `pattern => \{target = value}`: `=` binds more loosely than `=>`, so without them the whole arm is the assignment's target")
        dc_parser.at += 1
        if rt_dc_expr(11) == 0: return 0
    if not rt_dc_flow_ends(): return 0
    nodes[arm].b = i32(body)
    arm

# `if x = 2 { ... }`: an assignment as the condition (dw_flow's mistake, should nothing else read it),
# the condition as written again with `=?` when it ends on its line at a `{`.

rt_dc_condition_assign = (start: int) -> int:
    pos = mkpos(dc_parser.file, dc_parser.tokens[start].start)
    k = dc_parser.at + 1
    loop dc_parser.tokens[k].kind != .eof and dc_parser.tokens[k].symbol != .lbrace and not dc_parser.tokens[k].newline: k += 1
    if k == dc_parser.at + 1 or dc_parser.tokens[k].symbol != .lbrace or dc_parser.tokens[k].newline: return rt_dc_hint(pos, "a condition compares with `=?`, not `=`")
    src = files[dc_parser.file].src
    left = src[dc_parser.tokens[start].start..dc_parser.tokens[dc_parser.at - 1].stop)
    right = src[dc_parser.tokens[dc_parser.at + 1].start..dc_parser.tokens[k - 1].stop)
    rt_dc_hint(pos, "a condition compares with `=?`: write `if {left} =? {right} \{ ... }`")

# `<1> -> 2`, `<1> 2`: a pattern without its `=>` (dw_arm_fail's mistake, should nothing else read
# it), the arm as written again when its body is one token.

rt_dc_arm_arrow = (first: DewyLexeme) -> int:
    pos = mkpos(dc_parser.file, first.start)
    if rt_dn_peek() == .arrow: return rt_dc_hint(pos, "a match arm uses `=>`: replace `->` with `=>`")
    if not dn_can_start(dc_parser.tokens, dc_parser.at): return 0
    src = files[dc_parser.file].src
    body = dc_parser.tokens[dc_parser.at]
    after = dc_parser.tokens[dc_parser.at + 1]
    if body.newline or not (after.symbol == .rbrace or after.newline or after.kind == .eof): return rt_dc_hint(pos, "a match arm needs `=>` after its pattern")
    pattern = src[first.start..dc_parser.tokens[dc_parser.at - 1].stop)
    value = src[body.start..body.stop)
    rt_dc_hint(pos, "a match arm needs `=>`: write `{pattern} => {value}`")

# The right operand of `=>` as a block (dw_block): braced, or one statement.

rt_dc_operand_body = () -> int:
    first = dc_parser.at
    opening = dc_parser.tokens[dc_parser.at]
    if opening.symbol == .lbrace or opening.kind == .metatag and dc_parser.tokens[dc_parser.at + 1].symbol == .lbrace: return rt_dc_body()
    statement = 0
    if opening.symbol == .kw_concurrent:
        # (a statement: the group expresses nothing, dw_stmt)
        dc_parser.at += 1
        statement = rt_dc_concurrent(opening, true)
        if statement == 0: return 0
    else if opening.symbol == .kw_if or opening.symbol == .kw_match or opening.symbol == .kw_loop:
        statement = rt_dc_flow()
        if statement == 0: return 0
        # (a chain folding to its compiled arm: that arm's statements, dw_block's dw_target_splice)
        if dc_parser.reader.dc_live_at == first and opening.symbol == .kw_if:
            if dc_parser.collection.tagged_last.has(statement): return 0
            spliced = mk(.block, mkpos(dc_parser.file, opening.start))
            set_list(spliced, kids(statement))
            return spliced
        add_flag(statement, NF_STMT)
        statement = rt_dc_flow_stmt(statement)
    else if opening.symbol == .kw_return or opening.symbol == .kw_break or opening.symbol == .kw_continue:
        # (`=> return x`: the statement, dn_stmt within the operand)
        statement = rt_dc_statement()
        if statement == 0: return 0
    else if opening.symbol == .lparen and rt_dc_update_next():
        statement = rt_dc_grouped_update()
        if statement == 0: return 0
    else:
        value = rt_dc_expr(30)
        if value == 0: return 0
        # (`=> $unsafe f()`: the statement is its operand's, dw_stmt)
        written = opening.start
        if rt_dc_unsafe_at(first): written = dc_parser.tokens[first + 1].start
        statement = mk(.exprstmt, mkpos(dc_parser.file, written))
        nodes[statement].a = i32(value)
    body = mk(.block, mkpos(dc_parser.file, opening.start))
    set_list(body, [statement])
    body

# A name binds (`_` nothing), `name:T` tests a type, `<literal>` a value (dw_pattern).

rt_dc_pattern = () -> int:
    token = dc_parser.tokens[dc_parser.at]
    pos = mkpos(dc_parser.file, token.start)
    # (`else => ...` inside the braces: dw_pattern's mistake, noted; read as `_`)
    if token.symbol == .kw_else and dc_parser.tokens[dc_parser.at + 1].symbol == .function and dc_parser.flags.report_now:
        rt_dc_report(pos, "`else` follows the arms, outside the braces: `match v \{...} else ...`; as an arm, `_ => ...` matches everything left")
        dc_parser.at += 1
        return mk(.pwild, pos)
    if token.symbol == .langle:
        dc_parser.at += 1
        literal = dc_parser.tokens[dc_parser.at]
        # `<b'x'>`: a byte (dw_byte_char)
        quote = dc_parser.tokens[dc_parser.at + 1]
        if literal.kind == .identifier and literal.symbol == .none and rt_dc_word(int(literal.name)) == DC_B and quote.kind == .quoted and not quote.space:
            if files[dc_parser.file].src[quote.start] != '\'' or not rt_dc_plain_quote(quote): return 0
            text = rt_dn_string(quote)
            if text == 0 or len(name_of(int(nodes[text].sval))) != 1: return 0
            dc_parser.at += 2
            if not rt_dn_accept(.rangle): return 0
            p = mk(.plit, pos)
            nodes[p].a = i32(bc_int(int(name_of(int(nodes[text].sval))[0]), pos))
            return p
        # `<Busy>`, `<int64|string>`, `<'e'|'w'>`: a type (dw_pattern's `<>`)
        if literal.kind == .identifier and literal.symbol == .none and int(literal.name) != dc_parser.reader.dn_none_id or literal.kind == .quoted and dc_parser.tokens[dc_parser.at + 1].symbol == .pipe:
            dc_parser.reader.dc_type_args += 1
            t = rt_dc_annotation()
            dc_parser.reader.dc_type_args -= 1
            if t == 0: return 0
            if not rt_dn_accept(.rangle):
                if not (dc_parser.reader.dn_edits_on and rt_dn_closer_joined()): return 0
                rt_dn_split_closer()
            p = mk(.ptype, pos)
            nodes[p].a = i32(t)
            return p
        # `<0|1|2>`, `<-1|1>`: integer singletons, a type (dw_literal_type)
        leaf = rt_dc_int_leaf(dc_parser.at)
        if leaf > 0 and dc_parser.tokens[dc_parser.at + leaf].symbol == .pipe:
            dc_parser.reader.dc_type_args += 1
            t = rt_dc_annotation()
            dc_parser.reader.dc_type_args -= 1
            if t == 0: return 0
            if not rt_dn_accept(.rangle):
                if not (dc_parser.reader.dn_edits_on and rt_dn_closer_joined()): return 0
                rt_dn_split_closer()
            p = mk(.ptype, pos)
            nodes[p].a = i32(t)
            return p
        negative = literal.symbol == .minus
        if negative: literal = dc_parser.tokens[dc_parser.at + 1]
        integer = literal.kind == .source_integer or literal.kind == .integer
        if not integer and (negative or not (literal.kind == .boolean or literal.kind == .identifier and literal.symbol == .none and int(literal.name) == dc_parser.reader.dn_none_id or literal.kind == .quoted and rt_dc_plain_quote(literal))): return 0
        before = dc_parser.at
        dc_parser.reader.dn_angles += 1
        value = rt_dc_expr(0)
        dc_parser.reader.dn_angles -= 1
        if value == 0 or dc_parser.at != before + (if negative: 2 else: 1) or not rt_dn_accept(.rangle): return 0
        p = mk(.plit, pos)
        nodes[p].a = i32(value)
        return p
    # `[sign:1 limbs]`: an object's shape, each part a named field; `(a b)`: a sequence of two or more
    if token.symbol == .lbrack or token.symbol == .lparen:
        shape = token.symbol == .lbrack
        close = DewyToken.rparen
        if shape: close = .rbrack
        dc_parser.at += 1
        parts: int[]
        loop not rt_dn_accept(close):
            if dc_parser.tokens[dc_parser.at].kind == .eof: return 0
            saved_part = dc_parser.reader.dc_sequence_part
            dc_parser.reader.dc_sequence_part = not shape
            part = rt_dc_pattern()
            dc_parser.reader.dc_sequence_part = saved_part
            if part == 0 or shape and nodes[part].name == 0: return 0
            parts.push(part)
        if not shape and parts.len() < 2: return 0
        p = mk(if shape: NK.pshape else: NK.pseq, pos)
        set_list(p, parts)
        return p
    if token.kind != .identifier or (token.symbol != .none and token.symbol != .kw_test): return 0
    # (`none => 2`: dw_pattern_names' mistake, should nothing else read it)
    if rt_dn_reserved(int(token.name)): return rt_dc_hint(pos, dewy_reserved_text(rt_dn_payload(token)))
    dc_parser.at += 1
    named = rt_dc_word(int(token.name)) != DC_HOLE
    if not rt_dn_accept(.colon):
        p = mk(.pwild, pos)
        if named: nodes[p].name = token.name
        return p
    written = dc_parser.tokens[dc_parser.at]
    # `answer:42`, `s:"yes"`, `x:none`: one literal, a value (dw_pattern's literal); `n:1|2`,
    # `other:'e'|'w'`: literals joined, a type
    leaf = rt_dc_int_leaf(dc_parser.at)
    if leaf == 0 and (written.kind == .boolean or written.kind == .quoted and rt_dc_plain_quote(written) or written.kind == .identifier and int(written.name) == dc_parser.reader.dn_none_id): leaf = 1
    if leaf > 0 and dc_parser.tokens[dc_parser.at + leaf].symbol != .pipe:
        before = dc_parser.at
        value = rt_dc_atom()
        if value == 0 or dc_parser.at != before + leaf: return 0
        p = mk(.plit, pos)
        nodes[p].a = i32(value)
        if named: nodes[p].name = token.name
        return p
    if leaf == 0 and written.symbol != .lbrack and (written.kind != .identifier or written.symbol != .none or int(written.name) == dc_parser.reader.dn_none_id): return 0
    outer = dc_parser.reader.dc_pattern_binder
    if named: dc_parser.reader.dc_pattern_binder = int(token.name)
    t = rt_dc_annotation(45)
    dc_parser.reader.dc_pattern_binder = outer
    if t == 0: return 0
    p = mk(.ptype, pos)
    nodes[p].a = i32(t)
    if named: nodes[p].name = token.name
    p

# A quoted literal without interpolation.

rt_dc_plain_quote = (token: DewyLexeme) -> bool:
    source = files[dc_parser.file].src
    i = token.start
    loop i < token.stop:
        c = source[i]
        if c == '{': return false
        # (`'\{'`: an escaped brace opens nothing)
        if c == '\\': i += 1
        i += 1
    true

# Module functions with scalar signatures and migrated bodies need no syntax
# tree. A contextual signature or body retries the full declaration grammar.

rt_dc_function = () -> int:
    token = dc_parser.tokens[dc_parser.at]
    # (`let name = (...) => ...` and `const name = ...` declare a module function too)
    if token.symbol == .kw_let or token.symbol == .kw_const:
        dc_parser.at += 1
        token = dc_parser.tokens[dc_parser.at]
    # (`spawn = (...) => ...`: before `=`, `spawn` is a name, dn_atom)
    if token.kind != .identifier or (token.symbol != .none and token.symbol != .kw_test and token.symbol != .kw_spawn) or rt_dn_reserved(int(token.name)): return 0
    if dc_parser.tokens[dc_parser.at + 1].symbol != .assign: return 0
    # `name = <T U>(params) => body`: a generic function (dw_type_params)
    if dc_parser.tokens[dc_parser.at + 2].symbol == .langle:
        dc_parser.at += 2
        opening = dc_parser.tokens[dc_parser.at]
        type_params = rt_dc_type_params()
        if type_params.len() == 0: return 0
        if rt_dc_word(int(token.name)) == DC_MAIN: return rt_dc_generic_main(opening)
        dc_parser.depth += 3
        n = rt_dc_function_literal(token.name, opening, type_params)
        if n == 0: return 0
        rt_dn_accept_semi()
        return n
    # `g = x => body`: one parameter, named alone (dw_function's bare parameter)
    bare = dc_parser.tokens[dc_parser.at + 2]
    if bare.kind == .identifier and bare.symbol == .none and dc_parser.tokens[dc_parser.at + 3].symbol == .function and not rt_dn_reserved(int(bare.name)) and rt_dc_word(int(token.name)) != DC_MAIN:
        dc_parser.at += 2
        dc_parser.depth += 3
        n = rt_dc_function_literal(token.name, bare, bare = true)
        if n == 0: return 0
        rt_dn_accept_semi()
        return n
    if dc_parser.tokens[dc_parser.at + 2].symbol != .lparen: return 0
    # `twice = (*2)`: a partial application, a module function of its own (dw_function)
    if rt_dc_partial_at(dc_parser.at + 2):
        if rt_dc_word(int(token.name)) == DC_MAIN: return 0
        dc_parser.at += 3
        dc_parser.depth += 3
        n = rt_dc_partial(dc_parser.tokens[dc_parser.at - 1], token.name)
        if n == 0 or dn_power(rt_dn_peek()) > 0: return 0
        rt_dn_accept_semi()
        return n
    dc_parser.at += 2
    # Account for the enclosing assignment, signature and parameter grammar.
    dc_parser.depth += 3
    # (`name = (<T>(xs:T) => ...)`: a group of one generic member, below)
    # (`((w h):array<int64 length=2>) => ...`: a grouped parameter pattern opens the list)
    if dc_parser.tokens[dc_parser.at + 1].symbol != .lparen and not (dc_parser.tokens[dc_parser.at + 1].symbol == .langle and rt_dc_generic_lambda_next_at(dc_parser.at + 1)) or dc_parser.tokens[dc_parser.at + 1].symbol == .lparen and rt_dc_lambda_next_at(dc_parser.at):
        dc_parser.at += 1
        dc_parser.reader.dc_literal_at = dc_parser.at - 1
        n = rt_dc_function_literal(token.name, dc_parser.tokens[dc_parser.at - 1])
        dc_parser.reader.dc_literal_at = -1
        if n == 0: return 0
        rt_dn_accept_semi()
        return n
    # `name = ((a:T):>R => ...) & ((b:U):>R => ...)`: an overload group, one
    # declaration per member (an entry point's, dw_top_declarations' mistake, noted)
    if rt_dc_word(int(token.name)) == DC_MAIN:
        if not dc_parser.flags.report_now: return 0
        rt_dc_unsupported(mkpos(dc_parser.file, token.start), "an overloaded entry point")
    dc_parser.reader.dc_made.clear()
    # (`name = (((a:T) => a) & ((b:U) => b))`: the group parenthesized as a whole)
    wrapped = dc_parser.tokens[dc_parser.at + 1].symbol == .lparen and (dc_parser.tokens[dc_parser.at + 2].symbol == .lparen and rt_dc_lambda_next_at(dc_parser.at + 2) or dc_parser.tokens[dc_parser.at + 2].symbol == .langle and rt_dc_generic_lambda_next_at(dc_parser.at + 2))
    if wrapped: dc_parser.at += 1
    loop true:
        # (`(() => 42) & 42`: dw_overload_members' mistake, noted)
        if rt_dn_peek() != .lparen and dc_parser.reader.dc_made.len() > 0 and dc_parser.flags.report_now:
            if rt_dc_overload_value() == 0: return 0
            if rt_dn_peek() != .amp: break
            dc_parser.at += 1
            continue
        if not rt_dn_accept(.lparen): return 0
        # (`(<T>(n:int64):>array<T> => ...)`: a generic member)
        opening = dc_parser.tokens[dc_parser.at]
        type_params: int[]
        if opening.symbol == .langle:
            type_params = rt_dc_type_params()
            if type_params.len() == 0: return 0
        else if not rt_dn_accept(.lparen): return 0
        dc_parser.depth += if dc_parser.reader.dc_made.len() == 0: 1 else: 2
        n = rt_dc_function_literal(token.name, opening, type_params)
        if n == 0 or not rt_dn_accept(.rparen): return 0
        dc_parser.depth -= if dc_parser.reader.dc_made.len() == 0: 1 else: 2
        dc_parser.reader.dc_made.push(n)
        if rt_dn_peek() != .amp: break
        dc_parser.at += 1
    if wrapped and not rt_dn_accept(.rparen): return 0
    rt_dn_accept_semi()
    dc_parser.reader.dc_made[0]

rt_dc_generic_main = (opening: DewyLexeme) -> int: rt_dc_fail_now(mkpos(dc_parser.file, opening.start), "Dewy does not yet support a generic entry point")

rt_dc_overload_value = () -> int:
    rt_dc_unsupported(mkpos(dc_parser.file, dc_parser.tokens[dc_parser.at].start), "an overload group member other than a function literal")
    rt_dc_expr(dn_power(.amp) + 1)

# `((a:T) => a) & (...)` as a local declaration's value (dc_initial_at: where it starts), at the
# `&`: dw_declare's mistake, noted (read as the binary).

rt_dc_local_group = (first_at: int, minimum: int) -> bool:
    if first_at != dc_parser.reader.dc_initial_at or minimum != 11 or not dc_parser.flags.fn_body or not dc_parser.flags.report_now: return false
    rt_dc_unsupported(mkpos(dc_parser.file, dc_parser.tokens[first_at].start), "a local overload group; declare it at module level")
    true

# `<T U>(` at `<`: a function's type parameters (dw_type_params), through the `(` opening its
# parameters; empty for any other form.

rt_dc_type_params = () -> int[]:
    opening = dc_parser.tokens[dc_parser.at]
    if not rt_dn_accept(.langle): return []
    type_params: int[]
    loop not rt_dn_accept(.rangle):
        binder = dc_parser.tokens[dc_parser.at]
        # (dw_type_params' mistakes: `<T of int64>`, a reserved word, `<T T>`)
        if binder.symbol == .kw_of:
            rt_dc_fail_now(mkpos(dc_parser.file, binder.start), "Dewy does not yet support constrained type parameters; use plain type parameter names")
            return []
        if binder.kind != .identifier or binder.symbol != .none or rt_dc_word(int(binder.name)) == DC_HOLE: return []
        if rt_dn_reserved(int(binder.name)): rt_dc_reserved_at(binder)
        loop seen in type_params:
            if nodes[seen].name == binder.name:
                rt_dc_fail_now(mkpos(dc_parser.file, binder.start), "duplicate type parameter '{rt_dn_payload(binder)}'")
                return []
        dc_parser.at += 1
        t = mk(.ident, mkpos(dc_parser.file, binder.start))
        nodes[t].name = binder.name
        # (`<E:Effect>`: an effect row's parameter, dw_type_params)
        if rt_dc_effect_param(): nodes[t].aux = 1
        type_params.push(t)
    if type_params.len() == 0 and dc_parser.tokens[dc_parser.at].symbol == .lparen and not dc_parser.tokens[dc_parser.at].space:
        rt_dc_fail_now(mkpos(dc_parser.file, opening.start), "Dewy does not yet support an empty type parameter declaration")
        return []
    if type_params.len() == 0 or dc_parser.tokens[dc_parser.at].space or not rt_dn_accept(.lparen): return []
    type_params

# `:Effect` after a type parameter's name (taken): it names an effect row.

rt_dc_effect_param = () -> bool:
    kind = dc_parser.tokens[dc_parser.at + 1]
    if rt_dn_peek() != .colon or kind.kind != .identifier or rt_dn_payload(kind) != "Effect": return false
    dc_parser.at += 2
    true

# An overload group's declarations, or a type's and its methods', when the last direct
# declaration made several.

rt_dc_type_declaration = () -> int:
    # `small = int64<i => 0 <=? i>`: a refinement names a type (dw_top_declarations, dw_declare)
    refined = rt_dc_refinement_alias()
    if refined != 0: return refined
    # (`let Name:type = ...` declares it too, dw_declare)
    word = dc_parser.tokens[dc_parser.at].symbol
    if (word == .kw_let or word == .kw_const) and dc_parser.tokens[dc_parser.at + 2].symbol == .colon: dc_parser.at += 1
    after = dc_parser.tokens[dc_parser.at + 1].symbol
    if after != .colon and after != .assign: return 0
    token = dc_parser.tokens[dc_parser.at]
    if token.kind != .identifier or (token.symbol != .none and token.symbol != .kw_test) or rt_dn_reserved(int(token.name)): return 0
    annotated = dc_parser.tokens[dc_parser.at + 1].symbol == .colon and dc_parser.tokens[dc_parser.at + 2].kind == .identifier and dc_parser.tokens[dc_parser.at + 2].name == i32(dc_parser.reader.dn_type_id) and dc_parser.tokens[dc_parser.at + 3].symbol == .assign
    # (`E = (type of error) & [...]`: the nominal type grouped, dw_declare's mint)
    minted = dc_parser.tokens[dc_parser.at + 1].symbol == .assign and (rt_dc_mint_at(dc_parser.at + 2) or dc_parser.tokens[dc_parser.at + 2].symbol == .lparen and rt_dc_mint_at(dc_parser.at + 3))
    if not annotated and not minted: return 0
    dc_parser.reader.dc_methods.clear()
    dc_parser.reader.dc_method_hooks.clear()
    dc_parser.at += if annotated: 4 else: 2
    pos = mkpos(dc_parser.file, token.start)
    grouped = dc_parser.tokens[dc_parser.at].symbol == .lparen and rt_dc_mint_at(dc_parser.at + 1)
    if grouped: dc_parser.at += 1
    if rt_dc_mint_at(dc_parser.at):
        dc_parser.at += 2
        n = mk(.struct_, pos)
        nodes[n].name = token.name
        names: int[]
        if rt_dn_peek() == .lbrack and not grouped:
            dc_parser.at += 1
            if not rt_dc_record_fields(n, names): return 0
        else:
            base = rt_dc_type_named()
            if base == 0 or nodes[base].kind != .tname or nkids(base) != 0: return 0
            if grouped and not rt_dn_accept(.rparen): return 0
            nodes[n].a = i32(base)
            if rt_dn_accept(.amp):
                if not rt_dn_accept(.lbrack) or not rt_dc_record_fields(n, names): return 0
            else: set_list(n, [])
        if not rt_dc_statement_ends() or not rt_dc_record_members(n, names): return 0
        rt_dc_transfer_apply(n)
        return n
    if not annotated: return 0
    # `Name:type = A & B & [f:T]`: a record with the fields of each (dw_intersection)
    if rt_dc_intersection_next(): return rt_dc_intersection(token, pos)
    # `Name:type = <T U>[fields]`: a generic record (dw_type_params)
    type_params: int[]
    # (`<T>[...]`: type parameters, plain names then a record; `<(x:T):>R>`, `<'a' | 1>`: an alias)
    if rt_dn_peek() == .langle and dc_parser.tokens[dc_parser.at + 1].kind == .identifier and dc_parser.tokens[dc_parser.at + 1].symbol == .none and (dc_parser.tokens[dc_parser.at + 2].symbol == .rangle or dc_parser.tokens[dc_parser.at + 2].kind == .identifier or dc_parser.tokens[dc_parser.at + 2].symbol == .colon and rt_dn_payload(dc_parser.tokens[dc_parser.at + 3]) == "Effect"):
        dc_parser.at += 1
        loop not rt_dn_accept(.rangle):
            binder = dc_parser.tokens[dc_parser.at]
            if binder.kind != .identifier or binder.symbol != .none or rt_dn_reserved(int(binder.name)) or rt_dc_word(int(binder.name)) == DC_HOLE: return 0
            loop seen in type_params:
                if nodes[seen].name == binder.name: return 0
            dc_parser.at += 1
            t = mk(.ident, mkpos(dc_parser.file, binder.start))
            nodes[t].name = binder.name
            if rt_dc_effect_param(): nodes[t].aux = 1
            type_params.push(t)
        if type_params.len() == 0 or dc_parser.tokens[dc_parser.at].space: return 0
        # `Pair:type = <T>(array<T length=2>)`: a generic alias of the one type in parentheses
        if rt_dn_accept(.lparen):
            alias = rt_dc_annotation()
            if alias == 0 or not rt_dn_accept(.rparen) or dn_power(rt_dn_peek()) > 0: return 0
            n = mk(.typealias, pos)
            nodes[n].name = token.name
            nodes[n].a = i32(alias)
            set_list2(n, type_params)
            add_flag(n, NF_GENERIC)
            rt_dn_accept_semi()
            return n
        if rt_dn_peek() != .lbrack: return 0
    # (`Entry:type = [int64 string]`: a type per position, an alias, dw_positional_types)
    positional = false
    if rt_dn_peek() == .lbrack and type_params.len() == 0:
        first = dc_parser.tokens[dc_parser.at + 1]
        positional = first.symbol != .rbrack and first.kind != .metatag and first.symbol != .at and dc_parser.tokens[dc_parser.at + 2].symbol != .colon and dc_parser.tokens[dc_parser.at + 2].symbol != .assign
    if rt_dn_peek() != .lbrack or positional:
        # `Apply:type = (x:int64):>int64`: a function type without its angle brackets (dw_type's `:>`)
        alias = 0
        alias_at = dc_parser.at
        if rt_dn_peek() == .lparen and dc_parser.tokens[rt_dc_closing(dc_parser.at) + 1].symbol == .returns: alias = rt_dc_function_type(false)
        else: alias = rt_dc_annotation()
        if alias == 0 or dn_power(rt_dn_peek()) > 0: return rt_dc_untyped(alias_at)
        n = mk(.typealias, pos)
        nodes[n].name = token.name
        nodes[n].a = i32(alias)
        rt_dn_accept_semi()
        return n
    dc_parser.at += 1
    n = mk(.struct_, pos)
    nodes[n].name = token.name
    if type_params.len() > 0:
        set_list2(n, type_params)
        add_flag(n, NF_GENERIC)
    names: int[]
    if not rt_dc_record_fields(n, names) or dn_power(rt_dn_peek()) > 0: return 0
    rt_dn_accept_semi()
    if not rt_dc_record_members(n, names): return 0
    rt_dc_transfer_apply(n)
    n

# `type of` at token `at`.

rt_dc_mint_at = (at: int) -> bool: dc_parser.tokens[at].kind == .identifier and dc_parser.tokens[at].name == i32(dc_parser.reader.dn_type_id) and dc_parser.tokens[at + 1].symbol == .kw_of

# An `&` joins the declared type's operands at the top (not `int64 & ~0`, a refinement).

rt_dc_intersection_next = () -> bool:
    depth = 0
    k = dc_parser.at
    found = false
    loop k < dc_parser.tokens.len():
        t = dc_parser.tokens[k]
        if t.kind == .eof or k > dc_parser.at and depth == 0 and t.newline: break
        symbol = t.symbol
        if symbol == .lparen or symbol == .lbrack or symbol == .lbrace or symbol == .langle: depth += 1
        else if symbol == .rparen or symbol == .rbrack or symbol == .rbrace or symbol == .rangle: depth -= 1
        else if depth == 0 and symbol == .amp:
            if dc_parser.tokens[k + 1].symbol == .tilde: return false
            found = true
        k += 1
    found

# The operands of an intersection after its declaration's `=`: names, and one row list whose
# fields and methods the record adds (dw_intersection, dw_type_methods). 0 for other forms.

rt_dc_intersection = (token: DewyLexeme, pos: int) -> int:
    n = mk(.struct_, pos)
    nodes[n].name = token.name
    set_list(n, [])
    components: int[]
    names: int[]
    rows = false
    loop true:
        if rt_dn_peek() == .lbrack:
            if rows: return 0
            rows = true
            dc_parser.at += 1
            if not rt_dc_record_fields(n, names) or dc_parser.reader.dc_transfer_bits != 0: return 0
            loop hook in dc_parser.reader.dc_method_hooks:
                if hook != 0: return 0
        else:
            leaf = dc_parser.tokens[dc_parser.at]
            # (`$abstract type of any & [...]`: dw_type's mistake)
            if leaf.kind == .metatag and dc_parser.flags.report_now: return rt_dc_fail_now(mkpos(dc_parser.file, leaf.start), metatag_fail_text(rt_dn_payload(leaf)))
            if leaf.kind != .identifier or leaf.symbol != .none: return 0
            t = rt_dc_type_named()
            if t == 0: return 0
            components.push(t)
        if not rt_dn_accept(.amp): break
    if dn_power(rt_dn_peek()) > 0 or not rt_dc_statement_ends() and rt_dn_peek() != .semi: return 0
    rt_dn_accept_semi()
    if not rt_dc_record_members(n, names): return 0
    struct_components[n] = components
    n

# `name = T<condition>` or `name = T & ~value` at the top of a module (`let` or `const` before it,
# or neither): the alias of the refined type; 0 for anything else (dc_parser.at stays).

rt_dc_refinement_alias = () -> int:
    start = dc_parser.at
    if dc_parser.tokens[dc_parser.at].symbol == .kw_let or dc_parser.tokens[dc_parser.at].symbol == .kw_const: dc_parser.at += 1
    if dc_parser.at + 4 >= dc_parser.tokens.len():
        dc_parser.at = start
        return 0
    token = dc_parser.tokens[dc_parser.at]
    base = dc_parser.tokens[dc_parser.at + 2]
    if token.kind != .identifier or token.symbol != .none or rt_dn_reserved(int(token.name)) or dc_parser.tokens[dc_parser.at + 1].symbol != .assign or base.kind != .identifier or base.symbol != .none:
        dc_parser.at = start
        return 0
    # (`nonzero = int64 & ~0`: the value excluded, dw_type's `& ~`)
    excluded = dc_parser.tokens[dc_parser.at + 3].symbol == .amp and dc_parser.tokens[dc_parser.at + 4].symbol == .tilde
    if not excluded and (dc_parser.tokens[dc_parser.at + 3].symbol != .langle or dc_parser.tokens[dc_parser.at + 3].space or not rt_dc_refinement_arguments(dc_parser.at + 3)):
        dc_parser.at = start
        return 0
    dc_parser.at += 2
    t = rt_dc_type_named()
    if excluded:
        if t == 0 or rt_dn_peek() != .amp: return 0
        dc_parser.at += 2
        value = rt_dc_expr(dn_prefix_power(.tilde, false))
        if value == 0: return 0
        t = rt_dc_excluded(t, value, mkpos(dc_parser.file, base.start))
    if t == 0 or nodes[t].kind != .trefined or dn_power(rt_dn_peek()) > 0: return 0
    n = mk(.typealias, mkpos(dc_parser.file, token.start))
    nodes[n].name = token.name
    nodes[n].a = i32(t)
    rt_dn_accept_semi()
    n

# `T & ~value`: T refined to leave value out (dw_type's `& ~`).

rt_dc_excluded = (base: int, value: int, pos: int) -> int:
    n = mk(.trefined, pos)
    nodes[n].a = i32(base)
    binder = intern("$refinement")
    nodes[n].name = i32(binder)
    named = mk(.ident, pos)
    nodes[named].name = i32(binder)
    predicate = mk(.binary, pos)
    nodes[predicate].op = i32(int(Tok.ne))
    nodes[predicate].a = i32(named)
    nodes[predicate].b = i32(value)
    nodes[n].b = i32(predicate)
    refine_active = true
    n

# The type arguments opening at `at` hold a condition at their top (dw_top_declarations' test): a
# `=>` or a comparison, or a group opening with one.

rt_dc_refinement_arguments = (at: int) -> bool:
    depth = 0
    k = at
    loop k < dc_parser.tokens.len():
        t = dc_parser.tokens[k]
        symbol = t.symbol
        if t.kind == .eof: return false
        if symbol == .langle or symbol == .lparen or symbol == .lbrack or symbol == .lbrace:
            depth += 1
            if depth == 2 and symbol == .lparen and rt_dc_refinement_next_at(k): return true
        else if symbol == .rangle or symbol == .rparen or symbol == .rbrack or symbol == .rbrace:
            depth -= 1
            if depth == 0: return false
        else if depth == 1:
            scalar = dn_token_uninvert(symbol)
            if symbol == .function or symbol == .kw_and or scalar == .eq or scalar == .lt or scalar == .le or scalar == .gt or scalar == .ge or scalar == .contains: return true
        k += 1
    false

rt_dc_refinement_next_at = (at: int) -> bool:
    saved = dc_parser.at
    dc_parser.at = at
    yes = rt_dc_refinement_next()
    dc_parser.at = saved
    yes

# A record type's rows after its `[`, through its `]` (dw_param of each field): its fields, the
# rows' names in order; methods (`name = (params) => body`, a lifecycle tag before one) wait in
# dc_methods for dc_record_members. Transfer rows and other tags are left unread (dc_unread).

# (dw_record_type's mistakes, should nothing else read the type)

rt_dc_record_mistake = (at: int, msg: str) -> bool:
    rt_dc_hint(mkpos(dc_parser.file, at), msg)
    false

rt_dc_record_fields = (n: int, names: mut int[]) -> bool:
    fields: int[]
    dc_parser.reader.dc_methods.clear()
    dc_parser.reader.dc_method_hooks.clear()
    dc_parser.reader.dc_transfer_bits = 0
    dc_parser.reader.dc_transfer_at = 0
    hook = 0
    loop not rt_dn_accept(.rbrack):
        first = dc_parser.tokens[dc_parser.at]
        # (`$send`, `$sync=false`, `$unsafe` among the rows: the type's transfer claims, dw_transfer_row)
        if first.kind == .metatag and hook == 0 and rt_dc_transfer_row(first): continue
        if first.kind == .metatag:
            # (`$__drop__`, `$__copy__`, `$__move__` before a method, on the line before it or not)
            tag = rt_dc_lifecycle_tag(first)
            next = dc_parser.tokens[dc_parser.at + 1]
            if tag != 0 and hook != 0: return rt_dc_record_mistake(first.start, "a lifecycle tag must precede one method")
            if tag == 0 or not (next.newline or next.space and next.kind == .identifier): return false
            hook = tag
            dc_parser.at += 1
            continue
        by_place = rt_dn_accept(.at)
        field = dc_parser.tokens[dc_parser.at]
        if field.kind != .identifier or (field.symbol != .none and field.symbol != .kw_test): return false
        # (`[start:int64 end:int64]`: dw_row_names' mistake)
        if rt_dn_reserved(int(field.name)) and (dc_parser.tokens[dc_parser.at + 1].symbol == .colon or dc_parser.tokens[dc_parser.at + 1].symbol == .assign): rt_dc_reserved_at(field)
        else if rt_dn_reserved(int(field.name)): return false
        # (`pair = <U>(other:U) => ...`: a generic method, its own type parameters after the type's)
        generic = not by_place and dc_parser.tokens[dc_parser.at + 1].symbol == .assign and dc_parser.tokens[dc_parser.at + 2].symbol == .langle and rt_dc_generic_lambda_next_at(dc_parser.at + 2)
        if generic or not by_place and dc_parser.tokens[dc_parser.at + 1].symbol == .assign and dc_parser.tokens[dc_parser.at + 2].symbol == .lparen and rt_dc_lambda_next_at(dc_parser.at + 2):
            if rt_dc_word(int(field.name)) == DC_MAIN: return rt_dc_record_mistake(field.start, "a method cannot be named main")
            dc_parser.at += 2
            opening = dc_parser.tokens[dc_parser.at]
            type_params: int[]
            if generic:
                type_params = rt_dc_type_params()
                if type_params.len() == 0: return false
            else: dc_parser.at += 1
            dc_parser.depth += 3
            saved = dc_parser.reader.dc_method_body
            dc_parser.reader.dc_method_body = true
            method = rt_dc_function_literal(field.name, opening, type_params)
            dc_parser.reader.dc_method_body = saved
            if method == 0 or rt_dn_peek() == .semi: return false
            dc_parser.reader.dc_methods.push(method)
            dc_parser.reader.dc_method_hooks.push(hook)
            hook = 0
            names.push(int(field.name))
            continue
        if hook != 0: return rt_dc_record_mistake(first.start, "a lifecycle tag requires a method")
        dc_parser.at += 1
        f = mk(.vardecl, mkpos(dc_parser.file, first.start))
        nodes[f].name = field.name
        typed = rt_dn_accept(.colon)
        if typed:
            outer = dc_parser.reader.dc_pattern_binder
            dc_parser.reader.dc_pattern_binder = int(field.name)
            annotation = rt_dc_annotation()
            dc_parser.reader.dc_pattern_binder = outer
            if annotation == 0: return false
            nodes[f].a = i32(annotation)
        if rt_dn_accept(.assign):
            initial = rt_dc_expr(11)
            # (`speak = () => ...` reads as a method above)
            if initial == 0 or nodes[initial].kind == .lambda: return false
            nodes[f].b = i32(initial)
        else if not typed: return false
        if by_place: add_flag(f, NF_MUT)
        fields.push(f)
        names.push(int(field.name))
    if hook != 0: return false
    set_list(n, fields)
    true



# (`$send=1`: dw_dir_boolean's mistake, should nothing else read it)

rt_dc_transfer_value = (name: str, value: DewyLexeme) -> int: rt_dc_hint(mkpos(dc_parser.file, value.start), "`${name}` takes a literal true or false")

rt_dc_transfer_row = (tag: DewyLexeme) -> bool:
    name = rt_dn_payload(tag)
    if name != "send" and name != "sync" and name != "unsafe": return false
    at = dc_parser.at + 1
    on = true
    if dc_parser.tokens[at].symbol == .assign:
        if name == "unsafe": return false
        if dc_parser.tokens[at + 1].kind != .boolean: return rt_dc_transfer_value(name, dc_parser.tokens[at + 1]) != 0
        on = int(dc_parser.tokens[at + 1].name) == dc_parser.reader.dn_true_id
        at += 2
    next = dc_parser.tokens[at]
    if not (next.symbol == .rbrack or next.kind == .metatag or next.newline): return false
    bit = 0
    if name == "unsafe":
        if next.kind != .metatag and next.symbol != .rbrack: return false
        bit = TRANSFER_UNSAFE
    else if name == "send":
        bit = if on: TRANSFER_SEND_CLAIM else: TRANSFER_SEND_OFF
    else: bit = if on: TRANSFER_SYNC_CLAIM else: TRANSFER_SYNC_OFF
    dc_parser.reader.dc_transfer_bits = dc_parser.reader.dc_transfer_bits | bit
    if bit == TRANSFER_SEND_CLAIM or bit == TRANSFER_SYNC_CLAIM: dc_parser.reader.dc_transfer_at = mkpos(dc_parser.file, tag.start)
    dc_parser.at = at
    true

# The record's transfer tags, as dw_transfer_row records them, once its declaration is read.

rt_dc_transfer_apply = (decl: int):
    if dc_parser.reader.dc_transfer_bits == 0: return
    transfer_tags[decl] = (transfer_tags.get(decl) ?? 0) | dc_parser.reader.dc_transfer_bits
    if dc_parser.reader.dc_transfer_at != 0: transfer_claim_pos[decl] = dc_parser.reader.dc_transfer_at
    dc_parser.reader.dc_transfer_bits = 0
    dc_parser.reader.dc_transfer_at = 0

rt_dc_lifecycle_tag = (token: DewyLexeme) -> int:
    name = rt_dn_payload(token)
    if name == "__drop__": return 1
    if name == "__copy__": return 2
    if name == "__move__": return 3
    0

# `import m`, `import m as n`, `import p"file.dewy"`, `from m import a, b as c` (dw_import); a
# parenthesized selection and the reversed order are left unread (dc_unread).

rt_dc_import = () -> int:
    keyword = rt_dn_take()
    n = mk(.import_, mkpos(dc_parser.file, keyword.start))
    # (`import (a b) from p"x"` is `from p"x" import (a b)`, dw_import)
    imported: int[]
    reversed = keyword.symbol == .kw_import and rt_dn_peek() == .lparen
    if reversed:
        if not rt_dc_import_list(imported) or not rt_dn_accept(.kw_from): return 0
    spec = dc_parser.tokens[dc_parser.at]
    if not rt_dc_import_word(spec): return 0
    dc_parser.at += 1
    value = rt_dn_payload(spec)
    path = dc_parser.tokens[dc_parser.at]
    if rt_dc_word(int(spec.name)) == DC_P and not path.space and path.kind == .quoted:
        if not rt_dc_plain_quote(path): return 0
        text = rt_dn_string(path)
        if text == 0: return 0
        value = name_of(int(nodes[text].sval))
        nodes[n].aux2 = 1
        dc_parser.at += 1
    alias = ""
    if rt_dn_accept(.kw_as):
        if not rt_dc_import_alias(dc_parser.tokens[dc_parser.at]): return 0
        alias = rt_dn_payload(rt_dn_take())
    nodes[n].sval = i32(intern(value))
    nodes[n].name = i32(intern(strip_ext(file_name(value))))
    if alias != "": nodes[n].name = i32(intern(alias))
    if keyword.symbol == .kw_from or reversed:
        if not reversed and (not rt_dn_accept(.kw_import) or not rt_dc_import_list(imported)): return 0
        nodes[n].aux = 2
        set_list(n, imported)
    else if alias == "" and nodes[n].aux2 == 1: nodes[n].aux = 3
    next = dc_parser.tokens[dc_parser.at]
    # (`from m import a b`, `import m n`: dn_stmt's mistakes, at once)
    if not next.newline and dc_parser.flags.report_now and dn_can_start(dc_parser.tokens, dc_parser.at): rt_dc_import_mistake(keyword.symbol == .kw_import and not reversed)
    # (`import a, b`: dw_import's mistake, should nothing else read it)
    if next.symbol == .comma and keyword.symbol == .kw_import and not reversed: return rt_dc_hint(mkpos(dc_parser.file, spec.start), "Dewy does not yet support this module path; use a library name or p\"file.dewy\"")
    if next.kind != .eof and not (next.newline and dn_power(next.symbol) == 0 and next.symbol != .kw_not) and not (next.symbol == .semi and not next.space and not next.newline): return 0
    rt_dn_accept_semi()
    n

rt_dc_import_mistake = (module: bool):
    if module: dn_error(dc_parser.tokens[dc_parser.at].start, "an `import` line takes one module: put the next on a line of its own, or take names from a module with `from m import a, b`")
    dn_error(dc_parser.tokens[dc_parser.at].start, "imported names are separated by commas, `import a, b`, or listed in parentheses, `import (a b)`")

# The names an import selects, in order, each with an optional alias: `a, b as c` or `(a b as c)`;
# a group may be one of the comma-separated names, `(A as B), c` (dw_import_words).

rt_dc_import_list = (imported: mut int[]) -> bool:
    grouped = false
    loop true:
        if not grouped and rt_dn_accept(.lparen): grouped = true
        word = dc_parser.tokens[dc_parser.at]
        if not rt_dc_import_word(word): return false
        dc_parser.at += 1
        item = mk(.ident, mkpos(dc_parser.file, word.start))
        nodes[item].name = dw_value_name(word.name, nodes[item].pos)
        if rt_dn_accept(.kw_as):
            if not rt_dc_import_alias(dc_parser.tokens[dc_parser.at]): return false
            nodes[item].aux = i32(intern(rt_dn_payload(rt_dn_take())))
        imported.push(item)
        if grouped and rt_dn_accept(.rparen):
            if rt_dn_peek() != .comma: return true
            dc_parser.at += 1
            grouped = false
        else if not rt_dn_accept(.comma) and not grouped: return true
    true

# An alias (`as void`: dw_import's mistake, a reserved word).

rt_dc_import_alias = (token: DewyLexeme) -> bool:
    if token.kind == .identifier and token.symbol == .none and rt_dn_reserved(int(token.name)):
        rt_dc_reserved_at(token)
        return true
    rt_dc_import_word(token)

# A name an import may bind (not a reserved word or one with a meaning of its own).

rt_dc_import_word = (token: DewyLexeme) -> bool:
    if token.kind != .identifier or token.symbol != .none or rt_dn_reserved(int(token.name)): return false
    name = int(token.name)
    name != dc_parser.reader.dn_end_id and name != dc_parser.reader.dn_new_id and name != dc_parser.reader.dn_type_id and name != dc_parser.reader.dn_none_id and rt_dn_payload(token) != "Cancelled"

# What dw_type_methods records for a declared type: its rows' names (a parent's members are
# inherited), and the methods dc_record_fields read, each a module function taking the object
# first, its bare member names read through that receiver. False: a form left unread
# (methods of a type whose members are known only later, a name the frontend renames).

rt_dc_record_members = (struct_: int, names: int[]) -> bool:
    if dc_parser.reader.dc_local_type_on: return rt_dc_local_members()
    receiver = intern("$self")
    file = pos_file(nodes[struct_].pos)
    types_here = dw_type_members.get(file) ?? {}
    inherited: {int: int} = {}
    parent = int(nodes[struct_].a)
    deferred = false
    if parent != 0 and nodes[parent].kind == .tname:
        parent_name = int(nodes[parent].name)
        if let known = types_here.get(parent_name):
            inherited = known
            deferred = dewy_deferred_here(file, parent_name)
        else: deferred = name_of(parent_name) not in ["error", "exception", "any"]
    else if parent != 0: deferred = true
    methods = dc_parser.reader.dc_methods
    hooks = dc_parser.reader.dc_method_hooks
    dc_parser.reader.dc_methods = []
    dc_parser.reader.dc_method_hooks = []
    members: {int: int} = {}
    if methods.len() > 0:
        loop name, member in inherited: members[name] = receiver
        # (with members still unknown, inherited from another module or a later type, the other
        # names wait for them, dewy_defer_name)
        if deferred: members[dewy_inherited_key()] = struct_
        loop name in names:
            if name_of(name) in ["printl", "print", "int", "bigint", "__dewy_print", "__dewy_int"]: return false
            members[name] = receiver
        loop method in methods:
            loop other in kids(struct_):
                if nodes[other].name == nodes[method].name: return rt_dc_field_and_method(struct_, method)
        # (every method resolves before any is finished: a retry undoes the nodes only)
        dc_parser.reach.waiting.clear()
        dc_parser.reach.waiting_names.clear()
        dc_parser.reach.waiting_callees.clear()
        loop method in methods:
            dc_parser.reach.scope = members
            reached = rt_dc_reach_fn(method)
            dc_parser.reach.scope = {}
            if not reached: return false
    if deferred: dewy_defer_type(struct_, file)
    loop i in 0.. and waiting in dc_parser.reach.waiting: dewy_defer_name(struct_, waiting, dc_parser.reach.waiting_names[i])
    loop callee in dc_parser.reach.waiting_callees: dewy_defer_callee(callee)
    dc_parser.reach.waiting.clear()
    dc_parser.reach.waiting_names.clear()
    dc_parser.reach.waiting_callees.clear()
    decls: int[]
    extra_names: int[]
    extra_decls: int[]
    made = [struct_]
    k = 0
    loop name in names:
        if k < methods.len() and nodes[methods[k]].name == i32(name):
            method = methods[k]
            label = name_of(name)
            lent = place_method_split(method, receiver, label)
            dw_method_finish(method, struct_, kids2(struct_), receiver)
            if hooks[k] != 0: ownership_declare(struct_, method, hooks[k])
            made.push(method)
            decls.push(method)
            loop extra in lent:
                dw_method_finish(extra, struct_, kids2(struct_), receiver)
                made.push(extra)
                extra_names.push(int(nodes[extra].name))
                extra_decls.push(extra)
            k += 1
        else: decls.push(0)
    row_names = names
    loop i in [0..extra_names.len()):
        row_names.push(extra_names[i])
        decls.push(extra_decls[i])
    first = dewy_methods.len()
    group = dewy_method_group(row_names, decls, inherited)
    dewy_decl_members[struct_] = group
    dewy_decl_methods[struct_] = [first, dewy_methods.len()]
    types_here[int(nodes[struct_].name)] = group
    dw_type_members[file] = types_here
    if methods.len() > 0:
        dewy_type_members[struct_] = group
        dc_parser.reader.dc_made = made
    true



# 'width' as a field and a method (dw_type_methods' mistake, at once: the declaration is read), at
# the method's name, two tokens before its `(`.
# A local type's rows: a method is dw_declare's mistake, noted at its name.

rt_dc_local_members = () -> bool:
    methods = dc_parser.reader.dc_methods
    dc_parser.reader.dc_methods = []
    dc_parser.reader.dc_method_hooks = []
    if methods.len() == 0: return true
    if not dc_parser.flags.report_now: return false
    rt_dc_unsupported(rt_dc_method_name_at(methods[0]), "methods on a local type; declare the type at module level")
    true

# Where a method's name is written: two tokens before its `(`.

rt_dc_method_name_at = (method: int) -> int:
    at = pos_off(nodes[method].pos)
    k = dc_parser.at
    loop k > 2 and dc_parser.tokens[k].start != at: k -= 1
    mkpos(dc_parser.file, dc_parser.tokens[k - 2].start)

rt_dc_field_and_method = (struct_: int, method: int) -> bool:
    if not dc_parser.flags.report_now: return false
    rt_dc_fail_now(rt_dc_method_name_at(method), "'{name_of(int(nodes[method].name))}' is both a field and a method of {name_of(int(nodes[struct_].name))}")
    false

rt_dc_hide = (names: int[]):
    dm_hide(dc_parser, dw_builder_host, names)

# Resolve member names in n, as a body's names meet them. False: a
# form this does not follow.

rt_dc_reach = (n: int) -> bool:
    dm_reach(dc_parser, nodes, lists, dw_builder_host, names, n)

rt_dc_reach_all = (xs: int[]) -> bool:
    dm_reach_all(dc_parser, nodes, lists, dw_builder_host, names, xs)

rt_dc_reach_statements = (block: int) -> bool:
    dm_reach_statements(dc_parser, nodes, lists, dw_builder_host, names, block)

rt_dc_reach_statement = (s: int) -> bool:
    dm_reach_statement(dc_parser, nodes, lists, dw_builder_host, names, s)

# The names a pattern binds (dw_bound_names).

rt_dc_bound = (bindings: int[], out: mut int[]):
    dm_bound(nodes, lists, bindings, out)

rt_dc_reach_flow = (n: int) -> bool:
    dm_reach_flow(dc_parser, nodes, lists, dw_builder_host, names, n)

# `binders in source`: the binders hide members in the body, not in the source (dw_loop_head).

rt_dc_reach_in = (binders: int[], source: int) -> bool:
    dm_reach_in(dc_parser, nodes, lists, dw_builder_host, names, binders, source)

rt_dc_reach_head = (h: int) -> bool:
    dm_reach_head(dc_parser, nodes, lists, dw_builder_host, names, h)

rt_dc_reach_match = (n: int) -> bool:
    dm_reach_match(dc_parser, nodes, lists, dw_builder_host, names, n)

# A function: its result and parameters' types and defaults, its captures, then its body with
# its parameters and captures hiding members (dw_function).

rt_dc_reach_fn = (n: int) -> bool:
    dm_reach_fn(dc_parser, nodes, lists, dw_builder_host, names, n)

rt_dc_reach_type = (t: int) -> bool:
    dm_reach_type(dc_parser, nodes, lists, dw_builder_host, names, t)

# A token an effect row's atom may start with (dw_effect_atom reports any other).

rt_dc_effect_atom_start = (token: DewyLexeme) -> bool: token.kind == .identifier or token.symbol == .kw_not

# `:>R & no allocates & no blocks`: a function's effect row, atom by atom
# (dw_effect_result and dw_effect_atom read the same atoms in this order).

rt_dc_effect_row = (owner: int) -> bool:
    entries: EffectSyntax[]
    if not rt_dc_effect_entries(entries, false): return false
    effects_active = true
    effect_syntax.push(entries)
    nodes[owner].sval = i32(effect_syntax.len() - 1)
    true

# An effect row's entries from dc_parser.at, each after its `&` (`bare`: the first without one, a
# bundle's `$default_row`); false at a form left unread (dc_unread).

rt_dc_effect_entries = (entries: mut EffectSyntax[], bare: bool) -> bool:
    empty = false
    first = bare
    loop first or rt_dn_accept(.amp):
        first = false
        token = dc_parser.tokens[dc_parser.at]
        negative = token.symbol == .kw_not or token.kind == .identifier and token.symbol == .none and int(token.name) == dc_parser.reader.dn_no_id and dc_parser.tokens[dc_parser.at + 1].kind == .identifier
        if negative: dc_parser.at += 1
        atom = dc_parser.tokens[dc_parser.at]
        if atom.kind != .identifier or atom.symbol != .none: return false
        dc_parser.at += 1
        id = int(atom.name)
        word = rt_dc_word(id)
        pos = mkpos(dc_parser.file, atom.start)
        # `reads<x>`, `mutates<grid.cells>`: one place (dw_effect_path)
        if (word == DC_READS or word == DC_MUTATES) and rt_dn_peek() == .langle and not dc_parser.tokens[dc_parser.at].space:
            if empty: return false
            dc_parser.at += 1
            path: int[]
            loop true:
                part = dc_parser.tokens[dc_parser.at]
                if part.kind != .identifier or part.symbol != .none: return false
                path.push(intern(rt_dn_payload(part)))
                dc_parser.at += 1
                if not rt_dn_accept(.dot): break
            if not rt_dn_accept(.rangle):
                if not (dc_parser.reader.dn_edits_on and rt_dn_closer_joined()): return false
                rt_dn_split_closer()
            kind = EffectKind.write
            if word == DC_READS: kind = EffectKind.read
            entries.push(EffectSyntax(kind, path, pos, negative))
            continue
        if rt_dn_peek() == .langle or rt_dn_peek() == .lparen or rt_dn_peek() == .dot or rt_dn_peek() == .lbrack: return false
        if word == DC_NO_EFFECTS:
            if negative or empty or entries.len() != 0: return false
            empty = true
            continue
        if empty: return false
        if negative and (word == DC_READS or word == DC_MUTATES): entries.push(EffectSyntax(if word == DC_READS: EffectKind.read else: EffectKind.write, [], pos, true))
        else if word == DC_ALLOCATES: entries.push(EffectSyntax(.alloc, [], pos, negative))
        else if word == DC_BLOCKS:
            # (dw_effect_atom's mistakes, noted)
            if not negative and not rt_dc_granted(pos, "blocks"): return false
            entries.push(EffectSyntax(.block, [], pos, true))
            effect_blocks_demanded = true
        else if word == DC_PANICS:
            if not negative and not rt_dc_granted(pos, "panics"): return false
            entries.push(EffectSyntax(.panic, [], pos, true))
            effect_panics_demanded = true
        else: entries.push(EffectSyntax(.opaque, [id], pos, negative, true))
    true

rt_dc_granted = (pos: int, word: str) -> bool:
    if not dc_parser.flags.report_now: return false
    rt_dc_report(pos, "`{word}` is inferred, never granted: a row can only exclude it, `& no {word}`")
    true

# `(params):>result => body`, after its opening parenthesis.
# A lambda (a function literal in an expression, dw_function's unnamed function) may list
# `$capture name` and `$capture @name` among its parameters; `bare`, it has one
# parameter name instead of a list (`x => x + 1`, opening that name).

rt_dc_function_literal = (name_id: i32, opening: DewyLexeme, type_params: int[] = [], lambda: bool = false, bare: bool = false) -> int:
    name = name_of(int(name_id))
    n = mk(.fn_, mkpos(dc_parser.file, opening.start))
    if lambda: nodes[n].kind = .lambda
    nodes[n].name = name_id
    if type_params.len() > 0:
        set_list2(n, type_params)
        add_flag(n, NF_GENERIC)
    ps: int[]
    captures: int[]
    bound: {int: bool} = {}
    # (`... by:int64`: a bare `...` ends the positional run; the parameters after it are named
    # only, dewy_param_kinds)
    keyword_only = false
    kinds_at = dc_parser.reader.dc_kinds.len()
    # (`(a:int64, b:int64)`: once a comma follows an annotation, one ends each, dc_comma_mistake below)
    commas = false
    loop true:
        if bare:
            if ps.len() > 0: break
        else if rt_dn_accept(.rparen): break
        first = dc_parser.tokens[dc_parser.at]
        if first.symbol == .ellipsis and not bare and not keyword_only and dc_parser.tokens[dc_parser.at - 1].symbol == .lparen:
            after = dc_parser.tokens[dc_parser.at + 1]
            if after.kind != .identifier or after.symbol != .none or not after.space or dc_parser.tokens[dc_parser.at + 2].symbol != .colon:
                if not rt_dc_rest_parameter(): return 0
                continue
            keyword_only = true
            dc_parser.at += 1
            continue
        if first.kind == .metatag and not bare:
            # (dw_function's mistakes: another modifier, `$capture` on a module function, before no
            # name, or before something else)
            tagged = rt_dc_parameter_tag(first, lambda)
            if tagged < 0: return 0
            if tagged > 0: continue
            dc_parser.at += 1
            next = dc_parser.tokens[dc_parser.at]
            if next.kind == .metatag or next.symbol == .rparen:
                if type_params.len() > 0 or not rt_dc_capture_missing(next, opening): return 0
                continue
            place = rt_dn_accept(.at)
            target = dc_parser.tokens[dc_parser.at]
            if target.kind == .identifier and (target.symbol == .none or target.symbol == .kw_test) and (rt_dc_word(int(target.name)) == DC_HOLE or dc_parser.tokens[dc_parser.at + 1].symbol == .dot and not dc_parser.tokens[dc_parser.at + 1].space):
                if not rt_dc_capture_other(place, target): return 0
                continue
            if target.kind != .identifier or (target.symbol != .none and target.symbol != .kw_test) or rt_dn_reserved(int(target.name)) or rt_dc_word(int(target.name)) == DC_HOLE: return 0
            if bound.has(int(target.name)):
                # (dw_function's mistake; a method's member captures it checks apart)
                if dc_parser.reach.scope.len() == 0: fatal(mkpos(dc_parser.file, target.start), "duplicate parameter binding '{rt_dn_payload(target)}'")
                return 0
            dc_parser.at += 1
            cap = mk(.ident, mkpos(dc_parser.file, target.start))
            nodes[cap].name = dw_value_name(target.name, nodes[cap].pos)
            if place: add_flag(cap, NF_MUT)
            bound[int(target.name)] = true
            captures.push(cap)
            continue
        # (`<value:int64>`: a positional-only parameter, kind 2)
        angled = not bare and first.symbol == .langle
        if angled: dc_parser.at += 1
        by_place = not bare and not angled and rt_dn_accept(.at)
        parameter = dc_parser.tokens[dc_parser.at]
        # (`(@[x y]:T)`: dw_param's mistake, noted; read as the pattern)
        if by_place and parameter.symbol == .lbrack and dc_parser.flags.report_now: by_place = rt_dc_mutable_pattern(parameter)
        p = mk(.param, mkpos(dc_parser.file, first.start))
        if angled: nodes[p].pos = mkpos(dc_parser.file, parameter.start)
        pattern = (parameter.symbol == .lbrack or parameter.symbol == .lparen) and not bare and not by_place and not angled
        if pattern:
            # `([a b]:array<int64>) => ...`, `((a b):array<int64>) => ...`: the argument unpacked
            # (dw_param's pattern)
            dc_parser.at += 1
            seen: int[]
            close = DewyToken.rbrack
            if parameter.symbol == .lparen: close = .rparen
            binders = rt_dc_binding_items(seen, close)
            if binders.len() == 0 or close == .rparen and binders.len() < 2: return 0
            nodes[p].name = i32(intern("$parameter{p}"))
            set_list(p, binders)
        else:
            # (`(new:int64)`, `(in:int64)`, `(from:int64)`: dc_parameter_word)
            if parameter.kind != .identifier or parameter.symbol != .none and parameter.symbol != .kw_test:
                if not rt_dc_parameter_word(parameter): return 0
            else if rt_dn_reserved(int(parameter.name)): rt_dc_reserved_at(parameter)
            dc_parser.at += 1
            nodes[p].name = parameter.name
        if by_place: add_flag(p, NF_MUT)
        if bare:
            ps.push(p)
            break
        kind = 0
        if keyword_only: kind = 1
        if angled:
            kind = 2
            if rt_dn_peek() != .colon: return 0
        dc_parser.reader.dc_kinds.push(kind)
        if rt_dn_accept(.colon):
            dc_parser.reader.dc_parameter_type = true
            if angled: dc_parser.reader.dc_type_args += 1
            type_at = dc_parser.at
            type_edits = dc_parser.reader.dn_edit_at.len()
            type_depth = dc_parser.depth
            saved_comma = dc_parser.flags.comma_stop
            if commas: dc_parser.flags.comma_stop = true
            annotation = rt_dc_annotation()
            if annotation == 0 and not commas and not bare and dc_parser.flags.report_now and rt_dn_peek() == .comma:
                commas = true
                dc_parser.at = type_at
                rt_dn_edits_undo(type_edits)
                dc_parser.depth = type_depth
                dc_parser.flags.comma_stop = true
                annotation = rt_dc_annotation()
            dc_parser.flags.comma_stop = saved_comma
            if angled: dc_parser.reader.dc_type_args -= 1
            dc_parser.reader.dc_parameter_type = false
            if annotation == 0: return 0
            nodes[p].a = i32(annotation)
            # (`value:int64 ...`: the positional run ends after this parameter; `...rest` attached
            # is a rest parameter, which dw_function reports)
            if rt_dn_peek() == .ellipsis and not bare and not angled:
                after = dc_parser.tokens[dc_parser.at + 1]
                if not after.space and after.kind == .identifier and not keyword_only:
                    if not rt_dc_rest_parameter(): return 0
                else:
                    if keyword_only or after.symbol == .assign or not after.space and after.kind == .identifier: return 0
                    dc_parser.at += 1
                    keyword_only = true
        if angled:
            if not rt_dn_accept(.rangle):
                if not (dc_parser.reader.dn_edits_on and rt_dn_closer_joined()): return 0
                rt_dn_split_closer()
            if rt_dn_peek() == .assign: return 0
        if rt_dn_accept(.assign):
            initial = rt_dc_expr(11)
            if initial == 0: return 0
            nodes[p].b = i32(initial)
        if pattern:
            loop leaf in binding_leaves(kids(p)):
                if not rt_dc_bind_once(bound, int(nodes[leaf].name)): return rt_dc_duplicate_parameter(leaf, lambda)
        else if not rt_dc_bind_once(bound, int(parameter.name)): return rt_dc_duplicate_parameter(p, lambda and not by_place)
        ps.push(p)
        # (`(a:int64, b:int64)`: dw_comma_fail's mistake at the parameter, noted; the rest read on)
        if rt_dn_peek() == .comma and commas:
            rt_dc_comma_mistake(mkpos(dc_parser.file, first.start))
            dc_parser.at += 1
    if name == "main" and (ps.len() > 1 or (ps.len() == 1 and has_flag(ps[0], NF_MUT))): return 0
    if dc_parser.reader.dc_kinds.len() > kinds_at:
        any_kind = false
        loop i in [kinds_at..dc_parser.reader.dc_kinds.len()): any_kind = any_kind or dc_parser.reader.dc_kinds[i] != 0
        if any_kind: dewy_param_kinds[n] = dc_parser.reader.dc_kinds[kinds_at..dc_parser.reader.dc_kinds.len())
        dc_parser.reader.dc_kinds.truncate(kinds_at)
    if captures.len() > 0:
        # (a generic function's second list holds its type parameters: its captures are a block)
        if type_params.len() > 0:
            listed = mk(.block, nodes[n].pos)
            set_list(listed, captures)
            nodes[n].d = i32(listed)
        else: set_list2(n, captures)
    if not bare and rt_dn_accept(.returns):
        # (`:> @T`: a method lending a place, its type kept apart, dw_function's place_written)
        if rt_dn_peek() == .at:
            dc_parser.at += 1
            written = rt_dc_annotation(dn_prefix_power(.at, false))
            if written == 0: return 0
            # (`:> @T | Busy`: the other alternatives are written for the reader only)
            loop rt_dn_peek() == .pipe:
                other = dc_parser.tokens[dc_parser.at + 1]
                if other.kind != .identifier or other.symbol != .none or dc_parser.tokens[dc_parser.at + 2].symbol != .pipe and dc_parser.tokens[dc_parser.at + 2].symbol != .function: return 0
                dc_parser.at += 2
            if rt_dn_peek() != .function: return 0
            place_written[n] = written
            dc_parser.reader.dn_edit_at.push(DN_EDIT_BIGINT - n)
            dc_parser.reader.dn_edit_was.push(dc_parser.tokens[dc_parser.at - 1])
        else if dc_parser.tokens[dc_parser.at].kind == .identifier and int(dc_parser.tokens[dc_parser.at].name) == dc_parser.reader.dn_void_id and dc_parser.tokens[dc_parser.at + 1].symbol != .pipe and not (dc_parser.tokens[dc_parser.at + 1].symbol == .amp and dc_parser.tokens[dc_parser.at + 2].symbol == .langle):
            dc_parser.at += 1
            add_flag(n, NF_VOID | NF_WRITTEN_VOID)
        else if proof_pending and rt_dn_peek() == .langle:
            # (`$proof` then `:><a <=? c>`: the propositions it proves, joined, dw_function)
            predicate = rt_dc_facts()
            if predicate == 0: return 0
            proof_decls[n] = predicate
            add_flag(n, NF_VOID)
        else if rt_dc_fact_result_next():
            result = rt_dc_fact_result(n)
            if result == 0: return 0
            nodes[n].a = i32(result)
        else:
            dc_parser.reader.dc_effects_follow = true
            dc_parser.reader.dc_grouped = 0
            result = rt_dc_annotation(30)
            dc_parser.reader.dc_effects_follow = false
            # (`:>A | B & no_effects` puts the row on the last alternative: an error; `(A | B) & ...`
            # is the row of the whole result)
            if result == 0 or nodes[result].kind == .tunion and result != dc_parser.reader.dc_grouped and rt_dn_peek() == .amp and not rt_dc_row_grouping(result): return 0
            packed = rt_dc_pack(result)
            if packed == result and nodes[packed].kind == .tarray and nodes[packed].ival < 0 and rt_dn_peek() == .amp: return 0
            nodes[n].a = i32(packed)
        if rt_dn_peek() == .amp and not rt_dc_effect_row(n): return 0
    if not rt_dn_accept(.function): return 0
    dc_parser.depth -= 1
    # (`() => $extern` as a value: dw_extern_finish's mistake)
    if lambda and dc_parser.tokens[dc_parser.at].kind == .metatag and dc_parser.flags.report_now and rt_dc_lambda_extern(): return rt_dc_extern(n, ps)
    if lambda:
        in_body = dc_parser.flags.fn_body
        dc_parser.flags.fn_body = true
        outer_result = dc_parser.reader.dc_fn_result
        dc_parser.reader.dc_fn_result = if nodes[n].a != 0: 2 else: 1
        saved_map = dc_parser.reader.dc_map_ok
        dc_parser.reader.dc_map_ok = false
        body = rt_dc_operand_body()
        dc_parser.reader.dc_map_ok = saved_map
        dc_parser.reader.dc_fn_result = outer_result
        dc_parser.flags.fn_body = in_body
        if body == 0: return 0
        dc_parser.depth -= 2
        return dw_finish_function(n, ps, body, name)
    # (`=> $extern(name='c_name')`: a C function, no body)
    if dc_parser.tokens[dc_parser.at].kind == .metatag and not dc_parser.reader.dc_method_body and rt_dn_payload(dc_parser.tokens[dc_parser.at]) == "extern": return rt_dc_extern(n, ps)
    # (`=> $intrinsic`: the compiler provides it, the declaration binds nothing: dw_intrinsic_check)
    if dc_parser.tokens[dc_parser.at].kind == .metatag and not dc_parser.reader.dc_method_body and type_params.len() == 0 and rt_dc_intrinsic_next():
        next = dc_parser.tokens[dc_parser.at + 1]
        if name == "" or next.kind != .eof and not (next.newline and dn_power(next.symbol) == 0 and next.symbol != .kw_not): return 0
        if intrinsic_of(intern(name)) < 0: return rt_dc_not_intrinsic(n, name)
        dc_parser.at += 1
        dc_parser.reader.dc_nothing = true
        return n
    concrete = type_params.len() == 0
    loop p in ps:
        if nodes[p].a == 0: concrete = false
    body = if concrete and not dc_parser.reader.dc_method_body and (nodes[n].a != 0 or dc_parser.tokens[dc_parser.at].kind == .lazy_body and has_flag(n, NF_VOID)): rt_dc_lazy_body() else: 0
    if body == 0 and dc_parser.tokens[dc_parser.at].kind == .lazy_body: dn_expand_lazy()
    if body == 0:
        dc_parser.flags.unread_here = true
        dc_parser.flags.fn_body = true
        outer_result = dc_parser.reader.dc_fn_result
        dc_parser.reader.dc_fn_result = if nodes[n].a != 0: 2 else: 1
        body = rt_dc_body()
        dc_parser.reader.dc_fn_result = outer_result
        dc_parser.flags.fn_body = false
        dc_parser.flags.unread_here = false
    if body == 0: return 0
    dc_parser.depth -= 2
    dw_finish_function(n, ps, body, name)

# (dw_intrinsic_check's mistake)

rt_dc_not_intrinsic = (n: int, name: str) -> int:
    if not dc_parser.flags.report_now: return 0
    rt_dc_fail_now(nodes[n].pos, "'{name}' is not a function the compiler provides, so it cannot be `$intrinsic`: give it a body, or `$extern` for a C function")

# A metatag among parameters at dc_parser.at: 0 for a lambda's `$capture`; 1 for a mistake noted and its
# tag read, another modifier or a module function's `$capture`; -1 a form left unread
# (dc_unread).

rt_dc_parameter_tag = (tag: DewyLexeme, lambda: bool) -> int:
    text = rt_dn_payload(tag)
    if lambda and text == "capture": return 0
    if not dc_parser.flags.report_now or text != "capture" and dw_designed_directive(text): return -1
    if text != "capture": rt_dc_report(mkpos(dc_parser.file, tag.start), "unknown parameter modifier `${text}` (the one modifier is `$capture`)")
    else: rt_dc_unsupported(mkpos(dc_parser.file, tag.start), "$capture on a module function")
    dc_parser.at += 1
    1

rt_dc_lambda_extern = () -> bool: rt_dn_payload(dc_parser.tokens[dc_parser.at]) == "extern"

# `:>A | B & no_effects`: the row on the last alternative (dw_effect_result's mistake, noted).

rt_dc_row_grouping = (result: int) -> bool:
    if not dc_parser.flags.report_now or dc_parser.tokens[dc_parser.at + 1].symbol == .tilde: return false
    rt_dc_report(nodes[kid(result, nkids(result) - 1)].pos, "effects describe the whole result: parenthesize the alternatives before them, `:>(A | B) & no_effects`")
    true

# `...rest` at the `...` among parameters (dw_function's mistake, noted; read as a parameter).

rt_dc_rest_parameter = () -> bool:
    name = dc_parser.tokens[dc_parser.at + 1]
    if not dc_parser.flags.report_now or name.space or name.kind != .identifier or name.symbol != .none: return false
    word = rt_dn_payload(name)
    rt_dc_report(mkpos(dc_parser.file, dc_parser.tokens[dc_parser.at].start), "rest parameters (`...{word}`) are not implemented yet; a bare `...` ends the positional run, so write `... {word}` for a keyword-only parameter")
    dc_parser.at += 1
    true

rt_dc_mutable_pattern = (first: DewyLexeme) -> bool:
    rt_dc_unsupported(mkpos(dc_parser.file, first.start), "unpacking a mutable parameter; use a named @ parameter")
    false

# `$capture` then another tag or the list's end: noted (the list's `(` is opening).

rt_dc_capture_missing = (next: DewyLexeme, opening: DewyLexeme) -> bool:
    if not dc_parser.flags.report_now: return false
    if next.symbol == .rparen: rt_dc_unsupported(mkpos(dc_parser.file, opening.start), "$capture without a local name")
    else if rt_dn_payload(next) == "capture": rt_dc_unsupported(mkpos(dc_parser.file, next.start), "$capture without a local name")
    true

# `$capture _`, `$capture @r.n`: noted, and the route read.

rt_dc_capture_other = (place: bool, target: DewyLexeme) -> bool:
    if not dc_parser.flags.report_now: return false
    at = target.start
    if place: at = dc_parser.tokens[dc_parser.at - 1].start
    rt_dc_unsupported(mkpos(dc_parser.file, at), "a capture other than an enclosing local name")
    dc_parser.at += 1
    loop rt_dn_peek() == .dot and dc_parser.tokens[dc_parser.at + 1].kind == .identifier:
        dc_parser.at += 2
    true

# `$extern`, `$extern(name='c_name' lib='m')` as a module function's body, at its tag (dw_ffi_body,
# dw_extern_finish). A form dw_extern_finish reports is left unread (dc_unread).
# (dw_extern_finish's and dw_ffi_options' mistakes, after any noted, should nothing else read the
# declaration)

rt_dc_extern_mistake = (pos: int, msg: str) -> int:
    if dc_parser.status.report_pos == 0: rt_dc_hint(pos, msg)
    0

rt_dc_extern = (n: int, ps: int[]) -> int:
    dc_parser.at += 1
    pos = nodes[n].pos
    # (dw_extern_finish's mistakes, noted: a lambda, no result type)
    if nodes[n].kind == .lambda or not has_flag(n, NF_GENERIC) and nodes[n].a == 0 and not has_flag(n, NF_VOID):
        if not dc_parser.flags.report_now: return 0
        if nodes[n].kind == .lambda: rt_dc_report(pos, "`$extern` declares a module-level function: `strlen = (s:ptr<uint8>):>uint64 => $extern`")
        else: rt_dc_report(pos, "a `$extern` function states its result type, `:>int32` or `:>void`: there is no body to infer it from")
    if has_flag(n, NF_GENERIC): return rt_dc_extern_mistake(pos, "a `$extern` function cannot be generic: C has one signature per symbol")
    symbol = ""
    library = ""
    listed_lib = false
    if rt_dn_peek() == .lparen and not dc_parser.tokens[dc_parser.at].space:
        dc_parser.at += 1
        loop not rt_dn_accept(.rparen):
            arg = dc_parser.tokens[dc_parser.at]
            if not rt_dc_named_next(): return rt_dc_extern_mistake(mkpos(dc_parser.file, arg.start), "`$extern` takes keyword arguments: name=, lib=")
            key = rt_dn_payload(arg)
            value = dc_parser.tokens[dc_parser.at + 2]
            if key != "name" and key != "lib": return rt_dc_extern_mistake(mkpos(dc_parser.file, arg.start), "`$extern` takes keyword arguments: name=, lib=")
            if value.kind != .quoted or not rt_dc_plain_quote(value): return rt_dc_extern_mistake(mkpos(dc_parser.file, value.start), "`$extern({key}=...)` takes a string literal")
            dc_parser.at += 3
            source = files[dc_parser.file].src
            width = dn_quote_width(source, value.start, value.stop)
            stop = value.stop - width
            problem = LiteralProblem("", 0, false)
            bytes_: u8[]
            if literal_string_text(problem, bytes_, source, value.start + width, stop) < stop or len(problem.message) > 0: return 0
            if key == "name" and symbol != "" or key == "lib" and listed_lib: return rt_dc_extern_mistake(mkpos(dc_parser.file, arg.start), "`{key}=` is given twice")
            if bytes_.len() == 0: return rt_dc_extern_mistake(mkpos(dc_parser.file, value.start), "`{key}=` needs a name")
            text = str_from_bytes(bytes_)
            if key == "name": symbol = text
            else:
                listed_lib = true
                library = text
    loop p in ps:
        if has_flag(p, NF_MUT): return rt_dc_extern_mistake(nodes[p].pos, "a C function takes values, not `@` places: pass a `ptr<T>`")
        if nodes[p].b != 0: return rt_dc_extern_mistake(nodes[p].pos, "a `$extern` parameter has no default: C gives every argument")
        if nodes[p].a == 0: return rt_dc_extern_mistake(nodes[p].pos, "a `$extern` parameter states its type: C has one signature per symbol")
        if nkids(p) > 0: return rt_dc_extern_mistake(nodes[p].pos, "a `$extern` parameter is one name")
    next = dc_parser.tokens[dc_parser.at]
    if next.kind != .eof and not (next.newline and dn_power(next.symbol) == 0 and next.symbol != .kw_not): return 0
    loop p in ps: dw_ffi_c_types(int(nodes[p].a))
    dw_ffi_c_types(int(nodes[n].a))
    add_flag(n, NF_EXTERN)
    set_list(n, ps)
    attrs: int[]
    if not target_wasm or listed_lib: attrs.push(dw_ffi_attr("lib", bc_str(dw_ffi_library(library), pos), pos))
    if symbol != "": attrs.push(dw_ffi_attr("symbol", bc_str(symbol, pos), pos))
    dw_ffi_attach(n, attrs)
    n

# A parameter binding n repeats one before it: dw_function's mistake, where the parameters are
# certainly a function's (a lambda's, or a declaration's whose `)` meets `=>`, dc_literal_at).

rt_dc_duplicate_parameter = (n: int, certain: bool) -> int:
    if certain or dc_parser.reader.dc_literal_at >= 0 and rt_dc_lambda_next_at(dc_parser.reader.dc_literal_at): fatal(nodes[n].pos, "duplicate parameter binding '{name_of(int(nodes[n].name))}'")
    0

# A parameter's name bound once among the function's (`_` any number of times).

rt_dc_bind_once = (bound: mut {int: bool}, named: int) -> bool:
    if named == 0 or rt_dc_word(named) == DC_HOLE: return true
    if bound.has(named): return false
    bound[named] = true
    true

# Statement contexts are distinct from arguments, parameters and record
# elements. Keep that context at the construction boundary.

rt_dc_statement = () -> int:
    start = dc_parser.at
    token = dc_parser.tokens[dc_parser.at]
    pos = mkpos(dc_parser.file, token.start)
    op = token.symbol
    splice = dc_parser.reader.dc_splice_ok
    dc_parser.reader.dc_splice_ok = false
    if op == .kw_if or op == .kw_loop:
        n = rt_dc_flow()
        if n == 0: return 0
        # (a chain folding to its compiled arm splices that arm's statements into a block that reads
        # it, dc_body_read)
        if dc_parser.reader.dc_live_at == start and op == .kw_if:
            if not splice or rt_dn_peek() == .semi or dc_parser.collection.tagged_last.has(n): return 0
            return n
        add_flag(n, NF_STMT)
        # (`loop c xs.pop();`: what the statement expresses is discarded)
        if rt_dc_accept_semi(not dc_parser.reader.dc_unbraced):
            discard = mk(.block, pos)
            set_list(discard, [n])
            add_flag(discard, NF_DISCARD)
            return discard
        return n
    if op == .kw_match:
        n = rt_dc_flow()
        if n == 0 or rt_dn_peek() == .semi: return 0
        add_flag(n, NF_STMT)
        return rt_dc_flow_stmt(n)
    if op == .kw_parallel:
        dc_parser.at += 1
        n = rt_dc_parallel(token, false)
        if n == 0 or rt_dn_peek() == .semi: return 0
        return n
    if op == .kw_concurrent:
        dc_parser.at += 1
        n = rt_dc_concurrent(token, true)
        if n == 0 or rt_dn_peek() == .semi: return 0
        return n
    if op == .kw_return:
        dc_parser.at += 1
        n = mk(.return_, pos)
        if dn_can_start(dc_parser.tokens, dc_parser.at) and not dc_parser.tokens[dc_parser.at].newline:
            value = rt_dc_expr(0)
            if value == 0: return 0
            nodes[n].a = i32(value)
        rt_dn_accept_semi()
        return n
    if op == .kw_break or op == .kw_continue:
        dc_parser.at += 1
        n = mk(if op == .kw_break: NK.break_ else: NK.continue_, pos)
        if dc_parser.tokens[dc_parser.at].kind == .metatag and not dc_parser.tokens[dc_parser.at].newline:
            nodes[n].name = i32(intern(rt_dn_payload(rt_dn_take())))
        rt_dn_accept_semi()
        return n
    if op == .kw_let or op == .kw_const:
        if rt_dc_local_type_next(): return rt_dc_local_type()
        dc_parser.at += 1
        return rt_dc_declaration(op == .kw_const)
    if token.kind == .identifier and dc_parser.tokens[dc_parser.at + 1].symbol == .colon: return rt_dc_declaration(false, true)
    if token.kind == .metatag:
        if not rt_dc_unsafe_at(dc_parser.at):
            width = token.stop - token.start
            if width == 7 and rt_dn_payload(token) == "expect" or width == 5 and rt_dn_payload(token) == "fail": return rt_dc_expect(token, width == 5)
            if width == 11 and rt_dn_payload(token) == "breakpoint": return rt_dc_breakpoint(token)
            if width == 14 and rt_dn_payload(token) == "include_bytes": return rt_dc_include_binding(token)
            # (`$unsafe_assume x`: dw_unimplemented's mistake)
            if dc_parser.flags.report_now and rt_dc_unbuilt(rt_dn_payload(token)): return rt_dc_fail_now(pos, metatag_fail_text(rt_dn_payload(token)))
            place_end = rt_dc_setting_place_end(dc_parser.at)
            if place_end > 0 and dc_parser.tokens[place_end].symbol == .assign: return rt_dc_body_setting(place_end)
            return rt_dc_assertion(token)
        dc_parser.at += 1
        n = rt_dc_statement()
        if n != 0: rt_dc_unsafe_scope(pos)
        return n
    if op == .lparen and rt_dc_update_next():
        update = rt_dc_grouped_update()
        if update == 0 or not rt_dc_flow_ends(): return 0
        return update
    # `[a b] = value`, `(a b) = values`: unpacked into names (dw_stmt's pattern target)
    if (op == .lbrack or op == .lparen) and dc_parser.tokens[rt_dc_closing(dc_parser.at) + 1].symbol == .assign: return rt_dc_unpacking_assignment(op == .lparen, pos)
    # Assignment operands are values rather than binding patterns.
    if token.kind != .identifier or (op != .none and op != .kw_test): return 0
    left = rt_dc_expr(11)
    # (`x => y = 1`: the lambda would be the target, an arm's mistake: dw_arm_fail)
    if left == 0 or nodes[left].kind == .lambda: return 0
    op = rt_dn_peek()
    if op == .colon and dc_parser.reader.dc_top_level: return rt_dc_def_habit(left)
    if op != .assign and not dn_token_assignment(op):
        # (no assignment follows: what was read is the statement's value, as dc_expr(0) reads it)
        dc_parser.reader.dc_value = left
        dc_parser.reader.dc_value_start = start
        return 0
    # (`none = 1`, `void = 1`: a reserved word cannot be bound)
    if op == .assign and (nodes[left].kind == .none_lit or nodes[left].kind == .ident and rt_dn_reserved(int(nodes[left].name))):
        # (at the top of a module, dw_top_declarations' mistake)
        if not dc_parser.reader.dc_top_level: return 0
        rt_dc_reserved_target(left)
    dc_parser.at += 1
    if not dc_parser.flags.fn_body and rt_dc_lambda_next(): return 0
    dc_parser.depth += 1
    right = rt_dc_expr(11)
    dc_parser.depth -= 1
    # (outside a function body, `name = (...) => ...` may declare a module function: a `$target`
    # arm's statements are module declarations, dw_top_declarations)
    if right == 0 or nodes[right].kind == .lambda and not dc_parser.flags.fn_body or rt_dc_inferred_refinement(right): return 0
    n = rt_dc_assign_node(op, left, right, pos)
    rt_dc_accept_semi(not dc_parser.reader.dc_unbraced)
    n

# `def main():` at the top of a module, the declaration's target no name (dw_declare's mistake,
# noted; its type read on); 0 for any other target.

rt_dc_def_habit = (left: int) -> int:
    pos = nodes[left].pos
    at = pos_off(pos)
    src = files[dc_parser.file].src
    habit = false
    loop w in ["def ", "function ", "fn ", "func "]:
        if at >= len(w) and src[at - len(w)..at) == w: habit = true
    if not habit: return 0
    rt_dc_report(pos, "a function is a value bound to its name: `main = () => \{ ... }`, `add = (a:int64 b:int64) => a + b`")
    dc_parser.at += 1
    if rt_dc_expr(46) == 0: return 0
    statement = mk(.exprstmt, pos)
    nodes[statement].a = i32(left)
    statement

# `let Name:type = ` in a body.

rt_dc_local_type_next = () -> bool:
    token = dc_parser.tokens[dc_parser.at + 1]
    annotation = dc_parser.tokens[dc_parser.at + 3]
    token.kind == .identifier and dc_parser.tokens[dc_parser.at + 2].symbol == .colon and annotation.kind == .identifier and annotation.name == i32(dc_parser.reader.dn_type_id) and dc_parser.tokens[dc_parser.at + 4].symbol == .assign

# `let Name:type = [fields]`, `let Name:type = T` in a body: a local record or alias (dw_declare's,
# no members recorded); a nominal type or an intersection is left unread (dc_unread).

rt_dc_local_type = () -> int:
    after = dc_parser.tokens[dc_parser.at + 5]
    if after.kind == .identifier and after.name == i32(dc_parser.reader.dn_type_id) and dc_parser.tokens[dc_parser.at + 6].symbol == .kw_of: return 0
    start = dc_parser.at
    dc_parser.at += 5
    if rt_dc_intersection_next(): return 0
    dc_parser.at = start
    saved = dc_parser.reader.dc_local_type_on
    dc_parser.reader.dc_local_type_on = true
    n = rt_dc_type_declaration()
    dc_parser.reader.dc_local_type_on = saved
    n

rt_dc_reserved_target = (left: int):
    if nodes[left].kind == .none_lit: rt_dc_report(nodes[left].pos, dewy_reserved_text("none"))
    else: rt_dc_report(nodes[left].pos, dewy_reserved_text(name_of(int(nodes[left].name))))

# `nonzero = int64 & ~0` at the top of a module names a refined type (dw_top_declarations), which
# is left unread (dc_unread).

rt_dc_inferred_refinement = (n: int) -> bool: dc_parser.reader.dc_top_level and nodes[n].kind == .binary and nodes[n].op == i32(int(Tok.amp)) and nodes[int(nodes[n].b)].kind == .not_

# `[a b] = value`, `(a b) = values` (grouped) at its opener: the pattern target's assignment.

rt_dc_unpacking_assignment = (grouped: bool, pos: int) -> int:
    dc_parser.at += 1
    seen: int[]
    close = DewyToken.rbrack
    if grouped: close = .rparen
    binders = rt_dc_binding_items(seen, close)
    if binders.len() == 0 or grouped and binders.len() < 2: return 0
    dc_parser.at += 1
    if rt_dc_lambda_next(): return 0
    dc_parser.depth += 1
    right = rt_dc_expr(11)
    dc_parser.depth -= 1
    if right == 0 or nodes[right].kind == .lambda: return 0
    pattern = mk(.tuple, pos)
    set_list(pattern, binders)
    n = mk(.assign, pos)
    nodes[n].op = i32(int(Tok.assign))
    nodes[n].a = i32(pattern)
    nodes[n].b = i32(right)
    rt_dc_accept_semi(not dc_parser.reader.dc_unbraced)
    n

# `target op= value` (dw_stmt's assignment).

rt_dc_assign_node = (op0: DewyToken, left: int, right: int, pos: int) -> int:
    op = op0
    n = mk(.assign, pos)
    scalar = dn_token_undot(op)
    if scalar != .none:
        add_flag(n, NF_BROADCAST)
        op = scalar
    nodes[n].op = i32(int(dn_assign_tok(op)))
    if op == .and_assign or op == .or_assign: nodes[n].aux2 = 1
    if op == .slash_assign or op == .floor_assign or op == .percent_assign or op == .power_assign:
        nodes[n].sval = i32(intern(if op == .slash_assign: "__dewy_divide" else if op == .floor_assign: "__floor_div" else if op == .percent_assign: "__floor_mod" else: "__dewy_power"))
    nodes[n].a = i32(left)
    nodes[n].b = i32(right)
    n

# `(count += 1)` is next: parentheses holding an update at their top.

rt_dc_update_next = () -> bool:
    close = rt_dc_closing(dc_parser.at)
    if close < 0 or dc_parser.tokens[dc_parser.at + 1].kind != .identifier: return false
    depth = 0
    loop k in [dc_parser.at + 1..close):
        symbol = dc_parser.tokens[k].symbol
        if symbol == .lparen or symbol == .lbrack or symbol == .lbrace: depth += 1
        else if symbol == .rparen or symbol == .rbrack or symbol == .rbrace: depth -= 1
        else if depth == 0 and dn_token_assignment(symbol): return true
    false

# A parenthesized update is the update (dw_stmt's grouped assignment): 0 for another form.

rt_dc_grouped_update = () -> int:
    dc_parser.at += 1
    pos = mkpos(dc_parser.file, dc_parser.tokens[dc_parser.at].start)
    left = rt_dc_expr(11)
    if left == 0 or nodes[left].kind == .lambda: return 0
    op = rt_dn_peek()
    if not dn_token_assignment(op): return 0
    dc_parser.at += 1
    right = rt_dc_expr(11)
    if right == 0 or nodes[right].kind == .lambda or not rt_dn_accept(.rparen): return 0
    rt_dc_assign_node(op, left, right, pos)

# `test "name" { ... }`: another language's test block, which dn_stmt reports.

rt_dc_test_block = (at: int) -> bool:
    token = dc_parser.tokens[at]
    if token.kind == .eof: return false
    next = dc_parser.tokens[at + 1]
    token.symbol == .kw_test and next.space and (next.kind == .quoted or next.kind == .rawquoted) and not next.newline

# An expression as a statement (dw_stmt); with its `;`, its value discarded (at `ended`, where
# the statement starts).

rt_dc_expression_statement = (ended: int, at: int, read: int) -> int:
    value = read
    first = dc_parser.at
    if value == 0: value = rt_dc_expr(0)
    if value == 0 or nodes[value].kind == .lambda or read == 0 and dc_parser.reader.dc_live_at == first and dc_parser.tokens[first].symbol == .kw_if: return 0
    if rt_dn_accept_semi():
        n = mk(.assign, ended)
        nodes[n].op = i32(int(Tok.assign))
        nodes[n].a = i32(mk(.hole, ended))
        nodes[n].b = i32(value)
        return n
    n = mk(.exprstmt, at)
    nodes[n].a = i32(value)
    n

# What follows ends the statement, as it ends an expression.

rt_dc_statement_ends = () -> bool:
    after = dc_parser.tokens[dc_parser.at]
    if after.kind == .eof: return true
    if dn_power(after.symbol) > 0 or after.symbol == .comma or after.symbol == .semi or after.symbol == .dot or after.symbol == .question or after.symbol == .ellipsis or after.symbol == .kw_or_throw or after.symbol == .kw_not: return false
    after.space or after.newline or after.symbol == .rbrace or after.symbol == .rparen or after.symbol == .rbrack

# `$unsafe` opens a boundary over the expression after it, on its line or the next
# (dn_directive): not `$unsafe=false`, a tag alone or one before another tag.

rt_dc_unsafe_at = (at: int) -> bool:
    if dc_parser.tokens[at].kind != .metatag or not dc_parser.reader.dn_edits_on: return false
    token = dc_parser.tokens[at]
    if token.stop - token.start != 7 or rt_dn_payload(token) != "unsafe": return false
    next = dc_parser.tokens[at + 1]
    dn_can_start(dc_parser.tokens, at + 1) and next.symbol != .assign and next.kind != .metatag

rt_dc_unsafe_scope = (at: int):
    if dc_parser.reader.dc_unsafe_name == 0: dc_parser.reader.dc_unsafe_name = intern("unsafe")
    last = dc_parser.tokens[dc_parser.at - 1]
    rt_dc_scope_undoable()
    dir_set(dc_parser.reader.dc_unsafe_name, 1, at, mkpos(dc_parser.file, last.stop - 1), at)

# The setting scopes pushed from here on go if this attempt is retried (dn_edits_undo).

rt_dc_scope_undoable = ():
    dc_parser.reader.dn_edit_at.push(-1 - dir_scopes.len())
    dc_parser.reader.dn_edit_was.push(dc_parser.tokens[dc_parser.at - 1])

# `$setting` or `$setting=true|false` alone as a block's statement: 1 on, 0 off; -1 when it is not
# that (dc_parser.at stays).

rt_dc_block_setting = () -> int:
    at = dc_parser.at + 1
    value = 1
    if dc_parser.tokens[at].symbol == .assign:
        written = dc_parser.tokens[at + 1]
        if written.kind != .boolean:
            # (`$prototype=1`: dw_dir_boolean's mistake, reported once the statement is read)
            if not dc_parser.flags.report_now or not rt_dc_lone_value(at + 1): return -1
            rt_dc_report(mkpos(dc_parser.file, written.start), "`${rt_dn_payload(dc_parser.tokens[dc_parser.at])}` takes a literal true or false")
        else if int(written.name) != dc_parser.reader.dn_true_id: value = 0
        at += 2
    next = dc_parser.tokens[at]
    if next.kind != .eof and next.symbol != .rbrace:
        if dn_power(next.symbol) > 0 or next.symbol == .kw_not or next.symbol == .dot or next.symbol == .question or next.symbol == .ellipsis or next.symbol == .semi: return -1
        if not next.space and not next.newline and (next.symbol == .lparen or next.symbol == .lbrack or next.symbol == .langle or next.kind == .quoted or next.kind == .rawquoted): return -1
    dc_parser.at = at
    value

# One token, a number, a string or a name, ending its statement.

rt_dc_lone_value = (at: int) -> bool:
    t = dc_parser.tokens[at]
    if not (t.kind == .source_integer or t.kind == .quoted or t.kind == .identifier and t.symbol == .none): return false
    next = dc_parser.tokens[at + 1]
    next.kind == .eof or next.symbol == .rbrace or next.newline and dn_power(next.symbol) == 0 and next.symbol != .kw_not and next.symbol != .dot

# `$assert condition`, `$runtime_assert condition, message`, or either with its arguments
# listed, `$assert(condition, "message")`: the statement calling the intrinsic, as
# dw_directive makes it. Other directives, settings and labels are left unread (dc_unread).

rt_dc_assert_alone = (token: DewyLexeme, runtime: bool) -> int:
    name = "assert"
    if runtime: name = "runtime_assert"
    dn_error(token.start, "`${name}` needs a condition: `${name} condition` or `${name} condition, \"message\"`")

rt_dc_assertion = (token: DewyLexeme) -> int:
    source = files[dc_parser.file].src
    width = token.stop - token.start - 1
    runtime = width == 14 and rt_dn_matches(source.data(), token.start + 1, token.stop, "runtime_assert")
    if not runtime and not (width == 6 and rt_dn_matches(source.data(), token.start + 1, token.stop, "assert")): return 0
    pos = mkpos(dc_parser.file, token.start)
    dc_parser.at += 1
    next = dc_parser.tokens[dc_parser.at]
    # (`$assert` alone: dn_directive's mistake)
    if next.newline or not dn_can_start(dc_parser.tokens, dc_parser.at): return rt_dc_assert_alone(token, runtime)
    listed = next.symbol == .lparen and not next.space
    if listed: dc_parser.at += 1
    first = dc_parser.tokens[dc_parser.at].start
    saved = dc_parser.flags.comma_stop
    dc_parser.flags.comma_stop = true
    condition = rt_dc_expr(0)
    # (a range the condition does not take leaves the cursor at -1)
    if condition == 0:
        dc_parser.flags.comma_stop = saved
        return 0
    stop = dc_parser.tokens[dc_parser.at - 1].stop
    message = 0
    if condition != 0 and rt_dn_accept(.comma):
        written = dc_parser.at
        message = rt_dc_expr(0)
        # (an `$assert` message is a plain string literal: is left unread (dc_unread) others)
        if message != 0 and not runtime and (dc_parser.at != written + 1 or nodes[message].kind != .str_lit or nodes[message].aux != 0):
            # (dw_directive's mistake, noted)
            if dc_parser.flags.report_now: rt_dc_report(mkpos(dc_parser.file, dc_parser.tokens[written].start), "a `$assert` message is a string literal: the compiler reports it")
            else: message = 0
        if message == 0: condition = 0
    dc_parser.flags.comma_stop = saved
    if condition == 0: return 0
    # (`$assert(1 <? 2` then `}`: dn_directive's mistake, should nothing else read it)
    if listed and not rt_dn_accept(.rparen): return rt_dc_hint(mkpos(dc_parser.file, dc_parser.tokens[dc_parser.at].start), "expected ')'")
    # (`$assert x >? 0;`: the statement ends, its value discarded, dw_stmt's statement end)
    ended = rt_dn_peek() == .semi and rt_dc_accept_semi(not dc_parser.reader.dc_unbraced)
    if not ended and not rt_dc_statement_ends(): return 0
    args = [condition]
    if message != 0: args.push(message)
    else if runtime:
        text = mk(.str_lit, pos)
        nodes[text].sval = i32(intern("assertion failed: " + join(words(source[first..stop)), " ")))
        args.push(text)
    callee = mk(.ident, pos)
    nodes[callee].name = i32(intern(if runtime: "$runtime_assert" else: "$assert"))
    call = mk(.call, pos)
    nodes[call].a = i32(callee)
    set_list(call, args)
    rt_dc_directive_statement(call, pos, ended)

# A directive's call as a statement (dw_stmt): with its `;` (ended), the value discarded.

rt_dc_directive_statement = (call: int, pos: int, ended: bool) -> int:
    if ended:
        n = mk(.assign, pos)
        nodes[n].op = i32(int(Tok.assign))
        nodes[n].a = i32(mk(.hole, pos))
        nodes[n].b = i32(call)
        return n
    n = mk(.exprstmt, pos)
    nodes[n].a = i32(call)
    n

# `$breakpoint` alone (dn_directive's form 3, dw_directive): the call showing the live bindings.

rt_dc_breakpoint = (token: DewyLexeme) -> int:
    pos = mkpos(dc_parser.file, token.start)
    dc_parser.at += 1
    ended = rt_dn_peek() == .semi and rt_dc_accept_semi(not dc_parser.reader.dc_unbraced)
    if not ended and not rt_dc_statement_ends(): return 0
    rt_dc_directive_statement(bc_call("$breakpoint", [], pos), pos, ended)

# `$test`, `$proof`, `$export`, `$shadowable` or `$explicit_allocation_failure` alone at the top of
# a module, marking what follows: its metatag syntax, as dn_atom reads it (dewy_fast_file,
# dw_top_declarations). 0 for any other form.

rt_dc_marker = (token: DewyLexeme) -> int:
    name = rt_dn_payload(token)
    if not (name == "test" or name == "proof" or name == "export" or name == "shadowable" or name == "explicit_allocation_failure"): return 0
    next = dc_parser.tokens[dc_parser.at + 1]
    if next.kind != .eof and not (next.newline and dn_power(next.symbol) == 0 and next.symbol != .kw_not):
        if not next.space or dn_power(next.symbol) > 0 or next.symbol == .kw_not or next.symbol == .semi or next.symbol == .dot or next.symbol == .question or next.symbol == .ellipsis: return 0
    start = dc_parser.at
    dn_expand_lazy()
    dc_parser.at += 1
    rt_module_tag(token, 1, 0, 0)


# `$test(cases=…)`, `$export(name='…')` or `$supported_targets = [...]` on a line of its own at the
# top of a module: a compact statement holding what its consumer reads (dw_test_spec's test,
# dw_export_begin's name, dw_supported_targets' names); 0 for any other form, or one they report.

rt_dc_directive_line = (token: DewyLexeme) -> int:
    name = rt_dn_payload(token)
    if name != "test" and name != "export" and name != "supported_targets": return 0
    start = dc_parser.at
    node_start = nodes.len()
    list_start = lists.len()
    pos = mkpos(dc_parser.file, token.start)
    after = dc_parser.tokens[dc_parser.at + 1]
    n = 0
    if name == "supported_targets":
        if after.symbol == .assign:
            dc_parser.at += 2
            n = rt_dc_target_list()
    else if after.symbol == .lparen and not after.space:
        dc_parser.at += 2
        dc_parser.depth = 0
        n = if name == "test": rt_dc_test_cases(pos) else: rt_dc_export_name(pos)
    next = dc_parser.tokens[dc_parser.at]
    if n == 0 or next.kind != .eof and not (next.newline and dn_power(next.symbol) == 0 and next.symbol != .kw_not):
        dc_parser.at = start
        nodes.truncate(node_start)
        lists.truncate(list_start)
        return 0
    rt_module_tag(token, if name == "test": 5 else: if name == "export": 2 else: 3, n, 0)

# `$test(` then its cases, through `)` (dw_test_spec): the test, its function still to come.

rt_dc_test_cases = (pos: int) -> int:
    key = dc_parser.tokens[dc_parser.at]
    # (dw_test_spec's mistakes, at once)
    if key.symbol == .rparen: fatal(pos, DC_TEST_USAGE)
    if key.kind != .identifier or rt_dn_payload(key) != "cases" or dc_parser.tokens[dc_parser.at + 1].symbol != .assign:
        if key.kind == .identifier and key.symbol == .none and dc_parser.tokens[dc_parser.at + 1].symbol == .assign: fatal(mkpos(dc_parser.file, key.start), DC_TEST_USAGE)
        return 0
    dc_parser.at += 2
    n = mk(.test_, pos)
    nodes[n].aux = 1
    nodes[n].ival = 1
    opening = dc_parser.tokens[dc_parser.at]
    if (opening.symbol == .lparen or opening.symbol == .lbrack) and not rt_dc_range_inside(dc_parser.at):
        dc_parser.at += 1
        close = if opening.symbol == .lparen: DewyToken.rparen else: DewyToken.rbrack
        cases: int[]
        loop not rt_dn_accept(close):
            element = dc_parser.tokens[dc_parser.at]
            if element.kind == .eof or element.symbol == .comma or element.symbol == .semi: return 0
            value = rt_dc_expr(0)
            if value == 0: return 0
            # (`[a=1 b=2]`: the case's arguments by name)
            args = [value]
            if nodes[value].kind == .record_lit and element.symbol == .lbrack:
                args = kids(value)
                loop arg in args:
                    if nodes[arg].kind != .namedarg or nodes[int(nodes[arg].a)].kind == .lambda: return 0
            case = mk(.block, mkpos(dc_parser.file, element.start))
            set_list(case, args)
            cases.push(case)
        if cases.len() == 0: fatal(mkpos(dc_parser.file, opening.start), "`$test(cases=…)` needs at least one case")
        set_list(n, cases)
    else:
        value = rt_dc_expr(0)
        if value == 0: return 0
        nodes[n].a = i32(value)
    if not rt_dn_accept(.rparen): return 0
    n

rt_dc_export_name = (pos: int) -> int:
    text = ""
    loop not rt_dn_accept(.rparen):
        value = dc_parser.tokens[dc_parser.at + 2]
        if not rt_dc_named_next() or rt_dn_payload(dc_parser.tokens[dc_parser.at]) != "name" or text != "" or value.kind != .quoted or not rt_dc_plain_quote(value): return 0
        literal = rt_dn_string(value)
        if literal == 0 or nodes[literal].kind != .str_lit or nkids(literal) > 0: return 0
        text = name_of(int(nodes[literal].sval))
        if text == "": return 0
        dc_parser.at += 3
    n = mk(.str_lit, pos)
    nodes[n].sval = i32(intern(text))
    n

# `[...]` of target names after `$supported_targets =` (dw_supported_targets): each a plain string
# literal naming a target.

rt_dc_target_list = () -> int:
    if rt_dn_peek() != .lbrack: return 0
    list = mk(.array, mkpos(dc_parser.file, dc_parser.tokens[dc_parser.at].start))
    dc_parser.at += 1
    names: int[]
    loop not rt_dn_accept(.rbrack):
        token = dc_parser.tokens[dc_parser.at]
        if token.kind != .quoted and token.kind != .rawquoted: return 0
        dc_parser.at += 1
        literal = rt_dn_string(token)
        if literal == 0: return 0
        if rt_dc_target_literal(literal, 0, false) == "":
            # (syntax_target_literal's mistake, should nothing else read it)
            if dc_parser.reader.dc_target_problem == -2: rt_dc_hint(nodes[literal].pos, rt_dc_target_text(name_of(int(nodes[literal].sval)), 0))
            return 0
        names.push(literal)
    set_list(list, names)
    list

# `$setting`, `$setting=true` or `$setting=false` on a line of its own at the top of a
# module: a compact statement naming the setting (child_right 1 on, 0 off), applied where
# dw_dir_statement applies one read from syntax (dw_top_declarations). Other metatag
# lines (directives, bundle definitions, build settings, markers) are left unread (dc_unread).
# `$name = { $setting  $setting=false  $default_row = <row> }` at a module's top: the bundle
# (dw_dir_define's), defined as it is read; 0 for a form is left unread (dc_unread).

rt_dc_bundle = (token: DewyLexeme) -> int:
    name = rt_dn_payload(token)
    if dc_parser.tokens[dc_parser.at + 1].symbol != .assign or dc_parser.tokens[dc_parser.at + 2].symbol != .lbrace or dw_dir_known(name): return 0
    # (dw_dir_define's mistakes)
    if dir_builtin(name) or name == "realtime": fatal(mkpos(dc_parser.file, token.start), "`${name}` is a builtin setting, not a bundle")
    if dir_bundle_index(intern(name)) >= 0: fatal(mkpos(dc_parser.file, token.start), "the bundle `${name}` is already defined")
    start = dc_parser.at
    bundle = DirBundle(intern(name), [], [], 0, mkpos(dc_parser.file, token.start), [], [])
    rows = effect_syntax.len()
    blocks = effect_blocks_demanded
    dc_parser.at += 3
    read = true
    loop read and not rt_dn_accept(.rbrace):
        member = dc_parser.tokens[dc_parser.at]
        # (dw_dir_define's mistakes, at once)
        if member.kind != .metatag: fatal(mkpos(dc_parser.file, member.start), "a bundle lists settings: `$name`, `$name=false`, or `$default_row = <effect row>`")
        else:
            text = rt_dn_payload(member)
            pos = mkpos(dc_parser.file, member.start)
            dc_parser.at += 1
            if text == "default_row":
                if bundle.row != 0 or not rt_dn_accept(.assign): fatal(pos, "`$default_row` takes one effect row, as written after `&` on a function: `$default_row = no allocates`")
                else:
                    if not rt_dc_effect_atom_start(dc_parser.tokens[dc_parser.at]): fatal(mkpos(dc_parser.file, dc_parser.tokens[dc_parser.at].start), "effect pilot requires reads<place>, mutates<place>, or no_effects")
                    entries: EffectSyntax[]
                    # (a bundle's row demands what it excludes only where it is applied: dir_apply_rows)
                    saved_demand = effect_panics_demanded
                    read = rt_dc_effect_entries(entries, true)
                    effect_panics_demanded = saved_demand
                    if read:
                        effect_syntax.push(entries)
                        bundle.row = effect_syntax.len() - 1
            else:
                enabled = 1
                if rt_dn_accept(.assign):
                    value = dc_parser.tokens[dc_parser.at]
                    if value.kind != .boolean:
                        if not rt_dc_lone_value(dc_parser.at): read = false
                        else if text != "unsafe" and text != "audited_wait": fatal(mkpos(dc_parser.file, value.start), "`${text}` takes a literal true or false")
                    else if int(value.name) != dc_parser.reader.dn_true_id: enabled = 0
                    dc_parser.at += 1
                if text == "unsafe" and read: fatal(pos, "`$unsafe` cannot be bundled: write it where the unsafe code is, so each boundary is visible")
                if text == "audited_wait" and read: fatal(pos, "`$audited_wait` cannot be bundled: write it in each audited adapter, so each audit is visible")
                else if text == "explicit_allocation_failure":
                    if enabled != 1 and read: fatal(pos, "a bundle can turn `$explicit_allocation_failure` on, not off: it is a module policy")
                    bundle.allocation_failure = true
                # (any other name is a bundle it includes, defined before or after: dir_bundle_resolve)
                else if not dir_builtin(text):
                    if dw_dir_known(text) and read: fatal(pos, "a bundle lists builtin settings (`$runtime_checks`, `$explicit_copies`, `$no_nan`, …), other bundles and `$default_row`, not `${text}`")
                    if enabled != 1 and read: fatal(pos, "a bundle includes another bundle whole: `${text}`, not `${text}=false`")
                    bundle.includes.push(intern(text))
                    bundle.include_at.push(pos)
                else:
                    bundle.settings.push(intern(text))
                    bundle.values.push(enabled)
        next = dc_parser.tokens[dc_parser.at]
        if read and not next.newline and next.symbol != .rbrace: read = false
    next = dc_parser.tokens[dc_parser.at]
    if not read or next.kind != .eof and not next.newline:
        dc_parser.at = start
        effect_syntax.truncate(rows)
        effect_blocks_demanded = blocks
        return 0
    dir_bundles.push(bundle)
    rt_module_empty(token.start)

# A directive of the design not built yet, written as a statement (dw_unimplemented's).

rt_dc_unbuilt = (name: str) -> bool: name == "unsafe_assume" or name == "abstract" or name == "no_prelude"

# A tag no top-level form takes when set (`$frob = 3`): dw_metatag_fail reports it.

rt_dc_tag_mistake = (name: str) -> bool: not dw_dir_name(name) and not dw_dir_known(name) and name != "supported_targets" and name != "target" and name != "build" and name != "export" and name != "test"

# `$warn_if condition "message"` on the line before a module function (dw_warn_if_attr): a
# compact statement holding the attribute the function takes (dw_top_declarations).

rt_dc_warn_if = (token: DewyLexeme) -> int:
    if token.stop - token.start != 8 or rt_dn_payload(token) != "warn_if": return 0
    pos = mkpos(dc_parser.file, token.start)
    dc_parser.at += 1
    if dc_parser.tokens[dc_parser.at].newline or not dn_can_start(dc_parser.tokens, dc_parser.at): fatal(pos, "`$warn_if` takes a condition and a message: `$warn_if condition \"message\"`")
    saved = dc_parser.flags.comma_stop
    dc_parser.flags.comma_stop = true
    condition = rt_dc_expr(0)
    if condition == 0: return 0
    rt_dn_accept(.comma)
    if dc_parser.tokens[dc_parser.at].newline or not dn_can_start(dc_parser.tokens, dc_parser.at): return dn_error(token.start, "`$warn_if` needs a message after its condition: `$warn_if condition \"message\"`")
    written = dc_parser.tokens[dc_parser.at]
    message = rt_dc_expr(0)
    dc_parser.flags.comma_stop = saved
    if message == 0: return 0
    if nodes[message].kind != .str_lit or written.kind != .quoted and written.kind != .rawquoted: fatal(mkpos(dc_parser.file, written.start), "a `$warn_if` message is a string literal: the compiler shows it")
    next = dc_parser.tokens[dc_parser.at]
    if next.kind != .eof and not next.newline: return 0
    at = dw_ffi_attr("warn_if", condition, pos)
    nodes[at].b = i32(message)
    rt_module_tag(token, 4, at, 0)

rt_dc_setting = (token: DewyLexeme) -> int:
    name = rt_dn_payload(token)
    if dn_directive_form(name) != 0 or not dw_dir_name(name): return 0
    at = dc_parser.at + 1
    enabled = 1
    if dc_parser.tokens[at].symbol == .assign:
        value = dc_parser.tokens[at + 1]
        if value.newline: return 0
        if value.kind != .boolean:
            # (`$explicit_copies = 1`: dw_dir_boolean's mistake)
            if rt_dc_lone_value(at + 1) or value.symbol == .lbrace and dir_builtin(name): return rt_dc_fail_now(mkpos(dc_parser.file, value.start), "`${name}` takes a literal true or false")
            return 0
        if int(value.name) != dc_parser.reader.dn_true_id: enabled = 0
        at += 2
    next = dc_parser.tokens[at]
    if next.kind != .eof and not (next.newline and dn_power(next.symbol) == 0 and next.symbol != .kw_not and next.symbol != .semi): return 0
    dc_parser.at = at
    rt_module_tag(token, 0, 0, enabled)

# Where `$target`, `$build` or a member of either written at token `at` ends (the token after it):
# -1 for anything else.

rt_dc_setting_place_end = (at: int) -> int:
    token = dc_parser.tokens[at]
    width = token.stop - token.start
    if not (width == 7 and rt_dn_payload(token) == "target" or width == 6 and rt_dn_payload(token) == "build"): return -1
    dot = dc_parser.tokens[at + 1]
    member = dc_parser.tokens[at + 2]
    if dot.symbol == .dot and not dot.space and not member.space and member.kind == .identifier: return at + 3
    at + 1

# How the setting place ending before token `place_stop` is written: `$target`, `$build`, `$build.mode`.

rt_dc_setting_text = (place_stop: int) -> str:
    start = if dc_parser.tokens[place_stop - 1].kind == .metatag: place_stop - 1 else: place_stop - 3
    text = "$" + rt_dn_payload(dc_parser.tokens[start])
    if place_stop - start == 3: text = text + "." + rt_dn_payload(dc_parser.tokens[place_stop - 1])
    text

# `$build.mode = 'release'` or `$target = 'aarch64-linux'` at the top of a module: checked and
# applied where it is (dw_build_setting); a statement declaring nothing. 0 for another form.

rt_dc_build_setting = () -> int:
    token = dc_parser.tokens[dc_parser.at]
    place_stop = rt_dc_setting_place_end(dc_parser.at)
    if place_stop < 0: return 0
    target = rt_dn_payload(token) == "target"
    assigned = dc_parser.tokens[place_stop].symbol == .assign
    if target and not assigned: return 0
    pos = mkpos(dc_parser.file, token.start)
    text = rt_dc_setting_text(place_stop)
    if text == "$target.arch" or text == "$target.os": fatal(pos, "`{text}` is part of the target: set the whole target, as `$target = 'aarch64-linux'`")
    if text == "$build": fatal(pos, "`$build` is set one member at a time: `$build.mode = 'release'`")
    if text != "$target" and text != "$build.mode":
        # (`$build.debug`: syntax_target_field's mistake)
        if target or not rt_dc_build_member(dc_parser.tokens[place_stop - 1], pos): return 0
        rt_dc_flush_report()
    if not assigned: fatal(pos, "`$build.mode` is set to 'debug' or 'release': `$build.mode = 'release'`")
    value = dc_parser.tokens[place_stop + 1]
    after = dc_parser.tokens[place_stop + 2]
    literal = if value.kind == .quoted and rt_dc_plain_quote(value) or value.kind == .rawquoted: rt_dn_string(value) else: 0
    if literal == 0 or nodes[literal].kind != .str_lit or nkids(literal) > 0 or after.kind != .eof and not after.newline:
        example = if target: "aarch64-linux" else: "release"
        fatal(mkpos(dc_parser.file, value.start), "`{text}` is set to a name in quotes, as `{text} = '{example}'`")
    build_setting_apply(target, text, pos, mkpos(dc_parser.file, value.start), name_of(int(nodes[literal].sval)))
    dc_parser.at = place_stop + 2
    rt_module_empty(token.start)

# `$build.mode = ...` in a body (dw_stmt's mistake, noted): the value read on.

rt_dc_body_setting = (place_stop: int) -> int:
    rt_dc_report(mkpos(dc_parser.file, dc_parser.tokens[dc_parser.at].start), "`{rt_dc_setting_text(place_stop)}` is set at the top level of the program's main file, on a line of its own")
    dc_parser.at = place_stop + 1
    rt_dc_expr(0)

rt_dn_statement = (top: bool = false) -> int:
    saved_now = dc_parser.flags.report_now
    dc_parser.flags.report_now = top
    read = rt_dn_statement_read(top)
    dc_parser.flags.report_now = saved_now
    read

rt_dn_statement_read = (top: bool) -> int:
    if top:
        dc_parser.status.hint_pos = 0
    # (`test "adds" { ... }`: dn_stmt's mistake, at once)
    if dc_parser.tokens[dc_parser.at].symbol == .kw_test and rt_dc_test_block(dc_parser.at): dn_error(dc_parser.tokens[dc_parser.at].start, "a test is a function marked `$test` on the line before it: `$test` then `let adds_numbers = () => $expect add(20 22) =? 42`")
    if top and dc_parser.tokens[dc_parser.at].kind == .metatag:
        built = rt_dc_build_setting()
        if built != 0: return built
        setting = rt_dc_setting(dc_parser.tokens[dc_parser.at])
        if setting != 0: return setting
        marker = rt_dc_marker(dc_parser.tokens[dc_parser.at])
        if marker != 0: return marker
        line = rt_dc_directive_line(dc_parser.tokens[dc_parser.at])
        if line != 0: return line
        bundle = rt_dc_bundle(dc_parser.tokens[dc_parser.at])
        if bundle != 0:
            rt_dc_flush_report()
            return bundle
        soft = rt_dc_warn_if(dc_parser.tokens[dc_parser.at])
        if soft != 0: return soft
        # (`$frob = 3`, `$no_prelude = true`, `$bogus` alone: dw_metatag_fail's mistake)
        alone = dc_parser.tokens[dc_parser.at + 1].kind == .eof or dc_parser.tokens[dc_parser.at + 1].newline and dc_parser.tokens[dc_parser.at + 1].symbol != .kw_loop and dn_power(dc_parser.tokens[dc_parser.at + 1].symbol) == 0
        if (alone or dc_parser.tokens[dc_parser.at + 1].symbol == .assign and dc_parser.tokens[dc_parser.at + 2].symbol != .lbrace) and rt_dc_tag_mistake(rt_dn_payload(dc_parser.tokens[dc_parser.at])): return rt_dc_fail_now(mkpos(dc_parser.file, dc_parser.tokens[dc_parser.at].start), metatag_fail_text(rt_dn_payload(dc_parser.tokens[dc_parser.at])))
    # (`$unsafe` then a declaration: its boundary covers the declaration, dw_top_declarations)
    head = dc_parser.at
    if top and rt_dc_unsafe_at(dc_parser.at): dc_parser.at += 1
    start = dc_parser.at
    node_start = nodes.len()
    list_start = lists.len()
    edits = dc_parser.reader.dn_edit_at.len()
    dc_parser.depth = 0
    value = 0
    report_pos = dc_parser.status.report_pos
    reports = dc_parser.status.reports
    if top:
        module_start = dc_parser.reader.module_nodes.len()
        module_lists = dc_parser.reader.module_lists.len()
        dc_parser.reader.dc_made.clear()
        word = dc_parser.tokens[dc_parser.at].symbol
        # `if $target =? "wasm32" { ... } else { ... }`: the compiled arm's declarations
        if word == .kw_if and dc_parser.tokens[dc_parser.at + 1].kind == .metatag:
            chain = rt_dc_target_chain()
            if chain != 0:
                if head != start: rt_dc_unsafe_scope(mkpos(dc_parser.file, dc_parser.tokens[head].start))
                rt_dn_edits_clear(edits)
                rt_dc_flush_report()
                return chain
            dc_parser.at = start
            dc_parser.reader.module_nodes.truncate(module_start)
            dc_parser.reader.module_lists.truncate(module_lists)
        value = if word == .kw_import or word == .kw_from: rt_dc_import() else: rt_dc_type_declaration()
        if value == 0:
            dc_parser.at = start
            nodes.truncate(node_start)
            lists.truncate(list_start)
            dc_parser.depth = 0
            dc_parser.reader.dc_nothing = false
            dc_parser.status.report_pos = report_pos
            dc_parser.status.reports = reports
            value = rt_dc_function()
            if dc_parser.reader.dc_nothing:
                dc_parser.reader.dc_nothing = false
                if value == 0 or head != start: value = 0
                else: return rt_dc_declares_nothing(head, node_start, list_start, edits)
        if value == 0:
            rt_dn_edits_undo(edits)
            dc_parser.at = start
            nodes.truncate(node_start)
            lists.truncate(list_start)
            dc_parser.reader.module_nodes.truncate(module_start)
            dc_parser.reader.module_lists.truncate(module_lists)
            dc_parser.reader.dc_made.clear()
            rt_dc_forget_tables(node_start)
            dc_parser.depth = 0
            dc_parser.status.report_pos = report_pos
            dc_parser.status.reports = reports
    # (in a block is left unread (dc_unread), a statement's syntax may be read as syntax: an
    # expression statement or `$unsafe` collects, dw_collect, and ends an arena's value,
    # dw_copy_result)
    if value == 0 and (top or not rt_dc_unsafe_at(start)):
        dc_parser.reader.dc_top_level = top
        value = rt_dc_statement()
        dc_parser.reader.dc_top_level = false
    if value == 0 and top and dc_parser.tokens[start].kind != .metatag and not rt_dc_test_block(start):
        read = 0
        if dc_parser.reader.dc_value_start == start: read = dc_parser.reader.dc_value
        else:
            dc_parser.at = start
            nodes.truncate(node_start)
            lists.truncate(list_start)
            rt_dn_edits_undo(edits)
            dc_parser.status.report_pos = report_pos
            dc_parser.status.reports = reports
        dc_parser.depth = 0
        value = rt_dc_expression_statement(mkpos(dc_parser.file, dc_parser.tokens[head].start), mkpos(dc_parser.file, dc_parser.tokens[start].start), read)
    dc_parser.reader.dc_value = 0
    dc_parser.reader.dc_value_start = -1
    if value == 0: rt_dc_unread(head)
    if head != start: rt_dc_unsafe_scope(mkpos(dc_parser.file, dc_parser.tokens[head].start))
    if top and dc_parser.status.reports != reports: rt_dc_flush_report()
    if top: rt_dn_edits_clear(edits)
    if top and dc_parser.reader.dc_made.len() > 0:
        made = dc_parser.reader.dc_made
        dc_parser.reader.dc_made = []
        return rt_module_group(dc_parser.tokens[head].start, made, -316)
    value


# (the member captures of closures and the propositions of proofs a discarded reading made: their
# nodes are gone)

rt_dc_forget_tables = (node_start: int):
    if dc_parser.reach.captures.len() > 0:
        gone: int[]
        loop n, members in dc_parser.reach.captures:
            if n >= node_start: gone.push(n)
        loop n in gone: dc_parser.reach.captures.remove(n)
    if proof_pending and proof_decls.len() > 0:
        proofs: int[]
        loop n, predicate in proof_decls:
            if n >= node_start: proofs.push(n)
        loop n in proofs: proof_decls.remove(n)

rt_dc_intrinsic_next = () -> bool: rt_dn_payload(dc_parser.tokens[dc_parser.at]) == "intrinsic"

# A module statement the direct grammar read that declares nothing (`name = (...) => $intrinsic`):
# its nodes go.

rt_dc_declares_nothing = (head: int, node_start: int, list_start: int, edits: int) -> int:
    stop = dc_parser.at
    rt_dn_edits_undo(edits)
    nodes.truncate(node_start)
    lists.truncate(list_start)
    dc_parser.at = stop
    rt_module_empty(dc_parser.tokens[head].start)

# `concurrent { ... }`, `concurrent name { ... }` after its keyword (dw_concurrent): `transparent`, a
# statement. Its statements are read directly, none deferred (a deferred `spawn` would be projected
# outside its group).

rt_dc_concurrent = (token: DewyLexeme, transparent: bool) -> int:
    pos = mkpos(dc_parser.file, token.start)
    # (its hidden names' number: beyond any syntax index)
    serial = (1 << 32) + nodes.len()
    name = "$group{serial}"
    if rt_dn_peek() != .lbrace:
        group = dc_parser.tokens[dc_parser.at]
        if group.kind != .identifier: return rt_dc_concurrent_mistake(group.start, "concurrent needs a group name or a braced body")
        if group.symbol != .none: return 0
        name = rt_dn_payload(group)
        # (a named group is placed at its name)
        pos = mkpos(dc_parser.file, group.start)
        dc_parser.at += 1
        if rt_dn_peek() != .lbrace: return rt_dc_concurrent_mistake(dc_parser.tokens[dc_parser.at].start, "concurrent needs a braced body")
    dw_task_groups.push(name)
    saved_unread = dc_parser.flags.unread_here
    dc_parser.flags.unread_here = false
    body = rt_dc_body()
    dc_parser.flags.unread_here = saved_unread
    dw_task_groups.pop()
    if body == 0 or not rt_dc_flow_ends(): return 0
    dw_task_group(pos, name, serial, body, transparent)

# (dn_atom's mistakes, at once)

rt_dc_concurrent_mistake = (at: int, msg: str) -> int:
    if not dc_parser.flags.report_now: return 0
    dn_error(at, msg)

# `spawn value`, `spawn(group) value` after its keyword (dw_spawn); `spawn(...)` as a call and
# `spawn` outside a group the direct grammar reads are left unread (dc_unread).

rt_dc_spawn = (token: DewyLexeme) -> int:
    pos = mkpos(dc_parser.file, token.start)
    next = rt_dn_peek()
    if next == .assign or next == .colon: return 0
    g = 0
    if next == .lparen and not dc_parser.tokens[dc_parser.at].space:
        close = rt_dc_closing(dc_parser.at)
        if close < 0: return 0
        after = dc_parser.tokens[close + 1]
        # (`spawn("/bin/sh" [])`: the process API's call, unless one group is followed by a value)
        call = close == dc_parser.at + 1 or not dn_can_start(dc_parser.tokens, close + 1) or after.newline or dn_power(after.symbol) > 0 or after.symbol == .kw_return or after.symbol == .kw_let or after.symbol == .kw_const or after.symbol == .kw_break or after.symbol == .kw_continue
        if not call:
            group_at = dc_parser.at
            node_start = nodes.len()
            list_start = lists.len()
            edits = dc_parser.reader.dn_edit_at.len()
            dc_parser.at += 1
            g = rt_dc_expr(0)
            if g == 0: return 0
            if dc_parser.at != close:
                call = true
                dc_parser.at = group_at
                nodes.truncate(node_start)
                lists.truncate(list_start)
                rt_dn_edits_undo(edits)
        if call:
            callee = mk(.ident, pos)
            nodes[callee].name = dw_value_name(i32(intern("spawn")), pos)
            return callee
        dc_parser.at += 1
    else if dw_task_groups.len() == 0:
        # (dw_spawn's mistake, noted; the value read on)
        if not dc_parser.flags.report_now: return 0
        rt_dc_report(pos, "spawn needs an enclosing concurrent group, or an explicit spawn(group)")
        g = mk(.hole, pos)
    else: g = bc_ident(dw_task_groups[dw_task_groups.len() - 1], pos)
    value = rt_dc_expr(0)
    if value == 0: return 0
    dw_task_spawn(g, value, pos)

# `$allocator(@arena) expression` after its tag (dw_allocator); an arena not lent by its place is left
# unread (dc_unread).

rt_dc_allocator = (token: DewyLexeme) -> int:
    pos = mkpos(dc_parser.file, token.start)
    if not rt_dn_accept(.lparen): return 0
    # (`$allocator(scratch)`: dw_allocator's mistake)
    if rt_dn_peek() != .at:
        if dc_parser.flags.report_now: return rt_dc_fail_now(mkpos(dc_parser.file, dc_parser.tokens[dc_parser.at].start), "`$allocator` lends an arena by its place: `$allocator(@scratch) expression`")
        return 0
    arena = rt_dc_expr(0)
    if arena == 0 or not rt_dn_accept(.rparen): return 0
    if not (has_flag(arena, NF_AT) or nodes[arena].kind == .call and (nodes[arena].aux2 == i32(AUX2_PARTIAL) or nodes[arena].aux2 == i32(AUX2_PLACE))): return 0
    dw_allocators += 1
    serial = dw_allocators
    first = dc_parser.at
    body = rt_dc_expr(0)
    if body == 0: return 0
    # (arena_no_return's mistake, noted)
    returned = arena_return_at(body)
    if returned != 0:
        if not dc_parser.flags.report_now: return 0
        rt_dc_report(nodes[returned].pos, "`return` inside an `$allocator` expression would leave it before its value is copied out of the arena: make the value the expression's result, and return after it")
    arena_enable()
    # (a braced body's value is its last statement's, dw_copy_result)
    copied = if dc_parser.tokens[first].symbol == .lbrace and rt_dc_closing(first) == dc_parser.at - 1 and nodes[body].kind == .block: rt_dc_copy_last(body) else: rt_dc_copy_value(body)
    dw_arena_scope(serial, arena, body, copied, pos)

# `$lend(@owner reserve=n) body` after its tag (dn_directive's form 4, dw_directive): the call
# lending the owner's bytes to the body.

rt_dc_lend = (token: DewyLexeme) -> int:
    pos = mkpos(dc_parser.file, token.start)
    if not rt_dn_accept(.lparen): return 0
    owner = rt_dc_expr(0)
    if owner == 0: return 0
    reservation = 0
    if dc_parser.tokens[dc_parser.at].kind == .identifier and rt_dn_payload(dc_parser.tokens[dc_parser.at]) == "reserve" and dc_parser.tokens[dc_parser.at + 1].symbol == .assign:
        dc_parser.at += 2
        reservation = rt_dc_expr(0)
        if reservation == 0: return 0
    if not rt_dn_accept(.rparen): return 0
    body = rt_dc_expr(0)
    if body == 0: return 0
    if reservation == 0: reservation = bc_int(0, pos)
    bc_call("$lend", [owner, reservation, body], pos)

# The value is written `....copy()` (dw_copy_result).

rt_dc_copy_value = (n: int) -> bool:
    dr_copy_value(nodes, lists, names, n)

rt_dc_copy_last = (block: int) -> bool:
    dr_copy_last(nodes, lists, names, block)


# A module-level `if` chain testing `$target` or `$build`, after which only the compiled arm's
# declarations exist (dw_target_splice): a flow holding that arm alone, its statements read as
# module statements (dn_statement); the names the other arms use are noted (dw_target_dropped).
# 0 before the compiled arm when a condition does not fold (is left unread (dc_unread) it).

rt_dc_target_chain = () -> int:
    start = dc_parser.tokens[dc_parser.at].start
    live = false
    compiled = 0
    loop true:
        dc_parser.at += 1
        tag = dc_parser.tokens[dc_parser.at]
        if not live and (tag.kind != .metatag or (rt_dn_payload(tag) != "target" and rt_dn_payload(tag) != "build")): return 0
        dc_parser.depth = 0
        condition = rt_dc_expr(0)
        if condition == 0 or not dn_can_start(dc_parser.tokens, dc_parser.at): return 0
        taken = false
        if not live:
            fold = rt_dc_target_fold(condition)
            if fold < 0: return 0
            taken = fold == 1
        if taken:
            if not rt_dc_module_block_next(): return 0
            compiled = rt_dc_module_block()
            live = true
        else:
            rt_dc_target_dropped(condition)
            if not rt_dc_dropped_arm(): return 0
        if not rt_dn_accept(.kw_else): break
        if rt_dn_peek() == .kw_if: continue
        if not live:
            if not rt_dc_module_block_next(): return 0
            compiled = rt_dc_module_block()
        else if not rt_dc_dropped_arm(): return 0
        break
    # (the compiled arm, alone: dw_top_declarations splices its declarations, dw_target_live)
    if compiled != 0:
        dc_parser.reader.module_nodes[-1 - compiled].pos = mkpos(dc_parser.file, start)
        return compiled
    rt_module_empty(start)

# A left-out arm, passed over: the names its tokens and its strings' interpolations use are noted
# (dw_target_dropped_name); false where it does not end.

rt_dc_dropped_arm = () -> bool:
    stop = dc_parser.at
    if rt_dn_peek() == .lbrace: stop = rt_dc_closing(dc_parser.at) + 1
    else: stop = rt_dc_arm_end(dc_parser.at)
    if stop <= dc_parser.at: return false
    rt_dc_dropped_names(dc_parser.tokens, dc_parser.at, stop)
    dc_parser.at = stop
    true

# Where an unbraced arm from token `at` ends, at bracket depth 0: before an `else` no `if` or
# `match` in it takes, a line that does not continue it, a closer, or the end.

rt_dc_arm_end = (at: int) -> int: dc_scan_arm_end(dc_parser.tokens, at)

rt_dc_dropped_names = (tokens: DewyLexeme[], first: int, stop: int):
    loop k in [first..stop):
        t = tokens[k]
        if t.kind == .identifier and (t.symbol == .none or t.symbol == .kw_test): dw_target_dropped_name(int(t.name), mkpos(dc_parser.file, t.start))
        else if t.kind == .quoted: rt_dc_dropped_quoted(t)

# (the names a string's interpolations use, lexed as dn_string reads them)

rt_dc_dropped_quoted = (token: DewyLexeme):
    source = files[dc_parser.file].src
    width = dn_quote_width(source, token.start, token.stop)
    i = token.start + width
    stop = token.stop - width
    problem = LiteralProblem("", 0, false)
    bytes_: u8[]
    loop i < stop:
        i = literal_string_text(problem, bytes_, source, i, stop)
        if len(problem.message) > 0 or i >= stop: return
        first = i + 1
        i = dn_interpolation_close(source, first, stop)
        end = dn_spec_colon(dn_lexer, source, first, i)
        if end < 0: end = i
        inner = dn_lex(dc_parser.file, first, end)
        rt_dc_dropped_names(inner, 0, inner.len())
        i += 1

# A braced arm is next that nothing after its `}` continues but `else` (as an arm's body,
# dn_expr would apply it).

rt_dc_module_block_next = () -> bool:
    if rt_dn_peek() != .lbrace: return false
    close = rt_dc_closing(dc_parser.at)
    if close < 0: return false
    after = dc_parser.tokens[close + 1]
    after.kind == .eof or after.symbol == .kw_else or after.newline and dn_power(after.symbol) == 0 and after.symbol != .kw_not

# `{ ... }` of module statements (dn_bracketed_from's braces), bodies read eagerly.

rt_dc_module_block = () -> int:
    opening = rt_dn_take()
    saved_rows = dc_parser.reader.dn_rows
    dc_parser.reader.dn_rows = false
    saved_lazy = dc_parser.reader.dc_lazy_on
    saved_lib = dc_parser.reader.dc_lib_lazy
    dc_parser.reader.dc_lazy_on = false
    dc_parser.reader.dc_lib_lazy = false
    children: int[]
    starts: int[]
    loop not rt_dn_accept(.rbrace):
        if dc_parser.tokens[dc_parser.at].kind == .eof: dn_error(opening.start, "expected '{dn_token_text(.rbrace)}' before end of file")
        before = dc_parser.at
        starts.push(dc_parser.tokens[before].start)
        children.push(rt_dn_statement(true))
        if dc_parser.at == before: dn_error(dc_parser.tokens[dc_parser.at].start, "expected a block element")
    dc_parser.reader.dc_lazy_on = saved_lazy
    dc_parser.reader.dc_lib_lazy = saved_lib
    dc_parser.reader.dn_rows = saved_rows
    rt_module_group(opening.start, children, -315, starts)

# `$expect condition [, message]`, `$fail [message]` after its tag, a statement (dw_expect). A form
# dw_expect reports, and a condition holding a comparison chain, are left unread (dc_unread).
# `$expect` outside a function, or in one giving a value (dw_expect's mistakes, noted).

rt_dc_expect_context = (token: DewyLexeme) -> bool:
    if not dc_parser.flags.report_now or dc_parser.reader.dc_fn_result < 0: return false
    name = rt_dn_payload(token)
    if dc_parser.reader.dc_fn_result == 0: rt_dc_report(mkpos(dc_parser.file, token.start), "`${name}` belongs in a function: a test, or a helper a test calls")
    else: rt_dc_report(mkpos(dc_parser.file, token.start), "`${name}` returns from its function when it fails, and this function gives a value: expectations live in `void` functions (a test, or a helper it calls); return the value to the test that checks it")
    true

rt_dc_expect = (token: DewyLexeme, fail: bool) -> int:
    if dc_parser.reader.dc_fn_result != 1 and not rt_dc_expect_context(token): return 0
    pos = mkpos(dc_parser.file, token.start)
    dc_parser.at += 1
    next = dc_parser.tokens[dc_parser.at]
    present = not next.newline and dn_can_start(dc_parser.tokens, dc_parser.at)
    condition = 0
    message = 0
    first = 0
    stop = 0
    described = ""
    saved = dc_parser.flags.comma_stop
    if fail:
        if present:
            dc_parser.flags.comma_stop = true
            message = rt_dc_expr(0)
            dc_parser.flags.comma_stop = saved
            if message == 0: return 0
    else:
        if not present: return 0
        listed = next.symbol == .lparen and not next.space
        if listed: dc_parser.at += 1
        first = dc_parser.at
        chains = dc_parser.reader.dc_chains_made
        dc_parser.flags.comma_stop = true
        condition = rt_dc_expr(0)
        stop = dc_parser.at
        if condition != 0 and rt_dn_accept(.comma):
            message = rt_dc_expr(0)
            if message == 0: condition = 0
        dc_parser.flags.comma_stop = saved
        if condition == 0 or listed and not rt_dn_accept(.rparen) or dc_parser.reader.dc_chains_made != chains: return 0
        source = files[dc_parser.file].src
        described = join(words(source[dc_parser.tokens[first].start..dc_parser.tokens[stop - 1].stop)), " ")
    if not rt_dc_statement_ends(): return 0
    where = pos
    notes = 0
    if condition != 0:
        where = mkpos(dc_parser.file, dc_parser.tokens[first].start)
        notes = rt_dc_expect_notes(condition, first, stop, described, pos)
        if notes == 0: return 0
    else: notes = dw_text("", pos)
    said = message
    if said == 0: said = dw_text("", pos)
    dw_expectation(pos, where, described, said, notes, condition)

# What a failed comparison shows of its operands (dw_expect_notes), the condition read from token
# first up to stop: each place written as a route (`xs.length`, `grid[0 1]`), each other operand
# but a literal as written, with its value read again. 0: an operand not read again.

rt_dc_expect_notes = (condition: int, first: int, stop: int, described: str, pos: int) -> int:
    root = condition
    # (a parenthesized condition, and a `not` before it, are no comparison)
    if dc_parser.tokens[first].symbol == .lparen and rt_dc_closing(first) == stop - 1: return dw_text("", pos)
    if nodes[root].kind == .not_:
        if dc_parser.tokens[first].symbol == .kw_not: return dw_text("", pos)
        root = int(nodes[root].a)
    if nodes[root].kind != .binary: return dw_text("", pos)
    t = Tok(int(nodes[root].op))
    if not (t == .eq or t == .lt or t == .le or t == .gt or t == .ge): return dw_text("", pos)
    # (the comparison's operator, the first outside brackets)
    depth = 0
    at = first
    op = DewyToken.none
    right = 0
    loop at < stop:
        symbol = dc_parser.tokens[at].symbol
        if symbol == .lparen or symbol == .lbrack or symbol == .lbrace: depth += 1
        else if symbol == .rparen or symbol == .rbrack or symbol == .rbrace: depth -= 1
        else if depth == 0:
            if symbol == .kw_not and at + 1 < stop and dn_token_invert(dc_parser.tokens[at + 1].symbol) != .none:
                op = dn_token_invert(dc_parser.tokens[at + 1].symbol)
                right = at + 2
                break
            scalar = dn_token_uninvert(symbol)
            if scalar == .eq or scalar == .lt or scalar == .le or scalar == .gt or scalar == .ge:
                op = symbol
                right = at + 1
                break
        at += 1
    if right == 0 or rt_dc_binary_token(dn_token_uninvert(op)) != t: return 0
    n = mk(.str_lit, pos)
    nodes[n].aux = 1
    pieces: int[]
    texts = dw_comparison_sides(described, dn_token_uninvert(op))
    sides = [int(nodes[root].a), int(nodes[root].b)]
    starts = [first, right]
    loop i in [0..2):
        side = sides[i]
        shown = rt_dc_operand_text(side, starts[i])
        if shown == "" and not rt_dc_literal_operand(side, starts[i]) and texts.len() == 2: shown = texts[i]
        if shown == "": continue
        lead = "note: "
        if pieces.len() > 0: lead = "\nnote: "
        pieces.push(dw_text("{lead}{shown} is ", pos))
        # (read again: the note evaluates its operand anew)
        saved_at = dc_parser.at
        saved_comma = dc_parser.flags.comma_stop
        dc_parser.at = starts[i]
        dc_parser.flags.comma_stop = true
        again = rt_dc_expr(dn_power(op) + 1)
        dc_parser.flags.comma_stop = saved_comma
        dc_parser.at = saved_at
        if again == 0: return 0
        part = mk(.pair, pos)
        nodes[part].a = i32(again)
        nodes[part].sval = -1
        pieces.push(part)
    if pieces.len() == 0: return dw_text("", pos)
    set_list(n, pieces)
    n

# A place's route as written (dw_operand_text): "" for anything else.

rt_dc_operand_text = (n: int, start: int) -> str:
    if dc_parser.tokens[start].kind != .identifier: return ""
    rt_dc_route_text(n)

rt_dc_route_text = (n: int) -> str:
    source = files[dc_parser.file].src
    at = pos_off(nodes[n].pos)
    if source[at] == '(': return ""
    k = nodes[n].kind
    if k == .ident: return rt_dc_word_at(at)
    if k == .field:
        base = rt_dc_route_text(int(nodes[n].a))
        if base != "": return "{base}.{name_of(int(nodes[n].name))}"
        return ""
    if k != .index: return ""
    base = rt_dc_route_text(int(nodes[n].a))
    indices: str[]
    loop entry in kids(n):
        written = pos_off(nodes[entry].pos)
        before = written - 1
        loop before > 0 and (source[before] == ' ' or source[before] == '\t'): before -= 1
        if source[before] == '(' or source[before] == '@': return ""
        if nodes[entry].kind == .int_lit and nodes[entry].aux2 == 0 and is_digit(source[written]): indices.push(rt_dc_word_at(written))
        else:
            inner = rt_dc_route_text(entry)
            if inner == "": return ""
            indices.push(inner)
    if base != "" and indices.len() > 0: return "{base}[{join(indices, " ")}]"
    ""

# The name or number written at offset at.

rt_dc_word_at = (at: int) -> str:
    source = files[dc_parser.file].src
    stop = at
    loop stop < len(source) and (is_alnum(source[stop]) or source[stop] == '_'): stop += 1
    source[at..stop)

# A literal operand (dw_literal_operand): its value is what is written.

rt_dc_literal_operand = (n: int, start: int) -> bool:
    if dc_parser.tokens[start].symbol == .lparen: return false
    rt_dc_literal_node(n)

rt_dc_literal_node = (n: int) -> bool:
    k = nodes[n].kind
    if k == .int_lit or k == .float_lit or k == .bool_lit or k == .none_lit: return true
    if k == .str_lit: return nodes[n].aux == 0
    if k == .call: return nodes[n].aux2 == -1
    if k != .array: return false
    loop item in kids(n):
        if has_flag(item, NF_SPREAD) or not rt_dc_literal_node(item): return false
    true

rt_dn_reserved = (name: int) -> bool: name < dc_parser.reader.dn_reserved_words.len() and dc_parser.reader.dn_reserved_words[name]

rt_dn_matches = (source: *u8, at: int, stop: int, value: str) -> bool:
    if len(value) > stop - at: return false
    loop i in [0..len(value)):
        if source[at + i] != value[i]: return false
    true

# Dispatch punctuation by its leading byte, trying only relevant longer
# spellings. Canonical token text avoids allocating a string per punctuation.

rt_dn_payload = (token: DewyLexeme) -> str:
    if token.symbol != .none: return dn_token_text(token.symbol)
    if token.name != 0: return name_of(int(token.name))
    source = files[dc_parser.file].src
    first = token.start
    if token.kind == .metatag: return source[first + 1..token.stop)
    if token.kind == .integer:
        return source[first..first + 2) + ":" + source[first + 2..token.stop)
    if token.kind == .based_string:
        return source[first..first + 2) + ":" + source[first + 3..token.stop - 1)
    if (token.kind == .source_integer or token.kind == .source_real) and first + 1 < token.stop and source[first] == '0' and source[first + 1] == 'd': first += 2
    source[first..token.stop)

rt_dn_peek = () -> DewyToken: dc_parser.tokens[dc_parser.at].symbol

rt_dn_take = () -> DewyLexeme:
    value = dc_parser.tokens[dc_parser.at]
    dc_parser.at += 1
    value

rt_dn_accept = (symbol: DewyToken) -> bool:
    if rt_dn_peek() != symbol: return false
    dc_parser.at += 1
    true

# A statement's `;` is attached to it, `f();`: an unattached one (after a space or
# on its own line) ends a row of an array literal, `[1 2 ; 3 4]`

rt_dn_accept_semi = () -> bool:
    if rt_dn_peek() != .semi: return false
    token = dc_parser.tokens[dc_parser.at]
    if dc_parser.reader.dn_rows and (token.space or token.newline): return false
    if token.space or token.newline: dn_error(token.start, "an unattached `;` is reserved for array-dimension selection: attach it to the statement it ends, `f();`, or leave it out")
    dc_parser.at += 1
    true

rt_module_tag = (token: DewyLexeme, form: int, value: int, enabled: int) -> int:
    id = node_mk(dc_parser.reader.module_nodes, .build_, mkpos(dc_parser.file, token.start))
    dc_parser.reader.module_nodes[id].ival = token.stop
    dc_parser.reader.module_nodes[id].aux = i32(form)
    dc_parser.reader.module_nodes[id].a = i32(value)
    dc_parser.reader.module_nodes[id].b = i32(enabled)
    -1 - id

rt_module_group = (offset: int, children: int[], form: int, starts: int[] = []) -> int:
    id = node_mk(dc_parser.reader.module_nodes, .block, mkpos(dc_parser.file, offset))
    dc_parser.reader.module_nodes[id].aux = i32(form)
    node_set_list(dc_parser.reader.module_nodes, dc_parser.reader.module_lists, id, children)
    if starts.len() > 0: node_set_list2(dc_parser.reader.module_nodes, dc_parser.reader.module_lists, id, starts)
    -1 - id

rt_module_empty = (offset: int) -> int:
    -1 - node_mk(dc_parser.reader.module_nodes, .nil, mkpos(dc_parser.file, offset))


# String decoding is shared; the construction target selects syntax nodes for
# the reference parser or compact nodes for the value parser.

rt_dn_text = (text: str, offset: int) -> int:
    n = mk(.str_lit, mkpos(dc_parser.file, offset))
    nodes[n].sval = i32(intern(text))
    n

# (a mistake in a string's escapes: one stops the compile)

rt_dn_string = (token: DewyLexeme) -> int:
    source = files[dc_parser.file].src
    raw = token.kind == .rawquoted
    opening = token.start
    if raw: opening += 1
    width = dn_quote_width(source, opening, token.stop)
    i = opening + width
    stop = token.stop - width
    if raw: return rt_dn_text(source[i..stop), token.start)
    chunks: int[]
    bytes_: u8[]
    chunk_start = i
    interpolated = false
    loop i < stop:
        # (literals.dewy reads the text up to an interpolation)
        i = literal_string_text(dc_parser.reader.dn_string_problem, bytes_, source, i, stop)
        if len(dc_parser.reader.dn_string_problem.message) > 0: dn_error(dc_parser.reader.dn_string_problem.at, dc_parser.reader.dn_string_problem.message)
        if i >= stop: break
        interpolated = true
        if bytes_.len() > 0:
            chunks.push(rt_dn_text(str_from_bytes(bytes_), chunk_start))
            bytes_.clear()
        first = i + 1
        i = dn_interpolation_close(source, first, stop)
        # (`{x:.2f}`: a format spec after the value's last top-level colon)
        colon = dn_spec_colon(dn_lexer, source, first, i)
        saved_tokens = dc_parser.tokens
        saved_at = dc_parser.at
        saved_angles = dc_parser.reader.dn_angles
        saved_comma = dc_parser.flags.comma_stop
        dc_parser.tokens = dn_lex(dc_parser.file, first, if colon >= 0: colon else: i)
        dc_parser.at = 0
        dc_parser.reader.dn_angles = 0
        dc_parser.flags.comma_stop = false
        dc_parser.reader.dn_in_interpolation += 1
        expression = rt_dc_expr(0)
        if expression != 0 and dc_parser.tokens[dc_parser.at].kind != .eof: dn_error(dc_parser.tokens[dc_parser.at].start, "expected one interpolation expression")
        dc_parser.reader.dn_in_interpolation -= 1
        dc_parser.tokens = saved_tokens
        dc_parser.at = saved_at
        dc_parser.reader.dn_angles = saved_angles
        dc_parser.flags.comma_stop = saved_comma
        spec = if colon >= 0: source[colon + 1..i) else: ""
        if expression == 0: return 0
        part = mk(.pair, mkpos(dc_parser.file, first))
        nodes[part].a = i32(expression)
        nodes[part].sval = if colon >= 0: i32(intern(spec)) else: -1
        chunks.push(part)
        i += 1
        chunk_start = i
    if not interpolated: return rt_dn_text(str_from_bytes(bytes_), token.start)
    if bytes_.len() > 0: chunks.push(rt_dn_text(str_from_bytes(bytes_), chunk_start))
    n = mk(.str_lit, mkpos(dc_parser.file, token.start))
    nodes[n].aux = 1
    set_list(n, chunks)
    n

# Splitting a generic closer edits its token in place. While a direct declaration
# may still retry the reference grammar, the original tokens are kept to restore.

rt_dn_token_edit = (at: int):
    if not dc_parser.reader.dn_edits_on: return
    dc_parser.reader.dn_edit_at.push(at)
    dc_parser.reader.dn_edit_was.push(dc_parser.tokens[at])

# Undo the edits recorded after `mark` (an abandoned attempt's), the latest first. An entry
# -(k + 1) is a setting scope the attempt set (dc_unsafe_scope): scopes from k on go;
# DN_EDIT_BIGINT, the module's bigint import the attempt asked for (dc_bigint_value); below it,
# DN_EDIT_BIGINT - n, the place type written for function n (dc_function_literal); below
# DN_EDIT_LIVE, DN_EDIT_LIVE - n, node n marked a live loop's source (dc_head_term).

rt_dn_edits_undo = (mark: int = 0, kept: bool = false):
    i = dc_parser.reader.dn_edit_at.len() - 1
    loop i >= mark:
        at = dc_parser.reader.dn_edit_at[i]
        if at == DN_EDIT_BIGINT: dw_bigint_import = 0
        else if at < DN_EDIT_BIGINT:
            if kept: at = 0
            else if at <= DN_EDIT_METHODS: dewy_methods.truncate(DN_EDIT_METHODS - at)
            else if at <= DN_EDIT_LIVE: dewy_live_sources.remove(DN_EDIT_LIVE - at)
            else: place_written.remove(DN_EDIT_BIGINT - at)
        else if at < 0: dir_scopes.truncate(-at - 1)
        else: dc_parser.tokens[at] = dc_parser.reader.dn_edit_was[i]
        i -= 1
    rt_dn_edits_clear(mark)

rt_dn_edits_clear = (mark: int = 0):
    dc_parser.reader.dn_edit_at.truncate(mark)
    dc_parser.reader.dn_edit_was.truncate(mark)

# A generic closer joined to what follows (`>>`, `>=`, `>?` unspaced) closes one angle:
# its first `>` is consumed in place, leaving the rest for the enclosing grammar.

rt_dn_closer_joined = () -> bool:
    op = rt_dn_peek()
    op == .shr or op == .shr_assign or op == .angle_assign or (op == .gt and not dc_parser.tokens[dc_parser.at].space)

rt_dn_split_closer = ():
    rt_dn_token_edit(dc_parser.at)
    dc_parser.tokens[dc_parser.at].start += 1
    tail = dc_parser.tokens[dc_parser.at]
    dc_parser.tokens[dc_parser.at].symbol = dn_token_kind(files[dc_parser.file].src[tail.start..tail.stop))

# `$shadowable const` (shadowable_decls) or the prelude, which is declared so as a
# whole: an inner scope or an importing module may bind the name anew.
decl_shadowable = (d: int) -> bool:
    d != 0 and (shadowable_decls.has(d) or modules[int(nodes[d].mod)].is_prelude)
ml_bump = ():
    ml_tick += 1
    ml_struct = ml_tick
# names starting with _ stay in their module: `use` does not bring them (`import m` reaches
# them as m._x, `from m import _x` by name). The library's are hidden from programs; its __
# names are the runtime's, which code the compiler writes calls
is_private = (name: int) -> bool:
    s = name_of(name)
    len(s) > 0 and s[0] == '_'
lib_private = (name: int) -> bool:
    s = name_of(name)
    len(s) > 1 and s[0] == '_' and s[1] != '_'
# The bundled exact fraction's types are the builtin `rational` and
# `rational<int64>`: their library names are not a second spelling.
rational_one_spelling = (im: int, nm: int, pos: int, how: str):
    if files[int(modules[im].file)].path != lib_dir + "/rational.dewy": return
    builtin = if name_of(nm) == "Rational": "rational" else if name_of(nm) == "RationalWord": "rational<int64>" else: ""
    if builtin != "": fatal(pos, "the exact fraction type is the builtin `{builtin}`: {how}write `{builtin}`")
# (the game loop's functions and main keep their own kind of result)
never_skip_result = (decl: int) -> bool:
    if nodes[decl].c != 0: return true          # (attributes: @cabi, @export... keep their types)
    nm = name_of(int(nodes[decl].name))
    nm == "main" or nm == "update" or nm == "draw"
# Normalize graph identity without changing source paths: library checks also
# accept a relative lib_dir and compare it with the original source spelling.
module_path_key = (path: str) -> str: module_key(path, cwd())
find_module = (path: str) -> int: module_by_path.get(module_path_key(path)) ?? -1
resolve_type = (tn: int) -> int: ct_resolve_type(tn)
readonly_global = (g: int) -> bool:
    d = int(globals[g].decl)
    d != 0 and has_flag(d, NF_RDONLY)
mk_fixed_checked = (e: int, n: int, pos: int) -> int:
    if tkind(e) == .void_: fatal(pos, "an array of void")
    mk_fixed(e, n)
# T[,], T[,,] ...: n-dimensional arrays (lib/std/nd.jo)
nd_of = (t: int, pos: int) -> int:
    s = prelude.get(intern("NDArray")) ?? 0
    if s == 0: fatal(pos, "n-dimensional arrays are not available (lib/std/nd.jo is missing)")
    get_struct_inst(int(syms[s].ref), [t])
# type Name[T] = ...: the type it stands for, given its type arguments
resolve_alias = (d: int, targs: int[], use_pos: int) -> int: ca_resolve_alias(d, targs, use_pos)
alias_resume = (d: int):
    if refine_deferred.len() > 0: refine_resume(int(nodes[d].mod))
push_type_params = (decl: int, targs: int[]):
    loop i in [0..nkids2(decl)):
        if i < targs.len() and (nodes[kid2(decl, i)].aux == 1) != (tkind(targs[i]) == .effect): fatal(nodes[kid2(decl, i)].pos, "generic argument kind mismatch: expected Effect or value type")
        if i < targs.len(): push_scope_sym(int(nodes[kid2(decl, i)].name), new_sym(int(nodes[kid2(decl, i)].name), .type_, targs[i], 0))
refine_resume = (m: int):
    if refine_active or not refine_deferred.has(m): return
    # (a forked check worker gives up its part: the compiler checks it again itself)
    if pc_child >= 0: exit(1)
    refine_active = true
# a refinement written in the type annotations under node n (a declaration's parameters and
# result, say)
written_refinement = (n: int) -> bool: cs_written_refinement(n)
new_inst = (kind: int, m: int, base: str) -> int:
    inst_counter += 1
    fns.push(FnInst(kind = i32(kind), mod = i32(m), sym = "f_{base}_{inst_counter}"))
    fns.len() - 1
has_value_return = (n: int) -> bool: cr_has_value_return(n)
value_leaves = (n: int, out: mut int[]): cr_value_leaves(n, out)
# the name of the type a Dewy method belongs to, or ""
method_type_name = (d: int) -> str:
    t = int(nodes[kid(d, 0)].a)
    if t == 0 or nodes[t].kind != .tname: return ""
    name_of(int(nodes[t].name))
syntactic_void = (body: int) -> bool: cr_syntactic_void(body)
ensure_ret = (f: int, use_pos: int):
    if fns[f].ret != 0: return
    cb_ensure_ret(f, use_pos)
leave_module_context = (m: int, entered: bool):
    if not entered: return
    module_frames[m] = ctxs.pop()
    module_ctx[m] = -1
# global g is changed here: in a function, that is something a call may do
note_global_write = (g: int):
    if globals[g].fn_written or cx < 0: return
    if fns[int(ctxs[cx].inst)].kind != i32(FK_INIT): globals[g].fn_written = true
    else: globals[g].init_written = true
# ---------------- statements ----------------
# (the library's exit(code): the program ends there)
library_exit_call = (e: int) -> bool:
    if nodes[e].kind != .call or nodes[e].sym <= 0 or int(nodes[e].sym) >= fns.len(): return false
    d = int(fns[int(nodes[e].sym)].decl)
    d != 0 and name_of(int(nodes[d].name)) == "exit" and pos_in_lib(nodes[d].pos)
# (a function's name as written: its body under `$explicit_allocation_failure` is `__eaf_NAME`)
oom_written_name = (id: int) -> str:
    name = name_of(id)
    if starts_with(name, "__eaf_"): return name[6..]
    name
set_block_value = (b: int, e: int): nodes[kid(b, nkids(b) - 1)].a = i32(e)
# A written result `:>(int64 int64)` (dw_pack_type): how many values it gives, or 0.
pack_result_count = (tn: int) -> int: if tn != 0 and nodes[tn].kind == .tarray and nodes[tn].ival < 0: int(-nodes[tn].ival) else: 0
# A binding's written type, where several values may be written, `let p:(int64 int64) = ...`.
resolve_binding_type = (tn: int) -> int: ct_resolve_binding(tn)
resolve_result_type = (tn: int) -> int: ct_resolve_result(tn)
# The iterator protocol: a value whose type has a `next` method, giving the next
# element or none, is iterated by calling it until none. `loop x in it` steps a
# copy of the iterator (its value at loop entry); `loop x in @it` steps the bound
# iterator in place, so the body can call its other methods to steer it (a tree
# walk's `skip_children`). The loop becomes a `loop true` whose body starts by
# taking the next element.
dewy_iterator_type = (t: int) -> bool:
    if types[t].kind != .struct_ or is_map_type(t) or is_map_entries_type(t) or is_dewy_cursor_iter(t): return false
    members = dewy_decl_members.get(int(structs[int(types[t].st)].decl)) ?? {}
    (members.get(intern("next")) ?? -1) >= 0
# After a loop's body: each written binder gets its declaration, and the loop a hidden
# element binder to copy from.
for_copied_binders = (s: int):
    if loop_copy_writes.len() == 0: return
    nodes[s].sym = i32(for_copied_binder(s, int(nodes[s].sym)))
    if nodes[s].aux == 3: nodes[s].aux2 = i32(for_copied_binder(s, int(nodes[s].aux2)))
mutable_loop_syntax = (pos: int) -> str:
    if files[pos_file(pos)].is_dewy: return "loop @item"
    "loop mut"
jd = (pos: int, jo: str, dewy: str) -> str: if dewy_at(pos): dewy else: jo
narrow_invalidate = (l: int):
    if int(locals[l].flags) & LF_UNNARROWED == 0:
        locals[l].flags = i32(int(locals[l].flags) | LF_UNNARROWED)
        narrow_changes.push(l)
narrow_merge = (changed: int[]):
    loop l in changed: narrow_invalidate(l)
narrow_store_keeps = (l: int, rhs: int, rt: int) -> bool:
    al = int(locals[l].alias)
    in_place = nodes[al].kind != .conv and nodes[al].kind != .if_
    in_place and not is_union(rt) and types[rt].kind != .opt and can_coerce(rhs, rt, int(locals[l].type))
# Reads that cannot run user code or change the place being updated. Checked
# custom indexing is a call and deliberately does not qualify.
pool_update_scalar = (n: int) -> bool:
    t = prune(ntype(n))
    is_numeric(t) or tkind(t) == .bool_
pool_library_fn = (f: int) -> bool:
    if f <= 0: return false
    d = int(fns[f].decl)
    d != 0 and decl_in_prelude(d) and files[pos_file(nodes[d].pos)].path == lib_dir + "/std/pool.jo"
check_assign = (s: int) -> int: va_assign(s)
# a function another engine would call, which nothing here does: one warning, saying what is
# called instead (not also that it is never called)
callback_warn = (gs: int, msg: str):
    d = int(syms[gs].decl)
    fn_used[d] = true
    warn(nodes[d].pos, msg)
check_vardecl = (s: int): vd_decl(s)
check_stmt = (s: int): bk_stmt(s)
# Local constants, dropped values, `when` and `defer` run in checker_statements.dewy;
# these are its services.
statement_bind = (name: int, g: int): push_scope_sym(name, new_sym(name, .const_, g, 0))
statement_error = (s: int): fatal(nodes[s].pos, "projected mutable postconditions with deferred cleanup are not yet supported")
return_sink = (pos: int):
    sink_return(pos)
    return
# (a generic instance's body: an error in the library's code is reported at the program's call)
check_fn_body = (f: int): cb_check_fn_body(f)
check_body_now = (f: int): cb_check_body_now(f)
# Repay with statement/expression checking and lowering-proof finalization cutovers.
# A body's result obligations run in checker_body_results.dewy; these are its services.
body_expression = (f: int, decl: int): xe_body(f, decl)
# Finalization runs in checker_zonk.dewy; these are its services.
body_finalize = (f: int, vars0: int, binds0: int, exposed0: int, da_mark: int): xz_finalize(f, vars0, binds0, exposed0, da_mark)
warn_unused_copy = (pos: int, name: str):
    alias = if files[pos_file(pos)].is_dewy: "loop @e in xs" else: "loop mut e in xs"
    warn(pos, "'{name}' is changed here but never read: it holds a copy (structs and arrays are values), so what it was copied from stays as it was; change that instead (`xs[i].hp -= 5`, `{alias}`)")
hidden_method_message = (dn: str, first: int) -> str:
    "'{dn}' hides the library's method `{dt(first)}.{dn}`: this function takes over every `x.{dn}` on one in this module; rename it to keep the library's"
zonk_tree = (root: int): xz_tree(root)
const_eval_bool = (e: int) -> bool: ceval(e).i != 0
runtime_demand = (name: str):
    if runtime_insts.has(name): return
    demand_name(intern(name))
    if prelude.get(intern(name)) != none: runtime_fn(name)
values_expand_error0 = (c: int): fatal(nodes[c].pos, "spreading a record's fields into named arguments is not implemented yet: pass them by name, `f(x=r.x)`")
values_expand_error1 = (c: int, t: int): fatal(nodes[c].pos, "`...` spreads a container into arguments: an array, a fixed array or a `[int64 string]` (found {dt(t)})")
values_expand_error2 = (items: int[], i: int): fatal(nodes[items[i]].pos, "only one array of unknown length can be spread into a call: its length is what the other arguments leave")
values_expand_error3 = (items: int[], dyn: int): fatal(nodes[items[dyn]].pos, "this array's length is not known here, so how many values it gives is not either: spread a fixed array (`array<int64 length=2>`), or call a function (with one version) whose positional parameters say how many")
values_expand_error4 = (items: int[], dyn: int, arity: int): fatal(nodes[items[dyn]].pos, "the other arguments already fill the {arity} positional parameters, so this spread array would give none")
values_group_error0 = (c: int): fatal(nodes[c].pos, "a group of values has no names: `(a b)`; a record is `[a=1 b=2]`")
values_count_label = (count: int): values_hint_label.push("{count}")
sink_error0 = (pos: int, vt: int, elem: int): fatal(pos, "this expresses {a_type(vt)}, and the values expressed before it are {dt(elem)}: the values one block expresses have one type; attach `;` to discard this one, as in `f();`, or convert it")
sink_error1 = (v: int): fatal(nodes[v].pos, "this gives a value, and here the block gives one, its last expression: attach `;` to discard this value, as in `f();`")
sink_error2 = (v: int): fatal(nodes[v].pos, "this expresses a value before the function's end, and the function also gives one back with `return`; a function expressing several values cannot `return` one yet: attach `;` to discard this value, as in `f();`")
sink_error3 = (v: int): fatal(nodes[v].pos, "this value is in a loop or a branch, or comes from a call that may give any number, so the block does not give a fixed number of values, and a binding holds a fixed number: collect them into an array, `[ ... ]`, or attach `;` to discard it, as in `f();`")
program_main_error0 = (st: int, s: int): fatal(nodes[st].pos, "main runs by itself, once, after the file's top-level statements: remove this call (a file without main runs top to bottom as a script)")
program_main_error1 = (s: int, rt: int): fatal(nodes[int(syms[s].decl)].pos, "main must return void or an integer exit code, found {dt(rt)}")
# Ownership calls this entry through check.jo; execution is in the Dewy leaf.
check_pending_functions = (start: int) -> int: run_pending_functions(start)

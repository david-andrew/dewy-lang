$runtime_checks
from p"lex.jo" import (lx_n lx_p lx_skip_str)

LexerLineWord:type=int64<overflow='wrap'>
# whether the rest of the line from `from` closes a bracket it did not open, or is another
# lambda's header (its indented body follows)
lx_line_closes=(from_:LexerLineWord):>bool=>$unsafe {
    let p=lx_p
    let j=from_
    let depth:LexerLineWord=0
    let last=uint8(0)
    loop j <? lx_n and p[j] not=? b'\n' {
        let c=p[j]
        if c =? b'#' {break}
        if c =? b'"' or c =? b'\'' {
            let raw=j >? 0 and p[j - 1] =? b'r'
            j=lx_skip_str(j raw)
            if j <? 0 {return false}
            last=uint8(b'"')
            continue
        }
        if c =? b'(' or c =? b'[' or c =? 123 {depth += 1} else if c =? b')' or c =? b']' or c =? 125 {
            depth -= 1
            if depth <? 0 {return true}
        }
        if c not=? b' ' and c not=? b'\t' and c not=? b'\r' {last=c}
        j += 1
    }
    # (a lambda's header: `(x):` or `(x) -> T:`, not the rest of `loop [k v] in m:`)
    let k=from_
    loop k <? lx_n and (p[k] =? b' ' or p[k] =? b'\t') {k += 1}
    depth =? 0 and last =? b':' and k <? lx_n and p[k] =? b'('
}

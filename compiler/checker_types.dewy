# Shared compiler layouts. Arenas and mutable globals stay with their Jo owners.
TK:type='void_' | 'bool_' | 'int_' | 'float_' | 'str_' | 'array' | 'ptr' | 'fn_' | 'struct_' | 'enum_' | 'tuple' | 'opt' | 'var' | 'param' | 'null_' | 'range' | 'module' | 'typeval' | 'none_lit' | 'vec' | 'cfn' | 'fixed' | 'box' | 'polyfn' | 'quantity' | 'dimension' | 'refined' | 'callable' | 'effect' | 'secret'

RepId:type='ordinary' | 'tagged_int'

TypeInfo:type=[
    kind:TK='void_'
    bits:int32=0
    sign:bool=false
    flags:int32=0
    elem:int32=0
    args:int32=0
    nargs:int32=0
    st:int32=0
    ref:int32=0
    id:int32=0
    mutmask:int32=0
    size:int32=0
    align:int32=0
    mod:int32=0
    rep:RepId='ordinary'
]

Field:type=[
    name:int32=0
    type:int32=0
    offset:int32=0
    defval:int32=0
    boxed:bool=false # its value is kept in a box (its type holds the struct it is in)
]

Variant:type=[
    name:int32=0
    fields:int32=0
    nfields:int32=0
    tag:int32=0
    value:int64=0
]

StructInfo:type=[
    drop_fn:int32=0
    decl:int32=0
    targs:int32=0
    ntargs:int32=0
    fields:int32=0
    nfields:int32=0
    variants:int32=0
    nvariants:int32=0
    payload_off:int32=0
    simple_enum:bool=false
    resolving:bool=false
    resolved:bool=false
    type:int32=0
    name:string=""
    union_:bool=false # A | B: an enum whose variant i holds type argument (member) i
    soa_:bool=false # soa T[]: a struct with an array for each field of T (type argument 0)
    record_:bool=false # anonymous Dewy record; fields are the shape and types are its arguments
    boxes_done:bool=false # which of its fields are boxed is known (decide_boxes)
    lit_set:int32=0 # a string literal set (`'a'|'b'`, refine.jo's str_sets): variant i is member i
]

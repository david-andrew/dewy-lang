$runtime_checks
from p"check.jo" import (home_first home_mod home_next homes_built modules)

HomeIndexWord:type=int64<overflow='wrap'>
home_add=(m:HomeIndexWord name:HomeIndexWord):>void=>{
    if home_first.length <=? name {home_first.resize(name * 2 + 64)}
    let h=HomeIndexWord(home_first[name])
    if h not=? 0 and home_mod[h - 1] =? m {return}
    home_mod.push(m)
    home_next.push(h)
    home_first[name]=home_mod.length
}

homes_build=():>void=>{
    let built = @homes_built
    built=true
    loop m in [0..modules.length) {
        if modules[m].is_prelude {continue}
        loop [k _] in modules[m].names {home_add(m k)}
    }
}

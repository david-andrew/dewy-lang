use 'ast.jo'
use 'check.jo'
use 'checker_expr.dewy'
use 'checks_builders.dewy'
use 'diagnostic_exit.dewy'
use 'effect_contracts.dewy'
use 'expr.jo'
use 'type_ops.dewy'
use 'types.jo'
use 'util.jo'

setting_value_body = (body: int, snapshot: str, pos: int) -> int:
    active = "$policy_active{body}"
    enter = bc_let(active, bc_call("__settings_policy_enter", [bc_ident(snapshot, pos)], pos), pos)
    cleanup = mk(.defer_, pos)
    # This compiler cleanup restores policy only; it never borrows a user owner.
    nodes[cleanup].aux2 = 1788  # SETTING_SCOPE_PREFIX, setting_scopes.dewy
    nodes[cleanup].a = i32(bc_stmt(bc_call("__settings_policy_leave", [bc_ident(active, pos)], pos), pos))
    if nodes[body].kind == .block:
        statements = [enter, cleanup]
        loop child in kids(body): statements.push(child)
        set_list(body, statements)
        return body
    bc_block([enter, cleanup, bc_stmt(body, pos)], pos)
setting_value_lambda = (n: int, expected: int) -> int:
    pos = nodes[n].pos
    setting_value_defaults(n, pos)
    snapshot = "$policy_snapshot{n}"
    lam = nodes.len()
    nodes.push(nodes[n])
    nodes[lam].b = i32(setting_value_body(int(nodes[lam].b), snapshot, pos))
    block = bc_block([bc_let(snapshot, bc_call("__settings_policy_capture", [], pos), pos), bc_stmt(lam, pos)], pos)
    nodes[n] = nodes[block]
    setting_value_wrapped[lam] = true
    # Coercion must still recognize the one-shot spawn body through this block.
    setting_value_targets[n] = lam
    result = check_expr(n, expected)
    setting_value_targets[n] = lam
    result
# Default keepers execute before the closure installs its captured policy.
# Only simple literals are independent of that ordering. Computed defaults can
# read time transitively, including through implicit zero-argument calls.
setting_default_policy = (n: int) -> bool:
    if n == 0: return false
    k = nodes[n].kind
    if k == .int_lit or k == .float_lit or k == .bool_lit or k == .none_lit or k == .null_lit: return false
    if k == .str_lit: return nkids(n) != 0
    if k == .unary or k == .not_:
        inner = nodes[int(nodes[n].a)].kind
        return inner != .int_lit and inner != .float_lit and inner != .bool_lit
    true
setting_value_defaults = (decl: int, pos: int):
    loop param in kids(decl):
        if nodes[param].kind == .param and setting_default_policy(int(nodes[param].b)):
            fatal(pos, "capturing time policies in a function value with computed or setting-dependent defaults is not yet supported; use a lambda such as `()=>today` so its defaults run under the captured policy")
setting_value_named = (n: int, t: int, expected: int) -> int:
    if nodes[n].aux == 1: return t  # C ABI function pointers have no policy environment.
    if nodes[n].aux == 2: return t  # The generic lambda body already captures its creation policy.
    pos = nodes[n].pos
    f = int(nodes[n].sym)
    decl = int(fns[f].decl)
    if int(types[callable_base(t)].bits) != 0: setting_value_defaults(decl, pos)
    params: int[]
    args: int[]
    loop i in [0..fns[f].ptypes.len()):
        param = mk(.param, pos)
        nodes[param].name = i32(intern("$policy_arg{i}"))
        nodes[param].a = i32(type_node_of(fns[f].ptypes[i], pos))
        if int(types[callable_base(t)].mutmask) & (1 << i) != 0: add_flag(param, NF_MUT)
        params.push(param)
        arg = bc_ident("$policy_arg{i}", pos)
        if int(types[callable_base(t)].mutmask) & (1 << i) != 0: add_flag(arg, NF_MUT)
        args.push(arg)
    call = mk(.call, pos)
    nodes[call].sym = i32(f)
    nodes[call].type = fns[f].ret
    add_flag(call, NF_CHECKED)
    set_list(call, args)
    # The arguments need binding in the wrapper before the direct call is checked.
    nodes[call].flags = 0
    nodes[call].type = 0
    head = mk(.fnref, pos)
    nodes[head].sym = i32(f)
    nodes[head].type = i32(t)
    add_flag(head, NF_CHECKED)
    nodes[call].a = i32(head)
    nodes[call].aux = 1
    lam = mk(.lambda, pos)
    set_list(lam, params)
    nodes[lam].b = i32(bc_block([bc_stmt(call, pos)], pos))
    nodes[n] = nodes[lam]
    result = setting_value_lambda(n, t)
    # Retain the named target's defaults and callable contract on the wrapper.
    nodes[n].type = i32(t)
    t
# Partial arguments are evaluated once at creation; the wrapper captures the
# same values together with the policy snapshot. Mutable bound arguments have
# the language's existing partial-application diagnostic.
setting_value_partial = (n: int, t: int, ptypes: int[], mutmask: int, ret: int) -> int:
    pos = nodes[n].pos
    prefix: int[]
    params: int[]
    args: int[]
    target = int(nodes[n].sym)
    head = int(nodes[n].a)
    if nodes[n].aux == 0 and target > 0:
        head = mk(.fnref, pos)
        nodes[head].sym = i32(target)
        nodes[head].type = i32(mk_fn(ptypes, ret, mutmask))
        add_flag(head, NF_CHECKED)
    else:
        name = "$policy_target{n}"
        prefix.push(bc_let(name, head, pos))
        head = bc_ident(name, pos)
    loop i in [0..nkids(n)):
        arg = kid(n, i)
        name = "$policy_bound{n}_{i}"
        if nodes[arg].kind == .hole:
            param = mk(.param, pos)
            nodes[param].name = i32(intern(name))
            nodes[param].a = i32(type_node_of(ptypes[i], pos))
            if mutmask & (1 << i) != 0: add_flag(param, NF_MUT)
            params.push(param)
        else:
            if mutmask & (1 << i) != 0: fatal(nodes[arg].pos, "cannot partially apply a `mut` argument; use `_` for it")
            prefix.push(bc_let(name, arg, pos))
        value = bc_ident(name, pos)
        if mutmask & (1 << i) != 0: add_flag(value, NF_MUT)
        args.push(value)
    call = mk(.call, pos)
    nodes[call].a = i32(head)
    set_list(call, args)
    lam = mk(.lambda, pos)
    set_list(lam, params)
    nodes[lam].b = i32(bc_block([bc_stmt(call, pos)], pos))
    prefix.push(bc_stmt(lam, pos))
    block = bc_block(prefix, pos)
    nodes[n] = nodes[block]
    result = check_expr(n, t)
    setting_value_targets[n] = setting_value_target(lam)
    result

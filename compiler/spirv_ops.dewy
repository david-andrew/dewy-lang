$runtime_checks
from p"ast.jo" import (kid nkids nodes)
from p"check.jo" import (fns modules)
from p"checks_thin_expr.dewy" import (is_gpu_buffer)
from p"expr.jo" import (ntype)
from p"glsl.jo" import (sl_type)
from p"spirv.jo" import (SC_FUNCTION SC_INPUT SC_PUSH sv_body sv_bound sv_cache sv_caps sv_const sv_dead sv_dec sv_global sv_iid sv_label sv_pc_var sv_rawptr sv_rawptr_w sv_stmt sv_type sv_type_key sv_val sv_vars sv_vid sv_word sv_word_ptr)
from p"types.jo" import (T_MAT4 types is_lib_texture)
from p"util.jo" import (fatal name_of)

SpirvWord:type=int64<overflow='wrap'>
sv_err=(pos:SpirvWord msg:string):>void=>{
    fatal(pos "in shader code: {msg}")
}
sv_pick=(c:bool a:SpirvWord b:SpirvWord):>int64=>{
    if c {return a}
    b
}
# ---------------- instructions ----------------
sv_ins=(@o:array<int64> op:SpirvWord args:array<int64>):>void=>{
    o.push((SpirvWord(args.length + 1) << 16) | op)
    loop a in args {o.push(a)}
}
sv_new=():>int64=>{
    sv_bound += 1
    sv_bound
}
sv_deco=(id:SpirvWord d:SpirvWord extra:array<int64>):>void=>{
    let a:array<int64>=[id d]
    loop x in extra {a.push(x)}
    sv_ins(@sv_dec 71 a)
}
sv_mdeco=(st:SpirvWord member:SpirvWord d:SpirvWord extra:array<int64>):>void=>{
    let a:array<int64>=[st member d]
    loop x in extra {a.push(x)}
    sv_ins(@sv_dec 72 a)
}
# an instruction in the function being translated (in a new, unreachable block after a branch)
sv_code=(op:SpirvWord args:array<int64>):>void=>{
    if sv_dead {sv_begin(sv_new())}
    sv_ins(@sv_body op args)
}
sv_begin=(label:SpirvWord):>void=>{
    sv_ins(@sv_body 248 [label])
    sv_label=label
    sv_dead=false
}
sv_cond_branch=(c:SpirvWord a:SpirvWord b:SpirvWord):>void=>{
    sv_code(250 [c a b])
    sv_dead=true
}
sv_void=():>int64=>{
    sv_type_key("void" 19 [])
}
sv_bool=():>int64=>{
    sv_type_key("bool" 20 [])
}
sv_f32=():>int64=>{
    sv_type_key("f32" 22 [32])
}
sv_i32=():>int64=>{
    sv_type_key("i32" 21 [32 1])
}
sv_u32=():>int64=>{
    sv_type_key("u32" 21 [32 0])
}
sv_vecf=(n:SpirvWord):>int64=>{
    sv_type_key("v{n}" 23 [sv_f32() n])
}
sv_veci=(n:SpirvWord):>int64=>{
    sv_type_key("iv{n}" 23 [sv_i32() n])
}
sv_vecb=(n:SpirvWord):>int64=>{
    sv_type_key("bv{n}" 23 [sv_bool() n])
}
sv_mat4=():>int64=>{
    sv_type_key("m4" 24 [sv_vecf(4) 4])
}
sv_ptr=(sc:SpirvWord t:SpirvWord):>int64=>{
    sv_type_key("p{sc},{t}" 32 [sc t])
}
sv_ci=(v:SpirvWord):>int64=>{
    sv_const(sv_i32() v & 0xFFFFFFFF)
}
sv_cu=(v:SpirvWord):>int64=>{
    sv_const(sv_u32() v & 0xFFFFFFFF)
}
# a variable of the current function (declared at the start of its first block)
sv_var=(ty:SpirvWord):>int64=>{
    let id=sv_new()
    sv_ins(@sv_vars 59 [sv_ptr(SC_FUNCTION ty) id SC_FUNCTION])
    id
}
sv_load=(ty:SpirvWord p:SpirvWord):>int64=>{
    sv_val(61 ty [p])
}
sv_store=(p:SpirvWord v:SpirvWord):>void=>{
    sv_code(62 [p v])
}
sv_pc_types=():>array<int64>=>{
    let r=sv_rawptr()
    [r r r sv_i32() sv_i32() sv_f32() sv_i32()]
}
sv_pc_get=(i:SpirvWord):>int64=>{
    let ty=sv_pc_types()[i]
    let p=sv_val(65 sv_ptr(SC_PUSH ty) [sv_pc_var() sv_ci(i)])
    sv_load(ty p)
}
sv_builtin_var=(ty:SpirvWord sc:SpirvWord builtin:SpirvWord):>int64=>{
    let v=sv_global(sv_ptr(sc ty) sc)
    sv_deco(v 11 [builtin])
    v
}
sv_vertex_id=():>int64=>{
    if sv_vid =? 0 {sv_vid=sv_builtin_var(sv_i32() SC_INPUT 42)}
    sv_load(sv_i32() sv_vid)
}
sv_instance_id=():>int64=>{
    if sv_iid =? 0 {sv_iid=sv_builtin_var(sv_i32() SC_INPUT 43)}
    sv_load(sv_i32() sv_iid)
}
sv_image_type=():>int64=>{
    sv_type_key("img2d" 25 [sv_f32() 1 0 0 0 1 0])
}
sv_sampled_type=():>int64=>{
    sv_type_key("simg2d" 27 [sv_image_type()])
}
# ---------------- statements ----------------
sv_stmts=(b:SpirvWord):>void=>{
    loop i in [0..nkids(b)) {sv_stmt(kid(b i))}
}
# ---------------- expressions ----------------
sv_is_floaty=(t0:SpirvWord):>bool=>$unsafe {
    let t=sl_type(t0)
    types.ptr[t].kind =? 'float_' or (types.ptr[t].kind =? 'vec' and not types.ptr[t].sign)
}
sv_is_vector=(t0:SpirvWord):>bool=>$unsafe {
    let t=sl_type(t0)
    types.ptr[t].kind =? 'vec' and t not=? T_MAT4
}
sv_ncomp=(t0:SpirvWord):>int64=>$unsafe {
    let t=sl_type(t0)
    if types.ptr[t].kind =? 'vec' {return SpirvWord(types.ptr[t].bits)}
    1
}
# a scalar as a vector of type t (all components equal)
sv_splat=(t:SpirvWord v:SpirvWord pos:SpirvWord):>int64=>{
    let parts:array<int64>=[]
    loop i in [0..sv_ncomp(t)) {parts.push(v)}
    sv_val(80 sv_type(t pos) parts)
}
# integers are 32 bits in shaders; an unsigned one (u8 u16 u32 u64) is held in the same bits
sv_unsigned=(t0:SpirvWord):>bool=>$unsafe {
    let t=sl_type(t0)
    types.ptr[t].kind =? 'int_' and not types.ptr[t].sign
}
# ---------------- GPU buffers (lib/game/gpubuffer.jo) ----------------
# A GpuBuffer here is (its address, its length): struct { uvec2, i32 }. Reads past either end read
# the nearest element; writes (and atomics) past them do nothing. Only compute programs write.
sv_uv2=():>int64=>{
    sv_type_key("uv2" 23 [sv_u32() 2])
}
sv_gbuf_type=():>int64=>{
    sv_type_key("gbuf" 30 [sv_uv2() sv_i32()])
}
sv_gbuf_ptr=(b:SpirvWord):>int64=>{
    sv_val(124 sv_rawptr_w() [sv_val(81 sv_uv2() [b 0])])
}
sv_gbuf_len=(b:SpirvWord):>int64=>{
    sv_val(81 sv_i32() [b 1])
}
# e is a call of the library's operation `name` on a GpuBuffer (its first argument)
sv_is_gbuf_op=(e:SpirvWord name:string):>bool=>$unsafe {
    if nodes.ptr[e].kind not=? 'call' or nodes.ptr[e].aux not=? 0 or nkids(e) =? 0 {return false}
    let decl=SpirvWord(fns.ptr[SpirvWord(nodes.ptr[e].sym)].decl)
    decl not=? 0 and modules[SpirvWord(nodes.ptr[decl].mod)].is_prelude and name_of(SpirvWord(nodes.ptr[decl].name)) =? name and is_gpu_buffer(ntype(kid(e 0)))
}
sv_store_word=(base:SpirvWord c:SpirvWord d:SpirvWord w:SpirvWord):>void=>{
    sv_code(62 [sv_word_ptr(base c d) w 2 4])
}
# ---------------- subgroups ----------------
sv_cap=(c:SpirvWord):>void=>{
    if sv_cache.get("cap{c}") not=? none {return}
    sv_cache["cap{c}"]=1
    sv_ins(@sv_caps 17 [c])
}
sv_is_int_leaf=(t0:SpirvWord):>bool=>$unsafe {
    let t=sl_type(t0)
    if types.ptr[t].kind =? 'fixed' {return sv_is_int_leaf(SpirvWord(types.ptr[t].elem))}
    types.ptr[t].kind =? 'int_' or (types.ptr[t].kind =? 'vec' and types.ptr[t].sign) or (types.ptr[t].kind =? 'struct_' and is_lib_texture(SpirvWord(types.ptr[t].st)))
}
# a buffer address from two words (low, high) of the parameters
sv_addr_at=(params:SpirvWord word:SpirvWord ptrty:SpirvWord):>int64=>{
    let v=sv_val(80 sv_type_key("uv2" 23 [sv_u32() 2]) [sv_word(params word * 4 0) sv_word(params word * 4 + 4 0)])
    sv_val(124 ptrty [v])
}

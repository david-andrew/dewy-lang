use 'ir_types.dewy'
# Machine code made on several processors (x86-64): after every function is lowered, worker
# processes (fork: each starts as a copy of the compiler, the checked program and its IR
# included) each emit the code of a run of consecutive functions, and send back the code and
# what the tables need of it (calls and data to fix up, symbols, line rows, unwind and debugger
# information, new constants). The compiler joins them in order, moving each run's offsets to
# where its code lands: the same bytes as emitting the functions one after another here (each
# function starts at a multiple of 16, as it would anyway; constants get their places in the
# order they are first used, as they would anyway; a function whose branch pads would fall
# elsewhere where it lands is made again here). A worker that fails has its run emitted here.

use 'main.jo'
use 'util.jo'
use 'ir.jo'
use 'x64.jo'
use 'elf.jo'
use 'pe.jo'
use 'check.jo'
use 'watch.jo'
use 'lower.jo'
use 'types.jo'
use 'ast.jo'
use 'fused.jo'

# (DEWY_EMIT_WORKERS=n: how many; 1: none. DEWY_EMIT_FORCE=1: workers even for a small
# program, for tests. DEWY_PAR_TIME=1: how long each part took)
emit_workers = () -> int:
    n = 1
    when not BOOTSTRAP: n = min(cpu_count(), 16)          # (the C bootstrap's compiler: one)
    if let w = env("DEWY_EMIT_WORKERS"): n = to_int(w) ?? n
    n

# true when the queued functions' code was made in parallel (and joined)
emit_parallel = (q: IrFn[], fin: bool[]) -> bool:
    when TARGET == "windows" or TARGET == "wasm":
        return false
    else:
        if target_wasm or target_arm64 or ra_stat or watch_build or repl_image or len(ra_dump) > 0: return false
        total = 0
        loop f in q: total += f.code.len()
        n = emit_workers()
        # (each worker should have enough to make the fork worth it)
        n = min(n, total / 20000)
        forced = env("DEWY_EMIT_FORCE") != none
        if forced: n = max(emit_workers(), 1)
        if (n < 2 and not forced) or q.len() < n: return false
        # runs of consecutive functions with about the same amount of IR each
        cuts = [0]
        acc = 0
        loop k in 0.. and f in q:
            acc += f.code.len()
            if acc * n >= total * cuts.len() and cuts.len() < n and k + 1 < q.len(): cuts.push(k + 1)
        cuts.push(q.len())
        # (forked one by one and read in order: each pipe holds what a worker writes until read)
        r0 = rodata.len()
        tm = env("DEWY_PAR_TIME") != none
        ta = time()
        pids: int[]
        fds: int[]
        loop w in [0..cuts.len() - 1):
            pfd = [0]
            if syscall(293, data(pfd), 0x80000) != 0:
                pids.push(-1)
                fds.push(-1)
                continue
            rfd = pfd[0] & 0xFFFFFFFF
            wfd = pfd[0] >> 32
            pid = syscall(57)
            if pid == 0:
                syscall(3, rfd)
                if (env("DEWY_EMIT_FAIL_WORKER") ?? "") == "{w}": exit(1)
                par_worker(q, fin, cuts[w], cuts[w + 1], r0, wfd)
            syscall(3, wfd)
            if pid < 0:
                syscall(3, rfd)
                pids.push(-1)
                fds.push(-1)
            else:
                pids.push(pid)
                fds.push(rfd)
        tb = time()
        tread = 0.0
        tjoin = 0.0
        loop w in [0..cuts.len() - 1):
            got: u8[]
            ok = fds[w] >= 0
            if ok:
                t_0 = time()
                got = par_read(fds[w])
                tread += time() - t_0
                syscall(3, fds[w])
                st = [0]
                syscall(61, pids[w], data(st), 0, 0)
                ok = st[0] & 0xFFFF == 0 and got.len() >= 8
            if ok:
                t_1 = time()
                par_join(got, r0, q, fin, cuts[w])
                tjoin += time() - t_1
            else:
                # (that run, here)
                loop k in [cuts[w]..cuts[w + 1]):
                    ir = q[k]
                    emit_now(fin[k])
        if tm: eprint("emit: {cuts.len() - 1} workers, fork {(tb - ta) * 1000.0:.1} ms, waiting and reading {tread * 1000.0:.1} ms, joining {tjoin * 1000.0:.1} ms, {par_here} functions again here")
        true

# everything a pipe gives until it is closed
par_read = (fd: int) -> u8[]:
    out: u8[]
    loop true:
        n = out.len()
        out.resize(n + 262144)
        r = syscall(0, fd, data(out) + n, 262144)
        if r <= 0:
            out.resize(n)
            return out
        out.resize(n + r)

# ---- a worker: emit q[a..b), write what came of it to fd, end ----
par_worker = (q: IrFn[], fin: bool[], a: int, b: int, r0: int, fd: int):
    code = []
    call_fix = []
    data_fix = []
    stub_fix = []
    cabi_fix = []
    cabi_adapter = {}
    elf_syms = []
    line_rows = []
    call_sites = []
    unwind_fns = []
    uw_data = []
    dbg_raw = []
    dbg_cfi = []
    ro_new = []
    tw0 = time()
    out: u8[]
    pw(out, b - a)
    loop k in [a..b):
        ir = q[k]
        # (where it starts in each table: par_join's marks)
        at: int[] = [code.len(), call_fix.len(), data_fix.len(), stub_fix.len(), cabi_fix.len(), elf_syms.len(), line_rows.len(), call_sites.len(), unwind_fns.len(), uw_data.len(), dbg_raw.len(), dbg_cfi.len(), ro_new.len()]
        emit_now(fin[k])
        pw(out, ir.fn_index)
        pw(out, fn_addr[ir.fn_index])
        pw(out, fn_len[ir.fn_index])
        moved = 0
        if pad_moves: moved = 1
        pw(out, moved)
        loop x in at: pw(out, x)
    tw1 = time()
    pw(out, code.len())
    out.reserve(out.len() + code.len() + 16 * (call_fix.len() + data_fix.len() + line_rows.len() + call_sites.len()) + 1024)
    when BOOTSTRAP:
        loop c in code: out.push(c)
    else: out.extend(code)
    pw(out, call_fix.len())
    loop f in call_fix:
        pw(out, f.0)
        pw(out, f.1)
    pw(out, data_fix.len())
    loop f in data_fix:
        pw(out, f.0)
        pw(out, f.1)
        pw(out, f.2)
    pw(out, stub_fix.len())
    loop f in stub_fix:
        pw(out, f.0)
        pw(out, f.1)
    pw(out, cabi_fix.len())
    loop f in cabi_fix:
        pw(out, f.0)
        pw(out, f.1)
    pw(out, cabi_adapter.len())
    loop k2, v in cabi_adapter:
        pw(out, k2)
        pw(out, v)
    pw(out, elf_syms.len())
    loop s in elf_syms:
        pw(out, len(s.0))
        loop c in bytes(s.0): out.push(c)
        pw(out, s.1)
        pw(out, s.2)
    pw_ints(out, line_rows)
    pw_ints(out, call_sites)
    pw(out, unwind_fns.len())
    loop u in unwind_fns:
        pw(out, u.0)
        pw(out, u.1)
        pw(out, u.2)
        pw(out, u.3)
    pw_ints(out, uw_data)
    pw_ints(out, dbg_raw)
    pw_ints(out, dbg_cfi)
    news: int[]
    loop c in ro_new:
        news.push(c.0)
        news.push(c.1)
    pw_ints(out, news)
    tw2 = time()
    __olen = 0                      # (the compiler's own output, not yet written, is the parent's to write)
    __write_fd(fd, data(out), out.len())
    if env("DEWY_PAR_TIME") != none: eprint("  worker {a}..{b}: emit {(tw1 - tw0) * 1000.0:.1} ms, pack {(tw2 - tw1) * 1000.0:.1} ms, write {(time() - tw2) * 1000.0:.1} ms, {out.len()} bytes")
    exit(0)

pw = (b: mut u8[], v: int):
    loop k in [0..8): b.push(u8((v >> (8 * k)) & 255))

pw_ints = (b: mut u8[], xs: int[]):
    pw(b, xs.len())
    loop x in xs: pw(b, x)

# ---- joining a worker's run onto what is here ----
struct ParIn:
    b: u8[]
    i = 0

pr = (r: mut ParIn) -> int:
    v = 0
    when BOOTSTRAP:
        loop k in [0..8): v = v | (int(r.b[r.i + k]) << (8 * k))
    else: v = ((data(r.b) + r.i) as *int)[0]            # (x86-64 and arm64 load from any address)
    r.i += 8
    v

pr_ints = (r: mut ParIn) -> int[]:
    n = pr(r)
    xs: int[]
    xs.reserve(n)
    loop _ in [0..n): xs.push(pr(r))
    xs

pr_n = (r: mut ParIn, per: int) -> int[]:
    n = pr(r) * per
    xs: int[]
    xs.reserve(n)
    loop _ in [0..n): xs.push(pr(r))
    xs

par_here = 0                # functions of workers' runs made again here (their pads moved)

# A run's functions are moved as one where they land as far from where the worker made them as
# a multiple of 32 (so their branch pads fall the same), or, whatever the distance, when their
# pads do not depend on where they start; a function whose pads would move is made here, where
# its place is known, and the run's next function lands elsewhere again.
par_join = (bytes_: u8[], r0: int, q: IrFn[], fin: bool[], a: int):
    r = ParIn(bytes_)
    align = 16
    if fz_layout: align = 32
    nf = pr(r)
    fis: int[]
    ats: int[]
    lns: int[]
    moves: int[]
    # per function, then once more at the run's end: where it starts in each of the 13 tables
    # (code, call_fix, data_fix, stub_fix, cabi_fix, elf_syms, line_rows, call_sites,
    # unwind_fns, uw_data, dbg_raw, dbg_cfi, constants)
    marks: int[]
    loop _ in [0..nf):
        fis.push(pr(r))
        ats.push(pr(r))
        lns.push(pr(r))
        moves.push(pr(r))
        loop _ in [0..13): marks.push(pr(r))
    nc = pr(r)
    c0 = r.i
    r.i += nc
    calls = pr_n(r, 2)
    datas = pr_n(r, 3)
    stubs = pr_n(r, 2)
    cabis = pr_n(r, 2)
    adapters = pr_n(r, 2)
    names: str[]
    spos: int[]
    slen: int[]
    loop _ in [0..pr(r)):
        n = pr(r)
        names.push(str_from_bytes(r.b[r.i..r.i + n)))
        r.i += n
        spos.push(pr(r))
        slen.push(pr(r))
    rows = pr_ints(r)
    sites = pr_ints(r)
    uws = pr_n(r, 4)
    uwd = pr_ints(r)
    raw = pr_ints(r)
    cfi = pr_ints(r)
    news = pr_ints(r)
    ends: int[] = [nc, calls.len() / 2, datas.len() / 3, stubs.len() / 2, cabis.len() / 2, names.len(), rows.len(), sites.len(), uws.len() / 4, uwd.len(), raw.len(), cfi.len(), news.len() / 2]
    loop x in ends: marks.push(x)
    starts: int[]           # the worker's constants: where it put each, and where each is here
    to: int[]
    j = 0
    loop j < nf:
        loop code.len() % align != 0: code.push(0xCC)
        shift = code.len() - ats[j]
        e = j
        loop e < nf and ((shift & 31) == 0 or moves[e] == 0): e += 1
        if e == j:
            ir = q[a + j]
            emit_now(fin[a + j])
            par_here += 1
            loop k in [marks[13 * j + 12]..marks[13 * j + 25]):
                starts.push(news[2 * k])
                to.push(ro_const(news[2 * k + 1]))
            j += 1
            continue
        m0 = 13 * j
        m1 = 13 * e
        # (constants the worker added: their places here, in the order it first used them)
        loop k in [marks[m0 + 12]..marks[m1 + 12]):
            starts.push(news[2 * k])
            to.push(ro_const(news[2 * k + 1]))
        cs = ats[j]
        ce = marks[m1]
        when BOOTSTRAP:
            loop k in [cs..ce): code.push(r.b[c0 + k])
        else: code.extend(r.b[c0 + cs..c0 + ce))
        loop k in [j..e):
            fi = fis[k]
            loop fn_addr.len() <= fi: fn_addr.push(-1)
            loop fn_len.len() <= fi: fn_len.push(0)
            fn_addr[fi] = ats[k] + shift
            fn_len[fi] = lns[k]
        loop k in [marks[m0 + 1]..marks[m1 + 1]): call_fix.push((calls[2 * k] + shift, calls[2 * k + 1]))
        loop k in [marks[m0 + 2]..marks[m1 + 2]):
            kind = datas[3 * k + 1]
            off = datas[3 * k + 2]
            if kind == 0 and off >= r0:
                # (within which of the worker's constants)
                i = starts.len() - 1
                loop i > 0 and starts[i] > off: i -= 1
                if i >= 0 and starts[i] <= off: off = to[i] + (off - starts[i])
            data_fix.push((datas[3 * k] + shift, kind, off))
        loop k in [marks[m0 + 3]..marks[m1 + 3]): stub_fix.push((stubs[2 * k] + shift, stubs[2 * k + 1]))
        loop k in [marks[m0 + 4]..marks[m1 + 4]): cabi_fix.push((cabis[2 * k] + shift, cabis[2 * k + 1]))
        loop k in [0..adapters.len() / 2):
            p = adapters[2 * k + 1]
            if p >= cs and p < ce: cabi_adapter[adapters[2 * k]] = p + shift
        e0 = elf_syms.len() - marks[m0 + 5]
        loop k in [marks[m0 + 5]..marks[m1 + 5]): elf_syms.push((names[k], spos[k] + shift, slen[k]))
        k = marks[m0 + 6]
        loop k < marks[m1 + 6]:
            line_rows.push(rows[k] + shift)
            line_rows.push(rows[k + 1])
            k += 2
        k = marks[m0 + 7]
        loop k < marks[m1 + 7]:
            call_sites.push(sites[k] + shift)
            call_sites.push(sites[k + 1])
            k += 2
        u0 = uw_data.len() - marks[m0 + 9]
        loop k in [marks[m0 + 8]..marks[m1 + 8]):
            sz = uws[4 * k + 3]
            if uws[4 * k + 2] == UW_SAVES: sz += u0
            unwind_fns.push((uws[4 * k] + shift, uws[4 * k + 1] + shift, uws[4 * k + 2], sz))
        loop k in [marks[m0 + 9]..marks[m1 + 9]): uw_data.push(uwd[k])
        # dbg_raw: per function its symbol, start, length, frame, count; per variable 6 numbers (lo, hi: code)
        k = marks[m0 + 10]
        loop k < marks[m1 + 10]:
            dbg_raw.push(raw[k] + e0)
            dbg_raw.push(raw[k + 1] + shift)
            dbg_raw.push(raw[k + 2])
            dbg_raw.push(raw[k + 3])
            cnt = raw[k + 4]
            dbg_raw.push(cnt)
            k += 5
            loop _ in [0..cnt):
                dbg_raw.push(raw[k])
                dbg_raw.push(raw[k + 1])
                dbg_raw.push(raw[k + 2])
                dbg_raw.push(raw[k + 3])
                dbg_raw.push(raw[k + 4] + shift)
                dbg_raw.push(raw[k + 5] + shift)
                k += 6
        # dbg_cfi: per function its start (code), length, body, then the saved registers and epilogues
        k = marks[m0 + 11]
        loop k < marks[m1 + 11]:
            dbg_cfi.push(cfi[k] + shift)
            dbg_cfi.push(cfi[k + 1])
            dbg_cfi.push(cfi[k + 2])
            ns = cfi[k + 3]
            dbg_cfi.push(ns)
            k += 4
            loop _ in [0..2 * ns):
                dbg_cfi.push(cfi[k])
                k += 1
            ne = cfi[k]
            dbg_cfi.push(ne)
            k += 1
            loop _ in [0..ne):
                dbg_cfi.push(cfi[k])
                k += 1
        j = e

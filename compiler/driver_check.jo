use 'driver_cli.dewy'
use 'check.jo'
use 'parse.jo'
use 'directives.jo'
use 'module_paths.dewy'

driver_check_arguments = (arguments: str[]) -> str:
    a = arguments
    # type check only
    if a.len() > 3 and a[2] == "--obligations":
        dir_obligations = true
        a = [a[0], a[1]] + a[3..]
    else if a.len() > 3 and a[3] == "--obligations":
        dir_obligations = true
        a = [a[0], a[1], a[2]] + a[4..]
    if a.len() < 3: usage()
    if let s = env("DEWY_STOP"): stop_after = s
    path = os_path(a[2])
    # (the test blocks are checked too, as dewy test would)
    test_mode = true
    check_all = true
    path

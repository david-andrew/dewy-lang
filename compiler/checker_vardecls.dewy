$runtime_checks
from p"node_store.dewy" import Node
from p"checker_types.dewy" import (TypeInfo StructInfo TK)
from p"source_types.dewy" import SrcFile
from p"checker_state.dewy" import (Local FnCtx StatementWatch)
from p"type_inference.dewy" import tu_prune
# `let name = value`, `let name:T`, `let name:T = value`, once its other forms (a
# spawned task's handle, soa and element aliases, lent and local places, shaped
# values, patterns, globals) are passed to their host services: the written type
# resolved, the value checked and converted to it, or its type inferred (a literal's
# default, a sibling record's union), the local made with its flags, and the
# per-binding tables (temperatures, decimals, growth, quaternions, text and integer
# domains, constant views, definite assignment, editor hints) told. O(1) per
# declaration plus the demanded checking of its value; the rare tables are read
# here (Jo maps by pointer) and a host service runs only where one is live.
# Checking, conversion and bindings may grow every arena, so nodes, types and
# locals are reread by ID.
VWord:type=int64<overflow='wrap'>
CheckerDeclHost:type=[
    form:<(node:int64 code:int64):>bool>
    binding_type:<(node:int64):>int64>
    default:<(type_id:int64 pos:int64):>int64>
    syntax_type:<(node:int64):>int64>
    values:<(node:int64 expected:int64):>int64>
    annotated:<(node:int64 type_id:int64 member:int64):>void>
    coerce:<(node:int64 type_id:int64):>int64>
    sibling:<(node:int64 type_id:int64 code:int64):>int64>
    literal:<(node:int64):>int64>
    storage:<(node:int64 type_id:int64):>int64>
    value_param:<(node:int64 type_id:int64):>int64>
    temperature:<(node:int64 type_id:int64 unit:int64):>int64>
    binding:<(name:int64 type_id:int64 pos:int64):>int64>
    after:<(node:int64 local:int64 type_id:int64 code:int64):>void>
    error:<(node:int64 type_id:int64 code:int64):>void>
]
CheckerDeclInput:type=[
    nodes:ptr<array<Node>>
    lists:ptr<array<int32>>
    types:ptr<array<TypeInfo>>
    structs:ptr<array<StructInfo>>
    files:ptr<array<SrcFile>>
    locals:ptr<array<Local>>
    contexts:ptr<array<FnCtx>>
    context:ptr<int64>
    last:ptr<int64>
    refining:ptr<bool>
    effects:ptr<bool>
    ide:ptr<bool>
    sibling_literals:ptr<dict<int64 bool>>
    sibling_pending:ptr<array<int64>>
    sibling_block:ptr<int64>
    sibling_index:ptr<int64>
    flow_next:ptr<int64>
    flow_local:ptr<int64>
    parents:ptr<dict<int64 int64>>
    quat_nodes:ptr<dict<int64 bool>>
    quat_locals:ptr<dict<int64 bool>>
    tk_bindings:ptr<dict<int64 int64>>
    watch:ptr<StatementWatch>
    decimal_cached:ptr<int64>
    growth_pending:ptr<int64>
    growth_whole:ptr<bool>
    str_type:ptr<int64>
    math_int_type:ptr<int64>
    host:ptr<CheckerDeclHost>
]
let vd_nodes:ptr<array<Node>>=$unsafe (uint64(0) as ptr<array<Node>>)
let vd_lists:ptr<array<int32>>=$unsafe (uint64(0) as ptr<array<int32>>)
let vd_types:ptr<array<TypeInfo>>=$unsafe (uint64(0) as ptr<array<TypeInfo>>)
let vd_structs:ptr<array<StructInfo>>=$unsafe (uint64(0) as ptr<array<StructInfo>>)
let vd_files:ptr<array<SrcFile>>=$unsafe (uint64(0) as ptr<array<SrcFile>>)
let vd_locals:ptr<array<Local>>=$unsafe (uint64(0) as ptr<array<Local>>)
let vd_contexts:ptr<array<FnCtx>>=$unsafe (uint64(0) as ptr<array<FnCtx>>)
let vd_context:ptr<int64>=$unsafe (uint64(0) as ptr<int64>)
let vd_last:ptr<int64>=$unsafe (uint64(0) as ptr<int64>)
let vd_refining:ptr<bool>=$unsafe (uint64(0) as ptr<bool>)
let vd_effects:ptr<bool>=$unsafe (uint64(0) as ptr<bool>)
let vd_ide:ptr<bool>=$unsafe (uint64(0) as ptr<bool>)
let vd_sibling_literals:ptr<dict<int64 bool>>=$unsafe (uint64(0) as ptr<dict<int64 bool>>)
let vd_sibling_pending:ptr<array<int64>>=$unsafe (uint64(0) as ptr<array<int64>>)
let vd_sibling_block:ptr<int64>=$unsafe (uint64(0) as ptr<int64>)
let vd_sibling_index:ptr<int64>=$unsafe (uint64(0) as ptr<int64>)
let vd_flow_next:ptr<int64>=$unsafe (uint64(0) as ptr<int64>)
let vd_flow_local:ptr<int64>=$unsafe (uint64(0) as ptr<int64>)
let vd_parents:ptr<dict<int64 int64>>=$unsafe (uint64(0) as ptr<dict<int64 int64>>)
let vd_quat_nodes:ptr<dict<int64 bool>>=$unsafe (uint64(0) as ptr<dict<int64 bool>>)
let vd_quat_locals:ptr<dict<int64 bool>>=$unsafe (uint64(0) as ptr<dict<int64 bool>>)
let vd_tk_bindings:ptr<dict<int64 int64>>=$unsafe (uint64(0) as ptr<dict<int64 int64>>)
let vd_watch:ptr<StatementWatch>=$unsafe (uint64(0) as ptr<StatementWatch>)
let vd_decimal_cached:ptr<int64>=$unsafe (uint64(0) as ptr<int64>)
let vd_growth_pending:ptr<int64>=$unsafe (uint64(0) as ptr<int64>)
let vd_growth_whole:ptr<bool>=$unsafe (uint64(0) as ptr<bool>)
let vd_str_type:ptr<int64>=$unsafe (uint64(0) as ptr<int64>)
let vd_math_int_type:ptr<int64>=$unsafe (uint64(0) as ptr<int64>)
let vd_host:ptr<CheckerDeclHost>=$unsafe (uint64(0) as ptr<CheckerDeclHost>)
checker_vardecls_bind=(input:ptr<CheckerDeclInput>):>VWord=>$unsafe {
    vd_nodes=input[0].nodes
    vd_lists=input[0].lists
    vd_types=input[0].types
    vd_structs=input[0].structs
    vd_files=input[0].files
    vd_locals=input[0].locals
    vd_contexts=input[0].contexts
    vd_context=input[0].context
    vd_last=input[0].last
    vd_refining=input[0].refining
    vd_effects=input[0].effects
    vd_ide=input[0].ide
    vd_sibling_literals=input[0].sibling_literals
    vd_sibling_pending=input[0].sibling_pending
    vd_sibling_block=input[0].sibling_block
    vd_sibling_index=input[0].sibling_index
    vd_flow_next=input[0].flow_next
    vd_flow_local=input[0].flow_local
    vd_parents=input[0].parents
    vd_quat_nodes=input[0].quat_nodes
    vd_quat_locals=input[0].quat_locals
    vd_tk_bindings=input[0].tk_bindings
    vd_watch=input[0].watch
    vd_decimal_cached=input[0].decimal_cached
    vd_growth_pending=input[0].growth_pending
    vd_growth_whole=input[0].growth_whole
    vd_str_type=input[0].str_type
    vd_math_int_type=input[0].math_int_type
    vd_host=input[0].host
    0
}
vd_kind=(t:VWord):>TK=>$unsafe {vd_types[0].ptr[tu_prune(t)].kind}
vd_flag=(n:VWord f:VWord):>bool=>$unsafe {VWord(vd_nodes[0].ptr[n].flags) & f not=? 0}
vd_kid=(n:VWord i:VWord):>VWord=>$unsafe {VWord(vd_lists[0][VWord(vd_nodes[0].ptr[n].list) + i])}
vd_file_dewy=(pos:VWord):>bool=>$unsafe {vd_files[0][pos >> 40].is_dewy}
vd_dewy_at=(pos:VWord):>bool=>$unsafe {
    let f=pos >> 40
    pos >? 0 and f <? vd_files[0].length and vd_files[0].ptr[f].is_dewy
}
vd_union=(t0:VWord):>bool=>$unsafe {
    let t=tu_prune(t0)
    vd_types[0].ptr[t].kind =? 'enum_' and vd_structs[0].ptr[VWord(vd_types[0].ptr[t].st)].union_
}
vd_or_flags=(l:VWord f:VWord):>void=>$unsafe {vd_locals[0][l].flags=int32<overflow='wrap'>(VWord(vd_locals[0].ptr[l].flags) | f)}
# `n * unit` (or its negation) with a numeric literal n and a named unit, unchecked:
# the unit's name, or 0. (Frozen Tok ordinals: minus 59, star 60; NF_CHECKED 128.)
vd_literal_unit=(e:VWord):>VWord=>$unsafe {
    if e =? 0 or vd_flag(e 128) {return 0}
    let k=vd_nodes[0].ptr[e].kind
    if k =? 'unary' and vd_nodes[0].ptr[e].op =? 59 {return vd_literal_unit(VWord(vd_nodes[0].ptr[e].a))}
    if k not=? 'binary' or vd_nodes[0].ptr[e].op not=? 60 {return 0}
    let x=vd_nodes[0].ptr[VWord(vd_nodes[0].ptr[e].a)].kind
    let u=VWord(vd_nodes[0].ptr[e].b)
    if (x not=? 'int_lit' and x not=? 'float_lit') or vd_nodes[0].ptr[u].kind not=? 'ident' {return 0}
    VWord(vd_nodes[0].ptr[u].name)
}
# `let s = Circle[...]` mid-block, of a minted family: the rest of the block may
# give it a sibling (sibling_scalar's own first tests, here).
vd_scalar_followed=(s:VWord t:VWord):>bool=>$unsafe {
    let b=vd_sibling_block[0]
    let i=vd_sibling_index[0]
    if b =? 0 or i >=? VWord(vd_nodes[0].ptr[b].nlist) or vd_kid(b i) not=? s {return false}
    vd_parents[0].get(tu_prune(t) 0) not=? 0 and i + 1 <? VWord(vd_nodes[0].ptr[b].nlist)
}
# The forms another service declares (NF_SOA 131072, NF_ALIASDECL 8388608, NF_MUT 1,
# NF_GLOBAL 2048, NF_RDONLY 262144; a spawn's call aux2 17, a lent place's -11):
# true when one did.
vd_forms=(s:VWord):>bool=>$unsafe {
    let b=VWord(vd_nodes[0].ptr[s].b)
    if b >? 0 and vd_nodes[0].ptr[b].kind =? 'call' and vd_nodes[0].ptr[b].aux2 =? 17 {vd_host[0].form(s 1);}
    if VWord(vd_nodes[0].ptr[s].flags) & 131072 not=? 0 {return vd_host[0].form(s 2)}
    if VWord(vd_nodes[0].ptr[s].flags) & 8388608 not=? 0 {return vd_host[0].form(s 3)}
    if b not=? 0 {
        let c=b
        if vd_nodes[0].ptr[c].kind =? 'propagate' {c=VWord(vd_nodes[0].ptr[c].a)}
        if vd_nodes[0].ptr[c].kind =? 'call' and vd_nodes[0].ptr[c].aux2 =? -11 and vd_host[0].form(s 4) {return true}
        if vd_nodes[0].ptr[s].a =? 0 and vd_nodes[0].ptr[s].nlist =? 0 and VWord(vd_nodes[0].ptr[s].flags) & 2048 =? 0 and VWord(vd_nodes[0].ptr[s].flags) & 262144 =? 0 and VWord(vd_nodes[0].ptr[b].flags) & 1 not=? 0 and vd_file_dewy(vd_nodes[0].ptr[s].pos) and vd_host[0].form(s 5) {return true}
    }
    let tn=VWord(vd_nodes[0].ptr[s].a)
    if tn not=? 0 and b not=? 0 and vd_nodes[0].ptr[tn].kind =? 'tarray' and vd_nodes[0].ptr[tn].ival =? 1 {vd_host[0].form(s 6);}
    if vd_nodes[0].ptr[s].nlist >? 0 {return vd_host[0].form(s 7)}
    if VWord(vd_nodes[0].ptr[s].flags) & 2048 not=? 0 {return vd_host[0].form(s 8)}
    false
}
# (LF_DECL 512, LF_QUIET 65536, LF_CONST 131072, LF_VALUEPARAM 524288: a constant's
# 197120, a loop count's 66048; NF_RDONLY 262144, NF_LOOPCOUNT 33554432, NF_LITERAL
# 256. The commonest tests are written out: a call costs more than they do.)
vd_decl=(s:VWord):>void=>$unsafe {
    if vd_forms(s) {return}
    let pos=VWord(vd_nodes[0].ptr[s].pos)
    let typed=vd_nodes[0].ptr[s].a not=? 0
    let pf=pos >> 40
    let dewy=pos >? 0 and pf <? vd_files[0].length and vd_files[0].ptr[pf].is_dewy
    let t:VWord=0
    if typed {t=vd_host[0].binding_type(s)}
    let no_value=vd_nodes[0].ptr[s].b =? 0
    if vd_refining[0] and vd_kind(t) =? 'refined' and vd_nodes[0].ptr[s].b =? 0 {vd_nodes[0][s].b=int32<overflow='wrap'>(vd_host[0].default(t pos))}
    # (Dewy's `let x:T` without a value: given one on every path before it is read)
    let unset=no_value and t not=? 0 and dewy and VWord(vd_nodes[0].ptr[s].flags) & 262144 =? 0 and vd_host[0].form(s 9)
    # (x: T, a struct with default field values: it starts with them, as T() would)
    if vd_nodes[0].ptr[s].b =? 0 and t not=? 0 {vd_nodes[0][s].b=int32<overflow='wrap'>(vd_host[0].default(t pos))}
    let literal_init=false
    let unit:VWord=0
    if vd_nodes[0].ptr[s].b not=? 0 {
        # (growth's reading of the value starts here: a whole literal start is noted, and
        # a loop carrying an exact binding, or a reading left over, asks the host)
        let ik=vd_nodes[0].ptr[VWord(vd_nodes[0].ptr[s].b)].kind
        let c=vd_context[0]
        if vd_growth_pending[0] not=? 0 or (not typed and (ik =? 'float_lit' or ((vd_watch[0].growth >? 0 or vd_decimal_cached[0] not=? 0) and c >=? 0 and vd_contexts[0].ptr[c].loop_depth >? 0 and dewy))) {vd_host[0].after(s 0 0 1);}
        else {vd_growth_whole[0]=not typed and ik =? 'int_lit'}
        if t =? 0 and dewy {unit=vd_literal_unit(VWord(vd_nodes[0].ptr[s].b))}
        let literal:VWord=0
        if t not=? 0 and vd_union(t) and dewy {literal=vd_host[0].syntax_type(VWord(vd_nodes[0].ptr[s].b))}
        let et=vd_host[0].values(VWord(vd_nodes[0].ptr[s].b) t)
        vd_nodes[0][s].b=int32<overflow='wrap'>(vd_last[0])
        if t not=? 0 {
            # (`let s:Circle|Square = Circle[...]`: which member it holds is followed)
            if literal not=? 0 or (vd_union(t) and vd_kind(et) =? 'struct_' and dewy) {
                let member=et
                if literal not=? 0 {member=literal}
                vd_host[0].annotated(s t member)
            }
            vd_nodes[0][s].b=int32<overflow='wrap'>(vd_host[0].coerce(VWord(vd_nodes[0].ptr[s].b) t))
        } else {
            t=et
            let k=vd_kind(t)
            if k =? 'tuple' and vd_sibling_literals[0].has(VWord(vd_nodes[0].ptr[s].b)) {t=vd_host[0].sibling(s t 1)}
            # (`let s = Circle[...]` that the block later gives a Square: their union, followed)
            else if k =? 'struct_' and dewy and vd_scalar_followed(s t) {t=vd_host[0].sibling(s t 2)}
            # (NF_LITERAL 256: the literal's default, or float64 for a decimal a float was written to)
            if VWord(vd_nodes[0].ptr[VWord(vd_nodes[0].ptr[s].b)].flags) & 256 not=? 0 {
                t=vd_host[0].literal(s)
                literal_init=true
            }
            if vd_kind(t) =? 'none_lit' {vd_host[0].error(s t 1)}
        }
    }
    if vd_effects[0] and not typed {t=vd_host[0].storage(s t)}
    # (a value parameter's binding keeps its integer refinement: `s:-1|1` stays one)
    if vd_nodes[0].ptr[s].aux2 =? 1 and not typed and vd_refining[0] and vd_nodes[0].ptr[s].b not=? 0 {t=vd_host[0].value_param(s t)}
    if t =? 0 {vd_host[0].error(s 0 2)}
    if unit not=? 0 {t=vd_host[0].temperature(s t unit)}
    let tk=vd_kind(t)
    if tk =? 'void_' {vd_host[0].error(s t 3)}
    if tk =? 'null_' {vd_host[0].error(s t 4)}
    if tk =? 'typeval' or tk =? 'module' {vd_host[0].error(s t 5)}
    let l=vd_host[0].binding(VWord(vd_nodes[0].ptr[s].name) t pos)
    if vd_sibling_pending[0].length >? 0 {vd_host[0].after(s l t 3)}
    if vd_flow_next[0] not=? 0 {vd_flow_local[0]=l}
    if unit not=? 0 {vd_tk_bindings[0][l]=s}
    if literal_init and (vd_kind(t) =? 'struct_' or vd_watch[0].decimal_adapted >? 0) {vd_host[0].after(s l t 4)}
    if vd_growth_pending[0] not=? 0 or (not typed and vd_kind(t) =? 'struct_' and dewy and VWord(vd_nodes[0].ptr[s].flags) & 262144 =? 0) {vd_host[0].after(s l t 5)}
    let b=VWord(vd_nodes[0].ptr[s].b)
    if b not=? 0 and vd_watch[0].quaternions >? 0 and vd_quat_nodes[0].has(b) {vd_quat_locals[0][l]=true}
    vd_locals[0][l].flags=int32<overflow='wrap'>(512)
    if not typed and dewy {
        if t =? vd_str_type[0] {vd_host[0].after(s l t 6)}
        else if t =? vd_math_int_type[0] {vd_host[0].after(s l t 7)}
    }
    if VWord(vd_nodes[0].ptr[s].flags) & 262144 not=? 0 {
        vd_locals[0][l].flags=int32<overflow='wrap'>(197120)
        vd_locals[0][l].const_init=int32<overflow='wrap'>(b)
        if b not=? 0 and vd_file_dewy(pos) {vd_host[0].after(s l t 8)}
    }
    if VWord(vd_nodes[0].ptr[s].flags) & 33554432 not=? 0 {vd_locals[0][l].flags=int32<overflow='wrap'>(66048)}
    if vd_nodes[0].ptr[s].aux2 =? 1 {vd_or_flags(l 524288)}
    vd_nodes[0][s].sym=int32<overflow='wrap'>(l)
    if unset {vd_host[0].after(s l t 9)}
    if vd_ide[0] and not typed {vd_host[0].after(s l t 10)}
}

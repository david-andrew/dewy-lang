$runtime_checks
# Checked ordinary and mathematical execution share private evaluator state.
# The public value arena lends one stable header; type operations enter their
# Dewy owners directly, and only coarse checking/host services cross to Jo.
CWord:type=int64<overflow='wrap'>
from p"evaluator_state.dewy" import (CTValue CTFrame CTPlace)
from p"checker_tokens.dewy" import (Tok)
from p"checker_types.dewy" import (TK TypeInfo StructInfo Field Variant)
from p"checker_state.dewy" import (FnInst Global Local)
from p"refinement_types.dewy" import (RefAtom RefTerm)
from p"node_store.dewy" import (Node NK node_kids node_mk node_set_list)
from p"source_types.dewy" import (SrcFile)
from p"type_inference.dewy" import (tu_prune tu_equal tu_is_union tu_union_members)
from p"type_layout.dewy" import (tl_layout)
from p"type_format.dewy" import (tf_string)
from p"type_unions.dewy" import (uu_index uu_holder)
const NF_INCLUSIVE = 2
const NF_EXTERN = 4
const NF_CHECKED = 128
const NF_STEP = 32768         # range `a,b..c`: c holds the second value
const NF_U64 = 2097152        # an integer literal above the i64 range (written so, or computed from one)
const LF_MUTPARAM = 2
const LF_ALIAS = 8
CXIN:type='none_' | 'len' | 'push' | 'pop' | 'insert' | 'remove' | 'clear' | 'reserve' | 'slice' | 'syscall' | 'memcpy' | 'memset' | 'sizeof' | 'arrdata' | 'panic' | 'assert' | 'print' | 'embed' | 'from_bytes' | 'to_bytes' | 'argv' | 'setlen' | 'truncate' | 'resize' | 'hash' | 'alignof' | 'unreachable' | 'arrcap' | 'fmt_struct' | 'sqrt' | 'vec_ctor' | 'cfn_cast' | 'wasm_call' | 'callc' | 'floor_' | 'ceil_' | 'fabs' | 'fmin' | 'fmax' | 'setjmp' | 'longjmp' | 'jump' | 'shader' | 'extend' | 'clone_thread' | 'atomic_add' | 'atomic_cas' | 'stack_ptr' | 'fill' | 'fmt_elem' | 'gpu_kernel' | 'cpu_features' | 'code_sync' | 'compute' | 'compute_spirv' | 'compute_textures' | 'read_fields' | 'default_init' | 'offset_unit' | 'embed_dir' | 'dewy_iter' | 'dewy_iter_done' | 'dewy_iter_value' | 'json_fields' | 'dewy_iter_pair' | 'dewy_set' | 'static_assert' | 'runtime_assert' | 'dewy_print' | 'dewy_fmt' | 'dewy_fmt_elem' | 'lend' | 'loan_address' | 'loan_load' | 'loan_store' | 'loan_length' | 'zeroed' | 'relocate' | 'take_slot' | 'live_len' | 'task_report' | 'task_data' | 'task_duration' | 'arena_result' | 'arrdata_permute' | 'mul_hi' | 'secret_wrap' | 'secret_value' | 'range_max' | 'fixed_abs' | 'integer_mode'
CXCV:type='none_' | 'int_' | 'int2float' | 'float2int' | 'float_' | 'opt' | 'ptr' | 'bits' | 'fn2clos' | 'union_' | 'fixed2arr' | 'arr2fixed' | 'quantity_const' | 'explicit_copy' | 'refinement' | 'big2math' | 'math2big' | 'set_text' | 'promote' | 'wrap_int' | 'saturate_int' | 'fixed_store'
CheckedEvalHost:type=[
    binding_const_init:<(p0:int64 p1:int64 p2:int64):>int64>
    call_eval_order:<(p0:int64):>array<int64>>
    check_fn_body:<(p0:int64):>void>
    check_struct_fields:<(p0:int64):>void>
    compound_op:<(p0:int64):>int64>
    dewy_at:<(p0:int64):>bool>
    exact_type:<(p0:int64 p1:int64):>bool>
    fatal:<(p0:int64 p1:string):>void>
    int_fits:<(p0:int64 p1:int64):>bool>
    int_widens:<(p0:int64 p1:int64):>bool>
    intern:<(p0:string):>int64>
    math_rep_type:<(p0:int64):>bool>
    pos_str:<(p0:int64):>string>
    representation_type:<(p0:int64):>int64>
    runtime_fn:<(p0:string):>int64>
    str_set_of:<(p0:int64):>int64>
    wrap_conv:<(p0:int64 p1:int64 p2:int64):>void>
    byte_cut:<(text:string start:int64 end_:int64):>string>
    str_from_bytes:<(p0:array<uint8>):>string>
]
CheckedEvalInput:type=[
    ct_values:ptr<array<CTValue>>
    nodes:ptr<array<Node>>
    lists:ptr<array<int32>>
    names:ptr<array<string>>
    types:ptr<array<TypeInfo>>
    type_args:ptr<array<int32>>
    structs:ptr<array<StructInfo>>
    fields:ptr<array<Field>>
    variants:ptr<array<Variant>>
    fns:ptr<array<FnInst>>
    globals:ptr<array<Global>>
    locals:ptr<array<Local>>
    files:ptr<array<SrcFile>>
    ref_predicates:ptr<array<array<RefAtom>>>
    ref_narrowing:ptr<dict<int64 int64>>
    str_sets:ptr<array<array<string>>>
    T_BOOL:ptr<int64>
    T_INT:ptr<int64>
    T_MATH_INT:ptr<int64>
    T_STR:ptr<int64>
    T_U64:ptr<int64>
    T_U8:ptr<int64>
    ts_dewy:ptr<bool>
    lib_dir:ptr<string>
    host:ptr<CheckedEvalHost>
]
let cx_ct_values:ptr<array<CTValue>>=$unsafe (uint64<overflow='wrap'>(0) as ptr<array<CTValue>>)
let cx_nodes:ptr<array<Node>>=$unsafe (uint64<overflow='wrap'>(0) as ptr<array<Node>>)
let cx_lists:ptr<array<int32>>=$unsafe (uint64<overflow='wrap'>(0) as ptr<array<int32>>)
let cx_names:ptr<array<string>>=$unsafe (uint64<overflow='wrap'>(0) as ptr<array<string>>)
let cx_types:ptr<array<TypeInfo>>=$unsafe (uint64<overflow='wrap'>(0) as ptr<array<TypeInfo>>)
let cx_type_args:ptr<array<int32>>=$unsafe (uint64<overflow='wrap'>(0) as ptr<array<int32>>)
let cx_structs:ptr<array<StructInfo>>=$unsafe (uint64<overflow='wrap'>(0) as ptr<array<StructInfo>>)
let cx_fields:ptr<array<Field>>=$unsafe (uint64<overflow='wrap'>(0) as ptr<array<Field>>)
let cx_variants:ptr<array<Variant>>=$unsafe (uint64<overflow='wrap'>(0) as ptr<array<Variant>>)
let cx_fns:ptr<array<FnInst>>=$unsafe (uint64<overflow='wrap'>(0) as ptr<array<FnInst>>)
let cx_globals:ptr<array<Global>>=$unsafe (uint64<overflow='wrap'>(0) as ptr<array<Global>>)
let cx_locals:ptr<array<Local>>=$unsafe (uint64<overflow='wrap'>(0) as ptr<array<Local>>)
let cx_files:ptr<array<SrcFile>>=$unsafe (uint64<overflow='wrap'>(0) as ptr<array<SrcFile>>)
let cx_ref_predicates:ptr<array<array<RefAtom>>>=$unsafe (uint64<overflow='wrap'>(0) as ptr<array<array<RefAtom>>>)
let cx_ref_narrowing:ptr<dict<int64 int64>>=$unsafe (uint64<overflow='wrap'>(0) as ptr<dict<int64 int64>>)
let cx_str_sets:ptr<array<array<string>>>=$unsafe (uint64<overflow='wrap'>(0) as ptr<array<array<string>>>)
let cx_T_BOOL:ptr<int64>=$unsafe (uint64<overflow='wrap'>(0) as ptr<int64>)
let cx_T_INT:ptr<int64>=$unsafe (uint64<overflow='wrap'>(0) as ptr<int64>)
let cx_T_MATH_INT:ptr<int64>=$unsafe (uint64<overflow='wrap'>(0) as ptr<int64>)
let cx_T_STR:ptr<int64>=$unsafe (uint64<overflow='wrap'>(0) as ptr<int64>)
let cx_T_U64:ptr<int64>=$unsafe (uint64<overflow='wrap'>(0) as ptr<int64>)
let cx_T_U8:ptr<int64>=$unsafe (uint64<overflow='wrap'>(0) as ptr<int64>)
let cx_ts_dewy:ptr<bool>=$unsafe (uint64<overflow='wrap'>(0) as ptr<bool>)
let cx_lib_dir:ptr<string>=$unsafe (uint64(0) as ptr<string>)
let cx_host:ptr<CheckedEvalHost>=$unsafe (uint64<overflow='wrap'>(0) as ptr<CheckedEvalHost>)
checked_eval_bind=(input:ptr<CheckedEvalInput>):>CWord=>$unsafe {
    cx_ct_values=input[0].ct_values
    cx_nodes=input[0].nodes
    cx_lists=input[0].lists
    cx_names=input[0].names
    cx_types=input[0].types
    cx_type_args=input[0].type_args
    cx_structs=input[0].structs
    cx_fields=input[0].fields
    cx_variants=input[0].variants
    cx_fns=input[0].fns
    cx_globals=input[0].globals
    cx_locals=input[0].locals
    cx_files=input[0].files
    cx_ref_predicates=input[0].ref_predicates
    cx_ref_narrowing=input[0].ref_narrowing
    cx_str_sets=input[0].str_sets
    cx_T_BOOL=input[0].T_BOOL
    cx_T_INT=input[0].T_INT
    cx_T_MATH_INT=input[0].T_MATH_INT
    cx_T_STR=input[0].T_STR
    cx_T_U64=input[0].T_U64
    cx_T_U8=input[0].T_U8
    cx_ts_dewy=input[0].ts_dewy
    cx_lib_dir=input[0].lib_dir
    cx_host=input[0].host
    0
}
cx_prune=(t:CWord):>CWord=>$unsafe {
    tu_prune(t)
}
cx_tkind=(t:CWord):>TK=>$unsafe {
    cx_types[0].ptr[tu_prune(t)].kind
}
cx_telem=(t:CWord):>CWord=>$unsafe {
    CWord(cx_types[0].ptr[tu_prune(t)].elem)
}
cx_fixed_len=(t:CWord):>CWord=>$unsafe {
    CWord(cx_types[0].ptr[tu_prune(t)].bits)
}
cx_targ=(t:CWord i:CWord):>CWord=>$unsafe {
    CWord(cx_type_args[0].ptr[CWord(cx_types[0].ptr[t].args) + i])
}
cx_is_int=(t:CWord):>bool=>$unsafe {
    cx_types[0].ptr[tu_prune(t)].kind =? 'int_'
}
cx_is_float=(t:CWord):>bool=>$unsafe {
    cx_types[0].ptr[tu_prune(t)].kind =? 'float_'
}
cx_int_policy=(t:CWord):>CWord=>$unsafe {
    let t = tu_prune(t)
    if cx_types[0].ptr[t].kind not=? 'int_' or t =? cx_T_MATH_INT[0] {return 0}
    CWord(cx_types[0].ptr[t].st)
}
cx_has_flag=(n:CWord f:CWord):>bool=>$unsafe {
    CWord(cx_nodes[0].ptr[n].flags) & f not=? 0
}
cx_add_flag=(n:CWord f:CWord):>void=>$unsafe {
    cx_nodes[0].ptr[n].flags = int32<overflow='wrap'>(CWord(cx_nodes[0].ptr[n].flags) | f)
}
cx_ntype=(n:CWord):>CWord=>$unsafe {
    CWord(cx_nodes[0].ptr[n].type)
}
cx_nkids=(n:CWord):>CWord=>$unsafe {
    CWord(cx_nodes[0].ptr[n].nlist)
}
cx_kid=(n:CWord i:CWord):>CWord=>$unsafe {
    CWord(cx_lists[0].ptr[CWord(cx_nodes[0].ptr[n].list) + i])
}
cx_kids=(n:CWord):>array<int64>=>$unsafe {
    node_kids(@cx_nodes[0]  @cx_lists[0]  n)
}
cx_name_of=(id:CWord):>string=>$unsafe {
    cx_names[0][id]
}
cx_pos_file=(p:CWord):>CWord=>$unsafe {
    p >> 40
}
cx_dt=(t:CWord):>string=>$unsafe {
    tf_string(t  cx_ts_dewy[0])
}
cx_tsize=(t:CWord):>CWord=>$unsafe {
    tl_layout(t)
    CWord(cx_types[0].ptr[tu_prune(t)].size)
}
cx_mk=(kind:NK pos:CWord):>CWord=>$unsafe {
    node_mk(@cx_nodes[0]  kind  pos)
}
cx_set_list=(n:CWord xs:array<int64>):>void=>$unsafe {
    node_set_list(@cx_nodes[0]  @cx_lists[0]  n  xs)
}
# Ordinary checked Dewy bodies, interpreted on demand. Values are immutable;
# frames and places belong to the evaluator, never to the checker or backend.
# No fuel counter: general compile-time execution is trusted.
let cx_frames:array<CTFrame>=[]
let cx_places:array<CTPlace>=[]
let cx_stack:array<int64>=[]
let cx_global_cache:dict<int64 int64>=[]
let cx_pending:array<int64>=[]
let cx_frame:CWord=-1
cx_fail=(e:CWord why:string):>void=>$unsafe {
    let trail=""
    loop call in cx_stack {
        let f=CWord(cx_nodes[0].ptr[call].sym)
        let name=if f >? 0 and cx_fns[0][f].decl not=? 0 {cx_name_of(CWord(cx_nodes[0].ptr[CWord(cx_fns[0][f].decl)].name))} else {"<expression>"}
        trail = "{trail}\n  compile-time call to {name} at {cx_host[0].pos_str(cx_nodes[0].ptr[call].pos)}"
    }
    cx_host[0].fatal(cx_nodes[0].ptr[e].pos  "compile-time evaluation: {why}{trail}")
}
cx_add=(v:CTValue):>CWord=>$unsafe {
    cx_ct_values[0].push(v)
    cx_ct_values[0].length - 1
}
cx_int=(t:CWord i:CWord):>CWord=>$unsafe {
    let i = i
    let t = cx_prune(t)
    if cx_is_int(t) and CWord(cx_types[0].ptr[t].bits) <? 64 {
        let bits=CWord(cx_types[0].ptr[t].bits)
        if cx_types[0].ptr[t].sign {i=(i << (64 - bits)) >> (64 - bits)}
        else {i &= (CWord(1) << bits) - 1}
    }
    cx_add(CTValue[type = t  i = i])
}
cx_float=(t:CWord f:float64):>CWord=>$unsafe {
    cx_add(CTValue[type = t  f = if CWord(cx_types[0].ptr[t].bits) =? 32 {float64(float32(f))} else {f}])
}
cx_zero=(t0:CWord):>CWord=>$unsafe {
    let t=cx_prune(t0)
    let v=CTValue[type = t]
    let k=cx_tkind(t)
    if k =? 'struct_' {
        let si=CWord(cx_types[0].ptr[t].st)
        cx_host[0].check_struct_fields(si)
        loop i in [0..CWord(cx_structs[0].ptr[si].nfields)) {v.items.push(cx_zero(CWord(cx_fields[0].ptr[CWord(cx_structs[0].ptr[si].fields) + i].type)))}
    }
    else if k =? 'enum_' {
        let si=CWord(cx_types[0].ptr[t].st)
        cx_host[0].check_struct_fields(si)
        let vi=CWord(cx_structs[0].ptr[si].variants)
        loop i in [0..CWord(cx_variants[0].ptr[vi].nfields)) {v.items.push(cx_zero(CWord(cx_fields[0].ptr[CWord(cx_variants[0].ptr[vi].fields) + i].type)))}
    }
    else if k =? 'tuple' {
        loop i in [0..CWord(cx_types[0].ptr[t].nargs)) {v.items.push(cx_zero(cx_targ(t  i)))}
    }
    else if k =? 'fixed' {
        loop i in [0..cx_fixed_len(t)) {v.items.push(cx_zero(cx_telem(t)))}
    }
    cx_add(v)
}
cx_equal=(a:CWord b:CWord e:CWord=0):>bool=>$unsafe {
    let x=cx_value(a)
    let y=cx_value(b)
    if cx_is_int(x.type) and cx_is_int(y.type) and(x.type =? cx_T_MATH_INT[0] or y.type =? cx_T_MATH_INT[0]) and(x.items.length >? 0 or y.items.length >? 0) {
        return cx_value(cx_math_binary(e  'eq'  cx_exact_operand(a  e)  cx_exact_operand(b  e))).i not=? 0
    }
    if x.i not=? y.i or x.s not=? y.s or x.items.length not=? y.items.length {return false}
    if cx_is_float(x.type) and x.f not=? y.f {return false}
    loop i in [0..x.items.length) {
        if not cx_equal(x.items[i]  y.items[i]  e) {return false}
    }
    true
# The evaluator can use its compile-time mathematical representation; emitted
# fixed-width code uses only statically sized machine words.
}
let cx_fixed_internal:CWord=0
cx_exact_operand=(v:CWord e:CWord):>CWord=>$unsafe {
    let x=cx_value(v)
    if x.type =? cx_T_MATH_INT[0] {return v}
    if not cx_types[0].ptr[x.type].sign and x.i <? 0 {return cx_math_unpack(cx_math_runtime("__mi_unsigned"  [v]  e))}
    cx_int(cx_T_MATH_INT[0]  x.i)
}
cx_store=(v:CWord t0:CWord e:CWord):>CWord=>$unsafe {
    let t=cx_host[0].representation_type(t0)
    if cx_fixed_internal >? 0 or v =? 0 or not cx_host[0].exact_type(t  cx_nodes[0].ptr[e].pos) {return v}
    let x=cx_value(v)
    if x.type not=? cx_T_MATH_INT[0] {return v}
    let word=x.i
    if x.items.length >? 0 {
        let checked=cx_math_runtime((if cx_types[0].ptr[t].sign {"__mi_signed"} else {"__mi_to_unsigned"})  [cx_math_rep(v)]  e)
        word=cx_value(checked).i
    }
    else if not cx_types[0].ptr[t].sign and word <? 0 {cx_fail(e  "exact integer result does not fit {cx_dt(t)}")}
    if CWord(cx_types[0].ptr[t].bits) <? 64 and not cx_host[0].int_fits(word  t) {cx_fail(e  "exact integer result does not fit {cx_dt(t)}")}
    cx_int(t  word)
}
cx_binary=(e:CWord op:Tok a:CWord b:CWord t:CWord):>CWord=>$unsafe {
    let x=cx_value(a)
    let y=cx_value(b)
    if(op =? 'slash' or op =? 'percent') and cx_is_int(y.type) and y.i =? 0 and y.items.length =? 0 {cx_fail(e  "division by zero")}
    if cx_fixed_internal =? 0 and cx_is_int(x.type) and cx_is_int(y.type) and(cx_host[0].exact_type(t  cx_nodes[0].ptr[e].pos) or x.type =? cx_T_MATH_INT[0] or y.type =? cx_T_MATH_INT[0]) and cx_int_policy(t) =? 0 {
        return cx_math_binary(e  op  cx_exact_operand(a  e)  cx_exact_operand(b  e))
    }
    if x.type =? cx_T_MATH_INT[0] and(x.items.length >? 0 or y.items.length >? 0) {return cx_math_binary(e  op  a  b)}
    if cx_tkind(x.type) =? 'ptr' {
        if cx_tkind(t) not=? 'ptr' or(op not=? 'plus' and op not=? 'minus') {cx_fail(e  "pointer comparisons and host addresses are not allowed")}
        x.i = CWord(x.i) + (if op =? 'plus' {CWord(y.i)} else {-CWord(y.i)}) * cx_tsize(cx_telem(x.type))
        return cx_add(x)
    }
    if op =? 'eq' or op =? 'ne' {
        let eq=cx_equal(a  b  e)
        return cx_int(cx_T_BOOL[0]  int64(if op =? 'eq' {eq} else {not eq}))
    }
    if cx_tkind(x.type) =? 'str_' {
        if op =? 'plus' {return cx_add(CTValue[type = cx_T_STR[0]  s = "{x.s}{y.s}"])}
        if op =? 'lt' {return cx_int(cx_T_BOOL[0]  int64(x.s <? y.s))}
        if op =? 'le' {return cx_int(cx_T_BOOL[0]  int64(x.s <=? y.s))}
        if op =? 'gt' {return cx_int(cx_T_BOOL[0]  int64(x.s >? y.s))}
        if op =? 'ge' {return cx_int(cx_T_BOOL[0]  int64(x.s >=? y.s))}
    }
    if cx_tkind(x.type) =? 'array' and op =? 'plus' {return cx_add(CTValue[type = t  items = [x.items... y.items...]])}
    if cx_is_float(x.type) {
        if op =? 'lt' {return cx_int(cx_T_BOOL[0]  int64(x.f <? y.f))}
        if op =? 'le' {return cx_int(cx_T_BOOL[0]  int64(x.f <=? y.f))}
        if op =? 'gt' {return cx_int(cx_T_BOOL[0]  int64(x.f >? y.f))}
        if op =? 'ge' {return cx_int(cx_T_BOOL[0]  int64(x.f >=? y.f))}
        if op =? 'plus' {return cx_float(t  x.f + y.f)}
        if op =? 'minus' {return cx_float(t  x.f - y.f)}
        if op =? 'star' {return cx_float(t  x.f * y.f)}
        if op =? 'slash' {return cx_float(t  x.f / y.f)}
        cx_fail(e  "this floating operation is not supported")
    }
    if not cx_is_int(x.type) and cx_tkind(x.type) not=? 'bool_' {cx_fail(e  "this operation on {cx_dt(x.type)} is not supported")}
    let sg=cx_types[0].ptr[x.type].sign
    let p=CWord(x.i)
    let q=CWord(y.i)
    if not sg {
        p=p xor(-9223372036854775807 - 1)
        q=q xor(-9223372036854775807 - 1)
    }
    if op =? 'lt' {return cx_int(cx_T_BOOL[0]  int64(p <? q))}
    if op =? 'le' {return cx_int(cx_T_BOOL[0]  int64(p <=? q))}
    if op =? 'gt' {return cx_int(cx_T_BOOL[0]  int64(p >? q))}
    if op =? 'ge' {return cx_int(cx_T_BOOL[0]  int64(p >=? q))}
    if cx_int_policy(t) =? 2 and(op =? 'plus' or op =? 'minus' or op =? 'star' or op =? 'shl') {
        let left=cx_int(cx_T_MATH_INT[0]  x.i)
        let right=cx_int(cx_T_MATH_INT[0]  y.i)
        if not cx_types[0].ptr[x.type].sign and x.i <? 0 {left=cx_math_unpack(cx_math_runtime("__mi_unsigned"  [a]  e))}
        if not cx_types[0].ptr[y.type].sign and y.i <? 0 {right=cx_math_unpack(cx_math_runtime("__mi_unsigned"  [b]  e))}
        if op =? 'shl' and(y.i <? 0 or y.i >=? 64) {
            if x.i =? 0 {return cx_int(t  0)}
            let bits=CWord(cx_types[0].ptr[t].bits)
            if cx_types[0].ptr[t].sign {
                return cx_int(t  if x.i <? 0 {-(CWord(1) << (bits - 1))} else {(CWord(1) << (bits - 1)) - 1})
            }
            return cx_int(t  if bits =? 64 {-1} else {(CWord(1) << bits) - 1})
        }
        let value=cx_math_binary(e  op  left  right)
        let bits=CWord(cx_types[0].ptr[t].bits)
        let hi=if bits =? 64 {-1} else {(CWord(1) << bits) - 1}
        let lo:CWord=0
        if cx_types[0].ptr[t].sign {
            hi=CWord(uint64<overflow='wrap'>(hi) >> 1)
            lo=-hi - 1
        }
        let clamped=cx_math_runtime("__mi_clamp_word"  [cx_math_rep(value)  cx_int(cx_T_INT[0]  lo)  cx_int(cx_T_INT[0]  hi)  cx_int(cx_T_INT[0]  int64(not cx_types[0].ptr[t].sign))]  e)
        return cx_int(t  cx_value(clamped).i)
    }
    p=x.i
    q=y.i
    let r:CWord=0
    if op =? 'plus' {r=p + q}
    else if op =? 'minus' {r=p - q}
    else if op =? 'star' {r=p * q}
    else if op =? 'slash' or op =? 'percent' {
        if q =? 0 {cx_fail(e  "division by zero")}
        if sg and p =? - 9223372036854775807 - 1 and q =? - 1 {

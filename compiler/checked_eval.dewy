        return n
    }
    let n=cx_mk('int_lit'  pos)
    cx_nodes[0].ptr[n].type = int32<overflow='wrap'>(x.type)
    cx_nodes[0].ptr[n].ival = x.i
    cx_add_flag(n  NF_CHECKED)
    if k =? 'str_' {
        cx_nodes[0].ptr[n].kind ='str_lit'
        cx_nodes[0].ptr[n].sval = int32<overflow='wrap'>(cx_host[0].intern(x.s))
    }
    else if k =? 'float_' {
        cx_nodes[0].ptr[n].kind ='float_lit'
        cx_nodes[0].ptr[n].fval = x.f
    }
    else if k =? 'bool_' {cx_nodes[0].ptr[n].kind ='bool_lit'}
    else if k =? 'array' or k =? 'fixed' or k =? 'tuple' or k =? 'struct_' or k =? 'enum_' or k =? 'opt' {
        let items:array<int64>=[]
        loop item in x.items {items.push(cx_literal(item  pos))}
        cx_set_list(n  items)
        if k =? 'array' or k =? 'fixed' {cx_nodes[0].ptr[n].kind ='array'}
        else if k =? 'tuple' {cx_nodes[0].ptr[n].kind ='tuple'}
        else if k =? 'opt' {
            if x.i =? 0 {cx_nodes[0].ptr[n].kind ='none_lit'}
            else {
                cx_nodes[0].ptr[n].kind ='conv'
                cx_nodes[0].ptr[n].aux = int32<overflow='wrap'>(5)
                cx_nodes[0].ptr[n].a = int32<overflow='wrap'>(items[0])
                cx_set_list(n  [])
            }
        }
        else {
            cx_nodes[0].ptr[n].kind ='call'
            cx_nodes[0].ptr[n].aux = if k =? 'struct_' {2} else {3}
            cx_nodes[0].ptr[n].aux2 = int32<overflow='wrap'>(x.i)
        }
    }
    else if not cx_is_int(x.type) {cx_fail(n  "this value cannot be materialized")}
    n
}
cx_run=(e:CWord):>CWord=>$unsafe {
    let saved=cx_frame
    cx_frames.push(CTFrame[])
    cx_frame=cx_frames.length - 1
    let v=cx_expr(e)
    cx_frames.pop();
    cx_frame=saved
    v
# Reuse the bundled arithmetic inside the evaluator. CT mathematical integers
# have a word or one immutable BigInt value, independent of the tagged runtime boundary.
}
cx_math_runtime=(name:string args:array<int64> e:CWord):>CWord=>$unsafe {
    let f=cx_host[0].runtime_fn("__mc_{name.byte_slice(5 int64(cx_bytes(name).length))}")
    let call=cx_mk('call'  cx_nodes[0].ptr[e].pos)
    cx_nodes[0].ptr[call].sym = int32<overflow='wrap'>(f)
    cx_nodes[0].ptr[call].type = cx_fns[0][f].ret
    let actual:array<int64>=[]
    loop value in args {actual.push(cx_literal(value  cx_nodes[0].ptr[e].pos))}
    cx_set_list(call  actual)
    cx_fixed_internal += 1
    let result=cx_call(call)
    cx_fixed_internal -= 1
    result
}
cx_math_rep=(value:CWord):>CWord=>$unsafe {
    let x=cx_value(value)
    let f=cx_host[0].runtime_fn("__mc_compare")
    let rep=cx_prune(cx_fns[0][f].ptypes[0])
    tl_layout(rep)
    let handle=CWord(cx_fields[0].ptr[CWord(cx_structs[0].ptr[CWord(cx_types[0].ptr[rep].st)].fields) + 1].type)
    let word=cx_int(cx_T_INT[0]  x.i)
    let big=cx_add(CTValue[type = handle  items = x.items])
    cx_add(CTValue[type = rep  items = [word  big]])
}
cx_math_unpack=(value:CWord):>CWord=>$unsafe {
    let x=cx_value(value)
    cx_add(CTValue[type = cx_T_MATH_INT[0]  i = cx_value(x.items[0]).i  items = cx_value(x.items[1]).items])
}
cx_math_binary=(e:CWord op:Tok a:CWord b:CWord):>CWord=>$unsafe {
    if op =? 'starstar' {
        let exponent=cx_value(b).i
        if exponent <? 0 or cx_value(b).items.length >? 0 {cx_fail(e  "power exponent must be a nonnegative bounded integer")}
        let result=cx_int(cx_T_MATH_INT[0]  1)
        let base=a
        loop exponent >? 0 {
            if exponent & 1 not=? 0 {result=cx_math_binary(e  'star'  result  base)}
            exponent=exponent >> 1
            if exponent >? 0 {base=cx_math_binary(e  'star'  base  base)}
        }
        return result
    }
    let x=cx_math_rep(a)
    if op =? 'shl' or op =? 'shr' {
        let count=cx_value(b).i
        if cx_value(b).items.length >? 0 {
            count=cx_value(cx_math_runtime("__mi_count"  [cx_math_rep(b)]  e)).i
        }
        if count <? 0 {cx_fail(e  "shift count must be nonnegative")}
        let value=cx_math_runtime("__mi_shift"  [x  cx_int(cx_T_INT[0]  count)  cx_int(cx_T_BOOL[0]  int64(op =? 'shr'))]  e)
        return cx_math_unpack(value)
    }
    let y=cx_math_rep(b)
    if op =? 'eq' or op =? 'ne' or op =? 'lt' or op =? 'le' or op =? 'gt' or op =? 'ge' {
        let result=cx_math_runtime("__mi_compare"  [x  y]  e)
        return cx_binary(e  op  result  cx_int(cx_T_INT[0]  0)  cx_T_BOOL[0])
    }
    let operation=if op =? 'plus' {0} else {if op =? 'minus' {1} else {if op =? 'star' {2} else {if op =? 'slash' {3} else {if op =? 'percent' {4} else {if op =? 'amp' {5} else {if op =? 'pipe' {6} else {7}}}}}}}
    if cx_nodes[0].ptr[e].kind =? 'binary' and cx_nodes[0].ptr[e].aux2 =? - 1 and(op =? 'slash' or op =? 'percent') {operation += 5}
    cx_math_unpack(cx_math_runtime("__mi_slow"  [x  y  cx_int(cx_T_INT[0]  operation)]  e))
}
cx_math_for=(s:CWord):>void=>$unsafe {
    let it=CWord(cx_nodes[0].ptr[s].a)
    let counter=cx_expr(CWord(cx_nodes[0].ptr[it].a))
    let open_end=cx_nodes[0].ptr[it].b =? 0
    let bound=if open_end {cx_int(cx_T_MATH_INT[0]  0)} else {cx_expr(CWord(cx_nodes[0].ptr[it].b))}
    let step=cx_int(cx_T_MATH_INT[0]  1)
    if cx_has_flag(it  NF_STEP) {step=cx_binary(s  'minus'  cx_expr(CWord(cx_nodes[0].ptr[it].c))  counter  cx_T_MATH_INT[0])}
    if cx_frames[cx_frame].signal not=? 0 {return}
    let zero=cx_int(cx_T_MATH_INT[0]  0)
    if cx_value(cx_binary(s  'eq'  step  zero  cx_T_BOOL[0])).i not=? 0 {cx_fail(s  "zero range step")}
    let up=cx_value(cx_binary(s  'gt'  step  zero  cx_T_BOOL[0])).i not=? 0
    let inclusive=cx_has_flag(it  NF_INCLUSIVE)
    let op=if up {(if inclusive {Tok.le} else {Tok.lt})} else {(if inclusive {Tok.ge} else {Tok.gt})}
    loop true {
        if not open_end and cx_value(cx_binary(s  op  counter  bound  cx_T_BOOL[0])).i =? 0 {break}
        cx_frames[cx_frame].values[CWord(cx_nodes[0].ptr[s].sym)] = counter
        cx_block(CWord(cx_nodes[0].ptr[s].b));
        if cx_loop_exit() {break}
        counter=cx_binary(s  'plus'  counter  step  cx_T_MATH_INT[0])
    }
}

# Arguments finish before this immutable-value snapshot borrows the live header.
cx_value=(id:CWord):>CTValue=>$unsafe {cx_ct_values[0][id]}
cx_divide=(a:CWord b:CWord):>CWord=>{
    let q=a // b
    if (a <? 0) not=? (b <? 0) and mod(a b kind='trunc') not=? 0 {return q + 1}
    q
}

cx_bytes=(text:string):>array<uint8>=>$unsafe {text as array<uint8>}
let cx_token_values:array<Tok>=[Tok.eof Tok.newline Tok.indent Tok.dedent Tok.ident Tok.int_lit Tok.float_lit Tok.str_lit Tok.kw_struct Tok.kw_enum Tok.kw_if Tok.kw_else Tok.kw_in Tok.kw_break Tok.kw_continue Tok.kw_return Tok.kw_match Tok.kw_import Tok.kw_as Tok.kw_const Tok.kw_true Tok.kw_false Tok.kw_none Tok.kw_null Tok.kw_and Tok.kw_or Tok.kw_not Tok.kw_mut Tok.kw_when Tok.kw_defer Tok.kw_extern Tok.kw_test Tok.kw_build Tok.kw_use Tok.kw_pass Tok.lparen Tok.rparen Tok.lbrack Tok.rbrack Tok.lbrace Tok.rbrace Tok.comma Tok.colon Tok.semi Tok.dot Tok.dotdot Tok.arrow Tok.assign Tok.pluseq Tok.minuseq Tok.stareq Tok.slasheq Tok.percenteq Tok.ampeq Tok.pipeeq Tok.careteq Tok.shleq Tok.shreq Tok.plus Tok.minus Tok.star Tok.slash Tok.percent Tok.amp Tok.pipe Tok.caret Tok.tilde Tok.shl Tok.shr Tok.eq Tok.ne Tok.lt Tok.le Tok.gt Tok.ge Tok.question Tok.qq Tok.bang Tok.at Tok.starstar Tok.kw_loop Tok.kw_let Tok.kw_xor Tok.kw_is Tok.ellipsis Tok.dotop Tok.lazy]
cx_token=(value:CWord):>Tok=>$unsafe {cx_token_values[value]}
let cx_conversion_values:array<CXCV>=[CXCV.none_ CXCV.int_ CXCV.int2float CXCV.float2int CXCV.float_ CXCV.opt CXCV.ptr CXCV.bits CXCV.fn2clos CXCV.union_ CXCV.fixed2arr CXCV.arr2fixed CXCV.quantity_const CXCV.explicit_copy CXCV.refinement CXCV.big2math CXCV.math2big CXCV.set_text CXCV.promote CXCV.wrap_int CXCV.saturate_int CXCV.fixed_store]
cx_conversion=(value:CWord):>CXCV=>$unsafe {cx_conversion_values[value]}
let cx_intrinsic_kind_values:array<CXIN>=[CXIN.none_ CXIN.len CXIN.push CXIN.pop CXIN.insert CXIN.remove CXIN.clear CXIN.reserve CXIN.slice CXIN.syscall CXIN.memcpy CXIN.memset CXIN.sizeof CXIN.arrdata CXIN.panic CXIN.assert CXIN.print CXIN.embed CXIN.from_bytes CXIN.to_bytes CXIN.argv CXIN.setlen CXIN.truncate CXIN.resize CXIN.hash CXIN.alignof CXIN.unreachable CXIN.arrcap CXIN.fmt_struct CXIN.sqrt CXIN.vec_ctor CXIN.cfn_cast CXIN.wasm_call CXIN.callc CXIN.floor_ CXIN.ceil_ CXIN.fabs CXIN.fmin CXIN.fmax CXIN.setjmp CXIN.longjmp CXIN.jump CXIN.shader CXIN.extend CXIN.clone_thread CXIN.atomic_add CXIN.atomic_cas CXIN.stack_ptr CXIN.fill CXIN.fmt_elem CXIN.gpu_kernel CXIN.cpu_features CXIN.code_sync CXIN.compute CXIN.compute_spirv CXIN.compute_textures CXIN.read_fields CXIN.default_init CXIN.offset_unit CXIN.embed_dir CXIN.dewy_iter CXIN.dewy_iter_done CXIN.dewy_iter_value CXIN.json_fields CXIN.dewy_iter_pair CXIN.dewy_set CXIN.static_assert CXIN.runtime_assert CXIN.dewy_print CXIN.dewy_fmt CXIN.dewy_fmt_elem CXIN.lend CXIN.loan_address CXIN.loan_load CXIN.loan_store CXIN.loan_length CXIN.zeroed CXIN.relocate CXIN.take_slot CXIN.live_len CXIN.task_report CXIN.task_data CXIN.task_duration CXIN.arena_result CXIN.arrdata_permute CXIN.mul_hi CXIN.secret_wrap CXIN.secret_value CXIN.range_max CXIN.fixed_abs CXIN.integer_mode]
cx_intrinsic_kind=(value:CWord):>CXIN=>$unsafe {cx_intrinsic_kind_values[value]}

{
  "name": "dewy",
  "displayName": "Dewy",
  "description": "Dewy language support: highlighting, diagnostics as you type, completion, hover, navigation, rename, signature help, semantic highlighting, inlay hints, quick fixes, formatting, run/test/debug",
  "version": "0.1.9",
  "publisher": "RedFoxLabs",
  "engines": {
    "vscode": "^1.75.0"
  },
  "main": "./extension.js",
  "activationEvents": [
    "onLanguage:dewy",
    "onDebugResolve:dewy-core",
    "onDebugInitialConfigurations"
  ],
  "categories": [
    "Programming Languages"
  ],
  "icon": "images/dewy_logo_128x128.png",
  "files": [
    "extension.js",
    "compiler.js",
    "core-client.js",
    "core-debug.js",
    "core-test.js",
    "language-configuration.json",
    "syntaxes/dewy.tmLanguage.json",
    "images/dewy_logo_128x128.png",
    "images/dewy-file.png",
    "README.md",
    "LICENSE"
  ],
  "contributes": {
    "languages": [
      {
        "id": "dewy",
        "aliases": [
          "Dewy",
          "dewy"
        ],
        "extensions": [
          ".dewy"
        ],
        "icon": {
          "light": "./images/dewy-file.png",
          "dark": "./images/dewy-file.png"
        },
        "configuration": "./language-configuration.json"
      }
    ],
    "grammars": [
      {
        "language": "dewy",
        "scopeName": "source.dewy",
        "path": "./syntaxes/dewy.tmLanguage.json",
        "unbalancedBracketScopes": [
          "keyword.operator",
          "storage.type.function.arrow"
        ]
      }
    ],
    "breakpoints": [
      {
        "language": "dewy"
      }
    ],
    "debuggers": [
      {
        "type": "dewy-core",
        "label": "Dewy",
        "languages": [
          "dewy"
        ],
        "configurationAttributes": {
          "launch": {
            "required": [
              "program"
            ],
            "properties": {
              "program": {
                "type": "string",
                "description": "Dewy source file to compile with variable information.",
                "default": "${file}"
              },
              "args": {
                "type": [
                  "array",
                  "string"
                ],
                "description": "Program arguments as an array or a shell-style string.",
                "default": []
              },
              "cwd": {
                "type": "string",
                "description": "Program working directory; defaults to the source directory."
              },
              "env": {
                "type": "object",
                "additionalProperties": {
                  "type": "string"
                }
              },
              "stopOnPanic": {
                "type": "boolean",
                "default": true,
                "description": "Stop in the debugger when the program panics."
              }
            }
          }
        },
        "initialConfigurations": [
          {
            "type": "dewy-core",
            "request": "launch",
            "name": "Dewy: current file",
            "program": "${file}",
            "args": []
          }
        ],
        "configurationSnippets": [
          {
            "label": "Dewy: debug current file",
            "description": "Build the active .dewy file with variable information and debug it with CodeLLDB.",
            "body": {
              "type": "dewy-core",
              "request": "launch",
              "name": "Dewy: current file",
              "program": "^\"\\${file}\"",
              "args": []
            }
          },
          {
            "label": "Dewy: debug current file with arguments",
            "description": "The same, asking for the command line (split like a shell) each run.",
            "body": {
              "type": "dewy-core",
              "request": "launch",
              "name": "Dewy: current file with arguments",
              "program": "^\"\\${file}\"",
              "args": "^\"\\${command:dewy.programArguments}\""
            }
          }
        ]
      }
    ],
    "commands": [
      {
        "command": "dewy.core.run",
        "title": "Run Current File",
        "category": "Dewy",
        "icon": "$(play)"
      },
      {
        "command": "dewy.core.debug",
        "title": "Debug Current File",
        "category": "Dewy",
        "icon": "$(debug-alt)"
      },
      {
        "command": "dewy.core.test",
        "title": "Test Current File",
        "category": "Dewy"
      },
      {
        "command": "dewy.core.testRelease",
        "title": "Test Current File in Release Mode",
        "category": "Dewy"
      },
      {
        "command": "dewy.core.testWatch",
        "title": "Watch Tests in Current File",
        "category": "Dewy"
      },
      {
        "command": "dewy.core.runTest",
        "title": "Run Test",
        "category": "Dewy"
      },
      {
        "command": "dewy.core.restartServer",
        "title": "Restart Language Server",
        "category": "Dewy"
      },
      {
        "command": "dewy.programArguments",
        "title": "Program Arguments",
        "category": "Dewy"
      }
    ],
    "menus": {
      "commandPalette": [
        {
          "command": "dewy.programArguments",
          "when": "false"
        },
        {
          "command": "dewy.core.runTest",
          "when": "false"
        },
        {
          "command": "dewy.core.run",
          "when": "editorLangId == dewy && resourceScheme == file && processExecutionSupported"
        },
        {
          "command": "dewy.core.debug",
          "when": "editorLangId == dewy"
        },
        {
          "command": "dewy.core.test",
          "when": "editorLangId == dewy && resourceScheme == file && processExecutionSupported"
        },
        {
          "command": "dewy.core.testRelease",
          "when": "editorLangId == dewy && resourceScheme == file && processExecutionSupported"
        },
        {
          "command": "dewy.core.testWatch",
          "when": "editorLangId == dewy && resourceScheme == file && processExecutionSupported"
        }
      ],
      "editor/title/run": [
        {
          "command": "dewy.core.run",
          "when": "editorLangId == dewy && resourceScheme == file && processExecutionSupported",
          "group": "navigation@0"
        },
        {
          "command": "dewy.core.debug",
          "when": "resourceLangId == dewy && resourceScheme == file",
          "group": "navigation@1"
        }
      ],
      "editor/context": [
        {
          "command": "dewy.core.run",
          "when": "editorLangId == dewy && resourceScheme == file && processExecutionSupported",
          "group": "navigation@19"
        },
        {
          "command": "dewy.core.test",
          "when": "editorLangId == dewy && resourceScheme == file && processExecutionSupported",
          "group": "navigation@20"
        }
      ]
    },
    "configuration": {
      "title": "Dewy",
      "properties": {
        "dewy.core.path": {
          "type": "string",
          "default": "",
          "description": "Path to the dewy-core compiler or a checkout's tools/dewy launcher. Empty: the compiler bundled with this platform's extension, else ~/.dewy/bin/dewy-core from the installer, else dewy-core on the PATH. A standalone toolchain needs its sibling lib/ directory.",
          "scope": "machine-overridable",
          "markdownDescription": "Path to the `dewy-core` compiler or a checkout's `tools/dewy` launcher. Empty: the compiler bundled with this platform's extension, else `~/.dewy/bin/dewy-core` from the installer, else `dewy-core` on the `PATH`. A standalone toolchain needs its sibling `lib/` directory."
        }
      }
    }
  },
  "license": "GPL-3.0",
  "repository": {
    "type": "git",
    "url": "https://github.com/david-andrew/dewy-lang"
  },
  "capabilities": {
    "untrustedWorkspaces": {
      "supported": "limited",
      "description": "Highlighting works everywhere; the compiler (language server, run, test, debug) starts once the workspace is trusted.",
      "restrictedConfigurations": [
        "dewy.core.path"
      ]
    }
  },
  "keywords": [
    "dewy",
    "language server",
    "programming language"
  ]
}

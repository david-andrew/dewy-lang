{
  "$schema": "https://raw.githubusercontent.com/martinring/tmlanguage/master/tmlanguage.json",
  "name": "Dewy",
  "scopeName": "source.dewy",
  "patterns": [
    {
      "include": "#expression"
    }
  ],
  "repository": {
    "comment": {
      "patterns": [
        {
          "include": "#block-comment"
        },
        {
          "include": "#line-comment"
        }
      ]
    },
    "block-comment": {
      "comment": "nestable #{ ... }#",
      "name": "comment.block.dewy",
      "begin": "#\\{",
      "end": "\\}#",
      "beginCaptures": {
        "0": {
          "name": "punctuation.definition.comment.begin.dewy"
        }
      },
      "endCaptures": {
        "0": {
          "name": "punctuation.definition.comment.end.dewy"
        }
      },
      "patterns": [
        {
          "include": "#block-comment"
        }
      ]
    },
    "line-comment": {
      "name": "comment.line.number-sign.dewy",
      "match": "#.*$"
    },
    "string-escape": {
      "name": "constant.character.escape.dewy",
      "match": "\\\\(?:u\\{[0-9A-Fa-f]+\\}|U\\{[0-9A-Fa-f]+\\}|.)"
    },
    "interpolation": {
      "name": "meta.interpolation.dewy",
      "begin": "\\{",
      "end": "\\}",
      "beginCaptures": {
        "0": {
          "name": "punctuation.section.interpolation.begin.dewy"
        }
      },
      "endCaptures": {
        "0": {
          "name": "punctuation.section.interpolation.end.dewy"
        }
      },
      "contentName": "source.dewy.embedded",
      "patterns": [
        {
          "include": "#expression"
        }
      ]
    },
    "string": {
      "patterns": [
        {
          "name": "string.quoted.raw.triple.dewy",
          "begin": "r\"\"\"",
          "end": "\"\"\"",
          "beginCaptures": {
            "0": {
              "name": "punctuation.definition.string.begin.dewy"
            }
          },
          "endCaptures": {
            "0": {
              "name": "punctuation.definition.string.end.dewy"
            }
          }
        },
        {
          "name": "string.quoted.raw.triple.dewy",
          "begin": "r'''",
          "end": "'''",
          "beginCaptures": {
            "0": {
              "name": "punctuation.definition.string.begin.dewy"
            }
          },
          "endCaptures": {
            "0": {
              "name": "punctuation.definition.string.end.dewy"
            }
          }
        },
        {
          "name": "string.quoted.raw.double.dewy",
          "begin": "r\"",
          "end": "\"",
          "beginCaptures": {
            "0": {
              "name": "punctuation.definition.string.begin.dewy"
            }
          },
          "endCaptures": {
            "0": {
              "name": "punctuation.definition.string.end.dewy"
            }
          }
        },
        {
          "name": "string.quoted.raw.single.dewy",
          "begin": "r'",
          "end": "'",
          "beginCaptures": {
            "0": {
              "name": "punctuation.definition.string.begin.dewy"
            }
          },
          "endCaptures": {
            "0": {
              "name": "punctuation.definition.string.end.dewy"
            }
          }
        },
        {
          "comment": "p\"file.dewy\" and other prefixed strings: a name written against a string",
          "match": "\\b(?!r[\"\\'])([A-Za-z_][A-Za-z0-9_]*)(?=[\"\\'])",
          "name": "storage.type.string.prefix.dewy"
        },
        {
          "name": "string.quoted.triple.dewy",
          "begin": "\"\"\"",
          "end": "\"\"\"",
          "beginCaptures": {
            "0": {
              "name": "punctuation.definition.string.begin.dewy"
            }
          },
          "endCaptures": {
            "0": {
              "name": "punctuation.definition.string.end.dewy"
            }
          },
          "patterns": [
            {
              "include": "#string-escape"
            },
            {
              "include": "#interpolation"
            }
          ]
        },
        {
          "name": "string.quoted.triple.dewy",
          "begin": "'''",
          "end": "'''",
          "beginCaptures": {
            "0": {
              "name": "punctuation.definition.string.begin.dewy"
            }
          },
          "endCaptures": {
            "0": {
              "name": "punctuation.definition.string.end.dewy"
            }
          },
          "patterns": [
            {
              "include": "#string-escape"
            },
            {
              "include": "#interpolation"
            }
          ]
        },
        {
          "name": "string.quoted.double.dewy",
          "begin": "\"",
          "end": "\"",
          "beginCaptures": {
            "0": {
              "name": "punctuation.definition.string.begin.dewy"
            }
          },
          "endCaptures": {
            "0": {
              "name": "punctuation.definition.string.end.dewy"
            }
          },
          "patterns": [
            {
              "include": "#string-escape"
            },
            {
              "include": "#interpolation"
            }
          ]
        },
        {
          "name": "string.quoted.single.dewy",
          "begin": "'",
          "end": "'",
          "beginCaptures": {
            "0": {
              "name": "punctuation.definition.string.begin.dewy"
            }
          },
          "endCaptures": {
            "0": {
              "name": "punctuation.definition.string.end.dewy"
            }
          },
          "patterns": [
            {
              "include": "#string-escape"
            },
            {
              "include": "#interpolation"
            }
          ]
        }
      ]
    },
    "number": {
      "patterns": [
        {
          "comment": "binary data: 0x\"ff00\"",
          "name": "constant.numeric.bytes.dewy",
          "match": "\\b0[btqsodzxug]([\"\\'])[0-9A-Za-z_ ]*\\1"
        },
        {
          "comment": "based integers: 0xFF, 0b1010, 0d42",
          "match": "\\b(0[btqsodzxug][0-9A-Za-z_]+)",
          "captures": {
            "1": {
              "name": "constant.numeric.integer.based.dewy"
            }
          }
        },
        {
          "comment": "decimals with an optional unit: 42, 1_000, 2.5e-3, 300ms, 9.81m",
          "match": "(?<![A-Za-z0-9_.])(\\d[\\d_]*(?:\\.\\d[\\d_]*)?(?:[eE][+-]?\\d[\\d_]*)?)([A-Za-z_][A-Za-z0-9_]*)?",
          "captures": {
            "1": {
              "name": "constant.numeric.decimal.dewy"
            },
            "2": {
              "name": "keyword.other.unit.dewy"
            }
          }
        }
      ]
    },
    "directive": {
      "patterns": [
        {
          "match": "(\\$)(assert|runtime_assert|capture|include_bytes|abstract|allocator|breakpoint|expect|explicit_copies|fail|field|lend|no_prelude|proof|prototype|prototype_warnings|supported_targets|target|test|unsafe_assume|__copy__|__drop__|__move__)\\b",
          "captures": {
            "0": {
              "name": "keyword.other.directive.dewy"
            },
            "1": {
              "name": "punctuation.definition.directive.dewy"
            }
          }
        },
        {
          "comment": "loop labels: $rows before a loop, break $rows",
          "match": "(\\$)([A-Za-z_][A-Za-z0-9_]*)",
          "captures": {
            "0": {
              "name": "entity.name.label.dewy"
            },
            "1": {
              "name": "punctuation.definition.label.dewy"
            }
          }
        }
      ]
    },
    "keyword": {
      "patterns": [
        {
          "name": "keyword.control.import.dewy",
          "match": "\\b(?:import|from)\\b"
        },
        {
          "name": "keyword.control.dewy",
          "match": "\\b(?:if|else|loop|match|return|break|continue|or_throw)\\b"
        },
        {
          "name": "storage.type.dewy",
          "match": "\\b(?:let|const)\\b"
        },
        {
          "name": "keyword.operator.comparison.word.dewy",
          "match": "\\b(?:is|isnt|in)\\?"
        },
        {
          "name": "keyword.operator.comparison.dewy",
          "match": "(?<![A-Za-z0-9_])\\.?not(?:>=|<=|=|>|<)\\?"
        },
        {
          "name": "keyword.operator.word.dewy",
          "match": "\\b(?:and|or|xor|nand|nor|xnor|not|in|of|as|transmute)\\b"
        },
        {
          "name": "constant.language.dewy",
          "match": "\\b(?:true|false|none)\\b"
        }
      ]
    },
    "type-declaration": {
      "comment": "Point:type=[x:float64 y:float64]",
      "match": "^\\s*(?:(?:let|const)\\s+)?([A-Za-z_][A-Za-z0-9_]*)\\s*(:)\\s*(type)\\b",
      "captures": {
        "1": {
          "name": "entity.name.type.dewy"
        },
        "2": {
          "name": "punctuation.separator.annotation.dewy"
        },
        "3": {
          "name": "support.type.dewy"
        }
      }
    },
    "function-declaration": {
      "comment": "name = <T>(params) => body, name = (params):>Result => body",
      "match": "^\\s*(?:(?:let|const)\\s+)?([A-Za-z_][A-Za-z0-9_]*)(?=\\s*=\\s*(?:<(?:[^<>]|<[^<>]*>)*>\\s*)?\\((?:[^()]|\\((?:[^()]|\\([^()]*\\))*\\))*\\)\\s*(?:=>|:>))",
      "captures": {
        "1": {
          "name": "entity.name.function.dewy"
        }
      }
    },
    "type-name": {
      "patterns": [
        {
          "name": "support.type.builtin.dewy",
          "match": "\\b(?:int|int8|int16|int32|int64|int128|uint|uint8|uint16|uint32|uint64|uint128|float32|float64|bool|string|array|dict|set|void|type|error|vec2|vec3|vec4|mat4|quat|bigint|rational|NDArray)\\b(?!\\s*=[^=?>])"
        },
        {
          "comment": "Capitalized names are types by convention; the language server refines them",
          "name": "entity.name.type.dewy",
          "match": "\\b[A-Z][A-Za-z0-9_]*\\b(?!\\s*\\()"
        }
      ]
    },
    "handle": {
      "comment": "@f: the function itself; @x: the place itself",
      "match": "(@)(?=[A-Za-z_][A-Za-z0-9_]*)",
      "captures": {
        "1": {
          "name": "storage.modifier.reference.dewy"
        }
      }
    },
    "call": {
      "patterns": [
        {
          "match": "\\b(printl|print|assert)\\b(?=\\()",
          "captures": {
            "1": {
              "name": "support.function.builtin.dewy"
            }
          }
        },
        {
          "match": "(?<=\\.)([A-Za-z_][A-Za-z0-9_]*)(?=\\(|<[^<>()]*>\\()",
          "captures": {
            "1": {
              "name": "entity.name.function.member.dewy"
            }
          }
        },
        {
          "match": "\\b([A-Za-z_][A-Za-z0-9_]*)(?=\\(|<(?:[^<>()]|<[^<>()]*>)*>\\()",
          "captures": {
            "1": {
              "name": "entity.name.function.call.dewy"
            }
          }
        }
      ]
    },
    "member": {
      "match": "(?<=\\.)([A-Za-z_][A-Za-z0-9_]*)",
      "captures": {
        "1": {
          "name": "variable.other.member.dewy"
        }
      }
    },
    "operator": {
      "patterns": [
        {
          "name": "storage.type.function.arrow.dewy",
          "match": "=>"
        },
        {
          "name": "keyword.operator.type.returns.dewy",
          "match": ":>"
        },
        {
          "name": "keyword.operator.mapping.dewy",
          "match": "->"
        },
        {
          "name": "keyword.operator.comparison.dewy",
          "match": "\\.?(?:<=|>=|=|<|>)\\?"
        },
        {
          "name": "keyword.operator.coalesce.dewy",
          "match": "\\?\\?"
        },
        {
          "name": "keyword.operator.spread.dewy",
          "match": "\\.\\.\\."
        },
        {
          "name": "keyword.operator.range.dewy",
          "match": "\\.\\."
        },
        {
          "name": "keyword.operator.pipe.dewy",
          "match": "\\|>|<\\|"
        },
        {
          "name": "keyword.operator.assignment.compound.dewy",
          "match": "\\.?(?://|<<|>>|[-+*/%^])="
        },
        {
          "name": "keyword.operator.bitwise.shift.dewy",
          "match": "<<|>>"
        },
        {
          "name": "keyword.operator.arithmetic.dewy",
          "match": "\\.?(?://|[-+*/%^])"
        },
        {
          "name": "keyword.operator.assignment.dewy",
          "match": "="
        },
        {
          "name": "keyword.operator.type.dewy",
          "match": "[|&?]"
        }
      ]
    },
    "punctuation": {
      "patterns": [
        {
          "name": "punctuation.separator.annotation.dewy",
          "match": ":"
        },
        {
          "name": "punctuation.separator.comma.dewy",
          "match": ","
        },
        {
          "name": "punctuation.terminator.statement.dewy",
          "match": ";"
        },
        {
          "name": "punctuation.accessor.dewy",
          "match": "\\."
        },
        {
          "name": "punctuation.definition.typeparameters.dewy",
          "match": "[<>]"
        }
      ]
    },
    "expression": {
      "patterns": [
        {
          "include": "#comment"
        },
        {
          "include": "#string"
        },
        {
          "include": "#number"
        },
        {
          "include": "#directive"
        },
        {
          "include": "#type-declaration"
        },
        {
          "include": "#function-declaration"
        },
        {
          "include": "#keyword"
        },
        {
          "include": "#handle"
        },
        {
          "include": "#call"
        },
        {
          "include": "#type-name"
        },
        {
          "include": "#member"
        },
        {
          "include": "#operator"
        },
        {
          "include": "#punctuation"
        }
      ]
    }
  }
}

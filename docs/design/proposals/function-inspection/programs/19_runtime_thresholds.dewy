# Positive bounded-specialization case: many values, one inspected body.
import p"fixtures.dewy" as fixture
main = () => {
    let db = fixture.seed or_throw
    loop threshold in [0..10000) {
        let query = db.accounts.where((a) => a.balance <? threshold)
        let page = query.page(size=1 max_scanned=1000) or_throw
        if threshold =? 0 { printl(page.items.length) }
    }
    # One body template and runtime bindings; never 10,000 compiler instances.
}

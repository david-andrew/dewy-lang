# A queue processor with a status ticker and early stop on SIGTERM. The ticker is incidental;
# the signal loop is incidental by the library (its wait is marked), so both end with the work.
import p"@lib/std/signals.dewy" as signals

process_queue = (dir:Path done:Atomic<int>) => {
    loop file in dir.glob"*.job" {
        run_job(file) or_throw
        done.add(1 'relaxed')
    }
}

main = () => {
    let done = atomic(0)
    parallel {
        process_queue(p"queue" done) or_throw
        $incidental {
            let heart = ticker(10s)
            loop true {
                heart.next or_throw;                 # Tick | Canceled
                printl"{done.load'relaxed'} jobs so far"
            }
        }
        loop _ in signals.sigterm {
            printl"SIGTERM: stopping after the current job"
            return
        }
    }
    printl"all {done.load'relaxed'} jobs done"
}
# Today's rule (LANGUAGE.md, signals) keeps this block alive forever: the ticker is ordinary
# activity. Here it is incidental, so the block ends when process_queue does.

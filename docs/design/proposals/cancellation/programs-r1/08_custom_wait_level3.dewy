# A thumbnail service: one worker owns an expensive codec; callers send jobs carrying their own
# cancel request, so a caller that gives up also stops its job inside the worker.
# select's exact signature is still open; this uses the batch 7 form (waits written in the call,
# arms by type, source-qualified arms).
import p"@lib/std/tasks.dewy" as task

Reply:type = [result:Thumb | CodecError]
Job:type = [path:Path reply:Channel<Reply> cancel:task.CancelRequest]

serve_jobs = (jobs:Channel<Job>) => {
    let codec = open_codec or_throw
    loop job in jobs {
        codec.start(job.path)
        match select(@codec.finished @job.cancel.wait) {
            thumb:Thumb => job.reply.send(Reply[thumb]) ?? void    # the caller may be gone
            problem:CodecError => job.reply.send(Reply[problem]) ?? void
            <job.cancel.Canceled> => codec.abort()                 # this caller gave up; keep serving
            <Canceled> => break                                    # the worker itself was canceled
        }
    }
}

thumbnail = (jobs:Channel<Job> path:Path) => {
    let reply = channel<Reply>(1)
    jobs.send(Job[path reply task.cancel_request]) or_throw       # this task's own request
    let answer = reply.receive or_throw
    answer.result
}

main = () => {
    let jobs = channel<Job>(16)
    parallel {
        serve_jobs(jobs) or_throw
        {
            let thumbs = [loop f in p"photos".glob"*.jpg" within(2s @thumbnail(jobs f)) ?? void]
            jobs.close()
            printl"{thumbs.length} thumbnails"
        }
    }
}

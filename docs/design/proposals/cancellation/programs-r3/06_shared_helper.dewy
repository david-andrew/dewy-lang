# One helper called both where nothing can cancel and from a parallel item.
Config:type = [theme:string width:int]

load_config = (path:Path) => {
    let text = path.read_text or_throw
    parse_config(text) or_throw
}
# hover: Config | FileError | ParseError
#   + Canceled at line 15 (a parallel item; canceled if line 16 leaves main early).
#   Not at line 13 (main: nothing can cancel it).

main = () => {
    let base = load_config(p"app.toml") or_throw            # Config | FileError | ParseError
    parallel (
        let local = load_config(p"local.toml") ?? base      # this ?? also covers its Canceled
        let theme = load_theme(base.theme) or_throw         # leaves main on failure: cancels line 15
    )
    run(merge(base local) theme)                            # local:Config, theme:Theme
}

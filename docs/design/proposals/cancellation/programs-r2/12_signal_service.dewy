# A queue processor with a status ticker and early stop on SIGTERM. SIGTERM finishes the job
# in progress (up to 30 s), starts no new one, and ends the program.
import p"@lib/std/signals.dewy" as signals

process_queue = (dir:Path done:Atomic<int>) => {
    loop file in dir.glob"*.job" {
        check_cancel() or_throw                              # stop between jobs, not inside one
        protect_from_cancel(30s @run_job(file)) or_throw     # a started job gets up to 30 s
        done.add(1 'relaxed')
    }
}

main = () => {
    let done = atomic(0)
    parallel {
        process_queue(p"queue" done) or_throw
        $until_others_finish {
            let heart = ticker(10s)
            loop heart.next is? Tick printl"{done.load'relaxed'} jobs so far"
        }
        loop _ in signals.sigterm {
            printl"SIGTERM: finishing the current job, then stopping"
            return
        }
    }
    printl"all {done.load'relaxed'} jobs done"
}
# The ticker item would keep the block alive forever under batch 9 alone (a timer is ordinary
# activity); marked, it is canceled once process_queue ends. The SIGTERM loop ends then too, by
# batch 9's unchanged rule: only signal waits remain, so the block closes its signal views.

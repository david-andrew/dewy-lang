# A game with a background asset watcher that is stopped when the game ends.
main = (app:BackgroundTasks) => {
    let watcher = app.spawn(@watch_assets(p"assets"))   # cancellable: its group can stop it
    run_game() or_throw                                  # void | GameError: nothing can cancel main
    if not watcher.running printl"asset watcher had already stopped"
    watcher.stop()
    watcher.wait() or_throw                              # void | WatchError: the Canceled that
}                                                        # stop() caused is not reported back

watch_assets = (dir:Path) => {
    loop change in dir.watch or_throw {                  # WatchError, or this task's Canceled, leaves
        match reload(change.path) {
            problem:error => printl("reload failed: {problem}" file=stderr)
            _ => {}
        }
    }
}

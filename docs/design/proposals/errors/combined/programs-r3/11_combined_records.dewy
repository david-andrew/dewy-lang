# 11. Combined objects (not errors): one value is both a User and its Settings; `as` takes either back.
# User and Settings are minted (`type of any`), so a value can't be both at once: `and` keeps two facets,
# each with its own `id`. Plain records merge instead (round3.md, M1); see the end of the file.
User:type = type of any & [id:int name:string]
Settings:type = type of any & [id:int theme:'light' | 'dark' font_size:int]
greet = (user:User):>string => "hello {user.name}"
save_settings = (settings:Settings):>void => printl"saving settings row {settings.id}"
render = (profile:User & Settings):>void => {
    printl(greet(profile))                                    # the User facet is what greet takes
    printl"{profile.name}: {profile.theme} theme, {profile.font_size}pt"   # one facet has it: direct
    printl"user {(profile as User).id}, settings {(profile as Settings).id}"   # both have `id`: name one
    save_settings(profile)
}
Size:type = [width:int height:int]                           # plain records: `and` merges them
Place:type = [x:int y:int]
area = (box:Size & Place):>int => box.width * box.height
main = () => {
    render(User[7 "ana"] and Settings[31 'dark' 14])
    printl(area(Size[3 4] and Place[0 0]))                     # one record with four fields
}
# A declared intersection of plain records that share a field keeps today's merged field, and
# `Point[1 2] and Pos[3 4]` (plain records that both declare `x`) is an error: "both declare `x`;
# mint one of them (`type of any & [...]`) to keep two, or build one record".

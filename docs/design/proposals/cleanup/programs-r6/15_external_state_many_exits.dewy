# PAPER: editor is task-confined; callbacks consult its existing busy flag.
# PaintError/Invalid/none are ordinary results; busy is not a resource owner.
import p"editor_case.dewy" as ui
refresh = (@editor:ui.Editor rows:array<string>) => {
    let was_busy = editor.busy
    editor.busy = true
    defer editor.busy = was_busy
    loop row in rows {
        if row =? "stop" return
        if row =? "bad" return ui.Invalid
        if row =? "missing" return none
        check_cancel() or_throw
        ui.paint(@editor row) or_throw
    }
}

refresh_body = (@editor:ui.Editor rows:array<string>) => {
    loop row in rows {
        if row =? "stop" return
        if row =? "bad" return ui.Invalid
        if row =? "missing" return none
        check_cancel() or_throw
        ui.paint(@editor row) or_throw
    }
}
refresh_without_defer = (@editor:ui.Editor rows:array<string>) => {
    let was_busy = editor.busy
    editor.busy = true
    let result = refresh_body(@editor rows)
    editor.busy = was_busy
    return result
}
# No-defer works for ALL ordinary return/exception/cancellation results, even many exits.
# It costs a helper boundary; it fails restoration on supported panic/exit unwinding.
# Restore the previous value, not false: recursive/reentrant calls may already be busy.
# This is not a concurrency lock; sharing editor across tasks needs separate ownership.

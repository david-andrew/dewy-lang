# PAPER R4: infallible local socket release still follows proven last use.
import p"@lib/std/net.dewy" as net
EmptyReply:type = type of error
fetch_header = () => {
    let stream = net.tcp_connect("127.0.0.1" 8080) or_throw
    net.tcp_send(stream "HEAD / HTTP/1.0\r\nHost: localhost\r\n\r\n") or_throw
    let reply = net.tcp_receive(stream)
    if reply is? none return EmptyReply
    let bytes = reply or_throw
    if bytes.length =? 0 return EmptyReply
    return bytes
}
main = () => {
    let header = fetch_header or_throw
    printl"received {header.length} bytes"
}
# The owner releases on both early returns, NetError and Canceled.
# No defer/close line. Successful send does not promise peer acknowledgement.

# Count log lines per level; the parsed entries live in an array of inferred records.
Level:type = <0 | 1 | 2 | 3 | 4>
NAMES = ["debug" "info" "warn" "error" "fatal"]

level_of = (word:string):>Level | none => {
    loop l in members(Level) { if word =? NAMES[l] return l }
    none
}

entries = (lines:array<string>) => [loop line in lines {
    let words = line.split(" ")
    if words.length <? 2 continue
    [level = level_of(words[0]) ?? continue  text = words[1..].join(" ")]   # array<[level:Level text:string]> under (a)
}]

main = () => {
    let lines:array<string> = []
    loop true { let line = read_line(); if line isnt? string break; lines.push(line) }
    let log = entries(lines)
    let counts:array<int64 length=5> = [0 0 0 0 0]
    loop e in log counts[e.level] += 1                          # (b): e.level is int64: index needs 0..4
    loop name in NAMES and n in counts printl"{fmt'<6'(name)} {n}"
    let worst = [loop e in log if e.level >=? 3 e]
    if worst.length >? 0 printl"first problem: {worst[0].text}"
}

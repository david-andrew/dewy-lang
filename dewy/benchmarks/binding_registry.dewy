# Repeated stable-id lookup across many compiler metadata pages. Print the
# checksum, lookup nanoseconds, and lookup allocation traffic.
import reporting as reporting
import p"../bootstrap/semantic/bindings.dewy" as bindings
import p"apps/harness.dewy" as harness

main=():>int64=>{
    let registry=bindings.Registry[]
    let location=reporting.Span[0 1]
    loop i in 0.. and i <? 32768 {
        bindings.allocate(@registry none 'entry' 'value' location);
    }
    let checksum:int64=0
    let before=_arena_allocated_bytes
    let started=harness.clock()
    loop i in 0.. and i <? 1000000 {
        let id:addr=2*((i*17)%32768)+1
        checksum=(checksum+bindings.binding_at(registry id).id)%1000000007
    }
    let elapsed=harness.clock()-started
    let allocated=_arena_allocated_bytes-before
    printl"{checksum} {elapsed} {allocated}"
    return 0
}

# Sloppy counterpart of records.dewy / records.c. Same integers, input generator,
# indexed updates, 50 steps and checksum; no manual pointer/SoA optimization.
# The runner chooses debug or release. Sloppy stores Particle[] densely;
# Dewy currently stores an array of references to individually boxed records.
struct Particle:
    x: int
    y: int
    dx: int
    dy: int

const BOX = 4096

mix = (hash: int, value: int) -> int: (hash * 31 + value) % 1000000007

populate = (count: int) -> Particle[]:
    particles: Particle[]
    seed = 2024
    loop i in [0..count):
        seed = (seed * 1103515245 + 12345) % 2147483648
        x = seed % BOX
        seed = (seed * 1103515245 + 12345) % 2147483648
        y = seed % BOX
        seed = (seed * 1103515245 + 12345) % 2147483648
        particles.push(Particle(x, y, seed % 17 - 8, (seed / 32) % 17 - 8))
    particles

step = (particles: mut Particle[]):
    loop i in [0..particles.len()):
        x = particles[i].x + particles[i].dx
        y = particles[i].y + particles[i].dy
        if x < 0 or x >= BOX:
            particles[i].dx = 0 - particles[i].dx
            x = particles[i].x
        if y < 0 or y >= BOX:
            particles[i].dy = 0 - particles[i].dy
            y = particles[i].y
        particles[i].x = x
        particles[i].y = y

kernel = (particles: mut Particle[], rounds: int) -> int:
    loop round in [0..rounds): step(particles)
    hash = 3
    loop particle in particles: hash = mix(mix(hash, particle.x), particle.y)
    hash

main = ():
    count = 100000
    a = args()
    if a.len() > 1: count = to_int(a[1]) ?? count
    particles = populate(count)
    started = time_ns()
    result = kernel(particles, 50)
    finished = time_ns()
    print("{result} {finished - started}")

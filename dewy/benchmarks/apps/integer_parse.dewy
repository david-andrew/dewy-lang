# Parse ordinary signed decimal input; input construction is outside the timer.
from p"harness.dewy" import size_argument, clock
kernel=(texts:array<string> count:int64):>int64=>{
    let checksum:int64=0
    loop i in [0..count) {
        let value=to_int(texts[i and 31])
        if value is? none return -1
        checksum+=(value and 65535)
    }
    return checksum
}
main=(args:array<string>):>int64=>{
    let count=size_argument(args 2000000)
    let texts:array<string>=[]
    loop i in [0..32) {
        let value:int64=123456789012345+i*23456789
        texts.push("{if i%2=?0 value else -value}")
    }
    let started=clock()
    let result=kernel(texts count)
    printl"{result} {clock()-started}"
    return 0
}

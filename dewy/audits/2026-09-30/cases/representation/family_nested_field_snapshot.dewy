let Root=type of [x:int64]
let Child=type of Root & [y:int64]
make=(flag:bool):>Root=>if flag Child[20 22] else Root[42]
score=(x:Root):>int64=>if x is? Child x.x+x.y else x.x
Holder:type=[value:Root]
read=(h:Holder):>Root=>h.value
main=():>int64=>{
let original=Holder[Child[20 22]] let saved=read(original)
original.value=Root[99] return score(saved)}

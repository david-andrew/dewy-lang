let Root=type of [x:int64]
let Child=type of Root & [y:int64]
make=(flag:bool):>Root=>if flag Child[20 22] else Root[42]
score=(x:Root):>int64=>if x is? Child x.x+x.y else x.x
at=(xs:array<Root> i:addr<n=>n<?xs.length>):>Root=>xs[i].copy()
grow=(@xs:array<Root>):>void=>{xs.push(Child[100 200])}
main=():>int64=>{
let values:array<Root>=[Child[20 22]] let saved=at(values 0)
loop i in 0..31 {grow(@values)}
return score(saved)}

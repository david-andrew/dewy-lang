  "patch": "diff --git a/core/compiler/ir.jo b/core/compiler/ir.jo\nindex 53de4841..96fd3b13 100644\n--- a/core/compiler/ir.jo\n+++ b/core/compiler/ir.jo\n@@ -307,6 +307,28 @@ dump_ir = ():\n         print(line)\n         if ins.op == .block or ins.op == .loop or ins.op == .if_ or ins.op == .else_: ind += 1\n \n+# Low bits encode the ordinary use count; bit 2 marks a destination. Larger\n+# descriptors select instructions whose operands depend on flags or argument spans.\n+# Keep the final opcode here in sync when extending Op.\n+ir_make_operand_shapes = () -> u8[]:\n+    shapes = fill(u8(6), int(Op.streq) + 1)\n+    loop op in [Op.nop, Op.block, Op.loop, Op.end, Op.else_, Op.br, Op.trap, Op.zeroslots, Op.vzu]: shapes[int(op)] = 0\n+    loop op in [Op.iconst, Op.fconst, Op.slot, Op.gaddr, Op.daddr, Op.faddr]: shapes[int(op)] = 4\n+    loop op in [Op.if_, Op.brif, Op.brtable, Op.assume, Op.zero]: shapes[int(op)] = 1\n+    shapes[int(Op.copy)] = 2\n+    loop op in [Op.memcpy, Op.memset, Op.vop]: shapes[int(op)] = 3\n+    loop op in [Op.select, Op.memeq]: shapes[int(op)] = 7\n+    loop op in [Op.mov, Op.neg, Op.not_, Op.fneg, Op.fsqrt, Op.fabs, Op.ffloor, Op.fceil, Op.ftrunc, Op.sext8, Op.sext16, Op.sext32, Op.zext8, Op.zext16, Op.zext32, Op.i2f, Op.u2f, Op.f2i, Op.f2f, Op.bits2f, Op.f2bits, Op.vsplat]: shapes[int(op)] = 5\n+    loop op in [Op.intr, Op.call, Op.syscall]: shapes[int(op)] = 8\n+    loop op in [Op.calli, Op.callc]: shapes[int(op)] = 9\n+    shapes[int(Op.ret)] = 10\n+    shapes[int(Op.store)] = 11\n+    shapes[int(Op.vst)] = 12\n+    shapes[int(Op.load)] = 13\n+    shapes\n+\n+ir_operand_shapes = ir_make_operand_shapes()\n+\n ir_use_count = 0\n ir_use_values: (int, int, int)\n ir_use_span = -1\n@@ -331,7 +353,8 @@ ir_has_use = (v: int) -> bool:\n # Sets the operand view; returns the defined vreg or -1. zeroslots definitions\n # are carried in ir.args and handled separately by the consumers.\n ir_operands = (ins: Ins) -> int:\n-    ir_use_count = 0\n+    shape = int(ir_operand_shapes[int(ins.op)])\n+    ir_use_count = shape & 3\n     ir_use_span = -1\n     a = int(ins.a)\n     bb = int(ins.b)\n@@ -339,58 +362,28 @@ ir_operands = (ins: Ins) -> int:\n     ir_use_values.0 = a\n     ir_use_values.1 = bb\n     ir_use_values.2 = int(ins.c)\n-    match ins.op:\n-        nop, block, loop, end, else_, br, trap, zeroslots: return -1\n-        iconst, fconst, slot, gaddr, daddr, faddr: return d\n-        intr, call, syscall:\n+    if shape < 8: return if shape & 4 != 0: d else: -1\n+    match shape:\n+        8, 9:\n             ir_use_span = a\n             ir_use_span_count = bb\n-            ir_use_count = bb\n+            ir_use_count = bb + (shape - 8)\n             return d\n-        calli, callc:\n-            ir_use_span = a\n-            ir_use_span_count = bb\n-            ir_use_count = bb + 1\n-            return d\n-        if_, brif, brtable, assume:\n-            ir_use_count = 1\n+        10:\n+            ir_use_count = if a >= 0: 1 else: 0\n             return -1\n-        ret:\n-            if a >= 0: ir_use_count = 1\n-            return -1\n-        store:\n+        11:\n             ir_use_count = 2\n             if int(ins.c) & M_INDEX != 0:\n                 ir_use_values.2 = d\n                 ir_use_count = 3\n             return -1\n-        vst:\n+        12:\n             ir_use_values.2 = d\n             ir_use_count = 3\n             return -1\n-        vsplat:\n-            ir_use_count = 1\n-            return d\n-        vzu: return -1\n-        copy:\n-            ir_use_count = 2\n-            return -1\n-        zero:\n-            ir_use_count = 1\n-            return -1\n-        memcpy, memset, vop:\n-            ir_use_count = 3\n-            return -1\n-        select, memeq:\n-            ir_use_count = 3\n-            return d\n-        load:\n+        13:\n             ir_use_count = 1\n             if int(ins.c) & M_INDEX != 0: ir_use_count = 2\n             return d\n-        mov, neg, not_, fneg, fsqrt, fabs, ffloor, fceil, ftrunc, sext8, sext16, sext32, zext8, zext16, zext32, i2f, u2f, f2i, f2f, bits2f, f2bits:\n-            ir_use_count = 1\n-            return d\n-        _:\n-            ir_use_count = 2\n-            return d\n+    -1\n",

  "decision": "Deferred; compiler changes reverted. Static redundant extensions do not establish an end-to-end speedup. No full suite or stage gate run.",
  "implementation_patch": "diff --git a/core/compiler/opt.jo b/core/compiler/opt.jo\nindex 8bcbfed6..decb3159 100644\n--- a/core/compiler/opt.jo\n+++ b/core/compiler/opt.jo\n@@ -551,6 +551,40 @@ add_fact_false = (c: int): add_fact(c, 0)\n fact_true = (c: int) -> bool: fact_known(c, 1)\n add_fact_true = (c: int): add_fact(c, 1)\n \n+# Signed widths are negative; positive widths describe unsigned values.\n+o_extension_bits = (op: Op) -> int:\n+    match op:\n+        sext8: -8\n+        sext16: -16\n+        sext32: -32\n+        zext8: 8\n+        zext16: 16\n+        zext32: 32\n+        _: 0\n+\n+# The original definition already describes the value's range. Reading it only\n+# for stable values avoids an extra analysis pass or per-register range table.\n+# A load's range survives memory writes; this does not make another load equal.\n+o_value_bits = (v: int, pos: int) -> int:\n+    if not stable(v): return 0\n+    at = int(o_defpos[v])\n+    if at < 0 or at >= pos: return 0\n+    ins = ir.code[at]\n+    match ins.op:\n+        eq, ne, lts, les, gts, ges, ltu, leu, gtu, geu, feq, fne, flt, fle, fgt, fge, memeq, streq: 1\n+        load:\n+            mode = int(ins.c)\n+            if mode & M_FLOAT != 0: return 0\n+            bits = (mode & 15) * 8\n+            if mode & M_SIGNED != 0: -bits else: bits\n+        _: o_extension_bits(ins.op)\n+\n+o_bits_fit = (source: int, target: int) -> bool:\n+    if source == 0 or target == 0: return false\n+    if source < 0: return target < 0 and source >= target\n+    if target < 0: return source < -target\n+    source <= target\n+\n # simplify one instruction, appending the result to o_out\n o_simplify = (ins0: Ins, pos: int):\n     ins = ins0\n@@ -591,11 +625,6 @@ o_simplify = (ins0: Ins, pos: int):\n             return\n         o_emit(ins)\n         return\n-    # The bounded memory comparison already produces a canonical boolean.\n-    # Inlined bool returns otherwise carry an unnecessary ABI byte extension.\n-    if op == .zext8 and stable(a) and (o_dop[a] == i32(int(Op.memeq)) or o_dop[a] == i32(int(Op.streq))):\n-        o_simplify(Ins(.mov, VI, i32(d), i32(a), 0, 0, 0), pos)\n-        return\n     # unary integer ops\n     if op == .neg or op == .not_ or op == .sext8 or op == .sext16 or op == .sext32 or op == .zext8 or op == .zext16 or op == .zext32:\n         if is_k(a):\n@@ -603,6 +632,10 @@ o_simplify = (ins0: Ins, pos: int):\n             if ok:\n                 o_simplify(Ins(.iconst, VI, i32(d), 0, 0, 0, v), pos)\n                 return\n+        bits = o_extension_bits(op)\n+        if bits != 0 and o_bits_fit(o_value_bits(a, pos), bits):\n+            o_simplify(Ins(.mov, VI, i32(d), i32(a), 0, 0, 0), pos)\n+            return\n         o_emit(ins)\n         return\n     r = fold(op, 0, 1)\n",

{
  "status": "deferred; compiler changes reverted",
  "scope": "Decode common small decimal literals from source bytes into DewySyntax.name, bypassing temporary numeric strings. No token layout or language change.",
  "patch": "diff --git a/core/compiler/dewy_fast.jo b/core/compiler/dewy_fast.jo\nindex 5b68ee5f..20b5cead 100644\n--- a/core/compiler/dewy_fast.jo\n+++ b/core/compiler/dewy_fast.jo\n@@ -516,6 +516,22 @@ dn_flow = () -> int:\n         break\n     dn_node(.flow, \"\", start, arms)\n \n+# Keep common decimal literals scalar while projecting syntax. The lexer\n+# has already validated this span; at most ten digits fit comfortably in int.\n+# Larger literals retain the full unsigned/exact-integer path in dw_unsigned.\n+dn_small_integer = (token: DewyLexeme) -> int:\n+    source = files[dn_file].src\n+    bytes = data(source)\n+    i = token.start\n+    if i + 1 < token.stop and bytes[i] == '0' and bytes[i + 1] == 'd': i += 2\n+    if token.stop - i > 10: return -1\n+    value = 0\n+    loop i < token.stop:\n+        c = bytes[i]\n+        if c != '_': value = value * 10 + int(c - '0')\n+        i += 1\n+    if value <= 2147483647: value else: -1\n+\n dn_atom = () -> int:\n     token = dn_tokens[dn_at]\n     symbol = token.symbol\n@@ -536,6 +552,12 @@ dn_atom = () -> int:\n         if not dn_range_bound(): return dots\n         bound = dn_expr(101)\n         return dn_op_node(.flat, .range_apply, token.start, [0, dots, bound])\n+    if token.kind == .source_integer:\n+        value = dn_small_integer(token)\n+        if value >= 0:\n+            # Name IDs are positive. A negative name stores -(value + 1),\n+            # including zero, without changing syntax/token record sizes.\n+            return dn_node(token.kind, \"\", token.start, name = i32(-value - 1))\n     text = dn_payload(token)\n     if token.kind == .op: return dn_error(token.start, \"expected an expression, found '{text}'\")\n     dn_node(token.kind, text, token.start, name = token.name)\ndiff --git a/core/compiler/dewy_parse.jo b/core/compiler/dewy_parse.jo\nindex ae587166..9ced0700 100644\n--- a/core/compiler/dewy_parse.jo\n+++ b/core/compiler/dewy_parse.jo\n@@ -169,6 +169,8 @@ dw_integer_kind = (kind: DewyKind) -> bool:\n \n dw_unsigned = (text: str, id: int) -> u64?:\n     if dewy_syntax[id].kind == .source_integer:\n+        encoded = int(dewy_syntax[id].name)\n+        if encoded < 0: return u64(-encoded - 1)\n         value: u64 = 0\n         loop c in text:\n             if c == '_': continue\n",

  "implementation_patch": "diff --git a/core/compiler/x64.jo b/core/compiler/x64.jo\nindex ef02a939..0b4e3051 100644\n--- a/core/compiler/x64.jo\n+++ b/core/compiler/x64.jo\n@@ -168,6 +168,22 @@ store_sized = (base: int, disp: int, r: int, size: int):\n         b(0x88)\n         mem(r, base, disp)\n \n+# Integer constants already fit signed imm32. Narrow stores take their low\n+# bytes; a qword store sign-extends the immediate just like the register form.\n+store_immediate = (base: int, disp: int, value: int, size: int):\n+    bytes = if size < 4: size else: 4\n+    if size == 2: b(0x66)\n+    rex(size == 8, 0, 0, base, false)\n+    b(if size == 1: 0xC6 else: 0xC7)\n+    # mem's relocation is relative to the displacement's end. The processor\n+    # uses the end of this instruction, including its trailing immediate.\n+    mem(0, base, disp - (if base == RIPREL: bytes else: 0))\n+    if size == 1: b(value)\n+    else if size == 2:\n+        b(value)\n+        b(value >> 8)\n+    else: b32(value)\n+\n # SSE: prefix (F2 for sd, F3 for ss, 66 for pd), 0F, opc, modrm mem\n sse_rm = (prefix: int, opc: int, x: int, base: int, disp: int):\n     if prefix != 0: b(prefix)\n@@ -2028,12 +2044,9 @@ emit_ins = (pos: int, ins: Ins):\n                 use_index(ix, mem_scale(ins))\n                 if size == 4: sse_rm(0xF3, 0x11, xb, base, disp)\n                 else: sse_rm(0xF2, 0x11, xb, base, disp)\n-            else if vloc[bb] == LOC_CONST and size >= 4 and base != RIPREL:\n+            else if vloc[bb] == LOC_CONST:\n                 use_index(ix, mem_scale(ins))\n-                rex(size == 8, 0, 0, base, false)\n-                b(0xC7)\n-                mem(0, base, disp)\n-                b32(vcval[bb])\n+                store_immediate(base, disp, vcval[bb], size)\n             else:\n                 rb = reg_of(bb, RAX)\n                 use_index(ix, mem_scale(ins))\n",

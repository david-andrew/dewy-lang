  "source": "from p\"benchmark_harness.jo\" import clock\ncount_text=(text:string expected:int64)=>{\n    assert(text.length =? expected)\n    let total=0 let start=clock()\n    loop i in [0..64) total+=text.length\n    let elapsed=clock()-start\n    assert(total =? expected*64)\n    printl\"{total} {elapsed}\"\n}\nwalk_text=(text:string expected:int64)=>{\n    let total=0 let start=clock()\n    loop i in [0..8) {loop cluster in text total+=cluster.length}\n    let elapsed=clock()-start\n    assert(total =? expected*8)\n    printl\"{total} {elapsed}\"\n}\nmain=()=>{\n    let ascii=repeat(\"score=42 player=Nova\\n\" 4096)\n    let lines=repeat(\"row\\r\\nnext\\r\\n\" 4096)\n    let unicode=repeat(\"cafe\u0301\ud83d\ude42\ud83c\uddfa\ud83c\uddf8\\r\\n\" 4096)\n    count_text(ascii 21*4096) count_text(lines 9*4096) count_text(unicode 7*4096)\n    walk_text(ascii 21*4096) walk_text(lines 9*4096) walk_text(unicode 7*4096)\n}\n",
  "harness": "# Platform boundary for the Dewy application benchmarks. The original\n# harness uses compiler-specific raw syscalls; this uses the core's library.\nsize_argument = (values: str[], fallback: int) -> int:\n    if values.len() < 2: return fallback\n    text = values[1]\n    value = 0\n    loop byte in text:\n        if byte < 48 or byte > 57: return fallback\n        value = value * 10 + int(byte) - 48\n        if value > 1000000000: return fallback\n    value\n\nclock = () -> int:\n    ts: (int, int)\n    if syscall(228, 3, &ts) != 0: panic(\"thread CPU clock unavailable\")\n    ts.0 * 1000000000 + ts.1\nmix = (hash: int, value: int) -> int: __floor_mod(hash * 31 + value, 1000000007)\n",
  "limits": [
    "Native Linux x86-64, one CPU, one thread. No general string-performance or C-parity claim.",
    "Input creation and one length check per input are outside timing. Length scans allocate no result array; streaming loops include one independent string per cluster and its length calculation.",
    "Mixed input contains combining accents, emoji, regional-indicator pairs and CRLF. Counts are independently specified; complete Unicode correctness is checked by the separate conformance suite.",
    "One warmup, then seven samples with alternating order; frequency and cache contention may vary."
  ]
